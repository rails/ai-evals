+++ b/test/models/reaction_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "is left by the current user in the comment's account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "requires content" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is at most 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+
+    reaction = @comment.reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "composed emoji count as a single character" do
+    assert @comment.reactions.build(content: "👨‍👩‍👧‍👦" * 16).valid?
+    assert @comment.reactions.build(content: "👍🏽" * 16).valid?
+    assert_not @comment.reactions.build(content: "👍🏽" * 17).valid?
+  end
+
+  test "surrounding and repeated whitespace is squished" do
+    assert_equal "Nice one", @comment.reactions.create!(content: "  Nice   one ").content
+  end
+
+  test "all emoji" do
+    assert reactions(:kevin).all_emoji?
+    assert_not reactions(:david).all_emoji?
+  end
+
+  test "ordered by when they were left" do
+    newest = @comment.reactions.create!(content: "🎉")
+
+    assert_equal newest, @comment.reactions.ordered.last
+  end
+
+  test "reacting touches the comment and its card so cached views refresh" do
+    assert_changes -> { @comment.reload.updated_at } do
+      assert_changes -> { @comment.card.reload.updated_at } do
+        travel 1.minute do
+          @comment.reactions.create!(content: "🎉")
+        end
+      end
+    end
+
+    assert_changes -> { @comment.reload.updated_at } do
+      travel 2.minutes do
+        reactions(:kevin).destroy!
+      end
+    end
+  end
+
+  test "reacting broadcasts a refresh to everyone viewing the card" do
+    card = @comment.card
+
+    assert_turbo_stream_broadcasts card, count: 1 do
+      @comment.reactions.create!(content: "🎉")
+
+      Turbo::StreamsChannel.refresh_debouncer_for(card).wait
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+  end
+
+  test "reactions go away with their comment" do
+    assert_difference -> { Reaction.count }, -2 do
+      @comment.destroy!
+    end
+  end
+
+  test "reactions go away with their reacter" do
+    assert_difference -> { Reaction.count }, -1 do
+      users(:kevin).destroy!
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..e80353a
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,177 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction, up to 16 characters", with: "Ship it 🚀"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Ship it 🚀"
+      assert_no_selector "form.reaction__form"
+      assert_no_field type: "text"
+      assert_link "Add a reaction"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction, up to 16 characters", with: "Again"
+      send_keys :enter
+
+      assert_selector ".reaction", text: "Again"
+      assert_link "Add a reaction"
+    end
+  end
+
+  test "picking an emoji" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      click_on "Party popper"
+
+      assert_field "Your reaction, up to 16 characters", with: "🎉"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+  end
+
+  test "canceling brings the button back" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction, up to 16 characters", with: "Never mind"
+      send_keys :escape
+
+      assert_link "Add a reaction"
+      assert_no_selector "form.reaction__form"
+    end
+
+    assert_equal 2, @comment.reactions.count
+  end
+
+  test "clicking your own reaction reveals a way to remove it" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      assert_no_button "Remove your reaction"
+
+      find(reaction_selector(:david)).click
+      assert_no_button "Remove your reaction"
+
+      find(reaction_selector(:kevin)).click
+      click_on "Remove your reaction"
+
+      assert_no_selector reaction_selector(:kevin)
+      assert_selector reaction_selector(:david)
+    end
+
+    assert_not Reaction.exists?(reactions(:kevin).id)
+  end
+
+  test "removing your own reaction with the keyboard" do
+    visit card_url(@comment.card)
+
+    within_reactions do
+      find("#{reaction_selector(:kevin)} [role=button]").send_keys(:enter)
+      assert_selector "#{reaction_selector(:kevin)}.expanded"
+
+      send_keys :escape
+      assert_no_selector "#{reaction_selector(:kevin)}.expanded"
+
+      send_keys :enter
+      assert_button "Remove your reaction"
+      send_keys :enter
+
+      assert_no_selector reaction_selector(:kevin)
+    end
+
+    assert_current_path card_path(@comment.card)
+    assert_not Reaction.exists?(reactions(:kevin).id)
+  end
+
+  test "reactions from others land without reloading" do
+    visit card_url(@comment.card)
+    assert_selector reaction_selector(:kevin)
+
+    react_elsewhere
+
+    within_reactions do
+      assert_selector ".reaction", text: "From afar", wait: 5
+    end
+  end
+
+  test "your own reactions stay removable after a refresh" do
+    visit card_url(@comment.card)
+
+    react_elsewhere
+    within_reactions { assert_selector ".reaction", text: "From afar", wait: 5 }
+
+    within_reactions do
+      assert_selector "#{reaction_selector(:kevin)}.reaction--deleteable [role=button][tabindex='0']"
+      assert_no_selector "#{reaction_selector(:david)}.reaction--deleteable"
+
+      find(reaction_selector(:kevin)).click
+      assert_button "Remove your reaction"
+    end
+  end
+
+  test "a reaction in progress survives a refresh" do
+    other_comment = comments(:logo_agreement_kevin)
+    visit card_url(@comment.card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction, up to 16 characters", with: "Typing…"
+    end
+
+    react_elsewhere @comment, other_comment
+
+    # The reaction on the other comment appearing proves the refresh reached the page
+    within_reactions(other_comment) { assert_selector ".reaction", text: "From afar", wait: 5 }
+
+    within_reactions do
+      assert_field "Your reaction, up to 16 characters", with: "Typing…"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Typing…"
+      assert_selector ".reaction", text: "From afar"
+    end
+  end
+
+  private
+    def within_reactions(comment = @comment, &block)
+      within "##{dom_id(comment, :reacting)}", &block
+    end
+
+    def reaction_selector(name)
+      "##{dom_id(reactions(name))}"
+    end
+
+    def react_elsewhere(*comments)
+      wait_for_cable_subscriptions
+
+      Current.set(session: sessions(:david)) do
+        (comments.presence || [ @comment ]).each { it.reactions.create!(content: "From afar") }
+      end
+
+      Turbo::StreamsChannel.refresh_debouncer_for(@comment.card).wait
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
