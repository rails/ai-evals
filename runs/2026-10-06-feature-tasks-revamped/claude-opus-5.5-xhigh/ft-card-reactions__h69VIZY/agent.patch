@@ -0,0 +1,17 @@
+class MakeReactionsPolymorphic < ActiveRecord::Migration[8.2]
+  def change
+    remove_index :reactions, :comment_id
+    rename_column :reactions, :comment_id, :reactable_id
+
+    # Existing reactions all belong to comments
+    add_column :reactions, :reactable_type, :string, null: false, default: "Comment"
+    change_column_default :reactions, :reactable_type, from: "Comment", to: nil
+
+    # Only comment reactions can survive going back to a comment_id column
+    reversible do |dir|
+      dir.down { execute "DELETE FROM reactions WHERE reactable_type <> 'Comment'" }
+    end
+
+    add_index :reactions, %i[ reactable_type reactable_id ], name: "index_reactions_on_reactable"
+  end
+end
