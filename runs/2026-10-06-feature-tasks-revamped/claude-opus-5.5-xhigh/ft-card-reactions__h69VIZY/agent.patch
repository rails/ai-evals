+  test "creating a reaction on a card touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "reacting to a card defaults the account and reacter" do
+    reaction = cards(:logo).reactions.create!(content: "👍")
+
+    assert_equal cards(:logo).account, reaction.account
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "card reactions are kept apart from the reactions to its comments" do
+    card_reaction = cards(:logo).reactions.create!(content: "👍")
+    comment_reaction = comments(:logo_1).reactions.create!(content: "🎉")
+
+    assert_equal [ card_reaction ], cards(:logo).reactions
+    assert_equal [ comment_reaction ], comments(:logo_1).reactions
+  end
+
+  test "reactions are deleted with their card" do
+    card = cards(:logo)
+    card_reaction = card.reactions.create!(content: "👍")
+    comment_reaction = card.comments.first.reactions.create!(content: "🎉")
+
+    card.destroy!
+
+    assert_not Reaction.exists?(card_reaction.id)
+    assert_not Reaction.exists?(comment_reaction.id)
+  end
 end
