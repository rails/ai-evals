diff --git a/test/models/account/data_transfer/reaction_record_set_test.rb b/test/models/account/data_transfer/reaction_record_set_test.rb
new file mode 100644
index 0000000..c188677
--- /dev/null
+++ b/test/models/account/data_transfer/reaction_record_set_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "check and import accept comment reactions exported before cards could be reacted to" do
+    data = {
+      "id" => ActiveRecord::Type::Uuid.generate,
+      "account_id" => ActiveRecord::Type::Uuid.generate,
+      "comment_id" => ActiveRecord::Type::Uuid.generate,
+      "reacter_id" => ActiveRecord::Type::Uuid.generate,
+      "content" => "👍",
+      "created_at" => Time.current.iso8601,
+      "updated_at" => Time.current.iso8601
+    }
+    zip = build_reader(data)
+
+    assert_nothing_raised { record_set.check(from: zip) }
+    record_set.import(from: zip)
+
+    reaction = Reaction.find(data["id"])
+    assert_equal "Comment", reaction.reactable_type
+    assert_equal data["comment_id"], reaction.reactable_id
+    assert_equal importing_account, reaction.account
+  end
+
+  test "export and import preserve card reactions" do
+    reaction = cards(:logo).reactions.create!(content: "👍", reacter: users(:david))
+    zip = export_to_reader(Account::DataTransfer::ReactionRecordSet.new(accounts("37s")))
+    reaction.delete
+
+    Account::DataTransfer::ReactionRecordSet.new(accounts("37s")).import(from: zip)
+
+    assert_equal cards(:logo), Reaction.find(reaction.id).reactable
+  end
+
+  private
+    def record_set
+      @record_set ||= Account::DataTransfer::ReactionRecordSet.new(importing_account).tap do |record_set|
+        record_set.importable_model_names = %w[ Account User Card Comment Reaction ]
+      end
+    end
+
+    def importing_account
+      @importing_account ||= Account.create!(name: "Importing Account", external_account_id: 99999999)
+    end
+
+    def build_reader(data)
+      with_zip_writer do |writer|
+        writer.add_file("data/reactions/#{data['id']}.json", data.to_json)
+      end
+    end
+
+    def export_to_reader(record_set)
+      with_zip_writer do |writer|
+        record_set.export(to: writer)
+      end
+    end
+
+    def with_zip_writer
+      tempfile = Tempfile.new([ "reactions", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |f| f.close; f.unlink }
+      @importing_account&.destroy
+    end
+end
