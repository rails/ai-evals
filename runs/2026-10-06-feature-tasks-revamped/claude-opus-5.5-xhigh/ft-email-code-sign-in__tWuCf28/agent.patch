+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "show" do
+    untenanted do
+      request_code_for @identity
+
+      get session_magic_link_path
+    end
+
+    assert_response :success
+    assert_in_body @identity.email_address
+    assert_select "input[name=code][autocomplete=one-time-code]"
+  end
+
+  test "show without an email address pending authentication" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "show redirects authenticated users" do
+    sign_in_as :kevin
+
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create with a sign-in code" do
+    untenanted do
+      magic_link = request_code_for @identity
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_not MagicLink.exists?(magic_link.id), "the code should be used up"
+    end
+  end
+
+  test "create returns to where the person was headed" do
+    get cards_path
+    assert_response :redirect
+
+    untenanted do
+      post session_magic_link_path, params: { code: request_code_for(@identity).code }
+
+      assert_redirected_to cards_url(script_name: accounts("37s").slug)
+    end
+  end
+
+  test "create with a sign-up code" do
+    untenanted do
+      post session_path, params: { email_address: "newcomer@example.com" }
+      magic_link = MagicLink.last
+      assert magic_link.for_sign_up?
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create accepts codes typed loosely" do
+    untenanted do
+      magic_link = request_code_for @identity
+
+      post session_magic_link_path, params: { code: " #{magic_link.code.downcase} " }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      magic_link = request_code_for @identity
+
+      post session_magic_link_path, params: { code: wrong_code_for(magic_link) }
+
+      assert_redirected_to session_magic_link_path
+      assert flash[:shake]
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?, "should be able to try again"
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create with an expired code" do
+    untenanted do
+      magic_link = request_code_for @identity
+      magic_link.update!(expires_at: 1.second.ago)
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create after fifteen minutes" do
+    untenanted do
+      magic_link = request_code_for @identity
+      token = pending_authentication_token
+
+      travel 15.minutes + 1.second do
+        # Even a client that holds on to the token can't use it anymore
+        cookies[:pending_authentication_token] = token
+
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create with a code that was already used" do
+    untenanted do
+      magic_link = request_code_for @identity
+      post session_magic_link_path, params: { code: magic_link.code }
+      delete session_path
+
+      request_code_for @identity
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with a code sent to a different email address" do
+    other_magic_link = identities(:david).send_magic_link
+
+    untenanted do
+      request_code_for @identity
+
+      post session_magic_link_path, params: { code: other_magic_link.code }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+      assert_not MagicLink.exists?(other_magic_link.id), "a code tried against the wrong email address is used up"
+    end
+  end
+
+  test "create without an email address pending authentication" do
+    magic_link = @identity.send_magic_link
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+      assert MagicLink.exists?(magic_link.id)
+    end
+  end
+
+  test "create for an unknown email address never signs in" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        post session_path, params: { email_address: "stranger@example.com" }
+        post session_magic_link_path, params: { code: @identity.send_magic_link.code }
+
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      token = response.parsed_body["pending_authentication_token"]
+      cookies.delete :pending_authentication_token
+
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path(format: :json), params: { code: @identity.magic_links.last.code }
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with the wrong code" do
+    untenanted do
+      magic_link = request_code_for @identity
+
+      post session_magic_link_path(format: :json), params: { code: wrong_code_for(magic_link) }
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON without an email address pending authentication" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      magic_link = request_code_for @identity
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def request_code_for(identity)
+      post session_path, params: { email_address: identity.email_address }
+      assert_redirected_to session_magic_link_url
+
+      identity.magic_links.last
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def wrong_code_for(magic_link)
+      magic_link.code == "ZZZZZZ" ? "YYYYYY" : "ZZZZZZ"
+    end
+end
