diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b1da57d
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,43 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, presence: true, uniqueness: true
+
+  class << self
+    def consume(code)
+      active.find_by(code: Code.sanitize(code))&.consume
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  # Codes are single-use. Deleting by id makes sure that only one of several
+  # concurrent attempts with the same code gets to use it.
+  def consume
+    self if self.class.where(id: id).delete_all.positive?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..ebe66bc
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,18 @@
+# Codes use Crockford's Base32 alphabet, which leaves out letters that are easy
+# to mistake for digits. When reading a code back, we're lenient: lowercase is
+# fine, the look-alike letters map to the digits they resemble, and anything
+# else that isn't part of the alphabet (spaces, dashes...) is ignored.
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+  LOOK_ALIKES = { "O" => "0", "I" => "1", "L" => "1" }.freeze
+
+  class << self
+    def generate(length)
+      Array.new(length) { ALPHABET.sample(random: SecureRandom) }.join
+    end
+
+    def sanitize(code)
+      code.to_s.upcase.tr(LOOK_ALIKES.keys.join, LOOK_ALIKES.values.join).delete("^#{ALPHABET.join}").presence
+    end
+  end
+end
