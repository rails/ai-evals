diff --git a/test/mailers/magic_link_mailer_test.rb b/test/mailers/magic_link_mailer_test.rb
new file mode 100644
index 0000000..8add5af
--- /dev/null
+++ b/test/mailers/magic_link_mailer_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = MagicLink.create!(identity: @identity)
+  end
+
+  test "sign_in_instructions is sent to the identity" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @identity.email_address ], email.to
+  end
+
+  test "sign_in_instructions has the code in the subject" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_equal "Your Fizzy code is #{@magic_link.code}", email.subject
+  end
+
+  test "sign_in_instructions has the code in both parts" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_match @magic_link.code, email.html_part.body.to_s
+    assert_match @magic_link.code, email.text_part.body.to_s
+  end
+
+  test "sign_in_instructions says how long the code works" do
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+
+  test "sign_in_instructions for signing up" do
+    @magic_link.update!(purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(@magic_link)
+
+    assert_match "finish signing up", email.text_part.body.to_s
+  end
+
+  test "sign_in_instructions logs the code when email isn't configured" do
+    log = capturing_log do
+      with_log_sign_in_codes(true) { MagicLinkMailer.sign_in_instructions(@magic_link).message }
+    end
+
+    assert_match "The code for #{@identity.email_address} is #{@magic_link.code}", log
+  end
+
+  test "sign_in_instructions doesn't log the code when email is configured" do
+    log = capturing_log { MagicLinkMailer.sign_in_instructions(@magic_link).message }
+
+    assert_no_match @magic_link.code, log
+  end
+
+  private
+    def capturing_log
+      original_logger, log = MagicLinkMailer.logger, StringIO.new
+      MagicLinkMailer.logger = ActiveSupport::Logger.new(log)
+      yield
+      log.string
+    ensure
+      MagicLinkMailer.logger = original_logger
+    end
+
+    def with_log_sign_in_codes(value)
+      original_value = Rails.configuration.x.log_sign_in_codes
+      Rails.configuration.x.log_sign_in_codes = value
+      yield
+    ensure
+      Rails.configuration.x.log_sign_in_codes = original_value
+    end
+end
