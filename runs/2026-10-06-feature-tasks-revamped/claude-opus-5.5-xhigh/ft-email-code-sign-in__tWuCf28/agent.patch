+require "test_helper"
+
+class MagicLink::CodeTest < ActiveSupport::TestCase
+  test "generate" do
+    code = MagicLink::Code.generate(6)
+
+    assert_equal 6, code.length
+    assert code.chars.all? { |char| char.in?(MagicLink::Code::ALPHABET) }
+  end
+
+  test "the alphabet leaves out letters that look like digits" do
+    assert_empty %w[ I L O U ] & MagicLink::Code::ALPHABET
+  end
+
+  test "sanitize" do
+    assert_equal "ABC123", MagicLink::Code.sanitize("abc123")
+    assert_equal "ABC123", MagicLink::Code.sanitize(" ABC-123\n")
+    assert_equal "011", MagicLink::Code.sanitize("oIl")
+    assert_nil MagicLink::Code.sanitize("")
+    assert_nil MagicLink::Code.sanitize(nil)
+    assert_nil MagicLink::Code.sanitize("!!!")
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..cf11677
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "new links get a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = MagicLink.create!(identity: identities(:kevin))
+
+      assert_match /\A[#{MagicLink::Code::ALPHABET.join}]{6}\z/, magic_link.code
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "codes are unique" do
+    MagicLink::Code.stubs(:generate).returns("AAAAAA", "AAAAAA", "BBBBBB")
+
+    first = MagicLink.create!(identity: identities(:kevin))
+    second = MagicLink.create!(identity: identities(:david))
+
+    assert_equal "AAAAAA", first.code
+    assert_equal "BBBBBB", second.code
+  end
+
+  test "consume" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume only works once" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    assert MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume is lenient about how the code is typed" do
+    magic_link = MagicLink.create!(identity: identities(:kevin), code: "0B1C1D")
+
+    assert_equal magic_link, MagicLink.consume(" ob-ic l d ")
+  end
+
+  test "consume with an expired code" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume with a code that still has a moment left" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    travel 15.minutes - 1.second do
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume with an unknown or blank code" do
+    MagicLink.create!(identity: identities(:kevin))
+
+    assert_nil MagicLink.consume("ZZZZZZ")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+  end
+
+  test "cleanup deletes expired links" do
+    active = MagicLink.create!(identity: identities(:kevin))
+    stale = MagicLink.create!(identity: identities(:kevin), expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+end
