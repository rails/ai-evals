new file mode 100644
index 0000000..d02f1b5
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create defaults the reacter and account" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "reactions are ordered chronologically" do
+    reaction = @comment.reactions.create!(content: "Last")
+
+    assert_equal reaction, @comment.reactions.reload.last
+  end
+
+  test "content is squished" do
+    assert_equal "Great work", @comment.reactions.create!(content: "  Great \n work ").content
+  end
+
+  test "content must be present" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: "   ").valid?
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+
+    reaction = @comment.reactions.build(content: "a" * 17)
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "characters are counted as people see them" do
+    assert @comment.reactions.build(content: "👍🏽" * 16).valid?
+    assert @comment.reactions.build(content: "❤️" * 16).valid?
+    assert @comment.reactions.build(content: "👨‍👩‍👧" * 16).valid?
+
+    assert_not @comment.reactions.build(content: "👍🏽" * 17).valid?
+  end
+
+  test "content made of heavily combined characters is rejected" do
+    assert_not @comment.reactions.build(content: "a#{"\u0301" * 300}").valid?
+  end
+
+  test "creating a reaction touches the comment and its card" do
+    card = @comment.card
+
+    assert_changes -> { @comment.reload.updated_at } do
+      assert_changes -> { card.reload.updated_at } do
+        travel 1.minute do
+          @comment.reactions.create!(content: "👍")
+        end
+      end
+    end
+  end
+
+  test "destroying a reaction touches the comment" do
+    reaction = reactions(:logo_agreement_kevin_jz)
+
+    assert_changes -> { @comment.reload.updated_at } do
+      travel 1.minute do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "all emoji" do
+    assert reactions(:logo_agreement_jz_kevin).all_emoji?
+    assert_not reactions(:logo_agreement_jz_david).all_emoji?
+  end
+
+  test "reactions are deleted with their comment" do
+    assert_difference -> { Reaction.count }, -@comment.reactions.count do
+      @comment.destroy!
+    end
+  end
+
+  test "reactions are destroyed with their reacter" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
