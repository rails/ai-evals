new file mode 100644
index 0000000..7e349f9
--- /dev/null
+++ b/app/views/cards/comments/reactions/new.html.erb
@@ -0,0 +1,41 @@
+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(@card, @comment), class: "reaction reaction__form expanded",
+        data: { controller: "form morph-guard reaction-form", reaction_form_max_length_value: Reaction::MAX_CHARACTERS,
+          action: "keydown.esc->form#cancel:stop submit->form#preventComposingSubmit submit->form#preventEmptySubmit" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label", for: dom_id(@comment, :reaction_content) do %>
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "reaction__avatar btn btn--circle" %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, id: dom_id(@comment, :reaction_content), class: "input reaction__input", required: true, autofocus: true, autocomplete: "off",
+          data: { form_target: "input", reaction_form_target: "input", "1p-ignore": "true",
+            action: "input->reaction-form#validate compositionstart->form#compositionStart compositionend->form#compositionEnd" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--plain" data-action="dialog#toggle" title="Pick an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup popup--align-right panel shadow" data-dialog-target="dialog" data-action="keydown.esc->dialog#close:stop">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <%= tag.button emoji, type: :button, class: "btn btn--circle btn--plain", title: name, aria: { label: name },
+                  data: { action: "reaction-form#insert dialog#close", reaction_form_emoji_param: emoji } %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--plain", title: "Add reaction" do %>
+      <%= icon_tag "check-circle" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment), class: "reaction__cancel-btn btn btn--plain", title: "Cancel (#{ hotkey_label([ "esc" ]) })",
+          data: { form_target: "cancel" } do %>
+      <%= icon_tag "close-circle" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
