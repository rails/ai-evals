diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..ae91b3f
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,24 @@
+class Reaction < ApplicationRecord
+  MAX_CHARACTERS = 16
+  MAX_CODEPOINTS = 255
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.squish }
+
+  validates :content, presence: true
+  validate :content_fits, if: :content?
+
+  delegate :all_emoji?, to: :content
+
+  private
+    # Characters are counted the way people see them, so "👍🏽" or "❤️" count once. The raw
+    # length is capped too, so a few heavily combined characters can't overflow the column.
+    def content_fits
+      if content.grapheme_clusters.size > MAX_CHARACTERS || content.length > MAX_CODEPOINTS
+        errors.add :content, :too_long, count: MAX_CHARACTERS
+      end
+    end
+end
