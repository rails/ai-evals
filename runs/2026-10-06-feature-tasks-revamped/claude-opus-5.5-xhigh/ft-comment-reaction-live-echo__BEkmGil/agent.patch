+++ b/test/system/reactions_test.rb
@@ -0,0 +1,344 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    @comment = comments(:logo_agreement_kevin)
+    @card = @comment.card
+  end
+
+  test "adding a reaction" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+
+      assert_no_selector ".reactions__trigger"
+      find(".reaction__input").fill_in with: "Ship it!"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Ship it!"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal [ "Ship it!", users(:david) ], @comment.reactions.last.then { [ it.content, it.reacter ] }
+  end
+
+  test "adding another reaction right after one" do
+    visit card_url(@card)
+
+    within_comment do
+      react_with "One"
+      assert_selector ".reaction", text: "One"
+
+      react_with "Two"
+      assert_selector ".reaction", text: "Two"
+      assert_selector ".reaction", count: 3
+    end
+  end
+
+  test "the button is focused again after reacting or canceling from the keyboard" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").send_keys :enter
+      find(".reaction__input:focus").send_keys "Keyboard", :enter
+
+      assert_selector ".reaction", text: "Keyboard"
+      assert_selector ".reactions__trigger:focus"
+
+      send_keys :enter
+      find(".reaction__input:focus").send_keys :escape
+
+      assert_selector ".reactions__trigger:focus"
+    end
+  end
+
+  test "picking an emoji" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[title='Fire']").click
+
+      assert_no_selector ".reaction__popup"
+      assert_equal "🔥", find(".reaction__input").value
+      send_keys :enter
+
+      assert_selector ".reaction", text: "🔥"
+    end
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").send_keys :escape
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal 1, @comment.reactions.count
+  end
+
+  test "escape closes the emoji picker before canceling the reaction" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      assert_staying_on_the_card do
+        find(".reaction__emoji-list button[title='Fire']").send_keys :escape
+      end
+
+      assert_no_selector ".reaction__popup"
+      assert_selector ".reaction__input"
+
+      assert_staying_on_the_card do
+        find(".reaction__menu-btn").send_keys :escape
+      end
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "reactions are limited to 16 characters" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "a" * 17
+      find(".reaction__submit-btn").click
+
+      assert_not find(".reaction__input").evaluate_script("this.validity.valid")
+      assert_equal 1, @comment.reactions.count
+
+      fill_in_reaction "👍🏽" * 16
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "👍🏽" * 16
+    end
+  end
+
+  test "removing your reaction" do
+    @comment = comments(:logo_agreement_jz)
+    reaction = reactions(:logo_agreement_jz_david)
+    visit card_url(@card)
+
+    within_comment do
+      within("##{dom_id(reaction)}.reaction--deleteable") do
+        assert_no_selector ".reaction__delete"
+        assert_selector "span[role=button][aria-expanded=false]", text: "Nice one!"
+
+        find("span", text: "Nice one!").click
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector "##{dom_id(reaction)}"
+      assert_selector ".reaction", count: 1
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "clicking the avatar on your reaction reveals the option to remove it" do
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@card)
+
+    within_comment do
+      assert_staying_on_the_card do
+        find("##{dom_id(reactions(:logo_agreement_jz_david))} .reaction__avatar").click
+      end
+
+      assert_selector "##{dom_id(reactions(:logo_agreement_jz_david))} .reaction__delete"
+    end
+  end
+
+  test "reacting to two comments at once" do
+    other_comment = comments(:logo_agreement_jz)
+    visit card_url(@card)
+
+    within("##{dom_id(other_comment)}") { find(".reactions__trigger").click }
+    within_comment { find(".reactions__trigger").click }
+
+    within("##{dom_id(other_comment)}") do
+      find(".reaction__form-label").click
+      send_keys "First"
+    end
+    within_comment do
+      find(".reaction__form-label").click
+      send_keys "Second"
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Second"
+    end
+
+    within("##{dom_id(other_comment)}") do
+      assert_equal "First", find(".reaction__input").value
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "First"
+    end
+  end
+
+  test "escape hides the option to remove your reaction" do
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@card)
+
+    within_comment do
+      find(".reaction span", text: "Nice one!").click
+      assert_selector ".reaction.expanded .reaction__delete"
+
+      assert_staying_on_the_card do
+        find(".reaction span", text: "Nice one!").send_keys :escape
+      end
+
+      assert_no_selector ".reaction.expanded"
+      assert_no_selector ".reaction__delete"
+    end
+  end
+
+  test "clicking elsewhere hides the option to remove your reaction" do
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@card)
+
+    within_comment do
+      find(".reaction span", text: "Nice one!").click
+      assert_selector ".reaction__delete"
+    end
+
+    find("h1", text: @card.title).click
+    within_comment { assert_no_selector ".reaction__delete" }
+  end
+
+  test "other people's reactions can't be removed" do
+    visit card_url(@card)
+
+    within_comment do
+      within(".reaction", text: "🎉") do
+        find("span", text: "🎉").click
+        assert_no_selector ".reaction__delete"
+      end
+
+      assert_no_selector ".reaction--deleteable"
+    end
+  end
+
+  test "reactions from others land without reloading" do
+    visit card_url(@card)
+    within_comment { assert_selector ".reaction", count: 1 }
+
+    react_elsewhere "🙌"
+
+    within_comment do
+      assert_selector ".reaction", text: "🙌", wait: 5
+      assert_selector ".reaction", count: 2
+    end
+  end
+
+  test "reactions removed by others disappear without reloading" do
+    visit card_url(@card)
+    within_comment { assert_selector ".reaction", text: "🎉" }
+
+    wait_for_cable_subscriptions
+    reactions(:logo_agreement_kevin_jz).destroy!
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within_comment { assert_no_selector ".reaction", wait: 5 }
+  end
+
+  test "a reaction landing doesn't interrupt one in progress" do
+    visit card_url(@card)
+
+    within_comment do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Half typed"
+    end
+
+    react_elsewhere "🙌"
+
+    within_comment do
+      assert_selector ".reaction", text: "🙌", wait: 5
+      assert_equal "Half typed", find(".reaction__input").value
+
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: "Half typed"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "your reaction stays removable when reactions land" do
+    visit card_url(@card)
+
+    within_comment do
+      react_with "Mine"
+      find(".reaction span", text: "Mine").click
+      assert_selector ".reaction.expanded .reaction__delete"
+    end
+
+    react_elsewhere "🙌"
+
+    within_comment do
+      assert_selector ".reaction", text: "🙌", wait: 5
+
+      within(".reaction.reaction--deleteable.expanded", text: "Mine") do
+        assert_selector "span[role=button][aria-expanded=true]"
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector ".reaction", text: "Mine"
+    end
+  end
+
+  private
+    def within_comment(&)
+      within("##{dom_id(@comment)}", &)
+    end
+
+    def react_with(content)
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: content
+      find(".reaction__submit-btn").click
+      assert_selector ".reaction", text: content
+    end
+
+    # ChromeDriver can't type characters outside the Basic Multilingual Plane
+    def fill_in_reaction(content)
+      input = find(".reaction__input")
+      execute_script <<~JS, input, content
