--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,50 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..5642a5a
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,76 @@
+import { Controller } from "@hotwired/stimulus"
+
+const CONTENT_ATTRIBUTES = [ "role", "tabindex", "aria-label", "aria-expanded" ]
+
+// Reactions are rendered inside cached comments, so whether one is yours, and
+// can be removed, is only known here.
+export default class extends Controller {
+  static targets = [ "content" ]
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#isMine) {
+      this.element.classList.add(this.deleteableClass)
+      this.contentTarget.setAttribute("role", "button")
+      this.contentTarget.setAttribute("tabindex", "0")
+      this.contentTarget.setAttribute("aria-label", `Your reaction: ${this.contentTarget.textContent}`)
+      this.contentTarget.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  toggle(event) {
+    if (this.#isMine && !event.target.closest("form")) {
+      event.preventDefault()
+      this.#expand(!this.#isExpanded)
+    }
+  }
+
+  dismiss(event) {
+    if (this.#isExpanded) {
+      event.preventDefault()
+      this.contentTarget.focus()
+      this.#expand(false)
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (this.#isExpanded && !this.element.contains(target)) this.#expand(false)
+  }
+
+  delete() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  restore({ detail: { success } }) {
+    if (!success) this.element.classList.remove(this.deletingClass)
+  }
+
+  // Broadcast page refreshes morph elements back to their server-rendered
+  // attributes, which would undo what's set here.
+  preserveAttributes(event) {
+    const { target, detail: { attributeName } } = event
+
+    if (this.#isMine && this.#manages(target, attributeName)) {
+      event.preventDefault()
+    }
+  }
+
+  #expand(expanded) {
+    this.element.classList.toggle(this.expandedClass, expanded)
+    this.contentTarget.setAttribute("aria-expanded", expanded)
+  }
+
+  #manages(element, attributeName) {
+    return (element === this.element && attributeName === "class") ||
+      (element === this.contentTarget && CONTENT_ATTRIBUTES.includes(attributeName))
+  }
+
+  get #isExpanded() {
+    return this.element.classList.contains(this.expandedClass)
+  }
+
+  get #isMine() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..ba6dac2
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+  static values = { maxLength: Number }
+
+  insert({ params: { emoji } }) {
+    const { selectionStart, selectionEnd } = this.inputTarget
+
+    this.inputTarget.setRangeText(emoji, selectionStart, selectionEnd, "end")
+    this.inputTarget.focus()
+    this.validate()
+  }
+
+  validate() {
+    if (this.#length > this.maxLengthValue) {
+      this.inputTarget.setCustomValidity(`Keep it to ${this.maxLengthValue} characters or fewer`)
+    } else {
+      this.inputTarget.setCustomValidity("")
+    }
+  }
+
+  // Characters are counted as people see them, so "👍🏽" counts once, unlike
+  // maxlength, which counts UTF-16 code units.
+  get #length() {
+    const value = this.inputTarget.value.trim()
+
+    if ("Segmenter" in Intl) {
+      return Array.from(new Intl.Segmenter().segment(value)).length
+    } else {
+      return Array.from(value).length
+    }
+  }
+}
