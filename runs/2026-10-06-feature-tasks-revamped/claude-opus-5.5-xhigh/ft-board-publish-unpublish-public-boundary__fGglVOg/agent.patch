diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..26afcba
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+    assert_select "input[value=?]", public_board_url(@board.reload.publication)
+  end
+
+  test "publishing an already published board keeps the existing key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublish" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "publish without turbo redirects back to the board settings" do
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "unpublish without turbo redirects back to the board settings" do
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "publish as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal @board.id, @response.parsed_body["id"]
+    assert_equal public_board_url(@board.publication), @response.parsed_body["public_url"]
+  end
+
+  test "unpublish as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "board creators can publish their boards" do
+    logout_and_sign_in_as :david
+    assert_not users(:david).admin?
+
+    post board_publication_path(@board, format: :turbo_stream)
+
+    assert_response :success
+    assert @board.reload.published?
+  end
+
+  test "non-admins cannot publish" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admins cannot unpublish" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non-admins cannot publish as JSON" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "cannot publish boards without access" do
+    logout_and_sign_in_as :david
+    assert_not boards(:private).accessible_to?(users(:david))
+
+    post board_publication_path(boards(:private), format: :turbo_stream)
+
+    assert_response :not_found
+    assert_not boards(:private).reload.published?
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    post board_publication_path(@board, format: :turbo_stream)
+
+    assert_not @board.reload.published?
+  end
+end
