+    get public_board_card_path(@board.publication, cards(:shipping))
+
+    assert_response :success
+    assert_select ".card__closed-title", text: "Done"
+  end
+
+  test "show a drafted card" do
+    card = with_current_user(:kevin) { @board.cards.create!(title: "Secret draft", status: :drafted) }
+
+    get public_board_card_path(@board.publication, card)
+
+    assert_response :not_found
+  end
+
+  test "show a card from another board" do
+    card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Private card", status: :published) }
+
+    get public_board_card_path(@board.publication, card)
+
+    assert_response :not_found
+  end
+
+  test "show a card of an unpublished board" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, cards(:logo))
+
+    assert_response :not_found
+  end
+
+  test "show a card with an unknown number" do
+    get public_board_card_path(@board.publication, 9999)
+
+    assert_response :not_found
+  end
+end
