diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..d46574e
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,58 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+
+      <p class="margin-none-block-start" id="<%= dom_id(board, :public_url_label) %>">This board is published. Anyone with this secret link can see it, even without a Fizzy account.</p>
+
+      <div class="flex align-center gap-half">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" aria-labelledby="<%= dom_id(board, :public_url_label) %>" readonly>
+
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+
+        <div data-controller="dialog" data-dialog-modal-value="true" class="flex-inline">
+          <%= tag.button class: "btn", data: { action: "dialog#open", controller: "tooltip" } do %>
+            <%= icon_tag "qr-code" %>
+            <span class="for-screen-reader">Display QR code for the public link</span>
+          <% end %>
+
+          <dialog class="dialog panel shadow" data-dialog-target="dialog" style="--panel-size: 50ch;">
+            <p class="margin-none-block-start txt-balance">
+              <strong>Scan this code to see <%= board.name %>:</strong>
+            </p>
+
+            <%= qr_code_image(url) %>
+
+            <form method="dialog" class="margin-block-start flex justify-center">
+              <button class="btn">
+                <span>Done</span>
+              </button>
+            </form>
+          </dialog>
+        </div>
+      </div>
+
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative txt-small", form_class: "flex justify-center margin-block-start-half",
+              data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } do %>
+          <%= icon_tag "lock" %>
+          <span>Unpublish this board</span>
+        <% end %>
+      <% end %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share a read-only version of it with anyone, even people without a Fizzy account. Only people with the secret link will be able to see it.</p>
+
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to board_publication_path(board), method: :post, class: "btn", form_class: "flex justify-center" do %>
+          <%= icon_tag "globe" %>
+          <span>Publish this board</span>
+        <% end %>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
