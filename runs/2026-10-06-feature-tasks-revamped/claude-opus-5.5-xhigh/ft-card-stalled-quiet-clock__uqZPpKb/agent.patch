@@ -0,0 +1,25 @@
+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+
+    @card = cards(:layout)
+    with_current_user(:david) { @card.toggle_assignment users(:kevin) }
+  end
+
+  test "a stalled card shows how long it has been stalled" do
+    @card.update! last_active_at: 20.days.ago
+
+    visit card_url(@card)
+    assert_selector "#bubble_card_#{@card.id}", text: /stalled for\s+20\s+days/i
+
+    visit cards_url(indexed_by: "stalled")
+    assert_selector "#bubble_card_#{@card.id}", text: /stalled for\s+20\s+days/i
+  end
+
+  test "a card with a recent burst isn't shown as stalled" do
+    visit card_url(@card)
+    assert_selector "#bubble_card_#{@card.id}", visible: :hidden
+  end
+end
