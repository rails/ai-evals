+<% @page_title = "Upgrade" %>
+
+<div class="panel panel--centered flex flex-column gap" style="--panel-size: 60ch;">
+  <header>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-block-end-none">Pick a plan for <%= Current.account.name %></h1>
+    <div>You’re on the <strong><%= Current.account.plan.name %></strong> plan.</div>
+  </header>
+
+  <ul class="list-unindented flex flex-column gap">
+    <% Plan.all.each do |plan| %>
+      <li class="flex align-center gap justify-space-between txt-align-start">
+        <div>
+          <strong class="txt-medium"><%= plan.name %></strong> · <%= plan_price(plan) %>
+          <div class="txt-small"><%= plan_allowance(plan) %></div>
+        </div>
+
+        <% if plan == Current.account.plan %>
+          <span class="txt-small txt-ink-medium">Current plan</span>
+        <% elsif plan.paid? && !Current.account.comped? %>
+          <%= button_to Current.account.subscribed? ? "Switch to #{plan.name}" : "Upgrade to #{plan.name}",
+                saas.account_subscription_path(plan: plan), class: "btn btn--link", form: { data: { turbo: false } } %>
+        <% end %>
+      </li>
+    <% end %>
+  </ul>
+
+  <% if Current.account.comped? %>
+    <p class="txt-small">This account is complimentary, so there’s nothing to pay.</p>
+  <% else %>
+    <p class="txt-small">You’ll check out with Stripe, and you can change plans or cancel any time from Account Settings.</p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= link_to "Back to Account Settings", main_app.account_settings_path, class: "btn btn--plain txt-link" %>
+<% end %>
