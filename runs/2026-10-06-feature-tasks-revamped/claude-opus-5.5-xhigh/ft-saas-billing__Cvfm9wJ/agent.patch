+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+
+      <ul class="list-unindented txt-align-start">
+        <li>Account ID <strong>#<%= @account.external_account_id %></strong></li>
+        <li>Created <%= @account.created_at.strftime("%B %-d, %Y") %></li>
+        <li>Owner <%= @account.owner_name || "None" %> <span class="txt-ink-medium"><%= @account.owner_email %></span></li>
+        <li><%= @account.cancelled? ? "Cancelled #{time_ago_in_words(@account.cancellation.created_at)} ago" : "Active" %></li>
+      </ul>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+      </header>
+
+      <ul class="list-unindented txt-align-start">
+        <li>Plan <strong><%= @account.plan.name %></strong><%= ", comped" if @account.comped? %></li>
+
+        <% if subscription = @account.subscription %>
+          <li>Stripe customer <code><%= subscription.stripe_customer_id %></code></li>
+          <% if subscription.stripe_subscription_id %>
+            <li>Stripe subscription <code><%= subscription.stripe_subscription_id %></code>, <%= subscription.status.humanize(capitalize: false) %><%= ", ends #{subscription.cancel_at.strftime("%B %-d, %Y")}" if subscription.canceling? %></li>
+          <% end %>
+        <% else %>
+          <li>Never subscribed</li>
+        <% end %>
+      </ul>
+
+      <div class="flex gap-half">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn", disabled: @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn", disabled: !@account.comped? %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage</h2>
+        <div>An override stands in for the real figures when checking the account against its plan. Leave a field blank to keep the real figure.</div>
+      </header>
+
+      <ul class="list-unindented txt-align-start">
+        <li>
+          <%= pluralize number_with_delimiter(@account.billed_cards_count), "card" %><%= " of #{number_with_delimiter(@account.card_limit)}" if @account.plan.limit_cards? %>
+          <% if @account.overridden_limits&.card_count %><span class="txt-ink-medium">(overridden, really <%= number_with_delimiter(@account.cards_count) %>)</span><% end %>
+        </li>
+        <li>
+          <%= number_to_human_size(@account.billed_bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %> storage
+          <% if @account.overridden_limits&.bytes_used %><span class="txt-ink-medium">(overridden, really <%= number_to_human_size(@account.bytes_used) %>)</span><% end %>
+        </li>
+      </ul>
+
+      <%= form_with url: saas.admin_account_overridden_limits_path(@account), method: :put, scope: :overridden_limits, class: "flex flex-column gap-half txt-align-start" do |form| %>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limits&.card_count, min: 0, step: 1, class: "input", placeholder: @account.cards_count %>
+
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limits&.bytes_used, min: 0, step: 1, class: "input", placeholder: @account.bytes_used %>
+
+        <div class="flex gap-half">
+          <%= form.button "Override", class: "btn btn--link" %>
+        </div>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn", disabled: @account.overridden_limits.nil? %>
+    </section>
+  </div>
+</section>
+
+<% content_for :footer do %>
+  <%= link_to "All accounts", saas.admin_accounts_path, class: "btn btn--plain txt-link" %>
+<% end %>
