+<section class="settings__section" id="billing">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      <% if account.comped? && !account.subscribed? %>
+        <strong><%= account.plan.name %></strong>, complimentary.
+      <% else %>
+        <strong><%= account.plan.name %></strong>, <%= plan_price(account.plan) %>.
+      <% end %>
+      <%= plan_allowance(account.plan) %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented txt-small">
+    <% if account.plan.limit_cards? %>
+      <li>
+        <%= number_with_delimiter(account.billed_cards_count) %> of <%= number_with_delimiter(account.card_limit) %> cards used<% if account.nearing_card_limit? || account.out_of_cards? %>, <strong><%= cards_left(account.remaining_cards_count) %></strong><% end %>
+      </li>
+    <% end %>
+    <li><%= number_to_human_size(account.billed_bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used</li>
+
+    <% if subscription = account.active_subscription %>
+      <% if subscription.canceling? %>
+        <li>Ends on <%= subscription.cancel_at.strftime("%B %-d, %Y") %>.</li>
+      <% elsif subscription.status == "past_due" %>
+        <li><strong>Your last payment didn’t go through.</strong> Update your payment details to keep your plan.</li>
+      <% elsif subscription.current_period_end %>
+        <li>Renews on <%= subscription.current_period_end.strftime("%B %-d, %Y") %>.</li>
+      <% end %>
+    <% end %>
+  </ul>
+
+  <div class="flex gap-half">
+    <% if account.upgrade_plans.any? %>
+      <%= link_to "Upgrade", upgrade_path, class: "btn btn--link" %>
+    <% end %>
+
+    <% if account.subscription %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: account.slug), class: "btn", form: { data: { turbo: false } } %>
+    <% end %>
+  </div>
+</section>
