+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  def update
+    @account.override_limits(**overridden_limits_params)
+    redirect_to_account notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to_account alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_limits
+    redirect_to_account notice: "Limits reset"
+  end
+
+  private
+    def overridden_limits_params
+      params.expect(overridden_limits: %i[ card_count bytes_used ]).to_h.symbolize_keys.transform_values(&:presence)
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
