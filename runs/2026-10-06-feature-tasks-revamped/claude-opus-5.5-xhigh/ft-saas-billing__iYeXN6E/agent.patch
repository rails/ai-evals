diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..4f8afd6
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,52 @@
+#!/usr/bin/env ruby
+#
+# Sets up Stripe for local development: loads the 37signals Development keys and prices from
+# 1Password and starts the Stripe CLI forwarding webhooks to the local server.
+#
+# Usage: eval "$(BUNDLE_GEMFILE=Gemfile.saas bundle exec stripe-dev)"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+WEBHOOKS_URL = ENV.fetch("STRIPE_WEBHOOKS_URL", "http://app.fizzy.localhost:3006/stripe/webhooks")
+LOG_PATH = File.expand_path("log/stripe.log", Dir.pwd)
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/Development/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+unless system("which stripe > /dev/null 2>&1")
+  warn "Error: the Stripe CLI isn't installed. See https://stripe.com/docs/stripe-cli"
+  exit 1
+end
+
+secret_key = op_read("STRIPE_SECRET_KEY")
+monthly_price_id = op_read("STRIPE_MONTHLY_V1_PRICE_ID")
+monthly_extra_storage_price_id = op_read("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+
+if [ secret_key, monthly_price_id, monthly_extra_storage_price_id ].any?(&:empty?)
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+# Each `stripe listen` session signs its events with this device's secret
+webhook_secret = `stripe listen --api-key #{secret_key} --print-secret 2>/dev/null`.strip
+
+if webhook_secret.empty?
+  warn "Error: Could not get a webhook signing secret from the Stripe CLI. Have you run `stripe login`?"
+  exit 1
+end
+
+listener = spawn("stripe", "listen", "--api-key", secret_key, "--forward-to", WEBHOOKS_URL, out: LOG_PATH, err: LOG_PATH)
+Process.detach(listener)
+
+puts %Q(export STRIPE_SECRET_KEY="#{secret_key}")
+puts %Q(export STRIPE_WEBHOOK_SECRET="#{webhook_secret}")
+puts %Q(export STRIPE_MONTHLY_V1_PRICE_ID="#{monthly_price_id}")
+puts %Q(export STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID="#{monthly_extra_storage_price_id}")
+
+warn ""
+warn "Stripe configured for development"
+warn "  Webhooks: forwarding to #{WEBHOOKS_URL} (pid #{listener}, logging to #{LOG_PATH})"
+warn "  Stop forwarding with: kill #{listener}"
