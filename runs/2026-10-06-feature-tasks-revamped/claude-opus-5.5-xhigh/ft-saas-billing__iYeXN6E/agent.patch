@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @account = accounts(:"37s")
+  end
+
+  test "admins manage billing in the stripe portal" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+    Stripe::BillingPortal::Session.expects(:create)
+      .with({ customer: "cus_123", return_url: "http://www.example.com#{@account.slug}/account/settings#plan" })
+      .returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/123"))
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/p/session/123"
+  end
+
+  test "accounts that never checked out have nothing to manage" do
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to account_settings_path(anchor: "plan")
+  end
+
+  test "members can't manage billing" do
+    logout_and_sign_in_as :jz
+
+    post saas.account_billing_portal_path
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/account/settings_plan_test.rb b/saas/test/controllers/account/settings_plan_test.rb
