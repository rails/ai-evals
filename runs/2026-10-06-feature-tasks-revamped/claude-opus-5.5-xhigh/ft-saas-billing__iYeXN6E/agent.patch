@@ -0,0 +1,46 @@
+class Account::SubscriptionsController < ApplicationController
+  include Account::StripeRedirection
+
+  before_action :ensure_admin
+  before_action :set_plan, only: :create
+
+  # Stripe Checkout sends people back here once they've paid. GETs can land where the
+  # database is read-only, so the page submits itself to #update to record the purchase.
+  def show
+  end
+
+  def create
+    if Current.account.active_subscription
+      redirect_to_stripe Current.account.stripe_billing_portal_url(return_url: settings_url, change_plan: true)
+    else
+      redirect_to_stripe Current.account.stripe_checkout_url(plan: @plan, email: Current.identity.email_address,
+        success_url: checkout_success_url, cancel_url: settings_url)
+    end
+  end
+
+  def update
+    sync_checkout
+    redirect_to settings_url, notice: "Thanks for upgrading!"
+  end
+
+  private
+    def set_plan
+      @plan = Plan.find_by_key(params[:plan])
+
+      unless @plan&.paid?
+        redirect_to settings_url, alert: "Choose a plan to upgrade to"
+      end
+    end
+
+    def checkout_success_url
+      # Stripe fills in the placeholder, so it mustn't be escaped
+      "#{saas.account_subscription_url}?session_id={CHECKOUT_SESSION_ID}"
+    end
+
+    def sync_checkout
+      Current.account.sync_stripe_checkout(params[:session_id]) if params[:session_id].present?
+    rescue Stripe::StripeError => error
+      # The webhook will catch the account up shortly
+      Rails.error.report(error, handled: true)
+    end
+end
