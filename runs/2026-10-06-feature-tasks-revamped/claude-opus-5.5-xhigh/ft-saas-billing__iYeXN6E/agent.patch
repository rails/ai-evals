+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= @account.name %>
+    <div class="txt-normal font-weight-normal"><%= link_to "All accounts", saas.admin_accounts_path %></div>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Account</h2>
+      </header>
+
+      <ul class="list-unindented margin-none flex flex-column gap-half txt-align-start">
+        <li class="flex gap-half justify-space-between"><span class="txt-subtle">ID</span> <span>#<%= @account.external_account_id %></span></li>
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Owner</span>
+          <span class="min-width overflow-ellipsis"><%= [ @account.owner_name, @account.owner_email ].compact.join(", ").presence || "None" %></span>
+        </li>
+        <li class="flex gap-half justify-space-between"><span class="txt-subtle">Created</span> <span><%= @account.created_at.to_date.to_fs(:long) %></span></li>
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Status</span>
+          <span><%= @account.cancelled? ? "Cancelled on #{@account.cancellation.created_at.to_date.to_fs(:long)}" : "Active" %></span>
+        </li>
+      </ul>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+      </header>
+
+      <ul class="list-unindented margin-none flex flex-column gap-half txt-align-start">
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Plan</span>
+          <span><%= plan.name %> (<%= plan_price(plan) %>)<%= ", comped" if @account.comped? %></span>
+        </li>
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Subscription</span>
+          <span>
+            <% if subscription&.stripe_subscription_id %>
+              <%= subscription.status.to_s.humanize %><% if subscription.canceling? %>, ends <%= subscription.cancel_at.to_date.to_fs(:long) %><% elsif subscription.active? && subscription.current_period_end %>, renews <%= subscription.current_period_end.to_date.to_fs(:long) %><% end %>
+            <% else %>
+              None
+            <% end %>
+          </span>
+        </li>
+        <% if subscription %>
+          <li class="flex gap-half justify-space-between">
+            <span class="txt-subtle">Stripe customer</span>
+            <%= link_to subscription.stripe_customer_id, stripe_dashboard_url("customers/#{subscription.stripe_customer_id}"), target: "_blank" %>
+          </li>
+        <% end %>
+      </ul>
+
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage</h2>
+      </header>
+
+      <ul class="list-unindented margin-none flex flex-column gap-half txt-align-start">
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Cards</span>
+          <span>
+            <%= number_with_delimiter(@account.cards_count) %><% if overridden_limits&.card_count %>, counted as <%= number_with_delimiter(overridden_limits.card_count) %><% end %>
+            <% if plan.limit_cards? %>of <%= number_with_delimiter(plan.card_limit) %><% end %>
+          </span>
+        </li>
+        <li class="flex gap-half justify-space-between">
+          <span class="txt-subtle">Storage</span>
+          <span>
+            <%= number_to_human_size(@account.bytes_used) %><% if overridden_limits&.bytes_used %>, counted as <%= number_to_human_size(overridden_limits.bytes_used) %><% end %>
+            of <%= number_to_human_size(@account.storage_limit) %>
+          </span>
+        </li>
+      </ul>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override limits</h2>
+        <div>Count the account as having this many cards or bytes when checking its limits. Leave a field blank to use the real figure.</div>
+      </header>
+
+      <%= form_with scope: :overridden_limits, url: saas.admin_account_overridden_limits_path(@account), method: :patch, class: "flex flex-column gap-half txt-align-start" do |form| %>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: overridden_limits&.card_count, min: 0, step: 1, class: "input", placeholder: @account.cards_count.to_s %>
+
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: overridden_limits&.bytes_used, min: 0, step: 1, class: "input", placeholder: @account.bytes_used.to_s %>
+
+        <div><%= form.button "Override", class: "btn btn--link", name: nil %></div>
+      <% end %>
+
+      <% if overridden_limits %>
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      <% end %>
+    </section>
+  </div>
+</section>
