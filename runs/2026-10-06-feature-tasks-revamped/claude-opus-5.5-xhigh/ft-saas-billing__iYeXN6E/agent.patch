+++ b/saas/test/controllers/account/settings_plan_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Account::SettingsPlanTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade" do
+    sign_in_as :kevin
+    accounts(:"37s").update_column(:cards_count, 950)
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#plan" do
+      assert_select "h2", text: "Plan"
+      assert_select "strong", text: "Free"
+      assert_select "li", text: /950 of 1,000 cards used/
+      assert_select "form[action=?]", saas.account_subscription_path do
+        assert_select "input[type=radio][name=plan][value=monthly_v1]"
+        assert_select "input[type=radio][name=plan][value=monthly_extra_storage_v1]"
+        assert_select "button", text: "Upgrade"
+      end
+      assert_select "button", text: "Manage billing", count: 0
+    end
+  end
+
+  test "subscribers see their renewal and manage billing" do
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_v1",
+      status: "active", current_period_end: Time.utc(2030, 1, 15))
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_select "#plan" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "p", text: /\$20\/month.\s+Renews on January 15, 2030/
+      assert_select "input[type=radio][value=monthly_extra_storage_v1]"
+      assert_select "input[type=radio][value=monthly_v1]", count: 0
+      assert_select "button", text: "Upgrade"
+      assert_select "form[action=?] button", saas.account_billing_portal_path, text: "Manage billing"
+    end
+  end
+
+  test "the biggest plan has nothing to upgrade to" do
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_extra_storage_v1", status: "active")
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_select "#plan" do
+      assert_select "strong", text: "Unlimited+"
+      assert_select "button", text: "Upgrade", count: 0
+      assert_select "button", text: "Manage billing"
+    end
+  end
+
+  test "members don't see the plan" do
+    sign_in_as :jz
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "#plan", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..74d350e
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    sign_in_as :kevin
+    @account = accounts(:"37s")
+  end
+
+  test "upgrading sends admins to stripe checkout" do
+    Stripe::Customer.expects(:create).returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items] == [ { price: "price_monthly_extra_storage_v1", quantity: 1 } ] &&
+        params[:success_url] == "http://www.example.com#{@account.slug}/account/subscription?session_id={CHECKOUT_SESSION_ID}" &&
+        params[:cancel_url] == "http://www.example.com#{@account.slug}/account/settings#plan"
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/c/pay/cs_123"))
+
+    post saas.account_subscription_path, params: { plan: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_123"
+    assert_response :see_other
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "subscribed accounts change plans in the billing portal" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "monthly_v1", status: "active")
+
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create)
+      .with(has_entries(customer: "cus_123", flow_data: { type: "subscription_update", subscription_update: { subscription: "sub_123" } }))
+      .returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/123"))
+
+    post saas.account_subscription_path, params: { plan: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://billing.stripe.com/p/session/123"
+  end
+
+  test "only paid plans can be chosen" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path, params: { plan: "free_v1" }
+    assert_redirected_to account_settings_path(anchor: "plan")
+
+    post saas.account_subscription_path, params: { plan: "bogus" }
+    assert_redirected_to account_settings_path(anchor: "plan")
+  end
+
+  test "members can't upgrade" do
+    logout_and_sign_in_as :jz
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path, params: { plan: "monthly_v1" }
+
+    assert_response :forbidden
+  end
+
+  test "stripe outages send admins back to settings" do
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("Couldn't connect"))
+
+    post saas.account_subscription_path, params: { plan: "monthly_v1" }
+
+    assert_redirected_to account_settings_path(anchor: "plan")
+    assert_match(/couldn’t reach/, flash[:alert])
+  end
+
+  test "returning from checkout submits itself to record the upgrade" do
+    get saas.account_subscription_path(session_id: "cs_123")
+
+    assert_response :success
