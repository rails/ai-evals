+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,25 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    set_page_and_extract_portion_from matching_accounts.includes(:cancellation, :subscription, :billing_waiver).order(created_at: :desc)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+  end
+
+  private
+    def matching_accounts
+      case query = params[:query].to_s.strip
+      when ""
+        Account.all
+      when /\A\d+\z/
+        Account.where(external_account_id: query)
+      when /@/
+        Account.where(id: User.joins(:identity).where(identities: { email_address: query.downcase }).select(:account_id))
+      else
+        Account.where("accounts.name LIKE ?", "%#{Account.sanitize_sql_like(query)}%")
+      end
+    end
+end
