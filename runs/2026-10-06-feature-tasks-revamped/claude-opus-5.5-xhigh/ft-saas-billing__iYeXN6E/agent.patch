@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts get 1,000 cards" do
+    assert_equal 1_000, @account.card_limit
+
+    @account.update_column :cards_count, 950
+    assert_equal 50, @account.remaining_cards_count
+  end
+
+  test "exceeding the card limit" do
+    @account.update_column :cards_count, 1_001
+    assert @account.exceeding_card_limit?
+
+    @account.update_column :cards_count, 1_000
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "reaching the card limit" do
+    @account.update_column :cards_count, 1_000
+    assert @account.card_limit_reached?
+
+    @account.update_column :cards_count, 999
+    assert_not @account.card_limit_reached?
+  end
+
+  test "nearing the card limit from 100 cards out" do
+    @account.update_column :cards_count, 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 1_000
+    assert @account.nearing_card_limit?
+    assert_equal 0, @account.remaining_cards_count
+
+    @account.update_column :cards_count, 1_001
+    assert_not @account.nearing_card_limit?, "over the limit is more than nearing it"
+    assert_equal 0, @account.remaining_cards_count
+  end
+
+  test "paid plans have no card limit" do
+    @account.comp
+    @account.update_column :cards_count, 1_000_000
+
+    assert_nil @account.card_limit
+    assert_nil @account.remaining_cards_count
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.card_limit_reached?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "an overridden card count stands in for the real one" do
+    @account.update_column :cards_count, 5_000
+    @account.override_limits(card_count: 10)
+
+    assert_not @account.exceeding_card_limit?
+    assert_equal 990, @account.remaining_cards_count
+  end
+end
diff --git a/saas/test/models/account/limit_overridable_test.rb b/saas/test/models/account/limit_overridable_test.rb
new file mode 100644
index 0000000..023b59d
--- /dev/null
+++ b/saas/test/models/account/limit_overridable_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::LimitOverridableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.update_column :cards_count, 1_500
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+  end
+
+  test "billable figures default to the real ones" do
+    assert_equal 1_500, @account.billable_cards_count
+    assert_equal 2.gigabytes, @account.billable_bytes_used
+  end
+
+  test "override either figure" do
+    @account.override_limits(card_count: 100)
+    assert_equal 100, @account.billable_cards_count
+    assert_equal 2.gigabytes, @account.billable_bytes_used
+
+    @account.override_limits(bytes_used: 1.megabyte)
+    assert_equal 1_500, @account.billable_cards_count
+    assert_equal 1.megabyte, @account.billable_bytes_used
+  end
+
+  test "overriding again updates the same record" do
+    @account.override_limits(card_count: 100, bytes_used: 1.megabyte)
+
+    assert_no_difference -> { Account::OverriddenLimits.count } do
+      @account.override_limits(card_count: 200, bytes_used: 2.megabytes)
+    end
+
+    assert_equal 200, @account.reload.billable_cards_count
+    assert_equal 2.megabytes, @account.billable_bytes_used
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 100, bytes_used: 1.megabyte)
+
+    assert_difference -> { Account::OverriddenLimits.count }, -1 do
+      @account.reset_limits
+    end
+
+    assert_nil @account.overridden_limits
+    assert_equal 1_500, @account.billable_cards_count
+    assert_equal 2.gigabytes, @account.billable_bytes_used
+  end
+
+  test "overriding nothing resets" do
+    @account.override_limits(card_count: 100)
+    @account.override_limits(card_count: nil, bytes_used: nil)
+
+    assert_nil @account.overridden_limits
+  end
+
+  test "overrides must be whole, non-negative numbers" do
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: -1) }
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(bytes_used: "lots") }
+  end
+end
