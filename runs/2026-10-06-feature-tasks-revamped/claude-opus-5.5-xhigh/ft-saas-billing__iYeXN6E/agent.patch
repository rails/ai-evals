+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_123")
+  end
+
+  test "sync records the plan, status, and billing dates" do
+    renewal, cancellation = 20.days.from_now.change(usec: 0), 20.days.from_now.change(usec: 0)
+
+    Account::Subscription.sync stripe_subscription(price: "price_monthly_extra_storage_v1", current_period_end: renewal, cancel_at: cancellation)
+
+    @subscription.reload
+    assert_equal "sub_123", @subscription.stripe_subscription_id
+    assert_equal "monthly_extra_storage_v1", @subscription.plan_key
+    assert_equal "active", @subscription.status
+    assert_equal renewal, @subscription.current_period_end
+    assert_equal cancellation, @subscription.cancel_at
+    assert @subscription.canceling?
+    assert_equal Plan[:monthly_extra_storage_v1], @account.reload.plan
+  end
+
+  test "sync reads the billing period from the subscription on older API versions" do
+    renewal = 10.days.from_now.change(usec: 0)
+    attributes = stripe_subscription.to_hash.merge(current_period_end: renewal.to_i)
+    attributes[:items][:data].first.delete(:current_period_end)
+
+    Account::Subscription.sync Stripe::Subscription.construct_from(attributes)
+
+    assert_equal renewal, @subscription.reload.current_period_end
+  end
+
+  test "sync finds the account through subscription metadata" do
+    @subscription.destroy
+
+    Account::Subscription.sync stripe_subscription(customer: "cus_other", metadata: { account_id: @account.id })
+
+    assert_equal "cus_other", @account.reload.subscription.stripe_customer_id
+    assert_equal Plan[:monthly_v1], @account.plan
+  end
+
+  test "sync ignores unknown customers" do
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync stripe_subscription(customer: "cus_unknown")
+    end
+  end
+
+  test "deleted subscriptions put the account back on free" do
+    Account::Subscription.sync stripe_subscription
+    Account::Subscription.sync stripe_subscription(status: "canceled")
+
+    assert_equal "canceled", @subscription.reload.status
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "unknown prices don't grant a plan" do
+    Account::Subscription.sync stripe_subscription(price: "price_unknown")
+
+    assert_not @subscription.reload.active?
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "a second subscription doesn't displace a live one" do
+    Account::Subscription.sync stripe_subscription(id: "sub_123")
+    Account::Subscription.sync stripe_subscription(id: "sub_456", status: "incomplete")
+
+    assert_equal "sub_123", @subscription.reload.stripe_subscription_id
+    assert @subscription.active?
+  end
+
+  test "a second subscription takes over once the first lapses" do
+    Account::Subscription.sync stripe_subscription(id: "sub_123", status: "canceled")
+    Account::Subscription.sync stripe_subscription(id: "sub_456", price: "price_monthly_extra_storage_v1")
+
+    assert_equal "sub_456", @subscription.reload.stripe_subscription_id
+    assert_equal Plan[:monthly_extra_storage_v1], @account.reload.plan
+  end
+
+  test "cancel_now cancels a live subscription in stripe" do
+    Account::Subscription.sync stripe_subscription
+
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+    @subscription.reload.cancel_now
+  end
+
+  test "cancel_now leaves lapsed subscriptions alone" do
+    Account::Subscription.sync stripe_subscription(status: "canceled")
+
+    Stripe::Subscription.expects(:cancel).never
+    @subscription.reload.cancel_now
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..9b05794
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+require_relative "../test_helpers/stripe_test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  test "approved pricing" do
+    assert_plan :free_v1, name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte
+    assert_plan :monthly_v1, name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes
+    assert_plan :monthly_extra_storage_v1, name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes
+  end
+
+  test "only the free plan limits cards" do
+    assert Plan.free.limit_cards?
+    assert Plan.paid.none?(&:limit_cards?)
+  end
+
+  test "paid plans" do
+    assert_equal [ Plan[:monthly_v1], Plan[:monthly_extra_storage_v1] ], Plan.paid
+    assert Plan.free.free?
+    assert Plan[:monthly_v1].paid?
+  end
+
+  test "upgrades bring more storage" do
+    assert_equal [ Plan[:monthly_v1], Plan[:monthly_extra_storage_v1] ], Plan.free.upgrades
+    assert_equal [ Plan[:monthly_extra_storage_v1] ], Plan[:monthly_v1].upgrades
+    assert_not Plan[:monthly_extra_storage_v1].upgradable?
+  end
+
+  test "find by key" do
+    assert_equal Plan[:monthly_v1], Plan.find_by_key("monthly_v1")
+    assert_nil Plan.find_by_key("bogus")
+    assert_nil Plan.find_by_key(nil)
+    assert_raises(ArgumentError) { Plan.find(:bogus) }
+  end
+
+  test "stripe price ids come from the environment" do
+    assert_equal "price_monthly_v1", Plan[:monthly_v1].stripe_price_id
+    assert_equal "price_monthly_extra_storage_v1", Plan[:monthly_extra_storage_v1].stripe_price_id
+    assert_nil Plan.free.stripe_price_id
+  end
+
+  test "find by stripe price id or lookup key" do
+    assert_equal Plan[:monthly_extra_storage_v1], Plan.find_by_stripe_price(Stripe::Price.construct_from(id: "price_monthly_extra_storage_v1"))
+    assert_equal Plan[:monthly_v1], Plan.find_by_stripe_price(Stripe::Price.construct_from(id: "price_other", lookup_key: "monthly_v1"))
+    assert_nil Plan.find_by_stripe_price(Stripe::Price.construct_from(id: "price_other"))
+  end
+
+  private
+    def assert_plan(key, **attributes)
+      plan = Plan[key]
+
+      attributes.each do |attribute, value|
+        if value.nil?
+          assert_nil plan.public_send(attribute), "#{key} #{attribute}"
+        else
+          assert_equal value, plan.public_send(attribute), "#{key} #{attribute}"
+        end
+      end
+    end
+end
diff --git a/saas/test/test_helpers/stripe_test_helper.rb b/saas/test/test_helpers/stripe_test_helper.rb
new file mode 100644
index 0000000..bd53cc1
--- /dev/null
+++ b/saas/test/test_helpers/stripe_test_helper.rb
@@ -0,0 +1,47 @@
+module StripeTestHelper
+  STRIPE_PRICE_IDS = {
+    "STRIPE_MONTHLY_V1_PRICE_ID" => "price_monthly_v1",
+    "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_monthly_extra_storage_v1"
+  }
+
+  def self.included(base)
+    base.setup do
+      @original_stripe_env = ENV.to_h.slice(*STRIPE_PRICE_IDS.keys, "STRIPE_WEBHOOK_SECRET")
+      ENV.update(STRIPE_PRICE_IDS.merge("STRIPE_WEBHOOK_SECRET" => "whsec_test"))
+    end
+
+    base.teardown do
+      (STRIPE_PRICE_IDS.keys + [ "STRIPE_WEBHOOK_SECRET" ]).each { |key| ENV.delete(key) }
+      ENV.update(@original_stripe_env)
+    end
+  end
+
+  private
+    def stripe_subscription(id: "sub_123", customer: "cus_123", status: "active", price: "price_monthly_v1", current_period_end: 1.month.from_now, cancel_at: nil, metadata: {})
+      Stripe::Subscription.construct_from(stripe_subscription_attributes(id:, customer:, status:, price:, current_period_end:, cancel_at:, metadata:))
+    end
+
+    def stripe_subscription_attributes(id:, customer:, status:, price:, current_period_end:, cancel_at:, metadata:)
+      {
+        id: id,
+        object: "subscription",
+        customer: customer,
+        status: status,
+        cancel_at: cancel_at&.to_i,
+        metadata: metadata,
+        items: {
+          object: "list",
+          data: [ { id: "si_123", object: "subscription_item", current_period_end: current_period_end.to_i, price: { id: price, object: "price" } } ]
+        }
+      }
+    end
+
+    def stripe_event_payload(type, object)
+      { id: "evt_123", object: "event", type: type, created: Time.now.to_i, data: { object: object } }.to_json
+    end
+
+    def stripe_signature_for(payload, secret: ENV["STRIPE_WEBHOOK_SECRET"], timestamp: Time.now)
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+      Stripe::Webhook::Signature.generate_header(timestamp, signature)
+    end
+end
