+require "test_helper"
+require_relative "../../test_helpers/stripe_test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan" do
+    assert_equal Plan.free, @account.plan
+    assert_nil @account.active_subscription
+  end
+
+  test "an active subscription sets the plan" do
+    subscribe @account, to: :monthly_extra_storage_v1
+
+    assert_equal Plan[:monthly_extra_storage_v1], @account.plan
+    assert_equal @account.subscription, @account.active_subscription
+  end
+
+  test "lapsed subscriptions fall back to free" do
+    %w[ canceled unpaid incomplete incomplete_expired paused ].each do |status|
+      subscribe @account, to: :monthly_v1, status: status
+
+      assert_equal Plan.free, @account.reload.plan, status
+      assert_nil @account.active_subscription, status
+    end
+  end
+
+  test "payment retries keep the plan" do
+    subscribe @account, to: :monthly_v1, status: "past_due"
+
+    assert_equal Plan[:monthly_v1], @account.plan
+  end
+
+  test "comp and uncomp" do
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.comped, @account.plan
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "a comped account keeps a bigger paid plan" do
+    subscribe @account, to: :monthly_extra_storage_v1
+    @account.comp
+
+    assert_equal Plan[:monthly_extra_storage_v1], @account.plan
+  end
+
+  test "comps from queenbee are ignored" do
+    @account.comped = true
+
+    assert_not @account.comped?
+  end
+
+  test "checkout creates a stripe customer once and returns the checkout url" do
+    Stripe::Customer.expects(:create).once
+      .with(name: @account.name, email: "mike@37signals.com", metadata: { account_id: @account.id, queenbee_id: @account.external_account_id })
+      .returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).twice.with do |params|
+      params[:mode] == "subscription" && params[:customer] == "cus_new" && params[:client_reference_id] == @account.id &&
+        params[:line_items] == [ { price: "price_monthly_v1", quantity: 1 } ] && params[:subscription_data] == { metadata: { account_id: @account.id } }
+    end.returns(Stripe::Checkout::Session.construct_from(id: "cs_123", url: "https://checkout.stripe.com/c/pay/cs_123"))
+
+    2.times do
+      assert_equal "https://checkout.stripe.com/c/pay/cs_123",
+        @account.stripe_checkout_url(plan: Plan[:monthly_v1], email: "mike@37signals.com", success_url: "https://example.com/done", cancel_url: "https://example.com/back")
+    end
+
+    assert_equal "cus_new", @account.subscription.stripe_customer_id
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "billing portal can jump straight to changing plans" do
+    subscribe @account, to: :monthly_v1
+
+    Stripe::BillingPortal::Session.expects(:create)
+      .with({ customer: "cus_123", return_url: "https://example.com/back", flow_data: { type: "subscription_update", subscription_update: { subscription: "sub_123" } } })
+      .returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session/123"))
+
+    assert_equal "https://billing.stripe.com/p/session/123", @account.stripe_billing_portal_url(return_url: "https://example.com/back", change_plan: true)
+  end
+
+  test "syncing a returning checkout session" do
+    Stripe::Checkout::Session.expects(:retrieve).with(id: "cs_123", expand: [ "subscription" ])
+      .returns(Stripe::Checkout::Session.construct_from(id: "cs_123", client_reference_id: @account.id, subscription: stripe_subscription_attributes_for_checkout))
+
+    @account.sync_stripe_checkout("cs_123")
+
+    assert_equal Plan[:monthly_v1], @account.reload.plan
+  end
+
+  test "checkout sessions for other accounts are ignored" do
+    Stripe::Checkout::Session.expects(:retrieve)
+      .returns(Stripe::Checkout::Session.construct_from(id: "cs_123", client_reference_id: accounts(:"37s").id, subscription: stripe_subscription_attributes_for_checkout))
+
+    @account.sync_stripe_checkout("cs_123")
+
+    assert_nil @account.reload.subscription
+  end
+
+  test "cancelling the account cancels its subscription" do
+    subscribe @account, to: :monthly_v1
+
+    assert_enqueued_with job: Account::Subscription::CancelJob, args: [ @account.subscription ] do
+      @account.cancel(initiated_by: users(:mike))
+    end
+
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+    perform_enqueued_jobs only: Account::Subscription::CancelJob
+  end
+
+  test "cancelling a free account leaves stripe alone" do
+    assert_no_enqueued_jobs only: Account::Subscription::CancelJob do
+      @account.cancel(initiated_by: users(:mike))
+    end
+  end
+
+  test "incinerating the account removes its billing records" do
+    subscribe @account, to: :monthly_v1
+    @account.comp
+    @account.override_limits(card_count: 1)
+
+    @account.incinerate
+
+    assert_empty Account::Subscription.where(account_id: @account.id)
+    assert_empty Account::BillingWaiver.where(account_id: @account.id)
+    assert_empty Account::OverriddenLimits.where(account_id: @account.id)
+  end
+
+  private
+    def subscribe(account, to:, status: "active")
+      (account.subscription || account.build_subscription(stripe_customer_id: "cus_123"))
+        .update!(plan_key: to, status: status, stripe_subscription_id: "sub_123", current_period_end: 1.month.from_now)
+    end
+
+    def stripe_subscription_attributes_for_checkout
+      stripe_subscription_attributes(id: "sub_123", customer: "cus_123", status: "active", price: "price_monthly_v1",
+        current_period_end: 1.month.from_now, cancel_at: nil, metadata: { account_id: @account.id })
+    end
+end
