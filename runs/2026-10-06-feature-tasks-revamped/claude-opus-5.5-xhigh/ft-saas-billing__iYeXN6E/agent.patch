+module BillingHelper
+  def plan_allowance(plan)
+    cards = plan.limit_cards? ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards"
+    "#{cards}, #{number_to_human_size(plan.storage_limit)} of storage"
+  end
+
+  def plan_price(plan)
+    plan.free? ? "Free" : "#{number_to_currency(plan.price, precision: 0)}/month"
+  end
+
+  def cards_left(account)
+    if account.remaining_cards_count.zero?
+      "No cards left after this one"
+    else
+      "#{pluralize(number_with_delimiter(account.remaining_cards_count), "card")} left"
+    end
+  end
+
+  def stripe_dashboard_url(path)
+    test_mode = ENV["STRIPE_SECRET_KEY"].to_s.start_with?("sk_test_")
+    "https://dashboard.stripe.com/#{"test/" if test_mode}#{path}"
+  end
+end
