+<% if Current.user.admin? %>
+  <% plan, subscription = account.plan, account.active_subscription %>
+
+  <section id="plan" class="settings__section">
+    <header>
+      <h2 class="divider">Plan</h2>
+      <div>
+        This account is on the <strong><%= plan.name %></strong> plan<%= " (complimentary)" if account.comped? && !subscription %>:
+        <%= plan_allowance(plan).downcase_first %>.
+      </div>
+    </header>
+
+    <ul class="list-unindented margin-none txt-small">
+      <li>
+        <% if plan.limit_cards? %>
+          <%= number_with_delimiter(account.billable_cards_count) %> of <%= number_with_delimiter(plan.card_limit) %> cards used
+        <% else %>
+          <%= pluralize(number_with_delimiter(account.billable_cards_count), "card") %>
+        <% end %>
+      </li>
+      <li><%= number_to_human_size(account.billable_bytes_used) %> of <%= number_to_human_size(account.storage_limit) %> storage used</li>
+    </ul>
+
+    <% if subscription %>
+      <p class="txt-small">
+        <%= plan_price(plan) %>.
+        <% if subscription.past_due? %>
+          <strong class="txt-negative">Your last payment didn’t go through.</strong> Update your payment details to keep this plan.
+        <% elsif subscription.canceling? %>
+          Your plan ends on <%= subscription.cancel_at.to_date.to_fs(:long) %>.
+        <% elsif subscription.current_period_end %>
+          Renews on <%= subscription.current_period_end.to_date.to_fs(:long) %>.
+        <% end %>
+      </p>
+    <% end %>
+
+    <% if plan.upgradable? %>
+      <%= form_with url: saas.account_subscription_path(script_name: account.slug), class: "flex flex-column gap-half", data: { turbo: false } do |form| %>
+        <% plan.upgrades.each_with_index do |upgrade, index| %>
+          <label class="flex gap-half align-center txt-align-start">
+            <%= form.radio_button :plan, upgrade.key, checked: index.zero? %>
+            <span><strong><%= upgrade.name %></strong>, <%= plan_price(upgrade) %>: <%= plan_allowance(upgrade).downcase_first %></span>
+          </label>
+        <% end %>
+
+        <div><%= form.button "Upgrade", class: "btn btn--link" %></div>
+      <% end %>
+    <% end %>
+
+    <% if account.subscription %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: account.slug), class: "btn", form: { data: { turbo: false } } %>
+    <% end %>
+  </section>
+<% end %>
