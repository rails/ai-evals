+class Account::Subscription::CancelJob < ApplicationJob
+  queue_as :backend
+
+  retry_on Stripe::APIConnectionError, Stripe::RateLimitError, wait: :polynomially_longer
+  discard_on Stripe::InvalidRequestError, report: true
+  discard_on ActiveJob::DeserializationError
+
+  def perform(subscription)
+    subscription.cancel_now
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..7ea28af
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,82 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, -> { subscription&.cancel_later }
+  end
+
+  def plan
+    active_subscription&.plan || (Plan.comped if comped?) || Plan.free
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  def stripe_checkout_url(plan:, email:, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(
+      mode: "subscription",
+      customer: stripe_customer_id(email: email),
+      client_reference_id: id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      subscription_data: { metadata: { account_id: id } },
+      success_url: success_url,
+      cancel_url: cancel_url
+    ).url
+  end
+
+  # Plan changes on an existing subscription go through the portal's own plan picker,
+  # so Stripe handles proration and confirmation.
+  def stripe_billing_portal_url(return_url:, change_plan: false)
+    params = { customer: subscription.stripe_customer_id, return_url: return_url }
+    params[:flow_data] = plan_change_flow if change_plan && active_subscription
+
+    Stripe::BillingPortal::Session.create(params).url
+  end
+
+  # Admins usually make it back from checkout before Stripe's webhook does.
+  # Syncing then means the account shows its new plan straight away.
+  def sync_stripe_checkout(checkout_session_id)
+    checkout_session = Stripe::Checkout::Session.retrieve(id: checkout_session_id, expand: [ "subscription" ])
+
+    if checkout_session.client_reference_id == id && checkout_session.subscription.respond_to?(:status)
+      sync_stripe_subscription(checkout_session.subscription)
+    end
+  end
+
+  def sync_stripe_subscription(stripe_subscription)
+    (subscription || create_subscription!(stripe_customer_id: stripe_subscription.customer)).sync(stripe_subscription)
+  end
+
+  private
+    def stripe_customer_id(email:)
+      (subscription || create_subscription!(stripe_customer_id: create_stripe_customer(email: email).id)).stripe_customer_id
+    rescue ActiveRecord::RecordNotUnique
+      # Lost a race with another checkout for this account; use the customer it made
+      reload_subscription.stripe_customer_id
+    end
+
+    def create_stripe_customer(email:)
+      Stripe::Customer.create(name: name, email: email, metadata: { account_id: id, queenbee_id: external_account_id })
+    end
+
+    def plan_change_flow
+      { type: "subscription_update", subscription_update: { subscription: subscription.stripe_subscription_id } }
+    end
+end
