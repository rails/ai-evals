diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..c502787
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_not_includes Board.published, @board
+  end
+
+  test "publish" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+    assert_includes Board.published, @board
+  end
+
+  test "publishing an already published board keeps the same key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublish" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_not @board.reload.published?
+  end
+
+  test "unpublishing a board that isn't published does nothing" do
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "republishing generates a new key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_key, @board.publication.key
+  end
+
+  test "publishing and unpublishing touches the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      travel 1.minute do
+        @board.publish
+      end
+    end
+
+    assert_changes -> { @board.reload.updated_at } do
+      travel 2.minutes do
+        @board.unpublish
+      end
+    end
+  end
+
+  test "find by published key" do
+    @board.publish
+
+    assert_equal @board, Board.find_by_published_key(@board.publication.key)
+    assert_equal @board, Board.find_by_published_key!(@board.publication.key)
+  end
+
+  test "find by published key is scoped" do
+    @board.publish
+
+    assert_equal @board, accounts("37s").boards.find_by_published_key(@board.publication.key)
+    assert_nil accounts(:initech).boards.find_by_published_key(@board.publication.key)
+  end
+
+  test "find by published key when the key is unknown" do
+    assert_nil Board.find_by_published_key("unknown")
+    assert_nil Board.find_by_published_key(nil)
+
+    assert_raises ActiveRecord::RecordNotFound do
+      Board.find_by_published_key!("unknown")
+    end
+  end
+
+  test "find by published key raises once the board is unpublished" do
+    @board.publish
+    key = @board.publication.key
+    @board.unpublish
+
+    assert_raises ActiveRecord::RecordNotFound do
+      Board.find_by_published_key!(key)
+    end
+  end
+
+  test "publications use the key as their param" do
+    @board.publish
+
+    assert_equal @board.publication.key, @board.publication.to_param
+  end
+
+  test "publicly accessible only when published" do
+    assert_not @board.publicly_accessible?
+
+    @board.publish
+    assert @board.publicly_accessible?
+  end
+
+  test "published cards on published boards are publicly accessible" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+
+    @board.publish
+    assert card.reload.publicly_accessible?
+  end
+
+  test "drafted cards on published boards are not publicly accessible" do
+    card = @board.cards.create!(title: "Draft", status: :drafted, creator: users(:david))
+    @board.publish
+
+    assert_not card.publicly_accessible?
+  end
+
+  test "destroying the board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+end
