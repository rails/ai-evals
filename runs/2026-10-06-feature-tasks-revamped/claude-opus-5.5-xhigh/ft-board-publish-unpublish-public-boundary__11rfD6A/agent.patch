+require "application_system_test_case"
+
+class BoardPublicationTest < ApplicationSystemTestCase
+  test "publishing a board and browsing it publicly" do
+    board = boards(:writebook)
+    sign_in_as(users(:kevin))
+
+    visit edit_board_url(board)
+    find("label[for='#{dom_id(board, :publication_switch)}']").click
+
+    assert_selector "input[readonly][id='#{dom_id(board, :public_url)}']"
+    public_url = find("##{dom_id(board, :public_url)}").value
+    assert board.reload.published?
+    assert_equal published_board_url(board), public_url
+
+    Capybara.reset_session!
+
+    visit public_url
+    assert_selector "h1", text: "Writebook"
+    assert_selector "#maybe h3", text: "Buy domain"
+
+    # Lazily loaded columns
+    within "##{dom_id(columns(:writebook_in_progress))}" do
+      find(".cards__expander").click
+      assert_selector "h3", text: "The text is too small"
+    end
+
+    find("#maybe article", text: "Buy domain").click
+    assert_selector "h1.card__title", text: "Buy domain"
+    assert_current_path published_card_path(cards(:buy_domain))
+
+    click_on "Back to Writebook"
+    assert_selector "h1", text: "Writebook"
+  end
+
+  test "unpublishing a board" do
+    board = boards(:writebook)
+    board.publish
+    public_url = published_board_url(board)
+
+    sign_in_as(users(:kevin))
+    visit edit_board_url(board)
+    find("label[for='#{dom_id(board, :publication_switch)}']").click
+
+    assert_no_selector "##{dom_id(board, :public_url)}"
+    assert_not board.reload.published?
+
+    Capybara.reset_session!
+    visit public_url
+    assert_no_selector "h1", text: "Writebook"
+  end
+end
