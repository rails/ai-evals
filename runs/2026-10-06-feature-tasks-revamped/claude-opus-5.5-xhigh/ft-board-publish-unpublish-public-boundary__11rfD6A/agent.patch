diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..9716d4c
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,27 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+    <p class="margin-none-block-start">Share a read-only version of this board with anyone who has the link. They won’t need a Fizzy account to see it.</p>
+
+    <%= form_with url: board_publication_path(board), method: board.published? ? :delete : :post, class: "flex align-center justify-center gap-half", data: { controller: "form" } do %>
+      <label for="<%= dom_id(board, :publication_switch) %>" class="switch">
+        <%= check_box_tag :published, "1", board.published?, id: dom_id(board, :publication_switch), class: "switch__input",
+              disabled: !Current.user.can_administer_board?(board), data: { action: "change->form#submit" } %>
+        <span class="switch__btn round"></span>
+        <span class="for-screen-reader"><%= board.published? ? "Turn off the public link" : "Turn on the public link" %></span>
+      </label>
+      <strong><%= board.published? ? "On" : "Off" %></strong>
+    <% end %>
+
+    <% if board.published? %>
+      <% url = published_board_url(board) %>
+      <div class="flex align-center gap-half margin-block-start-half">
+        <input type="text" class="input txt-small flex-item-grow" id="<%= dom_id(board, :public_url) %>" value="<%= url %>" aria-label="Public link to this board" readonly>
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+<% end %>
