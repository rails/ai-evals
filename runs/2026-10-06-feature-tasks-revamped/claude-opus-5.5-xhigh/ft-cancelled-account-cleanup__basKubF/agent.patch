diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..416c4b7
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.cancel(initiated_by: users(:david))
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    travel 31.days
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id), "active accounts are kept"
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    travel 29.days
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..cccbbb9
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 29.days
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel 2.days
+    assert_includes Account.due_for_incineration, @account
+    assert_not_includes Account.due_for_incineration, accounts(:initech)
+  end
+
+  test "incinerate_all_due only incinerates due accounts" do
+    @account.cancel(initiated_by: @user)
+    travel 31.days
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_all_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "incinerate_all_due carries on past accounts that fail to incinerate" do
+    @account.cancel(initiated_by: @user)
+    accounts(:initech).cancel(initiated_by: users(:mike))
+    travel 31.days
+
+    assert_equal 2, Account.due_for_incineration.count
+    Account.any_instance.expects(:incinerate).twice.raises(RuntimeError, "boom").then.returns(true)
+
+    assert_error_reported(RuntimeError) do
+      Account.incinerate_all_due
+    end
+  end
+
+  test "incinerate deletes everything in the account" do
+    other_account_counts = account_scoped_counts(accounts(:initech))
+    add_data_not_covered_by_fixtures
+    @account.cancel(initiated_by: @user)
+
+    assert account_scoped_counts(@account).values.sum.positive?
+
+    perform_enqueued_jobs do
+      @account.incinerate
+    end
+
+    assert @account.destroyed?
+    assert_empty account_scoped_counts(@account).select { |_table, count| count.positive? }
+    assert_equal other_account_counts, account_scoped_counts(accounts(:initech))
+  end
+
+  test "incinerate does nothing to active accounts" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    @account.cancel(initiated_by: @user)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing when the account was reactivated after being picked up" do
+    @account.cancel(initiated_by: @user)
+    travel 31.days
+
+    picked_up = Account.due_for_incineration.find(@account.id)
+    assert picked_up.cancelled?
+
+    Account.find(@account.id).reactivate
+
+    assert_no_difference -> { Account.count } do
+      picked_up.incinerate
+    end
+  end
+
+  private
+    def add_data_not_covered_by_fixtures
+      card = cards(:logo)
+      card.image.attach io: StringIO.new("x" * 1024), filename: "image.png", content_type: "image/png"
+      card.update!(description: "Searchable description")
+      card.create_not_now!(user: @user)
+      card.create_activity_spike!
+      boards(:writebook).publish
+      @user.notification_bundles.create!
+      @user.search_queries.create!(terms: "logo")
+      @account.imports.create!(identity: identities(:david), status: :completed)
+      @account.materialize_storage
+
+      # Direct upload that never got attached to anything
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan"), filename: "orphan.txt")
+    end
+
+    def account_scoped_counts(account)
+      account_scoped_tables.index_with do |table|
+        Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: account.id).count
+      end
+    end
+
+    def account_scoped_tables
+      connection = ApplicationRecord.connection
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }
+    end
+end
