diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..b599537 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,47 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+
+    define_callbacks :incinerate
+  end
+
+  class_methods do
+    def incinerate_all_due
+      due_for_incineration.find_each do |account|
+        account.incinerate
+      rescue => error
+        Rails.error.report(error, context: { account_id: account.id })
+      end
+    end
+  end
+
+  # Permanently deletes the account and everything in it. Only cancelled accounts are
+  # incinerated, and the lock makes sure a reactivation racing with this always wins.
+  def incinerate
+    with_lock do
+      if cancelled?
+        run_callbacks :incinerate do
+          purge_unattached_blobs
+          destroy!
+          delete_storage_entries
+        end
+      end
+    end
+  end
+
+  private
+    # Attached blobs get purged when their attachments are destroyed along with the account.
+    # This catches the rest, like direct uploads that were never attached to anything.
+    def purge_unattached_blobs
+      ActiveStorage::Blob.unattached.where(account: self).find_each(&:purge_later)
+    end
+
+    # Not a dependent association because boards share the ledger with their account.
+    def delete_storage_entries
+      Storage::Entry.where(account: self).delete_all
+    end
 end
