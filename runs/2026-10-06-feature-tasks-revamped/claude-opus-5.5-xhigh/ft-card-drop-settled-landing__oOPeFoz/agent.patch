+  end
+
+  test "create" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: columns(:writebook_triage), to: column do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_card_refreshed_in_place card, dropped_in: dom_id(column)
+  end
+
+  test "create with a done card reopens it" do
+    card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    assert_changes -> { card.reload.closed? }, from: true, to: false do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_equal column, card.column
+  end
+
+  test "create with a column from another board" do
+    column = boards(:private).columns.create!(name: "Elsewhere")
+
+    post columns_card_drops_column_path(cards(:logo), column_id: column), as: :turbo_stream
+
+    assert_response :not_found
+    assert_equal columns(:writebook_triage), cards(:logo).reload.column
+  end
+
+  test "create with an inaccessible card" do
+    card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin))
+    column = boards(:private).columns.create!(name: "Elsewhere")
+    logout_and_sign_in_as :david
+
+    post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+
+    assert_response :not_found
+    assert_nil card.reload.column
+  end
+
+  private
+    def assert_card_refreshed_in_place(card, dropped_in:)
+      assert_turbo_stream action: :replace, targets: "##{dropped_in} ##{dom_id(card, :article)}"
+      assert_select "turbo-stream", count: 1
+    end
+end
