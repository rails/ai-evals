diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..5b29cda
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,206 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+
+// Stands in for the dropped card in containers' drop urls (see ColumnsHelper#dropped_card_placeholder)
+const DROPPED_CARD_PLACEHOLDER = "__card__"
+const DRAG_DATA_TYPE = "application/x-fizzy-card"
+
+// Moves cards between columns. Dropping a card updates the board on the spot, as the server will have it
+// once saved, and saves in the background. Columns keep their own order, so cards can't be dropped
+// where they already are.
+export default class extends Controller {
+  static targets = [ "item", "container", "count" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #draggedItem
+  #sourceContainer
+  #saves = Promise.resolve()
+
+  // Actions
+
+  dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item) return
+
+    if (!this.#isDesktop) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    this.#sourceContainer = this.#containerContaining(item)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData(DRAG_DATA_TYPE, item.dataset.dragAndDropCardNumber)
+    }
+
+    // Dim the card once the browser has taken its picture for the drag image
+    requestAnimationFrame(() => {
+      if (this.#draggedItem === item) item.classList.add(this.draggedItemClass)
+    })
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#containerContaining(event.target)
+
+    if (this.#canDropInto(container)) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const container = this.#containerContaining(event.target)
+
+    if (item && this.#canDropInto(container)) {
+      event.preventDefault()
+
+      this.#move(item, this.#sourceContainer, container)
+      this.#save(item, container)
+    }
+
+    this.dragEnd()
+  }
+
+  dragEnd() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+
+    this.#draggedItem = null
+    this.#sourceContainer = null
+  }
+
+  // Morphs from refreshes mid-drag would otherwise drop the class that dims the card
+  keepDraggedItemDimmed(event) {
+    if (event.target === this.#draggedItem && event.detail.attributeName === "class") {
+      event.preventDefault()
+    }
+  }
+
+  // Private
+
+  #move(item, from, to) {
+    this.#place(item, to)
+    this.#restyle(item, to)
+    this.#changeCount(from, -1)
+    this.#changeCount(to, +1)
+  }
+
+  // Put the card where the server lists it once moved. The move makes it the most recently active card,
+  // so it goes first, though behind golden cards in places that keep those on top.
+  #place(item, container) {
+    const items = this.#itemsIn(container)
+    const behindGolden = container.dataset.dragAndDropGoldenFirst === "true" && !this.#isGolden(item)
+    const nextItem = behindGolden ? items.find(other => !this.#isGolden(other)) : items[0]
+
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length > 0) {
+      items.at(-1).after(item)
+    } else {
+      this.#placeInEmpty(item, container)
+    }
+  }
+
+  #placeInEmpty(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      list.prepend(item)
+    } else {
+      // Its cards haven't loaded yet: they will show it once saved
+      item.remove()
+    }
+  }
+
+  // Give the card the look of its new place. Leaving Not Now or Done, it sheds what colors it as complete.
+  #restyle(item, container) {
+    item.style.setProperty("--card-color", container.dataset.dragAndDropCardColor)
+    item.classList.remove("card--postponed")
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+  }
+
+  #changeCount(container, change) {
+    const counter = this.countTargets.find(counter => container?.contains(counter))
+
+    if (counter) {
+      const count = Math.max(0, Number(counter.dataset.count) + change)
+      counter.dataset.count = count
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  // Saves go one after another, so the server applies moves in the order they were made
+  #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace(DROPPED_CARD_PLACEHOLDER, item.dataset.dragAndDropCardNumber)
+
+    this.#saves = this.#saves.then(async () => {
+      if (await this.#submit(url)) {
+        if (!item.isConnected) container.querySelector("turbo-frame")?.reload()
+      } else {
+        this.#resync()
+      }
+    })
+  }
+
+  async #submit(url) {
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      return response.ok && !response.redirected
+    } catch {
+      return false
+    }
+  }
+
+  // The board shows a move that didn't happen: bring back what the server has
+  #resync() {
+    if (this.element.isConnected) {
+      Turbo.visit(window.location.href, { action: "replace" })
+    }
+  }
+
+  #canDropInto(container) {
+    return container && container !== this.#sourceContainer
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => each.classList.toggle(this.hoverContainerClass, each === container))
+  }
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #itemsIn(container) {
+    return this.itemTargets.filter(item => container.contains(item))
+  }
+
+  #isGolden(item) {
+    return item.dataset.dragAndDropGolden === "true"
+  }
+
+  get #isDesktop() {
+    return window.matchMedia(this.desktopBreakpointValue).matches
+  }
+}
