diff --git a/test/controllers/columns/cards/drops/closures_controller_test.rb b/test/controllers/columns/cards/drops/closures_controller_test.rb
new file mode 100644
index 0000000..dccb423
--- /dev/null
+++ b/test/controllers/columns/cards/drops/closures_controller_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ClosuresControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, targets: "#closed-cards ##{dom_id(card, :article)}"
+  end
+
+  test "create with a postponed card" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_not card.postponed?
+  end
+end
