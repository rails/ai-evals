diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..4b0bac2
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,176 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    visit_board
+  end
+
+  test "dragging a card into another column" do
+    find_card(cards(:buy_domain)).drag_to find_column(columns(:writebook_in_progress))
+
+    assert_selector "##{dom_id(columns(:writebook_in_progress))} ##{dom_id(cards(:buy_domain), :article)}", visible: :all
+    assert_count "maybe", 0
+    assert_count dom_id(columns(:writebook_in_progress)), 2
+    assert_saved { cards(:buy_domain).reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "the board changes the moment a card is dropped, without waiting on the save" do
+    column = columns(:writebook_triage)
+
+    cards_in_column_on_drop = drop cards(:buy_domain), into: "##{dom_id(column)}"
+
+    assert_equal ids_of(cards(:logo), cards(:buy_domain), cards(:layout)), cards_in_column_on_drop, "lands behind golden cards, as the column lists it"
+    assert_count dom_id(column), 3
+    assert_saved { cards(:buy_domain).reload.column == column }
+  end
+
+  test "nothing shifts once the move is saved" do
+    column = columns(:writebook_triage)
+    drop cards(:buy_domain), into: "##{dom_id(column)}"
+    cards_in_column_on_drop = card_ids_in("##{dom_id(column)}")
+    assert_saved { cards(:buy_domain).reload.column == column }
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_no_changes -> { card_ids_in("##{dom_id(column)}") } do
+      sleep 0.5
+    end
+    assert_equal cards_in_column_on_drop, card_ids_in("##{dom_id(column)}")
+
+    visit_board
+    assert_equal cards_in_column_on_drop, card_ids_in("##{dom_id(column)}")
+    assert_count dom_id(column), 3
+  end
+
+  test "dragging a card to done, not now and back" do
+    card = cards(:layout)
+
+    drop card, into: "#closed-cards"
+    assert_saved { card.reload.closed? }
+
+    drop card, into: "#not-now"
+    assert_saved { card.reload.postponed? }
+
+    drop card, into: "#maybe"
+    assert_saved { card.reload.awaiting_triage? }
+  end
+
+  test "a done card dragged into a column looks like it belongs there right away" do
+    card, column = cards(:shipping), columns(:writebook_in_progress)
+
+    drop card, into: "##{dom_id(column)}"
+
+    assert_equal column.color.to_s, card_style(card, "--card-color")
+    assert_no_selector "##{dom_id(card, :article)} .card__closed", visible: :all
+    assert_saved { card.reload.open? && card.column == column }
+  end
+
+  test "a card can't be dropped where it already is" do
+    cards_in_maybe = card_ids_in("#maybe")
+
+    drop cards(:buy_domain), into: "#maybe"
+
+    assert_equal cards_in_maybe, card_ids_in("#maybe")
+    assert_count "maybe", 1
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    card, column = cards(:buy_domain), columns(:writebook_review)
+
+    start_dragging card
+    drag_over "##{dom_id(column)}"
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    drag_over "#maybe"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    stop_dragging card
+    assert_no_selector ".drag-and-drop__dragged-item"
+  end
+
+  test "a move that fails to save is undone" do
+    Card.any_instance.stubs(:triage_into).raises(ActiveRecord::RecordNotFound)
+
+    drop cards(:buy_domain), into: "##{dom_id(columns(:writebook_review))}"
+
+    assert_selector "#maybe ##{dom_id(cards(:buy_domain), :article)}"
+    assert_count "maybe", 1
+  end
+
+  private
+    def visit_board
+      visit board_url(boards(:writebook))
+      assert_selector ".card-columns turbo-frame[src][complete]", visible: :all, count: boards(:writebook).columns.count + 2
+    end
+
+    def find_card(card)
+      find("##{dom_id(card, :article)}")
+    end
+
+    def find_column(column)
+      find("##{dom_id(column)}")
+    end
+
+    # Drops the card in a single go, returning the cards in the place it was dropped right after:
+    # no response can arrive in the meantime.
+    def drop(card, into:)
+      page.evaluate_script(<<~JS, dom_id(card, :article), into)
+        ((cardId, selector) => {
+          const card = document.getElementById(cardId)
+          const container = document.querySelector(selector)
+          const options = { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }
+
+          card.dispatchEvent(new DragEvent("dragstart", options))
+          container.dispatchEvent(new DragEvent("dragenter", options))
+          if (!container.dispatchEvent(new DragEvent("dragover", options))) container.dispatchEvent(new DragEvent("drop", options))
+          card.dispatchEvent(new DragEvent("dragend", options))
+
+          return Array.from(container.querySelectorAll("article.card"), card => card.id)
+        })(...arguments)
+      JS
+    end
+
+    def start_dragging(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        window.testDataTransfer = new DataTransfer()
+        document.getElementById(arguments[0]).dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }))
+      JS
+    end
+
+    def drag_over(selector)
+      page.execute_script(<<~JS, selector)
+        document.querySelector(arguments[0]).dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }))
+      JS
+    end
+
+    def stop_dragging(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        document.getElementById(arguments[0]).dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: window.testDataTransfer }))
+      JS
+    end
+
+    def card_ids_in(selector)
+      page.evaluate_script("Array.from(document.querySelectorAll(arguments[0] + ' article.card'), card => card.id)", selector)
+    end
+
+    def ids_of(*cards)
+      cards.map { dom_id(it, :article) }
+    end
+
+    def card_style(card, property)
+      page.evaluate_script("document.getElementById(arguments[0]).style.getPropertyValue(arguments[1])", dom_id(card, :article), property)
+    end
+
+    def assert_count(column_id, count)
+      assert_selector "##{column_id} .cards__expander-count", text: /\A#{count}\z/, visible: :all
+    end
+
+    def assert_saved(timeout: Capybara.default_max_wait_time)
+      deadline = Time.current + timeout
+      sleep 0.05 until yield || Time.current > deadline
+      assert yield, "Expected the move to be saved"
+    end
+end
