+require "test_helper"
+
+class Public::Boards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show" do
+    get public_board_column_path(@board.publication, columns(:writebook_in_progress))
+
+    assert_response :success
+    assert_includes response.body, cards(:text).title
+    assert_select ".card__title", text: cards(:logo).title, count: 0
+    assert_select "a[href=?]", public_board_card_path(@board.publication, cards(:text))
+  end
+
+  test "show is not found for columns from other boards" do
+    other_board = boards(:private)
+    column = other_board.columns.create!(name: "Elsewhere")
