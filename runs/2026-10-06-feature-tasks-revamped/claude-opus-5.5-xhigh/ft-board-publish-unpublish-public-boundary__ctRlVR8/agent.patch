+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publish" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+  end
+
+  test "publishing an already published board keeps its key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublish" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_not @board.reload.published?
+  end
+
+  test "unpublishing a board that is not published does nothing" do
+    assert_no_difference -> { Board::Publication.count } do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "republishing generates a new key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_key, @board.publication.key
+  end
+
+  test "published scope" do
+    @board.publish
+
+    assert_includes Board.published, @board
+    assert_not_includes Board.published, boards(:private)
+  end
+
+  test "find by published key" do
+    @board.publish
+
+    assert_equal @board, Board.find_by_published_key(@board.publication.key)
+    assert_equal @board, accounts("37s").boards.find_by_published_key(@board.publication.key)
+  end
+
+  test "find by published key is scoped" do
+    @board.publish
+
+    assert_raises(ActiveRecord::RecordNotFound) { accounts(:initech).boards.find_by_published_key(@board.publication.key) }
+    assert_raises(ActiveRecord::RecordNotFound) { Board.find_by_published_key("missing") }
+    assert_raises(ActiveRecord::RecordNotFound) { Board.find_by_published_key(nil) }
+  end
+
+  test "publishing touches the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      travel 1.minute do
+        @board.publish
+      end
+    end
+  end
+
+  test "destroying the board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "published cards are publicly accessible only while the board is published" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+
+    @board.publish
+    assert card.reload.publicly_accessible?
+
+    @board.unpublish
+    assert_not card.reload.publicly_accessible?
+  end
+
+  test "drafted cards are not publicly accessible" do
+    @board.publish
+    card = @board.cards.create!(title: "Draft", creator: users(:david), status: :drafted)
+
+    assert_not card.publicly_accessible?
+  end
+end
