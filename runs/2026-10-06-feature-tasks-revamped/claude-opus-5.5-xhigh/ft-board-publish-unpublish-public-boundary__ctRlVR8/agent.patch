+    assert_select ".card__title", text: cards(:logo).title
+  end
+
+  test "show the closed column" do
+    get public_board_columns_closed_path(@board.publication)
+
+    assert_response :success
+    assert_includes response.body, cards(:shipping).title
+  end
+end
