diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..c99dfba
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,38 @@
+<%= tag.div id: dom_id(board, :publication), class: "margin-block-end" do %>
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <% url = public_board_url(board.publication) %>
+
+    <p class="margin-none-block-start">Anyone with this link can see this board and its cards, but they can’t change anything.</p>
+
+    <div class="flex align-center gap-half">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" aria-label="Public link to this board" readonly>
+
+      <%= tag.button class: "btn btn--circle txt-small", data: {
+            controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+            copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: url } do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative borderless txt-small margin-block-start-half",
+          disabled: !Current.user.admin?,
+          form: { data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } } do %>
+      <%= icon_tag "lock" %>
+      <span>Unpublish this board</span>
+    <% end %>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to share a read-only version of it with anyone who has the link.</p>
+
+    <%= button_to board_publication_path(board), class: "btn", disabled: !Current.user.admin? do %>
+      <%= icon_tag "globe" %>
+      <span>Publish this board</span>
+    <% end %>
+  <% end %>
+
+  <% unless Current.user.admin? %>
+    <p class="txt-small txt-subtle margin-block-start-half">Only admins can publish or unpublish boards.</p>
+  <% end %>
+<% end %>
