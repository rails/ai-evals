+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show a published board without being signed in" do
+    get public_board_path(@board.publication)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_includes response.body, cards(:buy_domain).title
+    assert_includes response.body, columns(:writebook_in_progress).name
+    assert_select "a[href=?]", public_board_card_path(@board.publication, cards(:buy_domain))
+    assert_select "a[href=?]", board_path(@board), count: 0
+  end
+
+  test "show a published board when signed in" do
+    sign_in_as :kevin
+
+    get public_board_path(@board.publication)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+  end
+
+  test "show lazy-loads the columns from public urls" do
+    get public_board_path(@board.publication)
+
+    assert_select "turbo-frame[src=?]", public_board_column_path(@board.publication, columns(:writebook_in_progress))
+    assert_select "turbo-frame[src=?]", public_board_columns_not_now_path(@board.publication)
+    assert_select "turbo-frame[src=?]", public_board_columns_closed_path(@board.publication)
+  end
+
+  test "show doesn't include drafted cards" do
+    draft = @board.cards.create!(title: "Secret draft", creator: users(:david), status: :drafted)
+
+    get public_board_path(@board.publication)
+
+    assert_response :success
+    assert_not_includes response.body, draft.title
+  end
+
+  test "show is not found for unknown keys" do
+    get public_board_path("unknown")
+
+    assert_response :not_found
+  end
+
+  test "show is not found once the board is unpublished" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+
+    assert_response :not_found
+  end
+
+  test "show is not found under a different account" do
+    get public_board_path(@board.publication, script_name: accounts(:initech).slug)
+
+    assert_response :not_found
+  end
+
+  test "show is not found for cancelled accounts" do
+    accounts("37s").create_cancellation!(initiated_by: users(:jason))
+
+    get public_board_path(@board.publication)
+
+    assert_response :not_found
+  end
+
+  test "show is not indexed by search engines" do
+    get public_board_path(@board.publication)
+
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+end
