diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..07ad5d9 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,27 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+
+    define_callbacks :incinerate
+  end
+
+  class_methods do
+    def incinerate_all_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if cancelled?
+        run_callbacks :incinerate do
+          destroy!
+        end
+      end
+    end
+  end
 end
diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
index 8b432e8..7282aa9 100644
--- a/app/models/account/storage.rb
+++ b/app/models/account/storage.rb
@@ -2,8 +2,21 @@ module Account::Storage
   extend ActiveSupport::Concern
   include Storage::Totaled
 
+  included do
+    # A deleted board's entries still count towards its account, but an account takes its whole ledger with it.
+    has_many :storage_entries, class_name: "Storage::Entry", dependent: :delete_all
+    has_many :blobs, class_name: "ActiveStorage::Blob"
+
+    # Attached blobs are purged along with their records. Unattached ones aren't reachable that way.
+    before_destroy :purge_unattached_blobs_later, prepend: true
+  end
+
   private
     def calculate_real_storage_bytes
       boards.sum { |board| board.send(:calculate_real_storage_bytes) }
     end
+
+    def purge_unattached_blobs_later
+      blobs.unattached.find_each(&:purge_later)
+    end
 end
