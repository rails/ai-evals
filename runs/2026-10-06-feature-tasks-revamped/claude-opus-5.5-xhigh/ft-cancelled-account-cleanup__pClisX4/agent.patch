diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..b928814
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.cancel(initiated_by: users(:david))
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    travel 31.days
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    travel 29.days
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    travel 31.days
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "removes all data associated with the account from the database" do
+    Current.session = sessions(:david)
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    card.update!(description: "<action-text-attachment sgid=\"#{embed.attachable_sgid}\"></action-text-attachment>")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("never attached"), filename: "orphan.txt")
+    card.steps.create!(content: "Pack the bags")
+    @account.cards.each(&:reindex)
+    @account.materialize_storage
+    Current.reset
+
+    assert_not_empty tables_with_records_for(@account)
+
+    travel 31.days
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_empty tables_with_records_for(@account)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: @account.id)
+  end
+
+  private
+    def tables_with_records_for(account)
+      connection = ActiveRecord::Base.connection
+
+      connection.tables.select do |table|
+        if connection.column_exists?(table, :account_id)
+          model = Class.new(ActiveRecord::Base) { self.table_name = table; self.inheritance_column = nil }
+          model.where(account_id: account.id).exists?
+        end
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..d83104a
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due for incineration once the grace period after cancellation is over" do
+    @account.cancel(initiated_by: @user)
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel 1.second
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "active accounts are never due for incineration" do
+    travel 1.year
+
+    assert_empty Account.due_for_incineration
+  end
+
+  test "reactivated accounts are not due for incineration" do
+    @account.cancel(initiated_by: @user)
+    @account.reactivate
+
+    travel 31.days
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate destroys the account along with all its data" do
+    card_ids = @account.cards.ids
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Card.exists?(id: card_ids)
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+  end
+
+  test "incinerate leaves other accounts alone" do
+    other_account = accounts(:initech)
+    @account.cancel(initiated_by: @user)
+
+    assert_no_changes -> { [ other_account.users.count, other_account.boards.count, other_account.cards.count ] } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(other_account.id)
+  end
+
+  test "incinerate does nothing unless the account is cancelled" do
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing if the account was reactivated in the meantime" do
+    @account.cancel(initiated_by: @user)
+    stale_account = Account.find(@account.id).tap(&:cancelled?)
+    @account.reactivate
+
+    stale_account.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate runs incinerate callbacks" do
+    @account.cancel(initiated_by: @user)
+    callback_ran = false
+    Account.set_callback(:incinerate, :before) { callback_ran = true }
+
+    @account.incinerate
+
+    assert callback_ran
+  ensure
+    Account.reset_callbacks(:incinerate)
+  end
+
+  test "incinerate all due" do
+    due_account, recent_account, active_account = accounts(:"37s", :initech, :acme)
+
+    due_account.cancel(initiated_by: users(:david))
+    travel 20.days
+    recent_account.cancel(initiated_by: users(:mike))
+    travel 11.days
+
+    Account.incinerate_all_due
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+end
diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..7c71556
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+  end
+
+  test "destroying an account deletes its storage entries" do
+    Storage::Entry.record account: @account, board: boards(:writebook), delta: 1024, operation: "attach"
+    other_entry = Storage::Entry.record account: @other_account, delta: 2048, operation: "attach"
+
+    @account.destroy!
+
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert Storage::Entry.exists?(other_entry.id)
+  end
+
+  test "destroying a board keeps its storage entries in the account's ledger" do
+    board = boards(:writebook)
+    entry = Storage::Entry.record account: @account, board: board, delta: 1024, operation: "attach"
+
+    board.destroy!
+
+    assert Storage::Entry.exists?(entry.id)
+  end
+
+  test "destroying an account purges its unattached blobs" do
+    orphan = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("never attached"), filename: "orphan.txt")
+    other_orphan = Current.with_account(@other_account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("someone else's"), filename: "other.txt")
+    end
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      @account.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(orphan.id)
+    assert ActiveStorage::Blob.exists?(other_orphan.id)
+  end
+end
