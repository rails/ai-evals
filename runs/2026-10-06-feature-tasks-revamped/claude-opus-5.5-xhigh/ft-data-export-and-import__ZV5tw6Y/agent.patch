+# zip_kit counts entries that were rolled back (because the block writing them
+# raised) in the end of central directory record, even though they're left out
+# of the central directory itself. Readers then expect more entries than there
+# are and reject the archive. This writes the number of entries actually listed.
+class ZipFile::CentralDirectoryWriter < ZipKit::ZipWriter
+  def write_central_directory_file_header(**)
+    @central_directory_entries_count = central_directory_entries_count + 1
+    super
+  end
+
+  def write_end_of_central_directory(num_files_in_archive:, **)
+    super(num_files_in_archive: central_directory_entries_count, **)
+  end
+
+  private
+    def central_directory_entries_count
+      @central_directory_entries_count || 0
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..2d40698
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,98 @@
+# Reads entries from a ZIP archive without extracting it.
+#
+# Only the central directory is loaded upfront. Entries are inflated on demand,
+# and their sizes and CRCs are verified while reading, so that a corrupt or
+# malicious archive can't make us read more than it declares.
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = read_entries
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature, ArgumentError => error
+    raise ZipFile::InvalidFileError, "This file isn't a valid ZIP archive (#{error.message})"
+  end
+
+  def read(path, limit: nil)
+    entry = entry_for(path)
+
+    if limit && entry.uncompressed_size > limit
+      raise ZipFile::InvalidFileError, "#{path} is too large (#{entry.uncompressed_size} bytes)"
+    end
+
+    String.new(capacity: entry.uncompressed_size, encoding: Encoding::BINARY).tap do |content|
+      stream(path) { |chunk| content << chunk }
+    end
+  end
+
+  def stream(path)
+    entry = entry_for(path)
+    extractor = extractor_for(entry)
+    bytes_read = 0
+    crc32 = Zlib.crc32
+
+    until extractor.eof?
+      chunk = extractor.extract(CHUNK_SIZE)
+      break if chunk.nil?
+
+      bytes_read += chunk.bytesize
+      raise ZipFile::InvalidFileError, "#{path} is larger than declared in the archive" if bytes_read > entry.uncompressed_size
+
+      crc32 = Zlib.crc32(chunk, crc32)
+      yield chunk
+    end
+
+    if bytes_read != entry.uncompressed_size || crc32 != entry.crc32
+      raise ZipFile::InvalidFileError, "#{path} is corrupted"
+    end
+  rescue Zlib::Error, ZipKit::FileReader::ReadError => error
+    raise ZipFile::InvalidFileError, "#{path} couldn't be read (#{error.message})"
+  end
+
+  def size_of(path)
+    entry_for(path).uncompressed_size
+  end
+
+  def glob(pattern)
+    if (directory, suffix = simple_directory_pattern(pattern))
+      Array(directories[directory]).select { |path| path.end_with?(suffix) }
+    else
+      @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+    end
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  private
+    def read_entries
+      @file_reader.read_zip_structure(io: @io, read_local_headers: false).index_by(&:filename)
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise ZipFile::MissingEntryError, "#{path} is missing from the archive" }
+    end
+
+    def extractor_for(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+      end
+
+      entry.extractor_from(@io)
+    end
+
+    # Patterns like "data/cards/*.json" are answered from a per-directory index
+    # instead of matching every entry in the archive, which matters for archives
+    # with millions of entries.
+    def simple_directory_pattern(pattern)
+      if (match = pattern.match(%r{\A(?<directory>[^*?\[\]{}]+)/\*(?<suffix>[^*?\[\]{}/]*)\z}))
+        [ match[:directory], match[:suffix] ]
+      end
+    end
+
+    def directories
+      @directories ||= @entries.keys.sort.group_by { |path| File.dirname(path) }
+    end
+end
