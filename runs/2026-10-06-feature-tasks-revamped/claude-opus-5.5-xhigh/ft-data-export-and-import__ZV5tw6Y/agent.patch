diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..7fb22c3
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,59 @@
+class Account::ImportsController < ApplicationController
+  layout "public"
+
+  disallow_account_scope only: %i[ new create ]
+  rate_limit to: 10, within: 1.hour, only: :create, with: -> { redirect_to new_account_import_path, alert: "Try again later." }
+
+  before_action :set_import, only: :show
+
+  def new
+  end
+
+  def create
+    if zip_file?(import_file)
+      signup = Signup.new(identity: Current.identity, full_name: importer_name, skip_account_seeding: true)
+
+      if signup.complete
+        import = start_import(signup.account)
+        redirect_to account_import_path(import, script_name: signup.account.slug)
+      else
+        redirect_to new_account_import_path, alert: signup.errors.full_messages.to_sentence
+      end
+    else
+      redirect_to new_account_import_path, alert: "Choose a Fizzy account export (a .zip file) to import."
+    end
+  end
+
+  def show
+  end
+
+  private
+    def set_import
+      @import = Current.account.imports.find_by!(id: params[:id], identity: Current.identity)
+    end
+
+    def import_file
+      params[:file]
+    end
+
+    def zip_file?(file)
+      if file.respond_to?(:read)
+        file.read(2) == "PK".b
+      end
+    ensure
+      file.rewind if file.respond_to?(:rewind)
+    end
+
+    def importer_name
+      Current.identity.users.order(:created_at).where.not(name: Current.identity.email_address).pick(:name) ||
+        Current.identity.email_address.split("@").first
+    end
+
+    def start_import(account)
+      import = Current.with_account(account) do
+        account.imports.create!(identity: Current.identity, file: import_file)
+      end
+
+      import.tap(&:process_later)
+    end
+end
