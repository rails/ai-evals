+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none">Bring in an account exported from Fizzy. We’ll create a new account with everything in it: boards, cards, comments, files, and people.</p>
+
+  <%= form_with url: account_imports_path, multipart: true, class: "flex flex-column gap margin-block-start", data: { controller: "form", turbo: false } do |form| %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input", aria: { label: "Account export file" } %>
+
+    <p class="txt-small margin-none">Large accounts can take a while. We’ll email you when the import is done, or if it can’t be completed. Nothing is kept from an import that fails.</p>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
