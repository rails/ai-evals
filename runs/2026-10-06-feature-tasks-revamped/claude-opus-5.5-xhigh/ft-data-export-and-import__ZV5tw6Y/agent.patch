diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..65b8708
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @export = User::DataExport.create!(account: Current.account, user: @user)
+  end
+
+  test "build_later enqueues the job that builds it" do
+    assert_enqueued_with(job: DataExportJob, args: [ @export ]) do
+      @export.build_later
+    end
+  end
+
+  test "build attaches the archive and emails a download link" do
+    assert_enqueued_email_with ExportMailer, :completed, args: [ @export ] do
+      @export.build
+    end
+
+    assert @export.completed?
+    assert @export.completed_at.present?
+    assert @export.file.attached?
+    assert_equal "application/zip", @export.file.content_type
+    assert_match(/\Adavid-cards-\d{4}-\d{2}-\d{2}\.zip\z/, @export.file.filename.to_s)
+  end
+
+  test "build is marked as failed when something goes wrong" do
+    ZipFile.stubs(:create_for).raises(StandardError, "Test error")
+
+    assert_raises(StandardError) { @export.build }
+    assert @export.reload.failed?
+  end
+
+  test "the download works for a day" do
+    @export.build
+    assert @export.downloadable?
+    assert @export.accessible_to?(@user)
+
+    travel Export::DOWNLOAD_PERIOD + 1.minute do
+      assert @export.expired?
+      assert_not @export.downloadable?
+      assert_not @export.accessible_to?(@user)
+    end
+  end
+
+  test "only whoever asked for it can download it" do
+    @export.build
+
+    assert_not @export.accessible_to?(users(:kevin))
+    assert_not @export.accessible_to?(nil)
+    assert @export.file.blob.accessible_to?(@user)
+    assert_not @export.file.blob.accessible_to?(users(:kevin))
+  end
+
+  test "account exports can only be downloaded by admins" do
+    export = Account::Export.create!(account: Current.account, user: users(:kevin))
+    export.build
+    assert export.accessible_to?(users(:kevin))
+
+    users(:kevin).update!(role: :member)
+    assert_not export.accessible_to?(users(:kevin))
+  end
+
+  test "cleanup deletes expired exports" do
+    expired = Export.create!(type: "User::DataExport", account: Current.account, user: @user, status: :completed, completed_at: 25.hours.ago)
+    downloadable = Export.create!(type: "User::DataExport", account: Current.account, user: @user, status: :completed, completed_at: 23.hours.ago)
+    failed = Export.create!(type: "User::DataExport", account: Current.account, user: @user, status: :failed, created_at: 2.days.ago, updated_at: 2.days.ago)
+    abandoned = Export.create!(type: "User::DataExport", account: Current.account, user: @user, status: :processing, created_at: 8.days.ago)
+    still_building = Export.create!(type: "Account::Export", account: Current.account, user: users(:kevin), status: :processing, created_at: 2.days.ago)
+
+    Export.cleanup
+
+    assert_not Export.exists?(expired.id)
+    assert_not Export.exists?(failed.id)
+    assert_not Export.exists?(abandoned.id)
+    assert Export.exists?(downloadable.id)
+    assert Export.exists?(still_building.id), "large accounts can take longer than a day to export"
+    assert Export.exists?(@export.id)
+  end
+
+  test "the number of exports a day is limited" do
+    (Export::DAILY_LIMIT - 1).times { User::DataExport.create!(account: Current.account, user: @user) }
+    assert Export.limit_reached_for?(@user)
+    assert_not Export.limit_reached_for?(users(:kevin))
+  end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..ae75f36
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+  end
+
+  test "the cards someone can see are exported as JSON with their comments" do
+    zip = build_export(@user)
+
+    with_zip_reader(zip) do |reader|
+      numbers = reader.glob("*.json").map { File.basename(it, ".json").to_i }.sort
+      assert_equal visible_cards(@user).pluck(:number).sort, numbers
+
+      logo = JSON.parse(reader.read("#{cards(:logo).number}.json"))
+      assert_equal "The logo isn't big enough", logo["title"]
+      assert_equal "Writebook", logo["board"]
+      assert_equal({ "name" => "David", "email_address" => "david@37signals.com" }, logo["creator"])
+      assert_includes logo["comments"].map { it["body"] }, "I agree."
+      assert_equal "JZ", logo["comments"].find { it["body"] == "I agree." }.dig("creator", "name")
+    end
+  end
+
+  test "cards on boards someone can't see aren't exported" do
+    hidden = cards(:logo)
+    hidden.board.accesses.where(user: @user).destroy_all
+    hidden.board.update_columns(all_access: false)
+
+    with_zip_reader(build_export(@user.reload)) do |reader|
+      assert_not reader.exists?("#{hidden.number}.json")
+    end
+  end
+
+  test "drafts by other people aren't exported" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), title: "Secret draft", status: :drafted)
+
+    with_zip_reader(build_export(@user)) do |reader|
+      assert_not reader.exists?("#{draft.number}.json")
+    end
+  end
+
+  test "pictures and files attached to cards and comments are exported" do
+    card = cards(:logo)
+    card.image.attach ActiveStorage::Blob.create_and_upload!(io: StringIO.new("header"), filename: "image.png", content_type: "image/png")
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "image.png", content_type: "image/png")
+    card.update!(description: %(<p>See <action-text-attachment sgid="#{embed.attachable_sgid}"></action-text-attachment></p>))
+    attachment = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("report"), filename: "report.pdf", content_type: "application/pdf")
+    comments(:logo_agreement_jz).update!(body: %(<action-text-attachment sgid="#{attachment.attachable_sgid}"></action-text-attachment>))
+
+    with_zip_reader(build_export(@user)) do |reader|
+      data = JSON.parse(reader.read("#{card.number}.json"))
+
+      assert_equal "#{card.number}/image.png", data["image"]
+      assert_equal "header", reader.read(data["image"])
+
+      embedded_path = data["attachments"].sole["path"]
+      assert_equal "#{card.number}/image (2).png", embedded_path
+      assert_equal file_fixture("avatar.png").binread, reader.read(embedded_path)
+      assert_includes data["description_html"], %(src="#{card.number}/image%20%282%29.png")
+
+      comment = data["comments"].find { it["id"] == comments(:logo_agreement_jz).id }
+      assert_equal "report", reader.read(comment["attachments"].sole["path"])
+    end
+  end
+
+  private
+    def build_export(user)
+      export = User::DataExport.create!(account: user.account, user: user)
+      export.build
+      export.file.download
+    end
+
+    def visible_cards(user)
+      user.accessible_cards.published.or(user.accessible_cards.drafted.where(creator: user))
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..3af1840 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,110 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "writer keeps the archive valid when writing an entry fails" do
+    zip = build_zip do |writer|
+      writer.add_file("first.txt", "First")
+      assert_raises(RuntimeError) { writer.add_file("broken.txt") { |sink| sink.write("Half"); raise "boom" } }
+      writer.add_file("last.txt", "Last")
+      assert_not writer.exists?("broken.txt")
+    end
+
+    with_zip_reader(zip) do |reader|
+      assert_equal [ "first.txt", "last.txt" ], reader.glob("*")
+      assert_equal "Last", reader.read("last.txt")
+    end
+  end
+
+  test "writer knows the size and checksum of what it wrote" do
+    io = StringIO.new("".b)
+    writer = ZipFile::Writer.new
+    writer.stream_to(io)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.close
+
+    assert_equal io.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), writer.checksum
+  end
+
+  test "reader reads, streams, and globs entries" do
+    zip = build_zip do |writer|
+      writer.add_file("data/cards/b.json", "{}")
+      writer.add_file("data/cards/a.json", %({"title":"Hello"}))
+      writer.add_file("data/comments/c.json", "{}")
+      writer.add_file("storage/abc", "x" * 3.megabytes, compress: false)
+    end
+
+    with_zip_reader(zip) do |reader|
+      assert_equal %({"title":"Hello"}), reader.read("data/cards/a.json")
+      assert_equal [ "data/cards/a.json", "data/cards/b.json" ], reader.glob("data/cards/*.json")
+      assert_equal [ "data/comments/c.json" ], reader.glob("data/*/c.json")
+      assert reader.exists?("storage/abc")
+      assert_not reader.exists?("storage/missing")
+      assert_equal 3.megabytes, reader.size_of("storage/abc")
+
+      streamed = 0
+      reader.stream("storage/abc") { |chunk| streamed += chunk.bytesize }
+      assert_equal 3.megabytes, streamed
+    end
+  end
+
+  test "reader refuses entries larger than allowed" do
+    zip = build_zip { |writer| writer.add_file("big.txt", "x" * 1000) }
+
+    with_zip_reader(zip) do |reader|
+      assert_raises(ZipFile::InvalidFileError) { reader.read("big.txt", limit: 100) }
+    end
+  end
+
+  test "reader raises for missing entries and invalid archives" do
+    zip = build_zip { |writer| writer.add_file("hello.txt", "Hello") }
+
+    with_zip_reader(zip) do |reader|
+      assert_raises(ZipFile::MissingEntryError) { reader.read("missing.txt") }
+    end
+
+    assert_raises(ZipFile::InvalidFileError) { ZipFile::Reader.new(StringIO.new("not a zip file")) }
+  end
+
+  test "reader detects corrupted entries" do
+    zip = build_zip { |writer| writer.add_file("hello.txt", "Hello, World!", compress: false) }
+    zip = zip.sub("Hello, World!", "Hello, Wxrld!")
+
+    with_zip_reader(zip) do |reader|
+      assert_raises(ZipFile::InvalidFileError) { reader.read("hello.txt") }
+    end
+  end
+
+  test "read_from reads archives from any storage service in ranges" do
+    zip = build_zip do |writer|
+      writer.add_file("hello.txt", "Hello, World!")
+      writer.add_file("big.bin", Random.bytes(2.megabytes), compress: false)
+    end
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new(zip), filename: "archive.zip")
+
+    ZipFile.stubs(:disk_service?).returns(false)
+
+    ZipFile.read_from(blob) do |reader|
+      assert_kind_of ZipFile::BlobIO, reader.instance_variable_get(:@io)
+      assert_equal "Hello, World!", reader.read("hello.txt")
+      assert_equal 2.megabytes, reader.read("big.bin").bytesize
+    end
+  end
+
+  test "blob IO buffers reads and seeks like a file" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("0123456789" * 10), filename: "digits.txt")
+    io = ZipFile::BlobIO.new(blob, buffer_size: 16)
+
+    assert_equal 100, io.size
+    assert_equal "0123", io.read(4)
+    assert_equal 4, io.tell
+    io.seek(95)
+    assert_equal "56789", io.read(10)
+    assert_nil io.read(1)
+    io.seek(-3, IO::SEEK_END)
+    assert_equal "789", io.read
+    io.seek(10)
+    assert_equal "0123456789" * 3, io.read(30)
+  end
 end
