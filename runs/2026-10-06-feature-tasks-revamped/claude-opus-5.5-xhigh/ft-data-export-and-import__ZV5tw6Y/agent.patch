@@ -0,0 +1,43 @@
+# The cards someone can see, as JSON files with their comments, along with the
+# files attached to them:
+#
+#   <card number>.json
+#   <card number>/<file name>
+class User::DataExport < Export
+  private
+    def filename_prefix
+      "#{user.name} cards"
+    end
+
+    def populate_zip(zip)
+      exportable_cards.find_each do |card|
+        add_card_to_zip(zip, card)
+      end
+    end
+
+    def exportable_cards
+      user.accessible_cards.published.or(user.accessible_cards.drafted.where(creator: user)).includes(
+        :board, :column, :tags, :steps, :closure, :not_now, :goldness,
+        creator: :identity, assignees: :identity,
+        image_attachment: :blob,
+        rich_text_description: { embeds_attachments: :blob },
+        comments: [ { creator: :identity }, { rich_text_body: { embeds_attachments: :blob } } ]
+      )
+    end
+
+    def add_card_to_zip(zip, card)
+      zip.add_file("#{card.number}.json", card.export_json)
+
+      card.export_attachments.each do |attachment|
+        add_attachment_to_zip(zip, attachment)
+      end
+    end
+
+    def add_attachment_to_zip(zip, attachment)
+      zip.add_file(attachment.path, compress: false) do |file|
+        attachment.blob.download { |chunk| file.write(chunk) }
+      end
+    rescue ActiveStorage::FileNotFoundError
+      # The file is gone from storage, so there's nothing to export
+    end
+end
