+++ b/app/models/account/data_transfer/record_set/reference.rb
@@ -0,0 +1,30 @@
+# A belongs_to association of an exported model, used to check that every
+# record in an archive only refers to records from the same archive.
+class Account::DataTransfer::RecordSet::Reference
+  attr_reader :name, :foreign_key
+
+  def initialize(reflection, exportable_models)
+    @reflection = reflection
+    @name = reflection.name.to_s.humanize(capitalize: false)
+    @foreign_key = reflection.foreign_key.to_s
+    @exportable_models = exportable_models
+  end
+
+  def optional?
+    @reflection.options[:optional] || @reflection.active_record.columns_hash[foreign_key].null
+  end
+
+  # The model a record refers to. Polymorphic references can only point to
+  # models that are part of the export.
+  def target_for(data)
+    if @reflection.polymorphic?
+      @exportable_models[data[@reflection.foreign_type.to_s]]
+    else
+      @reflection.klass
+    end
+  end
+
+  def account?(data)
+    target_for(data) == Account
+  end
+end
