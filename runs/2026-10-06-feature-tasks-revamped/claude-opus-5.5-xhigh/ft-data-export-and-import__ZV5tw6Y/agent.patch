@@ -0,0 +1,50 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class ImportAccountDataJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    Current.account = nil
+  end
+
+  test "imports the account" do
+    zip = exported_zip(export_account(accounts("37s")))
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { accounts("37s").incinerate }
+    import = create_import(zip, identity: identities(:david))
+
+    ImportAccountDataJob.perform_now(import)
+
+    assert import.reload.completed?
+    assert_equal 5, import.account.cards.count
+  end
+
+  test "imports of invalid files are cleaned up without failing the job" do
+    import = create_import(build_zip { |zip| zip.add_file("hello.txt", "Hello") }, identity: identities(:david))
+
+    assert_nothing_raised { ImportAccountDataJob.perform_now(import) }
+    assert_not Account.exists?(import.account_id)
+  end
+
+  test "an interrupted import picks up where it left off" do
+    zip = exported_zip(export_account(accounts("37s")))
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { accounts("37s").incinerate }
+    import = create_import(zip, identity: identities(:david))
+    cards_index = Account::DataTransfer::Manifest.new(import.account).record_sets.index { it.model == Card }
+
+    import.process_later
+    interrupt_job_during_step(ImportAccountDataJob, :process, cursor: [ "import", cards_index, 5 ]) do
+      perform_enqueued_jobs(only: ImportAccountDataJob)
+    end
+
+    assert import.reload.processing?
+    assert_equal 5, import.account.cards.count
+    assert_enqueued_jobs 1, only: ImportAccountDataJob
+
+    Account::DataTransfer::RecordSet.any_instance.expects(:check).never
+    perform_enqueued_jobs(only: ImportAccountDataJob)
+
+    assert import.reload.completed?
+    assert_equal Comment.where(account: import.account).count, 9
+  end
+end
