@@ -1,4 +1,92 @@
 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @rich_text_id = ActiveRecord::Type::Uuid.generate
+  end
+
+  test "export turns signed global ids into global ids" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("notes"), filename: "notes.txt", content_type: "text/plain")
+    card.update!(description: %(<p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment></p>))
+
+    zip = build_zip { |writer| record_set_for(card.account).export(to: writer) }
+
+    with_zip_reader(zip) do |reader|
+      body = JSON.parse(reader.read("data/action_text_rich_texts/#{card.description.id}.json"))["body"]
+
+      assert_includes body, %(gid="gid://fizzy/ActiveStorage::Blob/#{blob.id}")
+      assert_not_includes body, "sgid"
+    end
+  end
+
+  test "import signs global ids again for records imported into the account" do
+    import_rich_text_with_body %(<action-text-attachment gid="gid://fizzy/User/#{users(:mike).id}" content-type="application/vnd.actiontext.mention"></action-text-attachment>)
+
+    assert_equal [ users(:mike) ], imported_rich_text.body.attachables
+    assert_includes imported_rich_text.body.to_html, %(sgid="#{users(:mike).attachable_sgid}")
+  end
+
+  test "import drops attachments that point outside the account" do
+    blob_elsewhere = Current.with_account(accounts("37s")) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("secret"), filename: "secret.txt")
+    end
+
+    import_rich_text_with_body <<~HTML
+      <action-text-attachment gid="gid://fizzy/ActiveStorage::Blob/#{blob_elsewhere.id}"></action-text-attachment>
+      <action-text-attachment gid="gid://fizzy/User/#{users(:david).id}"></action-text-attachment>
+      <action-text-attachment gid="gid://fizzy/Identity/#{identities(:mike).id}"></action-text-attachment>
+      <action-text-attachment sgid="#{blob_elsewhere.attachable_sgid}"></action-text-attachment>
+    HTML
+
+    html = imported_rich_text.body.to_html
+    assert_not_includes html, "sgid"
+    assert_not_includes html, "gid="
+    assert_empty imported_rich_text.body.attachables.grep(ActiveStorage::Blob)
+    assert_empty imported_rich_text.body.attachables.grep(User)
+  end
+
+  test "check rejects rich text for records that aren't part of the export" do
+    zip = build_zip do |writer|
+      writer.add_file "data/account.json", { id: "exported", name: "Exported" }.to_json
+      writer.add_file "data/action_text_rich_texts/#{@rich_text_id}.json", rich_text_data(record_type: "Identity", record_id: identities(:mike).id).to_json
+    end
+
+    error = with_zip_reader(zip) do |reader|
+      assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { record_set_for(@account).check(from: reader) }
+    end
+
+    assert_match "refers to a record that isn't in the file", error.message
+  end
+
+  private
+    def record_set_for(account)
+      Account::DataTransfer::ActionText::RichTextRecordSet.new(account)
+    end
+
+    def import_rich_text_with_body(body)
+      zip = build_zip do |writer|
+        writer.add_file "data/action_text_rich_texts/#{@rich_text_id}.json", rich_text_data(body: body).to_json
+      end
+
+      with_zip_reader(zip) { |reader| record_set_for(@account).import(from: reader) }
+    end
+
+    def imported_rich_text
+      ActionText::RichText.find(@rich_text_id)
+    end
+
+    def rich_text_data(**attributes)
+      {
+        id: @rich_text_id,
+        account_id: "exported",
+        record_type: "Board",
+        record_id: ActiveRecord::Type::Uuid.generate,
+        name: "public_description",
+        body: "<p>Hello</p>",
+        created_at: Time.current,
+        updated_at: Time.current
+      }.merge(attributes)
+    end
 end
diff --git a/test/models/account/data_transfer/record_set_test.rb b/test/models/account/data_transfer/record_set_test.rb
