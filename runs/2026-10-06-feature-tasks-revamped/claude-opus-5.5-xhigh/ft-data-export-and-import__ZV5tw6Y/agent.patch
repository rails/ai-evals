diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..a6f461b
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,68 @@
+# A read-only, seekable IO over a blob stored in any Active Storage service.
+#
+# Reading a ZIP archive needs random access, but archives can be far too large
+# to download first. This reads ranges straight from the service instead, with
+# a read-ahead buffer so that sequential reads of small entries don't turn into
+# one request each.
+class ZipFile::BlobIO
+  BUFFER_SIZE = 8.megabytes
+
+  attr_reader :size
+
+  def initialize(blob, buffer_size: BUFFER_SIZE)
+    @blob = blob
+    @size = blob.byte_size
+    @buffer_size = buffer_size
+    @pos = 0
+    @buffer = "".b
+    @buffer_start = 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @pos = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @pos + offset
+    when IO::SEEK_END then @size + offset
+    else raise ArgumentError, "Unsupported whence: #{whence}"
+    end.clamp(0, @size)
+
+    0
+  end
+
+  def tell
+    @pos
+  end
+  alias_method :pos, :tell
+
+  def read(length = nil)
+    length ||= @size - @pos
+    return (length.zero? ? "".b : nil) if @pos >= @size
+
+    length = [ length, @size - @pos ].min
+
+    if length > @buffer_size
+      download(@pos, length)
+    else
+      fill_buffer(length) unless buffered?(length)
+      @buffer.byteslice(@pos - @buffer_start, length)
+    end.tap { |data| @pos += data.bytesize }
+  end
+
+  def close
+    @buffer = "".b
+  end
+
+  private
+    def buffered?(length)
+      @pos >= @buffer_start && @pos + length <= @buffer_start + @buffer.bytesize
+    end
+
+    def fill_buffer(length)
+      @buffer_start = @pos
+      @buffer = download(@pos, [ [ length, @buffer_size ].max, @size - @pos ].min)
+    end
+
+    def download(offset, length)
+      @blob.service.download_chunk(@blob.key, offset...(offset + length)).b
+    end
+end
