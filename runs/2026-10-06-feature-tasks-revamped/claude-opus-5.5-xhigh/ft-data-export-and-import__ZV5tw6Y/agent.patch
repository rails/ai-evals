+<% @page_title = "Import an account" %>
+
+<% if @import.pending? || @import.processing? %>
+  <% content_for :head do %>
+    <meta http-equiv="refresh" content="15">
+  <% end %>
+<% end %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <% if @import.completed? %>
+    <h1 class="txt-x-large font-weight-black margin-block-end">Your import is done</h1>
+    <p class="margin-none">Everything from your file is now in <strong><%= Current.account.name %></strong>.</p>
+
+    <%= link_to landing_path, class: "btn btn--link center margin-block-start" do %>
+      <span>Go to <%= Current.account.name %></span>
+      <%= icon_tag "arrow-right" %>
+    <% end %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-block-end">Your import couldn’t be completed</h1>
+    <p class="margin-none">We’ve emailed you the reason. Nothing from the file was kept.</p>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-block-end">Importing your account…</h1>
+    <p class="margin-none">This can take a while for large accounts. You can close this page: we’ll email you when it’s done.</p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
