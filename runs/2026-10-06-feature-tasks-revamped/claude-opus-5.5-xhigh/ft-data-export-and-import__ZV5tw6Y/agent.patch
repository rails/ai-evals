+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "the archive has every record of the account" do
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      account_data = JSON.parse(reader.read("data/account.json"))
+      assert_equal @account.id, account_data["id"]
+      assert_equal "37signals", account_data["name"]
+      assert_equal @account.join_code.code, account_data.dig("join_code", "code")
+
+      assert_equal @account.cards.ids.sort, reader.glob("data/cards/*.json").map { File.basename(it, ".json") }.sort
+      assert_equal Comment.where(account: @account).count, reader.glob("data/comments/*.json").size
+      assert_empty reader.glob("data/cards/*.json").map { JSON.parse(reader.read(it))["account_id"] }.uniq - [ @account.id ]
+    end
+  end
+
+  test "people are exported with their email address" do
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      david = JSON.parse(reader.read("data/users/#{users(:david).id}.json"))
+      assert_equal "david@37signals.com", david["email_address"]
+      assert_not david.key?("identity_id")
+    end
+  end
+
+  test "column colors are exported as they're stored" do
+    zip = exported_zip(export_account(@account))
+    column = columns(:writebook_triage)
+
+    with_zip_reader(zip) do |reader|
+      assert_equal column[:color], JSON.parse(reader.read("data/columns/#{column.id}.json"))["color"]
+    end
+  end
+
+  test "files are exported along with their blobs" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("header image"), filename: "header.png", content_type: "image/png")
+    cards(:logo).image.attach(blob)
+
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      assert reader.exists?("data/active_storage_blobs/#{blob.id}.json")
+      assert_equal "header image", reader.read("storage/#{blob.key}")
+    end
+  end
+
+  test "files missing from storage don't stop the export" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("header image"), filename: "header.png", content_type: "image/png")
+    cards(:logo).image.attach(blob)
+    blob.service.delete(blob.key)
+
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      assert reader.exists?("data/active_storage_blobs/#{blob.id}.json")
+      assert_not reader.exists?("storage/#{blob.key}")
+    end
+  end
+
+  test "earlier exports aren't part of the archive" do
+    earlier = export_account(@account)
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      assert_not reader.exists?("data/active_storage_blobs/#{earlier.file.blob.id}.json")
+      assert_not reader.exists?("storage/#{earlier.file.blob.key}")
+      assert reader.glob("data/active_storage_attachments/*.json").none? { JSON.parse(reader.read(it))["record_type"] == "Export" }
+    end
+  end
+
+  test "rich text attachments are exported with global ids" do
+    cards(:logo).update!(description: %(<action-text-attachment sgid="#{users(:kevin).attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>))
+
+    zip = exported_zip(export_account(@account))
+
+    with_zip_reader(zip) do |reader|
+      body = JSON.parse(reader.read("data/action_text_rich_texts/#{cards(:logo).description.id}.json"))["body"]
+      assert_includes body, %(gid="gid://fizzy/User/#{users(:kevin).id}")
+      assert_not_includes body, "sgid="
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..b5e6a49
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,254 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  # Like the interruptions of continuable jobs, this isn't a StandardError
+  class Interruption < Exception; end
+
+  setup do
+    @source = accounts("37s")
+    @identity = identities(:david)
+
+    Current.account = nil
+  end
+
+  test "an exported account comes back with everything in it" do
+    card = cards(:logo)
+    attach_files_to(card)
+
+    source_digest = account_digest(@source)
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { import.process }
+
+    assert import.completed?
+    assert import.completed_at.present?
+
+    account = import.account.reload
+    assert_equal source_digest, account_digest(account)
+
+    imported_card = account.cards.find(card.id)
+    assert_equal "header image", imported_card.image.download
+    assert_equal [ "embedded file" ], imported_card.description.embeds.map { it.blob.download }
+    assert_equal [ ActiveStorage::Blob, User ], imported_card.description.body.attachables.map(&:class)
+  end
+
+  test "people can sign in to the imported account" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    import.process
+    account = import.account
+
+    assert_equal users(:jz).id, identities(:jz).users.find_by!(account: account).id
+    assert_equal "system", account.system_user.role
+    assert_equal 1, account.users.where(role: :system).count
+  end
+
+  test "whoever imports the account owns it and can see every board" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    import.process
+    account = import.account
+
+    importer = @identity.users.find_by!(account: account)
+    assert_equal users(:david).id, importer.id, "the importer becomes their exported self"
+    assert importer.owner?
+    assert_equal [ importer ], account.users.owner.to_a
+    assert account.users.find(users(:jason).id).admin?, "the previous owner is still an admin"
+    assert_equal account.boards.ids.sort, importer.boards.ids.sort
+  end
+
+  test "someone who isn't in the export still owns the imported account" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: identities(:mike))
+    import.process
+    account = import.account
+
+    importer = identities(:mike).users.find_by!(account: account)
+    assert importer.owner?
+    assert_equal account.boards.ids.sort, importer.boards.ids.sort
+  end
+
+  test "imported cards can be searched" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    import.process
+
+    assert Search::Record.for(import.account.id).where(account_id: import.account.id, searchable_type: "Card").exists?
+  end
+
+  test "the uploaded file is removed once the import is done" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+
+    assert_enqueued_email_with ImportMailer, :completed, args: [ import ] do
+      import.process
+    end
+
+    assert_not import.reload.file.attached?
+  end
+
+  test "an import that can't be completed leaves nothing behind" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    account = import.account
+    identity_count = Identity.count
+
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import).raises(RuntimeError, "storage is down")
+
+    assert_enqueued_email_with ImportMailer, :failed, args: [ @identity, { reason: Account::Import::GENERIC_FAILURE_REASON } ] do
+      assert_raises(RuntimeError) { import.process }
+    end
+
+    assert import.failed?
+    assert_not Account.exists?(account.id)
+    assert_not Account::Import.exists?(import.id)
+    assert_equal identity_count, Identity.count
+
+    (Account::DataTransfer::Manifest.models - [ Account ]).each do |model|
+      assert_empty model.where(account_id: account.id), "#{model.name} records were left behind"
+    end
+  end
+
+  test "a hiccup after everything is imported doesn't undo the import" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    ImportMailer.stubs(:completed).raises(RuntimeError, "SMTP is down")
+
+    assert_raises(RuntimeError) { import.process }
+
+    assert Account.exists?(import.account_id)
+    assert_equal 5, import.account.cards.count
+  end
+
+  test "people created for a failed import are removed" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+    identities(:jz).destroy!
+
+    import = create_import(zip, identity: @identity)
+    Account::Import.any_instance.stubs(:reindex_for_search).raises(RuntimeError)
+
+    assert_raises(RuntimeError) { import.process }
+
+    assert_not Identity.exists?(email_address: "jz@37signals.com")
+    assert Identity.exists?(email_address: "david@37signals.com")
+  end
+
+  test "a file that isn't a zip archive fails with a reason" do
+    import = create_import("This is not a zip file", identity: @identity)
+    account = import.account
+
+    assert_raises(ZipFile::InvalidFileError) { import.process }
+
+    assert_not Account.exists?(account.id)
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob
+  end
+
+  test "a zip archive that isn't an export fails with a reason" do
+    import = create_import(build_zip { |zip| zip.add_file("hello.txt", "Hello") }, identity: @identity)
+
+    error = assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { import.process }
+    assert_equal "This file isn't a Fizzy account export", error.message
+  end
+
+  test "an export can't be imported while the data it contains is still in Fizzy" do
+    zip = exported_zip(export_account(@source))
+    import = create_import(zip, identity: @identity)
+
+    assert_no_difference -> { Card.count } do
+      assert_raises(Account::DataTransfer::RecordSet::ConflictError) { import.process }
+    end
+
+    assert_not Account.exists?(import.account_id)
+    assert_equal 5, @source.reload.cards.count, "the original account is untouched"
+  end
+
+  test "records can't refer to data from another account" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    victim_board = boards(:miltons_wish_list)
+    zip = rewrite_zip(zip) do |path, content|
+      if path.start_with?("data/accesses/")
+        JSON.parse(content).merge("board_id" => victim_board.id).to_json
+      end
+    end
+
+    import = create_import(zip, identity: @identity)
+
+    error = assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { import.process }
+    assert_match "refers to a board that isn't in the file", error.message
+    assert_not Access.exists?(board: victim_board, user: @identity.users)
+  end
+
+  test "an interrupted import resumes from where it left off" do
+    zip = exported_zip(export_account(@source))
+    incinerate @source
+
+    import = create_import(zip, identity: @identity)
+    cursors = []
+
+    assert_raises Interruption do
+      import.process do |cursor|
+        cursors << cursor
+        raise Interruption if cursor.first == "import" && cursor.second == 5
+      end
+    end
+
+    resumed_from = cursors.last
+    assert import.reload.processing?
+    assert_equal "import", resumed_from.first
+
+    import.process(start: resumed_from)
+    assert import.completed?
+    assert_equal 5, import.account.cards.count
+  end
+
+  private
+    # Files of the account are purged in the background after it's gone. Until
+    # then, an export of it can't be imported again.
+    def incinerate(account)
+      perform_enqueued_jobs(only: ActiveStorage::PurgeJob) { account.incinerate }
+    end
+
+    def attach_files_to(card)
+      Current.set(account: card.account) do
+        card.image.attach ActiveStorage::Blob.create_and_upload!(io: StringIO.new("header image"), filename: "header.png", content_type: "image/png")
+        blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded file"), filename: "notes.txt", content_type: "text/plain")
+        card.update! description: %(<p>Attached <action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment> by <action-text-attachment sgid="#{users(:kevin).attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment></p>)
+      end
+    end
+
+    def account_digest(account)
+      {
+        name: account.name,
+        cards_count: account.cards_count,
+        users: account.users.where.not(role: :system).order(:id).map { [ it.id, it.name, it.identity&.email_address, it.active ] },
+        boards: account.boards.order(:id).map { [ it.id, it.name, it.all_access ] },
+        columns: account.columns.order(:id).map { [ it.id, it.name, it[:color], it.position ] },
+        cards: account.cards.order(:number).map { [ it.number, it.title, it.status, it.board_id, it.column_id, it.creator_id, it.description.to_plain_text, it.closed?, it.postponed?, it.tags.map(&:title).sort ] },
+        comments: Comment.where(account: account).order(:id).map { [ it.id, it.card_id, it.creator_id, it.body.to_plain_text ] },
+        records: (Account::DataTransfer::Manifest.models - [ Account, User, Access, Entropy ]).to_h { [ it.name, it.where(account_id: account.id).count ] },
+        entropy: account.entropy.auto_postpone_period,
+        filters: Filter.where(account: account).order(:id).map { [ it.id, it.params_digest, it.tag_ids, it.assignee_ids, it.board_ids ] }
+      }
+    end
+end
