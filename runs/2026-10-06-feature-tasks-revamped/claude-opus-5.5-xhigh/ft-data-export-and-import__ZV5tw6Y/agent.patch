index 0000000..59f958b
--- /dev/null
+++ b/test/models/account/data_transfer/record_set_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class Account::DataTransfer::RecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @board_id = ActiveRecord::Type::Uuid.generate
+    @user_id = ActiveRecord::Type::Uuid.generate
+  end
+
+  test "check accepts records that only refer to records in the file" do
+    zip = archive(boards: [ board_data ], users: [ user_data ])
+
+    with_zip_reader(zip) do |reader|
+      assert_nothing_raised { record_set_for(Board).check(from: reader) }
+    end
+  end
+
+  test "check rejects records that don't match their file" do
+    zip = archive(boards: [ board_data.merge(id: ActiveRecord::Type::Uuid.generate) ], file_ids: { boards: [ @board_id ] }, users: [ user_data ])
+
+    assert_integrity_error "doesn't match the record it contains", zip, Board
+  end
+
+  test "check rejects records missing required attributes" do
+    zip = archive(boards: [ board_data.except(:name) ], users: [ user_data ])
+
+    assert_integrity_error "is missing name", zip, Board
+  end
+
+  test "check rejects records that refer to records outside the file" do
+    zip = archive(boards: [ board_data.merge(creator_id: users(:david).id) ], users: [ user_data ])
+
+    assert_integrity_error "refers to a creator that isn't in the file", zip, Board
+  end
+
+  test "check rejects polymorphic references to models that aren't exported" do
+    reaction = { id: ActiveRecord::Type::Uuid.generate, account_id: "exported", content: "👍", reactable_type: "Identity", reactable_id: identities(:mike).id, reacter_id: @user_id }
+    zip = archive(users: [ user_data ], reactions: [ reaction ])
+
+    assert_integrity_error "refers to a reactable that isn't in the file", zip, Reaction
+  end
+
+  test "check rejects records whose ids are taken by another account" do
+    zip = archive(boards: [ board_data.merge(id: boards(:writebook).id) ], file_ids: { boards: [ boards(:writebook).id ] }, users: [ user_data ])
+
+    with_zip_reader(zip) do |reader|
+      assert_raises(Account::DataTransfer::RecordSet::ConflictError) { record_set_for(Board).check(from: reader) }
+    end
+  end
+
+  test "import puts records into the account, once" do
+    zip = archive(boards: [ board_data ], users: [ user_data ])
+
+    with_zip_reader(zip) do |reader|
+      assert_difference -> { @account.boards.count }, +1 do
+        record_set_for(Board).import(from: reader)
+        record_set_for(Board).import(from: reader)
+      end
+    end
+
+    assert_equal "Imported board", @account.boards.find(@board_id).name
+  end
+
+  test "import reports its progress and can resume from it" do
+    boards = 3.times.map { board_data.merge(id: ActiveRecord::Type::Uuid.generate) }
+    zip = archive(boards: boards, users: [ user_data ])
+    stub_const(Account::DataTransfer::RecordSet, :BATCH_SIZE, 2) do
+      with_zip_reader(zip) do |reader|
+        progress = []
+        record_set_for(Board).import(from: reader, start: 1) { |imported| progress << imported }
+
+        assert_equal [ 3 ], progress
+        assert_equal boards.pluck(:id).sort.drop(1), @account.boards.where(id: boards.pluck(:id)).ids.sort
+      end
+    end
+  end
+
+  test "references to the exported account point to the new one" do
+    entropy = { id: ActiveRecord::Type::Uuid.generate, account_id: "exported", container_type: "Board", container_id: @board_id, auto_postpone_period: 7.days.to_i }
+    account_entropy = { id: ActiveRecord::Type::Uuid.generate, account_id: "exported", container_type: "Account", container_id: "exported", auto_postpone_period: 90.days.to_i }
+    zip = archive(boards: [ board_data ], users: [ user_data ], entropies: [ entropy, account_entropy ])
+
+    with_zip_reader(zip) do |reader|
+      Account::DataTransfer::EntropyRecordSet.new(@account).tap do |record_set|
+        record_set.check(from: reader)
+        record_set.import(from: reader)
+      end
+    end
+
+    assert_equal 90.days.to_i, @account.reload.entropy.auto_postpone_period
+    assert_equal 7.days.to_i, Entropy.find(entropy[:id]).auto_postpone_period
+  end
+
+  private
+    def record_set_for(model)
+      Account::DataTransfer::RecordSet.new(account: @account, model: model)
+    end
+
+    def board_data
+      { id: @board_id, account_id: "exported", name: "Imported board", creator_id: @user_id, all_access: true, created_at: Time.current, updated_at: Time.current }
+    end
+
+    def user_data
+      { id: @user_id, account_id: "exported", name: "Imported person", role: "member", active: true }
+    end
+
+    def archive(file_ids: nil, **records)
+      build_zip do |writer|
+        writer.add_file "data/account.json", { id: "exported", name: "Exported" }.to_json
+
+        records.each do |table, rows|
+          rows.each_with_index do |row, index|
+            writer.add_file "data/#{table}/#{file_ids&.dig(table, index) || row[:id]}.json", row.to_json
+          end
+        end
+      end
+    end
+
+    def assert_integrity_error(message, zip, model)
+      error = with_zip_reader(zip) do |reader|
+        assert_raises(Account::DataTransfer::RecordSet::IntegrityError) { record_set_for(model).check(from: reader) }
+      end
+
+      assert_match message, error.message
+    end
+
+    def stub_const(klass, name, value)
+      original = klass.const_get(name)
+      klass.send(:remove_const, name)
+      klass.const_set(name, value)
+      yield
+    ensure
+      klass.send(:remove_const, name)
+      klass.const_set(name, original)
+    end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
