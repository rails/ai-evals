+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    untenanted { get new_account_import_path }
+
+    assert_response :success
+    assert_select "input[type=file][name=file]"
+  end
+
+  test "new requires signing in" do
+    sign_out
+    untenanted { get new_account_import_path }
+
+    assert_response :redirect
+    assert_no_match account_imports_path, response.location
+  end
+
+  test "importing a file creates a new account for it" do
+    assert_difference -> { Account.count }, +1 do
+      assert_difference -> { Account::Import.count }, +1 do
+        assert_enqueued_with(job: ImportAccountDataJob) do
+          untenanted { post account_imports_path, params: { file: export_file } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: import.account.slug)
+    assert_equal identities(:david), import.identity
+    assert import.file.attached?
+    assert_equal import.account.id, import.file.blob.account_id
+    assert identities(:david).users.find_by!(account: import.account).owner?
+    assert_empty import.account.boards, "the account isn't seeded with sample data"
+  end
+
+  test "files that aren't zip archives are turned away" do
+    assert_no_difference -> { Account.count } do
+      untenanted { post account_imports_path, params: { file: fixture_file_upload("avatar.svg", "image/svg+xml") } }
+    end
+
+    assert_redirected_to new_account_import_path(script_name: nil)
+    assert flash[:alert].present?
+  end
+
+  test "a file is required" do
+    assert_no_difference -> { Account.count } do
+      untenanted { post account_imports_path }
+    end
+
+    assert_redirected_to new_account_import_path(script_name: nil)
+  end
+
+  test "the status of an import can be followed in its account" do
+    untenanted { post account_imports_path, params: { file: export_file } }
+    import = Account::Import.last
+
+    get account_import_path(import, script_name: import.account.slug)
+    assert_response :success
+    assert_select "h1", text: "Importing your account…"
+
+    import.update!(status: :completed)
+    get account_import_path(import, script_name: import.account.slug)
+    assert_select "h1", text: "Your import is done"
+  end
+
+  test "imports can't be followed by other people" do
+    untenanted { post account_imports_path, params: { file: export_file } }
+    import = Account::Import.last
+    import.account.users.create!(name: "Kevin", identity: identities(:kevin), role: :admin)
+
+    logout_and_sign_in_as :kevin
+    get account_import_path(import, script_name: import.account.slug)
+
+    assert_response :not_found
+  end
+
+  private
+    def export_file
+      zip = build_zip { |writer| writer.add_file("data/account.json", { id: "exported", name: "Exported" }.to_json) }
+      Rack::Test::UploadedFile.new(StringIO.new(zip), "application/zip", true, original_filename: "export.zip")
+    end
+end
