@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "ten failures in a row over an hour deactivate the webhook" do
+    travel_to 1.hour.ago do
+      9.times { @tracker.record_delivery_of(failed_delivery) }
+    end
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert_not @webhook.reload.active?
+  end
+
+  test "a burst of failures shorter than an hour doesn't deactivate the webhook" do
+    travel_to 59.minutes.ago do
+      20.times { @tracker.record_delivery_of(failed_delivery) }
+    end
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert @webhook.reload.active?
+  end
+
+  test "fewer than ten failures over an hour don't deactivate the webhook" do
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+
+    8.times { @tracker.record_delivery_of(failed_delivery) }
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "a success breaks the streak" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.record_delivery_of(failed_delivery) }
+    end
+
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  private
+    def failed_delivery
+      webhook_deliveries(:unsuccessfully_completed)
+    end
+end
