--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "creating an event relays it later" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event action: "card_published"
+    end
+  end
+
+  test "relay to the active webhooks on the board that are subscribed to the action" do
+    unsubscribed = Webhook.create!(name: "Comments", url: "https://example.com/comments", board: boards(:writebook), subscribed_actions: %w[ comment_created ])
+    inactive = Webhook.create!(name: "Inactive", url: "https://example.com/inactive", board: boards(:writebook), subscribed_actions: %w[ card_published ], active: false)
+    other_board = Webhook.create!(name: "Elsewhere", url: "https://example.com/elsewhere", board: boards(:private), subscribed_actions: %w[ card_published ])
+
+    event = create_event action: "card_published"
+    event.relay_now
+
+    assert_equal [ webhooks(:active) ], event.webhook_deliveries.map(&:webhook)
+    [ unsubscribed, inactive, other_board ].each { assert_empty it.deliveries }
+  end
+
+  test "relaying an event again doesn't deliver it twice" do
+    event = create_event action: "card_published"
+
+    assert_difference -> { event.webhook_deliveries.count }, +1 do
+      2.times { event.relay_now }
+    end
+  end
+
+  test "the receiver gets a single POST when an event happens" do
+    stub_dns_resolution "93.184.216.34"
+    request = stub_request(:post, webhooks(:active).url).to_return(status: 200)
+
+    perform_enqueued_jobs do
+      create_event action: "card_published"
+    end
+
+    assert_requested request, times: 1
+    assert webhooks(:active).deliveries.ordered.first.succeeded?
+  end
+
+  test "relay events that happen outside of a request, with no current account" do
+    webhooks(:active).update!(subscribed_actions: %w[ card_auto_postponed ])
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    Current.account = nil
+
+    perform_enqueued_jobs do
+      Card.auto_postpone_all_due
+    end
+
+    assert_requested(:post, webhooks(:active).url, times: 1) do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "card_auto_postponed", payload["action"]
+      assert_match %r{/#{ActiveRecord::FixtureSet.identify("37signals")}/cards/#{cards(:logo).number}\z}, payload.dig("eventable", "url")
+    end
+  end
+
+  private
+    def create_event(action:)
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: action)
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
