+    assert_requested request, times: 1
+  end
+
+  test "deliver does nothing for deliveries that were already attempted" do
+    request = stub_request(:post, webhooks(:active).url)
+
+    %i[ in_progress successfully_completed unsuccessfully_completed errored ].each do |name|
+      delivery = webhook_deliveries(name)
+      assert_no_changes -> { delivery.reload.attributes } do
+        delivery.deliver
+      end
+    end
+
+    assert_not_requested request
+  end
+
+  test "deliver records a failed delivery with the delinquency tracker" do
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, webhooks(:active).url).to_return(status: 500)
+
+    delivery = pending_delivery.tap(&:deliver)
+
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhooks(:active).delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver records a successful delivery with the delinquency tracker" do
+    webhooks(:active).delinquency_tracker.update!(consecutive_failures_count: 3, first_failure_at: 1.minute.ago)
+    stub_dns_resolution PUBLIC_IP
+    stub_request(:post, webhooks(:active).url).to_return(status: 204)
+
+    pending_delivery.deliver
+
+    assert_equal 0, webhooks(:active).delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver refuses receivers on private networks" do
+    stub_dns_resolution "169.254.169.254"
+    request = stub_request(:post, webhooks(:active).url)
+
+    delivery = pending_delivery.tap(&:deliver)
+
+    assert_not_requested request
+    assert delivery.failed?
+    assert_equal "private_uri", delivery.response[:error]
+    assert_equal 1, webhooks(:active).delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver logs network failures instead of raising" do
+    stub_dns_resolution PUBLIC_IP
+
+    {
+      Errno::ECONNREFUSED => "destination_unreachable",
+      Net::OpenTimeout => "connection_timeout",
+      OpenSSL::SSL::SSLError => "failed_tls",
+      Net::HTTPBadResponse => "invalid_response",
+      SocketError => "dns_lookup_failed"
+    }.each do |exception, error|
+      stub_request(:post, webhooks(:active).url).to_raise(exception)
+
+      delivery = pending_delivery.tap(&:deliver)
+
+      assert delivery.completed?, "#{exception} should be logged"
+      assert delivery.failed?
+      assert_equal error, delivery.response[:error]
+    end
+  end
+
+  test "deliver marks the delivery errored and raises when something unexpected happens" do
+    stub_dns_resolution PUBLIC_IP
+    delivery = pending_delivery
+    delivery.stubs(:payload).raises(RuntimeError, "Boom")
+
+    assert_raises(RuntimeError) { delivery.deliver }
+    assert delivery.reload.errored?
+  end
+
+  test "deliver doesn't send to a webhook that was switched off since the event happened" do
+    request = stub_request(:post, webhooks(:active).url)
+    delivery = pending_delivery
+    webhooks(:active).deactivate
+
+    delivery.deliver
+
+    assert_not_requested request
+    assert_equal "webhook_inactive", delivery.reload.response[:error]
+  end
+
+  test "deliver formats the payload for Slack" do
+    payload = deliver_to("https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx") # gitleaks:allow
+
+    assert_match %r{\ADavid commented on "Layout is broken" http://\S+/cards/\d+#comment_\w+\z}, JSON.parse(payload)["text"]
+  end
+
+  test "deliver formats the payload for Campfire" do
+    payload = deliver_to("https://campfire.example.com/rooms/1/2-bot-key/messages", content_type: "text/html")
+
+    assert_match "David commented on", payload
+    assert_match %r{<a href="http://\S+/cards/\d+#comment_\w+">}, payload
+    assert_no_match "<html", payload
+  end
+
+  test "deliver formats the payload for Basecamp" do
+    payload = deliver_to("https://3.basecamp.com/1/integrations/token/buckets/2/chats/3/lines")
+
+    assert_match "David commented on", JSON.parse(payload)["content"]
+  end
+
+  test "cleanup deletes deliveries older than a week" do
+    stale = webhooks(:active).deliveries.create!(event: events(:layout_commented), created_at: 1.week.ago - 1.minute)
+    recent = webhooks(:active).deliveries.create!(event: events(:layout_commented), created_at: 1.week.ago + 1.minute)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(stale.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
+
+  private
+    def pending_delivery
+      Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:layout_commented))
+    end
+
+    def deliver_to(url, content_type: "application/json")
+      stub_dns_resolution PUBLIC_IP
+      payload = nil
+      stub_request(:post, url).with(headers: { "Content-Type" => content_type }).to_return { |request| payload = request.body; {} }
+
+      webhook = Webhook.create!(name: "Chat", url: url, board: boards(:writebook))
+      webhook.deliveries.create!(event: events(:layout_commented)).deliver
+
+      assert_requested :post, url
+      payload
+    end
 end
