@@ -0,0 +1,20 @@
+require "test_helper"
+
+class Storage::MaterializeJobTest < ActiveJob::TestCase
+  test "runs one at a time per board, never alongside a recount" do
+    board = boards(:writebook)
+
+    assert_equal Storage::ReconcileJob.new(board).concurrency_key, Storage::MaterializeJob.new(board).concurrency_key
+    assert_not_equal Storage::MaterializeJob.new(boards(:private)).concurrency_key, Storage::MaterializeJob.new(board).concurrency_key
+  end
+
+  test "discards jobs for boards that have been deleted" do
+    board = boards(:writebook)
+    board.materialize_storage_later
+    board.delete
+
+    assert_no_difference -> { Storage::Total.count } do
+      perform_enqueued_jobs
+    end
+  end
+end
