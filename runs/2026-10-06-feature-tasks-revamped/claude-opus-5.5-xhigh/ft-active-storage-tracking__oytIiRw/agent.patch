new file mode 100644
index 0000000..1db8cf8
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,12 @@
+# The bytes stored by a board, or by all the boards in an account.
+#
+# Totals are only written by background jobs and use optimistic locking (lock_version), so a recount
+# never overwrites entries folded in while it was counting.
+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  def self.for(owner)
+    find_by(owner: owner) || create_or_find_by!(owner: owner, account: owner.account)
+  end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..43c2e45
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,21 @@
+# Accounts and boards: the owners of a storage total.
+#
+# Including models must implement:
+# - reconcile_storage: recalculate the total from the attachments themselves
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, as: :owner, class_name: "Storage::Total"
+  end
+
+  # Calculated in the background and kept up to date as attachments change. Queried every time, since
+  # the total changes independently of this record, and read-only so it's safe to call from replicas.
+  def bytes_used
+    Storage::Total.where(owner: self).pick(:bytes) || 0
+  end
+
+  def reconcile_storage_later
+    Storage::ReconcileJob.perform_later(self)
+  end
+end
diff --git a/app/models/storage/tracked.rb b/app/models/storage/tracked.rb
new file mode 100644
index 0000000..f53e9cd
--- /dev/null
+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,20 @@
+# Boards, cards, and comments: the records whose attachments count towards their board's storage
+# usage. That's card images, plus files embedded in their rich text (board descriptions, card
+# descriptions, and comments). See Storage::AttachmentTracking.
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  def track_storage(delta, board: storage_board)
+    if Storage.tracking? && delta.nonzero?
+      Storage::Entry.create!(board: board, card: storage_card, delta: delta)
+    end
+  end
+
+  def storage_board
+    board
+  end
+
+  def storage_card
+    card
+  end
+end
