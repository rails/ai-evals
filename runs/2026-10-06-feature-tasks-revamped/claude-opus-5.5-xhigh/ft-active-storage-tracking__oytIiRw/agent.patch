diff --git a/test/models/account/storage_usage_test.rb b/test/models/account/storage_usage_test.rb
new file mode 100644
index 0000000..9d14afa
--- /dev/null
+++ b/test/models/account/storage_usage_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Account::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+  end
+
+  test "bytes used adds up all the account's boards" do
+    assert_equal 0, @account.bytes_used
+
+    cards(:logo).image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    boards(:private).update! public_description: rich_text_embedding(upload_blob("b" * 20))
+    perform_enqueued_jobs
+
+    assert_equal 30, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "reconciling recounts every board" do
+    cards(:logo).image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    perform_enqueued_jobs
+    Storage.untracked { boards(:private).update! public_description: rich_text_embedding(upload_blob("b" * 20)) }
+    Storage::Total.find_by(owner: @account).update_columns(bytes: 1_000)
+
+    assert_enqueued_jobs 2, only: Storage::ReconcileJob do
+      @account.reconcile_storage
+    end
+    assert_equal 10, @account.bytes_used
+
+    perform_enqueued_jobs only: Storage::ReconcileJob
+    assert_equal 30, @account.bytes_used
+  end
+
+  test "the first change to any board counts everything already stored across the account" do
+    Storage.untracked do
+      boards(:private).update! public_description: rich_text_embedding(upload_blob("a" * 10))
+      cards(:logo).image.attach io: StringIO.new("b" * 20), filename: "b.txt"
+    end
+
+    cards(:layout).image.attach io: StringIO.new("c" * 30), filename: "c.txt"
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_equal 50, @account.bytes_used
+
+    perform_enqueued_jobs only: Storage::ReconcileJob # The account
+    perform_enqueued_jobs only: Storage::ReconcileJob # Its boards
+    assert_equal 60, @account.bytes_used
+  end
+
+  test "reconciling all accounts skips cancelled ones" do
+    accounts(:initech).cancel initiated_by: users(:mike)
+
+    Account.reconcile_all_storage_later
+
+    reconciled = enqueued_jobs.select { it["job_class"] == "Storage::ReconcileJob" }.map { GlobalID::Locator.locate(it["arguments"].first["_aj_globalid"]) }
+    assert_equal [ accounts(:acme), @account ].sort_by(&:id), reconciled.sort_by(&:id)
+  end
+
+  test "destroying the account deletes its storage records without tracking each attachment" do
+    cards(:logo).image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    perform_enqueued_jobs
+    cards(:layout).image.attach io: StringIO.new("b" * 20), filename: "b.txt"
+
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      @account.destroy!
+    end
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Storage::Total.where(account_id: @account.id)
+  end
+end
diff --git a/test/models/board/storage_usage_test.rb b/test/models/board/storage_usage_test.rb
new file mode 100644
index 0000000..7ecfb3f
--- /dev/null
+++ b/test/models/board/storage_usage_test.rb
@@ -0,0 +1,192 @@
+require "test_helper"
+
+class Board::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @image_size = file_fixture("moon.jpg").size
+  end
+
+  test "bytes used is calculated in the background" do
+    assert_equal 0, @board.bytes_used
+
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+    assert_equal @image_size, @board.bytes_used
+  end
+
+  test "card images count" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    perform_enqueued_jobs
+    assert_equal @image_size, @board.bytes_used
+
+    @card.reload.image.attach io: StringIO.new("small"), filename: "small.txt"
+    perform_enqueued_jobs
+    assert_equal 5, @board.bytes_used
+
+    @card.reload.image.purge_later
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "files embedded in the board description, card descriptions, and comments count" do
+    @board.update! public_description: rich_text_embedding(upload_blob("a" * 10))
+    @card.update! description: rich_text_embedding(upload_blob("b" * 20))
+    @card.comments.create! body: rich_text_embedding(upload_blob("c" * 30), upload_blob("d" * 40))
+    perform_enqueued_jobs
+
+    assert_equal 100, @board.bytes_used
+  end
+
+  test "removing embedded files" do
+    kept, removed = upload_blob("a" * 10), upload_blob("b" * 20)
+    comment = @card.comments.create!(body: rich_text_embedding(kept, removed))
+    perform_enqueued_jobs
+    assert_equal 30, @board.bytes_used
+
+    comment.update! body: rich_text_embedding(kept)
+    perform_enqueued_jobs
+    assert_equal 10, @board.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "other attachments don't count" do
+    assert_no_enqueued_jobs only: Storage::MaterializeJob do
+      users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png"
+      Account::Export.create!(account: accounts("37s"), user: users(:david)).build
+      upload_blob "Not attached to anything"
+    end
+
+    assert_empty Storage::Entry.all
+  end
+
+  test "moving a card moves its usage to the new board" do
+    @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    @card.update! description: rich_text_embedding(upload_blob("b" * 20))
+    @card.comments.create! body: rich_text_embedding(upload_blob("c" * 30))
+    perform_enqueued_jobs
+
+    @card.reload.move_to boards(:private)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 60, boards(:private).bytes_used
+  end
+
+  test "destroying a card releases its usage, including its comments'" do
+    @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    @card.comments.create! body: rich_text_embedding(upload_blob("b" * 20))
+    cards(:layout).image.attach io: StringIO.new("c" * 30), filename: "c.txt"
+    perform_enqueued_jobs
+
+    assert_difference -> { Storage::Entry.count }, +1 do
+      @card.reload.destroy!
+    end
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    assert_equal 30, @board.bytes_used
+  end
+
+  test "destroying the board releases its usage from the account" do
+    @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    boards(:private).update! public_description: rich_text_embedding(upload_blob("b" * 20))
+    perform_enqueued_jobs
+    @card.comments.create! body: rich_text_embedding(upload_blob("c" * 30))
+
+    assert_no_difference -> { Storage::Entry.where.not(board: @board).count } do
+      @board.destroy!
+    end
+    perform_enqueued_jobs
+
+    assert_equal 20, accounts("37s").bytes_used
+    assert_empty Storage::Entry.where(board_id: @board.id)
+    assert_not Storage::Total.exists?(owner_type: "Board", owner_id: @board.id)
+  end
+
+  test "materializing folds every pending entry at once" do
+    3.times { |index| cards(:logo, :layout, :text)[index].image.attach io: StringIO.new("a" * 10), filename: "a.txt" }
+    assert_equal 3, Storage::Entry.count
+
+    @board.materialize_storage
+
+    assert_equal 30, @board.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "the first materialization counts what was already stored" do
+    Storage.untracked { @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt" }
+
+    cards(:layout).image.attach io: StringIO.new("b" * 20), filename: "b.txt"
+    perform_enqueued_jobs
+
+    assert_equal 30, @board.bytes_used
+  end
+
+  test "reconciling corrects drift" do
+    @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    perform_enqueued_jobs
+    Storage.untracked { cards(:layout).image.attach io: StringIO.new("b" * 20), filename: "b.txt" }
+
+    @board.reconcile_storage
+
+    assert_equal 30, @board.bytes_used
+    assert_equal 30, accounts("37s").bytes_used
+  end
+
+  test "reconciling leaves pending entries to be folded, including those for cards moved away or destroyed" do
+    cards(:logo, :layout, :text).each { it.image.attach io: StringIO.new("a" * 10), filename: "a.txt" }
+    perform_enqueued_jobs
+
+    cards(:logo).move_to boards(:private)
+    cards(:layout).destroy!
+    cards(:shipping).image.attach io: StringIO.new("b" * 20), filename: "b.txt"
+
+    @board.reconcile_storage batch_size: 1
+    perform_enqueued_jobs
+
+    assert_equal 30, @board.bytes_used
+    assert_equal 10, boards(:private).bytes_used
+    assert_equal 40, accounts("37s").bytes_used
+  end
+
+  test "reconciling is exact when attachments change between batches" do
+    first_card, *, last_card = @board.cards.order(:id)
+
+    counted = 0
+    @board.define_singleton_method(:card_bytes) do |ids|
+      super(ids).tap do
+        if (counted += 1) == 1
+          first_card.image.attach io: StringIO.new("a" * 10), filename: "a.txt" # In a batch that's been counted
+          last_card.image.attach io: StringIO.new("b" * 20), filename: "b.txt"  # In a batch yet to be counted
+        end
+      end
+    end
+
+    @board.reconcile_storage batch_size: 2
+    perform_enqueued_jobs
+
+    assert_equal 30, @board.bytes_used
+  end
+
+  test "reconciling doesn't overwrite entries folded while counting" do
+    @card.image.attach io: StringIO.new("a" * 10), filename: "a.txt"
+    perform_enqueued_jobs
+
+    board, card = Board.find(@board.id), cards(:layout)
+    board.define_singleton_method(:description_bytes) do
+      super().tap do
+        card.image.attach io: StringIO.new("b" * 20), filename: "b.txt"
+        Board.find(id).materialize_storage
+      end
+    end
+
+    assert_raises(ActiveRecord::StaleObjectError) { board.reconcile_storage }
+  end
+end
