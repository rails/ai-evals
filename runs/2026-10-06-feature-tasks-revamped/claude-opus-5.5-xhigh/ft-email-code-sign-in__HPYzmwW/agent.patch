@@ -0,0 +1,65 @@
+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions" do
+    magic_link = identities(:kevin).magic_links.create!
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match magic_link.code, email.html_part.body.to_s
+    assert_match magic_link.code, email.text_part.body.to_s
+    assert_match "sign in", email.text_part.body.to_s
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+
+  test "sign_in_instructions for sign up" do
+    magic_link = identities(:kevin).magic_links.create!(purpose: :sign_up)
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match "finish signing up", email.text_part.body.to_s
+  end
+  test "sign_in_instructions logs the code when email isn't set up" do
+    magic_link = identities(:kevin).magic_links.create!
+    MagicLinkMailer.any_instance.stubs(:delivery_method).returns(:smtp)
+    MagicLinkMailer.any_instance.stubs(:smtp_settings).returns(address: "localhost", port: 25)
+
+    assert_logged "kevin@37signals.com: #{magic_link.code}" do
+      MagicLinkMailer.sign_in_instructions(magic_link).message
+    end
+  end
+
+  test "sign_in_instructions doesn't log the code when email is set up" do
+    magic_link = identities(:kevin).magic_links.create!
+    MagicLinkMailer.any_instance.stubs(:delivery_method).returns(:smtp)
+    MagicLinkMailer.any_instance.stubs(:smtp_settings).returns(address: "smtp.example.com", port: 587)
+
+    assert_not_logged magic_link.code do
+      MagicLinkMailer.sign_in_instructions(magic_link).message
+    end
+  end
+
+  private
+    def capture_log
+      output = StringIO.new
+      original = ActionMailer::Base.logger
+      ActionMailer::Base.logger = ActiveSupport::Logger.new(output)
+      yield
+      output.string
+    ensure
+      ActionMailer::Base.logger = original
+    end
+
+    def assert_logged(text, &block)
+      assert_includes capture_log(&block), text
+    end
+
+    def assert_not_logged(text, &block)
+      assert_not_includes capture_log(&block), text
+    end
+end
