--- /dev/null
+++ b/app/mailers/magic_link_mailer.rb
@@ -0,0 +1,20 @@
+class MagicLinkMailer < ApplicationMailer
+  def sign_in_instructions(magic_link)
+    @magic_link = magic_link
+    @identity = magic_link.identity
+
+    log_code unless email_delivery_configured?
+
+    mail to: @identity.email_address, subject: "Your Fizzy code is #{@magic_link.code}"
+  end
+
+  private
+    # Lets people sign in to an instance that can't send email yet, as described in docs/docker-deployment.md.
+    def log_code
+      logger.info "Email isn't set up, so here's the Fizzy code for #{@identity.email_address}: #{@magic_link.code}"
+    end
+
+    def email_delivery_configured?
+      !(delivery_method == :smtp && smtp_settings[:address] == "localhost")
+    end
+end
