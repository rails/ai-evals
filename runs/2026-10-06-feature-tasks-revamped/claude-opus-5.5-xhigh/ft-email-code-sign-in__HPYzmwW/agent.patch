+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "create generates a code and an expiration" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert magic_link.code.chars.all? { |char| char.in?(MagicLink::Code::ALPHABET) }
+    assert_in_delta MagicLink::EXPIRATION_TIME.from_now, magic_link.expires_at, 1.second
+    assert magic_link.for_sign_in?
+  end
+
+  test "codes are unique" do
+    existing = @identity.magic_links.create!
+
+    duplicate = @identity.magic_links.new(code: existing.code)
+    assert_not duplicate.valid?
+    assert duplicate.errors[:code].any?
+  end
+
+  test "consume returns the magic link and destroys it" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume works only once" do
+    magic_link = @identity.magic_links.create!
+
+    assert MagicLink.consume(magic_link.code)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume accepts lowercase, spacing and lookalike characters" do
+    magic_link = @identity.magic_links.create!(code: "0A1B2C")
+
+    assert_equal magic_link, MagicLink.consume(" oa-ib 2c ")
+  end
+
+  test "consume works for fifteen minutes" do
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes - 1.second
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+  end
+
+  test "consume rejects expired codes" do
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes + 1.second
+    assert_nil MagicLink.consume(magic_link.code)
+    assert MagicLink.exists?(magic_link.id), "expired links are left for cleanup"
+  end
+
+  test "consume rejects unknown and blank codes" do
+    @identity.magic_links.create!
+
+    assert_nil MagicLink.consume("ZZZZZZ")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+  end
+
+  test "cleanup deletes only stale magic links" do
+    active = @identity.magic_links.create!
+    stale = @identity.magic_links.create!(expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+
+  test "destroying the identity deletes its magic links" do
+    magic_link = @identity.magic_links.create!
+
+    @identity.destroy!
+
+    assert_not MagicLink.exists?(magic_link.id)
+  end
+end
