new file mode 100644
index 0000000..3b051da
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,56 @@
+module Authentication::ViaMagicLink
+  private
+    def redirect_to_session_magic_link(magic_link, return_to: nil)
+      serve_development_magic_link magic_link
+      redirect_to_code_entry_for magic_link.identity.email_address, expires_at: magic_link.expires_at, return_to: return_to
+    end
+
+    # Responds just like a code was sent, so the response doesn't reveal which email addresses have an identity.
+    def redirect_to_fake_session_magic_link(email_address, return_to: nil)
+      redirect_to_code_entry_for email_address, expires_at: MagicLink::EXPIRATION_TIME.from_now, return_to: return_to
+    end
+
+    def redirect_to_code_entry_for(email_address, expires_at:, return_to:)
+      set_pending_authentication_token email_address, expires_at: expires_at
+      session[:return_to_after_authenticating] = return_to if return_to
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def serve_development_magic_link(magic_link)
+      if Rails.env.development?
+        flash[:magic_link_code] = magic_link.code
+        response.set_header "X-Magic-Link-Code", magic_link.code
+      end
+    end
+
+    def set_pending_authentication_token(email_address, expires_at:)
+      cookies[:pending_authentication_token] = {
+        value: pending_authentication_token_verifier.generate(email_address, expires_at: expires_at),
+        httponly: true,
+        same_site: :lax,
+        expires: expires_at
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def email_address_pending_authentication
+      if pending_authentication_token.present?
+        pending_authentication_token_verifier.verified(pending_authentication_token)
+      end
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete :pending_authentication_token
+    end
+
+    def pending_authentication_token_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+end
