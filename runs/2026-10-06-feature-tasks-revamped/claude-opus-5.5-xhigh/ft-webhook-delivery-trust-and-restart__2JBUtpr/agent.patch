diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..1b354d9
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,36 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  DELINQUENCY_THRESHOLD = 10
+  DELINQUENCY_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery_of(delivery)
+    with_lock do
+      if delivery.succeeded?
+        reset
+      else
+        record_failure
+      end
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    def record_failure
+      increment :consecutive_failures_count
+      self.first_failure_at ||= Time.current
+      save!
+
+      webhook.deactivate if delinquent?
+    end
+
+    # Switch off receivers that keep failing: enough failures in a row, spread over long enough
+    # that it isn't just a brief outage meeting a burst of events.
+    def delinquent?
+      consecutive_failures_count >= DELINQUENCY_THRESHOLD && first_failure_at <= DELINQUENCY_PERIOD.ago
+    end
+end
