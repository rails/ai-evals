@@ -1,4 +1,8 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  ENDPOINT_TIMEOUT = 7.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +13,26 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where created_at: ...RETENTION_PERIOD.ago }
+
+  after_create_commit :deliver_later
+
+  def self.cleanup
+    stale.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Whoever claims a pending delivery gets to send it, so even if the job runs twice the
+  # receiver hears about the event once. Deliveries are never retried, whatever the outcome.
+  def deliver
+    if claim
+      post
+      webhook.delinquency_tracker.record_delivery_of(self)
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +53,114 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def post
+      self.request = { headers: headers }
+      self.response = perform_request
+      completed!
+    rescue
+      errored!
+      raise
+    end
+
+    def perform_request
+      if resolved_ip
+        http.request(post_request) do |response|
+          # All we need is the status, so don't wait for the body
+          return { code: response.code.to_i }
+        end
+      else
+        { error: :private_uri }
+      end
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError
+      { error: :dns_lookup_failed }
+    rescue Timeout::Error, Errno::ETIMEDOUT
+      { error: :connection_timeout }
+    rescue OpenSSL::SSL::SSLError
+      { error: :failed_tls }
+    rescue SystemCallError, IOError
+      { error: :destination_unreachable }
+    rescue Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError
+      { error: :invalid_response }
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.hostname)
+    end
+
+    def uri
+      @uri ||= URI(webhook.url)
+    end
+
+    # Connect straight to the vetted IP. A proxy would resolve the host again, undoing the SSRF check.
+    def http
+      Net::HTTP.new(uri.hostname, uri.port, nil).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def content_type
+      webhook.for_campfire? ? "text/html" : "application/json"
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= if webhook.for_campfire?
+        render_event(:html)
+      elsif webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      elsif webhook.for_slack?
+        { text: html_to_mrkdwn(render_event(:html)) }.to_json
+      else
+        render_event(:json)
+      end
+    end
+
+    def render_event(format)
+      ApplicationController.renderer.new(script_name: account.slug)
+        .render template: "webhooks/event", formats: format, assigns: { event: event }, layout: false
+    end
+
+    # Slack doesn't render HTML: links are written as <url|text>, and only &, < and > are escaped
+    def html_to_mrkdwn(html)
+      Nokogiri::HTML5.fragment(html).children.map do |node|
+        if node.name == "a"
+          "<#{node["href"]}|#{escape_mrkdwn(node.text)}>"
+        else
+          escape_mrkdwn(node.text)
+        end
+      end.join.squish
+    end
+
+    def escape_mrkdwn(text)
+      text.gsub(/[&<>]/, "&" => "&amp;", "<" => "&lt;", ">" => "&gt;")
+    end
 end
