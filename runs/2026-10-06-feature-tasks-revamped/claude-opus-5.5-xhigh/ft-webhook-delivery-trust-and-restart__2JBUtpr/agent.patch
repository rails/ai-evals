+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    unless account.cancelled?
+      board.webhooks.active.find_each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+  end
+end
