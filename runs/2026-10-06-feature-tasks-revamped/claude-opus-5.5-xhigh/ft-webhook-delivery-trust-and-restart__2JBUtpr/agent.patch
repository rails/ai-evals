diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..fa0a0b3
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "failures are counted from the first one" do
+    freeze_time
+
+    record_failures 3
+
+    assert_equal 3, @tracker.consecutive_failures_count
+    assert_equal Time.current, @tracker.first_failure_at
+  end
+
+  test "a success resets the count" do
+    record_failures 3
+    record succeeded_delivery
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "ten failures in a row over an hour switch the webhook off" do
+    freeze_time
+    record_failures 1
+
+    travel 1.hour do
+      record_failures 8
+      assert @webhook.reload.active?
+
+      record_failures 1
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "a burst of failures within the hour doesn't switch the webhook off" do
+    freeze_time
+    record_failures 1
+
+    travel 59.minutes do
+      record_failures 20
+      assert @webhook.reload.active?
+    end
+
+    travel 1.hour do
+      record_failures 1
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures don't switch the webhook off, however long they take" do
+    9.times do |i|
+      travel(i.hours) { record_failures 1 }
+    end
+
+    assert @webhook.reload.active?
+  end
+
+  test "a success in between starts over" do
+    record_failures 9
+
+    travel 2.hours do
+      record succeeded_delivery
+      record_failures 9
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "errored deliveries count as failures" do
+    record webhook_deliveries(:errored)
+
+    assert_equal 1, @tracker.consecutive_failures_count
+  end
+
+  private
+    def record_failures(count)
+      count.times { record webhook_deliveries(:unsuccessfully_completed) }
+    end
+
+    def succeeded_delivery
+      webhook_deliveries(:successfully_completed)
+    end
+
+    def record(delivery)
+      @tracker.record_delivery_of(delivery)
+    end
+end
