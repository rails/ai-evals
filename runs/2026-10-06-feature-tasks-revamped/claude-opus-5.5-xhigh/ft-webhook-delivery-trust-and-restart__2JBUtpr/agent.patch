diff --git a/test/models/event/relaying_test.rb b/test/models/event/relaying_test.rb
new file mode 100644
index 0000000..fe413bd
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:text_published)
+  end
+
+  test "new events are relayed" do
+    assert_enqueued_with job: Event::RelayJob do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+  end
+
+  test "new events are posted to webhooks" do
+    stub_dns_resolution "93.184.216.34"
+    request = stub_request(:post, webhooks(:active).url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      Current.set(user: users(:david)) { cards(:logo).close }
+    end
+
+    assert_requested request, times: 1
+    assert webhooks(:active).deliveries.ordered.first.succeeded?
+  end
+
+  test "relay to the subscribed webhooks of the event's board" do
+    other_board_webhook = Webhook.create!(board: boards(:private), name: "Elsewhere", url: "https://example.com/elsewhere", subscribed_actions: %w[ card_published ])
+
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      @event.relay_now
+    end
+
+    assert webhooks(:active).deliveries.exists?(event: @event)
+    assert_not other_board_webhook.deliveries.exists?(event: @event)
+  end
+
+  test "inactive webhooks don't get events" do
+    webhooks(:active).deactivate
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @event.relay_now
+    end
+  end
+
+  test "relaying an event again doesn't deliver it again" do
+    @event.relay_now
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @event.relay_now
+    end
+  end
+
+  test "events of cancelled accounts aren't relayed" do
+    @event.account.cancel(initiated_by: users(:david))
+    assert @event.account.cancelled?
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @event.reload.relay_now
+    end
+  end
+end
