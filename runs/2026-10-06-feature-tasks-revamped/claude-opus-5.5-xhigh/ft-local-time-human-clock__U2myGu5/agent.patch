diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..2fc55a0
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag sends the UTC timestamp for the browser to put into words" do
+    assert_dom_equal <<~HTML.squish, local_datetime_tag(Time.utc(2025, 9, 12, 20, 42), style: :ago)
+      <time datetime="2025-09-12T20:42:00Z" data-local-time-target="time" data-local-time-style="ago"
+        data-action="turbo:morph-element->local-time#refresh:self"></time>
+    HTML
+  end
+
+  test "local_datetime_tag renders the same markup in every timezone" do
+    time = Time.utc(2025, 9, 12, 20, 42)
+
+    tokyo = Time.use_zone("Asia/Tokyo") { local_datetime_tag(time.in_time_zone, style: :relative) }
+    los_angeles = Time.use_zone("America/Los_Angeles") { local_datetime_tag(time.in_time_zone, style: :relative) }
+
+    assert_equal tokyo, los_angeles
+  end
+
+  test "local_datetime_tag does not convert the given time" do
+    time = Time.new(2025, 9, 12, 13, 42, 0, "-07:00")
+
+    local_datetime_tag(time)
+
+    assert_equal "-07:00", time.formatted_offset
+  end
+
+  test "local_datetime_tag defaults to the time style" do
+    assert_dom_equal <<~HTML.squish, local_datetime_tag(Time.utc(2025, 9, 12, 20, 42))
+      <time datetime="2025-09-12T20:42:00Z" data-local-time-target="time" data-local-time-style="time"
+        data-action="turbo:morph-element->local-time#refresh:self"></time>
+    HTML
+  end
+
+  test "local_datetime_tag keeps other attributes, data and actions" do
+    assert_dom_equal <<~HTML.squish, local_datetime_tag(Time.utc(2025, 9, 12, 20, 42), style: :date, class: "stamp", data: { stamp_target: "date", action: "click->stamp#show" })
+      <time class="stamp" datetime="2025-09-12T20:42:00Z" data-stamp-target="date" data-local-time-target="time" data-local-time-style="date"
+        data-action="turbo:morph-element->local-time#refresh:self click->stamp#show"></time>
+    HTML
+  end
+end
diff --git a/test/integration/local_times_test.rb b/test/integration/local_times_test.rb
new file mode 100644
index 0000000..defd120
--- /dev/null
+++ b/test/integration/local_times_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class LocalTimesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "times are rendered the same for viewers in every timezone, for the browser to put into words" do
+    identities(:kevin).access_tokens.create!(description: "GitHub", permission: "read")
+
+    [
+      card_path(cards(:logo)),
+      card_path(cards(:shipping)),
+      notifications_path,
+      my_access_tokens_path
+    ].each do |path|
+      assert_equal times_seen_in("Asia/Tokyo", path), times_seen_in("America/Los_Angeles", path), "Times on #{path} depend on the viewer's timezone"
+    end
+  end
+
+  test "comments send their raw timestamp" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(cards(:logo))
+
+    assert_select "##{ActionView::RecordIdentifier.dom_id(comment)} .comment__permalink-title time[datetime=?][data-local-time-style=relative]", comment.created_at.utc.iso8601, text: ""
+  end
+
+  test "a card's meta, stamp, and closure message send their raw timestamps" do
+    card = cards(:shipping)
+
+    get card_path(card)
+
+    assert_select ".card__meta-text--added time[datetime=?][data-local-time-style=ago]", card.created_at.utc.iso8601
+    assert_select ".card__meta-text--updated time[datetime=?][data-local-time-style=ago]", card.last_active_at.utc.iso8601
+    assert_select ".card__closed-date time[datetime=?][data-local-time-style=date][data-bridge--stamp-target=description]", card.closed_at.utc.iso8601
+    assert_select ".card-perma__closure-message time[datetime=?]", card.closed_at.utc.iso8601
+    assert_select "[data-bridge--share-target=description] time", 2
+  end
+
+  test "the auto-close notice sends the raw timestamp" do
+    card = cards(:logo)
+
+    get card_path(card)
+
+    assert_select "##{ActionView::RecordIdentifier.dom_id(card, :closure_notice)}", text: /Moves to “Not Now”\s+if there’s no activity/ do
+      assert_select "time[datetime=?][data-local-time-style=upcoming]", card.entropy.auto_clean_at.utc.iso8601
+    end
+  end
+
+  test "the activity timeline sends raw timestamps for its days and hours" do
+    day = 1.week.ago
+
+    get events_days_path(day: day.to_date)
+
+    assert_select ".events__column-header time[datetime][data-local-time-style=day]", 3
+    assert_select ".event__timestamp time[datetime][data-local-time-style=time]"
+  end
+
+  private
+    def times_seen_in(timezone, path)
+      cookies[:timezone] = timezone
+      get path
+      assert_response :success
+
+      css_select("time").map(&:to_html).tap do |times|
+        assert times.any?, "Expected #{path} to show some times"
+      end
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..788226a
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,166 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "times read in the viewer's own timezone" do
+    now = Time.current.in_time_zone("America/Los_Angeles")
+    today = now.beginning_of_day + 1.minute
+    last_night = now.beginning_of_day - 1.hour
+    earlier_this_week = now.beginning_of_day - 4.days - 12.hours
+    long_ago = now - 20.days
+
+    comments = [ today, last_night, earlier_this_week, long_ago ].map do |created_at|
+      @card.comments.create!(creator: users(:kevin), body: "Posted at #{created_at}", created_at:)
+    end
+
+    in_browser_timezone "America/Los_Angeles" do
+      sign_in_as users(:david)
+      visit card_url(@card)
+
+      assert_equal [ "12:01 AM", "yesterday", "5 days ago", long_ago.strftime(long_ago.year == now.year ? "%b %-d" : "%b %-d, %Y") ],
+        comments.map { local_time_text(it) }
+    end
+  end
+
+  test "html cached for one viewer reads right for another in a different timezone" do
+    @comment.update_columns created_at: Time.utc(2025, 9, 12, 20, 42)
+
+    with_fragment_caching do
+      in_browser_timezone "Asia/Tokyo", session: :tokyo do
+        sign_in_as users(:kevin)
+        visit card_url(@card)
+        assert_equal "Saturday, September 13, 2025 at 5:42 AM", local_time_title(@comment)
+      end
+
+      in_browser_timezone "America/Los_Angeles", session: :los_angeles do
+        sign_in_as users(:david)
+        visit card_url(@card)
+        assert_equal "Friday, September 12, 2025 at 1:42 PM", local_time_title(@comment)
+      end
+    end
+  end
+
+  test "a card auto-closing overnight reads tomorrow, further out in a number of days" do
+    now = Time.current.in_time_zone("America/Los_Angeles")
+
+    in_browser_timezone "America/Los_Angeles" do
+      sign_in_as users(:david)
+
+      @card.update_columns last_active_at: now.end_of_day + 1.minute - @card.entropy.auto_clean_period
+      visit card_url(@card)
+      assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+      @card.update_columns last_active_at: now.beginning_of_day + 3.days + 12.hours - @card.entropy.auto_clean_period, updated_at: Time.current
+      visit card_url(@card)
+      assert_selector "##{dom_id(@card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+    end
+  end
+
+  test "card meta emphasizes the value and keeps it through a morphing page refresh" do
+    @card.update_columns last_active_at: 5.minutes.ago
+
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :meta)} .card__meta-text--updated" do
+      assert_selector "time .local-time-value", text: "5"
+      assert_text "UPDATED 5 MINUTES AGO"
+    end
+
+    # Morphing keeps the same element but resets it to the empty one sent by the server
+    page.execute_script "document.querySelector('##{dom_id(@card, :meta)} .card__meta-text--updated time').kept = true"
+    page.execute_script "document.querySelector('##{dom_id(@card, :meta)}').dataset.morphed = 'not yet'"
+    page.execute_script "Turbo.visit(location.href, { action: 'replace' })"
+    assert_no_selector "[data-morphed]"
+
+    assert evaluate_script("document.querySelector('##{dom_id(@card, :meta)} .card__meta-text--updated time').kept")
+    within "##{dom_id(@card, :meta)} .card__meta-text--updated" do
+      assert_text "UPDATED 5 MINUTES AGO"
+    end
+  end
+
+  test "formatting styles" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    now = "2025-09-15T23:30:00Z" # 4:30 PM on Monday in Los Angeles; 8:30 AM on Tuesday in Tokyo
+    {
+      [ "America/Los_Angeles", "2025-09-15T23:29:30Z", "ago" ]      => "just now",
+      [ "America/Los_Angeles", "2025-09-15T23:31:00Z", "ago" ]      => "just now",
+      [ "America/Los_Angeles", "2025-09-15T23:25:00Z", "ago" ]      => "5 minutes ago",
+      [ "America/Los_Angeles", "2025-09-15T21:30:00Z", "ago" ]      => "2 hours ago",
+      [ "America/Los_Angeles", "2025-09-15T06:00:00Z", "ago" ]      => "yesterday",
+      [ "America/Los_Angeles", "2025-09-10T19:00:00Z", "ago" ]      => "5 days ago",
+      [ "America/Los_Angeles", "2025-08-26T19:00:00Z", "ago" ]      => "Aug 26",
+      [ "America/Los_Angeles", "2025-09-15T21:42:00Z", "relative" ] => "2:42 PM",
+      [ "America/Los_Angeles", "2025-09-15T06:00:00Z", "relative" ] => "yesterday",
+      [ "Asia/Tokyo",          "2025-09-15T13:00:00Z", "relative" ] => "yesterday",
+      [ "America/Los_Angeles", "2025-09-10T19:00:00Z", "relative" ] => "5 days ago",
+      [ "America/Los_Angeles", "2025-09-08T19:00:00Z", "relative" ] => "Sep 8",
+      [ "America/Los_Angeles", "2024-09-08T19:00:00Z", "relative" ] => "Sep 8, 2024",
+      [ "America/Los_Angeles", "2025-09-16T02:00:00Z", "relative" ] => "7:00 PM",
+      [ "America/Los_Angeles", "2025-09-16T05:00:00Z", "upcoming" ] => "today",
+      [ "America/Los_Angeles", "2025-09-16T09:00:00Z", "upcoming" ] => "tomorrow",
+      [ "America/Los_Angeles", "2025-09-18T19:00:00Z", "upcoming" ] => "in 3 days",
+      [ "America/Los_Angeles", "2025-09-14T19:00:00Z", "upcoming" ] => "today",
+      [ "America/Los_Angeles", "2025-09-15T19:00:00Z", "day" ]      => "today",
+      [ "America/Los_Angeles", "2025-09-14T19:00:00Z", "day" ]      => "yesterday",
+      [ "America/Los_Angeles", "2025-09-12T19:00:00Z", "day" ]      => "Friday, September 12",
+      [ "America/Los_Angeles", "2025-09-12T20:42:00Z", "time" ]     => "1:42 PM",
+      [ "America/Los_Angeles", "2025-09-12T20:42:00Z", "date" ]     => "Sep 12, 2025",
+      [ "America/Los_Angeles", "2025-09-12T20:42:00Z", "datetime" ] => "9/12/25, 1:42 PM",
+      [ "Asia/Tokyo",          "2025-09-12T20:42:00Z", "datetime" ] => "9/13/25, 5:42 AM",
+      [ "America/Los_Angeles", "2025-09-12T20:42:00Z", "full" ]     => "Friday, September 12, 2025 at 1:42 PM"
+    }.each do |(timezone, time, style), expected|
+      assert_equal expected, format_local_time(time, style, now:, timezone:), "#{style} for #{time} in #{timezone}"
+    end
+  end
+
+  private
+    # The browser reports its timezone in a cookie, which the server then renders pages with
+    def sign_in_as(user)
+      super
+
+      page.document.synchronize do
+        raise Capybara::ExpectationNotMet, "The timezone cookie isn't set yet" unless evaluate_script("document.cookie").include?("timezone=")
+      end
+    end
+
+    def in_browser_timezone(timezone, session: Capybara.session_name)
+      Capybara.using_session(session) do
+        page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: timezone
+        yield
+      end
+    end
+
+    def with_fragment_caching
+      cache_store, perform_caching = ActionController::Base.cache_store, ActionController::Base.perform_caching
+      ActionController::Base.cache_store, ActionController::Base.perform_caching = ActiveSupport::Cache::MemoryStore.new, true
+      yield
+    ensure
+      ActionController::Base.cache_store, ActionController::Base.perform_caching = cache_store, perform_caching
+    end
+
+    def local_time_text(comment)
+      find("##{dom_id(comment)} .comment__permalink-title time:not(:empty)")
+      evaluate_script "document.querySelector('##{dom_id(comment)} .comment__permalink-title time').textContent"
+    end
+
+    def local_time_title(comment)
+      find("##{dom_id(comment)} .comment__permalink-title time[title]")["title"]
+    end
+
+    def format_local_time(time, style, now:, timezone:)
+      evaluate_async_script <<~JS, time, style, now, timezone
+        const [ time, style, now, timezone, done ] = arguments
+        document.querySelector("meta[name=timezone]").content = timezone
+        import("helpers/local_time_helpers").then(({ formatLocalTime }) => done(formatLocalTime(new Date(time), style, new Date(now))))
+      JS
+    end
+end
