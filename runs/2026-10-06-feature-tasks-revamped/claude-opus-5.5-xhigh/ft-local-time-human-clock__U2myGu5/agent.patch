diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..be3f8f2
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,113 @@
+import { formatDate, formatRelativeToParts, isSameYear, signedDifferenceInDays } from "helpers/date_helpers"
+
+const MS_PER_MINUTE = 60 * 1000
+const MS_PER_HOUR = 60 * MS_PER_MINUTE
+const DAYS_IN_A_WEEK = 7
+
+// Words for a timestamp in the viewer's timezone, in one of these styles:
+//
+//   time      1:42 PM
+//   date      Sep 12, 2025
+//   datetime  9/12/25, 1:42 PM
+//   full      Friday, September 12, 2025 at 1:42 PM
+//   day       today · yesterday · Wednesday, September 10
+//   ago       just now · 5 minutes ago · 2 hours ago · yesterday · 5 days ago · Sep 12
+//   relative  1:42 PM · yesterday · 5 days ago · Sep 12
+//   upcoming  today · tomorrow · in 3 days
+export function formatLocalTime(date, style, now = new Date()) {
+  return localTimeParts(date, style, now).map(part => part.text).join("")
+}
+
+// Same as formatLocalTime, but split into parts that flag the value worth emphasizing:
+// "in 3 days" is [ { text: "in " }, { text: "3", value: true }, { text: " days" } ].
+export function localTimeParts(date, style, now = new Date()) {
+  const format = STYLES[style] ?? STYLES.time
+  return format(date, now)
+}
+
+const STYLES = {
+  time(date) {
+    return emphasized(formatDate(date, { timeStyle: "short" }))
+  },
+
+  date(date) {
+    return emphasized(formatDate(date, { dateStyle: "medium" }))
+  },
+
+  datetime(date) {
+    return emphasized(formatDate(date, { dateStyle: "short", timeStyle: "short" }))
+  },
+
+  full(date) {
+    return emphasized(formatDate(date, { dateStyle: "full", timeStyle: "short" }))
+  },
+
+  day(date, now) {
+    const days = daysAgo(date, now)
+
+    if (days <= 1) {
+      return relativeParts(-days, "day")
+    } else {
+      return emphasized(formatDate(date, withYearIfNotCurrent(date, now, { weekday: "long", month: "long", day: "numeric" })))
+    }
+  },
+
+  ago(date, now) {
+    const elapsed = now - date
+
+    if (elapsed < MS_PER_MINUTE) {
+      return emphasized("just now")
+    } else if (elapsed < MS_PER_HOUR) {
+      return relativeParts(-Math.floor(elapsed / MS_PER_MINUTE), "minute")
+    } else if (daysAgo(date, now) === 0) {
+      return relativeParts(-Math.floor(elapsed / MS_PER_HOUR), "hour")
+    } else {
+      return STYLES.relative(date, now)
+    }
+  },
+
+  relative(date, now) {
+    const days = daysAgo(date, now)
+
+    if (days === 0) {
+      return STYLES.time(date)
+    } else if (days < DAYS_IN_A_WEEK) {
+      return relativeParts(-days, "day")
+    } else {
+      return emphasized(formatDate(date, withYearIfNotCurrent(date, now, { month: "short", day: "numeric" })))
+    }
+  },
+
+  upcoming(date, now) {
+    return relativeParts(daysUntil(date, now), "day")
+  }
+}
+
+// Calendar days, not 24-hour periods, so that last night is "yesterday" and tonight is "tomorrow".
+// Clamped at zero so that a slightly fast or slow clock doesn't push a time into the wrong tense.
+function daysAgo(date, now) {
+  return Math.max(signedDifferenceInDays(date, now), 0)
+}
+
+function daysUntil(date, now) {
+  return Math.max(signedDifferenceInDays(now, date), 0)
+}
+
+function withYearIfNotCurrent(date, now, options) {
+  return isSameYear(date, now) ? options : { ...options, year: "numeric" }
+}
+
+function emphasized(text) {
+  return [ { text, value: true } ]
+}
+
+// "5 days ago" emphasizes the number; words like "yesterday" are the value as a whole.
+function relativeParts(amount, unit) {
+  const parts = formatRelativeToParts(amount, unit)
+
+  if (parts.some(part => part.type === "integer")) {
+    return parts.map(part => ({ text: part.value, value: part.type !== "literal" }))
+  } else {
+    return emphasized(parts.map(part => part.value).join(""))
+  }
+}
