diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..1d5ffd9
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,63 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, localTimeParts } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Fills in the <time> elements rendered by TimeHelper#local_datetime_tag, in the viewer's own
+// timezone, and keeps relative ones like "5 minutes ago" or "yesterday" current as time passes.
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.refreshAll(), REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", this.#refreshAllWhenVisible)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    document.removeEventListener("visibilitychange", this.#refreshAllWhenVisible)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  // Morphing puts back the empty element sent by the server
+  refresh({ currentTarget }) {
+    this.#render(currentTarget)
+  }
+
+  refreshAll() {
+    this.timeTargets.forEach(target => this.#render(target))
+  }
+
+  #refreshAllWhenVisible = () => {
+    if (document.visibilityState === "visible") this.refreshAll()
+  }
+
+  #render(target) {
+    const date = new Date(target.getAttribute("datetime"))
+    if (isNaN(date)) return
+
+    const parts = localTimeParts(date, target.dataset.localTimeStyle)
+    const text = parts.map(part => part.text).join("")
+    const title = formatLocalTime(date, "full")
+
+    // Only touch the DOM when the words change, to avoid needless mutations every refresh
+    if (target.textContent !== text) target.replaceChildren(...parts.map(partToNode))
+    if (target.title !== title) target.title = title
+  }
+}
+
+function partToNode({ text, value }) {
+  if (value) {
+    const span = document.createElement("span")
+    span.className = "local-time-value"
+    span.textContent = text
+    return span
+  } else {
+    return document.createTextNode(text)
+  }
+}
