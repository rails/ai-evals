+module Event::Webhookable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :dispatch_webhooks_later
+  end
+
+  # Creates one delivery per active webhook on the board subscribed to this
+  # event's action. Safe to call repeatedly: each webhook gets the event once.
+  def dispatch_webhooks
+    unless account.cancelled?
+      Webhook.triggered_by(self).find_each do |webhook|
+        webhook.trigger(self)
+      end
+    end
+  end
+
+  private
+    def dispatch_webhooks_later
+      Event::WebhookDispatchJob.perform_later(self)
+    end
+end
