@@ -0,0 +1,11 @@
+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  discard_on ActiveJob::DeserializationError
+
+  # No retries: a delivery is sent at most once, and Webhook::Delivery#deliver
+  # ignores deliveries that were already claimed, so running it again is a no-op.
+  def perform(delivery)
+    delivery.deliver
+  end
+end
