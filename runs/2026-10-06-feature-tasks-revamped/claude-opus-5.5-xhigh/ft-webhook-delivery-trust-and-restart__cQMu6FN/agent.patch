@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Event::WebhookDispatchJobTest < ActiveJob::TestCase
+  test "creates and queues deliveries for subscribed webhooks" do
+    event = events(:logo_assignment_david)
+
+    assert_difference -> { webhooks(:active).deliveries.where(event: event).count }, +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        Event::WebhookDispatchJob.perform_now(event)
+      end
+    end
+  end
+
+  test "running again doesn't create or queue more deliveries" do
+    event = events(:logo_assignment_david)
+    Event::WebhookDispatchJob.perform_now(event)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event::WebhookDispatchJob.perform_now(event)
+      end
+    end
+  end
+
+  test "uses the webhooks queue" do
+    assert_equal "webhooks", Event::WebhookDispatchJob.new.queue_name
+  end
+
+  test "is discarded when the event is gone" do
+    event = events(:logo_assignment_david)
+    Event::WebhookDispatchJob.perform_later(event)
+    event.destroy!
+
+    assert_nothing_raised { perform_enqueued_jobs only: Event::WebhookDispatchJob }
+  end
+end
