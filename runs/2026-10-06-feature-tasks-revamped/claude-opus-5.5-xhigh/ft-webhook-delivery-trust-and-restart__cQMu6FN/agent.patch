index 0000000..341d2d2
--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution("93.184.216.34")
+    @webhook = webhooks(:active) # On Writebook, subscribed to card_published, card_assigned, and card_closed
+  end
+
+  test "creating an event queues dispatching it to webhooks" do
+    assert_enqueued_with job: Event::WebhookDispatchJob do
+      create_event action: "card_closed"
+    end
+  end
+
+  test "dispatch_webhooks creates a delivery for each subscribed webhook" do
+    other = boards(:writebook).webhooks.create!(name: "Other", url: "https://example.com/other", subscribed_actions: %w[ card_closed ])
+    event = create_event action: "card_closed"
+
+    assert_difference -> { Webhook::Delivery.count }, +2 do
+      event.dispatch_webhooks
+    end
+
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+    assert_equal 1, other.deliveries.where(event: event).count
+  end
+
+  test "dispatch_webhooks ignores webhooks not subscribed to the event" do
+    event = create_event action: "comment_created", eventable: comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+  end
+
+  test "dispatch_webhooks ignores webhooks that are switched off" do
+    @webhook.deactivate
+    event = create_event action: "card_closed"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+  end
+
+  test "dispatch_webhooks ignores webhooks on other boards" do
+    event = create_event action: "card_closed", board: boards(:private), eventable: cards(:logo)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      event.dispatch_webhooks
+    end
+  end
+
+  test "dispatch_webhooks does nothing for cancelled accounts" do
+    accounts("37s").cancel(initiated_by: users(:david))
+    event = create_event action: "card_closed"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+  end
+
+  test "dispatch_webhooks delivers an event once however many times it's dispatched" do
+    event = create_event action: "card_closed"
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      3.times { event.dispatch_webhooks }
+    end
+  end
+
+  test "an event is posted to each subscribed receiver exactly once" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = perform_enqueued_jobs do
+      create_event action: "card_closed"
+    end
+
+    assert_requested request, times: 1
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    # Running everything again, as a retried job would, doesn't send it again
+    perform_enqueued_jobs do
+      Event::WebhookDispatchJob.perform_later(event)
+      Webhook::DeliveryJob.perform_later(delivery)
+    end
+
+    assert_requested request, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+  end
+
+  test "events created outside a request, like auto-postponing, are delivered with the account's URLs" do
+    @webhook.update!(subscribed_actions: %w[ card_auto_postponed ])
+    sent = nil
+    stub_request(:post, @webhook.url).to_return { |request| sent = request; { status: 200 } }
+
+    Current.without_account do
+      perform_enqueued_jobs do
+        cards(:logo).auto_postpone(user: accounts("37s").system_user)
+      end
+    end
+
+    payload = JSON.parse(sent.body)
+    assert_equal "card_auto_postponed", payload["action"]
+    assert_equal "http://example.com#{accounts("37s").slug}/cards/#{cards(:logo).number}", payload.dig("eventable", "url")
+  end
+
+  private
+    def create_event(action:, board: boards(:writebook), eventable: cards(:logo))
+      Event.create!(board: board, creator: users(:david), eventable: eventable, action: action)
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
