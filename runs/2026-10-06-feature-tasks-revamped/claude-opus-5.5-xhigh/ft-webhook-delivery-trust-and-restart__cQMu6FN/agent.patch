@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Webhooks::EndToEndTest < ActionDispatch::IntegrationTest
+  setup do
+    stub_dns_resolution("93.184.216.34")
+    sign_in_as :kevin
+  end
+
+  test "closing a card posts it to the board's webhook once, and the log shows how it went" do
+    webhook = webhooks(:active)
+    card = cards(:logo)
+    request = stub_request(:post, webhook.url).to_return(status: 202)
+
+    perform_enqueued_jobs do
+      post card_closure_path(card), as: :turbo_stream
+    end
+
+    assert_requested request, times: 1
+    delivery = webhook.deliveries.ordered.first
+    assert_equal "card_closed", delivery.event.action
+    assert delivery.succeeded?
+
+    get board_webhook_deliveries_path(webhook.board, webhook), as: :json
+    logged = @response.parsed_body.find { it["id"] == delivery.id }
+    assert_equal "completed", logged["state"]
+    assert_equal 202, logged.dig("response", "code")
+    assert_nil logged.dig("response", "error")
+    assert_equal "card_closed", logged.dig("event", "action")
+    assert_not logged.dig("request", "headers").key?("X-Webhook-Signature")
+
+    get board_webhook_path(webhook.board, webhook)
+    assert_select "##{ActionView::RecordIdentifier.dom_id(delivery)}", text: /Delivered \(HTTP 202\).*Card moved to “Done”/m
+  end
+
+  test "the log shows failures, and a receiver that keeps failing gets switched off" do
+    webhook = webhooks(:active)
+    request = stub_request(:post, webhook.url).to_return(status: 503)
+    webhook.delinquency_tracker.update!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+
+    perform_enqueued_jobs do
+      post card_closure_path(cards(:logo)), as: :turbo_stream
+    end
+
+    assert_requested request, times: 1
+    assert_not webhook.reload.active?
+
+    get board_webhook_path(webhook.board, webhook)
+    assert_select "li", text: /Failed: the response was HTTP 503/
+    assert_select "p", text: /switched off/
+    assert_select "button", text: "Reactivate"
+
+    # Switched off, so later events aren't posted
+    perform_enqueued_jobs do
+      post card_closure_path(cards(:layout)), as: :turbo_stream
+    end
+    assert_requested request, times: 1
+  end
+end
