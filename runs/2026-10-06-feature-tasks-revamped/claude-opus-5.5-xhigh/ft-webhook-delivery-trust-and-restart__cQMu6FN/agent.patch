@@ -0,0 +1,37 @@
+# Webhooks are delivered exactly once: one delivery per webhook and event, and
+# one delinquency tracker per webhook. Enforce both at the database level so
+# concurrent or repeated dispatches can't create duplicates.
+class AddUniqueIndexesForWebhookDelivery < ActiveRecord::Migration[8.2]
+  def up
+    remove_duplicates :webhook_deliveries, group_by: %w[ webhook_id event_id ]
+    remove_index :webhook_deliveries, :webhook_id
+    add_index :webhook_deliveries, %i[ webhook_id event_id ], unique: true
+
+    remove_duplicates :webhook_delinquency_trackers, group_by: %w[ webhook_id ]
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id, unique: true
+  end
+
+  def down
+    remove_index :webhook_delinquency_trackers, :webhook_id
+    add_index :webhook_delinquency_trackers, :webhook_id
+
+    remove_index :webhook_deliveries, %i[ webhook_id event_id ]
+    add_index :webhook_deliveries, :webhook_id
+  end
+
+  private
+    def remove_duplicates(table, group_by:)
+      columns = group_by.join(", ")
+
+      if select_value("SELECT 1 FROM #{table} GROUP BY #{columns} HAVING COUNT(*) > 1 LIMIT 1")
+        # The extra derived table lets MySQL select from the table being deleted from.
+        execute <<~SQL
+          DELETE FROM #{table}
+          WHERE id NOT IN (
+            SELECT id FROM (SELECT MIN(id) AS id FROM #{table} GROUP BY #{columns}) AS kept
+          )
+        SQL
+      end
+    end
+end
