diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..31cada2
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    stub_vapid_keys
+    @kevin = users(:kevin)
+  end
+
+  test "new notifications are pushed" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "notifications brought back to the tray by something new are pushed" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.read
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:logo_published), read_at: nil, unread_count: 1)
+    end
+  end
+
+  test "reading and unreading isn't pushed" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "notifications aren't pushed to people who haven't turned push on" do
+    assert_empty users(:david).push_subscriptions
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: users(:david), source: events(:layout_commented), creator: users(:kevin))
+    end
+  end
+
+  test "notifications aren't pushed without VAPID keys" do
+    Push.stubs(:vapid_private_key).returns(nil)
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push says what the tray says to each of the user's devices, and opens the card" do
+    notification = notifications(:layout_commented_kevin)
+    comment = comments(:layout_overflowing_david)
+    expected = {
+      "title" => "RE: Layout is broken",
+      "body" => "The text is overflowing the container.",
+      "path" => "#{accounts("37s").slug}/cards/#{cards(:layout).number}#comment_#{comment.id}",
+      "tag" => notification.id
+    }
+
+    Push::Subscription.any_instance.expects(:deliver).with { |message| JSON.parse(message) == expected }.twice
+
+    notification.push
+  end
+
+  test "push for a mention says who mentioned you" do
+    notification = notifications(:logo_mentioned_david)
+    users(:david).push_subscriptions.register(endpoint: "https://web.push.apple.com/david", **browser_push_keys)
+
+    Push::Subscription.any_instance.expects(:deliver).with do |message|
+      JSON.parse(message).slice("title", "body", "path") == {
+        "title" => "JZ @mentioned you",
+        "body" => notification.source.source.mentionable_content.truncate(200),
+        "path" => "#{accounts("37s").slug}/cards/#{cards(:logo).number}#comment_#{notification.source.source.id}"
+      }
+    end
+
+    notification.push
+  end
+
+  test "push skips notifications that were read in the meantime" do
+    notification = notifications(:layout_commented_kevin)
+    notification.read
+
+    Push::Subscription.any_instance.expects(:deliver).never
+
+    notification.push
+  end
+
+  test "push skips deactivated people" do
+    notification = notifications(:layout_commented_kevin)
+    @kevin.update!(active: false)
+
+    Push::Subscription.any_instance.expects(:deliver).never
+
+    notification.push
+  end
+
+  test "a device that fails doesn't keep the push from the others" do
+    chrome = stub_request(:post, push_subscriptions(:kevin_chrome).endpoint).to_raise(Net::OpenTimeout)
+    firefox = stub_request(:post, push_subscriptions(:kevin_firefox).endpoint).to_return(status: 201)
+
+    notifications(:layout_commented_kevin).push
+
+    assert_requested chrome
+    assert_requested firefox
+  end
+
+  test "what lands in the tray reaches the user's devices" do
+    notifications(:layout_commented_kevin).destroy
+    pushes = push_subscriptions(:kevin_chrome, :kevin_firefox).map do |subscription|
+      stub_request(:post, subscription.endpoint).to_return(status: 201)
+    end
+
+    perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::PushJob ] do
+      cards(:layout).comments.create!(creator: users(:david), body: "Pushing the fix now")
+    end
+
+    assert @kevin.notifications.find_by(card: cards(:layout))
+    pushes.each { |push| assert_requested push, times: 1 }
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..db0ce83
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  include PushTestHelper
+
+  setup do
+    stub_vapid_keys
+    @subscription = push_subscriptions(:kevin_chrome)
+  end
+
+  test "register a browser's subscription" do
+    assert_difference -> { users(:kevin).push_subscriptions.count }, +1 do
+      users(:kevin).push_subscriptions.register(endpoint: "https://web.push.apple.com/kevin-safari", **browser_push_keys)
+    end
+
+    subscription = users(:kevin).push_subscriptions.find_by!(endpoint: "https://web.push.apple.com/kevin-safari")
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "registering an endpoint again refreshes it" do
+    keys = browser_push_keys
+
+    assert_no_difference -> { Push::Subscription.count } do
+      users(:kevin).push_subscriptions.register(endpoint: @subscription.endpoint, **keys, session: sessions(:jz))
+    end
+
+    assert_equal keys.merge(session: sessions(:jz)), p256dh_key: @subscription.reload.p256dh_key, auth_key: @subscription.auth_key, session: @subscription.session
+  end
+
+  test "a browser shared between accounts gets a subscription for each user" do
+    assert_difference -> { Push::Subscription.count }, +1 do
+      users(:david).push_subscriptions.register(endpoint: @subscription.endpoint, **browser_push_keys)
+    end
+  end
+
+  test "endpoints must be on a push service" do
+    %w[
+      https://fcm.googleapis.com/fcm/send/abc
+      https://updates.push.services.mozilla.com/wpush/v2/abc
+      https://web.push.apple.com/abc
+      https://wns2-par02p.notify.windows.com/w/?token=abc
+      https://FCM.googleapis.com/fcm/send/abc
+    ].each do |endpoint|
+      assert Push::Subscription.new(user: users(:kevin), endpoint: endpoint, **browser_push_keys).valid?, "#{endpoint} should be allowed"
+    end
+
+    [
+      "http://fcm.googleapis.com/fcm/send/abc",
+      "https://example.com/push",
+      "https://fcm.googleapis.com.example.com/abc",
+      "https://evilfcm.googleapis.com/abc",
+      "https://fcm.googleapis.com@example.com/abc",
+      "https://169.254.169.254/latest/meta-data",
+      "https://[::1]/push",
+      "not a url",
+      ""
+    ].each do |endpoint|
+      subscription = Push::Subscription.new(user: users(:kevin), endpoint: endpoint, **browser_push_keys)
+      assert_not subscription.valid?, "#{endpoint.inspect} should be rejected"
+      assert subscription.errors[:endpoint].any?
+    end
+  end
+
+  test "keys must be able to encrypt pushes" do
+    compressed_key = Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_octet_string(:compressed), padding: false)
+    off_curve_key = Base64.urlsafe_encode64("\x04".b + SecureRandom.random_bytes(64), padding: false)
+
+    [ "123", "not base64!", compressed_key, off_curve_key ].each do |p256dh_key|
+      subscription = Push::Subscription.new(user: users(:kevin), endpoint: @subscription.endpoint, **browser_push_keys, p256dh_key: p256dh_key)
+      assert_not subscription.valid?
+      assert subscription.errors.added?(:p256dh_key, :invalid), "#{p256dh_key} should be rejected"
+    end
+
+    [ "456", Base64.urlsafe_encode64(SecureRandom.random_bytes(32)) ].each do |auth_key|
+      subscription = Push::Subscription.new(user: users(:kevin), endpoint: @subscription.endpoint, **browser_push_keys, auth_key: auth_key)
+      assert_not subscription.valid?
+      assert subscription.errors.added?(:auth_key, :invalid), "#{auth_key} should be rejected"
+    end
+  end
+
+  test "deliver sends the encrypted message to the push service" do
+    push = stub_request(:post, @subscription.endpoint)
+      .with(headers: { "Content-Encoding" => "aes128gcm", "Urgency" => "high", "Ttl" => 1.day.to_i.to_s })
+      .with { |request| request.headers["Authorization"].start_with?("vapid t=") && !request.body.include?("Hello") }
+      .to_return(status: 201)
+
+    @subscription.deliver({ title: "Hello" }.to_json)
+
+    assert_requested push
+  end
+
+  test "deliver forgets subscriptions the push service no longer knows" do
+    [ 404, 410 ].each do |status|
+      subscription = users(:kevin).push_subscriptions.register(endpoint: "https://fcm.googleapis.com/fcm/send/#{status}", **browser_push_keys)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      subscription.deliver({ title: "Hello" }.to_json)
+
+      assert subscription.destroyed?, "#{status} should remove the subscription"
+    end
+  end
+
+  test "deliver keeps subscriptions through temporary trouble" do
+    stub_request(:post, @subscription.endpoint)
+      .to_return(status: 503).then
+      .to_return(status: 429).then
+      .to_timeout.then
+      .to_raise(Net::HTTPClientException.new('403 "Forbidden"', nil)) # An egress proxy refusing to tunnel
+
+    4.times { @subscription.deliver({ title: "Hello" }.to_json) }
+
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "signing out of a browser stops pushes to it" do
+    assert_difference -> { users(:kevin).push_subscriptions.count }, -1 do
+      sessions(:kevin).destroy
+    end
+
+    assert Push::Subscription.exists?(push_subscriptions(:kevin_firefox).id)
+  end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
