+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include PushTestHelper
+
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+    @params = { endpoint: "https://fcm.googleapis.com/fcm/send/david-chrome", **browser_push_keys }
+  end
+
+  test "create registers this browser's subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @params }, as: :json,
+        headers: { "User-Agent" => "Mozilla/5.0 Chrome/141.0" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal @params.stringify_keys, subscription.attributes.slice("endpoint", "p256dh_key", "auth_key")
+    assert_equal identities(:david).sessions.last, subscription.session
+    assert_equal "Mozilla/5.0 Chrome/141.0", subscription.user_agent
+  end
+
+  test "create refreshes a browser registered before" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @params }, as: :json
+    refreshed_keys = browser_push_keys
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @params.merge(refreshed_keys) }, as: :json
+    end
+
+    assert_response :success
+    assert_equal refreshed_keys[:p256dh_key], @user.push_subscriptions.last.p256dh_key
+  end
+
+  test "create rejects endpoints that aren't on a push service" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @params.merge(endpoint: "https://169.254.169.254/latest") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the whole subscription" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @params.except(:auth_key) }, as: :json
+    assert_response :unprocessable_entity
+
+    post user_push_subscriptions_path(@user), params: { endpoint: @params[:endpoint] }
+    assert_response :bad_request
+  end
+
+  test "create only registers subscriptions for yourself" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "signing out stops pushes to this browser" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @params }, as: :json
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      sign_out
+    end
+  end
+end
