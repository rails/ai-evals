--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  include PushTestHelper
+
+  setup do
+    stub_vapid_keys
+    sign_in_as users(:david)
+  end
+
+  test "turn on push notifications for this device" do
+    set_notification_permission "prompt"
+    visit notifications_settings_url
+    fake_push_service endpoint: "https://fcm.googleapis.com/fcm/send/david-chrome"
+
+    click_on "Turn on push notifications"
+
+    assert_text "Push notifications are on for this device."
+    assert_no_button "Turn on push notifications"
+    assert users(:david).push_subscriptions.exists?(endpoint: "https://fcm.googleapis.com/fcm/send/david-chrome")
+  end
+
+  test "say so when Fizzy can't push through the browser's push service" do
+    set_notification_permission "prompt"
+    visit notifications_settings_url
+    fake_push_service endpoint: "https://push.example.com/david-browser"
+
+    click_on "Turn on push notifications"
+
+    assert_text "This browser can’t receive push notifications."
+    assert_empty users(:david).push_subscriptions
+  end
+
+  test "explain how to allow notifications when the browser blocks them" do
+    set_notification_permission "denied"
+    visit notifications_settings_url
+
+    assert_text "Notifications are blocked on this device."
+    assert_selector "[data-notifications-target=help] .notifications-help", visible: true
+    assert_no_button "Turn on push notifications"
+  end
+
+  private
+    # Chrome keeps permissions for the whole run, so set the one each test needs
+    def set_notification_permission(setting)
+      page.driver.browser.execute_cdp "Browser.setPermission", permission: { name: "notifications" }, setting: setting
+    end
+
+    # Headless Chrome has no push service, so stand in for the browser's side of it
+    def fake_push_service(endpoint:)
+      keys = browser_push_keys
+
+      page.execute_script <<~JS, endpoint, keys[:p256dh_key], keys[:auth_key]
+        const [ endpoint, p256dh, auth ] = arguments
+        let permission = "default", subscription = null
+
+        Object.defineProperty(Notification, "permission", { get: () => permission, configurable: true })
+        Notification.requestPermission = async () => permission = "granted"
+
+        PushManager.prototype.getSubscription = async () => subscription
+        PushManager.prototype.subscribe = async ({ applicationServerKey }) => subscription = {
+          endpoint, options: { applicationServerKey }, toJSON: () => ({ endpoint, keys: { p256dh, auth } })
+        }
+      JS
+    end
+end
