@@ -0,0 +1,23 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.register(**push_subscription_params, session: Current.session, user_agent: request.user_agent)
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..98f5182
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,120 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns on push notifications for the device you're using. It's on when this
+// browser's push subscription is registered for you, so whoever signs in next
+// on a shared browser has to turn it on for themselves.
+export default class extends Controller {
+  static targets = [ "button", "blockedMessage", "unsupportedMessage", "help", "details" ]
+  static classes = [ "on" ]
+  static values = { publicKey: String, subscriptionsUrl: String, endpoints: Array }
+
+  async connect() {
+    this.#render(await this.#currentState())
+  }
+
+  async subscribe() {
+    this.buttonTarget.disabled = true
+
+    try {
+      if (await Notification.requestPermission() === "granted") {
+        await this.#register(await this.#subscribe())
+      }
+
+      this.#render(await this.#currentState())
+    } catch (error) {
+      console.error("Couldn't turn on push notifications", error)
+      this.#render(error instanceof PushUnavailableError ? "unsupported" : "off")
+    } finally {
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async #currentState() {
+    if (!this.#supported) {
+      return "unsupported"
+    } else if (Notification.permission === "denied") {
+      return "blocked"
+    } else if (Notification.permission === "granted" && await this.#registered()) {
+      return "on"
+    } else {
+      return "off"
+    }
+  }
+
+  async #registered() {
+    const subscription = await (await this.#pushManager()).getSubscription()
+    return Boolean(subscription && this.#usesCurrentKey(subscription) && this.endpointsValue.includes(subscription.endpoint))
+  }
+
+  async #subscribe() {
+    const pushManager = await this.#pushManager()
+    const subscription = await pushManager.getSubscription()
+
+    if (subscription && this.#usesCurrentKey(subscription)) {
+      return subscription
+    } else {
+      // Subscriptions are bound to the key they were made with, so replace any made with an old one
+      await subscription?.unsubscribe()
+
+      try {
+        return await pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+      } catch (error) {
+        throw new PushUnavailableError("This browser has no push service", { cause: error })
+      }
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.endpointsValue = [ ...this.endpointsValue, endpoint ]
+    } else if (response.unprocessableEntity) {
+      throw new PushUnavailableError(`Fizzy can't push through ${new URL(endpoint).host}`)
+    } else {
+      throw new Error(`Registering the push subscription failed with ${response.statusCode}`)
+    }
+  }
+
+  #render(state) {
+    this.element.classList.toggle(this.onClass, state === "on")
+    this.buttonTarget.hidden = state !== "off"
+    this.blockedMessageTarget.hidden = state !== "blocked"
+    this.unsupportedMessageTarget.hidden = state !== "unsupported"
+    this.helpTarget.hidden = state !== "blocked" && state !== "unsupported"
+    this.detailsTargets.forEach(details => details.hidden = state !== "blocked")
+  }
+
+  async #pushManager() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager
+  }
+
+  #usesCurrentKey(subscription) {
+    const key = new Uint8Array(subscription.options.applicationServerKey ?? [])
+    const currentKey = this.#applicationServerKey
+
+    return key.length === currentKey.length && key.every((byte, index) => byte === currentKey[index])
+  }
+
+  get #applicationServerKey() {
+    return decodeBase64Url(this.publicKeyValue)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+}
+
+class PushUnavailableError extends Error {}
+
+function decodeBase64Url(string) {
+  const base64 = string.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(string.length / 4) * 4, "=")
+  return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+}
