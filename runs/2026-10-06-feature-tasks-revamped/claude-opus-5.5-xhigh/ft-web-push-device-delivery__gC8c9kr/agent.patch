+module PushTestHelper
+  # Push is off until there's a VAPID key pair, as when ops haven't provided one
+  def stub_vapid_keys
+    key = WebPush.generate_key
+    Push.stubs(:vapid_public_key).returns(key.public_key)
+    Push.stubs(:vapid_private_key).returns(key.private_key)
+  end
+
+  def browser_push_keys
+    { p256dh_key: Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2), padding: false),
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16), padding: false) }
+  end
+end
