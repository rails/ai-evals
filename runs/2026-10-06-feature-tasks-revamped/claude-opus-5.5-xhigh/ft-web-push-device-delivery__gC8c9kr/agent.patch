@@ -60,6 +60,43 @@ TurboOffline.addRule({
   })
 })
 
+// Push notifications say what the tray says, and open the card they're about
+self.addEventListener("push", (event) => {
+  const { title, body, path, tag } = event.data?.json() ?? {}
+
+  event.waitUntil(self.registration.showNotification(title ?? "Fizzy", {
+    body,
+    tag,
+    renotify: Boolean(tag),
+    icon: "/app-icon-192.png",
+    data: { path }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openInFizzy(event.notification.data?.path))
+})
+
+async function openInFizzy(path) {
+  const href = sameOriginUrl(path).href
+
+  const windows = await self.clients.matchAll({ type: "window" })
+  const client = windows.find((client) => client.url === href) ?? windows.find((client) => client.focused) ?? windows[0]
+
+  if (client) {
+    await client.focus()
+    if (client.url !== href) await client.navigate(href)
+  } else {
+    await self.clients.openWindow(href)
+  }
+}
+
+function sameOriginUrl(path) {
+  const url = new URL(path ?? "/", self.location.origin)
+  return url.origin === self.location.origin ? url : new URL("/", self.location.origin)
+}
+
 self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
