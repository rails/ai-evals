diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..72d9ebd 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -2,8 +2,15 @@ module Card::Entropic
   extend ActiveSupport::Concern
 
   included do
+    # Excludes closed and postponed cards with NOT IN subqueries instead of the outer joins in +active+.
+    # This query visits every card, and SQLite chooses between probing an outer-joined table's index and
+    # scanning it based on its statistics. Stale ones, like an ANALYZE taken while the install was small,
+    # make it scan all closures for each card, so the sweep slows down quadratically as cards accumulate.
+    # A NOT IN subquery is always checked against the card_id index.
     scope :due_to_be_postponed, -> do
-      active
+      published
+        .where.not(id: Closure.select(:card_id))
+        .where.not(id: Card::NotNow.select(:card_id))
         .joins(board: :account)
         .left_outer_joins(board: :entropy)
         .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
