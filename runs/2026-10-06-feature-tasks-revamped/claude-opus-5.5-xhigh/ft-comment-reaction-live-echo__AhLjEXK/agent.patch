diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..6cffcf3
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "reacting defaults the reacter to the current user and the account to the comment's" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "🎉")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal accounts("37s"), reaction.account
+  end
+
+  test "content is required" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert comment.reactions.build(content: "x" * 16).valid?
+    assert comment.reactions.build(content: "👍" * 16).valid?
+    assert_not comment.reactions.build(content: "x" * 17).valid?
+  end
+
+  test "surrounding whitespace is stripped from content" do
+    assert_equal "Nice", comments(:logo_agreement_kevin).reactions.create!(content: "  Nice \n").content
+  end
+
+  test "reactions are ordered by when they were left" do
+    comment = comments(:logo_agreement_kevin)
+    later = comment.reactions.create!(content: "Later")
+
+    assert_equal [ reactions(:david_great), later ], comment.reload.reactions.to_a
+  end
+
+  test "reacting touches the comment so cached comments refresh" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_changes -> { comment.reload.updated_at } do
+      travel 1.minute do
+        comment.reactions.create!(content: "🙌")
+      end
+    end
+  end
+
+  test "reacting counts as activity on the card" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      comments(:logo_agreement_kevin).reactions.create!(content: "🙌")
+    end
+  end
+
+  test "all emoji" do
+    assert Reaction.new(content: "👍❤️").all_emoji?
+    assert_not Reaction.new(content: "Great 👍").all_emoji?
+  end
+
+  test "reactions are deleted along with their comment" do
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(content: "Bye")
+
+    assert_difference -> { Reaction.count }, -2 do
+      comment.destroy!
+    end
+  end
+
+  test "preloaded comments include their reactions and reacters" do
+    comment = Comment.preloaded.find(comments(:logo_agreement_kevin).id)
+
+    assert comment.association(:reactions).loaded?
+    assert comment.reactions.first.association(:reacter).loaded?
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..28da950
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,241 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "reacting with some text" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Ship it"
+      click_on "Add your reaction"
+
+      within_reactions { assert_reaction "Ship it", by: users(:david) }
+      assert_no_field "Your reaction"
+      assert_link "Add a reaction"
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "Ship it", reaction.content
+    assert_equal users(:david), reaction.reacter
+
+    within "##{dom_id(reaction)}" do
+      find("span", text: "Ship it").click
+      click_on "Remove your reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reacting with an emoji from the picker" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      click_on "Party popper"
+
+      assert_field "Your reaction", with: "🎉"
+      send_keys :enter
+
+      within_reactions { assert_reaction "🎉", by: users(:david) }
+      assert_no_field "Your reaction"
+      assert_link "Add a reaction"
+    end
+  end
+
+  test "reacting again once the first reaction is in" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "First"
+      click_on "Add your reaction"
+      within_reactions { assert_reaction "First", by: users(:david) }
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Second"
+      send_keys :enter
+
+      within_reactions do
+        assert_reaction "First", by: users(:david)
+        assert_reaction "Second", by: users(:david)
+      end
+    end
+  end
+
+  test "reactions are limited to 16 characters" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "This is far too long for a reaction"
+      assert_field "Your reaction", with: "This is far too "
+    end
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_field "Your reaction"
+      assert_link "Add a reaction"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      send_keys :escape
+
+      assert_no_field "Your reaction"
+      assert_link "Add a reaction"
+    end
+
+    assert_no_text "Never mind"
+    assert_equal [ reactions(:kevin_thumbs_up) ], @comment.reactions.reload.to_a
+  end
+
+  test "removing your own reaction" do
+    reaction = reactions(:david_great)
+    visit card_url(@card)
+
+    within "##{dom_id(reaction)}" do
+      assert_no_button "Remove your reaction"
+
+      find("span", text: "Great idea").click
+      click_on "Remove your reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "other people's reactions can't be removed" do
+    visit card_url(@card)
+
+    within "##{dom_id(reactions(:kevin_thumbs_up))}" do
+      find("span", text: "👍").click
+      assert_no_button "Remove your reaction"
+    end
+  end
+
+  test "reactions are not offered on system comments" do
+    visit card_url(@card)
+
+    within "##{dom_id(comments(:logo_1))}", visible: :all do
+      assert_no_selector ".reactions", visible: :all
+    end
+  end
+
+  test "reactions from other people land without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    react_elsewhere as: users(:kevin), with: "Love it"
+
+    within_comment do
+      within_reactions { assert_reaction "Love it", by: users(:kevin), wait: 5 }
+    end
+  end
+
+  test "reactions removed by other people disappear without reloading" do
+    reaction = reactions(:kevin_thumbs_up)
+    visit card_url(@card)
+    assert_selector "##{dom_id(reaction)}"
+    wait_for_cable_subscriptions
+
+    reaction.destroy!
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  test "a reaction in progress survives reactions landing from other people" do
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Drafting"
+    end
+
+    wait_for_cable_subscriptions
+    react_elsewhere as: users(:kevin), with: "Love it"
+
+    within_comment do
+      within_reactions { assert_reaction "Love it", by: users(:kevin), wait: 5 }
+      assert_field "Your reaction", with: "Drafting"
+
+      click_on "Add your reaction"
+      within_reactions { assert_reaction "Drafting", by: users(:david) }
+      assert_link "Add a reaction"
+    end
+  end
+
+  test "your reactions stay removable after reactions land from other people" do
+    reaction = reactions(:david_great)
+    visit card_url(@card)
+    assert_selector "##{dom_id(reaction)}.reaction--deleteable [role=button][tabindex='0'][aria-expanded=false]"
+    wait_for_cable_subscriptions
+
+    react_elsewhere as: users(:kevin), with: "Love it", on: comments(:logo_agreement_kevin)
+    assert_text "Love it", wait: 5
+
+    assert_selector "##{dom_id(reaction)}.reaction--deleteable [role=button][tabindex='0'][aria-expanded=false]"
+    within "##{dom_id(reaction)}" do
+      find("span", text: "Great idea").click
+      click_on "Remove your reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+  end
+
+  test "a revealed remove button stays put when reactions land from other people" do
+    reaction = reactions(:david_great)
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within("##{dom_id(reaction)}") { find("span", text: "Great idea").click }
+    assert_button "Remove your reaction"
+
+    react_elsewhere as: users(:kevin), with: "Love it", on: comments(:logo_agreement_kevin)
+    assert_text "Love it", wait: 5
+
+    within("##{dom_id(reaction)}") { assert_button "Remove your reaction" }
+  end
+
+  private
+    def within_comment(comment = @comment, &block)
+      within "##{dom_id(comment)}", &block
+    end
+
+    def within_reactions(comment = @comment, &block)
+      within "##{dom_id(comment, :reactions)}", &block
+    end
+
+    def assert_reaction(content, by:, **options)
+      assert_selector ".reaction", text: content, **options do |reaction|
+        assert reaction.has_css?("img[title='#{by.name}']", visible: :all), "Expected #{content.inspect} to show it was left by #{by.name}"
+      end
+    end
+
+    def react_elsewhere(as:, with:, on: @comment)
+      on.reactions.create!(reacter: as, content: with)
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
