new file mode 100644
index 0000000..c11d3e7
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,49 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..efe4ce2
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,77 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions render inside comments that are cached for everyone, so whether the
+// current user can remove one is worked out here, in the browser. The attributes
+// added for that are kept when a broadcasted page refresh morphs the reaction.
+const PRESERVED_ATTRIBUTES = [ "class", "role", "tabindex", "aria-expanded" ]
+
+export default class extends Controller {
+  static targets = [ "toggle", "deleteButton" ]
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#deleteable) {
+      this.element.classList.add(this.deleteableClass)
+      this.toggleTarget.setAttribute("role", "button")
+      this.toggleTarget.setAttribute("tabindex", "0")
+      this.toggleTarget.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  toggle(event) {
+    if (!this.#deleteable || event.target.closest("a, form")) return
+
+    if (this.#expanded) {
+      this.collapse()
+    } else {
+      this.#expand({ focusDeleteButton: event.type === "keydown" })
+    }
+  }
+
+  collapse() {
+    if (!this.#expanded) return
+
+    const hadFocus = this.element.contains(document.activeElement)
+
+    this.element.classList.remove(this.expandedClass)
+    this.toggleTarget.setAttribute("aria-expanded", "false")
+
+    if (hadFocus) this.toggleTarget.focus()
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (this.#expanded && !this.element.contains(target)) this.collapse()
+  }
+
+  markDeleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  unmarkDeleting({ detail: { success } }) {
+    if (!success) this.element.classList.remove(this.deletingClass)
+  }
+
+  preserveState(event) {
+    const { target, detail: { attributeName } } = event
+
+    if ((target === this.element || target === this.toggleTarget) && PRESERVED_ATTRIBUTES.includes(attributeName)) {
+      event.preventDefault()
+    }
+  }
+
+  #expand({ focusDeleteButton }) {
+    this.element.classList.add(this.expandedClass)
+    this.toggleTarget.setAttribute("aria-expanded", "true")
+
+    if (focusDeleteButton) this.deleteButtonTarget.focus()
+  }
+
+  get #expanded() {
+    return this.element.classList.contains(this.expandedClass)
+  }
+
+  get #deleteable() {
+    return Current.user?.id === this.reacterIdValue
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..c3f9142
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input" ]
+
+  insert({ params: { content } }) {
+    const input = this.inputTarget
+    const start = input.selectionStart ?? input.value.length
+    const end = input.selectionEnd ?? input.value.length
+    const value = input.value.slice(0, start) + content + input.value.slice(end)
+
+    input.focus()
+
+    if (this.#fits(value)) {
+      input.value = value
+      input.setSelectionRange(start + content.length, start + content.length)
+      input.dispatchEvent(new Event("input", { bubbles: true }))
+    } else {
+      this.#reportTooLong()
+    }
+  }
+
+  #fits(value) {
+    return this.inputTarget.maxLength < 0 || value.length <= this.inputTarget.maxLength
+  }
+
+  #reportTooLong() {
+    const input = this.inputTarget
+
+    input.setCustomValidity(`Reactions can be up to ${input.maxLength} characters`)
+    input.reportValidity()
+    input.addEventListener("input", () => input.setCustomValidity(""), { once: true })
+  }
+}
