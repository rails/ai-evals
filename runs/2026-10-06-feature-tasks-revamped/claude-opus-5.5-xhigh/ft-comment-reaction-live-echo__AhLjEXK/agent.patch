@@ -0,0 +1,127 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @comment = comments(:logo_agreement_kevin)
+    @card = @comment.card
+  end
+
+  test "index" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)} ##{dom_id(reactions(:david_great))}", text: /Great idea/
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a[href=?]", new_card_comment_reaction_path(@card, @comment)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    reaction = @response.parsed_body.sole
+    assert_equal reactions(:david_great).id, reaction["id"]
+    assert_equal "Great idea", reaction["content"]
+    assert_equal users(:david).id, reaction.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:david_great)), reaction["url"]
+  end
+
+  test "new" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form[action=?]", card_comment_reactions_path(@card, @comment) do
+      assert_select "input[name='reaction[content]'][maxlength='16'][required]"
+      assert_select "a[href=?]", card_comment_reactions_path(@card, @comment), text: /Cancel/
+    end
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:david), reaction.reacter
+
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions) do
+      assert_select "##{dom_id(reaction)}", text: /🎉/
+    end
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction) do
+      assert_select "a[href=?]", new_card_comment_reaction_path(@card, @comment)
+    end
+  end
+
+  test "create broadcasts a refresh to everyone looking at the card" do
+    assert_turbo_stream_broadcasts(@card) do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+  end
+
+  test "create rejects content longer than 16 characters" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "x" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @comment.reactions.last.content
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "👏" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👏", @comment.reactions.last.content
+  end
+
+  test "destroy" do
+    reaction = reactions(:david_great)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reactions(:david_great)), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot remove someone else's reaction" do
+    reaction = reactions(:kevin_thumbs_up)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot react on a card you can't access" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+end
