+<%# Rendered inside cached comments, so the reaction controller works out whether the current user can remove it %>
+<%= tag.div id: dom_id(reaction), class: "reaction", data: {
+      controller: "reaction tooltip",
+      reaction_reacter_id_value: reaction.reacter_id,
+      reaction_deleteable_class: "reaction--deleteable",
+      reaction_expanded_class: "expanded",
+      reaction_deleting_class: "reaction--deleting",
+      action: "click->reaction#toggle keydown.esc->reaction#collapse click@document->reaction#collapseOnClickOutside turbo:before-morph-attribute->reaction#preserveState" } do %>
+  <span class="reaction__avatar">
+    <%= avatar_tag reaction.reacter, hidden_for_screen_reader: true %>
+  </span>
+
+  <span class="for-screen-reader"><%= reaction.reacter.name %></span>
+
+  <%= tag.span reaction.content, class: [ "txt-small", { "txt-medium": reaction.all_emoji? } ],
+        data: { reaction_target: "toggle", action: "keydown.enter->reaction#toggle:prevent keydown.space->reaction#toggle:prevent" } %>
+
+  <%= button_to card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), method: :delete,
+        class: "btn btn--circle borderless", form_class: "reaction__delete",
+        title: "Remove your reaction", aria: { label: "Remove your reaction" },
+        form: { data: { action: "turbo:submit-start->reaction#markDeleting turbo:submit-end->reaction#unmarkDeleting" } },
+        data: { reaction_target: "deleteButton" } do %>
+    <%= icon_tag "trash" %>
+  <% end %>
+<% end %>
