@@ -0,0 +1,40 @@
+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(@card, @comment), class: "reaction reaction__form expanded",
+        data: { controller: "form reaction-form morph-guard", action: "submit->form#preventEmptySubmit keydown.esc->form#cancel:stop" } do |form| %>
+    <%= form.label :content, for: dom_id(@comment, :reaction_content), class: "reaction__form-label reaction__avatar" do %>
+      <%= avatar_preview_tag Current.user, class: "btn btn--circle", hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, id: dom_id(@comment, :reaction_content), class: "input reaction__input",
+          required: true, maxlength: 16, autofocus: true, autocomplete: "off",
+          data: { form_target: "input", reaction_form_target: "input", validation_message: "Type a reaction or pick an emoji", "1p-ignore": "true" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="btn btn--circle borderless reaction__menu-btn" title="Pick an emoji" data-action="dialog#toggle:stop">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup popup--align-right panel shadow" aria-label="Emoji" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <%= tag.button emoji, type: "button", class: "btn btn--circle borderless", title: name, aria: { label: name },
+                  data: { action: "dialog#close reaction-form#insert", reaction_form_content_param: emoji } %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "btn btn--circle borderless reaction__submit-btn", title: "Add your reaction (#{hotkey_label([ "enter" ])})" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add your reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment), class: "btn btn--circle borderless reaction__cancel-btn",
+          title: "Cancel (#{hotkey_label([ "esc" ])})", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
