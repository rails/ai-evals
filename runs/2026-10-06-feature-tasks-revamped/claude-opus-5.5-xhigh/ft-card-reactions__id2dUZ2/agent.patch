+    end
+
+    assert_changes -> { comments(:logo_1).reload.updated_at } do
+      comments(:logo_1).reactions.create!(content: "👍")
+    end
+  end
+
+  test "card is the reactable card" do
+    assert_equal cards(:logo), cards(:logo).reactions.create!(content: "👍").card
