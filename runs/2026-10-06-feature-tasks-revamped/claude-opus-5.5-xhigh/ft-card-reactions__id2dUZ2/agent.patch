+  end
+
+  test "account and reacter default from the reactable and current user" do
+    reaction = cards(:logo).reactions.create!(content: "👍")
+
+    assert_equal cards(:logo).account, reaction.account
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "destroying a card deletes its reactions" do
+    card = cards(:logo)
+    card_reaction = card.reactions.create!(content: "👍")
+    comment_reaction = card.comments.first.reactions.create!(content: "👍")
