diff --git a/test/models/account/data_transfer/reaction_record_set_test.rb b/test/models/account/data_transfer/reaction_record_set_test.rb
new file mode 100644
index 0000000..21dfa87
--- /dev/null
+++ b/test/models/account/data_transfer/reaction_record_set_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Account::DataTransfer::ReactionRecordSetTest < ActiveSupport::TestCase
+  test "check accepts reactions exported before cards could be reacted to" do
+    record_set = Account::DataTransfer::ReactionRecordSet.new(importing_account)
+    record_set.importable_model_names = %w[ Card Comment Reaction User ]
+
+    assert_nothing_raised do
+      record_set.check(from: build_reader(legacy_reaction_data))
+    end
+  end
+
+  test "import maps legacy reactions onto their comment" do
+    data = legacy_reaction_data
+    record_set = Account::DataTransfer::ReactionRecordSet.new(importing_account)
+
+    record_set.import(from: build_reader(data))
+
+    reaction = Reaction.find(data["id"])
+    assert_equal "Comment", reaction.reactable_type
+    assert_equal data["comment_id"], reaction.reactable_id
+    assert_equal importing_account.id, reaction.account_id
+  end
+
+  test "import keeps reactions on cards" do
+    card_id = ActiveRecord::Type::Uuid.generate
+    data = legacy_reaction_data.except("comment_id").merge("reactable_type" => "Card", "reactable_id" => card_id)
+    record_set = Account::DataTransfer::ReactionRecordSet.new(importing_account)
+
+    record_set.import(from: build_reader(data))
+
+    reaction = Reaction.find(data["id"])
+    assert_equal "Card", reaction.reactable_type
+    assert_equal card_id, reaction.reactable_id
+  end
+
+  private
+    def importing_account
+      @importing_account ||= Account.create!(name: "Importing Account", external_account_id: 99999999)
+    end
+
+    def legacy_reaction_data
+      {
+        "id" => ActiveRecord::Type::Uuid.generate,
+        "account_id" => ActiveRecord::Type::Uuid.generate,
+        "comment_id" => ActiveRecord::Type::Uuid.generate,
+        "reacter_id" => ActiveRecord::Type::Uuid.generate,
+        "content" => "👍",
+        "created_at" => Time.current.iso8601,
+        "updated_at" => Time.current.iso8601
+      }
+    end
+
+    def build_reader(data)
+      tempfile = Tempfile.new([ "import_test", ".zip" ])
+      tempfile.binmode
+
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file("data/reactions/#{data['id']}.json", data.to_json)
+      writer.close
+      tempfile.rewind
+
+      @tempfiles ||= []
+      @tempfiles << tempfile
+
+      ZipFile::Reader.new(tempfile)
+    end
+
+    def teardown
+      @tempfiles&.each { |f| f.close; f.unlink }
+      @importing_account&.destroy
+    end
+end
