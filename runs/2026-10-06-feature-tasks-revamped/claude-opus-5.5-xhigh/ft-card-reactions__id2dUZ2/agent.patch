+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,6 @@
+module ReactionsHelper
+  # Reactions are nested under their card, so this yields [ card ] for cards and [ card, comment ] for comments.
+  def reactable_route(reactable)
+    [ reactable.card, reactable ].uniq
+  end
+end
