-  INTERNAL_RECORD_TYPES = %w[Export].freeze
+  # Records of these types are artifacts of exports and imports themselves, so they never
+  # travel along with the data they were created from.
+  INTERNAL_RECORD_TYPES = %w[ Account::Export Account::Import ].freeze
+
+  INSERT_BATCH_SIZE = 500
 
   attr_reader :account, :model, :attributes
 
-  def initialize(account:, model:, attributes: nil)
+  def initialize(account:, model:, attributes: nil, scope: nil)
     @account = account
     @model = model
     @attributes = (attributes || model.column_names).map(&:to_s)
+    @scope = scope
+  end
+
+  # == Export ====================================================================
+
+  # Writes every record of this set into the archive as a JSON document of its own, so
+  # that they can be read back one by one without holding the whole set in memory.
+  def write_to(zip)
+    with_zip(zip) do
+      records.find_each do |record|
+        zip.add_file(entry_name_for(record), attributes_for(record).to_json)
+      end
+    end
+  end
+
