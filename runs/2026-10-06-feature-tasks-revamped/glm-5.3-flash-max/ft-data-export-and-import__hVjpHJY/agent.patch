diff --git a/app/models/account/data_transfer/mapping.rb b/app/models/account/data_transfer/mapping.rb
new file mode 100644
index 0000000..47ed9b1
--- /dev/null
+++ b/app/models/account/data_transfer/mapping.rb
@@ -0,0 +1,32 @@
+# Keeps track of the records that were created while importing an export, so records
+# imported later can point at them instead of at the records of the account the export
+# was taken from. Types are keyed by name so that polymorphic references, which only
+# know the type as a string, can be resolved the same way.
+class Account::DataTransfer::Mapping
+  def initialize
+    @ids = Hash.new { |ids, type| ids[type] = {} }
+  end
+
+  def add(type, original_id, id)
+    ids_for(type)[original_id.to_s] = id
+  end
+
+  def id_for(type, original_id)
+    ids_for(type)[original_id.to_s] if original_id.present?
+  end
+
+  def includes?(type, original_id)
+    ids_for(type).key?(original_id.to_s)
+  end
+
+  def created_count(type)
+    ids_for(type).size
+  end
+
+  private
+    attr_reader :ids
+
+    def ids_for(type)
+      ids[type.to_s]
+    end
+end
