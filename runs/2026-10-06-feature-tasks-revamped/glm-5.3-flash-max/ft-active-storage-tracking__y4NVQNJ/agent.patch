+# Recalculates the bytes used by an account, including the boards whose
+# recalculation is still pending, or by a single board.
+class Usage::RecalculationJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  queue_as :backend
+
+  def perform(record)
+    record.recalculate_bytes_used_now
+  end
+end
