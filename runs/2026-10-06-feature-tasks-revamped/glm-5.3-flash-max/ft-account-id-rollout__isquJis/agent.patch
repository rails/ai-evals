diff --git a/test/models/account/tenancy_test.rb b/test/models/account/tenancy_test.rb
new file mode 100644
index 0000000..1a75940
--- /dev/null
+++ b/test/models/account/tenancy_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Account::TenancyTest < ActiveSupport::TestCase
+  # Every model that holds an account's data, whether it belongs to the account
+  # directly (Account, User, Board) or to one of its records (Tagging, Watch).
+  ACCOUNT_SCOPED_MODELS = [
+    Account::Export, Account::Import, Account::JoinCode, Access, ActionText::RichText,
+    Assignment, Board, Board::Publication, Card, Card::ActivitySpike, Card::Goldness,
+    Card::NotNow, Closure, Column, Comment, Entropy, Event, Export, Filter, Mention,
+    Notification, Notification::Bundle, Pin, Push::Subscription, Reaction, Search::Query,
+    Step, Storage::Entry, Tag, Tagging, User, User::Settings, Watch, Webhook,
+    Webhook::Delivery, Webhook::DelinquencyTracker
+  ].freeze
+
+  # Blobs (and the attachments and variants derived from them) for global records,
+  # like Identity avatars, legitimately have no account.
+  OPTIONALLY_ACCOUNT_SCOPED_MODELS = [
+    ActiveStorage::Attachment, ActiveStorage::Blob, ActiveStorage::VariantRecord
+  ].freeze
+
+  test "every table holding an account's data has an account_id" do
+    (ACCOUNT_SCOPED_MODELS + OPTIONALLY_ACCOUNT_SCOPED_MODELS).each do |model|
+      assert model.columns_hash["account_id"], "#{model.table_name} has no account_id"
+    end
+  end
+
+  test "account_id is required on every table holding an account's data" do
+    ACCOUNT_SCOPED_MODELS.each do |model|
+      assert_not model.columns_hash["account_id"].null, "#{model.table_name}.account_id may be blank"
+    end
+  end
+
+  test "account_id is optional on the Active Storage tables" do
+    OPTIONALLY_ACCOUNT_SCOPED_MODELS.each do |model|
+      assert model.columns_hash["account_id"].null, "#{model.table_name}.account_id must be optional"
+    end
+  end
+
+  test "every table holding an account's data is indexed on account_id" do
+    (ACCOUNT_SCOPED_MODELS + OPTIONALLY_ACCOUNT_SCOPED_MODELS).each do |model|
+      indexed = model.connection.indexes(model.table_name).any? { |index| index.columns.first == "account_id" }
+
+      assert indexed, "#{model.table_name} is not indexed on account_id"
+    end
+  end
+
+  test "every account scoped model knows its account" do
+    (ACCOUNT_SCOPED_MODELS + OPTIONALLY_ACCOUNT_SCOPED_MODELS).each do |model|
+      assert model.reflect_on_association(:account), "#{model.name} has no account association"
+    end
+  end
+
+test "records inherit the account of the record they belong to" do
+  card = cards(:logo)
+  tagging = Tagging.new(card: card, tag: tags(:web))
+
+  tagging.valid?
+
+  assert_equal card.account_id, tagging.account_id
+end
+end
