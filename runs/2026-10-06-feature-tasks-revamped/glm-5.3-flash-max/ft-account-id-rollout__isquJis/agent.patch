diff --git a/config/initializers/active_storage_tenanting.rb b/config/initializers/active_storage_tenanting.rb
new file mode 100644
index 0000000..329fbe3
--- /dev/null
+++ b/config/initializers/active_storage_tenanting.rb
@@ -0,0 +1,45 @@
+# Multi-tenant accounting for Active Storage: blobs, attachments, and the variant
+# records derived from them, all know the account they belong to.
+#
+# Blobs are usually created before the record they end up attached to (direct
+# uploads, Action Text embeds), so they default to the account in context. When a
+# blob that has no account yet is attached to a record carrying one, it inherits
+# that account.
+#
+# Blobs for global records, like Identity avatars, have no account at all: that's
+# why the associations stay optional.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: true
+
+  before_create { self.account ||= Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: true
+
+  before_validation :assign_account, prepend: true, on: :create
+
+  private
+    def assign_account
+      if account = record.try(:account)
+        self.account = account
+        assign_blob_account(account)
+      else
+        self.account_id ||= blob&.account_id
+      end
+    end
+
+    def assign_blob_account(account)
+      return unless blob
+      return if blob.account_id.present?
+
+      blob.account_id = account.id
+      blob.update_column(:account_id, account.id) if blob.persisted?
+    end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: true
+
+  before_create { self.account ||= blob&.account }
+end
diff --git a/db/migrate/20260710000000_add_account_id_to_every_account_scoped_table.rb b/db/migrate/20260710000000_add_account_id_to_every_account_scoped_table.rb
new file mode 100644
index 0000000..9ee35dc
--- /dev/null
+++ b/db/migrate/20260710000000_add_account_id_to_every_account_scoped_table.rb
@@ -0,0 +1,231 @@
+# Finishes the multi-tenancy rollout: every table that holds an account's data
+# now carries a +account_id+ that is required and indexed.
+#
+# Existing rows are backfilled from the record they belong to. Rows that can't be
+# tied to an account (orphans left behind before cascading deletes were in place)
+# are dropped.
+#
+# Active Storage tables are the exception: blobs (and their attachments and
+# variants) for global records such as Identity avatars legitimately have no
+# account, so their +account_id+ stays optional.
+class AddAccountIdToEveryAccountScopedTable < ActiveRecord::Migration[8.2]
+  # Where each table's account comes from: [ table, parent table, foreign key,
+  # condition ]. Later entries backfill what earlier ones left blank, so the
+  # record that owns the data is preferred over the user that happened to act.
+  DERIVATIONS = [
+    [ "accesses", "boards", "board_id" ],
+    [ "assignments", "cards", "card_id" ],
+    [ "board_publications", "boards", "board_id" ],
+    [ "card_activity_spikes", "cards", "card_id" ],
+    [ "card_goldnesses", "cards", "card_id" ],
+    [ "card_not_nows", "cards", "card_id" ],
+    [ "closures", "cards", "card_id" ],
+    [ "mentions", "cards", "source_id", "source_type = 'Card'" ],
+    [ "mentions", "comments", "source_id", "source_type = 'Comment'" ],
+    [ "mentions", "users", "mentioner_id" ],
+    [ "pins", "cards", "card_id" ],
+    [ "reactions", "cards", "reactable_id", "reactable_type = 'Card'" ],
+    [ "reactions", "comments", "reactable_id", "reactable_type = 'Comment'" ],
+    [ "reactions", "users", "reacter_id" ],
+    [ "search_queries", "users", "user_id" ],
+    [ "taggings", "cards", "card_id" ],
+    [ "user_settings", "users", "user_id" ],
+    [ "watches", "cards", "card_id" ],
+    [ "webhook_delinquency_trackers", "webhooks", "webhook_id" ],
+    [ "webhook_deliveries", "webhooks", "webhook_id" ],
+    [ "action_text_rich_texts", "boards", "record_id", "record_type = 'Board'" ],
+    [ "action_text_rich_texts", "cards", "record_id", "record_type = 'Card'" ],
+    [ "action_text_rich_texts", "comments", "record_id", "record_type = 'Comment'" ]
+  ].freeze
+
+  # Tables that already had a +account_id+, but one that could be left blank.
+  NULLABLE_TODAY = %w[
+    account_imports account_join_codes boards cards columns comments events filters
+    notification_bundles notifications push_subscriptions steps tags users webhooks
+  ].freeze
+
+  ACTIVE_STORAGE_TABLES = %w[
+    active_storage_attachments active_storage_blobs active_storage_variant_records
+  ].freeze
+
+  # Tables that require an account: rows without one are dropped.
+  REQUIRED_TABLES = (DERIVATIONS.map(&:first).uniq + NULLABLE_TODAY + %w[ entropies ]).freeze
+
+  # Tables that need an index leading on +account_id+. +cards+ and +storage_entries+
+  # are already covered by composite indexes starting with it.
+  INDEXED_TABLES = (
+    DERIVATIONS.map(&:first).uniq + NULLABLE_TODAY + %w[ entropies ] + ACTIVE_STORAGE_TABLES
+  ).freeze
+
+  def up
+    add_account_id
+
+    backfill_from_parents
+    backfill_entropies
+    backfill_attachments_from_their_records
+    backfill_blobs_from_their_attachments
+    backfill_variant_records_from_their_blob
+    backfill_attachments_from_their_blob
+
+    drop_orphans
+
+    require_account_id
+    scope_tags_uniqueness_to_their_account
+    add_missing_indexes
+  end
+
+  def down
+    (DERIVATIONS.map(&:first).uniq + %w[ entropies ] + ACTIVE_STORAGE_TABLES).each do |table|
+      remove_standalone_account_id_index(table)
+      remove_column table, :account_id
+    end
+
+    # The indexes added for the tables above go away with their column. For the
+    # tables that keep their +account_id+, a leftover index is harmless.
+    NULLABLE_TODAY.each do |table|
+      change_column_null table, :account_id, true
+    end
+
+    restore_global_tags_uniqueness
+  end
+
+  private
+    def add_account_id
+      (DERIVATIONS.map(&:first).uniq + %w[ entropies ] + ACTIVE_STORAGE_TABLES).each do |table|
+        add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+      end
+    end
+
+    def backfill_from_parents
+      DERIVATIONS.each { |table, parent, foreign_key, condition| backfill table, parent, foreign_key, condition }
+    end
+
+    # Entropies hang off either the account itself or one of its boards.
+    def backfill_entropies
+      execute <<~SQL
+        UPDATE entropies SET account_id = container_id
+        WHERE account_id IS NULL AND container_type = 'Account'
+      SQL
+
+      backfill "entropies", "boards", "container_id", "container_type = 'Board'"
+    end
+
+    # Attachments belong to the record they are attached to. Only the record types
+    # that carry an account are considered; attachments for global records (like
+    # Identity avatars) keep a nil account.
+    def backfill_attachments_from_their_records
+      records_with_an_account = [
+        [ "account_imports", "Account::Import" ],
+        [ "boards", "Board" ],
+        [ "cards", "Card" ],
+        [ "comments", "Comment" ],
+        # Export and its User::DataExport subclass share the same table.
+        [ "exports", "Export" ],
+        [ "exports", "User::DataExport" ],
+        [ "users", "User" ]
+      ]
+
+      records_with_an_account.each do |parent, record_type|
+        backfill "active_storage_attachments", parent, "record_id", "record_type = '#{record_type}'"
+      end
+    end
+
+    # Blobs are created before the records they end up attached to, so their
+    # account is derived from the attachments pointing at them.
+    def backfill_blobs_from_their_attachments
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+        )
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_variant_records_from_their_blob
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (
+          SELECT active_storage_blobs.account_id
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+            AND active_storage_blobs.account_id IS NOT NULL
+        )
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    # Attachments for records that don't carry an account themselves still inherit
+    # the account of the blob they point at.
+    def backfill_attachments_from_their_blob
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (
+          SELECT active_storage_blobs.account_id
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_attachments.blob_id
+            AND active_storage_blobs.account_id IS NOT NULL
+        )
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill(table, parent, foreign_key, condition = nil)
+      where = "WHERE #{table}.account_id IS NULL"
+      where += " AND #{condition}" if condition
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (SELECT #{parent}.account_id FROM #{parent} WHERE #{parent}.id = #{table}.#{foreign_key})
+        #{where}
+      SQL
+    end
+
+    def drop_orphans
+      REQUIRED_TABLES.each do |table|
+        execute "DELETE FROM #{table} WHERE account_id IS NULL"
+      end
+    end
+
+    def require_account_id
+      REQUIRED_TABLES.each do |table|
+        change_column_null table, :account_id, false
+      end
+    end
+
+    # Tags are scoped to an account, so is their uniqueness.
+    def scope_tags_uniqueness_to_their_account
+      remove_index :tags, name: "index_tags_on_title" if index_name_exists?(:tags, "index_tags_on_title")
+
+      unless index_name_exists?(:tags, "index_tags_on_account_id_and_title")
+        add_index :tags, [ :account_id, :title ], unique: true
+      end
+    end
+
+    def restore_global_tags_uniqueness
+      remove_index :tags, name: "index_tags_on_account_id_and_title" if index_name_exists?(:tags, "index_tags_on_account_id_and_title")
+
+      unless index_name_exists?(:tags, "index_tags_on_title")
+        add_index :tags, :title, unique: true
+      end
+    end
+
+    def add_missing_indexes
+      INDEXED_TABLES.each do |table|
+        add_index table, :account_id unless index_leading_on_account_id?(table)
+      end
+    end
+
+    # Only indexes named after the Rails convention were added by +up+.
+    def remove_standalone_account_id_index(table)
+      name = "index_#{table}_on_account_id"
+      remove_index table, name: name if index_name_exists?(table, name)
+    end
+
+    def index_leading_on_account_id?(table)
+      indexes(table).any? { |index| index.columns.first == "account_id" }
+    end
+end
