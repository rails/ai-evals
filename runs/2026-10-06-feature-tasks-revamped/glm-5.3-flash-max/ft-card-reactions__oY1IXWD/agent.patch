+class Cards::ReactionsController < ApplicationController
+  include ReactionScoped
+
+  before_action :ensure_card_is_reactable, only: :create
+
+  private
+    def set_reactable
+      @reactable = @card
+    end
+
+    def ensure_card_is_reactable
+      head :forbidden unless @card.reactable?
+    end
+end
diff --git a/app/controllers/concerns/reaction_scoped.rb b/app/controllers/concerns/reaction_scoped.rb
new file mode 100644
index 0000000..992047a
--- /dev/null
+++ b/app/controllers/concerns/reaction_scoped.rb
@@ -0,0 +1,50 @@
+module ReactionScoped
+  extend ActiveSupport::Concern
+
+  included do
+    # Reactions always hang off a card, either directly or through one of its comments.
+    include CardScoped
+
+    wrap_parameters :reaction, include: %i[ content ]
+
+    before_action :set_reactable
+
+    with_options only: :destroy do
+      before_action :set_reaction
+      before_action :ensure_permission_to_administer_reaction
+    end
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render "reactions/show", status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..4412bee
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,19 @@
+module ReactionsHelper
+  # The records a reactable's reactions are nested under in URLs: the card and the comment for a
+  # comment's reactions, and just the card for a card's own reactions.
+  def reaction_nesting(reactable)
+    if reactable.is_a?(Card)
+      [ reactable ]
+    else
+      [ reactable.card, reactable ]
+    end
+  end
+
+  def reaction_path_for(reaction)
+    polymorphic_path([ *reaction_nesting(reaction.reactable), reaction ])
+  end
+
+  def reaction_url_for(reaction)
+    polymorphic_url([ *reaction_nesting(reaction.reactable), reaction ])
+  end
+end
