+++ b/app/assets/stylesheets/public-boards.css
@@ -0,0 +1,104 @@
+@layer components {
+  /* Public boards (read-only views shared with a secret URL)
+  /* ------------------------------------------------------------------------ */
+
+  .public-boards {
+    display: grid;
+    gap: var(--inline-space);
+    grid-auto-flow: column;
+    grid-auto-columns: minmax(17rem, 22rem);
+    padding: var(--block-space) var(--inline-space);
+    overflow-x: auto;
+  }
+
+  .public-boards--single {
+    grid-auto-flow: row;
+    grid-auto-columns: unset;
+    max-inline-size: 60rem;
+    margin-inline: auto;
+  }
+
+  .public-boards__column {
+    background-color: color-mix(in srgb, var(--card-color) 4%, var(--color-canvas));
+    border-radius: 0.4em;
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+    padding: var(--block-space);
+  }
+
+  .public-boards__column-name {
+    align-items: center;
+    display: flex;
+    font-weight: 700;
+    gap: var(--inline-space-half);
+    justify-content: space-between;
+    text-transform: uppercase;
+
+    a {
+      color: inherit;
+    }
+  }
+
+  .public-boards__column-count {
+    color: var(--color-ink-medium);
+    font-size: 0.8em;
+  }
+
+  .public-boards__cards {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+
+  .public-boards__card {
+    .card__title {
+  
+      a {
+        color: inherit;
+      }
+    }
+  }
+
+  .public-boards__card-tags {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--inline-space-half);
+    margin: 0;
+  }
+
+  .public-boards__card-meta {
+    margin: 0;
+  }
+
+  .public-boards__empty {
+    color: var(--color-ink-medium);
+    margin: 0;
+  }
+
+  .public-boards__perma {
+    margin-inline: auto;
+    max-inline-size: 60rem;
+  }
+
+  .public-boards__perma-header {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+  }
+
+  .public-boards__perma-meta {
+    margin: 0;
+  }
+
+  .public-boards__perma-description {
+    margin-block-start: var(--block-space);
+  }
+
+  .public-boards__perma-steps {
+    margin: var(--block-space) 0 0;
+  }
+}
