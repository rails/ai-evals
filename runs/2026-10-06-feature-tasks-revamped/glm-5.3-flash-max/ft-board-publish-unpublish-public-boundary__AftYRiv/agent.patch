+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@board.public_key), class: "btn btn--link" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="public-boards__perma card" id="<%= dom_id(@card) %>" style="--card-color: <%= @card.color %>">
+  <header class="public-boards__perma-header">
+    <p class="public-boards__perma-meta txt-subtle">
+      Added by <%= @card.creator.name %> on <%= l @card.created_at.to_date, format: :long %>
+      <% if @card.column %>
+        in <%= link_to @card.column.name, public_board_column_path(key: @board.public_key, id: @card.column) %>
+      <% end %>
+    </p>
+
+    <% if @card.tags.any? %>
+      <p class="public-boards__card-tags">
+        <% @card.tags.each do |tag| %>
+          <span class="card__tag"><%= tag.title %></span>
+        <% end %>
+      </p>
+    <% end %>
+
+    <% if @card.assignees.any? %>
+      <p class="public-boards__perma-meta txt-subtle">
+        Assigned to <%= @card.assignees.map(&:name).to_sentence %>
+      </p>
+    <% end %>
+  </header>
+
+  <% if @card.description.present? %>
+    <div class="public-boards__perma-description">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul class="public-boards__perma-steps">
+      <% @card.steps.each do |step| %>
+        <li class="<%= "completed" if step.completed? %>"><%= step.content %></li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
