diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..0c9c92b
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "public_url is nil by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).public_url
+    assert_nil boards(:writebook).public_key
+  end
+
+  test "publish generates a secret key and a public url" do
+    board = boards(:writebook)
+
+    board.publish
+
+    assert board.reload.published?
+    assert_equal Board::Publishable::PUBLIC_KEY_LENGTH, board.public_key.length
+    assert_equal "http://example.com/public/boards/#{board.public_key}", board.reload.public_url
+  end
+
+  test "publishing twice keeps the same public key" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_no_changes -> { board.reload.public_key } do
+      board.publish
+    end
+  end
+
+  test "unpublish removes the public url but keeps the key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.public_key
+
+    board.unpublish
+
+    assert_not board.reload.published?
+    assert_nil board.public_url
+    assert_equal key, board.public_key
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, boards(:writebook)
+
+    boards(:writebook).publish
+
+    assert_includes Board.published, boards(:writebook)
+  end
+
+  test "public key collisions are retried" do
+    taken = boards(:writebook).tap(&:publish).public_key
+    other = Board.create!(name: "Another board", creator: users(:kevin), account: accounts("37s"))
+
+    SecureRandom.stubs(:base58).returns(taken, "a_fresh_public_key")
+
+    other.publish
+
+    assert_equal "a_fresh_public_key", other.reload.public_key
+  end
+end
