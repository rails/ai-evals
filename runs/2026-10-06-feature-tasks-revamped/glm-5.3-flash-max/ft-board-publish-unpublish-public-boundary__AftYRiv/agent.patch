+<div class="settings__section">
+  <h2 class="divider txt-large">Public access</h2>
+  <p class="margin-none-block-start">Anyone with this secret link can see this board — no account needed.</p>
+
+  <% if board.published? %>
+    <div class="flex align-center gap" id="<%= dom_id(board, :publication) %>">
+      <input type="text" class="input fill-white" id="board_public_url" value="<%= board.public_url %>" aria-label="Public board link" readonly>
+
+      <%= button_to_copy_to_clipboard(board.public_url) do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public board link</span>
+      <% end %>
+
+      <%= link_to "View public board", board.public_url, class: "btn", target: "_blank" %>
+
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative", data: { turbo_frame: "_top" } do %>
+        <span>Stop publishing</span>
+      <% end %>
+    </div>
+  <% else %>
+    <%= button_to board_publication_path(board), method: :post, class: "btn", disabled: !Current.user.can_administer_board?(board), data: { turbo_frame: "_top" } do %>
+      <span>Publish this board</span>
+    <% end %>
+  <% end %>
+</div>
