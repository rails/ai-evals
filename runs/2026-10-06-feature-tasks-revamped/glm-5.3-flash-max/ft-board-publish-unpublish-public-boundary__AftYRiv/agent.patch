diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..5d1ecd4
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,48 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where(published: true) }
+
+    before_validation :set_public_key, if: :published?
+  end
+
+  def publish
+    update! published: true
+  end
+
+  def unpublish
+    update! published: false
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url public_key, **public_url_options
+    end
+  end
+
+  private
+    def set_public_key
+      if public_key.blank?
+        self.public_key = loop do
+          candidate = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+          break candidate unless self.class.exists?(public_key: candidate)
+        end
+      end
+    end
+
+    # Public boards live outside of the account scope, so the URL is never
+    # prefixed with the account slug. The host of the current request is
+    # preferred, falling back to the configured host when there is none.
+    def public_url_options
+      if Current.request
+        { host: Current.request.host, protocol: Current.request.protocol }
+      else
+        Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options ||
+          {}
+      end
+    end
+end
