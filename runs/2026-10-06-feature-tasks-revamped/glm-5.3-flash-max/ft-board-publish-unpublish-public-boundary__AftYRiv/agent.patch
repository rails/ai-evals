--- /dev/null
+++ b/test/system/public_boards_test.rb
@@ -0,0 +1,40 @@
+require "application_system_test_case"
+
+class PublicBoardsTest < ApplicationSystemTestCase
+  test "publishing a board makes it readable by anyone with the secret url" do
+    sign_in_as users(:kevin)
+
+    visit edit_board_url(boards(:writebook))
+    click_on "Publish this board"
+
+    assert_selector "h1", text: boards(:writebook).name
+    assert boards(:writebook).reload.published?
+
+    visit edit_board_url(boards(:writebook))
+    public_url = find("#board_public_url").value
+
+    using_session :visitor do
+      visit public_url
+      assert_selector "h1", text: boards(:writebook).name
+    end
+  end
+
+  test "unpublishing a board takes its public url down" do
+    board = boards(:writebook)
+    board.publish
+    public_url = public_board_url(board.public_key, script_name: nil)
+
+    sign_in_as users(:kevin)
+
+    visit edit_board_url(board)
+    click_on "Stop publishing"
+
+    assert_selector "h1", text: board.name
+    assert_not board.reload.published?
+
+    using_session :visitor do
+      visit public_url
+      assert_no_selector "h1", text: board.name
+    end
+  end
+end
