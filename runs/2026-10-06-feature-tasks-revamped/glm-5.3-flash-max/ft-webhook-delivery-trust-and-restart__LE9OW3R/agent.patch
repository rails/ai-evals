+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      Webhook.deliver_all_for(@event)
+    end
+  end
+
+  test "is not created for inactive webhooks" do
+    @webhook = webhooks(:inactive)
+    @event = events(:shipping_closed)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      Webhook.deliver_all_for(@event)
+    end
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ] do
+      delivery.deliver_later
+    end
+  end
+
+  test "deliver posts the payload and records a successful response" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert delivery.reload.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    headers = delivery.sanitized_request[:headers]
+    assert_equal Webhook::Delivery::USER_AGENT, headers["User-Agent"]
+    assert_equal "application/json", headers["Content-Type"]
+    assert headers.key?("X-Webhook-Timestamp")
+    assert_not headers.key?("X-Webhook-Signature")
+
+    assert_requested :post, @webhook.url do |request|
+      signature = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body)
+      request.headers["X-Webhook-Signature"] == signature &&
+        JSON.parse(request.body)["action"] == "comment_created"
+    end
+  end
+
+  test "deliver records a failed response" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    delivery.deliver
+
+    assert delivery.reload.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_not delivery.succeeded?
+  end
+
+  test "deliver records an unreachable destination" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver records a timeout as an unreachable destination" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_timeout
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver only happens once" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery.deliver
+    delivery.reload.deliver
+
+    assert_requested stub, times: 1
+  end
+
+  test "a successful delivery resets the delinquency tracker" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    @webhook.delinquency_tracker.update!(consecutive_failures_count: 4, first_failure_at: 30.minutes.ago)
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
