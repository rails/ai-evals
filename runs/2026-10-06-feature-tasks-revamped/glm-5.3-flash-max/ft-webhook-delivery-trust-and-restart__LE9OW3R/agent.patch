diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..5ace9d6
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,35 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A receiver that keeps failing -- ten times in a row over an hour -- gets its
+  # webhook switched off.
+  MAXIMUM_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def register_failure(at: Time.current)
+    update! \
+      consecutive_failures_count: consecutive_failures_count + 1,
+      first_failure_at: first_failure_at || at
+
+    webhook.deactivate if delinquent?(at: at)
+  end
+
+  def register_success
+    restart
+  end
+
+  def delinquent?(at: Time.current)
+    consecutive_failures_count >= MAXIMUM_CONSECUTIVE_FAILURES && failing_long_enough?(at: at)
+  end
+
+  def restart
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    # Whether the current run of failures has been going on for an hour.
+    def failing_long_enough?(at: Time.current)
+      first_failure_at.present? && first_failure_at <= FAILURE_WINDOW.ago(at)
+    end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..9af0e5b 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,16 @@
 class Webhook::Delivery < ApplicationRecord
+  # The log of deliveries is kept around for a week.
+  RETENTION_PERIOD = 1.week
+
+  TIMEOUT = 10
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  # Anything that can go wrong while talking to the receiver.
+  NETWORK_ERRORS = [
+    SocketError, SystemCallError, Timeout::Error, OpenSSL::SSL::SSLError,
+    Net::ProtocolError, URI::InvalidURIError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +21,33 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ..RETENTION_PERIOD.ago) }
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self if pending?
+  end
+
+  def deliver
+    return if delivered?
+
+    headers = request_headers
+
+    update! state: :in_progress, request: { headers: headers }
+
+    begin
+      update! state: :completed, response: post(headers)
+    rescue *NETWORK_ERRORS
+      update! state: :errored, response: { error: :destination_unreachable }
+    end
+
+    record_outcome
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +68,54 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def delivered?
+      completed? || errored?
+    end
+
+    def post(headers)
+      response = http.post(uri.request_uri, payload, headers)
+
+      { code: response.code.to_i, headers: response.to_hash }
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.use_ssl = uri.is_a?(URI::HTTPS)
+        http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      end
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def request_headers
+      {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => Time.current.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+      }
+    end
+
+    def payload
+      @payload ||= ApplicationController.renderer.render \
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: :json
+    end
+
+    def record_outcome
+      # Webhooks that existed before deliveries were tracked don't have a
+      # delinquency tracker yet, so we create one on the fly.
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+      if succeeded?
+        tracker.register_success
+      else
+        tracker.register_failure
+      end
+    end
 end
