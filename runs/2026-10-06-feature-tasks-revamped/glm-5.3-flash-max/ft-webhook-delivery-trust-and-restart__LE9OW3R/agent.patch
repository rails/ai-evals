index 0000000..af702c3
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created along with the webhook" do
+    webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert_not_nil webhook.delinquency_tracker
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "counts consecutive failures" do
+    @tracker.register_failure
+    @tracker.register_failure
+
+    assert_equal 2, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "remembers when the failures started" do
+    travel_to 2.hours.ago do
+      @tracker.register_failure
+    end
+
+    assert_equal 2.hours.ago.change(usec: 0), @tracker.reload.first_failure_at
+  end
+
+  test "switches the webhook off after ten failures in a row over an hour" do
+    travel_to 2.hours.ago do
+      @tracker.register_failure
+    end
+
+    9.times { @tracker.register_failure }
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "keeps the webhook on while the failures haven't been going on for an hour" do
+    10.times { @tracker.register_failure }
+
+    assert @webhook.reload.active?
+  end
+
+  test "keeps the webhook on after nine failures in a row" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.register_failure }
+    end
+
+    assert @webhook.reload.active?
+  end
+
+  test "starts counting over when a delivery succeeds" do
+    travel_to 2.hours.ago do
+      3.times { @tracker.register_failure }
+    end
+
+    @tracker.register_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "starts counting over when the webhook is activated again" do
+    travel_to 2.hours.ago do
+      10.times { @tracker.register_failure }
+    end
+
+    @webhook.reload.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "is delinquent after ten failures in a row over an hour" do
+    travel_to 2.hours.ago do
+      10.times { @tracker.register_failure }
+    end
+
+    assert @tracker.reload.delinquent?
+  end
+
+  test "is not delinquent while the failures are being counted" do
+    assert_not @tracker.delinquent?
+
+    9.times { @tracker.register_failure }
+
+    assert_not @tracker.reload.delinquent?
+  end
+end
