diff --git a/test/jobs/webhook/delivery_job_test.rb b/test/jobs/webhook/delivery_job_test.rb
new file mode 100644
index 0000000..1e2ea07
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+  end
+
+  test "runs on the webhooks queue" do
+    assert_equal "webhooks", Webhook::DeliveryJob.queue_name
+  end
+
+  test "delivers the delivery" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.succeeded?
+  end
+
+  test "records the outcome when the receiver is unreachable" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.errored?
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "is enqueued for every subscribed webhook when an event is created" do
+    webhook = Webhook.create!(
+      name: "Test", url: "https://example.com/webhooks", board: boards(:writebook),
+      subscribed_actions: [ "card_published" ]
+    )
+
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+
+    delivery = webhook.deliveries.sole
+    assert_equal "card_published", delivery.event.action
+    assert_equal "pending", delivery.state
+  end
+
+  test "is not enqueued for actions the webhook is not subscribed to" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      Event.create!(board: @webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_reopened")
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
