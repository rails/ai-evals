diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..5a7f641
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+  end
+
+  test "three comments from two people within the burst window burst the card" do
+    comment 12.hours.ago, creator: users(:david)
+    comment 6.hours.ago, creator: users(:david)
+    comment creator: users(:kevin)
+
+    assert @card.reload.bursted?
+  end
+
+  test "comments from a single person do not burst the card" do
+    comment 12.hours.ago
+    comment 6.hours.ago
+    comment
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments spread beyond the burst window do not burst the card" do
+    comment 40.days.ago
+    comment 39.days.ago, creator: users(:kevin)
+    comment 5.days.ago
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "the burst window is a third of the board's auto-close period" do
+    entropies(:writebook_board).update! auto_postpone_period: 90.days
+
+    comment 29.days.ago
+    comment 28.days.ago, creator: users(:kevin)
+    comment
+    assert @card.reload.bursted?
+  end
+
+  test "comments spread beyond a third of the auto-close period do not burst the card" do
+    entropies(:writebook_board).update! auto_postpone_period: 30.days
+
+    comment 11.days.ago
+    comment 10.days.ago, creator: users(:kevin)
+    comment
+    assert_not @card.reload.bursted?
+  end
+
+  test "the burst window falls back to the default auto-close period when the board has no entropy" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+
+    comment 10.days.ago
+    comment 9.days.ago, creator: users(:kevin)
+    comment
+    assert @card.reload.bursted?
+  end
+
+  test "system comments do not burst the card" do
+    comment 12.hours.ago
+    comment 6.hours.ago, creator: @card.account.system_user
+    comment creator: @card.account.system_user
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "assigning the card bursts it" do
+    assert_not @card.bursted?
+
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.bursted?
+  end
+
+  test "reopening the card bursts it" do
+    @card.close(user: users(:david))
+    @card.update_columns burst_at: nil
+
+    @card.reopen(user: users(:david))
+
+    assert @card.reload.bursted?
+  end
+
+  test "a burst is only recorded once" do
+    freeze_time do
+      @card.mark_burst
+
+      travel 1.hour
+      @card.mark_burst
+
+      assert_equal Time.now - 1.hour, @card.reload.burst_at
+    end
+  end
+
+  test "a card that had a burst and has been inactive for two weeks is stalled" do
+    freeze_time do
+      @card.update! last_active_at: 2.weeks.ago + 1.hour
+      @card.mark_burst
+      assert_not @card.stalled?
+
+      travel 1.hour
+
+      assert @card.reload.stalled?
+      assert_equal @card.last_active_at + Card::Stallable::STALL_PERIOD, @card.stalled_at
+    end
+  end
+
+  test "stalled_at is only set for stalled cards" do
+    @card.update! last_active_at: 3.weeks.ago
+    assert_nil @card.stalled_at
+
+    @card.mark_burst
+    assert_not_nil @card.stalled_at
+  end
+
+  test "a card that was never bursted is never stalled" do
+    @card.update! last_active_at: 1.year.ago
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "any activity on a stalled card resets it" do
+    @card.mark_burst
+    @card.update! last_active_at: 3.weeks.ago
+    assert @card.reload.stalled?
+
+    @card.comments.create!(body: "Still relevant!")
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.mark_burst
+    @card.update! last_active_at: 3.weeks.ago
+
+    @card.close(user: users(:david))
+    assert_not @card.reload.stalled?
+
+    @card.reopen(user: users(:david))
+    @card.postpone(user: users(:david))
+    assert_not @card.reload.stalled?
+  end
+
+  test "stalled scope" do
+    stalled_card = cards(:logo)
+    stalled_card.update!(burst_at: 1.month.ago, last_active_at: 3.weeks.ago)
+
+    active_card = cards(:text)
+    active_card.update!(burst_at: 1.month.ago, last_active_at: 1.day.ago)
+
+    quiet_card = cards(:buy_domain)
+    quiet_card.update!(last_active_at: 3.weeks.ago)
+
+    assert_equal [ stalled_card ], @card.board.cards.stalled
+    assert_not_includes Card.stalled, active_card
+    assert_not_includes Card.stalled, quiet_card
+  end
+
+  test "indexed by stalled" do
+    stalled_card = cards(:logo)
+    stalled_card.update!(burst_at: 1.month.ago, last_active_at: 3.weeks.ago)
+
+    assert_equal [ stalled_card.number ], Card.indexed_by("stalled").map(&:number)
+  end
+
+  private
+    def comment(at = Time.current, creator: users(:david))
+      @card.comments.create!(body: "A comment", creator: creator, created_at: at)
+    end
+end
