diff --git a/test/system/stalled_card_test.rb b/test/system/stalled_card_test.rb
new file mode 100644
index 0000000..1042883
--- /dev/null
+++ b/test/system/stalled_card_test.rb
@@ -0,0 +1,23 @@
+require "application_system_test_case"
+
+class StalledCardTest < ApplicationSystemTestCase
+  test "a stalled card shows for how long it has been stalled" do
+    sign_in_as users(:david)
+    cards(:logo).update! burst_at: 1.month.ago, last_active_at: 3.weeks.ago
+
+    visit cards_path
+
+    assert_selector ".bubble", text: /stalled for/i
+    assert_selector ".bubble__number", text: "7"
+  end
+
+  test "a card that is not stalled shows when it auto-closes instead" do
+    sign_in_as users(:david)
+    cards(:logo).update! burst_at: nil, last_active_at: 80.days.ago
+
+    visit cards_path
+
+    assert_selector ".bubble", text: /closes in/i
+    assert_no_selector ".bubble", text: /stalled for/i
+  end
+end
