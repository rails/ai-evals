diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..53f9005
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,55 @@
+# A card bursts when three or more comments from at least two people land on it
+# within a third of the board's auto-close period, or when someone is assigned
+# to it or reopens it. A card that had a burst and then sees no activity for two
+# weeks is stalled.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_WINDOW_FRACTION = 3
+
+  included do
+    scope :bursted, -> { where.not burst_at: nil }
+    scope :stalled, -> { active.bursted.where(last_active_at: ..(STALL_PERIOD.ago)) }
+  end
+
+  def bursted?
+    burst_at.present?
+  end
+
+  def stalled?
+    active? && bursted? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def stalled_at
+    last_active_at + STALL_PERIOD if stalled?
+  end
+
+  # Only the first burst is recorded. Whether the card then stalls depends on
+  # the inactivity that follows, which any activity on the card resets.
+  def mark_burst
+    update_column :burst_at, Time.current unless bursted?
+  end
+
+  def check_for_burst
+    mark_burst if comments_burst?
+  end
+
+  private
+    def comments_burst?
+      latest_comment_at = comments.by_user.maximum(:created_at)
+
+      if latest_comment_at
+        burst_comments = comments.by_user.where(created_at: (latest_comment_at - burst_window)..)
+        burst_comments.count >= BURST_COMMENTS && burst_comments.distinct.count(:creator_id) >= BURST_COMMENTERS
+      else
+        false
+      end
+    end
+
+    def burst_window
+      (board.entropy&.auto_postpone_period || Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days) / BURST_WINDOW_FRACTION
+    end
+end
