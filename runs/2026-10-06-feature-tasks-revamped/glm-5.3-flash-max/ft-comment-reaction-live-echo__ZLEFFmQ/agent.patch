+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+    @user = users(:david)
+  end
+
+  test "content is required" do
+    reaction = Reaction.new reactable: @comment, reacter: @user
+
+    assert_not reaction.valid?
+    assert_equal [ "can't be blank" ], reaction.errors.messages[:content]
+  end
+
+  test "content is limited to 16 characters" do
+    assert Reaction.new(reactable: @comment, reacter: @user, content: "a" * Reaction::MAX_LENGTH).valid?
+    assert_not Reaction.new(reactable: @comment, reacter: @user, content: "a" * (Reaction::MAX_LENGTH + 1)).valid?
+  end
+
+  test "content can be emoji or a short bit of text" do
+    assert Reaction.new(reactable: @comment, reacter: @user, content: "👍").valid?
+    assert Reaction.new(reactable: @comment, reacter: @user, content: "Nice!").valid?
+  end
+
+  test "a reacter can only leave the same reaction once" do
+    @comment.reactions.create! content: "👍", reacter: @user
+
+    assert_no_difference -> { @comment.reactions.count } do
+      assert_raises ActiveRecord::RecordInvalid do
+        @comment.reactions.create! content: "👍", reacter: @user
+      end
+    end
+  end
+
+  test "different reacters can leave the same reaction" do
+    assert_difference -> { @comment.reactions.count }, +2 do
+      @comment.reactions.create! content: "👍", reacter: @user
+      @comment.reactions.create! content: "👍", reacter: users(:jason)
+    end
+  end
+
+  test "#emoji?" do
+    assert Reaction.new(content: "👍👍").emoji?
+    assert_not Reaction.new(content: "Nice!").emoji?
+  end
+
+  test "#deletable_by?" do
+    reaction = @comment.reactions.create! content: "👍", reacter: @user
+
+    assert reaction.deletable_by?(@user)
+    assert_not reaction.deletable_by?(users(:kevin))
+  end
+
+  test "the account and reacter default to the comment's account and the current user" do
+    Current.user = @user
+
+    reaction = @comment.reactions.create! content: "👍"
+
+    assert_equal @comment.account, reaction.account
+    assert_equal @user, reaction.reacter
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = cards(:logo).comments.create! body: "Bye", creator: @user
+    reaction = comment.reactions.create! content: "👍", reacter: @user
+
+    comment.destroy
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creating a reaction broadcasts the comment's reactions strip" do
+    assert_turbo_stream_broadcasts [ @comment.card, :reactions ] do
+      @comment.reactions.create! content: "👍", reacter: @user
+    end
+  end
+
+  test "destroying a reaction broadcasts the comment's reactions strip" do
+    reaction = @comment.reactions.create! content: "👍", reacter: @user
+
+    assert_turbo_stream_broadcasts [ @comment.card, :reactions ] do
+      reaction.destroy
+    end
+  end
+
+  test "broadcasting replaces the comment's reactions strip" do
+    @comment.reactions.create! content: "👍", reacter: @user
+
+    streams = capture_turbo_stream_broadcasts([ @comment.card, :reactions ]) do
+      @comment.reactions.create! content: "🎉", reacter: users(:kevin)
+    end
+
+    assert_equal 1, streams.size
+    assert_equal "replace", streams.first["action"]
+    assert_equal dom_id(@comment, :reactions), streams.first["target"]
+    assert_includes streams.first.text, "🎉"
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..3a7cbdb
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,132 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction to a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      add_reaction "Nice!"
+
+      assert_selector ".reaction", text: "Nice!"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "Nice!", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "adding an emoji reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      add_reaction "🎉"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal "🎉", @comment.reactions.last.content
+  end
+
+  test "canceling leaves no reaction behind" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      click_on "Add a reaction"
+      fill_in reaction_content, with: "Never mind"
+      click_on "Cancel"
+
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form"
+    end
+
+    assert_empty @comment.reactions.where(content: "Never mind")
+  end
+
+  test "a reaction shows who left it" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: reactions(:logo_agreement_kevin_boost_by_jz).content
+      assert_selector ".reaction[title*='JZ']"
+      assert_selector ".reaction .avatar[aria-label='JZ']"
+    end
+  end
+
+  test "removing your own reaction" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    visit card_url(@card)
+
+    within "##{dom_id(reaction)}" do
+      click_on "Remove your reaction"
+    end
+
+    assert_no_selector "##{dom_id(reaction)}"
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "someone else's reaction can't be removed" do
+    reaction = reactions(:logo_agreement_kevin_boost_by_jz)
+
+    visit card_url(@card)
+
+    within "##{dom_id(reaction)}" do
+      assert_no_selector "button"
+    end
+  end
+
+  test "reactions left by someone else appear as they happen" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction", text: "🎉"
+    end
+
+    @comment.reactions.create!(content: "🎉", reacter: users(:david))
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+
+  test "reactions removed by someone else disappear as they happen" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:david))
+
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    assert_selector "##{dom_id(reaction)}"
+
+    reaction.destroy!
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  private
+    def reaction_content
+      "reaction_content"
+    end
+
+    def add_reaction(content)
+      click_on "Add a reaction"
+      fill_in reaction_content, with: content
+      click_on "Add this reaction"
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
