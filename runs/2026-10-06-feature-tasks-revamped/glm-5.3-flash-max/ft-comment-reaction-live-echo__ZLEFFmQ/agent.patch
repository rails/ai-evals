@@ -0,0 +1,51 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    fresh_when etag: @comment.reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.find_or_create_by! reaction_params.merge(reacter: Current.user)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..0e0315f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Turns the "add a reaction" button into a small input to type your reaction in,
+// and reveals the way to remove one of your own reactions.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+
+    nextFrame().then(() => this.inputTarget.focus())
+  }
+
+  close() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.querySelector("form")?.reset()
+    this.triggerTarget.hidden = false
+  }
+
+  submitEnd(event) {
+    if (event.detail.success) this.close()
+  }
+
+  toggleExpanded(event) {
+    if (event.target.closest("form")) return
+
+    event.currentTarget.classList.toggle("expanded")
+  }
+
+  remove(event) {
+    event.currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+}
