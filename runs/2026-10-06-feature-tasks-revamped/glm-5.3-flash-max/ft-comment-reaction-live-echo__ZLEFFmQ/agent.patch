+<%# The button that turns into a small input to add your own reaction %>
+<div class="reaction__form" data-reactions-target="form" hidden data-action="keydown.esc->reactions#close">
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "flex align-center",
+        data: { action: "turbo:submit-end->reactions#submitEnd" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::MAX_LENGTH, required: true,
+            placeholder: "React…", autocomplete: "off", data: { reactions_target: "input" } %>
+      <span class="for-screen-reader">Add a reaction to this comment</span>
+    <% end %>
+
+    <%= form.button class: "reaction__submit-btn btn", title: "Add this reaction", aria: { label: "Add this reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add this reaction</span>
+    <% end %>
+
+    <%= form.button type: "button", class: "reaction__cancel-btn btn", title: "Cancel", aria: { label: "Cancel" },
+          data: { action: "reactions#close:stop" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+</div>
+
+<%= button_tag type: "button", class: "reactions__trigger btn", aria: { label: "Add a reaction" },
+      data: { reactions_target: "trigger", action: "reactions#open" } do %>
+  <%= image_tag "boost-color.svg", class: "icon", alt: "" %>
+  <span class="for-screen-reader">Add a reaction</span>
+<% end %>
