--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,29 @@
+class Reaction < ApplicationRecord
+  MAX_LENGTH = 16
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+  scope :preloaded, -> { includes :reacter }
+
+  validates :content, presence: true, length: { maximum: MAX_LENGTH }
+  validates :content, uniqueness: { scope: [ :reactable_type, :reactable_id, :reacter_id ] }
+
+  after_create_commit -> { broadcast_reactions }
+  after_destroy_commit -> { broadcast_reactions }
+
+  def deletable_by?(user)
+    reacter == user
+  end
+
+  def emoji?
+    content.to_s.all_emoji?
+  end
+
+  private
+    def broadcast_reactions
+      reactable.broadcast_reactions
+    end
+end
