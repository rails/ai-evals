@@ -0,0 +1,48 @@
+require "application_system_test_case"
+
+class ZzzScreenshotTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  PROPERTIES = %w[display block-size inline-size border-radius background-color position inset z-index cursor padding font-size max-inline-size]
+
+  test "screenshots" do
+    sign_in_as users(:kevin)
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(content: "\u{1F44D}", reacter: users(:david))
+    visit card_url(cards(:logo))
+    strip = "##{dom_id(comment, :reactions)}"
+
+    puts "TRIGGER: #{describe("#{strip} .reactions__trigger")}"
+    puts "CHIP: #{describe("#{strip} .reaction")}"
+
+    within strip do
+      click_on "Add a reaction"
+    end
+    puts "FORM: #{describe("#{strip} .reaction__form")}"
+    puts "INNER: #{describe("#{strip} .reaction__form form")}"
+    puts "INPUT: #{describe("#{strip} .reaction__input")}"
+    puts "LABEL: #{describe("#{strip} .reaction__form-label")}"
+    puts "SUBMIT: #{describe("#{strip} .reaction__submit-btn")}"
+    puts "CANCEL: #{describe("#{strip} .reaction__cancel-btn")}"
+    page.save_screenshot("tmp/screenshots/reactions-open.png")
+
+    within strip do
+      find(".reaction--deleteable").click
+    end
+    puts "EXPANDED: #{describe("#{strip} .reaction--deleteable")}"
+    puts "DELETE: #{describe("#{strip} .reaction__delete")}"
+    page.save_screenshot("tmp/screenshots/reactions-deleteable.png")
+  end
+
+  private
+    def describe(selector)
+      data = page.evaluate_script(
+        "(() => { const el = document.querySelector(arguments[0]); if (!el) return null;" \
+        "const s = getComputedStyle(el); const r = el.getBoundingClientRect();" \
+        "const out = { x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.width), h: Math.round(r.height) };" \
+        "arguments[1].forEach(p => out[p] = s.getPropertyValue(p)); return out; })()",
+        selector, PROPERTIES
+      )
+      "#{selector} #{data.map { |k, v| "#{k}=#{v.respond_to?(:round) ? v.round(2) : v}" }.join(' ')}"
+    end
+end
