diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..7c2b745
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create replaces the comment's reactions strip" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+
+    assert_turbo_stream action: "replace", target: dom_id(@comment, :reactions) do
+      assert_select ".reaction span", text: "🎉"
+    end
+  end
+
+  test "create with the same content twice doesn't leave two reactions" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      2.times do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "create as JSON" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :json
+
+    assert_response :created
+    assert_equal "🎉", @response.parsed_body["content"]
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_kevin_boost_by_kevin).content, @response.parsed_body.first["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.first["reacter"]["id"]
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_kevin_boost_by_kevin)
+
+    get card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+  end
+
+  test "destroy" do
+    reaction = @comment.reactions.create! content: "🎉", reacter: users(:kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "destroying someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_boost_by_jz)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
