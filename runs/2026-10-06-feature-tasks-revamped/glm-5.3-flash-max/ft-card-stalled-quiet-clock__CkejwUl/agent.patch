diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..161f240
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,25 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :bursted, -> { where.not bursted_at: nil }
+
+    # Cards that drew a burst of attention and have been quiet ever since.
+    scope :stalled, -> { bursted.active.where last_active_at: ..STALL_PERIOD.ago }
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+
+  def stalled?
+    bursted? && active? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  # The moment the card stalls, unless something happens first.
+  def stalls_after
+    last_active_at + STALL_PERIOD if bursted? && active?
+  end
+end
