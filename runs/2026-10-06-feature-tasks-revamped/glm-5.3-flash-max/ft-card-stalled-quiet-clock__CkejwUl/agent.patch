diff --git a/app/models/card/burst.rb b/app/models/card/burst.rb
new file mode 100644
index 0000000..b5e7425
--- /dev/null
+++ b/app/models/card/burst.rb
@@ -0,0 +1,58 @@
+# A burst of attention on a card: three or more comments from at least two
+# different people landing on it within a third of the board's auto-postpone
+# period, or someone being assigned to it, or someone reopening it.
+#
+# Bursts are sticky: once a card has bursted it stays bursted, since a burst
+# says something about its history. It's the stall that activity resets.
+class Card::Burst
+  COMMENTS = 3
+  PEOPLE = 2
+
+  ATTENTION_EVENT_ACTIONS = %w[ card_assigned card_reopened ]
+
+  attr_reader :card
+
+  class << self
+    # Flags the card with the burst it just had, if any. There's nothing to look
+    # for on a card that already bursted.
+    def detect(card)
+      new(card).flag unless card.bursted?
+    end
+  end
+
+  def initialize(card)
+    @card = card
+  end
+
+  def bursted?
+    attended? || commented_enough?
+  end
+
+  def flag
+    card.update!(bursted_at: Time.current) if bursted?
+  end
+
+  private
+    def attended?
+      card.events.where(action: ATTENTION_EVENT_ACTIONS).exists?
+    end
+
+    def commented_enough?
+      counts = burst_comments.group(:creator_id).count
+      counts.values.sum >= COMMENTS && counts.size >= PEOPLE
+    end
+
+    # The comments posted from the latest burst window onwards, anchored on the
+    # most recent one so that backdated comments are caught too.
+    def burst_comments
+      card.comments.by_user.where created_at: (last_commented_at - window)..
+    end
+
+    def last_commented_at
+      card.comments.by_user.maximum(:created_at) || Time.current
+    end
+
+    def window
+      card.auto_postpone_period / 3.0
+    end
+end
