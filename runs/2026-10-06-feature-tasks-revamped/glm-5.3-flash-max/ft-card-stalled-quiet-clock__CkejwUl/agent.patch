diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..468f4c3
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    boards(:writebook).update! auto_postpone_period: 30.days
+  end
+
+  test "three comments from two people within the burst window flag the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.comments.create! body: "One", creator: users(:david)
+      card.comments.create! body: "Two", creator: users(:kevin)
+      card.comments.create! body: "Three", creator: users(:kevin)
+    end
+
+    assert_predicate card.reload, :bursted?
+    assert_predicate card, :stalled?
+  end
+
+  test "three comments from the same person don't flag the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.comments.create! body: "One", creator: users(:david)
+      card.comments.create! body: "Two", creator: users(:david)
+      card.comments.create! body: "Three", creator: users(:david)
+    end
+
+    assert_not_predicate card.reload, :bursted?
+    assert_not_predicate card, :stalled?
+  end
+
+  test "two comments from two people don't flag the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.comments.create! body: "One", creator: users(:david)
+      card.comments.create! body: "Two", creator: users(:kevin)
+    end
+
+    assert_not_predicate card.reload, :bursted?
+    assert_not_predicate card, :stalled?
+  end
+
+  test "comments spread beyond the burst window don't flag the card" do
+    card = cards(:text)
+
+    card.comments.create! body: "One", creator: users(:david), created_at: 8.weeks.ago
+    card.comments.create! body: "Two", creator: users(:kevin), created_at: 4.weeks.ago
+    card.comments.create! body: "Three", creator: users(:david), created_at: 1.week.ago
+
+    assert_not_predicate card.reload, :bursted?
+    assert_not_predicate card, :stalled?
+  end
+
+  test "system comments don't count as people" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.comments.create! body: "System", creator: card.account.system_user
+      card.comments.create! body: "One", creator: users(:david)
+      card.comments.create! body: "Two", creator: users(:kevin)
+    end
+
+    assert_not_predicate card.reload, :bursted?
+    assert_not_predicate card, :stalled?
+  end
+
+  test "assigning someone flags the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment users(:kevin)
+    end
+
+    assert_predicate card.reload, :bursted?
+    assert_predicate card, :stalled?
+  end
+
+  test "reopening a card flags it" do
+    card = cards(:text)
+    card.close
+
+    travel_to 3.weeks.ago do
+      card.reopen
+    end
+
+    assert_predicate card.reload, :bursted?
+    assert_predicate card, :stalled?
+  end
+
+  test "the first burst sticks" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      burst_with_comments card
+    end
+
+    assert_no_changes -> { card.reload.bursted_at } do
+      card.comments.create! body: "Another one", creator: users(:david)
+    end
+  end
+
+  test "an active card isn't stalled" do
+    card = cards(:text)
+
+    burst_with_comments card
+
+    assert_predicate card.reload, :bursted?
+    assert_not_predicate card, :stalled?
+  end
+
+  test "any activity resets the stall" do
+    card = cards(:text)
+    travel_to(3.weeks.ago) { burst_with_comments card }
+    assert_predicate card, :stalled?
+
+    card.comments.create! body: "Still on it", creator: users(:david)
+
+    assert_not_predicate card.reload, :stalled?
+  end
+
+  test "closed cards are never stalled" do
+    card = cards(:text)
+    travel_to 3.weeks.ago do
+      burst_with_comments card
+      card.close
+    end
+
+    assert_not_predicate card.reload, :stalled?
+  end
+
+  test "postponed cards are never stalled" do
+    card = cards(:text)
+    travel_to 3.weeks.ago do
+      burst_with_comments card
+      card.postpone
+    end
+
+    assert_not_predicate card.reload, :stalled?
+  end
+
+  test "stalled scope" do
+    stalled_card = cards(:text)
+    active_card = cards(:shipping)
+    closed_card = cards(:buy_domain)
+
+    travel_to 3.weeks.ago do
+      burst_with_comments stalled_card
+      burst_with_comments active_card
+      burst_with_comments closed_card
+    end
+    closed_card.close
+
+    assert_includes Card.stalled, stalled_card
+    assert_not_includes Card.stalled, active_card
+    assert_not_includes Card.stalled, closed_card
+  end
+
+  private
+    def burst_with_comments(card)
+      card.comments.create! body: "One", creator: users(:david)
+      card.comments.create! body: "Two", creator: users(:kevin)
+      card.comments.create! body: "Three", creator: users(:david)
+    end
+end
