diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..b594b2f
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,173 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "a card that never burst is not stalled" do
+    assert_not cards(:logo).stalled?
+    assert_not_includes Card.stalled, cards(:logo)
+  end
+
+  test "a card is not stalled before two weeks of inactivity" do
+    cards(:logo).update! burst_at: 1.week.ago
+
+    assert_not cards(:logo).stalled?
+    assert_not_includes Card.stalled, cards(:logo)
+  end
+
+  test "a card that burst and then went quiet for two weeks is stalled" do
+    cards(:logo).update! burst_at: 3.weeks.ago
+
+    assert cards(:logo).stalled?
+    assert_includes Card.stalled, cards(:logo)
+  end
+
+  test "three comments from two people within the burst window burst the card" do
+    card = cards(:layout)
+
+    travel_to 3.weeks.ago do
+      2.times { card.comments.create!(creator: users(:david), body: "Any news?") }
+      card.comments.create!(creator: users(:kevin), body: "Looking into it")
+    end
+
+    assert card.reload.burst?
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "comments from a single person never burst the card" do
+    card = cards(:layout)
+
+    travel_to 3.weeks.ago do
+      4.times { card.comments.create!(creator: users(:david), body: "Any news?") }
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "fewer than three comments never burst the card" do
+    card = cards(:layout)
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "Any news?")
+      card.comments.create!(creator: users(:kevin), body: "Looking into it")
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "comments spread over more than the burst window never burst the card" do
+    card = cards(:layout)
+
+    travel_to 3.weeks.ago { card.comments.create!(creator: users(:david), body: "Any news?") }
+    travel_to 2.weeks.ago { card.comments.create!(creator: users(:kevin), body: "Looking into it") }
+    travel_to 1.week.ago { card.comments.create!(creator: users(:david), body: "Still nothing") }
+
+    assert_not card.reload.burst?
+  end
+
+  test "being assigned bursts the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.toggle_assignment users(:david)
+    end
+
+    assert card.reload.burst?
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "being reopened bursts the card" do
+    card = cards(:shipping)
+
+    travel_to 3.weeks.ago do
+      card.reopen
+    end
+
+    assert card.reload.burst?
+    assert card.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "any activity on the card resets the burst" do
+    card = cards(:shipping)
+    card.update! burst_at: 3.weeks.ago
+
+    card.comments.create! body: "Still on it"
+
+    assert_not card.reload.burst?
+    assert_not card.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closing the card resets the burst" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago
+
+    card.close
+
+    assert_not card.reload.burst?
+  end
+
+  test "the stalled index lists stalled cards" do
+    cards(:logo).update! burst_at: 3.weeks.ago
+    cards(:text).update! burst_at: 1.week.ago
+
+    assert_equal [ cards(:logo) ], Card.indexed_by("stalled")
+  end
+
+  test "the burst window is a third of the board's auto-close period" do
+    board = boards(:writebook)
+    board.update! auto_postpone_period: 3.days
+
+    card = board.cards.open.first
+    card.comments.delete_all
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      travel 2.days
+      card.comments.create!(creator: users(:kevin), body: "Two")
+      travel 2.days
+      card.comments.create!(creator: users(:david), body: "Three")
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "system comments never burst the card" do
+    card = cards(:text)
+
+    travel_to 3.weeks.ago do
+      card.comments.create!(creator: users(:david), body: "One")
+      card.comments.create!(creator: users(:kevin), body: "Two")
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "unassigning the card resets the burst" do
+    card = cards(:logo)
+    assert card.assigned_to?(users(:kevin))
+    card.update! burst_at: 1.week.ago
+
+    card.toggle_assignment users(:kevin)
+
+    assert_not card.reload.burst?
+  end
+
+  test "closing the card clears the stall" do
+    card = cards(:layout)
+    card.update! burst_at: 3.weeks.ago
+
+    card.close
+
+    assert_not card.reload.stalled?
+  end
+
+  test "the stalled index is offered as a filter" do
+    assert_includes Filter::INDEXES, "stalled"
+  end
+end
