diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..35ad2a2
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,62 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  # A card bursts when it gets a sudden flurry of attention: three or more
+  # comments from at least two people landing on it within a third of the
+  # board's auto-close period, or someone being assigned to it or reopening it.
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  BURST_WINDOW_FRACTION = 3.0
+  BURSTING_EVENT_ACTIONS = %w[ card_assigned card_reopened ]
+
+  # A card that had a burst and then saw no activity for two weeks is stalled.
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { where(burst_at: ..STALL_PERIOD.ago) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    burst? && burst_at <= STALL_PERIOD.ago
+  end
+
+  def record_burst
+    update! burst_at: Time.current
+  end
+
+  def reset_burst
+    update! burst_at: nil if burst_at
+  end
+
+  def record_burst_from(event)
+    burst_or_reset event.action.in?(BURSTING_EVENT_ACTIONS)
+  end
+
+  def record_burst_from_comments
+    burst_or_reset comments_burst?
+  end
+
+  private
+    def burst_or_reset(bursting)
+      if bursting
+        record_burst
+      else
+        reset_burst
+      end
+    end
+
+    def comments_burst?
+      burst_comments = comments.by_user.where(created_at: burst_window.ago..Time.current)
+
+      burst_comments.count >= BURST_COMMENT_COUNT &&
+        burst_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+    end
+
+    def burst_window
+      (board.auto_postpone_period / BURST_WINDOW_FRACTION).seconds
+    end
+end
