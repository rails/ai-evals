diff --git a/script/i18n/build_error_pages.rb b/script/i18n/build_error_pages.rb
new file mode 100644
index 0000000..912feee
--- /dev/null
+++ b/script/i18n/build_error_pages.rb
@@ -0,0 +1,102 @@
+# Renders the static error pages in every language we ship.
+#
+# They're served straight from public/, before the app knows who is looking, so
+# each page carries both the English and the Japanese text.
+#
+#   ruby script/i18n/build_error_pages.rb
+
+require "pathname"
+
+ROOT = Pathname.new(File.expand_path("../..", __dir__))
+
+PAGES = {
+  "400.html" => {
+    status: "400",
+    title: "400 Bad Request",
+    heading: "Bad request",
+    detail: "Your request could not be understood by the server.",
+    back: "&larr; Back home"
+  },
+  "404.html" => {
+    status: "404",
+    title: "404 Not Found",
+    heading: "Sorry, that page doesn’t exist!",
+    detail: "You may have mistyped the address or the page may have moved.",
+    back: "&larr; Back home"
+  },
+  "406-unsupported-browser.html" => {
+    status: "406",
+    title: "406 Unsupported Browser",
+    heading: "You need to upgrade your browser",
+    detail: "This application requires a modern browser. Please upgrade to the latest version.",
+    back: "&larr; Back home"
+  },
+  "422.html" => {
+    status: "422",
+    title: "422 Unprocessable Entity",
+    heading: "Unprocessable entity",
+    detail: "The server understands the request but was unable to process it.",
+    back: "&larr; Back home"
+  },
+  "500.html" => {
+    status: "500",
+    title: "500 Internal Server Error",
+    heading: "Internal server error",
+    detail: "Something went wrong on our end; please try again later.",
+    back: "&larr; Back home"
+  }
+}.freeze
+
+TRANSLATIONS = {
+  "Bad request" => "リクエストが正しくありません",
+  "Your request could not be understood by the server." => "リクエストをサーバーが解釈できませんでした。",
+  "Sorry, that page doesn’t exist!" => "申し訳ありません。そのページは存在しません！",
+  "You may have mistyped the address or the page may have moved." =>
+    "アドレスの入力間違いか、ページが移動した可能性があります。",
+  "You need to upgrade your browser" => "ブラウザをアップグレードしてください",
+  "This application requires a modern browser. Please upgrade to the latest version." =>
+    "このアプリケーションは最新のブラウザが必要です。最新版にアップグレードしてください。",
+  "Unprocessable entity" => "リクエストを処理できません",
+  "The server understands the request but was unable to process it." =>
+    "リクエストは理解できましたが、処理できませんでした。",
+  "Internal server error" => "内部サーバーエラー",
+  "Something went wrong on our end; please try again later." =>
+    "こちらで問題が発生しました。しばらくしてからもう一度お試しください。",
+  "&larr; Back home" => "&larr; ホームへ戻る"
+}.freeze
+
+def page(file)
+  contents = PAGES.fetch(file)
+  japanese = contents.to_h { |key, text| [ key, TRANSLATIONS.fetch(text, text) ] }
+
+  <<~HTML
+    <!doctype html>
+    <html lang="en">
+      <head>
+        <title>#{contents[:title]}</title>
+        <meta charset="utf-8">
+        <meta name="viewport" content="initial-scale=1, width=device-width">
+        <meta name="robots" content="noindex, nofollow">
+        <link rel="stylesheet" href="/error.css">
+      </head>
+      <body>
+        <hgroup class="error-page__stamp">
+          <h1>#{contents[:status]}</h1>
+          <h2 lang="en">#{contents[:heading]}</h2>
+          <h2 lang="ja">#{japanese[:heading]}</h2>
+          <hr />
+          <div lang="en">#{contents[:detail]}</div>
+          <div lang="ja">#{japanese[:detail]}</div>
+        </hgroup>
+
+        <a href="/" lang="en">&larr; Back home</a>
+        <a href="/" lang="ja">#{TRANSLATIONS[contents[:back]]}</a>
+      </body>
+    </html>
+  HTML
+end
+
+PAGES.each_key do |file|
+  File.write(ROOT.join("public/#{file}"), page(file))
+  puts "public/#{file}"
+end
