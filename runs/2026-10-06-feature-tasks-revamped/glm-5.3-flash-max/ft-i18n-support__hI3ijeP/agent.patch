diff --git a/config/initializers/locale.rb b/config/initializers/locale.rb
new file mode 100644
index 0000000..5544197
--- /dev/null
+++ b/config/initializers/locale.rb
@@ -0,0 +1,5 @@
+# Fizzy speaks English and Japanese. English is the default; anything a locale
+# is missing falls back to it.
+Rails.application.config.i18n.available_locales = Fizzy.available_locales
+Rails.application.config.i18n.default_locale = :en
+Rails.application.config.i18n.fallbacks = [ :en ]
diff --git a/config/initializers/tenanting/turbo.rb b/config/initializers/tenanting/turbo.rb
index 9923fc0..92b4bcf 100644
--- a/config/initializers/tenanting/turbo.rb
+++ b/config/initializers/tenanting/turbo.rb
@@ -12,6 +12,22 @@ module TurboStreamsJobExtensions
   end
 end
 
+# Streams render outside of any request, so they read the locale of the person
+# the update is for rather than falling back to English.
+module TurboStreamsLocaleExtensions
+  def perform(stream, ...)
+    locale = stream.try(:identity).try(:locale)
+
+    if locale.present?
+      I18n.with_locale(locale) { super }
+    else
+      super
+    end
+  end
+end
+
 Rails.application.config.after_initialize do
   Turbo::StreamsChannel.prepend TurboStreamsJobExtensions
+  Turbo::Streams::BroadcastJob.prepend TurboStreamsLocaleExtensions
+  Turbo::Streams::BroadcastStreamJob.prepend TurboStreamsLocaleExtensions
 end
