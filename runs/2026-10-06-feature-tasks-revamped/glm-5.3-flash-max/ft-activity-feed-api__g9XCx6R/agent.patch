@@ -0,0 +1,286 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @davids_bearer_token = bearer_token_env(identity_access_tokens(:davids_api_token).token)
+    @jasons_bearer_token = bearer_token_env(identity_access_tokens(:jasons_api_token).token)
+  end
+
+  test "index as JSON" do
+    get activities_path, env: @davids_bearer_token
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_not_empty @response.parsed_body
+  end
+
+  test "index defaults to JSON" do
+    sign_in_as :kevin
+
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    sign_in_as :kevin
+
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index fails to authenticate with an invalid access token" do
+    get activities_path, env: bearer_token_env("nonsense")
+
+    assert_response :unauthorized
+  end
+
+  test "index includes all the documented attributes" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal event.eventable_type, activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+  end
+
+  test "index includes a card url for card events" do
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index includes a url to the commented card for comment events" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:layout_commented).id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+  end
+
+  test "index describes assignments from the perspective of the viewer" do
+    with_actionview_partial_caching do
+      get activities_path, env: @davids_bearer_token
+
+      assert_includes find_activity(events(:logo_assignment_david))["description"], "will handle"
+
+      sign_in_as :kevin
+
+      get activities_path, as: :json
+
+      assert_includes find_activity(events(:logo_assignment_david))["description"], "assigned"
+    end
+  end
+
+  test "index exposes assignment particulars" do
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index exposes board change particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "Writebook" } }
+
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal({ "old_board" => "Old board", "new_board" => "Writebook" }, activity["particulars"])
+  end
+
+  test "index exposes title change particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => cards(:logo).title } }
+
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal({ "old_title" => "Old title", "new_title" => cards(:logo).title }, activity["particulars"])
+  end
+
+  test "index exposes triage particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } }
+
+    get activities_path, env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "index returns empty strings for missing board, title and column particulars" do
+    board_event = events(:logo_published)
+    board_event.update! action: "card_board_changed", particulars: {}
+    title_event = events(:layout_published)
+    title_event.update! action: "card_title_changed", particulars: {}
+    column_event = events(:layout_assignment_jz)
+    column_event.update! action: "card_triaged", particulars: {}
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, find_activity(board_event)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, find_activity(title_event)["particulars"])
+    assert_equal({ "column" => "" }, find_activity(column_event)["particulars"])
+  end
+
+  test "index returns empty particulars for events without details" do
+    get activities_path, env: @davids_bearer_token
+
+    assert_equal({}, find_activity(events(:logo_published))["particulars"])
+  end
+
+  test "index includes card title changes" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed"
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_includes @response.parsed_body.pluck("id"), event.id
+  end
+
+  test "index omits deprecated card collection changes" do
+    event = events(:logo_published)
+    event.update! action: "card_collection_changed"
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+  end
+
+  test "index returns activity ordered by newest first" do
+    get activities_path, env: @davids_bearer_token
+
+    created_ats = @response.parsed_body.pluck("created_at")
+
+    assert_equal created_ats.max, created_ats.first
+    assert_equal created_ats.min, created_ats.last
+  end
+
+  test "index only returns activity you can access" do
+    inaccessible_event = events(:logo_published)
+    inaccessible_event.update! board: boards(:private)
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_not_includes @response.parsed_body.pluck("id"), inaccessible_event.id
+  end
+
+  test "index returns no activity when you have no access to any board" do
+    get activities_path, env: @jasons_bearer_token
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index filters activity by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), env: @davids_bearer_token
+
+    assert_not_empty @response.parsed_body
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+  end
+
+  test "index ignores blank filter values" do
+    get activities_path(creator_ids: [ "" ], board_ids: ""), env: @davids_bearer_token
+
+    assert_response :success
+    assert_equal david_accessible_activities.count, @response.parsed_body.count
+  end
+
+  test "index filters activity by board" do
+    inaccessible_event = events(:logo_published)
+    inaccessible_event.update! board: boards(:private)
+
+    get activities_path(board_ids: [ boards(:writebook).id ]), env: @davids_bearer_token
+
+    assert_not_includes @response.parsed_body.pluck("id"), inaccessible_event.id
+  end
+
+  test "index reports the total count of activity" do
+    get activities_path, env: @davids_bearer_token
+
+    assert_equal david_accessible_activities.count.to_s, @response.headers["X-Total-Count"]
+    assert_equal david_accessible_activities.count, @response.parsed_body.count
+  end
+
+  test "index paginates activity" do
+    20.times { |index| rename cards(:logo), "Logo #{index}" }
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_response :success
+    assert_equal david_accessible_activities.count.to_s, @response.headers["X-Total-Count"]
+    assert @response.headers["Link"].include?(%(rel="next")), "Expected a next page link header"
+    assert_equal 15, @response.parsed_body.count
+
+    get activities_path(page: 2), env: @davids_bearer_token
+
+    assert_response :success
+    assert_equal david_accessible_activities.count - 15, @response.parsed_body.count
+  end
+
+  test "index supports etag caching" do
+    get activities_path, env: @davids_bearer_token
+
+    assert_response :success
+    assert_equal "max-age=0, private, must-revalidate", @response.headers["Cache-Control"]
+
+    get activities_path, env: @davids_bearer_token.merge("HTTP_IF_NONE_MATCH" => @response.headers["ETag"])
+
+    assert_response :not_modified
+  end
+
+  private
+
+  test "index returns the latest activity first when events share a timestamp" do
+    3.times { |index| rename cards(:logo), "Logo #{index}" }
+    Event.where(action: "card_title_changed").update_all(created_at: Time.current)
+
+    get activities_path, env: @davids_bearer_token
+
+    assert_equal [ "Logo 2", "Logo 1", "Logo 0" ], @response.parsed_body.first(3).map { |activity| activity.dig("particulars", "new_title") }
+  end
+    def find_activity(event)
+      @response.parsed_body.find { |record| record["id"] == event.id }
+    end
+
+    def rename(card, title)
+      Current.user = users(:david)
+      card.update! title: title
+    ensure
+      Current.user = nil
+    end
+
+    def david_accessible_activities
+      Event.where(action: ActivitiesController::ACTIONS, board: users(:david).boards)
+    end
+
+    def bearer_token_env(token)
+      { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+    end
+end
