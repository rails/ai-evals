+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment particulars hold the assignee ids" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).activity_particulars)
+  end
+
+  test "unassignment particulars hold the assignee ids" do
+    event = events(:logo_assignment_jz)
+    event.update! action: "card_unassigned"
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.activity_particulars)
+  end
+
+  test "board change particulars hold the old and the new board" do
+    event = events(:logo_published)
+    event.update! action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "Writebook" } }
+
+    assert_equal({ old_board: "Old board", new_board: "Writebook" }, event.activity_particulars)
+  end
+
+  test "title change particulars hold the old and the new title" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+
+    assert_equal({ old_title: "Old title", new_title: "New title" }, event.activity_particulars)
+  end
+
+  test "triage particulars hold the column" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } }
+
+    assert_equal({ column: "In Progress" }, event.activity_particulars)
+  end
+
+  test "unrecorded board, title and column details are empty strings" do
