diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..5f3f948 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,29 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # The particulars of an event as exposed by the activities API: the details
+  # recorded for the action are flattened, and the ones that were never recorded
+  # are returned as empty strings.
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular("old_board"), new_board: particular("new_board") }
+    when "card_title_changed"
+      { old_title: particular("old_title"), new_title: particular("new_title") }
+    when "card_triaged"
+      { column: particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    # Details are recorded either at the top level, like +assignee_ids+, or nested
+    # under a +particulars+ key, like +old_board+ and +column+.
+    def particular(name)
+      particulars.to_h[name].presence || particulars.to_h.dig("particulars", name).presence || ""
+    end
 end
