@@ -0,0 +1,21 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      scope = Current.user.accessible_events.activity.preloaded.reverse_chronologically
+      scope = scope.where(creator_id: creator_ids) if creator_ids.present?
+      scope = scope.where(board_id: board_ids) if board_ids.present?
+      scope
+    end
+
+    def creator_ids
+      params[:creator_ids]
+    end
+
+    def board_ids
+      params[:board_ids]
+    end
+end
