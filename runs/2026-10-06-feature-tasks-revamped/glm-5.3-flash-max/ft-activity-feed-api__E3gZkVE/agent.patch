@@ -0,0 +1,104 @@
+# Activities
+
+Activities are the events that happen on the account: cards being added, moved, renamed,
+assigned, closed, or commented on. They are the same events shown in the HTML timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activities you have access to, newest first. Only events from
+boards you can access are returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by creator user ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_published",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David Heinemeier Hansson added First!",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!",
+      "status": "published",
+      "description": "Hello, World!",
+      "description_html": "<div class=\"action-text-content\"><p>Hello, World!</p></div>",
+      "image_url": null,
+      "has_attachments": false,
+      "tags": [],
+      "closed": false,
+      "postponed": false,
+      "golden": false,
+      "last_active_at": "2025-12-05T19:38:48.553Z",
+      "created_at": "2025-12-05T19:38:48.540Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+      "board": { "id": "03f5v9zkft4hj9qq0lsn9ohcm" },
+      "creator": { "id": "03f5v9zjw7pz8717a4no1h8a7" },
+      "comments_url": "http://app.fizzy.localhost:3006/897362094/cards/1/comments",
+      "reactions_url": "http://app.fizzy.localhost:3006/897362094/cards/1/reactions"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+      "creator": {
+        "id": "03f5v9zjw7pz8717a4no1h8a7",
+        "name": "David Heinemeier Hansson",
+        "role": "owner",
+        "active": true,
+        "email_address": "david@example.com",
+        "created_at": "2025-12-05T19:36:35.401Z",
+        "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+      }
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable` is the resource the activity happened on, either a `Card` or a `Comment`,
+rendered with its regular API representation. The `url` of an activity opens the card, or,
+for comments, the card where the comment was posted with an anchor to that comment.
+
+## `particulars`
+
+The `particulars` object holds the details specific to the `action` of the activity. All
+other actions return an empty object.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing board, title, or column values are returned as empty strings.
+
+```json
+{
+  "action": "card_title_changed",
+  "particulars": { "old_title": "First!", "new_title": "Hello, World!" }
+}
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..a41907a
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,216 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "index as JSON" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert @response.parsed_body.present?
+
+    @response.parsed_body.each do |activity|
+      assert_equal %w[action board created_at creator description eventable eventable_type id particulars url].sort, activity.keys.sort
+    end
+  end
+
+  test "index as JSON with an access token" do
+    logout_and_sign_in_as :david
+
+    get activities_path, env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    assert_response :success
+  end
+
+  test "index as JSON fails to authenticate with an invalid access token" do
+    sign_out
+
+    get activities_path, env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+
+    assert_response :unauthorized
+  end
+
+  test "index as JSON is ordered from newest to oldest" do
+    get activities_path(format: :json)
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index as JSON mirrors the timeline actions" do
+    cards(:logo).update! title: "Logo needs a rename"
+
+    deprecated_event = create_event("card_collection_changed")
+    title_changed_event = create_event("card_title_changed")
+
+    get activities_path(format: :json)
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, title_changed_event.id
+    assert_not_includes ids, deprecated_event.id
+
+    assert_not_includes @response.parsed_body.pluck("action"), "card_description_changed"
+  end
+
+  test "index as JSON includes eventable, board and creator" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_published" }
+
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "index as JSON includes comments as eventable" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "comment_created" }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+  end
+
+  test "index as JSON returns the url of the card for card events" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_published" }
+
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index as JSON returns the url of the card anchored to the comment for comment events" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "comment_created" }
+    comment = Comment.find(activity.dig("eventable", "id"))
+
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "index as JSON returns the plain text description" do
+    get activities_path(format: :json)
+
+    @response.parsed_body.each do |activity|
+      event = Event.find(activity["id"])
+
+      assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    end
+  end
+
+  test "index as JSON returns assignee ids in particulars" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_assigned" }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON returns boards in particulars for board changes" do
+    event = create_event("card_board_changed", particulars: { particulars: { old_board: "Old", new_board: "New" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == event.id }
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, activity["particulars"])
+  end
+
+  test "index as JSON returns titles in particulars for title changes" do
+    event = create_event("card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == event.id }
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+  end
+
+  test "index as JSON returns the column in particulars for triaged cards" do
+    event = create_event("card_triaged", particulars: { particulars: { column: "In Progress" } })
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == event.id }
+
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "index as JSON returns an empty particulars object for other actions" do
+    event = create_event("card_published")
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == event.id }
+
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    event = create_event("card_title_changed")
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == event.id }
+
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity["particulars"])
+  end
+
+  test "index as JSON can filter by creator" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    assert @response.parsed_body.present?
+    assert_equal [ users(:david).id ], @response.parsed_body.pluck("creator").pluck("id").uniq
+  end
+
+  test "index as JSON can filter by board" do
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+
+    assert @response.parsed_body.present?
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.pluck("board").pluck("id").uniq
+  end
+
+  test "index as JSON only returns activity from accessible boards" do
+    inaccessible_board = Board.create! name: "Secret", all_access: false, creator: users(:david)
+    create_event("card_published", board: inaccessible_board)
+
+    get activities_path(format: :json), params: { board_ids: [ inaccessible_board.id ] }
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON without any activity" do
+    Current.user.boards.destroy_all
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON is paginated" do
+    20.times do |index|
+      create_event("card_published", eventable: boards(:writebook).cards.create!(title: "Card #{index}", creator: users(:kevin)))
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_match 'rel="next"', response.headers["Link"]
+
+    get activities_path(format: :json, page: 2)
+
+    assert_response :success
+    assert @response.parsed_body.present?
+  end
+
+  private
+    def create_event(action, board: boards(:writebook), eventable: cards(:logo), particulars: {})
+      board.events.create! action:, creator: users(:kevin), eventable:, particulars:
+    end
+end
