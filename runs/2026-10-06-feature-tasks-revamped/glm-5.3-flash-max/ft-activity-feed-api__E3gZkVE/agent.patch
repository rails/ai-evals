diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..56630c0 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: stored_particular("old_board"), new_board: stored_particular("new_board") }
+    when "card_title_changed"
+      { old_title: stored_particular("old_title"), new_title: stored_particular("new_title") }
+    when "card_triaged"
+      { column: stored_particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def stored_particular(name)
+      particulars.dig("particulars", name).to_s
+    end
 end
