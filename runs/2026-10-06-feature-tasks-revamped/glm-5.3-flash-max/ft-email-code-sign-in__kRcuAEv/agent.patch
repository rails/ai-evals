+    </div>
+
+    <button type="submit" id="verify_code" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? %>
+    <p class="txt-subtle margin-none">Psst, here’s your code: <strong><%= @email_code.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
