+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, maxlength: EmailCode::CODE_LENGTH, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", class: "input txt-large full-width", placeholder: "Enter your code…" %>
