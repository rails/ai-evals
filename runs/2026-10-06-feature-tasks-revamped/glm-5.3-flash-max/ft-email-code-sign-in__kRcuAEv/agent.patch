--- /dev/null
+++ b/app/controllers/email_codes_controller.rb
@@ -0,0 +1,91 @@
+class EmailCodesController < ApplicationController
+  include EmailCodeFlow
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :set_email_code
+
+  def new
+    redirect_to new_session_path(script_name: nil) unless @email_code
+  end
+
+  def create
+    if @email_code&.verify?(params.expect(:code))
+      complete_email_code_flow
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:email_code_id])
+    end
+
+    def complete_email_code_flow
+      identity = @email_code.identity
+      intent = @email_code.intent
+      join_code = @email_code.join_code
+
+      @email_code.consume
+      end_email_code_flow
+
+      terminate_session if Current.session
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to destination_after_verifying(intent, identity, join_code) }
+        format.json { head :no_content }
+      end
+    end
+
+    def destination_after_verifying(intent, identity, join_code)
+      case intent
+      when "sign_in" then destination_after_sign_in(identity)
+      when "sign_up" then new_signup_completion_path
+      when "join" then destination_after_join(join_code, identity)
+      end
+    end
+
+    def destination_after_sign_in(identity)
+      if identity.users.exists?
+        after_authentication_url
+      else
+        session_menu_path
+      end
+    end
+
+    def destination_after_join(join_code, identity)
+      if join_code && (user = join_code.redeem_for(identity))
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        session_menu_path
+      end
+    end
+
+    def invalid_code
+      message = "That code didn\u2019t work. Check it and try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_email_code_path, alert: message }
+        format.json { render json: { message: message }, status: :unprocessable_entity }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_email_code_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
