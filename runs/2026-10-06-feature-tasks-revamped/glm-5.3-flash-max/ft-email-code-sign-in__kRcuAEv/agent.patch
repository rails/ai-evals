diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..d8ea31e
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,76 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = "23456789ABCDEFGHJKMNPQRSTUVWXYZ".chars.freeze
+  EXPIRY_DURATION = 15.minutes
+  INTENTS = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :intent, :code, :expires_at, presence: true
+  validates :intent, inclusion: { in: INTENTS }
+  validates :code, length: { is: CODE_LENGTH }
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  class << self
+    def issue(identity, intent:, join_code: nil)
+      # Only the code we emailed last works.
+      where(identity: identity).delete_all
+
+      create!(
+        identity: identity,
+        intent: intent,
+        join_code: join_code,
+        code: generate_code,
+        expires_at: EXPIRY_DURATION.from_now
+      ).tap(&:deliver)
+    end
+
+    def cleanup(batch_size: 500, pause: 0.1)
+      sleep pause until expired.limit(batch_size).delete_all.zero?
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_CHARACTERS)
+      end
+  end
+
+  def active?
+    expires_at > Time.current
+  end
+
+  def verify?(code)
+    active? && ActiveSupport::SecurityUtils.secure_compare(self.code, normalize(code))
+  end
+
+  def consume
+    destroy!
+  end
+
+  def deliver
+    IdentityMailer.verification_code(self).deliver_later
+    log_code_unless_email_is_configured
+  end
+
+  private
+    def normalize(code)
+      code.to_s.strip.upcase
+    end
+
+    def log_code_unless_email_is_configured
+      unless email_configured?
+        Rails.logger.info "Email isn't configured. Verification code for #{identity.email_address}: #{code}"
+      end
+    end
+
+    def email_configured?
+      if Rails.application.config.action_mailer.delivery_method == :smtp
+        Rails.application.config.action_mailer.smtp_settings[:address].present?
+      else
+        true
+      end
+    end
+end
