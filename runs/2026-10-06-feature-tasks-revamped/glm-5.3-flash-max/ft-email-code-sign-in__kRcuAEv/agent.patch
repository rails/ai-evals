--- /dev/null
+++ b/app/controllers/concerns/email_code_flow.rb
@@ -0,0 +1,20 @@
+# Signing in, signing up, and joining an account by email all start the same way:
+# prove you control the email address by entering a code we emailed you.
+module EmailCodeFlow
+  extend ActiveSupport::Concern
+
+  private
+    def start_email_code_flow(identity, intent:, join_code: nil)
+      email_code = EmailCode.issue(identity, intent: intent, join_code: join_code)
+      session[:email_code_id] = email_code.id
+
+      respond_to do |format|
+        format.html { redirect_to new_email_code_path(script_name: nil) }
+        format.json { head :no_content }
+      end
+    end
+
+    def end_email_code_flow
+      session.delete(:email_code_id)
+    end
+end
