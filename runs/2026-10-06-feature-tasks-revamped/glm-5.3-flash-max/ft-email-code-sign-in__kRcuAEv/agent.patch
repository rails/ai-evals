diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..e22820b
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "issue generates a code, expires it, and emails it" do
+    assert_emails 1 do
+      @email_code = EmailCode.issue(@identity, intent: :sign_in)
+    end
+
+    assert_equal @identity, @email_code.identity
+    assert_equal "sign_in", @email_code.intent
+    assert_equal EmailCode::CODE_LENGTH, @email_code.code.length
+    assert @email_code.expires_at > EmailCode::EXPIRY_DURATION.ago
+    assert @email_code.active?
+    assert_not @email_code.verify?(nil)
+  end
+
+  test "issue emails the code in the subject" do
+    assert_emails 1 do
+      @email_code = EmailCode.issue(@identity, intent: :sign_up)
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, @email_code.code
+    assert_match @email_code.code, email.body.encoded
+  end
+
+  test "issue with a join code remembers it" do
+    join_code = account_join_codes(:"37s")
+
+    email_code = EmailCode.issue(@identity, intent: :join, join_code: join_code)
+
+    assert_equal join_code, email_code.join_code
+    assert_equal "join", email_code.intent
+  end
+
+  test "issue invalidates the codes issued before it" do
+    first = EmailCode.issue(@identity, intent: :sign_in)
+    second = EmailCode.issue(@identity, intent: :sign_in)
+
+    assert_not EmailCode.exists?(first.id)
+    assert EmailCode.exists?(second.id)
+    assert_equal [ second.code ], @identity.email_codes.pluck(:code)
+  end
+
+  test "verify? is case insensitive and ignores surrounding whitespace" do
+    email_code = EmailCode.create!(
+      identity: @identity,
+      intent: "sign_in",
+      code: "ABC234",
+      expires_at: EmailCode::EXPIRY_DURATION.from_now
+    )
+
+    assert email_code.verify?("abc234")
+    assert email_code.verify?(" ABC234 ")
+    assert_not email_code.verify?("ABC235")
+  end
+
+  test "a code works for fifteen minutes" do
+    issued_at = Time.current
+
+    travel_to issued_at do
+      @email_code = EmailCode.issue(@identity, intent: :sign_in)
+    end
+
+    assert_in_delta issued_at + EmailCode::EXPIRY_DURATION, @email_code.expires_at, 1.second
+
+    travel_to issued_at + EmailCode::EXPIRY_DURATION - 1.second do
+      assert @email_code.verify?(@email_code.code)
+    end
+
+    travel_to issued_at + EmailCode::EXPIRY_DURATION + 1.second do
+      assert_not @email_code.active?
+      assert_not @email_code.verify?(@email_code.code)
+    end
+  end
+
+  test "consume destroys the code" do
+    email_code = EmailCode.create!(
+      identity: @identity,
+      intent: "sign_in",
+      code: "ABC234",
+      expires_at: EmailCode::EXPIRY_DURATION.from_now
+    )
+
+    email_code.consume
+
+    assert_not EmailCode.exists?(email_code.id)
+  end
+
+  test "cleanup deletes expired codes" do
+    expired = EmailCode.create!(
+      identity: @identity,
+      intent: "sign_in",
+      code: "ABC234",
+      expires_at: 1.minute.ago
+    )
+    active = EmailCode.create!(
+      identity: identities(:jz),
+      intent: "sign_in",
+      code: "DEF567",
+      expires_at: EmailCode::EXPIRY_DURATION.from_now
+    )
+
+    EmailCode.cleanup
+
+    assert_not EmailCode.exists?(expired.id)
+    assert EmailCode.exists?(active.id)
+  end
+end
