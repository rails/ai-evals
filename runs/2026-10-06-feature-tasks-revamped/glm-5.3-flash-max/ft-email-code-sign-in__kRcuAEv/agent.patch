+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "verification code" do
+    email_code = EmailCode.create!(
+      identity: identities(:kevin),
+      intent: "sign_in",
+      code: "ABC234",
+      expires_at: EmailCode::EXPIRY_DURATION.from_now
+    )
+
+    email = IdentityMailer.verification_code(email_code)
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Fizzy verification code: ABC234", email.subject
+    assert_match "ABC234", email.body.encoded
+    assert_match "15 minutes", email.body.encoded
+  end
+end
