+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:mike)
+  end
+
+  test "new without a pending code redirects to sign in" do
+    untenanted do
+      get new_email_code_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "new with a pending code" do
+    start_sign_in_flow
+
+    untenanted do
+      get new_email_code_path
+
+      assert_response :success
+      assert_in_body "mike@37signals.com"
+    end
+  end
+
+  test "create signs in with the code from the email" do
+    start_sign_in_flow
+
+    assert_difference -> { Session.count }, 1 do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: pending_code }
+
+        assert_redirected_to landing_url
+      end
+    end
+  end
+
+  test "create signs in an identity without any accounts" do
+    start_sign_in_flow
+    @identity.users.destroy_all
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: pending_code }
+
+      assert_redirected_to session_menu_path
+    end
+  end
+
+  test "create with a wrong code" do
+    start_sign_in_flow
+
+    assert_no_difference -> { Session.count } do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: "XXXXXX" }
+
+        assert_redirected_to new_email_code_path(script_name: nil)
+        assert_equal "That code didn\u2019t work. Check it and try again.", flash[:alert]
+      end
+    end
+  end
+
+  test "create with an expired code" do
+    start_sign_in_flow
+
+    travel 16.minutes do
+      assert_no_difference -> { Session.count } do
+        untenanted do
+          post email_code_path(script_name: nil), params: { code: pending_code }
+
+          assert_redirected_to new_email_code_path(script_name: nil)
+        end
+      end
+    end
+  end
+
+  test "create consumes the code" do
+    start_sign_in_flow
+    code = pending_code
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: code }
+
+      assert_redirected_to landing_url
+    end
+
+    assert_empty @identity.email_codes
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: code }
+
+      assert_redirected_to new_email_code_path(script_name: nil)
+    end
+  end
+
+  test "create signs up" do
+    email_address = "newbie@example.com"
+
+    assert_emails 1 do
+      untenanted do
+        post signup_path, params: { signup: { email_address: email_address } }
+
+        assert_redirected_to new_email_code_path(script_name: nil)
+      end
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: identity.email_codes.last.code }
+
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "create joins" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_not @identity.users.exists?(account: account)
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: @identity.email_address }
+
+      assert_redirected_to new_email_code_path(script_name: nil)
+    end
+
+    assert_difference -> { User.count }, 1 do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: pending_code }
+
+        assert_redirected_to new_users_verification_url(script_name: account.slug)
+      end
+    end
+  end
+
+  test "create is rate limited" do
+    start_sign_in_flow
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: pending_code }
+
+      assert_redirected_to new_email_code_path(script_name: nil)
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def start_sign_in_flow
+      assert_emails 1 do
+        untenanted do
+          post session_path, params: { email_address: @identity.email_address }
+
+          assert_redirected_to new_email_code_path(script_name: nil)
+        end
+      end
+    end
+
+    def pending_code
+      @identity.email_codes.last.code
+    end
+
+  test "create as JSON" do
+    start_sign_in_flow
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: pending_code }, as: :json
+
+      assert_response :no_content
+    end
+  end
+
+  test "create with a wrong code as JSON" do
+    start_sign_in_flow
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: "XXXXXX" }, as: :json
+
+      assert_response :unprocessable_entity
+    end
+  end
+end
