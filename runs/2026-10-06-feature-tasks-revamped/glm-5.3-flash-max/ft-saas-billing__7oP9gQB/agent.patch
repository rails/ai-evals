+  end
+
+  test "an unknown plan is not found" do
+    post saas.account_checkout_path(plan: "Enterprise")
+
+    assert_response :not_found
+  end
+
+  test "the free plan is not for sale" do
+    post saas.account_checkout_path(plan: "FreeV1")
+
+    assert_response :not_found
+  end
+
+  test "an admin manages the subscription in the customer portal" do
+    accounts(:"37s").find_or_create_subscription.update!(stripe_customer_id: "cus_37s")
