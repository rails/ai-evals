+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test"
+    assert_equal "cus_new", accounts(:"37s").reload.subscription.stripe_customer_id
+  end
+
+  test "a non-admin cannot start a checkout" do
+    logout_and_sign_in_as :jz
+
+    post saas.account_checkout_path(plan: "MonthlyV1")
