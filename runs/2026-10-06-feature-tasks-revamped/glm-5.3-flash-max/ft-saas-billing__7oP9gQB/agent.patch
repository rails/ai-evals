+<header>
+  <h2 class="divider txt-medium margin-block-start">Plan</h2>
+</header>
+
+<div class="flex flex-column gap margin-block-half">
+  <div class="flex align-center gap">
+    <strong class="txt-large"><%= Current.account.plan.proper_name %></strong>
+    <% if Current.account.comped? %>
+      <span class="txt-subtle">Complimentary</span>
+    <% elsif Current.account.paid? %>
+      <span class="txt-subtle">$<%= Current.account.plan.price %>/month</span>
+    <% end %>
+  </div>
+
+  <div class="txt-small txt-subtle">
+    <% if Current.account.card_limit %>
+      <%= number_with_delimiter(Current.account.cards_count) %> of <%= number_with_delimiter(Current.account.card_limit) %> cards and
+    <% else %>
+      <%= number_with_delimiter(Current.account.cards_count) %> cards and
+    <% end %>
+    <%= number_to_human_size(Current.account.bytes_used) %> of <%= number_to_human_size(Current.account.storage_limit) %> of storage used
+  </div>
+
+  <% if Current.user.admin? %>
+    <% if Current.account.paid? %>
+      <%= button_to "Manage subscription", saas.account_portal_path, class: "btn", form: { class: "margin-block-start-half" } %>
