+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <div class="flex flex-column gap margin-block-half">
+      <div>
+        <span class="txt-x-small txt-ink-medium">Plan</span>
+        <div>
+          <strong><%= @account.plan.proper_name %></strong>
+          <% if @account.comped? %>
+            <span class="txt-x-small txt-ink-medium">(complimentary)</span>
+          <% end %>
+          <span class="txt-x-small txt-ink-medium">#<%= @account.external_account_id %></span>
+        </div>
+      </div>
+
+      <div>
+        <span class="txt-x-small txt-ink-medium">Cards</span>
+        <div>
+          <% if @account.card_limit %>
+            <strong><%= number_with_delimiter(@account.cards_count) %></strong> of <%= number_with_delimiter(@account.card_limit) %>
+          <% else %>
+            <strong><%= number_with_delimiter(@account.cards_count) %></strong> (no limit)
+          <% end %>
+        </div>
+      </div>
+
+      <div>
+        <span class="txt-x-small txt-ink-medium">Storage</span>
+        <div>
+          <strong><%= number_to_human_size(@account.bytes_used) %></strong> of <%= number_to_human_size(@account.storage_limit) %>
+        </div>
+      </div>
+
+      <div class="flex gap margin-block-start-half">
+        <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Overrides</h2>
+    </header>
+
+    <div class="flex flex-column gap margin-block-half">
+      <% if @account.overridden_limit %>
+        <div class="txt-small">
+          Overriding this account:
+          <% if @account.overridden_limit.card_count %>
+            <%= number_with_delimiter(@account.overridden_limit.card_count) %> cards
+          <% end %>
+          <% if @account.overridden_limit.bytes_used %>
+            <%= number_to_human_size(@account.overridden_limit.bytes_used) %> of storage
+          <% end %>
+        </div>
+      <% end %>
+
+      <%= form_with model: @account.overridden_limit || @account.build_overridden_limit,
+            url: saas.admin_account_override_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, min: 1, placeholder: @account.plan.card_limit %>
+        </div>
+
+        <div class="flex flex-column">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, min: 1, placeholder: @account.plan.storage_limit %>
+        </div>
+
+        <%= form.submit "Override", class: "btn" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+</section>
