+        <% Subscription.plans.select(&:paid?).each do |plan| %>
+          <div class="flex align-center gap">
+            <div class="flex-item-grow">
+              <strong><%= plan.proper_name %></strong>
+              <div class="txt-small txt-subtle"><%= plan.description %> &mdash; $<%= plan.price %>/month</div>
+            </div>
+            <%= button_to "Upgrade", saas.account_checkout_path(plan: plan.short_name), class: "btn" %>
+          </div>
+        <% end %>
+      </div>
+    <% end %>
+  <% end %>
+</div>
