diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..65ab44b
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @card = cards(:radio)
+    @user = users(:mike)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    cancel_backdated_by 31.days
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Board.exists?(@board.id)
+    assert_not Card.exists?(@card.id)
+    assert_not User.exists?(@user.id)
+
+    assert Account.exists?(accounts(:"37s").id)
+    assert Board.exists?(boards(:writebook).id)
+    assert Card.exists?(cards(:logo).id)
+  end
+
+  test "leaves accounts cancelled within the grace period alone" do
+    cancel_backdated_by 29.days
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+  end
+
+  test "leaves accounts that are not cancelled alone" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+
+  private
+    def cancel_backdated_by(period)
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update!(created_at: period.ago)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..20392d9
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @card = cards(:radio)
+    @user = users(:mike)
+  end
+
+  test "incinerate removes the account and everything that belongs to it" do
+    @account.cancel(initiated_by: @user)
+    incinerate_after_grace_period
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Board.exists?(@board.id)
+    assert_not Card.exists?(@card.id)
+    assert_not User.exists?(@user.id)
+  end
+
+  test "incinerate drops the storage ledger" do
+    Storage::Entry.record account: @account, delta: 1024, operation: "attach"
+    @account.cancel(initiated_by: @user)
+    incinerate_after_grace_period
+
+    @account.incinerate
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "incinerate keeps the storage ledger of other accounts" do
+    Storage::Entry.record account: accounts(:"37s"), delta: 1024, operation: "attach"
+    @account.cancel(initiated_by: @user)
+    incinerate_after_grace_period
+
+    @account.incinerate
+
+    assert Storage::Entry.where(account_id: accounts(:"37s").id).exists?
+  end
+
+  test "incinerate removes accounts with attachments" do
+    Current.with_account(@account) do
+      @card.image.attach io: StringIO.new("x" * 1024), filename: "test.png", content_type: "image/png"
+    end
+
+    @account.cancel(initiated_by: @user)
+    incinerate_after_grace_period
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Card.exists?(@card.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "incinerate does nothing before the incineration grace period has passed" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing when the account is not cancelled" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incineratable? is true once the incineration grace period has passed" do
+    assert_not @account.incineratable?
+
+    @account.cancel(initiated_by: @user)
+    assert_not @account.incineratable?
+
+    incinerate_after_grace_period
+    assert @account.incineratable?
+  end
+
+  test "incinerate_due collects cancelled accounts past the incineration grace period" do
+    assert_empty Account.incinerate_due
+
+    @account.cancel(initiated_by: @user)
+    assert_empty Account.incinerate_due
+
+    incinerate_after_grace_period
+    assert_includes Account.incinerate_due, @account
+    assert_not_includes Account.incinerate_due, accounts(:"37s")
+  end
+
+  private
+    def incinerate_after_grace_period
+      @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    end
+end
