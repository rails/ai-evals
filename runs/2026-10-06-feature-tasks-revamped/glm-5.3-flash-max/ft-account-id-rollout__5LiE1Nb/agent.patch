diff --git a/config/initializers/tenant_scoped_framework_records.rb b/config/initializers/tenant_scoped_framework_records.rb
new file mode 100644
index 0000000..555db21
--- /dev/null
+++ b/config/initializers/tenant_scoped_framework_records.rb
@@ -0,0 +1,70 @@
+# ActionText and ActiveStorage records hold an account's data like any other
+# record, so they carry an +account_id+ too.
+#
+# The account is inherited from the row the record belongs to: a rich text gets
+# it from its record, a blob from the account it was uploaded in, an attachment
+# and its variants from their blob.
+#
+# The association is optional because not every attachment is tenanted: identity
+# avatars and other global files belong to no account.
+module TenantScopedFrameworkRecords
+  module ActiveStorageBlob
+    extend ActiveSupport::Concern
+
+    included do
+      belongs_to :account, optional: true, default: -> { Current.account }
+    end
+  end
+
+  module ActiveStorageAttachment
+    extend ActiveSupport::Concern
+
+    included do
+      belongs_to :account, optional: true, default: -> { record.try(:account) || blob&.account }
+
+      before_validation :assign_account_to_untenanted_blob, on: :create
+    end
+
+    private
+      # A blob uploaded outside of an account context (a job, a script) still
+      # belongs to the account of whatever it ends up attached to.
+      def assign_account_to_untenanted_blob
+        return unless blob && blob.account_id.blank?
+
+        account = record.try(:account)
+        blob.update!(account: account) if account
+      end
+  end
+
+  module ActiveStorageVariantRecord
+    extend ActiveSupport::Concern
+
+    included do
+      belongs_to :account, optional: true, default: -> { blob&.account }
+    end
+  end
+
+  module ActionTextRichText
+    extend ActiveSupport::Concern
+
+    included do
+      belongs_to :account, optional: true, default: -> { record.try(:account) }
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  include TenantScopedFrameworkRecords::ActiveStorageBlob
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include TenantScopedFrameworkRecords::ActiveStorageAttachment
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  include TenantScopedFrameworkRecords::ActiveStorageVariantRecord
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  include TenantScopedFrameworkRecords::ActionTextRichText
+end
diff --git a/db/migrate/20260710120000_add_account_id_to_every_table.rb b/db/migrate/20260710120000_add_account_id_to_every_table.rb
new file mode 100644
index 0000000..c844b23
--- /dev/null
+++ b/db/migrate/20260710120000_add_account_id_to_every_table.rb
@@ -0,0 +1,238 @@
+# Every table that holds an account's data carries an +account_id+.
+#
+# The multi-tenant rollout started with the core tables and left the rest for
+# later. This finishes it: the column is added where missing, every existing row
+# is backfilled from the row it belongs to, and rows that can no longer be
+# attributed to an account (orphans left behind by cascades that predate
+# tenancy) are dropped.
+class AddAccountIdToEveryTable < ActiveRecord::Migration[8.2]
+  # table => [foreign key, parent table] for rows that inherit the account from
+  # a single parent.
+  SCOPED_BY_PARENT = {
+    "accesses" => [ "board_id", "boards" ],
+    "assignments" => [ "card_id", "cards" ],
+    "board_publications" => [ "board_id", "boards" ],
+    "card_activity_spikes" => [ "card_id", "cards" ],
+    "card_goldnesses" => [ "card_id", "cards" ],
+    "card_not_nows" => [ "card_id", "cards" ],
+    "closures" => [ "card_id", "cards" ],
+    "columns" => [ "board_id", "boards" ],
+    "comments" => [ "card_id", "cards" ],
+    "events" => [ "board_id", "boards" ],
+    "filters" => [ "creator_id", "users" ],
+    "notification_bundles" => [ "user_id", "users" ],
+    "notifications" => [ "user_id", "users" ],
+    "pins" => [ "card_id", "cards" ],
+    "push_subscriptions" => [ "user_id", "users" ],
+    "search_queries" => [ "user_id", "users" ],
+    "steps" => [ "card_id", "cards" ],
+    "taggings" => [ "card_id", "cards" ],
+    "user_settings" => [ "user_id", "users" ],
+    "watches" => [ "card_id", "cards" ],
+    "webhook_delinquency_trackers" => [ "webhook_id", "webhooks" ],
+    "webhook_deliveries" => [ "webhook_id", "webhooks" ],
+    "webhooks" => [ "board_id", "boards" ]
+  }.freeze
+
+  # table => { association => { type => [foreign key, parent table] } } for rows
+  # that inherit the account from a polymorphic parent.
+  SCOPED_BY_POLYMORPHIC = {
+    "action_text_rich_texts" => {
+      "record" => {
+        "Card" => [ "record_id", "cards" ],
+        "Comment" => [ "record_id", "comments" ],
+        "Board" => [ "record_id", "boards" ]
+      }
+    },
+    "entropies" => {
+      "container" => {
+        "Board" => [ "container_id", "boards" ]
+      }
+    },
+    "mentions" => {
+      "source" => {
+        "Card" => [ "source_id", "cards" ],
+        "Comment" => [ "source_id", "comments" ]
+      }
+    },
+    "reactions" => {
+      "reactable" => {
+        "Card" => [ "reactable_id", "cards" ],
+        "Comment" => [ "reactable_id", "comments" ]
+      }
+    }
+  }.freeze
+
+  # Tables that already carried the column and only need their strays cleaned up.
+  ALREADY_SCOPED = %w[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    tags
+    users
+  ].freeze
+
+  SCOPED_TABLES = (ALREADY_SCOPED + SCOPED_BY_PARENT.keys + SCOPED_BY_POLYMORPHIC.keys).freeze
+
+  # Tables that had the column before this migration, so a rollback keeps it.
+  PREVIOUSLY_SCOPED = %w[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ].freeze
+
+  # Storage tables, scoped through the attachment's record rather than a column
+  # of their own parent.
+  STORAGE_TABLES = %w[
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+  ].freeze
+
+  def up
+    # Parents are backfilled before the rows that point at them.
+    ALREADY_SCOPED.each { ensure_account_id(it) }
+    SCOPED_BY_PARENT.each { |table, (foreign_key, parent)| backfill_from_parent(table, foreign_key, parent) }
+    SCOPED_BY_POLYMORPHIC.each { |table, scopes| backfill_from_polymorphic_parent(table, scopes) }
+
+    backfill_storage
+
+    # Rows that cannot be attributed to an account are orphans: drop them,
+    # children first so dropping a parent doesn't strand its rows.
+    SCOPED_TABLES.reverse_each { drop_orphans(it) }
+    drop_unattached_storage
+
+    # Tags are per account, so the same title may exist in two of them.
+    scope_tags_by_account
+
+    index_account_id
+  end
+
+  def down
+    (SCOPED_BY_PARENT.keys + SCOPED_BY_POLYMORPHIC.keys).each do |table|
+      next if PREVIOUSLY_SCOPED.include?(table)
+
+      if index_exists?(table, :account_id)
+        remove_index table, :account_id
+      end
+      remove_column table, :account_id
+    end
+
+    if index_exists?(:tags, [ :account_id, :title ], name: "index_tags_on_account_id_and_title")
+      remove_index :tags, name: "index_tags_on_account_id_and_title"
+    end
+    add_index :tags, :title, unique: true unless index_exists?(:tags, :title)
+  end
+
+  private
+    def ensure_account_id(table)
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    def backfill_from_parent(table, foreign_key, parent)
+      ensure_account_id(table)
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (SELECT #{parent}.account_id FROM #{parent} WHERE #{parent}.id = #{table}.#{foreign_key})
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_from_polymorphic_parent(table, scopes)
+      ensure_account_id(table)
+
+      scopes.each do |name, types|
+        type_column = "#{name}_type"
+        id_column = "#{name}_id"
+
+        assignments = types.map do |type, (foreign_key, parent)|
+          "WHEN #{quote(type)} THEN (SELECT #{parent}.account_id FROM #{parent} WHERE #{parent}.id = #{table}.#{id_column})"
+        end.join(" ")
+
+        execute <<~SQL
+          UPDATE #{table}
+          SET account_id = CASE #{type_column} #{assignments} END
+          WHERE account_id IS NULL
+        SQL
+      end
+    end
+
+    # The record knows the account, the blob inherits it from its attachments,
+    # and the attachment and its variants inherit it back from the blob.
+    def backfill_storage
+      STORAGE_TABLES.each { ensure_account_id(it) }
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = COALESCE(
+          (SELECT cards.account_id FROM cards WHERE cards.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'Card' LIMIT 1)),
+          (SELECT comments.account_id FROM comments WHERE comments.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'Comment' LIMIT 1)),
+          (SELECT boards.account_id FROM boards WHERE boards.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'Board' LIMIT 1)),
+          (SELECT users.account_id FROM users WHERE users.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'User' LIMIT 1)),
+          (SELECT exports.account_id FROM exports WHERE exports.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'Export' LIMIT 1)),
+          (SELECT account_imports.account_id FROM account_imports WHERE account_imports.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'Account::Import' LIMIT 1)),
+          (SELECT rich_texts.account_id FROM action_text_rich_texts AS rich_texts WHERE rich_texts.id = (SELECT attachments.record_id FROM active_storage_attachments AS attachments WHERE attachments.blob_id = active_storage_blobs.id AND attachments.record_type = 'ActionText::RichText' LIMIT 1))
+        )
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_attachments
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_attachments.blob_id)
+        WHERE account_id IS NULL
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    # Blobs may be global (identity avatars) and keep a NULL account: only rows
+    # whose parent is gone are orphans.
+    def drop_unattached_storage
+      execute "DELETE FROM active_storage_attachments WHERE NOT EXISTS (SELECT 1 FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_attachments.blob_id)"
+      execute "DELETE FROM active_storage_variant_records WHERE NOT EXISTS (SELECT 1 FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)"
+      execute "DELETE FROM active_storage_blobs WHERE NOT EXISTS (SELECT 1 FROM active_storage_attachments WHERE active_storage_attachments.blob_id = active_storage_blobs.id)"
+    end
+
+    def drop_orphans(table)
+      execute "DELETE FROM #{table} WHERE account_id IS NULL"
+    end
+
+    def scope_tags_by_account
+      if index_exists?(:tags, :title, name: "index_tags_on_title")
+        remove_index :tags, name: "index_tags_on_title"
+      end
+
+      unless index_exists?(:tags, [ :account_id, :title ], name: "index_tags_on_account_id_and_title")
+        add_index :tags, [ :account_id, :title ], unique: true, name: "index_tags_on_account_id_and_title"
+      end
+    end
+
+    def index_account_id
+      STORAGE_TABLES.each { index_account(it) }
+
+      # Tags gets a composite index instead of a plain one.
+      (SCOPED_TABLES - %w[tags]).each { index_account(it) }
+    end
+
+    def index_account(table)
+      indexed = connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+      add_index table, :account_id unless indexed
+    end
+end
