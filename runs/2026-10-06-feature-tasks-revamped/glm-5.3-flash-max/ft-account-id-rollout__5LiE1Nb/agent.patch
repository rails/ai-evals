diff --git a/script/maintenance/verify_account_scoping.rb b/script/maintenance/verify_account_scoping.rb
new file mode 100755
index 0000000..f1bd05a
--- /dev/null
+++ b/script/maintenance/verify_account_scoping.rb
@@ -0,0 +1,154 @@
+#!/usr/bin/env ruby
+
+# Audits that the multi-tenant rollout is finished: every table that holds an
+# account's data carries an indexed account_id, no row is missing its account,
+# and every account-scoped model belongs to an account.
+#
+#   script/maintenance/verify_account_scoping.rb
+
+require_relative "../../config/environment"
+
+TABLES = {
+  "accesses" => :board,
+  "account_imports" => nil,
+  "account_join_codes" => nil,
+  "action_text_rich_texts" => nil,
+  "active_storage_attachments" => nil,
+  "active_storage_blobs" => nil,
+  "active_storage_variant_records" => nil,
+  "assignments" => :card,
+  "board_publications" => :board,
+  "boards" => nil,
+  "card_activity_spikes" => :card,
+  "card_goldnesses" => :card,
+  "card_not_nows" => :card,
+  "cards" => nil,
+  "closures" => :card,
+  "columns" => :board,
+  "comments" => :card,
+  "entropies" => nil,
+  "events" => :board,
+  "exports" => nil,
+  "filters" => :creator,
+  "mentions" => :source,
+  "notification_bundles" => :user,
+  "notifications" => :user,
+  "pins" => :card,
+  "push_subscriptions" => :user,
+  "reactions" => :reactable,
+  "search_queries" => :user,
+  "steps" => :card,
+  "storage_entries" => nil,
+  "taggings" => :card,
+  "tags" => nil,
+  "user_settings" => :user,
+  "users" => nil,
+  "watches" => :card,
+  "webhook_delinquency_trackers" => :webhook,
+  "webhook_deliveries" => :webhook,
+  "webhooks" => :board
+}.freeze
+
+MODELS = {
+  "Access" => nil,
+  "Account::Import" => nil,
+  "Account::JoinCode" => nil,
+  "ActionText::RichText" => nil,
+  "ActiveStorage::Attachment" => nil,
+  "ActiveStorage::Blob" => nil,
+  "ActiveStorage::VariantRecord" => nil,
+  "Assignment" => nil,
+  "Board" => nil,
+  "Board::Publication" => nil,
+  "Card" => nil,
+  "Card::ActivitySpike" => nil,
+  "Card::Goldness" => nil,
+  "Card::NotNow" => nil,
+  "Closure" => nil,
+  "Column" => nil,
+  "Comment" => nil,
+  "Entropy" => nil,
+  "Event" => nil,
+  "Account::Export" => nil,
+  "Filter" => nil,
+  "Mention" => nil,
+  "Notification" => nil,
+  "Notification::Bundle" => nil,
+  "Pin" => nil,
+  "Push::Subscription" => nil,
+  "Reaction" => nil,
+  "Search::Query" => nil,
+  "Step" => nil,
+  "Storage::Entry" => nil,
+  "Tagging" => nil,
+  "Tag" => nil,
+  "User" => nil,
+  "User::Settings" => nil,
+  "Watch" => nil,
+  "Webhook" => nil,
+  "Webhook::DelinquencyTracker" => nil,
+  "Webhook::Delivery" => nil
+}.freeze
+
+# Framework records may be global (identity avatars), so their account is optional.
+OPTIONAL_ACCOUNT_MODELS = %w[
+  ActionText::RichText ActiveStorage::Attachment ActiveStorage::Blob
+  ActiveStorage::VariantRecord Search::Query
+].freeze
+
+GLOBAL_TABLES = %w[
+  account_external_id_sequences accounts action_pack_passkeys assignees_filters
+  assigners_filters boards_filters closers_filters creators_filters filters_tags
+  identities identity_access_tokens magic_links sessions storage_totals
+].freeze
+
+failures = []
+
+TABLES.each do |table, _parent|
+  columns = ActiveRecord::Base.connection.columns(table)
+  unless columns.any? { |column| column.name == "account_id" }
+    failures << "#{table} has no account_id column"
+    next
+  end
+
+  indexed = ActiveRecord::Base.connection.indexes(table).any? do |index|
+    index.columns.first == "account_id"
+  end
+  failures << "#{table} has no index on account_id" unless indexed
+end
+
+MODELS.each_key do |name|
+  model = name.constantize
+  reflection = model.reflect_on_association(:account)
+
+  unless reflection
+    failures << "#{name} does not belong to an account"
+    next
+  end
+
+  if reflection.options[:optional] && !OPTIONAL_ACCOUNT_MODELS.include?(name)
+    failures << "#{name}'s account is optional"
+  end
+end
+
+# Rows that belong to an account but carry none are orphans, and orphans are dropped.
+TABLES.each_key do |table|
+  orphans = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE account_id IS NULL")
+  failures << "#{table} (via #{TABLES[table] || "its own account_id"}) has #{orphans} rows without an account" if orphans.to_i.positive?
+end
+
+# Global tables must not have grown an account_id.
+GLOBAL_TABLES.each do |table|
+  next unless ActiveRecord::Base.connection.table_exists?(table)
+  if ActiveRecord::Base.connection.columns(table).any? { |column| column.name == "account_id" }
+    failures << "#{table} is global but has an account_id column"
+  end
+end
+
+if failures.any?
+  puts "FAILED:"
+  failures.each { puts "  - #{it}" }
+  exit 1
+else
+  puts "OK: #{TABLES.size} tables and #{MODELS.size} models are account scoped"
+end
