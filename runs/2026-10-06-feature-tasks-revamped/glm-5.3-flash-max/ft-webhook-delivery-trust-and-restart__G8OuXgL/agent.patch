+
+  test "deliver logs a response the receiver rejected" do
+    delivery = pending_delivery
+
+    stub_request(:post, delivery.webhook.url).to_return(status: 422)
+
+    delivery.deliver
+
+    delivery.reload
+    assert_equal "completed", delivery.state
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+    assert_equal 422, delivery.response[:code]
+  end
+
+  test "deliver logs an error when the receiver can't be reached" do
+    delivery = pending_delivery
+
+    stub_request(:post, delivery.webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver
+
+    delivery.reload
+    assert_equal "errored", delivery.state
+    assert delivery.failed?
+    assert delivery.response[:error].present?
+  end
+
+  test "deliver logs the request without the signature" do
+    delivery = pending_delivery
+
+    stub_request(:post, delivery.webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    delivery.reload
+    assert_includes delivery.request[:headers].keys, "X-Webhook-Signature"
+    assert_not_includes delivery.sanitized_request[:headers].keys, "X-Webhook-Signature"
+  end
+
+  test "deliver tells the delinquency tracker how it went" do
+    delivery = pending_delivery
+
+    stub_request(:post, delivery.webhook.url).to_return(status: 500)
+
+    assert_difference -> { delivery.webhook.delinquency_tracker.reload.consecutive_failures_count } do
+      delivery.deliver
+    end
+  end
+
+  test "deliver is posted exactly once" do
+    delivery = pending_delivery
+
+    stub = stub_request(:post, delivery.webhook.url).to_return(status: 500)
+
+    delivery.deliver
+    delivery.deliver
+
+    assert_requested stub, times: 1
+  end
+
+  test "an event is delivered to the receiver exactly once and the log shows how it went" do
+    webhook = webhooks(:active)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+    end
+
+    perform_enqueued_jobs
+
+    assert_requested stub, times: 1
+
+    delivery = webhook.deliveries.ordered.first
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response_summary[:code]
+  end
+
+  test "a receiver that keeps failing gets switched off" do
+    webhook = webhooks(:active)
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT.times do
+      event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+
+      perform_enqueued_jobs
+
+      travel 6.minutes
+    end
+
+    assert_not webhook.reload.active?, "A receiver failing ten times in a row over an hour gets switched off"
+
+    deliveries = webhook.deliveries.ordered.limit(Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT)
+    assert deliveries.all?(&:failed?)
+  end
+
+  private
+    def pending_delivery
+      Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:layout_published))
+    end
+
+    def fresh_webhook
+      Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+    end
 end
