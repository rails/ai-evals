@@ -29,4 +42,60 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  # Posts the event to the receiver and records how it went. Deliveries are
+  # posted exactly once: there are no retries, so a receiver that is slow or
+  # broken is never bothered about the same event twice.
+  def deliver
+    if claim
+      post
+    end
+  end
+
+  private
+    # Takes ownership of the delivery, so that it is only ever posted once, even
+    # if two jobs were to pick up the same delivery at the same time.
+    def claim
+      claimed = self.class.where(id: id, state: :pending)
+        .update_all(state: :in_progress, updated_at: Time.current) == 1
+
+      if claimed
+        self.state = :in_progress
+      end
+
+      claimed
+    end
+
+    def post
+      payload = Webhook::Payload.new(webhook, event)
+      update! request: { headers: payload.headers }
+
+      response = http.post(url.request_uri, payload.body, payload.headers)
+      complete code: response.code.to_i, headers: response.each_header.to_h
+    rescue => failure
+      errored failure.message
+    end
+
+    def complete(response)
+      update! response: response, state: :completed
+      webhook.record_delivery(self)
+    end
+
+    def errored(message)
+      update! response: { error: message }, state: :errored
+      webhook.record_delivery(self)
+    end
+
+    def url
+      @url ||= URI.parse(webhook.url)
+    end
+
+    def http
+      Net::HTTP.new(url.host, url.port).tap do |http|
+        http.use_ssl = url.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = WRITE_TIMEOUT
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..8c504fb
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,67 @@
+# Builds the request we send to a webhook receiver: the body describing the
+# event, and the headers to verify it came from us.
+class Webhook::Payload
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  CONTENT_TYPE = "application/json"
+  SIGNATURE_ALGORITHM = "SHA256"
+  SIGNATURE_HEADER = "X-Webhook-Signature"
+  TIMESTAMP_HEADER = "X-Webhook-Timestamp"
+
+  # Chat receivers only care about a short message about the event, so they
+  # get one under the key their API expects.
+  CHAT_MESSAGE_KEYS = {
+    slack: "text",
+    campfire: "message",
+    basecamp: "content"
+  }.freeze
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => CONTENT_TYPE,
+      TIMESTAMP_HEADER => timestamp,
+      SIGNATURE_HEADER => signature
+    }
+  end
+
+  def body
+    @body ||= if chat_message_key
+      JSON.generate(chat_message_key => message)
+    else
+      render formats: :json
+    end
+  end
+
+  private
+    def chat_message_key
+      if @webhook.for_slack?
+        CHAT_MESSAGE_KEYS[:slack]
+      elsif @webhook.for_campfire?
+        CHAT_MESSAGE_KEYS[:campfire]
+      elsif @webhook.for_basecamp?
+        CHAT_MESSAGE_KEYS[:basecamp]
+      end
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest SIGNATURE_ALGORITHM, @webhook.signing_secret, body
+    end
+
+    def timestamp
+      @event.created_at.utc.iso8601
+    end
+
+    def message
+      render(formats: :html).strip
+    end
+
+    def render(formats:)
+      ApplicationController.renderer
+        .new(script_name: @webhook.account.slug)
+        .render(template: "webhooks/event", assigns: { event: @event }, layout: false, formats: formats)
+    end
+end
