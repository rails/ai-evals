diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..47d9003
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+    @tracker.restart
+    @event = events(:layout_published)
+  end
+
+  test "a successful delivery resets the consecutive failures" do
+    @tracker.record_failure
+
+    @tracker.record(delivery(response: { code: 200 }, state: :completed))
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "a failed delivery counts towards the consecutive failures" do
+    assert_difference -> { @tracker.reload.consecutive_failures_count } do
+      @tracker.record(delivery(response: { code: 500 }, state: :completed))
+    end
+
+    assert @tracker.first_failure_at.present?
+  end
+
+  test "an errored delivery counts towards the consecutive failures" do
+    assert_difference -> { @tracker.reload.consecutive_failures_count } do
+      @tracker.record(delivery(response: { error: "destination_unreachable" }, state: :errored))
+    end
+  end
+
+  test "the webhook is deactivated after ten consecutive failures" do
+    limit = Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT
+
+    (limit - 1).times { @tracker.record_failure }
+    assert @webhook.reload.active?, "The webhook stays active before the limit is reached"
+
+    @tracker.record_failure
+
+    assert_not @webhook.reload.active?
+    assert @tracker.reload.delinquent?
+    assert @tracker.first_failure_at.present?
+  end
+
+  test "failures within the failure window add up" do
+    @tracker.record_failure(30.minutes.ago)
+
+    travel 30.minutes do
+      @tracker.record_failure
+    end
+
+    assert_equal 2, @tracker.reload.consecutive_failures_count
+  end
+
+  test "failures outside of the failure window start counting all over again" do
+    @tracker.record_failure(2.hours.ago)
+
+    @tracker.record_failure(30.minutes.ago)
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?, "The webhook stays active while the receiver is getting back on its feet"
+  end
+
+  private
+    def delivery(attributes = {})
+      Webhook::Delivery.create!({ webhook: @webhook, event: @event }.merge(attributes))
+    end
+end
