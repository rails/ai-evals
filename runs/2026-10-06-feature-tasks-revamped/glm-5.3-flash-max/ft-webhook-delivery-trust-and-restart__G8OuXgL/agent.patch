diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..505055e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,45 @@
+# Keeps track of how a webhook receiver is behaving, so that we can switch
+# off the ones that stopped caring about what we send them.
+#
+# A receiver that keeps failing gets deactivated: ten failed deliveries in
+# a row, all of them within an hour, and the webhook is switched off.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  CONSECUTIVE_FAILURES_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      record_success
+    else
+      record_failure
+    end
+  end
+
+  def record_success
+    restart
+  end
+
+  def record_failure(failed_at = Time.current)
+    if first_failure_at.nil? || failed_at > first_failure_at + FAILURE_WINDOW
+      # The receiver has been failing for too long for this to be a hiccup,
+      # so we start counting its failures all over again.
+      restart failed_at
+    end
+
+    increment! :consecutive_failures_count
+
+    webhook.deactivate if delinquent?
+  end
+
+  def delinquent?
+    consecutive_failures_count >= CONSECUTIVE_FAILURES_LIMIT
+  end
+
+  # Forgets about the failures recorded so far, giving the receiver a fresh start.
+  def restart(failed_at = nil)
+    update! consecutive_failures_count: 0, first_failure_at: failed_at
+  end
+end
