+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<article class="panel panel--wide center txt-align-start">
+  <%= form_with model: @import, url: account_imports_path, data: { controller: "form" }, html: { class: "flex flex-column gap" } do |form| %>
+    <div class="flex flex-column gap-half">
+      <%= form.label :file do %>
+        <strong>Account file</strong><br>
+        <p class="margin-none txt-x-small txt-subtle">The .zip file you exported from Fizzy. Everything in it will be brought into a new account: its boards, its cards, its comments, its files and its people.</p>
