+      <%= form.file_field :file, required: true, accept: ".zip", class: "input" %>
+    </div>
+
+    <% if @import.errors.any? %>
+      <p class="txt-negative txt-small"><%= @import.errors.full_messages.to_sentence %></p>
+    <% end %>
+
+    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
+      <span>Import account</span>
+    <% end %>
+
+    <p class="txt-x-small txt-subtle margin-none">This can take a while for a big account. We'll email you when it's done.</p>
+  <% end %>
+</article>
