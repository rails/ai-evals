diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..5f8d9db
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,17 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :board
+
+  has_secure_token :key
+
+  validates :key, presence: true
+
+  after_save { mirror_key_to_board(key) }
+  after_destroy { mirror_key_to_board(nil) }
+
+  private
+    # The key is mirrored onto the board so that public, tenant-free URLs can
+    # resolve the board (and through it the account) with a single lookup.
+    def mirror_key_to_board(key)
+      board.update_columns publication_key: key, updated_at: Time.current unless board.destroyed?
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..cc2f038
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,61 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { where.not(publication_key: nil).or(where(id: Board::Publication.select(:board_id))) }
+
+    # The publication key is the +key+ param of the public URLs.
+    alias_attribute :key, :publication_key
+  end
+
+  class_methods do
+    # Public URLs carry no account scope, so the key alone has to resolve the board.
+    def find_published_by_key(key)
+      where(publication_key: key).or(where(id: Board::Publication.where(key: key).select(:board_id))).take
+    end
+  end
+
+  def publish
+    create_publication! unless publication
+  end
+
+  def unpublish
+    publication&.destroy
+    update_column :publication_key, nil if publication_key?
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_key
+    publication_key || publication&.key
+  end
+
+  def public_url
+    if published?
+      "#{base_url}#{Rails.application.routes.url_helpers.public_board_path(public_key)}"
+    end
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  private
+    def base_url
+      Current.base_url.presence || root_base_url
+    end
+
+    def root_base_url
+      Rails.application.routes.url_helpers.root_url(**base_url_options).chomp("/")
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
