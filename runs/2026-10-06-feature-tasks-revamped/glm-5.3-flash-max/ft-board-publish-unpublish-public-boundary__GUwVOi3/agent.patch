+class Public::BoardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account # The publication key identifies the account
+
+  before_action :set_board
+
+  layout "public"
+
+  def show
+  end
+
+  private
+    def set_board
+      @board = Board.find_published_by_key(publication_key)
+
+      if @board&.account&.active?
+        Current.account = @board.account
+      else
+        head :not_found
+      end
+    end
+
+    # Nested public routes carry the key as +board_key+.
+    def publication_key
+      params[:key] || params[:board_key]
+    end
+end
