diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..9ebaad5
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publishing generates a secret key" do
+    assert_changes -> { @board.reload.publication_key }, from: nil do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publication.key.present?
+  end
+
+  test "publishing is idempotent" do
+    @board.publish
+    key = @board.reload.public_key
+
+    @board.publish
+
+    assert_equal key, @board.reload.public_key
+    assert_equal 1, Board::Publication.count
+  end
+
+  test "unpublishing removes the secret key" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      @board.unpublish
+    end
+
+    assert_nil @board.reload.publication_key
+    assert_not Board::Publication.exists?(board: @board)
+  end
+
+  test "unpublishing without a publication" do
+    @board.update_column :publication_key, "stale-key"
+
+    @board.unpublish
+
+    assert_nil @board.reload.publication_key
+  end
+
+  test "finding a published board by key" do
+    @board.publish
+
+    assert_equal @board, Board.find_published_by_key(@board.reload.public_key)
+    assert_nil Board.find_published_by_key("unknown-key")
+  end
+
+  test "finding a published board without an account scope" do
+    @board.publish
+
+    Current.without_account do
+      assert_equal @board, Board.find_published_by_key(@board.reload.public_key)
+    end
+  end
+
+  test "public_url is nil by default" do
+    assert_nil @board.public_url
+  end
+
+  test "public_url points at the public board page" do
+    @board.publish
+
+    assert_includes @board.reload.public_url, "/public/boards/#{@board.public_key}"
+  end
+
+  test "published boards are publicly accessible" do
+    assert_not @board.publicly_accessible?
+
+    @board.publish
+
+    assert @board.reload.publicly_accessible?
+    assert @board.cards.published.sample.publicly_accessible?
+  end
+
+  test "attachments on published boards are publicly accessible" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    assert_not card.image.blob.publicly_accessible?
+
+    @board.publish
+
+    assert card.reload.image.blob.publicly_accessible?
+  end
+
+  test "drafted cards are not publicly accessible" do
+    @board.publish
+    card = @board.cards.create! creator: users(:david), status: :drafted, title: "Sneak peek"
+
+    assert_not card.publicly_accessible?
+  end
+end
