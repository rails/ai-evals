diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..d99d93f
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "reacting with content creates a reaction for the current user" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      comment.react_with("\u{1F389}")
+    end
+
+    assert_equal Current.user, comment.reactions.last.creator
+  end
+
+  test "reacting twice with the same content is idempotent" do
+    comment = comments(:logo_agreement_kevin)
+    comment.react_with("\u{1F389}")
+
+    assert_no_difference -> { comment.reactions.count } do
+      comment.react_with("\u{1F389}")
+    end
+  end
+
+  test "reacting with content someone else already used creates another reaction" do
+    comment = comments(:logo_agreement_kevin)
+    others_reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      comment.react_with(others_reaction.content)
+    end
+
+    assert_not_equal others_reaction.creator, comment.reactions.last.creator
+  end
+
+  test "invalid without content" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      reaction = comment.reactions.create(creator: users(:kevin), content: "")
+
+      assert reaction.errors.of_kind?(:content, :blank)
+    end
+  end
+
+  test "invalid with more than 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      reaction = comment.reactions.create(creator: users(:kevin), content: "a" * (Reaction::MAXIMUM_CONTENT_LENGTH + 1))
+
+      assert reaction.errors.of_kind?(:content, :too_long)
+    end
+  end
+
+  test "reacting to a comment invalidates the comment and its card" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    was_comment_updated_at = comment.updated_at
+    was_card_updated_at = card.updated_at
+
+    comment.react_with("\u{1F389}")
+
+    assert_not_equal was_comment_updated_at, comment.reload.updated_at
+    assert_not_equal was_card_updated_at, card.reload.updated_at
+  end
+
+  test "a reaction landing broadcasts a page refresh to the card" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    assert_enqueued_with job: Turbo::Streams::BroadcastStreamJob do
+      comment.react_with("\u{1F389}")
+    end
+
+    streams = enqueued_jobs.select { it[:job] == Turbo::Streams::BroadcastStreamJob }.map { it[:args].first }
+    assert_includes streams, card.to_gid_param
+  end
+
+  test "destroying a reaction invalidates the comment and its card" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    card = reaction.comment.card
+    was_card_updated_at = card.updated_at
+
+    reaction.destroy
+
+    assert_not_equal was_card_updated_at, card.reload.updated_at
+  end
+
+  test "partial path" do
+    assert_equal "cards/reactions/reaction", reactions(:logo_agreement_kevin_thumbs_up).to_partial_path
+  end
+end
