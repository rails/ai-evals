@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+import { delay } from "helpers/timing_helpers"
+
+const DELETING_ANIMATION_DURATION = 200
+
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+
+  expand() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+
+  choose(event) {
+    this.inputTarget.value = event.currentTarget.dataset.content
+    this.#closeEmojiMenu()
+    this.formTarget.requestSubmit()
+  }
+
+  async remove(event) {
+    event.preventDefault()
+
+    const button = event.currentTarget
+    button.closest(".reaction")?.classList.add("reaction--deleting")
+
+    await delay(DELETING_ANIMATION_DURATION)
+
+    // The strip may have been replaced while the reaction was fading out.
+    if (button.isConnected) button.form?.requestSubmit()
+  }
+
+  #closeEmojiMenu() {
+    this.element.querySelector("dialog[open]")?.close()
+  }
+}
