+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reacting to a comment with text" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within reactions_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nice work")
+      find(".reaction__submit-btn").click
+    end
+
+    within reactions_strip do
+      assert_selector ".reaction", text: "Nice work"
+      assert_selector ".reactions__trigger" # The button is back for the next reaction
+      assert_no_selector ".reaction__form"
+    end
+  end
+
+  test "reacting to a comment with an emoji" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within reactions_strip do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[title=\"Thumbs up\"]").click
+    end
+
+    within reactions_strip do
+      assert_selector ".reaction", text: "\u{1F44D}"
+      assert_no_selector ".reaction__form"
+    end
+  end
+
+  test "canceling a reaction keeps the comment untouched" do
+    visit card_url(@card)
+
+    within reactions_strip do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Never mind")
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_no_text "Never mind"
+  end
+
+  test "removing your own reaction" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "\u{1F44D}")
+
+    visit card_url(@card)
+
+    find("##{dom_id(reaction)}").click
+
+    assert_selector "##{dom_id(reaction)} .reaction__delete"
+    find("##{dom_id(reaction)} .reaction__delete").click
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  test "a reaction landing elsewhere shows up without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    Current.user = users(:david)
+    @comment.react_with("\u{1F389}")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "##{dom_id(@comment)} .reaction", text: "\u{1F389}", wait: 5
+  end
+
+  test "a reaction removed elsewhere disappears without reloading" do
+    reaction = @comment.reactions.create!(creator: users(:david), content: "\u{1F389}")
+
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    Current.user = users(:david)
+    reaction.destroy
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  private
+    def reactions_strip
+      "##{dom_id(@comment, :reactions)}"
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
