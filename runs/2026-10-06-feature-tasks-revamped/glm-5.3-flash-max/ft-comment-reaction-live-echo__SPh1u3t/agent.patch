@@ -0,0 +1,46 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment, only: %i[ create destroy ]
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, :ensure_creatorship, only: :destroy
+
+  def create
+    @comment.react_with reaction_params[:content]
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
