+<button type="button" class="reactions__trigger btn" title="Add a reaction"
+      data-reactions-target="trigger" data-action="reactions#expand">
+  <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  <span class="for-screen-reader">Add a reaction</span>
+</button>
+
+<%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction__form", html: { hidden: true },
+      data: { reactions_target: "form" } do |form| %>
+  <label class="reaction__form-label">
+    <span class="for-screen-reader">Add a reaction to this comment</span>
+    <%= form.text_field :content, class: "reaction__input", maxlength: Reaction::MAXIMUM_CONTENT_LENGTH,
+          required: true, placeholder: "React…", aria: { label: "Add a reaction" },
+          data: { reactions_target: "input", action: "keydown.esc->reactions#collapse:stop" } %>
+  </label>
+
+  <div class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn" title="Pick an emoji" data-action="dialog#toggle:stop">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <dialog class="popup reaction__popup panel fill-white shadow" data-dialog-target="dialog"
+          data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+      <div class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+          <button type="button" class="btn" title="<%= name %>" data-content="<%= emoji %>"
+                data-action="reactions#choose:stop">
+            <span aria-hidden="true"><%= emoji %></span>
+            <span class="for-screen-reader"><%= name %></span>
+          </button>
+        <% end %>
+      </div>
+    </dialog>
+  </div>
+
+  <%= form.button class: "reaction__submit-btn btn", title: "Add reaction" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Add reaction</span>
+  <% end %>
+
+  <button type="button" class="reaction__cancel-btn btn" title="Cancel" data-action="reactions#collapse">
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  </button>
+<% end %>
