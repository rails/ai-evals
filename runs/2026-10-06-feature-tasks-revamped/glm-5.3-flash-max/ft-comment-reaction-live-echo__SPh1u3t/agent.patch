@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "\u{1F389}" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+    assert_includes @response.body, comment.reactions.last.content
+  end
+
+  test "create twice with the same content" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    content = "\u{1F389}"
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: content } }, as: :turbo_stream
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: content } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Nice" } }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "create on a card you can't access is not found" do
+    card = cards(:radio)
+    Current.user = users(:kevin)
+    comment = card.comments.create!(body: "Hidden")
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "Nice" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_jz_nice)
+    comment = reaction.comment
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_nice)
+    comment = reaction.comment
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroying someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    comment = reaction.comment
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
