+  test "deliver records a failed response" do
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    delivery.deliver
+
+    delivery.reload
+    assert delivery.failed?
+    assert_not delivery.succeeded?
+    assert_equal 500, delivery.response[:code]
+  end
+
+  test "deliver records an unreachable receiver" do
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver
+
+    delivery.reload
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver skips webhooks that are switched off" do
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    @webhook.deactivate
+
+    delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert delivery.reload.pending?
+  end
+
+  test "deliver records a receiver without a host as unreachable" do
+    @webhook.update! url: "http://"
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+
+    delivery.deliver
+
+    delivery.reload
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver is only ever posted once" do
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    delivery.deliver
+    delivery.deliver
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "a receiver that keeps failing gets switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT.times do
+      @webhook.deliveries.create!(event: events(:logo_published)).deliver
+    end
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "a receiver that keeps working stays on" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT.times do
+      @webhook.deliveries.create!(event: events(:logo_published)).deliver
+    end
+
+    assert @webhook.reload.active?
+  end
+
+  private
+    def header(request, name)
+      request.headers.find { |key, _| key.casecmp?(name) }&.last
+    end
 end
