diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..2dd60ef
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,55 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A receiver that keeps failing gets switched off once it has failed this many
+  # times in a row inside a single failure window.
+  CONSECUTIVE_FAILURES_LIMIT = 10
+
+  # Consecutive failures only count against a webhook while they happen inside
+  # this window, so a receiver that fails once in a while stays on.
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    if consecutive_failures_count.positive? || first_failure_at.present?
+      reset
+    end
+  end
+
+  def record_failure
+    if window_expired?
+      restart_window
+    end
+
+    self.consecutive_failures_count += 1
+    self.first_failure_at ||= Time.current
+    save!
+
+    if delinquent?
+      deactivate_webhook
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count >= CONSECUTIVE_FAILURES_LIMIT
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    def window_expired?
+      first_failure_at.present? && first_failure_at.before?(FAILURE_WINDOW.ago)
+    end
+
+    def restart_window
+      self.consecutive_failures_count = 0
+      self.first_failure_at = nil
+    end
+
+    def deactivate_webhook
+      webhook.deactivate
+      reset
+    end
+end
