+require "net/http"
+
 class Webhook::Delivery < ApplicationRecord
+  # Deliveries are the log of what we sent and how it went. We keep a week of it.
+  RETENTION_PERIOD = 1.week
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  SIGNATURE_DIGEST = "SHA256"
+
+  CONTENT_TYPE = "application/json"
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  DESTINATION_UNREACHABLE = "destination_unreachable"
+
+  UNREACHABLE_ERRORS = [
+    EOFError, IOError, SocketError, Timeout::Error, OpenSSL::SSL::SSLError,
+    URI::Error, Errno::EACCES, Errno::EADDRNOTAVAIL, Errno::ECONNREFUSED,
+    Errno::ECONNRESET, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ETIMEDOUT
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +31,24 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ..RETENTION_PERIOD.ago).in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  # Every delivery is posted once and only once: claiming it turns any other
+  # attempt at delivering it, be it a duplicate job or a retry, into a no-op.
+  def deliver
+    if webhook.active? && claim
+      post
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +68,111 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        self.state = :in_progress
+        update! request: { headers: headers }
+        true
+      else
+        false
+      end
+    end
+
+    def post
+      if uri.host.blank?
+        error_out
+      else
+        Net::HTTP.start(uri.host, uri.port, use_ssl: uri.is_a?(URI::HTTPS), open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+          complete http.post(uri.request_uri, body, headers)
+        end
+      end
+    rescue *UNREACHABLE_ERRORS => error
+      Rails.error.report(error, handled: true)
+      error_out
+    end
+
+    def complete(http_response)
+      update! state: :completed, response: { code: http_response.code.to_i, error: nil }
+      record_outcome
+    end
+
+    def error_out
+      update! state: :errored, response: { error: DESTINATION_UNREACHABLE }
+      record_outcome
+    end
+
+    # Receivers that keep failing get switched off, receivers that keep working
+    # get to stay on.
+    def record_outcome
+      if failed?
+        webhook.delinquency_tracker.record_failure
+      else
+        webhook.delinquency_tracker.record_success
+      end
+    end
+
+    # Chat receivers get a line about what happened, everyone else gets the
+    # event itself.
+    def body
+      @body ||= if webhook.for_slack?
+        { text: message }.to_json
+      elsif webhook.for_campfire?
+        { body: { message: message } }.to_json
+      elsif webhook.for_basecamp?
+        { content: message }.to_json
+      else
+        event_body
+      end
+    end
+
+    def headers
+      {
+        "Content-Type" => CONTENT_TYPE,
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest(SIGNATURE_DIGEST, webhook.signing_secret, body)
+      }
+    end
+
+    def message
+      # The description is written for people looking at the board, so we
+      # always use the creator name instead of "you".
+      "#{event.description_for(nil).to_plain_text}\n#{eventable_url}"
+    end
+
+    def event_body
+      ApplicationController
+        .renderer
+        .new(**renderer_options)
+        .render(template: "webhooks/event", assigns: { event: event }, formats: :json)
+    end
+
+    def eventable_url
+      if event.eventable
+        Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+      end
+    end
+
+    def renderer_options
+      { http_host: url_options[:host], script_name: url_options[:script_name] }.tap do |options|
+        if url_options[:protocol] == "https"
+          options[:https] = true
+        end
+      end
+    end
+
+    # Links in the payload point at the receiver's own account.
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+
+      base_options.merge(script_name: webhook.account.slug)
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
 end
