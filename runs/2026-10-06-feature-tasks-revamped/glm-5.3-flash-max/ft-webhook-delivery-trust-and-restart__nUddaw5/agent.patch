--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @card = cards(:logo)
+  end
+
+  test "an event is relayed to the webhooks subscribed to it" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = relay_event("card_published")
+
+    delivery = Webhook::Delivery.find_by!(event: event, webhook: @webhook)
+    assert delivery.reload.succeeded?
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "an event is relayed exactly once" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = relay_event("card_published")
+
+    event.relay_now
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_equal 1, Webhook::Delivery.where(event: event).count
+  end
+
+  test "an event is not relayed to webhooks that aren't subscribed to it" do
+    event = relay_event("comment_created")
+
+    assert_empty Webhook::Delivery.where(event: event)
+  end
+
+  test "an event is not relayed to webhooks that are switched off" do
+    @webhook.deactivate
+
+    event = relay_event("card_published")
+
+    assert_empty Webhook::Delivery.where(event: event)
+  end
+
+  private
+    def relay_event(action)
+      stub_request(:post, @webhook.url).to_return(status: 200)
+
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        @card.board.events.create! action: action, creator: users(:david), eventable: @card
+      end
+    end
+end
