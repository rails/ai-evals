@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.reload.delinquency_tracker.persisted?
+  end
+
+  test "is created on demand when it is missing" do
+    @tracker.destroy
+
+    assert @webhook.reload.delinquency_tracker.persisted?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "starts with a clean slate" do
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "counts consecutive failures" do
+    3.times { @tracker.record_failure }
+
+    assert_equal 3, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates the webhook after ten consecutive failures over an hour" do
+    freeze_time
+
+    Webhook::DelinquencyTracker::CONSECUTIVE_FAILURES_LIMIT.times do |index|
+      travel 6.minutes if index.positive?
+
+      @tracker.record_failure
+    end
+
+    assert_not @webhook.reload.active?, "A webhook that keeps failing gets switched off"
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+
+  test "failures that stretch out over more than an hour start a new window" do
+    freeze_time
+
+    6.times do |index|
+      travel 10.minutes if index.positive?
+
+      @tracker.record_failure
+    end
+
+    assert_equal 6, @tracker.reload.consecutive_failures_count
+
+    travel 1.hour
+    @tracker.record_failure
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "resets the count when the receiver succeeds again" do
+    5.times { @tracker.record_failure }
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.reload.first_failure_at
+  end
+
+  test "a success keeps the webhook from being switched off" do
+    9.times { @tracker.record_failure }
+
+    @tracker.record_success
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a switched off webhook starts from a clean slate" do
+    @tracker.update! consecutive_failures_count: 12, first_failure_at: 10.minutes.ago
+
+    @webhook.activate
+
+    tracker = @webhook.reload.delinquency_tracker
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+end
