+class Public::BoardsController < ApplicationController
+  layout "public"
+
+  allow_unauthenticated_access only: :show
+  skip_before_action :require_account, only: :show
+
+  include PublicBoardScoped
+
+  def show
+    @columns = @board.columns.sorted
+    @cards_by_column_id = @board.cards.published.latest.with_golden_first.preloaded.group_by(&:column_id)
+
+    fresh_when etag: [ @board, @columns ]
+  end
+end
