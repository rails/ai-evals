+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  test "publish" do
+    sign_in_as :kevin
+
+    assert_changes -> { boards(:writebook).reload.published? }, from: false, to: true do
+      post board_publication_path(boards(:writebook))
+      assert_response :redirect
+    end
+
+    assert boards(:writebook).key.present?
+    assert_redirected_to edit_board_path(boards(:writebook))
+  end
+
+  test "publish as JSON" do
+    sign_in_as :kevin
+
+    post board_publication_path(boards(:writebook)), as: :json
+
+    assert_response :created
+    assert boards(:writebook).reload.published?
+    assert_equal public_board_url(boards(:writebook)), @response.parsed_body["public_url"]
+  end
+
+  test "publishing again keeps the same secret URL" do
+    board = boards(:writebook).tap(&:publish)
+    sign_in_as :kevin
+
+    assert_no_changes -> { board.reload.key } do
+      post board_publication_path(board)
+      assert_response :redirect
+    end
+  end
+
+  test "unpublish" do
+    board = boards(:writebook).tap(&:publish)
+    sign_in_as :kevin
+
+    assert_changes -> { board.reload.published? }, from: true, to: false do
+      delete board_publication_path(board)
+      assert_response :redirect
+    end
+
+    assert_not board.published?
+    assert board.key.present?
+  end
+
+  test "unpublish as JSON" do
+    board = boards(:writebook).tap(&:publish)
+    sign_in_as :kevin
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :success
+    assert_not board.reload.published?
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "members cannot publish" do
+    sign_in_as :jz
+
+    post board_publication_path(boards(:writebook))
+
+    assert_response :forbidden
+    assert_not boards(:writebook).reload.published?
+  end
+
+  test "members cannot unpublish" do
+    board = boards(:writebook).tap(&:publish)
+    sign_in_as :jz
+
+    delete board_publication_path(board)
+
+    assert_response :forbidden
+    assert board.reload.published?
+  end
+end
