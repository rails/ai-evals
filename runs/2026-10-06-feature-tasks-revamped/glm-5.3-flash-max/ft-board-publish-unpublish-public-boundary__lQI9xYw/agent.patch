@@ -0,0 +1,64 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@board), class: "btn btn--plain" %>
+  </div>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <% if @card.column %>
+          <span class="btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width">
+            <span class="overflow-ellipsis"><%= @card.column.name %></span>
+          </span>
+        <% end %>
+
+        <% if @card.tags.any? %>
+          <div class="card__tags-list min-width">
+            <% @card.tags.each do |tag| %>
+              <span class="card__tag btn btn--plain min-width txt-uppercase fill-transparent"><%= tag.title %></span>
+            <% end %>
+          </div>
+        <% end %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title flex align-start gap-half"><%= card_html_title(@card) %></h1>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content"><%= @card.description %></div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ol class="steps txt-small">
+              <% @card.steps.each do |step| %>
+                <li class="step">
+                  <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+                  <span class="step__content"><%= step.content %></span>
+                </li>
+              <% end %>
+            </ol>
+          <% end %>
+        </div>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <div class="card__meta">
+          <span class="card__meta-text card__meta-text--added">
+            Added <%= local_datetime_tag(@card.created_at, style: :daysago) %>
+          </span>
+
+          <span class="card__meta-text card__meta-text--author">
+            By <strong><%= @card.creator.familiar_name %></strong>
+          </span>
+        </div>
+      </footer>
+    <% end %>
+  </div>
+</section>
