+class Public::Boards::ColumnsController < ApplicationController
+  layout "public"
+
+  allow_unauthenticated_access only: :show
+  skip_before_action :require_account, only: :show
+
+  include PublicBoardScoped
+
+  before_action :set_column
+
+  def show
+    set_page_and_extract_portion_from @column.cards.published.latest.with_golden_first.preloaded
+    fresh_when etag: [ @board, @column, @page.records ]
+  end
+
+  private
+    def set_column
+      # Resolving the board first means a column of another board is not found.
+      @column = @board.columns.find(params[:id])
+    end
+end
