diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..520780d
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,41 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  KEY_LENGTH = 20
+
+  included do
+    scope :published, -> { where published: true }
+
+    before_save :stamp_publication
+  end
+
+  class_methods do
+    def find_publicly_by(key)
+      published.find_by(key: key) || published.find_by(id: key)
+    end
+  end
+
+  # Boards are addressed publicly by their secret key. A board that was never
+  # published has no key yet, in which case its id is used.
+  def public_key
+    key.presence || id
+  end
+
+  def publish
+    update! published: true
+  end
+
+  def unpublish
+    update! published: false
+  end
+
+  private
+    def stamp_publication
+      if published?
+        self.published_at ||= Time.current
+        self.key ||= SecureRandom.base58(KEY_LENGTH)
+      elsif published_at.present?
+        self.published_at = nil
+      end
+    end
+end
