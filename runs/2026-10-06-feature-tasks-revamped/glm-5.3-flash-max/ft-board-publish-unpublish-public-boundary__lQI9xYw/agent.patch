+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook).tap(&:publish)
+  end
+
+  test "public URLs are addressed by the board's secret key" do
+    assert_includes public_board_path(@board), @board.key
+    assert_not_includes public_board_path(@board), @board.id
+  end
+
+  test "show" do
+    get public_board_path(@board)
+
+    assert_response :success
+    assert_match @board.name, response.body
+  end
+
+  test "show without signing in" do
+    cookies.delete :session_token
+
+    get public_board_path(@board)
+
+    assert_response :success
+  end
+
+  test "show without an account prefix" do
+    get "/public/boards/#{@board.key}"
+
+    assert_response :success
+  end
+
+  test "show as JSON" do
+    get public_board_path(@board), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@board), @response.parsed_body["url"]
+    assert_equal @board.columns.sorted.pluck(:name), @response.parsed_body["columns"].pluck("name")
+  end
+
+  test "not found when not published" do
+    board = boards(:private)
+
+    get public_board_path(board)
+
+    assert_response :not_found
+  end
+
+  test "hides drafted cards" do
+    cards(:logo).update! status: :drafted
+
+    get public_board_path(@board)
+
+    assert_response :success
+    assert_no_match cards(:logo).title, response.body
+    assert_match cards(:layout).title, response.body
+  end
+
+  test "not found for unknown key" do
+    get public_board_path("not-a-real-key")
+
+    assert_response :not_found
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..f570751
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "is not published by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).published_at
+    assert_nil boards(:writebook).key
+  end
+
+  test "publishing" do
+    assert_changes -> { boards(:writebook).reload.published? }, from: false, to: true do
+      boards(:writebook).publish
+    end
+
+    assert boards(:writebook).published?
+    assert boards(:writebook).published_at.present?
+    assert boards(:writebook).key.present?
+  end
+
+  test "publishing again keeps the key" do
+    board = boards(:writebook).tap(&:publish)
+
+    assert_no_changes -> { board.reload.key } do
+      board.unpublish
+      board.publish
+    end
+  end
+
+  test "unpublishing" do
+    board = boards(:writebook).tap(&:publish)
+
+    assert_changes -> { board.reload.published? }, from: true, to: false do
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_nil board.published_at
+    assert board.key.present?
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, boards(:writebook)
+
+    boards(:writebook).publish
+    assert_includes Board.published, boards(:writebook)
+  end
+
+  test "finds a published board by key" do
+    board = boards(:writebook).tap(&:publish)
+
+    assert_equal board, Board.find_publicly_by(board.key)
+  end
+
+  test "finds a published board by id" do
+    board = boards(:writebook).tap(&:publish)
+
+    assert_equal board, Board.find_publicly_by(board.id)
+  end
+
+  test "does not find unpublished boards" do
+    board = boards(:private)
+
+    assert_nil Board.find_publicly_by(board.key)
+    assert_nil Board.find_publicly_by(board.id)
+  end
+end
