+++ b/app/assets/stylesheets/public-boards.css
@@ -0,0 +1,37 @@
+/* Read-only boards published behind a secret public link */
+
+@layer components {
+  .public-board__columns {
+    display: flex;
+    align-items: flex-start;
+    gap: var(--inline-space-double);
+    inline-size: 100%;
+    overflow-x: auto;
+    padding-block: var(--block-space);
+  }
+
+  .public-board__column {
+    flex: 0 0 auto;
+    inline-size: min(100%, 24rem);
+    padding: var(--block-space-half);
+  }
+
+  .public-board__column-name {
+    font-size: var(--text-x-small);
+    font-weight: bold;
+    letter-spacing: 0.05em;
+    margin-block: 0 var(--block-space-half);
+  }
+
+  .public-board__column-name a {
+    color: inherit;
+  }
+
+  .public-board__column .card {
+    margin-block-end: var(--block-space-half);
+  }
+
+  .public-board__cards {
+    padding-block: var(--block-space);
+  }
+}
diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..f7005a4
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: :created, location: board_path(@board, format: :json) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.json { render "boards/show" }
+    end
+  end
+end
