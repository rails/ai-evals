+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_collection_changed
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+  ]
+
+  ACTIVITY_ACTIONS = TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]
