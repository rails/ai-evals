diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..671e94c 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,25 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: activity_particular(:old_board), new_board: activity_particular(:new_board) }
+    when "card_title_changed"
+      { old_title: activity_particular(:old_title), new_title: activity_particular(:new_title) }
+    when "card_triaged"
+      { column: activity_particular(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_particular(key)
+      key = key.to_s
+      particulars.dig("particulars", key) || particulars[key] || ""
+    end
 end
