index 0000000..3e5dc54
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,68 @@
+# Activities
+
+Activities are the events that happen on the boards you have access to: cards being added,
+moved, assigned, renamed, closed, and comments being posted. This is the same activity that
+powers the HTML timeline, exposed as JSON.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity events, from newest to oldest. Only the activity of the
+boards you have access to is returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `board_ids[]` | Filter by board ID(s) |
+| `creator_ids[]` | Filter by the user ID(s) who created the event |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohdn",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to \"First!\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/1"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` objects use the same representation as the rest of the
+API. For comment events, `eventable_type` is `Comment` and `url` points to the card the comment
+was posted on, anchored to that comment.
+
+### Particulars
+
+`particulars` exposes event-specific details. Events without particulars return an empty object.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..0e06d49
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,199 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @davids_bearer_token = bearer_token_env(identity_access_tokens(:davids_api_token).token)
+  end
+
+  test "fails to authenticate with an invalid access token" do
+    get activities_path(format: :json), env: bearer_token_env("nonsense")
+    assert_response :unauthorized
+  end
+
+  test "index returns the activity of the boards the current user has access to" do
+    event_on_inaccessible_board = create_event(board: boards(:private))
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    assert_response :success
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:layout_assignment_jz).id
+    assert_not_includes ids, event_on_inaccessible_board.id
+  end
+
+  test "index orders activity from newest to oldest" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats, created_ats.sort.reverse
+  end
+
+  test "index returns the timeline actions, except deprecated ones" do
+    renamed = rename_card(cards(:logo), "A better title")
+    collected = create_event(action: "card_collection_changed")
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, renamed.id
+    assert_not_includes ids, collected.id
+  end
+
+  test "index returns the API representation of every event" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    event = events(:layout_assignment_jz)
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc, Time.zone.parse(activity["created_at"])
+    assert_equal event.description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable.id, activity["eventable"]["id"]
+    assert_equal event.board.id, activity["board"]["id"]
+    assert_equal event.creator.id, activity["creator"]["id"]
+    assert_equal card_url(event.eventable), activity["url"]
+  end
+
+  test "index returns the plain text description of an event" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_commented).id }
+    assert_equal events(:layout_commented).description_for(users(:david)).to_plain_text, activity["description"]
+    assert_includes activity["description"], "David commented on"
+  end
+
+  test "index returns assignment particulars" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_assignment_jz).id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+  end
+
+  test "index returns board change particulars" do
+    boards(:private).accesses.create!(user: users(:david), account: accounts("37s"))
+    event = move_card_to_board(cards(:logo), boards(:private))
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+  end
+
+  test "index returns title change particulars" do
+    event = rename_card(cards(:logo), "A better title")
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "A better title" }, activity["particulars"])
+  end
+
+  test "index returns triage particulars" do
+    event = triage_card(cards(:logo), columns(:writebook_in_progress))
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "index returns no particulars for other actions" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_published).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index returns empty strings for missing board, title, and column particulars" do
+    create_event(action: "card_board_changed", particulars: { old_board: nil, new_board: nil })
+    create_event(action: "card_title_changed", particulars: {})
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    particulars = @response.parsed_body.group_by { |activity| activity["action"] }.transform_values { |activities| activities.pluck("particulars") }
+    assert_includes particulars["card_board_changed"], { "old_board" => "", "new_board" => "" }
+    assert_includes particulars["card_title_changed"], { "old_title" => "", "new_title" => "" }
+  end
+
+  test "index links card activity to the card" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_published).id }
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index links comment activity to the commented card" do
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    comment = comments(:layout_overflowing_david)
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_commented).id }
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+  end
+
+  test "index can be filtered by creator" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }, env: @davids_bearer_token
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+    end
+  end
+
+  test "index can be filtered by board" do
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }, env: @davids_bearer_token
+
+    assert_response :success
+    assert_empty @response.parsed_body, "David has no access to the private board"
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }, env: @davids_bearer_token
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    @response.parsed_body.each do |activity|
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+
+  test "index is paginated" do
+    16.times { |index| create_event(created_at: index.minutes.from_now) }
+
+    get activities_path(format: :json), env: @davids_bearer_token
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_match(/rel="next"/, @response.headers["Link"])
+
+    get activities_path(format: :json), params: { page: 2 }, env: @davids_bearer_token
+
+    assert_equal 12, @response.parsed_body.size
+  end
+
+  private
+    def bearer_token_env(token)
+      { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+    end
+
+    def create_event(board: boards(:writebook), action: "card_published", particulars: {}, created_at: 1.minute.ago)
+      Event.create! action: action, creator: users(:kevin), board: board,
+        eventable: cards(:logo), account: board.account, particulars: particulars, created_at: created_at
+    end
+
+    def move_card_to_board(card, board)
+      with_current_user(users(:david)) { card.move_to(board) }
+      card.events.find_by!(action: "card_board_changed")
+    end
+
+    def rename_card(card, title)
+      with_current_user(users(:david)) { card.update! title: title }
+      card.events.find_by!(action: "card_title_changed")
+    end
+
+    def triage_card(card, column)
+      with_current_user(users(:david)) { card.triage_into(column) }
+      card.events.find_by!(action: "card_triaged")
+    end
+end
