new file mode 100644
index 0000000..44b612e
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,28 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+    fresh_when etag: [ @page.records, Current.user ]
+  end
+
+  private
+    def activities
+      scope = Current.user.accessible_events.where(action: Event::ACTIVITY_ACTIONS)
+      scope = scope.where(board_id: accessible_board_ids) if board_ids.present?
+      scope = scope.where(creator_id: creator_ids) if creator_ids.present?
+      scope.preloaded.order created_at: :desc
+    end
+
+    # Requested boards are constrained to the ones the current user has access to, so asking for
+    # inaccessible boards returns no activity instead of all of it.
+    def accessible_board_ids
+      Current.user.boards.where(id: board_ids).ids
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+end
