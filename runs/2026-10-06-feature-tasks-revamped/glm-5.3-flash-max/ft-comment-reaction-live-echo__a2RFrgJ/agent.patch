diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..161000a
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,33 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_CONTENT_LENGTH = 16
+  EMOJI_ONLY_PATTERN = /\p{Extended_Pictographic}|\p{Regional_Indicator}/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  # The reacter is also known as the creator of the reaction
+  alias_attribute :creator_id, :reacter_id
+  alias_method :creator, :reacter
+  alias_method :creator=, :reacter=
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_CONTENT_LENGTH }
+  validates :content, uniqueness: { scope: [ :comment_id, :reacter_id ] }
+
+  after_create_commit  -> { broadcast_reactions_replacement }
+  after_destroy_commit -> { broadcast_reactions_replacement }
+
+  def emoji_only?
+    content.present? && content.grapheme_clusters.all? { |cluster| cluster.match?(EMOJI_ONLY_PATTERN) }
+  end
+
+  private
+    def broadcast_reactions_replacement
+      comment.broadcast_replace_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions/reactions",
+        locals: { comment: comment }
+    end
+end
