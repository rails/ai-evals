+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions) do
+      assert_select "div.reaction", count: comment.reactions.count
+    end
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Nice!" } }, as: :json
+
+    assert_response :created
+    reaction = comment.reactions.find(JSON.parse(@response.body)["id"])
+    assert_equal users(:kevin).id, reaction.reacter_id
+    assert_equal "Nice!", reaction.content
+  end
+
+  test "create is idempotent" do
+    comment = comments(:logo_agreement_jz)
+    comment.react_by users(:kevin), content: "Nice!"
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create on a draft card is forbidden" do
+    card = cards(:logo)
+    comment = card.comments.create!(body: "Draft comment", creator: users(:kevin))
+    card.update_column(:status, :drafted)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(cards(:logo), comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_kevin_thumbs_up).content, @response.parsed_body.first["content"]
+    assert_equal users(:kevin).name, @response.parsed_body.first["reacter"]["name"]
+  end
+
+  test "index as HTML" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(cards(:logo), comment)
+
+    assert_response :success
+    assert_select "div.reactions .reaction", count: comment.reactions.count
+  end
+
+  test "reactions show up on a card with cached comments" do
+    with_actionview_partial_caching do
+      card = cards(:logo)
+      comment = comments(:logo_agreement_jz)
+
+      get card_path(card)
+      assert_response :success
+
+      comment.react_by users(:kevin), content: "Nice!"
+
+      get card_path(card)
+      assert_response :success
+      assert_match "Nice!", @response.body
+    end
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    comment = reaction.comment
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(cards(:logo), comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    delete card_comment_reaction_path(cards(:logo), reaction.comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "cannot destroy another person's reaction" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(cards(:logo), reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "content is limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "This is way too long" } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_content
+  end
+end
