@@ -0,0 +1,94 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    Current.user = users(:david)
+  end
+
+  test "reacter defaults to the current user" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "Nice work!")
+    reaction.valid?
+
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "account defaults to the comment's account" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "Nice work!", reacter: users(:david))
+    reaction.valid?
+
+    assert_equal accounts("37s"), reaction.account
+  end
+
+  test "requires content" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: " ", reacter: users(:david))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "This is way too long")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "allows several reactions from the same person" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +2 do
+      comment.react_by users(:david), content: "Nice work!"
+      comment.react_by users(:david), content: "Wow"
+    end
+  end
+
+  test "does not allow the same reaction twice from the same person" do
+    comment = comments(:logo_agreement_jz)
+    comment.react_by users(:david), content: "Nice work!"
+
+    assert_no_difference -> { comment.reactions.where(content: "Nice work!").count } do
+      comment.react_by users(:david), content: "Nice work!"
+    end
+  end
+
+  test "the same reaction from different people is allowed" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      comment.react_by users(:kevin), content: "👍"
+    end
+  end
+
+  test "emoji only reactions" do
+    assert comments(:logo_agreement_jz).reactions.build(content: "👍").emoji_only?
+    assert comments(:logo_agreement_jz).reactions.build(content: "🇺🇸").emoji_only?
+    assert_not comments(:logo_agreement_jz).reactions.build(content: "👍 Nice!").emoji_only?
+    assert_not comments(:logo_agreement_jz).reactions.build(content: "Nice").emoji_only?
+    assert_not comments(:logo_agreement_jz).reactions.build(content: "").emoji_only?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -comment.reactions.count do
+      comment.destroy
+    end
+  end
+
+  test "replacing the reactions strip on create" do
+    card = cards(:logo)
+
+    assert_turbo_stream_broadcasts card, count: 1 do
+      comments(:logo_agreement_jz).react_by users(:david), content: "Nice work!"
+    end
+  end
+
+  test "replacing the reactions strip on destroy" do
+    card = cards(:logo)
+
+    assert_turbo_stream_broadcasts card, count: 1 do
+      reactions(:logo_agreement_jz_thumbs_up).destroy
+    end
+  end
+end
