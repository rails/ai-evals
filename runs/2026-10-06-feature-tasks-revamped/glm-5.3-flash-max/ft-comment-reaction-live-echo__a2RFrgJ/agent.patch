+<%# locals: (comment:) %>
+<%= tag.div id: dom_id(comment, :reactions), class: "reactions",
+      data: { controller: "reactions", reactions_expanded_class: "expanded", reactions_deleteable_class: "reaction--deleteable" } do %>
+  <div class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.chronologically, as: :reaction, locals: { comment: comment } %>
+  </div>
+
+  <%= tag.button class: "reactions__trigger btn", title: "Add a reaction",
+        data: { reactions_target: "trigger", action: "reactions#open" } do %>
+    <%= image_tag "boost-color.svg", size: 24, class: "icon", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction to this comment</span>
+  <% end %>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction__form", html: { hidden: true },
+        data: { reactions_target: "form" } do |form| %>
+    <div class="reaction__menu" data-controller="dialog">
+      <%= tag.button type: :button, class: "btn reaction__menu-btn", title: "Pick an emoji",
+            data: { action: "dialog#toggle:stop" } do %>
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      <% end %>
+
+      <dialog class="popup reaction__popup" data-dialog-target="dialog" data-action="click@document->dialog#closeOnClickOutside">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <%= tag.button emoji, type: :button, class: "btn", title: name,
+                  data: { action: "reactions#pick click->dialog#close", reactions_emoji_param: emoji } %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <label class="reaction__form-label">
+      <span class="for-screen-reader">Add a reaction to this comment</span>
+      <%= form.text_field :content, class: "input reaction__input", maxlength: Reaction::MAXIMUM_CONTENT_LENGTH,
+            required: true, autocomplete: "off", spellcheck: false,
+            data: { reactions_target: "input", action: "keydown.esc->reactions#close:stop" } %>
+    </label>
+
+    <%= form.button class: "btn reaction__submit-btn", title: "Add this reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add this reaction</span>
+    <% end %>
+
+    <%= tag.button type: :button, class: "btn reaction__cancel-btn", title: "Cancel",
+          data: { action: "reactions#close" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
