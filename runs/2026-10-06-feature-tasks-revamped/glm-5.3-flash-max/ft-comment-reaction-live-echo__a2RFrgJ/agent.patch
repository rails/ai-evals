+++ b/test/system/reactions_test.rb
@@ -0,0 +1,103 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+    sign_in_as users(:david)
+  end
+
+  test "adding a reaction with the input" do
+    visit card_url(@card)
+
+    within reactions_of(@comment) do
+      assert_no_selector(".reaction__form")
+
+      find(".reactions__trigger").click
+      fill_in "Add a reaction to this comment", with: "Nice!"
+      find(".reaction__submit-btn").click
+
+      assert_selector(".reaction", text: "Nice!")
+      assert_no_selector(".reaction__form")
+      assert_selector(".reactions__trigger")
+    end
+  end
+
+  test "canceling keeps the trigger button" do
+    visit card_url(@card)
+
+    within reactions_of(@comment) do
+      find(".reactions__trigger").click
+      fill_in "Add a reaction to this comment", with: "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector(".reaction__form")
+      assert_selector(".reactions__trigger")
+    end
+
+    assert_no_text "Never mind"
+  end
+
+  test "picking an emoji adds it right away" do
+    visit card_url(@card)
+
+    within reactions_of(@comment) do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list .btn[title='Thumbs up']").click
+
+      assert_selector(".reaction", text: "👍")
+    end
+  end
+
+  test "removing your own reaction" do
+    @comment.react_by(users(:david), content: "👍")
+    visit card_url(@card)
+
+    within reactions_of(@comment) do
+      assert_no_selector(".reaction__delete")
+
+      find(".reaction", text: "👍").click
+      assert_selector(".reaction__delete")
+
+      find(".reaction__delete").click
+    end
+
+    within comment_of(@comment) do
+      assert_no_selector(".reaction", text: "👍")
+    end
+  end
+
+  test "other people's reactions can't be removed" do
+    @comment.react_by(users(:kevin), content: "🔥")
+    visit card_url(@card)
+
+    within reactions_of(@comment) do
+      find(".reaction", text: "🔥").click
+
+      assert_no_selector(".reaction--deleteable", text: "🔥")
+    end
+  end
+
+  test "reactions from other people land as they happen" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    @comment.react_by(users(:kevin), content: "🔥")
+
+    within reactions_of(@comment) do
+      assert_selector(".reaction", text: "🔥")
+    end
+  end
+
+  private
+    def reactions_of(comment)
+      "##{dom_id(comment, :reactions)}"
+    end
+
+    def comment_of(comment)
+      "##{dom_id(comment)}"
+    end
+end
