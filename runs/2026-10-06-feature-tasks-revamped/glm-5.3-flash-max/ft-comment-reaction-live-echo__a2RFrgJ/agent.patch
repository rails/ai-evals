diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..23a601a
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,63 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: [ :content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    respond_to do |format|
+      format.html { render_reactions }
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.react_by(Current.user, content: reaction_params[:content])
+
+    respond_to do |format|
+      format.turbo_stream { render_reactions_replacement }
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream { render_reactions_replacement }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def render_reactions
+      render partial: "cards/comments/reactions/reactions", locals: { comment: @comment }
+    end
+
+    def render_reactions_replacement
+      render turbo_stream: turbo_stream.replace([ @comment, :reactions ], partial: "cards/comments/reactions/reactions", locals: { comment: @comment })
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..a2aa4b3
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "reaction" ]
+  static classes = [ "expanded", "deleteable" ]
+
+  connect() {
+    this.close()
+  }
+
+  reactionTargetConnected(reaction) {
+    if (this.#isMine(reaction)) reaction.classList.add(this.deleteableClass)
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(this.expandedClass)
+    this.inputTarget.focus()
+  }
+
+  close() {
+    if (!this.hasFormTarget) return
+
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove(this.expandedClass)
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+    if (this.hasInputTarget) this.inputTarget.value = ""
+  }
+
+  pick({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.inputTarget.form.requestSubmit()
+  }
+
+  reveal({ target }) {
+    const reaction = target.closest("[data-reactions-target=reaction]")
+
+    if (reaction && !target.closest("button") && this.#isMine(reaction)) {
+      reaction.classList.toggle(this.expandedClass)
+    }
+  }
+
+  #isMine(reaction) {
+    return reaction.dataset.reacterId === window.Current?.user?.id
+  }
+}
