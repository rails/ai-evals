@@ -0,0 +1,31 @@
+# Secrets for deploying Fizzy with Kamal.
+#
+# Copy this file to .kamal/secrets and fill it in -- .kamal/secrets is
+# gitignored, so real values stay out of the repository:
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# Kamal reads it as a dotenv file, so `KEY=value` and `KEY=$(command)` both work.
+
+# Password for the container registry the image is pushed to (see `image:` in
+# config/deploy.yml). On Docker Hub, create an access token at
+# https://app.docker.com/settings/personal-access-tokens
+KAMAL_REGISTRY_PASSWORD=
+
+# Signs sessions and cookies. Generate one and keep it safe -- losing it signs
+# everybody out, and changing it invalidates existing sessions:
+#
+#   openssl rand -hex 64
+SECRET_KEY_BASE=
+
+# Password for the mail server in config/deploy.yml. Leave it empty if your
+# relay accepts unauthenticated mail.
+SMTP_PASSWORD=
+
+# Browser push notifications (optional). Generate a pair with:
+#
+#   bin/rails runner 'key = WebPush.generate_key
+#                     puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+#                     puts "VAPID_PRIVATE_KEY=#{key.private_key}"'
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
