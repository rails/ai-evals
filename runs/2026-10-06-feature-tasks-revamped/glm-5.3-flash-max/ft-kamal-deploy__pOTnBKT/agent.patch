diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..e9f872c
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,110 @@
+# Deploy Fizzy to a single box with Kamal.
+#
+# Everything runs in one container on one Linux server: the web app, background
+# jobs (Solid Queue inside Puma), SQLite for the database, queue, cache and
+# cable, and uploaded files. kamal-proxy sits in front of it all and terminates
+# SSL, so Fizzy is served from https://your-host.
+#
+# To make this deployment yours:
+#
+#   1. Point the DNS record for your hostname at the box, then replace
+#      `fizzy.example.com` below -- it appears in `servers` and in `proxy`.
+#   2. Replace `your-docker-hub-username/fizzy` with an image you can push to.
+#   3. Point `SMTP_ADDRESS` at your mail server.
+#   4. Copy `.kamal/secrets.example` to `.kamal/secrets` and fill it in.
+#   5. Run `bin/kamal setup`.
+#
+# The full walkthrough is in docs/self-hosting.md.
+
+service: fizzy
+
+# Kamal builds the image from this checkout and pushes it to your registry
+# before every deploy. Docker Hub needs no `registry.server`; for ghcr.io or
+# any other registry, set `server` under `registry` below.
+image: your-docker-hub-username/fizzy
+
+# The box. Kamal connects over SSH as root -- see `ssh` at the bottom for
+# deploying as another user.
+servers:
+  web:
+    hosts:
+      - fizzy.example.com # <-- your hostname
+
+# Every database (app, queue, cache and cable) and every uploaded file lives
+# under /rails/storage. Mounting that directory as a named volume is what makes
+# data survive `kamal deploy` and `kamal app boot`.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# kamal-proxy listens on ports 80 and 443 of the box, answers the Let's Encrypt
+# challenge on 80, and proxies to the container. Leave both ports reachable.
+proxy:
+  ssl: true
+  host: fizzy.example.com # <-- your hostname, the certificate is issued for it
+
+# Credentials for the registry the image is pushed to. The password comes from
+# .kamal/secrets and is used both when pushing and when the box pulls.
+registry:
+  # server: ghcr.io
+  username: your-docker-hub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  # arm64 for an ARM box.
+  arch: amd64
+
+# Assets are fingerprinted per release. Bridging them over from the container
+# that is being replaced means in-flight requests don't 404 on their assets.
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_LOG_LEVEL: info
+
+    # Run Solid Queue inside Puma, so background jobs run in the same
+    # container as the web app. Give it fewer processes than the box has
+    # cores with JOB_CONCURRENCY, e.g. JOB_CONCURRENCY: "2".
+    SOLID_QUEUE_IN_PUMA: "true"
+    # JOB_CONCURRENCY: "2"
+
+    # From address for outbound mail. Use an address your mail server is allowed
+    # to send from, or the messages will be rejected as spam.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>"
+
+    # Your mail server. The password goes in .kamal/secrets as SMTP_PASSWORD.
+    # SMTP_DOMAIN, SMTP_TLS, SMTP_ENABLE_STARTTLS_AUTO and SMTP_AUTHENTICATION
+    # are read from the environment too, so set whatever your provider needs.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_USERNAME: fizzy@fizzy.example.com
+
+    # The public hostname. Links in magic-link emails, notifications and
+    # webhooks are built from it. It falls back to the host Kamal deployed to,
+    # so set it only when that differs from the hostname people visit.
+    # APP_HOST: fizzy.example.com
+
+    # Let anybody sign up for an account of their own. Leave it unset to run a
+    # single account that people join with a join code instead.
+    # MULTI_TENANT: "true"
+
+  secret:
+    # Signs sessions and cookies. Losing it signs everybody out.
+    - SECRET_KEY_BASE
+
+    # Password for the mail server above.
+    - SMTP_PASSWORD
+
+    # Optional: browser push notifications.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "bash"
+  logs: app logs -f
+
+# Deploy as a user other than root. They need to be in the `docker` group.
+#
+# ssh:
+#   user: deploy
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..23a807d 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,38 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Links in magic-link emails, notifications and webhooks have to be absolute.
+  # Kamal deployments get the host they deployed to injected as KAMAL_HOST, and
+  # can set APP_HOST to override it -- see config/deploy.yml and
+  # docs/self-hosting.md.
+  if public_host = ENV["APP_HOST"].presence || ENV["KAMAL_HOST"].presence
+    config.action_controller.default_url_options = { host: public_host, protocol: "https" }
+    config.action_mailer.default_url_options = { host: public_host, protocol: "https" }
+  end
+
+  # Outbound mail is delivered through an SMTP server of your choosing, which is
+  # configured entirely with environment variables (see docs/self-hosting.md).
+  # Leave SMTP_ADDRESS unset to deliver through a relay on the box itself.
+  if ENV["SMTP_ADDRESS"].present?
+    smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: ENV.fetch("SMTP_PORT", "587").to_i,
+      domain: ENV["SMTP_DOMAIN"].presence,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+    smtp_settings[:tls] = true if ENV["SMTP_TLS"] == "true"
+
+    # Not every relay wants a login, so only authenticate when asked to.
+    if ENV["SMTP_USERNAME"].present?
+      smtp_settings[:user_name] = ENV["SMTP_USERNAME"]
+      smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+    end
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
