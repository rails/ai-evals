diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c48601c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,198 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Drag a card onto another column to change the column it belongs to, or onto one of the
+// status columns (Maybe?, Not Now, Done) to change its status instead.
+//
+// The board shows the move the moment the card is dropped, before the save round trip
+// happens: the card is placed where the server will end up rendering it, and nothing has
+// to shift once the save lands.
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  start(event) {
+    const card = this.#cardFrom(event)
+    if (!card) return
+
+    this.draggedCard = card
+    card.classList.add(this.draggedItemClass)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", this.#titleOf(card))
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFrom(event)
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+
+    this.#highlight(column)
+  }
+
+  drop(event) {
+    const column = this.#columnFrom(event)
+
+    event.preventDefault()
+    this.#highlight(null)
+
+    if (this.draggedCard && column) this.#moveCard(this.draggedCard, column)
+  }
+
+  end() {
+    this.#highlight(null)
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+  }
+
+  // Private
+
+  #moveCard(card, column) {
+    const source = this.#columnOf(card)
+    if (!source || source === column) return // dragging a card within its column keeps the column order
+
+    const request = this.#requestFor(card, column)
+    if (!request) return
+
+    const move = this.#relocateCard(card, column)
+
+    if (move) {
+      this.#updateCount(source, -1)
+      this.#updateCount(column, +1)
+    }
+
+    this.#save(request, { card, source, column, move })
+  }
+
+  // The board is already showing the move, so the save has nothing left to change. If it
+  // fails, the card goes back to where it came from.
+  async #save(request, { card, source, column, move }) {
+    if ((await request).ok) return
+
+    if (move) {
+      move.undo()
+      this.#updateCount(source, +1)
+      this.#updateCount(column, -1)
+    }
+  }
+
+  #relocateCard(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return null
+
+    const parent = card.parentElement
+    const nextSibling = card.nextSibling
+    const asItWas = card.cloneNode(true)
+
+    this.#place(card, column)
+    list.insertBefore(card, this.#placeForNewestCardIn(list))
+
+    return {
+      undo: () => {
+        card.replaceWith(asItWas)
+        parent.insertBefore(asItWas, nextSibling)
+      }
+    }
+  }
+
+  // A card carries the name of the column it belongs to, and postponed or closed ones carry
+  // a stamp and a dimmed look. Dropping it somewhere else means dropping all of that.
+  #place(card, column) {
+    const columnId = column.dataset.dragAndDropColumnIdValue
+    const status = column.dataset.dragAndDropStatusValue
+
+    if (columnId) {
+      this.#renameColumnOf(card, column.dataset.columnName)
+      card.querySelector(".card__closed")?.remove()
+    } else {
+      card.querySelector(".card__column-name--current")?.remove()
+    }
+
+    card.classList.toggle("card--postponed", status === "not_now")
+    card.classList.toggle("card--active", status !== "not_now" && status !== "closed")
+  }
+
+  #renameColumnOf(card, columnName) {
+    if (!columnName) return
+
+    const label = card.querySelector(".card__column-name--current .overflow-ellipsis")
+    if (label) label.textContent = columnName
+  }
+
+  // Only children of the list can be used as an insertion point, so we settle for the
+  // wrapper of the card we'd land after.
+  #placeForNewestCardIn(list) {
+    for (const card of list.querySelectorAll("article.card")) {
+      if (!card.classList.contains("golden-effect")) return this.#wrapperOf(card, list)
+    }
+
+    return null
+  }
+
+  #wrapperOf(card, list) {
+    let wrapper = card
+
+    while (wrapper.parentElement !== list) wrapper = wrapper.parentElement
+
+    return wrapper
+  }
+
+  #requestFor(card, column) {
+    const columnId = column.dataset.dragAndDropColumnIdValue
+
+    if (columnId) {
+      return post(card.dataset.cardTriageUrl, { body: { column_id: columnId }, responseKind: "json" })
+    }
+
+    switch (column.dataset.dragAndDropStatusValue) {
+      case "not_now": return post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+      case "closed": return post(card.dataset.cardClosureUrl, { responseKind: "json" })
+      case "triage": return destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+    }
+
+    return null
+  }
+
+  #updateCount(column, delta) {
+    const counter = column.querySelector(".cards__expander-count")
+    const expander = column.querySelector(".cards__expander")
+    if (!counter || !expander) return
+
+    const count = Number.parseInt(counter.textContent, 10)
+    if (Number.isNaN(count)) return // "99+" and friends are left for the save to reconcile
+
+    const total = Math.max(0, count + delta)
+    counter.textContent = total
+    expander.style.setProperty("--card-count", total)
+  }
+
+  #highlight(column) {
+    if (column === this.hoveredColumn) return
+
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = column
+    this.hoveredColumn?.classList.add(this.hoverContainerClass)
+  }
+
+  #columnOf(card) {
+    return card.closest('[data-drag-and-drop-target~="column"]')
+  }
+
+  #cardFrom(event) {
+    return event.target.closest('[data-drag-and-drop-target~="card"]')
+  }
+
+  #columnFrom(event) {
+    return event.target.closest('[data-drag-and-drop-target~="column"]')
+  }
+
+  #titleOf(card) {
+    return card.querySelector(".card__title")?.textContent?.trim() ?? card.id
+  }
+}
