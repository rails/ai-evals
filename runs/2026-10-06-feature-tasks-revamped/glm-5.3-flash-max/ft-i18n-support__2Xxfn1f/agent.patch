diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..50e9cd8
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,33 @@
+// Strings the server rendered for the language of the page, so the JavaScript
+// can speak the same language (dates, relative times, prompts, ...).
+const messagesElement = () => document.querySelector("meta[name='js-messages']")
+
+let cachedMessages
+let cachedContent
+
+export function messages() {
+  const content = messagesElement()?.getAttribute("content") || "{}"
+
+  if (cachedContent !== content) {
+    cachedContent = content
+    try {
+      cachedMessages = JSON.parse(content)
+    } catch {
+      cachedMessages = {}
+    }
+  }
+
+  return cachedMessages
+}
+
+// The locale the page was rendered in, as BCP 47 (e.g. "en-US" or "ja-JP").
+export function pageLocale() {
+  return messages().locale || "en-US"
+}
+
+// Look up a translated message, interpolating %{placeholders}.
+export function message(key, { fallback = "", ...options } = {}) {
+  const template = messages()[key] ?? fallback
+
+  return template.replace(/%\{(\w+)\}/g, (_, name) => options[name] ?? `%{${name}}`)
+}
