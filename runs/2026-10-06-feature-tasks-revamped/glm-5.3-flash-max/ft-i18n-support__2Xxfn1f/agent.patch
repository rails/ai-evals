+module LocalizationHelper
+  # The locale the page is rendered in, in the form JavaScript wants.
+  # (+I18n.locale+ is "en" or "ja"; Intl also wants a region.)
+  def js_locale
+    I18n.t("js.locale", default: I18n.default_locale)
+  end
+
+  # Everything the JavaScript needs to say in the language of the page: relative
+  # times, prompts, browser validation messages, and so on.
+  def js_messages
+    { locale: js_locale }.merge(I18n.t("js", default: {}).except("locale"))
+  end
+end
