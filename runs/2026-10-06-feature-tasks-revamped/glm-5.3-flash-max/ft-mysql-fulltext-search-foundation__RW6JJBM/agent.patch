@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Card::Search::MatchTest < ActiveSupport::TestCase
+  test "matched" do
+    assert match("A haggis for dinner", %w[haggis]).matched?
+    assert_not match("A neep for dinner", %w[haggis]).matched?
+  end
+
+  test "to_html wraps every matched word in a mark tag" do
+    assert_equal "a <mark>haggis</mark> and another <mark>Haggis</mark>", match("a haggis and another Haggis", %w[haggis]).to_html
+  end
+
+  test "to_html escapes the text around the matched words" do
+    assert_equal "&lt;<mark>haggis</mark>&gt; &amp; neeps", match("<haggis> & neeps", %w[haggis]).to_html
+  end
+
+  test "excerpt is a snippet around the first matched word" do
+    text = "#{"Neeps " * 60}A haggis for dinner. #{"Tatties " * 60}"
+    excerpt = match(text, %w[haggis]).excerpt
+
+    assert_match(/A <mark>haggis<\/mark> for dinner\./, excerpt)
+    assert_not excerpt.start_with?("Neeps Neeps Neeps Neeps Neeps Neeps Neeps Neeps Neeps Neeps")
+  end
+
+  test "excerpt is the whole text when it is short" do
+    assert_equal "A <mark>haggis</mark> for dinner", match("A haggis for dinner", %w[haggis]).excerpt
+  end
+
+  test "excerpt from rich text content" do
+    assert_equal "Same, let&#39;s do it.", match(comments(:logo_agreement_kevin).body, %w[missing]).excerpt
+  end
+
+  private
+    def match(content, words)
+      Card::Search::Match.new content, words
+    end
+end
diff --git a/test/models/card/search_test.rb b/test/models/card/search_test.rb
