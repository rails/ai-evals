+++ b/test/models/card/search_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "words splits the query" do
+    assert_equal %w[ haggis neeps ], search("  haggis   neeps ").words
+  end
+
+  test "cards with an empty query" do
+    card title: "A haggis"
+
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+  end
+
+  test "cards finds cards by title, description, and comment body" do
+    titled = card title: "The haggis is missing"
+    described = card title: "About neeps", description: "It smells of haggis"
+    commented = card title: "About tatties"
+    commented.comments.create!(creator: users(:kevin), body: "Add some haggis to it")
+
+    assert_equal [ titled, described, commented ].collect(&:title).sort, search("haggis").cards.collect(&:title).sort
+  end
+
+  test "cards finds cards containing every word of the query" do
+    card title: "A haggis with neeps"
+    card title: "A haggis for dinner"
+
+    assert_equal [ "A haggis with neeps" ], search("haggis neeps").cards.collect(&:title)
+  end
+
+  test "cards matches words regardless of their case" do
+    card title: "The HAGGIS is missing"
+
+    assert_equal [ "The HAGGIS is missing" ], search("haggis").cards.collect(&:title)
+  end
+
+  test "cards never finds drafted cards" do
+    card title: "A draft about haggis", status: :drafted
+
+    assert_empty search("haggis").cards
+  end
+
+  test "cards with a query that contains wildcards" do
+    card title: "A haggis is missing"
+
+    assert_empty search("%_haggis").cards
+  end
+
+  private
+    def search(query)
+      Card::Search.new users(:kevin).accessible_cards, query
+    end
+
+    def card(**attributes)
+      with_current_user(users(:kevin)) do
+        boards(:writebook).cards.create!(**{ title: "A card", creator: users(:kevin), status: :published }.merge(attributes))
+      end
+    end
+end
