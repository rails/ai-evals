diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..69b38f3
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,35 @@
+# A free text search over cards: it matches the title, the description, or the body of any
+# comment on the card. Every word of the query has to be found somewhere in the card for it
+# to match.
+class Card::Search
+  attr_reader :query
+
+  def initialize(scope, query)
+    @scope = scope
+    @query = query
+  end
+
+  def cards
+    if words.any?
+      searchable_cards.matching(words).reverse_chronologically.distinct
+    else
+      searchable_cards.none
+    end
+  end
+
+  def words
+    @words ||= query.to_s.split.freeze
+  end
+
+  private
+    attr_reader :scope
+
+    def searchable_cards
+      published.preloaded.preload(comments: :rich_text_body)
+    end
+
+    # Drafts are never searched, not even for the comments they hold.
+    def published
+      scope.published
+    end
+end
diff --git a/app/models/card/search/match.rb b/app/models/card/search/match.rb
new file mode 100644
index 0000000..3345f63
--- /dev/null
+++ b/app/models/card/search/match.rb
@@ -0,0 +1,64 @@
+# A piece of searchable content: a card title, a card description, or the body of a comment.
+# It knows whether it contains any of the searched words, and how to render itself with
+# those words wrapped in <mark> tags.
+class Card::Search
+  class Match
+    include ActionView::Helpers::TagHelper, ERB::Util
+
+    EXCERPT_LENGTH = 200
+    LEADING_CONTEXT = 50
+
+    def initialize(content, words)
+      @text = plain_text(content)
+      @pattern = pattern_for(words)
+    end
+
+    def matched?
+      @text.match?(@pattern)
+    end
+
+    # The whole text, with every matched word highlighted.
+    def to_html
+      highlight(@text).html_safe
+    end
+
+    # A snippet of the text around the first matched word, with every matched word
+    # highlighted.
+    def excerpt
+      highlight(snippet).html_safe
+    end
+
+    private
+      attr_reader :text, :pattern
+
+      def plain_text(content)
+        text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+        text.gsub(/\s+/, " ").strip
+      end
+
+      def pattern_for(words)
+        Regexp.new words.sort_by(&:length).reverse.collect { Regexp.escape(it) }.join("|"), Regexp::IGNORECASE
+      end
+
+      def highlight(text)
+        parts = []
+        position = 0
+
+        while match = pattern.match(text, position)
+          parts << h(text[position...match.begin(0)])
+          parts << tag.mark(h(match[0]))
+          position = match.end(0)
+        end
+
+        parts << h(text[position..])
+        parts.join
+      end
+
+      def snippet
+        return text.first(EXCERPT_LENGTH) unless match = pattern.match(text)
+        return text if text.length <= EXCERPT_LENGTH
+
+        text[[ match.begin(0) - LEADING_CONTEXT, 0 ].max, EXCERPT_LENGTH]
+      end
+  end
+end
diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..876a0a8
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,53 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  # Cards are searched by title, by the body of their description, and by the body of
+  # every comment on them. Descriptions and comment bodies live in Action Text, so they
+  # are joined in with aliases to keep the card itself, its description, and its comment
+  # bodies addressable in the same query.
+  SEARCHABLE_TEXT_JOINS = <<~SQL.squish
+    LEFT JOIN action_text_rich_texts AS card_descriptions
+      ON card_descriptions.record_type = 'Card'
+      AND card_descriptions.record_id = cards.id
+      AND card_descriptions.name = 'description'
+    LEFT JOIN comments AS card_comments
+      ON card_comments.card_id = cards.id
+    LEFT JOIN action_text_rich_texts AS card_comment_bodies
+      ON card_comment_bodies.record_type = 'Comment'
+      AND card_comment_bodies.record_id = card_comments.id
+      AND card_comment_bodies.name = 'body'
+  SQL
+
+  class_methods do
+    # Cards that contain every one of the +words+ in their title, their description, or
+    # the body of any of their comments.
+    def matching(words)
+      with_searchable_text.where(words.collect { matches_searchable_text(it) }.reduce(:and))
+    end
+
+    private
+      def with_searchable_text
+        joins SEARCHABLE_TEXT_JOINS
+      end
+
+      def matches_searchable_text(word)
+        searchable_text_columns.collect { it.lower.matches(searchable_text_pattern(word)) }.reduce(:or)
+      end
+
+      def searchable_text_pattern(word)
+        "%#{sanitize_sql_like(word)}%"
+      end
+
+      def searchable_text_columns
+        [ arel_table[:title], card_descriptions[:body], card_comment_bodies[:body] ]
+      end
+
+      def card_descriptions
+        Arel::Table.new(name: "action_text_rich_texts", as: "card_descriptions")
+      end
+
+      def card_comment_bodies
+        Arel::Table.new(name: "action_text_rich_texts", as: "card_comment_bodies")
+      end
+  end
+end
