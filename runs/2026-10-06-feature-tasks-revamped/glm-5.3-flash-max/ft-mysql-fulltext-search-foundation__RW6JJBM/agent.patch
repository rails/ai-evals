+module SearchesHelper
+  # The content of +card+ (its title, its description, or the body of a comment on it) with
+  # the searched words wrapped in <mark> tags.
+  def search_highlight(content, words)
+    Card::Search::Match.new(content, words).to_html
+  end
+
+  # An excerpt around the first matched word for every description and comment on +card+
+  # that contains one of the searched words.
+  def search_excerpts(card, words)
+    searchable_contents(card).filter_map do |content|
+      match = Card::Search::Match.new(content, words)
+      match.excerpt if match.matched?
+    end
+  end
+
+  private
+    def searchable_contents(card)
+      [ card.description, *card.comments.collect(&:body) ]
+    end
+end
