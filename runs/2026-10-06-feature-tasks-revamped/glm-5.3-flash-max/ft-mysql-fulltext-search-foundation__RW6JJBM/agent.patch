diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1855124
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index finds cards by title, description, and comment body" do
+    card title: "The haggis is missing"
+    card title: "A card about neeps", description: "It smells of haggis"
+    commented = card title: "A card about tatties"
+    comment commented, "Add some haggis to it"
+
+    get search_path, params: { q: "haggis" }
+
+    assert_response :success
+    assert_results "The haggis is missing", "A card about neeps", "A card about tatties"
+  end
+
+  test "index wraps the matched words in a mark tag" do
+    card title: "The Haggis is missing"
+
+    get search_path, params: { q: "haggis" }
+
+    assert_select "h2.search-result__title", html: "The <mark>Haggis</mark> is missing"
+  end
+
+  test "index escapes the matched content while highlighting" do
+    commented = card title: "A card about tatties"
+    comment commented, "Found it behind the haggis & the neeps"
+
+    get search_path, params: { q: "haggis" }
+
+    assert_select "li.search-result__excerpt", html: "Found it behind the <mark>haggis</mark> &amp; the neeps"
+  end
+
+  test "index never finds drafted cards" do
+    card title: "A draft about haggis", status: :drafted
+
+    get search_path, params: { q: "haggis" }
+
+    assert_response :success
+    assert_no_results "A draft about haggis"
+  end
+
+  test "index finds the newest cards first" do
+    card title: "An old haggis", created_at: 3.weeks.ago
+    card title: "A new haggis", created_at: 3.days.ago
+
+    get search_path, params: { q: "haggis" }
+
+    assert_equal [ "A new haggis", "An old haggis" ], result_titles
+  end
+
+  test "index with a query that matches nothing" do
+    get search_path, params: { q: "cathampus" }
+
+    assert_response :success
+    assert_select "div.blank-slate", text: /No cards match/
+  end
+
+  test "index without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "div.blank-slate"
+  end
+
+  test "index redirects to sign in when signed out" do
+    sign_out
+
+    get search_path, params: { q: "haggis" }
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  private
+    def card(**attributes)
+      board = attributes.delete(:board) || boards(:writebook)
+      creator = attributes.delete(:creator) || users(:kevin)
+
+      with_current_user(creator) do
+        board.cards.create!(**{ title: "A card", creator: creator, status: :published }.merge(attributes))
+      end
+    end
+
+    def comment(card, body)
+      with_current_user(card.creator) { card.comments.create!(creator: card.creator, body: body) }
+    end
+
+    def assert_results(*titles)
+      titles.each { assert_select "h2.search-result__title", text: title_regexp(it) }
+    end
+
+    def assert_no_results(*titles)
+      titles.each { assert_select "h2.search-result__title", text: title_regexp(it), count: 0 }
+    end
+
+    def title_regexp(title)
+      Regexp.new "^" + Regexp.escape(title) + "$"
+    end
+
+    def result_titles
+      assert_select("h2.search-result__title").to_a.collect(&:text)
+    end
+end
+
+class SearchesControllerAccessTest < ActionDispatch::IntegrationTest
+  test "index finds cards on private boards you have access to" do
+    sign_in_as :kevin
+    secret_card_on_private_board
+
+    get search_path, params: { q: "haggis" }
+
+    assert_select "h2.search-result__title", text: /A secret haggis/
+  end
+
+  test "index does not find cards on boards you have no access to" do
+    sign_in_as :jz
+    secret_card_on_private_board
+
+    get search_path, params: { q: "haggis" }
+
+    assert_select "h2.search-result__title", text: /A secret haggis/, count: 0
+  end
+
+  test "index does not find cards from other accounts" do
+    sign_in_as :kevin
+
+    get search_path, params: { q: "reasonable volume" }
+
+    assert_select "h2.search-result__title", count: 0
+  end
+
+  test "index finds cards of the account you are in" do
+    sign_in_as :mike
+    tenant_as :initech
+
+    get search_path, params: { q: "reasonable volume" }
+
+    assert_select "h2.search-result__title", text: /play my radio/
+  end
+
+  private
+    def tenant_as(account)
+      integration_session.default_url_options[:script_name] = accounts(account).slug
+    end
+
+    def secret_card_on_private_board
+      with_current_user(users(:kevin)) do
+        boards(:private).cards.create!(title: "A secret haggis", creator: users(:kevin), status: :published)
+      end
+    end
+end
diff --git a/test/models/card/search/match_test.rb b/test/models/card/search/match_test.rb
