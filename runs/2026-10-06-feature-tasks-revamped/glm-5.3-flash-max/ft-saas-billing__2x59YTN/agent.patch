diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..63cbe30
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,29 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ACTIVE_STATUSES = %w[ active trialing ].freeze
+
+  before_destroy :cancel_with_stripe
+
+  validates :plan_key, presence: true
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.key
+  end
+
+  def active?
+    status.in? ACTIVE_STATUSES
+  end
+
+  private
+    # There is nobody left to bill for an account that's going away.
+    def cancel_with_stripe
+      Stripe::Subscription.cancel(stripe_subscription_id) if stripe_subscription_id
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..d152c13
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,73 @@
+# The hosted plans. Plans are code, not data: what each tier includes is a
+# product decision, not something to be edited in a database. Subscriptions
+# point at a plan by key, and everything else — price, card allowance, storage
+# allowance — hangs off the plan itself.
+class Plan
+  class << self
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s }
+    end
+
+    # Maps a Stripe price onto a plan. Unrecognized prices (or a missing
+    # STRIPE_*_PRICE_ID configuration) resolve to no plan at all, so a webhook
+    # for a product we don't know about never upgrades anybody.
+    def find_by_stripe_price_id(price_id)
+      PAID.find { |plan| plan.stripe_price_id == price_id }
+    end
+
+    def free = FREE
+  end
+
+  attr_reader :key, :name, :monthly_price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, monthly_price_in_cents:, card_limit: nil, storage_limit:)
+    @key = key
+    @name = name
+    @monthly_price_in_cents = monthly_price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  def free?
+    self == FREE
+  end
+
+  def paid?
+    !free?
+  end
+
+  def cards_unlimited?
+    card_limit.nil?
+  end
+
+  def monthly_price
+    monthly_price_in_cents / 100.0
+  end
+
+  # The Stripe price this plan is billed through, nil when the plan is free or
+  # when the deployment hasn't been given a price ID for it.
+  def stripe_price_id
+    ENV[STRIPE_PRICE_ID_ENV_VARS[key]]
+  end
+
+  def to_s
+    name
+  end
+
+  STRIPE_PRICE_ID_ENV_VARS = {
+    "unlimited" => "STRIPE_MONTHLY_V1_PRICE_ID",
+    "unlimited_plus" => "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  }.freeze
+
+  FREE = new key: "free", name: "Free",
+    monthly_price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte
+
+  UNLIMITED = new key: "unlimited", name: "Unlimited",
+    monthly_price_in_cents: 20_00, storage_limit: 5.gigabytes
+
+  UNLIMITED_PLUS = new key: "unlimited_plus", name: "Unlimited+",
+    monthly_price_in_cents: 25_00, storage_limit: 500.gigabytes
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+end
