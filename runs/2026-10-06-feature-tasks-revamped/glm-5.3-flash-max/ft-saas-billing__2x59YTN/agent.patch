diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..ef42f26
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "belongs to an account and defaults to Free" do
+    subscription = @account.create_subscription!
+
+    assert_equal @account, subscription.account
+    assert_equal Plan::FREE, subscription.plan
+    assert_equal Plan::FREE.key, subscription.plan_key
+  end
+
+  test "active? follows the statuses Stripe reports" do
+    assert Account::Subscription.new(status: "active").active?
+    assert Account::Subscription.new(status: "trialing").active?
+    assert_not Account::Subscription.new(status: "canceled").active?
+    assert_not Account::Subscription.new(status: nil).active?
+  end
+
+  test "active scope finds only the subscriptions in force" do
+    active = @account.create_subscription! plan: Plan::UNLIMITED, status: "active"
+    canceled = accounts(:acme).create_subscription! plan: Plan::UNLIMITED, status: "canceled"
+
+    assert_equal [ active ], Account::Subscription.active.to_a
+    assert_not_includes Account::Subscription.active.to_a, canceled
+  end
+
+  test "assigning a plan records its key" do
+    subscription = @account.create_subscription!
+
+    subscription.update! plan: Plan::UNLIMITED_PLUS
+
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal Plan::UNLIMITED_PLUS, subscription.reload.plan
+  end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..6f76914
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "Free includes 1,000 cards and 1 GB" do
+    assert_equal 1_000, Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Plan::FREE.storage_limit
+    assert_equal 0, Plan::FREE.monthly_price_in_cents
+    assert Plan::FREE.free?
+  end
+
+  test "Unlimited is $20 a month for 5 GB and unlimited cards" do
+    assert_equal "Unlimited", Plan::UNLIMITED.name
+    assert_equal 20_00, Plan::UNLIMITED.monthly_price_in_cents
+    assert_equal 5.gigabytes, Plan::UNLIMITED.storage_limit
+    assert_nil Plan::UNLIMITED.card_limit
+    assert Plan::UNLIMITED.paid?
+  end
+
+  test "Unlimited+ is $25 a month for 500 GB and unlimited cards" do
+    assert_equal "Unlimited+", Plan::UNLIMITED_PLUS.name
+    assert_equal 25_00, Plan::UNLIMITED_PLUS.monthly_price_in_cents
+    assert_equal 500.gigabytes, Plan::UNLIMITED_PLUS.storage_limit
+    assert_nil Plan::UNLIMITED_PLUS.card_limit
+    assert Plan::UNLIMITED_PLUS.paid?
+  end
+
+  test "find by key" do
+    Plan::ALL.each do |plan|
+      assert_equal plan, Plan.find(plan.key)
+    end
+
+    assert_nil Plan.find("nope")
+    assert_nil Plan.find(nil)
+  end
+
+  test "find by stripe price id matches the configured price" do
+    Plan::PAID.each do |plan|
+      env_var = Plan::STRIPE_PRICE_ID_ENV_VARS.fetch(plan.key)
+      ENV[env_var] = "price_#{plan.key}"
+
+      assert_equal plan, Plan.find_by_stripe_price_id("price_#{plan.key}")
+    end
+  ensure
+    Plan::PAID.each do |plan|
+      ENV[Plan::STRIPE_PRICE_ID_ENV_VARS.fetch(plan.key)] = nil
+    end
+  end
+
+  test "find by stripe price id ignores unknown prices" do
+    assert_nil Plan.find_by_stripe_price_id("price_unknown")
+  end
+
+  test "plans render as their name" do
+    assert_equal "Free", Plan.free.to_s
+    assert_equal "Unlimited+", Plan::UNLIMITED_PLUS.to_s
+  end
+end
