+        <div class="flex justify-space-between align-center gap full-width">
+          <div class="txt-align-start">
+            <strong><%= plan %></strong>
+            <div class="txt-x-small txt-ink-medium">
+              <% if plan.cards_unlimited? %>
+                Unlimited cards,
+              <% else %>
+                <%= number_with_delimiter(plan.card_limit) %> cards,
+              <% end %>
+              <%= number_to_human_size(plan.storage_limit) %> of storage —
+              <%= number_to_currency(plan.monthly_price) %>/month
+            </div>
+          </div>
+
+          <%= button_to "Upgrade", saas.account_billing_checkout_path, params: { plan_key: plan.key }, class: "btn" %>
+        </div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
