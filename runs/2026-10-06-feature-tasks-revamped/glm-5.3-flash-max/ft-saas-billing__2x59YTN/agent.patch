@@ -0,0 +1,26 @@
+# Support's override of what an account is allowed to use, for when the numbers
+# the plan grants aren't the numbers we promised the customer.
+class Admin::Accounts::OverridesController < AdminController
+  layout "public"
+
+  def update
+    account.override_limits **override_params
+
+    redirect_to saas.admin_account_path(account)
+  end
+
+  def destroy
+    account.reset_limits
+
+    redirect_to saas.admin_account_path(account)
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:account_id])
+    end
+
+    def override_params
+      params.expect(override: %i[ card_count bytes_used ]).to_h.symbolize_keys
+    end
+end
