+# The billing routes belong to the Fizzy::Saas engine, which the host app mounts
+# at the root. Linking to them from the host app's own views therefore means
+# spelling out which account the request is for, since the slug those URLs are
+# prefixed with doesn't come along for the ride.
+module BillingUrls
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :billing_path, :billing_portal_path
+  end
+
+  private
+    def billing_path
+      saas.account_billing_path(script_name: Current.account.slug)
+    end
+
+    def billing_portal_path
+      saas.account_billing_portal_path(script_name: Current.account.slug)
+    end
+end
