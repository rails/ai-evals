+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= link_to "Accounts", saas.admin_accounts_path %> / <%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">
+        #<%= @account.external_account_id %> •
+        <%= @account.users.owner.first&.identity&.email_address || "No admin" %>
+      </h2>
+    </header>
+
+    <dl class="flex flex-column gap-half">
+      <div class="flex justify-space-between">
+        <dt>Plan</dt>
+        <dd class="margin-none"><strong><%= @account.plan %></strong></dd>
+      </div>
+      <div class="flex justify-space-between">
+        <dt>Cards</dt>
+        <dd class="margin-none">
+          <%= number_with_delimiter(@account.cards_count) %> of
+          <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %>
+        </dd>
+      </div>
+      <div class="flex justify-space-between">
+        <dt>Storage</dt>
+        <dd class="margin-none">
+          <%= number_to_human_size(@account.bytes_used) %> of
+          <%= number_to_human_size(@account.storage_limit) %>
+        </dd>
+      </div>
+    </dl>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <% if @account.comped? %>
+      <p>This account is comped. It gets everything Unlimited includes, and isn’t billed for it.</p>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    <% else %>
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+      <div>Leave a field empty to keep whatever the plan grants.</div>
+    </header>
+
+    <%= form_with model: @overridden_limit, url: saas.admin_account_override_path(@account),
+          method: :patch, scope: :override, class: "flex flex-column gap" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count %>
+        <%= form.number_field :card_count, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used %>
+        <%= form.number_field :bytes_used, min: 0, class: "input" %>
+      </div>
+
+      <div class="flex gap">
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_override_path(@account), method: :delete, class: "btn btn--plain" %>
+  </div>
+</section>
