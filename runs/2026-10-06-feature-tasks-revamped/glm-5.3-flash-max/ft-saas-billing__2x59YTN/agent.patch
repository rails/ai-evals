+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Current plan</h2>
+    </header>
+
+    <p class="txt-large margin-block-none"><strong><%= Current.account.plan %></strong></p>
+
+    <p class="txt-align-start margin-block-end">
+      <% if Current.account.plan.cards_unlimited? %>
+        Unlimited cards, and <%= number_to_human_size(Current.account.storage_limit) %> of storage.
+      <% else %>
+        <%= number_with_delimiter(Current.account.plan.card_limit) %> cards, and
+        <%= number_to_human_size(Current.account.storage_limit) %> of storage.
+      <% end %>
+    </p>
+
+    <% if Current.account.plan.free? %>
+      <p class="txt-align-start">
+        You’ve used <strong><%= number_with_delimiter(Current.account.cards_count) %></strong> cards
+        and <strong><%= number_to_human_size(Current.account.bytes_used) %></strong> of storage.
+      </p>
