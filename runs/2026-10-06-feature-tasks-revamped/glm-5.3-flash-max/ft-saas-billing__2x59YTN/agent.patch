diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..77b37f8
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,94 @@
+# Stripe posts subscription changes here. Everything else about billing happens
+# on Stripe's side: checkout, the customer portal, and the payments themselves.
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  skip_forgery_protection
+
+  def create
+    handle Stripe::Webhook.construct_event(
+      request.raw_post, request.env["HTTP_STRIPE_SIGNATURE"], ENV["STRIPE_WEBHOOK_SECRET"]
+    )
+
+    head :no_content
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def handle(event)
+      case event.type
+      when "checkout.session.completed"    then complete_checkout(event.data.object)
+      when "customer.subscription.updated" then refresh_subscription(event.data.object)
+      when "customer.subscription.deleted" then cancel_subscription(event.data.object)
+      end
+    end
+
+    def complete_checkout(session)
+      # A checkout session for something other than a subscription has nothing
+      # to tell us about what the account is allowed to use.
+      return unless subscription_id = session[:subscription]
+
+      if subscription = account_subscription_for(session, stripe_subscription_id: subscription_id)
+        subscription.update! \
+          stripe_customer_id: session[:customer],
+          stripe_subscription_id: subscription_id,
+          plan: Plan.find(session[:metadata]&.plan_key) || Plan.free,
+          status: "active"
+      end
+    end
+
+    def refresh_subscription(subscription)
+      if account_subscription = account_subscription_for(subscription)
+        account_subscription.update! \
+          stripe_subscription_id: subscription.id,
+          plan: plan_for(subscription),
+          status: subscription.status,
+          current_period_end: period_end_for(subscription),
+          cancel_at: timestamp(subscription[:cancel_at])
+      end
+    end
+
+    # A canceled subscription keeps the plan it was on for the record, but since
+    # it is no longer active the account is back on Free.
+    def cancel_subscription(subscription)
+      if account_subscription = account_subscription_for(subscription)
+        account_subscription.update! status: subscription.status
+      end
+    end
+
+    # We put the account on the session and on the subscription as metadata when
+    # we sent the customer over, so Stripe can hand it straight back. Failing
+    # that, we recognise the customer or the subscription we already know about.
+    def account_subscription_for(object, stripe_subscription_id: object.id)
+      subscription_for_account(object) \
+        || Account::Subscription.find_by(stripe_customer_id: object[:customer]) \
+        || Account::Subscription.find_by(stripe_subscription_id: stripe_subscription_id)
+    end
+
+    def subscription_for_account(object)
+      if external_account_id = object[:metadata]&.account_external_id
+        Account.find_by(external_account_id: external_account_id)&.subscription
+      end
+    end
+
+    def plan_for(subscription)
+      Plan.find_by_stripe_price_id(price_id_for(subscription)) || Plan.free
+    end
+
+    # Stripe leaves a field off the payload when it doesn't apply, so we read
+    # through [] rather than assume any of them are there.
+    def price_id_for(subscription)
+      subscription[:items]&.data&.first&.price&.id
+    end
+
+    def period_end_for(subscription)
+      timestamp(subscription[:current_period_end]) \
+        || timestamp(subscription[:items]&.data&.first&.current_period_end)
+    end
+
+    def timestamp(seconds)
+      Time.at(seconds) if seconds
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..026a2a5
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,89 @@
+# Everything an account gets because of what it pays for: the plan it's on, the
+# allowances that come with it, and the support-only overrides that bend them.
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  # A free account starts counting down this many cards before it runs out.
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  # Comped accounts ride along for free on Unlimited. Everyone else is on their
+  # plan for as long as Stripe says the subscription is good, and falls back to
+  # Free the moment it isn't.
+  def plan
+    if comped?
+      Plan::UNLIMITED
+    elsif subscription&.active?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def comped?
+    subscription&.comped? || false
+  end
+
+  def comped=(value)
+    account_subscription.update! comped: value
+  end
+
+  # What the account is allowed to use. A support override wins over whatever
+  # the plan grants, and a missing override means "bill them by the book".
+  def card_limit
+    overridden_limit&.card_count || plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit && card_limit - cards_count
+  end
+
+  # Drafting is always allowed, so an account can only get here by drafting its
+  # way past the allowance. Publishing and API creation are what get refused.
+  def exceeding_card_limit?
+    if remaining = cards_remaining
+      remaining <= 0
+    end
+  end
+
+  def nearing_card_limit?
+    if remaining = cards_remaining
+      remaining <= CARD_LIMIT_WARNING_THRESHOLD && remaining.positive?
+    end
+  end
+
+  # Support can put numbers on an account that the plan doesn't grant. Both are
+  # optional: override one, the other, or both.
+  def override_limits(card_count:, bytes_used:)
+    if overridden_limit
+      overridden_limit.update! card_count: card_count, bytes_used: bytes_used
+    else
+      create_overridden_limit! card_count: card_count, bytes_used: bytes_used
+    end
+  end
+
+  def reset_limits
+    overridden_limit&.destroy
+    reset_overridden_limit
+  end
+
+  # The subscription that's actually in force, if there is one.
+  def active_subscription
+    subscription if subscription&.active? || comped?
+  end
+
+  private
+    # Free accounts don't get a subscription row until something needs one, so
+    # that a brand new account has nothing to pay for on record.
+    def account_subscription
+      if subscription.nil? || subscription.destroyed?
+        create_subscription!(plan: Plan.free)
+      else
+        subscription
+      end
+    end
+end
