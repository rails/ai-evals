+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription! plan: Plan::FREE
+  end
+
+  test "a completed checkout activates the plan the customer picked" do
+    post_webhook "checkout.session.completed",
+      id: "cs_123",
+      object: "checkout.session",
+      customer: "cus_123",
+      subscription: "sub_123",
+      metadata: {
+        account_external_id: @account.external_account_id.to_s,
+        plan_key: "unlimited"
+      }
+
+    assert_response :no_content
+
+    @subscription.reload
+    assert_equal "cus_123", @subscription.stripe_customer_id
+    assert_equal "sub_123", @subscription.stripe_subscription_id
+    assert_equal Plan::UNLIMITED, @subscription.plan
+    assert @subscription.active?
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+  end
+
+  test "a completed checkout for a plan we don't know leaves the account on Free" do
+    post_webhook "checkout.session.completed",
+      id: "cs_123",
+      object: "checkout.session",
+      customer: "cus_123",
+      subscription: "sub_123",
+      metadata: { account_external_id: @account.external_account_id.to_s, plan_key: "bogus" }
+
+    assert_response :no_content
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "a subscription update records the plan Stripe billed through" do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+
+    post_webhook "customer.subscription.updated",
+      id: "sub_123",
+      object: "subscription",
+      customer: "cus_123",
+      status: "active",
+      metadata: { account_external_id: @account.external_account_id.to_s },
+      current_period_end: 30.days.from_now.to_i,
+      cancel_at: nil,
+      items: {
+        object: "list",
+        data: [ { object: "subscription_item", price: { object: "price", id: "price_unlimited" } } ]
+      }
+
+    assert_response :no_content
+
+    @subscription.reload
+    assert_equal Plan::UNLIMITED, @subscription.plan
+    assert_equal "active", @subscription.status
+    assert_equal 30.days.from_now.change(usec: 0).to_i, @subscription.current_period_end.to_i
+    assert_nil @subscription.cancel_at
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = nil
+  end
+
+  test "a subscription update without a price we know leaves the account on Free" do
+    post_webhook "customer.subscription.updated",
+      id: "sub_123",
+      object: "subscription",
+      customer: "cus_123",
+      status: "active",
+      items: {
+        object: "list",
+        data: [ { object: "subscription_item", price: { object: "price", id: "price_unknown" } } ]
+      }
+
+    assert_response :no_content
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "a canceled subscription drops the account back to Free" do
+    @subscription.update! plan: Plan::UNLIMITED, status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123"
+
+    post_webhook "customer.subscription.deleted",
+      id: "sub_123",
+      object: "subscription",
+      customer: "cus_123",
+      status: "canceled"
+
+    assert_response :no_content
+
+    @subscription.reload
+    assert_equal "canceled", @subscription.status
+    assert_equal Plan::UNLIMITED, @subscription.plan
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "a subscription we only know by its customer is still updated" do
+    @subscription.update! stripe_customer_id: "cus_123"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus"
+
+    post_webhook "customer.subscription.updated",
+      id: "sub_123",
+      object: "subscription",
+      customer: "cus_123",
+      status: "active",
+      items: {
+        object: "list",
+        data: [ { object: "subscription_item", price: { object: "price", id: "price_unlimited_plus" } } ]
+      }
+
+    assert_response :no_content
+    assert_equal Plan::UNLIMITED_PLUS, @subscription.reload.plan
+  ensure
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = nil
+  end
+
+  test "a checkout that wasn't for a subscription changes nothing" do
+    post_webhook "checkout.session.completed",
+      id: "cs_123",
+      object: "checkout.session",
+      customer: "cus_123",
+      metadata: { account_external_id: @account.external_account_id.to_s, plan_key: "unlimited" }
+
+    assert_response :no_content
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_nil @subscription.reload.stripe_customer_id
+  end
+
+  test "events we don't handle are acknowledged and ignored" do
+    assert_no_difference -> { Account::Subscription.count } do
+      post_webhook "invoice.paid", id: "in_123", object: "invoice"
+    end
+
+    assert_response :no_content
+  end
+
+  test "a payload that isn't signed by Stripe is refused" do
+    post "/stripe/webhooks",
+      env: { "HTTP_STRIPE_SIGNATURE" => "t=#{Time.now.to_i},v1=not-stripe" },
+      params: event_payload("checkout.session.completed", id: "cs_123").to_json,
+      headers: { "Content-Type" => "application/json" }
+
+    assert_response :bad_request
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "a payload that isn't JSON is refused" do
+    post "/stripe/webhooks",
+      env: { "HTTP_STRIPE_SIGNATURE" => signature_for("not json") },
+      params: "not json",
+      headers: { "Content-Type" => "application/json" }
+
+    assert_response :bad_request
+  end
+
+  test "webhooks need no account and no session" do
+    post_webhook "invoice.paid", id: "in_123", object: "invoice"
+
+    assert_response :no_content
+  end
+
+  private
+    def post_webhook(type, object)
+      post "/stripe/webhooks",
+        env: { "HTTP_STRIPE_SIGNATURE" => signature_for(payload = event_payload(type, object).to_json) },
+        params: payload,
+        headers: { "Content-Type" => "application/json" }
+    end
+
+    def event_payload(type, object)
+      {
+        id: "evt_123",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }
+    end
+
+    def signature_for(payload)
+      timestamp = Time.now
+
+      Stripe::Webhook::Signature.generate_header(
+        timestamp,
+        Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV["STRIPE_WEBHOOK_SECRET"])
+      )
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..2563220
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "an account with nothing on file is on the Free plan" do
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.comped?
+  end
+
+  test "the Free plan allows 1,000 cards and 1 GB" do
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "an active subscription puts the account on its plan" do
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "active"
+
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "a subscription Stripe no longer considers active drops the account back to Free" do
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "canceled"
+
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping rides the account along on Unlimited" do
+    @account.comped = true
+
+    assert @account.reload.comped?
+    assert_equal Plan::UNLIMITED, @account.plan
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.active_subscription
+  end
+
+  test "uncomping drops the account back to the plan on file" do
+    @account.comped = true
+    @account.comped = false
+
+    assert_not @account.reload.comped?
+    assert_equal Plan::FREE, @account.plan
+    assert_nil @account.active_subscription
+  end
+
+  test "counting down starts 100 cards out" do
+    @account.update_column :cards_count, 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "the account runs out of cards at the limit" do
+    @account.update_column :cards_count, 999
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column :cards_count, 1_000
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "drafting past the limit keeps the account out of cards" do
+    @account.update_column :cards_count, 1_001
+
+    assert @account.exceeding_card_limit?
+    assert_equal(-1, @account.cards_remaining)
+  end
+
+  test "an override raises whatever it names" do
+    @account.override_limits card_count: 5_000, bytes_used: 10.gigabytes
+
+    assert_equal 5_000, @account.card_limit
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "an override only changes what it names" do
+    @account.override_limits card_count: 5_000, bytes_used: nil
+
+    assert_equal 5_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "updating an override replaces it" do
+    @account.override_limits card_count: 5_000, bytes_used: nil
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits card_count: 6_000, bytes_used: 2.gigabytes
+    end
+
+    assert_equal 6_000, @account.reload.card_limit
+    assert_equal 2.gigabytes, @account.storage_limit
+  end
+
+  test "resetting drops the override" do
+    @account.override_limits card_count: 5_000, bytes_used: 10.gigabytes
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      @account.reset_limits
+    end
+
+    assert_equal 1_000, @account.reload.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "resetting without an override is a no-op" do
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.reset_limits
+    end
+  end
+
+  test "the override wins over a comped plan" do
+    @account.comped = true
+    @account.override_limits card_count: 12, bytes_used: nil
+
+    assert_equal 12, @account.card_limit
+  end
+
+  test "destroying an account stops Stripe billing for it" do
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123"
+
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+
+    @account.destroy
+  end
+
+  test "destroying an account without a subscription never calls Stripe" do
+    Stripe::Subscription.expects(:cancel).never
+
+    @account.destroy
+  end
+end
