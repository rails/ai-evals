diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..5416b91
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "reports the plan the account is on" do
+    sign_in_as :mike
+
+    get saas.account_billing_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "p strong", text: "Free"
+  end
+
+  test "a free account is offered both paid plans" do
+    sign_in_as :mike
+
+    get saas.account_billing_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "strong", text: "Unlimited+"
+    assert_select "form button", text: "Upgrade", minimum: 2
+    assert_select "form button", text: "Manage billing", count: 0
+  end
+
+  test "a paid account is offered the customer portal instead" do
+    sign_in_as :mike
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "active",
+      stripe_customer_id: "cus_123"
+
+    get saas.account_billing_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "p strong", text: "Unlimited"
+    assert_select "form button", text: "Manage billing"
+    assert_select "form button", text: "Upgrade", count: 0
+  end
+
+  test "upgrading hands the customer over to Stripe's hosted checkout" do
+    sign_in_as :mike
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+
+    Stripe::Checkout::Session.stubs(:create).with do |attributes|
+      attributes[:mode] == "subscription" &&
+        attributes[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        attributes[:metadata][:account_external_id] == @account.external_account_id.to_s &&
+        attributes[:metadata][:plan_key] == "unlimited" &&
+        attributes[:customer_email] == identities(:mike).email_address
+    end.returns Stripe::Checkout::Session.construct_from(
+      id: "cs_123", url: "https://checkout.stripe.com/c/pay/cs_123"
+    )
+
+    assert_no_difference -> { Account::Subscription.count } do
+      post saas.account_billing_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited" }
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_123", allow_other_host: true
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = nil
+  end
+
+  test "an account Stripe already knows is checked out as that customer" do
+    sign_in_as :mike
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "canceled",
+      stripe_customer_id: "cus_123"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus"
+
+    Stripe::Checkout::Session.stubs(:create).with do |attributes|
+      attributes[:customer] == "cus_123" &&
+        attributes[:line_items] == [ { price: "price_unlimited_plus", quantity: 1 } ]
+    end.returns Stripe::Checkout::Session.construct_from(
+      id: "cs_456", url: "https://checkout.stripe.com/c/pay/cs_456"
+    )
+
+    post saas.account_billing_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited_plus" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_456", allow_other_host: true
+  ensure
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = nil
+  end
+
+  test "an unknown plan falls back to Unlimited" do
+    sign_in_as :mike
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+
+    Stripe::Checkout::Session.stubs(:create).with do |attributes|
+      attributes[:line_items] == [ { price: "price_unlimited", quantity: 1 } ]
+    end.returns Stripe::Checkout::Session.construct_from(
+      id: "cs_789", url: "https://checkout.stripe.com/c/pay/cs_789"
+    )
+
+    post saas.account_billing_checkout_path(script_name: @account.slug), params: { plan_key: "nonsense" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_789", allow_other_host: true
+  ensure
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = nil
+  end
+
+  test "managing billing hands the customer over to Stripe's customer portal" do
+    sign_in_as :mike
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "active",
+      stripe_customer_id: "cus_123"
+
+    Stripe::BillingPortal::Session.stubs(:create).with do |attributes|
+      attributes[:customer] == "cus_123" && attributes[:return_url].present?
+    end.returns Stripe::BillingPortal::Session.construct_from(
+      id: "bps_123", url: "https://billing.stripe.com/session/bps_123"
+    )
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/session/bps_123", allow_other_host: true
+  end
+
+  test "an account Stripe doesn't know has nothing to manage" do
+    sign_in_as :mike
+
+    post saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to saas.account_billing_path(script_name: @account.slug)
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..ba35814
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list the accounts" do
+    sign_in_as :david
+
+    untenanted { get saas.admin_accounts_path }
+
+    assert_response :success
+    assert_select "a", text: @account.name
+  end
+
+  test "non-staff cannot list the accounts" do
+    sign_in_as :jz
+
+    untenanted { get saas.admin_accounts_path }
+
+    assert_response :forbidden
+  end
+
+  test "each account name opens its page" do
+    sign_in_as :david
+
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "h1", text: /#{@account.name}/
+  end
+
+  test "the account page reports the plan, the cards and the storage" do
+    sign_in_as :david
+
+    @account.create_subscription! plan: Plan::UNLIMITED, status: "active"
+
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "dd", text: /Unlimited/
+    assert_select "dd", text: /5 GB/
+  end
+
+  test "the account page offers to comp and to uncomp" do
+    sign_in_as :david
+
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "form button", text: "Comp"
+
+    @account.comped = true
+    @account.reload
+
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "form button", text: "Uncomp"
+  end
+
+  test "the account page offers to override and to reset" do
+    sign_in_as :david
+
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "form label", text: "Card count"
+    assert_select "form label", text: "Bytes used"
+    assert_select "form input[type='submit'][value='Override']"
+    assert_select "form button", text: "Reset"
+  end
+
+  test "comping puts the account on Unlimited" do
+    sign_in_as :david
+
+    assert_difference -> { Account::Subscription.count } do
+      untenanted { post saas.admin_account_comp_path(@account) }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert @account.comped?
+  end
+
+  test "uncomping puts the account back on the plan it pays for" do
+    sign_in_as :david
+    @account.comped = true
+
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted { delete saas.admin_account_comp_path(@account) }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_not @account.reload.comped?
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "overriding the limits changes what the account is allowed" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_override_path(@account),
+        params: { override: { card_count: 5_000, bytes_used: 10.gigabytes } }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_equal 5_000, @account.reload.card_limit
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "overriding with blank fields keeps what the plan grants" do
+    sign_in_as :david
+
+    untenanted do
+      patch saas.admin_account_override_path(@account),
+        params: { override: { card_count: "", bytes_used: "" } }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_equal 1_000, @account.reload.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "resetting drops the override" do
+    sign_in_as :david
+    @account.override_limits card_count: 5_000, bytes_used: 10.gigabytes
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      untenanted { delete saas.admin_account_override_path(@account) }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_equal 1_000, @account.reload.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "non-staff cannot comp an account" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_comp_path(@account) }
+
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+  end
+end
