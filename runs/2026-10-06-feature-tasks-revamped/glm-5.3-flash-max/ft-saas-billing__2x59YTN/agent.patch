diff --git a/saas/app/controllers/account/billing/checkouts_controller.rb b/saas/app/controllers/account/billing/checkouts_controller.rb
new file mode 100644
index 0000000..139f98f
--- /dev/null
+++ b/saas/app/controllers/account/billing/checkouts_controller.rb
@@ -0,0 +1,44 @@
+# Hands the customer over to Stripe's hosted checkout for the plan they picked.
+class Account::Billing::CheckoutsController < ApplicationController
+  def create
+    session = Stripe::Checkout::Session.create checkout_attributes
+
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  end
+
+  private
+    def checkout_attributes
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.external_account_id.to_s,
+        metadata: metadata,
+        subscription_data: { metadata: metadata },
+        success_url: saas.account_billing_url,
+        cancel_url: saas.account_billing_url
+      }.merge customer_attributes
+    end
+
+    # Reusing the customer we already billed keeps their payment methods and
+    # their invoices in one place; a first-time customer gets created by Stripe.
+    def customer_attributes
+      if stripe_customer_id = Current.account.subscription&.stripe_customer_id
+        { customer: stripe_customer_id }
+      else
+        { customer_email: Current.identity.email_address }
+      end
+    end
+
+    # Checkout doesn't tell us what was bought beyond a session, so we carry the
+    # account and the plan along and read them back off the webhook.
+    def metadata
+      {
+        account_external_id: Current.account.external_account_id.to_s,
+        plan_key: plan.key
+      }
+    end
+
+    def plan
+      @plan ||= Plan.find(params[:plan_key]) || Plan::UNLIMITED
+    end
+end
