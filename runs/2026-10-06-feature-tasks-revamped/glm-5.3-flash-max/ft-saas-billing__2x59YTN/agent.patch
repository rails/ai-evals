+# Hands the customer over to Stripe's hosted customer portal, where they can
+# change plans, update their payment method, and cancel.
+class Account::Billing::PortalsController < ApplicationController
+  def create
+    if customer = Current.account.subscription&.stripe_customer_id
+      session = Stripe::BillingPortal::Session.create \
+        customer: customer, return_url: saas.account_billing_url
+
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    else
+      redirect_to saas.account_billing_path, alert: "There is no billing to manage yet."
+    end
+  end
+end
