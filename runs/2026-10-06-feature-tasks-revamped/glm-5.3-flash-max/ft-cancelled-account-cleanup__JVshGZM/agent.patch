diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..2a0ccaa 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,127 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
+  # How long after cancellation an account and its data are kept around before being incinerated.
   INCINERATION_GRACE_PERIOD = 30.days
+
+  # Join tables linking filters to the resources they filter. They carry no account_id, so they
+  # are cleaned up through the filters of the account being incinerated.
+  FILTER_JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  # Every model that keeps records for an account, ordered so that children are removed before
+  # their parents and attachments after the records they are attached to. Anything missing from
+  # this list would leave orphaned data behind.
+  INCINERATED_MODELS = [
+    ::Account::JoinCode,
+    ::Account::Cancellation,
+    ::Account::Export,
+    ::Account::Import,
+    ::Webhook::Delivery,
+    ::Webhook::DelinquencyTracker,
+    ::Webhook,
+    ::Notification,
+    ::Notification::Bundle,
+    ::Mention,
+    ::Reaction,
+    ::Watch,
+    ::Pin,
+    ::Tagging,
+    ::Assignment,
+    ::Step,
+    ::Comment,
+    ::Closure,
+    ::Card::Goldness,
+    ::Card::NotNow,
+    ::Card::ActivitySpike,
+    ::Event,
+    ::Card,
+    ::Column,
+    ::Board::Publication,
+    ::Access,
+    ::Board,
+    ::Filter,
+    ::Tag,
+    ::User::Settings,
+    ::Entropy,
+    ::Search::Query,
+    ::Push::Subscription,
+    ::ActionText::RichText,
+    ::User
+  ].freeze
+
+  included do
+    scope :cancelled_before, ->(timestamp) { joins(:cancellation).where(account_cancellations: { created_at: ...timestamp }) }
+    scope :due_for_incineration, -> { cancelled_before(INCINERATION_GRACE_PERIOD.ago) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    if incineration_due?
+      incinerate_data
+      destroy!
+    end
+  end
+
+  def incineration_due?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+
+  private
+    def incinerate_data
+      board_ids = boards.ids
+
+      incinerate_filter_memberships
+
+      INCINERATED_MODELS.each do |model|
+        model.where(account_id: id).delete_all
+      end
+
+      incinerate_search_records
+      purge_attachments
+      incinerate_storage_records(board_ids)
+    end
+
+    # Filters are linked to the resources they filter through join tables without an account_id.
+    def incinerate_filter_memberships
+      connection = self.class.connection
+      filters = Filter.where(account_id: id).select(:id)
+
+      FILTER_JOIN_TABLES.each do |join_table|
+        connection.delete(<<~SQL.squish, "Account::Incineratable#incinerate_filter_memberships")
+          DELETE FROM #{connection.quote_table_name(join_table)}
+          WHERE filter_id IN (#{filters.to_sql})
+        SQL
+      end
+    end
+
+    # Destroyed rather than deleted so that the full-text index rows go away with them.
+    def incinerate_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+    end
+
+    def incinerate_storage_records(board_ids)
+      Storage::Entry.where(account_id: id).delete_all
+
+      Storage::Total.where(owner: self)
+        .or(Storage::Total.where(owner_type: "Board", owner_id: board_ids))
+        .delete_all
+    end
+
+    # Purged rather than deleted so that the files themselves are removed from storage too.
+    def purge_attachments
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
 end
