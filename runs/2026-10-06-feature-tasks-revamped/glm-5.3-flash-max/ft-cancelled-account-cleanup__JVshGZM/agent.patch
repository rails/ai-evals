diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..5b7b693
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    incinerate_account(@account)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_incinerated @account
+  end
+
+  test "incinerates everything the account ever stored" do
+    memberships_before = filter_membership_counts
+    blob = ActiveStorage::Blob.create_and_upload! \
+      io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    card = boards(:writebook).cards.create!(status: "published", creator: @user, title: "Put the moon on it", image: blob)
+    @user.filters.create! tag_ids: [ tags(:mobile).id ], board_ids: [ boards(:writebook).id ], assignee_ids: [ users(:jz).id ]
+
+    assert card.image.attached?
+    assert Search::Record.for(@account.id).where(account_id: @account.id).any?
+    assert Storage::Entry.where(account_id: @account.id).any?
+    memberships_with_filter = filter_membership_counts
+    assert_operator memberships_with_filter.values.sum, :>, memberships_before.values.sum,
+      "Expected filter memberships to be created"
+
+    incinerate_account(@account)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id), "Attached file should be purged"
+    assert Search::Record.for(@account.id).where(account_id: @account.id).none?
+    assert Storage::Entry.where(account_id: @account.id).none?
+    assert Storage::Total.where(owner_type: "Account", owner_id: @account.id).none?
+    assert Storage::Total.where(owner_type: "Board", owner_id: boards(:writebook).id).none?
+    assert_operator filter_membership_counts.values.sum, :<, memberships_with_filter.values.sum,
+      "Filter memberships should be incinerated"
+    assert_no_orphaned_filter_memberships
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert_data_kept @account
+  end
+
+  test "keeps accounts that were never cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_data_kept @account
+  end
+
+  test "keeps other accounts untouched" do
+    other_account = accounts(:initech)
+    incinerate_account(@account)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert other_account.reload
+    assert_data_kept other_account
+  end
+
+  private
+    def incinerate_account(account)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    end
+
+    def assert_incinerated(account)
+      assert_not account.class.exists?(account.id)
+
+      Account::Incineratable::INCINERATED_MODELS.each do |model|
+        assert model.where(account_id: account.id).none?,
+          "#{model} still has records for the incinerated account"
+      end
+
+      assert ActiveStorage::Attachment.where(account_id: account.id).none?
+      assert ActiveStorage::Blob.where(account_id: account.id).none?
+      assert ActiveStorage::VariantRecord.where(account_id: account.id).none?
+      assert Storage::Entry.where(account_id: account.id).none?
+      assert Search::Record.for(account.id).where(account_id: account.id).none?
+      assert_no_orphaned_filter_memberships
+    end
+
+    def assert_data_kept(account)
+      kept = Account::Incineratable::INCINERATED_MODELS.select { |model| model.where(account_id: account.id).any? }
+
+      assert kept.any?, "No data found to keep for #{account.name}"
+    end
+
+    def filter_membership_counts
+      Account::Incineratable::FILTER_JOIN_TABLES.index_with do |join_table|
+        Account.connection.select_value("SELECT count(*) FROM #{join_table}").to_i
+      end
+    end
+
+    def assert_no_orphaned_filter_memberships
+      Account::Incineratable::FILTER_JOIN_TABLES.each do |join_table|
+        assert_empty Account.connection.select_values(<<~SQL.squish), "#{join_table} has rows without a filter"
+          SELECT #{join_table}.filter_id FROM #{join_table}
+          LEFT JOIN filters ON filters.id = #{join_table}.filter_id
+          WHERE filters.id IS NULL
+        SQL
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..9c365f2
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration only includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "incineration_due?" do
+    assert_not @account.incineration_due?
+
+    @account.cancel(initiated_by: @user)
+
+    assert_not @account.incineration_due?
+
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second)
+
+    assert @account.incineration_due?
+  end
+
+  test "incinerate removes the account and all of its data" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_incinerated @account
+  end
+
+  test "incinerate does nothing before the grace period is over" do
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_data_kept @account
+  end
+
+  test "incinerate does nothing to an active account" do
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+    assert_data_kept @account
+  end
+
+  private
+    def assert_incinerated(account)
+      Account::Incineratable::INCINERATED_MODELS.each do |model|
+        assert model.where(account_id: account.id).none?,
+          "#{model} still has records for the incinerated account"
+      end
+
+      assert ActiveStorage::Attachment.where(account_id: account.id).none?
+      assert ActiveStorage::Blob.where(account_id: account.id).none?
+      assert Storage::Entry.where(account_id: account.id).none?
+      assert Search::Record.for(account.id).where(account_id: account.id).none?
+    end
+
+    def assert_data_kept(account)
+      kept = Account::Incineratable::INCINERATED_MODELS.select { |model| model.where(account_id: account.id).any? }
+
+      assert kept.any?, "No data found to keep for #{account.name}"
+    end
+end
