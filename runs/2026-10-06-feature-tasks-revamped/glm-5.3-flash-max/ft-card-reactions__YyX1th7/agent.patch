diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..c92194a
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,51 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :ensure_card_is_reactable, only: :create
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+    render "reactions/index", locals: { reactable: @card }
+  end
+
+  def new
+    render "reactions/new", locals: { reactable: @card }
+  end
+
+  def create
+    @reaction = @card.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream { render "reactions/create", locals: { reactable: @card.reload } }
+      format.json { render "reactions/show", locals: { reaction: @reaction }, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream { render "reactions/destroy", locals: { reaction: @reaction } }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_reactable
+      head :forbidden unless @card.reactable?
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..74ec0f4
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,27 @@
+module ReactionsHelper
+  # Reactions are either left on a card directly, or on one of the comments nested
+  # inside that card. These helpers route to the right resource in both cases.
+  def reactions_parents(reactable)
+    if reactable.is_a?(Comment)
+      [ reactable.card, reactable ]
+    else
+      [ reactable ]
+    end
+  end
+
+  def reactions_path_for(reactable)
+    polymorphic_path([ *reactions_parents(reactable), :reactions ])
+  end
+
+  def new_reaction_path_for(reactable)
+    new_polymorphic_path([ *reactions_parents(reactable), :reaction ])
+  end
+
+  def reaction_path_for(reaction)
+    polymorphic_path([ *reactions_parents(reaction.reactable), reaction ])
+  end
+
+  def reaction_url_for(reaction)
+    polymorphic_url([ *reactions_parents(reaction.reactable), reaction ])
+  end
+end
