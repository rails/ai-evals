diff --git a/app/models/notification/push.rb b/app/models/notification/push.rb
new file mode 100644
index 0000000..5352425
--- /dev/null
+++ b/app/models/notification/push.rb
@@ -0,0 +1,56 @@
+# A push says what the tray says and opens the card it's about.
+class Notification::Push
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def payload
+    {
+      title: title,
+      body: body,
+      tag: tag,
+      renotify: true,
+      data: { url: url }
+    }.compact
+  end
+
+  private
+    attr_reader :notification
+
+    delegate :card, :creator, :source, to: :notification
+
+    def title
+      case source
+      when Mention then "#{source.mentioner.first_name} @mentioned you"
+      when Event   then event_notification_title(source)
+      end
+    end
+
+    def body
+      case source
+      when Mention then source.source.mentionable_content.truncate(200)
+      when Event   then "#{creator.name}: #{event_notification_body(source).squish}"
+      end
+    end
+
+    # Browsers replace pushes that share a tag, so a busy card keeps a single push.
+    def tag
+      "notification-#{notification.id}"
+    end
+
+    def url
+      card_url(card, **card_url_options)
+    end
+
+    def card_url_options
+      base_url_options.merge(script_name: notification.account.slug)
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..3fda7f7
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,56 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def register(user:, endpoint:, p256dh_key:, auth_key:)
+      user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update! p256dh_key: p256dh_key, auth_key: auth_key
+      end
+    end
+
+    # Endpoints are URLs, so they're not safe to put in a path. They're base64url-encoded
+    # without padding to keep them a single, well-behaved path segment.
+    def encode_endpoint(endpoint)
+      Base64.urlsafe_encode64(endpoint, padding: false)
+    end
+
+    def decode_endpoint(encoded_endpoint)
+      Base64.urlsafe_decode64(encoded_endpoint)
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send \
+      message: Notification::Push.new(notification).payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      urgency: "high",
+      vapid: vapid
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The push service told us this browser is no longer subscribed, so we won't try again.
+    destroy
+  rescue WebPush::Error => error
+    # A busy or misconfigured push service isn't the user's problem: we keep the subscription
+    # and report it, since there's nothing to retry.
+    Rails.error.report(error, handled: true, context: { endpoint: endpoint })
+  end
+
+  private
+    def vapid
+      {
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key,
+        subject: vapid_subject
+      }
+    end
+
+    def vapid_subject
+      from_address = ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")
+      "mailto:#{from_address[URI::MailTo::EMAIL_REGEXP]&.to_s || "support@fizzy.do"}"
+    end
+end
