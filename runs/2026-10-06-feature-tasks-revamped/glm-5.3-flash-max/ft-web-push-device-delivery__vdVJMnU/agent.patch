diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..efbd3e6
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @endpoint = "https://push.example.com/send/abc123"
+  end
+
+  test "belongs to the user's account" do
+    subscription = PushSubscription.create!(user: @user, **subscription_params)
+
+    assert_equal @user.account, subscription.account
+  end
+
+  test "requires an endpoint and its keys" do
+    subscription = PushSubscription.new(user: @user)
+
+    assert_not subscription.valid?
+    assert_equal [ "Endpoint can't be blank", "P256dh key can't be blank", "Auth key can't be blank" ], subscription.errors.full_messages
+  end
+
+  test "endpoint is unique per user" do
+    PushSubscription.create!(user: @user, **subscription_params)
+
+    assert_raise(ActiveRecord::RecordInvalid) do
+      PushSubscription.create!(user: @user, **subscription_params)
+    end
+  end
+
+  test "register subscribes the endpoint for the user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      PushSubscription.register(user: @user, **subscription_params)
+    end
+
+    assert_equal @endpoint, @user.push_subscriptions.last.endpoint
+  end
+
+  test "register refreshes the keys of an already subscribed endpoint" do
+    PushSubscription.register(user: @user, **subscription_params)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      PushSubscription.register(user: @user, **subscription_params(p256dh_key: "new p256dh", auth_key: "new auth"))
+    end
+
+    assert_equal "new p256dh", @user.push_subscriptions.last.p256dh_key
+  end
+
+  test "register keeps endpoints of other users apart" do
+    PushSubscription.register(user: @user, **subscription_params)
+
+    assert_difference -> { users(:jz).push_subscriptions.count }, 1 do
+      PushSubscription.register(user: users(:jz), **subscription_params)
+    end
+  end
+
+  test "deliver posts the notification to the endpoint" do
+    subscription = PushSubscription.create!(user: @user, **subscription_params)
+
+    stub_request(:post, @endpoint).to_return(status: 201)
+
+    subscription.deliver(notifications(:logo_assignment_kevin))
+
+    assert_requested :post, @endpoint
+  end
+
+  test "deliver forgets a subscription the push service no longer knows" do
+    subscription = PushSubscription.create!(user: @user, **subscription_params)
+
+    stub_request(:post, @endpoint).to_return(status: 410)
+
+    subscription.deliver(notifications(:logo_assignment_kevin))
+
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  test "deliver forgets an invalid subscription" do
+    subscription = PushSubscription.create!(user: @user, **subscription_params)
+
+    stub_request(:post, @endpoint).to_return(status: 404)
+
+    subscription.deliver(notifications(:logo_assignment_kevin))
+
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  test "deliver keeps a subscription when the push service fails" do
+    subscription = PushSubscription.create!(user: @user, **subscription_params)
+
+    stub_request(:post, @endpoint).to_return(status: 500)
+
+    assert_nothing_raised do
+      subscription.deliver(notifications(:logo_assignment_kevin))
+    end
+
+    assert PushSubscription.exists?(subscription.id)
+  end
+
+  private
+    # The browser hands out a P-256 public key and an authentication secret, both
+    # base64url-encoded. We generate real ones here, since delivering uses them as keys.
+    def subscription_params(endpoint: @endpoint, p256dh_key: WebPush.generate_key.public_key, auth_key: WebPush.encode64(SecureRandom.random_bytes(16)))
+      { endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key }
+    end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..e0b6052
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,124 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    @vapid_public_key = WebPush.generate_key.public_key
+    sign_in_as @user
+  end
+
+  test "turning notifications on subscribes the device" do
+    with_push_notification_keys do
+      visit notifications_settings_url
+
+      assert_selector ".notifications__off-message", text: "Notifications are off for this device."
+
+      mock_push_api
+
+      find(".notifications__status label.switch").click
+
+      assert_selector ".notifications--on"
+      assert_selector ".notifications__on-message", text: "Notifications are on for this device."
+
+      subscription = @user.push_subscriptions.sole
+      assert_equal "https://push.example.com/abc123", subscription.endpoint
+      assert_equal "mock-p256dh", subscription.p256dh_key
+      assert_equal "mock-auth", subscription.auth_key
+    end
+  end
+
+  test "turning notifications off unsubscribes the device" do
+    with_push_notification_keys do
+      visit notifications_settings_url
+
+      mock_push_api
+
+      find(".notifications__status label.switch").click
+
+      assert_selector ".notifications--on"
+
+      find(".notifications__status label.switch").click
+
+      assert_no_selector ".notifications--on"
+      assert_selector ".notifications__off-message", text: "Notifications are off for this device."
+      assert_empty @user.push_subscriptions.reload
+    end
+  end
+
+  test "explains what to do when the browser blocks notifications" do
+    with_push_notification_keys do
+      visit notifications_settings_url
+
+      mock_push_api permission: "denied"
+
+      assert_selector ".notifications__off-message", text: "Notifications are off for this device."
+      assert_selector ".notifications-help", visible: true
+    end
+  end
+
+  test "stays off when the browser can't subscribe" do
+    with_push_notification_keys do
+      visit notifications_settings_url
+
+      mock_unsupported_push_api
+
+      assert_selector ".notifications__off-message", text: "Notifications are off for this device."
+      assert_no_selector ".notifications--on"
+      assert_no_selector ".notifications-help"
+      assert_selector "input[data-notifications-target=switch][disabled]", visible: false
+    end
+  end
+
+  private
+    def with_push_notification_keys
+      old_public_key, ENV["VAPID_PUBLIC_KEY"] = ENV["VAPID_PUBLIC_KEY"], @vapid_public_key
+      old_private_key, ENV["VAPID_PRIVATE_KEY"] = ENV["VAPID_PRIVATE_KEY"], @vapid_public_key.reverse
+
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public_key
+      ENV["VAPID_PRIVATE_KEY"] = old_private_key
+    end
+
+    # Chromium won't subscribe to a push service without a real one behind it, so we stand in
+    # for the browser and check what the app does with the subscription it's handed.
+    def mock_push_api(permission: "granted")
+      execute_script <<~JS
+        const subscription = {
+          endpoint: "https://push.example.com/abc123",
+          toJSON: () => ({ keys: { p256dh: "mock-p256dh", auth: "mock-auth" } }),
+          unsubscribe: async () => {
+            window.__pushSubscription = null
+            return true
+          }
+        }
+        const registration = {
+          pushManager: {
+            getSubscription: async () => window.__pushSubscription ?? null,
+            subscribe: async () => (window.__pushSubscription = subscription)
+          }
+        }
+
+        Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: { ready: Promise.resolve(registration) } })
+        Object.defineProperty(window, "Notification", { configurable: true, value: { permission: "#{permission}", requestPermission: async () => "granted" } })
+      JS
+
+      come_back_with_mocked_push_api
+    end
+
+    def mock_unsupported_push_api
+      execute_script <<~JS
+        Object.defineProperty(window, "PushManager", { configurable: true, value: undefined })
+        Object.defineProperty(window, "Notification", { configurable: true, value: undefined })
+      JS
+
+      come_back_with_mocked_push_api
+    end
+
+    # The controller only subscribes when it appears in the DOM, so we come back with the
+    # mocked push API in place.
+    def come_back_with_mocked_push_api
+      execute_script "Turbo.visit('#{notifications_settings_path}')"
+      assert_selector "h1", text: "Notification Settings"
+    end
+end
