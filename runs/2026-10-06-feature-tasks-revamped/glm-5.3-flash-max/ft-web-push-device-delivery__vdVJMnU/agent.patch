diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..8a012eb
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,38 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    PushSubscription.register(user: @user, **push_subscription_params)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications are on for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(endpoint: decoded_endpoint)&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications are off for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).to_h.symbolize_keys
+    end
+
+    def decoded_endpoint
+      PushSubscription.decode_endpoint(params[:endpoint])
+    rescue ArgumentError
+      # A subscription we can't decode isn't one of ours, so there's nothing to forget.
+      nil
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..e780c46
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+import { destroy, post } from "@rails/request.js"
+
+const ON_CLASS = "notifications--on"
+
+// Turns push notifications on for the device this browser runs on: it asks the browser for
+// permission, hands the subscription the push service handed out to the server, and keeps
+// the settings in sync with what the browser actually allows.
+export default class extends Controller {
+  static targets = [ "details", "switch" ]
+  static values = { supported: Boolean, url: String }
+
+  connect() {
+    // The help copy only matters when the browser blocks notifications, and we won't know
+    // until the browser told us its state.
+    this.#revealHelp(false)
+
+    this.#refresh()
+  }
+
+  toggle(event) {
+    event.target.checked ? this.#turnOn() : this.#turnOff()
+  }
+
+  #refresh() {
+    this.#subscription().then((subscription) => this.#render(subscription))
+  }
+
+  async #turnOn() {
+    let subscription = null
+
+    if (this.#supported) {
+      this.#busy(true)
+
+      try {
+        subscription = await this.#subscribe()
+
+        if (subscription) {
+          const { p256dh, auth } = subscription.toJSON().keys
+
+          await post(this.urlValue, {
+            responseKind: "json",
+            body: { push_subscription: { endpoint: subscription.endpoint, p256dh_key: p256dh, auth_key: auth } }
+          })
+        }
+      } catch (error) {
+        console.error("Could not turn on notifications", error)
+        await subscription?.unsubscribe()
+        subscription = null
+      } finally {
+        this.#busy(false)
+      }
+    }
+
+    this.#render(subscription)
+  }
+
+  async #turnOff() {
+    this.#busy(true)
+
+    try {
+      const subscription = await this.#subscription()
+
+      if (subscription) {
+        await subscription.unsubscribe()
+        await destroy(encodeEndpoint(this.urlValue, subscription.endpoint), { responseKind: "json" })
+      }
+    } catch (error) {
+      console.error("Could not turn off notifications", error)
+    } finally {
+      this.#busy(false)
+      this.#refresh()
+    }
+  }
+
+  #render(subscription) {
+    const on = !!subscription
+
+    this.element.classList.toggle(ON_CLASS, on)
+
+    this.switchTargets.forEach((switchTarget) => {
+      switchTarget.checked = on
+      switchTarget.disabled = !this.#supported
+    })
+
+    this.#revealHelp(this.#blocked)
+  }
+
+  #busy(busy) {
+    this.switchTargets.forEach((switchTarget) => { switchTarget.disabled = busy })
+  }
+
+  #revealHelp(reveal) {
+    this.detailsTargets.forEach((detailsTarget) => { detailsTarget.toggleAttribute("hidden", !reveal) })
+  }
+
+  get #blocked() {
+    return this.#supported && Notification.permission === "denied"
+  }
+
+  get #supported() {
+    return this.supportedValue &&
+      typeof Notification !== "undefined" &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      !!getMetaContent("vapid-public-key")
+  }
+
+  async #subscription() {
+    if (!this.#supported) return null
+
+    const registration = await navigator.serviceWorker.ready
+
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribe() {
+    if (await this.#askForPermission() !== "granted") return null
+
+    const registration = await navigator.serviceWorker.ready
+
+    try {
+      return await this.#subscribeOn(registration)
+    } catch (error) {
+      // A browser keeps a single subscription per service worker: when it was created with a
+      // different key than ours, we drop it and start over.
+      const subscription = await registration.pushManager.getSubscription()
+      await subscription?.unsubscribe()
+
+      return this.#subscribeOn(registration)
+    }
+  }
+
+  #subscribeOn(registration) {
+    return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: applicationServerKey() })
+  }
+
+  async #askForPermission() {
+    if (Notification.permission === "granted") return Notification.permission
+
+    try {
+      return await Notification.requestPermission()
+    } catch {
+      return "denied"
+    }
+  }
+}
+
+// The VAPID public key travels base64url-encoded in a meta tag, but the browser wants the
+// raw key bytes as the application server key.
+function applicationServerKey() {
+  const base64Key = getMetaContent("vapid-public-key")
+  const padding = "=".repeat((4 - base64Key.length % 4) % 4)
+  const base64 = (base64Key + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+  return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+}
+
+// Endpoints are URLs, so they aren't safe to put in a path as-is.
+function encodeEndpoint(url, endpoint) {
+  return `${url}/${btoa(endpoint).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")}`
+}
