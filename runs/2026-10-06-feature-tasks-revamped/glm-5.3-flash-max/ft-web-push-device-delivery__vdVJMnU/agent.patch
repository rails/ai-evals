+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+
+    @subscription_params = {
+      endpoint: "https://push.example.com/send/abc123",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    }
+  end
+
+  test "create subscribes the browser's push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+    end
+
+    assert_response :no_content
+
+    subscription = @user.push_subscriptions.last
+    assert_equal @subscription_params[:endpoint], subscription.endpoint
+    assert_equal @subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal @subscription_params[:auth_key], subscription.auth_key
+  end
+
+  test "create refreshes an existing subscription" do
+    PushSubscription.register(user: @user, **@subscription_params)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: @subscription_params.merge(p256dh_key: "new p256dh") }, as: :json
+    end
+
+    assert_equal "new p256dh", @user.push_subscriptions.last.p256dh_key
+  end
+
+  test "create refuses to subscribe someone else's device" do
+    assert_no_difference -> { users(:jz).push_subscriptions.count } do
+      post user_push_subscriptions_path(users(:jz)), params: { push_subscription: @subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy forgets the subscription of this browser" do
+    subscription = PushSubscription.register(user: @user, **@subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, PushSubscription.encode_endpoint(subscription.endpoint)), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy ignores unknown subscriptions" do
+    delete user_push_subscription_path(@user, PushSubscription.encode_endpoint("https://push.example.com/send/unknown")), as: :json
+
+    assert_response :no_content
+  end
+end
