diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..9d4d311 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,59 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications
+/* ------------------------------------------------------------------------ */
+
+self.addEventListener("push", (event) => {
+  event.waitUntil(showPushNotification(event))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.waitUntil(openPushNotification(event.notification))
+})
+
+async function showPushNotification(event) {
+  const push = event.data?.json() ?? {}
+
+  await self.registration.showNotification(push.title ?? "Fizzy", {
+    body: push.body,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192-maskable.png",
+    tag: push.tag,
+    renotify: push.renotify,
+    data: push.data
+  })
+}
+
+async function openPushNotification(notification) {
+  const url = new URL(notification.data?.url ?? "/", self.location.origin)
+
+  notification.close()
+
+  return focusOrOpen(url)
+}
+
+async function focusOrOpen(url) {
+  const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const existing = clients.find((client) => new URL(client.url).origin === url.origin)
+
+  if (existing) {
+    await navigate(existing, url)
+
+    return existing.focus()
+  }
+
+  return self.clients.openWindow(url.href)
+}
+
+async function navigate(client, url) {
+  if (client.url === url.href) return
+
+  try {
+    await client.navigate(url.href)
+  } catch (error) {
+    // The client refused to be navigated, so we leave it where it is.
+  }
+}
+
 TurboOffline.start()
