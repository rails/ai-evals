diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..4f6e973
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @admin = users("jason")
+    @member = users("david")
+    sign_in_as @admin
+  end
+
+  test "an admin starts an export of the whole account" do
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_jobs 1, only: ExportJob do
+        post account_exports_url
+      end
+    end
+
+    assert_redirected_to account_settings_url
+    assert_equal @admin, Export.last.user
+    assert_equal "account", Export.last.kind
+  end
+
+  test "a member cannot export the whole account" do
+    logout_and_sign_in_as @member
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "the account settings hold the export of the whole account" do
+    get account_settings_url
+
+    assert_match "Export account data", response.body
+  end
+
+  test "a member is pointed at the cards they can see instead" do
+    logout_and_sign_in_as @member
+
+    get account_settings_url
+
+    assert_match "Only admins can export the whole account", response.body
+    assert_match "Import an account file", response.body
+  end
+
+  test "the person who asked for the export can download it" do
+    export = Export.start_account_export(@admin)
+    perform_enqueued_jobs only: ExportJob
+
+    get account_export_url(export)
+
+    assert_response :success
+    assert_match %r{application/zip}, response.headers["Content-Type"]
+    assert_equal export.filename, response.headers["Content-Disposition"][/filename="([^"]+)"/, 1]
+    assert_equal export.file.download.bytesize, response.body.bytesize
+  end
+
+  test "someone else cannot download an export" do
+    export = Export.start_account_export(@admin)
+    perform_enqueued_jobs only: ExportJob
+
+    logout_and_sign_in_as @member
+    get account_export_url(export)
+
+    assert_response :forbidden
+  end
+
+  test "the download link stops working after a day" do
+    export = Export.start_account_export(@admin)
+    perform_enqueued_jobs only: ExportJob
+
+    travel 2.days do
+      get account_export_url(export)
+
+      assert_response :gone
+    end
+  end
+
+  test "the download link does not work before the export is done" do
+    export = Export.start_account_export(@admin)
+
+    get account_export_url(export)
+
+    assert_response :gone
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..1cf95d8
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @user = users("jason")
+    sign_in_as @user
+    @archive = write_account_file
+  end
+
+  teardown do
+    @archive&.close
+    @archive&.unlink
+  end
+
+  test "someone signed in sees how to bring an account file in" do
+    get new_account_import_url
+
+    assert_response :success
+    assert_match "Import an account file", response.body
+    assert_match "Upload a Fizzy account file", response.body
+  end
+
+  test "uploading an account file starts an import" do
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_jobs 1, only: ImportJob do
+        post account_imports_url, params: { file: account_file }
+      end
+    end
+
+    assert_redirected_to new_account_import_url
+    assert_equal "We're importing your account. We'll email you when it's ready.", flash[:notice]
+
+    import = Import.last
+
+    assert_equal @user, import.user
+    assert_equal @account, import.account
+    assert import.file.attached?
+  end
+
+  test "uploading without an account file does not start an import" do
+    assert_no_difference -> { Import.count } do
+      post account_imports_url, params: { file: "" }
+    end
+
+    assert_response :unprocessable_entity
+    assert_match "Import an account file", response.body
+  end
+
+  private
+    def write_account_file
+      export = Export.start_account_export(@user)
+      export.export_now
+
+      tempfile = Tempfile.new([ "account", ".zip" ])
+      tempfile.binmode
+      tempfile.write(export.file.download)
+      tempfile.rewind
+      tempfile
+    end
+
+    def account_file
+      Rack::Test::UploadedFile.new(@archive.path, "application/zip")
+    end
+end
