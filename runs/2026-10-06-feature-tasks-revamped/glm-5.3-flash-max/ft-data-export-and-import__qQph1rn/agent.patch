diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..0fc9f9d
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,70 @@
+class Export < ApplicationRecord
+  # How long the download link in the email keeps working.
+  EXPIRATION_TIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %i[ account cards ].index_by(&:itself), default: :account, validate: true
+  enum :status, %i[ pending completed failed ].index_by(&:itself), default: :pending, validate: true
+
+  scope :recent, -> { order(created_at: :desc, id: :desc) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  class << self
+    # Exports everything in the account, admins only.
+    def start_account_export(user)
+      start user, kind: :account
+    end
+
+    # Exports every card the user can see, with their comments and attachments.
+    def start_cards_export(user)
+      start user, kind: :cards
+    end
+
+    # Removes the exports whose download link stopped working, along with the
+    # archive they hold.
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+
+    private
+      def start(user, kind:)
+        user.account.exports.create!(user: user, kind: kind).tap(&:export_later)
+      end
+  end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    Account::DataTransfer::Exporter.new(self).export
+    update! status: :completed, expires_at: EXPIRATION_TIME.from_now
+    AccountMailer.export_ready(self).deliver_later
+  rescue => error
+    Rails.error.report(error, context: { export_id: id, account_id: account_id })
+    update! status: :failed
+    AccountMailer.export_failed(self).deliver_later
+    file.purge
+  end
+
+  def downloadable?
+    completed? && file.attached? && !expired?
+  end
+
+  def expired?
+    expires_at.present? && expires_at.past?
+  end
+
+  def filename
+    "#{account.name.parameterize}-#{kind}-#{created_at.to_fs(:number)}.zip"
+  end
+
+  # Lets Active Storage serve the archive to the person it belongs to.
+  def accessible_to?(user)
+    self.user == user
+  end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..36cf85e
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,57 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :result, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %i[ pending completed failed ].index_by(&:itself), default: :pending, validate: true
+
+  scope :recent, -> { order(created_at: :desc, id: :desc) }
+
+  validate :file_is_attached, on: :create
+  validate :user_has_an_identity, on: :create
+
+  class << self
+    def start(user, file)
+      # The file belongs to the account it is imported from, whatever context
+      # the upload happens in.
+      Current.with_account(user.account) do
+        user.account.imports.create!(user: user, file: file).tap(&:import_later)
+      end
+    end
+  end
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    file.open do |archive|
+      archive.binmode
+      self.result = Account::DataTransfer::Importer.new(archive, initiated_by: identity).import
+    end
+
+    update! status: :completed
+    AccountMailer.import_completed(self).deliver_later
+    file.purge
+  rescue => error
+    Rails.error.report(error, context: { import_id: id, account_id: account_id })
+    file.purge
+    AccountMailer.import_failed(identity, reason: error.message).deliver_later
+    destroy
+  end
+
+  def identity
+    user.identity
+  end
+
+  private
+    def file_is_attached
+      errors.add :file, "must be attached" unless file.attached?
+    end
+
+    def user_has_an_identity
+      errors.add :user, "does not have an identity to import an account for" unless identity
+    end
+end
