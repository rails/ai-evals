diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..17bb2d6
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,70 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  # Reads the structure of the archive upfront so that entries can be looked
+  # up by name. Their contents are only read on demand, streamed in chunks, so
+  # that archives of any size can be processed.
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def exists?(path)
+    entries.key?(path)
+  end
+
+  def glob(pattern)
+    entries.keys.select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def read(path)
+    content = +"".b
+    read_chunks(path) { |chunk| content << chunk }
+    content
+  end
+
+  # Streams the contents of an entry into the given IO without ever holding
+  # the whole of it in memory.
+  def copy(path, io)
+    read_chunks(path) { |chunk| io.write(chunk) }
+    io
+  end
+
+  # Reads an entry line by line, for archives holding one JSON document per
+  # line.
+  def each_line(path)
+    buffer = +"".b
+    read_chunks(path) do |chunk|
+      buffer << chunk
+      while (newline = buffer.index("\n"))
+        yield line_from(buffer.slice!(0..newline))
+      end
+    end
+
+    yield line_from(buffer) unless buffer.empty?
+  end
+
+  private
+    attr_reader :io, :entries
+
+    def line_from(buffer)
+      buffer.dup.force_encoding(Encoding::UTF_8)
+    end
+
+    def read_chunks(path)
+      extractor = entry_for(path).extractor_from(io)
+
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        break if chunk.nil? || chunk.empty?
+
+        yield chunk
+      end
+    end
+
+    def entry_for(path)
+      entries.fetch(path) do
+        raise ZipFile::MissingEntryError, "No entry named #{path.inspect} in the archive"
+      end
+    end
+end
