@@ -0,0 +1,152 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("jason")
+  end
+
+  test "importing an account file creates a new account with everything in it" do
+    export = export_account(@user)
+
+    assert_difference -> { Account.count }, 1 do
+      start_import(export.file.download)
+      perform_enqueued_jobs
+    end
+
+    @import.reload
+    new_account = @import.result
+
+    assert @import.completed?
+    assert_not_equal @account.id, new_account.id
+    assert_equal @account.name, new_account.name
+
+    assert_equal @account.boards.count, new_account.boards.count
+    assert_equal @account.cards.count, new_account.cards.count
+    assert_equal @account.users.count, new_account.users.count
+    assert_equal @account.cards.sum(&:number), new_account.cards.sum(&:number)
+    assert_equal comments_of(@account).count, comments_of(new_account).count
+
+    assert_equal users("jason"), new_account.users.owner.first.identity.users.find_by(account: @account)
+    assert new_account.users.owner.first.owner?
+    assert new_account.system_user.present?
+    assert new_account.join_code.present?
+    assert_not_equal @account.external_account_id, new_account.external_account_id
+  end
+
+  test "the imported account holds its pictures and files" do
+    card = cards("logo")
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    comment = comments("logo_agreement_jz")
+    comment.update!(body: "See #{attachment_tag_for("avatar.png")}")
+
+    export = export_account(@user)
+    start_import(export.file.download)
+    perform_enqueued_jobs
+
+    imported_card = @import.reload.result.cards.find_by(number: card.number)
+
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal card.image.download, imported_card.image.download
+
+    imported_comment = comments_of(@import.reload.result).find { it.body&.body&.attachables&.any? }
+    imported_blob = imported_comment.body.body.attachables.first
+
+    assert_equal "avatar.png", imported_blob.filename.to_s
+    assert_equal comment.body.body.attachables.first.download, imported_blob.download
+    assert_equal @import.result.id, imported_blob.account_id
+  end
+
+  test "the imported rich texts point at the attachments they were imported with" do
+    comment = comments("logo_agreement_jz")
+    comment.update!(body: "See #{attachment_tag_for("avatar.png")}")
+
+    export = export_account(@user)
+    start_import(export.file.download)
+    perform_enqueued_jobs
+
+    imported_comment = comments_of(@import.reload.result).find { it.body&.body&.attachables&.any? }
+
+    assert imported_comment.body.body.attachables.first.id !=
+      comment.body.body.attachables.first.id
+    assert ActiveStorage::Blob.where(account: @import.reload.result).none? { it.account_id != @import.result.id }
+  end
+
+  test "an import that cannot be completed leaves nothing behind" do
+    export = export_account(@user)
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import).raises(
+      Account::DataTransfer::Importer::Error, "The archive is broken"
+    )
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Board.count } do
+        assert_no_difference -> { Card.count } do
+          start_import(export.file.download)
+          perform_enqueued_jobs
+        end
+      end
+    end
+
+    assert_not Import.exists?(@import.id)
+  end
+
+  test "an import that cannot be completed is explained in an email" do
+    export = export_account(@user)
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import).raises(
+      Account::DataTransfer::Importer::Error, "The archive is broken"
+    )
+
+    perform_enqueued_jobs do
+      start_import(export.file.download)
+    end
+
+    email = ActionMailer::Base.deliveries.find { it.subject == "Your Fizzy account could not be imported" }
+
+    assert_not_nil email
+    assert_match "The archive is broken", email.body.encoded
+  end
+
+  test "an archive of exported cards is not an account file" do
+    export = Export.start_cards_export(users("david"))
+    export.export_now
+
+    assert_no_difference -> { Account.count } do
+      assert_raises Account::DataTransfer::Importer::Error do
+        Account::DataTransfer::Importer.new(archive_io(export.file.download), initiated_by: @user.identity).import
+      end
+    end
+  end
+
+  test "a file that is not an account file is refused" do
+    assert_raises ZipKit::FileReader::MissingEOCD, ZipFile::MissingEntryError do
+      Account::DataTransfer::Importer.new(archive_io("not a zip"), initiated_by: @user.identity)
+    end
+  end
+
+  private
+    def export_account(user)
+      Export.start_account_export(user).tap(&:export_now)
+    end
+
+    def start_import(content)
+      archive = { io: StringIO.new(content), filename: "account.zip", content_type: "application/zip" }
+
+      @import = Import.start(@user, archive)
+    end
+
+    def archive_io(content)
+      StringIO.new(content.b)
+    end
+
+    def comments_of(account)
+      Comment.where(card: account.cards)
+    end
+
+    def attachment_tag_for(filename)
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture(filename).open, filename: filename)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..4ef8ac1 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,67 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "reader finds entries" do
+    reader = reader_for do |writer|
+      writer.add_file("docs/readme.txt", "Readme")
+      writer.add_file("images/logo.png", "PNG data")
+    end
+
+    assert reader.exists?("docs/readme.txt")
+    assert_not reader.exists?("docs/missing.txt")
+    assert_equal [ "docs/readme.txt" ], reader.glob("docs/*.txt")
+    assert_equal [ "images/logo.png" ], reader.glob("**/*.png")
+  end
+
+  test "reader reads the contents of an entry" do
+    reader = reader_for { |writer| writer.add_file("hello.txt", "Hello, World!") }
+
+    assert_equal "Hello, World!", reader.read("hello.txt")
+  end
+
+  test "reader reads entries one line at a time" do
+    reader = reader_for do |writer|
+      writer.add_file("records.json") do |sink|
+        sink.write(%({"name": "Jason"}\n{"name": "David"}\n))
+      end
+    end
+
+    lines = []
+    reader.each_line("records.json") { |line| lines << line }
+
+    assert_equal [ %({"name": "Jason"}\n), %({"name": "David"}\n) ], lines
+  end
+
+  test "reader copies the contents of an entry into an IO" do
+    reader = reader_for do |writer|
+      writer.add_file("big.bin", "0123456789" * 1000)
+    end
+
+    copied = StringIO.new
+    reader.copy("big.bin", copied)
+
+    assert_equal "0123456789" * 1000, copied.string
+  end
+
+  test "reader refuses to read entries that are not in the archive" do
+    reader = reader_for { |writer| writer.add_file("hello.txt", "Hello") }
+
+    assert_raises ZipFile::MissingEntryError do
+      reader.read("missing.txt")
+    end
+  end
+
+  private
+    def reader_for
+      archive = StringIO.new
+
+      writer = ZipFile::Writer.new(archive)
+      yield writer
+      writer.close
+
+      archive.rewind
+      ZipFile::Reader.new(archive)
+    end
+end
