@@ -0,0 +1,152 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("jason")
+  end
+
+  test "starting an account export creates one and emails a link when it is ready" do
+    assert_enqueued_jobs 1, only: ExportJob do
+      export = Export.start_account_export(@user)
+
+      assert export.pending?
+      assert_equal @account, export.account
+      assert_equal @user, export.user
+      assert_equal "account", export.kind
+    end
+  end
+
+  test "an account export holds every record of the account, with its files" do
+    card = cards("logo")
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    export = export_account(@user)
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |archive|
+      assert archive.exists?(Account::DataTransfer::Manifest::PATH)
+      assert archive.exists?("cards/records.json")
+      assert archive.exists?("comments/records.json")
+      assert archive.exists?("files/#{card.image.blob.id}/#{card.image.filename}")
+      assert_equal @account.cards.count, records_in(archive, "cards").count
+      assert_equal @account.users.count, records_in(archive, "users").count
+      assert_equal @account.boards.count, records_in(archive, "boards").count
+    end
+  end
+
+  test "a cards export only holds the cards the user can see, with their comments and files" do
+    card = cards("logo")
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    comment = comments("logo_agreement_jz")
+    comment.update!(body: "See #{attachment_tag_for("avatar.png")}")
+    secret_card = with_current_user(users("kevin")) do
+      boards("private").cards.create!(creator: users("kevin"), title: "A secret")
+    end
+
+    export = Export.start_cards_export(users("david"))
+    export.export_now
+
+    assert export.completed?
+    assert_equal "cards", export.kind
+
+    ZipFile.open(export.file) do |archive|
+      card_numbers = records_in(archive, "cards").map { it["number"] }
+
+      assert_includes card_numbers, card.number
+      assert_not_includes card_numbers, secret_card.number
+      assert_equal users("david").accessible_cards.count, card_numbers.size
+
+      comment_ids = records_in(archive, "comments").map { it["id"] }
+      assert_includes comment_ids, comment.id
+
+      assert archive.exists?("files/#{card.image.blob.id}/#{card.image.filename}")
+      assert archive.exists?("files/#{comment.body.body.attachables.first.id}/#{comment.body.body.attachables.first.filename}")
+    end
+  end
+
+  test "the export doesn't hold the archive it is writing" do
+    export = export_account(@user)
+
+    ZipFile.open(export.file) do |archive|
+      record_types = records_in(archive, "active_storage_attachments").map { it["record_type"] }
+
+      assert_not_includes record_types, "Export"
+    end
+  end
+
+  test "the archive says what kind of export it holds" do
+    export = export_account(@user)
+
+    ZipFile.open(export.file) do |archive|
+      manifest = JSON.parse(archive.read(Account::DataTransfer::Manifest::PATH))
+
+      assert_equal Account::DataTransfer::Manifest::VERSION, manifest["version"]
+      assert_equal "account", manifest["kind"]
+      assert_equal @account.name, manifest.dig("account", "name")
+    end
+  end
+
+  test "the export is only downloadable for a day" do
+    export = export_account(@user)
+
+    assert_not export.expired?
+    assert export.downloadable?
+    assert_equal "#{@account.name.parameterize}-account-#{export.created_at.to_fs(:number)}.zip", export.filename
+
+    travel 2.days do
+      assert export.expired?
+      assert_not export.downloadable?
+    end
+  end
+
+  test "a failed export holds no file and is not downloadable" do
+    Account::DataTransfer::Exporter.any_instance.stubs(:export).raises(StandardError, "boom")
+    export = Export.start_account_export(@user)
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      export.export_now
+    end
+
+    assert export.failed?
+    assert_not export.file.attached?
+    assert_not export.downloadable?
+  end
+
+  test "exports whose link stopped working are cleaned up" do
+    export = export_account(@user)
+
+    Export.cleanup
+
+    assert Export.exists?(export.id)
+
+    travel 2.days do
+      Export.cleanup
+    end
+
+    assert_not Export.exists?(export.id)
+  end
+
+  test "only the person who asked for the export can download it" do
+    export = export_account(@user)
+
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users("david"))
+  end
+
+  private
+    def export_account(user)
+      Export.start_account_export(user).tap(&:export_now)
+    end
+
+    def records_in(archive, table)
+      archive.read("#{table}/records.json").lines.map { JSON.parse(it) }
+    end
+
+    def attachment_tag_for(filename)
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture(filename).open, filename: filename)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+end
