@@ -0,0 +1,58 @@
+require "application_system_test_case"
+
+class DataTransferTest < ApplicationSystemTestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("jason")
+    # Fixture users don't get the settings the browser's timezone is saved in.
+    User::Settings.create!(user: @user, account: @account)
+  end
+
+  test "an admin exports the whole account from the account settings" do
+    sign_in_as @user
+
+    visit account_settings_url
+    click_on "Export account data"
+
+    assert_text "We're exporting your account. We'll email you a download link when it's ready."
+    assert_equal "account", @account.exports.last.kind
+  end
+
+  test "someone signed in exports the cards they can see from their profile" do
+    user = users("david")
+    User::Settings.create!(user: user, account: @account)
+
+    sign_in_as user
+
+    visit user_url(users("david"))
+    click_on "Export my cards"
+
+    assert_text "We're exporting your cards. We'll email you a download link when it's ready."
+    assert_equal "cards", users("david").account.exports.last.kind
+  end
+
+  test "someone signed in brings an account file back in" do
+    sign_in_as @user
+
+    visit new_account_import_url
+    attach_file "file", account_file.path
+    click_on "Import account"
+
+    assert_text "We're importing your account. We'll email you when it's ready."
+    assert @account.imports.last.file.attached?
+  end
+
+  private
+    def account_file
+      @account_file ||= begin
+        export = Export.start_account_export(@user)
+        export.export_now
+
+        tempfile = Tempfile.new([ "account", ".zip" ])
+        tempfile.binmode
+        tempfile.write(export.file.download)
+        tempfile.rewind
+        tempfile
+      end
+    end
+end
