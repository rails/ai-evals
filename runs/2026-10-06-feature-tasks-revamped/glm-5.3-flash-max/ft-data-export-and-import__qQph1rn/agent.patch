--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,21 @@
+class Account::DataTransfer::Exporter
+  def initialize(export)
+    @export = export
+  end
+
+  def export
+    ZipFile.create_for(@export.file, filename: @export.filename) do |zip|
+      manifest.export_to(zip)
+      manifest.each_record_set { |record_set| record_set.export_to(zip) }
+    end
+  end
+
+  private
+    def manifest
+      @manifest ||= if @export.cards?
+        Account::DataTransfer::Manifest.for_cards(@export.account, @export.user.accessible_cards)
+      else
+        Account::DataTransfer::Manifest.for_account(@export.account)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..9dce171
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,197 @@
+class Account::DataTransfer::Importer
+  BATCH_SIZE = 500
+
+  ATTACHMENT_TAG_PATTERN = %r{<action-text-attachment[^>]*>}i
+  SGID_ATTRIBUTE_PATTERN = /sgid="([^"]+)"/
+  URL_ATTRIBUTE_PATTERN = /url="[^"]*"/
+
+  # Attributes that stay as they are on a record that is updated rather than
+  # imported, because the account it belongs to brings it with it.
+  KEPT_ATTRIBUTES = %w[ id account_id external_account_id container_type container_id created_at updated_at ]
+
+  class Error < StandardError; end
+
+  def initialize(archive, initiated_by:)
+    @initiated_by = initiated_by
+    @buffered = Hash.new { |buffer, model| buffer[model] = [] }
+    @imported = Hash.new { |imported, model| imported[model] = {} }
+    @sgids = {}
+    @sgid_replacements = {}
+    @zip = ZipFile::Reader.new(archive)
+
+    validate_manifest
+  end
+
+  def import
+    Account.transaction do
+      create_account
+      import_record_sets
+      ensure_system_user
+      make_the_importer_an_owner
+    end
+
+    account
+  end
+
+  # Buffers a record to be inserted together with the batch that is currently
+  # being imported.
+  def stage(model, attributes)
+    register_sgid(attributes)
+    buffered[model] << attributes.slice(*model.column_names)
+    flush(model) if buffered[model].size >= BATCH_SIZE
+  end
+
+  # Gives an exported record a primary key of its own and points the records it
+  # belongs to at the records they were imported as.
+  def remap(model, attributes)
+    old_id = attributes["id"]
+    attributes["id"] = ActiveRecord::Type::Uuid.generate
+    remap_associations(model, attributes)
+    imported[model][old_id] = attributes if old_id.present?
+    attributes
+  end
+
+  def imported_record_for(model, old_id)
+    imported[model][old_id]
+  end
+
+  # Rich text bodies reference their attachments by a signed id that is signed
+  # with the key of the instance the account came from. Points them at the
+  # attachments they were imported as instead.
+  def rewrite_rich_text_body(body)
+    body.gsub(ATTACHMENT_TAG_PATTERN) { |tag| rewrite_attachment_tag(tag) }
+  end
+
+  # Applies exported attributes to a record the account already has, instead
+  # of importing it as a new one.
+  def update_record(record, attributes)
+    record.update!(attributes.except(*KEPT_ATTRIBUTES))
+  end
+
+  def account
+    @account or raise Error, "The account is created while the archive is imported"
+  end
+
+  private
+    attr_reader :initiated_by, :zip, :buffered, :imported, :sgids
+
+    def create_account
+      @account = Account.create!(name: archive_account_name)
+      imported[Account][archive_account_id] = { "id" => account.id }
+    end
+
+    def import_record_sets
+      manifest.each_record_set do |record_set|
+        record_set.import_from(zip, importer: self)
+        flush(record_set.model)
+      end
+    end
+
+    def flush(model)
+      rows = buffered[model]
+      buffered[model] = []
+
+      rows.group_by(&:keys).each_value { |batch| model.insert_all!(batch) }
+    end
+
+    # Blobs travel with the signed id that rich text bodies reference them by.
+    def register_sgid(attributes)
+      if (sgid = attributes["sgid"]).present?
+        sgids[sgid] = attributes["id"]
+      end
+    end
+
+    def remap_associations(model, attributes)
+      model.reflect_on_all_associations(:belongs_to).each do |reflection|
+        key = reflection.foreign_key
+        next if attributes[key].blank?
+
+        if imported_record = imported_record_for_association(reflection, attributes)
+          attributes[key] = imported_record["id"]
+        elsif column_of(model, key).null
+          attributes[key] = nil
+        else
+          raise Error, "#{model.name}.#{key} points at a record that is not part of the archive"
+        end
+      end
+    end
+
+    def imported_record_for_association(reflection, attributes)
+      if klass = klass_of_association(reflection, attributes)
+        imported[klass][attributes[reflection.foreign_key]]
+      end
+    end
+
+    def klass_of_association(reflection, attributes)
+      if reflection.polymorphic?
+        attributes[reflection.foreign_type]&.safe_constantize
+      else
+        reflection.klass
+      end
+    end
+
+    def column_of(model, name)
+      model.columns_hash.fetch(name)
+    end
+
+    def ensure_system_user
+      account.users.find_by(role: :system) ||
+        account.users.create!(role: :system, name: "System")
+    end
+
+    def make_the_importer_an_owner
+      if user = account.users.find_by(identity: initiated_by)
+        user.update!(role: :owner, active: true) unless user.owner? && user.active?
+      else
+        account.users.create!(role: :owner, name: initiated_by.email_address, identity: initiated_by, verified_at: Time.current)
+      end
+    end
+
+    def rewrite_attachment_tag(tag)
+      if (sgid = tag[SGID_ATTRIBUTE_PATTERN, 1]) && (replacement = sgid_replacement_for(sgid))
+        tag.sub(SGID_ATTRIBUTE_PATTERN, %(sgid="#{replacement[:sgid]}"))
+          .sub(URL_ATTRIBUTE_PATTERN, %(url="#{replacement[:url]}"))
+      else
+        tag
+      end
+    end
+
+    def sgid_replacement_for(sgid)
+      @sgid_replacements[sgid] ||= build_sgid_replacement(sgid)
+    end
+
+    def build_sgid_replacement(sgid)
+      if blob_id = sgids[sgid]
+        blob = ::ActiveStorage::Blob.find(blob_id)
+
+        {
+          sgid: blob.attachable_sgid,
+          url: Rails.application.routes.url_helpers.polymorphic_url(blob, only_path: true, script_name: account.slug)
+        }
+      end
+    end
+
+    def manifest
+      Account::DataTransfer::Manifest.for_account(account)
+    end
+
+    def archive_manifest
+      @archive_manifest ||= JSON.parse(zip.read(Account::DataTransfer::Manifest::PATH))
+    end
+
+    def validate_manifest
+      if archive_manifest["version"] != Account::DataTransfer::Manifest::VERSION
+        raise Error, "This file is not a Fizzy account file"
+      elsif archive_manifest["kind"] != "account"
+        raise Error, "This file only holds a selection of cards, not a whole account"
+      end
+    end
+
+    def archive_account_name
+      archive_manifest.fetch("account").fetch("name")
+    end
+
+    def archive_account_id
+      archive_manifest.fetch("account").fetch("id")
+    end
+end
diff --git a/app/models/account/data_transfer/manifest.rb b/app/models/account/data_transfer/manifest.rb
index 53c14c4..1140c13 100644
--- a/app/models/account/data_transfer/manifest.rb
+++ b/app/models/account/data_transfer/manifest.rb
@@ -1,8 +1,55 @@
 class Account::DataTransfer::Manifest
-  attr_reader :account
+  PATH = "manifest.json"
+  VERSION = 1
 
-  def initialize(account)
+  class << self
+    def for_account(account)
+      new(account)
+    end
+
+    # A manifest for an export of a subset of cards, with everything attached
+    # to them: their comments, rich texts, and every picture and file.
+    def for_cards(account, cards)
+      new(account, kind: :cards, record_sets: card_record_sets(account, cards))
+    end
+
+    private
+      def card_record_sets(account, cards)
+        comments = ::Comment.where(card: cards)
+        rich_texts = rich_texts_for_cards(account, cards, comments)
+        attachments = attachments_for_cards(account, cards, rich_texts)
+        blobs = ::ActiveStorage::Blob.where(account: account).where(id: attachments.select(:blob_id))
+
+        [
+          Account::DataTransfer::RecordSet.new(account: account, model: ::Card, records: cards),
+          Account::DataTransfer::RecordSet.new(account: account, model: ::Comment, records: comments),
+          Account::DataTransfer::ActionText::RichTextRecordSet.new(account, records: rich_texts),
+          Account::DataTransfer::ActiveStorage::BlobRecordSet.new(account, records: blobs),
+          Account::DataTransfer::ActiveStorage::AttachmentRecordSet.new(account, records: attachments),
+          Account::DataTransfer::ActiveStorage::FileRecordSet.new(account, records: blobs)
+        ]
+      end
+
+      def rich_texts_for_cards(account, cards, comments)
+        rich_texts = ::ActionText::RichText.where(account: account)
+
+        rich_texts.where(record: cards).or(rich_texts.where(record: comments))
+      end
+
+      def attachments_for_cards(account, cards, rich_texts)
