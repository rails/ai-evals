diff --git a/test/models/account/data_transfer/importer_test.rb b/test/models/account/data_transfer/importer_test.rb
new file mode 100644
index 0000000..00df37d
--- /dev/null
+++ b/test/models/account/data_transfer/importer_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("jason")
+  end
+
+  test "remapping gives a record a primary key of its own" do
+    remapped = importer.remap(Card, { "id" => cards("logo").id, "title" => "The logo isn't big enough" })
+
+    assert_not_equal cards("logo").id, remapped["id"]
+  end
+
+  test "remapping points the record at the records it was imported as" do
+    board = boards("writebook")
+    importer.remap(User, board.creator.as_json)
+    importer.remap(Board, board.as_json)
+
+    remapped = importer.remap(Card, { "id" => cards("logo").id, "account_id" => @account.id, "board_id" => board.id })
+
+    assert_equal importer.account.id, remapped["account_id"]
+    assert_not_equal board.id, remapped["board_id"]
+    assert_equal importer.imported_record_for(Board, board.id)["id"], remapped["board_id"]
+  end
+
+  test "remapping leaves out what the account doesn't hold" do
+    remapped = importer.remap(User, { "id" => @user.id, "identity_id" => @user.identity_id })
+
+    assert_nil remapped["identity_id"]
+  end
+
+  test "remapping refuses to point at a record that is not part of the archive" do
+    assert_raises Account::DataTransfer::Importer::Error do
+      importer.remap(Comment, { "id" => comments("logo_1").id, "card_id" => cards("logo").id })
+    end
+  end
+
+  test "the records of a record set are imported with keys of their own" do
+    board = boards("writebook")
+    user_record_set = Account::DataTransfer::RecordSet.new(account: @account, model: User)
+    board_record_set = Account::DataTransfer::RecordSet.new(account: @account, model: Board)
+    importer = import_records(
+      [ user_record_set, board_record_set ],
+      user_record_set.records_path => ndjson(board.creator.as_json),
+      board_record_set.records_path => ndjson(board.as_json)
+    )
+
+    imported_board = importer.account.boards.first
+
+    assert_equal "Writebook", imported_board.name
+    assert_equal importer.account.id, imported_board.account_id
+    assert_not_equal board.id, imported_board.id
+  end
+
+  test "rich text bodies point at the attachments they were imported with" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png")
+    blob_record_set = Account::DataTransfer::ActiveStorage::BlobRecordSet.new(@account)
+    importer = import_records(
+      [ blob_record_set ],
+      blob_record_set.records_path => ndjson(blob.as_json.merge("sgid" => blob.attachable_sgid))
+    )
+    imported_blob = ActiveStorage::Blob.find(importer.imported_record_for(ActiveStorage::Blob, blob.id)["id"])
+
+    rewritten = importer.rewrite_rich_text_body(%(<action-text-attachment sgid="#{blob.attachable_sgid}" url="/whatever"></action-text-attachment>))
+
+    assert_not_includes rewritten, blob.attachable_sgid
+    assert_match importer.account.slug, rewritten
+    assert_equal imported_blob.attachable_sgid, rewritten[/sgid="([^"]+)"/, 1]
+    assert_not_equal blob.key, imported_blob.key
+  end
+
+  test "rich text bodies are left alone when their attachment is not part of the archive" do
+    body = %(<action-text-attachment sgid="unknown"></action-text-attachment>)
+
+    assert_equal body, importer.rewrite_rich_text_body(body)
+  end
+
+  private
+    # An importer of an archive that holds nothing but the account itself, so
+    # that every test can bring in the records it needs.
+    def importer
+      @importer ||= Account::DataTransfer::Importer.new(archive, initiated_by: @user.identity).tap do |importer|
+        importer.stubs(:import_record_sets)
+        importer.import
+      end
+    end
+
+    def import_records(record_sets, entries)
+      Account::DataTransfer::Importer.new(archive_with(entries), initiated_by: @user.identity).tap do |importer|
+        importer.stubs(:manifest).returns(Account::DataTransfer::Manifest.new(@account, record_sets: record_sets))
+        importer.import
+      end
+    end
+
+    def ndjson(*records)
+      records.map { JSON.generate(it) + "\n" }.join
+    end
+
+    def archive
+      archive_with({})
+    end
+
+    def archive_with(entries)
+      io = StringIO.new
+      writer = ZipFile::Writer.new(io)
+      writer.add_file(Account::DataTransfer::Manifest::PATH, JSON.generate(account_manifest))
+      entries.each { |path, content| writer.add_file(path, content) }
+      writer.close
+
+      io.rewind
+      io
+    end
+
+    def account_manifest
+      {
+        version: Account::DataTransfer::Manifest::VERSION,
+        kind: "account",
+        account: { id: @account.id, name: @account.name, external_account_id: @account.external_account_id }
+      }
+    end
+end
diff --git a/test/models/account/data_transfer/manifest_test.rb b/test/models/account/data_transfer/manifest_test.rb
new file mode 100644
index 0000000..0551367
--- /dev/null
+++ b/test/models/account/data_transfer/manifest_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "an account manifest walks over every record set of the account" do
+    models = models_of(Account::DataTransfer::Manifest.for_account(@account))
+
+    assert_equal [ Account, User, User::Settings, Tag, Board, Column, Entropy ], models.first(7)
+    assert_includes models, Card
+    assert_includes models, Comment
+    assert_includes models, ActiveStorage::Blob
+    assert_includes models, ActiveStorage::Attachment
+    assert_includes models, ActiveStorage::VariantRecord
+    assert_includes models, ActionText::RichText
+  end
+
+  test "a cards manifest walks over the cards, their comments and everything attached to them" do
+    manifest = Account::DataTransfer::Manifest.for_cards(@account, users("david").accessible_cards)
+
+    assert_equal :cards, manifest.kind
+    assert_equal [ Card, Comment, ActionText::RichText, ActiveStorage::Blob, ActiveStorage::Attachment, ActiveStorage::Blob ],
+      models_of(manifest)
+  end
+
+  test "a cards manifest only holds the records of the cards it was given" do
+    cards = users("david").accessible_cards
+    manifest = Account::DataTransfer::Manifest.for_cards(@account, cards)
+    record_sets = []
+    manifest.each_record_set { |record_set| record_sets << record_set }
+
+    card_records = records_of(record_sets.find { it.model == Card })
+    comment_records = records_of(record_sets.find { it.model == Comment })
+
+    assert_equal cards.count, card_records.count
+    assert_equal Comment.where(card: cards).count, comment_records.count
+  end
+
+  test "each record set needs a block" do
+    assert_raises(ArgumentError) do
+      Account::DataTransfer::Manifest.for_account(@account).each_record_set
+    end
+  end
+
+  test "the manifest describes itself in the archive" do
+    manifest = Account::DataTransfer::Manifest.for_account(@account)
+    archive = StringIO.new
+
+    writer = ZipFile::Writer.new(archive)
+    manifest.export_to(writer)
+    writer.close
+
+    written = JSON.parse(ZipFile::Reader.new(archive.tap(&:rewind)).read(Account::DataTransfer::Manifest::PATH))
+
+    assert_equal Account::DataTransfer::Manifest::VERSION, written["version"]
+    assert_equal "account", written["kind"]
+    assert_equal @account.name, written.dig("account", "name")
+  end
+
+  private
+    def models_of(manifest)
+      record_sets = []
+      manifest.each_record_set { |record_set| record_sets << record_set.model }
+      record_sets
+    end
+
+    def records_of(record_set)
+      archive = StringIO.new
+      writer = ZipFile::Writer.new(archive)
+      record_set.export_to(writer)
+      writer.close
+
+      ZipFile::Reader.new(archive.tap(&:rewind)).read(record_set.records_path).lines
+    end
+end
