+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Bring an account in</h2>
+        <div>
+          Upload a Fizzy account file and we'll create a brand new account with everything in
+          it: boards, cards, comments, files and people. You'll get an email when it's done.
+        </div>
+      </header>
+
+      <%= form_with url: account_imports_path, multipart: true, local: true, data: { turbo: false } do |form| %>
+        <div class="margin-block-end">
+          <%= form.file_field :file, accept: ".zip", required: true %>
