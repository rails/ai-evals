+        <header>
+          <h2 class="divider">Previous imports</h2>
+        </header>
+
+        <ul class="list-unindented">
+          <% @imports.each do |import| %>
+            <li class="flex justify-between gap-half">
+              <% if import.result %>
+                <%= link_to import.result.name, root_path(script_name: import.result.slug) %>
+              <% else %>
+                <span class="txt-tinted">Imported account</span>
+              <% end %>
+              <span class="txt-small txt-tinted"><%= import.status.capitalize %></span>
+            </li>
+          <% end %>
+        </ul>
+      </section>
+    <% end %>
+  </div>
+</div>
