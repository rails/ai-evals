index 0000000..fd8a9b4
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,33 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+  before_action :set_export, only: :show
+
+  def create
+    Export.start_account_export(Current.user)
+
+    redirect_to account_settings_path, notice: "We're exporting your account. We'll email you a download link when it's ready."
+  end
+
+  def show
+    if @export.accessible_to?(Current.user)
+      @export.downloadable? ? send_export : head(:gone)
+    else
+      head :forbidden
+    end
+  end
+
+  private
+    def set_export
+      @export = Current.account.exports.find(params[:id])
+    end
+
+    def send_export
+      response.headers["Content-Type"] = "application/zip"
+      response.headers["Content-Disposition"] = %(attachment; filename="#{@export.filename}")
+      response.headers["Content-Length"] = @export.file.byte_size.to_s
+
+      self.response_body = Enumerator.new do |yielder|
+        @export.file.download { |chunk| yielder << chunk }
+      end
+    end
+end
