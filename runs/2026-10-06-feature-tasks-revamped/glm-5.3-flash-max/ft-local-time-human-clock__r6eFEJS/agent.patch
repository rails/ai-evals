diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..da3b998
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,152 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+// Times travel to the browser as raw timestamps and are turned into words here,
+// in the viewer's own timezone. That keeps the server's clock out of the HTML,
+// so pages can be cached and shared between people in different timezones.
+
+const MINUTE = 60
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+const WEEK = 7
+const MONTH = 30
+const YEAR = 365
+
+export function formatTimestamp(timestamp, format = "relative") {
+  const date = toDate(timestamp)
+  const formatter = FORMATS[format] || FORMATS.relative
+
+  return formatter(date)
+}
+
+// "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow", "in 3 days"
+export function formatRelativeTime(date) {
+  const now = new Date()
+  const days = signedDifferenceInDays(date, now)
+
+  if (days === 0) {
+    return formatToday(date, now)
+  }
+
+  if (Math.abs(days) < WEEK) {
+    return relativeTime(-days, "day")
+  }
+
+  if (days < 0) {
+    return formatUpcoming(date, now)
+  }
+
+  return formatShortDate(date)
+}
+
+// "Sep 12, 2025"
+export function formatDate(date) {
+  return dateFormatter().format(date)
+}
+
+// "Friday, September 12"
+export function formatDay(date) {
+  return dayFormatter().format(date)
+}
+
+// "1:42 PM"
+export function formatTime(date) {
+  return timeFormatter().format(date)
+}
+
+// "9/12/25, 1:42 PM"
+export function formatNumericDateTime(date) {
+  return numericDateTimeFormatter().format(date)
+}
+
+const FORMATS = {
+  relative: formatRelativeTime,
+  date: formatDate,
+  day: formatDay,
+  time: formatTime,
+  numeric: formatNumericDateTime
+}
+
+function toDate(timestamp) {
+  return timestamp instanceof Date ? timestamp : new Date(timestamp)
+}
+
+function formatToday(date, now) {
+  if (date.getTime() <= now.getTime()) {
+    return formatTime(date)
+  }
+
+  return formatUpcoming(date, now)
+}
+
+function formatUpcoming(date, now) {
+  const seconds = Math.round((date.getTime() - now.getTime()) / 1000)
+
+  if (seconds < HOUR) {
+    return relativeTime(Math.max(Math.round(seconds / MINUTE), 1), "minute")
+  }
+
+  if (seconds < DAY) {
+    return relativeTime(Math.round(seconds / HOUR), "hour")
+  }
+
+  const days = signedDifferenceInDays(now, date)
+
+  if (days < MONTH) {
+    return relativeTime(days, "day")
+  }
+
+  if (days < YEAR) {
+    return relativeTime(Math.round(days / MONTH), "month")
+  }
+
+  return relativeTime(Math.round(days / YEAR), "year")
+}
+
+function relativeTime(value, unit) {
+  return relativeTimeFormatter().format(value, unit)
+}
+
+function relativeTimeFormatter() {
+  return memoize("relative", () => new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }))
+}
+
+function timeFormatter() {
+  return memoize("time", () => new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }))
+}
+
+function dayFormatter() {
+  return memoize("day", () => new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }))
+}
+
+function dateFormatter() {
+  return memoize("date", () => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }))
+}
+
+function numericDateTimeFormatter() {
+  return memoize("numeric", () => new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" }))
+}
+
+function shortDateFormatter() {
+  return memoize("short-date", () => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }))
+}
+
+// Dates far enough back to span years need the year spelled out.
+function formatShortDate(date) {
+  const formatted = shortDateFormatter().format(date)
+
+  if (date.getFullYear() === new Date().getFullYear()) {
+    return formatted
+  }
+
+  return `${formatted}, ${date.getFullYear()}`
+}
+
+const formatters = new Map()
+
+function memoize(key, build) {
+  if (!formatters.has(key)) {
+    formatters.set(key, build())
+  }
+
+  return formatters.get(key)
+}
