+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "a comment from earlier today reads as a time of day" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_columns created_at: this_morning, updated_at: this_morning
+
+    sign_in_as users(:david)
+    visit card_url(comment.card)
+
+    assert_selector "time", text: /\d{1,2}:\d{2} [AP]M/
+  end
+
+  test "a comment from last night reads as yesterday" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_columns created_at: yesterday_morning, updated_at: yesterday_morning
+
+    sign_in_as users(:david)
+    visit card_url(comment.card)
+
+    assert_selector "time", text: /yesterday/i
+  end
+
+  test "a comment from earlier in the week reads as days ago" do
+    comment = comments(:logo_agreement_kevin)
+    comment.update_columns created_at: 5.days.ago, updated_at: 5.days.ago
+
+    sign_in_as users(:david)
+    visit card_url(comment.card)
+
+    assert_selector "time", text: /5 days ago/i
+  end
+
+  test "an older card reads as a date" do
+    sign_in_as users(:david)
+    visit card_url(cards(:layout))
+
+    assert_selector "time", text: /Oct \d{1,2}/i
+  end
+
+  test "a card auto-closing overnight reads as tomorrow" do
+    card = cards(:text)
+    card.update_columns last_active_at: 89.days.ago
+
+    sign_in_as users(:david)
+    visit card_url(card)
+
+    assert_selector "time", text: /tomorrow/i
+  end
+
+  test "a card auto-closing in a few days reads as days ahead" do
+    card = cards(:text)
+    card.update_columns last_active_at: 87.days.ago
+
+    sign_in_as users(:david)
+    visit card_url(card)
+
+    assert_selector "time", text: /in 3 days/i
+  end
+
+  private
+    def this_morning
+      Time.current.beginning_of_day + 1.hour
+    end
+
+    def yesterday_morning
+      1.day.ago.beginning_of_day + 1.hour
+    end
+end
