--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,13 @@
 module TimeHelper
+  # Times are turned into words by the browser, in the viewer's own timezone, so
+  # the server only sends the raw timestamp. That keeps everyone's clock out of
+  # the HTML and lets pages be cached and shared between people.
+  def local_time_tag(timestamp, format: :relative, **options)
+    return "" if timestamp.nil?
+
+    data = options.fetch(:data, {}).merge(controller: "time", action: "turbo:morph-element->time#render")
+    data[:time_format_value] = format unless format == :relative
+
+    tag.time datetime: timestamp.utc.iso8601, **options, data: data
+  end
 end
