diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..858b22d
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+const instances = new Set()
+let ticker
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.#tick()
+  }
+
+  disconnect() {
+    instances.delete(this)
+    this.#stopTicking()
+  }
+
+  // Times age, and Turbo morphing may hand us back the server's untouched markup.
+  render() {
+    if (this.datetime) {
+      this.element.textContent = formatTimestamp(this.datetime, this.formatValue)
+    }
+  }
+
+  get datetime() {
+    return this.element.getAttribute("datetime")
+  }
+
+  #tick() {
+    instances.add(this)
+    ticker ||= setInterval(() => instances.forEach((instance) => instance.render()), REFRESH_INTERVAL)
+  }
+
+  #stopTicking() {
+    if (instances.size === 0 && ticker) {
+      clearInterval(ticker)
+      ticker = undefined
+    }
+  }
+}
