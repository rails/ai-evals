+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "sends the raw timestamp instead of rendering words" do
+    tag = parse(local_time_tag(Time.zone.parse("2025-09-12 13:42")))
+
+    assert_select tag, "time[datetime='2025-09-12T13:42:00Z']"
+    assert_predicate tag.at_css("time").children, :empty?
+  end
+
+  test "sends the timestamp in UTC, whatever the server renders with" do
+    Time.use_zone("Pacific/Honolulu") do
+      tag = parse(local_time_tag(Time.zone.parse("2025-09-12 13:42")))
+
+      assert_select tag, "time[datetime='2025-09-12T23:42:00Z']"
+    end
+  end
+
+  test "hands the element to the time controller" do
+    assert_select parse(local_time_tag(Time.current)), "time[data-controller='time']"
+  end
+
+  test "only marks formats that differ from the default" do
+    assert_select parse(local_time_tag(Time.current)), "time:not([data-time-format-value])"
+    assert_select parse(local_time_tag(Time.current, format: :date)), "time[data-time-format-value='date']"
+  end
+
+  test "keeps the caller's options" do
+    tag = parse(local_time_tag(Time.current, class: "card__timestamp", data: { turbo_permanent: true }))
+
+    assert_select tag, "time.card__timestamp[data-turbo-permanent='true']"
+  end
+
+  test "nothing to render without a timestamp" do
+    assert_empty local_time_tag(nil)
+  end
+end
