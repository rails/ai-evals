diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..b1f8535
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,50 @@
+# Keeps track of how much storage a record owns: the images attached to its
+# cards and the files embedded in board descriptions, card descriptions, and
+# comments.
+#
+# Totals are calculated in the background. Adding, removing, or moving a counted
+# file marks the record stale and enqueues a recalculation, which adds up the
+# sizes of the counted blobs in a single query and records the result. Reading
+# the total is a column read, however much is stored.
+#
+# Records including this concern implement #counted_attachments, the relation of
+# Active Storage attachments whose blobs they count.
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    scope :with_stale_bytes_used, -> { where.not(bytes_used_stale_at: nil) }
+  end
+
+  # The number of bytes of storage used by the files this record counts.
+  def bytes_used
+    self[:bytes_used]
+  end
+
+  def mark_bytes_used_stale
+    if became_stale?
+      recalculate_bytes_used_later
+    end
+  end
+
+  def recalculate_bytes_used_later
+    RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used
+    calculated_at = Time.current
+    bytes = counted_attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+
+    # A file that changed while we were counting has already marked this record
+    # stale again and enqueued another recalculation, so leave its marker alone.
+    self.class.where(id: id).where(bytes_used_stale_at: ..calculated_at)
+      .update_all(bytes_used: bytes, bytes_used_stale_at: nil)
+  end
+
+  private
+    # Whether this call is the one that made the record stale. A burst of
+    # changes to the same record only enqueues a single recalculation.
+    def became_stale?
+      self.class.where(id: id, bytes_used_stale_at: nil).update_all(bytes_used_stale_at: Time.current) > 0
+    end
+end
