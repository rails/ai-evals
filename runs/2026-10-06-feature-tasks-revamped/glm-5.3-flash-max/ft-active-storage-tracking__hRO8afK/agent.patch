+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  include ::StorageUsage
+
+  # The files an account counts as its own: the images attached to its cards and
+  # the files embedded in its boards' descriptions, its cards' descriptions, and
+  # its cards' comments.
+  def counted_attachments
+    card_images.or(embedded_files)
+  end
+
+  private
+    def card_images
+      ActiveStorage::Attachment.where(record: cards, name: "image")
+    end
+
+    def embedded_files
+      ActiveStorage::Attachment.where(record: counted_rich_texts, name: "embeds")
+    end
+
+    def counted_rich_texts
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+
+    def board_descriptions
+      ActionText::RichText.where(record: boards, name: "public_description")
+    end
+
+    def card_descriptions
+      ActionText::RichText.where(record: cards, name: "description")
+    end
+
+    def comment_bodies
+      ActionText::RichText.where(record: Comment.where(account: self), name: "body")
+    end
+end
