+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  # Included here rather than in Board so that the board's own contribution to
+  # the tracking runs before the shared one.
+  include ::StorageUsage
+
+  included do
+    after_destroy :mark_counted_storage_stale
+  end
+
+  # A board's usage is part of its account's usage, so the account goes stale
+  # along with the board.
+  def mark_bytes_used_stale
+    account.mark_bytes_used_stale
+    super
+  end
+
+  # The files a board counts as its own: the images attached to its cards and
+  # the files embedded in its description, its cards' descriptions, and its
+  # cards' comments.
+  def counted_attachments
+    card_images.or(embedded_files)
+  end
+
+  private
+    def mark_counted_storage_stale
+      account.mark_bytes_used_stale
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(record: cards, name: "image")
+    end
+
+    def embedded_files
+      ActiveStorage::Attachment.where(record: counted_rich_texts, name: "embeds")
+    end
+
+    def counted_rich_texts
+      description_embeds.or(card_description_embeds).or(comment_body_embeds)
+    end
+
+    def description_embeds
+      ActionText::RichText.where(record: self, name: "public_description")
+    end
+
+    def card_description_embeds
+      ActionText::RichText.where(record: cards, name: "description")
+    end
+
+    def comment_body_embeds
+      ActionText::RichText.where(record: Comment.where(card: cards), name: "body")
+    end
+end
