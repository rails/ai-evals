diff --git a/test/models/board/bytes_used_test.rb b/test/models/board/bytes_used_test.rb
new file mode 100644
index 0000000..a972929
--- /dev/null
+++ b/test/models/board/bytes_used_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class Board::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "#bytes_used is zero for a board without counted files" do
+    assert_equal 0, boards(:writebook).bytes_used
+  end
+
+  test "#bytes_used counts the images attached to its cards" do
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("moon"), filename: "moon.png", content_type: "image/png"
+
+    perform_enqueued_jobs
+
+    assert_equal card.image.blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in its description" do
+    blob = attachable_blob("board", 100)
+    boards(:writebook).update! public_description: ActionText::Content.new("Our board").append_attachables(blob)
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in its cards' descriptions" do
+    card = cards(:logo)
+    blob = attachable_blob("card", 200)
+    card.update! description: ActionText::Content.new("A card").append_attachables(blob)
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in its cards' comments" do
+    comment = cards(:logo).comments.create!(body: "A comment")
+    blob = attachable_blob("comment", 300)
+    comment.update! body: ActionText::Content.new("A comment").append_attachables(blob)
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used adds up everything counted on the board" do
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("image"), filename: "image.png", content_type: "image/png"
+    card.update! description: ActionText::Content.new("A card").append_attachables(attachable_blob("description", 10))
+    card.comments.create!(body: ActionText::Content.new("A comment").append_attachables(attachable_blob("comment", 100)))
+
+    perform_enqueued_jobs
+
+    expected = card.image.blob.byte_size + 10 + 100
+    assert_equal expected, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used does not count files attached to other records" do
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used does not count files on other boards" do
+    blob = attachable_blob("elsewhere", 1234)
+    cards(:radio).update! description: ActionText::Content.new("Elsewhere").append_attachables(blob)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used drops what a detached card image used" do
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("moon"), filename: "moon.png", content_type: "image/png"
+    perform_enqueued_jobs
+
+    card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used follows a card that moves to another board" do
+    card = cards(:logo)
+    blob = attachable_blob("moving", 42)
+    card.update! description: ActionText::Content.new("A card").append_attachables(blob)
+    perform_enqueued_jobs
+
+    card.move_to boards(:private)
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+    assert_equal blob.byte_size, boards(:private).reload.bytes_used
+  end
+
+test "#bytes_used drops what a removed embed used" do
+  comment = cards(:logo).comments.create!(body: "A comment")
+  blob = attachable_blob("doomed", 42)
+  comment.update! body: ActionText::Content.new("A comment").append_attachables(blob)
+  perform_enqueued_jobs
+
+  comment.update! body: "A comment"
+  perform_enqueued_jobs
+
+  assert_equal 0, boards(:writebook).reload.bytes_used
+end
+
+  test "#bytes_used drops what a destroyed card used" do
+    card = cards(:logo)
+    card.update! description: ActionText::Content.new("A card").append_attachables(attachable_blob("doomed", 42))
+    perform_enqueued_jobs
+
+    card.destroy
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used drops what a destroyed comment used" do
+    comment = cards(:logo).comments.create!(body: "A comment")
+    comment.update! body: ActionText::Content.new("A comment").append_attachables(attachable_blob("doomed", 42))
+    perform_enqueued_jobs
+
+    comment.destroy
+    perform_enqueued_jobs only: RecalculateBytesUsedJob
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used is calculated in the background" do
+    card = cards(:logo)
+    blob = attachable_blob("later", 42)
+    card.update! description: ActionText::Content.new("A card").append_attachables(blob)
+
+    assert_equal 0, boards(:writebook).reload.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  test "#bytes_used is only calculated once for a burst of changes" do
+    card = cards(:logo)
+
+    # One recalculation for the board and one for its account, despite the burst
+    # of changes.
+    assert_enqueued_jobs 2, only: RecalculateBytesUsedJob do
+      card.image.attach io: StringIO.new("moon"), filename: "moon.png", content_type: "image/png"
+      card.update! description: ActionText::Content.new("A card").append_attachables(attachable_blob("card", 10))
+    end
+  end
+
+  test "#bytes_used recalculates stale boards" do
+    card = cards(:logo)
+    blob = attachable_blob("swept", 42)
+    card.update! description: ActionText::Content.new("A card").append_attachables(blob)
+
+    RecalculateStaleBytesUsedJob.perform_now
+
+    assert_equal blob.byte_size, boards(:writebook).reload.bytes_used
+  end
+
+  private
+    def attachable_blob(name, size)
+      ActiveStorage::Blob.create_and_upload! \
+        io: StringIO.new("x" * size),
+        filename: "#{name}.txt",
+        content_type: "text/plain"
+    end
+end
