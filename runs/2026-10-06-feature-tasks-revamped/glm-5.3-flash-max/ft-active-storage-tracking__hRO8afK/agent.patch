diff --git a/db/migrate/20260710120000_add_bytes_used_to_accounts_and_boards.rb b/db/migrate/20260710120000_add_bytes_used_to_accounts_and_boards.rb
new file mode 100644
index 0000000..da88bc3
--- /dev/null
+++ b/db/migrate/20260710120000_add_bytes_used_to_accounts_and_boards.rb
@@ -0,0 +1,22 @@
+class AddBytesUsedToAccountsAndBoards < ActiveRecord::Migration[8.2]
+  def change
+    add_column :accounts, :bytes_used, :bigint, default: 0, null: false
+    add_column :accounts, :bytes_used_stale_at, :datetime
+    add_column :boards, :bytes_used, :bigint, default: 0, null: false
+    add_column :boards, :bytes_used_stale_at, :datetime
+
+    reversible do |direction|
+      direction.up { mark_existing_records_as_stale }
+    end
+  end
+
+  private
+    # Records that predate the tracking have never had their usage calculated.
+    # Marking them stale hands them over to the recalculation sweep.
+    def mark_existing_records_as_stale
+      timestamp = connection.quote(connection.quoted_date(Time.current))
+
+      execute "UPDATE accounts SET bytes_used_stale_at = #{timestamp}"
+      execute "UPDATE boards SET bytes_used_stale_at = #{timestamp}"
+    end
+end
