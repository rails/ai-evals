+# Recalculates the storage total of an Account or Board after its counted files
+# changed.
+class RecalculateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record)
+    record.recalculate_bytes_used
+  end
+end
diff --git a/app/jobs/recalculate_stale_bytes_used_job.rb b/app/jobs/recalculate_stale_bytes_used_job.rb
new file mode 100644
index 0000000..6895890
--- /dev/null
+++ b/app/jobs/recalculate_stale_bytes_used_job.rb
@@ -0,0 +1,14 @@
+# Recalculates the storage totals of every Account and Board that is stale:
+# records whose files changed while a recalculation couldn't run, and records
+# that predate the tracking itself (see AddBytesUsedToAccountsAndBoards).
+#
+# RecalculateBytesUsedJob keeps totals up to date as files change, so this
+# usually has nothing to do.
+class RecalculateStaleBytesUsedJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.with_stale_bytes_used.find_each(&:recalculate_bytes_used)
+    Board.with_stale_bytes_used.find_each(&:recalculate_bytes_used)
+  end
+end
