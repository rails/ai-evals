diff --git a/test/models/account/bytes_used_test.rb b/test/models/account/bytes_used_test.rb
new file mode 100644
index 0000000..5e623ab
--- /dev/null
+++ b/test/models/account/bytes_used_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "#bytes_used is zero for an account without counted files" do
+    assert_equal 0, accounts("37s").bytes_used
+  end
+
+  test "#bytes_used adds up the files of all of its boards" do
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("moon"), filename: "moon.png", content_type: "image/png"
+    boards(:writebook).update! public_description: embed(attachable_blob("board", 10))
+    cards(:layout).update! description: embed(attachable_blob("card", 20))
+    cards(:text).comments.create!(body: embed(attachable_blob("comment", 30)))
+
+    perform_enqueued_jobs
+
+    assert_equal card.image.blob.byte_size + 10 + 20 + 30, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used does not count files attached to other records" do
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+
+    perform_enqueued_jobs
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used does not count the files of other accounts" do
+    cards(:radio).update! description: embed(attachable_blob("elsewhere", 1234))
+
+    perform_enqueued_jobs
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used follows what its boards count" do
+    card = cards(:logo)
+    card.update! description: embed(attachable_blob("moved", 42))
+    perform_enqueued_jobs
+
+    card.move_to boards(:private)
+    perform_enqueued_jobs
+
+    assert_equal 42, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used drops the files of a destroyed board" do
+    boards(:writebook).update! public_description: embed(attachable_blob("board", 10))
+    perform_enqueued_jobs
+
+    perform_enqueued_jobs only: RecalculateBytesUsedJob do
+      boards(:writebook).destroy
+    end
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used is calculated in the background" do
+    cards(:logo).update! description: embed(attachable_blob("later", 42))
+
+    assert_equal 0, accounts("37s").reload.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal 42, accounts("37s").reload.bytes_used
+  end
+
+  test "#bytes_used recalculates stale accounts" do
+    cards(:logo).update! description: embed(attachable_blob("swept", 42))
+
+    RecalculateStaleBytesUsedJob.perform_now
+
+    assert_equal 42, accounts("37s").reload.bytes_used
+  end
+
+  private
+    def embed(blob)
+      ActionText::Content.new("Text").append_attachables(blob)
+    end
+
+    def attachable_blob(name, size)
+      ActiveStorage::Blob.create_and_upload! \
+        io: StringIO.new("x" * size),
+        filename: "#{name}.txt",
+        content_type: "text/plain"
+    end
+end
