@@ -0,0 +1,10 @@
+module StorageUsage
+  # Purging and detaching an attachment deletes it straight off, without running
+  # callbacks, so the counted storage has to be marked stale before it goes.
+  module DeletedAttachment
+    def delete
+      mark_counted_storage_stale if persisted?
+      super
+    end
+  end
+end
diff --git a/app/models/concerns/storage_usage/tracked_attachment.rb b/app/models/concerns/storage_usage/tracked_attachment.rb
new file mode 100644
index 0000000..c256c71
--- /dev/null
+++ b/app/models/concerns/storage_usage/tracked_attachment.rb
@@ -0,0 +1,40 @@
+module StorageUsage
+  # Card images and the files embedded in rich texts count towards the storage
+  # of the Board and Account they belong to, so mark those stale whenever one of
+  # them is attached or detached. Files that nobody counts, like avatars, are
+  # left alone.
+  module TrackedAttachment
+    extend ActiveSupport::Concern
+
+    included do
+      after_commit :mark_counted_storage_stale, on: [ :create, :destroy ]
+    end
+
+    private
+      def mark_counted_storage_stale
+        if (board = counted_by_board)
+          board.mark_bytes_used_stale
+        end
+      end
+
+      # The Board whose usage includes this attachment, if it is counted at all.
+      def counted_by_board
+        case (owner = counted_record)
+        when Board then owner
+        when Card, Comment then owner.board
+        end
+      end
+
+      # The record a counted file belongs to: a card's image is attached to the
+      # card itself, a file embedded in a rich text is attached to the rich text.
+      # There is nothing to mark when the record is already gone.
+      def counted_record
+        case record_type
+        when "Card" then record
+        when "ActionText::RichText" then record&.record
+        end
+      rescue ActiveRecord::RecordNotFound
+        nil
+      end
+  end
+end
