diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..4ce35cc
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = cancelled_account(cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not Account::Cancellation.exists?(account_id: account.id)
+    assert_not User.exists?(account_id: account.id)
+    assert_not Board.exists?(account_id: account.id)
+    assert_not Card.exists?(account_id: account.id)
+    assert_not Notification.exists?(account_id: account.id)
+  end
+
+  test "does not incinerate accounts cancelled within the last 30 days" do
+    account = cancelled_account(cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.hour)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert account.cancelled?
+  end
+
+  test "does not incinerate active accounts" do
+    account = accounts(:initech)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+    assert_not account.cancelled?
+  end
+
+  private
+    def cancelled_account(cancelled_at:)
+      account = accounts(:initech)
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: cancelled_at)
+      account
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..4cdb393
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "incinerate permanently removes the account and everything in it" do
+    board = @account.boards.first
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Board.exists?(board.id)
+  end
+
+  test "incinerate removes the storage ledger of the account" do
+    Current.account = @account
+    @account.boards.first.cards.first.image.attach io: StringIO.new("x" * 1024), filename: "test.png", content_type: "image/png"
+
+    assert_not_equal [], Storage::Entry.where(account_id: @account.id)
+
+    @account.incinerate
+
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+  end
+
+  test "incineration_due includes accounts cancelled more than 30 days ago" do
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+
+    assert_includes Account.incineration_due, @account
+  end
+
+  test "incineration_due excludes accounts cancelled within the last 30 days" do
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.day
+
+    assert_not_includes Account.incineration_due, @account
+  end
+
+  test "incineration_due excludes accounts that are not cancelled" do
+    assert_not_includes Account.incineration_due, @account
+  end
+
+  test "incinerate_due incinerates only the accounts that are due" do
+    due = accounts(:acme)
+    not_due_yet = accounts(:"37s")
+    cancel @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day
+    cancel due, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 2.days
+    cancel not_due_yet, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 2.days
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(not_due_yet.id)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: at)
+    end
+end
