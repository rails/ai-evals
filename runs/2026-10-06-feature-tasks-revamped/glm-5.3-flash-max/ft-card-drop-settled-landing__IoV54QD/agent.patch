diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..a00de66
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,275 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card onto another column moves it there, on top of its cards" do
+    card = cards(:text)
+    column = columns(:writebook_triage)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_equal column, card.reload.column
+    assert_card_is_in card, column
+    expected_order = [ cards(:logo), card, cards(:layout) ] # golden cards stay on top
+    assert_equal expected_order.map { |card_in_place| dom_id(card_in_place, :article) }, card_order_in(column)
+  end
+
+  test "dragging a card from Maybe? onto a column triages it" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_equal column, card.reload.column
+    assert_card_is_in card, column
+  end
+
+  test "dragging a card onto Maybe? sends it back to triage" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container("maybe"))
+
+    assert_nil card.reload.column
+    assert_card_is_in card, "maybe"
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container("not-now"))
+
+    assert_predicate card.reload, :postponed?
+    assert_nil card.reload.column
+    assert_card_is_in card, "not-now"
+  end
+
+  test "dragging a card out of Not Now moves it to a column" do
+    card = cards(:text)
+    card.postpone(user: users(:kevin))
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column("not-now")
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_predicate card.reload, :active?
+    assert_equal column, card.reload.column
+    assert_card_is_in card, column
+  end
+
+  test "dragging a card onto Done closes it" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container("closed-cards"))
+
+    assert_predicate card.reload, :closed?
+    assert_card_is_in card, "closed-cards"
+  end
+
+  test "dragging a card out of Done moves it to a column" do
+    card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column("closed-cards")
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_predicate card.reload, :open?
+    assert_equal column, card.reload.column
+    assert_card_is_in card, column
+  end
+
+  test "dragging a card onto the place it already is changes nothing" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container(card.column))
+
+    assert_equal columns(:writebook_in_progress), card.reload.column
+    assert_card_is_in card, card.column
+  end
+
+  test "dragging lights up the column under the pointer and dims the dragged card" do
+    card = cards(:text)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    hold_card_over(card, column)
+
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+
+    release_card_on(card, column)
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_equal column, card.reload.column
+  end
+
+  test "empty places invite dragging cards into them" do
+    visit board_url(@board)
+
+    assert_selector "#not-now .blank-slate--drag", text: "Drag cards here", visible: :all
+    assert_no_selector "#not-now .blank-slate--default" # the default slate is replaced by the drag one
+  end
+
+  test "the place a card was dragged from doesn't light up" do
+    card = cards(:text)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    hold_card_over(card, card.column)
+
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+    assert_no_selector "##{dom_id(card.column)}.drag-and-drop__hover-container"
+  end
+
+  test "the board is already showing the drop while the save is still in flight" do
+    card = cards(:text)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column(card.column)
+    hold_requests
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_card_is_in card, column
+    assert_equal columns(:writebook_in_progress), card.reload.column
+
+    release_requests
+    wait_for { card.reload.column == column }
+
+    assert_equal column, card.reload.column
+  end
+
+  test "the board doesn't shift once the drop has been saved and broadcast" do
+    card = cards(:text)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column(card.column)
+
+    drag_card(card).drag_to(column_container(column))
+
+    assert_card_is_in card, column
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_equal column, card.reload.column
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", text: card.title, wait: 5, visible: :all
+  end
+
+  private
+    # Cards are also rendered in the pins tray, so scope to the board's columns
+    def drag_card(card)
+      find(".card-columns ##{dom_id(card, :article)}")
+    end
+
+    # Simulates the native drag of a card being held over a place on the board
+    def hold_card_over(card, place)
+      page.execute_script(<<~JS)
+        const dataTransfer = new DataTransfer()
+        const card = document.querySelector(".card-columns ##{dom_id(card, :article)}")
+        const place = document.querySelector("##{column_id(place)}")
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        place.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def release_card_on(card, place)
+      page.execute_script(<<~JS)
+        const dataTransfer = new DataTransfer()
+        const card = document.querySelector(".card-columns ##{dom_id(card, :article)}")
+        const place = document.querySelector("##{column_id(place)}")
+
+        place.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def column_container(column)
+      find("##{column_id(column)}")
+    end
+
+    def assert_card_is_in(card, column)
+      assert_selector "##{column_id(column)} ##{dom_id(card, :article)}", visible: :all
+    end
+
+    def card_order_in(column)
+      page.evaluate_script(<<~JS)
+        Array.from(document.querySelector("##{column_id(column)} .cards__list").getElementsByClassName("card")).map(card => card.id)
+      JS
+    end
+
+    def column_id(column)
+      column.is_a?(String) ? column : dom_id(column)
+    end
+
+    def expand_column(column)
+      within "##{column_id(column)}" do
+        find(".cards__expander").click
+      end
+    end
+
+    # Holds the requests that persist drops, so that the board can be checked while a save
+    # is still in flight
+    def hold_requests
+      page.execute_script(<<~JS)
+        window.__holdRequests = true
+        window.__originalFetch = window.fetch
+        window.fetch = (...args) => {
+          if (!window.__holdRequests) return window.__originalFetch(...args)
+          return new Promise(resolve => { window.__releaseHeld = () => resolve(window.__originalFetch(...args)) })
+        }
+      JS
+    end
+
+    def release_requests
+      page.execute_script(<<~JS)
+        window.__holdRequests = false
+        if (window.__releaseHeld) { const release = window.__releaseHeld; window.__releaseHeld = null; release() }
+      JS
+    end
+
+    def wait_for(timeout: 10)
+      deadline = Time.current + timeout
+
+      loop do
+        result = yield
+        return result if result
+
+        raise "condition was never met" if Time.current > deadline
+
+        sleep 0.1
+      end
+    end
+end
