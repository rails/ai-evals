diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e3041d9
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,201 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+// Dragging a card onto another column moves it there, and dropping it on "Maybe?", "Not
+// Now" or "Done" changes its status. Columns keep their own order, so a card always lands
+// on top of the place it was dropped on: dragging moves cards between places, not within
+// one.
+//
+// The board is showing the drop the moment the card is released, before the request that
+// saves it comes back. That request only persists the change, and the refresh it
+// broadcasts morphs the board into the state we're already showing, so nothing waits for
+// the save and nothing shifts afterwards.
+export default class extends Controller {
+  static targets = [ "container" ]
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredContainer = null
+  }
+
+  disconnect() {
+    this.#releaseCard()
+    this.#stopHighlighting()
+  }
+
+  dragStart(event) {
+    const card = this.#draggableCardFor(event)
+
+    if (card) {
+      this.draggedCard = card
+      card.classList.add(DRAGGED_ITEM_CLASS)
+
+      // Describe what's being dragged, so that the browser offers it to the other places
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", card.id)
+      }
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const container = this.#droppableContainerFor(event)
+
+    if (container) {
+      event.preventDefault()
+
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      this.#highlight(container)
+    } else {
+      this.#stopHighlighting()
+    }
+  }
+
+  dragLeave(event) {
+    if (this.hoveredContainer && !this.hoveredContainer.contains(event.relatedTarget)) {
+      this.#stopHighlighting()
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const container = this.#containerFor(event)
+
+    this.#stopHighlighting()
+
+    if (card && container && !container.contains(card)) {
+      event.preventDefault()
+      this.#dropCard(card, container)
+    }
+  }
+
+  dragEnd() {
+    this.#releaseCard()
+    this.#stopHighlighting()
+  }
+
+  // Private
+
+  #draggableCardFor(event) {
+    const card = event.target.closest(".card")
+    return card?.draggable ? card : null
+  }
+
+  #containerFor(event) {
+    return this.containerTargets.find(container => container.contains(event.target))
+  }
+
+  #droppableContainerFor(event) {
+    const container = this.#containerFor(event)
+
+    // Columns keep their own order, so the place a card was dragged from is not a target
+    if (container && !container.contains(this.draggedCard) && this.#actionForDropping(this.draggedCard, container)) {
+      return container
+    }
+  }
+
+  #highlight(container) {
+    if (this.hoveredContainer !== container) {
+      this.#stopHighlighting()
+
+      this.hoveredContainer = container
+      container.classList.add(HOVER_CONTAINER_CLASS)
+    }
+  }
+
+  #stopHighlighting() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(HOVER_CONTAINER_CLASS)
+      this.hoveredContainer = null
+    }
+  }
+
+  #releaseCard() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(DRAGGED_ITEM_CLASS)
+      this.draggedCard = null
+    }
+  }
+
+  #dropCard(card, container) {
+    const originalLocation = {
+      parent: card.parentNode,
+      nextSibling: card.nextSibling,
+      wasPostponed: card.classList.contains("card--postponed")
+    }
+
+    this.#moveCard(card, container)
+    this.#persistDrop(card, container, originalLocation)
+  }
+
+  #moveCard(card, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      const insertionPoint = this.#insertionPointFor(card, list)
+
+      if (insertionPoint) {
+        insertionPoint.parentNode.insertBefore(card, insertionPoint)
+      } else {
+        list.append(card)
+      }
+
+      this.#refreshCardStatus(card, container)
+    }
+  }
+
+  // Cards land on top of the place they were dropped on, right below the golden ones that
+  // are pinned there. The card the board would show above the dropped one is the insertion
+  // point, since cards are wrapped in pagination containers inside the list.
+  #insertionPointFor(card, list) {
+    const cards = Array.from(list.getElementsByClassName("card"))
+
+    return card.classList.contains("golden-effect")
+      ? cards[0]
+      : cards.find(listedCard => !listedCard.classList.contains("golden-effect"))
+  }
+
+  // Keep the card looking like the place it was dropped in until the board refreshes
+  #refreshCardStatus(card, container) {
+    card.classList.toggle("card--postponed", container.dataset.dragAndDropStatus === "not_now")
+  }
+
+  #persistDrop(card, container, originalLocation) {
+    const { method, url, query } = this.#actionForDropping(card, container)
+    const request = new FetchRequest(method, url, { query, responseKind: "json" })
+
+    request.perform().then(response => {
+      if (!response.ok) this.#undoDrop(card, originalLocation)
+    }).catch(() => this.#undoDrop(card, originalLocation))
+  }
+
+  // Puts the card back where it was dragged from when the drop couldn't be saved
+  #undoDrop(card, { parent, nextSibling, wasPostponed }) {
+    card.classList.toggle("card--postponed", wasPostponed)
+
+    if (card.isConnected) parent.insertBefore(card, nextSibling)
+  }
+
+  // How to save a card being dropped on the place it was dropped on
+  #actionForDropping(card, container) {
+    const { dragAndDropStatus: status, dragAndDropColumnId: columnId } = container.dataset
+
+    if (status === "maybe" && card.dataset.cardTriageUrl) {
+      return { method: "delete", url: card.dataset.cardTriageUrl }
+    } else if (status === "not_now" && card.dataset.cardNotNowUrl) {
+      return { method: "post", url: card.dataset.cardNotNowUrl }
+    } else if (status === "closed" && card.dataset.cardClosureUrl) {
+      return { method: "post", url: card.dataset.cardClosureUrl }
+    } else if (card.dataset.cardTriageUrl && columnId) {
+      return { method: "post", url: card.dataset.cardTriageUrl, query: { column_id: columnId } }
+    }
+  }
+}
