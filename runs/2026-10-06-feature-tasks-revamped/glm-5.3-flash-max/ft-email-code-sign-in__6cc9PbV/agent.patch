+class JoinCodes::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    @identity = Signup.new(email_address: "newperson@example.com").tap(&:create_identity).identity
+    @sign_in_code = SignInCode.generate_for(@identity)
+  end
+
+  test "new" do
+    get join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: @sign_in_code.token)
+
+    assert_response :success
+    assert_in_body @identity.email_address
+      assert_select "input[name='code']"
+  end
+
+  test "new with an unknown token" do
+    get join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: "nonsense")
+
+    assert_redirected_to join_url(code: @join_code.code, script_name: @account.slug)
+  end
+
+  test "new with an inactive join code" do
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    get join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: @sign_in_code.token)
+
+    assert_response :gone
+  end
+
+  test "create with the code that was emailed joins the account" do
+    assert_difference -> { User.count }, +1 do
+      post join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: @sign_in_code.token),
