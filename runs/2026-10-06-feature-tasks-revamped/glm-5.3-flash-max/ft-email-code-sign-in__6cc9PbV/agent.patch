+    end
+
+    assert_redirected_to new_users_join_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+
+    user = User.active.find_by!(account: @account, identity: @identity)
+    assert user.verified?, "Joining with a code should prove the email address"
+    assert_equal 1, @join_code.reload.usage_count
+  end
+
+  test "create with the code that was emailed for someone who is already on the account" do
+    sign_in_code = SignInCode.generate_for(identities(:david))
+
+    assert_no_difference -> { User.count } do
+      post join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: sign_in_code.token),
+        params: { code: sign_in_code.code }
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create with another code" do
+    assert_no_difference -> { User.count } do
+      post join_email_code_path(join_code: @join_code.code, script_name: @account.slug, token: @sign_in_code.token),
+        params: { code: "XXXXXX" }
+    end
+
+    assert_response :redirect
+    assert_match join_email_code_path(join_code: @join_code.code), @response.redirect_url
+    assert_not cookies[:session_token].present?
+    assert_equal 0, @join_code.reload.usage_count
+  end
+end
