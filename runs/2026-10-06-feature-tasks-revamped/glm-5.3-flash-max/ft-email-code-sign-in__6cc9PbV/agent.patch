+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    untenanted do
+      get new_session_email_code_path(token: sign_in_code.token)
+
+      assert_response :success
+      assert_in_body @identity.email_address
+      assert_in_body "15 minutes"
+      assert_select "input[name='code']"
+    end
+  end
+
+  test "new with an unknown token" do
+    untenanted do
+      get new_session_email_code_path(token: "nonsense")
+
+      assert_redirected_to new_session_path
+      assert_equal SignInCodeVerification::EXPIRED_CODE_MESSAGE, flash[:alert]
+    end
+  end
+
+  test "new for an authenticated user" do
+    sign_in_as @identity
+
+    untenanted do
+      get new_session_email_code_path(token: SignInCode.generate_for(@identity).token)
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create with the code that was emailed" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      assert_difference -> { Session.count }, +1 do
+        post session_email_code_path(token: sign_in_code.token), params: { code: sign_in_code.code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with the code in lowercase" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_email_code_path(token: sign_in_code.token), params: { code: sign_in_code.code.downcase }
+
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "create with another code" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path(token: sign_in_code.token), params: { code: "XXXXXX" }
+      end
+
+      assert_response :redirect
+      assert_match new_session_email_code_path, @response.redirect_url
+      assert_equal SignInCodeVerification::INVALID_CODE_MESSAGE, flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with a code that was already used" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_email_code_path(token: sign_in_code.token), params: { code: sign_in_code.code }
+      sign_out
+
+      post session_email_code_path(token: sign_in_code.token), params: { code: sign_in_code.code }
+
+      assert_response :redirect
+      assert_match new_session_email_code_path, @response.redirect_url
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    sign_in_code = SignInCode.generate_for(@identity)
+    token = sign_in_code.token
+
+    travel SignInCode::EXPIRY_DURATION + 1.minute do
+      untenanted do
+        post session_email_code_path(token: token), params: { code: sign_in_code.code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create without a pending sign-in request" do
+    untenanted do
+      post session_email_code_path, params: { code: "XXXXXX" }
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create via JSON" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_email_code_path(format: :json), params: { token: sign_in_code.token, code: sign_in_code.code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create via JSON with another code" do
+    sign_in_code = request_sign_in_code(@identity.email_address)
+
+    untenanted do
+      post session_email_code_path(format: :json), params: { token: sign_in_code.token, code: "XXXXXX" }
+
+      assert_response :unauthorized
+      assert_equal SignInCodeVerification::INVALID_CODE_MESSAGE, @response.parsed_body["message"]
+    end
+  end
+
+  private
+    # Signs in by email up to the point where the code is emailed out.
+    def request_sign_in_code(email_address)
+      untenanted do
+        assert_emails 1 do
+          post session_path, params: { email_address: email_address }
+        end
+
+        assert_response :redirect
+        assert_match new_session_email_code_path, @response.redirect_url
+      end
+
+      SignInCode.last
+    end
+end
