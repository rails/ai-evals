@@ -0,0 +1,54 @@
+class JoinCodes::EmailCodesController < ApplicationController
+  include SignInCodeVerification
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    show_sign_in_code_form
+  end
+
+  def create
+    check_sign_in_code
+  end
+
+  private
+    def start_of_sign_in_by_email_url
+      join_url(code: @join_code.code, tenant: params[:tenant])
+    end
+
+    def new_sign_in_code_url
+      join_email_code_url(join_code: @join_code.code, token: params[:token])
+    end
+
+    # Joining continues with naming yourself in the account, unless that's
+    # already done.
+    def sign_in_code_checked
+      @join_code.redeem_if { |account| @sign_in_code.identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: @sign_in_code.identity)
+      user.verify
+
+      if user.setup?
+        redirect_to landing_url(script_name: @join_code.account.slug)
+      else
+        redirect_to new_users_join_url(script_name: @join_code.account.slug)
+      end
+    end
+
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
