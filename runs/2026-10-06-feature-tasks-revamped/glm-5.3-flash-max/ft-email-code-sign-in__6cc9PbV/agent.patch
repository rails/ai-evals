@@ -0,0 +1,99 @@
+require "test_helper"
+
+class SignInCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generate_for creates a code with six characters" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert_equal SignInCode::CODE_LENGTH, sign_in_code.code.length
+    assert_match(/\A[A-Z2-9]+\z/, sign_in_code.code)
+  end
+
+  test "generate_for expires any code still in use" do
+    first = SignInCode.generate_for(@identity)
+    second = SignInCode.generate_for(@identity)
+
+    assert_not SignInCode.exists?(first.id)
+    assert second.unused?
+  end
+
+  test "generate_for expires the code after fifteen minutes" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert_in_delta SignInCode::EXPIRY_DURATION.from_now, sign_in_code.expires_at, 1.second
+  end
+
+  test "issue_for enqueues the email with the code" do
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      @sign_in_code = SignInCode.issue_for(@identity)
+    end
+  end
+
+  test "verify with the code that was sent" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert sign_in_code.verify(sign_in_code.code)
+    assert sign_in_code.reload.used_at.present?
+  end
+
+  test "verify is case insensitive and ignores whitespace" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert sign_in_code.verify(" #{sign_in_code.code.downcase} ")
+  end
+
+  test "verify with another code" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert_not sign_in_code.verify("WRONG!")
+    assert sign_in_code.reload.unused?
+  end
+
+  test "verify with a code that was already used" do
+    sign_in_code = SignInCode.generate_for(@identity)
+    sign_in_code.verify(sign_in_code.code)
+
+    assert_not sign_in_code.reload.verify(sign_in_code.code)
+  end
+
+  test "verify with an expired code" do
+    sign_in_code = SignInCode.generate_for(@identity)
+    travel SignInCode::EXPIRY_DURATION + 1.second do
+      assert_not sign_in_code.verify(sign_in_code.code)
+    end
+
+    assert sign_in_code.reload.unused?
+  end
+
+  test "find_by_token with the token of a code" do
+    sign_in_code = SignInCode.generate_for(@identity)
+
+    assert_equal sign_in_code, SignInCode.find_by_token(sign_in_code.token)
+  end
+
+  test "find_by_token with a tampered token" do
+    assert_nil SignInCode.find_by_token("nonsense")
+  end
+
+  test "find_by_token with the token of an expired code" do
+    sign_in_code = SignInCode.generate_for(@identity)
+    token = sign_in_code.token
+
+    travel SignInCode::EXPIRY_DURATION + 1.second do
+      assert_nil SignInCode.find_by_token(token)
+    end
+  end
+
+  test "cleanup removes expired codes" do
+    expired = @identity.sign_in_codes.create!(code: "OLDOLD", expires_at: 1.minute.ago)
+    active = SignInCode.generate_for(@identity)
+
+    SignInCode.cleanup
+
+    assert_not SignInCode.exists?(expired.id)
+    assert SignInCode.exists?(active.id)
+  end
+end
