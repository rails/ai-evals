new file mode 100644
index 0000000..d4fd2b7
--- /dev/null
+++ b/app/controllers/concerns/sign_in_code_verification.rb
@@ -0,0 +1,59 @@
+# The second step of signing in by email: the person enters the code that was
+# emailed to them to prove they own the email address. Sign-ups and joins with
+# a join code use the same flow.
+module SignInCodeVerification
+  extend ActiveSupport::Concern
+
+  EXPIRED_CODE_MESSAGE = "That code has expired. Enter your email to start again."
+  INVALID_CODE_MESSAGE = "That code didn't work. Try again."
+
+  private
+    # Shows the screen where the code is entered, or sends the person back to
+    # where they entered their email address when there's no code to check.
+    def show_sign_in_code_form
+      if @sign_in_code = SignInCode.find_by_token(params[:token])
+        render :new
+      else
+        redirect_to start_of_sign_in_by_email_url, alert: EXPIRED_CODE_MESSAGE
+      end
+    end
+
+    # Signs the person in when they entered the code they were emailed.
+    def check_sign_in_code
+      if @sign_in_code = SignInCode.find_by_token(params[:token])
+        if @sign_in_code.verify(params.expect(:code))
+          start_new_session_for @sign_in_code.identity
+          sign_in_code_checked
+        else
+          reject_sign_in_code
+        end
+      else
+        redirect_to start_of_sign_in_by_email_url, alert: EXPIRED_CODE_MESSAGE
+      end
+    end
+
+    def reject_sign_in_code
+      respond_to do |format|
+        format.html { redirect_to new_sign_in_code_url, alert: INVALID_CODE_MESSAGE }
+        format.json { render json: { message: INVALID_CODE_MESSAGE }, status: :unauthorized }
+      end
+    end
+
+    # Where to enter an email address to be sent a new code.
+    def start_of_sign_in_by_email_url
+      new_session_url
+    end
+
+    # Where the code is entered.
+    def new_sign_in_code_url
+      new_session_email_code_url(token: params[:token])
+    end
+
+    # What happens once the code checked out and the person is signed in.
+    def sign_in_code_checked
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+end
diff --git a/app/controllers/join_codes/email_codes_controller.rb b/app/controllers/join_codes/email_codes_controller.rb
