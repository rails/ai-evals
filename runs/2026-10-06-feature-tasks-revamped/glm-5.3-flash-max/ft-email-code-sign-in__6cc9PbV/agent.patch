diff --git a/app/models/sign_in_code.rb b/app/models/sign_in_code.rb
new file mode 100644
index 0000000..6f1332e
--- /dev/null
+++ b/app/models/sign_in_code.rb
@@ -0,0 +1,68 @@
+class SignInCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY_DURATION = 15.minutes
+  CODE_CHARACTERS = ([ *("A".."Z"), *("2".."9") ] - %w[ I L O ]).freeze
+
+  belongs_to :identity
+
+  scope :active, -> { where(used_at: nil).where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  before_create :generate_code, if: -> { code.blank? }
+
+  class << self
+    # Generates a fresh code for the identity and emails it to them.
+    def issue_for(identity)
+      generate_for(identity).tap do |sign_in_code|
+        IdentityMailer.sign_in_code(sign_in_code).deliver_later
+      end
+    end
+
+    def generate_for(identity)
+      identity.sign_in_codes.active.destroy_all
+
+      identity.sign_in_codes.create!(expires_at: EXPIRY_DURATION.from_now)
+    end
+
+    def find_by_token(token)
+      find_signed(token, purpose: :sign_in_code)
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+  end
+
+  def verify(candidate_code)
+    if unused? && !expired? && matches?(candidate_code)
+      touch(:used_at)
+      true
+    else
+      false
+    end
+  end
+
+  def unused?
+    used_at.nil?
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def token
+    signed_id(purpose: :sign_in_code, expires_in: EXPIRY_DURATION)
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_CHARACTERS.sample(random: SecureRandom) }.join
+        break candidate unless identity.sign_in_codes.exists?(code: candidate)
+      end
+    end
+
+    def matches?(candidate_code)
+      ActiveSupport::SecurityUtils.secure_compare(code, candidate_code.to_s.strip.upcase)
+    end
+end
