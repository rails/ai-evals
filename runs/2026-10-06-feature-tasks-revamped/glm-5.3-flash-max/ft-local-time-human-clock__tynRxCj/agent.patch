diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..ee0ac9c
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders an empty element carrying the raw timestamp" do
+    travel_to Time.zone.parse("2026-03-10 14:00") do
+      assert_dom_equal \
+        %(<time datetime="#{Time.current.iso8601}" data-controller="time" data-time-format-value="relative"></time>),
+        local_time_tag(Time.current)
+    end
+  end
+
+  test "renders a timestamp in a requested format" do
+    travel_to Time.zone.parse("2026-03-10 14:00") do
+      assert_dom_equal \
+        %(<time datetime="#{2.hours.ago.iso8601}" data-controller="time" data-time-format-value="ago"></time>),
+        local_time_tag(2.hours.ago, format: :ago)
+    end
+  end
+
+  test "anchors a bare date to the start of the day" do
+    date = Date.new(2026, 3, 10)
+
+    assert_dom_equal \
+      %(<time datetime="#{date.beginning_of_day.iso8601}" data-controller="time" data-time-format-value="day"></time>),
+      local_time_tag(date, format: :day)
+  end
+
+  test "carries extra attributes along" do
+    travel_to Time.zone.parse("2026-03-10 14:00") do
+      assert_dom_equal \
+        %(<time datetime="#{Time.current.iso8601}" data-controller="time" data-time-format-value="relative" class="txt-subtle"></time>),
+        local_time_tag(Time.current, class: "txt-subtle")
+    end
+  end
+end
diff --git a/test/integration/raw_timestamps_test.rb b/test/integration/raw_timestamps_test.rb
new file mode 100644
index 0000000..134a6eb
--- /dev/null
+++ b/test/integration/raw_timestamps_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class RawTimestampsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "a card ships raw timestamps instead of rendered times" do
+    get card_path(cards(:logo))
+
+    assert_response :success
+    assert_select "time[datetime]"
+    assert_select "time", text: /\S/, count: 0
+  end
+
+  test "a comment permalink carries the moment it was written" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(comment.card)
+
+    assert_includes response.body, %(<time datetime="#{comment.created_at.iso8601}" data-controller="time" data-time-format-value="relative")
+  end
+
+  test "a card's meta carries its timestamps as elapsed time" do
+    get card_path(cards(:logo))
+
+    assert_select "time[data-time-format-value=ago]", count: 2
+  end
+
+  test "a card that will auto-postpone carries the moment it closes" do
+    get card_path(cards(:logo))
+
+    assert_includes response.body, %(datetime="#{cards(:logo).entropy.auto_clean_at.iso8601}")
+  end
+
+  test "a closed card carries the moment it was completed" do
+    get card_path(cards(:shipping))
+
+    assert_includes response.body, %(datetime="#{cards(:shipping).closed_at.iso8601}" data-controller="time" data-time-format-value="full_date")
+  end
+
+  test "every page ships raw timestamps instead of rendered times" do
+    pages = [
+      root_path,
+      board_path(boards(:writebook)),
+      user_path(users(:kevin)),
+      tray_notifications_path,
+      search_path(q: "logo"),
+      my_access_tokens_path
+    ]
+
+    pages.each do |path|
+      get path
+
+      assert_response :success, "Expected #{path} to render"
+      assert_select "time", text: /\S/, count: 0, message: "Expected #{path} to leave timestamps to the browser"
+    end
+  end
+end
diff --git a/test/system/time_rendering_test.rb b/test/system/time_rendering_test.rb
new file mode 100644
index 0000000..d921dde
--- /dev/null
+++ b/test/system/time_rendering_test.rb
@@ -0,0 +1,51 @@
+require "application_system_test_case"
+
+class TimeRenderingTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+  end
+
+  test "timestamps are rendered by the browser" do
+    visit card_url(@card)
+    assert_selector "h1", text: @card.title
+
+    assert_operator timestamp_count, :>, 0, "expected the page to show timestamps"
+    assert_equal timestamp_count, rendered_timestamp_count, "expected every timestamp to be rendered"
+  end
+
+  test "timestamps survive a broadcast refresh" do
+    visit card_url(@card)
+    assert_selector "h1", text: @card.title
+    assert_equal timestamp_count, rendered_timestamp_count
+
+    update_card_elsewhere
+    assert_text "changed the title", wait: 5
+
+    assert_equal timestamp_count, rendered_timestamp_count, "expected timestamps to survive the refresh"
+  end
+
+  private
+    # An empty <time> element renders nothing, so a timestamp the browser never
+    # filled in reads as a gap in the page.
+    def timestamp_count
+      page.evaluate_script("document.querySelectorAll('time').length")
+    end
+
+    def rendered_timestamp_count
+      page.evaluate_script("Array.from(document.querySelectorAll('time')).filter(time => time.textContent.length > 0).length")
+    end
+
+    def update_card_elsewhere
+      wait_for_cable_subscriptions
+      @card.update!(title: "Retitled elsewhere", description: "Description updated elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
