diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..8fd8f5a
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTime } from "helpers/date_helpers"
+
+// The server renders timestamps as empty <time datetime> elements so that pages can
+// be cached and shared between people. This fills them in, in the viewer's own
+// timezone. A broadcasted page refresh morphs the page back to the server's empty
+// markup, hence the re-render on `turbo:morph-element`.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.element.addEventListener("turbo:morph-element", this.#render)
+    this.#render()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.#render)
+  }
+
+  formatValueChanged() {
+    this.#render()
+  }
+
+  #render = () => {
+    const date = this.#date
+    if (!date) return
+
+    this.element.textContent = formatTime(date, this.formatValue)
+    this.element.title ||= formatTime(date, "full_datetime")
+  }
+
+  get #date() {
+    const timestamp = this.element.getAttribute("datetime")
+    if (!timestamp) return null
+
+    const date = new Date(timestamp)
+
+    return isNaN(date) ? null : date
+  }
+}
