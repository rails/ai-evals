diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..5ac61f8 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,23 @@
 module TimeHelper
+  # Times are rendered by the browser, in the viewer's own timezone, so the server
+  # only ships the raw timestamp and leaves the element empty. That keeps rendered
+  # pages the same for everybody, and therefore cacheable. TimeController turns the
+  # timestamp into words, following the formats in app/javascript/helpers/date_helpers.js.
+  def local_time_tag(date_or_time, format: :relative, **options)
+    data = { controller: "time", time_format_value: format }
+    data = data.merge(options.delete(:data) || {})
+
+    tag.time datetime: timestamp_of(date_or_time), data: data, **options
+  end
+
+  private
+    # A bare date has no offset to travel with, so we anchor it to the start of the
+    # day in the zone we're rendering with.
+    def timestamp_of(date_or_time)
+      if date_or_time.is_a?(Date) && !date_or_time.is_a?(DateTime)
+        date_or_time.beginning_of_day
+      else
+        date_or_time
+      end.iso8601
+    end
 end
