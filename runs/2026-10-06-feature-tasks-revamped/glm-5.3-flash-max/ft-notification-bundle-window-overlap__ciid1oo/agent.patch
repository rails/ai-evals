+require "test_helper"
+
+class Notification::EmailBundle::DeliveryJobTest < ActiveJob::TestCase
+  test "delivers the bundle" do
+    email_bundle = Notification::EmailBundle.create!(
+      user: users(:kevin),
+      starts_at: 1.hour.ago,
+      ends_at: Time.current
+    )
+
+    Notification::EmailBundle::DeliveryJob.perform_now(email_bundle)
+
+    assert email_bundle.reload.delivered?
+  end
+
+  test "a bundle that was dropped is discarded" do
+    kevin = users(:kevin)
+    kevin.settings.update!(bundle_email_frequency: "daily")
+    kevin.notifications.delete_all
+    notification = Notification.create!(user: kevin, source: events(:logo_published), creator: users(:david))
+    email_bundle = notification.reload.email_bundle
+
+    kevin.settings.update!(bundle_email_frequency: "never")
+
+    assert_nothing_raised do
+      Notification::EmailBundle::DeliveryJob.perform_now(email_bundle)
+    end
+  end
+end
