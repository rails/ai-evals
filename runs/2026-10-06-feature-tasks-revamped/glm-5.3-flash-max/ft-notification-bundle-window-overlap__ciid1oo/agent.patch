@@ -0,0 +1,38 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:kevin).settings
+  end
+
+  test "nobody gets a digest unless they ask for one" do
+    assert_equal "never", @settings.bundle_email_frequency
+  end
+
+  test "bundle_email_frequency accepts the four frequencies" do
+    User::Settings::BUNDLE_EMAIL_FREQUENCIES.each do |frequency|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert_equal frequency, @settings.reload.bundle_email_frequency
+    end
+  end
+
+  test "bundle_email_frequency rejects anything else" do
+    assert_raises ArgumentError do
+      @settings.update!(bundle_email_frequency: "hourly")
+    end
+  end
+
+  test "turning the digest off drops the window that is still open" do
+    @settings.update!(bundle_email_frequency: "daily")
+
+    user = @settings.user
+    Notification::EmailBundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 3.hours.from_now)
+    Notification::EmailBundle.create!(user: user, starts_at: 1.day.ago, ends_at: 1.day.ago + 4.hours, delivered_at: Time.current)
+
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_equal 1, user.email_bundles.count
+    assert user.email_bundles.sole.delivered?
+  end
+end
