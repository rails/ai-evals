diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..5ef099c
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @user.notifications.delete_all
+
+    travel_to Time.zone.local(2026, 7, 10, 9, 0, 0)
+  end
+
+  test "no window is opened for people who don't want a digest" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_notification_email_bundle do
+      create_notification
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    notification = create_notification
+
+    assert_equal Time.zone.local(2026, 7, 10, 9, 0, 0), notification.reload.email_bundle.starts_at
+    assert_equal Time.zone.local(2026, 7, 11, 9, 0, 0), notification.reload.email_bundle.ends_at
+  end
+
+  test "the window closes after the chosen frequency" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    notification = create_notification
+
+    assert_equal 4.hours, notification.reload.email_bundle.ends_at - notification.reload.email_bundle.starts_at
+  end
+
+  test "the window closes after a week when the digest is weekly" do
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    notification = create_notification
+
+    assert_equal 1.week, notification.reload.email_bundle.ends_at - notification.reload.email_bundle.starts_at
+  end
+
+  test "notifications that land while a window is open are batched into it" do
+    first = create_notification
+    travel 2.hours
+    second = create_notification(events(:layout_published))
+
+    assert_equal first.reload.email_bundle, second.reload.email_bundle
+    assert_equal 1, @user.email_bundles.count
+  end
+
+  test "a notification that lands after the window closed is batched into it" do
+    first = create_notification
+    travel 1.day + 1.hour
+    late = create_notification(events(:layout_published))
+
+    assert_equal first.reload.email_bundle, late.reload.email_bundle
+  end
+
+  test "a window is scheduled to be delivered when it closes" do
+    notification = nil
+
+    assert_enqueued_with job: Notification::EmailBundle::DeliveryJob,
+      at: Time.zone.local(2026, 7, 11, 9, 0, 0) do
+      notification = create_notification
+    end
+
+    assert_equal Time.zone.local(2026, 7, 11, 9, 0, 0), notification.reload.email_bundle.ends_at
+  end
+
+  test "one email is sent for the window when it closes" do
+    create_notification
+    travel 2.hours
+    create_notification(events(:layout_published))
+    travel 22.hours
+
+    assert_emails 1 do
+      perform_enqueued_jobs
+    end
+
+    assert @user.email_bundles.sole.delivered?
+  end
+
+  test "the email of a window is only sent once" do
+    create_notification
+    travel 1.day
+    perform_enqueued_jobs
+
+    assert_emails 0 do
+      @user.email_bundles.sole.deliver
+    end
+  end
+
+  test "a notification that gets a new event after its window closed moves on to the next one" do
+    notification = create_notification(events(:logo_published))
+    travel 1.day
+    perform_enqueued_jobs
+
+    assert_equal 1, @user.email_bundles.count
+
+    notification.update!(source: events(:logo_assignment_km), unread_count: 2, read_at: nil)
+
+    assert_equal 2, @user.email_bundles.count
+    assert_equal @user.email_bundles.ordered.last, notification.reload.email_bundle
+  end
+
+  test "reading a notification doesn't move it to another window" do
+    notification = create_notification
+    travel 1.hour
+
+    notification.read
+
+    assert_equal 1, @user.email_bundles.count
+    assert_equal @user.email_bundles.sole, notification.reload.email_bundle
+  end
+
+  test "a window without notifications doesn't email an empty digest" do
+    email_bundle = Notification::EmailBundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: Time.current)
+
+    assert_emails 0 do
+      email_bundle.deliver
+    end
+
+    assert email_bundle.reload.delivered?
+  end
+
+  test "a new window opens when the previous one closed" do
+    first = create_notification
+    travel 1.day
+    perform_enqueued_jobs
+    travel 3.hours
+
+    second = create_notification(events(:layout_published))
+
+    assert_not_equal first.reload.email_bundle, second.reload.email_bundle
+    assert_equal Time.zone.local(2026, 7, 11, 12, 0, 0), second.reload.email_bundle.starts_at
+  end
+
+  test "a notification that lands late opens a window that starts when the previous one closed" do
+    first = create_notification
+    travel 1.day
+    perform_enqueued_jobs
+    travel 3.hours
+
+    second = create_notification(events(:layout_published), created_at: 21.hours.ago)
+
+    assert_equal first.reload.email_bundle.ends_at, second.reload.email_bundle.starts_at
+  end
+
+  test "windows of a person never overlap" do
+    first = create_notification
+    travel 1.day
+    perform_enqueued_jobs
+
+    travel 3.hours
+    second = create_notification(events(:layout_published), created_at: 21.hours.ago)
+    travel 2.days
+    perform_enqueued_jobs
+
+    third = create_notification(events(:text_published), created_at: 3.days.ago)
+
+    assert_equal [ first.reload.email_bundle, second.reload.email_bundle, third.reload.email_bundle ],
+      @user.email_bundles.ordered.to_a
+
+    @user.email_bundles.ordered.each_cons(2) do |window, following|
+      assert_operator following.starts_at, :>=, window.ends_at
+    end
+  end
+
+  test "turning the digest off drops the window that is still open" do
+    create_notification
+
+    assert_difference -> { @user.email_bundles.count }, -1 do
+      @user.settings.update!(bundle_email_frequency: "never")
+    end
+  end
+
+  private
+    def assert_no_notification_email_bundle(&block)
+      assert_no_difference -> { @user.email_bundles.count }, &block
+    end
+
+    def create_notification(source = events(:logo_published), created_at: Time.current)
+      Notification.create!(user: @user, source: source, creator: users(:david), created_at: created_at)
+    end
+end
