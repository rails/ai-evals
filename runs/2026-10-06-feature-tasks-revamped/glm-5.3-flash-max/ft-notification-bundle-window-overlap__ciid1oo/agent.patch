diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..875f5e7
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,94 @@
+class Notification::EmailBundle < ApplicationRecord
+  DURATIONS_BY_FREQUENCY = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, -> { order(:created_at) }, inverse_of: :email_bundle, dependent: :nullify
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :overdue, -> { undelivered.where(ends_at: ...Time.current) }
+  scope :ordered, -> { order(:starts_at) }
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    # Files a notification in the window that is open for its user and opens a new window
+    # when none is. The clock of a window starts when the first notification lands in it,
+    # and it closes after the person's chosen frequency. A notification that gets a new
+    # event after its window closed moves on to the window that follows.
+    def add(notification)
+      if duration = duration_for(notification.user)
+        email_bundle = window_for(notification, duration: duration)
+        if notification.email_bundle_id != email_bundle.id
+          # Filing bypasses the callbacks so that it doesn't broadcast the notification again.
+          notification.update_columns(email_bundle_id: email_bundle.id)
+        end
+        email_bundle.deliver_later if email_bundle.overdue?
+        email_bundle
+      end
+    end
+
+    private
+      def window_for(notification, duration:)
+        notification.user.with_lock do
+          current_for(notification.user) ||
+            open_for(notification.user, at: notification.created_at, duration: duration)
+        end
+      end
+
+      def current_for(user)
+        undelivered.find_by(user: user)
+      end
+
+      # Locking the person serializes window creation, so two notifications landing at the
+      # same time can never open two overlapping windows. Since a window only opens once
+      # the previous one closed, a notification that lands late is filed in the window that
+      # has already opened.
+      def open_for(user, at:, duration:)
+        starts_at = if previous_window = user.email_bundles.ordered.last
+          [ at, previous_window.ends_at ].max
+        else
+          at
+        end
+
+        create!(user: user, starts_at: starts_at, ends_at: starts_at + duration)
+      end
+
+      def duration_for(user)
+        return unless user.active? && user.account.active?
+
+        DURATIONS_BY_FREQUENCY[user.settings&.bundle_email_frequency]
+      end
+  end
+
+  def deliver_later
+    Notification::EmailBundle::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    with_lock do
+      unless delivered?
+        NotificationMailer.bundle(self).deliver_now if notifications.any?
+        update! delivered_at: Time.current
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def overdue?
+    !delivered? && ends_at.past?
+  end
+
+  private
+    def schedule_delivery
+      Notification::EmailBundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
