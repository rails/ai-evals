+class Notification::EmailBundle::DeliveryJob < ApplicationJob
+  include SmtpDeliveryErrorHandling
+
+  # The bundle may have been dropped while we were waiting for its window to close.
+  discard_on ActiveRecord::RecordNotFound
+
+  def perform(email_bundle)
+    email_bundle.deliver
+  end
+end
