+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @search.term,
+      placeholder: "Search cards…",
+      class: "input",
+      autofocus: true,
+      autocorrect: "off",
+      autocomplete: "off",
+      spellcheck: false,
+      aria: { label: "Search cards" } %>
+    <%= button_tag class: "btn btn--circle search__submit", name: nil do %>
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="blank-slate">Type something to search cards, their descriptions, and their comments</div>
+  <% elsif @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <ul class="search__results">
+        <%= render partial: "searches/match", collection: @page.records, as: :card, locals: { search: @search } %>
+      </ul>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">No cards match “<%= @search.term %>”</div>
+  <% end %>
+</section>
