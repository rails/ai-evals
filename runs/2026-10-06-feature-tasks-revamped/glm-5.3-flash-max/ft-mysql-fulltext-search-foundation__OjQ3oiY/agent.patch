diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..13beadf
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,67 @@
+# Finds published cards matching a term in their title, their description, or
+# the body of any of their comments. Only cards on boards the user has access
+# to are ever considered.
+class Search
+  attr_reader :user, :term
+
+  def initialize(user:, term: nil)
+    @user = user
+    @term = term.to_s.strip
+  end
+
+  def cards
+    if term.blank?
+      user.accessible_cards.none
+    else
+      user.accessible_cards.published
+        .merge(matching_cards)
+        .reverse_chronologically
+        .with_rich_text_description
+        .preload(:board, comments: :rich_text_body)
+    end
+  end
+
+  # Every word of the term has to match somewhere on a card for it to be a hit.
+  def terms
+    term.split
+  end
+
+  def blank?
+    term.blank?
+  end
+
+  def match(card)
+    Match.new card: card, terms: terms
+  end
+
+  private
+    def matching_cards
+      terms.collect { |word| cards_matching_word(word) }.inject(&:and)
+    end
+
+    def cards_matching_word(word)
+      Card.where matching_word_clause, word: pattern_for(word), card: Card.polymorphic_name, comment: Comment.polymorphic_name
+    end
+
+    def pattern_for(word)
+      "%#{ActiveRecord::Base.sanitize_sql_like(word)}%"
+    end
+
+    def matching_word_clause
+      <<~SQL.squish
+        cards.title LIKE :word
+        OR cards.id IN (
+          SELECT rich_texts.record_id FROM action_text_rich_texts rich_texts
+          WHERE rich_texts.record_type = :card
+            AND rich_texts.name = 'description'
+            AND rich_texts.body LIKE :word
+        )
+        OR cards.id IN (
+          SELECT comments.card_id FROM comments
+          JOIN action_text_rich_texts rich_texts
+            ON rich_texts.record_type = :comment AND rich_texts.record_id = comments.id AND rich_texts.name = 'body'
+          WHERE rich_texts.body LIKE :word
+        )
+      SQL
+    end
+end
diff --git a/app/models/search/excerpt.rb b/app/models/search/excerpt.rb
new file mode 100644
index 0000000..7f48696
--- /dev/null
+++ b/app/models/search/excerpt.rb
@@ -0,0 +1,40 @@
+class Search
+  # Cuts a text down to size, keeping the part where any of the terms appears.
+  class Excerpt
+    LENGTH = 200
+    CONTEXT = 80
+
+    def initialize(text:, terms:)
+      @text = text.to_s
+      @terms = terms
+    end
+
+    def to_s
+      if index = first_match_index
+        window_around index
+      else
+        @text.first(LENGTH)
+      end
+    end
+
+    private
+      def first_match_index
+        @terms.collect { |term| @text.index(/#{Regexp.escape(term)}/i) }.compact.min
+      end
+
+      def window_around(index)
+        start = [ index - CONTEXT, 0 ].max
+        window = @text[start, LENGTH].strip
+
+        "#{ellipsis(start)}#{window}#{ellipsis_tail(start)}"
+      end
+
+      def ellipsis(start)
+        "\u2026" unless start.zero?
+      end
+
+      def ellipsis_tail(start)
+        "\u2026" if start + LENGTH < @text.length
+      end
+  end
+end
