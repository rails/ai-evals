@@ -0,0 +1,23 @@
+class Search
+  # Wraps every occurrence of any of the terms in a <mark> element. The text is
+  # escaped first, so the result is safe to render as HTML.
+  class Highlight
+    def initialize(text, terms)
+      @text = text.to_s
+      @terms = terms
+    end
+
+    def to_html
+      ERB::Util.html_escape(@text).gsub(pattern) { |matched| "<mark>#{matched}</mark>" }.html_safe
+    end
+
+    private
+      def pattern
+        @pattern ||= /#{Regexp.union(escaped_terms).source}/i
+      end
+
+      def escaped_terms
+        @escaped_terms ||= @terms.collect { |term| ERB::Util.html_escape(term) }
+      end
+  end
+end
diff --git a/app/models/search/match.rb b/app/models/search/match.rb
new file mode 100644
index 0000000..9e00f72
--- /dev/null
+++ b/app/models/search/match.rb
@@ -0,0 +1,51 @@
+class Search
+  # A single search hit: a card plus the title and excerpt to show for it, with
+  # the matched words highlighted.
+  class Match
+    attr_reader :card, :terms
+
+    def initialize(card:, terms:)
+      @card = card
+      @terms = terms
+    end
+
+    def title
+      highlight(card.title).to_html
+    end
+
+    def excerpt
+      highlight(excerpt_text).to_html
+    end
+
+    def excerpt?
+      excerpt_text.present?
+    end
+
+    private
+      def excerpt_text
+        @excerpt_text ||= Excerpt.new(text: matched_context_text || description_text, terms: terms).to_s
+      end
+
+      # The description or comment that matched, so we can show the context of
+      # the match instead of repeating the title.
+      def matched_context_text
+        [ description_text, *comments_text ].find { |text| text_matches? text }
+      end
+
+      def description_text
+        card.description&.body&.to_plain_text.to_s.squish
+      end
+
+      def comments_text
+        card.comments.collect { |comment| comment.body.to_plain_text.squish }
+      end
+
+      def text_matches?(text)
+        terms.any? { |term| text.match?(/#{Regexp.escape(term)}/i) }
+      end
+
+      def highlight(text)
+        Highlight.new text, terms
+      end
+  end
+end
