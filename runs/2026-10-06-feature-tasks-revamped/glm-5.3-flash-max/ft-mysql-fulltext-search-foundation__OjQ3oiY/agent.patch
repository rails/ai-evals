+require "application_system_test_case"
+
+class SearchSystemTest < ApplicationSystemTestCase
+  test "searching for cards from the menu" do
+    sign_in_as(users(:david))
+
+    find("button.nav__trigger").click
+    click_on "Search cards"
+
+    assert_selector "h1", text: "Search"
+
+    fill_in "q", with: "logo"
+    click_on "Search"
+
+    assert_selector ".search__result-title", text: /logo/i
+    assert_selector "mark", text: "logo"
+  end
+
+  test "searching without any matches" do
+    sign_in_as(users(:david))
+
+    visit search_url(q: "haggis")
+
+    assert_selector ".blank-slate", text: "No cards match \u201Chaggis\u201D"
+  end
+end
