diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f8810db
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "search finds cards by title" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search__result-title", text: cards(:logo).title
+  end
+
+  test "search finds cards by description" do
+    boards(:writebook).cards.create! creator: users(:david), title: "Anything", status: :published, description: "A most unusual word: haggis"
+
+    get search_path, params: { q: "haggis" }
+
+    assert_response :success
+    assert_select ".search__result-title", text: "Anything"
+    assert_select ".search__result-excerpt", text: /haggis/i
+  end
+
+  test "search finds cards by comment body" do
+    cards(:logo).comments.create! creator: users(:david), body: "What about the kerning of the letters?"
+
+    get search_path, params: { q: "kerning" }
+
+    assert_response :success
+    assert_select ".search__result-title", text: cards(:logo).title
+    assert_select ".search__result-excerpt", text: /kerning/i
+  end
+
+  test "matched words are highlighted" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "mark", "logo"
+  end
+
+  test "search is ordered by newest first" do
+    boards(:writebook).cards.create! creator: users(:david), title: "Older logo note", created_at: 3.days.ago, status: :published
+    boards(:writebook).cards.create! creator: users(:david), title: "Newer logo note", created_at: 1.minute.ago, status: :published
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_equal [ "Newer logo note", "Older logo note", cards(:logo).title ], titles
+  end
+
+  test "only shows cards on boards you have access to" do
+    boards(:private).cards.create! creator: users(:kevin), title: "Secret logo plans", status: :published
+
+    get search_path, params: { q: "Secret" }
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "drafted cards and their comments never turn up" do
+    # Cards can only be commented on while published, which is how an imported
+    # draft can end up carrying comments.
+    card = boards(:writebook).cards.create! creator: users(:david), title: "Unfinished logo sketch", status: :published
+    card.comments.create! creator: users(:david), body: "Still thinking about the logo"
+    card.update! status: :drafted
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select ".search__result-title", text: "Unfinished logo sketch", count: 0
+    assert_select ".search__result-excerpt", text: /Still thinking/, count: 0
+  end
+
+  test "every word of the query has to match" do
+    cards(:logo).comments.create! creator: users(:david), body: "What about the kerning of the letters?"
+
+    get search_path, params: { q: "logo kerning" }
+
+    assert_select ".search__result-title", text: cards(:logo).title
+  end
+
+  test "query is escaped before being highlighted" do
+    boards(:writebook).cards.create! creator: users(:david), title: "Logo <script>alert(1)</script>", status: :published
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_no_match(/<script>/, @response.body)
+  end
+
+  test "search without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "search results are paginated" do
+    16.times { |index| boards(:writebook).cards.create! creator: users(:david), title: "Pagination test card #{index}", status: :published }
+
+    get search_path, params: { q: "Pagination test" }
+
+    assert_select ".search__result", count: 15
+    assert_select ".pagination-link"
+
+    get search_path, params: { q: "Pagination test", page: 2 }
+
+    assert_select ".search__result", count: 1
+  end
+
+  private
+    def titles
+      Nokogiri::HTML.fragment(@response.body).css(".search__result-title").map(&:text)
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..ca817e2
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:logo).comments.create! creator: users(:david), body: "Kerning looks off"
+
+    assert_includes searchable_titles_for("logo"), cards(:logo).title
+    assert_includes searchable_titles_for("Kerning"), cards(:logo).title
+  end
+
+  test "every word of the term has to match" do
+    assert_empty Search.new(user: users(:david), term: "logo kerning").cards
+
+    cards(:logo).comments.create! creator: users(:david), body: "Kerning looks off"
+
+    assert_includes searchable_titles_for("logo kerning"), cards(:logo).title
+  end
+
+  test "only finds cards on boards the user has access to" do
+    secret = boards(:private).cards.create! creator: users(:kevin), title: "Secret logo plans", status: :published
+
+    assert_not_includes searchable_titles_for("Secret"), secret.title
+
+    assert_includes searchable_titles_for("logo", as: users(:kevin)), secret.title
+  end
+
+  test "never finds drafted cards or their comments" do
+    card = boards(:writebook).cards.create! creator: users(:david), title: "Unfinished logo sketch", status: :published
+    card.comments.create! creator: users(:david), body: "Still thinking about the logo"
+    card.update! status: :drafted
+
+    assert_not_includes searchable_titles_for("Unfinished"), "Unfinished logo sketch"
+    assert_empty Search.new(user: users(:david), term: "Still thinking").cards
+  end
+
+  test "orders results by newest first" do
+    older = boards(:writebook).cards.create! creator: users(:david), title: "Older logo note", created_at: 3.days.ago, status: :published
+    newer = boards(:writebook).cards.create! creator: users(:david), title: "Newer logo note", created_at: 1.minute.ago, status: :published
+
+    assert_equal [ newer, older, cards(:logo) ], Search.new(user: users(:david), term: "logo").cards
+  end
+
+  test "matches nothing without a term" do
+    assert_predicate Search.new(user: users(:david), term: ""), :blank?
+    assert_empty Search.new(user: users(:david), term: "").cards
+    assert_empty Search.new(user: users(:david), term: nil).cards
+  end
+
+  test "splits the term into words to highlight" do
+    assert_equal [ "logo", "kerning" ], Search.new(user: users(:david), term: "  logo   kerning ").terms
+  end
+
+  test "highlights every occurrence of the words" do
+    match = Search.new(user: users(:david), term: "logo").match cards(:logo)
+
+    assert_equal "The <mark>logo</mark> isn&#39;t big enough", match.title
+  end
+
+  test "excerpts the description or comment that matched" do
+    card = boards(:writebook).cards.create! creator: users(:david), title: "Anything", status: :published, description: "A most unusual word: haggis"
+
+    match = Search.new(user: users(:david), term: "haggis").match card
+
+    assert_equal "A most unusual word: <mark>haggis</mark>", match.excerpt
+  end
+
+  test "excerpt only includes the matched words in its marks" do
+    card = boards(:writebook).cards.create! creator: users(:david), title: "Anything", status: :published, description: "<script>alert(1)</script> haggis"
+
+    match = Search.new(user: users(:david), term: "haggis").match card
+
+    assert_no_match(/<script>/, match.excerpt)
+  end
+
+  test "matches wildcards literally" do
+    assert_empty Search.new(user: users(:david), term: "%").cards
+    assert_empty Search.new(user: users(:david), term: "_").cards
+  end
+
+  private
+    def searchable_titles_for(term, as: users(:david))
+      Search.new(user: as, term:).cards.collect(&:title)
+    end
+end
