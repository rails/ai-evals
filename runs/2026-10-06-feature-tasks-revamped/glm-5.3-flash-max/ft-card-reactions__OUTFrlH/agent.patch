diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..d0f2183
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @thumbs_up = "\u{1F44D}"
+    @david_reaction = @card.reactions.create!(content: @thumbs_up, reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: @thumbs_up, reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card), headers: { "Turbo-Frame" => dom_id(@card, :new_reaction) }
+
+    assert_response :success
+    assert_select "form.reaction__form[action=\"#{card_reactions_path(@card)}\"]"
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot react to a drafted card" do
+    card = boards(:writebook).cards.create!(creator: users(:david), status: :drafted)
+
+    assert_no_difference -> { card.reactions.count } do
+      post card_reactions_path(card), params: { reaction: { content: @thumbs_up } }
+      assert_response :forbidden
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: @thumbs_up } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @thumbs_up, @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/integration/card_reactions_test.rb b/test/integration/card_reactions_test.rb
new file mode 100644
index 0000000..b941127
--- /dev/null
+++ b/test/integration/card_reactions_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class CardReactionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail shows the card reactions and a boost trigger" do
+    reaction = @card.reactions.create!(content: "\u{1F44D}", reacter: users(:kevin))
+
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@card, :reacting)}" do
+      assert_select "##{dom_id(reaction)}"
+    end
+    assert_select "a[href=\"#{new_card_reaction_path(@card)}\"]"
+  end
+
+  test "card detail without reactions only shows the boost trigger" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@card, :reacting)} .reaction", count: 0
+    assert_select "a[href=\"#{new_card_reaction_path(@card)}\"]"
+  end
+
+  test "card preview shows the boost count when boosted" do
+    2.times { @card.reactions.create!(content: "\u{1F44D}", reacter: users(:kevin)) }
+
+    get board_column_path(@card.board, @card.column)
+
+    assert_response :success
+    assert_select ".card__boosts strong", text: "2"
+  end
+
+  test "card preview does not show the boost count when not boosted" do
+    get board_column_path(@card.board, @card.column)
+
+    assert_response :success
+    assert_select ".card__boosts", count: 0
+  end
+end
