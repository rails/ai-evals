+class NotificationMailer < ApplicationMailer
+  def bundle_email(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.newest_first
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      if @notifications.one?
+        "1 new notification"
+      else
+        "#{@notifications.size} new notifications"
+      end
+    end
+end
