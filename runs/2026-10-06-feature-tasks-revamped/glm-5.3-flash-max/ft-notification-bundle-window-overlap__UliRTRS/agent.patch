diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..1b8327a
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,88 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :newest_first, -> { order(starts_at: :desc) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+  validate :window_must_not_overlap_an_open_one, on: :create
+
+  class << self
+    # Collects the notification in the email bundle it belongs to and returns it.
+    # The clock starts when the first notification lands and runs for as long as
+    # the person asked to be emailed. Notifications that arrive late are
+    # collected in the window that already opened, so that windows are never
+    # expanded and never overlap.
+    def add(notification)
+      return unless (duration = notification.user.bundle_email_frequency_duration)
+      return if already_collected_in_an_open_window?(notification)
+
+      # The lock keeps two notifications landing at the same time from opening
+      # two overlapping windows.
+      bundle = notification.user.with_lock do
+        notification.user.notification_bundles.undelivered.newest_first.first ||
+          notification.user.notification_bundles.create!(starts_at: Time.current, ends_at: duration.from_now)
+      end
+
+      collect(notification, bundle) unless notification.bundle_id == bundle.id
+      bundle
+    end
+
+    def deliver_due
+      due.find_each(&:deliver)
+    end
+
+    # Whether the notification is already waiting in a window that hasn't been
+    # emailed yet. The window is looked up in the database, since the one the
+    # notification carries may be stale.
+    def already_collected_in_an_open_window?(notification)
+      notification.bundle_id && undelivered.exists?(notification.bundle_id)
+    end
+
+    # The windows of a person that overlap the given one.
+    def overlapping(bundle)
+      where(user: bundle.user).undelivered.where.not(id: bundle.id)
+        .where(starts_at: ...bundle.ends_at)
+        .where("ends_at > ?", bundle.starts_at)
+    end
+
+    private
+      # Written straight to the database because the notification has just been
+      # broadcast to the tray and shouldn't broadcast again.
+      def collect(notification, bundle)
+        notification.bundle = bundle
+        notification.update_columns(bundle_id: bundle.id)
+      end
+  end
+
+  def deliver
+    return if delivered?
+
+    NotificationMailer.bundle_email(self).deliver_later if deliverable?
+    update!(delivered_at: Time.current)
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def due?
+    !delivered? && ends_at <= Time.current
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active?
+    end
+
+    def window_must_not_overlap_an_open_one
+      if self.class.overlapping(self).exists?
+        errors.add(:starts_at, "overlaps another window")
+      end
+    end
+end
