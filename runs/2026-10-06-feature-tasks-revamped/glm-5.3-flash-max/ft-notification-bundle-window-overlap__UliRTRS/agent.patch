+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = user_settings(:david_settings)
+  end
+
+  test "bundle_email_frequency defaults to never" do
+    assert_equal "never", @settings.bundle_email_frequency
+  end
+
+  test "bundle_email_frequency can be turned off, every few hours, daily or weekly" do
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      @settings.bundle_email_frequency = frequency
+
+      assert @settings.valid?
+    end
+  end
+
+  test "bundle_email_frequency rejects everything else" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+  end
+
+  test "bundle_email_frequency_duration is the length of the window" do
+    assert_nil @settings.bundle_email_frequency_duration
+
+    {
+      "every_few_hours" => 4.hours,
+      "daily" => 1.day,
+      "weekly" => 1.week
+    }.each do |frequency, duration|
+      @settings.update!(bundle_email_frequency: frequency)
+
+      assert_equal duration, @settings.bundle_email_frequency_duration
+    end
+  end
+end
