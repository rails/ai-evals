+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "bundle_email is sent to the person, with every notification of the window" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) do
+      create_notification(events(:text_published))
+      create_notification(events(:shipping_published))
+    end
+
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) do
+      assert_emails 1 do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications", email.subject
+    assert_includes email.text_part.body.to_s, "The text is too small"
+    assert_includes email.text_part.body.to_s, "We need to ship the app"
+    assert_includes email.html_part.body.to_s, "The text is too small"
+    assert_includes email.html_part.body.to_s, "We need to ship the app"
+  end
+
+  test "bundle_email is not sent when the person opted out of email digests" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    assert_no_emails do
+      Notification::Bundle.deliver_due
+    end
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(user: @user, source: source, creator: users(:david))
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..0ed3eac
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,221 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "people who opted out of email digests don't get a bundle" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(events(:text_published))
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) do
+      bundle = create_notification(events(:text_published)).bundle
+
+      assert_equal Time.zone.local(2026, 1, 5, 9), bundle.starts_at
+      assert_equal Time.zone.local(2026, 1, 5, 13), bundle.ends_at
+      assert_not bundle.delivered?
+      assert_not bundle.due?
+    end
+  end
+
+  test "notifications that land within the window are collected in the same bundle" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) do
+      create_notification(events(:text_published))
+      create_notification(events(:shipping_published))
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, @user.notification_bundles.sole.notifications.count
+  end
+
+  test "notifications that arrive late are collected in the window that already opened" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    travel_to(Time.zone.local(2026, 1, 5, 11)) do
+      # This notification was created half an hour ago, but only lands now.
+      notification = create_notification(events(:shipping_published), created_at: 30.minutes.ago)
+
+      assert_equal @user.notification_bundles.sole, notification.bundle
+      assert_equal 2, notification.bundle.notifications.count
+      assert_equal Time.zone.local(2026, 1, 5, 9), notification.bundle.starts_at
+    end
+  end
+
+  test "notifications that land in a window that already closed are collected in it" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    travel_to(Time.zone.local(2026, 1, 5, 14)) do
+      notification = create_notification(events(:shipping_published))
+
+      assert_equal @user.notification_bundles.sole, notification.bundle
+      assert_equal Time.zone.local(2026, 1, 5, 9), notification.bundle.starts_at
+    end
+  end
+
+  test "a notification that lands after the window was emailed opens a new window" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) { Notification::Bundle.deliver_due }
+
+    travel_to(Time.zone.local(2026, 1, 5, 14)) do
+      bundle = create_notification(events(:shipping_published)).bundle
+
+      assert_equal Time.zone.local(2026, 1, 5, 14), bundle.starts_at
+      assert_equal Time.zone.local(2026, 1, 5, 18), bundle.ends_at
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "the frequency picked by the person sets the length of the window" do
+    { "daily" => 1.day, "weekly" => 1.week }.each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      travel_to(Time.zone.local(2026, 1, 5, 9)) do
+        bundle = create_notification(events(:text_published)).bundle
+
+        assert_equal duration.after(bundle.starts_at), bundle.ends_at
+      end
+
+      @user.notification_bundles.destroy_all
+      @user.notifications.destroy_all
+    end
+  end
+
+test "new activity on a card that was already emailed lands in the current window" do
+  travel_to(Time.zone.local(2026, 1, 5, 9)) do
+    @notification = create_notification(events(:text_published))
+  end
+
+  travel_to(Time.zone.local(2026, 1, 5, 13, 1)) { Notification::Bundle.deliver_due }
+  emailed_bundle = @notification.bundle
+
+  travel_to(Time.zone.local(2026, 1, 5, 14)) do
+    @notification.update!(source: events(:shipping_published), read_at: nil, unread_count: 2)
+    bundle = @user.notification_bundles.undelivered.sole
+
+    assert_equal bundle, @notification.reload.bundle
+    assert_not_equal emailed_bundle, bundle
+    assert_equal Time.zone.local(2026, 1, 5, 14), bundle.starts_at
+  end
+end
+
+  test "windows never overlap" do
+    Notification::Bundle.create!(user: @user, starts_at: 4.hours.ago, ends_at: Time.current)
+
+    overlapping = Notification::Bundle.new(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+    assert_not overlapping.valid?
+    assert overlapping.errors[:starts_at].one?
+  end
+
+  test "windows that touch each other don't overlap" do
+    Notification::Bundle.create!(user: @user, starts_at: 4.hours.ago, ends_at: Time.current)
+
+    touching = Notification::Bundle.new(user: @user, starts_at: Time.current, ends_at: 4.hours.from_now)
+
+    assert touching.valid?
+  end
+
+  test "delivered windows don't stand in the way of new ones" do
+    Notification::Bundle.create!(user: @user, starts_at: 8.hours.ago, ends_at: 4.hours.ago, delivered_at: 4.hours.ago)
+
+    next_window = Notification::Bundle.new(user: @user, starts_at: 2.hours.ago, ends_at: 2.hours.from_now)
+
+    assert next_window.valid?
+  end
+
+  test "windows of other people don't stand in the way" do
+    Notification::Bundle.create!(user: users(:david), starts_at: 4.hours.ago, ends_at: Time.current)
+
+    mine = Notification::Bundle.new(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+
+    assert mine.valid?
+  end
+
+  test "windows that close before they open are invalid" do
+    backwards = Notification::Bundle.new(user: @user, starts_at: Time.current, ends_at: 1.hour.ago)
+
+    assert_not backwards.valid?
+  end
+
+  test "deliver_due delivers every window that closed" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+    bundle = @user.notification_bundles.sole
+
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) do
+      assert bundle.due?
+
+      assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "a window that hasn't closed yet isn't delivered" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    travel_to(Time.zone.local(2026, 1, 5, 10)) do
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    assert_not @user.notification_bundles.sole.reload.delivered?
+  end
+
+  test "a window is only delivered once" do
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) do
+      Notification::Bundle.deliver_due
+
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    assert @user.notification_bundles.sole.reload.delivered?
+  end
+
+  test "inactive people don't get an email, but their window is closed" do
+    @user.deactivate
+    travel_to(Time.zone.local(2026, 1, 5, 9)) { create_notification(events(:text_published)) }
+
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) do
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        Notification::Bundle.deliver_due
+      end
+    end
+
+    assert @user.notification_bundles.sole.reload.delivered?
+  end
+
+  test "every person with a closed window gets their own email" do
+    users(:david).settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to(Time.zone.local(2026, 1, 5, 9)) do
+      create_notification(events(:text_published))
+      create_notification(events(:shipping_published), user: users(:david))
+    end
+
+    travel_to(Time.zone.local(2026, 1, 5, 13, 1)) do
+      assert_enqueued_jobs 2, only: ActionMailer::MailDeliveryJob do
+        Notification::Bundle.deliver_due
+      end
+    end
+  end
+
+  private
+    def create_notification(source, user: @user, created_at: nil)
+      Notification.create!(user: user, source: source, creator: users(:david), created_at: created_at)
+    end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
