+<tr>
+  <td>
+    <h1 class="title">Your Fizzy notifications</h1>
+    <p class="subtitle">Here's what happened on your boards while you were away.</p>
+
+    <% @notifications.group_by(&:board).each do |board, notifications| %>
+      <h2 class="notification__board"><%= link_to board.name, board_url(board, script_name: board.account.slug) %></h2>
