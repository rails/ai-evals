diff --git a/.kamal/hooks/pre-connect b/.kamal/hooks/pre-connect
new file mode 100755
index 0000000..8a29dea
--- /dev/null
+++ b/.kamal/hooks/pre-connect
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Stops a deploy before it connects, when config/deploy.yml still holds the
+# placeholder hostname or mail server. Otherwise the deploy would go through and
+# kamal-proxy would spend a while failing to get a certificate for the wrong host.
+
+cd "$(dirname "$0")/../.."
+
+# Render the config without booting Kamal, so this stays fast and never blocks on
+# something unrelated.
+rendered=$(ruby -e 'require "erb"; print ERB.new(File.read("config/deploy.yml")).result' 2>/dev/null) || exit 0
+
+unfilled=""
+
+# Match the value rather than a substring of it, so smtp.mailprovider.com doesn't
+# count as the placeholder.
+if printf "%s" "$rendered" | grep -qE ":[[:space:]]*[\"']?fizzy\.example\.com[\"']?[[:space:]]*$"; then
+  unfilled="$unfilled APP_HOST"
+fi
+
+if printf "%s" "$rendered" | grep -qE ":[[:space:]]*[\"']?smtp\.example\.com[\"']?[[:space:]]*$"; then
+  unfilled="$unfilled SMTP_ADDRESS"
+fi
+
+if [ -z "$unfilled" ]; then
+  exit 0
+fi
+
+echo "" >&2
+echo "config/deploy.yml still has placeholder values:$unfilled" >&2
+echo "" >&2
+echo "→ Fill in your hostname and mail server in config/deploy.yml, or export APP_HOST, then try again" >&2
+echo "" >&2
+exit 1
diff --git a/.kamal/secrets.example b/.kamal/secrets.example
new file mode 100644
index 0000000..afcd09c
--- /dev/null
+++ b/.kamal/secrets.example
@@ -0,0 +1,25 @@
+# Secrets for your self-hosted Fizzy deployment.
+#
+# Copy this file to .kamal/secrets and fill in the values. .kamal/secrets is
+# git-ignored, so your secrets never leave your machine.
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# See docs/self-hosting.md for details.
+
+# Signs cookies and anything else Fizzy needs to keep private.
+# Generate one with: bin/rails secret
+SECRET_KEY_BASE=
+
+# The password for the mail server in config/deploy.yml. Leave it empty if your
+# mail server doesn't require authentication.
+SMTP_PASSWORD=
+
+# Optional: browser push notifications. Generate a pair with:
+#
+#   bin/rails runner 'p = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{p.public_key}"; puts "VAPID_PRIVATE_KEY=#{p.private_key}"'
+#
+# If you skip them, delete these two lines here and the matching entries in
+# config/deploy.yml.
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
