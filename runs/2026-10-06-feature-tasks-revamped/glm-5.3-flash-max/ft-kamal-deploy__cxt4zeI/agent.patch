diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..daf08d6
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,78 @@
+# Kamal configuration for running Fizzy on a single box: one Linux server with
+# Docker, SQLite and everything in one container, with SSL provided by the
+# Kamal proxy.
+#
+# Read docs/self-hosting.md for a step-by-step walkthrough.
+#
+# The hostname is read from APP_HOST, so you can also set it in your
+# environment instead of editing this file.
+
+<% host = ENV.fetch("APP_HOST", "fizzy.example.com") %>
+
+service: fizzy
+image: fizzy
+asset_path: /rails/public/assets
+
+servers:
+  web:
+    hosts:
+      - <%= host %>
+
+# SQLite databases (primary, queue, cache and cable) and uploaded files all live
+# under /rails/storage. The volume is what makes your data survive a deploy.
+volumes:
+  - "fizzy:/rails/storage"
+
+# kamal-proxy terminates SSL with a certificate from Let's Encrypt, so the app
+# is reached at https://<your host> and only sees plain HTTP from the proxy.
+proxy:
+  ssl: true
+  host: <%= host %>
+  # kamal-proxy stops forwarding headers when it terminates SSL itself. Ask it
+  # to keep doing it, so the app sees real client IP addresses.
+  forward_headers: true
+
+# The image is built on your machine and pushed to a throwaway registry, which
+# the server pulls from over an SSH tunnel. No registry account needed.
+#
+# To use a real registry instead, e.g. Docker Hub or ghcr.io:
+#
+#   registry:
+#     server: ghcr.io
+#     username: <your username>
+#     password:
+#       - KAMAL_REGISTRY_PASSWORD
+registry:
+  server: localhost:5000
+
+builder:
+  # Servers are usually amd64. Drop this line if your deploy machine matches
+  # your server's architecture, e.g. both are Apple Silicon.
+  arch: amd64
+
+env:
+  clear:
+    # Used for links in emails, redirects and push notification payloads.
+    APP_HOST: <%= host %>
+    MAILER_FROM_ADDRESS: "Fizzy <no-reply@<%= host %>>"
+    # Your mail server. Fizzy sends magic link emails through it.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: <%= host %>
+    # Add SMTP_USER_NAME here if your mail server requires authentication.
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # Background jobs run in this very container through Puma's Solid Queue
+    # plugin. Set this to "false" and add a separate jobs role running bin/jobs
+    # if you'd rather keep them apart.
+    SOLID_QUEUE_IN_PUMA: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional, for web push notifications.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  ssh: app exec -i --reuse /bin/bash
