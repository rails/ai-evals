+  extend ActiveSupport::Concern
+
+  NEAR_CARDS_LIMIT_THRESHOLD = 100
+
+  included do
+    has_many :subscriptions, dependent: :destroy, class_name: "Account::Subscription"
+    has_one :billing_waiver, dependent: :destroy, class_name: "Account::BillingWaiver"
+    has_one :overridden_limit, dependent: :destroy, class_name: "Account::OverriddenLimit"
+
+    set_callback :cancel, :after, :schedule_stripe_cancellation
+    set_callback :reactivate, :after, :unschedule_stripe_cancellation
+    set_callback :incinerate, :before, :cancel_stripe_subscription, prepend: true
+  end
+
+  def plan
+    if comped?
+      Account::Subscription::Plan::COMPED
+    else
+      active_subscription&.plan || Account::Subscription::Plan::FREE
+    end
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def active_subscription
+    subscriptions.active.most_recent.first
+  end
+
+  def free?
+    plan.free?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp!
+    if billing_waiver
+      billing_waiver.destroy
+      association(:billing_waiver).reset
+    end
+  end
+
+  def start_checkout(plan_key:, success_url:, cancel_url:)
+    Account::Subscription.start_checkout account: self, plan_key: plan_key,
+      success_url: success_url, cancel_url: cancel_url
+  end
+
+  def start_billing_portal(return_url:)
+    Account::Subscription.start_billing_portal account: self, return_url: return_url
+  end
+
+  def override_limits!(card_count: nil, bytes_used: nil)
+    card_count = card_count.presence
+    bytes_used = bytes_used.presence
+
+    if overridden_limit
+      overridden_limit.update! card_count: card_count, bytes_used: bytes_used
+    else
+      create_overridden_limit! card_count: card_count, bytes_used: bytes_used
+    end
+  end
+
+  def reset_overridden_limits!
+    if overridden_limit
+      overridden_limit.destroy
+      association(:overridden_limit).reset
+    end
+  end
+
+  def cards_limit
+    overridden_limit&.card_count || plan.cards_limit
+  end
+
+  def unlimited_cards?
+    cards_limit.nil?
+  end
+
+  def cards_remaining
+    return if unlimited_cards?
+
+    [ cards_limit - cards_count, 0 ].max
+  end
+
+  def exceeding_cards_limit?
+    return false if unlimited_cards?
+
+    cards_count >= cards_limit
+  end
+
+  def nearing_cards_limit?
+    return false if unlimited_cards? || exceeding_cards_limit?
+
+    cards_remaining <= NEAR_CARDS_LIMIT_THRESHOLD
+  end
+
+  private
+    # Keep Stripe in step with the account lifecycle: a cancelled account stops
+    # being billed when the period runs out, a reactivated one goes back to
+    # being billed, and an incinerated one loses its subscription outright.
+    def schedule_stripe_cancellation
+      if subscription = active_subscription
+        Stripe::Subscription.update(subscription.stripe_subscription_id, cancel_at_period_end: true)
+        subscription.update!(cancel_at: Time.current)
+      end
+    end
+
+    def unschedule_stripe_cancellation
+      if subscription = active_subscription
+        Stripe::Subscription.update(subscription.stripe_subscription_id, cancel_at_period_end: false)
+        subscription.update!(cancel_at: nil)
+      end
+    end
+
+    def cancel_stripe_subscription
+      if subscription = active_subscription
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+        subscription.update!(status: "canceled", cancel_at: nil)
+      end
+    end
+end
