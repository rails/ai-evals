@@ -0,0 +1,82 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap-half txt-align-start">
+      <div class="flex gap-half">
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Plan</div>
+          <div class="txt-large"><strong><%= @account.plan_name %></strong></div>
+        </div>
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Cards</div>
+          <div class="txt-large">
+            <strong><%= number_with_delimiter(@account.cards_count) %></strong>
+            <% unless @account.unlimited_cards? %>
+              <span class="txt-x-small txt-ink-medium">of <%= number_with_delimiter(@account.cards_limit) %></span>
+            <% end %>
+          </div>
+        </div>
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Storage</div>
+          <div class="txt-large">
+            <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+            <% unless @account.unlimited_storage? %>
+              <span class="txt-x-small txt-ink-medium">of <%= number_to_human_size(@account.storage_limit) %></span>
+            <% end %>
+          </div>
+        </div>
+      </div>
+
+      <div class="txt-x-small txt-ink-medium">
+        #<%= @account.external_account_id %> •
+        <%= @account.owner_name || "No owner" %> •
+        <%= @account.owner_email || "No admin" %> •
+        created <%= time_ago_in_words(@account.created_at) %> ago
+      </div>
+
+      <% if @account.comped? %>
+        <div class="txt-small">This account has been comped and is not billed.</div>
+      <% end %>
+    </div>
+
+    <div class="flex gap justify-center margin-block-start">
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), class: "btn" %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+      <div class="txt-small">Limits that apply to this account on top of its plan. Leave a field empty to keep the plan's value.</div>
+    </header>
+
+    <%= form_with model: (@account.overridden_limit || @account.build_overridden_limit),
+          url: saas.admin_account_overridden_limit_path(@account), method: :post, scope: :overridden_limit,
+          class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+      <div class="flex gap-half">
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, class: "input", min: 1 %>
+        </div>
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, class: "input", min: 1 %>
+        </div>
+      </div>
+
