diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..f2b5263
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  SIGNING_SECRET = "whsec_test_secret"
+
+  setup do
+    @account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = SIGNING_SECRET
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+
+  test "a completed checkout activates the subscription" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "incomplete",
+      stripe_customer_id: "cus_1"
+
+    post_webhook "checkout.session.completed",
+      id: "cs_1",
+      customer: "cus_1",
+      subscription: "sub_1",
+      status: "complete",
+      client_reference_id: @account.id,
+      metadata: { plan: "unlimited" }
+
+    assert_response :ok
+    assert_equal "active", subscription.reload.status
+    assert_equal "sub_1", subscription.stripe_subscription_id
+  end
+
+  test "a deleted subscription reverts the account to the free plan" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    post_webhook "customer.subscription.deleted", id: "sub_1", status: "canceled"
+
+    assert_response :ok
+    assert_equal "Free", @account.reload.plan_name
+  end
+
+  test "refuses a payload that is not signed by Stripe" do
+    post_webhook "checkout.session.completed", { id: "cs_1", customer: "cus_1", status: "complete" }, signature: "t=1,v1=tampered"
+
+    assert_response :bad_request
+    assert_equal "Free", @account.reload.plan_name
+  end
+
+  test "does not need a signed in user" do
+    post_webhook "invoice.paid", id: "in_1"
+
+    assert_response :ok
+  end
+
+  private
+    # The mounted helper only shows up once a request has been made, and the
+    # webhook is hit without a session.
+    def saas
+      Fizzy::Saas::Engine.routes.url_helpers
+    end
+
+    def post_webhook(type, object = {}, options = {})
+      payload = JSON.generate(id: "evt_#{type}", type: type, data: { object: object })
+      signature ||= options[:signature] || signature_for(payload)
+
+      post saas.stripe_webhooks_path, params: payload,
+        headers: { "Content-Type" => "application/json", "Stripe-Signature" => signature }
+    end
+
+    def signature_for(payload)
+      timestamp = Time.now
+      computed = Stripe::Webhook::Signature.compute_signature(timestamp, payload, SIGNING_SECRET)
+      Stripe::Webhook::Signature.generate_header(timestamp, computed)
+    end
+end
diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..bd64f65
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+# The whole story: a free account runs out of cards, upgrades, and gets the
+# storage that comes with its plan. Support comps and overrides along the way.
+class BillingTest < ActionDispatch::IntegrationTest
+  SIGNING_SECRET = "whsec_test_secret"
+
+  setup do
+    @account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = SIGNING_SECRET
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+
+  test "hosted fizzy is going paid" do
+    assert_equal "Free", @account.plan_name
+    assert_equal 1_000, @account.cards_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+
+    sign_in_as :mike
+
+    # From a 100 cards out, the warning counts down
+    @account.update_column :cards_count, 950
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_select "strong", text: "50 cards left"
+
+    # Out of cards, drafting still works, publishing and creating through the API
+    # are refused, and the create buttons give way to an upgrade pitch
+    @account.update_column :cards_count, 1_000
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_select ".card-perma__account-limit-message strong", text: /used all the cards/
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :forbidden
+
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+      params: { card: { title: "Through the API" } }, as: :json
+
+    assert_response :forbidden
+
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+
+    assert_response :redirect
+    assert Card.last.drafted?
+
+    # Admins see their plan and an upgrade in the settings
+    get account_settings_path(script_name: @account.slug)
+
+    assert_select "strong", text: "Free"
+    assert_select "button", text: "Upgrade to Unlimited ($20/month)"
+
+    # Upgrading happens on Stripe, and the plan brings its own storage
+    Stripe::Customer.stubs(:create).returns(Stripe::StripeObject.construct_from(id: "cus_1"))
+    Stripe::Checkout::Session.stubs(:create).returns(
+      Stripe::StripeObject.construct_from(id: "cs_1", url: "https://checkout.stripe.com/c/pay/cs_1")
+    )
+
+    post saas.account_checkout_path(plan: "unlimited", script_name: @account.slug)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_1", allow_other_host: true
+
+    deliver_webhook "checkout.session.completed",
+      id: "cs_1", customer: "cus_1", subscription: "sub_1", status: "complete",
+      client_reference_id: @account.id, metadata: { plan: "unlimited" }
+
+    assert_equal "Unlimited", @account.reload.plan_name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.unlimited_cards?
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_select "button", text: "Manage subscription"
+
+    # Support comps the account and overrides its limits, then undoes both
+    logout_and_sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_select "a", text: "Initech LLC"
+
+      get saas.admin_account_path(@account)
+
+      assert_select "button", text: "Comp"
+
+      post saas.admin_account_billing_waiver_path(@account)
+
+      assert @account.reload.comped?
+
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: "10", bytes_used: "100" } }
+
+      assert_equal 10, @account.reload.cards_limit
+      assert_equal 100, @account.storage_limit
+
+      delete saas.admin_account_overridden_limit_path(@account)
+
+      assert_nil @account.reload.overridden_limit
+
+      delete saas.admin_account_billing_waiver_path(@account)
+
+      assert_not @account.reload.comped?
+    end
+
+    # A subscription that goes away reverts the account to the free plan
+    deliver_webhook "customer.subscription.deleted", id: "sub_1", status: "canceled"
+
+    assert_equal "Free", @account.reload.plan_name
+    assert_equal 1_000, @account.cards_limit
+  end
+
+  private
+    def deliver_webhook(type, object)
+      payload = JSON.generate(id: "evt_#{type}", type: type, data: { object: object })
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, SIGNING_SECRET)
+
+      post saas.stripe_webhooks_path, params: payload,
+        headers: { "Content-Type" => "application/json",
+                   "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(timestamp, signature) }
+
+      assert_response :ok
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..92f306a
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "is free by default" do
+    assert_equal "Free", @account.plan_name
+    assert @account.free?
+    assert_not @account.subscribed?
+  end
+
+  test "plan comes from the active subscription" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    assert_equal "Unlimited", @account.plan_name
+    assert @account.subscribed?
+  end
+
+  test "a canceled subscription does not upgrade the plan" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "canceled", stripe_customer_id: "cus_1"
+
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "the most recent active subscription wins" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", created_at: 2.days.ago
+    @account.subscriptions.create! plan_key: "unlimited_plus", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_2", created_at: 1.day.ago
+
+    assert_equal "Unlimited+", @account.plan_name
+  end
+
+  test "comped accounts get everything" do
+    @account.comp!
+
+    assert_equal "Comp", @account.plan_name
+    assert @account.comped?
+    assert_not @account.free?
+    assert_not @account.subscribed?
+    assert @account.unlimited_cards?
+    assert @account.unlimited_storage?
+    assert_not @account.exceeding_cards_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "comp and uncomp round-trip" do
+    assert_difference -> { Account::BillingWaiver.count }, +1 do
+      @account.comp!
+    end
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp!
+    end
+
+    assert_difference -> { Account::BillingWaiver.count }, -1 do
+      @account.uncomp!
+    end
+
+    assert_not @account.comped?
+  end
+
+  test "the free plan includes 1,000 cards" do
+    assert_equal 1_000, @account.cards_limit
+    assert_equal 1_000, @account.cards_remaining
+    assert_not @account.exceeding_cards_limit?
+    assert_not @account.nearing_cards_limit?
+  end
+
+  test "runs out of cards when the count reaches the limit" do
+    @account.update_column :cards_count, 1_000
+
+    assert @account.exceeding_cards_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "warns when within a 100 cards of the limit" do
+    @account.update_column :cards_count, 900
+
+    assert @account.nearing_cards_limit?
+    assert_equal 100, @account.cards_remaining
+  end
+
+  test "does not warn when there are more than 100 cards left" do
+    @account.update_column :cards_count, 899
+
+    assert_not @account.nearing_cards_limit?
+  end
+
+  test "paid plans have no card limit" do
+    subscribe_to "unlimited"
+
+    assert @account.unlimited_cards?
+    assert_not @account.exceeding_cards_limit?
+    assert_not @account.nearing_cards_limit?
+    assert_nil @account.cards_remaining
+  end
+
+  test "a paid plan brings its own storage allowance" do
+    subscribe_to "unlimited"
+
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    subscribe_to "unlimited_plus"
+
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "overrides the card count and the bytes used" do
+    @account.override_limits! card_count: "10", bytes_used: "100"
+
+    assert_equal 10, @account.cards_limit
+    assert_equal 100, @account.storage_limit
+    assert_equal 1, Account::OverriddenLimit.count
+  end
+
+  test "overriding again updates the same record" do
+    @account.override_limits! card_count: 10, bytes_used: 100
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits! card_count: 20, bytes_used: 200
+    end
+
+    assert_equal 20, @account.cards_limit
+    assert_equal 200, @account.storage_limit
+  end
+
+  test "resetting drops the override" do
+    @account.override_limits! card_count: 10, bytes_used: 100
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      @account.reset_overridden_limits!
+    end
+
+    assert_equal 1_000, @account.cards_limit
+    assert_equal Account::StorageLimited::DEFAULT_STORAGE_LIMIT, @account.storage_limit
+  end
+
+  test "cancelling the account stops the subscription at the end of the period" do
+    subscribe_to "unlimited"
+    Stripe::Subscription.stubs(:update).returns(true)
+
+    @account.cancel!
+
+    assert_predicate @account.active_subscription, :cancel_at
+    assert_not_predicate @account, :active?
+  end
+
+  test "reactivating the account bills it again" do
+    subscribe_to "unlimited"
+    Stripe::Subscription.stubs(:update).returns(true)
+
+    @account.cancel!
+    @account.reactivate!
+
+    assert_nil @account.active_subscription.reload.cancel_at
+  end
+
+  test "incinerating the account cancels the subscription" do
+    subscribe_to "unlimited"
+    Stripe::Subscription.stubs(:update).returns(true)
+    Stripe::Subscription.expects(:cancel).once
+    @account.cancel!
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    @account.incinerate
+  end
+
+  private
+    def subscribe_to(plan_key)
+      @account.subscriptions.create! plan_key: plan_key, status: "active",
+        stripe_customer_id: "cus_1", stripe_subscription_id: "sub_#{plan_key}"
+    end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
