--- /dev/null
+++ b/saas/app/controllers/concerns/card/card_limited.rb
@@ -0,0 +1,8 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_cards_limit
+      head :forbidden if Current.account.exceeding_cards_limit? && !Current.identity.staff?
+    end
+end
diff --git a/saas/app/controllers/concerns/card/card_limited/creation.rb b/saas/app/controllers/concerns/card/card_limited/creation.rb
new file mode 100644
index 0000000..19f34ad
--- /dev/null
+++ b/saas/app/controllers/concerns/card/card_limited/creation.rb
@@ -0,0 +1,11 @@
+module Card::CardLimited::Creation
+  extend ActiveSupport::Concern
+
+  included do
+    include Card::CardLimited
+
+    # Drafting is always allowed, so only the API (which publishes on creation)
+    # is refused once the cards of the plan are used up.
+    before_action :ensure_within_cards_limit, only: :create, if: -> { request.format.json? }
+  end
+end
