diff --git a/saas/test/controllers/account/billing_portals_controller_test.rb b/saas/test/controllers/account/billing_portals_controller_test.rb
new file mode 100644
index 0000000..df68b05
--- /dev/null
+++ b/saas/test/controllers/account/billing_portals_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as :kevin
+  end
+
+  test "managing the subscription hands the account over to the Stripe customer portal" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+    Stripe::BillingPortal::Session.stubs(:create).returns(
+      Stripe::StripeObject.construct_from(url: "https://billing.stripe.com/session/1")
+    )
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/session/1", allow_other_host: true
+  end
+
+  test "accounts that were never billed have nothing to manage" do
+    post saas.account_billing_portal_path
+
+    assert_response :not_found
+  end
+
+  test "only admins can manage the subscription" do
+    logout_and_sign_in_as :david
+
+    post saas.account_billing_portal_path
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/account/checkouts_controller_test.rb b/saas/test/controllers/account/checkouts_controller_test.rb
new file mode 100644
index 0000000..241b81e
--- /dev/null
+++ b/saas/test/controllers/account/checkouts_controller_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as :kevin
+  end
+
+  test "upgrading hands the account over to Stripe checkout" do
+    Stripe::Customer.stubs(:create).returns(Stripe::StripeObject.construct_from(id: "cus_1"))
+    Stripe::Checkout::Session.stubs(:create).returns(
+      Stripe::StripeObject.construct_from(id: "cs_1", url: "https://checkout.stripe.com/c/pay/cs_1")
+    )
+
+    assert_no_difference -> { Account::Subscription.active.count } do
+      post saas.account_checkout_path(plan: "unlimited")
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_1", allow_other_host: true
+    assert_equal "unlimited", @account.subscriptions.sole.plan_key
+  end
+
+  test "only admins can start a checkout" do
+    logout_and_sign_in_as :david
+
+    post saas.account_checkout_path(plan: "unlimited")
+
+    assert_response :forbidden
+  end
+
+  test "upgrading to an unknown plan is not possible" do
+    post saas.account_checkout_path(plan: "unlimited_plus_plus")
+
+    assert_response :not_found
+  end
+end
diff --git a/saas/test/controllers/account/settings_billing_test.rb b/saas/test/controllers/account/settings_billing_test.rb
new file mode 100644
index 0000000..a979c73
--- /dev/null
+++ b/saas/test/controllers/account/settings_billing_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as :kevin
+  end
+
+  test "the settings page shows the plan of the account" do
+    get account_settings_path
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "div", text: /1,000 cards, 1 GB of storage/
+  end
+
+  test "the settings page pitches the paid plans to the admins of a free account" do
+    get account_settings_path
+
+    assert_response :success
+    assert_select "button", text: "Upgrade to Unlimited ($20/month)"
+    assert_select "button", text: "Upgrade to Unlimited+ ($25/month)"
+  end
+
+  test "only admins are pitched an upgrade" do
+    logout_and_sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "button", text: /^Upgrade to/, count: 0
+  end
+
+  test "the settings page sends paid accounts to the customer portal" do
+    subscribe_to "unlimited"
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited"
+    assert_select "button", text: "Manage subscription"
+  end
+
+  test "comped accounts are not pitched an upgrade" do
+    @account.comp!
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "strong", text: "Comp"
+    assert_select "button", text: /^Upgrade to/, count: 0
+    assert_select "button", text: "Manage subscription", count: 0
+  end
+
+  private
+    def subscribe_to(plan_key)
+      @account.subscriptions.create! plan_key: plan_key, status: "active",
+        stripe_customer_id: "cus_1", stripe_subscription_id: "sub_#{plan_key}"
+    end
+end
