+<section class="settings__section">
+  <header>
+    <h2 class="divider">Billing</h2>
+    <div>Your account is on the <strong><%= Current.account.plan_name %></strong> plan, which includes <%= Current.account.plan.summary %>.</div>
+  </header>
+
+  <div class="flex flex-column gap-quarter txt-small">
+    <div>
+      <strong><%= number_with_delimiter(Current.account.cards_count) %></strong>
+      <% unless Current.account.unlimited_cards? %>
+        of <%= number_with_delimiter(Current.account.cards_limit) %>
+      <% end %>
+      cards used
+    </div>
+    <div>
+      <strong><%= number_to_human_size(Current.account.bytes_used) %></strong>
+      <% unless Current.account.unlimited_storage? %>
+        of <%= number_to_human_size(Current.account.storage_limit) %>
+      <% end %>
+      storage used
+    </div>
+  </div>
+
+  <% if Current.user.admin? %>
+    <% if Current.account.comped? %>
+      <p class="txt-small">This account has been comped and is not billed.</p>
+    <% elsif Current.account.free? %>
+      <div class="flex gap justify-center margin-block-start">
+        <% Account::Subscription::Plan.paid.each do |plan| %>
+          <%= button_to "Upgrade to #{plan.name} (#{plan.price_label})", saas.account_checkout_path(plan: plan.key),
+                class: "btn", data: { turbo: false } %>
+        <% end %>
+      </div>
+    <% else %>
+      <%= button_to "Manage subscription", saas.account_billing_portal_path, class: "btn", data: { turbo: false } %>
+    <% end %>
+  <% end %>
+</section>
