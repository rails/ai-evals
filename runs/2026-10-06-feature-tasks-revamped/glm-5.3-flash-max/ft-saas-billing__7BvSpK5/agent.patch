@@ -0,0 +1,175 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  SIGNING_SECRET = "whsec_test_secret"
+
+  setup do
+    @account = accounts(:initech)
+    ENV["STRIPE_WEBHOOK_SECRET"] = SIGNING_SECRET
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_unlimited_plus"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+    ENV.delete("STRIPE_UNLIMITED_PRICE_ID")
+    ENV.delete("STRIPE_UNLIMITED_PLUS_PRICE_ID")
+  end
+
+  test "start_checkout sends the account to Stripe" do
+    Stripe::Customer.expects(:create).once.returns(stripe_object(id: "cus_1"))
+    Stripe::Checkout::Session.expects(:create).once.returns(stripe_object(id: "cs_1", url: "https://checkout.stripe.com/c/pay/cs_1"))
+
+    url = @account.start_checkout plan_key: "unlimited",
+      success_url: "https://fizzy.do/signed-up", cancel_url: "https://fizzy.do/settings"
+
+    assert_equal "https://checkout.stripe.com/c/pay/cs_1", url
+
+    subscription = @account.subscriptions.sole
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "cus_1", subscription.stripe_customer_id
+    assert_equal "incomplete", subscription.status
+  end
+
+  test "start_checkout reuses the customer of a previous subscription" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "canceled",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).once.returns(stripe_object(id: "cs_2", url: "https://checkout.stripe.com/c/pay/cs_2"))
+
+    @account.start_checkout plan_key: "unlimited_plus",
+      success_url: "https://fizzy.do/signed-up", cancel_url: "https://fizzy.do/settings"
+
+    assert_equal "cus_1", @account.subscriptions.order(:created_at).last.stripe_customer_id
+    assert_not_equal subscription.id, @account.subscriptions.order(:created_at).last.id
+  end
+
+  test "start_billing_portal hands the account over to the Stripe customer portal" do
+    @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+    Stripe::BillingPortal::Session.expects(:create).once
+      .with(customer: "cus_1", return_url: "https://fizzy.do/settings")
+      .returns(stripe_object(url: "https://billing.stripe.com/session/1"))
+
+    assert_equal "https://billing.stripe.com/session/1",
+      @account.start_billing_portal(return_url: "https://fizzy.do/settings")
+  end
+
+  test "start_billing_portal refuses accounts that were never billed" do
+    assert_raises(ActiveRecord::RecordNotFound) do
+      @account.start_billing_portal(return_url: "https://fizzy.do/settings")
+    end
+  end
+
+  test "a completed checkout activates the subscription" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "incomplete",
+      stripe_customer_id: "cus_1"
+
+    stripe_event "checkout.session.completed",
+      id: "cs_1",
+      customer: "cus_1",
+      subscription: "sub_1",
+      status: "complete",
+      client_reference_id: @account.id,
+      metadata: { plan: "unlimited" }
+
+    assert_response_to_webhook
+
+    assert_equal "active", subscription.reload.status
+    assert_equal "sub_1", subscription.stripe_subscription_id
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "Unlimited", @account.plan_name
+  end
+
+  test "a completed checkout for an unknown account is ignored" do
+    stripe_event "checkout.session.completed", id: "cs_1", customer: "cus_9", status: "complete"
+
+    assert_response_to_webhook
+
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "a subscription update syncs its status" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    stripe_event "customer.subscription.updated",
+      id: "sub_1",
+      status: "past_due",
+      cancel_at: 1.week.from_now.to_i,
+      current_period_end: 1.month.from_now.to_i,
+      items: { data: [ { price: { id: "price_unlimited" } } ] }
+
+    assert_response_to_webhook
+
+    assert_equal "past_due", subscription.reload.status
+    assert_equal "unlimited", subscription.plan_key
+    assert_predicate subscription, :active?
+    assert_predicate subscription.cancel_at, :future?
+  end
+
+  test "a subscription update can move the account to another plan" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    stripe_event "customer.subscription.updated",
+      id: "sub_1",
+      status: "active",
+      items: { data: [ { price: { id: "price_unlimited_plus" } } ] }
+
+    assert_response_to_webhook
+
+    assert_equal "unlimited_plus", subscription.reload.plan_key
+    assert_equal "Unlimited+", @account.plan_name
+  end
+
+  test "a deleted subscription reverts the account to the free plan" do
+    subscription = @account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    stripe_event "customer.subscription.deleted", id: "sub_1", status: "canceled"
+
+    assert_response_to_webhook
+
+    assert_equal "canceled", subscription.reload.status
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "events that are not about billing are ignored" do
+    stripe_event "invoice.paid", id: "in_1"
+
+    assert_response_to_webhook
+  end
+
+  test "an unauthenticated payload is refused" do
+    stripe_event "checkout.session.completed", id: "cs_1", customer: "cus_1", status: "complete"
+
+    assert_not Account::Subscription.receive_webhook(@payload, "t=#{Time.now.to_i},v1=deadbeef")
+  end
+
+  test "a malformed payload is refused" do
+    assert_not Account::Subscription.receive_webhook("not json", signature_for("not json"))
+  end
+
+  private
+    def stripe_object(**attributes)
+      Stripe::StripeObject.construct_from(attributes)
+    end
+
+    # Delivers the event to the webhook handler the way Stripe would, keeping
+    # the payload around for the tests that want to tamper with it.
+    def stripe_event(type, object)
+      @payload = JSON.generate(id: "evt_#{type}", type: type, data: { object: object })
+    end
+
+    def assert_response_to_webhook
+      assert Account::Subscription.receive_webhook(@payload, signature_for(@payload))
+    end
+
+    def signature_for(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, SIGNING_SECRET)
+      Stripe::Webhook::Signature.generate_header(timestamp, signature)
+    end
+end
