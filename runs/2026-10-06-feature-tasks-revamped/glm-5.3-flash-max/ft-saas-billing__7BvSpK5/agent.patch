diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..d61fad7
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,166 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ trialing active past_due ]
+  PENDING_STATUS = "incomplete"
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+  scope :most_recent, -> { order(created_at: :desc, id: :desc) }
+
+  validates :plan_key, presence: true
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def active?
+    status.in? ACTIVE_STATUSES
+  end
+
+  class << self
+    # Stripe hosts checkout: we hand the account over and pick things back up
+    # when the webhook announces the new subscription.
+    def start_checkout(account:, plan_key:, success_url:, cancel_url:)
+      plan = Plan.fetch(plan_key)
+      subscription = pending_subscription_for(account, plan)
+      metadata = metadata_for(account, plan)
+
+      checkout = Stripe::Checkout::Session.create \
+        mode: "subscription",
+        customer: subscription.stripe_customer_id,
+        line_items: [ { price: plan.price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: account.id,
+        metadata: metadata,
+        subscription_data: { metadata: metadata }
+
+      checkout.url
+    end
+
+    def start_billing_portal(account:, return_url:)
+      customer_id = existing_customer_id_for(account) or
+        raise ActiveRecord::RecordNotFound, "Account has never been billed"
+
+      Stripe::BillingPortal::Session.create(customer: customer_id, return_url: return_url).url
+    end
+
+    # Entry point of the /stripe/webhooks endpoint. Returns whether the payload
+    # was authenticated and understood, so the controller can answer 400 to
+    # anything that isn't a genuine Stripe event.
+    def receive_webhook(payload, signature)
+      event = parse_event(payload, signature) or return false
+
+      handle_stripe_event(event)
+      true
+    end
+
+    def handle_stripe_event(event)
+      case event.type
+      when "checkout.session.completed"
+        activate_from_checkout(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_from_stripe(event.data.object)
+      when "customer.subscription.deleted"
+        cancel_from_stripe(event.data.object)
+      end
+    end
+
+    private
+      def pending_subscription_for(account, plan)
+        account.subscriptions.where(status: PENDING_STATUS, plan_key: plan.key).most_recent.first ||
+          account.subscriptions.create!(plan_key: plan.key, status: PENDING_STATUS, stripe_customer_id: customer_id_for(account))
+      end
+
+      def customer_id_for(account)
+        existing_customer_id_for(account) ||
+          Stripe::Customer.create(customer_attributes_for(account)).id
+      end
+
+      def existing_customer_id_for(account)
+        account.subscriptions.where.not(stripe_customer_id: nil).order(:created_at).last&.stripe_customer_id
+      end
+
+      def customer_attributes_for(account)
+        {
+          name: account.name,
+          email: account.owner_email,
+          metadata: { fizzy_account_id: account.id }
+        }
+      end
+
+      def metadata_for(account, plan)
+        { fizzy_account_id: account.id, plan: plan.key }
+      end
+
+      def parse_event(payload, signature)
+        if signing_secret.present?
+          Stripe::Webhook.construct_event(payload, signature, signing_secret)
+        else
+          # Only reachable where the signing secret is not configured, which is
+          # never the case in an environment we charge money in.
+          Stripe::Event.construct_from(JSON.parse(payload))
+        end
+      rescue JSON::ParserError, Stripe::SignatureVerificationError
+        nil
+      end
+
+      def signing_secret
+        ENV["STRIPE_WEBHOOK_SECRET"]
+      end
+
+      def activate_from_checkout(session)
+        metadata = attributes_of(session)
+        account = Account.find_by(id: session[:client_reference_id]) ||
+                  Account.find_by(id: metadata[:fizzy_account_id])
+        return unless account
+
+        subscription = account.subscriptions.where(stripe_customer_id: session[:customer]).most_recent.first ||
+                       account.subscriptions.create!(plan_key: Plan.free.key, status: PENDING_STATUS, stripe_customer_id: session[:customer])
+
+        plan = Plan.find(metadata[:plan]) || subscription.plan
+        subscription.update! \
+          plan_key: plan.key,
+          stripe_customer_id: session[:customer],
+          stripe_subscription_id: session[:subscription],
+          status: session[:status] == "complete" ? "active" : session[:status]
+      end
+
+      def sync_from_stripe(subscription)
+        record = find_by(stripe_subscription_id: subscription.id) or return
+
+        plan = Plan.find_by_price_id(price_id_of(subscription)) ||
+               Plan.find(attributes_of(subscription)[:plan]) ||
+               record.plan
+
+        record.update! \
+          plan_key: plan.key,
+          status: subscription.status,
+          current_period_end: timestamp(subscription[:current_period_end]),
+          cancel_at: timestamp(subscription[:cancel_at])
+      end
+
+      def cancel_from_stripe(subscription)
+        record = find_by(stripe_subscription_id: subscription.id) or return
+
+        record.update! \
+          status: subscription.status.presence || "canceled",
+          cancel_at: timestamp(subscription[:cancel_at])
+      end
+
+      # Stripe objects answer nil for the attributes they don't carry, so their
+      # values are read through the hash interface instead of accessors.
+      def attributes_of(object)
+        object[:metadata] || {}
+      end
+
+      def price_id_of(subscription)
+        items = subscription[:items]
+        items && items.data.first&.price&.id
+      end
+
+      def timestamp(value)
+        value && Time.at(value)
+      end
+  end
+end
diff --git a/saas/app/models/account/subscription/plan.rb b/saas/app/models/account/subscription/plan.rb
new file mode 100644
index 0000000..ad0be6f
--- /dev/null
+++ b/saas/app/models/account/subscription/plan.rb
@@ -0,0 +1,106 @@
+class Account::Subscription
+  # A priced tier of hosted Fizzy. Plans are immutable value objects: the free
+  # tier and the paid ones, with the cards and storage each one includes.
+  class Plan
+    include ActionView::Helpers::NumberHelper
+
+    attr_reader :key, :name, :price_cents, :cards_limit, :storage_limit
+
+    def initialize(key:, name:, price_cents:, cards_limit:, storage_limit:)
+      @key = key
+      @name = name
+      @price_cents = price_cents
+      @cards_limit = cards_limit
+      @storage_limit = storage_limit
+    end
+
+    FREE          = new key: :free,           name: "Free",        price_cents: 0,    cards_limit: 1_000, storage_limit: 1.gigabyte
+    UNLIMITED     = new key: :unlimited,      name: "Unlimited",   price_cents: 20_00, cards_limit: nil,  storage_limit: 5.gigabytes
+    UNLIMITED_PLUS = new key: :unlimited_plus, name: "Unlimited+", price_cents: 25_00, cards_limit: nil,  storage_limit: 500.gigabytes
+
+    # Not purchasable: accounts we stopped charging, which get everything for nothing.
+    COMPED = new key: :comped, name: "Comp", price_cents: 0, cards_limit: nil, storage_limit: nil
+
+    ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ]
+
+    class << self
+      def all
+        ALL
+      end
+
+      def free
+        FREE
+      end
+
+      def comped
+        COMPED
+      end
+
+      def paid
+        ALL - [ FREE ]
+      end
+
+      def find(key)
+        ALL.find { |plan| plan.key.to_s == key.to_s }
+      end
+
+      def fetch(key)
+        find(key) or raise KeyError, "Unknown plan #{key.inspect}"
+      end
+
+      def find_by_price_id(price_id)
+        return if price_id.blank?
+
+        all.find { |plan| plan.price_id == price_id }
+      end
+    end
+
+    def free?
+      key == :free
+    end
+
+    def paid?
+      !free?
+    end
+
+    def unlimited_cards?
+      cards_limit.nil?
+    end
+
+    def unlimited_storage?
+      storage_limit.nil?
+    end
+
+    def price_id
+      ENV["STRIPE_#{key.to_s.upcase}_PRICE_ID"]
+    end
+
+    def price_label
+      if price_cents.zero?
+        "Free"
+      else
+        "$#{price_cents / 100}/month"
+      end
+    end
+
+    def summary
+      [ cards_summary, storage_summary ].join(", ")
+    end
+
+    def cards_summary
+      if unlimited_cards?
+        "Unlimited cards"
+      else
+        "#{number_with_delimiter(cards_limit)} cards"
+      end
+    end
+
+    def storage_summary
+      if unlimited_storage?
+        "Unlimited storage"
+      else
+        "#{number_to_human_size(storage_limit)} of storage"
+      end
+    end
+  end
+end
diff --git a/saas/app/views/account/settings/saas/_billing.html.erb b/saas/app/views/account/settings/saas/_billing.html.erb
