+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    if Account::Subscription.receive_webhook(request.body.read, request.env["HTTP_STRIPE_SIGNATURE"])
+      head :ok
+    else
+      head :bad_request
+    end
+  end
+end
