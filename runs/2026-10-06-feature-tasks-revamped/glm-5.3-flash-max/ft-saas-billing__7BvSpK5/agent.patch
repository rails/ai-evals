+      assert_select "a[href='#{saas.admin_account_path(accounts(:initech))}']", text: "Initech LLC"
+    end
+  end
+
+  test "accounts are listed with their plan and their owner" do
+    account = accounts(:initech)
+
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :success
+      assert_select "li", text: /#{account.owner_email}/
+      assert_select "li", text: /Free/
+      assert_select "li", text: /#{account.cards_count} cards/
+    end
+  end
+
+  test "non-staff cannot see the accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :forbidden
+    end
+  end
+
+  test "an account page shows its plan and its usage" do
+    account = accounts(:initech)
+    account.subscriptions.create! plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1"
+
+    untenanted do
+      get saas.admin_account_path(account)
+
+      assert_response :success
+      assert_select "h1", text: "Initech LLC"
+      assert_select "strong", text: "Unlimited"
+      assert_select "button", text: "Comp"
+    end
+  end
+
+  test "comping an account waives its billing" do
+    account = accounts(:acme)
+
+    untenanted do
+      assert_difference -> { Account::BillingWaiver.count }, +1 do
+        post saas.admin_account_billing_waiver_path(account)
+      end
+
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert account.reload.comped?
+    assert_equal "Comp", account.plan_name
+  end
+
+  test "uncomping an account puts it back on its plan" do
+    account = accounts(:acme)
+    account.comp!
+
+    untenanted do
+      assert_difference -> { Account::BillingWaiver.count }, -1 do
+        delete saas.admin_account_billing_waiver_path(account)
+      end
+
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_not account.reload.comped?
+    assert_equal "Free", account.plan_name
+  end
+
+  test "overriding the limits of an account" do
+    account = accounts(:acme)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account),
+        params: { overridden_limit: { card_count: "50", bytes_used: "1000" } }
+
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_equal 50, account.reload.cards_limit
+    assert_equal 1000, account.storage_limit
+  end
+
+  test "overriding the limits of an account that already has an override" do
+    account = accounts(:acme)
+    account.override_limits! card_count: 50, bytes_used: 1000
+
+    untenanted do
+      assert_no_difference -> { Account::OverriddenLimit.count } do
+        post saas.admin_account_overridden_limit_path(account),
+          params: { overridden_limit: { card_count: "10", bytes_used: "2000" } }
+      end
+
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_equal 10, account.reload.cards_limit
+    assert_equal 2000, account.storage_limit
+  end
+
+  test "resetting drops the overridden limits" do
+    account = accounts(:acme)
+    account.override_limits! card_count: 50, bytes_used: 1000
+
+    untenanted do
+      assert_difference -> { Account::OverriddenLimit.count }, -1 do
+        delete saas.admin_account_overridden_limit_path(account)
+      end
+
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_equal 1_000, account.reload.cards_limit
+    assert_equal Account::StorageLimited::DEFAULT_STORAGE_LIMIT, account.storage_limit
+  end
+
+  test "the override form shows the current override" do
+    account = accounts(:acme)
+    account.override_limits! card_count: 50, bytes_used: 1000
+
+    untenanted do
+      get saas.admin_account_path(account)
+
+      assert_response :success
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[value='50']"
+      assert_select "input[value='1000']"
+      assert_select "input[value='Override']"
+      assert_select "button", text: "Reset"
+    end
+  end
+end
