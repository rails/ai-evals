@@ -19,16 +25,39 @@ module Card::Entropic
         .where("last_active_at > #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)')}", now)
         .where("last_active_at <= #{connection.date_subtract('?', 'COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) * 0.75')}", now)
     end
-
-    delegate :auto_postpone_period, to: :board
   end
 
+  delegate :auto_postpone_period, to: :board
+
   class_methods do
+    # Sweeps entropy by entropy instead of card by card. How long a card may
+    # rest before it is postponed is decided by its board or, absent a board
+    # period, by its account, so a card's deadline can only be computed by
+    # COALESCEing two joined entropies. No index can serve that, which is why
+    # the sweep used to re-scan and re-join every card in the system once per
+    # batch, and stopped fitting in its hour once an install grew past a
+    # hundred thousand cards. Entropies are few and every card an entropy
+    # governs shares its period, so asking each entropy for its expired cards
+    # keeps the deadline out of the where clause.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      Entropy.find_each do |entropy|
+        postpone_cards entropy.expired_cards, user: entropy.account.system_user
       end
     end
+
+    private
+      # Postponing a card moves it to Not Now and bumps its last activity, which
+      # takes it out of the due set. Re-reading the next slice of still expired
+      # cards therefore walks the index forward, where paging through a single
+      # result set would re-scan everything the entropy governs for every batch.
+      def postpone_cards(cards, user:)
+        loop do
+          batch = cards.ordered_by_last_active.limit(BATCH_SIZE).to_a
+          break if batch.empty?
+
+          batch.each { |card| card.auto_postpone(user:) }
+        end
+      end
   end
 
   def entropy
diff --git a/app/models/entropy.rb b/app/models/entropy.rb
index c896fc4..a377546 100644
--- a/app/models/entropy.rb
+++ b/app/models/entropy.rb
@@ -10,6 +10,16 @@ class Entropy < ApplicationRecord
 
   after_commit -> { container.cards.touch_all if container }
 
+  # The cards this entropy has given up on: its container's cards for a board,
+  # or the cards of the boards that inherit the account period. Asking the
+  # entropy rather than the card keeps the period out of the where clause, so
+  # the database can answer from an index instead of computing a deadline per
+  # card.
+  def expired_cards
+    cards = container.is_a?(Board) ? container.cards : container.cards.without_board_entropy
+    cards.active.where(last_active_at: ..(Time.current - auto_postpone_period))
+  end
+
   def auto_postpone_period_in_days
     days = auto_postpone_period / 1.day.to_i
 
