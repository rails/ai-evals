+namespace :push do
+  desc "Generate a VAPID key pair for push notifications (VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY)"
+  task generate_vapid_keys: :environment do
+    require "web-push"
+
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+  end
+end
