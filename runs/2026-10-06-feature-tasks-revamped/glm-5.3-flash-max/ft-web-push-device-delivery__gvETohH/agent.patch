--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/new", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create updates the keys when the browser subscribes again to the same endpoint" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/new",
+      p256dh_key: "old-p256dh-key", auth_key: "old-auth-key")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "p256dh-key", subscription.reload.p256dh_key
+    assert_equal "auth-key", subscription.reload.auth_key
+  end
+
+  test "create is forbidden for anyone else's devices" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create is unprocessable entity without an endpoint" do
+    post user_push_subscriptions_path(@user),
+      params: { push_subscription: subscription_params.except(:endpoint) }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://fcm.googleapis.com/fcm/send/new", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+end
