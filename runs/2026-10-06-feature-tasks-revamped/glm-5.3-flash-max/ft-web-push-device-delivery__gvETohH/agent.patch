+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  # Push services are unreachable from time to time, so we try again later.
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, wait: :polynomially_longer
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    notification.push_now
+  end
+end
