diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..31a7b01
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,31 @@
+class PushSubscription < ApplicationRecord
+  # VAPID identifies the push sender to the push service. Ops may want to change
+  # this to point at their own inbox, but any reachable mailto will do.
+  VAPID_SUBJECT = "mailto:notifications@fizzy.do"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: ->(endpoint) { endpoint.strip }
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+
+  def push(notification)
+    WebPush.payload_send \
+      endpoint: endpoint,
+      message: notification.push_payload.to_json,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: VAPID_SUBJECT,
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key
+      }
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The browser is gone: either the person unsubscribed or the push service
+    # dropped the endpoint, so there is nothing left to push to.
+    destroy
+  end
+end
