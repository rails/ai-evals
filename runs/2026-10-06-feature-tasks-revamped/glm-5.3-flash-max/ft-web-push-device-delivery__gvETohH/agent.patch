+class NotificationTest::Push < ActiveSupport::TestCase
+  test "push payload says what the tray says" do
+    assert_equal({ "title" => "RE: Layout is broken", "body" => "The text is overflowing the container." },
+      notifications(:layout_commented_kevin).push_payload.slice("title", "body"))
+  end
+
+  test "push payload opens the card it is about" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}", URI(notification.push_payload["url"]).path
+  end
+
+  test "creating a notification queues a push" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on a card queues another push" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_enqueued_with job: Notification::PushJob do
+      notification.update!(source: events(:layout_published))
+    end
+  end
+
+  test "reading a notification does not queue a push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:layout_commented_kevin).read
+    end
+  end
+
+  test "pushing notifies every subscribed device" do
+    notification = notifications(:layout_commented_kevin)
+    phone = notification.user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/phone", p256dh_key: "p256dh-key", auth_key: "auth-key")
+    desktop = notification.user.push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/desktop", p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    WebPush.expects(:payload_send).twice.with(
+      endpoint: any_of(phone.endpoint, desktop.endpoint),
+      message: notification.push_payload.to_json,
+      p256dh: "p256dh-key",
+      auth: "auth-key",
+      vapid: { subject: PushSubscription::VAPID_SUBJECT, public_key: nil, private_key: nil }
+    )
+
+    notification.push_now
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..fbf257e
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/desktop",
+      p256dh_key: "p256dh-key", auth_key: "auth-key")
+    @notification = notifications(:layout_commented_kevin)
+    @vapid_options = {
+      subject: PushSubscription::VAPID_SUBJECT,
+      public_key: "vapid-public-key",
+      private_key: "vapid-private-key"
+    }
+
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_options[:public_key]
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_options[:private_key]
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "validates the presence of the subscription details" do
+    subscription = PushSubscription.new(user: users(:kevin), endpoint: "", p256dh_key: "", auth_key: "")
+
+    assert_not subscription.valid?
+    assert_equal [ "can't be blank" ], subscription.errors[:endpoint]
+    assert_equal [ "can't be blank" ], subscription.errors[:p256dh_key]
+    assert_equal [ "can't be blank" ], subscription.errors[:auth_key]
+  end
+
+  test "requires a unique endpoint" do
+    duplicate = PushSubscription.new(user: users(:david), endpoint: @subscription.endpoint,
+      p256dh_key: @subscription.p256dh_key, auth_key: @subscription.auth_key)
+
+    assert_not duplicate.valid?
+    assert_equal [ "has already been taken" ], duplicate.errors[:endpoint]
+  end
+
+  test "pushes the notification to the push service" do
+    WebPush.expects(:payload_send).with(
+      endpoint: @subscription.endpoint,
+      message: @notification.push_payload.to_json,
+      p256dh: @subscription.p256dh_key,
+      auth: @subscription.auth_key,
+      vapid: @vapid_options
+    )
+
+    @subscription.push(@notification)
+  end
+
+  test "pushes an encrypted payload to the push service" do
+    # A subscription as the browser would hand it over, encrypted for real.
+    key = WebPush.generate_key
+    ENV["VAPID_PUBLIC_KEY"] = key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = key.private_key
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://fcm.googleapis.com/fcm/send/new",
+      p256dh_key: WebPush.generate_key.public_key, auth_key: WebPush.encode64(Random.bytes(16)))
+
+    Net::HTTP.any_instance.stubs(:request).returns(Net::HTTPCreated.new("1.1", "201", "Created"))
+
+    assert_nothing_raised do
+      subscription.push(@notification)
+    end
+  end
+
+  test "removes the subscription when the push service no longer knows it" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "fcm.googleapis.com"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "keeps the subscription when the push service is unavailable" do
+    WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(response, "fcm.googleapis.com"))
+
+    assert_no_difference -> { PushSubscription.count } do
+      assert_raises(WebPush::PushServiceError) { @subscription.push(@notification) }
+    end
+  end
+
+  private
+    def response
+      @response ||= Struct.new(:body).new("Gone")
+    end
+end
