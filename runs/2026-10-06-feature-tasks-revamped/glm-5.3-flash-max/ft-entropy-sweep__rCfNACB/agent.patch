diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..c2ab4b2 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -10,6 +10,14 @@ module Board::Entropic
     super || account.entropy
   end
 
+  def cards_due_to_be_postponed
+    if (period = entropy&.auto_postpone_period)
+      cards.active.where(last_active_at: ..period.seconds.ago)
+    else
+      cards.none
+    end
+  end
+
   def auto_postpone_period=(new_value)
     entropy ||= association(:entropy).reader || self.build_entropy
     entropy.update! auto_postpone_period: new_value
diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..d375043 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,9 +24,15 @@ module Card::Entropic
   end
 
   class_methods do
+    # The entropy period is a setting of the board (or, failing that, of its account), not of the
+    # card. Asking every card for it through a join forces the database to visit every card in the
+    # install, five times over, on every single batch of the sweep. Resolving the period once per
+    # board keeps the query on the board's own index and lets it skip the cards that can't be due.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      Board.find_each do |board|
+        board.cards_due_to_be_postponed.find_each do |card|
+          card.auto_postpone(user: board.account.system_user)
+        end
       end
     end
   end
