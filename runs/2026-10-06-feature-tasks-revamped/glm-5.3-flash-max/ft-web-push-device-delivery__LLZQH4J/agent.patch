@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create registers the subscription the browser hands over" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: {
+        endpoint: "https://fcm.googleapis.com/fcm/send/david-phone",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal %w[ auth_key created_at endpoint id p256dh_key updated_at user_agent ], response.parsed_body.keys.sort
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/david-phone", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal Current.account, subscription.account
+  end
+
+  test "create refreshes the keys of a device that is already subscribed" do
+    subscription = @user.push_subscriptions.create!(account: Current.account, endpoint: "https://fcm.googleapis.com/fcm/send/david-phone",
+      p256dh_key: "old-p256dh-key", auth_key: "old-auth-key")
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: {
+      endpoint: subscription.endpoint,
+      p256dh_key: "new-p256dh-key",
+      auth_key: "new-auth-key"
+    } }, as: :json
+
+    assert_response :created
+    assert_equal "new-p256dh-key", subscription.reload.p256dh_key
+  end
+
+  test "create refuses to register a subscription for somebody else" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: {
+        endpoint: "https://fcm.googleapis.com/fcm/send/kevin-phone",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create refuses a subscription without its keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://fcm.googleapis.com/fcm/send/x" } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires being signed in" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: {
+      endpoint: "https://fcm.googleapis.com/fcm/send/david-phone",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    } }, as: :json
+
+    assert_response :redirect
+  end
+end
