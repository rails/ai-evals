diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..e21843c 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,44 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Web push
+self.addEventListener("push", (event) => {
+  event.waitUntil(showPushNotification(event.data))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openCard(event.notification.data?.url))
+})
+
+async function showPushNotification(data) {
+  const payload = pushPayload(data)
+
+  await self.registration.showNotification(payload.title || "Fizzy", {
+    body: payload.body,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192.png",
+    data: { url: payload.url }
+  })
+}
+
+// A push says what the tray says and opens the card it's about.
+async function openCard(url) {
+  const card = new URL(url || "/", self.location.origin).href
+  const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of clients) {
+    if (client.url === card) return client.focus()
+  }
+
+  return self.clients.openWindow(card)
+}
+
+function pushPayload(data) {
+  try {
+    return data?.json() ?? {}
+  } catch {
+    return {}
+  }
+}
