+++ b/app/models/push/message.rb
@@ -0,0 +1,41 @@
+class Push::Message
+  # A push says what the tray says, so we render the same title and body the
+  # notifications list and its JSON API use, and add the card to open on tap.
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def payload
+    @payload ||= { title: title, body: body, url: card_path }
+  end
+
+  def to_json(*)
+    payload.to_json
+  end
+
+  private
+    attr_reader :notification
+
+    def title
+      tray["title"]
+    end
+
+    def body
+      tray["body"]
+    end
+
+    def tray
+      JSON.parse(render_tray_body)
+    end
+
+    def render_tray_body
+      ApplicationController.renderer.new(script_name: notification.account.slug).render \
+        partial: "notifications/notification/#{notification.source_type.underscore}/body",
+        formats: :json,
+        locals: { notification: notification }
+    end
+
+    def card_path
+      Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..28b7861
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,40 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    # Registers the subscription the browser got from the push service. Browsers
+    # hand out the same subscription for as long as it lives, so we upsert on the
+    # endpoint and refresh the keys whenever the device checks in again.
+    def register(user:, endpoint: nil, p256dh_key: nil, auth_key: nil)
+      user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: Current.user_agent)
+      end
+    end
+  end
+
+  def deliver(message)
+    WebPush.payload_send \
+      message: message.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy # The browser or the push service forgot about this subscription.
+  rescue StandardError => e
+    Rails.logger.warn("Push to #{endpoint} failed: #{e.class}: #{e.message}")
+  end
+
+  private
+    def vapid_options
+      {
+        subject: Rails.application.config.x.push.vapid_subject,
+        public_key: Rails.application.config.x.push.vapid_public_key,
+        private_key: Rails.application.config.x.push.vapid_private_key
+      }
+    end
+end
