+# Web push (VAPID) credentials, provisioned by ops as VAPID_PUBLIC_KEY and
+# VAPID_PRIVATE_KEY. The public key is handed to the browser to subscribe to the
+# push service, the private key signs the pushes we send to it.
+Rails.application.config.x.push.vapid_public_key = ENV["VAPID_PUBLIC_KEY"].presence
+Rails.application.config.x.push.vapid_private_key = ENV["VAPID_PRIVATE_KEY"].presence
+
+# VAPID wants a contact for the app server: a "mailto:" or an "https:" URI.
+Rails.application.config.x.push.vapid_subject = \
+  "mailto:#{ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")[/[\w.+-]+@[\w.-]+/] || "support@fizzy.do"}"
