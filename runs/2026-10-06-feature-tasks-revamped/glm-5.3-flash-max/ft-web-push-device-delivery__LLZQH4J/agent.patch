+++ b/test/models/push/message_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Push::MessageTest < ActiveSupport::TestCase
+  test "says what the tray says for an event notification" do
+    message = Push::Message.new(notifications(:layout_commented_kevin))
+
+    assert_equal "RE: Layout is broken", message.payload[:title]
+    assert_equal "The text is overflowing the container.", message.payload[:body]
+  end
+
+  test "says what the tray says for a mention notification" do
+    message = Push::Message.new(notifications(:logo_mentioned_david))
+    mention = mentions(:logo_comment_david_mention_by_jz)
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", message.payload[:title]
+    assert_equal mention.source.mentionable_content.truncate(200), message.payload[:body]
+  end
+
+  test "points at the card it is about" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal "/#{notification.account.external_account_id}/cards/#{notification.card.number}", Push::Message.new(notification).payload[:url]
+  end
+
+  test "serializes to JSON for the push service" do
+    message = Push::Message.new(notifications(:layout_commented_kevin))
+
+    assert_equal message.payload.to_json, message.to_json
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..7f01005
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:kevin_phone)
+    @message = Push::Message.new(notifications(:layout_commented_kevin))
+  end
+
+  teardown do
+    clear_vapid_keys
+  end
+
+  test "belongs to an account, through its user by default" do
+    subscription = Push::Subscription.create!(user: users(:kevin), endpoint: "https://push.example.com/kevin",
+      p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_equal users(:kevin).account, subscription.account
+  end
+
+  test "requires an endpoint and its keys" do
+    subscription = Push::Subscription.new(user: users(:kevin))
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :blank)
+    assert subscription.errors.of_kind?(:p256dh_key, :blank)
+    assert subscription.errors.of_kind?(:auth_key, :blank)
+  end
+
+  test "endpoint is unique" do
+    subscription = Push::Subscription.new(user: users(:jason), endpoint: @subscription.endpoint,
+      p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :taken)
+  end
+
+  test "register creates a subscription for an endpoint the browser hands over" do
+    subscription = nil
+
+    assert_difference -> { users(:jason).push_subscriptions.count }, 1 do
+      subscription = Push::Subscription.register \
+        user: users(:jason),
+        endpoint: "https://fcm.googleapis.com/fcm/send/jz-phone",
+        p256dh_key: "jz-p256dh-key",
+        auth_key: "jz-auth-key"
+    end
+
+    assert_equal "jz-p256dh-key", subscription.p256dh_key
+    assert_equal "jz-auth-key", subscription.auth_key
+    assert_equal users(:jason).account, subscription.account
+  end
+
+  test "register refreshes the keys of a subscription the device already registered" do
+    assert_no_difference -> { Push::Subscription.count } do
+      Push::Subscription.register \
+        user: users(:kevin),
+        endpoint: @subscription.endpoint,
+        p256dh_key: "new-p256dh-key",
+        auth_key: "new-auth-key"
+    end
+
+    assert_equal "new-p256dh-key", @subscription.reload.p256dh_key
+    assert_equal "new-auth-key", @subscription.auth_key
+  end
+
+  test "deliver signs the push with the VAPID keys" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with(
+        message: @message.to_json,
+        endpoint: @subscription.endpoint,
+        p256dh: @subscription.p256dh_key,
+        auth: @subscription.auth_key,
+        vapid: { subject: "mailto:support@fizzy.do", public_key: "vapid-public-key", private_key: "vapid-private-key" }
+      )
+
+      @subscription.deliver(@message)
+    end
+  end
+
+  test "deliver forgets a subscription the push service no longer knows" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(push_service_response, "fcm.googleapis.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver(@message)
+      end
+
+      assert_not Push::Subscription.exists?(@subscription.id)
+    end
+  end
+
+  test "deliver forgets an invalid subscription" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(push_service_response, "fcm.googleapis.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver(@message)
+      end
+    end
+  end
+
+  test "deliver keeps a subscription when the push service hiccups" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(push_service_response, "fcm.googleapis.com"))
+
+      assert_no_difference -> { Push::Subscription.count } do
+        @subscription.deliver(@message)
+      end
+    end
+  end
+
+  private
+    def with_vapid_keys
+      config = Rails.application.config.x.push
+      config.vapid_public_key = "vapid-public-key"
+      config.vapid_private_key = "vapid-private-key"
+      config.vapid_subject = "mailto:support@fizzy.do"
+
+      yield
+    end
+
+    def clear_vapid_keys
+      config = Rails.application.config.x.push
+      config.vapid_public_key = nil
+      config.vapid_private_key = nil
+    end
+
+    def push_service_response
+      stub(inspect: "response", body: "")
+    end
+end
