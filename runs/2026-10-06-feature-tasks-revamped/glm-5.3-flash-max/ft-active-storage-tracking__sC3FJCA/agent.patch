@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Board::UsageTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:layout)
+    perform_enqueued_jobs # let creations settle
+  end
+
+  test "#bytes_used counts the images of the board's cards" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in the board's description" do
+    blob = upload_file("moon.jpg")
+    @board.update! public_description: ActionText::Content.new("A board").append_attachables(blob)
+
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in the cards' descriptions" do
+    blob = upload_file("avatar.png")
+    @card.update! description: ActionText::Content.new("A card").append_attachables(blob)
+
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts the files embedded in the cards' comments" do
+    blob = upload_file("avatar.svg")
+    comment = @card.comments.create! creator: users(:kevin)
+    comment.update! body: ActionText::Content.new("See attached").append_attachables(blob)
+
+    assert_equal file_fixture("avatar.svg").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts everything on the board and its cards" do
+    board_description = upload_file("moon.jpg")
+    card_image = upload_file("avatar.png")
+    card_description = upload_file("avatar.svg")
+    comment_body = upload_file("moon.jpg")
+
+    @board.update! public_description: ActionText::Content.new("A board").append_attachables(board_description)
+    @card.image.attach io: file_fixture("avatar.png").open, filename: "avatar.png"
+    @card.update! description: ActionText::Content.new("A card").append_attachables(card_description)
+    comment = @card.comments.create! creator: users(:kevin)
+    comment.update! body: ActionText::Content.new("See attached").append_attachables(comment_body)
+
+    expected = [ board_description, card_image, card_description, comment_body ].sum { |blob| blob.byte_size }
+    assert_equal expected, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts the embeds of a card created with a description" do
+    blob = upload_file("avatar.svg")
+    Current.user = users(:kevin)
+    @board.cards.create! title: "With embeds", status: "published",
+      description: ActionText::Content.new("A card").append_attachables(blob)
+
+    assert_equal file_fixture("avatar.svg").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used drops the embeds of an edited comment" do
+    blob = upload_file("avatar.png")
+    comment = @card.comments.create! creator: users(:kevin)
+    comment.update! body: ActionText::Content.new("See attached").append_attachables(blob)
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+
+    comment.update! body: "Nothing attached anymore"
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "#bytes_used counts an image that replaced another one once" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    @card.update! image: { io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png" }
+
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+  end
+
+  test "#bytes_used drops the image when it is purged" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+
+    @card.image.purge_later
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "#bytes_used drops the embeds of a removed comment" do
+    blob = upload_file("avatar.png")
+    comment = @card.comments.create! creator: users(:kevin)
+    comment.update! body: ActionText::Content.new("See attached").append_attachables(blob)
+    assert_equal file_fixture("avatar.png").size, @board.reload.bytes_used
+
+    comment.destroy!
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "#bytes_used drops the image of a destroyed card" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+
+    @card.destroy!
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "#bytes_used follows the card to the board it moves to" do
+    other_board = boards(:private)
+    Current.user = users(:david)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+
+    @card.move_to(other_board)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal file_fixture("moon.jpg").size, other_board.reload.bytes_used
+  end
+
+  test "#bytes_used schedules a recalculation when the content changes" do
+    @board.update_column :bytes_used, 0 # as if it had been calculated before
+
+    assert_enqueued_with job: UsageCalculationJob, args: [ @board ] do
+      @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    end
+
+    assert_nil @board.reload.bytes_used_in_database, "usage should not be calculated while the job is pending"
+  end
+
+  test "#bytes_used is up to date once the recalculation has run" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    UsageCalculationJob.perform_now @board.reload
+
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used_in_database
+  end
+
+  test "#bytes_used is calculated on the spot when it has never been calculated" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "#bytes_used only schedules one recalculation for a flurry of changes" do
+    @board.update_column :bytes_used, 0 # as if it had been calculated before
+
+    assert_difference -> { enqueued_jobs_for(UsageCalculationJob).size }, 1 do
+      3.times do
+        @card.update! description: ActionText::Content.new("A card").append_attachables(upload_file("avatar.svg"))
+      end
+    end
+  end
+
+  private
+    def upload_file(filename)
+      ActiveStorage::Blob.create_and_upload! io: file_fixture(filename).open, filename: filename
+    end
+
+    def enqueued_jobs_for(job_class)
+      ActiveJob::Base.queue_adapter.enqueued_jobs.select { |job| job[:job] == job_class }
+    end
+end
