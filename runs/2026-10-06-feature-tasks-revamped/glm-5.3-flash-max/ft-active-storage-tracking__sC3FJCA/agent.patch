+module ActiveStorage
+  module Extensions
+    # Attachment records are what storage usage is counted from (see UsageTrackable), so any
+    # change to one has to expire the usage of the board and of the account it belongs to.
+    module Attachment
+      # Callbacks are registered here rather than through Concern#included, because the
+      # module has to be prepended to override the removal methods below.
+      def self.prepended(attachment)
+        # One callback for both actions: registering :create and :destroy separately would
+        # have the second one replace the first, since callbacks are deduplicated by name.
+        attachment.after_commit :expire_usage, on: %i[ create destroy ]
+        attachment.before_destroy :remember_usage_board
+      end
+
+      # Purging and detaching delete the attachment record without running callbacks, so they
+      # have to expire usage themselves.
+      def purge
+        expire_usage_after_removal { super }
+      end
+
+      def purge_later
+        expire_usage_after_removal { super }
+      end
+
+      def detach
+        expire_usage_after_removal { super }
+      end
+
+      private
+        def expire_usage_after_removal
+          board = usage_board
+          yield
+          expire_usage(board)
+        end
+
+        # The board is remembered before a removal, because the record the attachment belongs
+        # to is already gone once the removal has been committed.
+        def expire_usage(board = @usage_board || usage_board)
+          if board
+            board.account.expire_usage
+            board.expire_usage
+          end
+        end
+
+        # The board whose usage changes when this attachment is added or removed, or nil for
+        # attachments that don't count toward usage, like avatars.
+        def usage_board
+          case record_type
+          when "Card"
+            record&.board if name == "image"
+          when "ActionText::RichText"
+            record&.record&.try(:board)
+          end
+        end
+
+        def remember_usage_board
+          @usage_board = usage_board
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorage::Extensions::Attachment
+end
+
 # ApplicationRecord calls `configure_replica_connections` to set up connection pools for the
 # application models. We want ActiveStorage::Record to use the same pools for transactional
 # integrity, proper callback invocation, joins, etc., however ActiveStorage::Record inherits from
