diff --git a/app/models/concerns/usage_trackable.rb b/app/models/concerns/usage_trackable.rb
new file mode 100644
index 0000000..2241320
--- /dev/null
+++ b/app/models/concerns/usage_trackable.rb
@@ -0,0 +1,72 @@
+module UsageTrackable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :calculate_usage_later, on: :create
+  end
+
+  # Bytes of storage taken up by the content of the record: card images and the files
+  # embedded in board descriptions, card descriptions and comments.
+  #
+  # The total is calculated in the background and kept on the record, so reading it costs
+  # nothing no matter how much content there is. It is only calculated here, on the spot,
+  # when it has never been calculated before.
+  def bytes_used
+    self[:bytes_used] || calculate_usage_now
+  end
+
+  def calculate_usage_later
+    UsageCalculationJob.perform_later(self)
+  end
+
+  # Calculates the usage and stores it, so that whoever reads it next doesn't have to.
+  def calculate_usage_now
+    bytes = counted_attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+    update_column :bytes_used, bytes unless destroyed?
+    bytes
+  end
+
+  # Forgets the stored usage and schedules a recalculation. Does nothing when the usage is
+  # already being recalculated, so that a flurry of changes schedules a single job.
+  def expire_usage
+    if self.class.where(id: id).where.not(bytes_used: nil).update_all(bytes_used: nil) > 0
+      calculate_usage_later
+    end
+  end
+
+  private
+    # Every attachment that counts toward the usage of the record.
+    def counted_attachments
+      card_images.or(embeds)
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(account_id: usage_account.id, record_type: "Card", name: "image",
+        record_id: usage_cards.select(:id))
+    end
+
+    def embeds
+      ActiveStorage::Attachment.where(account_id: usage_account.id, record_type: "ActionText::RichText", name: "embeds",
+        record_id: counted_rich_texts.select(:id))
+    end
+
+    # The rich texts whose embeds count toward the usage of the record.
+    def counted_rich_texts
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+
+    def board_descriptions
+      ActionText::RichText.where(account_id: usage_account.id, record_type: "Board", name: "public_description",
+        record_id: usage_boards.select(:id))
+    end
+
+    def card_descriptions
+      ActionText::RichText.where(account_id: usage_account.id, record_type: "Card", name: "description",
+        record_id: usage_cards.select(:id))
+    end
+
+    def comment_bodies
+      ActionText::RichText.where(account_id: usage_account.id, record_type: "Comment", name: "body",
+        record_id: Comment.where(card_id: usage_cards.select(:id)).select(:id))
+    end
+end
