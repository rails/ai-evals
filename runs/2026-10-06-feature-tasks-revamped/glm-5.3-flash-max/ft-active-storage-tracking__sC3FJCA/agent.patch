diff --git a/test/models/account/usage_test.rb b/test/models/account/usage_test.rb
new file mode 100644
index 0000000..56e4faa
--- /dev/null
+++ b/test/models/account/usage_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::UsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:layout)
+    perform_enqueued_jobs # let creations settle
+  end
+
+  test "#bytes_used counts everything on all of its boards" do
+    image = upload_file("moon.jpg")
+    embed = upload_file("avatar.png")
+
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    @board.update! public_description: ActionText::Content.new("A board").append_attachables(embed)
+
+    assert_equal [ image, embed ].sum(&:byte_size), @account.reload.bytes_used
+  end
+
+  test "#bytes_used counts the usage of boards that are not on the board being read" do
+    other_board = boards(:miltons_wish_list)
+
+    assert_not_equal @board.account, other_board.account
+
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    assert_equal file_fixture("moon.jpg").size, @account.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+  end
+
+  test "#bytes_used does not count avatars" do
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png"
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "#bytes_used drops the usage of a destroyed board" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+    assert_equal file_fixture("moon.jpg").size, @account.reload.bytes_used
+
+    @board.destroy!
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "#bytes_used is up to date once the recalculation has run" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    UsageCalculationJob.perform_now @account.reload
+
+    assert_equal file_fixture("moon.jpg").size, @account.bytes_used_in_database
+  end
+
+  private
+    def upload_file(filename)
+      ActiveStorage::Blob.create_and_upload! io: file_fixture(filename).open, filename: filename
+    end
+end
