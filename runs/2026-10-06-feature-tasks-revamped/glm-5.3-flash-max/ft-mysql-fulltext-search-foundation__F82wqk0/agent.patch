+++ b/app/assets/stylesheets/search.css
@@ -0,0 +1,94 @@
+@layer base {
+  /* Words that matched a search */
+  mark {
+    background-color: var(--color-highlight);
+    color: var(--color-ink);
+    border-radius: 0.25ch;
+    padding-inline: 0.1ch;
+  }
+}
+
+@layer components {
+  /* Search
+  /* ------------------------------------------------------------------------ */
+
+  .search {
+    margin: var(--block-space) auto;
+    max-inline-size: 60ch;
+    padding-inline: var(--inline-space);
+
+    .search__field {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: var(--inline-space-half);
+    }
+
+    .search__field-icon {
+      position: absolute;
+      inset-inline-start: 0.8em;
+      color: var(--color-ink-medium);
+      pointer-events: none;
+    }
+
+    .search__field .input {
+      padding-inline-start: calc(1em + 0.8em);
+    }
+  }
+
+  .search__results {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+    margin: var(--block-space) auto;
+    max-inline-size: 60ch;
+    padding-inline: var(--inline-space);
+    list-style: none;
+  }
+
+  .search__result-link {
+    display: flex;
+    flex-direction: column;
+    gap: var(--inline-space-half);
+    padding: var(--block-space-half) var(--inline-space);
+    border: var(--border);
+    border-radius: 1ch;
+
+    &:where(:hover, :focus-visible) {
+      background-color: var(--color-selected-light);
+    }
+  }
+
+  .search__result-meta {
+    display: flex;
+    align-items: baseline;
+    gap: var(--inline-space);
+    color: var(--color-ink-dark);
+    font-size: var(--text-x-small);
+
+    .search__result-number {
+      color: var(--color-ink-light);
+    }
+  }
+
+  .search__result-title {
+    font-size: var(--text-medium);
+    font-weight: 600;
+  }
+
+  .search__result-excerpt {
+    color: var(--color-ink-dark);
+    font-size: var(--text-small);
+
+    &.search__result-excerpt--comment {
+      .search__result-commenter {
+        font-weight: 600;
+        margin-inline-end: var(--inline-space-half);
+
+        &::after {
+          content: ":";
+        }
+      }
+    }
+  }
+}
