+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..dd5a37c
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,33 @@
+module SearchHelper
+  EXCERPT_LENGTH = 240
+  EXCERPT_CONTEXT = 80
+
+  # Returns a plain text excerpt of +content+ centered on the first term that matches it, so
+  # that whatever matched the search is visible in the results.
+  def search_excerpt(content, terms)
+    text = plain_text_of(content).squish
+    return text if text.blank?
+
+    if match = text.match(match_regexp(terms))
+      excerpt_around(text, match)
+    else
+      text.first(EXCERPT_LENGTH)
+    end
+  end
+
+  private
+    def plain_text_of(content)
+      content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    end
+
+    def match_regexp(terms)
+      /#{terms.collect { |term| Regexp.escape(term) }.join("|")}/i
+    end
+
+    def excerpt_around(text, match)
+      start = [ match.begin(0) - EXCERPT_CONTEXT, 0 ].max
+      finish = [ [ start + EXCERPT_LENGTH, text.length ].min, match.end(0) ].max
+
+      [ ("..." if start.positive?), text[start...finish], ("..." if finish < text.length) ].compact.join
+    end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..25c2882
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,77 @@
+# Finds the published cards somebody can access that match a query in their title,
+# their description, or the body of any of their comments.
+class Search
+  TERM_SEPARATOR = /\s+/
+
+  attr_reader :user, :term
+
+  def initialize(user, term)
+    @user, @term = user, term.to_s
+  end
+
+  def terms
+    term.split(TERM_SEPARATOR).uniq
+  end
+
+  def cards
+    if terms.empty?
+      accessible_cards.none
+    else
+      terms.reduce(accessible_cards) { |scope, term| scope.where(matching, pattern: like_pattern(term)) }
+        .reverse_chronologically
+        .with_rich_text_description
+        .preload(:board, :creator)
+    end
+  end
+
+  def comments(cards)
+    if terms.empty?
+      Comment.none
+    else
+      terms.reduce(Comment.where(card: cards)) { |scope, term| scope.where(matching_comment, pattern: like_pattern(term)) }
+        .chronologically
+        .with_rich_text_body
+        .preload(:creator)
+    end
+  end
+
+  private
+    def accessible_cards
+      user.accessible_cards.published
+    end
+
+    def matching
+      <<~SQL.squish
+        cards.title LIKE :pattern
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.body LIKE :pattern
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_type = 'Comment' AND comment_bodies.record_id = comments.id
+          WHERE comments.card_id = cards.id
+            AND comment_bodies.body LIKE :pattern
+        )
+      SQL
+    end
+
+    def matching_comment
+      <<~SQL.squish
+        EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Comment'
+            AND action_text_rich_texts.record_id = comments.id
+            AND action_text_rich_texts.body LIKE :pattern
+        )
+      SQL
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+    end
+end
