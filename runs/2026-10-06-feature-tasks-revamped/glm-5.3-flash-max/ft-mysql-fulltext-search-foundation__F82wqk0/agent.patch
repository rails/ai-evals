diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..a96a533
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index finds cards by title" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(cards(:logo))}']"
+  end
+
+  test "index finds cards by description" do
+    cards(:layout).update! description: "The overflowing containers need a different approach"
+
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(cards(:layout))}']"
+  end
+
+  test "index finds cards by the body of a comment" do
+    cards(:shipping).comments.create! creator: users(:david), body: "Let us wait for the inevitable review"
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(cards(:shipping))}']"
+  end
+
+  test "index wraps matched words in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+    assert_match(/<mark>logo<\/mark>/i, @response.body)
+  end
+
+  test "index wraps matched words in mark when they only match a comment" do
+    cards(:shipping).comments.create! creator: users(:david), body: "Let us wait for the inevitable review"
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_select "mark", text: "inevitable"
+  end
+
+  test "index matches case insensitively" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+  end
+
+  test "index only returns cards matching every term of the query" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(cards(:logo))}']"
+    assert_select "a[href='#{card_path(cards(:layout))}']", count: 0
+  end
+
+  test "index returns cards newest first" do
+    cards(:shipping).comments.create! creator: users(:david), body: "Wait for the inevitable review", created_at: 3.days.ago
+    cards(:layout).comments.create! creator: users(:david), body: "Wait for the inevitable review", created_at: 1.day.ago
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_equal [ cards(:layout).number, cards(:shipping).number ], card_numbers
+  end
+
+  test "index does not return draft cards" do
+    draft = users(:kevin).draft_new_card_in(boards(:writebook))
+    draft.update! title: "A draft about inevitable things"
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_not_includes @response.body, draft.title
+  end
+
+  test "index does not return comments on draft cards" do
+    card = with_current_user(users(:kevin)) do
+      boards(:writebook).cards.create! creator: users(:kevin), status: :published
+    end
+    card.comments.create! creator: users(:david), body: "Something inevitable"
+    card.update! status: :drafted
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_select "ol.search__results li", count: 0
+  end
+
+  test "index returns cards from boards the user has access to" do
+    hidden = with_current_user(users(:kevin)) do
+      boards(:private).cards.create! title: "An inevitable hidden card", creator: users(:kevin), status: "published"
+    end
+
+    get search_path(q: "inevitable")
+    assert_response :success
+
+    assert_select "a[href='#{card_path(hidden)}']"
+  end
+
+  test "index does not return cards from boards the user has no access to" do
+    with_current_user(users(:kevin)) do
+      boards(:private).cards.create! title: "An inevitable hidden card", creator: users(:kevin), status: "published"
+    end
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "a[href='#{card_path(cards(:logo))}']"
+
+    get search_path(q: "inevitable hidden")
+    assert_response :success
+    assert_select "ol.search__results li", count: 0
+  end
+
+  test "index returns nothing for users with access to no boards" do
+    logout_and_sign_in_as :jason
+
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "ol.search__results li", count: 0
+  end
+
+  test "index paginates results and keeps the query when loading more" do
+    with_current_user(users(:kevin)) do
+      16.times do |index|
+        boards(:writebook).cards.create! title: "A paginated card number #{index}", status: :published
+      end
+    end
+
+    get search_path(q: "paginated")
+    assert_response :success
+
+    assert_equal 15, results_count
+    assert_select ".pagination-link"
+
+    get search_path(q: "paginated", page: 2)
+    assert_response :success
+
+    assert_equal 1, results_count
+  end
+
+  test "index shows a blank slate without a query" do
+    get search_path
+    assert_response :success
+
+    assert_select "form[action='#{search_path}']"
+    assert_select "ol.search__results", count: 0
+  end
+
+  test "index shows a blank slate when nothing matches" do
+    get search_path(q: "unfindable")
+    assert_response :success
+
+    assert_select "ol.search__results", count: 0
+  end
+
+  test "index handles blank queries" do
+    get search_path(q: "   ")
+    assert_response :success
+
+    assert_select "ol.search__results", count: 0
+  end
+
+  test "index handles queries with wildcard characters" do
+    get search_path(q: "100% off_deal")
+    assert_response :success
+
+    assert_select "ol.search__results", count: 0
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+
+  private
+    def results_count
+      @response.parsed_body.css("ol.search__results li").count
+    end
+
+    def card_numbers
+      @response.parsed_body.css("ol.search__results .search__result-number").map(&:text).map { |number| number.delete("#").to_i }
+    end
+end
