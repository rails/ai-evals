diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..28ebd81
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,58 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "search" do |form| %>
+  <div class="search__field">
+    <%= icon_tag "search", class: "search__field-icon" %>
+    <%= form.label :q, "Search", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.term, class: "input", placeholder: "Search cards, descriptions, and comments...",
+      autofocus: true, autocomplete: "off", autocorrect: "off", spellcheck: false, aria: { label: "Search" } %>
+    <%= form.button "Search", class: "btn" %>
+  </div>
+<% end %>
+
+<%= with_automatic_pagination :search_results, @page do %>
+  <% if @page.records.any? %>
+    <ol class="search__results">
+      <% @page.records.each do |card| %>
+        <li class="search__result" id="<%= dom_id(card, :search_result) %>">
+          <%= link_to card_path(card), class: "search__result-link", data: { action: "dialog#close", turbo_frame: "_top" } do %>
+            <span class="search__result-meta">
+              <strong class="search__result-board"><%= card.board.name %></strong>
+              <span class="search__result-number">#<%= card.number %></span>
+              <span class="search__result-creator">Added by <%= card.creator.name %></span>
+            </span>
+
+            <h2 class="search__result-title"><%= highlight card.title.to_s, @search.terms %></h2>
+
+            <% if card.description.present? %>
+              <p class="search__result-excerpt"><%= highlight search_excerpt(card.description, @search.terms), @search.terms %></p>
+            <% end %>
+
+            <% @comments[card.id].to_a.each do |comment| %>
+              <p class="search__result-excerpt search__result-excerpt--comment">
+                <span class="search__result-commenter"><%= comment.creator.name %></span>
+                <%= highlight search_excerpt(comment.body, @search.terms), @search.terms %>
+              </p>
+            <% end %>
+          <% end %>
+        </li>
+      <% end %>
+    </ol>
+  <% else %>
+    <div class="blank-slate">
+      <% if @search.terms.any? %>
+        No cards match "<%= @search.term %>"
+      <% else %>
+        Search your cards by title, description, or comments
+      <% end %>
+    </div>
+  <% end %>
+<% end %>
