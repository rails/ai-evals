+      <p class="notification__author">
+        <%= notification.creator.name %>
+        &middot;
+        <%= notification.created_at.to_fs(:long) %>
+      </p>
+
+      <p class="card__title">
+        <%= link_to notification_title(notification), card_url(notification.card) %>
+      </p>
+
+      <p class="notification__details"><%= notification_body(notification) %></p>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  Your email digest is set to <%= @email_window.frequency_name %>. Change it in
+  <%= link_to "notification settings", notifications_settings_url %>.
+</p>
