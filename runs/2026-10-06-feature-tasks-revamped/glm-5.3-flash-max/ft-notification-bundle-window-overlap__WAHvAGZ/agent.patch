+<h1 class="title"><%= pluralize(@notifications.size, "new notification") %></h1>
+<p class="subtitle">Everything that happened since <%= @email_window.starts_at.to_fs(:long) %>.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
