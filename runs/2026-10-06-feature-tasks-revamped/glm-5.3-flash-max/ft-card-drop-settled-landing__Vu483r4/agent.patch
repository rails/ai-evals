diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..4b0deec
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,208 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @source_column = columns(:writebook_triage)
+    @destination_column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card into a column moves it there" do
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@destination_column)}"))
+
+    assert_equal @destination_column.id, @card.reload.column_id
+    assert_no_selector "##{dom_id(@source_column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_selector "##{dom_id(@destination_column)} .cards__list ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging a card back to Maybe? sends it back to triage" do
+    @card.update!(column: @source_column)
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("#maybe"))
+
+    assert_nil @card.reload.column_id
+    assert_selector "#maybe .cards__list ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    @card.update!(column: @source_column)
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("#not-now"))
+
+    assert @card.reload.postponed?
+    assert_selector "#not-now .cards__list ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging a card onto Done closes it" do
+    @card.update!(column: @source_column)
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("#closed-cards"))
+
+    assert @card.reload.closed?
+    assert_selector "#closed-cards .cards__list ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging a card out of Not Now back into a column resumes it" do
+    @card.postpone
+    visit board_url(@board)
+
+    expand("#not-now")
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@destination_column)}"))
+
+    assert_equal @destination_column.id, @card.reload.column_id
+    assert_not @card.postponed?
+  end
+
+  test "dragging a card within its own column leaves the board alone" do
+    @card.update!(column: @source_column)
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@source_column)}"))
+
+    assert_equal @source_column.id, @card.reload.column_id
+    assert_selector "##{dom_id(@source_column)} .cards__list ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging a card into an empty column fills it" do
+    empty_column = columns(:writebook_on_hold)
+    visit board_url(@board)
+
+    expand("##{dom_id(empty_column)}")
+    assert_selector "##{dom_id(empty_column)} .blank-slate--drag", text: "Drag cards here"
+
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(empty_column)}"))
+
+    assert_equal empty_column.id, @card.reload.column_id
+    assert_selector "##{dom_id(empty_column)} .cards__list ##{dom_id(@card, :article)}", visible: :all
+    assert_equal "1", counter("##{dom_id(empty_column)}")
+    assert_no_selector "##{dom_id(empty_column)} .blank-slate"
+  end
+
+  test "the board is already arranged when the card is dropped" do
+    visit board_url(@board)
+
+    moved = page.evaluate_script(<<~JS)
+      (() => {
+        const item = document.querySelector("##{dom_id(@card, :article)}")
+        const destination = document.querySelector("##{dom_id(@destination_column)}")
+        const dataTransfer = new DataTransfer()
+
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, dataTransfer }))
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+
+        return destination.contains(item)
+      })()
+    JS
+
+    assert moved, "the card should be in its new column as soon as it is dropped"
+    assert_equal @destination_column.id, @card.reload.column_id
+  end
+
+  test "the column counters keep up with the dropped card" do
+    visit board_url(@board)
+
+    assert_equal "1", counter("#maybe")
+    assert_equal "1", counter("##{dom_id(@destination_column)}")
+
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@destination_column)}"))
+
+    assert_equal "0", counter("#maybe")
+    assert_equal "2", counter("##{dom_id(@destination_column)}")
+
+    # The column's progress bar follows the cards as well
+    sleep 0.1
+    assert_equal "0", card_count_var("#maybe")
+    assert_equal "2", card_count_var("##{dom_id(@destination_column)}")
+  end
+
+  test "dragging highlights the column under the pointer and dims the dragged card" do
+    visit board_url(@board)
+
+    classes = page.evaluate_script(<<~JS)
+      (() => {
+        const item = document.querySelector("##{dom_id(@card, :article)}")
+        const destination = document.querySelector("##{dom_id(@destination_column)}")
+        const dataTransfer = new DataTransfer()
+
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer }))
+
+        const highlighted = destination.classList.contains("drag-and-drop__hover-container")
+        const dimmed = item.classList.contains("drag-and-drop__dragged-item")
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+
+        return { highlighted: highlighted, dimmed: dimmed,
+          cleaned: !destination.classList.contains("drag-and-drop__hover-container") && !item.classList.contains("drag-and-drop__dragged-item") }
+      })()
+    JS
+
+    assert classes["highlighted"], "the column under the pointer should light up"
+    assert classes["dimmed"], "the dragged card should dim"
+    assert classes["cleaned"], "the highlight should be gone once the drag ends"
+  end
+
+  test "a broadcast refresh doesn't shift a card that was just dropped" do
+    visit board_url(@board)
+
+    expand("##{dom_id(@source_column)}")
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@destination_column)}"))
+    assert_equal @destination_column.id, @card.reload.column_id
+
+    # The drop's own refresh is ignored by the page, let it settle before
+    # making a change elsewhere.
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    sleep 0.5
+
+    expand("##{dom_id(@destination_column)}")
+    wait_for_cable_subscriptions
+
+    @card.update!(title: "Retitled elsewhere")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_text "Retitled elsewhere"
+    assert_equal dom_id(@card, :article), first_card_id_in(@destination_column)
+  end
+
+  private
+    def counter(column)
+      page.evaluate_script(%(document.querySelector('#{column} .cards__expander-count').textContent.trim()))
+    end
+
+    def card_count_var(column)
+      page.evaluate_script(
+        %(document.querySelector('#{column} [data-css-variable-counter-target~="counter"]').style.getPropertyValue("--card-count"))
+      )
+    end
+
+    def first_card_id_in(column)
+      page.evaluate_script("document.querySelector('##{dom_id(column)} .cards__list .card')?.id")
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def expand(selector)
+      find(selector + " [data-collapsible-columns-target~='button']").click
+      assert_selector selector + ".is-expanded"
+    end
+end
