diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..4b35efa
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,191 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const ITEM_SELECTOR = "[data-drag-and-drop-target~='item']"
+const CONTAINER_SELECTOR = "[data-drag-and-drop-target~='container']"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+// Lets people move a card somewhere else on the board by dragging it: into
+// another column, back to "Maybe?", or onto "Not Now" and "Done".
+//
+// Columns keep their own order, so a drop always changes where a card lives,
+// never where it sits within a column.
+//
+// The board is updated optimistically: the card is placed in its new column as
+// soon as it's dropped and the change is saved in the background, so dropping
+// never waits on the server nor shifts the board afterwards.
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static values = { desktopBreakpoint: { type: String, default: "(min-width: 640px)" } }
+
+  connect() {
+    this.draggedItem = null
+    this.hoveredContainer = null
+
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.mediaQuery.addEventListener("change", this.#toggleDragging)
+
+    // Cards are rendered inside columns that come and go, so keep them draggable.
+    this.observer = new MutationObserver(() => this.#makeItemsDraggable())
+    this.observer.observe(this.element, { childList: true, subtree: true })
+
+    this.#makeItemsDraggable()
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+    this.mediaQuery?.removeEventListener("change", this.#toggleDragging)
+    this.#highlightContainer(null)
+  }
+
+  dragStart(event) {
+    const item = event.target.closest?.(ITEM_SELECTOR)
+    if (!item?.draggable) return
+
+    this.draggedItem = item
+    item.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.querySelector(".card__title")?.textContent ?? "")
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#highlightContainer(this.#containerFor(event.target))
+  }
+
+  dragLeave(event) {
+    if (!this.draggedItem) return
+    if (event.relatedTarget && this.element.contains(event.relatedTarget)) return
+
+    this.#highlightContainer(null)
+  }
+
+  async drop(event) {
+    const item = this.draggedItem
+    if (!item) return
+
+    event.preventDefault()
+
+    const destination = this.#containerFor(event.target) ?? this.hoveredContainer
+    this.#highlightContainer(null)
+
+    await this.#move(item, destination)
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedItem = null
+    this.#highlightContainer(null)
+  }
+
+  // Private
+
+  async #move(item, destination) {
+    const source = this.#containerFor(item)
+    if (!destination || destination === source) return
+
+    const parent = item.parentElement
+    const nextSibling = item.nextElementSibling
+    this.#place(item, destination)
+    this.#updateCounts(source, destination)
+
+    const response = await this.#save(item, destination)
+    if (!response?.ok) this.#undo(item, parent, nextSibling, source, destination)
+  }
+
+  // Shows the card in its new column without waiting for the save to finish.
+  #place(item, destination) {
+    const firstCard = destination.querySelector(".cards__list .card")
+
+    if (firstCard) {
+      firstCard.parentElement?.insertBefore(item, firstCard)
+    } else {
+      destination.querySelector(".cards__list")?.prepend(item)
+    }
+  }
+
+  async #save(item, destination) {
+    switch (destination.dataset.dragAndDropKind) {
+      // A regular column
+      case "column":
+        return post(item.dataset.dragAndDropTriageUrl, {
+          body: { column_id: destination.dataset.dragAndDropColumnId },
+          responseKind: "json"
+        })
+      // Back to the Maybe? column
+      case "triage":
+        return destroy(item.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      // Onto Not Now
+      case "not_now":
+        return post(item.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+      // Onto Done
+      case "closed":
+        return post(item.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+    }
+  }
+
+  #undo(item, parent, nextSibling, source, destination) {
+    this.#restore(item, parent, nextSibling)
+    this.#updateCounts(destination, source)
+  }
+
+  #restore(item, parent, nextSibling) {
+    if (parent?.isConnected) parent.insertBefore(item, nextSibling)
+  }
+
+  // Keeps the column counters in step with the cards people are looking at.
+  #updateCounts(from, to) {
+    this.#changeCount(from, -1)
+    this.#changeCount(to, +1)
+  }
+
+  #changeCount(container, delta) {
+    const counter = container?.querySelector(".cards__expander-count")
+    const current = parseInt(counter?.textContent, 10)
+
+    if (!counter || counter.textContent.includes("+") || Number.isNaN(current)) return
+
+    const count = Math.max(0, current + delta)
+    counter.textContent = count
+  }
+
+  #containerFor(element) {
+    return element?.closest?.(CONTAINER_SELECTOR) ?? null
+  }
+
+  #highlightContainer(container) {
+    if (this.hoveredContainer === container) return
+
+    this.hoveredContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredContainer = container
+    container?.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #makeItemsDraggable() {
+    this.itemTargets.forEach(item => {
+      if (!this.#isDesktop) {
+        item.draggable = false
+        return
+      }
+
+      item.draggable = true
+      // Links and images would otherwise start a drag of their own.
+      item.querySelectorAll("a, img").forEach(element => element.draggable = false)
+    })
+  }
+
+  #toggleDragging = () => this.#makeItemsDraggable()
+
+  get #isDesktop() {
+    return this.mediaQuery?.matches
+  }
+}
