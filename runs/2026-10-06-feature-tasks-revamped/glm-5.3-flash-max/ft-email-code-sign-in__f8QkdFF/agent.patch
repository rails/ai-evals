+  end
+
+  test "create for an existing identity" do
+    @email_code = EmailCode.issue(identities(:kevin).email_address, context: :sign_up)
+
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_difference -> { Session.count }, 1 do
+          post signup_magic_link_path, params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+        end
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with a wrong code" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_difference -> { Session.count } do
+          post signup_magic_link_path, params: { code: "WRONG1" }, headers: pending_authentication(@email_code)
+        end
+      end
+
+      assert_response :unprocessable_entity
+      assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    travel 16.minutes do
+      untenanted do
+        post signup_magic_link_path, params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+
+        assert_response :unprocessable_entity
+      end
+    end
+  end
+
+  test "create without a pending authentication" do
+    untenanted do
+      post signup_magic_link_path, params: { code: @email_code.code }
+
+      assert_redirected_to new_signup_path
+    end
+  end
+
+  private
+    def pending_authentication(email_code)
+      { "Cookie" => "pending_authentication_token=#{email_code.pending_authentication_token}" }
+    end
+end
