+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+    @email_code = EmailCode.issue(@identity.email_address, context: :sign_in)
+  end
+
+  test "new" do
+    untenanted do
+      get new_session_magic_link_path, headers: pending_authentication(@email_code)
+
+      assert_response :success
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "new ignores a pending authentication for another flow" do
+    email_code = EmailCode.issue(identities(:kevin).email_address, context: :sign_up)
+
+    untenanted do
+      get new_session_magic_link_path, headers: { "Cookie" => "pending_authentication_token=#{email_code.pending_authentication_token}" }
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "new without a pending authentication" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
