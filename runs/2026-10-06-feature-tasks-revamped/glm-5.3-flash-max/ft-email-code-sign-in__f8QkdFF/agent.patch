+      end
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not @email_code.reload.active?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "create with a wrong code" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WRONG1" }, headers: pending_authentication(@email_code)
+      end
+
+      assert_response :unprocessable_entity
+      assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+      assert @email_code.reload.active?
+    end
