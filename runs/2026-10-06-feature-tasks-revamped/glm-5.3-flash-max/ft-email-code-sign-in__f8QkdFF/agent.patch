diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..c407dc8
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,66 @@
+# A code that is emailed to someone so that they can sign in, sign up, or join an
+# account with their email address. It is entered on the screen that the pending
+# authentication token ties it to.
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = ("A".."Z").to_a - %w[ I O ] + ("2".."9").to_a # Without characters that are easy to mix up
+  LIFETIME = 15.minutes
+  CONTEXTS = %w[ sign_in sign_up join ]
+
+  generates_token_for :pending_authentication, expires_in: LIFETIME
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.strip.upcase.presence }
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, length: { is: CODE_LENGTH }
+  validates :context, inclusion: { in: CONTEXTS }
+
+  class << self
+    def issue(email_address, context:)
+      transaction do
+        # Truncated to the second, so the code is good for the whole fifteen minutes.
+        email_code = create!(email_address:, context:, code: generate_code, expires_at: LIFETIME.from_now.change(usec: 0))
+        retire(email_address: email_code.email_address, context: email_code.context, except: email_code)
+
+        email_code
+      end
+    end
+
+    def cleanup
+      where("expires_at < ?", 1.day.ago).delete_all
+    end
+
+    private
+      def generate_code
+        CODE_LENGTH.times.map { CODE_CHARACTERS.sample(random: SecureRandom) }.join
+      end
+
+      def retire(email_address:, context:, except:)
+        where(email_address:, context:).where.not(id: except).find_each(&:retire)
+      end
+  end
+
+  def active?
+    consumed_at.nil? && expires_at > Time.current
+  end
+
+  # The token that ties the code to the screen it is entered on. Generated once
+  # per code, so that the value handed to the client is always the same.
+  def pending_authentication_token
+    @pending_authentication_token ||= generate_token_for(:pending_authentication)
+  end
+
+  def consume(code)
+    with_lock do
+      if active? && self.code == self.class.normalize_value_for(:code, code)
+        update!(consumed_at: Time.current)
+        self
+      end
+    end
+  end
+
+  def retire
+    update!(consumed_at: Time.current)
+  end
+end
