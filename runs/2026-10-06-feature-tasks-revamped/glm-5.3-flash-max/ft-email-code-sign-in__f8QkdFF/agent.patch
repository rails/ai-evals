@@ -0,0 +1,17 @@
+module Joining
+  extend ActiveSupport::Concern
+
+  private
+    # Joins the identity to the account of the join code and redirects to the next
+    # step for the joined user. Relies on @join_code being set.
+    def join_account(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: @join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+      end
+    end
+end
diff --git a/app/controllers/concerns/pending_authentication.rb b/app/controllers/concerns/pending_authentication.rb
new file mode 100644
index 0000000..983c551
--- /dev/null
+++ b/app/controllers/concerns/pending_authentication.rb
@@ -0,0 +1,25 @@
+# Carries the email code that was issued between the screen where someone typed
+# their email address and the screen where they type the code.
+module PendingAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def remember_pending_authentication(email_code)
+      cookies[:pending_authentication_token] = {
+        value: email_code.pending_authentication_token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_email_code(context)
+      if token = cookies[:pending_authentication_token]
+        email_code = EmailCode.find_by_token_for(:pending_authentication, token)
+        email_code if email_code&.context == context.to_s
+      end
+    end
+
+    def forget_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+end
