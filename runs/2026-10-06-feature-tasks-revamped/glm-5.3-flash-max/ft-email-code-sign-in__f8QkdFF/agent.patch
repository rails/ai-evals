+    end
+  end
+
+  test "create for an email address without an account" do
+    @email_code = EmailCode.issue("nobody@37signals.com", context: :sign_in)
+
+    untenanted do
+      post session_magic_link_path, params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+
+      assert_response :unprocessable_entity
+      assert_equal "We couldn't find an account for that email address.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path, params: { code: @email_code.code }, headers: pending_authentication(@email_code)
