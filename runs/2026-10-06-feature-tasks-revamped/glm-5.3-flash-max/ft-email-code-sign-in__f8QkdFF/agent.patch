+class JoinCodes::MagicLinksController < ApplicationController
+  include Joining
+  include PendingAuthentication
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  before_action :require_pending_authentication
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if email_code = @email_code.consume(params.expect(:code))
+      forget_pending_authentication
+      join email_code
+    else
+      code_not_valid
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params[:join_code], account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def join(email_code)
+      identity = Identity.find_or_create_by!(email_address: email_code.email_address)
+      start_new_session_for identity
+
+      join_account identity
+    end
+
+    def require_pending_authentication
+      @email_code = pending_email_code :join
+
+      redirect_to join_path(code: @join_code.code) unless @email_code
+    end
+
+    def code_not_valid
+      message = "That code didn't work. Check it and try again."
+      flash.now[:alert] = message
+
+      render :new, status: :unprocessable_entity
+    end
+end
