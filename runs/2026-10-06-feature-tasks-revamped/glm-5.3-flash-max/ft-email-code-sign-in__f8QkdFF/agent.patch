diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..af71e5e
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issues a six-character code" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_equal "new@37signals.com", email_code.email_address
+    assert_equal 6, email_code.code.length
+    assert_match(/\A[A-HJ-NP-Z2-9]{6}\z/, email_code.code)
+    assert email_code.active?
+  end
+
+  test "issues are good for fifteen minutes" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    travel_to 14.minutes.from_now do
+      assert email_code.active?
+    end
+
+    travel_to 15.minutes.from_now do
+      assert_not email_code.active?
+    end
+  end
+
+  test "consumes an active code regardless of how it was typed" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_equal email_code, email_code.consume(" #{email_code.code.downcase} ")
+    assert_not email_code.reload.active?
+  end
+
+  test "doesn't consume a wrong code" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_nil email_code.consume("WRONG1")
+    assert email_code.reload.active?
+  end
+
+  test "doesn't consume an expired code" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    travel_to 16.minutes.from_now do
+      assert_nil email_code.consume(email_code.code)
+    end
+  end
+
+  test "consumes a code only once" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_equal email_code, email_code.consume(email_code.code)
+    assert_nil email_code.consume(email_code.code)
+  end
+
+  test "issues replace the codes issued before" do
+    superseded = EmailCode.issue("new@37signals.com", context: :sign_in)
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_not superseded.reload.active?
+    assert email_code.active?
+  end
+
+  test "keeps codes for other contexts and addresses when issuing" do
+    other_context = EmailCode.issue("new@37signals.com", context: :sign_up)
+    other_address = EmailCode.issue("someone.else@37signals.com", context: :sign_in)
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert other_context.reload.active?
+    assert other_address.reload.active?
+    assert email_code.active?
+  end
+
+  test "authenticates a pending code" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+
+    assert_equal email_code, EmailCode.find_by_token_for(:pending_authentication, email_code.pending_authentication_token)
+  end
+
+  test "doesn't authenticate a pending code that was tampered with" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+    token = email_code.pending_authentication_token
+
+    assert_nil EmailCode.find_by_token_for(:pending_authentication, token[..-2] + "z")
+  end
+
+  test "doesn't authenticate a pending code that is too old" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+    token = email_code.pending_authentication_token
+
+    travel_to 16.minutes.from_now do
+      assert_nil EmailCode.find_by_token_for(:pending_authentication, token)
+    end
+  end
+
+  test "cleanup" do
+    expired = EmailCode.issue("new@37signals.com", context: :sign_in)
+    expired.update!(expires_at: 2.days.ago)
+    email_code = EmailCode.issue("someone.else@37signals.com", context: :sign_in)
+
+    assert_difference -> { EmailCode.count }, -1 do
+      EmailCode.cleanup
+    end
+
+    assert EmailCode.exists?(email_code.id)
+  end
+
+  test "requires a valid email address" do
+    assert_not EmailCode.new(email_address: "not-an-email", code: "ABC234", context: "sign_in", expires_at: 15.minutes.from_now).valid?
+  end
+
+  test "requires a known context" do
+    assert_not EmailCode.new(email_address: "new@37signals.com", code: "ABC234", context: "hijack", expires_at: 15.minutes.from_now).valid?
+  end
+end
