+require "application_system_test_case"
+
+class SignInByEmailCodeTest < ApplicationSystemTestCase
+  test "signing in with a code from an email" do
+    identity = identities(:kevin)
+
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identity.email_address
+    find("#log_in").click
+
+    assert_selector "h1", text: "Enter your code"
+    assert_text identity.email_address
+
+    fill_in "code", with: EmailCode.sole.code
+    click_on "Sign in"
+
+    assert_current_path root_path(script_name: identity.accounts.first.slug)
+  end
+
+  test "signing in with a wrong code" do
+    identity = identities(:kevin)
+    EmailCode.issue(identity.email_address, context: :sign_in)
+
+    visit new_session_url(script_name: nil)
+    fill_in "email_address", with: identity.email_address
+    find("#log_in").click
+    fill_in "code", with: "WRONG1"
+    click_on "Sign in"
+
+    assert_text "That code didn't work. Check it and try again."
+  end
+end
