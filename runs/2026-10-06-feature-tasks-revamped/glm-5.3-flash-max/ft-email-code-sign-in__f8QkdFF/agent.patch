@@ -0,0 +1,27 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email code" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+    email = IdentityMailer.email_code(email_code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "new@37signals.com" ], email.to
+    assert_includes email.subject, email_code.code
+    assert_match email_code.code, email.body.encoded
+    assert_match "15 minutes", email.body.encoded
+  end
+
+  test "email code has both HTML and text parts" do
+    email_code = EmailCode.issue("new@37signals.com", context: :sign_in)
+    email = IdentityMailer.email_code(email_code)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+    assert_match email_code.code, email.html_part.body.encoded
+    assert_match email_code.code, email.text_part.body.encoded
+  end
+end
