+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    @email_code = EmailCode.issue("someone.new@37signals.com", context: :join)
+  end
+
+  test "new" do
+    get new_join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug), headers: pending_authentication(@email_code)
+
+    assert_response :success
+    assert_in_body "someone.new@37signals.com"
+    assert_in_body "37signals"
+  end
+
+  test "new without a pending authentication" do
+    get new_join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_redirected_to join_path(code: @join_code.code, script_name: @account.slug)
+  end
+
+  test "new with an invalid join code" do
+    get new_join_code_magic_link_path(join_code: "INVALID-CODE", script_name: @account.slug), headers: pending_authentication(@email_code)
+
+    assert_response :not_found
+  end
+
+  test "new with an inactive join code" do
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    get new_join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug), headers: pending_authentication(@email_code)
+
+    assert_response :gone
+    assert_in_body "That code is all used up"
+  end
+
+  test "create" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        assert_difference -> { @join_code.reload.usage_count }, 1 do
+          assert_difference -> { Session.count }, 1 do
+            post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+              params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+          end
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+    assert_not cookies[:pending_authentication_token].present?
+  end
+
+  test "create for an existing identity without a user in the account" do
+    identity = identities(:mike)
+    assert_not identity.users.exists?(account: @account), "Mike should not be a member of 37s for this test"
+
+    @email_code = EmailCode.issue(identity.email_address, context: :join)
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference -> { User.count }, 1 do
+        post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+          params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create for an identity that is already a member" do
+    identity = identities(:jz)
+    assert identity.users.find_by!(account: @account).setup?, "JZ's user should be setup for this test"
+
+    @email_code = EmailCode.issue(identity.email_address, context: :join)
+
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { @join_code.reload.usage_count } do
+          post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+            params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+        end
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create with a wrong code" do
+    assert_no_difference -> { Identity.count } do
+      assert_no_difference -> { User.count } do
+        post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+          params: { code: "WRONG1" }, headers: pending_authentication(@email_code)
+      end
+    end
+
+    assert_response :unprocessable_entity
+    assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with an expired code" do
+    travel 16.minutes do
+      post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+        params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create without a pending authentication" do
+    post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: @email_code.code }
+
+    assert_redirected_to join_path(code: @join_code.code, script_name: @account.slug)
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    post join_code_magic_link_path(join_code: @join_code.code, script_name: @account.slug),
+      params: { code: @email_code.code }, headers: pending_authentication(@email_code)
+
+    assert_response :too_many_requests
+  end
+
+  private
+    def pending_authentication(email_code)
+      { "Cookie" => "pending_authentication_token=#{email_code.pending_authentication_token}" }
+    end
+end
