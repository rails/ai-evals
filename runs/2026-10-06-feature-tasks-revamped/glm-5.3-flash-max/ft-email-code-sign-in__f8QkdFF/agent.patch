@@ -0,0 +1,74 @@
+class Sessions::MagicLinksController < ApplicationController
+  include PendingAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :require_pending_authentication
+
+  def new
+  end
+
+  def create
+    if email_code = @email_code.consume(params.expect(:code))
+      sign_in email_code
+    else
+      code_not_valid
+    end
+  end
+
+  private
+    def require_pending_authentication
+      @email_code = pending_email_code :sign_in
+
+      unless @email_code
+        respond_to do |format|
+          format.html { redirect_to new_session_path }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def sign_in(email_code)
+      if identity = Identity.find_by(email_address: email_code.email_address)
+        forget_pending_authentication
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        identity_not_found
+      end
+    end
+
+    def code_not_valid
+      respond_with_message "That code didn't work. Check it and try again.", status: :unauthorized
+    end
+
+    def identity_not_found
+      respond_with_message "We couldn't find an account for that email address.", status: :unauthorized
+    end
+
+    def respond_with_message(message, status:)
+      flash.now[:alert] = message
+
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { message: message }, status: status }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
