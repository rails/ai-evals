index 7e81725..6e12951 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -74,6 +74,34 @@ Rails.application.configure do
   config.solid_queue.connects_to = { database: { writing: :queue, reading: :queue } }
   # config.active_job.queue_name_prefix = "fizzy_production"
 
+  # Where Fizzy is served from. Used for the absolute URLs in emails,
+  # notifications and webhooks. Set it in config/deploy.yml.
+  if (app_host = ENV["APP_HOST"]).present?
+    url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options = url_options
+    # For URLs built outside a request, e.g. by background jobs.
+    Rails.application.routes.default_url_options = url_options
+  end
+
+  # Outbound email. Magic links, notifications and exports are all delivered by
+  # email, so Fizzy needs a mail server to be of any use. Configure it with the
+  # SMTP_* variables (see config/deploy.yml); without them, mail is sent to
+  # localhost:25.
+  if (smtp_address = ENV["SMTP_ADDRESS"]).present?
+    config.action_mailer.delivery_method = :smtp
+    smtp_settings = { address: smtp_address, port: ENV.fetch("SMTP_PORT", 587).to_i }
+    smtp_settings[:domain] = ENV["SMTP_DOMAIN"] if ENV["SMTP_DOMAIN"].present?
+    smtp_settings[:tls] = true if ENV["SMTP_TLS"] == "true"
+    smtp_settings[:enable_starttls_auto] = ENV.fetch("SMTP_STARTTLS_AUTO", "true") == "true"
+    smtp_settings[:openssl_verify_mode] = ENV["SMTP_OPENSSL_VERIFY_MODE"].to_sym if ENV["SMTP_OPENSSL_VERIFY_MODE"].present?
+    if (smtp_username = ENV["SMTP_USERNAME"]).present?
+      smtp_settings[:user_name] = smtp_username
+      smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+    end
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
   config.action_mailer.perform_caching = false
 
   # Ignore bad email addresses and do not raise email delivery errors.
