@@ -0,0 +1,103 @@
+# Deploy Fizzy to one box with Kamal.
+#
+# This is the configuration for running Fizzy yourself: one Linux server with
+# Docker, one container, SQLite for the database, background jobs inside that
+# container, and SSL from the proxy. docs/self-hosting.md walks through it
+# step by step.
+#
+# Fill in the FILL INs below, put your secrets in .kamal/secrets, then run:
+#
+#   bin/kamal setup
+
+<%
+  # FILL IN: the hostname people use to reach your Fizzy. It needs a DNS record
+  # pointing at your server, because kamal-proxy gets a certificate for it.
+  host = "fizzy.example.com"
+
+  # FILL IN: the SMTP server that delivers your email. Fizzy sends magic links
+  # by email, so without this nobody can log in. Credentials belong in
+  # .kamal/secrets, not here.
+  smtp_address = "smtp.example.com"
+  smtp_port = 587
+  smtp_domain = "example.com"
+  mailer_from = "Fizzy <fizzy@example.com>"
+%>
+
+service: fizzy
+
+# FILL IN: where the image you build lives. This is a Docker Hub repository,
+# which is private only if you create it as private.
+image: your-docker-hub-username/fizzy
+
+# The one box. Everything runs in this container: Rails, SQLite, Solid Queue
+# (via the puma plugin in config/puma.rb) and uploaded files.
+servers:
+  web:
+    hosts:
+      - <%= host %>
+
+# kamal-proxy listens on 80 and 443 on the box, terminates SSL with a
+# certificate from Let's Encrypt, and forwards to the container.
+proxy:
+  host: <%= host %>
+  ssl: true
+
+# SQLite databases and uploaded files are written here. This is a named volume,
+# so your data survives every deploy.
+volumes:
+  - fizzy:/rails/storage
+
+# Keeps old assets around during a deploy, so the browser never 404s on a
+# stylesheet or script it is still holding on to.
+asset_path: /rails/public/assets
+
+# The image is built on your machine and pushed here, then pulled by the box.
+# Anything Docker can log in to works; for a registry other than Docker Hub add
+# a `server:` to the registry block below, e.g.:
+#
+#   registry:
+#     server: ghcr.io
+#     username: your-github-username
+#     password:
+#       - KAMAL_REGISTRY_PASSWORD
+registry:
+  username: your-docker-hub-username # FILL IN
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64 # arm64 for an ARM box
+
+env:
+  clear:
+    # Absolute URLs in emails, notifications and webhooks.
+    APP_HOST: <%= host %>
+    MAILER_FROM_ADDRESS: <%= mailer_from %>
+    SMTP_ADDRESS: <%= smtp_address %>
+    SMTP_PORT: <%= smtp_port %>
+    SMTP_DOMAIN: <%= smtp_domain %>
+    # A single box doesn't need a process per CPU. Raise these if yours is big.
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+    # Signups close once the first account exists. Uncomment to keep taking them.
+    # MULTI_TENANT: "true"
+  secret:
+    # Signs cookies and links. Generate with `bin/rails secret`.
+    - SECRET_KEY_BASE
+    # Login for the mail server. If your relay needs no authentication, set
+    # both to anything you like.
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Browser push notifications stay off until you add these here and to
+    # .kamal/secrets. Generate them with the `web-push` gem (see
+    # docs/development.md):
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# Handy shortcuts, e.g. `bin/kamal console` and `bin/kamal ssh`.
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  ssh: app exec -i --reuse "/bin/bash"
+
+# Keep disk usage down on a small box.
+retain_containers: 2
