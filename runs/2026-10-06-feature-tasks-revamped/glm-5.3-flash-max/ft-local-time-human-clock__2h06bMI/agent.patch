diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..41d5f2e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTime, formatFullTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+const instances = new Set()
+let refresher
+
+// The server only ships the raw timestamp inside <time datetime>, so that the
+// same HTML can be cached for everybody. This controller fills in the words in
+// the timezone the browser is running in.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #rerender = () => this.render()
+
+  connect() {
+    this.render()
+    this.element.addEventListener("turbo:morph-element", this.#rerender)
+    keepFresh(this)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.#rerender)
+    instances.delete(this)
+    stopKeepingFresh()
+  }
+
+  render() {
+    const timestamp = this.element.getAttribute("datetime")
+
+    if (timestamp) {
+      this.element.textContent = formatTime(timestamp, this.formatValue)
+      this.element.title = formatFullTime(timestamp)
+    }
+  }
+}
+
+function keepFresh(instance) {
+  instances.add(instance)
+
+  if (!refresher) {
+    refresher = setInterval(() => instances.forEach(instance => instance.render()), REFRESH_INTERVAL)
+  }
+}
+
+function stopKeepingFresh() {
+  if (instances.size === 0 && refresher) {
+    clearInterval(refresher)
+    refresher = null
+  }
+}
