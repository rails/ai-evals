diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..56b598f 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,39 @@
 module TimeHelper
+  DEFAULT_FORMAT = :relative
+
+  # Times read differently depending on where you are, so the server only ships
+  # the raw timestamp and the browser turns it into words in the viewer's own
+  # timezone (see app/javascript/controllers/local_time_controller.js). That keeps
+  # the very same HTML cacheable for everybody, wherever they are.
+  #
+  # Pass a time to render an instant, or a date to render a calendar day, which
+  # the browser won't shift into its own timezone.
+  #
+  # Formats: :relative ("yesterday", "5 days ago", "Sep 12"), :time ("1:42 PM"),
+  # :date ("Monday, September 15"), :short_date ("Sep 12"),
+  # :stamp ("Sep 15, 2025") and :short_datetime ("9/15/25, 1:42 PM").
+  def local_time_tag(datetime, format: DEFAULT_FORMAT, **options)
+    if datetime
+      tag.time datetime: timestamp_of(datetime), data: local_time_data(format), **options
+    end
+  end
+
+  private
+    def local_time_data(format)
+      if format == DEFAULT_FORMAT
+        { controller: "local-time" }
+      else
+        { controller: "local-time", local_time_format_value: format }
+      end
+    end
+
+    # Instants are normalized to UTC so the markup doesn't depend on which
+    # timezone the request happened to be rendered in.
+    def timestamp_of(datetime)
+      if datetime.respond_to?(:utc)
+        datetime.utc.iso8601
+      else
+        datetime.iso8601
+      end
+    end
 end
