diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8f3d97d
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders the raw timestamp and no words at all" do
+    travel_to "2025-09-19 12:00"
+
+    assert_dom_equal \
+      %(<time datetime="2025-09-15T20:42:00Z" data-controller="local-time"></time>),
+      local_time_tag(ActiveSupport::TimeZone["America/Los_Angeles"].parse("2025-09-15 13:42"))
+  end
+
+  test "renders the same markup no matter which timezone the server renders in" do
+    timestamp = Time.utc(2025, 9, 15, 20, 42)
+
+    markup = Time.use_zone("America/New_York") { local_time_tag(timestamp) }
+    same_markup = Time.use_zone("Asia/Tokyo") { local_time_tag(timestamp) }
+
+    assert_equal markup, same_markup
+  end
+
+  test "renders a calendar day as a bare date" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-15" data-controller="local-time" data-local-time-format-value="date"></time>),
+      local_time_tag(Date.new(2025, 9, 15), format: :date)
+  end
+
+  test "accepts extra attributes" do
+    assert_dom_equal \
+      %(<time datetime="2025-09-15T20:42:00Z" data-controller="local-time" class="local-time-value"></time>),
+      local_time_tag(Time.utc(2025, 9, 15, 20, 42), class: "local-time-value")
+  end
+
+  test "renders nothing without a timestamp" do
+    assert_nil local_time_tag(nil)
+  end
+end
diff --git a/test/integration/local_time_rendering_test.rb b/test/integration/local_time_rendering_test.rb
new file mode 100644
index 0000000..8648ae7
--- /dev/null
+++ b/test/integration/local_time_rendering_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  test "pages ship raw timestamps and no words" do
+    sign_in_as users(:david)
+
+    get card_path(cards(:layout))
+
+    assert_response :success
+    assert_select "time[datetime]"
+    assert_select "time[datetime]", text: /\S/, count: 0
+  end
+
+  test "the same timestamps are shipped to viewers in any timezone" do
+    sign_in_as users(:david)
+
+    get card_path(cards(:layout))
+    rendered_in_new_york = shipped_timestamps
+
+    cookies[:timezone] = "Asia/Tokyo"
+    get card_path(cards(:layout))
+    rendered_in_tokyo = shipped_timestamps
+
+    assert_not_empty rendered_in_new_york
+    assert_equal rendered_in_new_york, rendered_in_tokyo
+  end
+
+  private
+    def shipped_timestamps
+      response.body.scan(/<time datetime="([^"]+)"/).flatten
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..d9a26fa
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,135 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  # Fixed to noon UTC, so a day always has twelve hours on either side of it and
+  # none of the words below depend on when the suite happens to run.
+  NOW = Time.utc(2025, 9, 19, 12, 0, 0)
+
+  test "a comment from earlier today reads as a clock time" do
+    visit_card_with_comment_created_at(NOW - 2.hours)
+
+    assert_comment_time "10:00 AM"
+  end
+
+  test "a comment from last night reads as yesterday" do
+    visit_card_with_comment_created_at(NOW - 1.day)
+
+    assert_comment_time /yesterday/i
+  end
+
+  test "a comment from earlier in the week reads as days ago" do
+    visit_card_with_comment_created_at(NOW - 5.days)
+
+    assert_comment_time /5 days ago/i
+  end
+
+  test "a card from over a week ago reads as a plain date" do
+    card = cards(:layout)
+    card.update_columns(created_at: NOW - 7.days, last_active_at: NOW - 7.days)
+
+    visit_card_and_freeze_clock(card)
+
+    within(".card__meta-text--added") do
+      assert_time /sep 12/i
+    end
+
+    within(".card__meta-text--updated") do
+      assert_time /sep 12/i
+    end
+  end
+
+  test "the activity timeline spells out the day in the browser" do
+    sign_in_as(users(:david))
+
+    visit root_path
+    freeze_browser_clock_at(NOW)
+
+    assert_selector "time[data-local-time-format-value=date]", text: /\S/
+  end
+
+  test "a card auto-closing overnight reads as tomorrow" do
+    visit_card_auto_closing_at(NOW + 1.day)
+
+    within(".card-perma__closure-message") do
+      assert_text(/Moves to .Not Now. tomorrow if there.s no activity/)
+      assert_time "tomorrow"
+    end
+  end
+
+  test "a card auto-closing further out reads as days away" do
+    visit_card_auto_closing_at(NOW + 3.days)
+
+    within(".card-perma__closure-message") do
+      assert_text(/Moves to .Not Now. in 3 days if there.s no activity/)
+      assert_time "in 3 days"
+    end
+  end
+
+  private
+    def visit_card_and_freeze_clock(card)
+      sign_in_as(users(:david))
+
+      visit card_url(card)
+      freeze_browser_clock_at(NOW)
+    end
+
+    def visit_card_with_comment_created_at(created_at)
+      card = cards(:layout)
+      @comment = card.comments.create!(creator: users(:david), body: "A comment").tap do |comment|
+        comment.update_columns(created_at: created_at)
+      end
+
+      visit_card_and_freeze_clock(card)
+    end
+
+    # Card::Entropy auto-cleans a card three days after its last activity, so the
+    # activity date is what decides how far out the cleanup lands.
+    def visit_card_auto_closing_at(auto_clean_at)
+      boards(:writebook).update!(auto_postpone_period: 3.days)
+      card = cards(:layout)
+      card.update_columns(last_active_at: auto_clean_at - 3.days)
+
+      visit_card_and_freeze_clock(card)
+    end
+
+    def assert_comment_time(text)
+      within("##{dom_id(@comment)}") do
+        assert_time text
+      end
+    end
+
+    def assert_time(text)
+      assert_selector "time", text: text
+    end
+
+    # The browser spells the times out, so its clock is the one that matters.
+    # Shift it and ask every timestamp on the page to say itself again.
+    def freeze_browser_clock_at(time)
+      epoch_milliseconds = (time.to_f * 1000).to_i
+
+      page.execute_script <<~JS
+        const RealDate = Date
+        const offset = #{epoch_milliseconds} - RealDate.now()
+
+        class ShiftedDate extends RealDate {
+          constructor(...args) {
+            if (args.length === 0) {
+              super(RealDate.now() + offset)
+            } else {
+              super(...args)
+            }
+          }
+
+          static now() {
+            return RealDate.now() + offset
+          }
+        }
+
+        window.Date = ShiftedDate
+
+        document.querySelectorAll("[data-controller~='local-time']").forEach(element => {
+          element.dispatchEvent(new Event("turbo:morph-element"))
+        })
+      JS
+    end
+end
