@@ -0,0 +1,41 @@
+class ActivitiesController < ApplicationController
+  ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.where(action: ACTIONS)
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events.reverse_chronologically
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
