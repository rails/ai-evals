@@ -0,0 +1,52 @@
+# Activities
+
+Activities are the account's timeline of events across the boards you can access.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated, flat list of activity in reverse chronological order (newest first). Only activity from boards you can access is returned.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by user ID(s) who created the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+List parameters can be repeated to provide multiple values, for example `?creator_ids[]=03f...&creator_ids[]=03f...`.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David assigned JZ to \"First!\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {},
+    "board": {},
+    "creator": {}
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` fields use the same representations as the cards, comments, boards, and users endpoints.
+
+The `particulars` object exposes details specific to the event:
+
+| Event | Particulars |
+|-------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged`, `card_sent_back_to_triage` | `column` |
+
+Other events return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+For card events, `url` opens the card. For comment events, `url` opens the card where the comment was posted and includes an anchor that jumps to the comment.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..5feeafd
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index returns newest activity first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_kind_of Array, body
+
+    created_ats = body.map { |activity| Time.zone.parse(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index includes timeline actions except deprecated collection changes and includes title changes" do
+    events(:logo_published).update_column(:action, "card_collection_changed")
+    cards(:logo).update!(title: "A new title")
+
+    get activities_path(format: :json)
+
+    actions = @response.parsed_body.map { |activity| activity["action"] }
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "index exposes the expected event fields" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:logo_assignment_jz).id }
+    assert activity.present?
+
+    %w[id action created_at description particulars url eventable_type eventable board creator].each do |key|
+      assert activity.key?(key), "Expected activity to include #{key}"
+    end
+
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity["eventable"]["id"]
+    assert_equal boards(:writebook).id, activity["board"]["id"]
+    assert_equal users(:david).id, activity["creator"]["id"]
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index returns card events with card urls" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:logo_published).id }
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index returns comment events with anchored card urls" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["eventable_type"] == "Comment" }
+    assert_equal comment.id, activity["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+  end
+
+  test "index returns plain text descriptions" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:logo_published).id }
+    assert_equal events(:logo_published).description_for(users(:david)).to_plain_text, activity["description"]
+  end
+
+  test "particulars expose board, title and triage details" do
+    cards(:logo).update!(title: "Renamed card")
+    cards(:text).triage_into(columns(:writebook_on_hold))
+
+    get activities_path(format: :json)
+
+    title_change = @response.parsed_body.find { |event| event["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "Renamed card" }, title_change["particulars"])
+
+    triage = @response.parsed_body.find { |event| event["action"] == "card_triaged" }
+    assert_equal({ "column" => "On Hold" }, triage["particulars"])
+  end
+
+  test "particulars expose board changes" do
+    board_change_event = boards(:writebook).events.create!(
+      action: "card_board_changed",
+      creator: users(:david),
+      eventable: cards(:logo),
+      particulars: { "particulars" => { "old_board" => "Old board", "new_board" => "New board" } }
+    )
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == board_change_event.id }
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activity["particulars"])
+  end
+
+  test "particulars expose an empty column for events sent back to triage" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:buy_domain_sent_back_to_triage).id }
+    assert_equal({ "column" => "" }, activity["particulars"])
+  end
+
+  test "particulars default missing board, title and column values to empty strings" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: {})
+    events(:layout_published).update_columns(action: "card_title_changed", particulars: {})
+    events(:shipping_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path(format: :json)
+
+    board_change = @response.parsed_body.find { |event| event["id"] == events(:logo_published).id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_change["particulars"])
+
+    title_change = @response.parsed_body.find { |event| event["id"] == events(:layout_published).id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_change["particulars"])
+
+    triage = @response.parsed_body.find { |event| event["id"] == events(:shipping_published).id }
+    assert_equal({ "column" => "" }, triage["particulars"])
+  end
+
+  test "particulars are empty for other events" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:shipping_closed).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "filters by creator ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    creator_ids = @response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+  end
+
+  test "filters by board ids" do
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "only returns activity from accessible boards" do
+    event = boards(:private).events.create!(
+      action: "card_published",
+      creator: users(:kevin),
+      eventable: cards(:logo)
+    )
+
+    get activities_path(format: :json)
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, event.id
+
+    logout_and_sign_in_as :kevin
+    get activities_path(format: :json)
+    assert_includes @response.parsed_body.map { |activity| activity["id"] }, event.id
+  end
+
+  test "paginates activity" do
+    20.times do |index|
+      boards(:writebook).events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo),
+        created_at: index.minutes.ago
+      )
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_operator @response.headers["X-Total-Count"].to_i, :>, 15
+    assert @response.headers["Link"].present?
+  end
+end
