@@ -0,0 +1,44 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Event.preloaded.includes(
+        creator: :identity,
+        board: [ :creator, :entropy, :publication ],
+        eventable: [
+          :tags, :not_now, { column: :board },
+          { creator: :identity }, { assignees: :identity },
+          { card: [ :tags, :not_now, { column: :board }, { creator: :identity }, { assignees: :identity } ] }
+        ]
+      ).where(board: Current.user.boards, action: ACTIVITY_ACTIONS)
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events.reverse_chronologically
+    end
+
+    def creator_ids
+      @creator_ids ||= Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array(params[:board_ids]).compact_blank
+    end
+end
