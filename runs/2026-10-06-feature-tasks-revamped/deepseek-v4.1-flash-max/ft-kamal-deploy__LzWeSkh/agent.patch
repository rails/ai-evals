+# Kamal configuration for a single-box Fizzy deployment.
+#
+# Everything -- the web server, background jobs, SQLite databases, and uploaded
+# files -- runs in one container on one Linux server, with SSL provided by
+# kamal-proxy.
+#
+# Before running `bin/kamal setup`:
+#
+#   1. Set `servers.web` to your server's IP address.
+#   2. Set `proxy.host` and `APP_HOST` to the hostname Fizzy will be served at.
+#      The hostname's DNS record must point at the server.
+#   3. Set the `MAILER_FROM_ADDRESS` and `SMTP_*` values to your mail server.
+#   4. Fill in `.kamal/secrets`.
+#
+# See docs/deployment.md for a full walkthrough.
+
+service: fizzy
+
+# The image is built on your machine and pushed to a local registry that Kamal
+# starts and tunnels to the server, so no external registry account is needed.
+# To use Docker Hub, GHCR, or another registry instead, set `registry.server`,
+# `registry.username`, and `registry.password` below, and update `image`.
+image: fizzy
+
+servers:
+  web:
+    - 192.168.0.1 # Replace with your server's IP address
+
+# Terminate SSL in kamal-proxy and fetch a Let's Encrypt certificate for the
+# hostname automatically.
+proxy:
+  ssl: true
+  host: fizzy.example.com # Replace with your hostname
+
+registry:
+  server: localhost:5555
+  # For an external registry, comment out the line above and use e.g.:
+  #
+  # server: ghcr.io
+  # username: your-github-username
+  # password:
+  #   - KAMAL_REGISTRY_PASSWORD
+
+env:
+  clear:
+    # The hostname users access Fizzy at. Must match `proxy.host` above.
+    APP_HOST: fizzy.example.com
+    APP_FQDN: fizzy.example.com # Alias used by existing Fizzy deployment configs
+
+    # Outgoing email. Replace with your mail server's details.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+
+    # Use SQLite and run Solid Queue background jobs inside the web process,
+    # since everything runs in one container on one box.
+    DATABASE_ADAPTER: sqlite
+    SOLID_QUEUE_IN_PUMA: true
+
+  secret:
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# Keep SQLite databases and Active Storage uploads on a Docker volume so they
+# survive deploys and container replacements.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between releases so in-flight requests don't 404.
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64 # Change to arm64 if your server is ARM (e.g. Graviton or Hetzner CAX)
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
