diff --git a/app/views/cards/reactions/_new.html.erb b/app/views/cards/reactions/_new.html.erb
new file mode 100644
index 0000000..4091237
--- /dev/null
+++ b/app/views/cards/reactions/_new.html.erb
@@ -0,0 +1,41 @@
+<% create_path = reactable.is_a?(Comment) ? card_comment_reactions_path(reactable.card, reactable) : card_reactions_path(reactable) %>
+
+<div class="reaction__menu" data-controller="reaction">
+  <button type="button" class="reactions__trigger btn" data-action="reaction#open" data-reaction-target="trigger"
+      title="Add a reaction" aria-label="Add a reaction" aria-expanded="false">
+    <%= image_tag "boost-color.svg", alt: "Add a reaction" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with url: create_path, scope: :reaction, class: "reaction__form",
+        data: { controller: "form", reaction_target: "form", action: "keydown.esc->reaction#close" },
+        html: { hidden: true } do |form| %>
+    <label class="reaction__form-label">
+      <%= form.text_field :content, class: "input reaction__input", placeholder: "Add a reaction…", maxlength: 16, required: true,
+            autocomplete: "off", aria: { label: "Add a reaction" }, data: { reaction_target: "input" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog">
+      <button type="button" class="reaction__menu-btn btn" data-action="dialog#toggle" aria-label="Choose an emoji">
+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= form.button type: :submit, name: "reaction[content]", value: emoji, class: "btn", title: label, formnovalidate: true, aria: { label: label } do %><%= emoji %><% end %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "reaction__submit-btn btn", title: "Confirm reaction", aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+    <%= button_tag type: :button, class: "reaction__cancel-btn btn", data: { action: "reaction#close" }, title: "Cancel", aria: { label: "Cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+</div>
