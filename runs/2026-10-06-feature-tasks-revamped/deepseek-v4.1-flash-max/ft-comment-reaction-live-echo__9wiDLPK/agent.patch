diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..c5f5312
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,49 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account || card&.account }
+  belongs_to :card, optional: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :boosts, -> { where comment_id: nil }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :reactable_present
+
+  before_validation :set_card_from_comment
+  after_create :register_card_activity
+  after_create_commit -> { broadcast_refresh_to card }
+  after_destroy_commit -> { broadcast_refresh_to card }
+
+  def card
+    super || comment&.card
+  end
+
+  def boost?
+    comment_id.nil?
+  end
+
+  def to_partial_path
+    "cards/reactions/reaction"
+  end
+
+  def reactable
+    comment || card
+  end
+
+  private
+    def set_card_from_comment
+      self.card ||= comment&.card
+    end
+
+    def reactable_present
+      unless comment || card
+        errors.add(:comment, :blank)
+        errors.add(:base, "must be added to a comment or card")
+      end
+    end
+
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
