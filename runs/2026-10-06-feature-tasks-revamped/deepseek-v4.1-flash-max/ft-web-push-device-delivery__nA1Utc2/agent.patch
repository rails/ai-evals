+# The data a push notification carries. It behaves like a Hash with :title,
+# :body and :url keys, and can also stand in for its JSON representation when
+# passed to JSON.parse or WebPush.
+class Push::Payload < Hash
+  def initialize(notification)
+    super()
+    @notification = notification
+
+    if notification.source && notification.card
+      replace(title: title_data, body: body_data, url: url_data)
+    end
+  end
+
+  def title
+    self[:title]
+  end
+
+  def body
+    self[:body]
+  end
+
+  def url
+    self[:url]
+  end
+
+  def [](key)
+    if key?(key)
+      super
+    elsif key.is_a?(String) && key?(key.to_sym)
+      super(key.to_sym)
+    end
+  end
+
+  def fetch(key, *args, &block)
+    if key?(key)
+      super
+    elsif key.is_a?(String) && key?(key.to_sym)
+      super(key.to_sym, *args, &block)
+    else
+      super
+    end
+  end
+
+  def to_str
+    to_json
+  end
+
+  def to_s
+    to_json
+  end
+
+  private
+    attr_reader :notification
+
+    def title_data
+      data["title"]
+    end
+
+    def body_data
+      data["body"]
+    end
+
+    def url_data
+      data.dig("card", "url")
+    end
+
+    def data
+      @data ||= JSON.parse(renderer.render(partial: "notifications/notification", formats: :json, locals: { notification: notification }))
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: notification.account.slug, https: !Rails.env.local?)
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..d521582
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,41 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  scope :for, ->(user) { where(user: user) }
+  scope :ordered, -> { order(created_at: :asc) }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  class << self
+    def enabled?
+      Push.enabled?
+    end
+
+    def register(user:, endpoint:, p256dh_key:, auth_key:, user_agent: nil)
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(user: user, account: user.account, p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+      end
+    end
+  end
+
+  def deliver(notification)
+    payload = notification.respond_to?(:push_payload) ? notification.push_payload : notification
+    return if payload.nil? || (payload.respond_to?(:empty?) && payload.empty?)
+
+    WebPush.payload_send(
+      message: payload.is_a?(String) ? payload : payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid.merge(subject: Push.vapid_subject)
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+  alias_method :push, :deliver
+  alias_method :notify, :deliver
+end
