new file mode 100644
index 0000000..69891d0
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,45 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+  before_action :set_subscription, only: :destroy
+
+  def create
+    @subscription = Push::Subscription.register(user: @user, user_agent: request.user_agent, **push_subscription_params)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications enabled for this device" }
+      format.json { render json: { id: @subscription.id }, status: :created }
+    end
+  end
+
+  def destroy
+    @subscription.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications disabled for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def set_subscription
+      @subscription = @user.push_subscriptions.find(params[:id])
+    end
+
+    def push_subscription_params
+      attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).to_h.symbolize_keys
+
+      missing = [ :endpoint, :p256dh_key, :auth_key ] - attributes.select { |_, value| value.present? }.keys
+      raise ActionController::ParameterMissing, missing.to_sentence if missing.any?
+
+      attributes
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..d17a140
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,116 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "toggle", "help" ]
+  static values = { subscribeUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      await this.#sync()
+    } else {
+      this.#showHelp()
+    }
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#enable()
+    } else {
+      await this.#disable()
+    }
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #sync() {
+    const subscription = await this.#getSubscription()
+    this.#render(subscription && Notification.permission === "granted")
+
+    if (Notification.permission === "denied") {
+      this.#showHelp()
+    }
+  }
+
+  async #enable() {
+    let subscription
+
+    try {
+      if (!this.vapidPublicKeyValue) throw new Error("Missing VAPID public key")
+
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") throw new Error("Notification permission was not granted")
+
+      const registration = await navigator.serviceWorker.ready
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey()
+      })
+
+      const response = await post(this.subscribeUrlValue, {
+        body: { push_subscription: this.#subscriptionParams(subscription) },
+        responseKind: "json"
+      })
+
+      if (!response.ok) throw new Error("Could not register the push subscription")
+
+      this.subscriptionId = (await response.json).id
+      this.#render(true)
+    } catch {
+      if (subscription) await subscription.unsubscribe()
+      this.#fail()
+    }
+  }
+
+  async #disable() {
+    const subscription = await this.#getSubscription()
+    if (subscription) await subscription.unsubscribe()
+
+    if (this.subscriptionId) {
+      await destroy(`${this.subscribeUrlValue}/${this.subscriptionId}`)
+      this.subscriptionId = null
+    }
+
+    this.#render(false)
+    if (Notification.permission === "denied") this.#showHelp()
+  }
+
+  #fail() {
+    this.toggleTarget.checked = false
+    this.#showHelp()
+  }
+
+  #showHelp() {
+    this.helpTarget.hidden = false
+  }
+
+  #render(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.toggleTarget.checked = enabled
+    if (enabled) this.helpTarget.hidden = true
+  }
+
+  async #getSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return await registration.pushManager.getSubscription()
+  }
+
+  #applicationServerKey() {
+    const padding = "=".repeat((4 - (this.vapidPublicKeyValue.length % 4)) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(window.atob(base64), char => char.charCodeAt(0))
+  }
+
+  #subscriptionParams(subscription) {
+    const keys = subscription.toJSON().keys
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: keys.p256dh,
+      auth_key: keys.auth
+    }
+  }
+}
