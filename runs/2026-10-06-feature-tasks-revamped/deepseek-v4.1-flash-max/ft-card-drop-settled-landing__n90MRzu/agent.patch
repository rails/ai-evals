diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..71036f1
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,169 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const CARD_SELECTOR = ".card"
+const COLUMN_SELECTOR = ".cards"
+const GOLDEN_FIRST_KINDS = [ "column", "maybe" ]
+
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+  }
+
+  dragStart(event) {
+    const card = this.#cardFor(event)
+    if (!card) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.dragOver(event)
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (column !== this.#sourceColumn) {
+      this.#hoverColumn(column)
+    }
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event)
+    if (column === this.hoveredColumn && !column.contains(event.relatedTarget)) {
+      this.#unhoverColumn()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFor(event)
+    if (!column) return
+
+    event.preventDefault()
+    this.#moveCard(this.#currentCard, column)
+    this.#reset()
+  }
+
+  dragEnd() {
+    this.#reset()
+  }
+
+  // Private
+
+  #moveCard(card, column) {
+    if (column === this.#sourceColumn) return
+
+    const list = column.querySelector(".cards__list")
+    if (!list) return
+
+    this.#insertCard(card, list, column)
+    this.#persistMove(card, column)
+  }
+
+  #insertCard(card, list, column) {
+    const cards = Array.from(list.querySelectorAll(CARD_SELECTOR))
+    const container = cards[0]?.parentElement || list
+
+    if (this.#goldenFirstColumn(column)) {
+      const goldenCards = cards.filter(card => card.classList.contains("golden-effect"))
+      if (!card.classList.contains("golden-effect") && goldenCards.length > 0) {
+        goldenCards.at(-1).after(card)
+        return
+      }
+    }
+
+    container.prepend(card)
+  }
+
+  async #persistMove(card, column) {
+    const options = { responseKind: "json", keepalive: true }
+
+    try {
+      switch (this.#kindFor(column)) {
+        case "maybe":
+          await destroy(card.dataset.cardTriageUrl, options)
+          break
+        case "not-now":
+          await post(card.dataset.cardNotNowUrl, options)
+          break
+        case "closed":
+          await post(card.dataset.cardClosureUrl, options)
+          break
+        default:
+          await post(card.dataset.cardTriageUrl, {
+            ...options,
+            body: { column_id: this.#columnIdFor(column) }
+          })
+      }
+    } catch (error) {
+      console.error("Failed to move card", error)
+    }
+  }
+
+  #hoverColumn(column) {
+    if (this.hoveredColumn === column) return
+
+    this.#unhoverColumn()
+    this.hoveredColumn = column
+    column.classList.add(HOVER_CLASS)
+  }
+
+  #unhoverColumn() {
+    this.hoveredColumn?.classList.remove(HOVER_CLASS)
+    this.hoveredColumn = null
+  }
+
+  #reset() {
+    this.#currentCard?.classList.remove(DRAGGED_CLASS)
+    this.#unhoverColumn()
+    this.draggedCard = null
+  }
+
+  #kindFor(column) {
+    return column.dataset.dragAndDropKind || "column"
+  }
+
+  #goldenFirstColumn(column) {
+    return GOLDEN_FIRST_KINDS.includes(this.#kindFor(column))
+  }
+
+  #columnIdFor(column) {
+    return column.dataset.dragAndDropColumnId
+  }
+
+  #cardFor(event) {
+    return event.target instanceof Element ? event.target.closest(CARD_SELECTOR) : null
+  }
+
+  #columnFor(event) {
+    return event.target instanceof Element ? event.target.closest(COLUMN_SELECTOR) : null
+  }
+
+  get #currentCard() {
+    if (!this.draggedCard) return null
+
+    return document.getElementById(this.draggedCard.id) || this.draggedCard
+  }
+
+  get #sourceColumn() {
+    return this.#currentCard?.closest(COLUMN_SELECTOR) || null
+  }
+}
