diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..a0e3073
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,128 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "dragging a card between regular columns moves it" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:text)
+    target = columns(:writebook_triage)
+
+    drag card, find("##{dom_id(target)}")
+
+    assert_in_column card, target
+    assert_equal target, card.reload.column
+  end
+
+  test "dragging a card into maybe sends it back to triage" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:logo)
+    drag card, find("#maybe")
+
+    assert_in_column card, "maybe"
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging a card into not now postpones it" do
+    card = cards(:shipping)
+    card.reopen(user: users(:david))
+    card.reload
+    visit board_url(boards(:writebook))
+
+    drag card, find("#not-now")
+
+    assert_in_column card, "not-now"
+    assert card.reload.postponed?
+  end
+
+  test "dragging a card into done closes it" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:layout)
+    drag card, find("#closed-cards")
+
+    assert_in_column card, "closed-cards"
+    assert card.reload.closed?
+  end
+
+  test "dragging a closed card back to a column reopens and triages it" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:shipping)
+    target = columns(:writebook_in_progress)
+
+    assert card.closed?
+    drag card, find("##{dom_id(target)}")
+
+    assert_in_column card, target
+    assert card.reload.triaged?
+  end
+
+  test "keeps the card in place when the save refreshes the board" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:text)
+    target = columns(:writebook_triage)
+
+    drag card, find("##{dom_id(target)}")
+    assert_equal target, card.reload.column
+
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_in_column card, target
+  end
+
+  test "dragging a card within the same column does not reorder it" do
+    visit board_url(boards(:writebook))
+
+    card = cards(:text)
+    column = card.column
+    expand_column column
+
+    before = card_ids_in(column)
+    drag card, find("##{dom_id(column)}")
+    after = card_ids_in(column)
+
+    assert_equal before, after
+    assert_equal column, card.reload.column
+  end
+
+  private
+    def drag(card, target)
+      expand_card_column(card)
+      find("##{dom_id(card, :article)}").drag_to(target)
+    end
+
+    def expand_card_column(card)
+      if card.closed?
+        expand_column "closed-cards"
+      elsif card.postponed?
+        expand_column "not-now"
+      else
+        expand_column(card.column || "maybe")
+      end
+    end
+
+    def expand_column(column)
+      id = column.is_a?(String) ? column : dom_id(column)
+      button = find("button[aria-controls='#{id}']", visible: :all)
+      button.click if button["aria-expanded"] == "false"
+    end
+
+    def card_ids_in(column)
+      id = column.is_a?(String) ? column : dom_id(column)
+      page.evaluate_script("Array.from(document.querySelectorAll('##{id} .card')).map(card => card.id)")
+    end
+
+    def assert_in_column(card, column)
+      id = column.is_a?(String) ? column : dom_id(column)
+      assert_selector "##{id} ##{dom_id(card, :article)}", visible: :all
+    end
+end
