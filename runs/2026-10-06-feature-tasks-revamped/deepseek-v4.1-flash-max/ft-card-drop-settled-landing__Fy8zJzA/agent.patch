diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..7c1abe2
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,286 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const OPEN_CARD_ACTION = "mouseenter->navigable-list#hoverSelect"
+const DEFAULT_CARD_COLOR = "var(--color-card-default)"
+
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+    this.sourceContainer = null
+    this.hoveredContainer = null
+  }
+
+  dragStart(event) {
+    const card = this.#cardFor(event.target)
+    const container = card?.closest(".cards")
+
+    if (!card || !container || !this.element.contains(container)) return
+
+    this.draggedCard = card
+    this.sourceContainer = container
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      try {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", card.id)
+      } catch (_) {
+        // Synthetic drag events may not provide a full DataTransfer.
+      }
+
+      this.#setDragImage(event, card)
+    }
+  }
+
+  dragOver(event) {
+    const container = this.#containerFor(event.target)
+
+    if (!container || container === this.sourceContainer) {
+      this.#unhover()
+      return
+    }
+
+    event.preventDefault()
+    try {
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    } catch (_) {
+      // Synthetic drag events may not provide a full DataTransfer.
+    }
+
+    this.#hover(container)
+  }
+
+  dragLeave(event) {
+    if (!this.element.contains(event.relatedTarget)) this.#unhover()
+  }
+
+  drop(event) {
+    const container = this.#containerFor(event.target)
+    const card = this.draggedCard
+
+    if (!container || !card || container === this.sourceContainer) {
+      this.#cleanup()
+      return
+    }
+
+    event.preventDefault()
+
+    // Move the card immediately, then persist in the background. The save goes
+    // through Turbo.fetch, so the refresh it broadcasts carries our request id and
+    // is ignored here: the board stays exactly as the user left it.
+    this.#move(card, container)
+    this.#save(card, container)
+
+    this.#cleanup()
+  }
+
+  dragEnd() {
+    this.#cleanup()
+  }
+
+  // Private
+
+  #cardFor(node) {
+    const card = node?.closest?.(".card")
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #containerFor(node) {
+    const container = node?.closest?.(".cards")
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #move(card, container) {
+    const list = this.#cardListFor(container)
+    const goldenCards = list.querySelectorAll(":scope > .card.golden-effect")
+    const reference = card.classList.contains("golden-effect") || goldenCards.length === 0
+      ? list.firstElementChild
+      : goldenCards[goldenCards.length - 1].nextElementSibling
+
+    list.insertBefore(card, reference)
+    this.#applyState(card, container)
+    this.#adjustCount(this.sourceContainer, -1)
+    this.#adjustCount(container, 1)
+    this.#restorePlaceholder(this.sourceContainer)
+  }
+
+  #cardListFor(container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return container.querySelector("turbo-frame") || container
+
+    const existingCard = list.querySelector(".card")
+    if (existingCard) return existingCard.parentElement
+
+    return list.querySelector('[data-controller~="pagination"] turbo-frame') || list
+  }
+
+  #applyState(card, container) {
+    const kind = this.#kindFor(container)
+    const closed = kind === "closed"
+    const postponed = kind === "not-now"
+
+    card.classList.toggle("card--active", !closed && !postponed)
+    card.classList.toggle("card--postponed", postponed)
+
+    if (!closed && !postponed) this.#removeStamps(card)
+    this.#updateColor(card, container)
+
+    if (closed) {
+      this.#removeOpenCardData(card)
+    } else {
+      this.#ensureOpenCardData(card)
+    }
+  }
+
+  #save(card, container) {
+    const url = this.#cardUrl(card)
+    if (!url) return
+
+    const request = this.#requestFor(container, url)
+    if (request) request.catch(() => {}) // The UI is already updated, so there's nothing to do.
+  }
+
+  #requestFor(container, url) {
+    switch (this.#kindFor(container)) {
+      case "maybe":
+        return destroy(`${url}/triage`, { responseKind: "json" })
+      case "not-now":
+        return post(`${url}/not_now`, { responseKind: "json" })
+      case "closed":
+        return post(`${url}/closure`, { responseKind: "json" })
+      default:
+        return post(`${url}/triage`, { responseKind: "json", body: { column_id: this.#columnIdFor(container) } })
+    }
+  }
+
+  #kindFor(container) {
+    if (container.id === "maybe") return "maybe"
+    if (container.id === "not-now") return "not-now"
+    if (container.id === "closed-cards") return "closed"
+    return "column"
+  }
+
+  #columnIdFor(container) {
+    return container.dataset.columnId || container.id.replace(/^column_/, "")
+  }
+
+  #ensureOpenCardData(card) {
+    const url = this.#cardUrl(card)
+    if (!url) return
+
+    card.dataset.cardNotNowUrl ||= `${url}/not_now`
+    card.dataset.cardClosureUrl ||= `${url}/closure`
+    card.dataset.cardAssignToSelfUrl ||= `${url}/self_assignment`
+    this.#addAction(card, OPEN_CARD_ACTION)
+  }
+
+  #updateColor(card, container) {
+    switch (this.#kindFor(container)) {
+      case "closed":
+        return // Closing keeps the card's column, so its color doesn't change.
+      case "column":
+        card.style.setProperty("--card-color", container.style.getPropertyValue("--card-color") || DEFAULT_CARD_COLOR)
+        return
+      default:
+        card.style.setProperty("--card-color", DEFAULT_CARD_COLOR)
+    }
+  }
+
+  #removeStamps(card) {
+    card.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+  }
+
+  #removeOpenCardData(card) {
+    delete card.dataset.cardNotNowUrl
+    delete card.dataset.cardClosureUrl
+    delete card.dataset.cardAssignToSelfUrl
+    this.#removeAction(card, OPEN_CARD_ACTION)
+  }
+
+  #restorePlaceholder(container) {
+    const list = container?.querySelector(".cards__list")
+    if (!list || list.querySelector(".card") || list.querySelector(".blank-slate")) return
+
+    list.prepend(this.#placeholder())
+  }
+
+  #placeholder() {
+    const fragment = document.createDocumentFragment()
+
+    const defaultSlate = document.createElement("div")
+    defaultSlate.className = "blank-slate blank-slate--default"
+    defaultSlate.textContent = "No cards here"
+
+    const dragSlate = document.createElement("div")
+    dragSlate.className = "blank-slate blank-slate--drag overflow-ellipsis"
+    dragSlate.textContent = "Drag cards here"
+
+    fragment.append(defaultSlate, dragSlate)
+    return fragment
+  }
+
+  #cardUrl(card) {
+    return card.querySelector(".card__link")?.href?.split("?")[0]?.split("#")[0] || null
+  }
+
+  #hover(container) {
+    if (this.hoveredContainer === container) return
+    this.#unhover()
+    this.hoveredContainer = container
+    container.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #unhover() {
+    this.hoveredContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredContainer = null
+  }
+
+  #cleanup() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#unhover()
+    this.draggedCard = null
+    this.sourceContainer = null
+  }
+
+  #adjustCount(container, delta) {
+    const count = container?.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const current = parseInt(count.textContent, 10) || 0
+    const next = Math.max(0, current + delta)
+    count.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #setDragImage(event, card) {
+    try {
+      const rect = card.getBoundingClientRect()
+      event.dataTransfer.setDragImage(card, event.clientX - rect.left, event.clientY - rect.top)
+    } catch (_) {
+      // Some browsers don't support custom drag images.
+    }
+  }
+
+  #addAction(card, action) {
+    const actions = new Set(this.#actionsFor(card))
+    if (actions.has(action)) return
+
+    actions.add(action)
+    card.dataset.action = Array.from(actions).join(" ")
+  }
+
+  #removeAction(card, action) {
+    const actions = this.#actionsFor(card).filter(candidate => candidate !== action)
+    if (actions.length > 0) {
+      card.dataset.action = actions.join(" ")
+    } else {
+      delete card.dataset.action
+    }
+  }
+
+  #actionsFor(card) {
+    return (card.dataset.action || "").split(/\s+/).filter(Boolean)
+  }
+}
