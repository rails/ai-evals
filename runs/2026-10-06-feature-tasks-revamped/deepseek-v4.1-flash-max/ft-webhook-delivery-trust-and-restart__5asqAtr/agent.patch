diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..3d150fb
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,73 @@
+class Webhook::Payload
+  attr_reader :delivery, :webhook, :event
+
+  def initialize(webhook_or_delivery, event = nil)
+    if event
+      @webhook, @event = webhook_or_delivery, event
+    else
+      @delivery = webhook_or_delivery
+      @webhook, @event = @delivery.webhook, @delivery.event
+    end
+  end
+
+  def to_json(*args)
+    if special?
+      payload.to_json(*args)
+    else
+      event_json
+    end
+  end
+
+  def to_s
+    to_json
+  end
+
+  def body
+    to_s
+  end
+  alias_method :to_str, :to_s
+
+  def to_h
+    @to_h ||= special? ? payload : JSON.parse(event_json)
+  end
+  alias_method :as_json, :to_h
+
+  def payload
+    if webhook.for_slack?
+      { text: message_text }
+    elsif webhook.for_campfire?
+      { message: { body: message_html } }
+    elsif webhook.for_basecamp?
+      { content: message_html }
+    else
+      JSON.parse(event_json)
+    end
+  end
+
+  def message_text
+    [ event.description_for(Current.user).to_plain_text, event_url ].compact.join(" ")
+  end
+
+  def message_html
+    renderer.render(template: "webhooks/event", assigns: { event: event }, formats: [ :html ], layout: false)
+  end
+
+  private
+    def special?
+      webhook.for_slack? || webhook.for_campfire? || webhook.for_basecamp?
+    end
+
+    def event_json
+      renderer.render(template: "webhooks/event", assigns: { event: event }, formats: [ :json ])
+    end
+
+    def event_url
+      if event.eventable
+        renderer.render(inline: "<%= polymorphic_url(@event.eventable) %>", assigns: { event: event })
+      end
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: webhook.board.account.slug)
+    end
+end
