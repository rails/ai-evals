@@ -29,4 +98,41 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim!
+      self.class.where(id: id, state: "pending").update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
+
+    def post
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = payload
+
+      response = http.request(request)
+      { code: response.code.to_i, headers: response.to_hash }
+    end
+
+    def error_code(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        :timeout
+      when SocketError, Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ECONNRESET, Errno::EPIPE
+        :destination_unreachable
+      when OpenSSL::SSL::SSLError
+        :ssl_error
+      else
+        error.class.name.demodulize.underscore.to_sym
+      end
+    end
 end
