diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..d7f70bb
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,48 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  MAX_FAILURES = FAILURE_THRESHOLD
+  MAX_CONSECUTIVE_FAILURES = FAILURE_THRESHOLD
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track_failure
+    if within_failure_window?
+      increment!(:consecutive_failures_count)
+    else
+      update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+    end
+
+    deactivate_webhook if delinquent?
+  end
+  alias_method :record_failure, :track_failure
+  alias_method :failure, :track_failure
+
+  def track_success
+    reset
+  end
+  alias_method :record_success, :track_success
+  alias_method :success, :track_success
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def track(delivery)
+    delivery.succeeded? ? track_success : track_failure
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD
+  end
+
+  private
+    def within_failure_window?
+      first_failure_at.present? && first_failure_at >= FAILURE_WINDOW.ago
+    end
+
+    def deactivate_webhook
+      webhook.deactivate
+    end
+end
