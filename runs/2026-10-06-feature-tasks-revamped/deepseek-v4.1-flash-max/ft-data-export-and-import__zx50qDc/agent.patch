+      <%= link_to "Download #{@export.filename}", account_export_path(@export, token: @export.download_token), class: "btn center" %>
+    <% else %>
+      <p class="margin-none">This export has expired. Please request a new one.</p>
+    <% end %>
+  <% elsif @export.failed? %>
+    <h2 class="txt-large margin-none font-weight-black">The export couldn't be completed</h2>
+    <p class="margin-none"><%= @export.error.presence || "Please try again." %></p>
+    <%= link_to "Try again", new_account_export_path, class: "btn center" %>
+  <% else %>
+    <h2 class="txt-large margin-none font-weight-black">Your export is being prepared</h2>
+    <p class="margin-none">We'll email you a download link when it's ready. The link works for 1 day.</p>
+  <% end %>
+</article>
diff --git a/app/views/account/imports/new.html.erb b/app/views/account/imports/new.html.erb
new file mode 100644
index 0000000..440d705
--- /dev/null
+++ b/app/views/account/imports/new.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "settings", account_settings_path, "keydown.left@document->hotkey@click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<article class="panel panel--wide center shadow txt-align-start">
+  <%= form_with model: @import, url: account_imports_path, method: :post, data: { controller: "form" }, html: { class: "flex flex-column gap", multipart: true } do |form| %>
+    <header>
+      <h2 class="txt-large margin-none font-weight-black">Upload an account file</h2>
+      <p class="txt-medium margin-none">The file must be a .zip exported from Fizzy. We'll create a new account with everything in it, and email you when it's done.</p>
+    </header>
+
+    <label class="flex flex-column gap-half">
+      <strong>Account file</strong>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small">
+        <% @import.errors.full_messages.each do |message| %>
+          <p class="margin-block-none"><%= message %></p>
+        <% end %>
+      </div>
+    <% end %>
+
+    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
+      <span>Import account</span>
+    <% end %>
+
+    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
+      <span>Import</span>
+    <% end %>
+
+    <%= link_to "Cancel and go back", account_settings_path, data: { form_target: "cancel" }, hidden: true %>
+  <% end %>
+</article>
