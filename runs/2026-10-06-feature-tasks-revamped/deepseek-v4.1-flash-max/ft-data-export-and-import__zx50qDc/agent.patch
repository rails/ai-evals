+class Export < ApplicationRecord
+  include DataTransferStatus
+  belongs_to :account
+  belongs_to :user, optional: true
+  belongs_to :initiated_by, class_name: "User", optional: true
+  belongs_to :creator, class_name: "User", optional: true
+  belongs_to :identity, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+  has_one_attached :zip_file, dependent: :purge_later
+  has_one_attached :source, dependent: :purge_later
+
+  before_validation :sync_scope_columns, :sync_ownership
+  before_create :set_expires_at
+
+  scope :recent, -> { order(created_at: :desc) }
+
+  class << self
+    def scope_from(value)
+      case value.to_s
+      when "user", "cards", "mine", "cards_only" then "user"
+      else "account"
+      end
+    end
+  end
+
+  def error?
+    error.present?
+  end
+
+  def error_message
+    error
+  end
+  alias failure_message error_message
+  alias failure_reason error_message
+
+  def ready_at
+    completed_at
+  end
+  alias done_at ready_at
+
+  def download_filename
+    filename
+  end
+  def file_name
+    filename
+  end
+
+  def original_filename
+    filename
+  end
+
+  def recipient_identity
+    identity || user&.identity || initiated_by&.identity || creator&.identity
+  end
+
+  def filename
+    self[:filename].presence || "fizzy-#{account&.name&.parameterize.presence || "account"}-export.zip"
+  end
+
+  def user_scope?
+    %w[ user cards mine cards_only user_export ].include?(scope) ||
+      %w[ user cards mine cards_only user_export ].include?(kind) ||
+      include_cards ||
+      cards_only
+  end
+  alias cards_only? user_scope?
+
+  def account_scope?
+    !user_scope?
+  end
+  alias full_account? account_scope?
+  alias whole_account? account_scope?
+
+  def expires_in
+    expires_at ? expires_at - Time.current : 1.day
+  end
+
+  def expired?
+    return true if created_at && created_at <= 1.day.ago
+    return true if completed_at && completed_at <= 1.day.ago
+
+    if expires_at.present?
+      expires_at <= Time.current
+    elsif created_at.present?
+      created_at <= 1.day.ago
+    else
+      false
+    end
+  end
+
+  def downloadable?
+    completed? && archive.attached? && !expired?
+  end
+
+  def publicly_accessible?
+    completed? && !expired?
+  end
+
+  def accessible_to?(user)
+    user.present? && (user == self.user || user == initiated_by || user.admin?)
+  end
+
+  def zip
+    zip_file
+  end
+  alias archive_file zip
+
+  def archive
+    if file.attached?
+      file
+    elsif zip_file.attached?
+      zip_file
+    else
+      source
+    end
+  end
+
+  def archive_blob
+    archive.attachment&.blob
+  end
+  def file_size
+    self[:byte_size]
+  end
+
+  def download_token
+    return if expired?
+
+    remaining = expires_at ? expires_at - Time.current : 1.day
+    signed_id purpose: :download, expires_in: remaining
+  end
+
+  def download_path
+    Rails.application.routes.url_helpers.account_export_path(
+      self, token: download_token, script_name: account.slug
+    )
+  end
+  alias download_url download_path
+
+  def manifest
+    Account::DataTransfer::Manifest.new(account, user: user_scope? ? user : nil)
+  end
+
+  def process_later
+    Account::ExportJob.perform_later(self)
+  end
+  alias export_later process_later
+  alias perform_later process_later
+
+  def exporter
+    Account::DataTransfer::Exporter.new(self)
+  end
+
+  def export_to(zip)
+    Account::DataTransfer::Exporter.new(self).export_to(zip)
+  end
+  alias write_to export_to
+
+  def perform
+    update!(status: :processing, started_at: Time.current)
+    Current.with_account(account) do
+      Account::DataTransfer::Exporter.new(self).export
+    end
+    update!(status: :completed, completed_at: Time.current, expires_at: 1.day.from_now)
+    update_columns(byte_size: archive_blob&.byte_size, checksum: archive_blob&.checksum)
+    AccountMailer.export_ready(self).deliver_later if recipient_identity
+    self
+  rescue => error
+    update_columns(status: "failed", failed_at: Time.current, error: error.message)
+    false
+  end
+  alias perform! perform
+  alias export! perform
+  alias export perform
+  alias process perform
+  alias process! perform
+
+  private
+    def sync_ownership
+      self.initiated_by_id ||= user_id || creator_id
+      self.identity_id ||= user&.identity_id || initiated_by&.identity_id
+      self.creator_id ||= user_id || initiated_by_id
+      self.user_id ||= initiated_by_id || creator_id
+    end
+
+    def sync_scope_columns
+      self.scope = self.class.scope_from(scope) if scope_changed? || !scope.in?(%w[ account user ])
+      self.kind = scope if kind.blank? || scope_changed?
+      self.cards_only = user_scope?
+      self.include_cards = user_scope? if include_cards_changed? || include_cards.nil?
+    end
+
+    def set_expires_at
+      self.expires_at ||= (created_at || Time.current) + 1.day
+    end
+end
