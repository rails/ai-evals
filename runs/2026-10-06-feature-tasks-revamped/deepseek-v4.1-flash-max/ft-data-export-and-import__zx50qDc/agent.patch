@@ -0,0 +1,112 @@
+class Account::DataTransfer::Importer
+  attr_reader :account
+
+  def initialize(import = nil, **options)
+    @import = options[:import] || import
+  end
+
+  def import
+    with_archive do |zip|
+      import_from(zip)
+    end
+  end
+  alias perform import
+  alias call import
+
+  def import_from(zip)
+    account_attributes = read_account_attributes(zip)
+    id_map = {}
+    blob_keys = {}
+    blob_metadata = Hash.new { |hash, key| hash[key] = [] }
+
+    begin
+      Account.transaction do
+        @account = Account.create!(
+          name: account_attributes["name"].presence || "Imported account",
+          cards_count: account_attributes["cards_count"].to_i
+        )
+        id_map[account_attributes["id"].to_s] = @account.id
+
+        manifest = Account::DataTransfer::Manifest.new(@account)
+        manifest.each_record_set do |record_set|
+          next if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+
+          record_set.import_from(zip, id_map: id_map, blob_keys: blob_keys, blob_metadata: blob_metadata)
+        end
+
+        ensure_importer_has_access!
+        @account.update_columns(cards_count: @account.cards.count)
+        reindex!
+      end
+    rescue => error
+      delete_uploaded_files(blob_keys)
+      raise error
+    end
+
+    @account
+  end
+  alias from_zip import_from
+
+  private
+    def with_archive
+      attachment = @import.archive
+      raise "No file was attached to this import" unless attachment&.attached?
+
+      ZipFile.read_for(attachment) do |zip|
+        yield zip
+      end
+    end
+
+    def read_account_attributes(zip)
+      path = zip.glob("accounts/*.json").first ||
+        zip.glob("account*.json").first ||
+        zip.glob("**/account*.json").first
+      raise "The uploaded file doesn't contain account data" unless path
+
+      JSON.parse(zip.read(path))
+    end
+
+    def ensure_importer_has_access!
+      identity = @import.respond_to?(:recipient_identity) ? @import.recipient_identity : nil
+      return unless identity
+
+      user = account.users.find_by(identity: identity)
+
+      if user
+        if account.users.active.where(role: :owner).none?
+          user.update_columns(role: "owner", active: true, verified_at: user.verified_at || Time.current)
+        end
+      else
+        account.users.insert_all([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          identity_id: identity.id,
+          name: identity.email_address.split("@").first,
+          role: "owner",
+          active: true,
+          verified_at: Time.current,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+      end
+    end
+
+    def reindex!
+      account.cards.find_each { |card| safely_reindex(card) }
+      Comment.where(account_id: account.id).find_each { |comment| safely_reindex(comment) }
+    end
+
+    def safely_reindex(record)
+      record.reindex
+    rescue StandardError => error
+      Rails.logger.warn "Couldn't reindex #{record.class.name} #{record.id} after import: #{error.message}"
+    end
+
+    def delete_uploaded_files(blob_keys)
+      blob_keys.each_value do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue StandardError
+        # Best effort cleanup of any files written before the import failed.
+      end
+    end
+end
