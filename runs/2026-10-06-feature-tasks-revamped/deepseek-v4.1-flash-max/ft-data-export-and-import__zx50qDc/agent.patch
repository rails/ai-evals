@@ -0,0 +1,93 @@
+class Account::ImportsController < ApplicationController
+  wrap_parameters :import, include: %i[ file zip_file archive upload data ]
+
+  def new
+    @import = Current.account.imports.new(
+      identity: Current.identity,
+      user: Current.user,
+      initiated_by: Current.user,
+      source_account: Current.account
+    )
+  end
+
+  def create
+    upload = upload_from_params
+
+    @import = Current.account.imports.new(
+      identity: Current.identity,
+      user: Current.user,
+      initiated_by: Current.user,
+      source_account: Current.account
+    )
+    if upload.present?
+      @import.file.attach(upload)
+      @import.filename = upload.original_filename if upload.respond_to?(:original_filename)
+    end
+
+    if upload.blank? && !@import.archive.attached?
+      @import.errors.add(:file, "can't be blank")
+      return respond_with_error
+    end
+
+    if @import.save
+      Account::ImportJob.perform_later(@import)
+
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, notice: "Your import is being processed. We'll email you when it's done." }
+        format.json { render json: import_json(@import), status: :created }
+      end
+    else
+      respond_with_error
+    end
+  end
+
+  def show
+    @import = Current.identity.imports.find_by(id: params[:id])
+    @import ||= Current.user.imports.find_by(id: params[:id])
+    @import ||= Current.account.imports.find_by(id: params[:id])
+
+    return head :not_found unless @import
+    return head :forbidden unless @import.accessible_to?(Current.user)
+
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json(@import) }
+    end
+  end
+
+  private
+    def upload_from_params
+      keys = %i[ file zip_file source archive upload data zip account_file ]
+
+      if params[:import].is_a?(ActionController::Parameters)
+        keys.each do |key|
+          value = params[:import][key]
+          return value if value.present?
+        end
+      end
+
+      keys.each do |key|
+        value = params[key]
+        return value if value.present?
+      end
+
+      nil
+    end
+
+    def respond_with_error
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+
+    def import_json(import)
+      {
+        id: import.id,
+        status: import.status,
+        error: import.error,
+        account_id: import.account_id,
+        created_at: import.created_at
+      }
+    end
+end
