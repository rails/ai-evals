+  end
+
+  STATUS_GROUPS = {
+    pending: %w[ pending created new queued ],
+    processing: %w[ processing in_progress started ],
+    completed: %w[ completed complete ready done success succeeded ],
+    failed: %w[ failed error errored failure ]
+  }.freeze
+
+  class_methods do
+    STATUS_GROUPS.each do |name, values|
+      define_method(name) { where(status: values) }
+    end
+
+    alias created pending
+    alias queued pending
+    alias in_progress processing
+    alias started processing
+    alias ready completed
+    alias done completed
+    alias complete completed
+    alias success completed
+    alias succeeded completed
+    alias errored failed
+    alias failure failed
+
+    def finished
+      where(status: STATUS_GROUPS[:completed] + STATUS_GROUPS[:failed])
+    end
+
+    def statuses
+      { pending: "pending", processing: "processing", completed: "completed", failed: "failed" }
+    end
+  end
+
+  STATUS_GROUPS.each do |name, values|
+    define_method("#{name}?") { normalized_status.in?(values) }
+    define_method("#{name}!") { update!(status: name.to_s) }
+  end
+
+  def created?
+    pending?
+  end
+
+  def created!
+    pending!
+  end
+
+  def ready?
+    completed?
+  end
+
+  def ready!
+    completed!
+  end
+
+  def done?
+    completed?
+  end
+
+  def done!
+    completed!
+  end
+
+  def complete?
+    completed?
+  end
+
+  def complete!
+    completed!
+  end
+
+  def succeeded?
+    completed?
+  end
+
+  def success?
+    completed?
+  end
+
+  def errored?
+    failed?
+  end
+
+  def fail!
+    failed!
+  end
+  alias error! fail!
+
+  def succeed!
+    completed!
+  end
+  alias success! succeed!
+
+  def in_progress?
+    processing?
+  end
+
+  def finished?
+    completed? || failed?
+  end
+
+  def state
+    status
+  end
+
+  def state=(value)
+    self.status = value
+  end
+
+  def normalized_status
+    normalize_status_value(status)
+  end
+
+  def normalize_status
+    self[:status] = normalized_status if status.present?
+  end
+
+  private
+    def normalize_status_value(value)
+      STATUS_ALIASES.fetch(value.to_s, value.to_s)
+    end
+end
