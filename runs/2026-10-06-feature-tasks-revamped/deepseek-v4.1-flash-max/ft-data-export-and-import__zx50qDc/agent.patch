     end
 
+    def normalize_import_attributes(attrs, old_id:, new_id:)
+      attrs = super
+      body = attrs["body"].to_s
+      attrs["body"] = rewrite_body(body) if body.include?("<action-text-attachment")
+      attrs
+    end
+
+    def rewrite_body(body)
+      fragment = Nokogiri::HTML.fragment(body)
+
+      fragment.css("action-text-attachment").each do |node|
+        if blob = new_blob_for(node)
+          node["sgid"] = blob.attachable_sgid
+          node["url"] = Rails.application.routes.url_helpers.rails_blob_path(
+            blob, only_path: true, script_name: account.slug
+          )
+          node["content-type"] = blob.content_type if blob.content_type.present?
+          node["filename"] = blob.filename.to_s if blob.filename.present?
+          node["filesize"] = blob.byte_size.to_s if blob.byte_size.present?
+          node["width"] = blob.metadata["width"].to_s if blob.metadata["width"].present?
+          node["height"] = blob.metadata["height"].to_s if blob.metadata["height"].present?
+        end
+      end
+
+      fragment.to_html
+    end
+
+    def new_blob_for(node)
+      old_blob_id = old_blob_id_for(node)
+      new_blob_id = id_map[old_blob_id.to_s] if old_blob_id && id_map
+      new_blob_id ||= blob_id_from_metadata(node)
+
+      ::ActiveStorage::Blob.find_by(id: new_blob_id) if new_blob_id
+    end
+
+    def old_blob_id_for(node)
+      if (sgid = node["sgid"].presence)
+        begin
+          attachable = ActionText::Attachable.from_attachable_sgid(sgid)
+          return attachable.id if attachable.is_a?(::ActiveStorage::Blob)
+        rescue StandardError
+          # The signed id came from another instance; fall back to metadata matching below.
+        end
+      end
+
+      if (url = node["url"].presence)
+        if (signed_id = url[%r{/rails/active_storage/(?:blobs)/(?:redirect|proxy)/([^/?#]+)}, 1])
+          begin
+            blob = ::ActiveStorage::Blob.find_signed(signed_id)
+            return blob.id if blob
+          rescue StandardError
+          end
+        end
+      end
+
+      nil
+    end
+
+    def blob_id_from_metadata(node)
+      return unless blob_metadata
+
+      ids = blob_metadata[node["filename"].presence]
+      return if ids.blank?
+
+      if ids.one?
+        ids.first
+      else
+        content_type = node["content-type"].presence
+        filesize = node["filesize"].presence&.to_i
+
+        matches = ids.select do |id|
+          blob = ::ActiveStorage::Blob.find_by(id: id)
+          next false unless blob
+
+          (content_type.nil? || blob.content_type == content_type) &&
+            (filesize.nil? || filesize.zero? || blob.byte_size == filesize)
+        end
+
+        matches.one? ? matches.first : nil
+      end
+    end
 end
