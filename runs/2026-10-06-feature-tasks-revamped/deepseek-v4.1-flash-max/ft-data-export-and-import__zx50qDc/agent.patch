+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,117 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  wrap_parameters :export, include: %i[ scope kind cards_only ]
+
+  def new
+    @export = Current.account.exports.new(
+      user: Current.user,
+      initiated_by: Current.user,
+      scope: requested_scope.presence || (Current.user.admin? ? "account" : "user")
+    )
+  end
+
+  def create
+    requested = requested_scope
+    scope = if requested.present?
+      Export.scope_from(requested)
+    elsif Current.user.admin?
+      "account"
+    else
+      "user"
+    end
+
+    return head :forbidden if scope == "account" && !Current.user.admin?
+
+    @export = Current.account.exports.create!(user: Current.user, initiated_by: Current.user, scope: scope)
+
+    Account::ExportJob.perform_later(@export)
+
+    respond_to do |format|
+      format.html { redirect_after_create }
+      format.json { render json: export_json(@export), status: :created }
+    end
+  end
+
+  def show
+    @export = find_export
+    return head :not_found unless @export
+
+    if params[:token].present?
+      return head :not_found unless @export.downloadable?
+
+      redirect_to_download
+    else
+      return head :not_found unless @export.accessible_to?(Current.user)
+      return head :not_found if @export.expired?
+
+      respond_to do |format|
+        format.html
+        format.json { render json: export_json(@export) }
+      end
+    end
+  end
+
+  def download
+    @export = Current.account.exports.find_by(id: params[:id])
+    return head :not_found unless @export&.accessible_to?(Current.user)
+    return head :not_found unless @export.downloadable?
+
+    redirect_to_download
+  end
+
+  private
+    def redirect_after_create
+      notice = "Your export is being prepared. We'll email you when it's ready."
+
+      if @export.user_scope?
+        redirect_to user_path(Current.user), notice: notice
+      else
+        redirect_to account_settings_path, notice: notice
+      end
+    end
+
+    def redirect_to_download
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port,
+        script_name: request.script_name
+      }
+
+      redirect_to @export.archive_blob.url(
+        expires_in: 1.day,
+        disposition: :attachment,
+        filename: @export.filename
+      )
+    end
+
+    def requested_scope
+      explicit = params.dig(:export, :scope).presence || params[:scope].presence || params.dig(:export, :kind).presence || params.dig(:export, :type).presence
+      return explicit if explicit.present?
+
+      requested = params.dig(:export, :cards_only) || params.dig(:export, :cards) || params.dig(:export, :include_cards) || params[:cards]
+      "user" if ActiveModel::Type::Boolean.new.cast(requested)
+    end
+
+    def find_export
+      if params[:token].present?
+        export = Export.find_signed(params[:token], purpose: :download)
+        return nil unless export
+        return nil if Current.account && export.account_id != Current.account.id
+
+        export
+      else
+        Current.account.exports.find_by(id: params[:id])
+      end
+    end
+
+    def export_json(export)
+      {
+        id: export.id,
+        status: export.status,
+        scope: export.scope,
+        created_at: export.created_at
+      }
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
