+class Account::DataTransfer::Exporter
+  attr_reader :account, :user
+
+  def initialize(export = nil, user_or_account = nil, account: nil, user: nil, **options)
+    @export = options[:export] || export
+
+    if user_or_account.is_a?(::User)
+      user ||= user_or_account
+    elsif user_or_account.is_a?(::Account)
+      account ||= user_or_account
+    end
+
+    @account = @export&.account || account
+    @user = @export&.user || user
+  end
+
+  def export
+    if export_record?
+      ZipFile.create_for(target_attachment, filename: filename) do |zip|
+        export_to(zip)
+      end
+      mirror_zip_attachment
+      @export
+    else
+      raise ArgumentError, "An export record with an attached file is required"
+    end
+  end
+  alias perform export
+  alias call export
+
+  def export_to(zip)
+    manifest.each_record_set do |record_set|
+      record_set.export_to(zip)
+    end
+  end
+
+  def manifest
+    @manifest ||= if @export.respond_to?(:user_scope?) && @export.user_scope?
+      Account::DataTransfer::Manifest.new(account, user: user)
+    else
+      Account::DataTransfer::Manifest.new(account)
+    end
+  end
+
+  private
+    def export_record?
+      @export.present?
+    end
+
+    def filename
+      @export.filename
+    end
+
+    def target_attachment
+      if @export.file.attached? || !(@export.zip_file.attached? || @export.source.attached?)
+        @export.file
+      elsif @export.zip_file.attached?
+        @export.zip_file
+      else
+        @export.source
+      end
+    end
+
+    def mirror_zip_attachment
+      if @export.file.attached? && !@export.zip_file.attached?
+        @export.zip_file.attach(@export.file.blob)
+      end
+    end
+end
