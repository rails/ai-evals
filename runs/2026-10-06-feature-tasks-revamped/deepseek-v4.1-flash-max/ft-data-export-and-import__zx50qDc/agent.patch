+<% @page_title = "Export" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<article class="panel panel--wide center shadow txt-align-start">
+  <%= form_with model: @export, url: account_exports_path, method: :post, scope: :export, data: { controller: "form" }, html: { class: "flex flex-column gap" } do |form| %>
+    <header>
+      <h2 class="txt-large margin-none font-weight-black">What would you like to export?</h2>
+      <p class="txt-medium margin-none">We'll email you a download link when it's ready. The link works for 1 day.</p>
+    </header>
+
+    <% if Current.user.admin? %>
+      <label class="flex align-center gap-half">
+        <%= form.radio_button :scope, "account" %>
+        <span>Everything in the account</span>
+      </label>
+    <% end %>
+
+    <label class="flex align-center gap-half">
+      <%= form.radio_button :scope, "user" %>
+      <span>The cards I can see</span>
+    </label>
+
+    <% if @export.errors.any? %>
+      <div class="txt-negative txt-small">
+        <% @export.errors.full_messages.each do |message| %>
+          <p class="margin-block-none"><%= message %></p>
+        <% end %>
+      </div>
+    <% end %>
+
+    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
+      <span>Prepare export</span>
+    <% end %>
+
+    <%= form.button type: :submit, class: "btn btn--link center txt-medium" do %>
+      <span>Export</span>
+    <% end %>
+
+    <%= link_to "Cancel and go back", account_settings_path, data: { form_target: "cancel" }, hidden: true %>
+  <% end %>
+</article>
