+class ZipFile::Reader
+  class EntryReader
+    attr_reader :extractor, :uncompressed_size
+
+    def initialize(extractor, uncompressed_size)
+      @extractor = extractor
+      @uncompressed_size = uncompressed_size.to_i
+    end
+
+    def extract(n_bytes = nil)
+      extractor.extract(n_bytes)
+    end
+
+    def read(n_bytes = nil)
+      return read_all if n_bytes.nil?
+      return "" if n_bytes.zero?
+
+      fill_buffer(n_bytes)
+      @read_buffer.slice!(0, n_bytes)
+    end
+
+    def read_all
+      fill_buffer(Float::INFINITY)
+      @read_buffer.slice!(0, @read_buffer.bytesize)
+    end
+
+    private
+      def fill_buffer(target_size)
+        @read_buffer ||= +""
+        while @read_buffer.bytesize < target_size && !extractor.eof?
+          chunk = extractor.extract(1.megabyte)
+          break if chunk.nil? && extractor.eof?
+          @read_buffer << chunk if chunk
+        end
+      end
+
+    public
+
+    def eof?
+      extractor.eof?
+    end
+
+    def size
+      uncompressed_size
+    end
+
+    def rewind
+      raise IOError, "Cannot rewind a streaming ZIP entry"
+    end
+
+    def binmode
+      self
+    end
+  end
+
+  class << self
+    def open(source)
+      io = source.is_a?(String) ? File.open(source, "rb") : source
+      reader = new(io)
+
+      if block_given?
+        begin
+          yield reader
+        ensure
+          io.close if source.is_a?(String) && io.respond_to?(:close)
+        end
+      else
+        reader
+      end
+    end
+  end
+
+  attr_reader :io
+
+  def initialize(source)
+    @opened_from_path = source.is_a?(String)
+    @io = @opened_from_path ? File.open(source, "rb") : source
+    @entries = nil
+    @entry_map = nil
+  end
+
+  def size
+    io.size
+  end
+  alias byte_size size
+
+  def entries
+    @entries ||= ZipKit::FileReader.read_zip_structure(io: io).map(&:filename)
+  end
+  alias files entries
+  alias paths entries
+
+  def entry(path)
+    @entry_map ||= ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+    @entry_map[path]
+  end
+
+  def exists?(path)
+    entries.include?(path)
+  end
+  alias include? exists?
+  alias has_entry? exists?
+
+  def glob(pattern)
+    entries.select { |entry| File.fnmatch(pattern, entry) }.sort
+  end
+
+  def read(path)
+    if block_given?
+      extract(path) do |extractor|
+        until extractor.eof?
+          chunk = extractor.extract(1.megabyte)
+          break if chunk.nil? && extractor.eof?
+          yield chunk if chunk
+        end
+      end
+    else
+      extract(path) { |extractor| read_all(extractor) }
+    end
+  end
+
+  alias read_entry read
+
+  def open(path)
+    extract(path) do |extractor|
+      entry_reader = EntryReader.new(extractor, entry(path)&.uncompressed_size)
+      if block_given?
+        yield entry_reader
+      else
+        entry_reader
+      end
+    end
+  end
+
+  alias get_entry entry
+  alias find_entry entry
+
+  def extract(path)
+    zip_entry = entry(path)
+    raise Errno::ENOENT, path unless zip_entry
+
+    extractor = zip_entry.extractor_from(io)
+    if block_given?
+      yield extractor
+    else
+      extractor
+    end
+  end
+
+  def each_entry
+    return enum_for(:each_entry) unless block_given?
+
+    entries.each do |path|
+      yield path, read(path)
+    end
+  end
+  alias each each_entry
+  alias each_file each_entry
+
+  def close
+    if @opened_from_path
+      io.close if io.respond_to?(:close) && !io.closed?
+    end
+  end
+  alias finish close
+
+  private
+    def read_all(extractor)
+      buffer = +""
+      until extractor.eof?
+        chunk = extractor.extract(1.megabyte)
+        break if chunk.nil? && extractor.eof?
+        buffer << chunk if chunk
+      end
+      buffer
+    end
+end
