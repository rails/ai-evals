+          chunk = extractor.extract(1.megabyte)
+          tempfile.write(chunk) if chunk
+        end
+      end
+
+      tempfile.rewind
+      blob.service.upload(
+        blob.key,
+        tempfile,
+        checksum: blob.checksum,
+        content_type: blob.content_type,
+        filename: blob.filename,
+        disposition: blob.metadata["disposition"]
+      )
+    ensure
+      tempfile&.close!
+    end
 end
