diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..0ff1c7f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,70 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+  end
+
+  def incinerate
+    transaction do
+      destroy!
+      delete_remaining_records
+    end
+  end
+
+  private
+    def delete_remaining_records
+      delete_search_records
+      purge_active_storage
+      delete_account_scoped_records
+    end
+
+    def delete_search_records
+      if sqlite?
+        Search::Record.where(account_id: id).destroy_all
+      else
+        Search::Record::Trilogy::SHARD_CLASSES.each do |shard|
+          shard.where(account_id: id).delete_all
+        end
+      end
+    end
+
+    def purge_active_storage
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:purge)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+    end
+
+    def delete_account_scoped_records
+      connection.tables.each do |table|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{quoted_account_id}")
+        end
+      end
+    end
+
+    def quoted_account_id
+      @quoted_account_id ||= connection.quote(self.class.type_for_attribute(:id).serialize(id))
+    end
+
+    def connection
+      self.class.connection
+    end
+
+    def sqlite?
+      connection.adapter_name == "SQLite"
+    end
 end
