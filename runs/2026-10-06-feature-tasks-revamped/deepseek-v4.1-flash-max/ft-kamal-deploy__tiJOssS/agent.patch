diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..30ffd54
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,101 @@
+# Fizzy is deployed with Kamal. This configuration runs everything in a single
+# container on one server: the Rails app (including background jobs via Solid
+# Queue), the SQLite databases, and uploaded files. Kamal's proxy provides SSL.
+#
+# Before deploying, update these values:
+#
+#   1. Replace every occurrence of fizzy.example.com with your hostname. It is
+#      used to reach the server over SSH and to serve the app, so point its
+#      DNS record at the server before running setup. (If you need to connect
+#      via a different address, replace only servers.web with the server IP.)
+#   2. env.clear SMTP_* values and MAILER_FROM_ADDRESS: replace them with the
+#      details for the mail server that should send Fizzy emails.
+#   3. .kamal/secrets: fill in the app secrets.
+#
+# Then run `bin/kamal setup`.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. Kamal pushes this to the local registry below,
+# so it doesn't need to exist anywhere yet.
+image: fizzy
+
+# Keep the last couple of deployments around so a rollback is quick without
+# letting old images fill up the server's disk.
+retain_containers: 2
+
+# The server to deploy to. This is the hostname set above, so make sure it
+# resolves to your server. You can replace it with an IP address if needed.
+servers:
+  web:
+    - fizzy.example.com
+
+# By default Kamal connects as root. Uncomment and set your SSH user if your
+# server requires a different one (it must be able to run Docker):
+# ssh:
+#   user: app
+
+# Enable automatic HTTPS via Let's Encrypt. The hostname must resolve to the
+# server above, and ports 80 and 443 must be open.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Kamal builds the image on this machine and pushes it to a local registry,
+# which is tunneled to the server over SSH during deploy. This avoids needing
+# an external registry account. To use Docker Hub or GHCR instead, set `image`
+# to <user>/fizzy and configure the registry section as described at
+# https://kamal-deploy.org/docs/configuration/registry/.
+registry:
+  server: localhost:5555
+
+# Environment for the app container.
+env:
+  clear:
+    # Keep everything in one process tree: Puma runs the Solid Queue
+    # supervisor so background jobs are processed in the same container.
+    SOLID_QUEUE_IN_PUMA: true
+    DATABASE_ADAPTER: sqlite
+
+    # Public hostname used in emails and links. Must match proxy.host above.
+    # Both names are accepted by the app; keep them in sync.
+    APP_HOST: fizzy.example.com
+    APP_FQDN: fizzy.example.com
+
+    # SMTP settings for outbound email. Use the details provided by your mail
+    # server. SMTP_PASSWORD comes from .kamal/secrets.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS: true
+    # For implicit TLS (usually on port 465), set SMTP_ENABLE_STARTTLS: false
+    # and uncomment the next line:
+    # SMTP_SSL: true
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Persist the SQLite databases (application, cache, queue, cable) and uploaded
+# files across deploys. The volume survives container restarts and redeploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between the old and new container during deploys
+# to avoid 404s for in-flight requests.
+asset_path: /rails/public/assets
+
+# Build for the server architecture. Change to arm64 for an ARM server.
+builder:
+  arch: amd64
+
+# Aliases run against the deployed container: `bin/kamal console`, etc.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
