diff --git a/app/views/mailers/notification_mailer/bundle.html.erb b/app/views/mailers/notification_mailer/bundle.html.erb
new file mode 100644
index 0000000..f45e444
--- /dev/null
+++ b/app/views/mailers/notification_mailer/bundle.html.erb
@@ -0,0 +1,48 @@
+<p class="subtitle">
+  New notifications in <%= @account.name %>.
+</p>
+
+<p>Hi <%= @user.name %>,</p>
+
+<p>
+  You have <%= pluralize(@notifications.size, "new notification") %>.
+</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <div class="notification">
+    <h2 class="notification__board">
+      <%= link_to board.name, board_url(board, script_name: @account.slug) %>
+    </h2>
+
+    <% notifications.each do |notification| %>
+      <table width="100%" cellpadding="0" cellspacing="0">
+        <tr>
+          <td class="avatar__container">
+            <%= mail_avatar_tag notification.creator, size: 48 %>
+          </td>
+          <td>
+            <p class="notification__author">
+              <%= notification.creator.familiar_name %> &middot; <%= notification_time(notification) %>
+            </p>
+            <p class="notification__details">
+              <%= link_to notification_title(notification), notification.payload.url %>
+            </p>
+            <p class="notification__details">
+              <% if notification.source_type == "Mention" %>
+                <mark class="notificaton__mention"><%= notification_body(notification) %></mark>
+              <% else %>
+                <%= notification_body(notification) %>
+              <% end %>
+            </p>
+          </td>
+        </tr>
+      </table>
+    <% end %>
+  </div>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  <%= link_to "View all notifications", notifications_url(script_name: @account.slug) %>.
+</p>
diff --git a/app/views/mailers/notification_mailer/bundle.text.erb b/app/views/mailers/notification_mailer/bundle.text.erb
new file mode 100644
index 0000000..1e07978
--- /dev/null
+++ b/app/views/mailers/notification_mailer/bundle.text.erb
@@ -0,0 +1,18 @@
+New notifications in <%= @account.name %>.
+
+Hi <%= @user.name %>,
+
+You have <%= pluralize(@notifications.size, "new notification") %>.
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+<%= board.name %>
+<%= "=" * board.name.length %>
+
+<% notifications.each do |notification| %>
+* <%= notification_title(notification) %> — <%= notification_time(notification) %>
+  <%= notification_body(notification) %>
+  <%= notification.payload.url %>
+
+<% end %>
+<% end %>
+View all notifications: <%= notifications_url(script_name: @account.slug) %>
diff --git a/app/views/notifications/settings/_email_frequency.html.erb b/app/views/notifications/settings/_email_frequency.html.erb
new file mode 100644
index 0000000..c398411
--- /dev/null
+++ b/app/views/notifications/settings/_email_frequency.html.erb
@@ -0,0 +1,30 @@
+<section class="settings__section">
+  <header>
+    <h2 class="divider">Email notifications</h2>
+    <div>Choose how often Fizzy emails you a digest of your notifications. Email digests are off by default.</div>
+  </header>
+
+  <%= form_with model: settings, url: notifications_settings_path, method: :patch, scope: :settings, data: { controller: "form" } do |form| %>
+    <div class="flex flex-column gap-half margin-block-start-half">
+      <% User::Settings.bundle_email_frequencies.each_key do |frequency| %>
+        <label class="flex align-center gap-half">
+          <%= form.radio_button :bundle_email_frequency, frequency %>
+          <span>
+            <% case frequency %>
+            <% when "never" %>
+              Off <span class="txt-small txt-tinted">(don’t send email)</span>
+            <% when "every_few_hours" %>
+              Every few hours <span class="txt-small txt-tinted">(every four hours)</span>
+            <% else %>
+              <%= frequency.humanize %>
+            <% end %>
+          </span>
+        </label>
+      <% end %>
+    </div>
+
+    <div class="margin-block-start-half">
+      <%= form.submit "Save", class: "btn" %>
+    </div>
+  <% end %>
+</section>
