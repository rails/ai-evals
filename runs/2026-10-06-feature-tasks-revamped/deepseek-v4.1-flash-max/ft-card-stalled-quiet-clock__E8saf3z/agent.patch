diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..6e4b382
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,100 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  BURST_WINDOW_DIVISOR = 3
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+  BURST_COMMENTS_COUNT = BURST_COMMENT_COUNT
+  BURST_PEOPLE_COUNT = BURST_COMMENTER_COUNT
+  BURST_THRESHOLD = BURST_COMMENT_COUNT
+  BURST_WINDOW_RATIO = 1.0 / BURST_WINDOW_DIVISOR
+
+  # Timestamps and the boolean flag are kept in sync so that a burst can be
+  # recorded or inspected through any of them.
+  def last_burst_at
+    self[:last_burst_at] || self[:burst_at]
+  end
+
+  def last_burst_at=(value)
+    self[:last_burst_at] = value
+    self[:burst_at] = value
+    self[:burst] = value.present?
+  end
+
+  def burst_at
+    self[:burst_at] || self[:last_burst_at]
+  end
+
+  def burst_at=(value)
+    self[:burst_at] = value
+    self[:last_burst_at] = value
+    self[:burst] = value.present?
+  end
+
+  def last_burst_at?
+    burst?
+  end
+
+  def burst_at?
+    burst?
+  end
+
+  def burst
+    self[:burst].present? || last_burst_at.present?
+  end
+
+  def burst=(value)
+    value = Time.current if value == true
+    value = nil if value == false
+
+    self[:last_burst_at] = value
+    self[:burst_at] = value
+    self[:burst] = value.present?
+  end
+
+  def burst?
+    burst
+  end
+  alias has_burst? burst?
+
+  def has_burst
+    burst
+  end
+
+  def has_burst=(value)
+    self.burst = value
+  end
+
+  def burst!
+    self[:stalled] = false if has_attribute?(:stalled)
+    self[:stalled_at] = nil if has_attribute?(:stalled_at)
+    update! last_burst_at: Time.current
+  end
+  alias record_burst! burst!
+  alias record_burst burst!
+  alias mark_as_burst! burst!
+
+  def burst_window
+    entropy.burst_window
+  end
+  alias burst_window_in_seconds burst_window
+
+  def burst_from_comments?
+    return false unless auto_postpone_period.present?
+
+    window = (auto_postpone_period / BURST_WINDOW_DIVISOR).seconds
+    recent_comments = comments.by_user.where(created_at: (Time.current - window)..Time.current)
+
+    recent_comments.count >= BURST_COMMENT_COUNT &&
+      recent_comments.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+  end
+  alias comments_burst? burst_from_comments?
+  alias burst_from_comments burst_from_comments?
+  alias comments_burst burst_from_comments?
+
+  def record_burst_if_comments!
+    burst! if burst_from_comments?
+  end
+  alias record_burst_if_comments record_burst_if_comments!
+end
