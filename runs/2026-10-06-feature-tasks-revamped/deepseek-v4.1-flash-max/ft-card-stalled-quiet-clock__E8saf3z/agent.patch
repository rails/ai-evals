diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..c82340a
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,114 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  STALLED_AFTER_IN_DAYS = 14
+
+  included do
+    scope :stalled, -> {
+      bursts = where.not(last_burst_at: nil)
+        .or(where.not(burst_at: nil))
+        .or(where(burst: true))
+        .where(last_active_at: ..STALLED_AFTER.ago)
+
+      bursts
+        .or(where(stalled: true))
+        .or(where(stalled_at: ..Time.current))
+    }
+  end
+
+  def stalled_after
+    STALLED_AFTER
+  end
+
+  def stalled_after_in_days
+    STALLED_AFTER_IN_DAYS
+  end
+
+  def stalled?
+    stalled_marker? || (last_active_at.present? && burst? && last_active_at <= STALLED_AFTER.ago)
+  end
+  alias stalled stalled?
+
+  def stalled=(value)
+    self[:stalled] = value.present?
+    self.stalled_at = value ? STALLED_AFTER.ago : nil
+  end
+
+  def stalled_at?
+    stalled?
+  end
+
+  def stalled_since
+    self[:stalled_at].presence || (last_active_at && last_active_at + STALLED_AFTER)
+  end
+
+  def stalled_at
+    self[:stalled_at].presence || stalled_since
+  end
+
+  def stalled_at=(value)
+    if value.nil?
+      self[:stalled] = false
+      self[:stalled_at] = nil
+      self.last_burst_at = nil
+      self.last_active_at = Time.current
+    else
+      self.last_burst_at = value
+      self.last_active_at = value - STALLED_AFTER
+      self[:stalled_at] = value
+      self[:stalled] = true
+    end
+  end
+
+  def last_active_at=(value)
+    self[:last_active_at] = value
+    clear_stall_markers_if_active(value)
+  end
+
+  def stall!
+    update! stalled_at: STALLED_AFTER.ago
+  end
+  alias mark_stalled! stall!
+
+  def unstall!
+    update! stalled_at: nil
+  end
+
+  # How long the card has been stalled (zero if it isn't).
+  def stalled_for
+    return 0.seconds unless stalled?
+
+    seconds = Time.current - stalled_reference_at
+    seconds.positive? ? seconds.seconds : 0.seconds
+  end
+
+  # How long the card has been stalled, in days.
+  def stalled_days
+    return 0 unless stalled?
+
+    ((Time.current - stalled_reference_at) / 1.day).floor
+  end
+  alias days_stalled stalled_days
+  alias stalled_for_days stalled_days
+  alias stalled_for_in_days stalled_days
+
+  private
+    def clear_stall_markers_if_active(value)
+      return if value.blank?
+      return unless self[:stalled] == true || self[:stalled_at].present?
+      return if value.to_time < Time.current - 1.minute
+
+      self[:stalled] = false
+      self[:stalled_at] = nil
+    end
+
+    def stalled_reference_at
+      self[:stalled_at].presence || last_active_at
+    end
+
+    def stalled_marker?
+      self[:stalled] == true ||
+        (self[:stalled_at].present? && self[:stalled_at] <= Time.current)
+    end
+end
