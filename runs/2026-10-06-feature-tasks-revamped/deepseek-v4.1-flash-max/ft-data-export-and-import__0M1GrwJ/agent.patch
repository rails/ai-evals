diff --git a/test/controllers/exports_imports_controller_test.rb b/test/controllers/exports_imports_controller_test.rb
new file mode 100644
index 0000000..3da5c6f
--- /dev/null
+++ b/test/controllers/exports_imports_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class ExportsImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admin can create an account export" do
+    sign_in_as :jason
+
+    assert_difference -> { Export.count }, +1 do
+      assert_enqueued_jobs 1, only: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.scope
+    assert Export.last.account_export?
+  end
+
+  test "member cannot create an account export" do
+    sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "any user can create a personal export" do
+    sign_in_as :david
+
+    assert_difference -> { Export.count }, +1 do
+      assert_enqueued_jobs 1, only: ExportJob do
+        post my_exports_path
+      end
+    end
+
+    assert_redirected_to user_path(users(:david))
+    assert Export.last.user_export?
+  end
+
+  test "new import page" do
+    sign_in_as :david
+
+    get new_account_import_path
+    assert_response :success
+    assert_select "form"
+  end
+
+  test "create import enqueues job" do
+    sign_in_as :david
+
+    file = uploaded_zip
+
+    assert_difference -> { Import.count }, +1 do
+      assert_enqueued_jobs 1, only: ImportJob do
+        post account_imports_path, params: { import: { file: file } }
+      end
+    end
+
+    assert_redirected_to account_import_path(Import.last)
+    assert_equal identities(:david), Import.last.identity
+  end
+
+  private
+    def uploaded_zip
+      file = Tempfile.new([ "export", ".zip" ])
+      file.binmode
+      writer = ZipFile::Writer.new(file)
+      writer.add_file("accounts/whatever.json", { name: "Test" }.to_json)
+      writer.close
+      file.rewind
+      Rack::Test::UploadedFile.new(file, "application/zip", false, original_filename: "export.zip")
+    end
+end
