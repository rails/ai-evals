@@ -0,0 +1,27 @@
+class ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  def create
+    scope = params[:scope].presence || (Current.user.admin? ? "account" : "user")
+    @export = Export.create_for(account: Current.account, user: Current.user, scope: scope, include_all: scope == "account")
+    @export.export_later
+
+    redirect_to root_path, notice: "Export started. We'll email you when it's ready."
+  end
+
+  def show
+    @export = find_export
+    head :not_found and return unless @export&.file&.attached?
+
+    redirect_to @export.download_url, allow_other_host: true
+  end
+
+  private
+    def find_export
+      if params[:token].present?
+        Export.find_by_download_token(params[:token]) || Export.find_by(id: params[:id])
+      else
+        Export.find_by(id: params[:id])
+      end
+    end
+end
