+    def regenerate_unique_attributes(row)
+      case model.name
+      when "Board::Publication"
+        row["key"] = SecureRandom.base58(24)
+      end
+    end
+
+    def choose_record_id(old_id)
+      return generate_unique_id if old_id.blank?
+      return id_map[old_id] if id_map.assigned?(old_id)
+
+      if model.exists?(id: old_id)
+        generate_unique_id
+      else
+        old_id
+      end
+    end
+
+    def generate_unique_id
+      loop do
+        id = ActiveRecord::Type::Uuid.generate
+        next if model.exists?(id: id)
+        next if id_map.assigned_values.include?(id)
+
+        return id
+      end
+    end
+
+    def id_from_path(path)
+      return if path.blank?
+
+      File.basename(path.to_s).delete_suffix(".json").split("/").last
+    end
+
+    def apply_scope(relation)
+      case scope
+      when nil
+        relation
+      when Array
+        scope.empty? ? relation.none : relation.where(id: scope)
+      when Hash
+        relation.where(**scope)
+      else
+        scope.respond_to?(:call) ? scope.call(relation) : relation
+      end
+    end
+
+    def stringify(hash)
+      hash.to_h.stringify_keys
+    end
+
+    def normalize_writer(destination)
+      case destination
+      when ZipFile::Writer
+        [ destination, false ]
+      when String
+        [ ZipFile::Writer.new(File.open(destination, "wb")), true ]
+      else
+        if destination.respond_to?(:add_file)
+          [ destination, false ]
+        elsif destination.respond_to?(:write_file)
+          [ ZipFile::StreamerAdapter.new(destination), false ]
+        elsif destination.respond_to?(:write)
+          [ ZipFile::Writer.new(destination), true ]
+        else
+          raise ArgumentError, "Unsupported archive destination: #{destination.class.name}"
+        end
+      end
+    end
+
+def normalize_reader(source)
+  case source
+  when ZipFile::Reader
+    [ source, false ]
+  else
+    if source.respond_to?(:glob) && source.respond_to?(:read)
+      [ source, false ]
+    else
+      [ ZipFile::Reader.new(source), true ]
+    end
+  end
+end
 end
