@@ -0,0 +1,40 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: %i[ new create ]
+  before_action :set_export, only: :show
+
+  def new
+    @export = Current.account.exports.new
+  end
+
+  def create
+    @export = Export.create_for(account: Current.account, user: Current.user, scope: "account", include_all: true)
+    @export.export_later
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Export started. We'll email you when it's ready." }
+      format.json { render json: export_json(@export), status: :created }
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.html do
+        if @export.completed? && @export.file.attached?
+          redirect_to @export.download_url
+        else
+          render :show
+        end
+      end
+      format.json { render json: export_json(@export) }
+    end
+  end
+
+  private
+    def set_export
+      @export = Current.account.exports.find(params[:id])
+    end
+
+    def export_json(export)
+      { id: export.id, status: export.status, filename: export.filename, created_at: export.created_at }
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
