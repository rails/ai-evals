+class Account::DataTransfer::UserScope
+  attr_reader :account, :user
+
+  def initialize(account, user)
+    @account = account
+    @user = user
+  end
+
+  def ids_for(model_name)
+    case model_name
+    when "User", "User::Settings" then user_ids
+    when "Tag" then tag_ids
+    when "Board" then board_ids
+    when "Column" then column_ids
+    when "Entropy" then entropy_ids
+    when "Board::Publication" then publication_ids
+    when "Webhook" then webhook_ids
+    when "Access" then access_ids
+    when "Card" then card_ids
+    when "Comment" then comment_ids
+    when "Step" then step_ids
+    when "Assignment" then assignment_ids
+    when "Tagging" then tagging_ids
+    when "Closure" then closure_ids
+    when "Card::Goldness" then goldness_ids
+    when "Card::NotNow" then not_now_ids
+    when "Card::ActivitySpike" then activity_spike_ids
+    when "Watch" then watch_ids
+    when "Pin" then pin_ids
+    when "Reaction" then reaction_ids
+    when "Mention" then mention_ids
+    when "Filter" then filter_ids
+    when "Webhook::DelinquencyTracker" then delinquency_tracker_ids
+    when "Event" then event_ids
+    when "Notification" then notification_ids
+    when "Notification::Bundle" then bundle_ids
+    when "Webhook::Delivery" then delivery_ids
+    when "ActiveStorage::Blob" then blob_ids
+    when "ActiveStorage::VariantRecord" then variant_record_ids
+    when "ActiveStorage::Attachment" then attachment_ids
+    when "ActionText::RichText" then rich_text_ids
+    end
+  end
+
+  private
+    def board_ids
+      @board_ids ||= user.boards.where(account_id: account.id).ids
+    end
+
+    def column_ids
+      @column_ids ||= Column.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def card_ids
+      @card_ids ||= Card.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def comment_ids
+      @comment_ids ||= Comment.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def step_ids
+      @step_ids ||= Step.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def assignment_ids
+      @assignment_ids ||= Assignment.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def tagging_ids
+      @tagging_ids ||= Tagging.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def tag_ids
+      @tag_ids ||= Tag.where(account_id: account.id, id: Tagging.where(account_id: account.id, card_id: card_ids).select(:tag_id)).ids
+    end
+
+    def closure_ids
+      @closure_ids ||= Closure.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def goldness_ids
+      @goldness_ids ||= Card::Goldness.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def not_now_ids
+      @not_now_ids ||= Card::NotNow.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def activity_spike_ids
+      @activity_spike_ids ||= Card::ActivitySpike.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def watch_ids
+      @watch_ids ||= Watch.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def pin_ids
+      @pin_ids ||= Pin.where(account_id: account.id, card_id: card_ids).ids
+    end
+
+    def reaction_ids
+      @reaction_ids ||= begin
+        scope = Reaction.where(account_id: account.id)
+        (scope.where(reactable_type: "Card", reactable_id: card_ids).ids +
+          scope.where(reactable_type: "Comment", reactable_id: comment_ids).ids).uniq
+      end
+    end
+
+    def mention_ids
+      @mention_ids ||= begin
+        scope = Mention.where(account_id: account.id)
+        (scope.where(source_type: "Card", source_id: card_ids).ids +
+          scope.where(source_type: "Comment", source_id: comment_ids).ids).uniq
+      end
+    end
+
+    def filter_ids
+      @filter_ids ||= Filter.where(account_id: account.id, creator_id: user.id).ids
+    end
+
+    def publication_ids
+      @publication_ids ||= Board::Publication.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def webhook_ids
+      @webhook_ids ||= Webhook.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def delinquency_tracker_ids
+      @delinquency_tracker_ids ||= Webhook::DelinquencyTracker.where(account_id: account.id, webhook_id: webhook_ids).ids
+    end
+
+    def delivery_ids
+      @delivery_ids ||= Webhook::Delivery.where(account_id: account.id, webhook_id: webhook_ids).ids
+    end
+
+    def event_ids
+      @event_ids ||= Event.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def notification_ids
+      @notification_ids ||= Notification.where(account_id: account.id, user_id: user.id).ids
+    end
+
+    def bundle_ids
+      @bundle_ids ||= Notification::Bundle.where(account_id: account.id, user_id: user.id).ids
+    end
+
+    def access_ids
+      @access_ids ||= Access.where(account_id: account.id, board_id: board_ids).ids
+    end
+
+    def entropy_ids
+      @entropy_ids ||= begin
+        scope = Entropy.where(account_id: account.id)
+        (scope.where(container_type: "Account", container_id: account.id).ids +
+          scope.where(container_type: "Board", container_id: board_ids).ids).uniq
+      end
+    end
+
+    def rich_text_ids
+      @rich_text_ids ||= begin
+        scope = ActionText::RichText.where(account_id: account.id)
+        (scope.where(record_type: "Card", record_id: card_ids).ids +
+          scope.where(record_type: "Comment", record_id: comment_ids).ids +
+          scope.where(record_type: "Board", record_id: board_ids).ids).uniq
+      end
+    end
+
+    def user_ids
+      @user_ids ||= begin
+        scope = User.where(account_id: account.id)
+        ids = [ user.id ]
+        ids.concat(Board.where(account_id: account.id, id: board_ids).pluck(:creator_id))
+        ids.concat(Card.where(account_id: account.id, id: card_ids).pluck(:creator_id))
+        ids.concat(Comment.where(account_id: account.id, id: comment_ids).pluck(:creator_id))
+        ids.concat(Assignment.where(account_id: account.id, card_id: card_ids).pluck(:assignee_id, :assigner_id).flatten)
+        ids.concat(Access.where(account_id: account.id, board_id: board_ids).pluck(:user_id))
+        ids.concat(Watch.where(account_id: account.id, card_id: card_ids).pluck(:user_id))
+        ids.concat(Pin.where(account_id: account.id, card_id: card_ids).pluck(:user_id))
+        ids.concat(Reaction.where(account_id: account.id, id: reaction_ids).pluck(:reacter_id))
+        ids.concat(Mention.where(account_id: account.id, id: mention_ids).pluck(:mentioner_id, :mentionee_id).flatten)
+        ids.concat(Event.where(account_id: account.id, id: event_ids).pluck(:creator_id))
+        ids.concat(Closure.where(account_id: account.id, id: closure_ids).pluck(:user_id))
+        ids.concat(Card::NotNow.where(account_id: account.id, id: not_now_ids).pluck(:user_id))
+        ids.compact!
+        scope.where(id: ids).ids
+      end
+    end
+
+    def attachment_ids
+      @attachment_ids ||= begin
+        scope = ActiveStorage::Attachment.where(account_id: account.id)
+        ids = []
+        ids.concat(scope.where(record_type: "Card", record_id: card_ids).ids)
+        ids.concat(scope.where(record_type: "Comment", record_id: comment_ids).ids)
+        ids.concat(scope.where(record_type: "Board", record_id: board_ids).ids)
+        ids.concat(scope.where(record_type: "ActionText::RichText", record_id: rich_text_ids).ids)
+        ids.concat(scope.where(record_type: "User", record_id: user_ids).ids)
+        ids.concat(scope.where(record_type: "Identity", record_id: identity_ids).ids)
+        ids.uniq
+      end
+    end
+
+    def identity_ids
+      @identity_ids ||= User.where(account_id: account.id, id: user_ids).pluck(:identity_id).compact
+    end
+
+    def blob_ids
+      @blob_ids ||= ActiveStorage::Attachment.where(account_id: account.id, id: attachment_ids).pluck(:blob_id).uniq
+    end
+
+    def variant_record_ids
+      @variant_record_ids ||= ActiveStorage::VariantRecord.where(account_id: account.id, blob_id: blob_ids).ids
+    end
+end
