+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  ASSOCIATIONS = {
+    "tag_ids" => :tag_ids,
+    "board_ids" => :board_ids,
+    "assignee_ids" => :assignee_ids,
+    "creator_ids" => :creator_ids,
+    "closer_ids" => :closer_ids
+  }.freeze
+
+  def initialize(account, **options)
+    super(account: account, model: ::Filter, **options)
+  end
+
+  def export_record(record)
+    super.merge(
+      "tag_ids" => record.tag_ids,
+      "board_ids" => record.board_ids,
+      "assignee_ids" => record.assignee_ids,
+      "creator_ids" => record.creator_ids,
+      "closer_ids" => record.closer_ids
+    )
+  end
+
+  def import_record(data, path: nil)
+    attributes = data.to_h.stringify_keys
+    row = super
+
+    filter = ::Filter.find_by(id: row["id"])
+    if filter
+      ASSOCIATIONS.each do |key, setter|
+        ids = attributes[key]
+        next if ids.blank?
+
+        mapped_ids = Array(ids).filter_map { |id| id_map[id] || id }
+        filter.public_send(setter, mapped_ids)
+      end
+    end
+
+    row
+  end
+end
