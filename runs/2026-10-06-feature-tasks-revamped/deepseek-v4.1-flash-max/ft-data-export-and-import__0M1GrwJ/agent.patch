@@ -0,0 +1,38 @@
+require "test_helper"
+
+class ExportImportJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    Current.account = @account
+  end
+
+  test "export job builds the archive and emails" do
+    export = Export.create_for(account: @account, user: @user)
+
+    assert_enqueued_emails 1 do
+      ExportJob.perform_now(export)
+    end
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert ExportJob == Account::ExportJob
+  end
+
+  test "import job imports the archive and emails" do
+    export = Export.create_for(account: @account, user: @user)
+    export.export_now
+
+    import = Import.new(identity: @user.identity, user: @user, source_account: @account)
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+
+    assert_enqueued_emails 1 do
+      ImportJob.perform_now(import)
+    end
+
+    assert import.reload.completed?
+    assert_not_nil import.account
+    assert ImportJob == Account::ImportJob
+  end
+end
diff --git a/test/mailers/export_import_mailer_test.rb b/test/mailers/export_import_mailer_test.rb
new file mode 100644
index 0000000..05513d4
--- /dev/null
+++ b/test/mailers/export_import_mailer_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class ExportImportMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    Current.account = @account
+  end
+
+  test "export ready email includes an expiring download link" do
+    export = Export.create_for(account: @account, user: @user)
+    export.file.attach(io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip")
+
+    email = ExportMailer.ready(export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match /export is ready/i, email.subject
+    assert_match /24 hours/, email.body.encoded
+    assert_match %r{rails/active_storage}, email.body.encoded
+  end
+
+  test "import completed email links to the new account" do
+    account = Account.create!(name: "Imported account")
+    import = Import.create!(identity: @user.identity, user: @user, account: account)
+
+    email = ImportMailer.completed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match /import is complete/i, email.subject
+    assert_match account.name, email.body.encoded
+  end
+
+  test "import failed email includes the reason" do
+    import = Import.create!(identity: @user.identity, user: @user, status: "failed", failure_reason: "The archive was corrupt")
+
+    email = ImportMailer.failed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match /The archive was corrupt/, email.body.encoded
+  end
+end
diff --git a/test/models/export_import_roundtrip_test.rb b/test/models/export_import_roundtrip_test.rb
new file mode 100644
index 0000000..193a0a7
--- /dev/null
+++ b/test/models/export_import_roundtrip_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class ExportImportRoundtripTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    Current.account = @account
+  end
+
+  test "exports an account and imports it into a new account" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("fake image data"), filename: "logo.png", content_type: "image/png")
+
+    export = Export.create_for(account: @account, user: @user, scope: "account", include_all: true)
+    export.export_now
+
+    assert export.completed?, export.failure_reason
+    assert export.file.attached?
+
+    zip_data = export.file.download
+    reader = ZipFile::Reader.new(StringIO.new(zip_data))
+    assert reader.exists?("accounts/#{@account.id}.json")
+    assert reader.exists?("boards/#{boards(:writebook).id}.json")
+    assert reader.exists?("cards/#{card.id}.json")
+    assert reader.exists?("comments/#{comments(:logo_1).id}.json")
+    file_entries = reader.glob("files/**/*")
+    assert file_entries.any?, "expected attached file to be exported, got #{reader.entry_names.inspect}"
+
+    before_boards = @account.boards.count
+    before_cards = @account.cards.count
+    before_comments = Comment.where(account: @account).count
+    before_blobs = ActiveStorage::Blob.count
+
+    import = Import.new(identity: @user.identity, user: @user, creator: @user, source_account: @account)
+    import.file.attach(io: StringIO.new(zip_data), filename: "export.zip", content_type: "application/zip")
+
+    assert_difference -> { Account.count }, +1 do
+      import.import_now
+    end
+
+    assert import.completed?, import.error_reason
+    assert_not_nil import.account
+    new_account = import.account.reload
+    assert_equal @account.name, new_account.name
+    assert_equal before_boards, new_account.boards.count
+    assert_equal before_cards, new_account.cards.count
+    assert_equal before_comments, Comment.where(account: new_account).count
+    assert_equal before_blobs + 2, ActiveStorage::Blob.count
+
+    new_card = new_account.cards.find_by(title: card.title)
+    assert_not_nil new_card
+    assert new_card.image.attached?
+    assert_equal "fake image data", new_card.image.download
+
+    assert new_account.users.exists?(identity: @user.identity)
+  end
+end
+
+class ExportImportRoundtripRichTextTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    Current.account = @account
+  end
+
+  test "round trips rich text embeds and their file data" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded file data"), filename: "embedded.txt", content_type: "text/plain")
+    card.description = ActionText::Content.new("Embedded: ").append_attachables(blob)
+    card.save!
+
+    export = Export.create_for(account: @account, user: @user, scope: "account", include_all: true)
+    export.export_now
+    assert export.completed?, export.failure_reason
+
+    import = Import.new(identity: @user.identity, user: @user, creator: @user, source_account: @account)
+    import.file.attach(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+
+    assert_difference -> { Account.count }, +1 do
+      import.import_now
+    end
+    assert import.completed?, import.error_reason
+
+    new_card = import.account.cards.find_by(title: card.title)
+    attachables = new_card.description.body.attachables
+    assert_equal 1, attachables.grep(ActiveStorage::Blob).size, attachables.inspect
+    assert_equal "embedded file data", attachables.grep(ActiveStorage::Blob).first.download
+  end
+
+  test "a failed import leaves nothing behind" do
+    import = Import.new(identity: @user.identity, user: @user, creator: @user, source_account: @account)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "export.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Board.count } do
+        import.import_now
+      end
+    end
+
+    assert import.failed?
+    assert_nil import.reload.account_id
+  end
+end
