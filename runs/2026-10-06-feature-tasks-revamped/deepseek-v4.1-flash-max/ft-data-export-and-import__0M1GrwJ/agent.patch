diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..f0b129b
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,131 @@
+require "zip"
+
+class ZipFile::Reader
+  attr_reader :source
+
+  def initialize(source)
+    @source = source
+    @owned = false
+
+    case source
+    when Zip::File
+      @zip = source
+    when String
+      if File.directory?(source)
+        @directory = source
+      else
+        @zip = Zip::File.open(source)
+        @owned = true
+      end
+    else
+      if source.respond_to?(:download)
+        @tempfile = Tempfile.new([ "fizzy-archive", ".zip" ])
+        @tempfile.binmode
+        source.download { |chunk| @tempfile.write(chunk) }
+        @tempfile.rewind
+        @zip = Zip::File.open(@tempfile.path)
+        @owned = true
+      elsif source.respond_to?(:read)
+        @zip = Zip::File.open_buffer(source)
+        @owned = true
+      else
+        raise ArgumentError, "Unsupported archive source: #{source.class.name}"
+      end
+    end
+  end
+
+  def self.open(source)
+    reader = new(source)
+
+    if block_given?
+      begin
+        yield reader
+      ensure
+        reader.close
+      end
+    else
+      reader
+    end
+  end
+
+  def entries
+    if @directory
+      Dir.glob(File.join(@directory, "**", "*")).select { |path| File.file?(path) }.map do |path|
+        Entry.new(path.delete_prefix("#{@directory}/"), path)
+      end
+    else
+      @zip.entries
+    end
+  end
+
+  def entry_names
+    entries.map(&:name)
+  end
+
+  def glob(pattern)
+    entry_names.select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(name)
+    if @directory
+      File.file?(File.join(@directory, name))
+    else
+      @zip.find_entry(name).present?
+    end
+  end
+
+  def read(name)
+    if @directory
+      path = File.join(@directory, name)
+      File.binread(path) if File.file?(path)
+    else
+      entry = @zip.find_entry(name)
+      entry&.get_input_stream&.then { |io| io.read }
+    end
+  end
+
+  def open(name)
+    return enum_for(:open, name) unless block_given?
+
+    io = if @directory
+      path = File.join(@directory, name)
+      File.open(path, "rb") if File.file?(path)
+    else
+      entry = @zip.find_entry(name)
+      entry&.get_input_stream
+    end
+
+    raise Errno::ENOENT, name unless io
+
+    begin
+      yield io
+    ensure
+      io.close if io.respond_to?(:close) && (!io.respond_to?(:closed?) || !io.closed?)
+    end
+  end
+
+def close
+  begin
+    if @owned && @zip && !(@zip.respond_to?(:closed?) && @zip.closed?)
+      @zip.close
+    end
+  rescue StandardError
+    nil
+  end
+
+  if @tempfile
+    @tempfile.close unless @tempfile.closed?
+    @tempfile.unlink if File.exist?(@tempfile.path)
+    @tempfile = nil
+  end
+end
+
+  class Entry
+    attr_reader :name, :path
+
+    def initialize(name, path)
+      @name = name
+      @path = path
+    end
+  end
+end
