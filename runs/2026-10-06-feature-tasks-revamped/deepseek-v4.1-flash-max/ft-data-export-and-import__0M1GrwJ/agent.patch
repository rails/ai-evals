+    @identity_emails = {}
+    @uploaded_blob_keys = []
+    @imported_blob_ids = []
+  end
+
+  def [](old_id)
+    @ids[normalize(old_id)]
+  end
+
+  def []=(old_id, new_id)
+    @ids[normalize(old_id)] = normalize(new_id)
+  end
+
+  def register(old_id, new_id)
+    return new_id if old_id.blank? || new_id.blank?
+
+    self[old_id] = new_id
+    new_id
+  end
+
+  def assigned?(old_id)
+    @ids.key?(normalize(old_id))
+  end
+
+  def remap(value)
+    case value
+    when Hash
+      value.transform_values { |item| remap(item) }
+    when Array
+      value.map { |item| remap(item) }
+    when String
+      @ids[value] || value
+    else
+      value
+    end
+  end
+
+  def record_for(old_id)
+    @records[normalize(old_id)]
+  end
+
+  def store_record(old_id, record)
+    @records[normalize(old_id)] = record
+  end
+
+  def old_blob_key(old_id)
+    @old_blob_keys[normalize(old_id)]
+  end
+
+  def store_old_blob_key(old_id, key)
+    return if old_id.blank? || key.blank?
+
+    @old_blob_keys[normalize(old_id)] = key
+    @key_to_old_blob_id[key] = normalize(old_id)
+  end
+
+  def new_blob_key(old_id)
+    @new_blob_keys[normalize(old_id)]
+  end
+
+  def store_new_blob_key(old_id, key)
+    @new_blob_keys[normalize(old_id)] = key
+  end
+
+  def old_blob_id_for_key(key)
+    @key_to_old_blob_id[key]
+  end
+
+def store_identity_email(old_identity_id, email_address)
+  return if old_identity_id.blank? || email_address.blank?
+
+  @identity_emails[normalize(old_identity_id)] = email_address
+end
+
+def identity_email(old_identity_id)
+  @identity_emails[normalize(old_identity_id)]
+end
+
+def record_rich_text_blob(rich_text_id, blob_id)
+    return if rich_text_id.blank? || blob_id.blank?
+
+    @rich_text_blob_ids[normalize(rich_text_id)] << normalize(blob_id)
+  end
+
+  def rich_text_blob_ids(rich_text_id)
+    @rich_text_blob_ids[normalize(rich_text_id)]
+  end
+
+  def record_uploaded_blob_key(key)
+    @uploaded_blob_keys << key if key.present?
+  end
+
+  def uploaded_blob_keys
+    @uploaded_blob_keys
+  end
+
+  def mark_blob_imported(old_id)
+    @imported_blob_ids << normalize(old_id)
+  end
+
+  def blob_imported?(old_id)
+    @imported_blob_ids.include?(normalize(old_id))
+  end
+
+  def assigned_values
+    @ids.values
+  end
+
+  private
+    def normalize(id)
+      id&.to_s
+    end
+end
