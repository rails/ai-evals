@@ -0,0 +1,50 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Import.new(import_params)
+    @import.identity = Current.identity
+    @import.user = Current.user
+    @import.creator = Current.user
+    @import.created_by = Current.user
+    @import.source_account = Current.account
+
+    if @import.file.attached? && @import.save
+      @import.import_later
+
+      respond_to do |format|
+        format.html { redirect_to account_import_path(@import), notice: "Import started. We'll email you when it's done." }
+        format.json { render json: import_json(@import), status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { error: "A Fizzy export file is required" }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+    @import = Import.find(params[:id])
+
+    respond_to do |format|
+      format.html
+      format.json { render json: import_json(@import) }
+    end
+  end
+
+  private
+    def import_params
+      if params[:import].present?
+        params.expect(import: [ :file ])
+      else
+        params.permit(:file)
+      end
+    end
+
+    def import_json(import)
+      { id: import.id, status: import.status, error: import.error_reason, account_id: import.account_id }
+    end
+end
