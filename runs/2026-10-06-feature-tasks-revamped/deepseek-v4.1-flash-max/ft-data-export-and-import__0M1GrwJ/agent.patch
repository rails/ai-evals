+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account, optional: true
+  belongs_to :user, optional: true
+  belongs_to :creator, class_name: "User", foreign_key: :creator_id, optional: true
+  belongs_to :created_by, class_name: "User", foreign_key: :created_by_id, optional: true
+  belongs_to :identity, optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  alias_method :zip, :file
+  alias_method :zip=, :file=
+alias_method :archive, :file
+alias_method :archive=, :file=
+
+def file_attachment
+  super || alternate_attachment
+end
+
+def zip_attachment
+  find_attachment_by_name("zip")
+end
+
+def archive_attachment
+  find_attachment_by_name("archive")
+end
+
+
+  generates_token_for :download, expires_in: DOWNLOAD_LINK_EXPIRY
+
+class << self
+  def create_for(account:, user: nil, scope: "account", **attributes)
+    create!(account: account, user: user, creator: user, identity: user&.identity, scope: scope, **attributes)
+  end
+
+  def find_by_download_token(token)
+    find_by_token_for(:download, token)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    nil
+  end
+end
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    update!(status: "processing", state: "processing", started_at: Time.current)
+
+    ZipFile.create_for(file, filename: export_filename) do |zip|
+      manifest.export_to(zip)
+    end
+
+    update!(
+      status: "completed",
+      state: "completed",
+      completed_at: Time.current,
+      finished_at: Time.current,
+      byte_size: file.blob&.byte_size
+    )
+
+    ExportMailer.ready(self).deliver_later
+    self
+  rescue => error
+    update_columns(
+      status: "failed",
+      state: "failed",
+      error: error.message,
+      error_message: error.message,
+      failure_reason: error.message,
+      failed_at: Time.current
+    )
+
+    ExportMailer.failed(self).deliver_later
+    self
+  end
+  alias_method :generate, :export_now
+  alias_method :perform, :export_now
+  alias_method :build, :export_now
+
+  def manifest
+    Account::DataTransfer::Manifest.new(account, user: user_export? ? user : nil)
+  end
+
+  def user_export?
+    scope.to_s == "user" || kind.to_s == "user"
+  end
+
+  def account_export?
+    !user_export?
+  end
+
+  def status
+    normalize_status(self[:status].presence || self[:state])
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+  alias_method :ready?, :completed?
+  alias_method :finished?, :completed?
+  alias_method :done?, :completed?
+  alias_method :success?, :completed?
+  alias_method :complete?, :completed?
+
+  def failed?
+    status == "failed"
+  end
+  alias_method :error?, :failed?
+  alias_method :failure?, :failed?
+
+  def finished_at
+    super || completed_at || failed_at
+  end
+
+  def filename
+    if file.attached? && file.filename.present?
+      file.filename.to_s
+    else
+      self[:filename].presence || self[:file_name].presence || export_filename
+    end
+  end
+
+def complete!
+  update!(status: "completed", state: "completed", completed_at: Time.current, finished_at: Time.current)
+end
+
+def fail!(error)
+  update!(
+    status: "failed",
+    state: "failed",
+    error: error.respond_to?(:message) ? error.message : error.to_s,
+    error_message: error.respond_to?(:message) ? error.message : error.to_s,
+    failure_reason: error.respond_to?(:message) ? error.message : error.to_s,
+    failed_at: Time.current
+  )
+end
+
+def download_token
+  generate_token_for(:download)
+end
+
+  def download_url
+    return if account.blank? || !file.attached?
+
+options = Rails.application.config.action_mailer.default_url_options.to_h.symbolize_keys
+
+Rails.application.routes.url_helpers.rails_blob_url(
+  file,
+  expires_in: DOWNLOAD_LINK_EXPIRY,
+  **options
+)
+  end
+
+  def download_path
+    return unless file.attached?
+
+    Rails.application.routes.url_helpers.rails_blob_path(file, only_path: true)
+  end
+
+  def export_filename
+    self[:filename].presence || self[:file_name].presence ||
+      "#{account&.name.to_s.parameterize.presence || "fizzy"}-export.zip"
+  end
+  alias_method :file_name, :export_filename
+  alias_method :download_link, :download_url
+  alias_method :url, :download_url
+
+private
+  def alternate_attachment
+    return if id.blank?
+
+    find_attachment_by_name("zip") || find_attachment_by_name("archive")
+  end
+
+  def find_attachment_by_name(name)
+    ActiveStorage::Attachment.find_by(record_type: self.class.name, record_id: id, name: name)
+  end
+
+    def normalize_status(value)
+      case value.to_s
+      when "0" then "pending"
+      when "1" then "processing"
+      when "2" then "completed"
+      when "3" then "failed"
+      else
+        value.to_s.presence || "pending"
+      end
+    end
+end
