+  def records
+    apply_scope(::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids))
+  end
+
+  def prepare_import(reader)
+    each_import_attributes(reader) do |data, path|
+      old_id = data["id"].presence || id_from_path(path)
+      next if old_id.blank?
+
+      old_key = data["key"].presence
+      id_map.store_old_blob_key(old_id, old_key) if old_key.present?
+      id_map.store_new_blob_key(old_id, choose_blob_key(old_key))
+      id_map.register(old_id, choose_record_id(old_id))
     end
 
+    @prepared = true
+  end
+
+  def import_record(data, path: nil)
+    attributes = data.to_h.stringify_keys
+    old_id = attributes["id"].presence || id_from_path(path)
+
+    row = attributes.slice(*model.column_names).except("id")
+    row = id_map.remap(row)
+    row["key"] = id_map.new_blob_key(old_id) || choose_blob_key(row["key"])
+    row["service_name"] = ::ActiveStorage::Blob.service.name.to_s
+    row["id"] = id_map[old_id] || old_id || generate_unique_id
+    row["account_id"] = account.id
+
+    insert_row(row, old_id)
+    row
+  end
+
+  private
     def excluded_blob_ids
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
+
+    def track_imported_records?
+      true
+    end
+
+    def choose_blob_key(old_key)
+      if old_key.present? && !::ActiveStorage::Blob.exists?(key: old_key)
+        old_key
+      else
+        generate_blob_key
+      end
+    end
+
+    def generate_blob_key
+      loop do
+        key = ::ActiveStorage::Blob.generate_unique_secure_token
+        return key unless ::ActiveStorage::Blob.exists?(key: key)
+      end
+    end
+
+    def regenerate_unique_attributes(row)
+      row["key"] = generate_blob_key
+    end
 end
