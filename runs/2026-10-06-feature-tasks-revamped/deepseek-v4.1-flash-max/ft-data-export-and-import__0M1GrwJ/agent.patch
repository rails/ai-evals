diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..50f2bb0 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -1,11 +1,83 @@
 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
-  def initialize(account)
-    super(account: account, model: ::ActionText::RichText)
+  def initialize(account, **options)
+    super(account: account, model: ::ActionText::RichText, **options)
+  end
+
+  def records
+    apply_scope(::ActionText::RichText.where(account: account))
+  end
+
+  def import_record(data, path: nil)
+    attributes = data.to_h.stringify_keys
+    old_id = attributes["id"].presence || id_from_path(path)
+
+    row = attributes.slice(*model.column_names).except("id")
+    row = id_map.remap(row)
+    row["id"] = id_map[old_id] || old_id || generate_unique_id
+    row["account_id"] = account.id
+    row["body"] = rewrite_body(row["body"], old_id) if row["body"].present?
+
+    insert_row(row, old_id)
+    row
   end
 
   private
-    def records
-      ::ActionText::RichText.where(account: account)
+    def rewrite_body(body, old_rich_text_id)
+      return body unless body.include?("action-text-attachment")
+
+      fragment = Nokogiri::HTML5.fragment(body)
+      nodes = fragment.css("action-text-attachment")
+      nodes.each_with_index do |node, index|
+        replacement = replacement_sgid(node["sgid"], old_rich_text_id, index)
+        node["sgid"] = replacement if replacement.present?
+      end
+      fragment.to_html
+    rescue StandardError
+      body
+    end
+
+    def replacement_sgid(sgid, old_rich_text_id, index)
+      if sgid.present? && (old_record = locate_attachable(sgid))
+        replacement = replacement_for_record(old_record)
+        return replacement if replacement.present?
+      end
+
+      fallback_blob_id = id_map.rich_text_blob_ids(old_rich_text_id)[index]
+      replacement_for_blob_id(fallback_blob_id)
     end
 
+    def locate_attachable(sgid)
+      GlobalID::Locator.locate_signed(sgid, for: "attachable")
+    rescue StandardError
+      nil
+    end
+
+    def replacement_for_record(record)
+      case record
+      when ::ActiveStorage::Blob
+        replacement_for_blob_id(record.id)
+      when User
+        replacement_for_model(record, User)
+      else
+        if record.respond_to?(:attachable_sgid)
+          replacement_for_model(record, record.class)
+        end
+      end
+    end
+
+    def replacement_for_model(record, klass)
+      new_id = id_map[record.id]
+      return if new_id.blank?
+
+      new_record = klass.find_by(id: new_id)
+      new_record&.attachable_sgid
+    end
+
+    def replacement_for_blob_id(old_blob_id)
+      return if old_blob_id.blank?
+
+      blob = id_map.record_for(old_blob_id)
+      blob = ::ActiveStorage::Blob.find_by(id: id_map[old_blob_id]) unless blob.is_a?(::ActiveStorage::Blob)
+      blob&.attachable_sgid
+    end
 end
