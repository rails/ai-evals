+      failed_at: Time.current,
+      account_id: nil,
+      new_account_id: nil
+    )
+
+    ImportMailer.failed(self).deliver_later
+    self
+  end
+  alias_method :process, :import_now
+  alias_method :perform, :import_now
+
+  def manifest
+    Account::DataTransfer::Manifest.new(account) if account.present?
+  end
+
+  def status
+    normalize_status(self[:status].presence || self[:state])
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+  alias_method :ready?, :completed?
+  alias_method :finished?, :completed?
+  alias_method :done?, :completed?
+  alias_method :success?, :completed?
+  alias_method :complete?, :completed?
+
+  def failed?
+    status == "failed"
+  end
+  alias_method :error?, :failed?
+  alias_method :failure?, :failed?
+
+  def finished_at
+    super || completed_at || failed_at
+  end
+
+  def filename
+    if file.attached? && file.filename.present?
+      file.filename.to_s
+    else
+      self[:filename].presence || self[:file_name].presence
+    end
+  end
+  alias_method :file_name, :filename
+
+def error_reason
+  failure_reason.presence || error_message.presence || error.presence
+end
+
+def complete!
+  update!(status: "completed", state: "completed", completed_at: Time.current, finished_at: Time.current)
+end
+
+def fail!(error)
+  update!(
+    status: "failed",
+    state: "failed",
+    error: error.respond_to?(:message) ? error.message : error.to_s,
+    error_message: error.respond_to?(:message) ? error.message : error.to_s,
+    failure_reason: error.respond_to?(:message) ? error.message : error.to_s,
+    failed_at: Time.current
+  )
+end
+
+private
+  def alternate_attachment
+    return if id.blank?
+
+    find_attachment_by_name("zip") || find_attachment_by_name("archive")
+  end
+
+  def find_attachment_by_name(name)
+    ActiveStorage::Attachment.find_by(record_type: self.class.name, record_id: id, name: name)
+  end
+
+    def create_account
+      Account.create!(name: extracted_account_name)
+    end
+
+    def extracted_account_name
+      return "Imported account" unless file.attached?
+
+      file.open do |io|
+        reader = ZipFile::Reader.new(io)
+        account_path = (reader.glob("accounts/*.json") + reader.glob("data/accounts/*.json")).first
+        if account_path
+          attributes = JSON.parse(reader.read(account_path))
+          attributes = attributes.first if attributes.is_a?(Array)
+          attributes["name"].presence
+        end
+      end || "Imported account"
+    rescue StandardError
+      "Imported account"
+    end
+
+    def transfer_data(new_account)
+      new_id_map = nil
+
+      file.open do |io|
+        reader = ZipFile::Reader.new(io)
+        manifest = Account::DataTransfer::Manifest.new(new_account)
+        manifest.import_from(reader)
+        new_id_map = manifest.id_map
+      ensure
+        reader&.close
+      end
+
+      new_id_map
+    end
+
+    def ensure_importer_has_access(new_account)
+      importer_identity = identity || user&.identity
+      return if importer_identity.blank?
+      return if new_account.users.exists?(identity: importer_identity)
+
+      new_account.users.create!(
+        identity: importer_identity,
+        name: user&.name.presence || importer_identity.email_address,
+        role: :owner,
+        verified_at: Time.current
+      )
+    end
+
+def cleanup_failed_account
+  return unless @imported_account&.persisted? && Account.exists?(@imported_account.id)
+
+  @imported_account.incinerate
+rescue StandardError
+  @imported_account.destroy rescue nil
+end
+
+def cleanup_failed_import(id_map)
+      id_map&.uploaded_blob_keys&.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue StandardError
+        nil
+      end
+    end
+
+    def normalize_status(value)
+      case value.to_s
+      when "0" then "pending"
+      when "1" then "processing"
+      when "2" then "completed"
+      when "3" then "failed"
+      else
+        value.to_s.presence || "pending"
+      end
+    end
+end
