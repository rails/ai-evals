diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..fc4047f
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,31 @@
+// Reads the translations embedded by ApplicationHelper#i18n_javascript_tag.
+const TRANSLATIONS_ELEMENT_ID = "i18n-translations"
+
+export function t(key, replacements = {}) {
+  const value = translationFor(key)
+  if (value === undefined) return key
+
+  return Object.entries(replacements).reduce(
+    (result, [name, replacement]) => result.split(`%{${name}}`).join(String(replacement)),
+    value
+  )
+}
+
+export function currentLocale() {
+  return document.documentElement.lang || "en"
+}
+
+function translationFor(key) {
+  return parseTranslations()[key]
+}
+
+function parseTranslations() {
+  const element = document.getElementById(TRANSLATIONS_ELEMENT_ID)
+  if (!element) return {}
+
+  try {
+    return JSON.parse(element.textContent)
+  } catch {
+    return {}
+  }
+}
