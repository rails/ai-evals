+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,41 @@
+class ActivitiesController < ApplicationController
+  ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    @events = activities
+    set_page_and_extract_portion_from @events
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def activities
+      activities = Current.user.accessible_events.preloaded.where(action: ACTIONS).reverse_chronologically
+      activities = activities.where(creator_id: creator_ids) if creator_ids.present?
+      activities = activities.where(board_id: board_ids) if board_ids.present?
+      activities
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..54a1e64
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,19 @@
+module ActivitiesHelper
+  def particulars_for(event)
+    event_particulars = event.particulars || {}
+    details = event_particulars["particulars"].presence || event_particulars
+
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: details["assignee_ids"] || event_particulars["assignee_ids"] }
+    when "card_board_changed"
+      { old_board: details["old_board"].to_s, new_board: details["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: details["old_title"].to_s, new_title: details["new_title"].to_s }
+    when "card_triaged"
+      { column: details["column"].to_s }
+    else
+      {}
+    end
+  end
+end
