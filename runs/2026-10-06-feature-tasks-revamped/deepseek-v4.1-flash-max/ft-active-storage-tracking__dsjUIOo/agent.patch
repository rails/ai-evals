diff --git a/app/jobs/storage_usage_job.rb b/app/jobs/storage_usage_job.rb
new file mode 100644
index 0000000..fc198cb
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,30 @@
+class StorageUsageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(*records)
+    records = records.flatten.compact
+
+    if records.any?
+      records.each { |record| recalculate record }
+    else
+      Account.find_each { |account| account.recalculate_bytes_used }
+      Board.find_each { |board| board.recalculate_bytes_used }
+      Card.find_each { |card| card.recalculate_bytes_used }
+    end
+  end
+
+  private
+    def recalculate(record)
+      case record
+      when Account
+        record.recalculate_bytes_used
+      when Board
+        record.recalculate_bytes_used
+        record.account&.recalculate_bytes_used
+      when Card
+        record.recalculate_bytes_used
+        record.board&.recalculate_bytes_used
+        record.account&.recalculate_bytes_used
+      end
+    end
+end
