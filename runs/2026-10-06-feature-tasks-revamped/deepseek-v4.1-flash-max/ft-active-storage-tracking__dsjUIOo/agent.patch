+module StorageUsage::ParentSync
+  extend ActiveSupport::Concern
+
+  def update_columns(attributes)
+    return super unless has_attribute?(:bytes_used)
+
+    previous_bytes_used = self[:bytes_used].to_i
+    result = super
+    current_bytes_used = self[:bytes_used].to_i
+
+    if current_bytes_used != previous_bytes_used
+      sync_storage_usage_parents(current_bytes_used - previous_bytes_used)
+    end
+
+    result
+  end
+end
diff --git a/app/models/concerns/storage_usage/tracked_attachment.rb b/app/models/concerns/storage_usage/tracked_attachment.rb
new file mode 100644
index 0000000..9617ec3
--- /dev/null
+++ b/app/models/concerns/storage_usage/tracked_attachment.rb
@@ -0,0 +1,94 @@
+module StorageUsage::TrackedAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :create_storage_usage
+    before_update :remember_storage_usage
+    after_update :update_storage_usage
+    before_destroy :remember_storage_usage
+    after_destroy :destroy_storage_usage
+  end
+
+  def delete
+    snapshot = persisted? ? storage_usage_snapshot : nil
+    super
+    apply_storage_usage_snapshot(snapshot, -1) if snapshot
+  end
+
+  private
+    def create_storage_usage
+      apply_storage_usage_snapshot(storage_usage_snapshot, 1)
+    end
+
+    def update_storage_usage
+      previous_snapshot = @storage_usage_snapshot
+      current_snapshot = storage_usage_snapshot
+      @storage_usage_snapshot = nil
+
+      return if previous_snapshot == current_snapshot
+
+      apply_storage_usage_snapshot(previous_snapshot, -1) if previous_snapshot
+      apply_storage_usage_snapshot(current_snapshot, 1) if current_snapshot
+    end
+
+    def destroy_storage_usage
+      apply_storage_usage_snapshot(@storage_usage_snapshot, -1)
+      @storage_usage_snapshot = nil
+    end
+
+    def remember_storage_usage
+      @storage_usage_snapshot = storage_usage_snapshot
+    end
+
+    def apply_storage_usage_snapshot(snapshot, sign)
+      return if snapshot.nil?
+
+      StorageUsage.adjust_counters(snapshot, sign * snapshot[:bytes])
+      enqueue_storage_usage_job(snapshot)
+    end
+
+    def enqueue_storage_usage_job(snapshot)
+      if snapshot[:board_id]
+        board = Board.find_by(id: snapshot[:board_id])
+        StorageUsageJob.perform_later(board) if board
+      elsif snapshot[:account_id]
+        account = Account.find_by(id: snapshot[:account_id])
+        StorageUsageJob.perform_later(account) if account
+      end
+    end
+
+    def storage_usage_snapshot
+      if location = storage_usage_location
+        account_id, board_id, card_id = location
+        { account_id: account_id, board_id: board_id, card_id: card_id, bytes: blob&.byte_size.to_i }
+      end
+    end
+
+    def storage_usage_location
+      case record
+      when Card
+        [ record.account_id, record.board_id, record.id ] if name == "image"
+      when ActionText::RichText
+        storage_usage_location_for_rich_text(record)
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def storage_usage_location_for_rich_text(rich_text)
+      return unless name == "embeds"
+
+      case rich_text.record_type
+      when "Board"
+        [ rich_text.account_id, rich_text.record_id, nil ] if rich_text.name == "public_description"
+      when "Card"
+        if card = Card.where(id: rich_text.record_id).pick(:account_id, :board_id)
+          [ card.first, card.last, rich_text.record_id ] if rich_text.name == "description"
+        end
+      when "Comment"
+        if comment = Comment.joins(:card).where(id: rich_text.record_id).pick("comments.account_id", "cards.board_id", "comments.card_id")
+          [ comment.first, comment.second, comment.third ] if rich_text.name == "body"
+        end
+      end
+    end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
