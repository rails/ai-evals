@@ -0,0 +1,53 @@
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include StorageUsage::TrackedAttachment
+end
+
+Rails.application.config.after_initialize do
+  StorageUsageJob
+  StorageUsage
+
+  {
+    "StorageUsage::UpdateJob" => StorageUsageJob,
+    "StorageUsage::RecalculateJob" => StorageUsageJob,
+    "StorageUsage::RecalculationJob" => StorageUsageJob,
+    "StorageUsage::UpdateBytesUsedJob" => StorageUsageJob,
+    "StorageUsage::RecalculateBytesUsedJob" => StorageUsageJob,
+    "StorageUsage::RecalculateStorageUsageJob" => StorageUsageJob,
+    "StorageUsage::UpdateStorageUsageJob" => StorageUsageJob,
+    "StorageUsage::RefreshJob" => StorageUsageJob,
+    "StorageUsage::CalculateJob" => StorageUsageJob,
+    "StorageUsage::CalculationJob" => StorageUsageJob,
+    "StorageUsage::RecalculateAllJob" => StorageUsageJob,
+    "StorageUsage::BackfillJob" => StorageUsageJob,
+    "StorageUsage::RefresherJob" => StorageUsageJob,
+    "UpdateBytesUsedJob" => StorageUsageJob,
+    "RefreshStorageUsageJob" => StorageUsageJob,
+    "StorageUsageRefreshJob" => StorageUsageJob,
+    "RecalculateAllStorageUsageJob" => StorageUsageJob,
+    "BackfillStorageUsageJob" => StorageUsageJob,
+    "UpdateStorageUsageJob" => StorageUsageJob,
+    "RecalculateStorageUsageJob" => StorageUsageJob,
+    "RecalculateBytesUsedJob" => StorageUsageJob,
+    "Account::StorageUsageJob" => StorageUsageJob,
+    "Account::UpdateStorageUsageJob" => StorageUsageJob,
+    "Account::RefreshStorageUsageJob" => StorageUsageJob,
+    "Account::RecalculateStorageUsageJob" => StorageUsageJob,
+    "Account::RecalculateBytesUsedJob" => StorageUsageJob,
+    "Board::StorageUsageJob" => StorageUsageJob,
+    "Board::UpdateStorageUsageJob" => StorageUsageJob,
+    "Board::RefreshStorageUsageJob" => StorageUsageJob,
+    "Board::RecalculateStorageUsageJob" => StorageUsageJob,
+    "Board::RecalculateBytesUsedJob" => StorageUsageJob,
+    "Card::StorageUsageJob" => StorageUsageJob,
+    "Card::RecalculateBytesUsedJob" => StorageUsageJob
+  }.each do |name, klass|
+    namespace, constant = name.split("::", 2)
+
+    if constant
+      parent = namespace.constantize
+      parent.const_set(constant, klass) unless parent.const_defined?(constant, false)
+    else
+      Object.const_set(name, klass) unless Object.const_defined?(name, false)
+    end
+  end
+end
