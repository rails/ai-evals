diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..dc3b5eb
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,106 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  class << self
+    def card_image_bytes_used(card_ids, account_id: nil)
+      relation = ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: card_ids)
+      relation = relation.where(account_id: account_id) if account_id
+      relation.joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    def rich_text_bytes_used(record_type:, name:, record_ids:, account_id: nil)
+      relation = ActionText::RichText.where(record_type: record_type, name: name, record_id: record_ids)
+      relation = relation.where(account_id: account_id) if account_id
+      relation.joins(embeds_attachments: :blob).sum("active_storage_blobs.byte_size")
+    end
+
+    def card_bytes_used(card_ids)
+      card_image_bytes_used(card_ids) +
+        rich_text_bytes_used(record_type: "Card", name: "description", record_ids: card_ids) +
+        rich_text_bytes_used(record_type: "Comment", name: "body", record_ids: Comment.where(card_id: card_ids).select(:id))
+    end
+
+    def board_bytes_used(board)
+      card_ids = board.cards.select(:id)
+
+      board_description_bytes_used(board.id) + card_bytes_used(card_ids)
+    end
+
+    def board_description_bytes_used(board_ids)
+      rich_text_bytes_used(record_type: "Board", name: "public_description", record_ids: board_ids)
+    end
+
+    def adjust_counters(snapshot, delta)
+      Account.adjust_bytes_used(snapshot[:account_id], delta)
+      Board.adjust_bytes_used(snapshot[:board_id], delta) if snapshot[:board_id]
+      Card.adjust_bytes_used(snapshot[:card_id], delta) if snapshot[:card_id]
+    end
+
+    def account_bytes_used(account)
+      card_ids = account.cards.select(:id)
+      board_ids = account.boards.select(:id)
+
+      board_description_bytes_used(board_ids) +
+        card_image_bytes_used(card_ids) +
+        rich_text_bytes_used(record_type: "Card", name: "description", record_ids: card_ids) +
+        rich_text_bytes_used(record_type: "Comment", name: "body", record_ids: Comment.where(account_id: account.id).select(:id))
+    end
+  end
+
+  class_methods do
+    def adjust_bytes_used(id, delta)
+      return if id.nil? || delta.zero?
+
+      if record = find_by(id: id)
+        if record[:bytes_used].nil?
+          transaction do
+            if locked_record = lock.find_by(id: id)
+              if locked_record[:bytes_used].nil?
+                locked_record.recalculate_bytes_used
+              else
+                where(id: id).update_all([ "bytes_used = bytes_used + ?", delta ])
+              end
+            end
+          end
+        else
+          where(id: id).update_all([ "bytes_used = bytes_used + ?", delta ])
+        end
+      end
+    end
+  end
+
+  def adjust_bytes_used(delta)
+    self.class.adjust_bytes_used(id, delta)
+  end
+
+  def bytes_used
+    if persisted?
+      return self[:bytes_used] if has_attribute?(:bytes_used) && will_save_change_to_bytes_used?
+
+      value = self.class.where(id: id).pick(:bytes_used)
+      value.nil? ? recalculate_bytes_used : value
+    else
+      calculated_bytes_used
+    end
+  end
+
+  def calculate_bytes_used
+    calculated_bytes_used
+  end
+
+  def bytes_used_now
+    calculated_bytes_used
+  end
+
+  def recalculate_bytes_used
+    return calculated_bytes_used if new_record?
+
+    value = calculated_bytes_used
+    self.class.where(id: id).update_all(bytes_used: value)
+    value
+  end
+
+  def recalculate_bytes_used_later
+    StorageUsageJob.perform_later(self)
+  end
+end
