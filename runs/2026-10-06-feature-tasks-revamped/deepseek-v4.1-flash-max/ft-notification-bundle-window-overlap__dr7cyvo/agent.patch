index 0000000..316a2d6
--- /dev/null
+++ b/app/views/notifications/settings/_email.html.erb
@@ -0,0 +1,18 @@
+<section class="settings__section">
+  <h2 class="divider">Email notifications</h2>
+
+  <%= form_with model: Current.user.settings, url: notifications_settings_path, method: :patch do |form| %>
+    <div class="flex align-center gap">
+      <%= form.label :bundle_email_frequency, "Send me email digests", class: "flex-item-grow" %>
+      <%= form.select :bundle_email_frequency,
+            options_for_select([
+              [ "Off", "never" ],
+              [ "Every few hours", "every_few_hours" ],
+              [ "Daily", "daily" ],
+              [ "Weekly", "weekly" ]
+            ], Current.user.settings.bundle_email_frequency),
+            {},
+            onchange: "this.form.requestSubmit()" %>
+    </div>
+  <% end %>
+</section>
