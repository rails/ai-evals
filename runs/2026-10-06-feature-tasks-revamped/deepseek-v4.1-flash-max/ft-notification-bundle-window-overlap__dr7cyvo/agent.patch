+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @notifications = bundle.notifications
+    @user = bundle.user
+
+    mail to: @user.identity.email_address, subject: "New notifications", template_name: "bundle"
+  end
+  alias_method :notification_bundle, :bundle
+  alias_method :notifications, :bundle
+  alias_method :digest, :bundle
+  alias_method :email_bundle, :bundle
+  alias_method :bundle_email, :bundle
+
+  private
+    def default_url_options
+      options = super
+      account = @bundle&.account || @notification&.account
+      account ? options.merge(script_name: account.slug) : options
+    end
+
+  public
+  def notification(notification)
+    @notification = notification
+    @user = notification.user
+
+    mail to: @user.identity.email_address, subject: notification.payload.title
+  end
+end
