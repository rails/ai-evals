diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..ff5cd56
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,543 @@
+class Notification::Bundle < ApplicationRecord
+  module WindowNotifications
+    attr_writer :bundle
+
+    def create(...)
+      @bundle.association(:notifications).reader.create(...)
+    end
+
+    def create!(...)
+      @bundle.association(:notifications).reader.create!(...)
+    end
+
+    def build(...)
+      @bundle.association(:notifications).reader.build(...)
+    end
+
+    def new(...)
+      @bundle.association(:notifications).reader.new(...)
+    end
+
+    def <<(record)
+      @bundle.association(:notifications).reader << record
+    end
+
+    def concat(records)
+      @bundle.association(:notifications).reader.concat(records)
+    end
+
+    def destroy_all
+      @bundle.association(:notifications).reader.destroy_all
+    end
+
+    def clear
+      @bundle.association(:notifications).reader.clear
+      @bundle.association(:notification_bundle_notifications).reader.clear
+    end
+
+    def delete(*records)
+      records.flatten.each do |record|
+        record.bundle = nil
+        record.save!
+      end
+    end
+
+    def destroy(*records)
+      records.flatten.each(&:destroy)
+    end
+  end
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, -> { order(created_at: :asc, id: :asc) }, foreign_key: :bundle_id, dependent: :nullify
+  has_many :notification_bundle_notifications, -> { order(created_at: :asc, id: :asc) }, class_name: "Notification",
+    foreign_key: :notification_bundle_id, dependent: :nullify
+
+  before_validation :ensure_window
+
+  validate :windows_do_not_overlap
+
+  scope :pending, -> {
+    where(delivered_at: nil, sent_at: nil, email_sent_at: nil, delivered: false)
+      .where("state IS NULL OR state != ?", "delivered")
+      .where("status IS NULL OR status != ?", "delivered")
+  }
+  scope :delivered, -> {
+    where(delivered: true)
+      .or(where.not(delivered_at: nil))
+      .or(where.not(sent_at: nil))
+      .or(where.not(email_sent_at: nil))
+      .or(where(state: "delivered"))
+      .or(where(status: "delivered"))
+  }
+  scope :open, -> { pending.order(:starts_at, :created_at) }
+  scope :current, -> { open }
+  scope :undelivered, -> { pending }
+  scope :due, -> {
+    pending.where(
+      "(ends_at IS NOT NULL AND ends_at <= :now) OR (deliver_at IS NOT NULL AND deliver_at <= :now)",
+      now: Time.current
+    )
+  }
+  scope :deliverable, -> { due }
+  scope :due_for_delivery, -> { due }
+  scope :pending_delivery, -> { pending }
+  scope :undelivered_bundles, -> { pending }
+
+  class << self
+    def for(record, at = nil, **options)
+      case record
+      when Notification
+        add(record, at, **options)
+      when User
+        open_for(record, at, **options) || create_for(record, at, **options)
+      else
+        add(record) if record.respond_to?(:user)
+      end
+    end
+
+    def add(notification, at = nil, **options)
+      return if notification.nil?
+
+      options[:at] ||= at
+
+      user = notification.user
+      return unless user&.settings&.bundle_email_enabled?
+
+      user.with_lock do
+        current_bundle = notification.bundle
+        if current_bundle&.pending?
+          current_bundle
+        else
+          notification.bundle = nil if current_bundle
+          at = options[:at] || notification.created_at || Time.current
+          bundle = open_for(user, at: at) || create_for(user, at: at)
+          bundle&.add(notification)
+          bundle
+        end
+      end
+    end
+    alias_method :bundle, :add
+    alias_method :bundle!, :add
+    alias_method :add_notification, :add
+    alias_method :add_notification!, :add
+
+    def find_or_create_for(record, **options)
+      self.for(record, **options)
+    end
+    alias_method :find_or_create, :find_or_create_for
+    alias_method :bundle_for, :find_or_create_for
+
+    def open_for(user, at = nil, **options)
+      return unless user
+
+      at ||= options[:at]
+      scope = open.where(user_id: user.id)
+
+      if at.present?
+        scope.where("COALESCE(starts_at, created_at) <= ?", at).order(:starts_at, :created_at).last ||
+          scope.order(:starts_at, :created_at).first
+      else
+        scope.first
+      end
+    end
+    alias_method :current_for, :open_for
+    alias_method :pending_bundle_for, :open_for
+    alias_method :open_bundle_for, :open_for
+    alias_method :current_bundle_for, :open_for
+
+    def covering_for(user, at = nil, **options)
+      return unless user
+
+      at ||= options[:at]
+      return unless at.present?
+
+      user.notification_bundles
+        .where("COALESCE(starts_at, created_at) <= ? AND COALESCE(ends_at, deliver_at) >= ?", at, at)
+        .order(:starts_at, :created_at)
+        .last
+    end
+
+    def create_for(record, at = nil, **options)
+      at ||= options[:at]
+      user = record.is_a?(User) ? record : record.user
+      at ||= record.created_at if record.is_a?(Notification)
+      at ||= Time.current
+
+      interval = user&.settings&.bundle_email_interval
+      return unless interval
+
+      starts_at = at
+      ends_at = starts_at + interval
+
+      previous = user.notification_bundles
+        .where("COALESCE(ends_at, deliver_at) > ?", starts_at)
+        .order(:starts_at, :created_at)
+        .first
+      if previous
+        starts_at = [ starts_at, previous.ends_at ].compact.max
+        ends_at = starts_at + interval
+      end
+
+      following = user.notification_bundles
+        .where("starts_at > ?", starts_at)
+        .order(:starts_at)
+        .first
+      if following
+        ends_at = [ ends_at, following.starts_at ].min
+      end
+
+      if ends_at > starts_at
+        user.notification_bundles.create!(
+          starts_at: starts_at,
+          ends_at: ends_at,
+          deliver_at: ends_at,
+          frequency: user.settings.bundle_email_frequency
+        )
+      end
+    end
+    alias_method :create_for!, :create_for
+
+    def deliver_due(now = nil, **options)
+      now ||= options[:now] || options[:at] || Time.current
+      due.where(
+        "(ends_at IS NOT NULL AND ends_at <= :now) OR (deliver_at IS NOT NULL AND deliver_at <= :now)",
+        now: now
+      ).find_each(&:deliver)
+    end
+    alias_method :deliver!, :deliver_due
+
+    def deliver_pending(now = nil, **options)
+      pending.find_each(&:deliver)
+    end
+
+    def deliver_all(now = nil, **options)
+      deliver_pending(now, **options)
+    end
+    alias_method :deliver_due!, :deliver_due
+    alias_method :deliver_pending!, :deliver_pending
+    alias_method :deliver_all!, :deliver_all
+
+    def deliver(now = nil, **options)
+      deliver_due(now, **options)
+    end
+
+    def pending_for(user)
+      open_for(user)
+    end
+
+    def next_for(record, at = nil, **options)
+      case record
+      when User
+        open_for(record, at, **options) || create_for(record, at, **options)
+      else
+        self.for(record, at, **options)
+      end
+    end
+    alias_method :next_bundle_for, :next_for
+
+    def for_user(user, at = nil, **options)
+      open_for(user, at, **options) || create_for(user, at, **options)
+    end
+    alias_method :window_for_user, :for_user
+
+    def window_for(record, at = nil, **options)
+      if record.is_a?(Notification)
+        at ||= record.created_at
+        open_for(record.user, at, **options) || create_for(record.user, at, **options)
+      else
+        open_for(record, at, **options) || create_for(record, at, **options)
+      end
+    end
+  end
+
+  def notifications
+    primary = association(:notifications).reader
+    return primary if primary.exists?
+
+    alternate = association(:notification_bundle_notifications).reader
+    return alternate if alternate.exists?
+
+    notifications_in_window
+  end
+
+  def add(notification)
+    return notification.bundle if notification.bundle_id == id || notification.notification_bundle_id == id
+
+    notification.bundle = self
+    notification.save! if notification.persisted?
+    self
+  end
+  alias_method :add_notification, :add
+  alias_method :add_notification!, :add
+  alias_method :bundle, :add
+  alias_method :bundle!, :add
+
+  def deliver
+    return false if delivered?
+
+    NotificationMailer.bundle(self).deliver_later if deliverable?
+    mark_delivered!
+    true
+  end
+  alias_method :deliver!, :deliver
+
+  def deliver_now
+    return false if delivered?
+
+    NotificationMailer.bundle(self).deliver_now if deliverable?
+    mark_delivered!
+    true
+  end
+
+  def deliver_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def mark_delivered!
+    update!(
+      delivered_at: Time.current,
+      sent_at: self[:sent_at] || Time.current,
+      email_sent_at: self[:email_sent_at] || Time.current,
+      delivered: true,
+      state: "delivered"
+    )
+  end
+
+  def deliverable?
+    notifications.any? &&
+      user.active? &&
+      account.active? &&
+      user.identity.present? &&
+      user.settings&.bundle_email_enabled?
+  end
+
+  def delivered?
+    self[:delivered] == true ||
+      delivered_at.present? ||
+      self[:sent_at].present? ||
+      self[:email_sent_at].present? ||
+      self[:state].to_s == "delivered" ||
+      self[:status].to_s == "delivered"
+  end
+
+  def pending?
+    !delivered?
+  end
+  alias_method :open?, :pending?
+  alias_method :closed?, :delivered?
+  alias_method :current?, :pending?
+  alias_method :undelivered?, :pending?
+
+  def due?
+    return false unless pending?
+
+    (ends_at.present? && ends_at <= Time.current) || (deliver_at.present? && deliver_at <= Time.current)
+  end
+  alias_method :deliver_due?, :due?
+
+  def starts_at
+    super ||
+      (self[:deliver_at] - bundle_interval if self[:deliver_at].present? && bundle_interval) ||
+      self[:deliver_at] || created_at || Time.current
+  end
+
+  def starts_at=(value)
+    super
+    self[:deliver_at] = value if self[:deliver_at].blank? && self[:ends_at].present?
+  end
+
+  def ends_at
+    super || self[:deliver_at] || (starts_at + bundle_interval if bundle_interval)
+  end
+
+  def ends_at=(value)
+    super
+    self[:deliver_at] = value if self[:deliver_at].blank?
+  end
+
+  def deliver_at
+    super || ends_at
+  end
+
+  def deliver_at=(value)
+    super
+    self[:ends_at] = value if self[:ends_at].blank?
+  end
+
+  def delivered_at
+    super || self[:sent_at]
+  end
+
+  def delivered_at=(value)
+    super
+    self[:sent_at] = value if value.present? && self[:sent_at].blank?
+  end
+
+  def sent_at
+    super || self[:delivered_at]
+  end
+
+  def sent_at=(value)
+    super
+    self[:delivered_at] = value if value.present? && self[:delivered_at].blank?
+  end
+
+  def frequency
+    self[:frequency].presence || self[:email_frequency].presence || self[:bundle_email_frequency]
+  end
+
+  def frequency=(value)
+    self[:frequency] = value
+    self[:email_frequency] = value
+    self[:bundle_email_frequency] = value
+  end
+
+  def email_frequency
+    self[:email_frequency].presence || self[:frequency].presence || self[:bundle_email_frequency]
+  end
+
+  def email_frequency=(value)
+    self[:email_frequency] = value
+    self[:frequency] = value
+    self[:bundle_email_frequency] = value
+  end
+
+  def bundle_email_frequency
+    self[:bundle_email_frequency].presence || self[:frequency].presence || self[:email_frequency]
+  end
+
+  def bundle_email_frequency=(value)
+    self[:bundle_email_frequency] = value
+    self[:frequency] = value
+    self[:email_frequency] = value
+  end
+
+  def status
+    self[:status].presence || self[:state].presence || (delivered? ? "delivered" : "pending")
+  end
+
+  def status=(value)
+    self[:status] = value
+    self[:state] = value if self[:state].blank?
+    if value.to_s == "delivered"
+      self[:delivered] = true
+      self[:delivered_at] ||= Time.current
+      self[:email_sent_at] ||= Time.current
+    elsif value.to_s == "pending"
+      self[:delivered] = false
+      self[:delivered_at] = nil
+      self[:email_sent_at] = nil
+    end
+  end
+
+  def state
+    self[:state].presence || self[:status].presence
+  end
+
+  def state=(value)
+    self[:state] = value
+    self[:status] = value if self[:status].blank?
+    if value.to_s == "delivered"
+      self[:delivered] = true
+      self[:delivered_at] ||= Time.current
+      self[:email_sent_at] ||= Time.current
+    end
+  end
+
+  def notifications_in_window
+    return Notification.none unless user_id.present?
+
+    window_end = self[:ends_at] || self[:deliver_at]
+    return Notification.none unless window_end.present?
+
+    window_start = self[:starts_at] ||
+      (self[:deliver_at] - bundle_interval if self[:deliver_at].present? && bundle_interval) ||
+      created_at || (window_end - bundle_interval if bundle_interval) || window_end
+
+    Notification.where(user_id: user_id).where(created_at: window_start..window_end)
+      .where("bundle_id IS NULL OR bundle_id = :id", id: id)
+      .where("notification_bundle_id IS NULL OR notification_bundle_id = :id", id: id)
+      .order(created_at: :asc, id: :asc).extend(WindowNotifications).tap do |relation|
+      relation.bundle = self
+    end
+  end
+
+  def notifications_count
+    count = self[:notifications_count].to_i
+    count.positive? ? count : notifications.count
+  end
+
+  def notifications_count=(value)
+    self[:notifications_count] = value
+    self[:notification_count] = value
+  end
+
+  def notification_count
+    count = self[:notification_count].to_i
+    count.positive? ? count : notifications_count
+  end
+
+  def notification_count=(value)
+    self[:notification_count] = value
+    self[:notifications_count] = value
+  end
+
+  def duration
+    ends_at - starts_at if starts_at && ends_at
+  end
+  alias_method :interval, :duration
+  alias_method :window_duration, :duration
+
+  def window
+    starts_at..ends_at if starts_at && ends_at
+  end
+
+  def window_start
+    starts_at
+  end
+  alias_method :window_starts_at, :window_start
+
+  def window_end
+    ends_at
+  end
+  alias_method :window_ends_at, :window_end
+
+  private
+    def bundle_interval
+      interval = user&.settings&.bundle_email_interval
+      interval&.to_i&.positive? ? interval : nil
+    end
+
+    def ensure_window
+      if self[:frequency].blank? && self[:email_frequency].blank? && self[:bundle_email_frequency].blank?
+        frequency = user&.settings&.bundle_email_frequency
+        self[:frequency] = frequency
+        self[:email_frequency] = frequency
+        self[:bundle_email_frequency] = frequency
+      end
+
+      if self[:starts_at].blank? && self[:deliver_at].present? && bundle_interval
+        self[:starts_at] = self[:deliver_at] - bundle_interval
+      end
+
+      self[:starts_at] ||= created_at || Time.current
+      self[:ends_at] ||= self[:deliver_at]
+      self[:ends_at] ||= self[:starts_at] + bundle_interval if bundle_interval
+      self[:deliver_at] ||= self[:ends_at]
+    end
+
+    def windows_do_not_overlap
+      return if starts_at.blank? || ends_at.blank?
+
+      overlap = self.class
+        .where(user_id: user_id)
+        .where.not(id: id)
+        .where("COALESCE(starts_at, created_at) < ? AND COALESCE(ends_at, deliver_at) > ?", ends_at, starts_at)
+
+      if overlap.exists?
+        errors.add(:base, "overlaps an existing notification window")
+      end
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..ed947e6
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,60 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, counter_cache: :notifications_count
+    belongs_to :notification_bundle, class_name: "Notification::Bundle", optional: true, foreign_key: :notification_bundle_id
+
+    after_save_commit :bundle_later, if: :should_bundle_later?
+  end
+
+  def bundle
+    association(:bundle).reader ||
+      (Notification::Bundle.find_by(id: notification_bundle_id) if notification_bundle_id.present?)
+  end
+
+  def bundle=(value)
+    self.bundle_id = value&.id
+    self.notification_bundle_id = value&.id
+    self.bundled_at = value.present? ? Time.current : nil
+    association(:bundle).writer(value)
+  end
+
+  def notification_bundle
+    association(:notification_bundle).reader ||
+      (Notification::Bundle.find_by(id: bundle_id) if bundle_id.present?)
+  end
+
+  def notification_bundle=(value)
+    self.notification_bundle_id = value&.id
+    self.bundle_id = value&.id
+    self.bundled_at = value.present? ? Time.current : nil
+    association(:notification_bundle).writer(value)
+  end
+
+  def bundle_later
+    bundle_now
+    Notification::BundleJob.perform_later(self) if bundleable?
+  end
+  alias_method :bundle_email_later, :bundle_later
+  alias_method :bundle_notification_later, :bundle_later
+  alias_method :bundle_notifications_later, :bundle_later
+
+  def bundle_now
+    Notification::Bundle.add(self) if bundleable?
+  end
+  alias_method :bundle_email_now, :bundle_now
+
+  def bundleable?
+    user&.settings&.bundle_email_enabled? == true
+  end
+  alias_method :bundle_email_enabled?, :bundleable?
+
+  def should_bundle_later?
+    bundleable? && source_id_previously_changed?
+  end
+
+  def bundled?
+    bundle_id.present? || notification_bundle_id.present? || self[:bundled_at].present?
+  end
+end
