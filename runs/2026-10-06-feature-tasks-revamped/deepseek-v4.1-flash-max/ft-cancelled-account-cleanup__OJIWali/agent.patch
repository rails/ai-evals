diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..18b22cb 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,83 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :cancelled, -> { joins(:cancellation) }
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).select(:account_id))
+    }
+    scope :incineratable, -> { due_for_incineration }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Permanently deletes the account and every row scoped to it. Bulk deletes
+  # are used so missing dependent associations can't leave orphaned data.
+  def incinerate
+    return unless persisted?
+
+    blobs = ActiveStorage::Blob.where(account_id: id).to_a
+
+    transaction do
+      delete_search_records
+      delete_join_records
+      delete_storage_totals
+      delete_account_records
+      delete
+    end
+
+    purge_blobs(blobs)
+
+    self
+  end
+
+  private
+    def delete_search_records
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy)
+    end
+
+    def delete_join_records
+      Filter.reflect_on_all_associations(:has_and_belongs_to_many).each do |reflection|
+        join_model = model_for(reflection.join_table)
+        owner_ids = reflection.active_record.where(account_id: id).ids
+        associated_ids = reflection.klass.where(account_id: id).ids
+
+        join_model.where(reflection.foreign_key => owner_ids).delete_all if owner_ids.any?
+        join_model.where(reflection.association_foreign_key => associated_ids).delete_all if associated_ids.any?
+      end
+    end
+
+    def delete_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: Board.where(account_id: id).select(:id)).delete_all
+    end
+
+    def delete_account_records
+      account_scoped_tables.each do |table|
+        model_for(table).where(account_id: id).delete_all
+      end
+    end
+
+    def account_scoped_tables
+      connection = self.class.connection
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }
+    end
+
+    def model_for(table)
+      Class.new(ApplicationRecord) { self.table_name = table }
+    end
+
+    def purge_blobs(blobs)
+      blobs.each do |blob|
+        blob.service.delete(blob.key)
+      rescue => error
+        Rails.logger.warn "Couldn't delete ActiveStorage blob #{blob.id}: #{error.message}"
+      end
+    end
 end
