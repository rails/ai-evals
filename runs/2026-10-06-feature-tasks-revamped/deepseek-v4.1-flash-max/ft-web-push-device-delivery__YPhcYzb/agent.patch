diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..987341c 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,37 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Push notifications
+self.addEventListener("push", (event) => {
+  const data = event.data ? event.data.json() : {}
+
+  event.waitUntil(
+    self.registration.showNotification(data.title || "Fizzy", {
+      body: data.body,
+      data: { url: data.url },
+      icon: "/app-icon-192.png",
+      badge: "/app-icon-192.png"
+    })
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url || event.notification.data?.card?.url
+  if (url) {
+    event.waitUntil(openNotificationUrl(url))
+  }
+})
+
+async function openNotificationUrl(url) {
+  const windowClients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const existingClient = windowClients.find(client => client.url === url)
+
+  if (existingClient) {
+    return existingClient.focus()
+  }
+
+  return self.clients.openWindow(url)
+}
