new file mode 100644
index 0000000..315f78a
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,48 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @subscription.assign_attributes(push_subscription_params)
+
+    if @subscription.save
+      respond_to do |format|
+        format.html { head :created }
+        format.json { render json: { id: @subscription.id }, status: :created }
+      end
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    subscription = find_push_subscription
+    subscription.destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def find_push_subscription
+      if params[:id]
+        @user.push_subscriptions.find_by(id: params[:id]) || @user.push_subscriptions.find_by!(endpoint: params[:id])
+      else
+        endpoint = params.dig(:push_subscription, :endpoint) || params[:endpoint]
+        @user.push_subscriptions.find_by!(endpoint: endpoint)
+      end
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f294c7c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,144 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "enable", "disable" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptions: Array,
+    url: String
+  }
+
+  connect() {
+    this.hideDetails()
+    this.refresh()
+  }
+
+  async enable() {
+    if (!this.#supported) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.showDetails()
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      const response = await post(this.urlValue, {
+        body: { push_subscription: this.#subscriptionParams(subscription) },
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        const { id } = await response.json
+        this.subscriptionsValue = [
+          ...this.subscriptionsValue.filter(([ , value ]) => value !== subscription.endpoint),
+          [ id, subscription.endpoint ]
+        ]
+        this.turnOn()
+      }
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+    }
+  }
+
+  async disable() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        const id = this.#subscriptionId(subscription.endpoint)
+        await subscription.unsubscribe()
+        this.subscriptionsValue = this.subscriptionsValue.filter(([ , value ]) => value !== subscription.endpoint)
+
+        if (id) {
+          await destroy(`${this.urlValue}/${id}`, { responseKind: "json" })
+        } else {
+          await destroy(this.urlValue, {
+            body: { push_subscription: { endpoint: subscription.endpoint } },
+            responseKind: "json"
+          })
+        }
+      }
+    } catch (error) {
+      console.error("Failed to disable push notifications", error)
+    } finally {
+      this.turnOff()
+    }
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  turnOn() {
+    this.element.classList.add("notifications--on")
+    this.enableTarget.hidden = true
+    this.disableTarget.hidden = false
+  }
+
+  turnOff() {
+    this.element.classList.remove("notifications--on")
+    this.enableTarget.hidden = false
+    this.disableTarget.hidden = true
+  }
+
+  async refresh() {
+    if (!this.#supported) return this.#unsupported()
+    if (Notification.permission === "denied") this.showDetails()
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.turnOn()
+      } else {
+        this.turnOff()
+      }
+    } catch (error) {
+      console.error("Failed to check push notification subscription", error)
+    }
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #vapidPublicKey() {
+    return this.vapidPublicKeyValue || document.querySelector('meta[name="vapid-public-key"]')?.content
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - (this.#vapidPublicKey.length % 4)) % 4)
+    const base64 = (this.#vapidPublicKey + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = atob(base64)
+    return Uint8Array.from(rawData, char => char.charCodeAt(0))
+  }
+
+  #unsupported() {
+    this.enableTarget.disabled = true
+    this.disableTarget.hidden = true
+  }
+
+  #subscriptionParams(subscription) {
+    const { keys } = subscription.toJSON()
+    return { endpoint: subscription.endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+  }
+
+  #subscriptionId(endpoint) {
+    const pair = this.subscriptionsValue.find(([ , value ]) => value === endpoint)
+    return pair?.[0]
+  }
+}
