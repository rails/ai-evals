diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..1b53256 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -8,6 +8,88 @@ class Board < ApplicationRecord
   has_many :events
   has_many :webhooks, dependent: :destroy
 
+  has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+  scope :published, -> {
+    left_outer_joins(:publication)
+      .where("boards.public_key IS NOT NULL OR board_publications.id IS NOT NULL")
+      .distinct
+  }
+
+  class << self
+    def find_by_public_key!(key)
+      raise ActiveRecord::RecordNotFound if key.blank?
+
+      find_by(public_key: key) || joins(:publication).find_by!(board_publications: { key: key })
+    end
+  end
+
+  def public_key=(value)
+    super
+
+    if value.nil? && persisted?
+      publication&.destroy unless publication&.destroyed?
+    elsif value.present? && persisted? && (record = publication) && !record.destroyed? && record.key != value
+      record.update!(key: value)
+    end
+  end
+
+  def public_key
+    if (key = super).present?
+      key
+    elsif (record = publication) && !record.destroyed?
+      record.key
+    end
+  end
+  alias_method :key, :public_key
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+
+  def publish
+    transaction do
+      publication = self.publication
+      publication = nil if publication&.destroyed?
+      publication ||= create_publication!(key: self[:public_key].presence)
+
+      update!(public_key: publication.key) unless self[:public_key] == publication.key
+      publication
+    end
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    transaction do
+      publication&.destroy
+      association(:publication).reset
+
+      update!(public_key: nil) unless self[:public_key].nil?
+    end
+  end
+  alias_method :unpublish!, :unpublish
+
+  def public_url
+    if public_key.present?
+      publication&.url || public_url_from_key
+    end
+  end
+
+  private
+    def public_url_from_key
+      Rails.application.routes.url_helpers.public_board_url(public_key, **url_options.merge(script_name: nil))
+    end
+
+    def url_options
+      if Rails.env.test?
+        { host: "www.example.com" }
+      else
+        Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options.presence ||
+          {}
+      end
+    end
 end
diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..f57e82f
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,49 @@
+class Board::Publication < ApplicationRecord
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true
+
+  has_secure_token :key
+
+  def public_key
+    key
+  end
+
+  def public_key=(value)
+    self.key = value
+  end
+
+  after_save :sync_board_public_key
+  after_destroy :clear_board_public_key
+
+  def to_param
+    key
+  end
+
+  def url
+    Rails.application.routes.url_helpers.public_board_url(key, **url_options.merge(script_name: nil))
+  end
+
+  private
+    def sync_board_public_key
+      if board&.persisted? && board[:public_key] != key
+        board.update_column :public_key, key
+      end
+    end
+
+    def clear_board_public_key
+      if board
+        board.update_column :public_key, nil if board.persisted? && board[:public_key] == key
+        board.association(:publication).reset unless destroyed_by_association
+      end
+    end
+
+    def url_options
+      if Rails.env.test?
+        { host: "www.example.com" }
+      else
+        Rails.application.routes.default_url_options.presence ||
+          Rails.application.config.action_mailer.default_url_options.presence ||
+          {}
+      end
+    end
+end
