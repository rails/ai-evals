diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..bae92d7 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,119 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  FILTER_JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  included do
+    scope :incineratable, -> { joins(:cancellation).merge(Account::Cancellation.due_for_incineration) }
+    scope :due_for_incineration, -> { incineratable }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    blob_files = attachment_files
+    filter_ids = filter_ids_to_delete
+    owner_ids = storage_owner_ids
+    search_record_ids = search_record_ids_to_delete
+
+    transaction do
+      delete_search_index(search_record_ids)
+      delete_account_records
+      delete_storage_totals(owner_ids)
+      delete_filter_joins(filter_ids)
+      delete
+    end
+
+    delete_attachment_files(blob_files)
+  end
+
+  private
+    def connection
+      self.class.connection
+    end
+
+    def delete_account_records
+      account_tables.each do |table|
+        connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{quoted_id}")
+      end
+    end
+
+    def account_tables
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }
+    end
+
+    def delete_storage_totals(owner_ids)
+      Storage::Total.where(owner_id: owner_ids).delete_all
+    end
+
+    def storage_owner_ids
+      [ id, *Board.where(account_id: id).pluck(:id), *Card.where(account_id: id).pluck(:id) ]
+    end
+
+    def delete_filter_joins(filter_ids)
+      return if filter_ids.empty?
+
+      quoted_filter_ids = filter_ids.map { |filter_id| quote_uuid(filter_id) }
+
+      FILTER_JOIN_TABLES.each do |table|
+        connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{quoted_filter_ids.join(',')})")
+      end
+    end
+
+    def filter_ids_to_delete
+      Filter.where(account_id: id).pluck(:id)
+    end
+
+    def delete_search_index(search_record_ids)
+      return if search_record_ids.empty?
+
+      connection.delete("DELETE FROM search_records_fts WHERE rowid IN (#{search_record_ids.join(',')})")
+    end
+
+    def search_record_ids_to_delete
+      if sqlite_search_index?
+        Search::Record.where(account_id: id).pluck(:id)
+      else
+        []
+      end
+    end
+
+    def sqlite_search_index?
+      connection.adapter_name == "SQLite" &&
+        connection.select_value("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'search_records_fts'").present?
+    end
+
+    def delete_attachment_files(blob_files)
+      blob_files.each do |service_name, key|
+        service = service_name ? ActiveStorage::Blob.services.fetch(service_name) : ActiveStorage::Blob.service
+        service.delete(key)
+      rescue => error
+        Rails.logger.warn "Unable to delete Active Storage file #{service_name}/#{key}: #{error.message}"
+      end
+    end
+
+    def attachment_files
+      ActiveStorage::Blob.where(account_id: id).pluck(:service_name, :key)
+    end
+
+    def quoted_id
+      @quoted_id ||= quote_uuid(id)
+    end
+
+    def quote_uuid(value)
+      connection.quote(ActiveRecord::Type::Uuid.new.serialize(value))
+    end
 end
