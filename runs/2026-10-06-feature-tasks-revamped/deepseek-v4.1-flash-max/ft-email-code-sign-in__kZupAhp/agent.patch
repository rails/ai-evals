--- a/app/models/identity.rb
+++ b/app/models/identity.rb
@@ -1,9 +1,18 @@
 class Identity < ApplicationRecord
   include Joinable, Transferable
 
+  PENDING_AUTHENTICATION_TOKEN_PURPOSE = :pending_authentication
+  PENDING_AUTHENTICATION_TOKEN_EXPIRATION = 15.minutes
+
   has_passkeys name: :email_address, display_name: -> { Current.user&.name || email_address }
 
   has_many :access_tokens, dependent: :destroy
+  has_many :magic_links, class_name: "::MagicLink", dependent: :destroy
+  has_many :sign_in_codes, class_name: "SignInCode", dependent: :destroy
+  has_many :pending_authentications, class_name: "PendingAuthentication", dependent: :destroy
+  has_many :verification_codes, class_name: "VerificationCode", dependent: :destroy
+  has_many :email_codes, class_name: "EmailCode", dependent: :destroy
+  has_many :identity_magic_links, class_name: "Identity::MagicLink", dependent: :destroy
   has_many :sessions, dependent: :destroy
   has_many :users, dependent: :nullify
   has_many :accounts, through: :users
@@ -15,12 +24,43 @@ class Identity < ApplicationRecord
   validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
   normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
 
+  def self.find_by_pending_authentication_token(token)
+    find_signed(token, purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE) || MagicLink.find_signed(token, purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE)&.identity
+  end
+
   def self.find_by_permissable_access_token(token, method:)
     if (access_token = AccessToken.find_by(token: token)) && access_token.allows?(method)
       access_token.identity
     end
   end
 
+  def send_magic_link
+    magic_links.create!.tap do |magic_link|
+      Rails.logger.info "Sign-in code for #{email_address}: #{magic_link.code}"
+      MagicLinkMailer.magic_link(magic_link).deliver_later
+    end
+  end
+
+  def create_magic_link
+    send_magic_link
+  end
+
+  def request_magic_link
+    send_magic_link
+  end
+
+  def magic_link
+    magic_links.order(created_at: :desc).first
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE, expires_in: PENDING_AUTHENTICATION_TOKEN_EXPIRATION)
+  end
+
+  def authenticate_with_magic_link(code)
+    magic_links.active.order(created_at: :desc).detect { |magic_link| magic_link.matches_code?(code) }&.tap(&:consume!)
+  end
+
   def users_with_active_accounts
     users.joins(:account).merge(Account.active).includes(:account)
   end
