--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,107 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_magic_link(identity)
+      identity.send_magic_link.tap do
+        set_pending_authentication_cookie identity.pending_authentication_token
+      end
+    end
+
+    def pending_authentication_token_for(identity)
+      identity.pending_authentication_token
+    end
+
+    def complete_magic_link_authentication(code = code_param)
+      if magic_link = MagicLink.authenticate(pending_authentication_token, code)
+        magic_link.consume!
+        clear_pending_authentication_cookie
+
+        identity = magic_link.identity
+        start_new_session_for identity
+
+        after_magic_link_authentication identity
+      else
+        invalid_magic_link_code
+      end
+    end
+
+    def code_param
+      params[:code].presence || params.dig(:magic_link, :code).presence || params.dig(:session, :code).presence || params.dig(:signup, :code).presence
+    end
+
+    def code_submitted?
+      params.key?(:code) || code_param.present? || nested_code_submitted?
+    end
+
+    def nested_code_submitted?
+      [ params.dig(:magic_link), params.dig(:session), params.dig(:signup) ].any? { |attributes| attributes.respond_to?(:key?) && attributes.key?(:code) }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token].presence || params[:pending_authentication_token].presence
+    end
+
+    def set_pending_authentication_cookie(token)
+      cookies[:pending_authentication_token] = {
+        value: token,
+        expires: MagicLink::EXPIRATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def clear_pending_authentication_cookie
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def after_magic_link_authentication(identity)
+      if join_code_id = session.delete(:pending_join_code_id)
+        complete_pending_join identity, join_code_id
+      elsif session.delete(:pending_signup) || (identity.users.none? && Account.accepting_signups?)
+        redirect_to_signup_completion
+      else
+        redirect_after_sign_in
+      end
+    end
+
+    def complete_pending_join(identity, join_code_id)
+      join_code = Account::JoinCode.find_by(id: join_code_id)
+
+      if join_code&.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by(account: join_code.account, identity: identity)
+
+        if user&.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That join code is no longer valid."
+      end
+    end
+
+    def redirect_to_signup_completion
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def redirect_after_sign_in
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_magic_link_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
