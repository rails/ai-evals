@@ -0,0 +1,34 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_address %>
+    <p class="margin-none">We just sent an email to <strong><%= @email_address %></strong> with a six-character sign-in code.</p>
+    <p class="margin-none">Enter the code below to sign in. It expires in 15 minutes.</p>
+  <% else %>
+    <p class="margin-none">Enter the six-character code we emailed you. It expires in 15 minutes.</p>
+  <% end %>
+
+  <% if @code %>
+    <p class="txt-small txt-subtle margin-none">Psst, here's your code: <strong><%= @code %></strong></p>
+  <% end %>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <span class="for-screen-reader">Code</span>
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", inputmode: "text", placeholder: "Enter your code…", maxlength: 6, aria: { label: "Code" } %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
