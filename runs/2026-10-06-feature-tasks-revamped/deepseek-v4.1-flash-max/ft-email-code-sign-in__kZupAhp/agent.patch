diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..01b4ddb
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,87 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  EXPIRY = EXPIRATION
+  CODE_EXPIRATION = EXPIRATION
+  VALIDITY = EXPIRATION
+
+  PENDING_AUTHENTICATION_TOKEN_PURPOSE = Identity::PENDING_AUTHENTICATION_TOKEN_PURPOSE
+  PENDING_AUTHENTICATION_TOKEN_EXPIRATION = Identity::PENDING_AUTHENTICATION_TOKEN_EXPIRATION
+
+  belongs_to :identity
+
+  validates :code, presence: true
+
+  scope :active, -> {
+    now = Time.current
+    where(used_at: nil)
+      .where("expires_at > :now OR (expires_at IS NULL AND created_at > :expiration)", now: now, expiration: EXPIRATION.ago)
+  }
+
+  scope :expired, -> {
+    now = Time.current
+    where("expires_at <= :now OR (expires_at IS NULL AND created_at <= :expiration)", now: now, expiration: EXPIRATION.ago)
+  }
+
+  scope :used, -> { where.not(used_at: nil) }
+  scope :unused, -> { where(used_at: nil) }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+
+  class << self
+    def authenticate(token, code)
+      if magic_link = find_signed(token, purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE)
+        magic_link if magic_link.active? && magic_link.matches_code?(code)
+      elsif identity = Identity.find_by_pending_authentication_token(token)
+        identity.magic_links.active.detect { |magic_link| magic_link.matches_code?(code) }
+      end
+    end
+
+    def find_by_active_code(code)
+      active.detect { |magic_link| magic_link.matches_code?(code) }
+    end
+
+    def find_by_pending_authentication_token(token)
+      find_signed(token, purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE) ||
+        Identity.find_by_pending_authentication_token(token)&.magic_links&.active&.order(created_at: :desc)&.first
+    end
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE, expires_in: EXPIRATION)
+  end
+
+  alias_method :token, :pending_authentication_token
+
+  def matches_code?(candidate)
+    code.to_s.casecmp?(candidate.to_s.strip)
+  end
+
+  def active?
+    !used? && !expired?
+  end
+
+  def used?
+    used_at.present?
+  end
+
+  def expired?
+    if expires_at.present?
+      expires_at <= Time.current
+    else
+      created_at.present? && created_at <= EXPIRATION.ago
+    end
+  end
+
+  def consume!
+    update!(used_at: Time.current)
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+end
