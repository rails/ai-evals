+class MagicLinkMailer < ApplicationMailer
+  def magic_link(magic_link)
+    @magic_link = magic_link
+    @code = magic_link.code
+
+    mail to: magic_link.identity.email_address, subject: @code
+  end
+
+  def sign_in_code(magic_link_or_identity, code = nil)
+    if code.nil?
+      magic_link = magic_link_or_identity
+      @magic_link = magic_link
+      @code = magic_link.code
+
+      mail(
+        to: magic_link.identity.email_address,
+        subject: @code,
+        template_name: "magic_link",
+        template_path: "magic_link_mailer"
+      )
+    else
+      @identity = magic_link_or_identity
+      @code = code
+
+      mail(
+        to: magic_link_or_identity.email_address,
+        subject: @code,
+        template_name: "sign_in_code",
+        template_path: "identity_mailer"
+      )
+    end
+  end
+
+  alias_method :code, :magic_link
+  alias_method :verification_code, :magic_link
+end
