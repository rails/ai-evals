diff --git a/test/controllers/email_code_authentication_test.rb b/test/controllers/email_code_authentication_test.rb
new file mode 100644
index 0000000..f33e386
--- /dev/null
+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,308 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "code entry page renders" do
+    untenanted do
+      get new_session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "code entry page renders from the magic link path" do
+    untenanted do
+      get session_magic_link_path
+    end
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "sign in request emails a six-character code and redirects to code screen" do
+    assert_emails 1 do
+      untenanted do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert cookies[:pending_authentication_token].present?
+
+    magic_link = MagicLink.last
+    assert_equal @identity, magic_link.identity
+    assert_match(/\A[A-Z0-9]{6}\z/, magic_link.code)
+    assert_includes ActionMailer::Base.deliveries.last.subject, magic_link.code
+  end
+
+  test "sign in with a valid code" do
+    request_sign_in_code @identity
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: MagicLink.last.code }
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "sign in with an invalid code" do
+    request_sign_in_code @identity
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: "WRONG1" }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "sign in with an expired code" do
+    request_sign_in_code @identity
+
+    travel 16.minutes do
+      untenanted do
+        post session_magic_link_path(script_name: nil), params: { code: MagicLink.last.code }
+      end
+
+      assert_redirected_to new_session_magic_link_path(script_name: nil)
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "code can be submitted on the session path" do
+    request_sign_in_code @identity
+
+    untenanted do
+      post session_path(script_name: nil), params: { code: MagicLink.last.code }
+    end
+
+    assert_redirected_to landing_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "code can be submitted on the signup path" do
+    assert_emails 1 do
+      untenanted do
+        post signup_path(script_name: nil), params: { signup: { email_address: "signup-path@example.com" } }
+      end
+    end
+
+    identity = Identity.find_by!(email_address: "signup-path@example.com")
+
+    untenanted do
+      post signup_path(script_name: nil), params: { code: identity.magic_links.last.code }
+    end
+
+    assert_redirected_to new_signup_completion_path(script_name: nil)
+    assert cookies[:session_token].present?
+  end
+
+  test "code can be submitted on the join path" do
+    join_code = account_join_codes(:"37s")
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: accounts("37s").slug),
+        params: { email_address: "join-path@example.com" }
+    end
+
+    identity = Identity.find_by!(email_address: "join-path@example.com")
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: accounts("37s").slug),
+        params: { code: identity.magic_links.last.code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: accounts("37s").slug)
+  end
+
+  test "sign in via JSON" do
+    assert_emails 1 do
+      untenanted do
+        post session_path(format: :json), params: { email_address: @identity.email_address }
+      end
+    end
+
+    assert_response :created
+    assert @response.parsed_body["pending_authentication_token"].present?
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: MagicLink.last.code }
+    end
+
+    assert_response :success
+    assert @response.parsed_body["session_token"].present?
+  end
+
+  test "sign in via JSON with an invalid code" do
+    request_sign_in_code @identity
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "invalid email is rejected when signups are enabled" do
+    without_action_dispatch_exception_handling do
+      assert_no_emails do
+        assert_no_difference -> { Identity.count } do
+          untenanted do
+            post session_path, params: { email_address: "not-an-email" }
+          end
+        end
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "signup sends a code and completes after entering it" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_emails 1 do
+        untenanted do
+          post signup_path, params: { signup: { email_address: "new-person@example.com" } }
+        end
+      end
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    identity = Identity.find_by!(email_address: "new-person@example.com")
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: identity.magic_links.last.code }
+    end
+
+    assert_redirected_to new_signup_completion_path(script_name: nil)
+    assert cookies[:session_token].present?
+
+    assert_difference -> { Account.count }, 1 do
+      untenanted do
+        post signup_completion_path(script_name: nil), params: { signup: { full_name: "New Person" } }
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: identity.users.last.account.slug)
+  end
+
+  test "joining with a join code sends a code and joins after entering it" do
+    join_code = account_join_codes(:"37s")
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: accounts("37s").slug),
+        params: { email_address: "joiner@example.com" }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    identity = Identity.find_by!(email_address: "joiner@example.com")
+
+    assert_difference -> { User.count }, 1 do
+      untenanted do
+        post session_magic_link_path(script_name: nil), params: { code: identity.magic_links.last.code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: accounts("37s").slug)
+    assert identity.users.exists?(account: accounts("37s"))
+  end
+
+  test "used code cannot be used again" do
+    request_sign_in_code @identity
+    code = MagicLink.last.code
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert cookies[:session_token].present?
+
+    sign_out
+
+    untenanted do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to new_session_magic_link_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  private
+    def request_sign_in_code(identity)
+      untenanted do
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+end
+
+class EmailCodeApiEdgeCasesTest < ActionDispatch::IntegrationTest
+  test "submitting a code without a pending token is unauthorized" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "submitting an invalid pending token is unauthorized" do
+    untenanted do
+      cookies[:pending_authentication_token] = "not-a-real-token"
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "email request with a blank email is rejected" do
