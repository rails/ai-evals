diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..34dc605
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,42 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide shadow center search">
+  <%= form_with url: search_path, method: :get, class: "search__form margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width",
+          autofocus: true, autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if @query.present? %>
+    <%= turbo_frame_tag :search_results do %>
+      <% if @cards.any? %>
+        <ul id="search-results" class="search-results flex flex-column gap margin-none-block-start unpad txt-align-start">
+          <% @cards.each do |card| %>
+            <li class="search-result">
+              <article class="card">
+                <h2 class="card__title search-result__title">
+                  <%= link_to search_highlight(card.title, @terms), card_path(card), class: "card__title-link", data: { turbo_frame: "_top" } %>
+                </h2>
+
+                <% if excerpt = search_result_excerpt(card, @terms) %>
+                  <p class="search-result__excerpt"><%= search_highlight(excerpt, @terms) %></p>
+                <% end %>
+
+                <div class="card__board search-result__board txt-small translucent">
+                  <span class="card__board-name overflow-ellipsis"><%= card.board.name %></span>
+                </div>
+              </article>
+            </li>
+          <% end %>
+        </ul>
+      <% else %>
+        <div id="search-results" class="blank-slate">No cards found for “<%= @query %>”</div>
+      <% end %>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Search for cards by title, description, or comment.</div>
+  <% end %>
+</section>
