diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..6310233
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,32 @@
+module SearchesHelper
+  def search_highlight(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  def search_result_excerpt(card, terms)
+    if description = card.description.presence
+      if matching_text?(description.to_plain_text, terms)
+        return excerpt(description.to_plain_text, matching_term(description.to_plain_text, terms), radius: 120)
+      end
+    end
+
+    if comment = matching_comment(card, terms)
+      excerpt(comment.body.to_plain_text, matching_term(comment.body.to_plain_text, terms), radius: 120)
+    elsif card.description.present?
+      format_excerpt(card.description)
+    end
+  end
+
+  private
+    def matching_comment(card, terms)
+      card.comments.includes(:rich_text_body).detect { |comment| matching_text?(comment.body.to_plain_text, terms) }
+    end
+
+    def matching_text?(text, terms)
+      terms.any? { |term| text.downcase.include?(term.downcase) }
+    end
+
+    def matching_term(text, terms)
+      terms.find { |term| text.downcase.include?(term.downcase) }
+    end
+end
