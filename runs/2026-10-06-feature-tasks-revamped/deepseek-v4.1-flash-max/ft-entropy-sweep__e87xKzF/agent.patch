-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    # Materializes the due card ids in a single query, then postpones them in batches.
+    #
+    # Running `find_each` directly over `due_to_be_postponed` re-evaluates the
+    # expensive entropy joins once per batch. On SQLite with six-figure card
+    # counts, that turns a single scan into many, and the hourly sweep overruns
+    # its hour. Fetching the ids first bounds the expensive query to one run.
+    #
+    # Small sweeps are postponed inline so that they are immediate. Large ones
+    # are handed to Card::AutoPostponeJob so that a single sweep never monopolizes
+    # a worker for an hour.
+    def auto_postpone_all_due(inline: nil, limit: nil, batch_size: POSTPONE_BATCH_SIZE)
+      due_card_ids = due_to_be_postponed.limit(limit).ids
+      inline = due_card_ids.size <= INLINE_POSTPONE_LIMIT if inline.nil?
+
+      due_card_ids.each_slice(batch_size) do |card_ids|
+        cards = Card.where(id: card_ids).to_a
+        cards.each { |card| card.auto_postpone(user: card.account.system_user) } if inline
+        ActiveJob.perform_all_later(cards.collect { |card| Card::AutoPostponeJob.new(card) })
       end
     end
   end
 
+  def due_to_be_postponed?
+    if active? && last_active_at
+      period = board.auto_postpone_period
+      period.present? && last_active_at <= period.seconds.ago
+    else
+      false
+    end
+  end
+
   def entropy
     Card::Entropy.for(self)
   end
