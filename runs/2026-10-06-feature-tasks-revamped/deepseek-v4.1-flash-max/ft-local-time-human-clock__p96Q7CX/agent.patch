diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..809c37f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,49 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatDate,
+  formatDateTime,
+  formatFullDateTime,
+  formatTime,
+  formatTimeAgo,
+  formatWeekday,
+  parseTimeValue
+} from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.#render()
+    this.datetimeObserver = new MutationObserver(() => this.#render())
+    this.datetimeObserver.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    this.datetimeObserver?.disconnect()
+  }
+
+  #render() {
+    const date = parseTimeValue(this.element.getAttribute("datetime"))
+    if (!date) return
+
+    this.element.textContent = this.#formattedValue(date)
+    this.element.title = formatFullDateTime(date)
+  }
+
+  #formattedValue(date) {
+    switch (this.formatValue) {
+      case "date":
+        return formatDate(date)
+      case "date_with_year":
+        return formatDate(date, { includeYear: true })
+      case "time":
+        return formatTime(date)
+      case "datetime":
+        return formatDateTime(date)
+      case "weekday":
+        return formatWeekday(date)
+      default:
+        return formatTimeAgo(date)
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..b840c08 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,76 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+const timeFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const monthDayFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const monthDayYearFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const weekdayFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const numericDateTimeFormatter = new Intl.DateTimeFormat("en-US", {
+  year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+})
+const fullDateTimeFormatter = new Intl.DateTimeFormat("en-US", {
+  weekday: "long", month: "long", day: "numeric", hour: "numeric", minute: "2-digit"
+})
+
+// Date-only values must not be shifted by timezone conversion, so build them
+// from their parts instead of passing them to `new Date(string)`.
+export function parseTimeValue(value) {
+  if (!value) return null
+
+  const dateOnly = value.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+  if (dateOnly) {
+    const [ , year, month, day ] = dateOnly
+    return new Date(parseInt(year), parseInt(month) - 1, parseInt(day))
+  }
+
+  const date = new Date(value)
+  return isNaN(date) ? null : date
+}
+
+export function formatTime(date) {
+  return normalizeSpaces(timeFormatter.format(date))
+}
+
+export function formatDate(date, { includeYear = false } = {}) {
+  const formatter = includeYear ? monthDayYearFormatter : monthDayFormatter
+
+  return normalizeSpaces(formatter.format(date))
+}
+
+export function formatWeekday(date) {
+  return normalizeSpaces(weekdayFormatter.format(date))
+}
+
+export function formatDateTime(date) {
+  return normalizeSpaces(numericDateTimeFormatter.format(date))
+}
+
+export function formatFullDateTime(date) {
+  return normalizeSpaces(fullDateTimeFormatter.format(date))
+}
+
+// Today shows the local clock time, yesterday/tomorrow and the surrounding days
+// read as relative words, and anything further out becomes a short date.
+export function formatTimeAgo(date, now = new Date()) {
+  const days = localDaysBetween(now, date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (Math.abs(days) < 7) {
+    return relativeTimeFormatter.format(days, "day")
+  } else {
+    return formatDate(date)
+  }
+}
+
+function localDaysBetween(fromDate, toDate) {
+  const from = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const to = new Date(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((to - from) / (1000 * 60 * 60 * 24))
+}
+
+function normalizeSpaces(string) {
+  return string.replace(/\u202f/g, " ")
+}
