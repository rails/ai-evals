@@ -0,0 +1,13 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    notification.push
+  rescue StandardError => error
+    # Push notifications are best-effort: a push service outage, an expired
+    # subscription, or missing VAPID configuration must not break the job.
+    raise if Push::Subscription.enabled?
+
+    Rails.logger.warn("Skipping push notification: #{error.class}: #{error.message}")
+  end
+end
