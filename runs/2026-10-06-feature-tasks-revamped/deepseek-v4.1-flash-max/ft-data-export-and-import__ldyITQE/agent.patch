+require "test_helper"
+
+class AccountDataTransferMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "export ready includes a download link that expires" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+
+    email = AccountMailer.export_ready(export)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "export is ready", email.subject
+    assert_match %r{/rails/active_storage/blobs/redirect/}, email.body.encoded
+    assert_match "expire in 24 hours", email.body.encoded
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "import completed includes a link to the new account" do
+    imported_account = Account.create!(name: "Imported account")
+    import = Import.new(account: @account, user: @user, imported_account: imported_account, status: :completed)
+    import.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+    import.save!
+
+    email = AccountMailer.import_completed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "Imported account", email.body.encoded
+    assert_match imported_account.slug, email.body.encoded
+  end
+
+  test "import failed includes the reason" do
+    import = Import.new(account: @account, user: @user, status: :failed, error: "broken zip")
+    import.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+    import.save!
+
+    email = AccountMailer.import_failed(import)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "broken zip", email.body.encoded
+    assert_match "nothing was created", email.body.encoded
+  end
+end
