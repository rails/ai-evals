+require "test_helper"
+
+class Account::DataTransfer::CardsExporterTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @account = accounts(:"37s")
+    Current.user = users(:kevin)
+  end
+
+  test "exports files embedded in comments" do
+    comment = comments(:logo_agreement_jz)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded"), filename: "notes.txt", content_type: "text/plain")
+    comment.update!(body: "Attached: #{ActionText::Attachment.from_attachable(blob).to_html}")
+
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    export.perform
+
+    ZipFile::Reader.open(export.file) do |zip|
+      path = zip.glob("cards/*.json").find { |p| JSON.parse(zip.read(p))["id"] == cards(:logo).id }
+      card_json = JSON.parse(zip.read(path))
+      attachment = card_json["attachments"].find { |a| a["filename"] == "notes.txt" }
+
+      assert_not_nil attachment
+      assert zip.exists?(attachment["path"])
+      assert_equal "embedded", zip.read(attachment["path"])
+    end
+  end
+
+  test "exports only cards the user can see" do
+    hidden_card = boards(:private).cards.create!(
+      title: "Secret",
+      creator: users(:kevin),
+      status: :published,
+      last_active_at: Time.current
+    )
+
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    export.perform
+
+    ZipFile::Reader.open(export.file) do |zip|
+      paths = zip.glob("cards/*.json")
+      titles = paths.map { |path| JSON.parse(zip.read(path))["title"] }
+
+      assert_includes titles, cards(:logo).title
+      assert_not_includes titles, hidden_card.title
+    end
+  end
+
+  test "exports card comments and files" do
+    cards(:logo).image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: @account, user: @user, kind: :cards)
+    export.perform
+
+    ZipFile::Reader.open(export.file) do |zip|
+      path = zip.glob("cards/*.json").find { |p| JSON.parse(zip.read(p))["id"] == cards(:logo).id }
+      card_json = JSON.parse(zip.read(path))
+
+      assert_equal cards(:logo).title, card_json["title"]
+      assert_equal cards(:logo).comments.count, card_json["comments"].size
+      assert card_json["comments"].any? { |comment| comment["body_html"].include?("I agree") }
+
+      assert_equal 1, zip.glob("files/*").size
+      attachment = card_json["attachments"].first
+      assert_equal "moon.jpg", attachment["filename"]
+      assert zip.exists?(attachment["path"])
+      assert_equal File.binread(file_fixture("moon.jpg")), zip.read(attachment["path"])
+    end
+  end
+end
