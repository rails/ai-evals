diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..0c0f1f4 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -8,4 +8,81 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def import_attributes(attributes, id_map)
+      old_id = attributes["id"]
+      body = attributes["body"]
+      mapped = super
+
+      mapped["body"] = rewrite_body(body, old_id, id_map) if body.present?
+      mapped
+    end
+
+    # Rewrites the signed global IDs embedded in the rich text body so that they
+    # point at the newly imported blobs. The old sgids are not portable between
+    # instances (they are signed with the source instance's secret), so we match
+    # attachment nodes against the embeds exported alongside the rich text.
+    def rewrite_body(body, old_rich_text_id, id_map)
+      blobs = embedded_blobs(old_rich_text_id, id_map)
+      return body if blobs.empty?
+
+      content = ::ActionText::Content.new(body, canonicalize: false)
+      available_blobs = blobs.dup
+
+      content.fragment.find_all(::ActionText::Attachment.tag_name).each do |node|
+        next if node["sgid"].blank?
+
+        blob = matching_blob(node, available_blobs) || available_blobs.first
+        next unless blob
+
+        available_blobs.delete(blob)
+        node["sgid"] = blob.attachable_sgid
+        node["url"] = rich_text_url_for(blob) if node["url"].present?
+      end
+
+      content.fragment.to_html
+    end
+
+    def embedded_blobs(old_rich_text_id, id_map)
+      embedded_blob_ids_for(old_rich_text_id).filter_map do |blob_id|
+        new_blob_id = id_map[blob_id]
+        ::ActiveStorage::Blob.find_by(id: new_blob_id) if new_blob_id
+      end
+    end
+
+    def embedded_blob_ids_for(rich_text_id)
+      embedded_blob_ids.fetch(rich_text_id, [])
+    end
+
+    def embedded_blob_ids
+      @embedded_blob_ids ||= begin
+        map = Hash.new { |hash, key| hash[key] = [] }
+
+        zip.glob("active_storage_attachments/*.json").each do |path|
+          attributes = JSON.parse(zip.read(path))
+
+          next unless attributes["record_type"] == "ActionText::RichText"
+          next unless attributes["name"] == "embeds"
+
+          map[attributes["record_id"]] << attributes["blob_id"]
+        end
+
+        map
+      end
+    end
+
+    def matching_blob(node, blobs)
+      filename = node["filename"]
+      content_type = node["content-type"]
+
+      blobs.find do |blob|
+        blob.filename.to_s == filename &&
+          (content_type.blank? || blob.content_type == content_type)
+      end
+    end
+
+    def rich_text_url_for(blob)
+      blob.to_rich_text_attributes[:url]
+    rescue StandardError
+      nil
+    end
 end
