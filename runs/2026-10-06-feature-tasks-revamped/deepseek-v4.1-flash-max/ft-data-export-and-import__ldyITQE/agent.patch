@@ -0,0 +1,13 @@
+class Account::ExportJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    export.processing!
+    export.perform
+    export.update!(status: :completed, completed_at: Time.current)
+    AccountMailer.export_ready(export).deliver_later
+  rescue => error
+    export.update!(status: :failed, error: error.message)
+    AccountMailer.export_failed(export).deliver_later
+  end
+end
