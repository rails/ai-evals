+    imported_user = imported_account.users.find_by(identity_id: users(:david).identity_id)
+    assert imported_user.avatar.attached?
+    assert_equal "moon.jpg", imported_user.avatar.filename.to_s
+    assert_equal File.binread(file_fixture("moon.jpg")), imported_user.avatar.download
+  end
+
+  test "imports board description embeds" do
+    board = boards(:writebook)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("board embed"), filename: "board.txt", content_type: "text/plain")
+    board.update!(public_description: "<p>About</p>#{ActionText::Attachment.from_attachable(blob).to_html}")
