+  test "imports multiple rich text embeds" do
+    card = cards(:logo)
+    first = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("first"), filename: "first.txt", content_type: "text/plain")
+    second = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("second"), filename: "second.txt", content_type: "text/plain")
+    html = [ first, second ].map { |b| ActionText::Attachment.from_attachable(b).to_html }.join
+    card.update!(description: "<p>Both:</p>#{html}")
