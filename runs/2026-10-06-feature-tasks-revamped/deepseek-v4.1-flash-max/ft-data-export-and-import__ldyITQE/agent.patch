+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  attr_reader :io
+
+  class EntryNotFound < StandardError; end
+
+  class << self
+    def open(source)
+      raise ArgumentError, "No block given" unless block_given?
+
+      if remote_io = remote_io_for(source)
+        yield new(remote_io)
+      elsif source.respond_to?(:open) && !source.is_a?(IO)
+        source.open { |io| yield new(io) }
+      elsif source.respond_to?(:read)
+        yield new(source)
+      else
+        File.open(source.to_s, "rb") { |io| yield new(io) }
+      end
+    end
+
+    private
+      def remote_io_for(source)
+        return unless source.respond_to?(:blob)
+
+        blob = source.blob
+        return unless blob&.service
+        return unless s3_service?(blob.service)
+
+        url = blob.service.url(blob.key, expires_in: 1.hour, filename: blob.filename, disposition: :inline)
+        ZipKit::RemoteIO.new(url)
+      end
+
+      def s3_service?(service)
+        defined?(ActiveStorage::Service::S3Service) && service.is_a?(ActiveStorage::Service::S3Service)
+      end
+  end
+
+  def initialize(io)
+    @io = io
+    @entries = nil
+  end
+
+  def entries
+    @entries ||= ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: true)
+  end
+
+  def filenames
+    entries.map(&:filename)
+  end
+  alias_method :files, :filenames
+
+  def each_entry
+    return enum_for(:each_entry) unless block_given?
+
+    entries.each { |entry| yield entry }
+  end
+
+  def glob(pattern)
+    filenames.select { |filename| File.fnmatch(pattern, filename) }.sort
+  end
+
+  def exists?(path)
+    entries.any? { |entry| entry.filename == path }
+  end
+
+  def read(path)
+    entry = find_entry!(path)
+    entry.extractor_from(io).extract.to_s
+  end
+
+  alias_method :read_entry, :read
+
+  def extract_to(path, destination)
+    entry = find_entry!(path)
+    extractor = entry.extractor_from(io)
+    destination.binmode if destination.respond_to?(:binmode)
+
+    until extractor.eof?
+      chunk = extractor.extract(CHUNK_SIZE)
+      destination.write(chunk) if chunk.present?
+    end
+
+    destination
+  end
+
+  def close
+    io.close if io.respond_to?(:close) && !io.closed?
+  end
+
+  private
+    def find_entry!(path)
+      entries.find { |entry| entry.filename == path } ||
+        raise(EntryNotFound, "No entry found for #{path}")
+    end
+end
