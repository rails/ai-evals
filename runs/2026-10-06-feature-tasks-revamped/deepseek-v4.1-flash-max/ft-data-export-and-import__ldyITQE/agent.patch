+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,15 @@
+class Account::ImportJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    import.processing!
+
+    account = import.perform
+
+    import.update!(status: :completed, imported_account: account, completed_at: Time.current)
+    AccountMailer.import_completed(import).deliver_later
+  rescue => error
+    import.update!(status: :failed, error: error.message, imported_account: nil)
+    AccountMailer.import_failed(import).deliver_later
+  end
+end
