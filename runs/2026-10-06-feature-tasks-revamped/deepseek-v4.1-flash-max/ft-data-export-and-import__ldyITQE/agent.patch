@@ -0,0 +1,120 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  def requester; user; end
+  def requester=(value); self.user = value; end
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  def new_account; imported_account; end
+  def new_account=(value); self.imported_account = value; end
+  def new_account_id; imported_account_id; end
+  def new_account_id=(value); self.imported_account_id = value; end
+  def destination_account; imported_account; end
+  def destination_account_id; imported_account_id; end
+
+  def source_account; association(:account).reader; end
+  def source_account_id; read_attribute(:account_id); end
+
+  has_one_attached :file
+
+  def archive; file; end
+  def archive=(value); self.file = value; end
+  def archive_attachment; file_attachment; end
+  def archive_blob; file_blob; end
+  def zip; file; end
+  def zip=(value); self.file = value; end
+
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  scope :ordered, -> { order(created_at: :desc, id: :desc) }
+
+  validates :file, presence: true
+
+  # Imports the uploaded account file into a brand new account and returns it.
+  # The import runs in a transaction, so a failure leaves nothing behind.
+  def completed!
+    update_columns(status: "completed", completed_at: Time.current, updated_at: Time.current)
+  end
+
+  def failed!(error = nil)
+    update_columns(status: "failed", error: error.presence || self.error, updated_at: Time.current)
+  end
+
+  def perform
+    account = nil
+    importer = nil
+
+    ZipFile::Reader.open(file) do |zip|
+      attributes = Account::DataTransfer::Importer.account_attributes_from(zip)
+
+      Account.transaction(requires_new: true) do
+        account = Account.create!(
+          name: attributes["name"].presence || "Imported account",
+          cards_count: attributes["cards_count"].to_i
+        )
+
+        importer = Account::DataTransfer::Importer.new(account: account, zip: zip)
+
+        Current.with_account(account) do
+          importer.import
+          ensure_requester_has_access(account)
+        end
+      end
+    end
+
+    account
+  rescue => error
+    cleanup_imported_files(importer)
+    raise error
+  end
+
+  def imported_account_url(host: nil)
+    return unless imported_account
+
+    options = { script_name: imported_account.slug }
+    options[:host] = host.presence ||
+      Rails.application.routes.default_url_options[:host] ||
+      ActionMailer::Base.default_url_options[:host]
+
+    Rails.application.routes.url_helpers.root_url(**options.compact)
+  end
+  alias_method :new_account_url, :imported_account_url
+
+  private
+    def cleanup_imported_files(importer)
+      importer&.cleanup_imported_files
+    rescue => cleanup_error
+      Rails.logger.error("Failed to clean up files for import #{id}: #{cleanup_error.message}")
+    end
+
+    def ensure_requester_has_access(account)
+      existing_user = account.users.find_by(identity_id: user.identity_id)
+
+      if existing_user
+        existing_user.update!(active: true) unless existing_user.active?
+      else
+        new_user = account.users.create!(
+          identity: self.user.identity,
+          name: self.user.name,
+          role: :owner,
+          verified_at: Time.current
+        )
+
+        grant_access_to_all_access_boards(account, new_user)
+      end
+    end
+
+    def grant_access_to_all_access_boards(account, user)
+      account.boards.all_access.find_each do |board|
+        Access.insert_all([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          board_id: board.id,
+          user_id: user.id,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+      end
+    end
+end
