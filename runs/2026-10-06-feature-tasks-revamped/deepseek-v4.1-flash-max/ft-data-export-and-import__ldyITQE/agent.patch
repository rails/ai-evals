diff --git a/app/models/account/data_transfer/cards_exporter.rb b/app/models/account/data_transfer/cards_exporter.rb
new file mode 100644
index 0000000..fc9b9b2
--- /dev/null
+++ b/app/models/account/data_transfer/cards_exporter.rb
@@ -0,0 +1,122 @@
+class Account::DataTransfer::CardsExporter
+  attr_reader :user, :zip
+
+  def initialize(user, zip = nil)
+    @user = user
+    @zip = zip
+  end
+
+  def export_to(zip = @zip)
+    raise ArgumentError, "No zip given" unless zip
+
+    exported_blob_ids = Set.new
+
+    each_card do |card|
+      zip.add_file(card_path(card), card_attributes(card).to_json)
+      export_attachments(zip, card, exported_blob_ids)
+    end
+  end
+  alias_method :export, :export_to
+  alias_method :write_to, :export_to
+
+  class << self
+    def export_to(user, zip)
+      new(user).export_to(zip)
+    end
+    alias_method :export, :export_to
+  end
+
+  private
+    def each_card
+      user.accessible_cards.find_each { |card| yield card }
+    end
+
+    def card_path(card)
+      "cards/#{card.id}.json"
+    end
+
+    def card_attributes(card)
+      attachments = attachments_for(card).map { |attachment| attachment_attributes(attachment) }
+
+      card.attributes.merge(
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "board" => board_attributes(card.board),
+        "column" => column_attributes(card.column),
+        "creator" => user_attributes(card.creator),
+        "assignees" => card.assignees.map { |assignee| user_attributes(assignee) },
+        "tags" => card.tags.pluck(:title).sort,
+        "steps" => card.steps.map { |step| step_attributes(step) },
+        "comments" => card.comments.chronologically.map { |comment| comment_attributes(comment) },
+        "attachments" => attachments,
+        "files" => attachments
+      )
+    end
+
+    def board_attributes(board)
+      board.attributes.slice("id", "name")
+    end
+
+    def column_attributes(column)
+      return nil unless column
+
+      column.attributes.slice("id", "name", "position", "color")
+    end
+
+    def user_attributes(user)
+      user.attributes.slice("id", "name")
+    end
+
+    def step_attributes(step)
+      step.attributes.slice("id", "content", "completed")
+    end
+
+    def comment_attributes(comment)
+      comment.attributes.merge(
+        "body" => comment.body.to_plain_text,
+        "body_html" => comment.body.to_s,
+        "creator" => user_attributes(comment.creator)
+      )
+    end
+
+    def attachments_for(card)
+      attachments = []
+
+      attachments << card.image.attachment if card.image.attached?
+      attachments.concat(rich_text_attachments(card.description))
+      card.comments.each { |comment| attachments.concat(rich_text_attachments(comment.body)) }
+
+      attachments.compact.uniq { |attachment| attachment.blob_id }
+    end
+
+    def rich_text_attachments(content)
+      content.embeds.attachments.to_a
+    rescue NoMethodError
+      Array(content.attachables.grep(ActiveStorage::Blob).map(&:attachment))
+    end
+
+    def attachment_attributes(attachment)
+      blob = attachment.blob
+      {
+        "name" => attachment.name,
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "path" => file_path(blob)
+      }
+    end
+
+    def export_attachments(zip, card, exported_blob_ids)
+      attachments_for(card).each do |attachment|
+        blob = attachment.blob
+        next if exported_blob_ids.include?(blob.id)
+
+        exported_blob_ids << blob.id
+        zip.add_file(file_path(blob)) { |sink| blob.download { |chunk| sink.write(chunk) } }
+      end
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}"
+    end
+end
