+class Account::DataTransfer::Importer
+  attr_reader :account, :zip, :id_map
+
+  def initialize(*args, account: nil, zip: nil)
+    args.each do |argument|
+      case argument
+      when ZipFile::Reader
+        zip ||= argument
+      when Account
+        account ||= argument
+      else
+        zip ||= argument if argument.respond_to?(:read) || argument.respond_to?(:glob)
+      end
+    end
+
+    @account = account
+    @zip = wrap_zip(zip)
+    @id_map = {}
+    @record_sets = nil
+  end
+
+  def import(zip = nil, account = nil)
+    if zip.is_a?(Account)
+      account ||= zip
+      zip = nil
+    end
+
+    @zip = wrap_zip(zip) if zip
+    @account = account if account
+
+    record_sets.each do |record_set|
+      record_set.register_ids(self.zip, id_map)
+    end
+
+    record_sets.each do |record_set|
+      record_set.import_from(self.zip, id_map: id_map)
+    end
+
+    if account.present?
+      sync_card_counter
+      reconcile_storage
+    end
+
+    account
+  end
+
+  def import_from(zip = nil, account: nil)
+    @zip = wrap_zip(zip) if zip
+    @account = account if account
+    import
+  end
+
+  alias_method :call, :import
+
+  def import_into(account)
+    @account = account
+    import
+  end
+  alias_method :import_to, :import_into
+  alias_method :read_from, :import_from
+
+  def account_attributes
+    self.class.account_attributes_from(zip)
+  end
+
+  def account_name
+    account_attributes["name"].presence || "Imported account"
+  end
+
+  def cleanup_imported_files
+    record_sets.each(&:cleanup_imported_files)
+  end
+
+  class << self
+    def account_attributes_from(zip)
+      zip = ZipFile::Reader.new(zip) unless zip.respond_to?(:glob)
+      path = zip.glob("accounts/*.json").first
+      path ? JSON.parse(zip.read(path)) : {}
+    end
+
+    def import(zip, account:)
+      new(account: account, zip: zip).import
+    end
+  end
+
+  private
+    def wrap_zip(source)
+      return source if source.nil? || source.respond_to?(:glob)
+
+      ZipFile::Reader.new(source)
+    end
+
+    def record_sets
+      @record_sets ||= begin
+        sets = []
+        manifest.each_record_set { |record_set| sets << record_set }
+        sets
+      end
+    end
+
+    def sync_card_counter
+      max_number = account.cards.maximum(:number) || 0
+      return unless max_number > account.cards_count
+
+      account.update_columns(cards_count: max_number)
+    end
+
+    def reconcile_storage
+      account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+
+      account.reconcile_storage
+      account.materialize_storage
+    end
+
+    def manifest
+      Account::DataTransfer::Manifest.new(account)
+    end
+end
