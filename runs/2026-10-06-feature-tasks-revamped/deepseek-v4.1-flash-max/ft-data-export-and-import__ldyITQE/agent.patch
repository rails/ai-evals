+class Account::ImportsController < ApplicationController
+  wrap_parameters :import, include: %i[ file ]
+
+  before_action :set_import, only: :show
+
+  def index
+    @imports = Current.user.imports.where(account: Current.account).ordered
+  end
+
+  def new
+    @import = Current.account.imports.build(user: Current.user)
+  end
+
+  def create
+    @import = Current.account.imports.create(import_params.merge(user: Current.user))
+
+    if @import.persisted?
+      Account::ImportJob.perform_later(@import)
+      redirect_back fallback_location: account_settings_path,
+        notice: "Your account file is being imported. We'll email you when it's done."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+  end
+
+  private
+    def set_import
+      @import = Current.account.imports.find(params[:id])
+      head :forbidden unless @import.user == Current.user || Current.user.admin?
+    end
+
+    def import_params
+      if params[:import].present?
+        params.expect(import: [ :file ])
+      else
+        { file: params[:file] }
+      end
+    end
+end
