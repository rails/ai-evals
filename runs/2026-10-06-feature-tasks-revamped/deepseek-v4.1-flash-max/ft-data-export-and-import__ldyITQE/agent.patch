+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,62 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create, if: :account_export_requested?
+  before_action :set_export, only: :show
+
+  def new
+    @export = Current.account.exports.build(user: Current.user)
+  end
+
+  def index
+    @exports = Current.user.exports.where(account: Current.account).ordered
+  end
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: requested_kind)
+    Account::ExportJob.perform_later(export)
+
+    redirect_back fallback_location: export_redirect_fallback,
+      notice: "Your export is being prepared. We'll email you when it's ready."
+  end
+
+  def show
+    unless @export.user == Current.user || Current.user.admin?
+      return head :forbidden
+    end
+
+    if @export.completed? && @export.file.attached?
+      redirect_to @export.download_url(host: request.host_with_port)
+    end
+  end
+
+  private
+    def export_redirect_fallback
+      requested_kind == :cards ? user_path(Current.user) : account_settings_path
+    end
+
+    def requested_kind
+      return :cards if cards_only_param?
+
+      kind = params[:kind].presence || params.dig(:export, :kind).presence ||
+        params[:scope].presence || params.dig(:export, :scope).presence ||
+        params[:type].presence || params.dig(:export, :type).presence
+      kind.to_s == "cards" ? :cards : :account
+    end
+
+    def cards_only_param?
+      [ params[:cards_only], params.dig(:export, :cards_only) ].any? do |value|
+        ActiveModel::Type::Boolean.new.cast(value)
+      end
+    end
+
+    def account_export_requested?
+      requested_kind == :account
+    end
+
+    def ensure_admin
+      head :forbidden unless Current.user.admin?
+    end
+
+    def set_export
+      @export = Current.account.exports.find(params[:id])
+    end
+end
