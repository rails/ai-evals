@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestRoundTripTest < ActiveSupport::TestCase
+  test "every manifest record set round trips" do
+    account = accounts(:"37s")
+    user = users(:kevin)
+    boards(:writebook).create_publication!
+
+    export = Export.create!(account: account, user: user, kind: :account)
+    export.perform
+
+    imported_account = Account.create!(name: "Imported account")
+    ZipFile::Reader.open(export.file) do |zip|
+      Account::DataTransfer::Importer.new(account: imported_account, zip: zip).import
+    end
+
+    assert_equal account.name, imported_account.reload.name
+
+    source_sets = []
+    Account::DataTransfer::Manifest.new(account).each_record_set { |set| source_sets << set }
+    imported_sets = []
+    Account::DataTransfer::Manifest.new(imported_account).each_record_set { |set| imported_sets << set }
+
+    source_sets.zip(imported_sets).each do |source_set, imported_set|
+      source_count = source_set.send(:records).count
+      imported_count = imported_set.send(:records).count
+
+      assert_equal source_count, imported_count, "#{source_set.model.name} did not round trip"
+    end
+
+    source_notifications = Notification.where(account: account).map { |n| [ n.card.title, n.user.identity&.email_address ] }.sort
+    imported_notifications = Notification.where(account: imported_account).map { |n| [ n.card.title, n.user.identity&.email_address ] }.sort
+    assert_equal source_notifications, imported_notifications
+
+    source_events = Event.where(account: account).map { |e| [ e.board.name, e.creator.identity&.email_address, e.action ] }.sort
+    imported_events = Event.where(account: imported_account).map { |e| [ e.board.name, e.creator.identity&.email_address, e.action ] }.sort
+    assert_equal source_events, imported_events
+
+    source_accesses = Access.where(account: account).map { |access| [ access.board.name, access.user.identity&.email_address ] }.sort
+    imported_accesses = Access.where(account: imported_account).map { |access| [ access.board.name, access.user.identity&.email_address ] }.sort
+    assert_equal source_accesses, imported_accesses
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..a3493b4
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "perform imports an account file into a new account" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.perform
+
+    import = build_import_from(export)
+    imported_account = import.perform
+
+    assert_not_nil imported_account
+    assert imported_account.persisted?
+    assert_equal @account.name, imported_account.name
+    assert_equal @account.boards.count, imported_account.boards.count
+    assert_equal @account.cards.count, imported_account.cards.count
+    assert imported_account.users.exists?(identity_id: @user.identity_id)
+  end
+
+  test "perform adds the requester when they are not part of the exported account" do
+    Current.with_account(accounts(:initech)) do
+      export = Export.create!(account: accounts(:initech), user: users(:mike), kind: :account)
+      export.perform
+      @initech_export = export
+    end
+
+    import = build_import_from(@initech_export, user: users(:david))
+    imported_account = import.perform
+
+    imported_user = imported_account.users.find_by(identity_id: users(:david).identity_id)
+    assert_not_nil imported_user
+    assert imported_user.owner?
+    assert_equal imported_account.boards.count, imported_user.boards.count
+    assert imported_user.settings.present?
+  end
+
+  test "perform leaves nothing behind when the file can't be imported" do
+    import = build_broken_import
+
+    assert_raises(StandardError) do
+      import.perform
+    end
+
+    assert_nil import.reload.imported_account
+    assert_equal @account, import.account
+  end
+
+  test "failed import job records the error and sends an email" do
+    import = build_broken_import
+
+    assert_no_difference -> { Account.count } do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs { Account::ImportJob.perform_now(import) }
+      end
+    end
+
+    assert import.reload.failed?
+    assert import.error.present?
+    assert_nil import.imported_account
+  end
+
+  test "failure during import leaves nothing behind" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.perform
+
+    import = build_import_from(export)
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import).raises("boom")
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { ActiveStorage::Blob.count } ] do
+      Account::ImportJob.perform_now(import)
+    end
+
+    assert import.reload.failed?
+    assert_equal "boom", import.error
+    assert_nil import.imported_account
+  end
+
+  test "failure partway through import rolls back imported records" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.perform
+
+    import = build_import_from(export)
+
+    Account::DataTransfer::ActionText::RichTextRecordSet.any_instance.stubs(:import_from).raises("partial boom")
+
+    assert_no_difference [ -> { Account.count }, -> { Board.count }, -> { Card.count }, -> { ActiveStorage::Blob.count } ] do
+      Account::ImportJob.perform_now(import)
+    end
+
+    assert import.reload.failed?
+    assert_equal "partial boom", import.error
+  end
+
+  test "successful import job records the imported account and sends an email" do
+    export = Export.create!(account: @account, user: @user, kind: :account)
+    export.perform
+
+    import = build_import_from(export)
+
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs { Account::ImportJob.perform_now(import) }
+      end
+    end
+
+    import.reload
+    assert import.completed?
+    assert_not_nil import.imported_account
+    assert_equal @account.name, import.imported_account.name
+  end
+
+  private
+    def build_import_from(export, user: @user)
+      Import.new(account: @account, user: user).tap do |import|
+        import.file.attach(
+          io: StringIO.new(export.file.download),
+          filename: export.filename,
+          content_type: "application/zip"
+        )
+        import.save!
+      end
+    end
+
+    def build_broken_import
+      Import.new(account: @account, user: @user).tap do |import|
+        import.file.attach(
+          io: StringIO.new("this is not a zip"),
+          filename: "broken.zip",
+          content_type: "application/zip"
+        )
+        import.save!
+      end
+    end
+end
diff --git a/test/models/zip_file_reader_test.rb b/test/models/zip_file_reader_test.rb
new file mode 100644
index 0000000..f2ed0f3
--- /dev/null
+++ b/test/models/zip_file_reader_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  setup do
+    @tempfile = Tempfile.new([ "reader", ".zip" ])
+    @tempfile.binmode
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("nested/data.json", '{"ok":true}')
+    writer.close
+
+    @tempfile.rewind
+  end
+
+  teardown do
+    @tempfile.close
+    @tempfile.unlink
+  end
+
+  test "reads entries" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert reader.exists?("hello.txt")
+    assert_not reader.exists?("missing.txt")
+    assert_equal [ "hello.txt", "nested/data.json" ], reader.filenames
+    assert_equal [ "nested/data.json" ], reader.glob("nested/*.json")
+  end
+
+  test "reads file contents" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert_equal "Hello, World!", reader.read("hello.txt")
+    assert_equal({ "ok" => true }, JSON.parse(reader.read("nested/data.json")))
+  end
+
+  test "extracts to an IO" do
+    reader = ZipFile::Reader.new(@tempfile)
+    output = StringIO.new
+
+    reader.extract_to("hello.txt", output)
+
+    assert_equal "Hello, World!", output.string
+  end
+
+  test "raises for missing entries" do
+    reader = ZipFile::Reader.new(@tempfile)
+
+    assert_raises(ZipFile::Reader::EntryNotFound) { reader.read("missing.txt") }
+  end
+end
