+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  def requester; user; end
+  def requester=(value); self.user = value; end
+
+  has_one_attached :file
+
+  def archive; file; end
+  def archive=(value); self.file = value; end
+  def archive_attachment; file_attachment; end
+  def archive_blob; file_blob; end
+  def zip; file; end
+  def zip=(value); self.file = value; end
+
+  enum :kind, %w[account cards].index_by(&:itself), default: :account
+
+  class << self
+    def cards
+      where(kind: "cards").or(where(cards_only: true))
+    end
+
+    def account
+      where(kind: "account").where(cards_only: false)
+    end
+  end
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  scope :ordered, -> { order(created_at: :desc, id: :desc) }
+  scope :completed, -> { where(status: :completed) }
+
+  before_validation :sync_cards_only
+
+  def kind
+    if has_attribute?(:cards_only) && read_attribute(:cards_only)
+      "cards"
+    else
+      super
+    end
+  end
+
+  def cards?
+    kind.to_s == "cards"
+  end
+
+  def account?
+    !cards?
+  end
+
+  def cards_only?
+    read_attribute(:cards_only) || cards?
+  end
+
+  def cards_only
+    read_attribute(:cards_only)
+  end
+
+  def cards_only=(value)
+    value = ActiveModel::Type::Boolean.new.cast(value)
+    write_attribute(:cards_only, value)
+    write_attribute(:kind, value ? "cards" : "account")
+  end
+
+  def kind=(value)
+    super
+    write_attribute(:cards_only, read_attribute(:kind).to_s == "cards")
+  end
+
+  def filename
+    case kind
+    when "cards" then "fizzy-cards-#{user.id}.zip"
+    else "fizzy-account-#{account.external_account_id}.zip"
+    end
+  end
+  alias_method :export_filename, :filename
+
+  def completed!
+    update_columns(status: "completed", completed_at: Time.current, updated_at: Time.current)
+  end
+
+  def failed!(error = nil)
+    update_columns(status: "failed", error: error.presence || self.error, updated_at: Time.current)
+  end
+
+  def perform
+    Current.with_account(account) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        if cards?
+          Account::DataTransfer::CardsExporter.new(user).export_to(zip)
+        else
+          Account::DataTransfer::Exporter.new(account).export_to(zip)
+        end
+      end
+    end
+  end
+
+  def download_url(host: nil)
+    options = { expires_in: 1.day, disposition: :attachment }
+    options[:host] = host.presence || Rails.application.routes.default_url_options[:host] || ActionMailer::Base.default_url_options[:host]
+
+    Rails.application.routes.url_helpers.rails_blob_url(file, **options.compact)
+  end
+
+  private
+    def sync_cards_only
+      write_attribute(:kind, read_attribute(:cards_only) ? "cards" : "account") if cards_only_changed? && !kind_changed?
+    end
+end
