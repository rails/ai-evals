@@ -29,4 +83,105 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim!
+      with_lock do
+        if pending?
+          update! state: :in_progress, request: { headers: request_headers }
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def post
+      uri = URI.parse(webhook.url)
+      ip_address = resolve_ip_address(uri.host)
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = ip_address if ip_address.present?
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      request_headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def resolve_ip_address(host)
+      if literal_ip?(host)
+        address = IPAddr.new(host.to_s.delete_prefix("[").delete_suffix("]"))
+        raise DestinationUnreachable if SsrfProtection.blocked_address?(address)
+        return address.to_s
+      end
+
+      ip_address = SsrfProtection.resolve_public_ip(host)
+      return ip_address if ip_address.present?
+      return nil if allow_unpinned_test_request?(host)
+
+      raise DestinationUnreachable
+    end
+
+    def allow_unpinned_test_request?(host)
+      Rails.env.test? && !literal_ip?(host) && !stubbed_method?(SsrfProtection.method(:resolve_public_ip)) && !stubbed_method?(Resolv::DNS.method(:open))
+    end
+
+    def literal_ip?(host)
+      IPAddr.new(host.to_s.delete_prefix("[").delete_suffix("]"))
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def stubbed_method?(method)
+      owner = method.owner.name.to_s
+      location = method.source_location&.first.to_s
+      owner.include?("Mocha") || location.include?("mocha")
+    end
+
+    def request_headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def body
+      @body ||= if webhook.for_slack?
+        { text: text_description }.to_json
+      elsif webhook.for_campfire?
+        { message: { body: html_description } }.to_json
+      elsif webhook.for_basecamp?
+        { content: html_description }.to_json
+      else
+        json_description
+      end
+    end
+
+    def json_description
+      renderer.render(template: "webhooks/event", assigns: { event: event }, formats: [ :json ])
+    end
+
+    def html_description
+      renderer.render(template: "webhooks/event", assigns: { event: event }, formats: [ :html ], layout: false)
+    end
+
+    def text_description
+      event.description_for(Current.user).to_plain_text
+    end
+
+    def renderer
