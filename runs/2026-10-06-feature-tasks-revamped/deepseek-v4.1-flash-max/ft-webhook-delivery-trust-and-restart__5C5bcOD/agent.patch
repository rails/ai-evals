@@ -0,0 +1,22 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    webhooks.each do |webhook|
+      webhook.deliver_later(self)
+    end
+  end
+
+  def webhooks
+    board.webhooks.active.subscribed_to(action)
+  end
+  alias_method :subscribed_webhooks, :webhooks
+end
