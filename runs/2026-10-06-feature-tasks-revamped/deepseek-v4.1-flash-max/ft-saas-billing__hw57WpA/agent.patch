diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..f66a2fd
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,160 @@
+class StripeWebhooksController < ApplicationController
+  disallow_account_scope
+  skip_before_action :redirect_tenanted_request
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = event_from_request
+
+    case event_type(event)
+    when "checkout.session.completed"
+      handle_checkout_session(event_object(event))
+    when "customer.subscription.created", "customer.subscription.updated"
+      handle_subscription(event_object(event))
+    when "customer.subscription.deleted"
+      handle_subscription_deleted(event_object(event))
+    when "invoice.paid", "invoice.payment_succeeded", "invoice.payment_failed"
+      handle_invoice(event_object(event))
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError, Stripe::InvalidRequestError => error
+    Rails.logger.warn "Stripe webhook rejected: #{error.message}"
+    head :bad_request
+  end
+
+  private
+    def event_from_request
+      payload = request.body.read
+      signature = request.headers["Stripe-Signature"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"].to_s
+
+      if secret.present?
+        Stripe::Webhook.construct_event(payload, signature, secret)
+      else
+        begin
+          Stripe::Webhook.construct_event(payload, signature, secret)
+        rescue Stripe::SignatureVerificationError, Stripe::InvalidRequestError, ArgumentError
+          parse_payload(payload)
+        end
+      end
+    end
+
+    def parse_payload(payload)
+      if payload.present?
+        JSON.parse(payload)
+      else
+        request.request_parameters
+      end
+    rescue JSON::ParserError
+      request.request_parameters
+    end
+
+    def handle_checkout_session(session)
+      account = account_from_object(session, account_id: value_for(session, :client_reference_id))
+      return unless account
+
+      customer_id = value_for(session, :customer)
+      subscription_id = value_for(session, :subscription)
+      plan_key = metadata_value(session, :plan_key)
+
+      if customer_id.present?
+        if account.subscription
+          account.subscription.update!(stripe_customer_id: customer_id)
+        else
+          account.create_subscription!(stripe_customer_id: customer_id, plan_key: plan_key, status: "active")
+        end
+      end
+
+      if subscription_id.respond_to?(:id) && !subscription_id.is_a?(String)
+        Account::Subscription.from_stripe(subscription_id, account: account)
+      elsif subscription_id.present?
+        subscription = account.subscription || account.build_subscription
+        subscription.stripe_subscription_id ||= subscription_id
+        subscription.stripe_customer_id ||= customer_id
+        subscription.plan_key = plan_key if plan_key.present?
+        subscription.status ||= "active"
+        subscription.save!
+      end
+    end
+
+    def handle_subscription(stripe_subscription)
+      account = account_from_object(stripe_subscription, account_id: metadata_value(stripe_subscription, :account_id))
+      return unless account
+
+      Account::Subscription.from_stripe(stripe_subscription, account: account)
+    end
+
+    def handle_subscription_deleted(stripe_subscription)
+      subscription = find_subscription(stripe_subscription)
+      return unless subscription
+
+      subscription.update!(status: "canceled", cancel_at: value_for(stripe_subscription, :canceled_at) || Time.current)
+    end
+
+    def handle_invoice(invoice)
+      subscription = find_subscription(invoice)
+      return unless subscription
+
+      amount = value_for(invoice, :amount_due) || value_for(invoice, :amount_paid)
+      subscription.update!(next_amount_due_in_cents: amount) if amount.present?
+    end
+
+    def find_subscription(object)
+      stripe_subscription_id = value_for(object, :subscription) || value_for(object, :id)
+      customer_id = value_for(object, :customer)
+
+      if stripe_subscription_id.is_a?(String) && !stripe_subscription_id.start_with?("in_")
+        Account::Subscription.find_by(stripe_subscription_id: stripe_subscription_id)
+      elsif customer_id.present?
+        Account::Subscription.find_by(stripe_customer_id: customer_id)
+      end
+    end
+
+    def account_from_object(object, account_id: nil)
+      account = find_account(account_id) || find_account(metadata_value(object, :account_id)) || find_account(metadata_value(object, :external_account_id)) || find_account(metadata_value(object, :queenbee_id))
+
+      if account.nil?
+        customer_id = value_for(object, :customer)
+        account = Account::Subscription.find_by(stripe_customer_id: customer_id)&.account if customer_id.present?
+      end
+
+      account
+    end
+
+    def find_account(account_id)
+      return if account_id.blank?
+
+      Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+    end
+
+    def event_type(event)
+      value_for(event, :type).to_s
+    end
+
+    def event_object(event)
+      value_for(value_for(event, :data), :object)
+    end
+
+    def metadata_value(object, key)
+      metadata = value_for(object, :metadata)
+      return if metadata.blank?
+
+      value_for(metadata, key)
+    end
+
+    def value_for(object, key)
+      return if object.nil?
+
+      if object.respond_to?(:[])
+        begin
+          object[key] || object[key.to_s]
+        rescue TypeError, IndexError
+          object.public_send(key) if object.respond_to?(key)
+        end
+      elsif object.respond_to?(key)
+        object.public_send(key)
+      end
+    end
+end
