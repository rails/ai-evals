diff --git a/saas/app/controllers/billing_controller.rb b/saas/app/controllers/billing_controller.rb
new file mode 100644
index 0000000..b0a68a9
--- /dev/null
+++ b/saas/app/controllers/billing_controller.rb
@@ -0,0 +1,71 @@
+class BillingController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    redirect_to account_settings_path
+  end
+
+  def create
+    checkout
+  end
+
+  def checkout
+    plan, price_id = plan_from_params
+
+    if plan.free?
+      redirect_to account_settings_path, alert: "Choose a plan to continue."
+    else
+      @price_id = price_id
+      session = Stripe::Checkout::Session.create(checkout_session_params(plan))
+      redirect_to session.url, allow_other_host: true
+    end
+  end
+
+  def portal
+    if Current.account.stripe_customer_id.present?
+      session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to account_settings_path, alert: "There's no subscription to manage."
+    end
+  end
+
+  private
+    def plan_from_params
+      price = params[:price].presence || params[:price_id].presence
+      plan_key = params[:plan].presence || params[:plan_key].presence
+
+      if plan_key.blank? && price.to_s.start_with?("price_")
+        [ Account::Plan.find("MonthlyV1"), price ]
+      else
+        [ Account::Plan.find(plan_key || price || "MonthlyV1"), nil ]
+      end
+    end
+
+    def checkout_session_params(plan)
+      params = {
+        mode: "subscription",
+        line_items: [ { price: plan_price_id(plan), quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: account_settings_url,
+        client_reference_id: Current.account.id,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.key } }
+      }
+
+      if Current.account.stripe_customer_id.present?
+        params[:customer] = Current.account.stripe_customer_id
+      else
+        params[:customer_email] = Current.user.identity.email_address
+      end
+
+      params
+    end
+
+    def plan_price_id(plan)
+      @price_id.presence || plan.stripe_price_id.presence || plan.key
+    end
+end
