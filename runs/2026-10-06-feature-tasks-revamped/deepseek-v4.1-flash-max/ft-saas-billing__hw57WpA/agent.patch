+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,109 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :active_subscription, -> { active }, class_name: "Account::Subscription"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def plan
+    if active_subscription&.plan&.paid?
+      subscription.plan
+    else
+      Account::Plan.free
+    end
+  end
+
+  def plan_key
+    plan.key
+  end
+
+  def plan_name
+    plan.name
+  end
+  alias_method :plan_label, :plan_name
+  alias_method :display_plan_name, :plan_name
+  alias_method :billing_plan_name, :plan_name
+
+  def free?
+    plan.free?
+  end
+
+  def paid?
+    !free?
+  end
+  alias_method :paid_plan?, :paid?
+  alias_method :free_plan?, :free?
+
+  def upgrade_required?
+    free?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+  alias_method :subscription_active?, :subscribed?
+
+  def billing_plan
+    plan
+  end
+
+  def subscription_plan
+    Subscription.find_by_short_name(plan_key) || Subscription::FreeV1
+  end
+
+  def stripe_subscription_id
+    subscription&.stripe_subscription_id
+  end
+
+  def subscription_status
+    subscription&.status
+  end
+
+  def current_period_end
+    subscription&.current_period_end
+  end
+
+  def next_amount_due_in_cents
+    subscription&.next_amount_due_in_cents
+  end
+
+  def unlimited_cards?
+    plan.unlimited_cards?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      create_billing_waiver! unless billing_waiver
+    else
+      billing_waiver&.destroy!
+      association(:billing_waiver).reset
+    end
+  end
+
+  def comp!
+    self.comped = true
+  end
+
+  def uncomp!
+    self.comped = false
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def stripe_customer_id=(value)
+    if subscription
+      subscription.update!(stripe_customer_id: value)
+    else
+      create_subscription!(stripe_customer_id: value, plan_key: "FreeV1")
+    end
+  end
+end
