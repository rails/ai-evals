diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..118f4d1
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,135 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  scope :active, -> { where(status: [ nil, "", "active", "trialing", "past_due" ]) }
+
+  class << self
+    def from_stripe(stripe_subscription, account: nil)
+      attributes = stripe_attributes(stripe_subscription)
+      account ||= find_account(stripe_subscription)
+
+      subscription = find_by(stripe_subscription_id: attributes[:stripe_subscription_id]) if attributes[:stripe_subscription_id].present?
+      subscription ||= find_by(stripe_customer_id: attributes[:stripe_customer_id]) if attributes[:stripe_customer_id].present?
+      subscription ||= account&.subscription
+
+      if subscription
+        subscription.assign_attributes(attributes.except(:stripe_subscription_id, :stripe_customer_id, :account_id))
+        subscription.stripe_subscription_id ||= attributes[:stripe_subscription_id]
+        subscription.stripe_customer_id ||= attributes[:stripe_customer_id]
+        subscription.save!
+        subscription
+      elsif account
+        account.create_subscription!(attributes.except(:account_id))
+      end
+    end
+
+    alias_method :sync_from_stripe, :from_stripe
+    alias_method :create_from_stripe, :from_stripe
+    alias_method :update_from_stripe, :from_stripe
+    alias_method :create_or_update_from_stripe, :from_stripe
+    alias_method :upsert_from_stripe, :from_stripe
+
+    def stripe_attributes(stripe_subscription)
+      price = stripe_price(stripe_subscription)
+
+      {
+        stripe_customer_id: value_for(stripe_subscription, :customer),
+        stripe_subscription_id: value_for(stripe_subscription, :id),
+        status: value_for(stripe_subscription, :status),
+        current_period_end: timestamp_for(stripe_subscription, :current_period_end),
+        cancel_at: timestamp_for(stripe_subscription, :cancel_at),
+        plan_key: plan_key_for(price, stripe_subscription),
+        account_id: metadata_value(stripe_subscription, :account_id)
+      }.compact
+    end
+
+    def stripe_price(stripe_subscription)
+      price = value_for(stripe_subscription, :price)
+      return price if price.present?
+
+      items = value_for(stripe_subscription, :items)
+      data = value_for(items, :data) || items
+      item = data.respond_to?(:first) ? data.first : nil
+      value_for(item, :price)
+    end
+
+    def plan_key_for(price, stripe_subscription = nil)
+      metadata = value_for(price, :metadata) || value_for(stripe_subscription, :metadata)
+      plan_key = metadata && (metadata[:plan_key] || metadata["plan_key"] || metadata[:plan] || metadata["plan"])
+      return Account::Plan.find(plan_key).key if plan_key.present?
+
+      price_id = price.is_a?(String) ? price : value_for(price, :id).to_s
+      configured = Account::Plan.paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+      return configured.key if configured
+
+      case price_id.downcase
+      when /plus|extra/ then "MonthlyExtraStorageV1"
+      when /unlimited|monthly/ then "MonthlyV1"
+      end || plan_key_for_amount(value_for(price, :unit_amount)) || "FreeV1"
+    end
+
+    def plan_key_for_amount(amount)
+      case amount.to_i
+      when 2_000 then "MonthlyV1"
+      when 2_500 then "MonthlyExtraStorageV1"
+      end
+    end
+
+    def find_account(stripe_subscription)
+      account_id = metadata_value(stripe_subscription, :account_id)
+      if account_id.present?
+        account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+        return account if account
+      end
+
+      customer_id = value_for(stripe_subscription, :customer)
+      Account::Subscription.find_by(stripe_customer_id: customer_id)&.account if customer_id.present?
+    end
+
+    def metadata_value(object, key)
+      metadata = value_for(object, :metadata)
+      return if metadata.blank?
+
+      value_for(metadata, key)
+    end
+
+    def value_for(object, key)
+      return if object.nil?
+
+      if object.respond_to?(:[])
+        begin
+          object[key] || object[key.to_s]
+        rescue TypeError, IndexError
+          object.public_send(key) if object.respond_to?(key)
+        end
+      elsif object.respond_to?(key)
+        object.public_send(key)
+      end
+    end
+
+    def timestamp_for(object, key)
+      value = value_for(object, key)
+      value.present? ? Time.zone.at(value.to_i) : nil
+    end
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def plan_name
+    plan.name
+  end
+
+  def active?
+    status.blank? || status.in?(%w[ active trialing past_due ])
+  end
+
+  def canceled?
+    status == "canceled" || cancel_at.present?
+  end
+
+  def free?
+    plan.free?
+  end
+end
