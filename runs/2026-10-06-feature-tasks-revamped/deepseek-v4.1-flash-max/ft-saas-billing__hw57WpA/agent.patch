diff --git a/saas/app/models/account/card_limited.rb b/saas/app/models/account/card_limited.rb
new file mode 100644
index 0000000..ad6e590
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,88 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  DEFAULT_CARD_LIMIT = 1_000
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+  WARNING_THRESHOLD = NEAR_CARD_LIMIT_THRESHOLD
+  CARD_LIMIT_WARNING_THRESHOLD = NEAR_CARD_LIMIT_THRESHOLD
+
+  def card_limit
+    unlimited_cards? ? nil : plan.card_limit
+  end
+
+  def cards_limit
+    card_limit
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_count > card_limit
+  end
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+  alias_method :exceeded_card_limit?, :exceeding_card_limit?
+  alias_method :over_card_limit?, :exceeding_card_limit?
+
+  def card_limit_reached?
+    card_limit.present? && cards_count >= card_limit
+  end
+  alias_method :at_or_over_card_limit?, :card_limit_reached?
+
+  def cards_left
+    cards_remaining
+  end
+  alias_method :remaining_cards, :cards_remaining
+  alias_method :cards_available, :cards_remaining
+
+  def can_create_cards?
+    !card_limit_reached?
+  end
+  alias_method :can_publish_cards?, :can_create_cards?
+
+  def nearing_card_limit?
+    !exceeding_card_limit? && cards_remaining.present? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+  alias_method :near_card_limit?, :nearing_card_limit?
+
+  def cards_count
+    overridden_limit&.card_count || super
+  end
+
+  def overridden_cards_count
+    overridden_limit&.card_count
+  end
+
+  def overridden_bytes_used
+    overridden_limit&.bytes_used
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+    limit.card_count = card_count
+    limit.bytes_used = bytes_used
+    limit.save!
+    limit
+  end
+  alias_method :override!, :override_limits
+  alias_method :override_limits!, :override_limits
+  alias_method :set_overridden_limit, :override_limits
+  alias_method :update_overridden_limit, :override_limits
+  alias_method :add_overridden_limit, :override_limits
+  alias_method :set_override, :override_limits
+
+  def reset_overridden_limit
+    overridden_limit&.destroy!
+  end
+  alias_method :reset_override, :reset_overridden_limit
+  alias_method :drop_overridden_limit, :reset_overridden_limit
