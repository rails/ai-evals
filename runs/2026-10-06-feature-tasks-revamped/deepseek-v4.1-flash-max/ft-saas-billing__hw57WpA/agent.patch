+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,54 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    @account.override_limits(**override_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def reset
+    @account.reset_overridden_limit
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+
+    def override_params
+      permitted = params
+        .fetch(:overridden_limit, params.fetch(:account_overridden_limit, params.fetch(:account, params)))
+        .permit(:card_count, :bytes_used)
+
+      existing = @account.overridden_limit
+
+      {
+        card_count: permitted.key?(:card_count) ? normalize_count(permitted[:card_count]) : existing&.card_count,
+        bytes_used: permitted.key?(:bytes_used) ? normalize_count(permitted[:bytes_used]) : existing&.bytes_used
+      }
+    end
+
+    def normalize_count(value)
+      value.presence
+    end
+end
