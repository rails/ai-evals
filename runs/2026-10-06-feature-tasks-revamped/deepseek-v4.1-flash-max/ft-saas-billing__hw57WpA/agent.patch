diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..5f77203
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,124 @@
+class Account::Plan < String
+  PLANS = [
+    { key: "FreeV1", name: "Free", card_limit: 1_000, storage_limit: 1.gigabyte, price_cents: 0 },
+    { key: "MonthlyV1", name: "Unlimited", card_limit: nil, storage_limit: 5.gigabytes, price_cents: 2_000,
+      env_price_id: "STRIPE_MONTHLY_V1_PRICE_ID" },
+    { key: "MonthlyExtraStorageV1", name: "Unlimited+", card_limit: nil, storage_limit: 500.gigabytes, price_cents: 2_500,
+      env_price_id: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" }
+  ].freeze
+
+  ALIASES = {
+    "free" => "FreeV1",
+    "freev1" => "FreeV1",
+    "free_v1" => "FreeV1",
+    "unlimited" => "MonthlyV1",
+    "unlimitedv1" => "MonthlyV1",
+    "unlimited_v1" => "MonthlyV1",
+    "monthly" => "MonthlyV1",
+    "monthlyv1" => "MonthlyV1",
+    "monthly_v1" => "MonthlyV1",
+    "unlimitedplus" => "MonthlyExtraStorageV1",
+    "unlimited+" => "MonthlyExtraStorageV1",
+    "unlimitedplusv1" => "MonthlyExtraStorageV1",
+    "unlimited_plus" => "MonthlyExtraStorageV1",
+    "unlimited_plus_v1" => "MonthlyExtraStorageV1",
+    "extra_storage" => "MonthlyExtraStorageV1",
+    "extrastorage" => "MonthlyExtraStorageV1",
+    "monthlyextrastoragev1" => "MonthlyExtraStorageV1",
+    "monthly_extra_storage" => "MonthlyExtraStorageV1",
+    "monthly_extra_storage_v1" => "MonthlyExtraStorageV1",
+    "extra_storage_v1" => "MonthlyExtraStorageV1"
+  }.freeze
+
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_cents
+
+  class << self
+    def all
+      PLANS.map { |attributes| new(**attributes) }
+    end
+
+    def find(key)
+      plan = all.find { |candidate| candidate.key == key.to_s || candidate.name == key.to_s }
+      plan || all.find { |candidate| candidate.key == ALIASES[key.to_s.downcase] } || free
+    end
+    alias [] find
+    alias for find
+
+    def free
+      new(**PLANS.first)
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def stripe_price_id(plan_key)
+      find(plan_key).stripe_price_id
+    end
+  end
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_cents:, env_price_id: nil)
+    @key = key
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_cents = price_cents
+    @env_price_id = env_price_id
+
+    super(key)
+  end
+
+  def stripe_price_id
+    candidates = [
+      @env_price_id && ENV[@env_price_id],
+      ENV["STRIPE_#{key.underscore.upcase}_PRICE_ID"],
+      ENV["STRIPE_PRICE_#{key.underscore.upcase}"]
+    ]
+
+    if key == "MonthlyV1"
+      candidates << ENV["STRIPE_PRICE_UNLIMITED"]
+      candidates << ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    elsif key == "MonthlyExtraStorageV1"
+      candidates << ENV["STRIPE_PRICE_UNLIMITED_PLUS"]
+      candidates << ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+    end
+
+    candidates.find(&:present?)
+  end
+
+  def proper_name
+    name
+  end
+
+  def short_name
+    key
+  end
+
+  def free?
+    price_cents.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price
+    price_cents / 100
+  end
+
+  def price_in_cents
+    price_cents
+  end
+
+  def frequency
+    free? ? "yearly" : "monthly"
+  end
+
+  def to_param
+    key
+  end
+end
