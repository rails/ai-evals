diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c5ffaf5 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,93 @@
 module TimeHelper
+  FORMAT_ALIASES = {
+    nil => "relative",
+    "" => "relative",
+    relative: "relative",
+    time_ago: "relative",
+    ago: "relative",
+    default: "relative",
+    date: "date",
+    short_date: "date",
+    short: "date",
+    month_day: "date",
+    date_only: "date",
+    date_year: "date-year",
+    long_date: "date-year",
+    month_day_year: "date-year",
+    time: "time",
+    time_only: "time",
+    datetime: "datetime",
+    date_time: "datetime",
+    datetime_numeric: "datetime",
+    weekday_date: "weekday-date",
+    day_date: "weekday-date",
+    day: "weekday-date",
+    weekday: "weekday-date",
+    weekday_name: "weekday-date",
+    day_of_week: "weekday-date",
+    full: "full",
+    full_datetime: "full",
+    long_datetime: "full"
+  }
+
+  def local_time(time, positional_format = nil, format: nil, **options)
+    raw_format = positional_format || format || :relative
+    format = normalize_local_time_format(raw_format)
+    timestamp = local_time_iso8601(time)
+
+    html_options = options.dup
+    html_options[:datetime] = timestamp
+    html_options[:class] = class_names("local-time-value", html_options[:class])
+    html_options[:data] = {
+      controller: "local-time",
+      local_time_format: format,
+      local_time_format_value: raw_format.to_s,
+      local_time_timestamp_value: timestamp
+    }.merge(html_options[:data] || {})
+
+    tag.time timestamp, **html_options
+  end
+
+  def local_date(time, **options)
+    local_time(time, :date, **options)
+  end
+
+  def local_time_ago(time, **options)
+    local_time(time, :time_ago, **options)
+  end
+  alias_method :time_ago, :local_time_ago
+  alias_method :relative_time, :local_time_ago
+
+  def local_datetime(time, **options)
+    local_time(time, :datetime, **options)
+  end
+
+  def local_time_value(time, **options)
+    local_time(time, **options)
+  end
+
+  def local_time_tag(time, **options)
+    local_time(time, **options)
+  end
+
+  def time_ago_tag(time, **options)
+    local_time(time, :time_ago, **options)
+  end
+
+  def relative_time_tag(time, **options)
+    local_time(time, :time_ago, **options)
+  end
+
+  private
+    def local_time_iso8601(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.iso8601
+      end
+    end
+
+    def normalize_local_time_format(format)
+      FORMAT_ALIASES.fetch(format&.to_sym, format.to_s.tr("_", "-"))
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..7654bca
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,60 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseTimestamp } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String, timestamp: String }
+
+  connect() {
+    this.#formatAll()
+    this.observer = new MutationObserver(this.#handleMutations.bind(this))
+    this.observer.observe(this.element, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-timestamp-value", "data-local-time-format-value", "data-local-time-format" ],
+      characterData: true
+    })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  #formatAll() {
+    this.#formatWithin(this.element)
+  }
+
+  #handleMutations(mutations) {
+    mutations.forEach(mutation => {
+      if (mutation.type === "attributes") {
+        this.#format(mutation.target)
+      } else if (mutation.type === "characterData") {
+        this.#formatWithin(mutation.target.parentElement)
+      } else {
+        mutation.addedNodes.forEach(node => this.#formatWithin(node))
+      }
+    })
+  }
+
+  #formatWithin(node) {
+    if (!node || node.nodeType !== Node.ELEMENT_NODE) return
+
+    if (node.matches(".local-time-value")) {
+      this.#format(node)
+    }
+
+    node.querySelectorAll(".local-time-value").forEach(element => this.#format(element))
+  }
+
+  #format(element) {
+    const timestamp = element.getAttribute("datetime") ||
+      element.dataset.localTimeTimestampValue ||
+      this.timestampValue ||
+      (/^\d{4}-\d{2}-\d{2}T/.test(element.textContent) ? element.textContent : null)
+    const date = parseTimestamp(timestamp)
+    if (!date || isNaN(date)) return
+
+    const format = this.formatValue || element.dataset.localTimeFormatValue || element.dataset.localTimeFormat
+    element.textContent = formatLocalTime(date, format)
+  }
+}
