diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..562fdda
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,20 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    return text if query.blank?
+
+    highlight(text.to_s, search_phrases(query))
+  end
+
+  def search_match?(text, query)
+    query.present? && text.to_s.downcase.include?(query.downcase)
+  end
+
+  def search_snippet(text, query)
+    search_highlight(excerpt(text.to_s, query, radius: 100), query)
+  end
+
+  private
+    def search_phrases(query)
+      [ query, *query.split ].uniq
+    end
+end
