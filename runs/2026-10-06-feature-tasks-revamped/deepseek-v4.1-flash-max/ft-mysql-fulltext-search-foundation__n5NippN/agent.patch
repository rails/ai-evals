diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..6dbe1f4
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,45 @@
+<%= card_article_tag card, class: "card search-result" do %>
+  <header class="card__header">
+    <div class="card__board flex align-start">
+      <span class="card__id">
+        <span class="for-screen-reader">Card number</span>
+        <%= card.number %>
+      </span>
+      <span class="card__board-name overflow-ellipsis"><%= card.board.name %></span>
+    </div>
+  </header>
+
+  <div class="card__body">
+    <div class="card__content">
+      <h3 class="card__title overflow-line-clamp">
+        <%= link_to card_path(card), class: "card__title-link", title: card_title_tag(card) do %>
+          <%= search_highlight(card.title, query) %>
+        <% end %>
+      </h3>
+
+      <% description_text = card.description&.to_plain_text.to_s %>
+      <% if search_match?(description_text, query) %>
+        <p class="card__snippet search-result__excerpt search-result__snippet search-result__description">
+          <%= search_snippet(description_text, query) %>
+        </p>
+      <% end %>
+
+      <% card.comments.each do |comment| %>
+        <% comment_text = comment.body&.to_plain_text.to_s %>
+        <% if search_match?(comment_text, query) %>
+          <p class="card__snippet search-result__excerpt search-result__snippet search-result__comment">
+            <%= search_snippet(comment_text, query) %>
+          </p>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+
+  <footer class="card__footer">
+    <div class="card__meta">
+      <span class="card__meta-text card__meta-text--author">
+        Added by <strong><%= card.creator.familiar_name %></strong>
+      </span>
+    </div>
+  </footer>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..ede44c8
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex gap" do |form| %>
+    <%= form.label :q, "Search", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…",
+          class: "input full-width", autofocus: true, aria: { label: "Search cards" },
+          autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+    <%= button_tag "Search", type: "submit", name: nil, class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="panel borderless margin pad">
+    <% if @cards.any? %>
+      <p class="txt-small translucent"><%= pluralize @cards.size, "result" %></p>
+
+      <div class="cards search-results cards__list hide-scrollbar" id="search-results">
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { query: @query } %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  </section>
+<% end %>
