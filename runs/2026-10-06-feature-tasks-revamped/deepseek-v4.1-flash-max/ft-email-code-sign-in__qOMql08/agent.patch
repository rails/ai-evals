@@ -0,0 +1,45 @@
+class Sessions::StartsController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+
+  layout "public"
+
+  def new
+    if params[:token].present?
+      store_token_from_params
+      @sign_in_code = pending_sign_in_code
+
+      redirect_to new_session_path, alert: "That link has expired. Request a new one." unless @sign_in_code&.active?
+    else
+      @sign_in_code = pending_sign_in_code
+    end
+  end
+
+  def create
+    sign_in_code = pending_sign_in_code
+
+    if sign_in_code&.active?
+      sign_in_code.consume!
+      clear_pending_authentication
+      start_new_session_for sign_in_code.identity
+
+      respond_to do |format|
+        format.html { redirect_after_pending_authentication(sign_in_code) }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      redirect_to new_session_path, alert: "That link has expired. Request a new one."
+    end
+  end
+
+  private
+    def store_token_from_params
+      if params[:token].present?
+        cookies.signed[Authentication::PENDING_AUTHENTICATION_COOKIE] = {
+          value: params[:token],
+          httponly: true,
+          same_site: :lax
+        }
+      end
+    end
+end
