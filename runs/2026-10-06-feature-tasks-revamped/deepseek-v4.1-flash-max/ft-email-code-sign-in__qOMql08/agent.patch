+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,61 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @sign_in_code = pending_sign_in_code
+    @code = @sign_in_code.code if Rails.env.development? && @sign_in_code
+  end
+
+  def create
+    candidate = params[:code].to_s
+    sign_in_code = pending_sign_in_code
+
+    if sign_in_code.nil?
+      invalid_pending_authentication
+    elsif sign_in_code.matches?(candidate)
+      authenticate_with_sign_in_code(candidate)
+      complete_authentication(sign_in_code)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def complete_authentication(sign_in_code)
+      respond_to do |format|
+        format.html { redirect_after_pending_authentication(sign_in_code) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def invalid_pending_authentication
+      message = "That code has expired. Request a new one."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
