+    def pending_authentication_token_for_response
+      @pending_authentication_token_for_response ||= cookies[PENDING_AUTHENTICATION_COOKIE]
+    end
+
+    def pending_sign_in_code
+      tokens = [
+        params[:pending_authentication_token].presence,
+        cookies.signed[PENDING_AUTHENTICATION_COOKIE]
+      ].compact
+
+      tokens.each do |token|
+        if sign_in_code = resolve_sign_in_code_from_token(token)
+          return sign_in_code
+        end
