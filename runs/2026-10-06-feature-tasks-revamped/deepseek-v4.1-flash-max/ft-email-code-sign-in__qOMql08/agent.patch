+    rescue => error
+      nil
+    end
+
+    def clear_pending_authentication
+      @pending_authentication_token = nil
+      cookies.delete(PENDING_AUTHENTICATION_COOKIE)
+    end
+
+    def authenticate_with_sign_in_code(candidate)
+      sign_in_code = pending_sign_in_code
+      return nil unless sign_in_code&.matches?(candidate)
+
+      sign_in_code.consume!
+      clear_pending_authentication
+      start_new_session_for sign_in_code.identity
+      sign_in_code
+    end
+
+    def redirect_after_pending_authentication(sign_in_code)
+      if sign_in_code.join_code
+        redirect_after_join(sign_in_code)
+      elsif sign_in_code.return_to.present?
+        redirect_to sign_in_code.return_to
+      else
+        redirect_to after_authentication_url
+      end
+    end
+
+    def redirect_after_join(sign_in_code)
+      join_code = sign_in_code.join_code
+      identity = sign_in_code.identity
+
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by(account: join_code.account, identity: identity)
+
+      if user&.setup?
+        redirect_to landing_url(script_name: join_code.account.slug)
+      elsif user
+        redirect_to new_users_verification_url(script_name: join_code.account.slug)
+      else
+        redirect_to join_url(code: join_code.code, script_name: join_code.account.slug), alert: "That join code is no longer available."
+      end
+    end
 end
