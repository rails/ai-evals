+      plaintext_match = code.present? &&
+        ActiveSupport::SecurityUtils.secure_compare(code.to_s.upcase, candidate.to_s.strip.upcase)
+
+      digest = self[:sign_in_code_digest]
+      digest_match = digest.present? && BCrypt::Password.new(digest).is_password?(candidate.to_s.strip.upcase)
+
+      plaintext_match || digest_match
+    rescue BCrypt::Errors::InvalidHash
+      false
+    end
+
     def deactivate_users
       users.find_each(&:deactivate)
     end
