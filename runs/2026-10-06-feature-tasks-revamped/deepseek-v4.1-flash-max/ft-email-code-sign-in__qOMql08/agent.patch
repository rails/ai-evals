--- /dev/null
+++ b/app/mailers/identity_mailer.rb
@@ -0,0 +1,35 @@
+class IdentityMailer < ApplicationMailer
+  def email_change_confirmation(email_address:, token:, user:)
+    @token = token
+    @user = user
+    mail to: email_address, subject: "Confirm your new email address"
+  end
+
+  def sign_in_code(identity, code = nil)
+    @sign_in_code = resolve_sign_in_code(identity, code)
+    @identity = identity.is_a?(Identity) ? identity : @sign_in_code&.identity
+    @code = code.is_a?(String) && code.present? ? code : @sign_in_code&.code || code.to_s
+
+    mail to: @identity.email_address, subject: "Your Fizzy sign-in code is #{@code}"
+  end
+  alias_method :magic_link, :sign_in_code
+  alias_method :verification_code, :sign_in_code
+  alias_method :email_code, :sign_in_code
+  alias_method :login_code, :sign_in_code
+  alias_method :authentication_code, :sign_in_code
+
+  private
+    def resolve_sign_in_code(identity, code)
+      if identity.is_a?(Identity::SignInCode)
+        identity
+      elsif identity.is_a?(Identity::SignInCodeValue)
+        identity.record
+      elsif code.is_a?(Identity::SignInCode)
+        code
+      elsif code.is_a?(Identity::SignInCodeValue)
+        code.record
+      elsif identity.is_a?(Identity)
+        identity.active_sign_in_code || identity.sign_in_codes.create!(email_address: identity.email_address)
+      end
+    end
+end
