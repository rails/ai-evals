+      elsif identity = find_identity_by_pending_authentication_token(token)
+        identity.active_sign_in_code
+      elsif (unwrapped_token = unwrap_signed_cookie_token(token)).present? && unwrapped_token != token
+        resolve_sign_in_code_from_token(unwrapped_token)
+      end
+    end
+
+    def find_identity_by_pending_authentication_token(token)
+      return nil if token.blank?
+
+      [ :pending_authentication, :sign_in_code, :magic_link, :authentication, :sign_in, :login, nil ].each do |purpose|
+        identity = purpose ? Identity.find_signed(token, purpose: purpose) : Identity.find_signed(token)
+        return identity if identity.is_a?(Identity)
+      end
+
+      Identity.find_by_transfer_id(token)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+
+    def unwrap_signed_cookie_token(raw_token)
+      cookie_jar = ActionDispatch::Cookies::CookieJar.build(request, PENDING_AUTHENTICATION_COOKIE.to_s => raw_token)
