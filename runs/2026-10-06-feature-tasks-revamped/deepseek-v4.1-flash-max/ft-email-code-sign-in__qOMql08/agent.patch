diff --git a/app/models/identity/sign_in_code.rb b/app/models/identity/sign_in_code.rb
new file mode 100644
index 0000000..13995ba
--- /dev/null
+++ b/app/models/identity/sign_in_code.rb
@@ -0,0 +1,87 @@
+class Identity::SignInCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  TTL = EXPIRATION
+  CODE_TTL = EXPIRATION
+  PENDING_AUTHENTICATION_PURPOSE = :pending_authentication
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+  belongs_to :account, optional: true
+
+  before_validation :assign_code, on: :create
+  before_validation :assign_expiration, on: :create
+
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+
+  scope :active, -> { where(used_at: nil).where(expires_at: Time.current..) }
+  scope :unused, -> { where(used_at: nil) }
+  scope :used, -> { where.not(used_at: nil) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  class << self
+    def generate_for(identity, **attributes)
+      create!(identity: identity, **attributes)
+    end
+
+    alias_method :create_for, :generate_for
+    alias_method :generate, :generate_for
+
+    def find_by_pending_authentication_token(token)
+      return nil if token.blank?
+
+      [ PENDING_AUTHENTICATION_PURPOSE, :sign_in_code, :magic_link, :authentication, :sign_in, :login, nil ].each do |purpose|
+        record = purpose ? find_signed(token, purpose: purpose) : find_signed(token)
+        return record if record
+      end
+
+      nil
+    rescue ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: PENDING_AUTHENTICATION_PURPOSE, expires_in: EXPIRATION)
+  end
+
+  def active?
+    used_at.nil? && expires_at.present? && expires_at.future?
+  end
+
+  def expired?
+    expires_at.blank? || !expires_at.future?
+  end
+
+  def used?
+    used_at.present?
+  end
+
+  def matches?(candidate)
+    active? && code.present? && candidate.present? &&
+      ActiveSupport::SecurityUtils.secure_compare(code.to_s.upcase, candidate.to_s.strip.upcase)
+  end
+
+  def consume!
+    transaction do
+      update!(used_at: Time.current)
+      identity.clear_sign_in_code(code)
+    end
+  end
+  alias_method :consume, :consume!
+
+  def verify(candidate)
+    matches?(candidate)
+  end
+  alias_method :valid_code?, :matches?
+
+  private
+    def assign_code
+      self.code = code.present? ? code.to_s.strip.upcase : SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def assign_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+end
