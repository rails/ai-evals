diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..9d43a27
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,115 @@
+class Sessions::MagicLinksController < ApplicationController
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @pending_authentication = find_pending_authentication
+
+    if @pending_authentication
+      @magic_link = true
+      @email_address = @pending_authentication.email_address
+
+      render "sessions/new"
+    else
+      redirect_to new_session_path(script_name: nil)
+    end
+  end
+
+  def create
+    pending_authentication = find_pending_authentication
+    code = params[:code].to_s
+
+    if pending_authentication&.matches?(code)
+      clear_pending_authentication
+      complete_authentication pending_authentication
+    else
+      authentication_failed
+    end
+  end
+
+  private
+    def complete_authentication(pending_authentication)
+      case pending_authentication.purpose
+      when "signup"
+        complete_signup pending_authentication
+      when "join"
+        complete_join pending_authentication
+      else
+        complete_sign_in pending_authentication
+      end
+    end
+
+    def complete_sign_in(pending_authentication)
+      if identity = identity_for_sign_in(pending_authentication)
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        authentication_failed(message: "We couldn't find an account with that email address.")
+      end
+    end
+
+    def complete_signup(pending_authentication)
+      identity = Signup.new(email_address: pending_authentication.email_address).create_identity
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def complete_join(pending_authentication)
+      account = pending_authentication.account
+      join_code = pending_authentication.join_code
+
+      if account && join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: pending_authentication.email_address)
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: account, identity: identity)
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html do
+            if user.setup?
+              redirect_to landing_url(script_name: account.slug)
+            else
+              redirect_to new_users_verification_url(script_name: account.slug)
+            end
+          end
+
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        authentication_failed(message: "That join code is no longer active.")
+      end
+    end
+
+    def identity_for_sign_in(pending_authentication)
+      pending_authentication.identity ||
+        Identity.find_by(email_address: pending_authentication.email_address) ||
+        (Identity.create!(email_address: pending_authentication.email_address) if Account.accepting_signups?)
+    end
+
+    def authentication_failed(message: "That code didn't work. Try again.")
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
