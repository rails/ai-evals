diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..9dc5326
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,64 @@
+class PendingAuthentication
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  EXPIRATION = 15.minutes
+  CODE_LENGTH = 6
+  PURPOSES = %w[ sign_in signup join ].freeze
+
+  attribute :email_address, :string
+  attribute :code, :string
+  attribute :purpose, :string, default: "sign_in"
+  attribute :identity_id, :string
+  attribute :account_id, :string
+  attribute :join_code_id, :string
+
+  validates :email_address, :code, presence: true
+
+  class << self
+    def generate(email_address:, purpose: "sign_in", **context)
+      new(email_address: email_address, purpose: purpose, code: generate_code, **context)
+    end
+
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def find_by_token(token)
+      if token.is_a?(String) && token.present? && payload = verifier.verified(token, purpose: :pending_authentication)
+        new(payload)
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+  end
+
+  def token
+    @token ||= self.class.verifier.generate(payload, expires_in: EXPIRATION, purpose: :pending_authentication)
+  end
+
+  def matches?(submitted_code)
+    submitted_code = submitted_code.to_s.strip.upcase
+
+    code.present? && ActiveSupport::SecurityUtils.secure_compare(code.to_s, submitted_code)
+  end
+
+  def identity
+    Identity.find_by(id: identity_id) if identity_id.present?
+  end
+
+  def account
+    Account.find_by(id: account_id) if account_id.present?
+  end
+
+  def join_code
+    Account::JoinCode.find_by(id: join_code_id) if join_code_id.present?
+  end
+
+  private
+    def payload
+      attributes.compact
+    end
+end
