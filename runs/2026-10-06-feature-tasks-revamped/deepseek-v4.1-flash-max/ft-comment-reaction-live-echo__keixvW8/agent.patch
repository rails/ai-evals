diff --git a/app/views/reactions/_new_fields.html.erb b/app/views/reactions/_new_fields.html.erb
new file mode 100644
index 0000000..b2478a7
--- /dev/null
+++ b/app/views/reactions/_new_fields.html.erb
@@ -0,0 +1,47 @@
+<%# locals: (reactable:) %>
+<button type="button" class="reactions__trigger btn" data-reaction-target="trigger" data-action="reaction#edit"
+    value="Add reaction" aria-label="Add reaction" title="Add a reaction">
+  <%= image_tag "boost-color.svg", alt: "" %>
+  <span class="for-screen-reader">Add reaction</span>
+</button>
+
+<div data-reaction-target="container" hidden>
+  <%= form_with model: Reaction.new, url: reactions_path_for(reactable),
+        class: "reaction__form flex align-center gap-half",
+        data: { reaction_target: "form", action: "keydown.esc->reaction#cancel" } do |form| %>
+    <label class="reaction__form-label for-screen-reader" for="<%= dom_id(reactable, :reaction_content) %>">Reaction</label>
+
+    <%= form.text_field :content, id: dom_id(reactable, :reaction_content), class: "input reaction__input",
+          maxlength: 16, required: true, autocomplete: "off", placeholder: "React…",
+          data: { reaction_target: "input" } %>
+
+    <div class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn" data-action="click->dialog#open:stop"
+          aria-label="Choose an emoji" title="Choose an emoji">
+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="popup reaction__popup" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" data-action="click->reaction#selectEmoji"
+                data-reaction-emoji-param="<%= emoji %>" aria-label="<%= label %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn", value: "Confirm",
+          title: "React", aria: { label: "Confirm reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn" data-action="reaction#cancel"
+        value="Cancel" title="Cancel" aria-label="Cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
