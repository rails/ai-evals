diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..601fb54
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,33 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account }
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :card, optional: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+  scope :preloaded, -> { includes(:reacter) }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  validate :must_belong_to_comment_or_card
+
+  after_create :register_card_activity
+
+  def card
+    super || comment&.card
+  end
+
+  def emoji?
+    EmojiHelper::REACTIONS.key?(content)
+  end
+  alias_method :emoji_only?, :emoji?
+
+  private
+    def must_belong_to_comment_or_card
+      errors.add(:comment, :blank) if comment.nil? && card.nil?
+    end
+
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
