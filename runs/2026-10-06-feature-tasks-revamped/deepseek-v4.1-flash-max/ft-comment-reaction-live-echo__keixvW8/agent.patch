diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..4901c28
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,22 @@
+module ReactionsHelper
+  def reactions_path_for(reactable)
+    case reactable
+    when Comment
+      card_comment_reactions_path(reactable.card, reactable)
+    when Card
+      card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    if reaction.comment
+      card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction)
+    else
+      card_reaction_path(reaction.card, reaction)
+    end
+  end
+
+  def reaction_emoji?(reaction)
+    reaction.emoji?
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..eb79a63
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,30 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "container", "form", "input" ]
+
+  edit(event) {
+    event.preventDefault()
+    this.triggerTarget.hidden = true
+    this.containerTarget.hidden = false
+    this.containerTarget.classList.add("reaction")
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event.preventDefault()
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.containerTarget.classList.remove("reaction")
+    this.containerTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  selectEmoji(event) {
+    this.inputTarget.value = event.params.emoji
+    this.inputTarget.focus()
+    event.currentTarget.closest("dialog")?.close()
+  }
+}
