diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..c85ec20
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,60 @@
+class Board::Publication < ApplicationRecord
+  self.table_name = "board_publications"
+
+  belongs_to :board
+  belongs_to :account, default: -> { board.account }
+
+  has_secure_token :key
+
+  before_validation :sync_key_columns, if: -> { key.blank? }
+
+  def publication_key
+    key.presence || self[:publication_key].presence || self[:public_key].presence || token.presence
+  end
+
+  def to_param
+    publication_key
+  end
+
+  def public_key
+    publication_key
+  end
+
+  def published?
+    true
+  end
+
+  def publicly_accessible?
+    board.publicly_accessible?
+  end
+
+  def public_url
+    board.public_url
+  end
+
+  after_create_commit :sync_board_publication
+  after_destroy_commit :clear_board_publication
+
+  private
+    def sync_board_publication
+      board.update_columns(
+        publication_key: publication_key,
+        public_key: publication_key,
+        key: publication_key,
+        published_at: created_at,
+        published: true,
+        updated_at: Time.current
+      )
+    end
+
+    def clear_board_publication
+      return if board.destroyed?
+
+      board.update_columns(publication_key: nil, public_key: nil, key: nil, published_at: nil, published: false)
+    end
+
+    def sync_key_columns
+      generated_or_given_key = self[:publication_key].presence || self[:public_key].presence || token.presence
+      self.key = generated_or_given_key if generated_or_given_key.present?
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..bd97aa7
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,243 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy, inverse_of: :board
+
+    scope :published, -> {
+      where(<<~SQL)
+        (boards.publication_key IS NOT NULL AND boards.publication_key <> '') OR
+        (boards.public_key IS NOT NULL AND boards.public_key <> '') OR
+        (boards.`key` IS NOT NULL AND boards.`key` <> '') OR
+        (boards.published = TRUE) OR
+        (boards.published_at IS NOT NULL) OR
+        EXISTS (
+          SELECT 1 FROM board_publications
+          WHERE board_publications.board_id = boards.id
+            AND (
+              (board_publications.`key` IS NOT NULL AND board_publications.`key` <> '') OR
+              (board_publications.publication_key IS NOT NULL AND board_publications.publication_key <> '') OR
+              (board_publications.public_key IS NOT NULL AND board_publications.public_key <> '') OR
+              (board_publications.token IS NOT NULL AND board_publications.token <> '')
+            )
+        )
+      SQL
+    }
+
+    scope :publicly_accessible, -> { published }
+
+    before_save :ensure_publication_key, if: :publishing?
+    before_save :clear_publication_key, if: :unpublishing?
+    before_save :clear_publication_metadata, if: :clearing_publication_key?
+
+    after_update_commit :destroy_publication_after_unpublish, if: :just_unpublished?
+  end
+
+  def publish
+    transaction do
+      publication_record = publication
+      publication_record = nil if publication_record&.destroyed?
+      publication_record ||= build_publication
+      key = publication_key.presence || publication_record.publication_key.presence || generate_unique_publication_key
+
+      publication_record.key = key
+      publication_record.publication_key ||= key
+      publication_record.public_key ||= key
+      publication_record.token ||= key
+      publication_record.save! if publication_record.new_record? || publication_record.changed?
+
+      update!(
+        publication_key: key,
+        public_key: key,
+        key: key,
+        published_at: publication_record.created_at || Time.current,
+        published: true
+      )
+      association(:publication).reset
+    end
+
+    self
+  end
+
+  def unpublish
+    transaction do
+      publication_record = publication
+      publication_record.destroy! if publication_record&.persisted?
+      association(:publication).reset
+
+      update!(
+        publication_key: nil,
+        public_key: nil,
+        key: nil,
+        published_at: nil,
+        published: false
+      )
+    end
+
+    self
+  end
+
+  def published?
+    publication_key.present? || self[:published] == true || self[:published_at].present?
+  end
+
+  def published
+    published?
+  end
+
+  def public?
+    published?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  def publication_key
+    self[:publication_key].presence ||
+      self[:public_key].presence ||
+      self[:key].presence ||
+      publication_key_from_record
+  end
+
+  def public_key
+    publication_key
+  end
+
+  def key
+    publication_key
+  end
+
+  alias_method :publish!, :publish
+  alias_method :unpublish!, :unpublish
+
+  def public_path
+    return if publication_key.blank?
+
+    Rails.application.routes.url_helpers.public_board_path(publication_key, script_name: nil)
+  end
+
+  def public_url
+    return if publication_key.blank?
+
+    options = public_url_options
+    if options[:host].present?
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **options)
+    else
+      public_path
+    end
+  end
+
+  class_methods do
+    def find_by_public_key(key)
+      return if key.blank?
+
+      published.left_joins(:publication).where(
+        "boards.publication_key = :key OR boards.public_key = :key OR boards.`key` = :key OR " \
+        "board_publications.`key` = :key OR board_publications.publication_key = :key OR " \
+        "board_publications.public_key = :key OR board_publications.token = :key",
+        key: key
+      ).first
+    end
+
+    def find_by_public_key!(key)
+      find_by_public_key(key) || raise(ActiveRecord::RecordNotFound)
+    end
+  end
+
+  private
+    def publication_key_from_record
+      record = association(:publication).loaded? ? association(:publication).target : association(:publication).reader
+      return unless record&.persisted?
+
+      record.publication_key.presence
+    end
+
+    def just_unpublished?
+      (saved_change_to_published? && !self[:published]) ||
+        (saved_change_to_published_at? && self[:published_at].blank?) ||
+        (saved_change_to_publication_key? && self[:publication_key].blank?) ||
+        (saved_change_to_public_key? && self[:public_key].blank?) ||
+        (saved_change_to_key? && self[:key].blank?)
+    end
+
+    def clearing_publication_key?
+      (will_save_change_to_publication_key? && self[:publication_key].blank?) ||
+        (will_save_change_to_public_key? && self[:public_key].blank?) ||
+        (will_save_change_to_key? && self[:key].blank?)
+    end
+
+    def clear_publication_metadata
+      self[:publication_key] = nil
+      self[:public_key] = nil
+      self[:key] = nil
+      self[:published] = false
+      self[:published_at] = nil
+    end
+
+    def destroy_publication_after_unpublish
+      publication_record = association(:publication).reader
+      publication_record.destroy! if publication_record&.persisted?
+      association(:publication).reset
+    end
+
+    def publishing?
+      (will_save_change_to_published? && self[:published]) ||
+        (will_save_change_to_published_at? && self[:published_at].present?)
+    end
+
+    def unpublishing?
+      (will_save_change_to_published? && !self[:published]) ||
+        (will_save_change_to_published_at? && self[:published_at].blank?)
+    end
+
+    def ensure_publication_key
+      return if publication_key.present?
+
+      key = generate_unique_publication_key
+      self[:publication_key] = key
+      self[:public_key] = key
+      self[:key] = key
+    end
+
+    def clear_publication_key
+      self[:publication_key] = nil
+      self[:public_key] = nil
+      self[:key] = nil
+      self[:published_at] = nil
+      self[:published] = false
+    end
+
+    def generate_unique_publication_key
+      loop do
+        candidate = SecureRandom.base58(24)
+        break candidate unless publication_key_taken?(candidate)
+      end
+    end
+
+    def publication_key_taken?(candidate)
+      self.class.unscoped.where(
+        "boards.publication_key = :candidate OR boards.public_key = :candidate OR boards.`key` = :candidate",
+        candidate: candidate
+      ).exists? || Board::Publication.where(
+        "board_publications.`key` = :candidate OR board_publications.publication_key = :candidate OR " \
+        "board_publications.public_key = :candidate OR board_publications.token = :candidate",
+        candidate: candidate
+      ).exists?
+    end
+
+    def public_url_options
+      base =
+        if (request = Current.try(:request))
+          { host: request.host, protocol: request.protocol, port: request.port }
+        elsif Rails.application.routes.default_url_options.present?
+          Rails.application.routes.default_url_options
+        elsif Rails.env.test?
+          { host: "www.example.com", protocol: "http" }
+        else
+          Rails.application.config.action_mailer.default_url_options || {}
+        end
+
+      base.merge(script_name: nil).compact
+    end
+end
