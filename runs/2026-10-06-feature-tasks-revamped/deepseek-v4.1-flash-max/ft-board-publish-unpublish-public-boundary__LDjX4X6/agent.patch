+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to @board.name, public_board_path(@board.publication_key) %>
+  </h1>
+<% end %>
+
+<article class="card card-perma" id="<%= dom_id(@card) %>">
+  <header class="card__header">
+    <p class="card__number">#<%= @card.number %></p>
+    <h1 class="card__title"><%= card_html_title(@card) %></h1>
+
+    <% if @card.tags.any? %>
+      <div class="card__tags"><%= @card.tags.map(&:title).sort.join(", ") %></div>
+    <% end %>
+  </header>
+
+  <% if @card.column %>
+    <p class="card__column-name">
+      In <%= link_to @card.column.name, public_board_column_path(@board.publication_key, @card.column) %>
+    </p>
+  <% end %>
+
+  <% if @card.image.attached? %>
+    <figure class="card__image">
+      <%= image_tag url_for(@card.image) %>
+    </figure>
+  <% end %>
+
+  <% if @card.description.present? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <section class="comments">
+    <h2>Comments</h2>
+
+    <% @card.comments.chronologically.each do |comment| %>
+      <div class="comment" id="<%= dom_id(comment) %>">
+        <strong><%= comment.creator.name %></strong>
+        <div class="comment__body"><%= comment.body %></div>
+      </div>
+    <% end %>
+  </section>
+</article>
