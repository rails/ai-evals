+<% @page_title = @board.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @board.name %></h1>
+<% end %>
+
+<section class="public-board card-columns" id="cards_container">
+  <h1><%= @board.name %></h1>
+
+  <% @columns.each do |column| %>
+    <section class="public-board__column cards--doing" id="<%= dom_id(column) %>">
+      <header>
+        <h2>
+          <%= link_to column.name, public_board_column_path(@board.publication_key, column) %>
+        </h2>
+      </header>
+
+      <div class="cards__list" id="<%= dom_id(column, :cards) %>">
+        <% column.cards.published.order(:number).each do |card| %>
+          <%= render "public/cards/card", card: card %>
+        <% end %>
+      </div>
+    </section>
+  <% end %>
+
+  <% if @other_cards.any? %>
+    <section class="public-board__column cards--maybe">
+      <header>
+        <h2>Maybe?</h2>
+      </header>
+
+      <div class="cards__list">
+        <% @other_cards.each do |card| %>
+          <%= render "public/cards/card", card: card %>
+        <% end %>
+      </div>
+    </section>
+  <% end %>
+</section>
