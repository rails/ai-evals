@@ -0,0 +1,27 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public board</h2>
+
+    <% if board.published? %>
+      <p>Anyone with this secret link can view this board:</p>
+
+      <p>
+        <%= link_to board.public_url, board.public_url, class: "overflow-ellipsis" %>
+      </p>
+
+      <div class="flex gap-half">
+        <input class="input full-width txt-small" type="text" readonly value="<%= board.public_url %>" aria-label="Public board URL">
+      </div>
+
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative" do %>
+        <span>Unpublish board</span>
+      <% end %>
+    <% else %>
+      <p>Publish this board to share it with anyone who has the secret link.</p>
+
+      <%= button_to board_publication_path(board), method: :post, class: "btn" do %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
