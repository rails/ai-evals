diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..17e1459 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,57 @@
 module TimeHelper
+  # Renders a <time> element whose text is replaced in the browser with a
+  # localized value. The server only provides the machine-readable timestamp,
+  # so responses can be cached and shared between viewers in different
+  # timezones.
+  def local_time_value(time, format = nil, **options)
+    format = options.delete(:format) || format || :relative
+    classes = [ "local-time-value", options.delete(:class) ].compact.join(" ")
+    data = {
+      controller: "local-time-value",
+      action: "turbo:morph-element->local-time-value#update",
+      local_time_value_format_value: format
+    }.merge(options.delete(:data) || {})
+
+    timestamp = time.respond_to?(:utc) ? time.utc.iso8601 : time.iso8601
+
+    tag.time timestamp,
+      class: classes,
+      datetime: timestamp,
+      data: data,
+      **options
+  end
+
+  alias_method :local_time, :local_time_value
+  alias_method :local_time_tag, :local_time_value
+  def time_ago_value(time, **options)
+    local_time_value time, format: :time_ago, **options
+  end
+
+  def local_time_ago(time, **options)
+    local_time_value time, format: :time_ago, **options
+  end
+
+  def local_time_or_date(time, **options)
+    local_time_value time, format: :time_or_date, **options
+  end
+
+  def local_date_value(time, **options)
+    local_time_value time, format: :date, **options
+  end
+
+  def local_short_date_value(time, **options)
+    local_time_value time, format: :short_date, **options
+  end
+
+  def local_time_of_day_value(time, **options)
+    local_time_value time, format: :time, **options
+  end
+
+  def relative_time(time, **options)
+    local_time_value time, format: :relative, **options
+  end
+
+  def day_time(time, **options)
+    local_time_value time, format: :day, **options
+  end
 end
