diff --git a/app/javascript/controllers/local_time_value_controller.js b/app/javascript/controllers/local_time_value_controller.js
new file mode 100644
index 0000000..7c252fa
--- /dev/null
+++ b/app/javascript/controllers/local_time_value_controller.js
@@ -0,0 +1,16 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  connect() {
+    this.update()
+  }
+
+  update() {
+    const datetime = this.element.getAttribute("datetime")
+    if (!datetime) return
+
+    const format = this.element.dataset.localTimeValueFormatValue || this.element.dataset.format || "relative"
+    this.element.textContent = formatLocalTime(new Date(datetime), format)
+  }
+}
