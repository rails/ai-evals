 export default class extends Controller {
+  static values = { timezoneUpdateUrl: String, userTimezone: String }
+
   connect() {
     this.#setTimezoneCookie()
+    this.#updateUserTimezone()
   }
 
   #setTimezoneCookie() {
     const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
     document.cookie = `timezone=${encodeURIComponent(timezone)}; path=/`
   }
+
+  #updateUserTimezone() {
+    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+    if (!this.hasTimezoneUpdateUrlValue || !this.userTimezoneValue || timezone === this.userTimezoneValue) return
