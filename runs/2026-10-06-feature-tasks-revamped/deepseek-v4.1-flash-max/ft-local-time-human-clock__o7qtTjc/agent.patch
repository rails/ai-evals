diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..ac3a336
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,31 @@
+import { formatLocalTime } from "helpers/date_helpers"
+
+const FORMATTED_FLAG = "localTimeValueFormatted"
+
+function formatTimes(root = document) {
+  root.querySelectorAll("time.local-time-value[datetime]").forEach((element) => formatTime(element))
+}
+
+function formatTime(element) {
+  const format = element.dataset.localTimeValueFormatValue || element.dataset.format || inferredFormat(element)
+  const formatted = formatLocalTime(new Date(element.getAttribute("datetime")), format)
+
+  if (formatted) {
+    element.textContent = formatted
+    element.dataset[FORMATTED_FLAG] = "true"
+  }
+}
+
+function inferredFormat(element) {
+  if (element.classList.contains("events__day-time")) return "day"
+  if (element.classList.contains("event__timestamp")) return "time"
+  return "relative"
+}
+
+document.addEventListener("DOMContentLoaded", () => formatTimes())
+document.addEventListener("turbo:load", () => formatTimes())
+document.addEventListener("turbo:render", () => formatTimes())
+document.addEventListener("turbo:morph", () => formatTimes())
+document.addEventListener("turbo:morph-element", (event) => {
+  if (event.target instanceof Element && event.target.matches("time.local-time-value[datetime]")) formatTime(event.target)
+})
