+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <div class="flex flex-column gap-half">
+      <div>
+        Plan:
+        <strong><%= @account.comped? ? "Comped" : @account.current_plan.proper_name %></strong>
+      </div>
+
+      <div>
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
