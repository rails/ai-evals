+          </div>
+
+          <div class="flex flex-column gap-quarter">
+            <%= form.label :bytes_used, "Bytes used" %>
+            <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0 %>
+          </div>
+
+          <%= form.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <% if @account.overridden_limit.present? %>
