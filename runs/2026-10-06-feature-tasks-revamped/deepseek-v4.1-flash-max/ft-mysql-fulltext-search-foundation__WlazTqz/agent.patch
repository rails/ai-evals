+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do %>
+    <label class="for-screen-reader" for="q">Search</label>
+    <%= text_field_tag :q, @query, id: "q", type: "search", role: "searchbox",
+          placeholder: "Search cards by title, description, or comments…",
+          class: "input input--transparent full-width txt-small", autofocus: true,
+          autocorrect: "off", autocomplete: "off", data: { "1p-ignore": "true" } %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <h2 class="search__summary txt-small">Search results for “<%= @query %>”</h2>
+
+    <% if @page.records.any? %>
+      <section class="cards cards--grid search-results">
+        <div class="cards__list hide-scrollbar">
+          <%= with_automatic_pagination :search_results, @page do %>
+            <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { query: @query } %>
+          <% end %>
+        </div>
+      </section>
+    <% else %>
+      <div class="blank-slate">No cards found for “<%= @query %>”</div>
+    <% end %>
+  <% else %>
+    <div class="blank-slate">Search cards by title, description, or comments</div>
+  <% end %>
+</section>
