@@ -0,0 +1,30 @@
+module SearchesHelper
+  include SearchHighlightHelper
+
+  def search_terms(query)
+    query.to_s.scan(/\S+/).uniq
+  end
+
+  def search_phrases(query)
+    query = query.to_s.strip
+    phrases = search_terms(query)
+    phrases.unshift(query) if query.present?
+    phrases.uniq
+  end
+
+  def search_highlight(text, query)
+    highlight_search_terms(text, search_phrases(query))
+  end
+
+  def search_snippet(text, query)
+    text = text.to_s
+
+    if phrase = search_phrases(query).find { |candidate| text.match?(/#{Regexp.escape(candidate)}/i) }
+      excerpt(text, phrase, radius: 100, omission: "…")
+    end
+  end
+
+  def search_matching_comments(card)
+    Array(@matching_comments_by_card&.[](card.id))
+  end
+end
