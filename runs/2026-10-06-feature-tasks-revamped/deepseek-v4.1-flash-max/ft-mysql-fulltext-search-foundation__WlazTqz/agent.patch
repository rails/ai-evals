@@ -0,0 +1,29 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from searchable_cards
+    @matching_comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def searchable_cards
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically.preloaded
+    end
+
+    def matching_comments_by_card
+      terms = @query.scan(/\S+/).uniq
+
+      if @page.records.any? && terms.any?
+        conditions = Array.new(terms.size, "INSTR(LOWER(action_text_rich_texts.body), LOWER(?)) > 0").join(" OR ")
+
+        Comment.joins(:rich_text_body)
+          .where(card_id: @page.records)
+          .where(conditions, *terms)
+          .chronologically
+          .includes(:creator, :rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
