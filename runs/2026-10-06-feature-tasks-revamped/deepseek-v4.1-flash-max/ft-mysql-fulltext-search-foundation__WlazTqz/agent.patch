diff --git a/app/helpers/search_highlight_helper.rb b/app/helpers/search_highlight_helper.rb
new file mode 100644
index 0000000..75af781
--- /dev/null
+++ b/app/helpers/search_highlight_helper.rb
@@ -0,0 +1,20 @@
+module SearchHighlightHelper
+  def highlight_search_terms(text, phrases)
+    phrases = Array(phrases).reject(&:blank?).sort_by { |phrase| -phrase.length }
+    return escape_search_text(text) if phrases.empty?
+
+    pattern = /(#{phrases.map { |phrase| Regexp.escape(phrase) }.join("|")})/i
+
+    text.to_s.split(pattern).map.with_index do |part, index|
+      if index.odd?
+        "<mark>#{escape_search_text(part)}</mark>"
+      else
+        escape_search_text(part)
+      end
+    end.join.html_safe
+  end
+
+  def escape_search_text(text)
+    ERB::Util.html_escape(text.to_s).gsub("&#39;", "'").gsub("&quot;", '"')
+  end
+end
