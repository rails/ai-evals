diff --git a/test/controllers/search_page_test.rb b/test/controllers/search_page_test.rb
new file mode 100644
index 0000000..e6a61fd
--- /dev/null
+++ b/test/controllers/search_page_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class SearchPageTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title and wraps matches in mark" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "mark", text: /logo/i
+    assert_select "a[href=?]", card_path(cards(:logo))
+  end
+
+  test "finds cards by description" do
+    card = create_published_card title: "Colors", description: "We need a chartreuse redesign"
+
+    get search_path(q: "chartreuse")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "mark", text: /chartreuse/i
+    assert_select "a[href=?]", card_path(card)
+  end
+
+  test "finds cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select "mark", text: /overflowing/i
+  end
+
+  test "matches every term in the query" do
+    card = create_published_card title: "Alpha beta gamma"
+
+    get search_path(q: "alpha gamma")
+    assert_select "a[href=?]", card_path(card)
+
+    get search_path(q: "alpha delta")
+    assert_select "a[href=?]", card_path(card), count: 0
+  end
+
+  test "does not return draft cards" do
+    draft = create_card title: "Draft xylophone", status: "drafted"
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_no_match draft.title, response.body
+  end
+
+  test "does not return draft cards that have matching comments" do
+    draft = create_card title: "Untitled", status: "drafted"
+    comment = Comment.new(card: draft, account: draft.account, creator: users(:kevin), body: "Draft xylophone secret")
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_no_match "Draft xylophone secret", response.body
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    secret_card = create_card title: "Secret xylophone", board: boards(:private)
+
+    logout_and_sign_in_as :jz
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_no_match secret_card.title, response.body
+  end
+
+  test "stops returning cards when board access is revoked" do
+    create_card title: "Secret xylophone", board: boards(:private)
+
+    get search_path(q: "xylophone")
+    assert_select "article.card", count: 1
+
+    accesses(:private_kevin).destroy
+    get search_path(q: "xylophone")
+    assert_select "article.card", count: 0
+  end
+
+  test "returns cards ordered newest first as JSON" do
+    older = create_card title: "Zebra older", created_at: 2.days.ago
+    newer = create_card title: "Zebra newer", created_at: 1.day.ago
+
+    get search_path(q: "zebra", format: :json)
+
+    assert_response :success
+    assert_equal [ newer.number, older.number ], @response.parsed_body.pluck("number")
+  end
+
+  test "is case insensitive and treats special characters literally" do
+    get search_path(q: "LOGO")
+    assert_select "mark", text: /logo/i
+
+    get search_path(q: "%")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "treats wildcard characters literally when they are present in the card" do
+    create_card title: "100% complete"
+
+    get search_path(q: "100%")
+
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "mark", text: "100%"
+  end
+
+  test "returns no results for a blank query" do
+    get search_path(q: "  ")
+
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_select "mark", count: 0
+  end
+
+  private
+    def create_card(title:, description: nil, board: boards(:writebook), status: "published", created_at: nil)
+      with_current_user(users(:kevin)) do
+        attributes = { title: title, creator: users(:kevin), status: status }
+        attributes[:description] = description if description
+        attributes[:created_at] = created_at if created_at
+        board.cards.create!(attributes)
+      end
+    end
+
+    def create_published_card(**attributes)
+      create_card(**attributes)
+    end
+end
