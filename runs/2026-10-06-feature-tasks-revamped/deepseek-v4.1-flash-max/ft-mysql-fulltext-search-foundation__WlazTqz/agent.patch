+++ b/test/models/card/search_query_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Card::SearchQueryTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "search matches cards by title" do
+    assert_equal [ cards(:logo) ], Card.search("logo").to_a
+  end
+
+  test "search matches cards by description" do
+    card = boards(:writebook).cards.create!(
+      title: "Colors",
+      creator: users(:david),
+      status: :published,
+      description: "We need a chartreuse redesign"
+    )
+
+    assert_equal [ card ], Card.search("chartreuse").to_a
+  end
+
+  test "search matches cards by comment body" do
+    assert_equal [ cards(:layout) ], Card.search("overflowing").to_a
+  end
+
+  test "search requires every term" do
+    card = boards(:writebook).cards.create!(title: "Alpha beta gamma", creator: users(:david), status: :published)
+
+    assert_equal [ card ], Card.search("alpha gamma").to_a
+    assert_empty Card.search("alpha delta")
+  end
+
+  test "search treats special characters literally" do
+    card = boards(:writebook).cards.create!(title: "100% complete", creator: users(:david), status: :published)
+
+    assert_equal [ card ], Card.search("100%").to_a
+  end
+
+  test "search returns no cards for a blank query" do
+    assert_empty Card.search(nil)
+    assert_empty Card.search("")
+    assert_empty Card.search("  ")
+  end
+end
