+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :subscribed_to, ->(action) { where("subscribed_actions LIKE ?", "%\"#{action}\"%") }
+    scope :triggerable_by, ->(event) { active.where(board_id: event.board_id).subscribed_to(event.action) }
+  end
+
+  class_methods do
+    def triggerable(event)
+      triggerable_by(event)
+    end
+
+    def subscribed_to_action(action)
+      subscribed_to(action)
+    end
+
+    alias_method :triggerable_for, :triggerable
+    alias_method :triggered_by, :triggerable
+    alias_method :for_event, :triggerable
+  end
+
+  def trigger_webhooks
+    board.webhooks.triggerable_by(self).find_each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+
+  alias_method :deliver_webhooks, :trigger_webhooks
+end
