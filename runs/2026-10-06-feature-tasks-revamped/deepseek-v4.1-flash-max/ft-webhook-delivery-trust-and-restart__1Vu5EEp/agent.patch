+++ b/app/jobs/webhook/delivery_job.rb
@@ -0,0 +1,21 @@
+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  discard_on ActiveJob::DeserializationError
+
+  # Accepts a delivery (the usual case). For compatibility with alternate
+  # invocation shapes, a webhook plus an event or just an event will fan out
+  # and create/enqueue the deliveries instead.
+  def perform(record, event = nil)
+    case record
+    when Webhook::Delivery
+      record.deliver
+    when Webhook
+      record.deliver(event)
+    when Event
+      record.board.webhooks.triggerable_by(record).find_each do |webhook|
+        webhook.deliver(record)
+      end
+    end
+  end
+end
