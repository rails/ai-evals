   end
+
+  alias_method :body, :payload
+  alias_method :deliver!, :deliver
+  alias_method :perform, :deliver
+  alias_method :request_body, :payload
+  alias_method :headers, :request_headers
+
+  private
+    def claim!
+      with_lock do
+        return false unless pending?
+
+        in_progress!
+        true
+      end
+    end
+
+    def just_finished?
+      saved_change_to_state? && (completed? || errored?)
+    end
+
+    def track_delinquency
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+      tracker.track(self)
+    end
+
+    def post
+      uri = URI.parse(webhook.url)
+      http_request = Net::HTTP::Post.new(uri)
+
+      request_headers.each { |name, value| http_request[name] = value }
+      http_request.body = payload
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.request(http_request)
+    end
+
+    def record_response(http_response)
+      update!(
+        state: :completed,
+        request: { headers: request_headers },
+        response: { code: http_response.code.to_i, error: nil, headers: http_response.to_hash }
+      )
+    end
+
+    def record_error(error)
+      update!(
+        state: :errored,
+        request: { headers: request_headers },
+        response: { error: error_code_for(error) }
+      )
+    end
+
+    def error_code_for(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "connection_timeout"
+      when Socket::ResolutionError, SocketError, Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH
+        "destination_unreachable"
+      when OpenSSL::SSL::SSLError
+        "ssl_error"
+      else
+        error.message
+      end
+    end
+
+    def timestamp
+      event.created_at.utc.iso8601(3)
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def generate_payload
+      if webhook.for_slack?
+        { text: chat_message }.to_json
+      elsif webhook.for_campfire?
+        { message: { body: chat_html } }.to_json
+      elsif webhook.for_basecamp?
+        { content: chat_html }.to_json
+      else
+        event_json
+      end
+    end
+
+    def event_json
+      render "webhooks/event", assigns: { event: event }, formats: [ :json ]
+    end
+
+    def chat_html
+      render "webhooks/event", assigns: { event: event }, formats: [ :html ], layout: false
+    end
+
+    def chat_message
+      event.description_for(event.creator).to_plain_text
+    end
+
+    def render(template, assigns:, formats:, layout: false)
+      renderer = ApplicationController.renderer.new(script_name: webhook.account.slug)
+      Current.with_account(webhook.account) do
+        renderer.render(template: template, assigns: assigns, formats: formats, layout: layout)
+      end
+    end
 end
