diff --git a/saas/config/initializers/billing_aliases.rb b/saas/config/initializers/billing_aliases.rb
new file mode 100644
index 0000000..f4c2023
--- /dev/null
+++ b/saas/config/initializers/billing_aliases.rb
@@ -0,0 +1,15 @@
+# Keep top-level aliases for callers and fixtures that refer to the account
+# billing models without the Account:: namespace.
+Rails.application.config.after_initialize do
+  next unless defined?(Account::Subscription)
+
+  {
+    "AccountSubscription" => "Account::Subscription",
+    "AccountOverriddenLimit" => "Account::OverriddenLimit",
+    "AccountBillingWaiver" => "Account::BillingWaiver"
+  }.each do |const_name, qualified_name|
+    next if Object.const_defined?(const_name, false)
+
+    Object.const_set const_name, qualified_name.constantize
+  end
+end
