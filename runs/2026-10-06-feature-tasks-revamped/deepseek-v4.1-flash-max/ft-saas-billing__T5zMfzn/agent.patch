+module Account::StripeBilling
+  extend ActiveSupport::Concern
+
+  included do
+    set_callback :cancel, :after, :cancel_stripe_subscription_at_period_end
+    set_callback :incinerate, :before, :cancel_stripe_subscription_now
+  end
+
+  private
+    def cancel_stripe_subscription_at_period_end
+      subscription&.cancel!
+    rescue => error
+      report_stripe_error(error)
+    end
+
+    def cancel_stripe_subscription_now
+      subscription&.cancel_now!
+    rescue => error
+      report_stripe_error(error)
+    end
+
+    def report_stripe_error(error)
+      Rails.error.report(error, handled: true, severity: :warning) if Rails.respond_to?(:error)
+    end
+end
