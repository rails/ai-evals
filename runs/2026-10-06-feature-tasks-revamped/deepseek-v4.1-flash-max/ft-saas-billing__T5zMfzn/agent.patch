+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <div class="flex flex-column gap-half">
+      <div>
+        <strong>Account ID:</strong>
+        #<%= @account.external_account_id %>
+      </div>
+      <div>
+        <strong>Plan:</strong>
+        <%= @account.plan_name %>
+      </div>
+      <div>
+        <strong>Status:</strong>
+        <%= @account.comped? ? "Comped" : "Not comped" %>
+      </div>
+      <div>
+        <strong>Card count:</strong>
+        <%= number_with_delimiter(@account.cards_count) %>
+        <% if @account.card_limit %>
+          of <%= number_with_delimiter(@account.card_limit) %>
+        <% else %>
+          (unlimited)
+        <% end %>
+      </div>
+      <div>
+        <strong>Bytes used:</strong>
+        <%= number_to_human_size(@account.bytes_used) %>
+        of <%= number_to_human_size(@account.storage_limit) %>
+      </div>
+      <% if @account.overridden_limit %>
+        <div>
+          <strong>Card count override:</strong>
+          <%= @account.overridden_card_count %>
+        </div>
+        <div>
+          <strong>Bytes used override:</strong>
+          <%= number_to_human_size(@account.overridden_bytes_used) %>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="flex gap-half margin-block-start">
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Limits</h2>
+    </header>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+      <label class="flex flex-column gap-quarter">
+        <span>Card count</span>
+        <%= form.number_field :card_count, value: @account.overridden_card_count, class: "input", min: 0, placeholder: "e.g. 5000" %>
+      </label>
+
+      <label class="flex flex-column gap-quarter">
+        <span>Bytes used</span>
+        <%= form.number_field :bytes_used, value: @account.overridden_bytes_used, class: "input", min: 0, placeholder: "e.g. 10737418240" %>
+      </label>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :delete, class: "btn btn--negative", disabled: @account.overridden_limit.blank? %>
+    </div>
+  </div>
+</section>
