+  </div>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card card-perma" style="--card-color: <%= @card.color %>;">
+  <% if @card.image.attached? %>
+    <div class="card-perma__image">
+      <%= image_tag @card.image %>
+    </div>
+  <% end %>
+
+  <div class="card-perma__bg">
+    <header class="card__header">
+      <span class="card__number">#<%= @card.number %></span>
+      <strong class="card__title"><%= @card.title %></strong>
+      <% if @card.column %>
+        <%= link_to @card.column.name, public_board_column_path(@board.secret_key, @card.column), class: "card__column-name" %>
+      <% end %>
+    </header>
+
+    <div class="card__body">
+      <div class="card__content">
+        <%= @card.description.to_s %>
+      </div>
+    </div>
+
+    <footer class="card__footer">
+      <% if @card.assignees.any? %>
+        <div class="card__assignees">
+          <%= @card.assignees.map(&:name).to_sentence %>
+        </div>
+      <% end %>
+
+      <% if @card.tags.any? %>
+        <div class="card__tags">
+          <% @card.tags.each do |tag| %>
+            <span class="tag"><%= tag.title %></span>
+          <% end %>
+        </div>
+      <% end %>
+    </footer>
+  </div>
+</article>
+
+<% if @card.steps.any? %>
+  <section class="steps">
+    <h2 class="divider">Steps</h2>
+    <ul>
+      <% @card.steps.each do |step| %>
+        <li class="step"><%= step.content %></li>
+      <% end %>
+    </ul>
+  </section>
+<% end %>
+
+<% if @card.comments.any? %>
+  <section class="comments">
+    <h2 class="divider">Comments</h2>
+    <% @card.comments.order(:created_at).each do |comment| %>
+      <article class="comment">
+        <strong class="comment__creator"><%= comment.creator.name %></strong>
+        <div class="comment__body"><%= comment.body.to_s %></div>
+      </article>
+    <% end %>
+  </section>
+<% end %>
