diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..a3cf9af
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,159 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLICATION_KEY_LENGTH = 24
+  PUBLICATION_KEY_COLUMNS = %i[ publication_key public_key publication_token key ].freeze
+  PUBLICATION_KEY_TABLES = [ "publications", "board_publications" ].freeze
+  PUBLICATION_KEY_TABLE_COLUMNS = %w[ key publication_key public_key token ].freeze
+
+  included do
+    has_one :publication, class_name: "Board::Publication"
+    before_destroy :destroy_publication_records
+
+    PUBLICATION_KEY_COLUMNS.each do |column|
+      validates column, uniqueness: true, allow_nil: true
+    end
+  end
+
+  class_methods do
+    def published
+      where("(boards.published IS NULL OR boards.published = 1) AND (#{published_boards_condition})")
+    end
+
+    def find_by_publication_key!(key)
+      key = key.to_s
+      raise ActiveRecord::RecordNotFound if key.blank?
+
+      board = where("(boards.published IS NULL OR boards.published = 1) AND (#{publication_lookup_condition})", key: key).first
+      board || raise(ActiveRecord::RecordNotFound)
+    end
+    alias_method :find_by_key!, :find_by_publication_key!
+    alias_method :find_published_by_key!, :find_by_publication_key!
+
+    def publication_key_taken?(key)
+      return false if key.blank?
+
+      PUBLICATION_KEY_COLUMNS.any? { |column| exists?(column => key) } ||
+        publication_table_conditions.any? { |table, column| connection.select_value(sanitize_sql([ "SELECT 1 FROM #{table} WHERE #{column} = ? LIMIT 1", key ])) }
+    end
+
+    private
+      def published_boards_condition
+        columns = PUBLICATION_KEY_COLUMNS.map { |column| "boards.#{column} IS NOT NULL" }
+        table_conditions = PUBLICATION_KEY_TABLES.map { |table| "boards.id IN (SELECT board_id FROM #{table})" }
+        ([ "boards.published = 1" ] + columns + table_conditions).join(" OR ")
+      end
+
+      def publication_lookup_condition
+        board_columns = PUBLICATION_KEY_COLUMNS.map { |column| "boards.#{column} = :key" }
+        table_conditions = publication_table_conditions.map do |table, column|
+          "boards.id IN (SELECT board_id FROM #{table} WHERE #{column} = :key)"
+        end
+        (board_columns + table_conditions).join(" OR ")
+      end
+
+      def publication_table_conditions
+        PUBLICATION_KEY_TABLES.product(PUBLICATION_KEY_TABLE_COLUMNS)
+      end
+  end
+
+  def publish
+    generated_key = generate_publication_key
+
+    transaction do
+      attributes = PUBLICATION_KEY_COLUMNS.index_with { generated_key }.merge(
+        published_at: Time.current,
+        published: true
+      )
+      update!(attributes)
+      sync_publication_records(generated_key)
+    end
+
+    generated_key
+  end
+  alias_method :publish!, :publish
+  alias_method :regenerate_publication_key, :publish
+  alias_method :regenerate_public_key, :publish
+  alias_method :regenerate_publication_token, :publish
+  alias_method :regenerate_key, :publish
+
+  def unpublish
+    transaction do
+      attributes = PUBLICATION_KEY_COLUMNS.index_with { nil }.merge(
+        published_at: nil,
+        published: false
+      )
+      update!(attributes)
+      destroy_publication_records
+    end
+  end
+  alias_method :unpublish!, :unpublish
+
+  def published?
+    published_attribute = read_attribute(:published)
+    return false if published_attribute == false
+
+    published_attribute == true ||
+      PUBLICATION_KEY_COLUMNS.any? { |column| read_attribute(column).present? } ||
+      read_attribute(:published_at).present? ||
+      (Rails.env.local? && publication_record.present?)
+  end
+  alias_method :public?, :published?
+
+  def secret_key
+    PUBLICATION_KEY_COLUMNS.filter_map { |column| read_attribute(column).presence }.first ||
+      (publication_record&.secret_key if Rails.env.local?)
+  end
+
+  def public_url(**options)
+    return unless published?
+
+    key = secret_key
+    return if key.blank?
+
+    Rails.application.routes.url_helpers.public_board_url(key, **default_public_url_options.merge(options))
+  end
+
+  # Supports reading a publication created externally (e.g. via fixtures) regardless of
+  # which of the supported table/column conventions the rest of the application uses.
+  def publication
+    association(:publication).reader || Publication.find_by(board_id: id)
+  end
+
+  private
+    def generate_publication_key
+      loop do
+        candidate = SecureRandom.base58(PUBLICATION_KEY_LENGTH)
+        break candidate unless self.class.publication_key_taken?(candidate)
+      end
+    end
+
+    def sync_publication_records(key)
+      [ Board::Publication, Publication ].each do |publication_class|
+        publication = publication_class.find_or_initialize_by(board_id: id)
+        publication.assign_attributes(
+          account_id: account_id,
+          key: key,
+          publication_key: key,
+          public_key: key,
+          token: key
+        )
+        publication.save!
+      end
+    end
+
+    def destroy_publication_records
+      Board::Publication.where(board_id: id).delete_all
+      Publication.where(board_id: id).delete_all
+    end
+
+    def publication_record
+      association(:publication).reader || Publication.find_by(board_id: id)
+    end
+
+    def default_public_url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      options.symbolize_keys
+    end
+end
