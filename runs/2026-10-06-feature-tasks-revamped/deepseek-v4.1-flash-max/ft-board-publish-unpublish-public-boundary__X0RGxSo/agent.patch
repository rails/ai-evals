+<%= turbo_frame_tag dom_id(board, :publication) do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Publish</h2>
+
+    <% if board.published? && board.secret_key.present? %>
+      <p>Anyone with this secret link can view the board:</p>
+      <p class="overflow-ellipsis">
+        <%= link_to public_board_url(board.secret_key), public_board_path(board.secret_key) %>
+      </p>
+
+      <%= button_to "Unpublish", board_publication_path(board), method: :delete,
+            class: "btn", disabled: !Current.user.can_administer_board?(board) %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to share it with anyone who has the secret link.</p>
+
+      <%= button_to "Publish", board_publication_path(board),
+            class: "btn", disabled: !Current.user.can_administer_board?(board) %>
+    <% end %>
+  </div>
+<% end %>
