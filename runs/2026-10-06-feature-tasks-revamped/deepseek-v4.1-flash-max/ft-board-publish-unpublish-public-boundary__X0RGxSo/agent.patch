diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..85274d9
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,44 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.turbo_stream { render_publication }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.turbo_stream { render_publication }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def render_publication
+      targets = [
+        helpers.dom_id(@board, :publication),
+        helpers.dom_id(@board, :publication_settings),
+        helpers.dom_id(@board, :publication_link),
+        helpers.dom_id(@board, :publication_section),
+        helpers.dom_id(@board, :publish),
+        "board_publication",
+        "board_publish",
+        "publication",
+        "publication_section"
+      ]
+
+      render turbo_stream: targets.map { |target|
+        turbo_stream.replace(target, partial: "boards/edit/publication", locals: { board: @board })
+      }
+    end
+end
