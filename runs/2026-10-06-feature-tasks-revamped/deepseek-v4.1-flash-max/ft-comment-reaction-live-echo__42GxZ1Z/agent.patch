diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..d5a450d
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,40 @@
+module ReactionsHelper
+  def reactions_for(reactable)
+    if reactable.is_a?(Card)
+      Reaction.where(card_id: reactable.id).or(Reaction.where(reactable_type: "Card", reactable_id: reactable.id)).where(comment_id: nil)
+    else
+      Reaction.where(comment_id: reactable.id).or(Reaction.where(reactable_type: "Comment", reactable_id: reactable.id))
+    end
+  end
+
+  def reaction_form_model(reactable)
+    if reactable.is_a?(Comment)
+      [ reactable.card, reactable, Reaction.new ]
+    else
+      [ reactable, Reaction.new ]
+    end
+  end
+
+  def reaction_path(reaction)
+    if reaction.comment
+      card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction)
+    else
+      card_reaction_path(reaction.card, reaction)
+    end
+  end
+
+  def reaction_url(reaction)
+    if reaction.comment
+      card_comment_reaction_url(reaction.comment.card, reaction.comment, reaction)
+    else
+      card_reaction_url(reaction.card, reaction)
+    end
+  end
+
+  def reaction_content_tag(reaction)
+    classes = [ "txt-small" ]
+    classes << "txt-medium" if EmojiHelper::REACTIONS.key?(reaction.content)
+
+    tag.span reaction.content, class: classes
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..a7357cc
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction")
+    this.formTarget.querySelector(".reaction__form")?.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.#close()
+    this.triggerTarget.focus()
+  }
+
+  #close() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction")
+    this.triggerTarget.hidden = false
+    this.inputTarget.value = ""
+    this.formTarget.querySelector(".reaction__form")?.classList.remove("expanded")
+    this.formTarget.querySelector("details[open]")?.removeAttribute("open")
+  }
+}
