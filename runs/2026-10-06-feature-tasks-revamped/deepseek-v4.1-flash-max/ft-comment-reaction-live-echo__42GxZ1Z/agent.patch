@@ -0,0 +1,65 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: %i[ new create ]
+
+  def index
+    @reactions = comment_reactions.chronologically
+    fresh_when etag: @reactions
+  end
+
+  def new
+    @reaction = Reaction.new
+  end
+
+  def show
+    fresh_when etag: @reaction
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = comment_reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def comment_reactions
+      Reaction.where(comment_id: @comment.id).or(Reaction.where(reactable_type: "Comment", reactable_id: @comment.id))
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
