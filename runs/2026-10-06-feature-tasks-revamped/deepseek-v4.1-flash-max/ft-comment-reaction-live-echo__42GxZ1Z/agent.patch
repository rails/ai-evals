diff --git a/app/views/reactions/_new.html.erb b/app/views/reactions/_new.html.erb
new file mode 100644
index 0000000..9f6c7e8
--- /dev/null
+++ b/app/views/reactions/_new.html.erb
@@ -0,0 +1,49 @@
+<%= turbo_frame_tag dom_id(reactable, :new_reaction) do %>
+  <button type="button" class="reactions__trigger btn" data-reaction-target="trigger" data-action="reaction#open"
+        title="Add a reaction" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <div hidden data-reaction-target="form">
+    <%= form_with model: reaction_form_model(reactable), class: "reaction__form flex align-center",
+          data: { action: "keydown.esc->reaction#cancel" } do |form| %>
+      <label class="reaction__form-label" for="<%= dom_id(reactable, :reaction_content) %>">
+        <span class="reaction__avatar"><%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %></span>
+        <span class="for-screen-reader">Reaction</span>
+      </label>
+
+      <%= form.text_field :content, id: dom_id(reactable, :reaction_content), maxlength: 16, required: true,
+            class: "reaction__input input", placeholder: "React…", autocomplete: "off",
+            data: { reaction_target: "input" }, aria: { label: "Reaction" } %>
+
+      <div class="reaction__menu">
+        <details data-controller="details" data-details-target="details" data-action="click@document->details#closeOnClickOutside">
+          <summary class="reaction__menu-btn btn btn--circle borderless" title="Pick an emoji" aria-label="Pick an emoji">
+            <%= icon_tag "reaction" %>
+          </summary>
+
+          <div class="reaction__popup popup panel flex-column gap-half fill-white shadow txt-small">
+            <div class="reaction__emoji-list">
+              <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+                <button type="submit" name="reaction[content]" value="<%= emoji %>" class="btn btn--circle borderless"
+                      title="<%= description %>" aria-label="<%= description %>" formnovalidate><%= emoji %></button>
+              <% end %>
+            </div>
+          </div>
+        </details>
+      </div>
+
+      <button type="submit" class="reaction__submit-btn btn btn--circle borderless" title="Save reaction" aria-label="Save reaction">
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Save reaction</span>
+      </button>
+
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction#cancel"
+            title="Cancel" aria-label="Cancel">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+<% end %>
