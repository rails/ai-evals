diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..67adca3
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,41 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account || card&.account }
+  belongs_to :card, optional: true, touch: true
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :reactable, polymorphic: true, optional: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :desc }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :must_have_a_reactable
+
+  before_validation :sync_reactable_columns
+  after_create :register_card_activity
+
+  def comment
+    super || (reactable if reactable_type == "Comment")
+  end
+
+  def card
+    super || (reactable if reactable_type == "Card") || comment&.card
+  end
+
+  private
+    def must_have_a_reactable
+      errors.add(:base, "must be attached to a card or comment") unless comment_id? || card_id? || reactable_id?
+    end
+
+    def sync_reactable_columns
+      if reactable_id.present? && comment_id.blank? && card_id.blank?
+        self.comment_id = reactable_id if reactable_type == "Comment"
+        self.card_id = reactable_id if reactable_type == "Card"
+      elsif reactable_id.blank? && (comment_id.present? || card_id.present?)
+        self.reactable = comment || card
+      end
+    end
+
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
