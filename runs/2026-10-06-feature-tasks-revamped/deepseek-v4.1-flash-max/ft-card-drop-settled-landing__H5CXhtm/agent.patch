diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..47e2427
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,171 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "dragging a card onto a column moves it immediately" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    wait_for_column_cards column
+
+    start_dragging card, over: dom_id(column)
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container", visible: :all
+
+    assert drop(card, on: dom_id(column)), "The card should be in the target column as soon as it is dropped"
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+    assert_selector "##{dom_id(card, :article)}:not(.drag-and-drop__dragged-item)", visible: :all
+
+    assert_equal column, card.reload.column
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    wait_for_column_cards "not-now"
+
+    drop card, on: "not-now"
+
+    assert_selector "#not-now ##{dom_id(card, :article)}", visible: :all
+    assert card.reload.postponed?
+  end
+
+  test "dragging a card onto Done closes it" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    wait_for_column_cards "closed-cards"
+
+    drop card, on: "closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(card, :article)}", visible: :all
+    assert card.reload.closed?
+  end
+
+  test "dragging a card onto Maybe sends it back to triage" do
+    card = cards(:logo)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+
+    drop card, on: "maybe"
+
+    assert_selector "#maybe ##{dom_id(card, :article)}", visible: :all
+    assert_nil card.reload.column
+  end
+
+  test "dragging a card within its own column does nothing" do
+    card = cards(:logo)
+    column = card.column
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    wait_for_column_cards column
+
+    original_position = page.evaluate_script(
+      "Array.from(document.querySelectorAll('##{dom_id(column)} .card')).indexOf(document.getElementById('#{dom_id(card, :article)}'))"
+    )
+
+    drop card, on: dom_id(column)
+
+    assert_equal original_position, page.evaluate_script(
+      "Array.from(document.querySelectorAll('##{dom_id(column)} .card')).indexOf(document.getElementById('#{dom_id(card, :article)}'))"
+    )
+    assert_equal column, card.reload.column
+  end
+
+  test "the card stays where it was dropped after the save completes" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    wait_for_column_cards column
+
+    drop card, on: dom_id(column)
+    assert_equal column, card.reload.column
+
+    # Give a possible broadcast refresh time to arrive, then confirm the card
+    # is still the first card in the target column and no drag styles linger.
+    sleep 1
+    assert_selector "##{dom_id(column)} .cards__list > ##{dom_id(card, :article)}:first-child", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+  end
+
+test "dragging a closed card onto a column reopens it" do
+  card = cards(:shipping)
+  column = columns(:writebook_in_progress)
+
+  visit board_url(boards(:writebook))
+  assert_selector "#closed-cards ##{dom_id(card, :article)}", visible: :all
+  wait_for_column_cards column
+
+  drop card, on: dom_id(column)
+
+  assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}", visible: :all
+  assert_not card.reload.closed?
+  assert_equal column, card.reload.column
+end
+
+test "emptying a column shows its drag placeholder" do
+  card = cards(:text)
+  source_column = card.column
+
+  visit board_url(boards(:writebook))
+  assert_selector "##{dom_id(card, :article)}", visible: :all
+
+  expand_column source_column
+  assert_selector "##{dom_id(source_column)} .card", visible: true
+
+  drop card, on: "maybe"
+
+  within "##{dom_id(source_column)}" do
+    assert_selector ".blank-slate--drag", text: "Drag cards here", visible: true
+  end
+  assert_nil card.reload.column
+end
+
+  private
+    def start_dragging(card, over:)
+      execute_drag_event "dragstart", dom_id(card, :article)
+      execute_drag_event "dragover", over
+    end
+
+    def drop(card, on:)
+      start_dragging card, over: on
+      execute_drag_event "drop", on
+      execute_drag_event "dragend", dom_id(card, :article)
+
+      page.evaluate_script(
+        "document.getElementById('#{on}').contains(document.getElementById('#{dom_id(card, :article)}'))"
+      )
+    end
+
+    def execute_drag_event(event_name, id)
+      page.execute_script(<<~JS, id, event_name)
+        const target = document.getElementById(arguments[0]);
+        const dataTransfer = new DataTransfer();
+        target.dispatchEvent(new DragEvent(arguments[1], { bubbles: true, cancelable: true, dataTransfer }));
+      JS
+    end
+
+    def expand_column(column)
+      page.execute_script("document.getElementById('#{dom_id(column)}').classList.replace('is-collapsed', 'is-expanded')")
+    end
+
+    def wait_for_column_cards(column)
+      id = column.is_a?(Column) ? dom_id(column) : column
+      assert_selector "##{id} .cards__list", visible: :all
+    end
+end
