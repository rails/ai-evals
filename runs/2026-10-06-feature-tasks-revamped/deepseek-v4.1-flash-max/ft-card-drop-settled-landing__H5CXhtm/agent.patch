diff --git a/test/controllers/cards/columns_controller_test.rb b/test/controllers/cards/columns_controller_test.rb
new file mode 100644
index 0000000..aa26d89
--- /dev/null
+++ b/test/controllers/cards/columns_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Cards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "edit" do
+    card = cards(:logo)
+
+    get edit_card_column_path(card)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(card, :columns)}"
+  end
+
+  test "create moves the card to a column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "destroy sends the card back to triage" do
+    card = cards(:logo)
+
+    delete card_column_path(card), as: :json
+
+    assert_response :no_content
+    assert_nil card.reload.column
+  end
+
+  test "update moves the card to a column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: card.column, to: column do
+      patch card_column_path(card), params: { column_id: column.id }
+    end
+
+    assert_redirected_to card
+  end
+
+  test "update as JSON" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "update can send a card back to triage" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "maybe" }, as: :json
+
+    assert_response :no_content
+    assert_nil card.reload.column
+  end
+
+  test "update can postpone a card" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "not_now" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+
+  test "update can close a card" do
+    card = cards(:logo)
+
+    patch card_column_path(card), params: { column_id: "closed" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+
+  test "update reopens a closed card moved to a column" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+
+    card.close
+
+    patch card_column_path(card), params: { column_id: column.id }, as: :json
+
+    assert_response :no_content
+    assert_not card.reload.closed?
+    assert_equal column, card.column
+  end
+end
