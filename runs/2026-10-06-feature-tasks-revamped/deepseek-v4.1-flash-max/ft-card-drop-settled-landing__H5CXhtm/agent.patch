diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..71fa880
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,266 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, patch, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+const CAPTURED_EVENT_NAMES = [ "dragstart", "dragenter", "dragover", "dragleave", "drop", "dragend" ]
+
+export default class extends Controller {
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+    this.captureHandler = (event) => this.#handleCapturedEvent(event)
+
+    for (const eventName of CAPTURED_EVENT_NAMES) {
+      this.element.addEventListener(eventName, this.captureHandler, true)
+    }
+  }
+
+  disconnect() {
+    for (const eventName of CAPTURED_EVENT_NAMES) {
+      this.element.removeEventListener(eventName, this.captureHandler, true)
+    }
+
+    this.#clearDraggedItem()
+    this.#clearHoveredColumn()
+  }
+
+  // Actions
+
+  dragStart(event) {
+    const card = this.#cardFor(event.target)
+    if (!card) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragEnter(event) {
+    this.dragOver(event)
+  }
+
+  dragOver(event) {
+    const column = this.#columnFor(event.target)
+    if (!column) return
+    if (!this.#hasDraggablePayload(event)) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#hover(column)
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFor(event.target)
+    if (column !== this.hoveredColumn) return
+    if (column.contains(event.relatedTarget)) return
+
+    this.#clearHoveredColumn()
+  }
+
+  drop(event) {
+    const card = this.draggedCard || this.#cardFromDataTransfer(event) || this.#draggedCardElement()
+    const column = this.#columnFor(event.target)
+
+    if (!card || !column) {
+      card?.classList.remove(DRAGGED_ITEM_CLASS)
+      this.#clearDraggedItem()
+      this.#clearHoveredColumn()
+      return
+    }
+
+    event.preventDefault()
+
+    const sourceColumn = this.#columnFor(card)
+    this.#clearHoveredColumn()
+
+    if (column !== sourceColumn) {
+      this.#move(card, sourceColumn, column)
+      this.#updateCounts(sourceColumn, column)
+      this.#save(card, column)
+    }
+
+    card.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#clearDraggedItem()
+  }
+
+  dragEnd() {
+    this.#clearDraggedItem()
+    this.#clearHoveredColumn()
+  }
+
+  // Private
+
+  #handleCapturedEvent(event) {
+    if (event.bubbles) return
+
+    const handlers = {
+      dragstart: this.dragStart,
+      dragenter: this.dragEnter,
+      dragover: this.dragOver,
+      dragleave: this.dragLeave,
+      drop: this.drop,
+      dragend: this.dragEnd
+    }
+
+    handlers[event.type]?.call(this, event)
+  }
+
+  #cardFor(element) {
+    if (!(element instanceof Element)) return null
+
+    const card = element.closest("[data-drag-and-drop-target~='card'], .cards__list .card")
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #hasDraggablePayload(event) {
+    return this.draggedCard || this.#draggedCardElement() || event.dataTransfer?.types?.includes("text/plain")
+  }
+
+  #draggedCardElement() {
+    const card = this.element.querySelector(`.${DRAGGED_ITEM_CLASS}`)
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #cardFromDataTransfer(event) {
+    const id = event.dataTransfer?.getData("text/plain")
+    const card = id ? document.getElementById(id) : null
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #columnFor(element) {
+    if (!(element instanceof Element)) return null
+
+    const column = element.closest(".cards")
+    return column && this.element.contains(column) ? column : null
+  }
+
+  #hover(column) {
+    if (column === this.hoveredColumn) return
+
+    this.#clearHoveredColumn()
+    column.classList.add(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = column
+  }
+
+  #clearHoveredColumn() {
+    this.hoveredColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = null
+  }
+
+  #clearDraggedItem() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedCard = null
+  }
+
+  #move(card, sourceColumn, targetColumn) {
+    const targetList = this.#listFor(targetColumn)
+    if (!targetList) return
+
+    targetList.prepend(card)
+    this.#updateStatus(card, targetColumn)
+    this.#updateEmptyState(this.#listFor(sourceColumn))
+  }
+
+  #listFor(column) {
+    return column?.querySelector(".cards__list") || column?.querySelector("turbo-frame") || column
+  }
+
+  #updateStatus(card, column) {
+    const status = column.dataset.dragAndDropColumnId || column.dataset.columnId
+    const postponed = status === "not_now"
+    const closed = status === "closed"
+
+    card.classList.toggle("card--postponed", postponed)
+    card.classList.toggle("card--active", !postponed && !closed)
+
+    if (postponed || closed) {
+      this.#ensureStamp(card, postponed ? "Not Now" : "Done")
+    } else {
+      card.querySelectorAll(".card__closed").forEach((element) => element.remove())
+    }
+  }
+
+  #ensureStamp(card, title) {
+    let stamp = card.querySelector(".card__closed")
+    if (!stamp) {
+      stamp = document.createElement("div")
+      stamp.className = "card__closed"
+      card.append(stamp)
+    }
+
+    let stampTitle = stamp.querySelector(".card__closed-title")
+    if (!stampTitle) {
+      stampTitle = document.createElement("span")
+      stampTitle.className = "card__closed-title"
+      stamp.append(stampTitle)
+    }
+
+    stampTitle.dataset.text = title
+    stampTitle.textContent = title
+  }
+
+  #updateCounts(sourceColumn, targetColumn) {
+    this.#adjustCount(sourceColumn, -1)
+    this.#adjustCount(targetColumn, 1)
+  }
+
+  #adjustCount(column, delta) {
+    const count = column?.querySelector(".cards__expander-count")
+    if (!count || count.textContent.includes("+")) return
+
+    const value = parseInt(count.textContent, 10)
+    if (Number.isNaN(value)) return
+
+    count.textContent = Math.max(0, value + delta)
+  }
+
+  #updateEmptyState(list) {
+    if (!list || list.querySelector(".card") || list.querySelector(".blank-slate")) return
+
+    const placeholder = document.createElement("div")
+    placeholder.className = "blank-slate blank-slate--drag overflow-ellipsis"
+    placeholder.textContent = "Drag cards here"
+    list.append(placeholder)
+  }
+
+  #save(card, column) {
+    const columnId = column.dataset.dragAndDropColumnId || column.dataset.columnId
+    if (!columnId) return
+
+    const url = card.dataset.dragAndDropUrl || card.dataset.cardColumnUrl
+    if (url) {
+      patch(url, { body: { column_id: columnId }, responseKind: "json" }).catch(console.error)
+    } else {
+      this.#saveWithLegacyUrls(card, columnId)
+    }
+  }
+
+  #saveWithLegacyUrls(card, columnId) {
+    this.#legacyRequestFor(card, columnId)?.catch(console.error)
+  }
+
+  #legacyRequestFor(card, columnId) {
+    switch (columnId) {
+      case "maybe":
+        return destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+      case "not_now":
+        return post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return post(card.dataset.cardClosureUrl, { responseKind: "json" })
+      default:
+        return post(card.dataset.cardTriageUrl, { body: { column_id: columnId }, responseKind: "json" })
+    }
+  }
+}
