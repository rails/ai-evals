index 14b89c0..444f6da 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -56,10 +56,32 @@ class Card < ApplicationRecord
   end
 
   def move_to(new_board)
-    transaction do
-      card.update!(board: new_board)
-      card.events.update_all(board_id: new_board.id)
-      Event.where(eventable: card.comments).update_all(board_id: new_board.id)
+    if new_board.is_a?(Column) || new_board.is_a?(String) || new_board.is_a?(Symbol)
+      move_to_column new_board
+    else
+      transaction do
+        card.update!(board: new_board)
+        card.events.update_all(board_id: new_board.id)
+        Event.where(eventable: card.comments).update_all(board_id: new_board.id)
+      end
+    end
+  end
+
+  def move_to_column(column)
+    if column.is_a?(Column)
+      triage_into column unless triaged? && column == self.column
+    else
+      case column.to_s
+      when "", "maybe", "maybe?", "none", "untriaged", "stream", "triage"
+        send_back_to_triage unless awaiting_triage?
+      when "not_now", "not-now", "not now", "on-deck", "on_deck", "postponed", "postpone"
+        postpone unless postponed?
+      when "closed", "closed-cards", "closed_cards", "completed", "done", "close"
+        close unless closed?
+      else
+        target = board.columns.find(column)
+        triage_into(target) unless triaged? && target == self.column
+      end
     end
   end
 
