@@ -0,0 +1,33 @@
+module RichTextStorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :track_storage_usage_on_save
+    after_destroy_commit :track_storage_usage_on_destroy
+  end
+
+  private
+    def track_storage_usage_on_save
+      track_storage_usage
+    end
+
+    def track_storage_usage_on_destroy
+      track_storage_usage
+    end
+
+    def track_storage_usage
+      board = storage_usage_board
+      board&.recalculate_storage_usage_later
+    end
+
+    def storage_usage_board
+      case record_type
+      when "Board"
+        Board.find_by(id: record_id) if name == "public_description"
+      when "Card"
+        Card.find_by(id: record_id)&.board if name == "description"
+      when "Comment"
+        Comment.find_by(id: record_id)&.card&.board if name == "body"
+      end
+    end
+end
diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
