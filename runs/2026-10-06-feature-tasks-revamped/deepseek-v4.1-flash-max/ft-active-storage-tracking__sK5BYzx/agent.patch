@@ -0,0 +1,37 @@
+module StorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :track_storage_usage_on_create
+    after_destroy_commit :track_storage_usage_on_destroy
+  end
+
+  # Active Storage deletes attachments directly (e.g. #detach, #purge_later),
+  # which skips the regular destroy callbacks.
+  def delete
+    board = storage_usage_board
+    super
+    board&.recalculate_storage_usage_later
+  end
+
+  private
+    def track_storage_usage_on_create
+      track_storage_usage
+    end
+
+    def track_storage_usage_on_destroy
+      track_storage_usage
+    end
+
+    def track_storage_usage
+      board = storage_usage_board
+      board&.recalculate_storage_usage_later
+    end
+
+    def storage_usage_board
+      case record_type
+      when "Card"
+        record.board if name == "image" && record.is_a?(Card)
+      end
+    end
+end
