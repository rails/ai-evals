diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..3c7cc90
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts card images for board and account" do
+    blob = create_blob
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = create_blob
+
+    perform_enqueued_jobs do
+      @card.update!(description: embed(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    blob = create_blob
+    comment = @card.comments.create!(body: "no attachment")
+
+    perform_enqueued_jobs do
+      comment.update!(body: embed(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    blob = create_blob
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: embed(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "does not count attachments outside cards and rich text" do
+    blob = create_blob
+
+    perform_enqueued_jobs do
+      users(:david).avatar.attach(blob)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "does not double count the same blob within a board" do
+    blob = create_blob
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob)
+      @card.update!(description: embed(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "does not double count the same blob across boards in an account" do
+    blob = create_blob
+    other_board = boards(:private)
+    other_card = other_board.cards.create!(title: "Other", creator: users(:kevin), status: :published)
+
+    perform_enqueued_jobs do
+      @card.image.attach(blob)
+      other_card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, other_board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "recalculates after attachments are removed" do
+    blob = create_blob
+    perform_enqueued_jobs { @card.image.attach(blob) }
+
+    perform_enqueued_jobs do
+      @card.image.detach
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card moves its usage between boards" do
+    other_board = boards(:private)
+    blob = create_blob
+    perform_enqueued_jobs { @card.image.attach(blob) }
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    perform_enqueued_jobs do
+      @card.update!(board: other_board)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, other_board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "accounts only include their own boards" do
+    other_account = accounts(:initech)
+    other_board = boards(:miltons_wish_list)
+    blob = create_blob
+
+    perform_enqueued_jobs { @card.image.attach(blob) }
+
+    assert_equal blob.byte_size, @account.reload.bytes_used
+    assert_equal 0, other_account.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+  end
+
+  test "bytes_used is calculated in the background" do
+    blob = create_blob
+    @card.image.attach(blob)
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_enqueued_jobs only: StorageUsageJob
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  private
+    def create_blob(bytes: 1024)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * bytes),
+        filename: "attachment.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def embed(blob)
+      ActionText::Content.new("<action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment>")
+    end
+end
