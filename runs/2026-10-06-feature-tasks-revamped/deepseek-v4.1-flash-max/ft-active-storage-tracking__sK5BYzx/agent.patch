index 0000000..72a8d59
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,37 @@
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used]
+  end
+
+  def calculate_bytes_used
+    calculate_storage_usage
+  end
+
+  def recalculate_bytes_used
+    recalculate_storage_usage
+  end
+
+  def recalculate_bytes_used_later
+    recalculate_storage_usage_later
+  end
+
+  def calculate_storage_usage
+    ActiveStorage::Blob.where(id: storage_usage_blob_ids).sum(:byte_size)
+  end
+
+  def recalculate_storage_usage
+    update_column(:bytes_used, calculate_storage_usage)
+  end
+
+  def recalculate_storage_usage_later
+    updated = self.class.where(id: id).update_all("storage_usage_version = storage_usage_version + 1")
+    StorageUsageJob.perform_later(self) if updated == 1
+  end
+
+  private
+    def storage_usage_blob_ids
+      raise NotImplementedError
+    end
+end
