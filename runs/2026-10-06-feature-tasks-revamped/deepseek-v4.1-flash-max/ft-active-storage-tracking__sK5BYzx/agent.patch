diff --git a/app/jobs/storage_usage_job.rb b/app/jobs/storage_usage_job.rb
new file mode 100644
index 0000000..281b89d
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,35 @@
+class StorageUsageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(owner = nil)
+    if owner
+      recalculate(owner)
+    else
+      recalculate_all
+    end
+  end
+
+  private
+    def recalculate(owner)
+      version, processed_version = owner.class.where(id: owner.id).pick(:storage_usage_version, :storage_usage_processed_version)
+      return if version.nil?
+      return if version.positive? && processed_version.to_i >= version
+
+      owner.recalculate_storage_usage
+      mark_processed(owner, version)
+    end
+
+    def recalculate_all
+      Board.find_each(&:recalculate_storage_usage)
+      Account.find_each(&:recalculate_storage_usage)
+    end
+
+    def mark_processed(owner, version)
+      return if version.zero?
+
+      owner.class
+        .where(id: owner.id)
+        .where("storage_usage_processed_version < ?", version)
+        .update_all(storage_usage_processed_version: version)
+    end
+end
