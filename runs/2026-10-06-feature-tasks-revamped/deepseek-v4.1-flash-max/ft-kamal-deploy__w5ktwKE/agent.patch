new file mode 100644
index 0000000..bca095f
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,17 @@
+# Secrets referenced from config/deploy.yml. Values are evaluated as a dotenv
+# file, so command substitutions and environment variables are supported.
+#
+# Keep this file safe for git: never put raw credentials here. See
+# docs/deployment.md for how to provide each value.
+
+# The Rails master key, generated by `bin/rails credentials:edit`.
+RAILS_MASTER_KEY=$(cat config/master.key)
+
+# The password for the SMTP server configured in config/deploy.yml. Export it
+# before deploying, or read it from your password manager:
+#   SMTP_PASSWORD=$(op read "op://Private/Fizzy SMTP/password")
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Only needed if you configure a remote registry instead of the default local
+# registry in config/deploy.yml.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
