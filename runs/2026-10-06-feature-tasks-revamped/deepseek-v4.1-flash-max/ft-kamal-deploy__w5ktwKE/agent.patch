--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,33 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Self-hosted deployments: derive public URLs and outbound email from the
+  # environment configured in config/deploy.yml.
+  unless Fizzy.saas?
+    app_host = ENV["APP_FQDN"].presence || ENV["APP_HOST"].presence || "localhost"
+    app_protocol = ENV.fetch("APP_PROTOCOL", "https")
+
+    config.action_mailer.default_url_options = { host: app_host, protocol: app_protocol }
+    config.action_controller.default_url_options = { host: app_host, protocol: app_protocol }
+    Rails.application.routes.default_url_options = { host: app_host, protocol: app_protocol }
+
+    # Configure outbound email when an SMTP server is provided.
+    if (smtp_address = ENV["SMTP_ADDRESS"].presence)
+      smtp_user_name = ENV["SMTP_USER_NAME"].presence || ENV["SMTP_USERNAME"].presence
+
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: smtp_address,
+        port: Integer(ENV.fetch("SMTP_PORT", 587)),
+        domain: ENV["SMTP_DOMAIN"].presence || app_host,
+        user_name: smtp_user_name,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym,
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true").to_s.downcase != "false"
+      }.compact
+    end
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
