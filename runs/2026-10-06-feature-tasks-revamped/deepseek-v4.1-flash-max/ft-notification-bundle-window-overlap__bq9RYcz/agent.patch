diff --git a/app/views/mailers/notification_mailer/bundle.html.erb b/app/views/mailers/notification_mailer/bundle.html.erb
new file mode 100644
index 0000000..00ea4d6
--- /dev/null
+++ b/app/views/mailers/notification_mailer/bundle.html.erb
@@ -0,0 +1,30 @@
+<h1 class="title">New notifications</h1>
+<p class="subtitle">You have <%= @notifications.size %> new <%= "notification".pluralize(@notifications.size) %> in <%= @account.name %>.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <h2 class="notification__board"><%= link_to board.name, board_url(board, script_name: @account.slug) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <table>
+        <tr>
+          <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+          <td>
+            <h3 class="card__title">
+              <%= link_to(notification.card.title.presence || "Card #{notification.card.number}", notification.payload.url) %>
+            </h3>
+            <p class="notification__details"><%= notification.payload.title %> — <%= notification.payload.body %></p>
+            <p class="notification__author"><%= notification.creator.name %></p>
+            <p><%= link_to "View notification", notification_url(notification, script_name: @account.slug) %></p>
+          </td>
+        </tr>
+      </table>
+    </div>
+  <% end %>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  <%= link_to "Manage notification emails", notifications_settings_url(script_name: @account.slug) %>.
+</p>
