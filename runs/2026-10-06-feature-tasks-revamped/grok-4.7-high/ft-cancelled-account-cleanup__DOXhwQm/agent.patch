diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..b707e96 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,23 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    Account::Incineration.new(self).run
+  end
+
+  def due_for_incineration?
+    cancellation.present? && cancellation.created_at.before?(INCINERATION_GRACE_PERIOD.ago)
+  end
 end
diff --git a/app/models/account/incineration.rb b/app/models/account/incineration.rb
new file mode 100644
index 0000000..4a2a29d
--- /dev/null
+++ b/app/models/account/incineration.rb
@@ -0,0 +1,122 @@
+class Account::Incineration
+  # Join tables have no account_id; remove rows that reference this account's records.
+  JOIN_TABLES = {
+    "filters_tags" => { "filter_id" => :filter_ids, "tag_id" => :tag_ids },
+    "assignees_filters" => { "filter_id" => :filter_ids, "assignee_id" => :user_ids },
+    "assigners_filters" => { "filter_id" => :filter_ids, "assigner_id" => :user_ids },
+    "boards_filters" => { "filter_id" => :filter_ids, "board_id" => :board_ids },
+    "closers_filters" => { "filter_id" => :filter_ids, "closer_id" => :user_ids },
+    "creators_filters" => { "filter_id" => :filter_ids, "creator_id" => :user_ids }
+  }.freeze
+
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    account.with_lock do
+      if account.due_for_incineration?
+        Rails.logger.info("[Account::Incineration] Removing account #{account.id}")
+        delete_stored_files
+        delete_records
+      end
+    end
+  end
+
+  private
+    attr_reader :account
+
+    def delete_stored_files
+      ActiveStorage::Blob.where(account_id: account.id).find_each do |blob|
+        blob.service.delete(blob.key)
+        blob.service.delete_prefixed("variants/#{blob.key}/")
+      end
+    end
+
+    def delete_records
+      delete_search_index
+      delete_join_tables
+      delete_storage_totals
+      delete_saas_records
+      delete_account_scoped_rows
+      account.delete
+    end
+
+    # SQLite keeps card/comment text in an FTS5 side table keyed by search record id.
+    # MySQL fulltext indexes live on the sharded search_records_* tables themselves.
+    def delete_search_index
+      if Fizzy.db_adapter.sqlite?
+        Search::Record.where(account_id: account.id).in_batches do |batch|
+          Search::Record::SQLite::Fts.where(rowid: batch.pluck(:id)).delete_all
+        end
+      end
+    end
+
+    def delete_join_tables
+      references = {
+        filter_ids: pluck_ids(Filter),
+        tag_ids: pluck_ids(Tag),
+        board_ids: pluck_ids(Board),
+        user_ids: pluck_ids(User)
+      }
+
+      JOIN_TABLES.each do |table, columns|
+        columns.each do |column, reference|
+          delete_matching(table, column, references.fetch(reference))
+        end
+      end
+    end
+
+    def delete_storage_totals
+      Storage::Total.where(owner: account).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: pluck_ids(Board)).delete_all
+    end
+
+    def delete_saas_records
+      if Fizzy.saas?
+        Account::StorageException.where(account_id: account.id).delete_all
+      end
+    end
+
+    # Every tenant table carries account_id. Foreign keys were removed, so a
+    # direct delete clears associated rows without callbacks that would recreate them.
+    def delete_account_scoped_rows
+      quoted_account_id = quote_id(account.id)
+      account_id_column = connection.quote_column_name("account_id")
+
+      connection.tables.each do |table|
+        if connection.column_exists?(table, "account_id")
+          quoted_table = connection.quote_table_name(table)
+          connection.delete("DELETE FROM #{quoted_table} WHERE #{account_id_column} = #{quoted_account_id}")
+        end
+      end
+    end
+
+    def delete_matching(table, column, ids)
+      if ids.any?
+        quoted_table = connection.quote_table_name(table)
+        quoted_column = connection.quote_column_name(column)
+
+        ids.each_slice(500) do |slice|
+          quoted_ids = slice.map { |id| quote_id(id) }.join(", ")
+          connection.delete("DELETE FROM #{quoted_table} WHERE #{quoted_column} IN (#{quoted_ids})")
+        end
+      end
+    end
+
+    def pluck_ids(model)
+      model.where(account_id: account.id).pluck(:id)
+    end
+
+    def quote_id(value)
+      connection.quote(uuid_type.serialize(value))
+    end
+
+    def uuid_type
+      @uuid_type ||= ActiveRecord::Type::Uuid.new
+    end
+
+    def connection
+      Account.connection
+    end
+end
