diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..cac74e0
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "is registered as a recurring task" do
+    config = ActiveSupport::ConfigurationFile.parse(Rails.root.join("config/recurring.yml"))
+    task = config.fetch("production").fetch("incinerate_due_accounts")
+
+    assert_equal "Account::IncinerateDueJob", task.fetch("class")
+    assert task.fetch("schedule").present?
+  end
+
+  test "perform incinerates accounts due for removal" do
+    identity = Identity.create!(email_address: "job-due-#{SecureRandom.hex(4)}@example.com")
+    account = Account.create_with_owner(account: { name: "Job Due" }, owner: { name: "Owner", identity: identity })
+    owner = account.users.find_by!(role: :owner)
+    account.cancel(initiated_by: owner)
+    account.cancellation.update_column(:created_at, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..9332744
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    travel_to Time.zone.parse("2026-06-15 12:00:00")
+    @keeper = accounts("37s")
+    @due = create_account("Due Co", "due")
+    @recent = create_account("Recent Co", "recent")
+    @boundary = create_account("Boundary Co", "boundary")
+
+    @due.cancel(initiated_by: @due.users.find_by!(role: :owner))
+    @recent.cancel(initiated_by: @recent.users.find_by!(role: :owner))
+    @boundary.cancel(initiated_by: @boundary.users.find_by!(role: :owner))
+
+    @due.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second)
+    @recent.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.day)
+    @boundary.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+  end
+
+  test "incinerate due job permanently removes accounts canceled more than 30 days ago" do
+    due_id = @due.id
+    due_identity = @due.users.find_by!(role: :owner).identity
+    keeper_card_count = @keeper.cards.count
+    blob = attach_file(@due)
+    blob_path = blob.service.path_for(blob.key)
+    assert File.exist?(blob_path), "expected the attached file to be stored before incineration"
+
+    create_filter(@due)
+    references = account_references(@due)
+    assert account_scoped_row_count(due_id) > 0
+    assert join_row_count(references) > 0
+
+    search_record_ids = Search::Record.where(account_id: due_id).pluck(:id)
+    assert search_record_ids.any?, "expected cards and comments to be indexed before incineration"
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_id)
+    assert_equal 0, account_scoped_row_count(due_id)
+    assert_equal 0, join_row_count(references)
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: due_id).count
+    assert_equal 0, Storage::Total.where(owner_type: "Board", owner_id: references[:board_ids]).count
+    assert_equal 0, Search::Record::SQLite::Fts.where(rowid: search_record_ids).count if search_record_ids.any?
+    assert_not File.exist?(blob_path)
+    assert Identity.exists?(due_identity.id), "login identities are global and are not account data"
+
+    assert Account.exists?(@recent.id)
+    assert @recent.reload.cancelled?
+    assert Account.exists?(@boundary.id), "an account canceled exactly 30 days ago is not more than 30 days old"
+    assert Account.exists?(@keeper.id)
+    assert_equal keeper_card_count, @keeper.cards.count
+    assert @keeper.users.exists?
+    assert account_scoped_row_count(@recent.id) > 0
+    assert account_scoped_row_count(@keeper.id) > 0
+  end
+
+  test "incinerate does nothing until the grace period has passed" do
+    assert_no_difference -> { Account.count } do
+      @recent.incinerate
+      @boundary.incinerate
+      @keeper.incinerate
+    end
+
+    assert Account.exists?(@recent.id)
+    assert Account.exists?(@boundary.id)
+    assert Account.exists?(@keeper.id)
+  end
+
+  test "reactivation keeps an account out of incineration" do
+    @due.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@due.id)
+    assert_not @due.reload.cancelled?
+  end
+
+  test "running the job twice is safe" do
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@due.id)
+    assert Account.exists?(@recent.id)
+  end
+
+  private
+    def create_account(name, label)
+      identity = Identity.create!(email_address: "#{label}-#{SecureRandom.hex(4)}@example.com")
+      account = Account.create_with_owner(account: { name: name }, owner: { name: "Owner", identity: identity })
+      owner = account.users.find_by!(role: :owner)
+
+      Current.set(account: account, user: owner) do
+        board = account.boards.create!(name: "Board", creator: owner, all_access: true)
+        card = board.cards.create!(title: "Card", creator: owner, status: "published", description: "Secret notes")
+        card.comments.create!(body: "A private comment", creator: owner)
+        tag = account.tags.create!(title: "bug-#{SecureRandom.hex(2)}")
+        card.taggings.create!(tag: tag)
+        board.columns.create!(name: "Yes")
+      end
+
+      account
+    end
+
+    def attach_file(account)
+      owner = account.users.find_by!(role: :owner)
+      card = account.cards.first
+      Current.set(account: account, user: owner) do
+        card.image.attach(io: StringIO.new("png-bytes"), filename: "x.png", content_type: "image/png")
+      end
+      card.image.blob
+    end
+
+    def create_filter(account)
+      owner = account.users.find_by!(role: :owner)
+      Current.set(account: account, user: owner) do
+        owner.filters.create!(board_ids: [ account.boards.first.id ], tag_ids: [ account.tags.first.id ])
+      end
+    end
+
+    def account_references(account)
+      {
+        filter_ids: Filter.where(account_id: account.id).pluck(:id),
+        tag_ids: account.tags.pluck(:id),
+        board_ids: account.boards.pluck(:id),
+        user_ids: account.users.pluck(:id)
+      }
+    end
+
+    def account_scoped_row_count(account_id)
+      connection = Account.connection
+      connection.tables.sum do |table|
+        if connection.column_exists?(table, "account_id")
+          connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{quote_id(connection, account_id)}").to_i
+        else
+          0
+        end
+      end
+    end
+
+    def join_row_count(references)
+      connection = Account.connection
+      tables = {
+        "filters_tags" => { "filter_id" => references[:filter_ids], "tag_id" => references[:tag_ids] },
+        "assignees_filters" => { "filter_id" => references[:filter_ids], "assignee_id" => references[:user_ids] },
+        "assigners_filters" => { "filter_id" => references[:filter_ids], "assigner_id" => references[:user_ids] },
+        "boards_filters" => { "filter_id" => references[:filter_ids], "board_id" => references[:board_ids] },
+        "closers_filters" => { "filter_id" => references[:filter_ids], "closer_id" => references[:user_ids] },
+        "creators_filters" => { "filter_id" => references[:filter_ids], "creator_id" => references[:user_ids] }
+      }
+
+      tables.sum do |table, columns|
+        columns.sum do |column, ids|
+          next 0 if ids.empty?
+
+          quoted_ids = ids.map { |id| quote_id(connection, id) }.join(", ")
+          connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE #{connection.quote_column_name(column)} IN (#{quoted_ids})").to_i
+        end
+      end
+    end
+    def quote_id(connection, value)
+      connection.quote(ActiveRecord::Type::Uuid.new.serialize(value))
+    end
+end
