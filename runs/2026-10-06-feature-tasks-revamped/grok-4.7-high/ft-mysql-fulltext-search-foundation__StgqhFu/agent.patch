diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..315ddca
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "search page" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select "h1", text: "Search"
+  end
+
+  test "finds cards by title and wraps the match" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select ".search-result mark", text: "logo"
+  end
+
+  test "finds cards by description and wraps the match" do
+    cards(:shipping).update!(description: "Remember the zymurgy notes")
+
+    get search_path(q: "zymurgy")
+
+    assert_select "a[href=?]", card_path(cards(:shipping))
+    assert_select ".search-result mark", text: "zymurgy"
+    assert_select "a[href=?]", card_path(cards(:logo)), count: 0
+  end
+
+  test "finds cards by comment body and wraps the match" do
+    get search_path(q: "overflowing")
+
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select ".search-result mark", text: "overflowing"
+  end
+
+  test "matches regardless of case and keeps the original word" do
+    get search_path(q: "LOGO")
+
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logo"
+  end
+
+  test "results are newest first" do
+    older = publish_card(title: "Older needle", created_at: 2.days.ago)
+    newer = publish_card(title: "Newer needle", created_at: 1.hour.ago)
+
+    get search_path(q: "needle")
+
+    numbers = css_select(".search-result").map { |element| element["data-card-number"] }
+    assert_equal [ newer.number.to_s, older.number.to_s ], numbers
+  end
+
+  test "returns each card once when title and comment both match" do
+    cards(:logo).comments.create!(creator: users(:kevin), body: "The logo needs another pass")
+
+    get search_path(q: "logo")
+
+    assert_select "article.search-result[data-card-number=?]", cards(:logo).number.to_s, count: 1
+  end
+
+  test "does not include draft cards" do
+    draft = boards(:writebook).cards.create!(title: "Draft needle", creator: users(:kevin), status: :drafted)
+
+    get search_path(q: "Draft needle")
+
+    assert_select ".search-result", count: 0
+    assert_select "a[href=?]", card_path(draft), count: 0
+  end
+
+  test "does not match comments on draft cards" do
+    draft = boards(:writebook).cards.create!(title: "Untitled draft", creator: users(:kevin), status: :drafted)
+    comment = Comment.new(card: draft, creator: users(:kevin), account: draft.account)
+    comment.save!(validate: false)
+    ActionText::RichText.insert!({
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: draft.account_id,
+      record_type: "Comment",
+      record_id: comment.id,
+      name: "body",
+      body: "DraftOnlyNeedle",
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    get search_path(q: "DraftOnlyNeedle")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not include cards from boards the user cannot access" do
+    secret = boards(:private).cards.create!(title: "Private needle", creator: users(:kevin), status: :published)
+
+    get search_path(q: "Private needle")
+    assert_select "a[href=?]", card_path(secret)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "Private needle")
+
+    assert_select ".search-result", count: 0
+    assert_select "a[href=?]", card_path(secret), count: 0
+  end
+
+  test "does not include cards from boards access was revoked from" do
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:kevin))
+
+    get search_path(q: "logo")
+
+    assert_select "a[href=?]", card_path(cards(:logo)), count: 0
+  end
+
+  test "does not include cards from other accounts" do
+    get search_path(q: "paycheck")
+
+    assert_select ".search-result", count: 0
+  end
+
+  test "includes closed cards" do
+    get search_path(q: "ship the app")
+
+    assert_select "a[href=?]", card_path(cards(:shipping))
+  end
+
+  test "shows a blank slate when nothing matches" do
+    get search_path(q: "zzzz-not-a-card")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select ".blank-slate", text: /No cards match/
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_response :redirect
+  end
+
+  private
+    def publish_card(title:, created_at:)
+      boards(:writebook).cards.create!(
+        title: title,
+        creator: users(:kevin),
+        status: :published,
+        created_at: created_at,
+        last_active_at: created_at
+      )
+    end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..e50ec6b
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "matches a card title" do
+    assert_includes Card.search("logo"), cards(:logo)
+  end
+
+  test "matches a card description" do
+    cards(:shipping).update!(description: "Remember the zymurgy notes")
+
+    assert_includes Card.search("zymurgy"), cards(:shipping)
+  end
+
+  test "matches a comment body" do
+    assert_includes Card.search("overflowing"), cards(:layout)
+  end
+
+  test "matches words spread across the title and a comment" do
+    assert_includes Card.search("logo agree"), cards(:logo)
+    assert_not_includes Card.search("layout agree"), cards(:logo)
+  end
+
+  test "is case insensitive" do
+    assert_includes Card.search("LOGO"), cards(:logo)
+  end
+
+  test "excludes draft cards even when their title matches" do
+    draft = cards(:unfinished_thoughts)
+    draft.update!(title: "zymurgy draft")
+
+    assert_not_includes Card.search("zymurgy"), draft
+  end
+
+  test "excludes draft cards even when a comment matches" do
+    draft = cards(:unfinished_thoughts)
+    comment = Comment.new(card: draft, creator: users(:mike), account: draft.account)
+    comment.save!(validate: false)
+    comment.update_column(:account_id, draft.account_id)
+    ActionText::RichText.insert!({
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: draft.account_id,
+      record_type: "Comment",
+      record_id: comment.id,
+      name: "body",
+      body: "DraftOnlyNeedle",
+      created_at: Time.current,
+      updated_at: Time.current
+    })
+
+    assert_not_includes Card.search("DraftOnlyNeedle"), draft
+  end
+
+  test "treats like wildcards as literals" do
+    card = boards(:writebook).cards.create!(title: "100% done_now", creator: users(:kevin), status: :published)
+
+    assert_includes Card.search("100%"), card
+    assert_includes Card.search("done_now"), card
+    assert_not_includes Card.search("100%"), cards(:logo)
+  end
+
+  test "returns nothing for a blank query" do
+    assert_empty Card.search("   ")
+  end
+end
