diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..a5ca245
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,55 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  # "!" is a portable LIKE escape for both SQLite and MySQL.
+  LIKE_ESCAPE = "!"
+
+  MATCHING_TERM_SQL = <<~SQL.squish
+    cards.title LIKE ? ESCAPE '!'
+    OR EXISTS (
+      SELECT 1
+      FROM action_text_rich_texts
+      WHERE action_text_rich_texts.record_id = cards.id
+        AND action_text_rich_texts.record_type = 'Card'
+        AND action_text_rich_texts.name = 'description'
+        AND action_text_rich_texts.body LIKE ? ESCAPE '!'
+    )
+    OR EXISTS (
+      SELECT 1
+      FROM comments
+      INNER JOIN action_text_rich_texts AS comment_bodies
+        ON comment_bodies.record_id = comments.id
+        AND comment_bodies.record_type = 'Comment'
+        AND comment_bodies.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND comment_bodies.body LIKE ? ESCAPE '!'
+    )
+  SQL
+
+  included do
+    scope :search, ->(query) {
+      terms = search_terms(query)
+
+      if terms.any?
+        terms.reduce(published) { |cards, term| cards.matching_term(term) }
+      else
+        none
+      end
+    }
+
+    scope :matching_term, ->(term) {
+      like = like_pattern(term)
+      where(MATCHING_TERM_SQL, like, like, like)
+    }
+  end
+
+  class_methods do
+    def search_terms(query)
+      query.to_s.scan(/[^\s]+/).uniq { |term| term.downcase }.sort_by { |term| -term.length }
+    end
+
+    def like_pattern(term)
+      "%#{sanitize_sql_like(term, LIKE_ESCAPE)}%"
+    end
+  end
+end
