@@ -0,0 +1,32 @@
+class SearchesController < ApplicationController
+  def show
+    @query = search_query
+
+    if @query.present?
+      set_page_and_extract_portion_from cards
+      preload_comments
+    end
+  end
+
+  private
+    def search_query
+      query = params[:q]
+
+      if query.is_a?(String)
+        query.strip.gsub(/\s+/, " ")
+      else
+        ""
+      end
+    end
+
+    def cards
+      Current.user.accessible_cards.search(@query).reverse_chronologically.preloaded
+    end
+
+    def preload_comments
+      ActiveRecord::Associations::Preloader.new(
+        records: @page.records,
+        associations: { comments: [ :rich_text_body, :creator ] }
+      ).call
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..6d2363b
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,34 @@
+module SearchesHelper
+  def highlighted_title(card)
+    highlight(card.title.to_s, search_terms)
+  end
+
+  def search_excerpt(content)
+    text = plain_search_text(content)
+    return if text.blank? || !term_in?(text)
+
+    snippet = search_terms.filter_map { |term| excerpt(text, term, radius: 80) }.first
+    highlight(snippet, search_terms) if snippet
+  end
+
+  def matching_comments(card)
+    card.comments
+      .select { |comment| term_in?(plain_search_text(comment.body)) }
+      .sort_by { |comment| [ comment.created_at, comment.id ] }
+      .first(3)
+  end
+
+  private
+    def search_terms
+      @search_terms ||= Card.search_terms(@query)
+    end
+
+    def plain_search_text(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.to_s.squish
+    end
+
+    def term_in?(text)
+      search_terms.any? { |term| text.match?(/#{Regexp.escape(term)}/i) }
+    end
+end
