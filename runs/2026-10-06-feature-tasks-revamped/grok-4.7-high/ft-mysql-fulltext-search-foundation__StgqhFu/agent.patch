+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,23 @@
+<article class="search-result panel" id="<%= dom_id(card, :search_result) %>" data-card-number="<%= card.number %>" style="--card-color: <%= card.color %>">
+  <%= link_to card_path(card), class: "search-result__title-link" do %>
+    <h2 class="search-result__title"><%= highlighted_title(card) %></h2>
+  <% end %>
+
+  <p class="search-result__meta txt-small txt-subtle">
+    <%= card.board.name %>
+    <span aria-hidden="true">·</span>
+    #<%= card.number %>
+  </p>
+
+  <% if snippet = search_excerpt(card.description) %>
+    <p class="search-result__snippet"><%= snippet %></p>
+  <% end %>
+
+  <% matching_comments(card).each do |comment| %>
+    <p class="search-result__comment">
+      <%= link_to comment, class: "search-result__comment-link" do %>
+        <%= safe_join([ comment.creator.familiar_name, ": ", search_excerpt(comment.body) ]) %>
+      <% end %>
+    </p>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..4b08ff0
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, authenticity_token: false, class: "search__form" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= text_field_tag :q, @query,
+          type: "search",
+          placeholder: "Search titles, descriptions, and comments",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          spellcheck: false,
+          class: "input",
+          enterkeyhint: "search" %>
+    <%= submit_tag "Search", class: "btn", name: nil %>
+  <% end %>
+
+  <% if @page %>
+    <% if @page.records.any? %>
+      <div class="search__results">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% else %>
+    <p class="search__hint txt-subtle">Find a card by its title, description, or comments.</p>
+  <% end %>
+</section>
