+class Public::BoardsController < ApplicationController
+  include PublicBoardScoped
+
+  def show
+    @columns = @board.columns.sorted
+    @stream_cards = @board.cards.awaiting_triage.latest.with_golden_first.preloaded
+    @column_cards = @board.cards.active.where.not(column_id: nil).latest.with_golden_first.preloaded.group_by(&:column_id)
+    @postponed_cards = @board.cards.postponed.latest.preloaded
+    @closed_cards = @board.cards.closed.published.recently_closed_first.preloaded
+
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+end
