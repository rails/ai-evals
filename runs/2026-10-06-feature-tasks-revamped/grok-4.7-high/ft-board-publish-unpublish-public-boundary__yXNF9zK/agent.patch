@@ -0,0 +1,21 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    layout "public"
+
+    before_action :set_public_board
+  end
+
+  private
+    def set_public_board
+      if Current.account&.active?
+        key = params[:key].presence || params[:board_key]
+        @publication = Board::Publication.find_by!(key: key, account_id: Current.account.id)
+        @board = @publication.board
+      else
+        head :not_found
+      end
+    end
+end
