diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..0d6dbee
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,26 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication", inverse_of: :board
+  end
+
+  def publish
+    publication || create_publication!
+  rescue ActiveRecord::RecordNotUnique
+    reload_publication
+  end
+
+  def unpublish
+    publication&.destroy
+    reload_publication
+  end
+
+  def published_publicly?
+    publication.present?
+  end
+
+  def publicly_accessible?
+    published_publicly?
+  end
+end
