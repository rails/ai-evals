 - The `users` array contains the current page of results; if there are more users, follow the `Link` response header with `rel="next"`
 
 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+
+## Publishing a board
+
+Admins can publish a board so anyone with a secret link can view it. The board JSON includes `public_url`, which is `null` until the board is published.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board and returns the board JSON. Only account admins can publish a board. Publishing again keeps the same secret link.
+
+__Response:__ `201 Created` the first time, or `200 OK` if the board is already published. `public_url` is an absolute URL like:
+
+```
+http://app.fizzy.localhost:3006/897362094/public/boards/the-secret-key
+```
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board and invalidates the secret link. Only account admins can unpublish a board.
+
+__Response:__ `204 No Content`
+
+### Public board
+
+These routes do not require authentication. They only show a published board, and only published cards are visible.
+
+- `GET /:account_slug/public/boards/:key`
+- `GET /:account_slug/public/boards/:key/columns/:id`
+- `GET /:account_slug/public/boards/:key/cards/:number`
+
+Unknown keys, unpublished boards, draft cards, and records from another board return `404 Not Found`.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..8367c4b
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes a nil public_url by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "board index JSON includes a nil public_url by default" do
+    get boards_path, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.all? { |board| board["public_url"].nil? }
+  end
+
+  test "admin can publish a board" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+    assert @board.published_publicly?
+    assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+    assert_match %r{/public/boards/#{@board.publication.key}\z}, @response.parsed_body["public_url"]
+  end
+
+  test "publishing is idempotent" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :success
+    assert_equal key, @board.reload.publication.key
+    assert_equal public_board_url(key), @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish a board" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published_publicly?
+
+    get board_path(@board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+    assert_not Board::Publication.exists?(key: key)
+  end
+
+  test "members cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published_publicly?
+
+    Current.set(account: accounts("37s")) { @board.publish }
+
+    logout_and_sign_in_as :jz
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published_publicly?
+  end
+
+  test "board creators who are not admins cannot publish" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+  end
+
+  test "owners can publish a board they do not already access" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published_publicly?
+  end
+
+  test "html publish and unpublish redirect back to settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_response :success
+    assert_select "input[value=?]", public_board_url(@board.reload.publication.key)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_nil @board.reload.publication
+  end
+
+  test "unauthenticated users cannot publish" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not @board.reload.published_publicly?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..5b0e921
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+    post board_publication_path(@board), as: :json
+    @key = @board.reload.publication.key
+    sign_out
+  end
+
+  test "anyone with the secret url can see the board" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_match @board.name, response.body
+    assert_match columns(:writebook_triage).name, response.body
+    assert_match ERB::Util.html_escape(cards(:logo).title), response.body
+    assert_match cards(:buy_domain).title, response.body
+  end
+
+  test "public board json includes the public url" do
+    get public_board_path(@key), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@key), @response.parsed_body["public_url"]
+    assert_includes @response.parsed_body["columns"].map { |column| column["name"] }, "Triage"
+  end
+
+  test "columns of a public board can be opened directly" do
+    column = columns(:writebook_triage)
+
+    get public_board_column_path(@key, column)
+
+    assert_response :success
+    assert_match column.name, response.body
+    assert_match ERB::Util.html_escape(cards(:logo).title), response.body
+    assert_no_match(/#{Regexp.escape(cards(:shipping).title)}/, response.body)
+
+    get public_board_column_path(@key, column), as: :json
+    assert_response :success
+    assert_equal column.name, @response.parsed_body["name"]
+    assert_includes @response.parsed_body["cards"].map { |card| card["title"] }, cards(:logo).title
+  end
+
+  test "published cards of a public board can be opened directly" do
+    card = cards(:logo)
+
+    get public_board_card_path(@key, card.number)
+
+    assert_response :success
+    assert_match ERB::Util.html_escape(card.title), response.body
+    assert_match "I agree.", response.body
+
+    get public_board_card_path(@key, card.number), as: :json
+    assert_response :success
+    assert_equal card.title, @response.parsed_body["title"]
+    assert_equal card.number, @response.parsed_body["number"]
+    assert_equal public_board_card_url(@key, card.number), @response.parsed_body["url"]
+  end
+
+  test "closed published cards can be opened directly but drafts cannot" do
+    get public_board_card_path(@key, cards(:shipping).number)
+    assert_response :success
+    assert_match ERB::Util.html_escape(cards(:shipping).title), response.body
+
+    draft = @board.cards.create!(title: "Secret draft", status: "drafted", creator: users(:kevin))
+
+    get public_board_card_path(@key, draft.number)
+    assert_response :not_found
+  end
+
+  test "unknown keys, columns, and other boards are not found" do
+    get public_board_path("not-a-real-key")
+    assert_response :not_found
+
+    get public_board_column_path(@key, columns(:writebook_triage).id.reverse)
+    assert_response :not_found
+
+    other_board = boards(:private)
+    Current.set(account: accounts("37s")) { other_board.publish }
+    get public_board_card_path(@key, cards(:logo).number)
+    assert_response :success
+
+    get public_board_column_path(other_board.publication.key, columns(:writebook_triage))
+    assert_response :not_found
+  end
+
+  test "unpublishing invalidates the secret url" do
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    sign_out
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :not_found
+
+    get public_board_card_path(@key, cards(:logo).number)
+    assert_response :not_found
+  end
+
+  test "republishing issues a new secret url" do
+    sign_in_as :kevin
+    delete board_publication_path(@board), as: :json
+    post board_publication_path(@board), as: :json
+    new_key = @board.reload.publication.key
+    sign_out
+
+    assert_not_equal @key, new_key
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_path(new_key)
+    assert_response :success
+  end
+
+  test "a public url from another account is not found" do
+    other = accounts(:initech)
+    other_board = boards(:miltons_wish_list)
+    Current.set(account: other) { other_board.publish }
+    key = other_board.publication.key
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "images on a published board are publicly accessible" do
+    card = cards(:logo)
+    blob = nil
+    Current.set(account: accounts("37s"), session: sessions(:kevin)) do
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "test.jpg", content_type: "image/jpeg"
+      blob = card.image.blob
+    end
+
+    get rails_blob_path(blob, disposition: :inline)
+    assert_response :redirect
+    assert_match %r{rails/active_storage}, response.location
+  end
+end
