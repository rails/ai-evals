diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..c136e68
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,83 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to public_board_path(@publication.key), class: "btn btn--back btn--circle-mobile" do %>
+      <%= icon_tag "arrow-left" %>
+      <%= tag.strong "Back to #{@board.name}", class: "overflow-ellipsis" %>
+    <% end %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <article class="card">
+      <header class="card__header">
+        <div class="card__board">
+          <div class="card__id"><%= @card.number %></div>
+          <div class="card__board-name">
+            <%= link_to @board.name, public_board_path(@publication.key) %>
+          </div>
+        </div>
+
+        <% if @card.tags.any? %>
+          <div class="card__tags">
+            <% @card.tags.each do |tag| %>
+              <span class="card__tag"><%= tag.title %></span>
+            <% end %>
+          </div>
+        <% end %>
+      </header>
+
+      <div class="card__body">
+        <div class="card__content">
+          <h2 class="card__title"><%= card_html_title(@card) %></h2>
+
+          <% if @card.column %>
+            <p>
+              <%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column) %>
+            </p>
+          <% end %>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <% if @card.steps.any? %>
+            <ul>
+              <% @card.steps.each do |step| %>
+                <li><%= step.completed? ? "Done" : "To do" %>: <%= step.content %></li>
+              <% end %>
+            </ul>
+          <% end %>
+        </div>
+      </div>
+
+      <footer class="card__footer">
+        <p>Added by <%= @card.creator.name %></p>
+        <% if @card.assignees.any? %>
+          <p>Assigned to <%= @card.assignees.map(&:name).to_sentence %></p>
+        <% end %>
+      </footer>
+    </article>
+  </div>
+</article>
+
+<% if @card.comments.any? %>
+  <section class="comments" aria-label="Comments">
+    <% @card.comments.chronologically.each do |comment| %>
+      <article class="comment" id="<%= dom_id(comment) %>">
+        <h3><%= comment.creator.name %></h3>
+        <div class="comment__body lexxy-content">
+          <%= comment.body %>
+        </div>
+      </article>
+    <% end %>
+  </section>
+<% end %>
