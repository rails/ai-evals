diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..5002d33
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,55 @@
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_THRESHOLD = 3
+  BURST_PEOPLE_THRESHOLD = 2
+  STALL_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { published.where.not(burst_at: nil).where(last_active_at: ..STALL_AFTER.ago) }
+  end
+
+  def stalled?
+    published? && burst_at.present? && last_active_at <= STALL_AFTER.ago
+  end
+
+  def stalls_at
+    last_active_at + STALL_AFTER if burst_at.present?
+  end
+
+  def stalled_for_days
+    if stalled?
+      ((Time.current - stalls_at) / 1.day).floor
+    end
+  end
+
+  def detect_comment_burst(at = Time.current)
+    if published? && comment_burst?(at)
+      record_burst(at)
+    end
+  end
+
+  def record_burst(at = Time.current)
+    if published? && (burst_at.nil? || burst_at < at)
+      update!(burst_at: at)
+    end
+  end
+
+  private
+    def comment_burst?(at)
+      count, people = comments.by_user.where(created_at: burst_window_ending_at(at)).pick(
+        Arel.sql("COUNT(*)"),
+        Arel.sql("COUNT(DISTINCT comments.creator_id)")
+      )
+
+      count.to_i >= BURST_COMMENT_THRESHOLD && people.to_i >= BURST_PEOPLE_THRESHOLD
+    end
+
+    def burst_window_ending_at(at)
+      (at - burst_period)..at
+    end
+
+    def burst_period
+      auto_postpone_period.to_i / 3
+    end
+end
