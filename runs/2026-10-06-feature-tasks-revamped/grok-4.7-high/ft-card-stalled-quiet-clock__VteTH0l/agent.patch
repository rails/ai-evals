diff --git a/test/controllers/stalled_cards_test.rb b/test/controllers/stalled_cards_test.rb
new file mode 100644
index 0000000..433502d
--- /dev/null
+++ b/test/controllers/stalled_cards_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+  end
+
+  test "cards index lists stalled cards with indexed_by=stalled" do
+    get cards_path(indexed_by: "stalled")
+    assert_response :success
+
+    assert_select ".card--stalled[data-stalled]", text: /#{Regexp.escape(@card.title)}/
+    assert_select ".card__stalled", text: "Stalled"
+    assert_select ".bubble--stalled[title=?]", "Stalled" do |elements|
+      assert_nil elements.first["hidden"]
+    end
+    assert_match "Stalled for", response.body
+  end
+
+  test "cards index JSON filters stalled cards and reports the flag" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+
+    numbers = @response.parsed_body.pluck("number")
+    assert_includes numbers, @card.number
+    assert_not_includes numbers, cards(:text).number
+
+    body = @response.parsed_body.find { |card| card["number"] == @card.number }
+    assert_equal true, body["stalled"]
+  end
+
+  test "a card shows stalled wherever it is rendered" do
+    get card_path(@card)
+    assert_response :success
+    assert_select ".card--stalled .card__stalled", text: "Stalled"
+    assert_select ".bubble--stalled", text: /Stalled/
+
+    get card_path(@card), as: :json
+    assert_equal true, @response.parsed_body["stalled"]
+  end
+
+  test "activity on the card clears the stalled flag" do
+    post card_comments_path(@card), params: { comment: { body: "Picking this back up" } }, as: :json
+    assert_response :created
+
+    get card_path(@card), as: :json
+    assert_equal false, @response.parsed_body["stalled"]
+  end
+end
diff --git a/test/models/account/data_transfer/record_set_test.rb b/test/models/account/data_transfer/record_set_test.rb
index 8c8d75e..8c12716 100644
--- a/test/models/account/data_transfer/record_set_test.rb
+++ b/test/models/account/data_transfer/record_set_test.rb
@@ -51,6 +51,38 @@ class Account::DataTransfer::RecordSetTest < ActiveSupport::TestCase
     end
   end
 
+test "check and import tolerate a new nullable column missing from an older export" do
+  card_id = ActiveRecord::FixtureSet.identify("imported_card", :uuid)
+  board_id = ActiveRecord::FixtureSet.identify("imported_board", :uuid)
+  creator_id = ActiveRecord::FixtureSet.identify("imported_creator", :uuid)
+  account = importing_account
+
+  data = {
+    "id" => card_id,
+    "account_id" => "old_account",
+    "board_id" => board_id,
+    "creator_id" => creator_id,
+    "number" => 4242,
+    "status" => "published",
+    "title" => "Imported without burst",
+    "last_active_at" => Time.current.iso8601,
+    "created_at" => Time.current.iso8601,
+    "updated_at" => Time.current.iso8601
+  }
+
+  record_set = Account::DataTransfer::RecordSet.new(account: account, model: Card, importable_model_names: %w[ Card ])
+
+  assert_nothing_raised do
+    record_set.check(from: build_reader(dir: "cards", data: data))
+  end
+
+  record_set.import(from: build_reader(dir: "cards", data: data))
+  imported = Card.find(card_id)
+  assert_nil imported.burst_at
+  assert_equal account.id, imported.account_id
+  assert_equal "Imported without burst", imported.title
+end
+
   private
     def importing_account
       @importing_account ||= Account.create!(name: "Importing Account", external_account_id: 99999999)
diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..99f28e0
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    freeze_time do
+      comment_on(@card, users(:david), "First")
+      comment_on(@card, users(:kevin), "Second")
+      assert_nil @card.reload.burst_at
+
+      comment_on(@card, users(:david), "Third")
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "three comments from one person is not a burst" do
+    freeze_time do
+      3.times { |i| comment_on(@card, users(:david), "Note #{i}") }
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "two comments from two people is not a burst" do
+    freeze_time do
+      comment_on(@card, users(:david), "First")
+      comment_on(@card, users(:kevin), "Second")
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments outside a third of the board auto-close period are not a burst" do
+    # Writebook auto-closes after 90 days, so a burst window is 30 days.
+    freeze_time do
+      comment_on(@card, users(:david), "Old", created_at: 31.days.ago)
+      comment_on(@card, users(:kevin), "Also old", created_at: 31.days.ago)
+      comment_on(@card, users(:jz), "Now")
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments inside the board burst window are a burst" do
+    freeze_time do
+      comment_on(@card, users(:david), "Recent", created_at: 29.days.ago)
+      comment_on(@card, users(:kevin), "Also recent", created_at: 29.days.ago)
+      comment_on(@card, users(:jz), "Now")
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "burst window follows the board auto-close period, not a fixed duration" do
+    boards(:writebook).update!(auto_postpone_period: 3.days)
+
+    freeze_time do
+      comment_on(@card, users(:david), "Yesterday", created_at: 2.days.ago)
+      comment_on(@card, users(:kevin), "Also yesterday", created_at: 2.days.ago)
+      comment_on(@card, users(:jz), "Now")
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time do
+      comment_on(@card, users(:system), "Assigned")
+      comment_on(@card, users(:system), "Moved")
+      comment_on(@card, users(:david), "A real comment")
+      comment_on(@card, users(:david), "Still one person")
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "assigning someone is a burst" do
+    freeze_time do
+      cards(:text).toggle_assignment(users(:kevin))
+      assert_equal Time.current, cards(:text).reload.burst_at
+    end
+  end
+
+  test "unassigning someone is not a burst" do
+    cards(:layout).toggle_assignment(users(:jz))
+    assert_nil cards(:layout).reload.burst_at
+  end
+
+  test "reopening a card is a burst" do
+    freeze_time do
+      cards(:shipping).reopen
+      assert_equal Time.current, cards(:shipping).reload.burst_at
+    end
+  end
+
+  test "closing a card is not a burst" do
+    cards(:text).close
+    assert_nil cards(:text).reload.burst_at
+  end
+
+  test "a card that had a burst and then sees no activity for two weeks is stalled" do
+    freeze_time do
+      @card.update!(burst_at: Time.current, last_active_at: 2.weeks.ago)
+      assert @card.stalled?
+      assert_includes Card.stalled, @card
+      assert_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+  test "a burst without two weeks of inactivity is not stalled" do
+    freeze_time do
+      @card.update!(burst_at: Time.current, last_active_at: 2.weeks.ago + 1.minute)
+      assert_not @card.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "inactivity without a burst is not stalled" do
+    @card.update!(last_active_at: 3.weeks.ago, burst_at: nil)
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets a stalled card" do
+    @card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    burst_at = @card.burst_at
+
+    freeze_time do
+      @card.touch_last_active_at
+      assert_not @card.reload.stalled?
+      assert_equal Time.current, @card.last_active_at
+      assert_equal burst_at, @card.burst_at
+    end
+  end
+
+  test "a comment resets a stalled card and can start a new quiet period" do
+    @card.update!(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+
+    freeze_time do
+      comment_on(@card, users(:kevin), "Still here")
+      assert_not @card.reload.stalled?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "filters can list stalled cards, including postponed ones, but not closed ones" do
+    stalled = cards(:logo)
+    postponed = cards(:layout)
+    closed = cards(:shipping)
+    quiet = 3.weeks.ago
+
+    stalled.update!(burst_at: quiet, last_active_at: quiet)
+    postponed.update!(burst_at: quiet, last_active_at: quiet)
+    postponed.postpone
+    postponed.update!(last_active_at: quiet)
+    closed.update!(burst_at: quiet, last_active_at: quiet)
+
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, stalled
+    assert_includes filter.cards, postponed
+    assert_not_includes filter.cards, closed
+    assert_not_includes filter.cards, cards(:text)
+  end
+
+test "comments landing exactly at the end of the burst window still count" do
+  window = boards(:writebook).auto_postpone_period / 3
+
+  freeze_time do
+    comment_on(@card, users(:david), "Boundary", created_at: window.seconds.ago)
+    comment_on(@card, users(:kevin), "Also boundary", created_at: window.seconds.ago)
+    comment_on(@card, users(:jz), "Now")
+
+    assert_equal Time.current, @card.reload.burst_at
+  end
+end
+
+test "burst window falls back to the account auto-close period" do
+  entropies(:writebook_board).destroy
+  @card.reload
+
+  freeze_time do
+    comment_on(@card, users(:david), "Outside", created_at: 11.days.ago)
+    comment_on(@card, users(:kevin), "Also outside", created_at: 11.days.ago)
+    comment_on(@card, users(:jz), "Now")
+    assert_nil @card.reload.burst_at
+
+    @card.comments.by_user.destroy_all
+    comment_on(@card, users(:david), "Inside", created_at: 9.days.ago)
+    comment_on(@card, users(:kevin), "Also inside", created_at: 9.days.ago)
+    comment_on(@card, users(:jz), "Now again")
+    assert_equal Time.current, @card.reload.burst_at
+  end
+end
+
+test "reopening a card that is already open is not a burst" do
+  cards(:text).reopen
+  assert_nil cards(:text).reload.burst_at
+end
+
+  private
+    def comment_on(card, creator, body, created_at: Time.current)
+      card.comments.create!(creator: creator, body: body, created_at: created_at)
+    end
+end
