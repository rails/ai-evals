diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..f5296a6
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,187 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ENTITLED_STATUSES = %w[ active trialing past_due ].freeze
+
+  def plan
+    Billing::Plan.find(plan_key)
+  end
+
+  def entitled?
+    ENTITLED_STATUSES.include?(status)
+  end
+
+  def self.apply_stripe_event(payload)
+    payload = JSON.parse(payload.to_json).with_indifferent_access
+    object = payload.dig(:data, :object) || payload
+
+    case payload[:type]
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      apply_subscription_object(object)
+    when "checkout.session.completed"
+      apply_checkout_session(object)
+    when "invoice.upcoming", "invoice.created", "invoice.finalized", "invoice.updated", "invoice.paid"
+      apply_invoice_object(object)
+    else
+      apply_subscription_object(object) if object[:object] == "subscription"
+    end
+  end
+
+  def self.apply_subscription_object(object)
+    customer_id = stripe_id(object[:customer])
+    return if customer_id.blank?
+
+    account = account_for(object, customer_id)
+    return unless account
+
+    record = find_or_build(account, customer_id)
+    attributes = {
+      stripe_subscription_id: stripe_id(object[:id]).presence || record.stripe_subscription_id,
+      status: object[:status].presence || record.status,
+      current_period_end: period_end_for(object) || record.current_period_end,
+      cancel_at: object.key?(:cancel_at) ? time_for(object[:cancel_at]) : record.cancel_at
+    }
+
+    if key = plan_key_for(object)
+      attributes[:plan_key] = key
+    end
+    attributes[:plan_key] ||= record.plan_key || "free"
+
+    if record.next_amount_due_in_cents.nil?
+      plan = Billing::Plan.find(attributes[:plan_key])
+      attributes[:next_amount_due_in_cents] = plan.price_cents if plan.paid?
+    end
+
+    record.update!(attributes)
+    record
+  end
+
+  def self.apply_checkout_session(object)
+    customer_id = stripe_id(object[:customer])
+    return if customer_id.blank?
+
+    account = account_for(object, customer_id)
+    return unless account
+
+    record = find_or_build(account, customer_id)
+    attributes = {}
+    subscription_id = stripe_id(object[:subscription])
+    attributes[:stripe_subscription_id] = subscription_id if subscription_id.present?
+
+    if plan_key = object.dig(:metadata, :plan_key).presence
+      attributes[:plan_key] = Billing::Plan.find(plan_key).key
+    end
+
+    if object[:status] == "complete" && !record.entitled?
+      attributes[:status] = "active"
+    end
+
+    plan = Billing::Plan.find(attributes[:plan_key] || record.plan_key)
+    if record.next_amount_due_in_cents.nil? && plan.paid?
+      attributes[:next_amount_due_in_cents] = plan.price_cents
+    end
+
+    record.assign_attributes(attributes)
+    record.save! if record.new_record? || record.changed?
+    record
+  end
+
+  def self.apply_invoice_object(object)
+    customer_id = stripe_id(object[:customer])
+    record = find_by(stripe_customer_id: customer_id)
+    return unless record
+
+    amount = object[:amount_due]
+    amount = object[:amount_remaining] if amount.nil?
+    return if amount.nil?
+
+    record.update!(next_amount_due_in_cents: amount)
+    record
+  end
+
+  def self.plan_key_for(object)
+    explicit = object.dig(:metadata, :plan_key)
+    if explicit.present? && known_plan_key?(explicit)
+      return Billing::Plan.find(explicit).key
+    end
+
+    price = object.dig(:items, :data, 0, :price)
+    price_id, unit_amount, lookup_key, nickname = price_details(price)
+
+    if plan = Billing::Plan.for_price_id(price_id)
+      return plan.key
+    end
+
+    if lookup_key.present? && known_plan_key?(lookup_key)
+      return Billing::Plan.find(lookup_key).key
+    end
+
+    if plan = Billing::Plan.for_unit_amount(unit_amount)
+      return plan.key
+    end
+
+    if nickname.to_s.match?(/unlimited\+/i)
+      "unlimited_plus"
+    elsif nickname.to_s.match?(/unlimited/i)
+      "unlimited"
+    end
+  end
+
+  def self.known_plan_key?(key)
+    Billing::Plan::ALIASES.key?(key.to_s.downcase)
+  end
+
+  def self.price_details(price)
+    case price
+    when Hash
+      price = price.with_indifferent_access
+      [ price[:id], price[:unit_amount], price[:lookup_key], price[:nickname] ]
+    when String
+      [ price, nil, nil, nil ]
+    else
+      [ nil, nil, nil, nil ]
+    end
+  end
+
+  def self.period_end_for(object)
+    timestamp = object[:current_period_end]
+    timestamp ||= object.dig(:items, :data, 0, :current_period_end)
+    time_for(timestamp)
+  end
+
+  def self.time_for(timestamp)
+    return if timestamp.blank?
+
+    Time.zone.at(timestamp.to_i)
+  end
+
+  def self.account_for(object, customer_id)
+    identifier = object.dig(:metadata, :account_id) || object[:client_reference_id]
+    find_account(identifier) || find_by(stripe_customer_id: customer_id)&.account
+  end
+
+  def self.find_account(identifier)
+    return if identifier.blank?
+
+    Account.find_by(id: identifier) || numeric_account(identifier)
+  end
+
+  def self.numeric_account(identifier)
+    return unless identifier.to_s.match?(/\A\d+\z/)
+
+    Account.find_by(external_account_id: identifier)
+  end
+
+  def self.find_or_build(account, customer_id)
+    find_by(stripe_customer_id: customer_id) || account.subscription || account.build_subscription(stripe_customer_id: customer_id)
+  end
+
+  def self.stripe_id(value)
+    case value
+    when Hash
+      value.with_indifferent_access[:id]
+    else
+      value
+    end
+  end
+end
diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..b0b0e32
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,89 @@
+class Billing::Plan
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_bytes, :price_env_key
+
+  def initialize(key:, name:, price_cents:, card_limit:, storage_bytes:, price_env_key: nil)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_bytes = storage_bytes
+    @price_env_key = price_env_key
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    price_cents: 0,
+    card_limit: 1_000,
+    storage_bytes: 1.gigabyte
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    price_cents: 2_000,
+    card_limit: nil,
+    storage_bytes: 5.gigabytes,
+    price_env_key: "STRIPE_MONTHLY_V1_PRICE_ID"
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    price_cents: 2_500,
+    card_limit: nil,
+    storage_bytes: 500.gigabytes,
+    price_env_key: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  )
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  ALIASES = {
+    "free" => "free",
+    "freev1" => "free",
+    "unlimited" => "unlimited",
+    "monthlyv1" => "unlimited",
+    "monthly_v1" => "unlimited",
+    "unlimited+" => "unlimited_plus",
+    "unlimitedplus" => "unlimited_plus",
+    "unlimited_plus" => "unlimited_plus",
+    "monthlyextrastoragev1" => "unlimited_plus",
+    "monthly_extra_storage_v1" => "unlimited_plus"
+  }.freeze
+
+  def self.find(key)
+    normalized = ALIASES[key.to_s.downcase] || key.to_s
+    ALL.find { |plan| plan.key == normalized } || FREE
+  end
+
+  def self.for_price_id(price_id)
+    return if price_id.blank?
+
+    PAID.find { |plan| plan.price_id.present? && plan.price_id == price_id }
+  end
+
+  def self.for_unit_amount(amount)
+    return if amount.blank?
+
+    PAID.find { |plan| plan.price_cents == amount.to_i }
+  end
+
+  def price_id
+    ENV[price_env_key] if price_env_key
+  end
+
+  def paid?
+    price_cents.positive?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def storage_limit
+    storage_bytes
+  end
+end
