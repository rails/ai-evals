+class Admin::Accounts::OverriddenLimitsController < AdminController
+  def create
+    account.override_usage(card_count: integer_or_nil(card_count_param), bytes_used: integer_or_nil(bytes_used_param))
+    redirect_to saas.admin_account_path(account)
+  end
+
+  def destroy
+    account.reset_overridden_limits
+    redirect_to saas.admin_account_path(account)
+  end
+
+  private
+    def account
+      @account ||= Account.locate(params[:account_id])
+    end
+
+    def card_count_param
+      nested[:card_count]
+    end
+
+    def bytes_used_param
+      nested[:bytes_used]
+    end
+
+    def nested
+      source = params[:overridden_limit].presence || params
+      source
+    end
+
+    def integer_or_nil(value)
+      return if value.blank?
+
+      Integer(value)
+    rescue ArgumentError, TypeError
+      nil
+    end
+end
