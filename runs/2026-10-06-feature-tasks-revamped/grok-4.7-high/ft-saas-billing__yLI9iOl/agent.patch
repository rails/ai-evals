diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..7e1ed29
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts are limited to 1000 cards and 1 GB" do
+    assert_equal Billing::Plan::FREE, @account.billing_plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "a paid plan brings its own storage allowance" do
+    subscribe(@account, "unlimited")
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "inactive subscriptions do not grant paid allowances" do
+    subscribe(@account, "unlimited", status: "canceled")
+
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "storage exceptions still override the plan allowance" do
+    subscribe(@account, "unlimited")
+    @account.add_storage_exception(9.gigabytes)
+
+    assert_equal 9.gigabytes, @account.storage_limit
+  end
+
+  test "card warning counts down from 100 cards out" do
+    @account.override_usage(card_count: 950, bytes_used: nil)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "card limit is reached at 1000 used cards" do
+    @account.override_usage(card_count: 1_000, bytes_used: nil)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "override replaces bytes used and reset drops it" do
+    @account.override_usage(card_count: 10, bytes_used: 2.gigabytes)
+
+    assert_equal 10, @account.cards_used
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+
+    assert_not_equal 10, @account.cards_used
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "comping lifts free limits and uncomping restores them" do
+    @account.comp
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "comped= remains a no-op for queenbee" do
+    @account.comped = true
+    assert_not @account.comped?
+  end
+
+  private
+    def subscribe(account, plan_key, status: "active")
+      account.create_subscription!(
+        plan_key: plan_key,
+        status: status,
+        stripe_customer_id: "cus_#{account.id}"
+      )
+    end
+end
diff --git a/saas/test/models/billing/plan_test.rb b/saas/test/models/billing/plan_test.rb
new file mode 100644
index 0000000..965f38e
--- /dev/null
+++ b/saas/test/models/billing/plan_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Billing::PlanTest < ActiveSupport::TestCase
+  test "approved prices and allowances" do
+    assert_equal 0, Billing::Plan::FREE.price_cents
+    assert_equal 1_000, Billing::Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Billing::Plan::FREE.storage_limit
+
+    assert_equal 2_000, Billing::Plan::UNLIMITED.price_cents
+    assert_nil Billing::Plan::UNLIMITED.card_limit
+    assert_equal 5.gigabytes, Billing::Plan::UNLIMITED.storage_limit
+
+    assert_equal 2_500, Billing::Plan::UNLIMITED_PLUS.price_cents
+    assert_nil Billing::Plan::UNLIMITED_PLUS.card_limit
+    assert_equal 500.gigabytes, Billing::Plan::UNLIMITED_PLUS.storage_limit
+  end
+
+  test "price ids come from the stripe env vars" do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+
+    assert_equal "price_unlimited", Billing::Plan::UNLIMITED.price_id
+    assert_equal "price_plus", Billing::Plan::UNLIMITED_PLUS.price_id
+    assert_equal Billing::Plan::UNLIMITED, Billing::Plan.for_price_id("price_unlimited")
+    assert_equal Billing::Plan::UNLIMITED_PLUS, Billing::Plan.for_unit_amount(2_500)
+  ensure
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+end
