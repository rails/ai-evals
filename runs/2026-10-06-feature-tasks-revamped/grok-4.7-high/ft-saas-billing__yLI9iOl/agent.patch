diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..19d52c0
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,113 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def locate(id)
+      find_by(id: id) || locate_by_external_id(id) || find(id)
+    end
+
+    def locate_by_external_id(id)
+      find_by(external_account_id: id) if id.to_s.match?(/\A\d+\z/)
+    end
+  end
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+
+    set_callback :cancel, :after, :cancel_remote_subscription
+  end
+
+  def billing_plan
+    candidates = [ Billing::Plan::FREE ]
+    candidates << subscription.plan if subscription&.entitled?
+    candidates << Billing::Plan::UNLIMITED_PLUS if comped?
+    candidates.max_by { |plan| plan.storage_limit }
+  end
+
+  def active_subscription
+    subscription if subscription&.entitled?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(_value)
+  end
+
+  def comp
+    create_billing_waiver! unless billing_waiver
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      [ cards_count, cards.published.count ].max
+    end
+  end
+
+  def cards_remaining
+    return if card_limit.nil?
+
+    card_limit - cards_used
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    return false if card_limit.nil? || exceeding_card_limit?
+
+    cards_remaining <= Billing::Plan::CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      super
+    end
+  end
+
+  def storage_allowance
+    billing_plan.storage_limit
+  end
+
+  def override_usage(card_count:, bytes_used:)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    reload_overridden_limit
+  end
+
+  private
+    def cancel_remote_subscription
+      remote = subscription
+      return if remote&.stripe_subscription_id.blank?
+
+      if ENV["STRIPE_SECRET_KEY"].present?
+        Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+        Stripe::Subscription.cancel(remote.stripe_subscription_id)
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, handled: true)
+    ensure
+      remote&.update!(status: "canceled") if remote&.stripe_subscription_id.present? && remote.respond_to?(:update!)
+    end
+end
