diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..5568b02
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,57 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def new
+    @plans = Billing::Plan::PAID
+  end
+
+  def create
+    plan = Billing::Plan::PAID.find { |candidate| candidate.key == params[:plan] }
+
+    if plan.nil? || plan.price_id.blank?
+      redirect_to saas.new_billing_checkout_path, alert: "Choose a plan to upgrade."
+      return
+    end
+
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+    session = Stripe::Checkout::Session.create(checkout_params(plan))
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, handled: true)
+    redirect_to account_settings_path, alert: "Billing is unavailable right now."
+  end
+
+  private
+    def checkout_params(plan)
+      {
+        mode: "subscription",
+        customer: stripe_customer_id,
+        client_reference_id: Current.account.id,
+        line_items: [ { price: plan.price_id, quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: saas.new_billing_checkout_url,
+        metadata: { account_id: Current.account.id, plan_key: plan.key },
+        subscription_data: {
+          metadata: { account_id: Current.account.id, plan_key: plan.key }
+        }
+      }
+    end
+
+    def stripe_customer_id
+      existing = Current.account.subscription&.stripe_customer_id
+      return existing if existing.present?
+
+      customer = Stripe::Customer.create(
+        email: Current.account.owner_email,
+        name: Current.account.name,
+        metadata: { account_id: Current.account.id }
+      )
+
+      Current.account.create_subscription!(
+        stripe_customer_id: customer.id,
+        plan_key: "free",
+        status: "incomplete"
+      )
+      customer.id
+    end
+end
