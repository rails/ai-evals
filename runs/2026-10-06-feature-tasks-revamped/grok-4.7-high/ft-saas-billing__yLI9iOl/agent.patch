+end
diff --git a/saas/app/controllers/billing/webhooks_controller.rb b/saas/app/controllers/billing/webhooks_controller.rb
new file mode 100644
index 0000000..84e0b7c
--- /dev/null
+++ b/saas/app/controllers/billing/webhooks_controller.rb
@@ -0,0 +1,32 @@
+class Billing::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    verify_signature!
+    Account::Subscription.apply_stripe_event(payload)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verify_signature!
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+      signature = request.headers["Stripe-Signature"]
+      return if secret.blank?
+      return if signature.blank? && Rails.env.local?
+
+      Stripe::Webhook.construct_event(request.raw_post, signature.to_s, secret)
+    end
+
+    def payload
+      body = request.raw_post
+      if body.present? && body.lstrip.start_with?("{")
+        JSON.parse(body)
+      else
+        params.to_unsafe_h.except("controller", "action", "webhook")
+      end
+    end
+end
