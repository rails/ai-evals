+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "members do not see the upgrade pitch in settings" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "admins see a paid plan name" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(plan_key: "unlimited_plus", status: "active", stripe_customer_id: "cus_settings")
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "strong", text: "Unlimited+"
+    assert_select "a", text: "Upgrade"
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..5de303f
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open one by name" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a", text: accounts(:initech).name
+
+      get saas.admin_account_path(accounts(:initech))
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comp and uncomp toggle the waiver" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+      assert account.reload.comped?
+
+      delete saas.admin_account_billing_waiver_path(account)
+      assert_redirected_to saas.admin_account_path(account)
+      assert_not account.reload.comped?
+    end
+  end
+
+  test "override sets usage and reset drops it" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: { card_count: 950, bytes_used: 42 }
+      assert_redirected_to saas.admin_account_path(account)
+    end
+
+    assert_equal 950, account.reload.cards_used
+    assert_equal 42, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_not_equal 950, account.reload.cards_used
+    assert_nil account.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/billing/webhooks_controller_test.rb b/saas/test/controllers/billing/webhooks_controller_test.rb
new file mode 100644
index 0000000..eb553cd
--- /dev/null
+++ b/saas/test/controllers/billing/webhooks_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Billing::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscription updates are applied from stripe webhooks" do
+    untenanted do
+      post "/stripe/webhooks",
+        params: {
+          type: "customer.subscription.updated",
+          data: {
+            object: {
+              id: "sub_123",
+              object: "subscription",
+              customer: "cus_123",
+              status: "active",
+              cancel_at: nil,
+              metadata: { account_id: @account.id, plan_key: "unlimited" },
+              items: {
+                data: [
+                  {
+                    current_period_end: 1_800_000_000,
+                    price: { id: "price_unlimited", unit_amount: 2_000, lookup_key: "unlimited" }
+                  }
+                ]
+              }
+            }
+          }
+        },
+        as: :json
+    end
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal 2_000, subscription.next_amount_due_in_cents
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "invoice events record the next amount due" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_invoice", next_amount_due_in_cents: 2_000)
+
+    untenanted do
+      post "/stripe/webhooks",
+        params: {
+          type: "invoice.upcoming",
+          data: { object: { customer: "cus_invoice", amount_due: 2_500 } }
+        },
+        as: :json
+    end
+
+    assert_response :ok
+    assert_equal 2_500, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "invalid signatures are rejected when a webhook secret is configured" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+
+    untenanted do
+      post "/stripe/webhooks", params: { type: "customer.subscription.updated" }, as: :json, headers: { "Stripe-Signature" => "t=1,v1=bad" }
+    end
+
+    assert_response :bad_request
+  ensure
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+
+  test "a signed webhook is accepted" do
+    secret = "whsec_test"
+    ENV["STRIPE_WEBHOOK_SECRET"] = secret
+    payload = {
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_signed",
+          object: "subscription",
+          customer: "cus_signed",
+          status: "active",
+          metadata: { account_id: @account.id, plan_key: "unlimited_plus" },
+          items: { data: [ { price: { unit_amount: 2_500 } } ] }
+        }
+      }
+    }.to_json
+    signature = Stripe::Webhook::Signature.generate_header(
+      Time.current,
+      Stripe::Webhook::Signature.compute_signature(Time.current, payload, secret)
+    )
+
+    untenanted do
+      post "/stripe/webhooks",
+        params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature }
+    end
+
+    assert_response :ok
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  ensure
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+end
