 - The `users` array contains the current page of results; if there are more users, follow the `Link` response header with `rel="next"`
 
 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+
+## `POST /:account_slug/boards/:board_id/publication`
+
+Publishes a board. Only board administrators (account admins and the board creator) can publish a board.
+
+Publishing creates a secret link. Anyone with that link can view the board, its columns, and its published cards without signing in. Publishing again keeps the same link.
+
+__Response:__
+
+Returns `201 Created` with the board, including a `public_url`:
+
+```json
+{
+  "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+  "name": "Fizzy",
+  "all_access": true,
+  "created_at": "2025-12-05T19:36:35.534Z",
+  "auto_postpone_period_in_days": 30,
+  "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm",
+  "public_url": "http://app.fizzy.localhost:3006/public/boards/secret-key",
+  "creator": {
+    "id": "03f5v9zjw7pz8717a4no1h8a7",
+    "name": "David Heinemeier Hansson",
+    "role": "owner",
+    "active": true,
+    "email_address": "david@example.com",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+  }
+}
+```
+
+The `Location` header points at `public_url`.
+
+## `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes a board. Only board administrators can unpublish a board. The previous secret link stops working. Publishing again creates a new link.
+
+__Response:__
+
+Returns `204 No Content` on success.
+
+## Public boards
+
+Published boards can be viewed without authentication or an account prefix.
+
+### `GET /public/boards/:key`
+
+Returns the published board. Unknown or unpublished keys return `404 Not Found`.
+
+### `GET /public/boards/:key/columns/:id`
+
+Returns a column that belongs to the published board, including its active cards.
+
+### `GET /public/boards/:key/cards/:number`
+
+Returns a published card on that board. Draft cards, and cards from other boards, return `404 Not Found`.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..1389a53
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes a nil public_url by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+    assert_not @board.published?
+  end
+
+  test "index JSON includes a nil public_url by default" do
+    get boards_path, as: :json
+
+    assert_response :success
+    board = @response.parsed_body.find { |record| record["id"] == @board.id }
+    assert_nil board["public_url"]
+  end
+
+  test "admin can publish a board" do
+    assert_difference -> { @board.reload.publication_key.present? ? 1 : 0 }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+    assert @board.published?
+    assert_equal public_board_url(@board.publication_key, script_name: ""), @response.parsed_body["public_url"]
+    assert_no_match %r{/\d+/public/boards}, @response.parsed_body["public_url"]
+    assert_equal @response.parsed_body["public_url"], @response.headers["Location"]
+  end
+
+  test "publishing is idempotent" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication_key
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal key, @board.reload.publication_key
+    assert_equal public_board_url(key, script_name: ""), @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+    key = @board.publication_key
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+    assert_nil @board.publication_key
+
+    get board_path(@board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+
+    untenanted do
+      get public_board_path(key)
+    end
+    assert_response :not_found
+  end
+
+  test "unpublishing a board that is not published is a no-op" do
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "republishing issues a new secret key" do
+    @board.publish
+    old_key = @board.publication_key
+    @board.unpublish
+
+    post board_publication_path(@board), as: :json
+
+    assert_not_equal old_key, @board.reload.publication_key
+  end
+
+  test "board creator who is not an account admin can publish" do
+    logout_and_sign_in_as :david
+    assert_not users(:david).admin?
+    assert users(:david).can_administer_board?(@board)
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "member who cannot administer the board cannot publish" do
+    logout_and_sign_in_as :jz
+    assert_not users(:jz).can_administer_board?(@board)
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "member who cannot administer the board cannot unpublish" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "user without access cannot publish" do
+    logout_and_sign_in_as :jz
+    board = boards(:private)
+    assert_not board.accessible_to?(users(:jz))
+
+    post board_publication_path(board), as: :json
+
+    assert_response :not_found
+    assert_not board.reload.published?
+  end
+
+  test "html publish and unpublish redirect back to settings" do
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "input[aria-label='Public link']"
+    assert_match %r{/public/boards/}, response.body
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..48b1985
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication_key
+    @column = columns(:writebook_in_progress)
+    @card = cards(:text)
+    @draft = cards(:unfinished_thoughts)
+  end
+
+  test "anyone can view a published board without signing in" do
+    untenanted do
+      get public_board_path(@key)
+    end
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: @card.title
+    assert_select "a", text: @column.name
+  end
+
+  test "published board JSON does not require authentication" do
+    untenanted do
+      get public_board_path(@key), as: :json
+    end
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@key, script_name: ""), @response.parsed_body["public_url"]
+    assert_nil @response.parsed_body["user_ids"]
+  end
+
+  test "unknown key is not found" do
+    untenanted do
+      get public_board_path("not-a-real-key")
+    end
+
+    assert_response :not_found
+  end
+
+  test "unpublished board key is not found" do
+    key = @key
+    @board.unpublish
+
+    untenanted do
+      get public_board_path(key)
+    end
+
+    assert_response :not_found
+  end
+
+  test "column of a published board can be opened directly" do
+    untenanted do
+      get public_board_column_path(@key, @column)
+    end
+
+    assert_response :success
+    assert_select "h1", text: @column.name
+    assert_select "a", text: @card.title
+  end
+
+  test "column JSON lists active cards" do
+    untenanted do
+      get public_board_column_path(@key, @column), as: :json
+    end
+
+    assert_response :success
+    assert_equal @column.name, @response.parsed_body["name"]
+    assert_includes @response.parsed_body["cards"].map { |card| card["number"] }, @card.number
+  end
+
+  test "column from another board is not found" do
+    other = columns(:writebook_triage)
+    other_board = boards(:private)
+    other_board.publish
+
+    untenanted do
+      get public_board_column_path(other_board.publication_key, other)
+    end
+
+    assert_response :not_found
+  end
+
+  test "published card can be opened directly" do
+    untenanted do
+      get public_board_card_path(@key, @card.number)
+    end
+
+    assert_response :success
+    assert_match @card.title, response.body
+    assert_match @board.name, response.body
+  end
+
+  test "published card JSON is available" do
+    untenanted do
+      get public_board_card_path(@key, @card), as: :json
+    end
+
+    assert_response :success
+    assert_equal @card.number, @response.parsed_body["number"]
+    assert_equal @card.title, @response.parsed_body["title"]
+    assert_equal "published", @response.parsed_body["status"]
+    assert_equal @column.name, @response.parsed_body.dig("column", "name")
+    assert_nil @response.parsed_body.dig("creator", "email_address")
+  end
+
+  test "draft cards are not publicly visible" do
+    other = boards(:miltons_wish_list)
+    Current.account = other.account
+    other.publish
+
+    untenanted do
+      get public_board_card_path(other.publication_key, @draft.number)
+    end
+
+    assert_response :not_found
+  end
+
+  test "card from another board is not found" do
+    other = boards(:private)
+    other.publish
+
+    untenanted do
+      get public_board_card_path(other.publication_key, @card.number)
+    end
+
+    assert_response :not_found
+  end
+
+  test "signed-in user can still open the public url" do
+    sign_in_as :kevin
+
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_match @board.name, response.body
+  end
+
+  test "public url works when requested under an account prefix" do
+    get "/#{accounts("37s").external_account_id}/public/boards/#{@key}"
+
+    assert_response :success
+    assert_match @board.name, response.body
+  end
+
+  test "closed published cards can be opened directly" do
+    card = cards(:shipping)
+    assert card.closed?
+    assert card.published?
+
+    untenanted do
+      get public_board_card_path(@key, card.number)
+    end
+
+    assert_response :success
+    assert_match card.title, response.body
+  end
+
+  test "cancelled accounts are not publicly visible" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    untenanted do
+      get public_board_path(@key)
+    end
+
+    assert_response :not_found
+  end
+
+  test "nested board JSON includes public_url" do
+    sign_in_as :kevin
+
+    get card_path(@card), as: :json
+
+    assert_equal public_board_url(@key, script_name: ""), @response.parsed_body.dig("board", "public_url")
+  end
+end
