diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..3028d1f
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,39 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLICATION_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    return if published?
+
+    attempts = 0
+
+    begin
+      update!(publication_key: generated_publication_key)
+    rescue ActiveRecord::RecordNotUnique
+      attempts += 1
+      retry if attempts < 3
+      raise
+    end
+  end
+
+  def unpublish
+    update!(publication_key: nil) if published?
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  private
+    def generated_publication_key
+      loop do
+        candidate = SecureRandom.base58(PUBLICATION_KEY_LENGTH)
+        break candidate unless self.class.exists?(publication_key: candidate)
+      end
+    end
+end
