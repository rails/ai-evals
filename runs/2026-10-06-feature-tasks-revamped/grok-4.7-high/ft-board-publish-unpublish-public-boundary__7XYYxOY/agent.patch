new file mode 100644
index 0000000..f89befd
--- /dev/null
+++ b/app/views/public/cards/show.html.erb
@@ -0,0 +1,82 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <% if @card.column %>
+      <%= link_to @card.column.name, public_board_column_path(@board.publication_key, @card.column, script_name: ""), class: "btn" %>
+    <% else %>
+      <%= link_to @board.name, public_board_path(@board.publication_key, script_name: ""), class: "btn" %>
+    <% end %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<section class="card-perma" style="--card-color: <%= @card.color %>;">
+  <article class="card">
+    <header class="card__header">
+      <p class="txt-small">
+        <%= link_to @board.name, public_board_path(@board.publication_key, script_name: "") %>
+        <% if @card.column %>
+          · <%= link_to @card.column.name, public_board_column_path(@board.publication_key, @card.column, script_name: "") %>
+        <% end %>
+      </p>
+
+      <% if @card.tags.any? %>
+        <p class="card__tags txt-small txt-uppercase"><%= @card.tags.map(&:title).join(", ") %></p>
+      <% end %>
+    </header>
+
+    <div class="card__body">
+      <h1 class="card__title"><%= card_html_title(@card) %></h1>
+
+      <% if @card.description.present? %>
+        <div class="card__description lexxy-content">
+          <%= @card.description %>
+        </div>
+      <% end %>
+
+      <% if @card.steps.any? %>
+        <ol class="steps txt-small">
+          <% @card.steps.each do |step| %>
+            <li class="step">
+              <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+              <span><%= step.content %></span>
+            </li>
+          <% end %>
+        </ol>
+      <% end %>
+    </div>
+
+    <footer class="card__footer txt-small">
+      <span>Added by <%= @card.creator.name %></span>
+      <% if @card.closed? %>
+        <span>Closed</span>
+      <% elsif @card.postponed? %>
+        <span>Not now</span>
+      <% end %>
+    </footer>
+  </article>
+
+  <% if @card.image.attached? %>
+    <div class="margin-block-start">
+      <%= image_tag @card.image, alt: "" %>
+    </div>
+  <% end %>
+
+  <% if @card.comments.any? %>
+    <section class="margin-block-start">
+      <h2 class="txt-medium">Comments</h2>
+      <% @card.comments.preloaded.chronologically.each do |comment| %>
+        <article class="comment align-start full-width" id="<%= dom_id(comment) %>">
+          <div class="comment__content">
+            <h3 class="txt-small"><%= comment.creator.name %></h3>
+            <div class="comment__body lexxy-content"><%= comment.body %></div>
+          </div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+</section>
