+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-small margin-block-start",
+            data: { turbo_frame: "_top", turbo_confirm: "Unpublish this board? The current link will stop working." } do %>
+        <span>Unpublish</span>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p>Publish this board to share a secret link. Anyone with the link can view it without signing in.</p>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :post, class: "btn btn--link", data: { turbo_frame: "_top" } do %>
+        <%= icon_tag "globe" %>
+        <span>Publish board</span>
+      <% end %>
+    <% else %>
+      <p class="txt-small">Only admins can publish this board.</p>
+    <% end %>
+  <% end %>
+</div>
