diff --git a/app/models/zip_file/entry_io.rb b/app/models/zip_file/entry_io.rb
new file mode 100644
index 0000000..7e3eceb
--- /dev/null
+++ b/app/models/zip_file/entry_io.rb
@@ -0,0 +1,74 @@
+# A readable IO over one zip entry. Streams inflated bytes without loading the
+# entry into memory, and reports +size+ so storage services can multipart-upload
+# very large files.
+class ZipFile::EntryIO
+  def initialize(extractor, size)
+    @extractor = extractor
+    @size = size
+    @buffer = +"".b
+  end
+
+  def size
+    @size
+  end
+
+  def binmode
+    self
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length.nil?
+      read_all(outbuf)
+    else
+      read_partial(length, outbuf)
+    end
+  end
+
+  def readpartial(length, outbuf = nil)
+    data = read(length, outbuf)
+    raise EOFError if data.nil?
+    data
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def close
+  end
+
+  private
+    def read_all(outbuf)
+      return nil if eof?
+
+      data = @buffer.dup
+      @buffer.clear
+      until @extractor.eof?
+        chunk = @extractor.extract(1.megabyte)
+        break if chunk.nil?
+        data << chunk
+      end
+      fill_outbuf(data, outbuf)
+    end
+
+    def read_partial(length, outbuf)
+      while @buffer.bytesize < length && !@extractor.eof?
+        chunk = @extractor.extract(length)
+        break if chunk.nil?
+        @buffer << chunk
+      end
+
+      return nil if @buffer.empty?
+
+      data = @buffer.byteslice(0, length)
+      @buffer = @buffer.byteslice(length..-1) || +"".b
+      fill_outbuf(data, outbuf)
+    end
+
+    def fill_outbuf(data, outbuf)
+      return data unless outbuf
+
+      outbuf.replace(data)
+      outbuf
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..224d525
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,78 @@
+# Reads a zip written by ZipFile::Writer, including archives too large to
+# download whole. Local file headers are resolved lazily so opening a remote
+# archive does not issue one request per entry.
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @parser = ZipKit::FileReader.new
+    @entries = @parser.read_zip_structure(io: io, read_local_headers: false)
+    @by_name = @entries.index_by(&:filename)
+  end
+
+  def exists?(path)
+    @by_name.key?(path)
+  end
+
+  def glob(pattern)
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name, File::FNM_PATHNAME) }.sort
+  end
+
+  def read(path)
+    data = +"".b
+    extract(path) { |chunk| data << chunk }
+    data
+  end
+
+  def each_line(path)
+    buffer = +"".b
+    extract(path) do |chunk|
+      buffer << chunk.b
+      while (index = buffer.index("\n".b))
+        line = buffer.slice!(0..index)
+        yield line.force_encoding(Encoding::UTF_8)
+      end
+    end
+    yield buffer.force_encoding(Encoding::UTF_8) if buffer.present?
+  end
+
+  def each_json_record(path)
+    each_line(path) do |line|
+      stripped = line.strip
+      next if stripped.blank?
+      yield JSON.parse(stripped)
+    end
+  end
+
+  def entry_io(path)
+    entry = entry_for(path)
+    ZipFile::EntryIO.new(extractor_for(entry), entry.uncompressed_size)
+  end
+
+  def close
+    @io.close if @io.respond_to?(:close)
+  end
+
+  private
+    def extract(path)
+      extractor = extractor_for(entry_for(path))
+      until extractor.eof?
+        chunk = extractor.extract(1.megabyte)
+        break if chunk.nil?
+        yield chunk unless chunk.empty?
+      end
+    end
+
+    def entry_for(path)
+      @by_name[path] || raise(Account::DataTransfer::Error, "Export is missing #{path}")
+    end
+
+    def extractor_for(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @parser.get_compressed_data_offset(
+          io: @io,
+          local_file_header_offset: entry.local_file_header_offset
+        )
+      end
+      entry.extractor_from(@io)
+    end
+end
