diff --git a/app/controllers/account/exports_controller.rb b/app/controllers/account/exports_controller.rb
new file mode 100644
index 0000000..147580c
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,53 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+  allow_unauthenticated_access only: :show
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: :full)
+    export.process_later
+
+    redirect_to account_settings_path, notice: "We'll email you a download link when your account export is ready."
+  end
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+
+    if @export.expired?
+      render :expired, status: :gone
+      return
+    end
+
+    unless @export.downloadable_by?(Current.user) || @export.token_authenticates?(params[:token])
+      if authenticated?
+        head :forbidden
+      else
+        request_authentication
+      end
+      return
+    end
+
+    unless @export.ready? && @export.file.attached?
+      render :unavailable, status: :not_found
+      return
+    end
+
+    send_export(@export)
+  end
+
+  private
+    def send_export(export)
+      blob = export.file.blob
+      if ZipFile.s3_service?(blob.service)
+        redirect_to blob.url(expires_in: export.time_remaining, disposition: :attachment, filename: blob.filename), allow_other_host: true
+      elsif blob.service.respond_to?(:path_for)
+        send_file blob.service.path_for(blob.key),
+          filename: blob.filename.to_s,
+          type: blob.content_type,
+          disposition: :attachment
+      else
+        send_stream(filename: blob.filename.to_s, type: blob.content_type, disposition: :attachment) do |stream|
+          blob.download { |chunk| stream.write(chunk) }
+        end
+      end
+    end
+end
