+++ b/app/models/account/data_transfer/context.rb
@@ -0,0 +1,36 @@
+class Account::DataTransfer::Context
+  attr_reader :account, :id_map, :key_map, :uploaded_keys
+
+  def initialize(account:, id_map:, key_map:, uploaded_keys:)
+    @account = account
+    @id_map = id_map
+    @key_map = key_map
+    @uploaded_keys = uploaded_keys
+  end
+
+  def remap_attributes(attrs)
+    attrs.each_with_object({}) do |(key, value), result|
+      result[key] = key == "id" || key.end_with?("_id") ? remap_id(value) : remap_nested(value)
+    end
+  end
+
+  def remap_id(value)
+    return value if value.blank?
+
+    id_map[value] || value
+  end
+
+  private
+    def remap_nested(value)
+      case value
+      when Hash
+        value.transform_values { |nested| remap_nested(nested) }
+      when Array
+        value.map { |nested| remap_nested(nested) }
+      when String
+        id_map[value] || value
+      else
+        value
+      end
+    end
+end
