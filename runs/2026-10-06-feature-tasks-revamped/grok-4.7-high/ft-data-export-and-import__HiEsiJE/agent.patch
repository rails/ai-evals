diff --git a/test/models/account/data_transfer/importer_test.rb b/test/models/account/data_transfer/importer_test.rb
new file mode 100644
index 0000000..1abbfa9
--- /dev/null
+++ b/test/models/account/data_transfer/importer_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    @comment = comments(:logo_agreement_jz)
+    @blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    @comment.update!(body: ActionText::Content.new("<p>See this</p>").append_attachables(@blob))
+
+    @private_card = @account.boards.find_by!(name: "Private board").cards.create!(
+      title: "Secret plan",
+      status: "published",
+      creator: users(:kevin)
+    )
+  end
+
+  test "account export and import copies boards, cards, comments, files, and people" do
+    export = export_account
+    export.process
+
+    assert export.reload.ready?
+    assert export.file.attached?
+    assert_equal 1.day.from_now.to_i, export.expires_at.to_i
+
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { Board.count }, @account.boards.count do
+        imported = import_blob(export.file.blob)
+        assert_equal @account.name, imported.name
+        assert_not_equal @account.id, imported.id
+        assert_not_equal @account.external_account_id, imported.external_account_id
+
+        assert_equal @account.boards.count, imported.boards.count
+        assert_equal @account.cards.count, imported.cards.count
+        assert_equal @account.users.count, imported.users.count
+        assert imported.cards.find_by!(title: "Secret plan")
+
+        imported_card = imported.cards.find_by!(title: @card.title)
+        assert imported_card.image.attached?
+        assert_equal @card.image.blob.checksum, imported_card.image.blob.checksum
+        assert_equal @card.image.blob.download, imported_card.image.blob.download
+
+        imported_comment = imported_card.comments.find_by!(creator: imported.users.find_by!(name: "JZ"))
+        assert_includes imported_comment.body.to_plain_text, "See this"
+        imported_embed = imported_comment.body.embeds.blobs.sole
+        assert_equal @blob.checksum, imported_embed.checksum
+        assert_equal @blob.download, imported_embed.download
+        assert_equal imported_embed, ActionText::Content.new(imported_comment.body.to_s).attachables.grep(ActiveStorage::Blob).sole
+
+        imported_webhook = imported.boards.find_by!(name: "Writebook").webhooks.first
+        if imported_webhook
+          assert_kind_of Array, imported_webhook.subscribed_actions
+          assert_includes imported_webhook.subscribed_actions, "card_closed"
+        end
+
+        assert_equal identities(:david), imported.users.find_by!(name: "David").identity
+        assert_nil imported.users.find_by!(role: :system).identity
+      end
+    end
+  end
+
+  test "a second import of the same file creates another account" do
+    export = export_account
+    export.process
+
+    first = import_blob(export.file.blob)
+    second = import_blob(export.file.blob)
+
+    assert_not_equal first.id, second.id
+    assert_equal first.cards.count, second.cards.count
+  end
+
+  test "failed import leaves nothing behind" do
+    export = export_account
+    export.process
+    accounts_before = Account.pluck(:id)
+    boards_before = Board.count
+    blobs_before = ActiveStorage::Blob.count
+
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import).raises(Account::DataTransfer::Error.new("disk full"))
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Account::DataTransfer::Importer.new(identity: identities(:jason)).import(export.file.blob)
+    end
+
+    assert_equal "disk full", error.message
+    assert_equal accounts_before.sort, Account.pluck(:id).sort
+    assert_equal boards_before, Board.count
+    assert_equal blobs_before, ActiveStorage::Blob.count
+  end
+
+  test "card export includes visible cards with comments and files, and skips the rest" do
+    export = @account.exports.create!(user: users(:david), kind: :cards)
+    export.process
+
+    ZipFile.open(export.file.blob) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "cards", manifest["kind"]
+
+      visible = JSON.parse(zip.read("cards/#{@card.number}.json"))
+      assert_equal @card.title, visible["title"]
+      assert_equal 1, visible["comments"].count { |comment| comment["body"]["plain_text"].include?("See this") }
+      image_path = visible["image"]["path"]
+      assert zip.exists?(image_path)
+      assert_equal @card.image.blob.download, zip.read(image_path)
+
+      comment = visible["comments"].find { |item| item["body"]["plain_text"].include?("See this") }
+      assert zip.exists?(comment["attachments"].sole["path"])
+
+      assert_not zip.exists?("cards/#{@private_card.number}.json")
+    end
+  end
+
+  private
+    def export_account
+      @account.exports.create!(user: users(:kevin), kind: :full)
+    end
+
+    def import_blob(blob)
+      Account::DataTransfer::Importer.new(identity: identities(:jason)).import(blob)
+    end
+end
