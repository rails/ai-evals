diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..bced6aa
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can request an account export" do
+    assert_enqueued_with(job: Export::ProcessJob) do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "full", Current.account.exports.last.kind
+  end
+
+  test "member cannot request an account export" do
+    logout_and_sign_in_as :david
+
+    post account_exports_path
+
+    assert_response :forbidden
+  end
+
+  test "email link downloads the export for a day" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin), kind: :full)
+    perform_enqueued_jobs do
+      export.process
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "kevin@37signals.com" ], mail.to
+    assert_match "ready", mail.subject
+
+    url = mail.body.encoded[%r{https?://[^\s"]+/account/exports/[^\s"]+}]
+    assert url, mail.body.encoded
+    assert_includes url, "/#{accounts(:"37s").external_account_id}/account/exports/"
+    token = Rack::Utils.parse_query(URI(url).query)["token"]
+
+    sign_out
+    get account_export_path(export, token: token)
+
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+
+    travel 1.day + 1.minute do
+      get account_export_path(export, token: token)
+      assert_response :gone
+    end
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..d0e50b6
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new import form is available to a signed-in user" do
+    get new_account_import_path
+
+    assert_response :success
+    assert_match "Import an account", response.body
+  end
+
+  test "importing an account file emails when it is done" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin), kind: :full)
+    export.process
+
+    uploaded = nil
+    export.file.open do |file|
+      uploaded = Rack::Test::UploadedFile.new(file.path, "application/zip", original_filename: "account.zip")
+      assert_difference -> { Account.count }, 1 do
+        perform_enqueued_jobs do
+          post account_imports_path, params: { file: uploaded }
+        end
+      end
+    end
+
+    assert_redirected_to account_import_path(Import.last)
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "david@37signals.com" ], mail.to
+    assert_match "ready", mail.subject
+    assert_match Import.last.created_account.name, mail.body.encoded
+    assert_includes mail.body.encoded, "/#{Import.last.created_account.external_account_id}/"
+    assert_not_includes mail.body.encoded, "/#{accounts(:"37s").external_account_id}/"
+  end
+
+  test "a failed import emails why and leaves nothing behind" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin), kind: :full)
+    export.process
+    accounts_before = Account.count
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import).raises(Account::DataTransfer::Error.new("The zip is missing cards"))
+
+    uploaded = nil
+    export.file.open do |file|
+      uploaded = Rack::Test::UploadedFile.new(file.path, "application/zip", original_filename: "account.zip")
+      perform_enqueued_jobs do
+        post account_imports_path, params: { file: uploaded }
+      end
+    end
+
+    assert_equal accounts_before, Account.count
+    mail = ActionMailer::Base.deliveries.last
+    assert_match "failed", mail.subject
+    assert_match "missing cards", mail.body.encoded
+    assert_equal "failed", Import.last.status
+  end
+
+  test "rejects a file that is not a zip" do
+    file = Rack::Test::UploadedFile.new(file_fixture("moon.jpg"), "image/jpeg", original_filename: "moon.jpg")
+
+    assert_no_difference -> { Import.count } do
+      post account_imports_path, params: { file: file }
+    end
+
+    assert_redirected_to new_account_import_path
+  end
+end
