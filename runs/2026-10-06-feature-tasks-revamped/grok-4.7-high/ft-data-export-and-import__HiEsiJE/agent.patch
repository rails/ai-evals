+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  test "a card archive cannot be imported as an account" do
+    export = accounts(:"37s").exports.create!(user: users(:david), kind: :cards)
+    export.process
+
+    error = assert_raises(Account::DataTransfer::Error) do
+      Account::DataTransfer::Importer.new(identity: identities(:david)).import(export.file.blob)
+    end
+
+    assert_match "not a Fizzy account export", error.message
+    assert_equal 3, Account.count
+  end
+
+  test "a corrupt zip fails and leaves nothing behind" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("not a zip"),
+      filename: "account.zip",
+      content_type: "application/zip"
+    )
+
+    assert_no_difference -> { Account.count } do
+      error = assert_raises(Account::DataTransfer::Error) do
+        Account::DataTransfer::Importer.new(identity: identities(:david)).import(blob)
+      end
+      assert_match "not a valid", error.message
+    end
+  end
+end
