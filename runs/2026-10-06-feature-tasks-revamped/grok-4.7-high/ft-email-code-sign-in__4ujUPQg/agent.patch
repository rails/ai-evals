+++ b/test/controllers/join_codes_controller_test.rb
@@ -79,3 +79,62 @@ class JoinCodesControllerTest < ActionDispatch::IntegrationTest
     assert_response :too_many_requests
   end
 end
+
+class JoinCodesControllerEmailCodeTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "joining by email code creates a member and signs them in" do
+    email_address = "joiner@example.com"
+
+    assert_no_difference -> { User.count } do
+      assert_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+      end
+    end
+
+    assert_response :redirect
+    assert_match %r{/session/magic_link/new\z}, response.location
+    code = email_code
+    assert_includes ActionMailer::Base.deliveries.last.subject, code
+
+    untenanted do
+      assert_difference -> { User.count }, +1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to new_users_verification_url(script_name: @account.slug)
+      assert cookies[:session_token].present?
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    user = User.active.find_by!(account: @account, identity: identity)
+    assert_equal email_address, user.name
+  end
+
+  test "joining an existing member by email code signs them in" do
+    identity = identities(:mike)
+    identity.join(@account)
+    user = User.find_by!(account: @account, identity: identity)
+    user.update!(name: "Mike")
+
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+    code = email_code
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to landing_url(script_name: @account.slug)
+      assert cookies[:session_token].present?
+    end
+  end
+
+  private
+    def email_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
