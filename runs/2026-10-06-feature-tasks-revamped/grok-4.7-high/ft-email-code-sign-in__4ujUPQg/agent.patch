diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..79395f1
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,105 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity, optional: true
+  belongs_to :account, optional: true
+
+  has_secure_password :code, validations: false, reset_token: false
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), scopes: false
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code_digest, :purpose, :expires_at, presence: true
+
+  before_validation :prepare_for_creation, on: :create
+
+  class << self
+    def issue(email_address:, purpose:, account: nil, join_code: nil)
+      transaction do
+        email_address = normalize_email_address(email_address)
+        where(email_address: email_address, used_at: nil).update_all(used_at: Time.current)
+
+        create!(email_address: email_address, purpose: purpose, account: account, join_code: join_code)
+      end
+    end
+
+    def issue_and_deliver(...)
+      issue(...).tap(&:deliver)
+    end
+
+    def normalize_code(code)
+      code.to_s.gsub(/[[:space:]]/, "").upcase
+    end
+
+    def normalize_email_address(email_address)
+      Identity.new(email_address: email_address).email_address.to_s
+    end
+  end
+
+  def deliver
+    MagicLinkMailer.code(email_address, code).deliver_now
+  end
+
+  def matches?(submitted_code)
+    normalized = self.class.normalize_code(submitted_code)
+    normalized.present? && authenticate_code(normalized).present?
+  end
+
+  def redeem(submitted_code)
+    return unless matches?(submitted_code)
+
+    with_lock do
+      return unless active?
+
+      if fulfilled_identity = fulfill
+        update!(used_at: Time.current)
+        fulfilled_identity
+      end
+    end
+  end
+
+  def active?
+    used_at.nil? && expires_at&.future?
+  end
+
+  private
+    def prepare_for_creation
+      generate_code
+      set_expiration
+      assign_identity
+    end
+
+    def generate_code
+      self.code ||= SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+
+    def assign_identity
+      self.identity ||= Identity.find_by(email_address: email_address) if email_address.present?
+    end
+
+    def fulfill
+      if sign_in?
+        identity
+      elsif sign_up?
+        Identity.find_or_create_by!(email_address: email_address)
+      elsif join?
+        fulfill_join
+      end
+    end
+
+    def fulfill_join
+      record = Account::JoinCode.find_by(account_id: account_id, code: join_code)
+      return unless record&.active?
+
+      joining_identity = Identity.find_or_create_by!(email_address: email_address)
+      record.redeem_if { joining_identity.join(record.account) }
+      joining_identity
+    end
+end
