@@ -0,0 +1,71 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = find_magic_link_by_cookie
+  end
+
+  def create
+    magic_link = find_magic_link_by_cookie
+    identity = magic_link&.redeem(params[:code])
+
+    if identity
+      sign_in_and_continue(magic_link, identity)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def sign_in_and_continue(magic_link, identity)
+      start_new_session_for identity
+      clear_pending_authentication_token
+
+      respond_to do |format|
+        format.html { redirect_to continuation_url(magic_link, identity) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def continuation_url(magic_link, identity)
+      if magic_link.sign_in?
+        after_authentication_url
+      elsif magic_link.sign_up?
+        new_signup_completion_path
+      elsif magic_link.join?
+        join_continuation_url(magic_link, identity)
+      end
+    end
+
+    def join_continuation_url(magic_link, identity)
+      user = User.active.find_by!(account: magic_link.account, identity: identity)
+
+      if user.setup?
+        landing_url(script_name: magic_link.account.slug)
+      else
+        new_users_verification_url(script_name: magic_link.account.slug)
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
