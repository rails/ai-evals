+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "sign in by email code" do
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert cookies[:pending_authentication_token].present?
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+
+      code = email_code
+      assert_equal 6, code.length
+      assert_includes ActionMailer::Base.deliveries.last.subject, code
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "sign in by email code via JSON" do
+    untenanted do
+      assert_emails 1 do
+        post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      end
+
+      assert_response :created
+      token = @response.parsed_body["pending_authentication_token"]
+      assert token.present?
+      assert_equal token, cookies[:pending_authentication_token]
+
+      post session_magic_link_path(format: :json), params: { code: email_code }, as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "JSON magic link accepts the pending token supplied as a cookie" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+      token = @response.parsed_body["pending_authentication_token"]
+      code = email_code
+
+      cookies.delete(:pending_authentication_token)
+      cookies[:pending_authentication_token] = token
+
+      post session_magic_link_path(format: :json), params: { code: code }, as: :json
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "wrong code does not sign in" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "wrong code via JSON is unauthorized" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }, as: :json
+
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "lowercase code signs in" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+
+      post session_magic_link_path, params: { code: email_code.downcase }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "code does not work after fifteen minutes" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = email_code
+
+      travel MagicLink::EXPIRATION + 1.minute do
+        post session_magic_link_path, params: { code: code }
+
+        assert_not cookies[:session_token].present?
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+  end
+
+  test "code still works just before it expires" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = email_code
+
+      travel MagicLink::EXPIRATION - 1.minute do
+        post session_magic_link_path, params: { code: code }
+
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a code cannot be reused" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = email_code
+
+      post session_magic_link_path, params: { code: code }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      assert_not cookies[:session_token].present?
+
+      post session_magic_link_path, params: { code: code }
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "unknown email does not send a code" do
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: "missing@example.com" }
+      end
+
+      assert_redirected_to new_session_path
+      assert_match "couldn't find that email address", flash[:alert]
+    end
+  end
+
+  test "invalid email is unprocessable via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: "not-an-email" }, as: :json
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  private
+    def email_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
