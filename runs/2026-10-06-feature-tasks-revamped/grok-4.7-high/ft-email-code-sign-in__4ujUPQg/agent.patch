@@ -111,4 +111,42 @@ module Authentication
     def session_token
       cookies[:session_token]
     end
+
+    def send_email_code(email_address, purpose:, account: nil, join_code: nil)
+      magic_link = MagicLink.issue_and_deliver(
+        email_address: email_address,
+        purpose: purpose,
+        account: account,
+        join_code: join_code
+      )
+      set_pending_authentication_token(magic_link)
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_token(magic_link)
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.signed_id(expires_in: MagicLink::EXPIRATION, purpose: :authentication),
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRATION.from_now
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def find_magic_link_by_cookie
+      if token = cookies.signed[:pending_authentication_token]
+        MagicLink.find_signed(token, purpose: :authentication)
+      end
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
 end
