+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "code is in the subject so it shows in a notification" do
+    email = MagicLinkMailer.code("person@example.com", "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_equal "ABC123 is your Fizzy code", email.subject
+    assert_match "ABC123", email.text_part.body.decoded
+    assert_match "ABC123", email.html_part.body.decoded
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..ad403b0
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @email = identities(:kevin).email_address
+  end
+
+  test "issues a six-character code that expires in fifteen minutes" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+
+    assert_equal 6, magic_link.code.length
+    assert_match(/\A[A-Z0-9]{6}\z/, magic_link.code)
+    assert_in_delta MagicLink::EXPIRATION.from_now, magic_link.expires_at, 2.seconds
+    assert magic_link.active?
+    assert magic_link.matches?(magic_link.code)
+  end
+
+  test "code match is case-insensitive and ignores spaces" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+
+    assert magic_link.matches?(magic_link.code.downcase)
+    assert magic_link.matches?(" #{magic_link.code[0, 3]} #{magic_link.code[3, 3]} ")
+    assert_not magic_link.matches?("WRONG1")
+  end
+
+  test "redeem signs in an existing identity and cannot be reused" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+
+    assert_equal identities(:kevin), magic_link.redeem(magic_link.code)
+    assert_not magic_link.reload.active?
+    assert_nil magic_link.redeem(magic_link.code)
+  end
+
+  test "code stops working after fifteen minutes" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+    code = magic_link.code
+
+    travel_to magic_link.expires_at - 1.second do
+      assert magic_link.reload.active?
+      assert_equal identities(:kevin), magic_link.redeem(code)
+    end
+  end
+
+  test "expired code cannot be redeemed" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+    code = magic_link.code
+
+    travel_to magic_link.expires_at + 1.second do
+      assert_not magic_link.reload.active?
+      assert_nil magic_link.redeem(code)
+    end
+  end
+
+  test "deliver puts the code in the email subject" do
+    magic_link = MagicLink.issue(email_address: @email, purpose: :sign_in)
+
+    assert_emails 1 do
+      magic_link.deliver
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @email ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_includes email.body.encoded, magic_link.code
+  end
+
+  test "issuing a new code invalidates the previous one" do
+    first = MagicLink.issue(email_address: @email, purpose: :sign_in)
+    second = MagicLink.issue(email_address: @email, purpose: :sign_up)
+
+    assert_not first.reload.active?
+    assert second.active?
+    assert_nil first.redeem(first.code)
+  end
+end
