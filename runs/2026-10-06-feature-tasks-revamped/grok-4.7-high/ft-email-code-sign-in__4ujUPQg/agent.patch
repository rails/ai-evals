@@ -0,0 +1,45 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.text_field :code,
+          required: true,
+          autofocus: true,
+          autocomplete: "one-time-code",
+          autocapitalize: "characters",
+          autocorrect: "off",
+          spellcheck: false,
+          maxlength: MagicLink::CODE_LENGTH,
+          class: "input",
+          placeholder: "Enter code" %>
+
+    <p>
+      <% if @magic_link %>
+        We sent a code to <strong><%= @magic_link.email_address %></strong>. Enter it to continue. It works for 15 minutes.
+      <% else %>
+        Enter the code from your email. It works for 15 minutes.
+      <% end %>
+    </p>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small center margin-block-start">
+    <% if @magic_link&.join? && @magic_link.account %>
+      <%= link_to "Use a different email", join_path(code: @magic_link.join_code, script_name: @magic_link.account.slug), class: "txt-link" %>
+    <% elsif @magic_link&.sign_up? %>
+      <%= link_to "Use a different email", new_signup_path, class: "txt-link" %>
+    <% else %>
+      <%= link_to "Use a different email", new_session_path, class: "txt-link" %>
+    <% end %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
