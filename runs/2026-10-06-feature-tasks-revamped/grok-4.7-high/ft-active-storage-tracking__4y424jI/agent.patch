diff --git a/app/jobs/storage/sync_attachment_job.rb b/app/jobs/storage/sync_attachment_job.rb
new file mode 100644
index 0000000..5452ae9
--- /dev/null
+++ b/app/jobs/storage/sync_attachment_job.rb
@@ -0,0 +1,9 @@
+class Storage::SyncAttachmentJob < ApplicationJob
+  # One reconciliation per attachment at a time. Later changes wait and then
+  # observe the committed state, so concurrent uploads don't clobber each other.
+  limits_concurrency to: 1, key: ->(attachment_id) { attachment_id }, duration: 5.minutes
+
+  def perform(attachment_id)
+    Storage.sync_attachment(attachment_id)
+  end
+end
