+++ b/saas/app/controllers/billing/webhooks_controller.rb
@@ -0,0 +1,22 @@
+class Billing::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+  skip_before_action :require_account
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, signature_header, webhook_secret)
+    Billing::Webhook.process(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def signature_header
+      request.headers["Stripe-Signature"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"].to_s
+    end
+end
