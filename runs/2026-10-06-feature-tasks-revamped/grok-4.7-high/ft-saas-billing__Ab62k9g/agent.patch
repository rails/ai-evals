+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open one by name" do
+    sign_in_as :david
+
+    untenanted do
+      get admin_accounts_path
+      assert_response :success
+      assert_select "a", text: accounts(:initech).name
+
+      get admin_account_path(accounts(:initech))
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "button", text: "Override"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "non-staff cannot open the account tools" do
+    sign_in_as :jz
+
+    untenanted do
+      get admin_accounts_path
+      assert_response :forbidden
+    end
+  end
+
+  test "comp uncomp override and reset" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post admin_account_billing_waiver_path(account)
+      assert_redirected_to admin_account_path(account)
+      assert account.reload.billing_waiver
+
+      delete admin_account_billing_waiver_path(account)
+      assert_redirected_to admin_account_path(account)
+      assert_nil account.reload.billing_waiver
+
+      post admin_account_overridden_limit_path(account), params: {
+        overridden_limit: { card_count: 42, bytes_used: 99 }
+      }
+      assert_redirected_to admin_account_path(account)
+      assert_equal 42, account.reload.overridden_limit.card_count
+      assert_equal 99, account.overridden_limit.bytes_used
+
+      delete admin_account_overridden_limit_path(account)
+      assert_redirected_to admin_account_path(account)
+      assert_nil account.reload.overridden_limit
+    end
+  end
+end
diff --git a/saas/test/controllers/billing/card_limits_test.rb b/saas/test/controllers/billing/card_limits_test.rb
new file mode 100644
index 0000000..10b5fc8
--- /dev/null
+++ b/saas/test/controllers/billing/card_limits_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Billing::CardLimitsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @script = { script_name: @account.slug }
+  end
+
+  test "publishing is refused when the free account is out of cards" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.update_column(:cards_count, 100)
+
+    post card_publish_path(cards(:unfinished_thoughts), **@script)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "creating through the API is refused when the free account is out of cards" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.update_column(:cards_count, 100)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), **@script),
+        params: { card: { title: "Blocked" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a free account that runs out of cards can still draft" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.update_column(:cards_count, 100)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), **@script)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "create buttons give way to an upgrade pitch" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.update_column(:cards_count, 100)
+
+    get card_draft_path(cards(:unfinished_thoughts), **@script)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "a warning counts down from 100 cards out" do
+    @account.override_limits(card_count: 950, bytes_used: nil)
+
+    get card_draft_path(cards(:unfinished_thoughts), **@script)
+
+    assert_response :success
+    assert_match "50 cards left", response.body
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "staff can still publish when the account is out of cards" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    @account.update_column(:cards_count, 100)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), **@script)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "a paid plan is not refused at the free card limit" do
+    @account.sync_billing_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    @account.override_limits(card_count: 5_000, bytes_used: nil)
+
+    post card_publish_path(cards(:unfinished_thoughts), **@script)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
