diff --git a/saas/test/controllers/billing/webhooks_controller_test.rb b/saas/test/controllers/billing/webhooks_controller_test.rb
new file mode 100644
index 0000000..7d22985
--- /dev/null
+++ b/saas/test/controllers/billing/webhooks_controller_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Billing::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret = ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+  end
+
+  test "subscription changes update the account" do
+    account = accounts(:initech)
+    payload = {
+      id: "evt_sub",
+      object: "event",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: "active",
+          cancel_at: nil,
+          metadata: { account_id: account.id },
+          items: {
+            data: [
+              { price: { id: "price_unlimited" }, current_period_end: 1_800_000_000 }
+            ]
+          }
+        }
+      }
+    }
+
+    post_stripe_webhook(payload)
+
+    assert_response :ok
+    subscription = account.reload.subscription
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal Time.zone.at(1_800_000_000), subscription.current_period_end
+    assert_equal Billing::Plan.unlimited, account.billing_plan
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "checkout completion records the customer and plan" do
+    account = accounts(:initech)
+    payload = {
+      id: "evt_checkout",
+      object: "event",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_123",
+          object: "checkout.session",
+          customer: "cus_checkout",
+          subscription: "sub_checkout",
+          payment_status: "paid",
+          client_reference_id: account.id,
+          metadata: { account_id: account.id, plan_key: "unlimited_plus" }
+        }
+      }
+    }
+
+    post_stripe_webhook(payload)
+
+    assert_response :ok
+    subscription = account.reload.subscription
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "upcoming invoices store the next amount due" do
+    account = accounts(:initech)
+    account.sync_billing_subscription!(
+      stripe_customer_id: "cus_invoice",
+      stripe_subscription_id: "sub_invoice",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_invoice",
+      object: "event",
+      type: "invoice.upcoming",
+      data: {
+        object: {
+          id: "in_123",
+          object: "invoice",
+          status: "draft",
+          amount_due: 2000,
+          parent: { subscription_details: { subscription: "sub_invoice" } }
+        }
+      }
+    }
+
+    post_stripe_webhook(payload)
+
+    assert_response :ok
+    assert_equal 2000, account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "a bad signature is refused" do
+    untenanted do
+      post stripe_webhooks_path, params: "{}", headers: {
+        "CONTENT_TYPE" => "application/json",
+        "Stripe-Signature" => "t=1,v1=bad"
+      }
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_stripe_webhook(payload)
+      body = payload.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, body, @secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      untenanted do
+        post stripe_webhooks_path, params: body, headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => header
+        }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..7044b62
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts get 1,000 cards and 1 GB" do
+    assert_equal Billing::Plan.free, @account.billing_plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "warning counts down from 100 cards out" do
+    @account.override_limits(card_count: 950, bytes_used: nil)
+
+    assert @account.nearing_card_limit?
+    assert_equal "50 cards left", @account.card_limit_warning_text
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "warning starts at 100 cards left and stops beyond that" do
+    @account.override_limits(card_count: 900, bytes_used: nil)
+    assert @account.nearing_card_limit?
+    assert_equal "100 cards left", @account.card_limit_warning_text
+
+    @account.override_limits(card_count: 899, bytes_used: nil)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "running out of cards is exceeding the limit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "the account card counter counts toward the free limit" do
+    @account.update_column(:cards_count, 950)
+
+    assert_equal "50 cards left", @account.card_limit_warning_text
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+  end
+
+  test "a paid plan brings its own storage allowance and unlimited cards" do
+    @account.sync_billing_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert_equal Billing::Plan.unlimited, @account.billing_plan
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.sync_billing_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      plan_key: "unlimited_plus",
+      status: "active"
+    )
+
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "canceled subscriptions fall back to free" do
+    @account.sync_billing_subscription!(
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      plan_key: "unlimited",
+      status: "canceled"
+    )
+
+    assert_equal Billing::Plan.free, @account.billing_plan
+    assert_nil @account.active_subscription
+  end
+
+  test "comp grants unlimited cards and uncomp drops it" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+    assert @account.exceeding_card_limit?
+
+    @account.comp
+    assert @account.billing_waiver
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.uncomp
+    assert_nil @account.billing_waiver
+    assert @account.exceeding_card_limit?
+  end
+
+  test "override replaces counted usage and reset drops it" do
+    @account.override_limits(card_count: 10, bytes_used: 2.gigabytes)
+    assert_equal 10, @account.cards_used
+    assert_equal 2.gigabytes, @account.bytes_counted_toward_storage_limit
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limit
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "storage exceptions still override the plan allowance" do
+    @account.sync_billing_subscription!(
+      stripe_customer_id: "cus_exception",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    @account.add_storage_exception(12.gigabytes)
+
+    assert_equal 12.gigabytes, @account.storage_limit
+  end
+end
