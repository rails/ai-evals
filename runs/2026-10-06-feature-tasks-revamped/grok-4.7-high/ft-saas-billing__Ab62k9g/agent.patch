+require "test_helper"
+
+class Billing::PlanTest < ActiveSupport::TestCase
+  test "approved pricing" do
+    free = Billing::Plan.free
+    unlimited = Billing::Plan.unlimited
+    plus = Billing::Plan.unlimited_plus
+
+    assert_equal "Free", free.name
+    assert_equal 0, free.price
+    assert_equal 1_000, free.card_limit
+    assert_equal 1.gigabyte, free.storage_bytes
+
+    assert_equal "Unlimited", unlimited.name
+    assert_equal 20, unlimited.price
+    assert_equal "$20/month", unlimited.monthly_price
+    assert_nil unlimited.card_limit
+    assert_equal 5.gigabytes, unlimited.storage_bytes
+
+    assert_equal "Unlimited+", plus.name
+    assert_equal 25, plus.price
+    assert_equal "$25/month", plus.monthly_price
+    assert_nil plus.card_limit
+    assert_equal 500.gigabytes, plus.storage_bytes
+  end
+
+  test "price ids come from the deploy environment" do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+
+    assert_equal "price_unlimited", Billing::Plan.unlimited.stripe_price_id
+    assert_equal "price_plus", Billing::Plan.unlimited_plus.stripe_price_id
+    assert_equal Billing::Plan.unlimited_plus, Billing::Plan.find_by_price_ids([ "price_plus" ])
+  ensure
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+end
