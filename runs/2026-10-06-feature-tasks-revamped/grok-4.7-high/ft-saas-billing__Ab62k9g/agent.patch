diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..4ee39c7
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,170 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_paid_subscription
+  end
+
+  def billing_plan
+    if subscription&.entitled?
+      Billing::Plan.find(subscription.plan_key) || Billing::Plan.unlimited
+    elsif billing_waiver
+      Billing::Plan.unlimited
+    else
+      Billing::Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.entitled?
+  end
+
+  def comp
+    create_billing_waiver! unless billing_waiver
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_limit
+    return if billing_waiver
+
+    billing_plan.card_limit
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      [ cards.published.count, cards_count ].max
+    end
+  end
+
+  def cards_remaining
+    return if card_limit.nil?
+
+    [ card_limit - cards_used, 0 ].max
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def card_limit_warning_text
+    label = cards_remaining == 1 ? "card" : "cards"
+    "#{cards_remaining} #{label} left"
+  end
+
+  def overridden_bytes_used
+    overridden_limit&.bytes_used
+  end
+
+  def override_limits(card_count:, bytes_used:)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    reload_overridden_limit
+  end
+
+  def sync_billing_subscription!(attributes)
+    record = subscription ||
+      Account::Subscription.find_by(stripe_subscription_id: attributes[:stripe_subscription_id]) ||
+      Account::Subscription.find_by(stripe_customer_id: attributes[:stripe_customer_id]) ||
+      build_subscription
+
+    record.account = self
+    record.stripe_customer_id = attributes[:stripe_customer_id] if attributes[:stripe_customer_id].present?
+    record.stripe_subscription_id = attributes[:stripe_subscription_id] if attributes[:stripe_subscription_id].present?
+    record.plan_key = attributes[:plan_key] if attributes[:plan_key].present?
+    record.status = attributes[:status] if attributes[:status].present?
+    record.current_period_end = attributes[:current_period_end] if attributes.key?(:current_period_end)
+    record.cancel_at = attributes[:cancel_at] if attributes.key?(:cancel_at)
+    record.next_amount_due_in_cents = attributes[:next_amount_due_in_cents] if attributes.key?(:next_amount_due_in_cents)
+    record.save!
+    reload_subscription
+    record
+  end
+
+  def begin_upgrade(plan, success_url:, cancel_url:)
+    if active_subscription&.stripe_subscription_id.present?
+      change_stripe_plan(plan)
+      success_url
+    else
+      Stripe::Checkout::Session.create(
+        checkout_session_params(plan, success_url: checkout_success_url(success_url), cancel_url: cancel_url)
+      ).url
+    end
+  end
+
+  def billing_portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: return_url
+    ).url
+  end
+
+  private
+    def cancel_paid_subscription
+      if subscription&.stripe_subscription_id.present?
+        Billing::CancelSubscriptionJob.perform_later(self)
+      end
+
+      subscription&.update!(status: "canceled")
+    end
+
+    def change_stripe_plan(plan)
+      stripe_subscription = Stripe::Subscription.retrieve(subscription.stripe_subscription_id)
+      item_id = stripe_subscription.items.data.first.id
+
+      Stripe::Subscription.update(
+        subscription.stripe_subscription_id,
+        items: [ { id: item_id, price: plan.stripe_price_id } ],
+        metadata: { account_id: id.to_s, plan_key: plan.key },
+        proration_behavior: "create_prorations"
+      )
+
+      subscription.update!(plan_key: plan.key)
+    end
+
+    def checkout_session_params(plan, success_url:, cancel_url:)
+      params = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: id.to_s,
+        metadata: { account_id: id.to_s, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: id.to_s, plan_key: plan.key } },
+        allow_promotion_codes: true
+      }
+
+      if subscription&.stripe_customer_id.present?
+        params[:customer] = subscription.stripe_customer_id
+      else
+        params[:customer_email] = owner_email if owner_email.present?
+        params[:customer_creation] = "always"
+      end
+
+      params
+    end
+
+    def checkout_success_url(url)
+      separator = url.include?("?") ? "&" : "?"
+      "#{url}#{separator}session_id={CHECKOUT_SESSION_ID}"
+    end
+end
