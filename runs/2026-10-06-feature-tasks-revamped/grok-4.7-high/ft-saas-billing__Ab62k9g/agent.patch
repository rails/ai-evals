@@ -0,0 +1,41 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  layout "public"
+
+  before_action :set_account
+
+  def create
+    save_override
+  end
+
+  def update
+    save_override
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to admin_account_path(@account)
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def save_override
+      @account.override_limits(**overridden_limit_attributes)
+      redirect_to admin_account_path(@account)
+    end
+
+    def overridden_limit_attributes
+      source = if params[:overridden_limit]
+        params.expect(overridden_limit: [ :card_count, :bytes_used ])
+      else
+        params.permit(:card_count, :bytes_used)
+      end
+
+      {
+        card_count: source[:card_count].presence,
+        bytes_used: source[:bytes_used].presence
+      }
+    end
+end
