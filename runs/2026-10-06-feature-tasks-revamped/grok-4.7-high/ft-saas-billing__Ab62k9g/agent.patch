+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,82 @@
+module Billing
+  # Hosted Fizzy plans. Stripe price ids come from the deploy environment:
+  # Unlimited uses STRIPE_MONTHLY_V1_PRICE_ID, Unlimited+ uses
+  # STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID.
+  class Plan
+    attr_reader :key, :name, :price_cents, :card_limit, :storage_bytes, :stripe_price_env
+
+    def initialize(key:, name:, price_cents:, card_limit:, storage_bytes:, stripe_price_env: nil)
+      @key = key
+      @name = name
+      @price_cents = price_cents
+      @card_limit = card_limit
+      @storage_bytes = storage_bytes
+      @stripe_price_env = stripe_price_env
+    end
+
+    def self.all
+      [ free, unlimited, unlimited_plus ]
+    end
+
+    def self.free
+      @free ||= new(
+        key: "free",
+        name: "Free",
+        price_cents: 0,
+        card_limit: 1_000,
+        storage_bytes: 1.gigabyte
+      )
+    end
+
+    def self.unlimited
+      @unlimited ||= new(
+        key: "unlimited",
+        name: "Unlimited",
+        price_cents: 2_000,
+        card_limit: nil,
+        storage_bytes: 5.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+      )
+    end
+
+    def self.unlimited_plus
+      @unlimited_plus ||= new(
+        key: "unlimited_plus",
+        name: "Unlimited+",
+        price_cents: 2_500,
+        card_limit: nil,
+        storage_bytes: 500.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+      )
+    end
+
+    def self.find(key)
+      all.find { |plan| plan.key == key.to_s }
+    end
+
+    def self.find_by_price_ids(price_ids)
+      ids = Array(price_ids).compact
+      all.select { |plan| plan.stripe_price_id.present? && ids.include?(plan.stripe_price_id) }.max_by(&:storage_bytes)
+    end
+
+    def stripe_price_id
+      ENV[stripe_price_env] if stripe_price_env
+    end
+
+    def price
+      price_cents / 100
+    end
+
+    def monthly_price
+      "$#{price}/month"
+    end
+
+    def paid?
+      price_cents.positive?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+  end
+end
diff --git a/saas/app/models/billing/webhook.rb b/saas/app/models/billing/webhook.rb
new file mode 100644
index 0000000..21f5ce4
--- /dev/null
+++ b/saas/app/models/billing/webhook.rb
@@ -0,0 +1,148 @@
+module Billing
+  class Webhook
+    def self.process(event)
+      new(event).process
+    end
+
+    def initialize(event)
+      @event = event
+    end
+
+    def process
+      case type
+      when "checkout.session.completed"
+        checkout_completed
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        subscription_changed
+      when "invoice.upcoming", "invoice.created", "invoice.finalized", "invoice.updated"
+        invoice_changed
+      end
+    end
+
+    private
+      def type
+        @event["type"]
+      end
+
+      def object
+        @event["data"]["object"]
+      end
+
+      def checkout_completed
+        session = object
+        account = account_for_checkout(session)
+        return unless account
+
+        account.sync_billing_subscription!(
+          stripe_customer_id: id_of(session["customer"]),
+          stripe_subscription_id: id_of(session["subscription"]),
+          plan_key: metadata_value(session, "plan_key"),
+          status: session["payment_status"] == "paid" ? "active" : "incomplete"
+        )
+      end
+
+      def subscription_changed
+        stripe_subscription = object
+        account = account_for_subscription(stripe_subscription)
+        return unless account
+
+        account.sync_billing_subscription!(
+          stripe_customer_id: id_of(stripe_subscription["customer"]),
+          stripe_subscription_id: stripe_subscription["id"],
+          plan_key: plan_key_for(stripe_subscription),
+          status: stripe_subscription["status"],
+          current_period_end: period_end_from(stripe_subscription),
+          cancel_at: time_from(stripe_subscription["cancel_at"])
+        )
+      end
+
+      def invoice_changed
+        invoice = object
+        return if %w[ paid void uncollectible ].include?(invoice["status"])
+
+        subscription_id = subscription_id_from_invoice(invoice)
+        return if subscription_id.blank?
+
+        record = Account::Subscription.find_by(stripe_subscription_id: subscription_id)
+        record&.update!(next_amount_due_in_cents: invoice["amount_due"])
+      end
+
+      def account_for_checkout(session)
+        account_id = metadata_value(session, "account_id").presence || session["client_reference_id"]
+        Account.find_by(id: account_id) if account_id.present?
+      end
+
+      def account_for_subscription(stripe_subscription)
+        account_id = metadata_value(stripe_subscription, "account_id")
+        account = Account.find_by(id: account_id) if account_id.present?
+        if account
+          account
+        else
+          Account::Subscription.find_by(stripe_subscription_id: stripe_subscription["id"])&.account ||
+            Account::Subscription.find_by(stripe_customer_id: id_of(stripe_subscription["customer"]))&.account
+        end
+      end
+
+      def plan_key_for(stripe_subscription)
+        Billing::Plan.find_by_price_ids(price_ids_from(stripe_subscription))&.key ||
+          metadata_value(stripe_subscription, "plan_key")
+      end
+
+      def price_ids_from(stripe_subscription)
+        Array(items_data(stripe_subscription)).filter_map do |item|
+          id_of(item["price"] || item["plan"])
+        end
+      end
+
+      def period_end_from(stripe_subscription)
+        timestamps = Array(items_data(stripe_subscription)).filter_map { |item| item["current_period_end"] }
+        time_from(timestamps.max || stripe_subscription["current_period_end"])
+      end
+
+      def items_data(stripe_subscription)
+        items = stripe_subscription["items"]
+        return [] if items.blank?
+
+        if items.respond_to?(:data)
+          items.data
+        else
+          items["data"]
+        end
+      end
+
+      def subscription_id_from_invoice(invoice)
+        direct = id_of(invoice["subscription"])
+        return direct if direct.present?
+
+        parent = invoice["parent"]
+        return if parent.blank?
+
+        details = parent["subscription_details"]
+        return if details.blank?
+
+        id_of(details["subscription"])
+      end
+
+      def metadata_value(object, key)
+        metadata = object["metadata"]
+        return if metadata.blank?
+
+        metadata[key] || metadata[key.to_sym]
+      end
+
+      def id_of(value)
+        case value
+        when String
+          value
+        when nil
+          nil
+        else
+          value["id"]
+        end
+      end
+
+      def time_from(timestamp)
+        timestamp.present? ? Time.zone.at(timestamp.to_i) : nil
+      end
+  end
+end
