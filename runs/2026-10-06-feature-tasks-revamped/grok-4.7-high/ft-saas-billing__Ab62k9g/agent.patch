+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= link_to "Accounts", admin_accounts_path %> / <%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider"><%= @account.name %></h2>
+        <div>
+          #<%= @account.external_account_id %>
+          · <%= @account.billing_plan.name %>
+          <% if @account.billing_waiver %>
+            · Comped
+          <% end %>
+        </div>
+        <div>
+          Cards used: <%= number_with_delimiter(@account.cards_used) %>
+          · Bytes used: <%= number_with_delimiter(@account.bytes_counted_toward_storage_limit) %>
+        </div>
+      </header>
+
+      <div class="flex gap">
+        <%= button_to "Comp", admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override</h2>
+        <div>Replace the card count and bytes used that count toward this account’s limits.</div>
+      </header>
+
+      <%= form_with url: admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post, class: "flex flex-column gap" do |form| %>
+        <div>
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+        </div>
+
+        <div>
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+        </div>
+
+        <%= form.button "Override", class: "btn btn--link" %>
+      <% end %>
+
+      <%= button_to "Reset", admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+    </section>
+  </div>
+</section>
