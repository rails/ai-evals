diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..0ede785 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,39 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(activity_assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular_string("old_board"), new_board: particular_string("new_board") }
+    when "card_title_changed"
+      { old_title: particular_string("old_title"), new_title: particular_string("new_title") }
+    when "card_triaged"
+      { column: particular_string("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_assignee_ids
+      assignee_ids.nil? ? nested_particulars[:assignee_ids] : assignee_ids
+    end
+
+    def particular_string(key)
+      value = nested_particulars[key]
+      value = top_level_particulars[key] if value.nil?
+      value.to_s
+    end
+
+    def top_level_particulars
+      particulars.is_a?(Hash) ? particulars.with_indifferent_access : {}.with_indifferent_access
+    end
+
+    def nested_particulars
+      nested = top_level_particulars[:particulars]
+      nested.is_a?(Hash) ? nested.with_indifferent_access : {}.with_indifferent_access
+    end
 end
diff --git a/app/models/user/timelined.rb b/app/models/user/timelined.rb
