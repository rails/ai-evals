diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..b68654b
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,80 @@
+# Activity
+
+Account activity is the stream of card and comment events shown on the HTML timeline. The API returns that activity as a flat list so clients do not have to scrape the timeline.
+
+Deprecated `card_collection_changed` events are omitted. `card_title_changed` events are included.
+
+## `GET /:account_slug/activities`
+
+Returns activity the current user can access, newest first. Results are paginated using the same `Link` header convention as other list endpoints.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only activity caused by these users |
+| `board_ids[]` | Only activity on these boards. Boards you cannot access are ignored |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_published",
+    "created_at": "2025-12-05T19:38:48.540Z",
+    "description": "David added &quot;First!&quot;",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the cards, boards, and users endpoints. The examples above are abbreviated.
+
+`description` is the event's plain-text sentence. It always uses the creator's name, even when you caused the activity.
+
+`url` opens the card. For comments, it opens the card where the comment was posted and jumps to that comment.
+
+`eventable_type` is `Card` or `Comment`.
+
+### Particulars
+
+`particulars` contains event-specific details. Other events return `{}`. Missing board, title, or column values are empty strings.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Included actions:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..c05985f
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,263 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns accessible activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    ids = @response.parsed_body.pluck("id")
+    assert_equal activity_ids_for(users(:kevin)), ids
+    assert_includes ids, events(:layout_assignment_jz).id
+    assert_includes ids, events(:layout_commented).id
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index includes the activity representation" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_published", activity["action"]
+    assert_equal events(:logo_published).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal events(:logo_published).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal card_url(cards(:logo)), activity.dig("eventable", "url")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "comment events link to the card and jump to the comment" do
+    get activities_path(format: :json)
+
+    comment = comments(:layout_overflowing_david)
+    activity = @response.parsed_body.find { |record| record["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_includes activity["url"], "##{dom_id(comment)}"
+    assert_equal events(:layout_commented).description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "assignment changes expose assignee ids" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+    assert_equal %w[ assignee_ids ], activity["particulars"].keys
+  end
+
+  test "description is specific to the current user" do
+    get activities_path(format: :json)
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_km).id }
+    assert_includes activity["description"], "will handle"
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_km).id }
+    assert_includes activity["description"], "assigned"
+    assert_includes activity["description"], "Kevin"
+    assert_not_includes activity["description"], "will handle"
+  end
+
+  test "omits deprecated collection changes and includes title changes" do
+    collection_event = events(:logo_published)
+    collection_event.update_columns(action: "card_collection_changed", particulars: { "particulars" => { "new_collection" => "Old" } })
+
+    title_event = events(:text_published)
+    title_event.update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Tiny text" } }
+    )
+
+    get activities_path(format: :json)
+    ids = @response.parsed_body.pluck("id")
+
+    assert_not_includes ids, collection_event.id
+    assert_includes ids, title_event.id
+
+    activity = @response.parsed_body.find { |record| record["id"] == title_event.id }
+    assert_equal "Tiny text", activity.dig("particulars", "old_title")
+    assert_equal "", activity.dig("particulars", "new_title")
+  end
+
+  test "exposes board, title, and column particulars with empty strings for missing values" do
+    Current.session = sessions(:kevin)
+    card = cards(:text)
+
+    card.update!(title: "Make the text larger")
+    card.triage_into(columns(:writebook_on_hold))
+    card.update!(board: boards(:private))
+
+    get activities_path(format: :json)
+
+    title_change = @response.parsed_body.find { |record| record["action"] == "card_title_changed" }
+    board_change = @response.parsed_body.find { |record| record["action"] == "card_board_changed" }
+    triage = @response.parsed_body.find { |record| record["action"] == "card_triaged" && record.dig("particulars", "column") == "On Hold" }
+
+    assert_equal({ "old_title" => "The text is too small", "new_title" => "Make the text larger" }, title_change["particulars"])
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, board_change["particulars"])
+    assert_equal({ "column" => "On Hold" }, triage["particulars"])
+
+    events(:shipping_closed).update_columns(action: "card_board_changed", particulars: {})
+    events(:shipping_published).update_columns(action: "card_triaged", particulars: {})
+
+    get activities_path(format: :json)
+    missing_board = @response.parsed_body.find { |record| record["id"] == events(:shipping_closed).id }
+    missing_column = @response.parsed_body.find { |record| record["id"] == events(:shipping_published).id }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, missing_board["particulars"])
+    assert_equal({ "column" => "" }, missing_column["particulars"])
+  end
+
+  test "other events return an empty particulars object" do
+    get activities_path(format: :json)
+
+    %w[ card_published card_closed card_sent_back_to_triage comment_created ].each do |action|
+      activity = @response.parsed_body.find { |record| record["action"] == action }
+      assert activity, "expected a #{action} event"
+      assert_equal({}, activity["particulars"])
+    end
+  end
+
+  test "filters by creator ids and board ids" do
+    private_event = boards(:private).events.create!(
+      action: "card_published",
+      creator: users(:kevin),
+      eventable: cards(:text),
+      created_at: Time.current
+    )
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:text_published).id
+    assert_includes ids, private_event.id
+    assert_not_includes ids, events(:logo_published).id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    ids = @response.parsed_body.pluck("id")
+    assert_equal [ private_event.id ], ids
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:logo_published).id
+    assert_not_includes ids, events(:text_published).id
+    assert_not_includes ids, private_event.id
+  end
+
+  test "does not return activity from boards the user cannot access" do
+    private_event = boards(:private).events.create!(
+      action: "card_closed",
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      created_at: Time.current
+    )
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+
+    logout_and_sign_in_as :jason
+    get activities_path(format: :json)
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates with the existing link header convention" do
+    now = Time.current
+    20.times do |index|
+      boards(:writebook).events.create!(
+        action: "card_reopened",
+        creator: users(:david),
+        eventable: cards(:logo),
+        created_at: now + index.seconds
+      )
+    end
+
+    expected_ids = activity_ids_for(users(:kevin))
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "authenticates json clients with a bearer token" do
+    sign_out
+
+    get activities_path(format: :json), headers: {
+      "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}"
+    }
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "html requests are not acceptable" do
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "reads particulars stored at the top level or nested" do
+    events(:shipping_closed).update_columns(
+      action: "card_board_changed",
+      particulars: { old_board: "Alpha", new_board: "Beta" }
+    )
+    events(:shipping_published).update_columns(
+      action: "card_unassigned",
+      particulars: { "particulars" => { "assignee_ids" => [ users(:jz).id ] } }
+    )
+
+    get activities_path(format: :json)
+
+    board_change = @response.parsed_body.find { |record| record["id"] == events(:shipping_closed).id }
+    unassignment = @response.parsed_body.find { |record| record["id"] == events(:shipping_published).id }
+
+    assert_equal({ "old_board" => "Alpha", "new_board" => "Beta" }, board_change["particulars"])
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, unassignment["particulars"])
+  end
+
+  private
+    def activity_ids_for(user)
+      Event.where(account_id: user.account_id, board_id: user.board_ids)
+        .for_activity
+        .reverse_chronologically
+        .pluck(:id)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
