@@ -8,4 +8,22 @@ module User::Timelined
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
+
+  def activities(creator_ids: nil, board_ids: nil)
+    events = Event.preloaded
+      .where(account_id: account_id, board_id: boards_for_activities(board_ids).select(:id))
+      .for_activity
+      .reverse_chronologically
+    events = events.where(creator_id: creator_ids) if creator_ids.present?
+    events
+  end
+
+  private
+    def boards_for_activities(board_ids)
+      if board_ids.present?
+        boards.where(id: board_ids)
+      else
+        boards
+      end
+    end
 end
