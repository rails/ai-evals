diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..cb88844
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+  end
+
+  test "bytes used starts at zero" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card images count toward the board and account after the background job" do
+    card = create_card(@board)
+
+    assert_no_difference -> { @board.bytes_used } do
+      attach_image(card, 1_000)
+    end
+
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 1_000, @board.bytes_used
+    assert_equal 1_000, @account.bytes_used
+  end
+
+  test "files embedded in card descriptions, comments, and board descriptions are counted" do
+    card = create_card(@board)
+    attach_description(card, 200)
+    comment = card.comments.create!(body: "Look", creator: users(:david))
+    attach_body(comment, 300)
+    attach_public_description(@board, 400)
+
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 900, @board.bytes_used
+    assert_equal 900, @account.bytes_used
+  end
+
+  test "account usage is the sum of its boards" do
+    attach_image(create_card(@board), 100)
+    attach_image(create_card(@other_board), 250)
+
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 100, @board.bytes_used
+    assert_equal 250, @other_board.bytes_used
+    assert_equal 350, @account.bytes_used
+  end
+
+  test "avatars and exports are not counted" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    export = Export.create!(account: @account, user: users(:david))
+    export.file.attach(io: StringIO.new("b" * 80), filename: "export.zip", content_type: "application/zip")
+
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "removing an image, embed, or comment decreases usage" do
+    card = create_card(@board)
+    attach_image(card, 500)
+    attach_description(card, 200)
+    comment = card.comments.create!(body: "Look", creator: users(:david))
+    attach_body(comment, 300)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+    assert_equal 1_000, @board.bytes_used
+
+    card.image.purge_later
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+    assert_equal 500, @board.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+    assert_equal 200, @board.bytes_used
+
+    card.update!(description: "no files")
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "replacing a card image applies the size delta" do
+    card = create_card(@board)
+    attach_image(card, 100)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    card.image.attach(io: StringIO.new("y" * 450), filename: "next.bin", content_type: "application/octet-stream")
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 450, @board.bytes_used
+  end
+
+  test "moving a card transfers its storage to the destination board" do
+    card = create_card(@board)
+    attach_image(card, 120)
+    attach_description(card, 30)
+    comment = card.comments.create!(body: "Look", creator: users(:david))
+    attach_body(comment, 50)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+    assert_equal 200, @board.bytes_used
+
+    card.move_to(@other_board)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 200, @other_board.bytes_used
+    assert_equal 200, @account.bytes_used
+  end
+
+  test "destroying a card removes its images, description files, and comment files" do
+    card = create_card(@board)
+    attach_image(card, 10)
+    attach_description(card, 20)
+    comment = card.comments.create!(body: "Look", creator: users(:david))
+    attach_body(comment, 30)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    card.destroy!
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "generated image variants are not counted" do
+    card = create_card(@board)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    card.update!(description: "<p>#{attachment_html(blob)}</p>")
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    assert blob.variant_records.any?, "expected embed variants to be generated"
+    assert_equal file_fixture("moon.jpg").size, @board.bytes_used
+  end
+
+  test "concurrent adjustments are not lost" do
+    card = create_card(@board)
+    attach_image(card, 1)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    deltas = Array.new(25) { 10 }
+    deltas.each { |delta| Board.adjust_bytes_used_now(@board.id, delta) }
+
+    assert_equal 1 + deltas.sum, @board.bytes_used
+    assert_equal 1 + deltas.sum, @account.bytes_used
+  end
+
+  test "recalculate matches incremental tracking for several embeds" do
+    card = create_card(@board)
+    html = +""
+    5.times do |index|
+      html << attachment_html(blob_of(100 + index, "desc-#{index}.bin"))
+    end
+    card.update!(description: html)
+    attach_image(card, 40)
+    perform_enqueued_jobs only: Board::AdjustBytesUsedJob
+
+    expected = 40 + (0...5).sum { |index| 100 + index }
+    assert_equal expected, @board.bytes_used
+
+    @board.update_columns(bytes_used: 0)
+    @board.recalculate_bytes_used_now
+
+    assert_equal expected, @board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "bytes_used reads the latest stored value without relying on the in-memory attribute" do
+    Board.where(id: @board.id).update_all(bytes_used: 42)
+
+    assert_equal 0, @board.read_attribute(:bytes_used)
+    assert_equal 42, @board.bytes_used
+  end
+
+  private
+    def create_card(board)
+      board.cards.create!(title: "Storage", creator: users(:david), status: "published")
+    end
+
+    def attach_image(card, bytes)
+      card.image.attach(io: StringIO.new("x" * bytes), filename: "image.bin", content_type: "application/octet-stream")
+    end
+
+    def attach_description(card, bytes)
+      card.update!(description: "<p>#{attachment_html(blob_of(bytes, "desc.bin"))}</p>")
+    end
+
+    def attach_body(comment, bytes)
+      comment.update!(body: "<p>#{attachment_html(blob_of(bytes, "comment.bin"))}</p>")
+    end
+
+    def attach_public_description(board, bytes)
+      board.update!(public_description: "<p>#{attachment_html(blob_of(bytes, "board.bin"))}</p>")
+    end
+
+    def blob_of(bytes, filename)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("z" * bytes), filename: filename, content_type: "application/octet-stream")
+    end
+
+    def attachment_html(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
