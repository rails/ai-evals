diff --git a/app/views/cards/comments/_reaction_composer.html.erb b/app/views/cards/comments/_reaction_composer.html.erb
new file mode 100644
index 0000000..514735c
--- /dev/null
+++ b/app/views/cards/comments/_reaction_composer.html.erb
@@ -0,0 +1,50 @@
+<div id="<%= dom_id(comment, :reaction_composer) %>" class="display-contents" data-controller="reaction-composer" data-turbo-permanent>
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction"
+      data-reaction-composer-target="trigger" data-action="reaction-composer#open">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ],
+        class: "reaction__form",
+        html: { hidden: true },
+        data: { turbo_frame: "_top",
+                reaction_composer_target: "form",
+                controller: "form",
+                action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label", for: dom_id(comment, :reaction_content) do %>
+      <span class="for-screen-reader">Reaction</span>
+      <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "reaction__input input", maxlength: 16, autocomplete: "off",
+            required: true, data: { reaction_composer_target: "input", form_target: "input" } %>
+    <% end %>
+
+    <div class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="btn reaction__menu-btn" data-action="dialog#toggle:stop" aria-label="Choose an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" title="<%= label %>" aria-label="<%= label %>"
+                data-emoji="<%= emoji %>" data-action="reaction-composer#pickEmoji dialog#close">
+              <%= emoji %>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "btn reaction__submit-btn", type: :submit, aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <button type="button" class="btn reaction__cancel-btn" data-reaction-composer-target="cancel" data-form-target="cancel" data-action="reaction-composer#cancel" aria-label="Cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
