+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "comment shows a reactions strip with the boost icon" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select ".reactions__list"
+      assert_select ".reactions__trigger img[src*='boost-color']"
+      assert_select "form.reaction__form[hidden] input.reaction__input[maxlength='16']"
+      assert_select ".reaction__submit-btn"
+      assert_select ".reaction__cancel-btn"
+    end
+  end
+
