diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..d6aca83
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,74 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically.preload(reacter: [ :avatar_attachment, :account ])
+
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params)
+
+    if @reaction.save
+      broadcast_reaction_created
+
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    @reaction.destroy!
+    broadcast_reaction_removed
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def broadcast_reaction_created
+      Turbo::StreamsChannel.broadcast_append_to @card,
+        target: helpers.dom_id(@comment, :reactions_list),
+        partial: "cards/comments/reaction",
+        locals: { reaction: @reaction }
+    end
+
+    def broadcast_reaction_removed
+      Turbo::StreamsChannel.broadcast_remove_to @card, target: helpers.dom_id(@reaction)
+    end
+end
diff --git a/app/javascript/controllers/reaction_composer_controller.js b/app/javascript/controllers/reaction_composer_controller.js
new file mode 100644
index 0000000..fbc4673
--- /dev/null
+++ b/app/javascript/controllers/reaction_composer_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  connect() {
+    this.#sync()
+  }
+
+  open() {
+    this.formTarget.classList.add("reaction", "expanded")
+    this.#sync()
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    if (this.hasFormTarget) {
+      this.formTarget.reset()
+      this.formTarget.classList.remove("reaction", "expanded")
+    }
+
+    this.#sync()
+
+    if (this.hasTriggerTarget) this.triggerTarget.focus()
+  }
+
+  pickEmoji(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+    const max = input.maxLength > 0 ? input.maxLength : 16
+
+    if (emoji && (input.value + emoji).length <= max) {
+      input.value += emoji
+      input.dispatchEvent(new Event("input", { bubbles: true }))
+    }
+
+    input.focus()
+  }
+
+  #sync() {
+    const editing = this.hasFormTarget && this.formTarget.classList.contains("expanded")
+
+    if (this.hasFormTarget) this.formTarget.hidden = !editing
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = editing
+  }
+}
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..c8f9ed3
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,53 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Own reactions can be expanded to reveal a remove button. The strip is
+// cached and broadcast to everyone, so ownership is decided in the browser.
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#duplicate()) {
+      this.element.remove()
+      return
+    }
+
+    this.own = this.reacterIdValue === window.Current?.user?.id
+
+    if (this.own) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.tabIndex = 0
+    }
+  }
+
+  toggle(event) {
+    if (!this.own) return
+    if (event.target.closest("a, button, form")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  keydown(event) {
+    if (!this.own) return
+    if (event.target.closest("a, button, form, input")) return
+
+    if (event.key === "Enter" || event.key === " ") {
+      event.preventDefault()
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+
+  markDeleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  #duplicate() {
+    if (!this.element.id) return false
+
+    const matches = document.querySelectorAll(`[id="${CSS.escape(this.element.id)}"]`)
+    return matches.length > 1 && matches[0] !== this.element
+  }
+}
