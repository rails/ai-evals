+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "creates a reaction on a comment" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.create!(content: "Nice 👍", reacter: users(:david))
+
+    assert_equal "Nice 👍", reaction.content
+    assert_equal users(:david), reaction.reacter
+    assert_equal comment.account, reaction.account
+    assert_includes comment.reactions, reaction
+  end
+
+  test "strips content and rejects blanks" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+
+    blank = comment.reactions.build(content: "   ")
+    assert_not blank.valid?
+    assert_includes blank.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert comment.reactions.build(content: "a" * 16).valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "emoji only reactions are distinguished from text" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert comment.reactions.build(content: "👍").emoji_only?
+    assert comment.reactions.build(content: "🎉🎉").emoji_only?
+    assert_not comment.reactions.build(content: "Great 👍").emoji_only?
+    assert_not comment.reactions.build(content: "ok").emoji_only?
+  end
+
+  test "touching the comment keeps the card fresh for live viewers" do
+    comment = comments(:logo_agreement_kevin)
+    card_was = comment.card.updated_at
+
+    travel 1.minute do
+      comment.reactions.create!(content: "👍")
+    end
+
+    assert comment.reload.updated_at > card_was
+    assert comment.card.reload.updated_at > card_was
+  end
+end
