+    margin-block-start: var(--block-space);
+    margin-inline: auto;
+    text-align: start;
+  }
+
+  .search__form {
+    align-items: center;
+    display: flex;
+    gap: 0.6rem;
+  }
+
+  .search__form .input {
+    flex: 1;
+  }
+
+  .search__form .btn {
+    flex-shrink: 0;
+  }
+
+  .search__hint,
+  .search__count {
+    margin-block-start: var(--block-space);
+  }
