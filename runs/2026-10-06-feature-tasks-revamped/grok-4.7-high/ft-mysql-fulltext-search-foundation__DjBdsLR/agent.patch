+  .search-result__title {
+    font-size: var(--text-medium);
+    font-weight: 700;
+    margin: 0;
+  }
+
+  .search-result__number {
+    color: var(--color-ink-dark);
+    font-weight: 600;
+    margin-inline-end: 0.4ch;
+  }
+
+  .search-result__meta {
+    margin: 0.2rem 0 0;
+  }
+
+  .search-result__snippet {
+    margin: 0.55rem 0 0;
+  }
