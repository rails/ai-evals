diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..028590e
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,23 @@
+module SearchesHelper
+  def highlight_matches(text, search)
+    plain = text.to_s
+    return "" if plain.blank? || search.terms.empty?
+
+    highlight(plain, search.highlight_terms)
+  end
+
+  def search_snippet(text, search)
+    plain = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    plain = plain.to_s.squish
+    return if plain.blank? || !search.matches_text?(plain)
+
+    phrase = search.terms.find { |term| plain.downcase.include?(term.downcase) }
+    visible = if plain.length > 320
+      excerpt(plain, phrase, radius: 100) || plain.truncate(320)
+    else
+      plain
+    end
+
+    highlight_matches(visible, search)
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..9bfee74
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,103 @@
+class Search
+  ESCAPE = "!"
+
+  attr_reader :query, :user
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def cards
+    if terms.any? && user.present?
+      matching_cards
+    else
+      Card.none
+    end
+  end
+
+  def terms
+    @terms ||= query.split(/\s+/).reject(&:blank?)
+  end
+
+  def highlight_terms
+    terms.sort_by { |term| -term.length }
+  end
+
+  def matches_text?(text)
+    haystack = text.to_s.downcase
+    terms.any? { |term| haystack.include?(term.downcase) }
+  end
+
+  def matching_comments(card)
+    card.comments.sort_by { |comment| [ comment.created_at, comment.id.to_s ] }.select do |comment|
+      matches_text?(comment.body.to_plain_text)
+    end
+  end
+
+  private
+    def matching_cards
+      relation = accessible_published_cards
+      terms.each { |term| relation = relation.where(term_match_sql, *term_match_binds(term)) }
+
+      relation
+        .reverse_chronologically
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+        .to_a
+        .select { |card| contains_every_term?(card) }
+    end
+
+    def accessible_published_cards
+      user.accessible_cards.published.where(account_id: user.account_id)
+    end
+
+    def contains_every_term?(card)
+      haystack = searchable_text(card).downcase
+      terms.all? { |term| haystack.include?(term.downcase) }
+    end
+
+    def searchable_text(card)
+      [
+        card.title,
+        card.description.to_plain_text,
+        *card.comments.map { |comment| comment.body.to_plain_text }
+      ].compact.join("\n")
+    end
+
+    def term_match_sql
+      @term_match_sql ||= <<~SQL.squish
+        (
+          #{like_sql("cards.title")}
+          OR EXISTS (
+            SELECT 1 FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_id = cards.id
+              AND action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.name = 'description'
+              AND #{like_sql("action_text_rich_texts.body")}
+          )
+          OR EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts comment_bodies
+              ON comment_bodies.record_id = comments.id
+              AND comment_bodies.record_type = 'Comment'
+              AND comment_bodies.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND #{like_sql("comment_bodies.body")}
+          )
+        )
+      SQL
+    end
+
+    def term_match_binds(term)
+      pattern = like_pattern(term)
+      [ pattern, pattern, pattern ]
+    end
+
+    def like_sql(column)
+      "LOWER(COALESCE(#{column}, '')) LIKE ? ESCAPE '#{ESCAPE}'"
+    end
+
+    def like_pattern(term)
+      "%#{Card.sanitize_sql_like(term.downcase, ESCAPE)}%"
+    end
+end
