--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,22 @@
+<li class="search-result" id="<%= dom_id(card, :search_result) %>">
+  <%= link_to card_path(card), class: "search-result__link" do %>
+    <h2 class="search-result__title">
+      <span class="search-result__number">#<%= card.number %></span>
+      <%= highlight_matches(card.title.presence || "Untitled", search) %>
+    </h2>
+  <% end %>
+
+  <p class="search-result__meta txt-small txt-subtle">
+    <%= card.board.name %>
+  </p>
+
+  <% if snippet = search_snippet(card.description, search) %>
+    <p class="search-result__snippet search-result__description"><%= snippet %></p>
+  <% end %>
+
+  <% search.matching_comments(card).each do |comment| %>
+    <blockquote class="search-result__snippet search-result__comment">
+      <%= search_snippet(comment.body, search) %>
+    </blockquote>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..fb2650b
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search panel center">
+  <%= form_with url: search_path, method: :get, class: "search__form" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @search.query,
+          placeholder: "Search titles, descriptions, and comments…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          class: "input",
+          enterkeyhint: "search" %>
+    <button type="submit" class="btn btn--link">
+      <%= icon_tag "search" %>
+      <span>Search</span>
+    </button>
+  <% end %>
+
+  <% if @search.query.present? %>
+    <% if @cards.any? %>
+      <p class="search__count txt-small txt-subtle"><%= pluralize(@cards.size, "card") %></p>
+      <ol class="search__results">
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { search: @search } %>
+      </ol>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @search.query %>”</p>
+    <% end %>
+  <% else %>
+    <p class="search__hint txt-subtle">Find cards by what’s in the title, description, or comments.</p>
+  <% end %>
+</section>
