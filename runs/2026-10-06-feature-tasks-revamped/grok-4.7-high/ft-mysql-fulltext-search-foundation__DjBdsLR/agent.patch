diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..3d7392d
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+    @board = boards(:writebook)
+  end
+
+  test "search page finds cards by title, description, or comment and highlights matches" do
+    title_card = @board.cards.create!(title: "Bring the xylophone", status: :published, creator: users(:david), created_at: 2.days.ago)
+    description_card = @board.cards.create!(title: "Unrelated title", status: :published, description: "Hidden xylophone in the description", creator: users(:david), created_at: 1.day.ago)
+    comment_card = @board.cards.create!(title: "Another plain title", status: :published, creator: users(:david), created_at: 1.hour.ago)
+    comment_card.comments.create!(body: "Please pack the xylophone", creator: users(:kevin))
+    @board.cards.create!(title: "No musical instruments here", status: :published, creator: users(:david))
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "mark", text: "xylophone", minimum: 3
+    assert_select "a[href=?]", card_path(title_card)
+    assert_select "a[href=?]", card_path(description_card)
+    assert_select "a[href=?]", card_path(comment_card)
+    assert_no_match "No musical instruments here", response.body
+
+    hrefs = css_select("a.search-result__link").map { |link| link["href"] }
+    assert_operator hrefs.index(card_path(comment_card)), :<, hrefs.index(card_path(description_card))
+    assert_operator hrefs.index(card_path(description_card)), :<, hrefs.index(card_path(title_card))
+  end
+
+  test "search is case insensitive and escapes like wildcards" do
+    match = @board.cards.create!(title: "100% done", status: :published, creator: users(:david))
+    @board.cards.create!(title: "1000 done", status: :published, creator: users(:david))
+
+    get search_path(q: "100%")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(match)
+    assert_select "mark", text: "100%"
+    assert_no_match "1000 done", response.body
+  end
+
+  test "people only see cards on boards they currently have access to" do
+    private_card = boards(:private).cards.create!(title: "private xylophone", status: :published, creator: users(:kevin))
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(private_card), count: 0
+    assert_no_match "private xylophone", response.body
+  end
+
+  test "revoked board access removes cards from search" do
+    card = @board.cards.create!(title: "shared xylophone", status: :published, creator: users(:david))
+
+    get search_path(q: "xylophone")
+    assert_select "a[href=?]", card_path(card)
+
+    @board.update!(all_access: false)
+    @board.accesses.revoke_from(users(:david))
+
+    get search_path(q: "xylophone")
+    assert_select "a[href=?]", card_path(card), count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = @board.cards.create!(title: "Draft xylophone", status: :drafted, creator: users(:david))
+    comment = Comment.new(card: draft, creator: users(:david), account: draft.account, body: "xylophone hiding in a draft comment")
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    published = @board.cards.create!(title: "Visible xylophone", status: :published, creator: users(:david))
+    published.comments.create!(body: "xylophone in a real comment", creator: users(:david))
+    published.update!(status: :drafted)
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_no_match "Draft xylophone", response.body
+    assert_no_match "hiding in a draft comment", response.body
+    assert_no_match "Visible xylophone", response.body
+    assert_no_match "real comment", response.body
+    assert_select "a.search-result__link", count: 0
+  end
+
+  test "empty search does not list cards" do
+    @board.cards.create!(title: "Visible xylophone", status: :published, creator: users(:david))
+
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select "a.search-result__link", count: 0
+    assert_no_match "Visible xylophone", response.body
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "xylophone")
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
+
+class SearchesControllerAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "cards on an accessible board are returned" do
+    private_card = boards(:private).cards.create!(title: "private xylophone", status: :published, creator: users(:kevin))
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(private_card)
+    assert_select "mark", text: "xylophone"
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..0a5ccb8
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @user = users(:david)
+  end
+
+  test "matches every word across title, description, and comments" do
+    card = @board.cards.create!(title: "Bring the brass", status: :published, creator: @user, description: "A small xylophone")
+    card.comments.create!(body: "for the recital", creator: @user)
+    @board.cards.create!(title: "Bring the brass", status: :published, creator: @user)
+
+    results = Search.new("brass xylophone", user: @user).cards
+
+    assert_equal [ card ], results
+  end
+
+  test "does not match html tag names in rich text" do
+    @board.cards.create!(title: "Plain title", status: :published, creator: @user, description: "Hello there")
+
+    assert_empty Search.new("div", user: @user).cards
+  end
+
+  test "orders by newest created_at first" do
+    older = @board.cards.create!(title: "older quasar", status: :published, creator: @user, created_at: 3.days.ago)
+    newer = @board.cards.create!(title: "newer quasar", status: :published, creator: @user, created_at: 1.hour.ago)
+
+    assert_equal [ newer, older ], Search.new("quasar", user: @user).cards
+  end
+
+  test "ignores cards the user cannot access and drafts" do
+    boards(:private).cards.create!(title: "secret quasar", status: :published, creator: users(:kevin))
+    @board.cards.create!(title: "draft quasar", status: :drafted, creator: @user)
+
+    assert_empty Search.new("quasar", user: @user).cards
+  end
+end
