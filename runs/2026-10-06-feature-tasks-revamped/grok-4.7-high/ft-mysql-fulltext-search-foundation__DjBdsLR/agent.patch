+  .search__results {
+    display: flex;
+    flex-direction: column;
+    gap: 0.8rem;
+    list-style: none;
+    margin: var(--block-space) 0 0;
+    padding: 0;
+  }
+
+  .search-result {
+    border: 1px solid var(--color-ink-lighter);
+    border-radius: 0.7em;
+    padding: 0.9rem 1rem;
+  }
+
+  .search-result__link {
+    color: inherit;
+    display: block;
+    text-decoration: none;
+  }
