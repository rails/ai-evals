+    [ /\A(.+) renamed (.+) \(was: "(.+)"\)\z/, ->(m) { "#{m[1]}が#{m[2]}の名前を変更しました（以前: 「#{m[3]}」）" } ],
+    [ /\A(.+) moved (.+) to "(.+)"\z/, ->(m) { "#{m[1]}が#{m[2]}を「#{m[3]}」に移動しました" } ],
+    [ /\A(.+) moved (.+) back to "Maybe\?"\z/, ->(m) { "#{m[1]}が#{m[2]}を「検討中？」に戻しました" } ],
