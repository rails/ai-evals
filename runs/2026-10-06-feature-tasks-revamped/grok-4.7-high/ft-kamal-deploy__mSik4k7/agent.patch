diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2504d44
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,104 @@
+<%
+  # One-box deploy: a Linux server with Docker, SQLite, everything in one
+  # container, SSL from kamal-proxy. Fill these in, fill in .kamal/secrets,
+  # then run `kamal setup`. Fizzy will be at https://<hostname>.
+  #
+  # hostname    — public DNS name (not a URL). Points at the server.
+  # mail_server — SMTP server for magic-link sign-in mail.
+  # ssh_host    — where Kamal SSHes. Defaults to hostname; use an IP if SSH
+  #               is not on the public name.
+  # arch        — amd64 for most servers; arm64 for Graviton / Ampere.
+  hostname    = "fizzy.example.com"
+  mail_server = "smtp.example.com"
+  mail_port   = "587"
+  ssh_host    = hostname
+  arch        = "amd64"
+%>
+# Name of the application. Used to name containers and the storage volume.
+service: fizzy
+
+# Local registry image name. Kamal starts a registry on localhost:5555, so a
+# fork does not need a Docker Hub account. Switch `registry.server` if you
+# would rather push to ghcr.io or Docker Hub.
+image: fizzy
+
+# One server. Do not add a jobs role: Solid Queue runs inside this container
+# (config/puma.rb), so background jobs stay on the box.
+servers:
+  web:
+    - "<%= ssh_host %>"
+
+# SSL is terminated by kamal-proxy (Let's Encrypt). Do not set TLS_DOMAIN —
+# that would make Thruster request its own certificate.
+# Ports 80 and 443 on the server must be open, and DNS for the hostname must
+# point at this box. Health checks hit /up over the proxy's private network.
+proxy:
+  ssl: true
+  host: "<%= hostname %>"
+  healthcheck:
+    path: /up
+
+# Local registry. Kamal forwards it to the server over SSH while deploying.
+registry:
+  server: localhost:5555
+
+# Clear env is visible in `kamal config`. Secrets are read from .kamal/secrets.
+env:
+  clear:
+    # Stay on SQLite in this container, even if the deploy machine has SAAS set.
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+
+    # Jobs run in the web process. A separate jobs container is not used.
+    SOLID_QUEUE_IN_PUMA: "true"
+
+    # Public hostname for links in mail and background jobs. Matches proxy.host.
+    APP_HOST: "<%= hostname %>"
+    APP_PROTOCOL: https
+
+    # Mail server. Magic-link sign-in does not work without this.
+    # Port 587 with STARTTLS is the usual submission setup. For a port-25 relay,
+    # set mail_port above to "25". For implicit TLS (port 465), also set
+    # SMTP_TLS: "true" here.
+    SMTP_ADDRESS: "<%= mail_server %>"
+    SMTP_PORT: "<%= mail_port %>"
+    SMTP_DOMAIN: "<%= hostname %>"
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@<%= hostname %>>"
+
+    # Uncomment on a small box if you want fewer Puma workers / job processes
+    # than one per CPU. SQLite is in WAL mode and lives on the volume below.
+    # WEB_CONCURRENCY: "1"
+    # JOB_CONCURRENCY: "1"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# SQLite databases (primary, cache, queue, cable) and local Active Storage
+# files live under /rails/storage. This named volume is not part of the image,
+# so data survives the next deploy. Replace with a local-disk host path such as
+# /var/lib/fizzy:/rails/storage if you want backups you can see on the host.
+# Do not put SQLite on NFS.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep fingerprinted assets available across the restart so in-flight browsers
+# do not 404.
+asset_path: /rails/public/assets
+
+# First boot runs db:prepare before /up answers. Give a slow box time.
+deploy_timeout: 60
+
+builder:
+  arch: "<%= arch %>"
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# ssh:
+#   user: root
