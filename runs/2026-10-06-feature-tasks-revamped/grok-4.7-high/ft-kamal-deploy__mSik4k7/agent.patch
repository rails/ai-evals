new file mode 100644
index 0000000..c9e8ad4
--- /dev/null
+++ b/.kamal/secrets
@@ -0,0 +1,23 @@
+# Secrets for the one-box Kamal deploy. This file is committed; do not put raw
+# secrets in it. Fill them in before `kamal setup`, either by exporting them or
+# by writing SECRET_KEY_BASE to the gitignored file .kamal/secret_key_base.
+#
+#   bin/rails secret
+#   export SECRET_KEY_BASE=...
+#
+# Mail server username and password, if your server requires authentication.
+# Leave them unset for an open relay (SMTP_ADDRESS is set in config/deploy.yml).
+#
+#   export SMTP_USERNAME=...
+#   export SMTP_PASSWORD=...
+#
+# Optional browser push. See docs/development.md for how to generate a pair.
+#
+#   export VAPID_PUBLIC_KEY=...
+#   export VAPID_PRIVATE_KEY=...
+
+SECRET_KEY_BASE=$(if [ -n "$SECRET_KEY_BASE" ]; then printf '%s' "$SECRET_KEY_BASE"; elif [ -f .kamal/secret_key_base ]; then tr -d '\n' < .kamal/secret_key_base; fi)
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
