diff --git a/test/integration/one_box_deploy_config_test.rb b/test/integration/one_box_deploy_config_test.rb
new file mode 100644
index 0000000..4f50417
--- /dev/null
+++ b/test/integration/one_box_deploy_config_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+require "kamal"
+
+class OneBoxDeployConfigTest < ActiveSupport::TestCase
+  test "kamal config is one box, sqlite, one container, ssl from the proxy, persistent storage" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_equal 1, config.app_hosts.size
+    assert_nil config.role(:web).cmd, "jobs must run in the web container, not a second role"
+    assert config.proxy.ssl?, "SSL must come from kamal-proxy"
+    assert_equal [ config.env.clear.fetch("APP_HOST") ], config.proxy.hosts
+    assert_equal 80, config.proxy.app_port
+    assert_equal "/up", config.proxy.proxy_config.dig("healthcheck", "path")
+    assert_equal "sqlite", config.env.clear.fetch("DATABASE_ADAPTER")
+    assert_equal "false", config.env.clear.fetch("SAAS")
+    assert_equal "true", config.env.clear.fetch("SOLID_QUEUE_IN_PUMA")
+    assert_equal config.env.clear.fetch("APP_HOST"), config.env.clear.fetch("SMTP_DOMAIN")
+    assert config.env.clear.fetch("SMTP_ADDRESS").present?
+    assert_equal [ "fizzy_storage:/rails/storage" ], config.raw_config.volumes
+    assert_equal "/rails/public/assets", config.raw_config.asset_path
+    assert_empty config.accessories
+    assert config.registry.local?
+    assert_includes config.env.secret_keys, "SECRET_KEY_BASE"
+    assert_includes config.env.secret_keys, "SMTP_PASSWORD"
+    assert_not config.env.clear.key?("TLS_DOMAIN")
+  end
+
+  test "sqlite databases and uploads live on the persistent volume path" do
+    text = Rails.root.join("config/database.sqlite.yml").read
+    production = text.split(/^production:\n/, 2).last
+    databases = production.scan(/database: (.+)/).flatten
+
+    assert_equal 4, databases.size
+    databases.each do |path|
+      assert path.start_with?("storage/"), "#{path} would not survive a deploy"
+    end
+
+    storage = Rails.root.join("config/storage.oss.yml").read
+    assert_match %r{root: <%= Rails\.root\.join\("storage", Rails\.env, "files"\) %>}, storage
+  end
+
+  test "secrets file defines every secret the deploy config references" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+    secrets = Rails.root.join(".kamal/secrets").read
+
+    config.env.secret_keys.each do |key|
+      assert_match(/^#{Regexp.escape(key)}=/, secrets, "missing #{key} in .kamal/secrets")
+    end
+  end
+end
