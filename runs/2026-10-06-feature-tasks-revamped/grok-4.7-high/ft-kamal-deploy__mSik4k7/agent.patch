new file mode 100755
index 0000000..00cc71d
--- /dev/null
+++ b/.kamal/hooks/pre-build
@@ -0,0 +1,27 @@
+#!/bin/sh
+# Fail fast, before the image build, if a fork has not filled in the one-box
+# deploy. `kamal setup` runs this hook.
+set -eu
+
+if grep -Eq 'hostname[[:space:]]*=[[:space:]]*"fizzy\.example\.com"' config/deploy.yml; then
+  echo "Fill in your hostname at the top of config/deploy.yml, then run kamal setup." >&2
+  exit 1
+fi
+
+if grep -Eq 'mail_server[[:space:]]*=[[:space:]]*"smtp\.example\.com"' config/deploy.yml; then
+  echo "Fill in your mail server at the top of config/deploy.yml, then run kamal setup." >&2
+  exit 1
+fi
+
+secret="${SECRET_KEY_BASE:-}"
+if [ -z "$secret" ] && [ -f .kamal/secret_key_base ]; then
+  secret=$(tr -d '\n' < .kamal/secret_key_base)
+fi
+
+if [ -z "$secret" ]; then
+  echo "Fill in SECRET_KEY_BASE before kamal setup. Generate one with: bin/rails secret" >&2
+  echo "Export it, or write it to .kamal/secret_key_base. See .kamal/secrets." >&2
+  exit 1
+fi
+
+exit 0
