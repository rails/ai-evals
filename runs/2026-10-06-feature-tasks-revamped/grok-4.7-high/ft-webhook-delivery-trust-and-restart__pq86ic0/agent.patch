   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +58,61 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      claimed = self.class.where(id: id, state: "pending").update_all(state: "in_progress", updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT
+      ) do |http|
+        request = Net::HTTP::Post.new(uri.request_uri)
+        headers.each { |key, value| request[key] = value }
+        request.body = body
+        http.request(request)
+      end
+    end
+
+    def record_http_response(headers, http_response)
+      update!(
+        state: :completed,
+        request: { headers: headers },
+        response: { code: http_response.code.to_i }
+      )
+      webhook.track_delivery(self)
+    rescue => error
+      raise unless completed?
+      Rails.logger.error("Webhook delivery #{id} completed but could not track outcome: #{error.class}: #{error.message}")
+    end
+
+    def record_error(error, headers = nil)
+      update!(
+        state: :errored,
+        request: headers.present? ? { headers: headers } : request,
+        response: { error: error_name(error) }
+      )
+      webhook.track_delivery(self)
+    rescue => recording_error
+      Rails.logger.error("Webhook delivery #{id} could not record failure: #{recording_error.class}: #{recording_error.message}")
+    end
+
+    def error_name(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when SocketError, SystemCallError, OpenSSL::SSL::SSLError, EOFError, IOError
+        "destination_unreachable"
+      else
+        "delivery_failed"
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..bb964a9
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,103 @@
+class Webhook::Payload
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def body
+    @body ||= render_body
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+  end
+
+  def signature
+    OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+  end
+
+  private
+    attr_reader :webhook, :event
+
+    def render_body
+      case
+      when webhook.for_slack?
+        { text: plain_message }.to_json
+      when webhook.for_campfire?
+        { body: plain_message }.to_json
+      when webhook.for_basecamp?
+        { content: html_message }.to_json
+      else
+        json_message
+      end
+    end
+
+    def plain_message
+      text = CGI.unescapeHTML(event.description_for(nil).to_plain_text.to_s)
+      "#{text} #{event_url}".squish
+    end
+
+    def html_message
+      render_template(:html)
+    end
+
+    def json_message
+      render_template(:json)
+    end
+
+    def render_template(format)
+      renderer.render(
+        template: "webhooks/event",
+        formats: [ format ],
+        assigns: { event: event }
+      )
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(
+        http_host: http_host,
+        https: protocol == "https",
+        script_name: event.account.slug
+      )
+    end
+
+    def event_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def url_options
+      @url_options ||= base_url_options.merge(script_name: event.account.slug)
+    end
+
+    def base_url_options
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "example.com" }
+      options.symbolize_keys
+    end
+
+    def http_host
+      host = base_url_options[:host] || "example.com"
+      port = base_url_options[:port]
+      if port.present? && !host.to_s.include?(":")
+        "#{host}:#{port}"
+      else
+        host
+      end
+    end
+
+    def protocol
+      base_url_options[:protocol].presence || "http"
+    end
+
+    def timestamp
+      @timestamp ||= Time.current.utc.iso8601(3)
+    end
+end
