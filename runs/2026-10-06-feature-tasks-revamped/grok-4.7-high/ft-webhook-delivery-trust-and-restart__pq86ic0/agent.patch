+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim
+
+    headers = nil
+    payload = Webhook::Payload.new(webhook, event)
+    headers = payload.headers
+    http_response = post(payload.body, headers)
+    record_http_response(headers, http_response)
+  rescue => error
+    record_error(error, headers) unless completed?
