@@ -0,0 +1,284 @@
+require "test_helper"
+
+class Webhook::DeliveryDispatchTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @webhook = Webhook.create!(
+      name: "Dispatch",
+      url: "https://hooks.example.com/fizzy",
+      board: @board,
+      subscribed_actions: %w[ card_closed card_published comment_created ]
+    )
+    @card = cards(:logo)
+    Current.user = users(:david)
+  end
+
+  test "creating a webhook starts a delinquency tracker" do
+    assert @webhook.delinquency_tracker.present?
+    assert_equal @webhook.account, @webhook.delinquency_tracker.account
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "posts the event once and logs the outcome" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 204, body: "ok")
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        close_card
+      end
+    end
+
+    assert_requested stub, times: 1
+
+    delivery = @webhook.deliveries.order(:created_at).last
+    assert delivery.succeeded?
+    assert_equal 204, delivery.response_summary[:code]
+    assert_nil delivery.response_summary[:error]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request.dig("headers", "User-Agent")
+    assert_equal "application/json", delivery.request.dig("headers", "Content-Type")
+    assert delivery.request.dig("headers", "X-Webhook-Timestamp").present?
+    assert delivery.request.dig("headers", "X-Webhook-Signature").present?
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    body = nil
+    assert_requested :post, @webhook.url do |request|
+      body = request.body
+      expected = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body)
+      assert_equal expected, request.headers["X-Webhook-Signature"]
+      assert_equal "application/json", request.headers["Content-Type"]
+    end
+
+    payload = JSON.parse(body)
+    assert_equal "card_closed", payload["action"]
+    assert_equal @card.id, payload.dig("eventable", "id")
+  end
+
+  test "delivers exactly once even if the job is enqueued again" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      event = close_card
+    end
+
+    delivery = @webhook.deliveries.find_by!(event: event)
+    delivery.deliver_later
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested stub, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+  end
+
+  test "does not post to inactive webhooks or unsubscribed actions" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+    stub_request(:post, webhooks(:active).url).to_return(status: 200)
+    @webhook.deactivate
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        close_card
+      end
+    end
+
+    @webhook.activate
+    @webhook.update!(subscribed_actions: %w[ card_published ])
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        close_card
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "does not post to webhooks on another board" do
+    other = Webhook.create!(
+      name: "Other board",
+      url: "https://other.example.com/hook",
+      board: boards(:private),
+      subscribed_actions: %w[ card_closed ]
+    )
+    stub = stub_request(:post, other.url).to_return(status: 200)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      close_card
+    end
+
+    assert_not_requested stub
+    assert_empty other.deliveries
+  end
+
+  test "a receiver that fails ten times in a row within an hour is switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    travel_to Time.current do
+      10.times do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          close_card
+        end
+      end
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "failures older than an hour do not count toward the cutoff" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    travel_to 2.hours.ago do
+      9.times do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          close_card
+        end
+      end
+    end
+
+    assert @webhook.reload.active?
+
+    travel_to Time.current do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        close_card
+      end
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a success resets the failure streak" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    4.times do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        close_card
+      end
+    end
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      close_card
+    end
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a switched off webhook clears the failure streak" do
+    @webhook.delinquency_tracker.update!(consecutive_failures_count: 10, first_failure_at: Time.current)
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "unreachable receivers are logged and count as failures" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      close_card
+    end
+
+    delivery = @webhook.deliveries.last
+    assert delivery.errored?
+    assert delivery.failed?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "cleanup drops delivery logs older than a week and keeps the rest" do
+    event = events(:layout_commented)
+    stale = @webhook.deliveries.create!(event: event, state: :completed, response: { code: 200 })
+    stale.update_column(:created_at, 8.days.ago)
+    fresh = @webhook.deliveries.create!(event: events(:logo_published), state: :completed, response: { code: 200 })
+    fresh.update_column(:created_at, 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(stale.id)
+    assert Webhook::Delivery.exists?(fresh.id)
+  end
+
