diff --git a/script/verify_account_id_rollout.rb b/script/verify_account_id_rollout.rb
new file mode 100755
index 0000000..70b5735
--- /dev/null
+++ b/script/verify_account_id_rollout.rb
@@ -0,0 +1,51 @@
+#!/usr/bin/env ruby
+# Verifies the multi-tenant account_id rollout:
+# every table that holds an account's data has a required, indexed account_id.
+# Global identity/auth tables are intentionally excluded.
+
+require_relative "../config/environment"
+
+GLOBAL_TABLES = %w[
+  accounts
+  account_external_id_sequences
+  action_pack_passkeys
+  identities
+  identity_access_tokens
+  magic_links
+  sessions
+  ar_internal_metadata
+  schema_migrations
+].freeze
+
+def account_data_tables
+  ActiveRecord::Base.connection.tables.reject do |table|
+    GLOBAL_TABLES.include?(table) || table.end_with?("_fts") || table.start_with?("sqlite_")
+  end.sort
+end
+
+failures = []
+
+account_data_tables.each do |table|
+  column = ActiveRecord::Base.connection.columns(table).find { |c| c.name == "account_id" }
+  if column.nil?
+    failures << "#{table}: missing account_id"
+    next
+  end
+
+  if column.null
+    failures << "#{table}: account_id is nullable"
+  end
+
+  indexed = ActiveRecord::Base.connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+  unless indexed
+    failures << "#{table}: account_id is not indexed"
+  end
+end
+
+if failures.any?
+  warn "account_id rollout incomplete (#{failures.size}):"
+  failures.each { |failure| warn "  - #{failure}" }
+  exit 1
+end
+
+puts "account_id rollout ok (#{account_data_tables.size} tables)"
