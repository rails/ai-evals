diff --git a/config/initializers/account_owned_records.rb b/config/initializers/account_owned_records.rb
new file mode 100644
index 0000000..8d38f8c
--- /dev/null
+++ b/config/initializers/account_owned_records.rb
@@ -0,0 +1,73 @@
+# Account data lives on every row, including Active Storage, Action Text, and
+# HABTM join tables. Those records are not ApplicationRecord subclasses, so the
+# account association is installed here.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) || Current.account }
+end
+
+# HABTM join models are anonymous and only know the two foreign keys. Copy the
+# owner's account onto the join row so the required column is populated.
+module AccountIdOnThroughRecords
+  private
+    def build_through_record(record)
+      through = super
+      install_account_callback(through.class)
+      assign_through_account(through)
+      through
+    end
+
+    def save_through_record(record)
+      through = build_through_record(record)
+      assign_through_account(through)
+      super
+    end
+
+    def assign_through_account(through)
+      if through.has_attribute?(:account_id) && through.account_id.nil?
+        through.account_id = account_id_for(through)
+      end
+    end
+
+    def install_account_callback(klass)
+      return if klass.instance_variable_defined?(:@account_id_callback_installed)
+
+      klass.instance_variable_set(:@account_id_callback_installed, true)
+      klass.before_validation do
+        if has_attribute?(:account_id) && account_id.nil?
+          self.account_id = AccountIdOnThroughRecords.account_id_for(self)
+        end
+      end
+    end
+
+    def account_id_for(through)
+      AccountIdOnThroughRecords.account_id_for(through) || owner.try(:account_id)
+    end
+
+    def self.account_id_for(through)
+      through.class.reflect_on_all_associations(:belongs_to).each do |reflection|
+        related = through.public_send(reflection.name)
+        account_id = related.try(:account_id)
+        return account_id if account_id.present?
+      rescue ActiveRecord::RecordNotFound
+        next
+      end
+      nil
+    end
+end
+
+ActiveSupport.on_load(:active_record) do
+  ActiveRecord::Associations::HasManyThroughAssociation.prepend(AccountIdOnThroughRecords)
+end
