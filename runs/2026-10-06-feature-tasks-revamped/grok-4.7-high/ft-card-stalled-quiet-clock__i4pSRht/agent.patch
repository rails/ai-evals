index 0000000..769391f
--- /dev/null
+++ b/test/controllers/cards/stalled_index_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Cards::StalledIndexTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:text)
+    @card.assignments.delete_all
+    @card.events.where(action: %w[card_assigned card_reopened]).delete_all
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    @card.update_columns(last_active_at: 3.weeks.ago)
+  end
+
+  test "index lists stalled cards and shows the flag" do
+    get cards_path(indexed_by: "stalled")
+    assert_response :success
+    assert_select ".card--stalled"
+    assert_select ".card__stalled-flag", text: "Stalled"
+    assert_select ".bubble--stalled", text: /Stalled for/
+  end
+
+  test "index as JSON filters by stalled and reports the flag" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+
+    numbers = @response.parsed_body.pluck("number")
+    assert_includes numbers, @card.number
+    assert_not_includes numbers, cards(:buy_domain).number
+
+    payload = @response.parsed_body.find { |card| card["number"] == @card.number }
+    assert_equal true, payload["stalled"]
+  end
+
+  test "show page explains that the card is stalled" do
+    get card_path(@card)
+    assert_response :success
+    assert_select ".card__stalled-flag", text: "Stalled"
+    assert_match(/Stalled for \d+ days/, response.body)
+  end
+
+  test "show as JSON includes stalled" do
+    get card_path(@card), as: :json
