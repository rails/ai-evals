diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..6acde18
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,103 @@
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  # A card stalls when it had a burst of attention and then sees no activity
+  # for this long. Any activity updates last_active_at and resets the stall.
+  STALL_PERIOD = 2.weeks
+  BURST_COMMENT_MINIMUM = 3
+  BURST_PEOPLE_MINIMUM = 2
+  BURST_WINDOW_DIVISOR = 3
+
+  included do
+    scope :stalled, -> { where(last_active_at: ..STALL_PERIOD.ago).with_burst }
+    scope :with_burst, -> { where(id: burst_card_ids) }
+  end
+
+  class_methods do
+    def burst_card_ids
+      assignment_ids = Assignment.select(:card_id)
+      event_ids = Event.where(eventable_type: "Card", action: %w[ card_assigned card_reopened ]).select(:eventable_id)
+
+      Card.where(id: assignment_ids).or(Card.where(id: event_ids)).or(Card.where(id: comment_burst_card_ids)).select(:id)
+    end
+
+    # Cards with at least three comments from two people inside any window of
+    # one third of the board's auto-close period (board entropy, else account).
+    def comment_burst_card_ids
+      period = "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) / #{BURST_WINDOW_DIVISOR}.0"
+      window_end = connection.date_add("comments.created_at", period)
+
+      Comment
+        .joins(:creator)
+        .where.not(users: { role: "system" })
+        .joins(card: :board)
+        .joins("LEFT OUTER JOIN entropies ON entropies.container_id = boards.id AND entropies.container_type = 'Board'")
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.container_id = boards.account_id AND account_entropies.container_type = 'Account'")
+        .joins(<<~SQL.squish)
+          INNER JOIN comments AS window_comments
+            ON window_comments.card_id = comments.card_id
+           AND window_comments.created_at >= comments.created_at
+           AND window_comments.created_at <= #{window_end}
+          INNER JOIN users AS window_users
+            ON window_users.id = window_comments.creator_id
+           AND window_users.role != 'system'
+        SQL
+        .group("comments.id", "comments.card_id")
+        .having("COUNT(DISTINCT window_comments.id) >= #{BURST_COMMENT_MINIMUM} AND COUNT(DISTINCT window_users.id) >= #{BURST_PEOPLE_MINIMUM}")
+        .select("comments.card_id")
+    end
+  end
+
+  def stalled?
+    had_burst? && inactive_long_enough_to_stall?
+  end
+
+  def had_burst?
+    return @had_burst if defined?(@had_burst)
+
+    @had_burst = assignment_burst? || reopen_burst? || comment_burst?
+  end
+
+  def reload(*)
+    remove_instance_variable(:@had_burst) if defined?(@had_burst)
+    super
+  end
+
+  def stalled_for_days
+    return 0 unless last_active_at
+
+    ((Time.current - last_active_at) / 1.day).floor
+  end
+
+  private
+    def inactive_long_enough_to_stall?
+      last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+
+    def assignment_burst?
+      assignments.exists? || events.exists?(action: "card_assigned")
+    end
+
+    def reopen_burst?
+      events.exists?(action: "card_reopened")
+    end
+
+    def comment_burst?
+      window = burst_window
+      return false unless window
+
+      rows = comments.by_user.pluck(:created_at, :creator_id)
+      return false if rows.size < BURST_COMMENT_MINIMUM
+
+      rows.any? do |time, _creator_id|
+        in_window = rows.select { |created_at, _| created_at >= time && created_at <= time + window }
+        in_window.size >= BURST_COMMENT_MINIMUM && in_window.map(&:last).uniq.size >= BURST_PEOPLE_MINIMUM
+      end
+    end
+
+    def burst_window
+      return unless auto_postpone_period
+
+      auto_postpone_period / BURST_WINDOW_DIVISOR.to_f
+    end
+end
