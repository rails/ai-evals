+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @card.assignments.delete_all
+    @card.events.where(action: %w[card_assigned card_reopened]).delete_all
+    @card.comments.delete_all
+    boards(:writebook).update!(auto_postpone_period: 30.days)
+  end
+
+  test "assignment is a burst and two weeks without activity stalls the card" do
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      assert @card.had_burst?
+      assert_not @card.stalled?
+
+      travel 2.weeks - 1.second
+      assert_not @card.reload.stalled?
+
+      travel 1.second
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "reopening is a burst" do
+    travel_to Time.current do
+      @card.close
+      @card.reopen
+      assert @card.had_burst?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    travel_to Time.current do
+      comment(@card, users(:david), at: 9.days.ago)
+      comment(@card, users(:kevin), at: 5.days.ago)
+      comment(@card, users(:david), at: 1.day.ago)
+
+      assert @card.reload.had_burst?
+      assert_not @card.stalled?
+
+      @card.update_columns(last_active_at: 2.weeks.ago)
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "comments outside a third of the auto-close period are not a burst" do
+    # 30 day auto-close => 10 day window
+    travel_to Time.current do
+      comment(@card, users(:david), at: 12.days.ago)
+      comment(@card, users(:kevin), at: 6.days.ago)
+      comment(@card, users(:david), at: Time.current)
+
+      assert_not @card.reload.had_burst?
+      @card.update_columns(last_active_at: 3.weeks.ago)
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "three comments from one person are not a burst" do
+    travel_to Time.current do
+      3.times { |i| comment(@card, users(:david), at: i.hours.ago) }
+      assert_not @card.reload.had_burst?
+    end
+  end
+
+  test "two comments from two people are not a burst" do
+    travel_to Time.current do
+      comment(@card, users(:david))
+      comment(@card, users(:kevin))
+      assert_not @card.reload.had_burst?
+    end
+  end
+
+  test "system comments do not count toward a burst" do
+    travel_to Time.current do
+      comment(@card, users(:david))
+      comment(@card, users(:kevin))
+      comment(@card, users(:system))
+      assert_not @card.reload.had_burst?
+    end
+  end
+
+  test "comment window uses the board auto-close period, falling back to the account" do
+    travel_to Time.current do
+      boards(:writebook).update!(auto_postpone_period: 90.days) # window = 30 days
+      comment(@card, users(:david), at: 20.days.ago)
+      comment(@card, users(:kevin), at: 10.days.ago)
+      comment(@card, users(:jz), at: Time.current)
+      assert @card.reload.had_burst?
+
+      boards(:writebook).update!(auto_postpone_period: 30.days) # window = 10 days
+      @card = Card.find(@card.id)
+      assert_not @card.had_burst?
+
+      entropies(:writebook_board).destroy
+      entropies("37s_account").update!(auto_postpone_period: 90.days)
+      @card = Card.find(@card.id)
+      assert_equal 90.days.to_i, @card.auto_postpone_period
+      assert @card.had_burst?
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      @card.touch_last_active_at
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "a comment resets a stalled card" do
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      comment(@card, users(:david), body: "still on it")
+      assert_not @card.reload.stalled?
+    end
+  end
+
+  test "historical assignment still counts after unassignment" do
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      @card.assignments.delete_all
+      @card.reload
+      assert_not @card.assigned?
+      assert @card.had_burst?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "indexed_by stalled returns only stalled cards" do
+    other = cards(:layout)
+    other.assignments.delete_all
+    other.events.where(action: %w[card_assigned card_reopened]).delete_all
+
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      @card.update_columns(last_active_at: 2.weeks.ago)
+      other.update_columns(last_active_at: 2.weeks.ago)
+
+      assert_includes Card.indexed_by("stalled"), @card
+      assert_not_includes Card.indexed_by("stalled"), other
+      assert_includes Card.indexed_by("stalled".inquiry), @card
+    end
+  end
+
+
+test "comments exactly at the window boundary still count as a burst" do
+  travel_to Time.current do
+    comment(@card, users(:david), at: 10.days.ago)
+    comment(@card, users(:kevin), at: 10.days.ago)
+    comment(@card, users(:jz), at: Time.current)
+
+    assert @card.reload.had_burst?
+    assert_includes Card.with_burst, @card
+
+    comment_outside = cards(:layout)
+    comment_outside.assignments.delete_all
+    comment_outside.events.where(action: %w[card_assigned card_reopened]).delete_all
+    comment_outside.comments.delete_all
+    comment(comment_outside, users(:david), at: 10.days.ago - 1.second)
+    comment(comment_outside, users(:kevin), at: 5.days.ago)
+    comment(comment_outside, users(:jz), at: Time.current)
+    assert_not comment_outside.reload.had_burst?
+    assert_not_includes Card.with_burst, comment_outside
+  end
+end
+
+test "title changes count as activity and reset a stall" do
+  travel_to Time.current do
+    assign(@card, users(:kevin))
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.update!(title: "Still the text size")
+    assert_not @card.reload.stalled?
+  end
+end
+  test "filters can list stalled cards" do
+    travel_to Time.current do
+      assign(@card, users(:kevin))
+      @card.update_columns(last_active_at: 2.weeks.ago)
+
+      filter = users(:david).filters.new(indexed_by: "stalled")
+      assert_includes filter.cards, @card
+      assert_not_includes filter.cards, cards(:buy_domain)
+    end
+  end
+
+  private
+    def assign(card, user)
+      with_current_user(:david) { card.toggle_assignment(user) }
+      card.reload
+    end
+
+    def comment(card, user, body: "Noted", at: Time.current)
+      card.comments.create!(creator: user, body: body, created_at: at)
+    end
+end
