@@ -0,0 +1,224 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jz
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal "application/json", @response.media_type
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:logo_published).id
+    assert_includes ids, events(:layout_commented).id
+    times = @response.parsed_body.map { |activity| Time.zone.parse(activity["created_at"]) }
+    assert_equal times.sort.reverse, times
+    assert_equal users(:jz).activities.count.to_s, @response.headers["X-Total-Count"]
+  end
+
+  test "index includes the activity representation" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601, Time.zone.parse(activity["created_at"]).utc.iso8601
+    assert_equal event.description_for(users(:jz)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal event.eventable_type, activity["eventable_type"]
+    assert_equal event.eventable.title, activity.dig("eventable", "title")
+    assert_equal event.eventable.number, activity.dig("eventable", "number")
+    assert_equal card_url(event.eventable), activity.dig("eventable", "url")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal board_url(event.board), activity.dig("board", "url")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+    assert_equal user_url(event.creator), activity.dig("creator", "url")
+  end
+
+  test "comment activity opens the card and jumps to the comment" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:jz)).to_plain_text, activity["description"]
+  end
+
+  test "assignment activity exposes assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal Array(event.assignee_ids), activity.dig("particulars", "assignee_ids")
+    assert_equal event.description_for(users(:jz)).to_plain_text, activity["description"]
+  end
+
+  test "board, title, and triage particulars expose event details" do
+    with_current_user :david do
+      cards(:logo).update!(title: "A much bigger logo")
+      cards(:text).update!(board: boards(:private))
+      cards(:buy_domain).triage_into(columns(:writebook_in_progress))
+    end
+
+    get activities_path, as: :json
+
+    title_event = Event.where(action: "card_title_changed").order(:created_at).last
+    board_event = Event.where(action: "card_board_changed").order(:created_at).last
+    triage_event = Event.where(action: "card_triaged", eventable: cards(:buy_domain)).order(:created_at).last
+
+    activities = @response.parsed_body.index_by { |record| record["id"] }
+
+    assert_equal "A much bigger logo", activities.dig(title_event.id, "particulars", "new_title")
+    assert_equal "The logo isn't big enough", activities.dig(title_event.id, "particulars", "old_title")
+    assert_equal %w[new_title old_title], activities.dig(title_event.id, "particulars").keys.sort
+
+    # Board change lands on the private board, which JZ cannot access.
+    assert_nil activities[board_event.id]
+
+    assert_equal "In progress", activities.dig(triage_event.id, "particulars", "column")
+
+    logout_and_sign_in_as :kevin
+    get activities_path, as: :json
+    board_activity = @response.parsed_body.find { |record| record["id"] == board_event.id }
+
+    assert_equal "Writebook", board_activity.dig("particulars", "old_board")
+    assert_equal "Private board", board_activity.dig("particulars", "new_board")
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    title_event = events(:logo_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => nil } })
+
+    board_event = events(:layout_published)
+    board_event.update_columns(action: "card_board_changed", particulars: {})
+
+    triage_event = events(:text_published)
+    triage_event.update_columns(action: "card_triaged", particulars: { "particulars" => {} })
+
+    get activities_path, as: :json
+    activities = @response.parsed_body.index_by { |record| record["id"] }
+
+    assert_equal "", activities.dig(title_event.id, "particulars", "old_title")
+    assert_equal "", activities.dig(title_event.id, "particulars", "new_title")
+    assert_equal "", activities.dig(board_event.id, "particulars", "old_board")
+    assert_equal "", activities.dig(board_event.id, "particulars", "new_board")
+    assert_equal "", activities.dig(triage_event.id, "particulars", "column")
+  end
+
+  test "omits deprecated collection changes and includes title changes" do
+    collection_event = events(:shipping_published)
+    collection_event.update_columns(action: "card_collection_changed")
+
+    with_current_user :david do
+      cards(:logo).update!(title: "Renamed logo")
+    end
+    title_event = Event.where(action: "card_title_changed").order(:created_at).last
+
+    get activities_path, as: :json
+    ids = @response.parsed_body.pluck("id")
+
+    assert_not_includes ids, collection_event.id
+    assert_includes ids, title_event.id
+  end
+
+  test "filters by creator and board and hides inaccessible boards" do
+    with_current_user :kevin do
+      boards(:private).cards.create!(title: "Secret work", creator: users(:kevin), status: "published", account: accounts("37s"))
+    end
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+    assert_not @response.parsed_body.any? { |activity| activity.dig("board", "id") == boards(:private).id }
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_empty @response.parsed_body
+
+    logout_and_sign_in_as :kevin
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:private).id }
+  end
+
+  test "paginates with the API link header" do
+    20.times do |index|
+      Event.create!(
+        account: accounts("37s"),
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_closed",
+        created_at: index.minutes.ago
+      )
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+    assert_response :success
+    assert_operator @response.parsed_body.size, :<, @response.headers["X-Total-Count"].to_i
+    assert_match(/rel="next"/, @response.headers["Link"])
+    assert_includes @response.headers["Link"], "creator_ids"
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    get next_page, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
+
+class ActivitiesControllerEdgeCaseTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jz
+  end
+
+  test "unknown and inaccessible filters return an empty list" do
+    get activities_path, params: { creator_ids: [ "not-a-real-id" ], board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "sent back to triage and closures have empty particulars" do
+    get activities_path, as: :json
+
+    sent_back = @response.parsed_body.find { |activity| activity["id"] == events(:buy_domain_sent_back_to_triage).id }
+    closed = @response.parsed_body.find { |activity| activity["action"] == "card_closed" }
+
+    assert_equal({}, sent_back["particulars"])
+    assert_equal({}, closed["particulars"])
+  end
+
+  test "accepts a scalar creator id" do
+    get activities_path, params: { creator_ids: users(:kevin).id }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+  end
+end
