diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..c802701 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,42 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids.presence || nested_particulars["assignee_ids"]) }
+    when "card_board_changed"
+      { old_board: particular_value("old_board"), new_board: particular_value("new_board") }
+    when "card_title_changed"
+      { old_title: particular_value("old_title"), new_title: particular_value("new_title") }
+    when "card_triaged"
+      { column: particular_value("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      data = flattened_particulars
+      data.key?(key) ? data[key].to_s : ""
+    end
+
+    def flattened_particulars
+      raw = particulars.is_a?(Hash) ? particulars.stringify_keys : {}
+      nested = raw["particulars"]
+
+      if nested.is_a?(Hash)
+        nested.stringify_keys.reverse_merge(raw.except("particulars"))
+      else
+        raw
+      end
+    end
+
+    def nested_particulars
+      raw = particulars.is_a?(Hash) ? particulars.stringify_keys : {}
+      nested = raw["particulars"]
+      nested.is_a?(Hash) ? nested.stringify_keys : {}
+    end
 end
