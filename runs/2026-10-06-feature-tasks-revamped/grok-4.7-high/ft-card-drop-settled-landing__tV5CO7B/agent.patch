diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e80d64a
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,323 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Move a card between columns or statuses by dragging. Columns keep their own
+// order, so a drop changes where the card lives — it does not reorder cards
+// inside a column. The board updates as soon as you let go; the save happens
+// in the background and must not move the card again.
+export default class extends Controller {
+  static targets = [ "container" ]
+
+  #draggedClass = "drag-and-drop__dragged-item"
+  #hoverClass = "drag-and-drop__hover-container"
+  #desktopQuery = "(min-width: 640px)"
+
+  #draggedCard = null
+  #hoverColumn = null
+  #draggedTimer = null
+  #mediaQuery = null
+  #onMediaChange = null
+  #observer = null
+  #saving = new WeakSet()
+  #origins = new WeakMap()
+
+  connect() {
+    this.#mediaQuery = window.matchMedia(this.#desktopQuery)
+    this.#onMediaChange = () => this.#syncDraggable()
+    this.#mediaQuery.addEventListener("change", this.#onMediaChange)
+
+    this.#syncDraggable()
+    this.#observer = new MutationObserver(() => this.#syncDraggable())
+    this.#observer.observe(this.element, { childList: true, subtree: true })
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+    this.#mediaQuery?.removeEventListener("change", this.#onMediaChange)
+    this.#clearDrag()
+  }
+
+  dragstart(event) {
+    const card = this.#cardFrom(event.target)
+    if (!card || !this.#enabled || this.#saving.has(card)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedCard = card
+    event.dataTransfer?.setData("text/plain", card.id)
+    if (event.dataTransfer) event.dataTransfer.effectAllowed = "move"
+
+    // Apply after the browser snapshots the drag image so the ghost stays sharp.
+    clearTimeout(this.#draggedTimer)
+    this.#draggedTimer = setTimeout(() => {
+      if (this.#draggedCard === card) card.classList.add(this.#draggedClass)
+    })
+  }
+
+  dragover(event) {
+    if (!this.#draggedCard) return
+
+    const column = this.#columnFrom(event.target)
+    if (!column) {
+      this.#clearHighlight()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    this.#highlight(column)
+    this.#autoScroll(event)
+  }
+
+  drop(event) {
+    if (!this.#draggedCard) return
+
+    event.preventDefault()
+    const card = this.#draggedCard
+    const column = this.#columnFrom(event.target)
+    const source = this.#columnFrom(card)
+    this.#clearDrag()
+
+    if (!column || column === source || !this.#canMove(card, column)) return
+
+    this.#move(card, column, source)
+  }
+
+  dragend() {
+    this.#clearDrag()
+  }
+
+  // Private
+
+  #move(card, column, source) {
+    this.#origins.set(card, {
+      parent: card.parentElement,
+      next: card.nextSibling,
+      className: card.className,
+      color: card.style.getPropertyValue("--card-color"),
+      source,
+      column,
+      sourceCount: source?.querySelector(".cards__expander-count")?.textContent,
+      columnCount: column.querySelector(".cards__expander-count")?.textContent
+    })
+
+    this.#place(card, column)
+    this.#watchUnloadedFrame(card, column)
+    this.#syncAppearance(card, column)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(column, 1)
+    this.#persist(card, column)
+  }
+
+  #place(card, column) {
+    const container = this.#cardsContainer(column)
+    container.insertBefore(card, this.#insertionReference(container, card, column))
+  }
+
+  // A column frame that hasn't loaded yet will replace its contents when it
+  // does. Put the card back if that load doesn't already include it.
+  #watchUnloadedFrame(card, column) {
+    const frame = column.querySelector("turbo-frame[src]")
+    if (!frame || frame.hasAttribute("complete")) return
+
+    frame.addEventListener("turbo:frame-load", () => {
+      if (!card.isConnected && !column.querySelector(`#${CSS.escape(card.id)}`)) {
+        this.#place(card, column)
+      }
+    }, { once: true })
+  }
+
+  // Columns sort themselves: golden cards first (then latest activity) in
+  // Maybe and custom columns; Not Now and Done put the card you just moved
+  // at the top. Matching that order now means the later refresh doesn't shift it.
+  #insertionReference(container, card, column) {
+    const cards = [ ...container.querySelectorAll(":scope > article.card") ].filter(el => el !== card)
+    const atTop = !this.#sortsGoldenFirst(column) || card.classList.contains("golden-effect")
+
+    if (atTop) return cards[0] || this.#afterCards(container)
+
+    const firstOrdinary = cards.find(el => !el.classList.contains("golden-effect"))
+    return firstOrdinary || this.#afterCards(container)
+  }
+
+  #afterCards(container) {
+    return [ ...container.children ].find(el => !el.classList.contains("card")) || null
+  }
+
+  #sortsGoldenFirst(column) {
+    return column.dataset.dropStatus === "column" || column.dataset.dropStatus === "stream"
+  }
+
+  #cardsContainer(column) {
+    const list = this.#cardsList(column)
+    return list.querySelector(":scope > [data-controller~='pagination'] > turbo-frame") ||
+      list.querySelector("turbo-frame") ||
+      list
+  }
+
+  #cardsList(column) {
+    return column.querySelector(".cards__list") || this.#buildList(column)
+  }
+
+  #buildList(column) {
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    const frame = column.querySelector("turbo-frame")
+    const parent = frame || column.querySelector(".cards__transition-container") || column
+    parent.append(list)
+    return list
+  }
+
+  #syncAppearance(card, column) {
+    const status = column.dataset.dropStatus
+    card.classList.toggle("card--postponed", status === "not-now")
+    card.classList.toggle("card--active", status === "column" || status === "stream")
+
+    if (status === "column") {
+      const color = column.style.getPropertyValue("--card-color").trim()
+      if (color) card.style.setProperty("--card-color", color)
+    } else if (status === "stream") {
+      card.style.setProperty("--card-color", "var(--color-card-default)")
+    }
+  }
+
+  #adjustCount(column, delta) {
+    const count = column?.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const text = count.textContent.trim()
+    if (text.endsWith("+")) return
+
+    const value = parseInt(text, 10)
+    if (Number.isNaN(value)) return
+
+    const next = value + delta
+    count.textContent = next > 99 ? "99+" : String(Math.max(0, next))
+  }
+
+  async #persist(card, column) {
+    this.#saving.add(card)
+
+    try {
+      const response = await this.#requestMove(card, column)
+      if (!response?.ok) this.#restore(card)
+    } catch (error) {
+      this.#restore(card)
+    } finally {
+      this.#saving.delete(card)
+    }
+  }
+
+  #requestMove(card, column) {
+    const status = column.dataset.dropStatus
+
+    if (status === "stream") {
+      return destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+    }
+
+    if (status === "not-now") {
+      return post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+    }
+
+    if (status === "closed") {
+      return post(card.dataset.cardClosureUrl, { responseKind: "json" })
+    }
+
+    return post(card.dataset.cardTriageUrl, {
+      responseKind: "json",
+      query: { column_id: column.dataset.columnId }
+    })
+  }
+
+  #canMove(card, column) {
+    const status = column.dataset.dropStatus
+
+    if (status === "column") return card.dataset.cardTriageUrl && column.dataset.columnId
+    if (status === "stream") return !!card.dataset.cardTriageUrl
+    if (status === "not-now") return !!card.dataset.cardNotNowUrl
+    if (status === "closed") return !!card.dataset.cardClosureUrl
+
+    return false
+  }
+
+  #restore(card) {
+    const origin = this.#origins.get(card)
+    if (!origin?.parent) return
+
+    origin.parent.insertBefore(card, origin.next)
+    card.className = origin.className
+
+    if (origin.color) {
+      card.style.setProperty("--card-color", origin.color)
+    } else {
+      card.style.removeProperty("--card-color")
+    }
+
+    this.#restoreCount(origin.column, origin.columnCount)
+    this.#restoreCount(origin.source, origin.sourceCount)
+    this.#origins.delete(card)
+  }
+
+  #restoreCount(column, text) {
+    const count = column?.querySelector(".cards__expander-count")
+    if (count && text != null) count.textContent = text
+  }
+
+  #highlight(column) {
+    if (this.#hoverColumn === column) return
+
+    this.#clearHighlight()
+    column.classList.add(this.#hoverClass)
+    this.#hoverColumn = column
+  }
+
+  #clearHighlight() {
+    this.#hoverColumn?.classList.remove(this.#hoverClass)
+    this.#hoverColumn = null
+  }
+
+  #clearDrag() {
+    clearTimeout(this.#draggedTimer)
+    this.#draggedCard?.classList.remove(this.#draggedClass)
+    this.#draggedCard = null
+    this.#clearHighlight()
+  }
+
+  #autoScroll(event) {
+    const rect = this.element.getBoundingClientRect()
+    const edge = 72
+    const maxSpeed = 22
+    let speed = 0
+
+    if (event.clientX < rect.left + edge) {
+      speed = -maxSpeed * (1 - Math.max(0, event.clientX - rect.left) / edge)
+    } else if (event.clientX > rect.right - edge) {
+      speed = maxSpeed * (1 - Math.max(0, rect.right - event.clientX) / edge)
+    }
+
+    if (speed !== 0) this.element.scrollLeft += speed
+  }
+
+  #syncDraggable() {
+    this.element.querySelectorAll("article.card").forEach(card => {
+      card.draggable = this.#enabled
+      card.querySelectorAll("a, img, button").forEach(el => { el.draggable = false })
+    })
+  }
+
+  #cardFrom(target) {
+    const card = target?.closest?.("article.card")
+    if (card && this.element.contains(card)) return card
+  }
+
+  #columnFrom(target) {
+    const column = target?.closest?.("[data-drag-and-drop-target~='container']")
+    if (column && this.element.contains(column)) return column
+  }
+
+  get #enabled() {
+    return this.#mediaQuery?.matches ?? window.matchMedia(this.#desktopQuery).matches
+  }
+}
