+  } else if (dayDiff === -1) {
+    return "yesterday"
+  } else if (dayDiff === 1) {
+    return "tomorrow"
+  } else if (dayDiff < -1 && dayDiff > -7) {
+    return `${-dayDiff} days ago`
+  } else if (dayDiff > 1) {
+    return `in ${dayDiff} days`
+  } else {
