diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..183de0c 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,33 @@
 module TimeHelper
+  # The browser turns this timestamp into words in the viewer's timezone.
+  # Leaving the words out of the HTML keeps fragment caches shareable.
+  def local_time_tag(time, format: :relative, **attributes)
+    return if time.blank?
+
+    tag.time(**local_time_options(time, format:, **attributes))
+  end
+
+  # A placeholder for dates that are shown outside HTML text, such as native
+  # share sheets. The browser replaces it when the text is actually used.
+  def local_time_placeholder(time, format: :short_date)
+    "{{local_time:#{format}:#{utc_iso8601(time)}}}" if time.present?
+  end
+
+  private
+    def local_time_options(time, format:, **attributes)
+      data = { controller: "local-time", local_time_format_value: format }
+      data.merge!(attributes.delete(:data)) if attributes[:data]
+
+      {
+        datetime: utc_iso8601(time),
+        class: class_names("local-time-value", attributes.delete(:class)),
+        data: data,
+        **attributes
+      }
+    end
+
+    def utc_iso8601(time)
+      timestamp = time.respond_to?(:utc) ? time.utc : time.to_time.utc
+      timestamp.iso8601
+    end
 end
