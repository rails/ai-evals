+  }
+}
+
+function formatTime(date, timeZone) {
+  return formatWith(date, { hour: "numeric", minute: "2-digit", hour12: true }, timeZone)
+}
+
+function formatShortDate(date, now, timeZone) {
+  const options = { month: "short", day: "numeric" }
+  if (yearOf(date, timeZone) !== yearOf(now, timeZone)) options.year = "numeric"
+
+  return formatWith(date, options, timeZone)
+}
+
+function formatDate(date, timeZone) {
+  return formatWith(date, { month: "short", day: "numeric", year: "numeric" }, timeZone)
+}
+
+function formatWeekday(date, timeZone) {
+  return formatWith(date, { weekday: "long", month: "long", day: "numeric" }, timeZone)
