diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..73297ff
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,73 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+const controllers = new Set()
+
+let timer
+let refreshScheduled = false
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    controllers.add(this)
+    startRefreshing()
+  }
+
+  disconnect() {
+    controllers.delete(this)
+    stopRefreshingIfIdle()
+  }
+
+  render() {
+    const date = new Date(this.element.getAttribute("datetime"))
+    if (Number.isNaN(date.getTime())) return
+
+    const text = formatLocalTime(date, this.formatValue)
+    if (this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+
+    const title = formatLocalTime(date, "full")
+    if (this.element.title !== title) {
+      this.element.title = title
+    }
+  }
+}
+
+function startRefreshing() {
+  if (timer) return
+
+  timer = setInterval(refreshAll, REFRESH_INTERVAL)
+}
+
+function stopRefreshingIfIdle() {
+  if (controllers.size === 0 && timer) {
+    clearInterval(timer)
+    timer = null
+  }
+}
+
+function refreshAll() {
+  controllers.forEach(controller => controller.render())
+}
+
+function scheduleRefreshAll() {
+  if (refreshScheduled) return
+
+  refreshScheduled = true
+  requestAnimationFrame(() => {
+    refreshScheduled = false
+    refreshAll()
+  })
+}
+
+// Morph replaces light-DOM text with the empty server markup without
+// reconnecting the controller. Paint the words again once that settles.
+document.addEventListener("turbo:morph", scheduleRefreshAll)
+document.addEventListener("turbo:morph-element", scheduleRefreshAll)
+document.addEventListener("visibilitychange", () => {
+  if (document.visibilityState === "visible") refreshAll()
+})
