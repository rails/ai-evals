+// differ in a PWA. Time words are still the viewer's: the cookie that sets this
+// tag comes from their browser.
+export function viewerTimeZone() {
+  return getMetaContent("timezone") || Intl.DateTimeFormat().resolvedOptions().timeZone
+}
+
+export function formatLocalTime(date, format = "relative", options = {}) {
+  const now = options.now || new Date()
+  const timeZone = options.timeZone || viewerTimeZone()
+
+  switch (format) {
+    case "time":
+      return formatTime(date, timeZone)
+    case "short_date":
+      return formatShortDate(date, now, timeZone)
+    case "date":
+      return formatDate(date, timeZone)
+    case "weekday":
+      return formatWeekday(date, timeZone)
+    case "numeric":
+      return formatNumeric(date, timeZone)
+    case "full":
+      return formatFull(date, timeZone)
+    default:
+      return formatRelative(date, now, timeZone)
+  }
+}
+
+export function formatEmbeddedLocalTimes(text, options = {}) {
+  if (!text) return text
+
+  return text.replace(EMBEDDED_LOCAL_TIME, (_match, format, iso) => {
