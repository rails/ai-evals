diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..a1b9da3
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "search page finds cards and wraps matched words in mark" do
+    card = boards(:writebook).cards.create!(title: "Ship the xylophone", status: :published, creator: users(:kevin))
+    card.update!(description: "<p>Details about <strong>xylodesc</strong> live here</p>")
+    card.comments.create!(body: "<div>Please note xylocomment today</div>", creator: users(:kevin))
+
+    get search_path(q: "xylophone")
+    assert_response :success
+    assert_select "#search-results mark", text: "xylophone"
+    assert_select "input[name=q][value=?]", "xylophone"
+
+    get search_path(q: "xylodesc")
+    assert_response :success
+    assert_select "#search-results mark", text: "xylodesc"
+    assert_select "#search-results a[href=?]", card_path(card)
+
+    get search_path(q: "xylocomment")
+    assert_response :success
+    assert_select "#search-results mark", text: "xylocomment"
+  end
+
+  test "account prefixed path finds cards" do
+    untenanted do
+      get "/#{accounts("37s").external_account_id}/search", params: { q: "logo" }
+    end
+
+    assert_response :success
+    assert_select "mark", text: "logo"
+  end
+
+  test "results are newest first" do
+    boards(:writebook).cards.create!(title: "xyloorder older", status: :published, creator: users(:kevin), created_at: 2.days.ago, last_active_at: 1.minute.ago)
+    boards(:writebook).cards.create!(title: "xyloorder newer", status: :published, creator: users(:kevin), created_at: 1.hour.ago, last_active_at: 3.days.ago)
+
+    get search_path(q: "xyloorder")
+    assert_response :success
+
+    assert_select "#search-results .search-result" do |results|
+      assert_equal 2, results.size
+      assert_match "newer", results.first.text
+      assert_match "older", results.last.text
+    end
+  end
+
+  test "inaccessible boards and drafts never turn up" do
+    boards(:private).cards.create!(title: "xylosecret private", status: :published, creator: users(:kevin)).comments.create!(body: "xylosecretcomment private", creator: users(:kevin))
+    boards(:writebook).cards.create!(title: "xylodraft secret", status: :drafted, creator: users(:kevin))
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "xylosecret")
+    assert_response :success
+    assert_select "#search-results", count: 0
+    assert_no_match(/private/, response.body)
+
+    get search_path(q: "xylosecretcomment")
+    assert_response :success
+    assert_select "#search-results", count: 0
+
+    get search_path(q: "xylodraft")
+    assert_response :success
+    assert_select "#search-results", count: 0
+    assert_no_match(/xylodraft secret/, response.body)
+  end
+
+  test "blank search renders the page without results" do
+    get search_path
+    assert_response :success
+    assert_select "#search-results", count: 0
+    assert_select "form[action=?][method=get]", search_path
+    assert_select "input[name=q]"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+end
diff --git a/test/models/card/search_test.rb b/test/models/card/search_test.rb
new file mode 100644
index 0000000..524f2be
--- /dev/null
+++ b/test/models/card/search_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finds cards by title, description, or comment and orders newest first" do
+    older = publish_card("xyloorder older", created_at: 3.days.ago, last_active_at: Time.current)
+    newer = publish_card("xyloorder newer", created_at: 1.hour.ago, last_active_at: 4.days.ago)
+    described = publish_card("Plain title", created_at: 2.days.ago)
+    described.update!(description: "A unique description token xylodesc")
+    commented = publish_card("Commented title", created_at: 2.hours.ago)
+    commented.comments.create!(body: "Mention xylocomment in the body", creator: @user)
+
+    assert_equal [ newer, older ], search("xyloorder").cards.to_a
+    assert_equal [ described ], search("xylodesc").cards.to_a
+    assert_equal [ commented ], search("xylocomment").cards.to_a
+  end
+
+  test "matches every word case insensitively across fields" do
+    card = publish_card("Needs a xylotitle")
+    card.update!(description: "Make the xylomark bigger")
+
+    assert_equal [ card ], search("xylotitle xylomark").cards.to_a
+    assert_equal [ card ], search("XYLOTITLE").cards.to_a
+    assert_empty search("xylotitle missingword").cards
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    hidden = boards(:private).cards.create!(title: "xylopriv hidden", status: :published, creator: users(:kevin))
+    hidden.comments.create!(body: "xyloprivcomment hidden", creator: users(:kevin))
+
+    assert_not_includes search("xylopriv", user: users(:david)).cards, hidden
+    assert_empty search("xyloprivcomment", user: users(:david)).cards
+    assert_includes search("xylopriv", user: users(:kevin)).cards, hidden
+    assert_not_includes search("radio", user: users(:kevin)).cards, cards(:radio)
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = boards(:writebook).cards.create!(title: "xylodraft title", status: :drafted, creator: @user)
+    published = publish_card("Will be drafted")
+    published.comments.create!(body: "xylodraftcomment secret", creator: @user)
+    published.update!(status: :drafted)
+
+    assert_empty search("xylodraft").cards
+    assert_not_includes search("xylodraft").cards, draft
+    assert_empty search("xylodraftcomment").cards
+  end
+
+  test "drops cards when access is revoked" do
+    card = publish_card("xylorevoke me")
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:david))
+
+    assert_not_includes search("xylorevoke", user: users(:david)).cards, card
+    assert_includes search("xylorevoke", user: users(:kevin)).cards, card
+  end
+
+  test "treats like wildcards as literal characters" do
+    publish_card("100 percent done")
+    publish_card("under_score token")
+
+    assert_empty search("%").cards
+    assert_empty search("_").cards
+    assert_equal [ Card.find_by!(title: "under_score token") ], search("under_score").cards.to_a
+  end
+
+  test "includes closed cards" do
+    card = publish_card("xyloclosed done")
+    card.close(user: @user)
+
+    assert_includes search("xyloclosed").cards, card
+  end
+
+  test "highlight wraps matched words and escapes html" do
+    highlighted = search("logo script").highlight("The logo isn't <script>alert(1)</script>")
+
+    assert_includes highlighted, "<mark>logo</mark>"
+    assert_includes highlighted, "<mark>script</mark>"
+    assert_not_includes highlighted, "<" + "script>"
+    assert_includes highlighted, "&" + "lt;"
+    assert highlighted.html_safe?
+  end
+
+  private
+    def search(query, user: @user)
+      Card::Search.new(query, user: user)
+    end
+
+    def publish_card(title, created_at: Time.current, last_active_at: created_at)
+      boards(:writebook).cards.create!(
+        title: title,
+        status: :published,
+        creator: @user,
+        created_at: created_at,
+        last_active_at: last_active_at
+      )
+    end
+end
