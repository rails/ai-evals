diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..d7e8c4c
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,136 @@
+class Card::Search
+  LIKE_ESCAPE = "!"
+  EXCERPT_RADIUS = 80
+
+  attr_reader :query
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s
+    @user = user
+  end
+
+  def cards
+    @cards ||= find_cards
+  end
+
+  def terms
+    @terms ||= extract_terms
+  end
+
+  def searched?
+    query.strip.present?
+  end
+
+  def highlight(text)
+    string = text.to_s
+    return "".html_safe if string.blank?
+    return escape(string).html_safe if terms.empty?
+
+    result = +""
+    cursor = 0
+
+    string.scan(highlight_pattern) do
+      match = Regexp.last_match
+      result << escape(string[cursor...match.begin(0)])
+      result << "<mark>" << escape(match[0]) << "</mark>"
+      cursor = match.end(0)
+    end
+
+    result << escape(string[cursor..])
+    result.html_safe
+  end
+
+  def description_excerpt(card)
+    excerpt_if_match(plain_text(card.description))
+  end
+
+  def comment_excerpts(card)
+    card.comments.filter_map { |comment| excerpt_if_match(plain_text(comment.body)) }
+  end
+
+  private
+    def find_cards
+      if @user.nil? || terms.empty?
+        Card.none
+      else
+        relation = accessible_published_cards
+        terms.each do |term|
+          relation = relation.where(id: ids_matching(term))
+        end
+
+        relation.reverse_chronologically
+          .preload(:board, :rich_text_description, comments: :rich_text_body)
+          .select { |card| terms.all? { |term| searchable_text(card).downcase.include?(term.downcase) } }
+      end
+    end
+
+    def searchable_text(card)
+      [ card.title, plain_text(card.description), *card.comments.map { |comment| plain_text(comment.body) } ].compact.join("\n")
+    end
+
+    def extract_terms
+      query.split(/\s+/).filter_map { |term| term.gsub(/\A[[:punct:]]+|[[:punct:]]+\z/, "").presence }.uniq
+    end
+
+    def accessible_published_cards
+      @user.accessible_cards.published
+    end
+
+    def ids_matching(term)
+      pattern = like_pattern(term)
+      title_ids = accessible_published_cards.where(like_sql("cards.title"), pattern).select("cards.id")
+      description_ids = accessible_published_cards.joins(:rich_text_description).where(like_sql("action_text_rich_texts.body"), pattern).select("cards.id")
+      comment_ids = accessible_published_cards.joins(comments: :rich_text_body).where(like_sql("action_text_rich_texts.body"), pattern).select("cards.id")
+
+      Card.where(id: title_ids).or(Card.where(id: description_ids)).or(Card.where(id: comment_ids)).select("cards.id")
+    end
+
+    def like_pattern(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, LIKE_ESCAPE)}%"
+    end
+
+    def like_sql(column)
+      "LOWER(#{column}) LIKE LOWER(?) ESCAPE '#{LIKE_ESCAPE}'"
+    end
+
+    def highlight_pattern
+      @highlight_pattern ||= Regexp.new(terms.sort_by { |term| -term.length }.map { |term| Regexp.escape(term) }.join("|"), Regexp::IGNORECASE)
+    end
+
+    def excerpt_if_match(text)
+      return if text.blank? || !matches?(text)
+
+      if text.length <= EXCERPT_RADIUS * 2
+        text
+      else
+        window_around_match(text)
+      end
+    end
+
+    def window_around_match(text)
+      index = first_match_index(text)
+      start = [ index - EXCERPT_RADIUS, 0 ].max
+      finish = [ index + terms.map(&:length).max + EXCERPT_RADIUS, text.length ].min
+      snippet = text[start...finish].strip
+      snippet = "…#{snippet}" unless start.zero?
+      snippet = "#{snippet}…" unless finish == text.length
+      snippet
+    end
+
+    def matches?(text)
+      first_match_index(text).present?
+    end
+
+    def first_match_index(text)
+      folded = text.downcase
+      terms.filter_map { |term| folded.index(term.downcase) }.min
+    end
+
+    def plain_text(rich_text)
+      rich_text&.to_plain_text.to_s
+    end
+
+    def escape(text)
+      ERB::Util.html_escape(text.to_s).to_str
+    end
+end
