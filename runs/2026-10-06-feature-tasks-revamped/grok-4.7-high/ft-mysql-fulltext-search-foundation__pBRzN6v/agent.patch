+<li id="<%= dom_id(card, :search) %>" class="search-result">
+  <%= link_to card_path(card), class: "search-result__title" do %>
+    <%= @search.highlight(card.title) %>
+  <% end %>
+
+  <p class="search-result__meta txt-small txt-subtle"><%= card.board.name %></p>
+
+  <% if excerpt = @search.description_excerpt(card) %>
+    <p class="search-result__snippet"><%= @search.highlight(excerpt) %></p>
+  <% end %>
+
+  <% @search.comment_excerpts(card).each do |excerpt| %>
+    <p class="search-result__snippet">
+      <span class="txt-subtle">Comment: </span><%= @search.highlight(excerpt) %>
+    </p>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7fe5caf
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless txt-align-start">
+  <%= form_with url: search_path, method: :get, role: "search", authenticity_token: false, class: "search-form" do %>
+    <%= search_field_tag :q, @search.query,
+          placeholder: "Search cards…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          spellcheck: false,
+          class: "input",
+          aria: { label: "Search cards" },
+          data: { "1p-ignore": true } %>
+    <%= submit_tag "Search", class: "btn", name: nil %>
+  <% end %>
+
+  <% if !@search.searched? %>
+    <p class="blank-slate">Search titles, descriptions, and comments</p>
+  <% elsif @cards.none? %>
+    <p class="blank-slate">No cards match “<%= @search.query %>”</p>
+  <% else %>
+    <ol id="search-results" class="search-results list-style-none unpad">
+      <%= render partial: "searches/result", collection: @cards, as: :card %>
+    </ol>
+  <% end %>
+</section>
