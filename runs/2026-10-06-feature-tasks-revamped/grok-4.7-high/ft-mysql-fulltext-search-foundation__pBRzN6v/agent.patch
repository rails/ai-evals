+@layer components {
+  .search {
+    --panel-size: 60ch;
+
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+  }
+
+  .search-form {
+    display: flex;
+    gap: var(--inline-space-half);
+  }
+
+  .search-form .input {
+    flex: 1;
+  }
+
+  .search-results {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space);
+  }
+
+  .search-result {
+    border-block-end: 1px solid var(--color-ink-lighter);
+    display: flex;
+    flex-direction: column;
+    gap: 0.35em;
+    padding-block-end: var(--block-space-half);
+  }
+
+  .search-result__title {
+    color: var(--color-ink);
+    font-weight: 700;
+    text-decoration: none;
+  }
+
+  .search-result__snippet {
+    margin: 0;
+  }
+
+  mark {
+    background-color: var(--color-highlight);
+    border-radius: 0.2em;
+    color: inherit;
+    padding-inline: 0.15em;
+  }
+}
