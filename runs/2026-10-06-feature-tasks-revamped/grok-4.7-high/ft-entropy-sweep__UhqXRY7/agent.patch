diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..7cad412 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,20 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due clears the column, records inactivity, and drops spikes" do
+    card = cards(:text)
+    card.create_activity_spike!
+    card.update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 1.day)
+
+    Card.auto_postpone_all_due
+
+    card.reload
+    assert card.postponed?
+    assert_nil card.column_id
+    assert_nil card.activity_spike
+    assert_equal accounts("37s").system_user, card.postponed_by
+    assert card.events.last.action.card_auto_postponed?
+    assert_equal "Moved to “Not Now” due to inactivity", card.comments.last.body.to_plain_text
+  end
 end
