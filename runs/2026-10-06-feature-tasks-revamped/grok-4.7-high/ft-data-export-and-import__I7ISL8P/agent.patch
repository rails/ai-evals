diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
new file mode 100644
index 0000000..b5dab02
--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+    Current.session = sessions(:kevin)
+  end
+
+  test "account export and import round trip boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    comment = card.comments.create!(creator: @member, body: "See this")
+    comment.body.body = ActionText::Content.new(comment.body.to_s).append_attachables(blob)
+    comment.save!
+
+    original_names = @account.users.pluck(:name).sort
+    original_board_names = @account.boards.pluck(:name).sort
+    original_card_titles = @account.cards.pluck(:title).sort
+    original_comment_count = @account.cards.joins(:comments).count
+
+    export = @account.exports.create!(user: @admin, kind: :account)
+    export.process_now
+
+    assert export.ready?, export.failure_reason
+    assert export.file.attached?
+    assert_equal 1.day.from_now.to_i, export.expires_at.to_i
+
+    imported = nil
+    assert_difference -> { Account.count }, 1 do
+      ZipFile.open(export.file.blob) do |zip|
+        imported = Account::DataTransfer::Importer.new(zip, importer: @admin.identity).perform
+      end
+    end
+
+    assert_not_equal @account.id, imported.id
+    assert_not_equal @account.external_account_id, imported.external_account_id
+    assert_equal @account.name, imported.name
+    assert_equal original_board_names, imported.boards.pluck(:name).sort
+    assert_equal original_card_titles, imported.cards.pluck(:title).sort
+    assert_equal original_names, imported.users.pluck(:name).sort
+    assert_equal original_comment_count, imported.cards.joins(:comments).count
+
+    imported_card = imported.cards.find_by!(number: card.number)
+    assert imported_card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    imported_comment = imported_card.comments.joins(:rich_text_body).where("action_text_rich_texts.body LIKE ?", "%See this%").first
+    assert imported_comment, "expected the imported comment"
+    assert_equal "avatar.png", imported_comment.body.embeds.sole.filename.to_s
+    assert_equal file_fixture("avatar.png").binread, imported_comment.body.embeds.sole.download
+
+    html = imported_comment.body.to_s
+    node = Nokogiri::HTML.fragment(html).at_css("action-text-attachment")
+    assert node["sgid"].present?
+    located = GlobalID::Locator.locate_signed(node["sgid"], for: "attachable")
+    assert_equal imported_comment.body.embeds.sole.blob, located
+
+    assert imported.users.find_by!(identity: @admin.identity)
+    assert imported.join_code.present?
+  end
+
+  test "failed import leaves nothing behind" do
+    export = export_account
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import_records).raises(Account::DataTransfer::Error, "disk full")
+
+    assert_no_difference [ -> { Account.count }, -> { Card.count }, -> { User.count }, -> { Board.count } ] do
+      error = assert_raises(Account::DataTransfer::Error) do
+        ZipFile.open(export.file.blob) do |zip|
+          Account::DataTransfer::Importer.new(zip, importer: identities(:kevin)).perform
+        end
+      end
+
+      assert_equal "disk full", error.message
+    end
+  end
+
+  test "import of a cards file fails and leaves nothing behind" do
+    export = @account.exports.create!(user: @member, kind: :cards)
+    export.process_now
+
+    assert_no_difference -> { Account.count } do
+      error = assert_raises(Account::DataTransfer::Error) do
+        ZipFile.open(export.file.blob) do |zip|
+          Account::DataTransfer::Importer.new(zip, importer: identities(:kevin)).perform
+        end
+      end
+
+      assert_match(/isn't a Fizzy account export/, error.message)
+    end
+  end
+
+  test "card export includes visible cards with comments and files, and skips hidden cards" do
+    visible = cards(:logo)
+    visible.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    visible.comments.create!(creator: @member, body: "A comment on the logo")
+
+    hidden_board = @account.boards.create!(name: "Secret", creator: @admin, all_access: false)
+    hidden = hidden_board.cards.create!(
+      creator: @admin,
+      title: "Hidden card",
+      status: :published,
+      last_active_at: Time.current
+    )
+
+    export = @account.exports.create!(user: @member, kind: :cards)
+    export.process_now
+
+    ZipFile.open(export.file.blob) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "cards", manifest["kind"]
+
+      payload = JSON.parse(zip.read("cards/#{visible.number}.json"))
+      assert_equal visible.title, payload["title"]
+      assert_includes payload["comments"].map { |comment| comment["body"] }, "A comment on the logo"
+      assert payload["files"].one?
+      assert_equal file_fixture("moon.jpg").binread, zip.read(payload["files"].first)
+
+      assert_not zip.exists?("cards/#{hidden.number}.json")
+    end
+  end
+
+  test "export emails a download link that works for a day" do
+    export = export_account
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      ExportMailer.ready(export).deliver_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @admin.identity.email_address ], email.to
+    assert_match "works for 24 hours", email.body.encoded
+
+    sig = export.signed_id(purpose: :download, expires_in: 1.day)
+    assert Export.find_signed(sig, purpose: :download)
+
+    travel 2.days do
+      assert_nil Export.find_signed(sig, purpose: :download)
+    end
+  end
+
+  private
+    def export_account
+      export = @account.exports.create!(user: @admin, kind: :account)
+      export.process_now
+      export
+    end
+end
