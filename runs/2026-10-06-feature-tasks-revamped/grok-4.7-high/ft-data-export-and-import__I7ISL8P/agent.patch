diff --git a/app/models/account/data_transfer/card_export.rb b/app/models/account/data_transfer/card_export.rb
new file mode 100644
index 0000000..cbae9e2
--- /dev/null
+++ b/app/models/account/data_transfer/card_export.rb
@@ -0,0 +1,112 @@
+class Account::DataTransfer::CardExport
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(zip)
+    paths = cards.map { |card| export_card(zip, card) }
+
+    zip.add_file("manifest.json", JSON.generate(
+      version: Account::DataTransfer::VERSION,
+      kind: "cards",
+      exported_at: Time.current.iso8601,
+      cards: paths
+    ))
+  end
+
+  private
+    attr_reader :user
+
+    def cards
+      published_ids = user.accessible_cards.published.ids
+      draft_ids = user.accessible_cards.drafted.where(creator: user).ids
+
+      Card.where(id: published_ids + draft_ids)
+        .includes(:board, :column, :tags, :creator, :assignees, :image_attachment, comments: [ :creator ])
+        .with_rich_text_description_and_embeds
+        .order(:number)
+    end
+
+    def export_card(zip, card)
+      files = export_files(zip, card)
+      path = "cards/#{card.number}.json"
+
+      zip.add_file(path, JSON.pretty_generate(card_payload(card, files)))
+      path
+    end
+
+    def card_payload(card, files)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: person(card.creator),
+        assignees: card.assignees.map { |assignee| person(assignee) },
+        tags: card.tags.map(&:title).sort,
+        created_at: card.created_at.iso8601,
+        updated_at: card.updated_at.iso8601,
+        files: files[:card],
+        comments: card.comments.chronologically.map do |comment|
+          comment_payload(comment, files[:comments].fetch(comment.id, []))
+        end
+      }
+    end
+
+    def comment_payload(comment, files)
+      {
+        id: comment.id,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        creator: person(comment.creator),
+        created_at: comment.created_at.iso8601,
+        updated_at: comment.updated_at.iso8601,
+        files: files
+      }
+    end
+
+    def person(user)
+      return unless user
+
+      {
+        id: user.id,
+        name: user.name,
+        email_address: user.identity&.email_address
+      }
+    end
+
+    def export_files(zip, card)
+      card_files = []
+      comment_files = {}
+
+      if card.image.attached?
+        card_files << write_blob(zip, card, card.image.blob, "image-")
+      end
+
+      card.attachments.each do |attachment|
+        card_files << write_blob(zip, card, attachment.blob, "file-")
+      end
+
+      card.comments.each do |comment|
+        comment_files[comment.id] = comment.attachments.filter_map do |attachment|
+          write_blob(zip, card, attachment.blob, "comment-#{comment.id}-") if attachment.blob
+        end
+      end
+
+      { card: card_files, comments: comment_files }
+    end
+
+    def write_blob(zip, card, blob, prefix)
+      return unless blob
+
+      path = "files/#{card.number}/#{prefix}#{blob.id}-#{blob.filename}"
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+      path
+    end
+end
diff --git a/app/models/account/data_transfer/cleanup.rb b/app/models/account/data_transfer/cleanup.rb
new file mode 100644
index 0000000..68b1e78
--- /dev/null
+++ b/app/models/account/data_transfer/cleanup.rb
@@ -0,0 +1,92 @@
+class Account::DataTransfer::Cleanup
+  MODELS = [
+    Access,
+    Account::Cancellation,
+    Account::JoinCode,
+    ActionText::RichText,
+    ActiveStorage::Attachment,
+    ActiveStorage::VariantRecord,
+    Assignment,
+    Board::Publication,
+    Card::ActivitySpike,
+    Card::Goldness,
+    Card::NotNow,
+    Closure,
+    Comment,
+    Step,
+    Tagging,
+    Reaction,
+    Mention,
+    Notification,
+    Notification::Bundle,
+    Pin,
+    Watch,
+    Event,
+    Webhook::Delivery,
+    Webhook::DelinquencyTracker,
+    Webhook,
+    Filter,
+    Entropy,
+    Column,
+    Card,
+    Board,
+    Tag,
+    User::Settings,
+    Push::Subscription,
+    Search::Query,
+    Storage::Entry,
+    User,
+    ActiveStorage::Blob
+  ].freeze
+
+  def self.purge(account, uploaded_keys: [], created_identity_ids: [])
+    new(account, uploaded_keys: uploaded_keys, created_identity_ids: created_identity_ids).purge
+  end
+
+  def initialize(account, uploaded_keys:, created_identity_ids:)
+    @account = account
+    @uploaded_keys = Array(uploaded_keys)
+    @created_identity_ids = Array(created_identity_ids)
+  end
+
+  def purge
+    delete_account_records
+    delete_files
+    delete_created_identities
+  end
+
+  private
+    attr_reader :account, :uploaded_keys, :created_identity_ids
+
+    def delete_account_records
+      return unless account&.id && Account.exists?(account.id)
+
+      board_ids = Board.where(account_id: account.id).pluck(:id)
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: account.id).delete_all
+
+      @uploaded_keys |= ActiveStorage::Blob.where(account_id: account.id).pluck(:key)
+
+      Search::Record.for(account.id).where(account_id: account.id).delete_all
+
+      MODELS.each do |model|
+        model.where(account_id: account.id).delete_all
+      end
+
+      account.delete
+    end
+
+    def delete_files
+      uploaded_keys.uniq.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue ActiveStorage::FileNotFoundError
+        nil
+      end
+    end
+
+    def delete_created_identities
+      Identity.where(id: created_identity_ids).find_each do |identity|
+        identity.destroy if identity.users.none?
+      end
+    end
+end
