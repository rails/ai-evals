+require "test_helper"
+
+class Users::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "a user can download the cards they can see from their profile" do
+    get user_path(users(:david))
+    assert_response :success
+    assert_select "form[action=?]", user_export_path(users(:david))
+
+    assert_enqueued_with(job: Export::ProcessJob) do
+      post user_export_path(users(:david))
+    end
+
+    assert_redirected_to user_path(users(:david))
+    export = Export.last
+    assert_equal "cards", export.kind
+    assert_equal users(:david), export.user
+
+    clear_enqueued_jobs
+    export.process_now
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    export.reload
+    assert export.ready?
+
+    ZipFile.open(export.file.blob) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      assert_equal "cards", manifest["kind"]
+      assert zip.exists?("cards/#{cards(:logo).number}.json")
+      assert_includes JSON.parse(zip.read("cards/#{cards(:logo).number}.json"))["comments"].map { |comment| comment["body"] }, comments(:logo_agreement_jz).body.to_plain_text
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match "24 hours", email.body.encoded
+  end
+
+  test "a user cannot export someone else's cards from their profile" do
+    assert_no_difference -> { Export.count } do
+      post user_export_path(users(:kevin))
+    end
+
+    assert_response :forbidden
+  end
+end
