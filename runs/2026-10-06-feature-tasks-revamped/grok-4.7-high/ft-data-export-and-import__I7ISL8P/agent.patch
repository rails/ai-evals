index 0000000..5064915
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admin can request an account export" do
+    assert_enqueued_with(job: Export::ProcessJob) do
+      post account_exports_path
+    end
+
+    assert_redirected_to account_settings_path
+    export = Export.last
+    assert_equal "account", export.kind
+    assert_equal users(:kevin), export.user
+
+    clear_enqueued_jobs
+    export.process_now
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    export.reload
+    assert export.ready?
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    assert_match %r{/account/exports/#{export.id}/download}, ActionMailer::Base.deliveries.last.body.encoded
+  end
+
+  test "members cannot export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "download link works for a day" do
+    export = accounts(:"37s").exports.create!(user: users(:kevin), kind: :account)
+    clear_enqueued_jobs
+    export.process_now
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    sig = export.signed_id(purpose: :download, expires_in: 1.day)
+    sign_out
+    get account_export_download_path(export, sig: sig)
+    assert_response :redirect
+
+    travel 2.days do
+      get account_export_download_path(export, sig: sig)
+      assert_response :not_found
+    end
+  end
+
+  test "settings page offers export to admins" do
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action=?]", account_exports_path
+    assert_select "a[href=?]", new_account_import_path
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..f7cdd69
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "signed in user can open the import form" do
+    get new_account_import_path
+    assert_response :success
+    assert_select "form[action=?]", account_imports_path
+  end
+
+  test "uploading an account export creates a new account and emails when done" do
+    file = uploaded_account_export
+
+    assert_enqueued_with(job: Import::ProcessJob) do
+      post account_imports_path, params: { import: { file: file } }
+    end
+
+    assert_redirected_to new_account_import_path
+
+    import = Import.last
+    assert_difference -> { Account.count }, 1 do
+      clear_enqueued_jobs
+      import.process_now
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    end
+
+    import.reload
+    assert import.completed?
+    assert_equal accounts(:"37s").name, import.imported_account.name
+    assert import.imported_account.users.exists?(identity: identities(:david))
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match import.imported_account.slug, email.body.encoded
+  end
+
+  test "a failed import emails the reason and leaves nothing behind" do
+    file = uploaded_account_export
+    post account_imports_path, params: { import: { file: file } }
+    import = Import.last
+
+    Account::DataTransfer::Importer.any_instance.stubs(:import_records).raises("unreadable archive")
+
+    assert_no_difference -> { Account.count } do
+      clear_enqueued_jobs
+      import.process_now
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.imported_account
+    assert_match "unreadable archive", import.failure_reason
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_match "unreadable archive", email.body.encoded
+    assert_match "Nothing was left behind", email.body.encoded
+  end
+
+  private
+    def uploaded_account_export
+      export = accounts(:"37s").exports.create!(user: users(:kevin), kind: :account)
+      export.process_now
+      path = export.file.blob.service.path_for(export.file.blob.key)
+      Rack::Test::UploadedFile.new(path, "application/zip", original_filename: "account.zip")
+    end
+end
