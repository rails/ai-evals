@@ -0,0 +1,24 @@
+class Account::Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed(params[:sig], purpose: :download)
+
+    if downloadable?(export)
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port
+      }
+
+      redirect_to export.file.url(disposition: :attachment, expires_in: 10.minutes), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def downloadable?(export)
+      export&.account_id == Current.account.id && export.ready? && export.file.attached? && !export.expired?
+    end
+end
