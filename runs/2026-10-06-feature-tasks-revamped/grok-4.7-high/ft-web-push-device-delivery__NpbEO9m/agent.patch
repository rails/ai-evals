new file mode 100644
index 0000000..f6b76e4
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+  end
+
+  test "create stores the browser subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/device-token", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal subscription.id, @response.parsed_body["id"]
+  end
+
+  test "create updates an existing subscription for the same endpoint" do
+    existing = @user.register_push_subscription(subscription_params)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params(auth_key: "rotated-auth") }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "rotated-auth", existing.reload.auth_key
+    assert_equal existing.id, @response.parsed_body["id"]
+  end
+
+  test "create rejects a non-https endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params(endpoint: "http://fcm.googleapis.com/fcm/send/token") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects a private push endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params(endpoint: "https://127.0.0.1/push") }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the subscription for this device" do
+    subscription = @user.register_push_subscription(subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params(**overrides)
+      {
+        endpoint: "https://fcm.googleapis.com/fcm/send/device-token",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }.merge(overrides)
+    end
+end
diff --git a/test/models/notification_push_test.rb b/test/models/notification_push_test.rb
new file mode 100644
index 0000000..c6211c3
--- /dev/null
+++ b/test/models/notification_push_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class NotificationPushTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @kevin.register_push_subscription(
+      endpoint: "https://fcm.googleapis.com/fcm/send/kevin-phone",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "a new tray notification is pushed to the user's devices" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push job delivers the tray text to every subscription" do
+    notification = notifications(:logo_assignment_kevin)
+    delivered = []
+
+    with_env "VAPID_PUBLIC_KEY" => "public", "VAPID_PRIVATE_KEY" => "private" do
+      WebPush.stubs(:payload_send).with { |args| delivered << JSON.parse(args[:message]); true }
+
+      perform_enqueued_jobs do
+        Notification::PushJob.perform_later(notification)
+      end
+    end
+
+    assert_equal 1, delivered.size
+    assert_equal notification.push_payload[:title], delivered.first["title"]
+    assert_equal notification.push_payload[:body], delivered.first["body"]
+    assert_equal notification.push_payload[:url], delivered.first["url"]
+  end
+
+  test "marking a notification read does not push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "new activity on a card already in the tray pushes again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      notification.update!(source: events(:logo_published), creator: users(:david), read_at: nil, unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "users without a subscription are not enqueued" do
+    david = users(:david)
+    notifications(:logo_mentioned_david).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: david, source: events(:layout_commented), creator: users(:jz))
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..f558f92
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.register_push_subscription(
+      endpoint: "https://updates.push.services.mozilla.com/wpush/v2/token",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "configured? requires both vapid keys" do
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      assert_not PushSubscription.configured?
+    end
+
+    with_env "VAPID_PUBLIC_KEY" => "public", "VAPID_PRIVATE_KEY" => nil do
+      assert_not PushSubscription.configured?
+    end
+
+    with_env "VAPID_PUBLIC_KEY" => "public", "VAPID_PRIVATE_KEY" => "private" do
+      assert PushSubscription.configured?
+    end
+  end
+
+  test "deliver sends what the tray says and opens the card" do
+    payload = nil
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with { |args| payload = args }.returns(true)
+      @subscription.deliver(@notification.push_payload.to_json)
+
+      message = JSON.parse(payload[:message])
+      assert_equal ApplicationController.helpers.event_notification_title(@notification.source), message["title"]
+      assert_equal ApplicationController.helpers.event_notification_body(@notification.source), message["body"]
+      assert_equal Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @notification.account.slug), message["url"]
+      assert_equal @notification.card_id, message["tag"]
+      assert_equal @subscription.endpoint, payload[:endpoint]
+      assert_equal @subscription.p256dh_key, payload[:p256dh]
+      assert_equal @subscription.auth_key, payload[:auth]
+      assert_equal ENV["VAPID_PUBLIC_KEY"], payload.dig(:vapid, :public_key)
+      assert_equal ENV["VAPID_PRIVATE_KEY"], payload.dig(:vapid, :private_key)
+      assert payload.dig(:vapid, :subject).start_with?("mailto:")
+    end
+  end
+
+  test "deliver removes subscriptions the push service has expired" do
+    with_vapid_keys do
+      response = Struct.new(:body).new("gone")
+      WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(@notification.push_payload.to_json)
+      end
+    end
+  end
+
+  test "deliver does nothing when vapid keys are missing" do
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      WebPush.expects(:payload_send).never
+      @subscription.deliver("{}")
+    end
+  end
+
+  test "mention payload matches the tray copy" do
+    notification = notifications(:logo_mentioned_david)
+    payload = notification.push_payload
+    mention = notification.source
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload[:title]
+    assert_equal mention.source.mentionable_content.truncate(200), payload[:body]
+    assert_equal Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug), payload[:url]
+  end
+
+  private
+    def with_vapid_keys
+      key = WebPush.generate_key
+      with_env "VAPID_PUBLIC_KEY" => key.public_key, "VAPID_PRIVATE_KEY" => key.private_key do
+        yield
+      end
+    end
+
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
