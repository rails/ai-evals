diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..5a856ec
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,102 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+  validate :endpoint_must_be_public_https
+
+  class << self
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_subject
+      if address = mailer_address
+        "mailto:#{address}"
+      elsif ENV["BASE_URL"].present?
+        ENV["BASE_URL"]
+      else
+        "mailto:support@fizzy.do"
+      end
+    end
+
+    private
+      def mailer_address
+        from = ENV["MAILER_FROM_ADDRESS"].to_s
+        from[/<([^>]+)>/, 1] || from[/\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b/]
+      end
+  end
+
+  def deliver(message)
+    return unless self.class.configured?
+    return unless deliverable_endpoint?
+
+    WebPush.payload_send(
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: self.class.vapid_subject,
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      },
+      ssl_timeout: 5,
+      open_timeout: 5,
+      read_timeout: 5
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, SocketError, SystemCallError, Timeout::Error, OpenSSL::SSL::SSLError => error
+    Rails.logger.warn("Push delivery failed for subscription #{id}: #{error.class}")
+  end
+
+  private
+    def endpoint_must_be_public_https
+      uri = parse_endpoint
+
+      if uri.nil? || !uri.is_a?(URI::HTTPS) || uri.host.blank?
+        errors.add(:endpoint, "must be an https URL")
+      elsif private_host?(uri.host)
+        errors.add(:endpoint, "must be a public push service")
+      end
+    end
+
+    def deliverable_endpoint?
+      uri = parse_endpoint
+      uri.is_a?(URI::HTTPS) && uri.host.present? && !private_host?(uri.host)
+    end
+
+    def parse_endpoint
+      URI.parse(endpoint.to_s)
+    rescue URI::InvalidURIError
+      nil
+    end
+
+    def private_host?(host)
+      normalized = host.to_s.downcase
+      return true if normalized == "localhost" || normalized.end_with?(".localhost", ".local", ".internal")
+
+      if ip_address?(normalized)
+        SsrfProtection.blocked_address?(normalized)
+      else
+        false
+      end
+    end
+
+    def ip_address?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
