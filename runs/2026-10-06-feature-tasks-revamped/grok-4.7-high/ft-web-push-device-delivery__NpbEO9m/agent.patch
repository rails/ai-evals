new file mode 100644
index 0000000..062f78e
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,31 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.register_push_subscription(push_subscription_params)
+
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..8afa030
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,153 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = {
+    publicKey: String,
+    subscribeUrl: String
+  }
+
+  async connect() {
+    this.#hideDetails()
+
+    if (!this.#supported) {
+      this.#disableToggle()
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      this.#showDetails()
+      this.#disableToggle()
+      return
+    }
+
+    const existing = await this.#existingSubscription()
+    if (existing) {
+      this.subscriptionId = await this.#register(existing)
+      this.#setOn(true)
+    }
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#enable()
+    } else {
+      await this.#disable()
+    }
+  }
+
+  async #enable() {
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#setOn(false)
+      if (permission === "denied") this.#showDetails()
+      return
+    }
+
+    try {
+      const subscription = await this.#subscribe()
+      this.subscriptionId = await this.#register(subscription)
+
+      if (this.subscriptionId) {
+        this.#setOn(true)
+        this.#hideDetails()
+      } else {
+        this.#setOn(false)
+      }
+    } catch (error) {
+      this.#setOn(false)
+      this.#showDetails()
+    }
+  }
+
+  async #disable() {
+    const subscription = await this.#existingSubscription()
+    await subscription?.unsubscribe()
+
+    if (this.subscriptionId) {
+      await destroy(`${this.subscribeUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+    }
+
+    this.subscriptionId = null
+    this.#setOn(false)
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+
+    try {
+      return await registration.pushManager.subscribe(this.#subscribeOptions)
+    } catch (error) {
+      const existing = await registration.pushManager.getSubscription()
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe(this.#subscribeOptions)
+    }
+  }
+
+  async #existingSubscription() {
+    if (!("serviceWorker" in navigator)) return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #register(subscription) {
+    const json = subscription.toJSON()
+    const response = await post(this.subscribeUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys?.p256dh,
+          auth_key: json.keys?.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const data = await response.json
+      return data.id
+    }
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+    if (this.hasToggleTarget) this.toggleTarget.checked = on
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(element => element.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(element => element.hidden = true)
+  }
+
+  #disableToggle() {
+    if (this.hasToggleTarget) this.toggleTarget.disabled = true
+  }
+
+  get #supported() {
+    return this.publicKeyValue.length > 0 &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window
+  }
+
+  get #subscribeOptions() {
+    return {
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+
+    return Uint8Array.from([ ...raw ].map(char => char.charCodeAt(0)))
+  }
+}
