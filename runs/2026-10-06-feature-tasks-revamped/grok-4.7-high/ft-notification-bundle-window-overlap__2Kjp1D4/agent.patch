+<h1 class="title"><%= @notifications.one? ? "New notification" : "#{@notifications.size} new notifications" %></h1>
+<p class="subtitle">Here's what happened on Fizzy.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.sort_by { |board, _| board.name.downcase }.each_with_index do |(board, notifications), index| %>
+  <% if index.positive? %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <table>
+        <tr>
+          <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+          <td>
+            <p class="card__title"><%= link_to notification.payload.title, notification.payload.url %></p>
+            <p class="notification__details"><%= notification.payload.body %></p>
+            <p class="notification__author"><%= notification.creator.name %> · <%= l(notification.created_at, format: :short) %></p>
+          </td>
+        </tr>
+      </table>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change how often you get these", notifications_settings_url %>.
+</p>
