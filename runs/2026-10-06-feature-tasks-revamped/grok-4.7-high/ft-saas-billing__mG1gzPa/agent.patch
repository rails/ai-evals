+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= @account.name %></h2>
+      <div class="txt-small txt-ink-medium">
+        #<%= @account.external_account_id %>
+        · <%= @account.billing_plan.display_name %>
+        <% if @account.billing_waived? %>· Comped<% end %>
+      </div>
+    </header>
+
+    <div class="flex gap margin-block-start">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Limits</h2>
+      <div class="txt-small">
+        Published cards: <%= number_with_delimiter(@account.cards.published.count) %>.
+        Counted toward the limit: <%= number_with_delimiter(@account.cards_counted_toward_limit) %>.
+      </div>
+    </header>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), method: :post, scope: :overridden_limit, class: "flex flex-column gap margin-block-start" do |form| %>
