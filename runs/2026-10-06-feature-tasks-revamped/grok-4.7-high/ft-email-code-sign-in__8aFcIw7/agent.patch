@@ -0,0 +1,46 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <p>
+      <% if email_address = @magic_link&.email_address || flash[:email_address] %>
+        We sent a six-character code to <strong><%= email_address %></strong>. Enter it to continue.
+      <% else %>
+        Enter the six-character code we sent to your email.
+      <% end %>
+    </p>
+
+    <div class="center">
+      <%= form.text_field :code,
+            required: true,
+            autofocus: true,
+            autocomplete: "one-time-code",
+            autocapitalize: "characters",
+            spellcheck: false,
+            maxlength: MagicLink::CODE_LENGTH,
+            placeholder: "Code",
+            aria: { label: "Code" },
+            class: "input" %>
+    </div>
+
+    <% if Rails.env.local? && @magic_link %>
+      <p class="txt-subtle txt-small margin-none">Psst, here's your code</p>
+      <p class="txt-large font-weight-black margin-none"><%= @magic_link.code %></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small center">
+    <%= link_to "Use a different email", @restart_path, class: "txt-link" %>
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
