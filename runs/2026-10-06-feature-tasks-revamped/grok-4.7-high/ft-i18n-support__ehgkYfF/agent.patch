diff --git a/config/initializers/localized_broadcasts.rb b/config/initializers/localized_broadcasts.rb
new file mode 100644
index 0000000..387f561
--- /dev/null
+++ b/config/initializers/localized_broadcasts.rb
@@ -0,0 +1,16 @@
+# Render user-specific Turbo Stream broadcasts in that person's locale.
+# The locale is passed as a rendering option and stripped before render so
+# it is not treated as a template local.
+module LocalizedBroadcasts
+  def perform(stream, action:, target: nil, targets: nil, attributes: {}, **rendering)
+    locale = rendering.delete(:locale)
+    locale = Localization.normalize(locale)&.to_sym || I18n.default_locale
+    I18n.with_locale(locale) do
+      super(stream, action: action, target: target, targets: targets, attributes: attributes, **rendering)
+    end
+  end
+end
+
+Rails.application.config.after_initialize do
+  Turbo::Streams::ActionBroadcastJob.prepend LocalizedBroadcasts
+end
