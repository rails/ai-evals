diff --git a/app/models/system_comment_translator.rb b/app/models/system_comment_translator.rb
new file mode 100644
index 0000000..22ee0ca
--- /dev/null
+++ b/app/models/system_comment_translator.rb
@@ -0,0 +1,46 @@
+# Re-renders stored system comments in the viewer's language without changing
+# the English HTML that was saved when the event happened.
+module SystemCommentTranslator
+  PATTERNS = [
+    [/\A(.+?) <strong>assigned<\/strong> this to (.+?)\.\z/m, "%{creator}がこれを%{names}に<strong>割り当て</strong>ました。"],
+    [/\A(.+?) <strong>unassigned<\/strong> from (.+?)\.\z/m, "%{creator}が%{names}の<strong>割り当てを解除</strong>しました。"],
+    [/\A<strong>Moved<\/strong> to “Done” by (.+)\z/m, "%{creator}が「完了」に<strong>移動</strong>しました"],
+    [/\A<strong>Reopened<\/strong> by (.+)\z/m, "%{creator}が<strong>再開</strong>しました"],
+    [/\A(.+?) <strong>moved<\/strong> this to “Not Now”\z/m, "%{creator}がこれを「今はしない」に<strong>移動</strong>しました"],
+    [/\A<strong>Moved<\/strong> to “Not Now” due to inactivity\z/m, "活動がないため「今はしない」に<strong>移動</strong>しました"],
+    [/\A(.+?) <strong>changed the title<\/strong> from “(.+?)” to “(.+?)”\.\z/m, "%{creator}がタイトルを「%{old}」から「%{new}」に<strong>変更</strong>しました。"],
+    [/\A(.+?) <strong>moved<\/strong> this from “(.+?)” to “(.+?)”\.\z/m, "%{creator}がこれを「%{old}」から「%{new}」に<strong>移動</strong>しました。"],
+    [/\A(.+?) <strong>moved<\/strong> this to “(.+?)”\z/m, "%{creator}がこれを「%{column}」に<strong>移動</strong>しました"],
+    [/\A(.+?) <strong>moved<\/strong> this back to “Maybe\?”\z/m, "%{creator}がこれを「たぶん？」に<strong>戻しました</strong>"]
+  ].freeze
+
+  def self.translate(body)
+    return body unless I18n.locale.to_s == "ja"
+
+    html = body.respond_to?(:body) ? body.body.to_s : body.to_s
+    plain = html.gsub(/<div[^>]*>/, "").gsub("</div>", "").strip
+    PATTERNS.each do |pattern, template|
+      if (match = plain.match(pattern))
+        values = case match.captures.size
+        when 0 then {}
+        when 1 then { creator: match[1], names: match[1] }
+        when 2 then { creator: match[1], names: match[2], column: match[2] }
+        else { creator: match[1], old: match[2], new: match[3] }
+        end
+        # assigned/unassigned use creator + names
+        if template.include?("%{names}") && match.captures.size == 2
+          values = { creator: match[1], names: match[2] }
+        elsif template.include?("%{column}")
+          values = { creator: match[1], column: match[2] }
+        elsif template.include?("%{old}")
+          values = { creator: match[1], old: match[2], new: match[3] }
+        elsif template.include?("%{creator}") && match.captures.size == 1
+          values = { creator: match[1] }
+        end
+        return I18n.interpolate(template, values).html_safe
+      end
+    end
+
+    body
+  end
+end
