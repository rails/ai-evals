diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..f428146
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "japanese query param switches the page and sticks in the session" do
+    sign_in_as :kevin
+
+    get root_path(locale: "ja")
+
+    assert_response :success
+    assert_equal "ja", session[:locale]
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_includes response.body, "lang=\"ja\""
+    assert_not_includes response.body, ">Search<"
+  end
+
+  test "unknown locale does not break the page or switch locale" do
+    sign_in_as :kevin
+
+    get root_path(locale: "xx")
+
+    assert_response :success
+    assert_nil session[:locale]
+    assert_nil identities(:kevin).reload.locale
+    assert_includes response.body, "lang=\"en\""
+  end
+
+  test "saved locale is restored on the next sign in from a clean browser" do
+    identities(:kevin).update!(locale: "ja")
+
+    sign_in_as :kevin
+
+    assert_equal "ja", session[:locale]
+    get root_path
+    assert_response :success
+    assert_includes response.body, "lang=\"ja\""
+  end
+
+  test "english pages stay english when no locale was chosen" do
+    sign_in_as :kevin
+    get root_path
+    assert_response :success
+    assert_includes response.body, "lang=\"en\""
+    assert_includes response.body, "Search"
+  end
+
+  test "magic link email is japanese when the identity chose japanese" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    email = MagicLinkMailer.sign_in_instructions(identity.magic_links.create!(purpose: :sign_in))
+
+    assert_includes email.subject, "Fizzyのコード"
+    assert_includes email.html_part.body.decoded, "確認コード"
+  end
+end
