diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..67a398f
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,100 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+  SIGNED_ID_PURPOSE = :magic_link
+
+  belongs_to :account, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  has_secure_password :code, reset_token: false
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :expires_at, presence: true
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  before_validation :assign_code, :assign_expiration, on: :create
+
+  class << self
+    def issue(email_address:, purpose:, account: nil, join_code: nil, deliver: true)
+      magic_link = transaction do
+        normalized_email = new(email_address: email_address).email_address
+
+        where(email_address: normalized_email, purpose: purpose, account: account, join_code: join_code).delete_all
+        create!(email_address: normalized_email, purpose: purpose, account: account, join_code: join_code)
+      end
+
+      magic_link.deliver if deliver
+      magic_link
+    end
+
+    def authenticate(token, code, purpose:)
+      normalized = normalize_code(code)
+      return if token.blank? || normalized.blank?
+      return unless purpose.to_s.in?(PURPOSES)
+
+      magic_link = find_signed(token, purpose: SIGNED_ID_PURPOSE)
+      if magic_link&.active? && magic_link.purpose == purpose.to_s && magic_link.authenticate_code(normalized)
+        magic_link
+      end
+    end
+
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def normalize_code(code)
+      normalized = code.to_s.gsub(/[[:space:]]/, "").upcase
+      normalized if normalized.match?(/\A[A-Z0-9]{#{CODE_LENGTH}}\z/)
+    end
+  end
+
+  def active?
+    expires_at.future?
+  end
+
+  def deliver
+    MagicLinkMailer.authentication_code(self, code).deliver_later if code.present?
+  end
+
+  def signed_token
+    signed_id(expires_at: expires_at, purpose: SIGNED_ID_PURPOSE)
+  end
+
+  def identity
+    Identity.find_by(email_address: email_address)
+  end
+
+  def establish_identity
+    if sign_in?
+      identity
+    else
+      Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+
+  def sign_in?
+    purpose == "sign_in"
+  end
+
+  def sign_up?
+    purpose == "sign_up"
+  end
+
+  def join?
+    purpose == "join"
+  end
+
+  private
+    def assign_code
+      self.code = self.class.generate_code if code_digest.blank?
+    end
+
+    def assign_expiration
+      self.expires_at ||= EXPIRATION.from_now
+    end
+end
