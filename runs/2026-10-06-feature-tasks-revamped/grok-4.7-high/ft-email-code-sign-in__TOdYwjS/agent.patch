+require "test_helper"
+
+class Signups::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "signing up emails a code and verifying it signs the person up" do
+    untenanted do
+      email_address = "new-person@example.com"
+
+      assert_difference -> { MagicLink.count }, 1 do
+        assert_enqueued_emails 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to new_signup_magic_link_path
+
+      perform_enqueued_jobs
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+      assert_equal 6, code.length
+
+      assert_difference -> { Identity.count }, 1 do
+        post signup_magic_link_path, params: { code: code }
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+      assert_equal email_address, Identity.find_by(email_address: email_address).email_address
+    end
+  end
+
+  test "signing up with an existing email signs that person in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+
+      assert_no_difference -> { Identity.count } do
+        post signup_path, params: { signup: { email_address: identity.email_address } }
+        post signup_magic_link_path, params: { code: "ABC123" }
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "a signup code cannot be used to sign in" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+      post signup_path, params: { signup: { email_address: "another@example.com" } }
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..d929e18
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "issues a six character code that expires in fifteen minutes" do
+    magic_link = MagicLink.issue(email_address: "person@example.com", purpose: :sign_in, deliver: false)
+
+    assert_equal 6, magic_link.code.length
+    assert magic_link.code.match?(/\A[A-Z0-9]{6}\z/)
+    assert magic_link.active?
+    assert_in_delta MagicLink::EXPIRATION.from_now, magic_link.expires_at, 2.seconds
+  end
+
+  test "consume rejects an expired code" do
+    magic_link = MagicLink.issue(email_address: "person@example.com", purpose: :sign_in, deliver: false)
+    token = magic_link.signed_token
+    code = magic_link.code
+
+    travel MagicLink::EXPIRATION + 1.second do
+      assert_nil MagicLink.authenticate(token, code, purpose: :sign_in)
+      assert_not magic_link.reload.active?
+    end
+  end
+end
