diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..9a55c0d
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,68 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_magic_link_for(email_address, purpose:, account: nil, join_code: nil, deliver: true)
+      MagicLink.issue(
+        email_address: email_address,
+        purpose: purpose,
+        account: account,
+        join_code: join_code,
+        deliver: deliver
+      ).tap do |magic_link|
+        set_pending_authentication_token(magic_link)
+      end
+    end
+
+    def set_pending_authentication_token(magic_link)
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.signed_token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def pending_magic_link
+      @pending_magic_link ||= MagicLink.find_signed(
+        cookies.signed[:pending_authentication_token],
+        purpose: MagicLink::SIGNED_ID_PURPOSE
+      )
+    end
+
+    def authenticate_magic_link(purpose)
+      MagicLink.authenticate(cookies.signed[:pending_authentication_token], params[:code], purpose: purpose)
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def render_magic_link_issued(redirect_path)
+      respond_to do |format|
+        format.html { redirect_to redirect_path }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def render_magic_link_success(redirect_path)
+      clear_pending_authentication_token
+
+      respond_to do |format|
+        format.html { redirect_to redirect_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def render_magic_link_failure(redirect_path)
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to redirect_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
diff --git a/app/controllers/join_codes/magic_links_controller.rb b/app/controllers/join_codes/magic_links_controller.rb
new file mode 100644
index 0000000..58be316
