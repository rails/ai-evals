diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..b72ce4f
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "requesting a code emails it and signing in with that code starts a session" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert cookies[:pending_authentication_token].present?
+
+      perform_enqueued_jobs
+      email = ActionMailer::Base.deliveries.last
+      code = email.subject.split.first
+
+      assert_equal 6, code.length
+      assert_equal "#{code} is your Fizzy code", email.subject
+      assert_includes email.to, @identity.email_address
+
+      get new_session_magic_link_path
+      assert_response :success
+      assert_select "input[name=code]"
+
+      post session_magic_link_path, params: { code: code }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "requesting a code via JSON returns a pending authentication token" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }, as: :json
+
+      assert_response :created
+      assert response.parsed_body["pending_authentication_token"].present?
+      assert_equal cookies[:pending_authentication_token], response.parsed_body["pending_authentication_token"]
+    end
+  end
+
+  test "submitting the code via JSON returns a session token" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+
+      post session_path, params: { email_address: @identity.email_address }, as: :json
+      assert_response :created
+
+      post session_magic_link_path, params: { code: "abc123" }, as: :json
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "an invalid code is rejected" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "an invalid code via JSON is unauthorized" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }, as: :json
+      post session_magic_link_path, params: { code: "WRONG1" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "a code expires after fifteen minutes" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+      post session_path, params: { email_address: @identity.email_address }
+
+      travel MagicLink::EXPIRATION + 1.second do
+        post session_magic_link_path, params: { code: "ABC123" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code still works just before it expires" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+      post session_path, params: { email_address: @identity.email_address }
+
+      travel MagicLink::EXPIRATION - 1.second do
+        post session_magic_link_path, params: { code: "ABC123" }
+      end
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "a code cannot be reused" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: "ABC123" }
+      assert cookies[:session_token].present?
+
+      delete session_path
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "unknown email does not send a code or reveal whether the account exists" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "nobody@example.com" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "invalid email is rejected when signups are accepted" do
+    untenanted do
+      post session_path, params: { email_address: "not-an-email" }
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "code entry accepts spaces and lowercase" do
+    untenanted do
+      MagicLink.stubs(:generate_code).returns("ABC123")
+      post session_path, params: { email_address: "  #{@identity.email_address.upcase}  " }
+      post session_magic_link_path, params: { code: " abc 123 " }
+
+      assert cookies[:session_token].present?
+    end
+  end
+end
