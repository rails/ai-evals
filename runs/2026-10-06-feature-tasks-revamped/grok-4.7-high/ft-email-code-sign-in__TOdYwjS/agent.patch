+++ b/app/controllers/join_codes/magic_links_controller.rb
@@ -0,0 +1,55 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @magic_link = pending_magic_link
+  end
+
+  def create
+    magic_link = authenticate_magic_link(:join)
+
+    if magic_link && magic_link.join_code_id == @join_code.id
+      identity = magic_link.establish_identity
+      magic_link.destroy!
+      start_new_session_for identity
+      clear_pending_authentication_token
+      admit identity
+    else
+      render_magic_link_failure new_join_magic_link_path(join_code: @join_code.code)
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code = Account::JoinCode.find_by(code: params[:join_code], account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def admit(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by(account: @join_code.account, identity: identity)
+
+      if user&.setup?
+        redirect_to landing_url(script_name: @join_code.account.slug)
+      elsif user
+        redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+      else
+        redirect_to join_path(code: @join_code.code), alert: "That code is all used up."
+      end
+    end
+end
