diff --git a/test/controllers/join_codes/magic_links_controller_test.rb b/test/controllers/join_codes/magic_links_controller_test.rb
new file mode 100644
index 0000000..0ee2519
--- /dev/null
+++ b/test/controllers/join_codes/magic_links_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "joining emails a code and verifying it joins the person" do
+    email_address = "joiner@example.com"
+
+    assert_enqueued_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+    end
+
+    assert_redirected_to new_join_magic_link_path(join_code: @join_code.code, script_name: @account.slug)
+
+    perform_enqueued_jobs
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject.split.first
+
+    assert_equal "#{code} is your Fizzy code", email.subject
+    assert_includes email.body.encoded, @account.name
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+    assert_equal 1, @join_code.reload.usage_count
+  end
+
+  test "an existing identity can join with a code" do
+    identity = identities(:mike)
+    MagicLink.stubs(:generate_code).returns("ABC123")
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference -> { User.count }, 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+        post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "a member who is already set up is signed in and sent to the account" do
+    identity = identities(:kevin)
+    MagicLink.stubs(:generate_code).returns("ABC123")
+
+    assert_no_difference -> { User.count } do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: "ABC123" }
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+    assert_equal 0, @join_code.reload.usage_count
+  end
+
+  test "the code field is named code" do
+    post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "field@example.com" }
+    follow_redirect!
+
+    assert_select "input[name=code]"
+  end
+end
