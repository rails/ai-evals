diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..adc3b6b
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,146 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "explainer", "toggle", "unsupported" ]
+  static values = {
+    publicKey: String,
+    subscriptionsUrl: String,
+    subscriptions: Array
+  }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async toggle() {
+    if (this.element.classList.contains("notifications--on")) {
+      await this.#turnOff()
+    } else {
+      await this.#turnOn()
+    }
+  }
+
+  async #refresh() {
+    if (!this.#supported) {
+      this.#showUnsupported()
+      return
+    }
+
+    const subscription = await this.#browserSubscription()
+    const known = subscription && this.#knownSubscription(subscription.endpoint)
+    this.#setEnabled(Notification.permission === "granted" && known)
+
+    if (Notification.permission === "denied") {
+      this.#showBlocked()
+    }
+  }
+
+  async #turnOn() {
+    if (!this.#supported) {
+      this.#showUnsupported()
+      return
+    }
+
+    const permission = Notification.permission === "granted" ? "granted" : await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#setEnabled(false)
+      this.#showBlocked()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    }
+
+    const json = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const saved = await response.json
+      this.#remember(saved)
+      this.#setEnabled(true)
+      this.#hideBlocked()
+    }
+  }
+
+  async #turnOff() {
+    const subscription = await this.#browserSubscription()
+    const known = subscription && this.#knownSubscription(subscription.endpoint)
+
+    if (known) {
+      await destroy(`${this.subscriptionsUrlValue}/${known.id}`, { responseKind: "json" })
+      this.subscriptionsValue = this.subscriptionsValue.filter(item => item.id !== known.id)
+    }
+
+    if (subscription) {
+      await subscription.unsubscribe()
+    }
+
+    this.#setEnabled(false)
+  }
+
+  async #browserSubscription() {
+    if (!("serviceWorker" in navigator)) return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  #knownSubscription(endpoint) {
+    return this.subscriptionsValue.find(subscription => subscription.endpoint === endpoint)
+  }
+
+  #remember(subscription) {
+    const rest = this.subscriptionsValue.filter(item => item.endpoint !== subscription.endpoint)
+    this.subscriptionsValue = [ ...rest, { id: subscription.id, endpoint: subscription.endpoint } ]
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    if (this.hasToggleTarget) this.toggleTarget.setAttribute("aria-pressed", enabled)
+  }
+
+  #showBlocked() {
+    this.element.classList.add("notifications--blocked")
+    this.detailsTargets.forEach(element => element.hidden = false)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = false
+  }
+
+  #hideBlocked() {
+    this.element.classList.remove("notifications--blocked")
+    this.detailsTargets.forEach(element => element.hidden = true)
+    if (this.hasExplainerTarget) this.explainerTarget.hidden = true
+  }
+
+  #showUnsupported() {
+    if (this.hasUnsupportedTarget) this.unsupportedTarget.hidden = false
+    if (this.hasToggleTarget) this.toggleTarget.disabled = true
+  }
+
+  get #supported() {
+    return this.publicKeyValue && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+
+    return Uint8Array.from([ ...raw ].map(character => character.charCodeAt(0)))
+  }
+}
