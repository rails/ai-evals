diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..950d640
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,62 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :deliver_push_later
+    after_update_commit :deliver_push_later_on_source_change
+  end
+
+  def deliver_push_later_on_source_change
+    deliver_push_later if source_id_previously_changed?
+  end
+
+  def deliver_push_later
+    Notification::PushDeliveryJob.perform_later(self) if user.push_subscriptions.any?
+  end
+
+  def deliver_push
+    return if source.nil? || card.nil?
+
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver(self)
+    end
+  end
+
+  def push_message
+    {
+      title: push_title,
+      body: push_body,
+      path: push_path,
+      url: push_url,
+      tag: id
+    }.compact
+  end
+
+  private
+    def push_title
+      ApplicationController.helpers.notification_title(self).presence || "Fizzy"
+    end
+
+    def push_body
+      ApplicationController.helpers.notification_body(self).to_s
+    end
+
+    def push_path
+      routes.card_path(card, script_name: account.slug)
+    end
+
+    def push_url
+      return unless url_options.present?
+
+      routes.card_url(card, url_options.merge(script_name: account.slug))
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+
+    def routes
+      Rails.application.routes.url_helpers
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..a98d27b
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,60 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user&.account }
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it.to_s.strip }
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true, length: { maximum: 4096 }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+
+  before_validation :assign_account
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_options
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def vapid_subject
+      ENV["VAPID_SUBJECT"].presence || ENV["BASE_URL"].presence || "mailto:support@fizzy.do"
+    end
+  end
+
+  def deliver(notification)
+    return unless self.class.configured?
+
+    WebPush.payload_send(
+      message: notification.push_message.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid_options,
+      ssl_timeout: 5,
+      open_timeout: 5,
+      read_timeout: 5
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def assign_account
+      self.account = user.account if user
+    end
+end
