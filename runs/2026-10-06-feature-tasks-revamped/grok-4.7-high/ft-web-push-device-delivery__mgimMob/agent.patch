diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..1a28b10 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,60 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  const data = readPushData(event)
+  const title = data.title || "Fizzy"
+  const url = notificationUrl(data)
+
+  event.waitUntil(self.registration.showNotification(title, {
+    body: data.body || "",
+    icon: data.icon || "/app-icon-192.png",
+    tag: data.tag,
+    data: { url, path: data.path }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url
+  if (!url) return
+
+  event.waitUntil(openCard(url))
+})
+
+function readPushData(event) {
+  if (!event.data) return {}
+
+  try {
+    return event.data.json()
+  } catch (error) {
+    return { title: "Fizzy", body: event.data.text() }
+  }
+}
+
+function notificationUrl(data) {
+  const candidate = data.path || data.url || "/"
+  const url = new URL(candidate, self.location.origin)
+
+  if (url.origin !== self.location.origin && data.path) {
+    return new URL(data.path, self.location.origin).href
+  }
+
+  return url.href
+}
+
+async function openCard(url) {
+  const windowClients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of windowClients) {
+    if (client.url === url && "focus" in client) {
+      return client.focus()
+    }
+  }
+
+  if (self.clients.openWindow) {
+    return self.clients.openWindow(url)
+  }
+}
