diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..10aeb14
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create stores the browser subscription for this device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.test/device", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+
+    body = @response.parsed_body
+    assert_equal subscription.id, body["id"]
+    assert_equal subscription.endpoint, body["endpoint"]
+    assert_equal user_push_subscription_path(@user, subscription), body["url"]
+  end
+
+  test "create updates an existing endpoint instead of duplicating it" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/device", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "p256dh-key", subscription.reload.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create moves an endpoint claimed by another user to the current user" do
+    other = users(:kevin)
+    subscription = other.push_subscriptions.create!(endpoint: "https://push.example.test/device", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :ok
+    assert_equal @user, subscription.reload.user
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create is forbidden for another user" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the current device subscription" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/device", p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for another user" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.test/kevin", p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    delete user_push_subscription_path(users(:kevin), subscription), as: :json
+
+    assert_response :forbidden
+    assert PushSubscription.exists?(subscription.id)
+  end
+
+
+test "create accepts form-encoded push_subscription params" do
+  assert_difference -> { @user.push_subscriptions.count }, 1 do
+    post user_push_subscriptions_path(@user), params: subscription_params
+  end
+
+  assert_redirected_to notifications_settings_path
+  assert_equal "auth-key", @user.push_subscriptions.last.auth_key
+end
+
+test "create rejects a subscription missing keys" do
+  assert_no_difference -> { PushSubscription.count } do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.test/incomplete", p256dh_key: "", auth_key: "" } }, as: :json
+  end
+
+  assert_response :unprocessable_entity
+end
+  private
+    def subscription_params
+      {
+        push_subscription: {
+          endpoint: "https://push.example.test/device",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+end
diff --git a/test/models/notification_push_test.rb b/test/models/notification_push_test.rb
new file mode 100644
index 0000000..1079fe4
--- /dev/null
+++ b/test/models/notification_push_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class NotificationPushTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:layout_commented_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    ENV["VAPID_PUBLIC_KEY"] = "public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-key"
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = nil
+    ENV["VAPID_PRIVATE_KEY"] = nil
+  end
+
+  test "a new tray notification is pushed to the user devices" do
+    @notification.destroy
+
+    assert_enqueued_with(job: Notification::PushDeliveryJob) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "updating the tray source pushes again" do
+    other_event = events(:layout_published)
+
+    assert_enqueued_with(job: Notification::PushDeliveryJob) do
+      @notification.update!(source: other_event, creator: users(:david), read_at: nil)
+    end
+  end
+
+  test "marking a notification read does not push" do
+    assert_no_enqueued_jobs only: Notification::PushDeliveryJob do
+      @notification.read
+    end
+  end
+
+  test "deliver_push sends the tray copy for mentions too" do
+    notification = notifications(:logo_mentioned_david)
+    notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/david",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    sent = []
+    WebPush.stubs(:payload_send).with { |options| sent << options; true }
+
+    notification.deliver_push
+
+    message = JSON.parse(sent.last[:message])
+    assert_equal "JZ @mentioned you", message["title"]
+    assert_includes message["url"], "/cards/#{notification.card.number}"
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..dc56cc4
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.test/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    @original_env = {
+      "VAPID_PUBLIC_KEY" => ENV["VAPID_PUBLIC_KEY"],
+      "VAPID_PRIVATE_KEY" => ENV["VAPID_PRIVATE_KEY"]
+    }
+    ENV["VAPID_PUBLIC_KEY"] = "public-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-key"
+  end
+
+  teardown do
+    @original_env.each { |key, value| ENV[key] = value }
+  end
+
+  test "deliver sends what the tray says and a url that opens the card" do
+    sent = nil
+    WebPush.expects(:payload_send).with { |options| sent = options; true }
+
+    @subscription.deliver(@notification)
+
+    message = JSON.parse(sent[:message])
+    assert_equal ApplicationController.helpers.notification_title(@notification), message["title"]
+    assert_equal ApplicationController.helpers.notification_body(@notification), message["body"]
+    assert_equal @notification.push_message[:path], message["path"]
+    assert_includes message["path"], "/cards/#{@notification.card.number}"
+    assert_includes message["url"], "/cards/#{@notification.card.number}"
+    assert_equal @subscription.endpoint, sent[:endpoint]
+    assert_equal @subscription.p256dh_key, sent[:p256dh]
+    assert_equal @subscription.auth_key, sent[:auth]
+    assert_equal "public-key", sent.dig(:vapid, :public_key)
+    assert_equal "private-key", sent.dig(:vapid, :private_key)
+  end
+
+  test "deliver removes subscriptions the push service has expired" do
+    response = stub(body: "gone", inspect: "410 Gone")
+    WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver does nothing when vapid keys are missing" do
+    ENV["VAPID_PUBLIC_KEY"] = nil
+    ENV["VAPID_PRIVATE_KEY"] = nil
+    WebPush.expects(:payload_send).never
+
+    @subscription.deliver(@notification)
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+end
