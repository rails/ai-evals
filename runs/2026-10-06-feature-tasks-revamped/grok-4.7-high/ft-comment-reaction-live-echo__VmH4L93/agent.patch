+require "test_helper"
+
+class Cards::CommentReactionsRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+    @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    @comment.reactions.create!(content: "Ship it", reacter: users(:david))
+  end
+
+  test "each comment renders a reactions strip" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}" do
+      assert_select ".reactions__list .reaction", 2
+      assert_select ".reaction--deleteable", 0
