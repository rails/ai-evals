@@ -0,0 +1,48 @@
+<div id="<%= dom_id(comment, :reaction_composer) %>">
+  <button type="button" class="btn btn--circle reactions__trigger" data-reactions-target="trigger"
+          data-action="reactions#showForm" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment),
+        class: "reaction__form",
+        html: { hidden: true },
+        data: { reactions_target: "form", turbo_frame: "_top",
+                action: "submit->reactions#guard turbo:submit-end->reactions#submitted keydown.esc->reactions#hideForm:stop" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label flex-item-grow" do %>
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, class: "input reaction__input", maxlength: 16, required: true,
+            autocomplete: "off", autocapitalize: "off", placeholder: "React",
+            data: { reactions_target: "input", action: "keydown.esc->reactions#hideForm:stop" } %>
+    <% end %>
+
+    <div class="reaction__menu">
+      <button type="button" class="btn reaction__menu-btn borderless" data-reactions-target="emojiButton"
+              data-action="reactions#toggleEmoji" aria-label="Insert emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Insert emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-reactions-target="popup">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn" data-action="reactions#pickEmoji" data-emoji="<%= emoji %>" aria-label="<%= name %>">
+              <%= emoji %>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "btn reaction__submit-btn borderless", aria: { label: "Confirm" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm</span>
+    <% end %>
+
+    <button type="button" class="btn reaction__cancel-btn borderless" data-action="reactions#hideForm" aria-label="Cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
