@@ -0,0 +1,113 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding and removing a reaction" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Ship it"
+      click_on "Confirm"
+
+      assert_selector ".reaction", text: "Ship it"
+      assert_no_selector "form.reaction__form", visible: :visible
+      assert_button "Add a reaction"
+    end
+
+    within_comment do
+      find(".reaction", text: "Ship it").click
+      click_on "Remove reaction"
+      assert_no_selector ".reaction", text: "Ship it"
+    end
+  end
+
+  test "emoji reactions are limited to 16 characters" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      field = find_field("Your reaction")
+      assert_equal "16", field["maxlength"]
+      field.set("12345678901234567")
+      assert_equal "1234567890123456", field.value
+    end
+  end
+
+  test "other viewers see reactions land without reloading" do
+    sign_in_as(users(:david))
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all, wait: 5
+
+    using_session(:kevin) do
+      sign_in_as(users(:kevin))
+      visit card_url(@card)
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all, wait: 5
+
+      within_comment do
+        click_on "Add a reaction"
+        fill_in "Your reaction", with: "Live"
+        click_on "Confirm"
+        assert_selector ".reaction", text: "Live"
+      end
+    end
+
+    within_comment do
+      assert_selector ".reaction", text: "Live", wait: 5
+    end
+
+    using_session(:kevin) do
+      within_comment do
+        find(".reaction", text: "Live").click
+        click_on "Remove reaction"
+        assert_no_selector ".reaction", text: "Live"
+      end
+    end
+
+    within_comment do
+      assert_no_selector ".reaction", text: "Live", wait: 5
+    end
+  end
+
+  test "cancel puts the add button back without saving" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nope"
+      click_on "Cancel"
+
+      assert_no_selector "form.reaction__form", visible: :visible
+      assert_button "Add a reaction"
+      assert_no_text "Nope"
+    end
+  end
+
+  test "picking an emoji fills the reaction input" do
+    sign_in_as(users(:kevin))
+    visit card_url(@card)
+
+    within_comment do
+      click_on "Add a reaction"
+      click_on "Insert emoji"
+      find(%(button[aria-label='Thumbs up'])).click
+      assert_field "Your reaction", with: "👍"
+      click_on "Confirm"
+      assert_selector ".reaction .txt-small.txt-medium", text: "👍"
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+end
