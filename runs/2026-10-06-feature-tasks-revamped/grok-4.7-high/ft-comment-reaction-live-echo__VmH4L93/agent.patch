+require "test_helper"
+
+class Cards::Comments::ReactionBroadcastHtmlTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "broadcast reaction markup includes who reacted and a removable control" do
+    payloads = capture_turbo_stream_broadcasts(@card) do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice" } }, as: :turbo_stream
+    end
+
+    html = payloads.map(&:to_html).join
+    assert_includes html, "Nice"
+    assert_includes html, users(:kevin).name
+    assert_includes html, "Remove reaction"
+    assert_match %r{/#{accounts("37s").external_account_id}/cards/#{@card.number}/comments/#{@comment.id}/reactions/}, html
+    assert_match %r{target="#{dom_id(@comment, :reactions_list)}"}, html
+  end
+end
diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..227a651
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create adds a reaction to the strip" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions_list)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reaction_composer)
+    assert_equal "Nice", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create broadcasts the updated strip to people watching the card" do
+    assert_turbo_stream_broadcasts @card, count: 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create rejects reactions longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = @comment.reactions.last
+    body = @response.parsed_body
+    assert_equal reaction.id, body["id"]
+    assert_equal "Great 👍", body["content"]
+    assert_equal users(:kevin).id, body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), body["url"]
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Flat" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat", @comment.reactions.last.content
+  end
+
+  test "index as JSON" do
+    reaction = @comment.reactions.create!(content: "👀", reacter: users(:kevin))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_equal 1, body.size
+    assert_equal reaction.id, body.first["id"]
+    assert_equal "👀", body.first["content"]
+  end
+
+  test "destroy removes your reaction and tells other viewers" do
+    reaction = @comment.reactions.create!(content: "Nice", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      assert_turbo_stream_broadcasts @card, count: 1 do
+        delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      end
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "Nice", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "cannot remove someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comment JSON includes reactions url" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+
+  test "repeating the same reaction does not duplicate it" do
+    @comment.reactions.create!(content: "Nice", reacter: users(:kevin))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "  Nice  " } }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "Nice", @response.parsed_body["content"]
+  end
+
+  test "blank reactions are rejected" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
