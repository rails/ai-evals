diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..84f2bd5
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+  scope :preloaded, -> { includes(:reacter) }
+
+  before_validation :normalize_content
+
+  def emoji_only?
+    content.present? && content.match?(/\A[\p{Extended_Pictographic}\u{FE0F}\u{200D}]+\z/)
+  end
+
+  def broadcast_removal
+    broadcast_remove_to comment.card
+  end
+
+  private
+    def normalize_content
+      self.content = content.to_s.strip
+    end
+end
