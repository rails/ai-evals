diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..1629dd8
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,82 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  wrap_parameters :reaction, include: %i[ content ]
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+    fresh_when @reactions
+  end
+
+  def create
+    @reaction = find_or_create_reaction
+
+    if @reaction.persisted?
+      publish_reaction_list
+
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to @card }
+        format.json { render :show, status: create_status, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.html { redirect_to @card, alert: @reaction.errors.full_messages.to_sentence }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    @reaction.broadcast_removal
+    @comment.bust_fragment_cache
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def find_or_create_reaction
+      content = reaction_params[:content].to_s.strip
+      existing = @comment.reactions.find_by(reacter: Current.user, content: content)
+      return existing if existing
+
+      @comment.reactions.create(content: content)
+    rescue ActiveRecord::RecordNotUnique
+      @comment.reactions.find_by!(reacter: Current.user, content: content)
+    end
+
+    def publish_reaction_list
+      @comment.bust_fragment_cache
+      @comment.broadcast_reactions_list
+    end
+
+    def create_status
+      @reaction.previously_new_record? ? :created : :ok
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
