+      assert_select ".reaction", text: /David|Kevin/
+      assert_select "button.reactions__trigger[aria-label='Add a reaction']"
+      assert_select "img[src*='boost-color']"
+      assert_select "form.reaction__form[hidden] input.reaction__input[maxlength='16']"
+      assert_select "button[aria-label='Confirm']"
+      assert_select "button[aria-label='Cancel']"
+      assert_select ".reaction__emoji-list button", EmojiHelper::REACTIONS.size
+    end
+  end
+end
