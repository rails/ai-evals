+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    this.#refreshCsrf()
+
+    if (this.element.dataset.reacterId === window.Current?.user?.id) {
+      this.element.classList.add("reaction--deleteable")
+    } else {
+      this.element.querySelector(".reaction__delete")?.remove()
+    }
+  }
+
+  toggle(event) {
+    if (!this.element.classList.contains("reaction--deleteable")) return
+    if (event.target.closest("form, button, a")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  #refreshCsrf() {
+    const token = document.querySelector("meta[name='csrf-token']")?.content
+    const input = this.element.querySelector("input[name='authenticity_token']")
+    if (token && input) input.value = token
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..c9a47ec
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,103 @@
+import { Controller } from "@hotwired/stimulus"
+import { orient } from "helpers/orientation_helpers"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "popup", "emojiButton" ]
+
+  connect() {
+    this.#refreshCsrf(this.element)
+  }
+
+  formTargetConnected(element) {
+    this.#refreshCsrf(element)
+  }
+
+  showForm(event) {
+    event?.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm(event) {
+    event?.preventDefault()
+    this.#closeEmoji()
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  guard(event) {
+    if (this.inputTarget.value.trim().length === 0) {
+      event.preventDefault()
+      this.inputTarget.focus()
+    }
+  }
+
+  submitted(event) {
+    if (!event.detail.success) {
+      this.inputTarget.focus()
+    }
+  }
+
+  toggleEmoji(event) {
+    event.preventDefault()
+    event.stopPropagation()
+
+    if (this.popupTarget.open) {
+      this.popupTarget.close()
+      orient({ target: this.popupTarget, reset: true })
+    } else {
+      this.#openEmojiPicker()
+    }
+  }
+
+  pickEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+    const max = input.maxLength > 0 ? input.maxLength : 16
+
+    if ((input.value + emoji).length <= max) {
+      input.value += emoji
+    }
+
+    input.focus()
+    this.#closeEmoji()
+  }
+
+  closeEmojiOnClickOutside(event) {
+    if (!this.hasPopupTarget || !this.popupTarget.open) return
+    if (this.popupTarget.contains(event.target)) return
+    if (this.hasEmojiButtonTarget && this.emojiButtonTarget.contains(event.target)) return
+
+    this.#closeEmoji()
+  }
+
+  #openEmojiPicker() {
+    const popup = this.popupTarget
+    popup.style.position = "absolute"
+    popup.style.inset = "auto auto auto 0px"
+    popup.style.inlineSize = "max-content"
+    popup.style.maxInlineSize = "calc(100vw - 1rem)"
+    popup.style.translate = "none"
+    popup.show()
+    orient({ target: popup, anchor: this.emojiButtonTarget })
+    popup.style.translate = "none"
+  }
+
+  #closeEmoji() {
+    if (this.hasPopupTarget && this.popupTarget.open) this.popupTarget.close()
+  }
+
+  #refreshCsrf(root) {
+    const token = document.querySelector("meta[name='csrf-token']")?.content
+    if (!token) return
+
+    root.querySelectorAll("input[name='authenticity_token']").forEach((input) => {
+      input.value = token
+    })
+  }
+}
