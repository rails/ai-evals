diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..184a3f2
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,16 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:created_at, :id)
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      count = @notifications.size
+      "#{count} new #{"notification".pluralize(count)} on #{@user.account.name}"
+    end
+end
