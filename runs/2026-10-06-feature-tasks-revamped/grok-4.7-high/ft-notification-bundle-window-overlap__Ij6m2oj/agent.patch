diff --git a/app/views/mailers/notification_mailer/digest.html.erb b/app/views/mailers/notification_mailer/digest.html.erb
new file mode 100644
index 0000000..9ad5380
--- /dev/null
+++ b/app/views/mailers/notification_mailer/digest.html.erb
@@ -0,0 +1,38 @@
+<h1 class="title"><%= @notifications.size %> new <%= "notification".pluralize(@notifications.size) %></h1>
+<p class="subtitle">On <%= @user.account.name %>, since <%= @bundle.starts_at.to_fs(:long) %>.</p>
+
+<% @notifications_by_board.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <table>
+        <tr>
+          <td class="avatar__container">
+            <%= mail_avatar_tag(notification.creator) %>
+          </td>
+          <td>
+            <p class="notification__author"><%= notification.creator.name %></p>
+            <p class="card__title"><%= link_to notification.card.title.presence || "Card #{notification.card.number}", notification.payload.url %></p>
+            <p class="notification__details">
+              <% if notification.source.is_a?(Mention) %>
+                <span class="notificaton__mention"><%= notification.payload.body %></span>
+              <% else %>
+                <%= notification.payload.body %>
+              <% end %>
+            </p>
+          </td>
+        </tr>
+      </table>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  You're receiving these in a <%= @user.settings.bundle_email_frequency_label %> digest.
+  <%= link_to "Change email digest settings", notifications_settings_url %>.
+</p>
