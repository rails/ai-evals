diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..f1435d1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatLocalTimeTitle, parseLocalTimeValue } from "helpers/local_time"
+
+const REFRESH_INTERVAL = 60_000
+
+// Renders a <time datetime="..."> sent by the server into words in the viewer's timezone.
+export default class extends Controller {
+  static values = { type: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const raw = this.element.getAttribute("datetime")
+    const date = parseLocalTimeValue(raw)
+    if (!date) return
+
+    const text = formatLocalTime(date, this.typeValue)
+    if (text && this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+
+    const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(raw || "")
+    const title = formatLocalTimeTitle(date, { dateOnly })
+    if (this.element.getAttribute("title") !== title) {
+      this.element.setAttribute("title", title)
+    }
+
+    this.#syncBridgeDescription(text)
+  }
+
+  #syncBridgeDescription(text) {
+    if (!this.element.hasAttribute("data-local-time-bridge")) return
+
+    const bridge = this.element.closest("[data-bridge-description]")
+    if (bridge && bridge.getAttribute("data-bridge-description") !== text) {
+      bridge.setAttribute("data-bridge-description", text)
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..1172fba
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,169 @@
+// Turn a raw timestamp into words in the viewer's timezone.
+//
+// relative:  "1:42 PM" today, "yesterday" / "tomorrow", "5 days ago" / "in 3 days"
+//            within a week, otherwise "Sep 12".
+// time-ago:  "2 hours ago", "yesterday", "5 days ago", "in 3 days".
+// time, date, full-date, weekday-date, numeric-datetime: absolute formats.
+
+const RELATIVE_DAY_WINDOW = 7
+
+export function parseLocalTimeValue(value) {
+  if (!value) return null
+
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  const date = new Date(value)
+  return Number.isNaN(date.getTime()) ? null : date
+}
+
+export function formatLocalTime(date, type = "relative", now = new Date()) {
+  if (!(date instanceof Date) || Number.isNaN(date.getTime())) return ""
+
+  switch (type) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date, now)
+    case "full-date":
+      return formatFullDate(date)
+    case "weekday-date":
+      return formatWeekdayDate(date)
+    case "numeric-datetime":
+      return formatNumericDatetime(date)
+    case "time-ago":
+      return formatTimeAgo(date, now)
+    case "relative":
+      return formatRelative(date, now)
+    default:
+      return formatRelative(date, now)
+  }
+}
+
+export function formatLocalTimeTitle(date, { dateOnly = false } = {}) {
+  const options = {
+    weekday: "long",
+    month: "long",
+    day: "numeric",
+    year: "numeric"
+  }
+
+  if (!dateOnly) {
+    options.hour = "numeric"
+    options.minute = "2-digit"
+    options.hour12 = true
+  }
+
+  return normalize(new Intl.DateTimeFormat("en-US", options).format(date))
+}
+
+function formatRelative(date, now) {
+  const dayDiff = calendarDaysBetween(now, date)
+
+  if (dayDiff === 0) {
+    return date.getTime() > now.getTime() ? "today" : formatTime(date)
+  }
+  if (dayDiff === -1) return "yesterday"
+  if (dayDiff === 1) return "tomorrow"
+  if (dayDiff < -1 && dayDiff >= -RELATIVE_DAY_WINDOW) return `${Math.abs(dayDiff)} days ago`
+  if (dayDiff > 1) return `in ${dayDiff} days`
+
+  return formatDate(date, now)
+}
+
+function formatTimeAgo(date, now) {
+  const dayDiff = calendarDaysBetween(now, date)
+
+  if (dayDiff === -1) return "yesterday"
+  if (dayDiff === 1) return "tomorrow"
+
+  if (dayDiff <= -2 || dayDiff >= 2) {
+    const phrase = distancePhrase(Math.abs(dayDiff))
+    return dayDiff < 0 ? `${phrase} ago` : `in ${phrase}`
+  }
+
+  const seconds = Math.round((date.getTime() - now.getTime()) / 1000)
+  const future = seconds > 0
+  const elapsed = Math.abs(seconds)
+
+  if (elapsed < 45) return "just now"
+
+  const phrase = elapsedPhrase(elapsed)
+  return future ? `in ${phrase}` : `${phrase} ago`
+}
+
+function distancePhrase(days) {
+  if (days < 30) return pluralize(days, "day")
+  if (days < 365) return pluralize(Math.max(1, Math.round(days / 30)), "month")
+  return pluralize(Math.max(1, Math.round(days / 365)), "year")
+}
+
+function elapsedPhrase(seconds) {
+  const minutes = Math.round(seconds / 60)
+  const hours = Math.round(seconds / 3600)
+
+  if (seconds < 90) return "1 minute"
+  if (minutes < 45) return pluralize(minutes, "minute")
+  if (minutes < 90) return "1 hour"
+  return pluralize(Math.max(hours, 1), "hour")
+}
+
+function pluralize(count, singular) {
+  return `${count} ${count === 1 ? singular : `${singular}s`}`
+}
+
+function formatTime(date) {
+  return normalize(new Intl.DateTimeFormat("en-US", {
+    hour: "numeric",
+    minute: "2-digit",
+    hour12: true
+  }).format(date))
+}
+
+function formatDate(date, now) {
+  const options = { month: "short", day: "numeric" }
+  if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+  return normalize(new Intl.DateTimeFormat("en-US", options).format(date))
+}
+
+function formatFullDate(date) {
+  return normalize(new Intl.DateTimeFormat("en-US", {
+    month: "short",
+    day: "2-digit",
+    year: "numeric"
+  }).format(date))
+}
+
+function formatWeekdayDate(date) {
+  return normalize(new Intl.DateTimeFormat("en-US", {
+    weekday: "long",
+    month: "long",
+    day: "numeric"
+  }).format(date))
+}
+
+function formatNumericDatetime(date) {
+  const day = normalize(new Intl.DateTimeFormat("en-US", {
+    month: "numeric",
+    day: "numeric",
+    year: "2-digit"
+  }).format(date))
+
+  return `${day}, ${formatTime(date)}`
+}
+
+function calendarDaysBetween(fromDate, toDate) {
+  const from = startOfLocalDay(fromDate)
+  const to = startOfLocalDay(toDate)
+  return Math.round((to - from) / 86_400_000)
+}
+
+function startOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function normalize(text) {
+  return text.replace(/[\u202f\u00a0]/g, " ")
+}
