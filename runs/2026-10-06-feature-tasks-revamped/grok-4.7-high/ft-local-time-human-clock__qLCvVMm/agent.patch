diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..340a125 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,52 @@
 module TimeHelper
+  # Emits a raw timestamp for the browser to render in the viewer's timezone.
+  # The markup is identical for every viewer, so fragment caches can be shared.
+  def local_time(time, type: :time, **attributes)
+    local_time_tag(time, type: type, **attributes)
+  end
+
+  def local_date(time, **attributes)
+    local_time_tag(time, type: :date, **attributes)
+  end
+
+  def local_full_date(time, **attributes)
+    local_time_tag(time, type: :full_date, **attributes)
+  end
+
+  def local_weekday_date(time, **attributes)
+    local_time_tag(time, type: :weekday_date, date_only: true, **attributes)
+  end
+
+  def local_numeric_datetime(time, **attributes)
+    local_time_tag(time, type: :numeric_datetime, **attributes)
+  end
+
+  def local_relative_time(time, **attributes)
+    local_time_tag(time, type: :relative, **attributes)
+  end
+
+  def local_time_ago(time, **attributes)
+    local_time_tag(time, type: :time_ago, **attributes)
+  end
+
+  # Placeholder embedded in native share text and replaced in the browser.
+  def local_time_placeholder(time)
+    "[time:#{time.utc.iso8601}]" if time.present?
+  end
+
+  private
+    def local_time_tag(time, type:, date_only: false, bridge: false, **attributes)
+      return if time.blank?
+
+      datetime = date_only ? time.in_time_zone.to_date.iso8601 : time.utc.iso8601
+      data = (attributes.delete(:data) || {}).dup
+      data[:controller] = token_list("local-time", data[:controller])
+      data[:local_time_type_value] = type.to_s.tr("_", "-")
+      data[:action] = token_list("turbo:morph-element->local-time#render:self", data[:action])
+      data[:local_time_bridge] = true if bridge
+
+      attributes[:class] = token_list("local-time-value", attributes[:class])
+
+      tag.time datetime, datetime: datetime, data: data, **attributes
+    end
 end
