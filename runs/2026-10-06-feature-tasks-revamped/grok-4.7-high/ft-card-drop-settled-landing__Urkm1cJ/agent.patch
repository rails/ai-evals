diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..75e98fd
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,321 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const DESKTOP_QUERY = "(min-width: 640px)"
+
+// Move a card between columns or statuses. Columns keep their own order, so a
+// drop never reorders within a column — the card takes its place in the
+// destination's order immediately. The save is a JSON request (no turbo stream)
+// so the board stays exactly where you left it.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  #mediaQuery
+  #token = 0
+  #onMediaChange
+
+  initialize() {
+    this.#mediaQuery = window.matchMedia(DESKTOP_QUERY)
+  }
+
+  connect() {
+    this.#onMediaChange = () => this.#syncDraggable()
+    this.#mediaQuery.addEventListener("change", this.#onMediaChange)
+    this.#syncDraggable()
+  }
+
+  disconnect() {
+    this.#mediaQuery.removeEventListener("change", this.#onMediaChange)
+    this.#clearDragStyles()
+  }
+
+  itemTargetConnected(card) {
+    this.#enableDragging(card)
+  }
+
+  start(event) {
+    const card = event.target.closest("[data-drag-and-drop-target='item']")
+    if (!card || !this.element.contains(card)) return
+
+    if (!this.#enabled) {
+      event.preventDefault()
+      return
+    }
+
+    const container = card.closest("[data-drag-and-drop-target='container']")
+    if (!container) return
+
+    this.draggedCard = card
+    this.sourceContainer = container
+    card.classList.add(DRAGGED_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+      const offsetX = event.offsetX || card.offsetWidth / 2
+      const offsetY = event.offsetY || card.offsetHeight / 2
+      try {
+        event.dataTransfer.setDragImage(card, offsetX, offsetY)
+      } catch {
+        // Synthetic or cross-browser drags may reject a custom image.
+      }
+    }
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const container = this.#containerFrom(event.target)
+    if (!container || container === this.sourceContainer) {
+      this.#clearHover()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "none"
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(container)
+    this.#autoscroll(event)
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const container = this.#containerFrom(event.target)
+    this.#clearDragStyles()
+
+    if (!card || !container || container === this.sourceContainer) return
+    if (!container.dataset.dragAndDropPlace) return
+
+    event.preventDefault()
+
+    const snapshot = this.#snapshot(card, this.sourceContainer, container)
+    this.#relocate(card, container)
+    this.#persist(card, container, snapshot)
+  }
+
+  end() {
+    this.#clearDragStyles()
+    this.draggedCard = null
+    this.sourceContainer = null
+  }
+
+  // Private
+
+  get #enabled() {
+    return this.#mediaQuery.matches
+  }
+
+  #syncDraggable() {
+    this.itemTargets.forEach(card => this.#enableDragging(card))
+  }
+
+  #enableDragging(card) {
+    const enabled = this.#enabled
+    card.draggable = enabled
+    const link = card.querySelector(".card__link")
+    if (link) link.draggable = enabled
+  }
+
+  #containerFrom(node) {
+    if (!(node instanceof Element)) return null
+    return node.closest("[data-drag-and-drop-target='container']")
+  }
+
+  #highlight(container) {
+    if (this.hoveredContainer === container) return
+    this.#clearHover()
+    this.hoveredContainer = container
+    container.classList.add(HOVER_CLASS)
+  }
+
+  #clearHover() {
+    this.hoveredContainer?.classList.remove(HOVER_CLASS)
+    this.hoveredContainer = null
+  }
+
+  #clearDragStyles() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.#clearHover()
+  }
+
+  #autoscroll(event) {
+    const rect = this.element.getBoundingClientRect()
+    const edge = 56
+    const speed = 22
+
+    if (event.clientX < rect.left + edge) {
+      this.element.scrollLeft -= speed
+    } else if (event.clientX > rect.right - edge) {
+      this.element.scrollLeft += speed
+    }
+  }
+
+  #relocate(card, container) {
+    this.#insertCard(card, container)
+    this.#syncAppearance(card, container)
+    this.#adjustCount(this.sourceContainer, -1)
+    this.#adjustCount(container, 1)
+    this.#ensureEmptyState(this.sourceContainer)
+    this.#keepCardThroughFrameLoad(card, container)
+  }
+
+  #insertCard(card, container) {
+    const list = this.#listFor(container)
+    const goldenFirst = container.dataset.dragAndDropOrder === "golden-first"
+    const others = [ ...list.querySelectorAll(".card") ].filter(other => other !== card)
+    const before = this.#cardBefore(card, others, goldenFirst)
+
+    if (before) {
+      before.parentElement.insertBefore(card, before)
+    } else if (others.length > 0 && goldenFirst && !card.classList.contains("golden-effect")) {
+      const last = others[others.length - 1]
+      last.parentElement.insertBefore(card, last.nextSibling)
+    } else {
+      const parent = list.querySelector("turbo-frame") || list
+      const anchor = parent.querySelector(":scope > .pagination-link, :scope > .blank-slate")
+      parent.insertBefore(card, anchor)
+    }
+
+    list.scrollTop = 0
+  }
+
+  // Golden cards stay ahead of the rest. Everyone else joins at the front of
+  // the non-golden cards, which is where a just-moved card lands in column order.
+  #cardBefore(card, others, goldenFirst) {
+    if (!goldenFirst || card.classList.contains("golden-effect")) {
+      return others[0] || null
+    }
+
+    return others.find(other => !other.classList.contains("golden-effect")) || null
+  }
+
+  #listFor(container) {
+    const existing = container.querySelector(".cards__list")
+    if (existing) return existing
+
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    const frame = container.querySelector("turbo-frame")
+    const parent = frame || container.querySelector(".cards__transition-container") || container
+    parent.appendChild(list)
+    return list
+  }
+
+  #syncAppearance(card, container) {
+    const place = container.dataset.dragAndDropPlace
+    const columnPlace = place !== "not_now" && place !== "maybe" && place !== "done"
+
+    card.classList.toggle("card--postponed", place === "not_now")
+    card.classList.toggle("card--active", place === "maybe" || columnPlace)
+
+    const color = container.dataset.dragAndDropCardColor
+    if (color) card.style.setProperty("--card-color", color)
+
+    if (place !== "done") {
+      card.querySelectorAll(".card__closed").forEach(node => node.remove())
+    }
+  }
+
+  #adjustCount(container, delta) {
+    const count = container?.querySelector(".cards__expander-count")
+    if (!count) return
+
+    const text = count.textContent.trim()
+    if (text === "99+") return
+
+    const value = Number.parseInt(text, 10)
+    if (Number.isNaN(value)) return
+
+    const next = value + delta
+    count.textContent = next > 99 ? "99+" : String(Math.max(next, 0))
+  }
+
+  #ensureEmptyState(container) {
+    const list = container?.querySelector(".cards__list")
+    if (!list || list.querySelector(".card") || list.querySelector(".blank-slate")) return
+
+    list.insertAdjacentHTML("beforeend", `
+      <div class="blank-slate blank-slate--default">No cards here</div>
+      <div class="blank-slate blank-slate--drag overflow-ellipsis">Drag cards here</div>
+    `)
+  }
+
+  #keepCardThroughFrameLoad(card, container) {
+    const frame = container.querySelector("turbo-frame")
+    if (!frame || frame.hasAttribute("complete")) return
+
+    frame.addEventListener("turbo:frame-load", () => {
+      if (!container.contains(card) && !container.querySelector(`#${CSS.escape(card.id)}`)) {
+        this.#insertCard(card, container)
+        this.#syncAppearance(card, container)
+      }
+    }, { once: true })
+  }
+
+  #snapshot(card, source, destination) {
+    return {
+      parent: card.parentElement,
+      nextSibling: card.nextElementSibling,
+      className: card.className,
+      style: card.getAttribute("style"),
+      stamps: [ ...card.querySelectorAll(".card__closed") ],
+      source,
+      destination,
+      sourceCount: source?.querySelector(".cards__expander-count")?.textContent,
+      destinationCount: destination?.querySelector(".cards__expander-count")?.textContent
+    }
+  }
+
+  #revert(card, snapshot) {
+    card.className = snapshot.className
+    if (snapshot.style == null) {
+      card.removeAttribute("style")
+    } else {
+      card.setAttribute("style", snapshot.style)
+    }
+
+    snapshot.stamps.forEach(stamp => {
+      if (!stamp.isConnected) card.appendChild(stamp)
+    })
+
+    if (snapshot.parent?.isConnected) {
+      snapshot.parent.insertBefore(card, snapshot.nextSibling)
+    }
+
+    const sourceCount = snapshot.source?.querySelector(".cards__expander-count")
+    const destinationCount = snapshot.destination?.querySelector(".cards__expander-count")
+    if (sourceCount && snapshot.sourceCount != null) sourceCount.textContent = snapshot.sourceCount
+    if (destinationCount && snapshot.destinationCount != null) destinationCount.textContent = snapshot.destinationCount
+  }
+
+  async #persist(card, container, snapshot) {
+    const token = String(++this.#token)
+    card.dataset.dragAndDropToken = token
+
+    try {
+      const response = await this.#request(card, container)
+      if (card.dataset.dragAndDropToken !== token) return
+      if (!response.ok) this.#revert(card, snapshot)
+    } catch {
+      if (card.dataset.dragAndDropToken === token) this.#revert(card, snapshot)
+    }
+  }
+
+  #request(card, container) {
+    const place = container.dataset.dragAndDropPlace
+    const options = { responseKind: "json", keepalive: true }
+
+    switch (place) {
+      case "not_now":
+        return post(card.dataset.dragAndDropNotNowUrl, options)
+      case "maybe":
+        return destroy(card.dataset.dragAndDropTriageUrl, options)
+      case "done":
+        return post(card.dataset.dragAndDropDoneUrl, options)
+      default:
+        return post(card.dataset.dragAndDropTriageUrl, { ...options, body: { column_id: place } })
+    }
+  }
+}
