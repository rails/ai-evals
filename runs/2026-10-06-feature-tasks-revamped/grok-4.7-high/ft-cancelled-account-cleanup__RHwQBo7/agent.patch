diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..0e00cbb
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @identity = identities(:david)
+    @account = Account.create_with_owner(
+      account: { name: "Doomed Account" },
+      owner: { name: "Doomed Owner", identity: @identity }
+    )
+    @owner = @account.users.find_by!(role: :owner)
+    @other = accounts(:"37s")
+
+    Current.set(account: @account, user: @owner) do
+      @board = @account.boards.create!(name: "Doomed Board", creator: @owner, all_access: true)
+      @card = @board.cards.create!(title: "Doomed card", status: "published", creator: @owner, description: "<p>Secret plan</p>")
+      @card.comments.create!(body: "<p>A doomed comment</p>", creator: @owner)
+      @card.image.attach(io: File.open(Rails.root.join("test/fixtures/files/moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+      @card.toggle_tag_with("doomed")
+      @card.pin_by(@owner)
+      @card.watch_by(@owner)
+      @board.webhooks.create!(name: "Hook", url: "https://example.com/hook", subscribed_actions: [ "card_published" ])
+      @board.events.create!(creator: @owner, eventable: @card, action: "card_published")
+      @filter = Filter.create!(creator: @owner, indexed_by: "closed")
+      insert_join("boards_filters", "board_id", @board.id, "filter_id", @filter.id)
+      insert_join("filters_tags", "tag_id", @account.tags.find_by!(title: "doomed").id, "filter_id", @filter.id)
+      Storage::Total.create!(owner: @account, bytes_stored: 10)
+      Storage::Total.create!(owner: @board, bytes_stored: 10)
+      Account::Export.create!(account: @account, user: @owner)
+    end
+
+    @account.cancel(initiated_by: @owner)
+  end
+
+  test "is registered as a recurring job" do
+    source = Rails.root.join("config/recurring.yml").read
+    assert_match(/class:\s*Account::IncinerateDueJob/, source)
+    assert_match(/incinerate_due_accounts:/, source)
+  end
+
+  test "permanently removes data for accounts cancelled more than 30 days ago" do
+    other_counts = row_counts(@other.id)
+    assert_not account_rows(@account.id).empty?, "expected associated rows before incineration"
+
+    make_due(@account)
+
+    Current.account = nil
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_empty account_rows(@account.id), -> { "leftover rows: #{account_rows(@account.id).inspect}" }
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Board.exists?(account_id: @account.id)
+    assert_not Card.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Blob.exists?(account_id: @account.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: @account.id)
+    assert_not Storage::Total.exists?(owner_type: "Board", owner_id: @board.id)
+    assert_not Search::Record.exists?(account_id: @account.id)
+    assert_equal 0, fts_count_for(@card)
+    assert_equal 0, join_count("boards_filters", "board_id", @board.id)
+    assert_equal 0, join_count("filters_tags", "filter_id", @filter.id)
+    assert Identity.exists?(@identity.id)
+    assert Account.exists?(@other.id)
+    assert_equal other_counts, row_counts(@other.id)
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    @account.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.minute)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Card.exists?(@card.id)
+  end
+
+  test "keeps accounts cancelled exactly 30 days ago" do
+    travel_to Time.current do
+      @account.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@other.id)
+  end
+
+  test "keeps a reactivated account" do
+    make_due(@account)
+    @account.reactivate
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@account.id)
+    assert Card.exists?(@card.id)
+  end
+
+test "incinerates after traveling past the grace period" do
+  travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.minute do
+    Account::IncinerateDueJob.perform_now
+  end
+
+  assert_not Account.exists?(@account.id)
+  assert_empty account_rows(@account.id)
+end
+
+test "incinerates every due account in one run" do
+  other_doomed = Account.create_with_owner(
+    account: { name: "Also Doomed" },
+    owner: { name: "Other Owner", identity: identities(:jz) }
+  )
+  other_doomed.cancel(initiated_by: other_doomed.users.find_by!(role: :owner))
+  make_due(@account)
+  make_due(other_doomed)
+
+  Account::IncinerateDueJob.perform_now
+
+  assert_not Account.exists?(@account.id)
+  assert_not Account.exists?(other_doomed.id)
+  assert Account.exists?(@other.id)
+end
+
+test "removes a cancelled account that has no other data" do
+  bare = Account.create!(name: "Bare Doomed")
+  bare.cancel(initiated_by: @owner)
+  make_due(bare)
+
+  Account::IncinerateDueJob.perform_now
+
+  assert_not Account.exists?(bare.id)
+  assert_not Account::Cancellation.exists?(account_id: bare.id)
+  assert Account.exists?(@account.id)
+end
+
+  test "is idempotent" do
+    make_due(@account)
+
+    Account::IncinerateDueJob.perform_now
+    assert_nothing_raised do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  private
+    def make_due(account)
+      account.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.minute)
+    end
+
+    def insert_join(table, left_column, left_id, right_column, right_id)
+      Account.with_connection do |connection|
+        connection.insert("INSERT INTO #{table} (#{left_column}, #{right_column}) VALUES (#{quote_id(connection, left_id)}, #{quote_id(connection, right_id)})")
+      end
+    end
+
+    def account_rows(account_id)
+      row_counts(account_id)
+    end
+
+    def row_counts(account_id)
+      Account.with_connection do |connection|
+        connection.tables.filter_map do |table|
+          next unless connection.column_exists?(table, "account_id")
+
+          count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{quote_id(connection, account_id)}").to_i
+          [ table, count ] if count.positive?
+        end.to_h
+      end
+    end
+
+    def fts_count_for(card)
+      return 0 unless Account.connection.table_exists?("search_records_fts")
+
+      search_id = Search::Record.where(searchable_type: "Card", searchable_id: card.id).pick(:id)
+      return 0 unless search_id
+
+      Account.with_connection do |connection|
+        connection.select_value("SELECT COUNT(*) FROM search_records_fts WHERE rowid = #{connection.quote(search_id)}").to_i
+      end
+    end
+
+    def join_count(table, column, id)
+      Account.with_connection do |connection|
+        connection.select_value("SELECT COUNT(*) FROM #{table} WHERE #{column} = #{quote_id(connection, id)}").to_i
+      end
+    end
+
+    def quote_id(connection, value)
+      connection.quote(Account.type_for_attribute(:id).serialize(value))
+    end
+end
