+    notification_bundle = Notification::Bundle.joins(:notifications).order(created_at: :desc).first
+    notification_bundle ||= Notification::Bundle.new(
+      user: User.active.where.not(identity_id: nil).first,
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+
+    Current.account = notification_bundle.account
+    NotificationMailer.bundle(notification_bundle)
+  end
+end
