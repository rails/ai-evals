@@ -0,0 +1,30 @@
+<h1 class="title"><%= @notifications.size %> <%= "notification".pluralize(@notifications.size) %></h1>
+<p class="subtitle">Here's what landed in <%= @account.name %>.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <table class="notification" role="presentation">
+      <tr>
+        <td class="avatar__container">
+          <%= mail_avatar_tag notification.creator %>
+        </td>
+        <td>
+          <p class="card__title"><%= link_to notification.payload.title, notification.payload.url %></p>
+          <p class="notification__details"><%= notification.payload.body %></p>
+          <p class="notification__author"><%= notification.creator.name %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change how often you get these", notifications_settings_url %>
+  · <%= link_to "View notifications", notifications_url %>
+</p>
