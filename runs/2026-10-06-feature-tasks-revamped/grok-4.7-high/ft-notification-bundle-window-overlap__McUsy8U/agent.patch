index 0000000..120e916
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,18 @@
+class NotificationMailer < ApplicationMailer
+  def bundle(notification_bundle)
+    @bundle = notification_bundle
+    @user = @bundle.user
+    @account = @bundle.account
+    @notifications = @bundle.notifications.preloaded.order(:created_at).to_a
+
+    Current.set(account: @account) do
+      mail to: @user.identity.email_address, subject: subject
+    end
+  end
+
+  private
+    def subject
+      count = @notifications.size
+      "#{count} #{"notification".pluralize(count)} on #{@account.name}"
+    end
+end
