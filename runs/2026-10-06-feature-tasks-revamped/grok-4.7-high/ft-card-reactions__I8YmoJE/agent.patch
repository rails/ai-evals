@@ -0,0 +1,17 @@
+module ReactionsHelper
+  def reaction_path_for(reaction)
+    if reaction.comment?
+      card_comment_reaction_path(reaction.card, reaction.comment, reaction)
+    else
+      card_reaction_path(reaction.card, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    if reaction.comment?
+      card_comment_reaction_url(reaction.card, reaction.comment, reaction)
+    else
+      card_reaction_url(reaction.card, reaction)
+    end
+  end
+end
