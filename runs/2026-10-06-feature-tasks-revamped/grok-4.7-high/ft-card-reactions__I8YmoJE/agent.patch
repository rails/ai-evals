+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "🔥", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+    assert_equal card_reaction_url(@card, @david_reaction), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, Reaction.last), @response.parsed_body["url"]
+  end
+
+  test "create as flat JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "🚀" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🚀", Reaction.last.content
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "card detail view offers reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "a[href=?]", new_card_reaction_path(@card)
+    assert_select "##{dom_id(@david_reaction)}"
+  end
+
+  test "board column preview shows boost count when non-zero" do
+    get board_column_path(@card.board, @card.column)
+
+    assert_response :success
+    assert_select "##{dom_id(@card, :article)} .card__boost-count", text: @card.boosts_count.to_s
+  end
+
+  test "board column preview hides boost count when zero" do
+    card = cards(:text)
+    assert_equal 0, card.boosts_count
+
+    get board_column_path(card.board, card.column)
+
+    assert_response :success
+    assert_select "##{dom_id(card, :article)} .card__boosts", count: 0
+  end
+end
+
+class Cards::ReactionsEdgeCasesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "detail view can start a reaction when the card has none" do
+    card = cards(:text)
+    assert_equal 0, card.reactions.count
+
+    get card_path(card)
+
+    assert_response :success
+    assert_select "a[href=?]", new_card_reaction_path(card)
+    assert_select ".card__boosts", count: 0
+  end
+
+  test "cannot destroy a reaction through a different card" do
+    card = cards(:logo)
+    other = cards(:text)
+    reaction = card.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_reaction_path(other, reaction), as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "column preview keeps the comment count next to a non-zero boost count" do
+    card = cards(:logo)
+    card.reactions.create!(content: "👍", reacter: users(:david))
+
+    get board_column_path(card.board, card.column)
+
+    assert_response :success
+    assert_select "##{dom_id(card, :article)} .card__comments strong", text: card.comments.by_user.count.to_s
+    assert_select "##{dom_id(card, :article)} .card__boost-count", text: "1"
+  end
+
+  test "comment reaction json url stays on the comment" do
+    comment = comments(:logo_agreement_jz)
+    post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :json
+
+    assert_response :created
+    assert_equal card_comment_reaction_url(comment.card, comment, Reaction.last), @response.parsed_body["url"]
+  end
+end
