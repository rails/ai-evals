+#!/usr/bin/env bash
+# Refuse to deploy the example one-box config until hostname, mail server, and
+# SECRET_KEY_BASE have been filled in.
+set -euo pipefail
+
+root="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$root"
+
+errors=0
+
+if grep -q 'x-host: &host fizzy.example.com' config/deploy.yml; then
+  echo "Fill in your hostname in config/deploy.yml (x-host). It is still fizzy.example.com." >&2
+  errors=1
+fi
+
+if grep -q 'x-mail-server: &mail_server smtp.example.com' config/deploy.yml; then
+  echo "Fill in your mail server in config/deploy.yml (x-mail-server). Magic-link sign-in cannot use smtp.example.com." >&2
+  errors=1
+fi
+
+secret="${SECRET_KEY_BASE:-}"
+if [ "${#secret}" -lt 32 ]; then
+  echo "Fill in SECRET_KEY_BASE before kamal setup. Generate one and export it:" >&2
+  echo "  export SECRET_KEY_BASE=\$(bin/rails secret)" >&2
+  echo "See .kamal/secrets. Use the same value on every deploy." >&2
+  errors=1
+fi
+
+exit "$errors"
