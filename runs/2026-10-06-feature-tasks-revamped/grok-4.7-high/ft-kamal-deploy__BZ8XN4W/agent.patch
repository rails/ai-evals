+# Secrets for config/deploy.yml. This file is committed and must stay free of
+# raw credentials. Kamal reads it with dotenv: values come from the environment
+# or a command, not from a shell script.
+#
+# Fill these in before `kamal setup` by exporting them:
+#
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export SMTP_USERNAME=your-smtp-user
+#   export SMTP_PASSWORD=your-smtp-password
+#
+# Keep SECRET_KEY_BASE stable across deploys or existing sessions are signed out.
+# Leave the SMTP variables empty only if the mail server relays without a login.
+#
+# To read from gitignored files instead, replace a line with a command:
+#   SECRET_KEY_BASE=$(cat .kamal/secret_key_base)
+#
+# Or a password manager:
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item SECRET_KEY_BASE SMTP_USERNAME SMTP_PASSWORD)
+#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+#   SMTP_USERNAME=$(kamal secrets extract SMTP_USERNAME $SECRETS)
+#   SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional browser push. Uncomment these and the matching env.secret entries
+# after generating a pair:
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}"; puts "VAPID_PUBLIC_KEY=#{k.public_key}"'
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
