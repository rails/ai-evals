@@ -0,0 +1,74 @@
+module Deployment
+  # SMTP and link-host settings for a one-box deploy. SaaS replaces these in
+  # the fizzy-saas environment files, so production.rb only applies this when
+  # Fizzy is not running as SaaS.
+  class OutboundMail
+    def self.from_address(env = ENV)
+      new(env).from_address
+    end
+
+    def initialize(env = ENV)
+      @env = env
+    end
+
+    def apply(config)
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = smtp_settings
+
+      if url_options
+        options = url_options
+        config.action_mailer.default_url_options = options
+        config.action_controller.default_url_options = options
+        config.after_initialize do
+          Rails.application.routes.default_url_options = options
+        end
+      end
+    end
+
+    def smtp_settings
+      settings = {
+        address: env["SMTP_ADDRESS"],
+        port: Integer(env["SMTP_PORT"].presence || "587"),
+        domain: env["SMTP_DOMAIN"].presence || host,
+        enable_starttls_auto: env.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+      }
+
+      if env["SMTP_TLS"] == "true"
+        settings[:tls] = true
+        settings[:enable_starttls_auto] = false
+      end
+
+      if env["SMTP_USERNAME"].present?
+        settings[:user_name] = env["SMTP_USERNAME"]
+        settings[:password] = env["SMTP_PASSWORD"]
+        settings[:authentication] = env.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+      end
+
+      settings
+    end
+
+    def url_options
+      return unless host
+
+      { host: host, protocol: "https" }
+    end
+
+    def from_address
+      configured = env["MAILER_FROM_ADDRESS"].presence
+      return configured if configured
+
+      if host
+        "Fizzy <fizzy@#{host}>"
+      else
+        "Fizzy <support@fizzy.do>"
+      end
+    end
+
+    private
+      attr_reader :env
+
+      def host
+        env["APP_HOST"].presence
+      end
+  end
+end
diff --git a/test/lib/deployment/one_box_deploy_test.rb b/test/lib/deployment/one_box_deploy_test.rb
new file mode 100644
index 0000000..1b195f1
--- /dev/null
+++ b/test/lib/deployment/one_box_deploy_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+require "kamal"
+require "open3"
+require "fileutils"
+require "tmpdir"
+
+class Deployment::OneBoxDeployTest < ActiveSupport::TestCase
+  test "kamal config is one sqlite container with proxy ssl and a persistent volume" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+    web = config.role(:web)
+
+    assert_equal [ "web" ], config.roles.map { |role| role.name.to_s }
+    assert_equal 1, web.hosts.size
+    assert_nil web.cmd
+    assert web.ssl?
+    assert_equal web.hosts, config.proxy.hosts
+    assert config.registry.local?
+    assert_empty config.accessories
+
+    volumes = Array(config.raw_config.volumes)
+    assert volumes.any? { |volume| volume.end_with?(":/rails/storage") }, volumes.inspect
+
+    clear = config.env.clear
+    assert_equal "true", clear["SOLID_QUEUE_IN_PUMA"].to_s
+    assert_equal "sqlite", clear["DATABASE_ADAPTER"].to_s
+    assert_equal "local", clear["ACTIVE_STORAGE_SERVICE"].to_s
+    assert_equal web.hosts.first, clear["APP_HOST"]
+    assert clear["SMTP_ADDRESS"].present?
+    assert_equal [ "SECRET_KEY_BASE", "SMTP_USERNAME", "SMTP_PASSWORD" ], config.env.secret_keys
+  end
+
+  test "secrets file is safe to commit and defines the deploy secrets" do
+    text = Rails.root.join(".kamal/secrets").read
+
+    %w[ SECRET_KEY_BASE SMTP_USERNAME SMTP_PASSWORD ].each do |key|
+      assert_match(/^#{key}=/, text)
+    end
+    assert_no_match(/^SECRET_KEY_BASE=(?!\$)\S+/, text)
+  end
+
+  test "pre-connect hook rejects the example hostname, mail server, and a missing secret" do
+    _out, err, status = run_hook({}, "SECRET_KEY_BASE" => "", "KAMAL_HOSTS" => "203.0.113.10")
+
+    assert_not status.success?
+    assert_match(/hostname/i, err)
+    assert_match(/mail server/i, err)
+    assert_match(/SECRET_KEY_BASE/, err)
+  end
+
+  test "pre-connect hook rejects a short secret even after the hostname is filled in" do
+    _out, err, status = run_hook(
+      { "x-host: &host fizzy.example.com" => "x-host: &host fizzy.their-host.test", "smtp.example.com" => "smtp.their-host.test" },
+      "SECRET_KEY_BASE" => "too-short",
+      "KAMAL_HOSTS" => "fizzy.their-host.test"
+    )
+
+    assert_not status.success?
+    assert_match(/SECRET_KEY_BASE/, err)
+    assert_no_match(/hostname/i, err)
+    assert_no_match(/mail server/i, err)
+  end
+
+  test "pre-connect hook allows a filled-in hostname, mail server, and secret" do
+    _out, err, status = run_hook(
+      { "x-host: &host fizzy.example.com" => "x-host: &host fizzy.their-host.test", "smtp.example.com" => "smtp.their-host.test" },
+      "SECRET_KEY_BASE" => "a" * 64,
+      "KAMAL_HOSTS" => "fizzy.their-host.test"
+    )
+
+    assert status.success?, err
+    assert_empty err
+  end
+
+  test "pre-connect hook treats an unset secret as missing" do
+    _out, err, status = run_hook(
+      { "x-host: &host fizzy.example.com" => "x-host: &host fizzy.their-host.test", "smtp.example.com" => "smtp.their-host.test" },
+      "KAMAL_HOSTS" => "fizzy.their-host.test"
+    )
+
+    assert_not status.success?
+    assert_match(/SECRET_KEY_BASE/, err)
+  end
+
+  private
+    def run_hook(replacements, env)
+      Dir.mktmpdir do |dir|
+        root = Pathname.new(dir)
+        FileUtils.mkdir_p root.join(".kamal/hooks")
+        FileUtils.mkdir_p root.join("config")
+
+        deploy = Rails.root.join("config/deploy.yml").read
+        replacements.each { |from, to| deploy = deploy.sub(from, to) }
+        File.write(root.join("config/deploy.yml"), deploy)
+
+        hook = root.join(".kamal/hooks/pre-connect")
+        File.write(hook, Rails.root.join(".kamal/hooks/pre-connect").read)
+        File.chmod(0o755, hook)
+
+        Open3.capture3(env.merge("PATH" => ENV["PATH"]), hook.to_s)
+      end
+    end
+end
