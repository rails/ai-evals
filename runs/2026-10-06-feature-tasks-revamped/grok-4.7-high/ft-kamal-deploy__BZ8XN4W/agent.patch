@@ -0,0 +1,70 @@
+require "test_helper"
+require "deployment/outbound_mail"
+
+class Deployment::OutboundMailTest < ActiveSupport::TestCase
+  test "smtp settings use the mail server, port 587, and starttls by default" do
+    settings = mail("SMTP_ADDRESS" => "smtp.their-host.test", "APP_HOST" => "fizzy.their-host.test").smtp_settings
+
+    assert_equal "smtp.their-host.test", settings[:address]
+    assert_equal 587, settings[:port]
+    assert_equal "fizzy.their-host.test", settings[:domain]
+    assert_equal true, settings[:enable_starttls_auto]
+    assert_not settings.key?(:user_name)
+    assert_not settings.key?(:authentication)
+  end
+
+  test "smtp username and password enable plain authentication" do
+    settings = mail(
+      "SMTP_ADDRESS" => "smtp.their-host.test",
+      "SMTP_USERNAME" => "apikey",
+      "SMTP_PASSWORD" => "secret",
+      "SMTP_AUTHENTICATION" => "login"
+    ).smtp_settings
+
+    assert_equal "apikey", settings[:user_name]
+    assert_equal "secret", settings[:password]
+    assert_equal :login, settings[:authentication]
+  end
+
+  test "blank smtp username is treated as an open relay" do
+    settings = mail("SMTP_USERNAME" => "", "SMTP_PASSWORD" => "").smtp_settings
+
+    assert_not settings.key?(:user_name)
+    assert_not settings.key?(:password)
+  end
+
+  test "implicit tls disables starttls" do
+    settings = mail("SMTP_PORT" => "465", "SMTP_TLS" => "true", "SMTP_ENABLE_STARTTLS_AUTO" => "true").smtp_settings
+
+    assert_equal 465, settings[:port]
+    assert_equal true, settings[:tls]
+    assert_equal false, settings[:enable_starttls_auto]
+  end
+
+  test "starttls can be turned off" do
+    settings = mail("SMTP_ENABLE_STARTTLS_AUTO" => "false").smtp_settings
+
+    assert_equal false, settings[:enable_starttls_auto]
+  end
+
+  test "empty port falls back to 587" do
+    assert_equal 587, mail("SMTP_PORT" => "").smtp_settings[:port]
+  end
+
+  test "url options use https and the hostname" do
+    assert_equal({ host: "fizzy.their-host.test", protocol: "https" }, mail("APP_HOST" => "fizzy.their-host.test").url_options)
+    assert_nil mail({}).url_options
+  end
+
+  test "from address follows the hostname unless overridden" do
+    assert_equal "Fizzy <fizzy@fizzy.their-host.test>", mail("APP_HOST" => "fizzy.their-host.test").from_address
+    assert_equal "Fizzy <board@their-host.test>", mail("APP_HOST" => "fizzy.their-host.test", "MAILER_FROM_ADDRESS" => "Fizzy <board@their-host.test>").from_address
+    assert_equal "Fizzy <support@fizzy.do>", mail({}).from_address
+    assert_equal "Fizzy <fizzy@fizzy.their-host.test>", mail("APP_HOST" => "fizzy.their-host.test", "MAILER_FROM_ADDRESS" => "").from_address
+  end
+
+  private
+    def mail(env)
+      Deployment::OutboundMail.new(env)
+    end
+end
