new file mode 100644
index 0000000..fbc20c1
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,93 @@
+# One-box Kamal config for Fizzy.
+#
+# A Linux server with Docker. SQLite, the web process, and background jobs run
+# in one container. kamal-proxy terminates SSL. A Docker volume keeps the
+# database and uploaded files, so they survive the next deploy.
+#
+# After forking, fill in three things, then run `kamal setup`
+# (from this repo: `bin/kamal setup`):
+#
+#   1. Hostname below (x-host). Fizzy will be at https://that-host.
+#   2. Mail server below (x-mail-server). Magic-link sign-in is sent through it.
+#   3. Secrets. See .kamal/secrets — export SECRET_KEY_BASE and your SMTP login.
+#
+# The server must accept SSH and have ports 80 and 443 open. DNS for the
+# hostname must point at it before Let's Encrypt can issue a certificate.
+
+# Public hostname. Also the SSH target unless you split them (see servers.web).
+x-host: &host fizzy.example.com
+
+# SMTP server. Credentials are SMTP_USERNAME / SMTP_PASSWORD in .kamal/secrets.
+# Port 587 with STARTTLS is the default. Override with SMTP_PORT, SMTP_DOMAIN,
+# SMTP_AUTHENTICATION, SMTP_ENABLE_STARTTLS_AUTO, or SMTP_TLS=true for port 465.
+x-mail-server: &mail_server smtp.example.com
+
+service: fizzy
+
+# Local registry: Kamal starts one on the server. No Docker Hub account needed.
+image: fizzy
+
+servers:
+  web:
+    - *host
+  # Jobs are not a separate role. Solid Queue runs inside this container so it
+  # uses the same SQLite files on this box. Do not add a jobs host.
+
+# If SSH should use an IP while the public name is a hostname, replace the
+# server above with that IP and keep x-host / proxy.host / APP_HOST as the
+# public name.
+
+proxy:
+  ssl: true
+  host: *host
+  # kamal-proxy stops forwarding client IP and protocol when ssl is on unless
+  # this is set. The app already assumes SSL in production.
+  forward_headers: true
+
+registry:
+  server: localhost:5555
+
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+  clear:
+    APP_HOST: *host
+    SMTP_ADDRESS: *mail_server
+    SMTP_PORT: "587"
+
+    # SQLite on the volume below. Everything for this box stays in one container.
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Background jobs in the web process. Required on one box.
+    SOLID_QUEUE_IN_PUMA: "true"
+
+    # Optional:
+    # MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    # SMTP_DOMAIN: example.com
+    # WEB_CONCURRENCY: "2"
+    # JOB_CONCURRENCY: "1"
+    # RAILS_LOG_LEVEL: info
+
+volumes:
+  # SQLite (primary, cache, queue, cable) and Active Storage files.
+  # Swap for a host path if you want backups to be a directory copy:
+  # - /var/lib/fizzy:/rails/storage
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+builder:
+  # Typical VPS. Set arm64 if the server is ARM.
+  arch: amd64
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# ssh:
+#   user: app
