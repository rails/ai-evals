+module Account::DataTransfer
+  VERSION = 1
+
+  class Error < StandardError; end
+  class ImportError < Error; end
+  class ExportError < Error; end
+
+  def self.import(blob, importer:, &block)
+    Importer.new(blob, importer: importer).import(&block)
