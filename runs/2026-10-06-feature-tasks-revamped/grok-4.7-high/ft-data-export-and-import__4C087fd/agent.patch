+    @user = users(:kevin)
+    Current.account = @account
+  end
+
+  test "exports and imports an account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
