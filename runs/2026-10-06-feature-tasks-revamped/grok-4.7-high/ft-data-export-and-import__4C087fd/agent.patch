index 0000000..d940115
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,89 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    @by_name = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @by_name.keys.select { |name| File.fnmatch(pattern, name, File::FNM_PATHNAME) }.sort
+  end
+
+  def exists?(path)
+    @by_name.key?(path)
+  end
+
+  def read(path)
+    extract(path) { |io| io.read }
+  end
+
+  def extract(path)
+    entry = @by_name.fetch(path)
+    extractor = entry.extractor_from(@io)
+    yield EntryIO.new(extractor, entry.uncompressed_size)
+  end
+
+  class EntryIO
+    def initialize(extractor, size)
+      @extractor = extractor
+      @size = size
+      @buffer = +"".b
+      @produced = 0
+    end
+
+    def size
+      @size
+    end
+
+    def read(length = nil, outbuf = nil)
+      if length.nil?
+        read_remaining(outbuf)
+      elsif length.zero?
+        replace(outbuf, +"".b)
+      else
+        read_some(length, outbuf)
+      end
+    end
+
+    def eof?
+      @produced >= @size && @buffer.empty?
+    end
+
+    private
+      def read_remaining(outbuf)
+        fill(@size)
+        data = @buffer
+        @produced += data.bytesize
+        @buffer = +"".b
+        replace(outbuf, data)
+      end
+
+      def read_some(length, outbuf)
+        fill(length)
+        return nil if @buffer.empty?
+
+        chunk = @buffer.byteslice(0, length) || +"".b
+        @buffer = @buffer.byteslice(length..) || +"".b
+        @produced += chunk.bytesize
+        replace(outbuf, chunk)
+      end
+
+      def fill(min_bytes)
+        while @buffer.bytesize < min_bytes && @produced + @buffer.bytesize < @size
+          chunk = @extractor.extract(1.megabyte)
+          break if chunk.nil? || chunk.empty?
+          @buffer << chunk.b
+        end
+      end
+
+      def replace(outbuf, data)
+        data = data.b
+        if outbuf
+          outbuf.replace(data)
+          outbuf
+        else
+          data
+        end
+      end
+  end
+end
diff --git a/app/models/zip_file/service_io.rb b/app/models/zip_file/service_io.rb
new file mode 100644
index 0000000..c36afc6
--- /dev/null
+++ b/app/models/zip_file/service_io.rb
@@ -0,0 +1,56 @@
+# Seekable IO over an Active Storage service. Used to read large zips from S3
+# via ranged downloads instead of pulling the whole archive into memory.
+class ZipFile::ServiceIO
+  CHUNK = 8.megabytes
+
+  def initialize(service, key, size)
+    @service = service
+    @key = key
+    @size = size.to_i
+    @pos = 0
+    @buffer = +"".b
+    @buffer_pos = 0
+  end
+
+  def size
+    @size
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @pos = offset.clamp(0, @size)
+    @buffer = +"".b
+    0
+  end
+
+  def tell
+    @pos
+  end
+
+  def read(n_bytes = nil)
+    return +"".b if n_bytes == 0
+    return if @pos >= @size
+
+    wanted = n_bytes || (@size - @pos)
+    wanted = [ wanted, @size - @pos ].min
+    return +"".b if wanted <= 0
+
+    ensure_buffer(wanted)
+    offset = @pos - @buffer_pos
+    data = @buffer.byteslice(offset, wanted) || +"".b
+    @pos += data.bytesize
+    data
+  end
+
+  private
+    def ensure_buffer(wanted)
+      covered = !@buffer.empty? && @pos >= @buffer_pos && (@pos + wanted) <= (@buffer_pos + @buffer.bytesize)
+      return if covered
+
+      length = [ [ wanted, CHUNK ].max, @size - @pos ].min
+      range = @pos..(@pos + length - 1)
+      @buffer = @service.download_chunk(@key, range).b
+      @buffer_pos = @pos
+    end
+end
