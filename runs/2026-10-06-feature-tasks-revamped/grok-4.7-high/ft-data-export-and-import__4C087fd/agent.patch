diff --git a/app/models/account/data_transfer/cards_archive.rb b/app/models/account/data_transfer/cards_archive.rb
new file mode 100644
index 0000000..af55bdb
--- /dev/null
+++ b/app/models/account/data_transfer/cards_archive.rb
@@ -0,0 +1,109 @@
+class Account::DataTransfer::CardsArchive
+  def initialize(user)
+    @user = user
+    @used_paths = {}
+  end
+
+  def write(zip)
+    cards.find_each do |card|
+      files = []
+      image_path = write_image(zip, card, files)
+      write_embeds(zip, card, "files/#{card.number}", files)
+
+      comments = card.comments.chronologically.includes(creator: :identity).with_rich_text_body.map do |comment|
+        comment_files = []
+        write_embeds(zip, comment, "files/#{card.number}/comments/#{comment.id}", comment_files)
+        comment_json(comment, comment_files)
+      end
+
+      zip.add_file("cards/#{card.number}.json", JSON.generate(card_json(card, image_path, files, comments)))
+    end
+  end
+
+  private
+    attr_reader :user
+
+    def cards
+      user.accessible_cards.published
+        .includes(:board, :column, :tags, :steps, :image_attachment, creator: :identity, assignees: :identity)
+        .with_rich_text_description
+    end
+
+    def card_json(card, image_path, files, comments)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        board: card.board.name,
+        column: card.column&.name,
+        creator: person(card.creator),
+        assignees: card.assignees.map { |assignee| person(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed } },
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        created_at: card.created_at.iso8601,
+        last_active_at: card.last_active_at.iso8601,
+        image: image_path,
+        files: files,
+        comments: comments
+      }
+    end
+
+    def comment_json(comment, files)
+      {
+        id: comment.id,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        creator: person(comment.creator),
+        created_at: comment.created_at.iso8601,
+        files: files
+      }
+    end
+
+    def person(user)
+      return unless user
+
+      { name: user.name, email: user.identity&.email_address }
+    end
+
+    def write_image(zip, card, files)
+      return unless card.image.attached?
+
+      path = write_blob(zip, card.image.blob, "files/#{card.number}")
+      files << path
+      path
+    end
+
+    def write_embeds(zip, record, directory, files)
+      record.attachments.each do |attachment|
+        next unless attachment.blob
+
+        files << write_blob(zip, attachment.blob, directory)
+      end
+    end
+
+    def write_blob(zip, blob, directory)
+      path = unique_path(directory, blob)
+      zip.add_file(path, compress: false) do |sink|
+        Account::DataTransfer.stream_blob(blob, sink)
+      end
+      path
+    rescue ActiveStorage::FileNotFoundError
+      raise Account::DataTransfer::ExportError, "A file attached to a card is missing, so the export can't be completed."
+    end
+
+    def unique_path(directory, blob)
+      name = blob.filename.sanitized.gsub(/[^\w.\-]+/, "_").presence || "file"
+      path = "#{directory}/#{name}"
+      if @used_paths[path]
+        path = "#{directory}/#{blob.id}-#{name}"
+      end
+      @used_paths[path] = true
+      path
+    end
+end
diff --git a/app/models/account/data_transfer/context.rb b/app/models/account/data_transfer/context.rb
new file mode 100644
index 0000000..889aeee
--- /dev/null
+++ b/app/models/account/data_transfer/context.rb
@@ -0,0 +1,57 @@
+class Account::DataTransfer::Context
+  attr_accessor :account
+  attr_reader :id_map, :files, :uploaded_keys, :importer
+
+  def initialize(importer:)
+    @importer = importer
+    @id_map = {}
+    @files = []
+    @uploaded_keys = []
+    @identities = {}
+  end
+
+  def map_id(old_id)
+    id_map[old_id.to_s] = ActiveRecord::Type::Uuid.generate
+  end
+
+  def remap(old_id)
+    return if old_id.blank?
+
+    id_map[old_id.to_s]
+  end
+
+  def fetch_id(old_id)
+    remap(old_id) || raise(Account::DataTransfer::ImportError, "The export refers to missing data and can't be completed.")
+  end
+
+  def remember_file(old_key, new_key, checksum)
+    files << [ old_key, new_key, checksum ]
+    uploaded_keys << new_key
+    new_key
+  end
+
+  def identity_id_for(email)
+    return if email.blank?
+
+    normalized = email.to_s.strip.downcase
+    return @identities[normalized] if @identities.key?(normalized)
+
+    identity = Identity.find_by(email_address: normalized) || Identity.create!(email_address: normalized)
+    @identities[normalized] = identity.id
+  end
+
+  def attachable_sgid(model_name, id)
+    model_name.constantize.new(id: id).attachable_sgid
+  end
+
+  def blob_path(blob_id, filename:)
+    signed_id = ActiveStorage::Blob.signed_id_verifier.generate(blob_id, purpose: "blob_id")
+    name = ActiveStorage::Filename.wrap(filename.presence || "file")
+    Rails.application.routes.url_helpers.rails_service_blob_path(
+      signed_id,
+      name,
+      only_path: true,
+      script_name: account.slug
+    )
+  end
+end
