diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..7516fd0
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,368 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+// Move a card between columns and statuses. Columns keep their own order, so a
+// drop changes where the card lives, not its place among siblings. The board
+// updates before the save returns; a later refresh must not slide the card again.
+export default class extends Controller {
+  static targets = [ "card", "container" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  initialize() {
+    this.draggedCard = null
+    this.highlightedContainer = null
+    this.moves = new WeakMap()
+    this.token = 0
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.onBreakpointChange = () => this.#syncDraggable()
+  }
+
+  connect() {
+    this.mediaQuery.addEventListener("change", this.onBreakpointChange)
+    this.#syncDraggable()
+  }
+
+  disconnect() {
+    this.mediaQuery.removeEventListener("change", this.onBreakpointChange)
+  }
+
+  cardTargetConnected(card) {
+    this.#prepareCard(card)
+  }
+
+  dragStart(event) {
+    const card = this.#cardFrom(event)
+    if (!card || !this.#enabled || this.#startsOnControl(event)) return
+
+    this.draggedCard = card
+    this.#suppressNextClick(card)
+    this.#setDragImage(event, card)
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    this.#autoScroll(event)
+
+    const container = this.#containerFrom(event)
+    if (!container) {
+      this.#clearHighlight()
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(container)
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const container = this.#containerFrom(event) || this.highlightedContainer
+
+    event.preventDefault()
+    this.#clearHighlight()
+    this.#clearDraggedStyle(card)
+
+    if (!card || !container || this.#samePlace(card, container)) return
+
+    this.#moveCard(card, container)
+    this.#persist(card, container)
+  }
+
+  dragEnd() {
+    this.#clearDraggedStyle(this.draggedCard)
+    this.#clearHighlight()
+    this.draggedCard = null
+  }
+
+  // Private
+
+  #moveCard(card, container) {
+    const source = card.closest("[data-drag-and-drop-target='container']")
+    const token = ++this.token
+
+    this.moves.set(card, {
+      token,
+      parent: card.parentElement,
+      next: card.nextSibling,
+      className: card.className,
+      color: card.style.getPropertyValue("--card-color"),
+      source,
+      sourceCount: source?.querySelector(".cards__expander-count")?.textContent,
+      target: container,
+      targetCount: container.querySelector(".cards__expander-count")?.textContent
+    })
+
+    this.#insertInOrder(card, container)
+    this.#syncAppearance(card, container)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(container, 1)
+    this.#pin(card)
+    this.#reveal(card, container)
+    this.#reinsertAfterFrameLoad(card, container)
+  }
+
+  async #persist(card, container) {
+    const token = this.moves.get(card)?.token
+
+    try {
+      const response = await this.#save(card, container)
+      if (this.moves.get(card)?.token !== token) return
+      if (!response?.ok) throw new Error("save failed")
+      await this.#afterNextMorph()
+    } catch (error) {
+      if (this.moves.get(card)?.token !== token) return
+      this.#revert(card)
+    } finally {
+      if (this.moves.get(card)?.token === token) this.#unpin(card)
+    }
+  }
+
+  #save(card, container) {
+    const place = container.dataset.dragAndDropPlace
+
+    switch (place) {
+      case "not_now":
+        return post(card.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+      case "stream":
+        return destroy(card.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      case "closed":
+        return post(card.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+      case "column":
+        return post(this.#columnUrl(card, container), { responseKind: "json" })
+      default:
+        return Promise.resolve({ ok: false })
+    }
+  }
+
+  #columnUrl(card, container) {
+    const url = new URL(card.dataset.dragAndDropTriageUrl, window.location.origin)
+    url.searchParams.set("column_id", container.dataset.dragAndDropColumnId)
+    return url.toString()
+  }
+
+  #insertInOrder(card, container) {
+    const holder = this.#holderFor(container)
+    const before = this.#insertionPoint(card, holder, container)
+
+    if (before) {
+      holder.insertBefore(card, before)
+    } else {
+      holder.appendChild(card)
+    }
+  }
+
+  // Columns order cards themselves (golden first, then most recently active).
+  // Land on that spot now so the save's refresh has nothing to reshuffle.
+  #insertionPoint(card, holder, container) {
+    const cards = [...holder.children].filter(child => child !== card && child.classList?.contains("card"))
+    const goldenFirst = container.dataset.dragAndDropOrder === "golden-first"
+    const golden = card.classList.contains("golden-effect")
+    const anchor = holder.querySelector(":scope > .pagination-link, :scope > .blank-slate")
+
+    if (!goldenFirst || golden) {
+      return cards[0] || anchor
+    }
+
+    return cards.find(child => !child.classList.contains("golden-effect")) || anchor
+  }
+
+  #holderFor(container) {
+    const list = container.querySelector(".cards__list") || this.#ensureList(container)
+    return list.querySelector("turbo-frame") || list
+  }
+
+  #ensureList(container) {
+    const frame = container.querySelector("turbo-frame")
+    const parent = frame || container.querySelector(".cards__transition-container") || container
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    parent.appendChild(list)
+    return list
+  }
+
+  #syncAppearance(card, container) {
+    const place = container.dataset.dragAndDropPlace
+    card.classList.toggle("card--postponed", place === "not_now")
+    card.classList.toggle("card--active", place === "column" || place === "stream")
+
+    const color = container.dataset.dragAndDropCardColor
+    if (color) card.style.setProperty("--card-color", color)
+  }
+
+  #adjustCount(container, delta) {
+    const element = container?.querySelector(".cards__expander-count")
+    if (!element) return
+
+    const text = element.textContent.trim()
+    if (text.endsWith("+")) return
+
+    const count = parseInt(text, 10)
+    if (Number.isNaN(count)) return
+
+    const next = count + delta
+    element.textContent = next > 99 ? "99+" : String(Math.max(next, 0))
+  }
+
+  #reveal(card, container) {
+    if (container.classList.contains("is-collapsed")) return
+
+    const list = container.querySelector(".cards__list")
+    if (list) list.scrollTop = 0
+    card.scrollIntoView({ block: "nearest", inline: "nearest" })
+  }
+
+  #reinsertAfterFrameLoad(card, container) {
+    const frame = container.querySelector("turbo-frame")
+    if (!frame) return
+
+    const token = this.moves.get(card)?.token
+    const onLoad = () => {
+      if (this.moves.get(card)?.token !== token) return
+      if (container.querySelector(`#${CSS.escape(card.id)}`)) return
+      this.#insertInOrder(card, container)
+    }
+
+    frame.addEventListener("turbo:frame-load", onLoad)
+    setTimeout(() => frame.removeEventListener("turbo:frame-load", onLoad), 2000)
+  }
+
+  // A refresh that was already in flight must not yank the card back to where
+  // it started. Keep this node where the drop left it until that refresh lands.
+  #pin(card) {
+    card.addEventListener("turbo:before-morph-element", this.#keepWhereDropped)
+  }
+
+  #unpin(card) {
+    card.removeEventListener("turbo:before-morph-element", this.#keepWhereDropped)
+  }
+
+  #keepWhereDropped = (event) => {
+    event.preventDefault()
+  }
+
+  #afterNextMorph() {
+    return new Promise(resolve => {
+      const finish = () => {
+        document.removeEventListener("turbo:morph", finish)
+        resolve()
+      }
+      document.addEventListener("turbo:morph", finish, { once: true })
+      setTimeout(finish, 400)
+    })
+  }
+
+  #revert(card) {
+    const move = this.moves.get(card)
+    if (!move?.parent?.isConnected) return
+
+    const reference = move.next?.parentElement === move.parent ? move.next : null
+    move.parent.insertBefore(card, reference)
+    card.className = move.className
+    card.classList.remove(DRAGGED_ITEM_CLASS)
+
+    if (move.color) {
+      card.style.setProperty("--card-color", move.color)
+    } else {
+      card.style.removeProperty("--card-color")
+    }
+
+    const sourceCount = move.source?.querySelector(".cards__expander-count")
+    const targetCount = move.target?.querySelector(".cards__expander-count")
+    if (sourceCount && move.sourceCount != null) sourceCount.textContent = move.sourceCount
+    if (targetCount && move.targetCount != null) targetCount.textContent = move.targetCount
+  }
+
+  #samePlace(card, container) {
+    return card.closest("[data-drag-and-drop-target='container']") === container
+  }
+
+  #cardFrom(event) {
+    return event.target.closest?.("[data-drag-and-drop-target='card']")
+  }
+
+  #containerFrom(event) {
+    const container = event.target.closest?.("[data-drag-and-drop-target='container']")
+    if (!container || !this.element.contains(container) || !container.dataset.dragAndDropPlace) return null
+    return container
+  }
+
+  #startsOnControl(event) {
+    return !!event.target.closest("button, input, textarea, select, dialog")
+  }
+
+  #highlight(container) {
+    if (this.highlightedContainer === container) return
+    this.#clearHighlight()
+    this.highlightedContainer = container
+    container.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #clearHighlight() {
+    this.highlightedContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.highlightedContainer = null
+  }
+
+  #clearDraggedStyle(card) {
+    card?.classList.remove(DRAGGED_ITEM_CLASS)
+  }
+
+  #setDragImage(event, card) {
+    if (!event.dataTransfer) return
+
+    const rect = card.getBoundingClientRect()
+    const x = event.clientX ? event.clientX - rect.left : rect.width / 2
+    const y = event.clientY ? event.clientY - rect.top : rect.height / 2
+
+    try {
+      event.dataTransfer.setDragImage(card, x, y)
+    } catch (error) {
+      // Some browsers reject setDragImage for synthetic events.
+    }
+  }
+
+  #suppressNextClick(card) {
+    const suppress = (event) => {
+      event.preventDefault()
+      event.stopPropagation()
+      card.removeEventListener("click", suppress, true)
+    }
+    card.addEventListener("click", suppress, true)
+  }
+
+  #autoScroll(event) {
+    if (!event.clientX) return
+
+    const rect = this.element.getBoundingClientRect()
+    const edge = 64
+    if (event.clientX < rect.left + edge) {
+      this.element.scrollLeft -= 16
+    } else if (event.clientX > rect.right - edge) {
+      this.element.scrollLeft += 16
+    }
+  }
+
+  #prepareCard(card) {
+    card.draggable = this.#enabled
+    card.querySelectorAll("img, a").forEach(element => { element.draggable = false })
+  }
+
+  #syncDraggable() {
+    this.cardTargets.forEach(card => this.#prepareCard(card))
+  }
+
+  get #enabled() {
+    return this.mediaQuery.matches
+  }
+}
