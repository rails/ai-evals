diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..b78ba1b 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,40 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    if action.card_assigned? || action.card_unassigned?
+      { assignee_ids: activity_assignee_ids }
+    elsif action.card_board_changed?
+      { old_board: particular_value("old_board"), new_board: particular_value("new_board") }
+    elsif action.card_title_changed?
+      { old_title: particular_value("old_title"), new_title: particular_value("new_title") }
+    elsif action.card_triaged?
+      { column: particular_value("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_assignee_ids
+      ids = assignee_ids
+      ids = nested_particulars["assignee_ids"] if ids.nil?
+      Array(ids)
+    end
+
+    def particular_value(key)
+      value = nested_particulars[key]
+      value = stored_particulars[key] if value.nil?
+      value.to_s
+    end
+
+    def nested_particulars
+      value = stored_particulars["particulars"]
+      value.is_a?(Hash) ? value : {}
+    end
+
+    def stored_particulars
+      particulars.is_a?(Hash) ? particulars.deep_stringify_keys : {}
+    end
 end
