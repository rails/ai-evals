+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from Current.user.activities(creator_ids: creator_ids, board_ids: board_ids)
+      end
+    end
+  end
+
+  private
+    def creator_ids
+      id_list(:creator_ids)
+    end
+
+    def board_ids
+      id_list(:board_ids)
+    end
+
+    def id_list(key)
+      Array(params[key]).flatten.compact_blank
+    end
+end
