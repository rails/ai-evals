index 0000000..8ac2d28
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,61 @@
+# Activity
+
+Account activity is the same stream shown on the HTML timeline: card updates and comments the current user can access.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity, newest first.
+
+Deprecated `card_collection_changed` events are omitted. `card_title_changed` events are included.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user who caused the activity |
+| `board_ids[]` | Filter by board. Boards you cannot access are ignored |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David assigned JZ to \"The logo isn't big enough\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 1,
+      "title": "The logo isn't big enough"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Writebook"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the cards, boards, and users endpoints. `description` is the event's plain-text sentence. `url` opens the card. For comments, it opens that card and jumps to the comment.
+
+`particulars` depends on the action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| anything else | `{}` |
+
+Missing board, title, or column values are empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..5666bb2
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,228 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+    assert_kind_of Array, @response.parsed_body
+
+    ids = @response.parsed_body.pluck("id")
+    assert_equal users(:kevin).accessible_events.for_activity.limit(15).pluck(:id), ids
+    assert_equal events(:layout_assignment_jz).id, ids.first
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+    assert_equal users(:kevin).accessible_events.for_activity.count.to_s, @response.headers["X-Total-Count"]
+  end
+
+  test "index includes the activity fields and existing representations" do
+    event = events(:logo_published)
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+    card = cards(:logo)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_published", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card.id, activity.dig("eventable", "id")
+    assert_equal card.title, activity.dig("eventable", "title")
+    assert_equal card_url(card), activity.dig("eventable", "url")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+    assert_equal user_url(users(:david)), activity.dig("creator", "url")
+  end
+
+  test "comment activity opens the card and jumps to the comment" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal "comment_created", activity["action"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_includes activity["url"], "##{dom_id(comment)}"
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+  end
+
+test "description is the plain text sentence for the current user" do
+  event = events(:logo_assignment_km)
+
+  get activities_path, as: :json
+
+  activity = activity_for(event)
+  assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+  assert_includes activity["description"], "will handle"
+end
+
+  test "assignment particulars include assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "includes title changes and exposes title particulars" do
+    event = create_event("card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path, as: :json
+
+    activity = activity_for(event)
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "board changes expose old and new board names" do
+    event = create_event("card_board_changed", particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity_for(event)["particulars"])
+  end
+
+  test "triage events expose the column" do
+    event = create_event("card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "column" => "In progress" }, activity_for(event)["particulars"])
+  end
+
+  test "missing board title and column values are empty strings" do
+    board_event = create_event("card_board_changed", particulars: {})
+    title_event = create_event("card_title_changed", particulars: { "particulars" => { "old_title" => nil } })
+    triage_event = create_event("card_triaged", particulars: { "particulars" => {} })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity_for(board_event)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity_for(title_event)["particulars"])
+    assert_equal({ "column" => "" }, activity_for(triage_event)["particulars"])
+  end
+
+  test "omits deprecated collection changes" do
+    event = create_event("card_collection_changed", particulars: { "particulars" => { "new_collection" => "Old name" } }, created_at: Time.current)
+
+    get activities_path, as: :json
+
+    assert_nil activity_for(event)
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+  end
+
+  test "filters by creator and board" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_closed",
+      created_at: Time.current
+    )
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+    assert_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "does not return activity from inaccessible boards" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_closed",
+      created_at: Time.current
+    )
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_empty @response.parsed_body
+  end
+
+  test "users without board access get an empty list" do
+    logout_and_sign_in_as :jason
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+    assert_equal "0", @response.headers["X-Total-Count"]
+  end
+
+  test "paginates using the existing API conventions" do
+    6.times do |index|
+      create_event("card_published", created_at: (index + 1).minutes.from_now)
+    end
+
+    get activities_path, as: :json
+
+    assert_equal 15, @response.parsed_body.size
+    assert_match(/rel="next"/, @response.headers["Link"])
+    assert_equal users(:kevin).activities.count.to_s, @response.headers["X-Total-Count"]
+
+    get activities_path(page: 2), as: :json
+    assert_equal users(:kevin).activities.count - 15, @response.parsed_body.size
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "reads particulars stored flat or nested" do
+    flat = create_event("card_title_changed", particulars: { "old_title" => "Flat old", "new_title" => "Flat new" })
+    nested = create_event("card_board_changed", particulars: { particulars: { old_board: "Nested old" } })
+
+    get activities_path, as: :json
+
+    assert_equal({ "old_title" => "Flat old", "new_title" => "Flat new" }, activity_for(flat)["particulars"])
+    assert_equal({ "old_board" => "Nested old", "new_board" => "" }, activity_for(nested)["particulars"])
+  end
+
+  private
+    def activity_for(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def create_event(action, particulars: {}, created_at: Time.current)
+      boards(:writebook).events.create!(
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: action,
+        particulars: particulars,
+        created_at: created_at
+      )
+    end
+end
