diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..5499346
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,58 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(reacter: [ :avatar_attachment, :account ])
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+    @comment.reactions.reset
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)) }
+      format.json { render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction) }
+    end
+  rescue ActiveRecord::RecordInvalid
+    respond_to do |format|
+      format.turbo_stream { head :unprocessable_entity }
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)), alert: "Could not add that reaction" }
+      format.json { head :unprocessable_entity }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    @comment.reactions.reset
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..469e93e
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,75 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "picker" ]
+
+  connect() {
+    this.markOwn()
+    this.boundMarkOwn = this.markOwn.bind(this)
+    window.addEventListener("turbo:morph", this.boundMarkOwn)
+  }
+
+  disconnect() {
+    window.removeEventListener("turbo:morph", this.boundMarkOwn)
+  }
+
+  add() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.reset()
+  }
+
+  preventEmpty(event) {
+    if (this.inputTarget.value.trim() === "") {
+      event.preventDefault()
+      this.inputTarget.focus()
+    }
+  }
+
+  pick(event) {
+    event.preventDefault()
+    this.inputTarget.value = event.params.emoji
+    this.closePicker()
+    this.formTarget.requestSubmit()
+  }
+
+  toggle(event) {
+    const reaction = event.target.closest(".reaction--deleteable")
+    if (!reaction || !this.element.contains(reaction)) return
+    if (event.target.closest("button, a, input, textarea, dialog, summary")) return
+
+    reaction.classList.toggle("expanded")
+  }
+
+  markOwn() {
+    const userId = window.Current?.user?.id
+    if (!userId) return
+
+    this.element.querySelectorAll(".reaction[data-creator-id]").forEach((reaction) => {
+      reaction.classList.toggle("reaction--deleteable", reaction.dataset.creatorId === userId)
+    })
+  }
+
+  reset() {
+    if (this.hasFormTarget) {
+      this.formTarget.reset()
+      this.formTarget.classList.remove("reaction", "expanded")
+      this.formTarget.hidden = true
+    }
+
+    this.closePicker()
+
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+  }
+
+  closePicker() {
+    if (!this.hasPickerTarget) return
+    if (this.pickerTarget.open) this.pickerTarget.close()
+  }
+}
