+        </div>
+      </dialog>
+    </div>
+
+    <button type="submit" class="reaction__submit-btn btn" aria-label="Add reaction">
+      <%= icon_tag "check" %>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn" aria-label="Cancel" data-action="reactions#cancel">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+</div>
