+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions" data-action="click->reactions#toggle">
+  <div class="reactions__list">
+    <%= render comment.reactions.preload(reacter: [ :avatar_attachment, :account ]) %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction" data-reactions-target="trigger" data-action="reactions#add">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ],
+        html: { class: "reaction__form", hidden: true },
+        data: { turbo_frame: "_top", reactions_target: "form", action: "submit->reactions#preventEmpty keydown.esc->reactions#cancel:stop" } do |form| %>
+    <label class="reaction__form-label">
+      <span class="for-screen-reader">Reaction</span>
+      <%= form.text_field :content,
+            maxlength: 16,
+            required: true,
+            autocomplete: "off",
+            spellcheck: false,
+            placeholder: "👍",
+            class: "reaction__input input",
+            data: { reactions_target: "input" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn" aria-label="Pick an emoji" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-reactions-target="picker">
+        <div class="reaction__emoji-list">
