diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..7bd1e48
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,43 @@
+class Reaction < ApplicationRecord
+  EMOJIS = %w[👍 👎 ❤️ 😄 🎉 🔥 👀 🚀 ✅ 💯 👏 🙌 😍 🤔 😮 😢 😂 🙏 💪 ✨].freeze
+  EMOJI_GRAPHEME = /\A(?:\p{Extended_Pictographic}|\p{Emoji_Presentation})(?:\uFE0F|\u200D|\p{Emoji_Modifier})*\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  normalizes :content, with: -> { it.to_s.strip }
+
+  after_create :register_card_activity
+  after_commit :broadcast_reaction, on: %i[ create destroy ]
+
+  delegate :card, to: :comment
+
+  def to_partial_path
+    "cards/comments/reaction"
+  end
+
+  def emoji_only?
+    graphemes = content.to_s.grapheme_clusters
+    graphemes.any? && graphemes.all? { |grapheme| grapheme.match?(EMOJI_GRAPHEME) }
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+
+    def broadcast_reaction
+      return if destroyed_by_association
+      return unless comment&.persisted? && card
+
+      broadcast_replace_later_to card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: comment }
+    end
+end
