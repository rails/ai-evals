+      [/\A<strong>Reopened<\/strong> by (.*)\z/, ->(c) { "#{c[0]}が<strong>再開</strong>しました" }],
+      [/\A(.*) <strong>moved<\/strong> this to “Not Now”\z/, ->(c) { "#{c[0]}が「今はしない」に<strong>移動</strong>しました" }],
+      [/\A<strong>Moved<\/strong> to “Not Now” due to inactivity\z/, ->(_) { "動きがなかったため「今はしない」に<strong>移動</strong>しました" }],
+      [/\A(.*) <strong>changed the title<\/strong> from “(.*)” to “(.*)”\.\z/, ->(c) { "#{c[0]}がタイトルを「#{c[1]}」から「#{c[2]}」に<strong>変更</strong>しました。" }],
+      [/\A(.*) <strong>moved<\/strong> this from “(.*)” to “(.*)”\.\z/, ->(c) { "#{c[0]}が「#{c[1]}」から「#{c[2]}」に<strong>移動</strong>しました。" }],
+      [/\A(.*) <strong>moved<\/strong> this back to “Maybe\?”\z/, ->(c) { "#{c[0]}が「たぶん？」に<strong>戻し</strong>ました" }],
+      [/\A(.*) <strong>moved<\/strong> this to “(.*)”\z/, ->(c) { "#{c[0]}が「#{c[1]}」に<strong>移動</strong>しました" }]
+    ]
+
+    rules.each do |pattern, builder|
+      if (match = html.match(pattern))
+        return builder.call(match.captures)
+      end
+    end
+    nil
+  end
 end
