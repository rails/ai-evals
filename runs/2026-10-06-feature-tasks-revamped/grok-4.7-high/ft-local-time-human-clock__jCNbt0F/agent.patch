diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..d0e3b21 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,34 @@
 module TimeHelper
+  # A cacheable <time> tag carrying a raw UTC timestamp. The local-time
+  # Stimulus controller turns it into words in the viewer's timezone, so the
+  # HTML itself does not depend on whose clock rendered it.
+  def local_time_tag(time, format: :relative, **options)
+    return if time.blank?
+
+    timestamp = utc_iso8601(time)
+    data = options.delete(:data) || {}
+    data[:controller] = token_list("local-time", data[:controller])
+    data[:local_time_format_value] = format.to_s
+    data[:action] = token_list("turbo:morph-element->local-time#render", data[:action])
+    options[:class] = class_names("local-time-value", options[:class])
+
+    tag.time timestamp, datetime: timestamp, data: data, **options
+  end
+
+  # Embed a timestamp in a plain string (native share sheets, bridge
+  # descriptions) for the browser to localize before it is shown.
+  def local_time_placeholder(time, format = :relative)
+    return if time.blank?
+
+    "{{time:#{utc_iso8601(time)}|#{format}}}"
+  end
+
+  private
+    def utc_iso8601(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        Time.utc(time.year, time.month, time.day, 12).iso8601
+      end
+    end
 end
