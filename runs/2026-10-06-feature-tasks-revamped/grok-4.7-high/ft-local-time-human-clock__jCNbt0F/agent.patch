diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..592e0a7
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,73 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_format"
+
+const REFRESH_INTERVAL = 60_000
+const REFRESHING_FORMATS = new Set([ "relative", "distance" ])
+
+const refreshCallbacks = new Set()
+let refreshTimer
+
+function watchClock(callback) {
+  refreshCallbacks.add(callback)
+
+  if (!refreshTimer) {
+    refreshTimer = setInterval(runRefreshCallbacks, REFRESH_INTERVAL)
+    document.addEventListener("visibilitychange", refreshWhenVisible)
+  }
+
+  return () => {
+    refreshCallbacks.delete(callback)
+
+    if (refreshCallbacks.size === 0) {
+      clearInterval(refreshTimer)
+      refreshTimer = null
+      document.removeEventListener("visibilitychange", refreshWhenVisible)
+    }
+  }
+}
+
+function runRefreshCallbacks() {
+  refreshCallbacks.forEach((callback) => callback())
+}
+
+function refreshWhenVisible() {
+  if (document.visibilityState === "visible") runRefreshCallbacks()
+}
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.originalText = this.element.textContent
+    this.render()
+    this.boundRestore = this.restore.bind(this)
+    document.addEventListener("turbo:before-cache", this.boundRestore)
+
+    if (REFRESHING_FORMATS.has(this.formatValue)) {
+      this.unwatch = watchClock(() => this.render())
+    }
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:before-cache", this.boundRestore)
+    this.unwatch?.()
+  }
+
+  // Re-run after a morph, which puts the server's raw timestamp back in the element.
+  render() {
+    const raw = this.element.getAttribute("datetime")
+    const formatted = formatTimestamp(raw, this.formatValue)
+
+    if (formatted) {
+      this.element.textContent = formatted
+      this.element.title = formatTimestamp(raw, "%B %-d, %Y at %-l:%M %p")
+      this.element.dataset.localized = "true"
+    }
+  }
+
+  restore() {
+    this.element.textContent = this.originalText
+    this.element.removeAttribute("title")
+    delete this.element.dataset.localized
+  }
+}
diff --git a/app/javascript/helpers/time_format.js b/app/javascript/helpers/time_format.js
new file mode 100644
index 0000000..095d71e
--- /dev/null
+++ b/app/javascript/helpers/time_format.js
@@ -0,0 +1,189 @@
+import { getMetaContent } from "helpers/meta_helpers"
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const WEEKDAYS = [ "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ]
+const MONTHS = [ "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" ]
+const MONTHS_ABBR = [ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" ]
+
+// Past the current week, a count of days stops being useful and a calendar
+// date ("Sep 12") reads better. Yesterday/tomorrow stay words.
+const RELATIVE_DAY_LIMIT = 7
+
+const TOKEN = /%-?[A-Za-z%]/g
+
+const TOKEN_FORMATTERS = {
+  "%A": (parts) => WEEKDAYS[parts.weekdayIndex],
+  "%B": (parts) => MONTHS[parts.month - 1],
+  "%b": (parts) => MONTHS_ABBR[parts.month - 1],
+  "%-d": (parts) => String(parts.day),
+  "%d": (parts) => String(parts.day).padStart(2, "0"),
+  "%e": (parts) => String(parts.day).padStart(2, " "),
+  "%Y": (parts) => String(parts.year),
+  "%y": (parts) => String(parts.year).slice(-2),
+  "%-m": (parts) => String(parts.month),
+  "%m": (parts) => String(parts.month).padStart(2, "0"),
+  "%-l": (parts) => String(parts.hour12),
+  "%l": (parts) => String(parts.hour12).padStart(2, " "),
+  "%H": (parts) => String(parts.hour).padStart(2, "0"),
+  "%-H": (parts) => String(parts.hour),
+  "%M": (parts) => String(parts.minute).padStart(2, "0"),
+  "%p": (parts) => parts.hour < 12 ? "AM" : "PM",
+  "%P": (parts) => parts.hour < 12 ? "am" : "pm",
+  "%%": () => "%"
+}
+
+const PLACEHOLDER = /\{\{time:([^|}]+)\|([^}]+)\}\}/g
+
+// The timezone the server rendered with (the `timezone` meta tag), so displayed
+// day boundaries match the server's grouping. Falls back to the browser zone
+// when the tag is missing or not a real IANA name.
+export function viewerTimeZone() {
+  const timezone = getMetaContent("timezone")
+  if (!timezone) return undefined
+
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: timezone })
+    return timezone
+  } catch {
+    return undefined
+  }
+}
+
+export function formatTimestamp(value, format = "relative", now = new Date()) {
+  const date = value instanceof Date ? value : new Date(value)
+  if (Number.isNaN(date.getTime())) return ""
+
+  if (format === "relative") return formatRelative(date, now)
+  if (format === "distance") return formatDistance(date, now)
+
+  return strftime(date, format).trim()
+}
+
+export function localizeTimePlaceholders(text, now = new Date()) {
+  if (!text) return text
+
+  return text.replace(PLACEHOLDER, (_match, iso, format) => formatTimestamp(iso, format, now))
+}
+
+// Same calendar day reads as a clock time ("1:42 PM"); last night is
+// "yesterday"; earlier in the week is "5 days ago", and older than that is a
+// short date ("Sep 12"). Ahead of now, overnight is "tomorrow" and further out
+// is "in 3 days".
+function formatRelative(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    if (date.getTime() > now.getTime()) return "today"
+    return formatClock(date)
+  }
+
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days <= -RELATIVE_DAY_LIMIT) return formatShortDate(date, now)
+  if (days < 0) return `${Math.abs(days)} days ago`
+
+  return `in ${days} days`
+}
+
+function formatClock(date) {
+  return strftime(date, "%-l:%M %p")
+}
+
+function formatShortDate(date, now) {
+  const parts = dateParts(date)
+  const nowParts = dateParts(now)
+
+  if (parts.year === nowParts.year) return strftime(date, "%b %-d")
+
+  return strftime(date, "%b %-d, %Y")
+}
+
+// Mirrors Action View's distance_of_time_in_words (without the trailing "ago",
+// which the surrounding sentence supplies) so card metadata keeps its wording.
+function formatDistance(date, now) {
+  const seconds = Math.round(Math.abs(now.getTime() - date.getTime()) / 1000)
+  const minutes = Math.round(seconds / 60)
+
+  if (minutes <= 1) {
+    if (minutes === 0) return "less than a minute"
+    return "1 minute"
+  }
+
+  if (minutes < 45) return `${minutes} minutes`
+  if (minutes < 90) return "about 1 hour"
+  if (minutes < 1440) return pluralAboutHours(Math.round(minutes / 60))
+  if (minutes < 2520) return "1 day"
+  if (minutes < 43200) return pluralDays(Math.round(minutes / 1440))
+  if (minutes < 86400) return pluralAboutMonths(Math.round(minutes / 43200))
+  if (minutes < 525600) return pluralMonths(Math.round(minutes / 43200))
+
+  return pluralAboutYears(Math.max(1, Math.round(minutes / 525600)))
+}
+
+function pluralAboutHours(count) {
+  return count === 1 ? "about 1 hour" : `about ${count} hours`
+}
+
+function pluralDays(count) {
+  return count === 1 ? "1 day" : `${count} days`
+}
+
+function pluralAboutMonths(count) {
+  return count === 1 ? "about 1 month" : `about ${count} months`
+}
+
+function pluralMonths(count) {
+  return count === 1 ? "1 month" : `${count} months`
+}
+
+function pluralAboutYears(count) {
+  return count === 1 ? "about 1 year" : `about ${count} years`
+}
+
+function strftime(date, format) {
+  const parts = dateParts(date)
+
+  return format.replace(TOKEN, (token) => {
+    const formatter = TOKEN_FORMATTERS[token]
+    return formatter ? formatter(parts) : token
+  })
+}
+
+let partsFormatter
+let partsFormatterZone
+
+function dateParts(date) {
+  const timezone = viewerTimeZone()
+  const formatter = partsFormatterFor(timezone)
+  const parsed = { year: 0, month: 0, day: 0, hour: 0, minute: 0, weekdayIndex: 0 }
+
+  for (const { type, value } of formatter.formatToParts(date)) {
+    if (type === "year") parsed.year = parseInt(value, 10)
+    if (type === "month") parsed.month = parseInt(value, 10)
+    if (type === "day") parsed.day = parseInt(value, 10)
+    if (type === "hour") parsed.hour = parseInt(value, 10) % 24
+    if (type === "minute") parsed.minute = parseInt(value, 10)
+    if (type === "weekday") parsed.weekdayIndex = WEEKDAYS.indexOf(value)
+  }
+
+  parsed.hour12 = parsed.hour % 12 || 12
+  return parsed
+}
+
+function partsFormatterFor(timezone) {
+  if (partsFormatter && partsFormatterZone === timezone) return partsFormatter
+
+  partsFormatterZone = timezone
+  const options = {
+    weekday: "long",
+    year: "numeric",
+    month: "numeric",
+    day: "numeric",
+    hour: "numeric",
+    minute: "numeric",
+    hourCycle: "h23"
+  }
+
+  partsFormatter = new Intl.DateTimeFormat("en-US", timezone ? { ...options, timeZone: timezone } : options)
+  return partsFormatter
+}
