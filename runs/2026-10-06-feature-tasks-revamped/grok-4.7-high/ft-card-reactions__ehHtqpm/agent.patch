 class Reaction < ApplicationRecord
-  belongs_to :account, default: -> { comment.account }
-  belongs_to :comment, touch: true
+  belongs_to :account, default: -> { comment&.account || card&.account }
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :card, optional: true, touch: true, counter_cache: true
   belongs_to :reacter, class_name: "User", default: -> { Current.user }
 
   scope :ordered, -> { order(:created_at) }
 
   after_create :register_card_activity
+  after_destroy :touch_affected_card
+
+  validate :single_reactable
 
   delegate :all_emoji?, to: :content
 
   private
+    def single_reactable
+      if comment.present? && card.present?
+        errors.add(:base, "cannot belong to both a card and a comment")
+      elsif comment.blank? && card.blank?
+        errors.add(:base, "must belong to a card or a comment")
+      end
+    end
+
     def register_card_activity
-      comment.card.touch_last_active_at
+      affected_card.touch_last_active_at
+    end
+
+    def touch_affected_card
+      affected_card&.touch
+    end
+
+    def affected_card
+      comment&.card || card
     end
 end
