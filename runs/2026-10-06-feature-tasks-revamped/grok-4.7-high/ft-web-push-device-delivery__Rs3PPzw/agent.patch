diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..10b0053
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,163 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Turns browser push on for the device viewing notification settings, and
+// shows the shipped help copy when the browser is blocking notifications.
+export default class extends Controller {
+  static targets = [ "details", "help", "toggle" ]
+  static values = {
+    publicKey: String,
+    url: String,
+    subscriptions: { type: Array, default: [] }
+  }
+
+  async connect() {
+    this.#hideHelp()
+
+    if (!this.#supported || !this.publicKeyValue) {
+      this.#showHelp()
+      this.#disableToggle()
+      return
+    }
+
+    try {
+      this.#subscription = await this.#existingSubscription()
+
+      if (this.#subscription && !this.#idFor(this.#subscription.endpoint)) {
+        await this.#register(this.#subscription)
+      }
+    } catch (error) {
+      this.#subscription = null
+      this.#showHelp()
+    }
+
+    if (Notification.permission === "denied") this.#showHelp()
+
+    this.#render()
+  }
+
+  async toggle() {
+    this.#disableToggle()
+
+    try {
+      if (this.#subscription) {
+        await this.#turnOff()
+      } else {
+        await this.#turnOn()
+      }
+    } catch (error) {
+      this.#showHelp()
+    } finally {
+      this.#enableToggle()
+      this.#render()
+    }
+  }
+
+  async #turnOn() {
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#showHelp()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    this.#subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#register(this.#subscription)
+    this.#hideHelp()
+  }
+
+  async #turnOff() {
+    const endpoint = this.#subscription.endpoint
+    const id = this.#idFor(endpoint)
+
+    await this.#subscription.unsubscribe()
+    this.#subscription = null
+
+    if (id) await destroy(`${this.urlValue}/${id}`, { responseKind: "json" })
+  }
+
+  async #register(subscription) {
+    const json = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (!response.ok) {
+      await subscription.unsubscribe()
+      this.#subscription = null
+      throw new Error("Couldn't save the push subscription")
+    }
+
+    const payload = await response.json
+    this.#remember(payload.id, json.endpoint)
+  }
+
+  async #existingSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  #render() {
+    const on = Boolean(this.#subscription)
+    this.element.classList.toggle("notifications--on", on)
+    if (this.hasToggleTarget) this.toggleTarget.checked = on
+  }
+
+  #showHelp() {
+    this.detailsTargets.forEach((element) => { element.hidden = false })
+    if (this.hasHelpTarget) this.helpTarget.hidden = false
+  }
+
+  #hideHelp() {
+    this.detailsTargets.forEach((element) => { element.hidden = true })
+    if (this.hasHelpTarget) this.helpTarget.hidden = true
+  }
+
+  #disableToggle() {
+    if (this.hasToggleTarget) this.toggleTarget.disabled = true
+  }
+
+  #enableToggle() {
+    if (this.hasToggleTarget) this.toggleTarget.disabled = false
+  }
+
+  #idFor(endpoint) {
+    return this.subscriptionsValue.find((subscription) => subscription.endpoint === endpoint)?.id
+  }
+
+  #remember(id, endpoint) {
+    const others = this.subscriptionsValue.filter((subscription) => subscription.endpoint !== endpoint)
+    this.subscriptionsValue = [ ...others, { id, endpoint } ]
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    return this.#urlBase64ToUint8Array(this.publicKeyValue)
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+    const output = new Uint8Array(raw.length)
+
+    for (let i = 0; i < raw.length; i++) output[i] = raw.charCodeAt(i)
+
+    return output
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
new file mode 100644
index 0000000..3e4cf6b
--- /dev/null
+++ b/app/jobs/push_subscription/delivery_job.rb
@@ -0,0 +1,13 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError,
+    Net::OpenTimeout, Net::ReadTimeout, SocketError, Errno::ECONNRESET,
+    wait: :polynomially_longer, attempts: 8
+
+  def perform(subscription, notification)
+    subscription.deliver_now(notification)
+  end
+end
