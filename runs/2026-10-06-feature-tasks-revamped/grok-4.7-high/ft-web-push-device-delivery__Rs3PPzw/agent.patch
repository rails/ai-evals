--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example/kevin-phone",
+      p256dh_key: "phone-p256dh",
+      auth_key: "phone-auth"
+    )
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example/kevin-desktop",
+      p256dh_key: "desktop-p256dh",
+      auth_key: "desktop-auth"
+    )
+  end
+
+  test "a new tray notification is pushed to every device" do
+    notifications(:layout_commented_kevin).destroy
+
+    with_vapid_keys do
+      assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+        Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+      end
+    end
+  end
+
+  test "updating the source pushes again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    with_vapid_keys do
+      assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+        notification.update!(source: events(:logo_published), creator: users(:david), read_at: nil, unread_count: notification.unread_count + 1)
+      end
+    end
+  end
+
+  test "marking a notification read does not push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    with_vapid_keys do
+      assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+        notification.read
+      end
+    end
+  end
+
+  test "push is skipped when vapid keys are missing" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "mention pushes say what the tray says" do
+    notification = notifications(:logo_mentioned_david)
+    data = notification.push_data
+
+    assert_equal "JZ @mentioned you", data[:title]
+    assert_equal ApplicationController.helpers.notification_body(notification), data[:body]
+    assert_includes data[:url], "/cards/#{notification.card.number}"
+  end
+
+  private
+    def with_vapid_keys
+      originals = { "VAPID_PUBLIC_KEY" => ENV["VAPID_PUBLIC_KEY"], "VAPID_PRIVATE_KEY" => ENV["VAPID_PRIVATE_KEY"] }
+      ENV["VAPID_PUBLIC_KEY"] = "vapid-public"
+      ENV["VAPID_PRIVATE_KEY"] = "vapid-private"
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..267e4f2
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "deliver now sends what the tray says and opens the card" do
+    with_vapid_keys do
+      payload = nil
+
+      WebPush.expects(:payload_send).with do |args|
+        payload = JSON.parse(args[:message])
+        assert_equal @subscription.endpoint, args[:endpoint]
+        assert_equal @subscription.p256dh_key, args[:p256dh]
+        assert_equal @subscription.auth_key, args[:auth]
+        assert_equal "vapid-public", args.dig(:vapid, :public_key)
+        assert_equal "vapid-private", args.dig(:vapid, :private_key)
+        true
+      end
+
+      @subscription.deliver_now(@notification)
+
+      assert_equal ApplicationController.helpers.notification_title(@notification), payload["title"]
+      assert_equal ApplicationController.helpers.notification_body(@notification), payload["body"]
+      assert_includes payload["url"], "#{@notification.account.slug}/cards/#{@notification.card.number}"
+      assert_equal @notification.id, payload["tag"]
+    end
+  end
+
+  test "deliver now is a no-op without vapid keys" do
+    WebPush.expects(:payload_send).never
+
+    @subscription.deliver_now(@notification)
+  end
+
+  test "expired subscriptions are removed" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: "", inspect: "gone"), "push.example"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver_now(@notification)
+      end
+    end
+  end
+
+  test "invalid subscriptions are removed" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).raises(WebPush::InvalidSubscription.new(stub(body: "", inspect: "missing"), "push.example"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver_now(@notification)
+      end
+    end
+  end
+
+  test "endpoint must be https" do
+    subscription = @user.push_subscriptions.build(endpoint: "http://push.example/insecure", p256dh_key: "k", auth_key: "a")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an https URL"
+  end
+
+  test "same endpoint can be registered for another user" do
+    other = users(:david).push_subscriptions.create!(
+      endpoint: @subscription.endpoint,
+      p256dh_key: "other-p256dh",
+      auth_key: "other-auth"
+    )
+
+    assert_equal @subscription.endpoint, other.endpoint
+  end
+
+  private
+    def with_vapid_keys
+      originals = { "VAPID_PUBLIC_KEY" => ENV["VAPID_PUBLIC_KEY"], "VAPID_PRIVATE_KEY" => ENV["VAPID_PRIVATE_KEY"] }
+      ENV["VAPID_PUBLIC_KEY"] = "vapid-public"
+      ENV["VAPID_PRIVATE_KEY"] = "vapid-private"
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
