@@ -0,0 +1,57 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :push_on_create
+    after_update_commit :push_on_update
+  end
+
+  def push_later
+    return unless user.active? && PushSubscription.configured?
+
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver_later(self)
+    end
+  end
+
+  def push_message
+    push_data.to_json
+  end
+
+  def push_data
+    {
+      title: push_title,
+      body: push_body,
+      url: push_url,
+      tag: id
+    }
+  end
+
+  private
+    def push_on_create
+      push_later unless read?
+    end
+
+    def push_on_update
+      push_later if should_push?
+    end
+
+    def should_push?
+      !read? && (source_id_previously_changed? || source_type_previously_changed? || unread_count_previously_changed? || read_at_previously_changed?)
+    end
+
+    def push_title
+      ApplicationController.helpers.notification_title(self).presence || card.title.presence || "Fizzy"
+    end
+
+    def push_body
+      ApplicationController.helpers.notification_body(self).to_s
+    end
+
+    # A path, not an absolute URL. The service worker resolves it against its
+    # own origin, so the click opens the card even when BASE_URL is unset or
+    # the browser is on a different host than the mailer.
+    def push_url
+      Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..da53058
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,70 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }, length: { maximum: 1024 }
+  validate :endpoint_must_be_https_url
+
+  normalizes :endpoint, :p256dh_key, :auth_key, with: ->(value) { value.to_s.strip }
+
+  class << self
+    # Ops provides the VAPID key pair. Push is skipped when either key is absent.
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].to_s.strip.presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].to_s.strip.presence
+    end
+
+    def vapid_subject
+      if (from = ENV["MAILER_FROM_ADDRESS"].presence)
+        address = from[/<([^>]+)>/, 1] || from.strip
+        address.include?("@") ? "mailto:#{address}" : address
+      elsif (base_url = ENV["BASE_URL"].presence)
+        base_url
+      else
+        "mailto:support@fizzy.do"
+      end
+    end
+
+    def vapid
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+  end
+
+  def deliver_later(notification)
+    DeliveryJob.perform_later(self, notification)
+  end
+
+  def deliver_now(notification)
+    return unless self.class.configured?
+    return unless notification.user.active?
+
+    WebPush.payload_send(
+      message: notification.push_message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid,
+      ttl: 1.day.to_i
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def endpoint_must_be_https_url
+      return if endpoint.blank?
+
+      uri = URI.parse(endpoint)
+      errors.add(:endpoint, "must be an https URL") unless uri.is_a?(URI::HTTPS) && uri.host.present?
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be a URL")
+    end
+end
