diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..660c895 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,48 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  let data = {}
+
+  try {
+    data = event.data ? event.data.json() : {}
+  } catch (error) {
+    data = { title: "Fizzy", body: event.data ? event.data.text() : "" }
+  }
+
+  const title = data.title || "Fizzy"
+  const options = {
+    body: data.body || "",
+    icon: "/app-icon-192.png",
+    badge: "/favicon.png",
+    tag: data.tag,
+    renotify: Boolean(data.tag),
+    data: { url: data.url || data.path }
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data && event.notification.data.url
+  if (!url) return
+
+  event.waitUntil(openCard(url))
+})
+
+async function openCard(url) {
+  const absolute = new URL(url, self.location.origin).href
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of windows) {
+    if (client.url.split("#")[0] === absolute.split("#")[0] && "focus" in client) {
+      return client.focus()
+    }
+  }
+
+  return self.clients.openWindow(absolute)
+}
+
 TurboOffline.start()
