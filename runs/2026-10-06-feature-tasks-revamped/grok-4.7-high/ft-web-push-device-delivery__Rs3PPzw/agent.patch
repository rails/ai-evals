+<section class="settings__section hide-on-native">
+  <heading>
+    <h2 class="divider">Push Notifications</h2>
+    <div>Whatever lands in your tray also reaches this phone or desktop.</div>
+  </heading>
+
+  <% if PushSubscription.configured? %>
+    <div class="notifications"
+         data-controller="notifications"
+         data-notifications-public-key-value="<%= PushSubscription.vapid_public_key %>"
+         data-notifications-url-value="<%= user_push_subscriptions_path(Current.user) %>"
+         data-notifications-subscriptions-value="<%= Current.user.push_subscriptions.map { |subscription| { id: subscription.id, endpoint: subscription.endpoint } }.to_json %>">
+      <div class="notifications__status panel">
+        <div class="flex align-center gap">
+          <%= icon_tag "bell" %>
+          <div class="flex-item-grow">
+            <p class="notifications__off-message margin-none"><strong>Off for this device.</strong> Turn this on to get tray notifications here.</p>
+            <p class="notifications__on-message margin-none"><strong>On for this device.</strong> New tray items will show up here too.</p>
+          </div>
+
+          <label class="switch">
+            <input type="checkbox" class="switch__input" data-notifications-target="toggle" data-action="change->notifications#toggle">
+            <span class="switch__btn"></span>
+            <span class="for-screen-reader">Toggle push notifications for this device</span>
+          </label>
+        </div>
+      </div>
+
+      <div class="notifications-help__explainer" data-notifications-target="help" hidden>
+        <p>Notifications are blocked for this browser. Allow them, then turn the switch on again.</p>
+        <%= render "notifications/settings/browser" %>
+        <%= render "notifications/settings/system" %>
+        <%= render "notifications/settings/install" %>
+      </div>
+    </div>
+  <% else %>
+    <p class="notifications-help__explainer">Push notifications aren't set up on this server yet.</p>
+  <% end %>
+</section>
