--- /dev/null
+++ b/app/models/account/incineratable/incineration.rb
@@ -0,0 +1,141 @@
+class Account::Incineratable::Incineration
+  # Join tables have no account_id. They are removed by the records they point at.
+  FILTER_JOINS = [
+    [ "assignees_filters", "assignee_id", "users" ],
+    [ "assignees_filters", "filter_id", "filters" ],
+    [ "assigners_filters", "assigner_id", "users" ],
+    [ "assigners_filters", "filter_id", "filters" ],
+    [ "boards_filters", "board_id", "boards" ],
+    [ "boards_filters", "filter_id", "filters" ],
+    [ "closers_filters", "closer_id", "users" ],
+    [ "closers_filters", "filter_id", "filters" ],
+    [ "creators_filters", "creator_id", "users" ],
+    [ "creators_filters", "filter_id", "filters" ],
+    [ "filters_tags", "tag_id", "tags" ],
+    [ "filters_tags", "filter_id", "filters" ]
+  ].freeze
+
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    if due?
+      stored_files = capture_stored_files
+
+      Account.transaction do
+        delete_records_without_account_id
+        delete_records_with_account_id
+        @account.delete
+      end
+
+      purge_stored_files(stored_files)
+    end
+  end
+
+  private
+    def due?
+      cancellation = @account.cancellation
+
+      if cancellation.present?
+        cancellation.created_at < Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+      else
+        false
+      end
+    end
+
+    def capture_stored_files
+      ActiveStorage::Blob.where(account_id: @account.id).pluck(:service_name, :key)
+    end
+
+    def delete_records_without_account_id
+      delete_filter_joins
+      delete_storage_totals
+      delete_search_index
+    end
+
+    def delete_filter_joins
+      FILTER_JOINS.each do |table, column, source_table|
+        delete_referencing(table, column, source_table)
+      end
+    end
+
+    def delete_referencing(table, column, source_table)
+      connection = Account.connection
+      connection.delete(<<~SQL.squish)
+        DELETE FROM #{connection.quote_table_name(table)}
+        WHERE #{connection.quote_column_name(column)} IN (
+          SELECT id FROM #{connection.quote_table_name(source_table)}
+          WHERE account_id = #{quoted_account_id(connection)}
+        )
+      SQL
+    end
+
+    def delete_storage_totals
+      connection = Account.connection
+      quoted_id = quoted_account_id(connection)
+
+      connection.delete(<<~SQL.squish)
+        DELETE FROM #{connection.quote_table_name("storage_totals")}
+        WHERE (owner_type = #{connection.quote("Account")} AND owner_id = #{quoted_id})
+           OR (owner_type = #{connection.quote("Board")} AND owner_id IN (
+             SELECT id FROM #{connection.quote_table_name("boards")}
+             WHERE account_id = #{quoted_id}
+           ))
+      SQL
+    end
+
+    def delete_search_index
+      if Fizzy.db_adapter.sqlite?
+        connection = Account.connection
+        connection.delete(<<~SQL.squish)
+          DELETE FROM search_records_fts
+          WHERE rowid IN (
+            SELECT id FROM search_records
+            WHERE account_id = #{quoted_account_id(connection)}
+          )
+        SQL
+      end
+    end
+
+    def delete_records_with_account_id
+      connections.each do |connection|
+        connection.tables.uniq.each do |table|
+          if account_scoped_table?(connection, table)
+            connection.delete(<<~SQL.squish)
+              DELETE FROM #{connection.quote_table_name(table)}
+              WHERE account_id = #{quoted_account_id(connection)}
+            SQL
+          end
+        end
+      end
+    end
+
+    def connections
+      if Fizzy.saas? && defined?(SaasRecord)
+        [ Account.connection, SaasRecord.connection ].uniq
+      else
+        [ Account.connection ]
+      end
+    end
+
+    def account_scoped_table?(connection, table)
+      connection.column_exists?(table, "account_id")
+    rescue ActiveRecord::StatementInvalid
+      false
+    end
+
+    def quoted_account_id(connection)
+      connection.quote(ActiveRecord::Type::Uuid.new.serialize(@account.id))
+    end
+
+    def purge_stored_files(stored_files)
+      stored_files.each do |service_name, key|
+        service = ActiveStorage::Blob.services.fetch(service_name)
+        service.delete(key)
+        service.delete_prefixed("variants/#{key}/")
+      rescue => error
+        Rails.error.report(error, context: { account_id: @account.id, blob_key: key })
+      end
+    end
+end
