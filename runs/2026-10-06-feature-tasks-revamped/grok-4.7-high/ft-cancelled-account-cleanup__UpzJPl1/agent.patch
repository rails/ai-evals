diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..fa1539a
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @identity = identities(:david)
+    @kept_account = accounts("37s")
+    @account = Account.create_with_owner(
+      account: { name: "Doomed Account" },
+      owner: { identity: @identity, name: "David" }
+    )
+    @owner = @account.users.find_by!(role: :owner)
+
+    Current.set(account: @account, user: @owner) do
+      @board = @account.boards.create!(name: "Doomed Board", creator: @owner, all_access: true)
+      @column = @board.columns.create!(name: "Doing")
+      @card = @board.cards.create!(title: "Doomed Card", creator: @owner, status: "published", column: @column)
+      @comment = @card.comments.create!(body: "Secret comment", creator: @owner)
+      @tag = @account.tags.create!(title: "Doomed")
+      @card.taggings.create!(tag: @tag)
+      @card.steps.create!(content: "A step")
+      @card.assignments.create!(assignee: @owner, assigner: @owner)
+      @card.image.attach(io: StringIO.new("png-bytes"), filename: "secret.png", content_type: "image/png")
+      @blob = @card.image.blob
+
+      @filter = @owner.filters.create!
+      @filter.tags = [ @tag ]
+      @filter.assignees = [ @owner ]
+      @filter.creators = [ @owner ]
+      @filter.closers = [ @owner ]
+      @filter.update!(board_ids: [ @board.id ])
+
+      @webhook = @board.webhooks.create!(name: "Hook", url: "https://example.com/webhook")
+      Storage::Total.create!(owner: @account, bytes_stored: 12)
+      Storage::Total.create!(owner: @board, bytes_stored: 7)
+    end
+  end
+
+  test "permanently removes data for accounts canceled more than 30 days ago" do
+    cancel_at(@account, 31.days.ago)
+    kept_card = @kept_account.cards.first
+    blob_path = ActiveStorage::Blob.service.path_for(@blob.key)
+    assert File.exist?(blob_path), "expected the attached file to be stored before incineration"
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(@owner.id)
+    assert_not Board.exists?(@board.id)
+    assert_not Card.exists?(@card.id)
+    assert_not Comment.exists?(@comment.id)
+    assert_not Tag.exists?(@tag.id)
+    assert_not Webhook.exists?(@webhook.id)
+    assert_not ActiveStorage::Blob.exists?(@blob.id)
+    assert_not File.exist?(blob_path)
+    assert Identity.exists?(@identity.id), "shared identities are global and must survive account incineration"
+    assert User.exists?(users(:david).id)
+    assert Card.exists?(kept_card.id)
+    assert_no_account_rows(@account.id)
+    assert_no_dangling_references(@account, @owner, @board, @card, @tag, @filter)
+  end
+
+  test "keeps accounts canceled less than 30 days ago" do
+    cancel_at(@account, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Card.exists?(@card.id)
+    assert User.exists?(@owner.id)
+  end
+
+  test "keeps accounts canceled exactly 30 days ago" do
+    cancelled_at = Time.current.change(usec: 0)
+    cancel_at(@account, cancelled_at)
+
+    travel_to cancelled_at + 30.days do
+      Account::IncinerateDueJob.perform_now
+      assert Account.exists?(@account.id)
+    end
+  end
+
+  test "incinerates once the grace period has fully elapsed" do
+    cancelled_at = Time.current.change(usec: 0)
+    cancel_at(@account, cancelled_at)
+
+    travel_to cancelled_at + 30.days + 1.second do
+      Account::IncinerateDueJob.perform_now
+      assert_not Account.exists?(@account.id)
+      assert_no_account_rows(@account.id)
+    end
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@kept_account.id)
+  end
+
+  test "does not incinerate an account that was reactivated" do
+    cancel_at(@account, 45.days.ago)
+    @account.reactivate
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(@account.id)
+    assert_not @account.reload.cancelled?
+  end
+
+  test "is idempotent" do
+    cancel_at(@account, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+    assert_nothing_raised { Account::IncinerateDueJob.perform_now }
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "is declared as a recurring job" do
+    source = Rails.root.join("config/recurring.yml").read
+    assert_match "class: Account::IncinerateDueJob", source
+  end
+
+  private
+    def cancel_at(account, time)
+      account.cancel(initiated_by: @owner)
+      account.cancellation.update_columns(created_at: time, updated_at: time)
+    end
+
+    def assert_no_account_rows(account_id)
+      connection = Account.connection
+      quoted = connection.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))
+
+      connection.tables.each do |table|
+        next unless connection.column_exists?(table, "account_id")
+
+        count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{quoted}").to_i
+        assert_equal 0, count, "expected #{table} to have no rows for the incinerated account"
+      end
+    end
+
+    def assert_no_dangling_references(account, owner, board, card, tag, filter)
+      connection = Account.connection
+      quote = ->(id) { connection.quote(ActiveRecord::Type::Uuid.new.serialize(id)) }
+
+      leftovers = {
+        "assignees_filters" => connection.select_value("SELECT COUNT(*) FROM assignees_filters WHERE assignee_id = #{quote.call(owner.id)} OR filter_id = #{quote.call(filter.id)}"),
+        "boards_filters" => connection.select_value("SELECT COUNT(*) FROM boards_filters WHERE board_id = #{quote.call(board.id)} OR filter_id = #{quote.call(filter.id)}"),
+        "filters_tags" => connection.select_value("SELECT COUNT(*) FROM filters_tags WHERE tag_id = #{quote.call(tag.id)} OR filter_id = #{quote.call(filter.id)}"),
+        "storage_totals" => connection.select_value("SELECT COUNT(*) FROM storage_totals WHERE owner_id IN (#{quote.call(account.id)}, #{quote.call(board.id)})")
+      }
+
+      leftovers.each do |table, count|
+        assert_equal 0, count.to_i, "expected no leftover rows in #{table}"
+      end
+
+      assert_equal 0, ActionText::RichText.where(record: card).count
+      assert_equal 0, ActionText::RichText.where(record: @comment).count
+    end
+end
