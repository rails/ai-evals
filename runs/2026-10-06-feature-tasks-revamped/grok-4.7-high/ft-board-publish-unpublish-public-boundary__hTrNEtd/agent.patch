+class Board::Publication < ApplicationRecord
+  belongs_to :account, default: -> { board.account }
+  belongs_to :board, touch: true, inverse_of: :publication
+
+  has_secure_token :key
+
+  validates :key, presence: true, uniqueness: true
+
+  after_commit :touch_cards
+
+  def to_param
+    key
+  end
+
+  private
+    def touch_cards
+      board.cards.touch_all
+    end
+end
diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..d3caf9f
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication", inverse_of: :board
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    if publication
+      publication.destroy!
+      reload_publication
+    end
+  end
+end
