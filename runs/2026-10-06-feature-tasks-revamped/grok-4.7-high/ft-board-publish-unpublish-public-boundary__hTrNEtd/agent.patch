@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anyone can view a published board without signing in" do
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_in_body @board.name
+    assert_in_body "Triage"
+    assert_in_body "In progress"
+    assert_in_body "Layout is broken"
+    assert_in_body "Buy domain"
+    assert_in_body "We need to ship the app"
+  end
+
+  test "published board is visible without an account slug" do
+    untenanted do
+      get public_board_path(@key)
+    end
+
+    assert_response :success
+    assert_in_body @board.name
+  end
+
+  test "unpublished and unknown boards are not found" do
+    @board.unpublish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_path("missing-key")
+    assert_response :not_found
+  end
+
+  test "draft cards are not shown" do
+    @board.cards.create!(creator: users(:david), title: "Secret draft title", status: "drafted")
+
+    get public_board_path(@key)
+
+    assert_response :success
+    assert_no_match "Secret draft title", response.body
+  end
+
+  test "a column can be opened directly" do
+    column = columns(:writebook_in_progress)
+
+    get public_board_column_path(@key, column)
+
+    assert_response :success
+    assert_in_body column.name
+    assert_in_body "The text is too small"
+    assert_no_match "Layout is broken", response.body
+  end
+
+  test "a column from another board is not found" do
+    other = Board.create!(name: "Other", creator: users(:kevin), account: accounts("37s"))
+    column = other.columns.create!(name: "Elsewhere", color: columns(:writebook_triage).color.to_s)
+
+    get public_board_column_path(@key, column)
+
+    assert_response :not_found
+  end
+
+  test "a published card can be opened directly" do
+    card = cards(:logo)
+
+    get public_board_card_path(@key, card.number)
+
+    assert_response :success
+    assert_select "h1", text: /The logo/
+    assert_in_body "I agree."
+  end
+
+  test "a published card can be opened as JSON without emails" do
+    card = cards(:logo)
+
+    get public_board_card_path(@key, card.number), as: :json
+
+    assert_response :success
+    json = @response.parsed_body
+    assert_equal card.title, json["title"]
+    assert_equal card.number, json["number"]
+    assert_equal @board.name, json["board"]["name"]
+    assert_not_includes response.body, users(:david).identity.email_address
+  end
+
+  test "draft cards and cards from other boards are not found" do
+    draft = @board.cards.create!(creator: users(:david), title: "Secret draft title", status: "drafted")
+
+    get public_board_card_path(@key, draft.number)
+    assert_response :not_found
+
+    get public_board_card_path(@key, 999_999)
+    assert_response :not_found
+  end
+
+  test "old secret stops working after unpublish" do
+    @board.unpublish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :not_found
+
+    get public_board_card_path(@key, cards(:logo).number)
+    assert_response :not_found
+  end
+
+  test "public board JSON does not include user emails" do
+    get public_board_path(@key), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_not_includes response.body, users(:david).identity.email_address
+  end
+end
+
+class Public::BoardsEdgeCaseTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "closed published cards can be opened" do
+    get public_board_card_path(@key, cards(:shipping).number)
+
+    assert_response :success
+    assert_in_body "We need to ship the app"
+    assert_in_body "Done"
+  end
+
+  test "a publication key is not visible under a different account" do
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+
+    assert_response :not_found
+  end
+
+  test "cancelled accounts do not expose public boards" do
+    Account::Cancellation.create!(account: accounts("37s"), initiated_by: users(:kevin))
+
+    get public_board_path(@key)
+
+    assert_response :not_found
+  end
+
+  test "secret pages ask crawlers not to index them" do
+    get public_board_path(@key)
+
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "missing columns are not found" do
+    get public_board_column_path(@key, "missing-column")
+
+    assert_response :not_found
+  end
+
+  test "raw paths work with and without an account prefix" do
+    get "/public/boards/#{@key}"
+    assert_response :success
+
+    get "#{accounts("37s").slug}/public/boards/#{@key}/cards/#{cards(:layout).number}"
+    assert_response :success
+    assert_in_body "Layout is broken"
+  end
+  test "an empty published board renders" do
+    board = Board.create!(name: "Empty public board", creator: users(:kevin), account: accounts("37s"))
+    board.publish
+
+    get public_board_path(board.publication.key)
+
+    assert_response :success
+    assert_in_body "Empty public board"
+  end
+
+  test "cards without a column can be opened" do
+    get public_board_card_path(@key, cards(:buy_domain).number), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["column"]
+    assert_equal "Buy domain", @response.parsed_body["title"]
+  end
+end
