diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..3e0c160
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,41 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <p class="margin-none-block-start">Anyone with this secret link can view the board, its columns, and its published cards. Drafts stay private.</p>
+
+    <% url = board_public_url(board) %>
+    <div class="flex align-center gap-half margin-block-start">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public link">
+
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to board_publication_path(board), method: :delete, class: "btn btn--circle txt-small",
+              data: { turbo_frame: "_top", turbo_confirm: "Unpublish this board? The current link will stop working." } do %>
+          <%= icon_tag "close" %>
+          <span class="for-screen-reader">Unpublish</span>
+        <% end %>
+      <% end %>
+    </div>
+
+    <div class="center margin-block-start">
+      <%= tag.button class: "btn btn--link", type: "button", data: {
+            controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+            copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: url } do %>
+        <%= icon_tag "copy-paste" %>
+        <span>Copy public link</span>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to share a secret link. Anyone with the link can view published cards. Drafts stay private.</p>
+
+    <% if Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :post, class: "btn btn--link margin-block-start",
+            data: { turbo_frame: "_top" } do %>
+        <%= icon_tag "share" %>
+        <span>Publish board</span>
+      <% end %>
+    <% else %>
+      <p class="txt-small">Only admins can publish this board.</p>
+    <% end %>
+  <% end %>
+</div>
