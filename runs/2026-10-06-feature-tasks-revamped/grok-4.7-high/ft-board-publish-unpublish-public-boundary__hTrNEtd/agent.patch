@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publish creates a unique secret and unpublish removes it" do
+    assert_not @board.published?
+
+    publication = @board.publish
+
+    assert @board.published?
+    assert publication.key.present?
+    assert_equal publication, @board.publish
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+end
