diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..b5af2d3
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,65 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@publication.key), class: "btn" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card card-perma panel" id="<%= dom_id(@card) %>" style="--card-color: <%= @card.color %>;">
+  <header class="card__header">
+    <p class="card__meta-text">
+      #<%= @card.number %>
+      <% if @card.column %>
+        · <%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column) %>
+      <% end %>
+      <% if @card.closed? %>
+        · Done
+      <% elsif @card.postponed? %>
+        · Not now
+      <% end %>
+    </p>
+  </header>
+
+  <% if @card.image.attached? %>
+    <%= image_tag @card.image, alt: "", class: "card__background" %>
+  <% end %>
+
+  <% if @card.description.present? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <p class="card__tags"><%= @card.tags.map(&:title).to_sentence %></p>
+  <% end %>
+
+  <% if @card.assignees.any? %>
+    <p>Assigned to <%= @card.assignees.map(&:name).to_sentence %></p>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul>
+      <% @card.steps.each do |step| %>
+        <li><%= step.completed? ? "Done:" : "Todo:" %> <%= step.content %></li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
+
+<% if @comments.any? %>
+  <section>
+    <h2>Comments</h2>
+    <% @comments.each do |comment| %>
+      <article class="comment" id="<%= dom_id(comment) %>">
+        <h3><%= comment.creator.name %></h3>
+        <div class="lexxy-content"><%= comment.body %></div>
+      </article>
+    <% end %>
+  </section>
+<% end %>
