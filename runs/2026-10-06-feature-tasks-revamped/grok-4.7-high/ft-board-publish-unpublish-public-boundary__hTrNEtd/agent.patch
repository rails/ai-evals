 - The `users` array contains the current page of results; if there are more users, follow the `Link` response header with `rel="next"`
 
 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+
+## Publishing
+
+Publishing a board creates a secret public URL. Anyone with that URL can view the board, its columns, and its published cards — no login required. Draft cards stay private. Only board administrators can publish or unpublish a board.
+
+`public_url` on the board JSON is `null` until the board is published.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board. Publishing again keeps the existing secret URL.
+
+__Response:__
+
+Returns `201 Created` when the board is newly published, or `200 OK` if it was already published, with the board in the same shape as `GET /:account_slug/boards/:board_id`. `public_url` is the secret URL.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board and invalidates the secret URL. Publishing again generates a new URL.
+
+__Response:__
+
+Returns `204 No Content`.
+
+### Public pages
+
+These pages do not require authentication. The `:key` is the secret from `public_url`.
+
+- `GET /:account_slug/public/boards/:key`
+- `GET /:account_slug/public/boards/:key/columns/:id`
+- `GET /:account_slug/public/boards/:key/cards/:number`
+
+The same paths also work without the account slug. Unpublished boards, draft cards, and unknown keys respond with `404 Not Found`.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..b50809e
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "public_url is nil by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "index includes a nil public_url by default" do
+    get boards_path, as: :json
+
+    assert_response :success
+    board = @response.parsed_body.find { |json| json["id"] == @board.id }
+    assert_nil board["public_url"]
+  end
+
+  test "admin can publish a board" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+    assert @board.published?
+    assert_equal board_public_url(@board), @response.parsed_body["public_url"]
+    assert_match %r{/public/boards/#{@board.publication.key}\z}, @response.parsed_body["public_url"]
+  end
+
+  test "publishing is idempotent" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :ok
+    assert_equal key, @board.reload.publication.key
+    assert_equal board_public_url(@board), @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "unpublishing an unpublished board is a no-op" do
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "html publish and unpublish redirect back to settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_response :success
+    assert_in_body @board.reload.publication.key
+    assert @board.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "board creator can publish even if they are not an account admin" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "members cannot publish or unpublish a board they do not administer" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "republishing generates a new secret" do
+    @board.publish
+    old_key = @board.publication.key
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_key, @board.reload.publication.key
+  end
+
+  private
+    def board_public_url(board)
+      public_board_url(board.publication.key, script_name: board.account.slug)
+    end
+end
