diff --git a/config/initializers/account_tenancy.rb b/config/initializers/account_tenancy.rb
new file mode 100644
index 0000000..9f58384
--- /dev/null
+++ b/config/initializers/account_tenancy.rb
@@ -0,0 +1,72 @@
+# Tenant rows carry a required account_id. Gem models and HABTM join tables
+# don't go through our ApplicationRecord defaults, so assign it here.
+
+module HabtmAccountTenancy
+  def through_model
+    model = super
+    model.before_validation :assign_tenant_account_id, on: :create
+    model.define_method(:assign_tenant_account_id) do
+      return unless has_attribute?(:account_id)
+      return if self[:account_id].present?
+      return unless has_attribute?(:filter_id) && filter_id.present?
+
+      self.account_id = Filter.where(id: filter_id).pick(:account_id) || Current.account&.id
+    end
+    model
+  end
+end
+
+ActiveRecord::Associations::Builder::HasAndBelongsToMany.prepend(HabtmAccountTenancy)
+
+module ActiveStorageAttachAccountContext
+  def attach(...)
+    account = record.try(:account)
+    if account && Current.account.nil?
+      Current.set(account: account) { super }
+    else
+      super
+    end
+  end
+end
+
+module ActiveStorageVariantAccountContext
+  private
+    def create_or_find_record(...)
+      account = blob.try(:account) || Current.account
+      if account
+        Current.set(account: account) { super }
+      else
+        super
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.try(:account) || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.try(:account) || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) || Current.account }
+end
+
+Rails.application.config.to_prepare do
+  unless ActiveStorage::Attached::One.ancestors.include?(ActiveStorageAttachAccountContext)
+    ActiveStorage::Attached::One.prepend(ActiveStorageAttachAccountContext)
+  end
+
+  unless ActiveStorage::Attached::Many.ancestors.include?(ActiveStorageAttachAccountContext)
+    ActiveStorage::Attached::Many.prepend(ActiveStorageAttachAccountContext)
+  end
+
+  unless ActiveStorage::VariantWithRecord.ancestors.include?(ActiveStorageVariantAccountContext)
+    ActiveStorage::VariantWithRecord.prepend(ActiveStorageVariantAccountContext)
+  end
+end
