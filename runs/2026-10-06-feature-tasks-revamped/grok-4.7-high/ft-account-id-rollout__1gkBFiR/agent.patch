+class RequireAccountIdOnTenantTables < ActiveRecord::Migration[8.2]
+  # Tenant tables that already have account_id, but it is still nullable.
+  NULLABLE_ACCOUNT_TABLES = %w[
+    account_imports
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ].freeze
+
+  # Backfill existing nullable account_ids from a parent that already has one.
+  # Ordered so children are filled after their parents.
+  EXISTING_BACKFILLS = [
+    [ "boards", "users", "creator_id" ],
+    [ "cards", "boards", "board_id" ],
+    [ "columns", "boards", "board_id" ],
+    [ "comments", "cards", "card_id" ],
+    [ "events", "boards", "board_id" ],
+    [ "filters", "users", "creator_id" ],
+    [ "notification_bundles", "users", "user_id" ],
+    [ "notifications", "users", "user_id" ],
+    [ "push_subscriptions", "users", "user_id" ],
+    [ "steps", "cards", "card_id" ],
+    [ "webhooks", "boards", "board_id" ]
+  ].freeze
+
+  # Tables that hold an account's data but never received account_id.
+  PARENT_BACKFILLS = [
+    [ "accesses", "boards", "board_id" ],
+    [ "assignments", "cards", "card_id" ],
+    [ "board_publications", "boards", "board_id" ],
+    [ "card_activity_spikes", "cards", "card_id" ],
+    [ "card_goldnesses", "cards", "card_id" ],
+    [ "card_not_nows", "cards", "card_id" ],
+    [ "closures", "cards", "card_id" ],
+    [ "pins", "cards", "card_id" ],
+    [ "search_queries", "users", "user_id" ],
+    [ "taggings", "cards", "card_id" ],
+    [ "user_settings", "users", "user_id" ],
+    [ "watches", "cards", "card_id" ],
+    [ "webhook_delinquency_trackers", "webhooks", "webhook_id" ],
+    [ "webhook_deliveries", "webhooks", "webhook_id" ]
+  ].freeze
+
+  JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  POLYMORPHIC_TABLES = {
+    "entropies" => [ "container_type", "container_id" ],
+    "mentions" => [ "source_type", "source_id" ],
+    "reactions" => [ "reactable_type", "reactable_id" ],
+    "action_text_rich_texts" => [ "record_type", "record_id" ],
+    "active_storage_attachments" => [ "record_type", "record_id" ],
+    "storage_totals" => [ "owner_type", "owner_id" ]
+  }.freeze
+
+  # Polymorphic type => [table, column that holds the account id (or the account's own id)].
+  TYPE_SOURCES = {
+    "Account" => [ "accounts", "id" ],
+    "Board" => [ "boards", "account_id" ],
+    "Card" => [ "cards", "account_id" ],
+    "Comment" => [ "comments", "account_id" ],
+    "User" => [ "users", "account_id" ],
+    "Export" => [ "exports", "account_id" ],
+    "Account::Import" => [ "account_imports", "account_id" ],
+    "Event" => [ "events", "account_id" ],
+    "ActionText::RichText" => [ "action_text_rich_texts", "account_id" ],
+    "ActiveStorage::Blob" => [ "active_storage_blobs", "account_id" ],
+    "ActiveStorage::VariantRecord" => [ "active_storage_variant_records", "account_id" ]
+  }.freeze
+
+  def up
+    backfill_existing_account_ids
+    add_missing_account_columns
+    backfill_new_account_ids
+    drop_orphans
+    require_account_ids
+    index_account_ids
+  end
+
+  def down
+    new_tables.each do |table|
+      next unless table_exists?(table) && column_exists?(table, :account_id)
+
+      remove_index table, :account_id if index_exists?(table, :account_id)
+      remove_column table, :account_id
+    end
+
+    NULLABLE_ACCOUNT_TABLES.each do |table|
+      next unless table_exists?(table) && column_exists?(table, :account_id)
+
+      change_column_null table, :account_id, true
+    end
+  end
+
+  private
+    def backfill_existing_account_ids
+      EXISTING_BACKFILLS.each do |table, parent, foreign_key|
+        backfill_from_parent(table, parent, foreign_key)
+      end
+    end
+
+    def add_missing_account_columns
+      new_tables.each do |table|
+        next unless table_exists?(table)
+        next if column_exists?(table, :account_id)
+
+        add_column table, :account_id, :uuid
+      end
+    end
+
+    def backfill_new_account_ids
+      PARENT_BACKFILLS.each do |table, parent, foreign_key|
+        backfill_from_parent(table, parent, foreign_key)
+      end
+
+      JOIN_TABLES.each do |table|
+        backfill_from_parent(table, "filters", "filter_id")
+      end
+
+      # Records whose parents already have account_id.
+      backfill_polymorphic_from(TYPE_SOURCES.except("ActionText::RichText", "ActiveStorage::Blob", "ActiveStorage::VariantRecord"))
+
+      # Rich text can now be used as a parent for embeds.
+      backfill_polymorphic_from(TYPE_SOURCES.slice("ActionText::RichText"))
+
+      backfill_blobs_from_attachments
+      backfill_variant_records_from_blobs
+      backfill_polymorphic_from(TYPE_SOURCES.slice("ActiveStorage::VariantRecord", "ActiveStorage::Blob"))
+      backfill_blobs_from_attachments
+    end
+
+    def drop_orphans
+      tenant_tables_with_account.each do |table|
+        execute <<~SQL
+          DELETE FROM #{table}
+          WHERE account_id IS NULL
+             OR NOT EXISTS (
+               SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id
+             )
+        SQL
+      end
+    end
+
+    def require_account_ids
+      tenant_tables_with_account.each do |table|
+        change_column_null table, :account_id, false
+      end
+    end
+
+    def index_account_ids
+      tenant_tables_with_account.each do |table|
+        next if account_indexed?(table)
+
+        add_index table, :account_id
+      end
+    end
+
+    def new_tables
+      PARENT_BACKFILLS.map(&:first) +
+        JOIN_TABLES +
+        POLYMORPHIC_TABLES.keys +
+        %w[ active_storage_blobs active_storage_variant_records ]
+    end
+
+    def tenant_tables_with_account
+      connection.tables.select { |table| column_exists?(table, :account_id) }
+    end
+
+    def backfill_from_parent(table, parent, foreign_key)
+      return unless table_exists?(table) && column_exists?(table, :account_id)
+      return unless table_exists?(parent) && column_exists?(parent, :account_id)
+
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{parent}.account_id
+          FROM #{parent}
+          WHERE #{parent}.id = #{table}.#{foreign_key}
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+    end
+
+    def backfill_polymorphic_from(sources)
+      POLYMORPHIC_TABLES.each do |table, (type_column, id_column)|
+        next unless table_exists?(table) && column_exists?(table, :account_id)
+
+        sources.each do |type_name, (parent, account_column)|
+          next unless table_exists?(parent) && column_exists?(parent, account_column)
+
+          execute <<~SQL
+            UPDATE #{table}
+            SET account_id = (
+              SELECT #{parent}.#{account_column}
+              FROM #{parent}
+              WHERE #{parent}.id = #{table}.#{id_column}
+            )
+            WHERE #{table}.account_id IS NULL
+              AND #{table}.#{type_column} = #{connection.quote(type_name)}
+          SQL
+        end
+      end
+    end
+
+    def backfill_blobs_from_attachments
+      return unless table_exists?("active_storage_blobs") && column_exists?("active_storage_blobs", :account_id)
+      return unless table_exists?("active_storage_attachments") && column_exists?("active_storage_attachments", :account_id)
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT MIN(active_storage_attachments.account_id)
+          FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+        )
+        WHERE active_storage_blobs.account_id IS NULL
+      SQL
+    end
+
+    def backfill_variant_records_from_blobs
+      return unless table_exists?("active_storage_variant_records") && column_exists?("active_storage_variant_records", :account_id)
+      return unless table_exists?("active_storage_blobs") && column_exists?("active_storage_blobs", :account_id)
+
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (
+          SELECT active_storage_blobs.account_id
+          FROM active_storage_blobs
+          WHERE active_storage_blobs.id = active_storage_variant_records.blob_id
+        )
+        WHERE active_storage_variant_records.account_id IS NULL
+      SQL
+    end
+
+    def account_indexed?(table)
