--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,10 @@
+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +16,41 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...RETENTION_PERIOD.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim_for_delivery
+
+    unless webhook.active?
+      update!(state: :errored, response: { error: "webhook_inactive" })
+      return
+    end
+
+    begin
+      body = render_event
+      headers = request_headers_for(body)
+      update!(request: { headers: headers })
+    rescue StandardError
+      record_error("delivery_failed")
+      return
+    end
+
+    begin
+      http_response = post(body, headers)
+    rescue StandardError
+      record_error("destination_unreachable", count_as_failure: true)
+      return
+    end
+
+    record_response(http_response)
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +68,63 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response.present? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def render_event
+      ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event }
+      )
+    end
+
+    def request_headers_for(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri, headers)
+      request.body = body
+
+      Net::HTTP.start(
+        uri.hostname,
+        uri.port,
+        use_ssl: uri.scheme == "https",
+        open_timeout: 5,
+        read_timeout: 15,
+        write_timeout: 15
+      ) do |http|
+        http.max_retries = 0
+        http.request(request)
+      end
+    end
+
+    def record_response(http_response)
+      update!(state: :completed, response: { code: http_response.code.to_i, error: nil })
+
+      if succeeded?
+        webhook.record_delivery_success
+      else
+        webhook.record_delivery_failure
+      end
+    end
+
+    def record_error(error, count_as_failure: false)
+      update!(state: :errored, response: { error: error })
+      webhook.record_delivery_failure if count_as_failure
+    end
 end
