--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,29 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    webhook.with_lock do
+      with_lock do
+        if first_failure_at.present? && first_failure_at >= FAILURE_WINDOW.ago
+          update!(consecutive_failures_count: consecutive_failures_count.to_i + 1)
+        else
+          update!(consecutive_failures_count: 1, first_failure_at: Time.current)
+        end
+
+        webhook.deactivate if consecutive_failures_count >= FAILURE_THRESHOLD && webhook.active?
+      end
+    end
+  end
+
+  def record_success
+    with_lock do
+      if consecutive_failures_count.to_i.positive? || first_failure_at.present?
+        update!(consecutive_failures_count: 0, first_failure_at: nil)
+      end
+    end
+  end
+end
