+++ b/test/models/webhook/triggering_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Webhook::TriggeringTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "an event creates one pending delivery for each active subscribed webhook" do
+    webhooks(:active).deactivate
+    board = boards(:writebook)
+    webhook = Webhook.create!(
+      board: board,
+      name: "Card publisher",
+      url: "https://example.test/webhooks",
+      subscribed_actions: [ "card_published" ]
+    )
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+        Event.create!(
+          board: board,
+          creator: users(:david),
+          eventable: cards(:logo),
+          action: "card_published"
+        )
+      end
+    end
+
+    event = Event.order(:created_at, :id).last
+    delivery = webhook.deliveries.find_by!(event: event)
+    assert_equal "pending", delivery.state
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_enqueued_jobs 0, only: Webhook::DeliveryJob do
+        webhook.deliver_later(event)
+        webhook.deliver_later(event)
+      end
+    end
+  end
+
+  test "events do not create deliveries for inactive or unsubscribed webhooks" do
+    webhooks(:active).deactivate
+    board = boards(:writebook)
+    Webhook.create!(
+      board: board,
+      name: "Unsubscribed",
+      url: "https://unsubscribed.example.test/webhooks",
+      subscribed_actions: [ "card_closed" ]
+    )
+    Webhook.create!(
+      board: board,
+      name: "Inactive",
+      url: "https://inactive.example.test/webhooks",
+      subscribed_actions: [ "card_published" ],
+      active: false
+    )
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_enqueued_jobs 0, only: Webhook::DeliveryJob do
+        Event.create!(
+          board: board,
+          creator: users(:david),
+          eventable: cards(:logo),
+          action: "card_published"
+        )
+      end
+    end
+  end
+end
