diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..62a99fa 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -75,6 +75,12 @@ Location: http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9
 
 Returns the created webhook in the response body.
 
+## Deliveries
+
+For each event on the board that matches an active webhook’s subscriptions, Fizzy sends one `POST` with a JSON payload representing the event and `Content-Type: application/json`. Requests include a `User-Agent` of `fizzy/1.0.0 Webhook` and an ISO 8601 `X-Webhook-Timestamp`. `X-Webhook-Signature` is the lowercase hexadecimal HMAC-SHA256 of the exact request body, using the webhook signing secret.
+
+Each event/webhook pair is recorded and attempted once; failed requests are not retried. A 2xx response is successful. Non-2xx responses and connection errors count as failures; a successful request resets the consecutive-failure count. Ten consecutive failures within an hour deactivate the webhook. An administrator can reactivate it from its settings. Delivery history is retained for one week.
+
 ## `PATCH /:account_slug/boards/:board_id/webhooks/:id`
 
 Updates a webhook.
diff --git a/test/models/webhook/delivery_dispatch_test.rb b/test/models/webhook/delivery_dispatch_test.rb
new file mode 100644
index 0000000..aa24757
--- /dev/null
+++ b/test/models/webhook/delivery_dispatch_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+require "openssl"
+require "time"
+
+class Webhook::DeliveryDispatchTest < ActiveSupport::TestCase
+  test "posts the event once with a signed payload and records the response" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = webhook.deliveries.create!(event: event)
+    stub_request(:post, webhook.url).to_return(status: 201, body: "created")
+
+    delivery.deliver_now
+    delivery.deliver_now
+
+    sent_request = nil
+    assert_requested(:post, webhook.url, times: 1) do |captured_request|
+      sent_request = captured_request
+      true
+    end
+
+    assert_equal "application/json", sent_request.headers["Content-Type"]
+    assert_equal "fizzy/1.0.0 Webhook", sent_request.headers["User-Agent"]
+    payload = JSON.parse(sent_request.body)
+    assert_equal event.id, payload["id"]
+    assert_equal "comment_created", payload["action"]
+    assert_match(/\A[0-9a-f]{64}\z/, sent_request.headers["X-Webhook-Signature"])
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, sent_request.body), sent_request.headers["X-Webhook-Signature"]
+    assert Time.iso8601(sent_request.headers["X-Webhook-Timestamp"])
+
+    delivery.reload
+    assert_equal "completed", delivery.state
+    assert_equal 201, delivery.response[:code]
+    assert_nil delivery.response[:error]
+    assert_predicate delivery, :succeeded?
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+
+  test "records a failed receiver response and deactivates after ten consecutive failures" do
+    webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Failing receiver",
+      url: "https://failing.example.test/webhooks",
+      subscribed_actions: [ "card_published" ]
+    )
+    tracker = webhook.delinquency_tracker
+
+    9.times { tracker.record_failure }
+    assert webhook.reload.active?
+
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+    stub_request(:post, webhook.url).to_return(status: 503)
+    delivery.deliver_now
+
+    assert_equal "completed", delivery.reload.state
+    assert_equal 503, delivery.response[:code]
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
+
+  test "records an unreachable receiver as an error and counts the failure" do
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:text_published))
+    stub_request(:post, webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver_now
+    delivery.deliver_now
+    assert_requested :post, webhook.url, times: 1
+
+    assert_equal "errored", delivery.reload.state
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a failure streak expires after an hour and a success clears it" do
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+
+    travel_to 2.hours.ago do
+      tracker.record_failure
+    end
+    tracker.reload.record_failure
+
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert_operator tracker.first_failure_at, :>, 1.hour.ago
+
+    tracker.record_success
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "keeps deliveries for one week and removes older ones" do
+    webhook = Webhook.create!(
+      board: boards(:writebook),
+      name: "Retention test",
+      url: "https://retention.example.test/webhooks"
+    )
+    old_delivery = webhook.deliveries.create!(event: events(:layout_published))
+    retained_delivery = webhook.deliveries.create!(event: events(:shipping_closed))
+    old_delivery.update_columns(created_at: 1.week.ago - 1.second)
+    retained_delivery.update_columns(created_at: 1.week.ago + 1.second)
+
+    assert_difference -> { webhook.deliveries.count }, -1 do
+      Webhook::Delivery.cleanup
+    end
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(retained_delivery.id)
+  end
+end
diff --git a/test/models/webhook/triggering_test.rb b/test/models/webhook/triggering_test.rb
