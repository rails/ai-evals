new file mode 100644
index 0000000..5f07991
--- /dev/null
+++ b/app/jobs/storage_usage/refresh_job.rb
@@ -0,0 +1,18 @@
+class StorageUsage::RefreshJob < ApplicationJob
+  queue_as :backend
+
+  RECORDS = {
+    Account.name => Account,
+    Board.name => Board
+  }.freeze
+
+  # Refreshes by global record ID, so a queued job must not depend on a tenant that may be deleted.
+  def initialize(...)
+    super
+    @account = nil
+  end
+
+  def perform(record_type, record_id)
+    RECORDS.fetch(record_type).find_by(id: record_id)&.refresh_bytes_used_now
+  end
+end
