@@ -0,0 +1,209 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "board and account usage includes only supported files across the right scope" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    another_board = boards(:private)
+    card = cards(:logo)
+    comment = card.comments.create!(creator: users(:david), body: "A comment")
+
+    board_image = create_blob(11)
+    board_description_file = create_blob(13)
+    card_description_file = create_blob(17)
+    comment_file = create_blob(19)
+    another_board_image = create_blob(23)
+    ignored_avatar = create_blob(31)
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.image.attach(board_image)
+      add_embed(board, :public_description, board_description_file)
+      add_embed(card, :description, card_description_file)
+      add_embed(comment, :body, comment_file)
+
+      another_board_card = Card.create!(board: another_board, creator: users(:david), title: "Another card")
+      another_board_card.image.attach(another_board_image)
+
+      ActiveStorage::Attachment.create!(record: users(:david), name: "avatar", blob: ignored_avatar)
+
+      Current.with_account(accounts("initech")) do
+        another_account_card = cards(:radio)
+        another_account_card.image.attach(create_blob(29))
+      end
+    end
+
+    assert_equal 60, board.bytes_used
+    assert_equal 23, another_board.bytes_used
+    assert_equal 83, account.bytes_used
+    assert_equal 29, accounts("initech").reload.bytes_used
+  end
+
+  test "removing an embedded file refreshes board and account usage" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    description_file = create_blob(41)
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      add_embed(card, :description, description_file)
+    end
+
+    assert_equal 41, board.bytes_used
+    assert_equal 41, account.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.update!(description: "")
+    end
+
+    assert_equal 0, board.bytes_used
+    assert_equal 0, account.bytes_used
+  end
+
+test "moving a comment moves its embedded usage between boards" do
+  account = accounts("37s")
+  old_board = boards(:writebook)
+  new_board = boards(:private)
+  old_card = cards(:logo)
+  new_card = Card.create!(board: new_board, creator: users(:david), title: "Destination card", status: :published)
+  comment = old_card.comments.create!(creator: users(:david), body: "A comment")
+  file = create_blob(53)
+
+  perform_enqueued_jobs only: StorageUsage::RefreshJob do
+    add_embed(comment, :body, file)
+  end
+
+  assert_equal 53, old_board.bytes_used
+
+  perform_enqueued_jobs only: StorageUsage::RefreshJob do
+    comment.update!(card: new_card)
+  end
+
+  assert_equal 0, old_board.bytes_used
+  assert_equal 53, new_board.bytes_used
+  assert_equal 53, account.bytes_used
+end
+
+  test "deleting a board refreshes its account usage" do
+    account = accounts("37s")
+    board = boards(:private)
+    card = Card.create!(board: board, creator: users(:david), title: "Card with an image")
+    image = create_blob(43)
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.image.attach(image)
+    end
+
+    assert_equal 43, account.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      board.destroy!
+    end
+
+    assert_equal 0, account.bytes_used
+  end
+
+test "many embedded files trigger one background refresh" do
+  card = cards(:logo)
+  board = card.board
+  files = Array.new(25) { create_blob(2) }
+
+  assert_enqueued_jobs 1, only: StorageUsage::RefreshJob do
+    card.description.body = ActionText::Content.new.append_attachables(files)
+    card.save!
+  end
+
+  perform_enqueued_jobs only: StorageUsage::RefreshJob
+
+  assert_equal 50, board.bytes_used
+end
+
+  test "a refresh retries if an attachment changes during calculation" do
+    card = cards(:logo)
+    board = card.board
+    image = create_blob(47)
+    calculator = StorageUsage::Calculator
+    original_calculation = calculator.method(:call)
+    calls = 0
+
+    calculator.singleton_class.define_method(:call) do |record|
+      calls += 1
+      if calls == 1
+        record.refresh_bytes_used_later
+        1
+      else
+        original_calculation.call(record)
+      end
+    end
+
+    begin
+      perform_enqueued_jobs only: StorageUsage::RefreshJob do
+        card.image.attach(image)
+      end
+    ensure
+      calculator.singleton_class.define_method(:call, original_calculation)
+    end
+
+    assert_equal 47, board.bytes_used
+    assert_operator calls, :>=, 2
+  end
+
+  test "bytes_used queues at most one refresh while a calculation is pending" do
+    board = boards(:writebook)
+
+    assert_enqueued_jobs 1, only: StorageUsage::RefreshJob do
+      10.times { assert_equal 0, board.bytes_used }
+    end
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob
+
+    assert_equal 0, board.reload.bytes_used
+  end
+
+  test "image removal and moving a card recalculate both affected boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    image = create_blob(37)
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.image.attach(image)
+    end
+
+    assert_equal 37, old_board.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.update!(board: new_board)
+    end
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal 37, new_board.reload.bytes_used
+    assert_equal 37, card.account.reload.bytes_used
+
+    perform_enqueued_jobs only: StorageUsage::RefreshJob do
+      card.remove_image_later
+    end
+
+    assert_equal 0, new_board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  private
+    def create_blob(byte_size)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * byte_size),
+        filename: "#{SecureRandom.hex}.txt",
+        content_type: "text/plain",
+        identify: false
+      )
+    end
+
+    def add_embed(record, attribute, blob)
+      rich_text = record.public_send(attribute)
+      rich_text.body = ActionText::Content.new.append_attachables(blob)
+      record.save!
+    end
+end
