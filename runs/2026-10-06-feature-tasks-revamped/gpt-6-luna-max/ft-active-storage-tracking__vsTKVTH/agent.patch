@@ -0,0 +1,48 @@
+module StorageUsage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_storage_usage_board, if: :storage_usage_card_image?
+    before_destroy :remember_storage_usage_board, if: :storage_usage_card_image?
+
+    after_create_commit :refresh_storage_usage_board, if: :storage_usage_card_image?
+    after_update_commit :refresh_storage_usage_boards, if: :storage_usage_card_image?
+    after_destroy_commit :refresh_storage_usage_boards, if: :storage_usage_card_image?
+  end
+
+  def delete
+    board_id = storage_usage_board_id
+    result = super
+
+    if board_id
+      ActiveRecord.after_all_transactions_commit do
+        StorageUsage.refresh_board_later(board_id)
+      end
+    end
+
+    result
+  end
+
+  private
+    def remember_storage_usage_board
+      @storage_usage_previous_board_id = storage_usage_board_id
+    end
+
+    def refresh_storage_usage_board
+      StorageUsage.refresh_board_later(storage_usage_board_id)
+    end
+
+    def refresh_storage_usage_boards
+      [ @storage_usage_previous_board_id, storage_usage_board_id ].compact.uniq.each do |board_id|
+        StorageUsage.refresh_board_later(board_id)
+      end
+    end
+
+    def storage_usage_board_id
+      record&.board_id if storage_usage_card_image?
+    end
+
+    def storage_usage_card_image?
+      record_type == Card.polymorphic_name && name == "image"
+    end
+end
