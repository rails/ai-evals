diff --git a/app/models/concerns/storage_usage/refreshable.rb b/app/models/concerns/storage_usage/refreshable.rb
new file mode 100644
index 0000000..d6eb16f
--- /dev/null
+++ b/app/models/concerns/storage_usage/refreshable.rb
@@ -0,0 +1,100 @@
+module StorageUsage::Refreshable
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted?
+      current_usage = self.class.where(id: id).pick(:bytes_used, :bytes_used_version, :bytes_used_calculated_version)
+
+      if current_usage
+        enqueue_bytes_used_refresh_later if current_usage[1] != current_usage[2]
+        current_usage[0]
+      else
+        self[:bytes_used]
+      end
+    else
+      self[:bytes_used]
+    end
+  end
+
+  def refresh_bytes_used_later
+    return unless persisted?
+
+    should_enqueue = self.class.transaction do
+      updated = self.class.where(id: id).update_all("bytes_used_version = bytes_used_version + 1")
+      updated.positive? && claim_bytes_used_refresh
+    end
+
+    enqueue_bytes_used_refresh if should_enqueue
+  end
+
+  def refresh_bytes_used_now
+    record = self.class.find_by(id: id)
+    return unless record
+
+    version = record.bytes_used_version
+    if record.bytes_used_calculated_version == version
+      record.send(:clear_bytes_used_refresh, version)
+      return record.bytes_used
+    end
+
+    previous_bytes_used = record[:bytes_used]
+    calculated_bytes_used = StorageUsage::Calculator.call(record)
+    updated = self.class.where(id: id, bytes_used_version: version).update_all(
+      bytes_used: calculated_bytes_used,
+      bytes_used_calculated_version: version,
+      bytes_used_refresh_enqueued: false
+    )
+
+    if updated.positive?
+      if record.is_a?(Board) && previous_bytes_used != calculated_bytes_used
+        StorageUsage.refresh_account_later(record.account_id)
+      end
+
+      calculated_bytes_used
+    else
+      record.send(:retry_bytes_used_refresh_later)
+      self.class.find_by(id: id)&.bytes_used
+    end
+  end
+
+  private
+    def enqueue_bytes_used_refresh_later
+      should_enqueue = self.class.transaction { claim_bytes_used_refresh }
+      enqueue_bytes_used_refresh if should_enqueue
+    end
+
+    def claim_bytes_used_refresh
+      self.class.where(id: id, bytes_used_refresh_enqueued: false)
+        .update_all(bytes_used_refresh_enqueued: true).positive?
+    end
+
+    def enqueue_bytes_used_refresh
+      StorageUsage::RefreshJob.perform_later(self.class.name, id)
+    rescue StandardError
+      self.class.where(id: id, bytes_used_refresh_enqueued: true).update_all(bytes_used_refresh_enqueued: false)
+      raise
+    end
+
+    def clear_bytes_used_refresh(version)
+      self.class.where(
+        id: id,
+        bytes_used_version: version,
+        bytes_used_calculated_version: version
+      ).update_all(bytes_used_refresh_enqueued: false)
+
+      current = self.class.find_by(id: id)
+      if current && current.bytes_used_calculated_version != current.bytes_used_version
+        current.send(:retry_bytes_used_refresh_later)
+      end
+    end
+
+    def retry_bytes_used_refresh_later
+      self.class.where(id: id, bytes_used_refresh_enqueued: true)
+        .update_all(bytes_used_refresh_enqueued: false)
+
+      current = self.class.find_by(id: id)
+      if current && current.bytes_used_calculated_version != current.bytes_used_version
+        current.send(:enqueue_bytes_used_refresh_later)
+      end
+    end
+end
diff --git a/app/models/concerns/storage_usage/rich_text_tracking.rb b/app/models/concerns/storage_usage/rich_text_tracking.rb
new file mode 100644
index 0000000..e953600
--- /dev/null
+++ b/app/models/concerns/storage_usage/rich_text_tracking.rb
@@ -0,0 +1,55 @@
+module StorageUsage::RichTextTracking
+  extend ActiveSupport::Concern
+
+  included do
+    before_validation :clear_storage_usage_embeds_from_blank_body
+    before_save :remember_storage_usage_embed_change
+    after_save :refresh_storage_usage_after_embed_change, if: :storage_usage_embeds_changed?
+    before_destroy :remember_storage_usage_embeds_before_destroy, prepend: true
+    after_destroy :refresh_storage_usage_after_embed_change, if: :storage_usage_embeds_changed?
+  end
+
+  private
+    def clear_storage_usage_embeds_from_blank_body
+      self.embeds = [] if storage_usage_rich_text? && body.blank?
+    end
+
+    def remember_storage_usage_embed_change
+      change = attachment_changes["embeds"]
+
+      if change && storage_usage_rich_text?
+        old_blob_ids = embeds_attachments.pluck(:blob_id).sort
+        new_blob_ids = change.blobs.respond_to?(:pluck) ? change.blobs.pluck(:id) : change.blobs.map(&:id)
+        @storage_usage_embeds_changed = old_blob_ids != new_blob_ids.sort
+        @storage_usage_record = record if @storage_usage_embeds_changed
+      end
+    end
+
+    def remember_storage_usage_embeds_before_destroy
+      if storage_usage_rich_text? && embeds_attachments.exists?
+        @storage_usage_embeds_changed = true
+        @storage_usage_record = record
+      end
+    end
+
+    def storage_usage_embeds_changed?
+      @storage_usage_embeds_changed
+    end
+
+    def refresh_storage_usage_after_embed_change
+      StorageUsage.refresh_for_rich_text_record(@storage_usage_record) if @storage_usage_record
+    end
+
+    def storage_usage_rich_text?
+      case record_type
+      when Board.polymorphic_name
+        name == "public_description"
+      when Card.polymorphic_name
+        name == "description"
+      when Comment.polymorphic_name
+        name == "body"
+      else
+        false
+      end
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..71a4160
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,28 @@
+module StorageUsage
+  INTERNAL_ATTRIBUTES = %w[bytes_used bytes_used_version bytes_used_calculated_version bytes_used_refresh_enqueued].freeze
+
+  def self.refresh_board_later(board_id)
+    if board_id
+      Board.find_by(id: board_id)&.refresh_bytes_used_later
+    end
+  end
+
+  def self.refresh_account_later(account_id)
+    if account_id
+      Account.find_by(id: account_id)&.refresh_bytes_used_later
+    end
+  end
+
+  def self.refresh_for_rich_text_record(record)
+    board_id = case record
+    when Board
+      record.id
+    when Card
+      record.board_id
+    when Comment
+      Card.where(id: record.card_id).pick(:board_id)
+    end
+
+    refresh_board_later(board_id)
+  end
+end
diff --git a/app/models/storage_usage/calculator.rb b/app/models/storage_usage/calculator.rb
new file mode 100644
index 0000000..f8db279
--- /dev/null
+++ b/app/models/storage_usage/calculator.rb
@@ -0,0 +1,63 @@
+module StorageUsage
+  class Calculator
+    def self.call(record)
+      case record
+      when Account
+        calculate_for_account(record)
+      when Board
+        calculate_for_board(record)
+      else
+        raise ArgumentError, "Cannot calculate storage usage for #{record.class}"
+      end
+    end
+
+    private
+      def self.calculate_for_account(account)
+        boards = Board.where(account_id: account.id)
+        cards = Card.where(board_id: boards.select(:id))
+        calculate(boards, cards)
+      end
+
+      def self.calculate_for_board(board)
+        boards = Board.where(id: board.id)
+        cards = Card.where(board_id: boards.select(:id))
+        calculate(boards, cards)
+      end
+
+      def self.calculate(boards, cards)
+        comments = Comment.where(card_id: cards.select(:id))
+
+        board_descriptions = ActionText::RichText.where(
+          record_type: Board.polymorphic_name,
+          name: "public_description",
+          record_id: boards.select(:id)
+        )
+        card_descriptions = ActionText::RichText.where(
+          record_type: Card.polymorphic_name,
+          name: "description",
+          record_id: cards.select(:id)
+        )
+        comment_bodies = ActionText::RichText.where(
+          record_type: Comment.polymorphic_name,
+          name: "body",
+          record_id: comments.select(:id)
+        )
+        rich_texts = board_descriptions.or(card_descriptions).or(comment_bodies)
+
+        card_images = ActiveStorage::Attachment.where(
+          record_type: Card.polymorphic_name,
+          name: "image",
+          record_id: cards.select(:id)
+        )
+        embedded_files = ActiveStorage::Attachment.where(
+          record_type: ActionText::RichText.polymorphic_name,
+          name: "embeds",
+          record_id: rich_texts.select(:id)
+        )
+
+        card_images.or(embedded_files)
+          .joins(:blob)
+          .sum("active_storage_blobs.byte_size")
+      end
+  end
+end
