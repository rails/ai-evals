--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "reaction content is required and limited to 16 characters" do
+    reaction = comments(:logo_agreement_jz).reactions.build(reacter: users(:kevin), content: "🎉")
+
+    assert_predicate reaction, :valid?
+
+    reaction.content = "x" * Reaction::CONTENT_MAX_LENGTH
+    assert_predicate reaction, :valid?
+
+    reaction.content = " "
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+
+    reaction.content = "x" * 17
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "a reaction must belong to the comment's account" do
+    reaction = comments(:logo_agreement_jz).reactions.build(reacter: users(:mike), content: "👍")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:reacter], "must belong to the same account as the comment"
+  end
+
+  test "saving a reaction touches its comment and card" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    travel 1.second do
+      assert_changes -> { comment.reload.updated_at } do
+        assert_changes -> { card.reload.updated_at } do
+          comment.reactions.create!(reacter: users(:kevin), content: "✨")
+        end
+      end
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..0834413
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,51 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding a reaction restores the add button and your reaction can be removed" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find("input[aria-label='Your reaction']").set("discard me")
+      find("button[aria-label='Cancel reaction']").click
+      assert_no_selector ".reaction", text: "discard me"
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reactions__trigger").click
+      find("input[aria-label='Your reaction']").set("Looking good")
+      find("button[aria-label='Confirm reaction']").click
+
+      assert_selector ".reaction", text: "Looking good"
+      assert_selector ".reactions__trigger", visible: true
+
+      find(".reaction--deleteable button[aria-expanded='false']").click
+      assert_selector ".reaction--deleteable.expanded button[aria-label='Remove your reaction']", visible: true
+      find(".reaction--deleteable.expanded button[aria-label='Remove your reaction']").click
+
+      assert_no_selector ".reaction", text: "Looking good"
+      assert_selector ".reactions__trigger", visible: true
+    end
+  end
+
+  test "reactions from other viewers arrive without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    @comment.reactions.create!(reacter: users(:jz), content: "✨")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "##{dom_id(@comment, :reactions)} .reaction", text: "✨", wait: 5
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
