@@ -0,0 +1,17 @@
+class Reaction < ApplicationRecord
+  CONTENT_MAX_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: CONTENT_MAX_LENGTH }
+  validate :reacter_belongs_to_comment_account
+
+  private
+    def reacter_belongs_to_comment_account
+      if comment && reacter && comment.account_id != reacter.account_id
+        errors.add(:reacter, "must belong to the same account as the comment")
+      end
+    end
+end
