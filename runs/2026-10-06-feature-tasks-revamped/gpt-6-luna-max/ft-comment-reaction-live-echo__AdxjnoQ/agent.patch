+<% own_reaction = reaction.reacter_id == Current.user.id %>
+<% reaction_text_classes = class_names("txt-small", "txt-medium" => reaction.content.match?(/\A\p{Emoji_Presentation}+\z/)) %>
+
+<% if own_reaction %>
+  <div id="<%= dom_id(reaction) %>" class="reaction reaction--deleteable" data-controller="reaction">
+    <%= tag.button type: :button, class: "btn btn--plain flex-inline align-center gap-half",
+          data: { action: "reaction#toggle" }, aria: { expanded: false, label: "Your reaction: #{reaction.content}. Show remove option" } do %>
+      <span class="<%= reaction_text_classes %>"><%= reaction.content %></span>
+      <%= render "cards/comments/reactions/avatar", reaction: reaction %>
+    <% end %>
+
+    <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+          class: "reaction__delete btn btn--circle borderless", form: { class: "reaction__delete-form" },
+          aria: { label: "Remove your reaction" } do %>
+      <%= icon_tag "close" %>
+    <% end %>
+  </div>
+<% else %>
+  <%= tag.div id: dom_id(reaction), class: "reaction", role: "group",
+        aria: { label: "Reaction by #{reaction.reacter.name}: #{reaction.content}" } do %>
+    <span class="<%= reaction_text_classes %>"><%= reaction.content %></span>
+    <%= render "cards/comments/reactions/avatar", reaction: reaction %>
+  <% end %>
+<% end %>
diff --git a/app/views/cards/comments/reactions/_reactions.html.erb b/app/views/cards/comments/reactions/_reactions.html.erb
new file mode 100644
index 0000000..ffde0e1
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reactions.html.erb
@@ -0,0 +1,37 @@
+<% reaction = local_assigns[:reaction] %>
+<% reaction_form = reaction&.new_record? ? reaction : Reaction.new %>
+<% form_expanded = local_assigns.fetch(:form_expanded, false) %>
+
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction-form">
+  <div class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions, as: :reaction, locals: { comment: comment } %>
+  </div>
+
+  <%= tag.button type: :button, class: "reactions__trigger btn btn--circle",
+        hidden: form_expanded, data: { reaction_form_target: "trigger", action: "reaction-form#show" },
+        aria: { label: "Add a reaction" } do %>
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  <% end %>
+
+  <%= form_with model: [ comment.card, comment, reaction_form ], id: dom_id(comment, :reaction_form),
+        class: class_names("reaction__form flex-inline align-center gap-half", "expanded" => form_expanded), hidden: !form_expanded,
+        data: { reaction_form_target: "form" } do |form| %>
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "input reaction__input",
+          maxlength: Reaction::CONTENT_MAX_LENGTH, required: true, autocomplete: "off", placeholder: "React", autofocus: form_expanded,
+          aria: { label: "Your reaction" }, data: { reaction_form_target: "input", action: "keydown.esc->reaction-form#cancel:prevent" } %>
+
+    <% if reaction_form.errors.any? %>
+      <span class="reaction__error txt-x-small" role="alert"><%= reaction_form.errors.full_messages.to_sentence %></span>
+    <% end %>
+
+    <%= button_tag type: :submit, class: "reaction__submit-btn btn btn--circle borderless", aria: { label: "Confirm reaction" } do %>
+      <%= icon_tag "check" %>
+    <% end %>
+
+    <%= button_tag type: :button, class: "reaction__cancel-btn btn btn--circle borderless",
+          aria: { label: "Cancel reaction" }, data: { action: "reaction-form#cancel" } do %>
+      <%= icon_tag "close" %>
+    <% end %>
+  <% end %>
+</div>
