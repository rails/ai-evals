diff --git a/app/jobs/notification/email_bundle/deliver_job.rb b/app/jobs/notification/email_bundle/deliver_job.rb
new file mode 100644
index 0000000..c45790f
--- /dev/null
+++ b/app/jobs/notification/email_bundle/deliver_job.rb
@@ -0,0 +1,57 @@
+class Notification::EmailBundle::DeliverJob < ApplicationJob
+  include SmtpDeliveryErrorHandling
+
+  DELIVERY_LEASE = 10.minutes
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    result = claim_delivery(bundle)
+
+    if result == :deliver
+      deliver_email(bundle)
+    elsif result.is_a?(Time)
+      self.class.set(wait_until: result).perform_later(bundle)
+    end
+  end
+
+  private
+    def claim_delivery(bundle)
+      settings = bundle.user_settings
+      result = nil
+
+      settings.with_lock do
+        bundle.lock!
+        now = Time.current
+
+        if bundle.sent_at.present? || bundle.cancelled_at.present?
+          result = :done
+        elsif bundle.ends_at > now
+          result = bundle.ends_at
+        elsif bundle.delivery_started_at && bundle.delivery_started_at > DELIVERY_LEASE.ago
+          result = :in_progress
+        elsif settings.bundle_email_frequency == "never" || !bundle.email_delivery_eligible?
+          bundle.cancel!
+          result = :done
+        else
+          bundle.close!
+          bundle.update!(delivery_started_at: now)
+          result = :deliver
+        end
+      end
+
+      result
+    end
+
+    def deliver_email(bundle)
+      if bundle.reload.cancelled_at.present? || bundle.user_settings.reload.bundle_email_frequency == "never"
+        bundle.cancel!
+      else
+        NotificationMailer.email_bundle(bundle).deliver_now
+        bundle.update!(sent_at: Time.current, delivery_started_at: nil)
+      end
+    rescue
+      bundle.update!(delivery_started_at: nil) if bundle.reload.delivery_started_at.present? && bundle.sent_at.blank?
+      raise
+    end
+end
