@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "the first notification opens a four-hour window and later notifications join it" do
+    started_at = Time.zone.parse("2026-07-10 10:00:00")
+
+    travel_to started_at do
+      first_notification = create_notification(events(:text_published))
+      bundle = Notification::EmailBundle.collect(first_notification)
+
+      assert_equal started_at, bundle.starts_at
+      assert_equal started_at + 4.hours, bundle.ends_at
+
+      travel 2.hours
+      second_notification = create_notification(events(:shipping_published))
+
+      assert_equal bundle, Notification::EmailBundle.collect(second_notification)
+      assert_equal [ first_notification.id, second_notification.id ].sort, bundle.notifications.ids.sort
+    end
+  end
+
+  test "a late notification joins the window that is currently open" do
+    started_at = Time.zone.parse("2026-07-10 10:00:00")
+    first_notification = nil
+    bundle = nil
+
+    travel_to started_at do
+      first_notification = create_notification(events(:text_published))
+      bundle = Notification::EmailBundle.collect(first_notification)
+    end
+
+    travel_to started_at + 2.hours do
+      late_notification = create_notification(events(:shipping_published))
+      late_notification.update_columns(created_at: started_at - 1.day)
+
+      assert_equal bundle, Notification::EmailBundle.collect(late_notification)
+      assert_equal [ first_notification.id, late_notification.id ].sort, bundle.notifications.ids.sort
+    end
+  end
+
+  test "a notification after a window expires opens an adjacent window, not an overlapping one" do
+    started_at = Time.zone.parse("2026-07-10 10:00:00")
+    first_bundle = nil
+
+    travel_to started_at do
+      first_bundle = Notification::EmailBundle.collect(create_notification(events(:text_published)))
+    end
+
+    next_started_at = first_bundle.ends_at + 1.minute
+
+    travel_to next_started_at do
+      second_bundle = Notification::EmailBundle.collect(create_notification(events(:shipping_published)))
+
+      assert_equal next_started_at, second_bundle.starts_at
+      assert_equal first_bundle.ends_at, first_bundle.reload.closed_at
+      assert_operator first_bundle.ends_at, :<=, second_bundle.starts_at
+      assert_equal [ first_bundle, second_bundle ], @settings.notification_email_bundles.order(:starts_at).to_a
+    end
+  end
+
+  test "daily and weekly preferences determine the window length" do
+    {
+      "daily" => [ 1.day, events(:text_published) ],
+      "weekly" => [ 1.week, events(:shipping_published) ]
+    }.each do |frequency, (duration, source)|
+      @settings.update!(bundle_email_frequency: frequency)
+      started_at = Time.current.change(usec: 0)
+
+      travel_to started_at do
+        bundle = Notification::EmailBundle.collect(create_notification(source))
+        assert_equal started_at + duration, bundle.ends_at
+      end
+
+      @settings.notification_email_bundles.destroy_all
+    end
+  end
+
+  test "never does not open a window" do
+    @settings.update!(bundle_email_frequency: "never")
+    notification = create_notification(events(:text_published))
+
+    assert_nil Notification::EmailBundle.collect(notification)
+    assert_empty @settings.notification_email_bundles
+  end
+
+  test "turning email digests off cancels the open window" do
+    bundle = Notification::EmailBundle.collect(create_notification(events(:text_published)))
+
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert bundle.reload.cancelled_at
+    assert_equal bundle.cancelled_at, bundle.closed_at
+    assert_equal bundle.cancelled_at, bundle.ends_at
+  end
+
+  test "delivery sends one email containing every notification in the window" do
+    bundle = Notification::EmailBundle.collect(create_notification(events(:text_published)))
+    Notification::EmailBundle.collect(create_notification(events(:shipping_published)))
+
+    ActionMailer::Base.deliveries.clear
+
+    travel_to bundle.ends_at, with_usec: true do
+      Notification::EmailBundle::DeliverJob.perform_now(bundle)
+      Notification::EmailBundle::DeliverJob.perform_now(bundle)
+    end
+
+    assert_equal 1, ActionMailer::Base.deliveries.size
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notifications", email.subject
+    assert_match "The text is too small", email.body.encoded
+    assert_match "We need to ship the app", email.body.encoded
+    assert bundle.reload.sent_at
+  end
+
+  test "notifications schedule collection only when the person has opted in" do
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_no_enqueued_jobs only: Notification::EmailBundle::CollectJob do
+      create_notification(events(:text_published))
+    end
+
+    @settings.update!(bundle_email_frequency: "daily")
+
+    assert_enqueued_with job: Notification::EmailBundle::CollectJob do
+      create_notification(events(:shipping_published))
+    end
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(user: @user, source: source, creator: users(:kevin))
+    end
+end
