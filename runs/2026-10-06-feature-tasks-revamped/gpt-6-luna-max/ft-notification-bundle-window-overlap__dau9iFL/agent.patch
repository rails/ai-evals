diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..e7863d1
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,82 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :user_settings, class_name: "User::Settings"
+
+  has_many :items, class_name: "Notification::EmailBundle::Item",
+    foreign_key: :notification_email_bundle_id, dependent: :destroy
+  has_many :notifications, through: :items
+
+  scope :collecting, -> { where(closed_at: nil, sent_at: nil, cancelled_at: nil) }
+  scope :pending, -> { where(sent_at: nil, cancelled_at: nil) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def collect(notification)
+      return unless eligible_notification?(notification)
+
+      user = notification.user
+
+      # The user row is the per-person lock, even if settings data is duplicated.
+      user.with_lock do
+        if settings = user.settings
+          settings.with_lock do
+            if settings.bundle_email_enabled? && eligible_notification?(notification)
+              now = Time.current
+              bundle = where(user: user).collecting.order(:starts_at).last
+
+              if bundle && bundle.ends_at <= now
+                bundle.close!
+                bundle = nil
+              end
+
+              bundle ||= settings.notification_email_bundles.create!(
+                account: user.account,
+                user: user,
+                frequency: settings.bundle_email_frequency,
+                starts_at: now,
+                ends_at: now + settings.bundle_email_duration
+              )
+
+              bundle.items.find_or_create_by!(notification: notification)
+              bundle
+            end
+          end
+        end
+      end
+    end
+
+    def eligible_notification?(notification)
+      user = notification.user
+
+      !notification.creator.system? && user.active? && notification.account.active? &&
+        user.identity&.email_address.present?
+    end
+  end
+
+  def close!
+    update!(closed_at: ends_at) if closed_at.nil?
+  end
+
+  def cancel!
+    now = Time.current
+    closed_at = [ ends_at, now ].min
+
+    update!(
+      ends_at: closed_at,
+      closed_at: closed_at,
+      cancelled_at: now,
+      delivery_started_at: nil
+    )
+  end
+
+  def email_delivery_eligible?
+    user.active? && account.active? && user.identity&.email_address.present? && notifications.exists?
+  end
+
+  private
+    def deliver_later
+      Notification::EmailBundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+end
