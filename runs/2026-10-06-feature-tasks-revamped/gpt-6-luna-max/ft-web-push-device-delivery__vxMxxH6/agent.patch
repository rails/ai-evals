+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "registers the current user's browser push subscription" do
+    post user_push_subscriptions_path(@user), params: push_subscription_params, as: :json
+
+    assert_response :created
+    assert_equal 1, @user.push_subscriptions.count
+  end
+
+  test "updates an existing endpoint instead of creating a duplicate" do
+    post user_push_subscriptions_path(@user), params: push_subscription_params, as: :json
+    post user_push_subscriptions_path(@user), params: push_subscription_params("new-p256dh-key", "new-auth-key"), as: :json
+
+    assert_response :created
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal "new-p256dh-key", @user.push_subscriptions.sole.p256dh_key
+    assert_equal "new-auth-key", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "removes only the current user's subscription for this endpoint" do
+    @user.push_subscriptions.create!(push_subscription_params[:push_subscription])
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: push_subscription_params, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "does not allow a user to register a subscription for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: push_subscription_params, as: :json
+
+    assert_response :forbidden
+    assert_empty users(:kevin).push_subscriptions
+  end
+
+  test "rejects insecure endpoints" do
+    post user_push_subscriptions_path(@user), params: push_subscription_params(endpoint: "http://push.example.test/subscription/123"), as: :json
+
+    assert_response :unprocessable_entity
+    assert_empty @user.push_subscriptions
+  end
+
+  private
+    def push_subscription_params(p256dh_key = "p256dh-key", auth_key = "auth-key", endpoint: "https://push.example.test/subscription/123")
+      { push_subscription: { endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key } }
+    end
+end
diff --git a/test/jobs/push_subscription/delivery_job_test.rb b/test/jobs/push_subscription/delivery_job_test.rb
new file mode 100644
index 0000000..2af77d8
--- /dev/null
+++ b/test/jobs/push_subscription/delivery_job_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class PushSubscription::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.test/subscription/123",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "sends the tray copy, the card URL, and VAPID credentials" do
+    expected_payload = @notification.push_payload
+    sent_options = nil
+
+    WebPush.stubs(:payload_send).with do |**options|
+      sent_options = options
+      true
+    end
+
+    with_env "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @notification)
+    end
+
+    assert_equal @subscription.endpoint, sent_options[:endpoint]
+    assert_equal @subscription.p256dh_key, sent_options[:p256dh]
+    assert_equal @subscription.auth_key, sent_options[:auth]
+    assert_equal expected_payload, JSON.parse(sent_options[:message])
+    assert_equal "public-key", sent_options.dig(:vapid, :public_key)
+    assert_equal "private-key", sent_options.dig(:vapid, :private_key)
+  end
+
+  test "push copy matches the tray text for events and mentions" do
+    helper = ApplicationController.helpers
+
+    event_payload = @notification.push_payload
+    event = @notification.source
+    assert_equal helper.event_notification_title(event), event_payload.fetch("title")
+    assert_equal helper.event_notification_body(event), event_payload.fetch("body")
+    assert_equal Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @notification.account.slug), event_payload.fetch("url")
+
+    mention_notification = notifications(:logo_mentioned_david)
+    mention = mention_notification.source
+    mention_payload = mention_notification.push_payload
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", mention_payload.fetch("title")
+    assert_equal mention.source.mentionable_content.truncate(200), mention_payload.fetch("body")
+    assert_equal Rails.application.routes.url_helpers.card_path(mention_notification.card, script_name: mention_notification.account.slug), mention_payload.fetch("url")
+  end
+
+  test "deletes expired subscriptions" do
+    response = Struct.new(:body).new("expired")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+    with_env "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @notification)
+    end
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "does not send notifications that have already been read" do
+    @notification.read
+    WebPush.expects(:payload_send).never
+
+    with_env "VAPID_PUBLIC_KEY" => "public-key", "VAPID_PRIVATE_KEY" => "private-key" do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @notification)
+    end
+  end
+
+  test "does not send when VAPID credentials are missing" do
+    WebPush.expects(:payload_send).never
+
+    with_env "VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @notification)
+    end
+  end
+
+  private
+    def with_env(values)
+      original_values = values.keys.index_with { |key| ENV[key] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      original_values.each { |key, value| ENV[key] = value }
+    end
+end
