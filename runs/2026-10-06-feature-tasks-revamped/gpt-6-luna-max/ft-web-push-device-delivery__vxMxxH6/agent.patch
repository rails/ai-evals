diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..8f99987
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,34 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint_digest: endpoint_digest)
+    @push_subscription.assign_attributes(push_subscription_params)
+
+    if @push_subscription.save
+      head :created
+    else
+      render json: { errors: @push_subscription.errors.full_messages }, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(endpoint_digest: endpoint_digest)&.destroy!
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    def endpoint_digest
+      Digest::SHA256.hexdigest(push_subscription_params[:endpoint])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1554be2
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,164 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "button", "details", "message", "status", "unavailable" ]
+  static values = { publicKey: String, subscriptionUrl: String }
+
+  async connect() {
+    this.subscription = null
+    this.registrationReady = false
+    this.available = this.#supportsPush && this.publicKeyValue.length > 0
+
+    if (!this.available) {
+      const explanation = this.publicKeyValue.length > 0 ?
+        "This browser doesn't support push notifications." :
+        "Push notifications aren't configured for this app yet."
+      this.#showUnavailable(explanation)
+      return
+    }
+
+    this.#updateState()
+
+    try {
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+      this.registration = await navigator.serviceWorker.ready
+      this.registrationReady = true
+      this.subscription = await this.registration.pushManager.getSubscription()
+      this.#updateState()
+
+      if (this.subscription) {
+        try {
+          await this.#saveSubscription(this.subscription)
+        } catch (error) {
+          this.#showMessage("This device's subscription couldn't be synced. Please reload to try again.")
+        }
+      }
+    } catch (error) {
+      this.#showUnavailable("Push notifications couldn't be set up in this browser.")
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.#clearMessage()
+
+    try {
+      if (this.subscription) {
+        await this.#unsubscribe()
+      } else {
+        await this.#subscribe()
+      }
+    } catch (error) {
+      this.#showMessage("We couldn't update push notifications. Please try again.")
+    } finally {
+      this.buttonTarget.disabled = false
+      this.#updateState()
+    }
+  }
+
+  async #subscribe() {
+    let permission = Notification.permission
+    if (permission !== "granted") {
+      permission = await Notification.requestPermission()
+    }
+
+    if (permission !== "granted") {
+      this.#updateState()
+      return
+    }
+
+    this.subscription = await this.registration.pushManager.getSubscription() ||
+      await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#decodePublicKey(this.publicKeyValue)
+      })
+
+    this.#updateState()
+    await this.#saveSubscription(this.subscription)
+  }
+
+  async #unsubscribe() {
+    const subscription = this.subscription
+    const params = this.#subscriptionParams(subscription)
+
+    await subscription.unsubscribe()
+    this.subscription = null
+    this.#updateState()
+    await this.#sendSubscription("DELETE", params)
+  }
+
+  async #saveSubscription(subscription) {
+    await this.#sendSubscription("POST", this.#subscriptionParams(subscription))
+  }
+
+  async #sendSubscription(method, pushSubscription) {
+    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content
+    const headers = {
+      "Accept": "application/json",
+      "Content-Type": "application/json"
+    }
+    if (csrfToken) headers["X-CSRF-Token"] = csrfToken
+
+    const response = await fetch(this.subscriptionUrlValue, {
+      method,
+      credentials: "same-origin",
+      headers,
+      body: JSON.stringify({ push_subscription: pushSubscription })
+    })
+
+    if (!response.ok) throw new Error("Subscription request failed")
+  }
+
+  #subscriptionParams(subscription) {
+    const keys = subscription.toJSON().keys
+    if (!keys?.p256dh || !keys?.auth) throw new Error("Incomplete push subscription")
+
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: keys.p256dh,
+      auth_key: keys.auth
+    }
+  }
+
+  #updateState() {
+    const permission = this.#supportsPush ? Notification.permission : "default"
+    const enabled = permission === "granted" && this.subscription !== null
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.textContent = this.subscription ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.hidden = !this.available || !this.registrationReady || (!this.subscription && permission === "denied")
+
+    this.detailsTargets.forEach(details => details.hidden = permission !== "denied")
+    this.statusTarget.textContent = enabled ?
+      "Push notifications are on for this device." :
+      permission === "denied" ? "Push notifications are blocked on this device." : "Push notifications are off for this device."
+  }
+
+  #showUnavailable(message) {
+    this.buttonTarget.hidden = true
+    this.unavailableTarget.textContent = message
+    this.unavailableTarget.hidden = false
+    this.statusTarget.textContent = message
+  }
+
+  #showMessage(message) {
+    this.messageTarget.textContent = message
+    this.messageTarget.hidden = false
+  }
+
+  #clearMessage() {
+    this.messageTarget.textContent = ""
+    this.messageTarget.hidden = true
+  }
+
+  #decodePublicKey(value) {
+    const base64 = value.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64 + "=".repeat((4 - base64.length % 4) % 4)
+    const binary = atob(padded)
+    return Uint8Array.from(binary, character => character.charCodeAt(0))
+  }
+
+  get #supportsPush() {
+    return window.isSecureContext && "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
new file mode 100644
index 0000000..1cd43ce
--- /dev/null
+++ b/app/jobs/push_subscription/delivery_job.rb
@@ -0,0 +1,32 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError,
+    Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Socket::ResolutionError,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(subscription, notification)
+    return unless ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    return unless notification.user.active? && notification.account.active?
+    return if notification.read?
+    return unless subscription.user_id == notification.user_id
+
+    WebPush.payload_send(
+      endpoint: subscription.endpoint,
+      p256dh: subscription.p256dh_key,
+      auth: subscription.auth_key,
+      message: notification.push_payload.to_json,
+      ssl_timeout: 5,
+      open_timeout: 5,
+      read_timeout: 5,
+      vapid: {
+        subject: "mailto:support@fizzy.do",
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    subscription.destroy
+  end
+end
