diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..2123868
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,95 @@
+class Stripe::WebhooksController < ActionController::API
+  def create
+    if webhook_secret.present? && request.headers["Stripe-Signature"].present?
+      event = Stripe::Webhook.construct_event(request.body.read, request.headers["Stripe-Signature"], webhook_secret)
+      process_event(event)
+      head :ok
+    else
+      head :bad_request
+    end
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, ArgumentError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      case value(event, :type)
+      when "checkout.session.completed"
+        record_checkout(value(value(event, :data), :object))
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        update_subscription(value(value(event, :data), :object))
+      end
+    end
+
+    def record_checkout(checkout)
+      account = find_account(checkout)
+
+      if account
+        subscription = account.subscription || Account::Subscription.create_or_find_by!(account_id: account.id)
+        subscription.stripe_customer_id ||= stripe_object_id(value(checkout, :customer))
+        subscription.stripe_subscription_id ||= stripe_object_id(value(checkout, :subscription))
+        subscription.save!
+      end
+    end
+
+    def update_subscription(stripe_subscription)
+      account = find_account(stripe_subscription)
+
+      if account
+        subscription = account.subscription || Account::Subscription.create_or_find_by!(account_id: account.id)
+        plan_key = plan_key_for(stripe_subscription)
+
+        subscription.plan_key = plan_key if plan_key
+        subscription.stripe_customer_id = stripe_object_id(value(stripe_subscription, :customer)) || subscription.stripe_customer_id
+        subscription.stripe_subscription_id = stripe_object_id(value(stripe_subscription, :id)) || subscription.stripe_subscription_id
+        subscription.status = value(stripe_subscription, :status).presence || subscription.status
+        subscription.current_period_end = stripe_time(value(stripe_subscription, :current_period_end))
+        subscription.cancel_at = stripe_time(value(stripe_subscription, :cancel_at))
+        subscription.save!
+      end
+    end
+
+    def find_account(stripe_object)
+      account_id = value(value(stripe_object, :metadata), :account_id) || value(stripe_object, :client_reference_id)
+      customer_id = stripe_object_id(value(stripe_object, :customer))
+
+      account = Account.find_by(id: account_id)
+      account ||= Account::Subscription.find_by(stripe_customer_id: customer_id)&.account if customer_id.present?
+      account
+    end
+
+    def plan_key_for(stripe_subscription)
+      metadata_key = value(value(stripe_subscription, :metadata), :plan_key).to_s
+      if Account::Subscription::PAID_PLAN_KEYS.include?(metadata_key)
+        metadata_key
+      else
+        price = value(first_subscription_item(stripe_subscription), :price)
+        Account::Subscription.plan_key_for_stripe_price(value(price, :id))
+      end
+    end
+
+    def first_subscription_item(stripe_subscription)
+      items = value(stripe_subscription, :items)
+      Array(value(items, :data)).first
+    end
+
+    def stripe_time(timestamp)
+      timestamp.present? ? Time.at(timestamp.to_i).utc : nil
+    end
+
+    def stripe_object_id(value)
+      value.respond_to?(:id) ? value.id : value
+    end
+
+    def value(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[])
+        object[key.to_s] || object[key]
+      end
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..b38c0e8
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,89 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def plan_key
+    active_subscription&.plan_key || Account::Subscription::FREE_PLAN_KEY
+  end
+
+  def plan
+    plan_details.fetch(:name)
+  end
+
+  def plan_details
+    Account::Subscription.plan_details_for(plan_key)
+  end
+
+  def active_subscription
+    if subscription&.active?
+      subscription
+    end
+  end
+
+  def card_limit
+    plan_details.fetch(:card_limit)
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count > card_limit
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    Account::BillingWaiver.create_or_find_by!(account_id: id).tap do |waiver|
+      association(:billing_waiver).target = waiver
+    end
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def override_limits(card_count:, bytes_used:)
+    limit = Account::OverriddenLimit.create_or_find_by!(account_id: id)
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+    association(:overridden_limit).target = limit
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  def bytes_used
+    if overridden_limit&.bytes_used.nil?
+      super
+    else
+      overridden_limit.bytes_used
+    end
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+end
