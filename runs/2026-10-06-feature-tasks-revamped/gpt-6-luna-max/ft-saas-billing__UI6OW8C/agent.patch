+require "test_helper"
+require "ostruct"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+  end
+
+  test "admin can start a Stripe Checkout subscription session" do
+    previous_price = ENV["STRIPE_PRICE_UNLIMITED"]
+    ENV["STRIPE_PRICE_UNLIMITED"] = "price_unlimited_test"
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" &&
+        attributes[:line_items] == [ { price: "price_unlimited_test", quantity: 1 } ] &&
+        attributes[:client_reference_id] == @account.id &&
+        attributes[:subscription_data][:metadata][:plan_key] == "unlimited" &&
+        attributes[:customer_email] == identities(:mike).email_address
+    end.returns(OpenStruct.new(url: "https://checkout.stripe.test/session"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  ensure
+    ENV["STRIPE_PRICE_UNLIMITED"] = previous_price
+  end
+
+  test "checkout rejects unknown plans and unconfigured Stripe prices" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "not-a-plan" }
+
+    assert_response :unprocessable_entity
+  end
+
+  test "an existing subscriber is sent to the Stripe customer portal to change plans" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_test")
+    Stripe::BillingPortal::Session.expects(:create).with do |attributes|
+      attributes[:customer] == "cus_test" && attributes[:return_url].include?(@account.slug)
+    end.returns(OpenStruct.new(url: "https://billing.stripe.test/portal"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "unlimited_plus" }
+
+    assert_redirected_to "https://billing.stripe.test/portal"
+  end
+
+  test "account settings show pricing, plan, and upgrade to admins" do
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "section h2", text: "Plan"
+    assert_select "strong", text: "Free"
+    assert_select "option", text: /Unlimited — \$20\/month/
+    assert_select "option", text: /Unlimited\+ — \$25\/month/
+    assert_select "input[type=submit][value=Upgrade]"
+    assert_select "form[action=?]", saas.account_subscription_path(script_name: @account.slug)
+  end
+
+  test "account settings hide plan and upgrade from non-admins" do
+    @account.users.create!(name: "JZ", role: :member, identity: identities(:jz), verified_at: Time.current)
+    logout_and_sign_in_as :jz
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "section h2", text: "Plan", count: 0
+    assert_select "input[type=submit][value=Upgrade]", count: 0
+  end
+end
