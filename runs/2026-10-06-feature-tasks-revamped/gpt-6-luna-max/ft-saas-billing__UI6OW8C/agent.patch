@@ -0,0 +1,52 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.active_subscription
+      portal = Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: settings_url
+      )
+
+      redirect_to portal.url, allow_other_host: true
+    elsif plan_key && (price_id = Account::Subscription.stripe_price_id_for(plan_key)).present?
+      checkout = Stripe::Checkout::Session.create(checkout_session_attributes(price_id))
+      redirect_to checkout.url, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def plan_key
+      params[:plan_key].presence_in(Account::Subscription::PAID_PLAN_KEYS)
+    end
+
+    def checkout_session_attributes(price_id)
+      attributes = {
+        mode: "subscription",
+        line_items: [ { price: price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: checkout_metadata,
+        subscription_data: { metadata: checkout_metadata },
+        success_url: settings_url(billing: "success"),
+        cancel_url: settings_url(billing: "cancelled")
+      }
+
+      if Current.account.stripe_customer_id.present?
+        attributes[:customer] = Current.account.stripe_customer_id
+      else
+        attributes[:customer_email] = Current.identity.email_address
+      end
+
+      attributes
+    end
+
+    def checkout_metadata
+      { account_id: Current.account.id, plan_key: plan_key }
+    end
+
+    def settings_url(**options)
+      main_app.account_settings_url(**options, script_name: Current.account.slug)
+    end
+end
