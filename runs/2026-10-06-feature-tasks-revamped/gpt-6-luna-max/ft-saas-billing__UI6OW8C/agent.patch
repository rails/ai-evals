diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..947ec00
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,62 @@
+class Account::Subscription < SaasRecord
+  FREE_PLAN_KEY = "free"
+
+  PLAN_DETAILS = {
+    FREE_PLAN_KEY => {
+      name: "Free",
+      monthly_price_in_cents: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    }.freeze,
+    "unlimited" => {
+      name: "Unlimited",
+      monthly_price_in_cents: 2_000,
+      card_limit: nil,
+      storage_limit: 5.gigabytes,
+      stripe_price_env: "STRIPE_PRICE_UNLIMITED"
+    }.freeze,
+    "unlimited_plus" => {
+      name: "Unlimited+",
+      monthly_price_in_cents: 2_500,
+      card_limit: nil,
+      storage_limit: 500.gigabytes,
+      stripe_price_env: "STRIPE_PRICE_UNLIMITED_PLUS"
+    }.freeze
+  }.freeze
+
+  PAID_PLAN_KEYS = (PLAN_DETAILS.keys - [ FREE_PLAN_KEY ]).freeze
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: PLAN_DETAILS.keys }
+  validates :account_id, uniqueness: true
+  validates :stripe_customer_id, uniqueness: true, allow_nil: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def self.plan_details_for(key)
+    PLAN_DETAILS.fetch(key.to_s)
+  end
+
+  def self.paid_plan_keys
+    PAID_PLAN_KEYS
+  end
+
+  def self.stripe_price_id_for(key)
+    price_env = plan_details_for(key)[:stripe_price_env]
+    ENV[price_env] if price_env
+  end
+
+  def self.plan_key_for_stripe_price(price_id)
+    PLAN_DETAILS.find do |_key, details|
+      details[:stripe_price_env] && ENV[details[:stripe_price_env]].present? && ENV[details[:stripe_price_env]] == price_id
+    end&.first
+  end
+
+  def active?
+    status.in?(%w[ active trialing ]) && plan_key != FREE_PLAN_KEY
+  end
+
+  def plan_name
+    self.class.plan_details_for(plan_key).fetch(:name)
+  end
+end
diff --git a/saas/app/views/account/settings/_subscription.html.erb b/saas/app/views/account/settings/_subscription.html.erb
new file mode 100644
index 0000000..dc2eb7d
--- /dev/null
+++ b/saas/app/views/account/settings/_subscription.html.erb
@@ -0,0 +1,37 @@
+<% plan_details = account.plan_details %>
+<% plan_options = Account::Subscription.paid_plan_keys.map do |key|
+     details = Account::Subscription.plan_details_for(key)
+     [ "#{details[:name]} — $#{details[:monthly_price_in_cents] / 100}/month", key ]
+   end %>
+<% default_plan_key = account.plan_key == "unlimited" ? "unlimited_plus" : "unlimited" %>
+
+<section class="settings__section">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>Your account is on the <strong><%= account.plan %></strong> plan.</div>
+  </header>
+
+  <dl class="flex flex-column gap-quarter txt-small">
+    <div class="flex justify-space-between gap">
+      <dt>Cards</dt>
+      <dd><%= plan_details[:card_limit] ? number_with_delimiter(plan_details[:card_limit]) : "Unlimited" %></dd>
+    </div>
+    <div class="flex justify-space-between gap">
+      <dt>Storage</dt>
+      <dd><%= number_to_human_size(plan_details[:storage_limit]) %></dd>
+    </div>
+    <div class="flex justify-space-between gap">
+      <dt>Price</dt>
+      <dd>$<%= plan_details[:monthly_price_in_cents] / 100 %>/month</dd>
+    </div>
+  </dl>
+
+  <%= form_with url: saas.account_subscription_path(script_name: account.slug), method: :post, class: "flex align-center gap-half" do %>
+    <%= select_tag :plan_key, options_for_select(plan_options, default_plan_key), class: "input", aria: { label: "Choose a plan" } %>
+    <%= submit_tag "Upgrade", class: "btn" %>
+  <% end %>
+
+  <% if account.stripe_customer_id.present? %>
+    <%= button_to "Manage billing", saas.account_billing_portal_path(script_name: account.slug), method: :post, class: "btn btn--plain" %>
+  <% end %>
+</section>
