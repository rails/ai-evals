+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open an account support page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(accounts(:initech))}']", text: "Initech LLC"
+
+      get saas.admin_account_path(accounts(:initech))
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "non-staff cannot access account support pages" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can comp and uncomp an account" do
+    account = accounts(:initech)
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(account)
+    end
+    assert_response :redirect
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_billing_waiver_path(account)
+    end
+    assert_response :redirect
+    assert_not account.reload.comped?
+  end
+
+  test "staff can override and reset account usage" do
+    account = accounts(:initech)
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: {
+        overridden_limit: { card_count: "500", bytes_used: "12345" }
+      }
+    end
+
+    assert_response :redirect
+    assert_equal 500, account.reload.card_count
+    assert_equal 12_345, account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_response :redirect
+    assert_nil account.reload.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/card/billing_limited_test.rb b/saas/test/controllers/card/billing_limited_test.rb
new file mode 100644
index 0000000..e63cad8
--- /dev/null
+++ b/saas/test/controllers/card/billing_limited_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Card::BillingLimitedTest < ActionDispatch::IntegrationTest
+  test "free account can keep drafting when it has used its card allowance" do
+    account = accounts(:initech)
+    account.update!(cards_count: 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+    sign_in_as :mike
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug)
+      assert_response :redirect
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "free account cannot create a card through the API after using its allowance" do
+    account = accounts(:initech)
+    account.update!(cards_count: 1_000)
+    sign_in_as :mike
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug),
+        params: { card: { title: "No more published cards" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "free account cannot publish a draft after using its allowance" do
+    account = accounts(:initech)
+    account.update!(cards_count: 1_000)
+    sign_in_as :mike
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "paid account can publish and create cards without a card limit" do
+    account = accounts(:initech)
+    account.update!(cards_count: 1_000)
+    account.create_subscription!(plan_key: "unlimited", status: "active")
+    sign_in_as :mike
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: account.slug),
+        params: { card: { title: "An unlimited card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "card warning counts down within the last 100 cards" do
+    account = accounts(:initech)
+    account.update!(cards_count: 950)
+    sign_in_as :mike
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch", text: /50 cards left/
+    assert_select ".card-perma__notch a", text: "Upgrade"
+  end
+
+  test "upgrade pitch replaces publish buttons once free cards run out" do
+    account = accounts(:initech)
+    account.update!(cards_count: 1_000)
+    sign_in_as :mike
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__notch", text: /used all 1,000 cards/
+    assert_select ".card-perma__notch a", text: "Upgrade"
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..1f5fe95
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @previous_webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous_webhook_secret
+  end
+
+  test "subscription webhook updates the account plan and billing identifiers" do
+    account = accounts(:initech)
+    subscription = {
+      id: "sub_test",
+      customer: "cus_test",
+      status: "active",
+      current_period_end: 1.month.from_now.to_i,
+      cancel_at: nil,
+      metadata: { account_id: account.id, plan_key: "unlimited" },
+      items: { data: [ { price: { id: "price_unlimited_test" } } ] }
+    }
+    event = { type: "customer.subscription.updated", data: { object: subscription } }
+
+    post_event(event)
+
+    assert_response :success
+    assert_equal "Unlimited", account.reload.plan
+    assert_equal "cus_test", account.subscription.stripe_customer_id
+    assert_equal "sub_test", account.subscription.stripe_subscription_id
+    assert_equal "active", account.subscription.status
+    assert_in_delta 1.month.from_now.to_i, account.subscription.current_period_end.to_i, 2
+  end
+
+  test "checkout completion stores the Stripe customer for the portal" do
+    account = accounts(:initech)
+    checkout = {
+      client_reference_id: account.id,
+      customer: "cus_checkout",
+      subscription: "sub_checkout",
+      metadata: { account_id: account.id, plan_key: "unlimited" }
+    }
+
+    post_event(type: "checkout.session.completed", data: { object: checkout })
+
+    assert_response :success
+    assert_equal "cus_checkout", account.reload.stripe_customer_id
+    assert_equal "free", account.plan_key
+  end
+
+  test "subscription deletion returns the account to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_test", stripe_subscription_id: "sub_test")
+    event = {
+      type: "customer.subscription.deleted",
+      data: { object: {
+        id: "sub_test",
+        customer: "cus_test",
+        status: "canceled",
+        metadata: { account_id: account.id, plan_key: "unlimited" }
+      } }
+    }
+
+    post_event(event)
+
+    assert_response :success
+    assert_equal "free", account.reload.plan_key
+    assert_equal "canceled", account.subscription.status
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "Stripe webhook route rejects a request without a signature" do
+    post "/stripe/webhooks", params: "payload", headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_event(event)
+      Stripe::Webhook.expects(:construct_event).with do |_payload, signature, secret|
+        signature == "signature" && secret == "whsec_test"
+      end.returns(event)
+
+      untenanted do
+        post "/stripe/webhooks", params: "payload", headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => "signature"
+        }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..7c2cf41
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "new accounts receive the free plan limits" do
+    account = accounts(:initech)
+
+    assert_equal "free", account.plan_key
+    assert_equal "Free", account.plan
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "paid plans provide their approved storage allowance and unlimited cards" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active")
+
+    assert_equal "Unlimited", account.plan
+    assert_nil account.card_limit
+    assert_equal 5.gigabytes, account.storage_limit
+
+    account.subscription.update!(plan_key: "unlimited_plus")
+
+    assert_equal "Unlimited+", account.plan
+    assert_equal 500.gigabytes, account.storage_limit
+  end
+
+  test "an inactive subscription falls back to the free plan" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "canceled")
+
+    assert_equal "free", account.plan_key
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "card limit counts down and is unlimited on paid plans" do
+    account = accounts(:initech)
+    account.update!(cards_count: 950)
+
+    assert_equal 50, account.cards_remaining
+    assert_not account.card_limit_reached?
+
+    account.update!(cards_count: 1_000)
+
+    assert_equal 0, account.cards_remaining
+    assert account.card_limit_reached?
+
+    account.create_subscription!(plan_key: "unlimited", status: "active")
+
+    assert_nil account.cards_remaining
+    assert_not account.card_limit_reached?
+  end
+
+  test "billing waiver comp and uncomp are repeatable" do
+    account = accounts(:initech)
+
+    assert_not account.comped?
+    assert_difference -> { Account::BillingWaiver.count }, +1 do
+      account.comp!
+      account.comp!
+    end
+    assert account.comped?
+
+    account.uncomp!
+    account.uncomp!
+    assert_not account.comped?
+  end
+
+  test "overridden usage replaces card count and bytes used and reset drops it" do
+    account = accounts(:initech)
+    account.update!(cards_count: 200)
+    account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, account.card_count
+    assert_equal 2.gigabytes, account.bytes_used
+    assert account.card_limit_reached?
+
+    account.reset_overridden_limits
+
+    assert_equal 200, account.card_count
+    assert_equal 0, account.bytes_used
+    assert_nil account.overridden_limit
+  end
+
+  test "storage exception still overrides a plan allowance" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "unlimited", status: "active")
+    account.add_storage_exception(12.gigabytes)
+
+    assert_equal 12.gigabytes, account.storage_limit
+  end
+end
