new file mode 100644
index 0000000..bde4a96
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,56 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p><%= link_to "All accounts", saas.admin_accounts_path %></p>
+
+    <dl class="flex flex-column gap-quarter">
+      <div class="flex justify-space-between gap">
+        <dt>Plan</dt>
+        <dd><%= @account.plan %></dd>
+      </div>
+      <div class="flex justify-space-between gap">
+        <dt>Card count</dt>
+        <dd><%= number_with_delimiter(@account.card_count) %></dd>
+      </div>
+      <div class="flex justify-space-between gap">
+        <dt>Bytes used</dt>
+        <dd><%= number_with_delimiter(@account.bytes_used) %></dd>
+      </div>
+      <div class="flex justify-space-between gap">
+        <dt>Comped</dt>
+        <dd><%= @account.comped? ? "Yes" : "No" %></dd>
+      </div>
+    </dl>
+
+    <div class="flex gap-half margin-block-start">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn" %>
+    </div>
+
+    <section class="settings__section margin-block-start">
+      <header>
+        <h2 class="divider">Override limits</h2>
+      </header>
+
+      <%= form_with url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, method: :post, class: "flex flex-column gap-half" do |form| %>
+        <div>
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+        </div>
+        <div>
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+        </div>
+        <div>
+          <%= form.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn btn--plain" %>
+    </section>
+  </div>
+</section>
