diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..b6f464e
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search cards</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center justify-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, autofocus: true, class: "input full-width", placeholder: "Search titles, descriptions, and comments…" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<section class="search-results margin-block-double" aria-label="Search results">
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result panel borderless margin-block pad" data-card-id="<%= card.id %>">
+          <h2 class="txt-large">
+            <%= link_to highlight(card.title, @query), card_path(card) %>
+          </h2>
+
+          <p class="txt-small txt-ink-light">
+            <%= link_to card.board.name, board_path(card.board) %>
+          </p>
+
+          <% if description = highlight_search_match(card.description.to_plain_text, @query) %>
+            <p class="search-result__match"><%= description %></p>
+          <% end %>
+
+          <% @matching_comments.fetch(card.id, []).each do |comment| %>
+            <p class="search-result__match"><%= highlight_search_match(comment.body.to_plain_text, @query) %></p>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% elsif @query.present? %>
+    <p class="blank-slate">No cards match “<%= @query %>”</p>
+  <% end %>
+</section>
