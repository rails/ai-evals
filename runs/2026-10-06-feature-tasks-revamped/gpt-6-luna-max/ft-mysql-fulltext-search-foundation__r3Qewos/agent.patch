+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,9 @@
+module SearchHelper
+  def highlight_search_match(text, query)
+    if text.present? && query.present?
+      if excerpt = excerpt(text, query, radius: 100)
+        highlight(excerpt, query)
+      end
+    end
+  end
+end
