+++ b/app/controllers/search_controller.rb
@@ -0,0 +1,26 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+
+    cards = if @query.present?
+      Current.user.accessible_cards.published.matching_search_term(@query)
+    else
+      Current.user.accessible_cards.published.none
+    end
+
+    set_page_and_extract_portion_from cards.reverse_chronologically.preload(:board, :rich_text_description)
+    @matching_comments = matching_comments
+  end
+
+  private
+    def matching_comments
+      if @query.present?
+        Comment.matching_body(@query)
+          .where(card_id: @page.records.map(&:id))
+          .preload(:rich_text_body)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
