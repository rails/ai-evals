@@ -19,7 +19,35 @@ class Card < ApplicationRecord
   after_touch  -> { board.touch }, if: :published?
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
+  scope :matching_search_term, ->(query) do
+    pattern = "%#{ActiveRecord::Base.sanitize_sql_like(query, "!")}%"
+
+    where(<<~SQL.squish, pattern: pattern)
+      cards.title LIKE :pattern ESCAPE '!'
+      OR EXISTS (
+        SELECT 1 FROM action_text_rich_texts
+        WHERE action_text_rich_texts.record_type = 'Card'
+          AND action_text_rich_texts.record_id = cards.id
+          AND action_text_rich_texts.account_id = cards.account_id
+          AND action_text_rich_texts.name = 'description'
+          AND action_text_rich_texts.body LIKE :pattern ESCAPE '!'
+      )
+      OR EXISTS (
+        SELECT 1 FROM comments
+        INNER JOIN action_text_rich_texts AS comment_bodies
+          ON comment_bodies.record_type = 'Comment'
+          AND comment_bodies.record_id = comments.id
+          AND comment_bodies.account_id = comments.account_id
+          AND comment_bodies.name = 'body'
+        WHERE comments.card_id = cards.id
+          AND comments.account_id = cards.account_id
+          AND comment_bodies.body LIKE :pattern ESCAPE '!'
+      )
+    SQL
+  end
+
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
+
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
