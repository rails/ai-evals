diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..37818a5
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments newest first with highlighted matches" do
+    title_card = cards(:logo)
+    description_card = cards(:layout)
+    comment_card = cards(:text)
+
+    with_current_user(users(:kevin)) do
+      title_card.update_column(:title, "Quartz in the title")
+      title_card.update!(created_at: 3.days.ago)
+      description_card.update!(description: "A quartz description", created_at: 2.days.ago)
+      comment_card.update!(created_at: 1.day.ago)
+      comment_card.comments.create!(creator: users(:kevin), body: "A quartz comment")
+    end
+
+    get search_path, params: { q: "quartz" }
+
+    assert_response :success
+    assert_select ".search-result", 3
+    assert_equal [ comment_card, description_card, title_card ].map(&:id),
+      css_select(".search-result").map { |result| result["data-card-id"] }
+    assert_select ".search-result mark", text: /quartz/i, count: 3
+    assert_select ".search-result__match mark", text: /quartz/i, count: 2
+  end
+
+  test "only searches cards on boards the user currently has access to" do
+    with_current_user(users(:kevin)) do
+      private_card = boards(:private).cards.create!(
+        creator: users(:kevin), title: "Secret-quartz-card", status: :published
+      )
+      boards(:private).accesses.revoke_from(users(:kevin))
+      @private_card_id = private_card.id
+    end
+
+    get search_path, params: { q: "Secret-quartz-card" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id=?]", @private_card_id, count: 0
+  end
+
+  test "draft cards and comments are excluded" do
+    with_current_user(users(:kevin)) do
+      draft = boards(:writebook).cards.create!(
+        creator: users(:kevin), title: "draft-only-quartz", status: :drafted
+      )
+      draft_comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"))
+      draft_comment.save!(validate: false)
+      ActionText::RichText.create!(
+        account: accounts("37s"), record: draft_comment, name: "body", body: "draft-comment-quartz"
+      )
+      @draft_id = draft.id
+    end
+
+    get search_path, params: { q: "quartz" }
+
+    assert_response :success
+    assert_select ".search-result[data-card-id=?]", @draft_id, count: 0
+    assert_no_match "draft-comment-quartz", response.body
+  end
+
+  test "search treats SQL wildcard characters as literal text" do
+    card = cards(:logo)
+    with_current_user(users(:kevin)) do
+      card.update!(title: "A 100% complete task")
+    end
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result", 1
+    assert_select ".search-result[data-card-id=?]", card.id
+  end
+
+  test "highlights card text safely and escapes the query" do
+    with_current_user(users(:kevin)) do
+      cards(:logo).update_column(:title, %q(safe-marker <img src=x onerror="alert(1)">))
+    end
+
+    get search_path, params: { q: "safe-marker" }
+
+    assert_response :success
+    assert_select ".search-result mark", text: "safe-marker"
+    assert_select ".search-result img[onerror]", count: 0
+
+    malicious_query = "<script>alert(1)</script>"
+    get search_path, params: { q: malicious_query }
+
+    assert_response :success
+    assert_select ".blank-slate", text: "No cards match “#{malicious_query}”"
+    assert_no_match Regexp.new(Regexp.escape(malicious_query)), response.body
+  end
+
+  test "blank search shows the form without returning cards" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[method=get]"
+    assert_select ".search-result", 0
+  end
+end
