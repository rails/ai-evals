diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..c017a86
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "an offered locale applies immediately and is saved for the identity" do
+    sign_in_as :kevin
+    identity = identities(:kevin)
+
+    get cards_path(locale: :ja)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identity.reload.locale
+
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "a locale chosen before signing in sticks for the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+test "Japanese sign-in screen localizes visible and accessible text" do
+  untenanted do
+    get new_session_path(locale: :ja)
+
+    assert_response :success
+    assert_select "h1", text: "Fizzyにログイン"
+    assert_select "input[placeholder='メールアドレスを入力…']"
+    assert_select "button", text: "始めましょう"
+    assert_select "html[lang=ja]"
+  end
+end
+
+test "Japanese notification settings translate visible help text" do
+  sign_in_as :david
+
+  get notifications_settings_path(locale: :ja)
+
+  assert_response :success
+  assert_select "h2", text: "メール通知"
+  assert_includes response.body, "プッシュ通知："
+  assert_includes response.body, "通知設定"
+  assert_not_includes response.body, "Email Notifications"
+end
+
+  test "an unsupported locale does not change the current locale" do
+    sign_in_as :kevin
+    get cards_path(locale: :ja)
+    assert_response :success
+
+    get cards_path(locale: :xx)
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "an unsupported locale leaves an unselected visitor in English" do
+    untenanted do
+      get new_session_path(locale: :xx)
+
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+  end
+
+test "a returning identity's locale is applied before completing sign-in" do
+  identity = identities(:kevin)
+  identity.update!(locale: "ja")
+
+  untenanted do
+    post session_path, params: { email_address: identity.email_address }
+    assert_redirected_to session_magic_link_path
+
+    get session_magic_link_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "メールを確認してください"
+  end
+end
+
+  test "an identity locale is restored after signing in with a clean session" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as identity
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "English remains the default for people without a preference" do
+    sign_in_as :kevin
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:kevin).reload.locale
+  end
+end
