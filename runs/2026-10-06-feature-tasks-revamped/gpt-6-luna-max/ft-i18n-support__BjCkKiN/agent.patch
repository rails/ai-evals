diff --git a/app/services/localized_html.rb b/app/services/localized_html.rb
new file mode 100644
index 0000000..ad6e163
--- /dev/null
+++ b/app/services/localized_html.rb
@@ -0,0 +1,53 @@
+class LocalizedHtml
+  READABLE_ATTRIBUTES = %w[ alt aria-description aria-label placeholder title value ].freeze
+  NON_TRANSLATABLE_ELEMENTS = %w[ code pre script style textarea ].freeze
+
+  def self.translate(html, full_document: false)
+    new.translate(html, full_document: full_document)
+  end
+
+  def translate(html, full_document: false)
+    fragment = full_document ? Nokogiri::HTML(html) : Nokogiri::HTML.fragment(html)
+    translations = I18n.t("localization.strings", locale: I18n.locale, default: {}).each_with_object({}) do |(source, translated), catalog|
+      catalog[source.to_s.gsub(/[[:space:]]+/, " ").strip] = translated
+    end
+
+    fragment.traverse do |node|
+      if node.text?
+        translate_text_node(node, translations)
+      elsif node.element?
+        translate_attributes(node, translations)
+      end
+    end
+
+    fragment.to_html
+  end
+
+  private
+    def translate_text_node(node, translations)
+      return if node.ancestors.any? { |ancestor| non_translatable?(ancestor) }
+
+      replace_translation(node.text, translations) { |value| node.content = value }
+    end
+
+    def translate_attributes(node, translations)
+      node.attribute_nodes.each do |attribute|
+        if READABLE_ATTRIBUTES.include?(attribute.name) || attribute.name.start_with?("data-")
+          replace_translation(attribute.value, translations) { |value| attribute.value = value }
+        end
+      end
+    end
+
+    def replace_translation(source, translations)
+      normalized = source.gsub(/[[:space:]]+/, " ").strip
+      if translation = translations[normalized]
+        leading_whitespace = source[/\A[[:space:]]*/]
+        trailing_whitespace = source[/[[:space:]]*\z/]
+        yield "#{leading_whitespace}#{translation}#{trailing_whitespace}"
+      end
+    end
+
+    def non_translatable?(node)
+      NON_TRANSLATABLE_ELEMENTS.include?(node.name) || node["contenteditable"].present? || node.name == "lexxy-editor"
+    end
+end
