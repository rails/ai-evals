diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..5452556
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,57 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    before_action :set_locale_from_identity
+    after_action :translate_japanese_response
+  end
+
+  private
+    def with_locale
+      requested_locale = params[:locale].to_s
+      if supported_locale?(requested_locale)
+        session[:locale] = requested_locale
+      end
+
+      locale = session_locale || I18n.default_locale
+
+      Current.with(locale: locale, locale_selected: session_locale.present?) do
+        I18n.with_locale(locale) { yield }
+      end
+    end
+
+    def set_locale_from_identity
+      if identity = Current.identity
+        locale = session_locale
+
+        if locale
+          identity.update_column(:locale, locale) unless identity[:locale] == locale
+        elsif supported_locale?(identity[:locale])
+          locale = identity[:locale]
+          session[:locale] = locale
+        end
+
+        if locale
+          I18n.locale = locale
+          Current.locale = locale
+          Current.locale_selected = true
+        end
+      end
+    end
+
+    def session_locale
+      value = session[:locale].to_s
+      value if supported_locale?(value)
+    end
+
+    def translate_japanese_response
+      if I18n.locale == :ja && response.media_type.in?([ "text/html", "text/vnd.turbo-stream.html" ]) && response.body.present?
+        response.body = LocalizedHtml.translate(response.body.to_s, full_document: response.media_type == "text/html")
+      end
+    end
+
+    def supported_locale?(value)
+      I18n.available_locales.map(&:to_s).include?(value)
+    end
+end
