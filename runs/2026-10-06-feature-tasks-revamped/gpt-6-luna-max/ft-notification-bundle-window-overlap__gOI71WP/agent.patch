diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..6e28f4e
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,68 @@
+class Notification::EmailBundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :email_bundle_notifications, class_name: "Notification::EmailBundleNotification", foreign_key: :notification_email_bundle_id, dependent: :delete_all
+  has_many :notifications, through: :email_bundle_notifications
+
+  scope :pending, -> { where.not(pending_user_id: nil) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add_notification(notification)
+      settings = notification.user.settings
+      return unless settings
+
+      settings.with_lock do
+        if interval = settings.bundle_email_interval
+          bundle = pending.find_by(pending_user_id: notification.user_id)
+
+          unless bundle
+            now = Time.current
+            bundle = create!(
+              account: notification.account,
+              user: notification.user,
+              pending_user_id: notification.user_id,
+              started_at: now,
+              deliver_at: now + interval
+            )
+          end
+
+          bundle.email_bundle_notifications.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+  end
+
+  def deliver
+    settings = user.settings
+    return unless settings
+
+    settings.with_lock do
+      if bundle = self.class.pending.find_by(id: id, pending_user_id: user_id)
+        if bundle.deliver_at > Time.current
+          bundle.deliver_later
+        else
+          if deliverable?(settings)
+            Notification::EmailBundleMailer.digest(bundle).deliver_now
+            bundle.update!(sent_at: Time.current, pending_user_id: nil)
+          else
+            bundle.update!(pending_user_id: nil)
+          end
+        end
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::EmailBundleDeliveryJob.set(wait_until: deliver_at).perform_later(self)
+  end
+
+  private
+    def deliverable?(settings)
+      settings.bundle_email_interval.present? &&
+        user.active? && account.active? && user.identity.present? && notifications.exists?
+    end
+end
