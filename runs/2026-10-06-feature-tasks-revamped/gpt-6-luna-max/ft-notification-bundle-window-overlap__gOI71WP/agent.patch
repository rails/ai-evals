diff --git a/app/mailers/notification/email_bundle_mailer.rb b/app/mailers/notification/email_bundle_mailer.rb
new file mode 100644
index 0000000..3e4cbf6
--- /dev/null
+++ b/app/mailers/notification/email_bundle_mailer.rb
@@ -0,0 +1,18 @@
+class Notification::EmailBundleMailer < ApplicationMailer
+  def digest(email_bundle)
+    @email_bundle = email_bundle
+    @user = email_bundle.user
+    @notifications = email_bundle.notifications.preloaded.order(updated_at: :desc)
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications.size)
+  end
+
+  private
+    def subject_for(notification_count)
+      if notification_count == 1
+        "Your Fizzy notification digest"
+      else
+        "Your Fizzy notification digest (#{notification_count} notifications)"
+      end
+    end
+end
