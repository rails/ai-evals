diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..41f5e72
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+    @first_notification = notifications(:logo_assignment_kevin)
+    @late_notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+  end
+
+  test "the first notification starts a rolling window and late notifications join it" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      bundle = Notification::EmailBundle.add_notification(@first_notification)
+
+      assert_equal started_at, bundle.started_at
+      assert_equal started_at + 4.hours, bundle.deliver_at
+    end
+
+    bundle = Notification::EmailBundle.pending.find_by!(user: @user)
+    travel_to started_at + 6.hours do
+      assert_operator @late_notification.created_at, :<, bundle.started_at
+      assert_equal bundle, Notification::EmailBundle.add_notification(@late_notification)
+    end
+
+    assert_equal 1, Notification::EmailBundle.pending.where(user: @user).count
+    assert_equal [ @first_notification.id, @late_notification.id ].sort, bundle.reload.notifications.pluck(:id).sort
+    assert_equal started_at + 4.hours, bundle.deliver_at
+  end
+
+  test "schedules one delivery for the window deadline" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      bundle = nil
+      assert_enqueued_with(job: Notification::EmailBundleDeliveryJob, at: started_at + 4.hours) do
+        bundle = Notification::EmailBundle.add_notification(@first_notification)
+      end
+
+      Notification::EmailBundle.add_notification(@late_notification)
+      assert_equal 1, enqueued_jobs.count { |job| job[:job] == Notification::EmailBundleDeliveryJob }
+      assert_equal started_at + 4.hours, bundle.deliver_at
+    end
+  end
+
+  test "updated notifications are added to the open bundle after commit" do
+    @settings.update!(bundle_email_frequency: "daily")
+    @first_notification.update!(source: events(:logo_published))
+
+    bundle = Notification::EmailBundle.pending.find_by!(user: @user)
+    assert_includes bundle.notifications, @first_notification
+  end
+
+  test "the scheduled job delivers the digest at the window deadline" do
+    @settings.update!(bundle_email_frequency: "daily")
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @bundle = Notification::EmailBundle.add_notification(@first_notification)
+    end
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      travel_to @bundle.deliver_at do
+        perform_enqueued_jobs(at: @bundle.deliver_at)
+      end
+    end
+
+    assert @bundle.reload.sent_at
+    assert_nil @bundle.pending_user_id
+  end
+
+  test "the database prevents two pending windows for one recipient" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    bundle = Notification::EmailBundle.add_notification(@first_notification)
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Notification::EmailBundle.create!(
+        account: @user.account,
+        user: @user,
+        pending_user_id: @user.id,
+        started_at: bundle.started_at + 1.hour,
+        deliver_at: bundle.deliver_at + 1.hour
+      )
+    end
+  end
+
+  test "frequency is per user and determines the window length" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    david_settings = users(:david).settings
+    david_settings.update!(bundle_email_frequency: "weekly")
+
+    started_at = Time.current.change(usec: 0)
+    travel_to started_at do
+      kevin_bundle = Notification::EmailBundle.add_notification(@first_notification)
+      david_bundle = Notification::EmailBundle.add_notification(notifications(:logo_mentioned_david))
+
+      assert_equal started_at + 4.hours, kevin_bundle.deliver_at
+      assert_equal started_at + 1.week, david_bundle.deliver_at
+      assert_not_equal kevin_bundle.user, david_bundle.user
+    end
+  end
+
+  test "new notifications are added to a bundle after commit" do
+    @settings.update!(bundle_email_frequency: "daily")
+    @late_notification.destroy
+
+    notification = Notification.create!(
+      user: @user,
+      source: events(:buy_domain_sent_back_to_triage),
+      creator: users(:david),
+      unread_count: 1
+    )
+
+    bundle = Notification::EmailBundle.pending.find_by!(user: @user)
+    assert_includes bundle.notifications, notification
+  end
+
+  test "never does not open an email window" do
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::EmailBundle.count } do
+      assert_nil Notification::EmailBundle.add_notification(@first_notification)
+    end
+  end
+
+  test "delivers one digest for a window and only opens the next window after delivery" do
+    @settings.update!(bundle_email_frequency: "daily")
+    started_at = Time.current.change(usec: 0)
+
+    travel_to started_at do
+      @bundle = Notification::EmailBundle.add_notification(@first_notification)
+      Notification::EmailBundle.add_notification(@late_notification)
+      @deliver_at = @bundle.deliver_at
+    end
+
+    travel_to @deliver_at do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        @bundle.deliver
+      end
+
+      assert_equal @deliver_at, @bundle.reload.sent_at
+      assert_nil @bundle.pending_user_id
+      assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+        @bundle.deliver
+      end
+
+      next_bundle = Notification::EmailBundle.add_notification(@first_notification)
+
+      assert_equal @deliver_at, next_bundle.started_at
+      assert_operator next_bundle.started_at, :>=, @bundle.deliver_at
+      assert_equal 2, Notification::EmailBundle.where(user: @user).count
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notification digest (2 notifications)", email.subject
+    assert_includes email.html_part.body.decoded, "The logo isn&#39;t big enough"
+    assert_includes email.html_part.body.decoded, "Buy domain"
+  end
+end
