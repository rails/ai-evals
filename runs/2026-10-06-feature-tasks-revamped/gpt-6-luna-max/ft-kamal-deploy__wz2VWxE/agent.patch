new file mode 100644
index 0000000..4104ecc
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,56 @@
+<% app_host = "fizzy.example.com" %>
+
+service: fizzy
+image: fizzy
+
+# Replace with the public IP of the single Linux server running Docker.
+servers:
+  web:
+    - 203.0.113.10
+
+# Kamal Proxy obtains and renews a Let's Encrypt certificate for this host.
+proxy:
+  ssl: true
+  host: <%= app_host %>
+
+# Kamal runs a local registry and tunnels it over SSH; no external registry is needed.
+registry:
+  server: localhost:5555
+
+# Build for the common x86_64 Linux server. Change to arm64 for an ARM server.
+builder:
+  arch: amd64
+
+# Keep SQLite databases and local Active Storage uploads across container replacements.
+volumes:
+  - "fizzy-storage:/rails/storage"
+
+# Bridge fingerprinted assets while a deploy switches containers.
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ASSUME_SSL: true
+    FORCE_SSL: true
+    APP_HOST: <%= app_host %>
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    SOLID_QUEUE_IN_PUMA: true
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Kamal defaults to SSH user root; set this if your server uses another Docker-enabled user.
+# ssh:
+#   user: ubuntu
