diff --git a/saas/test/controllers/billing/checkouts_controller_test.rb b/saas/test/controllers/billing/checkouts_controller_test.rb
new file mode 100644
index 0000000..7bad10e
--- /dev/null
+++ b/saas/test/controllers/billing/checkouts_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  test "account admin is redirected to Stripe checkout" do
+    previous_price = ENV["STRIPE_PRICE_UNLIMITED"]
+    ENV["STRIPE_PRICE_UNLIMITED"] = "price_unlimited"
+    sign_in_as :mike
+    account = accounts(:initech)
+    checkout_session = Struct.new(:url).new("https://checkout.stripe.com/session")
+
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" &&
+        attributes[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        attributes[:client_reference_id] == account.id &&
+        attributes[:metadata] == { account_id: account.id, plan_key: "unlimited" } &&
+        attributes[:subscription_data][:metadata][:plan_key] == "unlimited"
+    end.returns(checkout_session)
+
+    post saas.billing_checkout_path(script_name: account.slug), params: { plan_key: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/session"
+  ensure
+    ENV["STRIPE_PRICE_UNLIMITED"] = previous_price
+  end
+
+  test "checkout is restricted to account admins" do
+    sign_in_as :jz
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.billing_checkout_path(script_name: accounts(:"37s").slug), params: { plan_key: "unlimited" }
+
+    assert_response :forbidden
+  end
+
+  test "billing portal sends the customer to Stripe and returns to settings" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_stripe_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_portal",
+      stripe_subscription_id: "sub_portal",
+      status: "active"
+    )
+    portal_session = Struct.new(:url).new("https://billing.stripe.com/session")
+
+    Stripe::BillingPortal::Session.expects(:create).with do |attributes|
+      attributes[:customer] == "cus_portal" && attributes[:return_url].include?("/account/settings")
+    end.returns(portal_session)
+
+    post saas.billing_portal_path(script_name: account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/session"
+  end
+end
