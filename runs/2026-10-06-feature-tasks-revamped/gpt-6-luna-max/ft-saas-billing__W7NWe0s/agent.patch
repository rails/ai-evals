diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..75506c7
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,126 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  def active?
+    status.in?(ACTIVE_STATUSES) && Account::Billing::PAID_PLAN_KEYS.include?(plan_key)
+  end
+
+  class << self
+    def apply_stripe_event(event)
+      event_type = stripe_value(event, :type)
+      stripe_object = stripe_value(stripe_value(event, :data), :object)
+
+      case event_type
+      when "checkout.session.completed"
+        sync_checkout_session(stripe_object)
+      when "customer.subscription.created", "customer.subscription.updated",
+           "customer.subscription.deleted", "customer.subscription.paused", "customer.subscription.resumed"
+        sync_stripe_subscription(stripe_object)
+      end
+    end
+
+    private
+      def sync_checkout_session(checkout_session)
+        return unless stripe_value(checkout_session, :mode) == "subscription"
+
+        account = account_for(checkout_session)
+        return unless account
+
+        subscription_id = stripe_id(stripe_value(checkout_session, :subscription))
+        customer_id = stripe_id(stripe_value(checkout_session, :customer))
+        metadata = stripe_value(checkout_session, :metadata)
+        plan_key = Account::Billing.valid_plan_key(stripe_value(metadata, :plan_key))
+        return unless customer_id.present? && subscription_id.present?
+
+        subscription = account.stripe_subscription || account.build_stripe_subscription
+        new_subscription = subscription.stripe_subscription_id != subscription_id
+
+        subscription.assign_attributes(
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: subscription_id,
+          plan_key: plan_key || subscription.plan_key,
+          status: new_subscription || subscription.status.blank? ? "incomplete" : subscription.status
+        )
+        subscription.save!
+      end
+
+      def sync_stripe_subscription(stripe_subscription)
+        account = account_for(stripe_subscription)
+        return unless account
+
+        subscription_id = stripe_id(stripe_value(stripe_subscription, :id))
+        customer_id = stripe_id(stripe_value(stripe_subscription, :customer))
+        metadata = stripe_value(stripe_subscription, :metadata)
+        plan_key = plan_key_for(stripe_subscription) ||
+          Account::Billing.valid_plan_key(stripe_value(metadata, :plan_key))
+        return unless customer_id.present? && subscription_id.present?
+
+        subscription = account.stripe_subscription || account.build_stripe_subscription
+        if subscription.stripe_subscription_id.present? && subscription.stripe_subscription_id != subscription_id &&
+            (subscription.active? || subscription.status == "incomplete")
+          return
+        end
+
+        subscription.assign_attributes(
+          stripe_customer_id: customer_id,
+          stripe_subscription_id: subscription_id,
+          plan_key: plan_key || subscription.plan_key,
+          status: stripe_value(stripe_subscription, :status),
+          current_period_end: stripe_time(stripe_value(stripe_subscription, :current_period_end)),
+          cancel_at: stripe_time(stripe_value(stripe_subscription, :cancel_at))
+        )
+        subscription.save!
+      end
+
+      def account_for(stripe_object)
+        metadata = stripe_value(stripe_object, :metadata)
+        account_id = stripe_value(metadata, :account_id) || stripe_value(stripe_object, :client_reference_id)
+        account = Account.find_by(id: account_id) if account_id.present?
+
+        if account.nil?
+          subscription_id = stripe_id(stripe_value(stripe_object, :id))
+          customer_id = stripe_id(stripe_value(stripe_object, :customer))
+          record = find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+          record ||= find_by(stripe_customer_id: customer_id) if customer_id.present?
+          account = record&.account
+        end
+
+        account
+      end
+
+      def plan_key_for(stripe_subscription)
+        items = stripe_value(stripe_value(stripe_subscription, :items), :data)
+        price_ids = Array(items).filter_map do |item|
+          price = stripe_value(item, :price) || stripe_value(item, :plan)
+          stripe_id(price)
+        end
+
+        Account::Billing.plan_key_for_stripe_prices(price_ids)
+      end
+
+      def stripe_value(object, key)
+        if object.respond_to?(:[])
+          object[key.to_s] || object[key.to_sym]
+        elsif object.respond_to?(key)
+          object.public_send(key)
+        end
+      end
+
+      def stripe_id(value)
+        if value.respond_to?(:[]) && !value.is_a?(String)
+          stripe_value(value, :id)&.to_s
+        else
+          value&.to_s
+        end
+      end
+
+      def stripe_time(value)
