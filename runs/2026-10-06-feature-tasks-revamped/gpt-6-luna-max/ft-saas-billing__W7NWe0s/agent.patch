diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..12221a8
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,21 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    return head :service_unavailable if webhook_secret.blank?
+
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      webhook_secret
+    )
+
+    Account::Subscription.apply_stripe_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..82a7ca4
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,157 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_PLAN_KEY = "free"
+  UNLIMITED_PLAN_KEY = "unlimited"
+  UNLIMITED_PLUS_PLAN_KEY = "unlimited_plus"
+
+  PLAN_KEYS = [ FREE_PLAN_KEY, UNLIMITED_PLAN_KEY, UNLIMITED_PLUS_PLAN_KEY ].freeze
+  PAID_PLAN_KEYS = [ UNLIMITED_PLAN_KEY, UNLIMITED_PLUS_PLAN_KEY ].freeze
+
+  PLANS = {
+    FREE_PLAN_KEY => {
+      name: "Free",
+      price_in_cents: 0,
+      card_limit: 1_000,
+      storage_limit: 1.gigabyte
+    }.freeze,
+    UNLIMITED_PLAN_KEY => {
+      name: "Unlimited",
+      price_in_cents: 2_000,
+      card_limit: nil,
+      storage_limit: 5.gigabytes
+    }.freeze,
+    UNLIMITED_PLUS_PLAN_KEY => {
+      name: "Unlimited+",
+      price_in_cents: 2_500,
+      card_limit: nil,
+      storage_limit: 500.gigabytes
+    }.freeze
+  }.freeze
+
+  PRICE_ENVIRONMENT_VARIABLES = {
+    UNLIMITED_PLAN_KEY => %w[ STRIPE_PRICE_UNLIMITED STRIPE_UNLIMITED_PRICE_ID STRIPE_MONTHLY_V1_PRICE_ID ],
+    UNLIMITED_PLUS_PLAN_KEY => %w[ STRIPE_PRICE_UNLIMITED_PLUS STRIPE_UNLIMITED_PLUS_PRICE_ID ]
+  }.freeze
+  EXTRA_STORAGE_PRICE_ENVIRONMENT_VARIABLES = %w[ STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID STRIPE_PRICE_EXTRA_STORAGE ]
+
+  included do
+    has_one :stripe_subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def plan_key
+    if comped?
+      UNLIMITED_PLUS_PLAN_KEY
+    elsif stripe_subscription&.active?
+      stripe_subscription.plan_key
+    else
+      FREE_PLAN_KEY
+    end
+  end
+
+  def plan
+    plan_name
+  end
+
+  def plan_name
+    plan_details.fetch(:name)
+  end
+
+  def plan_details
+    PLANS.fetch(plan_key, PLANS.fetch(FREE_PLAN_KEY))
+  end
+
+  def card_limit
+    plan_details.fetch(:card_limit)
+  end
+
+  def cards_used
+    if overridden_limit&.card_count.nil?
+      cards_count
+    else
+      overridden_limit.card_count
+    end
+  end
+
+  def remaining_cards
+    if card_limit
+      [ card_limit - cards_used, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    remaining_cards.present? && remaining_cards.positive? && remaining_cards <= 100
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    Account::BillingWaiver.create_or_find_by!(account_id: id)
+    association(:billing_waiver).reset
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def active_subscription
+    stripe_subscription if stripe_subscription&.active?
+  end
+
+  def stripe_customer_id
+    stripe_subscription&.stripe_customer_id
+  end
+
+  class << self
+    def stripe_price_id(plan_key)
+      PRICE_ENVIRONMENT_VARIABLES.fetch(plan_key.to_s, []).filter_map { |name| ENV[name].presence }.first
+    end
+
+    def stripe_line_items(plan_key)
+      if price_id = stripe_price_id(plan_key)
+        [ { price: price_id, quantity: 1 } ]
+      elsif plan_key.to_s == UNLIMITED_PLUS_PLAN_KEY
+        base_price_id = stripe_price_id(UNLIMITED_PLAN_KEY)
+        extra_storage_price_id = EXTRA_STORAGE_PRICE_ENVIRONMENT_VARIABLES.filter_map { |name| ENV[name].presence }.first
+
+        if base_price_id.present? && extra_storage_price_id.present?
+          [ { price: base_price_id, quantity: 1 }, { price: extra_storage_price_id, quantity: 1 } ]
+        else
+          []
+        end
+      else
+        []
+      end
+    end
+
+    def plan_key_for_stripe_price(price_id)
+      plan_key_for_stripe_prices([ price_id ])
+    end
+
+    def plan_key_for_stripe_prices(price_ids)
+      price_ids = Array(price_ids).compact
+      unlimited_plus_price_id = stripe_price_id(UNLIMITED_PLUS_PLAN_KEY)
+      unlimited_price_id = stripe_price_id(UNLIMITED_PLAN_KEY)
+
+      if (unlimited_plus_price_id.present? && price_ids.include?(unlimited_plus_price_id)) ||
+          price_ids.any? { |id| EXTRA_STORAGE_PRICE_ENVIRONMENT_VARIABLES.any? { |name| ENV[name].present? && ENV[name] == id } }
+        UNLIMITED_PLUS_PLAN_KEY
+      elsif unlimited_price_id.present? && price_ids.include?(unlimited_price_id)
+        UNLIMITED_PLAN_KEY
+      end
+    end
+
+    def valid_plan_key(plan_key)
+      plan_key.to_s if PAID_PLAN_KEYS.include?(plan_key.to_s)
+    end
+  end
+end
