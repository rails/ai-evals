+class Admin::Accounts::OverridesController < AdminController
+  before_action :set_account
+
+  def create
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+    @overridden_limit.update!(overridden_limit_params)
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(@account), notice: "Account limits overridden"
