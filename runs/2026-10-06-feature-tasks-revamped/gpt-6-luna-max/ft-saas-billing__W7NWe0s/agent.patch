@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Card::BillingLimitsTest < ActionDispatch::IntegrationTest
+  test "free account can draft at its card limit but cannot publish or create through the API" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 1_000)
+    board = boards(:miltons_wish_list)
+    board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(board, script_name: account.slug)
+    end
+    assert_response :redirect
+    assert Card.last.drafted?
+
+    card = Card.last
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(board, script_name: account.slug),
+        params: { card: { title: "Blocked API card" } },
+        as: :json
+    end
+    assert_response :forbidden
+
+    post card_publish_path(card, script_name: account.slug)
+    assert_response :forbidden
+    assert card.reload.drafted?
+  end
+
+  test "card limit pitch replaces create buttons and countdown reports cards left" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message a", text: "Upgrade"
+
+    account.update_column(:cards_count, 950)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "paid plan allows unlimited cards and uses its own storage allowance" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.update_column(:cards_count, 1_000)
+    account.create_stripe_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_paid_card_test",
+      stripe_subscription_id: "sub_paid_card_test",
+      status: "active"
+    )
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+end
