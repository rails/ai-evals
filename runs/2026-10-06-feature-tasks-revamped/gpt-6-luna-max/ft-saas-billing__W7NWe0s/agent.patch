@@ -0,0 +1,18 @@
+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.stripe_customer_id.present?
+      portal_session = Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: account_settings_url
+      )
+      redirect_to portal_session.url, allow_other_host: true
+    else
+      redirect_to account_settings_path, alert: "There is no billing account to manage yet."
+    end
+  rescue Stripe::StripeError => error
+    Rails.logger.error("Stripe billing portal failed: #{error.message}")
+    redirect_to account_settings_path, alert: "We couldn't open the billing portal. Please try again."
+  end
+end
