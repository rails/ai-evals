diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..88fb9da
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,45 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan_key = Account::Billing.valid_plan_key(params.require(:plan_key))
+    raise ActionController::BadRequest, "Choose a paid plan" unless plan_key
+    if Current.account.comped? || Current.account.active_subscription
+      redirect_to account_settings_path, alert: "Manage your existing plan through the billing portal."
+      return
+    end
+
+    line_items = Account::Billing.stripe_line_items(plan_key)
+    raise ActionController::BadRequest, "The selected plan is not available" if line_items.empty?
+
+    checkout_session = Stripe::Checkout::Session.create(checkout_session_attributes(plan_key, line_items))
+    redirect_to checkout_session.url, allow_other_host: true
+  rescue ActionController::BadRequest => error
+    redirect_to account_settings_path, alert: error.message
+  rescue Stripe::StripeError => error
+    Rails.logger.error("Stripe checkout failed: #{error.message}")
+    redirect_to account_settings_path, alert: "We couldn't start checkout. Please try again."
+  end
+
+  private
+    def checkout_session_attributes(plan_key, line_items)
+      account = Current.account
+      metadata = { account_id: account.id, plan_key: plan_key }
+
+      {
+        mode: "subscription",
+        line_items: line_items,
+        client_reference_id: account.id,
+        metadata: metadata,
+        subscription_data: { metadata: metadata },
+        success_url: account_settings_url,
+        cancel_url: account_settings_url
+      }.tap do |attributes|
+        if account.stripe_customer_id.present?
+          attributes[:customer] = account.stripe_customer_id
+        elsif account.owner_email.present?
+          attributes[:customer_email] = account.owner_email
+        end
+      end
+    end
+end
diff --git a/saas/app/controllers/billing/portals_controller.rb b/saas/app/controllers/billing/portals_controller.rb
