diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..ea5ee6e
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+require "openssl"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "a signed subscription change updates the plan without authentication" do
+    account = accounts(:initech)
+    previous_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    previous_price = ENV["STRIPE_PRICE_UNLIMITED_PLUS"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_PRICE_UNLIMITED_PLUS"] = "price_unlimited_plus"
+
+    payload = {
+      id: "evt_subscription_updated",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_webhook_controller",
+          customer: "cus_webhook_controller",
+          status: "active",
+          metadata: { account_id: account.id, plan_key: "unlimited_plus" },
+          items: { data: [ { price: { id: "price_unlimited_plus" } } ] }
+        }
+      }
+    }.to_json
+    timestamp = Time.now.to_i
+    signature = OpenSSL::HMAC.hexdigest("SHA256", ENV["STRIPE_WEBHOOK_SECRET"], "#{timestamp}.#{payload}")
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path,
+        params: payload,
+        headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => "t=#{timestamp},v1=#{signature}"
+        }
+    end
+
+    assert_response :success
+    assert_equal "Unlimited+", account.reload.plan_name
+    assert_equal "cus_webhook_controller", account.stripe_customer_id
+  ensure
+    ENV["STRIPE_WEBHOOK_SECRET"] = previous_secret
+    ENV["STRIPE_PRICE_UNLIMITED_PLUS"] = previous_price
+  end
+
+  test "an invalid webhook signature is rejected" do
+    previous_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path,
+        params: "{}",
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "invalid" }
+    end
+
+    assert_response :bad_request
+  ensure
+    ENV["STRIPE_WEBHOOK_SECRET"] = previous_secret
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..91f93d1
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,164 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 0)
+  end
+
+  test "free plan includes 1000 cards and 1 GB" do
+    assert_equal "free", @account.plan_key
+    assert_equal "Free", @account.plan_name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.remaining_cards
+  end
+
+  test "unlimited plan has no card limit and includes 5 GB" do
+    @account.create_stripe_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "unlimited plus includes 500 GB" do
+    @account.create_stripe_subscription!(
+      plan_key: "unlimited_plus",
+      stripe_customer_id: "cus_unlimited_plus",
+      stripe_subscription_id: "sub_unlimited_plus",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan_name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "inactive subscriptions return the account to the free plan" do
+    @account.create_stripe_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_canceled",
+      stripe_subscription_id: "sub_canceled",
+      status: "canceled"
+    )
+
+    assert_equal "Free", @account.plan_name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "card count warning starts within the last 100 cards" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.remaining_cards
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.remaining_cards
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "support overrides card and storage usage until reset" do
+    @account.overridden_limit = Account::OverriddenLimit.new(card_count: 950, bytes_used: 2.gigabytes)
+    @account.save!
+
+    assert_equal 950, @account.cards_used
+    assert_equal 50, @account.remaining_cards
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+
+    @account.overridden_limit.destroy!
+    @account.reload
+
+    assert_equal 0, @account.cards_used
+    assert_equal 0, @account.bytes_used
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "comped accounts receive Unlimited+ entitlements and can be uncomped" do
+    @account.comp!
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp!
+
+    assert_not @account.comped?
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "the old base and storage add-on prices create the two monthly plan bundles" do
+  previous_base_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+  previous_extra_price = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+  ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly_base"
+  ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_monthly_storage"
+
+  assert_equal [ { price: "price_monthly_base", quantity: 1 } ],
+    Account::Billing.stripe_line_items("unlimited")
+  assert_equal [
+    { price: "price_monthly_base", quantity: 1 },
+    { price: "price_monthly_storage", quantity: 1 }
+  ], Account::Billing.stripe_line_items("unlimited_plus")
+  assert_equal "unlimited_plus", Account::Billing.plan_key_for_stripe_prices([ "price_monthly_base", "price_monthly_storage" ])
+ensure
+  ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = previous_base_price
+  ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = previous_extra_price
+end
+
+test "subscription webhook activates the plan associated with its Stripe price" do
+    previous_price = ENV["STRIPE_PRICE_UNLIMITED"]
+    ENV["STRIPE_PRICE_UNLIMITED"] = "price_unlimited"
+
+    Account::Subscription.apply_stripe_event(
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_webhook",
+          customer: "cus_webhook",
+          status: "active",
+          current_period_end: 1_800_000_000,
+          metadata: { account_id: @account.id, plan_key: "unlimited_plus" },
+          items: { data: [ { price: { id: "price_unlimited" } } ] }
+        }
+      }
+    )
+
+    assert_equal "Unlimited", @account.reload.plan_name
+    assert_equal "cus_webhook", @account.stripe_customer_id
+    assert_equal Time.at(1_800_000_000).utc, @account.stripe_subscription.current_period_end
+  ensure
+    ENV["STRIPE_PRICE_UNLIMITED"] = previous_price
+  end
+
+  test "checkout session webhook keeps the subscription inactive until Stripe confirms it" do
+    Account::Subscription.apply_stripe_event(
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          mode: "subscription",
+          client_reference_id: @account.id,
+          customer: "cus_checkout",
+          subscription: "sub_checkout",
+          metadata: { plan_key: "unlimited" }
+        }
+      }
+    )
+
+    subscription = @account.stripe_subscription
+    assert_equal "incomplete", subscription.status
+    assert_equal "Free", @account.plan_name
+    assert_equal "cus_checkout", subscription.stripe_customer_id
+  end
+end
