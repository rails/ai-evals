+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= link_to "Accounts", Fizzy::Saas::Engine.routes.url_helpers.admin_accounts_path, class: "txt-link" %> / <%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="flex flex-column gap-half margin-block-half">
+      <div class="flex justify-space-between gap">
+        <dt>Plan</dt>
+        <dd><strong><%= @account.plan_name %></strong><%= " (comped)" if @account.comped? %></dd>
+      </div>
+      <div class="flex justify-space-between gap">
+        <dt>Card count</dt>
+        <dd><%= number_with_delimiter(@account.cards_used) %></dd>
+      </div>
+      <div class="flex justify-space-between gap">
+        <dt>Bytes used</dt>
+        <dd><%= number_to_human_size(@account.bytes_used) %></dd>
+      </div>
+    </dl>
+
+    <% if @account.comped? %>
+      <%= button_to "Uncomp", Fizzy::Saas::Engine.routes.url_helpers.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    <% else %>
+      <%= button_to "Comp", Fizzy::Saas::Engine.routes.url_helpers.admin_account_comp_path(@account), method: :post, class: "btn" %>
+    <% end %>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+    </header>
+
+    <%= form_with model: @overridden_limit, url: Fizzy::Saas::Engine.routes.url_helpers.admin_account_override_path(@account), scope: :overridden_limit, method: :post, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <div>
+        <%= form.label :card_count, "Card count", class: "label" %>
+        <%= form.number_field :card_count, min: 0, class: "input full-width" %>
+      </div>
+      <div>
+        <%= form.label :bytes_used, "Bytes used", class: "label" %>
+        <%= form.number_field :bytes_used, min: 0, class: "input full-width" %>
+      </div>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <% if @account.overridden_limit.present? %>
+      <%= button_to "Reset", Fizzy::Saas::Engine.routes.url_helpers.admin_account_override_path(@account), method: :delete, class: "btn" %>
+    <% end %>
+  </div>
+</section>
