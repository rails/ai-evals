diff --git a/saas/test/controllers/account_settings_billing_test.rb b/saas/test/controllers/account_settings_billing_test.rb
new file mode 100644
index 0000000..b54ef43
--- /dev/null
+++ b/saas/test/controllers/account_settings_billing_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class AccountSettingsBillingTest < ActionDispatch::IntegrationTest
+  test "account admins see their plan, prices, and Upgrade actions" do
+    sign_in_as :mike
+    account = accounts(:initech)
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing" do
+      assert_select "h2", text: "Plan"
+      assert_select "strong", text: "Free"
+      assert_select "strong", text: "Unlimited"
+      assert_select "strong", text: "Unlimited+"
+      assert_select "form[action=?] button", saas.billing_checkout_path(script_name: account.slug), text: "Upgrade", count: 2
+      assert_select "p", text: /1,000 cards and 1 GB/
+      assert_select "div", text: /\$20\/month, 5 GB/
+      assert_select "div", text: /\$25\/month, 500 GB/
+    end
+  end
+
+  test "paid account admins can open the customer portal" do
+    sign_in_as :mike
+    account = accounts(:initech)
+    account.create_stripe_subscription!(
+      plan_key: "unlimited",
+      stripe_customer_id: "cus_settings_portal",
+      stripe_subscription_id: "sub_settings_portal",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing strong", text: "Unlimited"
+    assert_select "form[action=?] button", saas.billing_portal_path(script_name: account.slug), text: "Manage billing"
+  end
+
+  test "non-admin account members do not see billing controls" do
+    sign_in_as :jz
+    account = accounts(:"37s")
+
+    get account_settings_path(script_name: account.slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing", count: 0
+  end
+end
