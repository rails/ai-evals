+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  retry_on Net::OpenTimeout, Net::ReadTimeout, Socket::ResolutionError, WebPush::ResponseError, wait: :polynomially_longer
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification)
+    notification.push_now
+  end
+end
