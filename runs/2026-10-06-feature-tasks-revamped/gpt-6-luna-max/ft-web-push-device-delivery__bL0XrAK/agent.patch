diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..7c508d3
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,58 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :endpoint_digest, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 4096 }
+  validate :validate_endpoint
+
+  class << self
+    def register_for(user, attributes)
+      attributes = attributes.to_h.symbolize_keys
+      digest = Digest::SHA256.hexdigest(attributes[:endpoint].to_s)
+
+      subscription = user.push_subscriptions.create_or_find_by!(endpoint_digest: digest) do |record|
+        record.assign_attributes(attributes)
+      end
+
+      subscription.update!(attributes)
+      subscription
+    end
+  end
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: JSON.generate(notification.push_payload),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      ttl: 1.day.to_i,
+      open_timeout: 5,
+      read_timeout: 5,
+      vapid: {
+        subject: "mailto:support@fizzy.do",
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint) if endpoint.present?
+    end
+
+    def validate_endpoint
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+        valid_endpoint = uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.blank?
+        errors.add(:endpoint, "must be a secure HTTPS URL") unless valid_endpoint
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "is invalid")
+    end
+end
