diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..0ca0b1a
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "only accepts secure push endpoints" do
+    subscription = users(:kevin).push_subscriptions.build(
+      endpoint: "http://push.example.com/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    )
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be a secure HTTPS URL"
+  end
+
+  test "removes subscriptions rejected as expired by the push service" do
+    subscription = PushSubscription.register_for(users(:kevin), {
+      endpoint: "https://push.example.com/subscriptions/expired-device",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    })
+    notification = notifications(:layout_commented_kevin)
+    response = Struct.new(:body).new("expired")
+
+    WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      subscription.deliver(notification)
+    end
+  end
+
+  test "the same browser endpoint can be registered for different account users" do
+    attributes = {
+      endpoint: "https://push.example.com/subscriptions/shared-device",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    }
+
+    david_subscription = PushSubscription.register_for(users(:david), attributes)
+    mike_subscription = PushSubscription.register_for(users(:mike), attributes)
+
+    assert_not_equal david_subscription, mike_subscription
+    assert_equal users(:david).account, david_subscription.account
+    assert_equal users(:mike).account, mike_subscription.account
+    assert_equal attributes[:endpoint], david_subscription.endpoint
+    assert_equal attributes[:endpoint], mike_subscription.endpoint
+  end
+end
