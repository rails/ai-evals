diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..69f7320
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    @subscription_attributes = {
+      endpoint: "https://push.example.com/subscriptions/device-1",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    }
+
+    sign_in_as @user
+  end
+
+  test "create registers a push subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: @subscription_attributes },
+        as: :json
+    end
+
+    assert_response :created, @response.body
+    assert_equal @subscription_attributes.stringify_keys,
+      @user.push_subscriptions.last.attributes.slice("endpoint", "p256dh_key", "auth_key")
+    assert @response.parsed_body["id"].present?
+  end
+
+  test "create updates an existing subscription for this device" do
+    post user_push_subscriptions_path(@user),
+      params: { push_subscription: @subscription_attributes },
+      as: :json
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: @subscription_attributes.merge(p256dh_key: "rotated-public-key") },
+        as: :json
+    end
+
+    assert_response :created, @response.body
+    assert_equal "rotated-public-key", @user.push_subscriptions.sole.p256dh_key
+  end
+
+  test "a user cannot register subscriptions for another user" do
+    post user_push_subscriptions_path(users(:jz)),
+      params: { push_subscription: @subscription_attributes },
+      as: :json
+
+    assert_response :forbidden
+    assert_empty users(:jz).push_subscriptions
+  end
+
+  test "a user cannot remove another user's subscription" do
+    subscription = PushSubscription.register_for(users(:jz), @subscription_attributes)
+
+    delete user_push_subscription_path(@user, subscription), as: :json
+
+    assert_response :not_found
+    assert PushSubscription.exists?(subscription.id)
+  end
+
+  test "destroy removes the current user's subscription" do
+    subscription = PushSubscription.register_for(@user, @subscription_attributes)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
