 require "test_helper"
 
 class NotificationTest < ActiveSupport::TestCase
+  test "push payload uses the tray's title and body and opens its card" do
+    notification = notifications(:layout_commented_kevin)
+    helpers = ApplicationController.helpers
+
+    assert_equal helpers.notification_title(notification), notification.push_payload[:title]
+    assert_equal helpers.notification_body(notification), notification.push_payload[:body]
+    assert_equal Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug),
+      notification.push_payload[:url]
+  end
+
+  test "mention push content matches the tray content" do
+    notification = notifications(:logo_mentioned_david)
+    helpers = ApplicationController.helpers
+
+    assert_equal helpers.notification_title(notification), notification.push_payload[:title]
+    assert_equal helpers.notification_body(notification), notification.push_payload[:body]
+  end
+
+  test "push notifications are queued when a tray notification lands or changes source" do
+    notification = notifications(:layout_commented_kevin)
+    notification.destroy!
+
+    PushSubscription.register_for(users(:kevin), {
+      endpoint: "https://push.example.com/subscriptions/callback-test",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    })
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david))
+    end
+
+    notification = users(:kevin).notifications.find_by!(card: cards(:layout))
+    assert_enqueued_with job: Notification::PushJob do
+      notification.update!(source: events(:layout_published), creator: users(:david))
+    end
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "push delivery sends the notification payload with configured VAPID keys" do
+    notification = notifications(:layout_commented_kevin)
+    subscription = PushSubscription.register_for(users(:kevin), {
+      endpoint: "https://push.example.com/subscriptions/delivery-test",
+      p256dh_key: "device-public-key",
+      auth_key: "device-auth-key"
+    })
+
+    ENV.stubs(:[]).with("VAPID_PUBLIC_KEY").returns("public-vapid-key")
+    ENV.stubs(:[]).with("VAPID_PRIVATE_KEY").returns("private-vapid-key")
+    WebPush.expects(:payload_send).with do |options|
+      payload = JSON.parse(options[:message])
+      payload["title"] == notification.push_payload[:title] &&
+        payload["body"] == notification.push_payload[:body] &&
+        payload["url"] == notification.push_payload[:url] &&
+        options[:endpoint] == subscription.endpoint &&
+        options[:p256dh] == subscription.p256dh_key &&
+        options[:auth] == subscription.auth_key &&
+        options.dig(:vapid, :public_key) == "public-vapid-key" &&
+        options.dig(:vapid, :private_key) == "private-vapid-key"
+    end.once
+
+    notification.push_now
+  end
+
