diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..180e113
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,176 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "disableButton", "enableButton", "message" ]
+  static values = { publicKey: String, subscriptionsUrl: String }
+
+  #subscriptionId
+  #busy = false
+
+  connect() {
+    this.#setEnabled(false)
+
+    if (!this.publicKeyValue) {
+      this.#setMessage("Push notifications aren't configured for this server.")
+    } else if (!this.#supported) {
+      this.#setMessage("Push notifications aren't supported in this browser.")
+    } else if (window.Notification?.permission === "denied") {
+      this.#showBlockedHelp()
+    } else if (Notification.permission === "granted") {
+      this.#restoreSubscription()
+    } else {
+      this.enableButtonTarget.hidden = false
+    }
+  }
+
+  async enable() {
+    if (this.#busy || !this.#supported || window.Notification?.permission === "denied") return
+
+    this.#setBusy(true)
+    this.#setMessage("")
+
+    try {
+      const permission = await window.Notification.requestPermission()
+      if (permission !== "granted") {
+        this.#setEnabled(false)
+        this.#setMessage("Notifications weren't enabled for this device.")
+        return
+      }
+
+      const registration = await this.#serviceWorkerRegistration()
+      let subscription = await registration.pushManager.getSubscription()
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      }
+
+      this.#subscriptionId = await this.#saveSubscription(subscription)
+      this.#setEnabled(true)
+      this.#setMessage("Push notifications are enabled for this device.")
+    } catch (error) {
+      console.error("Couldn't enable push notifications", error)
+      this.#setEnabled(false)
+      this.#setMessage("Couldn't enable push notifications. Please try again.")
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  async disable() {
+    if (this.#busy) return
+
+    this.#setBusy(true)
+    this.#setMessage("")
+    let unsubscribed = false
+
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.#subscriptionId ||= await this.#saveSubscription(subscription)
+        unsubscribed = await subscription.unsubscribe()
+        if (!unsubscribed) throw new Error("Browser couldn't unsubscribe")
+      }
+
+      if (this.#subscriptionId) {
+        const response = await destroy(
+          `${this.subscriptionsUrlValue}/${encodeURIComponent(this.#subscriptionId)}`,
+          { responseKind: "json" }
+        )
+        if (!response.ok) throw new Error(`Subscription deletion failed: ${response.statusCode}`)
+      }
+
+      this.#subscriptionId = null
+      this.#setEnabled(false)
+      this.#setMessage("Push notifications are off for this device.")
+    } catch (error) {
+      console.error("Couldn't disable push notifications", error)
+      if (unsubscribed) {
+        this.#setEnabled(false)
+        this.#setMessage("Push notifications are off on this device, but the server subscription couldn't be removed.")
+      } else {
+        this.#setMessage("Couldn't turn off push notifications. Please try again.")
+      }
+    } finally {
+      this.#setBusy(false)
+    }
+  }
+
+  async #restoreSubscription() {
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        this.#subscriptionId = await this.#saveSubscription(subscription)
+        this.#setEnabled(true)
+      } else {
+        this.enableButtonTarget.hidden = false
+      }
+    } catch (error) {
+      console.error("Couldn't restore push subscription", error)
+      this.enableButtonTarget.hidden = false
+      this.#setMessage("Couldn't check push notifications for this device.")
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+
+    if (!response.ok) throw new Error(`Subscription registration failed: ${response.statusCode}`)
+    return (await response.json).id
+  }
+
+  async #serviceWorkerRegistration() {
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    return await navigator.serviceWorker.ready
+  }
+
+  #showBlockedHelp() {
+    this.#setEnabled(false)
+    this.detailsTargets.forEach(details => details.hidden = false)
+    this.#setMessage("Notifications are blocked. Update your browser or device settings to turn them on.")
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.enableButtonTarget.hidden = enabled || window.Notification?.permission === "denied"
+    this.disableButtonTarget.hidden = !enabled
+    this.detailsTargets.forEach(details => details.hidden = enabled || window.Notification?.permission !== "denied")
+  }
+
+  #setBusy(busy) {
+    this.#busy = busy
+    this.element.setAttribute("aria-busy", busy)
+    this.enableButtonTarget.disabled = busy
+    this.disableButtonTarget.disabled = busy
+  }
+
+  #setMessage(message) {
+    this.messageTarget.textContent = message
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(window.atob(base64), character => character.charCodeAt(0))
+  }
+}
