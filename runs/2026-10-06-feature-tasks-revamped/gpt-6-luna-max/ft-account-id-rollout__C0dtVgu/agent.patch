+         WHERE #{column(:tenant_card, :id)} = #{column(:closures, :card_id)}
+           AND (#{column(:closures, :user_id)} IS NULL OR EXISTS (
+             SELECT 1 FROM #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+             WHERE #{column(:tenant_user, :id)} = #{column(:closures, :user_id)}
+               AND #{column(:tenant_user, :account_id)} = #{column(:tenant_card, :account_id)}
+           )))
+      SQL
+      backfill_account_id :assignments, <<~SQL.squish
+        (SELECT tenant_card.account_id
+         FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+         INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_assignee)}
+           ON #{column(:tenant_assignee, :id)} = #{column(:assignments, :assignee_id)}
+          AND #{column(:tenant_assignee, :account_id)} = #{column(:tenant_card, :account_id)}
+         INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_assigner)}
+           ON #{column(:tenant_assigner, :id)} = #{column(:assignments, :assigner_id)}
+          AND #{column(:tenant_assigner, :account_id)} = #{column(:tenant_card, :account_id)}
+         WHERE #{column(:tenant_card, :id)} = #{column(:assignments, :card_id)})
+      SQL
+      backfill_account_id :board_publications, account_from(:board_publications, :boards, :board_id)
+      backfill_account_id :taggings, <<~SQL.squish
+        (SELECT tenant_card.account_id
+         FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+         INNER JOIN #{quoted_table(:tags)} AS #{quoted_table(:tenant_tag)}
+           ON #{column(:tenant_tag, :id)} = #{column(:taggings, :tag_id)}
+          AND #{column(:tenant_tag, :account_id)} = #{column(:tenant_card, :account_id)}
+         WHERE #{column(:tenant_card, :id)} = #{column(:taggings, :card_id)})
+      SQL
+      backfill_account_id :pins, account_for_card_user(:pins, :card_id, :user_id)
+      backfill_account_id :watches, account_for_card_user(:watches, :card_id, :user_id)
+      backfill_account_id :reactions, account_for_reactable_user
+      backfill_account_id :mentions, account_for_mention
+
+      backfill_account_id :user_settings, account_from(:user_settings, :users, :user_id)
+      backfill_account_id :search_queries, account_from(:search_queries, :users, :user_id)
+
+      backfill_account_id :entropies, <<~SQL.squish
+        (CASE #{column(:entropies, :container_type)}
+           WHEN 'Account' THEN (
+             SELECT tenant_account.id
+             FROM #{quoted_table(:accounts)} AS #{quoted_table(:tenant_account)}
+             WHERE #{column(:tenant_account, :id)} = #{column(:entropies, :container_id)}
+           )
+           WHEN 'Board' THEN (
+             SELECT tenant_board.account_id
+             FROM #{quoted_table(:boards)} AS #{quoted_table(:tenant_board)}
+             WHERE #{column(:tenant_board, :id)} = #{column(:entropies, :container_id)}
+           )
+         END)
+      SQL
+      backfill_account_id :storage_totals, <<~SQL.squish
+        (CASE #{column(:storage_totals, :owner_type)}
+           WHEN 'Account' THEN (
