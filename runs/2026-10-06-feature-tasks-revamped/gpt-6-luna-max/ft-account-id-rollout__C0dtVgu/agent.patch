+             SELECT tenant_board.account_id FROM #{quoted_table(:boards)} AS #{quoted_table(:tenant_board)}
+             WHERE #{column(:tenant_board, :id)} = #{column(:action_text_rich_texts, :record_id)}
+           )
+           WHEN 'Card' THEN (
+             SELECT tenant_card.account_id FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+             WHERE #{column(:tenant_card, :id)} = #{column(:action_text_rich_texts, :record_id)}
+           )
+           WHEN 'Comment' THEN (
+             SELECT tenant_comment.account_id FROM #{quoted_table(:comments)} AS #{quoted_table(:tenant_comment)}
+             WHERE #{column(:tenant_comment, :id)} = #{column(:action_text_rich_texts, :record_id)}
+           )
+         END)
+      SQL
+
+      backfill_account_id :active_storage_attachments, <<~SQL.squish
+        (CASE #{column(:active_storage_attachments, :record_type)}
+           WHEN 'Account' THEN (
+             SELECT tenant_account.id FROM #{quoted_table(:accounts)} AS #{quoted_table(:tenant_account)}
+             WHERE #{column(:tenant_account, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'Account::Import' THEN (
+             SELECT tenant_import.account_id FROM #{quoted_table(:account_imports)} AS #{quoted_table(:tenant_import)}
+             WHERE #{column(:tenant_import, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'Board' THEN (
+             SELECT tenant_board.account_id FROM #{quoted_table(:boards)} AS #{quoted_table(:tenant_board)}
+             WHERE #{column(:tenant_board, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'Card' THEN (
+             SELECT tenant_card.account_id FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+             WHERE #{column(:tenant_card, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'Comment' THEN (
+             SELECT tenant_comment.account_id FROM #{quoted_table(:comments)} AS #{quoted_table(:tenant_comment)}
+             WHERE #{column(:tenant_comment, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'Export' THEN (
+             SELECT tenant_export.account_id FROM #{quoted_table(:exports)} AS #{quoted_table(:tenant_export)}
+             WHERE #{column(:tenant_export, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'ActionText::RichText' THEN (
+             SELECT tenant_rich_text.account_id FROM #{quoted_table(:action_text_rich_texts)} AS #{quoted_table(:tenant_rich_text)}
+             WHERE #{column(:tenant_rich_text, :id)} = #{column(:active_storage_attachments, :record_id)}
+           )
+           WHEN 'User' THEN (
+             SELECT tenant_user.account_id FROM #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+             WHERE #{column(:tenant_user, :id)} = #{column(:active_storage_attachments, :record_id)}
