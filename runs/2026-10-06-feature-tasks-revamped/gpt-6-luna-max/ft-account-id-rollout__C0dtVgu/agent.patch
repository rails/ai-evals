+         FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+         INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+           ON #{column(:tenant_user, :id)} = #{column(child_table, user_foreign_key)}
+          AND #{column(:tenant_user, :account_id)} = #{column(:tenant_card, :account_id)}
+         WHERE #{column(:tenant_card, :id)} = #{column(child_table, card_foreign_key)})
+      SQL
+    end
+
+    def account_for_reactable_user
+      <<~SQL.squish
+        (CASE #{column(:reactions, :reactable_type)}
+           WHEN 'Card' THEN (
+             SELECT tenant_card.account_id
+             FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+               ON #{column(:tenant_user, :id)} = #{column(:reactions, :reacter_id)}
+              AND #{column(:tenant_user, :account_id)} = #{column(:tenant_card, :account_id)}
+             WHERE #{column(:tenant_card, :id)} = #{column(:reactions, :reactable_id)}
+           )
+           WHEN 'Comment' THEN (
+             SELECT tenant_comment.account_id
+             FROM #{quoted_table(:comments)} AS #{quoted_table(:tenant_comment)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+               ON #{column(:tenant_user, :id)} = #{column(:reactions, :reacter_id)}
+              AND #{column(:tenant_user, :account_id)} = #{column(:tenant_comment, :account_id)}
+             WHERE #{column(:tenant_comment, :id)} = #{column(:reactions, :reactable_id)}
+           )
+         END)
+      SQL
+    end
+
+    def account_for_mention
+      <<~SQL.squish
+        (CASE #{column(:mentions, :source_type)}
+           WHEN 'Card' THEN (
+             SELECT tenant_card.account_id
+             FROM #{quoted_table(:cards)} AS #{quoted_table(:tenant_card)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_mentioner)}
+               ON #{column(:tenant_mentioner, :id)} = #{column(:mentions, :mentioner_id)}
+              AND #{column(:tenant_mentioner, :account_id)} = #{column(:tenant_card, :account_id)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_mentionee)}
+               ON #{column(:tenant_mentionee, :id)} = #{column(:mentions, :mentionee_id)}
+              AND #{column(:tenant_mentionee, :account_id)} = #{column(:tenant_card, :account_id)}
+             WHERE #{column(:tenant_card, :id)} = #{column(:mentions, :source_id)}
+           )
+           WHEN 'Comment' THEN (
+             SELECT tenant_comment.account_id
+             FROM #{quoted_table(:comments)} AS #{quoted_table(:tenant_comment)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_mentioner)}
+               ON #{column(:tenant_mentioner, :id)} = #{column(:mentions, :mentioner_id)}
+              AND #{column(:tenant_mentioner, :account_id)} = #{column(:tenant_comment, :account_id)}
+             INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_mentionee)}
+               ON #{column(:tenant_mentionee, :id)} = #{column(:mentions, :mentionee_id)}
+              AND #{column(:tenant_mentionee, :account_id)} = #{column(:tenant_comment, :account_id)}
+             WHERE #{column(:tenant_comment, :id)} = #{column(:mentions, :source_id)}
+           )
+         END)
+      SQL
+    end
+
+    def quoted_table(name)
+      connection.quote_table_name(name)
+    end
+
+    def column(table, name)
+      "#{quoted_table(table)}.#{connection.quote_column_name(name)}"
+    end
+end
