+          AND #{column(:tenant_event, :account_id)} = #{column(:tenant_webhook, :account_id)}
+         WHERE #{column(:tenant_webhook, :id)} = #{column(:webhook_deliveries, :webhook_id)})
+      SQL
+
+      backfill_account_id :action_text_rich_texts, <<~SQL.squish
+        (CASE #{column(:action_text_rich_texts, :record_type)}
