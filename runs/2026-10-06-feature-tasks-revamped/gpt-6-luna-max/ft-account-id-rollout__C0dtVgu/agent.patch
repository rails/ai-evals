+             FROM #{quoted_table(:accounts)} AS #{quoted_table(:tenant_account)}
+             WHERE #{column(:tenant_account, :id)} = #{column(:storage_totals, :owner_id)}
+           )
+           WHEN 'Board' THEN (
+             SELECT tenant_board.account_id
+             FROM #{quoted_table(:boards)} AS #{quoted_table(:tenant_board)}
+             WHERE #{column(:tenant_board, :id)} = #{column(:storage_totals, :owner_id)}
+           )
+         END)
+      SQL
+
+      backfill_account_id :webhook_delinquency_trackers, account_from(:webhook_delinquency_trackers, :webhooks, :webhook_id)
