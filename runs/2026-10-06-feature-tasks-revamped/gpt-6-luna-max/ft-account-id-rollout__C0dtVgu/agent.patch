+         INNER JOIN #{quoted_table(:users)} AS #{quoted_table(:tenant_user)}
+           ON #{column(:tenant_user, :id)} = #{column(child_table, user_foreign_key)}
+          AND #{column(:tenant_user, :account_id)} = #{column(:tenant_filter, :account_id)}
+         WHERE #{column(:tenant_filter, :id)} = #{column(child_table, :filter_id)})
+      SQL
+    end
+
+    def account_for_card_user(child_table, card_foreign_key, user_foreign_key)
+      <<~SQL.squish
