+
+    def backfill_account_id(table, expression)
+      execute <<~SQL
+        UPDATE #{quoted_table(table)}
+        SET #{connection.quote_column_name(:account_id)} = #{expression}
+      SQL
+
+      execute <<~SQL
+        DELETE FROM #{quoted_table(table)}
+        WHERE #{column(table, :account_id)} IS NULL
+           OR NOT EXISTS (
+             SELECT 1 FROM #{quoted_table(:accounts)} AS #{quoted_table(:tenant_account)}
+             WHERE #{column(:tenant_account, :id)} = #{column(table, :account_id)}
+           )
+      SQL
+    end
+
+    def discard_dangling_storage_attachments
+      execute <<~SQL
+        DELETE FROM #{quoted_table(:active_storage_attachments)}
+        WHERE NOT EXISTS (
+          SELECT 1
+          FROM #{quoted_table(:active_storage_blobs)} AS #{quoted_table(:tenant_blob)}
+          WHERE #{column(:tenant_blob, :id)} = #{column(:active_storage_attachments, :blob_id)}
+            AND #{column(:tenant_blob, :account_id)} = #{column(:active_storage_attachments, :account_id)}
+        )
+      SQL
+    end
+
+    def replace_global_tag_title_index
+      remove_index :tags, name: "index_tags_on_title"
+      add_index :tags, [ :account_id, :title ], unique: true
+    end
+
+    def enforce_account_id_constraints
+      account_id_tables.each do |table|
+        change_column_null table, :account_id, false
+
+        unless connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+          add_index table, :account_id
+        end
+      end
+    end
+
+    def account_id_tables
+      (NEW_ACCOUNT_ID_TABLES + EXISTING_ACCOUNT_ID_TABLES + search_record_tables).uniq
+    end
+
+    def search_record_tables
+      connection.tables.grep(/\Asearch_records(?:_\d+)?\z/).map(&:to_sym)
+    end
+
+    def account_from(child_table, parent_table, foreign_key)
+      <<~SQL.squish
+        (SELECT tenant_parent.account_id
+         FROM #{quoted_table(parent_table)} AS #{quoted_table(:tenant_parent)}
+         WHERE #{column(:tenant_parent, :id)} = #{column(child_table, foreign_key)})
+      SQL
+    end
+
+    def account_for_filter_user(child_table, user_foreign_key)
+      <<~SQL.squish
+        (SELECT tenant_filter.account_id
