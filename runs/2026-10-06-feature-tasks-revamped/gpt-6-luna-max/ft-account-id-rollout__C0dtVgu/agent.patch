+
+    account_id_tables.each do |table|
+      if ACCOUNT_ID_INDEXES_TO_ADD.include?(table) || NEW_ACCOUNT_ID_TABLES.include?(table)
+        remove_index table, :account_id if index_exists?(table, :account_id)
