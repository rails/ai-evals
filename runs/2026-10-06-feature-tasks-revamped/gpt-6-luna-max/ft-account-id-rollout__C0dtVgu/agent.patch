+      backfill_account_id :assigners_filters, account_for_filter_user(:assigners_filters, :assigner_id)
+      backfill_account_id :closers_filters, account_for_filter_user(:closers_filters, :closer_id)
+      backfill_account_id :creators_filters, account_for_filter_user(:creators_filters, :creator_id)
+      backfill_account_id :boards_filters, <<~SQL.squish
+        (SELECT tenant_board.account_id
+         FROM #{quoted_table(:boards)} AS #{quoted_table(:tenant_board)}
+         INNER JOIN #{quoted_table(:filters)} AS #{quoted_table(:tenant_filter)}
+           ON #{column(:tenant_filter, :id)} = #{column(:boards_filters, :filter_id)}
+          AND #{column(:tenant_filter, :account_id)} = #{column(:tenant_board, :account_id)}
