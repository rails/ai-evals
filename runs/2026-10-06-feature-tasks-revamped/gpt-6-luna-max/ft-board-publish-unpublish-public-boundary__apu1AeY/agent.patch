+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_public_board
+  end
+
+  private
+    def set_public_board
+      key = params[:key] || params[:board_key]
+      @board = Board.publicly_published.find_by!(public_key: key)
+      Current.account = @board.account
+    end
+end
