--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board), notice: "Published" }
+      format.json { render "boards/show", location: public_board_url(@board.public_key, script_name: "") }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board), notice: "Unpublished" }
+      format.json { head :no_content }
+    end
+  end
+end
