diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..87efaf9
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins can publish and unpublish a board" do
+    board = boards(:writebook)
+
+    post publication_path(board), as: :json
+
+    assert_response :success
+    assert board.reload.public_key.present?
+    assert_equal public_board_url(board.public_key, script_name: ""), @response.parsed_body["public_url"]
+
+    public_key = board.public_key
+    delete publication_path(board), as: :json
+
+    assert_response :no_content
+    assert_nil board.reload.public_key
+
+    get board_path(board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+    get "/public/boards/#{public_key}"
+    assert_response :not_found
+  end
+
+  test "non-admins cannot publish or unpublish a board" do
+    board = boards(:writebook)
+    board.update!(public_key: "already-published")
+    logout_and_sign_in_as :david
+
+    post publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_equal "already-published", board.reload.public_key
+
+    delete publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_equal "already-published", board.reload.public_key
+  end
+
+  private
+    def publication_path(board)
+      "/#{accounts('37s').external_account_id}/boards/#{board.id}/publication"
+    end
+end
