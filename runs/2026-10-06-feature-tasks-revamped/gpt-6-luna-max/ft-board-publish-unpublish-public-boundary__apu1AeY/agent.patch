diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..63cc01f
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.update!(public_key: "secret-board-key")
+  end
+
+  test "anyone can view a published board and its published cards" do
+    draft = @board.cards.create!(
+      creator: users(:kevin),
+      column: columns(:writebook_triage),
+      title: "A private draft",
+      status: :drafted
+    )
+
+    get "/public/boards/#{@board.public_key}"
+
+    assert_response :success
+    assert_select "h1", @board.name
+    assert_select "a[href='/public/boards/#{@board.public_key}/cards/#{cards(:logo).number}']", text: cards(:logo).title
+    assert_select "a[href='/public/boards/#{@board.public_key}/columns/#{columns(:writebook_triage).id}']", text: columns(:writebook_triage).name
+    assert_select "a", text: draft.title, count: 0
+  end
+
+  test "a public column shows published cards from that column" do
+    column = columns(:writebook_in_progress)
+    draft = @board.cards.create!(creator: users(:kevin), column: column, title: "Draft in column", status: :drafted)
+
+    get "/public/boards/#{@board.public_key}/columns/#{column.id}"
+
+    assert_response :success
+    assert_select "h1", column.name
+    assert_select "a[href='/public/boards/#{@board.public_key}/cards/#{cards(:text).number}']", text: cards(:text).title
+    assert_select "a", text: cards(:logo).title, count: 0
+    assert_select "a", text: draft.title, count: 0
+  end
+
+  test "a public card can only be opened when published and on the selected board" do
+    get "/public/boards/#{@board.public_key}/cards/#{cards(:logo).number}"
+
+    assert_response :success
+    assert_select "h1", cards(:logo).title
+
+    draft = @board.cards.create!(creator: users(:kevin), title: "Draft", status: :drafted)
+    get "/public/boards/#{@board.public_key}/cards/#{draft.number}"
+    assert_response :not_found
+
+    other_board_card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Private card", status: :published)
+    end
+    get "/public/boards/#{@board.public_key}/cards/#{other_board_card.number}"
+    assert_response :not_found
+  end
+
+  test "public board, column, and card support safe JSON responses" do
+    column = columns(:writebook_in_progress)
+    card = cards(:text)
+
+    get "/public/boards/#{@board.public_key}.json"
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@board.public_key, script_name: ""), @response.parsed_body["url"]
+    assert_equal public_board_column_url(@board.public_key, column.id, script_name: ""), @response.parsed_body["columns"].find { |item| item["id"] == column.id }["url"]
+
+    get "/public/boards/#{@board.public_key}/columns/#{column.id}.json"
+
+    assert_response :success
+    assert_equal [ card.number ], @response.parsed_body["cards"].pluck("number")
+
+    get "/public/boards/#{@board.public_key}/cards/#{card.number}.json"
+
+    assert_response :success
+    assert_equal card.title, @response.parsed_body["title"]
+    assert_equal public_board_card_url(@board.public_key, card.number, script_name: ""), @response.parsed_body["url"]
+    assert_nil @response.parsed_body["creator"]
+  end
+
+  test "unpublished boards and columns from another board are not public" do
+    get "/public/boards/#{boards(:private).public_key || 'unpublished-key'}"
+    assert_response :not_found
+
+    foreign_column = boards(:private).columns.create!(name: "Private column")
+    get "/public/boards/#{@board.public_key}/columns/#{foreign_column.id}"
+    assert_response :not_found
+  end
+end
