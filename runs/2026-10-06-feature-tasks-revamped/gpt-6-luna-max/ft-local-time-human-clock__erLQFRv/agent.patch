diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..19e57d6
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,145 @@
+const millisecondsPerDay = 24 * 60 * 60 * 1000
+const relativeTimeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "always" })
+const dateFormatters = new Map()
+
+export function formatTimestamp(value, format = "date", now = new Date()) {
+  const date = parseTimestamp(value)
+
+  if (!date || Number.isNaN(date.getTime())) return ""
+
+  switch (format) {
+    case "comment":
+      return formatCommentTimestamp(date, now)
+    case "deadline":
+      return formatCalendarRelativeDate(date, now)
+    case "relative":
+      return formatRelativeTime(date, now)
+    case "time":
+      return formatDate(date, { hour: "numeric", minute: "2-digit" })
+    case "date-time":
+      return formatDate(date, {
+        month: "numeric", day: "numeric", year: "2-digit",
+        hour: "numeric", minute: "2-digit"
+      })
+    case "date-with-year":
+      return formatDate(date, { month: "short", day: "numeric", year: "numeric" })
+    case "weekday-date":
+      return formatDate(date, { weekday: "long", month: "long", day: "numeric" })
+    default:
+      return formatShortDate(date, now)
+  }
+}
+
+function parseTimestamp(value) {
+  if (value instanceof Date) return value
+  if (typeof value !== "string" || value.length === 0) return null
+
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) {
+    const date = new Date(0)
+    date.setFullYear(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+    date.setHours(0, 0, 0, 0)
+    return date
+  }
+
+  return new Date(value)
+}
+
+function formatCommentTimestamp(date, now) {
+  const daysFromNow = calendarDayDifference(now, date)
+
+  if (daysFromNow === 0) {
+    return formatTimestamp(date, "time", now)
+  } else if (daysFromNow === -1) {
+    return "yesterday"
+  } else if (daysFromNow < -1 && daysFromNow >= -6) {
+    return `${Math.abs(daysFromNow)} days ago`
+  } else if (daysFromNow > 0) {
+    return formatCalendarRelativeDate(date, now)
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+function formatCalendarRelativeDate(date, now) {
+  const daysFromNow = calendarDayDifference(now, date)
+
+  if (daysFromNow === 0) {
+    return "today"
+  } else if (daysFromNow === 1) {
+    return "tomorrow"
+  } else if (daysFromNow === -1) {
+    return "yesterday"
+  } else if (daysFromNow > 1) {
+    return `in ${daysFromNow} days`
+  } else {
+    return `${Math.abs(daysFromNow)} days ago`
+  }
+}
+
+function formatRelativeTime(date, now) {
+  const differenceInSeconds = (date.getTime() - now.getTime()) / 1000
+  const absoluteDifferenceInSeconds = Math.abs(differenceInSeconds)
+  const direction = differenceInSeconds <= 0 ? -1 : 1
+
+  if (absoluteDifferenceInSeconds < 45) {
+    return direction < 0 ? "less than a minute ago" : "in less than a minute"
+  }
+
+  let unit, unitInSeconds
+  if (absoluteDifferenceInSeconds < 60 * 60) {
+    unit = "minute"
+    unitInSeconds = 60
+  } else if (absoluteDifferenceInSeconds < 24 * 60 * 60) {
+    unit = "hour"
+    unitInSeconds = 60 * 60
+  } else if (absoluteDifferenceInSeconds < 7 * millisecondsPerDay / 1000) {
+    unit = "day"
+    unitInSeconds = millisecondsPerDay / 1000
+  } else if (absoluteDifferenceInSeconds < 28 * millisecondsPerDay / 1000) {
+    unit = "week"
+    unitInSeconds = 7 * millisecondsPerDay / 1000
+  } else if (absoluteDifferenceInSeconds < 365 * millisecondsPerDay / 1000) {
+    unit = "month"
+    unitInSeconds = 30 * millisecondsPerDay / 1000
+  } else {
+    unit = "year"
+    unitInSeconds = 365 * millisecondsPerDay / 1000
+  }
+
+  const amount = Math.max(1, Math.round(absoluteDifferenceInSeconds / unitInSeconds)) * direction
+  return relativeTimeFormatter.format(amount, unit)
+}
+
+function formatShortDate(date, now) {
+  const options = { month: "short", day: "numeric" }
+
+  if (date.getFullYear() !== now.getFullYear()) {
+    options.year = "numeric"
+  }
+
+  return formatDate(date, options)
+}
+
+function formatDate(date, options) {
+  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const key = `${timeZone}:${JSON.stringify(options)}`
+  let formatter = dateFormatters.get(key)
+
+  if (!formatter) {
+    formatter = new Intl.DateTimeFormat("en-US", { ...options, timeZone })
+    dateFormatters.set(key, formatter)
+  }
+
+  return formatter.format(date)
+}
+
+function calendarDayDifference(fromDate, toDate) {
+  return localDayNumber(toDate) - localDayNumber(fromDate)
+}
+
+function localDayNumber(date) {
+  const utcDate = new Date(0)
+  utcDate.setUTCFullYear(date.getFullYear(), date.getMonth(), date.getDate())
+  return utcDate.getTime() / millisecondsPerDay
+}
