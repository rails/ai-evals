diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..e0a00bb
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag contains a UTC timestamp and formatting mode" do
+    timestamp = Time.utc(2025, 9, 12, 20, 42)
+
+    html = local_time_tag(timestamp, format: "comment", class: "comment-time")
+    time = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "2025-09-12T20:42:00Z", time["datetime"]
+    assert_equal "local-time", time["data-controller"]
+    assert_equal "comment", time["data-local-time-format-value"]
+    assert_equal "comment-time", time["class"]
+    assert_equal "2025-09-12T20:42:00Z", time.text
+  end
+
+  test "local_time_tag serializes zoned timestamps as UTC" do
+    html = Time.use_zone("America/Los_Angeles") do
+      local_time_tag(Time.zone.parse("2025-09-12 13:42:00"), format: "time")
+    end
+    time = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "2025-09-12T20:42:00Z", time["datetime"]
+  end
+
+  test "local_time_tag preserves date-only values without a timezone" do
+    html = local_time_tag(Date.new(2025, 9, 12), format: "weekday-date")
+    time = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "2025-09-12", time["datetime"]
+    assert_equal "2025-09-12", time.text
+    assert_equal "weekday-date", time["data-local-time-format-value"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..a70ef62
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,73 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats timestamps using the browser's local timezone and calendar" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    execute_script <<~JS
+      const addTime = (id, date, format) => {
+        const element = document.createElement("time")
+        element.id = id
+        element.dateTime = date.toISOString()
+        element.dataset.controller = "local-time"
+        element.dataset.localTimeFormatValue = format
+        document.body.append(element)
+        return element
+      }
+
+      const addDate = (id, date, format) => {
+        const element = document.createElement("time")
+        element.id = id
+        element.dateTime = date
+        element.dataset.controller = "local-time"
+        element.dataset.localTimeFormatValue = format
+        document.body.append(element)
+        return element
+      }
+
+      const now = new Date()
+      const todayAt1342 = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 13, 42)
+      addTime("comment-today", todayAt1342, "comment")
+
+      const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 23, 42)
+      addTime("comment-yesterday", yesterday, "comment")
+
+      const fiveDaysAgo = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 5, 12, 0)
+      addTime("comment-five-days-ago", fiveDaysAgo, "comment")
+
+      const oldComment = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 8, 12, 0)
+      const oldCommentElement = addTime("comment-old", oldComment, "comment")
+      const dateOptions = { month: "short", day: "numeric" }
+      if (oldComment.getFullYear() !== now.getFullYear()) dateOptions.year = "numeric"
+      oldCommentElement.dataset.expected = new Intl.DateTimeFormat("en-US", dateOptions).format(oldComment)
+
+      const localDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 2)
+      const dateOnly = `${localDate.getFullYear()}-${String(localDate.getMonth() + 1).padStart(2, "0")}-${String(localDate.getDate()).padStart(2, "0")}`
+      const dateOnlyElement = addDate("date-only", dateOnly, "weekday-date")
+      dateOnlyElement.dataset.expected = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(localDate)
+
+      const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000)
+      addTime("relative-two-hours", twoHoursAgo, "relative")
+
+      const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 2, 0)
+      addTime("deadline-tomorrow", tomorrow, "deadline")
+
+      const threeDaysFromNow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 3, 2, 0)
+      addTime("deadline-three-days", threeDaysFromNow, "deadline")
+    JS
+
+    assert_selector "#comment-today", text: "1:42 PM"
+    assert_selector "#comment-yesterday", text: "yesterday"
+    assert_selector "#comment-five-days-ago", text: "5 days ago"
+    assert_selector "#relative-two-hours", text: "2 hours ago"
+    assert_selector "#deadline-tomorrow", text: "tomorrow"
+    assert_selector "#deadline-three-days", text: "in 3 days"
+
+    expected_old_date = page.evaluate_script("document.querySelector('#comment-old').dataset.expected")
+    assert_selector "#comment-old", text: expected_old_date
+
+    expected_date_only = page.evaluate_script("document.querySelector('#date-only').dataset.expected")
+    assert_selector "#date-only", text: expected_date_only
+  end
+end
