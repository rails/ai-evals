new file mode 100644
index 0000000..98eec6e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_helpers"
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    const timestamp = this.element.dateTime
+    this.element.textContent = formatTimestamp(timestamp, this.formatValue)
+    this.#positionEventTimeBlock(timestamp)
+  }
+
+  #positionEventTimeBlock(timestamp) {
+    if (this.formatValue === "time") {
+      const timeBlock = this.element.closest(".events__time-block")
+      if (timeBlock) {
+        timeBlock.style.gridRowStart = 25 - new Date(timestamp).getHours()
+      }
+    }
+  }
+}
