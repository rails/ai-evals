+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,15 @@
 module TimeHelper
+  def local_time_tag(value, format:, **attributes)
+    datetime = if value.respond_to?(:utc)
+      value.utc.iso8601
+    else
+      value.iso8601
+    end
+
+    data = attributes.delete(:data) || {}
+    data[:controller] = [ data[:controller], "local-time" ].compact.join(" ")
+    data[:local_time_format_value] = format.to_s
+
+    tag.time datetime, datetime: datetime, data: data, **attributes
+  end
 end
