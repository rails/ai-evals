diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..5dd7ad8 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,6 +1,9 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  # Stay below SQLite's default bind-variable limit for the ID lookup.
+  AUTO_POSTPONE_BATCH_SIZE = 500
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -25,8 +28,37 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.now
+
+      Account.includes(:entropy).find_each do |account|
+        account_entropy_period = account.entropy&.auto_postpone_period
+        board_cutoffs = account.boards.left_outer_joins(:entropy)
+          .pluck(:id, "entropies.auto_postpone_period")
+          .to_h do |board_id, board_period|
+            period = board_period || account_entropy_period
+            [ board_id, period && now - period ]
+          end
+        candidate_cutoff = board_cutoffs.values.compact.max
+
+        if candidate_cutoff
+          candidate_ids = Card.active
+            .where(account_id: account.id, last_active_at: ..candidate_cutoff)
+            .pluck(:id)
+
+          system_user = nil
+          candidate_ids.each_slice(AUTO_POSTPONE_BATCH_SIZE) do |ids|
+            Card.active.where(id: ids)
+              .preload(:account, :activity_spike, :closure, :not_now, board: :account)
+              .each do |card|
+                cutoff = board_cutoffs[card.board_id]
+
+                if cutoff && card.last_active_at <= cutoff
+                  system_user ||= account.system_user
+                  card.auto_postpone(user: system_user)
+                end
+              end
+          end
+        end
       end
     end
   end
