diff --git a/lib/japanese_copy.rb b/lib/japanese_copy.rb
new file mode 100644
index 0000000..51b3674
--- /dev/null
+++ b/lib/japanese_copy.rb
@@ -0,0 +1,95 @@
+require "nokogiri"
+
+module JapaneseCopy
+  module_function
+
+  def translate_html(html)
+    document = if html.lstrip.start_with?("<!DOCTYPE", "<html")
+      Nokogiri::HTML(html)
+    else
+      Nokogiri::HTML.fragment(html)
+    end
+    translations = copy
+
+    document.traverse do |node|
+      if node.text?
+        unless node.ancestors.any? { |ancestor| ancestor.name.in?([ "script", "style", "code", "pre" ]) } || user_content?(node)
+          node.content = translate_fragment(node.content, translations)
+        end
+      elsif node.element? && !user_content?(node)
+        node.attribute_nodes.each do |attribute|
+          attribute.value = translate_fragment(attribute.value, translations)
+        end
+      end
+    end
+
+    document.to_html
+  end
+
+  def translate_text(text)
+    translations = copy
+    text.lines.map do |line|
+      ending = line.end_with?("\n") ? "\n" : ""
+      content = ending.empty? ? line : line[0...-1]
+      translate_fragment(content, translations) + ending
+    end.join
+  end
+
+  def translate_mail(message)
+    if message.subject.present?
+      if match = message.subject.match(/\AFizzy \((.+)\): New notifications\z/)
+        message.subject = "Fizzy（#{match[1]}）：新しい通知"
+      else
+        message.subject = translate_text(message.subject)
+      end
+    end
+
+    if message.multipart?
+      message.parts.each { |part| translate_mail(part) }
+    elsif message.content_type&.start_with?("text/html")
+      message.body = translate_html(message.body.decoded)
+    elsif message.content_type&.start_with?("text/plain")
+      message.body = translate_text(message.body.decoded)
+    end
+
+    message
+  end
+
+  def user_content?(node)
+    nodes = node.element? ? node.ancestors.to_a + [ node ] : node.ancestors
+    nodes.any? do |ancestor|
+      (ancestor["class"].to_s.split & %w[ card__title card__title-link card__description card__content card__board-name comment__body lexxy-content trix-content step__content notification__board search__title ]).any?
+    end
+  end
+
+  def copy
+    @copy ||= I18n.t("japanese_copy", locale: :ja, default: {}).transform_keys(&:to_s)
+  end
+
+  def translate_fragment(value, translations)
+    return value if value.blank?
+
+    whitespace_prefix = value[/\A\s*/]
+    whitespace_suffix = value[/\s*\z/]
+    content = value[whitespace_prefix.length, value.length - whitespace_prefix.length - whitespace_suffix.length]
+
+    translated = if translated = translations[content]
+      "#{whitespace_prefix}#{translated}#{whitespace_suffix}"
+    else
+      translate_embedded_phrases(value, translations)
+    end
+
+    translated.gsub(/\.(?=\s|\z)/, "。")
+  end
+
+  def translate_embedded_phrases(value, translations)
+    translations.keys.sort_by { |phrase| -phrase.length }.each do |phrase|
+      next if phrase.length < 8 || phrase.match?(/\A[^[:alpha:]]+\z/)
+      next unless value.include?(phrase)
+
+      value = value.gsub(phrase, translations.fetch(phrase))
+    end
+
+    value
+  end
+end
