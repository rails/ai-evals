diff --git a/app/controllers/concerns/locale_selection.rb b/app/controllers/concerns/locale_selection.rb
new file mode 100644
index 0000000..2dfa0e0
--- /dev/null
+++ b/app/controllers/concerns/locale_selection.rb
@@ -0,0 +1,94 @@
+module LocaleSelection
+  extend ActiveSupport::Concern
+
+  AVAILABLE_LOCALES = %w[en ja].freeze
+
+  included do
+    prepend_around_action :with_selected_locale
+    before_action :apply_identity_locale
+  end
+
+  private
+    def with_selected_locale
+      @requested_locale = supported_locale(params[:locale])
+
+      if @requested_locale
+        session[:locale] = @requested_locale
+        session[:locale_identity_id] = nil
+      end
+
+      locale = @requested_locale || supported_locale(session[:locale]) || I18n.default_locale
+
+      I18n.with_locale(locale) do
+        yield
+        translate_response
+      end
+    end
+
+    def apply_identity_locale
+      if identity = Current.identity
+        locale = if @requested_locale
+          @requested_locale
+        elsif session_locale_belongs_to?(identity)
+          supported_locale(session[:locale])
+        else
+          supported_locale(identity.locale)
+        end
+
+        if locale
+          I18n.locale = locale
+          session[:locale] = locale
+          session[:locale_identity_id] = identity.id
+          identity.update!(locale: locale) if identity.locale != locale
+        elsif session[:locale_identity_id].present? && session[:locale_identity_id] != identity.id
+          session.delete(:locale)
+          session.delete(:locale_identity_id)
+          I18n.locale = I18n.default_locale
+        end
+      end
+    end
+
+    def remember_locale_for(identity)
+      locale = if @requested_locale || session[:locale_identity_id].blank? || session[:locale_identity_id] == identity.id
+        supported_locale(session[:locale])
+      else
+        nil
+      end
+      locale ||= supported_locale(identity.locale)
+
+      if locale
+        I18n.locale = locale
+        identity.update!(locale: locale) if identity.locale != locale
+        session[:locale] = locale
+        session[:locale_identity_id] = identity.id
+      elsif session[:locale_identity_id].present? && session[:locale_identity_id] != identity.id
+        session.delete(:locale)
+        session.delete(:locale_identity_id)
+        I18n.locale = I18n.default_locale
+      end
+
+      locale
+    end
+
+    def selected_locale_for_new_identity
+      if @requested_locale || session[:locale_identity_id].blank?
+        supported_locale(session[:locale])
+      end
+    end
+
+    def supported_locale(value)
+      if value.is_a?(String) && AVAILABLE_LOCALES.include?(value)
+        value
+      end
+    end
+
+    def session_locale_belongs_to?(identity)
+      session[:locale_identity_id].blank? || session[:locale_identity_id] == identity.id
+    end
+
+    def translate_response
+      if I18n.locale.to_s == "ja" && response.media_type.in?([ "text/html", "text/vnd.turbo-stream.html" ])
+        response.body = JapaneseCopy.translate_html(response.body)
+      end
+    end
+end
