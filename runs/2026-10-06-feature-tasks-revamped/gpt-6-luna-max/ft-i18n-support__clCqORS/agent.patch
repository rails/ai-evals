diff --git a/test/controllers/locales_controller_test.rb b/test/controllers/locales_controller_test.rb
new file mode 100644
index 0000000..06267f4
--- /dev/null
+++ b/test/controllers/locales_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class LocalesControllerTest < ActionDispatch::IntegrationTest
+  test "locale query switches the page and persists for the browser session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", "Fizzyにログイン"
+
+      get new_session_path
+
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_select "h1", "Fizzyにログイン"
+    end
+  end
+
+  test "unsupported locales do not switch the current locale" do
+    untenanted do
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang='en']"
+
+      get new_session_path(locale: "ja")
+      get new_session_path(locale: "xx")
+
+      assert_response :success
+      assert_select "html[lang='ja']"
+    end
+  end
+
+  test "locale choice is saved to the identity for a clean browser" do
+    sign_in_as :kevin
+
+    get board_path(boards(:writebook), locale: "ja")
+
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get board_path(boards(:writebook))
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+
+    clean_browser = open_session
+    clean_browser.host! "www.example.com"
+    clean_browser.post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address }
+    magic_link = identities(:kevin).magic_links.order(created_at: :desc).first
+    clean_browser.post session_magic_link_path(script_name: nil), params: { code: magic_link.code }
+    clean_browser.get "/#{accounts("37s").external_account_id}/boards/#{boards(:writebook).to_param}"
+
+    assert_match(/<html lang="ja">/, clean_browser.response.body)
+  end
+
+  test "locale selection before sign in is saved and used for the magic link email" do
+    identity = identities(:jz)
+    identity.update!(locale: nil)
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      perform_enqueued_jobs do
+        get new_session_path(locale: "ja")
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_equal "ja", identity.reload.locale
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.subject, "認証コード"
+    email_body = [ email.html_part, email.text_part ].compact.map { |part| part.body.decoded }.join(" ")
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, email_body)
+  end
+
+  test "choosing English switches back from Japanese" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path(locale: "en")
+    end
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "h1", "Get into Fizzy"
+  end
+
+  test "the PWA manifest uses the selected locale" do
+    untenanted do
+      get pwa_manifest_path(locale: "ja")
+    end
+
+    assert_response :success
+    assert_includes response.parsed_body.fetch("description"), "カード"
+    assert_includes response.parsed_body.fetch("shortcuts").first.fetch("name"), "通知"
+  end
+
+
+test "Japanese UI does not rewrite user-authored card titles" do
+  sign_in_as :kevin
+  card = cards(:logo)
+  card.update_column(:title, "Done")
+
+  get card_path(card, locale: "ja")
+
+  assert_response :success
+  assert_select ".card__title", text: "Done"
+end
+
+  test "pages without a locale choice remain in English" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "h1", "Get into Fizzy"
+  end
+
+  test "static error pages contain both English and Japanese" do
+    %w[400.html 404.html 406-unsupported-browser.html 422.html 500.html].each do |filename|
+      page = Rails.root.join("public", filename).read
+
+      assert_includes page, "lang=\"en\"", filename
+      assert_includes page, "lang=\"ja\"", filename
+      assert_match(/[ぁ-ゟァ-ヿ一-龯]/, page, filename)
+    end
+  end
+end
diff --git a/test/helpers/date_localization_test.rb b/test/helpers/date_localization_test.rb
new file mode 100644
index 0000000..b516cc0
--- /dev/null
+++ b/test/helpers/date_localization_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class DateLocalizationTest < ActiveSupport::TestCase
+  include ActionView::Helpers::DateHelper
+
+  test "Japanese dates and relative durations are localized" do
+    date = Date.new(2025, 6, 4)
+
+    I18n.with_locale(:ja) do
+      assert_equal "2025年6月4日", I18n.l(date, format: :card_stamp)
+      assert_equal "15分", distance_of_time_in_words(15.minutes)
+    end
+  end
+
+  test "English date output remains unchanged" do
+    I18n.with_locale(:en) do
+      assert_equal "Jun 04, 2025", I18n.l(Date.new(2025, 6, 4), format: :card_stamp)
+      assert_equal "15 minutes", distance_of_time_in_words(15.minutes)
+    end
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..e04d95f
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class LocalizationMailerTest < ActionMailer::TestCase
+  test "magic link emails use the recipient's saved locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    html_body = email.html_part.body.decoded
+    text_body = email.text_part.body.decoded
+
+    assert_includes email.subject, "認証コード"
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, html_body)
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, text_body)
+    assert_includes html_body, 'lang="ja"'
+    assert_includes html_body, magic_link.code
+    assert_includes text_body, "15分。"
+    assert_includes text_body, "追伸："
+    refute_match(/This code will work|P\.S\./, text_body)
+  end
+
+  test "transactional emails use the recipient's saved locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    user = users(:kevin)
+    account = accounts(:"37s")
+
+    cancellation = Account::Cancellation.create!(account: account, initiated_by: user)
+    export = Account::Export.create!(account: account, user: user)
+    import = Account::Import.create!(account: account, identity: identity, status: :failed)
+
+    emails = [
+      AccountMailer.cancellation(cancellation),
+      ExportMailer.completed(export),
+      ImportMailer.completed(identity, account),
+      ImportMailer.failed(import),
+      UserMailer.email_change_confirmation(email_address: identity.email_address, token: "token", user: user)
+    ]
+
+    emails.each do |email|
+      body_parts = email.multipart? ? email.parts : [ email ]
+      body = body_parts.map { |part| part.body.decoded }.join(" ")
+      assert_match(/[ぁ-ゟァ-ヿ一-龯]/, body, "Expected Japanese copy in #{email.subject}")
+
+      html_body = if email.html_part
+        email.html_part.body.decoded
+      elsif email.content_type.start_with?("text/html")
+        email.body.decoded
+      end
+      assert_includes html_body, 'lang="ja"' if html_body
+    end
+
+    assert_includes emails[2].text_part.body.decoded, "インポートが完了しました"
+    assert_includes emails[0].text_part.body.decoded, "をキャンセルしました"
+  end
+
+  test "notification bundle emails use the recipient's saved locale" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    user.notifications.destroy_all
+
+    bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, email.subject)
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, email.html_part.body.decoded)
+    assert_match(/[ぁ-ゟァ-ヿ一-龯]/, email.text_part.body.decoded)
+    assert_includes email.subject, "新しい通知"
+    assert_includes email.text_part.body.decoded, "すべての通知メールを停止"
+    assert_includes email.html_part.body.decoded, 'lang="ja"'
+  end
+end
