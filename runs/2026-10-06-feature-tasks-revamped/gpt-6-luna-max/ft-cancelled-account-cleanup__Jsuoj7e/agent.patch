diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f1d3872
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled more than 30 days ago and preserves the rest" do
+    freeze_time do
+      due_account, due_user, due_cancellation = create_cancelled_account("Due", canceled_at: 31.days.ago)
+      boundary_account, _, boundary_cancellation = create_cancelled_account("Boundary", canceled_at: 30.days.ago)
+      recent_account, _, recent_cancellation = create_cancelled_account("Recent", canceled_at: 29.days.ago)
+      active_account = Account.create!(name: "Active")
+
+      board = due_account.boards.create!(name: "Due board", creator: due_user)
+      card = due_account.cards.create!(board: board, creator: due_user, title: "Due card")
+      storage_entry = Storage::Entry.create!(account: due_account, delta: 1, operation: "test")
+
+      Account::IncinerateDueJob.perform_now
+
+      assert_not Account.exists?(due_account.id)
+      assert_not User.exists?(due_user.id)
+      assert_not Board.exists?(board.id)
+      assert_not Card.exists?(card.id)
+      assert_not Account::Cancellation.exists?(due_cancellation.id)
+      assert_not Storage::Entry.exists?(storage_entry.id)
+
+      [ [ boundary_account, boundary_cancellation ], [ recent_account, recent_cancellation ] ].each do |account, cancellation|
+        assert Account.exists?(account.id)
+        assert Account::Cancellation.exists?(cancellation.id)
+      end
+      assert Account.exists?(active_account.id)
+    end
+  end
+
+  test "does not incinerate an account reactivated after selection" do
+    freeze_time do
+      account, = create_cancelled_account("Reactivated", canceled_at: 31.days.ago)
+      selected_account = Account.due_for_incineration.find(account.id)
+
+      account.reactivate
+      selected_account.incinerate_if_due
+
+      assert Account.exists?(account.id)
+      assert_nil account.reload.cancellation
+    end
+  end
+
+  private
+    def create_cancelled_account(name, canceled_at:)
+      account = Account.create!(name: name)
+      user = account.users.create!(name: "#{name} owner", role: :owner)
+      cancellation = account.create_cancellation!(initiated_by: user, created_at: canceled_at)
+
+      [ account, user, cancellation ]
+    end
+end
