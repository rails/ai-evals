--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -10,4 +10,21 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+  scope :publicly_available, -> { where.not(public_key: nil) }
+
+  def published?
+    public_key.present?
+  end
+
+  def publish
+    with_lock do
+      update!(public_key: SecureRandom.base58(24)) unless published?
+    end
+  end
+
+  def unpublish
+    with_lock do
+      update!(public_key: nil) if published?
+    end
+  end
 end
