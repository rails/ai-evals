index 0000000..85954b3
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  test "show is available without authentication and only lists published cards" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    draft = board.cards.create!(creator: users(:david), title: "Private draft", status: :drafted)
+
+    get public_board_path(board.public_key, script_name: "")
+
+    assert_response :success
+    assert_select "h1", text: board.name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: draft.title, count: 0
+  end
+
+  test "show as JSON includes the public URL" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+
+    get public_board_path(board.public_key, format: :json, script_name: ""), as: :json
+
+    assert_response :success
+    assert_equal public_board_url(board.public_key, script_name: ""), @response.parsed_body["public_url"]
+    assert_equal public_board_url(board.public_key, script_name: ""), @response.parsed_body["url"]
+  end
+
+  test "unpublished boards cannot be accessed" do
+    get public_board_path("not-a-real-key", script_name: "")
+
+    assert_response :not_found
+  end
+
+  test "a published card can be opened directly but a draft cannot" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    draft = board.cards.create!(creator: users(:david), title: "Private draft", status: :drafted)
+
+    get public_board_card_path(board.public_key, cards(:logo).number, format: :json, script_name: ""), as: :json
+    assert_response :success
+    assert_equal cards(:logo).number, @response.parsed_body["number"]
+    assert_equal public_board_card_url(board.public_key, cards(:logo).number, script_name: ""), @response.parsed_body["url"]
+
+    get public_board_card_path(board.public_key, draft.number, format: :json, script_name: ""), as: :json
+    assert_response :not_found
+  end
+
+  test "a board column can be opened directly" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    column = columns(:writebook_in_progress)
+
+    get public_board_column_path(board.public_key, column, script_name: "")
+
+    assert_response :success
+    assert_select "h1", text: "Column: #{column.name}"
+    assert_select "a", text: cards(:text).title
+  end
+
+  test "a board column can be opened as JSON" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    column = columns(:writebook_in_progress)
+
+    get public_board_column_path(board.public_key, column, format: :json, script_name: ""), as: :json
+
+    assert_response :success
+    assert_equal column.id, @response.parsed_body["id"]
+    assert_equal public_board_column_url(board.public_key, column, script_name: ""), @response.parsed_body["url"]
+  end
+
+  test "public column only lists published cards" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    column = columns(:writebook_in_progress)
+    draft = board.cards.create!(creator: users(:david), column: column, title: "Private draft", status: :drafted)
+
+    get public_board_column_path(board.public_key, column, script_name: "")
+
+    assert_response :success
+    assert_select "a", text: cards(:text).title
+    assert_select "a", text: draft.title, count: 0
+  end
+
+  test "a published card can be opened as HTML" do
+    board = boards(:writebook)
+    board.update!(public_key: "secret-board-key")
+    card = cards(:logo)
+
+    get public_board_card_path(board.public_key, card.number, script_name: "")
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+end
