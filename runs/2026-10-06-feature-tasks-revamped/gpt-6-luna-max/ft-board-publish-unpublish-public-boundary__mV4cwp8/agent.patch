diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..c171128
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create publishes a board" do
+    board = boards(:writebook)
+
+    assert_changes -> { board.reload.public_key }, from: nil do
+      post board_publication_path(board), as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "publishing an already public board preserves its key" do
+    board = boards(:writebook)
+    board.update!(public_key: "existing-secret")
+
+    assert_no_changes -> { board.reload.public_key } do
+      post board_publication_path(board), as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "destroy unpublishes a board" do
+    board = boards(:writebook)
+    board.update!(public_key: "existing-secret")
+
+    assert_changes -> { board.reload.public_key }, from: "existing-secret", to: nil do
+      delete board_publication_path(board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "admin can publish a board they don't otherwise access" do
+    board = boards(:private)
+    board.accesses.delete_all
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.published?
+  end
+
+  test "board creator who is not an admin cannot publish" do
+    logout_and_sign_in_as :david
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_nil board.reload.public_key
+  end
+
+  test "non-admin cannot unpublish a board" do
+    board = boards(:writebook)
+    board.update!(public_key: "existing-secret")
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :forbidden
+    assert_equal "existing-secret", board.reload.public_key
+  end
+
+  test "unpublishing revokes the public URL" do
+    board = boards(:writebook)
+    board.update!(public_key: "existing-secret")
+
+    delete board_publication_path(board), as: :json
+    assert_response :no_content
+
+    get public_board_path("existing-secret", script_name: "")
+    assert_response :not_found
+  end
+end
