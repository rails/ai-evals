index 4ecfeb8..df97976 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,7 @@
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  REQUEST_TIMEOUT = 10
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +13,22 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      where("created_at < ?", 1.week.ago).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    deliver_request if claim
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +46,88 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    code = response&.dig(:code)
+    completed? && response&.dig(:error).blank? && code.present? && code.to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      # Commit before HTTP I/O so duplicate jobs cannot send another POST.
+      with_lock do
+        if pending?
+          if webhook.reload.active?
+            update! state: :in_progress
+            true
+          else
+            update! state: :errored, response: { error: "webhook_inactive" }
+            false
+          end
+        else
+          false
+        end
+      end
+    end
+
+    def deliver_request
+      begin
+        body = event_payload
+        uri = URI.parse(webhook.url)
+        timestamp = event.created_at.utc.iso8601
+        headers = {
+          "User-Agent" => USER_AGENT,
+          "Content-Type" => "application/json",
+          "X-Webhook-Timestamp" => timestamp,
+          "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+        }
+        request = Net::HTTP::Post.new(uri.request_uri, headers)
+        request.body = body
+
+        update! request: { headers: headers }
+      rescue StandardError
+        update! state: :errored, response: { error: "request_failed" }
+        return
+      end
+
+      begin
+        http_response = http_request(uri, request)
+      rescue StandardError
+        update! state: :errored, response: { error: "destination_unreachable" }
+        webhook.ensure_delinquency_tracker.record_failure
+        return
+      end
+
+      record_response(http_response)
+    end
+
+    def event_payload
+      defaults = Rails.application.routes.default_url_options
+      renderer = ApplicationController.renderer.with_defaults(
+        http_host: defaults[:host] || Rails.application.config.action_mailer.default_url_options[:host],
+        https: defaults[:protocol] == "https",
+        script_name: account.slug
+      )
+      renderer.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event }, layout: false)
+    end
+
+    def http_request(uri, request)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+      http.write_timeout = REQUEST_TIMEOUT if http.respond_to?(:write_timeout=)
+      http.start { |client| client.request(request) }
+    end
+
+    def record_response(http_response)
+      update!(
+        state: :completed,
+        response: { code: http_response.code.to_i, headers: http_response.to_hash }
+      )
+
+      if succeeded?
+        webhook.ensure_delinquency_tracker.record_success
+      else
+        webhook.ensure_delinquency_tracker.record_failure
+      end
+    end
 end
