+require "test_helper"
+
+class WebhookDeliveryFailureTest < ActiveSupport::TestCase
+  test "a payload generation failure is logged without counting against the receiver" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    tracker = webhook.ensure_delinquency_tracker
+    request = stub_request(:post, webhook.url)
+    delivery.stubs(:event_payload).raises("could not build payload")
+
+    delivery.deliver_now
+
+    assert_not_requested request
+    assert_equal "errored", delivery.reload.state
+    assert_equal "request_failed", delivery.response[:error]
+    assert_equal 0, tracker.reload.consecutive_failures_count
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..baeb39e 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -21,7 +21,7 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert delivery.succeeded?
 
     delivery.response[:code] = 422
-    assert_not delivery.succeeded?, "resonse must have a 2XX status"
+    assert_not delivery.succeeded?, "response must have a 2XX status"
 
     delivery.response[:code] = 200
     delivery.state = :pending
@@ -77,4 +77,98 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "posts the event once and logs the request and response" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    event = delivery.event
+    request = stub_request(:post, webhook.url).to_return(status: 201, body: "created")
+
+    delivery.deliver_now
+
+    assert_requested :post, webhook.url, times: 1 do |sent_request|
+      assert_equal "application/json", sent_request.headers["Content-Type"]
+      assert_equal "fizzy/1.0.0 Webhook", sent_request.headers["User-Agent"]
+      assert_equal event.created_at.utc.iso8601, sent_request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, sent_request.body), sent_request.headers["X-Webhook-Signature"]
+      assert_equal event.id, JSON.parse(sent_request.body).fetch("id")
+    end
+
+    delivery.reload
+    assert_equal "completed", delivery.state
+    assert_equal 201, delivery.response[:code]
+    assert delivery.succeeded?
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    delivery.deliver_now
+    assert_requested request, times: 1
+  end
+
+  test "a failed response advances the failure streak and a successful response clears it" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    tracker = webhook.ensure_delinquency_tracker
+
+    stub_request(:post, webhook.url).to_return(status: 503)
+    delivery.deliver_now
+
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert_not delivery.reload.succeeded?
+
+    next_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented))
+    stub_request(:post, webhook.url).to_return(status: 204)
+    next_delivery.deliver_now
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "network failures are logged and are not retried by duplicate jobs" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    tracker = webhook.ensure_delinquency_tracker
+    request = stub_request(:post, webhook.url).to_raise(Net::OpenTimeout)
+
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert_equal "errored", delivery.reload.state
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_equal 1, tracker.reload.consecutive_failures_count
+
+    delivery.deliver_now
+    assert_requested request, times: 1
+  end
+
+  test "pending deliveries for deactivated webhooks are not sent" do
+    delivery = webhook_deliveries(:pending)
+    webhook = delivery.webhook
+    webhook.deactivate
+    request = stub_request(:post, webhook.url)
+
+    delivery.deliver_now
+
+    assert_not_requested request
+    assert_equal "errored", delivery.reload.state
+    assert_equal "webhook_inactive", delivery.response[:error]
+  end
+
+  test "deliver_later enqueues a job on the webhook queue" do
+    delivery = webhook_deliveries(:pending)
+
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ], queue: "webhooks" do
+      delivery.deliver_later
+    end
+  end
+
+  test "cleanup removes deliveries older than one week only" do
+    webhook = webhooks(:active)
+    old_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:layout_commented), created_at: 8.days.ago)
+    recent_delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:logo_assignment_david), created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
 end
