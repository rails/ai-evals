+require "test_helper"
+
+class EventWebhookTest < ActiveSupport::TestCase
+  test "creates one delivery for each active webhook subscribed to the event" do
+    board = boards(:writebook)
+    webhook = webhooks(:active)
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      @event = Event.create!(
+        account: board.account,
+        board: board,
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_closed"
+      )
+    end
+
+    delivery = @event.webhook_deliveries.sole
+    assert_equal webhook, delivery.webhook
+    assert_equal "pending", delivery.state
+
+    assert_no_difference "Webhook::Delivery.count" do
+      @event.create_webhook_deliveries
+    end
+  end
+
+  test "does not create deliveries for unsubscribed events" do
+    board = boards(:writebook)
+
+    assert_no_difference "Webhook::Delivery.count" do
+      Event.create!(
+        account: board.account,
+        board: board,
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_reopened"
+      )
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..e953c0b
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "deactivates after ten consecutive failures within an hour" do
+    webhook = create_webhook
+    tracker = webhook.delinquency_tracker
+
+    9.times { tracker.record_failure }
+    assert webhook.reload.active?
+    assert_equal 9, tracker.reload.consecutive_failures_count
+
+    tracker.record_failure
+
+    assert_not webhook.reload.active?
+    assert_equal 10, tracker.reload.consecutive_failures_count
+  end
+
+  test "a success resets the consecutive failure count" do
+    tracker = create_webhook.delinquency_tracker
+    9.times { tracker.record_failure }
+
+    tracker.record_success
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "failures more than an hour apart start a new streak" do
+    webhook = create_webhook
+    tracker = webhook.delinquency_tracker
+    start_time = Time.current
+
+    9.times { tracker.record_failure(at: start_time) }
+    tracker.record_failure(at: start_time + 1.hour + 1.second)
+
+    assert webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+    assert_in_delta (start_time + 1.hour + 1.second).to_f, tracker.first_failure_at.to_f, 0.000001
+  end
+
+  test "reactivating a disabled webhook clears its failure streak" do
+    webhook = create_webhook
+    tracker = webhook.delinquency_tracker
+    10.times { tracker.record_failure }
+
+    assert_not webhook.reload.active?
+
+    webhook.reload.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  private
+    def create_webhook
+      Webhook.create!(
+        board: boards(:writebook),
+        name: "Failure test",
+        url: "https://example.com/failure-test",
+        subscribed_actions: [ "card_closed" ]
+      )
+    end
+end
