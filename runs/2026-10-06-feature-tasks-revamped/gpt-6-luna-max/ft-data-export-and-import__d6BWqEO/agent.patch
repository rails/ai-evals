+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account Settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<article class="panel panel--wide shadow center flex flex-column gap" style="--panel-size: 50ch;">
+  <header>
+    <h2 class="txt-large margin-none font-weight-black">Bring your Fizzy data with you</h2>
+    <p class="txt-medium margin-none">Choose a Fizzy account export ZIP. We'll create a new account with its boards, cards, comments, files, and people.</p>
+  </header>
+
+  <%= form_with model: @import, url: account_imports_path, multipart: true, class: "flex flex-column gap" do |form| %>
+    <label class="flex flex-column gap-half txt-small">
+      <span>Account export (.zip)</span>
+      <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+    </label>
+
+    <% if @import.errors.any? %>
+      <div class="txt-negative txt-small">
+        <% @import.errors.full_messages.each do |message| %>
+          <p class="margin-block-none"><%= message %></p>
+        <% end %>
+      </div>
+    <% end %>
+
+    <p class="margin-none txt-small txt-subtle">The import runs in the background. We'll email you when the new account is ready, or explain why the import failed.</p>
+
+    <%= form.button type: :submit, class: "btn btn--reversed center" do %>
+      <span>Start import</span>
+    <% end %>
+  <% end %>
+</article>
