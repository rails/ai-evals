+class Account::DataTransfer::TransferTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+    Current.identity = @user.identity
+
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    embed = ActionText::Attachment.from_attachable(@card.image.blob).to_html
+    mention = ActionText::Attachment.from_attachable(users(:jz)).to_html
+    @card.update!(description: "<p>Card image #{embed} #{mention}</p>")
+    @comment = @card.comments.create!(creator: @user, body: "<p>Comment with a file #{embed}</p>")
+  end
+
+  test "account archive round-trips cards, comments, people, rich text, and files" do
+    archive_file = account_archive(@account)
+    import = Import.new(account: @account, user: @user)
+    archive_file.rewind
+    import.file.attach(io: archive_file, filename: "account.zip", content_type: "application/zip")
+    import.save!
+
+    source_blob = @card.image.blob
+    archive = Account::DataTransfer::Archive.new(import.file.blob)
+    extracted_file = archive.each_chunk("files/#{source_blob.id}").to_a.join
+    assert_equal source_blob.download, extracted_file
+    archive.close
+
+    assert_difference "Account.count", 1 do
+      import.process_now
+      assert import.reload.completed?, import.error_message
+    end
+
+    imported_account = import.reload.imported_account
+    imported_card = imported_account.cards.find_by!(number: @card.number)
+    imported_comment = imported_card.comments.detect do |comment|
+      comment.body.to_plain_text.include?("Comment with a file")
+    end
+
+    assert imported_comment
+    assert_equal "Writebook", imported_card.board.name
+    assert_equal @card.title, imported_card.title
+    assert_includes imported_comment.body.to_plain_text, "Comment with a file"
+    assert imported_comment.attachments.any?
+    assert_equal "owner", imported_account.users.find_by!(identity: @user.identity).role
+    assert_not_equal @account.id, imported_account.id
+    assert imported_account.join_code.present?
+    assert imported_card.image.attached?
+    assert_equal source_blob.download, imported_card.image.blob.download
+    assert_includes imported_card.description.body.to_html, "action-text-attachment"
+    assert imported_card.description.body.attachables.any? do |attachable|
+      attachable.is_a?(User) && attachable.identity == users(:jz).identity
+    end
+    assert_equal imported_account.cards_count, imported_account.cards.count
+  ensure
+    archive_file&.close!
+  end
+
+  test "cards export is JSON and includes attached card and comment files" do
+    tempfile = Tempfile.new([ "cards", ".zip" ])
+    tempfile.binmode
+    zip = ZipFile::Writer.new(tempfile)
+    Account::DataTransfer::CardsExport.new(@user).export_to(zip)
+    zip.close
+    tempfile.rewind
+
+    entries = ZipKit::FileReader.new.read_zip_structure(io: tempfile)
+    cards_entry = entries.find { |entry| entry.filename == "cards.json" }
+    json = read_entry(tempfile, cards_entry)
+    card_data = JSON.parse(json).fetch("cards").find { |card| card.dig("card", "id") == @card.id }
+
+    assert card_data.fetch("comments").any? { |comment| comment.fetch("id") == @comment.id }
+    assert_equal 1, card_data.fetch("attachments").map { |attachment| attachment.fetch("path") }.uniq.size
+    assert entries.any? { |entry| entry.filename.start_with?("files/") }
+    assert_includes ActionText::Content.new(card_data.fetch("description")).to_plain_text, "Card image"
+  ensure
+    tempfile&.close!
+  end
+
+  test "a failed import rolls back the new account and preserves the reason" do
+    archive_file = account_archive(@account)
+    import = Import.new(account: @account, user: @user)
+    archive_file.rewind
+    import.file.attach(io: archive_file, filename: "account.zip", content_type: "application/zip")
+    import.save!
+
+    ActiveStorage::Blob.service.stubs(:upload).raises(IOError, "storage is unavailable")
+
+    assert_no_difference "Account.count" do
+      import.process_now
+    end
+
+    assert import.reload.failed?
+    assert_includes import.error_message, "storage is unavailable"
+    assert_nil import.imported_account_id
+  ensure
+    archive_file&.close!
+  end
+
+  test "invalid ZIP input fails without leaving an account behind" do
+    import = Import.new(account: @account, user: @user)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+    import.save!
+
+    assert_no_difference "Account.count" do
+      import.process_now
+    end
+
+    assert import.reload.failed?
+    assert_match(/ZIP|archive/i, import.error_message)
+  end
+
+  private
+    def account_archive(account)
+      tempfile = Tempfile.new([ "account", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      Account::DataTransfer::Manifest.new(account).export_to(writer)
+      writer.close
+      tempfile.flush
+      tempfile
+    end
+
+    def read_entry(io, entry)
+      extractor = entry.extractor_from(io)
+      result = String.new(encoding: Encoding::BINARY)
+      result << extractor.extract(64.kilobytes) until extractor.eof?
+      result
+    end
+end
