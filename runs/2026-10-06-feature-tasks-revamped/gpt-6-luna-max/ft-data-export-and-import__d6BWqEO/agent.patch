diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..733eb41
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,64 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRY_DURATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %i[ account cards ].index_by(&:itself), scopes: false
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validates :kind, :status, presence: true
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate_now
+    return if completed?
+
+    update!(status: :processing, error_message: nil)
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account?
+        Account::DataTransfer::Manifest.new(account).export_to(zip)
+      else
+        Account::DataTransfer::CardsExport.new(user).export_to(zip)
+      end
+    end
+
+    update!(status: :completed)
+    ExportMailer.ready(self).deliver_later
+  rescue StandardError => error
+    file.purge if file.attached?
+    update!(status: :failed, error_message: failure_reason(error).truncate(5000))
+    ExportMailer.failed(self).deliver_later
+    Rails.error.report(error, context: { export_id: id })
+  end
+
+  def download_id
+    signed_id(purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY_DURATION)
+  end
+
+  def downloadable?
+    completed? && file.attached?
+  end
+
+  private
+    def failure_reason(error)
+      if error.respond_to?(:record) && error.record&.errors&.any?
+        "#{error.message}: #{error.record.errors.full_messages.to_sentence}"
+      else
+        error.message
+      end
+    end
+
+    def filename
+      if account?
+        "fizzy-account-export.zip"
+      else
+        "fizzy-cards-export.zip"
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..6e52a24
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,45 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validate :file_must_be_a_zip
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+
+  def process_now
+    return if completed? || failed?
+
+    update!(status: :processing, error_message: nil)
+
+    begin
+      Account::DataTransfer::Importer.new(self).import!
+    rescue StandardError => error
+      update!(status: :failed, error_message: error.message.truncate(5000))
+      file.purge_later if file.attached?
+      ImportMailer.failed(self).deliver_later
+      Rails.error.report(error, context: { import_id: id })
+    else
+      file.purge_later if file.attached?
+      Current.with_account(imported_account) do
+        ImportMailer.completed(self).deliver_later
+        Storage::ReconcileJob.perform_later(imported_account)
+      end
+    end
+  end
+
+  private
+    def file_must_be_a_zip
+      if file.attached?
+        errors.add(:file, "must be a ZIP file") unless File.extname(file.filename.to_s).casecmp?(".zip")
+      else
+        errors.add(:file, "must be selected")
+      end
+    end
+end
