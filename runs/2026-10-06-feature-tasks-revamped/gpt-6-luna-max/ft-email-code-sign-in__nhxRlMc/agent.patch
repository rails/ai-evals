+++ b/test/models/email_code_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issues a six-character code that can only be used once" do
+    perform_enqueued_jobs do
+      @email_code = EmailCode.issue(email_address: "  Person@Example.com ", purpose: "sign_in")
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "person@example.com" ], email.to
+    assert_match(/\d{6}/, email.subject)
+    code = email.subject.match(/\d{6}/)[0]
+    assert_not_equal code, @email_code.code_digest
+
+    assert @email_code.authenticate(code)
+    assert_not @email_code.reload.authenticate(code)
+  end
+
+  test "email codes expire after fifteen minutes" do
+    issued_at = Time.current
+
+    perform_enqueued_jobs do
+      @email_code = EmailCode.issue(email_address: "person@example.com", purpose: "sign_in")
+    end
+
+    assert_in_delta 15.minutes.to_i, (@email_code.expires_at - issued_at).to_i, 1
+    code = ActionMailer::Base.deliveries.last.subject.match(/\d{6}/)[0]
+
+    travel_to @email_code.expires_at, with_usec: true do
+      assert_not @email_code.reload.authenticate(code)
+    end
+  end
+end
