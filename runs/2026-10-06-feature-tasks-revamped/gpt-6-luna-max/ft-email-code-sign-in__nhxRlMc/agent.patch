diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..87a3451
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,127 @@
+class Sessions::EmailCodesController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :set_email_code
+
+  layout "public"
+
+  def new
+    set_code_paths
+  end
+
+  def create
+    if @email_code.authenticate(params[:code])
+      session.delete(:email_code_id)
+      continue_authentication
+    else
+      set_code_paths
+      flash.now[:alert] = "That code didn't work or has expired. Try again."
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:email_code_id])
+
+      if @email_code.nil?
+        redirect_to new_session_path(script_name: nil)
+      end
+    end
+
+    def continue_authentication
+      case @email_code.purpose
+      when "sign_in"
+        sign_in_existing_identity
+      when "signup"
+        complete_signup
+      when "join"
+        complete_join
+      end
+    end
+
+    def sign_in_existing_identity
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        authenticate_as(identity)
+        redirect_to after_authentication_url
+      else
+        redirect_to new_session_path(script_name: nil), alert: "There’s no Fizzy account for that email address. Sign up to create one."
+      end
+    end
+
+    def complete_signup
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      authenticate_as(identity)
+      redirect_to new_signup_completion_path(script_name: nil)
+    end
+
+    def complete_join
+      join_code = @email_code.join_code
+
+      if join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        authenticate_as(identity)
+        join_code.redeem_if { |account| identity.join(account) }
+
+        if user = User.active.find_by(account: join_code.account, identity: identity)
+          if user.setup?
+            redirect_to landing_url(script_name: join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: join_code.account.slug)
+          end
+        else
+          redirect_to_join_code(join_code)
+        end
+      else
+        redirect_to_join_code(join_code)
+      end
+    end
+
+    def authenticate_as(identity)
+      if Current.identity != identity
+        terminate_session if Current.session
+        start_new_session_for(identity)
+      end
+    end
+
+    def redirect_to_join_code(join_code)
+      if join_code
+        redirect_to join_path(code: join_code.code, script_name: join_code.account.slug), alert: "That join code is no longer active."
+      else
+        redirect_to new_session_path(script_name: nil), alert: "That join code is no longer available."
+      end
+    end
+
+    def set_code_paths
+      @code_path = session_email_code_path(script_name: email_code_script_name)
+      @restart_path = email_code_restart_path
+    end
+
+    def email_code_restart_path
+      case @email_code.purpose
+      when "signup"
+        new_signup_path(script_name: nil)
+      when "join"
+        if join_code = @email_code.join_code
+          join_path(code: join_code.code, script_name: join_code.account.slug)
+        else
+          new_session_path(script_name: nil)
+        end
+      else
+        new_session_path(script_name: nil)
+      end
+    end
+
+    def email_code_script_name
+      if @email_code.purpose == "join"
+        @email_code.join_code&.account&.slug
+      else
+        nil
+      end
+    end
+
+    def rate_limit_exceeded
+      redirect_to new_session_path(script_name: nil), alert: "Try again later."
+    end
+end
