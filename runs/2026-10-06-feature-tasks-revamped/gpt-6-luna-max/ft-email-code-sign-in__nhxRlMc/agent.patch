@@ -0,0 +1,22 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= @email_code.email_address %></strong>. It expires in 15 minutes.</p>
+
+  <%= form_with url: @code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9]{6}", maxlength: 6, aria: { label: "Six-character code" }, class: "input txt-large full-width", placeholder: "Enter your code…" %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-align-center txt-small"><%= link_to "Use another email address", @restart_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
