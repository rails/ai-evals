diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..18077ca
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,57 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_FORMAT = /\A[0-9]{#{CODE_LENGTH}}\z/
+  EXPIRATION_DURATION = 15.minutes
+  PURPOSES = %w[ sign_in signup join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(value) { value&.strip&.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :code_digest, :expires_at, presence: true
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+  validates :join_code, absence: true, unless: -> { purpose == "join" }
+
+  def self.digest_code(email_address:, purpose:, join_code_id: nil, code:)
+    OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, [ email_address, purpose, join_code_id, code ].join(":"))
+  end
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    where("expires_at <= ?", Time.current).delete_all
+
+    code = SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+    email_code = new(email_address: email_address, purpose: purpose, join_code: join_code, expires_at: EXPIRATION_DURATION.from_now)
+    email_code.code_digest = digest_code(email_address: email_code.email_address, purpose: purpose, join_code_id: email_code.join_code_id, code: code)
+    email_code.save!
+
+    UserMailer.email_code(email_address: email_code.email_address, code: code).deliver_later
+    email_code
+  end
+
+  def authenticate(code)
+    with_lock do
+      if used_at.nil? && expires_at > Time.current && code_matches?(code)
+        update!(used_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  end
+
+  private
+    def code_matches?(code)
+      submitted_code = code.to_s
+
+      if submitted_code.match?(CODE_FORMAT) && code_digest.present?
+        ActiveSupport::SecurityUtils.secure_compare(
+          code_digest,
+          self.class.digest_code(email_address: email_address, purpose: purpose, join_code_id: join_code_id, code: submitted_code)
+        )
+      else
+        false
+      end
+    end
+end
