+      else
+        ""
+      end
+
+      <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM #{quoted_table(parent_table)}
+          WHERE #{column(parent_table, parent_key)} = #{column(child_table, child_key)}
+          #{account_match}
+        )
+      SQL
+    end
+
+    def polymorphic_relation_in_same_account(child_table, type_column, id_column, types, account_table: nil)
+      types.map do |type, parent_table|
+        account_match = if parent_table == account_table
+          "AND #{column(parent_table, "id")} = #{column(child_table, "account_id")}"
+        else
+          "AND #{column(parent_table, "account_id")} = #{column(child_table, "account_id")}"
+        end
+
+        <<~SQL.squish
+          (#{column(child_table, type_column)} = #{connection.quote(type)} AND EXISTS (
+            SELECT 1
+            FROM #{quoted_table(parent_table)}
+            WHERE #{column(parent_table, "id")} = #{column(child_table, id_column)}
+            #{account_match}
+          ))
+        SQL
+      end.join(" OR ").then { "(#{it})" }
+    end
+
+    def quoted_table(table)
+      connection.quote_table_name(table)
+    end
+
+    def table(table_name)
+      quoted_table(table_name)
+    end
+
+    def quoted_column_name(column_name)
+      connection.quote_column_name(column_name)
+    end
+
+    def column(table, name)
+      "#{quoted_table(table)}.#{quoted_column_name(name)}"
+    end
+end
