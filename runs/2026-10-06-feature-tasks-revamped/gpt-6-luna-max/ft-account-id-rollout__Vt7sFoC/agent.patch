+      else
+        account_match = "AND #{column(parent_table, parent_key)} = #{column(child_table, "account_id")}"
+      end
+
+      <<~SQL.squish
+        EXISTS (
+          SELECT 1
+          FROM #{quoted_table(parent_table)}
+          WHERE #{column(parent_table, parent_key)} = #{column(child_table, child_key)}
+          #{account_match}
+        )
+      SQL
+    end
