diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..860b9ad
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from at least two people within a third of the board auto-close period create a burst" do
+    freeze_time
+    card = cards(:buy_domain)
+    window = card.auto_postpone_period / 3
+
+    create_comment(card, users(:david), created_at: Time.current - window - 1.second)
+    create_comment(card, users(:david), created_at: Time.current - 1.day)
+    create_comment(card, users(:kevin), created_at: Time.current)
+
+    assert_nil card.reload.burst_at
+
+    create_comment(card, users(:kevin), created_at: Time.current)
+
+    assert_equal Time.current, card.reload.burst_at
+  end
+
+  test "comments by one person or system comments do not create a burst" do
+    freeze_time
+    card = cards(:buy_domain)
+
+    3.times { create_comment(card, users(:david), created_at: Time.current) }
+    assert_nil card.reload.burst_at
+
+    create_comment(card, card.account.system_user, created_at: Time.current)
+    assert_nil card.reload.burst_at
+
+    create_comment(card, users(:kevin), created_at: Time.current)
+    assert_equal Time.current, card.reload.burst_at
+  end
+
+  test "assigning or reopening a card creates a burst" do
+    freeze_time
+    assigned_card = cards(:buy_domain)
+    assigned_card.toggle_assignment(users(:kevin))
+
+    assert_equal Time.current, assigned_card.reload.burst_at
+
+    reopened_card = cards(:shipping)
+    reopened_card.reopen
+
+    assert_equal Time.current, reopened_card.reload.burst_at
+  end
+
+  test "a later comment resets the inactivity timer" do
+    freeze_time
+    card = cards(:buy_domain)
+    card.toggle_assignment(users(:kevin))
+    burst_at = card.reload.burst_at
+
+    travel 1.day
+    create_comment(card, users(:kevin), created_at: Time.current)
+
+    assert_equal burst_at, card.reload.burst_at
+    assert_not_predicate card, :stalled?
+  end
+
+  test "two inactive weeks after the latest activity make a burst card stalled" do
+    freeze_time
+    card = cards(:buy_domain)
+    card.toggle_assignment(users(:kevin))
+    burst_at = card.reload.burst_at
+
+    travel 13.days
+    assert_not_predicate card.reload, :stalled?
+
+    travel 1.day
+    assert_predicate card.reload, :stalled?
+    assert_includes Card.stalled, card
+
+    card.touch_last_active_at
+
+    assert_equal burst_at, card.reload.burst_at
+    assert_not_predicate card, :stalled?
+    assert_not_includes Card.stalled, card
+
+    travel 2.weeks
+    assert_predicate card.reload, :stalled?
+  end
+
+  private
+    def create_comment(card, creator, created_at:)
+      card.comments.create!(creator: creator, body: "An update", created_at: created_at)
+    end
+end
