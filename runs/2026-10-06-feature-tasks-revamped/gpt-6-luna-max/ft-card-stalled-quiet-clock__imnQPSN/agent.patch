diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..f9aadad
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,34 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLING_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      cutoff = as_of - STALLING_PERIOD
+      where(burst_at: ..cutoff, last_active_at: ..cutoff)
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    if burst_at.present?
+      cutoff = as_of - STALLING_PERIOD
+      burst_at <= cutoff && last_active_at <= cutoff
+    else
+      false
+    end
+  end
+
+  def record_burst
+    update! burst_at: last_active_at
+  end
+
+  def record_comment_burst(comment)
+    burst_window = auto_postpone_period / 3
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - burst_window)..comment.created_at)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      record_burst
+    end
+  end
+end
