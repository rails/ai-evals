diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1b9e957
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "shows the search page without searching when the query is blank" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?][method=get]", search_path
+    assert_select ".search-result", count: 0
+  end
+
+  test "searches published cards by title, description, and comment body" do
+    title_card = cards(:logo)
+    description_card = cards(:text)
+    comment_card = cards(:layout)
+
+    with_current_user do
+      title_card.update! title: "Term appears in the title"
+      description_card.update! description: "Term appears in the description"
+      comment_card.comments.create! creator: users(:kevin), body: "Term appears in a comment"
+    end
+
+    get search_path, params: { q: "term" }
+
+    assert_response :success
+    assert_select ".search-result", count: 3
+    assert_select ".search-result__title[href=?]", card_path(title_card)
+    assert_select ".search-result__title[href=?]", card_path(description_card)
+    assert_select ".search-result__title[href=?]", card_path(comment_card)
+    assert_select "mark" do |marks|
+      assert_operator marks.length, :>=, 3
+    end
+  end
+
+  test "orders results newest first" do
+    older_card = create_published_card "orderphrase older", created_at: 2.days.ago
+    newer_card = create_published_card "orderphrase newer", created_at: Time.current
+
+    get search_path, params: { q: "orderphrase" }
+
+    assert_response :success
+    assert_equal [ card_path(newer_card), card_path(older_card) ],
+      css_select(".search-result__title").map { |link| link["href"] }
+  end
+
+  test "only returns cards on boards the current user can access" do
+    private_card = with_current_user do
+      boards(:private).cards.create!(title: "privatephrase", status: :published, creator: users(:kevin))
+    end
+
+    get search_path, params: { q: "privatephrase" }
+    assert_select ".search-result__title[href=?]", card_path(private_card)
+
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "privatephrase" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards or comments on draft cards" do
+    card = create_published_card "draftphrase in the title"
+
+    with_current_user do
+      card.comments.create! creator: users(:kevin), body: "draftphrase in a comment"
+      card.update_column :status, "drafted"
+    end
+
+    get search_path, params: { q: "draftphrase" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "treats search terms as literal text" do
+    card = create_published_card "A literal % sign"
+
+    get search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(card)
+    assert_select "mark", text: "%"
+  end
+
+  test "escapes card content while highlighting a match" do
+    create_published_card "Needle <img src=x onerror=alert(1)>"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "Needle"
+    assert_select "[onerror]", count: 0
+  end
+
+  private
+    def create_published_card(title, created_at: Time.current)
+      with_current_user do
+        boards(:writebook).cards.create!(title: title, status: :published, created_at: created_at, creator: users(:kevin))
+      end
+    end
+
+    def with_current_user(&block)
+      Current.set(account: accounts("37s"), user: users(:kevin), &block)
+    end
+end
