+class SearchesController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @matching_comments_by_card_id = {}
+
+    if @query.present?
+      set_page_and_extract_portion_from search_results
+      @matching_comments_by_card_id = matching_comments if @page.records.any?
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards.published
+        .joins(<<~SQL.squish)
+          LEFT OUTER JOIN action_text_rich_texts AS search_card_descriptions
+            ON search_card_descriptions.record_type = 'Card'
+            AND search_card_descriptions.record_id = cards.id
+            AND search_card_descriptions.name = 'description'
+          LEFT OUTER JOIN comments AS search_comments
+            ON search_comments.card_id = cards.id
+          LEFT OUTER JOIN action_text_rich_texts AS search_comment_bodies
+            ON search_comment_bodies.record_type = 'Comment'
+            AND search_comment_bodies.record_id = search_comments.id
+            AND search_comment_bodies.name = 'body'
+        SQL
+        .where(<<~SQL.squish, pattern: search_pattern)
+          cards.title LIKE :pattern ESCAPE '!'
+          OR search_card_descriptions.body LIKE :pattern ESCAPE '!'
+          OR search_comment_bodies.body LIKE :pattern ESCAPE '!'
+        SQL
+        .distinct
+        .reverse_chronologically
+        .preload(:board, :rich_text_description)
+    end
+
+    def matching_comments
+      Comment
+        .joins(<<~SQL.squish)
+          INNER JOIN action_text_rich_texts AS search_comment_bodies
+            ON search_comment_bodies.record_type = 'Comment'
+            AND search_comment_bodies.record_id = comments.id
+            AND search_comment_bodies.name = 'body'
+        SQL
+        .where(card_id: @page.records)
+        .where("search_comment_bodies.body LIKE ? ESCAPE '!'", search_pattern)
+        .preload(:rich_text_body)
+        .order(created_at: :desc, id: :desc)
+        .group_by(&:card_id)
+    end
+
+    def search_pattern
+      "%#{ActiveRecord::Base.sanitize_sql_like(@query, '!')}%"
+    end
+end
diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..d2208b1
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, class: "input", placeholder: "Search cards…" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination "search-results", @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result panel margin-block">
+          <h2>
+            <%= link_to highlight(card.title, @query), card_path(card), class: "search-result__title" %>
+          </h2>
+
+          <p class="txt-small">On <%= link_to card.board.name, board_path(card.board) %></p>
+
+          <% if description_excerpt = excerpt(card.description.to_plain_text, @query, radius: 100) %>
+            <p><%= highlight(description_excerpt, @query) %></p>
+          <% end %>
+
+          <% @matching_comments_by_card_id.fetch(card.id, []).each do |comment| %>
+            <% if comment_excerpt = excerpt(comment.body.to_plain_text, @query, radius: 100) %>
+              <p><%= highlight(comment_excerpt, @query) %></p>
+            <% end %>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p class="blank-slate margin">No cards match this search.</p>
+  <% end %>
+<% end %>
