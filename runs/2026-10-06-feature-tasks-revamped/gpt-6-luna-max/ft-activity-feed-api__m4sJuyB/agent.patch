diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d6fc4d7
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index as JSON returns a flat array with existing API representations" do
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    activity = @response.parsed_body.find { |event| event["id"] == events(:logo_assignment_jz).id }
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], activity.keys.sort
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:logo_assignment_jz).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal events(:logo_assignment_jz).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "includes card title changes and omits deprecated collection changes" do
+    card = cards(:logo)
+    title_change = create_event(card, "card_title_changed", particulars: {
+      "particulars" => { "old_title" => "Old title", "new_title" => "New title" }
+    })
+    collection_change = create_event(card, "card_collection_changed")
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    title_activity = activities.find { |event| event["id"] == title_change.id }
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, title_activity["particulars"])
+    assert_not_includes activities.pluck("id"), collection_change.id
+  end
+
+  test "returns event-specific particulars and empty strings for missing values" do
+    card = cards(:logo)
+    board_change = create_event(card, "card_board_changed", particulars: {
+      "particulars" => { "old_board" => "Old board", "new_board" => "New board" }
+    })
+    triage = create_event(card, "card_triaged", particulars: { "particulars" => { "column" => "In progress" } })
+    missing_board = create_event(card, "card_board_changed")
+    missing_title = create_event(card, "card_title_changed")
+    missing_column = create_event(card, "card_triaged")
+    other_event = create_event(card, "card_published")
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body.index_by { |event| event["id"] }
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activities[board_change.id]["particulars"])
+    assert_equal({ "column" => "In progress" }, activities[triage.id]["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities[missing_board.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities[missing_title.id]["particulars"])
+    assert_equal({ "column" => "" }, activities[missing_column.id]["particulars"])
+    assert_equal({}, activities[other_event.id]["particulars"])
+  end
+
+  test "comment activity URL opens its card at the comment" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+  end
+
+  test "can filter by creator and board ids" do
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private activity", status: "drafted")
+    private_event = private_card.events.create!(board: private_card.board, creator: users(:kevin), action: "card_published")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.pluck("id")
+  end
+
+  test "only includes activity from boards the current user can access" do
+    private_card = boards(:private).cards.create!(creator: users(:kevin), title: "Private activity", status: "drafted")
+    private_event = private_card.events.create!(board: private_card.board, creator: users(:kevin), action: "card_published")
+
+    logout_and_sign_in_as :jz
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert @response.parsed_body.all? { |activity| users(:jz).boards.ids.include?(activity.dig("board", "id")) }
+  end
+
+  test "index uses the API pagination headers" do
+    card = cards(:logo)
+    20.times do |index|
+      card.events.create!(
+        board: card.board,
+        creator: users(:david),
+        action: "card_published",
+        created_at: Time.current + index.seconds
+      )
+    end
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_equal Event.where(board: users(:kevin).boards, action: ActivitiesController::ACTIVITY_ACTIONS).count.to_s,
+      @response.headers["X-Total-Count"]
+    assert @response.headers["Link"].include?('rel="next"')
+    assert_equal 15, @response.parsed_body.length
+    assert_equal @response.parsed_body.map { |event| event["created_at"] }.sort.reverse,
+      @response.parsed_body.map { |event| event["created_at"] }
+  end
+
+  private
+    def create_event(card, action, particulars: {})
+      card.events.create!(
+        board: card.board,
+        creator: users(:david),
+        action: action,
+        particulars: particulars,
+        created_at: Time.current
+      )
+    end
+end
