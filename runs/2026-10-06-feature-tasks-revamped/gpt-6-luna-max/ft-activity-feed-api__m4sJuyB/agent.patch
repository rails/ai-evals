+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,26 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = Event::ACTIVITY_ACTIONS
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events
+        .where(events: { account_id: Current.account.id, action: ACTIVITY_ACTIONS })
+
+      events = events.where(events: { creator_id: filter_params[:creator_ids] }) if filter_params[:creator_ids].present?
+      events = events.where(events: { board_id: filter_params[:board_ids] }) if filter_params[:board_ids].present?
+
+      events.preloaded.order(events: { created_at: :desc, id: :desc })
+    end
+
+    def filter_params
+      @filter_params ||= params.permit(creator_ids: [], board_ids: [])
+    end
+end
