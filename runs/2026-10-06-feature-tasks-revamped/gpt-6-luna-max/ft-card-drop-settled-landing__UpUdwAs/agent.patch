diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..14b917d
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,288 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DROP_CONTAINER_SELECTOR = '[data-drag-and-drop-target~="container"]'
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  #draggedCard
+  #hoveredContainer
+  #pendingFrameCards = new Map()
+
+  dragStart(event) {
+    const card = event.target.closest(".card[data-drag-and-drop-triage-url]")
+
+    if (card && this.element.contains(card)) {
+      this.#draggedCard = card
+      card.classList.add(DRAGGED_ITEM_CLASS)
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        event.dataTransfer.setData("text/plain", card.id)
+      }
+    }
+  }
+
+  dragOver(event) {
+    if (this.#draggedCard) {
+      const container = this.#dropContainerFor(event.target)
+
+      if (container) {
+        event.preventDefault()
+        if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+        this.#highlightContainer(container)
+      } else {
+        this.#clearHighlightedContainer()
+      }
+    }
+  }
+
+  drop(event) {
+    const card = this.#draggedCard
+    const container = this.#dropContainerFor(event.target)
+
+    if (card && container) {
+      event.preventDefault()
+      const source = this.#dropContainerFor(card)
+      this.#clearHighlightedContainer()
+
+      if (!this.#sameContainer(source, container)) {
+        const request = this.#requestFor(card, container)
+        const destinationList = container.querySelector(".cards__list")
+
+        if (request && destinationList) {
+          const originalParent = card.parentNode
+          const originalNextSibling = card.nextSibling
+          const originalCard = card.cloneNode(true)
+          const pendingFrame = container.querySelector("turbo-frame[src]:not([complete])")
+
+          if (pendingFrame) this.#pendingFrameCards.set(card, { frameId: pendingFrame.id, container })
+
+          this.#insertAtLatestPosition(card, destinationList, container)
+          this.#updateCardState(card, container)
+          this.#adjustCount(source, -1)
+          this.#adjustCount(container, 1)
+          this.#saveMove(request, card, originalCard, originalParent, originalNextSibling, destinationList, source, container)
+        }
+      }
+    }
+  }
+
+  dragEnd() {
+    this.#draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#draggedCard = null
+    this.#clearHighlightedContainer()
+  }
+
+  // A frame can finish loading with a stale snapshot after the local drop.
+  // Keep the optimistic card and discard any server-rendered duplicate.
+  reconcileFrame({ target: frame }) {
+    this.#pendingFrameCards.forEach(({ frameId, container }, card) => {
+      if (frameId === frame.id) {
+        const list = container.querySelector(".cards__list")
+
+        if (list) {
+          container.querySelectorAll(".card").forEach(duplicate => {
+            if (duplicate !== card && duplicate.id === card.id) duplicate.remove()
+          })
+          if (!card.isConnected) list.append(card)
+          if (this.#dropContainerFor(card) === container) {
+            this.#insertAtLatestPosition(card, list, container)
+          }
+        }
+        this.#pendingFrameCards.delete(card)
+      }
+    })
+  }
+
+  #dropContainerFor(element) {
+    const container = element.closest(DROP_CONTAINER_SELECTOR)
+    return container && this.element.contains(container) ? container : null
+  }
+
+  #highlightContainer(container) {
+    if (this.#hoveredContainer !== container) {
+      this.#clearHighlightedContainer()
+      container.classList.add(HOVER_CONTAINER_CLASS)
+      this.#hoveredContainer = container
+    }
+  }
+
+  #clearHighlightedContainer() {
+    this.#hoveredContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.#hoveredContainer = null
+  }
+
+  #sameContainer(source, destination) {
+    return source &&
+      source.dataset.dragAndDropKind === destination.dataset.dragAndDropKind &&
+      source.dataset.dragAndDropColumnId === destination.dataset.dragAndDropColumnId
+  }
+
+  #requestFor(card, container) {
+    switch (container.dataset.dragAndDropKind) {
+      case "column": {
+        const body = new FormData()
+        body.append("column_id", container.dataset.dragAndDropColumnId)
+
+        return {
+          method: "post",
+          url: card.dataset.dragAndDropTriageUrl,
+          body
+        }
+      }
+      case "maybe":
+        return { method: "delete", url: card.dataset.dragAndDropTriageUrl }
+      case "done":
+        return { method: "post", url: card.dataset.dragAndDropClosureUrl }
+      case "not-now":
+        return { method: "post", url: card.dataset.dragAndDropNotNowUrl }
+    }
+  }
+
+  #insertAtLatestPosition(card, list, container) {
+    const cards = Array.from(list.querySelectorAll(".card")).filter(existingCard => existingCard !== card)
+    const goldenFirst = container.dataset.dragAndDropKind === "column" || container.dataset.dragAndDropKind === "maybe"
+    const firstCard = goldenFirst && !card.classList.contains("golden-effect")
+      ? cards.find(existingCard => !existingCard.classList.contains("golden-effect"))
+      : cards[0]
+
+    if (firstCard) {
+      firstCard.before(card)
+    } else {
+      list.append(card)
+    }
+  }
+
+  #updateCardState(card, container) {
+    const kind = container.dataset.dragAndDropKind
+    card.classList.toggle("card--active", kind === "column" || kind === "maybe")
+    card.classList.toggle("card--postponed", kind === "not-now")
+
+    switch (kind) {
+      case "column":
+        this.#setCardColumn(card, container)
+        this.#removeStatusStamp(card)
+        break
+      case "maybe":
+      case "not-now":
+        this.#clearCardColumn(card)
+        if (kind === "not-now") {
+          this.#setStatusStamp(card, "Not Now")
+        } else {
+          this.#removeStatusStamp(card)
+        }
+        break
+      case "done":
+        this.#removeCurrentColumnLabel(card)
+        this.#setStatusStamp(card, "Done")
+        break
+    }
+  }
+
+  #setCardColumn(card, container) {
+    const columnId = container.dataset.dragAndDropColumnId
+    const columnName = container.dataset.columnName
+    const columnColor = getComputedStyle(container).getPropertyValue("--card-color").trim()
+
+    if (columnColor) card.style.setProperty("--card-color", columnColor)
+
+    card.querySelectorAll(".card__stages [data-card-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.cardColumnId === columnId)
+    })
+
+    let label = card.querySelector(".card__header > .card__column-name--current")
+
+    if (!label) {
+      label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const text = document.createElement("span")
+      text.className = "overflow-ellipsis"
+      label.append(text)
+      card.querySelector(".card__header")?.append(label)
+    }
+
+    const text = label.querySelector(".overflow-ellipsis") || label
+    text.textContent = columnName
+  }
+
+  #clearCardColumn(card) {
+    card.querySelectorAll(".card__stages .card__column-name--current").forEach(stage => {
+      stage.classList.remove("card__column-name--current")
+    })
+    this.#removeCurrentColumnLabel(card)
+
+    if (card.dataset.dragAndDropDefaultColor) {
+      card.style.setProperty("--card-color", card.dataset.dragAndDropDefaultColor)
+    }
+  }
+
+  #removeCurrentColumnLabel(card) {
+    card.querySelector(".card__header > .card__column-name--current")?.remove()
+  }
+
+  #setStatusStamp(card, status) {
+    let stamp = card.querySelector(".card__closed")
+
+    if (!stamp) {
+      stamp = document.createElement("div")
+      card.append(stamp)
+    }
+
+    stamp.className = "card__closed"
+    stamp.replaceChildren()
+
+    const title = document.createElement("span")
+    title.className = "card__closed-title"
+    title.dataset.text = status
+    title.textContent = status
+    stamp.append(title)
+  }
+
+  #removeStatusStamp(card) {
+    card.querySelector(".card__closed")?.remove()
+  }
+
+  #adjustCount(container, adjustment) {
+    const count = container?.querySelector("[data-drag-and-drop-card-count]")
+
+    if (count) {
+      const currentCount = Number(count.dataset.dragAndDropCardCount)
+
+      if (Number.isFinite(currentCount)) {
+        const updatedCount = Math.max(0, currentCount + adjustment)
+        count.dataset.dragAndDropCardCount = updatedCount
+        count.textContent = updatedCount > 99 ? "99+" : updatedCount
+      }
+    }
+  }
+
+  #saveMove({ method, url, body }, card, originalCard, originalParent, originalNextSibling, destinationList, source, destination) {
+    const request = new FetchRequest(method, url, { body, responseKind: "json" })
+
+    request.perform().then(response => {
+      if (!response.ok) {
+        this.#restoreMove(card, originalCard, originalParent, originalNextSibling, destinationList, source, destination)
+      }
+    }).catch(() => {
+      this.#restoreMove(card, originalCard, originalParent, originalNextSibling, destinationList, source, destination)
+    })
+  }
+
+  #restoreMove(card, originalCard, originalParent, originalNextSibling, destinationList, source, destination) {
+    this.#pendingFrameCards.delete(card)
+
+    if (card.closest(".cards__list") === destinationList) {
+      card.replaceWith(originalCard)
+
+      if (originalParent.isConnected) {
+        const nextSibling = originalNextSibling?.parentNode === originalParent ? originalNextSibling : null
+        originalParent.insertBefore(originalCard, nextSibling)
+      }
+
+      this.#adjustCount(source, 1)
+      this.#adjustCount(destination, -1)
+    }
+  }
+}
