+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card into a column moves it immediately without reordering columns" do
+    visit board_url(@board)
+
+    card = find("##{dom_id(@card, :article)}")
+    destination = find("##{dom_id(@column)}")
+    board = find(".card-columns")
+
+    assert_equal "true", card["draggable"]
+    assert_includes board["data-controller"].split, "drag-and-drop"
+    assert_equal "column", destination["data-drag-and-drop-kind"]
+
+    columns_before = page.all(".card-columns section.cards--doing").map { |column| column["id"] }
+
+    page.execute_script(<<~JS)
+      window.__originalDragAndDropTurbo = window.Turbo
+      window.Turbo = {
+        ...window.__originalDragAndDropTurbo,
+        fetch: (url, options) => new Promise((resolve, reject) => {
+          window.__dragAndDropRequest = { url, options, resolve, reject }
+        })
+      }
+    JS
+
+    drag_result = page.execute_script(<<~JS, dom_id(@card, :article), dom_id(@column))
+      const card = document.getElementById(arguments[0])
+      const destination = document.getElementById(arguments[1])
+      const dataTransfer = new DataTransfer()
+
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+      const dragover = new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer })
+      destination.dispatchEvent(dragover)
+
+      const draggedCardWasDimmed = card.classList.contains("drag-and-drop__dragged-item")
+      const destinationWasHighlighted = destination.classList.contains("drag-and-drop__hover-container")
+
+      const drop = new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer })
+      destination.dispatchEvent(drop)
+      const cardMovedImmediately = destination.contains(card)
+      const firstNonGoldenCard = Array.from(destination.querySelectorAll(".cards__list .card")).find(item => !item.classList.contains("golden-effect"))
+      const cardMovedToSortedPosition = firstNonGoldenCard === card
+      const requestStarted = !!window.__dragAndDropRequest
+      const requestOptions = window.__dragAndDropRequest?.options
+      const requestDetails = requestOptions && {
+        method: requestOptions.method,
+        accept: requestOptions.headers.Accept,
+        columnId: requestOptions.body.get("column_id")
+      }
+      card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+
+      return { draggedCardWasDimmed, destinationWasHighlighted, dropWasHandled: drop.defaultPrevented, cardMovedImmediately, cardMovedToSortedPosition, requestStarted, requestDetails }
+    JS
+
+    assert drag_result.fetch("draggedCardWasDimmed")
+    assert drag_result.fetch("destinationWasHighlighted")
+    assert drag_result.fetch("dropWasHandled")
+    assert drag_result.fetch("cardMovedImmediately")
+    assert drag_result.fetch("cardMovedToSortedPosition")
+    assert drag_result.fetch("requestStarted")
+    assert_equal "POST", drag_result.dig("requestDetails", "method")
+    assert_match(/application\/json/, drag_result.dig("requestDetails", "accept"))
+    assert_equal @column.id, drag_result.dig("requestDetails", "columnId")
+    assert_equal columns_before, page.all(".card-columns section.cards--doing").map { |column| column["id"] }
+
+    page.execute_script(<<~JS)
+      const { url, options, resolve, reject } = window.__dragAndDropRequest
+      window.Turbo = window.__originalDragAndDropTurbo
+      window.__originalDragAndDropTurbo.fetch(url, options).then(resolve, reject)
+    JS
+
+    wait_for { @card.reload.column_id == @column.id }
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    first_non_golden_card_id = page.execute_script(<<~JS, dom_id(@column))
+      const destination = document.getElementById(arguments[0])
+      return Array.from(destination.querySelectorAll(".cards__list .card")).find(card => !card.classList.contains("golden-effect"))?.id
+    JS
+    assert_equal dom_id(@card, :article), first_non_golden_card_id
+  end
+
+  test "the browser can drag a card with the pointer" do
+    visit board_url(@board)
+
+    card = find("##{dom_id(@card, :article)}")
+    destination = find("##{dom_id(@column)}")
+    card.drag_to(destination)
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    wait_for { @card.reload.column_id == @column.id }
+    assert_equal @column.id, @card.reload.column_id
+  end
+
+  test "dragging to board statuses updates card status" do
+    visit board_url(@board)
+
+    assert_selector "#closed-cards .cards__list", visible: :all
+    assert_selector "#not-now .cards__list", visible: :all
+
+    assert dispatch_drop(@card, "closed-cards")
+    wait_for { @card.reload.closed? }
+    assert @card.reload.closed?
+
+    assert dispatch_drop(@card, "not-now")
+    wait_for { @card.reload.postponed? }
+    assert @card.reload.postponed?
+
+    assert dispatch_drop(@card, "maybe")
+    wait_for { @card.reload.awaiting_triage? }
+    assert @card.reload.awaiting_triage?
+  end
+
+  test "moving a golden card preserves its golden-first position" do
+    @card = cards(:logo)
+    @column = columns(:writebook_in_progress)
+    visit board_url(@board)
+
+    assert dispatch_drop(@card, dom_id(@column))
+    first_card_id = page.execute_script(<<~JS, dom_id(@column))
+      const destination = document.getElementById(arguments[0])
+      return destination.querySelector(".cards__list .card")?.id
+    JS
+    assert_equal dom_id(@card, :article), first_card_id
+
+    wait_for { @card.reload.column_id == @column.id }
+    first_card_id = page.execute_script(<<~JS, dom_id(@column))
+      const destination = document.getElementById(arguments[0])
+      return destination.querySelector(".cards__list .card")?.id
+    JS
+    assert_equal dom_id(@card, :article), first_card_id
+  end
+
+  test "dropping a card back into its column does not reorder or save it" do
+    @card = cards(:logo)
+    @column = columns(:writebook_triage)
+    visit board_url(@board)
+
+    column_id = dom_id(@column)
+    cards_before = page.all("##{column_id} article.card", visible: :all).map { |card| card["id"] }
+    events_before = @card.events.count
+
+    assert dispatch_drop(@card, column_id)
+
+    cards_after = page.all("##{column_id} article.card", visible: :all).map { |card| card["id"] }
+    assert_equal cards_before, cards_after
+    assert_equal events_before, @card.reload.events.count
+  end
+
+  private
+    def dispatch_drop(card, destination_id)
+      find("##{dom_id(card, :article)}", visible: :all)
+      find("##{destination_id}", visible: :all)
+
+      page.execute_script(<<~JS, dom_id(card, :article), destination_id)
+
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        const moved = destination.contains(card)
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+
+        return moved
+      JS
+    end
+
+    def wait_for(&condition)
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.01 until condition.call
+      end
+    end
+end
