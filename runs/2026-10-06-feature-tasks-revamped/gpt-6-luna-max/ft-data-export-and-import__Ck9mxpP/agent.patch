@@ -0,0 +1,46 @@
+class Account::DataTransfer::IdMap
+  POLYMORPHIC_TABLES = {
+    "Account" => "accounts",
+    "Board" => "boards",
+    "Card" => "cards",
+    "Comment" => "comments",
+    "Event" => "events",
+    "Mention" => "mentions",
+    "User" => "users",
+    "ActionText::RichText" => "action_text_rich_texts",
+    "ActiveStorage::Attachment" => "active_storage_attachments",
+    "ActiveStorage::VariantRecord" => "active_storage_variant_records"
+  }.freeze
+
+  def initialize
+    @mappings = Hash.new { |mappings, table| mappings[table] = {} }
+  end
+
+  def add(table, source_id, destination_id)
+    raise ZipFile::InvalidArchive, "A record in the archive is missing its ID." if source_id.blank?
+
+    @mappings[table.to_s][source_id.to_s] = destination_id
+  end
+
+  def translate(table, source_id)
+    return if source_id.nil?
+
+    @mappings.fetch(table.to_s, {}).fetch(source_id.to_s) do
+      raise ZipFile::InvalidArchive, "The archive contains a reference to a missing #{table.to_s.humanize.downcase} record."
+    end
+  end
+
+  def translate_if_present(table, source_id)
+    @mappings.fetch(table.to_s, {})[source_id.to_s] if source_id.present?
+  end
+
+  def table_for_type(type)
+    POLYMORPHIC_TABLES.fetch(type) do
+      raise ZipFile::InvalidArchive, "The archive contains an unsupported record type."
+    end
+  end
+
+  def each_mapping(table, &block)
+    @mappings.fetch(table.to_s, {}).each(&block)
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..3a8a609
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,251 @@
+class Account::DataTransfer::Importer
+  attr_reader :data_import, :account, :id_map
+
+  def initialize(data_import)
+    @data_import = data_import
+    @id_map = Account::DataTransfer::IdMap.new
+    @uploaded_files = []
+    @created_identity_ids = []
+  end
+
+  def call
+    raise ZipFile::InvalidArchive, "The uploaded archive is missing." unless data_import.archive.attached?
+
+    reader = ZipFile::Reader.new(data_import.archive.blob)
+    archive_manifest = reader.read_json("manifest.json")
+    validate_manifest(archive_manifest, reader)
+    source_account = account_record(reader)
+
+    unless archive_manifest["account_id"].to_s == source_account["id"].to_s
+      raise ZipFile::InvalidArchive, "The archive account record does not match its manifest."
+    end
+
+    Account.transaction do
+      @account = Account.create!(name: source_account.fetch("name"))
+      id_map.add("accounts", source_account.fetch("id"), account.id)
+      account.entropies.delete_all
+
+      Current.with(account: account, identity: data_import.identity, user: nil) do
+        import_record_sets(reader)
+        account.association(:entropy).reset
+        ensure_system_user
+        ensure_account_entropy
+        rewrite_rich_text_embeds
+        reindex_search_records
+        ensure_importing_user
+        create_default_settings_for_account_users
+        account.update_columns(cards_count: account.cards.count)
+        reconcile_storage
+        data_import.update!(imported_account: account, status: :completed)
+      end
+    end
+
+    account
+  rescue => error
+    rollback_import if @account
+    delete_uploaded_files
+    remove_orphaned_identities
+    raise error
+  end
+
+  private
+    def validate_manifest(archive_manifest, reader)
+      unless archive_manifest.is_a?(Hash) &&
+          archive_manifest["type"] == "account" &&
+          archive_manifest["format_version"] == Account::DataTransfer::Manifest::FORMAT_VERSION
+        raise ZipFile::InvalidArchive, "This is not a supported Fizzy account archive."
+      end
+
+      expected_paths = [ "manifest.json" ]
+      Account::DataTransfer::Manifest.new(nil).each_record_set do |record_set|
+        expected_paths << record_set.data_path unless record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+      end
+
+      unexpected_paths = reader.entry_names - expected_paths
+      unless unexpected_paths.all? { |path| path.match?(/\Afiles\/(?:[0-9a-z]{25}|[0-9a-f-]{36})\z/i) }
+        raise ZipFile::InvalidArchive, "The archive contains unexpected files: #{unexpected_paths.inspect}."
+      end
+
+      reader.entries.each do |entry|
+        if entry.filename.start_with?("files/") &&
+            (entry.storage_mode != 0 || entry.compressed_size != entry.uncompressed_size)
+          raise ZipFile::InvalidArchive, "Attachment files in the archive must be stored without compression."
+        end
+      end
+
+      missing_paths = expected_paths - reader.entry_names
+
+      if missing_paths.any?
+        raise ZipFile::InvalidArchive, "The archive is missing #{missing_paths.first}."
+      end
+    end
+
+    def account_record(reader)
+      found = nil
+
+      reader.each_line("data/accounts.jsonl") do |line|
+        next if line.blank?
+        raise ZipFile::InvalidArchive, "The archive must contain exactly one account." if found
+
+        found = JSON.parse(line)
+      rescue JSON::ParserError => error
+        raise ZipFile::InvalidArchive, "The account record in the archive is invalid: #{error.message}"
+      end
+
+      raise ZipFile::InvalidArchive, "The archive does not contain an account." unless found
+      raise ZipFile::InvalidArchive, "The account record has no name." if found["name"].blank?
+
+      found
+    end
+
+    def import_record_sets(reader)
+      Account::DataTransfer::Manifest.new(nil).each_record_set do |record_set|
+        case record_set
+        when Account::DataTransfer::AccountRecordSet
+          next
+        when Account::DataTransfer::ActiveStorage::FileRecordSet
+          record_set.import_files(reader, account:, id_map:, uploaded_files: @uploaded_files)
+        else
+          record_set.import_from(reader, account:, id_map:)
+          if record_set.respond_to?(:created_identity_ids)
+            @created_identity_ids.concat(record_set.created_identity_ids)
+          end
+        end
+      end
+    end
+
+    def ensure_system_user
+      unless account.users.exists?(role: :system)
+        User.insert_all!([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          name: "System",
+          role: "system",
+          active: true,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+      end
+    end
+
+    def ensure_account_entropy
+      unless account.entropy
+        account.create_entropy!(auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD, account: account)
+      end
+    end
+
+    def rewrite_rich_text_embeds
+      rich_text_record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(account)
+      rich_text_record_set.rewrite_imported_embeds(account:, id_map:)
+    end
+
+    def reindex_search_records
+      account.cards.includes(:rich_text_description).find_each(batch_size: 500) do |card|
+        card.reindex
+        card.comments.includes(:rich_text_body, :card).find_each(batch_size: 500, &:reindex)
+      end
+    end
+
+    def reconcile_storage
+      account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+
+      account.reconcile_storage
+      account.materialize_storage
+    end
+
+    def ensure_importing_user
+      identity = data_import.identity
+      user = account.users.find_by(identity: identity)
+
+      if user
+        user.update_columns(
+          active: true,
+          role: "owner",
+          verified_at: user.verified_at || Time.current,
+          updated_at: Time.current
+        )
+      else
+        user_id = ActiveRecord::Type::Uuid.generate
+        User.insert_all!([ {
+          id: user_id,
+          account_id: account.id,
+          identity_id: identity.id,
+          name: data_import.requested_by&.name || identity.email_address,
+          role: "owner",
+          active: true,
+          verified_at: Time.current,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+        user = account.users.find(user_id)
+      end
+
+      create_default_settings_for(user)
+      grant_access_to_all_boards(user)
+      Current.user = user
+    end
+
+    def create_default_settings_for(user)
+      unless User::Settings.exists?(user_id: user.id)
+        User::Settings.insert_all!([ {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          user_id: user.id,
+          created_at: Time.current,
+          updated_at: Time.current
+        } ])
+      end
+    end
+
+    def create_default_settings_for_account_users
+      account.users.where.not(role: :system).find_each do |user|
+        create_default_settings_for(user)
+      end
+    end
+
+    def grant_access_to_all_boards(user)
+      existing_board_ids = Access.where(user: user).pluck(:board_id)
+      board_ids = account.boards.where.not(id: existing_board_ids).ids
+      return if board_ids.empty?
+
+      Access.insert_all(board_ids.map do |board_id|
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: account.id,
+          board_id: board_id,
+          user_id: user.id,
+          created_at: Time.current,
+          updated_at: Time.current
+        }
+      end)
+    end
+
+    def rollback_import
+      if Account.exists?(id: account.id)
+        account.destroy!
+        if data_import.imported_account_id == account.id && !Account.exists?(id: account.id)
+          data_import.update_columns(imported_account_id: nil, status: "pending")
+        end
+      end
+
+    rescue => error
+      Rails.logger.error("Could not remove incomplete imported account #{account.id}: #{error.message}")
+    end
+
+    def delete_uploaded_files
+      @uploaded_files.each do |service, key|
+        service.delete(key)
+      rescue => error
+        Rails.logger.error("Could not remove incomplete imported attachment #{key}: #{error.message}")
+      end
+    end
+
+    def remove_orphaned_identities
+      Identity.where(id: @created_identity_ids).where.missing(:users).delete_all
+    rescue => error
+      Rails.logger.error("Could not remove identities from incomplete import: #{error.message}")
+    end
+end
