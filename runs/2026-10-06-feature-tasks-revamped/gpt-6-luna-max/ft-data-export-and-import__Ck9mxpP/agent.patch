+class Account::ImportsController < ApplicationController
+  def new
+    @data_import = DataImport.new
+  end
+
+  def create
+    @data_import = DataImport.new(
+      account: Current.account,
+      requested_by: Current.user,
+      identity: Current.identity,
+      requested_by_email: Current.identity.email_address
+    )
+    @data_import.archive.attach(import_params[:archive]) if import_params[:archive].present?
+
+    if @data_import.save
+      @data_import.create_later
+      redirect_to account_settings_path, notice: "Your import has started. We’ll email you when it’s finished."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_params
+      params.expect(data_import: [ :archive ])
+    end
+end
