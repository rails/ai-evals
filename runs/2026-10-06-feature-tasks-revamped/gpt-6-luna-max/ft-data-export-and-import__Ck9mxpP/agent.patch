@@ -0,0 +1,18 @@
+class Account::DataTransfer::ImportJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(data_import)
+    data_import.import_now
+  rescue => error
+    if data_import.imported_account_id.present?
+      Rails.error.report(error, severity: :error)
+    else
+      data_import.fail!(error)
+      Rails.error.report(error, severity: :error)
+    end
+  ensure
+    data_import.archive.purge_later if data_import.archive.attached?
+  end
+end
