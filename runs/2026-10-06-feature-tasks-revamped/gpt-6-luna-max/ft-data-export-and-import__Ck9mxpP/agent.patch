diff --git a/app/models/zip_file/archive_io.rb b/app/models/zip_file/archive_io.rb
new file mode 100644
index 0000000..11623ea
--- /dev/null
+++ b/app/models/zip_file/archive_io.rb
@@ -0,0 +1,102 @@
+class ZipFile::ArchiveIO
+  CACHE_SIZE = 5.megabytes
+
+  def initialize(source)
+    if source.is_a?(ActiveStorage::Blob)
+      @service = source.service
+      @key = source.key
+      @size = source.byte_size
+      @position = 0
+    else
+      @io = source
+    end
+  end
+
+  def size
+    @size || @io.size
+  end
+
+  def tell
+    @position || @io.tell
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    if @io
+      @io.seek(offset, whence)
+    else
+      target = case whence
+      when IO::SEEK_SET then offset
+      when IO::SEEK_CUR then @position + offset
+      when IO::SEEK_END then size + offset
+      else raise ArgumentError, "Invalid seek mode"
+      end
+
+      raise Errno::EINVAL if target.negative?
+
+      @position = target
+      0
+    end
+  end
+
+  def read(length = nil, output_buffer = nil)
+    if @io
+      @io.read(length, output_buffer)
+    else
+      remote_read(length, output_buffer)
+    end
+  end
+
+  private
+    def remote_read(length, output_buffer)
+      length = size - @position if length.nil?
+      raise ArgumentError, "negative length #{length} given" if length.negative?
+
+      result = if length.zero?
+        "".b
+      else
+        read_remote_bytes(length)
+      end
+
+      if output_buffer
+        if result.nil?
+          output_buffer.clear
+          nil
+        else
+          output_buffer.replace(result)
+        end
+      else
+        result
+      end
+    end
+
+    def read_remote_bytes(length)
+      return if @position >= size
+
+      remaining = [ length, size - @position ].min
+      result = String.new(capacity: remaining, encoding: Encoding::BINARY)
+
+      while remaining.positive?
+        load_cache unless cache_covers_position?
+        cache_offset = @position - @cache_start
+        bytes_to_copy = [ remaining, @cache.bytesize - cache_offset ].min
+        raise ZipFile::InvalidArchive, "The ZIP archive is truncated." unless bytes_to_copy.positive?
+
+        result << @cache.byteslice(cache_offset, bytes_to_copy)
+        @position += bytes_to_copy
+        remaining -= bytes_to_copy
+      end
+
+      result
+    end
+
+    def cache_covers_position?
+      @cache && @position >= @cache_start && @position < @cache_start + @cache.bytesize
+    end
+
+    def load_cache
+      @cache_start = (@position / CACHE_SIZE) * CACHE_SIZE
+      last_byte = [ @cache_start + CACHE_SIZE, size ].min - 1
+      @cache = @service.download_chunk(@key, @cache_start..last_byte).to_s.b
+      raise ActiveStorage::FileNotFoundError if @cache.empty?
+    end
+end
diff --git a/app/models/zip_file/entry_io.rb b/app/models/zip_file/entry_io.rb
new file mode 100644
index 0000000..dbdf493
--- /dev/null
+++ b/app/models/zip_file/entry_io.rb
@@ -0,0 +1,112 @@
+class ZipFile::EntryIO
+  COMPRESSED_READ_SIZE = 16.kilobytes
+
+  def initialize(entry, archive_io)
+    @entry = entry
+    @archive_io = archive_io
+    @compressed_read_size = @entry.storage_mode.zero? ? 5.megabytes : COMPRESSED_READ_SIZE
+    rewind
+  end
+
+  def size
+    @entry.uncompressed_size
+  end
+
+  def read(length = nil, output_buffer = nil)
+    length ||= size - @bytes_returned
+    raise ArgumentError, "negative length #{length} given" if length.negative?
+
+    if length.zero?
+      result = "".b
+    else
+      fill_buffer(length)
+      result = if @buffer.empty?
+        nil
+      else
+        @buffer.slice!(0, length)
+      end
+      @bytes_returned += result.bytesize if result
+    end
+
+    if output_buffer
+      if result.nil?
+        output_buffer.clear
+        nil
+      else
+        output_buffer.replace(result)
+      end
+    else
+      result
+    end
+  end
+
+  def readpartial(length, output_buffer = nil)
+    result = read(length, output_buffer)
+    raise EOFError if result.nil?
+    result
+  end
+
+  def rewind
+    @reader = @entry.extractor_from(@archive_io)
+    @buffer = String.new(encoding: Encoding::BINARY)
+    @bytes_decoded = 0
+    @bytes_returned = 0
+    @crc = 0
+    @verified = false
+    0
+  end
+
+  def eof?
+    fill_buffer(1)
+    @buffer.empty? && @verified
+  end
+
+  private
+    def fill_buffer(length)
+      while @buffer.bytesize < length && !@verified
+        if @reader.eof?
+          verify_entry!
+        else
+          inflate_next_chunk
+        end
+      end
+    end
+
+    def inflate_next_chunk
+      chunk = @reader.extract(@compressed_read_size)
+      raise ZipFile::InvalidArchive, "ZIP entry is incomplete" if chunk.nil? && !@reader.eof?
+
+      if chunk.present?
+        @bytes_decoded += chunk.bytesize
+        raise ZipFile::InvalidArchive, "ZIP entry has an invalid size" if @bytes_decoded > size
+
+        @crc = Zlib.crc32(chunk, @crc)
+        @buffer << chunk
+      end
+
+      finish_entry! if @bytes_decoded == size
+      verify_entry! if @reader.eof? && !@verified
+    end
+
+    def finish_entry!
+      until @reader.eof?
+        chunk = @reader.extract(@compressed_read_size)
+        raise ZipFile::InvalidArchive, "ZIP entry is incomplete" if chunk.nil? && !@reader.eof?
+        raise ZipFile::InvalidArchive, "ZIP entry has an invalid size" if chunk.present?
+      end
+
+      verify_entry!
+    end
+
+    def verify_entry!
+      unless @bytes_decoded == size
+        raise ZipFile::InvalidArchive, "ZIP entry has an invalid size"
+      end
+
+      unless @crc == @entry.crc32
+        raise ZipFile::InvalidArchive, "ZIP entry checksum does not match"
+      end
+
+      @verified = true
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..5ea08ba
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,99 @@
+class ZipFile::Reader
+  MAX_ENTRIES = 1_000_000
+  MAX_MANIFEST_SIZE = 1.megabyte
+
+  InvalidArchive = ZipFile::InvalidArchive
+
+  attr_reader :entries
+
+  def initialize(source)
+    @io = ZipFile::ArchiveIO.new(source)
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io)
+
+    if entries.size > MAX_ENTRIES
+      raise InvalidArchive, "The ZIP archive contains too many files."
+    end
+
+    @entries_by_name = entries.index_by do |entry|
+      validate_entry(entry)
+      entry.filename
+    end
+
+    if @entries_by_name.size != entries.size
+      raise InvalidArchive, "The ZIP archive contains duplicate file names."
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD, ArgumentError => error
+    raise InvalidArchive, "The ZIP archive is invalid: #{error.message}"
+  end
+
+  def entry_names
+    @entries_by_name.keys
+  end
+
+  def entry?(path)
+    @entries_by_name.key?(path)
+  end
+
+  def read_json(path)
+    entry = find_entry(path)
+    if entry.uncompressed_size > MAX_MANIFEST_SIZE
+      raise InvalidArchive, "The archive manifest is too large."
+    end
+
+    content = ZipFile::EntryIO.new(entry, @io).read(entry.uncompressed_size)
+    JSON.parse(content.to_s)
+  rescue JSON::ParserError => error
+    raise InvalidArchive, "The archive manifest is not valid JSON: #{error.message}"
+  end
+
+  def each_line(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    entry_io = ZipFile::EntryIO.new(find_entry(path), @io)
+    buffer = String.new(encoding: Encoding::BINARY)
+
+    while chunk = entry_io.read(64.kilobytes)
+      buffer << chunk
+
+      while (newline = buffer.index("\n"))
+        yield buffer.slice!(0, newline + 1).delete_suffix("\n")
+      end
+    end
+
+    yield buffer if buffer.present?
+  end
+
+  def open(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    yield ZipFile::EntryIO.new(find_entry(path), @io)
+  end
+
+  private
+    def find_entry(path)
+      @entries_by_name.fetch(path) do
+        raise InvalidArchive, "The archive is missing #{path}."
+      end
+    end
+
+    def validate_entry(entry)
+      name = entry.filename.to_s
+      path_parts = name.tr("\\", "/").split("/")
+
+      if name.blank? || name.include?("\0") || name.start_with?("/") || name.match?(/\A[A-Za-z]:/)
+        raise InvalidArchive, "The ZIP archive contains an invalid file name."
+      end
+
+      if path_parts.any? { |part| part.blank? || part == "." || part == ".." }
+        raise InvalidArchive, "The ZIP archive contains an invalid file path."
+      end
+
+      if (entry.gp_flags & 0x0001).positive?
+        raise InvalidArchive, "Encrypted ZIP archives are not supported."
+      end
+
+      if entry.uncompressed_size.negative? || entry.compressed_size.negative?
+        raise InvalidArchive, "The ZIP archive contains an invalid file size."
+      end
+    end
+end
