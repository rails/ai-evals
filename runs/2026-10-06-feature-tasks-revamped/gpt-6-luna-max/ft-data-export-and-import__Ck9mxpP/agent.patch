index 0000000..66cbbe4
--- /dev/null
+++ b/test/jobs/account/data_transfer/import_job_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Account::DataTransfer::ImportJobTest < ActiveJob::TestCase
+  test "failed import sends a reason and leaves no new account behind" do
+    data_import = DataImport.new(
+      account: accounts(:"37s"),
+      requested_by: users(:kevin),
+      identity: users(:kevin).identity,
+      requested_by_email: users(:kevin).identity.email_address
+    )
+    data_import.archive.attach(
+      io: StringIO.new("not a zip archive"),
+      filename: "account.zip",
+      content_type: "application/zip"
+    )
+    data_import.save!
+    account_count = Account.count
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      perform_enqueued_jobs do
+        Account::DataTransfer::ImportJob.perform_later(data_import)
+      end
+    end
+
+    assert_equal "failed", data_import.reload.status
+    assert_match "ZIP archive is invalid", data_import.failure_reason
+    assert_equal account_count, Account.count
+    assert_nil data_import.imported_account
+  end
+end
