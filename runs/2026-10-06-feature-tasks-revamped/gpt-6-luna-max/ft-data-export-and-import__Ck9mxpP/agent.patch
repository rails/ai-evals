+  def create_later
+    Account::DataTransfer::ExportJob.perform_later(self)
+  end
+
+  def export_now
+    Current.with(account: account, user: requested_by) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        if account?
+          Account::DataTransfer::Manifest.new(account).export_to(zip)
+        else
+          Account::DataTransfer::CardExporter.new(requested_by).export_to(zip)
+        end
+      end
+
+      update!(status: :ready, ready_at: Time.current)
+      Account::DataTransfer::PurgeExportJob.set(wait: DOWNLOAD_LINK_EXPIRY).perform_later(self)
+      AccountMailer.export_ready(self).deliver_later
+    end
+  end
+
+  def fail!(error)
+    update!(status: :failed, failure_reason: failure_reason_for(error))
+    file.purge_later if file.attached?
+    AccountMailer.export_failed(self).deliver_later
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY)
+  end
+
+  private
+    def filename
+      "fizzy-#{kind}-#{id}.zip"
+    end
+
+    def failure_reason_for(error)
+      error.message.to_s.squish.truncate(500).presence || "The export could not be completed."
+    end
+end
