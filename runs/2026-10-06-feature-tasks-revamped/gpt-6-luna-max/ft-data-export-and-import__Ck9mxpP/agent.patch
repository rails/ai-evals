+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = {
+    "boards" => [ "boards_filters", "board_id", "boards" ],
+    "tags" => [ "filters_tags", "tag_id", "tags" ],
+    "assignees" => [ "assignees_filters", "assignee_id", "users" ],
+    "creators" => [ "creators_filters", "creator_id", "users" ],
+    "closers" => [ "closers_filters", "closer_id", "users" ]
+  }.freeze
+
+  RESOURCE_MODELS = {
+    "boards" => Board,
+    "tags" => Tag,
+    "assignees" => User,
+    "creators" => User,
+    "closers" => User
+  }.freeze
+
+  RESOURCE_PARAMS = {
+    "boards" => "board_ids",
+    "tags" => "tag_ids",
+    "assignees" => "assignee_ids",
+    "creators" => "creator_ids",
+    "closers" => "closer_ids"
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def records
+      Filter.where(account: account)
+    end
+
+    def export_attributes(record)
+      super.merge("filter_resources" => RESOURCES.keys.index_with { |resource| record.public_send(resource).ids })
+    end
+
+    def prepare_import_record(source_record, account:, id_map:)
+      resources = RESOURCES.to_h do |resource, (_, _, resource_table)|
+        destination_ids = source_record.fetch("filter_resources", {}).fetch(resource, []).filter_map do |source_id|
+          id_map.translate_if_present(resource_table, source_id)
+        end
+        [ resource, destination_ids ]
+      end
+
+      row = source_record.dup
+      fields = remap_field_ids!(row, id_map)
+      params = fields.merge(RESOURCE_PARAMS.to_h { |resource, parameter| [ parameter, resources.fetch(resource) ] })
+      row["params_digest"] = Filter.digest_params(params)
+
+      super(row, account:, id_map:).merge(resources: resources)
+    end
+
+    def after_insert_batch(batch, account:, id_map:)
+      batch.each do |record|
+        filter = Filter.find(record.fetch(:attributes).fetch("id"))
+
+        RESOURCES.each_key do |resource|
+          resource_ids = record.fetch(:resources).fetch(resource)
+          next if resource_ids.empty?
+
+          filter.public_send("#{resource}=", RESOURCE_MODELS.fetch(resource).where(id: resource_ids))
+        end
+      end
+    end
+
+    def remap_field_ids!(row, id_map)
+      fields = row["fields"]
+      fields = JSON.parse(fields) if fields.is_a?(String) && fields.present?
+      fields = fields.is_a?(Hash) ? fields.stringify_keys : {}
+
+      { "card_ids" => "cards", "column_ids" => "columns" }.each do |key, table|
+        if fields[key].is_a?(Array)
+          fields[key] = fields[key].filter_map { |id| id_map.translate_if_present(table, id) }
+        end
+      end
+
+      row["fields"] = fields
+      fields
+    rescue JSON::ParserError
+      raise ZipFile::InvalidArchive, "A saved view in the archive contains invalid filter settings."
+    end
+end
