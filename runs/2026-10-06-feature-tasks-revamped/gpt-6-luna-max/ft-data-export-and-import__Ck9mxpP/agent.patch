+
+    get export_download_path(export.download_token, script_name: "")
+
+    assert_response :redirect
+    assert_match "rails/active_storage/disk", response.location
+  end
+
+  test "expired download links cannot be used" do
+    export = create_ready_export
+    token = export.download_token
