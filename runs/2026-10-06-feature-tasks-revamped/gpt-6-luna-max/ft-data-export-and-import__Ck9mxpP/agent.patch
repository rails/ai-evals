index 76411f2..089147d 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -1,11 +1,75 @@
 class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransfer::RecordSet
+  EMBED_BLOB_ID_PREFIX = "fizzy-export-blob:"
+
   def initialize(account)
     super(account: account, model: ::ActionText::RichText)
   end
 
+  def rewrite_imported_embeds(account:, id_map:)
+    records_for_import(account).find_each(batch_size: BATCH_SIZE) do |rich_text|
+      fragment = Nokogiri::HTML.fragment(rich_text.body.to_html)
+      changed = false
+
+      fragment.css(ActionText::Attachment.tag_name).each do |node|
+        source_blob_id, caption = imported_blob_reference(node["caption"])
+        next unless source_blob_id
+
+        blob_id = id_map.translate("active_storage_blobs", source_blob_id)
+        blob = ::ActiveStorage::Blob.find_by!(id: blob_id, account: account)
+        attributes = preserved_attachment_attributes(node, caption: caption)
+        replacement = ActionText::Attachment.from_attachable(blob, attributes).to_html
+        node.replace(replacement)
+        changed = true
+      end
+
+      rich_text.update_columns(body: fragment.to_html) if changed
+    end
+  end
+
   private
     def records
       ::ActionText::RichText.where(account: account)
     end
 
+    def records_for_import(account)
+      ::ActionText::RichText.where(account: account)
+    end
+
+    def export_attributes(record)
+      super.merge("body" => exportable_body(record))
+    end
+
+    def exportable_body(record)
+      fragment = Nokogiri::HTML.fragment(record.body.to_html)
+
+      fragment.css(ActionText::Attachment.tag_name).each do |node|
+        attachable = ActionText::Attachable.from_node(node)
+        if attachable.is_a?(::ActiveStorage::Blob)
+          caption = Base64.urlsafe_encode64(JSON.generate(node["caption"]), padding: false)
+          node["caption"] = "#{EMBED_BLOB_ID_PREFIX}#{attachable.id}:#{caption}"
+        end
+      end
+
+      fragment.to_html
+    end
+
+    def imported_blob_reference(caption)
+      if caption&.start_with?(EMBED_BLOB_ID_PREFIX)
+        source_blob_id, encoded_caption = caption.delete_prefix(EMBED_BLOB_ID_PREFIX).split(":", 2)
+        [ source_blob_id, JSON.parse(Base64.urlsafe_decode64(encoded_caption)) ]
+      end
+    rescue ArgumentError, JSON::ParserError
+      raise ZipFile::InvalidArchive, "An embedded file reference in the archive is invalid."
+    end
+
+    def preserved_attachment_attributes(node, caption:)
+      attributes = node.attribute_nodes.each_with_object({}) do |attribute, attributes|
+        if attribute.name.in?(%w[ presentation content ])
+          attributes[attribute.name] = attribute.value
+        end
+      end
+
+      attributes["caption"] = caption unless caption.nil?
+      attributes
+    end
 end
