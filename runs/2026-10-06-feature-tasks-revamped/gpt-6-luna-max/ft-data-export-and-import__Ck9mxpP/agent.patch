diff --git a/app/models/data_import.rb b/app/models/data_import.rb
new file mode 100644
index 0000000..6c6f76c
--- /dev/null
+++ b/app/models/data_import.rb
@@ -0,0 +1,42 @@
+class DataImport < ApplicationRecord
+  belongs_to :account
+  belongs_to :requested_by, class_name: "User", optional: true
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :archive
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself), default: :pending
+
+  validates :requested_by_email, :status, presence: true
+  validate :archive_must_be_a_zip_file
+
+  def create_later
+    Account::DataTransfer::ImportJob.perform_later(self)
+  end
+
+  def import_now
+    Account::DataTransfer::Importer.new(self).call
+    AccountMailer.import_completed(self).deliver_later
+  end
+
+  def fail!(error)
+    update!(status: :failed, failure_reason: failure_reason_for(error))
+    AccountMailer.import_failed(self).deliver_later
+  end
+
+  private
+    def archive_must_be_a_zip_file
+      if archive.attached?
+        unless archive.filename.extension&.downcase == "zip"
+          errors.add(:archive, "must be a .zip file")
+        end
+      else
+        errors.add(:archive, "must be attached")
+      end
+    end
+
+    def failure_reason_for(error)
+      error.message.to_s.squish.truncate(500).presence || "The import could not be completed."
+    end
+end
