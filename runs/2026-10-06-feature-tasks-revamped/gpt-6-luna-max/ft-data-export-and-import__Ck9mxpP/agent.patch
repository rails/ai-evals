new file mode 100644
index 0000000..b09bcfa
--- /dev/null
+++ b/test/models/account/data_transfer/card_exporter_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::DataTransfer::CardExporterTest < ActiveSupport::TestCase
+  test "card exports include accessible cards, their comments, and attachment files" do
+    user = users(:david)
+    Current.user = user
+    private_card = boards(:private).cards.create!(
+      creator: users(:kevin),
+      title: "Only Kevin can see this",
+      status: "published"
+    )
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    export = Export.for_cards(account: user.account, requested_by: user)
+
+    export.export_now
+
+    reader = ZipFile::Reader.new(export.file.blob)
+    cards = reader.read_json("cards.json")
+    exported_card = cards.find { |attributes| attributes["id"] == card.id }
+
+    assert_equal user.accessible_cards.count, cards.size
+    assert_nil cards.find { |attributes| attributes["id"] == private_card.id }
+    assert_equal card.comments.count, exported_card.fetch("comments").size
+    assert_includes exported_card.fetch("comments").map { |comment| comment["id"] }, comments(:logo_agreement_jz).id
+
+    attachment = exported_card.fetch("attachments").find { |attributes| attributes["filename"] == "moon.jpg" }
+    assert_equal card.image.blob.byte_size, attachment.fetch("byte_size")
+    reader.open(attachment.fetch("path")) do |io|
+      assert_equal File.binread(file_fixture("moon.jpg")), io.read(attachment.fetch("byte_size"))
+    end
+  ensure
+    export&.file&.purge
+  end
+end
diff --git a/test/models/account/data_transfer/manifest_test.rb b/test/models/account/data_transfer/manifest_test.rb
new file mode 100644
index 0000000..e25d4d8
--- /dev/null
+++ b/test/models/account/data_transfer/manifest_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class Account::DataTransfer::ManifestTest < ActiveSupport::TestCase
+  test "account archives include account records and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    tempfile = build_account_archive(accounts(:"37s"))
+    reader = ZipFile::Reader.new(tempfile)
+
+    assert_equal "account", reader.read_json("manifest.json")["type"]
+    card_lines = []
+    reader.each_line("data/cards.jsonl") { |line| card_lines << line }
+    titles = card_lines.map { |line| JSON.parse(line)["title"] }
+    assert_includes titles, "The logo isn't big enough"
+
+    attachment = ActiveStorage::Attachment.find_by!(record: card, name: "image")
+    reader.open("files/#{attachment.blob_id}") do |io|
+      assert_equal File.binread(file_fixture("moon.jpg")), io.read(attachment.blob.byte_size)
+    end
+  ensure
+    tempfile&.close!
+  end
+
+  test "account import rebuilds the account with new record IDs and attached files" do
+    source_account = accounts(:"37s")
+    source_account.entropy.update!(auto_postpone_period: 7.days)
+    source_card = cards(:logo)
+    source_card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    source_comment = comments(:logo_agreement_jz)
+    embedded_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "comment-embed.jpg",
+      content_type: "image/jpeg"
+    )
+    source_comment.update!(body: "<p>#{ActionText::Attachment.from_attachable(embedded_blob).to_html}</p>")
+    source_filter = Filter.find_by!(account: source_account, creator: users(:david))
+    assert_equal [ "mobile" ], source_filter.tags.pluck(:title)
+    tempfile = build_account_archive(source_account)
+    archive_reader = ZipFile::Reader.new(tempfile)
+    rich_text_lines = []
+    archive_reader.each_line("data/action_text_rich_texts.jsonl") { |line| rich_text_lines << JSON.parse(line) }
+    filter_rows = []
+    archive_reader.each_line("data/filters.jsonl") { |line| filter_rows << JSON.parse(line) }
+    exported_filter = filter_rows.find { |filter| filter["id"] == source_filter.id }
+    assert_equal source_filter.tags.ids, exported_filter.fetch("filter_resources").fetch("tags")
+    assert rich_text_lines.any? { |record| record["body"].include?("fizzy-export-blob:") }
+    data_import = create_data_import(tempfile, requested_by: users(:kevin))
+
+    imported_account = Account::DataTransfer::Importer.new(data_import).call
+    assert_equal source_account.name, imported_account.name
+    assert_equal 7.days.to_i, imported_account.entropy.auto_postpone_period
+    assert_not_equal source_account.id, imported_account.id
+
+    assert_equal source_account.cards.count, imported_account.cards.count
+    assert_equal source_account.boards.count, imported_account.boards.count
+    assert_equal source_account.users.count, imported_account.users.count
+    assert_operator imported_account.storage_entries.sum(:delta), :>, 0
+    assert_operator imported_account.bytes_used, :>, 0
+    assert_equal source_card.comments.count, imported_account.cards.find_by!(number: source_card.number).comments.count
+    assert_equal users(:kevin).identity, imported_account.users.find_by!(identity: users(:kevin).identity).identity
+    assert imported_account.users.find_by!(identity: users(:kevin).identity).owner?
+    imported_david = imported_account.users.find_by!(identity: users(:david).identity)
+    source_filter = Filter.find_by!(account: source_account, creator: users(:david))
+    imported_filter = Filter.find_by!(account: imported_account, creator: imported_david)
+    assert_equal source_filter.tags.pluck(:title), imported_filter.tags.pluck(:title)
+    assert_equal source_filter.assignees.map { |user| user.identity.email_address }, imported_filter.assignees.map { |user| user.identity.email_address }
+    assert_equal Filter.digest_params(imported_filter.as_params), imported_filter.params_digest
+    assert_equal "completed", data_import.reload.status
+
+    imported_card = imported_account.cards.find_by!(number: source_card.number)
+    source_event = events(:logo_assignment_jz)
+    imported_event = imported_card.events.find_by!(action: source_event.action, created_at: source_event.created_at)
+    imported_assignee = imported_account.users.find_by!(identity: users(:jz).identity)
+    assert_equal [ imported_assignee.id ], imported_event.assignee_ids
+    assert imported_card.image.attached?
+    assert_equal File.binread(file_fixture("moon.jpg")), imported_card.image.download
+    search_records = Search::Record.for(imported_account.id).where(account_id: imported_account.id)
+    assert search_records.exists?(searchable_type: "Card", searchable_id: imported_card.id)
+    imported_comment = imported_card.comments.find_by!(creator: imported_account.users.find_by!(identity: users(:jz).identity))
+    imported_embed = imported_comment.body.embeds.sole
+    assert_equal File.binread(file_fixture("moon.jpg")), imported_embed.download
+    assert_includes imported_comment.body.body.attachables, imported_embed.blob
+    assert_not_includes imported_comment.body.body.to_html, "fizzy-export-blob:"
+  ensure
+    tempfile&.close!
+    data_import&.archive&.purge
+  end
+
+  test "an import failure after an attachment upload removes the partial account and file" do
+    source_account = accounts(:"37s")
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    embedded_blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "comment-embed.jpg",
+      content_type: "image/jpeg"
+    )
+    comments(:logo_agreement_jz).update!(body: "<p>#{ActionText::Attachment.from_attachable(embedded_blob).to_html}</p>")
+
+    complete_archive = build_account_archive(source_account)
+    incomplete_archive = account_archive_without_last_file(complete_archive)
+    data_import = create_data_import(incomplete_archive, requested_by: users(:kevin))
+    importer = Account::DataTransfer::Importer.new(data_import)
+    account_count = Account.count
+    blob_count = ActiveStorage::Blob.count
+
+    assert_raises(ZipFile::InvalidArchive) { importer.call }
+
+    assert_equal account_count, Account.count
+    assert_equal blob_count, ActiveStorage::Blob.count
+    uploaded_files = importer.instance_variable_get(:@uploaded_files)
+    assert uploaded_files.any?, "The test should fail after uploading an earlier file"
+    uploaded_files.each do |service, key|
+      assert_not service.exist?(key), "Expected #{key} to be cleaned up after rollback"
+    end
+  ensure
+    complete_archive&.close!
+    incomplete_archive&.close!
+    data_import&.archive&.purge
+  end
+
+  test "a corrupt account archive creates no account" do
+    source_account = accounts(:"37s")
+    tempfile = Tempfile.new([ "invalid", ".zip" ])
+    tempfile.write("not a zip")
+    tempfile.rewind
+    data_import = create_data_import(tempfile, requested_by: users(:kevin))
+    account_count = Account.count
+
+    assert_raises(ZipFile::InvalidArchive) do
+      Account::DataTransfer::Importer.new(data_import).call
+    end
+
+    assert_equal account_count, Account.count
+    assert_nil data_import.reload.imported_account
+  ensure
+    tempfile&.close!
+    data_import&.archive&.purge
+  end
+
+  private
+    def build_account_archive(account)
+      tempfile = Tempfile.new([ "account", ".zip" ])
+      tempfile.binmode
+      zip = ZipFile::Writer.new(tempfile)
+      Account::DataTransfer::Manifest.new(account).export_to(zip)
+      zip.close
+      tempfile.rewind
+      tempfile
+    end
+
+    def account_archive_without_last_file(archive)
+      reader = ZipFile::Reader.new(archive)
+      excluded_path = reader.entry_names.select { |path| path.start_with?("files/") }.sort.last
+      tempfile = Tempfile.new([ "incomplete-account", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+
+      reader.entry_names.each do |path|
+        next if path == excluded_path
+
+        writer.add_file(path, compress: !path.start_with?("files/")) do |sink|
+          reader.open(path) do |source|
+            while chunk = source.read(64.kilobytes)
+              sink.write(chunk)
+            end
+          end
+        end
+      end
+
+      writer.close
+      tempfile.rewind
+      tempfile
+    end
+
+    def create_data_import(tempfile, requested_by:)
+      DataImport.new(
+        account: requested_by.account,
+        requested_by: requested_by,
+        identity: requested_by.identity,
+        requested_by_email: requested_by.identity.email_address
+      ).tap do |data_import|
+        data_import.archive.attach(io: File.open(tempfile.path), filename: "account.zip", content_type: "application/zip")
+        data_import.save!
+      end
+    end
+end
