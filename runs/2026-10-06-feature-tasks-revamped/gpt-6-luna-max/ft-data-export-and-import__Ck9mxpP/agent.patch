+class Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  def show
+    export = Export.find_by_download_token(params[:id])
+
+    if export&.ready? && export.file.attached?
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port,
+        script_name: request.script_name
+      }
+
+      redirect_to export.file.blob.url(expires_in: 5.minutes, disposition: :attachment), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+end
