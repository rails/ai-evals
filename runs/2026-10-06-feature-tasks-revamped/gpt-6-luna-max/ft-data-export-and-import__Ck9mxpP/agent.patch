+  def import_files(reader, account:, id_map:, uploaded_files:)
+    expected_paths = []
+
+    id_map.each_mapping(model.table_name) do |source_id, destination_id|
+      blob = model.find_by!(id: destination_id, account: account)
+      entry_path = file_path(source_id)
+      expected_paths << entry_path
+      raise ZipFile::InvalidArchive, "The archive is missing an attachment file." unless reader.entry?(entry_path)
+
+      service = blob.service
+      uploaded_files << [ service, blob.key ]
+
+      reader.open(entry_path) do |io|
+        unless io.size == blob.byte_size
+          raise ZipFile::InvalidArchive, "An attachment in the archive has an invalid size."
+        end
+
+        checksum = checksums_for(io, blob.checksum, service)
+        service.upload(blob.key, io, checksum: checksum, **blob.service_metadata)
+        blob.update!(checksum: checksum)
+      end
+    end
+
+    actual_paths = reader.entry_names.grep(/\Afiles\//)
+    unless actual_paths.sort == expected_paths.sort
+      raise ZipFile::InvalidArchive, "The archive contains attachment files that do not belong to this account."
+    end
+  end
+
   private
     def records
-      ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
+      ::ActiveStorage::Blob.where(id: exported_blob_ids)
+    end
+
+    def exported_blob_ids
+      ::ActiveStorage::Attachment.where(account: account)
+        .where.not(record_type: INTERNAL_RECORD_TYPES)
+        .select(:blob_id)
+    end
+
+    def file_path(blob_id)
+      "files/#{blob_id}"
     end
 
-    def excluded_blob_ids
-      ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
+    def checksums_for(io, source_checksum, service)
+      source_algorithm, expected = if source_checksum.present?
+        source_checksum.include?(":") ? source_checksum.split(":", 2) : [ "md5", source_checksum ]
+      end
+      source_digest = digest_for(source_algorithm) if source_algorithm
+      destination_service = service.respond_to?(:primary) ? service.primary : service
+      destination_algorithm = destination_service.respond_to?(:default_digest_type) ? destination_service.default_digest_type.to_s : "md5"
+      destination_digest = digest_for(destination_algorithm)
+
+      while chunk = io.read(5.megabytes)
+        source_digest&.update(chunk)
+        destination_digest.update(chunk)
+      end
+      io.rewind
+
+      if source_digest && Base64.strict_encode64(source_digest.digest) != expected
+        raise ZipFile::InvalidArchive, "An attachment in the archive failed its checksum check."
+      end
+
+      destination_checksum = Base64.strict_encode64(destination_digest.digest)
+      destination_algorithm == "md5" ? destination_checksum : "#{destination_algorithm}:#{destination_checksum}"
     end
 
+    def digest_for(algorithm)
+      SOURCE_DIGESTS.fetch(algorithm.downcase) do
+        raise ZipFile::InvalidArchive, "An attachment in the archive has an unsupported checksum."
+      end.new
+    end
 end
