diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..8a6afe8
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,81 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+
+  normalizes :endpoint, with: -> { it&.strip }
+
+  before_validation :set_endpoint_sha256
+
+  validates :endpoint, presence: true, length: { maximum: 4096 }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 512 }
+  validates :endpoint_sha256, presence: true, uniqueness: { scope: :user_id }
+
+  validate :validate_endpoint
+
+  class << self
+    def vapid_keys
+      {
+        public_key: ENV["VAPID_PUBLIC_KEY"],
+        private_key: ENV["VAPID_PRIVATE_KEY"]
+      }
+    end
+
+    def vapid_public_key
+      keys = vapid_keys
+      keys[:public_key] if keys.values.all?(&:present?)
+    end
+  end
+
+  def deliver(notification)
+    if PushSubscription.vapid_public_key.present?
+      uri = URI.parse(endpoint)
+      if resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+        deliver_to(uri, resolved_ip, notification)
+      end
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error, ArgumentError, OpenSSL::OpenSSLError, Timeout::Error,
+      SocketError, Resolv::ResolvTimeout, Resolv::ResolvError, SystemCallError => error
+    Rails.logger.warn("Push delivery failed for subscription #{id} (#{error.class})")
+  end
+
+  private
+    def set_endpoint_sha256
+      self.endpoint_sha256 = Digest::SHA256.hexdigest(endpoint) if endpoint.present?
+    end
+
+    def validate_endpoint
+      if endpoint.present?
+        uri = URI.parse(endpoint)
+        unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.port == 443 && uri.fragment.nil?
+          errors.add(:endpoint, "must be an HTTPS push service URL")
+        end
+      end
+    rescue URI::InvalidURIError, TypeError
+      errors.add(:endpoint, "must be a valid URL")
+    end
+
+    def deliver_to(uri, resolved_ip, notification)
+      # Subscription endpoints are client-supplied, so pin the public DNS result to prevent SSRF.
+      request = WebPush::Request.new(
+        message: notification.push_payload.to_json,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: PushSubscription.vapid_keys,
+        ssl_timeout: 5,
+        open_timeout: 5,
+        read_timeout: 5
+      )
+
+      http = Net::HTTP.new(uri.host, uri.port, nil)
+      http.ipaddr = resolved_ip
+      http.use_ssl = true
+      http.ssl_timeout = 5
+      http.open_timeout = 5
+      http.read_timeout = 5
+
+      push_request = Net::HTTP::Post.new(uri.request_uri, request.headers)
+      push_request.body = request.body
+
+      request.send(:verify_response, http.request(push_request))
+    end
+end
