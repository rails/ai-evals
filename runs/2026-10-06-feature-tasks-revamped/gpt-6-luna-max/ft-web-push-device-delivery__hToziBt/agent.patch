diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..947fdcf
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    attributes = push_subscription_params
+    endpoint_sha256 = Digest::SHA256.hexdigest(attributes[:endpoint].to_s.strip)
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint_sha256: endpoint_sha256)
+    was_new_record = @push_subscription.new_record?
+
+    if @push_subscription.update(attributes)
+      render json: { id: @push_subscription.id }, status: was_new_record ? :created : :ok
+    else
+      render json: @push_subscription.errors, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3876a1b
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,147 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = ["toggle", "error", "help", "details"]
+  static values = { publicKey: String, collectionUrl: String }
+
+  #subscription
+  #subscriptionId
+  #busy = false
+
+  async connect() {
+    if (!this.#supported || !this.publicKeyValue) {
+      this.#showHelp(this.publicKeyValue)
+      this.#showError(this.publicKeyValue
+        ? "Push notifications aren't supported by this browser."
+        : "Push notifications aren't configured for this Fizzy instance.")
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      this.#subscription = await registration.pushManager.getSubscription()
+
+      if (this.#subscription) {
+        this.#subscriptionId = await this.#saveSubscription(this.#subscription)
+        this.#setEnabled(true)
+      } else if (Notification.permission === "denied") {
+        this.#showHelp(true)
+      } else {
+        this.#showHelp(false)
+      }
+
+      this.toggleTarget.disabled = false
+    } catch (error) {
+      this.#showError("Couldn't check push notification settings. Please try again.")
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async toggle() {
+    if (this.#busy) return
+
+    this.#busy = true
+    this.toggleTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      if (this.#subscriptionId) {
+        await this.#disableNotifications()
+      } else {
+        await this.#enableNotifications()
+      }
+    } catch (error) {
+      this.#showError("Couldn't update push notification settings. Please try again.")
+    } finally {
+      this.#busy = false
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #enableNotifications() {
+    let permission = Notification.permission
+    if (permission === "default") permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#showHelp(true)
+      if (permission === "denied") {
+        this.#showError("Notifications are blocked. Allow them in your browser or device settings, then try again.")
+      }
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    this.#subscription = await registration.pushManager.getSubscription()
+
+    if (!this.#subscription) {
+      try {
+        this.#subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      } catch (error) {
+        this.#showHelp(true)
+        throw error
+      }
+    }
+
+    this.#subscriptionId = await this.#saveSubscription(this.#subscription)
+    this.#showHelp(false)
+    this.#setEnabled(true)
+  }
+
+  async #disableNotifications() {
+    const response = await destroy(`${this.collectionUrlValue}/${this.#subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Couldn't remove the push subscription")
+
+    const subscription = this.#subscription
+    this.#subscription = null
+    this.#subscriptionId = null
+    this.#setEnabled(false)
+
+    if (subscription) await subscription.unsubscribe()
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.collectionUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (!response.ok) throw new Error("Couldn't save the push subscription")
+    return (await response.json).id
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    this.toggleTarget.textContent = enabled
+      ? "Turn off notifications for this device"
+      : "Turn on notifications for this device"
+    this.#showHelp(!enabled && Notification.permission === "denied")
+    this.errorTarget.hidden = true
+  }
+
+  #showHelp(visible) {
+    this.helpTarget.hidden = !visible
+    this.detailsTargets.forEach(details => details.hidden = !visible)
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  get #supported() {
+    return window.isSecureContext && "serviceWorker" in navigator &&
+      "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = window.atob(base64)
+    return Uint8Array.from(raw, character => character.charCodeAt(0))
+  }
+}
