+    switch_env "VAPID_PUBLIC_KEY", "public-vapid-key" do
+      switch_env "VAPID_PRIVATE_KEY", "private-vapid-key" do
+        get notifications_settings_path
+      end
+    end
+
+    assert_response :success
+    assert_includes response.body, 'data-notifications-public-key-value="public-vapid-key"'
+    assert_not_includes response.body, "private-vapid-key"
+  end
+
+  private
+    def switch_env(key, value)
+      old, ENV[key] = ENV[key], value
+      yield
+    ensure
+      ENV[key] = old
+    end
 end
