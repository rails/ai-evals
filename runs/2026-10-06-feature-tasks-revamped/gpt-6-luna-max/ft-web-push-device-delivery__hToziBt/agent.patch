diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..73ddc1a
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @endpoint = "https://push.example.test/webpush/token"
+    @vapid_key = WebPush.generate_key
+    client_key = OpenSSL::PKey::EC.generate("prime256v1")
+
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: @endpoint,
+      p256dh_key: WebPush.encode64(client_key.public_key.to_octet_string(:uncompressed)),
+      auth_key: WebPush.encode64(SecureRandom.random_bytes(16))
+    )
+  end
+
+  test "sends a VAPID-authenticated payload to the push service" do
+    PushSubscription.stubs(:vapid_keys).returns(
+      public_key: @vapid_key.public_key,
+      private_key: @vapid_key.private_key
+    )
+    SsrfProtection.stubs(:resolve_public_ip).with("push.example.test").returns("93.184.216.34")
+    stub_request(:post, @endpoint).to_return(status: 201)
+
+    @subscription.deliver(@notification)
+
+    assert_requested(:post, @endpoint) do |request|
+      request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.body.present?
+    end
+  end
+
+  test "does not send to a push endpoint that resolves to a private address" do
+    PushSubscription.stubs(:vapid_keys).returns(
+      public_key: @vapid_key.public_key,
+      private_key: @vapid_key.private_key
+    )
+    SsrfProtection.stubs(:resolve_public_ip).with("push.example.test").returns(nil)
+
+    @subscription.deliver(@notification)
+
+    assert_not_requested(:post, @endpoint)
+  end
+
+  test "removes subscriptions that the push service has expired" do
+    PushSubscription.stubs(:vapid_keys).returns(
+      public_key: @vapid_key.public_key,
+      private_key: @vapid_key.private_key
+    )
+    SsrfProtection.stubs(:resolve_public_ip).with("push.example.test").returns("93.184.216.34")
+    stub_request(:post, @endpoint).to_return(status: 410)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+end
