@@ -0,0 +1,25 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.activity.preloaded
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events.reverse_chronologically
+    end
+
+    def creator_ids
+      filter_ids(:creator_ids)
+    end
+
+    def board_ids
+      filter_ids(:board_ids)
+    end
+
+    def filter_ids(name)
+      Array(params[name]).select { |id| id.is_a?(String) && id.present? }
+    end
+end
