diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..650b3cf
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,148 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns flat, newest-first activity using existing API representations" do
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+
+    expected_ids = users(:kevin).accessible_events.activity.reverse_chronologically.pluck(:id)
+    assert_equal expected_ids, activities.map { |activity| activity["id"] }
+
+    comment_event = events(:layout_commented)
+    activity = activities.find { |item| item["id"] == comment_event.id }
+
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ].sort, activity.keys.sort
+    assert_equal comment_event.action, activity["action"]
+    assert_equal comment_event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal comment_event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment_event.eventable.id, activity.dig("eventable", "id")
+    assert_equal comment_event.eventable.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+    assert_equal comment_event.board.id, activity.dig("board", "id")
+    assert_equal comment_event.creator.id, activity.dig("creator", "id")
+    assert_equal card_url(comment_event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(comment_event.eventable)), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    card_event = events(:logo_assignment_jz)
+    card_activity = activities.find { |item| item["id"] == card_event.id }
+    assert_equal card_url(card_event.eventable), card_activity["url"]
+    assert_equal "Card", card_activity["eventable_type"]
+    assert_equal card_event.eventable.id, card_activity.dig("eventable", "id")
+    assert_equal [ users(:jz).id ], card_activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index includes title changes and omits deprecated collection changes" do
+    title_event = events(:text_published)
+    title_event.update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old title", "new_title" => "New title" } }
+    )
+    title_event.eventable.update_column(:title, "New title")
+
+    deprecated_event = events(:layout_published)
+    deprecated_event.update_column(:action, "card_collection_changed")
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    title_activity = activities.find { |activity| activity["id"] == title_event.id }
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, title_activity["particulars"])
+    assert_includes title_activity["description"], "renamed"
+    assert_not_includes activities.map { |activity| activity["id"] }, deprecated_event.id
+  end
+
+  test "particulars include board and triage details with empty values for missing data" do
+    board_event = events(:logo_published)
+    board_event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old board" } })
+
+    triage_event = events(:buy_domain_sent_back_to_triage)
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "Old board", "new_board" => "" }, activities.fetch(board_event.id)["particulars"])
+    assert_equal({ "column" => "" }, activities.fetch(triage_event.id)["particulars"])
+  end
+
+  test "index can filter activity by creators and boards" do
+    get activities_path(format: :json, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ]), as: :json
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_predicate activities, :present?
+    assert activities.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+
+    get activities_path(format: :json, creator_ids: [ users(:jz).id ]), as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index returns only activity on boards the user can access" do
+    board = boards(:private)
+    card = board.cards.create!(creator: users(:kevin), title: "Private card", status: "drafted")
+    event = board.events.create!(eventable: card, creator: users(:kevin), action: "card_published")
+
+    get activities_path(format: :json), as: :json
+    assert_includes @response.parsed_body.map { |activity| activity["id"] }, event.id
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, event.id
+
+    get activities_path(format: :json, board_ids: [ board.id ]), as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index paginates according to the API pagination conventions" do
+    now = Time.current
+    Event.insert_all!(20.times.map do |index|
+      {
+        id: SecureRandom.uuid,
+        account_id: accounts("37s").id,
+        action: "card_closed",
+        board_id: boards(:writebook).id,
+        created_at: now + index.seconds,
+        updated_at: now + index.seconds,
+        creator_id: users(:kevin).id,
+        eventable_id: cards(:logo).id,
+        eventable_type: "Card",
+        particulars: {}
+      }
+    end)
+
+    get activities_path(format: :json), as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.activity.count, @response.headers["X-Total-Count"].to_i
+    assert_equal 15, @response.parsed_body.size
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    assert next_page
+
+    get next_page, as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.activity.count, @response.headers["X-Total-Count"].to_i
+    assert_nil @response.headers["Link"]
+    assert_operator @response.parsed_body.size, :>, 0
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
