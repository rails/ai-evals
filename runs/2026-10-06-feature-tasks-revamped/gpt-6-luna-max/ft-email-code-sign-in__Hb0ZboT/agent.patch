diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..073ebcf
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,85 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+  MAX_ATTEMPTS = 5
+  PURPOSES = %w[ sign_in sign_up join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :code_digest, :expires_at, presence: true
+  validates :failed_attempts, numericality: { only_integer: true, greater_than_or_equal_to: 0 }
+  validate :join_code_matches_purpose
+
+  scope :expired, -> { where("expires_at <= ?", Time.current) }
+
+  attr_accessor :code
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    email_address = Identity.new(email_address: email_address).email_address
+    code = SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+
+    transaction do
+      expired.delete_all
+      where(email_address: email_address, purpose: purpose, join_code_id: join_code&.id).delete_all
+
+      new(
+        email_address: email_address,
+        purpose: purpose,
+        join_code: join_code,
+        code_digest: digest(code),
+        expires_at: LIFETIME.from_now
+      ).tap do |email_code|
+        email_code.code = code
+        email_code.save!
+      end
+    end
+  end
+
+  def consume(candidate)
+    return false unless persisted?
+
+    with_lock do
+      if usable? && code_matches?(candidate)
+        destroy!
+        true
+      else
+        increment!(:failed_attempts) if usable?
+        false
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  def usable?
+    expires_at.future? && failed_attempts < MAX_ATTEMPTS
+  end
+
+  private
+    def code_matches?(candidate)
+      candidate = candidate.to_s
+
+      if candidate.match?(/\A\d{#{CODE_LENGTH}}\z/)
+        ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.send(:digest, candidate))
+      else
+        false
+      end
+    end
+
+    def join_code_matches_purpose
+      if purpose == "join"
+        errors.add(:join_code, :blank) if join_code.nil?
+      elsif join_code.present?
+        errors.add(:join_code, :present)
+      end
+    end
+
+    def self.digest(code)
+      # Use a keyed digest because a six-digit code is easy to brute-force offline.
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+    end
+end
