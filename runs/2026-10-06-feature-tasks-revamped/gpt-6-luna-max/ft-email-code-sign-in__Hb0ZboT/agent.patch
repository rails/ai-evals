new file mode 100644
index 0000000..586ce36
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,28 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_email_code(email_address:, purpose:, session_key:, join_code: nil)
+      email_code = EmailCode.issue(email_address: email_address, purpose: purpose, join_code: join_code)
+      session[session_key] = email_code.id
+
+      IdentityMailer.email_code(email_address: email_code.email_address, code: email_code.code).deliver_later
+
+      email_code
+    end
+
+    def current_email_code(purpose:, session_key:, join_code: nil)
+      if id = session[session_key]
+        EmailCode.find_by(id: id, purpose: purpose, join_code_id: join_code&.id)
+      end
+    end
+
+    def consume_email_code(email_code, session_key:)
+      if email_code&.consume(params[:code])
+        session.delete(session_key)
+        true
+      else
+        false
+      end
+    end
+end
diff --git a/app/controllers/concerns/join_code_membership.rb b/app/controllers/concerns/join_code_membership.rb
