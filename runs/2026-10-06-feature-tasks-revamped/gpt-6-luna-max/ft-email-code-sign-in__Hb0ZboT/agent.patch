+class JoinCodes::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+  include JoinCodeMembership
+
+  allow_unauthenticated_access
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  layout "public"
+
+  def new
+    @email_code = current_email_code(purpose: :join, session_key: email_code_session_key, join_code: @join_code)
+
+    if @email_code.nil?
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "Enter your email address to request a new code."
+    elsif !@email_code.usable?
+      session.delete(email_code_session_key)
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "Your code expired. Enter your email address to get a new one."
+    end
+  end
+
+  def create
+    @email_code = current_email_code(purpose: :join, session_key: email_code_session_key, join_code: @join_code)
+
+    if @email_code && consume_email_code(@email_code, session_key: email_code_session_key)
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+      complete_join(identity)
+    elsif @email_code&.usable?
+      flash.now[:alert] = "That code didn't work. Try again."
+      render :new, status: :unprocessable_entity
+    else
+      session.delete(email_code_session_key)
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "Your code expired. Enter your email address to get a new one."
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code = Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def email_code_session_key
+      "join_email_code_id_#{@join_code.id}"
+    end
+end
