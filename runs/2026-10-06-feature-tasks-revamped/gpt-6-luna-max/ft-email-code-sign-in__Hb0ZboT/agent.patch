@@ -0,0 +1,66 @@
+class Sessions::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_code = current_email_code(purpose: :sign_in, session_key: SESSION_KEY)
+
+    if @email_code.nil?
+      redirect_to new_session_path(script_name: nil), alert: "Enter your email address to request a new code."
+    elsif !@email_code.usable?
+      expire_email_code
+    end
+  end
+
+  def create
+    @email_code = current_email_code(purpose: :sign_in, session_key: SESSION_KEY)
+
+    if @email_code && consume_email_code(@email_code, session_key: SESSION_KEY)
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    elsif @email_code&.usable?
+      invalid_email_code
+    else
+      expire_email_code
+    end
+  end
+
+  private
+    SESSION_KEY = :sign_in_email_code_id
+
+    def invalid_email_code
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn't work. Try again."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def expire_email_code
+      session.delete(SESSION_KEY)
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: "Your code expired. Enter your email address to get a new one." }
+        format.json { render json: { message: "Your code expired. Request a new one." }, status: :gone }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_path(script_name: nil), alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
