diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..2ac8e96
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issue generates a six-digit code with a 15-minute lifetime" do
+    started_at = Time.current
+    email_code = EmailCode.issue(email_address: "NewUser@Example.com", purpose: :sign_up)
+
+    assert_match /\A\d{6}\z/, email_code.code
+    assert_equal "newuser@example.com", email_code.email_address
+    assert_not_equal email_code.code, email_code.code_digest
+    assert_in_delta (started_at + EmailCode::LIFETIME).to_f, email_code.expires_at.to_f, 1
+    assert_predicate email_code, :usable?
+  end
+
+  test "a code can only be consumed once" do
+    email_code = EmailCode.issue(email_address: "newuser@example.com", purpose: :sign_in)
+    code = email_code.code
+
+    assert_not email_code.consume("wrong")
+    assert_equal 1, email_code.reload.failed_attempts
+    assert email_code.consume(code)
+    assert_not email_code.consume(code)
+    assert_not EmailCode.exists?(email_code.id)
+  end
+
+  test "five incorrect attempts make a code unusable" do
+    email_code = EmailCode.issue(email_address: "newuser@example.com", purpose: :sign_in)
+
+    EmailCode::MAX_ATTEMPTS.times { assert_not email_code.consume("wrong") }
+
+    assert_not_predicate email_code, :usable?
+    assert_not email_code.consume(email_code.code)
+  end
+
+  test "expired codes cannot be consumed" do
+    email_code = EmailCode.issue(email_address: "newuser@example.com", purpose: :sign_in)
+    code = email_code.code
+
+    travel EmailCode::LIFETIME + 1.second do
+      assert_not_predicate email_code, :usable?
+      assert_not email_code.consume(code)
+    end
+  end
+end
