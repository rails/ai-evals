+class Signups::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_signup_path, alert: "Try again later." }
+
+  layout "public"
+
+  def new
+    @email_code = current_email_code(purpose: :sign_up, session_key: SESSION_KEY)
+
+    if @email_code.nil?
+      redirect_to new_signup_path, alert: "Enter your email address to request a new code."
+    elsif !@email_code.usable?
+      session.delete(SESSION_KEY)
+      redirect_to new_signup_path, alert: "Your code expired. Enter your email address to get a new one."
+    end
+  end
+
+  def create
+    @email_code = current_email_code(purpose: :sign_up, session_key: SESSION_KEY)
+
+    if @email_code && consume_email_code(@email_code, session_key: SESSION_KEY)
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { head :created }
+      end
+    elsif @email_code&.usable?
+      flash.now[:alert] = "That code didn't work. Try again."
+      render :new, status: :unprocessable_entity
+    else
+      session.delete(SESSION_KEY)
+      redirect_to new_signup_path, alert: "Your code expired. Enter your email address to get a new one."
+    end
+  end
+
+  private
+    SESSION_KEY = :sign_up_email_code_id
+
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
