+# Copy this file to .kamal/secrets (which is ignored by git) and fill in values.
+# Do not commit .kamal/secrets.
+
+# GitHub Container Registry personal access token with read:packages and write:packages.
+KAMAL_REGISTRY_PASSWORD=replace-with-github-token
+
+# Generate a stable value with: openssl rand -hex 64
+SECRET_KEY_BASE=replace-with-a-long-random-secret
+
+# SMTP credentials. Leave empty only if your mail server does not require auth.
+SMTP_USERNAME=replace-with-smtp-username
+SMTP_PASSWORD=replace-with-smtp-password
+
+# Optional for browser push notifications; generate with WebPush.generate_key.
+VAPID_PRIVATE_KEY=
+VAPID_PUBLIC_KEY=
