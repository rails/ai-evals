+service: fizzy
+image: your-github-username/fizzy
+
+servers:
+  web:
+    - your-server.example.com
+
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+registry:
+  server: ghcr.io
+  username: your-github-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+# The OSS production database, Solid Queue, Solid Cache, Solid Cable, and local
+# Active Storage files all live under /rails/storage.
+volumes:
+  - "fizzy-storage:/rails/storage"
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    APP_HOST: fizzy.example.com
+    MAILER_FROM_ADDRESS: "Fizzy <no-reply@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_TLS: "false"
+    SMTP_STARTTLS: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
