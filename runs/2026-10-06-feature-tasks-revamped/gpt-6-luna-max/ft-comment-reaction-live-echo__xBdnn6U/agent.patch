+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "reaction content is limited to sixteen characters" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "1234567890123456")
+
+    assert_predicate reaction, :valid?
+
+    reaction.content = "12345678901234567"
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "emoji-only content is identified for display" do
+    reaction = Reaction.new(content: "👨‍👩‍👧‍👦❤️")
+    assert reaction.emoji_only?
+
+    reaction.content = "Great 👨‍👩‍👧‍👦"
+    assert_not reaction.emoji_only?
+  end
+
+  test "reaction reacter must be from the comment account" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "👍", reacter: users(:mike))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:reacter], "must belong to the comment's account"
+  end
+end
