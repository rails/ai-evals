index 0000000..30e3449
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,39 @@
+class Reaction < ApplicationRecord
+  EMOJI_ONLY = /\A(?:(?:\p{Emoji_Presentation}|\p{Extended_Pictographic}|\p{Regional_Indicator}|\p{Emoji_Modifier}|[#*0-9]\uFE0F?\u20E3)|\uFE0F|\u200D)+\z/u
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  scope :chronologically, -> { order :created_at, :id }
+
+  def emoji_only?
+    content.present? && content.match?(EMOJI_ONLY)
+  end
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validate :account_matches_comment_and_reacter
+
+  after_commit :broadcast_comment_reactions, on: %i[ create destroy ]
+
+  private
+    def account_matches_comment_and_reacter
+      if account && comment && account_id != comment.account_id
+        errors.add(:account, "must match the comment")
+      end
+
+      if reacter && comment && reacter.account_id != comment.account_id
+        errors.add(:reacter, "must belong to the comment's account")
+      end
+    end
+
+    def broadcast_comment_reactions
+      if comment = Comment.find_by(id: comment_id)
+        card = comment.card
+        card.broadcast_replace_later_to card,
+          target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+          partial: "cards/comments/reactions",
+          locals: { comment: comment }
+      end
+    end
+end
