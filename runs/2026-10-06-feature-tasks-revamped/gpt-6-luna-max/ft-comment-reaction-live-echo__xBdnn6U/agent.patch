diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..ac25d39
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,35 @@
+<% reactions = comment.reactions.reject(&:new_record?) %>
+<% reaction = local_assigns[:reaction] || Reaction.new %>
+<% expanded = local_assigns.fetch(:expanded, false) %>
+
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction-form">
+  <div class="reactions__list">
+    <%= render partial: "cards/comments/reaction", collection: reactions, as: :reaction, locals: { comment: comment } %>
+  </div>
+
+  <%= form_with model: reaction, url: card_comment_reactions_path(comment.card, comment),
+        class: class_names("reaction__form flex align-center gap-half", "expanded": expanded), html: { hidden: !expanded || nil },
+        data: { reaction_form_target: "form" } do |form| %>
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "reaction__input input", maxlength: 16, required: true,
+          autocomplete: "off", placeholder: "React…", aria: { label: "Your reaction (16 characters maximum)" },
+          data: { reaction_form_target: "input" } %>
+
+    <% if reaction.errors.any? %>
+      <span class="txt-x-small txt-negative" role="alert"><%= reaction.errors.full_messages.to_sentence %></span>
+    <% end %>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle btn--plain", title: "Confirm reaction", aria: { label: "Confirm reaction" } do %>
+      <%= icon_tag "check" %>
+    <% end %>
+
+    <%= button_tag type: :button, class: "reaction__cancel-btn btn btn--circle btn--plain", title: "Cancel reaction",
+          aria: { label: "Cancel reaction" }, data: { action: "reaction-form#cancel" } do %>
+      <%= icon_tag "close" %>
+    <% end %>
+  <% end %>
+
+  <%= button_tag type: :button, class: "reactions__trigger btn btn--circle", hidden: expanded || nil,
+        aria: { label: "Add a reaction to this comment" }, data: { reaction_form_target: "trigger", action: "reaction-form#open" } do %>
+    <%= image_tag "boost-color.svg", alt: "" %>
+  <% end %>
+</div>
