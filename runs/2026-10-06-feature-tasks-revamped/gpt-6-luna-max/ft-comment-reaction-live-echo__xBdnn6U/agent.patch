+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "add a reaction and remove your own" do
+    comment = comments(:logo_agreement_kevin)
+    sign_in_as(users(:david))
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment, :reactions)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Cancelled")
+      find(".reaction__cancel-btn").click
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__content", text: "Cancelled"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Nice!")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__trigger"
+      assert_selector ".reaction__form[hidden]", visible: :all
+      find(".reaction__content", text: "Nice!").click
+      find(".reaction__delete").click
+
+      assert_no_selector ".reaction__content", text: "Nice!"
+    end
+  end
+end
