diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..8d5aa00
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,60 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :ensure_reaction_ownership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically.includes(:reacter)
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+    @reaction.reacter = Current.user
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { render :create, status: :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reaction_ownership
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..8543d3e
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "content" ]
+  static values = { reacterId: String }
+
+  connect() {
+    const currentUserId = document.querySelector('meta[name="current-user-id"]')?.content
+    this.ownReaction = currentUserId && currentUserId === this.reacterIdValue
+
+    this.contentTarget.setAttribute("aria-disabled", String(!this.ownReaction))
+    this.contentTarget.setAttribute("aria-expanded", "false")
+    if (this.ownReaction) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle() {
+    if (this.ownReaction) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.contentTarget.setAttribute("aria-expanded", String(expanded))
+    }
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
