diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..e8b3eec
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,16 @@
+export function isJapanese() {
+  return currentLanguage() === "ja"
+}
+
+export function currentLocale() {
+  return isJapanese() ? "ja-JP" : "en-US"
+}
+
+export function updateDocumentLanguage() {
+  document.documentElement.lang = currentLanguage()
+}
+
+function currentLanguage() {
+  const language = document.body?.dataset.locale || document.documentElement.lang || "en"
+  return language.split("-")[0]
+}
