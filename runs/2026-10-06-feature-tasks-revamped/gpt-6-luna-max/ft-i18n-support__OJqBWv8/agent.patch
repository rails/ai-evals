diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..74cfc07
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,58 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :with_locale
+    before_action :apply_identity_locale
+  end
+
+  private
+    def with_locale
+      if selected_locale = supported_locale(params[:locale])
+        session[:locale] = selected_locale.to_s
+      end
+
+      identity = Current.identity || session_identity
+      identity_locale = supported_locale(identity&.locale)
+      session[:locale] = identity_locale.to_s if session[:locale].blank? && identity_locale
+      locale = supported_locale(session[:locale]) || identity_locale || I18n.default_locale
+
+      I18n.with_locale(locale) do
+        yield
+      end
+    end
+
+    def apply_identity_locale
+      if Current.identity
+        if locale = supported_locale(session[:locale])
+          save_locale_preference(Current.identity, locale)
+        elsif locale = supported_locale(Current.identity.locale)
+          session[:locale] = locale.to_s
+        end
+      end
+    end
+
+    def restore_identity_locale(identity)
+      if locale = supported_locale(session[:locale])
+        save_locale_preference(identity, locale)
+      elsif locale = supported_locale(identity.locale)
+        session[:locale] = locale.to_s
+      end
+    end
+
+    def save_locale_preference(identity, locale)
+      if locale = supported_locale(locale)
+        identity.update!(locale: locale.to_s) unless identity.locale == locale.to_s
+      end
+    end
+
+    def session_identity
+      if respond_to?(:find_session_by_cookie, true)
+        find_session_by_cookie&.identity
+      end
+    end
+
+    def supported_locale(value)
+      I18n.available_locales.find { |locale| locale.to_s == value.to_s }
+    end
+end
