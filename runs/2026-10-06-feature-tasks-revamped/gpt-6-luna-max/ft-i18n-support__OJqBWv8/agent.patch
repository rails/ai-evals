diff --git a/test/controllers/locales_controller_test.rb b/test/controllers/locales_controller_test.rb
new file mode 100644
index 0000000..c895788
--- /dev/null
+++ b/test/controllers/locales_controller_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class LocalesControllerTest < ActionDispatch::IntegrationTest
+  test "choosing Japanese applies it and persists it on the identity" do
+    sign_in_as :kevin
+
+    get new_board_path(locale: "ja")
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "新しいボードを作成"
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get new_board_path
+
+    assert_select "html[lang='ja']"
+    assert_includes response.body, "新しいボードを作成"
+  end
+
+  test "unsupported locale does not change the selected locale" do
+    sign_in_as :kevin
+
+    get new_board_path(locale: "ja")
+    get new_board_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "locale chosen before sign in is saved on the identity" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang='ja']"
+      assert_includes response.body, "メールアドレス"
+
+      post session_path, params: { email_address: identity.email_address }
+      assert_redirected_to session_magic_link_path
+    end
+
+    assert_equal "ja", identity.reload.locale
+  end
+
+  test "identity locale is restored in a clean browser after sign in" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    browser = open_session
+
+    browser.post "/session", params: { email_address: identity.email_address }
+    assert_equal 302, browser.response.status
+
+    magic_link = identity.magic_links.order(created_at: :desc, id: :desc).first
+    browser.post "/session/magic_link", params: { code: magic_link.code }
+    assert_equal 302, browser.response.status
+
+    browser.get "#{accounts("37s").slug}/boards/new"
+
+    assert_equal 200, browser.response.status
+    assert_match(/<html lang="ja">/, browser.response.body)
+    assert_includes browser.response.body, "新しいボードを作成"
+  end
+
+  test "an unselected identity continues to see the existing English board form" do
+    sign_in_as :kevin
+
+    get new_board_path
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "h1", "Create a new board"
+    assert_select "input[placeholder='Name it…']"
+  end
+
+  test "people without a locale choice continue to see English" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_includes response.body, "Enter your email"
+  end
+
+  test "static error pages always contain English and Japanese" do
+    %w[400.html 404.html 406-unsupported-browser.html 422.html 500.html].each do |filename|
+      page = File.read(Rails.root.join("public", filename))
+
+      assert_includes page, "lang=\"en\"", filename
+      assert_includes page, "lang=\"ja\"", filename
+      assert_match(/<span lang=\"en\">.*?<\/span>/m, page, filename)
