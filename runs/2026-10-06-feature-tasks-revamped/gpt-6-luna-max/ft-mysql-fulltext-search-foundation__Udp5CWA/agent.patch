@@ -0,0 +1,34 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = if @query.present?
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically.includes(:board, :rich_text_description)
+    else
+      Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from @cards
+    @comments_by_card = matching_comments_by_card
+  end
+
+  private
+    def matching_comments_by_card
+      if @query.present? && @page.records.any?
+        matching_texts = ActionText::RichText
+          .where(record_type: Comment.polymorphic_name, name: "body")
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", search_pattern)
+          .select(:record_id)
+
+        Comment.where(card_id: @page.records.map(&:id), id: matching_texts)
+          .with_rich_text_body
+          .order(created_at: :desc, id: :desc)
+          .group_by(&:card_id)
+      else
+        {}
+      end
+    end
+
+    def search_pattern
+      "%#{ActiveRecord::Base.sanitize_sql_like(@query, "!")}%"
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..8a2f693 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -20,6 +20,36 @@ class Card < ApplicationRecord
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
+  scope :search, ->(term) do
+    if term.present?
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term.to_s.strip, "!")}%"
+
+      where(<<~SQL.squish, pattern: pattern, card_type: Card.polymorphic_name, comment_type: Comment.polymorphic_name)
+        cards.title LIKE :pattern ESCAPE '!'
+        OR EXISTS (
+          SELECT 1
+          FROM action_text_rich_texts AS card_descriptions
+          WHERE card_descriptions.record_type = :card_type
+            AND card_descriptions.record_id = cards.id
+            AND card_descriptions.name = 'description'
+            AND card_descriptions.body LIKE :pattern ESCAPE '!'
+        )
+        OR EXISTS (
+          SELECT 1
+          FROM comments
+          INNER JOIN action_text_rich_texts AS comment_bodies
+            ON comment_bodies.record_id = comments.id
+            AND comment_bodies.record_type = :comment_type
+            AND comment_bodies.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_bodies.body LIKE :pattern ESCAPE '!'
+        )
+      SQL
+    else
+      none
+    end
+  end
+
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
   scope :with_users,              -> { preload(creator: [ :avatar_attachment, :account ], assignees: [ :avatar_attachment, :account ]) }
