diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..6706e0e
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "searches titles, descriptions, and comments and highlights matches newest first" do
+    title_card = create_search_card(title: "Needle in the title", created_at: 2.days.ago)
+    description_card = create_search_card(title: "Description result", description: "A needle in the description", created_at: 1.day.ago)
+    comment_card = create_search_card(title: "Comment result", created_at: 2.hours.ago)
+    Current.set(account: accounts("37s"), user: users(:kevin)) do
+      comment_card.comments.create!(creator: users(:kevin), body: "A needle in the comment")
+    end
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_equal [ comment_card, description_card, title_card ].map { card_path(it) },
+      css_select(".search-result__title").map { |link| link["href"] }
+    assert_select "mark", text: /needle/i, count: 3
+  end
+
+  test "only returns cards on boards the user can currently access" do
+    card = Current.set(account: accounts("37s"), user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Confidential needle")
+    end
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(card), count: 0
+  end
+
+  test "does not return draft cards or matches in their comments" do
+    card = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Private draft")
+    comment_id = ActiveRecord::Type::Uuid.generate
+    Comment.insert!({ id: comment_id, account_id: accounts("37s").id, card_id: card.id,
+      creator_id: users(:kevin).id, created_at: Time.current, updated_at: Time.current })
+    ActionText::RichText.create! record: Comment.find(comment_id), account: accounts("37s"), name: "body", body: "Needle in a draft comment"
+
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(card), count: 0
+  end
+
+  test "search treats wildcard characters literally" do
+    literal_match = create_search_card(title: "100% complete", created_at: 1.hour.ago)
+    wildcard_only_match = create_search_card(title: "100x complete", created_at: 30.minutes.ago)
+
+    get search_path(q: "%")
+
+    assert_response :success
+    assert_select ".search-result__title[href=?]", card_path(literal_match), count: 1
+    assert_select ".search-result__title[href=?]", card_path(wildcard_only_match), count: 0
+    assert_select "mark", text: "%", count: 1
+  end
+
+  test "blank search shows no results" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result__title", count: 0
+  end
+
+  private
+    def create_search_card(title:, created_at:, description: nil)
+      Current.set(account: accounts("37s"), user: users(:kevin)) do
+        boards(:writebook).cards.create!(
+          creator: users(:kevin), status: :published, title: title,
+          created_at: created_at, last_active_at: created_at, description: description
+        )
+      end
+    end
+end
