diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..673efd9
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,48 @@
+<% @page_title = "Search cards" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow margin-block-double">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search titles, descriptions, and comments…",
+          autocomplete: "off", autofocus: true, class: "input flex-item-grow" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</div>
+
+<% if @query.present? %>
+  <% if @page.records.any? %>
+    <p class="txt-small txt-tinted">Results for <strong><%= @query %></strong></p>
+
+    <%= with_automatic_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result panel shadow margin-block-end" data-card-number="<%= card.number %>">
+          <h2 class="txt-large margin-none">
+            <%= link_to highlight(card.title, @query), card_path(card), class: "search-result__title", data: { turbo_frame: "_top" } %>
+          </h2>
+
+          <p class="txt-small txt-tinted margin-block-half"><%= link_to card.board.name, board_path(card.board) %></p>
+
+          <% if description_excerpt = excerpt(card.description.to_plain_text, @query, radius: 100) %>
+            <p class="search-result__excerpt"><%= highlight(description_excerpt, @query) %></p>
+          <% end %>
+
+          <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+            <% if comment_excerpt = excerpt(comment.body.to_plain_text, @query, radius: 100) %>
+              <p class="search-result__excerpt txt-tinted"><%= highlight(comment_excerpt, @query) %></p>
+            <% end %>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% else %>
+    <p class="blank-slate">No cards match your search</p>
+  <% end %>
+<% end %>
