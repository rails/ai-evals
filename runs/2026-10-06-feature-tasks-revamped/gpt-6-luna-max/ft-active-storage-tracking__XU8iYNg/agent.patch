diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..33a425d
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "board bytes include card images and embeds on the board, its cards, and comments" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    image = create_blob("card image")
+    board_embed = create_blob("board embed")
+    card_embed = create_blob("card embed")
+    comment_embed = create_blob("comment embed")
+
+    card.image.attach(image)
+    attach_embed(board.public_description, board, board_embed)
+    attach_embed(card.description, card, card_embed)
+    comment = card.comments.create!(body: "A comment", creator: users(:david))
+    attach_embed(comment.body, comment, comment_embed)
+
+    StorageUsage::RecalculateJob.perform_now(board.account_id, [ board.id ])
+
+    expected_bytes = [ image, board_embed, card_embed, comment_embed ].sum(&:byte_size)
+    assert_equal expected_bytes, board.reload.bytes_used
+    assert_equal expected_bytes, board.account.reload.bytes_used
+  end
+
+  test "board usage is isolated while account usage includes all its boards" do
+    board = boards(:writebook)
+    other_board = boards(:private)
+    other_card = other_board.cards.create!(title: "Card on another board", creator: users(:kevin))
+    unrelated_card = cards(:radio)
+    card_image = create_blob("count me")
+    other_board_image = create_blob("count on its board")
+    unrelated_image = create_blob("belongs to another account")
+
+    cards(:logo).image.attach(card_image)
+    other_card.image.attach(other_board_image)
+    unrelated_card.image.attach(unrelated_image)
+
+    StorageUsage::RecalculateJob.perform_now(board.account_id, [ board.id, other_board.id ])
+    StorageUsage::RecalculateJob.perform_now(unrelated_card.account_id, [ unrelated_card.board_id ])
+
+    assert_equal card_image.byte_size, board.reload.bytes_used
+    assert_equal other_board_image.byte_size, other_board.reload.bytes_used
+    assert_equal card_image.byte_size + other_board_image.byte_size, board.account.reload.bytes_used
+    assert_equal unrelated_image.byte_size, unrelated_card.account.reload.bytes_used
+  end
+
+  test "account bytes are the sum of its boards after a board is deleted" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    board.update_column(:bytes_used, 125)
+    boards(:private).update_column(:bytes_used, 75)
+
+    account.calculate_bytes_used_now
+    assert_equal 200, account.reload.bytes_used
+
+    board.destroy!
+    StorageUsage::RecalculateJob.perform_now(account.id)
+
+    assert_equal 75, account.reload.bytes_used
+  end
+
+  test "board recalculations are enqueued in the background" do
+    board = boards(:writebook)
+
+    assert_enqueued_with(job: StorageUsage::RecalculateJob, args: [ board.account_id, [ board.id ] ]) do
+      board.recalculate_bytes_used_later
+    end
+
+    assert_includes ActiveStorage::Attachment._commit_callbacks.map(&:filter), :recalculate_storage_usage_later
+  end
+
+  test "moving a card recalculates usage for both boards" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    image = create_blob("card image")
+    card.image.attach(image)
+
+    StorageUsage::RecalculateJob.perform_now(old_board.account_id, [ old_board.id ])
+    card.update!(board: new_board)
+    StorageUsage::RecalculateJob.perform_now(old_board.account_id, [ old_board.id, new_board.id ])
+
+    assert_equal 0, old_board.reload.bytes_used
+    assert_equal image.byte_size, new_board.reload.bytes_used
+    assert_equal image.byte_size, old_board.account.reload.bytes_used
+  end
+
+  test "removing a rich text embed updates the board and account totals" do
+    board = boards(:writebook)
+    blob = create_blob("embedded file")
+    rich_text = board.public_description
+
+    attach_embed(rich_text, board, blob)
+    assert rich_text.send(:body_change_contains_attachments?)
+    StorageUsage::RecalculateJob.perform_now(board.account_id, [ board.id ])
+    assert_equal blob.byte_size, board.reload.bytes_used
+
+    rich_text.body = "No file"
+    rich_text.save!
+
+    assert rich_text.send(:body_change_contains_attachments?)
+    StorageUsage::RecalculateJob.perform_now(board.account_id, [ board.id ])
+    assert_equal 0, board.reload.bytes_used
+    assert_equal 0, board.account.reload.bytes_used
+  end
+
+  private
+    def create_blob(contents)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(contents),
+        filename: "storage-usage.txt",
+        content_type: "text/plain"
+      )
+    end
+
+    def attach_embed(rich_text, record, blob)
+      rich_text.body = ActionText::Content.new("Attachment").append_attachables(blob)
+      record.save!
+    end
+end
