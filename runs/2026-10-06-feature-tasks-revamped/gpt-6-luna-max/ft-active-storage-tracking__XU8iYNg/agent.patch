--- /dev/null
+++ b/app/jobs/storage_usage/recalculate_job.rb
@@ -0,0 +1,12 @@
+class StorageUsage::RecalculateJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account_id, board_ids = [])
+    Array(board_ids).each do |board_id|
+      Board.find_by(id: board_id, account_id: account_id)&.calculate_bytes_used_now
+    end
+
+    Account.find_by(id: account_id)&.calculate_bytes_used_now
+  end
+end
