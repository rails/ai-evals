@@ -0,0 +1,11 @@
+class StorageUsage::RecalculateAllJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account_id)
+    if account = Account.find_by(id: account_id)
+      account.boards.find_each(&:calculate_bytes_used_now)
+      account.calculate_bytes_used_now
+    end
+  end
+end
