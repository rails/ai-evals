diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..7c4efe5
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,50 @@
+class StorageUsage
+  class << self
+    def recalculate_later(account_id:, board_ids: [])
+      StorageUsage::RecalculateJob.perform_later(account_id, Array(board_ids).compact.uniq)
+    end
+
+    def recalculate_board_now(board)
+      attachments = attachments_for_board(board)
+      bytes_used = ActiveStorage::Blob.where(id: attachments.select(:blob_id))
+        .select("COALESCE(SUM(active_storage_blobs.byte_size), 0)")
+
+      Board.where(id: board.id).update_all(bytes_used: Arel.sql("(#{bytes_used.to_sql})"))
+    end
+
+    def recalculate_account_now(account)
+      board_bytes = Board.where(account_id: account.id).select("COALESCE(SUM(bytes_used), 0)")
+      Account.where(id: account.id).update_all(bytes_used: Arel.sql("(#{board_bytes.to_sql})"))
+    end
+
+    def for_board(board)
+      ActiveStorage::Blob.where(id: attachments_for_board(board).select(:blob_id)).sum(:byte_size)
+    end
+
+    private
+      def attachments_for_board(board)
+        cards = Card.where(board_id: board.id)
+        comments = Comment.where(card_id: cards.select(:id))
+
+        board_descriptions = ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: board.id)
+        card_descriptions = ActionText::RichText.where(record_type: "Card", name: "description", record_id: cards.select(:id))
+        comment_bodies = ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comments.select(:id))
+        rich_texts = board_descriptions.or(card_descriptions).or(comment_bodies)
+
+        card_images = ActiveStorage::Attachment.where(
+          account_id: board.account_id,
+          record_type: "Card",
+          name: "image",
+          record_id: cards.select(:id)
+        )
+        embeds = ActiveStorage::Attachment.where(
+          account_id: board.account_id,
+          record_type: "ActionText::RichText",
+          name: "embeds",
+          record_id: rich_texts.select(:id)
+        )
+
+        card_images.or(embeds)
+      end
+  end
+end
diff --git a/app/models/storage_usage/action_text_rich_text.rb b/app/models/storage_usage/action_text_rich_text.rb
new file mode 100644
index 0000000..502ff78
--- /dev/null
+++ b/app/models/storage_usage/action_text_rich_text.rb
@@ -0,0 +1,33 @@
+module StorageUsage::ActionTextRichText
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :recalculate_storage_usage_later, if: :body_contains_attachments?
+    after_update_commit :recalculate_storage_usage_later, if: :body_change_contains_attachments?
+    after_destroy_commit :recalculate_storage_usage_later, if: :body_contains_attachments?
+  end
+
+  private
+    def recalculate_storage_usage_later
+      case [ record_type, name ]
+      when [ "Board", "public_description" ]
+        StorageUsage.recalculate_later(account_id: account_id, board_ids: [ record_id ])
+      when [ "Card", "description" ]
+        if card = Card.where(id: record_id).pick(:account_id, :board_id)
+          StorageUsage.recalculate_later(account_id: card[0], board_ids: [ card[1] ])
+        end
+      when [ "Comment", "body" ]
+        if comment = Comment.joins(:card).where(id: record_id).pick("comments.account_id", "cards.board_id")
+          StorageUsage.recalculate_later(account_id: comment[0], board_ids: [ comment[1] ])
+        end
+      end
+    end
+
+    def body_contains_attachments?
+      body.to_s.include?("action-text-attachment")
+    end
+
+    def body_change_contains_attachments?
+      saved_change_to_body? && saved_change_to_body.any? { |changed_body| changed_body.to_s.include?("action-text-attachment") }
+    end
+end
diff --git a/app/models/storage_usage/active_storage_attachment.rb b/app/models/storage_usage/active_storage_attachment.rb
new file mode 100644
index 0000000..1e79b32
--- /dev/null
+++ b/app/models/storage_usage/active_storage_attachment.rb
@@ -0,0 +1,53 @@
+module StorageUsage::ActiveStorageAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :recalculate_storage_usage_later, if: :card_image_attachment?
+    after_destroy_commit :recalculate_storage_usage_later, if: :card_image_attachment?
+  end
+
+  private
+    def card_image_attachment?
+      record_type == "Card" && name == "image"
+    end
+
+    def embedded_file_attachment?
+      record_type == "ActionText::RichText" && name == "embeds"
+    end
+
+    def tracked_storage_usage_attachment?
+      card_image_attachment? || embedded_file_attachment?
+    end
+
+    def recalculate_storage_usage_later
+      owner = if card_image_attachment?
+        record
+      elsif embedded_file_attachment?
+        record&.record
+      end
+
+      if owner
+        board_id = case owner
+        when Board then owner.id
+        when Card then owner.board_id
+        when Comment then owner.card&.board_id
+        end
+
+        StorageUsage.recalculate_later(account_id: owner.account_id, board_ids: [ board_id ])
+      end
+    end
+end
+
+module StorageUsage::AttachmentPurge
+  def purge
+    super
+  ensure
+    recalculate_storage_usage_later if destroyed? && tracked_storage_usage_attachment?
+  end
+
+  def purge_later
+    super
+  ensure
+    recalculate_storage_usage_later if destroyed? && tracked_storage_usage_attachment?
+  end
+end
