diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..5616294
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "issues a six digit code, sends it in the subject, and consumes it once" do
+    email_code = nil
+
+    perform_enqueued_jobs do
+      email_code = EmailCode.issue_for(email_address: "Person@example.com", purpose: :sign_in)
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    code = email.subject[/\d{#{EmailCode::CODE_LENGTH}}/]
+
+    assert_equal "person@example.com", email_code.email_address
+    assert_equal [ "person@example.com" ], email.to
+    assert_match code, email.subject
+    assert_match code, email.body.encoded
+    assert_not_equal code, email_code.code_digest
+    assert_in_delta 15.minutes, email_code.expires_at - email_code.created_at, 1
+
+    assert email_code.consume(code)
+    assert_not email_code.consume(code)
+  end
+
+  test "a newer code invalidates any previous code for the same address" do
+    SecureRandom.stubs(:random_number).returns(123456, 654321)
+
+    previous = EmailCode.issue_for(email_address: "person@example.com", purpose: :sign_in)
+    current = EmailCode.issue_for(email_address: "person@example.com", purpose: :signup)
+
+    assert_not previous.consume("123456")
+    assert current.consume("654321")
+  end
+end
