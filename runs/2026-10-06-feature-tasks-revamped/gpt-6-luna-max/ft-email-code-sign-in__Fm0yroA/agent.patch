+++ b/app/controllers/email_codes_controller.rb
@@ -0,0 +1,143 @@
+class EmailCodesController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_code = pending_email_code
+
+    if @email_code
+      set_email_code_view_attributes
+      flash.now[:alert] = "That code has expired. Request a new one to continue." if @email_code.expired?
+    else
+      redirect_to new_session_path, alert: "Request a new code to continue."
+    end
+  end
+
+  def create
+    @email_code = pending_email_code
+
+    if @email_code&.consume(params[:code])
+      session.delete(:email_code_id)
+      complete_email_code_sign_in
+    elsif @email_code
+      set_email_code_view_attributes
+      flash.now[:alert] = if @email_code.expired?
+        "That code has expired. Request a new one to continue."
+      else
+        "That code did not work. Check it and try again."
+      end
+      render :new, status: :unprocessable_entity
+    else
+      redirect_to new_session_path, alert: "Request a new code to continue."
+    end
+  end
+
+  private
+    def pending_email_code
+      EmailCode.find_by(id: session[:email_code_id])
+    end
+
+    def set_email_code_view_attributes
+      @email_entry_path = email_entry_path
+      @continuation_description = case @email_code.purpose
+      when "signup"
+        "Use this code to continue signing up."
+      when "join"
+        "Use this code to join #{@email_code.join_code&.account&.name || 'your account'}."
+      else
+        "Use this code to sign in."
+      end
+    end
+
+    def email_entry_path
+      case @email_code.purpose
+      when "signup"
+        new_signup_path(signup: { email_address: @email_code.email_address }, script_name: nil)
+      when "join"
+        if @email_code.join_code
+          join_path(
+            code: @email_code.join_code_code,
+            email_address: @email_code.email_address,
+            script_name: @email_code.join_code.account.slug
+          )
+        else
+          new_session_path(email_address: @email_code.email_address, script_name: nil)
+        end
+      else
+        new_session_path(email_address: @email_code.email_address, script_name: nil)
+      end
+    end
+
+    def complete_email_code_sign_in
+      case @email_code.purpose
+      when "signup"
+        complete_signup
+      when "join"
+        complete_join
+      else
+        complete_sign_in
+      end
+    end
+
+    def complete_sign_in
+      if identity = Identity.find_by(email_address: @email_code.email_address)
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to new_signup_path, alert: "We couldn't find an account for that email address. Sign up to get started." }
+          format.json { render json: { message: "We couldn't find an account for that email address." }, status: :not_found }
+        end
+      end
+    end
+
+    def complete_signup
+      identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { render json: { session_token: session_token }, status: :created }
+      end
+    end
+
+    def complete_join
+      if @email_code.join_code_active?
+        identity = Identity.find_or_create_by!(email_address: @email_code.email_address)
+        join_code = @email_code.join_code
+        user = join_code.redeem_for(identity)
+
+        if user
+          start_new_session_for identity
+          redirect_after_join(user, join_code.account)
+        else
+          redirect_to join_path(code: @email_code.join_code_code, script_name: join_code.account.slug),
+            alert: "That join code is no longer active."
+        end
+      else
+        redirect_to new_session_path, alert: "That join code is no longer active."
+      end
+    end
+
+    def redirect_after_join(user, account)
+      if user.setup?
+        redirect_to landing_url(script_name: account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: account.slug)
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_email_code_path(script_name: nil), alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
