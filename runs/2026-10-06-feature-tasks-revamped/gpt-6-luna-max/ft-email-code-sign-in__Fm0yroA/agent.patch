+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "signing in by email sends a code that creates a session" do
+    identity = identities(:kevin)
+    code = request_code(session_path(script_name: nil), { email_address: identity.email_address })
+    email = ActionMailer::Base.deliveries.last
+
+    assert_match code, email.subject
+    assert_match code, email.body.encoded
+    assert_equal [ identity.email_address ], email.to
+
+    untenanted do
+      get new_email_code_path(script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "input[name=code][autocomplete='one-time-code'][maxlength='6']"
+
+    assert_difference -> { Session.count }, 1 do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_response :redirect
+    assert cookies[:session_token].present?
+    assert EmailCode.find_by!(email_address: identity.email_address).used_at.present?
+  end
+
+  test "invalid code can be retried and a code expires after fifteen minutes" do
+    code = request_code(session_path(script_name: nil), { email_address: identities(:kevin).email_address })
+
+    untenanted do
+      get new_email_code_path(script_name: nil)
+      post email_code_path(script_name: nil), params: { code: "ABC123" }
+    end
+
+    assert_response :unprocessable_entity
+    assert_in_body "That code did not work"
+    assert_not cookies[:session_token].present?
+
+    travel 15.minutes + 1.second do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: code }
+      end
+
+      assert_response :unprocessable_entity
+      assert_in_body "That code has expired"
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "unknown sign-in email is not created after code verification" do
+    email_address = "unknown@example.com"
+    code = request_code(session_path(script_name: nil), { email_address: email_address })
+
+    assert_no_difference -> { Identity.count } do
+      untenanted do
+        post email_code_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_signup_path(script_name: nil)
+  end
+
+  test "signing up with an email code continues to account setup" do
+    email_address = "new-signup@example.com"
+    code = request_code(signup_path(script_name: nil), { signup: { email_address: email_address } })
+
+    assert_not Identity.exists?(email_address: email_address)
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to new_signup_completion_path(script_name: nil)
+    assert Identity.exists?(email_address: email_address)
+    assert cookies[:session_token].present?
+
+    untenanted do
+      post signup_completion_path(script_name: nil), params: { signup: { full_name: "New Person" } }
+    end
+
+    assert_response :redirect
+    assert_equal "New Person", Identity.find_by!(email_address: email_address).users.last.name
+  end
+
+  test "joining with an email code creates the membership" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "new-member@example.com"
+    request_code(join_path(code: join_code.code, script_name: account.slug), { email_address: email_address })
+    code = ActionMailer::Base.deliveries.last.subject[/\d{6}/]
+
+    assert_not Identity.exists?(email_address: email_address)
+
+    untenanted do
+      post email_code_path(script_name: nil), params: { code: code }
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    assert User.exists?(account: account, identity: identity)
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+  end
+
+  private
+    def request_code(path, params)
+      perform_enqueued_jobs do
+        post path, params: params
+      end
+
+      assert_response :redirect
+      code = ActionMailer::Base.deliveries.last&.subject&.match(/\b\d{#{EmailCode::CODE_LENGTH}}\b/)&.to_s
+      assert code, "Expected the email subject to contain a six-character code"
+      code
+    end
+end
