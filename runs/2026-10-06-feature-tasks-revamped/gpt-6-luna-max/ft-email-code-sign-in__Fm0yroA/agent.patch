diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..800a804
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,71 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+  PURPOSES = %w[ sign_in signup join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code_digest, :expires_at, presence: true
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+
+  def self.issue_for(email_address:, purpose:, join_code: nil)
+    code = SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+    normalized_email_address = Identity.new(email_address: email_address).email_address
+
+    email_code = transaction do
+      where("expires_at <= :now OR email_address = :email_address", now: Time.current, email_address: normalized_email_address).delete_all
+      create!(
+        email_address: normalized_email_address,
+        code_digest: digest_for(code),
+        expires_at: LIFETIME.from_now,
+        purpose: purpose.to_s,
+        join_code: join_code,
+        join_code_code: join_code&.code
+      )
+    end
+
+    IdentityMailer.authentication_code(email_address: normalized_email_address, code: code).deliver_later
+    email_code
+  end
+
+  def consume(code)
+    with_lock do
+      if usable? && code_matches?(code)
+        update!(used_at: Time.current)
+        true
+      else
+        false
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def usable?
+    !used_at? && !expired?
+  end
+
+  def join_code_active?
+    join_code.present? && join_code.code == join_code_code && join_code.active?
+  end
+
+  private
+    def code_matches?(code)
+      code = code.to_s.strip
+
+      code.match?(/\A\d{#{CODE_LENGTH}}\z/) &&
+        ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest_for(code))
+    end
+
+    def self.digest_for(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+    end
+end
diff --git a/app/views/email_codes/new.html.erb b/app/views/email_codes/new.html.erb
new file mode 100644
index 0000000..1d0d8d9
--- /dev/null
+++ b/app/views/email_codes/new.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p>We sent a six-character code to <strong><%= @email_code.email_address %></strong>.</p>
+  <p><%= @continuation_description %> The code expires in 15 minutes.</p>
+
+  <%= form_with url: email_code_path(script_name: nil), class: "flex flex-column gap-half txt-medium", data: { turbo: false, controller: "form" } do |form| %>
+    <label class="flex flex-column gap-half">
+      <strong>Your code</strong>
+      <%= form.text_field :code,
+            required: true,
+            autofocus: true,
+            autocomplete: "one-time-code",
+            inputmode: "numeric",
+            pattern: "[0-9]{6}",
+            maxlength: EmailCode::CODE_LENGTH,
+            class: "input txt-large full-width",
+            placeholder: "Enter your six-character code" %>
+    </label>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Use a different email address", @email_entry_path, class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
