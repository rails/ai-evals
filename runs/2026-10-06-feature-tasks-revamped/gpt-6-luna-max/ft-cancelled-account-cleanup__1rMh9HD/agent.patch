diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..fe22abf
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts canceled beyond the grace period and all their data" do
+    due_account = create_account("Due for incineration", cancelled_at: 31.days.ago)
+    owner = due_account.users.find_by!(role: :owner)
+    identity_id = owner.identity_id
+
+    board = due_account.boards.create!(name: "Board", creator: owner)
+    card = Current.set(account: due_account, user: owner) do
+      board.cards.create!(title: "Published card", creator: owner, status: :published)
+    end
+    search_record = Search::Record.for(due_account.id).find_by!(searchable_type: "Card", searchable_id: card.id)
+    blob = Current.set(account: due_account, user: owner) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("account data"),
+        filename: "card.txt",
+        content_type: "text/plain",
+        identify: false
+      )
+    end
+    card.image.attach(blob)
+    attachment_id = card.image_attachment.id
+    blob_id = blob.id
+    import = Account::Import.create!(account: due_account, identity: identities(:david))
+    storage_entry = Storage::Entry.create!(account: due_account, delta: 1, operation: "reproduction")
+
+    recent_account = create_account("Recently canceled", cancelled_at: 29.days.ago)
+    active_account = create_account("Still active")
+
+    Current.without_account do
+      perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert_not Account::Cancellation.exists?(account_id: due_account.id)
+    assert_not Account::JoinCode.exists?(account_id: due_account.id)
+    assert_not User.exists?(account_id: due_account.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert_not Search::Record.for(due_account.id).exists?(search_record.id)
+    assert_not ActiveStorage::Attachment.exists?(attachment_id)
+    assert_not ActiveStorage::Blob.exists?(blob_id)
+    assert_not Account::Import.exists?(import.id)
+    assert_not Storage::Entry.exists?(storage_entry.id)
+    assert Identity.exists?(identity_id), "Shared identity data should be preserved"
+
+    assert Account.exists?(recent_account.id), "Recently canceled accounts should be retained"
+    assert Account.exists?(active_account.id), "Active accounts should be retained"
+  end
+
+  test "does not incinerate an account exactly at the grace-period boundary" do
+    travel_to Time.current do
+      account = create_account("At the grace-period boundary", cancelled_at: 30.days.ago)
+
+      Current.without_account do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert Account.exists?(account.id)
+    end
+  end
+
+  test "does not incinerate a reactivated account" do
+    account = create_account("Reactivated", cancelled_at: 31.days.ago)
+    account.reactivate
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+    assert_not account.reload.cancelled?
+  end
+
+  private
+    def create_account(name, cancelled_at: nil)
+      account = Account.create_with_owner(
+        account: { name: name },
+        owner: { identity: identities(:david), name: "David" }
+      )
+
+      if cancelled_at
+        account.create_cancellation!(initiated_by: account.users.find_by!(role: :owner), created_at: cancelled_at)
+      end
+
+      account
+    end
+end
