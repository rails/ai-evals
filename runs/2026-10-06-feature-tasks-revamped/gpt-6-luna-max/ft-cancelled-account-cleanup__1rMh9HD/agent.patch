diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..afade93 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,28 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineratable, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineratable.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if incineration_due?
+        destroy!
+      end
+    end
+  end
+
+  private
+    def incineration_due?
+      cancellation&.created_at&.before?(INCINERATION_GRACE_PERIOD.ago)
+    end
 end
