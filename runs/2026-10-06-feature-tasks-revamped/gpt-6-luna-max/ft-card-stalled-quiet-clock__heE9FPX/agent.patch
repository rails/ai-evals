diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..8ce0bbd
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,44 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  INACTIVITY_PERIOD = 2.weeks
+  COMMENTS_FOR_BURST = 3
+  COMMENTERS_FOR_BURST = 2
+
+  included do
+    scope :stalled, ->(as_of = Time.current) do
+      where.not(burst_at: nil).where(last_active_at: ..(as_of - INACTIVITY_PERIOD))
+    end
+  end
+
+  def stalled?(as_of: Time.current)
+    burst_at.present? && last_active_at <= as_of - INACTIVITY_PERIOD
+  end
+
+  def record_burst!
+    update!(burst_at: last_active_at || Time.current) if burst_at.nil?
+  end
+
+  def record_comment_burst!(comment)
+    unless comment.creator.system? || burst_at.present?
+      window_start = comment.created_at - board.auto_postpone_period / 3
+      recent_comments = comments.by_user.where(created_at: window_start..comment.created_at)
+
+      commenter_counts = recent_comments.group(:creator_id).count
+      if commenter_counts.size >= COMMENTERS_FOR_BURST && commenter_counts.values.sum >= COMMENTS_FOR_BURST
+        record_burst!
+      end
+    end
+  end
+
+  # Time-based stalled status must invalidate cached views when the inactivity cutoff passes.
+  def cache_version
+    version = super
+
+    if burst_at.present?
+      "#{version}/#{stalled?}"
+    else
+      version
+    end
+  end
+end
