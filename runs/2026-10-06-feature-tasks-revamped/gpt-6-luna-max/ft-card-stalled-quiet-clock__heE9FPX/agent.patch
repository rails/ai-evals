diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..7766832
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the auto-close period create a burst" do
+    card = published_card
+    window = card.board.auto_postpone_period.seconds / 3
+    start = Time.current
+
+    travel_to start do
+      card.comments.create!(body: "First", creator: users(:david))
+    end
+    travel_to start + window / 2 do
+      card.comments.create!(body: "Second", creator: users(:kevin))
+    end
+    travel_to start + window - 1.second do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert card.reload.burst_at
+    assert_not card.stalled?
+  end
+
+  test "comments by only one person do not create a burst" do
+    card = published_card
+    start = Time.current
+
+    3.times do |index|
+      travel_to start + index.hours do
+        card.comments.create!(body: "Comment #{index}", creator: users(:david))
+      end
+    end
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "comments outside the auto-close window do not create a burst" do
+    card = published_card
+    window = card.board.auto_postpone_period.seconds / 3
+    start = Time.current
+
+    travel_to start do
+      card.comments.create!(body: "First", creator: users(:david))
+    end
+    travel_to start + window do
+      card.comments.create!(body: "Second", creator: users(:kevin))
+    end
+    travel_to start + window + 1.second do
+      card.comments.create!(body: "Third", creator: users(:david))
+    end
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "assignment and reopening create bursts" do
+    assigned_card = published_card
+    assigned_card.toggle_assignment(users(:kevin))
+    assert assigned_card.reload.burst_at
+
+    reopened_card = published_card
+    reopened_card.close
+    reopened_card.reopen
+    assert reopened_card.reload.burst_at
+  end
+
+  test "a burst becomes stalled after two inactive weeks and any activity resets the timer" do
+    card = published_card
+    card.toggle_assignment(users(:kevin))
+    last_active_at = card.reload.last_active_at
+
+    travel_to last_active_at + 2.weeks - 1.second do
+      assert_not card.reload.stalled?
+    end
+    travel_to last_active_at + 2.weeks + 1.second do
+      assert card.reload.stalled?
+    end
+
+    travel_to last_active_at + 3.weeks do
+      card.comments.create!(body: "Back to work", creator: users(:david))
+      assert_not card.reload.stalled?
+    end
+
+    last_active_at = card.reload.last_active_at
+    travel_to last_active_at + 2.weeks + 1.second do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "system comments do not count toward a comment burst" do
+    card = published_card
+    card.comments.create!(body: "System note", creator: users(:system))
+    card.comments.create!(body: "First", creator: users(:david))
+    card.comments.create!(body: "Second", creator: users(:kevin))
+
+    assert_nil card.reload.burst_at
+  end
+
+  test "a card cache version changes when it becomes stalled" do
+    card = published_card
+    now = Time.current
+    card.update_columns(burst_at: now, last_active_at: now)
+    recent_cache_version = card.cache_version
+
+    travel_to now + 2.weeks + 1.second do
+      assert_not_equal recent_cache_version, card.cache_version
+    end
+  end
+
+  test "the stalled index includes cards that had a burst and have been inactive for two weeks" do
+    card = published_card
+    card.update_columns(burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago)
+    filter = users(:david).filters.new(indexed_by: "stalled")
+
+    assert_includes filter.cards, card
+  end
+
+  private
+    def published_card
+      boards(:writebook).cards.create!(title: "Stallable card", status: "published", creator: users(:david))
+    end
+end
