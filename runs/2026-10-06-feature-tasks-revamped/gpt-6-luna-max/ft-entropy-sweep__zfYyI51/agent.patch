+  test "board due cards use the effective entropy period in a board-scoped query" do
+    freeze_time
+
+    board = boards(:writebook)
+    due_card = cards(:logo)
+    due_card.update! last_active_at: Time.current - board.auto_postpone_period - 1.day
+
+    relation = board.cards_due_to_be_postponed(as_of: Time.current)
+
+    assert_includes relation, due_card
+    assert_match(/last_active_at/, relation.to_sql)
+    assert_no_match(/entropies/, relation.to_sql)
+
+    connection = ActiveRecord::Base.connection
+    if connection.adapter_name == "SQLite"
+      batch_query = relation.where(Card.arel_table[:id].gt(due_card.id)).order(:id).limit(1000)
+      query_plan = connection.execute("EXPLAIN QUERY PLAN #{batch_query.to_sql}").map { |row| row["detail"] }.join("\n")
+
+      assert_includes query_plan, "index_cards_on_board_id_and_id_and_status_and_last_active_at"
+      assert_no_match(/USE TEMP B-TREE/, query_plan)
+    end
+  end
+
