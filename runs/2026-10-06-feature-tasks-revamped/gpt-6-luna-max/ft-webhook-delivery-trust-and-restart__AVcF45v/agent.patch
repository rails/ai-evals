 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  def self.cleanup
+    where(arel_table[:created_at].lt(RETENTION_PERIOD.ago)).delete_all
+  end
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +17,24 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    if claim_for_delivery
+      reload
+
+      if webhook.active?
+        deliver
+      else
+        update!(state: :errored, response: { error: "webhook_inactive" })
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +52,110 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def deliver
+      if request = prepare_request
+        body, headers = request
+
+        begin
+          http_response = post(body, headers)
+        rescue StandardError
+          record_error
+        else
+          record_response(http_response)
+        end
+      end
+    end
+
+    def prepare_request
+      body = request_body
+      headers = request_headers(body)
+      update!(request: { headers: headers })
+      [ body, headers ]
+    rescue StandardError
+      record_error("payload_generation_failed", count_toward_delinquency: false)
+      nil
+    end
+
+    def request_body
+      if webhook.for_slack?
+        { text: event_text }.to_json
+      elsif webhook.for_basecamp?
+        URI.encode_www_form(content: event_text)
+      elsif webhook.for_campfire?
+        URI.encode_www_form("message[body]" => event_text)
+      else
+        renderer.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event }, layout: false)
+      end
+    end
+
+    def event_text
+      renderer.render(template: "webhooks/event", formats: [ :html ], assigns: { event: event }, layout: false).strip
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: account.slug)
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def content_type
+      if webhook.for_basecamp? || webhook.for_campfire?
+        "application/x-www-form-urlencoded"
+      else
+        "application/json"
+      end
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      request = Net::HTTP::Post.new(uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10
+      http.max_retries = 0
+
+      http.start { |connection| connection.request(request) }
+    end
+
+    def record_response(http_response)
+      Webhook::Delivery.transaction do
+        update!(
+          state: :completed,
+          response: { code: http_response.code.to_i, headers: http_response.to_hash }
+        )
+
+        if succeeded?
+          webhook.delinquency_tracker.record_success
+        else
+          webhook.delinquency_tracker.record_failure
+        end
+      end
+    end
+
+    def record_error(error = "destination_unreachable", count_toward_delinquency: true)
+      Webhook::Delivery.transaction do
+        update!(state: :errored, response: { error: error })
+        webhook.delinquency_tracker.record_failure if count_toward_delinquency
+      end
+    end
 end
