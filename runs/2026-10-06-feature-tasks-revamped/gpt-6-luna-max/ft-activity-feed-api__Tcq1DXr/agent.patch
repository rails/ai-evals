diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..ce9e432
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,166 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns flat activity with API representations and card destinations" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+
+    card_event = events(:logo_assignment_km)
+    card_activity = activities.find { |activity| activity["id"] == card_event.id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], card_activity.keys.sort
+    assert_equal card_event.description_for(users(:kevin)).to_plain_text, card_activity["description"]
+    assert_equal card_url(cards(:logo)), card_activity["url"]
+    assert_equal "Card", card_activity["eventable_type"]
+    assert_equal cards(:logo).id, card_activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, card_activity.dig("board", "id")
+    assert_equal users(:david).id, card_activity.dig("creator", "id")
+    assert_equal [ users(:kevin).id ], card_activity.dig("particulars", "assignee_ids")
+
+    comment = comments(:layout_overflowing_david)
+    comment_activity = activities.find { |activity| activity["id"] == events(:layout_commented).id }
+    assert_equal events(:layout_commented).description_for(users(:kevin)).to_plain_text, comment_activity["description"]
+    assert_equal "Comment", comment_activity["eventable_type"]
+    assert_equal comment.id, comment_activity.dig("eventable", "id")
+    assert_equal comment.card.id, comment_activity.dig("eventable", "card", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), comment_activity["url"]
+    assert_equal({}, comment_activity["particulars"])
+  end
+
+  test "index includes title changes, omits deprecated collection changes, and normalizes particulars" do
+    title_event = events(:layout_published)
+    title_event.update_columns(action: "card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+
+    missing_title_event = events(:text_published)
+    missing_title_event.update_columns(action: "card_title_changed", particulars: {})
+
+    board_event = events(:logo_assignment_jz)
+    board_event.update_columns(action: "card_board_changed", particulars: { particulars: { old_board: "Old board", new_board: "New board" } })
+
+    missing_board_event = events(:shipping_closed)
+    missing_board_event.update_columns(action: "card_board_changed", particulars: {})
+
+    triage_event = events(:buy_domain_sent_back_to_triage)
+    triage_event.update_columns(action: "card_triaged", particulars: { particulars: { column: "In progress" } })
+
+    missing_column_event = events(:logo_assignment_david)
+    missing_column_event.update_columns(action: "card_sent_back_to_triage", particulars: {})
+
+    legacy_event = events(:logo_published)
+    legacy_event.update_column(:action, "card_collection_changed")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+
+    assert_includes activities.keys, title_event.id
+    assert_not_includes activities.keys, legacy_event.id
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activities.dig(title_event.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(missing_title_event.id, "particulars"))
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activities.dig(board_event.id, "particulars"))
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.dig(missing_board_event.id, "particulars"))
+    assert_equal({ "column" => "In progress" }, activities.dig(triage_event.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(missing_column_event.id, "particulars"))
+    assert_equal({}, activities.dig(events(:layout_commented).id, "particulars"))
+  end
+
+  test "index filters by creator and board" do
+    private_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :drafted)
+    private_event = Event.create!(
+      board: boards(:private), eventable: private_card, creator: users(:kevin), action: "card_published"
+    )
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ] }
+
+    assert_response :success
+    creator_activities = @response.parsed_body
+    assert_not_empty creator_activities
+    assert creator_activities.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    board_activities = @response.parsed_body
+    assert_not_empty board_activities
+    assert board_activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+    assert_not_includes board_activities.map { |activity| activity["id"] }, private_event.id
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ],
+      board_ids: [ boards(:writebook).id ]
+    }
+
+    assert_response :success
+    filtered_activities = @response.parsed_body
+    assert_not_empty filtered_activities
+    assert filtered_activities.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert filtered_activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index only returns activity on boards the current user can access" do
+    private_card = boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :drafted)
+    private_event = Event.create!(
+      board: boards(:private), eventable: private_card, creator: users(:kevin), action: "card_published"
+    )
+
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_not_includes activities.pluck("id"), private_event.id
+    assert activities.all? { |activity| users(:david).boards.exists?(id: activity.dig("board", "id")) }
+  end
+
+  test "index paginates newest activity first" do
+    card = cards(:logo)
+    now = Time.current
+
+    20.times do |index|
+      Event.create!(
+        board: card.board,
+        eventable: card,
+        creator: users(:david),
+        action: "card_published",
+        created_at: now + index.seconds
+      )
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    first_page = @response.parsed_body
+    assert_equal 15, first_page.length
+    assert_equal first_page.map { |activity| activity["created_at"] }.sort.reverse, first_page.map { |activity| activity["created_at"] }
+    assert_equal users(:kevin).accessible_events.where(action: activity_actions).count, @response.headers["X-Total-Count"].to_i
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    assert next_page
+    get next_page
+
+    assert_response :success
+    all_ids = first_page.concat(@response.parsed_body).map { |activity| activity["id"] }
+    expected_ids = users(:kevin).accessible_events.where(action: activity_actions).order(created_at: :desc, id: :desc).ids
+    assert_equal expected_ids, all_ids
+  end
+
+  private
+    def activity_actions
+      %w[
+        card_assigned card_unassigned card_published card_closed card_reopened card_board_changed
+        card_postponed card_auto_postponed card_title_changed card_triaged card_sent_back_to_triage comment_created
+      ]
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
