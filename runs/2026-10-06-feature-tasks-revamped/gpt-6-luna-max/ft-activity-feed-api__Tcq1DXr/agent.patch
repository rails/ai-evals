diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..2b6f906
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,39 @@
+json.(activity, :id, :action)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+
+particulars = case activity.action
+when "card_assigned", "card_unassigned"
+  { assignee_ids: Array(activity.assignee_ids) }
+when "card_board_changed"
+  {
+    old_board: activity.particulars&.dig("particulars", "old_board") || "",
+    new_board: activity.particulars&.dig("particulars", "new_board") || ""
+  }
+when "card_title_changed"
+  {
+    old_title: activity.particulars&.dig("particulars", "old_title") || "",
+    new_title: activity.particulars&.dig("particulars", "new_title") || ""
+  }
+when "card_triaged", "card_sent_back_to_triage"
+  { column: activity.particulars&.dig("particulars", "column") || "" }
+else
+  {}
+end
+json.particulars particulars
+
+if activity.eventable.is_a?(Comment)
+  json.url card_url(activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+else
+  json.url card_url(activity.eventable)
+end
+
+json.eventable_type activity.eventable_type
+json.eventable do
+  case activity.eventable
+  when Card then json.partial! "cards/card", card: activity.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
