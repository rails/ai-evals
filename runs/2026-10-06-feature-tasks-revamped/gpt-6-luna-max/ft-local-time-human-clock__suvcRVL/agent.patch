diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..ebf52b8
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag renders a timezone-independent raw UTC timestamp" do
+    instant = Time.utc(2025, 9, 12, 20, 42)
+
+    rendered_times = [ "UTC", "America/Los_Angeles" ].map do |timezone|
+      Time.use_zone(timezone) { local_time_tag instant.in_time_zone }
+    end
+
+    assert_equal rendered_times.first, rendered_times.last
+
+    time_tag = Nokogiri::HTML.fragment(rendered_times.first).at_css("time")
+    assert_equal "2025-09-12T20:42:00.000Z", time_tag["datetime"]
+    assert_equal "2025-09-12T20:42:00.000Z", time_tag.text
+    assert_equal "local-time", time_tag["data-controller"]
+    assert_equal "relative", time_tag["data-local-time-format-value"]
+  end
+
+  test "local_time_tag accepts a display format and HTML options" do
+    rendered_time = local_time_tag Time.utc(2025, 9, 12, 20, 42), format: "time", class: "timestamp"
+    time_tag = Nokogiri::HTML.fragment(rendered_time).at_css("time")
+
+    assert_equal "time", time_tag["data-local-time-format-value"]
+    assert_equal "timestamp", time_tag["class"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..2ec0998
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders relative timestamps in the browser timezone" do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+    sign_in_as(users(:kevin))
+    visit card_url(cards(:logo))
+
+    page.execute_script(<<~JAVASCRIPT)
+      const now = new Date()
+      const timestamp = (dayOffset, hour, minute) => new Date(
+        now.getFullYear(), now.getMonth(), now.getDate() + dayOffset, hour, minute
+      )
+
+      const timestamps = [
+        [ "today", timestamp(0, 13, 42) ],
+        [ "yesterday", timestamp(-1, 23, 0) ],
+        [ "five-days-ago", timestamp(-5, 12, 0) ],
+        [ "old-date", timestamp(-8, 12, 0) ],
+        [ "tomorrow", timestamp(1, 0, 15) ],
+        [ "in-three-days", timestamp(3, 12, 0) ]
+      ]
+
+      for (const [id, date] of timestamps) {
+        const time = document.createElement("time")
+        time.id = id
+        time.dataset.controller = "local-time"
+        time.dateTime = date.toISOString()
+        time.textContent = time.dateTime
+        document.body.append(time)
+      }
+    JAVASCRIPT
+
+    assert_selector "time#today", text: "1:42 PM"
+    assert_selector "time#yesterday", text: "yesterday"
+    assert_selector "time#five-days-ago", text: "5 days ago"
+    assert_selector "time#tomorrow", text: "tomorrow"
+    assert_selector "time#in-three-days", text: "in 3 days"
+
+    old_date = page.evaluate_script(<<~JAVASCRIPT)
+      (() => {
+        const date = new Date(document.querySelector("#old-date").dateTime)
+        const now = new Date()
+        const options = { month: "short", day: "numeric" }
+        if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+        return new Intl.DateTimeFormat("en-US", options).format(date)
+      })()
+    JAVASCRIPT
+    assert_selector "time#old-date", text: old_date
+    assert_selector "body[data-timezone-cookie-user-timezone-value='America/New_York']"
+    assert_equal ActiveSupport::TimeZone["America/New_York"], users(:kevin).reload.timezone
+  end
+end
