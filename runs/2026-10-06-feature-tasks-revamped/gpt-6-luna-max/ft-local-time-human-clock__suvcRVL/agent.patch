@@ -1,12 +1,37 @@
 import { Controller } from "@hotwired/stimulus"
 
 export default class extends Controller {
+  static values = { userTimezone: String, updateUrl: String }
+
   connect() {
-    this.#setTimezoneCookie()
+    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+
+    this.#setTimezoneCookie(timezone)
+    this.#updateUserTimezone(timezone)
   }
 
-  #setTimezoneCookie() {
-    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  #setTimezoneCookie(timezone) {
     document.cookie = `timezone=${encodeURIComponent(timezone)}; path=/`
   }
+
+  #updateUserTimezone(timezone) {
+    if (!this.userTimezoneValue || !this.updateUrlValue || this.userTimezoneValue === timezone) return
+
+    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content
+
+    fetch(this.updateUrlValue, {
+      method: "PATCH",
+      credentials: "same-origin",
+      headers: {
+        "Accept": "application/json",
+        "Content-Type": "application/json",
+        "X-CSRF-Token": csrfToken
+      },
+      body: JSON.stringify({ timezone_name: timezone })
+    }).then(response => {
+      if (response.ok) this.userTimezoneValue = timezone
+    }).catch(error => {
+      console.error("Unable to update timezone preference", error)
+    })
+  }
 }
