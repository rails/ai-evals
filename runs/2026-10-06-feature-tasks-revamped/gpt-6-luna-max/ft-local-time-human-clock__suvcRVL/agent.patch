diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..4bbcbc1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.#render()
+
+    this.observer = new MutationObserver(() => this.#render())
+    this.observer.observe(this.element, {
+      attributes: true,
+      attributeFilter: [ "datetime", "data-local-time-format-value" ],
+      childList: true,
+      characterData: true,
+      subtree: true
+    })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  #render() {
+    const timestamp = this.element.getAttribute("datetime")
+    const date = new Date(timestamp)
+
+    if (!timestamp || Number.isNaN(date.getTime())) return
+
+    const text = formatLocalTime(date, this.formatValue)
+    if (this.element.textContent !== text) this.element.textContent = text
+
+    if (!this.element.hasAttribute("title")) {
+      this.element.title = formatLocalTime(date, "date-time-with-year")
+    }
+  }
+}
