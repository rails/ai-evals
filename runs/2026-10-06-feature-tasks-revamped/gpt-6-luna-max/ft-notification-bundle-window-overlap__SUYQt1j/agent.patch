+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to off" do
+    assert_equal "never", users(:jz).settings.bundle_email_frequency
+  end
+
+  test "bundle email frequency only allows supported options" do
+    settings = users(:jz).settings
+
+    [ "never", "every_few_hours", "daily", "weekly" ].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert settings.valid?, "Expected #{frequency.inspect} to be valid"
+    end
+
+    settings.bundle_email_frequency = "hourly"
+    assert_not settings.valid?
+    assert_includes settings.errors[:bundle_email_frequency], "is not included in the list"
+  end
