+class NotificationMailer < ApplicationMailer
+  def digest(email_digest)
+    @user = email_digest.user
+    @notifications = email_digest.notifications.preloaded.order(:updated_at, :id).to_a
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy notification digest"
+    )
+  end
+end
