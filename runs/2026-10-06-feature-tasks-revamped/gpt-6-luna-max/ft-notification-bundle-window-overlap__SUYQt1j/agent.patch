@@ -1,6 +1,26 @@
 class User::Settings < ApplicationRecord
+  BUNDLE_EMAIL_FREQUENCY_INTERVALS = {
+    "never" => nil,
+    "every_few_hours" => 4.hours,
+    "daily" => 24.hours,
+    "weekly" => 7.days
+  }.freeze
+
+  BUNDLE_EMAIL_FREQUENCY_OPTIONS = {
+    "Off" => "never",
+    "Every four hours" => "every_few_hours",
+    "Daily" => "daily",
+    "Weekly" => "weekly"
+  }.freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
+  belongs_to :bundle_email_digest, class_name: "Notification::EmailDigest", optional: true
+
+  validates :bundle_email_frequency, inclusion: { in: BUNDLE_EMAIL_FREQUENCY_INTERVALS.keys }
+
+  after_update_commit :cancel_bundle_email_digest_if_disabled,
+    if: -> { saved_change_to_bundle_email_frequency? && bundle_email_frequency == "never" }
 
   def timezone
     if timezone_name.present?
@@ -10,8 +30,53 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def add_notification_to_email_digest(notification)
+    return unless notification.user_id == user_id
+
+    with_lock do
+      if interval = BUNDLE_EMAIL_FREQUENCY_INTERVALS[bundle_email_frequency]
+        digest = current_bundle_email_digest
+
+        unless digest
+          started_at = Time.current
+          digest = Notification::EmailDigest.create!(
+            account: account,
+            user: user,
+            started_at: started_at,
+            ends_at: started_at + interval
+          )
+          update!(bundle_email_digest: digest)
+        end
+
+        notification.update_column(:email_digest_id, digest.id) unless notification.email_digest_id == digest.id
+      end
+    end
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def current_bundle_email_digest
+      if bundle_email_digest_id.present?
+        digest = Notification::EmailDigest.lock.find_by(id: bundle_email_digest_id, user_id: user_id)
+
+        if digest&.pending?
+          digest
+        else
+          update!(bundle_email_digest: nil)
+        end
+      end
+    end
+
+    def cancel_bundle_email_digest_if_disabled
+      with_lock do
+        if digest = current_bundle_email_digest
+          now = Time.current
+          digest.update!(cancelled_at: now, ends_at: now)
+          update!(bundle_email_digest: nil)
+        end
+      end
+    end
 end
