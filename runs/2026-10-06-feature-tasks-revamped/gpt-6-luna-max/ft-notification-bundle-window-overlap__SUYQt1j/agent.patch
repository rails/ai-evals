diff --git a/app/models/notification/email_digest.rb b/app/models/notification/email_digest.rb
new file mode 100644
index 0000000..500b44e
--- /dev/null
+++ b/app/models/notification/email_digest.rb
@@ -0,0 +1,51 @@
+class Notification::EmailDigest < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, foreign_key: :email_digest_id, dependent: :nullify
+
+  after_create_commit :deliver_later
+
+  scope :pending, -> { where(sent_at: nil, cancelled_at: nil) }
+
+  def pending?
+    sent_at.nil? && cancelled_at.nil?
+  end
+
+  def deliver
+    settings = user.settings
+    return unless settings
+
+    # Use the settings row as the per-user lock for both adding notifications
+    # and closing a digest. A new window can't start until this one is sent.
+    settings.with_lock do
+      reload
+
+      if settings.bundle_email_digest_id == id && pending?
+        if settings.bundle_email_frequency == "never" || !deliverable?
+          cancel(settings)
+        elsif ends_at > Time.current
+          deliver_later
+        else
+          NotificationMailer.digest(self).deliver_now
+          update!(sent_at: Time.current)
+          settings.update!(bundle_email_digest: nil)
+        end
+      end
+    end
+  end
+
+  private
+    def deliver_later
+      Notification::EmailDigestJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def deliverable?
+      user.active? && user.identity&.email_address.present? && notifications.exists?
+    end
+
+    def cancel(settings)
+      now = Time.current
+      update!(cancelled_at: now, ends_at: now)
+      settings.update!(bundle_email_digest: nil)
+    end
+end
