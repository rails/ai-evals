diff --git a/test/models/notification/email_digest_test.rb b/test/models/notification/email_digest_test.rb
new file mode 100644
index 0000000..f71f924
--- /dev/null
+++ b/test/models/notification/email_digest_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Notification::EmailDigestTest < ActiveSupport::TestCase
+  test "starts the clock on the first notification and adds late notifications to that window" do
+    user = users(:jz)
+    settings = user.settings
+    settings.update!(bundle_email_frequency: "every_few_hours")
+    first_landed_at = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to first_landed_at do
+      @first_notification = create_notification(user, events(:logo_published))
+      @digest = settings.reload.bundle_email_digest
+
+      assert_equal first_landed_at, @digest.started_at
+      assert_equal first_landed_at + 4.hours, @digest.ends_at
+      assert_equal @digest, @first_notification.reload.email_digest
+    end
+
+    # A delayed notification must join the window that's already open, even if
+    # it arrives after its nominal end time and the delivery job hasn't run yet.
+    travel_to first_landed_at + 5.hours do
+      late_notification = create_notification(user, events(:layout_commented))
+
+      assert_equal @digest, settings.reload.bundle_email_digest
+      assert_equal @digest, late_notification.reload.email_digest
+      assert_equal first_landed_at + 4.hours, @digest.reload.ends_at
+
+      emails_before = ActionMailer::Base.deliveries.size
+      Notification::EmailDigestJob.perform_now(@digest)
+      email = ActionMailer::Base.deliveries.last
+
+      assert_equal emails_before + 1, ActionMailer::Base.deliveries.size
+      assert_equal [ user.identity.email_address ], email.to
+      assert_equal "Your Fizzy notification digest", email.subject
+      assert_includes email.body.encoded, user.account.slug
+      assert_includes email.body.encoded, @first_notification.payload.title
+      assert_includes email.body.encoded, late_notification.payload.title
+    end
+  end
+
+  test "does not create a digest when the frequency is off" do
+    user = users(:jz)
+    user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::EmailDigest.count } do
+      create_notification(user, events(:logo_published))
+    end
+  end
+
+  test "delivers a digest once and starts the next window only after it closes" do
+    user = users(:jz)
+    settings = user.settings
+    settings.update!(bundle_email_frequency: "daily")
+    first_landed_at = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to first_landed_at do
+      create_notification(user, events(:logo_published))
+      @digest = settings.reload.bundle_email_digest
+    end
+
+    travel_to first_landed_at + 1.day do
+      emails_before = ActionMailer::Base.deliveries.size
+      Notification::EmailDigestJob.perform_now(@digest)
+
+      assert_equal emails_before + 1, ActionMailer::Base.deliveries.size
+      assert @digest.reload.sent_at
+      assert_nil settings.reload.bundle_email_digest
+
+      Notification::EmailDigestJob.perform_now(@digest)
+      assert_equal emails_before + 1, ActionMailer::Base.deliveries.size
+
+      create_notification(user, events(:layout_commented))
+      next_digest = settings.reload.bundle_email_digest
+
+      assert_not_equal @digest, next_digest
+      assert_operator next_digest.started_at, :>=, @digest.ends_at
+    end
+  end
+
+  test "turning email digests off cancels an open window" do
+    user = users(:jz)
+    settings = user.settings
+    settings.update!(bundle_email_frequency: "daily")
+    first_landed_at = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to first_landed_at do
+      create_notification(user, events(:logo_published))
+      @digest = settings.reload.bundle_email_digest
+    end
+
+    travel_to first_landed_at + 1.hour do
+      settings.update!(bundle_email_frequency: "never")
+
+      assert @digest.reload.cancelled_at
+      assert_equal @digest.cancelled_at, @digest.ends_at
+      assert_nil settings.reload.bundle_email_digest
+    end
+
+    travel_to first_landed_at + 2.hours do
+      settings.update!(bundle_email_frequency: "daily")
+      create_notification(user, events(:layout_commented))
+
+      next_digest = settings.reload.bundle_email_digest
+      assert_not_equal @digest, next_digest
+      assert_operator next_digest.started_at, :>=, @digest.ends_at
+    end
+
+    travel_to first_landed_at + 1.day do
+      emails_before = ActionMailer::Base.deliveries.size
+      Notification::EmailDigestJob.perform_now(@digest)
+
+      assert_equal emails_before, ActionMailer::Base.deliveries.size
+    end
+  end
+
+  test "notifier updates create a new window once the previous one has been delivered" do
+    user = users(:jz)
+    settings = user.settings
+    settings.update!(bundle_email_frequency: "weekly")
+    first_landed_at = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to first_landed_at do
+      @notification = create_notification(user, events(:logo_published))
+      @digest = settings.reload.bundle_email_digest
+    end
+
+    travel_to first_landed_at + 1.week do
+      Notification::EmailDigestJob.perform_now(@digest)
+      @notification.update!(source: events(:logo_assignment_jz))
+
+      next_digest = settings.reload.bundle_email_digest
+      assert_not_equal @digest, next_digest
+      assert_equal next_digest, @notification.reload.email_digest
+      assert_operator next_digest.started_at, :>=, @digest.ends_at
+    end
+  end
+
+  test "an early delivery job reschedules instead of closing the window" do
+    user = users(:jz)
+    settings = user.settings
+    settings.update!(bundle_email_frequency: "every_few_hours")
+    first_landed_at = Time.zone.parse("2026-01-01 09:00:00")
+
+    travel_to first_landed_at do
+      create_notification(user, events(:logo_published))
+      @digest = settings.reload.bundle_email_digest
+    end
+
+    travel_to first_landed_at + 3.hours do
+      emails_before = ActionMailer::Base.deliveries.size
+      Notification::EmailDigestJob.perform_now(@digest)
+
+      assert_equal emails_before, ActionMailer::Base.deliveries.size
+      assert_nil @digest.reload.sent_at
+      assert_equal @digest, settings.reload.bundle_email_digest
+      assert_enqueued_with(job: Notification::EmailDigestJob, at: @digest.ends_at)
+    end
+  end
+
+  private
+    def create_notification(user, event)
+      Notification.create!(
+        user: user,
+        source: event,
+        creator: users(:david),
+        unread_count: 1
+      )
+    end
+end
