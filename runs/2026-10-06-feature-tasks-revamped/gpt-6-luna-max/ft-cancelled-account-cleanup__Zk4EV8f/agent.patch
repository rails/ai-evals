diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..1d95062
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates only accounts canceled beyond the grace period" do
+    travel_to(Time.zone.local(2026, 6, 1, 12)) do
+      expired = create_cancelled_account("Expired account", 31.days.ago)
+      recent = create_cancelled_account("Recently canceled account", 29.days.ago)
+      at_grace_period = create_cancelled_account("At grace period", 30.days.ago)
+      reactivated = create_cancelled_account("Reactivated account", 31.days.ago)
+      reactivated.reactivate
+      active = Account.create!(name: "Active account")
+
+      expired_owner = expired.users.find_by!(identity: identities(:david))
+      board = expired.boards.create!(name: "Board", creator: expired_owner)
+      card = board.cards.create!(creator: expired_owner, title: "Account data")
+      storage_entry = Storage::Entry.create!(account: expired, delta: 100, operation: "attach")
+      search_record = Search::Record.for(expired.id).create!(
+        account_id: expired.id,
+        searchable: card,
+        card: card,
+        board_id: board.id,
+        title: "Account data",
+        content: "Account data",
+        created_at: Time.current
+      )
+
+      Current.set(account: expired) do
+        blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("account file"), filename: "account.txt", content_type: "text/plain")
+        card.image.attach(blob)
+        ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphan file"), filename: "orphan.txt", content_type: "text/plain")
+      end
+
+      perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_not Account.exists?(expired.id)
+      assert_not Board.exists?(board.id)
+      assert_not Card.exists?(card.id)
+      assert_not Storage::Entry.exists?(storage_entry.id)
+      assert_not Search::Record.for(expired.id).exists?(search_record.id)
+      assert_not ActiveStorage::Attachment.exists?(account_id: expired.id)
+      assert_not ActiveStorage::Blob.exists?(account_id: expired.id)
+      assert_empty account_scoped_data(expired.id)
+      assert Identity.exists?(identities(:david).id), "shared identities must be retained"
+
+      assert Account.exists?(recent.id)
+      assert Account.exists?(at_grace_period.id), "exactly 30 days is not more than the grace period"
+      assert Account.exists?(reactivated.id)
+      assert Account.exists?(active.id)
+    end
+  end
+
+  private
+    def account_scoped_data(account_id)
+      connection = ApplicationRecord.connection
+
+      connection.tables.filter_map do |table_name|
+        next unless connection.columns(table_name).any? { |column| column.name == "account_id" }
+
+        count = connection.select_value(<<~SQL).to_i
+          SELECT COUNT(*)
+          FROM #{connection.quote_table_name(table_name)}
+          WHERE #{connection.quote_column_name("account_id")} = #{connection.quote(account_id)}
+        SQL
+        [ table_name, count ] if count.positive?
+      end
+    end
+
+    def create_cancelled_account(name, cancelled_at)
+      account = Account.create!(name: name)
+      owner = account.users.create!(name: "Owner", role: :owner, identity: identities(:david))
+      cancellation = account.create_cancellation!(initiated_by: owner)
+      cancellation.update_column(:created_at, cancelled_at)
+      account
+    end
+end
