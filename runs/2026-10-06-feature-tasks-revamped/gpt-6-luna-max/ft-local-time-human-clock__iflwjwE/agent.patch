diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..1780a54 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,21 @@
 module TimeHelper
+  def local_time_tag(timestamp, format: :smart, **options)
+    if timestamp.present?
+      data = (options.delete(:data) || {}).dup
+      controller = [ data.delete(:controller), "local-time" ].compact.join(" ")
+      data.merge!(controller: controller, local_time_format_value: format)
+      classes = class_names("local-time-value", options.delete(:class))
+
+      tag.time "", datetime: timestamp_as_utc(timestamp).iso8601(6), class: classes, data: data, **options
+    end
+  end
+
+  private
+    def timestamp_as_utc(timestamp)
+      if timestamp.respond_to?(:utc)
+        timestamp.utc
+      else
+        timestamp.to_time.utc
+      end
+    end
 end
