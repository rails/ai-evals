diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..9442ba9
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a raw timestamp for browser-side formatting" do
+    timestamp = Time.utc(2025, 9, 12, 20, 42) + 0.123456
+
+    html = Time.use_zone("America/Los_Angeles") do
+      local_time_tag(timestamp, format: :smart)
+    end
+    element = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal timestamp.iso8601(6), element["datetime"]
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "smart", element["data-local-time-format-value"]
+    assert_equal "", element.text
+  end
+
+  test "retains caller attributes while enabling local-time rendering" do
+    html = local_time_tag(Time.utc(2025, 9, 12), format: :time, class: "event__timestamp", data: { controller: "tooltip" })
+    element = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "local-time-value event__timestamp", element["class"]
+    assert_equal "tooltip local-time", element["data-controller"]
+    assert_equal "time", element["data-local-time-format-value"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..a40bb2c
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,53 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+  end
+
+  test "formats timestamps in the browser timezone" do
+    expected_old_date = page.evaluate_script <<~JS
+      (() => {
+        const now = new Date()
+        const oldDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 8, 13, 42)
+        const options = { month: "short", day: "numeric" }
+        if (oldDate.getFullYear() !== now.getFullYear()) options.year = "numeric"
+        return new Intl.DateTimeFormat("en", options).format(oldDate)
+      })()
+    JS
+
+    page.execute_script <<~JS
+      const now = new Date()
+      const timestamp = (daysFromNow, hour = 13, minute = 42) => {
+        return new Date(now.getFullYear(), now.getMonth(), now.getDate() + daysFromNow, hour, minute).toISOString()
+      }
+
+      const timestamps = [
+        ["today", "smart", timestamp(0)],
+        ["yesterday", "smart", timestamp(-1, 23)],
+        ["five-days-ago", "smart", timestamp(-5)],
+        ["eight-days-ago", "smart", timestamp(-8)],
+        ["tomorrow", "future", timestamp(1)],
+        ["in-three-days", "future", timestamp(3)]
+      ]
+
+      for (const [id, format, datetime] of timestamps) {
+        const element = document.createElement("time")
+        element.id = `test-${id}`
+        element.dateTime = datetime
+        element.dataset.controller = "local-time"
+        element.dataset.localTimeFormatValue = format
+        document.body.append(element)
+      }
+    JS
+
+    assert_selector "#test-today", text: "1:42 PM"
+    assert_selector "#test-yesterday", text: "yesterday"
+    assert_selector "#test-five-days-ago", text: "5 days ago"
+    assert_selector "#test-eight-days-ago", text: expected_old_date
+    assert_selector "#test-tomorrow", text: "tomorrow"
+    assert_selector "#test-in-three-days", text: "in 3 days"
+  end
+end
