diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..487c4bd
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,126 @@
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+const SECONDS_IN_MINUTE = 60
+const SECONDS_IN_HOUR = 60 * SECONDS_IN_MINUTE
+const SECONDS_IN_DAY = 24 * SECONDS_IN_HOUR
+const SECONDS_IN_MONTH = 30 * SECONDS_IN_DAY
+const SECONDS_IN_YEAR = 365 * SECONDS_IN_DAY
+const formatterCache = new Map()
+
+export function formatLocalTime(date, format = "smart", now = new Date()) {
+  switch (format) {
+    case "time":
+      return dateTimeFormatter({ hour: "numeric", minute: "2-digit" }).format(date)
+    case "date":
+      return formatShortDate(date, now)
+    case "date-with-year":
+      return dateTimeFormatter({ month: "short", day: "numeric", year: "numeric" }).format(date)
+    case "weekday-date":
+      return dateTimeFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+    case "date-time":
+      return dateTimeFormatter({ dateStyle: "short", timeStyle: "short" }).format(date)
+    case "relative":
+      return formatRelativeTime(date, now)
+    case "future":
+      return formatFutureTime(date, now)
+    case "smart":
+    default:
+      return formatSmartTime(date, now)
+  }
+}
+
+export function formatShortDate(date, now = new Date()) {
+  const options = { month: "short", day: "numeric" }
+
+  if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+
+  return dateTimeFormatter(options).format(date)
+}
+
+export function formatAbsoluteDateTime(date) {
+  return dateTimeFormatter({ weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function formatSmartTime(date, now) {
+  const daysFromNow = calendarDaysFromNow(date, now)
+
+  if (daysFromNow === 0) {
+    return formatLocalTime(date, "time", now)
+  } else if (Math.abs(daysFromNow) <= 6) {
+    return relativeDateFormatter().format(daysFromNow, "day")
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+function formatFutureTime(date, now) {
+  const daysFromNow = calendarDaysFromNow(date, now)
+
+  if (daysFromNow === 0) {
+    return formatRelativeTime(date, now)
+  } else {
+    return relativeDateFormatter().format(daysFromNow, "day")
+  }
+}
+
+function formatRelativeTime(date, now) {
+  const differenceInSeconds = (date.getTime() - now.getTime()) / 1000
+  const absoluteDifference = Math.abs(differenceInSeconds)
+  const direction = Math.sign(differenceInSeconds)
+  let unit, secondsPerUnit
+
+  if (absoluteDifference < SECONDS_IN_MINUTE) {
+    unit = "second"
+    secondsPerUnit = 1
+  } else if (absoluteDifference < SECONDS_IN_HOUR) {
+    unit = "minute"
+    secondsPerUnit = SECONDS_IN_MINUTE
+  } else if (absoluteDifference < SECONDS_IN_DAY) {
+    unit = "hour"
+    secondsPerUnit = SECONDS_IN_HOUR
+  } else if (absoluteDifference < 45 * SECONDS_IN_DAY) {
+    unit = "day"
+    secondsPerUnit = SECONDS_IN_DAY
+  } else if (absoluteDifference < SECONDS_IN_YEAR) {
+    unit = "month"
+    secondsPerUnit = SECONDS_IN_MONTH
+  } else {
+    unit = "year"
+    secondsPerUnit = SECONDS_IN_YEAR
+  }
+
+  const value = absoluteDifference < SECONDS_IN_MINUTE ? 0 : direction * Math.round(absoluteDifference / secondsPerUnit)
+  return relativeDateFormatter().format(value, unit)
+}
+
+function calendarDaysFromNow(date, now) {
+  return localDayNumber(date) - localDayNumber(now)
+}
+
+function localDayNumber(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_IN_MILLISECONDS
+}
+
+function dateTimeFormatter(options) {
+  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone
+  const key = JSON.stringify([locale(), timezone, options])
+
+  if (!formatterCache.has(key)) {
+    formatterCache.set(key, new Intl.DateTimeFormat(locale(), options))
+  }
+
+  return formatterCache.get(key)
+}
+
+function relativeDateFormatter() {
+  const key = JSON.stringify([locale(), "relative"])
+
+  if (!formatterCache.has(key)) {
+    formatterCache.set(key, new Intl.RelativeTimeFormat(locale(), { numeric: "auto" }))
+  }
+
+  return formatterCache.get(key)
+}
+
+function locale() {
+  return document.documentElement.lang || "en"
+}
