--- /dev/null
+++ b/app/mailers/data_transfer_mailer.rb
@@ -0,0 +1,28 @@
+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    export.update!(expires_at: Export::DOWNLOAD_LIFETIME.from_now)
+    @export = export
+    @user = export.requested_by
+    @download_url = export_download_url(export.download_token, script_name: "")
+
+    subject = export.account? ? "Your Fizzy account export is ready" : "Your Fizzy card export is ready"
+    mail(to: @user.identity.email_address, subject: subject)
+  end
+
+  def import_completed(import)
+    @import = import
+    @user = import.requested_by
+    @account = import.imported_account
+    @account_url = root_url(script_name: @account.slug)
+
+    mail(to: @user.identity.email_address, subject: "Your Fizzy account import is complete")
+  end
+
+  def import_failed(import)
+    @import = import
+    @user = import.requested_by
+    @import_url = account_import_url(import, script_name: import.account.slug)
+
+    mail(to: @user.identity.email_address, subject: "Your Fizzy account import failed")
+  end
+end
