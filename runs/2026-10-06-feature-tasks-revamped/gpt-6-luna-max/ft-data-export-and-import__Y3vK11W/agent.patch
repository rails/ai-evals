@@ -0,0 +1,41 @@
+module Account::DataTransfer::RichText
+  BLOB_REFERENCE_ATTRIBUTE = "data-fizzy-blob-id"
+
+  class << self
+    def export_body(body, account:)
+      return body if body.blank?
+
+      fragment = ActionText::Fragment.wrap(body)
+      portable_fragment = fragment.update do |source|
+        source.css(ActionText::Attachment.tag_name).each do |node|
+          attachable = ActionText::Attachable.from_node(node)
+          if attachable.is_a?(ActiveStorage::Blob) && attachable.account_id == account.id
+            node[BLOB_REFERENCE_ATTRIBUTE] = attachable.id
+            node.remove_attribute("sgid")
+          end
+        end
+      end
+
+      portable_fragment.to_html
+    end
+
+    def import_body(body, blobs_by_source_id:, account:)
+      return body if body.blank?
+
+      fragment = ActionText::Fragment.wrap(body)
+      fragment.update do |source|
+        source.css("#{ActionText::Attachment.tag_name}[#{BLOB_REFERENCE_ATTRIBUTE}]").each do |node|
+          source_blob_id = node[BLOB_REFERENCE_ATTRIBUTE]
+          node.remove_attribute(BLOB_REFERENCE_ATTRIBUTE)
+          blob = blobs_by_source_id[source_blob_id]
+          raise Account::DataTransfer::Importer::InvalidArchive, "An embedded file is missing from the archive" unless blob
+
+          attributes = blob.to_rich_text_attributes
+          node["sgid"] = attributes.fetch(:sgid)
+          node["url"] = attributes.fetch(:url) if attributes[:url]
+          node["content-type"] = attributes.fetch(:content_type) if attributes[:content_type]
+        end
+      end.to_html
+    end
+  end
+end
