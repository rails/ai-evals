@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::DataTransfer::LifecycleTest < ActiveSupport::TestCase
+  test "account deletion cleans up requests and detaches imported accounts" do
+    identity = identities(:kevin)
+    source = Account.create_with_owner(account: { name: "Source account" }, owner: { identity: identity, name: "Kevin" })
+    source_owner = source.users.find_by!(identity: identity)
+    restored = Account.create!(name: "Restored account")
+
+    export = source.exports.create!(requested_by: source_owner, kind: :account)
+    import = source.imports.new(requested_by: source_owner)
+    Current.with(account: source, user: source_owner) do
+      import.file.attach(io: StringIO.new("archive"), filename: "account.zip", content_type: "application/zip")
+      import.save!
+    end
+    import.update_columns(imported_account_id: restored.id, status: "completed")
+
+    restored.destroy!
+    assert_nil import.reload.imported_account_id
+
+    source.destroy!
+    assert_not Export.exists?(export.id)
+    assert_not Account::Import.exists?(import.id)
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
