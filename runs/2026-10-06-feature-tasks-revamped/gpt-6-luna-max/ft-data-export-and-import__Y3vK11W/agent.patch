+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center shadow flex flex-column gap-half margin-block-start-half">
+  <p class="margin-none">Choose a Fizzy account export ZIP file. We’ll create a new account with its boards, cards, comments, files, and people.</p>
