diff --git a/app/models/account/data_transfer/exporter.rb b/app/models/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..b333f05
--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,173 @@
+require "set"
+
+class Account::DataTransfer::Exporter
+  CARD_BATCH_SIZE = 100
+
+  attr_reader :export, :account
+
+  def initialize(export)
+    @export = export
+    @account = export.account
+    @written_blob_ids = Set.new
+  end
+
+  def write
+    ZipFile.create_for(export.file, filename: filename) do |zip|
+      if export.account?
+        write_account_archive(zip)
+      else
+        write_cards_archive(zip)
+      end
+    end
+  end
+
+  private
+    def filename
+      if export.account?
+        "#{account.name.parameterize.presence || 'account'}-export.zip"
+      else
+        "#{export.requested_by.name.parameterize.presence || 'cards'}-cards.zip"
+      end
+    end
+
+    def write_account_archive(zip)
+      manifest = Account::DataTransfer::Manifest.new(account)
+      record_paths = manifest.record_set_paths
+
+      zip.add_file("manifest.json", JSON.generate(
+        format: "fizzy-account",
+        version: Account::DataTransfer::Manifest::VERSION,
+        record_sets: record_paths
+      ))
+
+      manifest.each_record_set do |record_set|
+        record_set.export_to(zip)
+      end
+    end
+
+    def write_cards_archive(zip)
+      user = export.requested_by
+      raise ActiveRecord::RecordNotFound unless user.account_id == account.id && user.active?
+
+      cards = user.accessible_cards.distinct
+      zip.add_file("manifest.json", JSON.generate(
+        format: "fizzy-cards",
+        version: Account::DataTransfer::Manifest::VERSION,
+        cards_count: cards.count
+      ))
+
+      cards.find_each(batch_size: CARD_BATCH_SIZE) do |card|
+        write_card(zip, card)
+      end
+    end
+
+    def write_card(zip, card)
+      comments = card.comments.chronologically
+      card_attachments = attachment_data_for(card, card.image_attachment, zip)
+      comment_attachments = {}
+      comments.includes(:creator, rich_text_body: { embeds_attachments: :blob }).find_each do |comment|
+        comment_attachments[comment.id] = attachment_data_for(comment, nil, zip)
+      end
+
+      card_data = {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column && { id: card.column.id, name: card.column.name },
+        creator: person_data(card.creator),
+        description: portable_body(card.rich_text_description),
+        tags: card.tags.map(&:title),
+        assignees: card.assignees.map { |assignee| person_data(assignee) },
+        steps: card.steps.map { |step| step.attributes.except("account_id", "card_id") },
+        attachments: card_attachments
+      }
+
+      zip.add_file("cards/#{card.number}.json") do |sink|
+        sink.write("{")
+        card_data.each_with_index do |(key, value), index|
+          sink.write(",") unless index.zero?
+          sink.write(JSON.generate(key.to_s))
+          sink.write(":")
+          sink.write(JSON.generate(value))
+        end
+
+        sink.write(",\"comments\":[")
+        first_comment = true
+        comments.includes(:creator, rich_text_body: { embeds_attachments: :blob }).find_each do |comment|
+          sink.write(",") unless first_comment
+          first_comment = false
+          sink.write(JSON.generate(comment_data(comment, comment_attachments.fetch(comment.id, []))))
+        end
+        sink.write("]}")
+      end
+    end
+
+    def comment_data(comment, attachments)
+      comment.attributes.except("account_id").merge(
+        "body" => portable_body(comment.rich_text_body),
+        "creator" => person_data(comment.creator),
+        "attachments" => attachments
+      )
+    end
+
+    def person_data(user)
+      {
+        id: user.id,
+        name: user.name,
+        email_address: user.identity&.email_address
+      }
+    end
+
+    def portable_body(rich_text)
+      if rich_text
+        Account::DataTransfer::RichText.export_body(rich_text.body.to_s, account: account)
+      end
+    end
+
+    def attachment_data_for(record, direct_attachment, zip)
+      attachments = []
+      if direct_attachment
+        attachments << add_blob(direct_attachment.blob, zip)
+      end
+
+      if rich_text = rich_text_for(record)
+        rich_text.embeds_attachments.includes(:blob).each do |attachment|
+          attachments << add_blob(attachment.blob, zip)
+        end
+      end
+
+      attachments
+    end
+
+    def rich_text_for(record)
+      association = if record.is_a?(Card)
+        :rich_text_description
+      elsif record.is_a?(Comment)
+        :rich_text_body
+      end
+
+      record.public_send(association) if association
+    end
+
+    def add_blob(blob, zip)
+      if @written_blob_ids.add?(blob.id)
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+
+      {
+        id: blob.id,
+        path: "files/#{blob.id}",
+        filename: blob.filename.to_s,
+        content_type: blob.content_type,
+        byte_size: blob.byte_size
+      }
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..0d208dc
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,490 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  BATCH_SIZE = 500
+  MAX_MANIFEST_SIZE = 1.megabyte
+  SAFE_ID = /\A[a-z0-9-]{1,64}\z/
+
+  attr_reader :account_import, :uploaded_files
+
+  def initialize(import)
+    @account_import = import
+    @uploaded_files = []
+    @id_map = {}
+    @blobs_by_source_id = {}
+  end
+
+  def import
+    open_archive do
+      validate_archive!
+      create_account
+      Current.with(account: target_account, user: owner_user, identity: owner_user.identity) do
+        import_record_sets
+        grant_importer_access
+        @target_account.update_columns(cards_count: @source_account.fetch("cards_count", 0).to_i)
+      end
+      @target_account
+    end
+  rescue StandardError
+    discard_uploaded_files
+    raise
+  end
+
+  def discard_uploaded_files
+    uploaded_files.each do |service, key|
+      service.delete(key)
+    rescue StandardError => error
+      Rails.error.report(error, context: { import_id: account_import.id, storage_key: key })
+    end
+
+    uploaded_files.clear
+  end
+
+  private
+    attr_reader :target_account, :system_user, :owner_user
+
+    def open_archive
+      raise InvalidArchive, "Choose a ZIP file to import" unless account_import.file.attached?
+
+      @archive_blob = account_import.file.blob
+      @archive_io = ZipFile::BlobIO.new(@archive_blob)
+      entries = ZipKit::FileReader.read_zip_structure(io: @archive_io)
+      names = entries.map { |entry| entry.filename.to_s.force_encoding(Encoding::UTF_8) }
+      raise InvalidArchive, "The ZIP archive contains invalid filenames" if names.any? { |name| !name.valid_encoding? }
+      raise InvalidArchive, "The ZIP archive contains duplicate filenames" unless names.uniq.size == names.size
+
+      @entries = entries.index_by { |entry| entry.filename.to_s.force_encoding(Encoding::UTF_8) }
+      yield
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature, Zlib::Error, ActiveStorage::FileNotFoundError
+      raise InvalidArchive, "The selected file is not a valid, readable ZIP archive"
+    end
+
+    def validate_archive!
+      validate_entry_names!
+      @archive_manifest = JSON.parse(read_entry("manifest.json", limit: MAX_MANIFEST_SIZE))
+      unless @archive_manifest["format"] == "fizzy-account" && @archive_manifest["version"] == Account::DataTransfer::Manifest::VERSION
+        raise InvalidArchive, "This ZIP file is not a supported Fizzy account export"
+      end
+
+      record_sets = manifest_record_sets
+      expected_paths = record_sets.reject(&:file_record_set?).map(&:path)
+      unless @archive_manifest["record_sets"] == expected_paths
+        raise InvalidArchive, "The account export is incomplete or uses an unsupported format"
+      end
+
+      expected_paths.each do |path|
+        raise InvalidArchive, "The account export is missing #{path}" unless @entries.key?(path)
+      end
+
+      @source_account = read_single_record("records/accounts.jsonl")
+      unless @source_account["name"].to_s.strip.present? && valid_id?(@source_account["id"])
+        raise InvalidArchive, "The account export does not contain a valid account"
+      end
+
+      validate_blob_files!(record_sets)
+    rescue JSON::ParserError
+      raise InvalidArchive, "The account export contains malformed JSON"
+    end
+
+    def validate_entry_names!
+      record_paths = manifest_record_sets.reject(&:file_record_set?).map(&:path)
+      allowed = ([ "manifest.json" ] + record_paths).to_set
+
+      @entries.each_key do |name|
+        if name.start_with?("files/")
+          file_id = name.delete_prefix("files/")
+          raise InvalidArchive, "The account export contains an unsafe file path" unless valid_id?(file_id)
+        elsif !allowed.include?(name)
+          raise InvalidArchive, "The ZIP archive contains an unexpected entry"
+        end
+      end
+    end
+
+    def validate_blob_files!(record_sets)
+      blob_set = record_sets.find { |record_set| record_set.model == ::ActiveStorage::Blob }
+      raise InvalidArchive, "The account export does not contain attachment metadata" unless blob_set
+
+      expected_file_count = 0
+      each_record("records/active_storage_blobs.jsonl") do |blob_attributes|
+        source_id = blob_attributes["id"]
+        file_entry = @entries["files/#{source_id}"]
+        unless valid_id?(source_id) && file_entry && file_entry.uncompressed_size == blob_attributes["byte_size"].to_i
+          raise InvalidArchive, "The account export is missing an attachment or its size does not match"
+        end
+
+        expected_file_count += 1
+      end
+
+      actual_file_count = @entries.keys.count { |name| name.start_with?("files/") }
+      unless actual_file_count == expected_file_count
+        raise InvalidArchive, "The account export contains an unexpected number of attachment files"
+      end
+    end
+
+    def manifest_record_sets
+      @manifest_record_sets ||= begin
+        sets = []
+        Account::DataTransfer::Manifest.new(account_import.account).each_record_set { |record_set| sets << record_set }
+        sets
+      end
+    end
+
+    def read_single_record(path)
+      records = []
+      each_record(path) { |record| records << record }
+      raise InvalidArchive, "The account export must contain exactly one account" unless records.one?
+
+      records.first
+    end
+
+    def read_entry(path, limit: nil)
+      entry = @entries[path]
+      raise InvalidArchive, "The account export is missing #{path}" unless entry
+      raise InvalidArchive, "The account export's manifest is too large" if limit && entry.uncompressed_size > limit
+
+      io = ZipFile::EntryIO.new(ZipFile::BlobIO.new(@archive_blob), entry)
+      content = +"".b
+      while chunk = io.read(64.kilobytes)
+        break if chunk.empty?
+
+        content << chunk
+        raise InvalidArchive, "The account export's manifest is too large" if limit && content.bytesize > limit
+      end
+      content.force_encoding(Encoding::UTF_8)
+    end
+
+    def each_record(path)
+      io = ZipFile::EntryIO.new(ZipFile::BlobIO.new(@archive_blob), @entries.fetch(path))
+      io.each_line do |line|
+        next if line.blank?
+
+        record = JSON.parse(line)
+        raise InvalidArchive, "The account export contains an invalid record" unless record.is_a?(Hash)
+
+        yield record
+      end
+    end
+
+    def each_batch(record_set)
+      batch = []
+      each_record(record_set.path) do |record|
+        batch << record
+        if batch.size >= BATCH_SIZE
+          yield batch
+          batch = []
+        end
+      end
+      yield batch if batch.any?
+    end
+
+    def create_account
+      importer_identity = account_import.requested_by.identity
+      raise InvalidArchive, "Your account needs a verified email address to import data" unless importer_identity
+
+      source_id = @source_account.fetch("id")
+      created_at = Time.current
+      @target_account_id = ActiveRecord::Type::Uuid.generate
+      Account.insert_all!([ {
+        id: @target_account_id,
+        external_account_id: Account::ExternalIdSequence.next,
+        name: @source_account.fetch("name"),
+        cards_count: 0,
+        created_at: created_at,
+        updated_at: created_at
+      } ])
+      @target_account = Account.find(@target_account_id)
+      @id_map[source_id] = @target_account.id
+
+      Account::JoinCode.create!(account: target_account)
+      Entropy.insert_all!([ {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: target_account.id,
+        container_type: "Account",
+        container_id: target_account.id,
+        auto_postpone_period: Account::Entropic::DEFAULT_ENTROPY_PERIOD.to_i,
+        created_at: created_at,
+        updated_at: created_at
+      } ])
+
+      Current.with(account: target_account, identity: importer_identity) do
+        create_system_user
+        create_owner_user(importer_identity)
+      end
+    end
+
+    def create_system_user
+      @system_user_id = ActiveRecord::Type::Uuid.generate
+      insert_user(
+        id: @system_user_id,
+        name: "System",
+        role: "system",
+        identity_id: nil,
+        active: true,
+        verified_at: nil
+      )
+      @system_user = User.find(@system_user_id)
+    end
+
+    def create_owner_user(identity)
+      @owner_user_id = ActiveRecord::Type::Uuid.generate
+      insert_user(
+        id: @owner_user_id,
+        name: account_import.requested_by.name,
+        role: "owner",
+        identity_id: identity.id,
+        active: true,
+        verified_at: Time.current
+      )
+      @owner_user = User.find(@owner_user_id)
+    end
+
+    def insert_user(id:, name:, role:, identity_id:, active:, verified_at:)
+      now = Time.current
+      User.insert_all!([ {
+        id: id,
+        account_id: target_account.id,
+        identity_id: identity_id,
+        name: name.presence || "Fizzy user",
+        role: role,
+        active: active,
+        verified_at: verified_at,
+        created_at: now,
+        updated_at: now
+      } ])
+    end
+
+    def import_record_sets
+      @id_map[@source_account.fetch("id")] = target_account.id
+
+      manifest_record_sets.each do |record_set|
+        if record_set.is_a?(Account::DataTransfer::AccountRecordSet)
+          next
+        elsif record_set.is_a?(Account::DataTransfer::UserRecordSet)
+          import_users(record_set)
+        elsif record_set.file_record_set?
+          import_files(record_set)
+        elsif record_set.join_record_set?
+          import_join_rows(record_set)
+        elsif record_set.model == ::ActiveStorage::Blob
+          import_blobs(record_set)
+        elsif record_set.model == ::Entropy
+          import_entropies(record_set)
+        else
+          import_model_rows(record_set)
+        end
+      end
+      refresh_filter_digests
+    end
+
+    def import_users(record_set)
+      requester_email = account_import.requested_by.identity.email_address
+      each_record(record_set.path) do |source_user|
+        source_id = source_user["id"]
+        raise InvalidArchive, "The account export contains a person without an ID" unless valid_id?(source_id)
+
+        if source_user["role"] == "system"
+          @id_map[source_id] = system_user.id
+        elsif source_user["identity_email_address"].to_s.casecmp?(requester_email)
+          @id_map[source_id] = owner_user.id
+          owner_user.update_columns(
+            name: source_user["name"].presence || owner_user.name,
+            active: true,
+            role: "owner",
+            verified_at: source_user["verified_at"] || Time.current,
+            updated_at: Time.current
+          )
+        else
+          import_person(source_user)
+        end
+      end
+    end
+
+    def import_person(source_user)
+      source_id = source_user.fetch("id")
+      email_address = source_user["identity_email_address"].presence
+      identity = Identity.find_or_create_by!(email_address: email_address) if email_address
+      target_id = mapped_id_for(source_id)
+      attributes = source_user.slice(*User.column_names)
+      attributes["id"] = target_id
+      attributes["account_id"] = target_account.id
+      attributes["identity_id"] = identity&.id
+      attributes["role"] = "member" if attributes["role"] == "system"
+      attributes["name"] = "Fizzy user" if attributes["name"].blank?
+      User.insert_all!([ attributes ])
+    end
+
+    def import_model_rows(record_set)
+      each_batch(record_set) do |source_rows|
+        rows = source_rows.map do |source_row|
+          import_row(record_set, source_row)
+        end
+        record_set.model.insert_all!(rows)
+      end
+    end
+
+    def import_row(record_set, source_row)
+      source_id = source_row["id"]
+      raise InvalidArchive, "The account export contains a record without an ID" unless valid_id?(source_id)
+
+      attributes = source_row.slice(*record_set.attributes)
+      attributes["id"] = mapped_id_for(source_id)
+      remap_foreign_keys!(attributes, record_set.model.table_name)
+      remap_json_references!(attributes, record_set.model)
+
+      if record_set.model == ::ActionText::RichText
+        attributes["body"] = Account::DataTransfer::RichText.import_body(
+          attributes["body"],
+          blobs_by_source_id: @blobs_by_source_id,
+          account: target_account
+        )
+        attributes["body"] = ActionText::ContentHelper.sanitizer.sanitize(attributes["body"]) if attributes["body"].present?
+      end
+
+      attributes
+    end
+
+    def remap_json_references!(attributes, model)
+      if model == ::Event && attributes["particulars"].present?
+        particulars = json_value(attributes["particulars"])
+        remap_id_array!(particulars, "assignee_ids", "events.particulars.assignee_ids")
+        nested = particulars["particulars"]
+        remap_id_array!(nested, "assignee_ids", "events.particulars.assignee_ids") if nested.is_a?(Hash)
+        attributes["particulars"] = particulars
+      elsif model == ::Filter && attributes["fields"].present?
+        fields = json_value(attributes["fields"])
+        remap_id_array!(fields, "card_ids", "filters.fields.card_ids")
+        remap_id_array!(fields, "column_ids", "filters.fields.column_ids")
+        attributes["fields"] = fields
+      end
+    end
+
+    def json_value(value)
+      value.is_a?(String) ? JSON.parse(value) : value.deep_dup
+    end
+
+    def remap_id_array!(hash, key, description)
+      if hash[key].present?
+        hash[key] = Array(hash[key]).map do |source_id|
+          mapped_reference(source_id, description)
+        end
+      end
+    end
+
+    def refresh_filter_digests
+      Filter.where(account: target_account).find_each do |filter|
+        filter.update_columns(params_digest: Filter.digest_params(filter.as_params))
+      end
+    end
+
+    def import_entropies(record_set)
+      each_record(record_set.path) do |source_entropy|
+        if source_entropy["container_type"] == "Account"
+          target_entropy = target_account.entropy
+          @id_map[source_entropy.fetch("id")] = target_entropy.id
+          attributes = source_entropy.slice(*Entropy.column_names).except("id")
+          remap_foreign_keys!(attributes, "entropies")
+          target_entropy.update_columns(attributes)
+        else
+          Entropy.insert_all!([ import_row(record_set, source_entropy) ])
+        end
+      end
+    end
+
+    def import_blobs(record_set)
+      each_record(record_set.path) do |source_blob|
+        source_id = source_blob.fetch("id")
+        raise InvalidArchive, "The account export contains an invalid file ID" unless valid_id?(source_id)
+
+        attributes = source_blob.slice(*record_set.attributes)
+        attributes["id"] = mapped_id_for(source_id)
+        attributes["account_id"] = target_account.id
+        attributes["key"] = ActiveStorage::Blob.generate_unique_secure_token
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+        blob = ActiveStorage::Blob.create!(attributes)
+        @blobs_by_source_id[source_id] = blob
+      end
+    end
+
+    def import_files(record_set)
+      @blobs_by_source_id.each do |source_id, blob|
+        entry = @entries.fetch("files/#{source_id}")
+        service = blob.service
+        uploaded_files << [ service, blob.key ]
+        service.upload(
+          blob.key,
+          ZipFile::EntryIO.new(ZipFile::BlobIO.new(@archive_blob), entry, checksum: blob.checksum),
+          checksum: blob.checksum,
+          **blob.service_metadata
+        )
+      end
+    end
+
+    def import_join_rows(record_set)
+      connection = ActiveRecord::Base.connection
+      table = connection.quote_table_name(record_set.table_name)
+      columns = record_set.attributes.map { |column| connection.quote_column_name(column) }
+      sql = "INSERT INTO #{table} (#{columns.join(', ')}) VALUES (#{([ '?' ] * columns.size).join(', ')})"
+      uuid_type = ActiveRecord::Type::Uuid.new
+
+      each_record(record_set.path) do |source_row|
+        attributes = source_row.transform_values { |value| value }
+        attributes.each do |column, value|
+          if column.end_with?("_id") && value.present?
+            attributes[column] = mapped_reference(value, "#{record_set.table_name}.#{column}")
+          end
+        end
+
+        binds = record_set.attributes.map do |column|
+          ActiveRecord::Relation::QueryAttribute.new(column, attributes[column], uuid_type)
+        end
+        connection.exec_query(sql, "Account data transfer", binds)
+      end
+    end
+
+    def grant_importer_access
+      board_ids = target_account.boards.ids
+      existing_ids = Access.where(user_id: owner_user.id, board_id: board_ids).pluck(:board_id).to_set
+      values = board_ids.reject { |board_id| existing_ids.include?(board_id) }.map do |board_id|
+        now = Time.current
+        {
+          id: ActiveRecord::Type::Uuid.generate,
+          account_id: target_account.id,
+          board_id: board_id,
+          user_id: owner_user.id,
+          involvement: "access_only",
+          created_at: now,
+          updated_at: now
+        }
+      end
+
+      Access.insert_all!(values) if values.any?
+    end
+
+    def remap_foreign_keys!(attributes, table_name)
+      attributes.each do |column, value|
+        if column == "account_id"
+          attributes[column] = target_account.id
+        elsif column == "identity_id"
+          attributes[column] = nil
+        elsif column.end_with?("_id") && column != "id" && value.present?
+          attributes[column] = mapped_reference(value, "#{table_name}.#{column}")
+        end
+      end
+    end
+
+    def mapped_reference(source_id, description)
+      if target_id = @id_map[source_id]
+        target_id
+      else
+        raise InvalidArchive, "The account export references a missing record (#{description})"
+      end
+    end
+
+    def mapped_id_for(source_id)
+      @id_map[source_id] ||= ActiveRecord::Type::Uuid.generate
+    end
+
+    def valid_id?(id)
+      id.to_s.match?(SAFE_ID)
+    end
+end
diff --git a/app/models/account/data_transfer/join_record_set.rb b/app/models/account/data_transfer/join_record_set.rb
