+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "a signed export link redirects to the attached ZIP without requiring a session" do
+    export = create_ready_export
+
+    get export_download_path(export.download_token, script_name: "")
+
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/disk/}, response.location
+
+    get URI(response.location).path
+    assert_response :success
+    entries = ZipKit::FileReader.read_zip_structure(io: StringIO.new(response.body)).map(&:filename)
+    assert_includes entries, "hello.txt"
+  end
+
+  test "an export link expires after one day" do
+    export = create_ready_export
+    token = export.download_token
+
+    travel Export::DOWNLOAD_LIFETIME + 1.second do
+      get export_download_path(token, script_name: "")
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def create_ready_export
+      export = accounts(:"37s").exports.create!(requested_by: users(:kevin), kind: :account)
+      ZipFile.create_for(export.file, filename: "account.zip") do |zip|
+        zip.add_file("hello.txt", "Hello, world!")
+      end
+      export.update!(status: :completed, completed_at: Time.current, expires_at: Export::DOWNLOAD_LIFETIME.from_now)
+      export
+    end
+end
