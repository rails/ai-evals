diff --git a/test/jobs/account/data_transfer/import_test.rb b/test/jobs/account/data_transfer/import_test.rb
new file mode 100644
index 0000000..62dc396
--- /dev/null
+++ b/test/jobs/account/data_transfer/import_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Account::DataTransfer::ImportTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @requester = users(:kevin)
+    Current.with(session: sessions(:kevin)) do
+      cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      @comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "comment-image.jpg",
+        content_type: "image/jpeg"
+      )
+      embed = ActionText::Attachment.from_attachable(@comment_blob).to_html
+      comments(:logo_1).update!(body: "A comment with a file #{embed}")
+      @filter = @requester.filters.create!(fields: {
+        card_ids: [ cards(:logo).id ],
+        column_ids: [ columns(:writebook_triage).id ]
+      })
+    end
+  end
+
+  test "restores an exported account as a new account" do
+    export = @account.exports.create!(requested_by: @requester, kind: :account)
+    export.generate
+    assert export.reload.completed?, export.failure_reason
+
+    imported = @account.imports.new(requested_by: @requester)
+    imported.file.attach(io: StringIO.new(export.file.blob.download), filename: "account.zip", content_type: "application/zip")
+    imported.save!
+
+    assert_enqueued_emails 1 do
+      imported.process
+    end
+
+    assert imported.reload.completed?, imported.failure_reason
+    restored = imported.imported_account
+    refute_equal @account.id, restored.id
+    assert_equal @account.name, restored.name
+    assert_equal @account.cards.count, restored.cards.count
+    assert_equal @account.boards.count, restored.boards.count
+    assert_equal @account.users.count, restored.users.count
+    restored_card = restored.cards.find_by!(number: cards(:logo).number)
+    assert restored_card.image.attached?
+    imported_comment = restored_card.comments.find { |comment| comment.body.to_plain_text.include?("A comment with a file") }
+    assert imported_comment
+    restored_embed = imported_comment.rich_text_body.embeds_attachments.first
+    assert_equal @comment_blob.download, restored_embed.blob.download
+
+    restored_assignee = restored.users.find_by!(identity_id: users(:jz).identity_id)
+    restored_assignment_event = Event.where(account: restored).find_by!(
+      eventable: restored_card,
+      action: events(:logo_assignment_jz).action,
+      created_at: events(:logo_assignment_jz).created_at
+    )
+    assert_equal [ restored_assignee.id ], restored_assignment_event.assignee_ids
+
+    restored_filter = restored.users.find_by!(identity_id: @requester.identity_id).filters.find_by!(
+      params_digest: Filter.digest_params(card_ids: [ restored_card.id ])
+    )
+    assert_equal [ restored_card.id ], restored_filter.card_ids
+    assert_equal [ restored_card.column_id ], restored_filter.column_ids
+    assert restored.users.exists?(identity_id: @requester.identity_id, role: :owner)
+    assert_not imported.file.attached?
+  end
+
+  test "a bad ZIP fails with a useful reason and does not create an account" do
+    imported = @account.imports.new(requested_by: @requester)
+    imported.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+    imported.save!
+    initial_account_count = Account.count
+
+    assert_enqueued_emails 1 do
+      imported.process
+    end
+
+    assert imported.reload.failed?
+    assert_match /valid, readable ZIP/, imported.failure_reason
+    assert_equal initial_account_count, Account.count
+    assert_not imported.file.attached?
+  end
+
+  test "rolls back the whole new account if import fails midway" do
+    imported = @account.imports.new(requested_by: @requester)
+    imported.file.attach(io: StringIO.new("backup data"), filename: "backup.zip", content_type: "application/zip")
+    imported.save!
+    initial_account_count = Account.count
+
+    importer = Object.new
+    importer.define_singleton_method(:import) do
+      Account.create!(name: "Partial account")
+      raise Account::DataTransfer::Importer::InvalidArchive, "Invalid account data"
+    end
+    importer.define_singleton_method(:discard_uploaded_files) { }
+    Account::DataTransfer::Importer.stubs(:new).returns(importer)
+
+    assert_enqueued_emails 1 do
+      imported.process
+    end
+
+    assert imported.reload.failed?
+    assert_equal initial_account_count, Account.count
+    assert_nil imported.imported_account_id
+  end
+end
diff --git a/test/jobs/export/generate_job_test.rb b/test/jobs/export/generate_job_test.rb
new file mode 100644
index 0000000..27b0cb3
--- /dev/null
+++ b/test/jobs/export/generate_job_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Export::GenerateJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @requester = users(:kevin)
+    Current.with(session: sessions(:kevin)) do
+      cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      boards(:private).cards.create!(title: "Private board card", status: :published, creator: users(:kevin))
+      comment_blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "comment-image.jpg",
+        content_type: "image/jpeg"
+      )
+      embed = ActionText::Attachment.from_attachable(comment_blob).to_html
+      comments(:logo_1).update!(body: "Comment with an image #{embed}")
+    end
+  end
+
+  test "writes an account ZIP and emails a one-day download link" do
+    export = @account.exports.create!(requested_by: @requester, kind: :account)
+
+    assert_enqueued_emails 1 do
+      Export::GenerateJob.perform_now(export)
+    end
+
+    assert export.reload.completed?, export.failure_reason
+    assert export.file.attached?
+    assert_equal Export::DOWNLOAD_LIFETIME.to_i, (export.expires_at - export.completed_at).to_i
+
+    entries = zip_entries(export.file.blob.download)
+    assert_includes entries, "manifest.json"
+    assert_includes entries, "records/cards.jsonl"
+    assert_includes entries, "records/comments.jsonl"
+    assert entries.any? { |entry| entry.start_with?("files/") }
+  end
+
+  test "writes accessible cards and their comments and attachments only" do
+    export = @account.exports.create!(requested_by: users(:jz), kind: :cards)
+
+    assert_enqueued_emails 1 do
+      Export::GenerateJob.perform_now(export)
+    end
+    assert export.reload.completed?, export.failure_reason
+
+    contents = export.file.blob.download
+    entries = zip_entries(contents)
+    assert_includes entries, "cards/1.json"
+    assert_not_includes entries, "cards/6.json"
+
+    card_json = JSON.parse(zip_entry(contents, "cards/1.json"))
+    assert card_json["comments"].any?
+    assert card_json["comments"].any? { |comment| comment["attachments"].any? }
+    assert card_json["attachments"].any?
+  end
+
+  private
+    def zip_entries(contents)
+      ZipKit::FileReader.read_zip_structure(io: StringIO.new(contents)).map(&:filename)
+    end
+
+    def zip_entry(contents, path)
+      io = StringIO.new(contents)
+      entry = ZipKit::FileReader.read_zip_structure(io: io).find { |candidate| candidate.filename == path }
+      reader = entry.extractor_from(io)
+      result = +"".b
+      result << reader.extract(64.kilobytes) until reader.eof?
+      result
+    end
+end
