index 0000000..38b59f6
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,51 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LIFETIME = 1.day
+
+  belongs_to :account
+  belongs_to :requested_by, class_name: "User"
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  after_create_commit :generate_later
+
+  validate :requested_by_belongs_to_account
+
+  scope :expired, -> { completed.where(expires_at: ...Time.current) }
+
+  def publicly_accessible?
+    completed? && expires_at&.future?
+  end
+
+  def download_token
+    signed_id(expires_at: expires_at || DOWNLOAD_LIFETIME.from_now, purpose: :download)
+  end
+
+  def generate
+    return unless pending?
+
+    update!(status: :processing)
+    Account::DataTransfer::Exporter.new(self).write
+    update!(status: :completed, completed_at: Time.current, expires_at: DOWNLOAD_LIFETIME.from_now)
+    DataTransferMailer.export_ready(self).deliver_later
+  rescue StandardError => error
+    file.purge if file.attached?
+    Rails.error.report(error, context: { export_id: id })
+    update!(status: :failed, failure_reason: error.message.truncate(1000), completed_at: Time.current)
+  end
+
+  def self.cleanup_expired
+    expired.find_each(&:destroy!)
+  end
+
+  private
+    def requested_by_belongs_to_account
+      errors.add(:requested_by, "must belong to the exported account") unless requested_by&.account_id == account_id
+    end
+
+    def generate_later
+      Export::GenerateJob.perform_later(self)
+    end
+end
