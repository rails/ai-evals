@@ -0,0 +1,25 @@
+class ExportsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  before_action :set_active_storage_url_options
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download)
+    if export&.completed? && export.expires_at&.future? && export.file.attached?
+      expires_in = [ export.expires_at - Time.current, Export::DOWNLOAD_LIFETIME ].min
+      redirect_to export.file.blob.url(expires_in: expires_in, disposition: :attachment)
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def set_active_storage_url_options
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port,
+        script_name: request.script_name
+      }
+    end
+end
