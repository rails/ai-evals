diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..e983bbe
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,46 @@
+# Kamal deployment for a single Linux server. Replace the example hostname below.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - fizzy.example.com
+
+# Kamal Proxy obtains and renews a Let's Encrypt certificate for this host.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Keep the image registry on the server; no external registry account is needed.
+registry:
+  server: localhost:5555
+
+# Build for a typical x86_64 Linux VPS, even when deploying from an ARM laptop.
+builder:
+  arch: amd64
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    APP_HOST: fizzy.example.com
+    WEB_CONCURRENCY: "1"
+    JOB_CONCURRENCY: "1"
+    SOLID_QUEUE_IN_PUMA: "true"
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_TLS: "false"
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# Includes the primary, cache, cable, and queue SQLite databases and local uploads.
+volumes:
+  - fizzy_storage:/rails/storage
