+class Admin::LimitOverridesController < AdminController
+  before_action :set_account
+
+  def create
+    @account.update_overridden_limit!(**override_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    @failed_override = error.record
+    render "admin/accounts/show", status: :unprocessable_entity
+  end
+
+  def destroy
+    @account.reset_overridden_limit!
+    redirect_to saas.admin_account_path(@account), notice: "Limit override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def override_params
+      parameters = params.require(:override).permit(:card_count, :bytes_used)
+      { card_count: parameters[:card_count], bytes_used: parameters[:bytes_used] }
+    end
+end
