diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..d1171bc
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+require "ostruct"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  test "account admins can see plan details and the approved prices" do
+    sign_in_as :kevin
+
+    get saas.account_billing_path
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "button", text: "Upgrade"
+    assert_select "li", text: /Unlimited.*\$20\/month.*5 GB/
+    assert_select "li", text: /Unlimited\+.*\$25\/month.*500 GB/
+  end
+
+  test "non-admin account members cannot see billing" do
+    sign_in_as :david
+
+    get saas.account_billing_path
+
+    assert_response :forbidden
+  end
+
+  test "upgrade creates a Stripe Checkout session for the selected plan" do
+    sign_in_as :kevin
+    Billing::StripeConfiguration.stubs(:secret_key).returns("sk_test")
+    Billing::StripeConfiguration.stubs(:price_id).with("STRIPE_PRICE_UNLIMITED").returns("price_unlimited")
+    Stripe::Checkout::Session.expects(:create).with do |parameters|
+      parameters[:mode] == "subscription" &&
+        parameters[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        parameters[:client_reference_id] == accounts(:"37s").id &&
+        parameters[:subscription_data][:metadata][:plan_key] == "unlimited"
+    end.returns(OpenStruct.new(url: "https://checkout.stripe.test/session"))
+
+    post saas.account_billing_checkout_path(plan: "unlimited")
+
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "unknown and free plans cannot start checkout" do
+    sign_in_as :kevin
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_billing_checkout_path(plan: "missing")
+    assert_response :service_unavailable
+
+    post saas.account_billing_checkout_path(plan: "free")
+    assert_response :service_unavailable
+  end
+
+  test "paid account admins are sent to the Stripe customer portal" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(
+      stripe_customer_id: "cus_123",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    Billing::StripeConfiguration.stubs(:secret_key).returns("sk_test")
+    Stripe::BillingPortal::Session.expects(:create).with do |parameters|
+      parameters[:customer] == "cus_123" && parameters[:return_url].include?("/account/settings")
+    end.returns(OpenStruct.new(url: "https://billing.stripe.test/session"))
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.test/session"
+  end
+end
