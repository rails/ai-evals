@@ -0,0 +1,25 @@
+class Account::Billings::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if customer_id.present? && Billing::StripeConfiguration.secret_key.present?
+      Stripe.api_key = Billing::StripeConfiguration.secret_key
+      portal = Stripe::BillingPortal::Session.create(
+        customer: customer_id,
+        return_url: main_app.account_settings_url(account_url_options)
+      )
+      redirect_to portal.url, allow_other_host: true
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  private
+    def customer_id
+      Current.account.subscription&.stripe_customer_id
+    end
+
+    def account_url_options
+      { script_name: Current.account.slug, host: request.host, protocol: request.protocol }
+    end
+end
