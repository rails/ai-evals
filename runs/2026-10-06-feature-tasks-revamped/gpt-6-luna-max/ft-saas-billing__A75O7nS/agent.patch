diff --git a/saas/app/controllers/account/billings/checkouts_controller.rb b/saas/app/controllers/account/billings/checkouts_controller.rb
new file mode 100644
index 0000000..344691f
--- /dev/null
+++ b/saas/app/controllers/account/billings/checkouts_controller.rb
@@ -0,0 +1,48 @@
+class Account::Billings::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Billing::Plan.find(params[:plan])
+
+    if plan&.paid? && plan.stripe_price_id.present? && Billing::StripeConfiguration.secret_key.present?
+      Stripe.api_key = Billing::StripeConfiguration.secret_key
+      session = Stripe::Checkout::Session.create(checkout_session_parameters(plan))
+      redirect_to session.url, allow_other_host: true
+    else
+      head :service_unavailable
+    end
+  end
+
+  private
+    def checkout_session_parameters(plan)
+      parameters = {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: checkout_metadata,
+        subscription_data: { metadata: checkout_metadata },
+        success_url: account_settings_url,
+        cancel_url: main_app.account_settings_url(account_url_options)
+      }
+
+      if Current.account.subscription&.stripe_customer_id.present?
+        parameters[:customer] = Current.account.subscription.stripe_customer_id
+      else
+        parameters[:customer_email] = Current.user.identity.email_address
+      end
+
+      parameters
+    end
+
+    def checkout_metadata
+      { account_id: Current.account.id, plan_key: params[:plan] }
+    end
+
+    def account_settings_url
+      main_app.account_settings_url(account_url_options)
+    end
+
+    def account_url_options
+      { script_name: Current.account.slug, host: request.host, protocol: request.protocol }
+    end
+end
diff --git a/saas/app/controllers/account/billings/portals_controller.rb b/saas/app/controllers/account/billings/portals_controller.rb
