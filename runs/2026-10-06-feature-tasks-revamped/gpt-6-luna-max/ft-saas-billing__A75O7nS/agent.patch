diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..b681cb3
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,41 @@
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(
+      request.raw_post,
+      request.headers["Stripe-Signature"],
+      Billing::StripeConfiguration.webhook_secret
+    )
+
+    process_event(event)
+    head :ok
+  rescue Stripe::SignatureVerificationError, JSON::ParserError, KeyError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      event_type = event_value(event, :type)
+      stripe_object = event_value(event_value(event, :data), :object)
+
+      case event_type
+      when "checkout.session.completed", "checkout.session.async_payment_succeeded"
+        Account::Subscription.record_checkout_session!(stripe_object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        Account::Subscription.sync_from_stripe!(stripe_object)
+      when "customer.subscription.deleted"
+        Account::Subscription.sync_from_stripe!(stripe_object, deleted: true)
+      end
+    end
+
+    def event_value(object, key)
+      if object.respond_to?(key)
+        object.public_send(key)
+      elsif object.respond_to?(:[]) && !object.is_a?(String)
+        object[key] || object[key.to_s]
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..032fdb1
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,85 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active? && (plan = Billing::Plan.find(subscription.plan_key))&.paid?
+      plan
+    elsif comped?
+      Billing::Plan.find("unlimited")
+    else
+      Billing::Plan.free
+    end
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    card_limit ? [ card_limit - card_count, 0 ].max : nil
+  end
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.positive? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def card_limit_reached?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count > card_limit
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    self.billing_waiver = Account::BillingWaiver.create_or_find_by!(account_id: id)
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+    self.billing_waiver = nil
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def update_overridden_limit!(card_count:, bytes_used:)
+    attributes = {
+      card_count: card_count.presence,
+      bytes_used: bytes_used.presence
+    }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      Account::OverriddenLimit.create!(account_id: id, **attributes)
+      association(:overridden_limit).reset
+    end
+  end
+
+  def reset_overridden_limit!
+    overridden_limit&.destroy!
+    self.overridden_limit = nil
+  end
+end
