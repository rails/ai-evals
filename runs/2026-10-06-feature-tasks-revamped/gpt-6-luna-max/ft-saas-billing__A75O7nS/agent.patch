diff --git a/saas/test/models/billing/plan_test.rb b/saas/test/models/billing/plan_test.rb
new file mode 100644
index 0000000..c551a75
--- /dev/null
+++ b/saas/test/models/billing/plan_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class Billing::PlanTest < ActiveSupport::TestCase
+  test "the approved plans define their card and storage allowances" do
+    free, unlimited, unlimited_plus = Billing::Plan.all
+
+    assert_equal [ "Free", 0, 1_000, 1.gigabyte ], [ free.name, free.monthly_price_cents, free.card_limit, free.storage_limit ]
+    assert_equal [ "Unlimited", 2_000, nil, 5.gigabytes ], [ unlimited.name, unlimited.monthly_price_cents, unlimited.card_limit, unlimited.storage_limit ]
+    assert_equal [ "Unlimited+", 2_500, nil, 500.gigabytes ], [ unlimited_plus.name, unlimited_plus.monthly_price_cents, unlimited_plus.card_limit, unlimited_plus.storage_limit ]
+  end
+
+  test "paid plan prices are described per month" do
+    assert_equal "$20/month", Billing::Plan.find("unlimited").monthly_price_label
+    assert_equal "$25/month", Billing::Plan.find("unlimited_plus").monthly_price_label
+  end
+end
