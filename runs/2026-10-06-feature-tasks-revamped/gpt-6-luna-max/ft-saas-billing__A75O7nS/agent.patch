+  end
+
+  test "subscription webhooks activate and update the account plan" do
+    account = accounts(:initech)
+    stripe_subscription = {
+      id: "sub_123",
+      customer: "cus_123",
+      status: "active",
+      current_period_end: 1_800_000_000,
+      metadata: { account_id: account.id, plan_key: "unlimited_plus" },
+      items: { data: [ { price: { id: "price_unlimited_plus" } } ] }
+    }
+    stub_webhook("customer.subscription.created", stripe_subscription)
+
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: webhook_headers
+    end
+
+    assert_response :ok
+    subscription = Account::Subscription.find_by!(account: account)
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal Time.at(1_800_000_000).utc, subscription.current_period_end
+  end
+
+  test "deleted subscriptions return the account to Free" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    stub_webhook("customer.subscription.deleted", {
+      id: "sub_123", customer: "cus_123", status: "canceled", metadata: { account_id: account.id }
+    })
+
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: webhook_headers
+    end
+
+    assert_response :ok
+    account.reload
+    assert_equal "Free", account.billing_plan.name
+    assert_equal "canceled", account.subscription.reload.status
+  end
+
+  test "checkout completion saves the Stripe customer and selected plan" do
+    account = accounts(:initech)
+    session = {
+      client_reference_id: account.id,
+      customer: "cus_checkout",
+      subscription: "sub_checkout",
+      metadata: { account_id: account.id, plan_key: "unlimited" }
+    }
+    stub_webhook("checkout.session.completed", session)
+
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: webhook_headers
+    end
+
+    assert_response :ok
+    assert_equal "cus_checkout", account.subscription.stripe_customer_id
+    assert_equal "unlimited", account.subscription.plan_key
+  end
+
+  test "invalid Stripe signatures are rejected" do
+    Stripe::Webhook.stubs(:construct_event).raises(Stripe::SignatureVerificationError.new("Invalid signature", "bad"))
+
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: webhook_headers
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def webhook_headers
+      { "Content-Type" => "application/json", "Stripe-Signature" => "sig_test" }
+    end
+
+    def stub_webhook(type, object)
+      Stripe::Webhook.stubs(:construct_event).with(anything, "sig_test", "whsec_test").returns(
+        { type: type, data: { object: object } }
+      )
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..ced51dd
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts default to Free limits" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "card count warnings start 100 cards from the limit" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column(:cards_count, 1_000)
+    assert_not @account.nearing_card_limit?
+    assert @account.card_limit_reached?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1_001)
+    assert @account.exceeding_card_limit?
+  end
+
+  test "an active subscription selects its plan and its storage allowance" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active")
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_nil @account.cards_remaining
+  end
+
+  test "a canceled subscription falls back to Free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "canceled")
+
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping grants Unlimited and uncomping restores the subscription or Free plan" do
+    @account.comp!
+    assert @account.comped?
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.card_limit
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert_equal "Free", @account.billing_plan.name
+  end
+
+  test "comped accounts retain an active paid plan" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active")
+    @account.comp!
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+  end
+
+  test "usage overrides replace card count and storage used until reset" do
+    @account.update_column(:cards_count, 10)
+    @account.update_overridden_limit!(card_count: "950", bytes_used: "123456")
+
+    assert_equal 950, @account.card_count
+    assert_equal 123_456, @account.bytes_used
+    assert @account.nearing_card_limit?
+
+    @account.reset_overridden_limit!
+    assert_equal 10, @account.card_count
+    assert_equal 0, @account.bytes_used
+  end
+end
