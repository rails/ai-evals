diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..e872c83
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,96 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :account_id, uniqueness: true
+
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    Billing::Plan.find(plan_key)
+  end
+
+  class << self
+    def record_checkout_session!(session)
+      account_id = value(session, :client_reference_id).presence || value(value(session, :metadata), :account_id)
+      account = Account.find_by(id: account_id)
+      return unless account
+
+      subscription = for_account(account)
+      subscription.assign_attributes(
+        stripe_customer_id: stripe_id(value(session, :customer)),
+        stripe_subscription_id: stripe_id(value(session, :subscription)),
+        plan_key: paid_plan_key(value(value(session, :metadata), :plan_key)) || subscription.plan_key,
+        status: subscription.status.presence || "incomplete"
+      )
+      subscription.save!
+    end
+
+    def sync_from_stripe!(stripe_subscription, deleted: false)
+      stripe_subscription_id = stripe_id(value(stripe_subscription, :id))
+      customer_id = stripe_id(value(stripe_subscription, :customer))
+      metadata = value(stripe_subscription, :metadata)
+
+      subscription = find_by(stripe_subscription_id: stripe_subscription_id) if stripe_subscription_id.present?
+      subscription ||= find_by(stripe_customer_id: customer_id) if customer_id.present?
+      account = subscription&.account || Account.find_by(id: value(metadata, :account_id))
+      return unless account
+
+      subscription ||= for_account(account)
+      price_id = first_price_id(stripe_subscription)
+      plan_key = Billing::Plan.find_by_stripe_price_id(price_id)&.key || paid_plan_key(value(metadata, :plan_key))
+
+      subscription.assign_attributes(
+        stripe_customer_id: customer_id.presence || subscription.stripe_customer_id,
+        stripe_subscription_id: stripe_subscription_id.presence || subscription.stripe_subscription_id,
+        plan_key: plan_key.presence || subscription.plan_key,
+        status: deleted ? "canceled" : value(stripe_subscription, :status),
+        current_period_end: timestamp(value(stripe_subscription, :current_period_end)),
+        cancel_at: timestamp(value(stripe_subscription, :cancel_at))
+      )
+      subscription.save!
+    end
+
+    private
+      def for_account(account)
+        find_by(account_id: account.id) || new(account: account)
+      end
+
+      def paid_plan_key(key)
+        plan = Billing::Plan.find(key)
+        plan.key if plan&.paid?
+      end
+
+      def first_price_id(stripe_subscription)
+        items = value(stripe_subscription, :items)
+        first_item = Array(value(items, :data)).first
+        price = value(first_item, :price) || value(first_item, :plan)
+        stripe_id(value(price, :id)) || stripe_id(price)
+      end
+
+      def stripe_id(value)
+        value(value, :id).presence || value
+      end
+
+      def timestamp(value)
+        if value.is_a?(Numeric)
+          Time.at(value).utc
+        elsif value.present? && !value.is_a?(Time)
+          Time.zone.parse(value.to_s)
+        else
+          value
+        end
+      end
+
+      def value(object, key)
+        if object.respond_to?(key)
+          object.public_send(key)
+        elsif object.respond_to?(:[]) && !object.is_a?(String)
+          object[key] || object[key.to_s]
+        end
+      end
+  end
+end
diff --git a/saas/app/models/billing/plan.rb b/saas/app/models/billing/plan.rb
new file mode 100644
index 0000000..4aa0d63
--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,55 @@
+module Billing
+  class Plan
+    attr_reader :key, :name, :monthly_price_cents, :card_limit, :storage_limit, :stripe_price_env
+
+    DEFINITIONS = [
+      { key: "free", name: "Free", monthly_price_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+      { key: "unlimited", name: "Unlimited", monthly_price_cents: 2_000, card_limit: nil, storage_limit: 5.gigabytes, stripe_price_env: "STRIPE_PRICE_UNLIMITED" },
+      { key: "unlimited_plus", name: "Unlimited+", monthly_price_cents: 2_500, card_limit: nil, storage_limit: 500.gigabytes, stripe_price_env: "STRIPE_PRICE_UNLIMITED_PLUS" }
+    ].freeze
+
+    def initialize(key:, name:, monthly_price_cents:, card_limit:, storage_limit:, stripe_price_env: nil)
+      @key = key
+      @name = name
+      @monthly_price_cents = monthly_price_cents
+      @card_limit = card_limit
+      @storage_limit = storage_limit
+      @stripe_price_env = stripe_price_env
+      freeze
+    end
+
+    def paid?
+      monthly_price_cents.positive?
+    end
+
+    def unlimited_cards?
+      card_limit.nil?
+    end
+
+    def stripe_price_id
+      Billing::StripeConfiguration.price_id(stripe_price_env) if stripe_price_env
+    end
+
+    def monthly_price_label
+      paid? ? "$#{monthly_price_cents / 100}/month" : "Free"
+    end
+
+    class << self
+      def all
+        @all ||= DEFINITIONS.map { |attributes| new(**attributes) }.freeze
+      end
+
+      def find(key)
+        all.find { |plan| plan.key == key.to_s }
+      end
+
+      def free
+        find("free")
+      end
+
+      def find_by_stripe_price_id(price_id)
+        all.find { |plan| plan.paid? && plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+      end
+    end
+  end
+end
