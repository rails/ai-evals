index 0000000..870515b
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,140 @@
+require "application_system_test_case"
+require "timeout"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @source_column = @card.column
+    @destination_column = columns(:writebook_on_hold)
+  end
+
+  test "dragging a card moves it before the save responds" do
+    visit board_path(@board)
+    expand_column(dom_id(@source_column))
+
+    card_id = dom_id(@card, :article)
+    source_id = dom_id(@source_column)
+    destination_id = dom_id(@destination_column)
+    assert_selector "##{source_id} ##{card_id}", wait: 5
+    source_count = page.evaluate_script("Number(document.getElementById('#{source_id}').dataset.dragAndDropCount)")
+    destination_count = page.evaluate_script("Number(document.getElementById('#{destination_id}').dataset.dragAndDropCount)")
+
+    page.execute_script <<~JAVASCRIPT
+      window.dragAndDropRequestStarted = false
+      window.fetch = () => {
+        window.dragAndDropRequestStarted = true
+        return new Promise(() => {})
+      }
+    JAVASCRIPT
+
+    drag_card_to(card_id, destination_id)
+
+    assert_selector "##{destination_id} ##{card_id}", visible: :all
+    assert_no_selector "##{source_id} ##{card_id}", visible: :all
+    assert_no_selector "##{destination_id} .blank-slate", visible: :all
+    assert page.evaluate_script("window.dragAndDropRequestStarted")
+    assert page.evaluate_script("window.dragAndDropFeedback.cardDimmed")
+    assert_equal "0.6", page.evaluate_script("window.dragAndDropFeedback.cardOpacity")
+    assert page.evaluate_script("window.dragAndDropFeedback.columnHighlighted")
+    assert_equal source_count - 1, page.evaluate_script("Number(document.getElementById('#{source_id}').dataset.dragAndDropCount)")
+    assert_equal destination_count + 1, page.evaluate_script("Number(document.getElementById('#{destination_id}').dataset.dragAndDropCount)")
+  end
+
+  test "moving a card persists its column without reordering board columns" do
+    column_order = @board.columns.sorted.pluck(:id)
+    visit board_path(@board)
+    expand_column(dom_id(@source_column))
+
+    drag_card_to(dom_id(@card, :article), dom_id(@destination_column))
+    wait_for { @card.reload.column_id == @destination_column.id }
+
+    assert_equal column_order, @board.columns.sorted.pluck(:id)
+    assert_selector "##{dom_id(@destination_column)} ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "dragging between status columns persists each status change" do
+    visit board_path(@board)
+    expand_column(dom_id(@source_column))
+    card_id = dom_id(@card, :article)
+
+    drag_card_to(card_id, "not-now")
+    wait_for { @card.reload.postponed? }
+    assert_selector "#not-now ##{card_id}", visible: :all
+
+    expand_column("not-now")
+    drag_card_to(card_id, "maybe")
+    wait_for { @card.reload.awaiting_triage? }
+    assert_selector "#not-now .blank-slate--drag", visible: :all
+    assert_selector "#maybe ##{card_id}", visible: :all
+
+    drag_card_to(card_id, "closed-cards")
+    wait_for { @card.reload.closed? }
+    assert_selector "#closed-cards ##{card_id}", visible: :all
+  end
+
+  test "dropping a card in its current column does not reorder cards" do
+    visit board_path(@board)
+    source_id = dom_id(@source_column)
+    expand_column(source_id)
+
+    card_id = dom_id(@card, :article)
+    original_order = page.evaluate_script(<<~JAVASCRIPT, source_id)
+      Array.from(document.querySelectorAll(`#${arguments[0]} .cards__list .card`), card => card.id)
+    JAVASCRIPT
+
+    page.execute_script <<~JAVASCRIPT
+      window.dragAndDropRequestCount = 0
+      window.fetch = () => {
+        window.dragAndDropRequestCount += 1
+        return new Promise(() => {})
+      }
+    JAVASCRIPT
+
+    drag_card_to(card_id, source_id)
+
+    new_order = page.evaluate_script(<<~JAVASCRIPT, source_id)
+      Array.from(document.querySelectorAll(`#${arguments[0]} .cards__list .card`), card => card.id)
+    JAVASCRIPT
+
+    assert_equal original_order, new_order
+    assert_equal 0, page.evaluate_script("window.dragAndDropRequestCount")
+  end
+
+  private
+    def drag_card_to(card_id, destination_id)
+      assert_selector "##{card_id}", visible: :all, wait: 5
+      assert_selector "##{destination_id}", visible: :all, wait: 5
+
+      page.execute_script <<~JAVASCRIPT, card_id, destination_id
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        const cardDimmed = card.classList.contains("drag-and-drop__dragged-item")
+        const cardOpacity = getComputedStyle(card).opacity
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        const columnHighlighted = destination.classList.contains("drag-and-drop__hover-container")
+        window.dragAndDropFeedback = { cardDimmed, cardOpacity, columnHighlighted }
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JAVASCRIPT
+    end
+
+    def expand_column(column_id)
+      page.execute_script <<~JAVASCRIPT, column_id
+        const column = document.getElementById(arguments[0])
+        if (column.classList.contains("is-collapsed")) column.querySelector(".cards__expander").click()
+      JAVASCRIPT
+    end
+
+    def wait_for
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until yield
+      end
+    end
+end
