diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d51b5e6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,294 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const MAX_PROGRESS_CARDS = 15
+
+export default class extends Controller {
+  static targets = [ "column" ]
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+    this.pendingRequests = new WeakMap()
+    this.revisions = new WeakMap()
+  }
+
+  disconnect() {
+    this.#clearDragState()
+  }
+
+  start(event) {
+    const card = this.#cardFor(event.target)
+
+    if (!card || !event.dataTransfer) return
+
+    if (window.matchMedia("(max-width: 639px)").matches) {
+      event.preventDefault()
+    } else {
+      this.draggedCard = card
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+      card.classList.add(DRAGGED_ITEM_CLASS)
+    }
+  }
+
+  end() {
+    this.#clearDragState()
+  }
+
+  over(event) {
+    const column = this.#columnFor(event.target)
+
+    if (this.draggedCard && column) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#setHoveredColumn(column)
+    }
+  }
+
+  leave(event) {
+    const column = this.#columnFor(event.target)
+
+    if (column && column === this.hoveredColumn && !column.contains(event.relatedTarget)) {
+      this.#clearHoveredColumn()
+    }
+  }
+
+  drop(event) {
+    const destination = this.#columnFor(event.target)
+    const card = this.draggedCard
+
+    if (!destination || !card) return
+
+    event.preventDefault()
+    this.#clearHoveredColumn()
+
+    const source = this.#columnFor(card)
+    const request = this.#requestFor(card, destination)
+
+    if (!source || !request || source === destination) return
+    if (source.dataset.dragAndDropLocation === destination.dataset.dragAndDropLocation) return
+
+    const sourceList = card.closest(".cards__list")
+    const destinationList = this.#listFor(destination)
+
+    if (!sourceList || !destinationList) return
+
+    const snapshot = this.#snapshot(card)
+    const revision = (this.revisions.get(card) || 0) + 1
+    this.revisions.set(card, revision)
+
+    this.#insertCard(card, destinationList, destination)
+    this.#updateCardStatus(card, destination)
+    card.dataset.dragAndDropLocation = destination.dataset.dragAndDropLocation
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+    this.#updateEmptyState(sourceList)
+    this.#persist(card, request, snapshot, source, revision)
+  }
+
+  #cardFor(element) {
+    if (!(element instanceof Element)) return null
+
+    const card = element.closest("article.card[draggable='true'][data-drag-and-drop-location]")
+    return card && this.element.contains(card) ? card : null
+  }
+
+  #columnFor(element) {
+    if (!(element instanceof Element)) return null
+
+    const column = element.closest("[data-drag-and-drop-target~='column']")
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  #requestFor(card, destination) {
+    switch (destination.dataset.dragAndDropType) {
+      case "column": {
+        const url = new URL(card.dataset.cardTriageUrl, window.location.href)
+        url.searchParams.set("column_id", destination.dataset.dragAndDropColumnId)
+        return { method: "POST", url: url.toString() }
+      }
+      case "maybe":
+        return { method: "DELETE", url: card.dataset.cardTriageUrl }
+      case "not-now":
+        return { method: "POST", url: card.dataset.cardNotNowUrl }
+      case "closed":
+        return { method: "POST", url: card.dataset.cardClosureUrl }
+    }
+  }
+
+  #listFor(column) {
+    let list = column.querySelector(".cards__list")
+
+    if (!list) {
+      const container = column.querySelector("turbo-frame") || column
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      container.append(list)
+    }
+
+    return list
+  }
+
+  #insertCard(card, list, destination) {
+    const cards = Array.from(list.querySelectorAll(".card"))
+    const type = destination.dataset.dragAndDropType
+
+    if (type === "column" || type === "maybe") {
+      if (card.classList.contains("golden-effect")) {
+        if (cards[0]) {
+          cards[0].before(card)
+        } else {
+          list.prepend(card)
+        }
+      } else {
+        const firstNonGoldenCard = cards.find(existingCard => !existingCard.classList.contains("golden-effect"))
+
+        if (firstNonGoldenCard) {
+          firstNonGoldenCard.before(card)
+        } else if (cards.length > 0) {
+          cards[cards.length - 1].after(card)
+        } else {
+          list.prepend(card)
+        }
+      }
+    } else if (cards[0]) {
+      cards[0].before(card)
+    } else {
+      list.prepend(card)
+    }
+
+    list.querySelectorAll(".blank-slate").forEach(placeholder => placeholder.remove())
+  }
+
+  #updateCardStatus(card, destination) {
+    card.querySelector(".card__closed")?.remove()
+    card.classList.remove("card--postponed")
+    card.classList.toggle("card--active", [ "column", "maybe" ].includes(destination.dataset.dragAndDropType))
+
+    if (destination.dataset.dragAndDropType === "not-now") {
+      card.classList.add("card--postponed")
+      card.append(this.#statusStamp("Not Now"))
+    } else if (destination.dataset.dragAndDropType === "closed") {
+      card.append(this.#statusStamp("Done"))
+    }
+  }
+
+  #statusStamp(title) {
+    const stamp = document.createElement("div")
+    const label = document.createElement("span")
+
+    stamp.className = "card__closed"
+    label.className = "card__closed-title"
+    label.dataset.text = title
+    label.textContent = title
+    stamp.append(label)
+
+    return stamp
+  }
+
+  #adjustCount(column, difference) {
+    const count = Number(column.dataset.dragAndDropCount)
+
+    if (!Number.isFinite(count)) return
+
+    const updatedCount = Math.max(0, count + difference)
+    column.dataset.dragAndDropCount = updatedCount
+    column.querySelector(".cards__expander")?.style.setProperty("--card-count", Math.min(updatedCount, MAX_PROGRESS_CARDS))
+
+    const countElement = column.querySelector(".cards__expander-count")
+    if (countElement) countElement.textContent = updatedCount > 99 ? "99+" : updatedCount
+  }
+
+  #updateEmptyState(list) {
+    if (list.querySelector(".card, .pagination-link")) return
+
+    if (!list.querySelector(".blank-slate--default")) {
+      const defaultPlaceholder = document.createElement("div")
+      defaultPlaceholder.className = "blank-slate blank-slate--default"
+      defaultPlaceholder.textContent = "No cards here"
+      list.append(defaultPlaceholder)
+    }
+
+    if (!list.querySelector(".blank-slate--drag")) {
+      const dragPlaceholder = document.createElement("div")
+      dragPlaceholder.className = "blank-slate blank-slate--drag overflow-ellipsis"
+      dragPlaceholder.textContent = "Drag cards here"
+      list.append(dragPlaceholder)
+    }
+  }
+
+  #snapshot(card) {
+    return {
+      className: card.className,
+      location: card.dataset.dragAndDropLocation,
+      parent: card.parentElement,
+      nextSibling: card.nextSibling,
+      statusStamp: card.querySelector(".card__closed")?.cloneNode(true)
+    }
+  }
+
+  #persist(card, request, snapshot, source, revision) {
+    const previousRequest = this.pendingRequests.get(card) || Promise.resolve()
+    const save = previousRequest
+      .catch(() => {})
+      .then(() => new FetchRequest(request.method, request.url, { responseKind: "json" }).perform())
+      .then(response => {
+        if (!response.ok) throw new Error(`Card move failed with status ${response.statusCode}`)
+      })
+
+    this.pendingRequests.set(card, save)
+
+    save.catch(error => {
+      if (this.revisions.get(card) === revision) {
+        this.#restoreCard(card, snapshot, source)
+      }
+      console.error(error)
+    }).then(() => {
+      if (this.pendingRequests.get(card) === save) this.pendingRequests.delete(card)
+    })
+  }
+
+  #restoreCard(card, snapshot, source) {
+    if (!snapshot.parent.isConnected) return
+
+    const currentColumn = this.#columnFor(card)
+    const currentList = card.closest(".cards__list")
+
+    if (currentColumn) this.#adjustCount(currentColumn, -1)
+    this.#adjustCount(source, 1)
+
+    const nextSibling = snapshot.nextSibling?.parentNode === snapshot.parent ? snapshot.nextSibling : null
+    snapshot.parent.insertBefore(card, nextSibling)
+
+    card.className = snapshot.className
+    card.dataset.dragAndDropLocation = snapshot.location
+    card.querySelector(".card__closed")?.remove()
+    if (snapshot.statusStamp) card.append(snapshot.statusStamp)
+
+    if (currentList) this.#updateEmptyState(currentList)
+    const sourceList = card.closest(".cards__list")
+    if (sourceList) this.#updateEmptyState(sourceList)
+  }
+
+  #setHoveredColumn(column) {
+    if (this.hoveredColumn === column) return
+
+    this.#clearHoveredColumn()
+    this.hoveredColumn = column
+    column.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #clearHoveredColumn() {
+    this.hoveredColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = null
+  }
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedCard = null
+    this.#clearHoveredColumn()
+  }
+}
