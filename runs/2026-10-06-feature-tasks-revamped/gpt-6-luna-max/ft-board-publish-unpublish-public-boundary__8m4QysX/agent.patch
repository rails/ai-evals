index 0000000..fe6e37b
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "anyone can show a published board" do
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "the board lists published cards using public card URLs but excludes drafts" do
+    draft = @board.cards.create!(creator: users(:kevin), title: "Private draft", status: :drafted)
+
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@board.public_key, cards(:logo).number)
+    assert_select "a[href=?]", public_board_card_path(@board.public_key, draft.number), count: 0
+    assert_select "body", text: /The logo isn't big enough/
+    assert_select "body", text: /Private draft/, count: 0
+  end
+
+  test "an unpublished board is not found" do
+    public_key = @board.public_key
+    @board.unpublish
+
+    get public_board_path(public_key)
+
+    assert_response :not_found
+  end
+
+  test "a key is not accessible through another account's URL" do
+    other_account_board = boards(:miltons_wish_list)
+    other_account_board.publish
+
+    get public_board_path(other_account_board.public_key)
+
+    assert_response :not_found
+  end
+
+  test "an unknown key is not found" do
+    get public_board_path("unknown-public-key")
+
+    assert_response :not_found
+  end
+end
