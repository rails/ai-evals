@@ -0,0 +1,36 @@
+require "test_helper"
+
+class PublicBoardCardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "anyone can open a published card on a published board" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.public_key, card.number)
+
+    assert_response :success
+    assert_select "h1", text: /#{Regexp.escape(card.title)}/
+    assert_select "a[href=?]", public_board_path(@board.public_key)
+  end
+
+  test "drafted cards are not available publicly" do
+    draft = @board.cards.create!(creator: users(:kevin), title: "Private draft", status: :drafted)
+
+    get public_board_card_path(@board.public_key, draft.number)
+
+    assert_response :not_found
+  end
+
+  test "cards from another board are not available through this board's key" do
+    other_board = boards(:private)
+    card = other_board.cards.create!(creator: users(:kevin), title: "Private board card", status: :drafted)
+    card.update_column(:status, "published")
+
+    get public_board_card_path(@board.public_key, card.number)
+
+    assert_response :not_found
+  end
+end
