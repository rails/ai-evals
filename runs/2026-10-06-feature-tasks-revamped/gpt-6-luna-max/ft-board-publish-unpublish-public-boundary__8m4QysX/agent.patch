+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    layout "public"
+    allow_unauthenticated_access
+    before_action :set_public_board
+  end
+
+  private
+    def set_public_board
+      public_key = params[:board_key] || params[:key]
+      @board = Current.account.boards.where.not(public_key: nil).find_by!(public_key: public_key)
+    end
+end
