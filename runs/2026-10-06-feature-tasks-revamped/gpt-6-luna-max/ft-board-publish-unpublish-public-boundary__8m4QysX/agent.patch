--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -1,4 +1,6 @@
 class Board < ApplicationRecord
+  PUBLIC_KEY_LENGTH = 24
+
   include Accessible, AutoPostponing, Board::Storage, Broadcastable, Cards, Entropic, Filterable, ::Storage::Tracked, Triageable
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
@@ -10,4 +12,22 @@ class Board < ApplicationRecord
 
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+
+  def publish
+    with_lock do
+      update!(public_key: generate_public_key) if public_key.blank?
+    end
+  end
+
+  def unpublish
+    update!(public_key: nil) if public_key.present?
+  end
+
+  private
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break candidate unless self.class.exists?(public_key: candidate)
+      end
+    end
 end
