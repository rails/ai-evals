diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..9c9be10
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,363 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card" ]
+
+  #pendingMoves = new WeakMap()
+  #latestMove = new WeakMap()
+  #rollbackPositions = new WeakMap()
+  #desktop
+  #updateDraggableCards = () => {
+    this.cardTargets.forEach(card => card.draggable = this.#desktop.matches)
+  }
+
+  connect() {
+    this.#desktop = window.matchMedia("(min-width: 640px)")
+    this.#desktop.addEventListener("change", this.#updateDraggableCards)
+    this.#updateDraggableCards()
+  }
+
+  disconnect() {
+    this.#desktop?.removeEventListener("change", this.#updateDraggableCards)
+    this.#finishDrag()
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = this.#desktop?.matches ?? false
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    const column = this.#columnFor(card)
+
+    if (card && column && this.#desktop.matches) {
+      this.draggedCard = card
+      this.sourceColumn = column
+      card.classList.add("drag-and-drop__dragged-item")
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    } else {
+      event.preventDefault()
+    }
+  }
+
+  dragover(event) {
+    if (this.draggedCard) {
+      const column = this.#columnFor(event.target)
+
+      if (column && column !== this.sourceColumn && this.#moveFor(this.draggedCard, column)) {
+        event.preventDefault()
+        event.dataTransfer.dropEffect = "move"
+        this.#highlight(column)
+      } else {
+        this.#clearHighlight()
+      }
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const destinationColumn = this.#columnFor(event.target)
+
+    if (card && destinationColumn && destinationColumn !== this.sourceColumn) {
+      const move = this.#moveFor(card, destinationColumn)
+
+      if (move) {
+        event.preventDefault()
+
+        const destinationList = destinationColumn.querySelector(".cards__list")
+        const sourceColumn = this.sourceColumn
+
+        if (destinationList) {
+          const originalPosition = {
+            parent: card.parentElement,
+            nextSibling: card.nextSibling,
+            previousSibling: card.previousSibling,
+            classNames: Array.from(card.classList).filter(name => name !== "drag-and-drop__dragged-item"),
+            action: card.getAttribute("data-action"),
+            style: card.getAttribute("style"),
+            columnBadge: card.querySelector("[data-card-column-name]"),
+            columnBadgeName: card.querySelector("[data-card-column-name] .overflow-ellipsis")?.textContent,
+            columnBadgeNextSibling: card.querySelector("[data-card-column-name]")?.nextSibling,
+            currentStages: Array.from(card.querySelectorAll(".card__stages .card__column-name--current")),
+            lastUpdated: card.querySelector(".card__meta-text--updated time"),
+            lastUpdatedDatetime: card.querySelector(".card__meta-text--updated time")?.getAttribute("datetime"),
+            lastUpdatedText: card.querySelector(".card__meta-text--updated time")?.innerHTML,
+            lastUpdatedTitle: card.querySelector(".card__meta-text--updated time")?.getAttribute("title"),
+            sourceColumn
+          }
+          const moveId = {}
+
+          this.#latestMove.set(card, moveId)
+          this.#insertCard(card, destinationList, destinationColumn)
+          this.#updateCardState(card, destinationColumn)
+          this.#adjustCount(sourceColumn, -1)
+          this.#adjustCount(destinationColumn, 1)
+          this.#persistMove(card, move, moveId, originalPosition)
+        }
+      }
+    }
+
+    this.#finishDrag()
+  }
+
+  end() {
+    this.#finishDrag()
+  }
+
+  #columnFor(element) {
+    return element?.closest('[data-drag-and-drop-target~="column"]')
+  }
+
+  #moveFor(card, column) {
+    const triageUrl = card.dataset.cardTriageUrl
+    let move
+
+    switch (column.dataset.dragAndDropStatus) {
+      case "triage":
+        move = { url: triageUrl, method: "DELETE" }
+        break
+      case "not-now":
+        move = { url: card.dataset.cardNotNowUrl, method: "POST" }
+        break
+      case "closed":
+        move = { url: card.dataset.cardClosureUrl, method: "POST" }
+        break
+      default:
+        if (column.dataset.dragAndDropColumnId) {
+          move = {
+            url: triageUrl,
+            method: "POST",
+            params: { column_id: column.dataset.dragAndDropColumnId }
+          }
+        }
+    }
+
+    return move?.url ? move : null
+  }
+
+  #insertCard(card, list, column) {
+    const isActiveColumn = column.dataset.dragAndDropStatus === "triage" || column.dataset.dragAndDropColumnId
+
+    if (isActiveColumn && !card.classList.contains("golden-effect")) {
+      const lastGoldenCard = Array.from(list.querySelectorAll(".card"))
+        .reverse()
+        .find(existingCard => existingCard.classList.contains("golden-effect"))
+
+      if (lastGoldenCard) {
+        lastGoldenCard.after(card)
+        return
+      }
+    }
+
+    list.prepend(card)
+  }
+
+  #updateCardState(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const columnId = column.dataset.dragAndDropColumnId
+    const isActive = status === "triage" || Boolean(columnId)
+
+    card.classList.toggle("card--active", isActive)
+    card.classList.toggle("card--postponed", status === "not-now")
+
+    const hoverAction = "mouseenter->navigable-list#hoverSelect"
+    if (isActive) {
+      card.dataset.action = hoverAction
+    } else if (card.dataset.action === hoverAction) {
+      delete card.dataset.action
+    }
+
+    const cardColor = columnId
+      ? getComputedStyle(column).getPropertyValue("--card-color")
+      : card.dataset.cardDefaultColor
+
+    if (cardColor) card.style.setProperty("--card-color", cardColor)
+
+    if (columnId) {
+      this.#setCurrentColumn(card, column)
+    } else {
+      this.#removeColumnBadge(card)
+      if (status !== "closed") this.#clearCurrentColumnStages(card)
+    }
+
+    this.#updateLastActiveAt(card)
+  }
+
+  #updateLastActiveAt(card) {
+    const updatedAt = card.querySelector(".card__meta-text--updated time")
+
+    if (updatedAt) {
+      updatedAt.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedAt.dispatchEvent(new Event("turbo:morph-element", { bubbles: true }))
+    }
+  }
+
+  #setCurrentColumn(card, column) {
+    const currentColumn = card.querySelector("[data-card-column-name]")
+    const columnName = column.dataset.columnName
+
+    if (currentColumn) {
+      currentColumn.querySelector(".overflow-ellipsis").textContent = columnName
+    } else {
+      const badge = document.createElement("span")
+      const name = document.createElement("span")
+
+      badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      badge.dataset.cardColumnName = ""
+      name.className = "overflow-ellipsis"
+      name.textContent = columnName
+      badge.append(name)
+      card.querySelector(".card__header").append(badge)
+    }
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === column.dataset.dragAndDropColumnId)
+    })
+  }
+
+  #removeColumnBadge(card) {
+    card.querySelector("[data-card-column-name]")?.remove()
+  }
+
+  #clearCurrentColumnStages(card) {
+    card.querySelectorAll(".card__stages .card__column-name--current").forEach(stage => {
+      stage.classList.remove("card__column-name--current")
+    })
+  }
+
+  #highlight(column) {
+    if (this.hoveredColumn !== column) {
+      this.#clearHighlight()
+      this.hoveredColumn = column
+      column.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  #clearHighlight() {
+    this.hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+    this.hoveredColumn = null
+  }
+
+  #finishDrag() {
+    this.draggedCard?.classList.remove("drag-and-drop__dragged-item")
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.#clearHighlight()
+  }
+
+  #adjustCount(column, change) {
+    const count = Number(column.dataset.dragAndDropCount)
+
+    if (Number.isInteger(count)) {
+      const newCount = Math.max(0, count + change)
+      const countElement = column.querySelector(".cards__expander-count")
+
+      column.dataset.dragAndDropCount = newCount
+      if (countElement) countElement.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  #persistMove(card, move, moveId, originalPosition) {
+    const previousMove = this.#pendingMoves.get(card) || Promise.resolve(true)
+    const save = previousMove.then(async previousSucceeded => {
+      if (previousSucceeded) this.#rollbackPositions.set(card, originalPosition)
+
+      try {
+        const request = { responseKind: "json" }
+
+        if (move.params) {
+          request.body = new FormData()
+          Object.entries(move.params).forEach(([ name, value ]) => request.body.append(name, value))
+        }
+
+        const response = await new FetchRequest(move.method, move.url, request).perform()
+
+        if (!response.ok) throw new Error(`Card move failed with status ${response.statusCode}`)
+
+        if (this.#latestMove.get(card) === moveId) {
+          this.#latestMove.delete(card)
+          this.#rollbackPositions.delete(card)
+        }
+
+        return true
+      } catch (error) {
+        console.error("Unable to move card", error)
+        this.#restoreMove(card, moveId, this.#rollbackPositions.get(card) || originalPosition)
+        return false
+      }
+    })
+
+    this.#pendingMoves.set(card, save)
+    save.finally(() => {
+      if (this.#pendingMoves.get(card) === save) this.#pendingMoves.delete(card)
+    })
+  }
+
+  #restoreCardState(card, originalPosition) {
+    card.className = originalPosition.classNames.join(" ")
+
+    if (originalPosition.action === null) {
+      card.removeAttribute("data-action")
+    } else {
+      card.setAttribute("data-action", originalPosition.action)
+    }
+
+    if (originalPosition.style === null) {
+      card.removeAttribute("style")
+    } else {
+      card.setAttribute("style", originalPosition.style)
+    }
+
+    const currentBadge = card.querySelector("[data-card-column-name]")
+    if (currentBadge && currentBadge !== originalPosition.columnBadge) currentBadge.remove()
+
+    if (originalPosition.columnBadge) {
+      const header = card.querySelector(".card__header")
+      if (!header.contains(originalPosition.columnBadge)) {
+        const nextSibling = originalPosition.columnBadgeNextSibling
+        header.insertBefore(originalPosition.columnBadge, nextSibling?.parentElement === header ? nextSibling : null)
+      }
+      originalPosition.columnBadge.querySelector(".overflow-ellipsis").textContent = originalPosition.columnBadgeName
+    }
+
+    card.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", originalPosition.currentStages.includes(stage))
+    })
+
+    if (originalPosition.lastUpdated) {
+      originalPosition.lastUpdated.setAttribute("datetime", originalPosition.lastUpdatedDatetime)
+      originalPosition.lastUpdated.innerHTML = originalPosition.lastUpdatedText
+      if (originalPosition.lastUpdatedTitle === null) {
+        originalPosition.lastUpdated.removeAttribute("title")
+      } else {
+        originalPosition.lastUpdated.setAttribute("title", originalPosition.lastUpdatedTitle)
+      }
+    }
+  }
+
+  #restoreMove(card, moveId, originalPosition) {
+    if (this.#latestMove.get(card) === moveId && this.element.isConnected && card.isConnected && originalPosition.parent.isConnected) {
+      const currentColumn = this.#columnFor(card)
+
+      if (originalPosition.nextSibling?.parentElement === originalPosition.parent) {
+        originalPosition.parent.insertBefore(card, originalPosition.nextSibling)
+      } else if (originalPosition.previousSibling?.parentElement === originalPosition.parent) {
+        originalPosition.parent.insertBefore(card, originalPosition.previousSibling.nextSibling)
+      } else {
+        originalPosition.parent.prepend(card)
+      }
+
+      this.#restoreCardState(card, originalPosition)
+
+      if (currentColumn !== originalPosition.sourceColumn) {
+        this.#adjustCount(currentColumn, -1)
+        this.#adjustCount(originalPosition.sourceColumn, 1)
+      }
+
+      this.#latestMove.delete(card)
+      this.#rollbackPositions.delete(card)
+    }
+  }
+}
