diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..4856408
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,182 @@
+require "application_system_test_case"
+require "timeout"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "dragging a card immediately moves it between columns without reordering columns" do
+    sign_in_as(users(:kevin))
+
+    board = boards(:writebook)
+    card = cards(:buy_domain)
+    destination_column = columns(:writebook_in_progress)
+
+    visit board_url(board)
+
+    card_id = dom_id(card, :article)
+    source_id = "maybe"
+    destination_id = dom_id(destination_column)
+
+    page.find("##{destination_id} .cards__expander").click
+    assert_selector "##{card_id}[data-drag-and-drop-target~='card'][draggable='true']"
+    column_order = column_order()
+
+    page.execute_script(<<~JS)
+      const originalFetch = window.fetch.bind(window)
+      window.fetch = (url, options) => {
+        const method = options?.method?.toUpperCase()
+        if (method === "POST" || method === "DELETE") {
+          window.dragFetchRequest = { url: url.toString(), method }
+          return new Promise(resolve => {
+            window.releaseDragSave = () => originalFetch(url, options).then(resolve)
+          })
+        }
+        return originalFetch(url, options)
+      }
+    JS
+
+    drag(card_id, source_id)
+    assert_selector "##{source_id} ##{card_id}"
+    assert_nil page.evaluate_script("window.dragFetchRequest"), "Dropping in the same column must not save or reorder the card"
+
+    drag(card_id, destination_id)
+
+    assert_selector "##{destination_id} ##{card_id}"
+    assert_selector "##{card_id} [data-card-column-name]", text: "In progress", visible: :all
+    assert_selector "##{destination_id} ##{card_id} .card__stages [data-column-id='#{destination_column.id}'].card__column-name--current", visible: :all
+    assert page.evaluate_script("document.getElementById(arguments[0]).classList.contains('card--active')", card_id)
+    assert page.evaluate_script("window.draggedCardIsDimmed")
+    assert_equal "0.6", page.evaluate_script("window.draggedCardOpacity")
+    assert page.evaluate_script("window.destinationIsHighlighted")
+    assert_equal "dashed", page.evaluate_script("window.destinationOutlineStyle")
+    assert_equal "POST", page.evaluate_script("window.dragFetchRequest?.method")
+    assert_nil card.reload.column, "The card should move in the UI before the save completes"
+    assert_equal column_order, column_order()
+    assert_selector "##{source_id} .cards__expander-count", text: "0", visible: :all
+    assert_selector "##{destination_id} .cards__expander-count", text: "2", visible: :all
+
+    page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      window.releaseDragSave().then(() => done())
+    JS
+
+    assert_equal destination_column, card.reload.column
+    assert_selector "##{destination_id} ##{card_id}"
+    assert_equal column_order, column_order()
+  end
+
+  test "dragging between status columns closes, postpones, and resumes a card" do
+    sign_in_as(users(:kevin))
+
+    card = cards(:logo)
+    card_id = dom_id(card, :article)
+    source_column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+    page.find("##{dom_id(source_column)} .cards__expander").click
+    page.find("#closed-cards .cards__expander").click
+    page.find("#not-now .cards__expander").click
+
+    drag(card_id, "closed-cards")
+    assert_selector "#closed-cards ##{card_id}", visible: :all
+    wait_for { card.reload.closed? }
+    assert_not page.evaluate_script("document.getElementById(arguments[0]).classList.contains('card--active')", card_id)
+    assert_selector "#closed-cards ##{card_id} .card__stages [data-column-id='#{source_column.id}'].card__column-name--current", visible: :all
+
+    drag(card_id, "not-now")
+    assert_selector "#not-now ##{card_id}", visible: :all
+    wait_for { card.reload.postponed? }
+    assert page.evaluate_script("document.getElementById(arguments[0]).classList.contains('card--postponed')", card_id)
+    assert_no_selector "#not-now ##{card_id} .card__stages .card__column-name--current", visible: :all
+
+    drag(card_id, "maybe")
+    assert_selector "#maybe ##{card_id}", visible: :all
+    wait_for { card.reload.awaiting_triage? }
+    assert page.evaluate_script("document.getElementById(arguments[0]).classList.contains('card--active')", card_id)
+  end
+
+  test "a failed save rolls an optimistic card move back" do
+    sign_in_as(users(:kevin))
+
+    card = cards(:buy_domain)
+    card_id = dom_id(card, :article)
+    destination_column = columns(:writebook_in_progress)
+    destination_id = dom_id(destination_column)
+    source_id = "maybe"
+
+    visit board_url(boards(:writebook))
+    page.find("##{destination_id} .cards__expander").click
+
+    page.execute_script(<<~JS)
+      window.fetch = (_url, _options) => new Promise(resolve => {
+        window.failDragSave = () => resolve(new Response(null, { status: 500 }))
+      })
+    JS
+
+    drag(card_id, destination_id)
+    assert_selector "##{destination_id} ##{card_id}"
+    assert_selector "##{card_id} [data-card-column-name]", text: "In progress", visible: :all
+    assert_selector "##{destination_id} ##{card_id} .card__stages [data-column-id='#{destination_column.id}'].card__column-name--current", visible: :all
+
+    page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      const cardId = "#{card_id}"
+      const sourceId = "#{source_id}"
+
+      window.failDragSave()
+
+      const waitForRollback = () => {
+        if (document.querySelector(`#${sourceId} #${cardId}`)) {
+          done()
+        } else {
+          requestAnimationFrame(waitForRollback)
+        }
+      }
+
+      waitForRollback()
+    JS
+
+    assert_nil card.reload.column
+    assert_no_selector "##{destination_id} ##{card_id}", visible: :all
+    assert_no_selector "##{card_id} [data-card-column-name]", visible: :all
+    assert page.evaluate_script("document.getElementById(arguments[0]).classList.contains('card--active')", card_id)
+    assert_selector "##{source_id} .cards__expander-count", text: "1", visible: :all
+    assert_selector "##{destination_id} .cards__expander-count", text: "1", visible: :all
+  end
+
+  private
+    def drag(card_id, destination_id)
+      page.execute_script(<<~JS, card_id, destination_id)
+        const card = document.getElementById(arguments[0])
+        const destination = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        const dispatch = (name, target) => target.dispatchEvent(new DragEvent(name, {
+          bubbles: true,
+          cancelable: true,
+          dataTransfer
+        }))
+
+        dispatch("dragstart", card)
+        dispatch("dragover", destination)
+        window.draggedCardIsDimmed = card.classList.contains("drag-and-drop__dragged-item")
+        window.draggedCardOpacity = getComputedStyle(card).opacity
+        window.destinationIsHighlighted = destination.classList.contains("drag-and-drop__hover-container")
+        window.destinationOutlineStyle = getComputedStyle(destination).outlineStyle
+        dispatch("drop", destination)
+        dispatch("dragend", card)
+      JS
+    end
+
+    def column_order
+      page.evaluate_script(<<~JS)
+        Array.from(document.querySelectorAll(".card-columns [data-drag-and-drop-target~='column']"))
+          .map(column => column.id)
+      JS
+    end
+
+    def wait_for(timeout: 5)
+      Timeout.timeout(timeout) do
+        sleep 0.02 until yield
+      end
+    end
+end
