+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  test "add and remove a reaction on a comment" do
+    sign_in_as users(:kevin)
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(content: "Already here", creator: users(:jz))
+
+    visit card_path(comment.card)
+
+    within "##{ActionView::RecordIdentifier.dom_id(comment, :reactions)}" do
+      assert_selector ".reaction", text: "Already here"
+      assert_no_selector ".reaction__delete"
+      assert_no_selector ".reaction__content[role=button]"
+
+      find("summary[aria-label='Add a reaction']").click
+      find("input.reaction__input").set "Nice one!"
+      find("button[type='submit']").click
+
+      assert_text "Nice one!"
+      assert_selector "details.reaction__form:not([open])"
+
+      find(".reaction__content[role='button']").click
+      find("button.reaction__delete").click
+      assert_no_text "Nice one!"
+    end
+  end
+end
