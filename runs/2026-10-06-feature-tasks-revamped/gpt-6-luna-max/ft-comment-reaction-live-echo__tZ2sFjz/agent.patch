diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..041562e
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,28 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :creator, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { includes(creator: [ :avatar_attachment, :account ]) }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  before_validation :strip_content
+  after_create_commit :broadcast_reactions_later
+  after_destroy_commit :broadcast_reactions_later
+
+  private
+    def strip_content
+      self.content = content.strip if content
+    end
+
+    def broadcast_reactions_later
+      if comment = Comment.find_by(id: comment_id)
+        comment.broadcast_replace_later_to [ comment.card, :reactions ],
+          target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+          partial: "cards/comments/reactions/list",
+          locals: { comment: comment }
+      end
+    end
+end
