+require "test_helper"
+
+class CardsCommentReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "creating a reaction updates the comment's reaction strip" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "🎉" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='replace'][target='#{ActionView::RecordIdentifier.dom_id(comment, :reactions_list)}']"
+  end
+
+  test "rejects reactions longer than 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "a" * 17 } },
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "creating a reaction returns its JSON representation" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment),
+        params: { reaction: { content: "Good work!" } },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "Good work!", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_path(comment.card, comment, Reaction.last, format: :json), @response.headers["Location"]
+  end
+
+  test "listing reactions returns JSON" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👏", creator: users(:kevin))
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body.sole["id"]
+    assert_equal "👏", @response.parsed_body.sole["content"]
+  end
+
+  test "deleting your own reaction updates the strip" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='replace'][target='#{ActionView::RecordIdentifier.dom_id(comment, :reactions_list)}']"
+  end
+
+  test "cannot delete another user's reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍", creator: users(:jz))
+
+    assert_no_difference -> { comment.reactions.count } do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a reaction cannot be accessed through a different card" do
+    comment = comments(:layout_overflowing_david)
+
+    get card_comment_reactions_path(cards(:logo), comment), as: :json
+
+    assert_response :not_found
+  end
+
+  test "reactions are present when the card is rendered again" do
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(content: "Fresh reaction", creator: users(:kevin))
+
+    get card_path(comment.card)
+
+    assert_response :success
+    assert_select "##{ActionView::RecordIdentifier.dom_id(comment, :reactions_list)} .reaction", text: /Fresh reaction/
+  end
+
+  test "reaction changes are broadcast to card viewers" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    streams = capture_turbo_stream_broadcasts [ card, :reactions ] do
+      reaction = comment.reactions.create!(content: "🎈", creator: users(:kevin))
+      reaction.send(:broadcast_reactions_later)
+      perform_enqueued_jobs(only: Turbo::Streams::ActionBroadcastJob)
+    end
+
+    assert_equal 1, streams.size
+    assert_equal ActionView::RecordIdentifier.dom_id(comment, :reactions_list), streams.last["target"]
+  end
+
+  test "card comments show the add reaction input with a 16 character limit" do
+    get card_path(cards(:logo))
+
+    assert_response :success
+    assert_select "details.reaction__form"
+    assert_select "input[name='reaction[content]'][maxlength='16']"
+    assert_select "summary.reactions__trigger img[src*='boost-color-']"
+  end
+end
