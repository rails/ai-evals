new file mode 100644
index 0000000..7be3164
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "strips surrounding whitespace and accepts 16 characters" do
+    reaction = @comment.reactions.create!(content: "  #{'a' * 16}  ")
+
+    assert_equal "a" * 16, reaction.content
+    assert_equal users(:kevin), reaction.creator
+  end
+
+  test "rejects blank and overlong reactions" do
+    [ "   ", "a" * 17 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+
+      assert_not reaction.valid?
+      assert_includes reaction.errors[:content], content.blank? ? "can't be blank" : "is too long (maximum is 16 characters)"
+    end
+  end
+end
