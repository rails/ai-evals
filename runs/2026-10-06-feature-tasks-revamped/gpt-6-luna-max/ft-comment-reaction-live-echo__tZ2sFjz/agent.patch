diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..83d662e
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "content", "delete" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.owned = this.creatorIdValue === document.querySelector('meta[name="current-user-id"]')?.content
+
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.contentTarget.setAttribute("role", "button")
+      this.contentTarget.setAttribute("tabindex", "0")
+      this.contentTarget.setAttribute("aria-expanded", "false")
+      this.deleteTarget.hidden = false
+    }
+  }
+
+  toggle(event) {
+    if (!this.owned) return
+
+    if (event.type === "keydown") {
+      if (![ "Enter", " " ].includes(event.key)) return
+
+      event.preventDefault()
+    }
+
+    const expanded = this.element.classList.toggle("expanded")
+    this.contentTarget.setAttribute("aria-expanded", expanded)
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..d703988
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,25 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "input", "trigger" ]
+
+  toggle() {
+    const expanded = this.element.open
+
+    this.element.classList.toggle("expanded", expanded)
+    this.triggerTarget.hidden = expanded
+
+    if (expanded) this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.element.open = false
+    this.element.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  submitEnd({ detail: { success } }) {
+    if (success) this.cancel()
+  }
+}
