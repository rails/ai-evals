diff --git a/app/models/concerns/bytes_used.rb b/app/models/concerns/bytes_used.rb
new file mode 100644
index 0000000..b6821a7
--- /dev/null
+++ b/app/models/concerns/bytes_used.rb
@@ -0,0 +1,70 @@
+module BytesUsed
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def invalidate_bytes_used_later(id)
+      # A running calculation checks this generation before storing its result.
+      updated = where(id: id).update_all(
+        bytes_used_calculated_at: nil,
+        bytes_used_calculation_generation: Arel.sql("bytes_used_calculation_generation + 1")
+      )
+
+      if updated.positive?
+        enqueue = where(id: id, bytes_used_calculation_pending: false)
+          .update_all(bytes_used_calculation_pending: true)
+
+        enqueue_bytes_used_calculation_later(id) if enqueue.positive?
+      end
+    end
+
+    def ensure_bytes_used_calculation_later(id)
+      enqueue = where(id: id, bytes_used_calculated_at: nil, bytes_used_calculation_pending: false)
+        .update_all(
+          bytes_used_calculation_pending: true,
+          bytes_used_calculation_generation: Arel.sql("bytes_used_calculation_generation + 1")
+        )
+
+      enqueue_bytes_used_calculation_later(id) if enqueue.positive?
+    end
+
+    def enqueue_bytes_used_calculation_later(id)
+      const_get(:RecalculateBytesUsedJob).perform_later(id)
+    end
+  end
+
+  def bytes_used
+    if persisted?
+      total, calculated_at, pending = self.class.where(id: id)
+        .pick(:bytes_used, :bytes_used_calculated_at, :bytes_used_calculation_pending)
+
+      if total && calculated_at.nil? && !pending
+        self.class.ensure_bytes_used_calculation_later(id)
+      end
+
+      total || 0
+    else
+      self[:bytes_used] || 0
+    end
+  end
+
+  def recalculate_bytes_used_now
+    reload
+    generation = self[:bytes_used_calculation_generation]
+    total = calculate_bytes_used
+    calculated_at = Time.current
+
+    # Store only if no attachment change arrived while the aggregate was running.
+    updated = self.class.where(id: id, bytes_used_calculation_generation: generation)
+      .update_all(
+        bytes_used: total,
+        bytes_used_calculated_at: calculated_at,
+        bytes_used_calculation_pending: false
+      )
+
+    if updated.zero? && self.class.exists?(id)
+      self.class.enqueue_bytes_used_calculation_later(id)
+    end
+
+    total
+  end
+end
diff --git a/app/models/concerns/storage_usage/attachment_tracking.rb b/app/models/concerns/storage_usage/attachment_tracking.rb
new file mode 100644
index 0000000..d6564dc
--- /dev/null
+++ b/app/models/concerns/storage_usage/attachment_tracking.rb
@@ -0,0 +1,88 @@
+module StorageUsage
+  module AttachmentTracking
+    extend ActiveSupport::Concern
+
+    included do
+      before_destroy :remember_storage_usage_location
+      before_update :remember_storage_usage_location, if: :storage_usage_attributes_will_change?
+
+      after_create_commit :invalidate_storage_usage_later
+      after_update_commit :invalidate_storage_usage_after_update, if: :storage_usage_attributes_changed?
+      after_destroy_commit :invalidate_previous_storage_usage_later
+    end
+
+    # Active Storage detach methods call delete directly, bypassing destroy callbacks.
+    def delete
+      location = storage_usage_location
+      result = super
+      StorageUsage.invalidate_later(location)
+      result
+    end
+
+    def storage_usage_location
+      if record_type == Card.polymorphic_name && name == "image"
+        if card = record
+          StorageUsage::Location.new(account_id, card.board_id)
+        else
+          StorageUsage::Location.new(account_id, nil)
+        end
+      elsif record_type == ActionText::RichText.polymorphic_name && name == "embeds"
+        location_for_rich_text(record)
+      end
+    end
+
+    private
+      def remember_storage_usage_location
+        @previous_storage_usage_location = storage_usage_location
+      end
+
+      def invalidate_storage_usage_later
+        StorageUsage.invalidate_later(storage_usage_location)
+      end
+
+      def invalidate_storage_usage_after_update
+        [ @previous_storage_usage_location, storage_usage_location ].compact.uniq.each do |location|
+          StorageUsage.invalidate_later(location)
+        end
+      end
+
+      def invalidate_previous_storage_usage_later
+        StorageUsage.invalidate_later(@previous_storage_usage_location)
+      end
+
+      def storage_usage_attributes_will_change?
+        will_save_change_to_record_type? || will_save_change_to_record_id? || will_save_change_to_name? ||
+          will_save_change_to_blob_id? || will_save_change_to_account_id?
+      end
+
+      def storage_usage_attributes_changed?
+        saved_change_to_record_type? || saved_change_to_record_id? || saved_change_to_name? ||
+          saved_change_to_blob_id? || saved_change_to_account_id?
+      end
+
+      def location_for_rich_text(rich_text)
+        if rich_text
+          board_id = case [ rich_text.record_type, rich_text.name ]
+          when [ Board.polymorphic_name, "public_description" ]
+            rich_text.record_id
+          when [ Card.polymorphic_name, "description" ]
+            rich_text.record&.board_id
+          when [ Comment.polymorphic_name, "body" ]
+            rich_text.record&.card&.board_id
+          end
+
+          StorageUsage::Location.new(account_id, board_id)
+        end
+      end
+  end
+
+  module DetachManyTracking
+    # The many-attachment detach path uses delete_all, so track it at the proxy boundary.
+    def detach
+      location = attachments.first&.storage_usage_location
+      result = super
+      StorageUsage.invalidate_later(location)
+      result
+    end
+  end
+end
