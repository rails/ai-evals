+module StorageUsage
+  Location = Struct.new(:account_id, :board_id)
+
+  def self.invalidate_later(location)
+    if location
+      Account.invalidate_bytes_used_later(location.account_id) if location.account_id
+      Board.invalidate_bytes_used_later(location.board_id) if location.board_id
+    end
+  end
+end
