diff --git a/test/models/bytes_used_test.rb b/test/models/bytes_used_test.rb
new file mode 100644
index 0000000..05641aa
--- /dev/null
+++ b/test/models/bytes_used_test.rb
@@ -0,0 +1,197 @@
+require "test_helper"
+
+class BytesUsedTest < ActiveSupport::TestCase
+  test "accounts and boards expose storage usage" do
+    assert_respond_to accounts("37s"), :bytes_used
+    assert_respond_to boards("writebook"), :bytes_used
+  end
+
+  test "reading an uncalculated total schedules a background refresh" do
+    account = accounts("37s")
+
+    assert_enqueued_with(job: Account::RecalculateBytesUsedJob, args: [ account.id ]) do
+      assert_equal 0, account.bytes_used
+    end
+
+    Account::RecalculateBytesUsedJob.perform_now(account.id)
+    assert_equal 0, account.bytes_used
+  end
+
+  test "attachment changes enqueue one refresh per account and board" do
+    card = cards("logo")
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ card.board_id ]) do
+      assert_enqueued_with(job: Account::RecalculateBytesUsedJob, args: [ card.account_id ]) do
+        attach_card_image(card, 11)
+      end
+    end
+  end
+
+  test "board and card description embeds refresh their owners" do
+    board = boards("writebook")
+    card = cards("logo")
+
+    assert_enqueued_jobs 2, only: [ Account::RecalculateBytesUsedJob, Board::RecalculateBytesUsedJob ] do
+      attach_embed(board, :public_description, 5)
+      attach_embed(card, :description, 7)
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(board.id)
+    Account::RecalculateBytesUsedJob.perform_now(board.account_id)
+
+    assert_equal 12, board.bytes_used
+    assert_equal 12, board.account.bytes_used
+  end
+
+  test "board and account totals include only counted attachments" do
+    account = accounts("37s")
+    board = boards("writebook")
+    card = cards("logo")
+    comment = card.comments.create!(creator: users("david"), body: "Files for this card")
+
+    attach_card_image(card, 11)
+    attach_embed(board, :public_description, 13)
+    attach_embed(card, :description, 17)
+    attach_embed(comment, :body, 19)
+    attach_embed(boards("private"), :public_description, 23)
+    other_board = boards("miltons_wish_list")
+    Current.with_account(other_board.account) do
+      attach_embed(other_board, :public_description, 29)
+    end
+
+    # Avatar attachments are not part of storage usage.
+    users("david").avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+
+    Board::RecalculateBytesUsedJob.perform_now(board.id)
+    Board::RecalculateBytesUsedJob.perform_now(boards("private").id)
+    Account::RecalculateBytesUsedJob.perform_now(account.id)
+
+    assert_equal 60, board.bytes_used
+    assert_equal 83, account.bytes_used
+  end
+
+  test "moving a card refreshes the old and new board totals" do
+    Current.session = sessions("david")
+    card = cards("logo")
+    old_board = card.board
+    new_board = boards("private")
+    attach_card_image(card, 31)
+
+    Board::RecalculateBytesUsedJob.perform_now(old_board.id)
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ old_board.id ]) do
+      assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ new_board.id ]) do
+        card.move_to(new_board)
+      end
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(old_board.id)
+    Board::RecalculateBytesUsedJob.perform_now(new_board.id)
+
+    assert_equal 0, old_board.bytes_used
+    assert_equal 31, new_board.bytes_used
+  end
+
+  test "detaching a card image updates board and account totals" do
+    card = cards("logo")
+    attach_card_image(card, 29)
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+    assert_equal 29, card.board.bytes_used
+    assert_equal 29, card.account.bytes_used
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ card.board_id ]) do
+      assert_enqueued_with(job: Account::RecalculateBytesUsedJob, args: [ card.account_id ]) do
+        card.image.detach
+      end
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+
+    assert_equal 0, card.board.bytes_used
+    assert_equal 0, card.account.bytes_used
+  end
+
+  test "detaching embedded files updates the totals" do
+    card = cards("logo")
+    comment = card.comments.create!(creator: users("david"), body: "Files")
+    attach_embeds(comment, :body, 7, 13)
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+    assert_equal 20, card.board.bytes_used
+    assert_equal 20, card.account.bytes_used
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ card.board_id ]) do
+      assert_enqueued_with(job: Account::RecalculateBytesUsedJob, args: [ card.account_id ]) do
+        comment.body.embeds.detach
+      end
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+
+    assert_equal 0, card.board.reload.bytes_used
+    assert_equal 0, card.account.reload.bytes_used
+  end
+
+  test "large embed collections are summed and refresh jobs are coalesced" do
+    card = cards("logo")
+    comment = card.comments.create!(creator: users("david"), body: "Files")
+    sizes = Array.new(25, 100)
+
+    assert_enqueued_jobs 2, only: [ Account::RecalculateBytesUsedJob, Board::RecalculateBytesUsedJob ] do
+      attach_embeds(comment, :body, *sizes)
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+
+    assert_equal sizes.sum, card.board.bytes_used
+    assert_equal sizes.sum, card.account.bytes_used
+  end
+
+  test "destroying a card invalidates its attachment usage" do
+    card = cards("logo")
+    attach_card_image(card, 37)
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ card.board_id ]) do
+      assert_enqueued_with(job: Account::RecalculateBytesUsedJob, args: [ card.account_id ]) do
+        card.destroy!
+      end
+    end
+
+    Board::RecalculateBytesUsedJob.perform_now(card.board_id)
+    Account::RecalculateBytesUsedJob.perform_now(card.account_id)
+
+    assert_equal 0, Board.find(card.board_id).bytes_used
+    assert_equal 0, Account.find(card.account_id).bytes_used
+  end
+
+  private
+    def attach_card_image(card, size)
+      card.image.attach(blob(size))
+    end
+
+    def attach_embed(record, rich_text_name, size)
+      attach_embeds(record, rich_text_name, size)
+    end
+
+    def attach_embeds(record, rich_text_name, *sizes)
+      rich_text = record.public_send(rich_text_name)
+      rich_text.body = ActionText::Content.new(rich_text.body.to_s).append_attachables(sizes.map { blob(_1) })
+      record.save!
+    end
+
+    def blob(size)
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * size),
+        filename: "file-#{size}.txt",
+        content_type: "text/plain"
+      )
+    end
+end
