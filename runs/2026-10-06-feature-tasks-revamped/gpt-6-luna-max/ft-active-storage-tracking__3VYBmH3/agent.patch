@@ -0,0 +1,15 @@
+class Board::RecalculateBytesUsedJob < ApplicationJob
+  queue_as :backend
+
+  def perform(board_id)
+    if board = Board.find_by(id: board_id)
+      if account = Account.find_by(id: board.account_id)
+        Current.with_account(account) do
+          board.recalculate_bytes_used_now
+        end
+      else
+        board.recalculate_bytes_used_now
+      end
+    end
+  end
+end
