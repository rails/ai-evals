diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..61f1413
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,140 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card into another column moves it there right away" do
+    card = cards(:logo)
+    target = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column dom_id(card.column)
+
+    drag card, to: "##{dom_id(target)}"
+
+    within("##{dom_id(target)}") { assert_selector "##{dom_id(card, :article)}", visible: :all, wait: 0 }
+    assert_card_saved -> { card.reload.column == target }
+    within("##{dom_id(target)}") { assert_selector ".card:first-of-type##{dom_id(card, :article)}", visible: :all }
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column dom_id(card.column)
+
+    drag card, to: "#closed-cards"
+
+    within("#closed-cards") { assert_selector "##{dom_id(card, :article)}", visible: :all, wait: 0 }
+    assert_card_saved -> { card.reload.closed? }
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column dom_id(card.column)
+
+    drag card, to: "#not-now"
+
+    within("#not-now") { assert_selector "##{dom_id(card, :article)}", visible: :all, wait: 0 }
+    assert_card_saved -> { card.reload.postponed? }
+  end
+
+  test "dragging a card to Maybe? sends it back to triage" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column dom_id(card.column)
+
+    drag card, to: "#maybe"
+
+    within("#maybe") { assert_selector "##{dom_id(card, :article)}", visible: :all, wait: 0 }
+    assert_card_saved -> { card.reload.awaiting_triage? }
+  end
+
+  test "dropping a card on its own column leaves it alone" do
+    card = cards(:logo)
+    column = card.column
+
+    visit board_url(@board)
+    expand_column dom_id(column)
+
+    drag card, to: "##{dom_id(column)}"
+
+    within("##{dom_id(column)}") { assert_selector "##{dom_id(card, :article)}" }
+    assert_equal column, card.reload.column
+  end
+
+test "the board changes before the save finishes" do
+  card = cards(:layout)
+  source, target = card.column, columns(:writebook_review)
+
+  visit board_url(@board)
+  expand_column dom_id(source)
+  source_count, target_count = expander_count(source), expander_count(target)
+
+  stall_drop_requests
+  drag card, to: "##{dom_id(target)}"
+
+  within("##{dom_id(target)}") { assert_selector "##{dom_id(card, :article)}", visible: :all, wait: 0 }
+  assert_equal source_count - 1, expander_count(source)
+  assert_equal target_count + 1, expander_count(target)
+  assert_equal source, card.reload.column
+end
+
+test "a dropped card lands where the board will keep it" do
+  golden, card = cards(:text), cards(:layout)
+  target = golden.column
+  golden.gild
+
+  visit board_url(@board)
+  expand_column dom_id(card.column)
+
+  drag card, to: "##{dom_id(target)}"
+
+  assert_equal [ golden, card ].map { dom_id(_1, :article) }, card_ids_in(target)
+  assert_card_saved -> { card.reload.column == target }
+  sleep 0.5
+  assert_equal [ golden, card ].map { dom_id(_1, :article) }, card_ids_in(target)
+
+  visit board_url(@board)
+  assert_selector "##{dom_id(card, :article)}", visible: :all
+  assert_equal [ golden, card ].map { dom_id(_1, :article) }, card_ids_in(target)
+end
+
+  private
+    def expand_column(id)
+      column = find("##{id}")
+      column.find(".cards__expander").click unless column.matches_css?(".is-expanded", wait: 0.5)
+      assert_selector "##{id}.is-expanded"
+    end
+
+    def drag(card, to:)
+      find(".card-columns ##{dom_id(card, :article)}").drag_to find(to), html5: true
+    end
+
+    def assert_card_saved(condition)
+      Timeout.timeout(5) { sleep 0.05 until condition.call }
+    end
+
+    def stall_drop_requests
+      page.execute_script <<~JS
+        const fetch = window.fetch
+        window.fetch = (url, options) => String(url).includes("/drops/") ? new Promise(() => {}) : fetch(url, options)
+      JS
+    end
+
+    def expander_count(column)
+      find("##{dom_id(column)} .cards__expander-count", visible: :all).text(:all).to_i
+    end
+
+    def card_ids_in(column)
+      all("##{dom_id(column)} .card", visible: :all).map { _1[:id] }
+    end
+end
