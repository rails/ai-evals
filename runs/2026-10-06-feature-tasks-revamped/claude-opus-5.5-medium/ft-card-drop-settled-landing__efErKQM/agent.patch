new file mode 100644
index 0000000..74a50f9
--- /dev/null
+++ b/app/controllers/concerns/card_dropping.rb
@@ -0,0 +1,15 @@
+# Drag and drop moves a card on the board before the request is even sent, so
+# responses only refresh the dropped card in place and never re-render columns.
+module CardDropping
+  extend ActiveSupport::Concern
+
+  include CardScoped
+
+  private
+    def render_dropped_card
+      respond_to do |format|
+        format.turbo_stream { render "cards/drops/create" }
+        format.json { head :no_content }
+      end
+    end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..f1a2819
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,168 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+
+// Moves cards between containers (columns, Maybe?, Not Now, Done). Containers keep
+// their own order, so a dropped card goes where the server would render it: at the
+// top, after any golden cards when the container lists golden cards first.
+//
+// The board is updated as soon as the card is dropped; the save happens afterwards
+// and only refreshes the dropped card's contents in place.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #saves = Promise.resolve()
+
+  dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item) return
+
+    this.draggedItem = item
+    this.sourceContainer = this.#containerContaining(item)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.dataset.cardNumber)
+
+    // Dim the card on the board, not the image the browser snapshots for the drag
+    requestAnimationFrame(() => {
+      if (this.draggedItem === item) item.classList.add(this.draggedItemClass)
+    })
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#droppableContainerAt(event.target)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#highlight(container)
+  }
+
+  dragLeave(event) {
+    if (this.draggedItem && !this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.draggedItem && this.#droppableContainerAt(event.target)
+
+    if (container) {
+      event.preventDefault()
+
+      const item = this.draggedItem
+      this.#move(item, this.sourceContainer, container)
+      this.#save(item, container)
+    }
+
+    this.dragEnd()
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  // Private
+
+  #itemContaining(element) {
+    const item = element.closest?.("[data-drag-and-drop-target~='item']")
+    return this.itemTargets.includes(item) ? item : null
+  }
+
+  #containerContaining(element) {
+    const container = element.closest?.("[data-drag-and-drop-target~='container']")
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #droppableContainerAt(element) {
+    const container = this.#containerContaining(element)
+    return container && container !== this.sourceContainer ? container : null
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => {
+      each.classList.toggle(this.hoverContainerClass, each === container)
+    })
+  }
+
+  #move(item, source, target) {
+    this.#insert(item, target)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(target, +1)
+    this.#recolor(item, target)
+  }
+
+  #insert(item, container) {
+    const items = this.#itemsIn(container).filter(each => each !== item)
+    const reference = this.#goldenFirst(container) && !this.#isGolden(item)
+      ? items.find(each => !this.#isGolden(each))
+      : items[0]
+
+    if (reference) {
+      reference.before(item)
+    } else if (items.length > 0) {
+      items.at(-1).after(item)
+    } else {
+      const list = container.querySelector(".cards__list")
+      list ? list.prepend(item) : item.remove()
+    }
+  }
+
+  #itemsIn(container) {
+    return this.itemTargets.filter(item => container.contains(item))
+  }
+
+  #goldenFirst(container) {
+    return container.dataset.dragAndDropGoldenFirst === "true"
+  }
+
+  #isGolden(item) {
+    return item.classList.contains("golden-effect")
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container?.querySelector(".cards__expander-count")
+    const text = counter?.textContent.trim()
+
+    // "99+" can't tell us the real count, so leave it alone
+    if (text && /^\d+$/.test(text)) {
+      const count = Math.max(parseInt(text) + delta, 0)
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  #recolor(item, container) {
+    const color = container.dataset.dragAndDropCardColor
+    if (color) item.style.setProperty("--card-color", color)
+  }
+
+  #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace("__card__", item.dataset.cardNumber)
+
+    // Save in drop order so the last move wins when cards are moved in quick succession
+    this.#saves = this.#saves.then(() => this.#submit(url))
+  }
+
+  async #submit(url) {
+    try {
+      const response = await post(url, { responseKind: "turbo-stream" })
+      if (!response.ok) this.#resync()
+    } catch {
+      this.#resync()
+    }
+  }
+
+  // The move didn't stick, so show the board as it really is
+  #resync() {
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+}
