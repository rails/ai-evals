@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create moves the card into the column and refreshes only the card" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, to: column do
+      post card_drops_column_path(card, column_id: column.id), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, targets: "#" + dom_id(card, :article)
+    assert_no_turbo_stream action: :replace, target: dom_id(column)
+  end
+
+  test "create reopens a closed card" do
+    card = cards(:shipping)
+    card.close(user: users(:kevin))
+
+    post card_drops_column_path(card, column_id: columns(:writebook_review).id), as: :turbo_stream
+
+    assert card.reload.open?
+    assert_equal columns(:writebook_review), card.column
+  end
+
+  test "create resumes a postponed card" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+
+    post card_drops_column_path(card, column_id: columns(:writebook_review).id), as: :turbo_stream
+
+    assert card.reload.active?
+    assert_equal columns(:writebook_review), card.column
+  end
+
+  test "create with a column from another board" do
+    post card_drops_column_path(cards(:logo), column_id: columns(:writebook_review).id.succ), as: :turbo_stream
+    assert_response :not_found
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+
+    post card_drops_column_path(card, column_id: columns(:writebook_review).id), as: :json
+
+    assert_response :no_content
+    assert_equal columns(:writebook_review), card.reload.column
+  end
+end
