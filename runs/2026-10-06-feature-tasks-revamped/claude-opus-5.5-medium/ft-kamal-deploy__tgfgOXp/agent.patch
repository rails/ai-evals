@@ -0,0 +1,33 @@
+# Secrets for config/deploy.yml. Kamal reads this file when it deploys.
+#
+# DON'T PUT RAW SECRETS IN THIS FILE. It gets committed to git. Pull them in from
+# your environment, a password manager, or a file that isn't committed.
+#
+# Generate the app secrets once and keep them. Changing SECRET_KEY_BASE signs everyone out.
+#
+#   SECRET_KEY_BASE:     bin/rails secret
+#   VAPID_PUBLIC_KEY /
+#   VAPID_PRIVATE_KEY:   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}", "VAPID_PRIVATE_KEY=#{k.private_key}"'
+#
+# Then export them in your shell (or use a .env file, which git ignores) before running bin/kamal:
+#
+#   export KAMAL_REGISTRY_PASSWORD=... SECRET_KEY_BASE=... VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
+#   export SMTP_USERNAME=... SMTP_PASSWORD=...
+#
+# Example using 1Password instead:
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Item KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE)
+#   KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
+
+# Registry password or access token, used to push and pull the image.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Rails secrets.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Web push notification keys.
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Mail server credentials. Leave these empty if your SMTP server doesn't need a login.
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
