+# Kamal config for running Fizzy on a single server.
+#
+# Everything runs in one container: Puma behind Thruster serves the app, and
+# Solid Queue runs inside Puma for background jobs. Data lives in SQLite.
+# kamal-proxy sets up SSL with Let's Encrypt.
+#
+# To deploy your own Fizzy:
+#
+#   1. Point a DNS record for your hostname at your server.
+#   2. Fill in everything marked CHANGE ME below.
+#   3. Set the secrets listed in .kamal/secrets (see that file).
+#   4. Run `bin/kamal setup` for the first deploy, then `bin/kamal deploy` after that.
+#
+# Everything under /rails/storage (SQLite databases and uploaded files) is kept
+# in the "fizzy_storage" Docker volume on the server, so it survives deploys.
+# Back up that volume.
+#
+# Full Kamal docs: https://kamal-deploy.org
+
+service: fizzy
+
+# CHANGE ME: the image name in your registry, e.g. "your-user/fizzy".
+image: your-user/fizzy
+
+servers:
+  web:
+    # CHANGE ME: your server's IP address or hostname. It needs SSH access and Docker
+    # (or a user that can install Docker).
+    - 192.168.0.1
+
+# kamal-proxy terminates SSL with a free Let's Encrypt certificate. Your hostname's DNS
+# must point at the server, and ports 80 and 443 must be open.
+proxy:
+  ssl: true
+  # CHANGE ME: the hostname people use to reach Fizzy.
+  host: &app_host fizzy.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Registry credentials. The default is Docker Hub; KAMAL_REGISTRY_PASSWORD comes from .kamal/secrets.
+registry:
+  # server: ghcr.io
+  # CHANGE ME: your registry username.
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  # CHANGE ME if your server is ARM, e.g. "arm64".
+  arch: amd64
+
+env:
+  clear:
+    # Absolute links in emails, webhooks and exports use this host (matches proxy.host above).
+    APP_HOST: *app_host
+
+    # Run background jobs (Solid Queue) inside the web container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Number of Puma worker processes. Raise it on a server with more CPU cores.
+    WEB_CONCURRENCY: 2
+
+    # CHANGE ME: the sender address for Fizzy's emails.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # CHANGE ME: your mail server. Fizzy sends sign-in codes by email, so this has to work.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com          # HELO domain, defaults to APP_HOST
+    # SMTP_AUTHENTICATION: plain        # plain, login or cram_md5
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: false                   # set to true for implicit TLS (usually port 465)
+
+    # Set to true to host more than one account on this install.
+    # MULTI_TENANT: false
+
+  secret:
+    - SECRET_KEY_BASE
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# Keep SQLite databases and uploaded files in a named volume so they survive deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Shortcuts, e.g. `bin/kamal console`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
