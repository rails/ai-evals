+ja:
+  account:
+    seeder:
+      playground: プレイグラウンド
+      cards:
+        orientation:
+          title: 最後に、Fizzyの紹介動画を見てみましょう
+          description_html: |
+            <p>Fizzyでできることはまだまだたくさんあります。下の動画では、37signalsの創業者でCEOのジェイソン・フリードが、わずか17分で基本を紹介します。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/fizzyorientation-4k.mp4" caption="Fizzyの紹介" content-type="video/mp4" filename="fizzyorientation-4k.mp4"></action-text-attachment>
+        passkey:
+          title: 次に、パスキーを設定しましょう
+          description_html: |
+            <p>パスキーを使うと、パスワードやメールのコードなしで安全にログインできます。設定するには、Fizzyメニューを開いて「<b><strong>プロフィール > パスキーを管理</strong></b>」に進みます。パスキーの利用は任意ですが、おすすめです。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/videos/creating_a_passkey.mp4" alt="パスキーを追加するデモ" caption="パスキーを作成して、パスワードやメールのコードなしでログイン" content-type="video/mp4" filename="creating_a_passkey.mp4"></action-text-attachment>
+        invite:
+          title: 次は、招待リンクを取得してほかの人を招待しましょう
+          description_html: |
+            <p>Fizzyメニューを開いて「<b><strong>+ メンバーを招待</strong></b>」を選び、招待リンクをコピーします。このリンクを渡せば、相手はあなたのアカウントに自分のログインを作成できます。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/invite-link.gif" alt="招待リンクをコピーするデモ" caption="同僚を招待するリンクを取得" content-type="image/*" filename="invite-link.gif" presentation="gallery"></action-text-attachment>
+        activity:
+          title: 次に、ホームに戻ってアクティビティを確認しましょう
+          description_html: |
+            <p>「1」キーを押すか、Fizzyメニューを開いて「ホーム」を選びます。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/back-to-home.gif" alt="ホームに移動するデモ" caption="ホームに戻って最新のアクティビティを確認" content-type="image/*" filename="back-to-home.gif" presentation="gallery"></action-text-attachment>
+        assigned:
+          title: 次は、自分が担当しているカードをすべて確認しましょう
+          description_html: |
+            <p>画面上部のFizzyメニューを開いて「<b><strong>自分の担当</strong></b>」を選ぶか、いつでもキーボードの「2」を押します。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/all-assigned.gif" alt="「自分の担当」に移動するデモ" caption="自分が担当しているカードをすべて表示" content-type="image/*" filename="all-assigned.gif" presentation="gallery"></action-text-attachment>
+        menu:
+          title: 次に、Fizzyメニューを開いてみましょう
+          description_html: |
+            <p>Fizzyメニューはアプリ内を移動するための入り口です。画面上部の「<b><strong>Fizzy</strong></b>」をクリックするか、キーボードの「J」キーを押すと開きます。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/open-menu.gif" alt="メインメニューを開くデモ" caption="Fizzyメニューを開く" content-type="image/*" filename="open-menu.gif" presentation="gallery"></action-text-attachment>
+        assign:
+          title: 次は、このカードの担当者を自分にしましょう
+          description_html: |
+            <p>横に＋が付いた小さな人型のアイコンをクリックし、自分を選びます。</p>
+            <action-text-attachment url="https://videos.37signals.com/fizzy/assets/images/assign-to-self.gif" alt="カードの担当者を設定するデモ" caption="このカードの担当者を自分にする" content-type="image/*" filename="assign-to-self.gif" presentation="gallery"></action-text-attachment>
+        tag:
+          title: 次に、このカードに「デザイン」タグを付けて「やる」列に移動しましょう
