diff --git a/test/lib/translations_test.rb b/test/lib/translations_test.rb
new file mode 100644
index 0000000..66d14f2
--- /dev/null
+++ b/test/lib/translations_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class TranslationsTest < ActiveSupport::TestCase
+  LOCALE_FILES = Dir[Rails.root.join("config/locales/**/*.yml"), Rails.root.join("saas/config/locales/**/*.yml")]
+
+  # Rails' own Japanese defaults (dates, numbers, validation messages) have no app-specific English counterpart.
+  RAILS_DEFAULTS = /\A(date|time\.(am|pm|formats\.(default|long|short))|datetime|number|errors\.(format|template|messages\.(accepted|blank|confirmation|empty|equal_to|even|exclusion|greater_than|greater_than_or_equal_to|in|inclusion|invalid|less_than|less_than_or_equal_to|model_invalid|not_a_number|not_an_integer|odd|other_than|present|required|taken|too_long|too_short|wrong_length|content_type_invalid|file_size_out_of_range|password_too_long))|activerecord|activemodel|attributes|helpers\.(select|submit)|support\.array\.(words|two_words|last_word)_connector)\b/
+
+  test "every English string has a Japanese translation and vice versa" do
+    english, japanese = translations(:en).keys, translations(:ja).keys
+
+    assert_empty english - japanese, "Missing Japanese translations"
+    assert_empty (japanese - english).grep_v(RAILS_DEFAULTS), "Japanese translations without an English original"
+  end
+
+  test "Japanese translations only interpolate values that English provides" do
+    english, japanese = translations(:en), translations(:ja)
+
+    (english.keys & japanese.keys).each do |key|
+      provided = interpolations(english[key])
+      provided |= [ "number" ] if provided.include?("ordinal")
+
+      assert_empty interpolations(japanese[key]) - provided, "#{key} interpolates values English doesn't provide"
+    end
+  end
+
+  test "a key is never both a string and a group of strings" do
+    %i[ en ja ].each do |locale|
+      keys = translations(locale).keys
+
+      keys.each do |key|
+        parents = key.split(".").each_index.map { |i| key.split(".")[0, i].join(".") }.drop(1)
+        assert_empty parents & keys, "#{locale}.#{key} is nested under a string"
+      end
+    end
+  end
+
+  test "English is the default and Japanese is available" do
+    assert_equal :en, I18n.default_locale
+    assert_includes I18n.available_locales, :ja
+  end
+
+  private
+    def translations(locale)
+      @translations ||= {}
+      @translations[locale] ||= LOCALE_FILES.each_with_object({}) do |file, all|
+        tree = YAML.load_file(file)[locale.to_s]
+        all.merge!(flatten(tree)) if tree
+      end
+    end
+
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), flat|
+        path = [ prefix, key ].compact.join(".")
+
+        if value.is_a?(Hash) && (value.keys.map(&:to_s) - %w[ zero one two few many other ]).any?
+          flat.merge!(flatten(value, path))
+        else
+          flat[path] = value
+        end
+      end
+    end
+
+    def interpolations(value)
+      Array(value.is_a?(Hash) ? value.values : value).flat_map { it.to_s.scan(/%\{(\w+)\}/).flatten }.uniq - [ "count" ]
+    end
+end
diff --git a/test/mailers/localized_mailers_test.rb b/test/mailers/localized_mailers_test.rb
new file mode 100644
index 0000000..1890f02
--- /dev/null
+++ b/test/mailers/localized_mailers_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class LocalizedMailersTest < ActionMailer::TestCase
+  test "emails speak the language the recipient chose" do
+    identities(:kevin).update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Fizzyの確認コードは#{magic_link.code}です", email.subject
+    assert_match "Fizzyの確認コード", email.html_part.body.to_s
+    assert_match "15分", email.text_part.body.to_s
+  end
+
+  test "emails stay in English for people who never chose a language" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+    assert_match "15 minutes", email.text_part.body.to_s
+  end
+
+  test "the recipient's language wins over the language of whoever triggered the email" do
+    magic_link = MagicLink.create!(identity: identities(:kevin))
+
+    email = I18n.with_locale(:ja) { MagicLinkMailer.sign_in_instructions(magic_link).tap(&:subject) }
+    assert_equal "Fizzyの確認コードは#{magic_link.code}です", email.subject, "falls back to the triggering request's language"
+
+    identities(:kevin).update!(locale: "en")
+    email = I18n.with_locale(:ja) { MagicLinkMailer.sign_in_instructions(magic_link).tap(&:subject) }
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+  end
+
+  test "notification emails are localized, dates included" do
+    user = users(:david)
+    user.identity.update!(locale: "ja")
+    user.notifications.destroy_all
+
+    travel_to Time.utc(2026, 1, 5, 6, 0, 0) do
+      bundle = Notification::Bundle.create!(user: user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+      Notification.create!(user: user, creator: user, source: events(:logo_published), created_at: 30.minutes.ago)
+
+      email = Notification::BundleMailer.notification(bundle)
+
+      assert_match "新しい通知", email.subject
+      assert_match "1月5日", email.html_part.body.to_s
+      assert_match "以降の通知", email.text_part.body.to_s
+      assert_no_match(/Notifications since/, email.html_part.body.to_s)
+    end
+  end
+
+  test "deliver_later keeps the recipient's language" do
+    identities(:kevin).update!(locale: "ja")
+
+    perform_enqueued_jobs do
+      identities(:kevin).send_magic_link
+    end
+
+    assert_match "Fizzyの確認コード", ActionMailer::Base.deliveries.last.subject
+  end
+end
