diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..53eb5b2
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,61 @@
+# Picks the language each request is rendered in.
+#
+# Anyone can switch by opening any page with <tt>?locale=ja</tt>. The choice is remembered in the
+# session and, for signed-in people, on their identity so it follows them to new browsers. Locales
+# we don't offer are ignored. People who never chose anything get the default locale.
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale
+
+    etag { I18n.locale unless I18n.locale == I18n.default_locale }
+    fragment_cache_key { I18n.locale unless I18n.locale == I18n.default_locale }
+  end
+
+  private
+    def switch_locale(&)
+      I18n.with_locale(current_locale, &)
+    end
+
+    def current_locale
+      if locale = requested_locale
+        remember_locale locale
+      else
+        session_locale || identity_locale || I18n.default_locale
+      end
+    end
+
+    def requested_locale
+      available_locale params[:locale]
+    end
+
+    def session_locale
+      available_locale session[:locale]
+    end
+
+    def identity_locale
+      available_locale localizable_identity&.locale
+    end
+
+    def remember_locale(locale)
+      session[:locale] = locale.to_s
+      remember_locale_for_identity localizable_identity, locale
+      locale
+    end
+
+    def remember_locale_for_identity(identity, locale = session_locale)
+      if identity && locale && identity.locale != locale.to_s
+        identity.update_column :locale, locale.to_s
+      end
+    end
+
+    # Authentication may not have run yet for actions that allow unauthenticated access.
+    def localizable_identity
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def available_locale(locale)
+      locale.to_s.to_sym.presence_in(I18n.available_locales) if locale.present?
+    end
+end
