diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..e72d2f3
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,41 @@
+// Translations for strings rendered by JavaScript. The server embeds them for the current
+// locale (see ApplicationHelper#javascript_translations_tag), so YAML stays the single source.
+const DEFAULT_LOCALE = "en"
+const INTL_LOCALES = { en: "en-US" }
+
+let cachedTranslations
+
+export function t(key, params = {}) {
+  let value = key.split(".").reduce((scope, part) => scope?.[part], translations())
+
+  if (value && typeof value === "object" && "count" in params) {
+    value = params.count === 1 ? value.one : value.other
+  }
+
+  if (typeof value !== "string") return key
+
+  return value.replace(/%\{(\w+)\}/g, (match, name) => name in params ? params[name] : match)
+}
+
+export function currentLocale() {
+  return document.documentElement.lang || DEFAULT_LOCALE
+}
+
+export function intlLocale() {
+  const locale = currentLocale()
+  return INTL_LOCALES[locale] || locale
+}
+
+function translations() {
+  if (!cachedTranslations) {
+    const element = document.getElementById("javascript-translations")
+
+    try {
+      cachedTranslations = JSON.parse(element?.textContent || "{}")
+    } catch {
+      cachedTranslations = {}
+    }
+  }
+
+  return cachedTranslations
+}
