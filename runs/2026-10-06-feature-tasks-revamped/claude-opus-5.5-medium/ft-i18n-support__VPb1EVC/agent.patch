diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..aab48bd
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "people who never chose a language get English" do
+    sign_in_as :kevin
+
+    get events_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "h1", text: /Latest Activity|Activity/
+    assert_nil identities(:kevin).reload.locale
+  end
+
+  test "choosing Japanese switches every page for the rest of the session" do
+    sign_in_as :kevin
+
+    get events_path(locale: "ja")
+    assert_select "html[lang=ja]"
+    assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+
+    get notifications_path
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "通知"
+
+    get board_path(boards(:writebook))
+    assert_select ".cards__expander-title", text: /検討中/
+  end
+
+  test "the choice follows the person to a new browser" do
+    sign_in_as :kevin
+    get events_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+    sign_in_as :kevin
+
+    get events_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "choosing a language before signing in sticks after signing in" do
+    untenanted { get new_session_path(locale: "ja") }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "Fizzyにログイン"
+
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+
+    get events_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "the sign-in code email speaks the language chosen on the sign-in page" do
+    untenanted do
+      get new_session_path(locale: "ja")
+
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+    end
+
+    assert_match "Fizzyの確認コード", ActionMailer::Base.deliveries.last.subject
+    assert_nil identities(:kevin).reload.locale, "Not saved until they actually sign in"
+  end
+
+  test "flash messages are translated" do
+    sign_in_as :kevin
+    get events_path(locale: "ja")
+
+    delete card_path(cards(:logo))
+    follow_redirect!
+
+    assert_select ".flash__inner", text: /カードを削除しました/
+  end
+
+  test "switching back to English" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+
+    get events_path(locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "an unsupported locale doesn't break the page or switch anything" do
+    sign_in_as :kevin
+
+    get events_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:kevin).reload.locale
+
+    get events_path(locale: "ja")
+    get events_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "unsupported locales are ignored before signing in too" do
+    untenanted { get new_session_path(locale: "xx") }
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "pages cached by the browser are not reused across languages" do
+    sign_in_as :kevin
+
+    get events_path
+    etag = response.headers["ETag"]
+
+    get events_path(locale: "ja"), headers: { "HTTP_IF_NONE_MATCH" => etag }
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "translations for JavaScript are embedded in the current language" do
+    sign_in_as :kevin
+
+    get events_path(locale: "ja")
+    assert_select "script#javascript-translations[type='application/json']" do |elements|
+      assert_equal "今日", JSON.parse(elements.first.text).dig("local_time", "today")
+    end
+  end
+end
