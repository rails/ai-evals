@@ -0,0 +1,86 @@
+require "test_helper"
+
+class LocalizationModelTest < ActiveSupport::TestCase
+  test "identities only accept locales we offer" do
+    identity = identities(:kevin)
+
+    identity.locale = "ja"
+    assert identity.valid?
+
+    identity.locale = "xx"
+    assert_not identity.valid?
+
+    identity.locale = nil
+    assert identity.valid?
+  end
+
+  test "with_locale uses the identity's language or the fallback" do
+    identity = identities(:kevin)
+
+    assert_equal :en, identity.with_locale { I18n.locale }
+    assert_equal :ja, identity.with_locale(fallback: :ja) { I18n.locale }
+
+    identity.locale = "ja"
+    assert_equal :ja, identity.with_locale { I18n.locale }
+  end
+
+  test "users without an identity get the default language" do
+    user = users(:kevin)
+    user.identity = nil
+
+    assert_equal :en, I18n.with_locale(:ja) { user.with_locale { I18n.locale } }
+  end
+
+  test "event descriptions are translated" do
+    event = events(:logo_published)
+
+    assert_match "added", event.description_for(users(:kevin)).to_plain_text
+    assert_match "を追加しました", I18n.with_locale(:ja) { event.description_for(users(:kevin)).to_plain_text }
+  end
+
+  test "push notifications speak the recipient's language" do
+    notification = Notification.new(user: users(:david), creator: users(:kevin), source: events(:logo_published)).tap(&:validate)
+    users(:david).identity.update!(locale: "ja")
+
+    payload = users(:david).with_locale { notification.payload.to_h }
+
+    assert_match "さんが追加しました", payload[:body]
+  end
+
+  test "system comments are stored in English and rebuilt for Japanese readers" do
+    card = cards(:logo)
+
+    assignee = (card.board.users - card.assignees).first
+
+    with_current_user(:kevin) do
+      I18n.with_locale(:ja) { card.toggle_assignment(assignee) }
+    end
+    comment = card.comments.by_system.order(:created_at).last
+
+    assert_match "assigned this to #{assignee.name}", comment.body.to_plain_text
+    assert_match "担当者を#{assignee.name}に", I18n.with_locale(:ja) { Card::Eventable::SystemCommenter.localized_body_for(comment) }
+  end
+
+  test "account names for Japanese sign-ups" do
+    identity = Identity.create!(email_address: "taro@example.com")
+    generator = Signup::AccountNameGenerator.new(identity: identity, name: "田中 太郎")
+
+    assert_equal "田中のFizzy", I18n.with_locale(:ja) { generator.generate }
+
+    account = Account.create!(external_account_id: "ja-1st", name: "田中のFizzy")
+    Current.without_account { identity.users.create!(account: account, name: "田中 太郎") }
+    identity.reload
+
+    assert_equal "田中のFizzy 2", I18n.with_locale(:ja) { generator.generate }
+    assert_equal "田中's 2nd Fizzy", generator.generate
+  end
+
+  test "the playground is seeded in the language of the person signing up" do
+    account = accounts("37s")
+
+    I18n.with_locale(:ja) { Account::Seeder.new(account, users(:kevin)).seed }
+
+    playground = account.boards.find_by!(name: "プレイグラウンド")
+    assert playground.cards.exists?(title: "まず、このカードの名前を変更しましょう")
+  end
+end
