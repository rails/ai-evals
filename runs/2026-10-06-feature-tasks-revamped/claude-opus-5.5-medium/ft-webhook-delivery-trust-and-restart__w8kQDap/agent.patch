@@ -0,0 +1,19 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def triggered_by(event)
+      active.where(board: event.board).select { it.triggered_by?(event) }
+    end
+  end
+
+  def triggered_by?(event)
+    active? && subscribed_actions.include?(event.action.to_s)
+  end
+
+  # Idempotent: an event is only ever delivered once per webhook, even if
+  # dispatch runs more than once.
+  def trigger(event)
+    deliveries.create_or_find_by!(event: event)
+  end
+end
