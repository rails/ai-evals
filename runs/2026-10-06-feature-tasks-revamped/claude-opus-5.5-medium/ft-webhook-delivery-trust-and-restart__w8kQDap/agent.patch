+  end
+
+  test "creating a delivery enqueues the delivery job" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    end
+  end
+
+  test "deliver posts a signed JSON payload and logs the outcome" do
+    stub_dns_resolution(PUBLIC_IP)
+    request = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert_requested request, times: 1
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "application/json", delivery.request[:headers]["Content-Type"]
+
+    assert_requested(:post, @webhook.url) do |req|
+      body = JSON.parse(req.body)
+      assert_equal @event.id, body["id"]
+      assert_equal "card_published", body["action"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, req.body), req.headers["X-Webhook-Signature"]
+    end
+  end
+
+  test "deliver only ever posts once" do
+    stub_dns_resolution(PUBLIC_IP)
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+    delivery.deliver
+    Webhook::Delivery.find(delivery.id).deliver
+
+    assert_requested request, times: 1
+  end
+
+  test "non-2xx responses are logged as failures" do
+    stub_dns_resolution(PUBLIC_IP)
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, @webhook.tracker.reload.consecutive_failures_count
+  end
+
+  test "network errors are logged" do
+    stub_dns_resolution(PUBLIC_IP)
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "private destinations are refused" do
+    stub_dns_resolution("127.0.0.1")
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "private_uri", delivery.response[:error]
+  end
+
+  test "deliveries for deactivated webhooks are not sent" do
+    @webhook.deactivate
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "slack payload" do
+    @webhook.update_column :url, "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    stub_dns_resolution(PUBLIC_IP)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::Delivery.create!(webhook: @webhook, event: @event).deliver
+
+    assert_requested(:post, @webhook.url) do |req|
+      text = JSON.parse(req.body)["text"]
+      assert_match "ship the app", text
+      assert_match %r{<http://[^|]+/cards/\d+\|}, text
+    end
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    old = Webhook::Delivery.create!(webhook: @webhook, event: @event, created_at: 8.days.ago)
+    recent = Webhook::Delivery.create!(webhook: @webhook, event: events(:text_published), created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
+end
