+
+  # Delivers at most once: the delivery is atomically claimed (pending -> in_progress)
+  # before the request is made, so retries or duplicate jobs never POST twice.
+  def deliver
+    if claim
+      if webhook.active?
+        perform_delivery
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
