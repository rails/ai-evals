@@ -27,6 +54,111 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1 && reload
+    end
+
+    def perform_delivery
+      self.request = { headers: headers }
+      self.response = perform_request
+      self.state = response[:error].present? ? :errored : :completed
+      save!
+    rescue => error
+      update! state: :errored, response: { error: "internal_error" }
+      raise error
+    ensure
+      webhook.tracker.record_delivery_of(self)
+    end
+
+    def perform_request
+      if resolved_ip.nil?
+        { error: "private_uri" }
+      else
+        response = http.request(Net::HTTP::Post.new(uri, headers).tap { it.body = payload })
+        { code: response.code.to_i }
+      end
+    rescue Resolv::ResolvTimeout, Resolv::ResolvError, SocketError
+      { error: "dns_lookup_failed" }
+    rescue Net::OpenTimeout, Net::ReadTimeout, Errno::ETIMEDOUT
+      { error: "connection_timeout" }
+    rescue Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ECONNRESET, EOFError
+      { error: "destination_unreachable" }
+    rescue OpenSSL::SSL::SSLError
+      { error: "failed_tls" }
+    end
+
+    def uri
+      @uri ||= URI(webhook.url)
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def headers
+      @headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3)
+      }
+    end
+
+    def content_type
+      webhook.for_campfire? ? "text/html" : "application/json"
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def payload
+      @payload ||= \
+        if webhook.for_campfire?
+          render_event(:html)
+        elsif webhook.for_basecamp?
+          { content: render_event(:html) }.to_json
+        elsif webhook.for_slack?
+          { text: slack_mrkdwn(render_event(:html)) }.to_json
+        else
+          render_event(:json)
+        end
+    end
+
+    def render_event(format)
+      renderer.render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event }).strip
+    end
+
+    def slack_mrkdwn(html)
+      html.gsub(%r{<a [^>]*href="([^"]+)"[^>]*>(.*?)</a>}m) { "<#{CGI.unescapeHTML($1)}|#{$2}>" }
+    end
+
+    def renderer
+      ApplicationController.renderer.new(renderer_env)
+    end
+
+    def renderer_env
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      host = [ options[:host], options[:port] ].compact.join(":").presence
+      https = options[:protocol].present? ? options[:protocol].to_s.start_with?("https") : !Rails.env.local?
+
+      { script_name: account.slug, https: https }.tap { it[:http_host] = host if host }
+    end
 end
