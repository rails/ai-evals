index 0000000..4b241f6
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.tracker
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+    8.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(failed_delivery)
+    assert_not @webhook.reload.active?
+  end
+
+  test "ten failures within an hour do not deactivate" do
+    10.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+  end
+
+  test "failures spanning an hour but fewer than ten do not deactivate" do
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(failed_delivery)
+    end
+    5.times { @tracker.record_delivery_of(failed_delivery) }
+    assert @webhook.reload.active?
+  end
+
+  test "a success resets the streak" do
+    travel_to 2.hours.ago do
+      5.times { @tracker.record_delivery_of(failed_delivery) }
+    end
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+    5.times { @tracker.record_delivery_of(failed_delivery) }
+
+    assert @webhook.reload.active?
+    assert_equal 5, @tracker.reload.consecutive_failures_count
+  end
+
+  test "reactivating resets the tracker" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "new webhooks get a tracker" do
+    webhook = Webhook.create!(name: "New", url: "https://example.com/hook", board: boards(:writebook))
+    assert webhook.delinquency_tracker.persisted?
+  end
+
+  private
+    def failed_delivery
+      webhook_deliveries(:unsuccessfully_completed)
+    end
+end
