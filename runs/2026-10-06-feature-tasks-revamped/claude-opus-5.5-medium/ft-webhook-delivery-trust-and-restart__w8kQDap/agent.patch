@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "creating an event enqueues webhook dispatch" do
+    assert_enqueued_with job: Event::WebhookDispatchJob do
+      boards(:writebook).events.create!(action: :card_published, creator: users(:david), eventable: cards(:logo))
+    end
+  end
+
+  test "dispatch creates one delivery per subscribed active webhook" do
+    event = events(:shipping_published)
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      event.dispatch_webhooks
+    end
+    assert_equal [ webhooks(:active) ], event.webhook_deliveries.map(&:webhook)
+  end
+
+  test "dispatching twice does not deliver twice" do
+    event = events(:shipping_published)
+    event.dispatch_webhooks
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.dispatch_webhooks
+    end
+  end
+
+  test "unsubscribed actions and inactive webhooks are skipped" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      events(:layout_commented).dispatch_webhooks
+    end
+
+    webhooks(:active).deactivate
+    assert_no_difference -> { Webhook::Delivery.count } do
+      events(:shipping_published).dispatch_webhooks
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
