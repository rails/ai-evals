index 0000000..377023e
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "comments show a reactions strip with a trigger" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select ".reactions__list##{dom_id(@comment, :reaction_list)}"
+      assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger[href=?]", new_card_comment_reaction_path(@card, @comment)
+    end
+  end
+
+  test "existing reactions show who left them" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:david))
+
+    get card_path(@card)
+
+    assert_select "##{dom_id(reaction)}.reaction[data-reaction-reacter-id-value=?]", users(:david).id do
+      assert_select ".reaction__avatar .avatar[aria-label=?]", users(:david).name
+      assert_select "span", text: "🎉"
+    end
+  end
+
+  test "new renders the reaction form in the frame" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form.reaction__form" do
+      assert_select "input.reaction__input[name=?][maxlength=?]", "reaction[content]", "16"
+      assert_select "button.reaction__submit-btn"
+      assert_select "a.reaction__cancel-btn[href=?]", card_comment_reactions_path(@card, @comment)
+    end
+  end
+
+  test "cancel brings back the trigger" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger"
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :turbo_stream
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "Great 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reaction_list) do
+      assert_select "##{dom_id(reaction)}.reaction"
+    end
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction) do
+      assert_select "a.reactions__trigger"
+    end
+  end
+
+  test "create broadcasts the reaction to everyone looking at the card" do
+    assert_turbo_stream_broadcasts @card, count: 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👀" } }, as: :turbo_stream
+    end
+  end
+
+  test "create rejects reactions over 16 characters" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy your own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy broadcasts the removal" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_turbo_stream_broadcasts @card, count: 1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+  end
+
+  test "cannot destroy someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ reaction.id ], @response.parsed_body.pluck("id")
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as JSON" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+
+    assert_response :created
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
