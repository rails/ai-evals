+++ b/app/models/reaction/broadcastable.rb
@@ -0,0 +1,17 @@
+module Reaction::Broadcastable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit  :broadcast_creation
+    after_destroy_commit :broadcast_removal
+  end
+
+  private
+    def broadcast_creation
+      broadcast_append_to card, target: [ comment, :reaction_list ], partial: "cards/comments/reactions/reaction", locals: { reaction: self }
+    end
+
+    def broadcast_removal
+      broadcast_remove_to card
+    end
+end
