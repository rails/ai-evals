diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..64a418b
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,37 @@
+class Reaction < ApplicationRecord
+  include Broadcastable
+
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true
+  validate :content_is_short
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_commit :touch_comment
+
+  delegate :card, to: :comment
+
+  def emoji?
+    content.match?(/\A[\p{Extended_Pictographic}\p{Emoji_Modifier}\p{Regional_Indicator}\u200D\uFE0F\u20E3\s]+\z/)
+  end
+
+  private
+    def content_is_short
+      if content.to_s.grapheme_clusters.size > MAX_CONTENT_LENGTH
+        errors.add(:content, :too_long, count: MAX_CONTENT_LENGTH)
+      end
+    end
+
+    # Bust the comment's cache without touching the card: reactions are streamed
+    # straight into the strip, so a page-wide refresh would only get in the way.
+    def touch_comment
+      Card.no_touching { comment.touch } unless comment.destroyed?
+    end
+end
