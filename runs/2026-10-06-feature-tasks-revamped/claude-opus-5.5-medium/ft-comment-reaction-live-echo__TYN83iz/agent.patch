@@ -0,0 +1,60 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults reacter and account" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "content is required and stripped" do
+    assert_not @comment.reactions.build(content: "   ").valid?
+    assert_equal "nice", @comment.reactions.create!(content: "  nice  ").content
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "multi-codepoint emoji count as a single character" do
+    assert @comment.reactions.build(content: "👨‍👩‍👧‍👦" * 16).valid?
+  end
+
+  test "emoji only" do
+    assert @comment.reactions.build(content: "👍").emoji?
+    assert @comment.reactions.build(content: "❤️ 🎉").emoji?
+    assert @comment.reactions.build(content: "👍🏽").emoji?
+    assert_not @comment.reactions.build(content: "Great 👍").emoji?
+    assert_not @comment.reactions.build(content: "100").emoji?
+  end
+
+  test "reacting refreshes the comment's cache key without touching the card" do
+    card_updated_at = @comment.card.reload.updated_at
+
+    assert_changes -> { @comment.reload.updated_at } do
+      travel 1.minute do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+
+    assert_equal card_updated_at, @comment.card.reload.updated_at
+  end
+
+  test "reactions are listed chronologically and go away with the comment" do
+    first = @comment.reactions.create!(content: "1", created_at: 2.minutes.ago)
+    second = @comment.reactions.create!(content: "2", created_at: 1.minute.ago)
+
+    assert_equal [ first, second ], @comment.reload.reactions
+
+    assert_difference -> { Reaction.count }, -2 do
+      @comment.destroy
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..ab87f40
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,95 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Love it"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Love it"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      # The button works again for the next one
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "🎉"
+      find(".reaction__input").send_keys :enter
+
+      assert_selector ".reaction", count: 2
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal [ "Love it", "🎉" ], @comment.reload.reactions.map(&:content)
+  end
+
+  test "picking an emoji and canceling" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      find(".reaction__cancel-btn").click
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find("button[title='Fire']").click
+
+      assert_selector ".reaction", text: "🔥"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "removing your own reaction" do
+    mine = @comment.reactions.create!(content: "mine", reacter: users(:david))
+    theirs = @comment.reactions.create!(content: "theirs", reacter: users(:kevin))
+
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within "##{dom_id(theirs)}" do
+      find("span", text: "theirs").click
+      assert_no_selector ".reaction__delete button", visible: true
+    end
+
+    within "##{dom_id(mine)}" do
+      assert_no_selector ".reaction__delete button", visible: true
+      find("span", text: "mine").click
+      find(".reaction__delete button", visible: true).click
+    end
+
+    assert_no_selector "##{dom_id(mine)}"
+    assert_selector "##{dom_id(theirs)}"
+    assert_not Reaction.exists?(mine.id)
+  end
+
+  test "reactions from others show up without reloading" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+    assert_selector "##{dom_id(@comment, :reactions)} .reactions__trigger"
+    sleep 1 # let the cable subscription settle
+
+    Current.set(session: sessions(:kevin)) do
+      @reaction = @comment.reactions.create!(content: "👀")
+    end
+
+    within "##{dom_id(@comment, :reaction_list)}" do
+      assert_selector "##{dom_id(@reaction)}", text: "👀", wait: 5
+    end
+
+    @reaction.destroy
+    assert_no_selector "##{dom_id(@reaction)}", wait: 5
+  end
+end
