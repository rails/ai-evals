+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(@card, @comment), class: "reaction reaction__form expanded",
+        data: { controller: "reaction-form", action: "submit->reaction-form#preventEmptySubmit keydown.esc->reaction-form#cancel:stop" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label", tabindex: -1 do %>
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, class: "input reaction__input", required: true, autofocus: true, autocomplete: "off",
+          maxlength: Reaction::MAX_CONTENT_LENGTH, placeholder: "Say something…", data: { reaction_form_target: "input" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false"
+         data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <%= tag.button emoji, type: :button, class: "btn borderless", title: label, aria: { label: label },
+                  data: { action: "reaction-form#pick", reaction_form_content_param: emoji } %>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment), class: "reaction__cancel-btn btn btn--circle borderless", title: "Cancel",
+          data: { reaction_form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
