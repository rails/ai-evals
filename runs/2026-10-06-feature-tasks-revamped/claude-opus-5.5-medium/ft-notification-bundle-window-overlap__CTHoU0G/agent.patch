diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..31aaded
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "no bundles when bundling is off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notify(events(:layout_published))
+    end
+  end
+
+  test "the first notification opens a window sized by the user's frequency" do
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, period|
+      @user.notification_bundles.delete_all
+      Notification.where(user: @user).delete_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      notification = notify(events(:layout_published))
+      bundle = @user.notification_bundles.sole
+
+      assert_equal notification.updated_at, bundle.starts_at
+      assert_equal notification.updated_at + period, bundle.ends_at
+      assert bundle.pending?
+    end
+  end
+
+  test "notifications inside an open window join it" do
+    first = notify(events(:layout_published))
+
+    travel 2.hours do
+      assert_no_difference -> { @user.notification_bundles.count } do
+        notify(events(:logo_published))
+      end
+    end
+
+    assert_equal 2, @user.notification_bundles.sole.notifications.count
+  end
+
+  test "notifications after the window closes open a new adjacent-free window" do
+    notify(events(:layout_published))
+
+    travel 5.hours do
+      notify(events(:logo_published))
+    end
+
+    first, second = @user.notification_bundles.chronologically.to_a
+    assert second.starts_at >= first.ends_at
+  end
+
+  test "late notifications join the window that already opened" do
+    travel_to Time.utc(2026, 1, 1, 10) do
+      notify(events(:layout_published))
+    end
+
+    travel_to Time.utc(2026, 1, 1, 10, 30) do
+      late = Notification.create!(user: @user, source: events(:logo_published), creator: users(:jason),
+        created_at: Time.utc(2026, 1, 1, 9, 50), updated_at: Time.utc(2026, 1, 1, 9, 50))
+
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.utc(2026, 1, 1, 9, 50), bundle.starts_at
+      assert_equal Time.utc(2026, 1, 1, 14), bundle.ends_at
+      assert_includes bundle.notifications, late
+    end
+  end
+
+  test "late notifications never stretch a window over the previous one" do
+    previous = @user.notification_bundles.create!(starts_at: Time.utc(2026, 1, 1, 6), ends_at: Time.utc(2026, 1, 1, 10), status: :delivered)
+    open = @user.notification_bundles.create!(starts_at: Time.utc(2026, 1, 1, 11), ends_at: Time.utc(2026, 1, 1, 15))
+
+    open.stretch_to_cover(Time.utc(2026, 1, 1, 9))
+
+    assert_equal previous.ends_at, open.reload.starts_at
+  end
+
+  test "a new window never starts inside an existing one" do
+    @user.notification_bundles.create!(starts_at: 1.hour.ago, ends_at: 1.minute.ago, status: :delivered)
+
+    Notification.create!(user: @user, source: events(:logo_published), creator: users(:jason), updated_at: 30.minutes.ago)
+
+    first, second = @user.notification_bundles.chronologically.to_a
+    assert_equal first.ends_at, second.starts_at
+  end
+
+  test "overlapping windows are invalid" do
+    @user.notification_bundles.create!(starts_at: Time.utc(2026, 1, 1, 10), ends_at: Time.utc(2026, 1, 1, 14))
+
+    overlapping = @user.notification_bundles.build(starts_at: Time.utc(2026, 1, 1, 13), ends_at: Time.utc(2026, 1, 1, 17))
+    assert_not overlapping.valid?
+
+    adjacent = @user.notification_bundles.build(starts_at: Time.utc(2026, 1, 1, 14), ends_at: Time.utc(2026, 1, 1, 18))
+    assert adjacent.valid?
+
+    other_user = users(:kevin).notification_bundles.build(starts_at: Time.utc(2026, 1, 1, 13), ends_at: Time.utc(2026, 1, 1, 17))
+    assert other_user.valid?
+  end
+
+  test "deliver_all_due sends one email per due window" do
+    notify(events(:layout_published))
+    notify(events(:logo_published))
+
+    travel 4.hours + 1.minute do
+      assert_emails 1 do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) { Notification::Bundle.deliver_all_due }
+      end
+
+      assert @user.notification_bundles.sole.delivered?
+
+      assert_no_emails do
+        perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) { Notification::Bundle.deliver_all_due }
+      end
+    end
+  end
+
+  test "windows that are not due are not delivered" do
+    notify(events(:layout_published))
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+      Notification::Bundle.deliver_all_due
+    end
+  end
+
+  test "read notifications are left out and empty windows send nothing" do
+    notify(events(:layout_published)).read
+
+    travel 5.hours do
+      assert_no_emails { @user.notification_bundles.sole.deliver }
+      assert @user.notification_bundles.sole.delivered?
+    end
+  end
+
+  test "turning bundling off drops pending windows" do
+    notify(events(:layout_published))
+
+    assert_difference -> { @user.notification_bundles.count }, -1 do
+      @user.settings.update!(bundle_email_frequency: :never)
+    end
+  end
+
+  private
+    def notify(source)
+      Notification.create!(user: @user, source: source, creator: users(:jason))
+    end
+end
