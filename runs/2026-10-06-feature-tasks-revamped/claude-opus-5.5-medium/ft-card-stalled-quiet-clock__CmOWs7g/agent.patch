diff --git a/test/controllers/cards/stalled_cards_test.rb b/test/controllers/cards/stalled_cards_test.rb
new file mode 100644
index 0000000..673eee0
--- /dev/null
+++ b/test/controllers/cards/stalled_cards_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Cards::StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @stalled = cards(:logo)
+    @stalled.create_burst!
+    @stalled.update_columns last_active_at: 3.weeks.ago
+  end
+
+  test "index as JSON lists stalled cards" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+
+    assert_equal [ @stalled.number ], @response.parsed_body.pluck("number")
+    assert @response.parsed_body.first["stalled"]
+  end
+
+  test "index lists stalled cards" do
+    get cards_path(indexed_by: "stalled")
+    assert_response :success
+
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    assert_select "article.card", count: 1
+  end
+
+  test "card JSON shows whether the card is stalled" do
+    get card_path(@stalled, format: :json)
+    assert_equal true, @response.parsed_body["stalled"]
+
+    get card_path(cards(:layout), format: :json)
+    assert_equal false, @response.parsed_body["stalled"]
+  end
+
+  test "card page shows the card as stalled" do
+    get card_path(@stalled)
+    assert_response :success
+    assert_select ".card-perma .card__stalled", text: "Stalled"
+  end
+
+  test "board columns show stalled cards" do
+    get board_column_path(boards(:writebook), columns(:writebook_triage))
+    assert_response :success
+    assert_select "article.card--stalled"
+  end
+
+  test "commenting resets a stalled card" do
+    post card_comments_path(@stalled, format: :json), params: { comment: { body: "Back on it" } }
+    assert_response :success
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_empty @response.parsed_body
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..6b68036
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = Card.find(boards(:writebook).cards.create!(title: "Fresh", status: "published", creator: users(:david)).id)
+    boards(:writebook).update! auto_postpone_period: 30.days
+  end
+
+  test "three comments from two people within a third of the auto-postpone period make a burst" do
+    comment_as :david, :jz, :david, spaced: 3.days
+    assert @card.reload.bursted?
+  end
+
+  test "comments from a single person don't make a burst" do
+    comment_as :david, :david, :david, :david
+    assert_not @card.reload.bursted?
+  end
+
+  test "two comments don't make a burst" do
+    comment_as :david, :jz
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments spread beyond a third of the auto-postpone period don't make a burst" do
+    comment_as :david, :jz, :david, spaced: 6.days
+    assert_not @card.reload.bursted?
+  end
+
+  test "the burst window follows the board's auto-postpone period" do
+    boards(:writebook).update! auto_postpone_period: 90.days
+    comment_as :david, :jz, :david, spaced: 14.days
+    assert @card.reload.bursted?
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_as :david, :system, :system
+    assert_not @card.reload.bursted?
+  end
+
+  test "assigning someone makes a burst" do
+    @card.toggle_assignment users(:jz)
+    assert @card.reload.bursted?
+  end
+
+  test "reopening makes a burst" do
+    @card.close
+    assert_not @card.reload.bursted?
+
+    @card.reopen
+    assert @card.reload.bursted?
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    @card.toggle_assignment users(:jz)
+
+    travel 14.days - 1.minute
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.minutes
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a card without a burst is never stalled" do
+    travel 1.month
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity before the stall pushes it back" do
+    @card.toggle_assignment users(:jz)
+
+    travel 10.days
+    comment_as :kevin
+
+    travel 10.days
+    assert_not @card.reload.stalled?
+
+    travel 4.days
+    assert @card.reload.stalled?
+  end
+
+  test "activity on a stalled card resets it" do
+    @card.toggle_assignment users(:jz)
+    travel 15.days
+    assert @card.reload.stalled?
+
+    comment_as :kevin
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+    assert_not_includes Card.stalled, @card
+
+    travel 15.days
+    assert_not @card.reload.stalled?
+  end
+
+  test "a burst on a stalled card starts a fresh burst" do
+    @card.toggle_assignment users(:jz)
+    travel 15.days
+
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.reload.stalled?
+    assert @card.bursted?
+
+    travel 15.days
+    assert @card.reload.stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment users(:jz)
+    travel 15.days
+    assert @card.reload.stalled?
+
+    Card.where(id: @card.id).update_all(last_active_at: 15.days.ago)
+    @card.create_closure!(user: users(:david))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "becoming stalled changes the cache version" do
+    @card.toggle_assignment users(:jz)
+    version = @card.reload.cache_version
+
+    travel 15.days
+    assert_not_equal version, @card.reload.cache_version
+  end
+
+  private
+    def comment_as(*user_names, spaced: 1.minute)
+      user_names.each_with_index do |name, index|
+        travel spaced unless index.zero?
+        @card.comments.create!(creator: users(name), body: "Comment #{index}")
+      end
+    end
+end
