+module Identity::MagicLinkable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :magic_links, dependent: :delete_all
+  end
+
+  def send_magic_link(purpose: :sign_in)
+    magic_links.create!(purpose: purpose).tap do |magic_link|
+      MagicLinkMailer.sign_in_instructions(magic_link).deliver_later
+    end
+  end
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..5ae1fd4
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,48 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ].index_by(&:itself), prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ...Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, presence: true, uniqueness: true
+
+  class << self
+    def consume(code)
+      if code = Code.sanitize(code).presence
+        active.find_by(code: code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  # Returns self when this request consumed the code, and nil when a concurrent one beat it to it.
+  def consume
+    self if self.class.where(id: id).delete_all == 1
+  end
+
+  def active?
+    expires_at.future?
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate(CODE_LENGTH)
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..54ac790
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,17 @@
+# Codes use Crockford's Base32 alphabet, which leaves out letters that are easy to confuse
+# with digits (I, L, O) and U. When reading a code typed in by a person, we map those
+# lookalikes back to the digits they resemble and drop anything else, like spaces or dashes.
+module MagicLink::Code
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+  LOOKALIKES = { "O" => "0", "I" => "1", "L" => "1" }
+
+  class << self
+    def generate(length)
+      SecureRandom.alphanumeric(length, chars: ALPHABET.chars)
+    end
+
+    def sanitize(code)
+      code.to_s.upcase.gsub(/[OIL]/, LOOKALIKES).delete("^#{ALPHABET}")
+    end
+  end
+end
