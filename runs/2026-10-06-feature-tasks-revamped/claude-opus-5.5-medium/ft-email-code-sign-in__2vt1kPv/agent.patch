diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..f1b3303
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,69 @@
+class Sessions::MagicLinksController < ApplicationController
+  include Authentication::ViaMagicLink
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_email_address
+
+  layout "public"
+
+  def show
+  end
+
+  def create
+    if magic_link = Identity.find_by(email_address: @email_address)&.magic_links&.consume(params[:code])
+      sign_in_with magic_link
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_email_address
+      unless @email_address = email_address_pending_authentication
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a code." }
+          format.json { render json: { message: "Enter your email address to get a code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def sign_in_with(magic_link)
+      clear_pending_authentication
+      start_new_session_for magic_link.identity
+
+      respond_to do |format|
+        format.html { redirect_to after_magic_link_url(magic_link) }
+        format.json { render json: { session_token: session_token, requires_signup_completion: magic_link.for_sign_up? } }
+      end
+    end
+
+    def after_magic_link_url(magic_link)
+      if magic_link.for_sign_up?
+        session.delete(:return_to_after_authenticating)
+        new_signup_completion_url
+      else
+        after_authentication_url
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Check it and try again."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
