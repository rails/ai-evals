diff --git a/app/controllers/concerns/authentication/via_magic_link.rb b/app/controllers/concerns/authentication/via_magic_link.rb
new file mode 100644
index 0000000..77c304e
--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,41 @@
+# Sign-in by email code. After someone asks for a code, we remember which email address is waiting to be
+# verified with a short-lived signed token: a cookie in browsers, or a value returned to JSON clients that
+# they send back with the code. A code is only accepted for the email address it was sent to.
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  private
+    def redirect_to_session_magic_link(email_address, return_to: nil)
+      token = pending_authentication_verifier.generate(email_address, expires_in: MagicLink::EXPIRATION_TIME)
+      session[:return_to_after_authenticating] = return_to if return_to
+
+      respond_to do |format|
+        format.html do
+          cookies[:pending_authentication_token] = { value: token, expires: MagicLink::EXPIRATION_TIME.from_now, httponly: true, same_site: :lax }
+          redirect_to main_app.session_magic_link_url(script_name: nil)
+        end
+
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
+    end
+
+    def email_address_pending_authentication
+      pending_authentication_verifier.verified(pending_authentication_token)
+    end
+
+    def pending_authentication_token
+      if params[:pending_authentication_token].is_a?(String)
+        params[:pending_authentication_token]
+      else
+        cookies[:pending_authentication_token]
+      end
+    end
+
+    def clear_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def pending_authentication_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+end
