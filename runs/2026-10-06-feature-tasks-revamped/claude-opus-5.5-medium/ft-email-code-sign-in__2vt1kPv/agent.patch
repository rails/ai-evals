index 0000000..2680ed3
--- /dev/null
+++ b/app/views/sessions/magic_links/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { turbo: false } do |form| %>
+    <p>We sent a code to <strong><%= @email_address %></strong>. Enter it below to continue. It works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+              maxlength: MagicLink::CODE_LENGTH * 2, placeholder: "Enter your code…", aria: { label: "Code" } %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-subtle txt-small margin-block-start">Didn’t get it? Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %>.</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
