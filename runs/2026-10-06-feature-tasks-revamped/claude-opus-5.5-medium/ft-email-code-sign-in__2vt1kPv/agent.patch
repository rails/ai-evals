diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..70a0c26
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code that works for fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match(/\A[#{MagicLink::Code::ALPHABET}]{6}\z/o, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "consume" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_nil MagicLink.consume(magic_link.code), "A code only works once"
+  end
+
+  test "consume forgives lowercase, spaces, and lookalike letters" do
+    magic_link = @identity.magic_links.create!(code: "0A1B2C")
+
+    assert_equal magic_link, MagicLink.consume(" oa-ib 2c ")
+  end
+
+  test "consume rejects expired codes" do
+    magic_link = @identity.magic_links.create!
+
+    travel 15.minutes + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume rejects blank and unknown codes" do
+    @identity.magic_links.create!
+
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("------")
+  end
+
+  test "consume is scoped to an identity" do
+    magic_link = @identity.magic_links.create!
+
+    assert_nil identities(:david).magic_links.consume(magic_link.code)
+    assert_equal magic_link, @identity.magic_links.consume(magic_link.code)
+  end
+
+  test "cleanup deletes expired codes" do
+    active = @identity.magic_links.create!
+    expired = @identity.magic_links.create!(expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(expired.id)
+  end
+
+  test "send_magic_link emails the code" do
+    assert_enqueued_email_with MagicLinkMailer, :sign_in_instructions, args: ->(args) { args.first.identity == @identity } do
+      @identity.send_magic_link(purpose: :sign_up)
+    end
+
+    assert @identity.magic_links.last.for_sign_up?
+  end
+end
