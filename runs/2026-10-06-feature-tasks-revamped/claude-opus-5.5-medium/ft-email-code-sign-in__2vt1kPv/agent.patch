+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "sign in with a code from email" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address.upcase }
+      end
+      assert_redirected_to session_magic_link_url
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @identity.email_address ], email.to
+      code = email.subject[/[A-Z0-9]{6}\z/]
+
+      get session_magic_link_path
+      assert_response :success
+      assert_in_body @identity.email_address
+
+      post session_magic_link_path, params: { code: code.downcase }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not MagicLink.exists?(code: code)
+    end
+  end
+
+  test "sign in returns to the page that asked for authentication" do
+    get board_path(boards(:writebook))
+    assert_redirected_to new_session_path(script_name: nil)
+
+    post session_path(script_name: ""), params: { email_address: @identity.email_address }
+    post session_magic_link_path(script_name: ""), params: { code: @identity.magic_links.last.code }
+
+    assert_redirected_to board_url(boards(:writebook))
+  end
+
+  test "a wrong code does not sign in" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to session_magic_link_path
+      assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code only works for the email address it was sent to" do
+    other_code = identities(:david).magic_links.create!.code
+
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      post session_magic_link_path, params: { code: other_code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "an expired code does not sign in" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      code = @identity.magic_links.last.code
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "requires an email address pending authentication" do
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to new_session_path
+
+      post session_magic_link_path, params: { code: @identity.magic_links.create!.code }
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "sign in via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: @identity.email_address }
+      assert_response :created
+      token = response.parsed_body["pending_authentication_token"]
+
+      post session_magic_link_path(format: :json), params: { code: "WRONG1", pending_authentication_token: token }
+      assert_response :unauthorized
+
+      post session_magic_link_path(format: :json), params: { code: @identity.magic_links.last.code, pending_authentication_token: token }
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+      assert_equal false, response.parsed_body["requires_signup_completion"]
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: @identity.email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: @identity.magic_links.last.code }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+end
