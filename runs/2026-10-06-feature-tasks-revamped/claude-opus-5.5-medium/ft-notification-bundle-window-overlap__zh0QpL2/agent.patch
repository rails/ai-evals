@@ -0,0 +1,22 @@
+class Notification::BundleMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications_by_board = bundle.notifications.preloaded.order(updated_at: :desc).group_by { it.card.board }
+
+    @user.in_time_zone do
+      mail to: @user.identity.email_address, subject: subject_for(@notifications_by_board.values.sum(&:size))
+    end
+  end
+
+  private
+    def default_url_options
+      super.merge(script_name: @bundle.account.slug)
+    end
+
+    def subject_for(count)
+      "#{count} new #{"notification".pluralize(count)} in Fizzy"
+    end
+end
