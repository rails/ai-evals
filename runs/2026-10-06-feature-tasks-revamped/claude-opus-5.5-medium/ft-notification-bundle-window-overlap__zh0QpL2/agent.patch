@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @bundle = @user.notification_bundles.create!(starts_at: 2.weeks.ago, ends_at: 1.minute.from_now)
+  end
+
+  test "notification lists the bundle's unread notifications grouped by board" do
+    notifications(:layout_commented_kevin).read
+
+    email = Notification::BundleMailer.notification(@bundle)
+    assert_emails(1) { email.deliver_now }
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "2 new notifications in Fizzy", email.subject
+
+    html = email.html_part.body.to_s
+    assert_match ERB::Util.html_escape(cards(:logo).title), html
+    assert_match cards(:buy_domain).title, html
+    assert_no_match cards(:layout).title, html
+    assert_match %r{/#{@user.account.external_account_id}/cards/#{cards(:logo).number}}, html
+    assert_match "once a day", html
+    assert_match %r{/#{@user.account.external_account_id}/notifications/settings}, html
+
+    assert_match cards(:logo).title, email.text_part.body.to_s
+  end
+
+  test "subject uses the singular for a single notification" do
+    notifications(:logo_assignment_kevin).read
+    notifications(:layout_commented_kevin).read
+
+    assert_equal "1 new notification in Fizzy", Notification::BundleMailer.notification(@bundle).subject
+  end
+  test "times are shown in the person's time zone" do
+    @user.settings.update!(timezone_name: "America/Chicago")
+    @bundle.update!(starts_at: Time.utc(2026, 1, 5, 15, 0))
+
+    email = @user.in_time_zone { Notification::BundleMailer.notification(@bundle) }
+
+    assert_match "January 05, 2026 09:00", email.text_part.body.to_s
+  end
+end
