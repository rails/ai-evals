diff --git a/app/models/user/notification_bundling.rb b/app/models/user/notification_bundling.rb
new file mode 100644
index 0000000..849f51f
--- /dev/null
+++ b/app/models/user/notification_bundling.rb
@@ -0,0 +1,19 @@
+module User::NotificationBundling
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :notification_bundles, class_name: "Notification::Bundle", dependent: :delete_all
+  end
+
+  def bundling_emails?
+    active? && !system? && identity.present? && settings&.bundling_emails?
+  end
+
+  def bundle(notification)
+    transaction do
+      # Serializes bundling for this person so concurrent notifications can't open overlapping windows.
+      settings.lock!
+      notification_bundles.find_or_create_for(notification)
+    end
+  end
+end
