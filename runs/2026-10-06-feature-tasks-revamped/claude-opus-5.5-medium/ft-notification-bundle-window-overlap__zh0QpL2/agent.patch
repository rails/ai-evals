 class User::Settings < ApplicationRecord
+  BUNDLE_AGGREGATION_PERIODS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
   belongs_to :account, default: -> { user.account }
   belongs_to :user
 
+  enum :bundle_email_frequency, %w[ never every_few_hours daily weekly ].index_by(&:itself),
+    default: :never, prefix: :bundle_email
+
+  after_update :review_pending_bundles, if: :saved_change_to_bundle_email_frequency?
+
   def timezone
     if timezone_name.present?
       ActiveSupport::TimeZone[timezone_name] || default_timezone
@@ -10,8 +21,24 @@ class User::Settings < ApplicationRecord
     end
   end
 
+  def bundling_emails?
+    !bundle_email_never?
+  end
+
+  def bundle_aggregation_period
+    BUNDLE_AGGREGATION_PERIODS[bundle_email_frequency]
+  end
+
   private
     def default_timezone
       ActiveSupport::TimeZone["UTC"]
     end
+
+    def review_pending_bundles
+      if bundling_emails?
+        user.notification_bundles.pending.chronologically.each(&:reschedule)
+      else
+        user.notification_bundles.pending.delete_all
+      end
+    end
 end
