+
+  test "update the email frequency via JSON" do
+    patch notifications_settings_path(format: :json), params: { user_settings: { bundle_email_frequency: "weekly" } }, as: :json
+
+    assert_response :no_content
+    assert @user.settings.reload.bundle_email_weekly?
+  end
 end
