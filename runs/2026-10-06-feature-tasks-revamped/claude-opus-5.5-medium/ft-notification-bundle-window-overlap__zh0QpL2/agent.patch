+<h1 class="title">Here’s what you missed</h1>
+<p class="subtitle margin-block-end-double">New activity in <%= @user.account.name %> since <%= l @bundle.starts_at.in_time_zone, format: :long %>.</p>
+
+<% @notifications_by_board.each do |board, notifications| %>
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator, size: 40 %></td>
+        <td>
+          <h3 class="card__title"><%= link_to payload.title, payload.url %></h3>
+          <p class="notification__details"><%= payload.body %></p>
+          <p class="notification__author"><%= notification.creator.name %> · <%= l notification.updated_at.in_time_zone, format: :short %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  You get these emails <%= bundle_email_frequency_description(@user.settings) %>.
+  <%= link_to "Change your email notification settings", notifications_settings_url %>.
+</p>
