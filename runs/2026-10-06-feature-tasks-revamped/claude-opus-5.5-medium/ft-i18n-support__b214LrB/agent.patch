diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..c34b0aa
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,49 @@
+# Picks the language each request renders in.
+#
+# Anyone can switch by opening any page with `?locale=ja`. The choice is remembered in the
+# session and, for signed-in people, on their identity, so it follows them the next time they
+# sign in from a clean browser. Unknown locales are ignored. People who never chose anything
+# get the default locale.
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :set_current_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&)
+      remember_requested_locale
+      I18n.with_locale(locale_from_session || I18n.default_locale, &)
+    end
+
+    def remember_requested_locale
+      session[:locale] = requested_locale if requested_locale
+    end
+
+    def requested_locale
+      Locale.find(params[:locale]) if params[:locale].is_a?(String)
+    end
+
+    def locale_from_session
+      Locale.find(session[:locale])
+    end
+
+    # Called once we know who is looking.
+    def adopt_locale_of(identity)
+      if requested_locale
+        identity.remember_locale requested_locale
+      elsif locale_from_session.nil? && identity.preferred_locale?
+        I18n.locale = identity.preferred_locale
+      end
+    end
+
+    # Called when someone signs in: a choice they made before signing in becomes their preference.
+    def store_locale_for(identity)
+      if locale = locale_from_session
+        identity.remember_locale locale
+      end
+    end
+end
