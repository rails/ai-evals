diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..fc01038
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,55 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Translations for the current locale are rendered by the server in the `i18n` meta tag
+// (see JavascriptTranslationsHelper). Keys are dot-separated paths, values can interpolate
+// `%{name}` placeholders and be pluralized with a `count` value.
+
+const DEFAULT_LOCALE = "en"
+
+let cachedSource
+let cachedTranslations = {}
+
+export function currentLocale() {
+  return getMetaContent("locale") || DEFAULT_LOCALE
+}
+
+// The locale to hand to Intl APIs, e.g. "en-US" or "ja-JP".
+export function intlLocale() {
+  return getMetaContent("intl-locale") || "en-US"
+}
+
+export function t(key, values = {}) {
+  let translation = lookup(key)
+
+  if (translation && typeof translation === "object" && "count" in values) {
+    translation = pluralize(translation, values.count)
+  }
+
+  if (typeof translation !== "string") return key
+
+  return translation.replace(/%\{(\w+)\}/g, (match, name) => name in values ? values[name] : match)
+}
+
+function lookup(key) {
+  return key.split(".").reduce((scope, part) => scope?.[part], translations())
+}
+
+function pluralize(translation, count) {
+  const rule = new Intl.PluralRules(intlLocale()).select(count)
+  return (count === 0 && translation.zero) || translation[rule] || translation.other
+}
+
+function translations() {
+  const source = getMetaContent("i18n") || "{}"
+
+  if (source !== cachedSource) {
+    cachedSource = source
+    try {
+      cachedTranslations = JSON.parse(source)
+    } catch {
+      cachedTranslations = {}
+    }
+  }
+
+  return cachedTranslations
+}
