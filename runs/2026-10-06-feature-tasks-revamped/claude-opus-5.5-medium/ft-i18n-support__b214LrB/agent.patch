diff --git a/app/helpers/javascript_translations_helper.rb b/app/helpers/javascript_translations_helper.rb
new file mode 100644
index 0000000..bbc0ac2
--- /dev/null
+++ b/app/helpers/javascript_translations_helper.rb
@@ -0,0 +1,21 @@
+module JavascriptTranslationsHelper
+  INTL_LOCALES = { en: "en-US", ja: "ja-JP" }
+
+  # Meta tags read by app/javascript/helpers/i18n_helpers.js.
+  def javascript_i18n_meta_tags
+    safe_join [
+      tag.meta(name: "locale", content: I18n.locale),
+      tag.meta(name: "intl-locale", content: intl_locale),
+      tag.meta(name: "i18n", content: javascript_translations.to_json)
+    ], "\n"
+  end
+
+  def intl_locale
+    INTL_LOCALES.fetch(I18n.locale, I18n.locale.to_s)
+  end
+
+  private
+    def javascript_translations
+      I18n.t("javascript", default: {})
+    end
+end
