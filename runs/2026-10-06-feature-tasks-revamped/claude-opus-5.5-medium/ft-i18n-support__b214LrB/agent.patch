+module LocalizationHelper
+  # Rendered fragments contain text in the locale they were rendered in, so fragments rendered
+  # in other locales are cached separately. Default-locale keys are unchanged.
+  def cache_fragment_name(name = {}, **options)
+    if I18n.locale == I18n.default_locale
+      super
+    else
+      super([ I18n.locale, name ], **options)
+    end
+  end
+end
