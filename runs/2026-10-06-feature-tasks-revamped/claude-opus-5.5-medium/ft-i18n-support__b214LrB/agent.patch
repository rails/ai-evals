diff --git a/app/models/identity/localizable.rb b/app/models/identity/localizable.rb
new file mode 100644
index 0000000..391dfe9
--- /dev/null
+++ b/app/models/identity/localizable.rb
@@ -0,0 +1,32 @@
+module Identity::Localizable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :locale, inclusion: { in: ->(_) { I18n.available_locales.map(&:to_s) } }, allow_nil: true
+    normalizes :locale, with: ->(value) { value.to_s.presence }
+  end
+
+  def preferred_locale
+    Locale.find(locale) || I18n.default_locale
+  end
+
+  def preferred_locale?
+    Locale.available?(locale)
+  end
+
+  # Remembers the locale this person chose. Requests served from a read replica can't write,
+  # so the choice is stored in the background there.
+  def remember_locale(locale)
+    unless self.locale == locale.to_s
+      if ActiveRecord::Base.current_preventing_writes
+        Identity::RememberLocaleJob.perform_later(self, locale.to_s)
+      else
+        update!(locale: locale.to_s)
+      end
+    end
+  end
+
+  def with_preferred_locale(&)
+    I18n.with_locale(preferred_locale, &)
+  end
+end
diff --git a/app/models/locale.rb b/app/models/locale.rb
new file mode 100644
index 0000000..a3a4a08
--- /dev/null
+++ b/app/models/locale.rb
@@ -0,0 +1,12 @@
+module Locale
+  extend self
+
+  # Returns the available locale matching +name+ as a symbol, or nil when we don't offer it.
+  def find(name)
+    I18n.available_locales.find { |locale| locale.to_s == name.to_s } if name.present?
+  end
+
+  def available?(name)
+    find(name).present?
+  end
+end
