+        post user_data_exports_path(users(:david))
+      end
+    end
+
+    assert_redirected_to user_path(users(:david))
+  end
+
+  test "can't export someone else's cards" do
+    assert_no_difference -> { Export.count } do
+      post user_data_exports_path(users(:jz))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show" do
+    export = User::DataExport.create!(account: accounts("37s"), user: users(:david))
+    export.build
+
+    get user_data_export_path(users(:david), export)
+    assert_response :success
+    assert_select "a[href*='/rails/active_storage/blobs/']"
+  end
+  test "the export button is on your own profile page" do
+    get user_path(users(:david))
+    assert_select "form[action='#{user_data_exports_path(users(:david))}']"
+
+    get user_path(users(:jz))
+    assert_select "form[action='#{user_data_exports_path(users(:jz))}']", count: 0
+  end
+end
