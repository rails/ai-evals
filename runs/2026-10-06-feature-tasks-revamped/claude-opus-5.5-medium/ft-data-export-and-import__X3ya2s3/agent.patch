diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..8d67afc
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "an admin can export the account" do
+    sign_in_as :kevin
+
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: DataExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal users(:kevin), Account::Export.last.user
+  end
+
+  test "members can't export the account" do
+    sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "show a completed export with its download link" do
+    sign_in_as :kevin
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a[href*='/rails/active_storage/blobs/']"
+
+    get rails_blob_path(export.file, disposition: "attachment")
+    assert_response :redirect
+  end
+
+  test "expired exports can't be downloaded" do
+    sign_in_as :kevin
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+    export.update!(completed_at: 25.hours.ago)
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a[href*='/rails/active_storage/blobs/']", count: 0
+    assert_match "expired", response.body
+  end
+
+  test "other admins can't see someone else's export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    sign_in_as :jason
+
+    get account_export_path(export)
+    assert_response :not_found
+  end
+  test "the export button is on the account settings page for admins only" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_select "form[action='#{account_exports_path}']"
+
+    logout_and_sign_in_as :david
+    get account_settings_path
+    assert_select "form[action='#{account_exports_path}']", count: 0
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..81f30da
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name=file]"
+  end
+
+  test "create starts an import" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+    file = Tempfile.new([ "export", ".zip" ]).tap { it.binmode; it.write(export.file.download); it.rewind }
+
+    untenanted do
+      assert_difference -> { Account::Import.count }, 1 do
+        assert_enqueued_with job: ImportAccountDataJob do
+          post account_imports_path, params: { file: fixture_file_upload(file.path, "application/zip") }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: nil)
+    assert_equal identities(:david), import.identity
+    assert import.file.attached?
+
+    perform_enqueued_jobs only: ImportAccountDataJob
+    assert import.reload.completed?, import.failure_reason
+
+    untenanted do
+      get account_import_path(import, script_name: nil)
+    end
+    assert_response :success
+    assert_match "Your import is done", response.body
+  end
+
+  test "create rejects files that aren't zip files" do
+    untenanted do
+      assert_no_difference -> { Account::Import.count } do
+        post account_imports_path, params: { file: fixture_file_upload("avatar.png", "image/png") }
+      end
+    end
+
+    assert_redirected_to new_account_import_path(script_name: nil)
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+    assert_no_match %r{/account/imports}, response.location
+  end
+end
