diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..4bba2d6
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,161 @@
+# Brings an account export back in as a brand new account. The new account is
+# created when the file is uploaded (the file needs somewhere to live), but
+# nobody can get into it until the import completes. Everything is imported
+# in a single transaction: if anything goes wrong, the account and all the
+# files copied for it are removed, and the person importing is told why.
+class Account::Import < ApplicationRecord
+  class Error < StandardError; end
+
+  PLACEHOLDER_NAME = "Importing…"
+
+  belongs_to :account, optional: true
+  belongs_to :identity
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  class << self
+    def start(identity:, file:)
+      account = Account.create!(name: PLACEHOLDER_NAME)
+
+      Current.with_account(account) do
+        create!(account: account, identity: identity, file: file).tap(&:process_later)
+      end
+    rescue
+      account&.destroy
+      raise
+    end
+  end
+
+  def process_later
+    ImportAccountDataJob.perform_later(self)
+  end
+
+  def process
+    Current.with_account(account) do
+      processing!
+      import_file
+      update!(status: :completed, completed_at: Time.current)
+    end
+
+    file.purge_later
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    fail_with error
+  end
+
+  private
+    def import_file
+      id_map = Account::DataTransfer::IdMap.new
+
+      ZipFile.read_from(file.blob) do |zip|
+        manifest = Account::DataTransfer::Manifest.new(account)
+        source_account_id = check(zip, manifest)
+
+        transaction(requires_new: true) do
+          import_records(zip, manifest, id_map, source_account_id)
+          grant_access_to_importer
+          reindex
+        end
+      end
+
+      reconcile_storage
+    rescue
+      delete_stored_files(id_map.storage_keys)
+      raise
+    end
+
+    def check(zip, manifest)
+      if zip.glob("data/accounts/*.json").empty?
+        raise Error, "This file isn't a Fizzy account export"
+      end
+
+      manifest.account_record_set.source_account_id(from: zip).tap do |source_account_id|
+        manifest.each_record_set { |record_set| record_set.check(from: zip, source_account_id: source_account_id) }
+      end
+    end
+
+    def import_records(zip, manifest, id_map, source_account_id)
+      id_map[source_account_id] = account.id
+
+      manifest.each_record_set do |record_set|
+        id_map.register(record_set.ids(from: zip)) unless record_set.model == Account
+      end
+
+      manifest.each_record_set do |record_set|
+        record_set.import(from: zip, id_map: id_map)
+      end
+    end
+
+    def grant_access_to_importer
+      account.users.find_or_create_by!(role: :system) { it.name = "System" }
+
+      if user = account.users.find_by(identity: identity)
+        user.update!(active: true, role: :owner, verified_at: user.verified_at || Time.current)
+      else
+        account.users.create!(identity: identity, name: importer_name, role: :owner, verified_at: Time.current)
+      end
+    end
+
+    def importer_name
+      identity.users.where.not(account: account).order(:created_at).last&.name || identity.email_address
+    end
+
+    def reindex
+      account.cards.published.includes(:rich_text_description).find_each(&:reindex)
+      Comment.where(account: account).includes(:card, :rich_text_body).find_each(&:reindex)
+    end
+
+    def reconcile_storage
+      account.reconcile_storage
+      account.boards.find_each(&:reconcile_storage)
+    rescue => error
+      Rails.error.report(error, severity: :warning)
+    end
+
+    def delete_stored_files(keys)
+      keys.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue => error
+        Rails.error.report(error, severity: :warning)
+      end
+    end
+
+    def fail_with(error)
+      Rails.error.report(error, severity: :error) unless expected_error?(error)
+
+      update_columns(status: "failed", failure_reason: failure_reason_for(error), updated_at: Time.current)
+      remove_account
+
+      Current.without_account { ImportMailer.failed(self).deliver_later }
+    end
+
+    def expected_error?(error)
+      error.is_a?(Error) || error.is_a?(Account::DataTransfer::RecordSet::IntegrityError) || error.is_a?(ZipFile::Reader::InvalidFileError)
+    end
+
+    def failure_reason_for(error)
+      if expected_error?(error)
+        error.message
+      elsif error.is_a?(ActiveRecord::RecordNotUnique)
+        "The file contains duplicated records, so it can't be imported. Please make sure it's an unmodified Fizzy account export."
+      else
+        "Something went wrong while importing the file. Please make sure it's a complete Fizzy account export, and try again."
+      end
+    end
+
+    def remove_account
+      if account
+        doomed_account = account
+
+        Current.with_account(doomed_account) do
+          file.purge if file.attached?
+          update_columns(account_id: nil)
+          Storage::Entry.suppressing_recording { doomed_account.destroy! }
+        end
+      end
+    rescue => error
+      Rails.error.report(error, severity: :error)
+    end
+end
diff --git a/app/models/card/export.rb b/app/models/card/export.rb
new file mode 100644
index 0000000..7616c63
--- /dev/null
+++ b/app/models/card/export.rb
@@ -0,0 +1,122 @@
+class Card::Export
+  attr_reader :card
+
+  def initialize(card)
+    @card = card
+    @paths = Set.new
+  end
+
+  def write_to(zip)
+    files = attachments_with_paths
+
+    zip.add_file json_path, JSON.pretty_generate(as_json(files))
+
+    files.each do |blob, path|
+      write_blob(zip, blob, path)
+    end
+  end
+
+  private
+    def json_path
+      "cards/#{card.number}.json"
+    end
+
+    def as_json(files)
+      {
+        number: card.number,
+        title: card.title,
+        board: card.board.name,
+        column: card.column&.name,
+        status: status,
+        golden: card.golden?,
+        due_on: card.due_on,
+        creator: person(card.creator),
+        assignees: card.assignees.map { person(it) },
+        tags: card.tags.map(&:title),
+        steps: card.steps.map { { content: it.content, completed: it.completed } },
+        description: card.description.to_plain_text,
+        description_html: card.description.body&.to_html.to_s,
+        image: files_for([ card.image_attachment ], files).first,
+        attachments: files_for(card.attachments, files),
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        closed_at: card.closed_at,
+        comments: comments.map { comment_json(it, files) }
+      }
+    end
+
+    def status
+      if card.closed?
+        "closed"
+      elsif card.postponed?
+        "not_now"
+      else
+        "open"
+      end
+    end
+
+    def comment_json(comment, files)
+      {
+        author: person(comment.creator),
+        body: comment.body.to_plain_text,
+        body_html: comment.body.body&.to_html.to_s,
+        attachments: files_for(comment.attachments, files),
+        created_at: comment.created_at,
+        updated_at: comment.updated_at
+      }
+    end
+
+    def person(user)
+      if user
+        { name: user.name, email_address: user.identity&.email_address }
+      end
+    end
+
+    def comments
+      @comments ||= card.comments.chronologically.preloaded.includes(creator: :identity)
+    end
+
+    def files_for(attachments, files)
+      attachments.compact.filter_map do |attachment|
+        if path = files[attachment.blob]
+          { filename: attachment.blob.filename.to_s, content_type: attachment.blob.content_type, byte_size: attachment.blob.byte_size, path: path }
+        end
+      end
+    end
+
+    def attachments_with_paths
+      all_attachments.map(&:blob).uniq.select { |blob| stored?(blob) }.index_with { |blob| unique_path_for(blob) }
+    end
+
+    def all_attachments
+      [ card.image_attachment, *card.attachments, *comments.flat_map(&:attachments) ].compact
+    end
+
+    def unique_path_for(blob)
+      base = blob.filename.sanitized.presence || blob.key
+      extension = File.extname(base)
+      name = File.basename(base, extension)
+
+      candidate = "cards/#{card.number}/#{base}"
+      counter = 1
+      while @paths.include?(candidate)
+        counter += 1
+        candidate = "cards/#{card.number}/#{name} (#{counter})#{extension}"
+      end
+
+      @paths << candidate
+      candidate
+    end
+
+    def stored?(blob)
+      blob.service.exist?(blob.key).tap do |exists|
+        Rails.logger.warn "[Export] Skipping blob #{blob.id}: file #{blob.key} is missing from storage" unless exists
+      end
+    end
+
+    def write_blob(zip, blob, path)
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
