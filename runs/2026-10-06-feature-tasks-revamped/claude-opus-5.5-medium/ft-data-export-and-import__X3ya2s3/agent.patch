@@ -0,0 +1,37 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  before_action :ensure_accepting_new_accounts, only: %i[ new create ]
+  before_action :set_import, only: :show
+
+  rate_limit to: 5, within: 1.hour, only: :create, with: -> { redirect_to new_account_import_path, alert: "Try again later." }
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if zip_file?(params[:file])
+      import = Account::Import.start(identity: Current.identity, file: params[:file])
+      redirect_to account_import_path(import)
+    else
+      redirect_to new_account_import_path, alert: "Please choose a Fizzy account export (a .zip file)."
+    end
+  end
+
+  def show
+  end
+
+  private
+    def ensure_accepting_new_accounts
+      redirect_to session_menu_path, alert: "This Fizzy doesn’t accept new accounts." unless Account.accepting_signups?
+    end
+
+    def set_import
+      @import = Current.identity.account_imports.find(params[:id])
+    end
+
+    def zip_file?(file)
+      file.respond_to?(:original_filename) && File.extname(file.original_filename.to_s).casecmp?(".zip")
+    end
+end
