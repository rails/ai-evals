+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Import an account</h1>
+
+  <p class="margin-none-block-start">Upload a Fizzy account export (the .zip file you downloaded from Account Settings). We’ll create a new account with everything in it: boards, cards, comments, files, and people.</p>
+
+  <%= form_with url: account_imports_path, multipart: true, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <%= form.file_field :file, accept: ".zip,application/zip", required: true, class: "input" %>
+
+    <p class="txt-small margin-none">It can take a while for big accounts. We’ll email you at <strong><%= Current.identity.email_address %></strong> when it’s done.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Start import</span>
