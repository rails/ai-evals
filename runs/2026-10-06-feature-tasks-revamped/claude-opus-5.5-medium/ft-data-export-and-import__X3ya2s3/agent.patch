diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..24eeb0d
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,193 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @source = accounts("37s")
+    @identity = identities(:david)
+
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    card.update!(description: "Look: #{ActionText::Content.new("").append_attachables(blob).to_html} and <action-text-attachment sgid=\"#{users(:jz).attachable_sgid}\"></action-text-attachment>")
+  end
+
+  test "round trip an account export into a new account" do
+    import = import_from(export_file)
+
+    assert import.reload.completed?, import.failure_reason
+    account = import.account
+
+    assert_equal @source.name, account.name
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: account).count
+    assert_equal @source.users.count, account.users.count
+    assert_equal @source.cards_count, account.reload.cards_count
+
+    assert_not_equal @source.cards.pluck(:id).sort, account.cards.pluck(:id).sort
+    assert account.users.find_by(identity: @identity).owner?
+
+    card = account.cards.find_by!(number: cards(:logo).number)
+    assert card.image.attached?
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+    assert_equal account, card.board.account
+    assert_equal account.users.find_by(identity: cards(:logo).creator.identity), card.creator
+
+    embed = card.description.embeds.sole
+    assert_equal file_fixture("avatar.png").binread, embed.download
+    assert_includes card.description.body.attachables, embed.blob
+    assert_includes card.description.body.attachables, account.users.find_by!(identity: identities(:jz))
+
+    assert_match account.slug, card.description.body.to_html
+    assert_no_match @source.slug, card.description.body.to_html
+
+    assert_equal Event.where(account: @source).count, Event.where(account: account).count
+    assert_equal Mention.where(account: @source).count, Mention.where(account: account).count
+    assert Webhook.where(account: account).none?(&:active?)
+    assert_equal 1, account.users.where(role: :system).count
+
+    assert_operator account.bytes_used_exact, :>, 0
+
+    assert_not import.reload.file.attached?
+  end
+
+  test "imports into an instance the original account is gone from" do
+    file = export_file
+    titles = @source.cards.pluck(:title).sort
+    @source.incinerate
+
+    import = import_from(file)
+    assert import.reload.completed?, import.failure_reason
+    assert_equal titles, import.account.cards.pluck(:title).sort
+  end
+
+  test "importing twice in the same instance creates two accounts" do
+    file = export_file
+
+    assert_difference -> { Account.count }, 2 do
+      2.times { assert import_from(file).reload.completed? }
+    end
+  end
+
+  test "an import that fails leaves nothing behind" do
+    broken = rewrite(export_file) do |name, content|
+      name.start_with?("data/comments/") ? "{ not json" : content
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { Card.count }, -> { ActiveStorage::Blob.count }, -> { User.count }, -> { Identity.count } ] do
+      import = import_from(broken)
+      assert import.reload.failed?
+      assert_match "isn't valid JSON", import.failure_reason
+      assert_nil import.account
+    end
+  end
+
+  test "rejects files that aren't zip files" do
+    file = Tempfile.new([ "nope", ".zip" ])
+    file.write("hello")
+    file.rewind
+
+    assert_no_difference -> { Account.count } do
+      import = import_from(file)
+      assert import.reload.failed?
+      assert_match "valid ZIP", import.failure_reason
+    end
+  end
+
+  test "the importer is emailed when the import is done or failed" do
+    file = export_file
+
+    Current.without_account do
+      Account::Import.start(identity: @identity, file: Rack::Test::UploadedFile.new(file.path, "application/zip"))
+      2.times { perform_enqueued_jobs only: [ ImportAccountDataJob, ActionMailer::MailDeliveryJob ] }
+    end
+
+    assert_equal "Your Fizzy import is done", ActionMailer::Base.deliveries.last.subject
+    assert_equal [ @identity.email_address ], ActionMailer::Base.deliveries.last.to
+
+    bad = Tempfile.new([ "bad", ".zip" ]).tap { it.write("nope"); it.rewind }
+    Current.without_account do
+      Account::Import.start(identity: @identity, file: Rack::Test::UploadedFile.new(bad.path, "application/zip"))
+      2.times { perform_enqueued_jobs only: [ ImportAccountDataJob, ActionMailer::MailDeliveryJob ] }
+    end
+
+    assert_equal "Your Fizzy import didn’t work", ActionMailer::Base.deliveries.last.subject
+    assert_match "valid ZIP", ActionMailer::Base.deliveries.last.text_part.body.to_s
+  end
+
+  test "imported cards can be found by search" do
+    import = import_from(export_file)
+    account = import.account
+    card = account.cards.find_by!(number: cards(:logo).number)
+
+    assert Search::Record.for(account.id).where(searchable_type: "Card", searchable_id: card.id).exists?
+  end
+
+  test "imported records can't point to records in other accounts" do
+    foreign_board = boards(:miltons_wish_list)
+    tampered_one = false
+    tampered = rewrite(export_file) do |name, content|
+      if name.start_with?("data/accesses/") && !tampered_one
+        tampered_one = true
+        JSON.parse(content).merge("board_id" => foreign_board.id).to_json
+      else
+        content
+      end
+    end
+
+    import = import_from(tampered)
+    assert import.reload.completed?, import.failure_reason
+    assert_empty Access.where(account: import.account, board: foreign_board)
+    assert_equal [ accounts(:initech) ], foreign_board.reload.accesses.map(&:account).uniq
+  end
+
+  test "rejects records from other accounts" do
+    tampered = rewrite(export_file) do |name, content|
+      if name.start_with?("data/cards/")
+        JSON.parse(content).merge("account_id" => accounts(:initech).id).to_json
+      else
+        content
+      end
+    end
+
+    import = import_from(tampered)
+    assert import.reload.failed?
+    assert_match "belongs to a different account", import.failure_reason
+  end
+
+  private
+    def rewrite(file)
+      entries = File.open(file.path, "rb") do |io|
+        ZipKit::FileReader.read_zip_structure(io: io).map { |entry| [ entry.filename, entry.extractor_from(io).extract.to_s ] }
+      end
+
+      Tempfile.new([ "rewritten", ".zip" ]).tap do |rewritten|
+        rewritten.binmode
+        ZipKit::Streamer.open(rewritten) do |zip|
+          entries.each do |name, content|
+            zip.write_deflated_file(name) { |sink| sink << yield(name, content) }
+          end
+        end
+        rewritten.rewind
+      end
+    end
+
+    def export_file
+      export = Account::Export.create!(account: @source, user: users(:kevin))
+      export.build
+
+      Tempfile.new([ "export", ".zip" ]).tap do |file|
+        file.binmode
+        file.write(export.file.download)
+        file.rewind
+      end
+    end
+
+    def import_from(file)
+      Current.without_account do
+        import = Account::Import.start(identity: @identity, file: Rack::Test::UploadedFile.new(file.path, "application/zip"))
+        import.process
+        import
+      end
+    end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..7c5ce4e
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "build an account export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    assert_enqueued_emails 1 do
+      export.build
+    end
+
+    assert export.completed?
+    assert export.downloadable?
+    assert_equal "application/zip", export.file.content_type
+
+    entries = zip_entries(export)
+    assert_includes entries.keys, "data/accounts/#{accounts("37s").id}.json"
+    assert_includes entries.keys, "data/cards/#{cards(:logo).id}.json"
+    assert_equal cards(:logo).title, JSON.parse(entries["data/cards/#{cards(:logo).id}.json"])["title"]
+  end
+
+  test "build a user data export with the cards they can see" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    export = User::DataExport.create!(account: accounts("37s"), user: users(:david))
+    export.build
+
+    entries = zip_entries(export)
+    json = JSON.parse(entries.fetch("cards/#{card.number}.json"))
+
+    assert_equal card.title, json["title"]
+    assert_equal card.comments.count, json["comments"].size
+    assert_equal "cards/#{card.number}/moon.jpg", json["image"]["path"]
+    assert_equal file_fixture("moon.jpg").binread, entries["cards/#{card.number}/moon.jpg"]
+
+    inaccessible = Card.where(account: accounts("37s")).where.not(id: users(:david).accessible_cards.select(:id))
+    inaccessible.each do |other|
+      assert_not entries.key?("cards/#{other.number}.json")
+    end
+  end
+
+  test "exports expire after a day" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.downloadable?
+
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+  test "only the person who requested the export can access it" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    assert export.accessible_to?(users(:kevin))
+    assert_not export.accessible_to?(users(:jason))
+  end
+
+  private
+    def zip_entries(export)
+      File.open(ActiveStorage::Blob.service.path_for(export.file.key), "rb") do |io|
+        ZipKit::FileReader.read_zip_structure(io: io).to_h do |entry|
+          [ entry.filename, entry.extractor_from(io).extract.to_s ]
+        end
+      end
+    end
+end
