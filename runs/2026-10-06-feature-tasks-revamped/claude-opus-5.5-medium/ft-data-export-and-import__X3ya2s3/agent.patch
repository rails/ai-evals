diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..84cd94f
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,62 @@
+# Just enough of an IO to let ZipKit read a ZIP file straight from an
+# Active Storage service using ranged reads. That way huge archives never
+# have to be downloaded in full, and both the Disk and S3 services work.
+class ZipFile::BlobIO
+  BUFFER_SIZE = 4.megabytes
+
+  attr_reader :size
+
+  def initialize(blob)
+    @blob = blob
+    @size = blob.byte_size
+    @pos = 0
+    @buffer = nil
+    @buffer_start = 0
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    @pos = case mode
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then @pos + offset
+    when IO::SEEK_END then @size + offset
+    else raise ArgumentError, "Unsupported seek mode #{mode}"
+    end.clamp(0, @size)
+
+    0
+  end
+
+  def tell
+    @pos
+  end
+  alias_method :pos, :tell
+
+  def read(n_bytes = nil)
+    return (n_bytes.to_i.zero? ? "".b : nil) if @pos >= @size
+
+    n_bytes = (n_bytes || @size - @pos).clamp(0, @size - @pos)
+    return "".b if n_bytes.zero?
+
+    data = n_bytes > BUFFER_SIZE ? download(@pos, n_bytes) : buffered_read(n_bytes)
+    @pos += data.bytesize
+    data
+  end
+
+  private
+    def buffered_read(n_bytes)
+      unless buffered?(@pos, n_bytes)
+        @buffer_start = @pos
+        @buffer = download(@pos, [ BUFFER_SIZE, @size - @pos ].min)
+      end
+
+      offset = @pos - @buffer_start
+      @buffer.byteslice(offset, n_bytes)
+    end
+
+    def buffered?(position, n_bytes)
+      @buffer && position >= @buffer_start && position + n_bytes <= @buffer_start + @buffer.bytesize
+    end
+
+    def download(position, n_bytes)
+      @blob.service.download_chunk(@blob.key, position...(position + n_bytes)).b
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..616a705
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,59 @@
+class ZipFile::Reader
+  class InvalidFileError < StandardError; end
+
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @entries = read_entries.index_by(&:filename)
+  end
+
+  def entries
+    @entries.keys
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def size_of(path)
+    entry_for(path).uncompressed_size
+  end
+
+  def read(path)
+    if block_given?
+      each_chunk(path) { |chunk| yield chunk }
+    else
+      String.new(encoding: Encoding::BINARY).tap do |content|
+        each_chunk(path) { |chunk| content << chunk }
+      end
+    end
+  end
+
+  private
+    def read_entries
+      ZipKit::FileReader.read_zip_structure(io: @io)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature, ZipKit::FileReader::MissingEOCD, ArgumentError, EOFError => e
+      raise InvalidFileError, "This doesn't look like a valid ZIP file (#{e.message})"
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise InvalidFileError, "#{path} is missing from the ZIP file" }
+    end
+
+    def each_chunk(path)
+      extractor = entry_for(path).extractor_from(@io)
+
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        break if chunk.nil?
+        yield chunk unless chunk.empty?
+      end
+    rescue Zlib::Error => e
+      raise InvalidFileError, "#{path} is corrupted (#{e.message})"
+    end
+end
