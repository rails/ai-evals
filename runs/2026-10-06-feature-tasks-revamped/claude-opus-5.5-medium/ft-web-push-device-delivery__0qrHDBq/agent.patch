+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  test "turning on push notifications in a browser that blocks them shows how to allow them" do
+    with_web_push_enabled do
+      sign_in_as users(:kevin)
+      visit notifications_settings_url(script_name: accounts("37s").slug)
+
+      within "[data-controller=notifications]" do
+        assert_text "Push notifications are off for this device."
+        assert_no_selector ".notifications-help__explainer", visible: true
+
+        click_on "Turn on"
+
+        assert_selector ".notifications-help__explainer", visible: true
+        assert_text "Turn on notifications for this website."
+        assert_button "Turn on", disabled: true
+      end
+    end
+  end
+
+  test "the service worker handles pushes" do
+    sign_in_as users(:kevin)
+    visit "/service-worker.js"
+
+    source = page.text
+    assert_includes source, 'addEventListener("push"'
+    assert_includes source, 'addEventListener("notificationclick"'
+    assert page.evaluate_script("(() => { try { new Function(arguments[0]); return true } catch (e) { return e.message } })(arguments[0])", source) == true
+  end
+end
