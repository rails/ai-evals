+module PushTestHelper
+  VAPID_PUBLIC_KEY = "BMwFyXbN2ItwtRcsbTzGYcoSUB3cieNB3AiL5-3bZzO9ltqJ2L_Ba_Ob8QjVBdG4lUrJQq-5LmFlmZM3e8M5VUg="
+  VAPID_PRIVATE_KEY = "6bnQmNcvdGk7gaaxGaeobo1gGFEwu-pu7p0SSG_hUAY="
+
+  def with_web_push_enabled
+    config = Rails.configuration.x.web_push
+    was_public_key, was_private_key = config.vapid_public_key, config.vapid_private_key
+    config.vapid_public_key, config.vapid_private_key = VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
+    yield
+  ensure
+    config.vapid_public_key, config.vapid_private_key = was_public_key, was_private_key
+  end
+end
