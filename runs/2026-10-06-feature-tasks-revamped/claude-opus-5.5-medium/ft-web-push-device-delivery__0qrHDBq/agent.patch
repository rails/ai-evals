diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..1b436d2 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,40 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications
+self.addEventListener("push", (event) => {
+  const { title = "Fizzy", body, url, tag, icon } = pushPayload(event)
+
+  event.waitUntil(self.registration.showNotification(title, { body, tag, icon, renotify: Boolean(tag), data: { url } }))
+})
+
+function pushPayload(event) {
+  try {
+    return event.data?.json() ?? {}
+  } catch {
+    return { body: event.data.text() }
+  }
+}
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotificationUrl(event.notification.data?.url))
+})
+
+async function openNotificationUrl(url) {
+  const target = new URL(url || "/", self.location.origin)
+
+  if (target.origin === self.location.origin) {
+    const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+    const client = windows.find((client) => new URL(client.url).origin === target.origin && "focus" in client)
+
+    if (client) {
+      await client.focus()
+      return client.navigate(target.href).catch(() => self.clients.openWindow(target.href))
+    } else {
+      return self.clients.openWindow(target.href)
+    }
+  }
+}
+
 TurboOffline.start()
diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..5d8ec7c
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,10 @@
+# Web push is on when ops provide a VAPID key pair. Generate one with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}", "VAPID_PRIVATE_KEY=#{key.private_key}"'
+#
+# Keep the pair stable: browser subscriptions are bound to the public key, so
+# rotating it means everyone has to turn push notifications on again.
+Rails.application.configure do
+  config.x.web_push.vapid_public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.web_push.vapid_private_key = ENV["VAPID_PRIVATE_KEY"].presence
+end
