diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..ca568ed
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,39 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.create_or_find_by(endpoint: push_subscription_params[:endpoint]) do |subscription|
+      subscription.assign_attributes(push_subscription_attributes)
+    end
+
+    if @push_subscription.update(push_subscription_attributes)
+      render json: { id: @push_subscription.id }, status: :created
+    else
+      render json: @push_subscription.errors, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.destroy_by(id: params[:id])
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def push_subscription_attributes
+      push_subscription_params.merge(user_agent: request.user_agent)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1c07abf
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,123 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const SERVICE_WORKER_URL = "/service-worker.js"
+
+export default class extends Controller {
+  static targets = [ "button", "explainer", "details" ]
+  static classes = [ "enabled" ]
+  static values = { publicKey: String, subscriptionsUrl: String, subscriptions: Object }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async subscribe() {
+    await this.#whileBusy(async () => {
+      if (await Notification.requestPermission() === "granted") {
+        await this.#register(await this.#subscribeBrowser())
+      }
+    })
+  }
+
+  async unsubscribe() {
+    await this.#whileBusy(async () => {
+      // Leave the browser's subscription alone: other accounts on this device may share it.
+      const subscription = await this.#browserSubscription()
+      const id = this.subscriptionsValue[subscription?.endpoint]
+
+      if (id) {
+        const response = await destroy(`${this.subscriptionsUrlValue}/${id}`)
+        if (response.ok) this.#remember(subscription.endpoint, null)
+      }
+    })
+  }
+
+  async #whileBusy(callback) {
+    this.buttonTargets.forEach(button => button.disabled = true)
+
+    try {
+      await callback()
+    } catch (error) {
+      console.error("Couldn't change push notifications", error)
+    } finally {
+      await this.#refresh()
+    }
+  }
+
+  async #refresh() {
+    const permission = this.#permission
+    const subscription = permission === "granted" ? await this.#browserSubscription().catch(() => null) : null
+    const blocked = permission === "denied"
+    const unsupported = permission === "unsupported"
+
+    this.element.classList.toggle(this.enabledClass, Boolean(subscription && this.subscriptionsValue[subscription.endpoint]))
+    this.buttonTargets.forEach(button => button.disabled = blocked || unsupported)
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+    this.explainerTarget.hidden = !blocked && !unsupported
+  }
+
+  get #permission() {
+    const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+    return supported ? Notification.permission : "unsupported"
+  }
+
+  async #browserSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribeBrowser() {
+    const registration = await this.#serviceWorkerRegistration()
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing && this.#subscribedWithCurrentKey(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe() // Made with a key we no longer have, so it can't receive our pushes
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #serviceWorkerRegistration() {
+    // Same worker and scope Turbo offline registers, so this resolves to the existing registration.
+    await navigator.serviceWorker.register(SERVICE_WORKER_URL, { scope: "/" })
+    return navigator.serviceWorker.ready
+  }
+
+  #subscribedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+    return !key || new Uint8Array(key).toString() === this.#applicationServerKey.toString()
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { id } = await response.json
+      this.#remember(endpoint, id)
+    }
+  }
+
+  #remember(endpoint, id) {
+    const subscriptions = { ...this.subscriptionsValue }
+
+    if (id) {
+      subscriptions[endpoint] = id
+    } else {
+      delete subscriptions[endpoint]
+    }
+
+    this.subscriptionsValue = subscriptions
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
