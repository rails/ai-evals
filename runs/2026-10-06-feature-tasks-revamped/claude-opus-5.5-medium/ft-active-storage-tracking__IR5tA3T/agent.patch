+  test "files embedded in card descriptions, comments, and board descriptions are counted" do
+    @card.update! description: embed_html(blob_for("moon.jpg"))
+    @card.comments.create! body: embed_html(blob_for("avatar.png"))
+    @board.update! public_description: embed_html(blob_for("moon.jpg"))
+    perform_enqueued_jobs
+
+    assert_bytes 2 * moon_size + avatar_size, @board
+    assert_bytes 2 * moon_size + avatar_size, @account
+  end
+
+  test "values are up to date before materializing, and materializing folds pending entries" do
+    @card.image.attach blob_for("moon.jpg")
+    assert_equal moon_size, @board.bytes_used
+    assert Storage::Entry.where(owner: @board).exists?
+
+    perform_enqueued_jobs
+    assert_not Storage::Entry.where(owner: @board).exists?
+    assert_equal moon_size, Storage::Total.find_by(owner: @board).bytes_stored
+  end
+
+  test "removing attachments frees storage" do
+    @card.image.attach blob_for("moon.jpg")
+    comment = @card.comments.create! body: embed_html(blob_for("avatar.png"))
+    @card.update! description: embed_html(blob_for("moon.jpg"))
+    perform_enqueued_jobs
+    assert_bytes 2 * moon_size + avatar_size, @board
+
+    @card.image.purge_later
+    @card.update! description: "No more images"
+    perform_enqueued_jobs
+    assert_bytes avatar_size, @board
+
+    comment.destroy!
+    perform_enqueued_jobs
+    assert_bytes 0, @board
+    assert_bytes 0, @account
+  end
+
+  test "purging and replacing a card image" do
+    @card.image.attach blob_for("moon.jpg")
+    @card.image.attach blob_for("avatar.png")
+    assert_bytes avatar_size, @board
+
+    @card.image.purge
+    assert_bytes 0, @board
+  end
+
+  test "destroying cards frees storage" do
+    @card.image.attach blob_for("moon.jpg")
+    @card.comments.create! body: embed_html(blob_for("avatar.png"))
+    perform_enqueued_jobs
+
+    @card.destroy!
+    perform_enqueued_jobs only: Storage::MaterializeJob
+    assert_bytes 0, @board
+    assert_bytes 0, @account
+  end
+
+  test "moving a card moves its storage to the new board" do
+    other_board = boards(:private)
+    @card.image.attach blob_for("moon.jpg")
+    @card.update! description: embed_html(blob_for("moon.jpg"))
+    @card.comments.create! body: embed_html(blob_for("avatar.png"))
+    perform_enqueued_jobs
+
+    @card.move_to other_board
+    perform_enqueued_jobs
+
+    assert_bytes 0, @board
+    assert_bytes 2 * moon_size + avatar_size, other_board
+    assert_bytes 2 * moon_size + avatar_size, @account
+  end
+
+  test "destroying a board frees its storage from the account" do
+    @card.image.attach blob_for("moon.jpg")
+    @board.update! public_description: embed_html(blob_for("avatar.png"))
+    perform_enqueued_jobs
+
+    @board.destroy!
+    perform_enqueued_jobs
+
+    assert_bytes 0, @account
+    assert_not Storage::Entry.where(owner_type: "Board", owner_id: @board.id).exists?
+    assert_not Storage::Total.where(owner_type: "Board", owner_id: @board.id).exists?
+  end
+
+  test "destroying an account deletes its storage records" do
+    @card.image.attach blob_for("moon.jpg")
+    perform_enqueued_jobs only: Storage::MaterializeJob
+
+    @account.destroy!
+
+    assert_not Storage::Entry.where(account_id: @account.id).exists?
+    assert_not Storage::Total.where(account_id: @account.id).exists?
+  end
+
+  test "untracked attachments are ignored" do
+    users(:david).avatar.attach blob_for("avatar.png")
+    perform_enqueued_jobs
+
+    assert_bytes 0, @account
+  end
+
+  test "reconciling recalculates from scratch" do
+    @card.image.attach blob_for("moon.jpg")
+    @card.comments.create! body: embed_html(blob_for("avatar.png"))
+    perform_enqueued_jobs
+
+    Storage::Total.find_by(owner: @board).update!(bytes_stored: 1)
+    Storage::Entry.record_change @account, 1234
+
+    perform_enqueued_jobs { [ @board, @account ].each(&:reconcile_storage_later) }
+
+    assert_bytes moon_size + avatar_size, @board
+    assert_bytes moon_size + avatar_size, @account
+  end
+
+  test "materializing in batches" do
+    Storage::Entry.record_change @board, 10
+    stub_const Storage::Total, :MATERIALIZATION_BATCH_SIZE, 2 do
+      4.times { Storage::Entry.record_change @board, 10 }
+      @board.materialize_storage
+    end
+
+    assert_equal 50, Storage::Total.find_by(owner: @board).bytes_stored
+    assert_not Storage::Entry.where(owner: @board).exists?
+  end
+
+  test "materializing all pending" do
+    Storage::Entry.record_change @board, 10
+    clear_enqueued_jobs
+
+    assert_enqueued_with job: Storage::MaterializeJob, args: [ @board ] do
+      Storage::Total.materialize_all_pending_later
+    end
+  end
+
+  test "jobs are coalesced while changes are pending" do
+    assert_enqueued_jobs 2, only: Storage::MaterializeJob do
+      3.times { @card.comments.create! body: embed_html(blob_for("avatar.png")) }
+    end
+  end
+
+  private
+    def assert_bytes(expected, owner)
+      assert_equal expected, owner.reload.bytes_used
+      assert_equal expected, owner.calculate_bytes_used, "Expected recalculation to match"
+    end
+
+    def blob_for(name)
+      ActiveStorage::Blob.create_and_upload! io: file_fixture(name).open, filename: name
+    end
+
+    def embed_html(blob)
+      "<p>Look:</p>#{ActionText::Attachment.from_attachable(blob).to_html}"
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+
+    def avatar_size
+      file_fixture("avatar.png").size
+    end
+
+    def stub_const(klass, name, value)
+      original = klass.const_get(name)
+      klass.send(:remove_const, name)
+      klass.const_set(name, value)
+      yield
+    ensure
+      klass.send(:remove_const, name)
+      klass.const_set(name, original)
+    end
+end
