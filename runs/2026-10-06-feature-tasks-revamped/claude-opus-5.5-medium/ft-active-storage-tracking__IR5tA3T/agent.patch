diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..50fc0dc
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,31 @@
+# Tracks the bytes stored by accounts and boards.
+#
+# Only card images and files embedded in board descriptions, card descriptions, and comments
+# count towards storage. Changes are appended to a ledger (Storage::Entry) as they happen, and
+# folded into per-owner totals (Storage::Total) in the background. Appending rows rather than
+# updating a shared counter keeps busy accounts and boards free from row contention.
+module Storage
+  def self.table_name_prefix
+    "storage_"
+  end
+
+  class << self
+    # Calculates from scratch the bytes attached to the given cards (their images, descriptions,
+    # and comments) and to the descriptions of the given boards. Accepts arrays of ids or subqueries.
+    def bytes_attached_to(card_ids: [], board_ids: [])
+      attachments_for(card_ids:, board_ids:).joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+
+    private
+      def attachments_for(card_ids:, board_ids:)
+        ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: card_ids)
+          .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts_for(card_ids:, board_ids:).select(:id)))
+      end
+
+      def rich_texts_for(card_ids:, board_ids:)
+        ActionText::RichText.where(record_type: "Card", record_id: card_ids)
+          .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: card_ids).select(:id)))
+          .or(ActionText::RichText.where(record_type: "Board", record_id: board_ids))
+      end
+  end
+end
diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..2441315
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,41 @@
+# Records storage changes as attachments are created and removed.
+#
+# Included into ActiveStorage::Attachment in config/initializers/active_storage.rb
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create  -> { record_storage_change +byte_size }
+    after_destroy -> { record_storage_change -byte_size }
+  end
+
+  # Called when purging, which skips the destroy callbacks.
+  def delete
+    record_storage_change -byte_size if persisted?
+    super
+  end
+
+  private
+    def record_storage_change(delta)
+      if board = storage_board
+        Storage::Entry.record_board_change board, delta
+      end
+    end
+
+    def storage_board
+      storage_tracked_record&.storage_board
+    end
+
+    def storage_tracked_record
+      tracked_record = case [ record_type, name ]
+      when [ "Card", "image" ]                    then record
+      when [ "ActionText::RichText", "embeds" ] then record&.record
+      end
+
+      tracked_record if tracked_record.is_a?(Storage::Tracked)
+    end
+
+    def byte_size
+      blob&.byte_size.to_i
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..86aaa41
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,27 @@
+# An append-only ledger of changes in the bytes stored by an account or board.
+#
+# Entries are folded into the owner's Storage::Total in the background and deleted.
+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  class << self
+    # Records a change in the bytes stored by a board and its account.
+    def record_board_change(board, delta)
+      record_change board, delta
+      record_change board.account, delta
+    end
+
+    def record_change(owner, delta)
+      unless delta.zero?
+        materialization_pending = where(owner: owner).exists?
+
+        create! account: owner.account, owner: owner, delta: delta
+
+        # Coalesce changes: if there were pending entries, a materialization is already on its way.
+        # Any straggler is picked up by Storage::Total.materialize_all_pending_later.
+        owner.materialize_storage_later unless materialization_pending
+      end
+    end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..87dac3e
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,61 @@
+# The materialized bytes stored by an account or board, as of the last time pending
+# Storage::Entry records were folded into it.
+class Storage::Total < ApplicationRecord
+  MATERIALIZATION_BATCH_SIZE = 1_000
+
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  class << self
+    # Returns the materialized total plus any pending changes. Calculated in a single statement so
+    # that a concurrent materialization can't make an entry count twice or not at all.
+    def bytes_used_by(owner)
+      materialized = where(owner: owner).select(:bytes_stored)
+      pending = Storage::Entry.where(owner: owner).select("SUM(delta)")
+
+      connection.select_value("SELECT COALESCE((#{materialized.to_sql}), 0) + COALESCE((#{pending.to_sql}), 0)").to_i
+    end
+
+    def for(owner)
+      create_or_find_by!(owner: owner) { it.account = owner.account }
+    end
+
+    def materialize_all_pending_later
+      Storage::Entry.distinct.pluck(:owner_type, :owner_id).each do |owner_type, owner_id|
+        owner_type.constantize.find_by(id: owner_id)&.materialize_storage_later
+      end
+    end
+  end
+
+  def materialize
+    loop do
+      break if materialize_batch < MATERIALIZATION_BATCH_SIZE
+    end
+  end
+
+  def reconcile
+    transaction do
+      lock!
+      pending_entries.delete_all
+      update! bytes_stored: owner.calculate_bytes_used
+    end
+  end
+
+  private
+    def materialize_batch
+      transaction do
+        lock!
+
+        pending_entries.order(:id).limit(MATERIALIZATION_BATCH_SIZE).pluck(:id, :delta).tap do |entries|
+          if entries.any?
+            update! bytes_stored: bytes_stored + entries.sum(&:last)
+            Storage::Entry.where(id: entries.map(&:first)).delete_all
+          end
+        end.size
+      end
+    end
+
+    def pending_entries
+      Storage::Entry.where(owner_type: owner_type, owner_id: owner_id)
+    end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..818045e
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,46 @@
+# Included in models whose storage usage is tracked: Account and Board.
+#
+# Including models must respond to #cards and implement #storage_board_ids, which returns the
+# ids of the boards whose descriptions count towards their usage.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy :delete_storage_records
+  end
+
+  # Returns the bytes used by card images and files embedded in board descriptions, card
+  # descriptions, and comments. Kept up to date in the background as attachments change.
+  def bytes_used
+    Storage::Total.bytes_used_by(self)
+  end
+
+  def materialize_storage_later
+    Storage::MaterializeJob.perform_later(self)
+  end
+
+  def materialize_storage
+    Storage::Total.for(self).materialize
+  end
+
+  def reconcile_storage_later
+    Storage::ReconcileJob.perform_later(self)
+  end
+
+  def reconcile_storage
+    Storage::Total.for(self).reconcile
+  end
+
+  # Recalculates usage from scratch, in batches of cards so that large accounts and boards
+  # don't result in unbounded queries.
+  def calculate_bytes_used
+    Storage.bytes_attached_to(board_ids: storage_board_ids) +
+      cards.in_batches.sum { |batch| Storage.bytes_attached_to(card_ids: batch.select(:id)) }
+  end
+
+  private
+    def delete_storage_records
+      Storage::Entry.where(owner: self).delete_all
+      Storage::Total.where(owner: self).delete_all
+    end
+end
