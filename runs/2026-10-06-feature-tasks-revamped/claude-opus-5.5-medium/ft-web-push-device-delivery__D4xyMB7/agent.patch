new file mode 100644
index 0000000..f2cf602
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,30 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.register(**push_subscription_params, user_agent: request.user_agent)
+
+    render :show, status: @push_subscription.previously_new_record? ? :created : :ok
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1ebdd63
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,110 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "install", "enableButton" ]
+  static classes = [ "on" ]
+  static values = { publicKey: String, url: String, subscriptions: Array }
+
+  async connect() {
+    await this.#render()
+  }
+
+  async enable() {
+    if (!this.#supported) return
+
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      const subscription = await this.#subscribe()
+      await this.#register(subscription)
+    }
+
+    await this.#render()
+  }
+
+  async disable() {
+    const registered = this.#registered(await this.#browserSubscription())
+
+    if (registered) {
+      const response = await destroy(registered.url, { responseKind: "json" })
+      if (response.ok) this.subscriptionsValue = this.subscriptionsValue.filter(({ url }) => url !== registered.url)
+    }
+
+    await this.#render()
+  }
+
+  async #render() {
+    const permission = this.#supported ? Notification.permission : "unsupported"
+
+    this.detailsTargets.forEach(target => target.hidden = permission !== "denied")
+    this.installTargets.forEach(target => target.hidden = permission !== "denied" && permission !== "unsupported")
+    this.enableButtonTargets.forEach(target => target.disabled = permission === "denied" || permission === "unsupported")
+
+    const subscription = await this.#browserSubscription()
+    this.element.classList.toggle(this.onClass, permission === "granted" && Boolean(this.#registered(subscription)))
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing && this.#signedWithCurrentKey(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { url } = await response.json
+      this.subscriptionsValue = [ ...this.subscriptionsValue.filter(it => it.endpoint !== endpoint), { endpoint, url } ]
+    }
+  }
+
+  async #browserSubscription() {
+    if (this.#supported) {
+      const registration = await navigator.serviceWorker.getRegistration()
+      const subscription = await registration?.pushManager.getSubscription()
+
+      if (subscription && this.#signedWithCurrentKey(subscription)) return subscription
+    }
+
+    return null
+  }
+
+  #registered(subscription) {
+    return subscription && this.subscriptionsValue.find(({ endpoint }) => endpoint === subscription.endpoint)
+  }
+
+  #signedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+
+    if (key) {
+      const current = this.#applicationServerKey
+      const existing = new Uint8Array(key)
+      return existing.length === current.length && existing.every((byte, index) => byte === current[index])
+    } else {
+      return true
+    }
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+}
