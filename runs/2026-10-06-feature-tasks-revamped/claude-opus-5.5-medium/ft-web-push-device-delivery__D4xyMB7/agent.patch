new file mode 100644
index 0000000..a4edcc4
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+    @keys = PushTestHelper.browser_keys
+  end
+
+  test "create registers this device for push notifications" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://fcm.googleapis.com/fcm/send/david-token", subscription.endpoint
+    assert_equal @keys[:p256dh_key], subscription.p256dh_key
+    assert_equal @keys[:auth_key], subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+    assert_equal user_push_subscription_url(@user, subscription), @response.parsed_body["url"]
+  end
+
+  test "create with form params" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: subscription_params
+    end
+
+    assert_response :created
+  end
+
+  test "create is idempotent for the same device" do
+    post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :ok
+  end
+
+  test "create rejects endpoints that aren't push services" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params(endpoint: "https://169.254.169.254/latest"), as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires all subscription fields" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://fcm.googleapis.com/fcm/send/x" } }, as: :json
+    assert_response :unprocessable_entity
+
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+    assert_response :bad_request
+  end
+
+  test "create is forbidden for other users" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy turns push notifications off for a device" do
+    subscription = @user.push_subscriptions.register(endpoint: "https://fcm.googleapis.com/fcm/send/david-token", **@keys)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is forbidden for other users' devices" do
+    subscription = push_subscriptions(:kevin_chrome)
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy can't reach another user's device through your own user" do
+    delete user_push_subscription_path(@user, push_subscriptions(:kevin_chrome)), as: :json
+
+    assert_response :not_found
+    assert PushSubscription.exists?(push_subscriptions(:kevin_chrome).id)
+  end
+
+  private
+    def subscription_params(endpoint: "https://fcm.googleapis.com/fcm/send/david-token")
+      { push_subscription: { endpoint: endpoint, **@keys } }
+    end
+end
