diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..65b8fbc
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other = accounts(:initech)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    assert @account.cards.any? && @account.users.any? && @account.boards.any?
+    @account.cancel(initiated_by: users(:david))
+
+    travel 31.days do
+      perform_enqueued_jobs do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(@other.id)
+
+    tables_with_account_id.each do |table|
+      count = ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{table} WHERE account_id = #{ActiveRecord::Base.connection.quote(@account.id)}")
+      assert_equal 0, count.to_i, "Expected no rows in #{table} for incinerated account"
+    end
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: users(:david))
+
+    travel 29.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    travel 365.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@other.id)
+  end
+
+  test "keeps reactivated accounts" do
+    @account.cancel(initiated_by: users(:david))
+    @account.reactivate
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  private
+    def tables_with_account_id
+      connection = ActiveRecord::Base.connection
+      connection.tables.select { |table| connection.column_exists?(table, :account_id) }
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..825a1e6
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.cancel(initiated_by: users(:david))
+  end
+
+  test "due_for_incineration includes only accounts cancelled more than the grace period ago" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+
+    travel Account::INCINERATION_GRACE_PERIOD + 1.minute do
+      assert_includes Account.due_for_incineration, @account
+      assert @account.reload.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, accounts(:initech)
+    end
+  end
+
+  test "incinerate destroys the account and its data" do
+    assert @account.cards.any?
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_equal 0, Card.where(account_id: @account.id).count
+    assert_equal 0, User.where(account_id: @account.id).count
+    assert_equal 0, Board.where(account_id: @account.id).count
+  end
+
+  test "incinerate_all_due continues when one account fails" do
+    other = accounts(:initech)
+    other.cancel(initiated_by: other.users.where.not(role: :system).first)
+
+    travel Account::INCINERATION_GRACE_PERIOD + 1.minute do
+      Account.any_instance.stubs(:incinerate).raises(StandardError).then.returns(true)
+      assert_nothing_raised { Account.incinerate_all_due }
+    end
+  end
+end
