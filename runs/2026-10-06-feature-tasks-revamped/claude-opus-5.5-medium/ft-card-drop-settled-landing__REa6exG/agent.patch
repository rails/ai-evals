index 0000000..7268473
--- /dev/null
+++ b/test/controllers/columns/cards/drops/closures_controller_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ClosuresControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, targets: ".card-columns ##{dom_id(card, :article)}"
+  end
+
+  test "create from Not Now" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post columns_card_drops_closure_path(card), as: :turbo_stream
+    end
+
+    assert_not card.postponed?
+  end
+
+  test "create for an inaccessible card" do
+    card = with_current_user(:david) { boards(:private).cards.create!(title: "Secret", status: :published) }
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    post columns_card_drops_closure_path(card), as: :turbo_stream
+
+    assert_response :not_found
+    assert_not card.reload.closed?
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+
+    post columns_card_drops_closure_path(card), as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+end
diff --git a/test/controllers/columns/cards/drops/columns_controller_test.rb b/test/controllers/columns/cards/drops/columns_controller_test.rb
new file mode 100644
index 0000000..708dde8
--- /dev/null
+++ b/test/controllers/columns/cards/drops/columns_controller_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Columns::Cards::Drops::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, to: column do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, targets: ".card-columns ##{dom_id(card, :article)}"
+  end
+
+  test "create from Done reopens the card" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.closed? }, from: true, to: false do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_equal column, card.column
+  end
+
+  test "create from Not Now resumes the card" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.postponed? }, from: true, to: false do
+      post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+    end
+
+    assert_equal column, card.column
+  end
+
+  test "create makes the card the latest in its column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+
+    assert_equal card, column.cards.active.latest.first
+  end
+
+  test "create with a column from another board" do
+    card = cards(:logo)
+    column = boards(:private).columns.create!(name: "Elsewhere")
+
+    post columns_card_drops_column_path(card, column_id: column), as: :turbo_stream
+
+    assert_response :not_found
+    assert_not_equal column, card.reload.column
+  end
+
+  test "create as JSON" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post columns_card_drops_column_path(card, column_id: column), as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+end
