+module CardDropping
+  extend ActiveSupport::Concern
+
+  included do
+    include CardScoped
+  end
+
+  def create
+    drop_card
+
+    respond_to do |format|
+      format.turbo_stream { render "columns/cards/drops/create" }
+      format.json { head :no_content }
+    end
+  end
+end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c131a3b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,168 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between containers (columns, Maybe?, Not Now, Done). Containers keep their own
+// order, so a dropped card goes where the server will list it: the top, after golden cards when
+// the container lists those first. The board updates on drop; the save happens in the background.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #saves = Promise.resolve()
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  // Actions
+
+  async dragStart(event) {
+    const item = this.#itemContaining(event.target)
+    const container = this.#containerContaining(item)
+    if (!item || !container) return
+
+    this.draggedItem = item
+    this.sourceContainer = container
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.querySelector("a[href]")?.href || "")
+
+    // Dim the card on the board, but not in the drag image the browser snapshots now
+    await nextFrame()
+    this.draggedItem?.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerContaining(event.target)
+
+    if (this.#canDropInto(container)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerContaining(event.target)
+
+    if (this.draggedItem && this.#canDropInto(container)) {
+      event.preventDefault()
+      this.#move(this.draggedItem, this.sourceContainer, container)
+    }
+
+    this.dragEnd()
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  // Morphing would strip the draggable attribute, since the server doesn't render it
+  preserveDraggable(event) {
+    const { attributeName, mutationType } = event.detail
+
+    if (attributeName === "draggable" && mutationType === "remove" && this.itemTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  // Private
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return element && this.containerTargets.find(container => container.contains(element))
+  }
+
+  // A container accepts cards from elsewhere once its own have loaded
+  #canDropInto(container) {
+    return container && container !== this.sourceContainer && this.#listIn(container)
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(each => each.classList.toggle(this.hoverContainerClass, each === container))
+  }
+
+  #move(item, source, target) {
+    this.#place(item, target)
+    this.#paint(item, target)
+    this.#changeCount(source, -1)
+    this.#changeCount(target, +1)
+
+    this.#save(item, target)
+  }
+
+  #place(item, container) {
+    const siblings = this.itemTargets.filter(each => each !== item && container.contains(each))
+    const lastGolden = siblings.findLast(each => this.#isGolden(each))
+
+    if (this.#listsGoldenFirst(container) && !this.#isGolden(item) && lastGolden) {
+      lastGolden.after(item)
+    } else if (siblings.length > 0) {
+      siblings[0].before(item)
+    } else {
+      this.#listIn(container).prepend(item)
+    }
+  }
+
+  #isGolden(item) {
+    return item.hasAttribute("data-drag-and-drop-golden")
+  }
+
+  #listsGoldenFirst(container) {
+    return container.hasAttribute("data-drag-and-drop-golden-first")
+  }
+
+  #listIn(container) {
+    return container.querySelector(".cards__list")
+  }
+
+  #paint(item, container) {
+    const color = container.dataset.dragAndDropCardColor
+    if (color) item.style.setProperty("--card-color", color)
+  }
+
+  #changeCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = parseInt(counter?.textContent)
+
+    // Unknown or already "99+": leave it to the server
+    if (counter && !isNaN(count) && !counter.textContent.includes("+")) {
+      const newCount = Math.max(count + delta, 0)
+      counter.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  // Saves run one after the other so the server ends up where the last drop left the board
+  #save(item, container) {
+    const url = container.dataset.dragAndDropUrl.replace("__card__", item.dataset.dragAndDropId)
+
+    this.#saves = this.#saves
+      .then(() => post(url, { responseKind: "turbo-stream" }))
+      .then(response => { if (!response.ok) throw new Error(`Drop failed with status ${response.statusCode}`) })
+      .catch(error => this.#restoreFromServer(error))
+  }
+
+  #restoreFromServer(error) {
+    console.error(error)
+    Turbo.visit(window.location.href, { action: "replace" })
+  }
+}
