index 0000000..bb64e4b
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,123 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    visit board_url(boards(:writebook))
+    assert_selector "[data-drag-and-drop-target=container] .cards__list", count: 7, visible: :all
+    assert_selector "#maybe [draggable=true]##{dom_id(cards(:buy_domain), :article)}"
+  end
+
+  test "the board shows a drop as soon as it happens, and nothing moves once it's saved" do
+    card, column = cards(:text), columns(:writebook_triage)
+
+    board_on_drop = drag card, to: dom_id(column)
+    assert_equal [ cards(:logo), card, cards(:layout) ].map { dom_id(it, :article) }, board_on_drop[dom_id(column)], "after golden cards, ahead of the rest"
+    assert_equal "0", board_on_drop["counts"][dom_id(columns(:writebook_in_progress))]
+    assert_equal "3", board_on_drop["counts"][dom_id(column)]
+    assert_equal column.color.to_s, board_on_drop["colors"][dom_id(card, :article)]
+
+    assert_card_saved -> { card.reload.column == column }
+    assert_equal board_on_drop, board_snapshot
+  end
+
+  test "drop into Done, Not Now and Maybe?" do
+    card = cards(:logo)
+
+    { "closed-cards" => -> { card.reload.closed? }, "not-now" => -> { card.reload.postponed? }, "maybe" => -> { card.reload.awaiting_triage? } }.each do |container, saved|
+      board_on_drop = drag card, to: container
+      assert_equal dom_id(card, :article), board_on_drop[container].first
+
+      assert_card_saved saved
+      assert_equal board_on_drop, board_snapshot
+      assert_selector "##{container} [draggable=true]##{dom_id(card, :article)}", visible: :all
+    end
+  end
+
+  test "dropping a card where it already is does nothing" do
+    card = cards(:buy_domain)
+
+    assert_no_changes -> { card.reload.updated_at } do
+      board_on_drop = drag card, to: "maybe"
+      assert_includes board_on_drop["maybe"], dom_id(card, :article)
+      sleep 0.5
+    end
+  end
+
+  test "a drop that can't be saved puts the board back the way it is" do
+    card, column = cards(:layout), columns(:writebook_review)
+    column.destroy
+
+    drag card, to: dom_id(column)
+
+    assert_no_selector "##{dom_id(column)}", wait: 5
+    assert_selector "##{dom_id(columns(:writebook_triage))} ##{dom_id(card, :article)}", visible: :all
+  end
+
+  test "while dragging, the card dims and the column under the pointer lights up, but not its own" do
+    card = cards(:logo)
+
+    page.execute_script(<<~JS, dom_id(card, :article))
+      window.dataTransfer = new DataTransfer()
+      window.fire = (target, type) => target.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+      fire(document.getElementById(arguments[0]), "dragstart")
+    JS
+    assert_selector ".drag-and-drop__dragged-item##{dom_id(card, :article)}", visible: :all
+
+    accepted = !page.evaluate_script("fire(document.getElementById('closed-cards'), 'dragover')")
+    assert accepted, "Done accepts the card"
+    assert_selector "#closed-cards.drag-and-drop__hover-container"
+
+    accepted = !page.evaluate_script("fire(document.getElementById('#{dom_id(columns(:writebook_triage))}'), 'dragover')")
+    assert_not accepted, "its own column refuses the card"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    page.execute_script("fire(document.getElementById('#{dom_id(card, :article)}'), 'dragend')")
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+  end
+
+  private
+    # Fires the drag events like a browser would, then snapshots the board in the same tick, before any response
+    def drag(card, to:)
+      page.evaluate_script(<<~JS, dom_id(card, :article), to)
+        ((cardId, containerId) => {
+          const card = document.getElementById(cardId)
+          const container = document.getElementById(containerId)
+          const dataTransfer = new DataTransfer()
+          const fire = (target, type) => target.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+
+          fire(card, "dragstart")
+          fire(container, "dragover")
+          fire(container, "drop")
+          fire(card, "dragend")
+
+          return (#{BOARD_SNAPSHOT_JS})()
+        })(arguments[0], arguments[1])
+      JS
+    end
+
+    def board_snapshot
+      page.evaluate_script("(#{BOARD_SNAPSHOT_JS})()")
+    end
+
+    def assert_card_saved(saved)
+      Timeout.timeout(5) { sleep 0.1 until saved.call }
+      sleep 0.5 # Let the response render
+    end
+
+    BOARD_SNAPSHOT_JS = <<~JS
+      () => {
+        const containers = [ ...document.querySelectorAll("[data-drag-and-drop-target~=container]") ]
+        const snapshot = { counts: {}, colors: {} }
+        containers.forEach(container => {
+          const items = [ ...container.querySelectorAll("[data-drag-and-drop-target~=item]") ]
+          snapshot[container.id] = items.map(item => item.id)
+          snapshot.counts[container.id] = container.querySelector(".cards__expander-count").textContent
+          items.forEach(item => snapshot.colors[item.id] = item.style.getPropertyValue("--card-color").trim())
+        })
+        return snapshot
+      }
+    JS
+end
