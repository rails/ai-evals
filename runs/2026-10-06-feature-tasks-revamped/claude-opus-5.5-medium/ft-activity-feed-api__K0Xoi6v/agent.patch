@@ -0,0 +1,73 @@
+# Activities
+
+Activities are the events that make up an account's timeline: cards being added, assigned, moved,
+renamed, closed, and commented on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity across all boards you can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the users who performed the activity |
+| `board_ids[]` | Filter by board ID(s). Boards you can't access are ignored |
+
+The following `action` values may be returned:
+
+`card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`,
+`card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`,
+`card_triaged`, `card_sent_back_to_triage`, `comment_created`
+
+`eventable_type` is either `Card` or `Comment`, and `eventable` uses the same representation as the
+[card](cards.md) and [comment](comments.md) endpoints. For card activity, `url` opens the card. For
+comment activity, `url` opens the card and jumps to the comment.
+
+`description` is a plain-text summary of the activity.
+
+`particulars` contains details specific to the action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are
+returned as empty strings.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David assigned Kevin to \"Layout is broken\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjysoy0fqs9yg0ei3hq"]
+    },
+    "url": "http://fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 4,
+      "title": "Layout is broken",
+      "...": "..."
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "...": "..."
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "...": "..."
+    }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6e63ada
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns timeline events newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    times = body.map { |event| Time.parse(event["created_at"]) }
+    assert_equal times.sort.reverse, times
+
+    body.each do |event|
+      assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, event.keys.sort
+    end
+  end
+
+  test "index as JSON includes event details" do
+    get activities_path, as: :json
+    body = @response.parsed_body
+
+    assignment = body.find { |event| event["id"] == events(:logo_assignment_jz).id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, assignment["particulars"])
+    assert_equal events(:logo_assignment_jz).description_for(users(:kevin)).to_plain_text, assignment["description"]
+    assert_equal "Card", assignment["eventable_type"]
+    assert_equal cards(:logo).id, assignment.dig("eventable", "id")
+    assert_equal card_url(cards(:logo)), assignment["url"]
+    assert_equal boards(:writebook).id, assignment.dig("board", "id")
+    assert_equal users(:david).id, assignment.dig("creator", "id")
+
+    published = body.find { |event| event["id"] == events(:logo_published).id }
+    assert_equal({}, published["particulars"])
+
+    comment = body.find { |event| event["id"] == events(:layout_commented).id }
+    assert_equal "Comment", comment["eventable_type"]
+    comment_record = events(:layout_commented).eventable
+    assert_equal card_url(comment_record.card, anchor: "comment_#{comment_record.id}"), comment["url"]
+  end
+
+  test "index as JSON includes title changes and omits collection changes" do
+    collection_changed = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_collection_changed")
+    with_current_user(:david) { cards(:logo).update!(title: "Renamed logo") }
+
+    get activities_path, as: :json
+    body = @response.parsed_body
+
+    assert_not body.any? { |event| event["id"] == collection_changed.id }
+    renamed = body.find { |event| event["action"] == "card_title_changed" }
+    assert_equal "Renamed logo", renamed.dig("particulars", "new_title")
+    assert renamed["particulars"].key?("old_title")
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    triaged = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_triaged")
+    moved = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_board_changed")
+
+    get activities_path, as: :json
+    body = @response.parsed_body
+
+    assert_equal({ "column" => "" }, body.find { |event| event["id"] == triaged.id }["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, body.find { |event| event["id"] == moved.id }["particulars"])
+  end
+
+  test "index as JSON filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert @response.parsed_body.all? { |event| event.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index as JSON only includes accessible activity" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published") }
+    event = private_card.events.last
+    assert event
+
+    logout_and_sign_in_as :jz
+    get activities_path, as: :json
+    assert_not @response.parsed_body.any? { |e| e["id"] == event.id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_not @response.parsed_body.any? { |e| e["id"] == event.id }
+  end
+
+  test "index as JSON is paginated" do
+    with_current_user(:kevin) do
+      60.times { |i| cards(:logo).update!(title: "Title #{i}") }
+    end
+
+    ids = []
+    next_page = activities_path(format: :json)
+    pages = 0
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      pages += 1
+      ids.concat @response.parsed_body.map { |event| event["id"] }
+      url = @response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = url && URI.parse(url).request_uri
+    end
+
+    assert_operator pages, :>, 1
+    assert_equal ids.uniq, ids
+    assert_operator ids.size, :>=, 60
+  end
+end
