+module SearchesHelper
+  # Escapes +text+ and wraps every occurrence of the given terms in <mark>.
+  def highlight_search_terms(text, terms)
+    return "" if text.blank?
+    return h(text) if terms.blank?
+
+    pattern = Regexp.union(terms.sort_by { -it.length }.map { Regexp.new(Regexp.escape(it), Regexp::IGNORECASE) })
+
+    safe_join text.split(/(#{pattern})/).map.with_index { |part, index| index.odd? ? tag.mark(part) : part }
+  end
+
+  # Returns a highlighted window of +text+ centered on the first matching term.
+  def search_excerpt(text, terms, radius: 100)
+    text = text.to_s.squish
+    pattern = Regexp.union(terms.map { Regexp.new(Regexp.escape(it), Regexp::IGNORECASE) })
+
+    if (position = text =~ pattern) && text.length > radius * 2
+      start = [ position - radius, 0 ].max
+      finish = [ position + radius, text.length ].min
+      text = "#{"…" if start > 0}#{text[start...finish].strip}#{"…" if finish < text.length}"
+    end
+
+    highlight_search_terms text, terms
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..4b2dcd4
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,73 @@
+class Search
+  LIMIT = 50
+  BATCH_SIZE = 100
+  MAX_TERMS = 10
+
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user, @query = user, query.to_s.squish
+  end
+
+  def terms
+    @terms ||= query.split.uniq(&:downcase).first(MAX_TERMS)
+  end
+
+  def results
+    @results ||= terms.any? ? matching_results : []
+  end
+
+  private
+    # SQL narrows down candidates by matching the stored rich text HTML. Each candidate
+    # is then verified against plain text so that markup (tag names, attachment
+    # attributes, entities) never produces a false match.
+    def matching_results
+      results = []
+      offset = 0
+
+      loop do
+        batch = candidates.offset(offset).limit(BATCH_SIZE).to_a
+
+        batch.each do |card|
+          result = Result.new(card, terms)
+          results << result if result.match?
+          return results if results.size >= LIMIT
+        end
+
+        break if batch.size < BATCH_SIZE
+        offset += BATCH_SIZE
+      end
+
+      results
+    end
+
+    def candidates
+      terms
+        .inject(user.accessible_cards.published) { |scope, term| scope.where(id: matching(term)) }
+        .reverse_chronologically
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+    end
+
+    def matching(term)
+      Card.where(like("cards.title", term))
+        .or(Card.where(id: descriptions_matching(term).select(:record_id)))
+        .or(Card.where(id: Comment.where(id: comment_bodies_matching(term).select(:record_id)).select(:card_id)))
+    end
+
+    def descriptions_matching(term)
+      rich_texts_matching(term).where(record_type: "Card", name: "description")
+    end
+
+    def comment_bodies_matching(term)
+      rich_texts_matching(term).where(record_type: "Comment", name: "body")
+    end
+
+    def rich_texts_matching(term)
+      ActionText::RichText.where(like("action_text_rich_texts.body", term))
+        .or(ActionText::RichText.where(like("action_text_rich_texts.body", ERB::Util.html_escape(term))))
+    end
+
+    def like(column, term)
+      ActiveRecord::Base.sanitize_sql_array [ "#{column} LIKE ? ESCAPE '\\'", "%#{ActiveRecord::Base.sanitize_sql_like(term)}%" ]
+    end
+end
diff --git a/app/models/search/result.rb b/app/models/search/result.rb
new file mode 100644
index 0000000..0ff96b2
--- /dev/null
+++ b/app/models/search/result.rb
@@ -0,0 +1,46 @@
+class Search::Result
+  attr_reader :card, :terms
+
+  def initialize(card, terms)
+    @card, @terms = card, terms
+  end
+
+  def match?
+    terms.all? { |term| searchable_texts.any? { |text| text.downcase.include?(term.downcase) } }
+  end
+
+  def title
+    card.title.to_s
+  end
+
+  # The most relevant piece of text other than the title: the description if it
+  # matches, otherwise the newest matching comment.
+  def excerpt
+    @excerpt ||= matching_texts.first
+  end
+
+  def excerpt_from_comment?
+    excerpt.present? && excerpt != description
+  end
+
+  private
+    def searchable_texts
+      @searchable_texts ||= [ title, description, *comment_bodies ]
+    end
+
+    def matching_texts
+      [ description, *comment_bodies.reverse ].select { |text| matches_any_term?(text) }
+    end
+
+    def matches_any_term?(text)
+      terms.any? { |term| text.downcase.include?(term.downcase) }
+    end
+
+    def description
+      @description ||= card.description.to_plain_text
+    end
+
+    def comment_bodies
+      @comment_bodies ||= card.comments.sort_by { |comment| [ comment.created_at, comment.id ] }.map { |comment| comment.body.to_plain_text }
+    end
+end
