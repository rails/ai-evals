diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5c1ba2f
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,39 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="search panel panel--wide flex center borderless unpad flex-column gap-half margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", autofocus: true, class: "input", aria: { label: "Search" } %>
+    <%= form.button "Search", name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <% if @search.results.any? %>
+      <ol class="search__results flex flex-column gap-half unpad">
+        <% @search.results.each do |result| %>
+          <li class="search__result" id="<%= dom_id result.card, :search_result %>">
+            <%= link_to card_path(result.card), class: "search__result-link" do %>
+              <strong class="search__result-title">#<%= result.card.number %> <%= highlight_search_terms result.title, @search.terms %></strong>
+            <% end %>
+            <span class="search__result-board txt-subtle"><%= result.card.board.name %></span>
+            <% if result.excerpt.present? %>
+              <p class="search__result-excerpt">
+                <% if result.excerpt_from_comment? %><span class="txt-subtle">Comment:</span><% end %>
+                <%= search_excerpt result.excerpt, @search.terms %>
+              </p>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <p class="search__empty txt-subtle">No cards match “<%= @search.query %>”.</p>
+    <% end %>
+  <% end %>
+</div>
