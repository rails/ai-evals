diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5e64eb6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "blank query renders the form without results" do
+    get search_path
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select ".search__result", count: 0
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:logo).id} mark", text: "logo"
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update!(description: "<p>The zanzibar widget overflows</p>")
+
+    get search_path(q: "Zanzibar")
+    assert_select "#search_result_card_#{cards(:layout).id}"
+    assert_select "#search_result_card_#{cards(:layout).id} mark", text: "zanzibar"
+  end
+
+  test "finds cards by comment body" do
+    cards(:layout).comments.create!(body: "Reminds me of quokkas", creator: users(:david))
+
+    get search_path(q: "quokkas")
+    assert_select "#search_result_card_#{cards(:layout).id} mark", text: "quokkas"
+  end
+
+  test "orders results newest first" do
+    cards(:logo).update!(description: "flamingo")
+    cards(:layout).update!(description: "flamingo")
+    cards(:layout).update_column(:created_at, 1.day.ago)
+    cards(:logo).update_column(:created_at, 1.month.ago)
+
+    get search_path(q: "flamingo")
+    ids = css_select(".search__result").map { it["id"] }
+    assert_equal [ "search_result_card_#{cards(:layout).id}", "search_result_card_#{cards(:logo).id}" ], ids
+  end
+
+  test "excludes boards without access" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret pelican plan", status: "published") }
+
+    get search_path(q: "pelican")
+    assert_select "#search_result_card_#{private_card.id}"
+
+    logout_and_sign_in_as :david
+    get search_path(q: "pelican")
+    assert_select ".search__result", count: 0
+  end
+
+  test "excludes drafts and their comments" do
+    draft = boards(:writebook).cards.create!(title: "Draft walrus", description: "walrus", creator: users(:kevin), status: "drafted")
+
+    get search_path(q: "walrus")
+    assert_select "#search_result_card_#{draft.id}", count: 0
+  end
+
+  test "ignores markup in rich text" do
+    cards(:layout).update!(description: "<div>plain</div>")
+
+    get search_path(q: "div")
+    assert_select "#search_result_card_#{cards(:layout).id}", count: 0
+  end
+
+  test "escapes html in matches" do
+    with_current_user(:kevin) { cards(:layout).update!(title: "Fix <script> & tags") }
+
+    get search_path(q: "<script>")
+    assert_select "#search_result_card_#{cards(:layout).id} mark", text: "<script>"
+    assert_no_match "<mark><script>", response.body
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..2c06db0
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "blank query has no results" do
+    assert_empty Search.new(users(:kevin), "   ").results
+  end
+
+  test "results disappear once access is revoked" do
+    card = boards(:private).cards.create!(title: "Ocelot roadmap", status: "published")
+    assert_includes Search.new(users(:kevin), "ocelot").results.map(&:card), card
+
+    boards(:private).accesses.find_by!(user: users(:kevin)).destroy!
+    assert_empty Search.new(users(:kevin).reload, "ocelot").results
+  end
+
+  test "comments on drafts never match" do
+    draft = boards(:writebook).cards.create!(title: "Untitled draft", status: "drafted")
+    Comment.insert!({ id: ActiveRecord::Type::Uuid.generate, account_id: draft.account_id, card_id: draft.id, creator_id: users(:kevin).id, created_at: Time.current, updated_at: Time.current })
+    comment = Comment.last
+    ActionText::RichText.create!(record: comment, name: "body", body: "armadillo", account_id: draft.account_id)
+
+    assert_empty Search.new(users(:kevin), "armadillo").results
+  end
+
+  test "all terms must match somewhere on the card" do
+    cards(:layout).update!(description: "heron")
+    cards(:layout).comments.create!(body: "egret")
+
+    assert_equal [ cards(:layout) ], Search.new(users(:kevin), "heron egret").results.map(&:card)
+    assert_empty Search.new(users(:kevin), "heron toucan").results
+  end
+
+  test "like wildcards are treated literally" do
+    assert_empty Search.new(users(:kevin), "%").results
+    assert_empty Search.new(users(:kevin), "_").results
+  end
+end
