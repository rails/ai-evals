index 0000000..4ce4930
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "a tracker is created with each webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+  end
+
+  test "failures are counted and successes reset the count" do
+    freeze_time
+
+    @tracker.record_delivery_of(webhook_deliveries(:unsuccessfully_completed))
+    @tracker.record_delivery_of(webhook_deliveries(:errored))
+    assert_equal 2, @tracker.reload.consecutive_failures_count
+    assert_equal Time.current, @tracker.first_failure_at
+
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "deactivates the webhook after ten consecutive failures over an hour" do
+    failure = webhook_deliveries(:errored)
+
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(failure)
+    end
+    8.times { @tracker.record_delivery_of(failure) }
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(failure)
+    assert_not @webhook.reload.active?
+  end
+
+  test "does not deactivate after ten failures within the hour" do
+    failure = webhook_deliveries(:errored)
+
+    20.times { @tracker.record_delivery_of(failure) }
+    assert @webhook.reload.active?
+
+    travel 61.minutes
+    @tracker.record_delivery_of(failure)
+    assert_not @webhook.reload.active?
+  end
+
+  test "does not deactivate after an hour of fewer than ten failures" do
+    failure = webhook_deliveries(:errored)
+
+    travel_to 3.hours.ago do
+      @tracker.record_delivery_of(failure)
+    end
+    8.times { @tracker.record_delivery_of(failure) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "a success in between starts over" do
+    travel_to 2.hours.ago do
+      9.times { @tracker.record_delivery_of(webhook_deliveries(:errored)) }
+    end
+    @tracker.record_delivery_of(webhook_deliveries(:successfully_completed))
+    @tracker.record_delivery_of(webhook_deliveries(:errored))
+
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a webhook resets the tracker" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
