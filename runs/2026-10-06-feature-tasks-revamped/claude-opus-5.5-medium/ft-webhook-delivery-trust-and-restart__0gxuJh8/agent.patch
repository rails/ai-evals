--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,8 @@
 class Webhook::Delivery < ApplicationRecord
+  STALE_THRESHOLD = 7.days
+  ENDPOINT_TIMEOUT = 7.seconds
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +13,33 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...STALE_THRESHOLD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      stale.in_batches(of: 1_000).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if claim
+      if webhook.active?
+        send_request
+        webhook.delinquency_tracker.record_delivery_of(self)
+      else
+        update! state: :errored, response: { error: :webhook_inactive }
+      end
+    end
+  rescue
+    update! state: :errored, response: { error: :internal_error } if in_progress?
+    raise
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +58,62 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    # Atomically move from pending to in progress so that an event is never
+    # sent twice, even if the delivery job runs more than once.
+    def claim
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def send_request
+      payload = Webhook::Payload.new(self)
+      self.request = { headers: payload.headers }
+
+      self.response = post(payload)
+      self.state = response[:error].present? ? :errored : :completed
+
+      save!
+    end
+
+    def post(payload)
+      if ip = SsrfProtection.resolve_public_ip(uri.host)
+        http_response = http_client(ip).request(http_request(payload))
+        { code: http_response.code.to_i }
+      else
+        { error: :private_uri }
+      end
+    rescue Resolv::ResolvError, SocketError
+      { error: :dns_lookup_failed }
+    rescue Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Timeout::Error
+      { error: :connection_timeout }
+    rescue OpenSSL::SSL::SSLError
+      { error: :failed_tls }
+    rescue SystemCallError, IOError, EOFError, Net::HTTPBadResponse, Net::ProtocolError
+      { error: :destination_unreachable }
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def http_client(ip)
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def http_request(payload)
+      Net::HTTP::Post.new(uri, payload.headers).tap do |request|
+        request.body = payload.body
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..9558d17
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,58 @@
+class Webhook::Payload
+  attr_reader :delivery, :timestamp
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery, timestamp: Time.current)
+    @delivery = delivery
+    @timestamp = timestamp
+  end
+
+  def headers
+    {
+      "User-Agent" => Webhook::Delivery::USER_AGENT,
+      "Content-Type" => content_type,
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp.utc.iso8601(3)
+    }
+  end
+
+  def body
+    @body ||= \
+      if webhook.for_campfire?
+        render_event :html
+      elsif webhook.for_basecamp?
+        { content: render_event(:html) }.to_json
+      elsif webhook.for_slack?
+        { text: render_event(:text) }.to_json
+      else
+        render_event :json
+      end
+  end
+
+  private
+    def content_type
+      webhook.for_campfire? ? "text/html" : "application/json"
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def render_event(format)
+      renderer.render template: "webhooks/event", formats: [ format ], assigns: { event: event }
+    end
+
+    def renderer
+      ApplicationController.renderer.new \
+        http_host: [ url_options[:host], url_options[:port] ].compact.join(":"),
+        https: url_options[:protocol].to_s.start_with?("https"),
+        script_name: event.account.slug
+    end
+
+    def url_options
+      @url_options ||= Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence ||
+        { host: "localhost" }
+    end
+end
