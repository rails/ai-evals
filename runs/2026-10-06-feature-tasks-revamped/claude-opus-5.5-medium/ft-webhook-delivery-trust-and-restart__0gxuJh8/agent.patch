+    assert_requested stub, times: 1
+  end
+
+  test "deliver does not send deliveries already in progress or done" do
+    stub_request(:post, "https://api.example.com/webhooks")
+
+    webhook_deliveries(:in_progress).deliver
+    webhook_deliveries(:successfully_completed).deliver
+
+    assert_not_requested :post, "https://api.example.com/webhooks"
+  end
+
+  test "deliver records unsuccessful responses as failures" do
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, "https://api.example.com/webhooks").to_return(status: 500)
+    delivery = new_delivery
+
+    assert_difference -> { delivery.webhook.delinquency_tracker.reload.consecutive_failures_count }, +1 do
+      delivery.deliver
+    end
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+  end
+
+  test "deliver records connection errors" do
+    stub_dns_resolution("93.184.216.34")
+    delivery = new_delivery
+
+    stub_request(:post, "https://api.example.com/webhooks").to_timeout
+    delivery.deliver
+    assert delivery.reload.errored?
+    assert_equal "connection_timeout", delivery.response[:error]
+
+    delivery = new_delivery(events(:logo_published))
+    stub_request(:post, "https://api.example.com/webhooks").to_raise(Errno::ECONNREFUSED)
+    delivery.deliver
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "deliver refuses private addresses" do
+    stub_dns_resolution("10.0.0.1")
+    delivery = new_delivery
+
+    delivery.deliver
+
+    assert_not_requested :post, "https://api.example.com/webhooks"
+    assert delivery.reload.errored?
+    assert_equal "private_uri", delivery.response[:error]
+  end
+
+  test "deliver skips webhooks that have been deactivated" do
+    delivery = new_delivery
+    delivery.webhook.deactivate
+
+    delivery.deliver
+
+    assert_not_requested :post, "https://api.example.com/webhooks"
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+  end
+
+  test "deliver formats messages for chat services" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+
+    webhook.update_column :url, "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    stub_request(:post, webhook.url)
+    new_delivery(events(:logo_published)).deliver
+    assert_requested(:post, webhook.url) { |request| JSON.parse(request.body)["text"].include?("/cards/") }
+
+    webhook.update_column :url, "https://campfire.example.com/rooms/1/2-bot/messages"
+    stub_request(:post, webhook.url)
+    new_delivery(events(:layout_commented)).deliver
+    assert_requested(:post, webhook.url) { |request| request.headers["Content-Type"] == "text/html" && request.body.include?("commented on") }
+
+    webhook.update_column :url, "https://3.basecamp.com/1/integrations/token/buckets/2/chats/3/lines"
+    stub_request(:post, webhook.url)
+    new_delivery(events(:logo_assignment_jz)).deliver
+    assert_requested(:post, webhook.url) { |request| JSON.parse(request.body)["content"].present? }
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    recent = webhook_deliveries(:pending)
+    stale = webhook_deliveries(:in_progress)
+    stale.update_column :created_at, 8.days.ago
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+
+  private
+    def new_delivery(event = events(:layout_commented))
+      webhook = webhooks(:active)
+      webhook.deliveries.where(event: event).delete_all
+      webhook.deliveries.create!(event: event)
+    end
 end
