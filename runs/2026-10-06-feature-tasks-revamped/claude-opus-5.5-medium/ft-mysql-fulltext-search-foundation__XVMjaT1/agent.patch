diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..2b6f5c5
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "blank query shows the form without results" do
+    get search_path
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds cards by title and highlights matches" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "##{dom_id(cards(:logo), :search_result)} mark", text: /logo/i
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update!(description: "Sidebar overlaps the zeppelin widget")
+
+    get search_path(q: "zeppelin")
+    assert_select "##{dom_id(cards(:layout), :search_result)}"
+    assert_select "mark", text: "zeppelin"
+  end
+
+  test "finds cards by comment body" do
+    cards(:text).comments.create!(body: "Let's talk about kerning", creator: users(:kevin))
+
+    get search_path(q: "kerning")
+    assert_select "##{dom_id(cards(:text), :search_result)}"
+    assert_select "mark", text: "kerning"
+  end
+
+  test "lists newest cards first" do
+    cards(:logo).update!(description: "quokka")
+    cards(:layout).update!(description: "quokka", created_at: 1.day.ago)
+
+    get search_path(q: "quokka")
+    ids = css_select(".search-result").map { |node| node["id"] }
+    assert_equal [ dom_id(cards(:layout), :search_result), dom_id(cards(:logo), :search_result) ], ids
+  end
+
+  test "excludes cards from inaccessible boards" do
+    cards(:radio).update_columns(title: "Secret quokka")
+    assert_includes Search.new(users(:mike), "quokka").cards, cards(:radio)
+
+    get search_path(q: "quokka")
+    assert_select ".search-result", count: 0
+  end
+
+  test "excludes draft cards and their comments" do
+    card = users(:kevin).draft_new_card_in(boards(:writebook))
+    card.update!(title: "Draft quokka", description: "quokka")
+
+    get search_path(q: "quokka")
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes HTML and LIKE wildcards in queries" do
+    get search_path(q: "%<script>")
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_no_match "<script>", response.body.scan(/<input[^>]*>/).join
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..5d57fc4
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  test "matches every term across title, description, and comments" do
+    cards(:logo).update!(description: "needs a quokka")
+    Current.set(user: users(:kevin)) { cards(:logo).comments.create!(body: "and a wombat") }
+
+    assert_includes Search.new(users(:kevin), "logo quokka wombat").cards, cards(:logo)
+    assert_not_includes Search.new(users(:kevin), "logo platypus").cards, cards(:logo)
+  end
+
+  test "drops access when it is revoked" do
+    cards(:logo).update!(description: "quokka")
+    assert_includes Search.new(users(:kevin), "quokka").cards, cards(:logo)
+
+    accesses(:writebook_kevin).destroy
+    assert_not_includes Search.new(users(:kevin).reload, "quokka").cards, cards(:logo)
+  end
+
+  test "treats LIKE wildcards literally" do
+    assert_empty Search.new(users(:kevin), "%").cards
+    assert_empty Search.new(users(:kevin), "_").cards
+  end
+
+  test "blank query finds nothing" do
+    assert_empty Search.new(users(:kevin), "  ").cards
+  end
+end
