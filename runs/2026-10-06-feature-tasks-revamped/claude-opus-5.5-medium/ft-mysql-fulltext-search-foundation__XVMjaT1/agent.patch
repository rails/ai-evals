--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,15 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 100
+
+  def search_highlight(text, search)
+    highlight text.to_s, search.terms
+  end
+
+  def search_excerpt(rich_text, search)
+    text = rich_text.to_plain_text.squish
+
+    if term = search.terms.find { |term| text.downcase.include?(term.downcase) }
+      search_highlight excerpt(text, term, radius: EXCERPT_RADIUS), search
+    end
+  end
+end
