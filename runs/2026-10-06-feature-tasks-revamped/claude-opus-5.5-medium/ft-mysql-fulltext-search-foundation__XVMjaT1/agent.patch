diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..0f9142f
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,18 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    include SearchableText
+
+    # Cards must match every term, each one in the title, the description, or any comment.
+    scope :searching, ->(terms) do
+      Array(terms).inject(all) { |cards, term| cards.matching(term) }
+    end
+
+    scope :matching, ->(term) do
+      where(like_condition_for("cards.title"), like_pattern_for(term))
+        .or(where(id: rich_text_record_ids_matching(:description, term)))
+        .or(where(id: Comment.matching(term).select(:card_id)))
+    end
+  end
+end
