@@ -0,0 +1,13 @@
+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    include SearchableText
+
+    scope :matching, ->(term) { where id: rich_text_record_ids_matching(:body, term) }
+
+    scope :matching_any, ->(terms) do
+      terms.collect { |term| matching(term) }.inject { |comments, matching| comments.or(matching) } || none
+    end
+  end
+end
diff --git a/app/models/concerns/searchable_text.rb b/app/models/concerns/searchable_text.rb
new file mode 100644
index 0000000..1f4134a
--- /dev/null
+++ b/app/models/concerns/searchable_text.rb
@@ -0,0 +1,22 @@
+module SearchableText
+  extend ActiveSupport::Concern
+
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  class_methods do
+    def like_pattern_for(term)
+      "%#{sanitize_sql_like(term, LIKE_ESCAPE_CHARACTER)}%"
+    end
+
+    def like_condition_for(column)
+      "#{column} LIKE ? ESCAPE '#{LIKE_ESCAPE_CHARACTER}'"
+    end
+
+    def rich_text_record_ids_matching(name, term)
+      ActionText::RichText
+        .where(record_type: base_class.name, name: name)
+        .where(like_condition_for("action_text_rich_texts.body"), like_pattern_for(term))
+        .select(:record_id)
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..dbdbb53
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,23 @@
+class Search
+  MAX_TERMS = 10
+
+  attr_reader :user, :query, :terms
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split(" ").uniq(&:downcase).first(MAX_TERMS)
+  end
+
+  def cards
+    if terms.any?
+      user.accessible_cards.published.searching(terms).reverse_chronologically.with_users.preload(:board)
+    else
+      Card.none
+    end
+  end
+
+  def matching_comments_for(card)
+    card.comments.matching_any(terms).with_rich_text_body.chronologically
+  end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..db7f56b
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,22 @@
+<article class="search-result pad" id="<%= dom_id(card, :search_result) %>">
+  <%= link_to card_path(card), class: "search-result__link", data: { turbo_frame: "_top" } do %>
+    <strong class="search-result__title">#<%= card.number %> <%= search_highlight card.title, search %></strong>
+  <% end %>
+
+  <div class="search-result__meta txt-small translucent">
+    <%= card.board.name %> · added by <%= card.creator.name %> · <%= local_datetime_tag card.created_at, style: :shortdate %>
+  </div>
+
+  <% if card.description.present? && (description_excerpt = search_excerpt(card.description, search)) %>
+    <p class="search-result__excerpt"><%= description_excerpt %></p>
+  <% end %>
+
+  <% search.matching_comments_for(card).each do |comment| %>
+    <% if comment_excerpt = search_excerpt(comment.body, search) %>
+      <p class="search-result__excerpt search-result__excerpt--comment">
+        <%= link_to comment.creator.name, comment, class: "txt-small", data: { turbo_frame: "_top" } %>:
+        <%= comment_excerpt %>
+      </p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5f86456
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = @search.query.present? ? "Search results for “#{@search.query}”" : "Search" %>
+<% @hide_footer_frames = true %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex gap" do |form| %>
+    <%= form.search_field :q, value: @search.query, class: "input flex-item-grow", placeholder: "Search cards and comments…", autofocus: true, aria: { label: "Search" } %>
+    <%= form.button "Search", name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @search.terms.any? %>
+    <% if @page.records.any? %>
+      <div class="search-results txt-align-start">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @search.query %>”</p>
+    <% end %>
+  <% end %>
+</section>
