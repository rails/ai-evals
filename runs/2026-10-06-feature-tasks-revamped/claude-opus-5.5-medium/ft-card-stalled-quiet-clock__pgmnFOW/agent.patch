diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..5189b5f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,61 @@
+# A card gets a burst of attention when several people comment on it within a
+# third of the board's auto-close period, or when someone is assigned to it or
+# reopens it. A card whose latest activity came during a burst and that then
+# goes quiet for two weeks is stalled. Any activity re-evaluates the burst, so
+# activity after the burst has passed resets the card.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  BURST_COMMENTS_COUNT = 3
+  BURST_COMMENTERS_COUNT = 2
+  BURST_ACTIONS = %w[ card_assigned card_reopened ]
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    after_update :track_burst, if: :saved_change_to_last_active_at?
+
+    scope :stalled, -> { active.joins(:burst).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    active? && burst.present? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  # Cards stall with the passage of time rather than through a change to the
+  # record, so cached renderings need to account for it.
+  def cache_version
+    stalled? ? "#{super}-stalled" : super
+  end
+
+  private
+    def track_burst
+      if bursting?
+        create_burst! unless burst
+      else
+        burst&.destroy
+        association(:burst).reset
+      end
+    end
+
+    def bursting?
+      since = last_active_at - burst_window
+
+      burst_actions_since?(since) || burst_of_comments_since?(since)
+    end
+
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+
+    def burst_actions_since?(time)
+      events.where(action: BURST_ACTIONS, created_at: time..).exists?
+    end
+
+    def burst_of_comments_since?(time)
+      commenter_ids = comments.by_user.where(created_at: time..).pluck(:creator_id)
+      commenter_ids.size >= BURST_COMMENTS_COUNT && commenter_ids.uniq.size >= BURST_COMMENTERS_COUNT
+    end
+end
