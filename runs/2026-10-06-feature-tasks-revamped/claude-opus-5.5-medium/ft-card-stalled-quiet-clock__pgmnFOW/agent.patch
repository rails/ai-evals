diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..2aede71
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    boards(:writebook).update! auto_postpone_period: 30.days
+    @card = Card.find(boards(:writebook).cards.create!(title: "Quiet card", status: "published", creator: users(:david)).id)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    comment_as :david, :kevin, :david
+
+    assert_not @card.stalled?
+
+    travel 2.weeks + 1.minute
+
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "comments from a single person are not a burst" do
+    comment_as :david, :david, :david
+
+    travel 2.weeks + 1.minute
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comments spread out over more than a third of the auto-close period are not a burst" do
+    comment_as :david
+    travel 6.days
+    comment_as :kevin
+    travel 6.days
+    comment_as :david
+
+    travel 2.weeks + 1.minute
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "fewer than three comments are not a burst" do
+    comment_as :david, :kevin
+
+    travel 2.weeks + 1.minute
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_as :david, :kevin
+    @card.comments.create! body: "Beep", creator: users(:system)
+
+    travel 2.weeks + 1.minute
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "being assigned is a burst" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.minute
+
+    assert @card.reload.stalled?
+  end
+
+  test "being reopened is a burst" do
+    @card.close
+    @card.reload.reopen
+
+    travel 2.weeks + 1.minute
+
+    assert @card.reload.stalled?
+  end
+
+  test "a card needs two weeks without activity to be stalled" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 2.weeks - 1.hour
+    assert_not @card.reload.stalled?
+
+    travel 1.hour + 1.minute
+    assert @card.reload.stalled?
+  end
+
+  test "any activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks + 1.minute
+    assert @card.reload.stalled?
+
+    comment_as :jz
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks + 1.minute
+    assert_not @card.reload.stalled?, "the burst is over, so going quiet again is not a stall"
+  end
+
+  test "reactions are activity too" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks + 1.minute
+
+    @card.reactions.create! content: "👍"
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "activity during a burst keeps it going" do
+    comment_as :david, :kevin
+    travel 1.day
+    comment_as :david
+    travel 1.day
+    comment_as :jz
+
+    travel 2.weeks + 1.minute
+
+    assert @card.reload.stalled?
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment users(:kevin)
+    other = Card.find(boards(:writebook).cards.create!(title: "Other", status: "published", creator: users(:david)).id)
+    other.toggle_assignment users(:kevin)
+
+    travel 2.weeks + 1.minute
+
+    @card.create_closure!(user: users(:david))
+    other.reload.create_not_now!(user: users(:david))
+
+    assert_not @card.reload.stalled?
+    assert_not other.reload.stalled?
+    assert_not_includes Card.stalled, @card
+    assert_not_includes Card.stalled, other
+  end
+
+  test "cache version changes when a card stalls" do
+    @card.toggle_assignment users(:kevin)
+    version = @card.reload.cache_version
+
+    travel 2.weeks + 1.minute
+
+    assert_not_equal version, @card.reload.cache_version
+  end
+
+  private
+    def comment_as(*users)
+      users.each do |user|
+        with_current_user(user) { @card.comments.create! body: "Hey" }
+      end
+    end
+end
