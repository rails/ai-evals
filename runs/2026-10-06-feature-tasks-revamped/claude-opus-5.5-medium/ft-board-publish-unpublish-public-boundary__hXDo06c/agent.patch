diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..e382e01
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "unpublish" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(@board, :publication)
+  end
+
+  test "publish as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication.key), @response.parsed_body["public_url"]
+  end
+
+  test "unpublish as JSON" do
+    @board.publish
+    delete board_publication_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "non admins can't publish" do
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      post board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "non admins can't unpublish" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    assert_no_changes -> { @board.reload.published? } do
+      delete board_publication_path(@board, format: :turbo_stream)
+    end
+
+    assert_response :forbidden
+  end
+end
