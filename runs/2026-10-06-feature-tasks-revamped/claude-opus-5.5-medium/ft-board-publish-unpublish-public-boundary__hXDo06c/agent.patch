diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..94c3b9f
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,28 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key(key)
+      joins(:publication).find_by!(board_publications: { key: key.to_s })
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    publication&.destroy
+    reload_publication
+  end
+end
