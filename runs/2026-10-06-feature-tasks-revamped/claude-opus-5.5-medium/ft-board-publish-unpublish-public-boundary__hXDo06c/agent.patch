+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show a published board without signing in" do
+    get public_board_path(@board.publication.key)
+
+    assert_response :success
+    assert_select "h1", text: /#{@board.name}/
+    assert_select "a[href=?]", public_board_card_path(@board.publication.key, cards(:logo))
+  end
+
+  test "show a published board signed in" do
+    sign_in_as :kevin
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+
+  test "unknown key" do
+    get public_board_path("unknown")
+    assert_response :not_found
+  end
+
+  test "unpublished board" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+end
