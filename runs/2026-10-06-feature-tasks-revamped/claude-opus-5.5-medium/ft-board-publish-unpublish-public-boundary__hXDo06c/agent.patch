+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@board.publication.key), class: "btn" %>
+  </div>
+<% end %>
+
+<article class="public-card-perma panel shadow" id="<%= dom_id(@card, :public) %>">
+  <header>
+    <p class="txt-subtle">
+      #<%= @card.number %>
+      <% if @card.closed? %>
+        · Done
+      <% elsif @card.postponed? %>
+        · Not now
+      <% elsif @card.column %>
+        · <%= link_to @card.column.name, public_board_column_path(@board.publication.key, @card.column) %>
+      <% else %>
+        · Maybe?
+      <% end %>
+    </p>
+    <h1 class="txt-x-large"><%= @card.title %></h1>
+  </header>
+
+  <% if @card.description.present? %>
+    <div class="rich-text-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <p class="txt-subtle">
+      <% @card.tags.each do |tag| %>
+        <span>#<%= tag.title %></span>
+      <% end %>
+    </p>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul class="public-card-perma__steps">
+      <% @card.steps.each do |step| %>
+        <li>
+          <%= check_box_tag dom_id(step, :public), "1", step.completed?, disabled: true %>
+          <%= label_tag dom_id(step, :public), step.content %>
+        </li>
+      <% end %>
+    </ul>
+  <% end %>
+</article>
