diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..50353e2 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,22 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw timestamp. The browser formats it in the viewer's own
+  # timezone (see local_time_controller.js), so no server timezone ever gets baked into the HTML.
+  #
+  # Styles:
+  #   :time       1:42 PM
+  #   :date       Sep 12, 2025
+  #   :shortdate  Sep 12 (year added when not the current year)
+  #   :longdate   Tuesday, September 12 (year added when not the current year)
+  #   :datetime   9/12/25, 1:42 PM
+  #   :ago        3 days ago
+  #   :relative   1:42 PM / yesterday / 5 days ago / Sep 12
+  #   :indays     today / tomorrow / in 3 days
+  LOCAL_TIME_STYLES = %i[ time date shortdate longdate datetime ago relative indays ]
+
+  def local_datetime_tag(datetime, style: :time, **attributes)
+    raise ArgumentError, "Unknown local time style: #{style.inspect}" unless style.to_sym.in?(LOCAL_TIME_STYLES)
+
+    tag.time "", **attributes.except(:data), datetime: datetime.to_time.utc.iso8601,
+      data: { local_time_target: style.to_s, action: "turbo:morph-element->local-time#refreshTarget", **attributes.fetch(:data, {}) }
+  end
 end
