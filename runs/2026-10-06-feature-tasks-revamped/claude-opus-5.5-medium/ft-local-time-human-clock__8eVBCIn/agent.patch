diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..f8a10fe
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders the raw UTC timestamp for the browser to format" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    in_time_zone("America/New_York") do
+      assert_dom_equal \
+        %(<time datetime="2025-09-12T13:42:00Z" data-local-time-target="ago" data-action="turbo:morph-element->local-time#refreshTarget"></time>),
+        local_datetime_tag(time.in_time_zone, style: :ago)
+    end
+  end
+
+  test "output does not depend on the server timezone" do
+    time = Time.utc(2025, 9, 12, 23, 30)
+
+    assert_equal \
+      in_time_zone("Pacific/Auckland") { local_datetime_tag(time.in_time_zone, style: :relative) },
+      in_time_zone("America/Los_Angeles") { local_datetime_tag(time.in_time_zone, style: :relative) }
+  end
+
+  test "defaults to the time style and accepts extra attributes" do
+    html = local_datetime_tag(Time.current, class: "txt-small", data: { foo: "bar" })
+
+    assert_includes html, %(data-local-time-target="time")
+    assert_includes html, %(class="txt-small")
+    assert_includes html, %(data-foo="bar")
+  end
+
+  test "rejects unknown styles" do
+    assert_raises(ArgumentError) { local_datetime_tag(Time.current, style: :nonsense) }
+  end
+
+  private
+    def in_time_zone(zone, &block)
+      Time.use_zone(zone, &block)
+    end
+end
