diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..cbc671b
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,57 @@
+import { Controller } from "@hotwired/stimulus"
+import { LOCAL_TIME_STYLES, formatLocalTime, formatFullDatetime } from "helpers/local_time_helpers"
+
+// Formats <time datetime="…" data-local-time-target="style"> elements (see TimeHelper#local_datetime_tag)
+// in the viewer's timezone, so the server never renders times and the HTML stays shareable.
+export default class extends Controller {
+  static targets = LOCAL_TIME_STYLES
+  static values = { refreshInterval: { type: Number, default: 60 * 1000 } }
+
+  connect() {
+    this.refreshAll()
+    this.timer = setInterval(() => this.refreshAll(), this.refreshIntervalValue)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  refreshAll() {
+    const now = new Date()
+    this.#timeElements.forEach(element => this.#render(element, now))
+  }
+
+  // Morphing restores the (empty) server-rendered content, so format again afterwards
+  refreshTarget({ target }) {
+    if (this.#timeElements.includes(target)) this.#render(target)
+  }
+
+  timeTargetConnected(element) { this.#render(element) }
+  dateTargetConnected(element) { this.#render(element) }
+  shortdateTargetConnected(element) { this.#render(element) }
+  longdateTargetConnected(element) { this.#render(element) }
+  datetimeTargetConnected(element) { this.#render(element) }
+  agoTargetConnected(element) { this.#render(element) }
+  relativeTargetConnected(element) { this.#render(element) }
+  indaysTargetConnected(element) { this.#render(element) }
+
+  get #timeElements() {
+    return LOCAL_TIME_STYLES.flatMap(style => this[`${style}Targets`])
+  }
+
+  #render(element, now = new Date()) {
+    const date = new Date(element.getAttribute("datetime"))
+    if (isNaN(date)) return
+
+    const { before, value, after } = formatLocalTime(element.dataset.localTimeTarget, date, now)
+    const valueElement = document.createElement("span")
+    valueElement.className = "local-time-value"
+    valueElement.textContent = value
+
+    if (element.textContent !== `${before}${value}${after}`) {
+      element.replaceChildren(before, valueElement, after)
+    }
+    const title = formatFullDatetime(date)
+    if (element.title !== title) element.title = title
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..0a4295f
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,124 @@
+// Turns timestamps into words in the viewer's own timezone and locale. Each formatter returns
+// the parts of the phrase so the meaningful bit (`value`) can be emphasized: "<3 days> ago".
+
+const MINUTE = 60 * 1000
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+
+export const LOCAL_TIME_STYLES = [ "time", "date", "shortdate", "longdate", "datetime", "ago", "relative", "indays" ]
+
+const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" })
+const dateFormatter = new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" })
+const shortdateFormatter = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" })
+const shortdateWithYearFormatter = dateFormatter
+const longdateFormatter = new Intl.DateTimeFormat(undefined, { weekday: "long", month: "long", day: "numeric" })
+const longdateWithYearFormatter = new Intl.DateTimeFormat(undefined, { weekday: "long", month: "long", day: "numeric", year: "numeric" })
+const datetimeFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: "short", timeStyle: "short" })
+const fullFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: "full", timeStyle: "short" })
+
+const formatters = {
+  time(date) {
+    return { value: timeFormatter.format(date) }
+  },
+
+  date(date) {
+    return { value: dateFormatter.format(date) }
+  },
+
+  shortdate(date, now) {
+    const formatter = isSameYear(date, now) ? shortdateFormatter : shortdateWithYearFormatter
+    return { value: formatter.format(date) }
+  },
+
+  longdate(date, now) {
+    const formatter = isSameYear(date, now) ? longdateFormatter : longdateWithYearFormatter
+    return { value: formatter.format(date) }
+  },
+
+  datetime(date) {
+    return { value: datetimeFormatter.format(date) }
+  },
+
+  ago(date, now) {
+    return { value: distanceInWords(now - date), after: " ago" }
+  },
+
+  relative(date, now) {
+    const days = calendarDaysBetween(date, now)
+
+    if (days <= 0) {
+      return formatters.time(date)
+    } else if (days === 1) {
+      return { value: "yesterday" }
+    } else if (days < 7) {
+      return { value: pluralize(days, "day"), after: " ago" }
+    } else {
+      return formatters.shortdate(date, now)
+    }
+  },
+
+  indays(date, now) {
+    const days = calendarDaysBetween(now, date)
+
+    if (days <= 0) {
+      return { value: "today" }
+    } else if (days === 1) {
+      return { value: "tomorrow" }
+    } else {
+      return { before: "in ", value: pluralize(days, "day") }
+    }
+  }
+}
+
+export function formatLocalTime(style, date, now = new Date()) {
+  const formatter = formatters[style] || formatters.time
+  return { before: "", after: "", ...formatter(date, now) }
+}
+
+export function formatLocalTimeAsText(style, date, now = new Date()) {
+  const { before, value, after } = formatLocalTime(style, date, now)
+  return `${before}${value}${after}`
+}
+
+export function formatFullDatetime(date) {
+  return fullFormatter.format(date)
+}
+
+// Number of midnights between two moments, in the viewer's timezone
+export function calendarDaysBetween(fromDate, toDate) {
+  return Math.round((startOfLocalDay(toDate) - startOfLocalDay(fromDate)) / DAY)
+}
+
+function startOfLocalDay(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function isSameYear(date, now) {
+  return date.getFullYear() === now.getFullYear()
+}
+
+function distanceInWords(milliseconds) {
+  const minutes = Math.floor(Math.max(milliseconds, 0) / MINUTE)
+  const hours = Math.floor(minutes / 60)
+  const days = Math.floor(hours / 24)
+  const months = Math.floor(days / 30)
+  const years = Math.floor(days / 365)
+
+  if (minutes < 1) {
+    return "less than a minute"
+  } else if (minutes < 60) {
+    return pluralize(minutes, "minute")
+  } else if (hours < 24) {
+    return pluralize(hours, "hour")
+  } else if (days < 30) {
+    return pluralize(days, "day")
+  } else if (months < 12) {
+    return pluralize(months, "month")
+  } else {
+    return pluralize(years, "year")
+  }
+}
+
+function pluralize(count, word) {
+  return `${count} ${word}${count === 1 ? "" : "s"}`
+}
