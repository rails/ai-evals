--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = PushSubscription.register(user: @user, user_agent: request.user_agent, **push_subscription_params)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.json { render json: { id: @push_subscription.id, url: user_push_subscription_path(@user, @push_subscription) }, status: :created }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..4a6dced
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,128 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Turns push notifications on and off for the device in use.
+export default class extends Controller {
+  static targets = [ "toggle", "explainer", "details" ]
+  static classes = [ "on" ]
+  static values = { publicKey: String, subscriptionsUrl: String, subscriptions: Object }
+
+  async connect() {
+    if (this.#supported) {
+      this.#render(await this.#isSubscribed())
+    } else {
+      this.#showExplainer({ blocked: false })
+    }
+  }
+
+  async subscribe() {
+    if (await Notification.requestPermission() === "granted") {
+      try {
+        this.#render(await this.#register(await this.#subscribeWithPushService()))
+      } catch (error) {
+        console.error("Couldn't turn on push notifications", error)
+        this.#render(false)
+      }
+    } else {
+      this.#render(false)
+    }
+  }
+
+  async unsubscribe() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription) {
+      const url = this.subscriptionsValue[subscription.endpoint]
+      if (url) await destroy(url, { responseKind: "json" })
+
+      await subscription.unsubscribe()
+    }
+
+    this.#render(false)
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #blocked() {
+    return Notification.permission === "denied"
+  }
+
+  async #isSubscribed() {
+    const subscription = await this.#currentSubscription()
+    return Notification.permission === "granted" && subscription != null && subscription.endpoint in this.subscriptionsValue
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    return registration?.pushManager.getSubscription()
+  }
+
+  async #subscribeWithPushService() {
+    const registration = await navigator.serviceWorker.ready
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing && this.#signedWithCurrentKey(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  #signedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+    return key ? encodeBase64Url(key) === encodeBase64Url(this.#applicationServerKey) : true
+  }
+
+  get #applicationServerKey() {
+    return decodeBase64Url(this.publicKeyValue)
+  }
+
+  async #register(subscription) {
+    const response = await post(this.subscriptionsUrlValue, { body: this.#serialize(subscription), responseKind: "json" })
+
+    if (response.ok) {
+      const { url } = await response.json
+      this.subscriptionsValue = { ...this.subscriptionsValue, [subscription.endpoint]: url }
+    }
+
+    return response.ok
+  }
+
+  #serialize(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+    return { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } }
+  }
+
+  #render(subscribed) {
+    this.element.classList.toggle(this.onClass, subscribed)
+
+    if (this.#blocked) {
+      this.#showExplainer({ blocked: true })
+    } else {
+      this.#hideExplainer()
+    }
+  }
+
+  #showExplainer({ blocked }) {
+    this.toggleTargets.forEach(toggle => toggle.hidden = true)
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+    this.explainerTarget.hidden = false
+  }
+
+  #hideExplainer() {
+    this.toggleTargets.forEach(toggle => toggle.hidden = false)
+    this.explainerTarget.hidden = true
+  }
+}
+
+function decodeBase64Url(value) {
+  const base64 = value.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(value.length / 4) * 4, "=")
+  return Uint8Array.from(atob(base64), char => char.charCodeAt(0))
+}
+
+function encodeBase64Url(buffer) {
+  return btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+}
