@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+  end
+
+  test "create subscribes the device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json,
+        headers: { "User-Agent" => "Firefox" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.find(@response.parsed_body["id"])
+    assert_equal user_push_subscription_path(@user, subscription), @response.parsed_body["url"]
+    assert_equal subscription_params[:endpoint], subscription.endpoint
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+    assert_equal "Firefox", subscription.user_agent
+  end
+
+  test "create for an already subscribed device updates it" do
+    existing = push_subscriptions(:kevin_chrome)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), as: :json,
+        params: { push_subscription: { endpoint: existing.endpoint, p256dh_key: existing.p256dh_key, auth_key: "fresh" } }
+    end
+
+    assert_response :created
+    assert_equal "fresh", existing.reload.auth_key
+  end
+
+  test "create with HTML redirects to notification settings" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "create rejects endpoints that aren't push services" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), as: :json,
+        params: { push_subscription: subscription_params.merge(endpoint: "https://169.254.169.254/latest") }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects incomplete subscriptions" do
+    post user_push_subscriptions_path(@user), params: { endpoint: "https://fcm.googleapis.com/fcm/send/x" }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires the subscription" do
+    post user_push_subscriptions_path(@user), params: { something: "else" }
+
+    assert_response :bad_request
+  end
+
+  test "create can't subscribe a device for someone else" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy unsubscribes the device" do
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, push_subscriptions(:kevin_chrome)), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy can't remove someone else's device" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@user, push_subscriptions(:kevin_chrome)), as: :json
+    end
+
+    assert_response :forbidden
+
+    delete user_push_subscription_path(users(:david), push_subscriptions(:kevin_chrome)), as: :json
+    assert_response :not_found
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://updates.push.services.mozilla.com/wpush/v2/kevin-firefox",
+        p256dh_key: push_subscriptions(:kevin_chrome).p256dh_key,
+        auth_key: "c2VjcmV0LWF1dGgta2V5"
+      }
+    end
+end
