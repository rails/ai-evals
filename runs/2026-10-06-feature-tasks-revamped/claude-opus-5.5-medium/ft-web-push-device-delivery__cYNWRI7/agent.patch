diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..37a3cb9
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  include WebPushTestHelper
+
+  setup do
+    enable_web_push
+    @kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+  end
+
+  teardown { restore_web_push }
+
+  test "landing in the tray enqueues a push" do
+    assert_enqueued_with job: Notification::PushJob do
+      create_notification
+    end
+  end
+
+  test "coming back to the top of the tray enqueues a push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:logo_published), read_at: nil, unread_count: 3)
+    end
+  end
+
+  test "reading or unreading doesn't push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "nothing is enqueued when web push isn't configured" do
+    disable_web_push
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      create_notification
+    end
+  end
+
+  test "a push says what the tray says and opens the card it's about" do
+    notification = create_notification
+    messages = capture_push_messages
+
+    notification.push
+
+    assert_equal @kevin.push_subscriptions.count, messages.size
+    messages.each do |message|
+      assert_equal helpers.event_notification_title(notification.source), message["title"]
+      assert_equal helpers.event_notification_body(notification.source), message["body"]
+      assert_equal card_path(cards(:layout)), message["path"]
+      assert_equal cards(:layout).id, message["tag"]
+    end
+  end
+
+  test "a mention push says who mentioned you" do
+    mention = mentions(:logo_card_david_mention_by_jz)
+    notification = users(:david).notifications.find_by(card: mention.card) ||
+      Notification.create!(user: users(:david), source: mention, creator: mention.mentioner)
+    notification.update!(source: mention, creator: mention.mentioner, read_at: nil)
+    users(:david).push_subscriptions.create!(push_subscriptions(:kevin_chrome).slice(:p256dh_key, :auth_key).merge(endpoint: "https://fcm.googleapis.com/fcm/send/david"))
+    messages = capture_push_messages
+
+    notification.push
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", messages.sole["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), messages.sole["body"]
+    assert_equal card_path(mention.card), messages.sole["path"]
+  end
+
+  test "notifications read before the push goes out aren't pushed" do
+    notification = create_notification
+    notification.read
+    messages = capture_push_messages
+
+    notification.push
+
+    assert_empty messages
+  end
+
+  test "push delivers to every device and survives one failing" do
+    notification = create_notification
+    stub_push_service(push_subscriptions(:kevin_chrome), status: 500)
+    stub_push_service(push_subscriptions(:kevin_safari))
+
+    notification.push
+
+    assert_requested :post, push_subscriptions(:kevin_chrome).endpoint
+    assert_requested :post, push_subscriptions(:kevin_safari).endpoint
+  end
+
+  test "push job delivers the notification and cleans up expired devices" do
+    stub_push_service(push_subscriptions(:kevin_chrome), status: 410)
+    stub_push_service(push_subscriptions(:kevin_safari))
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      create_notification
+    end
+
+    assert_requested :post, push_subscriptions(:kevin_safari).endpoint
+    assert_equal [ push_subscriptions(:kevin_safari) ], @kevin.push_subscriptions.reload
+  end
+
+  private
+    def create_notification
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+
+    def capture_push_messages
+      [].tap do |messages|
+        PushSubscription.any_instance.stubs(:push).with { |message| messages << JSON.parse(message) }
+      end
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+
+    def card_path(card)
+      Rails.application.routes.url_helpers.card_path(card, script_name: card.account.slug)
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..3e6ec07
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  include WebPushTestHelper
+
+  setup { enable_web_push }
+  teardown { restore_web_push }
+
+  test "enabled only when both VAPID keys are configured" do
+    assert PushSubscription.enabled?
+
+    Rails.configuration.x.web_push.vapid_private_key = nil
+    assert_not PushSubscription.enabled?
+
+    disable_web_push
+    assert_not PushSubscription.enabled?
+  end
+
+  test "accepts endpoints from browser push services" do
+    %w[
+      https://fcm.googleapis.com/fcm/send/abc
+      https://updates.push.services.mozilla.com/wpush/v2/abc
+      https://web.push.apple.com/abc
+      https://wns2-par02p.notify.windows.com/w/?token=abc
+    ].each do |endpoint|
+      assert build_subscription(endpoint: endpoint).valid?, "#{endpoint} should be valid"
+    end
+  end
+
+  test "rejects endpoints that aren't browser push services" do
+    [
+      "http://fcm.googleapis.com/fcm/send/abc",
+      "https://example.com/push",
+      "https://fcm.googleapis.com.evil.com/push",
+      "https://evilfcm.googleapis.com/push",
+      "https://user:pass@fcm.googleapis.com/push",
+      "https://169.254.169.254/latest/meta-data",
+      "https://localhost/push",
+      "not a url",
+      ""
+    ].each do |endpoint|
+      assert_not build_subscription(endpoint: endpoint).valid?, "#{endpoint.inspect} should be invalid"
+    end
+  end
+
+  test "requires well-formed keys" do
+    assert_not build_subscription(p256dh_key: "").valid?
+    assert_not build_subscription(auth_key: "not base64!").valid?
+  end
+
+  test "register creates a subscription for the user" do
+    subscription = PushSubscription.register(user: users(:david), endpoint: "https://fcm.googleapis.com/fcm/send/david",
+      p256dh_key: push_subscriptions(:kevin_chrome).p256dh_key, auth_key: "auth", user_agent: "Chrome")
+
+    assert subscription.persisted?
+    assert_equal users(:david), subscription.user
+    assert_equal accounts("37s"), subscription.account
+    assert_equal "Chrome", subscription.user_agent
+  end
+
+  test "register refreshes the keys of an existing subscription" do
+    existing = push_subscriptions(:kevin_chrome)
+
+    assert_no_difference -> { PushSubscription.count } do
+      PushSubscription.register(user: users(:kevin), endpoint: existing.endpoint, p256dh_key: existing.p256dh_key, auth_key: "rotated")
+    end
+
+    assert_equal "rotated", existing.reload.auth_key
+  end
+
+  test "register takes the device over from someone else who signed in on it" do
+    endpoint = push_subscriptions(:kevin_chrome).endpoint
+
+    PushSubscription.register(user: users(:david), endpoint: endpoint, p256dh_key: push_subscriptions(:kevin_chrome).p256dh_key, auth_key: "auth")
+
+    assert_equal [ users(:david) ], PushSubscription.where(endpoint: endpoint).map(&:user)
+    assert_not PushSubscription.exists?(push_subscriptions(:kevin_chrome).id)
+  end
+
+  test "register keeps the device subscribed for the same person in their other accounts" do
+    kevin_at_initech = accounts(:initech).users.create!(name: "Kevin", identity: identities(:kevin))
+    endpoint = push_subscriptions(:kevin_chrome).endpoint
+
+    PushSubscription.register(user: kevin_at_initech, endpoint: endpoint, p256dh_key: push_subscriptions(:kevin_chrome).p256dh_key, auth_key: "auth")
+
+    assert_equal [ users(:kevin), kevin_at_initech ].sort_by(&:id), PushSubscription.where(endpoint: endpoint).map(&:user).sort_by(&:id)
+  end
+
+  test "push sends an encrypted, VAPID-signed message to the push service" do
+    subscription = push_subscriptions(:kevin_chrome)
+    stub_push_service(subscription)
+
+    subscription.push({ title: "Hello" }.to_json)
+
+    assert_requested :post, subscription.endpoint do |request|
+      request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Urgency"] == "high" &&
+        !request.body.include?("Hello")
+    end
+  end
+
+  test "push forgets subscriptions the push service no longer knows" do
+    [ 404, 410 ].each do |status|
+      subscription = users(:kevin).push_subscriptions.create!(push_subscriptions(:kevin_chrome).slice(:p256dh_key, :auth_key).merge(endpoint: "https://fcm.googleapis.com/fcm/send/gone-#{status}"))
+      stub_push_service(subscription, status: status)
+
+      subscription.push("{}")
+
+      assert subscription.destroyed?, "should destroy on #{status}"
+    end
+  end
+
+  test "push keeps the subscription and raises on other failures" do
+    subscription = push_subscriptions(:kevin_chrome)
+    stub_push_service(subscription, status: 500)
+
+    assert_raises(WebPush::PushServiceError) { subscription.push("{}") }
+    assert PushSubscription.exists?(subscription.id)
+  end
+
+  test "deactivating a user removes their push subscriptions" do
+    users(:kevin).deactivate
+
+    assert_empty users(:kevin).push_subscriptions.reload
+  end
+
+  private
+    def build_subscription(**attributes)
+      users(:david).push_subscriptions.build({
+        endpoint: "https://fcm.googleapis.com/fcm/send/abc",
+        p256dh_key: push_subscriptions(:kevin_chrome).p256dh_key,
+        auth_key: "gPjTp4qvjRKbNbEWnxN02w"
+      }.merge(attributes))
+    end
+end
diff --git a/test/test_helpers/web_push_test_helper.rb b/test/test_helpers/web_push_test_helper.rb
new file mode 100644
index 0000000..ffcbc7f
--- /dev/null
+++ b/test/test_helpers/web_push_test_helper.rb
@@ -0,0 +1,24 @@
+module WebPushTestHelper
+  VAPID_KEY = WebPush.generate_key
+
+  private
+
+  def enable_web_push
+    @original_web_push_config = Rails.configuration.x.web_push.to_h
+    Rails.configuration.x.web_push.vapid_public_key = VAPID_KEY.public_key
+    Rails.configuration.x.web_push.vapid_private_key = VAPID_KEY.private_key
+  end
+
+  def disable_web_push
+    Rails.configuration.x.web_push.vapid_public_key = nil
+    Rails.configuration.x.web_push.vapid_private_key = nil
+  end
+
+  def restore_web_push
+    @original_web_push_config&.each { |key, value| Rails.configuration.x.web_push[key] = value }
+  end
+
+  def stub_push_service(subscription, status: 201)
+    stub_request(:post, subscription.endpoint).to_return(status: status)
+  end
+end
