diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..8850ff8
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,42 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :push_later, on: %i[ create update ], if: :landed_in_tray?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push
+    if pushable?
+      message = push_message
+
+      user.push_subscriptions.each do |subscription|
+        Rails.error.handle(context: { push_subscription_id: subscription.id }) do
+          subscription.push(message)
+        end
+      end
+    end
+  end
+
+  private
+    # A notification lands in the tray when it's created, and again whenever a new event or
+    # mention on the same card brings it back to the top. Reading or unreading it doesn't count.
+    def landed_in_tray?
+      source_id_previously_changed? && PushSubscription.enabled?
+    end
+
+    def pushable?
+      !read? && PushSubscription.enabled? && user.active?
+    end
+
+    def push_message
+      push_renderer.render(template: "notifications/push", formats: :json, assigns: { notification: self })
+    end
+
+    def push_renderer
+      ApplicationController.renderer.new(script_name: account.slug, https: !Rails.env.local?)
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..ccbfe9a
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,77 @@
+class PushSubscription < ApplicationRecord
+  # Browsers hand out endpoints from their vendor's push service. We only ever deliver to those,
+  # so a forged subscription can't turn the push sender into a way to reach arbitrary hosts.
+  PERMITTED_ENDPOINT_HOSTS = [
+    /\Afcm\.googleapis\.com\z/,                  # Chrome, Edge on non-Windows, Brave, Opera, Samsung Internet
+    /\Aandroid\.googleapis\.com\z/,              # Legacy Chrome
+    /\Aupdates\.push\.services\.mozilla\.com\z/, # Firefox
+    /\A([a-z0-9-]+\.)*push\.apple\.com\z/,       # Safari
+    /\A([a-z0-9-]+\.)+notify\.windows\.com\z/    # Edge on Windows
+  ].freeze
+
+  KEY_FORMAT = /\A[A-Za-z0-9_\-]+={0,2}\z/
+
+  DELIVERY_TIMEOUTS = { open_timeout: 5, read_timeout: 5, ssl_timeout: 5 }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, length: { maximum: 2048 }, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true, length: { maximum: 255 }, format: { with: KEY_FORMAT }
+  validate :endpoint_belongs_to_a_push_service
+
+  normalizes :endpoint, :p256dh_key, :auth_key, with: -> { it.strip }
+  normalizes :user_agent, with: -> { it.truncate(4096) }
+
+  class << self
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      Rails.configuration.x.web_push.vapid_public_key
+    end
+
+    # A browser only has one subscription per site, so whoever subscribes last on a device owns it.
+    # Other people who signed in on that browser before must stop receiving pushes there.
+    def register(user:, endpoint: nil, p256dh_key: nil, auth_key: nil, user_agent: nil)
+      transaction do
+        where(endpoint: endpoint).where.not(user: user.identity.users).destroy_all
+
+        user.push_subscriptions.find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+          subscription.update!(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+        end
+      end
+    end
+
+    def vapid
+      config = Rails.configuration.x.web_push
+      { subject: config.vapid_subject, public_key: config.vapid_public_key, private_key: config.vapid_private_key }
+    end
+
+    private
+      def vapid_private_key
+        Rails.configuration.x.web_push.vapid_private_key
+      end
+  end
+
+  def push(message)
+    WebPush.payload_send(message: message, endpoint: endpoint, p256dh: p256dh_key, auth: auth_key,
+      vapid: self.class.vapid, urgency: "high", **DELIVERY_TIMEOUTS)
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The push service no longer knows this subscription: the person turned notifications off,
+    # cleared site data, or uninstalled the browser.
+    destroy
+  end
+
+  private
+    def endpoint_belongs_to_a_push_service
+      uri = URI.parse(endpoint.to_s)
+
+      unless uri.is_a?(URI::HTTPS) && uri.userinfo.nil? && PERMITTED_ENDPOINT_HOSTS.any? { it.match?(uri.host.to_s.downcase) }
+        errors.add :endpoint, "is not a supported push service"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a valid URL"
+    end
+end
