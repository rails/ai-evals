diff --git a/app/models/card/exportable.rb b/app/models/card/exportable.rb
new file mode 100644
index 0000000..0289c5c
--- /dev/null
+++ b/app/models/card/exportable.rb
@@ -0,0 +1,64 @@
+# A self-contained, human-readable JSON version of a card with its comments, used by data exports.
+# Files are referenced by their path inside the archive, which the caller decides via `file_path`.
+module Card::Exportable
+  extend ActiveSupport::Concern
+
+  # Every file attached to the card: its image and the files embedded in its description and comments.
+  def exportable_blobs
+    [ image.attached? ? image.blob : nil, *attachments.map(&:blob), *comments.flat_map { |comment| comment.attachments.map(&:blob) } ].compact.uniq
+  end
+
+  def export_data(file_path:)
+    {
+      number: number,
+      title: title,
+      status: status,
+      url: Rails.application.routes.url_helpers.card_path(self, script_name: account.slug),
+      board: { id: board_id, name: board.name },
+      column: column&.name,
+      creator: export_person(creator),
+      created_at: created_at,
+      updated_at: updated_at,
+      last_active_at: last_active_at,
+      due_on: due_on,
+      closed: closed?,
+      closed_at: closed_at,
+      closed_by: export_person(closed_by),
+      postponed: postponed?,
+      golden: golden?,
+      tags: tags.map(&:title),
+      assignees: assignees.map { |assignee| export_person(assignee) },
+      steps: steps.map { |step| { content: step.content, completed: step.completed? } },
+      image: (export_file(image.blob, file_path) if image.attached?),
+      description: export_rich_text(description, file_path),
+      comments: comments.chronologically.map { |comment| export_comment(comment, file_path) }
+    }
+  end
+
+  private
+    def export_comment(comment, file_path)
+      {
+        id: comment.id,
+        creator: export_person(comment.creator),
+        created_at: comment.created_at,
+        updated_at: comment.updated_at,
+        body: export_rich_text(comment.body, file_path)
+      }
+    end
+
+    def export_person(user)
+      { id: user.id, name: user.name, email_address: user.identity&.email_address } if user
+    end
+
+    def export_rich_text(rich_text, file_path)
+      {
+        plain_text: rich_text.to_plain_text,
+        html: rich_text.body&.fragment&.to_html.to_s,
+        attachments: rich_text.embeds.map { |attachment| export_file(attachment.blob, file_path) }
+      }
+    end
+
+    def export_file(blob, file_path)
+      { filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, path: file_path.(blob) }
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..d4f64f3
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,70 @@
+class Export < ApplicationRecord
+  AVAILABLE_FOR = 24.hours
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :recent, -> { where(created_at: AVAILABLE_FOR.ago..) }
+  scope :expired, -> { where(completed_at: ...AVAILABLE_FOR.ago).or(where(completed_at: nil, created_at: ...AVAILABLE_FOR.ago)) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def build_later
+    DataExportJob.perform_later(self)
+  end
+
+  def build
+    processing!
+
+    ZipFile.create_for(file, filename: filename) { |zip| populate_zip(zip) }
+    update!(status: :completed, completed_at: Time.current)
+
+    ExportMailer.completed(self).deliver_later
+  rescue => error
+    update_columns(status: :failed, updated_at: Time.current)
+    ExportMailer.failed(self).deliver_later
+    raise error
+  end
+
+  def expires_at
+    completed_at + AVAILABLE_FOR if completed_at
+  end
+
+  def expired?
+    expires_at&.past? || false
+  end
+
+  def downloadable?
+    completed? && !expired? && file.attached?
+  end
+
+  # Only the person who asked for the export can download it, and only while it's available.
+  def accessible_to?(user)
+    user == self.user && downloadable?
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def filename
+    "fizzy-#{filename_subject.parameterize}-#{created_at.utc.strftime("%Y%m%d%H%M%S")}.zip"
+  end
+
+  private
+    def populate_zip(zip)
+      raise NotImplementedError
+    end
+
+    def filename_subject
+      account.name
+    end
+end
