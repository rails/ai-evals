@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    untenanted { get new_account_import_path }
+
+    assert_response :success
+    assert_select "input[type=file][name='account_import[file]']"
+  end
+
+  test "create starts an import in a new account" do
+    file = zip_upload
+
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { Account::Import.count }, 1 do
+        assert_enqueued_with(job: ImportAccountDataJob) do
+          untenanted { post account_imports_path, params: { account_import: { file: file } } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_redirected_to account_import_path(import, script_name: nil)
+    assert_equal identities(:david), import.identity
+    assert import.file.attached?
+    assert_equal import.account.id, import.file.blob.account_id
+    assert import.account.users.find_by(identity: identities(:david)).owner?
+  end
+
+  test "create without a zip file doesn't leave an account behind" do
+    assert_no_difference -> { Account.count } do
+      untenanted { post account_imports_path, params: { account_import: { file: fixture_file_upload("moon.jpg", "image/jpeg") } } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "show is only for the person who imported" do
+    import = Account::Import.start(identity: identities(:david), file: zip_upload)
+
+    untenanted { get account_import_path(import) }
+    assert_response :success
+
+    logout_and_sign_in_as :kevin
+    untenanted { get account_import_path(import) }
+    assert_response :not_found
+  end
+
+  private
+    def zip_upload
+      tempfile = Tempfile.new([ "export", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      writer.add_file "manifest.json", "{}"
+      writer.close
+      tempfile.flush
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+    end
+end
