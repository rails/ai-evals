diff --git a/lib/tasks/accounts.rake b/lib/tasks/accounts.rake
new file mode 100644
index 0000000..8b32002
--- /dev/null
+++ b/lib/tasks/accounts.rake
@@ -0,0 +1,11 @@
+namespace :accounts do
+  desc "Import an account export too big to upload through the browser: bin/rails accounts:import[path/to/export.zip,owner@example.com]"
+  task :import, %i[ path email_address ] => :environment do |_, args|
+    identity = Identity.find_by!(email_address: args.fetch(:email_address))
+
+    File.open(args.fetch(:path), "rb") do |io|
+      import = Account::Import.start(identity: identity, file: { io: io, filename: File.basename(args[:path]), content_type: "application/zip" })
+      puts "Import #{import.id} started. #{identity.email_address} will get an email when it's done."
+    end
+  end
+end
