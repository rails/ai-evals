@@ -0,0 +1,43 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  test "build exports the cards the person can see with comments and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "moon.jpg", content_type: "image/png")
+    card.update!(description: "<action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment>")
+
+    user = users(:david)
+    export = User::DataExport.create!(account: user.account, user: user)
+    export.build
+
+    assert export.completed?
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      expected = user.accessible_cards.published.map { "cards/#{it.number}.json" }.sort
+      assert_equal expected, zip.glob("cards/*.json")
+
+      data = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, data["title"]
+      assert_equal [ "I agree.", "Same, let's do it." ], data["comments"].map { it.dig("body", "plain_text") }.reject(&:blank?).first(2)
+
+      assert_equal "cards/#{card.number}/moon.jpg", data.dig("image", "path")
+      assert_equal "cards/#{card.number}/moon (2).jpg", data.dig("description", "attachments", 0, "path")
+      assert_equal File.binread(file_fixture("moon.jpg")), zip.read("cards/#{card.number}/moon.jpg")
+      assert_equal File.binread(file_fixture("avatar.png")), zip.read("cards/#{card.number}/moon (2).jpg")
+    end
+  end
+
+  test "cards on boards the person can't see are left out" do
+    user = users(:jz)
+    Current.user = users(:kevin)
+    hidden = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: :published)
+
+    export = User::DataExport.create!(account: user.account, user: user)
+    export.build
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      assert_not zip.exists?("cards/#{hidden.number}.json")
+    end
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..37556ba 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,52 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "reader reads files from a blob" do
+    blob = zip_blob do |writer|
+      writer.add_file("data/cards/1.json", "{\"id\":1}")
+      writer.add_file("data/cards/2.json", "{\"id\":2}")
+      writer.add_file("storage/abc", "x" * 100_000, compress: false)
+    end
+
+    ZipFile.read_from(blob) do |zip|
+      assert_equal [ "data/cards/1.json", "data/cards/2.json" ], zip.glob("data/cards/*.json")
+      assert zip.exists?("storage/abc")
+      assert_equal "{\"id\":2}", zip.read("data/cards/2.json")
+      assert_equal 100_000, zip.size_of("storage/abc")
+
+      chunks = []
+      zip.read("storage/abc") { |chunk| chunks << chunk }
+      assert_equal "x" * 100_000, chunks.join
+    end
+  end
+
+  test "reader refuses to read more than the limit" do
+    blob = zip_blob { |writer| writer.add_file("big.txt", "x" * 1000) }
+
+    ZipFile.read_from(blob) do |zip|
+      assert_raises(ZipFile::Reader::InvalidFileError) { zip.read("big.txt", limit: 10) }
+      assert_raises(ZipFile::Reader::InvalidFileError) { zip.read("missing.txt") }
+    end
+  end
+
+  test "reader rejects files that aren't zips" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("nope"), filename: "nope.zip")
+
+    assert_raises(ZipFile::Reader::InvalidFileError) do
+      ZipFile.read_from(blob) { }
+    end
+  end
+
+  private
+    def zip_blob
+      tempfile = Tempfile.new([ "test", ".zip" ])
+      tempfile.binmode
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.rewind
+
+      ActiveStorage::Blob.create_and_upload!(io: tempfile, filename: "test.zip")
+    end
 end
