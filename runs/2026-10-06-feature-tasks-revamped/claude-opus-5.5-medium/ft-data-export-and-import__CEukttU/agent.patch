diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..f34c25a
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,59 @@
+# A seekable, read-only IO over an Active Storage blob that fetches byte ranges from the
+# storage service on demand. Works the same for disk and S3 services, so huge archives
+# can be read without downloading them first.
+class ZipFile::BlobIO
+  READ_AHEAD = 4.megabytes
+
+  attr_reader :size
+
+  def initialize(blob)
+    @blob = blob
+    @size = blob.byte_size
+    @pos = 0
+    @buffer = "".b
+    @buffer_start = 0
+  end
+
+  def seek(offset, mode = IO::SEEK_SET)
+    raise ArgumentError, "Unsupported seek mode #{mode}" unless mode == IO::SEEK_SET
+
+    @pos = offset.clamp(0, size)
+    0
+  end
+
+  def tell
+    @pos
+  end
+  alias_method :pos, :tell
+
+  def read(length = nil)
+    return nil if @pos >= size && length.to_i > 0
+
+    length ||= size - @pos
+    length = [ length, size - @pos ].min
+    return "".b if length <= 0
+
+    read_range(@pos, length).tap { @pos += length }
+  end
+
+  private
+    def read_range(offset, length)
+      if buffered?(offset, length)
+        @buffer.byteslice(offset - @buffer_start, length)
+      elsif length >= READ_AHEAD
+        download(offset, length)
+      else
+        @buffer_start = offset
+        @buffer = download(offset, [ READ_AHEAD, size - offset ].min)
+        @buffer.byteslice(0, length)
+      end
+    end
+
+    def buffered?(offset, length)
+      offset >= @buffer_start && offset + length <= @buffer_start + @buffer.bytesize
+    end
+
+    def download(offset, length)
+      @blob.service.download_chunk(@blob.key, offset...(offset + length)).b
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..5b51b22
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,75 @@
+class ZipFile::Reader
+  class InvalidFileError < StandardError; end
+
+  CHUNK_SIZE = 64.kilobytes
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = read_entries
+    @entries_by_directory = @entries.keys.group_by { |path| File.dirname(path) }
+  end
+
+  def glob(pattern)
+    directory = File.dirname(pattern)
+    candidates = directory.match?(/[*?\[{]/) ? @entries.keys : @entries_by_directory.fetch(directory, [])
+
+    candidates.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def size_of(path)
+    entry_for(path).uncompressed_size
+  end
+
+  # Returns the whole uncompressed content, or streams it in chunks when given a block.
+  # Raises InvalidFileError when the content is larger than the entry claims to be.
+  def read(path, limit: nil)
+    entry = entry_for(path)
+    limit = [ limit, entry.uncompressed_size ].compact.min
+
+    if block_given?
+      extract(entry, limit) { |chunk| yield chunk }
+    else
+      "".b.tap { |content| extract(entry, limit) { |chunk| content << chunk } }
+    end
+  end
+
+  private
+    def read_entries
+      @file_reader.read_zip_structure(io: @io, read_local_headers: false).index_by(&:filename)
+    rescue StandardError => error # Malformed archives can fail in many ways while parsing
+      raise InvalidFileError, "The file is not a valid ZIP archive (#{error.message})"
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise InvalidFileError, "#{path} is missing from the archive" }
+    end
+
+    def extract(entry, limit)
+      locate_data(entry)
+      extractor = entry.extractor_from(@io)
+      extracted = 0
+
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        break if chunk.nil?
+
+        extracted += chunk.bytesize
+        raise InvalidFileError, "#{entry.filename} is larger than expected" if extracted > limit
+
+        yield chunk
+      end
+    rescue Zlib::Error, ZipKit::FileReader::ReadError, ZipKit::FileReader::UnsupportedFeature => error
+      raise InvalidFileError, "#{entry.filename} could not be read (#{error.message})"
+    end
+
+    def locate_data(entry)
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+      end
+    end
+end
