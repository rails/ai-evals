+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Start import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
