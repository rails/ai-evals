+<% @page_title = "Import an account" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none">Upload a .zip file exported from a Fizzy account’s settings. We’ll create a new account with everything in it: boards, cards, comments, files, and people.</p>
