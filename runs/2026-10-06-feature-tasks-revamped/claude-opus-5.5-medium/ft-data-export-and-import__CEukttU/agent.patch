@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jason
+  end
+
+  test "an admin can start an export" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with(job: DataExportJob) do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+    assert_equal users(:jason), export.user
+    assert_equal accounts("37s"), export.account
+    assert export.pending?
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "exports are limited" do
+    Account::ExportsController::CURRENT_EXPORT_LIMIT.times { Account::Export.create!(account: accounts("37s"), user: users(:jason)) }
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :too_many_requests
+  end
+
+  test "show offers the download of a completed export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+    export.build
+
+    get account_export_path(export)
+
+    assert_response :success
+    assert_select "a#download-link"
+
+    get css_select("a#download-link").first["href"]
+    assert_response :redirect
+    assert_match %r{rails/active_storage/disk}, response.location
+  end
+
+  test "show explains when the export is gone" do
+    get account_export_path("missing")
+
+    assert_response :success
+    assert_select "h2", "Download Expired"
+  end
+
+  test "show explains when the export expired" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+    export.build
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_select "a#download-link", count: 0
+      assert_select "h2", "Download Expired"
+    end
+  end
+
+  test "other people can't download someone's export" do
+    logout_and_sign_in_as :kevin
+
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+    export.build
+    download_path = rails_blob_path(export.file, disposition: :attachment)
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "a#download-link", count: 0
+
+    get download_path
+    assert_response :forbidden
+  end
+end
