--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,32 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  rate_limit to: 5, within: 1.hour, only: :create, with: -> { redirect_to new_account_import_path, alert: "Try again later." }
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Account::Import.start(identity: Current.identity, file: import_params[:file])
+    redirect_to account_import_path(@import)
+  rescue ActiveRecord::RecordInvalid => error
+    @import = error.record.is_a?(Account::Import) ? error.record : Account::Import.new
+    render :new, status: :unprocessable_entity
+  rescue Account::Import::AccountCreationError
+    @import = Account::Import.new
+    @import.errors.add(:base, "We couldn’t create the new account. Please give it another try.")
+    render :new, status: :unprocessable_entity
+  end
+
+  def show
+    @import = Account::Import.where(identity: Current.identity).find(params[:id])
+  end
+
+  private
+    def import_params
+      params.fetch(:account_import, {}).permit(:file)
+    end
+end
