diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..f135ffb
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing" do
+    assert_equal [ 0, 1_000, 1.gigabyte ], Plan.free.then { [ it.price, it.card_limit, it.storage_limit ] }
+    assert_equal [ "Unlimited", 20, 5.gigabytes ], Plan.unlimited.then { [ it.name, it.price, it.storage_limit ] }
+    assert_equal [ "Unlimited+", 25, 500.gigabytes ], Plan.unlimited_plus.then { [ it.name, it.price, it.storage_limit ] }
+  end
+
+  test "only the free plan limits cards" do
+    assert Plan.free.limit_cards?
+    assert_not Plan.unlimited.limit_cards?
+    assert_not Plan.unlimited_plus.limit_cards?
+  end
+
+  test "find by key and by stripe price" do
+    assert_equal Plan.unlimited, Plan.find("monthly_v1")
+    assert_nil Plan.find("nope")
+
+    with_env "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" do
+      assert_equal Plan.unlimited_plus, Plan.find_by_stripe_price_id("price_plus")
+      assert_nil Plan.find_by_stripe_price_id("price_other")
+      assert_nil Plan.find_by_stripe_price_id(nil)
+    end
+  end
+
+  private
+    def with_env(values)
+      previous = values.keys.index_with { ENV[it] }
+      values.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      previous.each { |key, value| ENV[key] = value }
+    end
+end
