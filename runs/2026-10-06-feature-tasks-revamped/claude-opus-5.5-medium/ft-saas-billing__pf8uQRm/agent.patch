@@ -0,0 +1,49 @@
+class Account::SubscriptionsController < ApplicationController
+  include StripeUnreachable
+
+  before_action :ensure_admin
+  before_action :set_plan, only: :create
+
+  # Stripe Checkout returns here once the customer has paid. The subscription itself
+  # arrives through Stripe's webhooks (see Stripe::WebhooksController).
+  def show
+    redirect_to main_app.account_settings_path, notice: "Thanks for upgrading! Your new plan will be ready in a moment."
+  end
+
+  def create
+    if Current.account.subscribed?
+      redirect_to saas.account_billing_portal_path(plan_key: @plan.key, script_name: Current.account.slug)
+    else
+      checkout = Stripe::Checkout::Session.create(checkout_params)
+      redirect_to checkout.url, allow_other_host: true, status: :see_other
+    end
+  end
+
+  private
+    def set_plan
+      @plan = Plan.find(params[:plan_key])&.then { |plan| plan if plan.paid? } || Plan.unlimited
+    end
+
+    def checkout_params
+      metadata = { account_id: Current.account.id, plan_key: @plan.key }
+
+      {
+        mode: "subscription",
+        line_items: [ { price: @plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: metadata,
+        subscription_data: { metadata: metadata },
+        allow_promotion_codes: true,
+        success_url: "#{saas.account_subscription_url(script_name: Current.account.slug)}?session_id={CHECKOUT_SESSION_ID}",
+        cancel_url: main_app.account_settings_url
+      }.merge(customer_params)
+    end
+
+    def customer_params
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        { customer: customer_id }
+      else
+        { customer_email: Current.identity.email_address }
+      end
+    end
+end
