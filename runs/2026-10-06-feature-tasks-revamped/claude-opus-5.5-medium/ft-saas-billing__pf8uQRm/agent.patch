diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..0fce398
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,67 @@
+class Stripe::WebhooksController < ApplicationController
+  SUBSCRIPTION_EVENTS = %w[
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+    customer.subscription.paused
+    customer.subscription.resumed
+  ]
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    if event = verified_event
+      process_event(event)
+      head :ok
+    else
+      head :bad_request
+    end
+  end
+
+  private
+    def verified_event
+      Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], webhook_secret)
+    rescue JSON::ParserError, Stripe::SignatureVerificationError, TypeError
+      nil
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+
+    def process_event(event)
+      case event.type
+      when "checkout.session.completed"
+        record_checkout(event.data.object)
+      when *SUBSCRIPTION_EVENTS
+        sync_subscription(event.data.object)
+      end
+    end
+
+    def record_checkout(checkout)
+      if checkout[:mode] == "subscription" && (account = account_for(checkout))
+        (account.subscription || account.build_subscription).record_checkout(checkout)
+      end
+    end
+
+    def sync_subscription(stripe_subscription)
+      subscription = Account::Subscription.find_for_stripe \
+        subscription_id: stripe_subscription[:id],
+        customer_id: id_of(stripe_subscription[:customer]),
+        account_id: stripe_subscription[:metadata]&.[](:account_id)
+
+      subscription ||= account_for(stripe_subscription)&.then { |account| account.subscription || account.build_subscription }
+      subscription&.sync_with(stripe_subscription)
+    end
+
+    def account_for(stripe_object)
+      account_id = stripe_object[:client_reference_id].presence || stripe_object[:metadata]&.[](:account_id)
+      Account.find_by(id: account_id) if account_id.present?
+    end
+
+    def id_of(object)
+      object.is_a?(String) ? object : object&.[](:id)
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
