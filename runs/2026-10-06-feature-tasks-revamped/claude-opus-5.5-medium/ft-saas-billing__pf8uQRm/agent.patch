+        <h2 class="divider">Plan</h2>
+      </header>
+
+      <dl class="txt-align-start">
+        <dt class="txt-x-small txt-ink-medium">Plan</dt>
+        <dd><%= plan.name %><%= " (comped)" if @account.comped? %></dd>
+        <% if subscription = @account.subscription %>
+          <dt class="txt-x-small txt-ink-medium">Subscription</dt>
+          <dd>
