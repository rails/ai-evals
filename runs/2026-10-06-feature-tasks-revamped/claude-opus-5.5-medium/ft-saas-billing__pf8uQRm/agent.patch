+      <% end %>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage</h2>
+        <div>Overridden figures replace the measured ones when enforcing the plan’s limits.</div>
+      </header>
+
+      <dl class="txt-align-start">
+        <dt class="txt-x-small txt-ink-medium">Cards</dt>
+        <dd>
+          <strong><%= number_with_delimiter(@account.billed_cards_count) %></strong>
+          <%= plan.limit_cards? ? "of #{number_with_delimiter(plan.card_limit)}" : "(unlimited)" %>
+          <%= "• overridden, measured #{number_with_delimiter(@account.cards_count)}" if overrides&.card_count %>
+        </dd>
+        <dt class="txt-x-small txt-ink-medium">Storage</dt>
+        <dd>
+          <strong><%= number_to_human_size(@account.billed_bytes_used) %></strong>
+          of <%= number_to_human_size(@account.storage_limit) %>
+          <%= "• overridden, measured #{number_to_human_size(@account.bytes_used)}" if overrides&.bytes_used %>
+        </dd>
+      </dl>
+
+      <%= form_with url: saas.admin_account_overridden_limits_path(@account), scope: :overridden_limits, method: :post, class: "flex flex-column gap-half txt-align-start" do |form| %>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: overrides&.card_count, min: 0, class: "input" %>
+
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: overrides&.bytes_used, min: 0, class: "input" %>
+
+        <%= form.submit "Override", class: "btn btn--link" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn", disabled: overrides.nil? %>
+    </section>
+  </div>
+</section>
