+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    integration_session.default_url_options[:script_name] = ""
+    @account = accounts(:initech)
+  end
+
+  test "override and reset" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1000", bytes_used: "" } } }
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_equal 1_000, @account.reload.billed_cards_count
+    assert_nil @account.overridden_limits.bytes_used
+    assert @account.card_limit_reached?
+
+    untenanted { patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "", bytes_used: "2147483648" } } }
+    assert_equal 2.gigabytes, @account.reload.billed_bytes_used
+    assert_equal @account.cards_count, @account.billed_cards_count
+
+    untenanted { delete saas.admin_account_overridden_limits_path(@account) }
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "invalid figures are reported" do
+    sign_in_as :david
+
+    untenanted { post saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "-5" } } }
+
+    assert_redirected_to saas.admin_account_path(@account)
+    assert_match(/Card count/, flash[:alert])
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "non-staff cannot override" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1" } } }
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limits
+  end
+end
