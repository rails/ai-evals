+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admins see their plan and Upgrade" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#billing" do
+      assert_select "strong", text: "Free"
+      assert_select "button", text: "Upgrade"
+      assert_select "button", text: "Upgrade to Unlimited+"
+      assert_select "a", text: "Manage billing", count: 0
+    end
+  end
+
+  test "paid admins can move up to Unlimited+ and manage billing" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_select "#billing" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "button", text: "Upgrade", count: 0
+      assert_select "button", text: "Upgrade to Unlimited+"
+      assert_select "a[href='#{@account.slug}/account/billing_portal']", text: "Manage billing"
+    end
+  end
+
+  test "members don't see billing" do
+    users(:mike).update_column(:role, "member")
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..7cd503a
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+  end
+
+  test "upgrading sends admins to Stripe Checkout for the plan" do
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:client_reference_id] == @account.id &&
+        params[:metadata][:plan_key] == :monthly_extra_storage_v1 &&
+        params[:customer_email] == "mike@37signals.com" &&
+        params[:success_url] == "http://www.example.com#{@account.slug}/account/subscription?session_id={CHECKOUT_SESSION_ID}" &&
+        params[:cancel_url] == "http://www.example.com#{@account.slug}/account/settings"
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test"
+  end
+
+  test "upgrading defaults to Unlimited and reuses a known Stripe customer" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "canceled", stripe_customer_id: "cus_old")
+
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items].first[:price] == Plan.unlimited.stripe_price_id && params[:customer] == "cus_old" && !params.key?(:customer_email)
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test"))
+
+    post saas.account_subscription_path(script_name: @account.slug)
+
+    assert_response :see_other
+  end
+
+  test "subscribed accounts change plans in the billing portal" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan_key: "monthly_extra_storage_v1" }
+
+    assert_redirected_to saas.account_billing_portal_path(plan_key: "monthly_extra_storage_v1", script_name: @account.slug)
+  end
+
+  test "members cannot upgrade" do
+    users(:mike).update_column(:role, "member")
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug)
+
+    assert_response :forbidden
+  end
+
+  test "Stripe being unreachable is reported in settings" do
+    Stripe::Checkout::Session.expects(:create).raises(Stripe::APIConnectionError.new("down"))
+
+    post saas.account_subscription_path(script_name: @account.slug)
+
+    assert_redirected_to "http://www.example.com#{@account.slug}/account/settings"
+    assert_match(/couldn’t reach/, flash[:alert])
+  end
+
+  test "returning from checkout lands in settings" do
+    get saas.account_subscription_path(session_id: "cs_test", script_name: @account.slug)
+
+    assert_redirected_to "http://www.example.com#{@account.slug}/account/settings"
+    assert_match(/Thanks for upgrading/, flash[:notice])
+  end
+end
