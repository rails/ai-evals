+      <% if @page.records.empty? %>
+        <li class="txt-ink-medium margin-block-start-half">No accounts found.</li>
+      <% end %>
+    </ul>
+
+    <% unless @page.last? %>
+      <%= link_to "Next page", saas.admin_accounts_path(q: params[:q].presence, page: @page.next_param), class: "btn txt-small center" %>
+    <% end %>
+  </div>
+</section>
