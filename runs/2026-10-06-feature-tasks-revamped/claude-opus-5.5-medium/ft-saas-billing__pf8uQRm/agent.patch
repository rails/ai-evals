@@ -0,0 +1,50 @@
+<% account = Current.account %>
+<% plan = account.plan %>
+
+<section class="settings__section" id="billing">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= plan.name %></strong> plan<%= ", courtesy of 37signals" if account.comped? && !account.subscribed? %>:
+      <%= plan.limit_cards? ? "#{number_with_delimiter(plan.card_limit)} cards" : "unlimited cards" %>
+      and <%= number_to_human_size(account.storage_limit) %> of storage<%= ", $#{plan.price}/month" if plan.paid? && account.subscribed? %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented margin-block-half txt-small">
+    <li>
+      <strong><%= number_with_delimiter(account.billed_cards_count) %></strong>
+      <%= plan.limit_cards? ? "of #{number_with_delimiter(plan.card_limit)} cards used" : "cards" %>
+      <% if account.nearing_card_limit? %>
+        (<%= pluralize(account.remaining_cards_count, "card") %> left)
+      <% end %>
+    </li>
+    <li><strong><%= number_to_human_size(account.billed_bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage used</li>
+    <% if account.active_subscription&.ending? %>
+      <li>Your <%= plan.name %> plan ends on <%= account.active_subscription.cancel_at.to_date.to_fs(:long) %>.</li>
+    <% elsif account.subscription&.past_due? %>
+      <li class="txt-negative">We couldn’t collect your last payment. Please update your billing details.</li>
+    <% end %>
+  </ul>
+
+  <div class="flex gap-half flex-wrap justify-center">
+    <% if plan.free? %>
+      <%= render "account/subscriptions/upgrade", plan: Plan.unlimited, label: "Upgrade" %>
+    <% end %>
+
+    <% if plan.storage_limit < Plan.unlimited_plus.storage_limit %>
+      <%= render "account/subscriptions/upgrade", plan: Plan.unlimited_plus, label: "Upgrade to #{Plan.unlimited_plus.name}", css: "btn settings-subscription__button" %>
+    <% end %>
+
+    <% if account.subscription&.stripe_customer_id.present? %>
+      <%= link_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn", data: { turbo: false } %>
+    <% end %>
+  </div>
+
+  <% if plan.free? %>
+    <p class="txt-small txt-ink-medium">
+      <%= Plan.unlimited.name %>: unlimited cards, <%= number_to_human_size(Plan.unlimited.storage_limit) %> of storage, $<%= Plan.unlimited.price %>/month.
+      <%= Plan.unlimited_plus.name %>: unlimited cards, <%= number_to_human_size(Plan.unlimited_plus.storage_limit) %> of storage, $<%= Plan.unlimited_plus.price %>/month.
+    </p>
+  <% end %>
+</section>
