diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..69624c7
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  SECRET = "whsec_test"
+
+  setup do
+    @account = accounts(:initech)
+    @previous_secret, ENV["STRIPE_WEBHOOK_SECRET"] = ENV["STRIPE_WEBHOOK_SECRET"], SECRET
+    @previous_price, ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"], "price_plus"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous_secret
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = @previous_price
+  end
+
+  test "rejects unsigned and badly signed payloads" do
+    untenanted { post "/stripe/webhooks", params: event_json("customer.subscription.updated", subscription), headers: { "Stripe-Signature" => "t=1,v1=nope" } }
+    assert_response :bad_request
+
+    untenanted { post "/stripe/webhooks", params: "{}" }
+    assert_response :bad_request
+  end
+
+  test "a completed checkout subscribes the account" do
+    Stripe::Subscription.expects(:retrieve).with("sub_1").returns(Stripe::Subscription.construct_from(subscription))
+
+    deliver "checkout.session.completed", mode: "subscription", client_reference_id: @account.id, customer: "cus_1",
+      subscription: "sub_1", payment_status: "paid", metadata: { plan_key: "monthly_v1" }
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal [ "cus_1", "sub_1", "active" ], [ subscription.stripe_customer_id, subscription.stripe_subscription_id, subscription.status ]
+    assert_equal Plan.unlimited_plus, @account.plan, "the price on the subscription wins over the checkout's metadata"
+    assert_equal Time.at(1_900_000_000), subscription.current_period_end
+  end
+
+  test "a completed checkout still subscribes when Stripe can't be asked for details" do
+    Stripe::Subscription.expects(:retrieve).raises(Stripe::APIConnectionError.new("down"))
+
+    deliver "checkout.session.completed", mode: "subscription", client_reference_id: @account.id, customer: "cus_1",
+      subscription: "sub_1", payment_status: "paid", metadata: { plan_key: "monthly_v1" }
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+  end
+
+  test "subscription events arriving before checkout completes create the subscription" do
+    deliver "customer.subscription.created", subscription
+
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+  end
+
+  test "subscription updates change the plan and status" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    deliver "customer.subscription.updated", subscription(status: "past_due", cancel_at: 1_950_000_000)
+
+    subscription = @account.reload.subscription
+    assert_equal "past_due", subscription.status
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert subscription.ending?
+  end
+
+  test "deleted subscriptions put the account back on Free" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    deliver "customer.subscription.deleted", subscription(status: "canceled")
+
+    assert_equal "canceled", @account.reload.subscription.status
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "unknown events and strangers are acknowledged and ignored" do
+    deliver "invoice.paid", id: "in_1"
+    assert_response :ok
+
+    deliver "customer.subscription.updated", subscription(customer: "cus_unknown", metadata: {})
+    assert_response :ok
+    assert_nil @account.reload.subscription
+  end
+
+  private
+    def subscription(status: "active", cancel_at: nil, customer: "cus_1", metadata: { account_id: accounts(:initech).id })
+      { id: "sub_1", object: "subscription", customer: customer, status: status, cancel_at: cancel_at, cancel_at_period_end: false, metadata: metadata,
+        items: { object: "list", data: [ { id: "si_1", price: { id: "price_plus" }, current_period_end: 1_900_000_000 } ] } }
+    end
+
+    def deliver(type, object)
+      payload = event_json(type, object)
+      signature = Stripe::Webhook::Signature.generate_header(Time.now, Stripe::Webhook::Signature.compute_signature(Time.now, payload, SECRET))
+
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "Stripe-Signature" => signature, "Content-Type" => "application/json" }
+      end
+    end
+
+    def event_json(type, object)
+      { id: "evt_#{SecureRandom.hex(4)}", object: "event", type: type, data: { object: object } }.to_json
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..ba63d8d
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts are on the free plan by default" do
+    assert_equal Plan.free, @account.plan
+    assert_not @account.subscribed?
+  end
+
+  test "an active subscription brings its plan" do
+    subscribe plan_key: "monthly_extra_storage_v1", status: "active"
+
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert @account.subscribed?
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "past due subscriptions keep their plan while Stripe retries" do
+    subscribe status: "past_due"
+
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "canceled and incomplete subscriptions fall back to free" do
+    subscribe status: "canceled"
+    assert_equal Plan.free, @account.reload.plan
+
+    @account.subscription.update!(status: "incomplete")
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "comp and uncomp" do
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.unlimited, @account.plan
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "cancelling the account ends the subscription at the period end and reactivating resumes it" do
+    subscribe status: "active"
+
+    Stripe::Subscription.expects(:update).with("sub_123", { cancel_at_period_end: true })
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:update).with("sub_123", { cancel_at_period_end: false })
+    @account.reactivate
+  end
+
+  test "incinerating the account cancels the subscription" do
+    subscribe status: "active"
+
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+    @account.incinerate
+  end
+
+  private
+    def subscribe(plan_key: "monthly_v1", status: "active")
+      @account.create_subscription!(plan_key: plan_key, status: status, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+    end
+end
diff --git a/saas/test/models/account/limited_test.rb b/saas/test/models/account/limited_test.rb
new file mode 100644
index 0000000..9c02955
--- /dev/null
+++ b/saas/test/models/account/limited_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::LimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts run out of cards at the limit" do
+    @account.update_column(:cards_count, 999)
+    assert_not @account.card_limit_reached?
+    assert_equal 1, @account.remaining_cards_count
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.card_limit_reached?
+    assert_equal 0, @account.remaining_cards_count
+
+    @account.update_column(:cards_count, 1_200)
+    assert @account.card_limit_reached?
+    assert_equal 0, @account.remaining_cards_count
+  end
+
+  test "nearing the card limit from 100 cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.remaining_cards_count
+
+    @account.update_column(:cards_count, 1_000)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid and comped accounts have no card limit" do
+    @account.update_column(:cards_count, 5_000)
+    @account.comp
+
+    assert_not @account.card_limit_reached?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "overridden limits replace the measured usage" do
+    Account.any_instance.stubs(:bytes_used).returns(10.megabytes)
+    @account.update_column(:cards_count, 10)
+
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, @account.billed_cards_count
+    assert @account.card_limit_reached?
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+
+    assert_nil @account.overridden_limits
+    assert_equal 10, @account.billed_cards_count
+    assert_not @account.card_limit_reached?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "overriding only one figure leaves the other measured" do
+    @account.update_column(:cards_count, 10)
+    @account.override_limits(bytes_used: 5)
+
+    assert_equal 10, @account.billed_cards_count
+    assert_equal 5, @account.billed_bytes_used
+  end
+
+  test "storage allowance follows the plan" do
+    Account.any_instance.stubs(:bytes_used).returns(2.gigabytes)
+    assert @account.exceeding_storage_limit?
+
+    @account.comp
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "storage exceptions can raise but not lower the plan's allowance" do
+    @account.comp
+    @account.add_storage_exception(2.gigabytes)
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.add_storage_exception(50.gigabytes)
+    assert_equal 50.gigabytes, @account.storage_limit
+  end
+end
