diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..f02e349
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,102 @@
+class Account::Subscription < SaasRecord
+  # Stripe keeps retrying payment while a subscription is past due, so the plan stays in force.
+  ACTIVE_STATUSES = %w[ active trialing past_due ]
+
+  belongs_to :account
+
+  enum :status, %w[ incomplete incomplete_expired trialing active past_due canceled unpaid paused ].index_by(&:itself), validate: { allow_nil: true }
+
+  validates :plan_key, inclusion: { in: Plan::PLANS.keys.map(&:to_s) }
+  validates :stripe_customer_id, presence: true
+
+  class << self
+    def find_for_stripe(subscription_id: nil, customer_id: nil, account_id: nil)
+      (subscription_id.presence && find_by(stripe_subscription_id: subscription_id)) ||
+        (customer_id.presence && find_by(stripe_customer_id: customer_id)) ||
+        (account_id.presence && find_by(account_id: account_id))
+    end
+  end
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def ending?
+    active? && cancel_at.present?
+  end
+
+  # Records a completed Stripe Checkout session.
+  def record_checkout(checkout)
+    self.stripe_customer_id = id_of(checkout[:customer]) || stripe_customer_id
+    self.plan_key = paid_plan_key_for(metadata: checkout[:metadata]) || plan_key || Plan.unlimited.key.to_s
+
+    if (stripe_subscription = checkout[:subscription]).is_a?(String)
+      self.stripe_subscription_id = stripe_subscription
+      self.status = "active" if checkout[:payment_status].in?(%w[ paid no_payment_required ])
+      save!
+      refresh_from_stripe
+    else
+      sync_with stripe_subscription
+    end
+  end
+
+  # Mirrors a Stripe subscription, as delivered by a webhook or fetched from the API.
+  def sync_with(stripe_subscription)
+    item = stripe_subscription[:items]&.[](:data)&.first
+    period_end = stripe_subscription[:current_period_end] || item&.[](:current_period_end)
+
+    update!(
+      stripe_subscription_id: stripe_subscription[:id],
+      stripe_customer_id: id_of(stripe_subscription[:customer]) || stripe_customer_id,
+      status: stripe_subscription[:status],
+      plan_key: paid_plan_key_for(price: item&.[](:price), metadata: stripe_subscription[:metadata]) || plan_key || Plan.unlimited.key.to_s,
+      current_period_end: time_at(period_end),
+      cancel_at: time_at(stripe_subscription[:cancel_at] || (period_end if stripe_subscription[:cancel_at_period_end]))
+    )
+  end
+
+  def refresh_from_stripe
+    sync_with Stripe::Subscription.retrieve(stripe_subscription_id) if stripe_subscription_id.present?
+  rescue Stripe::StripeError => error
+    Rails.logger.warn "Couldn't refresh subscription #{stripe_subscription_id} from Stripe: #{error.message}"
+  end
+
+  def cancel_at_period_end
+    update_on_stripe cancel_at_period_end: true
+  end
+
+  def resume
+    update_on_stripe cancel_at_period_end: false
+  end
+
+  def cancel
+    if stripe_subscription_id.present? && !canceled?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+      update!(status: :canceled)
+    end
+  end
+
+  private
+    def paid_plan_key_for(price: nil, metadata: nil)
+      plan = Plan.find_by_stripe_price_id(id_of(price)) || Plan.find(metadata&.[](:plan_key))
+      plan.key.to_s if plan&.paid?
+    end
+
+    def id_of(object)
+      object.is_a?(String) ? object : object&.[](:id)
+    end
+
+    def time_at(epoch)
+      Time.at(epoch) if epoch.is_a?(Integer)
+    end
+
+    def update_on_stripe(attributes)
+      if stripe_subscription_id.present? && active?
+        Stripe::Subscription.update(stripe_subscription_id, attributes)
+      end
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..8cd1647
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,75 @@
+class Plan
+  PLANS = {
+    free_v1: { name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+    monthly_v1: { name: "Unlimited", price: 20, card_limit: Float::INFINITY, storage_limit: 5.gigabytes },
+    monthly_extra_storage_v1: { name: "Unlimited+", price: 25, card_limit: Float::INFINITY, storage_limit: 500.gigabytes }
+  }
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  class << self
+    def all
+      @all ||= PLANS.map { |key, properties| new(key: key, **properties) }
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key.to_s == key.to_s }
+    end
+    alias_method :[], :find
+
+    def find_by_stripe_price_id(price_id)
+      all.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id } if price_id.present?
+    end
+
+    def free
+      find(:free_v1)
+    end
+
+    def unlimited
+      find(:monthly_v1)
+    end
+
+    def unlimited_plus
+      find(:monthly_extra_storage_v1)
+    end
+  end
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:)
+    @key, @name, @price, @card_limit, @storage_limit = key, name, price, card_limit, storage_limit
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def limit_cards?
+    card_limit.finite?
+  end
+
+  # Price IDs differ per Stripe environment, so they come from the environment:
+  # STRIPE_MONTHLY_V1_PRICE_ID, STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID.
+  def stripe_price_id
+    ENV["STRIPE_#{key.to_s.upcase}_PRICE_ID"] unless free?
+  end
+
+  def to_param
+    key.to_s
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+end
diff --git a/saas/app/views/account/settings/_billing.html.erb b/saas/app/views/account/settings/_billing.html.erb
