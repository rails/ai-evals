+      <%= form.search_field :q, value: params[:q], class: "input flex-item-grow", placeholder: "Name or account ID…", aria: { label: "Search accounts" } %>
+      <%= form.submit "Search", class: "btn", name: nil %>
+    <% end %>
+
+    <ul class="margin-block-half">
+      <% @page.records.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half">
