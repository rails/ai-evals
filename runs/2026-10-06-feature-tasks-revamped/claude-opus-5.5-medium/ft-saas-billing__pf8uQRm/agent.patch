@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::BillingPortalsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+  end
+
+  test "admins go to the Stripe customer portal" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:customer] == "cus_1" && params[:return_url] == "http://www.example.com#{@account.slug}/account/settings" && !params.key?(:flow_data)
+    end.returns(stub(url: "https://billing.stripe.com/p/session/test"))
+
+    get saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test"
+  end
+
+  test "plan changes open the portal's update flow" do
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:flow_data] == { type: "subscription_update", subscription: "sub_1" }
+    end.returns(stub(url: "https://billing.stripe.com/p/session/test"))
+
+    get saas.account_billing_portal_path(plan_key: "monthly_extra_storage_v1", script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test"
+  end
+
+  test "accounts that never paid have no portal" do
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    get saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "http://www.example.com#{@account.slug}/account/settings"
+  end
+end
