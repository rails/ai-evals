@@ -0,0 +1,68 @@
+# Activities
+
+Activities are the events shown in the account's activity timeline: cards being added, assigned, moved, renamed, closed, reopened, postponed or triaged, and comments being posted.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated, flat list of activity across the boards the current user can access, newest first.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | array | No | Only include activity performed by these users |
+| `board_ids[]` | array | No | Only include activity on these boards |
+
+The following actions are returned: `card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage` and `comment_created`.
+
+Each event includes:
+
+- `description` – the plain-text description of the event, as shown in the timeline
+- `url` – opens the card. For comment events it opens the card and jumps to the comment
+- `eventable_type` – `Card` or `Comment`
+- `eventable` – the [card](cards.md) or [comment](comments.md) the event refers to
+- `board` – the [board](boards.md) the event happened on
+- `creator` – the [user](users.md) who performed the action
+- `particulars` – event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other events return an empty `particulars` object. Missing board, title or column values are returned as empty strings.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_title_changed",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David renamed &quot;Layout is broken&quot; (was: &quot;Layout bug&quot;)",
+    "particulars": {
+      "old_title": "Layout bug",
+      "new_title": "Layout is broken"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "...": "..."
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Writebook",
+      "...": "..."
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "...": "..."
+    }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b9da21a
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of activity, newest first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    times = body.map { |event| Time.iso8601(event["created_at"]) }
+    assert_equal times.sort.reverse, times
+
+    event = body.first
+    %w[ id action created_at description particulars url eventable_type eventable board creator ].each do |key|
+      assert event.key?(key), "expected #{key}"
+    end
+  end
+
+  test "includes comment events with an anchored url" do
+    get activities_path, as: :json
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    comment = events(:layout_commented).eventable
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+    assert_equal({}, event["particulars"])
+  end
+
+  test "particulars for assignment, title, board and triage events" do
+    card = cards(:logo)
+    with_current_user(:kevin) do
+      card.update!(title: "Renamed logo")
+      card.toggle_assignment(users(:jz))
+    end
+
+    get activities_path, as: :json
+    body = @response.parsed_body
+
+    title = body.find { |e| e["action"] == "card_title_changed" }
+    assert_equal "Renamed logo", title.dig("particulars", "new_title")
+    assert_equal card_url(card), title["url"]
+    assert_equal Event.find(title["id"]).description_for(users(:kevin)).to_plain_text, title["description"]
+
+    assigned = body.find { |e| e["action"] == "card_assigned" }
+    assert_kind_of Array, assigned.dig("particulars", "assignee_ids")
+  end
+
+  test "omits collection changed events" do
+    Event.create!(action: "card_collection_changed", board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo), particulars: { particulars: { new_collection: "X" } })
+
+    get activities_path, as: :json
+    assert @response.parsed_body.none? { |e| e["action"] == "card_collection_changed" }
+  end
+
+  test "filters by creator and board" do
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+    assert @response.parsed_body.all? { |e| e.dig("creator", "id") == users(:jz).id }
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+    assert @response.parsed_body.all? { |e| e.dig("board", "id") == boards(:private).id }
+  end
+
+  test "does not include inaccessible boards" do
+    logout_and_sign_in_as :jz
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+end
+
+class ActivitiesControllerMoreTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as :kevin }
+
+  test "board change and triage particulars, blank when missing" do
+    board, card = boards(:writebook), cards(:logo)
+    moved = Event.create!(action: "card_board_changed", board:, creator: users(:kevin), eventable: card, particulars: { particulars: { old_board: "A", new_board: "B" } })
+    triaged = Event.create!(action: "card_triaged", board:, creator: users(:kevin), eventable: card, particulars: { particulars: { column: "Doing" } })
+    blank = Event.create!(action: "card_triaged", board:, creator: users(:kevin), eventable: card, particulars: {})
+
+    get activities_path, as: :json
+    body = @response.parsed_body.index_by { |e| e["id"] }
+
+    assert_equal({ "old_board" => "A", "new_board" => "B" }, body[moved.id]["particulars"])
+    assert_equal({ "column" => "Doing" }, body[triaged.id]["particulars"])
+    assert_equal({ "column" => "" }, body[blank.id]["particulars"])
+  end
+
+  test "paginates" do
+    60.times { Event.create!(action: "card_published", board: boards(:writebook), creator: users(:kevin), eventable: cards(:logo)) }
+    expected = users(:kevin).activity.map(&:id)
+
+    ids, next_page = [], activities_path(format: :json)
+    while next_page
+      get next_page, as: :json
+      ids.concat @response.parsed_body.map { |e| e["id"] }
+      url = @response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = url && URI.parse(url).request_uri
+    end
+
+    assert_equal expected, ids
+  end
+end
