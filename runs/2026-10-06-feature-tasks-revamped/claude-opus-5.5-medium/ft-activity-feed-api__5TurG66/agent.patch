+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from Current.user.activity(**activity_filter_params)
+      end
+    end
+  end
+
+  private
+    def activity_filter_params
+      params.permit(creator_ids: [], board_ids: []).to_h.symbolize_keys
+    end
+end
