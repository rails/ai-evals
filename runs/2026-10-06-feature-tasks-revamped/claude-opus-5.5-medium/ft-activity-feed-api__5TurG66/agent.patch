diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..9a85d11 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def exposed_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: action_particular(:old_board), new_board: action_particular(:new_board) }
+    when "card_title_changed"
+      { old_title: action_particular(:old_title), new_title: action_particular(:new_title) }
+    when "card_triaged"
+      { column: action_particular(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def action_particular(key)
+      particulars.to_h.fetch("particulars", nil).to_h[key.to_s].to_s
+    end
 end
