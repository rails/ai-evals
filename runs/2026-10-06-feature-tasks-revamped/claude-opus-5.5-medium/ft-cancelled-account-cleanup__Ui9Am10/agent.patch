diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7ee6b34
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @other_account = accounts(:initech)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: users(:david))
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(@other_account.id)
+    assert_empty leftover_rows_for(@account)
+  end
+
+  test "keeps accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: users(:david))
+
+    travel 29.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps reactivated accounts" do
+    @account.cancel(initiated_by: users(:david))
+    @account.reactivate
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  private
+    def leftover_rows_for(account)
+      connection = ActiveRecord::Base.connection
+
+      connection.tables.select { |table| connection.columns(table).any? { it.name == "account_id" } }.filter_map do |table|
+        count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id)}").to_i
+        [ table, count ] if count > 0
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..7b21d76
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "due_for_incineration includes accounts cancelled beyond the grace period" do
+    @account.cancel(initiated_by: users(:david))
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.minute do
+      assert_includes Account.due_for_incineration, @account
+      assert @account.due_for_incineration?
+      assert_not_includes Account.due_for_incineration, accounts(:initech)
+    end
+  end
+
+  test "incinerate destroys the account and its data" do
+    user_ids = @account.users.ids
+    board_ids = @account.boards.ids
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(id: user_ids)
+    assert_empty Board.where(id: board_ids)
+  end
+end
