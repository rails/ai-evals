+  # table => [ type column, id column, { type => parent table } ]
+  # A parent table of :accounts means the parent *is* the account.
+  POLYMORPHIC_TABLES = {
+    entropies: [ :container_type, :container_id, { "Account" => :accounts, "Board" => :boards } ],
+    storage_totals: [ :owner_type, :owner_id, { "Account" => :accounts, "Board" => :boards } ],
+    mentions: [ :source_type, :source_id, { "Card" => :cards, "Comment" => :comments } ],
+    reactions: [ :reactable_type, :reactable_id, { "Card" => :cards, "Comment" => :comments } ],
+    action_text_rich_texts: [ :record_type, :record_id, { "Board" => :boards, "Card" => :cards, "Comment" => :comments } ],
+    active_storage_attachments: [ :record_type, :record_id, {
+      "ActionText::RichText" => :action_text_rich_texts,
+      "Account::Import" => :account_imports,
+      "Board" => :boards,
+      "Card" => :cards,
+      "Comment" => :comments,
+      "Export" => :exports,
+      "User" => :users
