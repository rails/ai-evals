+        WHERE account_id IS NULL#{" AND #{where}" if where}
+      SQL
+    end
+
+    def backfill_polymorphic(table, from:, type_column:, type:, via:)
+      if from == :accounts
+        execute "UPDATE #{table} SET account_id = #{via} WHERE account_id IS NULL AND #{type_column} = #{quote(type)}"
+      else
+        backfill table, from: from, via: via, where: "#{type_column} = #{quote(type)}"
+      end
+    end
+
+    # A blob takes the account of its attachments. Unattached blobs are orphans.
+    def backfill_blobs
