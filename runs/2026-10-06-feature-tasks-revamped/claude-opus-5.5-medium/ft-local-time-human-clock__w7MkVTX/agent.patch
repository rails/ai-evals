diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..14562db 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,18 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw UTC timestamp. The local-time
+  # Stimulus controller turns it into words in the viewer's timezone, which keeps
+  # the markup the same for everyone (and so safe to cache and share).
+  #
+  # Styles: :time, :date, :shortdate, :weekday, :datetime, :ago, :indays, :relative.
+  # See app/javascript/helpers/local_time_helpers.js for what each looks like.
+  def local_datetime_tag(datetime, style: :datetime, **attributes)
+    data = attributes.delete(:data) || {}
+
+    tag.time **attributes, datetime: datetime.utc.iso8601, data: {
+      **data,
+      controller: token_list("local-time", data[:controller]),
+      action: token_list("turbo:morph-element->local-time#render", data[:action]),
+      local_time_style_value: style
+    }
+  end
 end
