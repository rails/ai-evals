diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..605814a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatFullLocalTime, isRelativeStyle } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Renders a server-provided timestamp (`<time datetime="...">`) as words in the
+// viewer's timezone, so the HTML we send is the same for everyone and can be
+// cached and shared.
+export default class extends Controller {
+  static values = { style: { type: String, default: "datetime" } }
+
+  connect() {
+    this.render()
+    if (isRelativeStyle(this.styleValue)) refreshing.add(this)
+  }
+
+  disconnect() {
+    refreshing.delete(this)
+  }
+
+  // Also invoked on `turbo:morph-element`: morphing restores the server-rendered
+  // (empty) content without reconnecting the controller.
+  render() {
+    const date = this.#date
+
+    if (date) {
+      const text = formatLocalTime(date, this.styleValue)
+      this.element.title = formatFullLocalTime(date)
+
+      if (this.element.textContent !== text) {
+        this.element.textContent = text
+        this.dispatch("rendered", { detail: { text } })
+      }
+    }
+  }
+
+  get #date() {
+    const date = new Date(this.element.getAttribute("datetime"))
+    return isNaN(date) ? null : date
+  }
+}
+
+const refreshing = new Set()
+
+setInterval(() => {
+  refreshing.forEach(controller => controller.render())
+}, REFRESH_INTERVAL)
