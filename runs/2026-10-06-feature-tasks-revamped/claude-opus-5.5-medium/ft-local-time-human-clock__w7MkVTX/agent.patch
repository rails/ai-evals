--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag renders the raw UTC timestamp for the browser to format" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    Time.use_zone("Tokyo") do
+      render html: local_datetime_tag(time.in_time_zone, style: :relative)
+    end
+
+    assert_select "time[datetime='2025-09-12T13:42:00Z'][data-controller='local-time'][data-local-time-style-value='relative']", text: ""
+    assert_select "time[data-action='turbo:morph-element->local-time#render']"
+  end
+
+  test "local_datetime_tag markup doesn't depend on the server timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    tokyo = Time.use_zone("Tokyo") { local_datetime_tag(time.in_time_zone, style: :ago) }
+    chicago = Time.use_zone("America/Chicago") { local_datetime_tag(time.in_time_zone, style: :ago) }
+
+    assert_equal tokyo, chicago
+  end
+
+  test "local_datetime_tag merges extra attributes" do
+    render html: local_datetime_tag(Time.current, style: :time, class: "stamp", data: { controller: "tooltip", action: "click->tooltip#show" })
+
+    assert_select "time.stamp[data-controller='local-time tooltip'][data-action='turbo:morph-element->local-time#render click->tooltip#show']"
+  end
+end
