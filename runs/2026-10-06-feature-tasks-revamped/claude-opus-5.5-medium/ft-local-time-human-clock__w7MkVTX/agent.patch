diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c2b1209
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,119 @@
+import { signedDifferenceInDays, sameYear, timezone } from "helpers/date_helpers"
+
+const MINUTE = 60 * 1000
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+
+// Formats a timestamp in the viewer's timezone. Each style mirrors a way we
+// show times in the app:
+//
+//   time        "1:42 PM"
+//   date        "Sep 12, 2025"
+//   shortdate   "Sep 12" ("Sep 12, 2024" outside the current year)
+//   weekday     "Monday, September 12"
+//   datetime    "9/12/25, 1:42 PM"
+//   ago         "just now", "5 minutes ago", "2 hours ago", "yesterday", "5 days ago", "3 months ago"
+//   indays      "today", "tomorrow", "in 3 days"
+//   relative    "1:42 PM" today, "yesterday", "5 days ago" this week, "Sep 12" before that
+export function formatLocalTime(date, style, now = new Date()) {
+  const formatter = FORMATTERS[style] || FORMATTERS.datetime
+  return formatter(date, now)
+}
+
+// Full, unambiguous version used as a tooltip: "Monday, September 12, 2025 at 1:42 PM"
+export function formatFullLocalTime(date) {
+  return intl({ dateStyle: "full", timeStyle: "short" }).format(date)
+}
+
+// Styles whose output depends on the current time and needs refreshing.
+export function isRelativeStyle(style) {
+  return RELATIVE_STYLES.includes(style)
+}
+
+const RELATIVE_STYLES = [ "shortdate", "ago", "indays", "relative" ]
+
+const FORMATTERS = {
+  time: (date) => formatTime(date),
+  date: (date) => intl({ month: "short", day: "numeric", year: "numeric" }).format(date),
+  shortdate: (date, now) => formatShortDate(date, now),
+  weekday: (date) => intl({ weekday: "long", month: "long", day: "numeric" }).format(date),
+  datetime: (date) => intl({ month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }).format(date),
+  ago: (date, now) => formatAgo(date, now),
+  indays: (date, now) => formatInDays(date, now),
+  relative: (date, now) => formatRelative(date, now)
+}
+
+function formatTime(date) {
+  return intl({ hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function formatShortDate(date, now) {
+  if (sameYear(date, now)) {
+    return intl({ month: "short", day: "numeric" }).format(date)
+  } else {
+    return intl({ month: "short", day: "numeric", year: "numeric" }).format(date)
+  }
+}
+
+function formatAgo(date, now) {
+  const elapsed = now - date
+
+  if (elapsed < MINUTE) {
+    return "just now"
+  } else if (elapsed < HOUR) {
+    return relativeTime(-Math.floor(elapsed / MINUTE), "minute")
+  } else if (elapsed < DAY) {
+    return relativeTime(-Math.floor(elapsed / HOUR), "hour")
+  } else {
+    return formatDaysAgo(Math.max(signedDifferenceInDays(date, now), 1))
+  }
+}
+
+function formatDaysAgo(days) {
+  if (days < 30) {
+    return relativeTime(-days, "day")
+  } else if (days < 365) {
+    return relativeTime(-Math.floor(days / 30), "month")
+  } else {
+    return relativeTime(-Math.floor(days / 365), "year")
+  }
+}
+
+function formatInDays(date, now) {
+  return relativeTime(Math.max(signedDifferenceInDays(now, date), 0), "day")
+}
+
+function formatRelative(date, now) {
+  const daysAgo = signedDifferenceInDays(date, now)
+
+  if (daysAgo === 0) {
+    return formatTime(date)
+  } else if (daysAgo > 0 && daysAgo < 7) {
+    return relativeTime(-daysAgo, "day")
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+function relativeTime(value, unit) {
+  return relativeTimeFormatter().format(value, unit)
+}
+
+let relativeTimeFormatterCache
+
+function relativeTimeFormatter() {
+  return relativeTimeFormatterCache ||= new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+}
+
+const intlCache = new Map()
+
+function intl(options) {
+  const currentTimezone = timezone()
+  const key = JSON.stringify([ currentTimezone, options ])
+
+  if (!intlCache.has(key)) {
+    intlCache.set(key, new Intl.DateTimeFormat("en-US", { ...options, timeZone: currentTimezone }))
+  }
+
+  return intlCache.get(key)
+}
