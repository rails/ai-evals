+class Account::CancelSubscriptionJob < ApplicationJob
+  queue_as :backend
+
+  retry_on Stripe::APIConnectionError, Stripe::RateLimitError, wait: :polynomially_longer
+
+  def perform(subscription)
+    subscription.cancel
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..6de3ffe
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,92 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_subscription_later
+  end
+
+  def plan
+    if comped?
+      Plan.comped
+    elsif active_subscription
+      active_subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def paid?
+    active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  # Queenbee pushes comp changes through this writer.
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+
+  def checkout_session_for(plan, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create \
+      mode: "subscription",
+      customer: find_or_create_stripe_customer_id,
+      client_reference_id: id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      subscription_data: { metadata: { account_id: id, plan_key: plan.key } },
+      allow_promotion_codes: true,
+      success_url: success_url,
+      cancel_url: cancel_url
+  end
+
+  def billing_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create customer: stripe_customer_id, return_url: return_url
+  end
+
+  # Checkout returns before Stripe's webhook may have landed, so pick up the
+  # new subscription right away rather than show a stale plan.
+  def complete_checkout(checkout_session_id)
+    checkout_session = Stripe::Checkout::Session.retrieve(id: checkout_session_id, expand: [ "subscription" ])
+
+    if subscription && checkout_session.customer == stripe_customer_id && checkout_session.subscription.is_a?(Stripe::Subscription)
+      subscription.sync_with(checkout_session.subscription)
+    end
+  end
+
+  private
+    def find_or_create_stripe_customer_id
+      (subscription || create_subscription!(stripe_customer_id: create_stripe_customer.id)).stripe_customer_id
+    end
+
+    def create_stripe_customer
+      Stripe::Customer.create \
+        name: name,
+        email: owner_email,
+        metadata: { account_id: id, queenbee_id: external_account_id }
+    end
+
+    def cancel_subscription_later
+      active_subscription&.cancel_later
+    end
+end
