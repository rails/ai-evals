@@ -0,0 +1,62 @@
+<% plan = account.plan %>
+
+<section class="settings__section" id="billing">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= plan.name %></strong> plan<% if account.comped? %>, courtesy of 37signals<% elsif plan.paid? %> (<%= number_to_currency(plan.price, precision: 0) %>/month)<% end %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented margin-block-half">
+    <li>
+      <% if plan.limit_cards? %>
+        <strong><%= number_with_delimiter(account.billed_cards_count) %></strong> of <%= number_with_delimiter(plan.card_limit) %> cards used
+      <% else %>
+        Unlimited cards
+      <% end %>
+    </li>
+    <li>
+      <strong><%= number_to_human_size(account.billed_bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage used
+    </li>
+    <% if (subscription = account.active_subscription) && subscription.canceling? %>
+      <li>Your plan ends on <%= subscription.cancel_at.to_date.to_fs(:long) %>.</li>
+    <% end %>
+  </ul>
+
+  <% unless account.comped? %>
+    <div class="flex gap-half justify-center">
+      <% if account.paid? %>
+        <% if plan.upgrades.any? %>
+          <%= link_to "Upgrade", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn btn--link", data: { turbo: false } %>
+        <% end %>
+      <% else %>
+        <div data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close">
+          <button type="button" class="btn btn--link" data-action="dialog#open">Upgrade</button>
+
+          <dialog class="dialog panel panel--wide shadow" data-dialog-target="dialog" style="--panel-size: 48ch;">
+            <h2 class="txt-large">Upgrade your plan</h2>
+
+            <div class="flex flex-column gap margin-block">
+              <% plan.upgrades.each do |upgrade| %>
+                <%= button_to saas.account_subscription_path(script_name: Current.account.slug), params: { plan: upgrade.key }, class: "btn full-width", form: { data: { turbo: false } } do %>
+                  <span>
+                    <strong><%= upgrade.name %></strong> · <%= number_to_currency(upgrade.price, precision: 0) %>/month ·
+                    <%= upgrade.limit_cards? ? "#{number_with_delimiter(upgrade.card_limit)} cards" : "Unlimited cards" %>,
+                    <%= number_to_human_size(upgrade.storage_limit) %> storage
+                  </span>
+                <% end %>
+              <% end %>
+            </div>
+
+            <button type="button" class="btn" data-action="dialog#close">Not now</button>
+          </dialog>
+        </div>
+      <% end %>
+
+      <% if account.stripe_customer_id %>
+        <%= link_to "Manage billing", saas.account_billing_portal_path(script_name: Current.account.slug), class: "btn", data: { turbo: false } %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
