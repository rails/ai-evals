diff --git a/saas/test/controllers/account/billing_settings_test.rb b/saas/test/controllers/account/billing_settings_test.rb
new file mode 100644
index 0000000..06b9062
--- /dev/null
+++ b/saas/test/controllers/account/billing_settings_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "#billing" do
+      assert_select "strong", text: "Free"
+      assert_select "button", text: "Upgrade"
+      assert_select "form[action='#{accounts(:initech).slug}/account/subscription'] input[name=plan][value=monthly_v1]"
+      assert_select "form[action='#{accounts(:initech).slug}/account/subscription'] input[name=plan][value=monthly_extra_storage_v1]"
+    end
+  end
+
+  test "paid admins upgrade through the billing portal" do
+    accounts(:initech).create_subscription! stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active", plan_key: "monthly_v1"
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "a[href='#{accounts(:initech).slug}/account/billing_portal']", text: "Upgrade"
+      assert_select "a[href='#{accounts(:initech).slug}/account/billing_portal']", text: "Manage billing"
+    end
+  end
+
+  test "comped accounts have nothing to buy" do
+    accounts(:initech).comp
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing", text: /courtesy of 37signals/
+    assert_select "#billing button", text: "Upgrade", count: 0
+  end
+
+  test "members don't see billing" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..35ed8ce
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+  end
+
+  test "upgrading sends admins to stripe checkout" do
+    sign_in_as :mike
+
+    Stripe::Customer.expects(:create).returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with { |params|
+      params[:customer] == "cus_new" && params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] && params[:client_reference_id] == @account.id &&
+        params[:success_url] == "http://www.example.com#{@account.slug}/account/subscription?session_id={CHECKOUT_SESSION_ID}" &&
+        params[:cancel_url] == "http://www.example.com#{@account.slug}/account/settings"
+    }.returns(Stripe::Checkout::Session.construct_from(id: "cs_1", url: "https://checkout.stripe.com/c/cs_1"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/cs_1"
+    assert_equal "cus_new", @account.reload.stripe_customer_id
+  end
+
+  test "existing customers are reused" do
+    @account.create_subscription! stripe_customer_id: "cus_old", status: "canceled"
+    sign_in_as :mike
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).with { |params| params[:customer] == "cus_old" }
+      .returns(Stripe::Checkout::Session.construct_from(id: "cs_1", url: "https://checkout.stripe.com/c/cs_1"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/cs_1"
+  end
+
+  test "unknown plans are refused" do
+    sign_in_as :mike
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "free_v1" }
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+  end
+
+  test "stripe outages are handled" do
+    sign_in_as :mike
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("unreachable"))
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_match /unavailable/, flash[:alert]
+  end
+
+  test "members can't upgrade" do
+    users(:mike).update!(role: :member)
+    sign_in_as :mike
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_v1" }
+
+    assert_response :forbidden
+  end
+
+  test "returning from checkout picks up the subscription" do
+    @account.create_subscription! stripe_customer_id: "cus_1"
+    sign_in_as :mike
+
+    stripe_subscription = Stripe::Subscription.construct_from \
+      id: "sub_1", object: "subscription", customer: "cus_1", status: "active",
+      items: { object: "list", data: [ { object: "subscription_item", current_period_end: 1.month.from_now.to_i, price: { object: "price", id: "price_unlimited", unit_amount: 2000 } } ] }
+    Stripe::Checkout::Session.expects(:retrieve).with(id: "cs_1", expand: [ "subscription" ])
+      .returns(Stripe::Checkout::Session.construct_from(id: "cs_1", object: "checkout.session", customer: "cus_1", subscription: stripe_subscription.to_hash))
+
+    get saas.account_subscription_path(script_name: @account.slug, session_id: "cs_1")
+
+    assert_redirected_to account_settings_path(script_name: @account.slug)
+    assert_equal Plan.find(:monthly_v1), @account.reload.plan
+  end
+
+  test "billing portal" do
+    @account.create_subscription! stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active", plan_key: "monthly_v1"
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).with { |params| params[:customer] == "cus_1" }
+      .returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/p/session_1"))
+
+    get saas.account_billing_portal_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session_1"
+  end
+
+  test "paid accounts asking to upgrade go to the portal" do
+    @account.create_subscription! stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active", plan_key: "monthly_v1"
+    sign_in_as :mike
+
+    post saas.account_subscription_path(script_name: @account.slug), params: { plan: "monthly_extra_storage_v1" }
+
+    assert_redirected_to saas.account_billing_portal_path(script_name: @account.slug)
+  end
+end
diff --git a/saas/test/controllers/admin/accounts/billing_waivers_controller_test.rb b/saas/test/controllers/admin/accounts/billing_waivers_controller_test.rb
