+++ b/saas/app/controllers/account/subscriptions_controller.rb
@@ -0,0 +1,47 @@
+class Account::SubscriptionsController < ApplicationController
+  before_action :ensure_admin
+  before_action :ensure_not_comped, only: :create
+  before_action :redirect_paid_accounts_to_billing_portal, only: :create
+  before_action :set_plan, only: :create
+
+  rescue_from Stripe::StripeError, with: :billing_unavailable
+
+  def create
+    checkout_session = Current.account.checkout_session_for @plan,
+      success_url: "#{saas.account_subscription_url(script_name: Current.account.slug)}?session_id={CHECKOUT_SESSION_ID}",
+      cancel_url: main_app.account_settings_url
+
+    redirect_to checkout_session.url, allow_other_host: true, status: :see_other
+  end
+
+  def show
+    if params[:session_id].present?
+      # Stripe returns here with a GET, which is otherwise served read-only.
+      ActiveRecord::Base.connected_to(role: :writing) { Current.account.complete_checkout(params[:session_id]) }
+    end
+
+    redirect_to main_app.account_settings_path, notice: "Thanks for upgrading!"
+  end
+
+  private
+    def ensure_not_comped
+      redirect_to main_app.account_settings_path, notice: "This account doesn’t need a plan" if Current.account.comped?
+    end
+
+    def redirect_paid_accounts_to_billing_portal
+      redirect_to saas.account_billing_portal_path(script_name: Current.account.slug) if Current.account.paid?
+    end
+
+    def set_plan
+      @plan = Plan.find(params[:plan])
+
+      unless @plan&.paid? && @plan.stripe_price_id.present?
+        redirect_to main_app.account_settings_path, alert: "Choose a plan to upgrade to"
+      end
+    end
+
+    def billing_unavailable(error)
+      Rails.error.report(error, handled: true)
+      redirect_to main_app.account_settings_path, alert: "Billing is unavailable right now. Please try again in a few minutes."
+    end
+end
