+require "test_helper"
+
+class Card::CardLimited::PublishingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "free accounts out of cards can't publish" do
+    accounts(:initech).update_column(:cards_count, 1_001)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "publishing through the API is refused too" do
+    accounts(:initech).update_column(:cards_count, 1_001)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug), as: :json
+
+    assert_response :forbidden
+    assert_match /Upgrade/, response.parsed_body["error"]
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "the draft that took the last card can be published" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "overridden card count is enforced" do
+    accounts(:initech).override_limits(card_count: 5_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+  end
+
+  test "paid accounts publish beyond the free limit" do
+    accounts(:initech).update_column(:cards_count, 5_000)
+    accounts(:initech).create_subscription! stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active", plan_key: "monthly_v1"
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "staff can publish past the limit" do
+    accounts(:initech).update_column(:cards_count, 1_001)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+  end
+end
