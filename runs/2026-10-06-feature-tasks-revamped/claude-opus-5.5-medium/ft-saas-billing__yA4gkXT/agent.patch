+<% upgrade = account.plan.upgrades.find { |plan| plan.storage_limit > account.storage_limit } unless account.comped? %>
+<% link_class = local_assigns[:link_class] %>
+
+<% if upgrade %>
+  <div>
+    <% if Current.user.admin? %>
+      <%= link_to "Upgrade", account_settings_path(anchor: "billing"), class: link_class %> to <%= upgrade.name %> for <%= number_to_human_size(upgrade.storage_limit) %> of storage.
