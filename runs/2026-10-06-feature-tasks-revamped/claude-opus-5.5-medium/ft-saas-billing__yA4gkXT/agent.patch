+<% @page_title = @account.name %>
+<% plan = @account.plan %>
+<% subscription = @account.subscription %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "All accounts", saas.admin_accounts_path, class: "btn" %>
+  </div>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">ID</dt>
+      <dd>#<%= @account.external_account_id %></dd>
+      <dt class="txt-x-small txt-ink-medium">Owner</dt>
+      <dd><%= @owner ? "#{@owner.name} <#{@owner.identity&.email_address}>" : "No owner" %></dd>
+      <dt class="txt-x-small txt-ink-medium">Created</dt>
+      <dd><%= @account.created_at.to_date.to_fs(:long) %> (<%= time_ago_in_words(@account.created_at) %> ago)</dd>
+      <dt class="txt-x-small txt-ink-medium">Status</dt>
+      <dd><%= @account.cancelled? ? "Cancelled" : "Active" %></dd>
+    </dl>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <dl class="margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">Plan</dt>
+      <dd><strong><%= plan.name %></strong><%= " (comped)" if @account.comped? %></dd>
+      <% if subscription %>
+        <dt class="txt-x-small txt-ink-medium">Subscription</dt>
+        <dd>
+          <%= Plan.find(subscription.plan_key)&.name || "No plan" %> · <%= subscription.status.presence || "pending" %>
+          <% if subscription.current_period_end %> · renews <%= subscription.current_period_end.to_date.to_fs(:long) %><% end %>
+          <% if subscription.cancel_at %> · ends <%= subscription.cancel_at.to_date.to_fs(:long) %><% end %>
+          <br>
+          <span class="txt-x-small txt-ink-medium">
+            Stripe customer <%= subscription.stripe_customer_id %><% if subscription.stripe_subscription_id %> · subscription <%= subscription.stripe_subscription_id %><% end %>
+          </span>
+        </dd>
+      <% end %>
+    </dl>
+
+    <div class="flex gap-half justify-center">
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn btn--link" %>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage</h2>
+      <% if @account.limits_overridden? %>
+        <div class="txt-small">Limits are enforced against the overridden figures below, not actual usage.</div>
+      <% end %>
+    </header>
+
+    <dl class="margin-block-half" style="text-align: left">
+      <dt class="txt-x-small txt-ink-medium">Cards</dt>
+      <dd>
+        <%= number_with_delimiter(@account.cards_count) %> actual
+        <% if @account.overridden_limits&.card_count %> · <strong><%= number_with_delimiter(@account.overridden_limits.card_count) %> overridden</strong><% end %>
+        · limit <%= plan.limit_cards? ? number_with_delimiter(plan.card_limit) : "unlimited" %>
+      </dd>
+      <dt class="txt-x-small txt-ink-medium">Storage</dt>
+      <dd>
+        <%= number_to_human_size(@account.bytes_used) %> actual
+        <% if @account.overridden_limits&.bytes_used %> · <strong><%= number_to_human_size(@account.overridden_limits.bytes_used) %> overridden</strong><% end %>
+        · limit <%= number_to_human_size(@account.storage_limit) %>
+      </dd>
+    </dl>
+
+    <%= form_with url: saas.admin_account_overridden_limits_path(@account), method: :patch, scope: :overridden_limits, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex gap-half">
+        <label class="flex flex-column gap-quarter flex-item-grow" style="text-align: left">
+          <span class="txt-small">Card count</span>
+          <%= form.number_field :card_count, value: @account.overridden_limits&.card_count, min: 0, class: "input" %>
+        </label>
+        <label class="flex flex-column gap-quarter flex-item-grow" style="text-align: left">
+          <span class="txt-small">Bytes used</span>
+          <%= form.number_field :bytes_used, value: @account.overridden_limits&.bytes_used, min: 0, class: "input" %>
+        </label>
+      </div>
+      <div class="txt-x-small txt-ink-medium">Leave a field blank to use the actual figure.</div>
+      <%= form.submit "Override", class: "btn btn--link" %>
+    <% end %>
+
+    <% if @account.limits_overridden? %>
+      <div class="flex justify-center margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn" %>
+      </div>
+    <% end %>
+  </div>
+</section>
