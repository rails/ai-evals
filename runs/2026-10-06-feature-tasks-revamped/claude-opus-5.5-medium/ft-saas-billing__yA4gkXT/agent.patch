@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Admin::Accounts::BillingWaiversControllerTest < ActionDispatch::IntegrationTest
+  test "comp and uncomp" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted { post saas.admin_account_billing_waiver_path(account) }
+    untenanted { assert_redirected_to saas.admin_account_path(account) }
+    assert account.reload.comped?
+
+    untenanted { get saas.admin_account_path(account) }
+    assert_select "button", text: "Uncomp"
+    assert_select "button", text: "Comp", count: 0
+
+    untenanted { delete saas.admin_account_billing_waiver_path(account) }
+    untenanted { assert_redirected_to saas.admin_account_path(account) }
+    assert_not account.reload.comped?
+  end
+
+  test "non-staff can't comp" do
+    sign_in_as :jz
+
+    untenanted { post saas.admin_account_billing_waiver_path(accounts(:"37s")) }
+
+    assert_response :forbidden
