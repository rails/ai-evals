@@ -0,0 +1,29 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: :show
+
+  def index
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from accounts_matching(@query).includes(:subscription, :billing_waiver, :cancellation).order(created_at: :desc, id: :desc), per_page: 50
+  end
+
+  def show
+    @owner = @account.users.owner.includes(:identity).first
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def accounts_matching(query)
+      if query.blank?
+        Account.all
+      elsif query.match?(/\A\d+\z/)
+        Account.where(external_account_id: query).or(Account.where("name LIKE ?", "%#{Account.sanitize_sql_like(query)}%"))
+      else
+        Account.where("name LIKE ?", "%#{Account.sanitize_sql_like(query)}%")
+      end
+    end
+end
