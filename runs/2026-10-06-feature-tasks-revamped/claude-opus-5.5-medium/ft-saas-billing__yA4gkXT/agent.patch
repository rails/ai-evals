@@ -0,0 +1,21 @@
+class Account::BillingPortalsController < ApplicationController
+  before_action :ensure_admin
+  before_action :ensure_stripe_customer
+
+  rescue_from Stripe::StripeError, with: :billing_unavailable
+
+  def show
+    portal_session = Current.account.billing_portal_session(return_url: main_app.account_settings_url)
+    redirect_to portal_session.url, allow_other_host: true, status: :see_other
+  end
+
+  private
+    def ensure_stripe_customer
+      redirect_to main_app.account_settings_path unless Current.account.stripe_customer_id
+    end
+
+    def billing_unavailable(error)
+      Rails.error.report(error, handled: true)
+      redirect_to main_app.account_settings_path, alert: "Billing is unavailable right now. Please try again in a few minutes."
+    end
+end
diff --git a/saas/app/controllers/account/subscriptions_controller.rb b/saas/app/controllers/account/subscriptions_controller.rb
new file mode 100644
index 0000000..e159152
