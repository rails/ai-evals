+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def update
+    @account.override_limits(**overridden_limits_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  rescue ActiveRecord::RecordInvalid => error
+    redirect_to saas.admin_account_path(@account), alert: error.record.errors.full_messages.to_sentence
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:account_id])
+    end
+
+    def overridden_limits_params
+      params.expect(overridden_limits: %i[ card_count bytes_used ]).to_h.symbolize_keys.transform_values { |value| value.to_s.delete(",_ ").presence }.with_defaults(card_count: nil, bytes_used: nil)
+    end
+end
