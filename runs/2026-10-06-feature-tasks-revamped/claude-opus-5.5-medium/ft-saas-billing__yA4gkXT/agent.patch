@@ -0,0 +1,19 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    Account::Subscription::StripeEvent.process(verified_event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def verified_event
+      Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"].to_s, signing_secret)
+    end
+
+    def signing_secret
+      ENV.fetch("STRIPE_WEBHOOK_SECRET")
+    end
+end
