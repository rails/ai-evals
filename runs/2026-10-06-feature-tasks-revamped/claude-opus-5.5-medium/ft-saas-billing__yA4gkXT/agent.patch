+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      refuse_over_card_limit if Current.account.exceeding_card_limit? && !Current.identity.staff?
+    end
+
+    def ensure_card_limit_not_reached
+      refuse_over_card_limit if Current.account.card_limit_reached? && !Current.identity.staff?
+    end
+
+    def refuse_over_card_limit
+      respond_to do |format|
+        format.json { render json: { error: "This account has used all #{Current.account.card_limit} cards included in the #{Current.account.plan.name} plan. Upgrade to create more." }, status: :forbidden }
+        format.any { head :forbidden }
+      end
+    end
+end
