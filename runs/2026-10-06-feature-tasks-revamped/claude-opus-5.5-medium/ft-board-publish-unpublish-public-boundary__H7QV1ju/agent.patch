diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..f14ff16
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,35 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_published_key!(key)
+      published.find_by!(board_publications: { key: key.to_s })
+    end
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    create_publication! unless published?
+  end
+
+  def unpublish
+    if published?
+      publication.destroy!
+      self.publication = nil
+      touch
+    end
+  end
+
+  def publication_key
+    publication&.key
+  end
+end
