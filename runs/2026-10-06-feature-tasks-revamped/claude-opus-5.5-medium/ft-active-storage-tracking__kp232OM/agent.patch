+++ b/test/models/storage_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts card images" do
+    attach_image @card
+    perform_storage_jobs
+
+    assert_equal moon_size, @board.reload.bytes_used
+    assert_equal moon_size, @account.reload.bytes_used
+    assert_equal moon_size, @board.storage_total.bytes_stored
+    assert_equal moon_size, @account.storage_total.bytes_stored
+    assert_empty Storage::Entry.all
+  end
+
+  test "counts files embedded in card descriptions, comments, and board descriptions" do
+    @card.update!(description: embed_html(upload("moon.jpg")))
+    @card.comments.create!(body: embed_html(upload("avatar.png")))
+    @board.update!(public_description: embed_html(upload("moon.jpg")))
+    perform_storage_jobs
+
+    expected = moon_size * 2 + avatar_size
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+    assert_equal 0, boards(:private).bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "ignores avatars and other untracked attachments" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    perform_storage_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removing attachments reduces usage" do
+    attach_image @card
+    comment = @card.comments.create!(body: embed_html(upload("avatar.png")))
+    perform_storage_jobs
+    assert_equal moon_size + avatar_size, @board.reload.bytes_used
+
+    @card.image.purge
+    comment.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "purging a card image later, as the images controller does" do
+    attach_image @card
+    @card.image.purge_later
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removing an embed from a description" do
+    @card.update!(description: embed_html(upload("moon.jpg")) + embed_html(upload("avatar.png")))
+    perform_storage_jobs
+    assert_equal moon_size + avatar_size, @board.reload.bytes_used
+
+    @card.update!(description: embed_html(@card.description.embeds.find_by(blob: ActiveStorage::Blob.find_by(filename: "avatar.png")).blob))
+    perform_storage_jobs
+    assert_equal avatar_size, @board.reload.bytes_used
+
+    @card.update!(description: "No more files")
+    perform_storage_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "replacing a card image" do
+    attach_image @card
+    @card.image.attach(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    perform_storage_jobs
+
+    assert_equal avatar_size, @board.reload.bytes_used
+  end
+
+  test "destroying cards and boards reduces account usage" do
+    attach_image @card
+    cards(:layout).comments.create!(body: embed_html(upload("avatar.png")))
+    @card.destroy!
+    perform_storage_jobs
+    assert_equal avatar_size, @account.reload.bytes_used
+
+    @board.destroy!
+    perform_storage_jobs
+    assert_equal 0, @account.reload.bytes_used
+    assert_empty Storage::Entry.where(owner_type: "Board")
+    assert_empty Storage::Total.where(owner_type: "Board")
+  end
+
+  test "moving a card moves its usage to the new board" do
+    attach_image @card
+    @card.comments.create!(body: embed_html(upload("avatar.png")))
+    perform_storage_jobs
+    @card.move_to(boards(:private))
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal moon_size + avatar_size, boards(:private).reload.bytes_used
+    assert_equal moon_size + avatar_size, @account.reload.bytes_used
+  end
+
+  test "usage includes changes not materialized yet" do
+    attach_image @card
+
+    assert_equal moon_size, @board.reload.bytes_used
+    assert_equal moon_size, @account.reload.bytes_used
+  end
+
+  test "materializes once per owner for bulk changes in a transaction" do
+    Card.transaction do
+      attach_image @card
+      attach_image cards(:layout)
+    end
+
+    assert_equal 2, enqueued_jobs.count { it["job_class"] == "Storage::MaterializeJob" }
+  end
+
+  test "rolled back changes are not counted and don't prevent later materializations" do
+    Card.transaction do
+      attach_image @card
+      raise ActiveRecord::Rollback
+    end
+    assert_equal 0, @board.reload.bytes_used
+
+    Card.transaction { attach_image Card.find(@card.id) }
+    perform_storage_jobs
+    assert_equal moon_size, @board.reload.storage_total.bytes_stored
+  end
+
+  test "reconcile recomputes from attachments" do
+    attach_image @card
+    perform_storage_jobs
+
+    @board.storage_total.update!(bytes_stored: 12345)
+    @board.reconcile_storage_later
+    perform_storage_jobs
+
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "attachments that predate tracking are counted" do
+    attach_image @card
+    Storage::Entry.delete_all
+    clear_enqueued_jobs
+
+    assert_equal moon_size, @board.reload.bytes_used
+    perform_storage_jobs
+    assert_equal moon_size, @board.reload.storage_total.bytes_stored
+  end
+
+  private
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Storage::MaterializeJob, Storage::ReconcileJob ]
+    end
+
+    def attach_image(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def upload(name)
+      ActiveStorage::Blob.create_and_upload!(io: file_fixture(name).open, filename: name)
+    end
+
+    def embed_html(blob)
+      ActionText::Content.new("<p>Hi</p>").append_attachables(blob).to_html
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+
+    def avatar_size
+      file_fixture("avatar.png").size
+    end
+end
