diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..30acb09
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,38 @@
+# Storage usage tracking for accounts and boards.
+#
+# Only card images and files embedded in board descriptions, card descriptions, and comments
+# are counted. Usage is tracked with an append-only ledger so that attaching files never
+# contends on a shared counter row, however many people are active at once:
+#
+# * Every tracked attachment change appends a +Storage::Entry+ with a byte delta for each
+#   owner it affects: its board and its account.
+# * +Storage::MaterializeJob+ folds pending entries into the owner's +Storage::Total+ in the
+#   background, one job per owner at a time.
+# * +Storage::ReconcileJob+ recomputes a total from the attachments themselves, for imports
+#   and for repairing drift.
+module Storage
+  class << self
+    def table_name_prefix
+      "storage_"
+    end
+
+    # Yields once per key within the current transaction, so that bulk changes (like destroying
+    # a board with many cards) enqueue a single job per owner instead of one per attachment.
+    def once_per_transaction(key)
+      transaction = ApplicationRecord.current_transaction
+
+      if transaction.open?
+        scheduled = ActiveSupport::IsolatedExecutionState[:storage_scheduled] ||= Set.new
+        scoped_key = [ transaction.uuid, key ]
+
+        if scheduled.add?(scoped_key)
+          transaction.after_commit { scheduled.delete(scoped_key) }
+          transaction.after_rollback { scheduled.delete(scoped_key) }
+          yield
+        end
+      else
+        yield
+      end
+    end
+  end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..29a923c
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,13 @@
+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  class << self
+    def record(owner:, delta:)
+      unless delta.zero?
+        create!(owner: owner, account: owner.account, delta: delta)
+        owner.materialize_storage_later
+      end
+    end
+  end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..b7f3ab1
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,50 @@
+class Storage::Total < ApplicationRecord
+  MATERIALIZE_BATCH_SIZE = 5_000
+
+  belongs_to :account
+  belongs_to :owner, polymorphic: true
+
+  def bytes_used
+    bytes_stored + pending_entries.sum(:delta)
+  end
+
+  # Folds pending ledger entries into the stored total. Entries are removed in the same
+  # transaction that adds their deltas, so each one is counted exactly once, even when
+  # entries are committed out of order by concurrent transactions.
+  def materialize
+    loop do
+      materialized = materialize_batch
+      break if materialized < MATERIALIZE_BATCH_SIZE
+    end
+  end
+
+  # Recomputes the stored total from the tracked attachments themselves. Pending entries are
+  # left in place and the stored total is offset by them, so entries for changes that commit
+  # concurrently are still applied when they get materialized.
+  def reconcile
+    transaction do
+      lock!
+      update! bytes_stored: owner.storage_attachments.storage_bytes - pending_entries.sum(:delta)
+    end
+  end
+
+  private
+    def pending_entries
+      Storage::Entry.where(owner: owner)
+    end
+
+    def materialize_batch
+      transaction do
+        lock!
+
+        ids, deltas = pending_entries.order(:id).limit(MATERIALIZE_BATCH_SIZE).pluck(:id, :delta).transpose
+
+        if ids.present?
+          Storage::Entry.where(id: ids).delete_all
+          update! bytes_stored: bytes_stored + deltas.sum
+        end
+
+        ids.to_a.size
+      end
+    end
+end
diff --git a/app/models/storage/totaled.rb b/app/models/storage/totaled.rb
new file mode 100644
index 0000000..ecabda0
--- /dev/null
+++ b/app/models/storage/totaled.rb
@@ -0,0 +1,54 @@
+# Owners of a storage total: accounts and boards.
+#
+# Including models define +storage_attachments+, the attachments counted towards their usage.
+module Storage::Totaled
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_total, class_name: "Storage::Total", as: :owner
+    has_many :storage_entries, class_name: "Storage::Entry", as: :owner
+
+    after_destroy :delete_storage_records
+  end
+
+  def bytes_used
+    if storage_total
+      storage_total.bytes_used
+    else
+      # Not materialized yet, e.g. for records created before storage was tracked.
+      materialize_storage_later
+      storage_attachments.storage_bytes
+    end
+  end
+
+  def materialize_storage_later
+    Storage.once_per_transaction(self) do
+      Storage::MaterializeJob.perform_later(self)
+    end
+  end
+
+  def materialize_storage
+    find_or_create_storage_total.materialize
+  end
+
+  def reconcile_storage_later
+    Storage::ReconcileJob.perform_later(self)
+  end
+
+  def reconcile_storage
+    find_or_create_storage_total.tap(&:reconcile).materialize
+  end
+
+  private
+    def find_or_create_storage_total
+      Storage::Total.create_or_find_by!(owner: self) { it.account = account }.tap do |total|
+        # Owners with attachments that predate their total start from a full count.
+        total.reconcile if total.previously_new_record?
+      end
+    end
+
+    def delete_storage_records
+      Storage::Entry.where(owner: self).delete_all
+      Storage::Total.where(owner: self).delete_all
+    end
+end
diff --git a/app/models/storage/tracked.rb b/app/models/storage/tracked.rb
new file mode 100644
index 0000000..96f058f
--- /dev/null
+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,18 @@
+# Records whose attachments, and files embedded in their rich texts, count towards the storage
+# used by their board and account.
+module Storage::Tracked
+  extend ActiveSupport::Concern
+
+  def storage_owners
+    [ storage_board, account ].compact
+  end
+
+  private
+    # Moves all the storage counted for this record from one board to another.
+    def transfer_storage(from:, to:)
+      bytes = storage_attachments.storage_bytes
+
+      Storage::Entry.record owner: from, delta: -bytes if from
+      Storage::Entry.record owner: to, delta: bytes if to
+    end
+end
