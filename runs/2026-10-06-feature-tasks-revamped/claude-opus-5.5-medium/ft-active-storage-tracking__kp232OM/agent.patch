diff --git a/lib/rails_ext/active_storage_attachment_storage_tracking.rb b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
new file mode 100644
index 0000000..e9c91d7
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_storage_tracking.rb
@@ -0,0 +1,57 @@
+# Appends storage ledger entries when attachments counted towards board and account usage are
+# added or removed. See Storage.
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    # Attachments of the given records, plus files embedded in their rich texts. Records are
+    # given by type, e.g. +storage_tracked_for(account: account, Card: account.cards)+.
+    scope :storage_tracked_for, ->(account:, **records_by_type) do
+      direct = records_by_type.map { |type, records| where(record_type: type.to_s, record_id: records) }.reduce(:or)
+      rich_texts = records_by_type.map { |type, records| ActionText::RichText.where(record_type: type.to_s, record_id: records) }.reduce(:or)
+
+      where(account: account).and(direct.or(where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id))))
+    end
+
+    after_create :record_storage_addition
+    after_destroy :record_storage_removal
+  end
+
+  class_methods do
+    def storage_bytes
+      joins(:blob).sum("active_storage_blobs.byte_size")
+    end
+  end
+
+  # Purging and detaching delete attachments without running callbacks.
+  def delete
+    record_storage_removal if persisted?
+    super
+  end
+
+  private
+    def record_storage_addition
+      record_storage_change +1
+    end
+
+    def record_storage_removal
+      record_storage_change -1
+    end
+
+    def record_storage_change(sign)
+      if blob && (tracked = storage_tracked_record)
+        tracked.storage_owners.each do |owner|
+          Storage::Entry.record owner: owner, delta: sign * blob.byte_size
+        end
+      end
+    end
+
+    def storage_tracked_record
+      tracked = record.is_a?(ActionText::RichText) ? record.record : record
+      tracked if tracked.is_a?(Storage::Tracked)
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentStorageTracking
+end
