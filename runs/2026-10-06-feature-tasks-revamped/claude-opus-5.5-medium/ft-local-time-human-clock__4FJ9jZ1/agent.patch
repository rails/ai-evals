diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..2fdb64d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,59 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatLocalTimeTitle } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+const RERENDER_EVENTS = [ "turbo:morph", "turbo:morph-element", "turbo:frame-render", "turbo:render" ]
+
+// Renders <time> elements emitted by `local_datetime_tag` in the viewer's timezone.
+export default class extends Controller {
+  static targets = [ "time", "date", "longdate", "datetime", "weekday", "ago", "relative", "indays" ]
+
+  #timer
+  #frame
+  #rerender = () => this.#scheduleRefresh()
+
+  connect() {
+    this.#timer = setInterval(() => this.refresh(), REFRESH_INTERVAL)
+    RERENDER_EVENTS.forEach(event => document.addEventListener(event, this.#rerender))
+    this.refresh()
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    cancelAnimationFrame(this.#frame)
+    RERENDER_EVENTS.forEach(event => document.removeEventListener(event, this.#rerender))
+  }
+
+  refresh() {
+    const now = new Date()
+    this.element.querySelectorAll("time[data-local-time-target]").forEach(element => this.#render(element, now))
+  }
+
+  timeTargetConnected(element) { this.#render(element) }
+  dateTargetConnected(element) { this.#render(element) }
+  longdateTargetConnected(element) { this.#render(element) }
+  datetimeTargetConnected(element) { this.#render(element) }
+  weekdayTargetConnected(element) { this.#render(element) }
+  agoTargetConnected(element) { this.#render(element) }
+  relativeTargetConnected(element) { this.#render(element) }
+  indaysTargetConnected(element) { this.#render(element) }
+
+  // Morphing can strip formatted text from a <time> without reconnecting it; many
+  // morph events can fire at once, so coalesce them into a single refresh.
+  #scheduleRefresh() {
+    cancelAnimationFrame(this.#frame)
+    this.#frame = requestAnimationFrame(() => this.refresh())
+  }
+
+  #render(element, now = new Date()) {
+    const value = element.getAttribute("datetime")
+    const text = formatLocalTime(value, element.dataset.localTimeTarget, now)
+
+    if (text !== null) {
+      if (element.textContent !== text) element.textContent = text
+
+      const title = formatLocalTimeTitle(value)
+      if (element.title !== title) element.title = title
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..f49e88e
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,152 @@
+// Formats timestamps rendered by `local_datetime_tag` (app/helpers/time_helper.rb)
+// in the viewer's own timezone. Keep the list of styles in sync with
+// TimeHelper::LOCAL_TIME_STYLES.
+
+const LOCALE = "en-US"
+const MINUTE = 60
+const HOUR = 60 * MINUTE
+const DAY = 24 * HOUR
+
+const formatters = {
+  time: new Intl.DateTimeFormat(LOCALE, { hour: "numeric", minute: "2-digit" }),
+  shortDate: new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric" }),
+  shortDateWithYear: new Intl.DateTimeFormat(LOCALE, { month: "short", day: "numeric", year: "numeric" }),
+  datetime: new Intl.DateTimeFormat(LOCALE, { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" }),
+  weekday: new Intl.DateTimeFormat(LOCALE, { weekday: "long", month: "long", day: "numeric" }),
+  fullDate: new Intl.DateTimeFormat(LOCALE, { weekday: "long", month: "long", day: "numeric", year: "numeric" }),
+  fullDateTime: new Intl.DateTimeFormat(LOCALE, { weekday: "long", month: "long", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" })
+}
+
+const styles = {
+  time: (date) => formatters.time.format(date),
+  date: (date, now) => formatDate(date, now),
+  longdate: (date) => formatters.shortDateWithYear.format(date),
+  datetime: (date) => formatters.datetime.format(date),
+  weekday: (date) => formatters.weekday.format(date),
+  ago: (date, now) => formatAgo(date, now),
+  relative: (date, now) => formatRelative(date, now),
+  indays: (date, now) => formatInDays(date, now)
+}
+
+export const LOCAL_TIME_STYLES = Object.keys(styles)
+
+// Accepts the `datetime` attribute value: an ISO 8601 timestamp, a calendar day
+// ("2025-09-12", which is never shifted across timezones) or epoch seconds.
+export function parseLocalTime(value) {
+  if (value === null || value === undefined || value === "") return null
+
+  const string = String(value).trim()
+  const calendarDay = string.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+  let date
+
+  if (calendarDay) {
+    const [ , year, month, day ] = calendarDay.map(Number)
+    date = new Date(year, month - 1, day, 12)
+  } else if (/^-?\d+(\.\d+)?$/.test(string)) {
+    date = new Date(Number(string) * 1000)
+  } else {
+    date = new Date(string)
+  }
+
+  return isNaN(date) ? null : { date, allDay: !!calendarDay }
+}
+
+export function formatLocalTime(value, style = "time", now = new Date()) {
+  const parsed = parseLocalTime(value)
+  const formatter = styles[style]
+
+  if (parsed && formatter) {
+    return formatter(parsed.date, now)
+  } else {
+    return null
+  }
+}
+
+export function formatLocalTimeTitle(value) {
+  const parsed = parseLocalTime(value)
+
+  if (parsed) {
+    return (parsed.allDay ? formatters.fullDate : formatters.fullDateTime).format(parsed.date)
+  } else {
+    return null
+  }
+}
+
+// Number of calendar days from `from` to `to` in the viewer's timezone.
+export function calendarDaysBetween(from, to) {
+  return Math.round((utcMidnight(to) - utcMidnight(from)) / (DAY * 1000))
+}
+
+function utcMidnight(date) {
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function formatDate(date, now) {
+  const formatter = date.getFullYear() === now.getFullYear() ? formatters.shortDate : formatters.shortDateWithYear
+  return formatter.format(date)
+}
+
+// Today: "1:42 PM"; yesterday: "yesterday"; this week: "5 days ago"; older: "Sep 12".
+// Mirrored for the future: "tomorrow", "in 3 days".
+function formatRelative(date, now) {
+  const days = calendarDaysBetween(now, date)
+
+  if (days === 0) {
+    return styles.time(date)
+  } else if (Math.abs(days) < 7) {
+    return daysInWords(days)
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+// "today", "tomorrow", "in 3 days", "yesterday", "3 days ago"
+function formatInDays(date, now) {
+  return daysInWords(calendarDaysBetween(now, date))
+}
+
+function daysInWords(days) {
+  switch (true) {
+    case days === 0:  return "today"
+    case days === 1:  return "tomorrow"
+    case days === -1: return "yesterday"
+    case days > 1:    return `in ${days} days`
+    default:          return `${-days} days ago`
+  }
+}
+
+// Mirrors Rails' distance_of_time_in_words: "5 minutes ago", "about 2 hours ago", "in 3 days".
+function formatAgo(date, now) {
+  const seconds = (date - now) / 1000
+  const distance = distanceInWords(Math.abs(seconds))
+
+  if (Math.abs(seconds) < MINUTE) {
+    return seconds > 0 ? "in less than a minute" : "less than a minute ago"
+  } else {
+    return seconds > 0 ? `in ${distance}` : `${distance} ago`
+  }
+}
+
+function distanceInWords(seconds) {
+  const minutes = Math.round(seconds / MINUTE)
+
+  if (minutes < 1) return "less than a minute"
+  if (minutes < 45) return pluralize(minutes, "minute")
+  if (minutes < 90) return "about 1 hour"
+  if (minutes < 1440) return `about ${pluralize(Math.round(minutes / 60), "hour")}`
+  if (minutes < 2520) return "1 day"
+  if (minutes < 43200) return pluralize(Math.round(minutes / 1440), "day")
+  if (minutes < 86400) return `about ${pluralize(Math.round(minutes / 43200), "month")}`
+  if (minutes < 525600) return pluralize(Math.round(minutes / 43200), "month")
+
+  const years = Math.floor(minutes / 525600)
+  const remainder = minutes % 525600
+
+  if (remainder < 131400) return `about ${pluralize(years, "year")}`
+  if (remainder < 394200) return `over ${pluralize(years, "year")}`
+  return `almost ${pluralize(years + 1, "year")}`
+}
+
+function pluralize(count, word) {
+  return `${count} ${count === 1 ? word : `${word}s`}`
+}
