diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..ae3d64e
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,47 @@
+class MagicLink < ApplicationRecord
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  enum :purpose, %w[ sign_in sign_up ], prefix: :for, default: :sign_in
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :stale, -> { where(expires_at: ..Time.current) }
+
+  before_validation :generate_code, :set_expiration, on: :create
+
+  validates :code, presence: true, uniqueness: true
+
+  class << self
+    def consume(code)
+      if sanitized_code = Code.sanitize(code)
+        active.find_by(code: sanitized_code)&.consume
+      end
+    end
+
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def consume
+    identity.magic_links.delete_all
+    self
+  end
+
+  def deliver_later
+    MagicLinkMailer.sign_in_instructions(self).deliver_later
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Code.generate
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+
+    def set_expiration
+      self.expires_at ||= EXPIRATION_TIME.from_now
+    end
+end
diff --git a/app/models/magic_link/code.rb b/app/models/magic_link/code.rb
new file mode 100644
index 0000000..16e8b44
--- /dev/null
+++ b/app/models/magic_link/code.rb
@@ -0,0 +1,18 @@
+# Six-character codes drawn from Crockford's Base32 alphabet, which leaves out
+# the letters that are easy to confuse with digits (I, L, O, U).
+module MagicLink::Code
+  LENGTH = 6
+  ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ".chars.freeze
+  LOOKALIKES = { "O" => "0", "I" => "1", "L" => "1" }
+
+  extend self
+
+  def generate
+    SecureRandom.alphanumeric(LENGTH, chars: ALPHABET)
+  end
+
+  def sanitize(code)
+    sanitized = code.to_s.upcase.gsub(/[^0-9A-Z]/, "").gsub(/[OIL]/, LOOKALIKES)
+    sanitized if sanitized.length == LENGTH
+  end
+end
