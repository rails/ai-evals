--- /dev/null
+++ b/app/controllers/concerns/authentication/via_magic_link.rb
@@ -0,0 +1,39 @@
+module Authentication::ViaMagicLink
+  extend ActiveSupport::Concern
+
+  private
+    # Sends people to the screen where they enter the code we emailed them. We redirect there even when
+    # no email was sent, so that the response doesn't reveal whether an email address has an account.
+    def redirect_to_session_magic_link(email_address, return_to: nil)
+      session[:return_to_after_authenticating] = return_to if return_to
+      set_pending_authentication_token_for email_address
+
+      respond_to do |format|
+        format.html { redirect_to main_app.session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_token_for(email_address)
+      token = pending_authentication_verifier.generate(email_address, expires_in: MagicLink::EXPIRATION_TIME)
+      cookies[:pending_authentication_token] = { value: token, httponly: true, same_site: :lax, expires: MagicLink::EXPIRATION_TIME.from_now }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def email_address_pending_authentication
+      if token = pending_authentication_token.presence
+        pending_authentication_verifier.verified(token)
+      end
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def pending_authentication_verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+end
