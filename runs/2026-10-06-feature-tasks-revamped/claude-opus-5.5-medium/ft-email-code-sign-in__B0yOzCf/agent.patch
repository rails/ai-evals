@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  test "show without a pending authentication redirects to sign in" do
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "sign in with the emailed code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      assert_redirected_to session_magic_link_url
+
+      follow_redirect!
+      assert_response :success
+      assert_in_body identity.email_address
+
+      post session_magic_link_path, params: { code: identity.magic_links.last.code.downcase }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_empty identity.magic_links.reload
+    end
+  end
+
+  test "sign in with a wrong code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: "ZZZZZZ" }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code sent to another email address doesn't work" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      other_code = identities(:jz).send_magic_link.code
+
+      post session_magic_link_path, params: { code: other_code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "an expired code doesn't work" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      magic_link = identity.magic_links.last
+      magic_link.update!(expires_at: 1.second.ago)
+
+      post session_magic_link_path, params: { code: magic_link.code }
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "after fifteen minutes you start over" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = identity.magic_links.last.code
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "sign in via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      assert_response :created
+      token = response.parsed_body["pending_authentication_token"]
+
+      assert_equal token, cookies[:pending_authentication_token]
+
+      reset!
+      post session_magic_link_path(format: :json), params: { code: identity.magic_links.last.code },
+        headers: { "Cookie" => "pending_authentication_token=#{token}" }
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+
+      Rails.cache.stubs(:increment).returns(11)
+      post session_magic_link_path, params: { code: "ZZZZZZ" }
+
+      assert_redirected_to new_session_path
+    end
+  end
+end
+
+class Sessions::MagicLinksControllerTokenTest < ActionDispatch::IntegrationTest
+  test "a tampered pending authentication token is rejected" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ZZZZZZ" },
+        headers: { "Cookie" => "pending_authentication_token=tampered" }
+
+      assert_response :unauthorized
+    end
+  end
+end
