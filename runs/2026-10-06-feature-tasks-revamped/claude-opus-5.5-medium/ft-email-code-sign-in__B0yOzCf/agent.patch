diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..bfd7906
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+
+      assert_match(/\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "consume returns the link and removes the identity's codes" do
+    magic_link = @identity.magic_links.create!
+    other = @identity.magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_not MagicLink.exists?(other.id)
+    assert_nil MagicLink.consume(magic_link.code)
+  end
+
+  test "consume is forgiving about case, spacing, and lookalike characters" do
+    magic_link = @identity.magic_links.create!(code: "0A1B2C")
+
+    assert_equal magic_link, MagicLink.consume(" oa-ib 2c ")
+  end
+
+  test "consume scoped to an identity ignores other identities' codes" do
+    magic_link = identities(:jz).magic_links.create!
+
+    assert_nil @identity.magic_links.consume(magic_link.code)
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "consume rejects expired codes" do
+    magic_link = @identity.magic_links.create!
+
+    travel 16.minutes do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume rejects blank and malformed codes" do
+    @identity.magic_links.create!
+
+    assert_nil MagicLink.consume(nil)
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume("TOOLONGCODE")
+  end
+
+  test "cleanup removes stale links" do
+    stale = @identity.magic_links.create!(expires_at: 1.minute.ago)
+    fresh = @identity.magic_links.create!
+
+    MagicLink.cleanup
+
+    assert_not MagicLink.exists?(stale.id)
+    assert MagicLink.exists?(fresh.id)
+  end
+
+  test "send_magic_link emails the code in the subject" do
+    magic_link = perform_enqueued_jobs { @identity.send_magic_link }
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+    assert_includes email.text_part.body.to_s, magic_link.code
+    assert_includes email.html_part.body.to_s, magic_link.code
+  end
+end
