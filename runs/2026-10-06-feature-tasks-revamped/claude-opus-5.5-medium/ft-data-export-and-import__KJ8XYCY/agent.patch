diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..e69abd4
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,40 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = %w[ tag_ids board_ids assignee_ids creator_ids closer_ids ].freeze
+
+  def initialize(account)
+    super(account: account, model: ::Filter)
+  end
+
+  def import(from:, mapping:)
+    @resources = {}
+    super
+    with_mapping(mapping) { restore_resources }
+  ensure
+    @resources = nil
+  end
+
+  private
+    def export_record(filter)
+      super.merge("resources" => RESOURCES.index_with { |resource| filter.public_send(resource) })
+    end
+
+    def import_record(data)
+      super.tap do |row|
+        @resources[row["id"]] = data["resources"].is_a?(Hash) ? data["resources"] : {}
+      end
+    end
+
+    def restore_resources
+      ::Filter.where(id: @resources.keys).find_each do |filter|
+        RESOURCES.each do |resource|
+          ids = Array(@resources.dig(filter.id, resource)).filter_map { |id| mapping[id] }.uniq
+          filter.public_send("#{resource}=", ids) if ids.any?
+        end
+
+        # Digests are calculated from ids, which changed with the import
+        filter.update_column :params_digest, ::Filter.digest_params(filter.reload.as_params)
+      rescue ActiveRecord::RecordNotUnique
+        filter.destroy
+      end
+    end
+end
