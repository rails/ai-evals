@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "an admin can export the account" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: DataExportJob do
+        post account_exports_path
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    export = Account::Export.last
+    assert_equal users(:kevin), export.user
+    assert_equal accounts("37s"), export.account
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "download a completed export" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+
+    get account_export_path(export)
+    assert_response :redirect
+    assert_match %r{/rails/active_storage/blobs/redirect/}, response.location
+
+    follow_redirect!
+    assert_response :redirect
+  end
+
+  test "pending exports show a status page" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+
+    get account_export_path(export)
+    assert_response :success
+    assert_select "h1", text: /being prepared/
+  end
+
+  test "expired download links don't work" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+    export.build
+    blob_path = rails_blob_path(export.file, disposition: "attachment")
+
+    travel 25.hours do
+      get account_export_path(export)
+      assert_response :gone
+
+      get blob_path
+      assert_response :forbidden
+    end
+  end
+
+  test "exports of other admins can't be downloaded" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason))
+    export.build
+
+    get account_export_path(export)
+    assert_response :not_found
+  end
+
+  test "settings show the export button to admins" do
+    get account_settings_path
+    assert_select "form[action=?]", account_exports_path
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..bc8c63b
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name=?]", "account_import[file]"
+  end
+
+  test "create starts an import into a new account" do
+    file = export_file
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_with job: ImportAccountDataJob do
+        untenanted do
+          post account_imports_path, params: { account_import: { file: file } }
+        end
+      end
+    end
+
+    import = Account::Import.last
+    assert_equal identities(:kevin), import.identity
+    assert import.file.attached?
+    assert import.account.users.find_by(identity: identities(:kevin)).owner?
+    assert_redirected_to account_import_url(import, script_name: import.account.slug)
+
+    perform_enqueued_jobs only: ImportAccountDataJob
+    assert import.reload.completed?
+    assert_equal accounts("37s").cards.count, import.account.cards.count
+
+    get account_import_url(import, script_name: import.account.slug)
+    assert_response :success
+  end
+
+  test "create without a file" do
+    assert_no_difference -> { Account.count } do
+      untenanted do
+        post account_imports_path, params: { account_import: { file: "" } }
+      end
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    untenanted do
+      get new_account_import_path
+    end
+
+    assert_response :redirect
+  end
+
+  private
+    def export_file
+      export = Account::Export.create!(account: accounts("37s"), user: users(:kevin))
+      export.build
+
+      tempfile = Tempfile.new([ "export", ".zip" ], binmode: true)
+      tempfile.write(export.file.download)
+      tempfile.rewind
+      Rack::Test::UploadedFile.new(tempfile.path, "application/zip", true, original_filename: "export.zip")
+    end
+end
