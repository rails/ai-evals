@@ -0,0 +1,57 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope only: %i[ new create ]
+
+  layout "public", only: %i[ new create ]
+
+  before_action :ensure_accepting_accounts, only: %i[ new create ]
+  before_action :set_import, only: :show
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    if file = import_file
+      @import = Account::Import.start(identity: Current.identity, file: file)
+      created
+    else
+      @import = Account::Import.new
+      @import.errors.add(:base, "Choose the .zip file of a Fizzy account export to import")
+      invalid
+    end
+  end
+
+  def show
+  end
+
+  private
+    def ensure_accepting_accounts
+      unless Account.accepting_signups?
+        redirect_to session_menu_url(script_name: nil), alert: "This Fizzy instance doesn’t accept new accounts."
+      end
+    end
+
+    def import_file
+      file = params.dig(:account_import, :file)
+      file if file.respond_to?(:read)
+    end
+
+    def created
+      respond_to do |format|
+        format.html { redirect_to account_import_url(@import, script_name: @import.account.slug) }
+        format.json { head :created, location: account_import_url(@import, script_name: @import.account.slug, format: :json) }
+      end
+    end
+
+    def invalid
+      respond_to do |format|
+        format.html { render :new, status: :unprocessable_entity }
+        format.json { render json: { errors: @import.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+
+    def set_import
+      @import = Current.account.imports.find(params[:id])
+      head :forbidden unless @import.identity == Current.identity
+    end
+end
