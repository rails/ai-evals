 require "test_helper"
 
 class Account::DataTransfer::ActionText::RichTextRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(@account)
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+  end
+
+  test "signed ids are exported as plain global ids" do
+    html = %(<p>Hi <action-text-attachment sgid="#{@blob.attachable_sgid}"></action-text-attachment></p>)
+
+    exported = @record_set.convert_sgids_to_gids(html)
+
+    assert_includes exported, %(gid="gid://fizzy/ActiveStorage::Blob/#{@blob.id}")
+    assert_not_includes exported, "sgid="
+  end
+
+  test "global ids are signed again with the new ids on import" do
+    mapping = Account::DataTransfer::Mapping.new(account: @account, identity: identities(:kevin))
+    mapping.map "oldblobid0000000000000000", @blob.id
+    mapping.map "olduserid0000000000000000", users(:david).id
+
+    html = %(<p><action-text-attachment gid="gid://fizzy/ActiveStorage::Blob/oldblobid0000000000000000"></action-text-attachment>) +
+      %(<action-text-attachment gid="gid://fizzy/User/olduserid0000000000000000" content-type="application/vnd.actiontext.mention"></action-text-attachment></p>)
+
+    imported = @record_set.convert_gids_to_sgids(html, mapping: mapping)
+    attachables = ActionText::Content.new(imported).attachables
+
+    assert_equal [ @blob, users(:david) ], attachables
+  end
+
+  test "attachments that aren't part of the export are dropped on import" do
+    mapping = Account::DataTransfer::Mapping.new(account: @account, identity: identities(:kevin))
+
+    html = %(<p><action-text-attachment gid="gid://fizzy/ActiveStorage::Blob/#{@blob.id}"></action-text-attachment>) +
+      %(<action-text-attachment sgid="#{@blob.attachable_sgid}"></action-text-attachment></p>)
+
+    imported = @record_set.convert_gids_to_sgids(html, mapping: mapping)
+
+    assert_not_includes imported, "sgid="
+    assert_not_includes imported, "gid="
+  end
 end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..298382c
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts("37s")
+    @user = users(:kevin)
+  end
+
+  test "build creates a zip with the account records, files and readable cards" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    export = Account::Export.create!(account: @account, user: @user)
+
+    assert_enqueued_email_with ExportMailer, :completed, args: [ export ] do
+      export.build
+    end
+
+    assert export.reload.completed?
+    assert export.completed_at.present?
+    assert export.file.attached?
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      metadata = JSON.parse(zip.read("export.json"))
+      assert_equal "fizzy-account-export", metadata["format"]
+
+      assert zip.exists?("data/accounts/#{@account.id}.json")
+      assert zip.exists?("data/cards/#{card.id}.json")
+      assert zip.exists?("data/users/#{@user.id}.json")
+      assert zip.exists?("storage/#{card.image.blob.key}")
+      assert_equal file_fixture("moon.jpg").binread, zip.read("storage/#{card.image.blob.key}")
+
+      document = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, document["title"]
+      assert_equal card.comments.count, document["comments"].size
+      assert_equal "storage/#{card.image.blob.key}", document.dig("image", "path")
+
+      assert_empty zip.glob("data/exports/*")
+      user_data = JSON.parse(zip.read("data/users/#{@user.id}.json"))
+      assert_equal @user.identity.email_address, user_data["email_address"]
+    end
+  end
+
+  test "exports of other exports are not included" do
+    previous = Account::Export.create!(account: @account, user: @user)
+    previous.build
+
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      assert_not zip.exists?("storage/#{previous.file.blob.key}")
+      assert_not zip.exists?("data/active_storage_blobs/#{previous.file.blob.id}.json")
+    end
+  end
+
+  test "download links expire after a day" do
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+
+    assert export.downloadable?
+    assert export.accessible_to?(@user)
+    assert_not export.accessible_to?(users(:david))
+
+    travel 25.hours do
+      assert export.expired?
+      assert_not export.downloadable?
+      assert_not export.accessible_to?(@user)
+    end
+  end
+
+  test "cleanup removes expired exports" do
+    export = Account::Export.create!(account: @account, user: @user)
+    export.build
+
+    travel 25.hours do
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..2f17763
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,217 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source = accounts("37s")
+    @identity = identities(:kevin)
+  end
+
+  test "importing an export creates a new account with everything in it" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    card.update!(description: %(<p>Look <action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment> #{mention_of(users(:david))}</p>))
+
+    import = import_export_of(@source)
+
+    assert import.reload.completed?
+    account = import.account
+    assert_not_equal @source.id, account.id
+
+    assert_equal @source.name, account.name
+    assert_equal @source.boards.count, account.boards.count
+    assert_equal @source.cards.count, account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: account).count
+    assert_equal Event.where(account: @source).count, Event.where(account: account).count
+    assert_equal @source.users.count, account.users.count
+    assert_equal @source.cards.maximum(:number), account.cards_count
+
+    # Importer owns the new account, and other people are brought in too
+    owner = account.users.find_by!(identity: @identity)
+    assert owner.owner?
+    assert_equal "Kevin", owner.name
+    assert_equal 1, account.users.where(role: :owner).count
+    assert_equal identities(:david), account.users.find_by!(name: "David").identity
+    assert_equal 1, account.users.where(role: :system).count
+
+    # Records keep their relationships, with new ids
+    imported_card = account.cards.find_by!(number: card.number)
+    assert_not_equal card.id, imported_card.id
+    assert_equal card.title, imported_card.title
+    assert_equal card.board.name, imported_card.board.name
+    assert_equal card.comments.count, imported_card.comments.count
+    assert_equal account, imported_card.board.account
+    assert_equal card.creator.name, imported_card.creator.name
+    assert_equal account, imported_card.creator.account
+
+    # Files
+    assert imported_card.image.attached?
+    assert_not_equal card.image.blob.key, imported_card.image.blob.key
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+
+    # Rich text attachments point to the imported records
+    imported_card.description.reload
+    attachables = imported_card.description.body.attachables
+    assert_includes attachables.map(&:class), ActiveStorage::Blob
+    imported_blob = attachables.grep(ActiveStorage::Blob).first
+    assert_equal account.id, imported_blob.account_id
+    assert_equal file_fixture("avatar.png").binread, imported_blob.download
+    mentioned = attachables.grep(User).first
+    assert_equal account, mentioned.account
+    assert_equal "David", mentioned.name
+    assert_equal 1, imported_card.description.embeds.count
+
+    # Search works in the new account
+    assert Search::Record.for(account.id).where(account_id: account.id).exists?
+
+    # The source account is untouched
+    assert_equal card.title, card.reload.title
+    assert_equal file_fixture("moon.jpg").binread, card.image.download
+  end
+
+  test "importing the same export twice works" do
+    first = import_export_of(@source)
+    second = import_export_of(@source)
+
+    assert first.reload.completed?
+    assert second.reload.completed?
+    assert_equal first.account.cards.count, second.account.cards.count
+  end
+
+  test "an import that fails leaves nothing behind" do
+    export = build_export_of(@source)
+    broken = rewrite_zip(export) do |path, content|
+      if path.start_with?("data/cards/") && path == first_card_path(export)
+        data = JSON.parse(content)
+        data["board_id"] = "zzzzzzzzzzzzzzzzzzzzzzzzz"
+        data.to_json
+      else
+        content
+      end
+    end
+
+    assert_no_difference [ -> { Account.count }, -> { Card.count }, -> { User.count }, -> { ActiveStorage::Blob.count }, -> { Identity.count }, -> { Account::Import.count }, -> { Access.count }, -> { ActionText::RichText.count }, -> { Entropy.count }, -> { Account::JoinCode.count } ] do
+      start_import(broken)
+    end
+
+    mail = enqueued_mail_for(ImportMailer, :failed)
+    assert_equal @identity, mail[:args].first
+    assert_match "isn't in the export", mail[:args].last[:reason]
+  end
+
+  test "a corrupted file fails the import and removes the files already stored" do
+    cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    cards(:layout).image.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+    export = build_export_of(@source)
+    corrupted_key = cards(:layout).image.blob.key
+
+    broken = rewrite_zip(export) do |path, content|
+      path == "storage/#{corrupted_key}" ? "corrupted" : content
+    end
+
+    uploaded_keys = []
+    subscriber = ActiveSupport::Notifications.subscribe("service_upload.active_storage") { |event| uploaded_keys << event.payload[:key] }
+
+    assert_no_difference [ -> { Account.count }, -> { ActiveStorage::Blob.count } ] do
+      start_import(broken)
+    end
+
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+    assert uploaded_keys.many?, "Expected files to be uploaded before the import failed"
+    uploaded_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key), "Expected #{key} to be removed"
+    end
+
+    assert_match "corrupted", enqueued_mail_for(ImportMailer, :failed)[:args].last[:reason]
+  end
+
+  test "people created for a failed import are removed" do
+    export = build_export_of(@source)
+    broken = rewrite_zip(export) do |path, content|
+      if path.start_with?("data/users/")
+        data = JSON.parse(content)
+        data["email_address"] = "new-#{data["id"]}@example.com" if data["email_address"]
+        data.to_json
+      elsif path == first_card_path(export)
+        "not json"
+      else
+        content
+      end
+    end
+
+    assert_no_difference [ -> { Identity.count }, -> { Account.count } ] do
+      start_import(broken)
+    end
+  end
+
+  test "an interrupted import is abandoned and cleaned up" do
+    export = build_export_of(@source)
+    import = Current.without_account { Account::Import.start(identity: @identity, file: { io: StringIO.new(export.file.download), filename: "export.zip" }) }
+    clear_enqueued_jobs
+    import.processing!
+
+    assert_difference -> { Account.count }, -1 do
+      ImportAccountDataJob.perform_now(import)
+    end
+
+    assert_not Account::Import.exists?(import.id)
+    assert_match "interrupted", enqueued_mail_for(ImportMailer, :failed)[:args].last[:reason]
+  end
+
+  test "a file that isn't an export fails" do
+    assert_no_difference -> { Account.count } do
+      assert_enqueued_emails 1 do
+        start_import(io: file_fixture("moon.jpg").open, filename: "moon.zip", content_type: "application/zip")
+      end
+    end
+  end
+
+  private
+    def enqueued_mail_for(mailer, method)
+      job = enqueued_jobs.reverse.find { |job| job["job_class"] == "ActionMailer::MailDeliveryJob" && job["arguments"][0..1] == [ mailer.name, method.to_s ] }
+      assert job, "Expected #{mailer}.#{method} to be enqueued"
+      arguments = ActiveJob::Arguments.deserialize(job["arguments"])
+      { args: arguments[3][:args] }
+    end
+
+    def mention_of(user)
+      %(<action-text-attachment sgid="#{user.attachable_sgid}" content-type="application/vnd.actiontext.mention"></action-text-attachment>)
+    end
+
+    def build_export_of(account)
+      Account::Export.create!(account: account, user: account.users.find_by!(identity: @identity)).tap(&:build)
+    end
+
+    def import_export_of(account)
+      export = build_export_of(account)
+      start_import(io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip")
+    end
+
+    def start_import(file)
+      import = Current.without_account { Account::Import.start(identity: @identity, file: file) }
+      perform_enqueued_jobs only: ImportAccountDataJob
+      import
+    end
+
+    def first_card_path(export)
+      "data/cards/#{export.account.cards.order(:id).first.id}.json"
+    end
+
+    def rewrite_zip(export)
+      tempfile = Tempfile.new([ "rewritten", ".zip" ], binmode: true)
+      writer = ZipFile::Writer.new(tempfile)
+
+      ZipFile.read_from(export.file.blob) do |zip|
+        zip.entries.each do |path|
+          writer.add_file(path, yield(path, zip.read(path)))
+        end
+      end
+
+      writer.close
+      tempfile.rewind
+      { io: tempfile, filename: "export.zip", content_type: "application/zip" }
+    end
+end
diff --git a/test/models/user/data_export_test.rb b/test/models/user/data_export_test.rb
new file mode 100644
index 0000000..0ff94b9
--- /dev/null
+++ b/test/models/user/data_export_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class User::DataExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+  end
+
+  test "exports the cards the user can see, with comments and files" do
+    card = @user.accessible_cards.published.first
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    comment = card.comments.create!(creator: @user, body: %(<p>See <action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment></p>))
+
+    export = User::DataExport.create!(account: @user.account, user: @user)
+
+    assert_enqueued_email_with ExportMailer, :completed, args: [ export ] do
+      export.build
+    end
+
+    ZipFile.read_from(export.reload.file.blob) do |zip|
+      card_paths = zip.glob("cards/*.json")
+      expected_cards = @user.accessible_cards.published.or(@user.accessible_cards.where(creator: @user))
+      assert_equal expected_cards.map { |c| "cards/#{c.number}.json" }.sort, card_paths
+
+      document = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, document["title"]
+      assert_equal card.board.name, document["board"]
+
+      exported_comment = document["comments"].find { |c| c["id"] == comment.id }
+      assert_equal "See", exported_comment["body"].strip.split.first
+      attachment = exported_comment["attachments"].first
+      assert_equal "avatar.png", attachment["filename"]
+      assert_equal file_fixture("avatar.png").binread, zip.read(attachment["path"])
+
+      assert_equal file_fixture("moon.jpg").binread, zip.read(document.dig("image", "path"))
+    end
+  end
+
+  test "cards on boards the user can't access are not exported" do
+    board = Board.create!(name: "Secret", account: @user.account, creator: users(:kevin), all_access: false)
+    board.accesses.where(user: @user).destroy_all
+    Current.set(user: users(:kevin)) { board.cards.create!(title: "Secret plans", status: :published) }
+    inaccessible = Card.where(account: @user.account).where.not(board_id: @user.reload.board_ids)
+    assert inaccessible.any?
+
+    export = User::DataExport.create!(account: @user.account, user: @user)
+    export.build
+
+    ZipFile.read_from(export.file.blob) do |zip|
+      inaccessible.each do |card|
+        assert_not zip.exists?("cards/#{card.number}.json")
+      end
+    end
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..0d0bbf5 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -37,4 +37,60 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "docs/guide.txt", "docs/readme.txt" ], writer.glob("docs/*.txt")
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
+
+  test "reader reads files written by the writer" do
+    blob = build_zip_blob do |writer|
+      writer.add_file("data/one.json", '{"a":1}')
+      writer.add_file("storage/file", "binary" * 1000, compress: false)
+    end
+
+    ZipFile.read_from(blob) do |zip|
+      assert_equal [ "data/one.json", "storage/file" ], zip.entries.sort
+      assert_equal [ "data/one.json" ], zip.glob("data/*.json")
+      assert zip.exists?("storage/file")
+      assert_equal '{"a":1}', zip.read("data/one.json")
+      assert_equal "binary" * 1000, zip.read("storage/file")
+    end
+  end
+
+  test "reader reads remote files with ranged requests" do
+    blob = build_zip_blob do |writer|
+      writer.add_file("big", "x" * 3.megabytes)
+      writer.add_file("small", "hello")
+    end
+
+    io = ZipFile::RemoteIO.new(service: blob.service, key: blob.key, size: blob.byte_size)
+    zip = ZipFile::Reader.new(io)
+
+    assert_equal "hello", zip.read("small")
+    assert_equal "x" * 3.megabytes, zip.read("big")
+  end
+
+  test "reader enforces read limits" do
+    blob = build_zip_blob { |writer| writer.add_file("big", "x" * 10_000) }
+
+    ZipFile.read_from(blob) do |zip|
+      assert_raises(ZipFile::InvalidFileError) { zip.read("big", limit: 100) }
+      assert_raises(ZipFile::InvalidFileError) { zip.read("missing") }
+    end
+  end
+
+  test "reader rejects files that aren't zips" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("not a zip"), filename: "nope.zip")
+
+    assert_raises(ZipFile::InvalidFileError) do
+      ZipFile.read_from(blob) { }
+    end
+  end
+
+  private
+    def build_zip_blob
+      tempfile = Tempfile.new([ "test", ".zip" ], binmode: true)
+      writer = ZipFile::Writer.new(tempfile)
+      yield writer
+      writer.close
+      tempfile.rewind
+
+      ActiveStorage::Blob.create_and_upload!(io: tempfile, filename: "test.zip", content_type: "application/zip")
+    end
 end
