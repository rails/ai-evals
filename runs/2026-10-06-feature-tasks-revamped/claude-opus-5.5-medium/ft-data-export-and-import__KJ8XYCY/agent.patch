+module ExportDownloads
+  extend ActiveSupport::Concern
+
+  def show
+    @export = find_export
+
+    respond_to do |format|
+      format.html do
+        if @export.downloadable?
+          redirect_to rails_blob_path(@export.file, disposition: "attachment")
+        else
+          render "exports/show", status: (@export.expired? ? :gone : :ok)
+        end
+      end
+
+      format.json { render "exports/show" }
+    end
+  end
+end
