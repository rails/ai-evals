+<%= card_article_tag card, class: "card", data: { id: card.number, navigable_list_target: "item", css_variable_counter_target: "item" }, tabindex: 0 do %>
+  <div class="flex flex-column flex-item-grow max-inline-size">
+    <%= link_to public_board_card_path(card.board.publication.key, card), class: "card__link", title: card.title, data: { turbo_frame: "_top" } do %>
+      <span class="for-screen-reader"><%= card.title %></span>
+    <% end %>
+
+    <header class="card__header">
+      <div class="card__board">
+        <%= render "cards/display/common/board", card: card %>
+      </div>
+
+      <% if card.tags.any? %>
+        <div class="card__tags">
+          <div class="card__tags-list min-width">
+            <% card.tags.each_with_index do |tag, index| %>
+              <span class="card__tag txt-uppercase"><%= tag.title %></span><%= "," unless index == card.tags.size - 1 %>
+            <% end %>
+          </div>
+        </div>
+      <% end %>
+
+      <% if card.triaged? %>
+        <span class="btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width">
+          <span class="overflow-ellipsis"><%= card.column.name %></span>
+        </span>
+      <% end %>
+    </header>
+
+    <div class="card__body justify-space-between">
+      <div class="card__content">
+        <h3 class="card__title overflow-line-clamp">
+          <%= card_html_title(card) %>
+        </h3>
