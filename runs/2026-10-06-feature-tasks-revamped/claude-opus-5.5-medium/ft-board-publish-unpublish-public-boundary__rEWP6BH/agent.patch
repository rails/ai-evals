@@ -0,0 +1,101 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <meta name="robots" content="noindex, nofollow">
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_back_to_public_board(@board) %>
+  </div>
+<% end %>
+
+<div data-controller="lightbox">
+  <section id="<%= dom_id(@card, :card_container) %>" class="card-perma" style="--card-color: <%= @card.color %>;">
+    <div class="card-perma__bg">
+      <%= card_article_tag @card, class: "card" do %>
+        <header class="card__header">
+          <div class="card__board">
+            <%= render "cards/display/common/board", card: @card %>
+          </div>
+
+          <% if @card.tags.any? %>
+            <div class="card__tags">
+              <div class="card__tags-list min-width">
+                <% @card.tags.each_with_index do |tag, index| %>
+                  <span class="card__tag txt-uppercase"><%= tag.title %></span><%= "," unless index == @card.tags.size - 1 %>
+                <% end %>
+              </div>
+            </div>
+          <% end %>
+        </header>
+
+        <div class="card__body justify-space-between">
+          <div class="card__content">
+            <h1 class="card__title flex align-start gap-half"><%= card_html_title(@card) %></h1>
+
+            <% unless @card.description.blank? %>
+              <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+                <%= @card.description %>
+              </div>
+            <% end %>
+
+            <% if @card.steps.any? %>
+              <ol class="steps txt-small margin-block-start-auto">
+                <% @card.steps.each do |step| %>
+                  <li class="step">
+                    <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %> aria-label="<%= step.completed? ? "Completed" : "Not completed" %>">
+                    <span class="step__content"><%= step.content %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% end %>
+          </div>
+
+          <% if @card.triaged? %>
+            <div class="card__stages">
+              <% @board.columns.sorted.each do |column| %>
+                <%= tag.span column.name, class: [ "card__column-name btn overflow-ellipsis", { "card__column-name--current": column == @card.column } ], style: "--column-color: #{column.color}" %>
+              <% end %>
+            </div>
+          <% end %>
+
+          <%= render "cards/display/common/stamp", card: @card %>
+        </div>
+
+        <footer class="card__footer">
+          <%= render "public/cards/meta", card: @card %>
+          <%= render "cards/display/common/background", card: @card %>
+        </footer>
+      <% end %>
+    </div>
+  </section>
+
+  <% comments = @card.comments.by_user.preloaded.chronologically %>
+  <% if comments.any? %>
+    <section class="comments">
+      <% comments.each do |comment| %>
+        <div id="<%= dom_id(comment) %>" class="comment align-start full-width">
+          <figure class="comment__avatar flex-item-no-shrink" aria-hidden="true">
+            <%= avatar_preview_tag comment.creator, hidden_for_screen_reader: true %>
+          </figure>
+
+          <div class="comment__content flex flex-column flex-item-grow full-width">
+            <div class="comment__author flex align-center gap-half">
+              <h3 class="font-weight-normal txt-normal flex-item-justify-start min-width overflow-ellipsis">
+                <strong><%= comment.creator.name %></strong>
+                <%= local_datetime_tag comment.created_at, style: :agoorweekday %>,
+                <%= local_datetime_tag comment.created_at, style: :time %>
+              </h3>
+            </div>
+
+            <div class="comment__body lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= comment.body %>
+            </div>
+          </div>
+        </div>
+      <% end %>
+    </section>
+  <% end %>
+</div>
