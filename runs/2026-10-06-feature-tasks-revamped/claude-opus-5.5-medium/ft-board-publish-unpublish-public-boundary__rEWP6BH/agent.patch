@@ -0,0 +1,20 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+
+    before_action :ensure_account_is_active, :set_board
+
+    layout "public"
+  end
+
+  private
+    def ensure_account_is_active
+      raise ActiveRecord::RecordNotFound unless Current.account.active?
+    end
+
+    def set_board
+      @board = Current.account.boards.find_by_published_key!(params[:board_id] || params[:id])
+    end
+end
