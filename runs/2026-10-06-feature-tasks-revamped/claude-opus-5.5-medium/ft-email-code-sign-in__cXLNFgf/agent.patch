+        perform_enqueued_jobs { post session_path, params: { email_address: identity.email_address } }
+      end
+      assert_redirected_to session_magic_link_url
+
+      email = ActionMailer::Base.deliveries.last
+      code = identity.magic_links.last.code
+      assert_equal [ identity.email_address ], email.to
+      assert_includes email.subject, code
+      assert_equal 6, code.length
+
+      get session_magic_link_path
+      assert_response :success
+      assert_in_body identity.email_address
+
+      post session_magic_link_path, params: { code: code.downcase }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_not MagicLink.exists?(code: code)
+    end
+  end
+
+  test "wrong code via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+      post session_magic_link_path(format: :json), params: { code: "AAAAAA" }
+      assert_response :unauthorized
+    end
+  end
+
+  test "wrong code doesn't sign in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      post session_magic_link_path, params: { code: "ZZZZZZ" }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "someone else's code doesn't sign in" do
+    other_code = identities(:david).send_magic_link.code
+
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post session_magic_link_path, params: { code: other_code }
+
+      assert_redirected_to session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "codes expire after fifteen minutes" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      code = identity.magic_links.last.code
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+
+    magic_link = identity.send_magic_link
+    magic_link.update!(expires_at: 1.second.ago)
+    assert_nil identity.magic_links.consume(magic_link.code)
+  end
+
+  test "code without a pending email address" do
+    untenanted do
+      post session_magic_link_path, params: { code: "ABCDEF" }
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "sign in via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+      assert_response :created
+      token = response.parsed_body["pending_authentication_token"]
+      assert token.present?
+
+      cookies[:pending_authentication_token] = token
+      post session_magic_link_path(format: :json), params: { code: identity.magic_links.last.code }
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "sign up by email code" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post signup_path, params: { signup: { email_address: "newbie@example.com" } }
+      end
+      assert_redirected_to session_magic_link_url
+
+      identity = Identity.find_by!(email_address: "newbie@example.com")
+      post session_magic_link_path, params: { code: identity.magic_links.last.code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "unknown email when sign ups are closed" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        assert_no_difference -> { Identity.count } do
+          post session_path, params: { email_address: "stranger@example.com" }
+        end
+        assert_redirected_to session_magic_link_url
+        post session_magic_link_path, params: { code: "ABCDEF" }
+        assert_redirected_to session_magic_link_path
+      end
+    end
+  end
+
+  test "join by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { Identity.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+    end
+    assert_redirected_to session_magic_link_url(script_name: nil)
+
+    identity = Identity.find_by!(email_address: "joiner@example.com")
+    untenanted do
+      post session_magic_link_url(script_name: nil), params: { code: identity.magic_links.last.code }
+      assert_redirected_to new_users_verification_url(script_name: account.slug)
+    end
+  end
+end
