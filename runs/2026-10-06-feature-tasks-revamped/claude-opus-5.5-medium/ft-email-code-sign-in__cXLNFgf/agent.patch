@@ -0,0 +1,32 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= email_address_pending_authentication %></strong>. Enter it below to continue. It works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+              placeholder: "Enter your code…", aria: { label: "Code" } %>
+      </label>
+    </div>
+
+    <% if Rails.env.development? && flash[:magic_link_code] %>
+      <p class="txt-subtle txt-small">Development code: <code><%= flash[:magic_link_code] %></code></p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle">Didn’t get it? Check your spam folder, or <%= link_to "try a different email address", new_session_path %>.</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
