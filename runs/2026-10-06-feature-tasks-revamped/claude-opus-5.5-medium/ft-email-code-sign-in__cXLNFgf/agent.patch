+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  test "sign_in_instructions puts the code in the subject" do
+    magic_link = identities(:kevin).magic_links.create!
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_emails(1) { email.deliver_now }
