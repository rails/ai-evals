diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..d80ad63
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      magic_link = identities(:kevin).magic_links.create!
+
+      assert_match(/\A[0-9A-HJKMNP-TV-Z]{6}\z/, magic_link.code)
+      assert_equal 15.minutes.from_now, magic_link.expires_at
+      assert magic_link.for_sign_in?
+    end
+  end
+
+  test "consume" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(" #{magic_link.code.downcase} ")
+    assert_nil MagicLink.consume(magic_link.code), "codes work only once"
+  end
+
+  test "consume forgives easily confused characters" do
+    magic_link = identities(:kevin).magic_links.create!(code: "0A1B1C")
+
+    assert_equal magic_link, MagicLink.consume("oa-ib-lc")
+  end
+
+  test "consume ignores expired codes" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    travel MagicLink::EXPIRATION_TIME + 1.second do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume ignores blank codes" do
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+  end
+
+  test "cleanup deletes expired codes" do
+    active = identities(:kevin).magic_links.create!
+    stale = identities(:kevin).magic_links.create!(expires_at: 1.minute.ago)
+
+    MagicLink.cleanup
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+
+  test "identity sends a magic link by email" do
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      assert_difference -> { identities(:kevin).magic_links.count }, 1 do
+        identities(:kevin).send_magic_link
+      end
+    end
+  end
+end
