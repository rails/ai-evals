+module Admin::AccountScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_account
+  end
+
+  private
+    def set_account
+      @account = find_account(params[:account_id] || params[:id])
+    end
+
+    # Support quotes the account number from the URL (the external account ID),
+    # while links inside the admin area use the record ID. Accept either.
+    def find_account(id)
+      (id.to_s.match?(/\A\d+\z/) && Account.find_by(external_account_id: id)) || Account.find(id)
+    end
+
+    def redirect_to_account(**flash)
+      redirect_to saas.admin_account_path(@account), **flash
+    end
+end
