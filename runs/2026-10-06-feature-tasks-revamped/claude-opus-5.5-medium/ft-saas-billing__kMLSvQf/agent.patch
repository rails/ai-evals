@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 120)
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing" do
+      assert_select "strong", text: "Free"
+      assert_match "120", css_select("#billing li").first.text
+      assert_select "form[action$='/account/subscription'][data-turbo='false']"
+      assert_select "input[type=radio][value=monthly_v1][checked]"
+      assert_select "input[type=radio][value=monthly_extra_storage_v1]"
+      assert_select "button", text: "Upgrade"
+    end
+  end
+
+  test "subscribers manage billing instead" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: "active", current_period_end: 1.month.from_now)
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_select "#billing" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "button", text: "Manage billing"
+      assert_select "button", text: "Upgrade", count: 0
+    end
+  end
+
+  test "members don't see billing" do
+    sign_in_as :jz
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "#billing", count: 0
+  end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..d5044ac
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    Plan.unlimited.stubs(:stripe_price_id).returns("price_unlimited")
+  end
+
+  test "admins upgrade through Stripe checkout" do
+    Stripe::Customer.expects(:create).returns(stub(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with { |params| params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] && params[:success_url].include?("/account/settings") }
+      .returns(stub(url: "https://checkout.stripe.com/c/pay/123"))
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug), params: { plan: "monthly_v1" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/123"
+  end
+
+  test "already subscribed accounts go to the portal" do
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: "active")
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_1", return_url: anything).returns(stub(url: "https://billing.stripe.com/p/1"))
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/1"
+  end
+
+  test "unknown plans are rejected" do
+    post saas.account_subscription_path(script_name: accounts(:initech).slug), params: { plan: "free_v1" }
+    assert_response :bad_request
+  end
+
+  test "Stripe outages send you back to settings" do
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("down"))
+
+    post saas.account_subscription_path(script_name: accounts(:initech).slug)
+
+    assert_redirected_to "#{accounts(:initech).slug}/account/settings#billing"
+  end
+
+  test "members can't upgrade" do
+    logout_and_sign_in_as :jz
+    post saas.account_subscription_path(script_name: accounts(:"37s").slug)
+    assert_response :forbidden
+  end
+end
