+        <dd>
+          Customer <%= subscription.stripe_customer_id %>
+          <% if subscription.stripe_subscription_id %>
+            • Subscription <%= subscription.stripe_subscription_id %> (<%= subscription.status %>)
+          <% end %>
+          <% if subscription.canceling? %>
+            • Ends <%= subscription.cancel_at.to_date.to_fs(:long) %>
+          <% end %>
+        </dd>
+      <% end %>
+
+      <dt class="txt-x-small txt-ink-medium">Cards</dt>
+      <dd>
+        <%= number_with_delimiter(@account.billed_cards_count) %> of <%= plan_cards_in_words(@account.plan) %>
+        <% if @account.overridden_limits&.card_count %>
+          <span class="txt-ink-medium">(overridden, actual <%= number_with_delimiter(@account.cards_count) %>)</span>
+        <% end %>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium">Storage</dt>
+      <dd>
+        <%= number_to_human_size(@account.billed_bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+        <% if @account.overridden_limits&.bytes_used %>
+          <span class="txt-ink-medium">(overridden, actual <%= number_to_human_size(@account.bytes_used) %>)</span>
+        <% end %>
+      </dd>
+    </dl>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Comp</h2>
+        <div>A comped account gets the <%= Plan.unlimited.name %> plan without paying.</div>
+      </header>
+
+      <div class="flex gap-half justify-center">
+        <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+        <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--negative" %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override limits</h2>
+        <div>Bill this account as if it had this many cards or bytes. Leave a field blank to use the real figure.</div>
+      </header>
+
+      <%= form_with url: saas.admin_account_overridden_limits_path(@account), method: :patch, scope: :overridden_limits, class: "flex flex-column gap-half" do |form| %>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limits&.card_count, min: 0, class: "input" %>
+
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limits&.bytes_used, min: 0, class: "input" %>
+
+        <%= form.submit "Override", class: "btn btn--link" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.admin_account_overridden_limits_path(@account), method: :delete, class: "btn margin-block-start-half" %>
+    </section>
+  </div>
+</section>
