+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "override and reset" do
+    untenanted { patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1001", bytes_used: "" } } }
+
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_equal 1001, @account.reload.billed_cards_count
+    assert_nil @account.overridden_limits.bytes_used
+    assert @account.exceeding_card_limit?
+
+    untenanted { delete saas.admin_account_overridden_limits_path(@account) }
+
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "invalid overrides are reported" do
+    untenanted { patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "-5" } } }
+
+    assert_redirected_to "/admin/accounts/#{@account.id}"
+    assert_match(/Card count/, flash[:alert])
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "non-staff can't override" do
+    logout_and_sign_in_as :jz
+    untenanted { patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: "1" } } }
+
+    assert_response :forbidden
+  end
+end
