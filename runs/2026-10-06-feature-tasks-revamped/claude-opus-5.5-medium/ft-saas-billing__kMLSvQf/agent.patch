@@ -0,0 +1,49 @@
+<% plan = account.plan %>
+
+<section class="settings__section" id="billing">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= plan.name %></strong> plan<%= " (complimentary)" if account.comped? && !account.active_subscription %>:
+      <%= plan_summary(plan) %>.
+    </div>
+  </header>
+
+  <ul class="list-unindented txt-small margin-block-half">
+    <li>
+      <% if plan.limit_cards? %>
+        <strong><%= number_with_delimiter(account.billed_cards_count) %></strong> of <%= number_with_delimiter(plan.card_limit) %> cards used
+      <% else %>
+        <strong><%= number_with_delimiter(account.billed_cards_count) %></strong> cards
+      <% end %>
+    </li>
+    <li><strong><%= number_to_human_size(account.billed_bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage used</li>
+  </ul>
+
+  <% if subscription = account.active_subscription %>
+    <p class="txt-small">
+      <%= plan_price_in_words(plan) %>.
+      <% if subscription.canceling? %>
+        Your subscription ends on <%= subscription.cancel_at.to_date.to_fs(:long) %>.
+      <% elsif subscription.current_period_end %>
+        Renews on <%= subscription.current_period_end.to_date.to_fs(:long) %>.
+      <% end %>
+      <% if subscription.status == "past_due" %>
+        <strong>Your last payment failed. Please update your payment details.</strong>
+      <% end %>
+    </p>
+
+    <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn", form: { data: { turbo: false } } %>
+  <% elsif !account.comped? %>
+    <%= form_with url: saas.account_subscription_path, method: :post, data: { turbo: false }, class: "flex flex-column gap-half" do |form| %>
+      <% Plan.paid.each_with_index do |paid_plan, index| %>
+        <label class="flex gap-half align-center txt-align-start">
+          <%= form.radio_button :plan, paid_plan.to_param, checked: index.zero? %>
+          <span><strong><%= paid_plan.name %></strong> — <%= plan_price_in_words(paid_plan) %>: <%= plan_summary(paid_plan) %></span>
+        </label>
+      <% end %>
+
+      <div><%= form.button "Upgrade", class: "btn btn--link", name: nil %></div>
+    <% end %>
+  <% end %>
+</section>
