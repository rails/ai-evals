@@ -18,3 +18,10 @@ module Fizzy::Saas::EngineFixtures
 end
 
 ActiveRecord::TestFixtures.singleton_class.prepend(Fizzy::Saas::EngineFixtures)
+
+# Routes load lazily, and the engine's `saas` mounted helper only exists once they have.
+# Integration tests that reach for `saas.*_path` before making any request would otherwise
+# fail depending on test order.
+ActiveSupport.on_load(:action_dispatch_integration_test) do
+  setup { Rails.application.reload_routes_unless_loaded }
+end
