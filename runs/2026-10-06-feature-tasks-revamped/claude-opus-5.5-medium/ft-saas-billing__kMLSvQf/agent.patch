+  test "no countdown on paid plans" do
+    accounts(:initech).override_limits(card_count: 950)
+    accounts(:initech).comp
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_no_match(/cards left/, response.body)
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..faeba77
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  SECRET = "whsec_test"
+
+  setup do
+    @account = accounts(:initech)
+    @account.create_subscription!(stripe_customer_id: "cus_initech")
+    Plan.unlimited.stubs(:stripe_price_id).returns("price_unlimited")
+    @previous_secret, ENV["STRIPE_WEBHOOK_SECRET"] = ENV["STRIPE_WEBHOOK_SECRET"], SECRET
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous_secret
+  end
+
+  test "subscription created upgrades the account" do
+    post_event "customer.subscription.created", subscription(status: "active")
+
+    assert_response :ok
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_equal "sub_1", @account.subscription.stripe_subscription_id
+  end
+
+  test "subscription deleted drops the account back to free" do
+    post_event "customer.subscription.created", subscription(status: "active")
+    post_event "customer.subscription.deleted", subscription(status: "canceled")
+
+    assert_response :ok
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "unhandled events are acknowledged" do
+    post_event "invoice.paid", { id: "in_1", object: "invoice" }
+    assert_response :ok
+  end
+
+  test "bad signatures are rejected" do
+    untenanted do
+      post "/stripe/webhooks", params: event_payload("customer.subscription.created", subscription(status: "active")),
+        headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=1,v1=bogus" }
+    end
+
+    assert_response :bad_request
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  private
+    def post_event(type, object)
+      payload = event_payload(type, object)
+      timestamp = Time.now.to_i
+      signature = Stripe::Webhook::Signature.compute_signature(Time.at(timestamp), payload, SECRET)
+
+      untenanted do
+        post "/stripe/webhooks", params: payload,
+          headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}" }
+      end
+    end
+
+    def event_payload(type, object)
+      { id: "evt_1", object: "event", type: type, data: { object: object } }.to_json
+    end
+
+    def subscription(status:)
+      { id: "sub_1", object: "subscription", customer: "cus_initech", status: status, cancel_at: nil, metadata: {},
+        items: { object: "list", data: [ { id: "si_1", price: { id: "price_unlimited" }, current_period_end: 1.month.from_now.to_i } ] } }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..585aaad
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan by default" do
+    assert_equal Plan.free, @account.plan
+    assert_nil @account.active_subscription
+  end
+
+  test "an active subscription brings its plan" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_extra_storage_v1", status: "active")
+
+    assert_equal Plan.find(:monthly_extra_storage_v1), @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "past due subscriptions keep the plan while Stripe retries" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: "past_due")
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "inactive subscriptions fall back to free" do
+    %w[ canceled unpaid incomplete incomplete_expired paused ].each do |status|
+      @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: status)
+      assert_equal Plan.free, @account.reload.plan, status
+      @account.subscription.destroy!
+    end
+  end
+
+  test "comp and uncomp" do
+    @account.comp
+    @account.comp
+    assert @account.comped?
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 1, Account::BillingWaiver.where(account: @account).count
+
+    @account.uncomp
+    assert_not @account.comped?
+    assert_not @account.reload.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "checkout creates the Stripe customer once" do
+    Stripe::Customer.expects(:create).once.returns(stub(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).twice.with { |params| params[:customer] == "cus_new" && params[:mode] == "subscription" }.returns(stub(url: "https://checkout.stripe.com/x"))
+
+    2.times { @account.checkout(Plan.unlimited, success_url: "https://example.com", cancel_url: "https://example.com") }
+
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "cancelling the account cancels the subscription at period end, reactivating resumes it" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: "active")
+
+    Stripe::Subscription.expects(:update).with("sub_1", cancel_at_period_end: true)
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:update).with("sub_1", cancel_at_period_end: false)
+    @account.reactivate
+  end
+
+  test "incineration cancels the subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "monthly_v1", status: "active")
+
+    Stripe::Subscription.expects(:cancel).with("sub_1")
+    @account.incinerate
+
+    assert_not Account::Subscription.exists?(account_id: @account.id)
+  end
+
+  test "free accounts don't talk to Stripe when cancelled" do
+    Stripe::Subscription.expects(:update).never
+    @account.cancel(initiated_by: users(:mike))
+  end
+end
diff --git a/saas/test/models/account/limited_test.rb b/saas/test/models/account/limited_test.rb
new file mode 100644
index 0000000..13494ad
--- /dev/null
+++ b/saas/test/models/account/limited_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::LimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "card limit on the free plan" do
+    @account.update_column :cards_count, 1_000
+    assert @account.card_limit_reached?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column :cards_count, 1_001
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.remaining_cards_count
+  end
+
+  test "nearing the card limit from 100 cards out" do
+    @account.update_column :cards_count, 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.remaining_cards_count
+
+    @account.update_column :cards_count, 1_001
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans don't limit cards" do
+    @account.update_column :cards_count, 50_000
+    @account.comp
+
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.card_limit_reached?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "override and reset limits" do
+    @account.override_limits(card_count: 1_001, bytes_used: 2.gigabytes)
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.override_limits(card_count: 10)
+    assert_not @account.exceeding_card_limit?
+    assert_equal @account.bytes_used, @account.billed_bytes_used
+
+    @account.reset_overridden_limits
+    assert_nil @account.overridden_limits
+    assert_nil @account.reload.overridden_limits
+    assert_equal @account.cards_count, @account.billed_cards_count
+  end
+
+  test "overriding nothing resets" do
+    @account.override_limits(card_count: 5)
+    @account.override_limits
+    assert_nil @account.reload.overridden_limits
+  end
+
+  test "overrides must be non-negative integers" do
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: -1) }
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_limits(card_count: "lots") }
+  end
+
+  test "storage exceptions never shrink the plan allowance" do
+    @account.comp
+    @account.add_storage_exception(2.gigabytes)
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..0ccc552
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    Plan.find(:monthly_extra_storage_v1).stubs(:stripe_price_id).returns("price_plus")
+  end
+
+  test "sync a Stripe subscription found by customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_1")
+
+    Account::Subscription.sync_from_stripe(stripe_subscription(cancel_at: 1.month.from_now.to_i))
+
+    subscription = @account.reload.subscription
+    assert_equal "sub_1", subscription.stripe_subscription_id
+    assert_equal "monthly_extra_storage_v1", subscription.plan_key
+    assert subscription.canceling?
+    assert_equal Plan.find(:monthly_extra_storage_v1), @account.plan
+  end
+
+  test "sync falls back to the account in the metadata" do
+    Account::Subscription.sync_from_stripe(stripe_subscription(metadata: { account_id: @account.id }))
+    assert_equal "cus_1", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "unknown customers are ignored" do
+    assert_nil Account::Subscription.sync_from_stripe(stripe_subscription)
+  end
+
+  test "late events about an old subscription don't clobber the current one" do
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_2", plan_key: "monthly_v1", status: "active")
+
+    Account::Subscription.sync_from_stripe(stripe_subscription(id: "sub_1", status: "canceled"))
+
+    assert_equal [ "sub_2", "active" ], [ @account.subscription.reload.stripe_subscription_id, @account.subscription.status ]
+  end
+
+  private
+    def stripe_subscription(id: "sub_1", status: "active", cancel_at: nil, metadata: {})
+      Stripe::Subscription.construct_from \
+        id: id, object: "subscription", customer: "cus_1", status: status, cancel_at: cancel_at, metadata: metadata,
+        items: { object: "list", data: [ { id: "si_1", price: { id: "price_plus" }, current_period_end: 1.month.from_now.to_i } ] }
+    end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..e06f433
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "approved pricing" do
+    assert_equal [ 0, 1_000, 1.gigabyte ], [ Plan.free.price, Plan.free.card_limit, Plan.free.storage_limit ]
+    assert_equal [ 20, 5.gigabytes ], [ Plan.unlimited.price, Plan.unlimited.storage_limit ]
+
+    unlimited_plus = Plan.find(:monthly_extra_storage_v1)
+    assert_equal [ "Unlimited+", 25, 500.gigabytes ], [ unlimited_plus.name, unlimited_plus.price, unlimited_plus.storage_limit ]
+  end
+
+  test "only the free plan limits cards" do
+    assert Plan.free.limit_cards?
+    assert Plan.paid.none?(&:limit_cards?)
+  end
+
+  test "find by key or stripe price" do
+    assert_equal Plan.unlimited, Plan.find("monthly_v1")
+    assert_nil Plan.find("nope")
+    assert_nil Plan.find_by_stripe_price_id(nil)
+
+    Plan.unlimited.stubs(:stripe_price_id).returns("price_unlimited")
+    assert_equal Plan.unlimited, Plan.find_by_stripe_price_id("price_unlimited")
+  end
+
+  test "next plan with more storage" do
+    assert_equal Plan.unlimited, Plan.with_more_storage_than(1.gigabyte)
+    assert_equal Plan.find(:monthly_extra_storage_v1), Plan.with_more_storage_than(5.gigabytes)
+    assert_nil Plan.with_more_storage_than(500.gigabytes)
+  end
+end
