@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Card::CardLimited::PublishingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "cannot publish when the free cards have run out" do
+    accounts(:initech).override_limits(card_count: 1_001)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "cannot publish through the API either" do
+    accounts(:initech).override_limits(card_count: 1_001)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug, format: :json)
+
+    assert_response :forbidden
+  end
+
+  test "can publish the last free card" do
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid accounts publish past the free limit" do
+    accounts(:initech).override_limits(card_count: 5_000)
+    accounts(:initech).comp
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "staff are exempt" do
+    accounts(:initech).override_limits(card_count: 1_001)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
