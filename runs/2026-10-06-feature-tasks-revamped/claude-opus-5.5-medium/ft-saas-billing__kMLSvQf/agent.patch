+module StripeRedirection
+  extend ActiveSupport::Concern
+
+  included do
+    rescue_from Stripe::StripeError, with: :stripe_unavailable
+  end
+
+  private
+    def redirect_to_stripe(session)
+      redirect_to session.url, allow_other_host: true
+    end
+
+    def stripe_unavailable(error)
+      Rails.error.report(error, handled: true)
+      redirect_to main_app.account_settings_path(anchor: "billing"), alert: "Billing is unavailable right now. Please try again in a few minutes."
+    end
+
+    def billing_settings_url
+      main_app.account_settings_url(anchor: "billing")
+    end
+end
diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..16a0712
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,36 @@
+class Stripe::WebhooksController < ApplicationController
+  SUBSCRIPTION_EVENTS = %w[
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+    customer.subscription.paused
+    customer.subscription.resumed
+  ]
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    if event = verified_event
+      handle event
+      head :ok
+    else
+      head :bad_request
+    end
+  end
+
+  private
+    def verified_event
+      Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV["STRIPE_WEBHOOK_SECRET"])
+    rescue JSON::ParserError, Stripe::SignatureVerificationError
+      nil
+    end
+
+    def handle(event)
+      case event.type
+      when *SUBSCRIPTION_EVENTS
+        Account::Subscription.sync_from_stripe(event.data.object)
+      end
+    end
+end
