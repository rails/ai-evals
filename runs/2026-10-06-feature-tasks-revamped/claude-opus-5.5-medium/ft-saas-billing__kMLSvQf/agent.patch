+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  def create
+    override_limits
+  end
+
+  def update
+    override_limits
+  end
+
+  def destroy
+    @account.reset_overridden_limits
+    redirect_to_account notice: "Overridden limits removed"
+  end
+
+  private
+    def override_limits
+      @account.override_limits(**overridden_limits_params)
+      redirect_to_account notice: "Limits overridden"
+    rescue ActiveRecord::RecordInvalid => error
+      redirect_to_account alert: error.record.errors.full_messages.to_sentence
+    end
+
+    # Blank fields mean "don't override this one".
+    def overridden_limits_params
+      params.expect(overridden_limits: %i[ card_count bytes_used ]).to_h.symbolize_keys.transform_values(&:presence)
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..a43799c
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,27 @@
+class Admin::AccountsController < AdminController
+  include Admin::AccountScoped
+
+  skip_before_action :set_account, only: :index
+
+  layout "public"
+
+  def index
+    @query = params[:q].to_s.strip
+    @accounts = matching_accounts.includes(:subscription, :billing_waiver).order(created_at: :desc).limit(100)
+  end
+
+  def show
+    @owner = @account.users.owner.first
+  end
+
+  private
+    def matching_accounts
+      if @query.present?
+        Account.where("accounts.name LIKE ?", "%#{Account.sanitize_sql_like(@query)}%")
+          .or(Account.where(external_account_id: @query))
+          .or(Account.where(id: User.joins(:identity).where(identities: { email_address: @query.downcase }).select(:account_id)))
+      else
+        Account.all
+      end
+    end
+end
