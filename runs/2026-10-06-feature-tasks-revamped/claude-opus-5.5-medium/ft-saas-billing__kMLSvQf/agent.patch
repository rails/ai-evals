+require "test_helper"
+
+class Card::CardLimited::CreationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @board = boards(:miltons_wish_list)
+    accounts(:initech).update_column :cards_count, 100 # Clear of the fixture card numbers
+  end
+
+  test "API creation is refused once the free cards have run out" do
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: accounts(:initech).slug, format: :json), params: { card: { title: "One more" } }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "API creation works with cards left" do
+    accounts(:initech).override_limits(card_count: 999)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: accounts(:initech).slug, format: :json), params: { card: { title: "One more" } }
+    end
+
+    assert_response :created
+  end
+
+  test "drafting still works when out of cards" do
+    accounts(:initech).override_limits(card_count: 5_000)
+
+    post board_cards_path(@board, script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert_match %r{/cards/\d+/draft}, response.location
+  end
+end
diff --git a/saas/test/controllers/card/card_limited/publishing_test.rb b/saas/test/controllers/card/card_limited/publishing_test.rb
