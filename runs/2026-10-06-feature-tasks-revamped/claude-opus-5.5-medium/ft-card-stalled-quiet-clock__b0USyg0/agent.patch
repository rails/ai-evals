diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..eb1aad9
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @card.comments.destroy_all
+  end
+
+  test "comments from several people within a third of the auto-close period are a burst" do
+    comment_on @card, by: :david
+    comment_on @card, by: :kevin
+    assert_nil @card.reload.burst
+
+    comment_on @card, by: :david
+    assert @card.reload.burst
+  end
+
+  test "comments from a single person are not a burst" do
+    3.times { comment_on @card, by: :david }
+    assert_nil @card.reload.burst
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    window = entropies(:writebook_board).auto_postpone_period / 3
+
+    comment_on @card, by: :david
+    travel window + 1.day
+    comment_on @card, by: :kevin
+    comment_on @card, by: :david
+    assert_nil @card.reload.burst
+
+    comment_on @card, by: :kevin
+    assert @card.reload.burst
+  end
+
+  test "assigning is a burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.burst
+  end
+
+  test "reopening is a burst" do
+    @card.close
+    assert_nil @card.reload.burst
+
+    @card.reopen
+    assert @card.reload.burst
+  end
+
+  test "a card with a burst stalls after two weeks without activity" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 13.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.days
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "a card without a burst never stalls" do
+    travel 30.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets a stalled card" do
+    @card.toggle_assignment users(:kevin)
+    travel 15.days
+    assert @card.reload.stalled?
+
+    @card.reactions.create!(content: "👍")
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.toggle_assignment users(:kevin)
+    @card.close
+    travel 15.days
+    assert_not @card.reload.stalled?
+
+    @card.reopen
+    @card.postpone
+    travel 15.days
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "stalling changes the cache version" do
+    @card.toggle_assignment users(:kevin)
+    version = @card.reload.cache_version
+
+    travel 15.days
+    assert_not_equal version, @card.reload.cache_version
+  end
+
+  private
+    def comment_on(card, by:)
+      card.comments.create!(creator: users(by), body: "Hey")
+    end
+end
