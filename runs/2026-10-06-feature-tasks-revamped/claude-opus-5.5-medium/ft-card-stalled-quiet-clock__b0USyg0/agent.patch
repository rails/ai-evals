diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..a41163e
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,58 @@
+# A card gets a burst of attention when several people comment on it in a short
+# time, or when someone assigns or reopens it. A card that had a burst and then
+# sees no activity for a while is stalled. Any activity on the card resets it.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 14.days
+  BURST_MINIMUM_COMMENTS = 3
+  BURST_MINIMUM_COMMENTERS = 2
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    has_one :burst, dependent: :destroy, class_name: "Card::Burst"
+
+    scope :stalled, -> { active.joins(:burst).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    burst.present? && active? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def burst_at
+    burst&.updated_at
+  end
+
+  def detect_burst_from(event)
+    record_burst if burst_triggered_by?(event)
+  end
+
+  # Stalling happens with the passage of time, without the card changing, so it's part of the cache version.
+  def cache_version
+    [ super, ("stalled" if stalled?) ].compact.join("-").presence
+  end
+
+  private
+    def burst_triggered_by?(event)
+      event.action.in?(BURST_ACTIONS) || (event.action.comment_created? && comments_burst?)
+    end
+
+    def comments_burst?
+      commenter_ids = comments.by_user.where(created_at: burst_window.ago..).pluck(:creator_id)
+      commenter_ids.size >= BURST_MINIMUM_COMMENTS && commenter_ids.uniq.size >= BURST_MINIMUM_COMMENTERS
+    end
+
+    def burst_window
+      (auto_postpone_period / 3.0).seconds
+    end
+
+    def record_burst
+      if burst
+        burst.touch
+      else
+        create_burst!
+      end
+    rescue ActiveRecord::RecordNotUnique
+      reload_burst.touch
+    end
+end
