+class Notification::BundleMailer < ApplicationMailer
+  helper_method :notification_payload
+
+  def notification(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.to_a
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      "#{@notifications.size} new #{"notification".pluralize(@notifications.size)} in Fizzy"
+    end
+
+    def notification_payload(notification)
+      notification.payload
+    end
+
+    def default_url_options
+      if @bundle
+        super.merge(script_name: @bundle.account.slug)
+      else
+        super
+      end
+    end
+end
