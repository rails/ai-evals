--- /dev/null
+++ b/app/models/notification/bundling.rb
@@ -0,0 +1,22 @@
+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :bundle
+    after_update_commit :rebundle, if: :renotified?
+  end
+
+  private
+    def bundle
+      user.bundle(self, time: created_at)
+    end
+
+    # Notifications are reused per card, so a fresh source means a new notification.
+    def rebundle
+      user.bundle(self, time: updated_at)
+    end
+
+    def renotified?
+      (saved_change_to_source_id? || saved_change_to_source_type?) && !read?
+    end
+end
