+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  test "notification digest lists the bundle's unread notifications" do
+    user = users(:kevin)
+    bundle = user.notification_bundles.create!(starts_at: 2.weeks.ago, ends_at: Time.current)
+
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_match "new notification", email.subject
+    assert_match %r{/cards/}, email.html_part.body.to_s
+    assert_match "/#{user.account.slug.delete_prefix("/")}/notifications/settings", email.text_part.body.to_s
+  end
+end
