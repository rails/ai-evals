+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json { set_page_and_extract_portion_from activities }
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events
+        .where(action: Event::API_ACTIONS)
+        .preloaded
+        .reverse_chronologically
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
