+# Activities
+
+Activities are the events that happen in an account, such as cards being added, assigned, moved, renamed, or closed, and comments being posted. They mirror the activity timeline shown in the web app.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated flat list of activity the current user has access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only return activity created by these users |
+| `board_ids[]` | Only return activity on these boards |
+
+__Actions:__
+
+`card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`,
+`card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, `comment_created`.
+
+__Particulars:__
+
+| Action | Keys |
+|--------|------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+The `url` opens the card. For `comment_created` activity, it opens the card and jumps to the comment.
+`eventable` is a [card](cards.md) or a [comment](comments.md), depending on `eventable_type`.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_title_changed",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David renamed \"New title\" (was: \"Old title\")",
+    "particulars": {
+      "old_title": "Old title",
+      "new_title": "New title"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": { "id": "03f5v9zo9qlcwwpyc0ascnikz", "number": 3, "title": "New title", "...": "..." },
+    "board": { "id": "03f5v9zkft4hj9qq0lsn9ohcm", "name": "Fizzy", "...": "..." },
+    "creator": { "id": "03f5v9zjw7pz8717a4no1h8a7", "name": "David", "...": "..." }
+  }
+]
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..96d6490
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array, newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert body.any?
+
+    times = body.map { |e| Time.iso8601(e["created_at"]) }
+    assert_equal times.sort.reverse, times
+  end
+
+  test "index includes event attributes" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:logo_assignment_jz).id }
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, event.keys.sort
+    assert_equal "card_assigned", event["action"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal card_url(cards(:logo)), event["url"]
+    assert_equal events(:logo_assignment_jz).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+    assert_equal cards(:logo).id, event.dig("eventable", "id")
+    assert_equal boards(:writebook).id, event.dig("board", "id")
+    assert_equal users(:david).id, event.dig("creator", "id")
+  end
+
+  test "comment events link to the comment on the card" do
+    get activities_path, as: :json
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    comment = events(:layout_commented).eventable
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal({}, event["particulars"])
+  end
+
+  test "title, board and triage particulars" do
+    card = cards(:logo)
+    with_current_user(:kevin) do
+      card.update!(title: "New title")
+      card.triage_into(columns(:writebook_on_hold))
+    end
+    Event.create!(board: card.board, creator: users(:kevin), eventable: card, action: "card_board_changed", particulars: { particulars: { new_board: "Writebook" } })
+    Event.create!(board: card.board, creator: users(:kevin), eventable: card, action: "card_collection_changed", particulars: { particulars: { new_collection: "Writebook" } })
+
+    get activities_path, as: :json
+    body = @response.parsed_body
+
+    title = body.find { |e| e["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "New title" }, title["particulars"]) if title
+    assert title
+
+    moved = body.find { |e| e["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, moved["particulars"])
+
+    triaged = body.find { |e| e["action"] == "card_triaged" }
+    assert_equal({ "column" => columns(:writebook_on_hold).name }, triaged["particulars"])
+
+    assert_not body.any? { |e| e["action"] == "card_collection_changed" }
+  end
+
+  test "filter by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |e| e.dig("creator", "id") == users(:kevin).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert @response.parsed_body.all? { |e| e.dig("board", "id") == boards(:private).id }
+  end
+
+  test "only accessible activity is returned" do
+    sign_in_as :david
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_equal [], @response.parsed_body
+
+    get activities_path, as: :json
+    assert @response.parsed_body.none? { |e| e.dig("board", "id") == boards(:private).id }
+  end
+end
+
+class ActivitiesControllerPaginationTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as :kevin }
+
+  test "paginates with a Link header" do
+    card = cards(:logo)
+    60.times { |i| Event.create!(board: card.board, creator: users(:kevin), eventable: card, action: "card_reopened", created_at: i.minutes.ago) }
+
+    get activities_path, as: :json
+    assert_match(/rel="next"/, @response.headers["Link"])
+    first_ids = @response.parsed_body.map { |e| e["id"] }
+
+    get activities_path(page: 2), as: :json
+    assert_response :success
+    assert_empty first_ids & @response.parsed_body.map { |e| e["id"] }
+  end
+
+  test "html is not supported" do
+    get activities_path
+    assert_response :not_acceptable
+  end
+end
