diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..3f02fb9
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create defaults the reacter and account" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "🎉")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal accounts("37s"), reaction.account
+  end
+
+  test "content is required and limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_not comment.reactions.build(content: "   ").valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+    assert comment.reactions.build(content: "a" * 16).valid?
+  end
+
+  test "content is squished" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  so   good  ")
+
+    assert_equal "so good", reaction.content
+  end
+
+  test "all emoji" do
+    assert Reaction.new(content: "👍").all_emoji?
+    assert Reaction.new(content: "❤️ 👍🏽").all_emoji?
+    assert_not Reaction.new(content: "Great 👍").all_emoji?
+    assert_not Reaction.new(content: "100").all_emoji?
+  end
+
+  test "reacting counts as activity on the card and refreshes the comment" do
+    comment = comments(:logo_agreement_jz)
+
+    freeze_time
+    travel 1.minute
+
+    assert_changes -> { comment.card.reload.last_active_at } do
+      assert_changes -> { comment.reload.updated_at } do
+        comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "reactions are broadcast to everyone viewing the card" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "🔥")
+    perform_enqueued_jobs
+
+    appended = capture_turbo_stream_broadcasts(comment.card).find { it["action"] == "append" }
+    assert_equal ActionView::RecordIdentifier.dom_id(comment, :reactions_list), appended["target"]
+    assert_includes appended.to_html, "🔥"
+    assert_includes appended.to_html, %(action="/#{comment.account.external_account_id}/cards/#{comment.card.number}/comments/#{comment.id}/reactions/#{reaction.id}")
+
+    reaction.destroy
+
+    removed = capture_turbo_stream_broadcasts(comment.card).find { it["action"] == "remove" }
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), removed["target"]
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { Reaction.count }, -comment.reactions.count do
+      comment.destroy
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..ae0c2ab
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,140 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "react to a comment" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+
+      find(".reaction__input").fill_in with: "Ship it 🚀"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "Ship it 🚀"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+
+      # Ready for the next one
+      find(".reactions__trigger").click
+      assert_selector ".reaction__input"
+    end
+
+    assert_equal "Ship it 🚀", @comment.reactions.last.content
+  end
+
+  test "cancel a reaction" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Never mind"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").send_keys :escape
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal 2, @comment.reactions.count
+  end
+
+  test "pick an emoji" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[title='Party popper']").click
+
+      assert_equal "🎉", find(".reaction__input").value
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "🎉"
+    end
+  end
+
+  test "remove your own reaction" do
+    visit card_url(@card)
+    mine = reactions(:logo_agreement_jz_david)
+    theirs = reactions(:logo_agreement_jz_kevin)
+
+    within "##{dom_id(theirs)}" do
+      find("span", text: theirs.content).click
+      assert_no_selector ".reaction__delete"
+    end
+
+    within "##{dom_id(mine)}" do
+      assert_no_selector ".reaction__delete"
+      find("span", text: mine.content).click
+      find(".reaction__delete").click
+    end
+
+    assert_no_selector "##{dom_id(mine)}"
+    assert_selector "##{dom_id(theirs)}"
+    assert_not Reaction.exists?(mine.id)
+  end
+
+  test "reactions from others land live" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    reaction = Current.set(session: sessions(:kevin)) { @comment.reactions.create!(content: "Live one") }
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    within_reactions do
+      assert_selector "##{dom_id(reaction)}", text: "Live one", wait: 5
+    end
+
+    reaction.destroy
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    assert_no_selector "##{dom_id(reaction)}", wait: 5
+  end
+
+  test "a reaction in progress survives a live update" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Typing…"
+    end
+
+    Current.set(session: sessions(:kevin)) do
+      @comment.reactions.create!(content: "Meanwhile")
+      @card.update!(title: "Retitled elsewhere")
+    end
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    # The new title only arrives with the page refresh, so the morph has happened by now.
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    within_reactions do
+      assert_selector ".reaction", text: "Meanwhile"
+      assert_equal "Typing…", find(".reaction__input").value
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
