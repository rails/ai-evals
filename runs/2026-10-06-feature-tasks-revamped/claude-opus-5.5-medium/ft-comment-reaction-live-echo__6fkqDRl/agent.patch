@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "card page shows each comment's reactions strip with who left each reaction" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}.reactions" do
+      assert_select "##{dom_id(@comment, :reactions_list)}.reactions__list .reaction", count: 2
+      assert_select "##{dom_id(reactions(:logo_agreement_jz_kevin))}" do
+        assert_select ".reaction__avatar a[aria-label=?]", users(:kevin).name
+        assert_select "span.txt-small.txt-medium", text: "👍"
+        assert_select "form[action=?] button.reaction__delete", card_comment_reaction_path(@card, @comment, reactions(:logo_agreement_jz_kevin))
+      end
+      assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger[href=?] img[src*=boost-color]", new_card_comment_reaction_path(@card, @comment)
+    end
+  end
+
+  test "system comments have no reactions strip" do
+    get card_path(@card)
+
+    assert_select "##{dom_id(comments(:logo_1), :reactions)}", count: 0
+  end
+
+  test "new renders the reaction input inside the trigger frame" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form.reaction__form[action=?]", card_comment_reactions_path(@card, @comment) do
+      assert_select "input.reaction__input[name='reaction[content]'][maxlength='16'][required]"
+      assert_select "button.reaction__submit-btn"
+      assert_select "a.reaction__cancel-btn[href=?]", card_comment_reactions_path(@card, @comment)
+      assert_select ".reaction__emoji-list button", count: EmojiHelper::REACTIONS.size
+    end
+  end
+
+  test "cancel puts the trigger back" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger"
+  end
+
+  test "create appends the reaction to the strip and restores the trigger" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.reacter
+
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list) do
+      assert_select "##{dom_id(reaction)}.reaction", text: /🎉/
+    end
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :new_reaction) do
+      assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger"
+      assert_select "form", count: 0
+    end
+  end
+
+  test "create rejects reactions longer than 16 characters" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy your own reaction" do
+    reaction = reactions(:logo_agreement_jz_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "can't destroy someone else's reaction" do
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reactions(:logo_agreement_jz_david)), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can't react on cards you can't access" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ "👍", "Great work" ], @response.parsed_body.pluck("content")
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:logo_agreement_jz_kevin)), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Great 👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Great 👍", @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    delete card_comment_reaction_path(@card, @comment, reactions(:logo_agreement_jz_kevin)), as: :json
+
+    assert_response :no_content
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
