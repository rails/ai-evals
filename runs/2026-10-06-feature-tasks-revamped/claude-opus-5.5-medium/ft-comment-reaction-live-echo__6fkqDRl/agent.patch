+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(@card, @comment), class: "reaction reaction__form expanded",
+        data: { controller: "form morph-guard reaction-form",
+                action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit keydown.esc->form#cancel:stop" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label reaction__avatar" do %>
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, class: "input reaction__input", required: true, autofocus: true, autocomplete: "off",
+          maxlength: 16, placeholder: "React…",
+          data: { form_target: "input", reaction_form_target: "input", "1p-ignore": "true",
+                  action: "compositionstart->form#compositionStart compositionend->form#compositionEnd" } %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false"
+          data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle" aria-haspopup="dialog">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog" aria-label="Pick an emoji">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn btn--plain" title="<%= name %>" aria-label="<%= name %>"
+                  data-action="reaction-form#insert dialog#close" data-reaction-form-emoji-param="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment), class: "reaction__cancel-btn btn btn--circle borderless",
+          title: "Cancel (#{hotkey_label([ "esc" ])})", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
