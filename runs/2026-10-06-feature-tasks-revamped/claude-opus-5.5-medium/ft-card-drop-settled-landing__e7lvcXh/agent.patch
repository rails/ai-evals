diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..52b8609
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,153 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card into another column moves it there right away, at the column's own order" do
+    card, triage = cards(:text), columns(:writebook_triage)
+    visit_board
+
+    order = drag card, to: dom_id(triage)
+
+    # Already in place when the pointer is released: after the golden card, before the rest
+    assert cards(:logo).golden?
+    assert_equal dom_id(cards(:logo), :article), order.first
+    assert_equal dom_id(card, :article), order.second
+    assert_selector "##{dom_id(columns(:writebook_in_progress))} .cards__expander-count[data-count='0']", visible: :all
+
+    wait_until { card.reload.column == triage }
+    assert_no_board_shift dom_id(triage)
+  end
+
+  test "a golden card goes to the very top of the column" do
+    card, in_progress = cards(:logo), columns(:writebook_in_progress)
+    visit_board
+
+    order = drag card, to: dom_id(in_progress)
+
+    assert_equal [ dom_id(card, :article), dom_id(cards(:text), :article) ], order
+    wait_until { card.reload.column == in_progress }
+    assert_no_board_shift dom_id(in_progress)
+  end
+
+  test "dragging a card to Done, Not Now and Maybe?" do
+    card = cards(:logo)
+    visit_board
+
+    order = drag card, to: "closed-cards"
+    assert_equal dom_id(card, :article), order.first
+    assert_selector "##{dom_id(card, :article)} .card__closed", visible: :all
+    wait_until { card.reload.closed? }
+    assert_selector "##{dom_id(card, :article)} .card__closed-date", visible: :all, wait: 5 # synced with the server render
+    assert_no_board_shift "closed-cards"
+
+    order = drag card, to: "not-now"
+    assert_equal dom_id(card, :article), order.first
+    assert_selector "##{dom_id(card, :article)}.card--postponed", visible: :all
+    wait_until { card.reload.postponed? }
+    assert_no_board_shift "not-now"
+
+    order = drag card, to: "maybe"
+    assert_includes order, dom_id(card, :article)
+    wait_until { card.reload.awaiting_triage? }
+    assert_no_board_shift "maybe"
+  end
+
+  test "dropping a card back where it was does nothing" do
+    card = cards(:logo)
+    visit_board
+    before = card_order(dom_id(columns(:writebook_triage)))
+
+    order = drag card, to: dom_id(columns(:writebook_triage))
+
+    assert_equal before, order
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  test "the hovered column lights up and the dragged card dims while dragging" do
+    card = cards(:logo)
+    visit_board
+
+    states = page.evaluate_script(<<~JS, dom_id(card, :article), "closed-cards")
+      (() => {
+        const [ card, target ] = [ document.getElementById(arguments[0]), document.getElementById(arguments[1]) ]
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        return { hovered: target.classList.contains("drag-and-drop__hover-container") }
+      })()
+    JS
+    assert states["hovered"]
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+
+    page.execute_script("arguments[0].dispatchEvent(new DragEvent('dragend', { bubbles: true }))", find("##{dom_id(card, :article)}", visible: :all))
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "a failed save puts the card back" do
+    card = cards(:logo)
+    visit_board
+    triage = dom_id(columns(:writebook_triage))
+    before = card_order(triage)
+    page.execute_script("document.getElementById('closed-cards').dataset.dragAndDropUrl = '/missing/__card__'")
+
+    drag card, to: "closed-cards"
+
+    assert_selector "##{triage} ##{dom_id(card, :article)}", visible: :all
+    assert_equal before, card_order(triage)
+    assert_not card.reload.closed?
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      @board.columns.each do |column|
+        assert_selector "##{dom_id(column)} .cards__list", visible: :all
+      end
+      assert_selector "#closed-cards .cards__list", visible: :all
+      assert_selector "#not-now .cards__list", visible: :all
+    end
+
+    # Simulates dragging a card onto a container and returns the order of the container's cards
+    # right after the drop, in the same tick: before any request could complete.
+    def drag(card, to:)
+      page.evaluate_script(<<~JS, dom_id(card, :article), to)
+        (() => {
+          const [ card, target ] = [ document.getElementById(arguments[0]), document.getElementById(arguments[1]) ]
+          const dataTransfer = new DataTransfer()
+          const fire = (element, type) => element.dispatchEvent(new DragEvent(type, { bubbles: true, cancelable: true, dataTransfer }))
+          fire(card, "dragstart")
+          fire(target, "dragover")
+          fire(target, "drop")
+          fire(card, "dragend")
+          return Array.from(target.querySelectorAll(".cards__list .card[data-card-number]")).map(card => card.id)
+        })()
+      JS
+    end
+
+    def card_order(container_id)
+      page.evaluate_script("Array.from(document.querySelectorAll('#' + arguments[0] + ' .cards__list .card[data-card-number]')).map(card => card.id)", container_id)
+    end
+
+    def assert_no_board_shift(container_id)
+      optimistic = card_order(container_id)
+      sleep 0.5 # let the in-place sync land
+      assert_equal optimistic, card_order(container_id), "cards shifted after the save"
+
+      visit_board
+      assert_equal optimistic, card_order(container_id), "the server order differs from the optimistic one"
+    end
+
+    def wait_until(timeout: 5)
+      deadline = Time.current + timeout
+      until yield
+        raise "Timed out waiting" if Time.current > deadline
+        sleep 0.1
+      end
+    end
+end
