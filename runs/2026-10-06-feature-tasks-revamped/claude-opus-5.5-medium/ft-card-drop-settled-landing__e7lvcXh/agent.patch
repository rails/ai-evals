diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..7eb3662
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,290 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { FetchRequest, get } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between the board's columns (Not Now, Maybe?, each column, Done) by dragging.
+//
+// The move is optimistic: when the card is dropped it's placed right away at the position the
+// server will give it (columns keep their own order, so we never insert where the pointer is),
+// it's restyled for its new place, and the column counts are adjusted. The save happens in the
+// background; once it succeeds the card's markup is synced in place with the server render, and
+// if it fails the move is undone.
+const DRAG_DATA_TYPE = "application/x-fizzy-card"
+
+// Containers whose cards are sorted golden-first, then most recently active. Moving a card always
+// touches it, so it lands at the top (after the golden cards, unless it's golden itself).
+// Not Now (most recently active first) and Done (most recently closed first) just put it on top.
+const GOLDEN_FIRST_STATUSES = [ "maybe", "column" ]
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { previewUrl: String, defaultColor: String }
+
+  initialize() {
+    this.pendingSaves = new Map()
+    this.moveGenerations = new Map()
+  }
+
+  disconnect() {
+    this.#finishDrag()
+  }
+
+  // Actions
+
+  async dragStart(event) {
+    const item = this.#itemFor(event.target)
+    const container = item && this.#containerFor(item)
+    if (!container) return
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData(DRAG_DATA_TYPE, item.dataset.cardNumber)
+
+    this.dragItem = item
+    this.sourceContainer = container
+
+    // Wait so the browser takes the drag image from the card before it's dimmed
+    await nextFrame()
+    if (this.dragItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    if (!this.dragItem) return
+
+    const container = this.#dropContainerFor(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.dragItem || !this.hoveredContainer) return
+
+    if (!this.hoveredContainer.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    if (!this.dragItem) return
+
+    const container = this.#dropContainerFor(event.target)
+    if (!container) return
+
+    event.preventDefault()
+
+    const item = this.dragItem
+    const source = this.sourceContainer
+    this.#finishDrag()
+    this.#move(item, source, container)
+  }
+
+  dragEnd() {
+    this.#finishDrag()
+  }
+
+  // Private
+
+  #finishDrag() {
+    this.dragItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.dragItem = null
+    this.sourceContainer = null
+  }
+
+  #highlight(container) {
+    if (this.hoveredContainer === container) return
+
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    container?.classList.add(this.hoverContainerClass)
+    this.hoveredContainer = container
+  }
+
+  #itemFor(element) {
+    const item = this.#elementFrom(element)?.closest("[data-drag-and-drop-target~='item']")
+    return this.itemTargets.includes(item) ? item : null
+  }
+
+  #containerFor(element) {
+    const container = this.#elementFrom(element)?.closest("[data-drag-and-drop-target~='container']")
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  // Cards move between places, not within one: the source isn't a drop target
+  #dropContainerFor(element) {
+    const container = this.#containerFor(element)
+    return container && container !== this.sourceContainer ? container : null
+  }
+
+  #elementFrom(node) {
+    return node instanceof Element ? node : node?.parentElement
+  }
+
+  // Moving
+
+  #move(item, source, target) {
+    const number = item.dataset.cardNumber
+    const generation = (this.moveGenerations.get(number) || 0) + 1
+    this.moveGenerations.set(number, generation)
+
+    const snapshot = {
+      original: item.cloneNode(true),
+      parent: item.parentNode,
+      nextSibling: item.nextSibling,
+      source,
+      target
+    }
+
+    this.#place(item, target)
+    this.#restyle(item, target)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(target, +1)
+
+    const save = this.#save(number, target)
+
+    save.then(
+      () => this.#syncCard(number, save).catch(error => console.error("Couldn't refresh the moved card", error)),
+      error => {
+        console.error("Couldn't move the card", error)
+
+        if (this.moveGenerations.get(number) === generation) {
+          this.#revert(item, snapshot)
+        } else {
+          // The card was moved again since; the server is the only reliable source of truth now
+          Turbo.visit(window.location.href, { action: "replace" })
+        }
+      }
+    )
+  }
+
+  #place(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (!list) {
+      // The column's cards haven't loaded yet, they will include this one when they do
+      item.remove()
+      return
+    }
+
+    const cards = Array.from(list.querySelectorAll(".card[data-card-number]")).filter(card => card !== item)
+    const goldenFirst = GOLDEN_FIRST_STATUSES.includes(container.dataset.dragAndDropStatus) && !this.#isGolden(item)
+    const anchor = goldenFirst ? cards.find(card => !this.#isGolden(card)) : cards[0]
+
+    if (anchor) {
+      anchor.before(item)
+    } else if (cards.length > 0) {
+      cards[cards.length - 1].after(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #isGolden(card) {
+    return card.classList.contains("golden-effect")
+  }
+
+  // Make the card look like it belongs to its new place right away; the server render
+  // replaces these approximations once the save succeeds.
+  #restyle(item, container) {
+    const status = container.dataset.dragAndDropStatus
+
+    if (status === "column") {
+      item.style.setProperty("--card-color", container.dataset.dragAndDropColor)
+    } else if (status === "maybe" || status === "not_now") {
+      item.style.setProperty("--card-color", this.defaultColorValue)
+    }
+
+    item.classList.toggle("card--postponed", status === "not_now")
+    item.classList.toggle("card--active", status === "maybe" || status === "column")
+
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+    if (status === "closed") item.querySelector(".card__body")?.append(this.#closedStamp())
+
+    const columnName = status === "column" ? container.dataset.columnName : null
+    item.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.textContent.trim() === columnName)
+    })
+  }
+
+  #closedStamp() {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+    stamp.innerHTML = `<span class="card__closed-title" data-text="Done">Done</span>`
+    return stamp
+  }
+
+  #adjustCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count[data-count]")
+    if (!counter) return
+
+    const count = Math.max(0, parseInt(counter.dataset.count, 10) + delta)
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+  }
+
+  #revert(item, { original, parent, nextSibling, source, target }) {
+    this.#adjustCount(source, +1)
+    this.#adjustCount(target, -1)
+
+    item.remove()
+    if (!parent.isConnected) return
+
+    if (nextSibling && nextSibling.parentNode === parent) {
+      parent.insertBefore(original, nextSibling)
+    } else {
+      parent.append(original)
+    }
+  }
+
+  // Saving
+
+  // Saves for the same card run one after the other, so quick successive moves land in order
+  #save(number, container) {
+    const url = container.dataset.dragAndDropUrl.replace("__card__", encodeURIComponent(number))
+    const method = container.dataset.dragAndDropMethod
+
+    const previous = this.pendingSaves.get(number) || Promise.resolve()
+    const save = previous.catch(() => {}).then(() => this.#request(method, url))
+
+    this.pendingSaves.set(number, save)
+    save.catch(() => {}).finally(() => {
+      if (this.pendingSaves.get(number) === save) this.pendingSaves.delete(number)
+    })
+
+    return save
+  }
+
+  async #request(method, url) {
+    const response = await new FetchRequest(method, url, { responseKind: "json" }).perform()
+    if (!response.ok) throw new Error(`${method.toUpperCase()} ${url} responded with ${response.statusCode}`)
+    return response
+  }
+
+  // Bring the card's markup in line with the server (stamps, hotkey URLs, bubbles...) without
+  // moving it: its position is already the right one.
+  async #syncCard(number, save) {
+    if (this.#hasNewerSave(number, save)) return
+
+    const response = await get(this.previewUrlValue.replace("__card__", encodeURIComponent(number)), { responseKind: "html" })
+    if (!response.ok) return
+
+    const template = document.createElement("template")
+    template.innerHTML = (await response.html).trim()
+    const fresh = template.content.querySelector(".card")
+    const current = fresh && this.itemTargets.find(item => item.id === fresh.id)
+
+    if (!current || current === this.dragItem || this.#hasNewerSave(number, save)) return
+
+    const selected = current.getAttribute("aria-selected")
+    Turbo.morphElements(current, fresh)
+    if (selected !== null) current.setAttribute("aria-selected", selected)
+  }
+
+  #hasNewerSave(number, save) {
+    return this.pendingSaves.has(number) && this.pendingSaves.get(number) !== save
+  }
+}
