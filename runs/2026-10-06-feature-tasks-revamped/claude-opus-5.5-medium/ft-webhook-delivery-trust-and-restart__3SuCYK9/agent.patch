diff --git a/test/jobs/event/webhook_dispatch_job_test.rb b/test/jobs/event/webhook_dispatch_job_test.rb
new file mode 100644
index 0000000..9925e55
--- /dev/null
+++ b/test/jobs/event/webhook_dispatch_job_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Event::WebhookDispatchJobTest < ActiveJob::TestCase
+  test "creating an event enqueues a dispatch after commit" do
+    assert_enqueued_with job: Event::WebhookDispatchJob do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+  end
+
+  test "creates one delivery for each active webhook subscribed to the action on the board" do
+    subscribed = webhooks(:active)
+    other_action = Webhook.create!(name: "Comments", url: "https://example.com/c", board: boards(:writebook), subscribed_actions: %w[ comment_created ])
+    other_board = Webhook.create!(name: "Elsewhere", url: "https://example.com/e", board: boards(:private), subscribed_actions: %w[ card_published ])
+    inactive = Webhook.create!(name: "Off", url: "https://example.com/o", board: boards(:writebook), subscribed_actions: %w[ card_published ], active: false)
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      Event::WebhookDispatchJob.perform_now(event)
+    end
+
+    assert subscribed.deliveries.exists?(event: event)
+    [ other_action, other_board, inactive ].each { assert_not it.deliveries.exists?(event: event) }
+  end
+
+  test "does not match actions that merely contain the subscribed action" do
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: %w[ card_postponed ])
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_auto_postponed")
+
+    Event::WebhookDispatchJob.perform_now(event)
+
+    assert_not webhook.deliveries.exists?(event: event)
+  end
+
+  test "running the dispatch again does not duplicate deliveries" do
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+
+    Event::WebhookDispatchJob.perform_now(event)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event::WebhookDispatchJob.perform_now(event)
+      end
+    end
+  end
+
+  test "end to end: an event results in exactly one POST to the receiver" do
+    stub_dns_resolution "93.184.216.34"
+    webhook = webhooks(:active)
+    request = stub_request(:post, webhook.url).to_return(status: 202)
+
+    perform_enqueued_jobs do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+
+    assert_requested request, times: 1
+    assert webhook.deliveries.ordered.first.succeeded?
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..e7e158c
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = webhook_delinquency_trackers(:active)
+  end
+
+  test "is created along with a webhook" do
+    webhook = Webhook.create!(name: "New", url: "https://example.com/hook", board: boards(:writebook))
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "is lazily created for webhooks without one" do
+    @tracker.delete
+    assert @webhook.reload.delinquency_tracker.persisted?
+  end
+
+  test "a success resets the failure streak" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    @tracker.record_delivery_of(delivery_with(code: 200))
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "failures are counted and the streak start is remembered" do
+    freeze_time do
+      @tracker.record_delivery_of(delivery_with(code: 500))
+      @tracker.record_delivery_of(delivery_with(error: "connection_timeout"))
+
+      assert_equal 2, @tracker.reload.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+
+  test "pending or in-progress deliveries are not counted" do
+    @tracker.record_delivery_of(Webhook::Delivery.new(webhook: @webhook, state: :in_progress))
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+
+  test "ten consecutive failures within an hour do not deactivate" do
+    travel_to 59.minutes.ago do
+      @tracker.record_delivery_of(delivery_with(code: 500))
+    end
+    9.times { @tracker.record_delivery_of(delivery_with(code: 500)) }
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "failing for over an hour with fewer than ten failures does not deactivate" do
+    travel_to 2.hours.ago do
+      @tracker.record_delivery_of(delivery_with(code: 500))
+    end
+    8.times { @tracker.record_delivery_of(delivery_with(code: 500)) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    travel_to 61.minutes.ago do
+      @tracker.record_delivery_of(delivery_with(code: 500))
+    end
+    8.times { @tracker.record_delivery_of(delivery_with(code: 500)) }
+    assert @webhook.reload.active?
+
+    @tracker.record_delivery_of(delivery_with(code: 500))
+    assert_not @webhook.reload.active?
+  end
+
+  test "a success in between restarts the streak" do
+    travel_to 2.hours.ago do
+      5.times { @tracker.record_delivery_of(delivery_with(code: 500)) }
+    end
+    @tracker.record_delivery_of(delivery_with(code: 204))
+    9.times { @tracker.record_delivery_of(delivery_with(code: 500)) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a webhook resets the tracker" do
+    @webhook.update!(active: false)
+    @tracker.update!(consecutive_failures_count: 12, first_failure_at: 2.hours.ago)
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  private
+    def delivery_with(**response)
+      Webhook::Delivery.new(webhook: @webhook, event: events(:layout_commented), state: :completed, response: response)
+    end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..c83633d 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,154 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "creating a delivery enqueues it for delivery" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:text_published))
+    end
+  end
+
+  test "deliver POSTs a signed JSON payload and logs the outcome" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+
+    request = stub_request(:post, webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_requested request, times: 1
+    assert_requested :post, webhook.url do |req|
+      body = JSON.parse(req.body)
+      assert_equal events(:text_published).id, body["id"]
+      assert_equal "card_published", body["action"]
+      assert_equal "application/json", req.headers["Content-Type"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, req.body), req.headers["X-Webhook-Signature"]
+    end
+
+    delivery.reload
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal "application/json", delivery.sanitized_request[:headers]["Content-Type"]
+  end
+
+  test "deliver sends exactly once even if run again" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    request = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+    delivery.deliver
+    Webhook::Delivery.find(delivery.id).deliver
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested request, times: 1
+  end
+
+  test "a delivery that another worker already claimed is not sent" do
+    webhook = webhooks(:active)
+    request = stub_request(:post, webhook.url)
+
+    webhook_deliveries(:in_progress).deliver
+    webhook_deliveries(:successfully_completed).deliver
+
+    assert_not_requested request
+  end
+
+  test "only one delivery can exist per webhook and event" do
+    Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:text_published))
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:text_published))
+    end
+  end
+
+  test "non-2xx responses are logged as failures" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+    assert_equal 1, webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "network errors are logged" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+
+    { Net::OpenTimeout => "connection_timeout", Errno::ECONNREFUSED => "destination_unreachable",
+      OpenSSL::SSL::SSLError => "failed_tls", SocketError => "dns_lookup_failed" }.each do |exception, error|
+      delivery = Webhook::Delivery.create!(webhook: webhook, event: Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published"))
+      stub_request(:post, webhook.url).to_raise(exception)
+
+      delivery.deliver
+
+      assert delivery.reload.failed?
+      assert_equal error, delivery.response[:error]
+    end
+  end
+
+  test "private destinations are refused" do
+    stub_dns_resolution "127.0.0.1"
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    request = stub_request(:post, webhook.url)
+
+    delivery.deliver
+
+    assert_not_requested request
+    assert delivery.reload.failed?
+    assert_equal "private_uri", delivery.response[:error]
+  end
+
+  test "unexpected errors mark the delivery as errored and are not retried" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    Net::HTTP.any_instance.stubs(:request).raises(ArgumentError, "boom")
+
+    assert_raises(ArgumentError) { delivery.deliver }
+    assert delivery.reload.errored?
+    assert_equal "internal_error", delivery.response[:error]
+
+    Net::HTTP.any_instance.unstub(:request)
+    request = stub_request(:post, webhook.url)
+    delivery.deliver
+    assert_not_requested request
+  end
+
+  test "slack payload" do
+    stub_dns_resolution PUBLIC_IP
+    webhook = webhooks(:active)
+    webhook.update_column :url, "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: events(:text_published))
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_requested :post, webhook.url do |req|
+      text = JSON.parse(req.body)["text"]
+      assert_match %r{<https?://\S+/cards/\S+\|↗︎>}, text
+      assert_no_match(/</, text.gsub(/<http[^>]+>/, ""))
+    end
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    fresh = Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:text_published), created_at: 6.days.ago)
+    stale = Webhook::Delivery.create!(webhook: webhooks(:active), event: events(:logo_assignment_david), created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+
+  PUBLIC_IP = "93.184.216.34"
 end
