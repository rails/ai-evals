+++ b/db/migrate/20260710120000_add_unique_index_on_webhook_deliveries_webhook_and_event.rb
@@ -0,0 +1,31 @@
+class AddUniqueIndexOnWebhookDeliveriesWebhookAndEvent < ActiveRecord::Migration[8.2]
+  def up
+    remove_duplicate_deliveries
+
+    add_index :webhook_deliveries, %i[ webhook_id event_id ], unique: true
+    remove_index :webhook_deliveries, :webhook_id
+  end
+
+  def down
+    add_index :webhook_deliveries, :webhook_id
+    remove_index :webhook_deliveries, %i[ webhook_id event_id ]
+  end
+
+  private
+    def remove_duplicate_deliveries
+      duplicates = select_rows(<<~SQL)
+        SELECT webhook_id, event_id FROM webhook_deliveries
+        GROUP BY webhook_id, event_id HAVING COUNT(*) > 1
+      SQL
+
+      duplicates.each do |webhook_id, event_id|
+        ids = select_values(<<~SQL)
+          SELECT id FROM webhook_deliveries
+          WHERE webhook_id = #{quote(webhook_id)} AND event_id = #{quote(event_id)}
+          ORDER BY created_at ASC, id ASC
+        SQL
+
+        execute "DELETE FROM webhook_deliveries WHERE id IN (#{ids.drop(1).map { quote(it) }.join(", ")})"
+      end
+    end
+end
