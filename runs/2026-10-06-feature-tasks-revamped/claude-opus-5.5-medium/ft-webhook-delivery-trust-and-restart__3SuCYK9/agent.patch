diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..839d88c
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,48 @@
+# Switches off a webhook whose receiver keeps failing: at least
+# DELINQUENCY_THRESHOLD consecutive failed deliveries, spanning at least
+# DELINQUENCY_DURATION since the first failure in the streak.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  DELINQUENCY_THRESHOLD = 10
+  DELINQUENCY_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_delivery_of(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      record_failure
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update_columns consecutive_failures_count: 0, first_failure_at: nil, updated_at: Time.current
+  end
+
+  def delinquent?
+    too_many_consecutive_failures? && failing_for_too_long?
+  end
+
+  private
+    # Atomic so concurrent deliveries to the same webhook are all counted.
+    def record_failure
+      now = Time.current
+
+      self.class.where(id: id).update_all [
+        "consecutive_failures_count = COALESCE(consecutive_failures_count, 0) + 1, " \
+        "first_failure_at = COALESCE(first_failure_at, ?), updated_at = ?", now, now
+      ]
+
+      reload
+    end
+
+    def too_many_consecutive_failures?
+      consecutive_failures_count.to_i >= DELINQUENCY_THRESHOLD
+    end
+
+    def failing_for_too_long?
+      first_failure_at.present? && first_failure_at <= DELINQUENCY_DURATION.ago
+    end
+end
