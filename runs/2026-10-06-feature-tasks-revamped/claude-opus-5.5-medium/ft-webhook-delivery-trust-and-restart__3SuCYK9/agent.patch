   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +52,111 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1 && reload
+    end
+
+    def perform_delivery
+      record_attempt
+      webhook.delinquency_tracker.record_delivery_of(self)
+    end
+
+    def record_attempt
+      self.request = { headers: headers }
+      self.response = perform_request
+      self.state = :completed
+      save!
+    rescue => error
+      update_columns state: :errored, response: { "error" => "internal_error" }, updated_at: Time.current
+      raise error
+    end
+
+    def perform_request
+      if resolved_ip.nil?
+        { error: :private_uri }
+      else
+        http.request(post_request).then { |response| { code: response.code.to_i } }
+      end
+    rescue Resolv::ResolvTimeout, Resolv::ResolvError, SocketError
+      { error: :dns_lookup_failed }
+    rescue Net::OpenTimeout, Net::ReadTimeout, Errno::ETIMEDOUT
+      { error: :connection_timeout }
+    rescue Errno::ECONNREFUSED, Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ECONNRESET, EOFError, IOError
+      { error: :destination_unreachable }
+    rescue OpenSSL::SSL::SSLError
+      { error: :failed_tls }
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri, headers).tap { |request| request.body = payload }
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def resolved_ip
+      return @resolved_ip if defined?(@resolved_ip)
+      @resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = resolved_ip
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+        http.write_timeout = ENDPOINT_TIMEOUT
+        http.max_retries = 0 # Net::HTTP would otherwise silently resend idempotent-looking requests
+      end
+    end
+
+    def headers
+      @headers ||= {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def content_type
+      if webhook.for_campfire?
+        "text/html"
+      elsif webhook.for_basecamp?
+        "application/x-www-form-urlencoded"
+      else
+        "application/json"
+      end
+    end
+
+    def payload
+      @payload ||= if webhook.for_campfire?
+        render_payload(formats: :html)
+      elsif webhook.for_basecamp?
+        { content: render_payload(formats: :html) }.to_query
+      elsif webhook.for_slack?
+        { text: html_to_mrkdwn(render_payload(formats: :html)) }.to_json
+      else
+        render_payload(formats: :json)
+      end
+    end
+
+    def render_payload(**options)
+      webhook.renderer.render(template: "webhooks/event", assigns: { event: event }, layout: false, **options).strip
+    end
+
+    def html_to_mrkdwn(html)
+      fragment = Nokogiri::HTML5.fragment(html)
+      fragment.css("a").each { |link| link.replace(Nokogiri::XML::Text.new("<#{link["href"]}|#{link.text}>", fragment.document)) }
+      fragment.text.squish
+    end
 end
