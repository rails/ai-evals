@@ -0,0 +1,17 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :triggered_by, ->(event) { where(board_id: event.board_id).triggered_by_action(event.action) }
+    scope :triggered_by_action, ->(action) do
+      where("subscribed_actions LIKE ? ESCAPE '!'", "%#{sanitize_sql_like(action.to_s.to_json, "!")}%")
+    end
+  end
+
+  # Creates the single delivery for this event. The unique index on
+  # (webhook_id, event_id) guarantees a retried dispatch never queues a
+  # second POST for the same event.
+  def trigger(event)
+    deliveries.create_or_find_by!(event: event) if account.active?
+  end
+end
