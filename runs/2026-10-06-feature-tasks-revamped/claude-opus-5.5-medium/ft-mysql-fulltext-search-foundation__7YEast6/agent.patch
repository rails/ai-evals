+<li class="search__result" id="<%= dom_id(card, :search_result) %>">
+  <%= link_to card_path(card), class: "search__result-link", data: { turbo_frame: "_top" } do %>
+    <strong class="search__result-title">#<%= card.number %> <%= highlight_search_terms(card.title, terms) %></strong>
+    <span class="search__result-board txt-subtle txt-small"><%= card.board.name %></span>
+  <% end %>
+
+  <% if snippet = search_snippet(card.search_snippet_for(terms), terms) %>
+    <p class="search__result-snippet txt-small"><%= snippet %></p>
+  <% end %>
+</li>
