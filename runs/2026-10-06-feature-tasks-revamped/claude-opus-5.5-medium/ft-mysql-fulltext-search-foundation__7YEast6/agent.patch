+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = Card.search_terms_from(@query)
+
+    set_page_and_extract_portion_from found_cards
+  end
+
+  private
+    def found_cards
+      if @terms.any?
+        Current.user.accessible_cards.search(@terms).preload(:board).with_rich_text_description.reverse_chronologically
+      else
+        Card.none
+      end
+    end
+end
