diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..a07fd60
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "blank query" do
+    get search_path
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "find cards by title with highlighted matches" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#search_result_card_#{cards(:logo).id} mark", text: "logo"
+  end
+
+  test "find cards by description" do
+    cards(:layout).update!(description: "The sidebar overlaps <strong>everything</strong>")
+
+    get search_path(q: "SIDEBAR")
+    assert_select "#search_result_card_#{cards(:layout).id}"
+    assert_select "#search_result_card_#{cards(:layout).id} .search__result-snippet mark", text: "sidebar"
+  end
+
+  test "find cards by comment body" do
+    cards(:text).comments.create!(body: "Try a bigger zebrafont", creator: users(:kevin))
+
+    get search_path(q: "zebrafont")
+    assert_select ".search__result", count: 1
+    assert_select "#search_result_card_#{cards(:text).id} .search__result-snippet mark", text: "zebrafont"
+  end
+
+  test "ampersands match" do
+    cards(:layout).update!(description: "Salt & pepper")
+
+    get search_path(q: "salt & pepper")
+    assert_select "#search_result_card_#{cards(:layout).id}"
+  end
+
+  test "newest first" do
+    cards(:logo).update_columns(created_at: 1.day.ago, title: "Quokka one")
+    cards(:layout).update_columns(created_at: 1.hour.ago, title: "Quokka two")
+
+    get search_path(q: "quokka")
+    ids = css_select(".search__result").map { |li| li["id"] }
+    assert_equal [ "search_result_card_#{cards(:layout).id}", "search_result_card_#{cards(:logo).id}" ], ids
+  end
+
+  test "only boards the user can access" do
+    cards(:logo).update_columns(board_id: boards(:private).id, title: "Secret wombat")
+
+    get search_path(q: "wombat")
+    assert_select "#search_result_card_#{cards(:logo).id}"
+  end
+
+  test "boards the user cannot access are excluded" do
+    cards(:logo).update_columns(board_id: boards(:private).id, title: "Secret wombat")
+
+    logout_and_sign_in_as :david
+    get search_path(q: "wombat")
+    assert_select ".search__result", count: 0
+  end
+
+  test "drafts and their comments never turn up" do
+    card = cards(:text)
+    card.comments.create!(body: "Narwhal notes", creator: users(:kevin))
+    card.update_columns(status: "drafted", title: "Narwhal title")
+
+    get search_path(q: "narwhal")
+    assert_select ".search__result", count: 0
+  end
+
+  test "html in content is escaped" do
+    cards(:logo).update_columns(title: "<script>alert(1)</script> giraffe")
+
+    get search_path(q: "giraffe")
+    assert_no_match "<script>alert(1)", response.body
+    assert_select "mark", text: "giraffe"
+  end
+
+  test "like wildcards are literal" do
+    get search_path(q: "%")
+    assert_select ".search__result", count: 0
+  end
+end
