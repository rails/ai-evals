@@ -0,0 +1,24 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    text = text.to_s
+
+    if terms.any?
+      pattern = Regexp.union(terms.sort_by { |term| -term.length }.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) })
+
+      safe_join(text.split(/(#{pattern})/).map.with_index { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      text
+    end
+  end
+
+  def search_snippet(text, terms, radius: 100)
+    text = text.to_s.squish
+    match = terms.filter_map { |term| text.downcase.index(term.downcase) }.min
+
+    if match
+      start = [ match - radius, 0 ].max
+      finish = [ match + radius, text.length ].min
+      highlight_search_terms("#{"…" if start > 0}#{text[start...finish]}#{"…" if finish < text.length}", terms)
+    end
+  end
+end
