diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..e76d035
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,55 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(terms) do
+      Array(terms).inject(published) { |cards, term| cards.matching_search_term(term) }
+    end
+
+    scope :matching_search_term, ->(term) do
+      where(arel_table[:title].matches(search_pattern_for(term), "\\"))
+        .or(where(id: descriptions_matching(term).select(:record_id)))
+        .or(where(id: comments_matching(term).select(:card_id)))
+    end
+  end
+
+  class_methods do
+    def search_terms_from(query)
+      query.to_s.scan(/"([^"]+)"|(\S+)/).flatten.compact.map(&:strip).compact_blank.uniq
+    end
+
+    def descriptions_matching(term)
+      ActionText::RichText.where(record_type: name, name: "description").merge(rich_text_bodies_matching(term))
+    end
+
+    def comments_matching(term)
+      Comment.joins(:rich_text_body).merge(rich_text_bodies_matching(term))
+    end
+
+    def rich_text_bodies_matching(term)
+      body = ActionText::RichText.arel_table[:body]
+
+      # Rich text bodies are stored as HTML, so also look for the escaped form of the term
+      condition = [ term, term.encode(xml: :text) ].uniq
+        .map { |variant| body.matches(search_pattern_for(variant), "\\") }
+        .reduce(:or)
+
+      ActionText::RichText.where(condition)
+    end
+
+    def search_pattern_for(term)
+      "%#{sanitize_sql_like(term)}%"
+    end
+  end
+
+  def search_snippet_for(terms)
+    texts = [ description.to_plain_text, *comments_matching_any(terms).map { |comment| comment.body.to_plain_text } ]
+    texts.find { |text| terms.any? { |term| text.downcase.include?(term.downcase) } }
+  end
+
+  private
+    def comments_matching_any(terms)
+      comment_ids = terms.flat_map { |term| self.class.comments_matching(term).where(card_id: id).pluck(:id) }
+      comments.where(id: comment_ids).with_rich_text_body.order(created_at: :desc)
+    end
+end
