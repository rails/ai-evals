+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="search panel panel--wide flex center borderless unpad flex-column gap-half margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…", class: "input", autofocus: true, aria: { label: "Search" } %>
+    <%= form.button "Search", type: :submit, name: nil, class: "btn" %>
+  <% end %>
+
+  <% if @terms.any? %>
+    <%= with_automatic_pagination :search_results, @page, tag_element: :ol, class: "search__results" do %>
+      <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { terms: @terms } %>
+    <% end %>
+
+    <% if @page.first? && @page.records.empty? %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+</div>
