+<%= turbo_frame_tag @comment, :new_reaction do %>
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(@card, @comment), class: "reaction reaction__form expanded",
+        data: { controller: "form reaction-form morph-guard", action: "submit->form#preventEmptySubmit keydown.esc->form#cancel:stop" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label reaction__avatar", style: "--avatar-size: auto" do %>
+      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true %>
+      <span class="for-screen-reader">Your reaction</span>
+    <% end %>
+
+    <%= form.text_field :content, class: "input reaction__input", required: true, autofocus: true, autocomplete: "off",
+          maxlength: Reaction::MAXIMUM_LENGTH,
+          data: { form_target: "input", reaction_form_target: "input", validation_message: "Type an emoji or a few words" } %>
+
+    <div class="reaction__menu" data-controller="dialog"
+         data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle" title="Pick an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn btn--circle borderless" title="<%= name %>"
+                    data-action="reaction-form#pick" data-reaction-form-content-param="<%= emoji %>">
+              <%= emoji %>
+              <span class="for-screen-reader"><%= name %></span>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless", title: "Add your reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add your reaction</span>
+    <% end %>
+
+    <%= link_to card_comment_reactions_path(@card, @comment), class: "reaction__cancel-btn btn btn--circle borderless",
+          title: "Cancel", data: { form_target: "cancel" } do %>
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    <% end %>
+  <% end %>
+<% end %>
