@@ -0,0 +1,24 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_LENGTH = 16
+  EMOJI_ONLY = /\A[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Emoji_Modifier}\p{Regional_Indicator}\u200d\ufe0f\u20e3]+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_LENGTH }
+
+  scope :ordered, -> { order(:created_at, :id) }
+
+  delegate :card, to: :comment
+
+  def emoji?
+    content.match?(EMOJI_ONLY)
+  end
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+end
