diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..5903dd8
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,44 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.includes(:reacter)
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reactions_url(@card, @comment, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.where(reacter: Current.user).find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..0875233
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,64 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions are rendered inside cached comments, so the markup is the same for
+// everyone. This reveals the delete button only to whoever left the reaction.
+export default class extends Controller {
+  static targets = [ "deleteButton" ]
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    this.restore()
+  }
+
+  // A broadcasted page refresh morphs the server markup back in, dropping the
+  // attributes added on connect.
+  restore() {
+    if (this.#reactedByCurrentUser) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("aria-expanded", this.#expanded)
+    }
+  }
+
+  toggle(event) {
+    if (!this.#reactedByCurrentUser || event.target.closest("form")) return
+
+    if (this.#expanded) {
+      this.collapse()
+    } else {
+      this.#expand()
+    }
+  }
+
+  collapse() {
+    if (this.#expanded) {
+      this.element.classList.remove(this.expandedClass)
+      this.element.setAttribute("aria-expanded", "false")
+      this.deleteButtonTarget.setAttribute("tabindex", "-1")
+    }
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  remove() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  #expand() {
+    this.element.classList.add(this.expandedClass)
+    this.element.setAttribute("aria-expanded", "true")
+    this.deleteButtonTarget.removeAttribute("tabindex")
+    this.deleteButtonTarget.focus()
+  }
+
+  get #expanded() {
+    return this.element.classList.contains(this.expandedClass)
+  }
+
+  get #reactedByCurrentUser() {
+    return Current.user?.id === this.reacterIdValue
+  }
+}
