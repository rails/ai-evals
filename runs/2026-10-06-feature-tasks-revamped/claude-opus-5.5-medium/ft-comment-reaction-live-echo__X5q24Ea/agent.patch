diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..493c278
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "index" do
+    get card_comment_reactions_path(@card, @comment)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reaction_list)} .reaction", count: 2
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} a.reactions__trigger[href=?]", new_card_comment_reaction_path(@card, @comment)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal [ "👍", "Love it" ], @response.parsed_body.pluck("content").sort_by { it == "👍" ? 0 : 1 }
+    assert_equal users(:kevin).id, @response.parsed_body.find { it["content"] == "👍" }.dig("reacter", "id")
+  end
+
+  test "new" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :new_reaction)} form.reaction__form" do
+      assert_select "input.reaction__input[name=?][maxlength=16]", "reaction[content]"
+      assert_select "button.reaction__submit-btn"
+      assert_select "a.reaction__cancel-btn[href=?]", card_comment_reactions_path(@card, @comment)
+    end
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reaction_list) do
+      assert_select ".reaction", text: /🎉/
+    end
+    assert_turbo_stream action: :update, target: dom_id(@comment, :new_reaction) do
+      assert_select "a.reactions__trigger"
+      assert_select "form", count: 0
+    end
+
+    reaction = @comment.reactions.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Ship it" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Ship it", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create rejects blank and overly long reactions" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "  " } }, as: :turbo_stream
+      assert_response :unprocessable_entity
+
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create on an inaccessible card" do
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy another user's reaction" do
+    reaction = reactions(:logo_agreement_david_text)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "reactions show on the card with who left them" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}" do
+      assert_select ".reaction[data-reaction-reacter-id-value=?]", users(:kevin).id, text: /👍/
+      assert_select ".reaction .reaction__avatar[title=?]", users(:david).name
+      assert_select "a.reactions__trigger img[src*=boost-color]"
+    end
+  end
+end
