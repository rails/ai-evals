new file mode 100644
index 0000000..e532b4b
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create with defaults from the comment and the current user" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "🎉")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comments(:logo_agreement_jz).account, reaction.account
+  end
+
+  test "content is stripped, required, and at most 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_equal "Nice", comment.reactions.create!(content: "  Nice  ").content
+    assert_not comment.reactions.build(content: "   ").valid?
+    assert comment.reactions.build(content: "a" * 16).valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "reacting touches the comment so cached renders refresh" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_changes -> { comment.reload.updated_at } do
+      comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reacting broadcasts a refresh to everyone looking at the card" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_turbo_stream_broadcasts comment.card do
+      comment.reactions.create!(content: "👍")
+      perform_enqueued_jobs
+    end
+  end
+
+  test "removing a reaction broadcasts a refresh to everyone looking at the card" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+
+    assert_turbo_stream_broadcasts reaction.card do
+      reaction.destroy
+      perform_enqueued_jobs
+    end
+  end
+
+  test "emoji only" do
+    assert Reaction.new(content: "👍").emoji?
+    assert Reaction.new(content: "👍🏽❤️").emoji?
+    assert_not Reaction.new(content: "Love it").emoji?
+    assert_not Reaction.new(content: "👍 nice").emoji?
+  end
+
+  test "reactions are ordered by creation" do
+    comment = comments(:logo_agreement_jz)
+    latest = comment.reactions.create!(content: "🚀")
+
+    assert_equal latest, comment.reactions.reload.last
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..00043cf
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,175 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Ship it!"
+      find(".reaction__submit-btn").click
+
+      assert_selector "#{reaction_list} .reaction", text: "Ship it!"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "🎉"
+      find(".reaction__input").send_keys :enter
+
+      assert_selector "#{reaction_list} .reaction", text: "🎉"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal [ "👍", "Love it", "Ship it!", "🎉" ].sort, @comment.reactions.pluck(:content).sort
+  end
+
+  test "picking an emoji reacts with it" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button[title='Fire']").click
+
+      assert_selector "#{reaction_list} .reaction", text: "🔥"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "canceling brings the button back without reacting" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "nah"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+
+      find(".reactions__trigger").click
+      find(".reaction__input").send_keys :escape
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal 2, @comment.reactions.count
+  end
+
+  test "removing your own reaction" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    mine = "##{dom_id(reactions(:logo_agreement_kevin_thumbs_up))}"
+    theirs = "##{dom_id(reactions(:logo_agreement_david_text))}"
+
+    within_reactions do
+      assert_selector "#{mine}.reaction--deleteable"
+      assert_no_selector "#{theirs}.reaction--deleteable"
+
+      find(theirs).click
+      assert_no_selector "#{theirs} .reaction__delete", visible: true
+
+      assert_no_selector "#{mine} .reaction__delete", visible: true
+      find(mine).click
+      find("#{mine} .reaction__delete button").click
+
+      assert_no_selector mine
+      assert_selector theirs
+    end
+
+    assert_not Reaction.exists?(reactions(:logo_agreement_kevin_thumbs_up).id)
+  end
+
+  test "everyone looking at the card sees reactions land" do
+    using_session :david do
+      sign_in_as users(:david)
+      visit card_url(@card)
+      wait_for_cable_subscriptions
+    end
+
+    using_session :kevin do
+      sign_in_as users(:kevin)
+      visit card_url(@card)
+
+      within_reactions do
+        find(".reactions__trigger").click
+        find(".reaction__input").fill_in with: "Live!"
+        find(".reaction__submit-btn").click
+        assert_selector ".reaction", text: "Live!"
+      end
+    end
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    using_session :david do
+      within_reactions do
+        assert_selector ".reaction", text: "Live!", wait: 5
+      end
+    end
+
+    using_session :kevin do
+      within_reactions do
+        find(".reaction", text: "Live!").click
+        find(".reaction", text: "Live!").find(".reaction__delete button").click
+        assert_no_selector ".reaction", text: "Live!"
+      end
+    end
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    using_session :david do
+      within_reactions do
+        assert_no_selector ".reaction", text: "Live!", wait: 5
+        assert_selector ".reaction", text: "👍"
+      end
+    end
+  end
+
+  test "an open reaction input survives someone else's reaction landing" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "typing"
+    end
+
+    Current.set(session: sessions(:david)) { @comment.reactions.create!(content: "🚀") }
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within_reactions do
+      assert_selector ".reaction", text: "🚀", wait: 5
+      assert_equal "typing", find(".reaction__input").value
+      assert_no_selector ".reactions__trigger"
+      assert_selector ".reaction--deleteable", text: "👍"
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def reaction_list
+      "##{dom_id(@comment, :reaction_list)}"
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
