+++ b/app/models/storage/tracked.rb
@@ -0,0 +1,16 @@
+# Records whose attachments count towards storage: cards (image and description),
+# comments (body) and boards (public description).
+module Storage::Tracked
+  def record_storage_change(delta)
+    storage_owners.each { it.add_storage_entry(delta) }
+  end
+
+  private
+    def storage_owners
+      [ account, storage_board ].compact.uniq
+    end
+
+    def storage_board
+      board
+    end
+end
diff --git a/config/initializers/storage_tracking.rb b/config/initializers/storage_tracking.rb
new file mode 100644
index 0000000..5a5cc28
--- /dev/null
+++ b/config/initializers/storage_tracking.rb
@@ -0,0 +1,48 @@
+module ActiveStorage
+  module Extensions
+    # Records storage changes for attachments that belong to a Storage::Tracked record,
+    # directly (card images) or through one of its rich texts (embedded files).
+    #
+    # Entries are recorded in the same transaction that creates or removes the attachment.
+    # Besides +destroy+, attachments are removed with +delete+ when purged or detached.
+    module StorageTracking
+      extend ActiveSupport::Concern
+
+      included do
+        after_create :track_storage_addition
+        after_destroy :track_storage_removal
+      end
+
+      def delete
+        track_storage_removal if persisted?
+        super
+      end
+
+      private
+        def track_storage_addition
+          track_storage_change blob_byte_size
+        end
+
+        def track_storage_removal
+          track_storage_change -blob_byte_size
+        end
+
+        def track_storage_change(delta)
+          storage_tracked_record&.record_storage_change(delta)
+        end
+
+        def storage_tracked_record
+          attached_to = record.is_a?(ActionText::RichText) ? record.record : record
+          attached_to if attached_to.is_a?(Storage::Tracked)
+        end
+
+        def blob_byte_size
+          blob&.byte_size.to_i
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorage::Extensions::StorageTracking
+end
