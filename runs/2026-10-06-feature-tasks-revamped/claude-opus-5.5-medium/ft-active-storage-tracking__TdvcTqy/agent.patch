--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,13 @@
+# Tracks the bytes used by card images and by files embedded in board descriptions,
+# card descriptions and comments.
+#
+# Changes are appended to a ledger of Storage::Entry records (one per owner: the
+# account and the board) as attachments come and go. That's a cheap insert that never
+# contends with other writers. A background job then folds pending entries into the
+# owner's Storage::Total, so reading the usage is a single-row lookup no matter how
+# many attachments an account has.
+module Storage
+  def self.table_name_prefix
+    "storage_"
+  end
+end
