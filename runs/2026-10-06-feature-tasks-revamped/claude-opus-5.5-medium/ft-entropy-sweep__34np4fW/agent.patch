diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..daa18ac 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,28 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due skips cards that are closed, drafted, or already postponed" do
+    stale = 1.day.ago - entropies(:writebook_board).auto_postpone_period
+
+    cards(:logo).close
+    cards(:shipping).update!(status: :drafted)
+    cards(:logo, :shipping).each { |card| card.update_column :last_active_at, stale }
+
+    assert_no_difference -> { Card::NotNow.count } do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.closed?
+    assert cards(:shipping).reload.drafted?
+  end
+
+  test "auto postpone all due skips boards without any entropy" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 1.year.ago)
+
+    assert_nothing_raised { Card.auto_postpone_all_due }
+    assert_not cards(:logo).reload.postponed?
+  end
 end
