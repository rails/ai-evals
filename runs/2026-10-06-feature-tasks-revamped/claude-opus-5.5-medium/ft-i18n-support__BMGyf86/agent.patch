@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Card::Eventable::LocalizedSystemCommentTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "system comments are stored in the default locale, even when the actor uses another one" do
+    I18n.with_locale(:ja) { @card.toggle_assignment users(:kevin) }
+
+    comment = @card.comments.last
+    assert comment.creator.system?
+    assert_match "David assigned this to Kevin", comment.body.to_plain_text
+  end
+
+  test "system comments are shown in the reader's locale" do
+    @card.toggle_assignment users(:kevin)
+    comment = @card.comments.last
+
+    assert_match "David assigned this to Kevin", comment.localized_body.to_plain_text
+
+    I18n.with_locale(:ja) do
+      assert_match "DavidがこのカードをKevinに割り当てました", comment.localized_body.to_plain_text
+      assert_equal "システム", comment.creator.name
+    end
+  end
+end
