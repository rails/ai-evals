diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..f268f96
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,81 @@
+// Strings rendered client-side. Keep in sync with the locales in config/locales.
+const TRANSLATIONS = {
+  en: {
+    "back_to": "Back to %{label}",
+    "bubble.action_in": "%{action} in",
+    "bubble.today": "Today",
+    "bubble.day": { one: "day", other: "days" },
+    "bubble.stalled_for": "Stalled for",
+    "form.blank": "Please fill out this field",
+    "local_time.less_than_a_minute_ago": "Less than a minute ago",
+    "local_time.years_ago": { one: "%{count} year ago", other: "%{count} years ago" },
+    "local_time.months_ago": { one: "%{count} month ago", other: "%{count} months ago" },
+    "local_time.weeks_ago": { one: "%{count} week ago", other: "%{count} weeks ago" },
+    "local_time.days_ago": { one: "%{count} day ago", other: "%{count} days ago" },
+    "local_time.hours_ago": { one: "%{count} hour ago", other: "%{count} hours ago" },
+    "local_time.minutes_ago": { one: "%{count} minute ago", other: "%{count} minutes ago" },
+    "local_time.today": "today",
+    "local_time.yesterday": "yesterday",
+    "local_time.tomorrow": "tomorrow",
+    "local_time.in_days": "in %{count} days",
+    "local_time.days_ago_short": "%{count} days ago",
+    "multi_selection.no_selection": "No selection",
+    "sentence.words_connector": ", ",
+    "sentence.two_words_connector": " and ",
+    "sentence.last_word_connector": ", and ",
+    "sentence.choice.two_words_connector": " or ",
+    "sentence.choice.last_word_connector": ", or ",
+    "confirm": "Are you sure?"
+  },
+  ja: {
+    "back_to": "%{label}に戻る",
+    "bubble.action_in": "%{action}",
+    "bubble.today": "今日",
+    "bubble.day": { other: "日" },
+    "bubble.stalled_for": "停滞",
+    "form.blank": "このフィールドを入力してください",
+    "local_time.less_than_a_minute_ago": "1分以内",
+    "local_time.years_ago": { other: "%{count}年前" },
+    "local_time.months_ago": { other: "%{count}か月前" },
+    "local_time.weeks_ago": { other: "%{count}週間前" },
+    "local_time.days_ago": { other: "%{count}日前" },
+    "local_time.hours_ago": { other: "%{count}時間前" },
+    "local_time.minutes_ago": { other: "%{count}分前" },
+    "local_time.today": "今日",
+    "local_time.yesterday": "昨日",
+    "local_time.tomorrow": "明日",
+    "local_time.in_days": "%{count}日後",
+    "local_time.days_ago_short": "%{count}日前",
+    "multi_selection.no_selection": "未選択",
+    "sentence.words_connector": "、",
+    "sentence.two_words_connector": "、",
+    "sentence.last_word_connector": "、",
+    "sentence.choice.two_words_connector": "または",
+    "sentence.choice.last_word_connector": "、または",
+    "confirm": "よろしいですか？"
+  }
+}
+
+const INTL_LOCALES = { en: "en-US", ja: "ja-JP" }
+const DEFAULT_LOCALE = "en"
+
+export function currentLocale() {
+  const lang = (document.documentElement.lang || DEFAULT_LOCALE).split("-")[0]
+  return lang in TRANSLATIONS ? lang : DEFAULT_LOCALE
+}
+
+export function intlLocale() {
+  return INTL_LOCALES[currentLocale()]
+}
+
+export function t(key, interpolations = {}) {
+  const locale = currentLocale()
+  let entry = TRANSLATIONS[locale][key] ?? TRANSLATIONS[DEFAULT_LOCALE][key] ?? key
+
+  if (typeof entry === "object") {
+    const category = new Intl.PluralRules(intlLocale()).select(interpolations.count)
+    entry = entry[category] ?? entry.other
+  }
+
+  return entry.replace(/%\{(\w+)\}/g, (match, name) => name in interpolations ? interpolations[name] : match)
+}
