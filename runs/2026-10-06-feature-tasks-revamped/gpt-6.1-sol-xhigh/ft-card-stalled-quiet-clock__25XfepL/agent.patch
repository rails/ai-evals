new file mode 100644
index 0000000..4582be6
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,34 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def record_burst_from(event)
+    if event.action.in?(%w[ card_assigned card_reopened ]) || (event.action.comment_created? && comment_burst?(event.created_at))
+      record_burst at: event.created_at
+    end
+  end
+
+  def record_burst(at: Time.current)
+    update! last_burst_at: at
+  end
+
+  # Inactivity can change the rendered state without changing the record.
+  def cache_key
+    "#{super}/#{stalled? ? 'stalled' : 'not-stalled'}"
+  end
+
+  private
+    def comment_burst?(at)
+      recent_comments = comments.by_user.where(created_at: (at - auto_postpone_period / 3.0)..at)
+      recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+    end
+end
