diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..b1706d9
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,213 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "A card with momentum", status: :published)
+    @card.board.auto_postpone_period = 30.days
+  end
+
+  test "three comments from two people within a third of the auto-close period are a burst" do
+    comment_by :david
+    travel 5.days
+    comment_by :kevin
+    travel 5.days
+    comment_by :david
+
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_not_predicate @card, :stalled?
+    travel 2.weeks - 1.second
+    assert_not_predicate @card, :stalled?
+    travel 1.second
+    assert_predicate @card, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "comments by one person do not cause a burst" do
+    3.times { comment_by :david }
+
+    assert_nil @card.reload.last_burst_at
+    travel 2.weeks
+    assert_not_predicate @card, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comments outside the burst window do not count" do
+    comment_by :david
+    travel 10.days + 1.second
+    comment_by :kevin
+    comment_by :david
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assigning someone causes a burst" do
+    @card.toggle_assignment users(:kevin)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert_predicate @card, :stalled?
+  end
+
+  test "creating an assignment directly causes a burst" do
+    @card.assignments.create! assignee: users(:kevin), assigner: Current.user
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+  end
+
+  test "reopening causes a burst but closing does not" do
+    @card.close
+    assert_nil @card.reload.last_burst_at
+
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert_predicate @card, :stalled?
+  end
+
+  test "new activity clears stalled and restarts the inactivity clock" do
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    comment_by :david
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+  end
+
+  test "two comments from two people are not enough" do
+    comment_by :david
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    2.times { comment_by :david }
+    @card.comments.create!(creator: @card.account.system_user, body: "A system update")
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the comment window uses the account default when the board has no override" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update! auto_postpone_period: 7.days
+
+    comment_by :david
+    travel 2.days
+    comment_by :kevin
+    travel 8.hours
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "the burst window slides past older comments" do
+    comment_by :david
+    travel 11.days
+    comment_by :david
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "cold cards without bursts are not stalled" do
+    travel 1.month
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "editing card content resets stalled" do
+    %i[ title description ].each do |attribute|
+      stall_card
+      @card.update! attribute => "Changed #{attribute}"
+      assert_not_predicate @card.reload, :stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "editing and deleting a comment reset stalled" do
+    comment = comment_by :david
+    stall_card
+    comment.update! body: "Updated comment"
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    comment.destroy!
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "checklist changes reset stalled" do
+    stall_card
+    step = @card.steps.create! content: "First step"
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    step.update! completed: true
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    step.destroy!
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "tag and goldness changes reset stalled" do
+    stall_card
+    @card.toggle_tag_with "Momentum"
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    @card.toggle_tag_with "Momentum"
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    @card.gild
+    assert_not_predicate @card.reload, :stalled?
+
+    stall_card
+    @card.ungild
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "adding and removing reactions on cards and comments reset stalled" do
+    [ @card, comment_by(:david) ].each do |reactable|
+      stall_card
+      reaction = reactable.reactions.create! content: "👍"
+      assert_not_predicate @card.reload, :stalled?
+
+      stall_card
+      reaction.destroy!
+      assert_not_predicate @card.reload, :stalled?
+    end
+  end
+
+  test "unassignment is activity but not a new burst" do
+    @card.toggle_assignment users(:kevin)
+    last_burst_at = @card.reload.last_burst_at
+    travel 2.weeks
+    @card.toggle_assignment users(:kevin)
+    assert_not_predicate @card.reload, :stalled?
+    assert_equal last_burst_at, @card.last_burst_at
+  end
+
+  test "the cache key changes when a card stalls without activity" do
+    @card.toggle_assignment users(:kevin)
+    key = @card.reload.cache_key_with_version
+    travel 2.weeks
+    assert_not_equal key, @card.cache_key_with_version
+  end
+
+  private
+    def stall_card
+      @card.update! last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+      assert_predicate @card.reload, :stalled?
+    end
+
+    def comment_by(user)
+      @card.comments.create!(creator: users(user), body: "Let's move this along")
+    end
