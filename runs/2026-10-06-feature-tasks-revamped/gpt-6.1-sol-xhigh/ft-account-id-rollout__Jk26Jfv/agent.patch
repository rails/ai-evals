+        end
+      end
+
+      insert_owned(:active_storage_blobs, account)
+      insert_owned(:active_storage_attachments, account, record_type: "ActionText::RichText", record_id: "action_text_rich_texts/Comment/#{account}", blob_id: "active_storage_blobs/#{account}")
+      insert_owned(:active_storage_variant_records, account, blob_id: "active_storage_blobs/#{account}")
+      insert_owned(:active_storage_blobs, account, id: "variant/#{account}")
+      insert_owned(:active_storage_attachments, account, id: "variant_attachment/#{account}", record_type: "ActiveStorage::VariantRecord", record_id: "active_storage_variant_records/#{account}", blob_id: "variant/#{account}")
+      insert_owned(:active_storage_blobs, account, id: "preview/#{account}")
+      insert_owned(:active_storage_attachments, account, id: "preview_attachment/#{account}", record_type: "ActiveStorage::Blob", record_id: "variant/#{account}", blob_id: "preview/#{account}")
+      insert_owned(:search_records_0, account, account_id: account)
+    end
+
+    tables.each do |table|
+      insert(table, id: "orphan")
+    end
+    insert(:users, id: "missing_account", account_id: "deleted")
+    insert(:boards, id: "orphan_child", creator_id: "missing_account")
+    insert(:reactions, id: "unknown_type", reactable_type: "Unknown", reactable_id: "cards/first")
+    insert(:reactions, id: "wrong_type", reactable_type: "Comment", reactable_id: "cards/first")
+
+    migrate
+
+    @expected_accounts.each do |(table, id), account|
+      assert_equal account, @connection.select_value("SELECT account_id FROM #{table} WHERE id = #{@connection.quote(id)}"), "#{table}/#{id}"
+    end
+    tables.each do |table|
+      assert_equal @expected_accounts.keys.count { |key| key.first == table.to_s }, @connection.select_value("SELECT COUNT(*) FROM #{table}"), table.to_s
+    end
+  end
+
+  def test_backfills_join_tables_without_primary_keys
+    @connection.drop_table :filters_tags
+    @connection.create_table(:filters_tags, id: false) do |definition|
+      definition.uuid :filter_id, null: false
+      definition.uuid :tag_id, null: false
+    end
+    insert(:accounts, id: "first")
+    insert(:users, id: "user", account_id: "first")
+    insert(:filters, id: "filter", creator_id: "user")
+    insert(:filters_tags, filter_id: "filter", tag_id: "tag")
+    insert(:filters_tags, filter_id: "missing_filter", tag_id: "tag")
+
+    migrate
+
+    assert_nil @connection.primary_key(:filters_tags)
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM filters_tags")
+    assert_equal "first", @connection.select_value("SELECT account_id FROM filters_tags")
+  end
+
+  def test_requires_and_indexes_accounts_without_changing_global_tables
+    migrate
+
+    tables.each do |table|
+      assert_equal :uuid, @connection.columns(table).find { |column| column.name == "account_id" }.type
+      refute @connection.columns(table).find { |column| column.name == "account_id" }.null, table.to_s
+      assert @connection.indexes(table).any? { |index| index.columns == [ "account_id" ] }, table.to_s
+      assert_raises(ActiveRecord::NotNullViolation) { insert(table, id: "null_account") }
+    end
+    %w[accounts identities sessions identity_access_tokens magic_links action_pack_passkeys account_external_id_sequences].each do |table|
+      refute @connection.column_exists?(table, :account_id), table
+    end
+  end
+
+  def test_preserves_existing_accounts_and_indexes
+    insert(:accounts, id: "first")
+    insert(:accounts, id: "second")
+    insert(:users, id: "user", account_id: "first")
+    insert(:boards, id: "board", creator_id: "user", account_id: "second")
+    @connection.add_index :account_cancellations, :account_id, unique: true
+
+    migrate
+
+    assert_equal "second", @connection.select_value("SELECT account_id FROM boards WHERE id = 'board'")
+    assert @connection.indexes(:account_cancellations).find { |index| index.columns == [ "account_id" ] }.unique
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  private
+    def create_old_schema
+      tables.each do |table|
+        @connection.create_table(table, id: :uuid) do |definition|
+          definition.uuid :account_id if CompleteAccountIdRollout::EXISTING_TABLES.include?(table.to_s) || table.to_s.start_with?("search_records")
+        end
+      end
+      %w[accounts identities sessions identity_access_tokens magic_links action_pack_passkeys account_external_id_sequences].each do |table|
+        @connection.create_table(table, id: :uuid)
+      end
+      CompleteAccountIdRollout::PARENTS.each do |table, (_, foreign_key)|
+        @connection.add_column table, foreign_key, :uuid
+      end
+      { entropies: :container, storage_totals: :owner, mentions: :source, reactions: :reactable, action_text_rich_texts: :record, active_storage_attachments: :record }.each do |table, association|
+        @connection.add_column table, "#{association}_id", :uuid
+        @connection.add_column table, "#{association}_type", :string
+      end
+      @connection.add_column :active_storage_attachments, :blob_id, :uuid
+      @connection.add_column :active_storage_variant_records, :blob_id, :uuid
+    end
+
+    def tables
+      CompleteAccountIdRollout::NEW_TABLES + CompleteAccountIdRollout::EXISTING_TABLES + [ "search_records_0" ]
+    end
+
+    def insert_owned(table, account, **attributes)
+      id = attributes.delete(:id) || "#{table}/#{account}"
+      insert(table, **attributes, id: id)
+      @expected_accounts[[ table.to_s, id ]] = account
+    end
+
+    def insert(table, **attributes)
+      columns = attributes.keys.map { |column| @connection.quote_column_name(column) }.join(", ")
+      values = attributes.values.map { |value| @connection.quote(value) }.join(", ")
+      @connection.execute("INSERT INTO #{table} (#{columns}) VALUES (#{values})")
+    end
+
+    def migrate
+      @migration.suppress_messages { @migration.up }
+    end
+end
