diff --git a/test/migrations/complete_account_id_rollout_test.rb b/test/migrations/complete_account_id_rollout_test.rb
new file mode 100644
index 0000000..9d90134
--- /dev/null
+++ b/test/migrations/complete_account_id_rollout_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+require_relative "../../db/migrate/20260710120000_complete_account_id_rollout"
+
+class CompleteAccountIdRolloutTest < Minitest::Test
+  class Record < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  def setup
+    Record.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = Record.connection
+    @migration = CompleteAccountIdRollout.new
+    @migration.instance_variable_set(:@connection, @connection)
+    @expected_accounts = {}
+    create_old_schema
+  end
+
+  def teardown
+    Record.connection_pool.disconnect!
+  end
+
+  def test_backfills_every_ownership_path_and_drops_orphans
+    %w[first second].each do |account|
+      insert(:accounts, id: account)
+      %w[users tags account_imports account_join_codes account_cancellations exports storage_entries].each do |table|
+        insert_owned(table, account, account_id: account)
+      end
+
+      CompleteAccountIdRollout::PARENTS.each do |table, (parent, foreign_key)|
+        insert_owned(table, account, foreign_key => "#{parent}/#{account}")
+      end
+
+      { entropies: :container, storage_totals: :owner }.each do |table, association|
+        insert_owned(table, account, "#{association}_type" => "Account", "#{association}_id" => account)
+        insert_owned(table, account, "#{association}_type" => "Board", "#{association}_id" => "boards/#{account}", id: "#{table}/board/#{account}")
+      end
+
+      { mentions: :source, reactions: :reactable, action_text_rich_texts: :record }.each do |table, association|
+        %w[Card Comment].each do |type|
