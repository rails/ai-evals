+require "test_helper"
+
+class AccountOwnedRecordsTest < ActiveSupport::TestCase
+  test "all account data tables require and index account_id" do
+    global_tables = %w[accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys schema_migrations ar_internal_metadata]
+
+    ApplicationRecord.connection.tables.each do |table|
+      next if global_tables.include?(table) || table.start_with?("search_records_fts")
+
+      column = ApplicationRecord.connection.columns(table).find { |column| column.name == "account_id" }
+      assert column, "#{table} must have account_id"
+      assert_equal :uuid, column.type, table
+      refute column.null, "#{table}.account_id must be required"
+      assert ApplicationRecord.connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id must be indexed"
+    end
+  end
+
+  test "child records inherit their parent's account rather than Current.account" do
+    account = accounts(:initech)
+    card = cards(:radio)
+    board = card.board
+    user = users(:mike)
+    records = [
+      Access.new(board: board, user: user),
+      Assignment.new(card: card, assignee: user, assigner: user),
+      Board::Publication.new(board: board),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card),
+      Closure.new(card: card),
+      Mention.new(source: card, mentioner: user, mentionee: user),
+      Pin.new(card: card, user: user),
+      Reaction.new(reactable: card, reacter: user, content: "👍"),
+      Search::Query.new(user: user, terms: "radio"),
+      Tagging.new(card: card, tag: tags(:web)),
+      User::Settings.new(user: user),
+      Watch.new(card: card, user: user),
+      Entropy.new(container: account, auto_postpone_period: 30.days.to_i),
+      Entropy.new(container: board, auto_postpone_period: 30.days.to_i),
+      Storage::Total.new(owner: account),
+      Storage::Total.new(owner: board),
+      ActionText::RichText.new(record: card, name: "description")
+    ]
+
+    assert_not_equal account, Current.account
+    records.each do |record|
+      record.valid?
+      assert_equal account, record.account, record.class.name
+    end
+  end
+
+  test "filter joins inherit their filter's account without relying on Current.account" do
+    filter = users(:mike).filters.create!(
+      tags: [ accounts(:initech).tags.create!(title: "radio") ], boards: [ boards(:miltons_wish_list) ],
+      assignees: [ users(:mike) ], creators: [ users(:mike) ], closers: [ users(:mike) ])
+
+    %i[tag_links board_links assignee_links creator_links closer_links].each do |association|
+      assert_equal [ accounts(:initech).id ], filter.public_send(association).pluck(:account_id), association.to_s
+    end
+  end
+
+  test "bulk board access grants include the board account" do
+    board = boards(:miltons_wish_list)
+    board.accesses.grant_to(users(:mike))
+
+    assert_equal board.account_id, board.accesses.find_by!(user: users(:mike)).account_id
+  end
+
+  test "uploads, rich text embeds and variants carry their account" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    card = cards(:logo)
+    card.update!(description: ActionText::Attachment.from_attachable(blob).to_html)
+    rich_text = card.description
+    variant = blob.variant(resize_to_limit: [ 10, 10 ]).processed
+
+    assert_equal Current.account, blob.account
+    assert_equal card.account, rich_text.account
+    assert_equal card.account, rich_text.embeds_attachments.sole.account
+    assert_equal [ card.account_id ], blob.variant_records.distinct.pluck(:account_id)
+    assert_equal card.account, variant.image.blob.account
+  end
+
+test "attachment uploads inherit the owner's account outside account context" do
+  card = cards(:radio)
+
+  Current.without_account do
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    variant = card.image.variant(resize_to_limit: [ 10, 10 ]).processed
+
+    assert_equal card.account, card.image.blob.account
+    assert_equal card.account, card.image_attachment.account
+    assert_equal card.account, variant.image.blob.account
+  end
+end
+
+  test "search value objects can still be validated without a user" do
+    assert Search::Query.wrap("radio").valid?
+    assert_equal users(:mike).account, users(:mike).remember_search("radio").account
+  end
+end
