diff --git a/config/initializers/tenanting/account_owned_content.rb b/config/initializers/tenanting/account_owned_content.rb
new file mode 100644
index 0000000..c76ef32
--- /dev/null
+++ b/config/initializers/tenanting/account_owned_content.rb
@@ -0,0 +1,26 @@
+module AccountOwnedBlobBuilding
+  def build_after_unfurling(record: nil, **options)
+    super.tap do |blob|
+      # Attachment builds can run outside a request (including preview/variant generation).
+      account = record.try(:account) || record.try(:record).try(:account) || record.try(:blob).try(:account)
+      blob.account = account if account
+    end
+  end
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.account }
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+  singleton_class.prepend AccountOwnedBlobBuilding
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
