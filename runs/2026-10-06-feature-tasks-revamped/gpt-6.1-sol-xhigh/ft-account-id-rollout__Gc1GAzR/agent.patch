diff --git a/config/initializers/account_owned_framework_records.rb b/config/initializers/account_owned_framework_records.rb
new file mode 100644
index 0000000..eb47e8e
--- /dev/null
+++ b/config/initializers/account_owned_framework_records.rb
@@ -0,0 +1,40 @@
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.account }
+end
+
+# Active Storage is shared with global identities. Tenant attachments still
+# inherit their parent's account; global avatars and uploads may have none.
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: true
+  after_initialize { self.account ||= Current.account if new_record? }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: true, default: -> { blob.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: true, default: -> { record.try(:account) }
+
+  before_validation do
+    blob.account ||= account if blob
+  end
+
+  before_save do
+    blob.save! if blob&.account_id_changed?
+  end
+end
+
+# Standalone/direct uploads use the request account. For uploads built for a
+# parent, use that parent's ownership instead, including nil for global avatars.
+module ActiveStorageBlobAccountExtensions
+  def build_after_unfurling(record: nil, **attributes)
+    super(record: record, **attributes).tap do |blob|
+      blob.account = record.try(:account) if record
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  singleton_class.prepend ActiveStorageBlobAccountExtensions
+end
