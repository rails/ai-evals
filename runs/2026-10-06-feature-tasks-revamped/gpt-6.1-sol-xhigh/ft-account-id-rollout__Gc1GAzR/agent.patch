+require "test_helper"
+
+class AccountOwnedRecordsTest < ActiveSupport::TestCase
+  test "every tenant table has a required indexed UUID account column" do
+    tables = %w[
+      accesses account_cancellations account_imports account_join_codes action_text_rich_texts
+      assignees_filters assigners_filters assignments board_publications boards boards_filters
+      card_activity_spikes card_goldnesses card_not_nows cards closers_filters closures columns
+      comments creators_filters entropies events exports filters filters_tags mentions
+      notification_bundles notifications pins push_subscriptions reactions search_queries
+      steps storage_entries storage_totals taggings tags user_settings users watches
+      webhook_delinquency_trackers webhook_deliveries webhooks
+    ]
+
+    ApplicationRecord.connection_pool.with_connection do |connection|
+      tables.concat(connection.tables.grep(/\Asearch_records(?:_\d+)?\z/))
+      tables.each do |table|
+        column = connection.columns(table).find { |column| column.name == "account_id" }
+        assert_not_nil column, table
+        assert_equal :uuid, column.type, table
+        assert_equal false, column.null, table
+        assert connection.index_exists?(table, :account_id), table
+      end
+    end
+  end
+
+  test "new dependent records inherit ownership without current account context" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    user = users(:david)
+    webhook = webhooks(:active)
+    account = board.account
+
+    records = [
+      Access.new(board: board, user: user),
+      Assignment.new(card: card, assignee: users(:jz), assigner: user),
+      Board::Publication.new(board: board),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card),
+      Closure.new(card: card),
+      Entropy.new(container: account, auto_postpone_period: 30.days),
+      Entropy.new(container: board, auto_postpone_period: 30.days),
+      Mention.new(source: card, mentioner: user, mentionee: users(:jz)),
+      Mention.new(source: comment, mentioner: user, mentionee: users(:jz)),
+      Pin.new(card: card, user: user),
+      Reaction.new(reactable: card, reacter: user, content: "👍"),
+      Reaction.new(reactable: comment, reacter: user, content: "👍"),
+      Search::Query.new(user: user, terms: "logo"),
+      Storage::Total.new(owner: account),
+      Storage::Total.new(owner: board),
+      Tagging.new(card: card, tag: tags(:mobile)),
+      User::Settings.new(user: user),
+      Watch.new(card: card, user: user),
+      Webhook::Delivery.new(webhook: webhook, event: events(:logo_published)),
+      Webhook::DelinquencyTracker.new(webhook: webhook),
+      ActionText::RichText.new(record: card, name: "description")
+    ]
+
+    Current.without_account do
+      records.each do |record|
+        assert record.valid?, "#{record.class}: #{record.errors.full_messages}"
+        assert_equal account, record.account, record.class.to_s
+      end
+    end
+  end
+
+  test "all filter joins inherit the filter account when created and replaced" do
+    Current.without_account do
+      filter = users(:david).filters.create!(
+        tags: [ tags(:mobile) ], boards: [ boards(:writebook) ],
+        assignees: [ users(:jz) ], creators: [ users(:kevin) ], closers: [ users(:david) ]
+      )
+
+      %i[ tags boards assignees creators closers ].each do |name|
+        join = Filter.const_get("HABTM_#{name.to_s.camelize}").find_by!(filter_id: filter.id)
+        assert_equal filter.account, join.account
+      end
+
+      filter.update!(tags: [ tags(:web) ])
+      join = Filter.const_get("HABTM_Tags").find_by!(filter_id: filter.id)
+      assert_equal tags(:web), join.tag
+      assert_equal filter.account, join.account
+    end
+  end
+
+  test "bulk access grants include account ownership" do
+    boards(:writebook).accesses.grant_to(users(:mike))
+    access = boards(:writebook).accesses.find_by!(user: users(:mike))
+    assert_equal boards(:writebook).account, access.account
+
+    Current.without_account do
+      user = accounts("37s").users.create!(name: "New member", role: :member)
+      assert user.accesses.exists?
+      user.accesses.each { |access| assert_equal user.account, access.account }
+    end
+  end
+
+  test "search value objects remain valid without an account while saved searches get ownership" do
+    Current.without_account do
+      assert Search::Query.wrap("logo").valid?
+      search = users(:mike).remember_search("paycheck")
+      assert search.persisted?
+      assert_equal accounts(:initech), search.account
+    end
+  end
+
+  test "tenant storage records inherit ownership while global avatars can remain unaccounted" do
+    Current.without_account do
+      card = cards(:logo)
+      card.image.attach(io: StringIO.new("image"), filename: "test.png", content_type: "image/png")
+      attachment = card.image.attachment
+      assert_equal card.account, attachment.account
+      assert_equal card.account, attachment.blob.reload.account
+      variant = ActiveStorage::VariantRecord.create!(blob: attachment.blob, variation_digest: "test")
+      assert_equal card.account, variant.account
+    end
+
+    # Identity avatars remain global even during a tenant-scoped request.
+    Current.with_account(accounts(:initech)) do
+      identity = identities(:david)
+      identity.avatar.attach(io: StringIO.new("avatar"), filename: "avatar.png", content_type: "image/png")
+      assert_nil identity.avatar.attachment.account
+      assert_nil identity.avatar.blob.account
+    end
+  end
+end
