diff --git a/test/migrations/complete_account_id_rollout_test.rb b/test/migrations/complete_account_id_rollout_test.rb
new file mode 100644
index 0000000..fa5281e
--- /dev/null
+++ b/test/migrations/complete_account_id_rollout_test.rb
@@ -0,0 +1,209 @@
+require "test_helper"
+require_relative "../../db/migrate/20260710120000_complete_account_id_rollout"
+
+class CompleteAccountIdRolloutTest < Minitest::Test
+  EXISTING_ACCOUNT_TABLES = %i[
+    boards columns cards comments events filters notification_bundles notifications
+    push_subscriptions steps webhooks
+  ].freeze
+
+  def setup
+    @pool = ActiveRecord::ConnectionAdapters::ConnectionHandler.new.establish_connection({ adapter: "sqlite3", database: ":memory:" })
+    @connection = @pool.lease_connection
+    @ids = Hash.new { |ids, name| ids[name] = ActiveRecord::Type::Uuid.generate }
+    @migration = CompleteAccountIdRollout.new
+    @migration.define_singleton_method(:connection) { @test_connection }
+    @migration.instance_variable_set(:@test_connection, @connection)
+
+    create_table(:accounts)
+    create_table(:identities)
+    CompleteAccountIdRollout::ACCOUNT_TABLES.each { |table| create_table(table, account_id: :uuid) }
+    CompleteAccountIdRollout::PARENT_TABLES.each do |table, (_, foreign_key)|
+      columns = { foreign_key => :uuid }
+      if target = CompleteAccountIdRollout::FILTER_JOIN_TARGETS[table]
+        columns[target.last] = :uuid
+      end
+      columns[:account_id] = :uuid if EXISTING_ACCOUNT_TABLES.include?(table)
+      create_table(table, **columns)
+    end
+    CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, _)|
+      create_table(table, "#{association}_id" => :uuid, "#{association}_type" => :string)
+    end
+    create_table(:active_storage_blobs)
+    create_table(:active_storage_attachments, record_id: :uuid, record_type: :string, blob_id: :uuid)
+    create_table(:active_storage_variant_records, blob_id: :uuid)
+  end
+
+  def teardown
+    @pool&.disconnect!
+  end
+
+  def test_backfills_parents_before_children_and_drops_unresolvable_rows
+    insert(:accounts, id: @ids[:account])
+    insert(:users, id: @ids[:parent], account_id: @ids[:account])
+    insert(:users, id: @ids[:orphan])
+    insert(:tags, id: @ids[:parent], account_id: @ids[:account])
+
+    CompleteAccountIdRollout::PARENT_TABLES.each do |table, (_, foreign_key)|
+      insert(table, id: @ids[:parent], foreign_key => @ids[:parent])
+      insert(table, id: @ids[:orphan], foreign_key => @ids[:orphan])
+    end
+
+    # An existing account_id must not keep a row whose owner has disappeared.
+    insert(:comments, id: @ids[:assigned_orphan], card_id: @ids[:missing], account_id: @ids[:account])
+    CompleteAccountIdRollout::FILTER_JOIN_TARGETS.each do |table, (_, foreign_key)|
+      insert(table, id: @ids[:dangling_join], filter_id: @ids[:parent], foreign_key => @ids[:missing])
+    end
+
+    migrate
+
+    CompleteAccountIdRollout::PARENT_TABLES.each_key do |table|
+      assert_equal @ids[:account], account_id(table, @ids[:parent]), table.to_s
+      assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM #{table}"), table.to_s
+      assert_required_and_indexed(table)
+    end
+  end
+
+  def test_backfills_each_polymorphic_type_and_drops_unknown_and_missing_parents
+    insert(:accounts, id: @ids[:account])
+    insert(:accounts, id: @ids[:other_account])
+    insert(:users, id: @ids[:parent], account_id: @ids[:account])
+    # Same ID in different tables: the discriminator must determine ownership.
+    insert(:boards, id: @ids[:parent], creator_id: @ids[:parent], account_id: @ids[:account])
+    insert(:cards, id: @ids[:parent], board_id: @ids[:parent], account_id: @ids[:other_account])
+    insert(:comments, id: @ids[:parent], card_id: @ids[:parent], account_id: @ids[:account])
+
+    expected = {}
+    CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, types)|
+      types.each do |type, parent|
+        parent_id = parent == :accounts ? @ids[:account] : @ids[:parent]
+        id = @ids[[ table, type ]]
+        insert(table, id: id, "#{association}_id" => parent_id, "#{association}_type" => type)
+        expected[[ table, id ]] = parent == :cards ? @ids[:other_account] : @ids[:account]
+        insert(table, id: @ids[[ table, type, :orphan ]], "#{association}_id" => @ids[:missing], "#{association}_type" => type)
+      end
+      insert(table, id: @ids[:unknown], "#{association}_id" => @ids[:parent], "#{association}_type" => "Unknown")
+    end
+
+    migrate
+
+    expected.each { |(table, id), account| assert_equal account, account_id(table, id) }
+    CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (_, types)|
+      assert_equal types.size, @connection.select_value("SELECT COUNT(*) FROM #{table}")
+      assert_required_and_indexed(table)
+    end
+  end
+
+  def test_requires_existing_account_columns_and_handles_both_search_layouts
+    insert(:accounts, id: @ids[:account])
+    insert(:identities, id: @ids[:global])
+    search_tables = [ :search_records, *(0..15).map { |shard| "search_records_#{shard}" } ]
+    search_tables.each { |table| create_table(table, account_id: :uuid) }
+    tables = CompleteAccountIdRollout::ACCOUNT_TABLES + search_tables
+    tables.each do |table|
+      insert(table, id: @ids[:valid], account_id: @ids[:account])
+      insert(table, id: @ids[:orphan])
+      insert(table, id: @ids[:invalid], account_id: @ids[:missing])
+    end
+
+    migrate
+
+    tables.each do |table|
+      assert_equal @ids[:account], account_id(table, @ids[:valid])
+      assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM #{table}")
+      assert_required_and_indexed(table)
+      assert_raises(ActiveRecord::NotNullViolation) { insert(table, id: @ids[:new_orphan]) }
+    end
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM identities")
+    refute @connection.column_exists?(:identities, :account_id)
+  end
+
+  def test_active_storage_propagates_ownership_to_variants_and_preserves_global_avatars
+    insert(:accounts, id: @ids[:account])
+    insert(:users, id: @ids[:parent], account_id: @ids[:account])
+    insert(:boards, id: @ids[:parent], creator_id: @ids[:parent], account_id: @ids[:account])
+    insert(:cards, id: @ids[:parent], board_id: @ids[:parent], account_id: @ids[:account])
+    insert(:identities, id: @ids[:global])
+    %i[ blob variant_blob global_blob ].each { |id| insert(:active_storage_blobs, id: @ids[id]) }
+    insert(:active_storage_attachments, id: @ids[:attachment], record_type: "Card", record_id: @ids[:parent], blob_id: @ids[:blob])
+    insert(:active_storage_attachments, id: @ids[:global_attachment], record_type: "Identity", record_id: @ids[:global], blob_id: @ids[:global_blob])
+    insert(:active_storage_variant_records, id: @ids[:variant], blob_id: @ids[:blob])
+    insert(:active_storage_attachments, id: @ids[:variant_attachment], record_type: "ActiveStorage::VariantRecord", record_id: @ids[:variant], blob_id: @ids[:variant_blob])
+
+    insert(:active_storage_attachments, id: @ids[:orphan_attachment], record_type: "Card", record_id: @ids[:missing], blob_id: @ids[:blob])
+    insert(:active_storage_variant_records, id: @ids[:orphan_variant], blob_id: @ids[:missing])
+
+    migrate
+
+    assert_equal 3, @connection.select_value("SELECT COUNT(*) FROM active_storage_attachments")
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM active_storage_variant_records")
+
+    [ [ :active_storage_blobs, :blob ], [ :active_storage_blobs, :variant_blob ],
+      [ :active_storage_attachments, :attachment ], [ :active_storage_attachments, :variant_attachment ],
+      [ :active_storage_variant_records, :variant ] ].each do |table, id|
+      assert_equal @ids[:account], account_id(table, @ids[id])
+    end
+    assert_nil account_id(:active_storage_blobs, @ids[:global_blob])
+    assert_nil account_id(:active_storage_attachments, @ids[:global_attachment])
+    assert_equal 3, @connection.select_value("SELECT COUNT(*) FROM active_storage_blobs")
+  end
+
+  def test_preserves_assigned_ownership_and_existing_unique_indexes
+    insert(:accounts, id: @ids[:account])
+    insert(:accounts, id: @ids[:other_account])
+    insert(:users, id: @ids[:parent], account_id: @ids[:account])
+    insert(:boards, id: @ids[:parent], creator_id: @ids[:parent], account_id: @ids[:other_account])
+    @connection.add_index(:account_cancellations, :account_id, unique: true)
+
+    migrate
+
+    assert_equal @ids[:other_account], account_id(:boards, @ids[:parent])
+    indexes = @connection.indexes(:account_cancellations)
+    assert_equal 1, indexes.size
+    assert indexes.first.unique
+  end
+
+  def test_deleting_orphans_cannot_be_rolled_back
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  private
+    def create_table(table, **columns)
+      @connection.create_table(table, id: join_table?(table) ? false : :uuid) do |definition|
+        columns.each { |name, type| definition.column(name, type) }
+      end
+    end
+
+    def insert(table, attributes)
+      if target = CompleteAccountIdRollout::FILTER_JOIN_TARGETS[table.to_sym]
+        attributes = { target.last => @ids[:parent] }.merge(attributes).except(:id)
+      end
+      columns = attributes.keys.map { |key| @connection.quote_column_name(key) }.join(", ")
+      values = attributes.map do |key, value|
+        value = ActiveRecord::Type::Uuid.new.serialize(value) if key.to_s == "id" || key.to_s.end_with?("_id")
+        @connection.quote(value)
+      end.join(", ")
+      @connection.execute("INSERT INTO #{table} (#{columns}) VALUES (#{values})")
+    end
+
+    def account_id(table, id)
+      key = join_table?(table) ? "filter_id" : "id"
+      value = @connection.select_value("SELECT account_id FROM #{table} WHERE #{key} = #{@connection.quote(ActiveRecord::Type::Uuid.new.serialize(id))}")
+      ActiveRecord::Type::Uuid.new.deserialize(value)
+    end
+
+    def assert_required_and_indexed(table)
+      column = @connection.columns(table).find { |column| column.name == "account_id" }
+      assert_equal :uuid, column.type
+      assert_equal false, column.null
+      assert @connection.index_exists?(table, :account_id)
+    end
+
+    def join_table?(table)
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].include?(table.to_s)
+    end
+
+    def migrate
+      @migration.suppress_messages { @migration.up }
+    end
+end
