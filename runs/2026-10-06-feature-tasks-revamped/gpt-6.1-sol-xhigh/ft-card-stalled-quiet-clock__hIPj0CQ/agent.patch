diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..ef33a05
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,33 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+
+    before_update :register_content_activity
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def comment_burst?(as_of: Time.current)
+    recent_comments = comments.by_user.where(created_at: (as_of - auto_postpone_period / 3.0)..as_of)
+    recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+  end
+
+  # The stalled state changes with time, without a database update.
+  def cache_key
+    "#{super}/#{stalled? ? 'stalled' : 'not-stalled'}"
+  end
+
+  private
+    def register_content_activity
+      if (changed_attribute_names_to_save - %w[ last_active_at last_burst_at updated_at ]).any? ||
+          rich_text_description&.has_changes_to_save? || attachment_changes.any?
+        self.last_active_at = Time.current unless will_save_change_to_last_active_at?
+      end
+    end
+end
