@@ -0,0 +1,72 @@
+class AddLastBurstAtToCards < ActiveRecord::Migration[8.2]
+  class CardRecord < ActiveRecord::Base
+    self.table_name = "cards"
+  end
+
+  class BoardRecord < ActiveRecord::Base
+    self.table_name = "boards"
+  end
+
+  class EventRecord < ActiveRecord::Base
+    self.table_name = "events"
+  end
+
+  class AssignmentRecord < ActiveRecord::Base
+    self.table_name = "assignments"
+  end
+
+  class CommentRecord < ActiveRecord::Base
+    self.table_name = "comments"
+  end
+
+  def up
+    add_column :cards, :last_burst_at, :datetime
+    add_index :comments, [ :card_id, :created_at ]
+    populate_last_burst_at
+  end
+
+  def down
+    remove_index :comments, [ :card_id, :created_at ]
+    remove_column :cards, :last_burst_at
+  end
+
+  private
+    def populate_last_burst_at
+      CardRecord.reset_column_information
+      periods = BoardRecord
+        .joins("LEFT JOIN entropies AS board_entropies ON board_entropies.container_type = 'Board' AND board_entropies.container_id = boards.id")
+        .joins("LEFT JOIN entropies AS account_entropies ON account_entropies.container_type = 'Account' AND account_entropies.container_id = boards.account_id")
+        .pluck(:id, Arel.sql("COALESCE(board_entropies.auto_postpone_period, account_entropies.auto_postpone_period)"))
+        .to_h { |id, period| [ id, period.to_f / 3 ] }
+
+      CardRecord.find_each do |card|
+        event_burst_at = EventRecord.where(eventable_type: "Card", eventable_id: card.id, action: %w[ card_assigned card_reopened ]).maximum(:created_at)
+        assignment_burst_at = AssignmentRecord.where(card_id: card.id).maximum(:created_at)
+        comment_burst_at = last_comment_burst_at(card.id, periods.fetch(card.board_id))
+        burst_at = [ event_burst_at, assignment_burst_at, comment_burst_at ].compact.max
+        card.update_columns(last_burst_at: burst_at) if burst_at
+      end
+    end
+
+    def last_comment_burst_at(card_id, period)
+      window = []
+      commenters = Hash.new(0)
+      burst_at = nil
+
+      CommentRecord.joins("INNER JOIN users ON users.id = comments.creator_id")
+        .where(card_id: card_id).where.not(users: { role: "system" })
+        .order(:created_at, :id).pluck(:created_at, :creator_id).each do |created_at, creator_id|
+          while window.any? && window.first.first < created_at - period
+            _, expired_creator_id = window.shift
+            commenters[expired_creator_id] -= 1
+            commenters.delete(expired_creator_id) if commenters[expired_creator_id].zero?
+          end
+
+          window << [ created_at, creator_id ]
+          commenters[creator_id] += 1
+          burst_at = created_at if window.size >= 3 && commenters.size >= 2
+        end
+
+      burst_at
+    end
+end
