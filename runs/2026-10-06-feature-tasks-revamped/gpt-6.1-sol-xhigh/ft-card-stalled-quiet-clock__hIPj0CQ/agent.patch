diff --git a/test/controllers/cards/stalled_test.rb b/test/controllers/cards/stalled_test.rb
new file mode 100644
index 0000000..7bb16f1
--- /dev/null
+++ b/test/controllers/cards/stalled_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Cards::StalledTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    freeze_time
+    @card = cards(:logo)
+    @card.update!(last_burst_at: Time.current, last_active_at: Time.current)
+  end
+
+  test "index lists only accessible stalled cards as HTML and JSON" do
+    cards(:radio).update!(last_burst_at: Time.current, last_active_at: Time.current)
+    travel 2.weeks
+
+    get cards_path(indexed_by: "stalled")
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+
+    get cards_path(indexed_by: "stalled"), as: :json
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    @card.comments.create!(creator: users(:kevin), body: "Some activity")
+    get cards_path(indexed_by: "stalled"), as: :json
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "cached previews update when time passes and when activity resumes" do
+    with_actionview_partial_caching do
+      get cards_path
+      assert_response :success
+      assert_select "#article_card_#{@card.id} .card__stalled", count: 0
+
+      travel 2.weeks
+      get cards_path
+      assert_response :success
+      assert_select "#article_card_#{@card.id} .card__stalled", text: "Stalled"
+
+      put card_path(@card), params: { card: { title: "Active again" } }, as: :json
+      get cards_path
+      assert_response :success
+      assert_select "#article_card_#{@card.id} .card__stalled", count: 0
+    end
+  end
+
+  test "board column etags change when a card becomes stalled" do
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    travel 2.weeks
+    get board_column_path(@card.board, @card.column), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select "#article_card_#{@card.id} .card__stalled", text: "Stalled"
+  end
+
+  test "stalled cards are marked in card details and board columns" do
+    travel 2.weeks
+
+    get card_path(@card)
+    assert_response :success
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+    assert_select "#article_card_#{@card.id} .card__stalled", text: "Stalled"
+  end
+
+  test "stalled cards are marked in public details and previews" do
+    @card.board.publish
+    travel 2.weeks
+
+    get public_board_card_path(@card.board.publication.key, @card)
+    assert_response :success
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+
+    get public_board_column_path(@card.board.publication.key, @card.column)
+    assert_response :success
+    assert_select "#article_card_#{@card.id} .card__stalled", text: "Stalled"
+  end
+
+  test "cached timeline cards gain the stalled marker when time passes" do
+    day = events(:logo_published).created_at.to_date
+
+    with_actionview_partial_caching do
+      get events_path(day: day)
+      assert_response :success
+      assert_select ".event .card__stalled", count: 0
+
+      travel 2.weeks
+      get events_path(day: day)
+      assert_response :success
+      assert_select ".event .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "image removal resets stalled status" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+
+    delete card_image_path(@card), as: :json
+    assert_response :no_content
+    assert_not @card.reload.stalled?
+  end
+
+  test "stalled cards are marked in notifications" do
+    travel 2.weeks
+
+    get notifications_path
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+end
