@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+    @card = cards(:logo)
+  end
+
+  test "anyone can open a published card by number" do
+    @card.update!(description: "A publicly visible description")
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :success
+      assert_select "h1", text: @card.title
+      assert_includes response.body, "A publicly visible description"
+      assert_select "a[href=?]", public_board_path(@publication.key)
+      assert_select "form", count: 0
+      assert_select "turbo-cable-stream-source", count: 0
+    end
+  end
+
+  test "draft cards cannot be opened directly" do
+    @card.update!(status: :drafted)
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :not_found
+    end
+  end
+
+  test "cards must belong to the public board even when numbers overlap across accounts" do
+    @card.destroy!
+    untenanted do
+      get public_board_card_path(@publication.key, cards(:radio).number)
+      assert_response :not_found
+    end
+  end
+
+  test "cards on another board are not accessible" do
+    publication = boards(:private).publish
+    untenanted do
+      get public_board_card_path(publication.key, @card)
+      assert_response :not_found
+    end
+  end
+
+  test "unpublishing revokes direct card URLs" do
+    @board.unpublish
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :not_found
+    end
+  end
+  test "checklist steps can be read but not changed" do
+    @card.steps.create!(content: "Make the logo bigger", completed: true)
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :success
+      assert_select "li", text: "Make the logo bigger (completed)"
+      assert_select "input, form", count: 0
+    end
+  end
+
+  test "card images are visible" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :success
+      assert_select "img[alt=?]", @card.title
+    end
+  end
+
+  test "a moved card is no longer accessible from its former board" do
+    with_current_user(:david) { @card.update!(board: boards(:private)) }
+    untenanted do
+      get public_board_card_path(@publication.key, @card)
+      assert_response :not_found
+    end
+  end
+end
