+# Single-server, self-hosted Fizzy. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: your-github-user/fizzy
+
+servers:
+  web:
+    # Set your hostname here. It must resolve directly to your Linux server.
+    - &hostname fizzy.example.com
+
+# Kamal Proxy obtains and renews the Let's Encrypt certificate.
+# Thruster serves HTTP on port 80 inside the app container.
+proxy:
+  ssl: true
+  host: *hostname
+  app_port: 80
+
+registry:
+  server: ghcr.io
+  username: your-github-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64 # Use arm64 if your server is ARM-based.
+
+# Databases (including jobs, cache, and cable) and uploads live in this volume.
+# Keep the volume name unchanged on subsequent deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+    ASSUME_SSL: "true"
+    FORCE_SSL: "true"
+    APP_FQDN: *hostname
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USER_NAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
