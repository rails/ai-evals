diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..4160ffe 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,41 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    Current.with_account(self) do
+      with_lock do
+        if cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+          Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+          incinerate_attachments
+          Storage::Entry.where(account: self).delete_all
+          destroy!
+        end
+      end
+    end
+  end
+
+  private
+    def incinerate_attachments
+      # Skip detach callbacks: the account's storage ledger is being deleted too.
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+
+      ActiveStorage::Blob.where(account_id: id).find_each do |blob|
+        blob.destroy!
+        ActiveRecord.after_all_transactions_commit { blob.delete }
+      end
+    end
 end
