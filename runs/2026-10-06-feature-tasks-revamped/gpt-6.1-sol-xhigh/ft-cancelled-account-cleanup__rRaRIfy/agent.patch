diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..9153878
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    cancel_at(account, 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert Account.exists?(accounts(:initech).id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "incinerates multiple overdue accounts without a current account" do
+    cancel_at(accounts(:"37s"), 31.days.ago)
+    cancel_at(accounts(:initech), 32.days.ago)
+
+    Current.without_account do
+      assert_difference -> { Account.count }, -2 do
+        Account::IncinerateDueJob.perform_now
+      end
+      assert_nil Current.account
+    end
+
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "keeps active accounts and cancellations within the grace period" do
+    freeze_time do
+      cancel_at(accounts(:"37s"), 30.days.ago)
+      cancel_at(accounts(:initech), 29.days.ago)
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "keeps reactivated accounts" do
+    account = accounts(:"37s")
+    cancel_at(account, 31.days.ago)
+    account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "can run repeatedly when no accounts are due" do
+    cancel_at(accounts(:"37s"), 31.days.ago)
+    Account::IncinerateDueJob.perform_now
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "removes all tenant data while preserving identities and other accounts" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    filter_id = filters(:jz_assignments).id
+    board_ids = account.boards.ids
+    identity = identities(:david)
+    other_user = accounts(:initech).users.create!(name: "David", identity: identity)
+
+    card.update!(description: "Account data to incinerate")
+    card.image.attach(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+    variant = ActiveStorage::VariantRecord.create!(blob: card.image.blob, variation_digest: "test-variation")
+    variant.image.attach(io: StringIO.new("variant"), filename: "variant.txt", content_type: "text/plain")
+    card.reindex
+    comments(:logo_agreement_jz).reindex
+    Search::Record.for(account.id).find_by!(searchable: card).update_columns(searchable_id: ActiveRecord::Type::Uuid.generate)
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt")
+    exports(:completed_account_export).file.attach(io: StringIO.new("export"), filename: "export.zip")
+    account_import = account.imports.create!(identity: identity, status: :completed)
+    account_import.file.attach(io: StringIO.new("import"), filename: "import.zip")
+    Storage::Entry.create!(account: account, board: board, delta: 10, operation: "attach")
+    Storage::Total.create!(owner: account)
+    Storage::Total.create!(owner: board)
+    cancel_at(account, 31.days.ago)
+
+    other_account_counts = tenant_tables.to_h { |table| [ table, tenant_record_count(table, accounts(:initech).id) ] }
+    identity_ids = Identity.ids.sort
+    session_ids = Session.ids.sort
+    search_record_ids = Search::Record.for(account.id).where(account_id: account.id).ids
+
+    Account::IncinerateDueJob.perform_now
+
+    tenant_tables.each do |table|
+      assert_equal 0, tenant_record_count(table, account.id), "Account data left in #{table}"
+      assert_equal other_account_counts[table], tenant_record_count(table, accounts(:initech).id), "Other account data changed in #{table}"
+    end
+
+    if Fizzy.db_adapter.sqlite?
+      assert_empty Search::Record::SQLite::Fts.with_rowid.where(rowid: search_record_ids)
+    end
+    assert_empty Storage::Total.where(owner_type: "Account", owner_id: account.id)
+    assert_empty Storage::Total.where(owner_type: "Board", owner_id: board_ids)
+    ApplicationRecord.connection.tables.grep(/filters/).each do |table|
+      if ApplicationRecord.connection.columns(table).any? { |column| column.name == "filter_id" }
+        assert_equal 0, ApplicationRecord.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE filter_id = #{ApplicationRecord.connection.quote(filter_id)}").to_i
+      end
+    end
+    assert_equal identity_ids, Identity.ids.sort
+    assert_equal session_ids, Session.ids.sort
+    assert_equal identity, other_user.reload.identity
+  end
+
+  private
+    def cancel_at(account, time)
+      account.create_cancellation!(initiated_by: account.users.where.not(role: :system).first, created_at: time)
+    end
+
+    def tenant_tables
+      ApplicationRecord.connection.tables.select do |table|
+        ApplicationRecord.connection.columns(table).any? { |column| column.name == "account_id" }
+      end
+    end
+
+    def tenant_record_count(table, account_id)
+      ApplicationRecord.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE account_id = #{ApplicationRecord.connection.quote(account_id)}").to_i
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..815ca5d
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "incinerate does nothing for active accounts" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing during the grace period" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "rechecks cancellation after locking the account" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    assert @account.cancelled?
+
+    Account.find(@account.id).reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "rechecks the grace period if an account has been cancelled again" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    other_account_instance = Account.find(@account.id)
+    other_account_instance.reactivate
+    other_account_instance.cancel(initiated_by: users(:david))
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "rolls back data deletion if account destruction fails" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    cards(:logo).image.attach(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+    blob = cards(:logo).image.blob
+    cards(:logo).reindex
+    Storage::Entry.create!(account: @account, delta: 10, operation: "attach")
+    @account.stubs(:destroy!).raises(ActiveRecord::RecordNotDestroyed)
+
+    assert_no_difference [ -> { Account.count }, -> { ActiveStorage::Attachment.count }, -> { ActiveStorage::Blob.count }, -> { Storage::Entry.count }, -> { Search::Record.for(@account.id).count } ] do
+      assert_raises ActiveRecord::RecordNotDestroyed do
+        @account.incinerate
+      end
+    end
+
+    assert blob.service.exist?(blob.key)
+  end
+end
