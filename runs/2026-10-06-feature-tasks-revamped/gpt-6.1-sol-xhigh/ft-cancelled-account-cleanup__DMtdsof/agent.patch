diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..a3bd3de
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    freeze_time
+    @account = accounts("37s")
+  end
+
+  test "incinerates expired accounts and all their account-scoped data" do
+    cancel_account(31.days.ago)
+    card = cards(:logo)
+    card.reindex
+    search_record_id = Search::Record.for(@account.id).find_by!(searchable: card).id
+    card.image.attach io: StringIO.new("image"), filename: "image.png", content_type: "image/png"
+    ActiveStorage::VariantRecord.create!(blob: card.image.blob, variation_digest: "test-variant")
+    ActiveStorage::Blob.create_and_upload! io: StringIO.new("unused"), filename: "unused.txt"
+    Account::Import.create!(account: @account, identity: identities(:david))
+    @account.materialize_storage
+    card.board.materialize_storage
+
+    other_account = accounts(:initech)
+    other_user = other_account.users.create!(identity: identities(:david), name: "David")
+    storage_total_ids = [ @account.storage_total.id, card.board.storage_total.id ]
+    other_records = account_record_counts(other_account)
+    identity_ids = Identity.ids.sort
+
+    perform_incineration
+
+    assert_not Account.exists?(@account.id)
+    account_record_counts(@account).each do |table, count|
+      assert_equal 0, count, "Expected all account data in #{table} to be removed"
+    end
+    assert_equal other_records, account_record_counts(other_account)
+    assert_equal identity_ids, Identity.ids.sort
+    assert Account.exists?(other_account.id)
+    assert User.exists?(other_user.id)
+    assert_not Storage::Total.where(id: storage_total_ids).exists?
+    if Fizzy.db_adapter.sqlite?
+      assert_not Search::Record::SQLite::Fts.exists?(search_record_id)
+    end
+  end
+
+  test "retains recently cancelled accounts" do
+    cancel_account(30.days.ago + 1.second)
+    records = account_record_counts(@account)
+
+    perform_incineration
+
+    assert Account.exists?(@account.id)
+    assert_equal records, account_record_counts(@account)
+  end
+
+  test "retains accounts cancelled exactly 30 days ago" do
+    cancel_account(30.days.ago)
+
+    assert_no_difference "Account.count" do
+      perform_incineration
+    end
+  end
+
+  test "retains active and reactivated accounts" do
+    cancel_account(31.days.ago)
+    @account.reactivate
+    records = account_record_counts(@account)
+
+    assert_no_difference "Account.count" do
+      perform_incineration
+    end
+
+    assert_equal records, account_record_counts(@account)
+  end
+
+  test "can run again after incinerating an account" do
+    cancel_account(31.days.ago)
+    perform_incineration
+
+    assert_no_difference "Account.count" do
+      perform_incineration
+    end
+  end
+
+  test "incinerates multiple accounts within their own account context" do
+    cancel_account(31.days.ago)
+    other_account = accounts(:initech)
+    other_account.create_cancellation!(initiated_by: users(:mike), created_at: 40.days.ago)
+    contexts = []
+    callback = ->(account) { contexts << [ account.id, Current.account.id ] }
+    Account.set_callback :destroy, :before, callback
+
+    assert_difference "Account.count", -2 do
+      perform_incineration
+    end
+
+    assert_equal [ @account.id, other_account.id ].sort, contexts.map(&:first).sort
+    assert contexts.all? { |account_id, current_account_id| account_id == current_account_id }
+    assert_equal @account, Current.account
+  ensure
+    Account.skip_callback :destroy, :before, callback
+  end
+
+  test "uses the cancellation creation time rather than its update time" do
+    cancel_account(31.days.ago)
+    @account.cancellation.touch
+
+    perform_incineration
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  private
+    def cancel_account(created_at)
+      @account.create_cancellation!(initiated_by: users(:david), created_at: created_at)
+    end
+
+    def perform_incineration
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    def account_record_counts(account)
+      ApplicationRecord.with_connection do |connection|
+        account_id = connection.quote(Account.type_for_attribute("id").serialize(account.id))
+
+        connection.tables.filter_map do |table|
+          if connection.columns(table).any? { |column| column.name == "account_id" }
+            count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}")
+            [ table, count ]
+          end
+        end.to_h
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..e527999
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @account = accounts("37s")
+  end
+
+  test "rechecks a cached cancellation after locking the account" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    stale_account = Account.find(@account.id)
+    assert stale_account.cancelled?
+
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      stale_account.incinerate
+    end
+  end
+
+  test "does not incinerate an account that was cancelled again recently" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    stale_account = Account.find(@account.id)
+    assert stale_account.cancelled?
+
+    @account.reactivate
+    @account.create_cancellation!(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      stale_account.incinerate
+    end
+  end
+
+  test "rolls back data removal without deleting files when destruction fails" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("image"), filename: "image.png", content_type: "image/png"
+    blob = card.image.blob
+    attachment_id = card.image.attachment.id
+    entry_ids = Storage::Entry.where(account_id: @account.id).ids
+    @account.stubs(:destroy!).raises(ActiveRecord::RecordNotDestroyed)
+
+    assert_raises ActiveRecord::RecordNotDestroyed do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account::Cancellation.exists?(@account.cancellation.id)
+    assert ActiveStorage::Attachment.exists?(attachment_id)
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert_equal entry_ids, Storage::Entry.where(account_id: @account.id).ids
+    assert blob.service.exist?(blob.key)
+  end
+end
