diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..7b0e35e 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,34 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }).find_each do |account|
+        Current.with_account(account) { account.incinerate }
+      end
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+        incinerate_attachments
+        Storage::Entry.where(account_id: id).delete_all
+        destroy!
+      end
+    end
+  end
+
+  private
+    def incinerate_attachments
+      # There is no need to record storage detaches for an account being incinerated.
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: id).delete_all
+      ActiveStorage::Blob.where(account_id: id).find_each do |blob|
+        blob.destroy!
+        ActiveRecord.after_all_transactions_commit { blob.delete }
+      end
+    end
 end
