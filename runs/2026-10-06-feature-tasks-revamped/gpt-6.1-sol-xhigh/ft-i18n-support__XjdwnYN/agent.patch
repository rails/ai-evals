diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..b8560f6
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,30 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_locale(&action)
+      response.headers["Vary"] = [ response.headers["Vary"], "Cookie" ].compact.join(", ")
+
+      # Resolve identity before authentication callbacks, including callbacks that redirect.
+      identity = Current.identity || find_session_by_cookie&.identity
+      if identity.nil? && bearer_token_authenticatable_request?
+        token, = ActionController::HttpAuthentication::Token.token_and_options(request)
+        identity = Identity.find_by_permissable_access_token(token, method: request.method) if token.present?
+      end
+      requested_locale = params[:locale].presence_in(I18n.available_locales.map(&:to_s))
+      if requested_locale
+        session[:locale] = requested_locale
+        identity&.update!(locale: requested_locale)
+      end
+      locale = requested_locale || identity&.locale || session[:locale]
+      locale = locale.presence_in(I18n.available_locales.map(&:to_s)) || I18n.default_locale
+      Current.set(locale_choice: session[:locale]) do
+        I18n.with_locale(locale, &action)
+      end
+    end
+end
