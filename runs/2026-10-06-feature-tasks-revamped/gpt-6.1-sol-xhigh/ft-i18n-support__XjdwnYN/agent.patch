+        <div class="select is-rounded">
+          <%= form.text_field :job_class_name, value: @job_filters[:job_class_name], class: "input", list: "job-classes", placeholder: t("app.admin_filter_by_job_class"), autocomplete: "off" %>
+        </div>
+      </div>
+
+      <div class="control">
+        <%= form.label :queue_name, class: "label" %>
+        <div class="select is-rounded">
+          <%= form.text_field :queue_name, value: @job_filters[:queue_name], class: "input", list: "queue-names", placeholder: t("app.admin_filter_by_queue_name"), autocomplete: "off" %>
+        </div>
+      </div>
+
+      <% if jobs_status == "finished" %>
+        <div class="control">
+          <%= form.label :finished_at_start, class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_start, value: @job_filters[:finished_at]&.begin, class: "input", placeholder: t("app.admin_finished_from") %>
+          </div>
+        </div>
+
+        <div class="control">
+          <%= form.label :finished_at_end, class: "label" %>
+          <div class="select is-rounded">
+            <%= form.datetime_field :finished_at_end, value: @job_filters[:finished_at]&.end, class: "input", placeholder: t("app.admin_finished_to") %>
+          </div>
+        </div>
+      <% end %>
+
+      <%= hidden_field_tag :server_id, MissionControl::Jobs::Current.server.id %>
+
+      <datalist id="job-classes" class="is-hidden">
+        <% job_class_names.each do |job_class_name| %>
+          <option value="<%= job_class_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <datalist id="queue-names" class="is-hidden">
+        <% queue_names.each do |queue_name| %>
+          <option value="<%= queue_name %>"></option>
+        <% end %>
+      </datalist>
+
+      <div class="control is-align-self-flex-end">
+        <%= link_to t("app.admin_clear"), application_jobs_path(MissionControl::Jobs::Current.application, jobs_status, job_class_name: nil, queue_name: nil, finished_at: nil..nil), class: "button" %>
+      </div>
+    </div>
+  <% end %>
+</div>
