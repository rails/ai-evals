+<% if job.failed? %>
+  <h2 class="subtitle"><%= t("app.admin_error_information") %></h2>
+
+  <table class="table">
+    <tbody>
+    <tr>
+      <th><%= t("app.admin_type") %></th>
+      <td> <%= job.last_execution_error.error_class %> </td>
+    </tr>
+    <tr>
+      <th><%= t("app.admin_message") %></th>
+      <td> <%= job.last_execution_error.try(:message) || job.last_execution_error.inspect %> </td>
+    </tr>
+    </tbody>
+  </table>
+
+  <% if @server.backtrace_cleaner %>
+    <%= render "mission_control/jobs/jobs/failed/backtrace_toggle", application: @application, job: job %>
+  <% end %>
+
+  <pre class="is-family-monospace mb-4 backtrace-content"><%= failed_job_backtrace(job, @server) %></pre>
+<% end %>
