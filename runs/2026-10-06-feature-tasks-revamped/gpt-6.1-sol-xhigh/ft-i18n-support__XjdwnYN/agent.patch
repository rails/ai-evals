+export function locale() {
+  return (getMetaContent("locale") || document.documentElement.lang) === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key, values = {}) {
+  const messages = JSON.parse(getMetaContent("translations") || "{}")
+  let message = messages[key]
+  if (typeof message === "object") message = message[values.count === 1 ? "one" : "other"]
+  return message.replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
