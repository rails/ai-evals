diff --git a/app/javascript/initializers/localization.js b/app/javascript/initializers/localization.js
new file mode 100644
index 0000000..43d4a24
--- /dev/null
+++ b/app/javascript/initializers/localization.js
@@ -0,0 +1,21 @@
+import { Turbo } from "@hotwired/turbo-rails"
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Turbo retains the html element. Keep its language in sync so assistive
+// technology uses the right pronunciation, and discard old-language snapshots.
+function synchronizeLanguage() {
+  const language = getMetaContent("locale") || "en"
+  document.documentElement.lang = language
+
+  try {
+    const previousLanguage = sessionStorage.getItem("fizzy-locale")
+    if (previousLanguage && previousLanguage !== language) {
+      Turbo.cache.clear()
+      if (navigator.serviceWorker?.controller) Turbo.offline.clearCache()
+    }
+    sessionStorage.setItem("fizzy-locale", language)
+  } catch {}
+}
+
+document.addEventListener("turbo:load", synchronizeLanguage)
+document.addEventListener("turbo:morph", synchronizeLanguage)
