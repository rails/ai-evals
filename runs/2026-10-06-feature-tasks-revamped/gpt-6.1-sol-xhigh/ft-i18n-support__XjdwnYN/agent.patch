@@ -5,6 +5,24 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  def process(action, *arguments, **keywords)
+    recipient = [ *arguments, keywords ].filter_map do |argument|
+      if argument.is_a?(Identity)
+        argument
+      elsif argument.respond_to?(:identity)
+        argument.identity
+      elsif argument.respond_to?(:user)
+        argument.user&.identity
+      elsif argument.respond_to?(:initiated_by)
+        argument.initiated_by&.identity
+      elsif argument.is_a?(Hash)
+        argument[:user]&.identity
+      end
+    end.first
+    locale = params[:locale].presence_in(I18n.available_locales.map(&:to_s)) || recipient&.locale || I18n.default_locale
+    I18n.with_locale(locale) { super(action, *arguments, **keywords) }
+  end
+
   private
     def default_url_options
       if Current.account
