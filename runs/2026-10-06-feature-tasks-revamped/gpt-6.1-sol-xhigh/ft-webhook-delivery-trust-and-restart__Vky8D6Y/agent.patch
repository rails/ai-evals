@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @failure = webhook_deliveries(:errored)
+    @success = webhook_deliveries(:successfully_completed)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the receiver" do
+    freeze_time
+    9.times { @webhook.record_delivery_outcome(@failure) }
+    assert @webhook.active?
+
+    travel 1.hour
+    @webhook.record_delivery_outcome(@failure)
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "ten failures in less than an hour do not deactivate the receiver" do
+    freeze_time
+    10.times { @webhook.record_delivery_outcome(@failure) }
+    assert @webhook.reload.active?
+
+    travel 1.hour - 1.second
+    @webhook.record_delivery_outcome(@failure)
+    assert @webhook.reload.active?
+  end
+
+  test "fewer than ten failures do not deactivate even after an hour" do
+    freeze_time
+    @webhook.record_delivery_outcome(@failure)
+    travel 2.hours
+    8.times { @webhook.record_delivery_outcome(@failure) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "a successful delivery resets the failure streak" do
+    freeze_time
+    9.times { @webhook.record_delivery_outcome(@failure) }
+    travel 1.hour
+    @webhook.record_delivery_outcome(@success)
+
+    tracker = @webhook.reload.delinquency_tracker
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    @webhook.record_delivery_outcome(@failure)
+    assert @webhook.reload.active?
+    assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "reactivation starts a new streak" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "destroying the webhook removes its tracker" do
+    tracker = @webhook.create_delinquency_tracker!
+    @webhook.destroy!
+    assert_not Webhook::DelinquencyTracker.exists?(tracker.id)
+  end
+end
