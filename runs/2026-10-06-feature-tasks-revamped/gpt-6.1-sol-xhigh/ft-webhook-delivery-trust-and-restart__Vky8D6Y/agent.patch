+class Webhook::Delivery::Payload
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def to_json
+    Current.with_account(@event.account) do
+      if @webhook.for_slack?
+        { text: "#{CGI.unescapeHTML(@event.description_for(nil).to_plain_text)}\n<#{event_url}|View in Fizzy>" }.to_json
+      elsif @webhook.for_campfire? || @webhook.for_basecamp?
+        { content: render(:html) }.to_json
+      else
+        render(:json)
+      end
+    end
+  end
+
+  private
+    def render(format)
+      renderer.render(template: "webhooks/event", formats: [ format ], assigns: { event: @event })
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new(script_name: @event.account.slug)
+    end
+
+    def event_url
+      JSON.parse(render(:json)).dig("eventable", "url")
+    end
+end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..b0d6242
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,62 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 5
+  TOTAL_TIMEOUT = 15
+  MAX_RESPONSE_SIZE = 16.kilobytes
+
+  class DestinationError < StandardError; end
+
+  def initialize(url, headers:, body:)
+    @uri = URI.parse(url)
+    @headers, @body = headers, body
+  end
+
+  def perform
+    http = Net::HTTP.new(@uri.hostname, @uri.port, nil)
+    http.ipaddr = public_ip
+    http.use_ssl = @uri.scheme == "https"
+    http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+    http.max_retries = 0
+
+    post = Net::HTTP::Post.new(@uri.request_uri, @headers)
+    post.body = @body
+
+    response = nil
+    Timeout.timeout(TOTAL_TIMEOUT) do
+      # Exit the request entirely at the limit, otherwise Net::HTTP will read
+      # the rest of the body after the read_body block returns.
+      catch(:response_body_limit) do
+        http.start do |connection|
+          connection.request(post) do |result|
+            response = { code: result.code.to_i, headers: result.to_hash, body: +"" }
+            result.read_body do |chunk|
+              response[:body] << chunk.byteslice(0, MAX_RESPONSE_SIZE - response[:body].bytesize)
+              throw :response_body_limit if response[:body].bytesize >= MAX_RESPONSE_SIZE
+            end
+          end
+        end
+      end
+    end
+    response[:body] = response[:body].force_encoding(Encoding::UTF_8).scrub("?")
+    response
+  end
+
+  private
+    def public_ip
+      address = literal_ip
+      ip = if address
+        address.to_s unless SsrfProtection.blocked_address?(address)
+      else
+        SsrfProtection.resolve_public_ip(@uri.hostname)
+      end
+
+      ip || raise(DestinationError, "Destination does not resolve to a public IP address")
+    end
+
+    def literal_ip
+      IPAddr.new(@uri.hostname)
+    rescue IPAddr::InvalidAddressError
+      nil
+    end
+end
