+require "test_helper"
+
+class Webhook::DeliveryPayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "generic card events use the existing JSON representation and tenant URLs" do
+    event = events(:logo_published)
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, event).to_json)
+
+    assert_equal event.id, payload["id"]
+    assert_equal "card_published", payload["action"]
+    assert_equal cards(:logo).id, payload.dig("eventable", "id")
+    assert_includes payload.dig("eventable", "url"), "#{event.account.slug}/cards/"
+    assert_equal users(:david).id, payload.dig("creator", "id")
+  end
+
+  test "generic comment events include the comment and its card" do
+    event = events(:layout_commented)
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, event).to_json)
+
+    assert_equal event.eventable_id, payload.dig("eventable", "id")
+    assert_equal event.card.id, payload.dig("eventable", "card", "id")
+    assert payload.dig("eventable", "body", "plain_text").present?
+  end
+
+  test "Slack receivers get a text message and link" do
+    @webhook.url = "https://hooks.slack.com/services/T123/B123/test-token"
+    payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, events(:logo_published)).to_json)
+
+    assert_includes payload["text"], "added"
+    assert_includes payload["text"], "#{@webhook.account.slug}/cards/"
+    assert_includes payload["text"], "|View in Fizzy>"
+  end
+
+  test "Campfire and Basecamp receivers get HTML content" do
+    [ "https://campfire.example.com/rooms/123/456-test-token/messages",
+      "https://3.basecamp.com/123/integrations/test-token/buckets/456/chats/789/lines" ].each do |url|
+      @webhook.url = url
+      payload = JSON.parse(Webhook::Delivery::Payload.new(@webhook, events(:logo_published)).to_json)
+
+      assert_includes payload["content"], "added"
+      assert_includes payload["content"], "<a href="
+      assert_includes payload["content"], "#{@webhook.account.slug}/cards/"
+    end
+  end
+
+  test "payload rendering restores the caller account" do
+    Current.account = accounts(:initech)
+    Webhook::Delivery::Payload.new(@webhook, events(:logo_published)).to_json
+    assert_equal accounts(:initech), Current.account
+  end
+end
diff --git a/test/models/webhook/delivery_request_test.rb b/test/models/webhook/delivery_request_test.rb
new file mode 100644
index 0000000..19c08ce
--- /dev/null
+++ b/test/models/webhook/delivery_request_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+require "socket"
+
+class Webhook::DeliveryRequestTest < ActiveSupport::TestCase
+  test "connects to the pinned IP, preserves Host, and stops reading at the response limit" do
+    server = TCPServer.new("127.0.0.1", 0)
+    port = server.addr[1]
+    SsrfProtection.expects(:resolve_public_ip).with("receiver.example.test").returns("127.0.0.1")
+    received = Queue.new
+
+    receiver = Thread.new do
+      client = server.accept
+      headers = []
+      headers << client.gets until headers.last == "\r\n"
+      content_length = headers.find { |line| line.start_with?("Content-Length:") }.split.last.to_i
+      received << { headers: headers, body: client.read(content_length) }
+
+      size = Webhook::Delivery::Request::MAX_RESPONSE_SIZE
+      client.write("HTTP/1.1 200 OK\r\nContent-Length: #{size * 100}\r\nConnection: close\r\n\r\n")
+      client.write("x" * size)
+      # Never finish the advertised body: the sender must close at its limit.
+      client.read
+    ensure
+      client&.close
+    end
+
+    WebMock.disable!
+    response = Timeout.timeout(3) do
+      Webhook::Delivery::Request.new("http://receiver.example.test:#{port}/webhook", headers: { "Content-Type" => "application/json" }, body: "{}").perform
+    end
+
+    assert_equal 200, response[:code]
+    assert_equal "x" * Webhook::Delivery::Request::MAX_RESPONSE_SIZE, response[:body]
+    request = received.pop
+    assert_equal "POST /webhook HTTP/1.1\r\n", request[:headers].first
+    assert_includes request[:headers], "Host: receiver.example.test:#{port}\r\n"
+    assert_equal "{}", request[:body]
+    assert receiver.join(1), "Sender should close the connection when the response limit is reached"
+  ensure
+    WebMock.enable!
+    receiver&.kill
+    server&.close
+  end
+
+  test "literal private addresses are rejected without DNS resolution" do
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    %w[ http://127.0.0.1/webhook http://169.254.169.254/webhook http://[::1]/webhook ].each do |url|
+      assert_raises Webhook::Delivery::Request::DestinationError do
+        Webhook::Delivery::Request.new(url, headers: {}, body: "{}").perform
+      end
+    end
+  end
+end
