+    @card.reactions.create! content: "👍"
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the board period falls back to the account setting" do
+    freeze_time
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update! auto_postpone_period: 3.days
+
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :kevin
+    comment_by :david
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assignment creates a burst but unassignment does not" do
+    freeze_time
+    @card.toggle_assignment users(:david)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 1.day
+    @card.toggle_assignment users(:david)
+
+    assert_equal 1.day.ago, @card.reload.last_burst_at
+  end
+
+  test "direct assignment creates a burst" do
+    freeze_time
+    @card.assignments.create! assignee: users(:david), assigner: users(:kevin)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_equal Time.current, @card.last_active_at
+  end
+
+  test "reopening creates a burst but closing does not" do
+    freeze_time
+    @card.close
+
+    assert_nil @card.reload.last_burst_at
+
+    @card.reopen
+
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "only active cards are stalled" do
+    freeze_time
+    stall_card
+
+    @card.close
+    @card.update! last_active_at: 2.weeks.ago
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    @card.update! last_active_at: 2.weeks.ago
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    @card.update! last_active_at: 2.weeks.ago
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "the stall threshold is exactly two weeks" do
+    freeze_time
+    @card.update! last_burst_at: Time.current, last_active_at: Time.current
+
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "editing a card restarts the inactivity clock" do
+    freeze_time
+    stall_card
+
+    @card.update! description: "Next steps"
+
+    assert_not @card.reload.stalled?
+    assert_equal Time.current, @card.last_active_at
+
+    travel 2.weeks
+    assert @card.stalled?
+
+    @card.update! title: "A new title"
+    assert_not @card.reload.stalled?
+  end
+
+  test "editing and deleting comments restarts the inactivity clock" do
+    freeze_time
+    comment = comment_by :david
+    stall_card
+
+    comment.update! body: "Updated comment"
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+
+    comment.destroy!
+    assert_not @card.reload.stalled?
+  end
+
+  test "checklist and reaction activity restarts the inactivity clock" do
+    freeze_time
+    step = @card.steps.create! content: "A step"
+    stall_card
+
+    step.update! completed: true
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+
+    @card.reactions.create! content: "👍"
+    assert_not @card.reload.stalled?
+  end
+
+  test "stalled scope works across accounts" do
+    freeze_time
+    [ @card, cards(:radio) ].each do |card|
+      card.update! last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+    end
+
+    assert_equal [ @card, cards(:radio) ].to_set, Card.stalled.to_set
+    assert_equal [ @card ], @card.account.cards.stalled.to_a
+  end
+
+  private
+    def comment_by(name)
+      @card.comments.create! body: "A comment", creator: users(name)
+    end
+
+    def stall_card
+      @card.update! last_burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+      assert @card.stalled?
+    end
+end
