diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..4e57c58
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,33 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  MINIMUM_BURST_COMMENTS = 3
+  MINIMUM_BURST_CREATORS = 2
+
+  included do
+    scope :stalled, -> do
+      active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago)
+    end
+  end
+
+  def stalled?
+    active? && last_burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def record_burst(at: Time.current)
+    if last_burst_at.nil? || at > last_burst_at
+      update! last_burst_at: at
+    end
+  end
+
+  def record_comment_burst(comment)
+    counts = comments.by_user
+      .where(created_at: (comment.created_at - auto_postpone_period / 3.0)..comment.created_at)
+      .group(:creator_id).count
+
+    if counts.size >= MINIMUM_BURST_CREATORS && counts.values.sum >= MINIMUM_BURST_COMMENTS
+      record_burst at: comment.created_at
+    end
+  end
+end
