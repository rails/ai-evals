diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..94e01f6
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,255 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    @card.comments.delete_all
+  end
+
+  test "a comment burst followed by two weeks of inactivity stalls a card" do
+    freeze_time
+
+    @card.comments.create! body: "First", creator: users(:david)
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_not @card.stalled?
+
+    travel 2.weeks
+
+    assert @card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create! body: "Moving again", creator: users(:kevin)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+  test "old cards without a burst are not stalled" do
+    @card.update! last_active_at: 1.month.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a burst requires at least three comments" do
+    comment_by :david
+    comment_by :kevin
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments from just one person do not create a burst" do
+    3.times { comment_by :david }
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_by :david
+    comment_by :kevin
+    @card.comments.create! body: "System update", creator: @card.account.system_user
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments must fall within a third of the board auto-close period" do
+    freeze_time
+    @card.board.auto_postpone_period = 3.days
+
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :kevin
+    comment_by :david
+
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "the comment window includes its boundary" do
+    freeze_time
+    @card.board.auto_postpone_period = 3.days
+
+    comment_by :david
+    travel 1.day
+    comment_by :kevin
+    comment_by :david
+
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "later comment bursts refresh the burst timestamp" do
+    freeze_time
+    3.times { comment_by :david }
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 1.day
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    @card.record_burst at: 1.day.ago
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "ordinary activity does not create a burst" do
+    @card.update! description: "Working on it"
