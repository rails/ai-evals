new file mode 100644
index 0000000..7080266
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,62 @@
+# Single-server deployment. Change this hostname to one pointing at your server.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - &hostname fizzy.example.com
+
+# Kamal Proxy obtains a Let's Encrypt certificate and terminates HTTPS.
+# Thruster serves the app inside the container on port 80.
+proxy:
+  ssl: true
+  host: *hostname
+  app_port: 80
+
+# Kamal runs a local registry on the deploying computer and tunnels it over SSH.
+# No external image registry or registry credentials are needed.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server.
+
+# SQLite databases, uploaded files, and local exports survive container replacement.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep fingerprinted assets available across deployments.
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+    APP_FQDN: *hostname
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    SMTP_TLS: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
+
+# Kamal defaults to SSH as root. For a user with Docker access instead:
+# ssh:
+#   user: deploy
