+require "application_system_test_case"
+
+class DataTransferTest < ApplicationSystemTestCase
+  driven_by :selenium, using: :headless_chrome do |options|
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+    options.binary = "/usr/bin/chromium" if File.exist?("/usr/bin/chromium")
+  end
+
+  test "uploading an account ZIP from the import form creates a new account" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:jason))
+    export.generate_now
+    assert export.reload.completed?
+    archive = Tempfile.new([ "fizzy-account", ".zip" ])
+    archive.binmode
+    export.archive.blob.download { |chunk| archive.write(chunk) }
+    archive.flush
+
+    sign_in_as users(:david)
+    visit new_account_import_path(script_name: nil)
+    attach_file "Account ZIP file", archive.path
