diff --git a/app/models/zip_file/bounded_io.rb b/app/models/zip_file/bounded_io.rb
new file mode 100644
index 0000000..c03e895
--- /dev/null
+++ b/app/models/zip_file/bounded_io.rb
@@ -0,0 +1,22 @@
+# ZipKit reads the central directory in one go. Bound that read even when a
+# malicious archive claims its directory starts at the beginning of the file.
+class ZipFile::BoundedIO
+  MAX_READ = 256.megabytes
+
+  def initialize(io)
+    @io = io
+  end
+
+  delegate :size, :tell, to: :@io
+
+  def seek(position, mode = IO::SEEK_SET)
+    raise ArgumentError, "Invalid archive offset" unless mode == IO::SEEK_SET && position.between?(0, size)
+    @io.seek(position, mode)
+  end
+
+  def read(length = nil)
+    length ||= size - tell
+    raise ArgumentError, "Archive directory is too large" unless length.between?(0, MAX_READ)
+    @io.read(length)
+  end
+end
diff --git a/app/models/zip_file/range_io.rb b/app/models/zip_file/range_io.rb
new file mode 100644
index 0000000..244de76
--- /dev/null
+++ b/app/models/zip_file/range_io.rb
@@ -0,0 +1,40 @@
+# Read S3 archives with buffered ranged requests. Small parser reads and
+# sequential extraction share the buffer, avoiding one HTTP request per 64 KB.
+class ZipFile::RangeIO
+  BUFFER_SIZE = 8.megabytes
+
+  attr_reader :size
+
+  def initialize(blob)
+    @object = blob.service.send(:object_for, blob.key)
+    @size = blob.byte_size
+    @position = 0
+    @buffer = ""
+    @buffer_start = 0
+  end
+
+  def seek(position, mode = IO::SEEK_SET)
+    raise ArgumentError, "Invalid archive offset" unless mode == IO::SEEK_SET && position.between?(0, size)
+    @position = position
+  end
+
+  def tell
+    @position
+  end
+
+  def read(length = nil)
+    length = [ length || size - @position, size - @position ].min
+    raise ArgumentError, "Invalid archive read" if length.negative?
+    if length > 0
+      unless @position >= @buffer_start && @position + length <= @buffer_start + @buffer.bytesize
+        fetch_size = [ [ length, BUFFER_SIZE ].max, size - @position ].min
+        @buffer = @object.get(range: "bytes=#{@position}-#{@position + fetch_size - 1}").body.read
+        raise ArgumentError, "Truncated archive" unless @buffer.bytesize == fetch_size
+        @buffer_start = @position
+      end
+      @buffer.byteslice(@position - @buffer_start, length).tap { @position += length }
+    else
+      ""
+    end
+  end
+end
