+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "an account export restores cards, people, rich text, comments and files into a new account" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    export = Account::Export.create!(account: card.account, user: users(:jason))
+    export.generate_now
+
+    assert export.reload.completed?
+    ZipFile.open(export.archive) do |zip|
+      data = zip.read_json("cards/#{card.id}.json")
+      assert_equal card.title, data.fetch("title")
+      assert_equal card.comments.count, data.fetch("comments").size
+      assert_equal "picture", zip.read("files/#{card.image.blob.id}")
+    end
+
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    assert_difference "Account.count", 1 do
+      import.process_now
+    end
+    assert import.reload.completed?, import.error_message
+    assert_not import.archive.attached?
+    assert export.archive.attached?
+    imported = import.account.cards.find_by!(number: card.number)
+    assert_not_equal card.id, imported.id
+    assert_equal card.title, imported.title
+    assert_equal card.description.to_plain_text, imported.description.to_plain_text
+    assert_equal card.comments.count, imported.comments.count
+    assert_equal "picture", imported.image.download
+    assert import.account.users.find_by!(identity: identities(:david)).owner?
+    assert_equal card.account.cards.count, import.account.cards.count
+    assert_equal card.account.boards.count, import.account.boards.count
+  end
+
+  test "a failed import leaves no account or people behind" do
+    import = Account::Import.create!(identity: identities(:david), archive: {
+      io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip"
+    })
+    assert_no_difference [ "Account.count", "User.count", "Identity.count" ] do
+      import.process_now
+    end
+    assert import.reload.failed?
+    assert import.error_message.present?
+    assert_nil import.account
+  end
+
+  test "card exports do not include private boards, other people's drafts, or other accounts" do
+    Current.user = users(:kevin)
+    hidden = boards(:private).cards.create!(title: "Confidential", creator: users(:kevin), status: :published)
+    draft = boards(:writebook).cards.create!(title: "Kevin's draft", creator: users(:kevin), status: :drafted)
+    Current.identity = identities(:david)
+    own_draft = boards(:writebook).cards.create!(title: "My draft", creator: users(:david), status: :drafted)
+    hidden.image.attach(io: StringIO.new("secret file"), filename: "secret.txt")
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:david), scope: "cards")
+    export.generate_now
+    assert export.reload.completed?
+    ZipFile.open(export.archive) do |zip|
+      assert zip.exists?("cards/#{cards(:logo).id}.json")
+      assert zip.exists?("cards/#{own_draft.id}.json")
+      assert_not zip.exists?("cards/#{draft.id}.json")
+      assert_not zip.exists?("cards/#{hidden.id}.json")
+      assert_not zip.exists?("files/#{hidden.image.blob_id}")
+      assert_not zip.exists?("cards/#{cards(:radio).id}.json")
+      assert_empty zip.glob("records/*")
+    end
+  end
+
+  test "rich text attachments and mentions are portable" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded file"), filename: "document.txt", content_type: "text/plain")
+    card.update!(description: %(<p>Hello</p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment><action-text-attachment sgid="#{users(:kevin).attachable_sgid}"></action-text-attachment>))
+    comment = card.comments.first
+    comment.update!(body: %(<p>Comment file</p><action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>))
+    export = full_export
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    import.process_now
+    assert import.reload.completed?, import.error_message
+    imported = import.account.cards.find_by!(number: card.number)
+    assert_equal "embedded file", imported.description.embeds.first.download
+    assert_equal "embedded file", imported.comments.find_by!(creator_id: mention_creator_id(import, comment)).body.embeds.first.download
+    assert_not_equal blob.id, imported.description.embeds.first.id
+    mention = imported.description.body.attachables.grep(User).sole
+    assert_equal import.account.id, mention.account_id
+    assert_equal users(:kevin).name, mention.name
+    assert_equal blob.download, imported.description.embeds.first.download
+  end
+
+  test "a late failure rolls back records, identities, search and uploaded files" do
+    cards(:logo).image.attach(io: StringIO.new("picture"), filename: "picture.txt", content_type: "text/plain")
+    export = full_export
+    import = modified_import(export) do |path, data|
+      if path == Account::DataTransfer.path_for(User, users(:kevin).id)
+        data["email_address"] = "imported-new-person@example.com"
+      elsif path.start_with?("records/active_storage_attachments/")
+        data["name"] = "invalid-attachment-name"
+      end
+    end
+    assert_no_difference [ "Account.count", "User.count", "Identity.count", "Card.count", "Storage::Entry.count" ] do
+      import.process_now
+    end
+    assert import.reload.failed?
+    assert_match "Invalid file attachment", import.error_message
+    assert_empty stored_files(import)
+    assert_equal "picture", cards(:logo).image.download
+  end
+
+  test "an import cannot reference pre-existing local records through rich text" do
+    cards(:logo).update!(description: "Text")
+    export = full_export
+    import = modified_import(export) do |path, data|
+      if path.start_with?("records/action_text_rich_texts/")
+        data["body"] = %(<action-text-attachment sgid="#{users(:mike).attachable_sgid}"></action-text-attachment>)
+      end
+    end
+    assert_no_difference "Account.count" do
+      import.process_now
+    end
+    assert import.reload.failed?
+    assert_match "non-portable reference", import.error_message
+  end
+
+  test "card-only exports cannot be imported as accounts" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:david), scope: "cards")
+    export.generate_now
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    assert_no_difference "Account.count" do
+      import.process_now
+    end
+    assert import.reload.failed?
+    assert_match "full Fizzy account export", import.error_message
+  end
+
+  test "jobs run once and completion emails have the download and new account links" do
+    export = full_export
+    token = export.download_token
+    message = Account::DataTransferMailer.export_completed(export).message
+    assert_equal [ identities(:jason).email_address ], message.to
+    assert_includes message.text_part.body.to_s, token
+    assert_includes message.text_part.body.to_s, "24 hours"
+    assert_no_enqueued_jobs do
+      export.generate_now
+    end
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    import.process_now
+    assert import.reload.completed?, import.error_message
+    assert_no_difference "Account.count" do
+      assert_no_enqueued_jobs do
+        import.process_now
+      end
+    end
+    message = Account::DataTransferMailer.import_completed(import).message
+    assert_includes message.text_part.body.to_s, import.account.slug
+  end
+
+  test "incomplete manifests are rejected before creating an account" do
+    export = full_export
+    import = modified_import(export) do |path, data|
+      data["records"]["cards"] += 1 if path == "manifest.json"
+    end
+    assert_no_difference "Account.count" do
+      import.process_now
+    end
+    assert import.reload.failed?
+    assert_match "incomplete", import.error_message
+    message = Account::DataTransferMailer.import_completed(import).message
+    assert_includes message.text_part.body.to_s, import.error_message
+  end
+
+  test "expired exports and abandoned uploads are purged" do
+    export = full_export
+    blob = export.archive.blob
+    upload = Account::Import::Upload.create(identity: identities(:david), attributes: {
+      filename: "abandoned.zip", byte_size: 3, checksum: Base64.strict_encode64(Digest::MD5.digest("zip"))
+    })
+    upload.blob.service.upload(upload.blob.key, StringIO.new("zip"))
+    travel 3.days do
+      Account::Export.cleanup
+      Account::Import::Upload.cleanup
+    end
+    assert_not Account::Export.exists?(export.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.exists?(upload.blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_not upload.blob.service.exist?(upload.blob.key)
+  end
+
+  test "saved filters and relational metadata are restored with new IDs" do
+    export = full_export
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    import.process_now
+    assert import.reload.completed?, import.error_message
+    [ Column, Assignment, Closure, Tag, Tagging, Reaction, Event, Filter ].each do |klass|
+      assert_equal klass.where(account_id: accounts(:"37s").id).count, klass.where(account_id: import.account.id).count
+    end
+    filter = import.account.users.find_by!(identity: identities(:david)).filters.first
+    assert_equal filters(:jz_assignments).tags.pluck(:title), filter.tags.pluck(:title)
+    assert_equal filters(:jz_assignments).assignees.pluck(:name), filter.assignees.pluck(:name)
+    assert_not_equal filters(:jz_assignments).params_digest, filter.params_digest
+  end
+
+  test "background jobs generate transfers and send completion and failure emails" do
+    export = nil
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      perform_enqueued_jobs(only: [ Account::ExportJob, ActionMailer::MailDeliveryJob ]) do
+        export = Account::Export.create!(account: accounts(:"37s"), user: users(:jason))
+      end
+    end
+    assert export.reload.completed?
+    assert_match "export is ready", ActionMailer::Base.deliveries.last.subject
+
+    import = nil
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      perform_enqueued_jobs(only: [ Account::ImportJob, ActionMailer::MailDeliveryJob ]) do
+        import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+      end
+    end
+    assert import.reload.completed?, import.error_message
+    assert_match "import is complete", ActionMailer::Base.deliveries.last.subject
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      perform_enqueued_jobs(only: [ Account::ImportJob, ActionMailer::MailDeliveryJob ]) do
+        Account::Import.create!(identity: identities(:david), archive: {
+          io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip"
+        })
+      end
+    end
+    assert_match "import failed", ActionMailer::Base.deliveries.last.subject
+    assert_includes ActionMailer::Base.deliveries.last.text_part.body.to_s, "not a valid ZIP"
+  end
+
+  private
+    def mention_creator_id(import, comment)
+      import.account.users.find_by!(identity_id: comment.creator.identity_id).id
+    end
+
+    def full_export
+      Account::Export.create!(account: accounts(:"37s"), user: users(:jason)).tap do |export|
+        export.generate_now
+        assert export.reload.completed?
+      end
+    end
+
+    def modified_import(export)
+      import = Account::Import.new(identity: identities(:david))
+      ZipFile.open(export.archive) do |source|
+        ZipFile.create_for(import.archive, filename: "modified.zip") do |zip|
+          source.glob("*").each do |path|
+            content = source.read(path)
+            if path.end_with?(".json")
+              data = JSON.parse(content)
+              yield path, data
+              content = data.to_json
+            end
+            zip.add_file(path, content)
+          end
+        end
+      end
+      import.save!
+      import
+    end
+
+    def stored_files(import)
+      Dir[Rails.root.join("tmp/storage/files/**/imports/#{import.id}/**/*")].select { |path| File.file?(path) }
+    end
+end
