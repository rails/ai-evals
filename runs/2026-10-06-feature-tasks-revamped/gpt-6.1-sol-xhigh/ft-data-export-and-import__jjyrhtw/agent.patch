+++ b/app/controllers/account/imports/uploads_controller.rb
@@ -0,0 +1,48 @@
+class Account::Imports::UploadsController < ApplicationController
+  disallow_account_scope
+  include ActiveStorageControllerExtensions
+  before_action :set_upload, except: :create
+  rescue_from ArgumentError, with: :invalid_upload
+
+  def create
+    if params[:multipart] && !Account::Import::Upload.multipart_supported?
+      render json: { multipart: false }
+    else
+      attributes = params.expect(blob: [ :filename, :byte_size, :checksum, :content_type ]).to_h.symbolize_keys
+      upload = Account::Import::Upload.create(identity: Current.identity, attributes: attributes, multipart: params[:multipart].present?)
+      if params[:multipart]
+        render json: { multipart: true, part_size: upload.part_size, part_count: upload.part_count,
+          url: account_imports_upload_url(upload.token, script_name: nil) }
+      else
+        blob = upload.blob
+        render json: blob.as_json(root: false, methods: :signed_id).merge(direct_upload: {
+          url: blob.service_url_for_direct_upload, headers: blob.service_headers_for_direct_upload
+        })
+      end
+    end
+  end
+
+  def show
+    render json: { url: @upload.part_url(Integer(params.require(:part_number))) }
+  end
+
+  def update
+    parts = params.expect(parts: [ [ :part_number, :etag ] ]).map { |part| part.to_h.symbolize_keys }
+    @upload.complete(parts)
+    render json: { signed_id: @upload.blob.signed_id }
+  end
+
+  def destroy
+    @upload.abort
+    head :no_content
+  end
+
+  private
+    def set_upload
+      @upload = Account::Import::Upload.find(params[:id], identity: Current.identity)
+    end
+
+    def invalid_upload(error)
+      render json: { error: error.message }, status: :unprocessable_entity
+    end
+end
