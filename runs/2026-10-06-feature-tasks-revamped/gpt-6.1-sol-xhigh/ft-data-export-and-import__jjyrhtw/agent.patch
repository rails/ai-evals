diff --git a/app/javascript/controllers/account_import_upload_controller.js b/app/javascript/controllers/account_import_upload_controller.js
new file mode 100644
index 0000000..1791df4
--- /dev/null
+++ b/app/javascript/controllers/account_import_upload_controller.js
@@ -0,0 +1,92 @@
+import { Controller } from "@hotwired/stimulus"
+import { DirectUpload } from "@rails/activestorage"
+
+export default class extends Controller {
+  static targets = [ "file", "progress", "submit" ]
+  static values = { url: String }
+
+  async upload(event) {
+    if (this.ready) return
+    event.preventDefault()
+    if (this.uploading) return
+    this.uploading = true
+    this.submitTarget.disabled = true
+
+    try {
+      const file = this.fileTarget.files[0]
+      if (!file) throw new Error("Choose a ZIP file first")
+      const upload = await this.#request(this.urlValue, "POST", {
+        multipart: true, blob: { filename: file.name, byte_size: file.size }
+      })
+      const signedId = upload.multipart ? await this.#multipart(file, upload) : await this.#direct(file)
+      const input = document.createElement("input")
+      input.type = "hidden"
+      input.name = this.fileTarget.name
+      input.value = signedId
+      this.element.append(input)
+      this.fileTarget.removeAttribute("name")
+      this.ready = true
+      this.submitTarget.disabled = false
+      this.element.requestSubmit()
+    } catch (error) {
+      this.progressTarget.textContent = `Upload failed: ${error.message}. Please try again.`
+      this.submitTarget.disabled = false
+    } finally {
+      this.uploading = false
+    }
+  }
+
+  async #multipart(file, upload) {
+    const parts = []
+    try {
+      for (let number = 1; number <= upload.part_count; number++) {
+        this.progressTarget.textContent = `Uploading file: ${Math.floor(100 * (number - 1) / upload.part_count)}%`
+        const chunk = file.slice((number - 1) * upload.part_size, number * upload.part_size)
+        parts.push({ part_number: number, etag: await this.#uploadPart(upload.url, number, chunk) })
+      }
+      this.progressTarget.textContent = "Finishing upload…"
+      return (await this.#request(upload.url, "PATCH", { parts })).signed_id
+    } catch (error) {
+      await this.#request(upload.url, "DELETE").catch(() => {})
+      throw error
+    }
+  }
+
+  async #uploadPart(url, number, chunk) {
+    for (let attempt = 0; attempt < 3; attempt++) {
+      try {
+        const part = await this.#request(`${url}?part_number=${number}`, "GET")
+        const response = await fetch(part.url, { method: "PUT", body: chunk })
+        if (!response.ok) throw new Error(`Storage returned ${response.status}`)
+        const etag = response.headers.get("ETag")
+        if (!etag) throw new Error("Storage must expose the ETag header in its CORS configuration")
+        return etag
+      } catch (error) {
+        if (attempt === 2) throw error
+        await new Promise(resolve => setTimeout(resolve, 1000 * 2 ** attempt))
+      }
+    }
+  }
+
+  #direct(file) {
+    this.progressTarget.textContent = "Uploading file…"
+    return new Promise((resolve, reject) => {
+      new DirectUpload(file, this.urlValue).create((error, blob) => {
+        error ? reject(new Error(error)) : resolve(blob.signed_id)
+      })
+    })
+  }
+
+  async #request(url, method, data) {
+    const response = await fetch(url, {
+      method, credentials: "same-origin",
+      headers: { "Content-Type": "application/json", "Accept": "application/json",
+        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || "" },
+      body: data ? JSON.stringify(data) : undefined
+    })
+    if (response.status === 204) return
+    const result = await response.json()
+    if (!response.ok) throw new Error(result.error || `Server returned ${response.status}`)
+    return result
+  }
+}
