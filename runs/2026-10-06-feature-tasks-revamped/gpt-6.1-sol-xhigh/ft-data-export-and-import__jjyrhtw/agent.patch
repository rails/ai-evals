@@ -0,0 +1,29 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Current.identity.account_imports.new(import_params)
+    if @import.save
+      redirect_to new_account_import_path(script_name: nil), notice: "Your account is being imported. We'll email you when it's done."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_params
+      attributes = params.expect(account_import: [ :archive ])
+      if attributes[:archive].is_a?(String) && attributes[:archive].present?
+        blob = ActiveStorage::Blob.find_signed(attributes[:archive])
+        unless blob && blob.metadata["import_identity_id"] == Current.identity.id && !blob.metadata["multipart_upload_id"]
+          raise ActiveRecord::RecordNotFound
+        end
+        attributes[:archive] = blob
+      end
+      attributes
+    end
+end
