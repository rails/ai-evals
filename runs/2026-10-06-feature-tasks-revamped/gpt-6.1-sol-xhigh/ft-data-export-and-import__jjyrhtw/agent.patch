--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,76 @@
+class ZipFile::Reader
+  MAX_JSON_SIZE = 16.megabytes
+  CHUNK_SIZE = 64.kilobytes
+
+  def initialize(io)
+    @io = io
+    @entries = {}
+    ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: false).each do |entry|
+      path = entry.filename
+      unless path.match?(%r{\A[a-zA-Z0-9_/.-]+\z}) && !path.split("/").include?("..") && !path.start_with?("/")
+        raise ArgumentError, "Unsafe archive entry"
+      end
+      raise ArgumentError, "Duplicate archive entry: #{path}" if @entries.key?(path)
+      raise ArgumentError, "Unsupported ZIP compression" unless entry.storage_mode.in?([ 0, 8 ])
+      raise ArgumentError, "Encrypted archives are not supported" unless (entry.gp_flags & 1).zero?
+      @entries[path] = entry
+    end
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read_json(path)
+    JSON.parse(read(path))
+  end
+
+  def read(path)
+    raise ArgumentError, "JSON entry is too large: #{path}" if @entries.fetch(path).uncompressed_size > MAX_JSON_SIZE
+    output = StringIO.new
+    copy(path, output, limit: MAX_JSON_SIZE)
+    output.string
+  end
+
+  def copy(path, output, limit: nil)
+    entry = @entries.fetch(path) { raise ArgumentError, "Missing archive entry: #{path}" }
+    offset = ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    unless offset >= 0 && entry.compressed_size >= 0 && offset + entry.compressed_size <= @io.size
+      raise ArgumentError, "Invalid ZIP entry bounds: #{path}"
+    end
+    @io.seek(offset)
+    remaining = entry.compressed_size
+    size = 0
+    crc = 0
+    inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if entry.storage_mode == 8
+    consume = ->(chunk) do
+      size += chunk.bytesize
+      if size > entry.uncompressed_size || (limit && size > limit)
+        raise ArgumentError, "Archive entry exceeds its declared size: #{path}"
+      end
+      crc = Zlib.crc32(chunk, crc)
+      output.write(chunk)
+    end
+
+    while remaining > 0
+      chunk = @io.read([ remaining, CHUNK_SIZE ].min)
+      raise ArgumentError, "Truncated ZIP entry: #{path}" if chunk.nil? || chunk.empty?
+      remaining -= chunk.bytesize
+      if inflater
+        inflater.inflate(chunk, &consume)
+      else
+        consume.call(chunk)
+      end
+    end
+    raise ArgumentError, "Truncated deflated entry: #{path}" if inflater && !inflater.finished?
+    unless size == entry.uncompressed_size && crc == entry.crc32
+      raise ArgumentError, "Archive checksum mismatch: #{path}"
+    end
+  ensure
+    inflater&.close
+  end
+end
