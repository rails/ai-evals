@@ -0,0 +1,46 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "writer counts bytes and checksums and reader preserves whitespace files" do
+    io = archive("spaces.txt" => " \n\t" * 30_000)
+    reader = ZipFile::Reader.new(ZipFile::BoundedIO.new(io))
+    output = StringIO.new
+    reader.copy("spaces.txt", output)
+    assert_equal " \n\t" * 30_000, output.string
+  end
+
+  test "corrupt entry data is rejected" do
+    io = archive("file.txt" => "original content")
+    corrupted = io.string.sub("original content", "modified content")
+    reader = ZipFile::Reader.new(StringIO.new(corrupted))
+    assert_raises(ArgumentError) { reader.read("file.txt") }
+  end
+
+  test "unsafe and duplicate entry names are rejected" do
+    io = archive("safe/file.txt" => "content")
+    unsafe = io.string.gsub("safe/file.txt", ".././file.txt")
+    assert_raises(ArgumentError) { ZipFile::Reader.new(StringIO.new(unsafe)) }
+    io = archive("one.json" => "{}", "two.json" => "{}")
+    duplicate = io.string.gsub("two.json", "one.json")
+    assert_raises(ArgumentError) { ZipFile::Reader.new(StringIO.new(duplicate)) }
+  end
+
+  test "bounded IO refuses out-of-range offsets and excessive reads" do
+    io = ZipFile::BoundedIO.new(StringIO.new("data"))
+    assert_raises(ArgumentError) { io.seek(-1) }
+    assert_raises(ArgumentError) { io.seek(5) }
+    assert_raises(ArgumentError) { io.read(ZipFile::BoundedIO::MAX_READ + 1) }
+  end
+
+  private
+    def archive(files)
+      io = StringIO.new
+      writer = ZipFile::Writer.new(io)
+      files.each { |name, content| writer.add_file(name, content, compress: false) }
+      writer.close
+      assert_equal io.string.bytesize, writer.byte_size
+      assert_equal Base64.strict_encode64(Digest::MD5.digest(io.string)), writer.checksum
+      io.rewind
+      io
+    end
+end
