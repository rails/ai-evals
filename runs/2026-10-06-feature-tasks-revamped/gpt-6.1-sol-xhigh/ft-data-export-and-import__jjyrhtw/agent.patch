+++ b/test/controllers/account/data_transfers_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Account::DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  test "only an admin can request a complete account export" do
+    sign_in_as :david
+    assert_no_difference "Account::Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+    sign_out
+    sign_in_as :jason
+    assert_enqueued_with(job: Account::ExportJob) do
+      assert_difference "Account::Export.count" do
+        post account_exports_path
+        assert_redirected_to account_settings_path
+      end
+    end
+    assert_equal "account", Account::Export.last.scope
+  end
+
+  test "a member exports their own visible cards and cannot choose an account scope" do
+    sign_in_as :david
+    assert_difference "Account::Export.count" do
+      post my_exports_path, params: { scope: "account", user_id: users(:kevin).id }
+      assert_redirected_to user_path(users(:david))
+    end
+    assert_equal users(:david), Account::Export.last.user
+    assert_equal "cards", Account::Export.last.scope
+  end
+
+  test "the email download link works without a session for only one day" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:jason))
+    export.generate_now
+    token = export.download_token
+    untenanted do
+      get account_export_path(token)
+      assert_response :redirect
+      assert_match %r{/rails/active_storage/disk/}, response.location
+      assert_equal "no-store", response.headers["Cache-Control"]
+      travel_to export.expires_at + 1.second do
+        get account_export_path(token)
+        assert_response :not_found
+      end
+      get account_export_path("invalid-token")
+      assert_response :not_found
+    end
+  end
+
+  test "a signed in identity with no account can upload an import" do
+    identity = Identity.create!(email_address: "newcomer@example.com")
+    sign_in_as identity
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_enqueued_with(job: Account::ImportJob) do
+        assert_difference "Account::Import.count" do
