+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,24 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+  disallow_account_scope only: :show
+  allow_unauthenticated_access only: :show
+
+  def create
+    Current.account.exports.create!(user: Current.user)
+    redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you a download link when it's ready."
+  end
+
+  def show
+    export = Account::Export.find_signed(params[:id], purpose: :export_download)
+    raise ActiveRecord::RecordNotFound unless export
+    if export.available?
+      expires_in = export.expires_at - Time.current
+      response.headers["Cache-Control"] = "no-store"
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port, script_name: "" }) do
+        redirect_to export.archive.blob.url(expires_in: expires_in, disposition: :attachment), allow_other_host: true
+      end
+    else
+      head :gone
+    end
+  end
+end
diff --git a/app/controllers/account/imports/uploads_controller.rb b/app/controllers/account/imports/uploads_controller.rb
new file mode 100644
index 0000000..f5d0855
