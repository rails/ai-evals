+++ b/test/models/account/data_transfer_s3_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class Account::DataTransferS3Test < ActiveSupport::TestCase
+  class MemoryS3 < ActiveStorage::Service::S3Service
+    attr_reader :objects, :ranges
+
+    def initialize
+      super(bucket: "test-archives", region: "us-east-1", access_key_id: "test", secret_access_key: "test", stub_responses: true)
+      self.name = "archive_s3"
+      @objects, @ranges = {}, []
+    end
+
+    def upload(key, io, **)
+      @objects[key] = io.read
+    end
+
+    def download(key)
+      if block_given?
+        yield @objects.fetch(key)
+      else
+        @objects.fetch(key)
+      end
+    end
+
+    def delete(key)
+      @objects.delete(key)
+    end
+
+    private
+      def upload_stream(key:, **)
+        io = StringIO.new
+        yield io
+        @objects[key] = io.string
+      end
+
+      def object_for(key)
+        data = @objects.fetch(key)
+        ranges = @ranges
+        object = Object.new
+        object.define_singleton_method(:get) do |range:|
+          ranges << range
+          first, last = range.delete_prefix("bytes=").split("-").map(&:to_i)
+          Struct.new(:body).new(StringIO.new(data.byteslice(first..last)))
+        end
+        object
+      end
+  end
+
+  test "S3 exports are streamed and imports use range reads and streamed uploads" do
+    original_service = ActiveStorage::Blob.service
+    service = MemoryS3.new
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).with(service.name).returns(service)
+    cards(:logo).image.attach(io: StringIO.new("S3 file"), filename: "file.txt", content_type: "text/plain")
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:jason))
+    export.generate_now
+    assert export.reload.completed?
+    assert_equal "archive_s3", export.archive.blob.service_name
+    assert_equal service.objects.fetch(export.archive.blob.key).bytesize, export.archive.blob.byte_size
+    import = Account::Import.create!(identity: identities(:david), archive: export.archive.blob)
+    import.process_now
+    assert import.reload.completed?, import.error_message
+    assert service.ranges.any?
+    card = import.account.cards.find_by!(number: cards(:logo).number)
+    assert_equal "S3 file", card.image.download
+    assert_not_equal cards(:logo).image.blob.key, card.image.blob.key
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+  test "very large S3 uploads use bounded parts and identity-owned signed tokens" do
+    original_service = ActiveStorage::Blob.service
+    service = MemoryS3.new
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).with(service.name).returns(service)
+    service.client.client.stub_responses(:create_multipart_upload, upload_id: "upload-id")
+    upload = Account::Import::Upload.create(identity: identities(:david),
+      attributes: { filename: "large-account.zip", byte_size: 501.gigabytes }, multipart: true)
+    assert_nil upload.blob.account_id
+    assert upload.part_count <= 10_000
+    assert upload.part_size >= 100.megabytes
+    assert_match "uploadId=upload-id", upload.part_url(1)
+    assert_raises(ArgumentError) { upload.part_url(upload.part_count + 1) }
+    assert_equal upload.blob, Account::Import::Upload.find(upload.token, identity: identities(:david)).blob
+    assert_raises(ActiveRecord::RecordNotFound) { Account::Import::Upload.find(upload.token, identity: identities(:jz)) }
+
+    parts = (1..upload.part_count).map { |number| { part_number: number, etag: "part-#{number}" } }
+    service.client.client.stub_responses(:complete_multipart_upload, {})
+    service.client.client.stub_responses(:head_object, content_length: upload.blob.byte_size)
+    upload.complete(parts)
+    assert upload.blob.reload.metadata["upload_complete"]
+    assert_nil upload.blob.metadata["multipart_upload_id"]
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+
+  test "incomplete multipart uploads are aborted and leave no temporary blob" do
+    original_service = ActiveStorage::Blob.service
+    service = MemoryS3.new
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).with(service.name).returns(service)
+    service.client.client.stub_responses(:create_multipart_upload, upload_id: "upload-id")
+    service.client.client.stub_responses(:abort_multipart_upload, {})
+    upload = Account::Import::Upload.create(identity: identities(:david),
+      attributes: { filename: "large-account.zip", byte_size: 501.gigabytes }, multipart: true)
+    assert_difference "ActiveStorage::Blob.count", -1 do
+      assert_raises(ArgumentError) { upload.complete([]) }
+    end
+    assert service.client.client.api_requests.any? { |request| request[:operation_name] == :abort_multipart_upload }
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+end
