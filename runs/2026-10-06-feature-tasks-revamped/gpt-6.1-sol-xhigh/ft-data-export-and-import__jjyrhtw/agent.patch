+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,18 @@
+module Account::DataTransfer
+  VERSION = 1
+
+  # A fixed allowlist: never constantize model names supplied by an archive.
+  # Credentials, sessions, push endpoints, caches, and derived image variants
+  # are deliberately not transferable.
+  def self.record_classes
+    [ User, User::Settings, Board, Column, Card, Comment, Tag, Tagging,
+      Access, Assignment, Closure, Card::Goldness, Card::NotNow, Card::ActivitySpike,
+      Step, Watch, Pin, Reaction, Entropy, Event, Mention,
+      Notification::Bundle, Notification, Board::Publication, Webhook, Webhook::DelinquencyTracker, Webhook::Delivery, Filter,
+      ::ActionText::RichText, ::ActiveStorage::Blob, ::ActiveStorage::Attachment ]
+  end
+
+  def self.path_for(klass, id)
+    "records/#{klass.table_name}/#{id}.json"
+  end
+end
diff --git a/app/models/account/data_transfer/reader.rb b/app/models/account/data_transfer/reader.rb
new file mode 100644
index 0000000..7329e7a
--- /dev/null
+++ b/app/models/account/data_transfer/reader.rb
@@ -0,0 +1,260 @@
+class Account::DataTransfer::Reader
+  def initialize(import, zip)
+    @import, @zip = import, zip
+    @ids = {}
+    @uploaded_blobs = []
+  end
+
+  def restore
+    manifest = @zip.read_json("manifest.json")
+    unless manifest.values_at("format", "version", "scope") == [ "fizzy", Account::DataTransfer::VERSION, "account" ]
+      raise ArgumentError, "Please upload a supported, full Fizzy account export"
+    end
+
+    verify_manifest(manifest)
+
+    Account.transaction do
+      name = manifest.fetch("account").fetch("name")
+      raise ArgumentError, "The account name is missing" if name.blank?
+      id = ActiveRecord::Type::Uuid.generate
+      Account.insert_all!([ { id: id, name: name, external_account_id: Account::ExternalIdSequence.next,
+        created_at: Time.current, updated_at: Time.current } ])
+      @account = Account.find(id)
+      @account.create_join_code!
+      @ids[[ "Account", manifest.fetch("account").fetch("id") ]] = @account.id
+      Current.with(account: @account, user: nil) do
+        prepare_ids
+        restore_records
+        ensure_owner
+        verify_account
+        @account.update!(cards_count: @account.cards.maximum(:number) || 0)
+        rebuild_derived_data
+        @import.update!(account: @account, status: :completed, error_message: nil)
+      end
+    end
+  rescue
+    # Database transactions do not undo object storage uploads. Only new keys
+    # are tracked here, so a failure cannot delete files in another account.
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+    raise
+  end
+
+  private
+    def verify_manifest(manifest)
+      counts = manifest.fetch("records")
+      classes = Account::DataTransfer.record_classes
+      unless counts.keys.sort == classes.map(&:table_name).sort && classes.all? { |klass|
+          counts.fetch(klass.table_name) == @zip.glob("records/#{klass.table_name}/*.json").size
+        } && @zip.glob("records/*").size == counts.values.sum && manifest.fetch("files") == @zip.glob("files/*").size
+        raise ArgumentError, "The archive is incomplete or contains unsupported records"
+      end
+    end
+
+    def prepare_ids
+      Account::DataTransfer.record_classes.each do |klass|
+        @zip.glob("records/#{klass.table_name}/*.json").each do |path|
+          old_id = File.basename(path, ".json")
+          raise ArgumentError, "Invalid record ID" unless old_id.match?(/\A[a-z0-9]{25}\z/)
+          @ids[[ klass.name, old_id ]] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+    end
+
+    def restore_records
+      Account::DataTransfer.record_classes.each do |klass|
+        @zip.glob("records/#{klass.table_name}/*.json").each do |path|
+          attributes = @zip.read_json(path)
+          old_id = attributes.fetch("id")
+          unless path == Account::DataTransfer.path_for(klass, old_id)
+            raise ArgumentError, "Record ID does not match its archive entry"
+          end
+          email_address = attributes.delete("email_address") if klass == User
+          resources = attributes.delete("resources") if klass == Filter
+          attributes = attributes.slice(*klass.column_names)
+          attributes["id"] = mapped_id(klass.name, old_id)
+          attributes["account_id"] = @account.id
+          remap_associations(klass, attributes)
+
+          case klass.name
+          when "User"
+            restore_identity(attributes, email_address)
+          when "ActionText::RichText"
+            attributes["body"] = restore_rich_text(attributes.fetch("body"))
+            validate_rich_text(attributes)
+          when "ActiveStorage::Blob"
+            restore_blob(attributes, old_id)
+          when "ActiveStorage::Attachment"
+            validate_attachment(attributes)
+          when "Board::Publication"
+            attributes["key"] = SecureRandom.base58(24)
+          when "Webhook"
+            attributes["signing_secret"] = SecureRandom.hex(32)
+            attributes["active"] = false
+          when "Webhook::Delivery"
+            attributes["state"] = "completed"
+          when "Notification::Bundle"
+            attributes["status"] = "delivered"
+          end
+          klass.insert_all!([ attributes ])
+          restore_filter(attributes["id"], resources) if klass == Filter
+        end
+      end
+    end
+
+    def restore_filter(id, resources)
+      filter = Filter.find(id)
+      filter.card_ids = Array(filter.card_ids).filter_map { |old_id| @ids[[ "Card", old_id ]] }
+      filter.column_ids = Array(filter.column_ids).filter_map { |old_id| @ids[[ "Column", old_id ]] }
+      Filter.reflect_on_all_associations(:has_and_belongs_to_many).each do |association|
+        ids = resources.fetch(association.name.to_s).map { |old_id| mapped_id(association.klass.name, old_id) }
+        filter.public_send("#{association.name.to_s.singularize}_ids=", ids)
+      end
+      filter.save! # Recalculate its digest with the new resource IDs.
+    end
+
+    def remap_associations(klass, attributes)
+      klass.reflect_on_all_associations(:belongs_to).each do |association|
+        key = association.foreign_key
+        next if key.in?([ "account_id", "identity_id" ]) || attributes[key].nil?
+        type = if association.polymorphic?
+          attributes.fetch(association.foreign_type)
+        else
+          association.klass.name
+        end
+        if association.polymorphic?
+          allowed_types = {
+            "Entropy" => [ "Account", "Board" ], "Event" => [ "Card", "Comment" ],
+            "Reaction" => [ "Card", "Comment" ], "Mention" => [ "Card", "Comment" ],
+            "Notification" => [ "Event", "Mention" ],
+            "ActionText::RichText" => [ "Card", "Comment", "Board" ],
+            "ActiveStorage::Attachment" => [ "Card", "User", "ActionText::RichText" ]
+          }
+          unless allowed_types.fetch(klass.name, []).include?(type)
+            raise ArgumentError, "Invalid #{klass.name} reference"
+          end
+        end
+        attributes[key] = mapped_id(type, attributes[key])
+      end
+    end
+
+    def mapped_id(type, old_id)
+      @ids.fetch([ type, old_id ]) { raise ArgumentError, "Missing #{type} record referenced by the archive" }
+    end
+
+    def restore_identity(attributes, email_address)
+      unless attributes["role"].in?(User.roles.keys) && attributes["name"].present?
+        raise ArgumentError, "Invalid person in archive"
+      end
+      attributes["identity_id"] = if email_address.present? && attributes["role"] != "system"
+        Identity.find_or_create_by!(email_address: email_address).id
+      end
+    end
+
+    def restore_rich_text(html)
+      document = Nokogiri::HTML.fragment(html)
+      document.css("action-text-attachment").each do |node|
+        if node["sgid"].present? || node["signed-id"].present?
+          raise ArgumentError, "Rich text contains a non-portable reference"
+        end
+      end
+      document.css("action-text-attachment[data-fizzy-id]").each do |node|
+        type = node["data-fizzy-type"]
+        unless type.in?([ "ActiveStorage::Blob", "User" ])
+          raise ArgumentError, "Unsupported rich text attachment"
+        end
+        new_id = mapped_id(type, node["data-fizzy-id"])
+        # Blobs are inserted later in the record sequence; their signed IDs only
+        # require their new primary keys, not persisted records.
+        attachable = type == "User" ? User.new(id: new_id) : ::ActiveStorage::Blob.new(id: new_id)
+        node["sgid"] = attachable.attachable_sgid
+        node.remove_attribute("url")
+        node.remove_attribute("data-fizzy-type")
+        node.remove_attribute("data-fizzy-id")
+      end
+      if document.css("action-text-attachment[sgid]").any? { |node| node["sgid"].blank? }
+        raise ArgumentError, "Invalid rich text reference"
+      end
+      document.to_html
+    end
+
+    def validate_rich_text(attributes)
+      names = { "Card" => "description", "Comment" => "body", "Board" => "public_description" }
+      unless names[attributes["record_type"]] == attributes["name"]
+        raise ArgumentError, "Invalid rich text record"
+      end
+    end
+
+    def restore_blob(attributes, old_id)
+      attributes["key"] = "imports/#{@import.id}/#{::ActiveStorage::Blob.generate_unique_secure_token}"
+      attributes["service_name"] = ::ActiveStorage::Blob.service.name
+      blob = ::ActiveStorage::Blob.new(attributes)
+      @uploaded_blobs << blob
+      digest = Digest::MD5.new
+      count = 0
+      ZipFile.write_blob(blob) do |output|
+        sink = Object.new
+        sink.define_singleton_method(:write) do |chunk|
+          digest.update(chunk)
+          count += chunk.bytesize
+          output.write(chunk)
+        end
+        @zip.copy("files/#{old_id}", sink, limit: blob.byte_size)
+      end
+      checksum = Base64.strict_encode64(digest.digest)
+      unless count == blob.byte_size && (blob.checksum.blank? || checksum == blob.checksum)
+        raise ArgumentError, "Attachment checksum mismatch: #{blob.filename}"
+      end
+      attributes["checksum"] = checksum
+      attributes["metadata"] = blob.metadata.except("composed")
+    end
+
+    def validate_attachment(attributes)
+      names = { "Card" => [ "image" ], "User" => [ "avatar" ], "ActionText::RichText" => [ "embeds" ] }
+      unless names.fetch(attributes["record_type"], []).include?(attributes["name"])
+        raise ArgumentError, "Invalid file attachment"
+      end
+    end
+
+    def ensure_owner
+      owner = @account.users.find_by(identity: @import.identity)
+      if owner
+        owner.update_columns(role: "owner", active: true, verified_at: Time.current)
+      else
+        owner = @account.users.create!(identity: @import.identity, name: @import.identity.email_address,
+          role: :owner, verified_at: Time.current)
+      end
+      @account.users.create!(name: "System", role: :system) unless @account.users.exists?(role: :system)
+      @account.boards.find_each do |board|
+        unless board.accesses.exists?(user: owner)
+          Access.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: board.id, user_id: owner.id } ])
+        end
+      end
+    end
+
+    def verify_account
+      # All references are mapped through this archive. Also reject internally
+      # inconsistent relationships that would otherwise bypass normal validation.
+      raise ArgumentError, "The account settings are missing" unless @account.entropy
+      @account.cards.includes(:column).find_each do |card|
+        if card.column && card.column.board_id != card.board_id
+          raise ArgumentError, "A card references a column on a different board"
+        end
+        unless card.status.in?(Card.statuses.keys) && card.number.positive?
+          raise ArgumentError, "Invalid card in archive"
+        end
+      end
+      @account.users.find_each do |user|
+        if @account.users.where(identity_id: user.identity_id).where.not(id: user.id).exists? && user.identity_id
+          raise ArgumentError, "Duplicate person in archive"
+        end
+      end
+    end
+
+    def rebuild_derived_data
+      @account.cards.find_each(&:reindex)
+      Comment.where(account_id: @account.id).find_each(&:reindex)
+      ::ActiveStorage::Attachment.where(account_id: @account.id).find_each do |attachment|
+        attachment.send(:record_storage_attach)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/writer.rb b/app/models/account/data_transfer/writer.rb
new file mode 100644
index 0000000..b3a6694
--- /dev/null
+++ b/app/models/account/data_transfer/writer.rb
@@ -0,0 +1,124 @@
+class Account::DataTransfer::Writer
+  def initialize(export, zip)
+    @export, @zip = export, zip
+    @account = export.account
+    @record_counts = {}
+  end
+
+  def write
+    write_account_records if @export.scope == "account"
+    write_cards
+    @zip.add_file("manifest.json", {
+      format: "fizzy", version: Account::DataTransfer::VERSION,
+      scope: @export.scope, account: @account.attributes, exported_at: Time.current,
+      records: @record_counts, files: @zip.glob("files/*").size
+    }.to_json)
+  end
+
+  private
+    def write_account_records
+      Account::DataTransfer.record_classes.each do |klass|
+        records = klass.where(account_id: @account.id)
+        if klass == ::ActiveStorage::Attachment
+          # Do not recursively export previous transfers or derived previews.
+          records = transferable_attachments
+        elsif klass == ::ActiveStorage::Blob
+          records = ::ActiveStorage::Blob.where(id: transferable_attachments.select(:blob_id))
+        end
+        @record_counts[klass.table_name] = 0
+        records.find_each(batch_size: 100) do |record|
+          data = record.attributes
+          if record.is_a?(User)
+            data["email_address"] = record.identity&.email_address
+          elsif record.is_a?(Filter)
+            data["resources"] = record.class.reflect_on_all_associations(:has_and_belongs_to_many).to_h do |association|
+              [ association.name.to_s, record.public_send(association.name).ids ]
+            end
+          elsif record.is_a?(::ActionText::RichText)
+            data["body"] = portable_rich_text(record)
+          end
+          @zip.add_file(Account::DataTransfer.path_for(klass, record.id), data.to_json)
+          @record_counts[klass.table_name] += 1
+          write_blob(record) if record.is_a?(::ActiveStorage::Blob)
+        end
+      end
+    end
+
+    def transferable_attachments
+      ::ActiveStorage::Attachment.where(account_id: @account.id).where(
+        "(record_type = ? AND name = ?) OR (record_type = ? AND name = ?) OR (record_type = ? AND name = ?)",
+        "Card", "image", "User", "avatar", "ActionText::RichText", "embeds")
+    end
+
+    def portable_rich_text(record)
+      document = Nokogiri::HTML.fragment(record.body&.to_html.to_s)
+      document.css("action-text-attachment[sgid]").each do |node|
+        attachable = ::ActionText::Attachable.from_attachable_sgid(node["sgid"])
+        if attachable.is_a?(::ActiveStorage::Blob) || (attachable.is_a?(User) && attachable.account_id == @account.id)
+          node["data-fizzy-type"] = attachable.class.name
+          node["data-fizzy-id"] = attachable.id
+          node.remove_attribute("sgid")
+          node.remove_attribute("url")
+        else
+          raise ArgumentError, "Cannot export an unresolved rich text attachment"
+        end
+      end
+      document.to_html
+    end
+
+    def write_blob(blob)
+      unless @zip.exists?("files/#{blob.id}")
+        @zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+
+    def write_cards
+      cards = if @export.scope == "account"
+        @account.cards
+      else
+        visible_cards = @export.user.accessible_cards.where(account_id: @account.id)
+        visible_cards.where(status: :published).or(visible_cards.where(creator: @export.user))
+      end
+      cards.find_each do |card|
+        attachments = attachments_for(card).includes(:blob)
+        attachments.find_each { |attachment| write_blob(attachment.blob) }
+        write_card(card, attachments)
+      end
+    end
+
+    def attachments_for(card)
+      rich_texts = ::ActionText::RichText.where(record: card).or(
+        ::ActionText::RichText.where(record_type: "Comment", record_id: card.comments.select(:id)))
+      ::ActiveStorage::Attachment.where(record: card).or(
+        ::ActiveStorage::Attachment.where(record_type: "Comment", record_id: card.comments.select(:id))).or(
+        ::ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id)))
+    end
+
+    def write_card(card, attachments)
+      data = card.attributes.merge("description" => card.description.body&.to_html.to_s,
+        "board" => card.board.name, "creator" => card.creator.name)
+      @zip.add_file("cards/#{card.id}.json") do |sink|
+        sink.write(data.to_json.delete_suffix("}"))
+        sink.write(',"comments":[')
+        first = true
+        card.comments.find_each(cursor: [ :created_at, :id ], order: [ :asc, :asc ], batch_size: 100) do |comment|
+          sink.write(",") unless first
+          sink.write(comment.attributes.merge("body" => comment.body.body&.to_html.to_s,
+            "creator" => comment.creator.name).to_json)
+          first = false
+        end
+        sink.write('],"attachments":[')
+        first = true
+        attachments.find_each do |attachment|
+          sink.write(",") unless first
+          sink.write({ id: attachment.blob_id, filename: attachment.blob.filename.to_s,
+            content_type: attachment.blob.content_type, path: "files/#{attachment.blob_id}",
+            record_type: attachment.record_type, record_id: attachment.record_id, name: attachment.name }.to_json)
+          first = false
+        end
+        sink.write("]}")
+      end
+    end
+end
diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..aeddcfb
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,62 @@
+class Account::Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+  validates :scope, inclusion: { in: %w[ account cards ] }
+  validate :user_belongs_to_account
+
+  after_create_commit :generate_later
+
+  def self.cleanup
+    where(expires_at: ...Time.current).find_each do |export|
+      export.archive.purge if export.archive.attached?
+      export.destroy!
+    end
+    failed.where(created_at: ...1.day.ago).destroy_all
+  end
+
+  def generate_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def generate_now
+    claimed = with_lock do
+      if pending?
+        update!(status: :processing)
+        true
+      end
+    end
+    if claimed
+      begin
+        Current.with_account(account) do
+          raise ArgumentError, "You no longer have access to this export" unless user.active? && (scope == "cards" || user.admin?)
+          ZipFile.create_for(archive, filename: "fizzy-#{scope}-#{id}.zip") do |zip|
+            Account::DataTransfer::Writer.new(self, zip).write
+          end
+        end
+        update!(status: :completed, expires_at: 1.day.from_now)
+      rescue => error
+        archive.purge if archive.attached?
+        update!(status: :failed)
+        Rails.logger.error("#{self.class.name} failed: #{error.class}: #{error.message}")
+        Rails.error.report(error)
+      end
+      Account::DataTransferMailer.export_completed(self).deliver_later if completed?
+    end
+  end
+
+  def download_token
+    signed_id(purpose: :export_download, expires_at: expires_at)
+  end
+
+  def available?
+    completed? && archive.attached? && expires_at&.future?
+  end
+
+  private
+    def user_belongs_to_account
+      errors.add(:user, "must belong to the account") if user && user.account_id != account_id
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..4743ffc
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,63 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :archive
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+  validate :archive_present, on: :create
+  after_create_commit :process_later
+
+  def process_later
+    Current.without_account { Account::ImportJob.perform_later(self) }
+  end
+
+  def process_now
+    claimed = with_lock do
+      if pending?
+        update!(status: :processing)
+        true
+      end
+    end
+    if claimed
+      begin
+        ZipFile.open(archive) do |zip|
+          Account::DataTransfer::Reader.new(self, zip).restore
+        end
+      rescue => error
+        update!(account: nil, status: :failed, error_message: failure_reason(error))
+        Rails.logger.error("#{self.class.name} failed: #{error.class}: #{error.message}")
+        Rails.error.report(error)
+      ensure
+        if archive.attached?
+          if archive.blob.attachments.count == 1
+            archive.purge
+          else
+            # Remove this input without deleting a file used by another record
+            # or an import that has not finished reading it.
+            archive.detach
+          end
+        end
+      end
+      Current.without_account { Account::DataTransferMailer.import_completed(self).deliver_later }
+    end
+  end
+
+  private
+    def archive_present
+      errors.add(:archive, "must be provided") unless archive.attached?
+    end
+
+    def failure_reason(error)
+      if error.is_a?(ActiveRecord::RecordInvalid)
+        "The archive contains an invalid record: #{error.record.errors.full_messages.to_sentence.truncate(500)}"
+      elsif error.is_a?(ZipKit::FileReader::MissingEOCD)
+        "This file is not a valid ZIP archive. Please upload a full account export from Fizzy."
+      elsif error.is_a?(Zlib::Error)
+        "A file in the ZIP archive is corrupt. Please export the account again and try that file."
+      elsif error.is_a?(ArgumentError) || error.is_a?(JSON::ParserError) || error.is_a?(KeyError)
+        "The archive could not be imported: #{error.message.truncate(500)}"
+      else
+        "The archive is damaged, incomplete, or could not be read. Please check the file and try again."
+      end
+    end
+end
diff --git a/app/models/account/import/upload.rb b/app/models/account/import/upload.rb
new file mode 100644
index 0000000..5d11826
--- /dev/null
+++ b/app/models/account/import/upload.rb
@@ -0,0 +1,114 @@
+# Identity-owned temporary uploads let people import without an account. S3
+# multipart uploads support ZIPs larger than the single-PUT limit of 5 GB.
+class Account::Import::Upload
+  PART_SIZE = 100.megabytes
+  MAX_PARTS = 10_000
+  MAX_SIZE = 5.terabytes
+  LIFETIME = 2.days
+
+  attr_reader :blob
+
+  def self.create(identity:, attributes:, multipart: false)
+    size = Integer(attributes.fetch(:byte_size))
+    raise ArgumentError, "The ZIP must be between 1 byte and 5 TB" unless size.between?(1, MAX_SIZE)
+    metadata = { "import_identity_id" => identity.id }
+    metadata["composed"] = true if multipart
+    Current.without_account do
+      # Use the model constructor so protected metadata (composed) is retained.
+      blob = ActiveStorage::Blob.create!(**attributes,
+        account: nil, content_type: "application/zip", checksum: multipart ? "pending" : attributes.fetch(:checksum), metadata: metadata)
+      new(blob).tap { |upload| upload.start if multipart }
+    end
+  end
+
+  def self.find(token, identity:)
+    blob = ActiveStorage::Blob.find_signed(token, purpose: :import_upload)
+    if blob && blob.metadata["import_identity_id"] == identity.id
+      new(blob)
+    else
+      raise ActiveRecord::RecordNotFound
+    end
+  end
+
+  def self.multipart_supported?
+    defined?(ActiveStorage::Service::S3Service) && ActiveStorage::Blob.service.is_a?(ActiveStorage::Service::S3Service)
+  end
+
+  def self.cleanup
+    ActiveStorage::Blob.unattached.where(account_id: nil).where(created_at: ...LIFETIME.ago).find_each do |blob|
+      new(blob).abort if blob.metadata["import_identity_id"]
+    end
+  end
+
+  def initialize(blob)
+    @blob = blob
+  end
+
+  def start
+    response = client.create_multipart_upload(bucket: bucket, key: blob.key, content_type: blob.content_type, **blob.service.upload_options)
+    @multipart_upload_id = response.upload_id
+    Current.without_account do
+      blob.update!(metadata: blob.metadata.merge("multipart_upload_id" => response.upload_id))
+    end
+  rescue
+    abort
+    raise
+  end
+
+  def token
+    blob.signed_id(purpose: :import_upload, expires_in: LIFETIME)
+  end
+
+  def part_size
+    [ PART_SIZE, (blob.byte_size.to_f / MAX_PARTS).ceil ].max
+  end
+
+  def part_count
+    (blob.byte_size.to_f / part_size).ceil
+  end
+
+  def part_url(number)
+    raise ArgumentError, "Invalid upload part" unless number.between?(1, part_count)
+    Aws::S3::Presigner.new(client: client).presigned_url(:upload_part,
+      bucket: bucket, key: blob.key, upload_id: blob.metadata.fetch("multipart_upload_id"),
+      part_number: number, expires_in: LIFETIME.to_i)
+  end
+
+  def complete(parts)
+    unless parts.map { |part| part.fetch(:part_number).to_i } == (1..part_count).to_a && parts.all? { |part| part[:etag].present? }
+      raise ArgumentError, "The upload is missing parts"
+    end
+    client.complete_multipart_upload(bucket: bucket, key: blob.key,
+      upload_id: blob.metadata.fetch("multipart_upload_id"), multipart_upload: { parts: parts })
+    unless client.head_object(bucket: bucket, key: blob.key).content_length == blob.byte_size
+      raise ArgumentError, "The uploaded file has the wrong size"
+    end
+    Current.without_account do
+      blob.update!(metadata: blob.metadata.except("multipart_upload_id").merge("upload_complete" => true))
+    end
+    @multipart_upload_id = nil
+  rescue
+    abort
+    raise
+  end
+
+  def abort
+    if id = blob.metadata["multipart_upload_id"] || @multipart_upload_id
+      begin
+        client.abort_multipart_upload(bucket: bucket, key: blob.key, upload_id: id)
+      rescue Aws::S3::Errors::NoSuchUpload
+        # Already completed or aborted; still remove the temporary object.
+      end
+    end
+    blob.purge
+  end
+
+  private
+    def client
+      blob.service.client.client
+    end
+
+    def bucket
+      blob.service.bucket.name
+    end
+end
