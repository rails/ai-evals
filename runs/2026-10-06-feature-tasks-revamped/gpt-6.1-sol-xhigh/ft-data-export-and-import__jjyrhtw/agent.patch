+          assert_redirected_to new_account_import_path
+        end
+      end
+      assert_equal identity, Account::Import.last.identity
+    end
+  end
+
+  test "imports require authentication" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+      assert_no_difference "Account::Import.count" do
+        post account_imports_path
+        assert_response :redirect
+      end
+    end
+  end
+
+  test "missing archive is rejected" do
+    sign_in_as :david
+    untenanted do
+      assert_no_difference "Account::Import.count" do
+        post account_imports_path, params: { account_import: { archive: "" } }
+        assert_response :unprocessable_entity
+      end
+    end
+  end
+
+  test "import direct uploads are authenticated and need no account" do
+    sign_in_as :david
+    untenanted do
+      post account_imports_uploads_path, params: { blob: {
+        filename: "account.zip", content_type: "application/zip", byte_size: 9, checksum: Base64.strict_encode64(Digest::MD5.digest("not a zip"))
+      } }, as: :json
+      assert_response :success
+      assert response.parsed_body["signed_id"].present?
+      assert_nil ActiveStorage::Blob.last.account_id
