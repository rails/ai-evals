+module Account::DataTransfer::RichText
+  def self.export(body)
+    fragment = Nokogiri::HTML.fragment(body.to_s)
+    fragment.css("action-text-attachment[sgid]").each do |node|
+      if attachable = GlobalID::Locator.locate_signed(node["sgid"], for: "attachable")
+        node["data-transfer-id"] = attachable.id
+        node["data-transfer-type"] = attachable.class.name
+        node.remove_attribute("sgid")
+        node.remove_attribute("url")
+      else
+        raise ArgumentError, "A rich text attachment could not be exported"
+      end
+    end
+    fragment.to_html
+  end
+end
