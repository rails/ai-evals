@@ -0,0 +1,78 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class ZipFile::S3Test < ActiveSupport::TestCase
+  class MemoryS3Service < ActiveStorage::Service::S3Service
+    attr_reader :objects
+
+    def initialize
+      @objects = {}
+      @default_digest_type = :md5
+      @default_digest_class = OpenSSL::Digest::MD5
+      self.name = "memory_s3"
+    end
+
+    def upload_stream(key:, **options)
+      io = StringIO.new
+      yield io
+      @objects[key] = io.string
+    end
+
+    def upload(key, io, **options)
+      @objects[key] = io.read
+    end
+
+    def update_metadata(key, **options)
+    end
+
+    def download(key)
+      @objects.fetch(key).bytes.each_slice(1024) { |bytes| yield bytes.pack("C*") }
+    end
+
+    def download_chunk(key, range)
+      @objects.fetch(key)[range]
+    end
+
+    def delete(key)
+      @objects.delete(key)
+    end
+
+    def exist?(key)
+      @objects.key?(key)
+    end
+  end
+
+  setup do
+    @original_service = ActiveStorage::Blob.service
+    @service = MemoryS3Service.new
+    ActiveStorage::Blob.services.stubs(:fetch).with("memory_s3").returns(@service)
+    ActiveStorage::Blob.service = @service
+  end
+
+  teardown do
+    ActiveStorage::Blob.service = @original_service
+  end
+
+  test "export streams to S3 with correct storage metadata" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    blob = export.file.blob
+    assert_equal "memory_s3", blob.service_name
+    bytes = @service.objects.fetch(blob.key)
+    assert_equal bytes.bytesize, blob.byte_size
+    assert_equal Base64.strict_encode64(Digest::MD5.digest(bytes)), blob.checksum
+    assert_equal "account", JSON.parse(ZipFile::Reader.new(blob).read("metadata.json"))["kind"]
+  end
+
+  test "import reads S3 ranges and uploads files without a full archive tempfile" do
+    cards(:logo).image.attach(io: StringIO.new("image bytes"), filename: "image.png", content_type: "image/png")
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    import.process
+    assert import.reload.completed?, import.error
+    restored = import.account.cards.find_by!(number: cards(:logo).number).image.blob
+    assert_equal "image bytes", @service.objects.fetch(restored.key)
+    assert_equal "memory_s3", restored.service_name
+  end
+end
