diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..f450ad9
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,63 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[account cards].index_by(&:itself), prefix: true
+  enum :status, %w[pending completed failed].index_by(&:itself)
+
+  validates :kind, presence: true
+  validate :user_belongs_to_account
+
+  after_create_commit :process_later
+
+  def process_later
+    ExportJob.perform_later(self)
+  end
+
+  def process
+    archive_blob = nil
+    with_lock do
+      if pending?
+        Current.with_account(account) do
+          raise ActiveRecord::RecordInvalid, self unless user.active? && (!kind_account? || user.admin?)
+          archive_blob = ZipFile.create_for(file, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            if kind_account?
+              counts = {}
+              Account::DataTransfer::Manifest.new(account).each_record_set do |set|
+                counts[set.directory] = set.export(zip)
+              end
+              zip.add_file("metadata.json", { format: 1, kind: "account", record_sets: counts }.to_json)
+            else
+              Account::DataTransfer::Cards.new(user).export(zip)
+            end
+          end
+          update!(status: :completed, completed_at: Time.current)
+          DataTransferMailer.export_ready(self).deliver_later
+        end
+      end
+    end
+  rescue
+    archive_blob&.service&.delete(archive_blob.key)
+    file.purge if file.attached?
+    update!(status: :failed)
+    raise
+  end
+
+  def expires_at
+    completed_at + 1.day
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  def accessible_to?(user)
+    completed? && expires_at.future? && self.user == user
+  end
+
+  private
+    def user_belongs_to_account
+      errors.add(:user, "must belong to this account") if user && user.account_id != account_id
+    end
+end
