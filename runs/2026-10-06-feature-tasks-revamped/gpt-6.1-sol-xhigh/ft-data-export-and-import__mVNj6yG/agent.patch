--- /dev/null
+++ b/app/models/account/data_transfer/cards.rb
@@ -0,0 +1,20 @@
+class Account::DataTransfer::Cards
+  def initialize(user)
+    @user = user
+  end
+
+  def export(zip)
+    cards = @user.accessible_cards.where(account: @user.account).distinct
+    count = Account::DataTransfer::CardRecordSet.new(@user.account, cards: cards).export(zip)
+    rich_texts = ::ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id))
+      .or(::ActionText::RichText.where(record_type: "Comment", record_id: @user.accessible_comments.select(:id)))
+    attachments = ::ActiveStorage::Attachment.where(record_type: "Card", record_id: cards.select(:id))
+      .or(::ActiveStorage::Attachment.where(record_type: "Comment", record_id: @user.accessible_comments.select(:id)))
+      .or(::ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id)))
+
+    ::ActiveStorage::Blob.where(id: attachments.select(:blob_id)).find_each do |blob|
+      zip.add_file("files/#{blob.id}", compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+    end
+    zip.add_file("metadata.json", { format: 1, kind: "cards", cards: count }.to_json)
+  end
+end
