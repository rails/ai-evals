+++ b/test/models/zip_file/reader_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  test "reads compressed and stored entries through storage range reads" do
+    blob = archive do |zip|
+      zip.add_file("compressed.json", "{\"hello\":\"world\"}")
+      zip.add_file("stored.txt", "file bytes", compress: false)
+    end
+    reader = ZipFile::Reader.new(blob)
+    assert_equal '{"hello":"world"}', reader.read("compressed.json")
+    assert_equal "file bytes", reader.read("stored.txt")
+    assert_raises(ZipFile::Reader::InvalidArchive) { reader.read("missing.txt") }
+  end
+
+  test "rejects unsafe paths" do
+    blob = archive { |zip| zip.add_file("../outside.txt", "bad") }
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(blob) }
+  end
+
+  test "rejects damaged entry content even when the ZIP directory is intact" do
+    blob = archive { |zip| zip.add_file("stored.txt", "original bytes", compress: false) }
+    bytes = blob.download.sub("original bytes", "tampered bytes")
+    damaged = ActiveStorage::Blob.create_and_upload!(io: StringIO.new(bytes), filename: "damaged.zip")
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(damaged).read("stored.txt") }
+  end
+
+  test "rejects excessive JSON sizes before expanding them" do
+    blob = archive { |zip| zip.add_file("large.json", "x" * 1024) }
+    reader = ZipFile::Reader.new(blob)
+    entries = reader.instance_variable_get(:@entries)
+    entries.fetch("large.json").uncompressed_size = ZipFile::Reader::JSON_LIMIT + 1
+    assert_raises(ZipFile::Reader::InvalidArchive) { reader.read("large.json") }
+  end
+
+  test "writer records the actual byte size and checksum" do
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("test.txt", "some bytes")
+    writer.close
+    assert_equal io.string.bytesize, writer.byte_size
+    assert_equal Base64.strict_encode64(Digest::MD5.digest(io.string)), writer.checksum
+  end
+
+  private
+    def archive
+      io = StringIO.new
+      writer = ZipFile::Writer.new(io)
+      yield writer
+      writer.close
+      io.rewind
+      ActiveStorage::Blob.create_and_upload!(io: io, filename: "test.zip", content_type: "application/zip")
+    end
+end
diff --git a/test/models/zip_file/s3_test.rb b/test/models/zip_file/s3_test.rb
