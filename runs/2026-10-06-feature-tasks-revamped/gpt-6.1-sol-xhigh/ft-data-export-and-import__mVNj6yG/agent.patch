diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..2ee20c0
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,130 @@
+class ZipFile::Reader
+  InvalidArchive = Class.new(StandardError)
+  JSON_LIMIT = 16.megabytes
+  DIRECTORY_LIMIT = 128.megabytes
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(blob)
+    @io = BlobIO.new(blob)
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io, read_local_headers: false).index_by do |entry|
+      validate_entry(entry)
+      entry.filename
+    end
+    raise InvalidArchive, "Duplicate archive entries" if @entries.size != @entry_count
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature => error
+    raise InvalidArchive, "Invalid ZIP file: #{error.message}"
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path, File::FNM_PATHNAME) }.sort
+  end
+
+  def read(path)
+    entry = entry_for(path)
+    raise InvalidArchive, "JSON record is too large: #{path}" if entry.uncompressed_size > JSON_LIMIT
+
+    content = +"".b
+    each_chunk(path) { |chunk| content << chunk }
+    content
+  end
+
+  def copy_to(blob, path)
+    digest = Digest::MD5.new
+    write = ->(sink) do
+      each_chunk(path) do |chunk|
+        digest.update(chunk)
+        sink.write(chunk)
+      end
+    end
+
+    if defined?(ActiveStorage::Service::S3Service) && blob.service.is_a?(ActiveStorage::Service::S3Service)
+      blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes, &write)
+    else
+      Tempfile.create(binmode: true) do |file|
+        write.call(file)
+        file.rewind
+        blob.service.upload(blob.key, file, checksum: blob.checksum)
+      end
+    end
+
+    unless blob.byte_size == entry_for(path).uncompressed_size && blob.checksum == Base64.strict_encode64(digest.digest)
+      raise InvalidArchive, "File checksum or size does not match: #{path}"
+    end
+  end
+
+  private
+    def validate_entry(entry)
+      @entry_count = (@entry_count || 0) + 1
+      unless entry.filename.match?(%r{\A[\w./-]+\z}) && entry.filename.split("/").none? { |part| part.in?([ "", ".", ".." ]) }
+        raise InvalidArchive, "Unsafe archive path"
+      end
+      unless entry.storage_mode.in?([ 0, 8 ]) && entry.gp_flags & 1 == 0 && entry.compressed_size >= 0 && entry.uncompressed_size >= 0
+        raise InvalidArchive, "Unsupported ZIP entry"
+      end
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise InvalidArchive, "Missing archive entry: #{path}" }
+    end
+
+    def each_chunk(path)
+      entry = entry_for(path)
+      offset = ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+      raise InvalidArchive, "Invalid file offset" unless offset >= 0 && offset + entry.compressed_size <= @io.size
+
+      @io.seek(offset)
+      remaining = entry.compressed_size
+      size = crc = 0
+      emit = ->(chunk) do
+        size += chunk.bytesize
+        raise InvalidArchive, "Invalid expanded file size: #{path}" if size > entry.uncompressed_size
+        crc = Zlib.crc32(chunk, crc)
+        yield chunk
+      end
+      inflater = Zlib::Inflate.new(-Zlib::MAX_WBITS) if entry.storage_mode == 8
+
+      while remaining > 0
+        chunk = @io.read([ remaining, CHUNK_SIZE ].min)
+        raise InvalidArchive, "Truncated ZIP entry: #{path}" if chunk.nil? || chunk.empty?
+        remaining -= chunk.bytesize
+        inflater ? inflater.inflate(chunk, &emit) : emit.call(chunk)
+      end
+
+      unless size == entry.uncompressed_size && crc == entry.crc32 && (!inflater || inflater.finished?)
+        raise InvalidArchive, "Corrupt ZIP entry: #{path}"
+      end
+    ensure
+      inflater&.close
+    end
+
+    # Uses storage range reads, so even a 500GB S3 archive need not be downloaded.
+    class BlobIO
+      attr_reader :pos
+      alias_method :tell, :pos
+
+      def initialize(blob)
+        @blob = blob
+        @pos = 0
+      end
+
+      def size
+        @blob.byte_size
+      end
+
+      def seek(offset, mode = IO::SEEK_SET)
+        raise InvalidArchive, "Invalid ZIP offset" unless mode == IO::SEEK_SET && offset.between?(0, size)
+        @pos = offset
+      end
+
+      def read(length = nil)
+        length ||= size - pos
+        raise InvalidArchive, "ZIP directory is too large" unless length.between?(0, DIRECTORY_LIMIT)
+        length = [ length, size - pos ].min
+        if length.zero?
+          "".b
+        else
+          @blob.service.download_chunk(@blob.key, pos..(pos + length - 1)).tap { |data| @pos += data.bytesize }
+        end
+      end
+    end
+end
