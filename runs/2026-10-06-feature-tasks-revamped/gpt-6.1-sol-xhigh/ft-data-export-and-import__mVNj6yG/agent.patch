--- /dev/null
+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,18 @@
+class ExportsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  skip_before_action :require_account
+  allow_unauthenticated_access
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download)
+    raise ActiveRecord::RecordNotFound unless export
+    if export.completed? && export.expires_at.future? && export.file.attached?
+      response.headers["Cache-Control"] = "no-store"
+      # The target comes from configured storage, never from a request-supplied URL.
+      redirect_to export.file.blob.url(expires_in: [ 5.minutes, export.expires_at - Time.current ].min, disposition: :attachment), allow_other_host: true
+    else
+      head :gone
+    end
+  end
+end
