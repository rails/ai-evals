--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,38 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[pending completed failed].index_by(&:itself)
+
+  validates :file, presence: true
+  after_create_commit :process_later
+
+  def process_later
+    Current.without_account { ImportJob.perform_later(self) }
+  end
+
+  def process
+    restored = false
+    restorer = nil
+    begin
+      with_lock do
+        if pending?
+          restorer = Account::DataTransfer::Restorer.new(file.blob, identity)
+          update!(account: restorer.restore, status: :completed)
+          restored = true
+        end
+      end
+    rescue StandardError => error
+      restorer&.discard_files
+      update!(status: :failed, account: nil, error: error.message.truncate(1000))
+      DataTransferMailer.import_failed(self).deliver_later
+    else
+      DataTransferMailer.import_completed(self).deliver_later if restored
+    end
+  end
+
+  def accessible_to?(user)
+    false
+  end
+end
