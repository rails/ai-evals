--- /dev/null
+++ b/test/jobs/data_transfer_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class DataTransferJobTest < ActiveJob::TestCase
+  test "export job generates an archive and emails a one day link" do
+    account = Current.account
+    perform_enqueued_jobs do
+      Export.create!(account: account, user: users(:kevin), kind: :account)
+    end
+    export = Export.last
+    assert export.completed?
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_equal "Your Fizzy export is ready", mail.subject
+    assert_includes mail.text_part.body.decoded, export.download_token
+    assert_includes mail.text_part.body.decoded, "one day"
+  end
+
+  test "import job creates a new account and emails its URL" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    clear_enqueued_jobs
+    perform_enqueued_jobs do
+      Import.create!(identity: identities(:kevin), file: export.file.blob)
+    end
+    import = Import.last
+    assert import.completed?, import.error
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_equal "Your Fizzy import is complete", mail.subject
+    assert_includes mail.text_part.body.decoded, import.account.slug
+  end
+
+  test "failed imports email an explanation without creating an account" do
+    assert_no_difference "Account.count" do
+      perform_enqueued_jobs do
+        Import.create!(identity: identities(:kevin), file: { io: StringIO.new("broken zip"), filename: "broken.zip" })
+      end
+    end
+    import = Import.last
+    assert import.failed?
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_equal "Your Fizzy import failed", mail.subject
+    assert_includes mail.text_part.body.decoded, import.error
+  end
+end
