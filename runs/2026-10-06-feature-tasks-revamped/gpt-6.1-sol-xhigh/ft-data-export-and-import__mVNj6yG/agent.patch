@@ -0,0 +1,31 @@
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account, cards: account.cards)
+    super(account: account, model: Card)
+    @cards = cards
+  end
+
+  private
+    def records
+      @cards
+    end
+
+    def serialize(card)
+      super.merge(
+        "description" => Account::DataTransfer::RichText.export(card.description.body),
+        "attachments" => attachments_for(card),
+        "comments" => card.comments.chronologically.map do |comment|
+          serializable_attributes(comment).merge(
+            "body" => Account::DataTransfer::RichText.export(comment.body.body),
+            "attachments" => attachments_for(comment)
+          )
+        end
+      )
+    end
+
+    def attachments_for(record)
+      rich_texts = ::ActionText::RichText.where(record: record)
+      ::ActiveStorage::Attachment.where(record: [ record, *rich_texts ]).includes(:blob).map do |attachment|
+        { "filename" => attachment.blob.filename.to_s, "path" => "files/#{attachment.blob_id}" }
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/cards.rb b/app/models/account/data_transfer/cards.rb
