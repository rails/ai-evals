+class Account::Imports::UploadsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  disallow_account_scope
+  allow_unauthorized_access
+
+  def create
+    blob = ActiveStorage::Blob.create_before_direct_upload!(**blob_params,
+      metadata: { import_identity_id: Current.identity.id })
+    render json: blob.as_json(root: false, methods: :signed_id).merge(direct_upload: {
+      url: blob.service_url_for_direct_upload,
+      headers: blob.service_headers_for_direct_upload
+    })
+  end
+
+  private
+    def blob_params
+      params.expect(blob: %i[ filename byte_size checksum content_type ]).to_h.symbolize_keys
+    end
+end
