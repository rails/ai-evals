--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "account export can be restored into a new account" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    assert_difference "Account.count", 1 do
+      import.process
+      assert import.reload.completed?, import.error
+    end
+
+    assert import.reload.completed?, import.error
+    assert_equal export.account.name, import.account.name
+    assert_equal export.account.boards.count, import.account.boards.count
+    assert_equal export.account.cards.count, import.account.cards.count
+    assert_equal export.account.users.count, import.account.users.count
+    assert import.account.users.find_by!(identity: identities(:kevin)).owner?
+  end
+
+  test "invalid imports leave no account or people behind" do
+    import = Import.create!(identity: identities(:kevin), file: { io: StringIO.new("not a zip"), filename: "invalid.zip" })
+
+    assert_no_difference [ "Account.count", "User.count", "Identity.count", "Card.count" ] do
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert import.error.present?
+    assert_nil import.account
+  end
+  test "restores comments, images, rich text files, mentions, and storage totals" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture bytes"), filename: "picture.png", content_type: "image/png")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document bytes"), filename: "report.pdf", content_type: "application/pdf")
+    card.update!(description: ActionText::Content.new("<p>Details</p>").append_attachables([ blob, users(:david) ]))
+    comment = card.comments.create!(creator: users(:kevin), body: ActionText::Content.new("<p>A comment</p>").append_attachables(blob))
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    import.process
+    assert import.reload.completed?, import.error
+    restored = import.account.cards.find_by!(number: card.number)
+    assert_equal "picture bytes", restored.image.download
+    assert_not_equal card.image.blob.key, restored.image.blob.key
+    assert_equal "report.pdf", restored.description.embeds.first.filename.to_s
+    assert_equal "document bytes", restored.description.embeds.first.download
+    assert_equal import.account.id, restored.description.embeds.first.account_id
+    assert_equal import.account.users.find_by!(name: "David"), restored.description.body.attachables.find { |record| record.is_a?(User) }
+    restored_comment = restored.comments.find_by!(created_at: comment.created_at)
+    assert_equal "document bytes", restored_comment.body.embeds.first.download
+    assert_equal card.description.embeds.first.id == comment.body.embeds.first.id, restored.description.embeds.first.id == restored_comment.body.embeds.first.id
+    assert_equal card.board.send(:calculate_real_storage_bytes), restored.board.bytes_used_exact
+    assert_equal import.account.boards.sum(&:bytes_used_exact), import.account.bytes_used_exact
+  end
+
+  test "card exports contain only visible cards, their comments, and their files" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("public bytes"), filename: "public.png", content_type: "image/png")
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: :published) }
+    private_card.image.attach(io: StringIO.new("private bytes"), filename: "private.png", content_type: "image/png")
+    export = Export.create!(account: Current.account, user: users(:david), kind: :cards)
+    export.process
+
+    zip = ZipFile::Reader.new(export.file.blob)
+    assert_equal users(:david).accessible_cards.ids.sort, zip.glob("cards/*.json").map { |path| File.basename(path, ".json") }.sort
+    assert_not_includes zip.glob("cards/*.json"), "cards/#{private_card.id}.json"
+    record = JSON.parse(zip.read("cards/#{card.id}.json"))
+    assert_equal card.comments.count, record["comments"].size
+    assert_equal "public bytes", zip.read("files/#{card.image.blob.id}")
+    assert_not_includes zip.glob("files/*"), "files/#{private_card.image.blob.id}"
+    assert_empty zip.glob("users/*.json")
+  end
+
+  test "card exports cannot be imported as accounts" do
+    export = Export.create!(account: Current.account, user: users(:david), kind: :cards)
+    export.process
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    assert_no_difference "Account.count" do
+      import.process
+    end
+    assert import.reload.failed?
+    assert_match /account export/, import.error
+  end
+
+  test "failure after a file upload rolls back records and removes restored files" do
+    cards(:logo).image.attach(io: StringIO.new("picture bytes"), filename: "picture.png", content_type: "image/png")
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    uploaded = []
+    original_copy = ZipFile::Reader.instance_method(:copy_to)
+    ZipFile::Reader.any_instance.stubs(:copy_to).with do |blob, path|
+      uploaded << blob
+      original_copy.bind_call(ZipFile::Reader.new(export.file.blob), blob, path)
+      true
+    end.returns(nil)
+    Account::DataTransfer::Restorer.any_instance.stubs(:ensure_owner).raises(ArgumentError, "Broken account")
+
+    assert_no_difference [ "Account.count", "User.count", "Identity.count", "Card.count", "Comment.count", "ActiveStorage::Blob.count", "ActiveStorage::Attachment.count" ] do
+      import.process
+    end
+    assert import.reload.failed?
+    assert_match /Broken account/, import.error
+    assert uploaded.any?
+    uploaded.each { |blob| assert_not blob.service.exist?(blob.key) }
+    assert_equal "picture bytes", cards(:logo).image.download
+  end
+
+  test "an importer not in the archive becomes owner without replacing archived people" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    import = Import.create!(identity: identities(:mike), file: export.file.blob)
+    import.process
+    assert import.reload.completed?, import.error
+    assert_equal export.account.users.count + 1, import.account.users.count
+    assert import.account.users.find_by!(identity: identities(:mike)).owner?
+    assert_equal import.account.boards.count, import.account.users.find_by!(identity: identities(:mike)).boards.count
+  end
+  test "restores published boards and saved filter relationships with new identifiers" do
+    boards(:writebook).publish
+    original_key = boards(:writebook).publication.key
+    filter = with_current_user(:david) do
+      Filter.create!(creator: users(:david), boards: [ boards(:writebook) ], assignees: [ users(:kevin) ], card_ids: [ cards(:logo).id ], column_ids: [ cards(:logo).column_id ])
+    end
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    import.process
+    assert import.reload.completed?, import.error
+    board = import.account.boards.find_by!(name: boards(:writebook).name)
+    assert board.published?
+    assert_not_equal original_key, board.publication.key
+    restored = Filter.where(account: import.account, creator: import.account.users.find_by!(name: "David")).find { |record| Array(record.card_ids).any? }
+    assert_equal [ board.id ], restored.boards.ids
+    assert_equal [ import.account.users.find_by!(name: "Kevin").id ], restored.assignee_ids
+    assert_equal [ import.account.cards.find_by!(number: cards(:logo).number).id ], restored.card_ids
+    assert_equal [ board.columns.find_by!(name: cards(:logo).column.name).id ], restored.column_ids
+    assert_equal Filter.digest_params(restored.as_params), restored.params_digest
+    assert_equal [ cards(:logo).id ], filter.card_ids
+  end
+
+  test "duplicate job execution creates neither duplicate accounts nor duplicate emails" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.process
+    clear_enqueued_jobs
+    assert_no_enqueued_jobs { export.process }
+    import = Import.create!(identity: identities(:kevin), file: export.file.blob)
+    import.process
+    clear_enqueued_jobs
+    assert_no_difference "Account.count" do
+      assert_no_enqueued_jobs { import.process }
+    end
+  end
+
+  test "export rechecks admin permissions when the queued work starts" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    users(:kevin).update!(role: :member)
+    assert_raises(ActiveRecord::RecordInvalid) { export.process }
+    assert export.reload.failed?
+    assert_not export.file.attached?
+  end
+end
