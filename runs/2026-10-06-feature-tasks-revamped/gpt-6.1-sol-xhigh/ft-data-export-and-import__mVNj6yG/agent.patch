diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..93e6d5c
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "sign in is required" do
+    untenanted { get new_account_import_path }
+    assert_response :redirect
+  end
+
+  test "a signed in identity without an account can open the import form" do
+    user = users(:david)
+    identity = user.identity
+    user.deactivate
+    sign_in_as identity
+    untenanted { get new_account_import_path }
+    assert_response :success
+    assert_select "input[type=file][data-direct-upload-url]"
+  end
+
+  test "uploading an archive queues an import for the current identity" do
+    sign_in_as :david
+    assert_enqueued_with(job: ImportJob) do
+      untenanted do
+        post account_imports_path, params: { import: { file: fixture_file_upload("moon.jpg", "application/zip") } }
+        assert_redirected_to new_account_import_path
+      end
+    end
+    assert_equal identities(:david), Import.last.identity
+    assert_nil Import.last.account
+  end
+
+  test "missing file renders an error" do
+    sign_in_as :david
+    untenanted do
+      post account_imports_path, params: { import: { file: "" } }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "direct uploads are global and owned by the importing identity" do
+    sign_in_as :david
+    untenanted do
+      post account_imports_uploads_path, params: { blob: { filename: "account.zip", byte_size: 100, checksum: "checksum", content_type: "application/zip" } }, as: :json
+      assert_response :success
+      blob = ActiveStorage::Blob.find_signed!(response.parsed_body["signed_id"])
+      assert_nil blob.account_id
+      assert_equal identities(:david).id, blob.metadata["import_identity_id"]
+      blob.service.upload(blob.key, StringIO.new("zip bytes"))
+      post account_imports_path, params: { import: { file: blob.signed_id } }
+      assert_response :redirect
+    end
+  end
+
+  test "cannot claim another identity's direct upload" do
+    blob = Current.without_account { ActiveStorage::Blob.create_before_direct_upload!(filename: "account.zip", byte_size: 100, checksum: "checksum", metadata: { import_identity_id: identities(:kevin).id }) }
+    sign_in_as :david
+    untenanted do
+      assert_no_difference "Import.count" do
+        post account_imports_path, params: { import: { file: blob.signed_id } }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+test "an unfinished direct upload renders a helpful error" do
+  sign_in_as :david
+  blob = Current.without_account do
+    ActiveStorage::Blob.create_before_direct_upload!(filename: "account.zip", byte_size: 100, checksum: "checksum", metadata: { import_identity_id: identities(:david).id })
+  end
+  untenanted do
+    post account_imports_path, params: { import: { file: blob.signed_id } }
+    assert_response :unprocessable_entity
+    assert_in_body "was not uploaded"
+  end
+end
+end
