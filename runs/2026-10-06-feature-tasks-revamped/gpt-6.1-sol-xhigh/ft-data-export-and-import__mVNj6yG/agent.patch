@@ -0,0 +1,36 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  allow_unauthorized_access
+
+  layout "public"
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Import.new(identity: Current.identity)
+    @import.file = import_file
+    if @import.save
+      redirect_to new_account_import_path(script_name: nil), notice: "We'll email you when your import is complete."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  rescue ActiveStorage::FileNotFoundError
+    @import.errors.add(:file, "was not uploaded. Please try again")
+    render :new, status: :unprocessable_entity
+  end
+
+  private
+    def import_file
+      file = params.expect(import: [ :file ])[:file]
+      if file.is_a?(String)
+        blob = ActiveStorage::Blob.find_signed(file)
+        if blob && blob.account_id.nil? && blob.metadata["import_identity_id"] == Current.identity.id
+          blob
+        end
+      else
+        file
+      end
+    end
+end
diff --git a/app/controllers/exports_controller.rb b/app/controllers/exports_controller.rb
