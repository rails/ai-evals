diff --git a/app/models/account/data_transfer/restorer.rb b/app/models/account/data_transfer/restorer.rb
new file mode 100644
index 0000000..5479066
--- /dev/null
+++ b/app/models/account/data_transfer/restorer.rb
@@ -0,0 +1,236 @@
+class Account::DataTransfer::Restorer
+  InvalidArchive = ZipFile::Reader::InvalidArchive
+
+  def initialize(file, identity)
+    @zip = ZipFile::Reader.new(file)
+    @identity = identity
+    @ids = {}
+    @uploaded_blobs = []
+    @record_sets = []
+    Account::DataTransfer::Manifest.new(Account.new).each_record_set { |set| @record_sets << set }
+  end
+
+  def restore
+    validate_manifest
+    Account.transaction do
+      restore_account
+      Current.with_account(@account) do
+        map_ids
+        @record_sets.each { |set| restore_records(set) }
+        restore_filter_resources
+        restore_files
+        ensure_owner
+        rebuild_indexes
+      end
+      @account
+    end
+  rescue
+    discard_files
+    raise
+  end
+
+  def discard_files
+    @uploaded_blobs.each do |blob|
+      blob.service.delete(blob.key)
+    rescue StandardError => error
+      Rails.error.report(error, handled: true)
+    end
+  end
+
+  private
+    def validate_manifest
+      metadata = read_json("metadata.json")
+      unless metadata["format"] == 1 && metadata["kind"] == "account" && metadata["record_sets"].is_a?(Hash)
+        raise InvalidArchive, "Please choose a Fizzy account export, not a cards export"
+      end
+
+      @record_sets.each do |set|
+        paths = paths_for(set)
+        unless metadata["record_sets"][set.directory] == paths.size
+          raise InvalidArchive, "Missing or incomplete record set: #{set.directory}"
+        end
+      end
+      raise InvalidArchive, "An account export must contain exactly one account" unless @zip.glob("accounts/*.json").one?
+    end
+
+    def restore_account
+      source = read_json(@zip.glob("accounts/*.json").first)
+      @source_account_id = source.fetch("id")
+      @account = Account.create!(name: source.fetch("name"), cards_count: source.fetch("cards_count"))
+      @account.entropies.delete_all
+      @account.reload
+      @ids[[ "Account", @source_account_id ]] = @account.id
+    end
+
+    def map_ids
+      @record_sets.each do |set|
+        unless set.model == Account || auxiliary?(set)
+          paths_for(set).each do |path|
+            id = File.basename(path, ".json")
+            raise InvalidArchive, "Invalid record ID" unless id.match?(/\A[0-9a-z]{25}\z/)
+            @ids[[ set.model.name, id ]] = ActiveRecord::Type::Uuid.generate
+          end
+        end
+      end
+    end
+
+    def paths_for(set)
+      @zip.glob(set.directory == "files" ? "files/*" : "#{set.directory}/*.json")
+    end
+
+    def auxiliary?(set)
+      set.directory.in?(%w[files filter_resources])
+    end
+
+    def restore_records(set)
+      unless set.model == Account || auxiliary?(set)
+        paths_for(set).each do |path|
+          source = read_json(path)
+          unless source["account_id"] == @source_account_id && source["id"] == File.basename(path, ".json")
+            raise InvalidArchive, "Record does not belong to the exported account: #{path}"
+          end
+          attributes = source.slice(*set.model.column_names)
+          attributes["id"] = mapped_id(set.model.name, source.fetch("id"))
+          remap_references(set.model, attributes)
+          prepare_attributes(set.model, attributes, source)
+          set.model.insert_all!([ attributes ])
+        end
+      end
+    end
+
+    def remap_references(model, attributes)
+      model.reflect_on_all_associations(:belongs_to).each do |reflection|
+        foreign_key = reflection.foreign_key.to_s
+        if attributes[foreign_key].present? && !(model == User && foreign_key == "identity_id")
+          type = reflection.polymorphic? ? attributes.fetch(reflection.foreign_type) : reflection.klass.name
+          attributes[foreign_key] = mapped_id(type, attributes[foreign_key])
+        end
+      end
+    end
+
+    def mapped_id(type, id)
+      @ids.fetch([ type, id ]) { raise InvalidArchive, "Missing reference to #{type} #{id}" }
+    end
+
+    def prepare_attributes(model, attributes, source)
+      case model.name
+      when "Board::Publication"
+        attributes["key"] = SecureRandom.base58(24)
+      when "Filter"
+        remap_array(attributes["fields"], "card_ids", "Card")
+        remap_array(attributes["fields"], "column_ids", "Column")
+      when "Event"
+        remap_array(attributes["particulars"], "assignee_ids", "User")
+      when "User"
+        restore_user(attributes, source)
+      when "ActiveStorage::Blob"
+        attributes["key"] = ActiveStorage::Blob.generate_unique_secure_token
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+      when "ActiveStorage::Attachment"
+        validate_attachment(attributes)
+      when "ActionText::RichText"
+        attributes["body"] = restore_rich_text(source["body"])
+      end
+    end
+
+    def remap_array(attributes, key, type)
+      if attributes && attributes[key]
+        attributes[key] = attributes[key].map { |id| mapped_id(type, id) }
+      end
+    end
+
+    def restore_user(attributes, source)
+      raise InvalidArchive, "Invalid user" unless attributes["name"].present? && attributes["role"].in?(User.roles.keys)
+      email = source["email_address"]
+      if attributes["active"] && attributes["role"] != "system" && email.blank?
+        raise InvalidArchive, "An active person is missing their email address"
+      end
+      identity = Identity.find_or_create_by!(email_address: email) if email.present?
+      attributes["identity_id"] = identity&.id
+      attributes["role"] = "admin" if attributes["role"] == "owner"
+      if identity == @identity
+        attributes["role"] = "owner"
+        attributes["active"] = true
+      end
+    end
+
+    def validate_attachment(attributes)
+      # Never let an archive attach to a global identity or transfer record.
+      model = @record_sets.map(&:model).find { |model| model.name == attributes["record_type"] }
+      reflection = model&.reflect_on_attachment(attributes["name"])
+      raise InvalidArchive, "Unknown attachment" unless reflection
+    end
+
+    def restore_rich_text(body)
+      fragment = Nokogiri::HTML.fragment(body.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        if node["data-transfer-id"]
+          type = node["data-transfer-type"]
+          raise InvalidArchive, "Unknown rich text attachment" unless type.in?(%w[ActiveStorage::Blob User])
+          model = type == "User" ? User : ::ActiveStorage::Blob
+          attachable = model.find(mapped_id(type, node["data-transfer-id"]))
+          node["sgid"] = attachable.attachable_sgid
+          if type == "ActiveStorage::Blob"
+            node["url"] = Rails.application.routes.url_helpers.rails_blob_path(attachable, only_path: true, script_name: @account.slug)
+          end
+          node.remove_attribute("data-transfer-id")
+          node.remove_attribute("data-transfer-type")
+        elsif node["sgid"]
+          raise InvalidArchive, "Nonportable rich text attachment"
+        end
+      end
+      fragment.to_html
+    end
+
+    def restore_filter_resources
+      @zip.glob("filter_resources/*.json").each do |path|
+        source = read_json(path)
+        filter = Filter.find(mapped_id("Filter", source.fetch("id")))
+        Account::DataTransfer::FilterResourcesRecordSet::RESOURCES.each do |name|
+          reflection = Filter.reflect_on_association(name)
+          ids = source.fetch(name).map { |id| mapped_id(reflection.klass.name, id) }
+          filter.public_send("#{name.singularize}_ids=", ids)
+        end
+        filter.reload.save!
+      end
+    end
+
+    def restore_files
+      @source_blob_ids = @ids.filter_map { |(type, id), new_id| [ new_id, id ] if type == "ActiveStorage::Blob" }.to_h
+      ::ActiveStorage::Blob.where(account: @account).find_each do |blob|
+        source_id = @source_blob_ids.fetch(blob.id)
+        @uploaded_blobs << blob
+        @zip.copy_to(blob, "files/#{source_id}")
+      end
+    end
+
+    def ensure_owner
+      owner = @account.users.find_by(identity: @identity)
+      owner ||= @account.users.create!(identity: @identity, role: :owner, name: @identity.email_address, verified_at: Time.current)
+      owner.update!(role: :owner, active: true)
+      @account.boards.find_each { |board| board.accesses.grant_to([ owner ]) }
+      raise InvalidArchive, "Missing system user" unless @account.users.where(role: :system).one?
+      raise InvalidArchive, "Missing account settings" unless @account.entropy
+      @account.update!(cards_count: [ @account.cards.maximum(:number).to_i, @account.cards_count ].max)
+    end
+
+    def rebuild_indexes
+      @account.cards.find_each(&:reindex)
+      Comment.where(account: @account).find_each(&:reindex)
+      # Restored attachments bypass callbacks to avoid notifications and webhooks.
+      # Reconcile totals from their original upload sizes instead.
+      @account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+      @account.materialize_storage
+    end
+
+    def read_json(path)
+      JSON.parse(@zip.read(path)).tap do |record|
+        raise InvalidArchive, "Invalid JSON record: #{path}" unless record.is_a?(Hash)
+      end
+    rescue JSON::ParserError
+      raise InvalidArchive, "Invalid JSON record: #{path}"
+    end
+end
