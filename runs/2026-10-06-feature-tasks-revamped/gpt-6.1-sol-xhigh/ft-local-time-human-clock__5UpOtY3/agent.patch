diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..6331fc9
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  #timer
+  #observer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.#observer?.disconnect()
+  }
+
+  styleValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const date = new Date(this.element.getAttribute("datetime") || "")
+
+    if (!Number.isNaN(date.getTime())) {
+      this.element.textContent = formatLocalTime(date, this.styleValue)
+      this.element.title = date.toLocaleString("en-US", { dateStyle: "full", timeStyle: "short" })
+    }
+  }
+}
