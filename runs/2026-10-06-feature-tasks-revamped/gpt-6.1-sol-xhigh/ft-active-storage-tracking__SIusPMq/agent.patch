diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..16830ad
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,64 @@
+class Storage::Entry < ApplicationRecord
+  class << self
+    def reconcile(attachment_id, account_id:)
+      transaction do
+        # Insert before locking, avoiding gap locks on missing entries in MySQL.
+        entry = create_or_find_by!(attachment_id: attachment_id) { |entry| entry.account_id = account_id }
+        entry.lock!
+        entry.reconcile
+      end
+    end
+  end
+
+  def reconcile
+    attachment = ActiveStorage::Attachment.includes(:blob).find_by(id: attachment_id, account_id: account_id)
+    board, card = location_for(attachment)
+    new_byte_size = board ? attachment.blob.byte_size : 0
+
+    apply_changes(board, new_byte_size)
+
+    if board
+      update!(board_id: board.id, card_id: card&.id, byte_size: new_byte_size)
+    else
+      destroy!
+    end
+  end
+
+  private
+    def location_for(attachment)
+      case attachment&.record_type
+      when "Card"
+        if attachment.name == "image" && (card = attachment.record)
+          [ card.board, card ]
+        end
+      when "ActionText::RichText"
+        if attachment.name == "embeds" && (rich_text = attachment.record)
+          case [ rich_text.record_type, rich_text.name ]
+          when [ "Board", "public_description" ]
+            [ rich_text.record, nil ]
+          when [ "Card", "description" ]
+            if card = rich_text.record
+              [ card.board, card ]
+            end
+          when [ "Comment", "body" ]
+            if card = rich_text.record&.card
+              [ card.board, card ]
+            end
+          end
+        end
+      end
+    end
+
+    def apply_changes(board, new_byte_size)
+      delta = new_byte_size - byte_size
+      Account.where(id: account_id).update_counters(bytes_used: delta) unless delta.zero?
+
+      # Stable lock ordering also handles two cards moving in opposite directions.
+      changes = Hash.new(0)
+      changes[board_id] -= byte_size if board_id
+      changes[board.id] += new_byte_size if board
+      changes.sort.each do |id, bytes|
+        Board.where(id: id).update_counters(bytes_used: bytes) unless bytes.zero?
+      end
+    end
+end
