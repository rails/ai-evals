+require "test_helper"
+
+class Storage::ConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @account = Account.create_with_owner(account: { name: "Concurrent storage" }, owner: { name: "Owner", identity: identities(:david) })
+    Current.account = @account
+    Current.user = @account.users.find_by!(role: :owner)
+    @board = @account.boards.create!(name: "Concurrent board", creator: Current.user, all_access: true)
+    @card = @board.cards.create!(title: "Concurrent card", creator: Current.user)
+  end
+
+  teardown do
+    @account.destroy!
+  end
+
+  test "concurrent duplicate jobs do not lose or double count updates" do
+    attachments = 20.times.map do |index|
+      blob = ActiveStorage::Blob.create!(account: @account, filename: "file.txt", byte_size: index + 1, checksum: "test-checksum", content_type: "text/plain")
+      ActiveStorage::Attachment.create!(record: @card, name: "image", blob: blob)
+    end
+    clear_enqueued_jobs
+
+    threads = 4.times.map do
+      Thread.new do
+        ApplicationRecord.connection_pool.with_connection do
+          attachments.shuffle.each do |attachment|
+            Storage::ReconcileJob.perform_now(@account.id, [ attachment.id ])
+          end
+        end
+      end
+    end
+    threads.each(&:value)
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+
+    assert_equal 210, @account.bytes_used
+    assert_equal 210, @board.bytes_used
+    assert_equal 20, Storage::Entry.where(account_id: @account.id).count
+
+    attachments.each(&:destroy!)
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "usage readers bypass a stale request query cache" do
+    blob = ActiveStorage::Blob.create!(account: @account, filename: "file.txt", byte_size: 123, checksum: "test-checksum", content_type: "text/plain")
+    attachment = ActiveStorage::Attachment.create!(record: @card, name: "image", blob: blob)
+
+    Account.cache do
+      assert_equal 0, @account.bytes_used
+      assert_equal 0, @board.bytes_used
+
+      Thread.new do
+        ApplicationRecord.connection_pool.with_connection do
+          Storage::Entry.reconcile(attachment.id, account_id: @account.id)
+        end
+      end.value
+
+      assert_equal 123, @account.bytes_used
+      assert_equal 123, @board.bytes_used
+    end
+  end
+end
