@@ -0,0 +1,12 @@
+class Storage::ReconcileJob < ApplicationJob
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::RecordNotUnique, ActiveRecord::RecordNotFound, wait: :polynomially_longer, attempts: 10
+
+  def perform(account_id, attachment_ids)
+    attachment_ids.each do |attachment_id|
+      Storage::Entry.reconcile(attachment_id, account_id: account_id)
+    end
+  end
+end
