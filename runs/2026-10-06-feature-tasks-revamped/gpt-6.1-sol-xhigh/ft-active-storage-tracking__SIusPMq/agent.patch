@@ -220,6 +220,45 @@ class Account::ImportTest < ActiveSupport::TestCase
     export_tempfile&.unlink
   end
 
+  test "import rebuilds storage totals without importing cached counters" do
+    source_account = accounts("37s")
+    exporter = users(:david)
+    source_board_id = boards(:writebook).id
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) do
+      Current.with_account(source_account) do
+        cards(:logo).image.attach(io: StringIO.new("storage"), filename: "storage.txt", content_type: "text/plain")
+      end
+    end
+    assert_equal 7, source_account.bytes_used
+    assert_equal 7, boards(:writebook).bytes_used
+
+    export = Account::Export.create!(account: source_account, user: exporter)
+    export.build
+    export_tempfile = Tempfile.new([ "storage-export", ".zip" ])
+    export.file.open { |file| FileUtils.cp(file.path, export_tempfile.path) }
+    source_account.destroy!
+    ActiveStorage::Blob.where(account_id: source_account.id).delete_all
+
+    target_account = Account.create_with_owner(account: { name: "Storage import" }, owner: { identity: exporter.identity, name: exporter.name })
+    import = Account::Import.create!(identity: exporter.identity, account: target_account)
+    Current.with_account(target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+    import.check
+    import.process
+    assert_equal 0, target_account.bytes_used
+    assert_equal 0, Board.find(source_board_id).bytes_used
+
+    perform_enqueued_jobs(only: Storage::ReconcileRecordJob)
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_equal 7, target_account.bytes_used
+    assert_equal 7, Board.find(source_board_id).bytes_used
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
   private
     def account_digest(account)
       {
