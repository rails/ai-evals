+module Storage::Reconcilable
+  extend ActiveSupport::Concern
+
+  def reconcile_storage_later
+    owner_account = account
+    owner_account_id = is_a?(Account) ? id : account_id
+    record_type, record_id = self.class.name, id
+
+    ActiveRecord.after_all_transactions_commit do
+      Current.with_account(owner_account) do
+        Storage::ReconcileRecordJob.perform_later(owner_account_id, record_type, record_id)
+      end
+    end
+  end
+end
diff --git a/app/models/storage/reconciliation.rb b/app/models/storage/reconciliation.rb
new file mode 100644
index 0000000..11e4b8f
--- /dev/null
+++ b/app/models/storage/reconciliation.rb
@@ -0,0 +1,58 @@
+class Storage::Reconciliation
+  BATCH_SIZE = 100
+
+  def initialize(account_id:, record_type:, record_id:)
+    @account_id, @record_type, @record_id = account_id, record_type, record_id
+  end
+
+  def reconcile_later
+    # Include live, untracked attachments as well as the ledger. A card can move
+    # before its first attachment job runs, or be deleted before a retry runs.
+    attachment_scopes.each do |scope|
+      untracked(scope).in_batches(of: BATCH_SIZE) do |batch|
+        Storage::ReconcileJob.perform_later(account_id, batch.pluck(:id))
+      end
+    end
+    entries.in_batches(of: BATCH_SIZE) do |batch|
+      Storage::ReconcileJob.perform_later(account_id, batch.pluck(:attachment_id))
+    end
+  end
+
+  private
+    attr_reader :account_id, :record_type, :record_id
+
+    def attachment_scopes
+      scope = ActiveStorage::Attachment.where(account_id: account_id)
+      images = scope.where(record_type: "Card", name: "image")
+      embeds = scope.where(record_type: "ActionText::RichText", name: "embeds")
+
+      case record_type
+      when "Account"
+        [ images, embeds ]
+      when "Board"
+        # Board reconciliation is used after destruction; live attachments are gone.
+        []
+      when "Card"
+        descriptions = ActionText::RichText.where(record_type: "Card", record_id: record_id, name: "description")
+        comments = ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: record_id).select(:id), name: "body")
+
+        [ images.where(record_id: record_id), embeds.where(record_id: descriptions.select(:id)), embeds.where(record_id: comments.select(:id)) ]
+      else
+        raise ArgumentError, "Unsupported storage owner: #{record_type}"
+      end
+    end
+
+    def untracked(scope)
+      scope.where(Storage::Entry.where("storage_entries.attachment_id = active_storage_attachments.id").arel.exists.not)
+    end
+
+    def entries
+      scope = Storage::Entry.where(account_id: account_id)
+
+      case record_type
+      when "Account" then scope
+      when "Board" then scope.where(board_id: record_id)
+      when "Card" then scope.where(card_id: record_id)
+      end
+    end
+end
diff --git a/app/models/storage/tracked_attachment.rb b/app/models/storage/tracked_attachment.rb
new file mode 100644
index 0000000..6c93ff6
--- /dev/null
+++ b/app/models/storage/tracked_attachment.rb
@@ -0,0 +1,27 @@
+module Storage::TrackedAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :reconcile_storage_later, on: %i[create destroy], if: :storage_tracked?
+  end
+
+  # Active Storage's purge and purge_later use delete, bypassing destroy callbacks.
+  def delete
+    super.tap do
+      if storage_tracked?
+        ActiveRecord.after_all_transactions_commit { reconcile_storage_later }
+      end
+    end
+  end
+
+  private
+    def storage_tracked?
+      (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+    end
+
+    def reconcile_storage_later
+      Current.with_account(account) do
+        Storage::ReconcileJob.perform_later(account_id, [ id ])
+      end
+    end
+end
