+module Storage::Used
+  extend ActiveSupport::Concern
+
+  # Read the latest background-calculated value, even on an already loaded model
+  # or when another connection updated usage during a query-cached request.
+  def bytes_used
+    if persisted?
+      self.class.uncached { self.class.where(id: id).pick(:bytes_used).to_i }
+    else
+      0
+    end
+  end
+end
