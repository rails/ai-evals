@@ -0,0 +1,262 @@
+require "test_helper"
+
+class Storage::EntryTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    Current.user = users(:david)
+  end
+
+  test "accounts and boards expose fresh storage usage, including zero for new records" do
+    assert_usage 0
+    assert_equal 0, Account.new.bytes_used
+    assert_equal 0, Board.new.bytes_used
+
+    attachment = attach_image(@card, 123)
+    assert_usage 0
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_usage 123
+    assert_equal 1, Storage::Entry.count
+  end
+
+  test "counts card images and embeds on boards, cards, and comments" do
+    perform_enqueued_jobs(only: Storage::ReconcileJob) do
+      attach_image(@card, 11)
+      embed(@board, :public_description, 22)
+      embed(@card, :description, 33)
+      embed(@comment, :body, 44)
+      attach_image(cards(:text), 55)
+    end
+
+    assert_usage 165
+    assert_equal 5, Storage::Entry.count
+    assert_equal 0, accounts(:initech).bytes_used
+    assert_equal 0, boards(:miltons_wish_list).bytes_used
+  end
+
+  test "other attachments and unattached blobs do not count" do
+    perform_enqueued_jobs(only: Storage::ReconcileJob) do
+      previewed_blob = blob(123)
+      ActiveStorage::Attachment.create!(record: previewed_blob, name: "preview_image", blob: blob(123))
+      variant = ActiveStorage::VariantRecord.create!(blob: previewed_blob, variation_digest: "test-variant")
+      ActiveStorage::Attachment.create!(record: variant, name: "image", blob: blob(123))
+      export = Account::Export.create!(account: @account, user: users(:david))
+      export.file.attach(blob(123))
+      import = Account::Import.create!(account: @account, identity: identities(:david))
+      import.file.attach(blob(123))
+      users(:david).avatar.attach(blob(234))
+      attachment = ActiveStorage::Attachment.create!(record: @card, name: "other", blob: blob(345))
+      Storage::Entry.reconcile(attachment.id, account_id: @account.id)
+      rich_text = ActionText::RichText.create!(record: @board, name: "other", body: "Ignored")
+      rich_text.embeds.attach(blob(456))
+    end
+
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "retries and delayed jobs reconcile current state without double counting" do
+    attachment = attach_image(@card, 123)
+    2.times { Storage::ReconcileJob.perform_now(@account.id, [ attachment.id ]) }
+    assert_usage 123
+
+    attachment.destroy!
+    2.times { Storage::ReconcileJob.perform_now(@account.id, [ attachment.id ]) }
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "an attachment removed before its first job does not count" do
+    attach_image(@card, 123).destroy!
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "replacing and purging images updates usage even when purge bypasses destroy callbacks" do
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { attach_image(@card, 123) }
+    assert_usage 123
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { attach_image(@card, 456) }
+    assert_usage 456
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @card.image.purge }
+    assert_usage 0
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { attach_image(@card, 789) }
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @card.image.purge_later }
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "removing embeds updates usage" do
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { embed(@comment, :body, 123) }
+    assert_usage 123
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @comment.update!(body: "No attachment") }
+    assert_usage 0
+  end
+
+  test "shared blobs count each attachment without being confused by equal byte sizes" do
+    shared_blob = blob(123)
+    perform_enqueued_jobs(only: Storage::ReconcileJob) do
+      @card.image.attach(shared_blob)
+      cards(:text).image.attach(shared_blob)
+    end
+    assert_usage 246
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @card.image.detach }
+    assert_usage 123
+  end
+
+  test "moving a card transfers its image, description, and comment storage" do
+    destination = boards(:private)
+    perform_storage_jobs do
+      embed(@board, :public_description, 100)
+      attach_image(@card, 11)
+      embed(@card, :description, 22)
+      embed(@comment, :body, 33)
+    end
+    assert_usage 166
+
+    perform_storage_jobs { @card.move_to(destination) }
+    assert_equal 100, @board.bytes_used
+    assert_equal 66, destination.bytes_used
+    assert_equal 166, @account.bytes_used
+  end
+
+  test "moving before the first attachment job uses the current board" do
+    attach_image(@card, 123)
+    @card.move_to(boards(:private))
+    perform_storage_jobs
+    assert_equal 0, @board.bytes_used
+    assert_equal 123, boards(:private).bytes_used
+    assert_equal 123, @account.bytes_used
+  end
+
+  test "destroying comments and cards removes their usage" do
+    perform_storage_jobs do
+      attach_image(@card, 11)
+      embed(@card, :description, 22)
+      embed(@comment, :body, 33)
+    end
+    perform_storage_jobs { @comment.destroy! }
+    assert_usage 33
+    perform_storage_jobs { @card.destroy! }
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "destroying a board updates its account without requiring the board to exist" do
+    perform_storage_jobs do
+      embed(@board, :public_description, 100)
+      attach_image(@card, 123)
+      cards(:buy_domain).move_to(boards(:private))
+      attach_image(cards(:buy_domain), 456)
+    end
+    assert_equal 679, @account.bytes_used
+    perform_storage_jobs { @board.destroy! }
+    assert_equal 456, @account.bytes_used
+    assert_empty Storage::Entry.where(board_id: @board.id)
+  end
+
+  test "destroying an account cleans up the ledger and tolerates queued jobs" do
+    perform_storage_jobs { attach_image(@card, 123) }
+    @account.destroy!
+    perform_storage_jobs
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "backfill includes attachments inserted without callbacks and is idempotent" do
+    attachment = attach_image(@card, 123)
+    clear_enqueued_jobs
+    2.times { perform_storage_jobs { @account.reconcile_storage_later } }
+    assert_usage 123
+    assert_equal 1, Storage::Entry.count
+  end
+
+  test "storage tracking rolls back with the attachment transaction" do
+    perform_storage_jobs do
+      ActiveStorage::Attachment.transaction do
+        attach_image(@card, 123)
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_usage 0
+    assert_empty Storage::Entry.all
+  end
+
+  test "large totals are stored without 32-bit overflow" do
+    attachment = attach_image(@card, 1)
+    attachment.blob.update!(byte_size: 5.gigabytes)
+    perform_storage_jobs
+    assert_usage 5.gigabytes
+  end
+
+  test "ledger and counter updates roll back together when reconciliation fails" do
+    attachment = attach_image(@card, 123)
+    Storage::Entry.any_instance.stubs(:update!).raises(ActiveRecord::RecordInvalid)
+    assert_raises(ActiveRecord::RecordInvalid) do
+      Storage::Entry.reconcile(attachment.id, account_id: @account.id)
+    end
+    assert_usage 0
+    assert_empty Storage::Entry.all
+
+    Storage::Entry.any_instance.unstub(:update!)
+    Storage::Entry.reconcile(attachment.id, account_id: @account.id)
+    assert_usage 123
+  end
+
+  test "purge rolls back without scheduling a storage decrement" do
+    perform_storage_jobs { attach_image(@card, 123) }
+    clear_enqueued_jobs
+    ActiveStorage::Attachment.transaction do
+      @card.image.purge_later
+      raise ActiveRecord::Rollback
+    end
+    assert_no_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_usage 123
+  end
+
+  test "account backfills enqueue bounded batches" do
+    attachment = attach_image(@card, 1)
+    rows = 205.times.map do
+      attachment.attributes.merge("id" => ActiveRecord::Type::Uuid.generate, "blob_id" => blob(1).id)
+    end
+    ActiveStorage::Attachment.insert_all!(rows)
+    clear_enqueued_jobs
+
+    @account.reconcile_storage_later
+    perform_enqueued_jobs(only: Storage::ReconcileRecordJob)
+    batches = enqueued_jobs.select { |job| job[:job] == Storage::ReconcileJob }
+    assert_equal [ 100, 100, 6 ], batches.map { |job| job[:args].last.size }
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob)
+    assert_usage 206
+  end
+
+  private
+    def blob(bytes)
+      Current.with_account(@account) do
+        ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * bytes), filename: "file.txt", content_type: "text/plain")
+      end
+    end
+
+    def attach_image(card, bytes)
+      card.image.attach(blob(bytes))
+      card.image_attachment
+    end
+
+    def embed(record, name, bytes)
+      record.update!(name => ActionText::Content.new(blob(bytes).to_rich_text_attributes.then { |attributes| ActionText::Attachment.from_attributes(attributes).to_html }))
+    end
+
+    def assert_usage(bytes)
+      assert_equal bytes, @board.bytes_used
+      assert_equal bytes, @account.bytes_used
+    end
+
+    def perform_storage_jobs(&block)
+      perform_enqueued_jobs(only: [ Storage::ReconcileJob, Storage::ReconcileRecordJob ], &block)
+    end
+end
