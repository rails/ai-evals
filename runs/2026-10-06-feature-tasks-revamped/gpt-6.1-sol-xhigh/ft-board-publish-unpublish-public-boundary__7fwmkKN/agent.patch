diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..3839f90
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,25 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+
+    validates :public_key, uniqueness: true, allow_nil: true
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publish
+    with_lock do
+      update! public_key: SecureRandom.urlsafe_base64(24) unless published?
+    end
+  end
+
+  def unpublish
+    with_lock do
+      update! public_key: nil if published?
+    end
+  end
+end
