diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..7cb0f30
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.public_key
+  end
+
+  test "anonymous visitors can view a board without an account prefix" do
+    get public_board_path(@key, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", @board.name
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo).number, script_name: nil), text: cards(:logo).title
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage), script_name: nil)
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+  end
+
+  test "anonymous visitors can use matching account-prefixed public URLs" do
+    get public_board_path(@key)
+
+    assert_response :success
+  end
+
+  test "signed in nonmembers can view public boards" do
+    sign_in_as :mike
+
+    get public_board_path(@key, script_name: nil)
+
+    assert_response :success
+  end
+
+  test "private boards can be published without granting membership" do
+    board = boards(:private)
+    board.publish
+
+    assert_no_difference -> { board.accesses.count } do
+      get public_board_path(board.public_key, script_name: nil)
+      assert_response :success
+    end
+  end
+
+  test "draft cards are never listed" do
+    draft = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:david))
+
+    get public_board_path(@key, script_name: nil)
+
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, draft.number, script_name: nil), count: 0
+    assert_not_includes response.body, "Secret draft"
+  end
+
+  test "unknown keys and board IDs do not grant public access" do
+    [ "unknown-key", @board.id ].each do |key|
+      get public_board_path(key, script_name: nil)
+      assert_response :not_found
+    end
+  end
+
+  test "a key cannot be used with a different or missing account" do
+    [ accounts(:initech).slug, "/999999999999" ].each do |slug|
+      get public_board_path(@key, script_name: slug)
+      assert_response :not_found
+    end
+  end
+
+  test "unpublishing revokes even conditional requests to the old URL" do
+    get public_board_path(@key, script_name: nil)
+    etag = response.headers["ETag"]
+    @board.unpublish
+
+    get public_board_path(@key, script_name: nil), headers: { "If-None-Match" => etag }
+
+    assert_response :not_found
+  end
+
+  test "republishing does not reactivate old links" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@key, script_name: nil)
+    assert_response :not_found
+    get public_board_path(@board.public_key, script_name: nil)
+    assert_response :success
+  end
+
+  test "public pages have no mutation routes" do
+    post public_board_path(@key, script_name: nil)
+    assert_response :not_found
+    delete public_board_card_path(@key, cards(:logo).number, script_name: nil)
+    assert_response :not_found
+  end
+
+  test "empty boards can be viewed" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.public_key, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", board.name
+    assert_select "article.card", count: 0
+  end
+
+  test "public access is unavailable for inactive accounts" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    get public_board_path(@key, script_name: nil)
+
+    assert_response :not_found
+  end
+
+  test "unknown keys do not grant direct column or card access" do
+    get public_board_column_path("unknown-key", columns(:writebook_triage), script_name: nil)
+    assert_response :not_found
+    get public_board_card_path("unknown-key", cards(:logo).number, script_name: nil)
+    assert_response :not_found
+  end
+end
diff --git a/test/models/account/data_transfer/board_record_set_test.rb b/test/models/account/data_transfer/board_record_set_test.rb
new file mode 100644
index 0000000..5f1a632
--- /dev/null
+++ b/test/models/account/data_transfer/board_record_set_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::DataTransfer::BoardRecordSetTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @record_set = Account::DataTransfer::BoardRecordSet.new(@account)
+  end
+
+  test "manifest excludes publication keys from board data" do
+    Account::DataTransfer::Manifest.new(@account).each_record_set do |record_set|
+      assert_not_includes record_set.attributes, "public_key" if record_set.model == Board
+    end
+  end
+
+  test "exports do not include publication keys" do
+    boards(:writebook).publish
+    exported = {}
+    zip = mock
+    zip.stubs(:add_file).with do |path, json|
+      exported[path] = JSON.parse(json)
+      true
+    end
+
+    @record_set.export(to: zip)
+
+    assert_equal @account.boards.count, exported.size
+    exported.each_value { |data| assert_not data.key?("public_key") }
+  end
+
+  test "old exports without publication keys still pass integrity checks" do
+    data = board_data.except("public_key")
+    data["creator_id"] = ActiveRecord::Type::Uuid.generate
+    data["account_id"] = ActiveRecord::Type::Uuid.generate
+
+    assert_nothing_raised do
+      @record_set.check(from: reader_for(data))
+    end
+  end
+
+  test "imports ignore publication keys and leave boards unpublished" do
+    data = board_data.merge("public_key" => "a-secret-from-another-instance")
+
+    @record_set.import(from: reader_for(data))
+
+    board = Board.find(data["id"])
+    assert_nil board.public_key
+    assert_not board.published?
+  end
+
+  private
+    def board_data
+      boards(:writebook).attributes.merge("id" => ActiveRecord::Type::Uuid.generate)
+    end
+
+    def reader_for(data)
+      path = "data/boards/#{data.fetch('id')}.json"
+      stub(glob: [ path ], read: data.to_json)
+    end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..220b00a
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_nil @board.public_key
+    assert_not @board.published?
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing creates a unique secret key" do
+    @board.publish
+    boards(:private).publish
+
+    assert @board.reload.published?
+    assert_match /\A[A-Za-z0-9_-]{32}\z/, @board.public_key
+    assert_not_equal @board.public_key, boards(:private).reload.public_key
+    assert_includes Board.published, @board
+  end
+
+  test "publishing is idempotent even with a stale board instance" do
+    another_instance = Board.find(@board.id)
+    @board.publish
+    original_key = @board.public_key
+
+    another_instance.publish
+
+    assert_equal original_key, another_instance.reload.public_key
+  end
+
+  test "unpublishing revokes the key and republishing generates a new one" do
+    @board.publish
+    original_key = @board.public_key
+    @board.unpublish
+
+    assert_nil @board.reload.public_key
+    assert_not @board.published?
+    assert_not_includes Board.published, @board
+
+    @board.publish
+    assert_not_equal original_key, @board.public_key
+  end
+
+  test "unpublishing an unpublished board is idempotent" do
+    assert_no_changes -> { @board.reload.updated_at } do
+      @board.unpublish
+      @board.unpublish
+    end
+  end
+
+  test "publication keys must be unique" do
+    @board.publish
+    other_board = boards(:private)
+    other_board.public_key = @board.public_key
+
+    assert_not other_board.valid?
+    assert other_board.errors[:public_key].any?
+  end
+end
