@@ -0,0 +1,17 @@
+module Public::BoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_board
+  end
+
+  private
+    def set_board
+      boards = Board.published.joins(:account).merge(Account.active)
+      boards = boards.where(account: Current.account) if request.env["fizzy.external_account_id"]
+
+      @board = boards.find_by!(public_key: params[:board_key] || params[:key])
+      Current.account = @board.account
+      Current.identity = Current.identity if authenticated?
+    end
+end
