diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..617a0c4
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,45 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+  CODE_LENGTH = 6
+
+  belongs_to :identity
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in signup join ].index_by(&:itself), scopes: false
+
+  attr_reader :code
+
+  validates :purpose, presence: true
+  validates :join_code, presence: true, if: :join?
+
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  before_create :generate_code
+  before_create :capture_join_code, if: :join?
+
+  def deliver_later
+    IdentityMailer.email_code(identity, code).deliver_later
+  end
+
+  def consume(code)
+    if ActiveSupport::SecurityUtils.secure_compare(code_digest, digest(code)) &&
+        self.class.where(id: id).where("expires_at > ?", Time.current).delete_all == 1
+      identity
+    end
+  end
+
+  private
+    def generate_code
+      @code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      self.code_digest = digest(@code)
+      self.expires_at = EXPIRATION.from_now
+    end
+
+    def capture_join_code
+      self.join_code_value = join_code.code
+    end
+
+    def digest(code)
+      Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+    end
+end
