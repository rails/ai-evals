@@ -0,0 +1,71 @@
+class Sessions::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :set_email_code
+
+  layout "public"
+  helper_method :new_code_path
+
+  def new
+  end
+
+  def create
+    if identity = @email_code.consume(params.expect(:code))
+      session.delete(:email_code_id)
+      start_new_session_for identity
+
+      complete_authentication(identity)
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn't work or has expired. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work or has expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:email_code_id])
+
+      unless @email_code && (!@email_code.join? || @email_code.join_code)
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email to get a new code." }
+          format.json { render json: { message: "Request a new sign-in code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def complete_authentication(identity)
+      if @email_code.join?
+        join_with_code(identity, @email_code.join_code, code: @email_code.join_code_value)
+      else
+        respond_to do |format|
+          format.html { redirect_to @email_code.signup? ? new_signup_completion_path : after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    end
+
+    def new_code_path
+      if @email_code.join?
+        join_path(code: @email_code.join_code_value, script_name: @email_code.join_code.account.slug)
+      elsif @email_code.signup?
+        new_signup_path
+      else
+        new_session_path
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
