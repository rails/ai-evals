--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,46 @@
+module EmailCodeAuthentication
+  private
+
+  def send_email_code(identity, purpose: :sign_in, join_code: nil)
+    EmailCode.where(id: session.delete(:email_code_id)).delete_all
+
+    email_code = identity.email_codes.create!(purpose: purpose, join_code: join_code)
+    email_code.deliver_later
+    session[:email_code_id] = email_code.id
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_path(script_name: nil) }
+      format.json { render json: { message: "Check your email for your sign-in code." }, status: :created }
+    end
+  end
+
+  def join_with_code(identity, join_code, code: join_code.code)
+    redeemed = false
+    join_code.redeem_if do |account|
+      if join_code.code == code
+        redeemed = true
+        identity.join(account)
+      end
+    end
+
+    if redeemed
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to join_url(code: code, script_name: join_code.account.slug), alert: "That join code is no longer active." }
+        format.json { render json: { message: "That join code is no longer active." }, status: :gone }
+      end
+    end
+  end
+end
