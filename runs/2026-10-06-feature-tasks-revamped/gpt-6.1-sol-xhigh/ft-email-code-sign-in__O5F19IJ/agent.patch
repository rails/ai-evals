+++ b/test/models/email_code_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "generates a six-character code and stores only its digest" do
+    email_code = identities(:kevin).email_codes.create!
+
+    assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+    assert_not_equal email_code.code, email_code.code_digest
+    assert_nil EmailCode.find(email_code.id).code
+  end
+
+  test "codes expire after fifteen minutes" do
+    freeze_time do
+      email_code = identities(:kevin).email_codes.create!
+      assert_equal 15.minutes.from_now, email_code.expires_at
+
+      travel 15.minutes
+      assert_nil email_code.consume(email_code.code)
+      assert EmailCode.exists?(email_code.id)
+    end
+  end
+
+  test "code is valid just before it expires" do
+    email_code = identities(:kevin).email_codes.create!
+
+    travel_to email_code.expires_at - 1.second do
+      assert_equal identities(:kevin), email_code.consume(email_code.code)
+    end
+  end
+
+  test "codes can only be used once even with a previously loaded record" do
+    email_code = identities(:kevin).email_codes.create!
+    copy = EmailCode.find(email_code.id)
+
+    assert_equal identities(:kevin), email_code.consume(email_code.code)
+    assert_nil copy.consume(email_code.code)
+  end
+
+  test "incorrect codes do not consume the code" do
+    email_code = identities(:kevin).email_codes.create!
+
+    assert_nil email_code.consume("WRONG")
+    assert EmailCode.exists?(email_code.id)
+    assert_equal identities(:kevin), email_code.consume(email_code.code)
+  end
+
+  test "codes are case insensitive and ignore surrounding whitespace" do
+    email_code = identities(:kevin).email_codes.create!
+
+    assert_equal identities(:kevin), email_code.consume(" #{email_code.code.downcase} ")
+  end
+
+  test "expired scope includes expired codes but not active ones" do
+    expired = identities(:kevin).email_codes.create!
+    expired.update!(expires_at: 1.second.ago)
+    active = identities(:kevin).email_codes.create!
+
+    assert_includes EmailCode.expired, expired
+    assert_not_includes EmailCode.expired, active
+  end
+
+  test "destroying an identity removes its codes" do
+    identity = Identity.create!(email_address: "removed@example.com")
+    email_code = identity.email_codes.create!
+
+    identity.destroy!
+    assert_not EmailCode.exists?(email_code.id)
+  end
+end
