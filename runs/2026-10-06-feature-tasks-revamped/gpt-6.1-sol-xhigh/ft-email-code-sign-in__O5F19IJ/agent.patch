diff --git a/test/controllers/email_code_flow_test.rb b/test/controllers/email_code_flow_test.rb
new file mode 100644
index 0000000..b74a5c7
--- /dev/null
+++ b/test/controllers/email_code_flow_test.rb
@@ -0,0 +1,380 @@
+require "test_helper"
+
+class EmailCodeFlowTest < ActionDispatch::IntegrationTest
+  test "sign in sends a six-character code in the email subject and accepts it as code" do
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+      assert_select "a", text: "Request a new code"
+      assert_in_body identities(:kevin).email_address
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "sign in preserves the requested account URL" do
+    get root_path
+    assert_redirected_to new_session_path(script_name: nil)
+
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to root_url(script_name: accounts("37s").slug)
+  end
+
+  test "invalid codes can be retried without signing in" do
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path(script_name: nil), params: { code: "WRONG" }
+      end
+      assert_response :unprocessable_entity
+      assert_select ".flash", text: /That code didn't work/
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "expired codes do not sign in" do
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+
+      travel_to EmailCode.last.expires_at, with_usec: true do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path(script_name: nil), params: { code: code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "requesting a new code invalidates the previous code" do
+    untenanted do
+      request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+      previous_code = EmailCode.last
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+      assert_not EmailCode.exists?(previous_code.id)
+
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "a code cannot be used from a different browser session" do
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+      other_browser = open_session
+
+      assert_no_difference -> { Session.count } do
+        other_browser.post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      other_browser.assert_redirected_to new_session_path
+
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "a consumed code cannot be replayed" do
+    untenanted do
+      code = request_code { post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address } }
+      post session_email_code_path(script_name: nil), params: { code: code }
+      sign_out
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "sign up verifies email before completing account creation" do
+    untenanted do
+      code = request_code do
+        assert_difference -> { Identity.count }, 1 do
+          assert_no_difference -> { Account.count } do
+            post signup_path, params: { signup: { email_address: "new@example.com" } }
+          end
+        end
