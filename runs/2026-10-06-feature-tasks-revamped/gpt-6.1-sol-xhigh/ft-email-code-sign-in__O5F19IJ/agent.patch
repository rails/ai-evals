+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= @email_code.identity.email_address %></strong>. Enter it below to continue. It works for 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <label class="flex align-center gap input input--actor">
+      <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, minlength: EmailCode::CODE_LENGTH, maxlength: EmailCode::CODE_LENGTH, placeholder: "Enter your code…", aria: { label: "Sign-in code" } %>
+    </label>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <%= link_to "Request a new code", new_code_path, class: "txt-small center" %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
