+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email contains the code in the subject and body and explains expiration" do
+    identity = identities(:kevin)
+    email = IdentityMailer.email_code(identity, "A1B2C3")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identity.email_address ], email.to
+    assert_equal "A1B2C3 is your Fizzy sign-in code", email.subject
+    assert_match "A1B2C3", email.body.to_s
+    assert_match "15 minutes", email.body.to_s
+    assert_match "only be used once", email.body.to_s
+  end
+
+  test "queued delivery does not depend on the code record still existing" do
+    email_code = identities(:kevin).email_codes.create!
+    code = email_code.code
+    email_code.deliver_later
+    email_code.delete
+
+    assert_emails 1 do
+      perform_enqueued_jobs
+    end
+
+    assert_includes ActionMailer::Base.deliveries.last.subject, code
+  end
+end
