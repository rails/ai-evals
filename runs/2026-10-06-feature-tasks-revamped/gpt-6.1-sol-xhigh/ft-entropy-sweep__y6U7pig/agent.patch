+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
   end
 
   test "postponing_soon scope works properly cross-account" do
@@ -85,4 +89,80 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone uses an inclusive cutoff with subsecond precision" do
+    travel_to Time.current.change(usec: 500000), with_usec: true
+    cutoff = Time.current - entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update_columns(last_active_at: cutoff)
+    cards(:layout).update_columns(last_active_at: cutoff - 0.000001r)
+    cards(:text).update_columns(last_active_at: cutoff + 0.000001r)
+
+    assert_difference -> { Card.postponed.count }, +2 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:text).reload.postponed?
+  end
+
+  test "auto postpone skips closed, drafted, already postponed and recently active cards" do
+    cards(:layout).close
+    cards(:text).postpone
+    cards(:buy_domain).drafted!
+    cards(:logo, :layout, :text, :buy_domain).each do |card|
+      card.update_columns(last_active_at: 100.days.ago)
+    end
+
+    assert_difference -> { Event.where(action: "card_auto_postponed").count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.closed?
+    assert cards(:buy_domain).reload.drafted?
+    assert_equal users(:david), cards(:text).reload.postponed_by
+    assert_not cards(:radio).reload.postponed?
+
+    assert_no_difference -> { Event.where(action: "card_auto_postponed").count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone honors both shorter and longer board overrides" do
+    entropies(:private_board).update!(auto_postpone_period: 7.days)
+    cards(:layout).update_columns(board_id: boards(:private).id, column_id: nil, last_active_at: 10.days.ago)
+    cards(:logo).update_columns(last_active_at: 40.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:logo).reload.postponed?
+  end
+
+  test "auto postpone selects cards with a fixed per-board cutoff instead of joining entropy" do
+    assert_no_queries_match(/FROM ["`]cards["`].*JOIN ["`](boards|accounts|entropies)["`]/) do
+      assert_queries_match(/FROM ["`]cards["`].*["`]board_id["`] = .*["`]last_active_at["`] <= /, count: Board.count) do
+        Card.auto_postpone_all_due
+      end
+    end
+  end
+
+  test "auto postpone batches cards sharing an activity time and looks up the system user only once" do
+    freeze_time
+
+    board = boards(:writebook)
+    rows = 1001.times.map do |number|
+      { id: ActiveRecord::Type::Uuid.generate, account_id: board.account_id, board_id: board.id,
+        creator_id: users(:david).id, number: number + 100, status: "published", last_active_at: 100.days.ago }
+    end
+    Card.insert_all!(rows)
+
+    Account.any_instance.expects(:system_user).once.returns(users(:system))
+    Card.any_instance.expects(:auto_postpone).with(user: users(:system)).times(rows.size)
+
+    Card.auto_postpone_all_due
+  end
 end
