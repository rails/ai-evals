diff --git a/app/models/board/auto_postponing.rb b/app/models/board/auto_postponing.rb
index da53692..6adb53d 100644
--- a/app/models/board/auto_postponing.rb
+++ b/app/models/board/auto_postponing.rb
@@ -5,6 +5,17 @@ module Board::AutoPostponing
     before_create :set_default_auto_postpone_period
   end
 
+  def auto_postpone_due_cards(now: Time.current)
+    if period = entropy&.auto_postpone_period
+      system_user = nil
+
+      # A fixed cutoff per board lets the database use the board/activity index.
+      cards.active.where(last_active_at: ..(now - period)).find_each do |card|
+        card.auto_postpone(user: system_user ||= account.system_user)
+      end
+    end
+  end
+
   private
     def set_default_auto_postpone_period
       self.auto_postpone_period ||= Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days unless attribute_present?(:auto_postpone_period)
