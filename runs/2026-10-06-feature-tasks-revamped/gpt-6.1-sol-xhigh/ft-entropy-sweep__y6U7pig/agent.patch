diff --git a/test/models/board/auto_postponing_test.rb b/test/models/board/auto_postponing_test.rb
new file mode 100644
index 0000000..b0d8c23
--- /dev/null
+++ b/test/models/board/auto_postponing_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class Board::AutoPostponingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "auto postpone due cards is limited to this board and the supplied time" do
+    cutoff = 100.days.ago
+    cards(:logo, :radio).each { |card| card.update_columns(last_active_at: cutoff) }
+    now = cutoff + boards(:writebook).auto_postpone_period
+
+    boards(:writebook).auto_postpone_due_cards(now: now)
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
+
+  test "auto postpone skips boards without an entropy configuration" do
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").destroy!
+    cards(:logo).update_columns(last_active_at: 100.days.ago)
+
+    assert_no_difference -> { Card::NotNow.count } do
+      boards(:writebook).reload.auto_postpone_due_cards
+    end
+  end
+end
