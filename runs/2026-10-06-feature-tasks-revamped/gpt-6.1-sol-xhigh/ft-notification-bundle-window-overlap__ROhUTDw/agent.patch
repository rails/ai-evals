@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:kevin)
+    @user.notification_bundles.reload.destroy_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  teardown do
+    @user.notification_bundles.reload.destroy_all
+    @user.settings.update!(bundle_email_frequency: "never")
+  end
+
+  test "concurrent first arrivals create only one window" do
+    notification_ids = [ notifications(:logo_assignment_kevin).id, notifications(:layout_commented_kevin).id ]
+    at = Time.current.change(usec: 0)
+
+    bundles = concurrently do |index|
+      notification = Notification.find(notification_ids[index % notification_ids.size])
+      Notification::Bundle.add(notification, at: at + index.seconds)
+    end
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, @user.notification_bundles.reload.sole.entries.count
+  end
+
+  test "concurrent deliveries send only one email" do
+    bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+
+    travel_to bundle.ends_at do
+      assert_emails 1 do
+        concurrently { Notification::Bundle.find(bundle.id).deliver_now }
+      end
+    end
+
+    assert_not_nil bundle.reload.sent_at
+  end
+
+  private
+    def concurrently
+      ready = Queue.new
+      start = Queue.new
+      account = @user.account
+
+      threads = 4.times.map do |index|
+        Thread.new do
+          ready << true
+          start.pop
+
+          ActiveRecord::Base.connection_pool.with_connection do
+            Current.with_account(account) { yield index }
+          end
+        ensure
+          Current.clear_all
+        end
+      end
+
+      4.times { ready.pop }
+      4.times { start << true }
+      threads.map(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..5b557ec
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,255 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "the first notification opens a four hour window" do
+    at = Time.current.change(usec: 0)
+
+    bundle = Notification::Bundle.add(@notification, at: at)
+
+    assert_equal @user, bundle.user
+    assert_equal @user.account, bundle.account
+    assert_equal at, bundle.starts_at
+    assert_equal at + 4.hours, bundle.ends_at
+    assert_equal [ @notification ], bundle.notifications.to_a
+  end
+
+  test "late notifications join the window already opened" do
+    at = Time.current.change(usec: 0)
+    bundle = Notification::Bundle.add(@notification, at: at)
+    late_notification = notifications(:layout_commented_kevin)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_equal bundle, Notification::Bundle.add(late_notification, at: at - 1.hour)
+    end
+
+    assert_includes bundle.notifications, late_notification
+    assert_equal at, bundle.reload.starts_at
+  end
+
+  test "the end of a window belongs to the next window" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: first.ends_at)
+
+    assert_not_equal first, second
+    assert_equal first.ends_at, second.starts_at
+  end
+
+  test "frequency changes do not overlap an existing window" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    assert_equal first, Notification::Bundle.add(notifications(:layout_commented_kevin), at: at + 1.hour)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_equal first.ends_at, second.starts_at
+    assert_equal second.starts_at + 1.week, second.ends_at
+  end
+  { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, interval|
+    test "#{frequency} uses its own interval" do
+      @user.settings.update!(bundle_email_frequency: frequency)
+      at = Time.current.change(usec: 0)
+
+      bundle = Notification::Bundle.add(@notification, at: at)
+
+      assert_equal at + interval, bundle.ends_at
+    end
+  end
+
+  test "never does not create a window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "recipients have independent windows and frequencies" do
+    david = users(:david)
+    david.settings.update!(bundle_email_frequency: "daily")
+    at = Time.current.change(usec: 0)
+
+    kevin_bundle = Notification::Bundle.add(@notification, at: at)
+    david_bundle = Notification::Bundle.add(notifications(:logo_mentioned_david), at: at + 1.hour)
+
+    assert_equal @user, kevin_bundle.user
+    assert_equal david, david_bundle.user
+    assert_equal at + 25.hours, david_bundle.ends_at
+    assert_equal at + 4.hours, kevin_bundle.ends_at
+  end
+
+  test "an overdue window does not overlap the next window" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: at + 5.hours)
+
+    assert_nil first.sent_at
+    assert_operator first.ends_at, :<=, second.starts_at
+    assert_equal at + 5.hours, second.starts_at
+  end
+
+  test "a delayed arrival uses the earlier unsent window rather than creating an overlap" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: at + 5.hours)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_equal first, Notification::Bundle.add(notifications(:buy_domain_sent_back_to_triage_kevin), at: at + 1.hour)
+    end
+    assert_operator first.ends_at, :<=, second.starts_at
+  end
+
+  test "late arrivals after delivery never open a window overlapping a sent window" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    travel_to first.ends_at do
+      first.deliver_now
+    end
+
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: at - 1.hour)
+
+    assert_equal first.ends_at, second.starts_at
+    assert_operator first.ends_at, :<=, second.starts_at
+  end
+
+  test "retries do not add a notification twice or enqueue another delivery" do
+    at = Time.current.change(usec: 0)
+    bundle = Notification::Bundle.add(@notification, at: at)
+
+    assert_no_difference "Notification::Bundle::Entry.count" do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        assert_equal bundle, Notification::Bundle.add(@notification, at: at)
+      end
+    end
+  end
+
+  test "a reused card notification can belong to successive windows" do
+    at = Time.current.change(usec: 0)
+    first = Notification::Bundle.add(@notification, at: at)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+    assert_equal [ @notification ], first.notifications.to_a
+    assert_equal [ @notification ], second.notifications.to_a
+  end
+
+  test "delivery is scheduled for the end of the window" do
+    at = Time.current.change(usec: 0)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, at: at + 4.hours) do
+      Notification::Bundle.add(@notification, at: at)
+    end
+  end
+
+  test "delivery sends all notifications in one email only after the window ends" do
+    at = Time.current.change(usec: 0)
+    bundle = Notification::Bundle.add(@notification, at: at)
+    Notification::Bundle.add(notifications(:layout_commented_kevin), at: at + 1.hour)
+
+    travel_to bundle.ends_at - 1.second do
+      assert_no_emails { bundle.deliver_now }
+      assert_nil bundle.reload.sent_at
+    end
+
+    travel_to bundle.ends_at do
+      assert_emails 1 do
+        2.times { Notification::Bundle.find(bundle.id).deliver_now }
+      end
+      assert_equal Time.current, bundle.reload.sent_at
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.html_part.body.decoded, ERB::Util.html_escape(@notification.payload.title)
+    assert_includes email.html_part.body.decoded, notifications(:layout_commented_kevin).payload.title
+    assert_includes email.text_part.body.decoded, @notification.account.slug
+  end
+
+  test "opting out before delivery suppresses the email" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver_now }
+      assert_not_nil bundle.reload.sent_at
+    end
+  end
+
+  test "empty windows do not send email" do
+    bundle = Notification::Bundle.add(@notification)
+    @notification.destroy!
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver_now }
+      assert_not_nil bundle.reload.sent_at
+    end
+  end
+
+  test "delivery failures leave the window available for retry" do
+    bundle = Notification::Bundle.add(@notification)
+    message = mock("message")
+    NotificationMailer.expects(:bundle).with(bundle).returns(message)
+    message.expects(:deliver_now).raises(IOError)
+
+    travel_to bundle.ends_at do
+      assert_raises(IOError) { bundle.deliver_now }
+      assert_nil bundle.reload.sent_at
+    end
+  end
+
+  test "inactive recipients and system activity do not open windows" do
+    @notification.update!(creator: users(:system))
+    assert_nil Notification::Bundle.add(@notification)
+
+    @notification.update!(creator: users(:david))
+    @user.update!(active: false)
+    assert_nil Notification::Bundle.add(@notification)
+  end
+
+  test "deactivation before delivery suppresses the email" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.deactivate
+
+    travel_to bundle.ends_at do
+      assert_no_emails { bundle.deliver_now }
+      assert_not_nil bundle.reload.sent_at
+    end
+  end
+  test "an enrollment retry after delivery reuses the original window" do
+    at = Time.current.change(usec: 0)
+    bundle = Notification::Bundle.add(@notification, at: at)
+    travel_to bundle.ends_at do
+      bundle.deliver_now
+    end
+    Notification::Bundle.add(notifications(:layout_commented_kevin), at: bundle.ends_at)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_no_difference "Notification::Bundle::Entry.count" do
+        assert_equal bundle, Notification::Bundle.add(@notification, at: at)
+      end
+    end
+  end
+test "mention notifications are included in digests" do
+  user = users(:david)
+  user.settings.update!(bundle_email_frequency: "daily")
+  notification = notifications(:logo_mentioned_david)
+  bundle = Notification::Bundle.add(notification)
+
+  assert_emails 1 do
+    bundle.deliver_now
+  end
+
+  email = ActionMailer::Base.deliveries.last
+  assert_equal [ user.identity.email_address ], email.to
+  assert_includes email.text_part.body.decoded, notification.payload.title
+  assert_includes email.text_part.body.decoded, notification.payload.body
+end
+end
