diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..5d2fc83
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,17 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :bundle_email_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_email_later
+    if user.settings&.bundle_email_interval
+      Notification::BundleJob.perform_later(self, at: updated_at)
+    end
+  end
+
+  def bundle_email_now(at: updated_at)
+    Notification::Bundle.add(self, at: at)
+  end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..43832c2
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,72 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::Bundle::Entry", foreign_key: :bundle_id, dependent: :delete_all
+  has_many :notifications, through: :entries
+
+  scope :unsent, -> { where(sent_at: nil) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at: notification.updated_at)
+      user = notification.user
+
+      # Lock the recipient, not a bundle: the first concurrent arrivals have no bundle to lock yet.
+      user.with_lock do
+        if interval = user.settings&.reload&.bundle_email_interval
+          if user.active? && user.identity.present? && user.account.active? && !notification.creator.system?
+            bundle = find_or_open_window(notification, user, at, interval)
+            bundle.entries.find_or_create_by!(notification: notification)
+            bundle
+          end
+        end
+      end
+    end
+
+    private
+      def find_or_open_window(notification, user, at, interval)
+        # Reuse existing enrollment even after delivery, making job retries idempotent.
+        # No lower bound: delayed notifications belong to an already opened window.
+        user.notification_bundles.joins(:entries)
+          .where(notification_bundle_entries: { notification_id: notification.id })
+          .where("notification_bundles.ends_at > ?", at).order(:starts_at).first ||
+          user.notification_bundles.unsent.where("ends_at > ?", at).order(:starts_at).first ||
+          open_window(user, at, interval)
+      end
+
+      def open_window(user, at, interval)
+        previous_end = user.notification_bundles.maximum(:ends_at)
+        starts_at = previous_end ? [ at, previous_end ].max : at
+
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+      end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    # Enrollment and delivery share this lock so the email contains the whole window,
+    # and duplicate delivery jobs cannot send the same bundle twice.
+    user.with_lock do
+      reload
+
+      if sent_at.nil? && ends_at <= Time.current
+        if deliverable?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && user.identity.present? && account.active? &&
+        user.settings&.reload&.bundle_email_interval && notifications.exists?
+    end
+end
