index 0000000..17f5a5d
--- /dev/null
+++ b/test/models/notification/bundlable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Notification::BundlableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+  end
+
+  test "new notifications enqueue enrollment with the activity timestamp" do
+    travel_to Time.current.change(usec: 0) do
+      assert_enqueued_with(job: Notification::BundleJob, args: ->(args) { args.last[:at] == Time.current }) do
+        @user.notifications.create!(source: events(:text_published), creator: users(:david))
+      end
+    end
+  end
+
+  test "source updates enroll reused notifications" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "reading a notification does not enroll it again" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+      @notification.unread
+      @notification.update!(unread_count: 5)
+    end
+  end
+
+  test "never does not enqueue enrollment" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "delayed enrollment uses the captured timestamp even if the notification has since been read" do
+    at = Time.current.change(usec: 0)
+    travel_to at do
+      @notification.update!(source: events(:logo_published))
+    end
+    travel_to at + 2.hours do
+      @notification.read
+
+      perform_enqueued_jobs only: Notification::BundleJob
+    end
+
+    bundle = @user.notification_bundles.sole
+    assert_equal at, bundle.starts_at
+    assert_equal at + 1.day, bundle.ends_at
+  end
+end
