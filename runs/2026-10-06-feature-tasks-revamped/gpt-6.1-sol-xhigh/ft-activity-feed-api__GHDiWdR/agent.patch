+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_events.preloaded.order(created_at: :desc, id: :desc)
+  end
+
+  private
+    def filtered_events
+      filters = params.permit(creator_ids: [], board_ids: [])
+      events = Current.user.accessible_events.for_activity
+      events = events.where(creator_id: filters[:creator_ids]) if filters[:creator_ids].present?
+      events = events.where(board_id: filters[:board_ids]) if filters[:board_ids].present?
+      events
+    end
+end
