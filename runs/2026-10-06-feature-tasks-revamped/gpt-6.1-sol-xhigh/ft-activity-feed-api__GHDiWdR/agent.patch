+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of account activity, newest first. Only activity on boards the current user can access is returned.
+
+Results use the API's standard [pagination](../README.md#pagination). Follow the `Link` header's `rel="next"` URL to fetch the next page; filters are preserved in that URL.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of user IDs | Only events created by these users |
+| `board_ids[]` | array of board IDs | Only events on these boards |
+
+Both filters are optional and can be combined. Multiple IDs within a filter are alternatives; when both filters are provided, events must match both. Empty lists do not restrict results. Inaccessible or unknown board IDs never grant access to additional activity.
+
+```bash
+curl --get \
+  -H "Authorization: Bearer put-your-access-token-here" \
+  --data-urlencode "creator_ids[]=03f5v9zjw7pz8717a4no1h8a7" \
+  --data-urlencode "board_ids[]=03f5v9zkft4hj9qq0lsn9ohcm" \
+  http://app.fizzy.localhost:3006/897362094/activities.json
+```
+
+### Event fields
+
+Each item in the array contains:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action, listed below |
+| `created_at` | Creation timestamp in UTC, in ISO 8601 format |
+| `description` | The event's plain-text description for the current user |
+| `particulars` | Event-specific details, described below |
+| `url` | Opens the card; for comments, opens the card and jumps to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation of the event creator |
+
+### Actions and particulars
+
+The activity feed mirrors the HTML timeline, except that it omits deprecated `card_collection_changed` events and includes `card_title_changed` events.
+
+| Action | `particulars` |
+|--------|---------------|
+| `card_assigned`, `card_unassigned` | `{"assignee_ids": ["user_id"]}` |
+| `card_board_changed` | `{"old_board": "Previous board name", "new_board": "New board name"}` |
+| `card_title_changed` | `{"old_title": "Previous title", "new_title": "New title"}` |
+| `card_triaged` | `{"column": "Column name"}` |
+| `card_published`, `card_closed`, `card_reopened` | `{}` |
+| `card_postponed`, `card_auto_postponed`, `card_sent_back_to_triage` | `{}` |
+| `comment_created` | `{}` |
+
+Missing or null board names, titles, and column names in `particulars` are returned as empty strings. Internal event details are not exposed for other actions.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..21b04cd
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns account activity as a flat JSON array" do
+    get "#{accounts('37s').slug}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_not_empty response.parsed_body
+  end
+
+  test "card activity includes the existing API representations and a plain text description" do
+    event = events(:logo_published)
+
+    get activities_path, as: :json
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_not_includes activity["description"], "<span"
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.eventable), as: :json
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board), as: :json
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator), as: :json
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the card with the comment anchor" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path, as: :json
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or other actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+
+    actions.each do |action|
+      eventable = action == "comment_created" ? events(:layout_commented).eventable : cards(:logo)
+      create_activity action, eventable: eventable
+    end
+    %w[ card_collection_changed card_resumed card_unknown ].each { |action| create_activity action }
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_response :success
+    assert_equal actions.sort, response.parsed_body.map { |item| item["action"] }.sort
+  end
+
+  test "returns newest activity first with stable ordering for simultaneous events" do
+    activity = [
+      create_activity("card_published", created_at: 2.hours.ago),
+      create_activity("card_published", created_at: 1.hour.ago),
+      create_activity("card_published", created_at: 1.hour.ago)
+    ]
+    activity.last.update!(created_at: activity.second.created_at)
+    expected_ids = activity.sort_by { |event| [ event.created_at, event.id ] }.reverse.map(&:id)
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_equal expected_ids, response.parsed_body.pluck("id")
+  end
+
+  test "assignment changes expose assignee ids" do
+    assignee_ids = [ users(:david).id, users(:kevin).id ]
+    %w[ card_assigned card_unassigned ].each do |action|
+      create_activity action, particulars: { assignee_ids: assignee_ids }
+    end
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_equal 2, response.parsed_body.size
+    response.parsed_body.each do |activity|
+      assert_equal({ "assignee_ids" => assignee_ids }, activity["particulars"])
+    end
+  end
+
+  test "board title and triage changes expose flattened particulars" do
+    details_by_action = {
+      "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }
+    details_by_action.each do |action, details|
+      create_activity action, particulars: { particulars: details, ignored: "Not exposed" }
+    end
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_equal 3, response.parsed_body.size
+    response.parsed_body.each do |activity|
+      assert_equal details_by_action.fetch(activity["action"]), activity["particulars"]
+    end
+  end
+
+  test "missing and null board title and column particulars become empty strings" do
+    keys_by_action = {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }
+    keys_by_action.each do |action, keys|
+      create_activity action, particulars: {}
+      create_activity action, particulars: { particulars: keys.index_with { nil } }
+    end
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_equal 6, response.parsed_body.size
+    response.parsed_body.each do |activity|
+      assert_equal keys_by_action.fetch(activity["action"]).index_with { "" }, activity["particulars"]
+    end
+  end
+
+  test "other actions expose an empty particulars object even if internal details are present" do
+    create_activity "card_closed", particulars: { assignee_ids: [ users(:david).id ], particulars: { column: "Ignored" } }
+
+    get activities_path(creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_equal({}, response.parsed_body.sole["particulars"])
+  end
+
+  test "filters by creator ids" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ events(:text_published).id, events(:shipping_published).id, events(:shipping_closed).id ].sort,
+      response.parsed_body.pluck("id").sort
+  end
+
+  test "filters by multiple board ids" do
+    private_card = create_private_card
+    public_activity = create_activity "card_published"
+    private_activity = create_activity "card_published", eventable: private_card
+
+    get activities_path(board_ids: [ boards(:writebook).id, boards(:private).id ], creator_ids: [ users(:jz).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ public_activity.id, private_activity.id ].sort, response.parsed_body.pluck("id").sort
+  end
+
+  test "combines board and multiple creator filters" do
+    private_card = create_private_card
+    jasons_activity = create_activity "card_published", eventable: private_card
+    davids_activity = create_activity "card_published", eventable: private_card, creator: users(:david)
+    create_activity "card_published"
+
+    get activities_path(board_ids: [ boards(:private).id ], creator_ids: [ users(:jz).id, users(:david).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ jasons_activity.id, davids_activity.id ].sort, response.parsed_body.pluck("id").sort
+  end
+
+  test "only returns accessible activity even when inaccessible boards are requested" do
+    private_card = create_private_card
+    private_activity = create_activity "card_published", eventable: private_card
+    other_account_activity = create_activity "card_published", eventable: cards(:radio), creator: users(:mike)
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_activity.id
+    assert_not_includes response.parsed_body.pluck("id"), other_account_activity.id
+
+    get activities_path(board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ]), as: :json
+    assert_response :success
+    assert_empty response.parsed_body
+
+    get activities_path(board_ids: [ boards(:writebook).id, boards(:private).id, boards(:miltons_wish_list).id ]), as: :json
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "unknown filter ids return no activity" do
+    %i[ board_ids creator_ids ].each do |filter|
+      get activities_path(filter => [ ActiveRecord::Type::Uuid.generate ]), as: :json
+
+      assert_response :success
+      assert_empty response.parsed_body
+    end
+  end
+
+  test "empty filter lists do not restrict activity" do
+    get activities_path(board_ids: [], creator_ids: []), as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.count, response.parsed_body.size
+  end
+
+  test "users with no accessible boards receive an empty array" do
+    users(:kevin).accesses.delete_all
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates newest first and preserves filters in next links" do
+    activity = 40.times.map do |index|
+      create_activity "card_published", created_at: 1.day.ago + index.minutes
+    end
+    create_activity "card_collection_changed"
+
+    expected_ids = activity.reverse.map(&:id)
+    actual_ids = []
+    page_count = 0
+    next_page = activities_path(format: :json, creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ])
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "supports bearer token authentication" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  test "rejects invalid bearer tokens" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+
+    assert_response :unauthorized
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+
+    def create_private_card
+      Current.set(user: users(:kevin)) do
+        boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: "published")
+      end
+    end
+
+    def create_activity(action, eventable: cards(:logo), creator: users(:jz), **attributes)
+      Event.create! action: action, eventable: eventable, board: eventable.card.board, creator: creator, **attributes
+    end
+end
