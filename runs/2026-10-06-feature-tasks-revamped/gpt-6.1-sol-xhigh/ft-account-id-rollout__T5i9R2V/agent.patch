diff --git a/config/initializers/account_owned_storage.rb b/config/initializers/account_owned_storage.rb
new file mode 100644
index 0000000..3bab25e
--- /dev/null
+++ b/config/initializers/account_owned_storage.rb
@@ -0,0 +1,30 @@
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record&.account }
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  attr_accessor :account_owner
+
+  belongs_to :account, default: -> { account_owner&.account || Current.account }
+
+  # Inline uploads (including generated previews/variants) belong to the attached record,
+  # which need not belong to the account currently serving the request.
+  singleton_class.prepend(Module.new do
+    def build_after_unfurling(record: nil, **attributes)
+      super(record: record, **attributes).tap do |blob|
+        if record&.respond_to?(:account)
+          blob.account_owner = record
+          blob.account = record.account
+        end
+      end
+    end
+  end)
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account }
+end
