+        "webhook_delinquency_trackers" => { webhook_id: webhook },
+        "webhook_deliveries" => { webhook_id: webhook },
+        "assignees_filters" => { filter_id: filter }, "assigners_filters" => { filter_id: filter },
+        "boards_filters" => { filter_id: filter }, "closers_filters" => { filter_id: filter },
+        "creators_filters" => { filter_id: filter }, "filters_tags" => { filter_id: filter },
+        "entropies" => { container_type: "Account", container_id: account },
+        "storage_totals" => { owner_type: "Board", owner_id: board },
+        "mentions" => { source_type: "Comment", source_id: comment },
+        "reactions" => { reactable_type: "Card", reactable_id: card },
+        "action_text_rich_texts" => { record_type: "Comment", record_id: comment }
+      }.each do |table, attributes|
+        insert(table, **attributes)
+        insert(table) # Missing parent, including rows in join tables without primary keys.
+      end
+    end
+
+    bad_account = uuid
+    orphan_user = insert("users", account_id: nil)
+    orphan_board = insert("boards", account_id: nil, creator_id: orphan_user)
+    insert("cards", account_id: nil, board_id: orphan_board)
+    insert("tags", account_id: bad_account)
+    insert("entropies", container_type: "Unknown", container_id: tenants.first)
+    @search_tables.each { |table| insert(table, account_id: bad_account) }
+    global_identity = insert("identities")
+
+    migrate
+
+    tables = NEW_TABLES - %w[active_storage_blobs active_storage_attachments active_storage_variant_records]
+    (tables + %w[users boards cards comments filters webhooks]).each do |table|
+      assert_equal tenants.sort, account_ids(table).sort, table
+    end
+    assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM tags")
+    @search_tables.each { |table| assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM #{table}") }
+    assert_equal global_identity, ids("identities").first
+  end
