+  def test_storage_ownership_follows_rich_text_previews_and_variants
+    account = insert("accounts")
+    board = insert("boards", account_id: account)
+    card = insert("cards", account_id: account, board_id: board)
+    rich_text = insert("action_text_rich_texts", record_type: "Card", record_id: card)
+    original = insert("active_storage_blobs")
+    insert("active_storage_attachments", record_type: "ActionText::RichText", record_id: rich_text, blob_id: original)
+    preview = insert("active_storage_blobs")
+    insert("active_storage_attachments", record_type: "ActiveStorage::Blob", record_id: original, blob_id: preview)
+    variant = insert("active_storage_variant_records", blob_id: preview)
+    representation = insert("active_storage_blobs")
+    insert("active_storage_attachments", record_type: "ActiveStorage::VariantRecord", record_id: variant, blob_id: representation)
+    insert("active_storage_blobs") # Unattached upload.
+    insert("active_storage_variant_records") # Missing source blob.
+    insert("active_storage_attachments", record_type: "Missing", record_id: card, blob_id: original)
+    insert("active_storage_attachments", record_type: "Card", record_id: card, blob_id: uuid)
+
+    migrate
+
+    assert_equal [ original, preview, representation ].sort, ids("active_storage_blobs").sort
+    assert_equal [ variant ], ids("active_storage_variant_records")
+    assert_equal [ account ] * 3, account_ids("active_storage_attachments")
+    assert_equal [ account ] * 3, account_ids("active_storage_blobs")
+  end
+
+  def test_blobs_shared_across_tenants_are_not_assigned_arbitrary_ownership
+    blob = insert("active_storage_blobs")
+    2.times do
+      account = insert("accounts")
+      card = insert("cards", account_id: account)
+      insert("active_storage_attachments", record_type: "Card", record_id: card, blob_id: blob)
+    end
+    migrate
+    assert_empty ids("active_storage_blobs")
+    assert_empty ids("active_storage_attachments")
+  end
+
+  private
+    def migrate
+      @migration.exec_migration(@connection, :up)
+    end
+
+    def uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def insert(table, **attributes)
+      @sequence += 1
+      attributes = attributes.stringify_keys
+      values = @connection.columns(table).to_h do |column|
+        value = if attributes.key?(column.name)
+          attributes[column.name]
+        elsif column.name == "id" || column.type == :uuid
+          uuid
+        elsif !column.null && column.default.nil?
+          case column.type
+          when :datetime then Time.current
+          when :integer, :bigint then @sequence
+          when :boolean then false
+          else "fixture"
+          end
+        else
+          column.default
+        end
+        value = ActiveRecord::Type::Uuid.new.serialize(value) if column.type == :uuid
+        [ column.name, value ]
+      end
+      @connection.execute "INSERT INTO #{table} (#{values.keys.join(', ')}) VALUES (#{values.values.map { |value| @connection.quote(value) }.join(', ')})"
+      attributes["id"] || (@connection.columns(table).any? { |column| column.name == "id" } && ActiveRecord::Type::Uuid.new.deserialize(values["id"]))
+    end
+
+    def account_ids(table)
+      @connection.select_values("SELECT account_id FROM #{table}").map { |id| ActiveRecord::Type::Uuid.new.deserialize(id) }
+    end
+
+    def ids(table)
+      @connection.select_values("SELECT id FROM #{table}").map { |id| ActiveRecord::Type::Uuid.new.deserialize(id) }
+    end
+end
