diff --git a/test/migrations/complete_account_id_rollout_test.rb b/test/migrations/complete_account_id_rollout_test.rb
new file mode 100644
index 0000000..fe0ff31
--- /dev/null
+++ b/test/migrations/complete_account_id_rollout_test.rb
@@ -0,0 +1,223 @@
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../../config/environment"
+require "minitest/autorun"
+require_relative "../../db/migrate/20260710120000_complete_account_id_rollout"
+
+# A separate connection lets us exercise the legacy schema without migrating the test database.
+class AccountRolloutDatabase < ActiveRecord::Base
+  self.abstract_class = true
+end
+
+class CompleteAccountIdRolloutTest < Minitest::Test
+  NEW_TABLES = %w[
+    accesses assignments board_publications card_activity_spikes card_goldnesses card_not_nows
+    closures pins search_queries taggings user_settings watches webhook_delinquency_trackers
+    webhook_deliveries assignees_filters assigners_filters boards_filters closers_filters
+    creators_filters filters_tags entropies storage_totals mentions reactions action_text_rich_texts
+    active_storage_attachments active_storage_blobs active_storage_variant_records
+  ].freeze
+  EXISTING_TABLES = %w[
+    users tags account_join_codes account_imports account_cancellations exports storage_entries boards
+    cards columns comments steps events filters notification_bundles notifications push_subscriptions webhooks
+  ].freeze
+  GLOBAL_TABLES = %w[accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys].freeze
+
+  def setup
+    AccountRolloutDatabase.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = AccountRolloutDatabase.connection
+    source = ActiveRecord::Base.connection
+    @search_tables = source.tables.grep(/\Asearch_records(?:_\d+)?\z/)
+    @sequence = 0
+
+    (NEW_TABLES + EXISTING_TABLES + GLOBAL_TABLES + @search_tables).each do |table|
+      @connection.create_table(table, id: false) do |definition|
+        source.columns(table).each do |column|
+          next if column.name == "account_id" && NEW_TABLES.include?(table)
+          definition.column column.name, column.type, limit: column.limit,
+            default: column.default, null: column.null || (column.name == "account_id" && (EXISTING_TABLES - %w[account_cancellations exports storage_entries]).include?(table))
+        end
+      end
+    end
+
+    @search_tables.each { |table| @connection.add_index table, :account_id }
+    @connection.add_index :cards, [ :account_id, :number ], unique: true
+    @connection.add_index :users, [ :account_id, :identity_id ], unique: true
+    @migration = CompleteAccountIdRollout.new
+    @migration.verbose = false
+  end
+
+  def teardown
+    AccountRolloutDatabase.remove_connection
+  end
+
+  def test_every_owned_table_has_a_required_indexed_uuid_account_id
+    migrate
+    (NEW_TABLES + EXISTING_TABLES + @search_tables).each do |table|
+      column = @connection.columns(table).find { |column| column.name == "account_id" }
+      assert_equal :uuid, column.type, table
+      refute column.null, table
+      assert @connection.indexes(table).any? { |index| index.columns.first == "account_id" }, table
+      assert_raises(ActiveRecord::NotNullViolation, table) { insert(table, account_id: nil) }
+    end
+    GLOBAL_TABLES.each do |table|
+      refute @connection.column_exists?(table, :account_id), table
+    end
+    refute @connection.index_exists?(:cards, :account_id)
+    refute @connection.index_exists?(:users, :account_id)
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.exec_migration(@connection, :down) }
+  end
+
+  def test_backfills_both_tenants_and_drops_unaccounted_rows
+    tenants = 2.times.map { insert("accounts") }
+    tenants.each do |account|
+      user = insert("users", account_id: account)
+      board = insert("boards", account_id: nil, creator_id: user)
+      card = insert("cards", account_id: nil, board_id: board)
+      comment = insert("comments", account_id: nil, card_id: card)
+      filter = insert("filters", account_id: nil, creator_id: user)
+      webhook = insert("webhooks", account_id: nil, board_id: board)
+
+      {
+        "accesses" => { board_id: board }, "assignments" => { card_id: card },
+        "board_publications" => { board_id: board }, "card_activity_spikes" => { card_id: card },
+        "card_goldnesses" => { card_id: card }, "card_not_nows" => { card_id: card },
