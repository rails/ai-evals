+  def test_all_supported_polymorphic_parent_types_and_unknown_types
+    account = insert("accounts")
+    board = insert("boards", account_id: account)
+    card = insert("cards", account_id: account, board_id: board)
+    comment = insert("comments", account_id: account, card_id: card)
+    {
+      "entropies" => [ "container", { "Account" => account, "Board" => board } ],
+      "storage_totals" => [ "owner", { "Account" => account, "Board" => board } ],
+      "mentions" => [ "source", { "Card" => card, "Comment" => comment } ],
+      "reactions" => [ "reactable", { "Card" => card, "Comment" => comment } ],
+      "action_text_rich_texts" => [ "record", { "Board" => board, "Card" => card, "Comment" => comment } ]
+    }.each do |table, (association, parents)|
+      parents.each { |type, id| insert(table, **{ "#{association}_type" => type, "#{association}_id" => id }) }
+      insert(table, **{ "#{association}_type" => "Unknown", "#{association}_id" => card })
+    end
+    migrate
+    %w[entropies storage_totals mentions reactions].each do |table|
+      assert_equal [ account, account ], account_ids(table), table
+    end
+    assert_equal [ account ] * 3, account_ids("action_text_rich_texts")
+  end
