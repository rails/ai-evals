+++ b/app/models/board/auto_postponing.rb
@@ -5,6 +5,15 @@ module Board::AutoPostponing
     before_create :set_default_auto_postpone_period
   end
 
+  def auto_postpone_all_due
+    system_user = nil
+
+    cards.active.where(last_active_at: ..auto_postpone_period.seconds.ago).find_each do |card|
+      system_user ||= account.system_user
+      card.auto_postpone(user: system_user)
+    end
+  end
+
   private
     def set_default_auto_postpone_period
       self.auto_postpone_period ||= Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days unless attribute_present?(:auto_postpone_period)
