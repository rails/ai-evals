diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..ddd3b5e 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -59,6 +59,82 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "auto postpone sweep does not join entropy settings when selecting cards" do
+    assert_no_queries_match(/SELECT ["`]cards["`]\.\*.*JOIN ["`](?:boards|accounts|entropies)["`]/) do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone includes the cutoff but excludes cards that are not yet due" do
+    freeze_time
+    cutoff = Time.current - entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update! last_active_at: cutoff
+    cards(:layout).update! last_active_at: cutoff + 1.second
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone excludes closed drafted and already postponed cards" do
+    cards(:logo).postpone
+    cards(:logo, :shipping, :unfinished_thoughts).each do |card|
+      card.update! last_active_at: 1.year.ago
+    end
+
+    assert_no_difference [ -> { Card::NotNow.count }, -> { Event.where(action: :card_auto_postponed).count } ] do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:shipping).reload.closed?
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "auto postpone honors mixed board overrides and account defaults" do
+    Card.update_all last_active_at: Time.current
+    entropies("37s_account").update! auto_postpone_period: 90.days
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+    entropies(:private_board).destroy
+    entropies(:initech_account).update! auto_postpone_period: 7.days
+
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 10.days.ago }
+    cards(:paycheck).update! last_active_at: 100.days.ago
+    recent_card = boards(:private).cards.create! title: "Recent", status: :published, last_active_at: 10.days.ago
+    due_card = boards(:private).cards.create! title: "Due", status: :published, last_active_at: 100.days.ago
+    Current.account = nil
+
+    assert_difference -> { Card.postponed.count }, +3 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert due_card.reload.postponed?
+    assert cards(:paycheck).reload.postponed?
+    assert_not recent_card.reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+    assert_equal accounts("37s").system_user, due_card.postponed_by
+    assert_equal accounts(:initech).system_user, cards(:paycheck).postponed_by
+    assert_equal accounts(:initech).system_user, cards(:paycheck).events.last.creator
+  end
+
+  test "auto postpone processes more than one batch of due cards on a board" do
+    attributes = cards(:logo).attributes.except("id", "number").merge("last_active_at" => 1.year.ago)
+    Card.insert_all! 1_001.times.map { |i| attributes.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => 1_000 + i) }
+    Card.any_instance.expects(:auto_postpone).with(user: accounts("37s").system_user).times(1_001)
+
+    Card.auto_postpone_all_due
+  end
+
+  test "auto postpone does not process the same card again on a subsequent sweep" do
+    cards(:logo).update! last_active_at: 1.year.ago
+    Card.auto_postpone_all_due
+
+    assert_no_difference [ -> { Card::NotNow.count }, -> { Event.count } ] do
+      Card.auto_postpone_all_due
+    end
+  end
+
