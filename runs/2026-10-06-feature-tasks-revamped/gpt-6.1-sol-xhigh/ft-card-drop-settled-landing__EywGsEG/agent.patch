diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..c70648c
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,310 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_triage)
+    visit_board
+  end
+
+  test "dropping a card moves it immediately into the column's sorted order" do
+    drag_card_to(dom_id(@column))
+
+    assert_equal dom_id(@column), card_column
+    assert_equal [ cards(:logo).id, @card.id ], column_card_ids(dom_id(@column)).first(2)
+    assert_equal 1, page.evaluate_script("window.cardMoveRequests.length")
+    assert_nil @card.reload.column
+
+    release_move_requests
+    assert_equal @column, @card.reload.column
+    assert_equal [ cards(:logo).id, @card.id ], column_card_ids(dom_id(@column)).first(2)
+
+    visit_board
+    assert_equal [ cards(:logo).id, @card.id ], column_card_ids(dom_id(@column)).first(2)
+  end
+
+  test "native dragging moves a card" do
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)}"))
+
+    assert_equal dom_id(@column), card_column
+    release_move_requests
+    assert_equal @column, @card.reload.column
+  end
+
+  test "cards can move between every status, including out of Done and Not Now" do
+    review = columns(:writebook_review)
+    original_closed_count = column_count("closed-cards")
+    [ dom_id(review), "closed-cards", "not-now", "maybe", "closed-cards", dom_id(review) ].each do |target|
+      count = column_count(target)
+      drag_card_to(target)
+      assert_equal target, card_column
+      assert_equal count + 1, column_count(target)
+      assert_equal @card.id, column_card_ids(target).first
+      release_move_requests
+
+      case target
+      when "closed-cards"
+        assert @card.reload.closed?
+        assert_selector "##{dom_id(@card, :article)} .card__closed-title", text: "Done", visible: :all
+      when "not-now"
+        assert @card.reload.postponed?
+        assert_nil @card.column
+        assert_selector "##{dom_id(@card, :article)}.card--postponed .card__closed-title", text: "Not Now", visible: :all
+      when "maybe"
+        assert @card.reload.awaiting_triage?
+        assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+      else
+        assert @card.reload.active?
+        assert_equal review, @card.column
+        assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+        assert_no_selector "##{target} .blank-slate", visible: :all
+      end
+    end
+    assert_equal 0, column_count("maybe")
+    assert_equal original_closed_count, column_count("closed-cards")
+    assert_equal 0, column_count("not-now")
+  end
+
+  test "golden cards lead active columns but do not lead status columns" do
+    @card = cards(:logo)
+    progress = columns(:writebook_in_progress)
+    drag_card_to(dom_id(progress))
+    assert_equal @card.id, column_card_ids(dom_id(progress)).first
+    release_move_requests
+
+    drag_card_to("not-now")
+    release_move_requests
+    @card = cards(:buy_domain)
+    drag_card_to("not-now")
+    assert_equal [ @card.id, cards(:logo).id ], column_card_ids("not-now")
+    release_move_requests
+    visit_board
+    assert_equal [ @card.id, cards(:logo).id ], column_card_ids("not-now")
+  end
+
+  test "an ordinary card follows an entirely golden destination" do
+    cards(:text).gild
+    visit_board
+    progress = columns(:writebook_in_progress)
+
+    drag_card_to(dom_id(progress))
+    assert_equal [ cards(:text).id, @card.id ], column_card_ids(dom_id(progress))
+    release_move_requests
+    visit_board
+    assert_equal [ cards(:text).id, @card.id ], column_card_ids(dom_id(progress))
+  end
+
+test "rapid drops are immediate and save in drop order" do
+  review = dom_id(columns(:writebook_review))
+  first = @card
+  drag_card_to(review)
+  @card = cards(:text)
+  drag_card_to(review)
+
+  assert_equal [ @card.id, first.id ], column_card_ids(review)
+  assert_equal 1, page.evaluate_script("window.cardMoveRequests.length")
+  assert_nil first.reload.column
+  assert_equal columns(:writebook_in_progress), @card.reload.column
+
+  page.execute_script("window.cardMoveRequests[0].release()")
+  assert_selector "##{review} [data-drag-and-drop-saving]", count: 1, visible: :all
+  assert_equal 2, page.evaluate_script("window.cardMoveRequests.length")
+  release_move_requests
+
+  visit_board
+  assert_equal [ @card.id, first.id ], column_card_ids(review)
+end
+
+  test "same-column drops do not reorder or save" do
+    @card = cards(:layout)
+    original = column_card_ids(dom_id(@column))
+    drag_card_to(dom_id(@column))
+
+    assert_equal original, column_card_ids(dom_id(@column))
+    assert_equal 0, page.evaluate_script("window.cardMoveRequests.length")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "drag styles follow the pointer and are cleared on cancellation" do
+    start_drag_over(dom_id(@column))
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+
+    page.execute_script <<~JS
+      document.getElementById("not-now").dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.cardDragData }))
+    JS
+    assert_no_selector "##{dom_id(@column)}.drag-and-drop__hover-container", visible: :all
+    assert_selector "#not-now.drag-and-drop__hover-container"
+
+    page.execute_script("document.getElementById('#{dom_id(@card, :article)}').dispatchEvent(new DragEvent('dragend', { bubbles: true }))")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_equal "maybe", card_column
+    assert_equal 0, page.evaluate_script("window.cardMoveRequests.length")
+  end
+
+  test "external drops and drops outside columns are ignored" do
+    page.execute_script("document.getElementById('#{dom_id(@column)}').dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))")
+    drag_card_to("cards_container")
+    assert_equal "maybe", card_column
+    assert_equal 0, page.evaluate_script("window.cardMoveRequests.length")
+  end
+
+  test "failed and disconnected saves restore the exact card and column counts" do
+    @card = cards(:layout)
+    original_order = column_card_ids(dom_id(@column))
+    original_html = page.evaluate_script("document.getElementById('#{dom_id(@card, :article)}').outerHTML")
+    original_count = column_count(dom_id(@column))
+    review = dom_id(columns(:writebook_review))
+
+    [ "request.resolve(new Response(null, { status: 500 }))", "request.reject(new TypeError('Network disconnected'))" ].each do |failure|
+      drag_card_to(review)
+      assert_equal review, card_column
+      assert_equal original_count - 1, column_count(dom_id(@column))
+      assert_equal 1, column_count(review)
+      page.execute_script("const request = window.cardMoveRequests.at(-1); #{failure}")
+      assert_no_selector "[data-drag-and-drop-saving]", visible: :all
+
+      assert_equal dom_id(@column), card_column
+      assert_equal original_order, column_card_ids(dom_id(@column))
+      assert_equal original_count, column_count(dom_id(@column))
+      assert_equal 0, column_count(review)
+      assert_equal original_html, page.evaluate_script("document.getElementById('#{dom_id(@card, :article)}').outerHTML")
+      assert_match "couldn't be moved", page.evaluate_script("window.cardMoveError")
+    end
+  end
+
+  test "in-flight frame renders and morphs cannot undo a pending move" do
+    drag_card_to(dom_id(@column))
+    assert_equal dom_id(@column), card_column
+    assert page.evaluate_script(<<~JS, dom_id(@column))
+      (() => {
+        const column = document.getElementById(arguments[0])
+        const event = new CustomEvent("turbo:before-morph-element", { bubbles: true, cancelable: true, detail: { newElement: column.cloneNode(true) } })
+        column.dispatchEvent(event)
+        return event.defaultPrevented
+      })()
+    JS
+    page.execute_script <<~JS, dom_id(@column, :cards)
+      const frame = document.getElementById(arguments[0])
+      const replacement = frame.cloneNode(false)
+      const event = new CustomEvent("turbo:before-frame-render", { bubbles: true, detail: { render: (current, incoming) => current.replaceChildren(...incoming.childNodes) } })
+      frame.dispatchEvent(event)
+      event.detail.render(frame, replacement)
+    JS
+    assert_equal dom_id(@column), card_column
+    assert_equal 1, page.evaluate_script("window.cardMoveRequests.length")
+    release_move_requests
+    assert_equal @column, @card.reload.column
+  end
+
+test "stale frame responses are ignored even after the save finishes" do
+  page.execute_script <<~JS, dom_id(@column, :cards)
+    const frame = document.getElementById(arguments[0])
+    frame.setAttribute("busy", "")
+    frame.dispatchEvent(new CustomEvent("turbo:before-fetch-request", { bubbles: true }))
+  JS
+  drag_card_to(dom_id(@column))
+  release_move_requests
+  assert_equal @column, @card.reload.column
+
+  page.execute_script <<~JS, dom_id(@column, :cards)
+    const frame = document.getElementById(arguments[0])
+    const replacement = frame.cloneNode(false)
+    const event = new CustomEvent("turbo:before-frame-render", { bubbles: true, detail: {} })
+    frame.dispatchEvent(event)
+    event.detail.render(frame, replacement)
+    frame.removeAttribute("busy")
+  JS
+  assert_equal dom_id(@column), card_column
+
+  # The next, fresh response must still be allowed to render.
+  page.execute_script <<~JS, dom_id(@column, :cards)
+    const frame = document.getElementById(arguments[0])
+    frame.dispatchEvent(new CustomEvent("turbo:before-fetch-request", { bubbles: true }))
+    const replacement = frame.cloneNode(true)
+    const marker = document.createElement("div")
+    marker.id = "fresh-frame-marker"
+    replacement.append(marker)
+    const event = new CustomEvent("turbo:before-frame-render", { bubbles: true, detail: {} })
+    frame.dispatchEvent(event)
+    event.detail.render(frame, replacement)
+  JS
+  assert_selector "#fresh-frame-marker", visible: :all
+  assert_equal dom_id(@column), card_column
+end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      @board.columns.each do |column|
+        assert_selector "##{dom_id(column, :cards)}[complete]", visible: :all
+      end
+      %w[not_now_column closed_column].each do |frame|
+        assert_selector "turbo-frame##{frame}[complete]", visible: :all
+      end
+      hold_move_requests
+    end
+
+    def hold_move_requests
+      page.execute_script <<~JS
+        window.cardMoveRequests = []
+        window.alert = message => window.cardMoveError = message
+        const originalFetch = window.fetch
+        window.fetch = (url, options = {}) => {
+          if (["POST", "DELETE"].includes(options.method) && url.toString().includes("/cards/")) {
+            return new Promise((resolve, reject) => {
+              const request = { url, options, resolve, reject, release: () => {
+                if (!request.released) {
+                  request.released = true
+                  originalFetch(url, options).then(resolve, reject)
+                }
+              } }
+              window.cardMoveRequests.push(request)
+            })
+          }
+          return originalFetch(url, options)
+        }
+      JS
+    end
+
+    def start_drag_over(column_id)
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        window.cardDragData = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: window.cardDragData }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.cardDragData }))
+      JS
+    end
+
+    def drag_card_to(column_id)
+      start_drag_over(column_id)
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: window.cardDragData }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: window.cardDragData }))
+      JS
+    end
+
+    def card_column
+      page.evaluate_script("document.getElementById('#{dom_id(@card, :article)}').closest('section.cards').id")
+    end
+
+    def column_card_ids(column_id)
+      page.evaluate_script("Array.from(document.querySelectorAll('##{column_id} article.card')).map(card => card.id.replace('article_card_', ''))")
+    end
+
+    def column_count(column_id)
+      page.evaluate_script("Number(document.querySelector('##{column_id} [data-card-count]').dataset.cardCount)")
+    end
+
+    def release_move_requests
+      page.execute_script("window.cardMoveRequests.forEach(request => request.release())")
+      assert_no_selector "[data-drag-and-drop-saving]", visible: :all
+    end
+end
