diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..da986d3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,287 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { userName: String }
+
+  #draggedCard
+  #hoverColumn
+  #moves = new Set()
+  #saveQueue = Promise.resolve()
+  #staleFrames = new WeakSet()
+
+  cardTargetConnected(card) {
+    card.draggable = !card.hasAttribute("data-drag-and-drop-saving")
+  }
+
+  disconnect() {
+    this.end()
+    this.cardTargets.forEach(card => card.removeAttribute("draggable"))
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!this.cardTargets.includes(card) || card.hasAttribute("data-drag-and-drop-saving")) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedCard = card
+    card.classList.add(this.draggedItemClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  end() {
+    this.#draggedCard?.classList.remove(this.draggedItemClass)
+    this.#draggedCard = null
+    this.#clearHover()
+  }
+
+  over(event) {
+    const column = this.#columnFor(event.target)
+    if (this.#draggedCard && column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      if (column !== this.#hoverColumn) {
+        this.#clearHover()
+        this.#hoverColumn = column
+        column.classList.add(this.hoverContainerClass)
+      }
+    }
+  }
+
+  leave(event) {
+    if (!this.#hoverColumn?.contains(event.relatedTarget)) {
+      this.#clearHover()
+    }
+  }
+
+  drop(event) {
+    const card = this.#draggedCard
+    const target = this.#columnFor(event.target)
+    if (!card || !target) return
+
+    event.preventDefault()
+    const source = this.#columnFor(card)
+    this.end()
+
+    if (source !== target) {
+      this.#move(card, source, target)
+    }
+  }
+
+  trackFrameRequest(event) {
+    if (event.target.tagName === "TURBO-FRAME") {
+      if (this.#isMoving(this.#columnFor(event.target))) {
+        this.#staleFrames.add(event.target)
+      } else {
+        this.#staleFrames.delete(event.target)
+      }
+    }
+  }
+
+  // A frame response or another user's refresh may still describe the old location.
+  preserveMove(event) {
+    const moving = this.#isMoving(this.#columnFor(event.target))
+    if (event.type === "turbo:before-frame-render") {
+      if (moving || this.#staleFrames.has(event.target)) {
+        event.detail.render = () => {}
+      }
+    } else if (moving) {
+      event.preventDefault()
+    }
+  }
+
+  #isMoving(column) {
+    return Array.from(this.#moves).some(move => move.source === column || move.target === column)
+  }
+
+  #columnFor(element) {
+    const column = element.closest('[data-drag-and-drop-target~="column"]')
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  #clearHover() {
+    this.#hoverColumn?.classList.remove(this.hoverContainerClass)
+    this.#hoverColumn = null
+  }
+
+  async #move(card, source, target) {
+    const move = { source, target, parent: card.parentNode, next: card.nextSibling, original: card.cloneNode(true) }
+    this.#moves.add(move)
+    // Remember requests already in flight, even if they finish after the save.
+    for (const column of [ source, target ]) {
+      column.querySelectorAll("turbo-frame[busy]").forEach(frame => this.#staleFrames.add(frame))
+    }
+    card.setAttribute("data-drag-and-drop-saving", "")
+    card.draggable = false
+
+    this.#insertCard(card, target)
+    this.#updateCard(card, target)
+    this.#updateColumn(source, -1)
+    this.#updateColumn(target, 1)
+
+    try {
+      const response = await this.#saveInOrder(card, target)
+      if (!response.ok || response.redirected) throw new Error(`Card move failed: ${response.statusCode}`)
+    } catch (error) {
+      card.remove()
+      move.parent.insertBefore(move.original, move.next?.parentNode === move.parent ? move.next : null)
+      this.#updateColumn(source, 1)
+      this.#updateColumn(target, -1)
+      this.dispatch("error", { detail: { error } })
+      window.alert("This card couldn't be moved. Please try again.")
+    } finally {
+      card.removeAttribute("data-drag-and-drop-saving")
+      card.draggable = true
+      this.#moves.delete(move)
+    }
+  }
+
+  #insertCard(card, column) {
+    const cards = Array.from(column.querySelectorAll('article[data-drag-and-drop-target~="card"]'))
+    const goldenFirst = [ "column", "maybe" ].includes(column.dataset.dragAndDropStatus)
+    const next = goldenFirst && !card.classList.contains("golden-effect") ? cards.find(card => !card.classList.contains("golden-effect")) : cards[0]
+
+    // Moving counts as activity, so the card leads its group in the server's order.
+    // Insert alongside cards, not alongside the pagination frames that wrap them.
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards[cards.length - 1].after(card)
+    } else {
+      this.#listFor(column).prepend(card)
+    }
+  }
+
+  #listFor(column) {
+    let list = column.querySelector(".cards__list")
+    if (!list) {
+      list = document.createElement("div")
+      list.className = "cards__list hide-scrollbar"
+      const container = column.querySelector('turbo-frame[data-controller~="frame"]') || column.querySelector(".cards__transition-container")
+      container.append(list)
+    }
+    return list
+  }
+
+  #updateCard(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const active = [ "column", "maybe" ].includes(status)
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "not-now")
+    if (status === "closed") {
+      delete card.dataset.action
+    } else {
+      card.dataset.action = "mouseenter->navigable-list#hoverSelect"
+    }
+
+    const updatedAt = card.querySelector(".card__meta-text--updated time")
+    if (updatedAt) {
+      updatedAt.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedAt.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    }
+    card.querySelector(".bubble")?.remove()
+
+    if (status !== "closed") {
+      card.style.setProperty("--card-color", column.dataset.dragAndDropColor || "var(--color-card-default)")
+      card.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === column.dataset.dragAndDropColumnId)
+      })
+    }
+
+    card.querySelector(".card__header > .card__column-name")?.remove()
+    if (status === "column") {
+      const name = document.createElement("span")
+      name.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const label = document.createElement("span")
+      label.className = "overflow-ellipsis"
+      label.textContent = column.dataset.columnName
+      name.append(label)
+      card.querySelector(".card__header").append(name)
+    }
+
+    card.querySelector(".card__closed")?.remove()
+    if (!active) {
+      this.#addStamp(card, status === "closed" ? "Done" : "Not Now")
+    }
+  }
+
+  #addStamp(card, title) {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+    const label = document.createElement("span")
+    label.className = "card__closed-title"
+    label.dataset.text = title
+    label.textContent = title
+    const date = document.createElement("strong")
+    date.className = "card__closed-date"
+    date.textContent = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric", timeZone: "UTC" })
+    const byline = document.createElement("span")
+    byline.className = "card__closed-by-line"
+    byline.append("by ")
+    const user = document.createElement("span")
+    user.className = "card__closed-by"
+    user.textContent = this.userNameValue
+    byline.append(user)
+    stamp.append(label, date, byline)
+    card.querySelector(".card__body").append(stamp)
+  }
+
+  #updateColumn(column, change) {
+    const counter = column.querySelector("[data-card-count]")
+    const count = Number(counter.dataset.cardCount) + change
+    counter.dataset.cardCount = count
+    counter.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    counter.style.setProperty("--card-count", Math.min(column.querySelectorAll("article.card").length, 15))
+
+    const list = this.#listFor(column)
+    list.querySelectorAll(":scope > .blank-slate").forEach(placeholder => placeholder.remove())
+    if (count === 0 && column.dataset.dragAndDropStatus !== "maybe") {
+      const empty = document.createElement("div")
+      empty.className = "blank-slate blank-slate--default"
+      empty.textContent = "No cards here"
+      const drop = document.createElement("div")
+      drop.className = "blank-slate blank-slate--drag overflow-ellipsis"
+      drop.textContent = "Drag cards here"
+      list.append(empty, drop)
+    }
+  }
+
+  #saveInOrder(card, column) {
+    // Activity determines order. Serial saves keep it aligned with the drop order,
+    // even when several cards are moved before the first request finishes.
+    const saving = this.#saveQueue.then(() => this.#save(card, column))
+    this.#saveQueue = saving.catch(() => {})
+    return saving
+  }
+
+  #save(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    let url, method, body
+    switch (status) {
+      case "column":
+        url = card.dataset.cardTriageUrl
+        method = "post"
+        body = { column_id: column.dataset.dragAndDropColumnId }
+        break
+      case "maybe":
+        url = card.dataset.cardTriageUrl
+        method = "delete"
+        break
+      case "not-now":
+        url = card.dataset.cardNotNowUrl
+        method = "post"
+        break
+      case "closed":
+        url = card.dataset.cardClosureUrl
+        method = "post"
+        break
+    }
+
+    return new FetchRequest(method, url, { body, responseKind: "json" }).perform()
+  }
+}
