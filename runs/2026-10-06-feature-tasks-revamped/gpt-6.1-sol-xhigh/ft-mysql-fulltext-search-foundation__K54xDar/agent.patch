index 0000000..27a4c25
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights all occurrences case insensitively" do
+    assert_equal "<mark>Needle</mark> and <mark>NEEDLE</mark>", highlight_search_matches("Needle and NEEDLE", [ "needle" ])
+  end
+
+  test "escapes HTML in both matching and nonmatching text" do
+    assert_equal "&lt;script&gt;<mark>needle</mark>&lt;/script&gt;", highlight_search_matches("<script>needle</script>", [ "needle" ])
+    assert_equal "<mark>&lt;script&gt;</mark>", highlight_search_matches("<script>", [ "<script>" ])
+    assert_equal "&lt;script&gt;", highlight_search_matches("<script>", [])
+  end
+
+  test "treats regular expression punctuation literally and prefers longer matches" do
+    assert_equal "<mark>[a+b]</mark> <mark>needles</mark>", highlight_search_matches("[a+b] needles", [ "[a+b]", "needle", "needles" ])
+  end
+
+  test "excerpts around a match even at the end of long content" do
+    text = "Filler " * 100 + "A NEEDLE at the end"
+
+    snippet = search_excerpt(text, [ "needle" ])
+
+    assert_includes snippet, "<mark>NEEDLE</mark>"
+    assert snippet.length < 250
+  end
+
+  test "excerpts without matches remain escaped" do
+    assert_equal "&lt;script&gt;unmatched&lt;/script&gt;", search_excerpt("<script>unmatched</script>", [ "needle" ])
+  end
+end
