diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b59cd4f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+  setup do
+    sign_in_as :david
+    Current.account = accounts("37s")
+    Current.user = users(:david)
+  end
+
+  test "search finds titles case insensitively and highlights matches" do
+    get search_path, params: { q: "LoGo" }
+
+    assert_response :success
+    assert_select "a[href='#{card_path(cards(:logo))}'] mark", text: "logo"
+    assert_select ".search-result", count: 1
+    assert_select "form[action='#{search_path}'][method='get'] input[name='q'][value='LoGo']"
+  end
+
+  test "search finds visible rich text descriptions including formatting and entities" do
+    cards(:logo).update!(description: "<p>A ne<strong>edle</strong> &amp; compass</p>")
+
+    get search_path, params: { q: "needle & compass" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "needle"
+    assert_select ".search-result mark", text: "&"
+    assert_select ".search-result mark", text: "compass"
+
+    get search_path, params: { q: "strong" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "search finds comment bodies and returns each card only once" do
+    comments(:logo_agreement_jz).update!(body: "A searchneedle appears here")
+    comments(:logo_agreement_kevin).update!(body: "Another searchneedle")
+    cards(:logo).update!(title: "Searchneedle", description: "Searchneedle in the description")
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select "a[href='#{card_path(cards(:logo), anchor: dom_id(comments(:logo_agreement_jz)))}'] mark", text: "searchneedle"
+    assert_select "a[href='#{card_path(cards(:logo), anchor: dom_id(comments(:logo_agreement_kevin)))}'] mark", text: "searchneedle"
+
+    get search_path, params: { q: "appears" }
+    assert_select ".search-result", count: 1
+    assert_select ".search-result mark", text: "appears"
+  end
+
+  test "all words must match and can be found in different fields or comments" do
+    cards(:logo).update!(title: "Firstneedle", description: "Secondneedle")
+    comments(:logo_agreement_jz).update!(body: "Thirdneedle")
+    comments(:logo_agreement_kevin).update!(body: "Fourthneedle")
+    cards(:layout).update!(title: "Firstneedle only")
+
+    get search_path, params: { q: "firstneedle secondneedle thirdneedle fourthneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    get search_path, params: { q: "firstneedle missingneedle" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "results are ordered by creation time newest first not recent activity" do
+    cards(:logo).update!(title: "Searchneedle older", created_at: 2.days.ago, last_active_at: Time.current)
+    cards(:layout).update!(title: "Searchneedle newer", created_at: 1.day.ago, last_active_at: 3.days.ago)
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_equal [ cards(:layout).title, cards(:logo).title ], css_select(".search-result h2").map(&:text)
+  end
+
+  test "search only includes boards the user currently has access to" do
+    private_card = boards(:private).cards.create!(title: "Secretneedle", creator: users(:kevin), status: :published,
+      description: "Secret descriptionneedle")
+    private_comment = private_card.comments.create!(creator: users(:kevin), body: "Secret commentneedle")
+
+    %w[ secretneedle descriptionneedle commentneedle ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+
+    boards(:private).accesses.grant_to(users(:david))
+    get search_path, params: { q: "commentneedle" }
+    assert_select ".search-result", count: 1
+
+    boards(:private).accesses.revoke_from(users(:david))
+    get search_path, params: { q: "commentneedle" }
+    assert_select ".search-result", count: 0
+    assert_no_match private_comment.body.plain_text, response.body
+  end
+
+  test "search does not expose other accounts" do
+    get search_path, params: { q: "radio" }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "drafts and their descriptions and comments are excluded even for their creator" do
+    cards(:logo).update!(description: "Draftdescriptionneedle")
+    comments(:logo_agreement_jz).update!(body: "Draftcommentneedle")
+    cards(:logo).drafted!
+
+    %w[ logo draftdescriptionneedle draftcommentneedle ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "missing empty whitespace and unmatched queries have no results" do
+    [ nil, "", " \t\n ", "nonexistentneedle" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "SQL wildcards and regular expression characters are literal search terms" do
+    cards(:logo).update!(title: "Literal 100% under_score bang! path\\end [a+b] O'Reilly")
+
+    [ "100%", "_", "!", "path\\end", "[a+b]", "O'Reilly" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select ".search-result", count: 1
+      assert_select ".search-result mark", text: query
+    end
+
+    get search_path, params: { q: "' OR 1=1 --" }
+    assert_select ".search-result", count: 0
+  end
+
+  test "results and query text are escaped before highlighting" do
+    cards(:logo).update!(title: '<img src=x onerror="alert(1)"> searchneedle')
+
+    get search_path, params: { q: "searchneedle" }
+    assert_response :success
+    assert_select ".search-result img", count: 0
+    assert_select ".search-result mark", text: "searchneedle"
+    assert_includes css_select(".search-result h2").first.text, "<img"
+
+    get search_path, params: { q: "<img" }
+    assert_select ".search-result img", count: 0
+    assert_select ".search-result mark", text: "<img"
+  end
+
+  test "pagination retains the query and returns all results in newest first order" do
+    created_cards = 20.times.map do |index|
+      boards(:writebook).cards.create!(title: "Paginationneedle #{index}", status: :published, created_at: index.minutes.ago)
+    end
+
+    get search_path, params: { q: "paginationneedle" }
+    assert_response :success
+    titles = css_select(".search-result h2").map(&:text)
+    assert_equal 15, titles.size
+
+    next_link = css_select(".pagination-link").first
+    assert_includes next_link["href"], "q=paginationneedle"
+    get next_link["href"]
+    assert_response :success
+    titles.concat(css_select(".search-result h2").map(&:text))
+
+    assert_equal created_cards.map(&:title), titles
+    assert_select ".pagination-link", count: 0
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+end
