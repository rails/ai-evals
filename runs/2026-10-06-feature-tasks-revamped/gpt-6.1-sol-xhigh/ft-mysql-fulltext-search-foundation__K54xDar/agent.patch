+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,12 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split.uniq
+
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query)
+      .reverse_chronologically.preload(:board).with_rich_text_description
+
+    @matching_comments = Comment.matching_any(@terms).where(card: @page.records)
+      .with_rich_text_body.chronologically.group_by(&:card_id)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..419998a
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlight_search_matches(text, terms)
+    if terms.any?
+      pattern = /(#{search_pattern(terms)})/
+      safe_join(text.to_s.split(pattern).each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      safe_join([ text.to_s ])
+    end
+  end
+
+  def search_excerpt(text, terms)
+    text = text.to_s.squish
+    snippet = excerpt(text, search_pattern(terms), radius: 100) if terms.any?
+    highlight_search_matches(snippet || text.truncate(200), terms)
+  end
+
+  private
+    def search_pattern(terms)
+      Regexp.new(Regexp.union(terms.sort_by { |term| -term.length }).source, Regexp::IGNORECASE)
+    end
+end
