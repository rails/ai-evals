@@ -0,0 +1,30 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide margin-block-start" aria-label="Card search">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search titles, descriptions, and comments…", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="center txt-subtle">Enter a term to find cards.</p>
+  <% elsif @page.records.empty? %>
+    <p class="center txt-subtle">No cards found for “<%= @query %>”.</p>
+  <% else %>
+    <div class="margin-block-start" aria-label="Search results">
+      <%= with_manual_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
