diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..db20bfc
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,31 @@
+json.(activity, :id, :action, :eventable_type)
+json.created_at activity.created_at.utc
+json.description CGI.unescapeHTML(activity.description_for(Current.user).to_plain_text)
+json.url polymorphic_url(activity.eventable)
+
+json.particulars do
+  case activity.action
+  when "card_assigned", "card_unassigned"
+    json.assignee_ids Array(activity.assignee_ids)
+  when "card_board_changed"
+    json.old_board activity.particulars&.dig("particulars", "old_board").to_s
+    json.new_board activity.particulars&.dig("particulars", "new_board").to_s
+  when "card_title_changed"
+    json.old_title activity.particulars&.dig("particulars", "old_title").to_s
+    json.new_title activity.particulars&.dig("particulars", "new_title").to_s
+  when "card_triaged"
+    json.column activity.particulars&.dig("particulars", "column").to_s
+  else
+    json.merge!({})
+  end
+end
+
+json.eventable do
+  case activity.eventable
+  when Card then json.partial! "cards/card", card: activity.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
