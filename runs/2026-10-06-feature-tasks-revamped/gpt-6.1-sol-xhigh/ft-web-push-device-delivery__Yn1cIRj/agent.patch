@@ -0,0 +1,9 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, Net::OpenTimeout, Net::ReadTimeout, SocketError, PushSubscription::Request::UnsafeEndpoint,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(subscription, notification, payload)
+    subscription.push(payload) if subscription.user == notification.user
+  end
+end
