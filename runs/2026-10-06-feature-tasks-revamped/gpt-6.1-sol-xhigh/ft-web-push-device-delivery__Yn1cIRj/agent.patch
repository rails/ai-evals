new file mode 100644
index 0000000..90d098d
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,26 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }
+    after_update_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if user.push_subscriptions.exists?
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(subscription, self, payload)
+      end
+    end
+  end
+
+  def push_payload
+    {
+      title: ApplicationController.helpers.notification_title(self),
+      body: ApplicationController.helpers.notification_body(self),
+      tag: id,
+      data: { url: Rails.application.routes.url_helpers.polymorphic_path(self, script_name: account.slug, only_path: true) }
+    }
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..64ee4c6
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,59 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :endpoint_is_https
+
+  class << self
+    def register(attributes)
+      subscription = create_or_find_by!(endpoint_digest: Digest::SHA256.hexdigest(attributes[:endpoint].to_s)) do |record|
+        record.assign_attributes(attributes)
+      end
+      subscription.update!(attributes)
+      subscription
+    end
+
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid
+      {
+        public_key: vapid_public_key,
+        private_key: ENV["VAPID_PRIVATE_KEY"],
+        subject: ENV.fetch("BASE_URL", "https://fizzy.do")
+      }
+    end
+  end
+
+  def push(payload)
+    if self.class.configured? && user.active?
+      Request.new(message: payload.to_json,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: self.class.vapid, open_timeout: 10, read_timeout: 10, ttl: 1.day.to_i).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS push service URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS push service URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..cc61829
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+class PushSubscription::Request < WebPush::Request
+  class UnsafeEndpoint < StandardError; end
+
+  # Push service URLs come from clients, just like webhook URLs. Pin the
+  # connection to a public IP rather than letting Net::HTTP resolve it again.
+  def perform
+    ip = SsrfProtection.resolve_public_ip(uri.host)
+    raise UnsafeEndpoint, "Push endpoint must resolve to a public IP" unless ip
+
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    http.ipaddr = ip
+    http.use_ssl = true
+    http.open_timeout = @options[:open_timeout]
+    http.read_timeout = @options[:read_timeout]
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
