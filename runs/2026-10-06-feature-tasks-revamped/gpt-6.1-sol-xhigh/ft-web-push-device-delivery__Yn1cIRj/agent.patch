@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key")
+  end
+
+  test "delivers the captured payload" do
+    payload = @notification.push_payload
+    @subscription.expects(:push).with(payload)
+
+    Notification::PushJob.perform_now(@subscription, @notification, payload)
+  end
+
+  test "discards queued pushes when the device has opted out" do
+    Notification::PushJob.perform_later(@subscription, @notification, @notification.push_payload)
+    @subscription.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Notification::PushJob }
+  end
+
+  test "discards queued pushes when the notification is removed" do
+    Notification::PushJob.perform_later(@subscription, @notification, @notification.push_payload)
+    @notification.destroy!
+    PushSubscription.any_instance.expects(:push).never
+
+    assert_nothing_raised { perform_enqueued_jobs only: Notification::PushJob }
+  end
+
+  test "retries a transient push failure" do
+    @subscription.expects(:push).raises(Net::ReadTimeout)
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification::PushJob.perform_now(@subscription, @notification, @notification.push_payload)
+    end
+    assert @subscription.reload
+  end
+end
