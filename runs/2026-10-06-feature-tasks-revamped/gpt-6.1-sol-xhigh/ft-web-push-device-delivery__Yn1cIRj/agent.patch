diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..0be9a83
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,122 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "error", "details" ]
+  static values = { url: String, publicKey: String, configured: Boolean }
+
+  async connect() {
+    this.busy = true
+    this.subscriptionId = null
+    this.#render()
+
+    if (this.#supported && this.configuredValue) {
+      try {
+        this.registration = await navigator.serviceWorker.ready
+        await this.#refreshSubscription()
+      } catch (error) {
+        this.#showError(error)
+      }
+    }
+
+    this.busy = false
+    this.#render()
+  }
+
+  async toggle() {
+    if (this.busy) return
+
+    this.busy = true
+    this.errorTarget.hidden = true
+    this.#render()
+
+    try {
+      if (this.subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch (error) {
+      this.#showError(error)
+    } finally {
+      this.busy = false
+      this.#render()
+    }
+  }
+
+  async #refreshSubscription() {
+    const subscription = await this.registration.pushManager.getSubscription()
+    if (subscription && Notification.permission === "granted") {
+      const response = await get(this.urlValue, { responseKind: "json" })
+      if (!response.ok) throw new Error("Unable to check notification settings. Please try again.")
+
+      const subscriptions = await response.json
+      this.subscriptionId = subscriptions.find(device => device.endpoint === subscription.endpoint)?.id
+    }
+  }
+
+  async #enable() {
+    // Ask directly from the click handler: Safari requires a user gesture.
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    const subscription = await this.registration.pushManager.getSubscription() ||
+      await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: JSON.stringify({ push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }),
+      responseKind: "json"
+    })
+    if (!response.ok) throw new Error("Unable to turn on notifications. Please try again.")
+
+    this.subscriptionId = (await response.json).id
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Unable to turn off notifications. Please try again.")
+
+    // Keep the browser subscription: it may also be used by another Fizzy account.
+    this.subscriptionId = null
+  }
+
+  #render() {
+    const enabled = !!this.subscriptionId
+    const supported = this.#supported
+    const denied = supported && Notification.permission === "denied"
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.textContent = enabled ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.disabled = this.busy || !supported || !this.configuredValue || (denied && !enabled)
+
+    if (!this.configuredValue) {
+      this.statusTarget.textContent = "Push notifications aren't configured for this server."
+    } else if (!supported) {
+      this.statusTarget.textContent = "This browser doesn't support push notifications."
+    } else if (denied) {
+      this.statusTarget.textContent = "Notifications are blocked. Follow the instructions below to allow them."
+    } else {
+      this.statusTarget.textContent = "Notifications are off for this device."
+    }
+
+    this.detailsTargets.forEach(details => { details.hidden = enabled || (supported && !denied) })
+  }
+
+  #showError(error) {
+    this.errorTarget.textContent = error.message || "Unable to update notification settings. Please try again."
+    this.errorTarget.hidden = false
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
