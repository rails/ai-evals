+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key")
+  end
+
+  test "creating a tray notification queues a push for every device" do
+    other = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "phone-key", auth_key: "phone-auth")
+    notifications(:layout_commented_kevin).destroy!
+
+    notification = nil
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+
+    [ @subscription, other ].each do |subscription|
+      assert_enqueued_with job: Notification::PushJob, args: [ subscription, notification, notification.push_payload ]
+    end
+  end
+
+  test "a new source in an existing tray entry queues a push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "marking read or unread does not send another push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).read
+      notifications(:logo_assignment_kevin).unread
+    end
+  end
+
+  test "queued pushes retain the wording of each tray update" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_published))
+    first_payload = notification.push_payload
+    notification.update!(source: events(:logo_assignment_jz))
+    second_payload = notification.push_payload
+
+    assert_not_equal first_payload[:body], second_payload[:body]
+    [ first_payload, second_payload ].each do |payload|
+      assert_enqueued_with job: Notification::PushJob, args: [ @subscription, notification, payload ]
+    end
+  end
+
+  test "event push uses the tray wording and an account-scoped URL" do
+    notification = notifications(:layout_commented_kevin)
+    payload = notification.push_payload
+
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload[:title]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload[:body]
+    assert_equal Rails.application.routes.url_helpers.polymorphic_path(notification, script_name: notification.account.slug, only_path: true), payload[:data][:url]
+    assert_includes payload[:data][:url], "#comment_"
+  end
+
+  test "mention push uses the tray wording" do
+    notification = notifications(:logo_mentioned_david)
+    payload = notification.push_payload
+
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", payload[:title]
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload[:body]
+    assert_includes payload[:data][:url], notification.account.slug
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..50be408
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    vapid = WebPush.generate_key
+    PushSubscription.stubs(:configured?).returns(true)
+    PushSubscription.stubs(:vapid).returns(public_key: vapid.public_key, private_key: vapid.private_key, subject: "https://fizzy.example.com")
+    key = OpenSSL::PKey::EC.generate("prime256v1")
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/device", p256dh_key: Base64.urlsafe_encode64(key.public_key.to_octet_string(:uncompressed)),
+      auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)))
+    @payload = notifications(:logo_assignment_kevin).push_payload
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "sends an encrypted and VAPID-signed push to the browser endpoint" do
+    request = stub_request(:post, @subscription.endpoint).with { |req|
+      req.headers["Authorization"].start_with?("vapid ") &&
+        req.headers["Content-Encoding"] == "aes128gcm" &&
+        req.headers["Ttl"] == "86400" &&
+        !req.body.include?(@payload[:title])
+    }.to_return(status: 201)
+
+    @subscription.push(@payload)
+
+    assert_requested request
+    assert @subscription.reload
+  end
+
+  test "expired and invalid subscriptions are removed" do
+    [ 404, 410 ].each do |status|
+      subscription = @subscription.user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/device-#{status}", p256dh_key: @subscription.p256dh_key, auth_key: @subscription.auth_key)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_difference "PushSubscription.count", -1 do
+        subscription.push(@payload)
+      end
+      assert @subscription.reload
+    end
+  end
+
+  test "transient failures keep the subscription for retry" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+
+    assert_no_difference "PushSubscription.count" do
+      assert_raises WebPush::PushServiceError do
+        @subscription.push(@payload)
+      end
+    end
+  end
+
+  test "does not send pushes to deactivated users" do
+    @subscription.user.update!(active: false)
+    @subscription.push(@payload)
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "does not make requests to private push endpoints" do
+    stub_dns_resolution("127.0.0.1")
+
+    assert_raises PushSubscription::Request::UnsafeEndpoint do
+      @subscription.push(@payload)
+    end
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "requires an HTTPS endpoint without credentials" do
+    [ "http://push.example.com/device", "not a URL", "https://user:secret@push.example.com/device" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, endpoint
+      assert @subscription.errors[:endpoint].present?
+    end
+  end
+
+  test "registers long and case-sensitive endpoints without duplicates" do
+    attributes = @subscription.attributes.symbolize_keys.slice(:endpoint, :p256dh_key, :auth_key)
+    long_endpoint = "https://push.example.com/#{'x' * 1000}"
+
+    long = @subscription.user.push_subscriptions.register(attributes.merge(endpoint: long_endpoint))
+    assert_equal long_endpoint, long.endpoint
+    assert_equal long, @subscription.user.push_subscriptions.register(attributes.merge(endpoint: long_endpoint))
+
+    upper = @subscription.user.push_subscriptions.register(attributes.merge(endpoint: "https://push.example.com/DEVICE"))
+    assert_not_equal @subscription, upper
+  end
+
+  test "deleting a user deletes their subscriptions" do
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.user.destroy!
+    end
+  end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..9742870
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,218 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  driven_by :selenium, using: :headless_chrome do |options|
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+    options.add_argument("--deny-permission-prompts")
+  end
+
+  test "settings let this browser opt in and show help when permission is denied" do
+    PushSubscription.stubs(:configured?).returns(true)
+    PushSubscription.stubs(:vapid_public_key).returns(WebPush.generate_key.public_key)
+    sign_in_as users(:david)
+    visit notifications_settings_path
+
+    assert_button "Turn on notifications", disabled: false
+    click_button "Turn on notifications"
+
+    assert_text "Notifications are blocked. Follow the instructions below to allow them."
+    assert_button "Turn on notifications", disabled: true
+    assert_selector ".notifications-help[data-notifications-target='details']", visible: true
+  end
+
+  test "subscribes with the VAPID key and posts the browser's endpoint and keys" do
+    boot_controller
+    result = run_javascript <<~JS
+      await controller.connect()
+      await controller.toggle()
+      return { enabled: controller.element.classList.contains("notifications--on"),
+        body: JSON.parse(requests[0].options.body), key: Array.from(subscribeOptions.applicationServerKey),
+        userVisibleOnly: subscribeOptions.userVisibleOnly, button: controller.buttonTarget.textContent }
+    JS
+
+    assert result["enabled"]
+    assert_equal "Turn off notifications", result["button"]
+    assert_equal [ 1, 2, 3, 251, 255 ], result["key"]
+    assert result["userVisibleOnly"]
+    assert_equal({ "push_subscription" => { "endpoint" => "https://push.example.com/device", "p256dh_key" => "public-key", "auth_key" => "auth-key" } }, result["body"])
+  end
+
+  test "permission denial shows help and does not subscribe or post" do
+    boot_controller("Notification.requestPermission = async () => Notification.permission = 'denied'")
+    result = run_javascript <<~JS
+      await controller.connect()
+      await controller.toggle()
+      return { requests: requests.length, subscribed: !!window.subscribeOptions,
+        disabled: controller.buttonTarget.disabled, help: !controller.detailsTargets[0].hidden }
+    JS
+
+    assert_equal 0, result["requests"]
+    assert_not result["subscribed"]
+    assert result["disabled"]
+    assert result["help"]
+  end
+
+  test "a failed registration stays off and can be retried" do
+    boot_controller("postOk = false")
+    result = run_javascript <<~JS
+      await controller.connect()
+      await controller.toggle()
+      const failed = !controller.subscriptionId && !controller.errorTarget.hidden && !controller.buttonTarget.disabled
+      postOk = true
+      await controller.toggle()
+      return { failed, enabled: !!controller.subscriptionId, requests: requests.length }
+    JS
+
+    assert result["failed"]
+    assert result["enabled"]
+    assert_equal 2, result["requests"]
+  end
+
+  test "turning off removes only this account's device registration" do
+    boot_controller("currentSubscription = browserSubscription; Notification.permission = 'granted'; devices = [{ id: 'device-id', endpoint: browserSubscription.endpoint }]")
+    result = run_javascript <<~JS
+      await controller.connect()
+      const wasEnabled = !!controller.subscriptionId
+      await controller.toggle()
+      return { wasEnabled, enabled: !!controller.subscriptionId, request: requests.at(-1),
+        browserStillSubscribed: !!currentSubscription }
+    JS
+
+    assert result["wasEnabled"]
+    assert_not result["enabled"]
+    assert_equal "delete", result["request"]["method"]
+    assert_equal "/123/users/user-id/push_subscriptions/device-id", result["request"]["url"]
+    assert result["browserStillSubscribed"]
+  end
+
+  test "a browser subscription for another account does not opt this account in" do
+    boot_controller("currentSubscription = browserSubscription; Notification.permission = 'granted'")
+    result = run_javascript("await controller.connect(); return { enabled: !!controller.subscriptionId, requests }")
+
+    assert_not result["enabled"]
+    assert_equal [ "get" ], result["requests"].pluck("method")
+  end
+
+  test "unsupported browsers show help without accessing push APIs" do
+    boot_controller("delete window.PushManager")
+    result = run_javascript <<~JS
+      await controller.connect()
+      return { disabled: controller.buttonTarget.disabled, help: !controller.detailsTargets[0].hidden,
+        status: controller.statusTarget.textContent, requests: requests.length }
+    JS
+
+    assert result["disabled"]
+    assert result["help"]
+    assert_equal "This browser doesn't support push notifications.", result["status"]
+    assert_equal 0, result["requests"]
+  end
+
+  test "service worker displays push content and opens the account-scoped card" do
+    boot_worker
+    result = run_javascript <<~JS
+      const payload = { title: "RE: New card", body: "A comment", tag: "notification-id", data: { url: "/123/cards/42#comment_1" } }
+      worker.handlers.push({ data: { json: () => payload }, waitUntil: promise => waits.push(promise) })
+      await Promise.all(waits)
+      const notification = { data: payload.data, close() { this.closed = true } }
+      worker.handlers.notificationclick({ notification, waitUntil: promise => waits.push(promise) })
+      await Promise.all(waits)
+      return { shown, opened, closed: notification.closed }
+    JS
+
+    assert_equal "RE: New card", result["shown"]["title"]
+    assert_equal "A comment", result["shown"]["options"]["body"]
+    assert_equal "notification-id", result["shown"]["options"]["tag"]
+    assert_equal "/app-icon-192.png", result["shown"]["options"]["icon"]
+    assert_equal [ "https://fizzy.example.com/123/cards/42#comment_1" ], result["opened"]
+    assert result["closed"]
+  end
+
+  test "service worker focuses an existing card window and refuses external URLs" do
+    boot_worker
+    result = run_javascript <<~JS
+      const client = { url: "https://fizzy.example.com/123/cards/42", async focus() { this.focused = true } }
+      worker.clients.matchAll = async () => [client]
+      for (const url of ["/123/cards/42", "https://other.example.com/"]) {
+        worker.handlers.notificationclick({ notification: { data: { url }, close() {} }, waitUntil: promise => waits.push(promise) })
+        await Promise.all(waits)
+      }
+      worker.handlers.push({ data: null, waitUntil: promise => waits.push(promise) })
+      return { focused: client.focused, opened }
+    JS
+
+    assert result["focused"]
+    assert_empty result["opened"]
+  end
+
+  private
+    def browser
+      page.driver.browser
+    end
+
+    def run_javascript(code)
+      result = browser.execute_async_script <<~JS
+        const done = arguments[arguments.length - 1]
+        ;(async () => { #{code} })().then(done).catch(error => done({ javascript_error: error.stack }))
+      JS
+      assert_not result.key?("javascript_error"), result["javascript_error"]
+      result
+    end
+
+    def boot_controller(setup = "")
+      browser.navigate.to("data:text/html,<main id='controller'></main>")
+      source = Rails.root.join("app/javascript/controllers/notifications_controller.js").read
+        .gsub(/^import .*\n/, "").sub("export default class", "window.NotificationsController = class")
+      browser.execute_script <<~JS
+        window.Controller = class {}
+        window.requests = []
+        window.devices = []
+        window.postOk = true
+        window.currentSubscription = null
+        window.browserSubscription = {
+          endpoint: "https://push.example.com/device",
+          toJSON() { return { endpoint: this.endpoint, keys: { p256dh: "public-key", auth: "auth-key" } } }
+        }
+        window.Notification = { permission: "default", requestPermission: async () => Notification.permission = "granted" }
+        window.PushManager = class {}
+        Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+          ready: Promise.resolve({ pushManager: {
+            async getSubscription() { return currentSubscription },
+            async subscribe(options) { window.subscribeOptions = options; return currentSubscription = browserSubscription }
+          } })
+        } })
+        window.get = async (url, options) => { requests.push({ method: "get", url, options }); return { ok: true, json: Promise.resolve(devices) } }
+        window.post = async (url, options) => { requests.push({ method: "post", url, options }); return { ok: postOk, json: Promise.resolve({ id: "device-id" }) } }
+        window.destroy = async (url, options) => { requests.push({ method: "delete", url, options }); return { ok: true } }
+        #{source}
+        window.controller = new NotificationsController()
+        controller.element = document.getElementById("controller")
+        controller.buttonTarget = document.createElement("button")
+        controller.statusTarget = document.createElement("p")
+        controller.errorTarget = document.createElement("p")
+        controller.detailsTargets = [document.createElement("div")]
+        controller.urlValue = "/123/users/user-id/push_subscriptions"
+        controller.publicKeyValue = "AQID-_8"
+        controller.configuredValue = true
+        #{setup}
+      JS
+    end
+
+    def boot_worker
+      browser.navigate.to("data:text/html,<main></main>")
+      source = Rails.root.join("app/views/pwa/service_worker.js.erb").read.gsub(/<%.*?%>/m, "")
+      browser.execute_script <<~JS
+        window.waits = []
+        window.opened = []
+        window.worker = {
+          handlers: {},
+          location: { origin: "https://fizzy.example.com" },
+          addEventListener(name, handler) { this.handlers[name] = handler },
+          registration: { async showNotification(title, options) { window.shown = { title, options } } },
+          clients: { async matchAll() { return [] }, async openWindow(url) { opened.push(url) } }
+        }
+        ;(function(self, TurboOffline, importScripts) { #{source} })(worker, {
+          addRule() {}, handlers: { networkFirst() {}, cacheFirst() {} }, start() {}
+        }, () => {})
+      JS
+    end
+end
