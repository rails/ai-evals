+            size: Reaction::MAX_CONTENT_LENGTH, autocomplete: "off", aria: { describedby: dom_id(comment, :reaction_error) },
+            data: { reactions_target: "input", action: "input->reactions#validate" } %>
+
+      <%= form.button class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction" do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Confirm reaction</span>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#cancel" title="Cancel reaction">
+        <%= icon_tag "remove" %>
+        <span class="for-screen-reader">Cancel reaction</span>
+      </button>
+      <span id="<%= dom_id(comment, :reaction_error) %>" class="txt-small" data-reactions-target="error" role="alert"></span>
+    <% end %>
+  </div>
+</div>
