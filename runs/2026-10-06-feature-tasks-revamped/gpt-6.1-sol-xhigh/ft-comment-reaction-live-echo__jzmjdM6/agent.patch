+<div class="reactions">
+  <div id="<%= dom_id(comment, :reactions) %>" class="reactions__list">
+    <%= render comment.reactions %>
+  </div>
+
+  <div id="<%= dom_id(comment, :new_reaction) %>" class="display-contents" data-turbo-permanent data-controller="reactions"
+       data-reactions-max-length-value="<%= Reaction::MAX_CONTENT_LENGTH %>">
+    <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#open">
+      <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+      <span class="for-screen-reader">Add a reaction</span>
+    </button>
+
+    <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment),
+          class: "reaction__form", html: { hidden: true },
+          data: { reactions_target: "form", action: "turbo:submit-end->reactions#submitted keydown.esc->reactions#cancel:prevent:stop" } do |form| %>
+      <%= form.label :content, "Reaction (16 characters maximum)", for: dom_id(comment, :reaction_content), class: "for-screen-reader" %>
