--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render json: @reaction, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream do
+          render turbo_stream: turbo_stream.update([ @comment, :reaction_error ], @reaction.errors.full_messages.to_sentence), status: :unprocessable_entity
+        end
+        format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..40178e1
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,38 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "content", "removal" ]
+  static values = { creatorId: String }
+
+  connect() {
+    if (this.#ownReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.contentTarget.setAttribute("role", "button")
+      this.contentTarget.setAttribute("tabindex", "0")
+      this.contentTarget.setAttribute("aria-expanded", "false")
+      this.removalTarget.hidden = false
+    }
+  }
+
+  toggle(event) {
+    if (event.target.closest("a, button, form")) return
+
+    if (this.#ownReaction) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.contentTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+    if (this.#ownReaction) this.contentTarget.setAttribute("aria-expanded", "false")
+  }
+
+  collapseOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  get #ownReaction() {
+    return this.creatorIdValue === window.Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e9055c9
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,45 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "error" ]
+  static values = { maxLength: Number }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorTarget.textContent = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate() {
+    const content = this.inputTarget.value
+    let message = ""
+
+    if (!content.trim()) {
+      message = "Please enter a reaction."
+    } else if (Array.from(content).length > this.maxLengthValue) {
+      message = `Reactions can be at most ${this.maxLengthValue} characters.`
+    }
+
+    this.inputTarget.setCustomValidity(message)
+    this.errorTarget.textContent = message
+  }
+
+  submitted({ detail: { success, fetchResponse } }) {
+    if (success) {
+      this.cancel()
+    } else if (!fetchResponse) {
+      this.errorTarget.textContent = "Couldn't save your reaction. Please try again."
+    }
+  }
+}
