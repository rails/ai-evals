diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..39865c6
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults creator and account from the current user and comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "accepts emoji and text up to sixteen characters" do
+    [ "👍", "Thanks!", "a" * 16, "👍" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?, "Expected #{content.inspect} to be valid"
+    end
+  end
+
+  test "rejects empty and overlong reactions" do
+    [ nil, "", "   ", "a" * 17, "👍" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?, "Expected #{content.inspect} to be invalid"
+    end
+  end
+
+  test "broadcasts new reactions to the card activity stream" do
+    reaction = nil
+    broadcasts = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        reaction = @comment.reactions.create!(content: "Great!")
+      end
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(@comment, :reactions), broadcasts.first["target"]
+    assert_includes broadcasts.first.to_html, ActionView::RecordIdentifier.dom_id(reaction)
+    assert_includes broadcasts.first.to_html, "Great!"
+    assert_includes broadcasts.first.to_html, users(:kevin).name
+  end
+
+  test "broadcasts removal to the card activity stream" do
+    reaction = @comment.reactions.create!(content: "👍")
+    broadcasts = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) { reaction.destroy! }
+
+    assert_equal 1, broadcasts.size
+    assert_equal "remove", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), broadcasts.first["target"]
+  end
+
+  test "changes invalidate the cached comment" do
+    old_cache_key = @comment.cache_key_with_version
+    reaction = @comment.reactions.create!(content: "👍")
+    assert_not_equal old_cache_key, @comment.reload.cache_key_with_version
+
+    old_cache_key = @comment.cache_key_with_version
+    reaction.destroy!
+    assert_not_equal old_cache_key, @comment.reload.cache_key_with_version
+  end
+
+  test "deleting a comment deletes its reactions" do
+    @comment.reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy!
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..0786fe9
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,199 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "add cancel confirm and remove a reaction" do
+    within_reactions do
+      click_on "Add a reaction"
+      assert_no_button "Add a reaction"
+      fill_in "Reaction", with: "Never mind"
+      click_on "Cancel reaction"
+      assert_button "Add a reaction"
+      assert_no_selector "input", visible: true
+      assert_equal 0, @comment.reactions.count
+
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "👍"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "👍", count: 1
+      assert_button "Add a reaction"
+      assert_no_selector "input", visible: true
+
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Love it!"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", count: 2
+      assert_no_button "Remove this reaction"
+      find(".reaction", text: "Love it!").click
+      click_on "Remove this reaction"
+      assert_no_selector ".reaction", text: "Love it!"
+      assert_selector ".reaction", text: "👍"
+    end
+
+    assert_equal [ "👍" ], @comment.reactions.pluck(:content)
+  end
+
+  test "enforces the length limit and rejects whitespace while allowing sixteen emoji" do
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: " " * 3
+      click_on "Confirm reaction"
+      assert_text "Please enter a reaction."
+      assert_equal 0, @comment.reactions.count
+
+      fill_in "Reaction", with: "a" * 17
+      click_on "Confirm reaction"
+      assert_text "at most 16 characters"
+      assert_equal 0, @comment.reactions.count
+
+      fill_in "Reaction", with: "👍" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "👍" * 16, count: 1
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "server validation errors preserve the input and allow retry" do
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "a" * 17
+      # Bypass the client validation to exercise a rejected server submission.
+      find("input").execute_script("this.setCustomValidity('')")
+      click_on "Confirm reaction"
+      assert_text "Content is too long"
+      assert_field "Reaction", with: "a" * 17
+      assert_no_button "Add a reaction"
+
+      fill_in "Reaction", with: "Saved"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "Saved"
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "reactions persist after reloading the card" do
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Thanks!"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "Thanks!"
+    end
+
+    page.refresh
+    within_reactions do
+      assert_selector ".reaction", text: "Thanks!"
+      assert_button "Add a reaction"
+      find(".reaction", text: "Thanks!").click
+      assert_button "Remove this reaction"
+    end
+  end
+
+  test "a card refresh preserves a reaction draft" do
+    wait_for_cable_subscriptions
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Draft"
+    end
+
+    Current.user = users(:kevin)
+    @comment.card.update!(title: "Retitled while reacting")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_selector "h1", text: "Retitled while reacting"
+
+    within_reactions do
+      assert_field "Reaction", with: "Draft"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "Draft"
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "keyboard controls can cancel confirm and reveal removal" do
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Canceled"
+      find("input").send_keys :escape
+      assert_button "Add a reaction"
+      assert_equal 0, @comment.reactions.count
+
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Keyboard"
+      find("input").send_keys :enter
+      assert_selector ".reaction", text: "Keyboard"
+      find(".reaction [role=button]").send_keys :space
+      assert_button "Remove this reaction"
+      find(".reaction [role=button]").send_keys :escape
+      assert_no_button "Remove this reaction"
+    end
+  end
+
+  test "only your own reactions can be expanded for removal" do
+    @comment.reactions.create!(content: "Not mine", creator: users(:kevin))
+    visit card_url(@comment.card)
+
+    within_reactions do
+      find(".reaction", text: "Not mine").click
+      assert_no_selector ".reaction--deleteable"
+      assert_no_button "Remove this reaction"
+    end
+  end
+
+  test "other viewers see additions and removals without losing a reaction draft" do
+    wait_for_cable_subscriptions
+    using_session(:observer) do
+      sign_in_as(users(:kevin))
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+      within_reactions do
+        click_on "Add a reaction"
+        fill_in "Reaction", with: "Draft"
+      end
+    end
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Reaction", with: "Live!"
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        click_on "Confirm reaction"
+        assert_selector ".reaction", text: "Live!", count: 1
+      end
+    end
+
+    using_session(:observer) do
+      within_reactions do
+        assert_selector ".reaction", text: "Live!", count: 1
+        assert_field "Reaction", with: "Draft"
+        assert_no_selector ".reaction--deleteable"
+        assert_no_button "Remove this reaction"
+      end
+    end
+
+    within_reactions do
+      find(".reaction", text: "Live!").click
+      click_on "Remove this reaction"
+      assert_no_selector ".reaction", text: "Live!"
+    end
+
+    using_session(:observer) do
+      within_reactions do
+        assert_no_selector ".reaction", text: "Live!"
+        assert_field "Reaction", with: "Draft"
+      end
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment)} .reactions", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
