+require "test_helper"
+
+class Webhook::Delivery::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+  end
+
+  test "generic payload includes event particulars and tenant scoped URLs" do
+    @delivery.event.update!(action: "card_assigned", particulars: { assignee_ids: [ users(:kevin).id ] })
+
+    payload = Webhook::Delivery::Payload.new(@delivery).to_h
+
+    assert_equal @delivery.event.id, payload[:id]
+    assert_equal [ users(:kevin).id ], payload[:particulars]["assignee_ids"]
+    assert_includes payload[:board][:url], @delivery.account.slug
+    assert_includes payload[:card][:url], @delivery.account.slug
+  end
+
+  test "comments identify the comment and its card" do
+    @delivery.event = events(:layout_commented)
+
+    payload = Webhook::Delivery::Payload.new(@delivery).to_h
+
+    assert_equal "Comment", payload[:eventable][:type]
+    assert_equal @delivery.event.eventable_id, payload[:eventable][:id]
+    assert_equal @delivery.event.card.id, payload[:card][:id]
+    assert_includes payload[:eventable][:url], @delivery.account.slug
+  end
+
+  test "Slack uses a text payload" do
+    @webhook.url = "https://hooks.slack.com/services/T123/B456/test-token"
+
+    payload = Webhook::Delivery::Payload.new(@delivery).to_h
+
+    assert_equal [ :text ], payload.keys
+    assert_includes payload[:text], @delivery.event.card.title
+  end
+
+  test "Campfire uses a body payload" do
+    @webhook.url = "https://campfire.example.com/rooms/123/456-test/messages"
+
+    payload = Webhook::Delivery::Payload.new(@delivery).to_h
+
+    assert_equal [ :body ], payload.keys
+    assert_includes payload[:body], @delivery.event.card.title
+  end
+
+  test "Basecamp uses an escaped content payload" do
+    @webhook.url = "https://3.basecamp.com/123/integrations/test/buckets/456/chats/789/lines"
+    @delivery.event.card.title = "<script>alert('no')</script>"
+
+    payload = Webhook::Delivery::Payload.new(@delivery).to_h
+
+    assert_equal [ :content ], payload.keys
+    assert_includes payload[:content], "&lt;script&gt;"
+    assert_not_includes payload[:content], "<script>"
+  end
+end
diff --git a/test/models/webhook/delivery_dispatch_test.rb b/test/models/webhook/delivery_dispatch_test.rb
new file mode 100644
index 0000000..132052c
--- /dev/null
+++ b/test/models/webhook/delivery_dispatch_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Webhook::DeliveryDispatchTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+    stub_dns_resolution(DnsTestHelper::WEB_PUSH_PUBLIC_TEST_IP)
+  end
+
+  test "posts a signed event and records the response" do
+    post = stub_request(:post, @webhook.url).with(ipaddr: DnsTestHelper::WEB_PUSH_PUBLIC_TEST_IP).to_return(status: 201)
+
+    @delivery.deliver_now
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @delivery.reload.succeeded?, @delivery.response.inspect
+    assert_equal 201, @delivery.response_summary[:code]
+    assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    assert_requested :post, @webhook.url do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @delivery.event.id, payload["id"]
+      assert_equal @delivery.event.action, payload["action"]
+      assert_equal @delivery.event.board_id, payload.dig("board", "id")
+      assert_equal @delivery.event.card.id, payload.dig("card", "id")
+      assert_includes payload.dig("eventable", "url"), @delivery.account.slug
+      assert_equal @delivery.id, request.headers["X-Webhook-Id"]
+      assert_equal @delivery.event.created_at.utc.iso8601(3), request.headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      true
+    end
+  end
+
+  test "duplicate workers and job replays do not issue another POST" do
+    stale_delivery = Webhook::Delivery.find(@delivery.id)
+    post = stub_request(:post, @webhook.url).to_return do
+      stale_delivery.deliver_now
+      { status: 200 }
+    end
+
+    @delivery.deliver_now
+    stale_delivery.deliver_now
+    @delivery.deliver_now
+
+    assert_requested post, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "a non-success HTTP status is logged without retries" do
+    post = stub_request(:post, @webhook.url).to_return(status: 503)
+
+    2.times { @delivery.deliver_now }
+
+    assert_requested post, times: 1
+    assert @delivery.reload.completed?
+    assert @delivery.failed?
+    assert_equal 503, @delivery.response_summary[:code]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a timeout is logged without retries" do
+    post = stub_request(:post, @webhook.url).to_timeout
+
+    2.times { @delivery.deliver_now }
+
+    assert_requested post, times: 1
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response_summary[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "private targets are rejected before a POST" do
+    stub_dns_resolution("127.0.0.1", "169.254.169.254", "10.0.0.1", "::1")
+
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response_summary[:error]
+  end
+
+  test "redirects are logged but never followed" do
+    post = stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/private" })
+
+    @delivery.deliver_now
+
+    assert_requested post, times: 1
+    assert_not_requested :any, "http://127.0.0.1/private"
+    assert @delivery.reload.failed?
+    assert_equal 302, @delivery.response_summary[:code]
+  end
+
+  test "ten failed POSTs over an hour deactivate the receiver and stop further deliveries" do
+    post = stub_request(:post, @webhook.url).to_return(status: 500)
+
+    travel_to Time.current do
+      deliveries = 11.times.map do
+        event = @webhook.board.events.create!(action: "card_closed", creator: users(:david), eventable: cards(:logo))
+        event.webhook_deliveries.sole
+      end
+      deliveries.first(9).each(&:deliver_now)
+      assert @webhook.reload.active?
+
+      travel 1.hour
+      deliveries[9].deliver_now
+      assert_not @webhook.reload.active?
+      deliveries[10].deliver_now
+      assert_equal "webhook_inactive", deliveries[10].reload.response_summary[:error]
+      assert_equal 10, @webhook.reload.delinquency_tracker.consecutive_failures_count
+
+      assert_no_difference "Webhook::Delivery.count" do
+        @webhook.board.events.create!(action: "card_closed", creator: users(:david), eventable: cards(:logo))
+      end
+    end
+
+    assert_requested post, times: 10
+  end
+
+  test "a receiver deactivated after enqueue is not contacted" do
+    @webhook.deactivate
+
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.errored?
+    assert_equal "webhook_inactive", @delivery.response_summary[:error]
+    assert_nil @webhook.reload.delinquency_tracker
+  end
+
+  test "the database prevents duplicate event deliveries" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: @webhook, event: @delivery.event)
+    end
+  end
+
+  test "cleanup removes only deliveries older than seven days across accounts" do
+    travel_to Time.current.change(usec: 0) do
+      Webhook::Delivery.update_all(created_at: Time.current)
+      expired = webhook_deliveries(:errored)
+      expired.update!(created_at: 1.week.ago - 1.second)
+      boundary = webhook_deliveries(:successfully_completed)
+      boundary.update!(created_at: 1.week.ago)
+      other_account = accounts(:initech)
+      expired.update_columns(account_id: other_account.id)
+
+      assert_difference "Webhook::Delivery.count", -1 do
+        Current.without_account { Webhook::Delivery.cleanup }
+      end
+
+      assert_not Webhook::Delivery.exists?(expired.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(@delivery.id)
+    end
+  end
+
+  test "pending deliveries can recover a missed enqueue with their account context" do
+    clear_enqueued_jobs
+
+    Current.without_account { Webhook::Delivery.deliver_pending }
+
+    assert_enqueued_with(job: Webhook::DeliveryJob, args: [ @delivery ])
+    assert_equal @delivery.account.to_gid.to_s, enqueued_jobs.find { |job| job[:job] == Webhook::DeliveryJob }["account"].to_s
+  end
+end
