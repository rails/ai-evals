diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..b448ad7
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,28 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_COUNT_THRESHOLD = 10
+  FAILURE_DURATION_THRESHOLD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  # The webhook is locked by the caller so concurrent deliveries cannot lose
+  # increments or race a successful delivery's reset.
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      update! first_failure_at: first_failure_at || Time.current,
+        consecutive_failures_count: consecutive_failures_count + 1
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_COUNT_THRESHOLD &&
+      first_failure_at.present? && first_failure_at <= FAILURE_DURATION_THRESHOLD.ago
+  end
+end
