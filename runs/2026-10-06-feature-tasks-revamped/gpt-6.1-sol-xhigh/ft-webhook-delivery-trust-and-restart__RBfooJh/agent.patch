index 0000000..b58f88e
--- /dev/null
+++ b/test/jobs/webhook/delivery_job_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  test "a delivery job restores its account context and sends only once" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution(DnsTestHelper::WEB_PUSH_PUBLIC_TEST_IP)
+    post = stub_request(:post, delivery.webhook.url).to_return(status: 204)
+
+    clear_enqueued_jobs
+    Current.without_account do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        2.times { delivery.deliver_later }
+      end
+      assert_nil Current.account
+    end
+
+    assert_requested post, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "jobs for deleted deliveries are discarded" do
+    delivery = webhook_deliveries(:pending)
+    clear_enqueued_jobs
+    delivery.deliver_later
+    delivery.destroy!
+
+    assert_nothing_raised { perform_enqueued_jobs only: Webhook::DeliveryJob }
+  end
+
+  test "destroying a receiver removes its deliveries and tracker" do
+    webhook = webhooks(:active)
+    webhook.create_delinquency_tracker!
+
+    webhook.destroy!
+
+    assert_not Webhook::Delivery.where(webhook_id: webhook.id).exists?
+    assert_not Webhook::DelinquencyTracker.where(webhook_id: webhook.id).exists?
+  end
+end
diff --git a/test/models/event/webhookable_test.rb b/test/models/event/webhookable_test.rb
