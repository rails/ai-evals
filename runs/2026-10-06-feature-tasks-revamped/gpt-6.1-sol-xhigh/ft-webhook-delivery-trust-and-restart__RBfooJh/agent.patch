+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.create_delinquency_tracker!
+  end
+
+  test "ten consecutive failures over an hour disable the receiver" do
+    travel_to Time.current do
+      9.times { record(code: 500) }
+      assert @webhook.reload.active?
+      assert_equal 9, @tracker.reload.consecutive_failures_count
+
+      travel 1.hour
+      record(code: 500)
+      assert_not @webhook.reload.active?
+      assert_equal 10, @tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "ten failures in less than an hour do not disable the receiver" do
+    travel_to Time.current do
+      10.times { record(code: 500) }
+      travel 1.hour - 1.second
+      record(code: 500)
+      assert @webhook.reload.active?
+
+      travel 1.second
+      record(code: 500)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures do not disable the receiver even after an hour" do
+    travel_to Time.current do
+      record(code: 500)
+      travel 2.hours
+      8.times { record(code: 500) }
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "success resets the consecutive failure count and duration" do
+    travel_to Time.current do
+      9.times { record(code: 500) }
+      travel 2.hours
+      record(code: 204)
+      assert_equal 0, @tracker.reload.consecutive_failures_count
+      assert_nil @tracker.first_failure_at
+
+      10.times { record(code: 500) }
+      assert @webhook.reload.active?
+      assert_equal Time.current, @tracker.reload.first_failure_at
+    end
+  end
+
+  test "transport errors count as failures and unfinished deliveries do not" do
+    record(error: "destination_unreachable")
+    pending = Webhook::Delivery.new(webhook: @webhook, event: events(:layout_commented))
+    @webhook.with_lock { @tracker.record(pending) }
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "reactivation resets the failure streak" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    record(code: 500)
+    assert @webhook.reload.active?
+  end
+
+  private
+    def record(**response)
+      delivery = Webhook::Delivery.new(webhook: @webhook, event: events(:layout_commented), response: response,
+        state: response[:error] ? :errored : :completed)
+      @webhook.with_lock { @tracker.record(delivery) }
+    end
+end
