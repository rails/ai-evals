--- /dev/null
+++ b/app/models/webhook/delivery/payload.rb
@@ -0,0 +1,47 @@
+class Webhook::Delivery::Payload
+  include Rails.application.routes.url_helpers
+
+  attr_reader :delivery
+
+  delegate :event, :webhook, :account, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def to_h
+    if webhook.for_slack?
+      { text: description }
+    elsif webhook.for_campfire?
+      { body: description }
+    elsif webhook.for_basecamp?
+      { content: ERB::Util.html_escape(description) }
+    else
+      event_payload
+    end
+  end
+
+  private
+    def description
+      CGI.unescapeHTML(event.description_for(event.creator).to_plain_text)
+    end
+
+    def event_payload
+      {
+        id: event.id,
+        action: event.action,
+        created_at: event.created_at.utc.iso8601(3),
+        creator: { id: event.creator_id, name: event.creator.name },
+        board: { id: event.board_id, name: event.board.name, url: board_url(event.board) },
+        eventable: { type: event.eventable_type, id: event.eventable_id, url: polymorphic_url(event.eventable) },
+        card: { id: event.card.id, number: event.card.number, title: event.card.title, url: card_url(event.card) },
+        particulars: event.api_particulars
+      }
+    end
+
+    def default_url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      base_options.merge(script_name: account.slug)
+    end
+end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..ce89ec1
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,57 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 5
+
+  attr_reader :delivery
+
+  delegate :event, :webhook, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Id" => delivery.id,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def body
+    @body ||= Webhook::Delivery::Payload.new(delivery).to_h.to_json
+  end
+
+  def post
+    uri = URI.parse(webhook.url)
+
+    if ip = SsrfProtection.resolve_public_ip(uri.hostname)
+      # Connect only to the verified public IP, retaining the hostname for TLS
+      # verification and Host. Do not use an environment-provided HTTP proxy.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri, headers)
+      request.body = body
+
+      Timeout.timeout(TIMEOUT) do
+        response = http.request(request) do |response|
+          # Discard the response body rather than storing unbounded receiver data.
+          response.read_body { |chunk| }
+        end
+        { code: response.code.to_i }
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError,
+      Net::HTTPBadResponse, Net::ProtocolError, Resolv::ResolvError, URI::InvalidURIError
+    { error: "destination_unreachable" }
+  end
+end
