+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "a subscribed board event creates and enqueues one pending delivery" do
+    webhook = webhooks(:active)
+    delivery = nil
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      assert_enqueued_with(job: Webhook::DeliveryJob, args: ->(args) { args == [ delivery ] }) do
+        event = create_event(webhook.board)
+        delivery = event.webhook_deliveries.find_by(webhook: webhook)
+
+        assert delivery, "The board's subscribed receiver should have a delivery"
+        assert delivery.pending?
+        assert_equal event.account, delivery.account
+      end
+    end
+  end
+
+  test "only active subscribed receivers on the event's board are notified" do
+    board = boards(:writebook)
+    subscribed = board.webhooks.create!(name: "Subscribed", url: "https://example.com/subscribed", subscribed_actions: [ "card_published" ])
+    board.webhooks.create!(name: "Unsubscribed", url: "https://example.com/unsubscribed", subscribed_actions: [ "comment_created" ])
+    board.webhooks.create!(name: "Empty", url: "https://example.com/empty", subscribed_actions: [])
+    board.webhooks.create!(name: "Inactive", url: "https://example.com/inactive", active: false, subscribed_actions: [ "card_published" ])
+    webhooks(:inactive).activate
+
+    event = create_event(board)
+
+    assert_equal [ webhooks(:active).id, subscribed.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+  end
+
+  test "unsubscribed actions create no deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      create_event(boards(:writebook), action: "card_title_changed")
+    end
+  end
+
+  test "an event in another account cannot notify this account's receivers" do
+    other_board = accounts(:initech).boards.create!(name: "Another account", creator: users(:mike))
+    receiver = other_board.webhooks.create!(name: "Other", url: "https://example.com/other", subscribed_actions: [ "card_published" ])
+
+    event = Current.with_account(other_board.account) do
+      other_board.events.create!(action: "card_published", creator: users(:mike), eventable: cards(:logo))
+    end
+
+    assert_equal [ receiver.id ], event.webhook_deliveries.pluck(:webhook_id)
+    assert_equal other_board.account, event.webhook_deliveries.sole.account
+  end
+
+  test "rolling back an event also rolls back its delivery and does not enqueue" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction(requires_new: true) do
+          create_event(boards(:writebook))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "updating an event does not dispatch it again" do
+    event = create_event(boards(:writebook))
+
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        event.touch
+      end
+    end
+  end
+
+  private
+    def create_event(board, action: "card_published")
+      board.events.create!(action: action, creator: users(:david), eventable: cards(:logo))
+    end
+end
