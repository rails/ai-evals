   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def self.deliver_pending
+    pending.find_each(&:deliver_later)
+  end
+
+  def deliver_later
+    Current.with_account(account) { Webhook::DeliveryJob.perform_later(self) }
+  end
+
+  def deliver_now
+    # A database compare-and-set, not the instance's potentially stale state.
+    # Once claimed, even a job retry after an ambiguous network failure cannot
+    # issue a second POST.
+    if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload
+
+      if webhook.reload.active?
+        outgoing_request = Request.new(self)
+        update! request: { headers: outgoing_request.headers }
+        record_result(outgoing_request.post)
+      else
+        record_result({ error: "webhook_inactive" }, track: false)
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +58,18 @@ class Webhook::Delivery < ApplicationRecord
   end
 
