@@ -0,0 +1,21 @@
+class Account::Subscriptions::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Account::Plan.find(params.require(:plan_key))
+    raise ArgumentError, "Only paid plans can be purchased" unless plan.paid?
+
+    subscription = Current.account.subscription_for_checkout
+    if subscription.ongoing?
+      checkout = subscription.portal(return_url: saas.account_subscription_url)
+    else
+      checkout = subscription.checkout(plan: plan, success_url: saas.account_subscription_url, cancel_url: saas.account_subscription_url)
+    end
+    redirect_to checkout.url, allow_other_host: true, status: :see_other
+  rescue ArgumentError
+    head :unprocessable_entity
+  rescue Stripe::StripeError, KeyError => error
+    Rails.error.report(error)
+    redirect_to saas.account_subscription_path, alert: "Billing is temporarily unavailable. Please try again."
+  end
+end
