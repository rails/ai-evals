diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..228a2a7
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,48 @@
+class Account::Plan
+  STRIPE_PRICE_ENV_KEYS = {
+    "unlimited" => "STRIPE_MONTHLY_V1_PRICE_ID",
+    "unlimited_plus" => "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  }.freeze
+
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  class << self
+    def all
+      ALL
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key } || raise(ArgumentError, "Unknown plan")
+    end
+
+    def for_stripe_price(price_id)
+      all.find { |plan| plan.paid? && plan.configured_stripe_price_id.present? && plan.configured_stripe_price_id == price_id }
+    end
+  end
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+    @key = key
+    @name = name
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  def paid?
+    price_in_cents.positive?
+  end
+
+  def configured_stripe_price_id
+    ENV[STRIPE_PRICE_ENV_KEYS.fetch(key)] if paid?
+  end
+
+  def stripe_price_id
+    configured_stripe_price_id.presence || raise(KeyError, "Stripe price is not configured for #{name}")
+  end
+
+  ALL = [
+    new(key: "free", name: "Free", price_in_cents: 0, card_limit: 1000, storage_limit: 1.gigabyte),
+    new(key: "unlimited", name: "Unlimited", price_in_cents: 2000, card_limit: nil, storage_limit: 5.gigabytes),
+    new(key: "unlimited_plus", name: "Unlimited+", price_in_cents: 2500, card_limit: nil, storage_limit: 500.gigabytes)
+  ].each(&:freeze).freeze
+end
