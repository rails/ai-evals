diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..71bdfbb
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @original_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @original_price
+  end
+
+  test "admins see their plan and Upgrade in settings" do
+    get account_settings_path(script_name: @account.slug)
+    assert_response :success
+    assert_select "h2", text: "Plan: Free"
+    assert_select "a[href='#{saas.account_subscription_path(script_name: @account.slug)}']", text: "Upgrade"
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_response :success
+    assert_select "h3", text: "Unlimited — $20/month"
+    assert_select "h3", text: "Unlimited+ — $25/month"
+    assert_match "500 GB", response.body
+    assert_select "form[action='#{saas.account_subscription_checkout_path(script_name: @account.slug)}']", count: 2
+    assert_select "a[href='#{account_settings_path(script_name: @account.slug)}']", text: "Back to settings"
+  end
+
+  test "checkout uses the configured price and the current account customer" do
+    Stripe::Customer.expects(:create).with(
+      { name: @account.name, email: @account.owner_email, metadata: { account_id: @account.id } },
+      { idempotency_key: "fizzy-customer-#{@account.id}" }
+    ).returns(Stripe::Customer.construct_from(id: "cus_checkout"))
+    Stripe::Checkout::Session.expects(:create).with do |parameters|
+      assert_equal "subscription", parameters[:mode]
+      assert_equal "cus_checkout", parameters[:customer]
+      assert_equal [ { price: "price_unlimited", quantity: 1 } ], parameters[:line_items]
+      assert_equal @account.id, parameters[:subscription_data][:metadata][:account_id]
+      assert_match @account.slug, parameters[:success_url]
+      assert_match @account.slug, parameters[:cancel_url]
+      true
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/local"))
+    post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited", stripe_customer_id: "cus_other" }
+    assert_redirected_to "https://checkout.stripe.com/local"
+    assert_equal "cus_checkout", @account.reload.subscription.stripe_customer_id
+    assert_equal "Free", @account.billing_plan.name
+  end
+
+  test "existing customers are reused and paid plans go to the portal" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing", plan_key: "unlimited", status: "active")
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with do |parameters|
+      parameters[:customer] == "cus_existing" && parameters[:return_url].include?(@account.slug)
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited_plus" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "unpaid subscriptions go to the portal rather than creating another subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_unpaid", stripe_subscription_id: "sub_unpaid", plan_key: "unlimited", status: "past_due")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "customer portal uses the current account not submitted customer IDs" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing")
+    Stripe::BillingPortal::Session.expects(:create).with do |parameters|
+      parameters[:customer] == "cus_existing"
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_subscription_portal_path(script_name: @account.slug), params: { customer: "cus_other" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "invalid or free plan cannot be checked out" do
+    Stripe::Customer.expects(:create).never
+    %w[ free unknown ].each do |key|
+      post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: key }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "Stripe failures do not grant a paid plan" do
+    Stripe::Customer.expects(:create).raises(Stripe::APIConnectionError.new("offline"))
+    post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited" }
+    assert_redirected_to saas.account_subscription_path(script_name: @account.slug)
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "members cannot view or change billing" do
+    users(:mike).update!(role: :member)
+    get account_settings_path(script_name: @account.slug)
+    assert_response :success
+    assert_select "h2", text: "Plan: Free", count: 0
+    get saas.account_subscription_path(script_name: @account.slug)
+    assert_response :forbidden
+    post saas.account_subscription_checkout_path(script_name: @account.slug), params: { plan_key: "unlimited" }
+    assert_response :forbidden
+    post saas.account_subscription_portal_path(script_name: @account.slug)
+    assert_response :forbidden
+  end
+
+  test "account membership is checked before billing access" do
+    get saas.account_subscription_path
+    assert_response :redirect
+  end
+end
