diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..290acbc
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,82 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  after_save -> { account.touch }
+  after_destroy -> { account.touch }
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :plan_key, inclusion: { in: Account::Plan.all.map(&:key) }, allow_nil: true
+
+  class << self
+    def apply_stripe_event(event)
+      if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+        if subscription = find_by(stripe_customer_id: event.data.object.customer)
+          subscription.apply_stripe_event(event)
+        end
+      end
+    end
+  end
+
+  def active?
+    status.in?(%w[ active trialing ]) && plan_key.present? && Account::Plan.find(plan_key).paid?
+  end
+
+  def ongoing?
+    active? || (stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ]))
+  end
+
+  def checkout(plan:, success_url:, cancel_url:)
+    raise ArgumentError, "Only paid plans can be purchased" unless plan.paid?
+    raise ArgumentError, "Use the customer portal to change a paid subscription" if ongoing?
+
+    Stripe::Checkout::Session.create(
+      mode: "subscription", customer: stripe_customer_id,
+      client_reference_id: account_id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      subscription_data: { metadata: { account_id: account_id } },
+      success_url: success_url, cancel_url: cancel_url
+    )
+  end
+
+  def portal(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url)
+  end
+
+  def cancel
+    if stripe_subscription_id.present?
+      remote = Stripe::Subscription.cancel(stripe_subscription_id)
+      update!(status: remote.status)
+    end
+  end
+
+  def apply_stripe_event(event)
+    with_lock do
+      unless stale_stripe_event?(event)
+        remote = event.data.object
+        item = remote.items.data.first
+        update!(
+          stripe_subscription_id: remote.id,
+          status: event.type == "customer.subscription.deleted" ? "canceled" : remote.status,
+          plan_key: Account::Plan.for_stripe_price(item&.price&.id)&.key,
+          current_period_end: stripe_time(remote[:current_period_end] || item&.[](:current_period_end)),
+          cancel_at: stripe_time(remote[:cancel_at]),
+          cancel_at_period_end: remote[:cancel_at_period_end] || false,
+          last_stripe_event_created_at: event.created,
+          last_stripe_event_id: event.id
+        )
+      end
+    end
+  end
+
+  private
+    def stale_stripe_event?(event)
+      last_stripe_event_id == event.id ||
+        (last_stripe_event_created_at && event.created < last_stripe_event_created_at) ||
+        (event.type == "customer.subscription.deleted" && stripe_subscription_id.present? && stripe_subscription_id != event.data.object.id) ||
+        (status == "canceled" && stripe_subscription_id == event.data.object.id && event.type != "customer.subscription.deleted")
+    end
+
+    def stripe_time(timestamp)
+      Time.at(timestamp).utc if timestamp
+    end
+end
