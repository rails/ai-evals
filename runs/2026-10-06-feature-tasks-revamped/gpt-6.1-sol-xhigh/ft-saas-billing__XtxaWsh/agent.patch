+require "test_helper"
+
+class Account::BillingCancellationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jason
+    @account = accounts(:"37s")
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_cancel", stripe_subscription_id: "sub_cancel", plan_key: "unlimited", status: "active")
