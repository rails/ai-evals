@@ -0,0 +1,19 @@
+module Card::BillingLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      # Card creation and publication share the account lock used for card numbering.
+      # Count while holding it so concurrent requests cannot spend the last card twice.
+      Current.account.with_lock do
+        if Current.account.card_limit_reached? && !@card&.published?
+          respond_to do |format|
+            format.html { render "cards/drafts/show", status: :forbidden }
+            format.json { render json: { error: "Card limit reached. Upgrade to publish more." }, status: :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
