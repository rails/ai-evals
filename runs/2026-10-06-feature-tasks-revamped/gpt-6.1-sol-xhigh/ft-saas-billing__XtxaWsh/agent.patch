diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..1f8bc96
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,17 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    secret = ENV["STRIPE_WEBHOOK_SECRET"].presence || raise(KeyError, "Stripe webhook secret is not configured")
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+    Account::Subscription.apply_stripe_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  rescue KeyError => error
+    Rails.error.report(error)
+    head :service_unavailable
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..8cb6028
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,85 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+
+    set_callback :cancel, :before, :cancel_billing_subscription
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Account::Plan.find(subscription.plan_key)
+    elsif comped?
+      Account::Plan.find("unlimited")
+    else
+      Account::Plan.find("free")
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.ongoing?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def cards_remaining
+    if limit = billing_plan.card_limit
+      [ limit - card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    billing_plan.card_limit.present? && cards_remaining.zero?
+  end
+
+  def nearing_card_limit?
+    billing_plan.card_limit.present? && cards_remaining.between?(1, 100)
+  end
+
+  def override_usage(**usage)
+    (overridden_limit || build_overridden_limit).update!(**usage)
+  end
+
+  def reset_usage_override
+    overridden_limit&.destroy!
+    reload_overridden_limit
+  end
+
+  def subscription_for_checkout
+    with_lock do
+      subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create({
+        name: name, email: owner_email, metadata: { account_id: id }
+      }, { idempotency_key: "fizzy-customer-#{id}" }).id)
+    end
+  end
+  private
+    def cancel_billing_subscription
+      active_subscription&.cancel
+    end
+end
