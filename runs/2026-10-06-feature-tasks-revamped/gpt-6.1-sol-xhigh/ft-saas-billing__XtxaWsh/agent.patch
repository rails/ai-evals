+<% @page_title = "Plans and billing" %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings panel shadow center">
+  <h2>Your plan: <%= @account.billing_plan.name %><%= " (comped)" if @account.comped? %></h2>
+  <p><%= number_with_delimiter(@account.card_count) %> published cards · <%= number_to_human_size(@account.bytes_used) %> used</p>
+  <% if @account.subscription %>
+    <%= button_to "Manage billing", saas.account_subscription_portal_path, class: "btn", data: { turbo: false } %>
+    <% if @account.subscription.cancel_at_period_end? %>
+      <p>Your subscription ends <%= @account.subscription.current_period_end&.to_date&.to_fs(:long) %>. You'll then return to Free.</p>
+    <% end %>
+  <% end %>
+
+  <p>Checkout and billing management are securely hosted by Stripe. Your plan updates after Stripe confirms the subscription.</p>
+  <% @plans.each do |plan| %>
+    <section class="margin-block">
+      <h3><%= plan.name %> — <%= plan.paid? ? "$#{plan.price_in_cents / 100}/month" : "Free" %></h3>
+      <p><%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %> · <%= number_to_human_size(plan.storage_limit, precision: 0) %> storage</p>
+      <% if plan.paid? && !@account.subscription&.ongoing? %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_subscription_checkout_path, params: { plan_key: plan.key }, class: "btn btn--reversed", data: { turbo: false } %>
+      <% end %>
+    </section>
+  <% end %>
+  <%= link_to "Back to settings", main_app.account_settings_path %>
+</section>
