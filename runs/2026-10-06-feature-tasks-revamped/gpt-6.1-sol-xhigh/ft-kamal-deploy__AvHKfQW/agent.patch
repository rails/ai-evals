--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,56 @@
+# Single-server deployment. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    # Set your public hostname here. It is also used by the proxy and Rails below.
+    - &host fizzy.example.com
+
+# Kamal proxy obtains and renews the Let's Encrypt certificate.
+# The Dockerfile runs Thruster on port 80; TLS terminates at the proxy.
+proxy:
+  ssl: true
+  host: *host
+  app_port: 80
+
+# Kamal runs a local registry and tunnels it to the server over SSH.
+# No external registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server.
+  dockerfile: Dockerfile
+
+# All SQLite databases and uploaded files live under /rails/storage.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    # Run background and recurring jobs inside the web container.
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    APP_FQDN: *host
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USER_NAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
