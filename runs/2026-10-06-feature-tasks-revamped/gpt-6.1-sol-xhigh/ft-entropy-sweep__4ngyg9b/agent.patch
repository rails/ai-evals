--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -25,8 +25,17 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      # Resolve cutoffs before querying cards so the board/activity index can be used.
+      Board.preload(:entropy, account: :entropy).find_each do |board|
+        if auto_postpone_period = board.entropy&.auto_postpone_period
+          system_user = nil
+
+          active.where(board_id: board.id, last_active_at: ..(now - auto_postpone_period)).find_each do |card|
+            card.auto_postpone(user: system_user ||= board.account.system_user)
+          end
+        end
       end
     end
   end
