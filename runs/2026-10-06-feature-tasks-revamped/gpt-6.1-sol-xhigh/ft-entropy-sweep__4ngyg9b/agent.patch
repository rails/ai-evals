   test "postponing_soon scope works properly cross-account" do
@@ -85,4 +87,125 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due includes the cutoff but not more recently active cards" do
+    freeze_time
+
+    cutoff = Time.current - entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update!(last_active_at: cutoff)
+    cards(:layout).update!(last_active_at: cutoff + Rational(1, 1_000_000))
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone all due respects different board overrides within an account" do
+    entropies("37s_account").update!(auto_postpone_period: 3.days)
+    entropies(:private_board).update!(auto_postpone_period: 7.days)
+    cards(:logo).update!(last_active_at: 10.days.ago)
+    cards(:layout).update_columns(board_id: boards(:private).id, last_active_at: 10.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert_not cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone all due skips closed drafted and already postponed cards" do
+    cards(:logo).postpone
+    cards(:logo, :shipping, :unfinished_thoughts).each do |card|
+      card.update_columns(last_active_at: 400.days.ago)
+    end
+
+    assert_no_difference -> { Event.count } do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "auto postpone all due is idempotent" do
+    cards(:logo).update!(last_active_at: 400.days.ago)
+    Card.auto_postpone_all_due
+
+    assert_no_difference -> { Event.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due skips boards without board or account entropy" do
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").destroy!
+    cards(:logo).update!(last_active_at: 400.days.ago)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due selects cards with board-local activity cutoffs" do
+    queries = []
+    subscriber = ->(*args) do
+      payload = args.last
+      queries << payload[:sql] if payload[:name] == "Card Load"
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    assert_not_empty queries
+    queries.each do |sql|
+      assert_match(/board_id/, sql)
+      assert_match(/last_active_at.*<=/, sql)
+      assert_no_match(/JOIN.*(?:boards|accounts|entropies)/i, sql)
+    end
+  end
+
+  test "auto postpone all due processes multiple batches and reuses the system user" do
+    board = boards(:writebook)
+    now = Time.current
+    Card.insert_all!(1001.times.map do |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate, account_id: board.account_id,
+        board_id: board.id, creator_id: users(:david).id, number: index + 100,
+        title: "Due card", status: "published", last_active_at: 400.days.ago,
+        created_at: now, updated_at: now
+      }
+    end)
+
+    system_user = accounts("37s").system_user
+    Account.any_instance.expects(:system_user).returns(system_user).once
+    Card.any_instance.expects(:auto_postpone).with(user: system_user).times(1001)
+
+    Card.auto_postpone_all_due
+  end
+  test "auto postpone all due respects a board override shorter than the account default" do
+    entropies("37s_account").update!(auto_postpone_period: 365.days)
+    entropies(:writebook_board).update!(auto_postpone_period: 30.days)
+    cards(:logo).update!(last_active_at: 60.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+  end
+
+  test "auto postpone all due preserves the calling card scope" do
+    cards(:logo, :radio).each { |card| card.update!(last_active_at: 400.days.ago) }
+
+    accounts("37s").cards.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
 end
