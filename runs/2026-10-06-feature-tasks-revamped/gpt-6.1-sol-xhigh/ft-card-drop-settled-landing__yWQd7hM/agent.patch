+  private
+    def pause_saves
+      page.execute_script <<~JS
+        window.originalFetch = window.fetch
+        window.saveCount = 0
+        window.fetch = (url, options) => {
+          if (options?.method === "POST" || options?.method === "DELETE") {
+            window.saveCount++
+            window.saveRequestId = options.headers.get("X-Turbo-Request-Id")
+            return new Promise((resolve, reject) => {
+              window.finishSave = () => window.originalFetch(url, options).then(resolve, reject)
+              window.failSave = network => network ? reject(new TypeError("Network error")) : resolve(new Response("", { status: 422 }))
+            })
+          }
+          return window.originalFetch(url, options)
+        }
+      JS
+    end
+
+    def finish_save(restore: true)
+      page.evaluate_async_script <<~JS, restore
+        const restore = arguments[0]
+        const done = arguments[arguments.length - 1]
+        window.finishSave().then(() => {
+          if (restore) window.fetch = window.originalFetch
+          done()
+        })
+      JS
+    end
+
+    def fail_save(network: false, restore: true)
+      page.execute_script "window.failSave(arguments[0]); if (arguments[1]) window.fetch = window.originalFetch", network, restore
+    end
+
+    def drag_card(card, destination_id)
+      start_drag(card)
+      drag_over(destination_id)
+      page.execute_script <<~JS, destination_id
+        document.getElementById(arguments[0]).firstElementChild.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: window.dragTransfer }))
+      JS
+      end_drag(card)
+    end
+
+    def start_drag(card)
+      page.execute_script <<~JS, dom_id(card, :article)
+        window.dragTransfer = new DataTransfer()
+        document.getElementById(arguments[0]).dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.dragTransfer }))
+      JS
+    end
+
+    def drag_over(destination_id)
+      page.execute_script <<~JS, destination_id
+        document.getElementById(arguments[0]).firstElementChild.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.dragTransfer }))
+      JS
+    end
+
+    def end_drag(card)
+      page.execute_script <<~JS, dom_id(card, :article)
+        document.getElementById(arguments[0]).dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: window.dragTransfer }))
+      JS
+    end
+
+    def assert_in_column(card, column_id)
+      assert_selector "##{column_id} ##{dom_id(card, :article)}", visible: :all
+      assert_equal 1, page.all("##{dom_id(card, :article)}", visible: :all).size
+    end
+
+    def assert_no_drag_styles
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    end
+
+    def card_ids_in(column_id)
+      page.all("##{column_id} article.card", visible: :all).map { |card| card[:id] }
+    end
+
+    def count_in(column_id)
+      find("##{column_id} .cards__expander-count", visible: :all).text(:all)
+    end
+end
