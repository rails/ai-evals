diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a62fbfe
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,221 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "item", "container", "stamp", "errorMessage" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem
+  #hoverContainer
+  #pendingMoves = new Map()
+  #saveQueue = Promise.resolve()
+
+  disconnect() {
+    this.dragEnd()
+    this.itemTargets.forEach(item => item.draggable = false)
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  dragStart(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!this.itemTargets.includes(item)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    const candidate = this.#containerFor(event.target)
+    const container = candidate?.querySelector(".cards__list") ? candidate : null
+    this.#highlight(container)
+
+    if (container && this.#draggedItem) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#hoverContainer?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const destination = this.#containerFor(event.target)
+    this.dragEnd()
+
+    if (item && destination) {
+      event.preventDefault()
+      const source = this.#containerFor(item)
+
+      if (source !== destination) {
+        this.#move(item, source, destination)
+      }
+    }
+  }
+
+  dragEnd() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  #containerFor(element) {
+    const container = element?.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #highlight(container) {
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoverContainer = this.#draggedItem ? container : null
+    this.#hoverContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  #move(item, source, destination) {
+    const list = destination.querySelector(".cards__list")
+    // A frame that hasn't loaded yet cannot safely accept a card.
+    if (!list) return
+
+    const pending = this.#pendingMoves.get(item) || { saved: this.#snapshot(item, source) }
+    const move = Symbol()
+    const request = this.#requestFor(item, destination)
+    pending.latest = move
+    this.#pendingMoves.set(item, pending)
+
+    this.#insert(item, list, destination)
+    this.#updateCard(item, destination)
+    this.#changeCount(source, -1)
+    this.#changeCount(destination, 1)
+    const moved = this.#snapshot(item, destination)
+
+    // Persist drops in order so server recency matches the instant local order.
+    this.#saveQueue = this.#saveQueue.then(async () => {
+      try {
+        const response = await request.perform()
+        if (!response.ok) throw new Error("Could not move card")
+        pending.saved = moved
+      } catch {
+        if (pending.latest === move && this.element.isConnected && this.element.contains(item)) {
+          this.#restore(item, pending.saved)
+          this.#showError()
+        }
+      } finally {
+        if (pending.latest === move) this.#pendingMoves.delete(item)
+      }
+    })
+  }
+
+  #snapshot(item, container) {
+    return {
+      container, parent: item.parentNode, next: item.nextSibling,
+      preview: item.cloneNode(true)
+    }
+  }
+
+  #restore(item, saved) {
+    const source = this.#containerFor(item)
+    const parent = saved.parent.isConnected ? saved.parent : saved.container.querySelector(".cards__list")
+    parent.insertBefore(item, saved.next?.parentNode === parent ? saved.next : null)
+    item.innerHTML = saved.preview.innerHTML
+    Array.from(item.attributes).forEach(attribute => item.removeAttribute(attribute.name))
+    Array.from(saved.preview.attributes).forEach(attribute => item.setAttribute(attribute.name, attribute.value))
+    this.#changeCount(source, -1)
+    this.#changeCount(saved.container, 1)
+  }
+
+  #showError() {
+    document.getElementById("flash")?.replaceChildren(this.errorMessageTarget.content.cloneNode(true))
+  }
+
+  #insert(item, list, destination) {
+    const items = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+    const goldenFirst = destination.dataset.dragAndDropStatus === "column" || destination.dataset.dragAndDropStatus === "maybe"
+    let next = items[0]
+    if (goldenFirst && !item.classList.contains("golden-effect")) {
+      next = items.find(item => !item.classList.contains("golden-effect"))
+    }
+
+    // Insert into the existing pagination frame, not after its load-more link.
+    const parent = next?.parentNode || items.at(-1)?.parentNode || list.querySelector("turbo-frame") || list
+    parent.insertBefore(item, next || parent.querySelector(".pagination-link"))
+  }
+
+  #updateCard(item, destination) {
+    const status = destination.dataset.dragAndDropStatus
+    const active = status === "column" || status === "maybe"
+    item.dataset.action = active ? "mouseenter->navigable-list#hoverSelect" : ""
+    for (const action of [ "NotNow", "Closure", "AssignToSelf" ]) {
+      if (active) {
+        item.dataset[`card${action}Url`] = item.dataset[`dragAndDrop${action}Url`]
+      } else {
+        delete item.dataset[`card${action}Url`]
+      }
+    }
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not-now")
+    item.querySelector(".card__closed")?.remove()
+    item.querySelector(".bubble")?.remove()
+    item.querySelector(".card__header .card__column-name")?.remove()
+
+    if (status !== "closed") {
+      item.style.setProperty("--card-color", destination.style.getPropertyValue("--card-color") || "var(--color-card-default)")
+      item.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === destination.dataset.dragAndDropColumnId)
+      })
+    }
+
+    if (status === "column") {
+      const name = document.createElement("span")
+      name.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const label = document.createElement("span")
+      label.className = "overflow-ellipsis"
+      label.textContent = destination.dataset.columnName
+      name.append(label)
+      item.querySelector(".card__header").append(name)
+    } else if (!active) {
+      const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+      const title = status === "closed" ? "Done" : "Not Now"
+      stamp.querySelector(".card__closed-title").textContent = title
+      stamp.querySelector(".card__closed-title").dataset.text = title
+      stamp.querySelector(".card__closed-date").textContent = new Intl.DateTimeFormat("en-US", {
+        month: "short", day: "2-digit", year: "numeric", timeZone: getMetaContent("timezone") || undefined
+      }).format(new Date())
+      item.querySelector(".card__body").append(stamp)
+    }
+  }
+
+  #changeCount(container, difference) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = Number(container.dataset.dragAndDropCount) + difference
+    container.dataset.dragAndDropCount = count
+    counter.textContent = count > 99 ? "99+" : count
+    const progress = container.querySelector('[data-css-variable-counter-target="counter"]')
+    const loadedCount = container.querySelectorAll('[data-css-variable-counter-target~="item"]').length
+    progress.style.setProperty("--card-count", Math.min(loadedCount, 15))
+  }
+
+  // request.js uses Turbo.fetch, whose request ID suppresses our own refresh broadcasts.
+  #requestFor(item, destination) {
+    switch (destination.dataset.dragAndDropStatus) {
+      case "column":
+        return new FetchRequest("post", item.dataset.dragAndDropTriageUrl, { responseKind: "json", body: { column_id: destination.dataset.dragAndDropColumnId } })
+      case "maybe":
+        return new FetchRequest("delete", item.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+      case "not-now":
+        return new FetchRequest("post", item.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return new FetchRequest("post", item.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+    }
+  }
+}
