diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..6b06fb2
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,386 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    cards(:logo).update_column(:column_id, columns(:writebook_in_progress).id)
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+    assert_selector "##{dom_id(cards(:layout), :article)}[draggable=true]", visible: :all
+    assert_selector "##{dom_id(cards(:logo), :article)}[draggable=true]", visible: :all
+  end
+
+  test "a drop moves the card before saving and preserves the column's sort order" do
+    card = cards(:layout)
+    destination = columns(:writebook_in_progress)
+    expected_order = [ cards(:logo), card, cards(:text) ].map { |card| dom_id(card, :article) }
+
+    pause_saves
+    drag_card(card, dom_id(destination))
+
+    assert_equal expected_order, card_ids_in(dom_id(destination))
+    assert_equal columns(:writebook_triage), card.reload.column
+    assert_selector "##{dom_id(card, :article)} .card__header .card__column-name", text: destination.name, visible: :all
+    assert_no_drag_styles
+    assert_equal "0", count_in(dom_id(columns(:writebook_triage)))
+    assert_equal "3", count_in(dom_id(destination))
+
+    finish_save
+    assert_equal destination, card.reload.column
+    assert_equal expected_order, card_ids_in(dom_id(destination))
+
+    page.refresh
+    assert_selector "##{dom_id(card, :article)}", visible: :all
+    assert_equal expected_order, card_ids_in(dom_id(destination))
+  end
+
+  test "drag styles follow the pointer and are cleared when the drag is canceled" do
+    card = cards(:layout)
+    destination = dom_id(columns(:writebook_in_progress))
+    original_order = card_ids_in(dom_id(columns(:writebook_triage)))
+
+    start_drag(card)
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    drag_over(destination)
+    assert_selector "##{destination}.drag-and-drop__hover-container", visible: :all
+
+    page.execute_script <<~JS, destination
+      const container = document.getElementById(arguments[0])
+      container.firstElementChild.dispatchEvent(new DragEvent("dragleave", { bubbles: true, relatedTarget: container.querySelector("header") }))
+    JS
+    assert_selector "##{destination}.drag-and-drop__hover-container", visible: :all
+
+    drag_over("maybe")
+    assert_no_selector "##{destination}.drag-and-drop__hover-container", visible: :all
+    assert_selector "#maybe.drag-and-drop__hover-container", visible: :all
+    end_drag(card)
+    assert_no_drag_styles
+    assert_equal original_order, card_ids_in(dom_id(columns(:writebook_triage)))
+  end
+
+  test "same-column and outside drops do not reorder or save" do
+    card = cards(:text)
+    source = dom_id(columns(:writebook_in_progress))
+    original_order = card_ids_in(source)
+    original_activity = card.last_active_at
+    pause_saves
+
+    drag_card(card, source)
+    drag_card(card, "cards_container")
+    assert_equal original_order, card_ids_in(source)
+    assert_equal 0, page.evaluate_script("window.saveCount")
+    assert_equal original_activity, card.reload.last_active_at
+    assert_no_drag_styles
+  end
+
+  test "cards move between Done, Not Now, Maybe and custom columns instantly" do
+    card = cards(:layout)
+    [ "closed-cards", "not-now", "maybe", dom_id(columns(:writebook_review)) ].each do |destination|
+      original_column = card.reload.column
+      pause_saves
+      drag_card(card, destination)
+      assert_in_column(card, destination)
+      if original_column
+        assert_equal original_column, card.reload.column
+      else
+        assert_nil card.reload.column
+      end
+      assert_no_drag_styles
+
+      case destination
+      when "closed-cards", "not-now"
+        title = destination == "closed-cards" ? "Done" : "Not Now"
+        assert_selector "##{dom_id(card, :article)} .card__closed-title", text: title, visible: :all
+        assert_no_selector "##{dom_id(card, :article)}.card--active", visible: :all
+      else
+        assert_selector "##{dom_id(card, :article)}.card--active", visible: :all
+        assert_no_selector "##{dom_id(card, :article)} .card__closed", visible: :all
+      end
+
+      finish_save
+      case destination
+      when "closed-cards" then assert card.reload.closed?
+      when "not-now" then assert card.reload.postponed?
+      when "maybe" then assert card.reload.awaiting_triage?
+      else assert_equal columns(:writebook_review), card.reload.column
+      end
+      assert_in_column(card, destination)
+    end
+  end
+
+  test "a closed card can go directly back to Maybe without returning to its old column" do
+    card = cards(:shipping)
+    pause_saves
+    drag_card(card, "maybe")
+    assert_in_column(card, "maybe")
+    finish_save
+    assert card.reload.awaiting_triage?
+    assert_nil card.column
+  end
+
+  test "a failed save restores the original position, presentation and counts" do
+    card = cards(:text)
+    source = dom_id(columns(:writebook_in_progress))
+    original_order = card_ids_in(source)
+    original_color = find("##{dom_id(card, :article)}", visible: :all)[:style]
+    pause_saves
+    drag_card(card, "not-now")
+    assert_in_column(card, "not-now")
+    fail_save
+
+    assert_text "Couldn't move this card. Please try again."
+    assert_equal original_order, card_ids_in(source)
+    assert_equal original_color, find("##{dom_id(card, :article)}", visible: :all)[:style]
+    assert_selector "##{dom_id(card, :article)}.card--active", visible: :all
+    assert_no_selector "##{dom_id(card, :article)} .card__closed", visible: :all
