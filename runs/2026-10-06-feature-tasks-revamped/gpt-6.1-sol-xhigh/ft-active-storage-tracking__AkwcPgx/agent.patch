index 0000000..09eb5ad
--- /dev/null
+++ b/app/jobs/storage/reconcile_account_job.rb
@@ -0,0 +1,14 @@
+class Storage::ReconcileAccountJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::StatementTimeout, ActiveRecord::RecordNotFound, wait: :polynomially_longer, attempts: 10
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    step :attachments do |step|
+      Storage::Entry.reconcile_account(account, start: step.cursor, callback: ->(id) { step.advance! from: id })
+    end
+  end
+end
