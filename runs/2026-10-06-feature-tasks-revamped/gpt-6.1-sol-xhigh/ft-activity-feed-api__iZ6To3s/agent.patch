--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,67 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat, paginated array of account activity, newest first. Only activity on boards the current user can access is returned. Follow the `Link` header's `rel="next"` URL to fetch the next page, as described in the [pagination guide](../README.md#pagination).
+
+__Optional query parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the users who performed the activity |
+| `board_ids[]` | Filter by boards |
+
+Multiple values within a filter are combined with OR; supplying both filters requires activity to match both. Board filters do not grant access to otherwise inaccessible boards.
+
+__Example request:__
+
+```bash
+curl -H "Authorization: Bearer put-your-access-token-here" \
+  "http://app.fizzy.localhost:3006/686465299/activities.json?creator_ids[]=03f5v9zjw7pz8717a4no1h8a7&board_ids[]=03f5v9zkft4hj9qq0lsn9ohcy"
+```
+
+__Response:__
+
+Each object in the array has these fields:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action, from the list below |
+| `created_at` | ISO 8601 timestamp in UTC |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details, as described below |
+| `url` | The card's URL; comment activity includes a `#comment_<id>` anchor to jump to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation for the person who performed the activity |
+
+__Actions:__
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
+
+These mirror the HTML timeline, except that deprecated `card_collection_changed` events are omitted and `card_title_changed` events are included.
+
+__Particulars:__
+
+| Actions | `particulars` fields |
+|---------|---------------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`: an array of user IDs |
+| `card_board_changed` | `old_board`, `new_board`: board names |
+| `card_title_changed` | `old_title`, `new_title`: card titles |
+| `card_triaged` | `column`: column name |
+| All other actions | An empty object (`{}`) |
+
+Missing board names, titles, and column names are returned as empty strings (`""`).
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..36f5aa4
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,292 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat array of activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal Event.order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+    assert_equal Event.count.to_s, response.headers["X-Total-Count"]
+  end
+
+  test "card activity includes the existing API representations" do
+    event = events(:logo_published)
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_path(event.card), URI.parse(activity["url"]).path
+    assert_nil URI.parse(activity["url"]).fragment
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.card, format: :json)
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the card with the comment anchor" do
+    event = events(:layout_commented)
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_path(event.card), URI.parse(activity["url"]).path
+    assert_equal ActionView::RecordIdentifier.dom_id(event.eventable), URI.parse(activity["url"]).fragment
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(event.card, event.eventable, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    Event.delete_all
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_postponed card_auto_postponed card_triaged
+      card_sent_back_to_triage card_title_changed
+    ]
+    actions.each { |action| create_activity(action: action) }
+    create_activity(action: "comment_created", eventable: comments(:layout_overflowing_david))
+    create_activity(action: "card_collection_changed")
+    create_activity(action: "card_resumed")
+    create_activity(action: "card_description_changed")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal (actions + [ "comment_created" ]).sort, response.parsed_body.pluck("action").sort
+  end
+
+  test "assignment particulars expose assignee ids for assignments and unassignments" do
+    event = events(:logo_assignment_jz)
+    %w[ card_assigned card_unassigned ].each do |action|
+      event.update_columns(action: action)
+      get activities_path(format: :json)
+
+      activity = response.parsed_body.find { |item| item["id"] == event.id }
+      assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    end
+  end
+
+  test "board changes expose old and new board names" do
+    event = create_activity(action: "card_board_changed", particulars: { particulars: { old_board: "Old board", new_board: "New board" } })
+    get activities_path(format: :json)
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activity["particulars"])
+  end
+
+  test "title changes expose old and new titles" do
+    event = create_activity(action: "card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+    get activities_path(format: :json)
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity["particulars"])
+  end
+
+  test "triage activity exposes the column name" do
+    event = create_activity(action: "card_triaged", particulars: { particulars: { column: "In progress" } })
+    get activities_path(format: :json)
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "missing board title and column particulars are empty strings" do
+    expectations = {
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }
+
+    expectations.each do |action, expected|
+      event = create_activity(action: action)
+      get activities_path(format: :json)
+
+      activity = response.parsed_body.find { |item| item["id"] == event.id }
+      assert_equal expected, activity["particulars"]
+    end
+  end
+
+  test "null board title and column particulars are empty strings" do
+    expectations = {
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }
+
+    expectations.each do |action, expected|
+      event = create_activity(action: action, particulars: { particulars: expected.transform_values { nil } })
+      get activities_path(format: :json)
+      assert_equal expected, response.parsed_body.find { |item| item["id"] == event.id }["particulars"]
+
+      event.update_columns(particulars: nil)
+      get activities_path(format: :json)
+      assert_response :success
+      assert_equal expected, response.parsed_body.find { |item| item["id"] == event.id }["particulars"]
+    end
+  end
+
+  test "descriptions use the existing plain text form without timeline markup" do
+    users(:david).update_column(:name, "Tom & Jerry")
+    cards(:logo).update_column(:title, "A < B")
+    event = events(:logo_published).reload
+    get activities_path(format: :json)
+
+    description = response.parsed_body.find { |item| item["id"] == event.id }["description"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, description
+    assert_not_includes description, "<span"
+  end
+
+  test "other activity does not expose stored particulars" do
+    event = events(:logo_published)
+    event.update_columns(particulars: { unrelated: "value", particulars: { column: "Ignored" } })
+    get activities_path(format: :json)
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "filters by multiple creators" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:jz).id ] }
+
+    assert_response :success
+    assert_equal Event.where(creator: [ users(:david), users(:jz) ]).order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+  end
+
+  test "filters by boards and combines board and creator filters" do
+    private_event = create_activity(board: boards(:private), creator: users(:kevin))
+    create_activity(board: boards(:private), creator: users(:david))
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, boards(:private).id ] }
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), private_event.id
+    assert_includes response.parsed_body.pluck("id"), events(:logo_published).id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }
+    assert_equal [ private_event.id ], response.parsed_body.pluck("id")
+  end
+
+  test "excludes activity on inaccessible boards and other accounts" do
+    create_activity(board: boards(:private))
+    create_activity(board: boards(:miltons_wish_list), eventable: cards(:radio), creator: users(:mike))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |item| item.dig("board", "id") }.uniq
+  end
+
+  test "inaccessible-only board filters return no activity" do
+    logout_and_sign_in_as :david
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ] }
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "filters with no matching activity return an empty array" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:mike).id ] }
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "empty filters do not restrict activity" do
+    get activities_path(format: :json), params: { creator_ids: [], board_ids: [] }
+
+    assert_response :success
+    assert_equal Event.count, response.parsed_body.size
+  end
+
+  test "revoked board access hides its activity" do
+    private_event = create_activity(board: boards(:private), creator: users(:kevin))
+    get activities_path(format: :json)
+    assert_includes response.parsed_body.pluck("id"), private_event.id
+
+    boards(:private).accesses.destroy_by(user: users(:kevin))
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+  end
+
+  test "moving a card to an inaccessible board also hides its comment activity" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_published).id
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_commented).id
+  end
+
+  test "empty activity returns an empty array" do
+    Event.delete_all
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+    assert_equal "0", response.headers["X-Total-Count"]
+    assert_nil response.headers["Link"]
+  end
+
+  test "paginates newest first and preserves filters in next-page links" do
+    60.times do |index|
+      create_activity(created_at: 1.minute.ago + index.seconds, creator: users(:kevin))
+    end
+    create_activity(board: boards(:private), creator: users(:kevin))
+    expected_ids = Event.where(board: boards(:writebook), creator: users(:kevin)).order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, board_ids: [ boards(:writebook).id ], creator_ids: [ users(:kevin).id ])
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+      assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      page_count += 1
+      url = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = url && URI.parse(url).request_uri
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids, actual_ids
+  end
+
+  test "supports bearer token authentication" do
+    sign_out
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  private
+    def create_activity(action: "card_published", eventable: nil, board: eventable&.board || boards(:writebook), creator: users(:david), particulars: {}, created_at: Time.current)
+      eventable ||= if board == cards(:logo).board
+        cards(:logo)
+      else
+        board.cards.create!(title: "Activity card", creator: creator, status: :drafted).tap do |card|
+          card.update_columns(status: "published")
+        end
+      end
+
+      Event.create!(action: action, eventable: eventable, board: board, account: board.account, creator: creator, particulars: particulars, created_at: created_at)
+    end
+end
