@@ -0,0 +1,17 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_activities
+  end
+
+  private
+    def filtered_activities
+      activities = Current.user.accessible_events.for_activity.preloaded.order(created_at: :desc, id: :desc)
+      activities = activities.where(creator_id: activity_params[:creator_ids]) if activity_params[:creator_ids].present?
+      activities = activities.where(board_id: activity_params[:board_ids]) if activity_params[:board_ids].present?
+      activities
+    end
+
+    def activity_params
+      @activity_params ||= params.permit(creator_ids: [], board_ids: []).transform_values(&:compact_blank)
+    end
+end
