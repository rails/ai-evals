diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a33fb79
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,275 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { userName: String }
+
+  #draggedItem
+  #hoverContainer
+  #moves = new Map()
+
+  itemTargetConnected(item) {
+    item.draggable = !this.#moves.get(item.id)?.pending
+  }
+
+  disconnect() {
+    this.end()
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  start(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!this.itemTargets.includes(item) || this.#moves.get(item.id)?.pending) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const container = this.#containerFor(event.target)
+    if (this.#draggedItem && container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  leave(event) {
+    if (this.#hoverContainer && !this.#hoverContainer.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const destination = this.#containerFor(event.target)
+    const source = item && this.#containerFor(item)
+    this.end()
+
+    if (item && destination) {
+      event.preventDefault()
+      if (source !== destination) {
+        this.#move(item, source, destination)
+      }
+    }
+  }
+
+  end() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  // An in-flight column load may contain the card's old location. Keep local moves
+  // in place until both that load and the save have completed.
+  preserveMoves(event) {
+    const container = this.#containerFor(event.target)
+    const moves = Array.from(this.#moves.values()).filter(move => move.containers.has(container))
+    if (moves.length === 0) return
+
+    const render = event.detail.render
+    event.detail.render = (currentFrame, newFrame) => {
+      moves.forEach(move => {
+        newFrame.querySelector(`#${CSS.escape(move.item.id)}`)?.remove()
+        if (move.destination === container) move.item.remove()
+      })
+
+      render(currentFrame, newFrame)
+
+      moves.forEach(move => {
+        if (move.destination === container) this.#insert(move.item, container)
+        move.frames.delete(currentFrame)
+        this.#forgetCompletedMove(move)
+      })
+    }
+  }
+
+  #containerFor(element) {
+    const container = element?.closest('[data-drag-and-drop-target~="container"]')
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #highlight(container) {
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoverContainer = container
+    container?.classList.add(this.hoverContainerClass)
+  }
+
+  #move(item, source, destination) {
+    const previous = this.#moves.get(item.id)
+    const move = {
+      item, source, destination, previous,
+      containers: new Set([ ...(previous?.containers || []), source, destination ]),
+      original: item.cloneNode(true),
+      parent: item.parentNode,
+      nextSibling: item.nextSibling,
+      pending: true,
+      frames: new Set([
+        ...(previous?.frames || []),
+        ...[ source, destination ].flatMap(container =>
+          Array.from(container.querySelectorAll("turbo-frame[src]:not([complete])")))
+      ])
+    }
+    this.#moves.set(item.id, move)
+    item.draggable = false
+
+    this.#updateCard(item, destination)
+    this.#insert(item, destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+    this.#save(move)
+  }
+
+  // Match latest.with_golden_first for active columns, latest for Not Now,
+  // and recently_closed_first for Done. Pointer position never changes order.
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+    const items = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]')).filter(other => other !== item)
+    const nextItem = items.find(other => this.#compare(item, other, container) < 0)
+
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #compare(item, other, container) {
+    const status = container.dataset.columnStatus
+    if (status === "triaged" || status === "maybe") {
+      const goldDifference = Number(other.classList.contains("golden-effect")) - Number(item.classList.contains("golden-effect"))
+      if (goldDifference) return goldDifference
+    }
+
+    const dateKey = status === "closed" ? "cardClosedAt" : "cardLastActiveAt"
+    const dateDifference = Date.parse(other.dataset[dateKey]) - Date.parse(item.dataset[dateKey])
+    return dateDifference || (item.id < other.id ? 1 : item.id > other.id ? -1 : 0)
+  }
+
+  #updateCard(item, destination) {
+    const status = destination.dataset.columnStatus
+    const active = status === "triaged" || status === "maybe"
+    const now = new Date()
+    item.dataset.cardLastActiveAt = now.toISOString()
+    item.dataset.cardClosedAt = status === "closed" ? now.toISOString() : ""
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not_now")
+    item.removeAttribute("aria-selected")
+    const hoverAction = "mouseenter->navigable-list#hoverSelect"
+    const actions = (item.dataset.action || "").split(/\s+/).filter(action => action && action !== hoverAction)
+    if (active) actions.push(hoverAction)
+    item.dataset.action = actions.join(" ")
+    if (destination.dataset.columnColor) {
+      item.style.setProperty("--card-color", destination.dataset.columnColor)
+    }
+
+    item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === destination.dataset.columnId)
+    })
+    item.querySelector(".card__header .card__column-name--current")?.remove()
+    if (status === "triaged") {
+      const label = document.createElement("span")
+      label.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      label.textContent = destination.dataset.columnName
+      item.querySelector(".card__header").append(label)
+    }
+
+    item.querySelector(".card__closed")?.remove()
+    item.querySelector(".bubble")?.remove()
+    if (!active) this.#addStamp(item, status === "closed" ? "Done" : "Not Now", now)
+
+    const updatedTime = item.querySelector(".card__meta-text--updated time")
+    if (updatedTime) {
+      updatedTime.dateTime = Math.floor(now.getTime() / 1000)
+      updatedTime.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    }
+  }
+
+  #addStamp(item, title, date) {
+    const stamp = document.createElement("div")
+    stamp.className = "card__closed"
+    stamp.innerHTML = '<span class="card__closed-title"></span><strong class="card__closed-date"></strong><span class="card__closed-by-line">by <span class="card__closed-by"></span></span>'
+    const titleElement = stamp.querySelector(".card__closed-title")
+    titleElement.textContent = title
+    titleElement.dataset.text = title
+    stamp.querySelector(".card__closed-date").textContent = new Intl.DateTimeFormat("en-US", { month: "short", day: "2-digit", year: "numeric" }).format(date)
+    stamp.querySelector(".card__closed-by").textContent = this.userNameValue
+    item.querySelector(".card__body").append(stamp)
+  }
+
+  #updateCount(container, change) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = Number(counter.dataset.count) + change
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+    container.querySelector(".cards__expander").style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  async #save(move) {
+    try {
+      const response = await this.#requestFor(move).perform()
+      if (!response.ok) throw new Error(`Card move failed: ${response.statusCode}`)
+      move.pending = false
+      move.item.draggable = true
+      this.#forgetCompletedMove(move)
+    } catch (error) {
+      if (move.previous) {
+        move.previous.item = move.original
+        move.previous.frames = move.frames
+        this.#moves.set(move.item.id, move.previous)
+        this.#forgetCompletedMove(move.previous)
+      } else {
+        this.#moves.delete(move.item.id)
+      }
+      if (this.element.isConnected) {
+        this.#restore(move)
+        this.dispatch("error", { detail: { error } })
+        window.alert("The card couldn't be moved. Please try again.")
+      }
+    }
+  }
+
+  #requestFor({ item, destination }) {
+    const options = { responseKind: "json" }
+    switch (destination.dataset.columnStatus) {
+      case "triaged":
+        options.body = { column_id: destination.dataset.columnId }
+        return new FetchRequest("post", item.dataset.cardTriageUrl, options)
+      case "maybe":
+        return new FetchRequest("delete", item.dataset.cardTriageUrl, options)
+      case "not_now":
+        return new FetchRequest("post", item.dataset.cardNotNowUrl, options)
+      case "closed":
+        return new FetchRequest("post", item.dataset.cardClosureUrl, options)
+    }
+  }
+
+  #forgetCompletedMove(move) {
+    move.frames.forEach(frame => {
+      if (!frame.isConnected) move.frames.delete(frame)
+    })
+    if (this.#moves.get(move.item.id) === move && !move.pending && move.frames.size === 0) {
+      this.#moves.delete(move.item.id)
+    }
+  }
+
+  #restore({ item, original, parent, nextSibling, source, destination }) {
+    item.remove()
+    if (parent.isConnected && nextSibling?.parentNode === parent) {
+      parent.insertBefore(original, nextSibling)
+    } else {
+      this.#insert(original, source)
+    }
+    this.#updateCount(source, 1)
+    this.#updateCount(destination, -1)
+  }
+}
