diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..77dc6e1
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,393 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @card.ungild
+    @source = columns(:writebook_triage)
+    @destination = columns(:writebook_in_progress)
+    @golden = cards(:text)
+    @golden.gild
+    @ordinary = @board.cards.create!(title: "An older card", status: :published, column: @destination, last_active_at: 2.days.ago)
+    visit_board
+    hold_saves
+  end
+
+  test "board cards are draggable and a native drag moves between columns immediately" do
+    assert_selector "#{card_selector}[draggable=true]"
+    source_count = column_count(@source)
+    destination_count = column_count(@destination)
+
+    find(card_selector).drag_to(find("#{column_selector(@destination)} .cards__header"))
+
+    assert_card_in @destination
+    assert_no_selector "#{column_selector(@source)} #{card_selector}", visible: :all
+    assert_equal @source, @card.reload.column, "The card must move before the request is sent"
+    assert_equal source_count - 1, column_count(@source)
+    assert_equal destination_count + 1, column_count(@destination)
+    assert_equal [ dom_id(@golden, :article), dom_id(@card, :article), dom_id(@ordinary, :article) ], card_order(@destination)
+    assert_selector "#{card_selector}[draggable=false]", visible: :all
+
+    original_order = card_order(@destination)
+    release_save
+
+    assert_equal @destination, @card.reload.column
+    assert_equal original_order, card_order(@destination)
+    assert_equal [], page.evaluate_script("window.boardRequests")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+
+    visit_board
+    assert_equal original_order, card_order(@destination), "Local order must match the server-rendered order"
+  end
+
+  test "a golden card goes ahead of the destination's golden cards" do
+    @card.reload.gild
+    visit_board
+    hold_saves
+
+    drop_card @destination
+
+    assert_equal dom_id(@card, :article), card_order(@destination).first
+    release_save
+    visit_board
+    assert_equal dom_id(@card, :article), card_order(@destination).first
+  end
+
+  test "moves can close postpone resume and send cards back to Maybe" do
+    [ "closed-cards", "not-now", "maybe", @destination, "closed-cards", "maybe" ].each do |destination|
+      drop_card destination
+      assert_card_in destination
+      assert_selector "#{card_selector}[draggable=false]", visible: :all
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+
+      request = page.evaluate_script("window.moveRequests.at(-1)")
+      case destination
+      when "closed-cards"
+        assert_equal "POST", request["method"]
+        assert_match %r{/closure$}, request["url"]
+        assert_selector "#{card_selector} .card__closed-title", text: "Done", visible: :all
+      when "not-now"
+        assert_equal "POST", request["method"]
+        assert_match %r{/not_now$}, request["url"]
+        assert_selector "#{card_selector}.card--postponed .card__closed-title", text: "Not Now", visible: :all
+      when "maybe"
+        assert_equal "DELETE", request["method"]
+        assert_match %r{/triage$}, request["url"]
+        assert_selector "#{card_selector}.card--active", visible: :all
+        assert_no_selector "#{card_selector} .card__closed", visible: :all
+      else
+        assert_equal "POST", request["method"]
+        assert_equal @destination.id, JSON.parse(request["body"])["column_id"]
+        assert_selector "#{card_selector}.card--active", visible: :all
+      end
+
+      release_save
+      case destination
+      when "closed-cards" then assert @card.reload.closed?
+      when "not-now" then assert @card.reload.postponed?
+      when "maybe" then assert @card.reload.awaiting_triage?
+      else assert_equal @destination, @card.reload.column
+      end
+    end
+  end
+
+  test "Not Now ignores gold-first ordering and Done uses closure order" do
+    @golden.postpone
+    visit_board
+    hold_saves
+
+    drop_card "not-now"
+    assert_equal dom_id(@card, :article), card_order("not-now").first
+    release_save
