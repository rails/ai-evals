+  test "the save's refresh broadcast does not reload or shift the board" do
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    drop_card @destination
+    order = card_order(@destination)
+    request_id = page.evaluate_script("window.moveRequests[0].requestId")
+    assert request_id.present?
+    page.execute_script <<~JS, dom_id(@card, :article), request_id
+      window.optimisticCard = document.getElementById(arguments[0])
+      const requestId = arguments[1]
+      window.refreshReceived = new Promise(resolve => {
+        document.addEventListener("turbo:before-stream-render", event => {
+          if (event.target.getAttribute("request-id") === requestId) resolve()
+        })
+      })
+    JS
+    release_save
+
+    Turbo::StreamsChannel.broadcast_refresh_to(@board, request_id: request_id)
+    page.evaluate_async_script <<~JS
+      const done = arguments[arguments.length - 1]
+      window.refreshReceived.then(() => requestAnimationFrame(() => requestAnimationFrame(done)))
+    JS
+
+    assert_equal [], page.evaluate_script("window.boardRequests")
+    assert_equal order, card_order(@destination)
+    assert page.evaluate_script("document.getElementById('#{dom_id(@card, :article)}') === window.optimisticCard")
+  end
+
+  test "a failed second move preserves the first move against an earlier stale frame" do
+    page.execute_script <<~JS, board_column_path(@board, @source), dom_id(@source, :cards)
+      window.heldFramePath = arguments[0]
+      document.getElementById(arguments[1]).reload()
+    JS
+    assert_selector "html[data-frame-held=true]", visible: :all
+
+    drop_card @destination
+    release_save
+    drop_card "maybe"
+    page.execute_script 'window.pendingMoves.shift().reject(new TypeError("Network unavailable"))'
+    assert_card_in @destination
+    page.execute_script "window.releaseFrame()"
+
+    assert_selector "##{dom_id(@source, :cards)}[complete]", visible: :all
+    assert_card_in @destination
+    assert_selector card_selector, count: 1, visible: :all
+    assert_no_selector "#{column_selector(@source)} #{card_selector}", visible: :all
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      @board.columns.each do |column|
+        assert_selector "##{dom_id(column, :cards)}[complete]", visible: :all
+      end
+      assert_selector "#not_now_column[complete], #closed_column[complete]", count: 2, visible: :all
+      within column_selector(@source) do
+        find(".cards__expander").click unless find(".cards__expander")["aria-expanded"] == "true"
+      end
+      assert_selector card_selector, visible: :all
+    end
+
+    def hold_saves
+      page.execute_script <<~JS
+        window.originalFetch ||= window.fetch
+        window.pendingMoves = []
+        window.moveRequests = []
+        window.boardRequests = []
+        window.alert = message => window.moveAlert = message
+        window.fetch = (url, options = {}) => {
+          const method = (options.method || "GET").toUpperCase()
+          if (method !== "GET" && String(url).includes("/cards/")) {
+            window.moveRequests.push({ url: String(url), method, body: options.body, requestId: new Headers(options.headers).get("X-Turbo-Request-Id") })
+            return new Promise((resolve, reject) => window.pendingMoves.push({ url, options, resolve, reject }))
+          }
+          if (String(url).includes("/boards/")) window.boardRequests.push(String(url))
+          if (window.heldFramePath && new URL(url, location.href).pathname === window.heldFramePath) {
+            return new Promise(async resolve => {
+              const response = await window.originalFetch(url, options)
+              window.releaseFrame = () => resolve(response)
+              document.documentElement.dataset.frameHeld = "true"
+            })
+          }
+          return window.originalFetch(url, options)
+        }
+      JS
+    end
+
+    def drop_card(destination)
+      page.execute_script <<~JS, find(card_selector, visible: :all), find(column_selector(destination), visible: :all)
+        const [item, container] = arguments
+        const transfer = new DataTransfer()
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: transfer }))
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        container.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: transfer }))
+      JS
+    end
+
+    def release_save
+      page.execute_script <<~JS
+        const request = window.pendingMoves.shift()
+        window.originalFetch(request.url, request.options).then(request.resolve, request.reject)
+      JS
+      assert_selector "#{card_selector}[draggable=true]", visible: :all
+    end
+
+    def card_selector
+      "##{dom_id(@card, :article)}"
+    end
+
+    def column_selector(column)
+      "##{column.is_a?(Column) ? dom_id(column) : column}"
+    end
+
+    def card_order(column)
+      all("#{column_selector(column)} .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def column_count(column)
+      find("#{column_selector(column)} .cards__expander-count", visible: :all)["data-count"].to_i
+    end
+
+    def assert_card_in(column)
+      assert_selector "#{column_selector(column)} .cards__list #{card_selector}", visible: :all
+    end
+end
