+
+  test "HTTP and network failures restore the exact card position appearance and counts" do
+    order = card_order(@source)
+    source_count = column_count(@source)
+    destination_count = column_count(@destination)
+    original_style = find(card_selector)[:style]
+
+    [ "http", "network" ].each do |failure|
+      drop_card @destination
+      page.execute_script <<~JS, failure
+        const request = window.pendingMoves.shift()
+        if (arguments[0] === "http") {
+          request.resolve(new Response("", { status: 422, headers: { "Content-Type": "application/json" } }))
+        } else {
+          request.reject(new TypeError("Network unavailable"))
+        }
+      JS
+
+      assert_card_in @source
+      assert_selector "#{card_selector}[draggable=true]"
+      assert_equal order, card_order(@source)
+      assert_equal source_count, column_count(@source)
+      assert_equal destination_count, column_count(@destination)
+      assert_equal original_style, find(card_selector)[:style]
+      assert_equal @source, @card.reload.column
+      assert_equal "The card couldn't be moved. Please try again.", page.evaluate_script("window.moveAlert")
+    end
+
+    drop_card @destination
+    release_save
+    assert_equal @destination, @card.reload.column
+  end
+
