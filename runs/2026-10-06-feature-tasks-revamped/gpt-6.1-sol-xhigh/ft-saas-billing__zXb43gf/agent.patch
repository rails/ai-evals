+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Account::Plan.find(params[:plan_key])
+    if plan&.paid? && plan.stripe_price_id.present? && !Current.account.subscription&.active?
+      redirect_to Current.account.stripe_checkout_url(plan,
+        success_url: saas.account_billing_url,
+        cancel_url: saas.account_billing_url), allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report(error)
+    redirect_to saas.account_billing_path, alert: "Billing is temporarily unavailable. Please try again.", status: :see_other
+  end
+end
