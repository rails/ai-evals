+      <%= form.label :bytes_used, "Bytes used" %>
+      <%= form.number_field :bytes_used, min: 0, step: 1, placeholder: @account.bytes_used %>
+    </p>
+    <%= form.submit "Override", class: "btn" %>
+  <% end %>
+  <%= button_to "Reset", saas.admin_account_usage_override_path(@account), method: :delete, class: "btn" %>
+</section>
