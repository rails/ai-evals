+<% @page_title = @account.name %>
+
+<section class="panel panel--wide center">
+  <%= link_to "Accounts", saas.admin_accounts_path %>
+  <h1><%= @account.name %></h1>
+  <p>Plan: <strong><%= @account.billing_plan.name %></strong><%= " (Comped)" if @account.comped? %></p>
+  <p><%= number_with_delimiter(@account.card_count) %> cards · <%= number_to_human_size(@account.bytes_used) %> used</p>
