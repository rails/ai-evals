+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open support controls" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      %w[Comp Reset].each { |label| assert_select "button", text: label }
+      assert_select "input[type=submit][value=Override]"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+    end
+  end
+
+  test "staff can comp uncomp override and reset" do
+    untenanted do
+      post saas.admin_account_comp_path(@account)
+      assert_response :redirect
+      assert @account.reload.comped?
+      get saas.admin_account_path(@account)
+      assert_select "button", text: "Uncomp"
+      delete saas.admin_account_comp_path(@account)
+      assert_not @account.reload.comped?
+      patch saas.admin_account_usage_override_path(@account), params: { overridden_limit: { card_count: 1000, bytes_used: 99 } }
+      assert_response :redirect
+      assert_equal 1000, @account.reload.card_count
+      assert_equal 99, @account.bytes_used
+      delete saas.admin_account_usage_override_path(@account)
+      assert_response :redirect
+      assert_nil @account.reload.overridden_limit
+    end
+  end
+
+  test "invalid overrides do not change persisted usage" do
+    @account.override_usage(card_count: 10, bytes_used: 50)
+    untenanted do
+      patch saas.admin_account_usage_override_path(@account), params: { overridden_limit: { card_count: -1, bytes_used: 0 } }
+      assert_response :unprocessable_entity
+      assert_match "greater than or equal to 0", response.body
+    end
+    assert_equal 10, @account.reload.card_count
+    assert_equal 50, @account.bytes_used
+  end
+
+  test "non staff cannot access or change support settings" do
+    logout_and_sign_in_as :mike
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.admin_account_comp_path(@account)
+      assert_response :forbidden
+      delete saas.admin_account_comp_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_usage_override_path(@account), params: { overridden_limit: { card_count: 0 } }
+      assert_response :forbidden
+      delete saas.admin_account_usage_override_path(@account)
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..efeb821
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.override_usage(card_count: 1000)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+  end
+
+  test "exhausted free accounts can still draft" do
+    post board_cards_path(@board, script_name: @account.slug)
+    assert_response :redirect
+    assert @account.cards.order(:created_at).last.drafted?
+  end
+
+  test "exhausted free accounts cannot create through the API" do
+    assert_no_difference "Card.count" do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "No room" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "exhausted free accounts cannot publish" do
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "draft creation buttons are replaced with Upgrade" do
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "button", text: "Create card", count: 0
+  end
+
+  test "warning counts down from 100 remaining cards" do
+    @account.override_usage(card_count: 950)
+    get card_draft_path(@draft, script_name: @account.slug)
+    assert_response :success
+    assert_match "50 cards left", response.body
+    assert_select "button", text: "Create card"
+  end
+
+  test "the last free card is allowed but the next is refused" do
+    @account.reset_usage_override
+    count = @account.card_count
+    now = Time.current
+    Card.insert_all!((999 - count).times.map do |index|
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: @board.id,
+        creator_id: users(:mike).id, status: "published", title: "Existing card", number: 100 + index,
+        created_at: now, updated_at: now, last_active_at: now }
+    end)
+    @account.update_column(:cards_count, 10_000)
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Last free card" } }, as: :json
+    assert_response :created
+    assert_equal 1000, @account.reload.card_count
+    assert_no_difference "Card.count" do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Too many cards" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "board add button gives way to Upgrade" do
+    get board_path(@board, script_name: @account.slug)
+    assert_response :success
+    assert_select ".board-tools a[data-turbo-frame=_top]", text: "Upgrade"
+    assert_select ".board-tools button", text: "Add a card", count: 0
+  end
+
+  test "paid plans can create cards beyond the free limit but obey their storage limit" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited", status: "active")
+    @account.override_usage(card_count: 2000, bytes_used: 2.gigabytes)
+    @account.update_column(:cards_count, 10_000)
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Paid card" } }, as: :json
+    assert_response :created
+    @account.override_usage(bytes_used: 5.gigabytes + 1)
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Over storage" } }, as: :json
+    assert_response :forbidden
+  end
+
+  test "paid and comped accounts can publish despite card usage" do
+    @account.comp
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+end
