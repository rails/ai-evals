+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      # Check and publish under the same account lock so concurrent requests
+      # cannot both claim the last available card.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
