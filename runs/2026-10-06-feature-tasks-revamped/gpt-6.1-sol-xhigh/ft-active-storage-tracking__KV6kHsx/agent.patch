new file mode 100644
index 0000000..2e305d0
--- /dev/null
+++ b/app/jobs/storage/backfill_job.rb
@@ -0,0 +1,22 @@
+class Storage::BackfillJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::StatementTimeout
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account = nil)
+    step :track_attachments do |step|
+      attachments = ActiveStorage::Attachment.where(record_type: [ "Card", "ActionText::RichText" ])
+      attachments = attachments.where(account: account) if account
+
+      attachments.find_each(start: step.cursor) do |attachment|
+        Storage::Attachment.track(attachment)
+        step.set! attachment.id
+      end
+    end
+
+    Current.without_account { Storage::ReconcileJob.perform_later }
+  end
+end
diff --git a/app/jobs/storage/reconcile_job.rb b/app/jobs/storage/reconcile_job.rb
new file mode 100644
index 0000000..89e8e4a
--- /dev/null
+++ b/app/jobs/storage/reconcile_job.rb
@@ -0,0 +1,11 @@
+class Storage::ReconcileJob < ApplicationJob
+  queue_as :backend
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout, ActiveRecord::StatementTimeout
+
+  def perform
+    processed = Storage::Attachment.reconcile_now
+    if processed.positive? && Storage::Attachment.pending.exists?
+      Current.without_account { self.class.perform_later }
+    end
+  end
+end
