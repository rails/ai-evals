diff --git a/test/models/storage/concurrency_test.rb b/test/models/storage/concurrency_test.rb
new file mode 100644
index 0000000..0c24af5
--- /dev/null
+++ b/test/models/storage/concurrency_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Storage::ConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  teardown do
+    Storage::Attachment.delete_all
+    Storage::Total.delete_all
+  end
+
+  test "overlapping workers account for each entry exactly once" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    entries = (Storage::Attachment::BATCH_SIZE * 2 + 1).times.map do
+      { id: ActiveRecord::Type::Uuid.generate, account_id: account.id, board_id: board.id, byte_size: 1 }
+    end
+    Storage::Attachment.insert_all!(entries)
+    started = Queue.new
+    proceed = Queue.new
+
+    workers = 2.times.map do
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          started.push(true)
+          proceed.pop
+          Storage::Attachment.reconcile_now
+        end
+      end
+    end
+    2.times { started.pop }
+    2.times { proceed.push(true) }
+    workers.each(&:value)
+    Storage::Attachment.reconcile_now while Storage::Attachment.pending.exists?
+
+    assert_equal entries.size, account.bytes_used
+    assert_equal entries.size, board.bytes_used
+    assert_equal 2, Storage::Total.count
+    assert_equal 0, Storage::Attachment.pending.count
+  end
+  test "writes during reconciliation are not lost" do
+    account = accounts(:"37s")
+    old_board = boards(:writebook)
+    new_board = boards(:private)
+    entry = Storage::Attachment.create!(account: account, board: old_board, byte_size: 10)
+    Storage::Attachment.reconcile_now
+    started = Queue.new
+    proceed = Queue.new
+
+    writer = Thread.new do
+      ActiveRecord::Base.connection_pool.with_connection do
+        started.push(true)
+        proceed.pop
+        30.times do |index|
+          Storage::Attachment.where(id: entry.id).update_all(byte_size: index + 1, board_id: new_board.id, needs_reconciliation: true)
+          Thread.pass
+        end
+      end
+    end
+    worker = Thread.new do
+      ActiveRecord::Base.connection_pool.with_connection do
+        started.push(true)
+        proceed.pop
+        30.times do
+          Storage::Attachment.reconcile_now
+          Thread.pass
+        end
+      end
+    end
+    2.times { started.pop }
+    2.times { proceed.push(true) }
+    [ writer, worker ].each(&:value)
+    Storage::Attachment.reconcile_now
+
+    assert_equal 30, account.bytes_used
+    assert_equal 0, old_board.bytes_used
+    assert_equal 30, new_board.bytes_used
+    assert_equal 0, Storage::Attachment.pending.count
+  end
+  test "getters bypass a query cache populated before another worker updates totals" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    entry = Storage::Attachment.create!(account: account, board: board, byte_size: 10)
+    Storage::Attachment.reconcile_now
+
+    Storage::Total.cache do
+      assert_equal 10, Storage::Total.where(owner: account).pick(:bytes_used)
+      assert_equal 10, account.bytes_used
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          Storage::Attachment.where(id: entry.id).update_all(byte_size: 20, needs_reconciliation: true)
+          Storage::Attachment.reconcile_now
+        end
+      end.value
+      assert_equal 20, account.bytes_used
+      assert_equal 20, board.bytes_used
+    end
+  end
+end
