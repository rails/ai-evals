+require "test_helper"
+
+class LocalizationCatalogTest < ActiveSupport::TestCase
+  test "every application string has Japanese text and matching interpolation names" do
+    english = I18n.t(:app, locale: :en)
+    japanese = I18n.t(:app, locale: :ja)
+    assert_equal english.keys.sort, japanese.keys.sort
+
+    english.each do |key, text|
+      assert japanese[key].present?, "Empty Japanese translation: #{key}"
+      assert_equal text.scan(/%\{(\w+)\}/).flatten.sort, japanese[key].scan(/%\{(\w+)\}/).flatten.sort, "Interpolation mismatch: #{key}"
+    end
+  end
+
+  test "Japanese counts never require a singular form" do
+    I18n.with_locale(:ja) do
+      [ 0, 1, 3 ].each do |count|
+        assert_equal "新しい通知#{count}件", I18n.t("labels.new_notifications", count: count)
+        assert_equal "#{count}人", I18n.t("labels.people", count: count)
+      end
+    end
+  end
+
+  test "Japanese dates and validation attributes are localized" do
+    I18n.with_locale(:ja) do
+      assert_equal "2026年2月18日", I18n.l(Time.zone.local(2026, 2, 18), format: :card_stamp)
+      user = User.new(name: "")
+      user.validate
+      assert_includes user.errors.full_messages, "名前を入力してください"
+      assert_equal "メンバー", I18n.t("labels.roles.member")
+    end
+  end
+
+  test "static error pages contain English and Japanese with language annotations" do
+    Dir[Rails.root.join("public/{400,404,406-unsupported-browser,422,500}.html")].each do |path|
+      document = Nokogiri::HTML5(File.read(path))
+      assert document.at_css("h2:not([lang])").text.match?(/[a-z]/i), path
+      assert document.at_css("h2[lang=ja]").text.match?(/[\p{Han}\p{Hiragana}\p{Katakana}]/), path
+      assert_includes document.at_css("a").text, "ホームに戻る"
+    end
+  end
+end
