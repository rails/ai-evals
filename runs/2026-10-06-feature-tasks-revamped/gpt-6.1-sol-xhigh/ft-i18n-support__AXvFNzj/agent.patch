+  private
+    def legacy_system_comment_event(comment)
+      # Older comments predate the explicit association. Match the canonical body
+      # as well as the timestamp: several events can occur in the same instant.
+      I18n.with_locale(:en) do
+        comment.card.events.where(created_at: comment.created_at).detect do |event|
+          body = Card::Eventable::SystemCommenter.new(comment.card, event).localized_body
+          body.present? && ActionText::Content.new(body).to_plain_text.squish == comment.body.to_plain_text.squish
+        end
+      end
+    end
 end
