diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..e57de2e
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,17 @@
+// Read the current document, not the browser's language or the locale at module load.
+export function locale() {
+  return document.querySelector('meta[name="locale"]')?.content || document.documentElement.lang
+}
+
+export function dateLocale() {
+  return locale() === "en" ? "en-US" : locale()
+}
+
+export function t(key, values = {}) {
+  const messages = JSON.parse(document.querySelector('meta[name="translations"]').content)
+  let message = key.split(".").reduce((value, part) => value[part], messages)
+  if (typeof message === "object") {
+    message = message[values.count === 1 ? "one" : "other"] || message.other
+  }
+  return message.replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
