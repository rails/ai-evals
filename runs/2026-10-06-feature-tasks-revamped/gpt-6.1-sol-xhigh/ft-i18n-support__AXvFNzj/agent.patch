+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  driven_by :selenium, using: :headless_chrome do |options|
+    options.add_argument("--no-sandbox")
+    options.add_argument("--disable-dev-shm-usage")
+  end
+
+  test "Japanese dates and messages follow the application locale, not the browser" do
+    visit new_session_path(locale: :ja, script_name: nil)
+    assert_text "Fizzyにログイン"
+    assert_selector "html[lang=ja]", visible: :all
+
+    page.execute_script <<~JS
+      const element = document.createElement("section")
+      element.id = "localized-dates"
+      element.dataset.controller = "local-time"
+      element.innerHTML = `
+        <time data-local-time-target="ago" datetime="${Math.floor(Date.now()/1000)-172800}"></time>
+        <time data-local-time-target="shortdate" datetime="#{Time.utc(2026, 2, 18, 10).to_i}"></time>`
+      document.body.appendChild(element)
+    JS
+    assert_selector "#localized-dates", text: "2日前"
+    assert_selector "#localized-dates", text: "2月18日"
+
+    result = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      Promise.all([import("helpers/i18n"), import("helpers/text_helpers")]).then(([i18n, text]) => {
+        done([i18n.t("required"), i18n.t("back_to", {label: "ホーム"}),
+          text.toSentence(["一", "二"])])
+      }).catch(error => done(error.message))
+    JS
+    assert_equal [ "この項目を入力してください", "ホームに戻る", "一と二" ], result
+
+    click_on "新規登録"
+    assert_selector "html[lang=ja]", visible: :all
+    assert_text "メールアドレスを入力してアカウントを作成してください。"
+    visit new_session_path(locale: :en, script_name: nil)
+    assert_text "Get into Fizzy"
+    assert_selector "html[lang=en]", visible: :all
+  end
+
+  test "a saved Japanese preference localizes authenticated navigation and accessibility labels" do
+    users(:kevin).identity.update!(locale: :ja)
+    sign_in_as users(:kevin)
+    assert_selector "html[lang=ja]", visible: :all
+    assert_text "活動"
+    visit card_path(cards(:logo))
+    assert_selector ".for-screen-reader", text: "カード番号", visible: :all
+    assert_no_selector ".for-screen-reader", text: "Delete this card", visible: :all
+  end
+end
