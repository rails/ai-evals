diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..a8c5960
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "anonymous preference survives navigation and invalid locale parameters" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", "Fizzyにログイン"
+
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select "html[lang=ja]"
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "authenticated preference is saved and restored in a clean browser" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_select "html[lang=ja]"
+    get root_path(locale: :xx)
+    assert_equal "ja", identities(:kevin).reload.locale
+    get root_path(locale: :en)
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+
+  test "anonymous choice is saved on authentication" do
+    untenanted { get new_session_path(locale: :ja) }
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "default and unsupported locales leave English unchanged" do
+    untenanted do
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", "Get into Fizzy"
+    end
+  end
+
+  test "malformed locale values do not change the selected language" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      [ [ "ja" ], { language: "ja" }, "", "JA" ].each do |invalid|
+        get new_session_path, params: { locale: invalid }
+        assert_response :success
+        assert_select "html[lang=ja]"
+      end
+    end
+  end
+
+  test "a signed pending login restores the preference before showing the code screen" do
+    identities(:kevin).update!(locale: :ja)
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      follow_redirect!
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "locale is restored even when rendering fails" do
+    SessionsController.any_instance.stubs(:passkey_authentication_options).raises(RuntimeError, "render failed")
+    untenanted do
+      without_action_dispatch_exception_handling do
+        assert_raises(RuntimeError) { get new_session_path(locale: :ja) }
+      end
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "cached card controls cannot cross languages" do
+    sign_in_as :kevin
+    previous_store = ApplicationController.cache_store
+    with_actionview_partial_caching do
+      ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+      get card_path(cards(:logo), locale: :en)
+      assert_response :success
+      assert_select ".card-perma .for-screen-reader", text: "Card number"
+      get card_path(cards(:logo), locale: :ja)
+      assert_response :success
+      assert_select ".card-perma .for-screen-reader", text: "カード番号"
+      assert_select ".card-perma .for-screen-reader", text: "Card number", count: 0
+    end
+  ensure
+    ApplicationController.cache_store = previous_store
+  end
+
+  test "public caches vary by cookie because language is a session preference" do
+    boards(:writebook).publish
+    get published_board_path(boards(:writebook)), params: { locale: :ja }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_includes response.headers["Vary"], "Cookie"
+  end
+end
diff --git a/test/helpers/comments_localization_test.rb b/test/helpers/comments_localization_test.rb
new file mode 100644
index 0000000..9e83583
--- /dev/null
+++ b/test/helpers/comments_localization_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class CommentsLocalizationTest < ActionView::TestCase
+  include CommentsHelper
+  test "system comments have stable English storage and localized presentation" do
+    card = cards(:logo)
+    Current.set(user: users(:david)) do
+      I18n.with_locale(:ja) { card.close }
+    end
+    comment = card.comments.by_system.last
+    assert_not_nil comment.source_event
+    assert_includes comment.body.to_plain_text, "Moved"
+
+    I18n.with_locale(:ja) do
+      assert_includes localized_comment_body(comment).to_plain_text, "「完了」に移動しました"
+    end
+    assert_equal comment.body, localized_comment_body(comment)
+
+    # Also cover comments created before the association was introduced.
+    comment.update!(source_event: nil)
+    I18n.with_locale(:ja) do
+      assert_includes localized_comment_body(comment).to_plain_text, "「完了」に移動しました"
+    end
+  end
+
+  test "user-authored English is never translated" do
+    comment = comments(:logo_agreement_kevin)
+    I18n.with_locale(:ja) { assert_equal comment.body, localized_comment_body(comment) }
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..d685677
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "magic link uses the saved locale, regardless of the worker locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: :ja)
+    link = MagicLink.create!(identity: identity)
+
+    I18n.with_locale(:en) do
+      email = MagicLinkMailer.sign_in_instructions(link)
+      assert_equal "Fizzyの確認コード：#{link.code}", email.subject
+      assert_includes email.html_part.body.decoded, "Fizzy確認コード"
+      assert_includes email.text_part.body.decoded, "6文字の確認コード"
+      assert_includes email.text_part.body.decoded, "15分"
+      assert_not_includes email.text_part.body.decoded, "minutes"
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "delayed delivery resolves each recipient's preference independently" do
+    japanese = identities(:kevin)
+    japanese.update!(locale: :ja)
+    english = identities(:david)
+    ja_link = MagicLink.create!(identity: japanese)
+    en_link = MagicLink.create!(identity: english)
+
+    MagicLinkMailer.sign_in_instructions(ja_link).deliver_later
+    MagicLinkMailer.sign_in_instructions(en_link).deliver_later
+    perform_enqueued_jobs
+
+    assert_equal "Fizzyの確認コード：#{ja_link.code}", ActionMailer::Base.deliveries[-2].subject
+    assert_equal "Your Fizzy code is #{en_link.code}", ActionMailer::Base.deliveries[-1].subject
+    assert_equal :en, I18n.locale
+  end
+
+  test "anonymous signup locale is carried to delayed instructions" do
+    signup = Signup.new(email_address: "japanese-signup@example.com")
+    signup.create_identity(locale: :ja)
+    perform_enqueued_jobs
+    assert_includes ActionMailer::Base.deliveries.last.text_part.body.decoded, "アカウントの作成を完了"
+  end
+
+  test "bundle dates, count, content and links are Japanese" do
+    user = users(:kevin)
+    user.identity.update!(locale: :ja)
+    user.notifications.destroy_all
+    Notification::Bundle.where(user: user).destroy_all
+    notification = Notification.create!(user: user, creator: users(:david), source: events(:logo_published))
+    bundle = Notification::Bundle.create!(user: user, starts_at: Time.zone.local(2026, 2, 18, 10), ends_at: Time.zone.local(2026, 2, 18, 12))
+    notification.update_columns(created_at: bundle.starts_at + 1.minute, updated_at: bundle.starts_at + 1.minute)
+    email = Notification::BundleMailer.notification(bundle)
+
+    assert_match "新しい通知", email.subject
+    [ email.html_part, email.text_part ].each do |part|
+      assert_includes part.body.decoded, "2026年2月18日"
+      assert_includes part.body.decoded, "新しい通知1件"
+      assert_includes part.body.decoded, "locale=ja"
+      assert_not_includes part.body.decoded, "February"
+      assert_not_includes part.body.decoded, "new notification"
+    end
+  end
+
+  test "all account, import, export and confirmation mail is localized for the recipient" do
+    user = users(:david)
+    user.identity.update!(locale: :ja)
+    export = Account::Export.create!(account: Current.account, user: user)
+    import = Account::Import.create!(account: Current.account, identity: user.identity, status: :failed)
+    cancellation = Account::Cancellation.new(account: Current.account, initiated_by: user)
+    messages = [
+      [ AccountMailer.cancellation(cancellation), "Fizzyアカウントを解約しました" ],
+      [ ExportMailer.completed(export), "Fizzyデータのエクスポートをダウンロードできます" ],
+      [ ImportMailer.completed(user.identity, Current.account), "Fizzyアカウントのインポートが完了しました" ],
+      [ ImportMailer.failed(import), "Fizzyアカウントのインポートに失敗しました" ],
+      [ UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: user), "新しいメールアドレスを確認してください" ]
+    ]
+
+    messages.each do |message, subject|
+      assert_equal subject, message.subject
+      (message.multipart? ? message.parts : [ message ]).each do |part|
+        assert_match /[\p{Hiragana}\p{Katakana}]/, part.body.decoded
+        assert_not_includes part.body.decoded, "Your Fizzy"
+      end
+      assert_equal :en, I18n.locale
+    end
+  end
+end
