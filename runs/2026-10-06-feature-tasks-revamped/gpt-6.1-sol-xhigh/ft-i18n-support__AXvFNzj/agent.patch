diff --git a/config/locales/en_pluralization.rb b/config/locales/en_pluralization.rb
new file mode 100644
index 0000000..8543cd2
--- /dev/null
+++ b/config/locales/en_pluralization.rb
@@ -0,0 +1,10 @@
+{
+  en: {
+    i18n: {
+      plural: {
+        keys: [ :one, :other ],
+        rule: ->(count) { count == 1 ? :one : :other }
+      }
+    }
+  }
+}
