diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..a396963
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,47 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_locale(&action)
+      # Resolve the identity before authentication callbacks, including redirects.
+      Current.session ||= find_session_by_cookie
+      if !Current.identity && request.format.json?
+        Current.identity = authenticate_with_http_token do |token|
+          Identity.find_by_permissable_access_token(token, method: request.method)
+        end
+      end
+      requested_locale = params[:locale]
+      if supported_locale?(requested_locale)
+        session[:locale] = requested_locale
+      end
+
+      locale = session[:locale] || Current.identity&.locale || pending_identity_locale || I18n.default_locale
+      locale = I18n.default_locale unless supported_locale?(locale)
+      persist_locale_choice
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def pending_identity_locale
+      unless Current.identity
+        if email_address = email_address_pending_authentication
+          Identity.find_by(email_address: email_address)&.locale
+        end
+      end
+    end
+
+    def supported_locale?(locale)
+      (locale.is_a?(String) || locale.is_a?(Symbol)) && I18n.available_locales.include?(locale.to_sym)
+    end
+
+    def persist_locale_choice
+      if Current.identity && supported_locale?(session[:locale]) && Current.identity.locale != session[:locale]
+        Current.identity.update!(locale: session[:locale])
+      end
+    end
+end
