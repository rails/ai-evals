@@ -0,0 +1,31 @@
+require "test_helper"
+
+class NotificationLocalizationTest < ActiveSupport::TestCase
+  test "a live broadcast uses the recipient's locale, not the actor's" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.identity.update!(locale: :ja)
+
+    payloads = capture_turbo_stream_broadcasts [ notification.user, :notifications ] do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        notification.unread
+      end
+    end
+    html = payloads.map(&:to_html).join
+    assert_includes html, "カード番号"
+    assert_not_includes html, "Card number"
+    assert_equal :en, I18n.locale
+  end
+
+  test "push text uses the recipient's locale and restores the ambient locale" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.identity.update!(locale: :ja)
+    text = nil
+    target = Object.new
+    target.define_singleton_method(:process) { |record| text = record.payload.body }
+    Notification.stubs(:push_targets).returns([ target ])
+
+    notification.push
+    assert_includes text, "あなたに割り当てました"
+    assert_equal :en, I18n.locale
+  end
+end
