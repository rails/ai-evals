diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..5c5632a 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,67 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      # Cancellation and reactivation take the same lock. Check again in case an
+      # account was reactivated after the recurring job selected it.
+      if self.class.incineration_due.exists?(id: id)
+        incinerate_filter_resources
+        incinerate_storage_totals
+        incinerate_search_index
+        incinerate_account_records
+        delete
+      end
+    end
+  end
+
+  private
+    def incinerate_filter_resources
+      connection = self.class.connection
+      filter_ids = Filter.where(account_id: id).select(:id).to_sql
+
+      connection.tables.each do |table|
+        if connection.schema_cache.columns_hash(table).key?("filter_id")
+          connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filter_ids})")
+        end
+      end
+    end
+
+    def incinerate_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id)).delete_all
+    end
+
+    def incinerate_search_index
+      if Fizzy.db_adapter.sqlite?
+        record_ids = Search::Record.for(id).where(account_id: id).select(:id)
+        Search::Record::SQLite::Fts.where(rowid: record_ids).delete_all
+      end
+    end
+
+    def incinerate_account_records
+      # Delete by tenant rather than following associations: detached blobs,
+      # historical storage entries, and orphaned records must also be removed.
+      # Global identities and authentication records have no account_id.
+      connection = self.class.connection
+      quoted_id = connection.quote(id_for_database)
+
+      connection.tables.each do |table|
+        if connection.schema_cache.columns_hash(table).key?("account_id")
+          connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{quoted_id}")
+        end
+      end
+    end
 end
