diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..93ec08c
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+import { parseLocalTime, formatLocalTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+  #observer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, {
+      attributes: true, attributeFilter: [ "datetime" ],
+      childList: true, characterData: true, subtree: true
+    })
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.#observer?.disconnect()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const date = parseLocalTime(this.element.dateTime)
+
+    if (!Number.isNaN(date.getTime())) {
+      const text = formatLocalTime(date, this.formatValue)
+      if (this.element.textContent !== text) this.element.textContent = text
+      this.element.title = formatLocalTime(date, "title")
+    }
+  }
+}
