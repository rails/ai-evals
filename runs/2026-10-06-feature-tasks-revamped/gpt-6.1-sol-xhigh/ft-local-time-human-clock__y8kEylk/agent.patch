 module TimeHelper
+  def local_time_tag(time, format: :relative, **options)
+    # Dates represent calendar days; timestamps represent instants, independent of the server's zone.
+    datetime = time.respond_to?(:hour) ? time.to_time.getutc.iso8601 : time.iso8601
+    data = options.delete(:data) || {}
+
+    tag.time datetime, **options, datetime: datetime, data: data.merge(
+      controller: token_list(data[:controller], "local-time"),
+      local_time_format_value: format
+    )
+  end
 end
