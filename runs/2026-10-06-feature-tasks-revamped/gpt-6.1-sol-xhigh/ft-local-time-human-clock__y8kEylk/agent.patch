diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..eb6cca9
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a raw UTC timestamp with a browser controller" do
+    time = Time.new(2025, 9, 12, 13, 42, 0, "-07:00")
+    element = parse(local_time_tag(time))
+
+    assert_equal "2025-09-12T20:42:00Z", element["datetime"]
+    assert_equal element["datetime"], element.text
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "relative", element["data-local-time-format-value"]
+    assert_nil element["title"]
+    assert_equal(-7.hours, time.utc_offset)
+  end
+
+  test "the markup does not depend on the server's timezone or current time" do
+    time = Time.utc(2025, 9, 12, 20, 42)
+    html = Time.use_zone("America/Los_Angeles") { local_time_tag(time.in_time_zone) }
+
+    travel 3.days do
+      assert_equal html, Time.use_zone("Asia/Tokyo") { local_time_tag(time.in_time_zone) }
+    end
+  end
+
+  test "date-only values remain calendar dates" do
+    element = parse(local_time_tag(Date.new(2025, 9, 12), format: "long-date"))
+
+    assert_equal "2025-09-12", element["datetime"]
+    assert_equal "2025-09-12", element.text
+    assert_equal "long-date", element["data-local-time-format-value"]
+  end
+
+  test "preserves HTML options and other controllers" do
+    element = parse(local_time_tag(Time.current, format: :datetime, class: "timestamp", data: { controller: "other", custom: "value" }))
+
+    assert_equal "timestamp", element["class"]
+    assert_equal "other local-time", element["data-controller"]
+    assert_equal "value", element["data-custom"]
+    assert_equal "datetime", element["data-local-time-format-value"]
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+    end
+end
diff --git a/test/integration/local_times_test.rb b/test/integration/local_times_test.rb
new file mode 100644
index 0000000..186ab80
--- /dev/null
+++ b/test/integration/local_times_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class LocalTimesTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "comments send timestamps instead of server formatted dates" do
+    comment = comments(:logo_agreement_jz)
+    comment.update!(created_at: Time.utc(2025, 9, 12, 20, 42))
+
+    get card_path(comment.card)
+    assert_response :success
+
+    assert_select "##{dom_id(comment)} .comment__permalink-title time[datetime='2025-09-12T20:42:00Z'][data-controller='local-time']", text: "2025-09-12T20:42:00Z"
+  end
+
+  test "timestamps remain identical across server zones and time passing" do
+    card = cards(:logo)
+    cookies[:timezone] = "America/Los_Angeles"
+    get card_path(card)
+    timestamps = css_select("time[data-controller='local-time']").map(&:to_html)
+    assert_not_empty timestamps
+
+    travel 3.days do
+      cookies[:timezone] = "Asia/Tokyo"
+      get card_path(card)
+      assert_equal timestamps, css_select("time[data-controller='local-time']").map(&:to_html)
+    end
+  end
+
+  test "auto postponing notices send future timestamps without a baked-in countdown" do
+    card = cards(:logo)
+    get card_path(card)
+
+    assert_select "##{dom_id(card, :closure_notice)}" do
+      assert_select "time[datetime=?][data-local-time-format-value='relative-date']", card.entropy.auto_clean_at.utc.iso8601
+    end
+  end
+
+  test "closure stamps and native descriptions send timestamps" do
+    card = cards(:shipping)
+    card.closure.update!(created_at: Time.utc(2025, 9, 12, 20, 42))
+    get card_path(card)
+
+    assert_select ".card__closed-date time[datetime='2025-09-12T20:42:00Z'][data-local-time-format-value='full-date']"
+    assert_select "[data-controller='bridge--stamp'][data-bridge-timestamp='2025-09-12T20:42:00Z']"
+    assert_select "[data-controller='bridge--stamp'][data-bridge-description]", count: 0
+
+    share_data = JSON.parse(css_select("button[data-controller='bridge--share']").first["data-bridge--share-card-value"])
+    assert_equal card.created_at.utc.iso8601, share_data.fetch("createdAt")
+    assert_equal card.last_active_at.utc.iso8601, share_data.fetch("updatedAt")
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..b815c8a
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,210 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    set_browser_timezone "America/Los_Angeles"
+    sign_in_as users(:kevin)
+  end
+
+  teardown do
+    set_browser_timezone "UTC"
+  end
+
+  test "comments render in the browser's timezone" do
+    timestamp = page.evaluate_script("(() => { const date = new Date(); date.setHours(13, 42, 0, 0); return date.toISOString() })()")
+    comment = comments(:logo_agreement_jz)
+    comment.update!(created_at: Time.iso8601(timestamp))
+
+    visit card_url(comment.card)
+
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: "1:42 PM"
+  end
+
+  test "auto postponing notices read today, tomorrow, or in three days" do
+    card = cards(:logo)
+    { 0 => "today", 1 => "tomorrow", 3 => "in 3 days" }.each do |days, expected|
+      timestamp = page.evaluate_script("(() => { const date = new Date(); date.setDate(date.getDate() + #{days}); date.setHours(0, 1, 0, 0); return date.toISOString() })()")
+      card.update_column :last_active_at, Time.iso8601(timestamp) - card.auto_postpone_period
+      visit card_url(card)
+
+      assert_selector "##{dom_id(card, :closure_notice)}", text: "Moves to “Not Now” #{expected} if there’s no activity."
+    end
+  end
+
+  test "native share and stamp descriptions are formatted locally" do
+    card = cards(:shipping)
+    timestamp = Time.utc(2025, 9, 12, 20, 42)
+    card.update_columns(created_at: timestamp, last_active_at: timestamp)
+    card.closure.update!(created_at: timestamp)
+    visit card_url(card)
+    assert_selector ".card__closed-date time", text: "SEP 12, 2025"
+
+    descriptions = native_descriptions
+    assert_equal "Sep 12, 2025", descriptions.fetch("stamp")
+    assert_match /\AAdded Sep 12 by .*\. Updated Sep 12\z/, descriptions.fetch("share")
+
+    set_browser_timezone "Asia/Tokyo"
+    descriptions = native_descriptions
+    assert_equal "Sep 13, 2025", descriptions.fetch("stamp")
+    assert_match /\AAdded Sep 13 by .*\. Updated Sep 13\z/, descriptions.fetch("share")
+  end
+
+  test "relative timestamps use local calendar days" do
+    now = "2025-09-17T15:42:00-07:00"
+    {
+      "2025-09-17T13:42:00-07:00" => "1:42 PM",
+      "2025-09-17T16:42:00-07:00" => "4:42 PM",
+      "2025-09-16T23:59:00-07:00" => "yesterday",
+      "2025-09-12T12:00:00-07:00" => "5 days ago",
+      "2025-09-10T12:00:00-07:00" => "Sep 10",
+      "2024-12-31T12:00:00-08:00" => "Dec 31, 2024",
+      "2025-09-18T00:01:00-07:00" => "tomorrow",
+      "2025-09-20T12:00:00-07:00" => "in 3 days",
+      "2025-10-17T12:00:00-07:00" => "in 30 days"
+    }.each do |timestamp, expected|
+      assert_equal expected, format_time(timestamp, now: now), timestamp
+    end
+  end
+
+  test "day boundaries handle daylight saving, leap days, and year changes" do
+    [
+      [ "2025-03-09T23:59:00-07:00", "2025-03-08T00:01:00-08:00", "tomorrow" ],
+      [ "2025-11-02T23:59:00-08:00", "2025-11-01T00:01:00-07:00", "tomorrow" ],
+      [ "2025-03-08T23:59:00-08:00", "2025-03-09T00:01:00-08:00", "yesterday" ],
+      [ "2024-02-29T23:59:00-08:00", "2024-03-01T00:01:00-08:00", "yesterday" ],
+      [ "2026-01-01T00:01:00-08:00", "2025-12-31T23:59:00-08:00", "tomorrow" ]
+    ].each do |timestamp, now, expected|
+      assert_equal expected, format_time(timestamp, now: now)
+    end
+  end
+
+  test "the viewer's timezone wins and date-only headings do not shift days" do
+    timestamp = "2025-09-12T20:42:00Z"
+    assert_equal "1:42 PM", format_time(timestamp, format: "time")
+    assert_equal "9/12/25, 1:42 PM", format_time(timestamp, format: "datetime")
+    assert_equal "Friday, September 12", format_time("2025-09-12", format: "long-date")
+
+    set_browser_timezone "Asia/Tokyo"
+    assert_equal "5:42 AM", format_time(timestamp, format: "time")
+    assert_equal "Sep 13", format_time(timestamp, format: "date")
+    assert_equal "Friday, September 12", format_time("2025-09-12", format: "long-date")
+  end
+
+  test "timestamps connect in Turbo streams and update when morphed" do
+    page.execute_script <<~JS
+      Turbo.renderStreamMessage(`<turbo-stream action="append" target="main"><template>
+        <time id="local-time-test" datetime="2025-09-12T20:42:00Z"
+          data-controller="local-time" data-local-time-format-value="time">2025-09-12T20:42:00Z</time>
+      </template></turbo-stream>`)
+    JS
+    assert_selector "#local-time-test", text: "1:42 PM"
+    assert_match /Friday, September 12, 2025.*1:42 PM/, find("#local-time-test")["title"]
+
+    page.execute_script <<~JS
+      Turbo.renderStreamMessage(`<turbo-stream action="replace" method="morph" target="local-time-test"><template>
+        <time id="local-time-test" datetime="2025-09-12T21:42:00Z"
+          data-controller="local-time" data-local-time-format-value="time">2025-09-12T21:42:00Z</time>
+      </template></turbo-stream>`)
+    JS
+    assert_selector "#local-time-test", text: "2:42 PM"
+
+    # Morphing unchanged timestamps must not leave the server's raw fallback in the page.
+    page.execute_script 'document.querySelector("#local-time-test").firstChild.textContent = "2025-09-12T21:42:00Z"'
+    assert_selector "#local-time-test", text: "2:42 PM"
+
+    page.execute_script 'document.querySelector("#local-time-test").dataset.localTimeFormatValue = "full-date"'
+    assert_selector "#local-time-test", text: "Sep 12, 2025"
+  end
+
+  test "relative labels refresh across midnight and clean up on disconnect" do
+    page.execute_script <<~JS
+      window.RealDate = Date
+      window.localTimeNow = "2025-09-17T23:59:00-07:00"
+      window.Date = class extends RealDate {
+        constructor(...args) { super(...(args.length ? args : [window.localTimeNow])) }
+      }
+      const originalSetInterval = window.setInterval
+      const originalClearInterval = window.clearInterval
+      window.localTimeTimers = new Set()
+      window.localTimeRefreshes = []
+      window.setInterval = (callback, interval) => {
+        const timer = originalSetInterval(callback, interval)
+        if (interval === 60000) {
+          window.localTimeRefreshes.push(callback)
+          window.localTimeTimers.add(timer)
+        }
+        return timer
+      }
+      window.clearInterval = timer => {
+        window.localTimeTimers.delete(timer)
+        originalClearInterval(timer)
+      }
+      document.querySelector("main").insertAdjacentHTML("beforeend", `
+        <time id="local-time-test" datetime="2025-09-17T20:42:00Z" data-controller="local-time">raw</time>`)
+    JS
+    assert_selector "#local-time-test", text: "1:42 PM"
+    assert_operator page.evaluate_script("window.localTimeTimers.size"), :>=, 1
+
+    page.execute_script <<~JS
+      window.localTimeNow = "2025-09-18T00:01:00-07:00"
+      window.localTimeRefreshes.forEach(refresh => refresh())
+    JS
+    assert_selector "#local-time-test", text: "yesterday"
+
+    timer_count = page.evaluate_script("window.localTimeTimers.size")
+    page.execute_script 'document.querySelector("#local-time-test").remove()'
+    assert_no_selector "#local-time-test"
+    assert_equal timer_count - 1, page.evaluate_script("window.localTimeTimers.size")
+  end
+
+  test "invalid timestamps retain their fallback without throwing" do
+    assert_nil format_time("invalid")
+    page.execute_script <<~JS
+      document.querySelector("main").insertAdjacentHTML("beforeend", `
+        <time id="local-time-test" datetime="invalid" data-controller="local-time">fallback</time>`)
+    JS
+    assert_selector "#local-time-test", text: "fallback"
+    assert_empty find("#local-time-test")["title"]
+  end
+
+  private
+    def native_descriptions
+      page.evaluate_async_script <<~JS
+        const done = arguments[arguments.length - 1]
+        ;(async () => {
+          // Native-only controllers normally opt out in a regular browser.
+          if (!Stimulus.getControllerForElementAndIdentifier(document.querySelector("button[data-controller='bridge--share']"), "bridge--share")) {
+            const [{ default: Share }, { default: Stamp }] = await Promise.all([
+              import("controllers/bridge/share_controller"), import("controllers/bridge/stamp_controller")
+            ])
+            Stimulus.register("bridge--share", class extends Share { static get shouldLoad() { return true } })
+            Stimulus.register("bridge--stamp", class extends Stamp { static get shouldLoad() { return true } })
+            await new Promise(resolve => requestAnimationFrame(resolve))
+          }
+          const descriptions = {}
+          const shareElement = document.querySelector("button[data-controller='bridge--share']")
+          const share = Stimulus.getControllerForElementAndIdentifier(shareElement, "bridge--share")
+          share.send = (event, data) => descriptions.share = data.description
+          share.shareUrl()
+          const stampElement = document.querySelector("[data-controller='bridge--stamp']")
+          const stamp = Stimulus.getControllerForElementAndIdentifier(stampElement, "bridge--stamp")
+          stamp.send = (event, data) => descriptions.stamp = data.description
+          stamp.notifyBridgeOfConnect()
+          done(descriptions)
+        })()
+      JS
+    end
+
+    def set_browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def format_time(timestamp, format: "relative", now: "2025-09-17T15:42:00-07:00")
+      page.evaluate_async_script(<<~JS, timestamp, format, now)
+        const [timestamp, format, now, done] = arguments
+        import("helpers/date_helpers").then(({ parseLocalTime, formatLocalTime }) => {
+          done(formatLocalTime(parseLocalTime(timestamp), format, new Date(now)))
+        })
+      JS
+    end
+end
