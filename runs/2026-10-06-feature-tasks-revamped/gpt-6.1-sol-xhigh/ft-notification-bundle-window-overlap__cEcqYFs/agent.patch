+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_items, class_name: "Notification::Bundle::Item", dependent: :destroy
+    has_many :bundles, through: :bundle_items
+
+    after_save_commit :bundle_for_email, if: :source_previously_changed?
+  end
+
+  def bundle_for_email
+    if !creator.system? && user.active? && user.identity.present? && account.active?
+      Notification::Bundle.record(self)
+    end
+  end
+
+  private
+    def source_previously_changed?
+      source_id_previously_changed? || source_type_previously_changed?
+    end
+end
