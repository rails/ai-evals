diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..ad8836f
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @identity = Identity.create!(email_address: "digest-#{SecureRandom.hex(8)}@example.com")
+    @user = User.create!(account: accounts("37s"), identity: @identity, name: "Digest concurrency test")
+    @notifications = [ :logo_assignment_jz, :layout_commented ].map do |event_name|
+      @user.notifications.create!(source: events(event_name), creator: users(:david), unread_count: 1)
+    end
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  teardown do
+    @user&.destroy!
+    @identity&.destroy!
+  end
+
+  test "simultaneous notifications open only one window" do
+    concurrently_record(@notifications.map(&:id))
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, @user.notification_bundles.sole.items.count
+  end
+
+  test "simultaneous retries add a notification to its window only once" do
+    concurrently_record([ @notifications.first.id, @notifications.first.id ])
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, @user.notification_bundles.sole.items.count
+  end
+
+  private
+    def concurrently_record(notification_ids)
+      ready = Queue.new
+      start = Queue.new
+      threads = notification_ids.map do |id|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            notification = Notification.find(id)
+            ready << true
+            start.pop
+            Current.with_account(notification.account) { notification.bundle_for_email }
+          end
+        ensure
+          Current.reset
+        end
+      end
+
+      threads.size.times { ready.pop }
+      threads.size.times { start << true }
+      threads.each(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..a0b6b4e
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+    travel_to Time.utc(2026, 7, 10, 10)
+    @notification = @user.notifications.create!(source: events(:logo_assignment_jz), creator: users(:david), unread_count: 1)
+    @bundle = @notification.bundles.sole
+  end
+
+  test "a digest is not delivered before its window ends" do
+    assert_no_emails { @bundle.deliver }
+    assert_nil @bundle.reload.delivered_at
+  end
+
+  test "one digest contains all unread notifications in the window and is only sent once" do
+    second = @user.notifications.create!(source: events(:layout_commented), creator: users(:david), unread_count: 1)
+    travel 4.hours
+
+    assert_emails 1 do
+      @bundle.deliver
+      @bundle.deliver
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    [ @notification, second ].each do |notification|
+      assert_includes email.html_part.body.decoded, ERB::Util.html_escape(notification.card.title)
+      assert_includes email.text_part.body.decoded, notification.card.title
+      assert_includes email.text_part.body.decoded, notification.payload.url
+    end
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "delivery job carries account context and duplicate jobs do not send duplicate emails" do
+    travel 4.hours
+    saved_account = Current.account
+    Current.account = nil
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+      Notification::Bundle::DeliverJob.perform_now(@bundle)
+    end
+
+    assert_nil Current.account
+    assert_includes ActionMailer::Base.deliveries.last.text_part.body.decoded, @bundle.account.slug
+  ensure
+    Current.account = saved_account
+  end
+
+  test "turning email off cancels delivery of pending digests" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    travel 4.hours
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "read notifications are excluded and an empty digest is not sent" do
+    @notification.read
+    travel 4.hours
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "inactive users are not emailed" do
+    @user.deactivate
+    travel 4.hours
+
+    assert_no_emails { @bundle.deliver }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "failed delivery is left pending for retry" do
+    travel 4.hours
+    delivery = mock
+    delivery.expects(:deliver_now).twice.raises(IOError).then.returns(true)
+    NotificationMailer.expects(:bundle).with(@bundle).twice.returns(delivery)
+
+    assert_raises(IOError) { @bundle.deliver }
+    assert_nil @bundle.reload.delivered_at
+
+    @bundle.deliver
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "late arrivals after delivery open a new non-overlapping window at arrival time" do
+    travel 4.hours
+    @bundle.deliver
+    travel 1.hour
+    late = @user.notifications.create!(source: events(:layout_commented), creator: users(:david), updated_at: @bundle.starts_at - 1.hour)
+    latest = late.bundles.sole
+
+    assert_equal Time.current, latest.starts_at
+    assert_operator latest.starts_at, :>=, @bundle.ends_at
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "overlapping windows and nonpositive durations are rejected" do
+    overlapping = @user.notification_bundles.build(starts_at: @bundle.starts_at + 1.hour, ends_at: @bundle.ends_at + 1.hour)
+    assert_not overlapping.valid?
+    assert overlapping.errors.added?(:starts_at, "overlaps another window")
+
+    empty = @user.notification_bundles.build(starts_at: @bundle.ends_at, ends_at: @bundle.ends_at)
+    assert_not empty.valid?
+    assert empty.errors.added?(:ends_at, "must be after the start of the window")
+  end
+end
diff --git a/test/models/notification/bundling_test.rb b/test/models/notification/bundling_test.rb
new file mode 100644
index 0000000..6cabbd9
--- /dev/null
+++ b/test/models/notification/bundling_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class Notification::BundlingTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.notifications.destroy_all
+  end
+
+  test "the first notification opens a four hour window and subsequent notifications share it" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz)
+      bundle = first.bundles.sole
+
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_enqueued_with job: Notification::Bundle::DeliverJob, args: [ bundle ], at: bundle.ends_at
+
+      travel 2.hours
+      second = create_notification(:layout_commented)
+
+      assert_equal [ bundle ], second.bundles.to_a
+      assert_equal 1, @user.notification_bundles.count
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob
+      assert_equal [ first, second ].sort_by(&:id), bundle.notifications.order(:id).to_a
+    end
+  end
+
+  test "late notifications join the opened window even when their timestamp predates its start" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz)
+      bundle = first.bundles.sole
+      late = create_notification(:layout_commented, updated_at: 2.hours.ago)
+
+      assert_equal [ bundle ], late.bundles.to_a
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal Time.current, bundle.reload.starts_at
+    end
+  end
+
+  test "off does not open a window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(:logo_assignment_jz)
+    end
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob
+  end
+
+  test "each frequency determines the duration of a newly opened window" do
+    { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, interval|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      @user.notification_bundles.destroy_all
+      @user.notifications.destroy_all
+
+      travel_to Time.utc(2026, 7, 10, 10) do
+        bundle = create_notification(:logo_assignment_jz).bundles.sole
+        assert_equal interval, bundle.ends_at - bundle.starts_at
+      end
+    end
+  end
+
+  test "a notification at the end of a window opens an adjacent window" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz).bundles.sole
+      travel 4.hours
+      second = create_notification(:layout_commented).bundles.sole
+
+      assert_equal first.ends_at, second.starts_at
+      assert_equal 4.hours.from_now, second.ends_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "an idle gap does not create empty windows" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz).bundles.sole
+      travel 2.days
+      second = create_notification(:layout_commented).bundles.sole
+
+      assert_equal Time.current, second.starts_at
+      assert_operator first.ends_at, :<, second.starts_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "frequency changes do not shorten an open window or cause overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz).bundles.sole
+      travel 1.day
+      @user.settings.update!(bundle_email_frequency: "every_few_hours")
+      assert_equal first, create_notification(:layout_commented).bundles.sole
+
+      travel 6.days
+      second = create_notification(:buy_domain_sent_back_to_triage).bundles.sole
+      assert_equal first.ends_at, second.starts_at
+      assert_equal 4.hours.from_now, second.ends_at
+    end
+  end
+
+  test "repeated updates to one card are bundled once per window but can belong to multiple windows" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      notification = create_notification(:logo_assignment_jz)
+      first = notification.bundles.sole
+      travel 1.hour
+      notification.update!(source: events(:logo_assignment_david))
+      assert_equal 1, first.items.count
+      assert_equal 1, @user.notification_bundles.count
+
+      travel 3.hours
+      notification.update!(source: events(:logo_assignment_km))
+      assert_equal 2, notification.bundles.count
+      assert_equal [ notification ], first.notifications.to_a
+    end
+  end
+
+  test "read state changes do not open windows or enqueue deliveries" do
+    notification = create_notification(:logo_assignment_jz)
+    clear_enqueued_jobs
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.read
+      notification.unread
+    end
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob
+  end
+
+  test "replaying bundling is idempotent within a window" do
+    notification = create_notification(:logo_assignment_jz)
+
+    assert_no_difference -> { Notification::Bundle::Item.count } do
+      assert_no_difference -> { Notification::Bundle.count } do
+        2.times { notification.bundle_for_email }
+      end
+    end
+  end
+
+  test "late arrivals join the latest open window instead of creating a historical overlap" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz).bundles.sole
+      travel 4.hours
+      latest = create_notification(:layout_commented).bundles.sole
+      late = create_notification(:buy_domain_sent_back_to_triage, updated_at: first.starts_at - 1.hour)
+
+      assert_equal [ latest ], late.bundles.to_a
+      assert_equal 2, @user.notification_bundles.count
+      assert_operator latest.starts_at, :>=, first.ends_at
+    end
+  end
+
+  test "people have independent windows and frequencies" do
+    travel_to Time.utc(2026, 7, 10, 10) do
+      first = create_notification(:logo_assignment_jz).bundles.sole
+      other = users(:jz)
+      other.settings.update!(bundle_email_frequency: "daily")
+      other.notifications.destroy_all
+      travel 1.hour
+      second = other.notifications.create!(source: events(:layout_commented), creator: users(:david)).bundles.sole
+
+      assert_equal first.starts_at + 1.hour, second.starts_at
+      assert_equal 1.day, second.ends_at - second.starts_at
+      assert_equal @user, first.user
+      assert_equal other, second.user
+    end
+  end
+
+  test "daily and weekly windows use elapsed time across daylight saving changes" do
+    Time.use_zone("America/New_York") do
+      { "daily" => 24.hours, "weekly" => 7 * 24.hours }.each do |frequency, interval|
+        @user.settings.update!(bundle_email_frequency: frequency)
+        @user.notification_bundles.destroy_all
+        @user.notifications.destroy_all
+
+        travel_to Time.zone.local(2026, 3, 7, 12) do
+          bundle = create_notification(:logo_assignment_jz).bundles.sole
+          assert_equal interval, bundle.ends_at - bundle.starts_at
+        end
+      end
+    end
+  end
+
+  private
+    def create_notification(event_name, **attributes)
+      event = events(event_name)
+      @user.notifications.create!(source: event, creator: event.creator, unread_count: 1, **attributes)
+    end
+end
