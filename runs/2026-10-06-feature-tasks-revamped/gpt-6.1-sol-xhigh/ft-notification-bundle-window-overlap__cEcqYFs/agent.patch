diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..687d346
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,70 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :destroy
+  has_many :notifications, through: :items
+
+  validates :starts_at, :ends_at, presence: true
+  validate :window_does_not_overlap
+
+  after_create_commit :deliver_later
+
+  class << self
+    def record(notification)
+      user = notification.user
+
+      user.with_lock do
+        if interval = user.settings&.bundle_email_interval
+          latest = user.notification_bundles.order(starts_at: :desc).first
+
+          # A delayed notification can predate the start of an already opened window.
+          # Reuse that window instead of opening an overlapping one in the past.
+          bundle = if latest && latest.delivered_at.nil? && notification.updated_at < latest.ends_at
+            latest
+          else
+            starts_at = [ Time.current, notification.updated_at, latest&.ends_at ].compact.max
+            user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval.to_i)
+          end
+
+          bundle.items.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if delivered_at.nil? && ends_at <= Time.current
+        if emailable? && notifications.unread.exists?
+          Current.with_account(account) { NotificationMailer.bundle(self).deliver_now }
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliver_later
+      Current.with_account(account) do
+        Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+      end
+    end
+
+    def emailable?
+      user.active? && user.identity.present? && account.active? && user.settings&.bundle_email_interval.present?
+    end
+
+    def window_does_not_overlap
+      if starts_at && ends_at
+        if ends_at <= starts_at
+          errors.add(:ends_at, "must be after the start of the window")
+        elsif user && user.notification_bundles.where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at).exists?
+          errors.add(:starts_at, "overlaps another window")
+        end
+      end
+    end
+end
