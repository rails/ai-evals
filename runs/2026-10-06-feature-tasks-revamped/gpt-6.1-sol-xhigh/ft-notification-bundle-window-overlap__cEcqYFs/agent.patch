+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "email is off by default" do
+    settings = User::Settings.new
+    assert settings.bundle_email_frequency_never?
+    assert_nil settings.bundle_email_interval
+  end
+
+  test "email frequency accepts only the supported choices" do
+    settings = users(:kevin).settings
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert settings.valid?
+    end
+
+    [ nil, "hourly" ].each do |frequency|
+      settings.bundle_email_frequency = frequency
+      assert_not settings.valid?
+    end
+  end
+end
