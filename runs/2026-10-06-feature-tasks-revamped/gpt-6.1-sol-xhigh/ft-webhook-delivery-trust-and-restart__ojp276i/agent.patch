@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  test "duplicate jobs only POST once and only record one failure" do
+    delivery = webhooks(:active).deliveries.create!(event: events(:layout_commented))
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, delivery.webhook.url).to_return(status: 500)
+
+    2.times { Webhook::DeliveryJob.perform_now(delivery.reload) }
+
+    assert_requested request, times: 1
+    assert_equal 1, delivery.webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deleted deliveries are discarded" do
+    delivery = webhooks(:active).deliveries.create!(event: events(:layout_commented))
+    delivery.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+  end
+
+  test "job captures the delivery account rather than the caller account" do
+    delivery = nil
+    Current.with_account(accounts(:initech)) do
+      assert_enqueued_with(job: Webhook::DeliveryJob) do
+        delivery = webhooks(:active).deliveries.create!(event: events(:layout_commented))
+      end
+    end
+
+    job = enqueued_jobs.find { |job| job[:job] == Webhook::DeliveryJob }
+    assert_equal accounts(:'37s').to_gid, job["account"]
+
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, delivery.webhook.url).to_return(status: 204)
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested request, times: 1
+    assert delivery.reload.succeeded?
+  end
+end
diff --git a/test/models/event/webhookable_test.rb b/test/models/event/webhookable_test.rb
