@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @failure = webhook_deliveries(:unsuccessfully_completed)
+    @success = webhook_deliveries(:successfully_completed)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the receiver" do
+    travel_to Time.current do
+      9.times { @webhook.record_delivery_result(@failure) }
+      assert @webhook.reload.active?
+      assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+
+      travel 1.hour
+      @webhook.record_delivery_result(@failure)
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+      assert @webhook.delinquency_tracker.delinquent?
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate the receiver" do
+    travel_to Time.current do
+      10.times { @webhook.record_delivery_result(@failure) }
+      assert @webhook.reload.active?
+
+      travel 1.hour - 1.second
+      @webhook.record_delivery_result(@failure)
+      assert @webhook.reload.active?
+
+      travel 1.second
+      @webhook.record_delivery_result(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures over an hour do not deactivate the receiver" do
+    travel_to Time.current do
+      @webhook.record_delivery_result(@failure)
+      travel 2.hours
+      8.times { @webhook.record_delivery_result(@failure) }
+
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "a success resets both the count and the failure period" do
+    travel_to Time.current do
+      9.times { @webhook.record_delivery_result(@failure) }
+      travel 2.hours
+      @webhook.record_delivery_result(@success)
+
+      tracker = @webhook.reload.delinquency_tracker
+      assert_equal 0, tracker.consecutive_failures_count
+      assert_nil tracker.first_failure_at
+
+      @webhook.record_delivery_result(@failure)
+      tracker.reload
+      assert_equal 1, tracker.consecutive_failures_count
+      assert_equal Time.current, tracker.first_failure_at
+      assert @webhook.active?
+    end
+  end
+
+  test "network errors count as failures" do
+    @webhook.record_delivery_result(webhook_deliveries(:errored))
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "reactivating starts a fresh failure streak" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+    @webhook.record_delivery_result(@failure)
+
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_not @webhook.delinquency_tracker.delinquent?
+  end
+
+  test "inactive webhooks do not accumulate failures" do
+    @webhook.deactivate
+    @webhook.record_delivery_result(@failure)
+    assert_nil @webhook.reload.delinquency_tracker
+  end
+
+  test "deleting the webhook also deletes its tracker" do
+    @webhook.record_delivery_result(@failure)
+    tracker = @webhook.delinquency_tracker
+    @webhook.destroy!
+    assert_not Webhook::DelinquencyTracker.exists?(tracker.id)
+  end
+end
