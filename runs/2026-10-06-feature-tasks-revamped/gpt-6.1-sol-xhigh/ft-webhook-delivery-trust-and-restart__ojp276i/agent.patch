index 0000000..7d0b9db
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,24 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      update! consecutive_failures_count: consecutive_failures_count.to_i + 1, first_failure_at: first_failure_at || Time.current
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD && first_failure_at.present? && first_failure_at <= FAILURE_PERIOD.ago
+  end
+end
