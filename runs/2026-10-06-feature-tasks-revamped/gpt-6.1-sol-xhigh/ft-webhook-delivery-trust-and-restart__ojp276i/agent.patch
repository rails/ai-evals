diff --git a/app/models/webhook/delivery/attempt.rb b/app/models/webhook/delivery/attempt.rb
new file mode 100644
index 0000000..e432b6a
--- /dev/null
+++ b/app/models/webhook/delivery/attempt.rb
@@ -0,0 +1,76 @@
+require "net/http"
+
+class Webhook::Delivery::Attempt
+  RESPONSE_BODY_LIMIT = 10.kilobytes
+  NETWORK_ERRORS = [ Timeout::Error, SocketError, SystemCallError, EOFError, IOError, Net::ProtocolError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, OpenSSL::SSL::SSLError, Resolv::ResolvError ].freeze
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def request
+    @request ||= { headers: headers, body: body }
+  end
+
+  def perform
+    if ip = destination_ip
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = 5
+      http.read_timeout = 10
+      http.write_timeout = 10
+      http.max_retries = 0
+
+      post = Net::HTTP::Post.new(uri.request_uri, request[:headers])
+      post.body = request[:body]
+
+      result = nil
+      http.request(post) do |response|
+        result = { code: response.code.to_i, headers: response.to_hash, body: response_body(response) }
+      end
+      result
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue *NETWORK_ERRORS => error
+    { error: "destination_unreachable", message: error.class.name }
+  end
+
+  private
+    def uri
+      @uri ||= URI.parse(@delivery.webhook.url)
+    end
+
+    def destination_ip
+      address = IPAddr.new(uri.hostname)
+      address.to_s unless SsrfProtection.blocked_address?(address)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(uri.hostname)
+    end
+
+    def headers
+      {
+        "User-Agent" => "Fizzy Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Id" => @delivery.id,
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", @delivery.webhook.signing_secret, body)
+      }
+    end
+
+    def body
+      @body ||= ApplicationController.renderer.new(script_name: @delivery.account.slug).render(
+        template: "webhooks/event", formats: [ :json ], assigns: { event: @delivery.event }
+      )
+    end
+
+    def response_body(response)
+      body = +""
+      response.read_body do |chunk|
+        remaining = RESPONSE_BODY_LIMIT - body.bytesize
+        body << chunk.byteslice(0, remaining) if remaining > 0
+      end
+      body.force_encoding(Encoding::UTF_8).scrub("?")
+    end
+end
diff --git a/app/models/webhook/delivery/deliverable.rb b/app/models/webhook/delivery/deliverable.rb
new file mode 100644
index 0000000..0627e46
--- /dev/null
+++ b/app/models/webhook/delivery/deliverable.rb
@@ -0,0 +1,42 @@
+module Webhook::Delivery::Deliverable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :deliver_later
+  end
+
+  def deliver_later
+    Current.with_account(account) { Webhook::DeliveryJob.perform_later(self) }
+  end
+
+  def deliver
+    if claim
+      if webhook.reload.active?
+        attempt = Webhook::Delivery::Attempt.new(self)
+        update! request: attempt.request
+        finish attempt.perform
+      else
+        finish error: "webhook_inactive"
+      end
+    end
+  end
+
+  private
+    # Claim before doing any network I/O. A duplicate or retried job must never
+    # resend, even if the first worker stopped before it could save the response.
+    def claim
+      if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+        true
+      else
+        false
+      end
+    end
+
+    def finish(result)
+      webhook.with_lock do
+        update! response: result, state: result[:error].present? ? :errored : :completed
+        webhook.record_delivery_result(self)
+      end
+    end
+end
