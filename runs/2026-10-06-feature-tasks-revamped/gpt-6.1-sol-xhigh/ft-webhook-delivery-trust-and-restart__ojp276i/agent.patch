+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "a committed event queues a delivery for each active subscribed webhook on its board" do
+    webhook = webhooks(:active)
+    second = webhook.board.webhooks.create!(name: "Second", url: "https://second.example.com/webhook", subscribed_actions: [ "card_published" ])
+    webhook.board.webhooks.create!(name: "Unsubscribed", url: "https://unsubscribed.example.com/webhook", subscribed_actions: [ "card_closed" ])
+    webhook.board.webhooks.create!(name: "Inactive", url: "https://inactive.example.com/webhook", subscribed_actions: [ "card_published" ], active: false)
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = create_event
+      assert_equal [ webhook.id, second.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+      assert event.webhook_deliveries.all?(&:pending?)
+    end
+  end
+
+  test "an event is posted and logged by its queued job" do
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, webhooks(:active).url).to_return(status: 201)
+    event = nil
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      event = create_event
+    end
+
+    assert_requested request, times: 1
+    delivery = event.webhook_deliveries.sole
+    assert delivery.succeeded?
+    assert_equal event.id, JSON.parse(delivery.request[:body])["id"]
+  end
+
+  test "rolled back events do not queue deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction do
+          create_event
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "an event does not trigger webhooks on other boards" do
+    event = create_event(board: boards(:private))
+    assert_empty event.webhook_deliveries
+  end
+
+  private
+    def create_event(board: boards(:writebook))
+      Event.create!(board: board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+    end
+end
