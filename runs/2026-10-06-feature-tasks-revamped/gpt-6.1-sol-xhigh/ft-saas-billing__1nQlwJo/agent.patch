+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    Account::Subscription.process_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3e47281
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,72 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+  end
+
+  def billing_plan
+    if comped?
+      Subscription::UnlimitedPlusV1
+    elsif subscription&.paid?
+      Subscription.for_key(subscription.plan_key)
+    else
+      Subscription::FreeV1
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  # cards_count allocates card numbers, including drafts; it is not billable usage.
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && cards_remaining.between?(1, 100)
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def override_usage(**attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_usage_override
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def billing_subscription
+    with_lock do
+      reload_subscription || create_subscription!(stripe_customer_id: Account::Subscription.create_customer(self).id)
+    end
+  end
+end
