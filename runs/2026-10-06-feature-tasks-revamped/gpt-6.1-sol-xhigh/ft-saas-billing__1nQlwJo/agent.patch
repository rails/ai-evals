+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if params[:plan_key].in?(Subscription::PAID_PLAN_KEYS)
+      plan = Subscription.for_key(params[:plan_key])
+      subscription = Current.account.billing_subscription
+      session = if subscription.subscribed?
+        subscription.portal_session(return_url: saas.account_billing_url)
+      else
+        subscription.checkout_session(plan: plan, return_url: saas.account_billing_url)
+      end
+      redirect_to session.url, allow_other_host: true, status: :see_other
+    else
+      head :bad_request
+    end
+  rescue Stripe::StripeError
+    redirect_to saas.account_billing_path, alert: "Billing is temporarily unavailable. Please try again."
+  end
+end
