+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david
+  end
+
+  test "staff can browse accounts and support controls" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href='#{saas.admin_account_path(@account)}']", text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      %w[Comp Uncomp Reset].each { |label| assert_select "button", text: label }
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type='submit'][value='Override']"
+    end
+  end
+
+  test "staff can comp uncomp override and reset usage" do
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :redirect
+      assert @account.reload.comped?
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :redirect
+      assert_not @account.reload.comped?
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 950, bytes_used: 2_000 } }
+      assert_response :redirect
+      assert_equal 950, @account.reload.card_count
+      assert_equal 2_000, @account.bytes_used
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :redirect
+      assert_nil @account.reload.overridden_limits
+    end
+  end
+
+  test "non staff cannot view or change support billing data" do
+    logout_and_sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: 0 } }
+      assert_response :forbidden
+      delete saas.admin_account_overridden_limits_path(@account)
+      assert_response :forbidden
+    end
+    assert_nil @account.reload.overridden_limits
+    assert_not @account.comped?
+  end
+
+  test "invalid usage is rejected without replacing the override" do
+    @account.override_usage(card_count: 900)
+    untenanted do
+      patch saas.admin_account_overridden_limits_path(@account), params: { overridden_limits: { card_count: -1, bytes_used: -5 } }
+      assert_response :redirect
+    end
+    assert_equal 900, @account.reload.card_count
+    assert_nil @account.overridden_limits.bytes_used
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..3b22123
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    sign_in_as :mike
+    integration_session.default_url_options[:script_name] = @account.slug
+    @account.update_column(:cards_count, 2_000)
+  end
+
+  test "at the free limit drafts remain possible but publishing and API creation are forbidden" do
+    @account.override_usage(card_count: 1_000)
+    assert_no_difference -> { Card.published.count } do
+      post card_publish_path(@draft)
+      assert_response :forbidden
+      assert @draft.reload.drafted?
+      post board_cards_path(@board), params: { card: { title: "Blocked" } }, as: :json
+      assert_response :forbidden
+    end
+
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+    assert_difference -> { Card.drafted.count } do
+      post board_cards_path(@board)
+    end
+    assert_response :redirect
+  end
+
+  test "the card quota applies to staff unless the account is comped" do
+    @account.override_usage(card_count: 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+    post board_cards_path(@board), params: { card: { title: "Still free" } }, as: :json
+    assert_response :forbidden
+    @account.comp
+    post board_cards_path(@board), params: { card: { title: "Comped" } }, as: :json
+    assert_response :created
+  end
+
+  test "actual published usage enforces the boundary without counting drafts or card numbers" do
+    count = 999 - @account.card_count
+    Card.insert_all!(Array.new(count) do |index|
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: @board.id,
+        creator_id: users(:mike).id, title: "Quota card", status: "published", number: 10_000 + index,
+        created_at: Time.current, updated_at: Time.current, last_active_at: Time.current }
+    end)
+    assert_equal 999, @account.reload.card_count
+    post card_publish_path(@draft), as: :json
+    assert_response :created
+    assert_equal 1_000, @account.reload.card_count
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "No room left" } }, as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "the last free card can be published" do
+    @account.override_usage(card_count: 999)
+    post card_publish_path(@draft)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "paid and comped accounts can create beyond 1000 cards" do
+    @account.override_usage(card_count: 2_000)
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_cards", plan_key: "UnlimitedV1", status: "active")
+    post board_cards_path(@board), params: { card: { title: "Paid" } }, as: :json
+    assert_response :created
+    subscription.update!(status: "canceled")
+    @account.comp
+    post board_cards_path(@board), params: { card: { title: "Comped" } }, as: :json
+    assert_response :created
+  end
+
+  test "draft create buttons become an upgrade pitch at exhaustion" do
+    @account.override_usage(card_count: 1_000)
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+    assert_includes response.body, "You can still draft"
+  end
+
+  test "the warning counts down from 100 cards" do
+    @account.override_usage(card_count: 950)
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "board create buttons become Upgrade" do
+    @account.override_usage(card_count: 1_000)
+    get board_path(@board)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "form[action='#{board_cards_path(@board)}']", count: 0
+  end
+
+  test "paid storage allowance is enforced" do
+    @account.create_subscription!(stripe_customer_id: "cus_storage", plan_key: "UnlimitedV1", status: "active")
+    @account.override_usage(bytes_used: 2.gigabytes)
+    post board_cards_path(@board), params: { card: { title: "Within paid storage" } }, as: :json
+    assert_response :created
+    @account.override_usage(bytes_used: 5.gigabytes + 1)
+    post board_cards_path(@board), params: { card: { title: "Out of storage" } }, as: :json
+    assert_response :forbidden
+  end
+end
