+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      # Check and publish under one lock so concurrent requests cannot spend the last card twice.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
