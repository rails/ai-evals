diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..bd7a076
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,68 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  # Stripe event timestamps have second precision. Remember every ID at the latest timestamp.
+  attribute :last_event_ids, default: -> { [] }
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :account_id, uniqueness: true
+  validates :plan_key, inclusion: { in: ::Subscription::PAID_PLAN_KEYS }, allow_nil: true
+
+  def self.create_customer(account)
+    Stripe::Customer.create({ name: account.name, email: account.owner_email, metadata: { account_id: account.id } },
+      { idempotency_key: "fizzy-account-customer-#{account.id}" })
+  end
+
+  def self.process_event(event)
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      if subscription = find_by(stripe_customer_id: event.data.object.customer)
+        subscription.apply_event(event)
+      end
+    end
+  end
+
+  def paid?
+    status.in?(%w[ active trialing ]) && plan_key.in?(::Subscription::PAID_PLAN_KEYS)
+  end
+
+  def subscribed?
+    paid? || (stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ]))
+  end
+
+  def checkout_session(plan:, return_url:)
+    raise ArgumentError, "Unknown paid plan" unless plan.in?(::Subscription::PAID_PLAN_KEYS.map { |key| ::Subscription.for_key(key) })
+    raise Stripe::InvalidRequestError.new("Stripe price is not configured", "price") if plan.stripe_price_id.blank?
+
+    Stripe::Checkout::Session.create(
+      mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: return_url, cancel_url: return_url,
+      client_reference_id: account_id,
+      subscription_data: { metadata: { account_id: account_id } })
+  end
+
+  def portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url)
+  end
+
+  def apply_event(event)
+    with_lock do
+      if !last_event_ids.include?(event.id) && (!last_event_created || event.created >= last_event_created)
+        object = event.data.object
+        if event.type != "customer.subscription.deleted" || stripe_subscription_id.nil? || stripe_subscription_id == object.id
+          item = object.items.data.first
+          plan = ::Subscription.for_price(item&.price&.id)
+          update!(stripe_subscription_id: object.id, plan_key: plan&.short_name,
+            status: event.type == "customer.subscription.deleted" ? "canceled" : object.status,
+            current_period_end: timestamp(object[:current_period_end] || item&.[](:current_period_end)),
+            cancel_at: timestamp(object[:cancel_at]), last_event_ids: event.created == last_event_created ? last_event_ids + [ event.id ] : [ event.id ], last_event_created: event.created)
+        end
+      end
+    end
+  end
+
+  private
+    def timestamp(value)
+      Time.at(value).utc if value
+    end
+end
