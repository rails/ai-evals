diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..b742388
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_webhook")
+    @env = ENV.to_h.slice("STRIPE_WEBHOOK_SECRET", "STRIPE_MONTHLY_V1_PRICE_ID", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+  end
+
+  teardown do
+    %w[ STRIPE_WEBHOOK_SECRET STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ].each { |key| ENV[key] = @env[key] }
+  end
+
+  test "signed subscription changes update the plan without authentication or Stripe requests" do
+    deliver(event)
+    assert_response :success
+    assert_equal "UnlimitedV1", @subscription.reload.plan_key
+    assert_equal 5.gigabytes, @account.reload.storage_limit
+    deliver(event(id: "evt_plus", created: 2, price: "price_plus"))
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+    deliver(event(id: "evt_deleted", created: 3, type: "customer.subscription.deleted", status: "canceled"))
+    assert_equal 1_000, @account.reload.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "duplicate and older events cannot undo a later plan change" do
+    newer = event(id: "evt_new", created: 10, price: "price_plus")
+    deliver(newer)
+    updated_at = @subscription.reload.updated_at
+    deliver(newer)
+    assert_equal updated_at, @subscription.reload.updated_at
+    deliver(event(id: "evt_old", created: 9))
+    assert_equal "UnlimitedPlusV1", @subscription.reload.plan_key
+  end
+
+  test "a replay of an earlier event in the same second cannot undo the current plan" do
+    older = event(id: "evt_first", created: 10)
+    deliver(older)
+    deliver(event(id: "evt_second", created: 10, price: "price_plus"))
+    deliver(older)
+    assert_equal "UnlimitedPlusV1", @subscription.reload.plan_key
+  end
+
+  test "missing expired and malformed webhook signatures are rejected" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: event.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+    end
+    assert_response :bad_request
+    deliver(event, timestamp: 10.minutes.ago)
+    assert_response :bad_request
+    deliver("not json", raw: true)
+    assert_response :bad_request
+    assert_nil @subscription.reload.plan_key
+  end
+
+  test "a forged signature cannot change subscription state" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: event.to_json, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=#{Time.now.to_i},v1=forged" }
+    end
+    assert_response :bad_request
+    assert_nil @subscription.reload.plan_key
+  end
+
+  test "unknown customers and irrelevant events are acknowledged without granting a plan" do
+    deliver(event(customer: "cus_unknown"))
+    assert_response :success
+    assert_nil @subscription.reload.plan_key
+    deliver(event(type: "checkout.session.completed"))
+    assert_response :success
+    assert_nil @subscription.reload.plan_key
+  end
+
+  test "unrecognized prices and unpaid statuses do not grant paid allowances" do
+    deliver(event(price: "price_unknown"))
+    assert_equal 1_000, @account.reload.card_limit
+    deliver(event(id: "evt_past_due", created: 2, status: "past_due"))
+    assert_equal 1_000, @account.reload.card_limit
+  end
+
+  test "scheduled cancellation retains access until subscription ends" do
+    deliver(event(cancel_at: 2.days.from_now.to_i))
+    assert_nil @account.reload.card_limit
+    assert @subscription.reload.cancel_at
+  end
+
+  private
+    def event(id: "evt_test", created: 1, type: "customer.subscription.created", customer: "cus_webhook", price: "price_unlimited", status: "active", cancel_at: nil)
+      { id: id, created: created, type: type, data: { object: {
+        id: "sub_test", object: "subscription", customer: customer, status: status, cancel_at: cancel_at,
+        items: { object: "list", data: [ { id: "si_test", object: "subscription_item", price: { id: price, object: "price" }, current_period_end: 1.month.from_now.to_i } ] }
+      } } }
+    end
+
+    def deliver(payload, timestamp: Time.now, raw: false)
+      body = raw ? payload : payload.to_json
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, body, ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      untenanted do
+        post saas.stripe_webhooks_path, params: body, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=#{timestamp.to_i},v1=#{signature}" }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..1c891c5
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "approved free plan limits" do
+    assert_equal "Free", @account.billing_plan.proper_name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "drafts do not consume the card allowance" do
+    count = @account.card_count
+    @account.cards.create!(board: boards(:writebook), creator: users(:david), status: :drafted)
+    assert_equal count, @account.card_count
+  end
+
+  test "warning starts at 100 remaining cards and stops at exhaustion" do
+    @account.override_usage(card_count: 899)
+    assert_not @account.nearing_card_limit?
+    @account.override_usage(card_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+    @account.override_usage(card_count: 950)
+    assert_equal 50, @account.cards_remaining
+    @account.override_usage(card_count: 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans have unlimited cards and their own storage allowance" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_billing", plan_key: "UnlimitedV1", status: "active")
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    subscription.update!(plan_key: "UnlimitedPlusV1")
+    assert_equal 500.gigabytes, @account.storage_limit
+    subscription.update!(status: "canceled")
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp preserve the underlying subscription" do
+    @account.comp
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "usage overrides support zero and reset restores actual usage" do
+    count, bytes = @account.card_count, @account.bytes_used
+    @account.override_usage(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    @account.reset_usage_override
+    assert_equal count, @account.card_count
+    assert_equal bytes, @account.bytes_used
+  end
+
+  test "blank fields restore measured usage and bigint storage overrides are supported" do
+    count = @account.card_count
+    @account.override_usage(card_count: 950, bytes_used: 500.gigabytes)
+    assert_equal 500.gigabytes, @account.reload.bytes_used
+    @account.override_usage(card_count: "")
+    assert_equal count, @account.reload.card_count
+    assert_equal 500.gigabytes, @account.bytes_used
+  end
+
+  test "uncomp restores an existing paid subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_comp", plan_key: "UnlimitedV1", status: "active")
+    @account.comp
+    assert_equal 500.gigabytes, @account.storage_limit
+    @account.uncomp
+    assert_equal "Unlimited", @account.billing_plan.proper_name
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "negative overrides are invalid" do
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_usage(card_count: -1, bytes_used: -1) }
+  end
+end
