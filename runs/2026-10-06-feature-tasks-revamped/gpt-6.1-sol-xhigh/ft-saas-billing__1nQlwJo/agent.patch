diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..420deec
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike
+    integration_session.default_url_options[:script_name] = @account.slug
+    @old_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @old_price
+  end
+
+  test "admins see plans and Upgrade in settings" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Plan: Free"
+    assert_select "a", text: "Upgrade"
+    get saas.account_billing_path
+    assert_response :success
+    assert_includes response.body, "$20/month"
+    assert_includes response.body, "$25/month"
+    assert_includes response.body, "500 GB"
+  end
+
+  test "checkout uses a locally associated customer and a configured price" do
+    Stripe::Customer.expects(:create).with(
+      { name: @account.name, email: @account.owner_email, metadata: { account_id: @account.id } },
+      { idempotency_key: "fizzy-account-customer-#{@account.id}" }).returns(Stripe::Customer.construct_from(id: "cus_checkout"))
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" && params[:customer] == "cus_checkout" &&
+        params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        params[:success_url] == params[:cancel_url] && params[:success_url].include?(@account.slug)
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/test"))
+    post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedV1" }
+    assert_redirected_to "https://checkout.stripe.com/test"
+    assert_equal "cus_checkout", @account.reload.subscription.stripe_customer_id
+    assert_equal "Free", @account.billing_plan.proper_name
+  end
+
+  test "retrying checkout reuses the same customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_retry")
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).twice.with do |params|
+      params[:customer] == "cus_retry"
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/retry"))
+    2.times do
+      post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedV1" }
+      assert_redirected_to "https://checkout.stripe.com/retry"
+    end
+    assert_equal 1, Account::Subscription.where(account: @account).count
+  end
+
+  test "existing subscribers use Stripe portal instead of creating a second subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_portal", plan_key: "UnlimitedV1", status: "active")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:customer] == "cus_portal" && params[:return_url].include?(@account.slug)
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/test"))
+    post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedPlusV1" }
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "unpaid existing subscriptions use the portal instead of a duplicate checkout" do
+    @account.create_subscription!(stripe_customer_id: "cus_unpaid", stripe_subscription_id: "sub_unpaid", plan_key: "UnlimitedV1", status: "past_due")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/recover"))
+    post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedV1" }
+    assert_redirected_to "https://billing.stripe.com/recover"
+  end
+
+  test "portal uses the account customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_manage")
+    Stripe::BillingPortal::Session.expects(:create).with do |params|
+      params[:customer] == "cus_manage"
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/test"))
+    post saas.account_billing_portal_path
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "arbitrary Stripe price IDs and free checkout are rejected" do
+    Stripe::Customer.expects(:create).never
+    [ "price_attacker", "FreeV1", nil ].each do |key|
+      post saas.account_billing_checkout_path, params: { plan_key: key }
+      assert_response :bad_request
+    end
+  end
+
+  test "members cannot access billing or create Stripe sessions" do
+    logout_and_sign_in_as :jz
+    integration_session.default_url_options[:script_name] = accounts(:"37s").slug
+    Stripe::Customer.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).never
+    get saas.account_billing_path
+    assert_response :forbidden
+    post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedV1" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path
+    assert_response :forbidden
+    get account_settings_path
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "Stripe failures do not change plan or grant paid limits" do
+    @account.create_subscription!(stripe_customer_id: "cus_failure")
+    Stripe::Checkout::Session.expects(:create).raises(Stripe::APIConnectionError.new("unavailable"))
+    post saas.account_billing_checkout_path, params: { plan_key: "UnlimitedV1" }
+    assert_redirected_to saas.account_billing_path
+    assert_equal "Free", @account.reload.billing_plan.proper_name
+  end
+end
