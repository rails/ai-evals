diff --git a/db/migrate/20260710120000_add_searchable_content_to_cards_and_comments.rb b/db/migrate/20260710120000_add_searchable_content_to_cards_and_comments.rb
new file mode 100644
index 0000000..350c569
--- /dev/null
+++ b/db/migrate/20260710120000_add_searchable_content_to_cards_and_comments.rb
@@ -0,0 +1,44 @@
+class AddSearchableContentToCardsAndComments < ActiveRecord::Migration[8.2]
+  class Card < ActiveRecord::Base
+    self.table_name = "cards"
+  end
+
+  class Comment < ActiveRecord::Base
+    self.table_name = "comments"
+  end
+
+  class RichText < ActiveRecord::Base
+    self.table_name = "action_text_rich_texts"
+  end
+
+  def up
+    options = { limit: 4.gigabytes - 1 }
+    options[:collation] = "utf8mb4_bin" if connection.adapter_name.in?(%w[ Mysql2 Trilogy ])
+
+    add_column :cards, :searchable_content, :text, **options
+    add_column :comments, :searchable_content, :text, **options
+
+    backfill Card, "Card", "description"
+    backfill Comment, "Comment", "body"
+  end
+
+  def down
+    remove_column :cards, :searchable_content
+    remove_column :comments, :searchable_content
+  end
+
+  private
+    def backfill(model, record_type, name)
+      model.reset_column_information
+
+      model.find_in_batches(batch_size: 1000) do |records|
+        bodies = RichText.where(record_type: record_type, name: name, record_id: records.map(&:id)).pluck(:record_id, :body).to_h
+
+        records.each do |record|
+          text = ActionText::Content.new(bodies[record.id].to_s).to_plain_text
+          text = [ record.title, text.presence ].compact.join(" ") if record_type == "Card"
+          record.update_columns(searchable_content: text.downcase)
+        end
+      end
+    end
+end
