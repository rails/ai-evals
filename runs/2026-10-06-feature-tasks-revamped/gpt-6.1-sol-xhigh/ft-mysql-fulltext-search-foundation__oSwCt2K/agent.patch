+++ b/app/models/card/searchable.rb
@@ -0,0 +1,27 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+  include ::Searchable
+
+  class_methods do
+    def search(query)
+      terms = query.to_s.split.uniq
+
+      if terms.any?
+        cards = published
+        comments = Comment.where(card_id: cards.select(:id))
+
+        terms.reduce(cards) do |matches, term|
+          matches.matching_search(term)
+            .or(matches.where(id: comments.matching_search(term).select(:card_id)))
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+
+  private
+    def set_searchable_content
+      self.searchable_content = [ title, rich_text_description&.to_plain_text ].compact.join(" ").downcase
+    end
+end
