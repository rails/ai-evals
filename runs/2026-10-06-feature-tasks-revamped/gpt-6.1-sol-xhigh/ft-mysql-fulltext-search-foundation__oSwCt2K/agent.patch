diff --git a/app/models/concerns/searchable.rb b/app/models/concerns/searchable.rb
new file mode 100644
index 0000000..9926903
--- /dev/null
+++ b/app/models/concerns/searchable.rb
@@ -0,0 +1,23 @@
+module Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching_search, ->(query) do
+      terms = query.to_s.downcase.split.uniq
+
+      if terms.any?
+        matches = terms.map do |term|
+          arel_table[:searchable_content].matches("%#{sanitize_sql_like(term, "!")}%", "!", true)
+        end
+        where(matches.reduce(&:or))
+      else
+        none
+      end
+    end
+  end
+
+  def reindex_searchable_content
+    set_searchable_content
+    update_column :searchable_content, searchable_content
+  end
+end
