--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlight_search_matches(text, query)
+    terms = query.to_s.split.uniq.sort_by { |term| -term.length }
+
+    if terms.any?
+      pattern = Regexp.new("(#{Regexp.union(terms).source})", Regexp::IGNORECASE)
+      safe_join(text.to_s.split(pattern).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_excerpt(text, query)
+    terms = query.to_s.split.uniq.sort_by { |term| -term.length }
+    pattern = Regexp.new(Regexp.union(terms).source, Regexp::IGNORECASE)
+    snippet = excerpt(text, pattern, radius: 100) || truncate(text, length: 200, escape: false)
+    highlight_search_matches(snippet, query)
+  end
+end
