+require "test_helper"
+require_relative "../../db/migrate/20260710120000_add_searchable_content_to_cards_and_comments"
+
+class AddSearchableContentToCardsAndCommentsTest < ActiveSupport::TestCase
+  test "backfill makes existing titles descriptions and comments searchable without markup" do
+    Current.session = sessions(:kevin)
+    cards(:logo).update! description: "<p>Existing<strong>descriptionneedle</strong> &amp; café</p>"
+    comments(:logo_agreement_jz).update! body: "<p>Existing<strong>commentneedle</strong></p>"
+    Card.update_all searchable_content: nil
+    Comment.update_all searchable_content: nil
+
+    migration = AddSearchableContentToCardsAndComments.new
+    migration.send :backfill, AddSearchableContentToCardsAndComments::Card, "Card", "description"
+    migration.send :backfill, AddSearchableContentToCardsAndComments::Comment, "Comment", "body"
+
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_equal [ cards(:logo) ], Card.search("existingdescriptionneedle café")
+    assert_equal [ cards(:logo) ], Card.search("existingcommentneedle")
+    assert_equal [ cards(:layout) ], Card.search("overflowing")
+    assert_empty Card.search("<strong>")
+  end
+end
