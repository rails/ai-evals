@@ -0,0 +1,13 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query).preload(:board).with_rich_text_description
+    @matching_comments = matching_comments_for(@page.records)
+  end
+
+  private
+    def matching_comments_for(cards)
+      comment_ids = Comment.where(card_id: cards.map(&:id)).matching_search(@query).group(:card_id).maximum(:id).values
+      Comment.where(id: comment_ids).with_rich_text_body.index_by(&:card_id)
+    end
+end
