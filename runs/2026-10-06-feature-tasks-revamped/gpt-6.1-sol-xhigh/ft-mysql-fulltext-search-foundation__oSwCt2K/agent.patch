diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..a971204
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "existing titles and comment bodies are searchable" do
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_includes Card.search("overflowing"), cards(:layout)
+  end
+
+  test "title and description edits remove old matches and add new ones" do
+    card = cards(:logo)
+    card.update! title: "Oldtitleneedle", description: "Olddescriptionneedle"
+    assert_equal [ card ], Card.search("oldtitleneedle")
+    assert_equal [ card ], Card.search("olddescriptionneedle")
+
+    card.update! title: "Newtitleneedle", description: "Newdescriptionneedle"
+    assert_empty Card.matching_search("oldtitleneedle")
+    assert_empty Card.search("olddescriptionneedle")
+    assert_equal [ card ], Card.search("newtitleneedle")
+    assert_equal [ card ], Card.search("newdescriptionneedle")
+
+    card.update! description: ""
+    assert_empty Card.search("newdescriptionneedle")
+  end
+
+  test "comment edits and deletions update search results immediately" do
+    comment = cards(:logo).comments.create! creator: users(:kevin), body: "Oldcommentneedle"
+    assert_equal [ cards(:logo) ], Card.search("oldcommentneedle")
+
+    comment.update! body: "Newcommentneedle"
+    assert_empty Card.search("oldcommentneedle")
+    assert_equal [ cards(:logo) ], Card.search("newcommentneedle")
+
+    comment.destroy!
+    assert_empty Card.search("newcommentneedle")
+  end
+
+  test "visible rich text is searched rather than HTML markup" do
+    card = cards(:logo)
+    card.update! description: '<blockquote data-hiddenneedle="attribute">A rich<strong>textneedle</strong> &amp; entityneedle</blockquote>'
+    card.comments.create! creator: users(:kevin), body: '<div class="commenthiddenneedle">Comment<strong>textneedle</strong></div>'
+
+    assert_equal [ card ], Card.search("richtextneedle")
+    assert_equal [ card ], Card.search("commenttextneedle")
+    assert_equal [ card ], Card.search("& entityneedle")
+    assert_empty Card.search("blockquote")
+    assert_empty Card.search("hiddenneedle")
+  end
+
+  test "LIKE wildcards escape characters and regex metacharacters are literal" do
+    cards(:logo).update! title: 'Literal % _ ! a+b .* \\ characters'
+    cards(:layout).update! title: "Unrelated words"
+
+    [ "%", "_", "!", "a+b", ".*", "\\" ].each do |query|
+      assert_equal [ cards(:logo) ], Card.search(query), "Expected a literal match for #{query.inspect}"
+    end
+    assert_empty Card.search("' OR 1=1 --")
+  end
+
+  test "search is case insensitive including non ASCII text" do
+    cards(:logo).update! title: "CAFÉ title"
+    cards(:layout).update! description: "Éléphant description"
+
+    assert_equal [ cards(:logo) ], Card.search("café")
+    assert_empty Card.search("cafe")
+    assert_equal [ cards(:layout) ], Card.search("ÉLÉPHANT")
+  end
+
+  test "empty queries return no cards" do
+    [ nil, "", " \t\n " ].each do |query|
+      assert_empty Card.search(query)
+    end
+  end
+
+  test "published untitled cards are searchable without a description" do
+    card = boards(:writebook).cards.create! status: :published, creator: users(:kevin)
+
+    assert_equal "Untitled", card.title
+    assert_equal [ card ], Card.search("untitled")
+    assert_nil card.rich_text_description
+  end
+
+  test "cards with equal creation times are ordered by id descending" do
+    cards(:logo).update! title: "Orderneedle", created_at: Time.current
+    cards(:layout).update! title: "Orderneedle", created_at: cards(:logo).created_at
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id).reverse, Card.search("orderneedle")
+  end
+
+  test "search remains scoped to current board access when a card moves" do
+    card = cards(:shipping)
+    card.update! title: "Movingneedle"
+    assert_equal [ card ], users(:jz).accessible_cards.search("movingneedle")
+
+    card.move_to boards(:private)
+    assert_empty users(:jz).accessible_cards.search("movingneedle")
+    assert_equal [ card ], users(:kevin).accessible_cards.search("movingneedle")
+  end
+end
