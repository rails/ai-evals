diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..2cb757a
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights each matching word case insensitively" do
+    assert_equal "A <mark>Big</mark> <mark>red</mark> card, <mark>RED</mark> again", highlight_search_matches("A Big red card, RED again", "big red")
+  end
+
+  test "escapes both matched and unmatched text" do
+    assert_equal "&lt;script&gt;<mark>needle</mark>&lt;/script&gt;", highlight_search_matches("<script>needle</script>", "needle")
+    assert_equal "<mark>&lt;script&gt;</mark>needle&lt;/script&gt;", highlight_search_matches("<script>needle</script>", "<script>")
+    assert_equal "&lt;script&gt;", highlight_search_matches("<script>", "")
+  end
+
+  test "regex characters are matched literally" do
+    assert_equal "<mark>a+b</mark> ab", highlight_search_matches("a+b ab", "a+b")
+    assert_equal "<mark>.*</mark> text", highlight_search_matches(".* text", ".*")
+  end
+
+  test "excerpt includes a match from the middle of long text" do
+    text = ("before " * 100) + "Needle " + ("after " * 100)
+    snippet = search_excerpt(text, "needle")
+
+    assert_includes snippet, "<mark>Needle</mark>"
+    assert snippet.length < 250
+  end
+
+  test "unmatched excerpts remain escaped without double escaping" do
+    assert_equal "&lt;img src=x&gt; no match", search_excerpt("<img src=x> no match", "needle")
+    assert_equal "a &amp; b", search_excerpt("a & b", "needle")
+  end
+
+  test "overlapping terms highlight the longest match" do
+    assert_equal "<mark>cards</mark> <mark>card</mark>", highlight_search_matches("cards card", "card cards")
+  end
+end
