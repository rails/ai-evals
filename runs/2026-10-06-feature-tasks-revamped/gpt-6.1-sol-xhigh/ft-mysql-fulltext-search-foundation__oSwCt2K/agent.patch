diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..57bd3fa
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "search finds titles descriptions and comments newest first without duplicate cards" do
+    cards(:logo).update! title: "Searchneedle title", created_at: 3.days.ago
+    cards(:layout).update! description: "A Searchneedle description", created_at: 2.days.ago
+    cards(:text).update! created_at: 1.day.ago
+    cards(:text).comments.create! creator: users(:kevin), body: "First Searchneedle comment"
+    cards(:text).comments.create! creator: users(:kevin), body: "Second Searchneedle comment"
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { |card| card_path(card) },
+      css_select(".search-result__title a").map { |link| link["href"] }
+    assert_select ".search-result__title mark", text: "Searchneedle"
+    assert_select ".search-result__description mark", text: "Searchneedle"
+    assert_select ".search-result__comment mark", text: "Searchneedle"
+  end
+
+  test "search checks current board access including after it is revoked" do
+    cards(:logo).update! title: "Accessneedle", description: "Accessdescriptionneedle"
+    cards(:layout).comments.create! creator: users(:kevin), body: "Accesscommentneedle"
+
+    get search_path, params: { q: "accessneedle" }
+    assert_response :success
+    assert_select ".search-result", count: 1
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    %w[ accessneedle accessdescriptionneedle accesscommentneedle ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "draft titles descriptions and comments are excluded" do
+    card = cards(:logo)
+    card.update! title: "Draftneedle", description: "Draftneedle description"
+    card.comments.create! creator: users(:kevin), body: "Draftcommentneedle"
+    card.drafted!
+
+    %w[ draftneedle draftcommentneedle ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select ".search-result", count: 0
+    end
+  end
+
+  test "blank queries show a search form without listing cards" do
+    [ nil, "", "  \t\n" ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "form[action=?][method=get] input[name=q]", search_path
+      assert_select ".search-result", count: 0
+      assert_select ".search__empty", text: "Find cards by their title, description, or comments."
+    end
+  end
+
+  test "results are limited to this account and to accessible boards" do
+    cards(:logo).update! title: "Tenantneedle"
+    boards(:private).cards.create! title: "Tenantneedle private", status: :published, creator: users(:kevin)
+    Current.set(account: accounts(:initech), user: users(:mike)) do
+      cards(:radio).update! title: "Tenantneedle other account"
+      cards(:radio).comments.create! body: "Tenantneedle foreign comment", creator: users(:mike)
+    end
+
+    users(:mike).update! identity: identities(:jz)
+    logout_and_sign_in_as :jz
+    get search_path, params: { q: "tenantneedle" }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title a", text: "Tenantneedle"
+    assert_no_match "Tenantneedle private", response.body
+    assert_no_match "Tenantneedle other account", response.body
+    assert_no_match "Tenantneedle foreign comment", response.body
+  end
+
+  test "all query words can match across the title description and different comments" do
+    cards(:logo).update! title: "Alpha title", description: "Beta description"
+    cards(:logo).comments.create! creator: users(:kevin), body: "Gamma comment"
+    cards(:logo).comments.create! creator: users(:kevin), body: "Delta comment"
+    cards(:layout).update! title: "Alpha beta gamma without the last word"
+
+    get search_path, params: { q: "  alpha BETA gamma delta  " }
+
+    assert_response :success
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "Alpha"
+    assert_select ".search-result__description mark", text: "Beta"
+    assert_select ".search-result__comment mark", text: /Gamma|Delta/
+    assert_select "input[name=q][value=?]", "alpha BETA gamma delta"
+  end
+
+  test "highlighted card text and the query are escaped" do
+    cards(:logo).update! title: "<img src=x onerror=alert(1)> Safetyneedle",
+      description: "<p>&lt;script&gt;Safetyneedle&lt;/script&gt;</p>"
+    cards(:logo).comments.create! creator: users(:kevin), body: "<p>&lt;svg onload=alert(1)&gt;Safetyneedle</p>"
+
+    get search_path, params: { q: "safetyneedle" }
+
+    assert_response :success
+    assert_select ".search-result img, .search-result script, .search-result svg", count: 0
+    assert_select ".search-result mark", text: "Safetyneedle", count: 3
+    assert_select ".search-result__title", text: "<img src=x onerror=alert(1)> Safetyneedle"
+
+    get search_path, params: { q: "<img src=x onerror=alert(2)>" }
+    assert_response :success
+    assert_select ".search__empty img", count: 0
+  end
+
+  test "comment matches link directly to the matching comment" do
+    comment = cards(:logo).comments.create! creator: users(:kevin), body: "Commentlinkneedle"
+
+    get search_path, params: { q: "commentlinkneedle" }
+
+    assert_response :success
+    assert_select ".search-result__comment a[href=?]", card_path(cards(:logo), anchor: dom_id(comment))
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :redirect
+    assert_select ".search-result", count: 0
+  end
+
+  test "pagination preserves the query and newest first order" do
+    matches = 17.times.map do |index|
+      boards(:writebook).cards.create! title: "Paginationneedle #{index}", status: :published,
+        creator: users(:kevin), created_at: Time.current + index.minutes
+    end.reverse
+
+    get search_path, params: { q: "paginationneedle" }
+
+    assert_response :success
+    assert_equal matches.first(15).map { |card| card_path(card) }, css_select(".search-result__title a").map { |link| link["href"] }
+    assert_select "a.pagination-link[href=?]", search_path(q: "paginationneedle", page: 2)
+
+    get search_path, params: { q: "paginationneedle", page: 2 }
+
+    assert_response :success
+    assert_equal matches.last(2).map { |card| card_path(card) }, css_select(".search-result__title a").map { |link| link["href"] }
+  end
+end
