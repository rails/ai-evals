+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search cards</h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Titles, descriptions, and comments", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn btn--positive" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <%= render partial: "searches/result", collection: @page.records, as: :card %>
+    <% end %>
+    <% if @page.records.empty? %>
+      <p class="search__empty">No cards match “<%= @query %>”.</p>
+    <% end %>
+  <% else %>
+    <p class="search__empty">Find cards by their title, description, or comments.</p>
+  <% end %>
+</section>
