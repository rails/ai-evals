new file mode 100644
index 0000000..0358e10
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,24 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order(:created_at, :id) }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  private
+    def broadcast_creation
+      broadcast_append_to comment.card, :activity, target: [ comment, :reactions ]
+    end
+
+    def broadcast_removal
+      broadcast_remove_to comment.card, :activity
+    end
+end
