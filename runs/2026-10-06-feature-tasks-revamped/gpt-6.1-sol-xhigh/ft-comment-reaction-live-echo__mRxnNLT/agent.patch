--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,42 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      render :create
+    else
+      render turbo_stream: turbo_stream.update([ @comment, :reaction_errors ], @reaction.errors.full_messages.to_sentence), status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_composer_controller.js b/app/javascript/controllers/reaction_composer_controller.js
new file mode 100644
index 0000000..f5229d3
--- /dev/null
+++ b/app/javascript/controllers/reaction_composer_controller.js
@@ -0,0 +1,47 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "composer", "form", "input", "errors" ]
+  static values = { maximumLength: Number }
+
+  connect() {
+    // Native maxlength counts UTF-16 units, so an emoji would consume two characters.
+    // Validate Unicode characters instead, matching the server's length validation.
+    this.inputTarget.removeAttribute("maxlength")
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.composerTarget.classList.add("reaction", "expanded")
+    this.composerTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.reset()
+    this.clearErrors()
+    this.composerTarget.hidden = true
+    this.composerTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitted(event) {
+    if (event.detail.success) {
+      this.cancel()
+    }
+  }
+
+  validate() {
+    this.clearErrors()
+
+    if (Array.from(this.inputTarget.value.trim()).length > this.maximumLengthValue) {
+      this.inputTarget.setCustomValidity(`Use at most ${this.maximumLengthValue} characters.`)
+    }
+  }
+
+  clearErrors() {
+    this.errorsTarget.textContent = ""
+    this.inputTarget.setCustomValidity("")
+  }
+}
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..815900e
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "trigger", "removal" ]
+
+  connect() {
+    this.removalTarget.hidden = !this.#isOwnReaction
+
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.triggerTarget.setAttribute("role", "button")
+      this.triggerTarget.setAttribute("tabindex", "0")
+      this.triggerTarget.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+      this.triggerTarget.setAttribute("aria-label", `${this.element.title}. Show removal option`)
+    }
+  }
+
+  toggle(event) {
+    if (this.#isOwnReaction && !event.target.closest("form")) {
+      event.preventDefault()
+      this.element.classList.toggle("expanded")
+      this.triggerTarget.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+    }
+  }
+
+  collapse(event) {
+    if (this.#isOwnReaction) {
+      event.preventDefault()
+      this.element.classList.remove("expanded")
+      this.triggerTarget.setAttribute("aria-expanded", "false")
+      this.triggerTarget.focus()
+    }
+  }
+
+  get #isOwnReaction() {
+    return this.element.dataset.creatorId === getMetaContent("current-user-id")
+  }
+}
