+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "compose, cancel, confirm, and remove reactions" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Draft"
+      click_on "Cancel reaction"
+      assert_no_selector "input[name='reaction[content]']"
+
+      click_on "Add a reaction"
+      assert_field "Your reaction", with: ""
+      fill_in "Your reaction", with: "🎉"
+      click_on "Confirm reaction"
+
+      assert_selector ".reaction", text: "🎉", count: 1
+      assert_no_selector "input[name='reaction[content]']"
+      assert_button "Add a reaction"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Thanks!"
+      find("input[name='reaction[content]']").send_keys :enter
+      assert_selector ".reaction", text: "Thanks!", count: 1
+      assert_no_selector "input[name='reaction[content]']"
+
+      find(".reaction", text: "🎉").click
+      click_on "Remove your reaction"
+      assert_no_selector ".reaction", text: "🎉"
+      assert_selector ".reaction", text: "Thanks!"
+    end
+  end
+
+  test "escape cancels and whitespace cannot be submitted" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "   "
+      click_on "Confirm reaction"
+      assert_selector "input[name='reaction[content]']"
+      assert_no_selector ".reactions__list .reaction"
+
+      find("input[name='reaction[content]']").send_keys :escape
+      assert_no_selector "input[name='reaction[content]']"
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "incoming reactions and removals are live and preserve a draft" do
+    wait_for_cable_subscriptions
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "My reaction"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "My reaction"
+    end
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "My draft"
+    end
+
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Nice!")
+    within_comment do
+      assert_selector ".reaction", text: "Nice!", wait: 5
+      assert_field "Your reaction", with: "My draft"
+      find(".reaction", text: "Nice!").click
+      assert_no_button "Remove your reaction"
+    end
+
+    # Exercise a page refresh separately from the immediate reaction broadcasts.
+    # Performing all queued refresh jobs can also deliver the author's own refresh,
+    # whose request ID intentionally suppresses the browser's debounced refresh.
+    @comment.card.update_columns(title: "Reactions refreshed")
+    @comment.card.broadcast_refresh
+    assert_selector "h1", text: "Reactions refreshed", wait: 5
+
+    within_comment do
+      assert_field "Your reaction", with: "My draft"
+      own_reaction = find(".reaction", text: "My reaction").find("[data-reaction-target='trigger']")
+      own_reaction.send_keys :enter
+      assert_button "Remove your reaction"
+      own_reaction.send_keys :escape
+      assert_no_button "Remove your reaction"
+    end
+
+    reaction.destroy!
+
+    within_comment do
+      assert_no_selector ".reaction", text: "Nice!", wait: 5
+      assert_field "Your reaction", with: "My draft"
+    end
+  end
+
+  test "the limit counts emoji as characters and rejects overlong text" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "a" * 17
+      click_on "Confirm reaction"
+      assert_no_selector ".reactions__list .reaction"
+      assert_selector "input[name='reaction[content]']"
+
+      fill_in "Your reaction", with: "🎉" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "🎉" * 16
+      assert_no_selector "input[name='reaction[content]']"
+    end
+  end
+
+  test "server validation errors keep the composer open for correction" do
+    within_comment do
+      click_on "Add a reaction"
+      input = find("input[name='reaction[content]']")
+      page.execute_script("arguments[0].value = 'a'.repeat(17)", input)
+      click_on "Confirm reaction"
+
+      assert_selector "[role='alert']", text: "is too long"
+      assert_field "Your reaction", with: "a" * 17
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Your reaction", with: "Fixed"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "Fixed"
+      assert_no_selector "input[name='reaction[content]']"
+    end
+  end
+
+  private
+
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
