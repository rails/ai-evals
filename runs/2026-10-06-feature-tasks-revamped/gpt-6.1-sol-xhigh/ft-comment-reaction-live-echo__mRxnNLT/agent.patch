diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..7405ef9
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "comments have a reactions strip and a short reaction composer" do
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "#comment_#{@comment.id} .reactions" do
+      assert_select ".reactions__list"
+      assert_select ".reactions__trigger"
+      assert_select "input[name='reaction[content]'][maxlength='16']"
+      assert_select ".reaction__submit-btn"
+      assert_select ".reaction__cancel-btn"
+    end
+  end
+
+  test "create a reaction as its signed-in author" do
+    assert_difference "Reaction.count", 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = Reaction.last
+    assert_equal @comment, reaction.comment
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_select "turbo-stream[action='append'][target='reactions_comment_#{@comment.id}']"
+    assert_select ".reaction", text: /🎉/
+  end
+  test "the author and account cannot be supplied by the client" do
+    post card_comment_reactions_path(@comment.card, @comment), params: {
+      reaction: { content: "Thanks", creator_id: users(:jz).id, account_id: accounts(:initech).id }
+    }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal users(:kevin), Reaction.last.creator
+    assert_equal @comment.account, Reaction.last.account
+  end
+
+  test "invalid content returns errors without storing or broadcasting a reaction" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_difference "Reaction.count", 0 do
+        assert_turbo_stream_broadcasts([ @comment.card, :activity ], count: 0) do
+          post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+        end
+      end
+
+      assert_response :unprocessable_entity
+      assert_select "turbo-stream[action='update'][target='reaction_errors_comment_#{@comment.id}']"
+    end
+  end
+
+  test "sixteen characters are accepted" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "a" * 16 } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal "a" * 16, Reaction.last.content
+  end
+
+  test "an author can remove their reaction" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "Thanks")
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action='remove'][target='reaction_#{reaction.id}']"
+  end
+
+  test "even an admin cannot remove another person's reaction" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Thanks")
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a comment must belong to the card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Thanks" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "a reaction must belong to the comment" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(creator: users(:kevin), content: "Thanks")
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "an inaccessible card cannot receive reactions" do
+    logout_and_sign_in_as :david
+    @comment.card.update_columns(board_id: boards(:private).id, column_id: nil)
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Thanks" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cached comments display reactions and identify their authors" do
+    with_actionview_partial_caching do
+      get card_path(@comment.card)
+      reaction = @comment.reactions.create!(creator: users(:jz), content: "<b>nice</b>")
+      get card_path(@comment.card)
+
+      assert_response :success
+      assert_select "#reaction_#{reaction.id}[data-creator-id='#{users(:jz).id}']" do
+        assert_select ".reaction__avatar[aria-label='JZ']"
+        assert_select "span", text: "<b>nice</b>"
+        assert_select "b", count: 0
+        assert_select "form[data-reaction-target='removal'][hidden]"
+      end
+
+      reaction.destroy!
+      get card_path(@comment.card)
+      assert_select "#reaction_#{reaction.id}", count: 0
+    end
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..7123d7b
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "content is required and limited to sixteen characters" do
+    [ nil, "", "  ", "a" * 17, "🎉" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?
+    end
+
+    [ "🎉", "Great work!", "a" * 16, "🎉" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?
+    end
+  end
+
+  test "creation broadcasts the reaction to people viewing the card" do
+    reaction = nil
+    streams = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) do
+      reaction = @comment.reactions.create!(content: "🎉")
+    end
+
+    assert_equal 1, streams.size
+    assert_equal "append", streams.first["action"]
+    assert_equal "reactions_comment_#{@comment.id}", streams.first["target"]
+    assert_equal "reaction_#{reaction.id}", streams.first.at_css(".reaction")["id"]
+    assert_includes streams.first.to_html, users(:kevin).name
+    assert_includes streams.first.to_html, card_comment_reaction_path_for(reaction)
+  end
+
+  test "removal broadcasts to people viewing the card" do
+    reaction = @comment.reactions.create!(content: "Thanks")
+    streams = capture_turbo_stream_broadcasts([ @comment.card, :activity ]) { reaction.destroy! }
+
+    assert_equal 1, streams.size
+    assert_equal "remove", streams.first["action"]
+    assert_equal "reaction_#{reaction.id}", streams.first["target"]
+  end
+
+  test "creating and removing reactions invalidates the comment cache" do
+    original_cache_key = @comment.cache_key_with_version
+    reaction = @comment.reactions.create!(content: "Thanks")
+    assert_not_equal original_cache_key, @comment.reload.cache_key_with_version
+
+    original_cache_key = @comment.cache_key_with_version
+    reaction.destroy!
+    assert_not_equal original_cache_key, @comment.reload.cache_key_with_version
+  end
+
+  test "a person can leave more than one reaction" do
+    assert_difference "Reaction.count", 2 do
+      @comment.reactions.create!(content: "🎉")
+      @comment.reactions.create!(content: "Thanks")
+    end
+  end
+
+  test "deleting a comment deletes its reactions" do
+    reaction = @comment.reactions.create!(content: "Thanks")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "deleting an author deletes their reactions on other people's comments" do
+    reaction = @comment.reactions.create!(content: "Thanks")
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  private
+    def card_comment_reaction_path_for(reaction)
+      Rails.application.routes.url_helpers.card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction, script_name: Current.account.slug)
+    end
+end
