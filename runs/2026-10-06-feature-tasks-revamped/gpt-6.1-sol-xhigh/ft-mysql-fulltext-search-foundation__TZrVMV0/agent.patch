diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..abf61f5
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,174 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles, descriptions, and comments, newest first without duplicates" do
+    cards(:logo).update! title: "Searchneedle in the title", created_at: 3.days.ago
+    cards(:layout).update! description: "<p>A searchneedle in the description</p>", created_at: 2.days.ago
+    cards(:text).update! created_at: 1.day.ago
+    cards(:text).comments.create! body: "A SEARCHNEEDLE in a comment", creator: users(:kevin)
+    cards(:text).comments.create! body: "Another searchneedle", creator: users(:kevin)
+
+    search "searchneedle"
+
+    assert_response :success
+    assert_equal cards(:text, :layout, :logo).map { |card| dom_id(card, :search_result) },
+      css_select(".search-result").map { |result| result["id"] }
+    assert_select ".search-result__title mark", text: "Searchneedle"
+    assert_select ".search-result__description mark", text: "searchneedle"
+    assert_select ".search-result__comment mark", text: "SEARCHNEEDLE"
+  end
+
+  test "only cards from currently accessible boards are returned" do
+    private_card = create_card(board: boards(:private))
+    other_board = Board.create! name: "Inaccessible", creator: users(:david), all_access: false, account: accounts("37s")
+    hidden_card = create_card(board: other_board, title: "Unrelated")
+    hidden_card.comments.create! body: "searchneedle", creator: users(:david)
+    cards(:radio).update_columns title: "searchneedle"
+
+    search "searchneedle"
+    assert_results private_card
+
+    boards(:private).accesses.delete_by(user: users(:kevin))
+
+    search "searchneedle"
+    assert_results
+  end
+
+  test "draft cards and comments on draft cards are never returned" do
+    create_card(status: :drafted, description: "searchneedle")
+    comment_only_draft = create_card(title: "Unrelated")
+    comment_only_draft.comments.create! body: "searchneedle", creator: users(:kevin)
+    comment_only_draft.update_column :status, "drafted"
+
+    search "searchneedle"
+
+    assert_response :success
+    assert_results
+    assert_select ".search-result__comment", count: 0
+  end
+
+  test "missing and blank queries show the search form without listing cards" do
+    [ nil, "", "   " ].each do |query|
+      search query
+      assert_response :success
+      assert_results
+      assert_select "form[action=?][method=get] input[type=search][name=q]", search_path
+    end
+  end
+
+  test "no matches shows an empty result message" do
+    search "not-a-match-anywhere"
+
+    assert_response :success
+    assert_results
+    assert_select "p", text: "No cards found for “not-a-match-anywhere”."
+  end
+
+  test "queries are trimmed and case insensitive" do
+    cards(:logo).update_columns title: "A SearchNeedle"
+
+    search "  sEaRcHnEeDlE  "
+
+    assert_results cards(:logo)
+    assert_select ".search-result__title mark", text: "SearchNeedle"
+    assert_select "input[name=q][value=?]", "sEaRcHnEeDlE"
+  end
+
+  test "wildcards and SQL or regular expression syntax are literal" do
+    [ "%", "_", "!", "\\", "[.*]", "' OR 1=1 --" ].each do |term|
+      cards(:logo).update_columns title: "Literal #{term} here"
+
+      search term
+
+      assert_response :success
+      assert_results cards(:logo)
+      assert_select ".search-result__title mark", text: term
+    end
+  end
+
+  test "rich text is searched as visible text, not HTML tags or attributes" do
+    cards(:logo).update! description: '<div data-hidden="hiddenneedle">A search<strong>needle</strong> &amp; more</div>'
+
+    search "searchneedle & more"
+
+    assert_results cards(:logo)
+    assert_select ".search-result__description mark", text: "searchneedle & more"
+
+    search "hiddenneedle"
+    assert_results
+  end
+
+  test "comments with inline formatting and entities are searchable" do
+    cards(:logo).comments.create! body: "<p>A comment<strong>needle</strong> &amp; more</p>", creator: users(:kevin)
+
+    search "commentneedle & more"
+
+    assert_results cards(:logo)
+    assert_select ".search-result__comment mark", text: "commentneedle & more"
+  end
+
+  test "search results escape titles and rich text while highlighting" do
+    cards(:logo).update_columns title: "<img src=x onerror=alert(1)> searchneedle"
+    cards(:logo).update! description: "<p>searchneedle &lt;script&gt;alert(1)&lt;/script&gt;</p>"
+    cards(:logo).comments.create! body: "<p>searchneedle &lt;img src=x onerror=alert(1)&gt;</p>", creator: users(:kevin)
+
+    search "searchneedle"
+
+    assert_results cards(:logo)
+    assert_select ".search-result img, .search-result script", count: 0
+    assert_select ".search-result mark", count: 3
+    assert_select ".search-result__title", text: "<img src=x onerror=alert(1)> searchneedle"
+    assert_select 'meta[name="turbo-cache-control"][content="no-cache"]'
+  end
+
+  test "pagination preserves the query and newest first order" do
+    matches = 18.times.map { |index| create_card(created_at: index.minutes.ago) }
+
+    search "searchneedle"
+
+    assert_results(*matches.first(15))
+    next_page = css_select("a.pagination-link").first
+    assert_not_nil next_page
+    assert_includes next_page["href"], "q=searchneedle"
+    assert_includes next_page["href"], "page=2"
+
+    get next_page["href"]
+
+    assert_response :success
+    assert_results(*matches.drop(15))
+  end
+
+  test "an authenticated identity cannot search an account without a membership" do
+    get "#{accounts("initech").slug}/search", params: { q: "radio" }
+
+    assert_response :redirect
+    assert_results
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    search "searchneedle"
+
+    assert_response :redirect
+    assert_results
+  end
+
+  private
+    def create_card(board: boards(:writebook), **attributes)
+      board.cards.create!({ title: "searchneedle", creator: users(:kevin), status: :published }.merge(attributes))
+    end
+
+    def assert_results(*cards)
+      assert_equal cards.map { |card| dom_id(card, :search_result) }, css_select(".search-result").map { |result| result["id"] }
+    end
+
+    def search(query)
+      get "#{integration_session.default_url_options[:script_name]}/search", params: { q: query }
+    end
+end
