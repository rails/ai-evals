+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights every match without changing case" do
+    assert_equal "<mark>Needle</mark> and <mark>NEEDLE</mark>", highlight_search_result("Needle and NEEDLE", "needle")
+  end
+
+  test "regular expression characters are literal" do
+    assert_equal "A <mark>[.*]</mark> match", highlight_search_result("A [.*] match", "[.*]")
+  end
+
+  test "both matched and unmatched text are escaped even when marked HTML safe" do
+    assert_equal "&lt;script&gt;<mark>&lt;img&gt;</mark>&lt;/script&gt;",
+      highlight_search_result("<script><img></script>".html_safe, "<img>")
+  end
+
+  test "rich text formatting is removed and entities are escaped exactly once" do
+    text = ActionText::Content.new("<p>A <strong>needle</strong> &amp; more</p>")
+    assert_equal "A <mark>needle</mark> &amp; more", highlight_search_result(text, "needle")
+    assert_equal "A needle <mark>&amp;</mark> more", highlight_search_result(text, "&")
+  end
+
+  test "blank query and missing content are safe" do
+    assert_equal "&lt;img&gt;", highlight_search_result("<img>".html_safe, "")
+    assert_equal "", highlight_search_result(nil, "needle")
+  end
+end
