+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide center-block margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap margin-block-end", role: "search" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search.query.blank? %>
+    <p>Search card titles, descriptions, and comments.</p>
+  <% elsif @page.records.empty? %>
+    <p>No cards found for “<%= @search.query %>”.</p>
+  <% else %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <%= render partial: "searches/card", collection: @page.records, locals: { query: @search.query, comments_by_card: @comments_by_card } %>
+    <% end %>
+  <% end %>
+</section>
