diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..af7eadb
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "title, description, and comment changes are immediately reflected" do
+    card = cards(:logo)
+    card.update! description: "<p>descriptionneedle</p>"
+    assert_equal [ card ], search("descriptionneedle").cards
+
+    card.update! description: "<p>replacementneedle</p>"
+    assert_empty search("descriptionneedle").cards
+    assert_equal [ card ], search("replacementneedle").cards
+
+    card.update! description: ""
+    assert_empty search("replacementneedle").cards
+
+    comment = card.comments.create! body: "commentneedle", creator: users(:kevin)
+    assert_equal [ card ], search("commentneedle").cards
+
+    comment.update! body: "updatedneedle"
+    assert_empty search("commentneedle").cards
+    assert_equal [ comment ], search("updatedneedle").comments_for([ card ])
+
+    comment.destroy!
