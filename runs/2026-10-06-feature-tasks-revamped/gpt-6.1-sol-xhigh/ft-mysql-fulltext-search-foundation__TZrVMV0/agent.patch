+module SearchesHelper
+  def highlight_search_result(content, query)
+    text = String.new(content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s)
+
+    if query.present?
+      safe_join(text.split(/(#{Regexp.escape(query)})/i).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      safe_join([ text ])
+    end
+  end
+end
