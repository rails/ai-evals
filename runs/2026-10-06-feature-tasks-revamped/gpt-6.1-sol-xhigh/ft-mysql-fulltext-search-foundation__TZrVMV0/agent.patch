diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..05122fc
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,43 @@
+class Search
+  attr_reader :query
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def cards
+    if query.present?
+      accessible_cards
+        .where("LOWER(cards.title) LIKE ? ESCAPE '!'", search_pattern(query))
+        .or(accessible_cards.where(id: matching_rich_text("Card", "description").select(:record_id)))
+        .or(accessible_cards.where(id: matching_comments.select(:card_id)))
+        .reverse_chronologically
+    else
+      accessible_cards.none
+    end
+  end
+
+  def comments_for(cards)
+    matching_comments.where(card: cards).chronologically.with_rich_text_body
+  end
+
+  private
+    def accessible_cards
+      @user.accessible_cards.published
+    end
+
+    def matching_comments
+      @user.accessible_comments.where(card: accessible_cards)
+        .where(id: matching_rich_text("Comment", "body").select(:record_id))
+    end
+
+    def matching_rich_text(record_type, name)
+      ActionText::RichText.where(account_id: @user.account_id, record_type: record_type, name: name)
+        .where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", search_pattern(query))
+    end
+
+    def search_pattern(text)
+      "%#{ActiveRecord::Base.sanitize_sql_like(text.downcase, "!")}%"
+    end
+end
