diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..8256332
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,26 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :set_current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&block)
+      # Resolve the identity before authentication callbacks (which may redirect).
+      identity = Current.identity || find_session_by_cookie&.identity
+      requested = supported_locale(params[:locale])
+      if requested
+        session[:locale] = requested
+        identity&.update!(locale: requested)
+      end
+
+      locale = requested || supported_locale(session[:locale]) || supported_locale(identity&.locale) || I18n.default_locale
+      I18n.with_locale(locale, &block)
+    end
+
+    def supported_locale(value)
+      value.to_s if value.is_a?(String) && value.in?(I18n.available_locales.map(&:to_s))
+    end
+end
