diff --git a/test/controllers/current_locale_test.rb b/test/controllers/current_locale_test.rb
new file mode 100644
index 0000000..88d45ab
--- /dev/null
+++ b/test/controllers/current_locale_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class CurrentLocaleTest < ActionDispatch::IntegrationTest
+  test "anonymous locale persists and unsupported values do not change it" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select 'html[lang="ja"]'
+      assert_select 'input[placeholder="メールアドレスを入力…"]'
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select 'html[lang="ja"]'
+      get new_session_path
+      assert_select 'html[lang="ja"]'
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "signed in choice is persisted and restored in a clean browser" do
+    sign_in_as :david
+    get root_path(locale: :ja)
+    assert_response :success
+    assert_select 'html[lang="ja"]'
+    assert_equal "ja", identities(:david).reload.locale
+    get root_path(locale: :xx)
+    assert_select 'html[lang="ja"]'
+    reset!
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify('37signals')}"
+    sign_in_as :david
+    get root_path
+    assert_select 'html[lang="ja"]'
+    get root_path(locale: :en)
+    assert_select 'html[lang="en"]'
+    assert_equal "en", identities(:david).reload.locale
+  end
+
+  test "people with no preference still see English" do
+    untenanted do
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select 'html[lang="en"]'
+      assert_select 'input[placeholder="Enter your email address…"]'
+    end
+  end
+  test "Japanese renders the main pages and accessibility text" do
+    sign_in_as :david
+    get root_path(locale: :ja)
+    paths = [ root_path, new_board_path, board_path(boards(:writebook)),
+      edit_board_path(boards(:writebook)), card_path(cards(:logo)),
+      user_path(users(:david)), edit_user_path(users(:david)), account_settings_path,
+      account_join_code_path, notifications_path, notifications_settings_path,
+      my_menu_path, my_passkeys_path, my_access_tokens_path, new_my_access_token_path ]
+    paths.each do |path|
+      get path
+      assert_response :success, "#{path}: #{response.status}"
+      assert_no_match /translation missing/i, response.body, path
+      assert_no_match />\s*(?:Settings|Save changes|Create board|Notifications|Full history|Sign out|Add a card)\s*</, response.body, path
+    end
+    get my_passkeys_path
+    assert_no_match /Something went wrong|Passkey registration was cancelled|You already have a passkey registered/, response.body
+    get account_settings_path
+    assert_select 'label[aria-label="権限： 管理者"]'
+    assert_equal :en, I18n.locale
+  end
+
+  test "anonymous Japanese selection is saved on sign-in" do
+    untenanted { get new_session_path(locale: :ja) }
+    sign_in_as :david
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "conditional requests vary by locale" do
+    sign_in_as :david
+    get my_menu_path
+    english_etag = response.headers["ETag"]
+    get my_menu_path(locale: :ja), headers: { "If-None-Match" => english_etag }
+    assert_response :success
+    assert_not_equal english_etag, response.headers["ETag"]
+  end
+end
diff --git a/test/helpers/localization_test.rb b/test/helpers/localization_test.rb
new file mode 100644
index 0000000..8d5a4e6
--- /dev/null
+++ b/test/helpers/localization_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class LocalizationTest < ActiveSupport::TestCase
+  test "Japanese and English application catalogs have identical keys and interpolation" do
+    en = YAML.load_file(Rails.root.join("config/locales/fizzy.en.yml")).fetch("en").fetch("app")
+    ja = YAML.load_file(Rails.root.join("config/locales/fizzy.ja.yml")).fetch("ja").fetch("app")
+    assert_equal en.keys.sort, ja.keys.sort
+    check = lambda do |english, japanese|
+      if english.is_a?(Hash)
+        assert_equal english.keys.sort, japanese.keys.sort
+        english.each { |key, value| check.call(value, japanese.fetch(key)) }
+      else
+        assert japanese.present?
+        assert_equal english.scan(/%\{\w+\}/).sort, japanese.scan(/%\{\w+\}/).sort
+      end
+    end
+    en.each { |key, value| check.call(value, ja.fetch(key)) }
+  end
+
+  test "dates, plurals, built-in validation, and constant labels are localized" do
+    I18n.with_locale(:ja) do
+      assert_equal "2026年10月08日", I18n.l(Time.utc(2026, 10, 8), format: :stamp)
+      assert_equal "2件の新しい通知", I18n.t("app.notification_count", count: 2)
+      assert_equal "青", Color::COLORS.first.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      user = User.new(name: "")
+      user.valid?
+      assert_includes user.errors.full_messages, "名前を入力してください"
+    end
+    assert_equal "Oct 08, 2026", I18n.l(Time.utc(2026, 10, 8), format: :stamp)
+    assert_equal "Blue", Color::COLORS.first.name
+  end
+
+  test "static errors include both languages" do
+    Dir[Rails.root.join("public/*.html")].each do |path|
+      doc = Nokogiri::HTML5(File.read(path))
+      assert doc.at_css('[lang="en"]')
+      assert doc.at_css('[lang="ja"]'), path
+      assert_match /[\p{Han}\p{Hiragana}\p{Katakana}]/, doc.at_css('[lang="ja"]').text
+    end
+  end
+  test "new Japanese accounts get Japanese onboarding content" do
+    I18n.with_locale(:ja) do
+      Account::Seeder.new(Current.account, users(:david)).seed
+      board = Current.account.boards.find_by!(name: "練習用ボード")
+      assert_equal 11, board.cards.count
+      board.cards.each do |card|
+        assert_match /[\p{Han}\p{Hiragana}\p{Katakana}]/, card.title
+        assert_no_match /I18n\.t|Demo of|Click the|Then, hit|Back to Playground/, card.description.to_s
+      end
+    end
+  end
+
+  test "templates contain no literal readable English except brands and technical names" do
+    allowed = /\A(?:Fizzy|37signals™\s*,\s*HEY™|DEV|HMAC|SHA256|X-Webhook-Signature|fizzy\.do|support@fizzy\.do|,\s*jason@37signals\.com|&nbsp)\z/
+    Dir[Rails.root.join("app/views/**/*.html.erb")].each do |file|
+      next if file.end_with?("_theme_preference.html.erb") # Inline theme initialization script.
+      doc = Nokogiri::HTML.fragment(File.read(file).gsub(/<%.*?%>/m, " "))
+      doc.xpath(".//text()").each do |node|
+        next if node.ancestors.any? { |ancestor| %w[ script style ].include?(ancestor.name) }
+        text = node.text.strip
+        assert_match allowed, text, file if text.match?(/[a-zA-Z]{2}/)
+      end
+    end
+  end
+  test "queued notifications render in the stream language" do
+    notification = notifications(:logo_assignment_kevin)
+    japanese = capture_turbo_stream_broadcasts([ notification.user, :notifications, :ja ]) do
+      notification.unread
+      perform_enqueued_jobs
+    end
+    assert japanese.any?
+    assert_includes japanese.last.to_s, "担当："
+    assert_no_match /Assigned to|Mark as read|translation missing/, japanese.last.to_s
+    assert_equal :en, I18n.locale
+  end
+
+  test "system comments are stored canonically and rendered in Japanese" do
+    Current.session = sessions(:david)
+    card = cards(:logo)
+    I18n.with_locale(:ja) { card.close }
+    comment = card.comments.where(creator: Current.account.system_user).order(:created_at).last
+    assert_includes comment.body.to_plain_text, "Moved"
+    I18n.with_locale(:ja) do
+      html = ApplicationController.helpers.localized_comment_body(comment).to_s
+      assert_includes html, "完了"
+      assert_no_match /Moved|translation missing/, html
+    end
+  end
+end
