+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update!(locale: "ja")
+    @user = users(:david)
+    @user.notifications.destroy_all
+  end
+
+  test "all email families render the recipient language, even from an English job" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed)
+    bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: @user, creator: @user, source: events(:logo_published), created_at: 30.minutes.ago)
+    cancellation = Current.account.create_cancellation!(initiated_by: @user)
+    link = @identity.magic_links.create!
+
+    emails = [
+      [ MagicLinkMailer.sign_in_instructions(link), "Fizzyの認証コード" ],
+      [ UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user), "新しいメールアドレス" ],
+      [ AccountMailer.cancellation(cancellation), "解約" ],
+      [ ExportMailer.completed(export), "ダウンロード" ],
+      [ ImportMailer.completed(@identity, Current.account), "完了" ],
+      [ ImportMailer.failed(import), "失敗" ],
+      [ Notification::BundleMailer.notification(bundle), "新しい通知" ]
+    ]
+    emails.each do |email, subject|
+      assert_includes email.subject, subject
+      parts = email.multipart? ? email.parts : [ email ]
+      parts.each do |part|
+        text = part.body.decoded
+        assert_match /[\p{Han}\p{Hiragana}\p{Katakana}]/, text
+        assert_no_match /translation missing|Please enter|Notifications since|WHAT HAPPENS NOW|new notifications|about \d+ hours/i, text
+      end
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "queued email uses the stored preference at delivery time" do
+    link = @identity.magic_links.create!
+    @identity.update!(locale: "en")
+    MagicLinkMailer.sign_in_instructions(link).deliver_later
+    @identity.update!(locale: "ja")
+    perform_enqueued_jobs
+    assert_includes ActionMailer::Base.deliveries.last.subject, "Fizzyの認証コード"
+    assert_equal :en, I18n.locale
+  end
+end
