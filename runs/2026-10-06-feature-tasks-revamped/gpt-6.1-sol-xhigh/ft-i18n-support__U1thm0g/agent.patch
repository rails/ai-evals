diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..b3afd41
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,27 @@
+export function locale() {
+  return (document.querySelector('meta[name="fizzy-locale"]')?.content || document.documentElement.lang) === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key, values = {}) {
+  const messages = JSON.parse(document.querySelector('meta[name="fizzy-translations"]').content)
+  const message = key.split(".").reduce((value, part) => value[part], messages)
+  return message.replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
+
+function updateDocumentLanguage() {
+  const language = document.querySelector('meta[name="fizzy-locale"]')?.content || "en"
+  document.documentElement.lang = language
+  try {
+    const previous = sessionStorage.getItem("fizzyLocale")
+    if (previous !== language && (previous || language !== "en")) {
+      window.Turbo?.cache.clear()
+      window.Turbo?.offline?.clearCache()?.catch(() => {})
+    }
+    sessionStorage.setItem("fizzyLocale", language)
+  } catch {
+    // Storage may be unavailable; the server session still remembers the language.
+  }
+}
+
+document.addEventListener("turbo:load", updateDocumentLanguage)
+document.addEventListener("turbo:morph", updateDocumentLanguage)
