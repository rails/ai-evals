diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..6247149
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,78 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, class_name: "Notification::Bundle::Entry", inverse_of: :bundle, dependent: :destroy
+
+  scope :due, -> { where(delivered_at: nil).where(ends_at: ..Time.current) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_start
+  validate :window_does_not_overlap, if: -> { starts_at_changed? || ends_at_changed? || user_id_changed? }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification)
+      # Lock the recipient, not a bundle: there may not be a window to lock yet.
+      notification.user.with_lock do
+        if interval = notification.user.settings&.reload&.bundle_email_interval
+          now = Time.current
+          # Use arrival time, not the source's timestamp. Late notifications belong
+          # to the window already open, even when their source predates its start.
+          bundle = notification.user.notification_bundles.where("ends_at > ?", now).order(ends_at: :desc).lock.first ||
+            notification.user.notification_bundles.create!(starts_at: now, ends_at: interval.since(now))
+
+          bundle.entries.find_or_initialize_by(notification: notification).update!(source: notification.source, creator: notification.creator)
+          bundle
+        end
+      end
+    end
+
+    def deliver_due_later
+      due.find_each(&:deliver_later)
+    end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+    end
+  end
+
+  def deliver_now
+    user.with_lock do
+      reload
+
+      if delivered_at.nil? && ends_at <= Time.current
+        if deliverable?
+          Current.with_account(account) { NotificationMailer.bundle(self).deliver_now }
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && user.identity.present? && account.active? &&
+        user.settings&.reload&.bundle_email_interval.present? && entries.exists?
+    end
+
+    def ends_after_start
+      if starts_at && ends_at && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the start of the window")
+      end
+    end
+
+    def window_does_not_overlap
+      if user && starts_at && ends_at
+        user.with_lock do
+          overlapping = self.class.where(user: user).where.not(id: id)
+            .where("starts_at < ? AND ends_at > ?", ends_at, starts_at).lock
+
+          errors.add(:base, "Notification windows must not overlap") if overlapping.exists?
+        end
+      end
+    end
+end
