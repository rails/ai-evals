diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..0ea3286
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  # Separate connections must see committed data to exercise real row locking.
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  teardown do
+    @user.notification_bundles.reload.destroy_all
+    @user.settings.update!(bundle_email_frequency: :never)
+  end
+
+  test "simultaneous arrivals cannot open overlapping windows" do
+    ids = [ notifications(:layout_commented_kevin).id, notifications(:logo_assignment_kevin).id ]
+    bundles = concurrently(ids) { |id| Notification.find(id).bundle_for_email }
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, @user.notification_bundles.sole.entries.count
+  end
+
+  test "simultaneous delivery jobs cannot send a window twice" do
+    bundle = notifications(:layout_commented_kevin).bundle_for_email
+    travel_to bundle.ends_at, with_usec: true
+
+    assert_emails 1 do
+      concurrently([ bundle.id, bundle.id ]) { |id| Notification::Bundle.find(id).deliver_now }
+    end
+
+    assert_not_nil bundle.reload.delivered_at
+  end
+
+  private
+    def concurrently(ids)
+      ready = Queue.new
+      start = Queue.new
+      threads = ids.map do |id|
+        Thread.new do
+          ready << true
+          start.pop
+          ActiveRecord::Base.connection_pool.with_connection { yield id }
+        end
+      end
+
+      ids.size.times { ready.pop }
+      ids.size.times { start << true }
+      threads.map(&:value)
+    ensure
+      threads&.each(&:join)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..bde72a7
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:layout_commented_kevin)
+    @bundle = @notification.bundle_for_email
+  end
+
+  test "delivers one email for all notifications when the window closes" do
+    notifications(:logo_assignment_kevin).bundle_for_email
+    travel_to @bundle.ends_at
+
+    assert_emails 1 do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliverJob)
+    end
+
+    assert_not_nil @bundle.reload.delivered_at
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.text_part.body.to_s, @notification.payload.title
+    assert_includes email.text_part.body.to_s, notifications(:logo_assignment_kevin).payload.title
+  end
+
+  test "delivery cannot send a window early" do
+    assert_no_emails { @bundle.deliver_now }
+    assert_nil @bundle.reload.delivered_at
+  end
+
+  test "duplicate jobs only send the window once" do
+    travel_to @bundle.ends_at
+
+    assert_emails 1 do
+      2.times { Notification::Bundle::DeliverJob.perform_now(@bundle) }
+    end
+  end
+
+  test "opting out suppresses a pending digest" do
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver_now }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "deactivated users do not receive pending digests" do
+    @user.deactivate
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver_now }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "cancelled accounts do not receive pending digests" do
+    @user.account.cancel(initiated_by: @user)
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver_now }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "empty digests are not emailed" do
+    @notification.destroy!
+    travel_to @bundle.ends_at
+
+    assert_no_emails { @bundle.deliver_now }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "failed deliveries remain available for retry" do
+    travel_to @bundle.ends_at
+    NotificationMailer.expects(:bundle).raises(IOError).once
+
+    assert_raises(IOError) { @bundle.deliver_now }
+    assert_nil @bundle.reload.delivered_at
+
+    NotificationMailer.unstub(:bundle)
+    assert_emails(1) { @bundle.deliver_now }
+    assert_not_nil @bundle.reload.delivered_at
+  end
+
+  test "due sweep recovers delivery without resending completed windows" do
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliverJob) do
+      Notification::Bundle.deliver_due_later
+    end
+
+    travel_to @bundle.ends_at
+    assert_enqueued_with(job: Notification::Bundle::DeliverJob, args: [ @bundle ]) do
+      Notification::Bundle.deliver_due_later
+    end
+
+    assert_emails(1) { perform_enqueued_jobs(only: Notification::Bundle::DeliverJob) }
+
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliverJob) do
+      Notification::Bundle.deliver_due_later
+    end
+  end
+
+  test "overlapping windows are rejected but touching windows are valid" do
+    overlap = @user.notification_bundles.new(starts_at: @bundle.starts_at - 1.hour, ends_at: @bundle.starts_at + 1.hour)
+    assert_not overlap.save
+    assert_includes overlap.errors[:base], "Notification windows must not overlap"
+
+    following = @user.notification_bundles.new(starts_at: @bundle.ends_at, ends_at: @bundle.ends_at + 4.hours)
+    assert following.save
+  end
+
+  test "windows must have positive duration" do
+    @bundle.ends_at = @bundle.starts_at
+    assert_not @bundle.valid?
+    assert @bundle.errors[:ends_at].any?
+  end
+end
diff --git a/test/models/notification/bundling_test.rb b/test/models/notification/bundling_test.rb
new file mode 100644
index 0000000..568f864
--- /dev/null
+++ b/test/models/notification/bundling_test.rb
@@ -0,0 +1,189 @@
+require "test_helper"
+
+class Notification::BundlingTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:layout_commented_kevin)
+  end
+
+  test "the first notification opens a four hour window and later notifications share it" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      @notification.update!(source: events(:layout_published))
+      bundle = @user.notification_bundles.sole
+
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_enqueued_with job: Notification::Bundle::DeliverJob, args: [ bundle ], at: bundle.ends_at
+
+      travel 1.hour
+      notifications(:logo_assignment_kevin).update!(source: events(:logo_published))
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal 2, bundle.entries.count
+    end
+  end
+
+  test "never does not open a window" do
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.update!(source: events(:layout_published))
+    end
+  end
+
+  test "a late notification joins the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    freeze_time do
+      @notification.update!(source: events(:layout_published))
+      bundle = @user.notification_bundles.sole
+
+      travel 1.hour
+      notifications(:logo_assignment_kevin).update!(source: events(:logo_published), updated_at: 2.hours.ago)
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal 2, bundle.entries.count
+      assert_equal 1.hour.ago, bundle.starts_at
+      assert_equal 23.hours.from_now, bundle.ends_at
+    end
+  end
+  test "daily and weekly windows last for the chosen frequency" do
+    { daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+      @user.notification_bundles.reload.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      freeze_time do
+        bundle = @notification.bundle_for_email
+        assert_equal Time.current, bundle.starts_at
+        assert_equal interval.from_now, bundle.ends_at
+      end
+    end
+  end
+
+  test "creation bundles the notification" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification.destroy!
+
+    assert_difference -> { Notification::Bundle.count }, 1 do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    end
+  end
+
+  test "reading and other updates do not create digest entries" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.read
+      @notification.unread
+      @notification.update!(unread_count: 5)
+    end
+  end
+
+  test "each person's frequency and windows are independent" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    david = users(:david)
+    david.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      kevin_bundle = @notification.bundle_for_email
+      david_bundle = notifications(:logo_mentioned_david).bundle_for_email
+
+      assert_equal 4.hours.from_now, kevin_bundle.ends_at
+      assert_equal 1.week.from_now, david_bundle.ends_at
+      assert_not_equal kevin_bundle, david_bundle
+    end
+  end
+
+  test "changing frequency does not change or overlap the open window" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      bundle = @notification.bundle_for_email
+      travel 1.hour
+      @user.settings.update!(bundle_email_frequency: :every_few_hours)
+      other = notifications(:logo_assignment_kevin).bundle_for_email
+
+      assert_equal bundle, other
+      assert_equal 1.week.from_now - 1.hour, bundle.reload.ends_at
+
+      travel_to bundle.ends_at
+      next_bundle = @notification.bundle_for_email
+
+      assert_not_equal bundle, next_bundle
+      assert_equal bundle.ends_at, next_bundle.starts_at
+      assert_equal 4.hours.from_now, next_bundle.ends_at
+    end
+  end
+
+  test "a gap between windows starts the next clock at the next arrival" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      first = @notification.bundle_for_email
+      travel 2.days
+      second = @notification.bundle_for_email
+
+      assert_equal Time.current, second.starts_at
+      assert_equal 4.hours.from_now, second.ends_at
+      assert_operator second.starts_at, :>, first.ends_at
+    end
+  end
+
+  test "repeated activity on a card is deduplicated within a window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification.bundle_for_email
+
+    @notification.update!(source: events(:layout_published))
+
+    assert_equal 1, @user.notification_bundles.count
+    entry = @user.notification_bundles.sole.entries.sole
+    assert_equal events(:layout_published), entry.source
+  end
+
+  test "activity in a later window does not rewrite an earlier digest" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    freeze_time do
+      first = @notification.bundle_for_email
+      original_source = @notification.source
+      travel 4.hours
+      @notification.update!(source: events(:layout_published))
+      second = @user.notification_bundles.order(:starts_at).last
+
+      assert_equal original_source, first.entries.sole.source
+      assert_equal events(:layout_published), second.entries.sole.source
+    end
+  end
+
+  test "removing a notification also removes its digest entries" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    bundle = @notification.bundle_for_email
+
+    @notification.destroy!
+
+    assert_empty bundle.entries.reload
+  end
+
+  test "removing an older source removes its snapshot even after the notification changed" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    source = @notification.source
+    bundle = @notification.bundle_for_email
+    travel_to bundle.ends_at, with_usec: true
+    @notification.update!(source: events(:layout_published))
+
+    source.destroy!
+
+    assert_empty bundle.entries.reload
+    assert @notification.reload.persisted?
+  end
+
+  test "system activity and inactive recipients are not bundled" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification.creator = users(:system)
+    assert_nil @notification.bundle_for_email
+
+    @notification.creator = users(:david)
+    @user.update!(active: false)
+    assert_nil @notification.bundle_for_email
+  end
+end
