+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    @notification = notifications(:layout_commented_kevin)
+    @bundle = @notification.bundle_for_email
+  end
+
+  test "digest contains notification summaries and account-scoped links in both formats" do
+    email = NotificationMailer.bundle(@bundle)
+
