+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "email bundling is off by default" do
+    assert_equal "never", users(:kevin).settings.bundle_email_frequency
+    assert_nil users(:kevin).settings.bundle_email_interval
+  end
+
+  test "frequencies map to the configured intervals" do
+    settings = users(:kevin).settings
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+      settings.bundle_email_frequency = frequency
+      assert_equal interval, settings.bundle_email_interval
+    end
+  end
+
+  test "unknown frequencies are rejected" do
+    settings = users(:kevin).settings
+    settings.bundle_email_frequency = "immediately"
+    assert_not settings.valid?
+    assert settings.errors[:bundle_email_frequency].any?
+  end
+end
