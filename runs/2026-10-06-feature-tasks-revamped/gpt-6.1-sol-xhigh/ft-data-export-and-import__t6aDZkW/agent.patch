diff --git a/app/models/account/data_transfer/restorer.rb b/app/models/account/data_transfer/restorer.rb
new file mode 100644
index 0000000..5271d80
--- /dev/null
+++ b/app/models/account/data_transfer/restorer.rb
@@ -0,0 +1,241 @@
+class Account::DataTransfer::Restorer
+  class InvalidArchive < StandardError; end
+
+  def initialize(import)
+    @import = import
+    @ids = {}
+    @types = {}
+    @original_ids = {}
+    @uploaded_keys = []
+  end
+
+  def restore
+    @zip = ZipFile::Reader.new(service: @import.source_service, key: @import.source_key, byte_size: @import.source_byte_size)
+    validate_manifest
+    validate_counts
+    prepare_ids
+
+    Account.transaction(requires_new: true) do
+      restore_account
+      Current.with_account(@account) do
+        restore_records
+        ensure_owner
+        rebuild_derived_data
+      end
+      @account
+    end
+  rescue
+    discard_files
+    raise
+  end
+
+  def discard_files
+    @uploaded_keys.each { |key| ActiveStorage::Blob.service.delete(key) }
+  end
+
+  private
+    def validate_manifest
+      @manifest = @zip.read_json("manifest.json")
+      unless @manifest.is_a?(Hash) && @manifest["version"] == Account::DataTransfer::VERSION && @manifest["kind"] == "account"
+        raise InvalidArchive, "Please choose a supported Fizzy account export, not a cards export."
+      end
+      @record_sets = Account::DataTransfer::Manifest.new(nil).record_sets.reject { |set| set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) }
+    end
+
+    def validate_counts
+      counts = @manifest["counts"]
+      unless counts.is_a?(Hash)
+        raise InvalidArchive, "The archive is missing its record counts."
+      end
+      @record_sets.each do |set|
+        unless paths_for(set.model).size == counts[set.model.table_name]
+          raise InvalidArchive, "The archive is incomplete: #{set.model.table_name}."
+        end
+      end
+      unless @zip.glob("files/*").size == counts["files"]
+        raise InvalidArchive, "The archive is missing attached files."
+      end
+    end
+
+    def prepare_ids
+      @record_sets.each do |set|
+        paths_for(set.model).each do |path|
+          id = File.basename(path, ".json")
+          raise InvalidArchive, "Invalid or duplicate record ID" unless id.match?(/\A[a-z0-9]{25}\z/) && !@ids.key?(id)
+          @ids[id] = ActiveRecord::Type::Uuid.generate
+          @types[id] = set.model.name
+          @original_ids[@ids[id]] = id
+        end
+      end
+      unless paths_for(Account).size == 1 && @types[@manifest["account_id"]] == "Account"
+        raise InvalidArchive, "The archive must contain exactly one account."
+      end
+    end
+
+    def paths_for(model)
+      @zip.glob("#{model.table_name}/*.json")
+    end
+
+    def restore_account
+      attributes = read_attributes(Account, paths_for(Account).first)
+      attributes.delete("external_account_id")
+      @account = Account.create!(attributes)
+      @account.entropies.delete_all
+      @account.association(:entropy).reset
+    end
+
+    def restore_records
+      @record_sets.reject { |set| set.model == Account }.each do |set|
+        paths_for(set.model).each do |path|
+          old_id = File.basename(path, ".json")
+          attributes = read_attributes(set.model, path)
+          resources = attributes.delete("resources") if set.model == Filter
+          case set.model.name
+          when "User"
+            restore_user(attributes)
+          when "ActiveStorage::Blob"
+            restore_blob(attributes, old_id)
+          when "ActionText::RichText"
+            attributes["body"] = Account::DataTransfer::RichText.restore(attributes["body"]) { |type, id| resolve_attachable(type, id) }
+          when "Webhook"
+            # Do not send requests to destinations supplied in an uploaded archive.
+            attributes["active"] = false
+            attributes["signing_secret"] = SecureRandom.hex(32)
+          when "Board::Publication"
+            attributes["key"] = SecureRandom.base58(24)
+          when "Notification::Bundle"
+            # Restoring historical records must not replay emails or webhooks.
+            attributes["status"] = "delivered"
+          end
+          set.model.insert_all!([ attributes ])
+          restore_filter_resources(attributes["id"], resources) if set.model == Filter
+        end
+      end
+    end
+
+    def read_attributes(model, path)
+      attributes = @zip.read_json(path)
+      unless attributes.is_a?(Hash) && attributes["id"] == File.basename(path, ".json")
+        raise InvalidArchive, "Invalid record: #{path}"
+      end
+      if model != Account && attributes["account_id"] != @manifest["account_id"]
+        raise InvalidArchive, "The archive contains records from another account."
+      end
+      attributes.except!("description", "comments") if model == Card
+      extra_attributes = case model.name
+      when "User" then [ "email_address" ]
+      when "Filter" then [ "resources" ]
+      else []
+      end
+      allowed = model.column_names + extra_attributes
+      raise InvalidArchive, "Unknown attributes in #{path}" if (attributes.keys - allowed).any?
+      raise InvalidArchive, "Identity IDs cannot be imported" if model == User && attributes.key?("identity_id")
+
+      attributes.transform_values! { |value| remap_value(value) }
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        foreign_key = association.foreign_key
+        next if foreign_key == "identity_id" || attributes[foreign_key].nil?
+        original_id = @original_ids[attributes[foreign_key]]
+        expected_type = association.polymorphic? ? attributes[association.foreign_type] : association.class_name
+        unless original_id && @types[original_id] == expected_type
+          raise InvalidArchive, "Invalid #{foreign_key} reference in #{path}"
+        end
+      end
+      attributes
+    end
+
+    def remap_value(value)
+      case value
+      when String then @ids.fetch(value, value)
+      when Array then value.map { |item| remap_value(item) }
+      when Hash then value.transform_values { |item| remap_value(item) }
+      else value
+      end
+    end
+
+    def restore_filter_resources(id, resources)
+      filter = Filter.find(id)
+      (resources || {}).each do |name, ids|
+        type = Account::DataTransfer::FilterRecordSet::RESOURCE_TYPES.fetch(name) { raise InvalidArchive, "Unknown filter resource" }
+        unless ids.is_a?(Array) && ids.all? { |id| @types[@original_ids[id]] == type }
+          raise InvalidArchive, "Invalid filter resource reference"
+        end
+        filter.public_send("#{name.singularize}_ids=", ids)
+      end
+    end
+
+    def restore_user(attributes)
+      email_address = attributes.delete("email_address")
+      if email_address.present?
+        identity = Identity.find_or_create_by!(email_address: email_address)
+        attributes["identity_id"] = identity.id
+      end
+      attributes["role"] = "admin" if attributes["role"] == "owner"
+      attributes["role"] = "owner" if attributes["identity_id"] == @import.identity_id
+    end
+
+    def restore_blob(attributes, old_id)
+      key = ActiveStorage::Blob.generate_unique_secure_token
+      attributes["key"] = key
+      attributes["service_name"] = ActiveStorage::Blob.service.name
+      @uploaded_keys << key
+      service = ActiveStorage::Blob.service
+      if ZipFile.s3_service?(service)
+        service.send(:upload_stream, key: key, content_type: attributes["content_type"], part_size: 100.megabytes) do |stream|
+          stream.binmode
+          extract_file(old_id, attributes, stream)
+        end
+      else
+        Tempfile.create([ "fizzy-import", ".bin" ]) do |file|
+          file.binmode
+          extract_file(old_id, attributes, file)
+          file.rewind
+          service.upload(key, file, checksum: attributes["checksum"], content_type: attributes["content_type"])
+        end
+      end
+    end
+
+    def extract_file(old_id, attributes, output)
+      digest = Digest::MD5.new
+      size = 0
+      @zip.extract("files/#{old_id}") do |chunk|
+        output.write(chunk)
+        digest.update(chunk)
+        size += chunk.bytesize
+      end
+      unless size == attributes["byte_size"] && digest.base64digest == attributes["checksum"]
+        raise InvalidArchive, "Damaged attachment: #{attributes['filename']}"
+      end
+    end
+
+    def resolve_attachable(type, id)
+      unless %w[User ActiveStorage::Blob].include?(type) && @types[id] == type
+        raise InvalidArchive, "Invalid rich text attachment"
+      end
+      model = type == "User" ? User : ActiveStorage::Blob
+      model.find(@ids.fetch(id))
+    end
+
+    def ensure_owner
+      owner = @account.users.find_by(identity: @import.identity)
+      if owner
+        owner.update_columns(role: "owner", active: true, verified_at: Time.current)
+      else
+        owner = @account.users.create!(identity: @import.identity, name: @import.identity.email_address, role: :owner, verified_at: Time.current)
+      end
+      unless @account.users.where(role: :system).count == 1
+        raise InvalidArchive, "The archive must contain exactly one system user."
+      end
+      @account.boards.each do |board|
+        Access.find_or_create_by!(account: @account, board: board, user: owner)
+      end
+      @account.update_columns(cards_count: [ @account.cards.maximum(:number).to_i, @account.cards_count ].max)
+    end
+
+    def rebuild_derived_data
+      @account.cards.find_each(&:reindex)
+      Comment.where(account: @account).find_each(&:reindex)
+      @account.boards.find_each(&:reconcile_storage)
+      @account.reconcile_storage
+    end
+end
