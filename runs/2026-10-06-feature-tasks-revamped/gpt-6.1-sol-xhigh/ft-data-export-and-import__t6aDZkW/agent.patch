+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,20 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Export.create!(account: Current.account, user: Current.user, kind: :account)
+    export.build_later
+    redirect_to account_settings_path, notice: "We’ll email you a download link when your account export is ready."
+  end
+
+  def show
+    export = Export.find_signed(params[:id], purpose: :download)
+    raise ActiveRecord::RecordNotFound unless export
+    if export.account == Current.account && export.accessible_to?(Current.user) && export.archive.attached?
+      response.headers["Cache-Control"] = "no-store"
+      redirect_to rails_storage_redirect_path(export.archive.blob, expires_at: export.completed_at + Export::LINK_LIFETIME, disposition: :attachment)
+    else
+      head :not_found
+    end
+  end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
