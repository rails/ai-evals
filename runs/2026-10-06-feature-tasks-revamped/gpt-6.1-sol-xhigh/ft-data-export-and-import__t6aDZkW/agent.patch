+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  test "malformed archive sends an explanatory failure email without creating data" do
+    import = Account::Import.create!(identity: identities(:david))
+    File.open(file_fixture("moon.jpg")) { |file| import.store_file(file) }
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { ActiveStorage::Blob.count } ] do
+      perform_enqueued_jobs only: Account::ImportJob do
+        import.restore_later
+      end
+    end
+    assert import.reload.failed?
+    assert_nil import.account
+    assert_match /not a valid.*archive/, import.error
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob, args: [ "Account::ImportMailer", "finished", "deliver_now", { args: [ import ] } ]
+    email = Account::ImportMailer.finished(import).message
+    assert_equal [ identities(:david).email_address ], email.to
+    assert_includes email.text_part.body.decoded, import.error
+    assert_not import.source_service.exist?(import.source_key)
+  end
+
+  test "completed import cannot create a second account when the job is repeated" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:kevin), kind: :account)
+    export.build_now
+    import = Account::Import.create!(identity: identities(:kevin))
+    export.archive.blob.open { |file| import.store_file(file) }
+    import.restore_now
+    assert import.completed?, import.error
+    assert_no_difference -> { Account.count } do
+      import.restore_now
+    end
+  end
+end
