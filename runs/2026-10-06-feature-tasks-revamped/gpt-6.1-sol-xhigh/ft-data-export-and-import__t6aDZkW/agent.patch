--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,21 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+    @import = Current.identity.account_imports.new
+  end
+
+  def create
+    file = params.dig(:import, :file)
+    if file.is_a?(ActionDispatch::Http::UploadedFile) && file.size.positive?
+      @import = Current.identity.account_imports.create!
+      @import.store_file(file.tempfile)
+      @import.restore_later
+      redirect_to new_account_import_path, notice: "We’ll email you when your import is complete, or if it can’t be completed."
+    else
+      @import = Current.identity.account_imports.new
+      flash.now[:alert] = "Choose a Fizzy account ZIP file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
