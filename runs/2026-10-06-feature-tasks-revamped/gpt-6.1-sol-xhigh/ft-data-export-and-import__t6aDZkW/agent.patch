diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..6b1233d
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,31 @@
+class Account::DataTransfer::CardArchive
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(zip)
+    cards.find_each do |card|
+      comments = card.comments.chronologically.includes(:creator, rich_text_body: { embeds_attachments: :blob }).to_a
+      blobs = [ card.image.blob, *card.attachments.map(&:blob), *comments.flat_map { |comment| comment.attachments.map(&:blob) } ].compact.uniq(&:id)
+      directory = "cards/#{card.number}"
+      zip.add_file("#{directory}/card.json", card.attributes.merge(
+        "description" => card.description.to_s,
+        "board" => card.board.name,
+        "creator" => card.creator.name,
+        "comments" => comments.map { |comment| comment.attributes.merge("body" => comment.body.to_s, "creator" => comment.creator.name) },
+        "attachments" => blobs.map { |blob| { id: blob.id, filename: blob.filename.to_s, path: "#{directory}/files/#{blob.id}/#{blob.filename}" } }
+      ).to_json)
+      blobs.each do |blob|
+        zip.add_file("#{directory}/files/#{blob.id}/#{blob.filename}", compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+  end
+
+  private
+    def cards
+      @user.accessible_cards.where(account: @user.account).where(status: :published)
+        .or(@user.accessible_cards.where(account: @user.account, status: :drafted, creator: @user))
+    end
+end
