@@ -0,0 +1,86 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup { Current.user = users(:kevin) }
+
+  test "card archive contains only visible cards, comments, and attached files" do
+    user = users(:david)
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    private_board = Board.create!(account: Current.account, creator: users(:kevin), name: "Private", all_access: false)
+    hidden_card = private_board.cards.create!(creator: users(:kevin), title: "Secret", status: :published)
+    others_draft = card.board.cards.create!(creator: users(:kevin), title: "Private draft", status: :drafted)
+    own_draft = card.board.cards.create!(creator: user, title: "My draft", status: :drafted)
+    export = Export.create!(account: Current.account, user: user, kind: :cards)
+    export.build_now
+    reader = ZipFile::Reader.new(service: export.archive.blob.service, key: export.archive.blob.key, byte_size: export.archive.blob.byte_size)
+    assert_empty reader.glob("cards/#{hidden_card.number}/*")
+    assert_empty reader.glob("cards/#{others_draft.number}/*")
+    assert reader.glob("cards/#{own_draft.number}/*").any?
+    json = reader.read_json("cards/#{card.number}/card.json")
+    assert_equal card.title, json["title"]
+    assert_equal card.comments.count, json["comments"].count
+    assert_equal "picture.png", json["attachments"].first["filename"]
+    data = +""
+    reader.extract(json["attachments"].first["path"]) { |chunk| data << chunk }
+    assert_equal "picture", data
+    assert_not_includes reader.glob("cards/*/card.json"), "cards/#{cards(:radio).number}/card.json" if cards(:radio).number != card.number
+  end
+
+  test "admin permissions are rechecked when the job runs" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    users(:kevin).update!(role: :member)
+    assert_raises(ActiveRecord::RecordInvalid) { export.build_now }
+    assert_not export.archive.attached?
+  end
+
+  test "completed export is not generated twice and archive is purged after one day" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.build_now
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      export.build_now
+    end
+    export.discard_archive
+    assert export.archive.attached?
+    travel_to export.completed_at + 1.day + 1.second do
+      export.discard_archive
+    end
+    assert_not export.archive.attached?
+  end
+
+  test "streamed export reports its real byte size and checksum" do
+    file = StringIO.new
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("file.json", { title: "Fizzy" }.to_json)
+    writer.close
+    assert_equal file.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(file.string), writer.checksum
+  end
+
+  test "S3 export and import stream without staging attachments on disk" do
+    service = ActiveStorage::Blob.service
+    streams = []
+    service.define_singleton_method(:upload_stream) do |key:, **options, &block|
+      stream = StringIO.new
+      block.call(stream)
+      streams << stream.string
+      stream.rewind
+      upload(key, stream, checksum: Digest::MD5.base64digest(stream.string), content_type: options[:content_type])
+    end
+    ZipFile.stubs(:s3_service?).returns(true)
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("streamed picture"), filename: "picture.png", content_type: "image/png")
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :account)
+    export.build_now
+    assert_equal streams.first.bytesize, export.archive.blob.byte_size
+    assert_equal Digest::MD5.base64digest(streams.first), export.archive.blob.checksum
+    import = Account::Import.create!(identity: users(:kevin).identity)
+    export.archive.blob.open { |file| import.store_file(file) }
+    import.restore_now
+    assert import.completed?, import.error
+    assert_includes streams, "streamed picture"
+    assert_equal "streamed picture", import.account.cards.find_by!(number: card.number).image.download
+  ensure
+    service.singleton_class.remove_method(:upload_stream) if service&.singleton_class&.method_defined?(:upload_stream)
+  end
+end
diff --git a/test/models/zip_file/reader_test.rb b/test/models/zip_file/reader_test.rb
new file mode 100644
index 0000000..5614e81
--- /dev/null
+++ b/test/models/zip_file/reader_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  test "reads JSON and streams stored binary files" do
+    with_archive do |writer, file|
+      writer.add_file("record.json", { name: "Fizzy" }.to_json)
+      writer.add_file("files/picture", "picture bytes", compress: false)
+      writer.close
+      reader = reader_for(file)
+      assert_equal({ "name" => "Fizzy" }, reader.read_json("record.json"))
+      bytes = +""
+      reader.extract("files/picture") { |chunk| bytes << chunk }
+      assert_equal "picture bytes", bytes
+      assert_equal [ "record.json" ], reader.glob("*.json")
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader.read_json("missing.json") }
+    end
+  end
+
+  test "rejects duplicate paths" do
+    with_archive do |writer, file|
+      writer.add_file("first.json", "{}")
+      writer.add_file("other.json", "{}")
+      writer.close
+      replace_bytes(file, "other.json", "first.json")
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader_for(file) }
+    end
+  end
+
+  test "rejects unsafe paths" do
+    with_archive do |writer, file|
+      writer.add_file("aa/file.json", "{}")
+      writer.close
+      replace_bytes(file, "aa/file.json", "../file.json")
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader_for(file) }
+    end
+  end
+
+  test "checks archive entry CRC" do
+    with_archive do |writer, file|
+      writer.add_file("file", "secret", compress: false)
+      writer.close
+      replace_bytes(file, "secret", "secrex")
+      reader = reader_for(file)
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader.extract("file") { |chunk| } }
+    end
+  end
+
+  test "limits decompressed JSON metadata" do
+    with_archive do |writer, file|
+      writer.add_file("large.json", "a" * (ZipFile::Reader::MAX_JSON_SIZE + 1))
+      writer.close
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader_for(file).read_json("large.json") }
+    end
+  end
+
+  private
+    def with_archive
+      Tempfile.create([ "zip-test", ".zip" ]) do |file|
+        file.binmode
+        yield ZipFile::Writer.new(file), file
+      end
+    end
+
+    def replace_bytes(file, from, to)
+      file.rewind
+      bytes = file.read.gsub(from, to)
+      file.rewind
+      file.write(bytes)
+      file.flush
+    end
+
+    def reader_for(file)
+      file.flush
+      file.rewind
+      key = "zip-tests/#{SecureRandom.hex}"
+      service = ActiveStorage::Blob.service
+      service.upload(key, file, checksum: Digest::MD5.file(file.path).base64digest)
+      (@keys ||= []) << key
+      ZipFile::Reader.new(service: service, key: key, byte_size: file.size)
+    end
+
+  teardown do
+    (@keys || []).each { |key| ActiveStorage::Blob.service.delete(key) }
+  end
+end
