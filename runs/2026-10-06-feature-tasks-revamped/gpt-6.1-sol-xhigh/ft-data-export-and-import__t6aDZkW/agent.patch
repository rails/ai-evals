diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..12b3982
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,68 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  after_destroy_commit :discard_file
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  def store_file(file)
+    file.rewind
+    update!(source_key: "imports/#{SecureRandom.base58(28)}", source_service_name: ActiveStorage::Blob.service.name, source_byte_size: file.size)
+    source_service.upload(source_key, file, checksum: Digest::MD5.file(file.path).base64digest, content_type: "application/zip")
+  rescue
+    discard_file
+    raise
+  end
+
+  def restore_later
+    Current.without_account { Account::ImportJob.perform_later(self) }
+  end
+
+  def restore_now
+    handled = false
+    restorer = nil
+    with_lock do
+      if pending?
+        handled = true
+        restorer = Account::DataTransfer::Restorer.new(self)
+        restored = restorer.restore
+        update!(status: :completed, account: restored)
+      end
+    end
+  rescue => exception
+    Rails.error.report(exception)
+    if handled
+      restorer&.discard_files
+      update!(status: :failed, account: nil, error: failure_reason(exception))
+    else
+      raise
+    end
+  ensure
+    if handled && (completed? || failed?)
+      discard_file
+      Account::ImportMailer.finished(self).deliver_later
+    end
+  end
+
+  def source_service
+    ActiveStorage::Blob.services.fetch(source_service_name)
+  end
+
+  def discard_file
+    source_service.delete(source_key) if source_key.present?
+  end
+
+  private
+    def failure_reason(exception)
+      if exception.is_a?(Account::DataTransfer::Restorer::InvalidArchive) || exception.is_a?(ZipFile::Reader::InvalidArchive)
+        exception.message.truncate(1000)
+      elsif exception.is_a?(JSON::ParserError) || exception.class.name.start_with?("ZipKit::", "Zlib::")
+        "The file is not a valid Fizzy ZIP archive, or it is damaged."
+      elsif exception.is_a?(ActiveRecord::ActiveRecordError)
+        "The archive contains invalid or inconsistent records."
+      else
+        "The import could not be completed. Please try again or contact support."
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..e8d9080
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,70 @@
+class Export < ApplicationRecord
+  LINK_LIFETIME = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), suffix: true
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself)
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build_now
+    if claim
+      begin
+        Current.with_account(account) do
+          ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            counts = {}
+            if account_kind?
+              Account::DataTransfer::Manifest.new(account).each_record_set do |records|
+                directory = records.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) ? "files" : records.model.table_name
+                counts[directory] = records.export_to(zip)
+              end
+            else
+              Account::DataTransfer::CardArchive.new(user).export_to(zip)
+            end
+            zip.add_file("manifest.json", { version: Account::DataTransfer::VERSION, kind: kind, account_id: account_id, counts: counts }.to_json)
+          end
+        end
+        update!(status: :completed, completed_at: Time.current)
+        ExportMailer.ready(self).deliver_later
+        ExportCleanupJob.set(wait_until: completed_at + LINK_LIFETIME).perform_later(self)
+      rescue
+        archive.purge if archive.attached?
+        update!(status: :failed)
+        raise
+      end
+    end
+  end
+
+  def authorized?
+    user.account_id == account_id && user.active? && account.active? && (!account_kind? || user.admin?)
+  end
+
+  def accessible_to?(requester)
+    requester == user && requester&.account_id == account_id && completed? &&
+      completed_at + LINK_LIFETIME > Time.current && authorized?
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: completed_at + LINK_LIFETIME)
+  end
+
+  def discard_archive
+    archive.purge if completed? && completed_at + LINK_LIFETIME <= Time.current
+  end
+
+  private
+    def claim
+      with_lock do
+        if pending?
+          raise ActiveRecord::RecordInvalid, self unless authorized?
+          update!(status: :processing)
+          true
+        end
+      end
+    end
+end
