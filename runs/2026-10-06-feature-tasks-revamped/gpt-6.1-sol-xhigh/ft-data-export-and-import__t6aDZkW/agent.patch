diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..0e87a02
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,109 @@
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+
+  MAX_METADATA_SIZE = 128.megabytes
+  MAX_JSON_SIZE = 16.megabytes
+
+  def initialize(service:, key:, byte_size:)
+    @io = ServiceIO.new(service, key, byte_size)
+    entries = ZipKit::FileReader.read_zip_structure(io: @io, read_local_headers: false)
+    @entries = entries.index_by do |entry|
+      validate_path(entry.filename)
+      entry.filename
+    end
+    raise InvalidArchive, "Duplicate archive paths" unless @entries.size == entries.size
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path, File::FNM_PATHNAME) }.sort
+  end
+
+  def read_json(path)
+    content = +""
+    extract(path, limit: MAX_JSON_SIZE) { |chunk| content << chunk }
+    JSON.parse(content)
+  end
+
+  def extract(path, limit: nil)
+    entry = @entries.fetch(path) { raise InvalidArchive, "Missing file: #{path}" }
+    raise InvalidArchive, "File too large: #{path}" if limit && entry.uncompressed_size > limit
+
+    entry.compressed_data_offset = ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    if entry.compressed_data_offset + entry.compressed_size > @io.size
+      raise InvalidArchive, "Truncated file: #{path}"
+    end
+
+    @io.seek(entry.compressed_data_offset)
+    extractor = entry.extractor_from(@io)
+    size = 0
+    crc = 0
+    until extractor.eof?
+      chunk = extractor.extract(16.kilobytes)
+      raise InvalidArchive, "Truncated file: #{path}" if chunk.nil?
+      size += chunk.bytesize
+      raise InvalidArchive, "Invalid file size: #{path}" if size > entry.uncompressed_size || (limit && size > limit)
+      crc = Zlib.crc32(chunk, crc)
+      yield chunk
+    end
+    unless size == entry.uncompressed_size && crc == entry.crc32
+      raise InvalidArchive, "Damaged file: #{path}"
+    end
+  end
+
+  private
+    def validate_path(path)
+      if path.blank? || path.start_with?("/") || path.include?("\\") || path.include?("\0") || path.split("/").include?("..")
+        raise InvalidArchive, "Unsafe archive path"
+      end
+    end
+
+    # Range reads let imports use disk or S3 without downloading the entire ZIP.
+    class ServiceIO
+      attr_reader :size
+
+      def initialize(service, key, size)
+        @service, @key, @size = service, key, size
+        @position = 0
+        @buffer = ""
+        @buffer_offset = 0
+      end
+
+      def tell
+        @position
+      end
+
+      def seek(offset, whence = IO::SEEK_SET)
+        position = case whence
+        when IO::SEEK_SET then offset
+        when IO::SEEK_CUR then @position + offset
+        when IO::SEEK_END then size + offset
+        end
+        raise InvalidArchive, "Invalid ZIP offset" unless position && position.between?(0, size)
+        @position = position
+        0
+      end
+
+      def read(length = nil)
+        length ||= size - @position
+        raise InvalidArchive, "Archive metadata too large" if length > MAX_METADATA_SIZE
+        length = [ length, size - @position ].min
+        if length.zero?
+          ""
+        else
+          if length > 8.megabytes
+            data = @service.download_chunk(@key, @position...(@position + length))
+          else
+            unless @position >= @buffer_offset && @position + length <= @buffer_offset + @buffer.bytesize
+              @buffer_offset = @position
+              buffer_end = [ @position + 8.megabytes, size ].min
+              @buffer = @service.download_chunk(@key, @position...buffer_end)
+            end
+            data = @buffer.byteslice(@position - @buffer_offset, length)
+          end
+          raise InvalidArchive, "Truncated archive" unless data && data.bytesize == length
+          @position += data.bytesize
+          data
+        end
+      end
+    end
+end
