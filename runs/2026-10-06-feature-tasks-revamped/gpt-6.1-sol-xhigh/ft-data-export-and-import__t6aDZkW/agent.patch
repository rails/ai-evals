new file mode 100644
index 0000000..c57aa6b
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,37 @@
+class Account::DataTransfer::RichText
+  class << self
+    def export(html)
+      transform(html) do |node|
+        if node["sgid"].present?
+          attachable = ActionText::Attachable.from_attachable_sgid(node["sgid"])
+          if attachable.is_a?(User) || attachable.is_a?(ActiveStorage::Blob)
+            node["data-fizzy-type"] = attachable.class.name
+            node["data-fizzy-id"] = attachable.id
+            node.remove_attribute("sgid")
+            node.remove_attribute("url")
+          end
+        end
+      end
+    end
+
+    def restore(html, &resolver)
+      transform(html) do |node|
+        if node["data-fizzy-id"].present?
+          attachable = resolver.call(node["data-fizzy-type"], node["data-fizzy-id"])
+          attachable.to_rich_text_attributes.each { |key, value| node[key.to_s] = value.to_s }
+          node.remove_attribute("data-fizzy-type")
+          node.remove_attribute("data-fizzy-id")
+        elsif node["sgid"].present?
+          raise Account::DataTransfer::Restorer::InvalidArchive, "Non-portable rich text attachment"
+        end
+      end
+    end
+
+    private
+      def transform(html)
+        fragment = Nokogiri::HTML.fragment(html)
+        fragment.css("action-text-attachment").each { |node| yield node }
+        fragment.to_html
+      end
+  end
+end
