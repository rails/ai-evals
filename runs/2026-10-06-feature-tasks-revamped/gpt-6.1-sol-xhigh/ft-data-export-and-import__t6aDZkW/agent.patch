diff --git a/test/models/account/data_transfer/round_trip_test.rb b/test/models/account/data_transfer/round_trip_test.rb
new file mode 100644
index 0000000..2f10e25
--- /dev/null
+++ b/test/models/account/data_transfer/round_trip_test.rb
@@ -0,0 +1,171 @@
+require "test_helper"
+
+class Account::DataTransfer::RoundTripTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+    @user = users(:kevin)
+  end
+
+  test "an account export restores into a separate account with people, cards, comments and files" do
+    @card.image.attach(io: StringIO.new("cover picture"), filename: "cover.png", content_type: "image/png")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document content"), filename: "document.txt", content_type: "text/plain")
+    @card.update!(description: ActionText::Content.new("<p>Remember this</p>").append_attachables([ blob, users(:david) ]))
+    comment = @card.comments.create!(creator: @user, body: ActionText::Content.new("<p>Comment with a file</p>").append_attachables([
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("comment file"), filename: "comment.txt", content_type: "text/plain")
+    ]))
+    filter = @user.filters.create!(fields: { card_ids: [ @card.id ] })
+    filter.board_ids = [ @card.board_id ]
+    filter.assignee_ids = [ users(:david).id ]
+    export = build_export
+    import = import_export(export)
+
+    assert import.completed?, import.error
+    restored = import.account
+    assert_not_equal @account, restored
+    assert_not_equal @account.external_account_id, restored.external_account_id
+    assert_equal @account.cards.count, restored.cards.count
+    assert_equal @account.boards.count, restored.boards.count
+    assert_equal @account.users.count, restored.users.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: restored).count
+    assert restored.users.find_by!(identity: @user.identity).owner?
+    restored_card = restored.cards.find_by!(number: @card.number)
+    assert_equal "cover picture", restored_card.image.download
+    assert_equal "document content", restored_card.attachments.first.download
+    assert_not_equal blob.key, restored_card.attachments.first.blob.key
+    assert_equal [ "ActiveStorage::Blob", "User" ], restored_card.description.body.attachables.map { |record| record.class.name }
+    assert restored_card.description.body.attachables.all? { |record| record.account == restored }
+    assert_equal "comment file", restored_card.comments.find { |entry| entry.body.to_plain_text.include?("Comment with a file") }.attachments.first.download
+    restored_filter = restored.users.find_by!(identity: @user.identity).filters.find_by!(fields: { card_ids: [ restored_card.id ] })
+    assert_equal [ restored_card.board_id ], restored_filter.board_ids
+    assert_equal [ restored.users.find_by!(identity: users(:david).identity).id ], restored_filter.assignee_ids
+    assert_not import.source_service.exist?(import.source_key)
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob, args: [ "Account::ImportMailer", "finished", "deliver_now", { args: [ import ] } ]
+  end
+
+  test "failure after files are uploaded rolls back every imported record and removes files" do
+    @card.image.attach(io: StringIO.new("picture"), filename: "cover.png", content_type: "image/png")
+    export = build_export
+    import = prepare_import(export)
+    restorer = Account::DataTransfer::Restorer.new(import)
+    Account::DataTransfer::Restorer.stubs(:new).with(import).returns(restorer)
+    service = ActiveStorage::Blob.service
+    Account::DataTransfer::Restorer.any_instance.stubs(:rebuild_derived_data).raises(StandardError, "late failure")
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count }, -> { Comment.count }, -> { ActiveStorage::Blob.count }, -> { Identity.count }, -> { Entropy.count } ] do
+      import.restore_now
+    end
+    assert import.failed?
+    assert_nil import.account
+    uploaded_keys = restorer.instance_variable_get(:@uploaded_keys)
+    assert uploaded_keys.any?
+    assert uploaded_keys.none? { |key| service.exist?(key) }
+    assert_not service.exist?(import.source_key)
+    assert import.error.present?
+  end
+
+  test "cards exports cannot be imported as an account" do
+    import = import_export(build_export(kind: :cards))
+    assert import.failed?
+    assert_match /account export/, import.error
+    assert_nil import.account
+  end
+
+  test "importer not in exported account becomes its owner" do
+    export = build_export
+    import = prepare_import(export, identity: identities(:mike))
+    import.restore_now
+    assert import.completed?, import.error
+    owner = import.account.users.find_by!(identity: identities(:mike))
+    assert owner.owner?
+    assert_equal import.account.boards.count, owner.boards.count
+  end
+
+  test "exports never include other exports or their ZIP files" do
+    first = build_export
+    second = build_export
+    zip = ZipFile::Reader.new(service: second.archive.blob.service, key: second.archive.blob.key, byte_size: second.archive.blob.byte_size)
+    assert_empty zip.glob("exports/*")
+    assert_not_includes zip.glob("active_storage_blobs/*"), "active_storage_blobs/#{first.archive.blob.id}.json"
+    assert_not_includes zip.glob("files/*"), "files/#{first.archive.blob.id}"
+  end
+
+  test "incomplete archives and cross-account references leave no account" do
+    export = build_export
+    import = altered_import(export) do |path, data|
+      if path == "cards/#{@card.id}.json"
+        nil
+      else
+        data
+      end
+    end
+    assert_no_difference -> { Account.count } do
+      import.restore_now
+    end
+    assert import.failed?
+    assert_match /incomplete/, import.error
+
+    import = altered_import(export) do |path, data|
+      if path == "cards/#{@card.id}.json"
+        data.merge("board_id" => boards(:miltons_wish_list).id)
+      else
+        data
+      end
+    end
+    assert_no_difference -> { Account.count } do
+      import.restore_now
+    end
+    assert import.failed?
+    assert_match /board_id reference/, import.error
+  end
+
+  test "failure saving completion also cleans uploaded files and rolls back the account" do
+    @card.image.attach(io: StringIO.new("picture"), filename: "cover.png", content_type: "image/png")
+    import = prepare_import(build_export)
+    restorer = Account::DataTransfer::Restorer.new(import)
+    Account::DataTransfer::Restorer.stubs(:new).with(import).returns(restorer)
+    import.define_singleton_method(:update!) do |attributes|
+      raise "Could not save completion" if attributes[:status] == :completed
+      super(attributes)
+    end
+    assert_no_difference [ -> { Account.count }, -> { ActiveStorage::Blob.count } ] do
+      import.restore_now
+    end
+    assert import.failed?
+    assert restorer.instance_variable_get(:@uploaded_keys).none? { |key| ActiveStorage::Blob.service.exist?(key) }
+  end
+
+  private
+    def altered_import(export)
+      reader = ZipFile::Reader.new(service: export.archive.blob.service, key: export.archive.blob.key, byte_size: export.archive.blob.byte_size)
+      import = Account::Import.create!(identity: @user.identity)
+      Tempfile.create([ "altered-export", ".zip" ]) do |file|
+        file.binmode
+        writer = ZipFile::Writer.new(file)
+        reader.glob("**/*").each do |path|
+          if path.end_with?(".json")
+            data = yield path, reader.read_json(path)
+            writer.add_file(path, data.to_json) if data
+          else
+            writer.add_file(path, compress: false) { |sink| reader.extract(path) { |chunk| sink.write(chunk) } }
+          end
+        end
+        writer.close
+        import.store_file(file)
+      end
+      import
+    end
+
+    def build_export(kind: :account)
+      Export.create!(account: @account, user: @user, kind: kind).tap(&:build_now)
+    end
+
+    def prepare_import(export, identity: @user.identity)
+      Account::Import.create!(identity: identity).tap do |import|
+        export.archive.blob.open { |file| import.store_file(file) }
+      end
+    end
+
+    def import_export(export)
+      prepare_import(export).tap(&:restore_now)
+    end
+end
