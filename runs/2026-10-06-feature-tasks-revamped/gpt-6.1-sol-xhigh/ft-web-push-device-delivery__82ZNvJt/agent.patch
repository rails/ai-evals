+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,167 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  driven_by :selenium, using: :headless_chrome do |options|
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+  end
+
+  setup do
+    @original_keys = ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = "AQIDBA", "private-key"
+    sign_in_as users(:david)
+    mock_push_browser
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = @original_keys
+  end
+
+  test "enables and disables notifications for this device" do
+    open_settings
+    assert_selector "[data-notifications-target=button]:not([disabled])[aria-checked=false]"
+
+    find("[data-notifications-target=button]:not([disabled])").click
+    assert_selector ".notifications--on [aria-checked=true]"
+    subscription = users(:david).push_subscriptions.last
+    assert_equal "https://push.example.com/device", subscription.endpoint
+    assert_equal "public-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal [ 1, 2, 3, 4 ], page.evaluate_script("pushTest.serverKey")
+    assert_equal true, page.evaluate_script("pushTest.userVisibleOnly")
+
+    find("[data-notifications-target=button]:not([disabled])").click
+    assert_selector "[data-notifications-target=button]:not([disabled])[aria-checked=false]"
+    assert_not users(:david).push_subscriptions.exists?(subscription.id)
+    assert_equal 1, page.evaluate_script("pushTest.unsubscribeCount")
+  end
+
+  test "existing browser subscriptions are registered without prompting again" do
+    page.execute_script("Notification.permission = 'granted'; pushTest.subscription = pushTest.device")
+    open_settings
+    assert_selector ".notifications--on [aria-checked=true]"
+    assert_equal 1, users(:david).push_subscriptions.count
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+  end
+
+  test "denied permission shows browser help without registering a device" do
+    page.execute_script("pushTest.permissionResult = 'denied'")
+    open_settings
+    find("[data-notifications-target=button]:not([disabled])").click
+    assert_selector "[data-notifications-target=help]:not([hidden])"
+    assert_selector "[data-notifications-target=button][aria-checked=false]"
+    assert_equal 0, users(:david).push_subscriptions.count
+  end
+
+  test "dismissing the permission prompt leaves notifications off" do
+    page.execute_script("pushTest.permissionResult = 'default'")
+    open_settings
+    find("[data-notifications-target=button]:not([disabled])").click
+    assert_selector "[data-notifications-target=button]:not([disabled])[aria-checked=false]"
+    assert_equal 0, users(:david).push_subscriptions.count
+  end
+
+  test "missing server keys leave the toggle disabled" do
+    ENV.delete("VAPID_PRIVATE_KEY")
+    open_settings
+    assert_selector "[data-notifications-target=button][disabled]"
+    assert_text "Push notifications are not available on this server."
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+  end
+
+  test "unsupported browsers show help and cannot enable push" do
+    page.execute_script("delete window.PushManager")
+    open_settings
+    assert_selector "[data-notifications-target=button][disabled]"
+    assert_selector "[data-notifications-target=help]:not([hidden])"
+    assert_text "This browser does not support push notifications."
+  end
+
+  test "failed registration rolls back a newly created browser subscription" do
+    page.execute_script <<~JS
+      const originalFetch = window.fetch
+      window.fetch = (url, options) => {
+        if (url.toString().includes("push_subscriptions")) {
+          return Promise.resolve(new Response("{}", { status: 500, headers: { "Content-Type": "application/json" } }))
+        }
+        return originalFetch(url, options)
+      }
+    JS
+    open_settings
+    find("[data-notifications-target=button]:not([disabled])").click
+    assert_text "Couldn't update notifications. Please try again."
+    assert_selector "[data-notifications-target=button]:not([disabled])[aria-checked=false]"
+    assert_equal 1, page.evaluate_script("pushTest.unsubscribeCount")
+    assert_equal 0, users(:david).push_subscriptions.count
+  end
+
+  test "service worker displays push copy and opens its card" do
+    worker = ApplicationController.renderer.render(template: "pwa/service_worker", formats: [ :js ], layout: false)
+    result = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      const listeners = {}
+      const worker = {
+        location: { origin: "https://fizzy.example.com" },
+        addEventListener: (name, callback) => listeners[name] = callback,
+        registration: { showNotification: (title, options) => { worker.shown = { title, options }; return Promise.resolve() } },
+        clients: {
+          claim: () => Promise.resolve(),
+          openWindow: (url) => { worker.opened = url; return Promise.resolve() }
+        }
+      }
+      const offline = { addRule() {}, start() {}, handlers: { networkFirst() {}, cacheFirst() {} } }
+      new Function("self", "TurboOffline", "importScripts", #{worker.to_json})(worker, offline, () => {})
+      listeners.push({ data: null, waitUntil: () => { throw new Error("Empty pushes must be ignored") } })
+      listeners.notificationclick({ notification: { data: {}, close() {} }, waitUntil: () => { throw new Error("Missing URLs must be ignored") } })
+      listeners.notificationclick({ notification: { data: { url: "https://other.example.com" }, close() {} }, waitUntil: () => { throw new Error("External URLs must be ignored") } })
+      const payload = { title: "Card title", body: "Added by David", url: "/123/cards/42", tag: "notification_1", icon: "/app-icon-192.png" }
+      let pending
+      listeners.push({ data: { json: () => payload }, waitUntil: promise => pending = promise })
+      pending.then(() => {
+        listeners.notificationclick({ notification: { data: { url: payload.url }, close: () => worker.closed = true }, waitUntil: promise => pending = promise })
+        return pending
+      }).then(() => done({ shown: worker.shown, opened: worker.opened, closed: worker.closed }))
+    JS
+    assert_equal "Card title", result.dig("shown", "title")
+    assert_equal "Added by David", result.dig("shown", "options", "body")
+    assert_equal "notification_1", result.dig("shown", "options", "tag")
+    assert_equal "https://fizzy.example.com/123/cards/42", result["opened"]
+    assert_equal true, result["closed"]
+  end
+
+  private
+    def open_settings
+      # Keep the browser mocks across navigation, as a real Turbo visit does.
+      page.execute_script("Turbo.visit(#{notifications_settings_path.to_json})")
+      assert_text "Push Notifications"
+    end
+
+    def mock_push_browser
+      page.execute_script <<~JS
+        window.pushTest = { subscription: null, unsubscribeCount: 0, permissionRequests: 0, permissionResult: "granted" }
+        pushTest.device = {
+          toJSON: () => ({ endpoint: "https://push.example.com/device", keys: { p256dh: "public-key", auth: "auth-key" } }),
+          unsubscribe: () => { pushTest.subscription = null; pushTest.unsubscribeCount++; return Promise.resolve(true) }
+        }
+        Object.defineProperty(window, "Notification", { configurable: true, value: {
+          permission: "default",
+          requestPermission: () => {
+            pushTest.permissionRequests++
+            Notification.permission = pushTest.permissionResult
+            return Promise.resolve(Notification.permission)
+          }
+        } })
+        const registration = { pushManager: {
+          getSubscription: () => Promise.resolve(pushTest.subscription),
+          subscribe: (options) => {
+            pushTest.serverKey = Array.from(options.applicationServerKey)
+            pushTest.userVisibleOnly = options.userVisibleOnly
+            pushTest.subscription = pushTest.device
+            return Promise.resolve(pushTest.device)
+          }
+        } }
+        Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+          register: () => Promise.resolve(registration), ready: Promise.resolve(registration)
+        } })
+      JS
+    end
+end
