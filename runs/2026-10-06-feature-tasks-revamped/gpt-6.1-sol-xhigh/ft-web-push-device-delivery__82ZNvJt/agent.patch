--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    @user.with_lock do
+      subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: attributes[:endpoint])
+      status = subscription.new_record? ? :created : :ok
+
+      if subscription.update(attributes)
+        render json: { id: subscription.id, url: user_push_subscription_path(@user, subscription) }, status: status
+      else
+        render json: subscription.errors, status: :unprocessable_entity
+      end
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..52bae52
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,111 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "help", "error" ]
+  static values = { url: String, publicKey: String }
+
+  async connect() {
+    this.supported = "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+    this.subscription = null
+    this.#updateStatus()
+
+    if (!this.publicKeyValue) {
+      this.#showError("Push notifications are not available on this server.")
+    } else if (!this.supported) {
+      this.#showError("This browser does not support push notifications. Try installing Fizzy as a web app.")
+      this.helpTarget.hidden = false
+    } else {
+      try {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.registration = await navigator.serviceWorker.ready
+        const subscription = await this.registration.pushManager.getSubscription()
+
+        if (subscription && Notification.permission === "granted") {
+          await this.#saveSubscription(subscription)
+          this.subscription = subscription
+        }
+      } catch {
+        this.#showError("Couldn't check notification settings. Please try again.")
+      } finally {
+        this.#updateStatus()
+        this.buttonTarget.disabled = !this.registration
+      }
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      if (this.subscription) {
+        await this.#unsubscribe()
+      } else {
+        await this.#subscribe()
+      }
+    } catch {
+      this.#showError("Couldn't update notifications. Please try again.")
+    } finally {
+      this.#updateStatus()
+      this.buttonTarget.disabled = false
+    }
+  }
+
+  async #subscribe() {
+    // Request permission before any other asynchronous work to preserve the user gesture on Safari.
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      let subscription = await this.registration.pushManager.getSubscription()
+      const newSubscription = !subscription
+      subscription ||= await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      try {
+        await this.#saveSubscription(subscription)
+        this.subscription = subscription
+      } catch (error) {
+        if (newSubscription) await subscription.unsubscribe()
+        throw error
+      }
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (!response.ok) throw new Error("Subscription registration failed")
+    this.subscriptionUrl = (await response.json).url
+  }
+
+  async #unsubscribe() {
+    await this.subscription.unsubscribe()
+    this.subscription = null
+    const response = await destroy(this.subscriptionUrl, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Subscription removal failed")
+  }
+
+  #updateStatus() {
+    const enabled = !!this.subscription && Notification.permission === "granted"
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.setAttribute("aria-checked", enabled.toString())
+    this.helpTarget.hidden = !this.supported || Notification.permission !== "denied"
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
