+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+  end
+
+  test "delivers the notification payload" do
+    @subscription.expects(:push).with(@notification.push_payload)
+    Notification::PushJob.perform_now(@notification, @subscription)
+  end
+
+  test "retries transient delivery errors" do
+    @subscription.expects(:push).raises(Net::ReadTimeout)
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification::PushJob.perform_now(@notification, @subscription)
+    end
+  end
+
+  test "discards jobs when the device has been removed" do
+    Notification::PushJob.perform_later(@notification, @subscription)
+    @subscription.destroy!
