+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }
+    after_update_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured?
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription)
+      end
+    end
+  end
+
+  def push_payload
+    ApplicationController.renderer.new(script_name: account.slug).render(
+      template: "notifications/push", formats: [ :json ], locals: { notification: self }
+    )
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..adaa9ab
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,38 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, length: { maximum: 512 }, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+  validate :endpoint_is_https
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def push(payload)
+    if self.class.configured? && user.active?
+      Request.new(
+        message: payload,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: {
+          public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+          private_key: ENV.fetch("VAPID_PRIVATE_KEY"),
+          subject: "mailto:#{Mail::Address.new(ApplicationMailer.default[:from]).address}"
+        }
+      ).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy
+  end
+
+  private
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..b3b8ace
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+# Keep the Web Push encryption and response handling, but pin the connection to a
+# public IP just as we do for webhooks. Subscription endpoints are user input.
+class PushSubscription::Request < WebPush::Request
+  class UnsafeEndpoint < StandardError; end
+
+  def perform
+    ip = SsrfProtection.resolve_public_ip(uri.host)
+    raise UnsafeEndpoint, "Push endpoint must resolve to a public IP" unless ip
+
+    http = Net::HTTP.new(uri.host, uri.port)
+    http.ipaddr = ip
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
