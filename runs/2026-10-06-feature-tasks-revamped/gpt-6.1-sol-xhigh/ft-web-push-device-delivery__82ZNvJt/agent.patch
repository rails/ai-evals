+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError, PushSubscription::Request::UnsafeEndpoint
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(notification, subscription)
+    subscription.push(notification.push_payload)
+  end
+end
