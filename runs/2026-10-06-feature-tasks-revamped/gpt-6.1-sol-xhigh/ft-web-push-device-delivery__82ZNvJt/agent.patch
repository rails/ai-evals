+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+  end
+
+  test "new tray entries enqueue push delivery" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @notification.user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing tray entry enqueues push delivery" do
+    assert_enqueued_with(job: Notification::PushJob, args: [ @notification, @subscription ]) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "fans out to all of the recipient's devices and no one else's" do
+    other_device = @notification.user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/phone", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+    users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.com/david", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      @notification.push_later
+    end
+    devices = enqueued_jobs.select { |job| job[:job] == Notification::PushJob }.map { |job| job[:args].last["_aj_globalid"] }
+    assert_equal [ @subscription.to_gid.to_s, other_device.to_gid.to_s ].sort, devices.sort
+  end
+
+  test "reading and marking unread do not send pushes" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "does not enqueue pushes when keys are missing" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "push uses the tray copy and an account-scoped card link" do
+    payload = JSON.parse(@notification.push_payload)
+    helpers = ApplicationController.helpers
+    assert_equal helpers.event_notification_title(@notification.source), payload["title"]
+    assert_equal helpers.event_notification_body(@notification.source), payload["body"]
+    assert_equal "#{@notification.account.slug}/cards/#{@notification.card.to_param}", payload["url"]
+  end
+
+  test "mentions use the tray copy and open the mentioned comment" do
+    notification = notifications(:logo_mentioned_david)
+    payload = JSON.parse(notification.push_payload)
+    mention = notification.source
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}#comment_#{mention.source.id}", payload["url"]
+  end
+end
diff --git a/test/models/push_subscription/request_test.rb b/test/models/push_subscription/request_test.rb
new file mode 100644
index 0000000..ed9015a
--- /dev/null
+++ b/test/models/push_subscription/request_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    # An empty payload exercises the HTTP transport without needing encryption keys.
+    @request = PushSubscription::Request.new(
+      message: "", subscription: { endpoint: "https://push.example.com/device" }, vapid: {}
+    )
+  end
+
+  test "pins the TLS connection to a public IP" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.com").returns("1.2.3.4")
+    http = mock
+    Net::HTTP.expects(:new).with("push.example.com", 443).returns(http)
+    http.expects(:ipaddr=).with("1.2.3.4")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(5)
+    http.expects(:read_timeout=).with(5)
+    response = Net::HTTPCreated.new("1.1", "201", "Created")
+    http.expects(:request).with { |request| request.path == "/device" }.returns(response)
+
+    assert_equal response, @request.perform
+  end
+
+  test "does not contact private endpoints" do
+    SsrfProtection.expects(:resolve_public_ip).returns(nil)
+    Net::HTTP.expects(:new).never
+    assert_raises(PushSubscription::Request::UnsafeEndpoint) { @request.perform }
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..5f3f623
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key"
+    )
+    ApplicationMailer.stubs(:default).returns(from: "Support <support@example.com>")
+    @original_keys = ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = "vapid-public", "vapid-private"
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = @original_keys
+  end
+
+  test "push uses the device keys and configured VAPID keys" do
+    request = mock
+    PushSubscription::Request.expects(:new).with(
+      message: "payload",
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "public-key", auth: "auth-key" } },
+      vapid: { public_key: "vapid-public", private_key: "vapid-private", subject: "mailto:support@example.com" }
+    ).returns(request)
+    request.expects(:perform)
+
+    @subscription.push("payload")
+  end
+
+  test "delivers an encrypted payload with VAPID authentication" do
+    vapid = WebPush.generate_key
+    client = WebPush.generate_key
+    ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = vapid.public_key, vapid.private_key
+    @subscription.update!(p256dh_key: client.public_key, auth_key: WebPush.encode64(SecureRandom.random_bytes(16)))
+    SsrfProtection.stubs(:resolve_public_ip).returns("1.2.3.4")
+    delivery = stub_request(:post, @subscription.endpoint).with do |request|
+      request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Content-Encoding"] == "aes128gcm" && request.body.bytesize > 100
+    end.to_return(status: 201)
+
+    Notification::PushJob.perform_now(notifications(:logo_assignment_kevin), @subscription)
+
+    assert_requested delivery
+  end
+
+  [ WebPush::InvalidSubscription, WebPush::ExpiredSubscription ].each do |error_class|
+    test "removes #{error_class.name.demodulize} devices" do
+      response = mock(body: "")
+      request = mock
+      PushSubscription::Request.stubs(:new).returns(request)
+      request.expects(:perform).raises(error_class.new(response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.push("payload")
+      end
+    end
+  end
+
+  test "temporary failures preserve the subscription" do
+    request = mock
+    PushSubscription::Request.stubs(:new).returns(request)
+    request.expects(:perform).raises(Net::ReadTimeout)
+
+    assert_no_difference -> { PushSubscription.count } do
+      assert_raises(Net::ReadTimeout) { @subscription.push("payload") }
+    end
+  end
+
+  test "does not deliver without both VAPID keys" do
+    ENV.delete("VAPID_PRIVATE_KEY")
+    assert_not PushSubscription.configured?
+    PushSubscription::Request.expects(:new).never
+    @subscription.push("payload")
+  end
+
+  test "does not deliver to deactivated users" do
+    @subscription.user.deactivate
+    PushSubscription::Request.expects(:new).never
+    @subscription.push("payload")
+  end
+
+  test "rejects non HTTPS and malformed endpoints" do
+    [ "http://push.example.com/device", "not a URL", "https:///device", "https://user:password@push.example.com" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, endpoint
+      assert @subscription.errors[:endpoint].present?
+    end
+  end
+
+  test "destroying a user removes their subscriptions" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.user.destroy!
+    end
+  end
+end
