@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "content", "toggle", "deleteForm" ]
+  static values = { creatorId: String }
+
+  connect() {
+    const ownReaction = this.creatorIdValue === Current.user?.id
+    this.contentTarget.hidden = ownReaction
+    this.toggleTarget.hidden = !ownReaction
+    this.deleteFormTarget.hidden = true
+    this.element.classList.toggle("reaction--deleteable", ownReaction)
+  }
+
+  toggle() {
+    const expanded = this.element.classList.toggle("expanded")
+    this.toggleTarget.setAttribute("aria-expanded", expanded)
+    this.deleteFormTarget.hidden = !expanded
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..7e14888
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "errors" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.classList.add("reaction", "expanded")
+    this.formTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    event?.stopPropagation()
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorsTarget.textContent = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate(event) {
+    const content = this.inputTarget.value.trim()
+    let message = ""
+
+    if (content.length === 0) {
+      message = "Please enter a reaction."
+    } else if (Array.from(content).length > 16) {
+      message = "Reactions must be 16 characters or fewer."
+    }
+
+    this.inputTarget.setCustomValidity(message)
+
+    if (event.type === "submit" && message) {
+      event.preventDefault()
+      this.inputTarget.reportValidity()
+    }
+  }
+
+  submitted(event) {
+    if (event.detail.success) {
+      this.cancel()
+    }
+  }
+}
