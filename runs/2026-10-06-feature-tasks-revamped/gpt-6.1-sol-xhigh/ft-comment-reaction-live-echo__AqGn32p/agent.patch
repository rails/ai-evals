+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+  end
+
+  test "add, confirm, add another, and remove your reaction" do
+    within_reactions do
+      assert_no_selector ".reaction__input"
+      click_button "Add a reaction"
+      assert_no_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "🎉"
+      click_button "Confirm reaction"
+
+      assert_selector ".reactions__list .reaction", count: 1
+      assert_button "Add a reaction"
+      assert_no_selector ".reaction__input"
+
+      click_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Great!"
+      click_button "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_button "Add a reaction"
+
+      within ".reactions__list .reaction", text: "Great!" do
+        assert_no_button "Remove reaction"
+        find("[data-reaction-target='toggle']").click
+        click_button "Remove reaction"
+      end
+      assert_selector ".reactions__list .reaction", count: 1
+      assert_no_text "Great!"
+    end
+  end
+
+  test "cancel and Escape discard the draft without creating a reaction" do
+    within_reactions do
+      click_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Nope"
+      click_button "Cancel reaction"
+      assert_button "Add a reaction"
+      assert_no_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+
+      click_button "Add a reaction"
+      assert_field "Your reaction (16 characters maximum)", with: ""
+      fill_in "Your reaction (16 characters maximum)", with: "Nope"
+      find(".reaction__input").send_keys :escape
+      assert_button "Add a reaction"
+      assert_no_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+    end
+  end
+
+  test "length validation supports emoji and can recover from invalid input" do
+    within_reactions do
+      click_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "x" * 17
+      assert_equal "Reactions must be 16 characters or fewer.", find(".reaction__input")["validationMessage"]
+      click_button "Confirm reaction"
+      assert_no_selector ".reactions__list .reaction"
+      assert_selector ".reaction__input"
+
+      fill_in "Your reaction (16 characters maximum)", with: "🎉" * 16
+      click_button "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 1
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "another person's reaction arrives and disappears live without clearing your draft" do
+    within_reactions do
+      click_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "My draft"
+    end
+
+    reaction = @comment.reactions.create!(content: "Hello!", creator: users(:kevin))
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", text: "Hello!"
+      assert_operator find(".reaction [data-reaction-target='content'] .avatar").native.size.height, :<=, find(".reactions__list .reaction").native.size.height
+      assert_no_selector ".reaction--deleteable"
+      assert_no_button "Remove reaction"
+      assert_field "Your reaction (16 characters maximum)", with: "My draft"
+    end
+
+    @comment.card.update!(title: "Updated while reacting")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_selector "h1", text: "Updated while reacting"
+
+    within_reactions do
+      assert_field "Your reaction (16 characters maximum)", with: "My draft"
+      assert_no_button "Add a reaction"
+    end
+
+    reaction.destroy!
+    within_reactions do
+      assert_no_selector ".reactions__list .reaction"
+      assert_field "Your reaction (16 characters maximum)", with: "My draft"
+    end
+  end
+
+  test "your reaction remains removable after a card refresh" do
+    @comment.reactions.create!(content: "Mine!", creator: users(:david))
+    within_reactions { assert_selector ".reaction--deleteable" }
+
+    @comment.card.update!(title: "Refreshed after reacting")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_selector "h1", text: "Refreshed after reacting"
+
+    within_reactions do
+      find("[data-reaction-target='toggle']").click
+      click_button "Remove reaction"
+      assert_no_selector ".reactions__list .reaction"
+    end
+  end
+
+  test "two viewers
+ see additions and removals from the other browser" do
+    Capybara.using_session(:observer) do
+      sign_in_as users(:kevin)
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+    end
+
+    within_reactions do
+      click_button "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Agreed!"
+      click_button "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 1
+    end
+
+    Capybara.using_session(:observer) do
+      within_reactions do
+        assert_selector ".reactions__list .reaction", text: "Agreed!"
+        assert_no_selector ".reaction--deleteable"
+        assert_no_button "Remove reaction"
+      end
+    end
+
+    within_reactions do
+      find("[data-reaction-target='toggle']").click
+      click_button "Remove reaction"
+      assert_no_selector ".reactions__list .reaction"
+    end
+
+    Capybara.using_session(:observer) do
+      within_reactions { assert_no_selector ".reactions__list .reaction" }
+    end
+  end
+
+  private
+
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
