+      assert_select "h1", text: cards(:logo).title
+      assert_includes response.body, cards(:logo).description.to_plain_text
+      assert_select "form", count: 0
+      assert_select "turbo-cable-stream-source", count: 0
+    end
+  end
+
+  test "drafts cannot be opened directly" do
+    cards(:logo).update!(status: :drafted)
+
+    untenanted do
+      get public_board_card_path(@key, cards(:logo))
+      assert_response :not_found
+    end
+  end
+
+  test "cards must belong to the public board" do
+    with_current_user(:kevin) do
+      cards(:logo).move_to(boards(:private))
+    end
+
+    untenanted do
+      get public_board_card_path(@key, cards(:logo))
+      assert_response :not_found
+    end
+  end
+
+  test "card lookup does not leak matching numbers from other accounts" do
+    untenanted do
+      get public_board_card_path(@key, cards(:logo))
+      assert_response :success
+      assert_not_includes response.body, cards(:radio).title
+    end
+  end
+
+  test "revoking publication also revokes card access" do
+    boards(:writebook).unpublish
+
+    untenanted do
+      get public_board_card_path(@key, cards(:logo))
+      assert_response :not_found
+    end
+  end
+end
