--- a/test/controllers/boards_controller_test.rb
+++ b/test/controllers/boards_controller_test.rb
@@ -338,6 +338,52 @@ class BoardsControllerTest < ActionDispatch::IntegrationTest
     assert first_board["creator"]["email_address"].present?
   end
 
+  test "unpublished boards include a nil public URL in JSON" do
+    get board_path(boards(:writebook)), as: :json
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+
+    get boards_path, as: :json
+    assert_response :success
+    assert response.parsed_body.all? { |board| board.key?("public_url") && board["public_url"].nil? }
+  end
+
+  test "published boards include their public URL in index JSON" do
+    board = boards(:writebook)
+    board.publish
+
+    get boards_path, as: :json
+    assert_response :success
+    json = response.parsed_body.find { |item| item["id"] == board.id }
+    assert_equal public_board_url(board.publication.key, script_name: nil), json["public_url"]
+  end
+
+test "publication changes invalidate board JSON caches" do
+  original_cache_store = ApplicationController.cache_store
+  ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+
+  with_actionview_partial_caching do
+    board = boards(:writebook)
+    get board_path(board), as: :json
+    assert_nil response.parsed_body["public_url"]
+    etag = response.headers["ETag"]
+
+    post board_publication_path(board), as: :json
+    get board_path(board), as: :json, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_equal public_board_url(board.reload.publication.key, script_name: nil), response.parsed_body["public_url"]
+    etag = response.headers["ETag"]
+
+    delete board_publication_path(board), as: :json
+    get board_path(board), as: :json, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+ensure
+  ApplicationController.cache_store = original_cache_store
+end
+
   private
     def next_page_from_link_header(link_header)
       url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
