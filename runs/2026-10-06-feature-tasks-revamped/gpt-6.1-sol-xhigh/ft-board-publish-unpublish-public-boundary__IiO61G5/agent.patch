diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..23ce24a
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admins can publish and unpublish a board" do
+    post board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert @board.reload.published?
+
+    key = @board.publication.key
+    get board_path(@board), as: :json
+    assert_equal public_board_url(key, script_name: nil), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    untenanted do
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "publication is idempotent" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    post board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_equal key, @board.reload.publication.key
+
+    2.times do
+      delete board_publication_path(@board), as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "HTML publication redirects to board settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "board creators who are not admins cannot publish or unpublish" do
+    @board.publish
+    key = @board.publication.key
+    logout_and_sign_in_as :david
+    assert users(:david).can_administer_board?(@board)
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal key, @board.reload.publication.key
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "admins cannot publish boards in another account" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  test "anonymous visitors cannot publish" do
+    sign_out
+    post board_publication_path(@board), as: :json
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "account owners can publish" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert @board.reload.published?
+  end
+
+  test "members cannot publish an unpublished board" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "publication controls are shown to admins" do
+    get edit_board_path(@board)
+    assert_select "form[action=?]", board_publication_path(@board)
+  end
+
+  test "publication controls are hidden from non-admin board creators" do
+    logout_and_sign_in_as :david
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+end
diff --git a/test/controllers/boards_controller_test.rb b/test/controllers/boards_controller_test.rb
