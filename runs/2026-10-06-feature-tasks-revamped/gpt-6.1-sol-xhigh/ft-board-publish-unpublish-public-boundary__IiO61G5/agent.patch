index 0000000..9eef1ed
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anyone with the key can see a board without an account prefix" do
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      assert_select "h1", text: @board.name
+      assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+      assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain)), text: cards(:buy_domain).title
+      assert_select "form", count: 0
+      assert_select "turbo-cable-stream-source", count: 0
+    end
+  end
+
+  test "drafts are not shown" do
+    cards(:buy_domain).update!(status: :drafted)
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain)), count: 0
+    end
+  end
+
+  test "unknown and revoked keys return not found" do
+    untenanted do
+      get public_board_path("unknown")
+      assert_response :not_found
+
+      @board.unpublish
+      get public_board_path(@key)
+      assert_response :not_found
+    end
+  end
+
+  test "signed in users from another account can view a public board" do
+    sign_in_as :mike
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+    end
+  end
+
+  test "a board id is not a publication key" do
+    untenanted do
+      get public_board_path(@board.id)
+      assert_response :not_found
+    end
+  end
+
+  test "publishing does not allow anonymous access to private routes" do
+    get board_path(@board)
+    assert_response :redirect
+
+    get card_path(cards(:logo))
+    assert_response :redirect
+  end
+
+  test "republishing does not reactivate old links" do
+    @board.unpublish
+    @board.publish
+
+    untenanted do
+      get public_board_path(@key)
+      assert_response :not_found
+
+      get public_board_path(@board.publication.key)
+      assert_response :success
+    end
+  end
+
+  test "public routes are read only" do
+    untenanted do
+      post public_board_path(@key)
+      assert_response :not_found
+
+      patch public_board_card_path(@key, cards(:logo)), params: { card: { title: "Changed" } }
+      assert_response :not_found
+      assert_equal "The logo isn't big enough", cards(:logo).reload.title
+
+      delete public_board_column_path(@key, columns(:writebook_triage))
+      assert_response :not_found
+      assert Column.exists?(columns(:writebook_triage).id)
+    end
+  end
+
+  test "published private boards can also be viewed anonymously" do
+    board = boards(:private)
+    board.publish
+
+    untenanted do
+      get public_board_path(board.publication.key)
+      assert_response :success
+      assert_select "h1", text: board.name
+    end
+  end
+
+  test "revocation takes precedence over conditional requests" do
+    untenanted do
+      get public_board_path(@key)
+      etag = response.headers["ETag"]
+      @board.unpublish
+
+      get public_board_path(@key), headers: { "If-None-Match" => etag }
+      assert_response :not_found
+    end
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..1986c5d
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are not published by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).publication
+  end
+
+  test "publishing creates a unique secret key and touches the board" do
+    board = boards(:writebook)
+
+    freeze_time do
+      board.update_columns(updated_at: 1.minute.ago)
+      assert_changes -> { board.reload.updated_at } do
+        board.publish
+      end
+    end
+
+    assert board.reload.published?
+    assert_equal board.account, board.publication.account
+    assert_operator board.publication.key.length, :>=, 24
+    assert_not_equal board.publication.key, boards(:private).publish.key
+  end
+
+  test "republishing after revocation generates a new key" do
+    board = boards(:writebook)
+    old_key = board.publish.key
+
+    board.unpublish
+    assert_not board.published?
+    assert_not Board::Publication.exists?(key: old_key)
+
+    assert_not_equal old_key, board.publish.key
+  end
+
+  test "destroying a board also revokes its publication" do
+    board = boards(:writebook)
+    key = board.publish.key
+
+    board.destroy!
+
+    assert_not Board::Publication.exists?(key: key)
+  end
+end
