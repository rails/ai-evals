+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+    freeze_time
+  end
+
+  test "new displays the code form" do
+    request_code
+
+    untenanted do
+      get new_session_email_code_path
+
+      assert_response :success
+      assert_in_body @identity.email_address
+      assert_select "form[action=?]", session_email_code_path do
+        assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+      end
+    end
+  end
+
+  test "new without a pending challenge asks for an email" do
+    untenanted do
+      get new_session_email_code_path
+
+      assert_redirected_to new_session_url
+    end
+  end
+
+  test "valid code starts a session" do
+    request_code
+
+    untenanted do
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: @code }
+      end
+
+      assert_redirected_to landing_url
+      assert_equal @identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+      assert_nil session[:pending_email_authentication]
+    end
+  end
+
+  test "valid code respects the requested destination" do
+    return_url = board_url(boards(:writebook))
+    get return_url
+    assert_redirected_to new_session_path(script_name: nil)
+    follow_redirect!
+    request_code
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }
+
+      assert_redirected_to return_url
+    end
+  end
+
+  test "valid code via JSON returns a session token" do
+    request_code
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }, as: :json
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "invalid code does not sign in and can be retried" do
+    request_code
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "invalid code via JSON is unauthorized" do
+    request_code
+
+    untenanted do
+      post session_email_code_path, params: { code: "WRONG!" }, as: :json
+
+      assert_response :unauthorized
+      assert_equal "That code didn't work. Try again.", response.parsed_body["message"]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "code from a different challenge cannot sign in" do
+    request_code
+    other_code = identities(:david).email_codes.create!
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: other_code.code }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "expired code does not sign in" do
+    request_code
+    travel 15.minutes
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+
+      assert_redirected_to new_session_url
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "expired code via JSON is unauthorized" do
+    request_code
+    travel 15.minutes
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }, as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a code cannot be reused after signing out" do
+    request_code
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }
+      sign_out
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+
+      assert_redirected_to new_session_url
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "requesting a new code replaces the pending challenge" do
+    request_code
+    old_code = @code
+    request_code
+
+    untenanted do
+      post session_email_code_path, params: { code: old_code }
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "verification is rate limited" do
+    request_code
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  test "verification via JSON is rate limited" do
+    request_code
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }, as: :json
+
+      assert_response :too_many_requests
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def request_code
+      untenanted do
+        assert_emails 1 do
+          perform_enqueued_jobs do
+            post session_path, params: { email_address: @identity.email_address }
+          end
+        end
+        assert_redirected_to new_session_email_code_path
+      end
+
+      @code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+      assert_not_nil @code
+    end
+end
