diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..418667d
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,107 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_pending_authentication
+  before_action :ensure_pending_authentication
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if @email_code.consume(params.expect(:code))
+      session.delete(:pending_email_authentication)
+      identity = @email_code.identity
+
+      if join_account(identity)
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to destination_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      else
+        head :forbidden
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def set_pending_authentication
+      @pending_authentication = session[:pending_email_authentication] || {}
+      @email_code = Identity::EmailCode.find_by(id: @pending_authentication["email_code_id"])
+      @join_code = Account::JoinCode.find_by(id: @pending_authentication["join_code_id"]) if @pending_authentication["purpose"] == "join"
+      @restart_url = restart_url
+    end
+
+    def restart_url
+      if @pending_authentication["purpose"] == "signup"
+        new_signup_url
+      elsif @join_code
+        join_url(code: @pending_authentication["join_code"], script_name: @join_code.account.slug)
+      else
+        new_session_url
+      end
+    end
+
+    def ensure_pending_authentication
+      if @email_code.nil? || !@email_code.expires_at.future?
+        session.delete(:pending_email_authentication)
+
+        respond_to do |format|
+          format.html { redirect_to @restart_url, alert: "That code has expired. Enter your email to get a new one." }
+          format.json { render json: { message: "That code has expired. Request a new one." }, status: :unauthorized }
+        end
+      elsif @pending_authentication["purpose"] == "join"
+        if @join_code.nil? || @join_code.code != @pending_authentication["join_code"]
+          head :not_found
+        elsif !@join_code.active?
+          render "join_codes/inactive", status: :gone
+        end
+      end
+    end
+
+    def join_account(identity)
+      if @join_code
+        @join_code.redeem_if { |account| identity.join(account) }
+        @joined_user = User.active.find_by(account: @join_code.account, identity: identity)
+      else
+        true
+      end
+    end
+
+    def destination_url
+      if @pending_authentication["purpose"] == "signup"
+        new_signup_completion_url
+      elsif @joined_user
+        if @joined_user.setup?
+          landing_url(script_name: @join_code.account.slug)
+        else
+          new_users_verification_url(script_name: @join_code.account.slug)
+        end
+      else
+        after_authentication_url
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
