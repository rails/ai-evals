diff --git a/test/controllers/join_codes_controller_test.rb b/test/controllers/join_codes_controller_test.rb
index 7c55e80..ef75615 100644
--- a/test/controllers/join_codes_controller_test.rb
+++ b/test/controllers/join_codes_controller_test.rb
@@ -78,4 +78,142 @@ class JoinCodesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :too_many_requests
   end
+  test "email join creates membership only after verification and completes setup" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference -> { User.count } do
+        request_join_email("new@example.com")
+      end
+    end
+    assert_not cookies[:session_token].present?
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        assert_difference -> { @join_code.reload.usage_count }, 1 do
+          post session_email_code_path, params: { code: @email_code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    identity = Identity.find_by!(email_address: "new@example.com")
+    user = @account.users.find_by!(identity: identity)
+    assert_not user.setup?
+
+    post users_verifications_path(script_name: @account.slug)
+    assert_redirected_to new_users_join_path(script_name: @account.slug)
+    post users_joins_path(script_name: @account.slug), params: { user: { name: "New Person" } }
+    assert_redirected_to landing_path(script_name: @account.slug)
+    assert user.reload.setup?
+  end
+
+  test "email join signs in an existing member without consuming join usage" do
+    identity = identities(:jz)
+    assert_no_difference -> { Identity.count } do
+      request_join_email(identity.email_address)
+    end
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { @join_code.reload.usage_count } do
+          post session_email_code_path, params: { code: @email_code }
+        end
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+    assert_equal identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "email join adds an existing identity to the account" do
+    identity = identities(:mike)
+    assert_no_difference -> { Identity.count } do
+      request_join_email(identity.email_address)
+    end
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: @email_code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert identity.users.exists?(account: @account)
+  end
+
+  test "expired email join code does not join" do
+    freeze_time
+    request_join_email("new@example.com")
+    travel 15.minutes
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        assert_no_difference -> { User.count } do
+          post session_email_code_path, params: { code: @email_code }
+        end
+      end
+    end
+
+    assert_redirected_to join_url(code: @join_code.code, script_name: @account.slug)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "a join code exhausted before email verification cannot be redeemed" do
+    request_join_email("new@example.com")
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: @email_code }
+        end
+      end
+    end
+
+    assert_response :gone
+    assert_not cookies[:session_token].present?
+  end
+
+  test "a join code reset before email verification cannot be redeemed" do
+    request_join_email("new@example.com")
+    @join_code.reset
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: @email_code }
+      end
+    end
+
+    assert_response :not_found
+    assert_not cookies[:session_token].present?
+  end
+
+  test "incorrect email code cannot join" do
+    request_join_email("new@example.com")
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { @join_code.reload.usage_count } do
+          post session_email_code_path, params: { code: "WRONG!" }
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  private
+    def request_join_email(email_address)
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email_address }
+        end
+      end
+
+      assert_redirected_to new_session_email_code_path(script_name: nil)
+      @email_code = ActionMailer::Base.deliveries.last.subject[/\A[A-Z0-9]{6}/]
+      assert_not_nil @email_code
+      follow_redirect!
+      assert_response :success
+    end
 end
