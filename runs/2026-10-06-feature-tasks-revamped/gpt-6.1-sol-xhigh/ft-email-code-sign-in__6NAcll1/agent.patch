+++ b/test/models/identity/email_code_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Identity::EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code, stores only its digest, and expires in fifteen minutes" do
+    freeze_time do
+      email_code = @identity.email_codes.create!
+
+      assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+      assert_equal 15.minutes.from_now, email_code.expires_at
+      assert_not_equal email_code.code, email_code.code_digest
+      assert_nil Identity::EmailCode.find(email_code.id).code
+    end
+  end
+
+  test "consumes a valid code only once" do
+    email_code = @identity.email_codes.create!
+    another_copy = Identity::EmailCode.find(email_code.id)
+
+    assert_difference -> { Identity::EmailCode.count }, -1 do
+      assert email_code.consume(email_code.code)
+    end
+
+    assert_not another_copy.consume(email_code.code)
+  end
+
+  test "accepts lowercase and surrounding whitespace" do
+    email_code = @identity.email_codes.create!
+
+    assert email_code.consume(" #{email_code.code.downcase} \n")
+  end
+
+  test "does not consume an incorrect or blank code" do
+    email_code = @identity.email_codes.create!
+
+    assert_no_difference -> { Identity::EmailCode.count } do
+      assert_not email_code.consume("WRONG!")
+      assert_not email_code.consume("")
+      assert_not email_code.consume(nil)
+    end
+
+    assert email_code.consume(email_code.code)
+  end
+
+  test "works just before fifteen minutes" do
+    freeze_time do
+      email_code = @identity.email_codes.create!
+
+      travel 15.minutes - 1.second
+      assert email_code.consume(email_code.code)
+    end
+  end
+
+  test "does not work at or after fifteen minutes" do
+    freeze_time do
+      email_code = @identity.email_codes.create!
+
+      travel 15.minutes
+      assert_not email_code.consume(email_code.code)
+
+      travel 1.second
+      assert_not email_code.consume(email_code.code)
+    end
+  end
+
+  test "cleanup deletes only expired codes" do
+    expired_code = travel_to(16.minutes.ago) { @identity.email_codes.create! }
+    active_code = @identity.email_codes.create!
+
+    assert_difference -> { Identity::EmailCode.count }, -1 do
+      Identity::EmailCode.cleanup
+    end
+
+    assert_not Identity::EmailCode.exists?(expired_code.id)
+    assert Identity::EmailCode.exists?(active_code.id)
+  end
+
+  test "destroying an identity deletes its codes" do
+    email_code = @identity.email_codes.create!
+
+    @identity.destroy!
+
+    assert_not Identity::EmailCode.exists?(email_code.id)
+  end
+end
