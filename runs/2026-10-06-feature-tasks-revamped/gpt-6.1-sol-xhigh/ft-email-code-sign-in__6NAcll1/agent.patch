diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..b869377
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,40 @@
+class Identity::EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+  LENGTH = 6
+
+  belongs_to :identity
+
+  attr_reader :code
+
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  before_create :generate_code
+
+  def self.cleanup
+    expired.delete_all
+  end
+
+  def consume(code)
+    with_lock do
+      if expires_at.future? && ActiveSupport::SecurityUtils.secure_compare(code_digest, digest(code.to_s.strip.upcase))
+        destroy!
+        true
+      else
+        false
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  private
+    def generate_code
+      @code = SecureRandom.base36(LENGTH).upcase
+      self.code_digest = digest(@code)
+      self.expires_at = EXPIRATION.from_now
+    end
+
+    def digest(code)
+      OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code)
+    end
+end
