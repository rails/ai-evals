+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email code appears in the subject and both email bodies" do
+    email = IdentityMailer.email_code(identities(:kevin), code: "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "ABC123 is your Fizzy sign-in code", email.subject
+
+    [ email.html_part, email.text_part ].each do |part|
+      assert_includes part.body.decoded, "ABC123"
+      assert_includes part.body.decoded, "15 minutes"
+      assert_includes part.body.decoded, "only be used once"
+    end
+  end
+end
