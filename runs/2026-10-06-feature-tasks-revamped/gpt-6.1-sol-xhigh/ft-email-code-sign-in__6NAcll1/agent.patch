+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= @email_code.identity.email_address %></strong>. Enter it below to continue. It works for 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.label :code, "Sign-in code", class: "txt-small" %>
+    <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, minlength: Identity::EmailCode::LENGTH, maxlength: Identity::EmailCode::LENGTH, placeholder: "Enter your code…" %>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Use another email or get a new code", @restart_url %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
