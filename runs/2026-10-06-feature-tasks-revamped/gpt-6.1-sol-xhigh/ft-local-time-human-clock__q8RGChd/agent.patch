+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share buttons contain raw timestamps and escaped names instead of formatted dates" do
+    card = cards(:layout)
+    card.creator.name = 'David & <script>alert("test")</script>'
+    card.created_at = Time.utc(2025, 9, 19, 6, 15)
+    card.last_active_at = Time.utc(2025, 9, 20, 6, 15)
+
+    html = Time.use_zone("Asia/Tokyo") { bridged_share_card_button(card) }
+    button = Nokogiri::HTML.fragment(html).at_css("button")
+
+    assert_equal "2025-09-19T06:15:00Z", button["data-bridge-share-created-at"]
+    assert_equal "2025-09-20T06:15:00Z", button["data-bridge-share-updated-at"]
+    assert_equal card.creator.familiar_name, button["data-bridge-share-author"]
+    assert_equal "assigned to JZ", button["data-bridge-share-assignees"]
+    assert_nil button["data-bridge-share-description"]
+    assert_select Nokogiri::HTML.fragment(html), "script", count: 0
+  end
+
+  test "board share descriptions are preserved" do
+    html = bridged_share_url_button("3 open cards")
+    assert_equal "3 open cards", Nokogiri::HTML.fragment(html).at_css("button")["data-bridge-share-description"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..751155e
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamps are raw, canonical, and independent of the server timezone and clock" do
+    timestamp = Time.utc(2025, 9, 18, 20, 42)
+    utc_html = Time.use_zone("UTC") { local_time_tag(timestamp.in_time_zone) }
+
+    travel_to timestamp + 5.days do
+      local_html = Time.use_zone("America/Los_Angeles") { local_time_tag(timestamp.in_time_zone) }
+      assert_equal utc_html, local_html
+    end
+
+    assert_select Nokogiri::HTML.fragment(utc_html), "time", text: timestamp.iso8601 do |elements|
+      assert_equal timestamp.iso8601, elements.first["datetime"]
+      assert_equal "local-time", elements.first["data-controller"]
+      assert_equal "relative", elements.first["data-local-time-format-value"]
+      assert_nil elements.first["title"]
+    end
+  end
+
+  test "absolute formats and caller attributes are preserved" do
+    html = local_time_tag(Time.utc(2025, 9, 18), format: :date, class: "timestamp", data: { controller: "other", example: "value" })
+
+    assert_select Nokogiri::HTML.fragment(html), "time.timestamp" do |elements|
+      assert_equal "date", elements.first["data-local-time-format-value"]
+      assert_equal "other local-time", elements.first["data-controller"]
+      assert_equal "value", elements.first["data-example"]
+    end
+  end
+end
diff --git a/test/integration/local_time_rendering_test.rb b/test/integration/local_time_rendering_test.rb
new file mode 100644
index 0000000..6039a59
--- /dev/null
+++ b/test/integration/local_time_rendering_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card and comment timestamps remain raw across viewers and requests" do
+    with_actionview_partial_caching do
+      cookies[:timezone] = "America/Los_Angeles"
+      get card_path(cards(:logo))
+      assert_response :success
+
+      assert_select ".comment__permalink-title time[data-controller='local-time']", minimum: 1
+      assert_select ".card__meta time[data-controller='local-time']", minimum: 2
+      assert_select ".card-perma__closure-message time[data-controller='local-time']", minimum: 1
+      first_timestamps = timestamp_markup
+      assert first_timestamps.any?
+
+      cookies[:timezone] = "Asia/Tokyo"
+      travel_to 1.hour.from_now do
+        get card_path(cards(:logo))
+        assert_response :success
+        assert_equal first_timestamps, timestamp_markup
+      end
+    end
+  end
+
+  private
+    def timestamp_markup
+      Nokogiri::HTML(response.body).css("time[data-controller~='local-time']").map do |element|
+        assert_equal element["datetime"], element.text
+        assert_match(/Z\z/, element["datetime"])
+        assert_nil element["title"]
+        element.to_html
+      end
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..87c5c0a
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,163 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+  end
+
+  test "relative times follow the viewer's calendar rather than the server timezone" do
+    set_timezone "America/Los_Angeles"
+    page.execute_script('document.head.insertAdjacentHTML("beforeend", \'<meta name="timezone" content="Asia/Tokyo">\')')
+
+    timestamps = %w[
+      2025-09-18T20:42:00Z
+      2025-09-18T06:59:00Z
+      2025-09-13T20:42:00Z
+      2025-09-11T20:42:00Z
+      2024-09-11T20:42:00Z
+      2025-09-19T07:00:00Z
+      2025-09-21T20:42:00Z
+      2025-09-18T23:42:00Z
+    ]
+
+    assert_equal [ "1:42 PM", "yesterday", "5 days ago", "Sep 11", "Sep 11, 2024", "tomorrow", "in 3 days", "today" ],
+      format_timestamps(timestamps, now: "2025-09-18T22:42:00Z")
+
+    set_timezone "Asia/Tokyo"
+    assert_equal [ "5:42 AM", "3:59 PM" ], format_timestamps(timestamps.first(2), format: "time")
+  end
+
+  test "day boundaries work across daylight saving and year changes" do
+    set_timezone "America/New_York"
+
+    assert_equal [ "yesterday", "2 days ago", "tomorrow" ], format_timestamps(
+      %w[2025-03-09T05:30:00Z 2025-03-08T17:00:00Z 2025-03-11T04:00:00Z], now: "2025-03-10T04:15:00Z")
+    assert_equal [ "yesterday", "2 days ago", "tomorrow" ], format_timestamps(
+      %w[2025-11-02T04:30:00Z 2025-11-01T16:00:00Z 2025-11-04T05:00:00Z], now: "2025-11-03T05:15:00Z")
+    assert_equal [ "tomorrow" ], format_timestamps([ "2026-01-01T05:00:00Z" ], now: "2025-12-31T23:00:00Z")
+    assert_equal [ nil ], format_timestamps([ "not-a-date" ])
+  end
+
+  test "timestamps inserted or morphed into the page get local text and a full tooltip" do
+    set_timezone "America/Los_Angeles"
+    insert_timestamp "2025-09-18T20:42:00Z", format: :time
+
+    assert_selector "#local-time-sample", text: "1:42 PM"
+    assert_match "Thursday, September 18, 2025", find("#local-time-sample")["title"]
+    assert_match "1:42 PM", find("#local-time-sample")["title"]
+    assert_equal "2025-09-18T20:42:00Z", find("#local-time-sample")["datetime"]
+
+    page.execute_script('document.getElementById("local-time-sample").setAttribute("datetime", "2025-09-19T06:15:00Z")')
+    assert_selector "#local-time-sample", text: "11:15 PM"
+    page.execute_script('document.getElementById("local-time-sample").dataset.localTimeFormatValue = "date_with_year"')
+    assert_selector "#local-time-sample", text: "Sep 18, 2025"
+
+    set_timezone "Asia/Tokyo"
+    page.execute_script('window.Stimulus.getControllerForElementAndIdentifier(document.getElementById("local-time-sample"), "local-time").update()')
+    assert_selector "#local-time-sample", text: "Sep 19, 2025"
+  end
+
+  test "relative labels refresh overnight and stop refreshing after removal" do
+    set_timezone "America/Los_Angeles"
+    page.execute_script(<<~JS)
+      const NativeDate = Date
+      window.localTimeNow = "2025-09-18T22:42:00Z"
+      window.Date = class extends NativeDate {
+        constructor(...args) { super(...(args.length ? args : [window.localTimeNow])) }
+        static now() { return new NativeDate(window.localTimeNow).getTime() }
+      }
+      const nativeSetInterval = window.setInterval
+      const nativeClearInterval = window.clearInterval
+      window.localTimeIntervals = new Map()
+      window.setInterval = (callback, delay, ...args) => {
+        const id = nativeSetInterval(callback, delay, ...args)
+        if (delay === 60000) window.localTimeIntervals.set(id, callback)
+        return id
+      }
+      window.clearInterval = id => {
+        window.localTimeIntervals.delete(id)
+        nativeClearInterval(id)
+      }
+    JS
+    insert_timestamp "2025-09-18T20:42:00Z", format: :relative
+    assert_selector "#local-time-sample", text: "1:42 PM"
+
+    page.execute_script(<<~JS)
+      const controller = window.Stimulus.getControllerForElementAndIdentifier(document.getElementById("local-time-sample"), "local-time")
+      const update = controller.update
+      controller.update = () => window.localTimeSampleInterval = window.currentLocalTimeInterval
+      window.localTimeIntervals.forEach((callback, id) => {
+        window.currentLocalTimeInterval = id
+        callback()
+      })
+      controller.update = update
+      window.localTimeNow = "2025-09-19T07:01:00Z"
+      window.localTimeIntervals.get(window.localTimeSampleInterval)()
+    JS
+    assert_selector "#local-time-sample", text: "yesterday"
+
+    page.execute_script('document.getElementById("local-time-sample").remove()')
+    assert_no_selector "#local-time-sample"
+    interval_still_running = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      setTimeout(() => done(window.localTimeIntervals.has(window.localTimeSampleInterval)), 0)
+    JS
+    assert_equal false, interval_still_running
+
+    insert_timestamp "2025-09-18T20:42:00Z", format: :relative
+    assert_selector "#local-time-sample", text: "yesterday"
+  end
+
+  test "native share descriptions and stamps format raw timestamps in the browser" do
+    set_timezone "America/Los_Angeles"
+    card = cards(:layout)
+    card.created_at = Time.utc(2025, 9, 19, 6, 15)
+    card.last_active_at = Time.utc(2025, 9, 20, 6, 15)
+    html = ApplicationController.helpers.bridged_share_card_button(card)
+    page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+
+    description = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      import("controllers/bridge/share_controller").then(({ default: ShareController }) => {
+        const element = document.querySelectorAll("[data-bridge-share-created-at]")
+        const controller = new ShareController({ scope: { element: element[element.length - 1] } })
+        controller.send = (event, data) => done(data.description)
+        controller.shareUrl()
+      }).catch(error => done(error.message))
+    JS
+    assert_equal "Added Sep 18 by #{card.creator.familiar_name} and assigned to JZ. Updated Sep 19", description
+
+    description = page.evaluate_async_script(<<~JS)
+      const done = arguments[0]
+      import("controllers/bridge/stamp_controller").then(({ default: StampController }) => {
+        const element = document.createElement("div")
+        element.dataset.bridgeTimestamp = "2025-09-19T06:15:00Z"
+        element.dataset.bridgeTitle = "Done"
+        const controller = new StampController({ scope: { element } })
+        controller.send = (event, data) => done(data.description)
+        controller.notifyBridgeOfConnect()
+      }).catch(error => done(error.message))
+    JS
+    assert_equal "Sep 18, 2025", description
+  end
+
+  private
+    def set_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def format_timestamps(timestamps, format: "relative", now: "2025-09-18T22:42:00Z")
+      page.evaluate_async_script(<<~JS, timestamps, format, now)
+        const [timestamps, format, now, done] = arguments
+        import("helpers/local_time_helpers").then(({ formatLocalTime }) => {
+          done(timestamps.map(timestamp => formatLocalTime(new Date(timestamp), format, new Date(now))))
+        }).catch(error => done(error.message))
+      JS
+    end
+
+    def insert_timestamp(timestamp, format:)
+      html = ApplicationController.helpers.local_time_tag(Time.iso8601(timestamp), format: format, id: "local-time-sample")
+      page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+    end
+end
