diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c1d1edc
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,38 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const FORMATS = {
+  time: { hour: "numeric", minute: "2-digit", hour12: true },
+  date: { month: "short", day: "numeric" },
+  date_with_year: { month: "short", day: "numeric", year: "numeric" },
+  long_date: { weekday: "long", month: "long", day: "numeric" },
+  date_time: { year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit", hour12: true },
+  full: { weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit", hour12: true, timeZoneName: "short" }
+}
+
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  if (Number.isNaN(date.getTime())) return null
+
+  if (format === "relative") {
+    return relativeTime(date, now)
+  } else {
+    return new Intl.DateTimeFormat("en-US", FORMATS[format] || FORMATS.full).format(date)
+  }
+}
+
+function relativeTime(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return date > now ? "today" : formatLocalTime(date, "time")
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days < -1 && days > -7) {
+    return `${-days} days ago`
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else {
+    return formatLocalTime(date, date.getFullYear() === now.getFullYear() ? "date" : "date_with_year")
+  }
+}
