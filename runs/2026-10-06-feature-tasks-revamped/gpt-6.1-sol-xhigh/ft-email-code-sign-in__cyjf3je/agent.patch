new file mode 100644
index 0000000..233e37a
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,29 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+
+  scope :expired, -> { where(expires_at: ..Time.current) }
+
+  before_create :generate_code
+
+  def consume(code)
+    return unless persisted?
+
+    with_lock do
+      if expires_at.future? && ActiveSupport::SecurityUtils.secure_compare(self.code, code.to_s.strip.upcase)
+        destroy!
+        identity
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.base36(CODE_LENGTH).upcase
+      self.expires_at = EXPIRATION.from_now
+    end
+end
