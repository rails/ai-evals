index 0000000..5d72f95
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,90 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :set_email_code
+  before_action :set_join_code, only: :create
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = @email_code.consume(params.expect(:code))
+      session.delete(:email_code_id)
+      session.delete(:email_code_join_code)
+      session.delete(:email_code_request_url)
+      start_new_session_for identity
+      location = completed_authentication_url(identity)
+
+      respond_to do |format|
+        format.html { redirect_to location }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code didn't work or has expired. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work or has expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:email_code_id])
+      @email_code_request_url = session[:email_code_request_url] || new_session_path
+
+      unless @email_code
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email to get a new code." }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def set_join_code
+      if code = session[:email_code_join_code]
+        @join_code = Account::JoinCode.find_by(code: code)
+
+        unless @join_code&.active?
+          session.delete(:email_code_id)
+          session.delete(:email_code_join_code)
+          session.delete(:email_code_request_url)
+          respond_to do |format|
+            format.html { redirect_to new_session_path, alert: "That join code is no longer active. Ask for a new invitation." }
+            format.json { head :gone }
+          end
+        end
+      end
+    end
+
+    def completed_authentication_url(identity)
+      if @join_code
+        session.delete(:return_to_after_authenticating)
+        @join_code.redeem_if { |account| identity.join(account) }
+        user = identity.users.active.find_by(account: @join_code.account)
+
+        if user&.setup?
+          landing_url(script_name: @join_code.account.slug)
+        elsif user
+          new_users_verification_url(script_name: @join_code.account.slug)
+        else
+          join_url(code: @join_code.code, script_name: @join_code.account.slug)
+        end
+      else
+        after_authentication_url
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
