diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..73d2c2d
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code that expires in fifteen minutes" do
+    freeze_time do
+      email_code = @identity.email_codes.create!
+
+      assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+      assert_equal 15.minutes.from_now, email_code.expires_at
+    end
+  end
+
+  test "consumes a code once" do
+    email_code = @identity.email_codes.create!
+    code = email_code.code
+
+    assert_difference -> { EmailCode.count }, -1 do
+      assert_equal @identity, email_code.consume(code)
+    end
+    assert_nil email_code.consume(code)
+  end
+
+  test "a stale copy cannot consume an already-used code" do
+    email_code = @identity.email_codes.create!
+    stale_copy = EmailCode.find(email_code.id)
+
+    assert_equal @identity, email_code.consume(email_code.code)
+    assert_nil stale_copy.consume(stale_copy.code)
+  end
+
+  test "ignores case and surrounding whitespace" do
+    email_code = @identity.email_codes.create!
+
+    assert_equal @identity, email_code.consume(" #{email_code.code.downcase} ")
+  end
+
+  test "does not consume an incorrect or blank code" do
+    email_code = @identity.email_codes.create!
+
+    assert_no_difference -> { EmailCode.count } do
+      assert_nil email_code.consume("WRONG!")
+      assert_nil email_code.consume(nil)
+      assert_nil email_code.consume("")
+    end
+    assert_equal @identity, email_code.consume(email_code.code)
+  end
+
+  test "works until fifteen minutes have elapsed" do
+    email_code = @identity.email_codes.create!
+
+    travel_to email_code.expires_at - 1.second do
+      assert_equal @identity, email_code.consume(email_code.code)
+    end
+  end
+
+  test "does not consume an expired code including at the expiration boundary" do
+    email_code = @identity.email_codes.create!
+
+    travel_to email_code.expires_at, with_usec: true do
+      assert_no_difference -> { EmailCode.count } do
+        assert_nil email_code.consume(email_code.code)
+      end
+      assert_includes EmailCode.expired, email_code
+    end
+  end
+
+  test "expired code cleanup leaves valid codes alone" do
+    expired_code = @identity.email_codes.create!
+    expired_code.update!(expires_at: 1.second.ago)
+    valid_code = @identity.email_codes.create!
+
+    assert_difference -> { EmailCode.count }, -1 do
+      EmailCode.expired.delete_all
+    end
+    assert EmailCode.exists?(valid_code.id)
+  end
+end
