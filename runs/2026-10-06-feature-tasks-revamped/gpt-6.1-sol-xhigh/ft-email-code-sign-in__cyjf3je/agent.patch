diff --git a/test/controllers/sessions/email_codes_controller_test.rb b/test/controllers/sessions/email_codes_controller_test.rb
new file mode 100644
index 0000000..d30b440
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,280 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in by emailed code" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+
+      perform_enqueued_jobs
+      email = ActionMailer::Base.deliveries.last
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert_not_nil code
+      assert_equal [ identities(:kevin).email_address ], email.to
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+  test "invalid code can be retried without starting a session" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      email_code = EmailCode.last
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+      assert_response :unprocessable_entity
+      assert_select ".flash", text: /That code didn't work or has expired/
+      assert_select "input[name=code]"
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: email_code.code.downcase }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "expired code does not sign in" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      email_code = EmailCode.last
+
+      travel_to email_code.expires_at, with_usec: true do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: email_code.code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "new without a pending code asks for an email" do
+    untenanted do
+      get new_session_email_code_path(script_name: nil)
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "a code requires the browser that requested it" do
+    code = identities(:kevin).email_codes.create!.code
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "a code cannot be replayed after signing out" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      code = EmailCode.last.code
+      post session_email_code_path, params: { code: code }
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "a new request replaces the browser's pending code" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      first_code = EmailCode.last
+      post session_path, params: { email_address: identities(:david).email_address }
+      second_code = EmailCode.last
+      second_code.update!(code: "SECOND")
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: first_code.code }
+      end
+      assert_response :unprocessable_entity
+
+      post session_email_code_path, params: { code: second_code.code }
+      assert_equal identities(:david), Session.last.identity
+    end
+  end
+
+  test "sign-in preserves the original destination" do
+    destination = board_url(boards(:writebook), script_name: accounts("37s").slug)
+    get destination
+    assert_response :redirect
+
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      post session_email_code_path, params: { code: EmailCode.last.code }
+
+      assert_redirected_to destination
+    end
+  end
+
+  test "sign in via JSON" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+      end
+      assert_response :no_content
+      code = EmailCode.last.code
+
+      post session_email_code_path(format: :json), params: { code: "WRONG!" }
+      assert_response :unauthorized
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path(format: :json), params: { code: code }
+      end
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "code verification is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: EmailCode.last.code }
+      end
+      assert_redirected_to new_session_email_code_path
+
+      post session_email_code_path(format: :json), params: { code: EmailCode.last.code }
+      assert_response :too_many_requests
+    end
+  end
+
+  test "signup verifies email before completing account creation" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_no_difference -> { Account.count } do
+          assert_enqueued_emails 1 do
+            post signup_path, params: { signup: { email_address: "newuser@example.com" } }
+          end
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+      email_code = EmailCode.last
+      get new_session_email_code_path(script_name: nil)
+      assert_select "a[href=?]", new_signup_url
+
+      post session_email_code_path, params: { code: email_code.code }
+      assert_redirected_to new_signup_completion_url
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New User" } }
+      end
+      account = Account.last
+      assert_equal email_code.identity, account.users.find_by!(role: :owner).identity
+      assert_redirected_to landing_url(script_name: account.slug)
+    end
+  end
+
+  test "joining verifies email before redeeming the invitation" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        assert_enqueued_emails 1 do
+          post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "newmember@example.com" }
+        end
+      end
+    end
+    assert_redirected_to new_session_email_code_path(script_name: nil)
+    email_code = EmailCode.last
+
+    untenanted do
+      get new_session_email_code_path(script_name: nil)
+      assert_select "a[href=?]", join_url(code: join_code.code, script_name: account.slug)
+      assert_difference [ -> { User.count }, -> { join_code.reload.usage_count } ], 1 do
+        post session_email_code_path, params: { code: email_code.code }
+      end
+    end
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    user = email_code.identity.users.find_by!(account: account)
+    assert_not user.verified?
+
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_url(script_name: account.slug)
+    assert user.reload.setup?
+  end
+
+  test "existing members can join via email without consuming another invitation use" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference -> { Identity.count } do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identities(:kevin).email_address }
+    end
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path, params: { code: EmailCode.last.code }
+      end
+    end
+    assert_redirected_to landing_url(script_name: account.slug)
+  end
+
+  test "an invitation that expires before verification does not join or sign in" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "newmember@example.com" }
+    code = EmailCode.last.code
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count } ] do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "a reset invitation cannot be redeemed by a pending email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "newmember@example.com" }
+    code = EmailCode.last.code
+    join_code.reset
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count } ] do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "joining with another email can switch a signed-in identity after verification" do
+    sign_in_as :kevin
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identities(:mike).email_address }
+    assert_redirected_to new_session_email_code_path(script_name: nil)
+
+    untenanted do
+      get new_session_email_code_path(script_name: nil)
+      assert_response :success
+      post session_email_code_path, params: { code: EmailCode.last.code }
+    end
+    assert_equal identities(:mike), Session.last.identity
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+end
