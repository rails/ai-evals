+    email_code = identities(:kevin).email_codes.create!
+    email = EmailCodeMailer.sign_in(email_code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_includes email.subject, email_code.code
+    assert_includes email.text_part.body.to_s, email_code.code
+    assert_includes email.html_part.body.to_s, email_code.code
+    assert_includes email.text_part.body.to_s, "15 minutes"
+    assert_includes email.html_part.body.to_s, "15 minutes"
+  end
+end
