--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,37 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    render json: @user.push_subscriptions.select(:id, :endpoint).as_json(only: [ :id, :endpoint ])
+  end
+
+  def create
+    attributes = subscription_params
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: attributes[:endpoint])
+
+    if subscription.update(attributes)
+      render json: { id: subscription.id, endpoint: subscription.endpoint }, status: :created
+    else
+      render json: subscription.errors, status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1056646
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,117 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "error", "details" ]
+  static values = { url: String, publicKey: String }
+
+  #registration
+  #device
+  #busy = false
+
+  async connect() {
+    this.#device = undefined
+    this.#registration = undefined
+    this.element.classList.remove("notifications--on")
+    this.buttonTarget.disabled = true
+    this.buttonTarget.hidden = false
+    this.errorTarget.hidden = true
+
+    if (!("Notification" in window && "PushManager" in window && "serviceWorker" in navigator)) {
+      this.statusTarget.textContent = "Push notifications are not available in this browser."
+      this.buttonTarget.hidden = true
+    } else if (!this.publicKeyValue) {
+      this.statusTarget.textContent = "Push notifications are not configured for this app."
+      this.buttonTarget.hidden = true
+    } else {
+      try {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.#registration = await navigator.serviceWorker.ready
+        const subscription = await this.#registration.pushManager.getSubscription()
+
+        if (subscription) {
+          const response = await get(this.urlValue, { responseKind: "json" })
+          if (!response.ok) throw new Error("Could not load notification settings")
+          this.#device = (await response.json).find(device => device.endpoint === subscription.endpoint)
+        }
+      } catch (error) {
+        this.#showError("Could not load notification settings. Please try again.")
+      } finally {
+        this.#render()
+      }
+    }
+  }
+
+  async toggle() {
+    if (this.#busy || !this.#registration) return
+
+    this.#busy = true
+    this.buttonTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      if (this.#device) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch (error) {
+      this.#showError("Could not update notifications. Please try again.")
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async #enable() {
+    // Request permission directly from the click, before any other async work.
+    const permission = Notification.permission === "granted" ? "granted" : await Notification.requestPermission()
+
+    if (permission === "granted") {
+      const subscription = await this.#registration.pushManager.getSubscription() ||
+        await this.#registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      const { endpoint, keys } = subscription.toJSON()
+      const response = await post(this.urlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+        responseKind: "json"
+      })
+
+      if (!response.ok) throw new Error("Could not save subscription")
+      this.#device = await response.json
+    }
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${encodeURIComponent(this.#device.id)}`)
+    if (!response.ok) throw new Error("Could not remove subscription")
+
+    // Keep the browser subscription: other accounts on this device may still use it.
+    this.#device = undefined
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const bytes = atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, "="))
+    return Uint8Array.from(bytes, character => character.charCodeAt(0))
+  }
+
+  #render() {
+    const enabled = Boolean(this.#device)
+    const blocked = Notification.permission === "denied"
+
+    this.element.classList.toggle("notifications--on", enabled && !blocked)
+    this.buttonTarget.textContent = enabled ? "Turn off for this device" : "Turn on for this device"
+    this.buttonTarget.disabled = this.#busy || !this.#registration
+    this.statusTarget.textContent = blocked ? "Notifications are blocked by your browser." :
+      enabled ? "Notifications are on for this device." : "Notifications are off for this device."
+    this.detailsTargets.forEach(element => element.hidden = !blocked && !enabled)
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+}
