+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { previously_new_record? || source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured? && user.push_subscriptions.exists?
+      payload = ApplicationController.render(partial: "notifications/push", formats: [ :json ], locals: { notification: self })
+      user.push_subscriptions.find_each { |subscription| subscription.push_later(payload) }
+    end
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..eaf0849
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,49 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, length: { maximum: 512 }, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  class << self
+    def public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def configured?
+      public_key.present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+
+  def push_later(payload)
+    PushJob.perform_later(self, payload)
+  end
+
+  def push(payload)
+    if self.class.configured? && user.active? && account.active?
+      Request.new(message: payload, subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: vapid_options).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription, Request::InvalidEndpoint
+    destroy!
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add(:endpoint, "must be an HTTPS push service URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an HTTPS push service URL")
+    end
+
+    def vapid_options
+      {
+        public_key: self.class.public_key,
+        private_key: ENV.fetch("VAPID_PRIVATE_KEY"),
+        subject: ENV.fetch("BASE_URL", "https://fizzy.do")
+      }
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..33eae8a
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+class PushSubscription::Request < WebPush::Request
+  class InvalidEndpoint < StandardError; end
+
+  def perform
+    # Pin the resolved public IP to prevent DNS rebinding, while retaining the
+    # endpoint hostname for TLS verification and the VAPID audience.
+    address = SsrfProtection.resolve_public_ip(uri.hostname)
+    raise InvalidEndpoint unless address
+
+    http = Net::HTTP.new(uri.hostname, uri.port)
+    http.ipaddr = address
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
