+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription_params = {
+      endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key"
+    }
+  end
+
+  test "register a device for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal @user.account, subscription.account
+    assert_equal @subscription_params.stringify_keys, subscription.attributes.slice(*@subscription_params.keys.map(&:to_s))
+    assert_equal subscription.id, response.parsed_body["id"]
+  end
+
+  test "registering the same endpoint updates keys instead of duplicating a device" do
+    2.times do |index|
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: @subscription_params.merge(auth_key: "auth-#{index}")
+      }, as: :json
+      assert_response :created
+    end
+
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal "auth-1", @user.push_subscriptions.last.auth_key
+  end
+
+  test "list only the current user's devices without encryption keys" do
+    own = @user.push_subscriptions.create!(@subscription_params)
+    users(:kevin).push_subscriptions.create!(@subscription_params)
+
+    get user_push_subscriptions_path(@user), as: :json
+    assert_response :success
+    assert_equal [ { "id" => own.id, "endpoint" => own.endpoint } ], response.parsed_body
+  end
+
+  test "cannot register a device for another user, even as an admin" do
+    logout_and_sign_in_as users(:kevin)
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+    assert_response :forbidden
+  end
+
+  test "cannot access another account's user" do
+    post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @subscription_params }, as: :json
+    assert_response :not_found
+  end
+
+  test "remove only the selected device" do
+    subscription = @user.push_subscriptions.create!(@subscription_params)
+    other = @user.push_subscriptions.create!(@subscription_params.merge(endpoint: "https://push.example.com/other"))
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+    assert_response :no_content
+    assert other.reload
+  end
+
+  test "cannot remove someone else's device" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription_params)
+    delete user_push_subscription_path(@user, subscription), as: :json
+    assert_response :not_found
+    assert subscription.reload
+  end
+
+  test "subscription registration requires authentication" do
+    sign_out
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params }, as: :json
+    end
+    assert_response :redirect
+  end
+
+  test "cannot list another user's devices" do
+    get user_push_subscriptions_path(users(:kevin)), as: :json
+    assert_response :forbidden
+  end
+
+  test "reject incomplete subscriptions" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription_params.except(:auth_key) }, as: :json
+    assert_response :unprocessable_entity
+  end
+end
diff --git a/test/javascript/push_notifications_test.js b/test/javascript/push_notifications_test.js
new file mode 100644
index 0000000..eb70f03
--- /dev/null
+++ b/test/javascript/push_notifications_test.js
@@ -0,0 +1,158 @@
+// Browser API stubs keep these tests independent of an external push service.
+class Controller {}
+let state
+const subscription = {
+  endpoint: "https://push.example.com/device",
+  toJSON: () => ({ endpoint: subscription.endpoint, keys: { p256dh: "public-key", auth: "auth-key" } })
+}
+const response = (json, ok = true) => ({ ok, json: Promise.resolve(json) })
+const get = async () => response(state.devices, !state.failGet)
+const post = async (url, options) => {
+  state.posts.push({ url, options })
+  return response({ id: "device-id", endpoint: subscription.endpoint }, !state.failPost)
+}
+const destroy = async url => {
+  state.deletes.push(url)
+  return response(null, !state.failDelete)
+}
+const reset = ({ permission = "default", existing = false, devices = [] } = {}) => {
+  state = { posts: [], deletes: [], subscriptions: [], permissions: 0, existing, devices }
+  Object.defineProperty(window, "Notification", { configurable: true, value: {
+    permission,
+    async requestPermission() {
+      state.permissions++
+      this.permission = state.nextPermission || "granted"
+      return this.permission
+    }
+  } })
+  Object.defineProperty(window, "PushManager", { configurable: true, value: class {} })
+  Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+    register: async () => ({}),
+    ready: Promise.resolve({ pushManager: {
+      getSubscription: async () => state.existing ? subscription : null,
+      subscribe: async options => {
+        state.subscriptions.push(options)
+        state.existing = true
+        return subscription
+      }
+    } })
+  } })
+}
+const mount = async () => {
+  const controller = new NotificationsController()
+  controller.element = document.createElement("section")
+  controller.buttonTarget = document.createElement("button")
+  controller.statusTarget = document.createElement("p")
+  controller.errorTarget = document.createElement("p")
+  controller.errorTarget.hidden = true
+  controller.detailsTargets = [document.createElement("div")]
+  controller.urlValue = "/123/users/user-id/push_subscriptions"
+  controller.publicKeyValue = "AQID"
+  await controller.connect()
+  return controller
+}
+const assert = (condition, message) => { if (!condition) throw new Error(message) }
+const isOn = controller => controller.element.classList.contains("notifications--on")
+
+// The worker uses a separate global scope in production.
+const workerHandlers = {}
+const self = {
+  addEventListener: (type, handler) => workerHandlers[type] = handler,
+  location: { origin: "https://fizzy.example.com" },
+  registration: { showNotification: async (title, options) => { state.shown = { title, options } } },
+  clients: {
+    matchAll: async () => state.windows || [],
+    openWindow: async url => { state.opened = url }
+  }
+}
+
+async function runTests() {
+  reset()
+  let controller = await mount()
+  assert(!isOn(controller), "Notifications should start off")
+  assert(state.permissions === 0 && state.posts.length === 0, "Connecting must not opt a device in")
+  await controller.toggle()
+  assert(state.permissions === 1, "Enabling should request permission")
+  assert(state.subscriptions[0].userVisibleOnly, "Subscription must be user-visible")
+  assert(String(state.subscriptions[0].applicationServerKey) === "1,2,3", "Decode the VAPID public key")
+  const posted = state.posts[0].options.body.push_subscription
+  assert(posted.endpoint === subscription.endpoint && posted.p256dh_key === "public-key" && posted.auth_key === "auth-key", "Use the required subscription parameter names")
+  assert(isOn(controller), "Saved subscriptions should show as enabled")
+  await controller.toggle()
+  assert(state.deletes[0] === "/123/users/user-id/push_subscriptions/device-id", "Remove only this user's device")
+  assert(!isOn(controller), "Removing the device should show notifications as off")
+
+  reset({ permission: "granted", existing: true, devices: [{ id: "this-device", endpoint: subscription.endpoint }] })
+  controller = await mount()
+  assert(isOn(controller), "Restore the current device's saved setting")
+  assert(state.posts.length === 0, "Connecting with an existing device should not register again")
+assert(!controller.detailsTargets[0].hidden, "Enabled devices should show troubleshooting help")
+state.existing = false
+await controller.connect()
+assert(!isOn(controller), "A restored settings page must forget a subscription that no longer exists")
+
+  reset({ permission: "granted", existing: true, devices: [{ id: "other-device", endpoint: "https://push.example.com/other" }] })
+  controller = await mount()
+  assert(!isOn(controller), "Another device's subscription must not turn this one on")
+  await controller.toggle()
+  assert(state.permissions === 0 && state.subscriptions.length === 0, "Reuse an existing browser subscription without a new permission prompt")
+  assert(state.posts.length === 1 && isOn(controller), "Explicitly save an existing browser subscription for this user")
+
+  reset({ permission: "denied" })
+  state.nextPermission = "denied"
+  controller = await mount()
+  await controller.toggle()
+  assert(state.posts.length === 0 && state.subscriptions.length === 0, "Denied permission must not create a subscription")
+  assert(controller.statusTarget.textContent.includes("blocked") && !controller.detailsTargets[0].hidden, "Show shipped help for blocked browsers")
+
+  reset()
+  state.nextPermission = "default"
+  controller = await mount()
+  await controller.toggle()
+  assert(!isOn(controller) && state.posts.length === 0, "Dismissed permission should leave notifications off")
+
+  reset({ permission: "granted" })
+  state.failPost = true
+  controller = await mount()
+  await controller.toggle()
+  assert(!isOn(controller) && !controller.errorTarget.hidden, "Failed persistence must not show an enabled setting")
+  state.failPost = false
+  await controller.toggle()
+  assert(isOn(controller) && state.subscriptions.length === 1, "A failed save should be retryable using the same subscription")
+  state.failDelete = true
+  await controller.toggle()
+  assert(isOn(controller) && !controller.errorTarget.hidden, "Failed deletion must preserve the enabled setting")
+
+  reset()
+  delete window.PushManager
+  controller = await mount()
+  assert(controller.buttonTarget.hidden && controller.statusTarget.textContent.includes("not available"), "Unsupported browsers should show an explanation without crashing")
+
+  reset()
+  const payload = { title: "RE: A card", body: "Tray text", tag: "notification_123", data: { url: "/123/cards/456#comment_789" } }
+  let pending
+  workerHandlers.push({ data: { json: () => payload }, waitUntil: promise => pending = promise })
+  await pending
+  assert(state.shown.title === payload.title && state.shown.options.body === payload.body, "Display the tray title and body")
+  assert(state.shown.options.data.url === payload.data.url, "Preserve the card URL in notification data")
+  workerHandlers.push({ data: null })
+
+  const click = url => {
+    pending = null
+    workerHandlers.notificationclick({
+      notification: { data: { url }, close: () => state.closed = true },
+      waitUntil: promise => pending = promise
+    })
+    return pending
+  }
+  await click(payload.data.url)
+  assert(state.closed && state.opened === "https://fizzy.example.com/123/cards/456#comment_789", "Clicks should open the account-scoped card and comment")
+  state.opened = null
+  state.windows = [{ url: "https://fizzy.example.com/123/cards/456#comment_789", focus: async () => state.focused = true }]
+  await click(payload.data.url)
+  assert(state.focused && !state.opened, "Focus the card when it is already open")
+  await click(undefined)
+  await click("https://untrusted.example.com/")
+  assert(!state.opened, "Do not open a different origin")
+  return "Browser push and worker tests passed"
+}
