@@ -0,0 +1,30 @@
+require "test_helper"
+require "selenium-webdriver"
+
+class BrowserPushNotificationsTest < ActiveSupport::TestCase
+  test "device settings and service worker behavior" do
+    options = Selenium::WebDriver::Chrome::Options.new
+    options.add_argument("--headless")
+    options.add_argument("--no-sandbox")
+    options.add_argument("--disable-dev-shm-usage")
+    options.binary = ENV["CHROME_BIN"] if ENV["CHROME_BIN"]
+    browser = Selenium::WebDriver.for(:chrome, options: options)
+    browser.get("data:text/html,<html><body></body></html>")
+
+    controller = Rails.root.join("app/javascript/controllers/notifications_controller.js").read
+      .gsub(/^import .*\n/, "").sub("export default class", "class NotificationsController")
+    worker = Rails.root.join("app/views/pwa/service_worker.js.erb").read.split('self.addEventListener("push"', 2).last
+    harness = Rails.root.join("test/javascript/push_notifications_test.js").read
+    result = browser.execute_async_script(<<~JS)
+      #{harness}
+      #{controller}
+      self.addEventListener("push"#{worker}
+      const done = arguments[arguments.length - 1]
+      runTests().then(done).catch(error => done(error.stack))
+    JS
+
+    assert_equal "Browser push and worker tests passed", result
+  ensure
+    browser&.quit
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..e8bdc55
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public", auth_key: "auth")
+  end
+
+  test "new tray notification schedules a push to every device" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/second", p256dh_key: "public", auth_key: "auth")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: PushSubscription::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "changing the source of an existing tray entry schedules a push" do
+    notification = notifications(:logo_assignment_kevin)
+    assert_enqueued_jobs 1, only: PushSubscription::PushJob do
+      notification.update!(source: mentions(:logo_comment_david_mention_by_jz), creator: users(:jz), read_at: nil)
+    end
+  end
+
+  test "reading and marking unread do not send pushes" do
+    assert_no_enqueued_jobs only: PushSubscription::PushJob do
+      notifications(:logo_assignment_kevin).read
+      notifications(:logo_assignment_kevin).unread
+    end
+  end
+
+  test "push payload matches tray text and links to the account-scoped target" do
+    notification = notifications(:layout_commented_kevin)
+    notification.push_later
+    job = enqueued_jobs.find { |job| job[:job] == PushSubscription::PushJob }
+    payload = JSON.parse(job[:args].last)
+
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+    assert_equal Rails.application.routes.url_helpers.polymorphic_path(notification, script_name: notification.account.slug, only_path: true), payload.dig("data", "url")
+  end
+
+  test "mentions use the same text as the tray" do
+    notification = notifications(:logo_mentioned_david)
+    notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/david", p256dh_key: "public", auth_key: "auth")
+    notification.push_later
+    payload = JSON.parse(enqueued_jobs.find { |job| job[:job] == PushSubscription::PushJob }[:args].last)
+
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload["body"]
+  end
+
+  test "rapid updates retain the text from each tray update" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update!(source: events(:logo_assignment_jz))
+    notification.update!(source: events(:logo_assignment_david))
+    payloads = enqueued_jobs.select { |job| job[:job] == PushSubscription::PushJob }.map { |job| JSON.parse(job[:args].last) }
+
+    assert_equal [ "Assigned to JZ", "Assigned to David" ], payloads.map { |payload| payload["body"] }
+  end
+
+  test "rolled back tray updates never schedule a push" do
+    assert_no_enqueued_jobs only: PushSubscription::PushJob do
+      Notification.transaction do
+        notifications(:logo_assignment_kevin).update!(source: events(:logo_assignment_jz))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "no push jobs without registered devices" do
+    @subscription.destroy!
+    assert_no_enqueued_jobs only: PushSubscription::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+
+  test "no push jobs when VAPID is not configured" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: PushSubscription::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+end
diff --git a/test/models/push_subscription/subscription_test.rb b/test/models/push_subscription/subscription_test.rb
new file mode 100644
index 0000000..c671ec8
--- /dev/null
+++ b/test/models/push_subscription/subscription_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @original_environment = ENV.to_h.slice("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "BASE_URL")
+    @vapid = WebPush.generate_key
+    ENV["VAPID_PUBLIC_KEY"] = @vapid.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid.private_key
+    ENV["BASE_URL"] = "https://fizzy.example.com"
+
+    client = WebPush.generate_key
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/device", p256dh_key: client.public_key, auth_key: SecureRandom.urlsafe_base64(16))
+    @payload = { title: "A card", body: "Assigned to Kevin", data: { url: "/123/cards/456" } }.to_json
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  teardown do
+    %w[ VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY BASE_URL ].each { |key| ENV[key] = @original_environment[key] }
+  end
+
+  test "sends an encrypted payload signed with the configured VAPID keys" do
+    request = stub_request(:post, @subscription.endpoint).with do |request|
+      assert_equal "aes128gcm", request.headers["Content-Encoding"]
+      assert_equal "application/octet-stream", request.headers["Content-Type"]
+      assert_not_includes request.body, "Assigned to Kevin"
+      authorization = request.headers.fetch("Authorization")
+      assert_includes authorization, "k=#{@vapid.public_key.delete('=')}"
+      token = authorization[/t=([^,]+)/, 1]
+      claims = JWT.decode(token, @vapid.curve, true, algorithm: "ES256").first
+      assert_equal "https://push.example.com", claims["aud"]
+      assert_equal "https://fizzy.example.com", claims["sub"]
+      true
+    end.to_return(status: 201)
+
+    @subscription.push(@payload)
+    assert_requested request
+  end
+
+  test "expired and invalid endpoints are removed" do
+    [ 404, 410 ].each do |status|
+      subscription = @subscription.user.push_subscriptions.create!(
+        endpoint: "https://push.example.com/device-#{status}", p256dh_key: @subscription.p256dh_key, auth_key: @subscription.auth_key)
+      stub_request(:post, subscription.endpoint).to_return(status: status)
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push(@payload)
+      end
+    end
+  end
+
+  test "unauthorized requests preserve subscriptions so VAPID configuration can be fixed" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 403)
+    assert_raises WebPush::Unauthorized do
+      @subscription.push(@payload)
+    end
+    assert @subscription.reload
+  end
+
+  test "transient push service errors retry without removing the device" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 503)
+
+    assert_enqueued_with job: PushSubscription::PushJob do
+      PushSubscription::PushJob.perform_now(@subscription, @payload)
+    end
+    assert @subscription.reload
+  end
+
+  test "removed subscriptions are safely discarded by queued jobs" do
+    @subscription.push_later(@payload)
+    @subscription.destroy!
+    assert_nothing_raised do
+      perform_enqueued_jobs only: PushSubscription::PushJob
+    end
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "no delivery without VAPID configuration or to deactivated users" do
+    ENV.delete("VAPID_PRIVATE_KEY")
+    assert_not PushSubscription.configured?
+    @subscription.push(@payload)
+    ENV["VAPID_PRIVATE_KEY"] = @vapid.private_key
+    @subscription.user.update!(active: false)
+    @subscription.push(@payload)
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "deactivating a user removes their device subscriptions" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.user.deactivate
+    end
+  end
+
+  test "reject malformed, insecure or credential-bearing endpoint URLs" do
+    [ "http://push.example.com/device", "https://", "https://user:pass@push.example.com/device", "https://push.example.com/device#fragment", "not a URL" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, "Should reject #{endpoint}"
+    end
+  end
+
+  test "never sends to private or loopback addresses" do
+    stub_dns_resolution("127.0.0.1", "10.0.0.1", "169.254.169.254")
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.push(@payload)
+    end
+    assert_not_requested :post, @subscription.endpoint
+  end
+end
