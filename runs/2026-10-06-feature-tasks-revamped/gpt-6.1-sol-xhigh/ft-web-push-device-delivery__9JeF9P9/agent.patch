+class PushSubscription::PushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout,
+    Resolv::ResolvTimeout, Resolv::ResolvError, SocketError, Errno::ECONNRESET, Errno::ECONNREFUSED,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(subscription, payload)
+    subscription.push(payload)
+  end
+end
