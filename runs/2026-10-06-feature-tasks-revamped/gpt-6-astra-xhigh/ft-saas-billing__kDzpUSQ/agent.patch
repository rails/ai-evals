@@ -0,0 +1,18 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      # Serialize allowance checks with card creation/publishing on the primary DB.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit? && !@card&.published?
+          respond_to do |format|
+            format.json { render json: { error: "Card limit reached. Upgrade to publish more cards." }, status: :forbidden }
+            format.html { head :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
