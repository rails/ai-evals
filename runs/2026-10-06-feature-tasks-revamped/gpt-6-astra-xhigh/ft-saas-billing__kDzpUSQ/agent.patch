+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = ""
+  end
+
+  test "staff can browse accounts and use comp override and reset" do
+    sign_in_as :david
+    get saas.admin_accounts_path
+    assert_response :success
+    assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+    get saas.admin_account_path(@account)
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+
+    post saas.admin_account_billing_waiver_path(@account)
+    assert_redirected_to saas.admin_account_path(@account)
+    assert @account.reload.comped?
+    follow_redirect!
+    assert_select "button", text: "Uncomp"
+    delete saas.admin_account_billing_waiver_path(@account)
+    assert_not @account.reload.comped?
+
+    patch saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 950, bytes_used: 123 } }
+    assert_response :see_other
+    assert_equal 950, @account.reload.card_count
+    assert_equal 123, @account.bytes_used
+    assert_equal 0, accounts(:acme).card_count
+    delete saas.admin_account_overridden_limit_path(@account)
+    assert_response :see_other
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "invalid overrides are reported without changing saved usage" do
+    sign_in_as :david
+    @account.override_usage(card_count: 50)
+    patch saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: -1 } }
+    assert_response :unprocessable_entity
+    assert_select "[role=alert]", text: /greater than or equal to 0/
+    assert_equal 50, @account.reload.card_count
+  end
+
+  test "non-staff cannot read or change account billing" do
+    sign_in_as :mike
+    get saas.admin_accounts_path
+    assert_response :forbidden
+    get saas.admin_account_path(@account)
+    assert_response :forbidden
+    post saas.admin_account_billing_waiver_path(@account)
+    assert_response :forbidden
+    delete saas.admin_account_billing_waiver_path(@account)
+    assert_response :forbidden
+    patch saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 0 } }
+    assert_response :forbidden
+    delete saas.admin_account_overridden_limit_path(@account)
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..a710016
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+    integration_session.default_url_options[:script_name] = @account.slug
+    sign_in_as :mike
+    @account.update!(cards_count: 100)
+    @account.override_usage(card_count: 1_000)
+  end
+
+  test "at the limit drafts remain editable and new drafts can be saved" do
+    patch card_path(@draft), params: { card: { title: "Still drafting" } }, as: :json
+    assert_response :success
+    assert_equal "Still drafting", @draft.reload.title
+    assert @draft.drafted?
+
+    @account.cards.drafted.where(creator: users(:mike)).destroy_all
+    assert_difference -> { Card.drafted.count } do
+      post board_cards_path(@board)
+    end
+    assert_response :redirect
+  end
+
+  test "at the limit publishing and API creation are refused" do
+    assert_no_difference -> { Card.published.count } do
+      post card_publish_path(@draft)
+      assert_response :forbidden
+      post card_publish_path(@draft), as: :json
+      assert_response :forbidden
+      post board_cards_path(@board), params: { card: { title: "No room" } }, as: :json
+      assert_response :forbidden
+      assert_match "Upgrade", response.parsed_body["error"]
+    end
+    assert @draft.reload.drafted?
+  end
+
+  test "draft create buttons give way to Upgrade" do
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message a", text: "Upgrade"
+  end
+
+  test "board create controls become an upgrade pitch and show the approaching limit" do
+    get board_path(@board)
+    assert_response :success
+    assert_select ".board-tools .card-perma__account-limit-message a", text: "Upgrade"
+    assert_select ".board-tools form[action=?]", board_cards_path(@board), count: 0
+
+    @account.override_usage(card_count: 950)
+    get board_path(@board)
+    assert_response :success
+    assert_select ".board-tools [role=status] strong", text: "50 cards left"
+    assert_select ".board-tools form[action=?]", board_cards_path(@board)
+  end
+
+  test "billing changes invalidate conditional board responses" do
+    get board_path(@board)
+    assert_response :success
+    limited_etag = response.headers["ETag"]
+    assert limited_etag
+
+    @account.override_usage(card_count: 950)
+    get board_path(@board), headers: { "If-None-Match" => limited_etag }
+    assert_response :success
+    assert_select ".board-tools [role=status] strong", text: "50 cards left"
+    warning_etag = response.headers["ETag"]
+
+    @account.comp
+    get board_path(@board), headers: { "If-None-Match" => warning_etag }
+    assert_response :success
+    assert_select ".board-tools [role=status]", count: 0
+    assert_select ".board-tools form[action=?]", board_cards_path(@board)
+  end
+
+  test "the countdown starts at 100 remaining and handles singular cards" do
+    { 899 => nil, 900 => "100 cards left", 950 => "50 cards left", 999 => "1 card left" }.each do |count, text|
+      @account.override_usage(card_count: count)
+      get card_draft_path(@draft)
+      assert_response :success
+      assert_select ".card-perma__notch-new-card-buttons"
+      if text
+        assert_select "[role=status] strong", text: text
+      else
+        assert_select "[role=status]", count: 0
+      end
+    end
+  end
+
+  test "the thousandth published card is allowed and the next one is refused" do
+    @account.reset_usage_override
+    Card.where(account: @account).delete_all
+    template = @draft.attributes.except("id").merge("status" => "published")
+    Card.insert_all!((1..999).map { |number| template.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => number) })
+    @account.update!(cards_count: 999)
+    post board_cards_path(@board), params: { card: { title: "Thousandth" } }, as: :json
+    assert_response :created
+    post board_cards_path(@board), params: { card: { title: "One too many" } }, as: :json
+    assert_response :forbidden
+  end
+
+  test "comped and paid accounts have unlimited cards but their own storage limit" do
+    @account.comp
+    post card_publish_path(@draft)
+    assert_response :redirect
+    @account.uncomp
+    @account.create_subscription!(stripe_customer_id: "cus_paid", status: "active", plan_key: "unlimited")
+    @account.override_usage(bytes_used: 5.gigabytes + 1)
+    post board_cards_path(@board), params: { card: { title: "Full storage" } }, as: :json
+    assert_response :forbidden
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    post board_cards_path(@board), params: { card: { title: "More storage" } }, as: :json
+    assert_response :created
+  end
+end
