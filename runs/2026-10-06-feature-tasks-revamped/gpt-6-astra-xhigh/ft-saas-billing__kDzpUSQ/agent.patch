index 0000000..aae3531
--- /dev/null
+++ b/saas/app/controllers/account/billing/checkouts_controller.rb
@@ -0,0 +1,18 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find(params.require(:plan_key))
+    if plan.free? || Current.account.comped? || Current.account.subscription&.manageable?
+      head :conflict
+    else
+      subscription = Current.account.with_lock { Current.account.subscription_for_checkout }
+      redirect_to subscription.checkout_url(plan,
+        success_url: main_app.account_settings_url, cancel_url: saas.account_billing_url),
+        allow_other_host: true, status: :see_other
+    end
+  rescue Stripe::StripeError => error
+    Rails.error.report(error)
+    redirect_to saas.account_billing_url, alert: "Checkout is unavailable. Please try again.", status: :see_other
+  end
+end
