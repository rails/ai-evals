index 0000000..cd4c523
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,11 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    ::Billing::StripeEvent.process(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..dbf9759
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,72 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active? && subscription.plan_key.present?
+      Plan.find(subscription.plan_key)
+    elsif comped?
+      Plan.find("unlimited")
+    else
+      Plan.free
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def override_usage(attributes)
+    (overridden_limit || build_overridden_limit).update!(attributes)
+  end
+
+  def reset_usage_override
+    overridden_limit&.destroy!
+    reload_overridden_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && cards_remaining.between?(1, 100)
+  end
+
+  def subscription_for_checkout
+    subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create(
+      { name: name, email: owner_email, metadata: { account_id: id } },
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY"), idempotency_key: "account-#{id}" }
+    ).id)
+  end
+end
