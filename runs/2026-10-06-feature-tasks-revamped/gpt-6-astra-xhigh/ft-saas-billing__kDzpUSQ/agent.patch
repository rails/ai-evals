diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..6f4b702
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,56 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+  validates :plan_key, inclusion: { in: -> { Plan.paid.map(&:key) } }, allow_nil: true
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def manageable?
+    stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ])
+  end
+
+  def checkout_url(plan, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create({
+      mode: "subscription", customer: stripe_customer_id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      client_reference_id: account_id,
+      subscription_data: { metadata: { account_id: account_id } },
+      success_url: success_url, cancel_url: cancel_url
+    }, { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create({
+      customer: stripe_customer_id, return_url: return_url
+    }, { api_key: ENV.fetch("STRIPE_SECRET_KEY") }).url
+  end
+
+  def apply_stripe_event(event)
+    object = event.data.object
+    event_time = Time.at(event.created).utc
+
+    with_lock do
+      # Stripe retries and may deliver events out of order. A terminated subscription
+      # must not be resurrected by an update from the same second as its deletion.
+      stale = stripe_event_created_at && event_time < stripe_event_created_at
+      terminated = status == "canceled" && stripe_subscription_id == object.id
+
+      unless stale || terminated
+        item = object.items.data.sole
+        update!(stripe_subscription_id: object.id,
+          plan_key: Plan.for_price_id(item.price.id)&.key,
+          status: event.type == "customer.subscription.deleted" ? "canceled" : object.status,
+          current_period_end: timestamp(object[:current_period_end] || item[:current_period_end]),
+          cancel_at: timestamp(object[:cancel_at]), stripe_event_created_at: event_time)
+      end
+    end
+  end
+
+  private
+    def timestamp(value)
+      Time.at(value).utc if value
+    end
+end
diff --git a/saas/app/models/billing/stripe_event.rb b/saas/app/models/billing/stripe_event.rb
new file mode 100644
index 0000000..fdd391e
--- /dev/null
+++ b/saas/app/models/billing/stripe_event.rb
@@ -0,0 +1,16 @@
+class Billing::StripeEvent < SaasRecord
+  self.table_name = "billing_stripe_events"
+
+  TYPES = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ].freeze
+
+  def self.process(event)
+    if event.type.in?(TYPES)
+      transaction do
+        receipt = create_or_find_by!(stripe_id: event.id)
+        if receipt.previously_new_record?
+          Account::Subscription.find_by(stripe_customer_id: event.data.object.customer)&.apply_stripe_event(event)
+        end
+      end
+    end
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..b5a64d6
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,35 @@
+Plan = Data.define(:key, :name, :price, :card_limit, :storage_limit, :price_variable) do
+  class << self
+    def all
+      @all ||= [
+        new(key: "free", name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte, price_variable: nil),
+        new(key: "unlimited", name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes, price_variable: "STRIPE_MONTHLY_V1_PRICE_ID"),
+        new(key: "unlimited_plus", name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes, price_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+      ].freeze
+    end
+
+    def free
+      all.first
+    end
+
+    def paid
+      all.drop(1)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key } || raise(ActiveRecord::RecordNotFound, "Unknown plan")
+    end
+
+    def for_price_id(price_id)
+      paid.find { |plan| price_id.present? && ENV[plan.price_variable].present? && ENV[plan.price_variable] == price_id }
+    end
+  end
+
+  def stripe_price_id
+    ENV.fetch(price_variable)
+  end
+
+  def free?
+    key == "free"
+  end
+end
