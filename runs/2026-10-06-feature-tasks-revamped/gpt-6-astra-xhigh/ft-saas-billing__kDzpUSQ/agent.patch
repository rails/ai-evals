diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..89776c9
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    integration_session.default_url_options[:script_name] = ""
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_webhook")
+  end
+
+  test "signed subscription changes grant change and remove entitlements without Stripe requests" do
+    deliver event("evt_created", "customer.subscription.created")
+    assert_response :success
+    assert_equal "unlimited", @account.reload.billing_plan.key
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    deliver event("evt_updated", price: "price_unlimited_plus", created: Time.current.to_i + 1)
+    assert_response :success
+    assert_equal "unlimited_plus", @account.reload.billing_plan.key
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    deliver event("evt_deleted", "customer.subscription.deleted", created: Time.current.to_i + 2)
+    assert_response :success
+    assert @account.reload.billing_plan.free?
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal "canceled", @subscription.reload.status
+  end
+
+  test "cancel at period end retains the paid plan until subscription deletion" do
+    payload = event("evt_canceling")
+    payload[:data][:object][:cancel_at] = 1.month.from_now.to_i
+    deliver payload
+    assert_response :success
+    assert_equal "unlimited", @account.reload.billing_plan.key
+    assert @subscription.reload.cancel_at
+  end
+
+  test "duplicate and out of order events cannot roll back the plan" do
+    original = event("evt_original")
+    deliver original
+    deliver event("evt_newer", price: "price_unlimited_plus", created: Time.current.to_i + 10)
+    assert_no_difference -> { ::Billing::StripeEvent.count } do
+      deliver original
+      assert_response :success
+    end
+    deliver event("evt_older", created: Time.current.to_i - 10)
+    assert_response :success
+    assert_equal "unlimited_plus", @account.reload.billing_plan.key
+  end
+
+  test "an update cannot resurrect a deleted subscription" do
+    deliver event("evt_deleted", "customer.subscription.deleted")
+    deliver event("evt_late_update")
+    assert_response :success
+    assert @account.reload.billing_plan.free?
+  end
+
+  test "failed subscription updates roll back the receipt so Stripe can retry" do
+    payload = event("evt_retry")
+    Account::Subscription.any_instance.stubs(:update!).raises(ActiveRecord::Deadlocked)
+    assert_no_difference -> { ::Billing::StripeEvent.count } do
+      assert_raises(ActiveRecord::Deadlocked) { deliver payload }
+    end
+    Account::Subscription.any_instance.unstub(:update!)
+    deliver payload
+    assert_response :success
+    assert_equal "unlimited", @account.reload.billing_plan.key
+  end
+
+  test "a new subscription can replace a canceled subscription" do
+    deliver event("evt_canceled", "customer.subscription.deleted")
+    replacement = event("evt_replacement", "customer.subscription.created", created: Time.current.to_i + 1)
+    replacement[:data][:object][:id] = "sub_replacement"
+    deliver replacement
+    assert_response :success
+    assert_equal "unlimited", @account.reload.billing_plan.key
+    assert_equal "sub_replacement", @subscription.reload.stripe_subscription_id
+  end
+
+  test "unrecognized prices and non-paying statuses do not grant paid entitlements" do
+    deliver event("evt_unknown_price", price: "price_untrusted")
+    assert_response :success
+    assert @account.reload.billing_plan.free?
+    payload = event("evt_unpaid", created: Time.current.to_i + 1)
+    payload[:data][:object][:status] = "unpaid"
+    deliver payload
+    assert_response :success
+    assert @account.reload.billing_plan.free?
+  end
+
+  test "invalid missing and expired signatures and invalid JSON are rejected" do
+    payload = event("evt_unsigned").to_json
+    post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json" }
+    assert_response :bad_request
+    post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=1,v1=bad" }
+    assert_response :bad_request
+    deliver event("evt_expired"), timestamp: 10.minutes.ago.to_i
+    assert_response :bad_request
+    deliver "invalid json"
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "unknown customers and unrelated events cannot affect existing accounts" do
+    payload = event("evt_stranger")
+    payload[:data][:object][:customer] = "cus_other"
+    payload[:data][:object][:metadata] = { account_id: @account.id }
+    deliver payload
+    assert_response :success
+    deliver event("evt_unrelated", "invoice.paid")
+    assert_response :success
+    assert_nil @subscription.reload.status
+    assert_nil accounts(:acme).subscription
+  end
+
+  private
+    def event(id, type = "customer.subscription.updated", price: "price_unlimited", created: Time.current.to_i)
+      { id: id, object: "event", type: type, created: created, data: { object: {
+        id: "sub_webhook", object: "subscription", customer: "cus_webhook", status: "active", cancel_at: nil,
+        items: { object: "list", data: [ { id: "si_test", object: "subscription_item", price: { id: price, object: "price" }, current_period_end: 1.month.from_now.to_i } ] }
+      } } }
+    end
+
+    def deliver(event, timestamp: Time.current.to_i)
+      payload = event.is_a?(String) ? event : event.to_json
+      signature = OpenSSL::HMAC.hexdigest("SHA256", "whsec_local", "#{timestamp}.#{payload}")
+      post "/stripe/webhooks", params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}" }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..e7766f6
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "approved plans" do
+    assert_equal [ "Free", 0, 1_000, 1.gigabyte ], Plan.free.to_h.values_at(:name, :price, :card_limit, :storage_limit)
+    assert_equal [ "Unlimited", 20, nil, 5.gigabytes ], Plan.find("unlimited").to_h.values_at(:name, :price, :card_limit, :storage_limit)
+    assert_equal [ "Unlimited+", 25, nil, 500.gigabytes ], Plan.find("unlimited_plus").to_h.values_at(:name, :price, :card_limit, :storage_limit)
+  end
+
+  test "card limit and warning boundaries" do
+    { 899 => [ false, false, 101 ], 900 => [ true, false, 100 ], 950 => [ true, false, 50 ],
+      999 => [ true, false, 1 ], 1_000 => [ false, true, 0 ], 1_001 => [ false, true, 0 ] }.each do |count, expected|
+      @account.override_usage(card_count: count)
+      assert_equal expected, [ @account.nearing_card_limit?, @account.exceeding_card_limit?, @account.cards_remaining ], "at #{count} cards"
+    end
+  end
+
+  test "drafts and the card number sequence do not consume the free allowance" do
+    @account.update!(cards_count: 5_000)
+    assert_equal @account.cards.published.count, @account.card_count
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "comp and uncomp preserve a paid subscription and usage overrides" do
+    @account.create_subscription!(stripe_customer_id: "cus_test", stripe_subscription_id: "sub_test", status: "active", plan_key: "unlimited_plus")
+    @account.override_usage(card_count: 1_500, bytes_used: 6.gigabytes)
+    @account.comp
+    assert @account.comped?
+    assert_not @account.exceeding_card_limit?
+    assert_equal 500.gigabytes, @account.storage_limit
+    @account.uncomp
+    assert_not @account.comped?
+    assert_equal "unlimited_plus", @account.billing_plan.key
+    @account.subscription.update!(status: "canceled")
+    assert @account.exceeding_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plans retain their storage allowance even with an older smaller exception" do
+    @account.add_storage_exception(2.gigabytes)
+    @account.create_subscription!(stripe_customer_id: "cus_storage", status: "active", plan_key: "unlimited")
+    assert_equal 5.gigabytes, @account.storage_limit
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "partial usage overrides leave the other measured usage unchanged" do
+    measured_card_count = @account.card_count
+    @account.override_usage(bytes_used: 123)
+    assert_equal measured_card_count, @account.card_count
+    assert_equal 123, @account.bytes_used
+    @account.override_usage(bytes_used: nil, card_count: 900)
+    assert_equal 900, @account.card_count
+    assert_equal @account.storage_total&.bytes_stored || 0, @account.bytes_used
+  end
+
+  test "usage overrides can be zero, partial, reset, but never negative" do
+    @account.override_usage(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    assert_raises(ActiveRecord::RecordInvalid) { @account.override_usage(card_count: -1) }
+    @account.reset_usage_override
+    assert_nil @account.reload.overridden_limit
+    assert_equal @account.cards.published.count, @account.card_count
+  end
+end
