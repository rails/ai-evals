new file mode 100644
index 0000000..62dc0c4
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,30 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def index
+    subscription = @user.push_subscriptions.find_by(endpoint: params.expect(:endpoint))
+    render json: { id: subscription&.id }
+  end
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = @user.push_subscriptions.create_or_find_by!(endpoint: attributes[:endpoint]) do |subscription|
+      subscription.assign_attributes(attributes)
+    end
+    subscription.update!(attributes)
+
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.where(id: Current.user.id).find(params[:user_id])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..e56ab2e
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,119 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = ["button", "status", "details", "help"]
+  static values = { url: String, publicKey: String }
+
+  #subscriptionId = null
+  #busy = false
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (this.#busy) return
+
+    this.#busy = true
+    this.statusTarget.textContent = ""
+    this.#render()
+
+    try {
+      this.#subscriptionId = null
+      if (this.#supported && Notification.permission === "granted") {
+        const registration = await navigator.serviceWorker.getRegistration("/")
+        const subscription = await registration?.pushManager.getSubscription()
+
+        if (subscription) {
+          const response = await get(this.urlValue, { query: { endpoint: subscription.endpoint }, responseKind: "json" })
+          if (!response.ok) throw new Error("Could not check subscription")
+          this.#subscriptionId = (await response.json).id
+        }
+      }
+    } catch {
+      this.statusTarget.textContent = "Couldn't check notification settings. Please try again."
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async toggle() {
+    if (this.#busy || !this.#supported) return
+
+    this.#busy = true
+    this.statusTarget.textContent = ""
+    this.#render()
+
+    try {
+      if (this.#subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch {
+      this.statusTarget.textContent = "Couldn't update notifications. Please try again."
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async #enable() {
+    // Request permission before any other asynchronous work to preserve the user gesture on Safari.
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription() || await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (!response.ok) throw new Error("Could not save subscription")
+    this.#subscriptionId = (await response.json).id
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.#subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove subscription")
+
+    // Keep the browser subscription: other accounts on this device may still use it.
+    this.#subscriptionId = null
+  }
+
+  #render() {
+    const enabled = Boolean(this.#subscriptionId)
+    const denied = this.#supported && Notification.permission === "denied"
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.textContent = enabled ? "Turn off for this device" : "Turn on for this device"
+    this.buttonTarget.disabled = this.#busy || !this.#supported || denied
+    this.detailsTargets.forEach(element => element.hidden = this.#supported && Notification.permission === "default")
+
+    if (!this.#supported) {
+      this.statusTarget.textContent = "This browser doesn't support push notifications. See the help below."
+      this.helpTarget.open = true
+    } else if (denied) {
+      this.statusTarget.textContent = "Notifications are blocked. Allow them in your browser settings."
+      this.helpTarget.open = true
+    }
+  }
+
+  get #supported() {
+    return window.isSecureContext && "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_subscription/delivery_job.rb b/app/jobs/push_subscription/delivery_job.rb
