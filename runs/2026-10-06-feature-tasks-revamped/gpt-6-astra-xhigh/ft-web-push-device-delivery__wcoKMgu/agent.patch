index 0000000..0834950
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @subscription = { endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key" }
+    sign_in_as @user
+  end
+
+  test "register a subscription for the current user" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+
+    assert_response :created
+    subscription = @user.push_subscriptions.sole
+    assert_equal @subscription.stringify_keys, subscription.attributes.slice(*@subscription.keys.map(&:to_s))
+    assert_equal @user.account, subscription.account
+  end
+
+  test "registering the same endpoint updates keys without duplicating it" do
+    2.times do |i|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "key-#{i}") }, as: :json
+      assert_response :created
+    end
+
+    assert_equal "key-1", @user.push_subscriptions.sole.auth_key
+  end
+
+  test "cannot register for another user or account" do
+    [ users(:kevin), users(:mike) ].each do |user|
+      post user_push_subscriptions_path(user), params: { push_subscription: @subscription }, as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "cannot override ownership through subscription parameters" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @subscription.merge(user_id: users(:kevin).id, account_id: accounts(:initech).id)
+    }, as: :json
+
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.sole.account
+    assert_empty users(:kevin).push_subscriptions
+  end
+
+  test "reject incomplete subscriptions" do
+    @subscription.keys.each do |key|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(key) }, as: :json
+      assert_response :unprocessable_entity
+    end
+    assert_empty @user.push_subscriptions
+  end
+
+  test "cannot remove another user's subscription through one's own URL" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription)
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@user, subscription), as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "look up and remove only this user's device" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    subscription = @user.push_subscriptions.sole
+
+    get user_push_subscriptions_path(@user), params: { endpoint: subscription.endpoint }, as: :json
+    assert_equal subscription.id, response.parsed_body.fetch("id")
+
+    delete user_push_subscription_path(users(:kevin), subscription), as: :json
+    assert_response :not_found
+    assert subscription.reload
+
+    delete user_push_subscription_path(@user, subscription), as: :json
+    assert_response :no_content
+    assert_empty @user.push_subscriptions
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..91763d9
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "public", auth_key: "auth")
+  end
+
+  test "new tray entries enqueue a push for every subscribed device" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/desktop", p256dh_key: "public", auth_key: "auth")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing tray entry also pushes" do
+    assert_enqueued_jobs 1, only: PushSubscription::DeliveryJob do
+      Notifier.for(events(:logo_published)).notify
+    end
+  end
+
+  test "reading, marking unread and touching do not push" do
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notification = notifications(:logo_assignment_kevin)
+      notification.read
+      notification.unread
+      notification.touch
+    end
+  end
+
+  test "event pushes say what the tray says and link to the account's card" do
+    notification = notifications(:layout_commented_kevin)
+    WebPush.expects(:payload_send).with do |options|
+      payload = JSON.parse(options[:message])
+      assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+      assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+      assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}#comment_#{notification.source.eventable.id}", payload.dig("data", "url")
+      assert_equal "notification_#{notification.id}", payload["tag"]
+      assert_equal @subscription.endpoint, options[:endpoint]
+      true
+    end
+
+    perform_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notification.push_later
+    end
+  end
+
+  test "mention pushes reuse the tray's mention text" do
+    notification = notifications(:logo_mentioned_david)
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/david", p256dh_key: "public", auth_key: "auth")
+    mention = notification.source
+
+    WebPush.expects(:payload_send).with do |options|
+      payload = JSON.parse(options[:message])
+      assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+      assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+      assert_includes payload.dig("data", "url"), "#{notification.account.slug}/cards/#{notification.card.to_param}"
+      true
+    end
+
+    perform_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notification.push_later
+    end
+  end
+
+  test "queued pushes retain the text of the event that enqueued them" do
+    notification = notifications(:logo_assignment_kevin)
+    expected_body = ApplicationController.helpers.event_notification_body(notification.source)
+    notification.push_later
+    notification.update_columns(source_id: events(:logo_published).id)
+
+    WebPush.expects(:payload_send).with do |options|
+      JSON.parse(options[:message])["body"] == expected_body
+    end
+    perform_enqueued_jobs only: PushSubscription::DeliveryJob
+  end
+
+  test "no push jobs when unconfigured or unsubscribed" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription.destroy!
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..4d7fe15
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public", auth_key: "auth")
+    PushSubscription.stubs(:vapid).returns(public_key: "vapid-public", private_key: "vapid-private", subject: "mailto:support@example.com")
+    @payload = { title: "A card", body: "Added by David", data: { url: "/123/cards/1" } }
+  end
+
+  test "sends with the subscription keys and configured VAPID pair" do
+    WebPush.expects(:payload_send).with(
+      endpoint: @subscription.endpoint, p256dh: "public", auth: "auth", message: @payload.to_json,
+      vapid: PushSubscription.vapid, open_timeout: 5, read_timeout: 5
+    )
+    @subscription.deliver(@payload)
+  end
+
+  test "encrypts the payload and signs the request with VAPID" do
+    vapid = WebPush.generate_key
+    PushSubscription.stubs(:vapid).returns(public_key: vapid.public_key, private_key: vapid.private_key, subject: "mailto:support@example.com")
+    @subscription.update!(p256dh_key: WebPush.generate_key.public_key, auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)))
+    request = stub_request(:post, @subscription.endpoint).with do |request|
+      assert_equal "aes128gcm", request.headers["Content-Encoding"]
+      assert_not_includes request.body, @payload.to_json
+      token = request.headers.fetch("Authorization")[/t=([^,]+)/, 1]
+      claims, = JWT.decode(token, vapid.curve, true, algorithms: [ "ES256" ])
+      assert_equal "https://push.example.com", claims["aud"]
+      assert_equal "mailto:support@example.com", claims["sub"]
+      true
+    end.to_return(status: 201)
+
+    @subscription.deliver(@payload)
+    assert_requested request
+  end
+
+  test "invalid and expired subscriptions are removed" do
+    [ WebPush::InvalidSubscription, WebPush::ExpiredSubscription ].each do |error|
+      subscription = PushSubscription.new(@subscription.attributes.except("id", "created_at", "updated_at"))
+      subscription.endpoint += "/#{error.name.demodulize}"
+      subscription.save!
+      WebPush.expects(:payload_send).raises(error.new(stub(body: "Gone"), "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.deliver(@payload)
+      end
+    end
+  end
+
+  test "transient failures retain subscriptions and are retried" do
+    WebPush.expects(:payload_send).raises(WebPush::PushServiceError.new(stub(body: "Unavailable"), "push.example.com"))
+
+    assert_enqueued_jobs 1, only: PushSubscription::DeliveryJob do
+      PushSubscription::DeliveryJob.perform_now(@subscription, @payload)
+    end
+    assert @subscription.reload
+  end
+
+  test "deleted devices are discarded by delivery jobs" do
+    PushSubscription::DeliveryJob.perform_later(@subscription, @payload)
+    @subscription.destroy!
+    WebPush.expects(:payload_send).never
+    perform_enqueued_jobs only: PushSubscription::DeliveryJob
+  end
+
+  test "deactivating a user removes their devices" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.user.deactivate
+    end
+  end
+
+  test "does not send without keys or to inactive users" do
+    WebPush.expects(:payload_send).never
+    PushSubscription.stubs(:vapid).returns(public_key: nil, private_key: nil)
+    assert_not PushSubscription.configured?
+    @subscription.deliver(@payload)
+
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription.user.update!(active: false)
+    @subscription.deliver(@payload)
+  end
+
+  test "endpoints must use HTTPS" do
+    @subscription.endpoint = "http://push.example.com/device"
+    assert_not @subscription.valid?
+  end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..81b6293
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,170 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    page.driver.options[:options].add_argument("--no-sandbox") if Process.uid.zero?
+    PushSubscription.stubs(:vapid).returns(public_key: WebPush.generate_key.public_key, private_key: "private")
+    sign_in_as users(:david)
+    visit notifications_settings_path
+    assert_selector "[data-controller=notifications]"
+    mock_push_apis
+  end
+
+  test "opt in and out on this device" do
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_empty users(:david).push_subscriptions
+
+    click_on "Turn on for this device"
+    assert_selector ".notifications--on"
+    subscription = users(:david).push_subscriptions.sole
+    assert_equal "https://push.example.com/browser", subscription.endpoint
+    assert_equal "browser-public", subscription.p256dh_key
+    assert_equal "browser-auth", subscription.auth_key
+    assert page.evaluate_script("pushTest.subscribeOptions.userVisibleOnly")
+    assert page.evaluate_script("pushTest.subscribeOptions.applicationServerKey instanceof Uint8Array")
+
+    refresh_settings
+    assert_selector ".notifications--on"
+    click_on "Turn off for this device"
+    assert_no_selector ".notifications--on"
+    assert_empty users(:david).push_subscriptions
+    assert page.evaluate_script("Boolean(pushTest.subscription)"), "Other accounts may still use the browser subscription"
+
+    click_on "Turn on for this device"
+    assert_selector ".notifications--on"
+    assert_equal 1, users(:david).push_subscriptions.count
+  end
+
+  test "denied and dismissed permission do not register a device" do
+    page.execute_script("pushTest.permission = 'default'")
+    click_on "Turn on for this device"
+    assert_button "Turn on for this device", disabled: false
+    assert_empty users(:david).push_subscriptions
+
+    page.execute_script("pushTest.permission = 'denied'")
+    click_on "Turn on for this device"
+    assert_text "Notifications are blocked"
+    assert_selector "details[open]"
+    assert_button "Turn on for this device", disabled: true
+    assert_empty users(:david).push_subscriptions
+  end
+
+  test "unsupported browsers get help without errors" do
+    page.execute_script("delete window.PushManager")
+    refresh_settings
+
+    assert_text "This browser doesn't support push notifications"
+    assert_selector "details[open]"
+    assert_button "Turn on for this device", disabled: true
+  end
+
+  test "a browser subscription alone does not opt this account in" do
+    page.execute_script("Notification.permission = 'granted'; pushTest.subscription = pushTest.browserSubscription")
+    refresh_settings
+
+    assert_no_selector ".notifications--on"
+    assert_equal 0, page.evaluate_script("pushTest.permissionRequests")
+    assert_empty users(:david).push_subscriptions
+  end
+
+  test "failed registration is not shown as enabled and can be retried" do
+    page.execute_script("delete pushTest.keys.auth")
+    click_on "Turn on for this device"
+    assert_text "Couldn't update notifications"
+    assert_no_selector ".notifications--on"
+    assert_empty users(:david).push_subscriptions
+
+    page.execute_script("pushTest.keys.auth = 'browser-auth'")
+    click_on "Turn on for this device"
+    assert_selector ".notifications--on"
+    assert_equal 1, users(:david).push_subscriptions.count
+  end
+
+  test "service worker displays pushes and opens or focuses their cards" do
+    mock_service_worker
+    assert page.evaluate_async_script(<<~JS)
+      const done = arguments[arguments.length - 1]
+      pushWorker.handlers.install({ waitUntil: promise => promise.then(() => done(pushWorker.activated)) })
+    JS
+    payload = { title: "A card", body: "Added by David", data: { url: "#{accounts("37s").slug}/cards/123" }, tag: "notification_123" }
+    displayed = page.evaluate_async_script(<<~JS, payload)
+      const done = arguments[arguments.length - 1]
+      pushWorker.handlers.push({ data: { json: () => arguments[0] }, waitUntil: promise => promise.then(() => done(pushWorker.displayed)) })
+    JS
+    assert_equal payload[:title], displayed[0]
+    assert_equal payload[:body], displayed[1]["body"]
+    assert_equal payload[:data].stringify_keys, displayed[1]["data"]
+
+    result = click_notification(payload[:data][:url])
+    assert result["closed"]
+    assert_equal "https://fizzy.example#{payload[:data][:url]}", result["opened"]
+
+    page.execute_script("pushWorker.windows = [{ url: pushWorker.opened, focus: async () => pushWorker.focused = true }]; pushWorker.opened = null")
+    result = click_notification(payload[:data][:url])
+    assert result["focused"]
+    assert_nil result["opened"]
+
+    result = click_notification("https://untrusted.example/card")
+    assert_nil result["opened"]
+  end
+
+  private
+    def mock_push_apis
+      page.execute_script <<~JS
+        window.pushTest = { permissionRequests: 0, permission: "granted", keys: { p256dh: "browser-public", auth: "browser-auth" } }
+        pushTest.browserSubscription = { endpoint: "https://push.example.com/browser", toJSON: () => ({ endpoint: "https://push.example.com/browser", keys: pushTest.keys }) }
+        Object.defineProperty(window, "Notification", { configurable: true, value: {
+          permission: "default",
+          requestPermission: async () => { pushTest.permissionRequests++; Notification.permission = pushTest.permission; return pushTest.permission }
+        } })
+        Object.defineProperty(window, "PushManager", { configurable: true, value: class {} })
+        const registration = { pushManager: {
+          getSubscription: async () => pushTest.subscription,
+          subscribe: async options => { pushTest.subscribeOptions = options; pushTest.subscription = pushTest.browserSubscription; return pushTest.subscription }
+        } }
+        Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+          getRegistration: async () => registration,
+          register: async () => registration,
+          ready: Promise.resolve(registration)
+        } })
+      JS
+      refresh_settings
+    end
+
+    def refresh_settings
+      page.evaluate_async_script <<~JS
+        const done = arguments[arguments.length - 1]
+        const element = document.querySelector('[data-controller="notifications"]')
+        Stimulus.getControllerForElementAndIdentifier(element, "notifications").refresh().then(done)
+      JS
+    end
+
+    def mock_service_worker
+      script = ApplicationController.render(template: "pwa/service_worker", formats: [ :js ], layout: false)
+      page.execute_script <<~JS
+        window.pushWorker = { handlers: {}, windows: [] }
+        const worker = {
+          location: { origin: "https://fizzy.example" },
+          skipWaiting: async () => pushWorker.activated = true,
+          addEventListener: (name, handler) => pushWorker.handlers[name] = handler,
+          registration: { showNotification: async (...args) => pushWorker.displayed = args },
+          clients: {
+            matchAll: async () => pushWorker.windows,
+            openWindow: async url => pushWorker.opened = url
+          }
+        }
+        const offline = { addRule: () => {}, start: () => {}, handlers: { networkFirst: () => {}, cacheFirst: () => {} } }
+        ;(function(self, importScripts, TurboOffline) { #{script} })(worker, () => {}, offline)
+      JS
+    end
+
+    def click_notification(url)
+      page.evaluate_async_script(<<~JS, url)
+        const done = arguments[arguments.length - 1]
+        pushWorker.handlers.notificationclick({
+          notification: { data: { url: arguments[0] }, close: () => pushWorker.closed = true },
+          waitUntil: promise => promise.then(() => done({ closed: pushWorker.closed, opened: pushWorker.opened, focused: pushWorker.focused }))
+        })
+      JS
+    end
+end
