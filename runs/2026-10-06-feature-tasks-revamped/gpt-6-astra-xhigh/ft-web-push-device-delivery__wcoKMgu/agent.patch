new file mode 100644
index 0000000..631186f
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,23 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if !read? && user.active? && PushSubscription.configured? && user.push_subscriptions.exists?
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        PushSubscription::DeliveryJob.perform_later(subscription, payload)
+      end
+    end
+  end
+
+  private
+    def push_payload
+      JSON.parse(ApplicationController.render(
+        partial: "notifications/push", formats: [ :json ], locals: { notification: self }
+      ))
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..4e24dd0
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,28 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 512 }, format: { with: /\Ahttps:\/\/[^\s]+\z/ }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+
+  def self.configured?
+    vapid.values_at(:public_key, :private_key).all?(&:present?)
+  end
+
+  def self.vapid
+    Rails.application.config.x.web_push
+  end
+
+  def deliver(payload)
+    if self.class.configured? && user.active?
+      WebPush.payload_send(
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key,
+        message: payload.to_json, vapid: self.class.vapid,
+        open_timeout: 5, read_timeout: 5
+      )
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+end
