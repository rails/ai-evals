@@ -0,0 +1,55 @@
+# Activities
+
+Account activity records changes to cards and comments across boards the current user can access.
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of events, newest first. Results use the API's [standard pagination](../README.md#pagination); follow the `Link` header's `rel="next"` URL for subsequent pages.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of strings | Only events created by any of these users |
+| `board_ids[]` | array of strings | Only events on any of these boards |
+
+When both filters are supplied, events must match both. Filters never grant access to otherwise inaccessible boards or other accounts.
+
+```bash
+curl -H "Authorization: Bearer put-your-access-token-here" \
+  "http://app.fizzy.localhost:3006/897362094/activities.json?creator_ids[]=03f5v9zjw7pz8717a4no1h8a7&board_ids[]=03f5v9zo9qlcwwpyc0ascnikz"
+```
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event type (listed below) |
+| `created_at` | Event timestamp in UTC |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details (listed below) |
+| `url` | Opens the card; for comments, opens the card and jumps to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation |
+
+### Actions and particulars
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned` | `{ "assignee_ids": ["user_id"] }` |
+| `card_unassigned` | `{ "assignee_ids": ["user_id"] }` |
+| `card_published` | `{}` |
+| `card_closed` | `{}` |
+| `card_reopened` | `{}` |
+| `card_board_changed` | `{ "old_board": "Old board name", "new_board": "New board name" }` |
+| `card_title_changed` | `{ "old_title": "Old title", "new_title": "New title" }` |
+| `card_postponed` | `{}` |
+| `card_auto_postponed` | `{}` |
+| `card_triaged` | `{ "column": "Column name" }` |
+| `card_sent_back_to_triage` | `{}` |
+| `comment_created` | `{}` |
+
+Missing board names, titles, and column names in `particulars` are returned as empty strings. Deprecated `card_collection_changed` events are not returned.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..aacad92
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,270 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_includes response.parsed_body.pluck("id"), events(:layout_commented).id
+    assert_equal response.parsed_body.pluck("created_at").sort.reverse, response.parsed_body.pluck("created_at")
+  end
+
+  test "card activity includes the existing API representations" do
+    event = events(:logo_published)
+    activity = activity_for(event)
+
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_no_match(/<[^>]+>/, activity["description"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.eventable, format: :json)
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage
+    ]
+    included_events = actions.map { |action| create_event(action) }
+    excluded_events = %w[ card_collection_changed card_resumed card_unknown ].map { |action| create_event(action) }
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_empty included_events.map(&:id) - response.parsed_body.pluck("id")
+    assert_empty excluded_events.map(&:id) & response.parsed_body.pluck("id")
+  end
+
+  test "assignment and unassignment particulars contain assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    %w[ card_assigned card_unassigned ].each do |action|
+      event.update_columns(action: action)
+      assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "descriptions use the current user" do
+    event = events(:logo_assignment_jz)
+    kevins_description = activity_for(event)["description"]
+
+    logout_and_sign_in_as :jz
+    jzs_description = activity_for(event)["description"]
+
+    assert_equal event.description_for(users(:jz)).to_plain_text, jzs_description
+    assert_not_equal kevins_description, jzs_description
+  end
+
+  test "board change particulars contain board names" do
+    event = create_event("card_board_changed", particulars: { particulars: { old_board: "Old board", new_board: "New board", internal: "ignored" } })
+
+    assert_equal({ "old_board" => "Old board", "new_board" => "New board" }, activity_for(event)["particulars"])
+  end
+
+  test "title change particulars contain titles" do
+    event = create_event("card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, activity_for(event)["particulars"])
+  end
+
+  test "triage particulars contain the column name" do
+    event = create_event("card_triaged", particulars: { particulars: { column: "In progress" } })
+
+    assert_equal({ "column" => "In progress" }, activity_for(event)["particulars"])
+  end
+
+  test "missing board title and column particulars are empty strings" do
+    {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }.each do |action, keys|
+      event = create_event(action)
+      expected = keys.index_with { "" }
+      assert_equal expected, activity_for(event)["particulars"]
+
+      event.update!(particulars: { particulars: keys.index_with { nil } })
+      assert_equal expected, activity_for(event)["particulars"]
+    end
+  end
+
+  test "other actions do not expose stored particulars" do
+    event = create_event("card_published", particulars: { internal: "ignored", particulars: { column: "ignored" } })
+
+    assert_equal({}, activity_for(event)["particulars"])
+    assert_equal({}, activity_for(events(:buy_domain_sent_back_to_triage))["particulars"])
+  end
+
+  test "filters by one or more creators" do
+    jz_event = create_event("card_published", creator: users(:jz))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ users(:kevin).id ], response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id, users(:jz).id ] }
+    assert_response :success
+    assert_equal [ users(:kevin).id, users(:jz).id ].sort, response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq.sort
+    assert_includes response.parsed_body.pluck("id"), jz_event.id
+  end
+
+  test "filters by boards and combines board and creator filters" do
+    with_current_user(:kevin) { cards(:logo).move_to(boards(:private)) }
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ boards(:private).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ], creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ boards(:private).id, boards(:writebook).id ].sort, response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq.sort
+    assert_equal [ users(:kevin).id ], response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq
+  end
+
+  test "excludes inaccessible boards even when explicitly requested" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_published).id
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_commented).id
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "excludes activity from other accounts" do
+    other_event = create_event("card_published", card: cards(:radio), creator: users(:mike))
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), other_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:miltons_wish_list).id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:mike).id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "users without board access have an empty feed" do
+    users(:kevin).accesses.destroy_all
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_equal [], response.parsed_body
+    assert_nil response.headers["Link"]
+  end
+
+  test "unknown filters and out of range pages return empty arrays" do
+    [ { creator_ids: [ "unknown" ] }, { board_ids: [ "unknown" ] }, { page: 999 } ].each do |params|
+      get activities_path(format: :json), params: params
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+  end
+
+  test "paginates newest first with stable ordering and preserves filters in links" do
+    created_at = 2.days.ago.change(usec: 0)
+    created_events = 40.times.map do |index|
+      create_event("card_published", creator: users(:jz), created_at: created_at + (index / 2).minutes)
+    end
+    expected_ids = created_events.sort_by { |event| [ event.created_at, event.id ] }.reverse.map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      next_page = next_page_from_link_header(response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "allows read only access tokens" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(permission: :read)
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  test "rejects invalid tokens and users outside the account" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+    assert_response :unauthorized
+
+    token = identities(:mike).access_tokens.create!(permission: :read)
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+    assert_response :forbidden
+  end
+
+  private
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+      response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity, "Expected activity for event #{event.id}"
+      end
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+
+    def create_event(action, card: cards(:logo), creator: users(:kevin), **attributes)
+      card.events.create!(action: action, board: card.board, creator: creator, **attributes)
+    end
+end
