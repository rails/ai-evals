diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..22cb668
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,371 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "a card moves immediately and stays put when the save finishes" do
+    visit board_url(@board)
+    expand_column(@column)
+    hold_moves
+
+    drag_card(@card, dom_id(@column))
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}"
+    assert_no_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_nil @card.reload.column
+
+    release_moves
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])"
+    assert_equal @column, @card.reload.column
+    assert_equal @card.id, column_card_ids(dom_id(@column)).first
+
+    page.refresh
+    assert_equal @card.id, column_card_ids(dom_id(@column)).first
+  end
+
+  test "active columns keep golden cards ahead of newly moved ordinary cards" do
+    Current.user = users(:david)
+    golden = cards(:text)
+    golden.gild
+    ordinary = cards(:layout)
+    ordinary.triage_into(@column)
+
+    visit board_url(@board)
+    expand_column(@column)
+    hold_moves
+    drag_card(@card, dom_id(@column))
+
+    expected = [ golden.id, @card.id, ordinary.id ]
+    assert_equal expected, column_card_ids(dom_id(@column))
+    assert_equal "3", column_count(dom_id(@column))
+    assert_equal "0", column_count("maybe")
+    assert_selector "#maybe .blank-slate--drag", text: "Drag cards here"
+
+    release_moves
+    assert_saved(@card)
+    assert_equal expected, column_card_ids(dom_id(@column))
+    page.refresh
+    assert_equal expected, column_card_ids(dom_id(@column))
+  end
+
+  test "a golden card moves to the front of its priority group" do
+    Current.user = users(:david)
+    @card.gild
+    cards(:text).gild
+    cards(:layout).triage_into(@column)
+
+    visit board_url(@board)
+    expand_column(@column)
+    hold_moves
+    drag_card(@card, dom_id(@column))
+
+    expected = [ @card.id, cards(:text).id, cards(:layout).id ]
+    assert_equal expected, column_card_ids(dom_id(@column))
+    release_moves
+    assert_saved(@card)
+    page.refresh
+    assert_equal expected, column_card_ids(dom_id(@column))
+  end
+
+  test "cards can move through not now, done, a custom column, and maybe" do
+    visit board_url(@board)
+    hold_moves
+
+    [ [ "not-now", :postponed? ], [ "closed-cards", :closed? ], [ dom_id(@column), :triaged? ], [ "maybe", :awaiting_triage? ] ].each do |column_id, predicate|
+      drag_card(@card, column_id)
+      assert_selector "##{column_id} ##{dom_id(@card, :article)}", visible: :all
+      assert_equal @card.id, column_card_ids(column_id).first
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+
+      release_moves
+      assert_saved(@card)
+      assert_predicate @card.reload, predicate
+      expand_column(column_id) unless column_id == "maybe"
+    end
+
+    assert_selector "#maybe .card--active##{dom_id(@card, :article)}"
+    assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+  end
+
+  test "not now ignores golden priority and done sorts by closure time" do
+    Current.user = users(:david)
+    cards(:text).gild
+    cards(:text).postpone
+    cards(:layout).close
+    cards(:shipping).gild
+
+    visit board_url(@board)
+    hold_moves
+    drag_card(@card, "not-now")
+    assert_equal [ @card.id, cards(:text).id ], column_card_ids("not-now")
+    release_moves
+    assert_saved(@card)
+    expand_column("not-now")
+
+    drag_card(@card, "closed-cards")
+    assert_equal @card.id, column_card_ids("closed-cards").first
+    expected = column_card_ids("closed-cards")
+    release_moves
+    assert_saved(@card)
+    page.refresh
+    assert_equal expected, column_card_ids("closed-cards")
+  end
+
+  test "dropping into an empty column updates its count and placeholder immediately" do
+    empty = columns(:writebook_on_hold)
+    visit board_url(@board)
+    expand_column(empty)
+    hold_moves
+    assert_selector "##{dom_id(empty)} .blank-slate--drag"
+
+    drag_card(@card, dom_id(empty))
+
+    assert_equal [ @card.id ], column_card_ids(dom_id(empty))
+    assert_equal "1", column_count(dom_id(empty))
+    assert_equal "0", column_count("maybe")
+    assert_no_selector "##{dom_id(empty)} .blank-slate--drag"
+    assert_selector "#maybe .blank-slate--drag"
+    release_moves
+    assert_saved(@card)
+    page.refresh
+    assert_equal [ @card.id ], column_card_ids(dom_id(empty))
+  end
+
+  test "same-column drops and cancelled drags never save or reorder" do
+    visit board_url(@board)
+    expand_column(@column)
+    hold_moves
+    original_order = column_card_ids(dom_id(@column))
+
+    drag_card(cards(:text), dom_id(@column))
+
