+  test "quick moves update immediately but save in drop order" do
+    second_card = cards(:logo)
+    visit board_url(@board)
+    expand_column(@column)
+    hold_moves
+    drag_card(@card, dom_id(@column))
+    expand_column(second_card.column)
+    drag_card(second_card, dom_id(@column))
+
+    expected = [ second_card.id, @card.id, cards(:text).id ]
+    assert_equal expected, column_card_ids(dom_id(@column))
+    assert_equal 1, page.evaluate_script("window.heldMoves.length")
+    assert_nil @card.reload.column
+    assert_not_equal @column, second_card.reload.column
+
+    release_moves
+    assert_saved(@card)
+    assert_selector "##{dom_id(second_card, :article)}[aria-busy]", visible: :all
+    assert_equal 1, page.evaluate_script("window.heldMoves.length")
+    release_moves
+    assert_saved(second_card)
+
+    assert_equal expected, column_card_ids(dom_id(@column))
+    assert_equal expected, @column.cards.active.latest.with_golden_first.pluck(:id)
+  end
+
+  private
+    def expand_column(column)
+      column_id = column.is_a?(String) ? column : dom_id(column)
+      find("##{column_id} .cards__expander").click
+      assert_selector "##{column_id}.is-expanded"
+      assert_selector "##{column_id} .cards__list", visible: :all
+    end
+
+    def hold_moves
+      page.execute_script <<~JS
+        const originalFetch = window.fetch
+        window.heldMoves = []
+        window.fetch = (...args) => {
+          if (/(triage|closure|not_now)$/.test(args[0].toString()) && args[1]?.method !== "GET") {
+            return new Promise((resolve, reject) => {
+              window.heldMoves.push(() => originalFetch(...args).then(resolve, reject))
+              window.failMove = response => { window.heldMoves.pop(); resolve(response) }
+              window.rejectMove = error => { window.heldMoves.pop(); reject(error) }
+            })
+          }
+          return originalFetch(...args)
+        }
+      JS
+    end
+
+    def release_moves
+      page.execute_script "window.heldMoves.splice(0).forEach(release => release())"
+    end
+
+    def assert_saved(card)
+      assert_selector "##{dom_id(card, :article)}:not([aria-busy])", visible: :all
+    end
+
+    def column_count(column_id)
+      find("##{column_id} .cards__expander-count", visible: :all)["data-count"]
+    end
+
+    def dispatch_drag(type, target)
+      id = target.is_a?(String) ? target : dom_id(target, :article)
+      page.execute_script <<~JS, type, id
+        window.dragData ||= new DataTransfer()
+        document.getElementById(arguments[1]).dispatchEvent(new DragEvent(arguments[0], {
+          bubbles: true, cancelable: true, dataTransfer: window.dragData
+        }))
+      JS
+    end
+
+    def drag_card(card, column_id)
+      find("##{dom_id(card, :article)}").drag_to(find("##{column_id} .cards__header"))
+    end
+
+    def column_card_ids(column_id)
+      all("##{column_id} [data-drag-and-drop-target~=item]", visible: :all).map { |card| card[:id].delete_prefix("article_card_") }
+    end
+end
