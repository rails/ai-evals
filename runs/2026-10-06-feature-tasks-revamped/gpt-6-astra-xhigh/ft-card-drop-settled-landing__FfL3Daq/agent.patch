diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..6dcb276
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,219 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = { defaultColor: String }
+
+  #draggedItem
+  #source
+  #draggedItemForClick
+  #pending = new Set()
+  #saveQueue = Promise.resolve()
+
+  disconnect() {
+    this.end()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  start(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!item || this.#pending.has(item) || event.target.closest("input, textarea, button, [contenteditable], dialog")) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    this.#draggedItemForClick = item
+    this.#source = this.#containerFor(item)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const container = this.#dropContainer(event.target)
+    this.#highlight(container === this.#source ? null : container)
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    const container = this.#containerFor(event.target)
+    if (!container?.contains(event.relatedTarget)) {
+      container?.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    const container = this.#dropContainer(event.target)
+    if (container) {
+      event.preventDefault()
+      const item = this.#draggedItem
+      const source = this.#source
+      this.end()
+      if (container !== source) {
+        this.#move(item, source, container)
+      }
+    } else {
+      this.end()
+    }
+  }
+
+  end() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.#draggedItem = null
+    this.#source = null
+  }
+
+  allowClick() {
+    this.#draggedItemForClick = null
+  }
+
+  preventClick(event) {
+    if (event.detail > 0 && this.#draggedItemForClick?.contains(event.target)) {
+      event.preventDefault()
+      event.stopPropagation()
+    }
+  }
+
+  preventMorph(event) {
+    if (event.target === this.element && (this.#draggedItem || this.#pending.size)) {
+      event.preventDefault()
+    }
+  }
+
+  #containerFor(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #dropContainer(element) {
+    const container = this.#containerFor(element)
+    if (this.#draggedItem && container?.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(target => target.classList.toggle(this.hoverContainerClass, target === container))
+  }
+
+  async #move(item, source, destination) {
+    const original = item.cloneNode(true)
+    const position = document.createComment("card position")
+    item.before(position)
+
+    this.#pending.add(item)
+    item.setAttribute("aria-busy", "true")
+    this.#insert(item, destination)
+    this.#updateCard(item, destination)
+    this.#changeCount(source, -1)
+    this.#changeCount(destination, 1)
+
+    try {
+      const response = await this.#save(this.#request(item, destination))
+      if (!response.ok) throw new Error("Unable to move card")
+    } catch (error) {
+      item.remove()
+      position.replaceWith(original)
+      this.#changeCount(source, 1)
+      this.#changeCount(destination, -1)
+      if (this.element.isConnected) {
+        window.alert("This card couldn’t be moved. Please try again.")
+      }
+    } finally {
+      position.remove()
+      item.removeAttribute("aria-busy")
+      this.#pending.delete(item)
+    }
+  }
+
+  #insert(item, destination) {
+    const list = destination.querySelector(".cards__list")
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+    const goldenFirst = [ "column", "maybe" ].includes(destination.dataset.dragAndDropStatus)
+    const next = goldenFirst && !item.classList.contains("golden-effect") ?
+      cards.find(card => !card.classList.contains("golden-effect")) : cards[0]
+
+    // Moves record new activity, so put the card first in its priority group.
+    // Insert within pagination frames, not outside their card list.
+    if (next) {
+      next.before(item)
+    } else if (cards.length) {
+      cards.at(-1).after(item)
+    } else {
+      const contents = list.querySelector("turbo-frame") || list
+      contents.prepend(item)
+    }
+  }
+
+  #updateCard(item, destination) {
+    const status = destination.dataset.dragAndDropStatus
+    const active = [ "column", "maybe" ].includes(status)
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not-now")
+    item.removeAttribute("aria-selected")
+    item.dataset.action = active ? "mouseenter->navigable-list#hoverSelect" : ""
+    item.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+
+    if (status !== "closed") {
+      item.style.setProperty("--card-color", destination.dataset.columnColor || this.defaultColorValue)
+      item.dataset.cardColumnId = destination.dataset.columnId || ""
+    }
+
+    const updatedAt = item.querySelector(".card__meta-text--updated time")
+    if (updatedAt) {
+      updatedAt.setAttribute("datetime", Math.floor(Date.now() / 1000))
+      updatedAt.dispatchEvent(new Event("turbo:morph-element", { bubbles: true }))
+    }
+
+    const columnName = item.querySelector(".card__header .card__column-name")
+    if (columnName) {
+      columnName.hidden = status !== "column"
+      columnName.querySelector("span").textContent = destination.dataset.columnName
+    }
+
+    item.querySelectorAll(".card__stages .card__column-name").forEach(column => {
+      column.classList.toggle("card__column-name--current", column.dataset.columnId === item.dataset.cardColumnId)
+    })
+  }
+
+  #changeCount(container, change) {
+    const counter = container.querySelector(".cards__expander-count")
+    const count = Number(counter.dataset.count) + change
+    counter.dataset.count = count
+    counter.textContent = count > 99 ? "99+" : count
+    const loadedCount = container.querySelectorAll('[data-drag-and-drop-target~="item"]').length
+    counter.closest(".cards__expander").style.setProperty("--card-count", Math.min(loadedCount, 15))
+  }
+
+  #save(request) {
+    // Activity determines card order. Save in drop order even on a slow connection.
+    const response = this.#saveQueue.then(() => request.perform())
+    this.#saveQueue = response.catch(() => {})
+    return response
+  }
+
+  #request(item, destination) {
+    // JSON avoids a response-driven redraw; request.js also suppresses our own Turbo refreshes.
+    const options = { responseKind: "json" }
+    switch (destination.dataset.dragAndDropStatus) {
+      case "column":
+        options.body = { column_id: destination.dataset.columnId }
+        return new FetchRequest("post", item.dataset.cardTriageUrl, options)
+      case "maybe":
+        return new FetchRequest("delete", item.dataset.cardTriageUrl, options)
+      case "not-now":
+        return new FetchRequest("post", item.dataset.cardNotNowUrl, options)
+      case "closed":
+        return new FetchRequest("post", item.dataset.cardClosureUrl, options)
+    }
+  }
+}
