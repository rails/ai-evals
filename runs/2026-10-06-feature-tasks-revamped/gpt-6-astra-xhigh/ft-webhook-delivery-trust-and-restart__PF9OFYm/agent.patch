diff --git a/test/jobs/webhook/deliver_job_test.rb b/test/jobs/webhook/deliver_job_test.rb
new file mode 100644
index 0000000..47f3144
--- /dev/null
+++ b/test/jobs/webhook/deliver_job_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Webhook::DeliverJobTest < ActiveSupport::TestCase
+  test "a board event is posted and logged only once, even when the job is repeated" do
+    webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+    receiver = stub_request(:post, webhook.url).with do |request|
+      payload = JSON.parse(request.body)
+      payload["action"] == "card_closed" &&
+        payload.dig("board", "id") == webhook.board_id &&
+        request.headers["X-Webhook-Signature"] == OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request.body)
+    end.to_return(status: 204)
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      event = cards(:logo).events.create!(action: "card_closed", board: webhook.board, creator: users(:david))
+      @delivery = event.webhook_deliveries.sole
+    end
+
+    perform_enqueued_jobs(only: Webhook::DeliverJob)
+    Webhook::DeliverJob.perform_now(@delivery.reload)
+
+    assert_requested receiver, times: 1
+    assert @delivery.reload.succeeded?
+    assert_equal 204, @delivery.response_summary[:code]
+    assert_equal @delivery.id, @delivery.sanitized_request[:headers]["X-Webhook-Delivery"]
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+  end
+  test "enqueuing uses the delivery account rather than ambient context" do
+    delivery = webhook_deliveries(:pending)
+    clear_enqueued_jobs
+
+    Current.without_account do
+      delivery.deliver_later
+      assert_nil Current.account
+    end
+
+    job = enqueued_jobs.sole
+    assert_equal delivery.account.to_gid.to_s, job["account"].to_s
+    assert_equal "webhooks", job["queue_name"]
+  end
+
+  test "a job whose delivery was cleaned up is discarded" do
+    delivery = webhook_deliveries(:pending)
+    job = Webhook::DeliverJob.perform_later(delivery)
+    delivery.destroy!
+
+    assert_nothing_raised { ActiveJob::Base.execute(job.serialize) }
+    assert_not_requested :post, webhooks(:active).url
+  end
+end
diff --git a/test/models/event/webhookable_test.rb b/test/models/event/webhookable_test.rb
