+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "creating a webhook creates an account-scoped tracker" do
+    webhook = Webhook.create!(name: "Receiver", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_not webhook.delinquency_tracker.delinquent?
+  end
+
+  test "the database allows only one tracker per webhook" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::DelinquencyTracker.create!(webhook: webhooks(:active))
+    end
+  end
+
+  test "legacy webhooks without trackers can record deliveries and reactivate" do
+    webhook = webhooks(:active)
+    webhook.delinquency_tracker.destroy!
+    webhook.reload
+    webhook.record_delivery_result(webhook_deliveries(:unsuccessfully_completed))
+
+    assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+    assert_not_nil webhook.delinquency_tracker.first_failure_at
+
+    webhook.deactivate
+    webhook.delinquency_tracker.destroy!
+    webhook.reload.activate
+
+    assert webhook.active?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "destroying a webhook removes its tracker and delivery log" do
+    webhook = webhooks(:active)
+    tracker = webhook.delinquency_tracker
+    webhook.destroy!
+
+    assert_not Webhook::DelinquencyTracker.exists?(tracker.id)
+    assert_empty Webhook::Delivery.where(webhook_id: webhook.id)
+  end
+end
diff --git a/test/models/webhook/delivery_execution_test.rb b/test/models/webhook/delivery_execution_test.rb
new file mode 100644
index 0000000..ad8ff63
--- /dev/null
+++ b/test/models/webhook/delivery_execution_test.rb
@@ -0,0 +1,260 @@
+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "pins DNS and records request and response details" do
+    receiver = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(
+      status: 201, headers: { "X-Receiver" => "test" }, body: "accepted"
+    )
+    delivery = create_delivery
+    delivery.deliver
+
+    assert_requested receiver, times: 1
+    assert delivery.succeeded?
+    assert_equal "accepted", delivery.response[:body]
+    assert_equal [ "test" ], delivery.response[:headers]["x-receiver"]
+    payload = JSON.parse(delivery.request[:body])
+    assert_equal delivery.event_id, payload["id"]
+    assert_includes payload.dig("eventable", "url"), "#{@webhook.account.slug}/cards/"
+  end
+
+  test "only the claimed worker can send, including with stale model instances" do
+    delivery = create_delivery
+    stale = Webhook::Delivery.find(delivery.id)
+    receiver = stub_request(:post, @webhook.url).to_return do
+      stale.deliver
+      { status: 200 }
+    end
+
+    delivery.deliver
+    stale.deliver
+
+    assert_requested receiver, times: 1
+  end
+
+  test "the database rejects duplicate webhook and event pairs" do
+    delivery = create_delivery
+    assert_raises ActiveRecord::RecordNotUnique do
+      @webhook.deliveries.create!(event: delivery.event)
+    end
+  end
+
+  test "non-success responses are logged and never retried" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 503, body: "unavailable")
+    delivery = create_delivery
+    2.times { delivery.deliver }
+
+    assert_requested receiver, times: 1
+    assert delivery.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "network errors are logged and never retried" do
+    [ Net::ReadTimeout, Errno::ECONNREFUSED, OpenSSL::SSL::SSLError, SocketError ].each do |error|
+      receiver = stub_request(:post, @webhook.url).to_raise(error)
+      delivery = create_delivery
+      2.times { delivery.deliver }
+
+      assert delivery.errored?
+      assert_equal error.name, delivery.response[:error]
+      assert_requested receiver, times: 1
+      WebMock.reset!
+    end
+  end
+
+  test "private addresses are not contacted" do
+    [ "127.0.0.1", "169.254.169.254", "::1" ].each do |ip|
+      stub_dns_resolution(ip)
+      delivery = create_delivery
+      delivery.deliver
+
+      assert delivery.errored?
+      assert_equal "destination_unreachable", delivery.response[:error]
+    end
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "literal internal IP addresses are not contacted" do
+    @webhook.update!(url: "http://127.0.0.1/webhook")
+    delivery = create_delivery
+    delivery.deliver
+
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "redirects are not followed" do
+    receiver = stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/private" })
+    delivery = create_delivery
+    delivery.deliver
+
+    assert_requested receiver, times: 1
+    assert delivery.failed?
+    assert_equal 302, delivery.response[:code]
+    assert_not_requested :any, "http://127.0.0.1/private"
+  end
+
+  test "response bodies are bounded and valid UTF-8" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "a" * 20.kilobytes + "\xFF".b)
+    delivery = create_delivery
+    delivery.deliver
+
+    assert delivery.succeeded?
+    assert_equal Webhook::Delivery::Request::MAX_RESPONSE_BODY_SIZE, delivery.response[:body].bytesize
+    assert delivery.response[:body].valid_encoding?
+  end
+
+  test "deactivation stops already queued deliveries without counting a receiver failure" do
+    delivery = create_delivery
+    @webhook.deactivate
+    delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert delivery.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the receiver" do
+    freeze_time do
+      stub_request(:post, @webhook.url).to_return(status: 500)
+      9.times { create_delivery.deliver }
+      assert @webhook.reload.active?
+      assert_equal 9, @webhook.delinquency_tracker.reload.consecutive_failures_count
+
+      travel 1.hour
+      create_delivery.deliver
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "a brief burst or fewer than ten failures does not deactivate the receiver" do
+    freeze_time do
+      stub_request(:post, @webhook.url).to_return(status: 500)
+      10.times { create_delivery.deliver }
+      assert @webhook.reload.active?
+
+      @webhook.delinquency_tracker.update!(consecutive_failures_count: 1)
+      travel 2.hours
+      create_delivery.deliver
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "success resets the failure streak" do
+    @webhook.delinquency_tracker.update!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    create_delivery.deliver
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.reload.first_failure_at
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    create_delivery.deliver
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "reactivation starts a fresh failure streak" do
+    @webhook.deactivate
+    @webhook.delinquency_tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.activate
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.reload.first_failure_at
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    create_delivery.deliver
+    assert @webhook.reload.active?
+  end
+
+  test "cleanup deletes only logs older than a week without resetting failure tracking" do
+    freeze_time do
+      Webhook::Delivery.delete_all
+      @webhook.delinquency_tracker.update!(consecutive_failures_count: 9, first_failure_at: 8.days.ago)
+      old = create_delivery(created_at: 1.week.ago - 1.second)
+      boundary = create_delivery(created_at: 1.week.ago)
+      recent = create_delivery(created_at: 1.day.ago)
+
+      assert_difference "Webhook::Delivery.count", -1 do
+        Webhook::Delivery.cleanup
+      end
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(recent.id)
+      assert_equal 9, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    end
+  end
+
+  test "pending recovery enqueues only pending deliveries with their account context" do
+    Webhook::Delivery.delete_all
+    delivery = create_delivery
+    create_delivery(state: :completed, response: { code: 200 })
+    clear_enqueued_jobs
+
+    Current.without_account do
+      assert_enqueued_with(job: Webhook::DeliverJob, args: [ delivery ]) do
+        Webhook::Delivery.deliver_pending_later
+      end
+    end
+    assert_equal 1, enqueued_jobs.size
+    assert_equal delivery.account.to_gid.to_s, enqueued_jobs.first["account"].to_s
+  end
+
+  test "completed records without a response code are safe to display" do
+    delivery = create_delivery(state: :completed)
+    assert_not delivery.succeeded?
+    assert delivery.failed?
+  end
+
+  test "Slack uses a text payload with a tenant-aware link" do
+    @webhook.update!(url: "https://hooks.slack.com/services/T123/B456/test-token") # gitleaks:allow
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    delivery = create_delivery
+    delivery.deliver
+
+    assert delivery.succeeded?, delivery.response.inspect
+    payload = JSON.parse(delivery.request[:body])
+    assert_includes payload.fetch("text"), "David commented on"
+    assert_includes payload["text"], "<http://example.org#{@webhook.account.slug}/cards/"
+    assert_includes payload["text"], "|↗︎>"
+  end
+
+  test "Campfire and Basecamp use an HTML content payload" do
+    [ "https://chat.example.com/rooms/123/456-token/messages",
+      "https://3.basecamp.com/123/integrations/token/buckets/456/chats/789/lines" ].each do |url|
+      @webhook.update!(url: url)
+      stub_request(:post, url).to_return(status: 201)
+      delivery = create_delivery
+      delivery.deliver
+
+      assert delivery.succeeded?, delivery.response.inspect
+      payload = JSON.parse(delivery.request[:body])
+      assert_includes payload.fetch("content"), "David commented on"
+      assert_includes payload["content"], "<a href=\"http://example.org#{@webhook.account.slug}/cards/"
+    end
+  end
+
+  test "an unresolvable destination is logged as unreachable" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+    delivery = create_delivery
+    delivery.deliver
+
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  private
+
+    def create_delivery(**attributes)
+      event = Event.new(events(:layout_commented).attributes.except("id", "created_at", "updated_at"))
+      event.save!
+      @webhook.deliveries.create!(event: event, **attributes)
+    end
+end
