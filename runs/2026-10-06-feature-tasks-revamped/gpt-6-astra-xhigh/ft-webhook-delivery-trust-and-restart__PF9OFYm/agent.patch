diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..ffbebe0
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,77 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 5
+  MAX_RESPONSE_BODY_SIZE = 16.kilobytes
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def body
+    @body ||= if webhook.for_slack?
+      { text: render_event(:text).strip }.to_json
+    elsif webhook.for_campfire? || webhook.for_basecamp?
+      { content: render_event(:html) }.to_json
+    else
+      render_event(:json)
+    end
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Delivery" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def perform
+    uri = URI.parse(webhook.url)
+    ip = public_ip(uri.hostname)
+
+    if ip
+      # Pin the checked address, retain the hostname for TLS, and bypass environment proxies.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.request(request) do |response|
+        response_body = +""
+        response.read_body do |chunk|
+          response_body << chunk.byteslice(0, MAX_RESPONSE_BODY_SIZE - response_body.bytesize)
+          break if response_body.bytesize >= MAX_RESPONSE_BODY_SIZE
+        end
+
+        return { code: response.code.to_i, headers: response.to_hash, body: response_body.force_encoding(Encoding::UTF_8).scrub }
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  end
+
+  private
+    def public_ip(hostname)
+      ip = IPAddr.new(hostname)
+      ip.to_s unless SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+
+    def render_event(format)
+      ApplicationController.renderer.new(script_name: delivery.account.slug).render(
+        template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event }
+      )
+    end
+end
