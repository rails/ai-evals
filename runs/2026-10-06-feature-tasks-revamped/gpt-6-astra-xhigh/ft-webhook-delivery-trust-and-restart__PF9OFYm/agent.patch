--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "only active subscribers on the event's board receive deliveries" do
+    subscribed = webhooks(:active)
+    subscribed.update!(subscribed_actions: [ "comment_created" ])
+    Webhook.new(subscribed.attributes.except("id", "created_at", "updated_at")).tap { |webhook| webhook.update!(active: false) }
+    Webhook.new(subscribed.attributes.except("id", "created_at", "updated_at")).tap { |webhook| webhook.update!(subscribed_actions: [ "card_closed" ]) }
+    Webhook.new(subscribed.attributes.except("id", "created_at", "updated_at")).tap { |webhook| webhook.update!(board: boards(:private)) }
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      event = Event.new(events(:layout_commented).attributes.except("id", "created_at", "updated_at"))
+      event.save!
+      assert_equal [ subscribed.id ], event.webhook_deliveries.pluck(:webhook_id)
+    end
+  end
+
+  test "disabled webhooks and unsupported actions do not get deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      webhook = webhooks(:active)
+      webhook.deactivate
+      Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_closed")
+
+      webhook.activate
+      Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_title_changed")
+    end
+  end
+
+  test "updating an event does not create another delivery" do
+    event = events(:logo_published)
+    assert_no_difference "Webhook::Delivery.count" do
+      event.touch
+    end
+  end
+
+  test "rolled back events neither persist deliveries nor enqueue sends" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliverJob do
+        Event.transaction do
+          event = Event.new(events(:logo_published).attributes.except("id", "created_at", "updated_at"))
+          event.save!
+          assert_equal 1, event.webhook_deliveries.count
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
