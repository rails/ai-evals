+require "test_helper"
+
+class Account::DataTransfer::ActiveStorage::AttachmentRecordSetTest < ActiveSupport::TestCase
+  test "the local accounting marker is not exported or required on import" do
+    record_set = Account::DataTransfer::ActiveStorage::AttachmentRecordSet.new(Current.account)
+
+    assert_not_includes record_set.attributes, "storage_tracked"
+    assert_includes record_set.attributes, "blob_id"
+  end
+
+  test "imported attachments are backfilled even if the export contained an accounting marker" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+    attachment_id = ActiveRecord::Type::Uuid.generate
+    file = Tempfile.new([ "attachments", ".zip" ])
+    file.binmode
+    writer = ZipFile::Writer.new(file)
+    writer.add_file("data/active_storage_attachments/#{attachment_id}.json", {
+      id: attachment_id,
+      account_id: Current.account.id,
+      blob_id: blob.id,
+      record_type: "Card",
+      record_id: cards(:logo).id,
+      name: "image",
+      created_at: Time.current.iso8601,
+      storage_tracked: true
+    }.to_json)
+    writer.close
+    file.rewind
+
+    Account::DataTransfer::ActiveStorage::AttachmentRecordSet.new(Current.account).import(from: ZipFile::Reader.new(file))
+
+    assert_not ActiveStorage::Attachment.find(attachment_id).storage_tracked?
+    Storage::AccountUsageJob.perform_now(Current.account)
+    assert_equal 5, Current.account.bytes_used
+    assert_equal 5, boards(:writebook).bytes_used
+  ensure
+    file&.close!
+  end
+end
