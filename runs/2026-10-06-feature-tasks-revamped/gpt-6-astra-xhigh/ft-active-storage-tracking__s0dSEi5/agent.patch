+module Storage::Measured
+  def bytes_used
+    # Deltas from different writers can arrive out of order across batches.
+    # Keep the signed cache for reconciliation, but never report negative usage.
+    Storage::Usage.where(account_id: account.id, record: self).pick(:bytes_used).to_i.clamp(0..)
+  end
+end
