diff --git a/app/jobs/storage/account_usage_job.rb b/app/jobs/storage/account_usage_job.rb
new file mode 100644
index 0000000..f5fdfab
--- /dev/null
+++ b/app/jobs/storage/account_usage_job.rb
@@ -0,0 +1,19 @@
+class Storage::AccountUsageJob < ApplicationJob
+  limits_concurrency key: ->(account) { account.id }
+
+  # Incineration can remove the account or its cache after job deserialization.
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound, ActiveRecord::InvalidForeignKey
+  retry_on ActiveRecord::Deadlocked
+
+  def perform(account)
+    # Rich text records are imported after attachments; do not backfill a partial import.
+    return if account.importing?
+
+    ActiveStorage::Attachment.track_storage_batch(account)
+    Storage::Usage.process(account)
+
+    if Storage::Entry.exists?(account: account) || ActiveStorage::Attachment.exists?(account: account, storage_tracked: false)
+      self.class.perform_later(account)
+    end
+  end
+end
