diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..f143a0e
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,94 @@
+# Account and Board rows are read caches. Card rows remember both the card's
+# subtotal and where it was last counted, so moving a card is constant work,
+# regardless of how many images or comment attachments it has.
+class Storage::Usage < ApplicationRecord
+  BATCH_SIZE = 1_000
+
+  belongs_to :account
+  belongs_to :record, polymorphic: true, optional: true
+
+  def self.process(account)
+    total = find_or_create_by!(account: account, record: account)
+
+    # Only workers take this lock. Different accounts can be processed in parallel.
+    # Keep the transaction bounded and delete only the entries we actually applied.
+    total.with_lock do
+      entries = Storage::Entry.where(account: account).order(:id).limit(BATCH_SIZE).to_a
+      total.apply(entries)
+      Storage::Entry.where(id: entries.map(&:id)).delete_all
+    end
+  end
+
+  def apply(entries)
+    deltas = entries.group_by { |entry| [ entry.record_type, entry.record_id ] }
+      .transform_values { |group| group.sum(&:byte_delta) }
+
+    card_deltas = deltas.filter_map { |(type, id), delta| [ id, delta ] if type == "Card" }.to_h
+    board_deltas = Hash.new(0)
+    deltas.each { |(type, id), delta| board_deltas[id] += delta if type == "Board" }
+
+    move_card_usage(card_deltas, board_deltas)
+    apply_board_usage(board_deltas)
+    save!
+  end
+
+  private
+    def move_card_usage(deltas, board_deltas)
+      usages = cached("Card", deltas.keys)
+      boards = Card.where(account_id: account_id, id: deltas.keys).pluck(:id, :board_id).to_h
+
+      writes, deletes = [], []
+
+      deltas.each do |card_id, delta|
+        usage = usages[card_id] || new_usage("Card", card_id)
+        board_deltas[usage.board_id] -= usage.bytes_used if usage.board_id
+
+        if board_id = boards[card_id]
+          usage.bytes_used += delta
+          usage.board_id = board_id
+          board_deltas[board_id] += usage.bytes_used
+          writes << usage
+        else
+          deletes << usage.id
+        end
+      end
+
+      write_usages(writes, deletes)
+    end
+
+    def apply_board_usage(deltas)
+      usages = cached("Board", deltas.keys)
+      board_ids = Board.where(account_id: account_id, id: deltas.keys).pluck(:id).to_set
+
+      writes, deletes = [], []
+
+      deltas.each do |board_id, delta|
+        usage = usages[board_id] || new_usage("Board", board_id)
+        previous_bytes = usage.bytes_used
+
+        if board_ids.include?(board_id)
+          usage.bytes_used += delta
+          writes << usage
+          self.bytes_used += usage.bytes_used - previous_bytes
+        else
+          self.bytes_used -= previous_bytes
+          deletes << usage.id
+        end
+      end
+
+      write_usages(writes, deletes)
+    end
+
+    def write_usages(writes, deletes)
+      self.class.upsert_all(writes.map(&:attributes), update_only: [ :bytes_used, :board_id ]) if writes.any?
+      self.class.where(id: deletes).delete_all if deletes.any?
+    end
+
+    def cached(type, ids)
+      self.class.where(account_id: account_id, record_type: type, record_id: ids).index_by(&:record_id)
+    end
+
+    def new_usage(type, id)
+      self.class.new(account: account, record_type: type, record_id: id)
+    end
+end
