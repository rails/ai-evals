@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Storage::ConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    Current.session = sessions(:david)
+    Storage::Entry.delete_all
+    Storage::Usage.delete_all
+  end
+
+  teardown do
+    @blob&.attachments&.each(&:delete)
+    @blob&.purge
+    Search::Record.for(accounts(:"37s").id).where(searchable_type: "Card", searchable_id: cards(:logo).id).destroy_all
+    Storage::Entry.delete_all
+    Storage::Usage.delete_all
+  end
+
+  test "overlapping workers apply each change once" do
+    account = accounts(:"37s")
+    card = cards(:logo)
+    10.times { Storage::Entry.record(card, 5) }
+    concurrently(*2.times.map { -> { Storage::Usage.process(Account.find(account.id)) } })
+
+    assert_equal 50, account.bytes_used
+    assert_equal 50, card.board.bytes_used
+    assert_empty Storage::Entry.all
+    assert_equal 3, Storage::Usage.count
+  end
+  test "concurrent removals only subtract once" do
+    attachment = create_attachment
+    Storage::Usage.process(Current.account)
+    copies = 2.times.map { ActiveStorage::Attachment.find(attachment.id) }
+
+    concurrently(*copies.map { |copy| -> { copy.delete } })
+    Storage::Usage.process(Current.account)
+
+    assert_equal 0, Current.account.bytes_used
+    assert_equal 0, cards(:logo).board.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "backfill racing removal does not lose or double count usage" do
+    attachment = create_attachment
+    Storage::Entry.delete_all
+    attachment.update_column(:storage_tracked, false)
+    account = Current.account
+
+    concurrently(
+      -> { ActiveStorage::Attachment.track_storage_batch(account) },
+      -> { ActiveStorage::Attachment.find_by(id: attachment.id)&.delete }
+    )
+    Storage::Usage.process(account)
+
+    assert_equal 0, account.bytes_used
+    assert_equal 0, cards(:logo).board.bytes_used
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_empty Storage::Entry.all
+  end
+
+  private
+    def create_attachment
+      @blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+      cards(:logo).image.attach @blob
+      cards(:logo).image_attachment
+    end
+
+    def concurrently(*operations)
+      ready, start = Queue.new, Queue.new
+      workers = operations.map do |operation|
+        Thread.new do
+          ApplicationRecord.connection_pool.with_connection do
+            ready << true
+            start.pop
+            operation.call
+          end
+        end
+      end
+
+      operations.size.times { ready.pop }
+      operations.size.times { start << true }
+      workers.each(&:value)
+    end
+end
diff --git a/test/models/storage/usage_test.rb b/test/models/storage/usage_test.rb
new file mode 100644
index 0000000..d3bf295
--- /dev/null
+++ b/test/models/storage/usage_test.rb
@@ -0,0 +1,421 @@
+require "test_helper"
+
+class Storage::UsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "account and board expose background calculated storage usage" do
+    assert_usage 0
+    attach_image("image")
+    assert_usage 0
+
+    process_usage
+
+    assert_usage 5
+  end
+
+  test "counts images and embeds in board descriptions, card descriptions, and comments" do
+    attach_image("image")
+    embed(@board, :public_description, "board file")
+    embed(@card, :description, "card file")
+    embed(comments(:logo_agreement_jz), :body, "comment file")
+
+    process_usage
+
+    assert_usage 36
+  end
+
+  test "ignores avatars, exports, unattached uploads, and generated previews" do
+    users(:david).avatar.attach blob("avatar")
+    @account.exports.create!(user: users(:david)).file.attach blob("export")
+    blob("not attached")
+    original = blob("original")
+    original.preview_image.attach blob("preview")
+    variant = original.variant_records.create!(variation_digest: "variation")
+    variant.image.attach blob("variant")
+
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "each attachment counts even when it reuses a blob" do
+    shared = blob("shared")
+    @card.image.attach shared
+    @card.update!(description: attachment_html(shared))
+    cards(:layout).image.attach shared
+
+    process_usage
+
+    assert_usage 18
+  end
+
+  test "drafts and closed cards count and accounts stay isolated" do
+    attach_image("image")
+    cards(:shipping).image.attach blob("closed")
+    other_account = accounts(:initech)
+    Current.with_account(other_account) do
+      cards(:unfinished_thoughts).image.attach blob("draft")
+    end
+
+    process_usage
+
+    assert_usage 11
+    assert_equal 5, other_account.bytes_used
+    assert_equal 5, boards(:miltons_wish_list).bytes_used
+    assert_equal 0, boards(:private).bytes_used
+  end
+
+  test "replacing an image subtracts the old image" do
+    attach_image("old")
+    process_usage
+    attach_image("new image")
+    process_usage
+
+    assert_usage 9
+  end
+
+  test "removing an embed subtracts it without waiting for the blob purge" do
+    embed(@card, :description, "file")
+    process_usage
+    @card.update!(description: "no attachment")
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "purge and purge_later subtract attachments" do
+    [ :purge, :purge_later ].each do |method|
+      attach_image("image")
+      process_usage
+      assert_usage 5
+
+      @card.image.public_send(method)
+      process_usage
+      assert_usage 0
+    end
+  end
+
+  test "detaching one or many attachments keeps blobs but removes their usage" do
+    attach_image("image")
+    embed(@card, :description, "embed")
+    process_usage
+
+    assert_no_difference "ActiveStorage::Blob.count" do
+      @card.image.detach
+      @card.description.embeds.detach
+    end
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "repeated removal from stale attachment instances is counted only once" do
+    attach_image("image")
+    first = @card.image_attachment
+    second = ActiveStorage::Attachment.find(first.id)
+    process_usage
+
+    first.delete
+    second.delete
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "attachment changes roll back together with their entries" do
+    ActiveStorage::Attachment.transaction do
+      attach_image("rolled back")
+      raise ActiveRecord::Rollback
+    end
+    process_usage
+    assert_usage 0
+
+    @card.reload
+    attach_image("image")
+    process_usage
+    ActiveStorage::Attachment.transaction do
+      @card.image_attachment.delete
+      raise ActiveRecord::Rollback
+    end
+    process_usage
+    assert_usage 5
+  end
+
+  test "moving a card transfers its image, description, and comments but not board files" do
+    attach_image("image")
+    embed(@board, :public_description, "board")
+    embed(@card, :description, "card")
+    embed(comments(:logo_agreement_jz), :body, "comment")
+    process_usage
+
+    @card.move_to(boards(:private))
+    process_usage
+
+    assert_equal 5, @board.bytes_used
+    assert_equal 16, boards(:private).bytes_used
+    assert_equal 21, @account.bytes_used
+  end
+
+  test "moves and attachment changes before processing use the current board" do
+    attach_image("image")
+    @card.move_to(boards(:private))
+    embed(comments(:logo_agreement_jz), :body, "comment")
+    @card.image.purge_later
+    @card.move_to(@board)
+    @card.move_to(boards(:private))
+    process_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 7, boards(:private).bytes_used
+    assert_equal 7, @account.bytes_used
+  end
+
+  test "destroying comments, cards and boards subtracts their usage" do
+    attach_image("image")
+    embed(@board, :public_description, "board")
+    embed(comments(:logo_agreement_jz), :body, "comment")
+    process_usage
+    assert_usage 17
+
+    comments(:logo_agreement_jz).destroy!
+    process_usage
+    assert_usage 10
+
+    @card.destroy!
+    process_usage
+    assert_usage 5
+
+    @board.destroy!
+    process_usage
+    assert_usage 0
+  end
+
+  test "deleting a board before pending additions are processed does not leave usage" do
+    attach_image("image")
+    embed(@board, :public_description, "board")
+    @board.destroy!
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "a moved card remains counted when the old board is deleted" do
+    attach_image("image")
+    process_usage
+    @card.move_to(boards(:private))
+    @board.destroy!
+    process_usage
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 5, boards(:private).bytes_used
+    assert_equal 5, @account.bytes_used
+  end
+
+  test "backfills existing and bulk imported attachments exactly once" do
+    attach_image("image")
+    embed(@board, :public_description, "board")
+    embed(comments(:logo_agreement_jz), :body, "comment")
+    Storage::Entry.delete_all
+    ActiveStorage::Attachment.update_all(storage_tracked: false)
+
+    2.times { process_usage }
+
+    assert_usage 17
+    assert_not ActiveStorage::Attachment.exists?(storage_tracked: false)
+
+    @card.image.purge_later
+    process_usage
+    assert_usage 12
+  end
+
+  test "deleting an attachment before backfill does not subtract uncounted bytes" do
+    attach_image("image")
+    Storage::Entry.delete_all
+    ActiveStorage::Attachment.update_all(storage_tracked: false)
+    @card.image.purge_later
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "deleting a stale untracked instance after backfill subtracts its bytes" do
+    attach_image("image")
+    Storage::Entry.delete_all
+    ActiveStorage::Attachment.update_all(storage_tracked: false)
+    stale_attachment = @card.image_attachment.reload
+    process_usage
+    stale_attachment.delete
+    process_usage
+
+    assert_usage 0
+  end
+
+  test "worker retries do not count changes twice" do
+    attach_image("image")
+    2.times { Storage::AccountUsageJob.perform_now(@account) }
+
+    assert_usage 5
+    assert_empty Storage::Entry.all
+  end
+
+  test "failed batches roll back both totals and consumed entries" do
+    attach_image("image")
+    Storage::Usage.create!(account: @account, record: @account)
+    Storage::Usage.any_instance.stubs(:save!).raises("interrupted")
+
+    assert_raises(RuntimeError) { Storage::Usage.process(@account) }
+    assert_usage 0
+    assert_equal 1, Storage::Entry.count
+    assert_not Storage::Usage.exists?(record_type: [ "Card", "Board" ])
+
+    Storage::Usage.any_instance.unstub(:save!)
+    process_usage
+    assert_usage 5
+  end
+
+  test "processes bounded batches and continues until caught up" do
+    attach_image("image")
+    cards(:layout).image.attach blob("second")
+    stub_const(Storage::Usage, :BATCH_SIZE, 1) do
+      Storage::Usage.process(@account)
+      assert_equal 1, Storage::Entry.count
+      process_usage
+    end
+
+    assert_usage 11
+    assert_empty Storage::Entry.all
+  end
+
+  test "out of order additions and removals never report negative usage" do
+    attach_image("image")
+    @card.image_attachment.delete
+    removal = Storage::Entry.find_by!(byte_delta: -5)
+    removal.update_column(:id, ActiveRecord::FixtureSet.identify("early_storage_removal", :uuid))
+
+    stub_const(Storage::Usage, :BATCH_SIZE, 1) do
+      Storage::Usage.process(@account)
+      assert_equal(-5, Storage::Usage.find_by!(record: @account).bytes_used)
+      assert_usage 0
+
+      Storage::Usage.process(@account)
+      assert_equal 0, Storage::Usage.find_by!(record: @account).bytes_used
+      assert_usage 0
+    end
+  end
+
+  test "64 bit totals support large files" do
+    large = blob("file")
+    large.update_column(:byte_size, 5.terabytes)
+    @card.image.attach large
+    process_usage
+
+    assert_usage 5.terabytes
+  end
+
+  test "changes arriving during a batch are not discarded" do
+    attach_image("image")
+    total = Storage::Usage.create!(account: @account, record: @account)
+    original_apply = total.method(:apply)
+    card = @card
+    total.define_singleton_method(:apply) do |entries|
+      Storage::Entry.record(card, 7)
+      original_apply.call(entries)
+    end
+    Storage::Usage.stubs(:find_or_create_by!).returns(total)
+
+    Storage::Usage.process(@account)
+    assert_usage 5
+    assert_equal 1, Storage::Entry.count
+
+    Storage::Usage.unstub(:find_or_create_by!)
+    process_usage
+    assert_usage 12
+  end
+
+  test "waits for imports to finish before backfilling" do
+    attach_image("image")
+    Storage::Entry.delete_all
+    ActiveStorage::Attachment.update_all(storage_tracked: false)
+    import = @account.imports.create!(identity: identities(:david), status: :processing)
+
+    assert_no_enqueued_jobs only: Storage::AccountUsageJob do
+      Storage::Entry.process_all_later
+    end
+    Storage::AccountUsageJob.perform_now(@account)
+    assert_usage 0
+    assert_not @card.image_attachment.reload.storage_tracked?
+
+    import.update!(status: :completed)
+    process_usage
+    assert_usage 5
+  end
+
+  test "deleting an account cleans up pending entries and cached totals" do
+    attach_image("image")
+    process_usage
+    embed(@board, :public_description, "pending")
+    @account.destroy!
+
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Usage.exists?(account_id: @account.id)
+  end
+
+  test "an in-flight job cannot recreate the cache of a deleted account" do
+    stale_account = Account.find(@account.id)
+    @account.destroy!
+
+    Storage::AccountUsageJob.perform_now(stale_account)
+
+    assert_not Storage::Entry.exists?(account_id: stale_account.id)
+    assert_not Storage::Usage.exists?(account_id: stale_account.id)
+  end
+
+  test "reads and incremental batches do not scan attachments" do
+    attach_image("image")
+
+    assert_no_queries_match(/(?:FROM|JOIN) ["`]active_storage_(?:blobs|attachments)["`]/i) do
+      Storage::Usage.process(@account)
+      assert_usage 5
+    end
+
+    # Moving a card also uses its cached subtotal, not its attachments/comments.
+    Storage::Entry.record(@card)
+    assert_no_queries_match(/(?:FROM|JOIN) ["`](?:active_storage_|action_text_|comments)/i) do
+      Storage::Usage.process(@account)
+      assert_usage 5
+    end
+  end
+
+  private
+    def attach_image(content)
+      @card.image.attach blob(content)
+    end
+
+    def blob(content)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new(content), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(record, name, content)
+      record.update!(name => attachment_html(blob(content)))
+    end
+
+    def attachment_html(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def process_usage
+      perform_enqueued_jobs only: Storage::AccountUsageJob do
+        Storage::Entry.process_all_later
+      end
+    end
+
+    def assert_usage(bytes)
+      assert_equal bytes, @account.bytes_used
+      assert_equal bytes, @board.bytes_used
+    end
+end
