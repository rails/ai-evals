diff --git a/app/models/storage/attachment.rb b/app/models/storage/attachment.rb
new file mode 100644
index 0000000..ee8010e
--- /dev/null
+++ b/app/models/storage/attachment.rb
@@ -0,0 +1,62 @@
+module Storage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    before_create { self.storage_tracked = true }
+    after_create :record_storage_addition
+  end
+
+  class_methods do
+    def track_storage_batch(account)
+      where(account: account, storage_tracked: false).limit(100).each do |attachment|
+        attachment.with_lock do
+          unless attachment.storage_tracked?
+            attachment.send(:record_storage_addition)
+            attachment.update_column(:storage_tracked, true)
+          end
+        end
+      rescue ActiveRecord::RecordNotFound
+        # It was removed before the backfill acquired its lock.
+      end
+    end
+  end
+
+  private
+    def record_storage_addition
+      if owner = storage_owner
+        Storage::Entry.record(owner, blob.byte_size)
+      end
+    end
+
+    def storage_owner
+      case record
+      when Card
+        record if name == "image"
+      when ActionText::RichText
+        if name == "embeds"
+          case parent = record.record
+          when Board
+            parent if record.name == "public_description"
+          when Card
+            parent if record.name == "description"
+          when Comment
+            parent.card if record.name == "body"
+          end
+        end
+      end
+    end
+
+    # destroy, purge, purge_later and has_one_attached#detach all reach this
+    # method. A conditional write makes concurrent/repeated deletes safe, and
+    # serializes removal against the backfill without locking an account/board.
+    def _delete_row
+      self.class.transaction do
+        if self.class.where(id: id, storage_tracked: true).update_all(storage_tracked: false) == 1
+          if owner = storage_owner
+            Storage::Entry.record(owner, -blob.byte_size)
+          end
+        end
+        super
+      end
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..46c8790
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,21 @@
+# A transactional outbox: requests only append entries, never lock shared totals.
+# Entries and their effects on the cache are committed together by the worker.
+class Storage::Entry < ApplicationRecord
+  belongs_to :account
+  belongs_to :record, polymorphic: true, optional: true
+
+  class << self
+    def record(record, byte_delta = 0)
+      create!(account_id: record.account_id, record: record, byte_delta: byte_delta)
+    end
+
+    def process_all_later
+      pending = Account.where(id: select(:account_id))
+      untracked = Account.where(id: ActiveStorage::Attachment.where(storage_tracked: false).select(:account_id))
+
+      pending.or(untracked).where.not(id: Account.importing.select(:id)).find_each do |account|
+        Current.with_account(account) { Storage::AccountUsageJob.perform_later(account) }
+      end
+    end
+  end
+end
