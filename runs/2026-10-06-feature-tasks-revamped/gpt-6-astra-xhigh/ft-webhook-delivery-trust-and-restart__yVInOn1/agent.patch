+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def deliver_request
+      outgoing_request = Request.new(self)
+      update! request: { headers: outgoing_request.headers }
+      complete(outgoing_request.perform)
+    rescue StandardError
+      # Preserve the failed attempt in the log, while still surfacing the exception
+      # to job monitoring. Re-running the job must not send another POST.
+      complete(error: "delivery_error")
+      raise
+    end
+
+    def complete(result)
+      webhook.with_lock do
+        update! response: result, state: result[:error].present? ? :errored : :completed
+        webhook.record_delivery_result(self)
+      end
+    end
