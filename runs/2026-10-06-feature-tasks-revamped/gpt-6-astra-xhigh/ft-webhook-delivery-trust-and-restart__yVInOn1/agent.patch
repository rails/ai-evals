diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..334b598
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,75 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def headers
+    @headers ||= {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Delivery-Id" => delivery.id,
+      "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    }
+  end
+
+  def perform
+    uri = URI.parse(webhook.url)
+
+    if Webhook::PERMITTED_SCHEMES.exclude?(uri.scheme) || uri.host.blank?
+      { error: "invalid_url" }
+    elsif ip = public_ip(uri.hostname)
+      post(uri, ip)
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Resolv::ResolvError
+    { error: "destination_unreachable" }
+  rescue URI::InvalidURIError
+    { error: "invalid_url" }
+  end
+
+  private
+    def body
+      @body ||= ApplicationController.renderer.new(script_name: delivery.account.slug).render(
+        template: "webhooks/event", formats: [ :json ], assigns: { event: event }
+      )
+    end
+
+    def public_ip(hostname)
+      ip = IPAddr.new(hostname)
+      ip.to_s unless SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+
+    def post(uri, ip)
+      # Pin the validated address, keep the original host for TLS/Host, and do not
+      # use environment proxies or follow redirects (both can bypass SSRF checks).
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      result = nil
+      Timeout.timeout(TIMEOUT) do
+        http.request(Net::HTTP::Post.new(uri.request_uri, headers), body) do |response|
+          # Drain without retaining an unbounded receiver-controlled response body.
+          response.read_body { |_chunk| } if response.class.body_permitted?
+          result = { code: response.code.to_i, headers: response.to_hash }
+        end
+      end
+      result
+    end
+end
