--- /dev/null
+++ b/test/models/event/webhookable_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  setup { WebMock.disable_net_connect! }
+  teardown { WebMock.allow_net_connect! }
+
+  test "a subscribed board event is posted once and its outcome is logged" do
+    webhook = webhooks(:active)
+    SsrfProtection.stubs(:resolve_public_ip).with("api.example.com").returns("93.184.216.34")
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 204)
+
+    event = nil
+    assert_difference "Webhook::Delivery.count", 1 do
+      event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+    end
+
+    delivery = event.webhook_deliveries.sole
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ]
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested :post, webhook.url, times: 1
+    assert delivery.reload.succeeded?, delivery.attributes.inspect
+    assert_equal 204, delivery.response[:code]
+  end
+  test "only active subscriptions on the event's board are triggered" do
+    webhooks(:inactive).update!(board: boards(:writebook))
+    boards(:private).webhooks.create!(name: "Other board", url: "https://other.example.com", subscribed_actions: [ "card_published" ])
+    boards(:writebook).webhooks.create!(name: "Other action", url: "https://other.example.com", subscribed_actions: [ "card_closed" ])
+
+    event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+
+    assert_equal [ webhooks(:active) ], event.webhook_deliveries.map(&:webhook)
+  end
+
+  test "comments are delivered when subscribed" do
+    webhooks(:active).update!(subscribed_actions: [ "comment_created" ])
+    event = boards(:writebook).events.create!(action: "comment_created", creator: users(:david), eventable: comments(:layout_overflowing_david))
+
+    assert_equal [ webhooks(:active) ], event.webhook_deliveries.map(&:webhook)
+  end
+
+  test "rolling back an event leaves no delivery or job" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference [ "Event.count", "Webhook::Delivery.count" ] do
+        Event.transaction(requires_new: true) do
+          boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "duplicate triggers return the same delivery without enqueuing again" do
+    event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+    delivery = event.webhook_deliveries.sole
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        assert_equal delivery, webhooks(:active).trigger(event)
+      end
+    end
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      webhooks(:active).deliveries.create!(event: event)
+    end
+  end
+
+  test "trigger cannot cross boards or accounts" do
+    event = events(:layout_commented)
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: [ event.action ])
+
+    assert_no_difference "Webhook::Delivery.count" do
+      event.board = boards(:private)
+      assert_nil webhook.trigger(event)
+      event.board = webhook.board
+      event.account = accounts(:initech)
+      assert_nil webhook.trigger(event)
+    end
+  end
+end
