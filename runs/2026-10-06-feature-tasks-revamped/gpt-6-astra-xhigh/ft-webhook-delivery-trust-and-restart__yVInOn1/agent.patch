+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    WebMock.disable_net_connect!
+    @webhook = webhooks(:active)
+    SsrfProtection.stubs(:resolve_public_ip).with("api.example.com").returns("93.184.216.34")
+    stub_request(:post, @webhook.url).to_return(status: 503)
+  end
+
+  teardown { WebMock.allow_net_connect! }
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    freeze_time do
+      first_failure_at = Time.current
+      9.times { deliver_event }
+      assert @webhook.reload.active?
+
+      travel 1.hour
+      deliver_event
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+      assert_equal first_failure_at, @webhook.delinquency_tracker.first_failure_at
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate the webhook" do
+    freeze_time do
+      9.times { deliver_event }
+      travel 1.hour - 1.second
+      deliver_event
+      assert @webhook.reload.active?
+
+      travel 1.second
+      deliver_event
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures do not deactivate even after an hour" do
+    freeze_time do
+      deliver_event
+      travel 2.hours
+      8.times { deliver_event }
+
+      assert @webhook.reload.active?
+      assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "success resets both the failure count and the start of the streak" do
+    freeze_time do
+      9.times { deliver_event }
+      travel 2.hours
+      stub_request(:post, @webhook.url).to_return(status: 200)
+      deliver_event
+
+      assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_nil @webhook.delinquency_tracker.first_failure_at
+
+      stub_request(:post, @webhook.url).to_return(status: 500)
+      10.times { deliver_event }
+
+      assert @webhook.reload.active?
+      assert_equal Time.current, @webhook.delinquency_tracker.first_failure_at
+    end
+  end
+
+  test "reactivation resets the streak" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+    deliver_event
+
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_in_delta Time.current, @webhook.delinquency_tracker.first_failure_at, 1.second
+  end
+
+  test "log retention does not reset a failure streak" do
+    freeze_time do
+      9.times { deliver_event }
+      travel 8.days
+      Webhook::Delivery.cleanup
+      deliver_event
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "destroying the webhook removes the tracker" do
+    @webhook.create_delinquency_tracker!
+
+    assert_difference "Webhook::DelinquencyTracker.count", -1 do
+      @webhook.destroy!
+    end
+  end
+
+  private
+    def deliver_event
+      event = @webhook.board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      event.webhook_deliveries.sole.deliver
+    end
+end
diff --git a/test/models/webhook/delivery_execution_test.rb b/test/models/webhook/delivery_execution_test.rb
new file mode 100644
index 0000000..fc41114
--- /dev/null
+++ b/test/models/webhook/delivery_execution_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    WebMock.disable_net_connect!
+    @webhook = webhooks(:active)
+    @delivery = webhook_deliveries(:pending)
+    SsrfProtection.stubs(:resolve_public_ip).with("api.example.com").returns("93.184.216.34")
+  end
+
+  teardown { WebMock.allow_net_connect! }
+
+  test "posts a signed JSON event and records request and response details" do
+    stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34") do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @delivery.event_id, payload["id"]
+      assert_equal @delivery.event.action, payload["action"]
+      assert_equal @webhook.board_id, payload.dig("board", "id")
+      assert_includes payload.dig("eventable", "url"), @webhook.account.slug
+      assert_equal @delivery.id, request.headers["X-Webhook-Delivery-Id"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      true
+    end.to_return(status: 201, headers: { "X-Receiver" => "test" }, body: "created")
+
+    @delivery.deliver
+
+    assert @delivery.reload.succeeded?
+    assert_equal 201, @delivery.response[:code]
+    assert_equal [ "test" ], @delivery.response.dig(:headers, "x-receiver")
+    assert_equal "application/json", @delivery.request.dig(:headers, "Content-Type")
+    assert_not @delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+    assert_nil @webhook.reload.delinquency_tracker
+  end
+
+  test "an overlapping job and a stale pending instance cannot send again" do
+    other = Webhook::Delivery.find(@delivery.id)
+    stub_request(:post, @webhook.url).to_return do
+      assert @delivery.reload.in_progress?
+      other.deliver
+      { status: 200 }
+    end
+
+    @delivery.deliver
+    other.deliver
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "non-pending deliveries are never sent" do
+    %i[ successfully_completed unsuccessfully_completed errored in_progress ].each do |name|
+      webhook_deliveries(name).deliver
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "HTTP errors are completed failures and are not retried" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    2.times { @delivery.deliver }
+
+    assert @delivery.reload.completed?
+    assert @delivery.failed?
+    assert_equal 503, @delivery.response[:code]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "timeouts are logged without retrying" do
+    stub_request(:post, @webhook.url).to_timeout
+
+    2.times { @delivery.deliver }
+
+    assert @delivery.reload.errored?
+    assert_equal "timeout", @delivery.response[:error]
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "unexpected errors are logged and surfaced without allowing a second attempt" do
+    Webhook::Delivery::Request.any_instance.expects(:headers).once.raises(RuntimeError, "render failed")
+
+    assert_raises RuntimeError do
+      @delivery.deliver
+    end
+    @delivery.deliver
+
+    assert @delivery.reload.errored?
+    assert_equal "delivery_error", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "connection errors are logged" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    @delivery.deliver
+
+    assert @delivery.reload.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "redirects are failures and are not followed" do
+    stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/private" })
+
+    @delivery.deliver
+
+    assert @delivery.reload.failed?
+    assert_equal 302, @delivery.response[:code]
+    assert_not_requested :any, "http://127.0.0.1/private"
+  end
+
+  test "private and unresolved destinations are not contacted" do
+    SsrfProtection.stubs(:resolve_public_ip).with("api.example.com").returns(nil)
+
+    @delivery.deliver
+
+    assert_equal "destination_unreachable", @delivery.reload.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "private literal addresses are blocked" do
+    @webhook.update!(url: "http://127.0.0.1/private")
+
+    @delivery.deliver
+
+    assert_equal "destination_unreachable", @delivery.reload.response[:error]
+    assert_not_requested :any, @webhook.url
+  end
+
+  test "queued deliveries do not send after deactivation" do
+    @webhook.deactivate
+
+    @delivery.deliver
+
+    assert_equal "webhook_inactive", @delivery.reload.response[:error]
+    assert_nil @webhook.reload.delinquency_tracker
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "jobs for deleted deliveries are discarded" do
+    @delivery.deliver_later
+    @delivery.destroy!
+
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "cleanup removes only logs older than a week across accounts" do
+    freeze_time do
+      @delivery.update_columns(created_at: 1.week.ago - 1.second)
+      boundary = webhook_deliveries(:in_progress)
+      boundary.update_columns(created_at: 1.week.ago)
+      recent = webhook_deliveries(:successfully_completed)
+      recent.update_columns(created_at: 1.week.ago + 1.second)
+      other = webhooks(:inactive).deliveries.create!(event: events(:layout_commented), account: accounts(:initech), created_at: 8.days.ago)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(@delivery.id)
+      assert_not Webhook::Delivery.exists?(other.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(recent.id)
+      assert Event.exists?(@delivery.event_id)
+      assert Webhook.exists?(@webhook.id)
+    end
+  end
+end
