new file mode 100644
index 0000000..d90833a
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,39 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      render :create
+    else
+      render turbo_stream: turbo_stream.replace([ @comment, :new_reaction ],
+        partial: "cards/comments/reactions/new", locals: { comment: @comment, reaction: @reaction }), status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..5798b24
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,43 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+
+  connect() {
+    if (this.#owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.setAttribute("tabindex", "0")
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  toggle(event) {
+    if (this.#owned && !event.target.closest("button, a, form")) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.element.setAttribute("aria-expanded", expanded)
+    }
+  }
+
+  keydown(event) {
+    if (event.target === this.element && [ "Enter", " " ].includes(event.key)) {
+      event.preventDefault()
+      this.toggle(event)
+    } else if (event.key === "Escape") {
+      this.#close()
+    }
+  }
+
+  closeOnClickOutside(event) {
+    if (!this.element.contains(event.target)) this.#close()
+  }
+
+  #close() {
+    this.element.classList.remove("expanded")
+    if (this.#owned) this.element.setAttribute("aria-expanded", "false")
+  }
+
+  get #owned() {
+    return this.creatorIdValue === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..9d9e800
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "template", "composer", "form", "input" ]
+  static values = { maxLength: Number }
+
+  connect() {
+    if (this.hasInputTarget) this.inputTarget.focus()
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.composerTarget.replaceChildren(this.templateTarget.content.cloneNode(true))
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.composerTarget.replaceChildren()
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  validate(event) {
+    const content = this.inputTarget.value
+    let message = ""
+
+    if (!content.trim()) {
+      message = "Enter an emoji or a short reaction."
+    } else if (Array.from(content).length > this.maxLengthValue) {
+      message = `Reactions can have at most ${this.maxLengthValue} characters.`
+    }
+
+    this.inputTarget.setCustomValidity(message)
+
+    if (event.type === "submit" && !this.formTarget.checkValidity()) {
+      event.preventDefault()
+      this.inputTarget.reportValidity()
+    }
+  }
+
+  submitEnd({ detail }) {
+    if (detail.success) this.cancel()
+  }
+}
