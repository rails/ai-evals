+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create a reaction and append it to the strip" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great!", creator_id: users(:jz).id, account_id: accounts(:initech).id } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_select "turbo-stream[action=append][target=?]", dom_id(@comment, :reactions) do
+      assert_select ".reaction", text: /Great!/
+    end
+  end
+
+  test "invalid content is not saved and displays errors" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+      assert_select "[role=alert]"
+    end
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target=?]", dom_id(reaction)
+  end
+
+  test "cannot destroy another person's reaction" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comment must belong to the card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction must belong to the comment" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "cannot react to an inaccessible card" do
+    @card.update_columns(board_id: boards(:private).id)
+    accesses(:private_kevin).destroy!
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "cannot react to another account's comment" do
+    foreign_comment = cards(:radio).comments.create!(creator: users(:mike), body: "Hello")
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(foreign_comment.card, foreign_comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction content is rendered as plain text" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "<b>Nice</b>" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select ".reaction > span.txt-small", text: "<b>Nice</b>"
+    assert_select ".reaction b", count: 0
+  end
+
+  test "cached comments reflect reactions being added and removed" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      reaction = @comment.reactions.last
+
+      get card_path(@card)
+      assert_select "##{dom_id(@comment, :reactions)} ##{dom_id(reaction)}", text: /👍/
+
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      get card_path(@card)
+      assert_select "##{dom_id(@comment, :reactions)} .reaction", count: 0
+    end
+  end
+
+  test "renders the supplied reaction styles and icon on comments" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} .reactions" do
+      assert_select ".reactions__list"
+      assert_select ".reactions__trigger img[src*='boost-color']"
+    end
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..b2537ec
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "defaults to the comment account and current creator" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:kevin), reaction.creator
+  end
+
+  test "requires content with at most 16 characters" do
+    [ nil, "", "   ", "a" * 17, "👍" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?, content.inspect
+    end
+
+    [ "Thanks!", "a" * 16, "👍" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?, content.inspect
+    end
+  end
+
+  test "can leave more than one reaction" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "👍") }
+    end
+  end
+
+  test "creation and removal broadcast to the card and invalidate cached comments" do
+    travel 1.minute do
+      assert_changes -> { @comment.reload.updated_at } do
+        assert_turbo_stream_broadcasts @comment.card do
+          perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+            @reaction = @comment.reactions.create!(content: "Great!")
+          end
+        end
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { @comment.reload.updated_at } do
+        assert_turbo_stream_broadcasts @comment.card do
+          @reaction.destroy!
+        end
+      end
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
