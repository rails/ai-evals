diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..2415d54
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,51 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :memberships, dependent: :destroy, class_name: "Notification::Bundle::Membership", inverse_of: :bundle
+  has_many :notifications, through: :memberships
+
+  after_create_commit :deliver_later
+
+  def self.add(notification)
+    user = notification.user
+
+    # Lock the recipient, not a bundle: there may not be a window to lock yet.
+    user.with_lock do
+      if !notification.creator.system? && user.active? && user.account.active? && user.identity.present? && (interval = user.settings&.bundle_email_interval)
+        now = Time.current
+
+        # Arrival time determines membership, so delayed notifications join the
+        # open window even when their timestamps precede its start.
+        bundle = user.notification_bundles.where("ends_at > ?", now).order(:ends_at).first ||
+          user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+        bundle.memberships.find_or_create_by!(notification: notification)
+        bundle
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliverJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    # Serialize delivery with arrivals and other delivery attempts for this user.
+    user.with_lock do
+      reload
+
+      if processed_at.nil? && ends_at <= Time.current
+        if deliverable?
+          Current.with_account(account) { NotificationMailer.bundle(self).deliver_now }
+        end
+
+        update!(processed_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def deliverable?
+      user.active? && account.active? && user.identity.present? &&
+        user.settings&.bundle_email_interval.present? && notifications.exists?
+    end
+end
