@@ -0,0 +1,24 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "a digest includes its notifications and account-scoped settings link in both formats" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    notification = notifications(:logo_assignment_kevin)
+    bundle = Notification::Bundle.add(notification)
+    other_notification = notifications(:layout_commented_kevin)
+    Notification::Bundle.add(other_notification)
+
+    email = Current.with_account(accounts(:initech)) { NotificationMailer.bundle(bundle).message }
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notifications", email.subject
+    [ email.html_part, email.text_part ].each do |part|
+      assert_includes CGI.unescapeHTML(part.body.decoded), notification.payload.title
+      assert_includes part.body.decoded, notification.payload.url
+      assert_includes part.body.decoded, other_notification.payload.url
+      assert_includes part.body.decoded, "#{user.account.slug}/notifications/settings"
+      assert_not_includes part.body.decoded, "#{accounts(:initech).slug}/"
+    end
+  end
+end
