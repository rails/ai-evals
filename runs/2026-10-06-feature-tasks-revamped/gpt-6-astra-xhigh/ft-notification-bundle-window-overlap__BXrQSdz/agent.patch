diff --git a/test/jobs/notification/bundle/deliver_job_test.rb b/test/jobs/notification/bundle/deliver_job_test.rb
new file mode 100644
index 0000000..1449a41
--- /dev/null
+++ b/test/jobs/notification/bundle/deliver_job_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Notification::Bundle::DeliverJobTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "delivers a scheduled bundle in its account context" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :every_few_hours)
+    bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_emails 1 do
+        perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+      end
+    end
+
+    assert_not_nil bundle.reload.processed_at
+    assert_includes ActionMailer::Base.deliveries.last.html_part.body.decoded, "#{user.account.slug}/notifications/settings"
+  end
+
+  test "discard a delivery when its bundle has been deleted" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+    bundle.destroy!
+
+    assert_no_emails do
+      perform_enqueued_jobs only: Notification::Bundle::DeliverJob
+    end
+  end
+end
