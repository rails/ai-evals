@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notification::BundlableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+  end
+
+  test "new notifications join a bundle" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+      assert_equal [ notification ], @user.notification_bundles.sole.notifications.to_a
+    end
+  end
+
+  test "new activity on an existing notification joins a bundle" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_difference "Notification::Bundle.count", 1 do
+      notification.update!(source: events(:logo_published))
+    end
+
+    assert_equal [ notification ], @user.notification_bundles.sole.notifications.to_a
+  end
+
+  test "reading and unreading do not open windows" do
+    assert_no_difference "Notification::Bundle.count" do
+      notifications(:logo_assignment_kevin).read
+      notifications(:logo_assignment_kevin).unread
+    end
+  end
+end
diff --git a/test/models/notification/bundle/concurrency_test.rb b/test/models/notification/bundle/concurrency_test.rb
new file mode 100644
index 0000000..bc17721
--- /dev/null
+++ b/test/models/notification/bundle/concurrency_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Notification::Bundle::ConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification_ids = @user.notifications.pluck(:id)
+  end
+
+  teardown do
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: :never)
+  end
+
+  test "simultaneous first arrivals open only one window" do
+    assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+      bundles = concurrently_add(@notification_ids)
+      assert_equal 1, bundles.map(&:id).uniq.size
+    end
+
+    bundle = @user.notification_bundles.sole
+    assert_equal @notification_ids.sort, bundle.notifications.pluck(:id).sort
+  end
+
+  test "simultaneous arrivals at the deadline open only one nonoverlapping window" do
+    first = Notification::Bundle.add(@user.notifications.first)
+
+    travel_to first.ends_at, with_usec: true do
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliverJob do
+        bundles = concurrently_add(@notification_ids)
+        assert_equal 1, bundles.map(&:id).uniq.size
+        assert_equal first.ends_at, bundles.first.starts_at
+      end
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "simultaneous delivery attempts send only one email" do
+    bundle = Notification::Bundle.add(@user.notifications.first)
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_emails 1 do
+        3.times.map do
+          Thread.new do
+            ActiveRecord::Base.connection_pool.with_connection do
+              Notification::Bundle.find(bundle.id).deliver
+            end
+          end
+        end.map(&:value)
+      end
+    end
+
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  private
+    def concurrently_add(notification_ids)
+      ready = Queue.new
+      start = Queue.new
+
+      threads = notification_ids.map do |id|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            notification = Notification.find(id)
+            ready << true
+            start.pop
+            Current.with_account(notification.account) { Notification::Bundle.add(notification) }
+          end
+        end
+      end
+
+      threads.size.times { ready.pop }
+      threads.size.times { start << true }
+      threads.map(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..05f5f12
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "the first notification opens a window and schedules one email" do
+    freeze_time do
+      assert_enqueued_with job: Notification::Bundle::DeliverJob, at: 4.hours.from_now do
+        bundle = Notification::Bundle.add(@notification)
+
+        assert_equal Time.current, bundle.starts_at
+        assert_equal 4.hours.from_now, bundle.ends_at
+        assert_equal [ @notification ], bundle.notifications.to_a
+      end
+    end
+  end
+
+  test "late notifications join the open window without moving its deadline" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      deadline = bundle.ends_at
+      late_notification = notifications(:layout_commented_kevin)
+      late_notification.update_columns(created_at: 2.days.ago, updated_at: 1.day.ago)
+
+      travel 1.hour
+
+      assert_no_difference "Notification::Bundle.count" do
+        assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+          assert_equal bundle, Notification::Bundle.add(late_notification)
+        end
+      end
+
+      assert_equal [ @notification, late_notification ].sort_by(&:id), bundle.notifications.order(:id).to_a
+      assert_equal deadline, bundle.reload.ends_at
+    end
+  end
+
+  test "a notification at the deadline opens a nonoverlapping window" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification)
+      travel_to first.ends_at
+      second = Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+      assert_not_equal first, second
+      assert_equal first.ends_at, second.starts_at
+      assert_equal second.starts_at + 4.hours, second.ends_at
+    end
+  end
+
+  { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+    test "#{frequency} uses the recipient's frequency" do
+      freeze_time do
+        @user.settings.update!(bundle_email_frequency: frequency)
+        bundle = Notification::Bundle.add(@notification)
+
+        assert_equal Time.current, bundle.starts_at
+        assert_equal Time.current + interval, bundle.ends_at
+      end
+    end
+  end
+
+  test "off does not create a window or schedule delivery" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        assert_nil Notification::Bundle.add(@notification)
+      end
+    end
+  end
+
+  test "duplicate arrivals do not duplicate memberships or deliveries" do
+    bundle = Notification::Bundle.add(@notification)
+
+    assert_no_difference [ "Notification::Bundle.count", "Notification::Bundle::Membership.count" ] do
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliverJob do
+        assert_equal bundle, Notification::Bundle.add(@notification.reload)
+      end
+    end
+  end
+
+  test "users have independent windows and frequencies" do
+    users(:david).settings.update!(bundle_email_frequency: :weekly)
+
+    freeze_time do
+      kevin_bundle = Notification::Bundle.add(@notification)
+      david_bundle = Notification::Bundle.add(notifications(:logo_mentioned_david))
+
+      assert_not_equal kevin_bundle, david_bundle
+      assert_equal @user, kevin_bundle.user
+      assert_equal users(:david), david_bundle.user
+      assert_equal 4.hours.from_now, kevin_bundle.ends_at
+      assert_equal 1.week.from_now, david_bundle.ends_at
+    end
+  end
+
+  test "frequency changes apply to the next window without overlapping" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification)
+      deadline = first.ends_at
+      travel 1.hour
+      @user.settings.update!(bundle_email_frequency: :weekly)
+
+      assert_equal first, Notification::Bundle.add(notifications(:layout_commented_kevin))
+      assert_equal deadline, first.reload.ends_at
+
+      travel_to deadline
+      second = Notification::Bundle.add(@notification)
+      assert_equal first.ends_at, second.starts_at
+      assert_equal 1.week.from_now, second.ends_at
+    end
+  end
+
+  test "a new window starts at the next arrival rather than the previous deadline" do
+    first = Notification::Bundle.add(@notification)
+
+    travel_to first.ends_at + 2.days do
+      second = Notification::Bundle.add(@notification)
+      assert_equal Time.current, second.starts_at
+      assert_equal 4.hours.from_now, second.ends_at
+    end
+  end
+
+  test "delivery sends one email for the window and is idempotent" do
+    bundle = Notification::Bundle.add(@notification)
+    Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+    assert_no_emails { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_emails 1 do
+        bundle.deliver
+        Notification::Bundle.find(bundle.id).deliver
+      end
+      assert_equal Time.current, bundle.reload.processed_at
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.html_part.body.decoded, @notification.payload.url
+    assert_includes email.html_part.body.decoded, notifications(:layout_commented_kevin).payload.url
+  end
+
+  test "opting out suppresses an already scheduled email" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "inactive recipients do not receive scheduled emails" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.deactivate
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "removed notifications do not result in an empty email" do
+    bundle = Notification::Bundle.add(@notification)
+    @notification.destroy!
+
+    assert_empty bundle.notifications.reload
+    travel_to bundle.ends_at, with_usec: true do
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+
+  test "system activity and inactive users do not open windows" do
+    @notification.creator = users(:system)
+    assert_nil Notification::Bundle.add(@notification)
+
+    @notification.creator = users(:david)
+    @user.deactivate
+    assert_nil Notification::Bundle.add(@notification)
+    assert_empty @user.notification_bundles
+  end
+
+  test "failed deliveries can be retried" do
+    bundle = Notification::Bundle.add(@notification)
+
+    travel_to bundle.ends_at, with_usec: true do
+      NotificationMailer.expects(:bundle).with(bundle).raises(IOError).once
+      assert_raises(IOError) { bundle.deliver }
+      assert_nil bundle.reload.processed_at
+    end
+  end
+
+  test "cancelled accounts neither open windows nor receive pending digests" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.account.create_cancellation!(initiated_by: @user)
+
+    travel_to bundle.ends_at, with_usec: true do
+      assert_nil Notification::Bundle.add(notifications(:layout_commented_kevin))
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.processed_at
+    end
+  end
+end
