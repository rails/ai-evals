new file mode 100644
index 0000000..50dae2f
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,38 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[pending processing completed failed].index_by(&:itself)
+
+  def restore_later
+    Current.without_account { Account::Import::RestoreJob.perform_later(self) }
+  end
+
+  def restore_now
+    with_lock do
+      if pending?
+        importer = Account::DataTransfer::Importer.new(file.blob, identity: identity)
+        begin
+          transaction(requires_new: true) do
+            update! status: :processing
+            update! account: importer.restore, status: :completed
+          end
+        rescue StandardError => exception
+          importer.cleanup
+          Rails.logger.error("Account import #{id} failed: #{exception.class}: #{exception.message}")
+          reason = if exception.is_a?(Account::DataTransfer::InvalidArchive)
+            exception.message
+          elsif exception.is_a?(ActiveRecord::RecordInvalid)
+            exception.record.errors.full_messages.to_sentence
+          else
+            "The archive is damaged or incomplete (#{exception.class.name.demodulize}). Please upload a complete Fizzy account export."
+          end
+          update! status: :failed, account: nil, error: reason
+        end
+        Current.without_account { DataTransferMailer.import_finished(self).deliver_later }
+      end
+    end
+    file.purge if completed? || failed?
+  end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
