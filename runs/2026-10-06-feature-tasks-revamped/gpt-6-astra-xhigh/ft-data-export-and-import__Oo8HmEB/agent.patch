+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "account exports can be imported without changing the source account" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "account")
+    export.build_now
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    source = accounts(:"37s")
+    source_cards = source.cards.count
+    import = Account::Import.create!(identity: identities(:david))
+    export.file.blob.open do |file|
+      import.file.attach(io: file, filename: "account.zip", content_type: "application/zip")
+    end
+
+    assert_difference "Account.count", 1 do
+      import.restore_now
+    end
+
+    assert import.reload.completed?, import.error
+    assert_not_equal source, import.account
+    assert_equal source_cards, import.account.cards.count
+    assert_equal source_cards, source.cards.count
+    assert_equal users(:david).attributes, users(:david).reload.attributes
+    import.account.users.find_each do |user|
+      user.filters.each do |filter|
+        assert_equal Filter.digest_params(filter.as_params), filter.params_digest
+      end
+    end
+    assert_no_difference "Account.count" do
+      assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        import.restore_now
+      end
+    end
+    assert_equal source.boards.count, import.account.boards.count
+    assert import.account.users.find_by!(identity: identities(:david)).owner?
+    assert_equal source.cards.order(:number).pluck(:title), import.account.cards.order(:number).pluck(:title)
+  end
+
+  test "an importer without a membership becomes the owner and can access every board" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+    export.build_now
+    identity = Identity.create!(email_address: "new-account-owner@example.com")
+    import = Account::Import.create!(identity: identity)
+    Current.without_account do
+      export.file.blob.open do |file|
+        import.file.attach(io: file, filename: "account.zip", content_type: "application/zip")
+      end
+      import.restore_now
+    end
+
+    assert import.reload.completed?, import.error
+    owner = import.account.users.find_by!(identity: identity)
+    assert owner.owner?
+    assert owner.settings
+    assert_equal import.account.boards.ids.sort, owner.boards.ids.sort
+    assert_equal [ import.account ], identity.accounts.to_a
+    assert_equal accounts(:"37s").users.count + 1, import.account.users.count
+  end
+
+  test "a malformed import leaves no account behind and records a useful failure" do
+    import = Account::Import.create!(identity: identities(:david))
+    import.file.attach(io: StringIO.new("not a zip"), filename: "bad.zip")
+
+    assert_no_difference "Account.count" do
+      import.restore_now
+    end
+
+    assert import.reload.failed?
+    assert import.error.present?
+    assert_nil import.account
+  end
+end
