+class CreateDataTransfers < ActiveRecord::Migration[8.2]
+  def change
+    create_table :exports, id: :uuid do |t|
+      t.belongs_to :account, type: :uuid, null: false
+      t.belongs_to :user, type: :uuid, null: false
+      t.string :kind, null: false
+      t.string :status, null: false, default: "pending"
+      t.datetime :expires_at
+      t.timestamps
+    end
+
+    create_table :account_imports, id: :uuid do |t|
+      t.belongs_to :identity, type: :uuid, null: false
+      t.belongs_to :account, type: :uuid
+      t.string :status, null: false, default: "pending"
+      t.text :error
+      t.timestamps
+    end
+
+    # An import belongs to an identity, before it has an account to restore into.
+    change_column_null :active_storage_blobs, :account_id, true
+    change_column_null :active_storage_attachments, :account_id, true
+  end
+end
