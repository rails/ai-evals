diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..2515095
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,236 @@
+class Account::DataTransfer::Importer
+  include Account::DataTransfer
+
+  attr_reader :account
+
+  def initialize(file, identity:)
+    @file, @identity = file, identity
+    @ids, @uploaded_blobs = {}, []
+    @sets = []
+    Manifest.new(nil).each_record_set { |set| @sets << set unless set.is_a?(ActiveStorage::FileRecordSet) }
+    @models = @sets.map(&:model).index_by(&:name)
+  end
+
+  # The caller wraps this in the same transaction as the import's completion.
+  def restore
+    @zip = ZipFile::Reader.new(@file)
+    read_manifest
+    create_account
+    Current.with(account: account, user: nil) do
+      @sets.each do |set|
+        next if set.model == ::Account
+        paths_for(set.model).each { |path| restore_record(set.model, @zip.read_json(path), path) }
+      end
+      restore_owner
+      rebuild_derived_data
+    end
+    account
+  end
+
+  # Database rollback doesn't roll back object storage. Delete every key we
+  # attempted to upload, including a partially uploaded file.
+  def cleanup
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+  end
+
+  private
+    def read_manifest
+      manifest = @zip.read_json("manifest.json")
+      unless manifest.is_a?(Hash) && manifest["format"] == "fizzy-account" && manifest["version"] == VERSION && manifest["tables"].is_a?(Hash)
+        raise InvalidArchive, "This is not a supported Fizzy account export"
+      end
+      tables = @sets.map { |set| set.model.table_name }
+      raise InvalidArchive, "The archive contains unknown record types" if (manifest["tables"].keys - tables).any?
+
+      @sets.each do |set|
+        model = set.model
+        paths = paths_for(model)
+        unless paths.size == manifest["tables"].fetch(model.table_name, 0)
+          raise InvalidArchive, "Missing records in #{model.table_name}"
+        end
+        @ids[model.name] = paths.to_h do |path|
+          old_id = File.basename(path, ".json")
+          unless path == "#{model.table_name}/#{old_id}.json" && old_id.match?(/\A[0-9a-z]{25}\z/)
+            raise InvalidArchive, "Invalid record path: #{path}"
+          end
+          [ old_id, ::ActiveRecord::Type::Uuid.generate ]
+        end
+      end
+      raise InvalidArchive, "The archive must contain one account" unless paths_for(::Account).one?
+    end
+
+    def paths_for(model)
+      @zip.glob("#{model.table_name}/*.json")
+    end
+
+    def create_account
+      data = @zip.read_json(paths_for(::Account).first)
+      @source_account_id = data.fetch("id")
+      @source_cards_count = data.fetch("cards_count", 0).to_i
+      @account = ::Account.create!(name: data.fetch("name"))
+      @ids.fetch("Account").fetch(@source_account_id)
+      @ids["Account"][@source_account_id] = account.id
+      # The archive supplies the account's original entropy settings.
+      account.entropy.delete
+    end
+
+    def restore_record(model, data, path)
+      unless data.is_a?(Hash) && path == "#{model.table_name}/#{data['id']}.json" && data["account_id"] == @source_account_id
+        raise InvalidArchive, "Invalid record or account in #{path}"
+      end
+      model.defined_enums.each do |name, values|
+        raise InvalidArchive, "Invalid #{name} in #{path}" unless values.key?(data[name])
+      end
+      attributes = data.slice(*model.column_names)
+      attributes["id"] = mapped_id(model.name, data.fetch("id"))
+      remap_associations(model, attributes)
+      case model.name
+      when "User" then restore_identity(attributes, data)
+      when "ActiveStorage::Blob" then return restore_blob(attributes, data)
+      when "ActionText::RichText" then restore_rich_text(attributes)
+      when "ActiveStorage::Attachment" then validate_attachment(attributes)
+      when "Board::Publication" then attributes["key"] = SecureRandom.base58(24)
+      when "Webhook" then attributes["active"] = false
+      when "Notification::Bundle" then attributes["status"] = "delivered"
+      when "Filter" then remap_filter_fields(attributes)
+      when "Event" then remap_event_particulars(attributes)
+      end
+      model.insert!(attributes)
+      restore_filter_resources(attributes["id"], data["resources"]) if model == ::Filter
+    end
+
+    def remap_associations(model, attributes)
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        next if association.name == :identity
+        foreign_key = association.foreign_key
+        if attributes[foreign_key].present?
+          type = association.polymorphic? ? attributes[association.foreign_type] : association.klass.name
+          attributes[foreign_key] = mapped_id(type, attributes[foreign_key])
+        end
+      end
+    end
+
+    def mapped_id(type, id)
+      @ids.fetch(type).fetch(id)
+    rescue KeyError
+      raise InvalidArchive, "Missing #{type} reference: #{id}"
+    end
+
+    def restore_identity(attributes, data)
+      attributes.delete("identity_id")
+      if data["email_address"].present?
+        identity = ::Identity.find_or_create_by!(email_address: data["email_address"].strip.downcase)
+        attributes["identity_id"] = identity.id
+      end
+      unless ::User.roles.key?(attributes["role"])
+        raise InvalidArchive, "Invalid role for #{attributes['name']}"
+      end
+      # Ownership belongs to the person performing the import, not an archived
+      # identity. Existing identities and their credentials are never changed.
+      attributes["role"] = "admin" if attributes["role"] == "owner"
+    end
+
+    def restore_blob(attributes, data)
+      attributes["key"] = ::ActiveStorage::Blob.generate_unique_secure_token
+      attributes["service_name"] = ::ActiveStorage::Blob.service.name
+      ::ActiveStorage::Blob.insert!(attributes)
+      blob = ::ActiveStorage::Blob.find(attributes["id"])
+      @uploaded_blobs << blob
+      path = "files/#{data.fetch('id')}/#{::ActiveStorage::Filename.new(data.fetch('filename'))}"
+      if ZipFile.s3_service?(blob.service)
+        restore_s3_file(blob, path)
+      else
+        restore_disk_file(blob, path)
+      end
+    end
+
+    def restore_s3_file(blob, path)
+      size, digest = 0, Digest::MD5.new
+      blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes) do |stream|
+        stream.binmode
+        @zip.each_chunk(path) do |chunk|
+          size += chunk.bytesize
+          digest.update(chunk)
+          stream.write(chunk)
+        end
+      end
+      unless size == blob.byte_size && Base64.strict_encode64(digest.digest) == blob.checksum
+        raise InvalidArchive, "File checksum does not match: #{blob.filename}"
+      end
+    end
+
+    def restore_disk_file(blob, path)
+      @zip.open(path) do |file|
+        unless file.size == blob.byte_size && Base64.strict_encode64(Digest::MD5.file(file.path).digest) == blob.checksum
+          raise InvalidArchive, "File checksum does not match: #{blob.filename}"
+        end
+        blob.service.upload(blob.key, file, checksum: blob.checksum)
+      end
+    end
+
+    def restore_rich_text(attributes)
+      model = @models.fetch(attributes["record_type"])
+      unless model.reflect_on_association("rich_text_#{attributes['name']}")
+        raise InvalidArchive, "Unknown rich text field"
+      end
+      attributes["body"] = RichText.restore(attributes["body"]) do |type, id|
+        @models.fetch(type).find(mapped_id(type, id))
+      end
+    end
+
+    def validate_attachment(attributes)
+      model = @models.fetch(attributes["record_type"])
+      unless model.respond_to?(:reflect_on_attachment) && model.reflect_on_attachment(attributes["name"])
+        raise InvalidArchive, "Unknown attachment field"
+      end
+    end
+
+    def remap_filter_fields(attributes)
+      fields = attributes["fields"] || {}
+      fields["card_ids"] = Array(fields["card_ids"]).map { |id| mapped_id("Card", id) } if fields.key?("card_ids")
+      fields["column_ids"] = Array(fields["column_ids"]).map { |id| mapped_id("Column", id) } if fields.key?("column_ids")
+    end
+
+    def restore_filter_resources(id, resources)
+      filter = ::Filter.find(id)
+      (resources || {}).each do |name, ids|
+        association = ::Filter.reflect_on_all_associations(:has_and_belongs_to_many).find { |reflection| reflection.name.to_s == name }
+        raise InvalidArchive, "Unknown filter resource" unless association
+        filter.public_send("#{association.name.to_s.singularize}_ids=", ids.map { |old_id| mapped_id(association.klass.name, old_id) })
+      end
+      filter.update_columns(params_digest: ::Filter.digest_params(filter.as_params))
+    end
+
+    def remap_event_particulars(attributes)
+      particulars = attributes["particulars"] || {}
+      if particulars["assignee_ids"]
+        particulars["assignee_ids"] = particulars["assignee_ids"].map { |id| mapped_id("User", id) }
+      end
+    end
+
+    def restore_owner
+      owner = account.users.find_by(identity: @identity)
+      if owner
+        owner.update_columns(role: "owner", active: true, verified_at: Time.current)
+      else
+        owner = account.users.create!(identity: @identity, name: @identity.email_address, role: :owner, verified_at: Time.current)
+      end
+      account.boards.find_each do |board|
+        board.accesses.find_or_create_by!(user: owner)
+      end
+      raise InvalidArchive, "The account is missing its system user" unless account.users.exists?(role: :system)
+      account.update!(cards_count: [ @source_cards_count, account.cards.maximum(:number) || 0 ].max)
+      account.create_entropy!(auto_postpone_period: Account::DEFAULT_ENTROPY_PERIOD, account: account) unless account.reload.entropy
+    end
+
+    def rebuild_derived_data
+      account.cards.find_each(&:reindex)
+      ::Comment.where(account: account).find_each(&:reindex)
+      account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+      account.reconcile_storage
+      account.materialize_storage
+    end
+end
