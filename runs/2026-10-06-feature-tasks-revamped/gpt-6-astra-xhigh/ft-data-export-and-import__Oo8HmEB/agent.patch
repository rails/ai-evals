@@ -0,0 +1,22 @@
+class Account::ImportsController < ApplicationController
+  layout "public"
+  disallow_account_scope
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Account::Import.new(identity: Current.identity)
+    upload = params.dig(:account_import, :file)
+    if upload.respond_to?(:original_filename) && upload.original_filename.downcase.end_with?(".zip")
+      @import.file.attach(upload)
+      @import.save!
+      @import.restore_later
+      redirect_to new_account_import_path, notice: "Your import has started. We'll email you when it's complete, or if it fails."
+    else
+      @import.errors.add(:file, "must be a Fizzy account ZIP export")
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
