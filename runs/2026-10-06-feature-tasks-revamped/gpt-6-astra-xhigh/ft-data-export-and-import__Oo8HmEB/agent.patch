new file mode 100644
index 0000000..579e498
--- /dev/null
+++ b/app/models/account/data_transfer/card_export.rb
@@ -0,0 +1,45 @@
+class Account::DataTransfer::CardExport
+  def initialize(cards)
+    @cards = cards
+  end
+
+  def write_to(zip, directory: "cards")
+    @cards.find_each do |card|
+      files = card.attachments.map(&:blob).index_by(&:id)
+      files[card.image.blob.id] = card.image.blob if card.image.attached?
+      write_card(zip, card, files, directory)
+      write_files(zip, files.values)
+    end
+  end
+
+  private
+    def write_card(zip, card, files, directory)
+      data = card.attributes.merge(
+        "description" => Account::DataTransfer::RichText.export(card.description.body),
+        "creator" => card.creator.name
+      )
+      zip.add_file("#{directory}/#{card.number}.json") do |sink|
+        sink.write(data.to_json.delete_suffix("}"))
+        sink.write(',"comments":[')
+        first = true
+        card.comments.reorder(nil).find_each do |comment|
+          comment.attachments.each { |attachment| files[attachment.blob_id] = attachment.blob }
+          sink.write(",") unless first
+          sink.write(comment.attributes.merge("body" => Account::DataTransfer::RichText.export(comment.body.body), "creator" => comment.creator.name).to_json)
+          first = false
+        end
+        sink.write('],"attachments":')
+        sink.write(files.values.map { |blob| { filename: blob.filename.to_s, path: Account::DataTransfer.file_path(blob) } }.to_json)
+        sink.write("}")
+      end
+    end
+
+    def write_files(zip, files)
+      files.each do |blob|
+        path = Account::DataTransfer.file_path(blob)
+        unless zip.exists?(path)
+          zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+      end
+    end
+end
