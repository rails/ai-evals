+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  test "personal export contains visible cards and comments, but not private or foreign cards or other people's drafts" do
+    Current.user = users(:kevin)
+    boards(:private).cards.create!(title: "Private secret", creator: users(:kevin), status: :published)
+    boards(:writebook).cards.create!(title: "Someone else's draft", creator: users(:kevin), status: :drafted)
+    draft = boards(:writebook).cards.create!(title: "My draft", creator: users(:david), status: :drafted)
+    export = Export.create!(account: accounts(:"37s"), user: users(:david), kind: :cards)
+
+    assert_enqueued_with job: ActionMailer::MailDeliveryJob do
+      export.build_now
+    end
+    reader = ZipFile::Reader.new(export.file.blob)
+    data = reader.glob("cards/*.json").map { |path| reader.read_json(path) }
+    assert_equal [ *users(:david).accessible_cards.published.ids, draft.id ].sort, data.pluck("id").sort
+    assert_equal cards(:logo).comments.count, data.find { |card| card["id"] == cards(:logo).id }["comments"].size
+    assert_equal [], reader.glob("users/*.json")
+    assert_equal [], reader.glob("manifest.json")
+
+    assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      export.build_now
+    end
+  end
+
+  test "permissions are checked again when a queued export runs" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:kevin), kind: :account)
+    users(:kevin).update!(role: :member)
+    assert_raises(ActiveRecord::RecordNotFound) { export.build_now }
+    assert_not export.reload.file.attached?
+  end
+
+  test "completed exports are cleaned up after their download expires" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:david), kind: :cards)
+    export.build_now
+    travel_to export.expires_at + 1.second do
+      Export::CleanupJob.perform_now(export)
+      assert_not export.file.attached?
+    end
+  end
+end
diff --git a/test/models/zip_file_reader_test.rb b/test/models/zip_file_reader_test.rb
new file mode 100644
index 0000000..cfd24d1
--- /dev/null
+++ b/test/models/zip_file_reader_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "writer records exact byte size and checksum and reader verifies the contents" do
+    export = create_archive do |writer|
+      writer.add_file("data.json", { hello: "world" }.to_json)
+      writer.add_file("binary.dat", "\x00\xff\x00".b, compress: false)
+      writer.add_file("empty", "", compress: false)
+    end
+    export.file.blob.expects(:download).never
+    reader = ZipFile::Reader.new(export.file.blob)
+    assert_equal({ "hello" => "world" }, reader.read_json("data.json"))
+    reader.open("binary.dat") { |file| assert_equal "\x00\xff\x00".b, file.read }
+    reader.open("empty") { |file| assert_equal "", file.read }
+  end
+
+  test "unsafe and duplicate paths are rejected" do
+    [ "../data.json", "/data.json", "folder/../../data.json", "folder\\data.json" ].each do |path|
+      safe_path = "x" * path.bytesize
+      export = create_archive { |writer| writer.add_file(safe_path, "{}") }
+      # ZipKit sanitizes writer paths, so forge both headers to test untrusted input.
+      data = export.file.download.gsub(safe_path, path)
+      export.file.blob.service.upload(export.file.blob.key, StringIO.new(data))
+      assert_raises(Account::DataTransfer::InvalidArchive) { ZipFile::Reader.new(export.file.blob) }
+    end
+    export = create_archive do |writer|
+      writer.add_file("data.json", "{}")
+      writer.add_file("copy.json", "{}")
+    end
+    data = export.file.download.gsub("copy.json", "data.json")
+    export.file.blob.service.upload(export.file.blob.key, StringIO.new(data))
+    assert_raises(Account::DataTransfer::InvalidArchive) { ZipFile::Reader.new(export.file.blob) }
+  end
+
+  test "bad file checksums are rejected even with a valid central directory" do
+    export = create_archive { |writer| writer.add_file("data.json", '{"value":"original"}', compress: false) }
+    data = export.file.download.sub("original", "tampered")
+    export.file.blob.service.upload(export.file.blob.key, StringIO.new(data))
+    assert_raises(Account::DataTransfer::InvalidArchive) { ZipFile::Reader.new(export.file.blob).read_json("data.json") }
+  end
+
+  test "archives can be built using the S3 multipart streaming path" do
+    with_streaming_service do
+      export = create_archive { |writer| writer.add_file("data.json", { hello: "stream" }.to_json) }
+      assert_equal export.file.download.bytesize, export.file.byte_size
+      assert_equal Base64.strict_encode64(Digest::MD5.digest(export.file.download)), export.file.checksum
+      assert_equal({ "hello" => "stream" }, ZipFile::Reader.new(export.file.blob).read_json("data.json"))
+    end
+  end
+
+  private
+    def create_archive
+      export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: :account)
+      ZipFile.create_for(export.file, filename: "test.zip") do |writer|
+        yield writer
+      end
+      export
+    end
+
+    def with_streaming_service
+      service = ActiveStorage::Blob.service
+      ZipFile.stubs(:s3_service?).with(service).returns(true)
+      service.define_singleton_method(:upload_stream) do |key:, **options, &block|
+        stream = StringIO.new("".b)
+        block.call(stream)
+        stream.rewind
+        upload(key, stream)
+      end
+      yield
+    ensure
+      service.singleton_class.remove_method(:upload_stream)
+    end
+end
