--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,59 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[account cards].index_by(&:itself), suffix: true
+  enum :status, %w[pending processing completed failed].index_by(&:itself)
+
+  validates :kind, presence: true
+  validate :user_belongs_to_account
+
+  def build_later
+    Export::BuildJob.perform_later(self)
+  end
+
+  def build_now
+    generated_blob = nil
+    with_lock do
+      if pending?
+        raise ActiveRecord::RecordNotFound unless user.active? && account.active?
+        raise ActiveRecord::RecordNotFound if account_kind? && !user.admin?
+
+        update! status: :processing
+        Current.with(account: account, user: user) do
+          generated_blob = ZipFile.create_for(file, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            if account_kind?
+              Account::DataTransfer::Manifest.new(account).export_to(zip)
+            end
+            Account::DataTransfer::CardExport.new(exported_cards).write_to(zip, directory: account_kind? ? "readable/cards" : "cards")
+          end
+        end
+        update! status: :completed, expires_at: 1.day.from_now
+        DataTransferMailer.export_ready(self).deliver_later
+        Export::CleanupJob.set(wait_until: expires_at).perform_later(self)
+      end
+    end
+  rescue StandardError
+    generated_blob&.purge
+    update! status: :failed
+    raise
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  def downloadable?
+    completed? && expires_at&.future? && file.attached?
+  end
+
+  private
+    def user_belongs_to_account
+      errors.add(:user, "must belong to this account") if user && user.account_id != account_id
+    end
+
+    def exported_cards
+      account_kind? ? account.cards : user.accessible_cards.where(status: "published").or(user.accessible_cards.where(creator: user, status: "drafted"))
+    end
+end
