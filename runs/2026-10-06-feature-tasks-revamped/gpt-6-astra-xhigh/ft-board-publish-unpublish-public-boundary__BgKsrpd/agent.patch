diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..13b14b4
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anonymous visitors can see the board and its public links" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain))
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "a publication also grants public access to a private board" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication.key)
+    assert_response :success
+    assert_select "h1", text: board.name
+  end
+
+  test "signed in visitors from another account can read public boards" do
+    sign_in_as :mike
+
+    get public_board_path(@key)
+    assert_response :success
+  end
+
+  test "drafts are not listed" do
+    cards(:buy_domain).drafted!
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:buy_domain)), count: 0
+  end
+
+  test "public pages do not leak their secret URLs to external sites or search engines" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "unpublishing revokes access even with a previously valid ETag" do
+    paths = [ public_board_path(@key), public_board_column_path(@key, columns(:writebook_triage)), public_board_card_path(@key, cards(:logo)) ]
+    etags = paths.to_h do |path|
+      get path
+      assert_response :success
+      [ path, response.headers["ETag"] ]
+    end
+
+    @board.unpublish
+
+    etags.each do |path, etag|
+      get path, headers: { "If-None-Match" => etag }
+      assert_response :not_found
+    end
+  end
+
+  test "cancelled accounts cannot share public boards" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    get public_board_path(@key)
+    assert_response :not_found
+  end
+
+  test "public boards paginate using public URLs" do
+    with_current_user(:david) do
+      60.times do |index|
+        @board.cards.create!(title: "Public card #{index}", status: :published)
+      end
+    end
+
+    get public_board_path(@key)
+    assert_response :success
+    next_page = css_select("a.pagination-link").first["href"]
+    assert_includes next_page, public_board_path(@key)
+
+    get next_page
+    assert_response :success
+    assert_select "a.card__link[href^=?]", "#{public_board_path(@key)}/cards/"
+  end
+
+  test "unknown keys and board IDs are not public keys" do
+    [ "unknown", @board.id ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "publications cannot be used under another account" do
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes all public pages and old URLs stay revoked after republishing" do
+    paths = [ public_board_path(@key), public_board_column_path(@key, columns(:writebook_triage)), public_board_card_path(@key, cards(:logo)) ]
+    @board.unpublish
+    @board.publish
+
+    paths.each do |path|
+      get path
+      assert_response :not_found
+    end
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..69d7ac9
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are unpublished by default" do
+    assert_not boards(:writebook).published?
+  end
+
+  test "publish creates a unique secret key and is idempotent" do
+    board = boards(:writebook)
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      board.publish
+      board.publish
+    end
+
+    assert board.published?
+    assert_equal board.account, board.publication.account
+    assert_operator board.publication.key.length, :>=, 24
+
+    boards(:private).publish
+    assert_not_equal board.publication.key, boards(:private).publication.key
+  end
+
+  test "unpublish revokes the key and republishing creates a new one" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.unpublish
+      board.unpublish
+    end
+
+    assert_not board.published?
+    assert_nil Board::Publication.find_by(key: key)
+
+    board.publish
+    assert_not_equal key, board.publication.key
+  end
+
+  test "destroying a board destroys its publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.destroy!
+    end
+  end
+end
