new file mode 100644
index 0000000..98b21c1
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,23 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    with_lock do
+      publication || create_publication!
+    end
+  end
+
+  def unpublish
+    with_lock do
+      self.publication = nil
+    end
+  end
+end
