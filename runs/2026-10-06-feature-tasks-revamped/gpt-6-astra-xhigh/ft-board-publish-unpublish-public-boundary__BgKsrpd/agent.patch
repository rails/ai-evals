+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anonymous visitors can read published cards by number" do
+    card = cards(:logo)
+    card.update!(description: "Public description")
+
+    get public_board_card_path(@key, card.number)
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_select ".lexxy-content", text: /Public description/
+    assert_select "a[href=?]", public_board_path(@key)
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "cards display images and read-only steps" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    card.steps.create!(content: "First step")
+    card.steps.create!(content: "Done step", completed: true)
+
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select "li", text: "○ First step"
+    assert_select "li", text: "✓ Done step"
+    assert_select "img[src*=?]", "moon.jpg"
+    assert_select "form, input, textarea", count: 0
+  end
+
+  test "closed and postponed cards remain accessible" do
+    cards(:logo).close(user: users(:david))
+    cards(:text).postpone(user: users(:david))
+
+    [ cards(:logo), cards(:text) ].each do |card|
+      get public_board_card_path(@key, card)
+      assert_response :success
+      assert_select "h1", text: card.title
+    end
+  end
+
+  test "signed in users without board access see only the public card" do
+    sign_in_as :mike
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :success
+    assert_select "form, textarea", count: 0
+  end
+
+  test "public URLs cannot modify cards" do
+    patch public_board_card_path(@key, cards(:logo)), params: { card: { title: "Changed" } }
+    assert_response :not_found
+    assert_not_equal "Changed", cards(:logo).reload.title
+  end
+
+  test "drafts cannot be opened directly" do
+    cards(:logo).drafted!
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "cards must belong to the published board" do
+    with_current_user(:david) do
+      cards(:logo).update!(board: boards(:private))
+    end
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "unknown keys and card numbers return not found" do
+    get public_board_card_path("unknown", cards(:logo))
+    assert_response :not_found
+
+    get public_board_card_path(@key, 999999)
+    assert_response :not_found
+
+    get "#{public_board_path(@key)}/cards/#{cards(:logo).id}"
+    assert_response :not_found
+  end
+end
