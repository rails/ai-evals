diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..7f26c3f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,54 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }).find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if cancelled? && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+        incinerate_filter_resources
+        incinerate_storage_totals
+        incinerate_search_index
+        incinerate_account_records
+        delete
+      end
+    end
+  end
+
+  private
+    def incinerate_filter_resources
+      filter_ids = Filter.where(account_id: id).select(:id)
+
+      %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ].each do |table|
+        self.class.connection.delete("DELETE FROM #{self.class.connection.quote_table_name(table)} WHERE filter_id IN (#{filter_ids.to_sql})")
+      end
+    end
+
+    def incinerate_storage_totals
+      Storage::Total.where(owner: self).or(Storage::Total.where(owner_type: "Board", owner_id: boards.select(:id))).delete_all
+    end
+
+    def incinerate_search_index
+      if Fizzy.db_adapter.sqlite?
+        Search::Record::SQLite::Fts.where(rowid: Search::Record.where(account_id: id).select(:id)).delete_all
+      end
+    end
+
+    def incinerate_account_records
+      # Avoid destroy callbacks that broadcast, enqueue jobs, or create new records.
+      # Include all account-scoped tables, even records no longer reachable through associations.
+      self.class.connection_pool.with_connection do |connection|
+        connection.tables.each do |table|
+          if connection.schema_cache.columns_hash(table).key?("account_id")
+            connection.delete("DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(id_for_database)}")
+          end
+        end
+      end
+    end
 end
