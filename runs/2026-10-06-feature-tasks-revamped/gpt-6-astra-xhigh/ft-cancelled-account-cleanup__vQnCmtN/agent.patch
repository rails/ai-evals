diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..111bd22
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates all accounts cancelled more than 30 days ago" do
+    freeze_time do
+      account = accounts(:"37s")
+      other_account = accounts(:initech)
+      account.create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago - 1.second)
+      other_account.create_cancellation!(initiated_by: users(:mike), created_at: 90.days.ago)
+
+      Current.without_account do
+        assert_difference -> { Account.count }, -2 do
+          Account::IncinerateDueJob.perform_now
+        end
+      end
+
+      assert_not Account.exists?(account.id)
+      assert_not Account.exists?(other_account.id)
+      assert Account.exists?(accounts(:acme).id)
+      assert Identity.exists?(identities(:david).id)
+    end
+  end
+
+  test "retains active accounts and cancellations within or exactly at the grace period" do
+    freeze_time do
+      accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago)
+      accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 30.days.ago + 1.second)
+
+      assert_no_difference [ -> { Account.count }, -> { Account::Cancellation.count } ] do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "retains reactivated accounts" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert account.reload.active?
+  end
+
+  test "can run again after incineration" do
+    accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    Account::IncinerateDueJob.perform_now
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..f15f3ca
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+  end
+
+  test "incinerates all account-owned database records without callbacks" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+    card.image.blob.variant_records.create!(variation_digest: "variant")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt")
+    import = @account.imports.create!(identity: identities(:david), status: :completed)
+    import.file.attach(io: StringIO.new("export"), filename: "export.zip")
+    @account.materialize_storage
+    card.board.materialize_storage
+    board_ids = @account.boards.ids
+
+    # Incineration must also remove records left behind by previously deleted parents.
+    card.reindex
+    card.delete
+
+    filter = filters(:jz_assignments)
+    filter.board_ids = [ boards(:writebook).id ]
+    filter.creators << users(:david)
+    filter.closers << users(:jason)
+    connection.execute("INSERT INTO assigners_filters (filter_id, assigner_id) VALUES (#{connection.quote(filter.id_for_database)}, #{connection.quote(users(:david).id_for_database)})")
+
+    other_account = accounts(:initech)
+    other_account.users.create!(name: "David", identity: identities(:david))
+    other_total = other_account.create_storage_total!(bytes_stored: 123)
+    other_filter = Filter.create!(creator: users(:mike))
+    other_filter.assignees << users(:mike)
+    other_card = other_account.cards.published.first
+    other_card.reindex
+    Current.with_account(other_account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("keep"), filename: "keep.txt")
+    end
+    other_records = account_record_counts(other_account)
+    assert_equal @account.users.count, account_record_counts(@account).fetch("users")
+    identity_count = Identity.count
+    session_count = Session.count
+    search_ids = Search::Record.for(@account.id).where(account_id: @account.id).ids
+    assert_not_empty search_ids
+
+    Current.without_account do
+      assert_no_enqueued_jobs do
+        @account.incinerate
+      end
+    end
+
+    assert_not Account.exists?(@account.id)
+    account_record_counts(@account).each do |table, count|
+      assert_equal 0, count, "Account data remains in #{table}"
+    end
+    filter_join_tables.each do |table|
+      assert_equal 0, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE filter_id = #{connection.quote(filter.id_for_database)}"), "Filter data remains in #{table}"
+    end
+    assert_not Storage::Total.where(owner: @account).exists?
+    assert_not Storage::Total.where(owner_type: "Board", owner_id: board_ids).exists?
+    if Fizzy.db_adapter.sqlite?
+      assert_not Search::Record::SQLite::Fts.where(rowid: search_ids).exists?
+    end
+
+    assert_equal other_records, account_record_counts(other_account)
+    assert_equal 123, other_total.reload.bytes_stored
+    assert_equal [ users(:mike).id ], other_filter.reload.assignee_ids
+    assert Search::Record.for(other_account.id).where(account_id: other_account.id).exists?
+    if Fizzy.db_adapter.sqlite?
+      other_search_ids = Search::Record.where(account_id: other_account.id).select(:id)
+      assert Search::Record::SQLite::Fts.where(rowid: other_search_ids).exists?
+    end
+    assert_equal identity_count, Identity.count
+    assert_equal session_count, Session.count
+    assert Identity.exists?(identities(:david).id)
+  end
+
+  test "rechecks cancellation after an account was selected for incineration" do
+    assert @account.cancelled?
+    Account.find(@account.id).reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.active?
+  end
+
+  test "does not incinerate a newly cancelled account" do
+    @account.cancellation.update!(created_at: Time.current)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "rolls back all deletions when incineration fails" do
+    original_records = account_record_counts(@account)
+    @account.stubs(:delete).raises(ActiveRecord::StatementInvalid)
+
+    assert_raises ActiveRecord::StatementInvalid do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_equal original_records, account_record_counts(@account)
+    assert filters(:jz_assignments).reload.assignees.exists?
+  end
+
+  private
+    def connection
+      ApplicationRecord.connection
+    end
+
+    def account_record_counts(account)
+      connection.tables.filter_map do |table|
+        if connection.schema_cache.columns_hash(table).key?("account_id")
+          [ table, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id_for_database)}") ]
+        end
+      end.to_h
+    end
+
+    def filter_join_tables
+      connection.tables.select { |table| connection.schema_cache.columns_hash(table).key?("filter_id") }
+    end
+end
