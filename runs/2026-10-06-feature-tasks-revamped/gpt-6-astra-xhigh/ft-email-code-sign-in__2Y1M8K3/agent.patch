new file mode 100644
index 0000000..1c296bf
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @identity = identities(:kevin)
+    @email_code = @identity.email_codes.create!
+    @code = @email_code.code
+  end
+
+  test "generates a six-character code and stores only its digest" do
+    assert_match /\A[A-Z0-9]{6}\z/, @code
+    assert_not_equal @code, @email_code.code_digest
+    assert_nil EmailCode.find(@email_code.id).code
+    assert_in_delta 15.minutes.from_now, @email_code.expires_at, 1.second
+  end
+
+  test "consumes a code only once even with two copies of the record" do
+    other_copy = EmailCode.find(@email_code.id)
+
+    assert_equal @identity, @email_code.consume(@code)
+    assert_nil other_copy.consume(@code)
+    assert_not EmailCode.exists?(@email_code.id)
+  end
+
+  test "accepts lowercase codes with surrounding whitespace" do
+    assert_equal @identity, @email_code.consume(" #{@code.downcase}\n")
+  end
+
+  test "rejects incorrect and malformed codes without consuming the correct code" do
+    [ nil, "", "not-a-code", "X" * 100, @code.succ ].each do |code|
+      assert_nil @email_code.consume(code)
+    end
+
+    assert_equal @identity, @email_code.consume(@code)
+  end
+
+  test "works until fifteen minutes after creation" do
+    travel_to @email_code.expires_at - 1.second do
+      assert_equal @identity, @email_code.consume(@code)
+    end
+  end
+
+  test "expires at fifteen minutes" do
+    travel_to @email_code.expires_at do
+      assert_nil @email_code.consume(@code)
+      assert_not EmailCode.active.exists?(@email_code.id)
+    end
+  end
+
+  test "cleanup removes expired codes but keeps active ones" do
+    travel 15.minutes do
+      active_code = @identity.email_codes.create!
+      EmailCode.cleanup
+
+      assert_not EmailCode.exists?(@email_code.id)
+      assert EmailCode.exists?(active_code.id)
+    end
+  end
+
+  test "destroying the identity removes its codes" do
+    @identity.destroy!
+
+    assert_not EmailCode.exists?(@email_code.id)
+  end
+end
