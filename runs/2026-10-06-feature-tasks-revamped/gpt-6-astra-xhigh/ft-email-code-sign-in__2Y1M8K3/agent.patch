diff --git a/test/controllers/sessions/email_codes_controller_test.rb b/test/controllers/sessions/email_codes_controller_test.rb
new file mode 100644
index 0000000..a7af562
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time
+    @identity = identities(:kevin)
+
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+    end
+
+    @email_code = EmailCode.last
+    @code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+  end
+
+  test "invalid codes allow retrying without starting a session" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code.succ }
+      end
+      assert_response :unprocessable_entity
+      assert_select "input[name=code]"
+      assert_select "a[href=?]", new_session_path, text: "Request a new code"
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to landing_path
+    end
+  end
+
+  test "expired codes cannot authenticate" do
+    travel 15.minutes do
+      untenanted do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: @code }
+        end
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a consumed code cannot be replayed with the original pending session" do
+    pending_cookies = cookies.to_hash
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }
+      assert cookies[:session_token].present?
+
+      reset!
+      pending_cookies.each { |name, value| cookies[name] = value }
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "cannot use a code without the requesting browser session" do
+    reset!
+
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "cannot use another identity's code" do
+    other_code = identities(:david).email_codes.create!
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: other_code.code }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "verification is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @code }
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_equal "Try again later.", flash[:alert]
+      assert EmailCode.exists?(@email_code.id)
+    end
+  end
+
+  test "authenticates via JSON" do
+    untenanted do
+      post session_email_code_path, params: { code: @code }, as: :json
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+      assert_equal @identity, Session.find_signed(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "rejects invalid codes via JSON" do
+    untenanted do
+      post session_email_code_path, params: { code: @code.succ }, as: :json
+
+      assert_response :unauthorized
+      assert response.parsed_body["message"].present?
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "returns to the requested page after signing in" do
+    get board_path(boards(:writebook))
+    assert_redirected_to new_session_path(script_name: nil)
+    follow_redirect!
+
+    untenanted do
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to board_path(boards(:writebook), script_name: accounts("37s").slug)
+    end
+  end
+end
