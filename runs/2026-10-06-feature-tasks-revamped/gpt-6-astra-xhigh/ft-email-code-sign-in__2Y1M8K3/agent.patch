--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,29 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+  has_secure_password :code, validations: false, reset_token: false
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+
+  before_create :generate_code
+
+  def self.cleanup
+    where("expires_at <= ?", Time.current).delete_all
+  end
+
+  def consume(code)
+    code = code.to_s.strip.upcase
+
+    if code.length == CODE_LENGTH && authenticate_code(code) && self.class.active.where(id: id).delete_all == 1
+      identity
+    end
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      self.expires_at = EXPIRATION.from_now
+    end
+end
