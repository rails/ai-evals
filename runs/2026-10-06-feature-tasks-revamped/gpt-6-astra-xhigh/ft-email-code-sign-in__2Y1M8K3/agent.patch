+    session[:email_authentication] = {
+      "email_code_id" => email_code&.id,
+      "email_address" => email_address,
+      "signup" => signup,
+      "join_code_id" => join_code&.id,
+      "join_code" => join_code&.code,
+      "restart_url" => restart_url
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_url(script_name: nil) }
+      format.json { render json: { redirect_url: new_session_email_code_url(script_name: nil) }, status: :created }
+    end
+  end
+end
