+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in with a code delivered by email" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: identities(:kevin).email_address }
+        end
+      end
+
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ identities(:kevin).email_address ], email.to
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "Expected a six-character code in the email subject"
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to landing_path
+      assert_equal identities(:kevin), Session.find_signed(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+  test "sign up with an email code and complete account setup" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        assert_no_difference [ -> { Session.count }, -> { Account.count } ] do
+          perform_enqueued_jobs do
+            post signup_path, params: { signup: { email_address: "new@example.com" } }
+          end
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_path, text: "Request a new code"
+
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_path
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      account = Account.last
+      assert_redirected_to landing_url(script_name: account.slug)
+      assert_equal Identity.find_by!(email_address: "new@example.com"), account.users.find_by!(role: :owner).identity
+    end
+  end
+
+  test "signing up with an existing email uses the same identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: identities(:kevin).email_address } }
+        end
+      end
+
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_path
+      assert_equal identities(:kevin), Session.find_signed(parsed_cookies.signed[:session_token]).identity
+    end
+  end
+
+  test "join by email only redeems the invitation after verification" do
+    join_code = account_join_codes(:"37s")
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference [ -> { User.count }, -> { Session.count }, -> { join_code.reload.usage_count } ] do
+        request_join_code(join_code, "new@example.com")
+      end
+    end
+
+    assert_difference [ -> { User.count }, -> { Session.count }, -> { join_code.reload.usage_count } ], 1 do
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+    end
+    assert_redirected_to new_users_join_url(script_name: join_code.account.slug)
+
+    user = Identity.find_by!(email_address: "new@example.com").users.find_by!(account: join_code.account)
+    assert user.verified?
+    assert_equal "member", user.role
+    follow_redirect!
+    assert_response :success
+
+    post users_joins_path(script_name: join_code.account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_url(script_name: join_code.account.slug)
+    assert_equal "New Member", user.reload.name
+  end
+
+  test "existing members can sign in through a join code without redeeming it again" do
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference [ -> { Identity.count }, -> { User.count }, -> { join_code.reload.usage_count } ] do
+      request_join_code(join_code, identities(:jz).email_address)
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+    end
+
+    assert_redirected_to landing_url(script_name: join_code.account.slug)
+    assert_equal identities(:jz), Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "an existing identity can join another account by email" do
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference -> { Identity.count } do
+      request_join_code(join_code, identities(:mike).email_address)
+    end
+
+    assert_difference -> { User.count }, 1 do
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+    end
+    assert_redirected_to new_users_join_url(script_name: join_code.account.slug)
+    assert identities(:mike).users.find_by!(account: join_code.account).verified?
+  end
+
+  test "a signed in person can join with a different email after verifying it" do
+    sign_in_as :kevin
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:mike).email_address)
+
+    post session_email_code_path(script_name: nil), params: { code: delivered_code }
+
+    assert_redirected_to new_users_join_url(script_name: join_code.account.slug)
+    assert_equal identities(:mike), Session.find_signed(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "an exhausted join code cannot be redeemed after email verification" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, "new@example.com")
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    assert_no_difference [ -> { User.count }, -> { Session.count }, -> { join_code.reload.usage_count } ] do
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+    end
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  test "a reset join code cannot be redeemed after email verification" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, "new@example.com")
+    join_code.reset
+
+    assert_no_difference [ -> { User.count }, -> { Session.count }, -> { join_code.reload.usage_count } ] do
+      post session_email_code_path(script_name: nil), params: { code: delivered_code }
+    end
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not cookies[:session_token].present?
+  end
+
+  private
+    def delivered_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+
+    def request_join_code(join_code, email_address)
+      perform_enqueued_jobs do
+        post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: email_address }
+      end
+      assert_redirected_to new_session_email_code_url(script_name: nil)
+      follow_redirect!
+      assert_response :success
+      assert_select "form[action=?]", session_email_code_path(script_name: nil)
+      assert_select "a[href=?]", join_path(code: join_code.code, script_name: join_code.account.slug), text: "Request a new code"
+    end
+end
