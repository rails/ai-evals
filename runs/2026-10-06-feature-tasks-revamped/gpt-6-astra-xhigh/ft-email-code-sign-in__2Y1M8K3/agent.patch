diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..dbf0079
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,86 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :require_pending_email_authentication
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = EmailCode.active.find_by(id: @email_authentication["email_code_id"])&.consume(params.expect(:code))
+      session.delete(:email_authentication)
+
+      if redirect_url = complete_email_authentication(identity)
+        start_new_session_for identity
+
+        respond_to do |format|
+          format.html { redirect_to redirect_url }
+          format.json { render json: { session_token: session_token, redirect_url: redirect_url } }
+        end
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def require_pending_email_authentication
+      @email_authentication = session[:email_authentication]
+      redirect_to new_session_path unless @email_authentication
+    end
+
+    def complete_email_authentication(identity)
+      if @email_authentication["join_code_id"]
+        join_account(identity)
+      elsif @email_authentication["signup"]
+        new_signup_completion_url
+      else
+        after_authentication_url
+      end
+    end
+
+    def join_account(identity)
+      join_code = Account::JoinCode.find_by(id: @email_authentication["join_code_id"], code: @email_authentication["join_code"])
+      user = nil
+
+      if join_code && join_code.account.active?
+        join_code.redeem_if do |account|
+          joined = identity.join(account, verified_at: Time.current)
+          user = account.users.active.find_by(identity: identity)
+          joined
+        end
+      end
+
+      if user
+        user.setup? ? landing_url(script_name: join_code.account.slug) : new_users_join_url(script_name: join_code.account.slug)
+      else
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "That join code is no longer available." }
+          format.json { render json: { message: "That join code is no longer available." }, status: :gone }
+        end
+        nil
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work or has expired. Try again or request a new code."
+
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = message
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
