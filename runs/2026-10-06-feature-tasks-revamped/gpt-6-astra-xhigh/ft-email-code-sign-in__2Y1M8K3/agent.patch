+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>If an account exists for <strong><%= @email_authentication["email_address"] %></strong>, we’ve sent a six-character code. Enter it below to continue. The code works for 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap txt-medium", data: { turbo: false } do |form| %>
+    <%= form.label :code, "Sign-in code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: EmailCode::CODE_LENGTH, minlength: EmailCode::CODE_LENGTH, placeholder: "Enter your code…" %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Request a new code", @email_authentication["restart_url"], class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
