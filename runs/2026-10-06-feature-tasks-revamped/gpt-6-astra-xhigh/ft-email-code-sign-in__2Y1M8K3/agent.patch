+      assert_no_difference [ -> { Identity.count }, -> { EmailCode.count }, -> { Session.count } ] do
+        assert_no_enqueued_emails do
+          post session_path, params: { email_address: "unknown@example.com" }
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+
+      post session_email_code_path, params: { code: "ABC123" }
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "invalid email addresses cannot request a code" do
+    untenanted do
+      assert_no_difference -> { EmailCode.count } do
+        post session_path, params: { email_address: "not-an-email" }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }, as: :json
+      end
+      assert_response :created
+      assert_equal new_session_email_code_url, response.parsed_body["redirect_url"]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "requesting codes is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_difference -> { EmailCode.count } do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      assert_redirected_to new_session_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
 end
