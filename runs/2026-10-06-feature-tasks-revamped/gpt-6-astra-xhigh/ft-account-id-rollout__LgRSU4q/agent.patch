+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  test "all account data has a required indexed UUID account ID" do
+    global_tables = %w[ accounts account_external_id_sequences identities identity_access_tokens
+      sessions magic_links action_pack_passkeys ar_internal_metadata schema_migrations ]
+
+    ApplicationRecord.connection_pool.with_connection do |connection|
+      # FTS5 shadow tables are an implementation detail of the search index.
+      tables = connection.tables - global_tables
+      tables.reject { |table| table.start_with?("search_records_fts") }.each do |table|
+        column = connection.columns(table).find { |column| column.name == "account_id" }
+        assert column, table
+        assert_equal :uuid, column.type, table
+        refute column.null, table
+        assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, table
+      end
+    end
+  end
+
+  test "child records inherit their parent's account rather than the current account" do
+    Current.account = accounts(:initech)
+    card = cards(:logo)
+    board = card.board
+    user = users(:david)
+
+    records = [
+      Access.new(board: board, user: user),
+      Assignment.new(card: card, assignee: user, assigner: user),
+      Board::Publication.new(board: board),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card),
+      Closure.new(card: card),
+      Entropy.new(container: board),
+      Entropy.new(container: board.account),
+      Mention.new(source: card, mentioner: user, mentionee: user),
+      Pin.new(card: card, user: user),
+      Reaction.new(reactable: card, reacter: user, content: "👍"),
+      Search::Query.new(user: user, terms: "logo"),
+      Storage::Total.new(owner: board),
+      Storage::Total.new(owner: board.account),
+      Tagging.new(card: card, tag: tags(:web)),
+      User::Settings.new(user: user),
+      Watch.new(card: card, user: user),
+      Webhook::DelinquencyTracker.new(webhook: webhooks(:active)),
+      Webhook::Delivery.new(webhook: webhooks(:active), event: events(:logo_published))
+    ]
+
+    records.each do |record|
+      record.valid?
+      assert_equal card.account, record.account, record.class.name
+    end
+  end
+
+  test "filter join writes include the filter account" do
+    Current.account = accounts(:initech)
+    filter = users(:david).filters.create!(boards: [ boards(:writebook) ], tags: [ tags(:web) ],
+      assignees: [ users(:jz) ], creators: [ users(:david) ], closers: [ users(:kevin) ])
+
+    %i[ board_filters tag_filters assignee_filters creator_filters closer_filters ].each do |association|
+      assert_equal filter.account_id, filter.public_send(association).sole.account_id
+    end
+  end
+
+  test "rich text and attachments inherit ownership without a current account" do
+    Current.account = nil
+    card = cards(:logo)
+    card.update!(description: "Account-owned text")
+    assert_equal card.account, card.description.account
+
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    assert_equal card.account, card.image.attachment.account
+    assert_equal card.account, card.image.blob.account
+
+    variant = card.image.blob.variant_records.create!(variation_digest: "test")
+    assert_equal card.account, variant.account
+    variant.image.attach(io: file_fixture("moon.jpg").open, filename: "variant.jpg", content_type: "image/jpeg")
+    assert_equal card.account, variant.image.attachment.account
+    assert_equal card.account, variant.image.blob.account
+  end
+end
