+    insert(:cards, id: 1, account_id: 1)
+    insert(:action_text_rich_texts, id: 1, record_type: "Card", record_id: 1)
+    (1..6).each { |id| insert(:active_storage_blobs, id: id) }
+    insert(:active_storage_attachments, id: 1, record_type: "ActionText::RichText", record_id: 1, blob_id: 1)
+    insert(:active_storage_variant_records, id: 1, blob_id: 1)
+    insert(:active_storage_attachments, id: 2, record_type: "ActiveStorage::VariantRecord", record_id: 1, blob_id: 2)
+    insert(:active_storage_attachments, id: 3, record_type: "ActiveStorage::Blob", record_id: 2, blob_id: 3)
+    insert(:active_storage_variant_records, id: 2, blob_id: 3)
+    insert(:active_storage_attachments, id: 4, record_type: "ActiveStorage::VariantRecord", record_id: 2, blob_id: 4)
+    insert(:active_storage_attachments, id: 5, record_type: "Card", record_id: 99, blob_id: 5)
+    insert(:active_storage_attachments, id: 6, record_type: "Card", record_id: 1, blob_id: 99)
+    insert(:active_storage_variant_records, id: 3, blob_id: 99)
+    # A disconnected preview cycle cannot establish an account.
+    insert(:active_storage_attachments, id: 7, record_type: "ActiveStorage::Blob", record_id: 6, blob_id: 6)
+
+    migrate
+
+    assert_equal [ 1 ] * 4, accounts_for(:active_storage_attachments)
+    assert_equal [ 1 ] * 4, accounts_for(:active_storage_blobs)
+    assert_equal [ 1 ] * 2, accounts_for(:active_storage_variant_records)
