+  def test_required_uuid_columns_indexes_and_global_tables
+    migrate
+
+    tables = CompleteAccountIdRollout::EXISTING_TABLES.keys +
+      CompleteAccountIdRollout::CHILD_TABLES.keys +
+      CompleteAccountIdRollout::POLYMORPHIC_TABLES.keys +
+      CompleteAccountIdRollout::STORAGE_TABLES
+    tables.each do |table|
+      column = @connection.columns(table).find { |column| column.name == "account_id" }
+      assert_equal :uuid, column.type, table.to_s
+      refute column.null, table.to_s
+      assert @connection.index_exists?(table, :account_id), table.to_s
+      assert_raises(ActiveRecord::NotNullViolation) { insert(table, account_id: nil) }
+    end
+
+    %i[ identities sessions magic_links identity_access_tokens action_pack_passkeys account_external_id_sequences ].each do |table|
+      refute @connection.column_exists?(table, :account_id), table.to_s
+    end
+    assert @connection.indexes(:account_cancellations).sole.unique
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  private
+    def create_legacy_tables
+      @connection.create_table(:accounts, id: :uuid)
+      %i[ identities sessions magic_links identity_access_tokens action_pack_passkeys account_external_id_sequences ].each do |table|
+        @connection.create_table(table, id: :uuid)
+      end
+      CompleteAccountIdRollout::EXISTING_TABLES.each do |table, parent|
+        @connection.create_table(table, id: :uuid) do |t|
+          t.uuid :account_id
+          t.uuid parent.last if parent
+        end
+      end
+      # Preserve an existing unique account index.
+      @connection.add_index :account_cancellations, :account_id, unique: true
+      CompleteAccountIdRollout::CHILD_TABLES.each do |table, (_, key)|
+        @connection.create_table(table, id: table.to_s.include?("filters") ? false : :uuid) { |t| t.uuid key }
+      end
+      CompleteAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (reference, _)|
+        @connection.create_table(table, id: :uuid) do |t|
+          t.uuid "#{reference}_id"
+          t.string "#{reference}_type"
+        end
+      end
+      @connection.create_table(:active_storage_blobs, id: :uuid)
+      @connection.create_table(:active_storage_variant_records, id: :uuid) { |t| t.uuid :blob_id }
+      @connection.create_table(:active_storage_attachments, id: :uuid) do |t|
+        t.uuid :record_id
+        t.string :record_type
+        t.uuid :blob_id
+      end
+    end
+
+    def insert(table, **attributes)
+      if @connection.primary_key(table) && !attributes.key?(:id)
+        attributes[:id] = ActiveRecord::Type::Uuid.generate
+      end
+      attributes = attributes.to_h do |key, value|
+        if value && (key.to_s == "id" || key.to_s.end_with?("_id"))
+          value = ActiveRecord::Type::Uuid.new.serialize(value.is_a?(Integer) ? value.to_s(36) : value)
+        end
+        [ key, value ]
+      end
+      columns = attributes.keys.map { |key| @connection.quote_column_name(key) }.join(", ")
+      values = attributes.values.map { |value| @connection.quote(value) }.join(", ")
+      @connection.execute "INSERT INTO #{table} (#{columns}) VALUES (#{values})"
+    end
+
+    def migrate
+      @migration.suppress_messages { @migration.exec_migration(@connection, :up) }
+    end
+
+    def accounts_for(table)
+      @connection.select_values("SELECT account_id FROM #{table} ORDER BY account_id").map { |value| ActiveRecord::Type::Uuid.new.deserialize(value).to_i(36) }
+    end
+end
