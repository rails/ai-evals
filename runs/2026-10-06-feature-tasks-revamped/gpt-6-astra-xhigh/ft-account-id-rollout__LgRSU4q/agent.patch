+      insert(table, id: 1, account_id: 1)
+      insert(table, id: 2, account_id: 2)
+    end
+    insert(:action_text_rich_texts, id: 1, record_type: "Card", record_id: 1)
+    insert(:action_text_rich_texts, id: 2, record_type: "Card", record_id: 2)
+    types = %w[ Board Card Comment User Export Account::Export Account::Import ActionText::RichText ]
+    types.each_with_index do |type, index|
+      [ 1, 2 ].each do |account_id|
+        blob_id = index * 2 + account_id
+        insert(:active_storage_blobs, id: blob_id)
+        insert(:active_storage_attachments, record_type: type, record_id: account_id, blob_id: blob_id)
+      end
