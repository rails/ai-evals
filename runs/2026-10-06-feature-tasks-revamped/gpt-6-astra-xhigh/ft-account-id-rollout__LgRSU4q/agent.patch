diff --git a/config/initializers/account_owned_content.rb b/config/initializers/account_owned_content.rb
new file mode 100644
index 0000000..279e18b
--- /dev/null
+++ b/config/initializers/account_owned_content.rb
@@ -0,0 +1,22 @@
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record&.account }
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account }
+
+  # Attachments built outside a request still inherit their owner's account.
+  # Set this before autosave validates the new blob.
+  before_validation(prepend: true) do
+    self.account ||= record.try(:account) || blob&.account
+    blob.account ||= account if blob&.new_record?
+  end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::VariantRecord.belongs_to :account, default: -> { blob.account }
+end
