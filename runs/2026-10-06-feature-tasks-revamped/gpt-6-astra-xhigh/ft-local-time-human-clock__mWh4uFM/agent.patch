diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..0664947
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, localTimeTitle, parseLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+  #observer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), 60_000)
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, {
+      attributes: true, attributeFilter: [ "datetime" ], childList: true, characterData: true, subtree: true
+    })
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+    this.#observer?.disconnect()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const datetime = this.element.getAttribute("datetime")
+    const date = parseLocalTime(datetime)
+
+    if (datetime && !Number.isNaN(date.getTime())) {
+      const text = formatLocalTime(date, this.formatValue)
+      const title = localTimeTitle(date, { dateOnly: datetime.length === 10 })
+
+      // Turbo morphs can restore the raw content without reconnecting the controller.
+      if (this.element.textContent !== text) this.element.textContent = text
+      if (this.element.title !== title) this.element.title = title
+    }
+  }
+}
