diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..7034207
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,52 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+export function parseLocalTime(datetime) {
+  // A calendar date (such as a timeline heading) is not a UTC timestamp.
+  return new Date(/^\d{4}-\d{2}-\d{2}$/.test(datetime) ? `${datetime}T00:00:00` : datetime)
+}
+
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  switch (format) {
+    case "time":
+      return formatDate(date, { hour: "numeric", minute: "2-digit" })
+    case "date":
+      return formatDate(date, { year: "numeric", month: "short", day: "numeric" })
+    case "long_date":
+      return formatDate(date, { weekday: "long", month: "long", day: "numeric", ...yearIfDifferent(date, now) })
+    case "datetime":
+      return formatDate(date, { dateStyle: "medium", timeStyle: "short" })
+    case "relative_date":
+      return formatRelativeDate(date, now)
+    default:
+      return formatRelativeTime(date, now)
+  }
+}
+
+export function localTimeTitle(date, { dateOnly = false } = {}) {
+  return formatDate(date, dateOnly ? { dateStyle: "full" } : { dateStyle: "full", timeStyle: "long" })
+}
+
+function formatDate(date, options) {
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
+
+function yearIfDifferent(date, now) {
+  return date.getFullYear() === now.getFullYear() ? {} : { year: "numeric" }
+}
+
+function formatRelativeTime(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return formatLocalTime(date, "time")
+  } else if (Math.abs(days) < 7) {
+    return formatRelativeDate(date, now)
+  } else {
+    return formatDate(date, { month: "short", day: "numeric", ...yearIfDifferent(date, now) })
+  }
+}
+
+function formatRelativeDate(date, now) {
+  return new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }).format(signedDifferenceInDays(now, date), "day")
+}
+
