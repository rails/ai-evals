diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..a944e95
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "timestamps contain no server-rendered dates or relative wording" do
+    time = Time.utc(2025, 9, 17, 20, 42)
+    html = local_time_tag(time)
+
+    assert_dom_equal %(<time datetime="2025-09-17T20:42:00Z" data-controller="local-time" data-local-time-format-value="relative">2025-09-17T20:42:00Z</time>), html
+  end
+
+  test "markup is independent of the server timezone and current time" do
+    time = Time.utc(2025, 9, 17, 1, 42)
+    html = Time.use_zone("America/Los_Angeles") { local_time_tag(time.in_time_zone) }
+
+    travel_to 3.days.from_now do
+      Time.use_zone("Asia/Tokyo") do
+        assert_equal html, local_time_tag(time.in_time_zone)
+      end
+    end
+  end
+
+  test "normalizing a timestamp does not change the supplied time" do
+    time = Time.new(2025, 9, 17, 1, 42, 0, "+09:00")
+    html = local_time_tag(time)
+
+    assert_includes html, 'datetime="2025-09-16T16:42:00Z"'
+    assert_equal 9.hours, time.utc_offset
+  end
+
+  test "datetime values include an unambiguous offset" do
+    html = local_time_tag(DateTime.iso8601("2025-09-17T01:42:00+09:00"))
+
+    assert_includes html, 'datetime="2025-09-16T16:42:00Z"'
+  end
+
+  test "preserves calendar dates and custom attributes" do
+    html = local_time_tag(Date.new(2025, 9, 17), format: :long_date, class: "timestamp", data: { controller: "other", test: "date" })
+
+    assert_dom_equal %(<time datetime="2025-09-17" class="timestamp" data-controller="other local-time" data-test="date" data-local-time-format-value="long_date">2025-09-17</time>), html
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..c21fdda
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,132 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    use_timezone "America/Los_Angeles"
+    sign_in_as users(:david)
+    visit card_url(cards(:layout))
+    set_browser_time "2025-09-17T22:42:00Z"
+  end
+
+  teardown do
+    use_timezone "UTC"
+  end
+
+  test "recent activity uses the viewer's calendar days" do
+    # This deliberately disagrees with the browser timezone.
+    append_html '<meta name="timezone" content="UTC">'
+
+    assert_local_time "2025-09-17T20:42:00Z", "1:42 PM"
+    assert_local_time "2025-09-17T06:42:00Z", "yesterday"
+    assert_local_time "2025-09-15T20:42:00Z", "2 days ago"
+    assert_local_time "2025-09-12T20:42:00Z", "5 days ago"
+    assert_local_time "2025-09-10T20:42:00Z", "Sep 10"
+    assert_local_time "2024-09-12T20:42:00Z", "Sep 12, 2024"
+
+    time = find("#local-time-1")
+    assert_includes time[:title], "September 17, 2025"
+    assert_includes time[:title], "1:42:00 PM"
+  end
+
+  test "deadlines include their own relative wording" do
+    assert_local_time "2025-09-17T23:42:00Z", "today", format: :relative_date
+    assert_local_time "2025-09-18T08:00:00Z", "tomorrow", format: :relative_date
+    assert_local_time "2025-09-20T08:00:00Z", "in 3 days", format: :relative_date
+    assert_local_time "2025-10-17T08:00:00Z", "in 30 days", format: :relative_date
+  end
+
+  test "calendar boundaries work across daylight saving, leap days, and new years" do
+    [
+      [ "2025-03-09T00:30:00-08:00", "2025-03-10T00:15:00-07:00" ],
+      [ "2025-11-02T00:30:00-07:00", "2025-11-03T00:15:00-08:00" ],
+      [ "2024-02-28T23:59:00-08:00", "2024-02-29T00:01:00-08:00" ],
+      [ "2025-12-31T23:59:00-08:00", "2026-01-01T00:01:00-08:00" ]
+    ].each do |now, tomorrow|
+      set_browser_time now
+      assert_local_time tomorrow, "tomorrow", format: :relative_date
+      set_browser_time tomorrow
+      assert_local_time now, "yesterday"
+    end
+  end
+
+  test "the same timestamp renders differently in different browser timezones" do
+    assert_local_time "2025-09-17T20:42:00Z", "Sep 17, 2025, 1:42 PM", format: :datetime
+    use_timezone "Asia/Tokyo"
+    refresh_local_times
+
+    assert_selector "#local-time-1", exact_text: "Sep 18, 2025, 5:42 AM"
+    assert_equal "2025-09-17T20:42:00Z", find("#local-time-1")[:datetime]
+  end
+
+  test "calendar dates do not shift when the browser is west of UTC" do
+    html = ApplicationController.helpers.local_time_tag(Date.new(2025, 9, 17), format: :long_date, id: "calendar-date")
+    append_html html
+
+    assert_selector "#calendar-date", exact_text: "Wednesday, September 17"
+    assert_equal "Wednesday, September 17, 2025", find("#calendar-date")[:title]
+  end
+
+  test "formatting survives Turbo updates and reconnects" do
+    assert_local_time "2025-09-17T20:42:00Z", "1:42 PM"
+
+    # A morph may replace just the text while leaving the controller connected.
+    page.execute_script('document.querySelector("#local-time-1").textContent = "2025-09-17T20:42:00Z"')
+    assert_selector "#local-time-1", exact_text: "1:42 PM"
+
+    page.execute_script('document.querySelector("#local-time-1").dateTime = "2025-09-17T06:42:00Z"')
+    assert_selector "#local-time-1", exact_text: "yesterday"
+
+    page.execute_script('window.detachedTime = document.querySelector("#local-time-1"); window.detachedTime.remove()')
+    assert_no_selector "#local-time-1"
+    set_browser_time "2025-09-18T22:42:00Z"
+    page.execute_script("document.body.append(window.detachedTime)")
+    assert_selector "#local-time-1", exact_text: "2 days ago"
+  end
+
+  test "connected timestamps refresh after midnight and ignore invalid timestamps" do
+    assert_local_time "2025-09-17T20:42:00Z", "1:42 PM"
+    set_browser_time "2025-09-18T08:00:00Z"
+    refresh_local_times
+    assert_selector "#local-time-1", exact_text: "yesterday"
+
+    append_html '<time id="invalid-time" data-controller="local-time" datetime="invalid">Unknown time</time>'
+    assert_selector "#invalid-time", exact_text: "Unknown time"
+    assert_local_time "2025-09-18T08:00:00Z", "1:00 AM"
+  end
+
+  private
+    def use_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def set_browser_time(time)
+      page.execute_script <<~JS, time
+        window.originalDate ||= window.Date
+        const now = new window.originalDate(arguments[0]).getTime()
+        window.Date = class extends window.originalDate {
+          constructor(...args) { super(...(args.length ? args : [now])) }
+          static now() { return now }
+        }
+      JS
+    end
+
+    def assert_local_time(datetime, expected, format: :relative)
+      @time_count = (@time_count || 0) + 1
+      id = "local-time-#{@time_count}"
+      html = ApplicationController.helpers.local_time_tag(Time.iso8601(datetime), format: format, id: id)
+      append_html html
+      assert_selector "##{id}", exact_text: expected
+    end
+
+    def append_html(html)
+      page.execute_script('document.body.insertAdjacentHTML("beforeend", arguments[0])', html)
+    end
+
+    def refresh_local_times
+      page.execute_script <<~JS
+        document.querySelectorAll('[data-controller~="local-time"]').forEach(element => {
+          window.Stimulus.getControllerForElementAndIdentifier(element, "local-time").render()
+        })
+      JS
+    end
+end
