@@ -0,0 +1,70 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of account activity, newest first. Only events on boards the
+current user can access are returned. Activity is not limited to a single day.
+
+The endpoint uses the API's [standard pagination](../README.md#pagination). Follow
+the `Link` header's `rel="next"` URL to retrieve subsequent pages.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of strings | Include events created by any of these users, not necessarily the card's creator |
+| `board_ids[]` | array of strings | Include events on any of these boards |
+
+When both filters are supplied, events must match both. Filters never grant access
+to otherwise inaccessible activity. No matching events returns `[]`.
+
+```bash
+curl -H "Authorization: Bearer $TOKEN" \
+  "https://app.fizzy.do/1234567/activities.json?creator_ids[]=USER_ID&board_ids[]=BOARD_ID"
+```
+
+### Events
+
+The feed includes the same event kinds as the HTML timeline, except that it omits
+the deprecated `card_collection_changed` action and includes `card_title_changed`:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_title_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `comment_created`
+
+Each array entry has these fields:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | One of the action names listed above |
+| `created_at` | Event timestamp in UTC (ISO 8601) |
+| `description` | The event's plain-text description, rather than the HTML timeline markup |
+| `particulars` | Event-specific details, as described below |
+| `url` | Card URL; comment events include an anchor that jumps to the comment on its card |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation of the event's creator |
+
+### Particulars
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `{"assignee_ids": ["USER_ID"]}` |
+| `card_board_changed` | `{"old_board": "Previous board", "new_board": "New board"}` |
+| `card_title_changed` | `{"old_title": "Previous title", "new_title": "New title"}` |
+| `card_triaged` | `{"column": "In progress"}` |
+| All other actions | `{}` |
+
+Board and column values are names, not IDs. Missing board, title, and column
+values are returned as empty strings (`""`).
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..3201bfe
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,282 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns a flat array of activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+  end
+
+  test "card activity uses the existing API representations and plain text description" do
+    event = events(:logo_published)
+
+    get activities_path(format: :json)
+    assert_response :success
+    activity = response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal %w[ action board created_at creator description eventable eventable_type id particulars url ], activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get cards_path(format: :json), params: { card_ids: [ event.card.id ] }
+    assert_equal response.parsed_body.sole, activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the comment on its card and uses the comment API representation" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    assert_response :success
+    activity = response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+    expected_events = actions.map do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:logo)
+      create_event(action, eventable: eventable, creator: users(:jz))
+    end
+    create_event("card_collection_changed", creator: users(:jz))
+    create_event("card_resumed", creator: users(:jz))
+    create_event("card_unknown", creator: users(:jz))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:jz).id ] }
+
+    assert_response :success
+    assert_equal expected_events.reverse.map(&:id), response.parsed_body.pluck("id")
+    assert_equal actions.sort, response.parsed_body.pluck("action").sort
+  end
+
+  test "assignment and unassignment particulars expose assignee ids" do
+    %w[ card_assigned card_unassigned ].each do |action|
+      event = create_event(action, particulars: { assignee_ids: [ users(:david).id, users(:jz).id ], internal: "hidden" })
+
+      assert_equal({ "assignee_ids" => [ users(:david).id, users(:jz).id ] }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "board title and triage particulars expose event details without the storage wrapper" do
+    {
+      "card_board_changed" => { "old_board" => "Writebook", "new_board" => "Private board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }.each do |action, particulars|
+      event = create_event(action, particulars: { particulars: particulars.merge("internal" => "hidden") })
+
+      assert_equal particulars, activity_for(event)["particulars"]
+    end
+  end
+
+  test "missing board title and column particulars are empty strings" do
+    {
+      "card_board_changed" => { "old_board" => "", "new_board" => "" },
+      "card_title_changed" => { "old_title" => "", "new_title" => "" },
+      "card_triaged" => { "column" => "" }
+    }.each do |action, expected|
+      [ {}, { particulars: {} }, { particulars: expected.transform_values { nil } } ].each do |particulars|
+        event = create_event(action, particulars: particulars)
+
+        assert_equal expected, activity_for(event)["particulars"]
+      end
+    end
+  end
+
+  test "other events do not expose stored particulars" do
+    %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage ].each do |action|
+      event = create_event(action, particulars: { internal: "hidden" })
+
+      assert_equal({}, activity_for(event)["particulars"])
+    end
+  end
+
+  test "filters by multiple creators using event creators rather than card creators" do
+    event = create_event("card_closed", creator: users(:jz))
+    creator_ids = [ users(:kevin).id, users(:jz).id ]
+
+    get activities_path(format: :json), params: { creator_ids: creator_ids }
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(creator_id: creator_ids).order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+    assert_includes response.parsed_body.pluck("id"), event.id
+  end
+
+  test "filters by boards and combines board and creator filters" do
+    private_event = create_private_event
+    other_event = create_event("card_closed", eventable: private_event.card, creator: users(:david))
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ other_event.id, private_event.id ], response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+    assert_equal [ private_event.id ], response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+  end
+
+  test "only returns accessible account activity even when inaccessible boards are requested" do
+    private_event = create_private_event
+    foreign_event = Current.with(account: accounts(:initech), user: users(:mike)) do
+      create_event("card_published", eventable: cards(:radio), creator: users(:mike))
+    end
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes response.parsed_body.pluck("id"), foreign_event.id
+
+    get activities_path(format: :json), params: { board_ids: [ private_event.board_id, foreign_event.board_id ] }
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, private_event.board_id, foreign_event.board_id ] }
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "card and comment activity follows access when a card moves to a private board" do
+    card_event = events(:layout_published)
+    comment_event = events(:layout_commented)
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), card_event.id
+    assert_includes response.parsed_body.pluck("id"), comment_event.id
+
+    Current.with(user: users(:kevin)) { cards(:layout).move_to(boards(:private)) }
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), card_event.id
+    assert_not_includes response.parsed_body.pluck("id"), comment_event.id
+    assert_not_includes response.parsed_body.map { |activity| activity.dig("board", "id") }, boards(:private).id
+  end
+
+  test "returns an empty array when the user has no board access" do
+    users(:kevin).accesses.destroy_all
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+    assert_equal "0", response.headers["X-Total-Count"]
+    assert_nil response.headers["Link"]
+  end
+
+  test "empty filters do not restrict activity" do
+    get activities_path(format: :json), params: { creator_ids: [], board_ids: [] }
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).pluck(:id), response.parsed_body.pluck("id")
+  end
+
+  test "nonmatching filters return an empty array" do
+    [ { creator_ids: [ users(:mike).id ] }, { board_ids: [ ActiveRecord::Type::Uuid.generate ] } ].each do |filters|
+      get activities_path(format: :json), params: filters
+
+      assert_response :success
+      assert_equal [], response.parsed_body
+      assert_equal "0", response.headers["X-Total-Count"]
+      assert_nil response.headers["Link"]
+    end
+  end
+
+  test "paginates newest first with stable ordering and retains filters in next links" do
+    40.times do |index|
+      create_event("card_published", creator: users(:jz), created_at: index.even? ? 1.month.ago.beginning_of_day : Time.current.beginning_of_day)
+    end
+    expected_ids = users(:kevin).accessible_events.where(creator: users(:jz)).order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+      assert_equal expected_ids.size.to_s, response.headers["X-Total-Count"]
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      page_count += 1
+      assert_operator page_count, :<, 10
+      next_page = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected_ids, actual_ids
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json", response.media_type
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "requires authentication and accepts API tokens" do
+    sign_out
+
+    get activities_path(format: :json)
+    assert_redirected_to new_session_path(script_name: nil)
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer invalid" }
+    assert_response :unauthorized
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  private
+    def create_event(action, eventable: cards(:logo), creator: users(:kevin), **attributes)
+      eventable.events.create!(action: action, board: eventable.board, creator: creator, **attributes)
+    end
+
+    def create_private_event
+      card = Current.with(user: users(:kevin)) do
+        boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published)
+      end
+      card.events.find_by!(action: "card_published")
+    end
+
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+      response.parsed_body.find { |record| record["id"] == event.id }
+    end
+end
