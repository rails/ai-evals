+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    sign_in_as users(:kevin)
+    visit card_url(@comment.card)
+    wait_for_cable_subscriptions
+  end
+
+  test "cancel, add multiple reactions, and remove your own reaction" do
+    within_comment do
+      click_on "Add a reaction"
+      assert_selector "input:focus"
+      fill_in "Your reaction", with: "Discard this"
+      click_on "Cancel reaction"
+      assert_no_selector "input[name='reaction[content]']"
+      assert_button "Add a reaction"
+      assert_no_selector ".reactions__list .reaction"
+
+      click_on "Add a reaction"
+      assert_field "Your reaction", with: ""
+      fill_in "Your reaction", with: "Nice work!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Nice work!", count: 1
+      assert_no_selector "input[name='reaction[content]']"
+      assert_button "Add a reaction"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "🎉"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_selector "input[name='reaction[content]']"
+
+      reaction = find(".reactions__list .reaction", text: "Nice work!")
+      avatar = reaction.find(".avatar")
+      assert_operator avatar.native.rect.height, :<=, reaction.native.rect.height
+      assert_in_delta avatar.native.rect.height, avatar.native.rect.width, 1
+
+      assert_no_button "Remove reaction"
+      find("[role=button]", text: "Nice work!").click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction", text: "Nice work!"
+      assert_selector ".reactions__list .reaction", text: "🎉", count: 1
+    end
+
+    page.refresh
+    within_comment { assert_selector ".reactions__list .reaction", text: "🎉", count: 1 }
+  end
+
+  test "an empty strip uses the empty reaction styling" do
+    within_comment do
+      assert_selector ".reactions:not(:has(.reaction))"
+      click_on "Add a reaction"
+      assert_selector ".reactions:has(.reaction__form.reaction)"
+      click_on "Cancel reaction"
+      assert_selector ".reactions:not(:has(.reaction))"
+    end
+  end
+
+  test "allows sixteen emoji as well as sixteen text characters" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "🎉" * 16
+      assert_field "Your reaction", with: "🎉" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "🎉" * 16
+    end
+  end
+
+  test "server validation errors keep the input available for correction" do
+    within_comment do
+      click_on "Add a reaction"
+      input = find("input[name='reaction[content]']")
+      page.execute_script("arguments[0].removeAttribute('maxlength'); arguments[0].value = arguments[1]", input, "a" * 17)
+      click_on "Confirm reaction"
+      assert_selector "[role=alert]", text: "Content is too long"
+      assert_field "Your reaction", with: "a" * 17
+      assert_no_selector ".reactions__list .reaction"
+
+      fill_in "Your reaction", with: "Corrected"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Corrected"
+      assert_button "Add a reaction"
+      assert_no_text "Content is too long"
+    end
+  end
+
+  test "the response and broadcast show each reaction only once to both viewers" do
+    Capybara.using_session(:other_viewer) do
+      sign_in_as users(:jz)
+      visit card_url(@comment.card)
+      wait_for_cable_subscriptions
+    end
+
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Hello!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "Hello!", count: 1
+    end
+
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ]
+
+    within_comment do
+      assert_selector ".reactions__list .reaction", text: "Hello!", count: 1
+      find("[role=button]", text: "Hello!").click
+      assert_button "Remove reaction"
+    end
+
+    Capybara.using_session(:other_viewer) do
+      within_comment do
+        assert_selector ".reactions__list .reaction", text: "Hello!", count: 1
+        find(".reaction", text: "Hello!").click
+        assert_no_button "Remove reaction"
+      end
+    end
+
+    within_comment { click_on "Remove reaction" }
+
+    Capybara.using_session(:other_viewer) do
+      within_comment { assert_no_selector ".reactions__list .reaction" }
+    end
+  end
+
+  test "escape cancels and text is limited to sixteen characters" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Discard this"
+      find("input[name='reaction[content]']").send_keys :escape
+      assert_button "Add a reaction"
+      assert_no_selector "input[name='reaction[content]']"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "a" * 17
+      assert_field "Your reaction", with: "a" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "a" * 16
+    end
+  end
+
+  test "your reaction can be expanded and removed with the keyboard" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Great!"
+      click_on "Confirm reaction"
+
+      toggle = find("[role=button]", text: "Great!")
+      toggle.send_keys :enter
+      assert_button "Remove reaction"
+      toggle.send_keys :escape
+      assert_no_button "Remove reaction"
+      toggle.send_keys :space
+      find_button("Remove reaction").send_keys :enter
+      assert_no_selector ".reactions__list .reaction"
+    end
+  end
+
+  test "live additions and removals preserve an unfinished reaction" do
+    within_comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Still typing"
+    end
+
+    reaction = nil
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ] do
+      reaction = @comment.reactions.create!(content: "Thanks!", creator: users(:jz))
+    end
+
+    within_comment do
+      assert_selector ".reactions__list .reaction", text: "Thanks!", count: 1
+      assert_selector "[aria-label='JZ reacted: Thanks!']"
+      assert_field "Your reaction", with: "Still typing"
+      find(".reactions__list .reaction", text: "Thanks!").click
+      assert_no_button "Remove reaction"
+    end
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+      reaction.destroy!
+    end
+
+    within_comment do
+      assert_no_selector ".reactions__list .reaction", text: "Thanks!"
+      assert_field "Your reaction", with: "Still typing"
+    end
+  end
+
+  private
+    def within_comment(&block)
+      within "##{dom_id(@comment)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
