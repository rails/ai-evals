diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..c8a838b
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create appends a reaction with the signed in creator" do
+    assert_difference "Reaction.count", 1 do
+      post card_comment_reactions_path(@card, @comment), params: {
+        reaction: { content: "🎉", creator_id: users(:jz).id, account_id: accounts(:initech).id }
+      }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @card.account, reaction.account
+    assert_select "turbo-stream[action=append][target='#{ActionView::RecordIdentifier.dom_id(@comment, :reactions)}']"
+    assert_select ".reaction", text: /🎉/
+  end
+
+  test "rejects blank and overlong reactions" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "cannot react to a comment through a different card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot react without access to the board" do
+    @card.board.accesses.where(user: users(:kevin)).destroy_all
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot react to a comment in another account with the same card number" do
+    foreign_comment = Current.with(account: accounts(:initech), user: users(:mike)) do
+      cards(:radio).comments.create!(body: "Private comment")
+    end
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:radio), foreign_comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :redirect
+  end
+
+  test "renders reaction content as text rather than markup" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "<b>Hi</b>" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select ".reaction .txt-small", text: "<b>Hi</b>"
+    assert_select ".reaction b", count: 0
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target='#{ActionView::RecordIdentifier.dom_id(reaction)}']"
+  end
+
+  test "cannot destroy another person's reaction even as an administrator" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot destroy a reaction after losing board access" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:kevin))
+    @card.board.accesses.where(user: users(:kevin)).destroy_all
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot destroy a reaction through a different comment" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, comments(:logo_agreement_kevin), reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..cb81439
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "records the comment, account, and current creator" do
+    reaction = @comment.reactions.create!(content: "🎉")
+
+    assert_equal @comment, reaction.comment
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:kevin), reaction.creator
+  end
+
+  test "accepts emoji and text up to sixteen characters" do
+    [ "👍", "Nice work!", "a" * 16, "🎉" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?
+    end
+  end
+
+  test "rejects blank and overlong reactions" do
+    [ nil, "", "   ", "a" * 17, "🎉" * 17 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+      assert_not reaction.valid?
+      assert reaction.errors[:content].any?
+    end
+  end
+
+  test "allows multiple reactions from the same person" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "🎉") }
+    end
+  end
+
+  test "invalidates the comment cache when reactions are created and removed" do
+    reaction = nil
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      reaction = @comment.reactions.create!(content: "🎉")
+    end
+
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      reaction.destroy!
+    end
+  end
+
+  test "removes reactions when the comment is destroyed" do
+    reaction = @comment.reactions.create!(content: "🎉")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "broadcasts additions and removals to viewers of the card" do
+    reaction = nil
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        reaction = @comment.reactions.create!(content: "🎉")
+      end
+    end
+
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy!
+    end
+  end
+end
