+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "creation enrolls the notification using its arrival time" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::BundleJob, at: nil) do
+        @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+      end
+
+      perform_enqueued_jobs only: Notification::BundleJob
+      bundle = @user.notification_bundles.sole
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 1.day.from_now, bundle.ends_at
+      assert_equal [ cards(:layout) ], bundle.notifications.map(&:card)
+    end
+  end
+
+  test "new activity on an existing notification is enrolled" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::BundleJob, args: [ @notification, { at: Time.current } ]) do
+        @notification.update!(source: events(:logo_published))
+      end
+    end
+  end
+
+  test "marking a notification read or changing its count does not enroll it" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+      @notification.unread
+      @notification.update!(unread_count: 5)
+    end
+  end
+
+  test "a delayed job uses the captured arrival time, not a newer notification timestamp" do
+    freeze_time do
+      notified_at = Time.current
+      @notification.update!(source: events(:logo_published))
+      travel 2.hours
+      @notification.read
+
+      perform_enqueued_jobs only: Notification::BundleJob
+      bundle = @user.notification_bundles.sole
+      assert_equal notified_at, bundle.starts_at
+      assert_equal notified_at + 1.day, bundle.ends_at
+    end
+  end
+end
