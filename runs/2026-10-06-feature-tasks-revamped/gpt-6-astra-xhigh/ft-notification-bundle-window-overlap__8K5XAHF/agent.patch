+++ b/test/jobs/notification/bundle/delivery_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notification::Bundle::DeliveryJobTest < ActiveJob::TestCase
+  include ActionMailer::TestHelper
+
+  test "scheduled delivery sends one digest in the recipient account" do
+    freeze_time do
+      users(:kevin).settings.update!(bundle_email_frequency: "every_few_hours")
+      bundle = notifications(:logo_assignment_kevin).bundle
+      notifications(:layout_commented_kevin).bundle
+
+      assert_no_emails do
+        perform_enqueued_jobs only: Notification::Bundle::DeliveryJob, at: 4.hours.from_now - 1.second
+      end
+
+      travel_to bundle.ends_at
+      assert_emails 1 do
+        perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+      end
+      assert_equal [ users(:kevin).identity.email_address ], ActionMailer::Base.deliveries.last.to
+      assert_not_nil bundle.reload.delivered_at
+
+      assert_no_emails { Notification::Bundle::DeliveryJob.perform_now(bundle) }
+    end
+  end
+
+  test "deleted bundles are discarded" do
+    users(:kevin).settings.update!(bundle_email_frequency: "daily")
+    bundle = notifications(:logo_assignment_kevin).bundle
+    bundle.destroy!
+
+    assert_no_emails { perform_enqueued_jobs only: Notification::Bundle::DeliveryJob }
+  end
+end
