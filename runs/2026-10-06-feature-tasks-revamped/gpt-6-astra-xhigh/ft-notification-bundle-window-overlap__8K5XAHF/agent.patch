@@ -0,0 +1,34 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "a digest contains all bundled notifications and account scoped links" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    first = notifications(:logo_assignment_kevin)
+    second = notifications(:layout_commented_kevin)
+    bundle = first.bundle
+    second.bundle
+
+    email = NotificationMailer.bundle(bundle)
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notifications", email.subject
+
+    [ email.html_part, email.text_part ].each do |part|
+      assert_not_nil part
+      [ first, second ].each do |notification|
+        assert_includes CGI.unescapeHTML(part.body.decoded), notification.payload.title
+        assert_includes part.body.decoded, notification.payload.url
+      end
+      assert_includes part.body.decoded, "#{user.account.slug}/notifications/settings"
+    end
+  end
+
+  test "digests support mention notifications" do
+    users(:david).settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:logo_mentioned_david)
+    email = NotificationMailer.bundle(notification.bundle)
+
+    assert_includes email.text_part.body.decoded, notification.payload.title
+    assert_includes email.text_part.body.decoded, notification.payload.body
+  end
+end
diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..ce15b6f
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @identity = Identity.create!(email_address: "digest-concurrency@example.com")
+    @user = accounts(:"37s").users.create!(name: "Digest recipient", identity: @identity)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @notifications = [ events(:logo_published), events(:layout_published) ].map do |source|
+      @user.notifications.create!(source: source, creator: users(:david))
+    end
+  end
+
+  teardown do
+    @user&.destroy!
+    @identity&.destroy!
+  end
+
+  test "concurrent first arrivals and later arrivals never open overlapping windows" do
+    freeze_time do
+      3.times do |window|
+        at = Time.current + window * 8.hours
+        bundles = concurrently do |index|
+          notification = Notification.find(@notifications[index % 2].id)
+          notification.bundle(at: at + index.hours)
+        end
+
+        assert_equal 1, bundles.map(&:id).uniq.size
+      end
+
+      bundles = @user.notification_bundles.order(:starts_at).to_a
+      assert_equal 3, bundles.size
+      assert_equal 12, Notification::Bundle::Entry.where(bundle: bundles).count
+      bundles.each_cons(2) do |first, second|
+        assert_operator first.ends_at, :<=, second.starts_at
+      end
+    end
+  end
+
+  test "concurrent retries enroll activity once" do
+    freeze_time do
+      at = Time.current
+      concurrently do
+        Notification.find(@notifications.first.id).bundle(at: at)
+      end
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal 1, @user.notification_bundles.sole.entries.count
+    end
+  end
+
+  test "concurrent delivery jobs send one email" do
+    freeze_time do
+      bundle = @notifications.first.bundle
+      travel_to bundle.ends_at
+
+      assert_emails 1 do
+        concurrently { Notification::Bundle.find(bundle.id).deliver }
+      end
+      assert_not_nil bundle.reload.delivered_at
+    end
+  end
+
+  test "direct concurrent creation cannot bypass the nonoverlap invariant" do
+    freeze_time do
+      at = Time.current
+      results = concurrently do |index|
+        Notification::Bundle.create!(user: User.find(@user.id), starts_at: at + index.minutes, ends_at: at + 4.hours + index.minutes)
+        :created
+      rescue ActiveRecord::RecordInvalid
+        :overlapping
+      end
+
+      assert_equal 1, results.count(:created)
+      assert_equal 3, results.count(:overlapping)
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  private
+
+    def concurrently
+      ready = Queue.new
+      start = Queue.new
+      threads = 4.times.map do |index|
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            ready << true
+            start.pop
+            yield index
+          end
+        end
+      end
+      4.times { ready.pop }
+      4.times { start << true }
+      threads.map(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..4f40c77
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,245 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @first = notifications(:logo_assignment_kevin)
+    @second = notifications(:layout_commented_kevin)
+  end
+
+  test "notifications share a window starting with the first arrival and send one email" do
+    freeze_time do
+      bundle = @first.bundle
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+
+      travel 1.hour
+      assert_equal bundle, @second.bundle
+      assert_equal [ @first, @second ].sort_by(&:id), bundle.notifications.order(:id).to_a
+      assert_equal 1, @user.notification_bundles.count
+
+      assert_no_emails { bundle.deliver }
+      travel_to bundle.ends_at
+      assert_emails(1) { bundle.deliver }
+      assert_no_emails { bundle.reload.deliver }
+    end
+  end
+
+  test "each frequency has its own duration and never opens no window" do
+    { "never" => nil, "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, interval|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      @user.notification_bundles.reload.destroy_all
+
+      freeze_time do
+        bundle = @first.bundle
+        if interval
+          assert_equal Time.current, bundle.starts_at
+          assert_equal Time.current + interval, bundle.ends_at
+        else
+          assert_nil bundle
+          assert_empty @user.notification_bundles
+        end
+      end
+    end
+  end
+
+  test "only the first arrival schedules delivery at the end of the window" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, at: 4.hours.from_now) do
+        @first.bundle
+      end
+      assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+        @second.bundle
+      end
+    end
+  end
+
+  test "late arrivals before the start join the existing window without shifting it" do
+    freeze_time do
+      bundle = @first.bundle
+      assert_equal bundle, @second.bundle(at: 2.hours.ago)
+      assert_equal Time.current, bundle.reload.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "the closing boundary belongs to the next window" do
+    freeze_time do
+      first_bundle = @first.bundle
+      next_bundle = @second.bundle(at: first_bundle.ends_at)
+
+      assert_not_equal first_bundle, next_bundle
+      assert_equal first_bundle.ends_at, next_bundle.starts_at
+      assert_equal first_bundle.ends_at + 4.hours, next_bundle.ends_at
+    end
+  end
+
+  test "idle time does not create windows or align them to calendar boundaries" do
+    freeze_time do
+      first_bundle = @first.bundle
+      travel 2.days + 37.minutes
+
+      next_bundle = @second.bundle
+      assert_equal Time.current, next_bundle.starts_at
+      assert_equal 4.hours.from_now, next_bundle.ends_at
+      assert_operator first_bundle.ends_at, :<, next_bundle.starts_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "out of order arrivals join the appropriate pending window" do
+    freeze_time do
+      first_bundle = @first.bundle
+      next_bundle = @second.bundle(at: 5.hours.from_now)
+
+      assert_equal first_bundle, @second.bundle(at: 3.hours.from_now)
+      assert_equal first_bundle, @second.bundle(at: 1.hour.ago)
+      assert_equal next_bundle, @first.bundle(at: 6.hours.from_now)
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "a delayed arrival after delivery never opens overlapping time" do
+    freeze_time do
+      first_bundle = @first.bundle
+      travel_to first_bundle.ends_at
+      first_bundle.deliver
+
+      next_bundle = @second.bundle(at: first_bundle.starts_at - 1.hour)
+      assert_not_equal first_bundle, next_bundle
+      assert_equal first_bundle.ends_at, next_bundle.starts_at
+      assert_nil next_bundle.delivered_at
+    end
+  end
+
+  test "enrollment retries before and after delivery do not duplicate activity" do
+    freeze_time do
+      notified_at = Time.current
+      bundle = @first.bundle(at: notified_at)
+      assert_equal bundle, @first.bundle(at: notified_at)
+      assert_equal 1, bundle.entries.count
+
+      travel_to bundle.ends_at
+      bundle.deliver
+      assert_no_difference [ "Notification::Bundle.count", "Notification::Bundle::Entry.count" ] do
+        assert_equal bundle, @first.bundle(at: notified_at)
+      end
+    end
+  end
+
+  test "repeated activity on a card is listed once within a digest" do
+    freeze_time do
+      bundle = @first.bundle
+      travel 1.hour
+      assert_equal bundle, @first.bundle
+      assert_equal 2, bundle.entries.count
+      assert_equal [ @first ], bundle.notifications.to_a
+    end
+  end
+
+  test "a frequency change only affects the next window" do
+    freeze_time do
+      bundle = @first.bundle
+      @user.settings.update!(bundle_email_frequency: "weekly")
+      assert_equal bundle, @second.bundle(at: 1.hour.from_now)
+      assert_equal 4.hours.from_now, bundle.reload.ends_at
+
+      next_bundle = @second.bundle(at: bundle.ends_at)
+      assert_equal bundle.ends_at, next_bundle.starts_at
+      assert_equal next_bundle.starts_at + 1.week, next_bundle.ends_at
+    end
+  end
+
+  test "recipients have independent windows and preferences" do
+    other_user = users(:david)
+    other_user.settings.update!(bundle_email_frequency: "daily")
+
+    freeze_time do
+      first_bundle = @first.bundle
+      travel 1.hour
+      other_bundle = notifications(:logo_mentioned_david).bundle
+
+      assert_equal 4.hours, first_bundle.ends_at - first_bundle.starts_at
+      assert_equal 1.day.from_now, other_bundle.ends_at
+      assert_equal other_user, other_bundle.user
+      assert_equal @user, first_bundle.user
+      assert_equal @user.account, first_bundle.account
+      assert_equal @user.account, first_bundle.entries.first.account
+    end
+  end
+
+  test "turning email off prevents both enrollment and pending delivery" do
+    freeze_time do
+      bundle = @first.bundle
+      @user.settings.update!(bundle_email_frequency: "never")
+      assert_nil @second.bundle
+
+      travel_to bundle.ends_at
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.reload.delivered_at
+    end
+  end
+
+  test "inactive recipients and system activity are not bundled" do
+    @user.update!(active: false)
+    assert_nil @first.bundle
+    @user.update!(active: true)
+    @first.creator = users(:system)
+    assert_nil @first.bundle
+  end
+
+  test "empty bundles are closed without sending an email" do
+    freeze_time do
+      bundle = @first.bundle
+      @first.destroy!
+      travel_to bundle.ends_at
+
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.delivered_at
+    end
+  end
+
+  test "deactivated recipients do not receive pending mail" do
+    freeze_time do
+      bundle = @first.bundle
+      @user.deactivate
+      travel_to bundle.ends_at
+
+      assert_no_emails { bundle.deliver }
+      assert_not_nil bundle.delivered_at
+    end
+  end
+
+  test "delivery failures leave the window pending for retry" do
+    freeze_time do
+      bundle = @first.bundle
+      travel_to bundle.ends_at
+      NotificationMailer.expects(:bundle).with(bundle).raises(Net::ReadTimeout)
+
+      assert_raises(Net::ReadTimeout) { bundle.deliver }
+      assert_nil bundle.reload.delivered_at
+    end
+  end
+
+  test "overlapping windows are invalid but adjacent windows are allowed" do
+    freeze_time do
+      bundle = @first.bundle
+      overlapping = @user.notification_bundles.build(starts_at: 1.hour.from_now, ends_at: 5.hours.from_now)
+      assert_not overlapping.valid?
+      assert_includes overlapping.errors[:base], "Time window overlaps another email bundle"
+
+      adjacent = @user.notification_bundles.build(starts_at: bundle.ends_at, ends_at: bundle.ends_at + 4.hours)
+      assert adjacent.valid?
+    end
+  end
+
+  test "a window cannot be moved after it opens" do
+    bundle = @first.bundle
+    assert_raises(ActiveRecord::ReadonlyAttributeError) { bundle.update!(starts_at: bundle.starts_at - 1.hour) }
+    assert_raises(ActiveRecord::ReadonlyAttributeError) { bundle.update!(ends_at: bundle.ends_at + 1.hour) }
+  end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
