@@ -0,0 +1,17 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_entries, class_name: "Notification::Bundle::Entry", dependent: :delete_all
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self, at: updated_at)
+  end
+
+  def bundle(at: Time.current)
+    Notification::Bundle.add(self, at: at)
+  end
+end
