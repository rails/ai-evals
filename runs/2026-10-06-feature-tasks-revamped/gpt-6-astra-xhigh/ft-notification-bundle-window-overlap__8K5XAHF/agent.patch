diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..b15d102
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,80 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, dependent: :delete_all
+  has_many :notifications, -> { distinct }, through: :entries
+
+  attr_readonly :user_id, :account_id, :starts_at, :ends_at
+
+  scope :pending, -> { where(delivered_at: nil) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+  validate :does_not_overlap, on: :create
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at:)
+      # Lock the recipient, not a bundle: two first arrivals must not both open a window.
+      notification.user.with_lock do
+        if entry = notification.bundle_entries.lock.find_by(notified_at: at)
+          entry.bundle
+        elsif bundleable?(notification)
+          bundle = find_or_open_for(notification.user, at: at)
+          bundle.entries.create!(notification: notification, notified_at: at)
+          bundle
+        end
+      end
+    end
+
+    private
+      def bundleable?(notification)
+        !notification.creator.system? && notification.user.active? && notification.account.active? &&
+          notification.user.identity.present? && notification.user.settings&.reload&.bundle_email_interval.present?
+      end
+
+      def find_or_open_for(user, at:)
+        # There is deliberately no lower bound: late arrivals join an already-opened
+        # window rather than opening an earlier, overlapping one.
+        user.notification_bundles.pending.where("ends_at > ?", at).order(:ends_at).lock.first || open_for(user, at: at)
+      end
+
+      def open_for(user, at:)
+        # Never reopen delivered time, including when all pending windows have closed.
+        starts_at = [ at, user.notification_bundles.order(ends_at: :desc).lock.pick(:ends_at) ].compact.max
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + user.settings.bundle_email_interval)
+      end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    # Enrollment and delivery use the same lock so a late arrival cannot be attached
+    # while the mail is being rendered or after the window has been delivered.
+    user.with_lock do
+      reload(lock: true)
+      if delivered_at.nil? && ends_at <= Time.current
+        if user.active? && account.active? && user.identity.present? &&
+            user.settings&.reload&.bundle_email_interval.present? && notifications.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def does_not_overlap
+      if user && starts_at && ends_at
+        # During creation this lock is held until the save transaction commits.
+        user.with_lock do
+          if user.notification_bundles.where("starts_at < ? AND ends_at > ?", ends_at, starts_at).lock.exists?
+            errors.add(:base, "Time window overlaps another email bundle")
+          end
+        end
+      end
+    end
+end
