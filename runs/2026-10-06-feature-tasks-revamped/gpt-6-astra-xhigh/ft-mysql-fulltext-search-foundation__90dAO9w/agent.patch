+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "all query words must appear in the title description or comments" do
+    card = create_card(title: "Lunar plans", description: "A space mission")
+    card.comments.create!(body: "Prepare the rocket", creator: users(:kevin))
+    card.comments.create!(body: "Bring provisions", creator: users(:kevin))
+    create_card(title: "Lunar mission rocket")
+
+    assert_results "  LUNAR   mission rocket\nprovisions  ", card
+  end
+
+  test "blank queries return no cards or comments" do
+    [ nil, "", " \n\t " ].each do |query|
+      search = Search.new(user: users(:kevin), query: query)
+      assert_empty search.cards
+      assert_empty search.comments_for(Card.all)
+    end
+  end
+
+  test "only boards currently accessible to the user are searched" do
+    card = create_card(board: boards(:private), title: "Secretneedle")
+    comment = card.comments.create!(body: "Secretneedle", creator: users(:kevin))
+    search = Search.new(user: users(:david), query: "Secretneedle")
+
+    assert_empty search.cards
+    assert_empty search.comments_for([ card ])
+
+    access = boards(:private).accesses.create!(user: users(:david))
+    assert_equal [ card ], search.cards.to_a
+    assert_equal [ comment ], search.comments_for([ card ]).to_a
+
+    access.destroy!
+    assert_empty search.cards
+    assert_empty search.comments_for([ card ])
+  end
+
+  test "another account's cards and comments are not searched" do
+    cards(:radio).update!(title: "Accountneedle")
+    cards(:radio).comments.create!(body: "Accountneedle", creator: users(:mike))
+
+    assert_results "Accountneedle"
+    assert_results "Accountneedle", cards(:radio), user: users(:mike)
+  end
+
+  test "draft titles descriptions and comments are excluded until publication" do
+    title_draft = create_card(title: "Draftneedle", status: :drafted)
+    description_draft = create_card(title: "Description draft", description: "Draftneedle", status: :drafted)
+    comment_draft = create_card(title: "Comment draft")
+    comment_draft.comments.create!(body: "Draftneedle", creator: users(:kevin))
+    comment_draft.drafted!
+
+    assert_results "Draftneedle"
+    search = Search.new(user: users(:kevin), query: "Draftneedle")
+    assert_empty search.comments_for([ comment_draft ])
+
+    title_draft.publish
+    description_draft.publish
+    comment_draft.publish
+    assert_results "Draftneedle", comment_draft, description_draft, title_draft
+  end
+
+  test "moving a card changes search visibility immediately" do
+    card = create_card(title: "Moveneedle")
+    card.comments.create!(body: "Moveneedle", creator: users(:kevin))
+
+    assert_results "Moveneedle", card, user: users(:david)
+    card.move_to(boards(:private))
+    assert_results "Moveneedle", user: users(:david)
+    card.move_to(boards(:writebook))
+    assert_results "Moveneedle", card, user: users(:david)
+  end
+
+  test "edits and deletions are reflected immediately" do
+    card = create_card(title: "Beforetitle", description: "Beforedescription")
+    comment = card.comments.create!(body: "Beforecomment", creator: users(:kevin))
+
+    card.update!(title: "Aftertitle")
+    card.rich_text_description.update!(body: "<strong>Afterdescription</strong>")
+    comment.update!(body: "<em>Aftercomment</em>")
+    card.comments.by_system.destroy_all # Title changes are retained in history comments.
+
+    %w[ Beforetitle Beforedescription Beforecomment ].each { |query| assert_results query }
+    %w[ Aftertitle Afterdescription Aftercomment ].each { |query| assert_results query, card }
+
+    comment.destroy!
+    assert_results "Aftercomment"
+    card.update!(description: "")
+    assert_results "Afterdescription"
+    card.destroy!
+    assert_results "Aftertitle"
+  end
+
+  test "rich text is searched as visible text not HTML markup" do
+    card = create_card(title: "Rich text", description: '<p title="hiddenneedle">Need<strong>le</strong> &amp; thread</p>')
+    card.comments.create!(body: "<p>Rock&amp;roll</p>", creator: users(:kevin))
+
+    assert_results "needle", card
+    assert_results "Rock&roll", card
+    assert_results "hiddenneedle"
+    assert_results "strong"
+    assert_results "amp"
+  end
+
+  test "SQL wildcards and regular expression characters are literal" do
+    [ "%", "_", "!", "\\", "[x]", "a.b", "can't", "' OR 1=1 --" ].each do |query|
+      card = create_card(title: "Literal #{query}", description: query)
+      assert_results query, card
+      card.destroy!
+    end
+  end
+
+  test "results are ordered by creation not activity with stable ordering for ties" do
+    older = create_card(title: "Orderneedle", created_at: 2.days.ago)
+    newer = create_card(title: "Orderneedle", created_at: 1.day.ago)
+    tied = create_card(title: "Orderneedle", created_at: newer.created_at)
+    older.comments.create!(body: "Orderneedle", creator: users(:kevin))
+
+    assert_results "Orderneedle", *[ newer, tied ].sort_by(&:id).reverse, older
+  end
+
+  test "existing rich text fixtures are searchable" do
+    assert_results "overflowing", cards(:layout)
+  end
+
+  private
+    def create_card(**attributes)
+      Card.create!(board: boards(:writebook), creator: users(:kevin), status: :published, **attributes)
+    end
+
+    def assert_results(query, *cards, user: users(:kevin))
+      assert_equal cards, Search.new(user: user, query: query).cards.to_a, "Query: #{query}"
+    end
+end
