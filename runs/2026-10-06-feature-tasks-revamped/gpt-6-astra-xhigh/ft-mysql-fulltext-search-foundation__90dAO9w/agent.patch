diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..69ec134
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,22 @@
+module SearchesHelper
+  def highlight_search_result(text, terms)
+    if terms.any?
+      parts = text.to_s.split(search_pattern_for(terms))
+      safe_join(parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_result_excerpt(content, terms)
+    text = content.to_plain_text.squish
+    match = text.match(search_pattern_for(terms)) if terms.any?
+    snippet = match ? excerpt(text, match[0], radius: 100) : text.truncate(200)
+    highlight_search_result(snippet, terms)
+  end
+
+  private
+    def search_pattern_for(terms)
+      Regexp.new("(#{Regexp.union(terms.sort_by { |term| -term.length }).source})", Regexp::IGNORECASE)
+    end
+end
