+require "test_helper"
+require Rails.root.join("db/migrate/20260710120000_add_plain_text_body_to_action_text_rich_texts")
+
+class AddPlainTextBodyToActionTextRichTextsTest < ActiveSupport::TestCase
+  test "backfills existing descriptions and comments" do
+    card = cards(:logo)
+    card.update!(description: "<p>Backfill<strong>needle</strong> &amp; text</p>")
+    ActionText::RichText.update_all(plain_text_body: nil)
+    migration = AddPlainTextBodyToActionTextRichTexts.new
+    migration.expects(:add_column).with(:action_text_rich_texts, :plain_text_body, :text, limit: 4_294_967_295)
+
+    migration.up
+
+    assert_equal "Backfillneedle & text", card.reload.description.plain_text_body
+    assert_equal [ card ], Search.new(user: users(:kevin), query: "Backfillneedle").cards.to_a
+    assert_equal [ cards(:layout) ], Search.new(user: users(:kevin), query: "overflowing").cards.to_a
+  end
+end
