+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center margin-block-start">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…", class: "input", autofocus: true %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @search.terms.empty? %>
+    <p>Search card titles, descriptions, and comments.</p>
