+      "body" => "<p>Import<strong>needle</strong> &amp; data</p>",
+      "created_at" => Time.current,
+      "updated_at" => Time.current
+    }
+    record_set = Account::DataTransfer::ActionText::RichTextRecordSet.new(card.account)
+    record_set.stubs(:load).with("description.json").returns(data)
+
+    record_set.send(:import_batch, [ "description.json" ])
+
+    assert_equal "Importneedle & data", card.reload.description.plain_text_body
+    assert_equal [ card ], Search.new(user: users(:kevin), query: "Importneedle").cards.to_a
+  end
