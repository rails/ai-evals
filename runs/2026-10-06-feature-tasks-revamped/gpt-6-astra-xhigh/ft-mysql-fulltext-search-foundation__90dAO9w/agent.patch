diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..3a3cc18
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights case insensitively while preserving the original text" do
+    assert_equal "<mark>Needle</mark> and <mark>NEEDLE</mark>", highlight_search_result("Needle and NEEDLE", [ "needle" ])
+  end
+
+  test "escapes content and query characters instead of rendering HTML" do
+    text = '<img src=x onerror="alert(1)"> & <script>alert(1)</script>'
+    result = highlight_search_result(text, [ "<script>", "&" ])
+
+    assert_includes result, "<mark>&lt;script&gt;</mark>"
+    assert_includes result, "<mark>&amp;</mark>"
+    assert_no_match(/<(img|script)/, result)
+    assert_equal text, Nokogiri::HTML.fragment(result).text
+  end
+
+  test "treats regular expression characters literally" do
+    assert_equal "<mark>[a.b]</mark> axb", highlight_search_result("[a.b] axb", [ "[a.b]" ])
+  end
+
+  test "highlights the longest overlapping term" do
+    assert_equal "<mark>needles</mark>", highlight_search_result("needles", [ "needle", "needles" ])
+  end
+
+  test "excerpts include matches deep in rich text" do
+    content = ActionText::Content.new("<p>#{'before ' * 100}Needle #{'after ' * 100}</p>")
+    result = search_result_excerpt(content, [ "needle" ])
+
+    assert_includes result, "<mark>Needle</mark>"
+    assert_operator result.length, :<, 250
+  end
+
+  test "unmatched excerpts are escaped exactly once" do
+    content = ActionText::Content.new("<p>Rock &amp; roll</p>")
+    assert_equal "Rock &amp; roll", search_result_excerpt(content, [ "absent" ])
+  end
+end
