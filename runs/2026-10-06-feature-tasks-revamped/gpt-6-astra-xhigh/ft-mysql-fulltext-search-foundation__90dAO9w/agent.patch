diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..a1ae6e5
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,54 @@
+class Search
+  attr_reader :query, :terms
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.squish
+    @terms = @query.split.uniq
+  end
+
+  def cards
+    cards = accessible_cards
+
+    if terms.any?
+      terms.each { |term| cards = cards.merge(cards_matching(term)) }
+      cards.reverse_chronologically
+    else
+      cards.none
+    end
+  end
+
+  def comments_for(cards)
+    if terms.any?
+      rich_texts = terms.map { |term| rich_texts_matching(term) }.reduce(&:or)
+      Comment.where(card: accessible_cards.where(id: cards), id: rich_texts.where(record_type: "Comment", name: "body").select(:record_id))
+        .with_rich_text_body.chronologically
+    else
+      Comment.none
+    end
+  end
+
+  private
+    def accessible_cards
+      @user.accessible_cards.published.where(account: @user.account)
+    end
+
+    def cards_matching(term)
+      rich_texts = rich_texts_matching(term)
+      descriptions = rich_texts.where(record_type: "Card", name: "description")
+      comments = Comment.where(id: rich_texts.where(record_type: "Comment", name: "body").select(:record_id))
+
+      Card.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern_for(term))
+        .or(Card.where(id: descriptions.select(:record_id)))
+        .or(Card.where(id: comments.select(:card_id)))
+    end
+
+    def rich_texts_matching(term)
+      ActionText::RichText.where(account: @user.account)
+        .where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern_for(term))
+    end
+
+    def pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase, "!")}%"
+    end
+end
