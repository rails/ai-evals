diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..7d744d5
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles descriptions and comments newest first without duplicates" do
+    title_match = create_card(title: "Searchneedle in the title", created_at: 3.days.ago)
+    description_match = create_card(title: "Description match", description: "A <strong>searchneedle</strong> in the description", created_at: 2.days.ago)
+    comment_match = create_card(title: "Comment match", created_at: 1.day.ago)
+    2.times { comment_match.comments.create!(body: "A searchneedle in a comment", creator: users(:kevin)) }
+    create_card(title: "Unrelated")
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_select "article.search-result" do |results|
+      assert_equal [ comment_match, description_match, title_match ].map { |card| dom_id(card, :search_result) }, results.map { |result| result["id"] }
+    end
+    [ title_match, description_match, comment_match ].each do |card|
+      assert_select "##{dom_id(card, :search_result)} mark", text: /searchneedle/i
+      assert_select "##{dom_id(card, :search_result)} a[href='#{card_path(card)}']"
+    end
+  end
+
+  test "search requires authentication" do
+    sign_out
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+
+  test "search does not expose inaccessible boards or other accounts" do
+    visible = create_card(title: "Accessneedle")
+    hidden = create_card(board: boards(:private), title: "Accessneedle private", description: "Accessneedle secret description")
+    hidden.comments.create!(body: "Accessneedle secret comment", creator: users(:kevin))
+    cards(:radio).update!(title: "Accessneedle other account")
+    logout_and_sign_in_as :david
+
+    get search_path(q: "Accessneedle")
+
+    assert_response :success
+    assert_search_results visible
+    assert_not_includes response.body, "secret description"
+    assert_not_includes response.body, "secret comment"
+    assert_not_includes response.body, "other account"
+  end
+
+  test "revoking access removes results on the next request" do
+    card = create_card(board: boards(:private), title: "Revokedneedle")
+    card.comments.create!(body: "Revokedneedle comment", creator: users(:kevin))
+
+    get search_path(q: "Revokedneedle")
+    assert_search_results card
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+
+    accesses(:private_kevin).destroy!
+    get search_path(q: "Revokedneedle")
+    assert_response :success
+    assert_search_results
+    assert_not_includes response.body, "Revokedneedle comment"
+  end
+
+  test "drafts and comments on drafts never appear" do
+    create_card(title: "Draftneedle title", description: "Draftneedle description", status: :drafted)
+    card = create_card(title: "Unpublished")
+    card.comments.create!(body: "Draftneedle comment", creator: users(:kevin))
+    card.drafted!
+
+    get search_path(q: "Draftneedle")
+
+    assert_response :success
+    assert_search_results
+    assert_not_includes response.body, "Draftneedle title"
+    assert_not_includes response.body, "Draftneedle description"
+    assert_not_includes response.body, "Draftneedle comment"
+  end
+
+  test "blank search shows the form without listing cards" do
+    [ nil, "", " \n " ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_search_results
+      assert_select "form[action='#{search_path}'][method='get'] input[name=q]"
+      assert_select "p", text: "Search card titles, descriptions, and comments."
+    end
+  end
+
+  test "queries and results are safely escaped" do
+    card = create_card(title: '<script>alert("needle")</script>', description: "<p>Rock &amp; needle</p>")
+    get search_path(q: "needle")
+
+    assert_response :success
+    assert_search_results card
+    assert_select "article script", count: 0
+    assert_select "article h2 mark", text: "needle"
+    assert_select "article p mark", text: "needle"
+
+    get search_path(q: '"><img src=x onerror=alert(1)>')
+    assert_response :success
+    assert_select "#main img", count: 0
+    assert_search_results
+  end
+
+  test "pagination retains the query and newest first order" do
+    cards = 30.times.map do |index|
+      create_card(title: "Pageneedle #{index}", created_at: index.minutes.ago)
+    end
+
+    get search_path(q: "Pageneedle")
+    assert_response :success
+    first_page_ids = css_select("article.search-result").map { |result| result["id"] }
+    assert_equal cards.first(first_page_ids.size).map { |card| dom_id(card, :search_result) }, first_page_ids
+    assert_operator first_page_ids.size, :<, cards.size
+
+    next_page = css_select("a.pagination-link").first["href"]
+    assert_includes next_page, "q=Pageneedle"
+    get next_page
+    assert_response :success
+    second_page_ids = css_select("article.search-result").map { |result| result["id"] }
+    assert_equal cards.drop(first_page_ids.size).first(second_page_ids.size).map { |card| dom_id(card, :search_result) }, second_page_ids
+    assert_empty first_page_ids & second_page_ids
+  end
+
+  private
+    def assert_search_results(*cards)
+      assert_equal cards.map { |card| dom_id(card, :search_result) }, css_select("article.search-result").map { |result| result["id"] }
+    end
+
+    def create_card(**attributes)
+      Card.create!(board: boards(:writebook), creator: users(:kevin), status: :published, **attributes)
+    end
+end
