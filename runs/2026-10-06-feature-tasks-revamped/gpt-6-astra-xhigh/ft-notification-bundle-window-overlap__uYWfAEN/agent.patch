diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..480fdca
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,65 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :memberships, dependent: :destroy
+  has_many :notifications, through: :memberships
+
+  scope :pending, -> { where(processed_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+
+  class << self
+    def add(notification)
+      user = notification.user
+
+      # Lock the recipient, not a bundle: there may not be a window to lock yet.
+      user.with_lock do
+        if interval = user.settings&.bundle_email_interval
+          now = Time.current
+          bundle = user.notification_bundles.order(ends_at: :desc).first
+
+          # Windows follow arrival time, not the source's timestamp. Late arrivals
+          # belong to the open window, and frequency changes must not resize it.
+          if bundle.nil? || bundle.ends_at <= now
+            bundle = user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+          end
+
+          bundle.memberships.create_or_find_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver_later)
+    end
+  end
+
+  def deliver_later
+    Current.with_account(account) do
+      Notification::Bundle::DeliveryJob.perform_later(self)
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+
+      if processed_at.nil? && ends_at <= Time.current
+        if email_enabled? && notifications.unread.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(processed_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def email_enabled?
+      user.active? && user.identity.present? && account.active? && user.settings&.bundle_email_interval.present?
+    end
+end
