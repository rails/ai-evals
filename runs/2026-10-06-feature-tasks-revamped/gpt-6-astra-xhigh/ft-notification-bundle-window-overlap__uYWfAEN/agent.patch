@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  # Separate connections must observe committed data and acquire real DB locks.
+  self.use_transactional_tests = false
+
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    @identity = Identity.create!(email_address: "digest-concurrency@example.com")
+    @user = accounts("37s").users.create!(name: "Digest recipient", identity: @identity)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = @user.notifications.create!(source: events(:logo_published), creator: users(:david))
+  end
+
+  teardown do
+    @user&.destroy!
+    @identity&.destroy!
+  end
+
+  test "simultaneous arrivals open one window" do
+    bundles = concurrently do
+      Notification::Bundle.add(Notification.find(@notification.id))
+    end
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal [ @notification ], bundles.first.notifications
+  end
+
+  test "simultaneous delivery attempts send one email" do
+    bundle = Notification::Bundle.add(@notification)
+    travel_to bundle.ends_at
+
+    assert_emails 1 do
+      concurrently { Notification::Bundle.find(bundle.id).deliver }
+    end
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  private
+    def concurrently
+      ready = Queue.new
+      start = Queue.new
+      threads = 4.times.map do
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            ready << true
+            start.pop
+            yield
+          end
+        end
+      end
+      4.times { ready.pop }
+      4.times { start << true }
+      threads.map(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..78ab782
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,221 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:logo_assignment_kevin)
+    freeze_time
+  end
+
+  test "off does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "each frequency starts its clock with the first arrival" do
+    { every_few_hours: 4.hours, daily: 1.day, weekly: 1.week }.each do |frequency, interval|
+      @user.notification_bundles.reload.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      bundle = Notification::Bundle.add(@notification)
+
+      assert_equal Time.current, bundle.starts_at
+      assert_equal Time.current + interval, bundle.ends_at
+      assert_equal @user.account, bundle.account
+      assert_equal [ @notification ], bundle.notifications
+    end
+  end
+
+  test "late notifications join the already open window without moving its clock" do
+    bundle = Notification::Bundle.add(@notification)
+    late_notification = notifications(:layout_commented_kevin)
+    late_notification.update_columns(created_at: 2.days.ago, updated_at: 2.days.ago)
+
+    travel 1.hour
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_equal bundle, Notification::Bundle.add(late_notification)
+    end
+    assert_equal 3.hours.from_now, bundle.reload.ends_at
+    assert_equal [ @notification, late_notification ].sort, bundle.notifications.sort
+  end
+
+  test "processing a notification twice only includes it once" do
+    bundle = Notification::Bundle.add(@notification)
+
+    assert_no_difference "Notification::Bundle::Membership.count" do
+      assert_equal bundle, Notification::Bundle.add(Notification.find(@notification.id))
+    end
+  end
+
+  test "the end boundary starts a new nonoverlapping window even before the old one is delivered" do
+    first = Notification::Bundle.add(@notification)
+    travel_to first.ends_at
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+    assert_not_equal first, second
+    assert_equal first.ends_at, second.starts_at
+    assert_equal 4.hours.from_now, second.ends_at
+  end
+
+  test "a quiet period does not open empty windows" do
+    first = Notification::Bundle.add(@notification)
+    travel 3.days
+    second = Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+    assert_equal Time.current, second.starts_at
+    assert_operator first.ends_at, :<, second.starts_at
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "changing frequency applies only to the next window" do
+    first = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    travel 1.hour
+
+    assert_equal first, Notification::Bundle.add(notifications(:layout_commented_kevin))
+    assert_equal 3.hours.from_now, first.reload.ends_at
+
+    travel_to first.ends_at
+    second = Notification::Bundle.add(@notification)
+    assert_equal 1.week.from_now, second.ends_at
+  end
+
+  test "recipients have independent windows and frequencies" do
+    users(:david).settings.update!(bundle_email_frequency: :daily)
+    kevin_bundle = Notification::Bundle.add(@notification)
+    david_bundle = Notification::Bundle.add(notifications(:logo_mentioned_david))
+
+    assert_equal @user, kevin_bundle.user
+    assert_equal users(:david), david_bundle.user
+    assert_equal 1.day.from_now, david_bundle.ends_at
+    assert_not_includes david_bundle.notifications, @notification
+  end
+
+  test "one email contains the unread notifications and a completed window is not delivered twice" do
+    bundle = Notification::Bundle.add(@notification)
+    Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+    assert_no_emails { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+
+    travel_to bundle.ends_at
+    assert_emails 1 do
+      bundle.deliver
+      Notification::Bundle.find(bundle.id).deliver
+    end
+    assert_equal Time.current, bundle.reload.processed_at
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    [ @notification, notifications(:layout_commented_kevin) ].each do |notification|
+      assert_includes email.html_part.body.decoded, ERB::Util.html_escape(notification.payload.title)
+      assert_includes email.text_part.body.decoded, notification.payload.url
+    end
+  end
+
+  test "switching off suppresses pending emails" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "read or deleted notifications do not produce empty emails" do
+    bundle = Notification::Bundle.add(@notification)
+    other = notifications(:layout_commented_kevin)
+    Notification::Bundle.add(other)
+    @notification.read
+    other.destroy!
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "delivery failure leaves the window pending for retry" do
+    bundle = Notification::Bundle.add(@notification)
+    travel_to bundle.ends_at
+    NotificationMailer.expects(:bundle).with(bundle).raises(RuntimeError)
+
+    assert_raises(RuntimeError) { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+  end
+  test "inactive users do not receive pending digests" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.deactivate
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "cancelled accounts do not receive pending digests" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.account.create_cancellation!(initiated_by: @user)
+    travel_to bundle.ends_at
+
+    assert_no_emails { bundle.deliver }
+    assert_not_nil bundle.reload.processed_at
+  end
+
+  test "turning digests off and back on does not create overlapping windows" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel 1.hour
+    assert_nil Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+    @user.settings.update!(bundle_email_frequency: :daily)
+    assert_equal bundle, Notification::Bundle.add(notifications(:layout_commented_kevin))
+    assert_equal 3.hours.from_now, bundle.reload.ends_at
+  end
+
+  test "new activity on an existing notification is bundled but reading it is not" do
+    assert_includes Notification.push_targets, Notification::PushTarget::Email
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      @notification.update!(source: events(:logo_published))
+    end
+    bundle = @user.notification_bundles.sole
+    assert_equal [ @notification ], bundle.notifications
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "deleting a recipient cleans up their windows and memberships" do
+    Notification::Bundle.add(@notification)
+
+    assert_difference "Notification::Bundle.count", -1 do
+      assert_difference "Notification::Bundle::Membership.count", -1 do
+        @user.destroy!
+      end
+    end
+  end
+  test "an arrival immediately before the deadline remains in the open window" do
+    bundle = Notification::Bundle.add(@notification)
+    travel_to bundle.ends_at - Rational(1, 1_000_000), with_usec: true
+
+    assert_equal bundle, Notification::Bundle.add(notifications(:layout_commented_kevin))
+    assert_no_emails { bundle.deliver }
+    assert_nil bundle.reload.processed_at
+  end
+
+  test "users without settings do not open windows" do
+    @user.settings.destroy!
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+end
