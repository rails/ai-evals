@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Notification::Bundle::DeliveryJobTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    freeze_time
+    users(:kevin).settings.update!(bundle_email_frequency: :every_few_hours)
+    @bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+  end
+
+  test "only due windows are enqueued with their own account context" do
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      Notification::Bundle.deliver_due
+    end
+
+    travel_to @bundle.ends_at
+    Current.account = accounts(:initech)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ @bundle ]) do
+      Notification::Bundle.deliver_due
+    end
+    assert_equal @bundle.account.to_gid.to_s, enqueued_jobs.last["account"].to_s
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+    end
+    assert_not_nil @bundle.reload.processed_at
+    assert_equal accounts(:initech), Current.account
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      Notification::Bundle.deliver_due
+    end
+  end
+
+  test "a window deleted before delivery is discarded" do
+    @bundle.deliver_later
+    @bundle.destroy!
+
+    assert_no_emails do
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+    end
+  end
+end
diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..0b2838c
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "digests render mentions and events with recipient account links" do
+    user = users(:david)
+    user.settings.update!(bundle_email_frequency: :daily)
+    mention = notifications(:logo_mentioned_david)
+    event = user.notifications.create!(source: events(:layout_commented), creator: users(:jz))
+    bundle = Notification::Bundle.add(mention)
+    Notification::Bundle.add(event)
+    Current.account = accounts(:initech)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails(1) { email.deliver_now }
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "Your Fizzy notification digest", email.subject
+    [ mention, event ].each do |notification|
+      assert_includes email.html_part.body.decoded, ERB::Util.html_escape(notification.payload.title)
+      assert_includes email.text_part.body.decoded, notification.payload.body
+      assert_includes email.text_part.body.decoded, notification.payload.url
+    end
+    assert_includes email.html_part.body.decoded, "#{user.account.slug}/notifications/settings"
+    assert_not_includes email.html_part.body.decoded, "#{accounts(:initech).slug}/notifications/settings"
+  end
+
+  test "read notifications are omitted from a digest" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :daily)
+    bundle = Notification::Bundle.add(notifications(:logo_assignment_kevin))
+    read_notification = notifications(:layout_commented_kevin)
+    Notification::Bundle.add(read_notification)
+    read_notification.read
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_not_includes email.text_part.body.decoded, read_notification.payload.url
+    assert_includes email.text_part.body.decoded, notifications(:logo_assignment_kevin).payload.url
+  end
+end
