diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..a02cb02
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "matches are case insensitive and regex characters are literal" do
+    assert_equal "<mark>Needle</mark> and <mark>NEEDLE</mark>", highlight_search_result("Needle and NEEDLE", "needle")
+    assert_equal "<mark>[test]</mark> test", highlight_search_result("[test] test", "[test]")
+    assert_equal "<mark>needles</mark>", highlight_search_result("needles", "needle needles")
+  end
+
+  test "text is escaped without highlighting inside HTML entities" do
+    assert_equal "&lt;script&gt;<mark>needle</mark>&lt;/script&gt;", highlight_search_result("<script>needle</script>", "needle")
+    assert_equal "&amp; <mark>amp</mark>", highlight_search_result("& amp", "amp")
+    assert_equal "<mark>&lt;script&gt;</mark>", highlight_search_result("<script>", "<script>")
+    assert_equal "&lt;script&gt;", highlight_search_result("<script>", "")
+  end
+
+  test "excerpts center on a match and preserve safe plain text" do
+    content = ActionText::Content.new("<p>#{'padding ' * 100}&lt;script&gt;needle&lt;/script&gt;</p>")
+    result = search_result_excerpt(content, "needle")
+    assert_includes result, "&lt;script&gt;<mark>needle</mark>&lt;/script&gt;"
+    assert_operator result.length, :<, 250
+  end
+end
