diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..cdd6692
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,24 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      words = query.to_s.split.uniq
+
+      if words.any?
+        words.reduce(published) do |cards, word|
+          matching_text = ActionText::RichText.containing_any_word(word)
+          descriptions = matching_text.where(record_type: "Card", name: "description").select(:record_id)
+          comment_bodies = matching_text.where(record_type: "Comment", name: "body").select(:record_id)
+          commented_cards = Comment.where(id: comment_bodies).select(:card_id)
+
+          cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", "%#{sanitize_sql_like(word.downcase, "!")}%")
+            .or(cards.where(id: descriptions))
+            .or(cards.where(id: commented_cards))
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
