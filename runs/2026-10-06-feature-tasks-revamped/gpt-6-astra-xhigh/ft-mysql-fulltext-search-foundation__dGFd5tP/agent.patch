+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "content edits and deletions are reflected immediately" do
+    card = cards(:logo)
+    card.update_columns title: "searchtitle"
+    card.update! description: "<p>searchdescription</p>"
+    comment = card.comments.create!(body: "<p>searchcomment</p>")
+
+    [ "searchtitle", "searchdescription", "searchcomment" ].each do |query|
+      assert_equal [ card ], search(query)
+    end
+
+    card.update_columns title: "replacementtitle"
+    card.update! description: "<p>replacementdescription</p>"
+    comment.update! body: "<p>replacementcomment</p>"
+
+    [ "searchtitle", "searchdescription", "searchcomment" ].each do |query|
+      assert_empty search(query)
+    end
+    [ "replacementtitle", "replacementdescription", "replacementcomment" ].each do |query|
+      assert_equal [ card ], search(query)
+    end
+
+    comment.destroy!
+    assert_empty search("replacementcomment")
+    card.update! description: ""
+    assert_empty search("replacementdescription")
+    card.destroy!
+    assert_empty search("replacementtitle")
+  end
+
+  test "moving a card changes access to both its content and its comments immediately" do
+    card = cards(:logo)
+    card.update! title: "searchtitle"
+    card.comments.create!(body: "searchcomment")
+    assert_equal [ card ], search("searchtitle")
+    assert_equal [ card ], search("searchcomment")
+
+    card.move_to boards(:private)
+    assert_empty search("searchtitle")
+    assert_empty search("searchcomment")
+
+    card.move_to boards(:writebook)
+    assert_equal [ card ], search("searchtitle")
+    assert_equal [ card ], search("searchcomment")
+  end
+
+  test "publishing and drafting a card changes visibility of all its content" do
+    card = cards(:logo)
+    card.update! title: "searchtitle"
+    card.comments.create!(body: "searchcomment")
+    card.drafted!
+    assert_empty search("searchtitle")
+    assert_empty search("searchcomment")
+
+    card.publish
+    assert_equal [ card ], search("searchtitle")
+    assert_equal [ card ], search("searchcomment")
+  end
+
+  test "closed and postponed cards are still searchable" do
+    cards(:shipping).update! title: "searchtitle"
+    cards(:logo).update! title: "searchtitle"
+    cards(:logo).postpone
+
+    assert_equal cards(:logo, :shipping).sort_by(&:id).reverse, search("searchtitle")
+  end
+
+  test "a direct rich text edit updates the searchable plain text" do
+    comment = comments(:logo_agreement_jz)
+    comment.rich_text_body.update! body: "A <strong>newword</strong> &amp; another"
+    assert_equal "A newword & another", comment.rich_text_body.reload.plain_text_body
+    assert_equal [ comment.card ], search("newword")
+    assert_empty search("agree")
+  end
+
+  test "literal wildcard and escape characters in rich text" do
+    cards(:logo).update! description: "100% foo_bar wow!"
+    cards(:layout).comments.create! body: "100% foo_bar wow!"
+    cards(:text).update! description: "1000 fooXbar wow"
+
+    [ "100%", "foo_bar", "wow!" ].each do |query|
+      assert_equal cards(:logo, :layout).map(&:id).sort, search(query).map(&:id).sort
+    end
+  end
+
+  private
+    def search(query)
+      users(:david).accessible_cards.search(query).to_a
+    end
+end
