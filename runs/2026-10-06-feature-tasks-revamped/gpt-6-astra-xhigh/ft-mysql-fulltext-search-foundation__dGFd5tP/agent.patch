diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..5213e9b
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide center txt-break">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap margin-block-end" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn btn--link" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="txt-subtle">Search card titles, descriptions, and comments.</p>
+  <% elsif @page.records.empty? %>
+    <p role="status">No cards found for “<%= @query %>”.</p>
+  <% else %>
+    <section id="search_results" aria-label="Search results">
+      <%= with_manual_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article id="<%= dom_id(card, :search_result) %>" class="search-result border-top margin-block-end">
+            <p class="txt-small txt-subtle"><%= card.board.name %> · <%= local_datetime_tag card.created_at %></p>
+            <h2><%= link_to highlight_search_result(card.title, @query), card_path(card) %></h2>
+            <% if card.description.present? %>
+              <p class="search-result__description"><%= search_result_excerpt(card.description, @query) %></p>
+            <% end %>
+            <% @matching_comments.fetch(card.id, []).each do |comment| %>
+              <p class="search-result__comment"><%= link_to search_result_excerpt(comment.body, @query), card_path(card, anchor: dom_id(comment)) %></p>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    </section>
+  <% end %>
+</section>
