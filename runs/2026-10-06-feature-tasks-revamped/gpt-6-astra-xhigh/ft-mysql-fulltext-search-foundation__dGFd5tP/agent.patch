+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query).preload(:board, :rich_text_description)
+    @matching_comments = Comment.where(card_id: @page.records.map(&:id))
+      .joins(:rich_text_body).merge(ActionText::RichText.containing_any_word(@query))
+      .with_rich_text_body.chronologically.group_by(&:card_id)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..0c4a6ce
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,25 @@
+module SearchesHelper
+  def highlight_search_result(text, query)
+    if query.present?
+      # Escape each plain-text fragment, adding only our own markup.
+      safe_join(text.to_s.split(/(#{search_pattern(query)})/).each_with_index.map do |fragment, index|
+        index.odd? ? tag.mark(fragment) : fragment
+      end)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_result_excerpt(content, query)
+    text = content.to_plain_text.squish
+    match = text.match(search_pattern(query)) if query.present?
+    snippet = match ? excerpt(text, match[0], radius: 100) : truncate(text, length: 200)
+    highlight_search_result(snippet, query)
+  end
+
+  private
+    def search_pattern(query)
+      words = query.split.uniq.sort_by { |word| -word.length }
+      Regexp.new(words.map { |word| Regexp.escape(word) }.join("|"), Regexp::IGNORECASE)
+    end
+end
