diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8c795da
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.session = sessions(:david)
+  end
+
+  test "finds titles, descriptions, and comments once each, newest first" do
+    title_match = create_card(title: "Needle in the title", created_at: 3.days.ago)
+    description_match = create_card(description: "A <strong>needle</strong> in the description", created_at: 2.days.ago)
+    comment_match = create_card(created_at: 1.day.ago)
+    2.times { comment_match.comments.create!(body: "A NEEDLE in a comment", creator: users(:david)) }
+    create_card(title: "Unrelated")
+
+    get search_url, params: { q: "needle" }
+
+    assert_response :success
+    assert_equal [ comment_match, description_match, title_match ].map { |card| dom_id(card, :search_result) }, result_ids
+    assert_select "#search_results h2 mark", text: "Needle"
+    assert_select "#search_results .search-result__description mark", text: "needle"
+    assert_select "#search_results .search-result__comment mark", text: "NEEDLE"
+    assert_select "#search_results a[href=?]", card_path(comment_match)
+  end
+
+  test "only searches currently accessible boards in this account" do
+    visible = create_card(title: "needle")
+    private_card = create_card(title: "needle", board: boards(:private), creator: users(:kevin))
+    private_card.comments.create!(body: "needle", creator: users(:kevin))
+    cards(:radio).update! title: "needle"
+
+    get search_url, params: { q: "needle", board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ dom_id(visible, :search_result) ], result_ids
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:david)
+
+    get search_url, params: { q: "needle" }
+    assert_response :success
+    assert_empty result_ids
+  end
+
+  test "draft cards and comments on them are excluded" do
+    draft = create_card(title: "needle", description: "needle")
+    draft.comments.create!(body: "draftcomment", creator: users(:david))
+    draft.drafted!
+
+    [ "needle", "draftcomment" ].each do |query|
+      get search_url, params: { q: query }
+      assert_response :success
+      assert_empty result_ids
+    end
+  end
+
+  test "blank and unmatched queries have useful empty states" do
+    [ nil, "", " \t\n " ].each do |query|
+      get search_url, params: { q: query }
+      assert_response :success
+      assert_empty result_ids
+      assert_select "form[action=?][method=get] input[name=q]", search_path
+      assert_select "p", text: "Search card titles, descriptions, and comments."
+    end
+
+    get search_url, params: { q: "unfindable" }
+    assert_response :success
+    assert_empty result_ids
+    assert_select "[role=status]", text: "No cards found for “unfindable”."
+  end
+
+  test "search requires authentication" do
+    sign_out
+    get search_url, params: { q: "logo" }
+    assert_response :redirect
+    assert_empty result_ids
+  end
+
+  test "existing comment content is searchable" do
+    get search_url, params: { q: "overflowing" }
+    assert_response :success
+    assert_equal [ dom_id(cards(:layout), :search_result) ], result_ids
+    assert_select ".search-result__comment mark", text: "overflowing"
+  end
+
+  test "all words must match, even when spread across fields" do
+    match = create_card(title: "Silver", description: "A gold lining")
+    match.comments.create!(body: "Copper", creator: users(:david))
+    create_card(title: "Silver gold")
+
+    get search_url, params: { q: "  SILVER  gold copper  " }
+    assert_response :success
+    assert_equal [ dom_id(match, :search_result) ], result_ids
+    assert_select "#search_results mark", count: 3
+  end
+
+  test "literal punctuation is not a wildcard, SQL, or a regular expression" do
+    card = create_card(title: '100% foo_bar [brackets] wow! C:\folder')
+    create_card(title: "1000 fooXbar brackets wow Cfolder")
+
+    [ "100%", "foo_bar", "[brackets]", "wow!", 'C:\folder' ].each do |query|
+      get search_url, params: { q: query }
+      assert_response :success
+      assert_equal [ dom_id(card, :search_result) ], result_ids
+      assert_select "#search_results mark", text: query
+    end
+
+    get search_url, params: { q: "' OR 1=1 --" }
+    assert_response :success
+    assert_empty result_ids
+  end
+
+  test "rich text searches visible text instead of HTML tags and attributes" do
+    card = create_card(description: '<div class="hiddenword">A fox &amp; <strong>hen</strong></div>')
+
+    get search_url, params: { q: "fox & hen" }
+    assert_response :success
+    assert_equal [ dom_id(card, :search_result) ], result_ids
+    assert_select ".search-result__description mark", text: "&"
+
+    [ "div", "hiddenword", "strong", "amp" ].each do |query|
+      get search_url, params: { q: query }
+      assert_response :success
+      assert_empty result_ids
+    end
+  end
+
+  test "HTML-like titles and comment text remain escaped" do
+    card = create_card(title: "<img src=x onerror=alert(1)> needle")
+    card.comments.create!(body: "&lt;script&gt;needle&lt;/script&gt;", creator: users(:david))
+
+    get search_url, params: { q: "needle" }
+    assert_response :success
+    assert_select "#search_results img, #search_results script", count: 0
+    assert_select "#search_results mark", count: 2, text: "needle"
+    assert_select "#search_results h2", text: card.title
+  end
+
+  test "a match late in a long comment is visible in its snippet" do
+    card = create_card
+    card.comments.create!(body: "#{'padding ' * 100}needle at the end", creator: users(:david))
+
+    get search_url, params: { q: "needle" }
+    assert_response :success
+    assert_equal [ dom_id(card, :search_result) ], result_ids
+    assert_select ".search-result__comment mark", text: "needle"
+  end
+
+  test "pagination keeps the query and orders cards by creation, not recent activity" do
+    matches = 17.times.map do |index|
+      create_card(title: "paginated", created_at: index.days.ago, last_active_at: index.days.from_now)
+    end
+
+    get search_url, params: { q: "paginated" }
+    assert_response :success
+    assert_equal matches.first(15).map { |card| dom_id(card, :search_result) }, result_ids
+    assert_select "a[href=?]", search_path(q: "paginated", page: 2), text: "Load more…"
+
+    get search_url, params: { q: "paginated", page: 2 }
+    assert_response :success
+    assert_equal matches.last(2).map { |card| dom_id(card, :search_result) }, result_ids
+  end
+
+  test "access granted after an earlier search takes effect immediately" do
+    card = create_card(title: "privateword", board: boards(:private), creator: users(:kevin))
+    get search_url, params: { q: "privateword" }
+    assert_empty result_ids
+
+    boards(:private).accesses.grant_to users(:david)
+    get search_url, params: { q: "privateword" }
+    assert_response :success
+    assert_equal [ dom_id(card, :search_result) ], result_ids
+  end
+
+  test "an account the identity does not belong to cannot be searched" do
+    get search_url(script_name: accounts(:initech).slug), params: { q: "radio" }
+    assert_response :redirect
+    assert_empty result_ids
+  end
+
+  private
+    def create_card(**attributes)
+      Card.create!({ board: boards(:writebook), title: "A card", status: :published, creator: users(:david) }.merge(attributes))
+    end
+
+    def result_ids
+      css_select("#search_results article").map { |element| element["id"] }
+    end
+end
