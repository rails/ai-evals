@@ -0,0 +1,74 @@
+# Activities
+
+Activities describe changes to cards and comments across the boards the current user can access.
+
+## `GET /:account_slug/activities.json`
+
+Returns a flat array of events, newest first. Results use the API's standard
+[pagination](../README.md#pagination): follow the `Link` header's `rel="next"`
+URL to retrieve the next page. Activity is not restricted to a single day.
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of strings | Only events created by these users |
+| `board_ids[]` | array of strings | Only events on these boards |
+
+Multiple values within a filter are combined with OR; the two filters are combined
+with AND. Filtering never grants access to otherwise inaccessible boards or accounts.
+
+__Example:__
+
+```bash
+curl -H "Authorization: Bearer put-your-access-token-here" \
+  'http://app.fizzy.localhost:3006/686465299/activities.json?creator_ids[]=03f5v9zjw7pz8717a4no1h8a7&board_ids[]=03f5v9zjv4p9wz3qjz9v4x6s8'
+```
+
+__Response:__
+
+Each event contains these fields:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action (listed below) |
+| `created_at` | Event timestamp in UTC |
+| `description` | The event's plain-text description for the current user |
+| `particulars` | Event-specific details (see below) |
+| `url` | Card URL; for a comment event, the card URL with an anchor to that comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation |
+
+The following actions are included:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_title_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `comment_created`
+
+These mirror the HTML timeline, except that deprecated `card_collection_changed`
+events are omitted and `card_title_changed` events are included.
+
+### Particulars
+
+The `particulars` object contains only the details relevant to the action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `{"assignee_ids": ["user-id"]}` |
+| `card_board_changed` | `{"old_board": "Old board name", "new_board": "New board name"}` |
+| `card_title_changed` | `{"old_title": "Old title", "new_title": "New title"}` |
+| `card_triaged` | `{"column": "Column name"}` |
+| All other actions | `{}` |
+
+Board names, titles, and column names are the values recorded at the time of the
+event. Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..e369737
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,265 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    assert_equal users(:kevin).accessible_events.order(created_at: :desc, id: :desc).ids, response.parsed_body.pluck("id")
+  end
+
+  test "index defaults to JSON and rejects HTML" do
+    get activities_path
+    assert_response :success
+    assert_equal "application/json", response.media_type
+
+    get activities_path(format: :html)
+    assert_response :not_acceptable
+  end
+
+  test "card events use existing API representations and plain text descriptions" do
+    event = events(:layout_published)
+    activity = activity_for(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(event.card), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+
+    get cards_path(format: :json), params: { card_ids: [ event.card.id ] }
+    assert_equal response.parsed_body.first, activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment events link to the comment on its card" do
+    event = events(:layout_commented)
+    activity = activity_for(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(event.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(event.card, event.eventable, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated events" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+
+    actions.each do |action|
+      eventable = action == "comment_created" ? comments(:layout_overflowing_david) : cards(:logo)
+      create_event(action, eventable: eventable)
+    end
+    create_event("card_collection_changed")
+    create_event("card_resumed")
+    create_event("card_gilded")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal actions.sort, response.parsed_body.pluck("action").uniq.sort
+  end
+
+  test "assignment particulars contain only assignee ids" do
+    %w[ card_assigned card_unassigned ].each do |action|
+      assignee_ids = [ users(:david).id, users(:jz).id ]
+      event = create_event(action, particulars: { assignee_ids: assignee_ids, internal: "not exposed" })
+
+      assert_equal({ "assignee_ids" => assignee_ids }, activity_for(event)["particulars"])
+    end
+  end
+
+  test "board title and triage particulars are flattened" do
+    {
+      "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }.each do |action, particulars|
+      event = create_event(action, particulars: { particulars: particulars.merge("internal" => "not exposed") })
+
+      assert_equal particulars, activity_for(event)["particulars"]
+    end
+  end
+
+  test "missing board title and column particulars are empty strings" do
+    {
+      "card_board_changed" => %w[ old_board new_board ],
+      "card_title_changed" => %w[ old_title new_title ],
+      "card_triaged" => %w[ column ]
+    }.each do |action, keys|
+      [ {}, { particulars: keys.index_with(nil) } ].each do |particulars|
+        event = create_event(action, particulars: particulars)
+
+        assert_equal keys.index_with(""), activity_for(event)["particulars"]
+      end
+    end
+  end
+
+  test "other events have empty particulars even when details are stored" do
+    event = create_event("card_published", particulars: { internal: "not exposed" })
+
+    assert_equal({}, activity_for(event)["particulars"])
+  end
+
+  test "descriptions are rendered for the current user" do
+    event = events(:logo_assignment_km)
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity_for(event)["description"]
+
+    logout_and_sign_in_as :david
+    assert_equal event.description_for(users(:david)).to_plain_text, activity_for(event)["description"]
+  end
+
+  test "filters by multiple creator ids" do
+    event = create_event("card_reopened", creator: users(:jz))
+    creator_ids = [ users(:kevin).id, users(:jz).id ]
+
+    get activities_path(format: :json), params: { creator_ids: creator_ids }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), event.id
+    assert_equal creator_ids.sort, response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq.sort
+  end
+
+  test "filters by board ids and combines them with creator ids" do
+    private_event = create_private_event
+
+    get activities_path(format: :json), params: { board_ids: [ private_event.board_id ] }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), private_event.id
+    assert_equal [ private_event.board_id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+
+    get activities_path(format: :json), params: {
+      board_ids: [ boards(:writebook).id, private_event.board_id ], creator_ids: [ users(:kevin).id ]
+    }
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id, private_event.board_id ].sort, response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq.sort
+    assert_equal [ users(:kevin).id ], response.parsed_body.map { |activity| activity.dig("creator", "id") }.uniq
+  end
+
+  test "only includes accessible events even when inaccessible boards are requested" do
+    private_event = create_private_event
+    other_account_event = create_event("card_published", eventable: cards(:radio), board: boards(:miltons_wish_list), creator: users(:mike))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), private_event.id
+    assert_not_includes response.parsed_body.pluck("id"), other_account_event.id
+    assert_includes response.parsed_body.pluck("id"), events(:layout_published).id
+
+    get activities_path(format: :json), params: { board_ids: [ private_event.board_id, other_account_event.board_id ] }
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:writebook).id, private_event.board_id, other_account_event.board_id ] }
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "unknown filters return an empty array" do
+    [ :creator_ids, :board_ids ].each do |filter|
+      get activities_path(format: :json), params: { filter => [ ActiveRecord::Type::Uuid.generate ] }
+
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+  end
+
+  test "users without board access receive an empty array" do
+    logout_and_sign_in_as :jason
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+    assert_equal "0", response.headers["X-Total-Count"]
+    assert_nil response.headers["Link"]
+  end
+
+  test "cannot read another account's activity" do
+    get activities_path(format: :json, script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+  end
+
+  test "paginates with next links while preserving filters and stable newest first ordering" do
+    created_events = 20.times.map { create_event("card_reopened", creator: users(:jz), created_at: 1.day.ago.change(usec: 0)) }
+    created_events << create_event("card_reopened", creator: users(:jz), created_at: 1.month.ago)
+    created_events << create_event("card_reopened", creator: users(:jz), created_at: Time.current)
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert_equal created_events.size.to_s, response.headers["X-Total-Count"]
+    assert response.headers["Link"].present?
+    activity_ids = response.parsed_body.pluck("id")
+    assert_operator activity_ids.size, :<, created_events.size
+
+    while next_url = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      get next_url
+      assert_response :success
+      activity_ids.concat response.parsed_body.pluck("id")
+    end
+
+    assert_equal created_events.sort_by { |event| [ event.created_at, event.id ] }.reverse.map(&:id), activity_ids
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get activities_path(format: :json)
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "accepts a read only bearer token" do
+    token = identities(:david).access_tokens.create!(description: "Activity reader", permission: :read)
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), events(:layout_published).id
+  end
+
+  private
+    def activity_for(event)
+      get activities_path(format: :json)
+      assert_response :success
+      response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert activity, "Expected event #{event.id} in the activity feed"
+      end
+    end
+
+    def create_event(action, **attributes)
+      Event.create!(action: action, eventable: cards(:logo), board: boards(:writebook), creator: users(:kevin), **attributes)
+    end
+
+    def create_private_event
+      card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Private card", creator: users(:kevin), status: :published) }
+      create_event("card_reopened", eventable: card, board: card.board)
+    end
+end
