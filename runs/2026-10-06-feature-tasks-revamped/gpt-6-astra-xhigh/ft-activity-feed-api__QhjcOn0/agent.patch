+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events.preloaded.order(created_at: :desc, id: :desc)
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.for_activity_feed
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      events
+    end
+end
