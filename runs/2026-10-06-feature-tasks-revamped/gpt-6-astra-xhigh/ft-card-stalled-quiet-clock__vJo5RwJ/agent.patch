diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..0056951
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,30 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_activity_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    last_activity_burst_at.present? && active? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  # The status can change with time, without a database update.
+  def display_cache_key
+    [ self, stalled? ]
+  end
+
+  def record_activity_burst
+    update!(last_activity_burst_at: Time.current, last_active_at: Time.current)
+  end
+
+  def detect_comment_activity_burst
+    recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      record_activity_burst
+    end
+  end
+end
