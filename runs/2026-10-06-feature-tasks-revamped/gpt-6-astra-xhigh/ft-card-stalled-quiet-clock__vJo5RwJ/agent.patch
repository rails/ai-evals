diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..e45ea51
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    freeze_time
+    @board = boards(:writebook)
+    @column = columns(:writebook_in_progress)
+
+    with_current_user :kevin do
+      @card = @board.cards.create!(title: "Waiting after a burst", status: :published, column: @column)
+      @card.toggle_assignment(users(:david))
+    end
+  end
+
+  test "stalled index lists only stalled cards in HTML and JSON" do
+    travel 2.weeks
+
+    get cards_path, params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select ".card--stalled .card__stalled", text: "Stalled"
+    assert_select "[data-combobox-value=stalled]", text: /Stalled/
+
+    get cards_path(format: :json), params: { indexed_by: "stalled", board_ids: [ @board.id ] }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.sole["stalled"]
+
+    with_current_user :kevin do
+      @card.comments.create!(body: "Back to work")
+    end
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "stalled filtering respects board and account access" do
+    with_current_user :kevin do
+      private_card = boards(:private).cards.create!(title: "Private burst", status: :published)
+      private_card.close
+      private_card.reopen
+    end
+
+    Current.set(account: accounts(:initech)) do
+      with_current_user :mike do
+        cards(:radio).close
+        cards(:radio).reopen
+      end
+    end
+
+    logout_and_sign_in_as :david
+    travel 2.weeks
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+
+    get cards_path(format: :json), params: { indexed_by: "stalled", board_ids: [ boards(:private).id ] }
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+  end
+
+  test "stalled badge appears on card pages and private and public previews" do
+    @board.publish
+    travel 2.weeks
+
+    [ card_path(@card), board_column_path(@board, @column),
+      public_board_card_path(@board.publication.key, @card),
+      public_board_column_path(@board.publication.key, @column) ].each do |path|
+      get path
+      assert_response :success
+      assert_select ".card--stalled .card__stalled", text: "Stalled", count: 1
+    end
+  end
+
+  test "stalled badge appears in paginated previews" do
+    travel 2.weeks
+
+    get cards_previews_path(format: :turbo_stream), params: { indexed_by: "stalled", target: "cards" }
+    assert_response :success
+    assert_select "template .card--stalled .card__stalled", text: "Stalled"
+  end
+
+  test "cached previews change when the inactivity threshold is reached" do
+    with_actionview_partial_caching do
+      get board_column_path(@board, @column)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      travel 2.weeks
+      get board_column_path(@board, @column), headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+
+      with_current_user :kevin do
+        @card.steps.create!(content: "Working again")
+      end
+
+      get board_column_path(@board, @column)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "cached public previews change when the inactivity threshold is reached" do
+    @board.publish
+
+    with_actionview_partial_caching do
+      get public_board_column_path(@board.publication.key, @column)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      travel 2.weeks
+      get public_board_column_path(@board.publication.key, @column)
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+    end
+  end
+
+  test "activity timeline caches include the current stalled state" do
+    day = Time.current.to_date.to_s
+
+    with_actionview_partial_caching do
+      get events_path, params: { day: day }
+      assert_response :success
+      assert_select ".event .card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      travel 2.weeks
+      get events_path, params: { day: day }, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".event .card__stalled", text: "Stalled", minimum: 1
+    end
+  end
+
+  test "cached card details and JSON change when the inactivity threshold is reached" do
+    original_cache = ApplicationController.cache_store
+    original_rails_cache = Rails.cache
+    Rails.cache = ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+
+      travel 2.weeks
+
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled", count: 1
+
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal true, response.parsed_body["stalled"]
+    end
+  ensure
+    ApplicationController.cache_store = original_cache
+    Rails.cache = original_rails_cache
+  end
+
+  test "removing a background image resets stalled status" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    delete card_image_path(@card), as: :json
+    assert_response :no_content
+    assert_not @card.reload.stalled?
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f0f5a6e
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = boards(:writebook).cards.create!(title: "A burst, then silence", status: :published)
+  end
+
+  test "a comment burst stalls after two weeks without activity" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:kevin))
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    travel 2.weeks - 1.second
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create!(body: "Moving again", creator: users(:kevin))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a quiet card without a burst never stalls" do
+    travel 3.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from one person are not a burst" do
+    3.times { @card.comments.create!(body: "Thinking aloud", creator: users(:david)) }
+
+    assert_nil @card.reload.last_activity_burst_at
+    travel 2.weeks
+    assert_not @card.stalled?
+  end
+
+  test "two comments from two people are not a burst" do
+    comment_as :david
+    comment_as :kevin
+
+    assert_nil @card.reload.last_activity_burst_at
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_as :david
+    comment_as :kevin
+    @card.comments.create!(body: "System activity", creator: @card.account.system_user)
+
+    assert_nil @card.reload.last_activity_burst_at
+
+    @card.comments.delete_all
+    2.times { comment_as :david }
+    @card.comments.create!(body: "System activity", creator: @card.account.system_user)
+    comment_as :david
+
+    assert_nil @card.reload.last_activity_burst_at
+  end
+
+  test "comments exactly a third of the board period apart are a burst" do
+    @card.board.auto_postpone_period = 30.days
+    comment_as :david
+    travel 10.days
+    comment_as :kevin
+    comment_as :david
+
+    assert_equal Time.current, @card.reload.last_activity_burst_at
+  end
+
+  test "comments outside a third of the board period are not a burst" do
+    @card.board.auto_postpone_period = 30.days
+    comment_as :david
+    travel 10.days + 1.second
+    comment_as :kevin
+    comment_as :david
+
+    assert_nil @card.reload.last_activity_burst_at
+
+    comment_as :kevin
+    assert_equal Time.current, @card.reload.last_activity_burst_at
+  end
+
+  test "comment burst window falls back to the account period" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.account.entropy.update!(auto_postpone_period: 90.days)
+
+    comment_as :david
+    travel 30.days
+    comment_as :kevin
+    comment_as :david
+
+    assert_equal Time.current, @card.reload.last_activity_burst_at
+  end
+
+  test "comments on other cards do not count" do
+    comment_as :david
+    comment_as :kevin
+    cards(:layout).comments.create!(body: "Elsewhere", creator: users(:david))
+
+    assert_nil @card.reload.last_activity_burst_at
+  end
+
+  test "assignment is a burst but unassignment is not" do
+    @card.toggle_assignment(users(:kevin))
+    burst_at = @card.reload.last_activity_burst_at
+    assert_equal Time.current, burst_at
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.toggle_assignment(users(:kevin))
+    assert_not @card.reload.stalled?
+    assert_equal burst_at, @card.last_activity_burst_at
+  end
+
+  test "reopening is a burst but closing is not" do
+    @card.close
+    assert_nil @card.reload.last_activity_burst_at
+
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_activity_burst_at
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "closed postponed and drafted cards are not stalled" do
+    [ -> { @card.close }, -> { @card.postpone }, -> { @card.drafted! } ].each do |change_status|
+      @card = boards(:writebook).cards.create!(title: "Inactive status", status: :published)
+      @card.toggle_assignment(users(:kevin))
+      change_status.call
+
+      travel 2.weeks
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity restarts the inactivity period after a burst" do
+    @card.toggle_assignment(users(:kevin))
+
+    activities = [
+      -> { @card.update!(title: "A new title") },
+      -> { @card.update!(description: "A new description") },
+      -> { @card.steps.create!(content: "A new step") },
+      -> { @card.steps.last.update!(completed: true) },
+      -> { @card.steps.last.destroy! },
+      -> { @card.gild },
+      -> { @card.ungild },
+      -> { @card.reactions.create!(content: "👍") },
+      -> { @card.reactions.last.destroy! },
+      -> { comment_as :david },
+      -> { @card.comments.by_user.last.update!(body: "Edited comment") },
+      -> { @card.comments.by_user.last.reactions.create!(content: "👍") },
+      -> { @card.comments.by_user.last.reactions.last.destroy! },
+      -> { @card.comments.by_user.last.destroy! },
+      -> { @card.toggle_tag_with("attention") },
+      -> { @card.triage_into(columns(:writebook_in_progress)) }
+    ]
+
+    activities.each do |activity|
+      travel 2.weeks
+      assert @card.reload.stalled?, "Expected stalled before #{activity.source_location}"
+
+      activity.call
+      assert_not @card.reload.stalled?, "Expected reset after #{activity.source_location}"
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  private
+    def comment_as(user)
+      @card.comments.create!(body: "A comment", creator: users(user))
+    end
+end
