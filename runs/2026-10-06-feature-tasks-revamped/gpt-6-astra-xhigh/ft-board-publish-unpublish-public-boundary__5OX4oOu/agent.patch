diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..1534cdc
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "publish and unpublish as JSON" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    public_url = public_board_url(@board.reload.publication)
+    assert_equal public_url, response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert_equal public_url, response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+  end
+
+  test "account owners can publish" do
+    @board.accesses.grant_to(users(:jason))
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "members cannot publish even boards they created" do
+    logout_and_sign_in_as :david
+    @board.update!(creator: users(:david))
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "members cannot unpublish even boards they created" do
+    @board.publish
+    @board.update!(creator: users(:david))
+    logout_and_sign_in_as :david
+
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board), as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "anonymous visitors cannot publish or unpublish" do
+    sign_out
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board)
+    end
+    assert_response :redirect
+
+    @board.publish
+    assert_no_difference -> { Board::Publication.count } do
+      delete board_publication_path(@board)
+    end
+    assert_response :redirect
+  end
+
+  test "admins cannot publish inaccessible boards" do
+    board = boards(:private)
+    board.accesses.where(user: users(:kevin)).delete_all
+
+    post board_publication_path(board), as: :json
+    assert_response :not_found
+    assert_not board.reload.published?
+  end
+
+  test "admins cannot change publication in another account" do
+    board = boards(:miltons_wish_list)
+
+    post board_publication_path(board), as: :json
+    assert_response :not_found
+
+    board.publish
+    delete board_publication_path(board), as: :json
+    assert_response :not_found
+    assert board.reload.published?
+  end
+end
