@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+    @card = cards(:logo)
+  end
+
+  test "anonymous visitors can open a published card by number" do
+    @card.update!(description: "A publicly readable description")
+    @card.steps.create!(content: "A checklist item")
+
+    get public_board_card_path(@publication, @card.number)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_select ".card__description", text: /A publicly readable description/
+    assert_select "input[type='checkbox'][disabled]"
+    assert_select "a[href=?]", public_board_path(@publication)
+    assert_select "turbo-cable-stream-source", count: 0
+    assert_select "form", count: 0
+  end
+
+  test "drafts cannot be viewed even with a valid public key" do
+    @card.drafted!
+
+    get public_board_card_path(@publication, @card)
+    assert_response :not_found
+  end
+
+  test "a card must belong to the published board" do
+    other_publication = boards(:private).publish
+
+    get public_board_card_path(other_publication, @card)
+    assert_response :not_found
+  end
+
+  test "a card with the same number in another account is not exposed" do
+    assert_equal cards(:radio).number, @card.number
+
+    get public_board_card_path(@publication, @card)
+    assert_response :success
+    assert_not_includes response.body, cards(:radio).title
+  end
+
+  test "closed and postponed published cards can still be opened" do
+    @card.close(user: users(:david))
+    get public_board_card_path(@publication, @card)
+    assert_response :success
+
+    with_current_user :david do
+      @card.postpone
+    end
+    get public_board_card_path(@publication, @card)
+    assert_response :success
+  end
+
+  test "unknown cards and revoked keys return not found" do
+    get public_board_card_path(@publication, 999999)
+    assert_response :not_found
+
+    @board.unpublish
+    get public_board_card_path(@publication, @card)
+    assert_response :not_found
+  end
+  test "images can be viewed without an account prefix" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    untenanted do
+      get public_board_card_path(@publication, @card)
+      assert_response :success
+      image_url = css_select(".card__content img").first["src"]
+      get image_url
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal "image/jpeg", response.media_type
+    end
+  end
+
+  test "public cards cannot be updated" do
+    assert_no_changes -> { @card.reload.title } do
+      patch public_board_card_path(@publication, @card), params: { card: { title: "Changed" } }
+      assert_response :not_found
+    end
+  end
+
+  test "description embeds can be downloaded from an unprefixed public card" do
+    blob = Current.with(account: @board.account) do
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("Public attachment"), filename: "details.txt", content_type: "text/plain"
+      )
+    end
+    @card.update!(description: ActionText::Attachment.from_attachable(blob).to_html)
+
+    untenanted do
+      get public_board_card_path(@publication, @card)
+      assert_response :success
+      download_url = css_select("a.attachment__link").first["href"]
+
+      get download_url
+      assert_response :redirect
+      follow_redirect!
+      assert_response :success
+      assert_equal "Public attachment", response.body
+    end
+  end
+end
