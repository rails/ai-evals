diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..5c63359
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing creates a secret key and is idempotent" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+      @board.publish
+    end
+
+    assert @board.published?
+    assert_includes Board.published, @board
+    assert_equal @board.account, @board.publication.account
+    assert_operator @board.publication.key.length, :>=, 24
+    assert_equal @board.publication.key, @board.publication.to_param
+  end
+
+  test "unpublishing is idempotent and republishing uses a new key" do
+    old_key = @board.publish.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_not_equal old_key, @board.publish.key
+  end
+
+  test "publications use different keys" do
+    assert_not_equal @board.publish.key, boards(:private).publish.key
+  end
+
+  test "publication changes invalidate the board cache" do
+    travel 1.minute do
+      assert_changes -> { @board.reload.cache_key_with_version } do
+        @board.publish
+      end
+    end
+
+    travel 2.minutes do
+      assert_changes -> { @board.reload.cache_key_with_version } do
+        @board.unpublish
+      end
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy!
+    end
+  end
+end
