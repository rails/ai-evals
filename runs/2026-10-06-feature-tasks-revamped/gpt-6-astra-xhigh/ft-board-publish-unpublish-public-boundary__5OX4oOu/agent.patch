diff --git a/app/controllers/public/base_controller.rb b/app/controllers/public/base_controller.rb
new file mode 100644
index 0000000..2f7f331
--- /dev/null
+++ b/app/controllers/public/base_controller.rb
@@ -0,0 +1,31 @@
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  before_action :set_board
+  before_action :protect_public_url
+
+  # Attachments need an account prefix even when a public link was opened without one.
+  def url_options
+    super.merge(script_name: Current.account&.slug)
+  end
+
+  private
+    def set_board
+      publications = Board::Publication.all
+      publications = publications.where(account: Current.account) if request.env["fizzy.external_account_id"]
+
+      @publication = publications.find_by!(key: params[:board_key] || params[:key])
+      @board = @publication.board
+      raise ActiveRecord::RecordNotFound unless @board.account.active?
+
+      Current.account = @board.account
+    end
+
+    def protect_public_url
+      no_store
+      response.headers["Referrer-Policy"] = "no-referrer"
+    end
+end
