diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..887ad9a
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = @board.publish
+  end
+
+  test "anonymous visitors can see a public board and its public links" do
+    get public_board_path(@publication)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@publication, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@publication, cards(:logo))
+    assert_select "turbo-cable-stream-source", count: 0
+    assert_select "form", count: 0
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+    assert_match "no-store", response.headers["Cache-Control"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+
+  test "a secret key also works without an account prefix" do
+    untenanted do
+      get public_board_path(@publication)
+      assert_response :success
+      assert_select "h1", text: @board.name
+    end
+  end
+
+  test "drafts are not listed" do
+    cards(:logo).drafted!
+
+    get public_board_path(@publication)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@publication, cards(:logo)), count: 0
+    assert_not_includes response.body, cards(:logo).title
+  end
+
+  test "unknown and revoked keys return not found" do
+    get public_board_path("unknown-key")
+    assert_response :not_found
+
+    @board.unpublish
+    @board.publish
+    get public_board_path(@publication)
+    assert_response :not_found
+  end
+
+  test "the board ID is not a public key" do
+    get public_board_path(@board.id)
+    assert_response :not_found
+  end
+
+  test "a key cannot be used under another account prefix" do
+    get public_board_path(@publication, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+
+  test "a key cannot be used under a nonexistent account prefix" do
+    get public_board_path(@publication, script_name: "/999999999999")
+    assert_response :not_found
+  end
+
+  test "a cancelled account cannot be viewed publicly" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    get public_board_path(@publication)
+    assert_response :not_found
+  end
+
+  test "publication does not grant access to the private board URL" do
+    get board_path(@board)
+    assert_response :redirect
+  end
+
+  test "signed in visitors from another account can view a public board" do
+    sign_in_as :mike
+
+    get public_board_path(@publication)
+    assert_response :success
+    assert_select "h1", text: @board.name
+  end
+
+  test "members without board access can view a public board" do
+    board = boards(:private)
+    sign_in_as :david
+    assert_not board.accessible_to?(users(:david))
+
+    get public_board_path(board.publish)
+    assert_response :success
+  end
+  test "public board cards are paginated using public links" do
+    with_current_user :kevin do
+      55.times { |number| @board.cards.create!(title: "Public card #{number}", status: :published) }
+    end
+
+    get public_board_path(@publication)
+    assert_response :success
+    first_page_links = css_select("a.card__link").map { |link| link["href"] }
+    next_page_link = css_select("a.pagination-link").first["href"]
+    assert_includes next_page_link, public_board_path(@publication)
+
+    get next_page_link
+    assert_response :success
+    second_page_links = css_select("a.card__link").map { |link| link["href"] }
+    assert second_page_links.any?
+    assert_empty first_page_links & second_page_links
+  end
+
+  test "public URLs do not permit mutations" do
+    assert_no_changes -> { @board.reload.name } do
+      patch public_board_path(@publication), params: { board: { name: "Changed" } }
+      assert_response :not_found
+    end
+  end
+end
