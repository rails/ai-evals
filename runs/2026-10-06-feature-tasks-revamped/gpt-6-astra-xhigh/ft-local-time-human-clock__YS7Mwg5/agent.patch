--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "emits a raw timestamp for browser rendering" do
+    timestamp = Time.utc(2026, 9, 12, 20, 42)
+
+    assert_dom_equal \
+      '<time datetime="2026-09-12T20:42:00Z" data-controller="local-time" data-local-time-style-value="relative">2026-09-12T20:42:00Z</time>',
+      local_time_tag(timestamp)
+  end
+
+  test "markup does not depend on the server timezone or current time" do
+    timestamp = Time.utc(2026, 9, 12, 20, 42)
+    original = timestamp.dup
+    tags = [ "America/Los_Angeles", "Asia/Tokyo" ].each_with_index.map do |timezone, index|
+      Time.use_zone(timezone) do
+        travel_to timestamp + index.days do
+          local_time_tag(timestamp.in_time_zone)
+        end
+      end
+    end
+
+    assert_equal tags.first, tags.last
+    assert_equal original, timestamp
+  end
+
+  test "preserves calendar dates and HTML options" do
+    tag = local_time_tag(Date.new(2026, 9, 12), style: :long_date, class: "date", data: { controller: "other", custom: "value" })
+
+    assert_dom_equal \
+      '<time datetime="2026-09-12" class="date" data-controller="other local-time" data-custom="value" data-local-time-style-value="long_date">2026-09-12</time>', tag
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..aef9a8b
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,178 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    visit new_session_url
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+  end
+
+  teardown do
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  test "relative timestamps use the viewer's calendar days" do
+    now = "2026-09-17T15:42:00-07:00"
+
+    assert_equal "1:42 PM", format_time("2026-09-17T20:42:00Z", now: now)
+    assert_equal "yesterday", format_time("2026-09-17T06:59:00Z", now: now)
+    assert_equal "5 days ago", format_time("2026-09-12T20:42:00Z", now: now)
+    assert_equal "Sep 10", format_time("2026-09-10T20:42:00Z", now: now)
+    assert_equal "Sep 12, 2025", format_time("2025-09-12T20:42:00Z", now: now)
+    assert_equal "tomorrow", format_time("2026-09-18T07:01:00Z", now: now)
+    assert_equal "today", format_time("2026-09-17T23:42:00Z", style: "relative_date", now: now)
+    assert_equal "in 3 days", format_time("2026-09-20T20:42:00Z", now: now)
+    assert_equal "in 30 days", format_time("2026-10-17T20:42:00Z", now: now)
+  end
+
+  test "local midnight matters more than elapsed hours or UTC midnight" do
+    assert_equal "yesterday", format_time("2026-09-16T23:59:00-07:00", now: "2026-09-17T00:01:00-07:00")
+    assert_equal "tomorrow", format_time("2026-09-17T00:01:00-07:00", now: "2026-09-16T23:59:00-07:00")
+    assert_equal "4:59 PM", format_time("2026-09-16T23:59:00Z", now: "2026-09-17T00:01:00Z")
+    assert_equal "yesterday", format_time("2025-12-31T23:59:00-08:00", now: "2026-01-01T00:01:00-08:00")
+  end
+
+  test "daylight saving transitions use calendar days" do
+    assert_equal "yesterday", format_time("2026-03-08T00:30:00-08:00", now: "2026-03-09T00:15:00-07:00")
+    assert_equal "yesterday", format_time("2026-11-01T00:30:00-07:00", now: "2026-11-02T00:15:00-08:00")
+    assert_equal "in 3 days", format_time("2026-03-10T00:15:00-07:00", now: "2026-03-07T23:45:00-08:00")
+  end
+
+  test "the same timestamp renders differently for different viewers" do
+    timestamp = "2026-09-17T00:42:00Z"
+    now = "2026-09-17T08:00:00Z"
+
+    assert_equal "yesterday", format_time(timestamp, now: now)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Asia/Tokyo")
+    assert_equal "9:42 AM", format_time(timestamp, now: now)
+    assert_equal "9:42 AM", format_time(timestamp, style: "time", now: now)
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "UTC")
+    assert_equal "12:42 AM", format_time(timestamp, now: now)
+  end
+
+  test "absolute formats are local and calendar dates do not shift" do
+    now = "2026-09-17T20:00:00Z"
+
+    assert_equal "Sep 16", format_time("2026-09-17T00:42:00Z", style: "date", now: now)
+    assert_equal "Sep 16, 2026", format_time("2026-09-17T00:42:00Z", style: "full_date", now: now)
+    assert_equal "9/16/26, 5:42 PM", format_time("2026-09-17T00:42:00Z", style: "datetime", now: now)
+    assert_equal "Thursday, September 17", format_time("2026-09-17", style: "long_date", now: now)
+    assert_equal "", format_time("invalid", now: now)
+  end
+
+  test "timestamps inserted and morphed by Turbo are formatted and have a local tooltip" do
+    page.execute_script <<~JS
+      document.body.insertAdjacentHTML("beforeend", '<time id="test-time" datetime="2026-09-17T00:42:00Z" data-controller="local-time" data-local-time-style-value="time">2026-09-17T00:42:00Z</time>')
+    JS
+    assert_selector "#test-time", exact_text: "5:42 PM"
+    assert_includes find("#test-time")[:title], "September 16, 2026"
+    assert_includes find("#test-time")[:title], "5:42:00 PM"
+
+    page.execute_script 'document.getElementById("test-time").setAttribute("datetime", "2026-09-17T01:42:00Z")'
+    assert_selector "#test-time", exact_text: "6:42 PM"
+
+    page.execute_script 'document.getElementById("test-time").textContent = "2026-09-17T01:42:00Z"'
+    assert_selector "#test-time", exact_text: "6:42 PM"
+
+    page.execute_script 'document.getElementById("test-time").dataset.localTimeStyleValue = "full_date"'
+    assert_selector "#test-time", exact_text: "Sep 16, 2026"
+
+    page.execute_script <<~JS
+      const time = document.getElementById("test-time")
+      time.remove()
+      setTimeout(() => document.body.append(time), 0)
+    JS
+    assert_selector "#test-time", exact_text: "Sep 16, 2026"
+  end
+
+  test "relative labels refresh on open pages and stop refreshing after removal" do
+    page.execute_script <<~JS
+      window.originalDate = Date
+      window.originalSetInterval = window.setInterval
+      window.originalClearInterval = window.clearInterval
+      window.localTimeNow = "2026-09-17T23:59:00-07:00"
+      window.Date = class extends window.originalDate {
+        constructor(...args) { super(...(args.length ? args : [window.localTimeNow])) }
+      }
+      window.setInterval = (callback, delay) => {
+        window.localTimeRefresh = callback
+        return window.localTimeTimer = window.originalSetInterval(callback, delay)
+      }
+      window.clearInterval = timer => {
+        if (timer === window.localTimeTimer) window.localTimeTimerCleared = true
+        window.originalClearInterval(timer)
+      }
+      document.body.insertAdjacentHTML("beforeend", '<time id="refresh-time" datetime="2026-09-17T20:42:00Z" data-controller="local-time"></time>')
+    JS
+    assert_selector "#refresh-time", exact_text: "1:42 PM"
+
+    page.execute_script 'window.localTimeNow = "2026-09-18T00:01:00-07:00"; window.localTimeRefresh()'
+    assert_selector "#refresh-time", exact_text: "yesterday"
+
+    cleared = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      document.getElementById("refresh-time").remove()
+      setTimeout(() => done(window.localTimeTimerCleared), 0)
+    JS
+    assert cleared
+  ensure
+    page.execute_script <<~JS
+      window.Date = window.originalDate
+      window.setInterval = window.originalSetInterval
+      window.clearInterval = window.originalClearInterval
+    JS
+  end
+
+  test "native share descriptions and stamps format raw timestamps locally" do
+    page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      Promise.all([import("controllers/bridge/share_controller"), import("controllers/bridge/stamp_controller")]).then(([share, stamp]) => {
+        for (const [name, controller] of [["share", share.default], ["stamp", stamp.default]]) {
+          Stimulus.register(`bridge--${name}`, class extends controller {
+            static get shouldLoad() { return true }
+            send(event, data) {
+              if (data) this.element.textContent = data.description
+            }
+          })
+        }
+        const button = document.createElement("button")
+        button.id = "native-share"
+        button.dataset.controller = "bridge--share"
+        button.dataset.action = "bridge--share#shareUrl"
+        button.textContent = "Share card"
+        button.setAttribute("data-bridge--share-card-value", JSON.stringify({
+          created_at: "2026-09-17T00:42:00Z", updated_at: "2026-09-17T01:42:00Z", author: "David", assignees: "not assigned"
+        }))
+        document.body.append(button)
+        document.body.insertAdjacentHTML("beforeend", '<div id="native-stamp" data-controller="bridge--stamp" data-bridge-title="Done" data-bridge-timestamp="2026-09-17T00:42:00Z"></div>')
+        document.body.insertAdjacentHTML("beforeend", '<button id="board-share" data-controller="bridge--share" data-action="bridge--share#shareUrl" data-bridge-share-description="3 open cards">Share board</button>')
+        done(true)
+      }).catch(error => done(error.toString()))
+    JS
+
+    click_on "Share card"
+    assert_selector "#native-share", text: /Added Sep 16(?:, 2026)? by David and not assigned\. Updated Sep 16/
+    assert_selector "#native-stamp", exact_text: "Sep 16, 2026"
+    click_on "Share board"
+    assert_selector "#board-share", exact_text: "3 open cards"
+  end
+
+  test "comments render raw timestamps in the browser" do
+    comment = comments(:layout_overflowing_david)
+    comment.update_column(:created_at, Time.utc(2026, 9, 17, 0, 42))
+    sign_in_as(users(:david))
+    visit card_url(comment.card)
+
+    assert_selector '.comment__permalink-title time[datetime="2026-09-17T00:42:00Z"]'
+    assert_includes find('.comment__permalink-title time[datetime="2026-09-17T00:42:00Z"]')[:title], "September 16, 2026"
+  end
+
+  private
+    def format_time(timestamp, style: "relative", now:)
+      page.evaluate_async_script <<~JS, timestamp, style, now
+        const [timestamp, style, now, done] = arguments
+        import("helpers/local_time_helpers").then(({ parseLocalTime, formatLocalTime }) => {
+          done(formatLocalTime(parseLocalTime(timestamp), style, new Date(now)))
+        }).catch(error => done(error.toString()))
+      JS
+    end
+end
