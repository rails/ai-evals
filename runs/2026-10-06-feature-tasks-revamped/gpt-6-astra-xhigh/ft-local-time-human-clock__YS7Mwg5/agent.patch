diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..035132d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+import { parseLocalTime, formatLocalTime, formatLocalTimeTitle } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.timer = setInterval(() => this.render(), REFRESH_INTERVAL)
+
+    // Turbo can morph the timestamp or restore the raw text without reconnecting.
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ], childList: true })
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+    this.observer.disconnect()
+  }
+
+  styleValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const date = parseLocalTime(this.element.dateTime)
+    const text = formatLocalTime(date, this.styleValue)
+
+    if (text) {
+      if (this.element.textContent !== text) this.element.textContent = text
+      this.element.title = formatLocalTimeTitle(date)
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..c8798cb
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,61 @@
+const MILLISECONDS_PER_DAY = 86_400_000
+const relativeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+
+export function parseLocalTime(timestamp) {
+  // Calendar dates (such as timeline headings) are not UTC instants.
+  return new Date(/^\d{4}-\d{2}-\d{2}$/.test(timestamp) ? `${timestamp}T00:00:00` : timestamp)
+}
+
+export function formatLocalTime(date, style = "relative", now = new Date()) {
+  if (Number.isNaN(date.getTime())) return ""
+
+  switch (style) {
+    case "relative":
+      return formatRelativeTime(date, now)
+    case "relative_date":
+      return formatRelativeTime(date, now, false)
+    case "time":
+      return format(date, { hour: "numeric", minute: "2-digit" })
+    case "date":
+      return formatDate(date, now)
+    case "full_date":
+      return format(date, { year: "numeric", month: "short", day: "numeric" })
+    case "long_date":
+      return format(date, { weekday: "long", month: "long", day: "numeric", ...yearIfDifferent(date, now) })
+    case "datetime":
+      return format(date, { dateStyle: "short", timeStyle: "short" })
+  }
+}
+
+export function formatLocalTimeTitle(date) {
+  return format(date, { dateStyle: "full", timeStyle: "long" })
+}
+
+function formatRelativeTime(date, now, showTime = true) {
+  const days = calendarDay(date) - calendarDay(now)
+
+  if (days === 0 && showTime) {
+    return formatLocalTime(date, "time", now)
+  } else if (days >= -6) {
+    return relativeFormatter.format(days, "day")
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+function calendarDay(date) {
+  // Compare local calendar days, not elapsed 24-hour periods (which fail at DST).
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / MILLISECONDS_PER_DAY
+}
+
+function formatDate(date, now) {
+  return format(date, { month: "short", day: "numeric", ...yearIfDifferent(date, now) })
+}
+
+function yearIfDifferent(date, now) {
+  return date.getFullYear() === now.getFullYear() ? {} : { year: "numeric" }
+}
+
+function format(date, options) {
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
