diff --git a/test/helpers/bridge_helper_test.rb b/test/helpers/bridge_helper_test.rb
new file mode 100644
index 0000000..d12ef14
--- /dev/null
+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card share buttons carry raw timestamps rather than server formatted dates" do
+    card = cards(:layout)
+    button = Nokogiri::HTML.fragment(bridged_share_card_button(card)).at_css("button")
+    data = JSON.parse(button["data-bridge--share-card-value"])
+
+    assert_equal card.created_at, Time.iso8601(data.fetch("created_at"))
+    assert_equal card.last_active_at, Time.iso8601(data.fetch("updated_at"))
+    assert_equal card.creator.familiar_name, data.fetch("author")
+    assert_nil button["data-bridge-share-description"]
+  end
+
+  test "ordinary share descriptions do not carry card data" do
+    button = Nokogiri::HTML.fragment(bridged_share_url_button("3 open cards")).at_css("button")
+
+    assert_equal "3 open cards", button["data-bridge-share-description"]
+    assert_nil button["data-bridge--share-card-value"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
