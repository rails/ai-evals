+module Account::DataTransfer
+  FORMAT = "fizzy-account"
+  VERSION = 1
+
+  class InvalidArchive < StandardError; end
+
+  def self.export(account, zip)
+    tables = {}
+    Manifest.new(account).each_record_set do |record_set|
+      count = record_set.export(zip)
+      tables[record_set.model.table_name] = count unless record_set.is_a?(ActiveStorage::FileRecordSet)
+    end
+    zip.add_file "manifest.json", { format: FORMAT, version: VERSION, tables: tables }.to_json
+  end
+end
