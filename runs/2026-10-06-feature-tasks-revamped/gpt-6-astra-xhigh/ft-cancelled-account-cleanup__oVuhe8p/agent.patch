diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..02b6fda
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago and all their data" do
+    account = accounts(:"37s")
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("image data"), filename: "image.png", content_type: "image/png"
+    variant = card.image.blob.variant_records.create!(variation_digest: "thumbnail")
+    variant.image.attach io: StringIO.new("thumbnail data"), filename: "thumbnail.png", content_type: "image/png"
+    ActiveStorage::Blob.create_and_upload! io: StringIO.new("unused upload"), filename: "unused.txt"
+    account.materialize_storage
+    card.board.materialize_storage
+    board_ids = account.board_ids
+    card.reindex
+
+    import = account.imports.create!(identity: identities(:david), status: :completed)
+    import.file.attach io: StringIO.new("import data"), filename: "import.zip"
+
+    other_account = accounts(:initech)
+    other_user = other_account.users.create!(name: "David", identity: identities(:david))
+    Current.with_account(other_account) do
+      cards(:radio).image.attach io: StringIO.new("other image"), filename: "other.png", content_type: "image/png"
+    end
+    other_record_counts = account_record_counts(other_account)
+
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_empty account_record_counts(account).select { |table, count| count.positive? }
+    assert_not Storage::Total.exists?(owner_type: "Account", owner_id: account.id)
+    assert_not Storage::Total.exists?(owner_type: "Board", owner_id: board_ids)
+    assert_not Account.exists?(account.id)
+    assert_equal other_record_counts, account_record_counts(other_account)
+    assert Account.exists?(other_account.id)
+    assert User.exists?(other_user.id)
+    assert Identity.exists?(identities(:david).id)
+    assert Session.exists?(sessions(:david).id)
+  end
+
+  test "keeps active accounts and accounts within the cancellation grace period" do
+    freeze_time do
+      account = accounts(:"37s")
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: 30.days.ago)
+      accounts(:initech).cancel(initiated_by: users(:mike))
+
+      assert_no_difference "Account.count" do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      travel 1.second
+
+      assert_difference "Account.count", -1 do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      assert_not Account.exists?(account.id)
+      assert Account.exists?(accounts(:initech).id)
+      assert Account.exists?(accounts(:acme).id)
+    end
+  end
+
+  test "keeps reactivated accounts" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "incinerates all due accounts and can be run again" do
+    [ [ accounts(:"37s"), users(:david) ], [ accounts(:initech), users(:mike) ] ].each do |account, user|
+      account.cancel(initiated_by: user)
+      account.cancellation.update!(created_at: 31.days.ago)
+    end
+
+    assert_difference "Account.count", -2 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  private
+    def account_record_counts(account)
+      ApplicationRecord.connection_pool.with_connection do |connection|
+        connection.tables.filter_map do |table|
+          if connection.columns(table).any? { |column| column.name == "account_id" }
+            count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id_for_database)}")
+            [ table, count ]
+          end
+        end.to_h
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..4d87348
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  test "rechecks eligibility when an account has been reactivated after loading" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    assert_includes Account.due_for_incineration, account
+
+    Account.find(account.id).reactivate
+
+    assert_no_difference "Account.count" do
+      account.incinerate
+    end
+
+    assert_predicate account.reload, :active?
+  end
+
+  test "a new cancellation restarts the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    reactivated_account = Account.find(account.id)
+    reactivated_account.reactivate
+    reactivated_account.cancel(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      account.incinerate
+    end
+
+    assert_predicate account.reload, :cancelled?
+    assert_not_includes Account.due_for_incineration, account
+  end
+end
