diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..9ff8247 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,30 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    Current.with_account(self) do
+      with_lock do
+        if self.class.due_for_incineration.exists?(id: id)
+          # Attached blobs are purged by their records' destruction callbacks.
+          ActiveStorage::Blob.where(account_id: id).unattached.find_each(&:purge_later)
+          destroy!
+          storage_entries.delete_all(:delete_all)
+        end
+      end
+    end
+  end
 end
