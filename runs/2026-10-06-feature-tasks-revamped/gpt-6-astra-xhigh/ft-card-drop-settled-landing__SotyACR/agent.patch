diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d729203
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,192 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem
+  #hoverContainer
+  #pendingItems = new Set()
+
+  disconnect() {
+    this.dragEnd()
+    this.element.removeAttribute("data-turbo-permanent")
+    this.itemTargets.forEach(item => item.removeAttribute("draggable"))
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = !this.#pendingItems.has(item)
+  }
+
+  preventDraggableRemoval(event) {
+    if (event.detail.attributeName === "draggable" && this.itemTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  dragStart(event) {
+    const item = event.target.closest('[data-drag-and-drop-target~="item"]')
+    if (!this.itemTargets.includes(item) || this.#pendingItems.has(item)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#draggedItem = item
+    this.#protectBoard()
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    item.classList.add(this.draggedItemClass)
+  }
+
+  dragOver(event) {
+    const container = this.#dropContainer(event)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#hoverContainer?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  dragEnd() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+    this.#protectBoard()
+  }
+
+  async drop(event) {
+    const container = this.#dropContainer(event)
+    const item = this.#draggedItem
+    if (item) event.preventDefault()
+    this.dragEnd()
+
+    if (container) {
+      const restore = this.#move(item, container)
+      this.#pendingItems.add(item)
+      this.#protectBoard()
+      item.draggable = false
+
+      try {
+        const response = await this.#save(item, container)
+        if (!response.ok) throw new Error("Unable to move card")
+      } catch {
+        restore()
+        window.alert("The card couldn't be moved. Please try again.")
+      } finally {
+        this.#pendingItems.delete(item)
+        this.#protectBoard()
+        item.draggable = true
+      }
+    }
+  }
+
+  #protectBoard() {
+    // A broadcast refresh must not undo a drag or an optimistic move in flight.
+    this.element.toggleAttribute("data-turbo-permanent", Boolean(this.#draggedItem || this.#pendingItems.size))
+  }
+
+  #dropContainer(event) {
+    if (!this.#draggedItem) return
+
+    const container = event.target.closest('[data-drag-and-drop-target~="container"]')
+    if (this.containerTargets.includes(container) && !container.contains(this.#draggedItem) && container.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #highlight(container) {
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoverContainer = container
+    this.#hoverContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  #move(item, container) {
+    const source = item.closest('[data-drag-and-drop-target~="container"]')
+    const parent = item.parentElement
+    const nextSibling = item.nextSibling
+    const original = item.cloneNode(true)
+
+    this.#insert(item, container)
+    this.#updateAppearance(item, container)
+    this.#changeCount(source, -1)
+    this.#changeCount(container, 1)
+
+    return () => {
+      item.remove()
+      parent.insertBefore(original, nextSibling?.parentNode === parent ? nextSibling : null)
+      this.#changeCount(source, 1)
+      this.#changeCount(container, -1)
+    }
+  }
+
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="item"]'))
+    const goldenFirst = container.dataset.dragAndDropStatus === "triage"
+
+    // Moving records fresh activity. Match latest.with_golden_first for active
+    // columns, latest for Not Now, and recently_closed_first for Done.
+    const nextCard = goldenFirst && !item.classList.contains("golden-effect")
+      ? cards.find(card => !card.classList.contains("golden-effect"))
+      : cards[0]
+
+    if (nextCard) {
+      nextCard.before(item)
+    } else if (cards.length) {
+      cards[cards.length - 1].after(item)
+    } else {
+      const page = list.querySelector("turbo-frame") || list
+      page.prepend(item)
+    }
+  }
+
+  #updateAppearance(item, container) {
+    const status = container.dataset.dragAndDropStatus
+    const active = status === "triage"
+    item.classList.toggle("card--active", active)
+    item.classList.toggle("card--postponed", status === "not-now")
+    item.style.setProperty("--card-color", container.dataset.dragAndDropColor)
+    item.removeAttribute("aria-selected")
+    item.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+    item.querySelectorAll(".card__column-name").forEach(element => {
+      element.classList.toggle("card__column-name--current", active && element.dataset.columnId === container.dataset.dragAndDropColumnId)
+    })
+  }
+
+  #changeCount(container, difference) {
+    const counter = container.querySelector(".cards__expander")
+    const count = Number(counter.dataset.cardCount) + difference
+    counter.dataset.cardCount = count
+    counter.querySelector(".cards__expander-count").textContent = count > 99 ? "99+" : count
+    counter.style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  #save(item, container) {
+    const status = container.dataset.dragAndDropStatus
+    const columnId = container.dataset.dragAndDropColumnId
+    let url, method = "post", body
+
+    if (status === "triage") {
+      url = item.dataset.cardTriageUrl
+      if (columnId) {
+        body = { column_id: columnId }
+      } else {
+        method = "delete"
+      }
+    } else {
+      url = status === "closed" ? item.dataset.cardClosureUrl : item.dataset.cardNotNowUrl
+    }
+
+    // JSON avoids a Turbo Stream replacement. request.js uses Turbo.fetch, so
+    // the originating browser also ignores this mutation's refresh broadcast.
+    return new FetchRequest(method, url, { body, responseKind: "json" }).perform()
+  }
+}
