diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..4fd70a8
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,314 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @board = boards(:writebook)
+    @card = cards(:layout)
+    @column = columns(:writebook_in_progress)
+    Current.user = users(:david)
+    cards(:text).gild
+    @other_card = @board.cards.create!(title: "Another card", status: :published, column: @column, last_active_at: 2.days.ago)
+    sign_in_as(users(:david))
+  end
+
+  test "dropping moves immediately into the saved order without waiting for the save" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    pause_saves
+
+    drag_card_to(@card, dom_id(@column))
+
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+    assert_equal columns(:writebook_triage), @card.reload.column
+    pending_item = find("##{dom_id(@card, :article)}", visible: :all)
+    dispatch_drag "dragstart", pending_item
+    dispatch_drag "drop", find("#maybe")
+    assert_equal 1, page.evaluate_script("window.saveCount")
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container"
+
+    release_save
+    assert_equal @column, @card.reload.column
+    assert page.evaluate_script("window.draggedCard.isConnected")
+    assert page.evaluate_script('window.pendingSave.options.headers.has("X-Turbo-Request-Id")')
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+
+    page.refresh
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+  end
+
+  test "golden cards move ahead of other golden cards" do
+    @card = cards(:logo)
+    visit board_url(@board)
+    expand_column(@card.column)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    pause_saves
+
+    drag_card_to(@card, dom_id(@column))
+    assert_card_order @column, [ @card, cards(:text), @other_card ]
+    release_save
+    page.refresh
+    assert_card_order @column, [ @card, cards(:text), @other_card ]
+  end
+
+  test "cards can move through Done Not Now Maybe and an empty custom column" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    pause_saves
+
+    drag_card_to(@card, "closed-cards")
+    assert_column_cards "closed-cards", [ @card, cards(:shipping) ]
+    assert_card_state active: false, postponed: false, color: "var(--color-card-complete)"
+    release_save
+    assert @card.reload.closed?
+    expand_column("closed-cards")
+
+    drag_card_to(@card, "not-now")
+    assert_column_cards "not-now", [ @card ]
+    assert_card_state active: false, postponed: true, color: "var(--color-card-complete)"
+    release_save
+    assert @card.reload.postponed?
+    expand_column("not-now")
+
+    drag_card_to(@card, "maybe")
+    assert_column_cards "maybe", [ @card, cards(:buy_domain) ]
+    assert_card_state active: true, postponed: false, color: Column::Colored::DEFAULT_COLOR.to_s
+    release_save
+    assert @card.reload.awaiting_triage?
+
+    empty_column = columns(:writebook_on_hold)
+    drag_card_to(@card, dom_id(empty_column))
+    assert_card_order empty_column, [ @card ]
+    assert_card_state active: true, postponed: false, color: empty_column.color.to_s
+    release_save
+    assert_equal empty_column, @card.reload.column
+    page.refresh
+    assert_card_order empty_column, [ @card ]
+  end
+
+  test "closed and postponed cards rendered by the server can be dragged back into active columns" do
+    @card.postpone
+    visit board_url(@board)
+    pause_saves
+
+    [ [ cards(:shipping), "closed-cards" ], [ @card, "not-now" ] ].each do |card, source|
+      expand_column(source)
+      drag_card_to(card, "maybe")
+      assert_selector "#maybe ##{dom_id(card, :article)}.card--active"
+      assert_no_selector "#maybe ##{dom_id(card, :article)} .card__closed", visible: :all
+      release_save
+      assert card.reload.awaiting_triage?
+    end
+  end
+
+  test "same column drops do not reorder or save" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    pause_saves
+    original = all("##{dom_id(@card.column)} article.card").map { |item| item[:id] }
+
+    drag_card_to(@card, dom_id(@card.column))
+
+    assert_equal original, all("##{dom_id(@card.column)} article.card").map { |item| item[:id] }
+    assert_nil page.evaluate_script("window.pendingSave")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "hover and dragging styles are cleaned up after cancellation and external drops are ignored" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    pause_saves
+    item = find("##{dom_id(@card, :article)}")
+    destination = find("##{dom_id(@column)}")
+    dispatch_drag "dragstart", item
+    dispatch_drag "dragover", destination
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+
+    page.execute_script <<~JS, destination
+      const column = arguments[0]
+      column.dispatchEvent(new DragEvent("dragleave", { bubbles: true, relatedTarget: column.querySelector("header") }))
+    JS
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+    dispatch_drag "dragleave", destination
+    assert_no_selector ".drag-and-drop__hover-container"
+    dispatch_drag "dragend", item
+    assert_no_selector ".drag-and-drop__dragged-item"
+
+    dispatch_drag "drop", destination
+    assert_nil page.evaluate_script("window.pendingSave")
+    assert_selector "##{dom_id(@card.column)} ##{dom_id(@card, :article)}"
+  end
+
+  test "failed saves restore the exact position appearance and counts" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    pause_saves
+    source = dom_id(@card.column)
+    original_order = all("##{source} article.card").map { |item| item[:id] }
+    original_color = find("##{dom_id(@card, :article)}")[:style]
+    source_count = column_count(source)
+    destination_count = column_count(dom_id(@column))
+
+    [ 'window.finishSave(new Response("", { status: 422 }))', 'window.failSave(new TypeError("Offline"))' ].each do |failure|
+      drag_card_to(@card, dom_id(@column))
+      assert_equal source_count - 1, column_count(source)
+      assert_equal destination_count + 1, column_count(dom_id(@column))
+      assert_selector "##{dom_id(@card, :article)}[draggable=false]", visible: :all
+      accept_alert("The card couldn't be moved. Please try again.") { page.execute_script failure }
+
+      assert_equal original_order, all("##{source} article.card").map { |item| item[:id] }
+      assert_equal original_color, find("##{dom_id(@card, :article)}")[:style]
+      assert_equal source_count, column_count(source)
+      assert_equal destination_count, column_count(dom_id(@column))
+      assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    end
+  end
+
+  test "native browser dragging works" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    pause_saves
+
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)} .cards__expander"))
+
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+    release_save
+    assert_equal @column, @card.reload.column
+  end
+
+  test "moving the last card leaves an empty drop target" do
+    visit board_url(@board)
+    pause_saves
+    card = cards(:buy_domain)
+    drag_card_to(card, dom_id(columns(:writebook_review)))
+
+    assert_selector "#maybe .blank-slate--drag", text: "Drag cards here"
+    assert_equal 0, column_count("maybe")
+    release_save
+    expand_column(columns(:writebook_review))
+    drag_card_to(card, "maybe")
+    assert_no_selector "#maybe .blank-slate"
+    release_save
+    assert card.reload.awaiting_triage?
+  end
+
+  test "cards outside the editable board are not draggable" do
+    visit board_column_url(@board, @card.column)
+    assert_selector "##{dom_id(@card, :article)}"
+    assert_no_selector "article[draggable=true]", visible: :all
+  end
+
+  test "cards remain draggable after a normal live refresh" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    Current.user = users(:david)
+    @card.update!(title: "Changed elsewhere")
+    page.execute_script <<~JS
+      Turbo.renderStreamMessage('<turbo-stream action="refresh"></turbo-stream>')
+    JS
+    assert_selector "##{dom_id(@card, :article)} .card__title", text: "Changed elsewhere"
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+  end
+
+  test "a live refresh cannot undo a move while it is being saved" do
+    visit board_url(@board)
+    expand_column(@card.column)
+    pause_saves
+    drag_card_to(@card, dom_id(@column))
+
+    page.execute_script <<~JS
+      document.addEventListener("turbo:morph", () => document.body.dataset.dragTestMorphed = "true", { once: true })
+      Turbo.renderStreamMessage('<turbo-stream action="refresh"></turbo-stream>')
+    JS
+    assert_selector "body[data-drag-test-morphed=true]"
+    assert_card_order @column, [ cards(:text), @card, @other_card ]
+    assert page.evaluate_script("window.draggedCard.isConnected")
+
+    release_save
+    assert_no_selector ".card-columns[data-turbo-permanent]"
+    assert_equal @column, @card.reload.column
+  end
+
+  private
+    def assert_card_state(active:, postponed:, color:)
+      item = find("##{dom_id(@card, :article)}", visible: :all)
+      assert_equal active, item[:class].include?("card--active")
+      assert_equal postponed, item[:class].include?("card--postponed")
+      assert_includes item[:style], "--card-color: #{color};"
+    end
+
+    def column_count(column_id)
+      find("##{column_id} .cards__expander", visible: :all)["data-card-count"].to_i
+    end
+
+    def dispatch_drag(name, target)
+      page.execute_script <<~JS, name, target
+        const [name, target] = arguments
+        target.dispatchEvent(new DragEvent(name, { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))
+      JS
+    end
+
+    def expand_column(column)
+      column_id = column.is_a?(String) ? column : dom_id(column)
+      section = find("##{column_id}")
+      section.find(".cards__expander").click if section[:class].include?("is-collapsed")
+      assert_selector "##{column_id} .cards__list"
+    end
+
+    def pause_saves
+      page.execute_script <<~JS
+        window.saveCount = 0
+        window.originalFetch = window.fetch
+        window.fetch = (url, options) => {
+          if (options?.method && options.method !== "GET") {
+            window.saveCount += 1
+            window.pendingSave = { url, options }
+            return new Promise((resolve, reject) => { window.finishSave = resolve; window.failSave = reject })
+          }
+          return window.originalFetch(url, options)
+        }
+      JS
+    end
+
+    def drag_card_to(card, column_id)
+      assert_selector "##{column_id} .cards__list", visible: :all
+      item = find("##{dom_id(card, :article)}")
+      assert_equal "true", item[:draggable]
+      page.execute_script <<~JS, item, find("##{column_id}")
+        const [item, column] = arguments
+        window.draggedCard = item
+        const dataTransfer = new DataTransfer()
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def release_save
+      page.evaluate_async_script <<~JS
+        const done = arguments[arguments.length - 1]
+        window.originalFetch(window.pendingSave.url, window.pendingSave.options).then(response => {
+          window.finishSave(response)
+          done()
+        })
+      JS
+    end
+
+    def assert_card_order(column, cards)
+      assert_column_cards dom_id(column), cards
+    end
+
+    def assert_column_cards(column_id, cards)
+      assert_selector "##{column_id} article.card", count: cards.size, visible: :all
+      assert_equal cards.map { |card| dom_id(card, :article) },
+        all("##{column_id} article.card", visible: :all).map { |card| card[:id] }
+    end
+end
