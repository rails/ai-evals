+
+  test "a card can move again without waiting for its previous save" do
+    closed_count = column_count("closed-cards")
+    hold_saves
+    drag_card_to dom_id(@column)
+    drag_card_to "closed-cards"
+
+    assert_card_in "closed-cards"
+    assert_count "maybe", 0
+    assert_count dom_id(@column), 0
+    assert_count "closed-cards", closed_count + 1
+    assert_nil @card.reload.column
+
+    # Requests are serialized, but rendering never waits for either request.
+    release_save
+    assert_equal @column, @card.reload.column
+    assert_card_in "closed-cards"
