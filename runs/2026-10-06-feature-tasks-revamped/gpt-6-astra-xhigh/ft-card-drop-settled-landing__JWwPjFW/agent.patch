+        assert_selector "##{dom_id(@card, :article)} .card__closed-title", text: "Not Now", visible: :all
+      else
+        assert_selector "##{dom_id(@card, :article)}.card--active", visible: :all
+        assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+      end
+
+      release_save
+      @card.reload
