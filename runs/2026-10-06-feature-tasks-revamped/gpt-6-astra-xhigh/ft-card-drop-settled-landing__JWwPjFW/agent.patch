diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d518723
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,214 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "card", "column", "stamp", "error" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #card
+  #hoveredColumn
+  #saves = new Map()
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && this.cardTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!this.cardTargets.includes(card)) {
+      event.preventDefault()
+      return
+    }
+
+    this.#card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(this.draggedItemClass)
+    this.errorTarget.hidden = true
+  }
+
+  over(event) {
+    const column = this.#dropColumn(event)
+    this.#highlight(column)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.#hoveredColumn?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const column = this.#dropColumn(event)
+    if (!column) return
+
+    event.preventDefault()
+    const card = this.#card
+    const source = card.closest('[data-drag-and-drop-target~="column"]')
+    this.end()
+
+    const original = this.#snapshot(card)
+    this.#insert(card, column)
+    this.#updatePreview(card, column)
+    this.#changeCount(source, -1)
+    this.#changeCount(column, 1)
+
+    this.#save(card, column, original)
+  }
+
+  end() {
+    this.#card?.classList.remove(this.draggedItemClass)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  #dropColumn(event) {
+    if (!this.#card) return
+
+    const column = event.target.closest('[data-drag-and-drop-target~="column"]')
+    if (this.columnTargets.includes(column) && !column.contains(this.#card) && column.querySelector(".cards__list")) {
+      return column
+    }
+  }
+
+  #highlight(column) {
+    this.#hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.#hoveredColumn = column
+    this.#hoveredColumn?.classList.add(this.hoverContainerClass)
+  }
+
+  #snapshot(card) {
+    const siblings = Array.from(card.parentNode.children)
+    return {
+      column: card.closest('[data-drag-and-drop-target~="column"]'),
+      parent: card.parentNode,
+      following: siblings.slice(siblings.indexOf(card) + 1),
+      card: card.cloneNode(true)
+    }
+  }
+
+  #insert(card, column) {
+    const cards = this.cardTargets.filter(item => column.contains(item))
+    const goldenFirst = column.dataset.dragAndDropStatus === "active" && !card.classList.contains("golden-effect")
+    const next = cards.find(item => !goldenFirst || !item.classList.contains("golden-effect"))
+
+    // Moving records fresh activity: newest first, below gold cards in active columns.
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      column.querySelector(".cards__list").prepend(card)
+    }
+  }
+
+  #updatePreview(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const active = status === "active"
+    const columnId = column.dataset.dragAndDropColumnId
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", status === "postponed")
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".bubble")?.remove()
+
+    const label = card.querySelector(".card__header .card__column-name")
+    label.hidden = !active || !columnId
+
+    if (status !== "closed") {
+      card.style.setProperty("--card-color", columnId ? column.style.getPropertyValue("--card-color") : "var(--color-card-default)")
+      label.querySelector("span").textContent = columnId ? column.dataset.columnName : ""
+      card.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === columnId)
+      })
+    }
+
+    if (!active) {
+      const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+      const title = stamp.querySelector(".card__closed-title")
+      title.textContent = title.dataset.text = column.dataset.columnName
+      stamp.querySelector(".card__closed-date").textContent = new Intl.DateTimeFormat("en-US", {
+        month: "short", day: "2-digit", year: "numeric", timeZone: getMetaContent("timezone")
+      }).format(new Date())
+      card.querySelector(".card__body").append(stamp)
+    }
+
+    const time = card.querySelector(".card__meta-text--updated time")
+    if (time) {
+      time.dateTime = Math.floor(Date.now() / 1000)
+      time.dispatchEvent(new CustomEvent("turbo:morph-element", { bubbles: true }))
+    }
+  }
+
+  #changeCount(column, change) {
+    const counter = column.querySelector("[data-card-count]")
+    const count = Number(counter.dataset.cardCount) + change
+    counter.dataset.cardCount = count
+    counter.textContent = count > 99 ? "99+" : count
+    column.querySelector(".cards__expander").style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  #save(card, column, original) {
+    const pending = this.#saves.get(card) || { saved: original, promise: Promise.resolve() }
+    const move = { snapshot: this.#snapshot(card), request: this.#request(card, column) }
+    pending.latest = move
+    this.#saves.set(card, pending)
+
+    // Serialize saves per card without delaying the next optimistic move.
+    pending.promise = pending.promise.then(async () => {
+      try {
+        // request.js uses Turbo.fetch, so our own refresh broadcast is ignored.
+        const response = await move.request.perform()
+        if (!response.ok) throw new Error(`Card move failed: ${response.statusCode}`)
+        pending.saved = move.snapshot
+      } catch {
+        if (pending.latest === move) this.#restore(card, pending.saved)
+      } finally {
+        if (pending.latest === move) this.#saves.delete(card)
+      }
+    })
+  }
+
+  #restore(card, saved) {
+    if (this.element.isConnected && card.isConnected) {
+      const column = card.closest('[data-drag-and-drop-target~="column"]')
+      const next = saved.following.find(sibling => sibling.parentNode === saved.parent)
+      saved.parent.insertBefore(saved.card, next || null)
+      card.remove()
+      this.#changeCount(column, -1)
+      this.#changeCount(saved.column, 1)
+      this.errorTarget.hidden = false
+    }
+  }
+
+  #request(card, column) {
+    const status = column.dataset.dragAndDropStatus
+    const columnId = column.dataset.dragAndDropColumnId
+    const options = { responseKind: "json" }
+
+    if (status === "closed") {
+      return new FetchRequest("post", card.dataset.cardClosureUrl, options)
+    } else if (status === "postponed") {
+      return new FetchRequest("post", card.dataset.cardNotNowUrl, options)
+    } else if (columnId) {
+      return new FetchRequest("post", card.dataset.cardTriageUrl, { ...options, body: { column_id: columnId } })
+    } else {
+      return new FetchRequest("delete", card.dataset.cardTriageUrl, options)
+    }
+  }
+}
