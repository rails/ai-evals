+
+  private
+    def visit_board
+      visit board_url(@board)
+      assert_selector ".card-columns .cards__list", count: @board.columns.count + 3, visible: :all
+      assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+    end
+
+    def assert_card_in(column_id)
+      assert_selector "##{column_id} ##{dom_id(@card, :article)}", visible: :all
+    end
+
+    def card_ids(column_id)
+      all("##{column_id} .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def column_count(column_id)
+      find("##{column_id} [data-card-count]", visible: :all)["data-card-count"].to_i
+    end
+
+    def assert_count(column_id, count)
+      assert_selector "##{column_id} [data-card-count='#{count}']", text: count > 99 ? "99+" : count.to_s, visible: :all
+    end
+
+    def assert_drag_finished
+      assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    end
+
+    def hold_saves
+      page.execute_script <<~JS
+        window.originalFetch = window.fetch
+        window.pendingSaves = []
+        window.fetch = (url, options = {}) => {
+          if (["POST", "DELETE"].includes(options.method?.toUpperCase())) {
+            return new Promise((resolve, reject) => pendingSaves.push({ url, options, resolve, reject }))
+          }
+          return originalFetch(url, options)
+        }
+      JS
+    end
+
+    def start_drag
+      page.execute_script "window.dragData = new DataTransfer()"
+      drag_event "dragstart", "##{dom_id(@card, :article)}"
+    end
+
+    def drag_event(name, selector)
+      page.execute_script <<~JS, name, selector
+        document.querySelector(arguments[1]).dispatchEvent(new DragEvent(arguments[0], {
+          bubbles: true, cancelable: true, dataTransfer: window.dragData
+        }))
+      JS
+    end
+
+    def drag_card_to(column_id)
+      start_drag
+      drag_event "dragover", "##{column_id}"
+      drag_event "drop", "##{column_id}"
+      drag_event "dragend", "##{dom_id(@card, :article)}"
+    end
+
+    def release_save
+      assert_equal 1, page.evaluate_script("pendingSaves.length")
+      status = page.evaluate_async_script <<~JS
+        const done = arguments[0]
+        const { url, options, resolve, reject } = pendingSaves.shift()
+        originalFetch(url, options).then(response => { resolve(response); done(response.status) }).catch(reject)
+      JS
+      assert_equal 204, status
+    end
+end
