+
+    page.execute_script <<~JS, request_id
+      window.boardFetches = 0
+      window.fetch = (...args) => { boardFetches++; return originalFetch(...args) }
+      Turbo.renderStreamMessage(`<turbo-stream action="refresh" request-id="${arguments[0]}"></turbo-stream>`)
+    JS
