+  test "a later move can succeed even if its previous save failed" do
+    hold_saves
+    drag_card_to dom_id(@column)
+    drag_card_to "not-now"
+    page.execute_script("pendingSaves.shift().resolve(new Response(null, { status: 422 }))")
+
+    assert_card_in "not-now"
+    release_save
+    assert @card.reload.postponed?
+    assert_count "maybe", 0
