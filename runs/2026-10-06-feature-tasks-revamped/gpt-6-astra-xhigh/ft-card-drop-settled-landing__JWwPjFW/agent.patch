diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..6089ee2
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,413 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_on_hold)
+    visit_board
+  end
+
+  test "dropping moves the card before saving and keeps it there after saving" do
+    hold_saves
+    drag_card_to dom_id(@column)
+
+    assert_card_in dom_id(@column)
+    assert_no_selector "#maybe ##{dom_id(@card, :article)}", visible: :all
+    assert_count dom_id(@column), 1
+    assert_count "maybe", 0
+    assert_nil @card.reload.column
+    assert_selector "##{dom_id(@card, :article)} .card__meta-text--updated", text: "today", visible: :all
+    assert_equal @column.color.to_s, page.evaluate_script("document.getElementById('#{dom_id(@card, :article)}').style.getPropertyValue('--card-color')")
+
+    release_save
+    assert_equal @column, @card.reload.column
+    assert_card_in dom_id(@column)
+    assert_drag_finished
+
+    refresh
+    assert_card_in dom_id(@column)
+  end
+
+  test "native browser dragging moves a card to a collapsed column" do
+    hold_saves
+    find("##{dom_id(@card, :article)}").drag_to find("##{dom_id(@column)} .cards__expander")
+
+    assert_card_in dom_id(@column)
+    release_save
+    assert_equal @column, @card.reload.column
+  end
+
+  test "drag feedback follows the pointer and clears when canceled" do
+    start_drag
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+
+    drag_event "dragover", "##{dom_id(@column)} .cards__expander-title"
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+
+    # Moving between children of a column must not clear its highlight.
+    page.execute_script <<~JS, dom_id(@column)
+      const column = document.getElementById(arguments[0])
+      column.querySelector(".cards__header").dispatchEvent(new DragEvent("dragleave", {
+        bubbles: true, relatedTarget: column.querySelector(".cards__expander-title")
+      }))
+    JS
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+
+    drag_event "dragover", "#not-now"
+    assert_no_selector "##{dom_id(@column)}.drag-and-drop__hover-container"
+    assert_selector "#not-now.drag-and-drop__hover-container"
+
+    drag_event "dragleave", "#not-now"
+    assert_no_selector ".drag-and-drop__hover-container"
+    drag_event "dragend", "##{dom_id(@card, :article)}"
+    assert_drag_finished
+    assert_nil @card.reload.column
+  end
+
+  test "dropping in the same column or outside the board is a no-op" do
+    hold_saves
+    original = card_ids("maybe")
+    drag_card_to "maybe"
+    assert_equal original, card_ids("maybe")
+    assert_equal 0, page.evaluate_script("pendingSaves.length")
+    assert_drag_finished
+
+    start_drag
+    drag_event "drop", "body"
+    drag_event "dragend", "##{dom_id(@card, :article)}"
+    assert_equal original, card_ids("maybe")
+    assert_equal 0, page.evaluate_script("pendingSaves.length")
+    assert_drag_finished
+
+    @card = cards(:layout)
+    source = dom_id(@card.column)
+    original = card_ids(source)
