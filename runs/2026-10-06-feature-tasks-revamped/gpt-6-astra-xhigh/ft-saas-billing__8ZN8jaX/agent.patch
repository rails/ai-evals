@@ -0,0 +1,18 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find(params[:plan_key])
+    if Plan.paid.include?(plan) && !Current.account.comped?
+      checkout = Current.account.billing_subscription.checkout(plan,
+        success_url: saas.account_billing_url, cancel_url: saas.account_billing_url)
+      redirect_to checkout.url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  rescue ArgumentError
+    redirect_to saas.account_billing_url, alert: "Manage your existing subscription in the customer portal."
+  rescue Stripe::StripeError, KeyError
+    redirect_to saas.account_billing_url, alert: "Billing is temporarily unavailable. Please try again."
+  end
+end
