@@ -0,0 +1,16 @@
+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      # Serialize the check with publishing so concurrent requests cannot both
+      # consume the last available card. Draft creation does not take this path.
+      Current.account.with_lock do
+        if Current.account.exceeding_card_limit?
+          head :forbidden
+        else
+          yield
+        end
+      end
+    end
+end
