+<% @page_title = "Plans and billing" %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center">
+  <h2>Current plan: <%= @account.billing_plan.name %></h2>
+  <% if @account.comped? %><p>This account is complimentary.</p><% end %>
+  <p>Changes made in Stripe appear here after your subscription is confirmed.</p>
