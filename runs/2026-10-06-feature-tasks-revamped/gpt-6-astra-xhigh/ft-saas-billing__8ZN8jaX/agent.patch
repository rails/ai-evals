diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..a1d1cc2
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,15 @@
+class Stripe::WebhooksController < ActionController::API
+  SUBSCRIPTION_EVENTS = %w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ].freeze
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    if SUBSCRIPTION_EVENTS.include?(event.type)
+      Account::Subscription.find_by(stripe_customer_id: event.data.object.customer)&.apply_stripe_event(event)
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..1cae232
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,75 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.paid?
+      subscription.plan
+    elsif comped?
+      Plan.find("monthly_v1")
+    else
+      Plan.free
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def override_usage(attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_usage_override
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_remaining
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining&.between?(1, 100) || false
+  end
+
+  def billing_subscription
+    subscription || create_subscription!
+  rescue ActiveRecord::RecordNotUnique
+    reload_subscription
+  end
+end
