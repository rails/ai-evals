diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..79c7c48
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,83 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def paid?
+    %w[ active trialing ].include?(status) && plan.present? && !plan.free?
+  end
+
+  def subscribed?
+    stripe_subscription_id.present? && !%w[ canceled incomplete_expired ].include?(status)
+  end
+
+  def checkout(plan, success_url:, cancel_url:)
+    raise ArgumentError, "Choose a paid plan" unless Plan.paid.include?(plan)
+
+    with_lock do
+      raise ArgumentError, "Manage your existing subscription in the customer portal" if subscribed?
+
+      price_id = plan.stripe_price_id
+      ensure_stripe_customer
+      Stripe::Checkout::Session.create(
+        mode: "subscription", customer: stripe_customer_id,
+        client_reference_id: account_id,
+        line_items: [ { price: price_id, quantity: 1 } ],
+        subscription_data: { metadata: { account_id: account_id } },
+        success_url: success_url, cancel_url: cancel_url
+      )
+    end
+  end
+
+  def portal(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url) if stripe_customer_id.present?
+  end
+
+  # Webhooks are retried and may arrive out of order. Only signed subscription
+  # events change entitlements; a browser returning from Checkout never does.
+  def apply_stripe_event(event)
+    with_lock do
+      if applicable_event?(event)
+        remote = event.data.object
+        item = remote.items.data.first
+        update!(
+          stripe_subscription_id: remote.id,
+          plan_key: Plan.find_by_price_id(item&.price&.id)&.key,
+          status: event.type == "customer.subscription.deleted" ? "canceled" : remote.status,
+          current_period_end: stripe_time(remote[:current_period_end] || item&.[](:current_period_end)),
+          cancel_at: stripe_time(remote[:cancel_at]),
+          last_stripe_event_created: event.created,
+          last_stripe_event_id: event.id
+        )
+      end
+    end
+  end
+
+  private
+    def ensure_stripe_customer
+      unless stripe_customer_id?
+        customer = Stripe::Customer.create(
+          { email: account.owner_email, name: account.name, metadata: { account_id: account_id } },
+          { idempotency_key: "fizzy-account-#{account_id}" }
+        )
+        update!(stripe_customer_id: customer.id)
+      end
+    end
+
+    def applicable_event?(event)
+      remote = event.data.object
+      return false if event.id == last_stripe_event_id
+      return false if last_stripe_event_created && event.created < last_stripe_event_created
+      return false if remote.customer != stripe_customer_id
+      return false if stripe_subscription_id.present? && remote.id != stripe_subscription_id && event.type != "customer.subscription.created"
+      return false if remote.id == stripe_subscription_id && status == "canceled"
+
+      true
+    end
+
+    def stripe_time(timestamp)
+      Time.at(timestamp).utc if timestamp
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..84fd088
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,51 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, price_environment_key: nil)
+    @key, @name, @price = key, name, price
+    @card_limit, @storage_limit = card_limit, storage_limit
+    @price_environment_key = price_environment_key
+  end
+
+  PLANS = [
+    new(key: "free_v1", name: "Free", price: 0, card_limit: 1000, storage_limit: 1.gigabyte),
+    new(key: "monthly_v1", name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes,
+      price_environment_key: "STRIPE_MONTHLY_V1_PRICE_ID"),
+    new(key: "monthly_extra_storage_v1", name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes,
+      price_environment_key: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  ].each(&:freeze).freeze
+
+  class << self
+    def all
+      PLANS
+    end
+
+    def free
+      all.first
+    end
+
+    def paid
+      all.reject(&:free?)
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key }
+    end
+
+    def find_by_price_id(price_id)
+      paid.find { |plan| plan.configured_price_id.present? && plan.configured_price_id == price_id }
+    end
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def configured_price_id
+    ENV[@price_environment_key] if @price_environment_key
+  end
+
+  def stripe_price_id
+    configured_price_id.presence || raise(KeyError, "Missing Stripe price for #{key}")
+  end
+end
