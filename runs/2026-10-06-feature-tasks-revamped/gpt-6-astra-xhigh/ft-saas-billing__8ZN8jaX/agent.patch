@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 100)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "at the limit API creation and publishing are refused but drafting and editing work" do
+    @account.override_usage(card_count: 1000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "Blocked" } }, as: :json
+    end
+    assert_response :forbidden
+
+    draft = cards(:unfinished_thoughts)
+    post card_publish_path(draft)
+    assert_response :forbidden
+    assert draft.reload.drafted?
+
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+    assert_difference -> { Card.drafted.count } do
+      post board_cards_path(boards(:miltons_wish_list))
+    end
+    assert_response :redirect
+    draft = Card.last
+    patch card_path(draft), params: { card: { title: "Still drafting" } }, as: :json
+    assert_response :success
+    assert_equal "Still drafting", draft.reload.title
+  end
+
+  test "the last available card can be published without counting drafts" do
+    @account.cards.published.delete_all
+    template = cards(:unfinished_thoughts).attributes.except("id", "number").merge("status" => "published")
+    @account.cards.insert_all!((1..999).map { |number| template.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => number + 10000) })
+    assert_equal 999, @account.card_count
+
+    post card_publish_path(cards(:unfinished_thoughts))
+    assert_response :redirect
+    assert_equal 1000, @account.card_count
+    post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "One too many" } }, as: :json
+    assert_response :forbidden
+  end
+
+  test "the create buttons become an Upgrade pitch and the warning counts down" do
+    @account.override_usage(card_count: 950)
+    get card_draft_path(cards(:unfinished_thoughts))
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_select "strong", text: "50 cards left"
+
+    @account.override_usage(card_count: 999)
+    get card_draft_path(cards(:unfinished_thoughts))
+    assert_select "strong", text: "1 card left"
+
+    @account.override_usage(card_count: 1000)
+    get card_draft_path(cards(:unfinished_thoughts))
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "paid and comped accounts can publish beyond 1000 cards" do
+    @account.override_usage(card_count: 1000)
+    @account.comp
+    post board_cards_path(boards(:miltons_wish_list)), params: { card: { title: "Comped" } }, as: :json
+    assert_response :created
+
+    @account.uncomp
+    @account.create_subscription!(plan_key: "monthly_v1", status: "active")
+    post card_publish_path(cards(:unfinished_thoughts))
+    assert_response :redirect
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..e7fca4a
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_local")
+  end
+
+  test "signed subscription events activate, change and cancel the account plan without authentication" do
+    deliver_event
+    assert_response :ok
+    assert_equal "Unlimited", @account.reload.billing_plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    deliver_event(type: "customer.subscription.updated", price: "price_plus", created: 101)
+    assert_response :ok
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    deliver_event(type: "customer.subscription.deleted", status: "canceled", created: 102)
+    assert_response :ok
+    assert_equal "Free", @account.reload.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "cancellation scheduled for period end retains paid access until Stripe ends it" do
+    cancel_at = 1.month.from_now.to_i
+    deliver_event(cancel_at: cancel_at)
+    assert_response :ok
+    assert @subscription.reload.paid?
+    assert_equal Time.at(cancel_at).utc, @subscription.cancel_at
+    assert_equal Time.at(cancel_at).utc, @subscription.current_period_end
+  end
+
+  test "duplicates and older events cannot roll back subscription state" do
+    deliver_event(price: "price_plus", created: 101)
+    timestamp = @subscription.reload.updated_at
+    deliver_event(price: "price_plus", created: 101)
+    assert_equal timestamp, @subscription.reload.updated_at
+    deliver_event(created: 100)
+    assert_equal "monthly_extra_storage_v1", @subscription.reload.plan_key
+
+    deliver_event(type: "customer.subscription.deleted", status: "canceled", created: 102)
+    deliver_event(type: "customer.subscription.updated", created: 102)
+    assert_not @subscription.reload.paid?
+  end
+
+  test "events for old subscriptions cannot cancel a replacement subscription" do
+    deliver_event
+    deliver_event(type: "customer.subscription.deleted", status: "canceled", created: 101)
+    deliver_event(subscription_id: "sub_new", created: 102)
+    deliver_event(type: "customer.subscription.deleted", status: "canceled", created: 103)
+    assert @subscription.reload.paid?
+    assert_equal "sub_new", @subscription.stripe_subscription_id
+  end
+
+  test "invalid signatures and malformed signed JSON are rejected" do
+    untenanted { post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "invalid", "Content-Type" => "application/json" } }
+    assert_response :bad_request
+    post_signed "not json"
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "unknown customers and unrelated events are ignored" do
+    deliver_event(customer: "cus_other")
+    assert_response :ok
+    deliver_event(type: "checkout.session.completed")
+    assert_response :ok
+    assert_nil @subscription.reload.status
+  end
+
+  test "unknown prices and inactive subscriptions do not grant paid access" do
+    deliver_event(price: "price_unknown")
+    assert_not @subscription.reload.paid?
+    deliver_event(type: "customer.subscription.updated", status: "unpaid", created: 101)
+    assert_not @subscription.reload.paid?
+  end
+
+  private
+    def deliver_event(type: "customer.subscription.created", price: "price_unlimited", status: "active", created: 100, customer: "cus_local", subscription_id: "sub_local", cancel_at: nil)
+      post_signed({ id: "evt_#{type}_#{created}", object: "event", type: type, created: created,
+        data: { object: { id: subscription_id, object: "subscription", customer: customer, status: status, cancel_at: cancel_at,
+          items: { object: "list", data: [ { id: "si_local", object: "subscription_item", price: { id: price, object: "price" }, current_period_end: 1.month.from_now.to_i } ] } } } }.to_json)
+    end
+
+    def post_signed(payload)
+      timestamp = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", ENV["STRIPE_WEBHOOK_SECRET"], "#{timestamp}.#{payload}")
+      untenanted do
+        post "/stripe/webhooks", params: payload,
+          headers: { "Content-Type" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}" }
+      end
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..6a6cab3
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  test "free plan includes 1000 published cards and 1 GB" do
+    account = accounts(:initech)
+    assert_equal "Free", account.billing_plan.name
+    assert_equal 1000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+    assert_equal account.cards.published.count, account.card_count
+  end
+
+  test "card warning starts at 100 remaining and stops at the limit" do
+    account = accounts(:initech)
+    account.stubs(:card_count).returns(899)
+    assert_not account.nearing_card_limit?
+    account.stubs(:card_count).returns(900)
+    assert account.nearing_card_limit?
+    assert_equal 100, account.cards_remaining
+    account.stubs(:card_count).returns(1000)
+    assert account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+    account.stubs(:card_count).returns(1001)
+    assert_equal 0, account.cards_remaining
+  end
+
+  test "paid plans and comps have their own allowances" do
+    account = accounts(:initech)
+    account.override_usage(card_count: 1001, bytes_used: 4.gigabytes)
+    assert account.exceeding_card_limit?
+    assert account.exceeding_storage_limit?
+    subscription = account.create_subscription!(plan_key: "monthly_v1", status: "active")
+    assert_nil account.card_limit
+    assert_not account.exceeding_card_limit?
+    assert_not account.exceeding_storage_limit?
+    assert_not account.nearing_card_limit?
+    assert_equal 5.gigabytes, account.storage_limit
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    account.comp
+    assert_equal 500.gigabytes, account.storage_limit
+    subscription.update!(status: "canceled")
+    assert_equal "Unlimited", account.billing_plan.name
+    account.uncomp
+    assert_equal "Free", account.billing_plan.name
+  end
+
+  test "usage overrides accept zero and blanks and reset to measured usage" do
+    account = accounts(:initech)
+    measured_cards, measured_bytes = account.card_count, account.bytes_used
+    account.override_usage(card_count: 0, bytes_used: 0)
+    assert_equal 0, account.card_count
+    assert_equal 0, account.bytes_used
+    account.override_usage(card_count: "", bytes_used: "")
+    assert_equal measured_cards, account.card_count
+    assert_equal measured_bytes, account.bytes_used
+    account.override_usage(card_count: 1500, bytes_used: 10.gigabytes)
+    account.reset_usage_override
+    assert_nil account.overridden_limits
+    assert_equal measured_cards, account.card_count
+    assert_equal measured_bytes, account.bytes_used
+  end
+
+  test "storage exceptions continue to work on paid accounts" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: "monthly_v1", status: "trialing")
+    account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, account.storage_limit
+  end
+end
