diff --git a/saas/test/stripe_test_helper.rb b/saas/test/stripe_test_helper.rb
new file mode 100644
index 0000000..feb2878
--- /dev/null
+++ b/saas/test/stripe_test_helper.rb
@@ -0,0 +1,24 @@
+module StripeTestHelper
+  extend ActiveSupport::Concern
+
+  included do
+    setup do
+      @stripe_environment = %w[ STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ].index_with { |key| ENV[key] }
+      ENV.update("STRIPE_SECRET_KEY" => "sk_test_local", "STRIPE_WEBHOOK_SECRET" => "whsec_local",
+        "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus")
+      @stripe_api_key = Stripe.api_key
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+      WebMock.disable_net_connect!
+    end
+
+    teardown do
+      @stripe_environment.each { |key, value| value ? ENV[key] = value : ENV.delete(key) }
+      Stripe.api_key = @stripe_api_key
+      WebMock.allow_net_connect!
+    end
+  end
+
+  def stripe_response(body)
+    { status: 200, headers: { "Content-Type" => "application/json" }, body: body.to_json }
+  end
+end
