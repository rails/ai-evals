diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..275c829
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+require_relative "../../stripe_test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  include StripeTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+    sign_in_as :mike
+  end
+
+  test "admins see their plan and upgrade in settings and the approved prices" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Plan: Free"
+    assert_select "a", text: "Upgrade"
+    get saas.account_billing_path
+    assert_response :success
+    assert_select "h3", text: "Unlimited — $20/month"
+    assert_select "h3", text: "Unlimited+ — $25/month"
+  end
+
+  test "checkout uses the configured price and account, not client supplied Stripe identifiers" do
+    customer = stub_request(:post, "https://api.stripe.com/v1/customers").with { |request|
+      body = Rack::Utils.parse_nested_query(request.body)
+      body["metadata"]["account_id"] == @account.id
+    }.to_return(stripe_response(id: "cus_local", object: "customer"))
+    checkout = stub_request(:post, "https://api.stripe.com/v1/checkout/sessions").with { |request|
+      body = Rack::Utils.parse_nested_query(request.body)
+      body["mode"] == "subscription" && body["customer"] == "cus_local" &&
+        body["line_items"]["0"]["price"] == "price_plus" &&
+        body["subscription_data"]["metadata"]["account_id"] == @account.id &&
+        body["success_url"].include?("#{@account.slug}/account/billing")
+    }.to_return(stripe_response(id: "cs_local", object: "checkout.session", url: "https://checkout.stripe.com/local"))
+
+    post saas.account_billing_checkout_path, params: { plan_key: "monthly_extra_storage_v1", customer: "cus_other", price: "price_other" }
+    assert_redirected_to "https://checkout.stripe.com/local"
+    assert_requested customer
+    assert_requested checkout
+    assert_equal "cus_local", @account.reload.subscription.stripe_customer_id
+    assert_equal "Free", @account.billing_plan.name
+  end
+
+  test "portal uses only this account's customer and returns to billing" do
+    @account.create_subscription!(stripe_customer_id: "cus_local", plan_key: "monthly_v1", status: "active")
+    portal = stub_request(:post, "https://api.stripe.com/v1/billing_portal/sessions").with { |request|
+      body = Rack::Utils.parse_nested_query(request.body)
+      body["customer"] == "cus_local" && body["return_url"].include?("#{@account.slug}/account/billing")
+    }.to_return(stripe_response(id: "bps_local", object: "billing_portal.session", url: "https://billing.stripe.com/local"))
+    post saas.account_billing_portal_path, params: { customer: "cus_other" }
+    assert_redirected_to "https://billing.stripe.com/local"
+    assert_requested portal
+  end
+
+  test "unknown or free plans cannot be checked out" do
+    %w[ free_v1 invalid ].each do |key|
+      post saas.account_billing_checkout_path, params: { plan_key: key }
+      assert_response :unprocessable_entity
+    end
+    assert_nil @account.reload.subscription
+  end
+
+  test "members cannot access billing or start Stripe sessions" do
+    users(:mike).update!(role: :member)
+    get account_settings_path
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+    get saas.account_billing_path
+    assert_response :forbidden
+    post saas.account_billing_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path
+    assert_response :forbidden
+  end
+
+  test "account admins cannot bill an account they do not belong to" do
+    post saas.account_billing_checkout_path(script_name: accounts(:acme).slug), params: { plan_key: "monthly_v1" }
+    assert_response :redirect
+    assert_nil accounts(:acme).subscription
+  end
+
+  test "missing price configuration does not contact Stripe" do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    post saas.account_billing_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_redirected_to saas.account_billing_path
+    assert_match /temporarily unavailable/, flash[:alert]
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "Stripe failures preserve the free plan and show a retry message" do
+    Stripe::Customer.stubs(:create).raises(Stripe::APIConnectionError)
+    post saas.account_billing_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_redirected_to saas.account_billing_path
+    assert_match /temporarily unavailable/, flash[:alert]
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "existing subscriptions must use the portal instead of subscribing twice" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_local", stripe_subscription_id: "sub_local", plan_key: "monthly_v1", status: "active")
+    %w[ active past_due unpaid incomplete ].each do |status|
+      subscription.update!(status: status)
+      post saas.account_billing_checkout_path, params: { plan_key: "monthly_v1" }
+      assert_redirected_to saas.account_billing_path
+      assert_match /existing subscription/, flash[:alert]
+    end
+  end
+
+  test "portal without a Stripe customer and checkout for a comped account are refused" do
+    post saas.account_billing_portal_path
+    assert_response :unprocessable_entity
+    @account.comp
+    post saas.account_billing_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_response :unprocessable_entity
+  end
+end
