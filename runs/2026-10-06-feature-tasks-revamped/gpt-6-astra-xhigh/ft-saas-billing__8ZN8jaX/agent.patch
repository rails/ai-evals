+    <section class="margin-block">
+      <h3><%= plan.name %> — <%= plan.free? ? "Free" : "$#{plan.price}/month" %></h3>
+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) : "Unlimited" %> cards · <%= number_to_human_size(plan.storage_limit) %> storage</p>
+      <% unless plan.free? || @account.comped? || @account.subscription&.subscribed? %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_billing_checkout_path, params: { plan_key: plan.key }, class: "btn", data: { turbo: false } %>
+      <% end %>
+    </section>
+  <% end %>
+  <% if @account.subscription&.stripe_customer_id.present? %>
+    <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn", data: { turbo: false } %>
+  <% end %>
+  <%= link_to "Back to settings", main_app.account_settings_path %>
+</div>
