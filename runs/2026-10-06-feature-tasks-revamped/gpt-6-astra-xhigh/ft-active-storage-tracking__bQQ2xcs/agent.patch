new file mode 100644
index 0000000..eb7f4a9
--- /dev/null
+++ b/app/jobs/storage/update_job.rb
@@ -0,0 +1,12 @@
+class Storage::UpdateJob < ApplicationJob
+  queue_as :backend
+  limits_concurrency key: ->(account) { account.id }
+
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked
+
+  def perform(account)
+    Storage::Total.for(account).refresh
+    self.class.perform_later(account) if Storage::Change.exists?(account_id: account.id)
+  end
+end
