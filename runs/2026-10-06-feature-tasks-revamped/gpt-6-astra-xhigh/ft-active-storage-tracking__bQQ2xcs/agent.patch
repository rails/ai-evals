diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..6ad326c
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,22 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :track_storage_change
+    before_destroy :track_storage_change
+  end
+
+  # Active Storage's purge, purge_later and has_one detach use delete rather
+  # than destroy, so callbacks alone don't cover attachment removal.
+  def delete
+    transaction do
+      track_storage_change
+      super
+    end
+  end
+
+  private
+    def track_storage_change
+      Storage::Change.record_attachment(record, name)
+    end
+end
diff --git a/app/models/storage/change.rb b/app/models/storage/change.rb
new file mode 100644
index 0000000..578ad8e
--- /dev/null
+++ b/app/models/storage/change.rb
@@ -0,0 +1,69 @@
+# A transactional, coalescing outbox. Writers never lock an account-wide
+# counter. Workers acknowledge only the version they read, so changes committed
+# during calculation remain pending for the next batch.
+class Storage::Change < ApplicationRecord
+  RECORD_TYPES = { "Board" => Board, "Card" => Card, "Comment" => Comment }.freeze
+
+  class << self
+    def record(record)
+      invalidate([ { account_id: record.account_id, record_type: record.class.name, record_id: record.id } ])
+    end
+
+    def record_attachment(record, name)
+      case record
+      when Card
+        self.record(record) if name == "image"
+      when ActionText::RichText
+        expected_name = { "Board" => "public_description", "Card" => "description", "Comment" => "body" }[record.record_type]
+        if name == "embeds" && record.name == expected_name
+          invalidate([ { account_id: record.account_id, record_type: record.record_type, record_id: record.record_id } ])
+        end
+      end
+    end
+
+    def process_later
+      Account.where(id: select(:account_id)).find_each do |account|
+        Current.with_account(account) { Storage::UpdateJob.perform_later(account) }
+      end
+
+      backfilled_accounts = Storage::Total.where(record_type: "Account").where.not(backfilled_at: nil).select(:record_id)
+      Account.where.not(id: backfilled_accounts).find_each do |account|
+        Current.with_account(account) { Storage::BackfillJob.perform_later(account) }
+      end
+    end
+
+    def acknowledge(changes)
+      if changes.any?
+        where([ :id, :version ] => changes.map { |change| [ change.id, change.version ] }).delete_all
+      end
+    end
+
+    def backfill(account, force: false)
+      return if !force && Storage::Total.for(account).backfilled_at?
+
+      Storage::Entry.where(account_id: account.id).in_batches(of: 500) do |entries|
+        invalidate(entries.pluck(:record_type, :record_id).map { |type, id| { account_id: account.id, record_type: type, record_id: id } })
+      end
+
+      RECORD_TYPES.each do |type, model|
+        model.where(account_id: account.id).in_batches(of: 500) do |records|
+          invalidate(records.pluck(:id).map { |id| { account_id: account.id, record_type: type, record_id: id } })
+        end
+      end
+
+      Storage::Total.for(account).update!(backfilled_at: Time.current)
+      Storage::UpdateJob.perform_later(account)
+    end
+
+    private
+      def invalidate(attributes)
+        attributes = attributes.map { |attributes| attributes.merge(id: ActiveRecord::Type::Uuid.generate) }
+        options = if connection.supports_insert_conflict_target?
+          { unique_by: [ :account_id, :record_type, :record_id ] }
+        else
+          {}
+        end
+        upsert_all(attributes, on_duplicate: Arel.sql("version = version + 1"), **options)
+      end
+  end
+end
