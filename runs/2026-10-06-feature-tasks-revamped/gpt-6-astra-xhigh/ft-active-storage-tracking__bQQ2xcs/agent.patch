+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    Current.user = users(:david)
+  end
+
+  test "account and board storage usage is calculated in the background" do
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+
+    @card.image.attach(blob(10))
+
+    assert_equal 0, @board.bytes_used
+    settle
+
+    assert_usage 10
+  end
+
+  test "counts card images and embeds in board descriptions card descriptions and comments" do
+    @card.image.attach(blob(10))
+    embed @board, :public_description, blob(20)
+    embed @card, :description, blob(30), blob(40)
+    embed @comment, :body, blob(50)
+    settle
+
+    assert_usage 150
+  end
+
+  test "accounts sum boards without crossing account boundaries" do
+    @card.image.attach(blob(10))
+    embed boards(:private), :public_description, blob(20)
+    Current.with_account(accounts(:initech)) do
+      cards(:radio).image.attach(blob(40))
+      settle accounts(:initech)
+    end
+    settle
+
+    assert_equal 10, @board.bytes_used
+    assert_equal 20, boards(:private).bytes_used
+    assert_equal 30, @account.bytes_used
+    assert_equal 40, accounts(:initech).bytes_used
+  end
+
+  test "counts references to shared blobs but excludes unattached blobs avatars exports and variants" do
+    shared = blob(10)
+    @card.image.attach(shared)
+    embed @card, :description, shared
+    blob(100)
+    ActiveStorage::Attachment.create!(record: users(:david), name: "avatar", blob: blob(200))
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach(blob(300))
+    variant = ActiveStorage::VariantRecord.create!(blob: shared, variation_digest: "test")
+    variant.image.attach(blob(400))
+    settle
+
+    assert_usage 20
+  end
+
+  test "replacing and removing rich text embeds updates totals" do
+    embed @card, :description, blob(10), blob(20)
+    settle
+    assert_usage 30
+
+    embed @card, :description, blob(40)
+    settle
+    assert_usage 40
+
+    @card.update!(description: "No more attachments")
+    settle
+    assert_usage 0
+  end
+
+  test "replacing card images updates totals" do
+    @card.image.attach(blob(10))
+    settle
+    @card.image.attach(blob(20))
+    settle
+    assert_usage 20
+  end
+
+  test "purging an attachment updates totals before the blob purge job runs" do
+    @card.image.attach(blob(10))
+    settle
+    @card.image.purge_later
+    settle
+    assert_usage 0
+  end
+
+  test "synchronous purge updates totals" do
+    @card.image.attach(blob(10))
+    settle
+    @card.image.purge
+    settle
+    assert_usage 0
+  end
+
+  test "detaching single and multiple attachments updates totals" do
+    @card.image.attach(blob(10))
+    embed @card, :description, blob(20), blob(30)
+    settle
+    assert_usage 60
+
+    @card.image.detach
+    @card.description.embeds.detach
+    settle
+    assert_usage 0
+  end
+
+  test "deleting a comment removes only its usage" do
+    @card.image.attach(blob(10))
+    embed @comment, :body, blob(20)
+    settle
+    @comment.destroy!
+    settle
+    assert_usage 10
+  end
+
+  test "deleting a card removes its image description and comments" do
+    @card.image.attach(blob(10))
+    embed @card, :description, blob(20)
+    embed @comment, :body, blob(30)
+    embed @board, :public_description, blob(40)
+    settle
+    @card.destroy!
+    settle
+    assert_usage 40
+  end
+
+  test "deleting a board removes its usage from the account" do
+    @card.image.attach(blob(10))
+    embed @comment, :body, blob(20)
+    embed @board, :public_description, blob(30)
+    embed boards(:private), :public_description, blob(40)
+    settle
+    @board.destroy!
+    settle
+
+    assert_equal 40, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+    assert_not Storage::Entry.exists?(board_id: @board.id)
+  end
+
+  test "moving a card transfers its image description and comments without changing account usage" do
+    @card.image.attach(blob(10))
+    embed @card, :description, blob(20)
+    embed @comment, :body, blob(30)
+    embed @board, :public_description, blob(40)
+    settle
+    @card.move_to(boards(:private))
+    settle
+
+    assert_equal 40, @board.bytes_used
+    assert_equal 60, boards(:private).bytes_used
+    assert_equal 100, @account.bytes_used
+  end
+
+  test "moves and removals before pending attachment changes are processed use current state" do
+    @card.image.attach(blob(10))
+    embed @comment, :body, blob(20)
+    @card.move_to(boards(:private))
+    @card.image.detach
+    settle
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 20, boards(:private).bytes_used
+    assert_equal 20, @account.bytes_used
+  end
+
+  test "duplicate invalidations and repeated jobs are idempotent" do
+    @card.image.attach(blob(10))
+    10.times { Storage::Change.record(@card) }
+    assert_equal 1, Storage::Change.where(account_id: @account.id).count
+    settle
+    2.times { Storage::UpdateJob.perform_now(@account) }
+    assert_usage 10
+  end
+
+  test "rolled back changes never update usage" do
+    @card.image.attach(blob(10))
+    settle
+    Card.transaction(requires_new: true) do
+      @card.image.detach
+      raise ActiveRecord::Rollback
+    end
+    assert_not Storage::Change.exists?(account_id: @account.id)
+    settle
+    assert_usage 10
+  end
+
+  test "a change during calculation is not acknowledged by the previous version" do
+    @card.image.attach(blob(10))
+    replacement = blob(20)
+    calculate = Storage::Entry.method(:bytes_for)
+    with_calculation(->(record) { calculate.call(record).tap { record.image.attach(replacement) } }) do
+      Storage::Total.for(@account).refresh
+    end
+    assert_usage 10
+    assert Storage::Change.exists?(account_id: @account.id)
+    settle
+    assert_usage 20
+    assert_not Storage::Change.exists?(account_id: @account.id)
+  end
+
+  test "a failed batch rolls back snapshots totals and acknowledgement" do
+    @card.image.attach(blob(10))
+    Storage::Change.stubs(:acknowledge).raises(RuntimeError)
+    assert_raises(RuntimeError) { Storage::Total.for(@account).refresh }
+    Storage::Change.unstub(:acknowledge)
+    assert_usage 0
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert Storage::Change.exists?(account_id: @account.id)
+    settle
+    assert_usage 10
+  end
+
+  test "backfills preexisting attachments and can be safely repeated" do
+    @card.image.attach(blob(10))
+    embed @comment, :body, blob(20)
+    Storage::Change.delete_all
+
+    2.times do
+      Storage::Change.backfill(@account, force: true)
+      settle
+      assert_usage 30
+    end
+    assert Storage::Total.for(@account).backfilled_at?
+  end
+
+  test "scheduler discovers existing accounts and pending changes" do
+    @card.image.attach(blob(10))
+    assert_enqueued_with job: Storage::BackfillJob, args: [ @account ] do
+      assert_enqueued_with job: Storage::UpdateJob, args: [ @account ] do
+        Storage::Change.process_later
+      end
+    end
+    perform_enqueued_jobs only: [ Storage::UpdateJob, Storage::BackfillJob ]
+    assert_usage 10
+  end
+
+  test "usage supports files larger than a 32 bit integer" do
+    large = blob(1)
+    large.update!(byte_size: 5.gigabytes)
+    @card.image.attach(large)
+    settle
+    assert_usage 5.gigabytes
+  end
+
+  test "batch processing is bounded and schedules the remainder" do
+    @card.image.attach(blob(10))
+    embed @comment, :body, blob(20)
+    stub_const Storage::Total, :BATCH_SIZE, 1 do
+      Storage::UpdateJob.perform_now(@account)
+      assert_equal 1, Storage::Change.where(account_id: @account.id).count
+      assert_enqueued_with job: Storage::UpdateJob, args: [ @account ]
+      settle
+    end
+    assert_usage 30
+  end
+
+  test "reading cached usage only queries totals and does not enqueue jobs" do
+    @card.image.attach(blob(10))
+    settle
+    queries = []
+    subscriber = ->(event) { queries << event.payload[:sql] }
+
+    assert_no_enqueued_jobs do
+      ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+        assert_usage 10
+      end
+    end
+
+    assert_equal 2, queries.size
+    assert queries.all? { |query| query.include?("storage_totals") }
+  end
+
+  test "many attachments coalesce into one invalidation and are summed without loading attachments" do
+    embed @card, :description, *50.times.map { blob(10) }
+    assert_equal 1, Storage::Change.where(account_id: @account.id).count
+
+    ActiveStorage::Attachment.expects(:instantiate).never
+    settle
+    assert_usage 500
+  end
+
+  test "draft card attachments count" do
+    @card.update!(status: :drafted)
+    @card.image.attach(blob(10))
+    settle
+    assert_usage 10
+  end
+
+  test "forced backfill reconciles records deleted without callbacks" do
+    @card.image.attach(blob(10))
+    settle
+    @card.delete
+    Storage::Change.backfill(@account, force: true)
+    settle
+    assert_usage 0
+  end
+
+  test "account destruction cleans up storage tracking and queued jobs tolerate missing accounts" do
+    @card.image.attach(blob(10))
+    settle
+    Storage::UpdateJob.perform_later(@account)
+    @account.destroy!
+    perform_enqueued_jobs only: Storage::UpdateJob
+
+    [ Storage::Change, Storage::Entry, Storage::Total ].each do |model|
+      assert_not model.exists?(account_id: @account.id)
+    end
+  end
+
+  private
+    def with_calculation(calculation)
+      original = Storage::Entry.method(:bytes_for)
+      Storage::Entry.define_singleton_method(:bytes_for, calculation)
+      yield
+    ensure
+      Storage::Entry.define_singleton_method(:bytes_for, original)
+    end
+
+    def blob(bytes)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * bytes), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(record, attribute, *blobs)
+      record.update!(attribute => blobs.map { |blob| %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>) }.join)
+    end
+
+    def settle(account = @account)
+      Current.with_account(account) { Storage::UpdateJob.perform_later(account) }
+      perform_enqueued_jobs only: Storage::UpdateJob
+    end
+
+    def assert_usage(bytes)
+      assert_equal bytes, @board.bytes_used
+      assert_equal bytes, @account.bytes_used
+    end
+end
