diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..a7d8300
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    freeze_time
+    @card = cards(:text)
+    @card.record_burst
+  end
+
+  test "stalled index only lists accessible stalled cards in HTML and JSON" do
+    cards(:radio).record_burst
+    travel 2.weeks
+
+    get cards_path(indexed_by: :stalled)
+    assert_response :success
+    assert_select "article.card", count: 1
+    assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    assert_select "[data-combobox-value=stalled]", text: /Stalled/
+
+    get cards_path(indexed_by: :stalled, format: :json)
+    assert_response :success
+    assert_equal [ @card.id ], response.parsed_body.pluck("id")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    @card.touch_last_active_at
+    get cards_path(indexed_by: :stalled, format: :json)
+    assert_equal [], response.parsed_body
+  end
+
+  test "stalled index respects board access and other filters" do
+    travel 2.weeks
+    get cards_path(indexed_by: :stalled, column_ids: [ columns(:writebook_triage).id ], format: :json)
+    assert_response :success
+    assert_equal [], response.parsed_body
+
+    @card.board.update! all_access: false
+    @card.board.accesses.revoke_from users(:kevin)
+    get cards_path(indexed_by: :stalled, format: :json)
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "stalled badge is shown on board previews and the card page without resetting activity" do
+    travel 2.weeks
+
+    [ board_column_path(@card.board, @card.column), card_path(@card) ].each do |path|
+      get path
+      assert_response :success
+      assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    end
+
+    assert @card.reload.stalled?
+  end
+
+  test "stalled badge is shown on public previews and cards" do
+    @card.board.publish
+    travel 2.weeks
+
+    [ public_board_column_path(@card.board.publication.key, @card.column), published_card_path(@card) ].each do |path|
+      get path
+      assert_response :success
+      assert_select "article.card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+
+  test "cached previews acquire and lose the stalled badge" do
+    with_actionview_partial_caching do
+      get cards_path
+      assert_select "article.card--stalled", count: 0
+
+      travel 2.weeks
+      get cards_path
+      assert_select "article.card--stalled .card__stalled", text: "Stalled"
+
+      @card.touch_last_active_at
+      get cards_path
+      assert_select "article.card--stalled", count: 0
+    end
+  end
+
+  test "cached card pages acquire and lose the stalled badge" do
+    with_fragment_caching do
+      get card_path(@card)
+      assert_select ".card__stalled", count: 0
+
+      travel 2.weeks
+      get card_path(@card)
+      assert_select ".card__stalled", text: "Stalled"
+
+      @card.touch_last_active_at
+      get card_path(@card)
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "column HTTP cache expires when a card becomes stalled" do
+    path = board_column_path(@card.board, @card.column)
+    get path
+    etag = response.headers["ETag"]
+    assert_select ".card__stalled", count: 0
+
+    travel 2.weeks
+    get path, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  test "board and stream HTTP caches expire when a card becomes stalled" do
+    @card.update! column: nil
+    paths = [ board_path(@card.board), board_columns_stream_path(@card.board) ]
+    etags = paths.map do |path|
+      get path
+      response.headers["ETag"]
+    end
+
+    travel 2.weeks
+    paths.zip(etags).each do |path, etag|
+      get path, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "cached timeline cards acquire and lose the stalled badge" do
+    Current.set(user: users(:kevin)) { @card.track_event :assigned, assignee_ids: [ users(:kevin).id ] }
+    day = Time.current.to_date
+
+    with_fragment_caching do
+      get events_path(day: day)
+      assert_select ".event .card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      travel 2.weeks
+      get events_path(day: day), headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".event .card__stalled", text: "Stalled"
+
+      @card.touch_last_active_at
+      get events_path(day: day)
+      assert_select ".event .card__stalled", count: 0
+    end
+  end
+
+  test "notification cards acquire and lose stalled status in cached HTML and JSON" do
+    card = cards(:logo)
+    card.record_burst
+
+    with_fragment_caching do
+      get tray_notifications_path
+      assert_select ".card--notification .card__stalled", count: 0
+      etag = response.headers["ETag"]
+
+      get tray_notifications_path(format: :json)
+      assert_equal false, response.parsed_body.find { it["card"]["id"] == card.id }["card"]["stalled"]
+
+      travel 2.weeks
+      get tray_notifications_path, headers: { "If-None-Match" => etag }
+      assert_response :success
+      assert_select ".card--notification.card--stalled .card__stalled", text: "Stalled"
+
+      get tray_notifications_path(format: :json)
+      assert_equal true, response.parsed_body.find { it["card"]["id"] == card.id }["card"]["stalled"]
+
+      card.touch_last_active_at
+      get tray_notifications_path
+      assert_select ".card--notification .card__stalled", count: 0
+    end
+  end
+
+  private
+    def with_fragment_caching
+      original_cache_store = ApplicationController.cache_store
+      ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+      with_actionview_partial_caching { yield }
+    ensure
+      ApplicationController.cache_store = original_cache_store
+    end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..9183fb3
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,202 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = cards(:text)
+  end
+
+  test "three comments from two people create a burst" do
+    comment_by :david
+    comment_by :david
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+    assert_not @card.stalled?
+
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a single commenter does not create a burst" do
+    4.times { comment_by :david }
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    comment_by :david
+    3.times { comment_by :system }
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comment burst window is a third of the board auto-close period" do
+    @card.board.update! auto_postpone_period: 3.days
+    comment_by :david
+    travel 1.day + 1.second
+    comment_by :david
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "the start of the comment window is inclusive" do
+    @card.board.update! auto_postpone_period: 3.days
+    comment_by :david
+    travel 1.day
+    comment_by :david
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comment window falls back to the account auto-close period" do
+    entropies(:writebook_board).destroy!
+    accounts("37s").entropy.update! auto_postpone_period: 90.days
+    @card.reload
+    comment_by :david
+    travel 29.days
+    comment_by :david
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comment windows retain partial days" do
+    @card.board.update! auto_postpone_period: 7.days
+    comment_by :david
+    travel 7.days / 3
+    comment_by :kevin
+    comment_by :kevin
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments on other cards and future comments do not contribute to a burst" do
+    cards(:buy_domain).comments.create! body: "Another card", creator: users(:david)
+    @card.comments.create! body: "Future comment", creator: users(:david), created_at: 1.day.from_now
+    comment_by :david
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assignment and reopening each create a burst" do
+    @card.toggle_assignment(users(:jz))
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    reopened = cards(:shipping)
+    reopened.reopen
+    assert_equal Time.current, reopened.reload.last_burst_at
+  end
+
+  test "unassignment and reopening an open card do not create bursts" do
+    @card.reopen
+    assert_nil @card.reload.last_burst_at
+
+    @card.assignments.create! assignee: users(:david), assigner: users(:david)
+    @card.update_column :last_burst_at, nil
+    @card.toggle_assignment(users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "old cards without a burst are not stalled" do
+    @card.update! last_active_at: 3.weeks.ago
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity restarts the inactivity clock" do
+    stall_card
+    comment_by :kevin
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+  end
+
+  test "edits and touches clear stalled status" do
+    stall_card
+    @card.update! description: "New information"
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+    @card.steps.create! content: "Follow up"
+    assert_not @card.reload.stalled?
+  end
+
+  test "editing and deleting comments clear stalled status without creating bursts" do
+    comment = comment_by :david
+    stall_card
+    last_burst_at = @card.last_burst_at
+    comment.update! body: "More information"
+    assert_not @card.reload.stalled?
+    assert_equal last_burst_at, @card.last_burst_at
+
+    travel 2.weeks
+    assert @card.stalled?
+    comment.destroy!
+    assert_not @card.reload.stalled?
+    assert_equal last_burst_at, @card.last_burst_at
+  end
+
+  test "changes to tags and steps clear stalled status" do
+    stall_card
+    @card.toggle_tag_with("important")
+    assert_not @card.reload.stalled?
+
+    step = @card.steps.create! content: "Next step"
+    travel 2.weeks
+    assert @card.stalled?
+    step.update! completed: true
+    assert_not @card.reload.stalled?
+  end
+
+  test "reactions and card events clear stalled status" do
+    stall_card
+    @card.reactions.create! content: "👍", reacter: users(:kevin)
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    @card.update! title: "A new title"
+    assert_not @card.reload.stalled?
+  end
+
+  test "only active cards can be stalled" do
+    stall_card
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create! body: "A comment", creator: users(user)
+    end
+
+    def stall_card
+      @card.toggle_assignment(users(:jz))
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+end
