diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..40da26c
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,38 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+
+    # Associated records (comments, steps, tags, attachments, etc.) touch the card too.
+    after_touch :touch_last_active_at, if: :last_burst_at?
+    before_update :restart_stall_clock, if: :last_burst_at?
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  # Becoming stalled does not write to the card, but must invalidate cached displays.
+  def cache_key
+    "#{super}/stalled-#{stalled?}"
+  end
+
+  def record_burst
+    update! last_burst_at: Time.current, last_active_at: Time.current
+  end
+
+  def detect_comment_burst
+    recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3)..Time.current)
+    counts_by_creator = recent_comments.group(:creator_id).count
+
+    record_burst if counts_by_creator.size >= 2 && counts_by_creator.values.sum >= 3
+  end
+
+  private
+    def restart_stall_clock
+      self.last_active_at = Time.current unless last_active_at_changed?
+    end
+end
