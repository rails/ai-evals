+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "blank queries return no cards" do
+    [ nil, "", " \t\n " ].each do |query|
+      assert_empty Card.search(query)
+    end
+  end
+
+  test "each word can match a different field or comment" do
+    card = cards(:logo)
+    card.update!(title: "Scarlet", description: "<p>emerald</p>")
+    card.comments.create!(body: "cobalt", creator: users(:kevin))
+    card.comments.create!(body: "indigo", creator: users(:kevin))
+
+    assert_equal [ card ], Card.search("  SCARLET emerald\tcobalt indigo scarlet ")
+    assert_empty Card.search("scarlet missingneedle")
+  end
+
+  test "rich text matches visible words and decoded entities, not HTML attributes" do
+    card = cards(:logo)
+    card.update!(description: '<p>A <strong>butter</strong>fly &amp; R&amp;D <a href="https://markupneedle.example">link</a></p>')
+
+    assert_equal [ card ], Card.search("butterfly")
+    assert_equal [ card ], Card.search("R&D")
+    assert_empty Card.search("markupneedle")
+    assert_empty Card.search("strong")
+  end
+
+  test "query punctuation and SQL wildcards are literal" do
+    card = cards(:logo)
+    card.update!(description: '100% a_b c!d C:\notes [bracket] "quoted"')
+
+    [ "100%", "a_b", "c!d", 'C:\notes', "[bracket]", '"quoted"' ].each do |query|
+      assert_equal [ card ], Card.search(query), "Expected a literal match for #{query.inspect}"
+    end
+    assert_empty Card.search("' OR 1=1 --")
+  end
+
+  test "title wildcard matches do not broaden the query" do
+    cards(:logo).update_column(:title, "100% a_b c!d")
+    cards(:layout).update_column(:title, "1000 axb cid")
+
+    [ "%", "_", "!" ].each do |query|
+      assert_equal [ cards(:logo) ], Card.search(query)
+    end
+  end
+
+  test "description changes and removals are reflected immediately" do
+    card = cards(:logo)
+    card.update!(description: "oldneedle")
+    assert_equal [ card ], Card.search("oldneedle")
+
+    card.update!(description: "newneedle")
+    assert_empty Card.search("oldneedle")
+    assert_equal [ card ], Card.search("newneedle")
+
+    card.update!(description: "")
+    assert_empty Card.search("newneedle")
+  end
+
+  test "comment creation, editing, and deletion are reflected immediately" do
+    card = cards(:logo)
+    comment = card.comments.create!(body: "oldneedle", creator: users(:kevin))
+    assert_equal [ card ], Card.search("oldneedle")
+
+    comment.update!(body: "newneedle")
+    assert_empty Card.search("oldneedle")
+    assert_equal [ card ], Card.search("newneedle")
+
+    comment.destroy!
+    assert_empty Card.search("newneedle")
+  end
+
+  test "draft titles, descriptions, and existing comments are excluded until published" do
+    card = cards(:logo)
+    card.update!(title: "titleneedle", description: "descriptionneedle")
+    card.comments.create!(body: "commentneedle", creator: users(:kevin))
+    card.drafted!
+
+    [ "titleneedle", "descriptionneedle", "commentneedle" ].each do |query|
+      assert_empty Card.search(query)
+    end
+
+    card.publish
+    [ "titleneedle", "descriptionneedle", "commentneedle" ].each do |query|
+      assert_equal [ card ], Card.search(query)
+    end
+  end
+
+  test "multiple comment and field matches return a single card" do
+    card = cards(:logo)
+    card.update!(title: "uniqueneedle", description: "uniqueneedle")
+    2.times { card.comments.create!(body: "uniqueneedle", creator: users(:kevin)) }
+
+    assert_equal [ card ], Card.search("uniqueneedle")
+  end
+
+  test "newest cards come first with a stable order for equal creation times" do
+    [ cards(:logo), cards(:layout), cards(:text) ].each do |card|
+      card.update!(description: "orderneedle", created_at: 2.days.ago.beginning_of_day)
+    end
+    cards(:text).update!(created_at: 1.day.ago)
+    cards(:layout).update!(last_active_at: 1.minute.from_now)
+
+    assert_equal [ cards(:text), *[ cards(:logo), cards(:layout) ].sort_by(&:id).reverse ], Card.search("orderneedle")
+  end
+
+  test "search preserves the caller's access scope" do
+    card = cards(:logo)
+    card.update!(description: "accessneedle")
+    card.update!(board: boards(:private))
+
+    assert_equal [ card ], users(:kevin).accessible_cards.search("accessneedle")
+    assert_empty users(:david).accessible_cards.search("accessneedle")
+
+    accesses(:private_kevin).destroy!
+    assert_empty users(:kevin).accessible_cards.search("accessneedle")
+  end
+
+  test "existing comment fixtures are searchable" do
+    assert_equal [ cards(:layout) ], Card.search("overflowing")
+  end
+end
