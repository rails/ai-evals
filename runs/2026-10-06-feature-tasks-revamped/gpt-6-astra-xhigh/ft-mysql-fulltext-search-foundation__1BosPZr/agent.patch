diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..298a5ff
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights every matching word case insensitively" do
+    assert_equal "<mark>RED</mark> and <mark>blue</mark> and <mark>red</mark>", highlight_search_matches("RED and blue and red", "red blue")
+  end
+
+  test "escapes text and query without losing encoded matches" do
+    assert_equal "&lt;script&gt;<mark>R&amp;D</mark>&lt;/script&gt;", highlight_search_matches("<script>R&D</script>", "R&D")
+    assert_equal "<mark>&lt;script&gt;</mark>bad&lt;/script&gt;", highlight_search_matches("<script>bad</script>", "<script>")
+  end
+
+  test "treats regular expression metacharacters literally" do
+    assert_equal "<mark>[.*]</mark> safe", highlight_search_matches("[.*] safe", "[.*]")
+  end
+
+  test "prefers the longest overlapping match" do
+    assert_equal "<mark>searching</mark>", highlight_search_matches("searching", "search searching")
+  end
+
+  test "blank queries escape text without highlighting" do
+    assert_equal "&lt;b&gt;safe&lt;/b&gt;", highlight_search_matches("<b>safe</b>", " ")
+  end
+
+  test "excerpts include matches even at the end of a long body" do
+    result = search_excerpt("filler " * 1_000 + "endneedle", "endneedle")
+
+    assert_includes result, "<mark>endneedle</mark>"
+    assert_operator result.length, :<, 350
+  end
+end
