+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query)
+      .preload(:board, :rich_text_description)
+
+    @matching_comments = Comment.where(card_id: @page.records.map(&:id)).joins(:rich_text_body)
+      .merge(ActionText::RichText.containing(@query.split)).with_rich_text_body
+      .group_by(&:card_id)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..db3bc6c
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def highlight_search_matches(text, query)
+    if query.present?
+      parts = text.to_s.split(/(#{search_pattern(query)})/i)
+      safe_join(parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part })
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_excerpt(text, query)
+    text = text.to_s.squish
+    snippet = excerpt(text, search_pattern(query), radius: 140) || truncate(text, length: 280)
+    highlight_search_matches(snippet, query)
+  end
+
+  private
+    def search_pattern(query)
+      Regexp.new(Regexp.union(query.split.sort_by { -it.length }).source, Regexp::IGNORECASE)
+    end
+end
