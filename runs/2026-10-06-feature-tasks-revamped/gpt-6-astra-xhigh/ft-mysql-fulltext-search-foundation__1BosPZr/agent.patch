diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..b4c6cbc
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "search finds titles, descriptions, and comments newest first with highlights" do
+    cards(:logo).update!(title: "A SEARCHNEEDLE in the title", created_at: 3.days.ago)
+    cards(:layout).update!(description: "<p>A <strong>searchneedle</strong> in the description</p>", created_at: 2.days.ago)
+    cards(:text).update!(created_at: 1.day.ago)
+    comments(:text_1).update!(body: "A SearchNeedle in a comment")
+    cards(:text).comments.create!(body: "Another searchneedle", creator: users(:kevin))
+
+    get "#{accounts(:"37s").slug}/search", params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_select ".search-result h2 a" do |links|
+      assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { card_path(it) }, links.map { it["href"] }
+    end
+    assert_select ".search-result mark", text: "SEARCHNEEDLE"
+    assert_select ".search-result mark", text: "searchneedle"
+    assert_select ".search-result mark", text: "SearchNeedle"
+  end
+  test "blank and missing queries show the form without results" do
+    [ nil, "", "  " ].each do |query|
+      get search_path, params: { q: query }
+
+      assert_response :success
+      assert_select "form[action=?][method=get] input[name=q][type=search]", search_path
+      assert_select ".search-result", count: 0
+      assert_select "mark", count: 0
+    end
+  end
+
+  test "no matches and HTML in queries are rendered safely" do
+    get search_path, params: { q: '<script>alert("xss")</script>' }
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select "main script", count: 0
+    assert_select "p", text: /No cards found/
+  end
+
+  test "only currently accessible boards appear, even for admins" do
+    cards(:logo).update!(description: "accessneedle")
+    cards(:layout).update!(board: boards(:private), description: "accessneedle")
+    cards(:radio).update!(description: "accessneedle")
+
+    get search_path, params: { q: "accessneedle" }
+    assert_result_cards cards(:logo), cards(:layout)
+
+    accesses(:private_kevin).destroy!
+    get search_path, params: { q: "accessneedle" }
+    assert_result_cards cards(:logo)
+  end
+
+  test "moving a matching card to an inaccessible board removes it from results" do
+    cards(:logo).update!(description: "moveneedle")
+    cards(:logo).assignees.clear
+    accesses(:private_kevin).destroy!
+
+    get search_path, params: { q: "moveneedle" }
+    assert_result_cards cards(:logo)
+
+    with_current_user(users(:kevin)) { cards(:logo).move_to(boards(:private)) }
+    get search_path, params: { q: "moveneedle" }
+    assert_result_cards
+  end
+
+  test "drafts and their comments never appear" do
+    cards(:logo).update!(title: "draftneedle", description: "draftneedle")
+    comments(:logo_agreement_kevin).update!(body: "commentneedle")
+    cards(:logo).drafted!
+
+    [ "draftneedle", "commentneedle" ].each do |query|
+      get search_path, params: { q: query }
+      assert_result_cards
+      assert_select "mark", count: 0
+    end
+  end
+
+  test "highlighting cannot inject markup from titles or rich text" do
+    cards(:logo).update_column(:title, "<img src=x onerror=alert(1)> safeneedle")
+    cards(:logo).update!(description: "<p>&lt;script&gt;safeneedle&lt;/script&gt;</p>")
+
+    get search_path, params: { q: "safeneedle" }
+    assert_result_cards cards(:logo)
+    assert_select ".search-result img, .search-result script", count: 0
+    assert_select ".search-result mark", text: "safeneedle", count: 2
+    assert_select ".search-result h2", text: /<img src=x onerror=alert\(1\)>/
+  end
+
+  test "comment-only results link to the matching comment" do
+    comment = comments(:layout_overflowing_david)
+
+    get search_path, params: { q: "overflowing" }
+
+    assert_result_cards cards(:layout)
+    assert_select ".search-result a[href=?]", card_path(comment.card, anchor: dom_id(comment))
+    assert_select ".search-result mark", text: "overflowing"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+
+    assert_response :redirect
+    assert_select ".search-result", count: 0
+  end
+
+  test "pagination keeps the query and newest-first order" do
+    found = 20.times.map do |index|
+      boards(:writebook).cards.create!(title: "pagingneedle #{index}", status: "published", created_at: index.minutes.ago)
+    end
+
+    get search_path, params: { q: "pagingneedle" }
+    assert_response :success
+    assert_equal found.first(15).map { card_path(it) }, css_select(".search-result h2 a").map { it["href"] }
+
+    next_page = css_select("a.pagination-link").first
+    assert next_page, "Expected a link to the next page"
+    assert_equal "pagingneedle", Rack::Utils.parse_query(URI.parse(next_page["href"]).query)["q"]
+
+    get next_page["href"], headers: { "Turbo-Frame" => next_page["data-frame"] }
+    assert_response :success
+    assert_select "turbo-frame[id=?]", next_page["data-frame"]
+    assert_equal found.drop(15).map { card_path(it) }, css_select(".search-result h2 a").map { it["href"] }
+  end
+
+  test "an identity with multiple accounts searches only the current account" do
+    users(:mike).update!(identity: identities(:kevin))
+    cards(:radio).update!(description: "tenantneedle")
+    cards(:logo).update!(description: "tenantneedle")
+
+    get search_path, params: { q: "tenantneedle" }
+    assert_result_cards cards(:logo)
+
+    get search_path(script_name: accounts(:initech).slug), params: { q: "tenantneedle" }
+    assert_response :success
+    assert_select ".search-result h2 a", count: 1, text: cards(:radio).title
+  end
+
+  test "comment-only matches cannot reveal inaccessible boards or other accounts" do
+    cards(:layout).update!(board: boards(:private))
+    comments(:layout_overflowing_david).update!(body: "hiddencommentneedle")
+    cards(:radio).comments.create!(body: "hiddencommentneedle", creator: users(:mike))
+    accesses(:private_kevin).destroy!
+
+    get search_path, params: { q: "hiddencommentneedle" }
+
+    assert_result_cards
+    assert_select ".search-result__comment", count: 0
+  end
+
+  test "the navigation menu links to search" do
+    get my_menu_path
+
+    assert_response :success
+    assert_select "a[href=?]", search_path, text: "Search cards"
+  end
+
+  private
+    def assert_result_cards(*cards)
+      assert_response :success
+      links = css_select(".search-result h2 a")
+      assert_equal cards.map { card_path(it) }.sort, links.map { it["href"] }.sort
+    end
+end
