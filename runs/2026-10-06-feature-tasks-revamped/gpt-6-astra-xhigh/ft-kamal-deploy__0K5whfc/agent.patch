@@ -0,0 +1,58 @@
+# Single-server deployment. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: your-dockerhub-user/fizzy
+
+servers:
+  web:
+    - &hostname fizzy.example.com
+
+# Kamal Proxy terminates HTTPS and forwards HTTP to Thruster in the app container.
+proxy:
+  ssl: true
+  host: *hostname
+  app_port: 80
+
+registry:
+  username: your-dockerhub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+# All SQLite databases and uploaded files live here. Keep this volume across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    SAAS: "false"
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # A modest starting point for a single box. Increase these for larger servers.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    APP_FQDN: *hostname
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Uncomment these and set both secrets to enable browser push notifications.
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbconsole: app exec --interactive --reuse "bin/rails dbconsole"
