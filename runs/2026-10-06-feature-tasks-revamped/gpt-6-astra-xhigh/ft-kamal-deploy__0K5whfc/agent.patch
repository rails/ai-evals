+# Copy to .kamal/secrets (gitignored). Do not commit real secrets.
+# Values can also reference exported variables, e.g. SMTP_PASSWORD=$SMTP_PASSWORD.
+KAMAL_REGISTRY_PASSWORD=replace-with-your-docker-hub-access-token
+
+# Generate once with bin/rails secret. Keep the same value across deployments.
+SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret
+SMTP_USERNAME=replace-with-your-smtp-username
+SMTP_PASSWORD=replace-with-your-smtp-password
+
+# Optional browser push notifications; see docs/deployment.md.
+# VAPID_PUBLIC_KEY=
+# VAPID_PRIVATE_KEY=
