diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..9ac00f9
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,26 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_current_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&block)
+      # Resume before selecting the locale, including on public and login pages.
+      resume_session
+      requested_locale = params[:locale]
+      if requested_locale.is_a?(String) && I18n.available_locales.map(&:to_s).include?(requested_locale)
+        session[:locale] = requested_locale
+        Current.identity&.update!(locale: requested_locale)
+      end
+
+      locale = session[:locale] || Current.identity&.locale || I18n.default_locale
+      I18n.with_locale(locale) do
+        response.set_header("Content-Language", I18n.locale.to_s)
+        block.call
+      end
+    end
+end
