diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..1eac939
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,12 @@
+// Read from the current head, not module state: Turbo can replace the locale.
+export function locale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key, values = {}) {
+  const messages = JSON.parse(document.querySelector('meta[name="i18n"]')?.content || "{}")
+  let message = messages[key]
+  if (typeof message === "object") message = message[values.count === 1 ? "one" : "other"] || message.other
+  if (typeof message !== "string") throw new Error(`Missing translation: ${key}`)
+  return message.replace(/%\{(\w+)\}/g, (_, name) => String(values[name]))
+}
