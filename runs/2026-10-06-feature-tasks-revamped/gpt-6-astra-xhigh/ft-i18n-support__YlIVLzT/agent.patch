diff --git a/app/javascript/initializers/locale.js b/app/javascript/initializers/locale.js
new file mode 100644
index 0000000..9f9b73a
--- /dev/null
+++ b/app/javascript/initializers/locale.js
@@ -0,0 +1,25 @@
+import { Turbo } from "@hotwired/turbo-rails"
+
+function rememberLocale() {
+  const locale = document.documentElement.lang
+  const previous = sessionStorage.getItem("locale")
+
+  if (previous && previous !== locale) {
+    Turbo.cache.clear()
+    Turbo.offline?.clearCache()
+    sessionStorage.removeItem("referrerUrl")
+    sessionStorage.removeItem("referrerLabel")
+  }
+
+  sessionStorage.setItem("locale", locale)
+}
+
+// A locale change forces a full load via the tracked locale meta tag. Clear
+// persisted offline pages as well as Turbo snapshots from the previous language.
+rememberLocale()
+document.addEventListener("turbo:load", rememberLocale)
+window.addEventListener("pageshow", (event) => {
+  if (event.persisted && sessionStorage.getItem("locale") !== document.documentElement.lang) {
+    window.location.reload()
+  }
+})
