diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..37c6a4a
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "English is unchanged unless a supported locale is chosen" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en]"
+      assert_select "button", text: /Let’s go/
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=en]"
+      get new_session_path(locale: "ja")
+      assert_select "html[lang=ja]"
+      assert_select "button", text: /始めましょう/
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+      get new_session_path(locale: [ "ja" ])
+      assert_select "html[lang=ja]"
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "an anonymous choice survives authentication and a clean browser" do
+    untenanted { get new_session_path(locale: "ja") }
+    sign_in_as :david
+    assert_equal "ja", identities(:david).reload.locale
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_no_match /translation missing/i, response.body
+
+    reset!
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang=ja]"
+    get root_path(locale: "xx")
+    assert_equal "ja", identities(:david).reload.locale
+    get root_path(locale: "en")
+    assert_equal "en", identities(:david).reload.locale
+    assert_select "html[lang=en]"
+    assert_equal :en, I18n.locale
+  end
+
+  test "signed in choices are persisted on the identity" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:david).reload.locale
+    assert_select "html[lang=ja]"
+  end
+
+  test "collection caches and etags distinguish locales" do
+    sign_in_as :david
+    with_actionview_partial_caching do
+      get cards_previews_path(format: :turbo_stream, locale: "en")
+      english = response.body
+      assert_includes english, "added by"
+      get cards_previews_path(format: :turbo_stream, locale: "ja")
+      assert_response :success
+      assert_includes response.body, "が作成"
+      refute_includes response.body, "added by"
+      get cards_previews_path(format: :turbo_stream, locale: "en")
+      assert_equal english, response.body
+    end
+
+    get board_path(boards(:writebook), locale: "en")
+    etag = response.headers["ETag"]
+    get board_path(boards(:writebook), locale: "ja"), headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_equal "ja", response.headers["Content-Language"]
+    assert_not_equal etag, response.headers["ETag"]
+  end
+
+  test "screens and accessibility labels render Japanese without missing messages" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    [ board_path(boards(:writebook)), card_path(cards(:logo)), edit_user_path(users(:david)),
+      notifications_path, notifications_settings_path, my_passkeys_path, new_my_access_token_path,
+      account_settings_path, my_menu_path ].each do |path|
+      get path
+      assert_response :success
+      refute_match /translation[ _]missing/i, response.body, path
+    end
+  end
+end
diff --git a/test/localization/catalog_test.rb b/test/localization/catalog_test.rb
new file mode 100644
index 0000000..d933c7c
--- /dev/null
+++ b/test/localization/catalog_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class LocalizationCatalogTest < ActiveSupport::TestCase
+  test "every application message has a Japanese translation with the same placeholders" do
+    english = YAML.load_file(Rails.root.join("config/locales/en.yml")).fetch("en")
+    japanese = YAML.load_file(Rails.root.join("config/locales/ja.yml")).fetch("ja")
+    compare_catalogs(english, japanese)
+  end
+
+  test "Japanese dates, durations, counts and validations do not fall back to English" do
+    I18n.with_locale(:ja) do
+      assert_equal "1人", I18n.t("counts.people", count: 1)
+      assert_equal "0人", I18n.t("counts.people", count: 0)
+      assert_equal "2人", I18n.t("counts.people", count: 2)
+      assert_equal "2026年1月2日", I18n.l(Time.zone.local(2026, 1, 2), format: :card_stamp)
+      assert_equal "約1時間", I18n.t("datetime.distance_in_words.about_x_hours", count: 1)
+      identity = Identity.new(email_address: "invalid")
+      assert_not identity.valid?
+      assert_equal [ "メールアドレスは不正な値です" ], identity.errors.full_messages
+      assert_equal "青", Color::COLORS.first.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+    end
+  end
+
+  test "all static errors include both languages and language markers" do
+    Dir[Rails.root.join("public/{400,404,406-unsupported-browser,422,500}.html")].each do |path|
+      html = Nokogiri::HTML5(File.read(path))
+      assert html.at_css('[lang="ja"]'), path
+      assert html.at_css('[lang="en"]'), path
+      assert_match /[ぁ-んァ-ン一-龯]/, html.at_css("title").text, path
+      assert_includes html.text, "Back home"
+    end
+  end
+
+  private
+    def compare_catalogs(english, japanese, path = [])
+      english.each do |key, value|
+        current = path + [ key ]
+        assert japanese.key?(key), "Missing #{current.join('.')}" unless key == "one"
+        translated = japanese[key] || japanese["other"]
+        if value.is_a?(Hash)
+          compare_catalogs(value, translated, current)
+        else
+          assert_equal value.scan(/%\{\w+\}/).sort, translated.scan(/%\{\w+\}/).sort, current.join(".")
+        end
+      end
+    end
+end
