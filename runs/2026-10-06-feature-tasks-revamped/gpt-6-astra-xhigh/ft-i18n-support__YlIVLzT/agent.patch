@@ -0,0 +1,51 @@
+require "test_helper"
+
+class LocalizedSystemCommentsTest < ActiveSupport::TestCase
+  test "system comments render for the reader and retain the original English body" do
+    card = cards(:logo)
+    event = nil
+    with_current_user(:david) do
+      event = card.track_event(:postponed)
+    end
+    comment = card.comments.by_system.order(created_at: :desc).first
+    assert_equal event, comment.source_event
+    english = comment.body.to_plain_text
+    I18n.with_locale(:ja) do
+      assert_includes comment.localized_body.to_plain_text, "今はしない"
+      refute_includes comment.localized_body.to_plain_text, "Not Now"
+    end
+    assert_equal english, comment.localized_body.to_plain_text
+    assert_equal english, comment.reload.body.to_plain_text
+
+    comment.update_column(:source_event_id, nil)
+    I18n.with_locale(:ja) do
+      assert_includes comment.reload.localized_body.to_plain_text, "今はしない"
+    end
+  end
+
+  test "user content is never translated" do
+    comment = comments(:logo_agreement_jz)
+    original = comment.body.to_plain_text
+    I18n.with_locale(:ja) { assert_equal original, comment.localized_body.to_plain_text }
+  end
+
+  test "notification broadcasts and pushes use the recipient rather than the actor locale" do
+    users(:david).identity.update!(locale: "ja")
+    users(:david).notifications.destroy_all
+    clear_enqueued_jobs
+    notification = nil
+    I18n.with_locale(:en) do
+      notification = Notification.create!(user: users(:david), creator: users(:jz), source: events(:logo_published))
+      broadcast = enqueued_jobs.find { |job| job[:job] == Turbo::Streams::ActionBroadcastJob }
+      assert_equal "ja", broadcast.fetch("locale")
+      target = Class.new do
+        def self.process(notification)
+          raise "Wrong locale" unless I18n.locale == :ja
+        end
+      end
+      Notification.stubs(:push_targets).returns([ target ])
+      notification.push
+      assert_equal :en, I18n.locale
+    end
+  end
+end
