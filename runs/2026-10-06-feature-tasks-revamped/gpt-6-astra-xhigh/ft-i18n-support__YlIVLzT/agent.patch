diff --git a/app/mailers/application_mailer.rb b/app/mailers/application_mailer.rb
index 9f0d723..1042291 100644
--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -5,7 +5,28 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  # Wrap the action as well as rendering: subjects must use the recipient's
+  # preference, never the actor's locale captured by deliver_later.
+  def process(action, *args, **kwargs)
+    locale = params[:locale] || recipient_identity(args.first || kwargs)&.locale || I18n.default_locale
+    I18n.with_locale(locale) { super(action, *args, **kwargs) }
+  end
+
   private
+    def recipient_identity(recipient)
+      if recipient.is_a?(Identity)
+        recipient
+      elsif recipient.is_a?(Hash)
+        recipient[:user]&.identity
+      elsif recipient.respond_to?(:identity)
+        recipient.identity
+      elsif recipient.respond_to?(:initiated_by)
+        recipient.initiated_by.identity
+      elsif recipient.respond_to?(:user)
+        recipient.user.identity
+      end
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
