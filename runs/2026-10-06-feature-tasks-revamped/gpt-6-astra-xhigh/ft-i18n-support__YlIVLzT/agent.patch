@@ -0,0 +1,50 @@
+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  driven_by :selenium, using: :headless_chrome do |options|
+    options.add_argument("--no-sandbox") if Process.uid.zero?
+  end
+
+  test "client-side messages and dates follow the page locale, not the browser language" do
+    visit new_session_url(script_name: nil, locale: "ja")
+    assert_selector "html[lang=ja]"
+    assert_text "始めましょう"
+
+    page.execute_script <<~JS
+      for (const style of ["date", "ago", "daysago", "indays"]) {
+        const time = document.createElement("time")
+        time.id = `test-${style}`
+        time.dataset.localTimeTarget = style
+        time.setAttribute("datetime", Math.floor(Date.now() / 1000))
+        document.body.append(time)
+      }
+    JS
+    assert_selector "#test-date", text: /\d+年\d+月\d+日/
+    assert_selector "#test-ago", text: "1分未満前"
+    assert_selector "#test-daysago", text: "今日"
+    assert_selector "#test-indays", text: "今日"
+
+    messages = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      import("helpers/i18n").then(({ translate }) => done([
+        translate("back", { label: "ホーム" }),
+        translate("ago_day", { count: 1 }),
+        translate("ago_day", { count: 2 }),
+        translate("required")
+      ]))
+    JS
+    assert_equal [ "ホームに戻る", "1日前", "2日前", "この項目を入力してください" ], messages
+
+    visit new_session_url(script_name: nil, locale: "en")
+    assert_text "Let’s go"
+    messages = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      import("helpers/i18n").then(({ translate }) => done([
+        translate("ago_day", { count: 1 }),
+        translate("ago_day", { count: 2 }),
+        translate("less_than_a_minute")
+      ]))
+    JS
+    assert_equal [ "1 day ago", "2 days ago", "Less than a minute ago" ], messages
+  end
+end
