--- /dev/null
+++ b/test/localization/templates_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class LocalizedTemplatesTest < ActiveSupport::TestCase
+  test "templates contain no untranslated readable text or accessibility attributes" do
+    templates = Dir[Rails.root.join("{app,saas/app}/views/**/*.html.erb")]
+    # These helpers produce script/style elements rather than readable content.
+    code_partials = %w[ _theme_preference.html.erb _user_css.html.erb ]
+    templates.reject { |path| File.basename(path).in?(code_partials) }.each do |path|
+      html = File.read(path).gsub(/<%.*?%>/m, "")
+      document = Nokogiri::HTML5.fragment(html)
+      document.css("script, style").remove
+      readable = document.xpath(".//text() | .//@title | .//@alt | .//@placeholder | .//@aria-label | .//@aria-description | .//@data-text")
+      readable.each do |node|
+        text = node.text.strip
+        # Product names and URL examples are language-independent.
+        next if text.in?(%w[ Fizzy 37signals ]) || text.match?(%r{\Ahttps?://\S+\z})
+        refute_match(/[A-Za-z]{2,}/, text, "Untranslated text in #{path}: #{text.inspect}")
+      end
+    end
+  end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..9684ae4
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.identity.update!(locale: "ja")
+  end
+
+  test "magic link subject and both bodies use recipient language, even from an English job" do
+    magic_link = @user.identity.magic_links.create!
+    I18n.with_locale(:en) do
+      mail = MagicLinkMailer.sign_in_instructions(magic_link)
+      assert_equal "Fizzyの認証コードは#{magic_link.code}です", mail.subject
+      assert_includes mail.html_part.body.decoded, "認証コード"
+      assert_includes mail.text_part.body.decoded, "認証コード"
+      assert_includes mail.text_part.body.decoded, "15分"
+      refute_match /translation missing|Please enter/, mail.body.to_s
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "notification subject, counts, descriptions and dates are localized" do
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    notification = Notification.create!(user: @user, creator: users(:jz), source: events(:logo_published))
+    mail = Notification::BundleMailer.notification(bundle)
+    assert_match /新しい通知/, mail.subject
+    [ mail.html_part, mail.text_part ].each do |part|
+      assert_includes part.body.decoded, "新しい通知1件"
+      assert_match /\d+年\d+月\d+日/, part.body.decoded
+      refute_match /translation missing|Notifications since|Added by/, part.body.decoded
+    end
+  end
+
+  test "keyword-argument mailers also use the recipient preference" do
+    mail = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user)
+    assert_equal "新しいメールアドレスを確認", mail.subject
+    assert_match /メールアドレス/, mail.html_part&.body&.decoded || mail.body.decoded
+  end
+
+  test "English recipients do not inherit the actor locale" do
+    @user.identity.update!(locale: nil)
+    magic_link = @user.identity.magic_links.create!
+    I18n.with_locale(:ja) do
+      mail = MagicLinkMailer.sign_in_instructions(magic_link)
+      assert_equal "Your Fizzy code is #{magic_link.code}", mail.subject
+      assert_includes mail.text_part.body.decoded, "Please enter"
+      assert_equal :ja, I18n.locale
+    end
+  end
+
+  test "an anonymous language choice can localize the sign-in mail without modifying the identity" do
+    @user.identity.update!(locale: nil)
+    magic_link = @user.identity.magic_links.create!
+    mail = MagicLinkMailer.with(locale: "ja").sign_in_instructions(magic_link)
+    assert_match /認証コード/, mail.subject
+    assert_nil @user.identity.reload.locale
+  end
+
+  test "exports, imports and account cancellation emails use the recipient preference" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    user_export = User::DataExport.create!(account: Current.account, user: @user)
+    import = Account::Import.create!(identity: @user.identity, account: Current.account)
+    cancellation = Account::Cancellation.new(account: Current.account, initiated_by: @user)
+
+    messages = [ ExportMailer.completed(export), ExportMailer.completed(user_export),
+      ImportMailer.completed(@user.identity, Current.account), ImportMailer.failed(import),
+      AccountMailer.cancellation(cancellation) ]
+    messages.each do |message|
+      assert_match /[ぁ-んァ-ン一-龯]/, message.subject
+      [ message.html_part, message.text_part ].each do |part|
+        assert_match /[ぁ-んァ-ン一-龯]/, part.body.decoded
+        refute_match /translation[ _]missing|Need help|Your Fizzy|Unfortunately|What happens/i, part.body.decoded
+      end
+    end
+  end
+
+  test "queued delivery uses the recipient locale at delivery time" do
+    @user.identity.update!(locale: nil)
+    magic_link = @user.identity.magic_links.create!
+    MagicLinkMailer.sign_in_instructions(magic_link).deliver_later
+    @user.identity.update!(locale: "ja")
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+    assert_match /認証コード/, ActionMailer::Base.deliveries.last.subject
+    assert_equal :en, I18n.locale
+  end
+end
