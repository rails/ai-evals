--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,28 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured?
+      # Capture the text now: another event may update this tray item before delivery.
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription, payload)
+      end
+    end
+  end
+
+  private
+    def push_payload
+      {
+        title: ApplicationController.helpers.notification_title(self),
+        body: ApplicationController.helpers.notification_body(self),
+        icon: "/app-icon-192.png",
+        tag: "notification_#{id}",
+        data: { url: Rails.application.routes.url_helpers.polymorphic_path(self, script_name: account.slug, only_path: true) }
+      }
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..e162975
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,38 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  before_validation :set_endpoint_digest
+
+  def self.configured?
+    Rails.configuration.x.web_push.values_at(:public_key, :private_key).all?(&:present?)
+  end
+
+  def deliver(payload)
+    if self.class.configured? && user.active? && account.active?
+      Delivery.new(
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        message: payload.to_json, vapid: Rails.configuration.x.web_push
+      ).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+end
diff --git a/app/models/push_subscription/delivery.rb b/app/models/push_subscription/delivery.rb
new file mode 100644
index 0000000..b38a876
--- /dev/null
+++ b/app/models/push_subscription/delivery.rb
@@ -0,0 +1,20 @@
+# Use WebPush's encryption and VAPID signing, but pin the connection to a public
+# IP, just like webhooks. Subscription endpoints are supplied by the client.
+class PushSubscription::Delivery < WebPush::Request
+  class UnsafeEndpoint < StandardError; end
+
+  def perform
+    address = SsrfProtection.resolve_public_ip(uri.host)
+    raise UnsafeEndpoint unless address
+
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    http.ipaddr = address
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    response = http.post(uri.request_uri, body, headers)
+    verify_response(response)
+    response
+  end
+end
