@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @phone = @user.register_push_subscription(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "auth")
+    @desktop = @user.register_push_subscription(endpoint: "https://push.example.com/desktop", p256dh_key: "key", auth_key: "auth")
+  end
+
+  test "new tray notifications push to every subscribed device" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing tray item pushes again" do
+    notification = notifications(:logo_assignment_kevin)
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+  end
+
+  test "reading and marking unread do not send push notifications" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).read
+      notifications(:logo_assignment_kevin).unread
+    end
+  end
+
+  test "push uses the tray's event text and tenant-scoped card URL" do
+    notification = notifications(:logo_assignment_kevin)
+    expected = {
+      title: ApplicationController.helpers.notification_title(notification),
+      body: ApplicationController.helpers.notification_body(notification),
+      icon: "/app-icon-192.png", tag: "notification_#{notification.id}",
+      data: { url: "#{notification.account.slug}/cards/#{notification.card.number}" }
+    }
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification, @phone, expected ]) do
+      notification.push_later
+    end
+  end
+
+  test "mention pushes match the tray and link to the mentioned comment" do
+    notification = notifications(:logo_mentioned_david)
+    phone = notification.user.register_push_subscription(endpoint: "https://push.example.com/david", p256dh_key: "key", auth_key: "auth")
+    mention = notification.source
+    expected = {
+      title: "#{mention.mentioner.first_name} @mentioned you",
+      body: mention.source.mentionable_content.truncate(200),
+      icon: "/app-icon-192.png", tag: "notification_#{notification.id}",
+      data: { url: "#{notification.account.slug}/cards/#{notification.card.number}#comment_#{mention.source.id}" }
+    }
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification, phone, expected ]) do
+      notification.push_later
+    end
+  end
+
+  test "queued messages retain the original text when the tray is updated again" do
+    notification = notifications(:logo_assignment_kevin)
+    original_title = ApplicationController.helpers.notification_title(notification)
+    original_body = ApplicationController.helpers.notification_body(notification)
+    notification.push_later
+    notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+
+    messages = []
+    PushSubscription::Delivery.stubs(:new).with { |**options| messages << JSON.parse(options[:message]); true }.returns(stub(perform: true))
+    perform_enqueued_jobs only: Notification::PushJob
+
+    assert_equal 4, messages.size
+    assert_equal [ original_title, original_title ], messages.first(2).pluck("title")
+    assert_equal [ original_body, original_body ], messages.first(2).pluck("body")
+    assert_equal [ "JZ @mentioned you", "JZ @mentioned you" ], messages.last(2).pluck("title")
+  end
+
+  test "removing a tray item or a device before delivery discards its jobs" do
+    PushSubscription::Delivery.expects(:new).never
+    notification = notifications(:logo_assignment_kevin)
+    notification.push_later
+    notification.destroy!
+    perform_enqueued_jobs only: Notification::PushJob
+
+    notifications(:layout_commented_kevin).push_later
+    @user.push_subscriptions.destroy_all
+    perform_enqueued_jobs only: Notification::PushJob
+  end
+
+  test "rolled back tray changes do not enqueue pushes" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.transaction(requires_new: true) do
+        Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
+
+  test "a temporary failure retries only the affected device" do
+    phone_delivery = mock
+    phone_delivery.expects(:perform).raises(WebPush::PushServiceError.new(stub(body: "Unavailable"), "push.example.com"))
+    desktop_delivery = mock
+    desktop_delivery.expects(:perform).once
+
+    PushSubscription::Delivery.expects(:new).with { |**options| options.dig(:subscription, :endpoint) == @phone.endpoint }.returns(phone_delivery)
+    PushSubscription::Delivery.expects(:new).with { |**options| options.dig(:subscription, :endpoint) == @desktop.endpoint }.returns(desktop_delivery)
+
+    perform_enqueued_jobs only: Notification::PushJob, at: Time.current do
+      notifications(:logo_assignment_kevin).push_later
+    end
+
+    assert_enqueued_jobs 1, only: Notification::PushJob
+    assert_equal 2, @user.push_subscriptions.count
+  end
+
+  test "without VAPID configuration no push jobs are enqueued" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+end
diff --git a/test/models/push_subscription/delivery_test.rb b/test/models/push_subscription/delivery_test.rb
