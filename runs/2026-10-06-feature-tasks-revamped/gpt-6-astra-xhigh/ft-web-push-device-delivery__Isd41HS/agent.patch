@@ -0,0 +1,39 @@
+require "test_helper"
+
+class PushSubscription::DeliveryTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    @delivery = PushSubscription::Delivery.new(
+      message: { title: "A card", body: "Added by David" }.to_json,
+      subscription: {
+        endpoint: "https://push.example.com/device",
+        keys: { p256dh: WebPush.generate_key.public_key, auth: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)) }
+      },
+      vapid: { public_key: key.public_key, private_key: key.private_key, subject: "mailto:push@example.com" }
+    )
+  end
+
+  test "encrypts and signs the payload and pins the connection to a public address" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.com").returns("1.1.1.1")
+    http = mock
+    Net::HTTP.expects(:new).with("push.example.com", 443, nil).returns(http)
+    http.expects(:ipaddr=).with("1.1.1.1")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(5)
+    http.expects(:read_timeout=).with(5)
+    response = Net::HTTPCreated.new("1.1", "201", "Created")
+    http.expects(:post).with do |path, body, headers|
+      path == "/device" && !body.include?("Added by David") &&
+        headers["Content-Encoding"] == "aes128gcm" && headers["Authorization"].start_with?("vapid t=")
+    end.returns(response)
+
+    assert_equal response, @delivery.perform
+  end
+
+  test "does not connect to an endpoint without a public address" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.com").returns(nil)
+    Net::HTTP.expects(:new).never
+
+    assert_raises(PushSubscription::Delivery::UnsafeEndpoint) { @delivery.perform }
+  end
+end
