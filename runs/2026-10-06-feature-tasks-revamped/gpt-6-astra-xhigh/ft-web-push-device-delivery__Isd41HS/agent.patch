diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..5e50db1
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,126 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "help", "error" ]
+  static values = { url: String, publicKey: String }
+
+  #registration
+  #subscriptionId
+  #busy = false
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (this.#busy) return
+
+    this.errorTarget.hidden = true
+    this.#busy = true
+    this.#render()
+
+    try {
+      if (this.#available) {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.#registration = await navigator.serviceWorker.ready
+        const subscription = await this.#registration.pushManager.getSubscription()
+        this.#subscriptionId = null
+
+        if (subscription && Notification.permission === "granted") {
+          const response = await get(this.urlValue, { responseKind: "json" })
+          if (!response.ok) throw new Error("Could not check notification settings.")
+
+          const subscriptions = await response.json
+          this.#subscriptionId = subscriptions.find(({ endpoint }) => endpoint === subscription.endpoint)?.id
+        }
+      }
+    } catch {
+      this.#showError("Could not check notification settings. Please try again.")
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async toggle() {
+    if (this.#busy || !this.#available) return
+
+    this.#busy = true
+    this.errorTarget.hidden = true
+    this.#render()
+
+    try {
+      if (this.#subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } catch {
+      this.#showError("Could not update notification settings. Please try again.")
+    } finally {
+      this.#busy = false
+      this.#render()
+    }
+  }
+
+  async #enable() {
+    // Request permission directly from the button gesture, before other async work.
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      const subscription = await this.#registration.pushManager.getSubscription() ||
+        await this.#registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      const { endpoint, keys } = subscription.toJSON()
+      const response = await post(this.urlValue, {
+        body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+        responseKind: "json"
+      })
+      if (!response.ok) throw new Error("Could not save subscription.")
+
+      this.#subscriptionId = (await response.json).id
+    } else {
+      this.#showError("Notifications aren’t allowed. Follow the instructions below to enable them.")
+      this.helpTarget.open = true
+    }
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.#subscriptionId}`)
+    if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove subscription.")
+
+    // Other accounts can share this browser subscription. Only unregister this user.
+    this.#subscriptionId = null
+  }
+
+  #render() {
+    const enabled = !!this.#subscriptionId
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.disabled = this.#busy || !this.#available
+    this.buttonTarget.setAttribute("aria-pressed", enabled)
+    this.helpTarget.hidden = enabled
+
+    if (!this.#available || Notification.permission === "denied") {
+      this.helpTarget.open = true
+    }
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  get #available() {
+    return window.isSecureContext && "Notification" in window && "PushManager" in window &&
+      "serviceWorker" in navigator && !!this.publicKeyValue
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padding = "=".repeat((4 - base64.length % 4) % 4)
+    return Uint8Array.from(atob(base64 + padding), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..ffee572
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,9 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError, PushSubscription::Delivery::UnsafeEndpoint
+  retry_on WebPush::ResponseError, Net::OpenTimeout, Net::ReadTimeout, SocketError, wait: :polynomially_longer, attempts: 3
+
+  def perform(notification, subscription, payload)
+    # Deserializing the notification also prevents delivery after its removal.
+    subscription.deliver(payload)
+  end
+end
