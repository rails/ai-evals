+<section class="settings__section">
+  <h2 class="divider">Push Notifications</h2>
+  <p>Get your tray notifications on this device, even when Fizzy isn’t open.</p>
+
+  <% if PushSubscription.configured? %>
+    <%= tag.div class: "notifications__status panel", data: {
+      controller: "notifications",
+      notifications_url_value: user_push_subscriptions_path(Current.user),
+      notifications_public_key_value: Rails.configuration.x.web_push[:public_key],
+      action: "focus@window->notifications#refresh"
+    } do %>
+      <div aria-live="polite">
+        <p class="notifications__on-message">Push notifications are on for this device.</p>
+        <p class="notifications__off-message">Push notifications are off for this device.</p>
+        <p data-notifications-target="error" role="alert" hidden></p>
+      </div>
+
+      <button type="button" class="btn" data-notifications-target="button" data-action="notifications#toggle" disabled>
