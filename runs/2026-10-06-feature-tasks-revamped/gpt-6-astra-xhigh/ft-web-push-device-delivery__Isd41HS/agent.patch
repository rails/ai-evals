+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key" }
+  end
+
+  test "register a device for the current user" do
+    assert_difference "PushSubscription.count", 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.find(response.parsed_body.fetch("id"))
+    assert_equal @subscription.stringify_keys, subscription.attributes.slice(*@subscription.keys.map(&:to_s))
+    assert_equal @user.account, subscription.account
+  end
+  test "repeat registration refreshes keys without adding a device" do
+    existing = @user.register_push_subscription(@subscription)
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "new-auth") }, as: :json
+    end
+
+    assert_response :created
+    assert_equal existing.id, response.parsed_body["id"]
+    assert_equal "new-auth", existing.reload.auth_key
+  end
+
+  test "a user cannot subscribe another account member" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "a user cannot subscribe someone in another account" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @subscription }, as: :json
+    end
+    assert_response :not_found
+  end
+
+  test "ownership cannot be supplied in the payload" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @subscription.merge(user_id: users(:mike).id, account_id: accounts(:initech).id)
+    }, as: :json
+
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.last.account
+  end
+
+  test "invalid subscriptions are rejected" do
+    [ @subscription.except(:auth_key), @subscription.merge(endpoint: "http://push.example.com/device") ].each do |attributes|
+      assert_no_difference "PushSubscription.count" do
+        post user_push_subscriptions_path(@user), params: { push_subscription: attributes }, as: :json
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "list only this user's device identifiers, without encryption keys" do
+    own = @user.register_push_subscription(@subscription)
+    users(:kevin).register_push_subscription(@subscription)
+
+    get user_push_subscriptions_path(@user), as: :json
+
+    assert_response :success
+    assert_equal [ { "id" => own.id, "endpoint" => own.endpoint } ], response.parsed_body
+  end
+
+  test "turn off only the selected device" do
+    phone = @user.register_push_subscription(@subscription)
+    desktop = @user.register_push_subscription(@subscription.merge(endpoint: "https://push.example.com/desktop"))
+
+    assert_difference "PushSubscription.count", -1 do
+      delete user_push_subscription_path(@user, phone), as: :json
+    end
+
+    assert_response :no_content
+    assert @user.push_subscriptions.exists?(desktop.id)
+  end
+
+  test "cannot delete another user's subscription" do
+    other = users(:kevin).register_push_subscription(@subscription)
+
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscription_path(@user, other), as: :json
+    end
+    assert_response :not_found
+
+    delete user_push_subscription_path(users(:kevin), other), as: :json
+    assert_response :forbidden
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }
+    end
+    assert_response :redirect
+  end
+end
diff --git a/test/javascript/notifications_test.mjs b/test/javascript/notifications_test.mjs
new file mode 100644
index 0000000..e60d164
--- /dev/null
+++ b/test/javascript/notifications_test.mjs
@@ -0,0 +1,179 @@
+// Run with: node --test test/javascript/notifications_test.mjs
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { readFileSync } from "node:fs"
+import vm from "node:vm"
+
+const controllerSource = readFileSync(new URL("../../app/javascript/controllers/notifications_controller.js", import.meta.url), "utf8")
+  .replace(/^import .*$/gm, "")
+  .replace("export default class", "globalThis.NotificationsController = class")
+
+function device({ permission = "default", existing = false, registered = false, saveOK = true, supported = true } = {}) {
+  const calls = { permission: 0, subscribe: [], post: [], destroy: [] }
+  const subscription = {
+    endpoint: "https://push.example.com/device",
+    toJSON() { return { endpoint: this.endpoint, keys: { p256dh: "public", auth: "auth" } } },
+    unsubscribe() { assert.fail("Must not unsubscribe other accounts sharing this browser") }
+  }
+  let currentSubscription = existing ? subscription : null
+  const Notification = {
+    permission,
+    async requestPermission() { calls.permission++; return this.permission }
+  }
+  const registration = {
+    pushManager: {
+      async getSubscription() { return currentSubscription },
+      async subscribe(options) { calls.subscribe.push(options); currentSubscription = subscription; return subscription }
+    }
+  }
+  const context = vm.createContext({
+    Controller: class {}, Notification,
+    window: { isSecureContext: true, ...(supported ? { Notification, PushManager: class {} } : {}) },
+    navigator: { serviceWorker: { async register() {}, ready: Promise.resolve(registration) } },
+    atob: value => Buffer.from(value, "base64").toString("binary"),
+    async get() { return { ok: true, json: registered ? [ { id: "device-id", endpoint: subscription.endpoint } ] : [] } },
+    async post(url, options) { calls.post.push({ url, options }); return { ok: saveOK, json: { id: "device-id" } } },
+    async destroy(url) { calls.destroy.push(url); return { ok: true } }
+  })
+  vm.runInContext(controllerSource, context)
+  const controller = new context.NotificationsController()
+  let enabled = false
+  controller.element = { classList: { toggle(name, value) { assert.equal(name, "notifications--on"); enabled = value } } }
+  controller.buttonTarget = { disabled: true, setAttribute() {} }
+  controller.helpTarget = { hidden: false, open: false }
+  controller.errorTarget = { hidden: true, textContent: "" }
+  controller.urlValue = "/123/users/me/push_subscriptions"
+  controller.publicKeyValue = "AQID"
+  return { controller, calls, enabled: () => enabled }
+}
+
+test("loading settings does not request notification permission", async () => {
+  const { controller, calls, enabled } = device()
+  await controller.refresh()
+  assert.equal(calls.permission, 0)
+  assert.equal(enabled(), false)
+  assert.equal(controller.buttonTarget.disabled, false)
+})
+
+test("enabling saves the browser's subscription using the public VAPID key", async () => {
+  const { controller, calls, enabled } = device({ permission: "granted" })
+  await controller.refresh()
+  await controller.toggle()
+  assert.equal(calls.permission, 1)
+  assert.equal(calls.subscribe[0].userVisibleOnly, true)
+  assert.deepEqual(Array.from(calls.subscribe[0].applicationServerKey), [ 1, 2, 3 ])
+  assert.deepEqual(JSON.parse(JSON.stringify(calls.post[0])), {
+    url: "/123/users/me/push_subscriptions",
+    options: { body: { push_subscription: { endpoint: "https://push.example.com/device", p256dh_key: "public", auth_key: "auth" } }, responseKind: "json" }
+  })
+  assert.equal(enabled(), true)
+})
+
+test("denied permission shows help without subscribing", async () => {
+  const { controller, calls, enabled } = device({ permission: "denied" })
+  await controller.refresh()
+  await controller.toggle()
+  assert.equal(calls.subscribe.length, 0)
+  assert.equal(calls.post.length, 0)
+  assert.equal(enabled(), false)
+  assert.equal(controller.helpTarget.open, true)
+})
+
+test("unsupported browsers show help without accessing push APIs", async () => {
+  const { controller, calls } = device({ supported: false })
+  await controller.refresh()
+  await controller.toggle()
+  assert.equal(calls.permission, 0)
+  assert.equal(controller.buttonTarget.disabled, true)
+  assert.equal(controller.helpTarget.open, true)
+})
+
+test("a browser subscription alone does not enable notifications for a different user", async () => {
+  const { controller, calls, enabled } = device({ permission: "granted", existing: true })
+  await controller.refresh()
+  assert.equal(enabled(), false)
+  assert.equal(calls.post.length, 0)
+  await controller.toggle()
+  assert.equal(calls.subscribe.length, 0)
+  assert.equal(enabled(), true)
+})
+
+test("a failed registration never shows notifications as enabled", async () => {
+  const { controller, enabled } = device({ permission: "granted", saveOK: false })
+  await controller.refresh()
+  await controller.toggle()
+  assert.equal(enabled(), false)
+  assert.equal(controller.errorTarget.hidden, false)
+  assert.equal(controller.buttonTarget.disabled, false)
+})
+
+test("disabling removes only the current user's registration", async () => {
+  const { controller, calls, enabled } = device({ permission: "granted", existing: true, registered: true })
+  await controller.refresh()
+  assert.equal(enabled(), true)
+  await controller.toggle()
+  assert.deepEqual(calls.destroy, [ "/123/users/me/push_subscriptions/device-id" ])
+  assert.equal(enabled(), false)
+})
+
+function worker(windows = []) {
+  const listeners = {}
+  const calls = { shown: [], opened: [], closed: 0, skippedWaiting: 0 }
+  const context = vm.createContext({
+    URL, importScripts() {},
+    TurboOffline: { addRule() {}, handlers: { networkFirst() {}, cacheFirst() {} }, start() {} },
+    self: {
+      async skipWaiting() { calls.skippedWaiting++ },
+      location: { origin: "https://fizzy.example.com" },
+      addEventListener(name, handler) { listeners[name] = handler },
+      registration: { async showNotification(title, options) { calls.shown.push({ title, ...options }) } },
+      clients: { async matchAll() { return windows }, async openWindow(url) { calls.opened.push(url) } }
+    }
+  })
+  // ERB only supplies asset paths and a CORS configuration branch, neither used here.
+  const source = readFileSync(new URL("../../app/views/pwa/service_worker.js.erb", import.meta.url), "utf8").replace(/<%[\s\S]*?%>/g, "")
+  vm.runInContext(source, context)
+  async function dispatch(name, event) {
+    let pending
+    listeners[name]({ ...event, waitUntil(promise) { pending = promise } })
+    await pending
+  }
+  async function click(url) {
+    await dispatch("notificationclick", { notification: { data: { url }, close() { calls.closed++ } } })
+  }
+  return { calls, dispatch, click }
+}
+
+test("push displays the supplied tray text and card data", async () => {
+  const { calls, dispatch } = worker()
+  const payload = { title: "A card", body: "Added by David", data: { url: "/123/cards/2" } }
+  await dispatch("push", { data: { json: () => payload } })
+  assert.deepEqual(JSON.parse(JSON.stringify(calls.shown)), [ payload ])
+})
+
+test("click opens the tenant-scoped card, including a comment anchor", async () => {
+  const { calls, click } = worker()
+  await click("/123/cards/2#comment_3")
+  assert.equal(calls.closed, 1)
+  assert.deepEqual(calls.opened, [ "https://fizzy.example.com/123/cards/2#comment_3" ])
+})
+
+test("click focuses an existing card window", async () => {
+  let focused = false
+  const { calls, click } = worker([ { url: "https://fizzy.example.com/123/cards/2", async focus() { focused = true } } ])
+  await click("/123/cards/2")
+  assert.equal(focused, true)
+  assert.equal(calls.opened.length, 0)
+})
+
+test("click does not open a URL from another origin", async () => {
+  const { calls, click } = worker()
+  await click("https://other.example.com/")
+  assert.equal(calls.opened.length, 0)
+})
+
+test("an updated worker activates without waiting for every app window to close", async () => {
+  const { calls, dispatch } = worker()
+  await dispatch("install", {})
+  assert.equal(calls.skippedWaiting, 1)
+})
