+        <span class="notifications__on-message">Turn off notifications</span>
+      </button>
+
+      <details class="notifications-help__explainer" data-notifications-target="help">
+        <summary>Need help enabling notifications?</summary>
+        <%= render "notifications/settings/install" %>
+        <%= render "notifications/settings/browser" %>
+        <%= render "notifications/settings/system" %>
+      </details>
+    <% end %>
+  <% else %>
+    <p>Push notifications haven’t been configured for this Fizzy installation.</p>
+  <% end %>
+</section>
