diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..d19a355
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates overdue accounts and all their data without affecting other accounts" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    account.imports.create!(identity: identities(:david), status: :completed)
+    cards(:logo).reindex
+    comments(:logo_1).reindex
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("attached"), filename: "attached.txt")
+    cards(:logo).image.attach(blob)
+    variant = ActiveStorage::VariantRecord.create!(blob: blob, variation_digest: "test-variant")
+    variant.image.attach(io: StringIO.new("variant"), filename: "variant.txt")
+    ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt")
+    account.materialize_storage
+    boards(:writebook).materialize_storage
+
+    other_account = accounts(:initech)
+    other_account.users.create!(identity: identities(:david), name: "David")
+    other_data = account_data_counts(other_account)
+    identity_ids = Identity.ids
+    filter_ids = Filter.where(account: account).ids
+    search_ids = Search::Record.for(account.id).where(account_id: account.id).ids
+    storage_total_ids = Storage::Total.where(owner: [ account, *account.boards ]).ids
+
+    Current.without_account do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_empty account_data_counts(account).reject { |table, count| count.zero? }
+    assert_empty Storage::Total.where(id: storage_total_ids)
+    assert_equal other_data, account_data_counts(other_account)
+    assert_equal identity_ids.sort, Identity.ids.sort
+    assert Account.exists?(other_account.id)
+
+    Filter.reflect_on_all_associations(:has_and_belongs_to_many).each do |association|
+      join_model = Class.new(ApplicationRecord) { self.table_name = association.join_table }
+      assert_empty join_model.where(filter_id: filter_ids)
+    end
+
+    if Fizzy.db_adapter.sqlite?
+      assert_empty Search::Record::SQLite::Fts.where(rowid: search_ids)
+    end
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "only incinerates accounts cancelled more than 30 days ago" do
+    freeze_time do
+      overdue = accounts(:"37s")
+      overdue.create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago - 1.second)
+      boundary = accounts(:initech)
+      boundary.create_cancellation!(initiated_by: users(:mike), created_at: 30.days.ago)
+      recent = Account.create_with_owner(account: { name: "Recently cancelled" }, owner: { identity: identities(:david), name: "David" })
+      recent.create_cancellation!(initiated_by: recent.users.find_by!(role: :owner), created_at: 29.days.ago)
+      active = accounts(:acme)
+
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+
+      assert_not Account.exists?(overdue.id)
+      assert Account.exists?(boundary.id)
+      assert Account.exists?(recent.id)
+      assert Account.exists?(active.id)
+    end
+  end
+
+  test "does not incinerate reactivated accounts" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "incinerates multiple overdue accounts in one run" do
+    accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 60.days.ago)
+
+    assert_difference "Account.count", -2 do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def account_data_counts(account)
+      ApplicationRecord.connection_pool.with_connection do |connection|
+        connection.tables.filter_map do |table|
+          if connection.columns(table).any? { |column| column.name == "account_id" }
+            model = Class.new(ApplicationRecord) { self.table_name = table }
+            [ table, model.where(account_id: account.id).count ]
+          end
+        end.to_h
+      end
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b37c045
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "does not incinerate an active account" do
+    assert_no_difference "Account.count" do
+      @account.incinerate
+    end
+  end
+
+  test "rechecks cancellation after an account has been reactivated" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    candidate = Account.due_for_incineration.find(@account.id)
+    assert candidate.cancelled?
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      candidate.incinerate
+    end
+  end
+
+  test "rechecks the grace period after an account has been cancelled again" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    candidate = Account.due_for_incineration.find(@account.id)
+    assert candidate.cancelled?
+    @account.reactivate
+    @account.reload.cancel(initiated_by: users(:david))
+
+    assert_no_difference "Account.count" do
+      candidate.incinerate
+    end
+  end
+
+  test "rolls back database deletion if incineration fails" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("upload"), filename: "upload.txt")
+    ActiveStorage::Blob.any_instance.stubs(:purge).raises(StandardError, "Storage unavailable")
+
+    assert_no_difference [ "Account.count", "User.count", "Board.count", "Card.count", "Account::Cancellation.count" ] do
+      assert_raises(StandardError) { @account.incinerate }
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert @account.reload.cancelled?
+  end
+end
