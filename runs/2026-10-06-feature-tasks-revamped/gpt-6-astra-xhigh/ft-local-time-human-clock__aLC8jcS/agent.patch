diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..01fc6b3
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,41 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const FORMATS = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  date_with_year: { month: "short", day: "numeric", year: "numeric" },
+  long_date: { weekday: "long", month: "long", day: "numeric" },
+  datetime: { dateStyle: "medium", timeStyle: "short" },
+  full_datetime: { dateStyle: "full", timeStyle: "long" }
+}
+
+export function formatLocalTime(timestamp, format = "relative", now = new Date()) {
+  // Calendar dates (such as timeline headings) aren't UTC instants.
+  const date = new Date(/^\d{4}-\d{2}-\d{2}$/.test(timestamp) ? `${timestamp}T00:00:00` : timestamp)
+
+  if (!timestamp || isNaN(date.getTime())) return ""
+
+  if (format === "relative" || format === "relative_date") {
+    return relativeTime(date, now, format)
+  } else {
+    return new Intl.DateTimeFormat("en-US", FORMATS[format] || FORMATS.datetime).format(date)
+  }
+}
+
+function relativeTime(date, now, format) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return format === "relative_date" ? "today" : formatLocalTime(date, "time")
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days > -7) {
+    return `${-days} days ago`
+  } else {
+    return formatLocalTime(date, date.getFullYear() === now.getFullYear() ? "date" : "date_with_year")
+  }
+}
