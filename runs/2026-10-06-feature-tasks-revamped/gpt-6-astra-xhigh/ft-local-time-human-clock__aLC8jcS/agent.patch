diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..4446780
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  initialize() {
+    this.render = this.render.bind(this)
+  }
+
+  connect() {
+    this.render()
+    this.timer = setInterval(this.render, REFRESH_INTERVAL)
+    this.observer = new MutationObserver(this.render)
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+    this.element.addEventListener("turbo:morph-element", this.render)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+    this.observer.disconnect()
+    this.element.removeEventListener("turbo:morph-element", this.render)
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const timestamp = this.element.getAttribute("datetime")
+    const text = formatLocalTime(timestamp, this.formatValue)
+
+    if (text) {
+      this.element.textContent = text
+      this.element.title = formatLocalTime(timestamp, timestamp.length === 10 ? "long_date" : "full_datetime")
+    }
+  }
+}
