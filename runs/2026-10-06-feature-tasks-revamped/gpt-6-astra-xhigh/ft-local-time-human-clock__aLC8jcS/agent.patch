--- /dev/null
+++ b/test/helpers/bridge_helper_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "card sharing sends timestamps rather than formatted dates" do
+    card = cards(:logo)
+    card.created_at = Time.iso8601("2025-09-17T23:30:00-07:00")
+    card.last_active_at = Time.iso8601("2025-09-18T01:30:00-07:00")
+
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(card: card)).at_css("button")
+    data = JSON.parse(button["data-bridge--share-card-value"])
+
+    assert_equal "2025-09-18T06:30:00Z", data["createdAt"]
+    assert_equal "2025-09-18T08:30:00Z", data["updatedAt"]
+    assert_equal card.creator.familiar_name, data["author"]
+    assert_nil button["data-bridge-share-description"]
+  end
+
+  test "plain share descriptions still work" do
+    button = Nokogiri::HTML.fragment(bridged_share_url_button("5 open cards")).at_css("button")
+
+    assert_equal "5 open cards", button["data-bridge-share-description"]
+    assert_nil button["data-bridge--share-card-value"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..c3cecc2
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "emits a raw UTC timestamp for client-side formatting" do
+    timestamp = Time.iso8601("2025-09-17T13:42:00-07:00")
+
+    assert_dom_equal '<time datetime="2025-09-17T20:42:00Z" data-controller="local-time" data-local-time-format-value="relative">2025-09-17T20:42:00Z</time>', local_time_tag(timestamp)
+    assert_equal(-7.hours, timestamp.utc_offset)
+  end
+
+  test "markup does not depend on the current time or server timezone" do
+    timestamp = Time.utc(2025, 9, 17, 20, 42)
+    original = Time.use_zone("UTC") { local_time_tag(timestamp.in_time_zone) }
+
+    travel_to 2.days.from_now do
+      Time.use_zone("America/Los_Angeles") do
+        assert_equal original, local_time_tag(timestamp.in_time_zone)
+      end
+    end
+  end
+
+  test "preserves HTML options and other controllers" do
+    markup = local_time_tag(Time.utc(2025, 9, 17), format: :date, class: "timestamp", data: { controller: "other", custom: "value" })
+
+    assert_dom_equal '<time class="timestamp" datetime="2025-09-17T00:00:00Z" data-controller="other local-time" data-custom="value" data-local-time-format-value="date">2025-09-17T00:00:00Z</time>', markup
+  end
+
+  test "preserves calendar dates without introducing a timezone" do
+    assert_dom_equal '<time datetime="2025-09-17" data-controller="local-time" data-local-time-format-value="long_date">2025-09-17</time>', local_time_tag(Date.new(2025, 9, 17), format: :long_date)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..34a3b0f
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,142 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    visit new_session_path(script_name: nil)
+    browser_timezone "America/Los_Angeles"
+  end
+
+  teardown do
+    browser_timezone ""
+  end
+
+  test "relative times use the viewer's calendar day" do
+    {
+      "2025-09-17T20:42:00Z" => "1:42 PM",
+      "2025-09-17T06:30:00Z" => "yesterday",
+      "2025-09-12T20:42:00Z" => "5 days ago",
+      "2025-09-10T20:42:00Z" => "Sep 10",
+      "2024-09-12T20:42:00Z" => "Sep 12, 2024",
+      "2025-09-18T07:00:00Z" => "tomorrow",
+      "2025-09-20T07:00:00Z" => "in 3 days"
+    }.each do |timestamp, expected|
+      assert_equal expected, formatted_time(timestamp)
+    end
+
+    assert_equal "today", formatted_time("2025-09-17T23:42:00Z", format: "relative_date")
+    assert_equal "in 30 days", formatted_time("2025-10-17T23:42:00Z", format: "relative_date")
+  end
+
+  test "the same cached markup renders in each browser timezone" do
+    markup = ApplicationController.helpers.local_time_tag(Time.utc(2025, 9, 17, 20, 42), format: :time, id: "local-time-test")
+
+    { "America/Los_Angeles" => "1:42 PM", "America/New_York" => "4:42 PM", "Asia/Kathmandu" => "2:27 AM" }.each do |timezone, expected|
+      browser_timezone timezone
+      page.execute_script("document.getElementById('local-time-test')?.remove(); document.body.insertAdjacentHTML('beforeend', arguments[0])", markup)
+
+      assert_selector "#local-time-test", exact_text: expected
+      assert_equal "2025-09-17T20:42:00Z", find("#local-time-test")["datetime"]
+    end
+  end
+
+  test "calendar boundaries survive spring and fall daylight saving changes" do
+    browser_timezone "America/New_York"
+
+    assert_equal "yesterday", formatted_time("2025-03-09T00:30:00-05:00", now: "2025-03-10T00:15:00-04:00")
+    assert_equal "2 days ago", formatted_time("2025-03-08T23:30:00-05:00", now: "2025-03-10T00:30:00-04:00")
+    assert_equal "tomorrow", formatted_time("2025-03-10T00:15:00-04:00", now: "2025-03-09T00:30:00-05:00")
+    assert_equal "yesterday", formatted_time("2025-11-02T00:15:00-04:00", now: "2025-11-03T00:30:00-05:00")
+    assert_equal "2 days ago", formatted_time("2025-11-01T23:30:00-04:00", now: "2025-11-03T00:30:00-05:00")
+  end
+
+  test "midnight and year boundaries are relative to the viewer" do
+    assert_equal "yesterday", formatted_time("2025-12-31T23:59:00-08:00", now: "2026-01-01T00:01:00-08:00")
+    assert_equal "tomorrow", formatted_time("2026-01-01T00:01:00-08:00", now: "2025-12-31T23:59:00-08:00")
+    assert_equal "12:00 AM", formatted_time("2025-09-17T07:00:00Z")
+    assert_equal "12:00 PM", formatted_time("2025-09-17T19:00:00Z")
+  end
+
+  test "absolute formats use local time but calendar-only dates do not shift" do
+    assert_equal "Sep 16", formatted_time("2025-09-17T06:30:00Z", format: "date")
+    assert_equal "Sep 16, 2025", formatted_time("2025-09-17T06:30:00Z", format: "date_with_year")
+    assert_equal "Sep 16, 2025, 11:30 PM", formatted_time("2025-09-17T06:30:00Z", format: "datetime")
+    assert_equal "Wednesday, September 17", formatted_time("2025-09-17", format: "long_date")
+  end
+
+  test "timestamps update after attribute changes and Turbo morphs" do
+    insert_time(Time.utc(2025, 9, 17, 20, 42), format: :time)
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+    assert_match "1:42:00 PM", find("#local-time-test")["title"]
+
+    page.execute_script("document.getElementById('local-time-test').setAttribute('datetime', '2025-09-17T21:42:00Z')")
+    assert_selector "#local-time-test", exact_text: "2:42 PM"
+
+    markup = ApplicationController.helpers.local_time_tag(Time.utc(2025, 9, 17, 21, 42), format: :time, id: "local-time-test")
+    page.execute_script <<~JS, markup
+      Turbo.renderStreamMessage(`<turbo-stream action="replace" method="morph" target="local-time-test"><template>${arguments[0]}</template></turbo-stream>`)
+    JS
+    assert_selector "#local-time-test", exact_text: "2:42 PM"
+
+    page.execute_script("document.getElementById('local-time-test').dataset.localTimeFormatValue = 'date'")
+    assert_selector "#local-time-test", exact_text: "Sep 17"
+  end
+
+  test "relative timestamps refresh across midnight and clean up on removal" do
+    page.execute_script <<~JS
+      const OriginalDate = Date
+      window.localTimeNow = "2025-09-17T23:30:00-07:00"
+      window.Date = class extends OriginalDate {
+        constructor(...args) { super(...(args.length ? args : [window.localTimeNow])) }
+      }
+      const originalSetInterval = window.setInterval
+      window.setInterval = (callback, delay) => {
+        const timer = originalSetInterval(callback, delay)
+        if (delay === 60000) window.localTimeTimer = { callback, timer }
+        return timer
+      }
+      const originalClearInterval = window.clearInterval
+      window.clearInterval = timer => {
+        if (timer === window.localTimeTimer?.timer) window.localTimeTimerCleared = true
+        originalClearInterval(timer)
+      }
+    JS
+
+    insert_time(Time.utc(2025, 9, 17, 20, 42))
+    assert_selector "#local-time-test", exact_text: "1:42 PM"
+
+    page.execute_script("window.localTimeNow = '2025-09-18T00:30:00-07:00'; window.localTimeTimer.callback()")
+    assert_selector "#local-time-test", exact_text: "yesterday"
+
+    cleared = page.evaluate_async_script <<~JS
+      const done = arguments[0]
+      document.getElementById("local-time-test").remove()
+      setTimeout(() => done(window.localTimeTimerCleared), 0)
+    JS
+    assert cleared
+  end
+
+  test "invalid or absent timestamps do not throw" do
+    [ "not-a-date", "", nil ].each do |timestamp|
+      assert_equal "", formatted_time(timestamp)
+    end
+  end
+
+  private
+    def browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def formatted_time(timestamp, format: "relative", now: "2025-09-17T22:42:00Z")
+      page.evaluate_async_script <<~JS, timestamp, format, now
+        const [timestamp, format, now, done] = arguments
+        import("helpers/local_time_helpers")
+          .then(({ formatLocalTime }) => done(formatLocalTime(timestamp, format, new Date(now))))
+          .catch(error => done(error.toString()))
+      JS
+    end
+
+    def insert_time(timestamp, **options)
+      markup = ApplicationController.helpers.local_time_tag(timestamp, **options, id: "local-time-test")
+      page.execute_script("document.body.insertAdjacentHTML('beforeend', arguments[0])", markup)
+    end
+end
