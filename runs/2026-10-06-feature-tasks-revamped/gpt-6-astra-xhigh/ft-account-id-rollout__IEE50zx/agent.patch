diff --git a/app/models/concerns/account_join_tables.rb b/app/models/concerns/account_join_tables.rb
new file mode 100644
index 0000000..ddb7095
--- /dev/null
+++ b/app/models/concerns/account_join_tables.rb
@@ -0,0 +1,19 @@
+module AccountJoinTables
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def has_and_belongs_to_many(name, ...)
+      super
+
+      # HABTM creates an anonymous join model and can save it without validation.
+      # Its owner is persisted by the time the join row is inserted.
+      through = _reflect_on_association(name).through_reflection
+      owner_key = through.foreign_key
+      join_model = through.klass
+      join_model.belongs_to :account, optional: true
+      join_model.before_create do
+        self.account_id ||= self.class.left_model.find(self[owner_key]).account_id
+      end
+    end
+  end
+end
