+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  test "child records inherit their parent's account rather than the current account" do
+    Current.account = accounts(:initech)
+    card = cards(:buy_domain)
+    user = users(:david)
+
+    records = [
+      Assignment.new(card: card, assignee: user, assigner: user),
+      Closure.new(card: card, user: user),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card, user: user),
+      Pin.new(card: card, user: user),
+      Tagging.new(card: card, tag: tags(:web)),
+      Watch.new(card: card, user: user),
+      Access.new(board: boards(:private), user: user)
+    ]
+
+    records.each do |record|
+      record.save!
+      assert_equal accounts(:"37s"), record.reload.account, record.class.name
+    end
+  end
+
+  test "polymorphic owners and saved searches work without request context" do
+    Current.reset
+    card = cards(:buy_domain)
+    card.update!(description: "Description")
+    reaction = card.reactions.create!(content: "👍", reacter: users(:david))
+    query = users(:david).remember_search("account ownership")
+
+    [ card.rich_text_description, reaction, query ].each do |record|
+      assert_equal card.account, record.reload.account
+    end
+
+    account = Account.create!(name: "New account")
+    assert_equal account, account.entropy.reload.account
+    assert_equal account, Storage::Total.create!(owner: account).reload.account
+  end
+
+  test "filter join rows inherit ownership on both sides without request context" do
+    Current.reset
+    filter = users(:david).filters.create!(
+      tag_ids: [ tags(:mobile).id ],
+      board_ids: [ boards(:writebook).id ],
+      assignee_ids: [ users(:jz).id ],
+      creator_ids: [ users(:kevin).id ],
+      closer_ids: [ users(:david).id ]
+    )
+    tags(:web).filters << filter
+
+    %i[ tags boards assignees creators closers ].each do |name|
+      join_model = Filter._reflect_on_association(name).through_reflection.klass
+      assert_equal [ filter.account_id ], join_model.where(filter_id: filter.id).distinct.pluck(:account_id)
+    end
+  end
+
+  test "bulk access grants retain ownership without request context" do
+    Current.reset
+    board = boards(:private)
+    board.accesses.grant_to(users(:david))
+    assert_equal board.account, board.accesses.find_by!(user: users(:david)).account
+
+    user = accounts(:initech).users.create!(name: "New user", role: :member)
+    assert user.accesses.any?
+    assert_equal [ user.account_id ], user.accesses.distinct.pluck(:account_id)
+  end
+
+  test "storage records inherit ownership through rich text and variants" do
+    card = cards(:buy_domain)
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+    attachment = card.image.attachment
+    blob = card.image.blob
+    assert_equal card.account, attachment.reload.account
+    assert_equal card.account, blob.reload.account
+
+    Current.reset
+    variant = blob.variant_records.create!(variation_digest: "a-variant")
+    assert_equal card.account, variant.reload.account
+    variant.image.attach(io: StringIO.new("variant"), filename: "variant.png", content_type: "image/png")
+    assert_equal card.account, variant.image.attachment.reload.account
+    assert_equal card.account, variant.image.blob.reload.account
+  end
+end
