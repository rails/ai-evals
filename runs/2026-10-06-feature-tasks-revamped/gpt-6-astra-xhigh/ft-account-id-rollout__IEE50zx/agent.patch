diff --git a/test/migrations/complete_account_id_rollout_test.rb b/test/migrations/complete_account_id_rollout_test.rb
new file mode 100644
index 0000000..0f6265a
--- /dev/null
+++ b/test/migrations/complete_account_id_rollout_test.rb
@@ -0,0 +1,257 @@
+require "test_helper"
+require_relative "../../db/migrate/20260710120000_complete_account_id_rollout"
+
+# Exercise the data migration without fixtures, application models or callbacks.
+class CompleteAccountIdRolloutTest < Minitest::Test
+  class Database < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  def setup
+    Database.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = Database.lease_connection
+    @migration = CompleteAccountIdRollout.new
+    create_old_schema
+    @accounts = [ insert(:accounts), insert(:accounts) ]
+  end
+
+  def teardown
+    Database.connection_pool.disconnect!
+    Database.remove_connection
+  end
+
+  def test_all_tenant_tables_have_required_indexed_uuid_accounts
+    migrate
+
+    tenant_tables.each do |table|
+      column = @connection.columns(table).find { |column| column.name == "account_id" }
+      assert_equal :uuid, column.type, table.to_s
+      refute column.null, table.to_s
+      assert @connection.indexes(table).any? { |index| index.columns == [ "account_id" ] }, table.to_s
+      assert_raises(ActiveRecord::NotNullViolation) { insert(table) }
+    end
+
+    %i[ accounts identities sessions ].each do |table|
+      refute @connection.column_exists?(table, :account_id)
+    end
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  def test_application_schema_covers_all_tenant_tables
+    shared_tables = %w[accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys schema_migrations ar_internal_metadata]
+    connection = ActiveRecord::Base.connection
+    connection.tables.each do |table|
+      unless shared_tables.include?(table) || table.start_with?("search_records_fts")
+        column = connection.columns(table).find { |column| column.name == "account_id" }
+        assert column, "#{table} is missing account_id"
+        assert_equal :uuid, column.type, table
+        refute column.null, table
+        assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, table
+      end
+    end
+  end
+
+  def test_existing_ownership_is_preserved_and_accountless_rows_are_deleted
+    rows = CompleteAccountIdRollout::EXISTING_TABLES.to_h do |table|
+      valid = @accounts.map { |account| insert(table, account_id: account) }
+      insert(table, account_id: nil)
+      insert(table, account_id: uuid)
+      [ table, valid ]
+    end
+
+    migrate
+
+    rows.each do |table, ids|
+      assert_equal 2, @connection.select_value("SELECT COUNT(*) FROM #{table}")
+      ids.zip(@accounts).each { |id, account| assert_account(table, id, account) }
+    end
+  end
+
+  def test_direct_children_and_idless_join_tables_inherit_ownership
+    CompleteAccountIdRollout::PARENTS.each do |table, (parent, foreign_key)|
+      @accounts.each do |account|
+        owner = insert(parent, account_id: account)
+        insert(table, foreign_key => owner)
+      end
+      insert(table, foreign_key => uuid)
+      insert(table, foreign_key => insert(parent, account_id: nil))
+    end
+
+    migrate
+
+    CompleteAccountIdRollout::PARENTS.each_key do |table|
+      assert_equal @accounts.sort, account_ids(table).sort, table.to_s
+    end
+  end
+
+  def test_polymorphic_ownership_uses_both_type_and_id
+    rows = []
+    CompleteAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (association, types)|
+      types.each do |type, parent|
+        @accounts.each do |account|
+          owner = parent == :accounts ? account : insert(parent, account_id: account)
+          id = insert(table, "#{association}_type" => type, "#{association}_id" => owner)
+          rows << [ table, id, account ]
+        end
+        insert(table, "#{association}_type" => type, "#{association}_id" => uuid)
+      end
+      insert(table, "#{association}_type" => "Unknown", "#{association}_id" => @accounts.first)
+    end
+
+    migrate
+
+    rows.each { |table, id, account| assert_account(table, id, account) }
+    CompleteAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (_, types)|
+      assert_equal types.size * @accounts.size, account_ids(table).size, table.to_s
+    end
+  end
+
+  def test_polymorphic_parents_with_the_same_id_do_not_mix_accounts
+    id = uuid
+    insert(:cards, id: id, account_id: @accounts.first)
+    insert(:comments, id: id, account_id: @accounts.last)
+    card_reaction = insert(:reactions, reactable_type: "Card", reactable_id: id)
+    comment_reaction = insert(:reactions, reactable_type: "Comment", reactable_id: id)
+
+    migrate
+
+    assert_account(:reactions, card_reaction, @accounts.first)
+    assert_account(:reactions, comment_reaction, @accounts.last)
+  end
+
+  def test_ordinary_attachments_and_shared_blobs_retain_ownership
+    rows = []
+    CompleteAccountIdRollout::ATTACHMENT_PARENTS.each do |type, parent|
+      next if type.start_with?("ActiveStorage::", "ActionText::")
+
+      @accounts.each do |account|
+        owner = parent == :accounts ? account : insert(parent, account_id: account)
+        blob = insert(:active_storage_blobs)
+        2.times { rows << [ :active_storage_attachments, attach(type, owner, blob), account ] }
+        rows << [ :active_storage_blobs, blob, account ]
+      end
+    end
+
+    migrate
+
+    rows.each { |table, id, account| assert_account(table, id, account) }
+  end
+
+  def test_storage_ownership_reaches_variants_previews_and_their_attachments
+    rows = []
+    @accounts.each do |account|
+      card = insert(:cards, account_id: account)
+      rich_text = insert(:action_text_rich_texts, record_type: "Card", record_id: card)
+      original = insert(:active_storage_blobs)
+      attachment = attach("ActionText::RichText", rich_text, original)
+      variant = insert(:active_storage_variant_records, blob_id: original)
+      variant_blob = insert(:active_storage_blobs)
+      variant_attachment = attach("ActiveStorage::VariantRecord", variant, variant_blob)
+      preview_blob = insert(:active_storage_blobs)
+      preview_attachment = attach("ActiveStorage::Blob", original, preview_blob)
+      preview_variant = insert(:active_storage_variant_records, blob_id: preview_blob)
+      preview_variant_blob = insert(:active_storage_blobs)
+      preview_variant_attachment = attach("ActiveStorage::VariantRecord", preview_variant, preview_variant_blob)
+
+      [ original, variant_blob, preview_blob, preview_variant_blob ].each { |id| rows << [ :active_storage_blobs, id, account ] }
+      [ variant, preview_variant ].each { |id| rows << [ :active_storage_variant_records, id, account ] }
+      [ attachment, variant_attachment, preview_attachment, preview_variant_attachment ].each { |id| rows << [ :active_storage_attachments, id, account ] }
+    end
+
+    migrate
+
+    rows.each { |table, id, account| assert_account(table, id, account) }
+  end
+
+  def test_orphaned_storage_and_unsupported_record_types_are_deleted
+    insert(:active_storage_blobs) # Unattached upload
+    attach("Card", uuid, insert(:active_storage_blobs))
+    attach("Unknown", uuid, insert(:active_storage_blobs))
+    card = insert(:cards, account_id: nil)
+    rich_text = insert(:action_text_rich_texts, record_type: "Card", record_id: card)
+    blob = insert(:active_storage_blobs)
+    attach("ActionText::RichText", rich_text, blob)
+    variant = insert(:active_storage_variant_records, blob_id: blob)
+    attach("ActiveStorage::VariantRecord", variant, insert(:active_storage_blobs))
+    insert(:active_storage_variant_records, blob_id: uuid)
+    attach("Card", insert(:cards, account_id: @accounts.first), uuid) # Missing blob
+
+    migrate
+
+    %i[ action_text_rich_texts active_storage_blobs active_storage_attachments active_storage_variant_records ].each do |table|
+      assert_empty account_ids(table), table.to_s
+    end
+  end
+
+  private
+    def create_old_schema
+      %i[ accounts identities sessions ].each { |table| @connection.create_table(table, id: :uuid) }
+      CompleteAccountIdRollout::EXISTING_TABLES.each do |table|
+        @connection.create_table(table, id: :uuid) { |t| t.uuid :account_id }
+      end
+      @connection.add_index :account_imports, :account_id
+
+      CompleteAccountIdRollout::PARENTS.each do |table, (_, foreign_key)|
+        @connection.create_table(table, id: table.to_s.include?("filters") ? false : :uuid) do |t|
+          t.uuid foreign_key
+        end
+      end
+      CompleteAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (association, _)|
+        @connection.create_table(table, id: :uuid) do |t|
+          t.uuid "#{association}_id"
+          t.string "#{association}_type"
+        end
+      end
+      @connection.create_table(:active_storage_attachments, id: :uuid) do |t|
+        t.uuid :record_id
+        t.string :record_type
+        t.uuid :blob_id
+      end
+      @connection.create_table(:active_storage_blobs, id: :uuid)
+      @connection.create_table(:active_storage_variant_records, id: :uuid) { |t| t.uuid :blob_id }
+    end
+
+    def tenant_tables
+      CompleteAccountIdRollout::EXISTING_TABLES + CompleteAccountIdRollout::NEW_TABLES
+    end
+
+    def migrate
+      @migration.suppress_messages { @migration.exec_migration(@connection, :up) }
+    end
+
+    def uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def insert(table, attributes = {})
+      attributes = attributes.stringify_keys
+      attributes["id"] ||= uuid if @connection.primary_key(table)
+      columns = @connection.columns(table).index_by(&:name)
+      values = attributes.map do |name, value|
+        value = ActiveRecord::Type.lookup(:uuid, adapter: :sqlite3).serialize(value) if columns.fetch(name).type == :uuid
+        @connection.quote(value)
+      end
+      if attributes.empty?
+        @connection.execute("INSERT INTO #{table} DEFAULT VALUES")
+      else
+        @connection.execute("INSERT INTO #{table} (#{attributes.keys.join(', ')}) VALUES (#{values.join(', ')})")
+      end
+      attributes["id"]
+    end
+
+    def attach(type, record_id, blob_id)
+      insert(:active_storage_attachments, record_type: type, record_id: record_id, blob_id: blob_id)
+    end
+
+    def account_ids(table)
+      @connection.select_values("SELECT account_id FROM #{table}").map do |value|
+        ActiveRecord::Type.lookup(:uuid, adapter: :sqlite3).deserialize(value)
+      end
+    end
+
+    def assert_account(table, id, account)
+      type = ActiveRecord::Type.lookup(:uuid, adapter: :sqlite3)
+      actual = @connection.select_value("SELECT account_id FROM #{table} WHERE id = #{@connection.quote(type.serialize(id))}")
+      assert_equal account, type.deserialize(actual), "#{table}/#{id}"
+    end
+end
