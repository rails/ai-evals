+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens magic_links
+    sessions action_pack_passkeys schema_migrations ar_internal_metadata
+  ].freeze
+
+  test "every account-owned table has a required indexed UUID account ID" do
+    connection = ApplicationRecord.connection
+    tables = connection.tables - GLOBAL_TABLES
+    tables.reject! { |table| table.start_with?("search_records_fts") }
+
+    tables.each do |table|
+      column = connection.columns(table).find { |column| column.name == "account_id" }
+      assert column, "#{table} is missing account_id"
+      assert_equal :uuid, column.type, table
+      assert_not column.null, "#{table}.account_id is nullable"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id is not indexed"
+    end
+
+    GLOBAL_TABLES.each do |table|
+      assert_not connection.column_exists?(table, :account_id), "#{table} must remain global"
+    end
+  end
+
+  test "child records inherit the parent's account rather than the current account" do
+    card = cards(:radio)
+    user = users(:mike)
+    assert_not_equal Current.account, card.account
+
+    records = [
+      Assignment.new(card: card, assigner: user, assignee: user),
+      Board::Publication.new(board: card.board),
+      Card::ActivitySpike.new(card: card),
+      Card::Goldness.new(card: card),
+      Card::NotNow.new(card: card),
+      Closure.new(card: card),
+      Mention.new(source: card, mentioner: user, mentionee: user),
+      Pin.new(card: card, user: user),
+      Reaction.new(reactable: card, reacter: user, content: "👍"),
+      Search::Query.new(user: user, terms: "radio"),
+      Watch.new(card: card, user: user)
+    ]
+
+    records.each do |record|
+      record.save!
+      assert_equal card.account_id, record.reload.account_id, record.class.name
+    end
+  end
+
+  test "bulk access grants carry the board account" do
+    board = boards(:miltons_wish_list)
+    board.accesses.delete_all
+    board.accesses.grant_to(users(:mike))
+    assert_equal board.account_id, board.accesses.reload.sole.account_id
+  end
+
+  test "filter joins carry the filter account" do
+    user = users(:mike)
+    tag = user.account.tags.create!(title: "filter ownership")
+    filter = user.filters.create!(
+      tags: [ tag ], boards: [ boards(:miltons_wish_list) ],
+      assignees: [ user ], creators: [ user ], closers: [ user ]
+    )
+
+    %i[ tag_selections board_selections assignee_selections creator_selections closer_selections ].each do |association|
+      assert_equal user.account_id, filter.public_send(association).sole.account_id
+    end
+  end
+
+  test "account and board polymorphic records derive ownership without request context" do
+    Current.without_account do
+      account = Account.create!(name: "New account")
+      assert_equal account.id, account.entropy.account_id
+      assert_equal account.id, account.create_storage_total!.account_id
+
+      board = accounts(:initech).boards.create!(name: "Owned board", creator: users(:mike))
+      entropy = board.create_entropy!(auto_postpone_period: 30.days)
+      assert_equal board.account_id, entropy.account_id
+      assert_equal board.account_id, board.create_storage_total!.account_id
+    end
+  end
+
+  test "rich text and attached uploads inherit the record account" do
+    card = cards(:radio)
+    card.update!(description: "Account-owned text")
+    assert_equal card.account_id, card.rich_text_description.account_id
+
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+    assert_equal card.account_id, card.image.attachment.account_id
+    assert_equal card.account_id, card.image.blob.account_id
+  end
+
+  test "variants and their image blobs inherit ownership without request context" do
+    card = cards(:radio)
+    card.image.attach(io: StringIO.new("image"), filename: "image.png", content_type: "image/png")
+
+    Current.without_account do
+      variant = ActiveStorage::VariantRecord.new(blob: card.image.blob, variation_digest: "account-ownership")
+      variant.image.attach(io: StringIO.new("variant"), filename: "variant.png", content_type: "image/png")
+      variant.save!
+
+      assert_equal card.account_id, variant.account_id
+      assert_equal card.account_id, variant.image.attachment.account_id
+      assert_equal card.account_id, variant.image.blob.account_id
+    end
+  end
+
+  test "unattached direct uploads use the current account" do
+    blob = ActiveStorage::Blob.create_before_direct_upload!(filename: "upload.png", byte_size: 10, checksum: "checksum", content_type: "image/png")
+    assert_equal Current.account.id, blob.account_id
+  end
+end
