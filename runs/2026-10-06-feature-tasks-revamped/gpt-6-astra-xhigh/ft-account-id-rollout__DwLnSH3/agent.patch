diff --git a/config/initializers/tenanting/attachments.rb b/config/initializers/tenanting/attachments.rb
new file mode 100644
index 0000000..0255a8b
--- /dev/null
+++ b/config/initializers/tenanting/attachments.rb
@@ -0,0 +1,33 @@
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.account }
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.account }
+
+  before_validation do
+    blob.account ||= account if blob&.new_record?
+  end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
+
+# New uploads attached to a record inherit its account, even when they are
+# created outside a request (or with a different Current.account).
+module AccountOwnedBlobUploads
+  def build_after_unfurling(record: nil, **attributes)
+    super.tap do |blob|
+      blob.account = record.account if record.respond_to?(:account)
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  singleton_class.prepend AccountOwnedBlobUploads
+end
