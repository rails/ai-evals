diff --git a/test/migrations/finish_account_id_rollout_test.rb b/test/migrations/finish_account_id_rollout_test.rb
new file mode 100644
index 0000000..d1c3728
--- /dev/null
+++ b/test/migrations/finish_account_id_rollout_test.rb
@@ -0,0 +1,215 @@
+require "test_helper"
+require Rails.root.join("db/migrate/20260710120000_finish_account_id_rollout")
+
+# Use a separate database: these tests exercise legacy rows that cannot be
+# inserted into the application's current, constrained schema.
+class FinishAccountIdRolloutTest < Minitest::Test
+  class LegacyRecord < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  EXISTING_ACCOUNT_TABLES = %i[
+    users account_join_codes account_imports account_cancellations tags storage_entries
+    boards cards columns comments filters events notifications notification_bundles
+    push_subscriptions steps webhooks exports
+  ].freeze
+
+  def setup
+    LegacyRecord.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = LegacyRecord.connection
+    @ids = {}
+    @migration = FinishAccountIdRollout.new
+    connection = @connection
+    @migration.define_singleton_method(:connection) { connection }
+
+    @connection.create_table(:accounts, id: :uuid)
+    @connection.create_table(:identities, id: :uuid)
+
+    FinishAccountIdRollout::PARENTS.each do |table, parent|
+      join = table.to_s.end_with?("_filters") || table == :filters_tags
+      @connection.create_table(table, id: join ? false : :uuid) do |t|
+        t.string :marker
+        t.uuid :account_id if EXISTING_ACCOUNT_TABLES.include?(table)
+        t.uuid parent.last if parent
+      end
+    end
+
+    FinishAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (association, _)|
+      @connection.create_table(table, id: :uuid) do |t|
+        t.uuid "#{association}_id"
+        t.string "#{association}_type"
+      end
+    end
+
+    @connection.create_table(:active_storage_blobs, id: :uuid)
+    @connection.create_table(:active_storage_attachments, id: :uuid) do |t|
+      t.uuid :record_id
+      t.string :record_type
+      t.uuid :blob_id
+    end
+    @connection.create_table(:active_storage_variant_records, id: :uuid) { |t| t.uuid :blob_id }
+
+    # Preserve existing indexes rather than attempting to add them twice.
+    @connection.add_index :account_imports, :account_id
+    @connection.add_index :users, [ :account_id, :marker ], unique: true
+
+    %w[ a b ].each { |account| insert(:accounts, account) }
+    insert(:identities, "global-identity")
+  end
+
+  def teardown
+    LegacyRecord.remove_connection
+  end
+
+  def test_backfills_all_parent_and_polymorphic_paths_and_deletes_unresolvable_rows
+    FinishAccountIdRollout::PARENTS.each do |table, parent|
+      %w[ a b ].each do |account|
+        attributes = if parent
+          { parent.last => uuid("#{parent.first}-#{account}") }
+        else
+          { account_id: uuid(account) }
+        end
+        insert(table, "#{table}-#{account}", **attributes)
+      end
+
+      attributes = parent ? { parent.last => uuid("#{parent.first}-orphan") } : { account_id: uuid("missing-account") }
+      insert(table, "#{table}-orphan", **attributes)
+      insert(table, "#{table}-null")
+    end
+
+    # Existing non-null ownership is authoritative and must not be overwritten.
+    insert(:cards, "existing-owner", account_id: uuid("b"), board_id: uuid("boards-a"))
+
+    FinishAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (association, parents)|
+      parents.each do |type, parent|
+        %w[ a b ].each do |account|
+          parent_id = parent == :accounts ? account : "#{parent}-#{account}"
+          insert(table, "#{table}-#{type}-#{account}", "#{association}_id" => uuid(parent_id), "#{association}_type" => type)
+        end
+        insert(table, "#{table}-#{type}-orphan", "#{association}_id" => uuid("#{parent}-orphan"), "#{association}_type" => type)
+      end
+      insert(table, "#{table}-unknown", "#{association}_id" => uuid("cards-a"), "#{association}_type" => "Unknown")
+    end
+
+    migrate
+
+    FinishAccountIdRollout::PARENTS.each_key do |table|
+      %w[ a b ].each { |account| assert_account(table, "#{table}-#{account}", account) }
+      assert_missing table, "#{table}-orphan"
+      assert_missing table, "#{table}-null"
+    end
+    assert_account :cards, "existing-owner", "b"
+
+    FinishAccountIdRollout::POLYMORPHIC_PARENTS.each do |table, (_, parents)|
+      parents.each_key do |type|
+        %w[ a b ].each { |account| assert_account(table, "#{table}-#{type}-#{account}", account) }
+        assert_missing table, "#{table}-#{type}-orphan"
+      end
+      assert_missing table, "#{table}-unknown"
+    end
+
+    assert_equal 1, @connection.select_value("SELECT COUNT(*) FROM identities")
+    refute @connection.column_exists?(:identities, :account_id)
+    assert_schema
+  end
+
+  def test_backfills_attachments_blobs_variants_and_previews_without_guessing_ownership
+    insert(:users, "user", account_id: uuid("b"))
+    insert(:boards, "board", account_id: uuid("b"))
+    insert(:cards, "card", board_id: uuid("board"))
+    insert(:comments, "comment", card_id: uuid("card"))
+    insert(:exports, "export", account_id: uuid("b"))
+    insert(:account_imports, "import", account_id: uuid("b"))
+    insert(:action_text_rich_texts, "rich-text", record_type: "Comment", record_id: uuid("comment"))
+
+    { "User" => "user", "Board" => "board", "Card" => "card", "Comment" => "comment",
+      "Export" => "export", "Account::Import" => "import", "ActionText::RichText" => "rich-text" }.each do |type, record|
+      attach(record, type, record)
+    end
+    insert(:active_storage_variant_records, "variant", blob_id: uuid("rich-text-blob"))
+    attach("variant", "ActiveStorage::VariantRecord", "variant")
+    attach("preview", "ActiveStorage::Blob", "card-blob")
+    insert(:active_storage_variant_records, "preview-variant", blob_id: uuid("preview-blob"))
+    attach("preview-variant", "ActiveStorage::VariantRecord", "preview-variant")
+
+    insert(:active_storage_blobs, "unattached")
+    insert(:active_storage_variant_records, "orphan", blob_id: uuid("unattached"))
+    attach("orphan", "ActiveStorage::VariantRecord", "orphan")
+    attach("missing-parent", "Card", "missing-card")
+    attach("unknown-type", "Unknown", "user")
+    insert(:active_storage_attachments, "missing-blob", record_type: "Card", record_id: uuid("card"), blob_id: uuid("missing"))
+
+    migrate
+
+    %w[ user board card comment export import rich-text variant preview preview-variant ].each do |name|
+      assert_account :active_storage_attachments, "#{name}-attachment", "b"
+      assert_account :active_storage_blobs, "#{name}-blob", "b"
+    end
+    %w[ variant preview-variant ].each { |name| assert_account :active_storage_variant_records, name, "b" }
+    %w[ orphan missing-parent unknown-type ].each do |name|
+      assert_missing :active_storage_attachments, "#{name}-attachment"
+      assert_missing :active_storage_blobs, "#{name}-blob"
+    end
+    assert_missing :active_storage_blobs, "unattached"
+    assert_missing :active_storage_variant_records, "orphan"
+    assert_missing :active_storage_attachments, "missing-blob"
+    assert_schema
+  end
+
+  def test_cannot_roll_back_deleted_data
+    assert_raises(ActiveRecord::IrreversibleMigration) { @migration.down }
+  end
+
+  private
+    def migrate
+      @migration.suppress_messages { @migration.up }
+    end
+
+    def insert(table, marker, **attributes)
+      if @connection.primary_key(table)
+        attributes[:id] = uuid(marker)
+      else
+        attributes[:marker] = marker
+      end
+      columns = attributes.keys.map { |name| @connection.quote_column_name(name) }.join(", ")
+      values = attributes.values.map { |value| @connection.quote(value) }.join(", ")
+      @connection.execute "INSERT INTO #{@connection.quote_table_name(table)} (#{columns}) VALUES (#{values})"
+    end
+
+    def uuid(label)
+      @ids[label] ||= ActiveRecord::Type.lookup(:uuid, adapter: :sqlite3).serialize(ActiveRecord::Type::Uuid.generate)
+    end
+
+    def attach(name, record_type, record_id)
+      insert(:active_storage_blobs, "#{name}-blob")
+      insert(:active_storage_attachments, "#{name}-attachment", record_type: record_type, record_id: uuid(record_id), blob_id: uuid("#{name}-blob"))
+    end
+
+    def row_condition(table, marker)
+      if @connection.primary_key(table)
+        "id = #{@connection.quote(uuid(marker))}"
+      else
+        "marker = #{@connection.quote(marker)}"
+      end
+    end
+
+    def assert_account(table, marker, account)
+      count = @connection.select_value("SELECT COUNT(*) FROM #{table} WHERE #{row_condition(table, marker)} AND account_id = #{@connection.quote(uuid(account))}")
+      assert_equal 1, count, "#{table}/#{marker} should belong to #{account}"
+    end
+
+    def assert_missing(table, marker)
+      assert_equal 0, @connection.select_value("SELECT COUNT(*) FROM #{table} WHERE #{row_condition(table, marker)}"), "#{table}/#{marker} should be deleted"
+    end
+
+    def assert_schema
+      (@connection.tables - %w[ accounts identities ]).each do |table|
+        column = @connection.columns(table).find { |column| column.name == "account_id" }
+        assert_equal :uuid, column.type, table
+        refute column.null, table
+        assert @connection.index_exists?(table, :account_id), table
+        assert_raises(ActiveRecord::NotNullViolation) { @connection.execute "INSERT INTO #{table} (account_id) VALUES (NULL)" }
+      end
+      assert @connection.index_exists?(:users, [ :account_id, :marker ], unique: true)
+    end
+end
