+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      travel 2.weeks
+      get cards_path
+      assert_response :success
+      assert_select "#article_card_#{card.id} .card__stalled", text: "Stalled"
+
+      card.update! description: "Back in progress"
+      get cards_path
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "show displays stalled status and clears it when edited" do
+    freeze_time
+    card = cards(:logo)
+    card.record_burst
+    travel 2.weeks
+
+    get card_path(card)
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    patch card_path(card, format: :json), params: { card: { description: "Back in progress" } }
+    assert_response :success
+    assert_equal false, response.parsed_body["stalled"]
+
+    get card_path(card)
+    assert_select ".card__stalled", count: 0
+  end
 end
