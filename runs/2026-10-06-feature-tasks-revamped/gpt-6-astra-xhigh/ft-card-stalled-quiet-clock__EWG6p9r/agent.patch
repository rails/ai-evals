diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..542270c
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,243 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    freeze_time
+    @card = cards(:text)
+  end
+
+  test "a comment burst stalls after two weeks without activity" do
+    @card.comments.create! body: "First", creator: users(:david)
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+
+    travel 1.second
+    assert @card.reload.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create! body: "Still working on this"
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "quiet cards without a burst never stall" do
+    travel 3.months
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a burst requires three human comments from at least two people" do
+    3.times { @card.comments.create! body: "Working", creator: users(:david) }
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create! body: "System update", creator: users(:system)
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create! body: "Me too", creator: users(:kevin)
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "two comments by different people are not a burst" do
+    @card.comments.create! body: "First", creator: users(:david)
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "System update", creator: users(:system)
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the comment window is a third of the board period" do
+    @card.board.auto_postpone_period = 3.days
+    @card.comments.create! body: "First", creator: users(:david)
+
+    travel 1.day + 1.second
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create! body: "Fourth", creator: users(:david)
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments exactly at the edge of the burst window count" do
+    @card.board.auto_postpone_period = 7.days
+    @card.comments.create! body: "First", creator: users(:david)
+
+    travel 7.days / 3
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "boards without an override use the account period" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    assert_equal @card.account.entropy.auto_postpone_period, @card.auto_postpone_period
+
+    @card.comments.create! body: "First", creator: users(:david)
+    travel @card.auto_postpone_period / 3 + 1.second
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments on other cards do not contribute to a burst" do
+    @card.comments.create! body: "First", creator: users(:david)
+    cards(:layout).comments.create! body: "Second", creator: users(:kevin)
+    @card.comments.create! body: "Third", creator: users(:david)
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assigning someone is a burst but unassigning them is not" do
+    @card.assignments.delete_all
+    @card.toggle_assignment users(:kevin)
+    burst_at = @card.reload.last_burst_at
+    assert_equal Time.current, burst_at
+
+    travel 2.weeks
+    assert @card.stalled?
+
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.reload.stalled?
+    assert_equal burst_at, @card.last_burst_at
+  end
+
+  test "reopening is a burst but closing is not" do
+    @card.close
+    assert_nil @card.reload.last_burst_at
+
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  test "closed postponed and draft cards are not stalled" do
+    @card.record_burst
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity before the cutoff restarts the full two week clock" do
+    @card.record_burst
+    travel 1.week
+    @card.reactions.create! content: "👍"
+
+    travel 1.week
+    assert_not @card.reload.stalled?
+    travel 1.week
+    assert @card.stalled?
+  end
+
+  test "edits to the title description and checklist reset stalling" do
+    @card.record_burst
+    travel 2.weeks
+    assert @card.stalled?
+    @card.update! title: "A new title"
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+    @card.update! description: "More information"
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.stalled?
+    @card.steps.create! content: "Next step"
+    assert_not @card.reload.stalled?
+  end
+
+  test "editing and deleting comments resets stalling" do
+    comment = @card.comments.create! body: "Initial comment"
+    @card.record_burst
+    travel 2.weeks
+    assert @card.stalled?
+    comment.update! body: "Updated comment"
