diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..4b8a459
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,44 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+
+    around_save :preserve_explicit_activity_time, if: :last_active_at_changed?
+    before_update :refresh_activity_after_burst, if: :last_burst_at?
+    after_touch :touch_last_active_at, if: :last_burst_at?
+  end
+
+  def stalled?
+    last_burst_at? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def record_burst
+    update! last_burst_at: Time.current, last_active_at: Time.current
+  end
+
+  def detect_comment_burst
+    recent_comments = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      record_burst
+    end
+  end
+
+  # Stalling happens without a write, so cached cards must also vary by this state.
+  def cache_key
+    "#{super}/#{stalled? ? 'stalled' : 'not-stalled'}"
+  end
+
+  private
+    def preserve_explicit_activity_time(&block)
+      # Autosaved rich text can touch the card; an explicit timestamp takes precedence.
+      Card.no_touching(&block)
+    end
+
+    def refresh_activity_after_burst
+      self.last_active_at = Time.current unless last_active_at_changed?
+    end
+end
