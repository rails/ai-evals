+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  test "duplicate jobs make only one request and restore account context" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution "93.184.216.34"
+    post = stub_request(:post, delivery.webhook.url).to_return do
+      assert_equal delivery.account, Current.account
+      { status: 200 }
+    end
+
+    Current.without_account do
+      2.times { delivery.deliver_later }
+    end
+    perform_enqueued_jobs only: Webhook::DeliveryJob
+
+    assert_requested post, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "discards jobs for deleted deliveries" do
+    delivery = webhook_deliveries(:pending)
+    delivery.deliver_later
+    delivery.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+  end
+end
