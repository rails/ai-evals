+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "a committed event delivers only to active subscribers on its board" do
+    webhook = webhooks(:active)
+    webhook.board.webhooks.create!(name: "Inactive", url: webhook.url, active: false, subscribed_actions: [ "card_published" ])
+    webhook.board.webhooks.create!(name: "Unsubscribed", url: webhook.url, subscribed_actions: [ "comment_created" ])
+    boards(:private).webhooks.create!(name: "Another board", url: webhook.url, subscribed_actions: [ "card_published" ])
+
+    assert_difference "Webhook::Delivery.count", 1 do
+      event = cards(:logo).track_event(:published, creator: users(:david))
+      delivery = event.webhook_deliveries.sole
+      assert_equal webhook, delivery.webhook
+      assert_equal event.account, delivery.account
+      assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ]
+    end
+  end
+
+  test "rolling back an event neither retains nor enqueues deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        Event.transaction do
+          cards(:logo).track_event(:published, creator: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
