--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -8,8 +8,31 @@ class Webhook::Delivery < ApplicationRecord
 
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Current.with_account(account) { Webhook::DeliveryJob.perform_later(self) }
+  end
+
+  def deliver
+    # Claim before doing any network I/O. A duplicate job, including one retried
+    # after an ambiguous timeout or worker crash, must never send a second POST.
+    if self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload
+      if webhook.reload.active?
+        perform_request
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +50,23 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def perform_request
+      request = Request.new(self)
+      update! request: request.attributes
+      finish(request.perform)
+    rescue StandardError => error
+      finish(error: error.class.name)
+      raise
+    end
+
+    def finish(result)
+      webhook.with_lock do
+        update! response: result, state: result[:error].present? ? :errored : :completed
+        webhook.record_delivery(self)
+      end
+    end
 end
diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..f28c1e2
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,63 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 5
+
+  attr_reader :delivery
+  delegate :webhook, :event, :account, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def attributes
+    { headers: headers, body: body }
+  end
+
+  def perform
+    uri = URI.parse(webhook.url)
+    ip = SsrfProtection.resolve_public_ip(uri.hostname)
+
+    if ip
+      # Pin the validated IP while retaining the hostname for Host/SNI and TLS
+      # verification. Do not use an environment proxy or follow redirects.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      result = nil
+      http.request(request) do |response|
+        result = { code: response.code.to_i }
+        response.read_body { |_chunk| } # Don't buffer or retain receiver-controlled bodies.
+      end
+      result
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error
+    { error: "timeout" }
+  rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Resolv::ResolvError, Net::HTTPBadResponse
+    { error: "destination_unreachable" }
+  end
+
+  private
+    def headers
+      @headers ||= {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Delivery" => delivery.id,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def body
+      @body ||= ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event", formats: [ :json ], assigns: { event: event }
+      )
+    end
+end
