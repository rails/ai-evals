+    assert delivery.reload.succeeded?
+    assert_equal 204, delivery.response[:code]
+    body = delivery.request[:body]
+    payload = JSON.parse(body)
+    assert_equal delivery.event.id, payload["id"]
+    assert_equal delivery.event.action, payload["action"]
+    assert_equal delivery.event.board_id, payload.dig("board", "id")
+    assert_includes payload.dig("eventable", "url"), delivery.account.slug
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body),
+      delivery.request[:headers]["X-Webhook-Signature"]
+    assert_equal delivery.id, delivery.request[:headers]["X-Webhook-Delivery"]
+  end
+
+  test "posts comment payloads to each subscribed receiver" do
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: [ "comment_created" ])
+    other = webhook.board.webhooks.create!(name: "Second", url: "https://second.example.com/hook", subscribed_actions: [ "comment_created" ])
+    first_post = stub_request(:post, webhook.url).to_return(status: 200)
+    second_post = stub_request(:post, other.url).to_return(status: 200)
+    comment = comments(:layout_overflowing_david)
+
+    event = comment.track_event(:created, creator: users(:david))
+    assert_equal 2, event.webhook_deliveries.count
+    event.webhook_deliveries.each(&:deliver)
+
+    assert_requested first_post, times: 1
+    assert_requested second_post, times: 1
+    event.webhook_deliveries.each do |delivery|
+      payload = JSON.parse(delivery.reload.request[:body])
+      assert_equal "comment_created", payload["action"]
+      assert_equal comment.id, payload.dig("eventable", "id")
+      assert_equal comment.body.to_plain_text, payload.dig("eventable", "body", "plain_text")
+      assert_equal comment.card.id, payload.dig("eventable", "card", "id")
+    end
+  end
+
+  test "an overlapping worker cannot claim a delivery already being sent" do
+    delivery = webhook_deliveries(:pending)
+    competing_delivery = Webhook::Delivery.find(delivery.id)
+    post = stub_request(:post, delivery.webhook.url).to_return do
+      competing_delivery.deliver
+      { status: 200 }
+    end
+
+    delivery.deliver
+
+    assert_requested post, times: 1
+    assert delivery.reload.succeeded?
+  end
+
+  test "all 2xx responses succeed and missing response codes fail safely" do
+    delivery = webhook_deliveries(:pending)
+    [ 200, 201, 204, 299 ].each do |code|
+      delivery.state = :completed
+      delivery.response = { code: code }
+      assert delivery.succeeded?
+    end
+
+    delivery.response = {}
+    assert_not delivery.succeeded?
+    assert delivery.failed?
+  end
+
+  test "records failed responses without retrying" do
+    delivery = webhook_deliveries(:pending)
+    post = stub_request(:post, delivery.webhook.url).to_return(status: 503)
+
+    2.times { delivery.deliver }
+
+    assert_requested post, times: 1
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response[:code]
+  end
+
+  test "records network errors without retrying" do
+    delivery = webhook_deliveries(:pending)
+    post = stub_request(:post, delivery.webhook.url).to_timeout
+
+    2.times { delivery.deliver }
+
+    assert_requested post, times: 1
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert_equal "timeout", delivery.response[:error]
+  end
+
+  test "cleanup retains a week of deliveries" do
+    freeze_time do
+      old = webhook_deliveries(:successfully_completed)
+      old.update_columns(created_at: 1.week.ago - 1.second)
+      boundary = webhook_deliveries(:unsuccessfully_completed)
+      boundary.update_columns(created_at: 1.week.ago)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id)
+    end
+  end
+
+  test "does not send pending deliveries for an inactive webhook" do
+    delivery = webhook_deliveries(:pending)
+    delivery.webhook.deactivate
+
+    delivery.deliver
+
+    assert_not_requested :post, delivery.webhook.url
+    assert delivery.reload.errored?
+    assert_equal "webhook_inactive", delivery.response[:error]
+  end
+
+  test "does not resend a delivery already in progress" do
+    delivery = webhook_deliveries(:in_progress)
+
+    delivery.deliver
+
+    assert_not_requested :post, delivery.webhook.url
+    assert delivery.reload.in_progress?
+  end
+
+  test "blocks private destinations and does not follow redirects" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution "127.0.0.1"
+
+    delivery.deliver
+
+    assert_not_requested :post, delivery.webhook.url
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+  end
+
+  test "redirects are failed deliveries rather than new requests" do
+    delivery = webhook_deliveries(:pending)
+    post = stub_request(:post, delivery.webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/secret" })
+
+    delivery.deliver
+
+    assert_requested post, times: 1
+    assert_not_requested :any, "http://127.0.0.1/secret"
+    assert delivery.reload.failed?
+    assert_equal 302, delivery.response[:code]
+  end
+
+  test "the database prevents duplicate deliveries for a webhook and event" do
+    delivery = webhook_deliveries(:pending)
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: delivery.webhook, event: delivery.event)
+    end
+  end
+end
