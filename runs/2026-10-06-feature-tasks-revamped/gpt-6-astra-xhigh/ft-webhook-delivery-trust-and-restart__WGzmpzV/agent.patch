@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution "93.184.216.34"
+    @post = stub_request(:post, @webhook.url).to_return(status: 503)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    freeze_time do
+      9.times { deliver }
+      assert @webhook.reload.active?
+      assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+
+      travel 1.hour
+      deliver
+
+      assert_not @webhook.reload.active?
+      assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+    end
+  end
+
+  test "ten failures within an hour do not deactivate the webhook" do
+    freeze_time do
+      10.times { deliver }
+      assert @webhook.reload.active?
+
+      travel 1.hour - 1.second
+      deliver
+      assert @webhook.reload.active?
+
+      travel 1.second
+      deliver
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "fewer than ten failures do not deactivate even after an hour" do
+    deliver
+    travel 2.hours do
+      8.times { deliver }
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "a success resets the consecutive failure count and time" do
+    freeze_time do
+      9.times { deliver }
+      travel 1.hour
+      @post.to_return(status: 201)
+      deliver
+
+      tracker = @webhook.reload.delinquency_tracker
+      assert_equal 0, tracker.consecutive_failures_count
+      assert_nil tracker.first_failure_at
+
+      @post.to_return(status: 503)
+      deliver
+      assert @webhook.reload.active?
+      assert_equal 1, tracker.reload.consecutive_failures_count
+      assert_equal Time.current, tracker.first_failure_at
+    end
+  end
+
+  test "network failures count and duplicate jobs do not count again" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    delivery = deliver
+    delivery.deliver
+
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+    assert delivery.reload.errored?
+  end
+
+  test "reactivation resets delinquency and grants a new grace period" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+
+    deliver
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "destroying the webhook destroys its tracker" do
+    tracker = @webhook.create_delinquency_tracker!
+    @webhook.destroy!
+
+    assert_not Webhook::DelinquencyTracker.exists?(tracker.id)
+  end
+
+  private
+    def deliver
+      event = cards(:logo).track_event(:published, creator: users(:david))
+      event.webhook_deliveries.sole.tap(&:deliver)
+    end
+end
