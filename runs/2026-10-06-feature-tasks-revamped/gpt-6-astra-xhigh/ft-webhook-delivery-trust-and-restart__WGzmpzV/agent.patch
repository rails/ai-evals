+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    # Keep the outbox in the event's transaction. Delivery jobs are only enqueued
+    # after commit, so a rolled-back event can never send a webhook.
+    after_create :relay_to_webhooks
+  end
+
+  private
+    def relay_to_webhooks
+      board.webhooks.active.find_each do |webhook|
+        if webhook.subscribed_actions.include?(action)
+          webhook.deliveries.create!(event: self)
+        end
+      end
+    end
+end
