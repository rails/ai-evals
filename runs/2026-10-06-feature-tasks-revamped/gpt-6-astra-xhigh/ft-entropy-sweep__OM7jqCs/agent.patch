@@ -59,6 +59,112 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_not cards(:shipping).reload.postponed?
   end
 
+  test "due scope includes the cutoff with subsecond precision" do
+    travel_to Time.utc(2026, 2, 19, 12, 0, 0, 123456), with_usec: true
+    cutoff = 30.days.ago
+
+    cards(:logo).update_columns(last_active_at: cutoff)
+    cards(:layout).update_columns(last_active_at: cutoff + Rational(1, 1_000_000))
+    cards(:text).update_columns(last_active_at: cutoff - Rational(1, 1_000_000))
+
+    assert_equal cards(:logo, :text).to_set, boards(:writebook).cards.due_to_be_postponed(30.days).to_set
+  end
+
+  test "auto postponing honors both shorter and longer board overrides" do
+    freeze_time
+    Card.update_all last_active_at: Time.current
+    entropies(:writebook_board).update! auto_postpone_period: 7.days
+    entropies(:private_board).update! auto_postpone_period: 90.days
+
+    cards(:logo).update! last_active_at: 8.days.ago
+    cards(:layout).update! last_active_at: 6.days.ago
+    cards(:text).update_columns(board_id: boards(:private).id, column_id: nil, last_active_at: 31.days.ago)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+    assert_not cards(:text).reload.postponed?
+  end
+
+  test "auto postponing ignores closed drafted and already postponed cards" do
+    cards(:text).postpone
+    cards(:layout).drafted!
+    Card.where(id: cards(:logo, :layout, :text, :shipping).map(&:id)).update_all(last_active_at: 400.days.ago)
+
+    assert_difference -> { Event.where(action: "card_auto_postponed").count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert cards(:layout).reload.drafted?
+    assert_equal users(:david), cards(:text).reload.postponed_by
+    assert_not cards(:text).events.exists?(action: "card_auto_postponed")
+
+    assert_no_difference -> { Event.where(action: "card_auto_postponed").count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postponing inherits different account defaults across accounts" do
+    Card.update_all last_active_at: Time.current
+    entropies(:writebook_board).destroy!
+    entropies(:miltons_wish_list_board).destroy!
+    entropies("37s_account").update! auto_postpone_period: 7.days
+    entropies(:initech_account).update! auto_postpone_period: 90.days
+    cards(:logo).update! last_active_at: 8.days.ago
+    cards(:layout).update! last_active_at: 6.days.ago
+    cards(:radio).update! last_active_at: 91.days.ago
+    cards(:paycheck).update! last_active_at: 89.days.ago
+    Current.reset
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
+    assert_not cards(:layout).reload.postponed?
+    assert_not cards(:paycheck).reload.postponed?
+  end
+
+  test "auto postponing allows a board override without an account entropy" do
+    entropies("37s_account").destroy!
+    cards(:logo).update! last_active_at: 400.days.ago
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+  end
+
+  test "auto postponing skips boards with no entropy" do
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").destroy!
+    cards(:logo).update! last_active_at: 400.days.ago
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postponing processes more than one batch of due cards" do
+    attributes = cards(:logo).attributes.except("id", "number").merge("last_active_at" => 400.days.ago)
+    Card.insert_all! 1001.times.map { |i| attributes.merge("id" => ActiveRecord::Type::Uuid.generate, "number" => 1000 + i) }
+
+    Card.any_instance.expects(:auto_postpone).with(user: accounts("37s").system_user).times(1001)
+
+    Card.auto_postpone_all_due
+  end
+
+  test "auto postponing selects cards without joining entropy configuration" do
+    assert_queries_match(/FROM ["`]cards["`].*JOIN ["`]?(boards|accounts|entropies)["`]? /, count: 0) do
+      Card.auto_postpone_all_due
+    end
+  end
+
