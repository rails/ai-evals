@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish as JSON" do
+    get board_path(@board), as: :json
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+
+    get board_path(@board), as: :json
+    public_url = response.parsed_body["public_url"]
+    assert_equal public_board_url(@board.reload.publication.key, script_name: ""), public_url
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    get public_url
+    assert_response :not_found
+  end
+
+  test "publish and unpublish as HTML" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "board creators who are not admins cannot publish or unpublish" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "publishing twice keeps the URL and republishing revokes the old URL" do
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    public_url = response.parsed_body["public_url"]
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert_equal public_url, response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    new_url = response.parsed_body["public_url"]
+    assert_not_equal public_url, new_url
+
+    get public_url
+    assert_response :not_found
+    get new_url
+    assert_response :success
+  end
+
+  test "owners can publish" do
+    @board.accesses.grant_to users(:jason)
+    logout_and_sign_in_as :jason
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert @board.reload.published?
+  end
+
+  test "admins see publishing controls" do
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board)
+  end
+
+  test "non-admin board creators do not see publishing controls" do
+    logout_and_sign_in_as :david
+    get edit_board_path(@board)
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board), count: 0
+  end
+
+  test "anonymous visitors cannot unpublish" do
+    @board.publish
+    sign_out
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish boards they cannot access" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "anonymous visitors cannot publish" do
+    sign_out
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
