+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+    integration_session.default_url_options[:script_name] = ""
+  end
+
+  test "anyone with the key can open a board and follow public links" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_in_progress))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:text))
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "public card pages show published card content without editing controls" do
+    card = cards(:text)
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select "h1", text: card.title
+    assert_select "a[href=?]", public_board_path(@key)
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+  end
+
+  test "public column pages show only published cards" do
+    card = cards(:text)
+    draft = @board.cards.create!(title: "Private draft", creator: users(:david), column: card.column)
+
+    get public_board_column_path(@key, card.column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, card)
+    assert_select "a[href=?]", public_board_card_path(@key, draft), count: 0
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, draft), count: 0
+
+    get public_board_card_path(@key, draft)
+    assert_response :not_found
+  end
+
+  test "public cards include descriptions and read-only steps" do
+    card = cards(:text)
+    card.update!(description: "<p>A public description</p>")
+    card.steps.create!(content: "A completed step", completed: true)
+
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select ".card__description", text: "A public description"
+    assert_select "input[type=checkbox][checked][disabled]", count: 1
+  end
+
+  test "closed published cards can still be opened" do
+    card = cards(:text)
+    with_current_user(:kevin) { card.close }
+
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "public board and column pagination keep links public and exclude drafts" do
+    column = columns(:writebook_in_progress)
+    with_current_user(:kevin) do
+      20.times do |index|
+        @board.cards.create!(title: "Public card #{index}", column: column, status: :published)
+      end
+    end
+
+    [ public_board_path(@key), public_board_column_path(@key, column) ].each do |path|
+      get path
+      assert_response :success
+      assert_select "article.card", count: 15
+      next_page = css_select("a.pagination-link").first["href"]
+      assert_equal path, URI.parse(next_page).path
+
+      get next_page
+      assert_response :success
+      assert_select "article.card"
+      assert_select "article.card a[href^=?]", "#{public_board_path(@key)}/cards/"
+    end
+  end
+
+  test "card numbers are resolved within the published board" do
+    assert_equal cards(:logo).number, cards(:radio).number
+
+    get public_board_card_path(@key, cards(:radio).number)
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+  end
+
+  test "columns and cards must belong to the published board" do
+    other_board = boards(:private)
+    other_card = with_current_user(:kevin) do
+      other_board.cards.create!(title: "Secret", creator: users(:kevin), status: :published)
+    end
+    other_column = other_board.columns.create!(name: "Secret column")
+
+    get public_board_card_path(@key, other_card)
+    assert_response :not_found
+    get public_board_column_path(@key, other_column)
+    assert_response :not_found
+  end
+
+  test "invalid and revoked keys cannot open any public page" do
+    [ "invalid-key", @key ].each do |key|
+      @board.unpublish if key == @key
+
+      get public_board_path(key)
+      assert_response :not_found
+      get public_board_column_path(key, columns(:writebook_in_progress))
+      assert_response :not_found
+      get public_board_card_path(key, cards(:text))
+      assert_response :not_found
+    end
+  end
+
+  test "a public URL grants access even to a private board" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication.key)
+    assert_response :success
+    assert_select "h1", text: board.name
+  end
+
+  test "account prefixes cannot be used to access another account's publication" do
+    get public_board_path(@key, script_name: @board.account.slug)
+    assert_response :success
+
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+
+  test "cancelled accounts do not expose public boards" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+    get public_board_path(@key)
+    assert_response :not_found
+  end
+
+  test "public boards can be opened by signed in visitors from another account" do
+    sign_in_as :mike
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "form", count: 0
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..54460f4
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+  end
+
+  test "publishing is idempotent and generates a secret key" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      @board.publish
+      @board.publish
+    end
+
+    assert @board.reload.published?
+    assert_operator @board.publication.key.length, :>=, 24
+    assert_equal @board.account, @board.publication.account
+    assert_equal @board.publication.key, Board.find(@board.id).publication.key
+  end
+
+  test "unpublishing is idempotent and republishing rotates the key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+      @board.unpublish
+    end
+    assert_not @board.reload.published?
+
+    @board.publish
+    assert_not_equal old_key, @board.reload.publication.key
+  end
+
+  test "publication changes invalidate cached board JSON" do
+    original_cache_key = @board.cache_key_with_version
+
+    travel 1.second do
+      @board.publish
+      assert_not_equal original_cache_key, @board.reload.cache_key_with_version
+    end
+
+    published_cache_key = @board.cache_key_with_version
+    travel 2.seconds do
+      @board.unpublish
+      assert_not_equal published_cache_key, @board.reload.cache_key_with_version
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy!
+    end
+  end
+end
