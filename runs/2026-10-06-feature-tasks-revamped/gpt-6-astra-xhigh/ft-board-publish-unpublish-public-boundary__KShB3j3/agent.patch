new file mode 100644
index 0000000..597387b
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,26 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish
+    with_lock do
+      publication || create_publication!
+    end
+  end
+
+  def unpublish
+    with_lock do
+      publication&.destroy!
+      reset_publication
+    end
+  end
+end
