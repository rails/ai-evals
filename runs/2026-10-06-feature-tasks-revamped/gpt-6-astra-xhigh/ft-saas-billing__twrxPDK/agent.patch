+<% @page_title = "Plans & billing" %>
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings panel shadow center">
+  <h2>Current plan: <%= @account.billing_plan.name %></h2>
+  <p><%= number_with_delimiter(@account.card_count) %> cards · <%= number_to_human_size(@account.bytes_used) %> used</p>
+  <% if @account.comped? %><p>This account is complimentary.</p><% end %>
+
+  <% Plan::ALL.each do |plan| %>
+    <section class="margin-block">
+      <h3><%= plan.name %></h3>
+      <p><%= plan.paid? ? "#{number_to_currency(plan.price_in_cents / 100, precision: 0)}/month" : "Free" %></p>
+      <p><%= plan.card_limit ? "#{number_with_delimiter(plan.card_limit)} cards" : "Unlimited cards" %> · <%= number_to_human_size(plan.storage_limit, precision: 0) %> storage</p>
+      <% if plan.paid? && Current.user.admin? && plan.price_in_cents > @account.billing_plan.price_in_cents %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_subscription_checkout_path, params: { plan_key: plan.key }, class: "btn", data: { turbo: false } %>
+      <% end %>
+    </section>
+  <% end %>
+
+  <% if Current.user.admin? && @account.subscription %>
+    <%= button_to "Manage billing", saas.account_subscription_portal_path, class: "btn", data: { turbo: false } %>
+  <% elsif !Current.user.admin? %>
+    <p>Ask an account admin to upgrade.</p>
+  <% end %>
+  <p><%= link_to "Account settings", main_app.account_settings_path %></p>
+</section>
