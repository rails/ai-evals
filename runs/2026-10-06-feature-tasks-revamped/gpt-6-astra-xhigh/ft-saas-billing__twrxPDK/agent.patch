diff --git a/saas/test/billing_test_helper.rb b/saas/test/billing_test_helper.rb
new file mode 100644
index 0000000..6b6f136
--- /dev/null
+++ b/saas/test/billing_test_helper.rb
@@ -0,0 +1,33 @@
+require "test_helper"
+
+module BillingTestHelper
+  extend ActiveSupport::Concern
+
+  included do
+    setup do
+      @billing_env = ENV.to_h.slice(*billing_environment.keys)
+      ENV.update(billing_environment)
+      WebMock.disable_net_connect!(allow_localhost: true)
+    end
+
+    teardown do
+      billing_environment.each_key { |key| ENV.delete(key) }
+      ENV.update(@billing_env)
+      WebMock.allow_net_connect!
+    end
+  end
+
+  private
+    def billing_environment
+      { "STRIPE_SECRET_KEY" => "sk_test_local", "STRIPE_WEBHOOK_SECRET" => "whsec_local",
+        "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" }
+    end
+
+    def subscription_event(type: "customer.subscription.updated", id: "evt_local", created: Time.current.to_i,
+      price: "price_unlimited", status: "active", subscription_id: "sub_local", customer: "cus_local")
+      { id: id, type: type, created: created, data: { object: {
+        id: subscription_id, customer: customer, status: status, cancel_at: nil,
+        items: { data: [ { price: { id: price }, current_period_end: 1.month.from_now.to_i } ] }
+      } } }
+    end
+end
diff --git a/saas/test/controllers/account/subscriptions_controller_test.rb b/saas/test/controllers/account/subscriptions_controller_test.rb
new file mode 100644
index 0000000..e7fb1c5
--- /dev/null
+++ b/saas/test/controllers/account/subscriptions_controller_test.rb
@@ -0,0 +1,95 @@
+require_relative "../../billing_test_helper"
+
+class Account::SubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  test "plans show approved pricing and allowances" do
+    get saas.account_subscription_path
+    assert_response :success
+    assert_select "h3", "Free"
+    assert_select "h3", "Unlimited"
+    assert_select "h3", "Unlimited+"
+    assert_select "p", "$20/month"
+    assert_select "p", "$25/month"
+    assert_select "p", /1,000 cards.*1 GB/
+    assert_select "p", /Unlimited cards.*5 GB/
+    assert_select "p", /Unlimited cards.*500 GB/
+  end
+
+  test "settings show plan and upgrade to admins" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", "Plan: Free"
+    assert_select "a", "Upgrade"
+  end
+
+  test "checkout creates a customer and a server priced hosted subscription session" do
+    Stripe::Customer.expects(:create).with(
+      { name: @account.name, email: @account.owner_email, metadata: { account_id: @account.id } },
+      { api_key: "sk_test_local", idempotency_key: "account-#{@account.id}" }
+    ).returns(Stripe::Customer.construct_from(id: "cus_checkout"))
+    Stripe::Checkout::Session.expects(:create).with do |params, options|
+      assert_equal "cus_checkout", params[:customer]
+      assert_equal "subscription", params[:mode]
+      assert_equal [ { price: "price_plus", quantity: 1 } ], params[:line_items]
+      assert_equal @account.id, params[:subscription_data][:metadata][:account_id]
+      assert_includes params[:success_url], "#{@account.slug}/account/subscription"
+      assert_equal params[:success_url], params[:cancel_url]
+      assert_equal "sk_test_local", options[:api_key]
+      true
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/local"))
+
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1", price: "untrusted" }
+    assert_response :see_other
+    assert_redirected_to "https://checkout.stripe.com/local"
+    assert_equal "cus_checkout", @account.reload.subscription.stripe_customer_id
+    assert_equal Plan::FREE, @account.billing_plan # Redirects alone never grant paid access.
+  end
+
+  test "existing subscriptions go to the customer portal rather than a second checkout" do
+    @account.create_subscription!(stripe_customer_id: "cus_local", stripe_subscription_id: "sub_local", status: "active", plan_key: "monthly_v1")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with do |params, options|
+      params[:customer] == "cus_local" && params[:return_url].include?(@account.slug)
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_extra_storage_v1" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "portal uses the current account's customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_local")
+    Stripe::BillingPortal::Session.expects(:create).with do |params, options|
+      params[:customer] == "cus_local" && params[:return_url].include?(@account.slug)
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/local"))
+    post saas.account_subscription_portal_path, params: { customer: "cus_someone_else" }
+    assert_redirected_to "https://billing.stripe.com/local"
+  end
+
+  test "unknown and free plans cannot start checkout" do
+    Stripe::Customer.expects(:create).never
+    [ "free", "forged", nil ].each do |key|
+      post saas.account_subscription_checkout_path, params: { plan_key: key }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "members cannot start checkout or use the portal and do not see billing settings" do
+    users(:mike).update!(role: :member)
+    Stripe::Customer.expects(:create).never
+    post saas.account_subscription_checkout_path, params: { plan_key: "monthly_v1" }
+    assert_response :forbidden
+    post saas.account_subscription_portal_path
+    assert_response :forbidden
+    get account_settings_path
+    assert_select "h2", text: /Plan:/, count: 0
+    get saas.account_subscription_path
+    assert_response :success
+    assert_select "p", "Ask an account admin to upgrade."
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..b0530b2
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open linked account pages" do
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", "Comp"
+      assert_select "label", "Card count"
+      assert_select "label", "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", "Reset"
+    end
+  end
+
+  test "staff can comp and uncomp an account" do
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+      assert_nil @account.card_limit
+      get saas.admin_account_path(@account)
+      assert_select "button", "Uncomp"
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+      assert_equal 1_000, @account.card_limit
+    end
+  end
+
+  test "override form changes effective usage and reset drops the override" do
+    real_count = @account.card_count
+    untenanted do
+      patch saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: 1_000, bytes_used: 2.gigabytes } }
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.exceeding_card_limit?
+      assert @account.exceeding_storage_limit?
+      patch saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: "", bytes_used: 0 } }
+      assert_equal real_count, @account.reload.card_count
+      assert_equal 0, @account.bytes_used
+      delete saas.admin_account_overridden_limit_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_nil @account.reload.overridden_limit
+      assert_equal real_count, @account.card_count
+    end
+  end
+
+  test "invalid overrides render errors instead of changing usage" do
+    untenanted do
+      patch saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: -1, bytes_used: "bad" } }
+      assert_response :unprocessable_entity
+      assert_select "p[role=alert]", count: 2
+      assert_nil @account.reload.overridden_limit
+    end
+  end
+
+  test "being an account admin does not grant support access" do
+    sign_out
+    sign_in_as :mike
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+      post saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      delete saas.admin_account_billing_waiver_path(@account)
+      assert_response :forbidden
+      patch saas.admin_account_overridden_limit_path(@account), params: { account_overridden_limit: { card_count: 0 } }
+      assert_response :forbidden
+      delete saas.admin_account_overridden_limit_path(@account)
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/controllers/card/billing_limited_test.rb b/saas/test/controllers/card/billing_limited_test.rb
new file mode 100644
index 0000000..e4218dd
--- /dev/null
+++ b/saas/test/controllers/card/billing_limited_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Card::BillingLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.update!(cards_count: @account.cards.maximum(:number))
+    @draft = cards(:unfinished_thoughts)
+    @board = boards(:miltons_wish_list)
+    integration_session.default_url_options[:script_name] = @account.slug
+    @override = @account.create_overridden_limit!(card_count: 1_000)
+  end
+
+  test "at the limit HTML drafting remains available" do
+    post board_cards_path(@board)
+    assert_redirected_to card_draft_path(@draft)
+    assert @draft.reload.drafted?
+  end
+
+  test "at the limit a new draft can still be created and edited" do
+    @draft.destroy!
+    assert_difference -> { Card.drafted.count }, 1 do
+      post board_cards_path(@board)
+    end
+    draft = Card.last
+    assert_redirected_to card_draft_path(draft)
+    patch card_path(draft), params: { card: { title: "Keep drafting" } }, as: :json
+    assert_response :success
+    assert_equal "Keep drafting", draft.reload.title
+  end
+
+  test "publishing the actual thousandth card exhausts the allowance" do
+    @override.destroy!
+    published_count = @account.cards.published.count
+    max_number = @account.cards.maximum(:number)
+    rows = (1..(999 - published_count)).map do |offset|
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: @board.id,
+        creator_id: users(:mike).id, number: max_number + offset, status: "published", last_active_at: Time.current }
+    end
+    Card.insert_all!(rows)
+    @account.update!(cards_count: @account.cards.maximum(:number))
+    assert_equal 999, @account.reload.card_count
+
+    post card_publish_path(@draft), as: :json
+    assert_response :created
+    assert_equal 1_000, @account.reload.card_count
+    post board_cards_path(@board), params: { card: { title: "1001" } }, as: :json
+    assert_response :forbidden
+    assert_equal 1_000, @account.reload.card_count
+  end
+
+  test "at the limit drafts replace publishing buttons with an upgrade pitch" do
+    get card_draft_path(@draft)
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select ".card-perma__account-limit-message a", text: "Upgrade"
+  end
+
+  test "refuses publishing with HTML or JSON and preserves the draft" do
+    [ :html, :json ].each do |format|
+      post card_publish_path(@draft, format: format)
+      assert_response :forbidden
+      assert @draft.reload.drafted?
+    end
+  end
+
+  test "refuses API creation without creating a card" do
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board), params: { card: { title: "Over limit" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "last free card can be published" do
+    @override.update!(card_count: 999)
+    post card_publish_path(@draft), as: :json
+    assert_response :created
+    assert @draft.reload.published?
+  end
+
+  test "warning counts down within the last 100 cards" do
+    [ [ 899, nil ], [ 900, "100 cards left" ], [ 950, "50 cards left" ], [ 999, "1 card left" ] ].each do |count, warning|
+      @override.update!(card_count: count)
+      get card_draft_path(@draft)
+      assert_response :success
+      assert_select ".card-perma__notch-new-card-buttons"
+      if warning
+        assert_select "strong", text: warning
+      else
+        assert_select "strong", text: /cards left/, count: 0
+      end
+    end
+  end
+
+  test "paid and comped accounts can publish beyond the free limit" do
+    @account.comp
+    post card_publish_path(@draft), as: :json
+    assert_response :created
+
+    @account.uncomp
+    @account.create_subscription!(stripe_customer_id: "cus_cards", status: "active", plan_key: "monthly_v1")
+    post board_cards_path(@board), params: { card: { title: "Paid card" } }, as: :json
+    assert_response :created
+  end
+
+  test "another account's usage does not prevent publishing" do
+    sign_out
+    sign_in_as :kevin
+    draft = cards(:logo)
+    draft.drafted!
+    post card_publish_path(draft, script_name: accounts(:"37s").slug), as: :json
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..3eeab28
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,105 @@
+require_relative "../../billing_test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  include BillingTestHelper
+
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_local")
+  end
+
+  test "signed subscription changes activate and change plans without a login" do
+    deliver subscription_event(type: "customer.subscription.created")
+    assert_response :ok
+    assert_equal Plan::UNLIMITED, @account.reload.billing_plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @subscription.reload.current_period_end.present?
+
+    deliver subscription_event(price: "price_plus", id: "evt_upgrade", created: 1.second.from_now.to_i)
+    assert_response :ok
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.billing_plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "scheduled cancellation retains the plan until the subscription ends" do
+    event = subscription_event
+    event[:data][:object][:cancel_at] = 1.month.from_now.to_i
+    deliver event
+    assert @subscription.reload.cancel_at.present?
+    assert_equal Plan::UNLIMITED, @account.reload.billing_plan
+
+    deliver subscription_event(type: "customer.subscription.deleted", id: "evt_deleted", status: "canceled", created: 2.seconds.from_now.to_i)
+    assert_response :ok
+    assert_equal Plan::FREE, @account.reload.billing_plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "duplicate and stale events do not undo a newer plan" do
+    upgrade = subscription_event(price: "price_plus", id: "evt_upgrade", created: 2.seconds.from_now.to_i)
+    deliver upgrade
+    updated_at = @subscription.reload.updated_at
+    deliver upgrade
+    assert_equal updated_at, @subscription.reload.updated_at
+    deliver subscription_event
+    assert_response :ok
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.billing_plan
+  end
+
+  test "late updates cannot resurrect a canceled subscription" do
+    deliver subscription_event
+    deliver subscription_event(type: "customer.subscription.deleted", id: "evt_deleted", status: "canceled")
+    deliver subscription_event(id: "evt_late")
+    assert_equal Plan::FREE, @account.reload.billing_plan
+  end
+
+  test "deleting a different subscription does not cancel the current subscription" do
+    deliver subscription_event
+    deliver subscription_event(type: "customer.subscription.deleted", subscription_id: "sub_old", id: "evt_old_deleted", created: 1.second.from_now.to_i)
+    assert_equal Plan::UNLIMITED, @account.reload.billing_plan
+  end
+
+  test "unpaid and unrecognized plans do not receive paid entitlements" do
+    deliver subscription_event(status: "unpaid")
+    assert_equal Plan::FREE, @account.reload.billing_plan
+    deliver subscription_event(price: "price_unknown", id: "evt_unknown")
+    assert_equal Plan::FREE, @account.reload.billing_plan
+  end
+
+  test "unrelated events and customers are acknowledged without changes" do
+    deliver subscription_event(customer: "cus_other")
+    assert_response :ok
+    assert_nil @subscription.reload.status
+    deliver({ id: "evt_ignored", type: "invoice.paid", created: Time.current.to_i, data: { object: {} } })
+    assert_response :ok
+    assert_nil @subscription.reload.status
+  end
+
+  test "invalid missing and expired signatures are refused" do
+    payload = subscription_event.to_json
+    [ nil, "invalid", signature(payload, timestamp: 10.minutes.ago.to_i) ].each do |header|
+      untenanted { post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => header } }
+      assert_response :bad_request
+      assert_nil @subscription.reload.status
+    end
+  end
+
+  test "tampered and malformed bodies are refused" do
+    payload = subscription_event.to_json
+    untenanted { post "/stripe/webhooks", params: "#{payload} ", headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature(payload) } }
+    assert_response :bad_request
+    deliver "not-json"
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  private
+    def deliver(event)
+      payload = event.is_a?(String) ? event : event.to_json
+      untenanted { post "/stripe/webhooks", params: payload, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature(payload) } }
+    end
+
+    def signature(payload, timestamp: Time.current.to_i)
+      digest = OpenSSL::HMAC.hexdigest("SHA256", ENV.fetch("STRIPE_WEBHOOK_SECRET"), "#{timestamp}.#{payload}")
+      "t=#{timestamp},v1=#{digest}"
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..c181916
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  test "free plan includes 1000 published cards and 1 GB" do
+    account = accounts(:initech)
+    assert_equal "Free", account.billing_plan.name
+    assert_equal 1_000, account.card_limit
+    assert_equal 1.gigabyte, account.storage_limit
+    assert_equal account.cards.published.count, account.card_count
+  end
+
+  test "drafts do not consume the card allowance" do
+    account = accounts(:initech)
+    account.update!(cards_count: account.cards.maximum(:number))
+    assert_no_difference -> { account.card_count } do
+      Current.set(user: users(:mike), account: account) do
+        account.cards.create!(board: boards(:miltons_wish_list), status: :drafted)
+      end
+    end
+  end
+
+  test "warnings start with 100 cards left and publishing stops at 1000" do
+    account = accounts(:initech)
+    override = account.create_overridden_limit!(card_count: 899)
+    assert_not account.nearing_card_limit?
+    override.update!(card_count: 900)
+    assert account.nearing_card_limit?
+    assert_equal 100, account.remaining_cards
+    override.update!(card_count: 950)
+    assert_equal 50, account.remaining_cards
+    override.update!(card_count: 999)
+    assert_not account.exceeding_card_limit?
+    override.update!(card_count: 1_000)
+    assert account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+    override.update!(card_count: 1_001)
+    assert_equal 0, account.remaining_cards
+  end
+
+  test "each paid plan has unlimited cards and its own storage allowance" do
+    account = accounts(:initech)
+    subscription = account.create_subscription!(stripe_customer_id: "cus_plans", status: "active", plan_key: "monthly_v1")
+    account.create_overridden_limit!(card_count: 5_000, bytes_used: 6.gigabytes)
+    assert_equal "Unlimited", account.billing_plan.name
+    assert_nil account.card_limit
+    assert_not account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+    assert_equal 5.gigabytes, account.storage_limit
+    assert account.exceeding_storage_limit?
+
+    subscription.update!(plan_key: "monthly_extra_storage_v1")
+    assert_equal "Unlimited+", account.billing_plan.name
+    assert_equal 500.gigabytes, account.storage_limit
+    assert_not account.exceeding_storage_limit?
+
+    subscription.update!(status: "canceled")
+    assert_equal Plan::FREE, account.billing_plan
+    assert account.exceeding_card_limit?
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "comp and uncomp do not change an existing paid subscription" do
+    account = accounts(:initech)
+    account.create_subscription!(stripe_customer_id: "cus_comp", status: "active", plan_key: "monthly_extra_storage_v1")
+    account.comp
+    assert account.comped?
+    assert_nil account.card_limit
+    assert_equal 500.gigabytes, account.storage_limit
+    account.uncomp
+    assert_not account.comped?
+    assert_equal Plan::UNLIMITED_PLUS, account.billing_plan
+  end
+
+  test "usage overrides support zero and blank and reset restores measured usage" do
+    account = accounts(:initech)
+    real_count = account.card_count
+    real_bytes = account.bytes_used
+    override = account.create_overridden_limit!(card_count: 0, bytes_used: 0)
+    assert_equal 0, account.card_count
+    assert_equal 0, account.bytes_used
+    override.update!(card_count: nil, bytes_used: nil)
+    assert_equal real_count, account.card_count
+    assert_equal real_bytes, account.bytes_used
+    override.update!(card_count: 1_000, bytes_used: 2.gigabytes)
+    assert account.exceeding_card_limit?
+    assert account.exceeding_storage_limit?
+    override.destroy!
+    account.reload
+    assert_equal real_count, account.card_count
+    assert_equal real_bytes, account.bytes_used
+  end
+
+  test "invalid usage overrides are rejected" do
+    override = accounts(:initech).build_overridden_limit(card_count: -1, bytes_used: -1)
+    assert_not override.valid?
+    override.assign_attributes(card_count: 1.5, bytes_used: "not a number")
+    assert_not override.valid?
+  end
+end
