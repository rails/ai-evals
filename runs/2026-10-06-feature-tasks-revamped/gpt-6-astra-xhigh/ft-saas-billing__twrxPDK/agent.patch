@@ -0,0 +1,18 @@
+class Account::Subscriptions::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find(params[:plan_key])
+    if plan&.paid?
+      subscription = Current.account.with_lock { Current.account.stripe_subscription }
+      url = if subscription.stripe_subscription_id.present? && !subscription.status.in?(%w[ canceled incomplete_expired ])
+        subscription.portal_url(return_url: saas.account_subscription_url)
+      else
+        subscription.checkout_url(plan, return_url: saas.account_subscription_url)
+      end
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  end
+end
