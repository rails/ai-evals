diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..9060376
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,12 @@
+class Stripe::WebhooksController < ActionController::Base
+  # Stripe authenticates the raw request with a signature, not a browser session.
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    Account::Subscription.process_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..f94f987
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,67 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active? && Plan.find(subscription.plan_key)&.paid?
+      Plan.find(subscription.plan_key)
+    elsif comped?
+      Plan::UNLIMITED
+    else
+      Plan::FREE
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def card_count
+    overridden_limit&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def remaining_cards
+    [ card_limit - card_count, 0 ].max if card_limit
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && remaining_cards.between?(1, 100)
+  end
+
+  def stripe_subscription
+    subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create(
+      { name: name, email: owner_email, metadata: { account_id: id } },
+      { api_key: ENV.fetch("STRIPE_SECRET_KEY"), idempotency_key: "account-#{id}" }
+    ).id)
+  end
+end
