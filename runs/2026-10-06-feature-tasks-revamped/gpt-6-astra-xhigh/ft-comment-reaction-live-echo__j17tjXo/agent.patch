+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "comments accept reactions with a creator and account" do
+    reaction = @comment.reactions.create!(content: "🙌")
+
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_equal "🙌", reaction.reload.content
+  end
+
+  test "content must be present and at most sixteen characters" do
+    [ nil, "", "   ", "a" * 17, "🙌" * 17 ].each do |content|
+      reaction = @comment.reactions.build(content: content)
+      assert_not reaction.valid?, "Expected #{content.inspect} to be invalid"
+      assert reaction.errors[:content].any?
+    end
+
+    [ "🙌", "Great work!", "a" * 16, "🙌" * 16, "👍🏽" ].each do |content|
+      assert @comment.reactions.build(content: content).valid?, "Expected #{content.inspect} to be valid"
+    end
+  end
+
+  test "a person can leave multiple reactions" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "🎉") }
+    end
+  end
+
+  test "creating broadcasts an append to the card without refreshing it" do
+    card = @comment.card
+    updated_at = card.updated_at
+    reaction = nil
+
+    streams = capture_turbo_stream_broadcasts(card) do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        reaction = @comment.reactions.create!(content: "Nice!")
+      end
+    end
+
+    assert_equal 1, streams.size
+    assert_equal "append", streams.sole["action"]
+    assert_equal dom_id(@comment, :reactions), streams.sole["target"]
+    assert_includes streams.sole.to_s, dom_id(reaction)
+    assert_includes streams.sole.to_s, reaction.creator.name
+    assert_includes streams.sole.to_s, "#{reaction.account.slug}/cards/#{card.number}/comments/#{@comment.id}/reactions/#{reaction.id}"
+    assert_equal updated_at, card.reload.updated_at
+  end
+
+  test "destroying broadcasts removal" do
+    reaction = @comment.reactions.create!(content: "🙌")
+
+    streams = capture_turbo_stream_broadcasts(@comment.card) { reaction.destroy! }
+
+    assert_equal "remove", streams.sole["action"]
+    assert_equal dom_id(reaction), streams.sole["target"]
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "🙌")
+    @comment.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying a creator destroys their reactions on other comments" do
+    reaction = @comment.reactions.create!(content: "🙌")
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
