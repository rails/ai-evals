diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..5e7892c
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "comments have a reactions strip and composer" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "#comment_#{@comment.id} .reactions" do
+      assert_select ".reactions__list"
+      assert_select ".reactions__trigger", text: "Add a reaction"
+      assert_select "input[name='reaction[content]']"
+    end
+  end
+
+  test "create appends the reaction" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @card.account, reaction.account
+    assert_turbo_stream action: :append, target: "reactions_comment_#{@comment.id}" do
+      assert_select "#reaction_#{reaction.id}", text: /🎉.*Kevin/m
+    end
+  end
+
+  test "creator, account, and comment cannot be supplied by the client" do
+    post card_comment_reactions_path(@card, @comment), params: {
+      reaction: { content: "Nice!", creator_id: users(:jz).id, account_id: accounts(:initech).id, comment_id: comments(:layout_1).id }
+    }, as: :turbo_stream
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @card.account, reaction.account
+    assert_equal @comment, reaction.comment
+  end
+
+  test "invalid content returns errors without creating a reaction" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+
+      assert_response :unprocessable_entity
+      assert_select "turbo-stream[action=update][target=reaction_error_comment_#{@comment.id}]"
+    end
+  end
+
+  test "sixteen emoji are accepted" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" * 16 } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal "🎉" * 16, @comment.reactions.last.content
+  end
+
+  test "destroy removes your own reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: "reaction_#{reaction.id}"
+  end
+
+  test "even an administrator cannot destroy another person's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reactions and comments must belong to the requested card" do
+    reaction = comments(:layout_1).reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, comments(:layout_1)), params: { reaction: { content: "No" } }, as: :turbo_stream
+      assert_response :not_found
+
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      assert_response :not_found
+    end
+  end
+
+  test "cannot react to comments on inaccessible cards" do
+    Current.user = users(:kevin)
+    card = boards(:private).cards.create!(title: "Private", status: :published, creator: users(:kevin))
+    comment = card.comments.create!(body: "Secret", creator: users(:kevin))
+    reaction = comment.reactions.create!(content: "Nice!", creator: users(:david))
+    Current.reset
+    logout_and_sign_in_as :david
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "No" } }, as: :turbo_stream
+      assert_response :not_found
+
+      delete card_comment_reaction_path(card, comment, reaction), as: :turbo_stream
+      assert_response :not_found
+    end
+  end
+
+  test "cannot react across accounts even when card numbers overlap" do
+    card = cards(:radio)
+    comment = card.comments.create!(body: "Secret", creator: users(:mike))
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "No" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cached comments show current reactions after creation and deletion" do
+    with_actionview_partial_caching do
+      get card_path(@card)
+      assert_select "#comment_#{@comment.id} .reactions__list .reaction", count: 0
+
+      reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+      get card_path(@card)
+      assert_select "#reaction_#{reaction.id}", text: /Nice!/
+
+      reaction.destroy!
+      get card_path(@card)
+      assert_select "#reaction_#{reaction.id}", count: 0
+    end
+  end
+
+  test "reaction text is escaped" do
+    reaction = @comment.reactions.create!(content: "<b>Hi</b>", creator: users(:kevin))
+    get card_path(@card)
+
+    assert_select "#reaction_#{reaction.id}" do
+      assert_select "b", count: 0
+      assert_select "span", text: /<b>Hi<\/b>/
+    end
+  end
+end
