diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..66f5f14
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = @identity.magic_links.create!
+    @code = @magic_link.code
+  end
+
+  test "generates a six-character code and stores only its digest" do
+    assert_match /\A[A-Z0-9]{6}\z/, @code
+    assert_not_equal @code, @magic_link.code_digest
+    assert_nil MagicLink.find(@magic_link.id).code
+    assert_in_delta 15.minutes, @magic_link.expires_at - @magic_link.created_at, 1.second
+  end
+
+  test "consumes a code once" do
+    assert_difference -> { MagicLink.count }, -1 do
+      assert_equal @identity, MagicLink.consume(@magic_link.id, @code)
+    end
+
+    assert_nil MagicLink.consume(@magic_link.id, @code)
+  end
+
+  test "accepts lowercase and surrounding whitespace" do
+    assert_equal @identity, MagicLink.consume(@magic_link.id, " #{@code.downcase}\n")
+  end
+
+  test "rejects an incorrect code without consuming the correct one" do
+    assert_no_difference -> { MagicLink.count } do
+      assert_nil MagicLink.consume(@magic_link.id, @code == "ABC123" ? "DEF456" : "ABC123")
+    end
+
+    assert_equal @identity, MagicLink.consume(@magic_link.id, @code)
+  end
+
+  test "a code is bound to its pending request" do
+    other_magic_link = identities(:david).magic_links.create!
+
+    assert_nil MagicLink.consume(other_magic_link.id, @code)
+    assert_equal @identity, MagicLink.consume(@magic_link.id, @code)
+  end
+
+  test "valid just before fifteen minutes" do
+    travel_to @magic_link.expires_at - 1.second do
+      assert_equal @identity, MagicLink.consume(@magic_link.id, @code)
+    end
+  end
+
+  test "expired at fifteen minutes" do
+    freeze_time do
+      magic_link = @identity.magic_links.create!
+      travel 15.minutes
+
+      assert_nil MagicLink.consume(magic_link.id, magic_link.code)
+    end
+  end
+
+  test "expired codes cannot be consumed" do
+    travel 16.minutes do
+      assert_nil MagicLink.consume(@magic_link.id, @code)
+    end
+  end
+
+  test "rejects missing requests and malformed codes" do
+    assert_nil MagicLink.consume(nil, @code)
+
+    [ nil, "", " ", "a" * 100, "\0" * 6, [ @code ], { code: @code } ].each do |code|
+      assert_nil MagicLink.consume(@magic_link.id, code)
+    end
+  end
+
+  test "cleanup removes expired codes but keeps active codes" do
+    @magic_link.update!(expires_at: Time.current)
+    active = @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert MagicLink.exists?(active.id)
+    assert_not MagicLink.exists?(@magic_link.id)
+  end
+end
