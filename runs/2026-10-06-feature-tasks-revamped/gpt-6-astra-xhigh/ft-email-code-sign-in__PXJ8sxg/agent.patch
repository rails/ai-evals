@@ -0,0 +1,157 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+
+    untenanted do
+      deliver_enqueued_emails do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+    end
+
+    @code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    @pending_token = cookies[:pending_authentication_token]
+  end
+
+  test "invalid code allows retry without signing in" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WRONG!" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+      assert_equal @pending_token, cookies[:pending_authentication_token]
+
+      post session_magic_link_path, params: { code: @code.downcase }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "missing and malformed codes fail gracefully" do
+    untenanted do
+      [ nil, "", "a" * 100, "\0" * 6, { value: @code }, [ @code ] ].each do |code|
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: code }, as: :json
+        end
+        assert_response :unauthorized
+      end
+    end
+  end
+
+  test "expired code does not sign in" do
+    @identity.magic_links.last.update!(expires_at: Time.current)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "expired pending authentication asks for a new code" do
+    travel 16.minutes do
+      untenanted do
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: @code }
+        end
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "cannot reuse a code even with the original pending token" do
+    untenanted do
+      post session_magic_link_path, params: { code: @code }
+      assert cookies[:session_token].present?
+      sign_out
+
+      cookies[:pending_authentication_token] = @pending_token
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "requires a pending authentication cookie" do
+    cookies.delete("pending_authentication_token")
+
+    untenanted do
+      get new_session_magic_link_path
+      assert_redirected_to new_session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "rejects a tampered pending authentication cookie" do
+    cookies[:pending_authentication_token] = @pending_token.reverse
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: @code }, as: :json
+      end
+      assert_response :unauthorized
+    end
+  end
+
+  test "does not accept another identity's code" do
+    other_code = identities(:david).magic_links.create!.code
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
