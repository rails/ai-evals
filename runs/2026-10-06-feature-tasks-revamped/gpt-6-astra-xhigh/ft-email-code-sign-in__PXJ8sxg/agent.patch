+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with the code from the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identity.email_address } }
+
+      assert_not cookies[:session_token].present?
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][autocomplete=one-time-code][maxlength='6']"
+
+      assert_difference -> { identity.sessions.count }, 1 do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "sign up after verifying an email code" do
+    untenanted do
+      code = request_code do
+        post signup_path, params: { signup: { email_address: "newperson@example.com" } }
+      end
+
+      assert_not cookies[:session_token].present?
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_path
+      assert_no_difference -> { Account.count } do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_signup_completion_path
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      identity = Identity.find_by!(email_address: "newperson@example.com")
+      assert_equal "New Person", identity.users.sole.name
+      assert_redirected_to landing_url(script_name: identity.accounts.sole.slug)
+    end
+  end
+
+  test "join an account only after verifying the email code" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+
+    code = nil
+    assert_no_difference -> { User.count } do
+      code = request_code do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "newmember@example.com" }
+      end
+    end
+    assert_not cookies[:session_token].present?
+    assert_redirected_to new_session_magic_link_url(script_name: nil)
+    follow_redirect!
+    assert_response :success
+    assert_select "a[href=?]", join_path(code: join_code.code, script_name: account.slug)
+
+    untenanted do
+      assert_difference -> { join_code.reload.usage_count }, 1 do
+        assert_difference -> { User.count }, 1 do
+          post session_magic_link_path(script_name: nil), params: { code: code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "newmember@example.com"))
+    assert user.verified?
+    assert_equal "New Member", user.name
+    assert_redirected_to landing_path(script_name: account.slug)
+  end
+
+  test "new email on sign in continues to signup when signups are enabled" do
+    untenanted do
+      code = request_code { post session_path, params: { email_address: "newperson@example.com" } }
+      post session_magic_link_path(script_name: nil), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "signup with an existing identity still continues to signup completion" do
+    untenanted do
+      code = nil
+      assert_no_difference -> { Identity.count } do
+        code = request_code { post signup_path, params: { signup: { email_address: identities(:kevin).email_address } } }
+      end
+
+      post session_magic_link_path(script_name: nil), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  test "sign in returns to the originally requested page" do
+    destination = board_url(boards(:writebook), script_name: accounts(:"37s").slug)
+    get destination
+    assert_response :redirect
+    follow_redirect!
+
+    untenanted do
+      code = request_code { post session_path, params: { email_address: identities(:kevin).email_address } }
+      post session_magic_link_path(script_name: nil), params: { code: code }
+      assert_redirected_to destination
+    end
+  end
+
+  test "existing member verifies their email without using another join" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identities(:jz).email_address }
+    end
+
+    assert_no_difference -> { User.count } do
+      assert_no_difference -> { join_code.reload.usage_count } do
+        post session_magic_link_path(script_name: nil), params: { code: code }
+      end
+    end
+    assert_redirected_to landing_url(script_name: account.slug)
+  end
+
+  test "joining with another email verifies that identity before switching sessions" do
+    sign_in_as :kevin
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    identity = identities(:mike)
+    old_session = Session.find_signed!(parsed_cookies.signed[:session_token])
+
+    code = nil
+    assert_no_difference -> { User.count } do
+      code = request_code do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identity.email_address }
+      end
+    end
+    assert_equal old_session, Session.find_signed!(parsed_cookies.signed[:session_token])
+    follow_redirect!
+    assert_response :success
+
+    assert_difference -> { identity.users.count }, 1 do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert_not_equal old_session, Session.find_signed!(parsed_cookies.signed[:session_token])
+    assert_equal identity, Session.find_signed!(parsed_cookies.signed[:session_token]).identity
+  end
+
+  test "cannot join if the join code is exhausted before email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: "newmember@example.com" }
+    end
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    assert_no_difference -> { User.count } do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to session_menu_url(script_name: nil)
+    assert_match /join code is no longer available/, flash[:alert]
+  end
+
+  test "cannot join if the join code is reset before email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code do
+      post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: "newmember@example.com" }
+    end
+    join_code.reset
+
+    assert_no_difference -> { User.count } do
+      post session_magic_link_path(script_name: nil), params: { code: code }
+    end
+    assert_redirected_to session_menu_url(script_name: nil)
+    assert_equal 0, join_code.reload.usage_count
+  end
+
+  private
+    def request_code
+      assert_emails 1 do
+        deliver_enqueued_emails { yield }
+      end
+
+      email = ActionMailer::Base.deliveries.last
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "The email subject must contain the six-character code"
+      assert_includes email.text_part.body.decoded, code
+      assert_includes email.html_part.body.decoded, code
+      code
+    end
+end
