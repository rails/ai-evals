diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..d2715d9
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,34 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  has_secure_password :code, validations: false, reset_token: false
+
+  before_create :generate_code
+
+  def self.consume(id, code)
+    code = code.to_s.strip.upcase
+    return unless code.match?(/\A[A-Z0-9]{6}\z/)
+
+    transaction do
+      if magic_link = lock.find_by(id: id)
+        if magic_link.expires_at.future? && magic_link.authenticate_code(code)
+          magic_link.destroy!
+          magic_link.identity
+        end
+      end
+    end
+  end
+
+  def self.cleanup
+    where(expires_at: ..Time.current).delete_all
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      self.expires_at = EXPIRATION_TIME.from_now
+    end
+end
