+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>Enter the six-character code from your email to continue. The code is valid for 15 minutes.</p>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <label class="flex flex-column gap-half">
+      <span>Sign-in code</span>
+      <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, minlength: MagicLink::CODE_LENGTH, maxlength: MagicLink::CODE_LENGTH %>
+    </label>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Try another email or request a new code", @pending_authentication["email_entry_path"] %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
