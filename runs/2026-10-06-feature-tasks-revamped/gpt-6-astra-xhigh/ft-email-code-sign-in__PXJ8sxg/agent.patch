diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..55c6302
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,90 @@
+class Sessions::MagicLinksController < ApplicationController
+  include Authentication::ViaEmail
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  before_action :require_pending_authentication
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  rate_limit to: 10, within: MagicLink::EXPIRATION_TIME, only: :create, name: "code_attempts",
+    by: -> { @pending_authentication["magic_link_id"] || request.remote_ip }, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = MagicLink.consume(@pending_authentication["magic_link_id"], params[:code])
+      start_new_session_for identity
+      cookies.delete(:pending_authentication_token)
+      destination = after_email_authentication_url(identity)
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def require_pending_authentication
+      @pending_authentication = pending_email_authentication
+
+      unless @pending_authentication
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a new sign-in code." }
+          format.json { render json: { message: "Request a new sign-in code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def after_email_authentication_url(identity)
+      return_to = after_authentication_url
+
+      if context = @pending_authentication["join_code"]
+        join_account_url(identity, context)
+      elsif @pending_authentication["signup"]
+        new_signup_completion_url
+      else
+        return_to
+      end
+    end
+
+    def join_account_url(identity, context)
+      join_code = Account::JoinCode.find_by(account_id: context["account_id"], code: context["code"])
+
+      if join_code&.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = identity.users.active.find_by(account: join_code.account)
+      end
+
+      if user
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        flash[:alert] = "That join code is no longer available. Ask for a new one."
+        session_menu_url
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again or request a new code."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
