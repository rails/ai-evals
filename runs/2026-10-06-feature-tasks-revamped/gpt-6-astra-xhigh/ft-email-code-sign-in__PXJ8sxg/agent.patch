+    code = identity.magic_links.create!.code
+    email = IdentityMailer.magic_link(identity, code: code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identity.email_address ], email.to
+    assert_includes email.subject, code
+    assert_includes email.text_part.body.decoded, code
+    assert_includes email.html_part.body.decoded, code
+    assert_includes email.text_part.body.decoded, "15 minutes"
+    assert_includes email.html_part.body.decoded, "15 minutes"
+  end
+end
