@@ -0,0 +1,38 @@
+module Authentication::ViaEmail
+  private
+
+  def request_email_verification(identity, signup: false, join_code: nil)
+    magic_link = identity&.send_magic_link
+
+    cookies.encrypted[:pending_authentication_token] = {
+      value: {
+        magic_link_id: magic_link&.id,
+        signup: signup,
+        email_entry_path: email_entry_path(signup: signup, join_code: join_code),
+        join_code: join_code && { account_id: join_code.account_id, code: join_code.code }
+      },
+      expires: MagicLink::EXPIRATION_TIME.from_now,
+      httponly: true,
+      same_site: :lax
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_magic_link_path(script_name: nil) }
+      format.json { render json: { pending_authentication_token: cookies[:pending_authentication_token] }, status: :created }
+    end
+  end
+
+  def email_entry_path(signup:, join_code:)
+    if join_code
+      join_path(code: join_code.code, script_name: join_code.account.slug)
+    elsif signup
+      new_signup_path(script_name: nil)
+    else
+      new_session_path(script_name: nil)
+    end
+  end
+
+  def pending_email_authentication
+    cookies.encrypted[:pending_authentication_token]
+  end
+end
