+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p>Enter the six-character code we emailed you. It expires in 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code", class: "for-screen-reader" %>
+    <%= form.text_field :code, required: true, minlength: 6, maxlength: 6, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, class: "input txt-large full-width", placeholder: "Enter your code…" %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small"><%= link_to "Try another email or request a new code", @email_authentication["retry_url"] %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
