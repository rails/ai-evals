diff --git a/test/controllers/sessions/email_codes_controller_test.rb b/test/controllers/sessions/email_codes_controller_test.rb
new file mode 100644
index 0000000..71ffb57
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+    end
+    @email_code = identities(:kevin).email_codes.last
+  end
+
+  test "invalid codes can be retried" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "wrong" }
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_match /invalid or has expired/, flash[:alert]
+
+      post session_email_code_path, params: { code: @email_code.code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "expired codes cannot sign in" do
+    travel_to @email_code.expires_at, with_usec: true do
+      untenanted do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: @email_code.code }
+        end
+        assert_redirected_to new_session_email_code_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "verification requires the requesting browser" do
+    open_session do |other_browser|
+      assert_no_difference -> { Session.count } do
+        other_browser.post "/session/email_code", params: { code: @email_code.code }
+      end
+      other_browser.assert_redirected_to "/session/new"
+    end
+  end
+
+  test "another identity's code cannot be used" do
+    other_code = identities(:david).email_codes.create!
+    other_code.update!(code: @email_code.code == "ABCDEF" ? "GHIJKL" : "ABCDEF")
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: other_code.code }
+      end
+      assert_redirected_to new_session_email_code_path
+    end
+  end
+
+  test "requesting another code invalidates the previous request" do
+    untenanted do
+      post session_path, params: { email_address: identities(:david).email_address }
+      assert_not EmailCode.exists?(@email_code.id)
+
+      post session_email_code_path, params: { code: identities(:david).email_codes.last.code }
+      assert_equal identities(:david), Session.last.identity
+    end
+  end
+
+  test "consumed code cannot sign in again" do
+    untenanted do
+      post session_email_code_path, params: { code: @email_code.code }
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @email_code.code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "missing and malformed codes cannot authenticate" do
+    untenanted do
+      [ {}, { code: "" }, { code: [ @email_code.code ] }, { code: { value: @email_code.code } } ].each do |params|
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: params
+        end
+        assert_response :bad_request
+      end
+    end
+  end
+
+  test "JSON authentication returns a session token" do
+    untenanted do
+      post session_email_code_path, params: { code: @email_code.code }, as: :json
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "invalid JSON authentication is unauthorized" do
+    untenanted do
+      post session_email_code_path, params: { code: "wrong" }, as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "verification is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: @email_code.code }
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_equal "Try again later.", flash[:alert]
+
+      post session_email_code_path, params: { code: @email_code.code }, as: :json
+      assert_response :too_many_requests
+    end
+  end
+end
