diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..8ede848
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,25 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+
+  before_validation :generate_code, on: :create
+
+  def self.cleanup
+    where(expires_at: ..Time.current).in_batches.delete_all
+  end
+
+  def consume(submitted_code)
+    # Deleting atomically makes the code single-use, even for concurrent requests.
+    if self.class.where(id: id, code: submitted_code.to_s.strip.upcase).where("expires_at > ?", Time.current).delete_all == 1
+      identity
+    end
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      self.expires_at = EXPIRATION.from_now
+    end
+end
