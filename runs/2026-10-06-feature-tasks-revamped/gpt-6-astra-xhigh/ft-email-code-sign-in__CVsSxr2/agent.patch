+module Authentication::ByEmail
+  private
+
+  def request_email_code_for(identity, return_to: nil, join_code: nil, retry_url: new_session_url(script_name: nil))
+    EmailCode.where(id: session.dig(:email_authentication, "email_code_id")).delete_all
+    email_code = identity&.send_email_code
+
+    session[:email_authentication] = {
+      email_code_id: email_code&.id,
+      return_to: return_to,
+      retry_url: retry_url,
+      join_code: join_code&.code,
+      account_id: join_code&.account_id
+    }
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_url(script_name: nil) }
+      format.json { head :created }
+    end
+  end
+end
