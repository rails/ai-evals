diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..1cdd7a8
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six-character code valid for fifteen minutes" do
+    freeze_time do
+      email_code = @identity.email_codes.create!
+
+      assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+      assert_equal 15.minutes.from_now, email_code.expires_at
+    end
+  end
+
+  test "consumes a code only once, including from a stale copy" do
+    email_code = @identity.email_codes.create!
+    stale_copy = EmailCode.find(email_code.id)
+
+    assert_equal @identity, email_code.consume(email_code.code)
+    assert_nil stale_copy.consume(email_code.code)
+  end
+
+  test "accepts lower case and surrounding whitespace" do
+    email_code = @identity.email_codes.create!
+
+    assert_equal @identity, email_code.consume(" #{email_code.code.downcase}\n")
+  end
+
+  test "incorrect codes do not consume the code" do
+    email_code = @identity.email_codes.create!
+
+    [ nil, "", "wrong", "toolong", "!!!!!!" ].each do |code|
+      assert_nil email_code.consume(code)
+    end
+
+    assert_equal @identity, email_code.consume(email_code.code)
+  end
+
+  test "works just before expiry" do
+    email_code = @identity.email_codes.create!
+
+    travel_to email_code.expires_at - 1.second do
+      assert_equal @identity, email_code.consume(email_code.code)
+    end
+  end
+
+  test "does not work at or after expiry" do
+    email_code = @identity.email_codes.create!
+
+    travel_to email_code.expires_at, with_usec: true do
+      assert_nil email_code.consume(email_code.code)
+    end
+
+    travel_to email_code.expires_at + 1.second do
+      assert_nil email_code.consume(email_code.code)
+    end
+  end
+
+  test "cleanup removes only expired codes" do
+    expired = @identity.email_codes.create!
+    expired.update!(expires_at: Time.current)
+    current = @identity.email_codes.create!
+
+    EmailCode.cleanup
+
+    assert_not EmailCode.exists?(expired.id)
+    assert EmailCode.exists?(current.id)
+  end
+
+  test "destroying an identity destroys its codes" do
+    identity = Identity.create!(email_address: "temporary@example.com")
+    email_code = identity.email_codes.create!
+
+    identity.destroy!
+
+    assert_not EmailCode.exists?(email_code.id)
+  end
+end
