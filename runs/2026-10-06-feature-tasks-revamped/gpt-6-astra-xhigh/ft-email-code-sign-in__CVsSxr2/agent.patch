+require "test_helper"
+
+class EmailAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with an emailed code" do
+    untenanted do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address }
+        end
+      end
+
+      assert_redirected_to "/session/email_code/new"
+      assert_not cookies[:session_token].present?
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+      assert_select "form[action=?]", "/session/email_code"
+
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      assert code, "The subject should contain the six-character code"
+
+      post "/session/email_code", params: { code: code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+  test "sign up and complete a new account" do
+    Account.any_instance.expects(:setup_customer_template).once
+
+    untenanted do
+      code = nil
+      assert_difference -> { Identity.count }, 1 do
+        assert_no_difference -> { Account.count } do
+          code = emailed_code do
+            post signup_path, params: { signup: { email_address: "new-person@example.com" } }
+          end
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_url
+
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      account = Account.last
+      assert_redirected_to landing_url(script_name: account.slug)
+      assert_equal "new-person@example.com", account.users.find_by!(role: :owner).identity.email_address
+    end
+  end
+
+  test "sign up with an existing email without duplicating the identity" do
+    untenanted do
+      code = nil
+      assert_no_difference -> { Identity.count } do
+        code = emailed_code do
+          post signup_path, params: { signup: { email_address: identities(:kevin).email_address } }
+        end
+      end
+
+      post session_email_code_path(script_name: nil), params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "join a new identity after verifying its email and complete its profile" do
+    account = accounts(:"37s")
+    join_code = account_join_codes(:"37s")
+    code = nil
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        code = emailed_code do
+          post join_path(code: join_code.code), params: { email_address: "joiner@example.com" }
+        end
+      end
+    end
+    assert_redirected_to new_session_email_code_url(script_name: nil)
+    assert_not cookies[:session_token].present?
+    follow_redirect!
+    assert_select "a[href=?]", join_url(code: join_code.code)
+
+    untenanted do
+      assert_difference [ -> { User.count }, -> { join_code.reload.usage_count } ], 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+    end
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+
+    post users_verifications_path
+    assert_redirected_to new_users_join_path
+    post users_joins_path, params: { user: { name: "New Joiner" } }
+    assert_redirected_to landing_path
+
+    user = account.users.find_by!(identity: Identity.find_by!(email_address: "joiner@example.com"))
+    assert user.verified?
+    assert_equal "New Joiner", user.name
+  end
+
+  test "join an existing identity without adding a duplicate membership" do
+    join_code = account_join_codes(:"37s")
+    code = emailed_code do
+      post join_path(code: join_code.code), params: { email_address: identities(:jz).email_address }
+    end
+
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_redirected_to landing_url(script_name: accounts(:"37s").slug)
+    assert_equal identities(:jz), Session.last.identity
+  end
+
+  test "join an existing identity to a new account" do
+    join_code = account_join_codes(:"37s")
+    code = nil
+    assert_no_difference [ -> { Identity.count }, -> { User.count } ] do
+      code = emailed_code do
+        post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+      end
+    end
+
+    untenanted do
+      assert_difference [ -> { User.count }, -> { join_code.reload.usage_count } ], 1 do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: accounts(:"37s").slug)
+    assert_equal identities(:mike), Session.last.identity
+  end
+
+  test "joining with a different email switches identity only after verification" do
+    sign_in_as :kevin
+    join_code = account_join_codes(:"37s")
+    code = emailed_code do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+    end
+    assert_equal identities(:kevin), Session.last.identity
+
+    untenanted do
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+    assert_equal identities(:mike), Session.last.identity
+  end
+
+  test "an invitation exhausted while waiting for the email cannot be redeemed" do
+    join_code = account_join_codes(:"37s")
+    code = emailed_code do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+    end
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count } ] do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_session_path
+      assert_match /join link is no longer available/, flash[:alert]
+    end
+  end
+
+  test "a replaced invitation cannot be redeemed" do
+    join_code = account_join_codes(:"37s")
+    code = emailed_code do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+    end
+    join_code.reset
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { Session.count } ] do
+        post session_email_code_path(script_name: nil), params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "sign in returns to the protected page originally requested" do
+    get board_path(boards(:writebook))
+    assert_redirected_to new_session_url(script_name: nil)
+
+    untenanted do
+      code = emailed_code do
+        post session_path(script_name: nil), params: { email_address: identities(:kevin).email_address }
+      end
+      post session_email_code_path(script_name: nil), params: { code: code }
+    end
+
+    assert_redirected_to board_url(boards(:writebook))
+  end
+
+  private
+    def emailed_code
+      assert_emails 1 do
+        perform_enqueued_jobs { yield }
+      end
+
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/].tap do |code|
+        assert code, "The subject should contain the six-character code"
+      end
+    end
+end
