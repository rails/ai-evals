+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "email code includes the code in the subject and both message parts" do
+    email_code = identities(:kevin).email_codes.create!
+    email = IdentityMailer.email_code(email_code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ email_code.identity.email_address ], email.to
+    assert_includes email.subject, email_code.code
+
+    [ email.html_part, email.text_part ].each do |part|
+      assert_includes part.body.decoded, email_code.code
+      assert_includes part.body.decoded, "15 minutes"
+    end
+  end
+end
