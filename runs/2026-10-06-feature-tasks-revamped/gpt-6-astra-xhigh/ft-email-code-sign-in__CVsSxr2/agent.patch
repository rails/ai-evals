@@ -0,0 +1,67 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :require_email_authentication
+  before_action :set_join_code, only: :create
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    email_code = EmailCode.find_by(id: @email_authentication["email_code_id"])
+
+    if identity = email_code&.consume(params.expect(:code))
+      session.delete(:email_authentication)
+      start_new_session_for identity
+      return_to = after_authentication_url
+      destination = @join_code ? join_account(identity) : @email_authentication["return_to"] || return_to
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "That code is invalid or has expired. Try again or request a new code." }
+        format.json { render json: { message: "That code is invalid or has expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def require_email_authentication
+      @email_authentication = session[:email_authentication]
+      redirect_to new_session_path unless @email_authentication
+    end
+
+    def set_join_code
+      if @email_authentication["join_code"]
+        @join_code = Account::JoinCode.active.find_by(code: @email_authentication["join_code"], account_id: @email_authentication["account_id"])
+        unless @join_code
+          redirect_to new_session_path, alert: "That join link is no longer available. Ask for a new one."
+        end
+      end
+    end
+
+    def join_account(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      if user.setup?
+        landing_url(script_name: @join_code.account.slug)
+      else
+        new_users_verification_url(script_name: @join_code.account.slug)
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
