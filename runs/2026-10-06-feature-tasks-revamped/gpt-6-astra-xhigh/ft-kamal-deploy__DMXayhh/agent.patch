+++ b/config/deploy.yml
@@ -0,0 +1,60 @@
+# Single-server, self-hosted Fizzy. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: your-dockerhub-user/fizzy
+
+servers:
+  web:
+    # Point this hostname directly at your server. Reused below for HTTPS and links.
+    - &hostname fizzy.example.com
+
+# Kamal Proxy obtains and renews the certificate; Thruster serves HTTP inside Docker.
+proxy:
+  ssl: true
+  host: *hostname
+  app_port: 80
+  healthcheck:
+    path: /up
+
+registry:
+  username: your-dockerhub-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+# All SQLite databases (including jobs, cache, and cable) and uploads live here.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Keep memory use modest on a single box; tune for your server as needed.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    APP_HOST: *hostname
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Optional browser push notifications (see docs/deployment.md):
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbconsole: app exec --interactive --reuse "bin/rails dbconsole"
