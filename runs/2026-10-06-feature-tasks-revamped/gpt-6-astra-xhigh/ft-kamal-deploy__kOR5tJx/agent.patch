--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,65 @@
+# Single-server deployment. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: fizzy
+minimum_version: 2.11.0
+
+servers:
+  web:
+    # Point this hostname at your server. The proxy and app reuse it below.
+    - &host fizzy.example.com
+
+# Kamal Proxy terminates TLS; Thruster serves HTTP inside the app container.
+proxy:
+  ssl: true
+  host: *host
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Kamal runs a local registry on the deployer's machine and tunnels it over SSH.
+# No external registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Change to arm64 for an ARM server.
+
+# SSH defaults to root. For another user, it must be able to run Docker.
+# ssh:
+#   user: deploy
+
+env:
+  clear:
+    RAILS_ENV: production
+    SAAS: "false"
+    APP_HOST: *host
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Conservative defaults for a small box; increase as resources allow.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    # Optional browser push notifications (see docs/deployment.md):
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# All SQLite databases and local uploads live here. Keep this volume across deploys.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep fingerprinted assets available during rolling deploys.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
