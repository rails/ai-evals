+module Account::StorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy :delete_storage_tracking
+  end
+
+  # Also used after bulk imports, which bypass attachment callbacks.
+  def reconcile_storage_later
+    Storage::Change.create!(account_id: id)
+  end
+
