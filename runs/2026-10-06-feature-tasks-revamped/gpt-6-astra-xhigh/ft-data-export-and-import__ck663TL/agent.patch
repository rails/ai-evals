+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "only administrators can export an account" do
+    sign_in_as :david
+    assert_no_difference "Account::Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+
+    logout_and_sign_in_as :jason
+    assert_enqueued_with(job: Account::ExportJob) do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+    assert_equal users(:jason), Account::Export.last.user
+  end
+
+  test "download is a private bearer link that expires after one day" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+    export.generate
+    token = export.download_token
+
+    get account_export_path(token)
+    assert_response :redirect
+    assert_equal "no-store", response.headers["Cache-Control"]
+
+    travel 24.hours + 1.second do
+      get account_export_path(token)
+      assert_response :not_found
+    end
+  end
+
+  test "download does not accept a record id or another account" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+    export.generate
+
+    get account_export_path(export)
+    assert_response :not_found
+    get account_export_path(export.download_token, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+end
