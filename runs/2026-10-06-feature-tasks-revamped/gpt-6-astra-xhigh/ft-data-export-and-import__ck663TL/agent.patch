--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,84 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "writer tracks the exact size and checksum of the ZIP" do
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("test.json", '{"hello":"world"}')
+    writer.close
+    assert_equal io.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), writer.checksum
+  end
+
+  test "reader handles empty compressed entries and chunked binary files" do
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("empty.jsonl", "")
+    writer.add_file("hello.json", '{"hello":"world"}')
+    writer.add_file("binary", "\xFF".b * 200_000, compress: false)
+    writer.close
+    reader = ZipFile::Reader.new(io)
+    assert_equal({ "hello" => "world" }, reader.read_json("hello.json"))
+    assert_equal "", reader.read("empty.jsonl", limit: 1)
+    reader.open_file("binary") { |file| assert_equal "\xFF".b * 200_000, file.read }
+  end
+
+  test "reader rejects traversal, duplicates, and corruption" do
+    [ [ "../outside" ], [ "same", "diff" ] ].each do |paths|
+      io = StringIO.new
+      writer = ZipFile::Writer.new(io)
+      paths.each { |path| writer.add_file(path, "data") }
+      writer.close
+      io.string.gsub!("diff", "same")
+      assert_raises(ArgumentError) { ZipFile::Reader.new(io) }
+    end
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("file", "contents", compress: false)
+    writer.close
+    io.string.sub!("contents", "corrupt!")
+    assert_raises(ArgumentError) { ZipFile::Reader.new(io).read("file", limit: 100) }
+  end
+end
+
+class ZipFileStorageTest < ActiveSupport::TestCase
+  test "S3 output streams a ZIP with correct metadata and can be read with ranges" do
+    service = ActiveStorage::Service.configure(:transfer_s3, {
+      transfer_s3: { service: "S3", bucket: "transfers", region: "us-east-1",
+        access_key_id: "test", secret_access_key: "test", stub_responses: true }
+    })
+    ActiveStorage::Blob.stubs(:service).returns(service)
+    ActiveStorage::Blob.services.stubs(:fetch).with(:transfer_s3).returns(service)
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(service)
+    stream = StringIO.new
+    service.expects(:upload_stream).yields(stream)
+    service.define_singleton_method(:download_chunk) { |key, range| stream.string.byteslice(range) }
+    service.expects(:download).never
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+
+    ZipFile.create_for(export.archive, filename: "account.zip") do |zip|
+      zip.add_file("hello.json", '{"hello":"world"}')
+    end
+
+    blob = export.archive.blob
+    assert_equal "transfer_s3", blob.service_name
+    assert_equal stream.string.bytesize, blob.byte_size
+    assert_equal Digest::MD5.base64digest(stream.string), blob.checksum
+    ZipFile::Reader.open(blob) { |reader| assert_equal({ "hello" => "world" }, reader.read_json("hello.json")) }
+  end
+
+  test "a failed disk export does not leave a blob" do
+    export = Account::Export.create!(account: accounts("37s"), user: users(:jason), kind: "account")
+    assert_no_difference "ActiveStorage::Blob.count" do
+      assert_raises(ArgumentError) do
+        ZipFile.create_for(export.archive, filename: "account.zip") do |zip|
+          zip.add_file("partial", "data")
+          raise ArgumentError, "failure"
+        end
+      end
+    end
+    assert_not export.archive.attached?
+  end
+end
