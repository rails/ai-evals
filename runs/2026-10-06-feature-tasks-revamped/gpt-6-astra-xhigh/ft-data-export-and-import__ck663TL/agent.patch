+class Account::ExportsController < ApplicationController
+  include ActiveStorage::SetCurrent
+
+  allow_unauthenticated_access only: :show
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Account::Export.create!(account: Current.account, user: Current.user, kind: "account")
+    export.generate_later
+    redirect_to account_settings_path, notice: "We'll email you a download link when your export is ready."
+  end
+
+  def show
+    export = Account::Export.find_signed(params[:id], purpose: :account_export)
+    if export && export.account == Current.account && export.downloadable?
+      expires_now
+      response.cache_control.replace(no_store: true)
+      redirect_to export.archive.url(expires_in: [ export.expires_at - Time.current, 5.minutes ].min,
+        disposition: :attachment), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+end
