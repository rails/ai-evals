@@ -0,0 +1,24 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+  layout "public"
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    # Accept an uploaded file, not someone else's Active Storage signed blob ID.
+    archive = params.expect(import: [ :archive ])[:archive]
+    unless archive.is_a?(ActionDispatch::Http::UploadedFile)
+      return head :unprocessable_entity
+    end
+
+    @import = Account::Import.new(identity: Current.identity, archive: archive)
+    if @import.save
+      @import.process_later
+      redirect_to new_account_import_path, notice: "We'll email you when your account import is complete."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
