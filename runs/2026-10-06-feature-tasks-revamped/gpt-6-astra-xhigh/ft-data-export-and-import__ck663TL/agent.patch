diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..219a951
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,74 @@
+# Reads ZIP64 archives through storage range requests. No extraction paths are ever
+# taken from the archive, and only one uncompressed file is spooled at a time.
+class ZipFile::Reader
+  JSON_LIMIT = 64.megabytes
+
+  def self.open(blob)
+    yield new(BlobIO.new(blob))
+  end
+
+  def initialize(io)
+    @io = io
+    entries = ZipKit::FileReader.read_zip_structure(io: io, read_local_headers: false)
+    @entries = entries.index_by(&:filename)
+    raise ArgumentError, "Duplicate ZIP entries" unless entries.size == @entries.size
+    raise ArgumentError, "Unsafe ZIP entry" if @entries.keys.any? { |path| path.start_with?("/", "\\") || path.split(/[\\\/]/).include?("..") }
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def read_json(path)
+    JSON.parse(read(path, limit: JSON_LIMIT))
+  end
+
+  def each_json(path)
+    open_file(path) do |file|
+      while line = file.gets(JSON_LIMIT + 1)
+        raise ArgumentError, "JSON record is too large" if line.bytesize > JSON_LIMIT
+        yield JSON.parse(line)
+      end
+    end
+  end
+
+  def read(path, limit:)
+    raise ArgumentError, "ZIP entry is too large" if entry(path).uncompressed_size > limit
+    data = +""
+    copy(path) { |chunk| data << chunk }
+    data
+  end
+
+  def open_file(path)
+    Tempfile.create([ "fizzy-import", ".data" ], binmode: true) do |file|
+      copy(path) { |chunk| file.write(chunk) }
+      file.rewind
+      yield file
+    end
+  end
+
+  private
+    def entry(path)
+      @entries.fetch(path) { raise ArgumentError, "Missing file in archive: #{path}" }
+    end
+
+    def copy(path)
+      entry = entry(path)
+      unless entry.known_offset?
+        entry.compressed_data_offset = ZipKit::FileReader.new.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+      end
+      extractor = entry.extractor_from(@io)
+      size = crc = 0
+      until extractor.eof?
+        chunk = extractor.extract(entry.storage_mode == 0 ? 8.megabytes : 64.kilobytes)
+        raise ArgumentError, "Truncated ZIP entry: #{path}" if chunk.nil? || (chunk.empty? && !extractor.eof?)
+        size += chunk.bytesize
+        crc = Zlib.crc32(chunk, crc)
+        raise ArgumentError, "Invalid ZIP entry size: #{path}" if size > entry.uncompressed_size
+        yield chunk
+      end
+      unless size == entry.uncompressed_size && crc == entry.crc32
+        raise ArgumentError, "Corrupt ZIP entry: #{path}"
+      end
+    end
+end
diff --git a/app/models/zip_file/reader/blob_io.rb b/app/models/zip_file/reader/blob_io.rb
new file mode 100644
index 0000000..ae9b6c4
--- /dev/null
+++ b/app/models/zip_file/reader/blob_io.rb
@@ -0,0 +1,31 @@
+class ZipFile::Reader::BlobIO
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(blob)
+    @blob, @size, @pos = blob, blob.byte_size, 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    @pos = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then pos + offset
+    when IO::SEEK_END then size + offset
+    end
+    raise ArgumentError, "Invalid ZIP offset" unless pos.between?(0, size)
+    0
+  end
+
+  def read(length = nil)
+    length = [ length || size - pos, size - pos ].min
+    if length.positive?
+      unless @buffer && pos >= @buffer_start && pos + length <= @buffer_start + @buffer.bytesize
+        @buffer_start = pos
+        @buffer = @blob.download_chunk(pos...[ pos + [ length, 8.megabytes ].max, size ].min)
+      end
+      @buffer.byteslice(pos - @buffer_start, length).tap { |data| @pos += data.bytesize }
+    else
+      ""
+    end
+  end
+end
