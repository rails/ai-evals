diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..aa10e1d
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,45 @@
+class Account::Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  validates :kind, inclusion: { in: %w[ account cards ] }
+  validate :requester_can_export
+
+  def self.cleanup
+    where(expires_at: ..Time.current).find_each(&:destroy!)
+  end
+
+  def generate_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def generate
+    with_lock do
+      unless status == "completed"
+        user.reload
+        raise ActiveRecord::RecordInvalid, self unless valid?
+        ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+          Account::DataTransfer::Exporter.new(self, zip).write
+        end
+        update!(status: "completed", expires_at: 1.day.from_now)
+      end
+    end
+    DataTransferMailer.export_ready(self).deliver_later
+  end
+
+  def download_token
+    signed_id(purpose: :account_export, expires_at: expires_at)
+  end
+
+  def downloadable?
+    status == "completed" && expires_at&.future? && archive.attached?
+  end
+
+  private
+    def requester_can_export
+      unless user && user.account == account && user.active? && (kind != "account" || user.admin?)
+        errors.add(:user, "cannot export this data")
+      end
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..b13388b
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,48 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :archive
+
+  validate :archive_is_zip, on: :create
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process
+    with_lock do
+      if status == "pending"
+        begin
+          # The savepoint includes identities, account data, and search indexes.
+          transaction(requires_new: true) do
+            ZipFile::Reader.open(archive.blob) do |zip|
+              Account::DataTransfer::Importer.new(self, zip).restore do |account|
+                update!(account: account, status: "completed")
+              end
+            end
+          end
+        rescue StandardError => exception
+          Rails.error.report(exception)
+          Rails.logger.error(exception.full_message)
+          update!(account: nil, status: "failed", error: failure_reason(exception))
+        end
+      end
+    end
+    archive.purge if archive.attached?
+    DataTransferMailer.import_finished(self).deliver_later
+  end
+
+  private
+    def archive_is_zip
+      errors.add(:archive, "must be a ZIP file") unless archive.attached? && archive.filename.extension.to_s.downcase == "zip"
+    end
+
+    def failure_reason(exception)
+      case exception
+      when ArgumentError, JSON::ParserError, KeyError, ActiveRecord::RecordInvalid
+        exception.message.truncate(1000)
+      else
+        "The archive could not be restored. It may be damaged or incompatible with this version of Fizzy."
+      end
+    end
+end
