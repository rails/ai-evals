@@ -0,0 +1,15 @@
+module Account::DataTransfer
+  VERSION = 1
+
+  # An explicit allowlist: never transfer credentials, sessions, push endpoints,
+  # webhooks (which would send real traffic), or other imports/exports.
+  MODELS = [ User, Board, Board::Publication, Column, Card, Comment, Access, Tag, Tagging, Assignment,
+    Closure, Card::Goldness, Card::NotNow, Card::ActivitySpike, Step, Watch, Pin,
+    Reaction, Mention, Event, Notification, Filter, Entropy, User::Settings, ::ActionText::RichText ].freeze
+
+  FILTER_RESOURCES = %w[ tags boards assignees creators closers ].freeze
+
+  def self.path(model)
+    "records/#{model.table_name}.jsonl"
+  end
+end
diff --git a/app/models/account/data_transfer/exporter.rb b/app/models/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..8c015d4
--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,119 @@
+class Account::DataTransfer::Exporter
+  def initialize(export, zip)
+    @export, @zip = export, zip
+    @account = export.account
+  end
+
+  def write
+    @zip.add_file "manifest.json", { version: Account::DataTransfer::VERSION, kind: @export.kind,
+      account: @account.attributes.slice("id", "name", "created_at", "cards_count") }.to_json
+
+    if @export.kind == "account"
+      write_records
+      write_attachments(::ActiveStorage::Attachment.where(account: @account, record_type: Account::DataTransfer::MODELS.map(&:name)))
+    else
+      write_attachments(card_attachments)
+    end
+    write_cards
+  end
+
+  private
+    def cards
+      if @export.kind == "account"
+        @account.cards
+      else
+        @export.user.accessible_cards.where(account: @account)
+      end
+    end
+
+    def write_records
+      Account::DataTransfer::Manifest.new(@account).each_record_set do |record_set|
+        model = record_set.model
+        next unless model.in?(Account::DataTransfer::MODELS)
+        @zip.add_file(Account::DataTransfer.path(model)) do |sink|
+          record_set.each_record do |record|
+            attributes = record.attributes.except("account_id")
+            case record
+            when User
+              attributes.except!("identity_id")
+              attributes["email_address"] = record.identity&.email_address
+            when Board::Publication
+              attributes.except!("key")
+            when Filter
+              attributes["resources"] = Account::DataTransfer::FILTER_RESOURCES.index_with { |name| record.association(name).scope.ids }
+            when ::ActionText::RichText
+              attributes["body"] = portable_body(record)
+            end
+            sink.write(attributes.to_json << "\n")
+          end
+        end
+      end
+    end
+
+    def portable_body(rich_text)
+      fragment = Nokogiri::HTML5.fragment(rich_text.body&.to_html.to_s)
+      fragment.css("action-text-attachment[sgid]").each do |node|
+        attachable = ::ActionText::Attachable.from_attachable_sgid(node["sgid"])
+        case attachable
+        when ::ActiveStorage::Blob
+          node["data-fizzy-blob-id"] = attachable.id
+          node["url"] = "files/#{attachable.id}"
+        when User
+          node["data-fizzy-user-id"] = attachable.id
+        else
+          raise ArgumentError, "Unsupported rich text attachment"
+        end
+        node.remove_attribute("sgid")
+      end
+      fragment.to_html
+    end
+
+    def write_cards
+      cards.find_each do |card|
+        @zip.add_file("cards/#{card.id}.json") do |sink|
+          attributes = card.attributes.except("account_id").merge("description" => portable_body(card.description), "attachments" => attachment_details(card),
+            "board" => card.board.name, "creator" => card.creator.name)
+          sink.write(attributes.to_json.delete_suffix("}"))
+          sink.write(',"comments":[')
+          first = true
+          card.comments.find_each do |comment|
+            sink.write(",") unless first
+            first = false
+            sink.write(comment.attributes.except("account_id").merge("body" => portable_body(comment.body), "attachments" => attachment_details(comment), "creator" => comment.creator.name).to_json)
+          end
+          sink.write("]}")
+        end
+      end
+    end
+
+    def attachment_details(record)
+      attachments = record.attachments.to_a
+      attachments << record.image.attachment if record.is_a?(Card) && record.image.attached?
+      attachments.map do |attachment|
+        { filename: attachment.filename.to_s, content_type: attachment.content_type,
+          path: "files/#{attachment.blob_id}", byte_size: attachment.byte_size }
+      end
+    end
+
+    def card_attachments
+      texts = ::ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id))
+        .or(::ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card: cards).select(:id)))
+      ::ActiveStorage::Attachment.where(account: @account, record_type: "Card", record_id: cards.select(:id))
+        .or(::ActiveStorage::Attachment.where(account: @account, record_type: "ActionText::RichText", record_id: texts.select(:id)))
+    end
+
+    def write_attachments(attachments)
+      @zip.add_file("attachments.jsonl") do |sink|
+        attachments.find_each { |attachment| sink.write(attachment.attributes.except("account_id").to_json << "\n") }
+      end
+      blobs = ::ActiveStorage::Blob.where(id: attachments.select(:blob_id))
+      @zip.add_file("blobs.jsonl") do |sink|
+        blobs.find_each do |blob|
+          sink.write(blob.attributes.slice("id", "filename", "content_type", "byte_size", "checksum", "metadata", "created_at").to_json << "\n")
+        end
+      end
+      blobs.find_each do |blob|
+        @zip.add_file("files/#{blob.id}", compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..c896781
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,212 @@
+class Account::DataTransfer::Importer
+  POLYMORPHIC_TYPES = {
+    "Entropy" => %w[ Account Board ],
+    "ActionText::RichText" => %w[ Card Comment Board ],
+    "Reaction" => %w[ Card Comment ],
+    "Mention" => %w[ Card Comment ],
+    "Event" => %w[ Card Comment ],
+    "Notification" => %w[ Event Mention ]
+  }.freeze
+
+  def initialize(import, zip)
+    @import, @zip = import, zip
+    @ids = {}
+    @uploaded_blobs = []
+  end
+
+  def restore
+    manifest = @zip.read_json("manifest.json")
+    unless manifest["version"] == Account::DataTransfer::VERSION && manifest["kind"] == "account"
+      raise ArgumentError, "Choose a complete Fizzy account export (version #{Account::DataTransfer::VERSION})"
+    end
+
+    Account.transaction do
+      source = manifest.fetch("account")
+      @card_count = Integer(source.fetch("cards_count"))
+      @account = Account.create!(name: source.fetch("name"), created_at: source.fetch("created_at"))
+      @account.entropies.delete_all
+      register_id(Account, manifest.fetch("account").fetch("id"), @account.id)
+      Current.with(account: @account, user: nil) do
+        prepare_ids
+        restore_people
+        restore_blobs
+        restore_records
+        restore_attachments
+        finish_account
+      end
+      yield @account if block_given?
+      @account
+    end
+  rescue Exception
+    # Database rollback cannot undo object-storage writes. Keep the generated
+    # keys separately so they can be removed even after their rows roll back.
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+    raise
+  end
+
+  private
+    def prepare_ids
+      Account::DataTransfer::MODELS.each do |model|
+        @zip.each_json(Account::DataTransfer.path(model)) { |row| register_id(model, row.fetch("id")) }
+      end
+      @zip.each_json("blobs.jsonl") { |row| register_id(::ActiveStorage::Blob, row.fetch("id")) }
+    end
+
+    def register_id(model, old_id, new_id = ActiveRecord::Type::Uuid.generate)
+      raise ArgumentError, "Invalid record ID" unless old_id.is_a?(String) && old_id.match?(/\A[0-9a-z]{25}\z/)
+      key = [ model.name, old_id ]
+      raise ArgumentError, "Duplicate #{model.name} record" if @ids.key?(key)
+      @ids[key] = new_id
+    end
+
+    def mapped_id(model, old_id)
+      @ids.fetch([ model.name, old_id ]) { raise ArgumentError, "Missing #{model.name} reference: #{old_id}" }
+    end
+
+    def restore_people
+      @zip.each_json(Account::DataTransfer.path(User)) do |row|
+        attributes = remap(User, row.except("email_address", "identity_id"))
+        if row["email_address"].present? && attributes["role"] != "system" && attributes["active"]
+          email = row["email_address"].strip.downcase
+          identity = Identity.find_by(email_address: email) || Identity.create!(email_address: email)
+          attributes["identity_id"] = identity.id
+          attributes["role"] = "owner" if identity == @import.identity
+        end
+        User.insert_all!([ attributes ])
+      end
+    end
+
+    def restore_blobs
+      @zip.each_json("blobs.jsonl") do |row|
+        @zip.open_file("files/#{row.fetch("id")}") do |file|
+          blob = ::ActiveStorage::Blob.build_after_unfurling(io: file, filename: row.fetch("filename"),
+            content_type: row["content_type"], identify: false)
+          unless blob.byte_size == row.fetch("byte_size") && (row["checksum"].nil? || blob.checksum == row["checksum"])
+            raise ArgumentError, "Attachment checksum mismatch: #{row.fetch('filename')}"
+          end
+          blob.id = mapped_id(::ActiveStorage::Blob, row.fetch("id"))
+          blob.account = @account
+          blob.created_at = row["created_at"] if row["created_at"]
+          blob.save!
+          @uploaded_blobs << blob
+          file.rewind
+          blob.upload_without_unfurling(file)
+        end
+      end
+    end
+
+    def restore_records
+      Account::DataTransfer::MODELS.excluding(User).each do |model|
+        @zip.each_json(Account::DataTransfer.path(model)) do |row|
+          attributes = remap(model, row.except("resources"))
+          if model == ::ActionText::RichText
+            names = { "Card" => "description", "Comment" => "body", "Board" => "public_description" }
+            raise ArgumentError, "Unsupported rich text field" unless row["name"] == names[row["record_type"]]
+            attributes["body"] = restore_body(row["body"])
+          end
+          attributes["key"] = SecureRandom.base58(24) if model == Board::Publication
+          if model == Event && attributes.dig("particulars", "assignee_ids")
+            attributes["particulars"]["assignee_ids"] = attributes["particulars"]["assignee_ids"].map { |id| mapped_id(User, id) }
+          end
+          if model == Filter
+            { "card_ids" => Card, "column_ids" => Column }.each do |key, target|
+              if attributes["fields"][key]
+                attributes["fields"][key] = attributes["fields"][key].filter_map { |id| @ids[[ target.name, id ]] }
+              end
+            end
+          end
+          model.insert_all!([ attributes ])
+          restore_filter_resources(Filter.find(attributes.fetch("id")), row.fetch("resources")) if model == Filter
+        end
+      end
+    end
+
+    def restore_filter_resources(filter, resources)
+      Account::DataTransfer::FILTER_RESOURCES.each do |name|
+        model = Filter.reflect_on_association(name).klass
+        filter.public_send("#{name.singularize}_ids=", resources.fetch(name).map { |id| mapped_id(model, id) })
+      end
+      filter.update_column(:params_digest, Filter.digest_params(filter.as_params))
+    end
+
+    def remap(model, row)
+      unknown = row.keys - model.column_names
+      raise ArgumentError, "Unknown #{model.name} attributes: #{unknown.join(', ')}" if unknown.any?
+      attributes = row.except("account_id").merge("id" => mapped_id(model, row.fetch("id")), "account_id" => @account.id)
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        next if association.name.in?([ :account, :identity ])
+        key = association.foreign_key
+        if attributes[key].present?
+          target = if association.polymorphic?
+            type = attributes.fetch(association.foreign_type)
+            unless type.in?(POLYMORPHIC_TYPES.fetch(model.name))
+              raise ArgumentError, "Unsupported #{model.name} reference: #{type}"
+            end
+            allowed_model(type)
+          else
+            association.klass
+          end
+          attributes[key] = mapped_id(target, attributes[key])
+        end
+      end
+      attributes
+    end
+
+    def allowed_model(name)
+      ([ Account, ::ActiveStorage::Blob ] + Account::DataTransfer::MODELS).find { |model| model.name == name } ||
+        raise(ArgumentError, "Unsupported record type: #{name}")
+    end
+
+    def restore_body(html)
+      fragment = Nokogiri::HTML5.fragment(html.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        if id = node.delete("data-fizzy-blob-id")&.value
+          blob = ::ActiveStorage::Blob.find(mapped_id(::ActiveStorage::Blob, id))
+          node["sgid"] = blob.attachable_sgid
+          node["url"] = Rails.application.routes.url_helpers.rails_blob_path(blob, only_path: true, script_name: @account.slug)
+        elsif id = node.delete("data-fizzy-user-id")&.value
+          node["sgid"] = User.find(mapped_id(User, id)).attachable_sgid
+        elsif node["sgid"].present?
+          raise ArgumentError, "Non-portable rich text attachment"
+        end
+      end
+      fragment.to_html
+    end
+
+    def restore_attachments
+      @zip.each_json("attachments.jsonl") do |row|
+        model = allowed_model(row.fetch("record_type"))
+        names = { "Card" => [ "image" ], "User" => [ "avatar" ], "ActionText::RichText" => [ "embeds" ] }
+        unless row.fetch("name").in?(names.fetch(model.name, []))
+          raise ArgumentError, "Unsupported attachment"
+        end
+        attributes = row.slice("name", "record_type", "created_at").merge(
+          "id" => ActiveRecord::Type::Uuid.generate, "account_id" => @account.id,
+          "record_id" => mapped_id(model, row.fetch("record_id")),
+          "blob_id" => mapped_id(::ActiveStorage::Blob, row.fetch("blob_id")))
+        ::ActiveStorage::Attachment.insert_all!([ attributes ])
+      end
+    end
+
+    def finish_account
+      owner = @account.users.find_by(identity: @import.identity) ||
+        @account.users.create!(identity: @import.identity, name: @import.identity.email_address, role: :owner, verified_at: Time.current)
+      owner.update_columns(role: "owner", active: true)
+      @account.users.create!(name: "System", role: :system) unless @account.users.exists?(role: :system)
+      @account.users.where.not(role: :system).find_each do |user|
+        user.create_settings! unless user.settings
+      end
+      @account.boards.find_each do |board|
+        board.accesses.find_or_create_by!(user: owner)
+      end
+      @account.update!(cards_count: [ @card_count, @account.cards.maximum(:number) || 0 ].max)
+      @account.cards.find_each(&:reindex)
+      Comment.where(account: @account).find_each(&:reindex)
+      ::ActiveStorage::Attachment.where(account: @account).find_each do |attachment|
+        if record = attachment.record.try(:storage_tracked_record)
+          Storage::Entry.record(account: @account, board: record.board_for_storage_tracking,
+            recordable: record, blob: attachment.blob, delta: attachment.blob.byte_size, operation: "attach")
+        end
+      end
+    end
+end
