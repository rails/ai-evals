+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key" }
+  end
+
+  test "registers the current user's device" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    end
+
+    assert_response :created
+    assert_equal @subscription.stringify_keys, @user.push_subscriptions.last.attributes.slice(*@subscription.keys.map(&:to_s))
+    assert_equal @user.account, @user.push_subscriptions.last.account
+  end
+
+  test "registering a device again refreshes its keys without duplicating it" do
+    2.times do |index|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "key-#{index}") }, as: :json
+      assert_response :created
+    end
+
+    assert_equal 1, @user.push_subscriptions.where(endpoint: @subscription[:endpoint]).count
+    assert_equal "key-1", @user.push_subscriptions.find_by!(endpoint: @subscription[:endpoint]).auth_key
+  end
+
+  test "cannot register for another user, even as an admin" do
+    logout_and_sign_in_as users(:kevin)
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+    assert_response :forbidden
+  end
+
+  test "cannot register for another account" do
+    post user_push_subscriptions_path(users(:mike)), params: { push_subscription: @subscription }, as: :json
+    assert_response :not_found
+  end
+
+  test "rejects incomplete subscriptions" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(:auth_key) }, as: :json
+    assert_response :unprocessable_entity
+  end
+  test "turning off a device does not affect other devices" do
+    device = @user.push_subscriptions.create!(@subscription)
+    other = @user.push_subscriptions.create!(@subscription.merge(endpoint: "https://push.example.com/other"))
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, device), as: :json
+    end
+    assert_response :no_content
+    assert other.reload.persisted?
+  end
+
+  test "cannot delete another user's device" do
+    device = users(:kevin).push_subscriptions.create!(@subscription)
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@user, device), as: :json
+    end
+    assert_response :not_found
+  end
+
+  test "ignores attempted ownership changes" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @subscription.merge(user_id: users(:kevin).id, account_id: accounts(:initech).id)
+    }, as: :json
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.last.account
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..3356520
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "public-key", auth_key: "auth-key")
+  end
+
+  test "new notifications push to every subscribed device" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/desktop", p256dh_key: "other-public-key", auth_key: "other-auth-key")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing notification pushes, but reading and unreading do not" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_jobs 1, only: Notification::PushJob do
+      notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+      notification.touch
+    end
+  end
+
+  test "no jobs without subscriptions or VAPID configuration" do
+    @subscription.destroy!
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "key")
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+
+  test "event payload uses tray text and account-scoped comment link" do
+    notification = notifications(:layout_commented_kevin)
+    notification.push_later
+
+    payload = JSON.parse(push_jobs.last[:args].last)
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}#comment_#{notification.source.eventable.id}", payload.dig("data", "url")
+    assert_equal "notification_#{notification.id}", payload["tag"]
+  end
+
+  test "mention payload uses tray text and keeps its snapshot after further activity" do
+    notification = notifications(:logo_assignment_kevin)
+    mention = mentions(:logo_card_david_mention_by_jz)
+    notification.update!(source: mention)
+    payload = JSON.parse(push_jobs.last[:args].last)
+
+    notification.update!(source: events(:logo_assignment_km))
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload.dig("data", "url")
+  end
+
+  test "jobs deliver the saved payload and recipient credentials" do
+    notification = notifications(:layout_commented_kevin)
+    PushSubscription::Request.expects(:new).with do |**options|
+      options[:subscription][:endpoint] == @subscription.endpoint && options[:subscription][:keys][:p256dh] == @subscription.p256dh_key &&
+        options[:subscription][:keys][:auth] == @subscription.auth_key && JSON.parse(options[:message])["body"].present?
+    end.returns(stub(perform: true))
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification.push_later
+    end
+  end
+
+  test "queued pushes do not leak content after access is revoked or the recipient deactivated" do
+    notification = notifications(:layout_commented_kevin)
+    PushSubscription::Request.expects(:new).never
+
+    @user.accesses.where(board: notification.card.board).delete_all
+    notification.push_now(@subscription, "payload")
+
+    @user.update!(active: false)
+    notifications(:logo_assignment_kevin).push_now(@subscription, "payload")
+  end
+
+  test "removed notifications and devices are discarded by queued jobs" do
+    notification = notifications(:layout_commented_kevin)
+    notification.push_later
+    @subscription.destroy!
+    PushSubscription::Request.expects(:new).never
+    perform_enqueued_jobs only: Notification::PushJob
+
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "key")
+    notification.push_later
+    notification.destroy!
+    perform_enqueued_jobs only: Notification::PushJob
+  end
+
+  private
+    def push_jobs
+      enqueued_jobs.select { |job| job[:job] == Notification::PushJob }
+    end
+end
diff --git a/test/models/push_subscription/request_test.rb b/test/models/push_subscription/request_test.rb
new file mode 100644
index 0000000..0578d40
--- /dev/null
+++ b/test/models/push_subscription/request_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    @key = WebPush.generate_key
+    @request = PushSubscription::Request.new(
+      message: "test notification",
+      subscription: { endpoint: "https://push.example.com/device", keys: { p256dh: @key.public_key, auth: Base64.urlsafe_encode64("a" * 16) } },
+      vapid: { public_key: @key.public_key, private_key: @key.private_key, subject: "mailto:test@example.com" }
+    )
+  end
+
+  test "sends an encrypted payload with VAPID authorization over a pinned public connection" do
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, "https://push.example.com/device").with do |request|
+      request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.headers["Authorization"].start_with?("vapid ") &&
+        !request.body.include?("test notification")
+    end.to_return(status: 201)
+
+    assert_equal "201", @request.perform.code
+    assert_requested request
+  end
+
+  test "blocks endpoints that resolve to private addresses" do
+    stub_dns_resolution("127.0.0.1", "169.254.169.254", "192.168.0.1")
+    Net::HTTP.expects(:new).never
+    assert_raises PushSubscription::Request::BlockedEndpoint do
+      @request.perform
+    end
+  end
+
+  test "pins the checked address to prevent DNS rebinding" do
+    stub_dns_resolution("93.184.216.34")
+    http = mock
+    Net::HTTP.expects(:new).with("push.example.com", 443, nil).returns(http)
+    http.expects(:ipaddr=).with("93.184.216.34")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(5)
+    http.expects(:read_timeout=).with(5)
+    http.expects(:request).returns(Net::HTTPCreated.new("1.1", "201", "Created"))
+    @request.perform
+  end
+
+  test "preserves push service error classification" do
+    stub_dns_resolution("93.184.216.34")
+    { 404 => WebPush::InvalidSubscription, 410 => WebPush::ExpiredSubscription, 429 => WebPush::TooManyRequests, 503 => WebPush::PushServiceError }.each do |status, error|
+      stub_request(:post, "https://push.example.com/device").to_return(status: status)
+      assert_raises(error) { @request.perform }
+    end
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..de2fd57
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "public-key", auth_key: "auth-key")
+  end
+
+  test "sends with the configured VAPID keys" do
+    PushSubscription::Request.expects(:new).with(
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "public-key", auth: "auth-key" } },
+      message: "payload",
+      vapid: Rails.configuration.x.web_push.to_h
+    ).returns(stub(perform: true))
+    @subscription.push("payload")
+  end
+
+  test "expired and invalid subscriptions are removed" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error_class|
+      subscription = users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/#{error_class.name}", p256dh_key: "key", auth_key: "key")
+      PushSubscription::Request.stubs(:new).raises(error_class.new(stub(body: "gone"), "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push("payload")
+      end
+      assert subscription.destroyed?
+    end
+  end
+
+  test "temporary failures do not remove subscriptions" do
+    error = WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.com")
+    PushSubscription::Request.stubs(:new).raises(error)
+
+    assert_raises WebPush::PushServiceError do
+      @subscription.push("payload")
+    end
+    assert @subscription.reload.persisted?
+  end
+
+  test "endpoints must be HTTPS URLs without embedded credentials" do
+    [ "", "not a URL", "http://push.example.com/device", "https://user:password@push.example.com/device" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, endpoint
+    end
+  end
+
+  test "endpoint uniqueness is case-sensitive and scoped to the user" do
+    subscription = @subscription.user.push_subscriptions.register(endpoint: "https://push.example.com/PHONE", p256dh_key: "key", auth_key: "key")
+    assert_not_equal @subscription, subscription
+
+    other = users(:david).push_subscriptions.register(@subscription.attributes.slice("endpoint", "p256dh_key", "auth_key").symbolize_keys)
+    assert_equal @subscription.endpoint, other.endpoint
+    assert_not_equal @subscription.user, other.user
+  end
+end
diff --git a/test/system/push_notifications_test.rb b/test/system/push_notifications_test.rb
new file mode 100644
index 0000000..0cd49af
--- /dev/null
+++ b/test/system/push_notifications_test.rb
@@ -0,0 +1,81 @@
+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    Rails.configuration.x.web_push.stubs(:public_key).returns("AQID-v8")
+    sign_in_as users(:david)
+    visit notifications_settings_path
+    assert_button "Turn on notifications", disabled: false
+  end
+
+  test "opting in and out only changes this device" do
+    other = users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/other", p256dh_key: "key", auth_key: "key")
+    simulate_push_service
+
+    click_on "Turn on notifications"
+    assert_text "Push notifications are on for this device."
+    assert_equal "device-key", users(:david).push_subscriptions.find_by!(endpoint: "https://push.example.com/device").p256dh_key
+    assert_equal 1, page.evaluate_script("window.permissionRequests")
+    assert_equal [ 1, 2, 3, 250, 255 ], page.evaluate_script("Array.from(window.subscriptionOptions.applicationServerKey)")
+
+    click_on "Turn off notifications"
+    assert_text "Push notifications are off for this device."
+    assert_equal [ other ], users(:david).push_subscriptions.to_a
+  end
+
+  test "blocked notifications show browser help without registering a device" do
+    simulate_push_service(permission: "denied")
+    click_on "Turn on notifications"
+
+    assert_text "Push notifications are off for this device."
+    assert_selector '[data-notifications-target="help"]', visible: true
+    assert_empty users(:david).push_subscriptions
+  end
+
+  test "failed saves stay off and can be retried" do
+    simulate_push_service
+    PushSubscription.stubs(:register).raises(ActiveRecord::RecordInvalid.new(PushSubscription.new))
+    click_on "Turn on notifications"
+
+    assert_text "Couldn't turn on notifications. Please try again."
+    assert_text "Push notifications are off for this device."
+    assert_button "Turn on notifications", disabled: false
+  end
+
+  test "an existing browser subscription does not opt in another account automatically" do
+    simulate_push_service(existing: true)
+    assert_text "Push notifications are off for this device."
+    assert_equal 0, page.evaluate_script("window.permissionRequests")
+    assert_empty users(:david).push_subscriptions
+
+    click_on "Turn on notifications"
+    assert_text "Push notifications are on for this device."
+    assert_nil page.evaluate_script("window.subscriptionOptions")
+  end
+
+  private
+    def simulate_push_service(permission: "granted", existing: false)
+      page.execute_script <<~JS
+        window.permissionRequests = 0
+        window.subscriptionOptions = null
+        window.deviceSubscription = {
+          endpoint: "https://push.example.com/device",
+          toJSON: () => ({ endpoint: "https://push.example.com/device", keys: { p256dh: "device-key", auth: "auth-key" } })
+        }
+        Object.defineProperty(Notification, "permission", { configurable: true, get: () => window.pushPermission || "default" })
+        Notification.requestPermission = async () => {
+          window.permissionRequests++
+          window.pushPermission = #{permission.to_json}
+          return window.pushPermission
+        }
+        PushManager.prototype.getSubscription = async () => #{existing ? "window.deviceSubscription" : "null"}
+        PushManager.prototype.subscribe = async options => {
+          window.subscriptionOptions = options
+          return window.deviceSubscription
+        }
+        const element = document.querySelector('[data-controller="notifications"]')
+        window.Stimulus.getControllerForElementAndIdentifier(element, "notifications").connect()
+      JS
+    end
+end
