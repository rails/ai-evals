--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,29 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.register(push_subscription_params)
+    render json: { id: subscription.id }, status: :created
+  rescue ActiveRecord::RecordInvalid => error
+    render json: { errors: error.record.errors.full_messages }, status: :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b3c2662
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,99 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "enable", "disable", "help", "unsupported", "error" ]
+  static values = { url: String, publicKey: String, subscriptions: Object }
+
+  async connect() {
+    if (!this.#supported) {
+      this.enableTarget.hidden = true
+      this.unsupportedTarget.hidden = false
+      this.helpTarget.hidden = false
+      return
+    }
+
+    try {
+      this.registration = await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+      this.subscription = await this.registration.pushManager.getSubscription()
+      this.subscriptionId = this.subscriptionsValue[this.subscription?.endpoint]
+      this.#render()
+    } catch {
+      this.#showError("Couldn't check notification settings. Please try reloading the page.")
+    }
+  }
+
+  async enable() {
+    this.enableTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      // Request permission directly from the click, before waiting for the worker (required on iOS).
+      const permission = await Notification.requestPermission()
+      if (permission === "granted") {
+        const registration = await navigator.serviceWorker.ready
+        this.subscription = await registration.pushManager.getSubscription() || await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+        const { endpoint, keys } = this.subscription.toJSON()
+        const response = await post(this.urlValue, {
+          body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+          responseKind: "json"
+        })
+        if (!response.ok) throw new Error("Subscription could not be saved")
+
+        this.subscriptionId = (await response.json).id
+        this.subscriptionsValue = { ...this.subscriptionsValue, [endpoint]: this.subscriptionId }
+      }
+    } catch {
+      this.#showError("Couldn't turn on notifications. Please try again.")
+    } finally {
+      this.#render()
+    }
+  }
+
+  async disable() {
+    this.disableTarget.disabled = true
+    this.errorTarget.hidden = true
+
+    try {
+      const response = await destroy(`${this.urlValue}/${this.subscriptionId}`, { responseKind: "json" })
+      if (!response.ok && response.statusCode !== 404) throw new Error("Subscription could not be removed")
+
+      // Keep the browser subscription: another account may still use this device.
+      const subscriptions = { ...this.subscriptionsValue }
+      delete subscriptions[this.subscription.endpoint]
+      this.subscriptionsValue = subscriptions
+      this.subscriptionId = null
+    } catch {
+      this.#showError("Couldn't turn off notifications. Please try again.")
+    } finally {
+      this.#render()
+    }
+  }
+
+  #render() {
+    const enabled = Notification.permission === "granted" && !!this.subscriptionId
+    this.element.classList.toggle("notifications--on", enabled)
+    this.enableTarget.disabled = false
+    this.disableTarget.disabled = false
+    this.helpTarget.hidden = Notification.permission !== "denied"
+  }
+
+  #showError(message) {
+    this.errorTarget.textContent = message
+    this.errorTarget.hidden = false
+  }
+
+  get #supported() {
+    return window.isSecureContext && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
