diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..fd6c647
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,30 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured? && user.push_subscriptions.exists?
+      # Capture the text now: later activity can replace this notification's source.
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription, payload)
+      end
+    end
+  end
+
+  def push_now(subscription, payload)
+    if PushSubscription.configured? && user.active? && user.boards.exists?(id: card.board_id) && subscription.user_id == user_id
+      subscription.push(payload)
+    end
+  end
+
+  private
+    def push_payload
+      ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "notifications/push", formats: [ :json ], locals: { notification: self }
+      )
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..2d10db9
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,45 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :endpoint_is_https
+
+  class << self
+    def configured?
+      Rails.configuration.x.web_push.public_key.present? && Rails.configuration.x.web_push.private_key.present?
+    end
+
+    def register(attributes)
+      create_or_find_by!(endpoint: attributes[:endpoint]) do |subscription|
+        subscription.assign_attributes(attributes)
+      end.tap { |subscription| subscription.update!(attributes) }
+    end
+  end
+
+  def push(payload)
+    Request.new(
+      subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+      message: payload,
+      vapid: Rails.configuration.x.web_push.to_h
+    ).perform
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint) if endpoint.present?
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..5f2ddaa
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+# Keep WebPush's encryption and response handling, but pin the connection to a
+# public address just like webhook delivery. Endpoints are supplied by clients.
+class PushSubscription::Request < WebPush::Request
+  class BlockedEndpoint < StandardError; end
+
+  def perform
+    ip = SsrfProtection.resolve_public_ip(uri.host)
+    raise BlockedEndpoint unless ip
+
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    http.ipaddr = ip
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
