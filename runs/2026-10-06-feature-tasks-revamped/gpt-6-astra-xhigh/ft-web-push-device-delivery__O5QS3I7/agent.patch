+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError, PushSubscription::Request::BlockedEndpoint
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError, Net::OpenTimeout, Net::ReadTimeout, Resolv::ResolvTimeout, Resolv::ResolvError, SocketError,
+    wait: :polynomially_longer, attempts: 5
+
+  def perform(notification, subscription, payload)
+    notification.push_now(subscription, payload)
+  end
+end
