diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..3bedcae
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      assert_difference -> { Account.count }, -1 do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerates all data associated with due accounts" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(account: @account.id)
+    assert_empty Board.where(account: @account.id)
+    assert_empty Card.where(account: @account.id)
+    assert_empty Column.where(account: @account.id)
+    assert_empty Comment.where(account: @account.id)
+    assert_empty Event.where(account: @account.id)
+    assert_empty Notification.where(account: @account.id)
+    assert_empty Tag.where(account: @account.id)
+    assert_empty Webhook.where(account: @account.id)
+    assert_empty Account::Cancellation.where(account: @account.id)
+  end
+
+  test "does not incinerate accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 29.days do
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "does not incinerate reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      @account.reactivate
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert Account.exists?(@account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..782ea91
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled over 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration excludes accounts cancelled exactly 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    travel 30.days do
+      assert_not_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration excludes recently cancelled accounts" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+
+    travel 31.days do
+      @account.reactivate
+
+      assert_not_includes Account.due_for_incineration, @account.reload
+    end
+  end
+end
