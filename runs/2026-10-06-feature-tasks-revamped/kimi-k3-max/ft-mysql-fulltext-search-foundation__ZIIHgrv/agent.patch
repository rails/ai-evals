+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    cards = if @query.present?
+      Current.user.accessible_cards.search(@query)
+    else
+      Current.user.accessible_cards.none
+    end
+
+    set_page_and_extract_portion_from cards.includes(:board, :rich_text_description, comments: :rich_text_body)
+  end
+end
