+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds published cards by title" do
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_not_includes Card.search("logo"), cards(:layout)
+  end
+
+  test "matching is case insensitive" do
+    assert_includes Card.search("LOGO"), cards(:logo)
+  end
+
+  test "finds cards by description" do
+    cards(:shipping).update! description: "We must get the shipment out the door"
+
+    assert_includes Card.search("shipment"), cards(:shipping)
+    assert_not_includes Card.search("shipment"), cards(:logo)
+  end
+
+  test "finds cards by the body of any comment" do
+    cards(:layout).comments.create! creator: users(:david), body: "Fixed by bumping the ziggurat index"
+
+    assert_includes Card.search("ziggurat"), cards(:layout)
+    assert_not_includes Card.search("ziggurat"), cards(:logo)
+  end
+
+  test "orders results newest first" do
+    cards(:logo).update! title: "Umbrella logo", created_at: 2.days.ago
+    cards(:layout).update! title: "Umbrella layout", created_at: 1.day.ago
+
+    assert_equal [ cards(:layout), cards(:logo) ], Card.search("Umbrella").to_a
+  end
+
+  test "does not find drafted cards by title or description" do
+    cards(:unfinished_thoughts).update! title: "Zebra stripes", description: "A draft about zebras"
+
+    assert_empty Card.search("Zebra")
+  end
+
+  test "comments on drafted cards never turn up" do
+    card = cards(:logo)
+    card.comments.create! creator: users(:david), body: "Drafty mccommentson"
+    card.update_column :status, "drafted"
+
+    assert_empty Card.search("mccommentson")
+  end
+
+  test "escapes LIKE wildcards in the query" do
+    assert_empty Card.search("100%")
+    assert_includes Card.search("logo isn't"), cards(:logo)
+  end
+
+  test "strips surrounding whitespace from the query" do
+    assert_includes Card.search("  logo  "), cards(:logo)
+  end
+end
