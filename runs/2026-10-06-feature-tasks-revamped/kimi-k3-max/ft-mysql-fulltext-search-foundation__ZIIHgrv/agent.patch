diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..3a2b58a
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,27 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…", class: "input full-width", autofocus: true, autocomplete: "off", aria: { label: "Search cards and comments" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <div class="txt-align-start">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "card", collection: @page.records %>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards found for “<%= @query %>”</div>
+    <% end %>
+  <% end %>
+</section>
