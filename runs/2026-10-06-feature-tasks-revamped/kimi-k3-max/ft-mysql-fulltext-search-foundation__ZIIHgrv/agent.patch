diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..5f2ae61
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,129 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:david)
+    sign_in_as :david
+  end
+
+  test "show renders the search page" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?][method=get]", search_path
+    assert_select "input[type=search][name=q]"
+  end
+
+  test "finds cards by title and highlights the match" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "article", /The .* isn't big enough/ do
+      assert_select "a[href=?]", card_path(cards(:logo))
+      assert_select "mark", text: "logo", count: 1
+    end
+    assert_select "a[href=?]", card_path(cards(:layout)), count: 0
+  end
+
+  test "finds cards by description with a highlighted excerpt" do
+    cards(:shipping).update! description: "We must get the shipment out the door"
+
+    get search_path(q: "shipment")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:shipping))
+    assert_select "p mark", text: "shipment"
+  end
+
+  test "finds cards by comment body with a highlighted excerpt" do
+    cards(:layout).comments.create! creator: users(:david), body: "Fixed by bumping the ziggurat index"
+
+    get search_path(q: "ziggurat")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select "p mark", text: "ziggurat"
+  end
+
+  test "orders results newest first" do
+    cards(:logo).update! title: "Umbrella logo", created_at: 2.days.ago
+    cards(:layout).update! title: "Umbrella layout", created_at: 1.day.ago
+
+    get search_path(q: "Umbrella")
+
+    assert_response :success
+    assert_equal [ cards(:layout), cards(:logo) ].map { |card| card_path(card) },
+      response.parsed_body.css("article a").map { |link| link["href"] }.uniq
+  end
+
+  test "shows a blank slate when nothing matches" do
+    get search_path(q: "nonexistent term")
+
+    assert_response :success
+    assert_select ".blank-slate", /No cards found/
+  end
+
+  test "empty query does not list every card" do
+    get search_path(q: " ")
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "only shows cards from boards the user can access" do
+    boards(:private).cards.create! creator: users(:kevin), title: "Secret squirrel plans", status: "published"
+
+    get search_path(q: "Secret")
+
+    assert_response :success
+    assert_select "article", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "Secret")
+
+    assert_response :success
+    assert_select "article mark", text: "Secret"
+  end
+
+  test "drafted cards and their comments never turn up" do
+    boards(:writebook).cards.create! creator: users(:david), title: "Unpublished brainstorm", status: "drafted"
+
+    card = cards(:logo)
+    card.comments.create! creator: users(:david), body: "mccommentson strikes again"
+    card.update_column :status, "drafted"
+
+    get search_path(q: "brainstorm")
+    assert_select "article", count: 0
+
+    get search_path(q: "mccommentson")
+    assert_select "article", count: 0
+  end
+
+test "card matching on both title and comment only appears once" do
+  cards(:logo).comments.create! creator: users(:david), body: "This logo comment also matches"
+
+  get search_path(q: "logo")
+
+  assert_response :success
+  assert_select "article", count: 1
+  assert_select "a[href=?]", card_path(cards(:logo)), count: 1
+end
+
+test "highlights are safe from injected markup" do
+  cards(:logo).update! title: "Funny <script>alert(1)</script> logo"
+
+  get search_path(q: "logo")
+
+  assert_response :success
+  assert_no_match %r{<script>}, response.body
+  assert_select "mark", text: "logo"
+end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_response :redirect
+  end
+end
