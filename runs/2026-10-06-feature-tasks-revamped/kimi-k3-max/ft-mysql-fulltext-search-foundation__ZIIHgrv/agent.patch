--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,31 @@
+module SearchesHelper
+  def highlight_search_query(text)
+    highlight(text.to_s, @query)
+  end
+
+  # Returns a highlighted excerpt of the first card field that matched the
+  # search query: the description if it matched, otherwise the first matching
+  # comment. Returns nil when the card only matched on its title.
+  def search_result_excerpt(card)
+    description = card.description.to_plain_text
+
+    if search_query_matches?(description)
+      search_query_excerpt(description)
+    elsif comment = card.comments.detect { search_query_matches?(it.body.to_plain_text) }
+      search_query_excerpt(comment.body.to_plain_text)
+    end
+  end
+
+  private
+    def search_query_regex
+      @search_query_regex ||= /#{Regexp.escape(@query)}/i
+    end
+
+    def search_query_matches?(text)
+      text.present? && text.match?(search_query_regex)
+    end
+
+    def search_query_excerpt(text)
+      highlight(excerpt(text.squish, @query, radius: 120), @query)
+    end
+end
