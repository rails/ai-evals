+# Keeps Board#bytes_used current when a comment goes away (the embeds in its body
+# stop counting). Attachment additions and removals are tracked separately -- see
+# lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb.
+#
+# A regular (non-commit) callback is used on purpose: the owning card may be
+# destroyed in the same transaction, and resolving it here (rather than after
+# commit) lets us fall back to re-aggregating the account. Enqueued jobs are
+# deferred until after commit (via +enqueue_after_transaction_commit+), so
+# rolled-back destroys never trigger recalculations.
+module Comment::StorageUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy :recalculate_board_bytes_used_later
+  end
+
+  private
+    def recalculate_board_bytes_used_later
+      if card && !card.destroyed?
+        board.recalculate_bytes_used_later
+      elsif account && !account.destroyed?
+        account.recalculate_bytes_used_later
+      end
+    end
+end
