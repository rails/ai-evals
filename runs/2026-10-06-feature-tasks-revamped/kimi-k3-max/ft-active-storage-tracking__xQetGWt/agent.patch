+require "test_helper"
+
+class Board::StorageUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "bytes_used starts at zero" do
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "recalculating counts card images" do
+    attach_card_image
+
+    @board.recalculate_bytes_used_now
+    assert_equal @card.image.blob.byte_size, @board.bytes_used
+  end
+
+  test "recalculating counts files embedded in the board description" do
+    blob = embed_blob_in @board, :public_description
+
+    @board.recalculate_bytes_used_now
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "recalculating counts files embedded in card descriptions" do
+    blob = embed_blob_in @card, :description
+
+    @board.recalculate_bytes_used_now
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "recalculating counts files embedded in comments" do
+    comment = @card.comments.create!(body: "Nice work")
+    blob = embed_blob_in comment, :body
+
+    @board.recalculate_bytes_used_now
+    assert_equal blob.byte_size, @board.bytes_used
+  end
+
+  test "recalculating totals everything on the board and its cards" do
+    image_size = attach_card_image.byte_size
+    board_embed = embed_blob_in @board, :public_description
+    card_embed = embed_blob_in @card, :description
+    comment_embed = embed_blob_in @card.comments.create!(body: "See attached"), :body
+
+    @board.recalculate_bytes_used_now
+    assert_equal image_size + board_embed.byte_size + card_embed.byte_size + comment_embed.byte_size, @board.bytes_used
+  end
+
+  test "recalculating ignores other boards, avatars, exports, and variants" do
+    embed_blob_in @card, :description # embedding an image processes variants immediately
+    attach_card_image
+
+    other_card = boards(:private).cards.create!(title: "Elsewhere", status: :published)
+    embed_blob_in other_card, :description
+    users(:david).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+
+    export = Account::Export.create!(account: @account, user: users(:david))
+    export.file.attach io: StringIO.new("zipped"), filename: "export.zip", content_type: "application/zip"
+
+    @board.recalculate_bytes_used_now
+    assert_equal @card.image.blob.byte_size + @card.rich_text_description.embeds.first.byte_size, @board.bytes_used
+  end
+
+  test "recalculating is a constant number of queries regardless of attachment count" do
+    assert_queries_count(2) { @board.recalculate_bytes_used_now } # one SUM, one UPDATE
+
+    3.times do
+      card = @board.cards.create!(title: "More", status: :published)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      embed_blob_in card, :description
+      embed_blob_in card.comments.create!(body: "See attached"), :body
+    end
+
+    assert_queries_count(2) { @board.recalculate_bytes_used_now }
+  end
+
+  test "usage is recalculated in the background when a card image is attached" do
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      attach_card_image
+    end
+
+    perform_storage_jobs
+    assert_equal @card.image.blob.byte_size, @board.reload.bytes_used
+    assert_equal @card.image.blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "usage is recalculated in the background when embeds are added and removed" do
+    blob = nil
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      blob = embed_blob_in @card, :description
+    end
+
+    perform_storage_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      @card.update! description: "No more attachments"
+    end
+
+    perform_storage_jobs
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "usage is recalculated in the background when a comment is destroyed" do
+    comment = @card.comments.create!(body: "See attached")
+    blob = embed_blob_in comment, :body
+    perform_storage_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      comment.destroy
+    end
+
+    perform_storage_jobs
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "usage is recalculated in the background when a card is destroyed" do
+    attach_card_image
+    embed_blob_in @card, :description
+    perform_storage_jobs
+
+    assert_enqueued_with(job: Board::RecalculateBytesUsedJob, args: [ @board ]) do
+      @card.destroy
+    end
+
+    perform_storage_jobs
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "usage moves with the card when it moves to another board" do
+    image_size = attach_card_image.byte_size
+    other_board = boards(:private)
+
+    @card.move_to other_board
+
+    perform_storage_jobs
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal image_size, other_board.reload.bytes_used
+    assert_equal image_size, @account.reload.bytes_used
+  end
+
+  test "destroying the board re-aggregates the account" do
+    image_size = attach_card_image.byte_size
+    perform_storage_jobs
+    assert_equal image_size, @account.reload.bytes_used
+
+    @board.destroy
+
+    # The board itself is gone, so only the account total is re-aggregated.
+    assert enqueued_jobs.any? { |job| job["job_class"] == "Account::RecalculateBytesUsedJob" }
+
+    perform_storage_jobs
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "usage jobs are discarded when the board no longer exists" do
+    attach_card_image
+    Board::RecalculateBytesUsedJob.perform_later(@board)
+    @board.destroy
+
+    assert_nothing_raised { perform_storage_jobs }
+  end
+
+  private
+    def perform_storage_jobs
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+    end
+
+    def attach_card_image
+      @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      @card.image.blob
+    end
+
+    def embed_blob_in(container, attribute)
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+
+      container.update! attribute => "<p>Check this out: #{ActionText::Attachment.from_attachable(blob).to_html}</p>"
+      blob
+    end
+end
