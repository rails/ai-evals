diff --git a/app/models/card/storage_used.rb b/app/models/card/storage_used.rb
new file mode 100644
index 0000000..01c09b6
--- /dev/null
+++ b/app/models/card/storage_used.rb
@@ -0,0 +1,35 @@
+# Keeps Board#bytes_used current when a card goes away (its image and the embeds
+# in its description and comments stop counting) or moves to another board (its
+# bytes move with it). Attachment additions and removals are tracked separately --
+# see lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb.
+#
+# Regular (non-commit) callbacks are used on purpose: +handle_board_change+ saves
+# the card again when it moves, which would reset saved_changes before an
+# after_update_commit could evaluate them. Enqueued jobs are deferred until after
+# commit (via +enqueue_after_transaction_commit+), so rolled-back changes never
+# trigger recalculations.
+module Card::StorageUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :recalculate_bytes_used_later_for_old_and_new_board, if: :saved_change_to_board_id?
+    after_destroy :recalculate_board_bytes_used_later
+  end
+
+  private
+    def recalculate_bytes_used_later_for_old_and_new_board
+      board.recalculate_bytes_used_later
+
+      if old_board = account.boards.find_by(id: board_id_before_last_save)
+        old_board.recalculate_bytes_used_later
+      end
+    end
+
+    def recalculate_board_bytes_used_later
+      if board && !board.destroyed?
+        board.recalculate_bytes_used_later
+      elsif account && !account.destroyed?
+        account.recalculate_bytes_used_later
+      end
+    end
+end
