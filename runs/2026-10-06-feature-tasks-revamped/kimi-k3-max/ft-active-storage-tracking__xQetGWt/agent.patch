index 0000000..ccf0ddf
--- /dev/null
+++ b/test/jobs/account/reconcile_bytes_used_job_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::ReconcileBytesUsedJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "recomputes every board and then the account total" do
+    account = accounts("37s")
+    attach_image_to cards(:logo)
+    attach_image_to boards(:private).cards.create!(title: "Elsewhere", status: :published)
+
+    account.boards.each { |board| board.update_columns(bytes_used: 0) }
+    account.update_columns(bytes_used: 0)
+
+    Account::ReconcileBytesUsedJob.perform_now(account)
+
+    assert_equal cards(:logo).image.blob.byte_size, boards(:writebook).reload.bytes_used
+    assert_equal account.boards.sum(:bytes_used), account.reload.bytes_used
+    assert account.bytes_used > 0
+  end
+
+  test "reconciles accounts after data imports" do
+    source_account = accounts("37s")
+    byte_size = attach_image_to(cards(:logo)).byte_size
+
+    export = Account::Export.create!(account: source_account, user: users(:david))
+    export.build
+
+    export_tempfile = Tempfile.new([ "export", ".zip" ])
+    export.file.open { |file| FileUtils.cp(file.path, export_tempfile.path) }
+
+    source_account.destroy!
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob # blobs are purged in the background on destroy
+
+    identity = users(:david).identity
+    target_account = Account.create_with_owner(account: { name: "Import Test" }, owner: { identity: identity, name: "David" })
+    import = Account::Import.create!(identity: identity, account: target_account)
+    Current.set(account: target_account) do
+      import.file.attach(io: File.open(export_tempfile.path), filename: "export.zip", content_type: "application/zip")
+    end
+
+    assert_enqueued_with(job: Account::ReconcileBytesUsedJob) do
+      Account::DataImportJob.perform_now(import)
+    end
+
+    # Imports insert attachments without firing callbacks, so nothing was tracked yet.
+    assert_equal 0, target_account.reload.bytes_used
+
+    Account::ReconcileBytesUsedJob.perform_now(target_account)
+
+    assert_equal byte_size, target_account.reload.bytes_used
+    assert_equal byte_size, target_account.boards.sum(:bytes_used)
+  ensure
+    export_tempfile&.close
+    export_tempfile&.unlink
+  end
+
+  test "is discarded when the account no longer exists" do
+    account = accounts("37s")
+    Account::ReconcileBytesUsedJob.perform_later(account)
+    account.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: Account::ReconcileBytesUsedJob
+    end
+  end
+
+  private
+    def attach_image_to(card)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      card.image.blob
+    end
+end
diff --git a/test/models/account/storage_used_test.rb b/test/models/account/storage_used_test.rb
new file mode 100644
index 0000000..273edc1
--- /dev/null
+++ b/test/models/account/storage_used_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Account::StorageUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "bytes_used is the sum of board usage" do
+    boards(:writebook).update_columns(bytes_used: 100)
+    boards(:private).update_columns(bytes_used: 50)
+
+    @account.recalculate_bytes_used_now
+    assert_equal 150, @account.bytes_used
+  end
+
+  test "bytes_used includes everything counted across all boards" do
+    image_size = attach_card_image.byte_size
+    other_card = boards(:private).cards.create!(title: "Elsewhere", status: :published)
+    embed_size = embed_blob_in(other_card, :description).byte_size
+
+    perform_enqueued_jobs
+    assert_equal image_size + embed_size, @account.reload.bytes_used
+  end
+
+  test "reconciling recalculates every board from its attachments" do
+    image_size = attach_card_image.byte_size
+    @board.recalculate_bytes_used_now
+    @account.recalculate_bytes_used_now
+
+    @board.update_columns(bytes_used: 0)
+    @account.update_columns(bytes_used: 0)
+
+    Account::ReconcileBytesUsedJob.perform_now(@account)
+
+    assert_equal image_size, @board.reload.bytes_used
+    assert_equal image_size, @account.reload.bytes_used
+  end
+
+  test "reconciling is enqueued per account" do
+    assert_enqueued_jobs Account.count, only: Account::ReconcileBytesUsedJob do
+      Account.reconcile_all_bytes_used_later
+    end
+  end
+
+  test "usage jobs are discarded when the account no longer exists" do
+    attach_card_image
+    @account.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob, Account::ReconcileBytesUsedJob ]
+    end
+  end
+
+  test "bytes_used is zero when the account has no boards" do
+    account = Account.create_with_owner(account: { name: "Empty" }, owner: { identity: identities(:jason), name: "Jason" })
+
+    account.recalculate_bytes_used_now
+    assert_equal 0, account.bytes_used
+  end
+
+  private
