diff --git a/app/models/board/storage_used.rb b/app/models/board/storage_used.rb
new file mode 100644
index 0000000..e97f962
--- /dev/null
+++ b/app/models/board/storage_used.rb
@@ -0,0 +1,50 @@
+# Tracks how much storage this board uses, in bytes, so that Board#bytes_used is
+# always ready to read. The value is recalculated in the background as countable
+# attachments (card images and files embedded in board descriptions, card
+# descriptions, and comments) come and go -- see
+# lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb.
+#
+# Recalculating is a single aggregation query, so it stays cheap even for boards
+# with lots of attachments. When the board is destroyed, only the account total
+# needs re-aggregating (a regular, non-commit callback: enqueued jobs are
+# deferred until after commit via +enqueue_after_transaction_commit+).
+module Board::StorageUsed
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy :recalculate_account_bytes_used_later
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    update_columns bytes_used: counted_attachments.joins(:blob).sum(ActiveStorage::Blob.arel_table[:byte_size])
+  end
+
+  private
+    def counted_attachments
+      card_ids    = cards.select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      card_images(card_ids)
+        .or(embeds_of ActionText::RichText.where(record_type: "Board",   name: "public_description", record_id: id))
+        .or(embeds_of ActionText::RichText.where(record_type: "Card",    name: "description",        record_id: card_ids))
+        .or(embeds_of ActionText::RichText.where(record_type: "Comment", name: "body",               record_id: comment_ids))
+    end
+
+    def card_images(card_ids)
+      ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: card_ids)
+    end
+
+    def embeds_of(rich_texts)
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts.select(:id))
+    end
+
+    def recalculate_account_bytes_used_later
+      if account && !account.destroyed?
+        account.recalculate_bytes_used_later
+      end
+    end
+end
