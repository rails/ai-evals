diff --git a/app/models/account/storage_used.rb b/app/models/account/storage_used.rb
new file mode 100644
index 0000000..16ee161
--- /dev/null
+++ b/app/models/account/storage_used.rb
@@ -0,0 +1,29 @@
+# Tracks how much storage this account uses, in bytes, so that Account#bytes_used
+# is always ready to read. An account's usage is the sum of its boards' usage;
+# board totals are recalculated in the background as attachments come and go (see
+# Board::StorageUsed), so recalculating the account total is a cheap re-aggregation.
+module Account::StorageUsed
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Nightly sweep (see config/recurring.yml) that repairs any drift between the
+    # stored bytes_used values and the attachments actually on record.
+    def reconcile_all_bytes_used_later
+      find_each { |account| Account::ReconcileBytesUsedJob.perform_later(account) }
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Account::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    update_columns bytes_used: boards.sum(:bytes_used)
+  end
+
+  # Recomputes every board from its attachments, not just the account total.
+  # Imports bypass attachment callbacks, so they reconcile once they finish.
+  def reconcile_bytes_used_later
+    Account::ReconcileBytesUsedJob.perform_later(self)
+  end
+end
