diff --git a/lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb b/lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb
new file mode 100644
index 0000000..405bc03
--- /dev/null
+++ b/lib/rails_ext/active_storage_attachment_bytes_used_tracking.rb
@@ -0,0 +1,55 @@
+# Keeps Board#bytes_used and Account#bytes_used up to date (in the background) as
+# countable attachments come and go.
+#
+# Countable attachments are card images and files embedded in board descriptions,
+# card descriptions, and comments -- everything else (avatars, exports, image
+# variants) is ignored. One recalculation job is enqueued per attachment change,
+# and each job recomputes the total from scratch, so bursts of activity on busy
+# boards simply result in a few redundant, idempotent recalculations.
+#
+# Regular (non-commit) callbacks are used on purpose: attaching via autosave can
+# swallow after_create_commit, and perform_later is deferred until after commit
+# anyway (via +enqueue_after_transaction_commit+), so jobs are never enqueued for
+# rolled-back transactions.
+#
+# When the owning record can no longer be located (it is being destroyed in the
+# same transaction), only the account total is re-aggregated; the destroy
+# callbacks on Board/Card/Comment recompute the affected board.
+module ActiveStorageAttachmentBytesUsedTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :track_bytes_used_later
+    after_destroy :track_bytes_used_later
+  end
+
+  private
+    def track_bytes_used_later
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        track_board_bytes_used_later Card.find_by(id: record_id)&.board
+      when [ "ActionText::RichText", "embeds" ]
+        track_board_bytes_used_later board_owning_embed
+      end
+    end
+
+    def board_owning_embed
+      case (rich_text = ActionText::RichText.find_by(id: record_id))&.record_type
+      when "Board"   then Board.find_by(id: rich_text.record_id)
+      when "Card"    then Card.find_by(id: rich_text.record_id)&.board
+      when "Comment" then Comment.find_by(id: rich_text.record_id)&.card&.board
+      end
+    end
+
+    def track_board_bytes_used_later(board)
+      if board
+        board.recalculate_bytes_used_later
+      elsif account
+        account.recalculate_bytes_used_later
+      end
+    end
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  include ActiveStorageAttachmentBytesUsedTracking
+end
diff --git a/test/jobs/account/reconcile_bytes_used_job_test.rb b/test/jobs/account/reconcile_bytes_used_job_test.rb
