diff --git a/app/jobs/account/reconcile_bytes_used_job.rb b/app/jobs/account/reconcile_bytes_used_job.rb
new file mode 100644
index 0000000..8e0ea46
--- /dev/null
+++ b/app/jobs/account/reconcile_bytes_used_job.rb
@@ -0,0 +1,24 @@
+# Recomputes the bytes_used of every board on the account from its attachments,
+# then re-sums the account total. Enqueued after data imports (which insert
+# attachments without firing callbacks) and by the nightly reconciliation sweep.
+#
+# Idempotent and continuable: resumes from the last-processed board if interrupted.
+class Account::ReconcileBytesUsedJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    step :boards do |step|
+      account.boards.find_each(start: step.cursor) do |board|
+        board.recalculate_bytes_used_now
+        step.advance! from: board.id
+      end
+    end
+
+    step :account do
+      account.recalculate_bytes_used_now
+    end
+  end
+end
