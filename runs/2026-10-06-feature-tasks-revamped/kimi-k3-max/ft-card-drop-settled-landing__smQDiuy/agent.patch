diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..06f586c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,159 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Moves cards between columns by dragging them around the board. Columns keep
+// their own order, so a card can only change columns -- never its place
+// within one.
+//
+// The move is optimistic: as soon as the card is dropped it is already in its
+// new column, and the save happens in the background. Since the save goes
+// through Turbo's fetch, the board refresh it broadcasts is skipped by this
+// client -- nothing shifts after you let go.
+export default class extends Controller {
+  static targets = [ "card", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  start(event) {
+    const card = event.target.closest(`[data-drag-and-drop-target~='card']`)
+
+    if (card && this.#isAvailable) {
+      this.draggedCard = card
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+
+      // Dim the card only once the browser has captured the drag image
+      requestAnimationFrame(() => card.classList.add(this.draggedItemClass))
+    } else {
+      event.preventDefault()
+    }
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const container = this.#containerFor(event)
+
+    if (container && this.#canDropInto(container)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#highlight(null)
+    }
+  }
+
+  leave(event) {
+    const container = this.#containerFor(event)
+
+    if (container && !container.contains(event.relatedTarget)) {
+      container.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const container = this.#containerFor(event)
+
+    if (container && this.#canDropInto(container)) {
+      event.preventDefault()
+
+      const originalPosition = this.#move(this.draggedCard, container)
+
+      if (originalPosition) {
+        this.#save(this.draggedCard, container, originalPosition)
+      }
+    }
+  }
+
+  end() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#highlight(null)
+  }
+
+  get #isAvailable() {
+    return window.matchMedia(this.desktopBreakpointValue).matches
+  }
+
+  #containerFor(event) {
+    return event.target.closest(`[data-drag-and-drop-target~='container']`)
+  }
+
+  #canDropInto(container) {
+    return container !== this.draggedCard.closest(`[data-drag-and-drop-target~='container']`)
+  }
+
+  #highlight(container) {
+    this.containerTargets.forEach(element => {
+      element.classList.toggle(this.hoverContainerClass, element === container)
+    })
+  }
+
+  #move(card, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      const originalPosition = { parent: card.parentElement, next: card.nextElementSibling }
+      const successor = this.#successorIn(card, container, list)
+
+      if (successor) {
+        successor.parentElement.insertBefore(card, successor)
+      } else if (this.#goesFirst(card, container)) {
+        list.prepend(card)
+      } else {
+        list.append(card)
+      }
+
+      return originalPosition
+    }
+  }
+
+  // The card a dropped card should land before, if any. Columns sort their
+  // most recently active card on top, except that golden-first columns lead
+  // with their golden cards.
+  #successorIn(card, container, list) {
+    if (this.#goesFirst(card, container)) {
+      return list.querySelector(".card")
+    } else {
+      return list.querySelector(".card:not(.golden-effect)")
+    }
+  }
+
+  #goesFirst(card, container) {
+    return card.classList.contains("golden-effect") || !container.hasAttribute("data-drag-and-drop-golden-first")
+  }
+
+  async #save(card, container, originalPosition) {
+    const number = this.#numberOf(card)
+
+    if (number) {
+      const url = container.dataset.dragAndDropUrl.replace("__card__", number)
+
+      try {
+        const response = container.dataset.dragAndDropMethod === "delete" ?
+          await destroy(url, { responseKind: "json" }) :
+          await post(url, { responseKind: "json" })
+
+        if (!response.ok) this.#restore(card, originalPosition)
+      } catch {
+        this.#restore(card, originalPosition)
+      }
+    } else {
+      this.#restore(card, originalPosition)
+    }
+  }
+
+  #restore(card, { parent, next }) {
+    if (parent.isConnected) {
+      parent.insertBefore(card, next?.parentElement === parent ? next : null)
+    }
+  }
+
+  #numberOf(card) {
+    return card.querySelector(".card__link")?.pathname.split("/").pop()
+  }
+}
