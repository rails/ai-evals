diff --git a/test/integration/drag_and_drop_test.rb b/test/integration/drag_and_drop_test.rb
new file mode 100644
index 0000000..e8a5692
--- /dev/null
+++ b/test/integration/drag_and_drop_test.rb
@@ -0,0 +1,142 @@
+require "test_helper"
+
+class DragAndDropTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "board renders drag-and-drop hooks" do
+    get board_path(boards(:writebook))
+    assert_response :success
+
+    assert_select ".card-columns[data-controller~='drag-and-drop']" do |element|
+      assert_equal "drag-and-drop__dragged-item", element.first["data-drag-and-drop-dragged-item-class"]
+      assert_equal "drag-and-drop__hover-container", element.first["data-drag-and-drop-hover-container-class"]
+
+      %w[ dragstart dragover dragleave drop dragend ].each do |event_name|
+        assert_includes element.first["data-action"], "#{event_name}->drag-and-drop"
+      end
+    end
+
+    assert_select "section#maybe[data-drag-and-drop-target='container']" do |element|
+      assert_match %r{/cards/__card__/triage\z}, element.first["data-drag-and-drop-url"]
+      assert_equal "delete", element.first["data-drag-and-drop-method"]
+      assert element.first.has_attribute?("data-drag-and-drop-golden-first")
+    end
+
+    assert_select "section#not-now[data-drag-and-drop-target='container']" do |element|
+      assert_match %r{/cards/__card__/not_now\z}, element.first["data-drag-and-drop-url"]
+      assert_equal "post", element.first["data-drag-and-drop-method"]
+    end
+
+    assert_select "section#closed-cards[data-drag-and-drop-target='container']" do |element|
+      assert_match %r{/cards/__card__/closure\z}, element.first["data-drag-and-drop-url"]
+      assert_equal "post", element.first["data-drag-and-drop-method"]
+    end
+
+    boards(:writebook).columns.each do |column|
+      assert_select "section##{dom_id(column)}[data-drag-and-drop-target='container']" do |element|
+        assert_includes element.first["data-drag-and-drop-url"], "/cards/__card__/triage?column_id=#{column.id}"
+        assert_equal "post", element.first["data-drag-and-drop-method"]
+        assert element.first.has_attribute?("data-drag-and-drop-golden-first")
+      end
+    end
+  end
+
+  test "cards render draggable" do
+    get board_path(boards(:writebook))
+    assert_response :success
+
+    assert_select "article.card[draggable='true'][data-drag-and-drop-target='card']", minimum: 1
+  end
+
+  test "dropping a card into a column triages it there" do
+    card = cards(:logo)
+    column = columns(:writebook_on_hold)
+
+    post card_triage_path(card, column_id: column.id), as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+
+  test "a dropped card becomes the most recently active card in its column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post card_triage_path(card, column_id: column.id), as: :json
+
+    assert_response :no_content
+    assert_equal card, column.cards.active.latest.first
+  end
+
+  test "dropping a closed card into a column reopens and triages it" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    post card_triage_path(card, column_id: columns(:writebook_review).id), as: :json
+
+    assert_response :no_content
+    assert card.reload.open?
+    assert_equal columns(:writebook_review), card.column
+  end
+
+  test "dropping a card on Maybe sends it back to triage" do
+    card = cards(:logo)
+    assert card.triaged?
+
+    delete card_triage_path(card), as: :json
+
+    assert_response :no_content
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dropping a postponed card on Maybe revives it into triage" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+    assert card.postponed?
+
+    delete card_triage_path(card), as: :json
+
+    assert_response :no_content
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dropping a card on Not Now postpones it" do
+    card = cards(:logo)
+
+    post card_not_now_path(card), as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+
+  test "dropping a card on Done closes it" do
+    card = cards(:logo)
+
+    post card_closure_path(card), as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+
+  test "board refresh broadcast carries the request id so the dragging client skips it" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    column = columns(:writebook_on_hold)
+
+    broadcasts = capture_broadcasts(Turbo::StreamsChannel.send(:stream_name_from, board)) do
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+        post card_triage_path(card, column_id: column.id),
+          headers: { "X-Turbo-Request-Id" => "drag-request-1" }, as: :json
+      end
+    end
+
+    assert_response :no_content
+    assert broadcasts.any? { |content| content.include?(%(request-id="drag-request-1")) },
+      "expected a board refresh broadcast carrying the drag request id"
+  end
+end
diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..20d8dc5
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,264 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card from Maybe into a column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+
+    visit board_url(@board)
+    wait_for_column column
+
+    spy_on_turbo_visits
+    start_dragging card
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    drag_over column
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+
+    drop_on dom_id(column)
+
+    # The card is already in its new column as soon as it is dropped...
+    assert_card_in_column card, column
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    # ...and the save lands in the background
+    assert_eventually_in_column card, column
+
+    # The board refresh that the save broadcasts is skipped by this client,
+    # so the board stays the way you left it: nothing shifts afterwards.
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    assert_refresh_received_but_not_performed
+    assert_card_in_column card, column
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+    wait_for_section "not-now"
+
+    start_dragging card
+    drop_on "not-now"
+
+    assert_selector "#not-now .cards__list ##{dom_id(card, :article)}", visible: :all
+    assert_eventually { card.reload.postponed? }
+  end
+
+  test "dragging a card onto Done closes it" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+    wait_for_section "closed-cards"
+
+    start_dragging card
+    drop_on "closed-cards"
+
+    assert_selector "#closed-cards .cards__list ##{dom_id(card, :article)}", visible: :all
+    assert_eventually { card.reload.closed? }
+  end
+
+  test "dragging a card between columns" do
+    card = cards(:logo)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    wait_for_column card.column
+    wait_for_column column
+
+    start_dragging card
+    drop_on dom_id(column)
+
+    assert_card_in_column card, column
+    assert_eventually_in_column card, column
+  end
+
+  test "dragging a card back onto Maybe" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    wait_for_column card.column
+
+    start_dragging card
+    drop_on "maybe"
+
+    assert_selector "#maybe .cards__list ##{dom_id(card, :article)}", visible: :all
+    assert_eventually { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a card onto its own column is a no-op" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    wait_for_column card.column
+
+    start_dragging card
+    drag_over card.column
+
+    # Its own column doesn't light up, and dropping there does nothing
+    assert_no_selector "##{dom_id(card.column)}.drag-and-drop__hover-container"
+
+    drop_on dom_id(card.column)
+
+    assert_selector "##{dom_id(card.column)} .cards__list ##{dom_id(card, :article)}", visible: :all
+    assert_equal card.column, card.reload.column
+  end
+
+  test "dropped cards land where the column's own order puts the most recently active card" do
+    golden_card = cards(:logo)
+    triage = columns(:writebook_triage)
+
+    visit board_url(@board)
+    wait_for_column triage
+
+    # A regular card goes after the leading golden cards...
+    start_dragging cards(:buy_domain)
+    drop_on dom_id(triage)
+
+    assert_equal [ dom_id(golden_card, :article), dom_id(cards(:buy_domain), :article), dom_id(cards(:layout), :article) ],
+      card_ids_in(triage).first(3)
+
+    # ...while a golden card takes the top spot
+    start_dragging golden_card
+    drop_on dom_id(columns(:writebook_in_progress))
+
+    assert_equal dom_id(golden_card, :article), card_ids_in(columns(:writebook_in_progress)).first
+  end
+
+  test "dragging a card into an empty column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    wait_for_column column
+
+    start_dragging card
+    drop_on dom_id(column)
+
+    assert_equal [ dom_id(card, :article) ], card_ids_in(column)
+    assert_eventually_in_column card, column
+  end
+
+test "canceling a drag leaves the board untouched" do
+  card = cards(:buy_domain)
+  column = columns(:writebook_on_hold)
+
+  visit board_url(@board)
+  wait_for_column column
+
+  start_dragging card
+  assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+  page.execute_script(<<~JS)
+    window.dndCard.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+  JS
+
+  assert_no_selector ".drag-and-drop__dragged-item"
+  assert_selector "#maybe .cards__list ##{dom_id(card, :article)}", visible: :all
+  assert_nil card.reload.column
+end
+
+test "dragging is not available on small viewports" do
+  card = cards(:buy_domain)
+  column = columns(:writebook_on_hold)
+
+  visit board_url(@board)
+  wait_for_column column
+
+  page.current_window.resize_to(500, 900)
+
+  start_dragging card
+  drop_on dom_id(column)
+
+  assert_no_selector ".drag-and-drop__dragged-item"
+  assert_selector "#maybe .cards__list ##{dom_id(card, :article)}", visible: :all
+  assert_nil card.reload.column
+ensure
+  page.current_window.resize_to(1200, 1000)
+end
+
+  private
+    def wait_for_column(column)
+      wait_for_section dom_id(column)
+    end
+
+    def wait_for_section(id)
+      assert_selector "##{id} .cards__list", visible: :all
+    end
+
+    def card_ids_in(column)
+      page.evaluate_script(%{Array.from(document.querySelectorAll("##{dom_id(column)} .cards__list .card")).map(card => card.id)})
+    end
+
+    def assert_card_in_column(card, column)
+      assert_selector "##{dom_id(column)} .cards__list ##{dom_id(card, :article)}", visible: :all
+    end
+
+    def assert_eventually_in_column(card, column)
+      assert_eventually { card.reload.column == column }
+    end
+
+    def assert_eventually(timeout: 5)
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
+      until yield
+        raise "condition not met in time" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.1
+      end
+    end
+
+    def spy_on_turbo_visits
+      page.execute_script(<<~JS)
+        window.dndRefreshes = []
+        window.dndVisits = []
+
+        const originalRefresh = Turbo.session.refresh.bind(Turbo.session)
+        Turbo.session.refresh = function(url, options) {
+          window.dndRefreshes.push({ url: url, options: options })
+          return originalRefresh(url, options)
+        }
+
+        const originalVisit = Turbo.session.visit.bind(Turbo.session)
+        Turbo.session.visit = function(url, options) {
+          window.dndVisits.push(url)
+          return originalVisit(url, options)
+        }
+      JS
+    end
+
+    def assert_refresh_received_but_not_performed
+      assert_eventually { page.evaluate_script("window.dndRefreshes.length") > 0 }
+      assert_equal 0, page.evaluate_script("window.dndVisits.length")
+    end
+
+    def start_dragging(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        window.dndCard = document.getElementById(arguments[0])
+        window.dndDataTransfer = new DataTransfer()
+        window.dndCard.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+      JS
+    end
+
+    def drag_over(column)
+      page.execute_script(<<~JS, dom_id(column))
+        document
+          .getElementById(arguments[0])
+          .dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+      JS
+    end
+
+    def drop_on(id)
+      page.execute_script(<<~JS, id)
+        const container = document.getElementById(arguments[0])
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+        container.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+        window.dndCard.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: window.dndDataTransfer }))
+      JS
+    end
+end
