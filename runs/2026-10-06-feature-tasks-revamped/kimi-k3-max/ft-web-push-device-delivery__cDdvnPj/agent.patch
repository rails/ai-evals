new file mode 100644
index 0000000..309a047
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions
+      .find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+      .update!(push_subscription_params)
+
+    head :created
+  end
+
+  # The id is the URL-encoded push endpoint handed out by the push service.
+  def destroy
+    @user.push_subscriptions.find_by(endpoint: params[:id])&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..936d211
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,108 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Turns web push notifications on and off for the device it's used on. When
+// turned on, it hands the push subscription it got from the browser's push
+// service to the server so notifications can be delivered to this device.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details", "status" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    if (this.#supported) {
+      this.#reflect(await this.#currentSubscription())
+    } else {
+      this.statusTarget.hidden = true
+    }
+  }
+
+  async subscribe() {
+    if (await Notification.requestPermission() == "granted") {
+      try {
+        const subscription = await this.#subscribeToPush()
+
+        await this.#registerWithServer(subscription)
+        this.#reflect(subscription)
+      } catch {
+        this.#showHelp()
+      }
+    } else {
+      this.#reflect(null)
+    }
+  }
+
+  async unsubscribe() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription) {
+      await subscription.unsubscribe()
+
+      try {
+        await this.#unregisterWithServer(subscription)
+      } catch {
+        // The expired subscription cleans itself up on the next delivery
+      }
+    }
+
+    this.#reflect(null)
+  }
+
+  // Private
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribeToPush() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  async #registerWithServer(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      }
+    })
+
+    if (!response.ok) throw new Error(`Could not register push subscription (status ${response.statusCode})`)
+  }
+
+  #unregisterWithServer(subscription) {
+    return destroy(`${this.subscriptionsUrlValue}/${encodeURIComponent(subscription.endpoint)}`)
+  }
+
+  #reflect(subscription) {
+    this.element.classList.toggle(this.onClass, subscription != null)
+    this.detailsTargets.forEach(target => target.hidden = Notification.permission != "denied")
+  }
+
+  #showHelp() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+}
