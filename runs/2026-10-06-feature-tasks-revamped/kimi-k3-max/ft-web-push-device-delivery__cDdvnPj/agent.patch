diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..e06d0a1
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:kevin_browser)
+    @notification = notifications(:layout_commented_kevin)
+  end
+
+  test "configured when both VAPID keys are present" do
+    with_vapid_keys do
+      assert PushSubscription.configured?
+    end
+
+    assert_not PushSubscription.configured?
+  end
+
+  test "deliver sends the notification payload to the push endpoint" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |arguments|
+        payload = JSON.parse(arguments[:message])
+
+        arguments[:endpoint] == @subscription.endpoint &&
+          arguments[:p256dh] == @subscription.p256dh_key &&
+          arguments[:auth] == @subscription.auth_key &&
+          arguments[:vapid][:public_key] == "test-public-key" &&
+          arguments[:vapid][:private_key] == "test-private-key" &&
+          payload["title"].present? &&
+          payload["body"].present? &&
+          payload["url"].include?(@notification.account.slug)
+      end
+
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver does nothing without VAPID keys" do
+    WebPush.expects(:payload_send).never
+
+    @subscription.deliver(@notification)
+  end
+
+  test "deliver destroys the subscription when the push service reports it expired" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "deliver destroys the subscription when the push service reports it invalid" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(stub(body: ""), "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "deliver raises other push service errors" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(body: ""), "push.example.com"))
+
+      assert_no_difference -> { PushSubscription.count } do
+        assert_raises(WebPush::PushServiceError) { @subscription.deliver(@notification) }
+      end
+    end
+  end
+
+  private
+    def with_vapid_keys
+      ENV["VAPID_PUBLIC_KEY"] = "test-public-key"
+      ENV["VAPID_PRIVATE_KEY"] = "test-private-key"
+      yield
+    ensure
+      ENV.delete("VAPID_PUBLIC_KEY")
+      ENV.delete("VAPID_PRIVATE_KEY")
+    end
+end
