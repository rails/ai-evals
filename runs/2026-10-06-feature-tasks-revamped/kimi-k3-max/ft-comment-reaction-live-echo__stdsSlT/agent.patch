index 0000000..0cec1b9
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+test "card page renders the reactions strip on comments" do
+  comment = comments(:logo_agreement_kevin)
+
+  get card_path(@card)
+
+  assert_response :success
+  assert_select "##{ActionView::RecordIdentifier.dom_id(comment, :reactions)}" do
+    assert_select ".reactions__list .reaction", 2
+    assert_select ".reaction .reaction__avatar .avatar img[title=?]", "JZ"
+    assert_select ".reaction .reaction__delete form[action=?]", card_comment_reaction_path(@card, comment, reactions(:logo_thumbs_up_jz))
+    assert_select ".reactions__trigger"
+    assert_select "form.reaction__form[hidden][action=?]", card_comment_reactions_path(@card, comment)
+    assert_select ".reaction__input[maxlength=?]", Reaction::MAX_CONTENT_LENGTH.to_s
+    assert_select ".reaction__emoji-list button", EmojiHelper::REACTIONS.size
+  end
+end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :created
+    assert_equal "👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create with a short text" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Ship it!" } }, as: :turbo_stream
+
+    assert_response :created
+    assert_equal "Ship it!", @comment.reactions.last.content
+  end
+
+  test "create rejects content over 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on a card that is not commentable is forbidden" do
+    @card.update_column :status, :drafted
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create broadcasts the new reaction to everyone watching the card" do
+    assert_turbo_stream_broadcasts @card do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy broadcasts the removal to everyone watching the card" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    assert_turbo_stream_broadcasts @card do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(cards(:logo), reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👀" } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create as JSON with flat params" do
+  assert_difference -> { @comment.reactions.count }, +1 do
+    post card_comment_reactions_path(@card, @comment), params: { content: "🚀" }, as: :json
+  end
+
+  assert_response :created
+  assert_equal "🚀", @comment.reactions.last.content
+end
+
+test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
