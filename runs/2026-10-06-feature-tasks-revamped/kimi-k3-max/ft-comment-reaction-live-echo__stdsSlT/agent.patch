+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "content is required" do
+    assert_not @comment.reactions.build(content: "").valid?
+    assert_not @comment.reactions.build(content: nil).valid?
+  end
+
+  test "content can be an emoji or up to 16 characters of text" do
+    assert @comment.reactions.build(content: "👍").valid?
+    assert @comment.reactions.build(content: "a" * 16).valid?
+    assert_not @comment.reactions.build(content: "a" * 17).valid?
+  end
+
+  test "reacter defaults to the current user" do
+    reaction = @comment.reactions.build(content: "🎉")
+    reaction.valid?
+
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "account defaults to the comment's account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+    assert_equal accounts(:"37s"), reaction.account
+  end
+
+  test "reactions are destroyed with their comment" do
+    assert_difference -> { Reaction.count }, -@comment.reactions.count do
+      @comment.destroy
+    end
+  end
+
+  test "creating a reaction broadcasts an append to the card" do
+    assert_turbo_stream_broadcasts @comment.card do
+      @comment.reactions.create!(content: "🎉")
+    end
+
+    stream = capture_turbo_stream_broadcasts(@comment.card) do
+      @reaction = @comment.reactions.create!(content: "🔥")
+    end.first
+
+    assert_equal "append", stream["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(@comment, :reactions_list), stream["target"]
+    assert_includes stream.at_css("template").inner_html, "🔥"
+    assert_includes stream.at_css("template").inner_html, ActionView::RecordIdentifier.dom_id(@reaction)
+  end
+
+  test "destroying a reaction broadcasts a remove to the card" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    stream = capture_turbo_stream_broadcasts(@comment.card) do
+      reaction.destroy
+    end.first
+
+    assert_equal "remove", stream["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), stream["target"]
+  end
+
+  test "creating a reaction touches the comment to expire its cache" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "🎉")
+    end
+  end
+end
