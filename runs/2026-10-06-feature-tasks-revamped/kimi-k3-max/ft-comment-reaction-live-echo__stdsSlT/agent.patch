+<%= tag.div class: "reactions", id: dom_id(comment, :reactions), data: { controller: "reaction" } do %>
+  <div class="reactions__list" id="<%= dom_id(comment, :reactions_list) %>">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.chronologically, as: :reaction %>
+  </div>
+
+  <button class="reactions__trigger btn btn--circle borderless" title="Add a reaction"
+      data-action="click->reaction#showForm" data-reaction-target="trigger">
+    <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, comment.reactions.build ], class: "reaction__form", html: { hidden: true },
+        data: { reaction_target: "form", action: "turbo:submit-end->reaction#hideForm keydown.esc->reaction#hideForm" } do |form| %>
+    <span class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" title="Pick an emoji" data-action="click->dialog#toggle:stop">
+        <span aria-hidden="true">😀</span>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn borderless" title="<%= name %>" aria-label="<%= name %>"
+                data-action="click->reaction#selectEmoji click->dialog#close"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </span>
+
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <span class="for-screen-reader">Your reaction (an emoji or up to <%= Reaction::MAX_CONTENT_LENGTH %> characters)</span>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::MAX_CONTENT_LENGTH,
+            required: true, placeholder: "😍", autocomplete: "off", data: { reaction_target: "input" } %>
+    <% end %>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" title="Add this reaction">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add this reaction</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" data-action="click->reaction#hideForm">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+<% end %>
