--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,14 @@
+module ReactionsHelper
+  def reaction_content_tag(reaction)
+    if emoji_only_reaction?(reaction.content)
+      tag.span reaction.content, class: "txt-small txt-medium"
+    else
+      tag.span reaction.content, class: "txt-small"
+    end
+  end
+
+  private
+    def emoji_only_reaction?(content)
+      content.present? && content.match?(/\A[\p{So}\p{Sk}\p{Mn}\p{Me}\p{Cf}\s]+\z/)
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..0c312b0
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,57 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Handles both the reactions strip on a comment (adding reactions) and each
+// individual reaction pill (removing your own).
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+    }
+  }
+
+  // Adding a reaction
+
+  showForm() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm(event) {
+    if (event?.type == "turbo:submit-end" && !event.detail.success) return
+
+    this.formTarget.querySelectorAll("dialog[open]").forEach(dialog => dialog.close())
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  selectEmoji({ currentTarget }) {
+    this.inputTarget.value = currentTarget.textContent.trim()
+    this.inputTarget.focus()
+  }
+
+  // Removing your own reaction
+
+  toggleExpanded() {
+    if (this.#isOwnReaction) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  markDeleting() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleting")
+    }
+  }
+
+  get #isOwnReaction() {
+    return this.hasReacterIdValue && this.reacterIdValue == window.Current?.user?.id
+  }
+}
