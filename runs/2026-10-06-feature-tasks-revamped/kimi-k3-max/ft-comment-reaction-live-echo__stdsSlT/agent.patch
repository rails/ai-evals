+require "application_system_test_case"
+
+class ReactionsCssTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "computed styles match the design" do
+    sign_in_as(users(:kevin))
+    comment = comments(:logo_agreement_kevin)
+
+    visit card_url(cards(:logo))
+
+    # A comment with reactions: strip flows in layout
+    strip_position = page.evaluate_script(<<~JS)
+      getComputedStyle(document.querySelector("##{dom_id(comment, :reactions)}")).position
+    JS
+    assert_equal "static", strip_position
+
+    # A comment without reactions: strip is absolutely positioned (trigger sits over the comment body)
+    empty_comment = comments(:logo_agreement_jz)
+    empty_position = page.evaluate_script(<<~JS)
+      getComputedStyle(document.querySelector("##{dom_id(empty_comment, :reactions)}")).position
+    JS
+    assert_equal "absolute", empty_position
+
+    # Delete affordance is hidden until your own reaction is expanded
+    reaction = comment.reactions.create!(content: "🎉", reacter: users(:kevin))
+    assert_selector "##{dom_id(reaction)}", wait: 5
+
+    delete_display_before = page.evaluate_script(<<~JS)
+      getComputedStyle(document.querySelector("##{dom_id(reaction)} .reaction__delete")).display
+    JS
+    assert_equal "none", delete_display_before
+
+    find("##{dom_id(reaction)}").click
+    delete_display_after = page.evaluate_script(<<~JS)
+      getComputedStyle(document.querySelector("##{dom_id(reaction)} .reaction__delete")).display
+    JS
+    assert_equal "grid", delete_display_after
+
+    # Own reactions are marked deleteable; others are not
+    assert_selector "##{dom_id(reaction)}.reaction--deleteable"
+    assert_no_selector "##{dom_id(reactions(:logo_thumbs_up_jz))}.reaction--deleteable"
+  end
+end
