+require "test_helper"
+
+class ReactionsHelperTest < ActionView::TestCase
+  include ReactionsHelper
+
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "emoji-only reactions get the emoji content classes" do
+    reaction = @comment.reactions.build(content: "👍")
+
+    assert_equal %(<span class="txt-small txt-medium">👍</span>), reaction_content_tag(reaction)
+  end
+
+  test "emoji with variation selectors and ZWJ sequences count as emoji-only" do
+    %w[ ❤️ ☀️ ✌️ ].each do |emoji|
+      reaction = @comment.reactions.build(content: emoji)
+
+      assert_includes reaction_content_tag(reaction), "txt-small txt-medium"
+    end
+  end
+
+  test "text reactions get the plain content class" do
+    reaction = @comment.reactions.build(content: "Ship it!")
+
+    assert_equal %(<span class="txt-small">Ship it!</span>), reaction_content_tag(reaction)
+  end
+
+  test "numbers count as text" do
+    reaction = @comment.reactions.build(content: "100")
+
+    assert_equal %(<span class="txt-small">100</span>), reaction_content_tag(reaction)
+  end
+end
