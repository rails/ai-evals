+++ b/test/system/reactions_test.rb
@@ -0,0 +1,133 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction with the input" do
+    visit card_url(@card)
+
+    within reactions_strip_selector do
+      assert_no_selector ".reaction", text: "🎉"
+
+      click_on "Add a reaction"
+      assert_selector ".reaction__form.reaction", visible: :visible
+
+      find(".reaction__input").set("🎉")
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "🎉", wait: 5
+      assert_no_selector ".reaction__form.reaction"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "🎉", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "adding a reaction from the emoji picker" do
+    visit card_url(@card)
+
+    within reactions_strip_selector do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+
+      within ".reaction__emoji-list" do
+        click_on "Party popper"
+      end
+
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+
+  test "canceling the reaction form" do
+    visit card_url(@card)
+
+    within reactions_strip_selector do
+      click_on "Add a reaction"
+      find(".reaction__input").set("nope")
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__form.reaction"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction", text: "nope"
+    end
+
+    assert_no_difference -> { @comment.reactions.reload.count } do
+      sleep 0.2
+    end
+  end
+
+  test "removing your own reaction" do
+    visit card_url(@card)
+
+    within reactions_strip_selector do
+      click_on "Add a reaction"
+      find(".reaction__input").set("👋")
+      click_on "Add this reaction"
+      assert_selector ".reaction", text: "👋", wait: 5
+
+      find(".reaction", text: "👋").click
+      click_on "Remove your reaction"
+
+      assert_no_selector ".reaction", text: "👋", wait: 5
+    end
+
+    assert_empty @comment.reactions.where(content: "👋")
+  end
+
+  test "you cannot remove someone else's reaction" do
+    visit card_url(@card)
+
+    within reactions_strip_selector do
+      reaction = find(".reaction", text: "👍") # left by JZ
+      reaction.click
+
+      assert_no_selector ".reaction.expanded", text: "👍"
+    end
+  end
+
+  test "reactions land as they happen without reloading" do
+    visit card_url(@card)
+    assert_selector reactions_strip_selector
+
+    wait_for_cable_subscriptions
+    @comment.reactions.create!(content: "🎉", reacter: users(:david))
+
+    within reactions_strip_selector do
+      assert_selector ".reaction", text: "🎉", wait: 5
+    end
+  end
+
+  test "reaction removals land without reloading" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    visit card_url(@card)
+    within(reactions_strip_selector) { assert_selector ".reaction", text: "👍" }
+
+    wait_for_cable_subscriptions
+    reaction.destroy
+
+    within reactions_strip_selector do
+      assert_no_selector ".reaction", text: "👍", wait: 5
+    end
+  end
+
+  private
+    def reactions_strip_selector
+      "##{dom_id(@comment, :reactions)}"
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
