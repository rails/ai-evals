@@ -0,0 +1,88 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing</h2>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div class="flex gap-half align-center">
+        <div class="flex-item-grow" style="text-align: left">
+          <strong>Plan:</strong> <%= @account.plan.name %>
+          <% if @account.comped? %>
+            <span class="txt-x-small txt-ink-medium">(comped)</span>
+          <% end %>
+          <br>
+          <span class="txt-x-small txt-ink-medium">
+            #<%= @account.external_account_id %> •
+            <%= @account.users.owner.first&.identity&.email_address || "No owner" %>
+          </span>
+        </div>
+
+        <div class="flex gap-half">
+          <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn", disabled: @account.comped? %>
+          <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn", disabled: !@account.comped? %>
+        </div>
+      </div>
+
+      <div class="flex gap-half">
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Cards</div>
+          <div class="txt-medium">
+            <strong><%= number_with_delimiter(@account.cards_used) %></strong>
+            <span class="txt-x-small txt-ink-medium">/ <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %></span>
+          </div>
+        </div>
+        <div class="flex flex-column gap-quarter flex-item-grow">
+          <div class="txt-x-small">Storage</div>
+          <div class="txt-medium">
+            <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+            <span class="txt-x-small txt-ink-medium">/ <%= number_to_human_size(@account.storage_limit) %></span>
+          </div>
+        </div>
+      </div>
+
+      <% if subscription = @account.subscription %>
+        <div class="txt-x-small txt-ink-medium" style="text-align: left">
+          Stripe customer <%= subscription.stripe_customer_id %>
+          <% if subscription.stripe_subscription_id.present? %>
+            • subscription <%= subscription.stripe_subscription_id %> (<%= subscription.status %>)
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+    </header>
+
+    <p class="txt-small margin-block-half">
+      These numbers replace the account’s real usage when checking plan limits.
+    </p>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <div class="flex gap-half align-center">
+        <%= form.label :card_count, "Card count", class: "flex-item-grow", style: "text-align: left" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input", placeholder: number_with_delimiter(@account.cards.count) %>
+      </div>
+      <div class="flex gap-half align-center">
+        <%= form.label :bytes_used, "Bytes used", class: "flex-item-grow", style: "text-align: left" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input", placeholder: @account.storage_total&.bytes_stored || 0 %>
+      </div>
+      <div class="flex gap-half justify-center">
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <div class="flex gap-half justify-center margin-block-half">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), class: "btn", disabled: @account.overridden_limit.blank? %>
+    </div>
+  </div>
+</section>
