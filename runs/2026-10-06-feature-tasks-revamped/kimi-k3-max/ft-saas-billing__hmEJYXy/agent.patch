+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan allowance" do
+    assert_equal 0, Plan.free.price_in_cents
+    assert_equal 1_000, Plan.free.card_limit
+    assert_equal 1.gigabyte, Plan.free.storage_limit
+    assert Plan.free.free?
+    assert_not Plan.free.paid?
+  end
+
+  test "unlimited plan" do
+    assert_equal "Unlimited", Plan.unlimited.name
+    assert_equal 2_000, Plan.unlimited.price_in_cents
+    assert_equal 20, Plan.unlimited.price_in_dollars
+    assert_nil Plan.unlimited.card_limit
+    assert_equal 5.gigabytes, Plan.unlimited.storage_limit
+    assert Plan.unlimited.paid?
+  end
+
+  test "unlimited+ plan" do
+    assert_equal "Unlimited+", Plan.unlimited_plus.name
+    assert_equal 2_500, Plan.unlimited_plus.price_in_cents
+    assert_equal 25, Plan.unlimited_plus.price_in_dollars
+    assert_nil Plan.unlimited_plus.card_limit
+    assert_equal 500.gigabytes, Plan.unlimited_plus.storage_limit
+  end
+
+  test "find by key" do
+    assert_equal Plan.free, Plan.find("free")
+    assert_equal Plan.unlimited, Plan.find("unlimited")
+    assert_equal Plan.unlimited_plus, Plan.find("unlimited_plus")
+    assert_equal Plan.free, Plan.find("bogus")
+    assert_equal Plan.free, Plan.find(nil)
+  end
+
+  test "find by stripe price id" do
+    with_stripe_price_ids do
+      assert_equal Plan.unlimited, Plan.find_by_stripe_price_id("price_unlimited")
+      assert_equal Plan.unlimited_plus, Plan.find_by_stripe_price_id("price_unlimited_plus")
+      assert_nil Plan.find_by_stripe_price_id("price_nope")
+    end
+  end
+
+  test "paid plans" do
+    assert_equal [ Plan.unlimited, Plan.unlimited_plus ], Plan.paid
+  end
+
+  private
+    def with_stripe_price_ids
+      old_unlimited, old_unlimited_plus = ENV["STRIPE_UNLIMITED_PRICE_ID"], ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+      ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+      ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_unlimited_plus"
+      yield
+    ensure
+      ENV["STRIPE_UNLIMITED_PRICE_ID"] = old_unlimited
+      ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = old_unlimited_plus
+    end
+end
