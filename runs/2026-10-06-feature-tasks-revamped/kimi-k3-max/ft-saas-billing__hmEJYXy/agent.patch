diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..7e3b38a
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @old_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @old_unlimited_price = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    @old_unlimited_plus_price = ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_unlimited_plus"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @old_secret
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = @old_unlimited_price
+    ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = @old_unlimited_plus_price
+  end
+
+  test "checkout session completed links the stripe customer to the account" do
+    post_stripe_event type: "checkout.session.completed", object: {
+      id: "cs_test_123",
+      object: "checkout.session",
+      customer: "cus_123",
+      subscription: "sub_123",
+      client_reference_id: @account.id
+    }
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+  end
+
+  test "subscription created puts the account on the matching plan" do
+    travel_to Time.current do
+      post_stripe_event type: "customer.subscription.created", object: subscription_attributes(
+        metadata: { account_id: @account.id },
+        current_period_end: 1.month.from_now.to_i
+      )
+
+      assert_response :ok
+
+      subscription = @account.reload.subscription
+      assert_equal "cus_123", subscription.stripe_customer_id
+      assert_equal "sub_123", subscription.stripe_subscription_id
+      assert_equal "unlimited", subscription.plan_key
+      assert_equal "active", subscription.status
+      assert_equal 1.month.from_now.to_i, subscription.current_period_end.to_i
+      assert_equal Plan.unlimited, @account.plan
+    end
+  end
+
+  test "subscription created finds the account through the stripe customer" do
+    Account::Subscription.create! account: @account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123"
+
+    post_stripe_event type: "customer.subscription.created", object: subscription_attributes
+
+    assert_response :ok
+    assert_equal "unlimited", @account.reload.subscription.plan_key
+  end
+
+  test "subscription updated changes the plan and status" do
+    Account::Subscription.create! account: @account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123",
+      plan_key: "unlimited", status: "active"
+
+    post_stripe_event type: "customer.subscription.updated", object: subscription_attributes(
+      status: "past_due",
+      cancel_at: 1.month.from_now.to_i,
+      items: { object: "list", data: [ { id: "si_123", price: { id: "price_unlimited_plus", object: "price" } } ] }
+    )
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "unlimited_plus", subscription.plan_key
+    assert_equal "past_due", subscription.status
+    assert_equal 1.month.from_now.to_i, subscription.cancel_at.to_i
+    assert_equal Plan.unlimited_plus, @account.plan
+  end
+
+  test "subscription deleted drops the account back to free" do
+    Account::Subscription.create! account: @account, stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123",
+      plan_key: "unlimited", status: "active"
+
+    assert_equal Plan.unlimited, @account.reload.plan
+
+    post_stripe_event type: "customer.subscription.deleted", object: {
+      id: "sub_123",
+      object: "subscription",
+      customer: "cus_123",
+      status: "canceled"
+    }
+
+    assert_response :ok
+    assert_nil @account.reload.subscription
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "repeat checkouts update the existing subscription" do
+    Account::Subscription.create! account: @account, stripe_customer_id: "cus_old", stripe_subscription_id: "sub_old"
+
+    assert_no_difference -> { Account::Subscription.count } do
+      post_stripe_event type: "checkout.session.completed", object: {
+        id: "cs_test_456",
+        object: "checkout.session",
+        customer: "cus_new",
+        subscription: "sub_new",
+        client_reference_id: @account.id
+      }
+    end
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "cus_new", subscription.stripe_customer_id
+    assert_equal "sub_new", subscription.stripe_subscription_id
+  end
+
+  test "delivering the same event twice is idempotent" do
+    2.times do
+      post_stripe_event type: "customer.subscription.created", object: subscription_attributes(
+        metadata: { account_id: @account.id }
+      )
+
+      assert_response :ok
+    end
+
+    assert_equal 1, Account::Subscription.where(account: @account).count
+    assert_equal "unlimited", @account.reload.subscription.plan_key
+  end
+
+  test "unknown events are accepted and ignored" do
+    post_stripe_event type: "invoice.paid", object: { id: "in_123", object: "invoice" }
+
+    assert_response :ok
+  end
+
+  test "events for unknown accounts are accepted and ignored" do
+    assert_no_difference -> { Account::Subscription.count } do
+      post_stripe_event type: "customer.subscription.created", object: subscription_attributes(customer: "cus_unknown")
+    end
+
+    assert_response :ok
+  end
+
+  test "a bad signature is rejected" do
+    payload = { id: "evt_123", type: "customer.subscription.created", data: { object: subscription_attributes } }.to_json
+
+    post "/stripe/webhooks",
+      params: payload,
+      headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=1,v1=bogus" }
+
+    assert_response :bad_request
+  end
+
+  test "an unsigned request is rejected" do
+    post "/stripe/webhooks",
+      params: { id: "evt_123", type: "invoice.paid", data: { object: {} } }.to_json,
+      headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :bad_request
+  end
+
+  private
+    def subscription_attributes(overrides = {})
+      {
+        id: "sub_123",
+        object: "subscription",
+        customer: "cus_123",
+        status: "active",
+        cancel_at: nil,
+        metadata: {},
+        items: { object: "list", data: [ { id: "si_123", price: { id: "price_unlimited", object: "price" } } ] }
+      }.merge(overrides)
+    end
+
+    def post_stripe_event(type:, object:)
+      payload = { id: "evt_#{SecureRandom.hex(4)}", object: "event", type: type, data: { object: object } }.to_json
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, "whsec_test")
+
+      post "/stripe/webhooks",
+        params: payload,
+        headers: {
+          "CONTENT_TYPE" => "application/json",
+          "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(timestamp, signature)
+        }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..bdf6f93
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts are on the free plan by default" do
+    assert_equal Plan.free, @account.plan
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "cards used counts the account's cards" do
+    assert_equal @account.cards.count, @account.cards_used
+  end
+
+  test "exceeding card limit at the limit" do
+    Account.any_instance.stubs(:cards_used).returns(1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "not exceeding card limit one under" do
+    Account.any_instance.stubs(:cards_used).returns(999)
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit counts down from 100 cards out" do
+    Account.any_instance.stubs(:cards_used).returns(950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "not nearing card limit with more than 100 to go" do
+    Account.any_instance.stubs(:cards_used).returns(899)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid plans have no card limit" do
+    subscribe "unlimited"
+
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "an active subscription puts the account on its plan" do
+    subscribe "unlimited"
+
+    assert_equal Plan.unlimited, @account.plan
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited+ storage allowance" do
+    subscribe "unlimited_plus"
+
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "an inactive subscription falls back to free" do
+    subscribe "unlimited", status: "canceled"
+
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "comped accounts get unlimited+ at no charge" do
+    @account.comp!
+
+    assert @account.comped?
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp!
+
+    assert_not @account.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "comping is idempotent" do
+    @account.comp!
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp!
+    end
+  end
+
+  test "comped= comps and uncomps" do
+    @account.comped = true
+    assert @account.comped?
+
+    @account.comped = false
+    assert_not @account.reload.comped?
+  end
+
+  test "overridden card count replaces the real count" do
+    @account.override_limits card_count: 950
+
+    assert_equal 950, @account.cards_used
+    assert @account.nearing_card_limit?
+  end
+
+  test "overridden bytes used replaces the real usage" do
+    @account.override_limits bytes_used: 2.gigabytes
+
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "overriding one number leaves the other alone" do
+    @account.override_limits card_count: 950
+
+    assert_equal 950, @account.cards_used
+    assert_equal @account.storage_total&.bytes_stored || 0, @account.bytes_used
+  end
+
+  test "reset drops the override" do
+    @account.override_limits card_count: 950, bytes_used: 2.gigabytes
+    @account.reset_overridden_limits
+
