+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  # Stripe subscription statuses that still entitle the account to its plan.
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def active?
+    status.in? ACTIVE_STATUSES
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..bff6c32
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,93 @@
+# The plans an account can be on. Free is the default; paid plans are billed
+# through Stripe and mapped back to us via their Stripe price id.
+#
+#   Plan.free.name             # => "Free"
+#   Plan.find("unlimited")     # => #<Plan key="unlimited" ...>
+#   Current.account.plan       # => one of Plan.all
+class Plan
+  include ActiveModel::Model
+
+  attr_accessor :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  FREE = new \
+    key:             "free",
+    name:            "Free",
+    price_in_cents:  0,
+    card_limit:      1_000,
+    storage_limit:   1.gigabyte
+
+  UNLIMITED = new \
+    key:             "unlimited",
+    name:            "Unlimited",
+    price_in_cents:  2_000,
+    card_limit:      nil,
+    storage_limit:   5.gigabytes
+
+  UNLIMITED_PLUS = new \
+    key:             "unlimited_plus",
+    name:            "Unlimited+",
+    price_in_cents:  2_500,
+    card_limit:      nil,
+    storage_limit:   500.gigabytes
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  class << self
+    def all
+      ALL
+    end
+
+    def free
+      FREE
+    end
+
+    def unlimited
+      UNLIMITED
+    end
+
+    def unlimited_plus
+      UNLIMITED_PLUS
+    end
+
+    def paid
+      ALL.reject(&:free?)
+    end
+
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s } || Plan.free
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def stripe_price_id
+    ENV["STRIPE_#{key.upcase}_PRICE_ID"] if paid?
+  end
+
+  def free?
+    key == FREE.key
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price_in_dollars
+    price_in_cents / 100
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+  alias_method :eql?, :==
+
+  def hash
+    key.hash
+  end
+end
