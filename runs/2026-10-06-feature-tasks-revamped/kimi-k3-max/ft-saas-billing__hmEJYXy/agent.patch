+        stripe_customer_id: "cus_#{SecureRandom.hex(4)}",
+        stripe_subscription_id: "sub_#{SecureRandom.hex(4)}",
+        plan_key: plan_key,
+        status: status
+
+      @account.reload
+    end
+end
