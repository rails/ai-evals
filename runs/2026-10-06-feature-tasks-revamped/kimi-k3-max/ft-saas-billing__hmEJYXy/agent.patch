+++ b/saas/test/controllers/billings_controller_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as :kevin
+  end
+
+  test "show lists the paid plans" do
+    get saas.billing_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "h3", "Unlimited"
+    assert_select "h3", "Unlimited+"
+    assert_select "button[type=submit]", text: "Upgrade", count: 2
+  end
+
+  test "show is admin only" do
+    logout_and_sign_in_as :jz
+
+    get saas.billing_path(script_name: @account.slug)
+
+    assert_response :forbidden
+  end
+
+  test "checkout redirects to stripe checkout" do
+    with_stripe_price_ids do
+      session = stub(url: "https://checkout.stripe.com/c/pay/cs_test_123")
+      Stripe::Checkout::Session.expects(:create).with do |params|
+        params[:mode] == "subscription" &&
+          params[:client_reference_id] == @account.id &&
+          params[:line_items] == [ { price: "price_unlimited", quantity: 1 } ]
+      end.returns(session)
+
+      post saas.checkout_billing_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+    end
+  end
+
+  test "checkout reuses the existing stripe customer" do
+    with_stripe_price_ids do
+      Account::Subscription.create! account: @account, stripe_customer_id: "cus_123", plan_key: "unlimited", status: "active"
+
+      session = stub(url: "https://checkout.stripe.com/c/pay/cs_test_456")
+      Stripe::Checkout::Session.expects(:create).with { |params| params[:customer] == "cus_123" }.returns(session)
+
+      post saas.checkout_billing_path(script_name: @account.slug), params: { plan: "unlimited_plus" }
+
+      assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_456"
+    end
+  end
+
+  test "checkout is admin only" do
+    logout_and_sign_in_as :jz
+
+    post saas.checkout_billing_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_response :forbidden
+  end
+
+  test "portal redirects to the stripe customer portal" do
+    Account::Subscription.create! account: @account, stripe_customer_id: "cus_123", plan_key: "unlimited", status: "active"
+
+    session = stub(url: "https://billing.stripe.com/p/session/test_123")
+    Stripe::BillingPortal::Session.expects(:create).with { |params| params[:customer] == "cus_123" }.returns(session)
+
+    post saas.portal_billing_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test_123"
+  end
+
+  test "portal requires a stripe customer" do
+    post saas.portal_billing_path(script_name: @account.slug)
+
+    assert_redirected_to saas.billing_path(script_name: @account.slug)
+  end
+
+  private
+    def with_stripe_price_ids
+      old_unlimited, old_unlimited_plus = ENV["STRIPE_UNLIMITED_PRICE_ID"], ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+      ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+      ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = "price_unlimited_plus"
+      yield
+    ensure
+      ENV["STRIPE_UNLIMITED_PRICE_ID"] = old_unlimited
+      ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] = old_unlimited_plus
+    end
+end
