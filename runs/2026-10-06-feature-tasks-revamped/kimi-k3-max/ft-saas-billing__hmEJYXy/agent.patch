diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..4516d4b
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,43 @@
+# Support tools for account billing: comp/uncomp accounts and override or
+# reset the usage numbers their limits are measured against.
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.includes(:subscription, :billing_waiver, :overridden_limit).order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is now comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is no longer comped"
+  end
+
+  def override
+    @account.override_limits card_count: limit_param(:card_count), bytes_used: limit_param(:bytes_used)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden for #{@account.name}"
+  end
+
+  def reset
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limit overrides reset for #{@account.name}"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def limit_param(name)
+      params[name].presence
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..95b504a
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,56 @@
+# Account admins manage billing here. Stripe hosts both checkout and the
+# customer portal; we just create sessions and redirect to them. Subscription
+# changes come back through Stripe::WebhooksController.
+class BillingsController < ApplicationController
+  before_action :ensure_admin
+  before_action :ensure_subscription, only: :portal
+
+  def show
+    @plans = Plan.paid
+  end
+
+  def checkout
+    plan = Plan.find(params[:plan])
+
+    if plan.paid?
+      redirect_to create_checkout_session(plan).url, allow_other_host: true
+    else
+      redirect_to saas.billing_path, alert: "Pick a paid plan to upgrade to"
+    end
+  end
+
+  def portal
+    redirect_to create_portal_session.url, allow_other_host: true
+  end
+
+  private
+    def ensure_subscription
+      redirect_to saas.billing_path unless Current.account.subscription&.stripe_customer_id.present?
+    end
+
+    def create_checkout_session(plan)
+      Stripe::Checkout::Session.create checkout_session_params(plan)
+    end
+
+    # Stripe creates the customer at checkout; we learn its id from the
+    # checkout.session.completed webhook. Reuse it if we already know it.
+    def checkout_session_params(plan)
+      {
+        mode: "subscription",
+        client_reference_id: Current.account.id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: account_settings_url,
+        cancel_url: saas.billing_url
+      }.tap do |params|
+        if customer_id = Current.account.subscription&.stripe_customer_id.presence
+          params[:customer] = customer_id
+        end
+      end
+    end
+
+    def create_portal_session
+      Stripe::BillingPortal::Session.create \
+        customer: Current.account.subscription.stripe_customer_id,
+        return_url: account_settings_url
+    end
+end
