+#### Push notifications (optional)
+
+Fizzy can push notifications to phones and desktops via web push, so whatever lands in someone's notifications tray also reaches their devices.
+People turn this on per device from their notification settings.
+
+To enable it, generate a VAPID key pair:
+
+```sh
+bin/rails runner "puts WebPush.generate_key.to_h"
+```
+
+Then set the resulting pair of environment variables:
+
+- `VAPID_PUBLIC_KEY` - the public key, handed to browsers when subscribing
+- `VAPID_PRIVATE_KEY` - the private key, used to sign pushes so push services can verify your instance
+
 #### S3 storage (optional)
 
 If you'd prefer that uploaded files were stored in an S3 bucket rather than in your mounted volume, you can set that up.
diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..34b966c
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/david-phone",
+          p256dh_key: "phone-p256dh-key",
+          auth_key: "phone-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.order(:created_at).last
+    assert_equal "https://push.example.com/subscriptions/david-phone", subscription.endpoint
+    assert_equal "phone-p256dh-key", subscription.p256dh_key
+    assert_equal "phone-auth-key", subscription.auth_key
+  end
+
+  test "create again for the same endpoint refreshes the keys" do
+    subscription = push_subscriptions(:david_desktop)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "rotated-p256dh-key",
+          auth_key: "rotated-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "rotated-p256dh-key", subscription.reload.p256dh_key
+    assert_equal "rotated-auth-key", subscription.auth_key
+  end
+
+  test "create with an endpoint already registered to another user gets its own subscription" do
+    # A browser push endpoint belongs to the browser profile, so people sharing
+    # a browser, or using several accounts in it, each get their own row.
+    subscription = push_subscriptions(:kevin_phone)
+
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: subscription.p256dh_key,
+          auth_key: subscription.auth_key
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal users(:kevin), subscription.reload.user
+  end
+
+  test "create subscribes the current user, whatever user id is in the url" do
+    assert_no_difference -> { users(:kevin).push_subscriptions.count } do
+      assert_difference -> { @user.push_subscriptions.count }, +1 do
+        post user_push_subscriptions_path(users(:kevin)), params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/subscriptions/david-tablet",
+            p256dh_key: "tablet-p256dh-key",
+            auth_key: "tablet-auth-key"
+          }
+        }, as: :json
+      end
+    end
+  end
+
+  test "create requires the subscription details" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "" } }, as: :json
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires a push subscription payload" do
+    post user_push_subscriptions_path(@user), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
