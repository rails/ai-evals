+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,19 @@
+class Users::PushSubscriptionsController < ApplicationController
+  def create
+    @push_subscription = Current.user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params)
+
+    render json: { id: @push_subscription.id }, status: :created
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find(params[:id]).destroy!
+
+    head :no_content
+  end
+
+  private
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..6f96526
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,154 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Manages push notifications for the device in use. The browser's push
+// subscription is the source of truth: while it exists, we mirror it on the
+// server so that whatever lands in the tray also reaches this device.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String,
+    subscriptions: Array
+  }
+
+  connect() {
+    this.#reflectCurrentState()
+  }
+
+  async subscribe() {
+    if (this.#supported) {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        const subscription = await this.#subscribeBrowser()
+
+        if (subscription) {
+          await this.#registerOnServer(subscription)
+        }
+      }
+    }
+
+    this.#reflectCurrentState()
+  }
+
+  async unsubscribe() {
+    const subscription = await this.#browserSubscription
+
+    if (subscription) {
+      await subscription.unsubscribe()
+      await this.#deregisterFromServer(subscription)
+    }
+
+    this.#reflectCurrentState()
+  }
+
+  // Private
+
+  async #reflectCurrentState() {
+    const subscription = await this.#browserSubscription
+
+    this.element.classList.toggle(this.onClass, Boolean(subscription))
+
+    if (subscription) {
+      this.#hideDetails()
+      this.#registerOnServer(subscription) // Reconcile in case the server lost track of it
+    } else if (this.#blocked || !this.#supported) {
+      this.#showDetails()
+    } else {
+      this.#hideDetails()
+    }
+  }
+
+  async #subscribeBrowser() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+
+      return await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    } catch {
+      return null
+    }
+  }
+
+  get #browserSubscription() {
+    if (this.#supported) {
+      return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+    } else {
+      return Promise.resolve(null)
+    }
+  }
+
+  async #registerOnServer(subscription) {
+    if (!this.#knownOnServer(subscription)) {
+      try {
+        const response = await post(this.subscriptionsUrlValue, {
+          body: { push_subscription: this.#serialized(subscription) },
+          responseKind: "json"
+        })
+
+        if (response.ok) {
+          const { id } = await response.json
+          this.subscriptionsValue = [ ...this.subscriptionsValue, { id: id, endpoint: subscription.endpoint } ]
+        }
+      } catch {
+        // Reconciled again on a future visit
+      }
+    }
+  }
+
+  async #deregisterFromServer(subscription) {
+    const record = this.subscriptionsValue.find(record => record.endpoint === subscription.endpoint)
+
+    if (record) {
+      this.subscriptionsValue = this.subscriptionsValue.filter(it => it !== record)
+      await destroy(`${this.subscriptionsUrlValue}/${record.id}`, { responseKind: "json" })
+    }
+  }
+
+  #knownOnServer(subscription) {
+    return this.subscriptionsValue.some(record => record.endpoint === subscription.endpoint)
+  }
+
+  #serialized(subscription) {
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+      auth_key: this.#encodeKey(subscription.getKey("auth"))
+    }
+  }
+
+  #encodeKey(key) {
+    return btoa(String.fromCharCode(...new Uint8Array(key))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    const bytes = atob(padded)
+
+    return Uint8Array.from(bytes, byte => byte.charCodeAt(0))
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window &&
+      this.vapidPublicKeyValue.length > 0
+  }
+
+  get #blocked() {
+    return "Notification" in window && Notification.permission === "denied"
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+}
