@@ -0,0 +1,45 @@
+require "application_system_test_case"
+
+class PushNotificationSettingsTest < ApplicationSystemTestCase
+  test "push section reflects that this device is not subscribed" do
+    with_vapid_keys do
+      sign_in_as(users(:david))
+
+      visit notifications_settings_path
+
+      assert_selector "h2", text: "Push Notifications"
+      assert_selector ".notifications__off-message", text: "Push notifications are off for this device."
+      assert_selector "button", text: "Turn on"
+
+      assert_no_selector ".notifications__on-message"
+      assert_no_selector ".notifications-help"
+    end
+  end
+
+  test "help copy shows when push is not available" do
+    without_vapid_keys do
+      sign_in_as(users(:david))
+
+      visit notifications_settings_path
+
+      assert_selector "h2", text: "Push Notifications"
+      assert_selector ".notifications-help", visible: true
+    end
+  end
+
+  private
+    def with_vapid_keys
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = "system-test-public-key", "system-test-private-key"
+      yield
+    ensure
+      ENV.delete("VAPID_PUBLIC_KEY")
+      ENV.delete("VAPID_PRIVATE_KEY")
+    end
+
+    def without_vapid_keys
+      original_public_key, original_private_key = ENV.delete("VAPID_PUBLIC_KEY"), ENV.delete("VAPID_PRIVATE_KEY")
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = original_public_key, original_private_key
+    end
+end
