diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..0495a24
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "show published board without authentication" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(key: board.publication_key)
+
+    assert_response :success
+    assert_match board.name, response.body
+  end
+
+  test "show renders the board's columns and cards" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(key: board.publication_key)
+
+    assert_response :success
+    board.columns.each do |column|
+      assert_match column.name, response.body
+    end
+    assert_match cards(:buy_domain).title, response.body
+  end
+
+  test "show with an unknown key returns not found" do
+    get public_board_path(key: "no-such-key")
+
+    assert_response :not_found
+  end
+
+  test "show unpublished board returns not found" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication_key
+    board.unpublish
+
+    get public_board_path(key: key)
+
+    assert_response :not_found
+  end
+
+  test "show does not require authentication" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(key: board.publication_key)
+
+    assert_response :success
+    assert_nil Current.user
+  end
+
+test "show supports conditional GETs" do
+  board = boards(:writebook)
+  board.publish
+
+  get public_board_path(key: board.publication_key)
+  etag = response.headers["ETag"]
+
+  get public_board_path(key: board.publication_key), headers: { "If-None-Match" => etag }
+  assert_response :not_modified
+end
+
+  test "show is also available to authenticated users" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(key: board.publication_key)
+
+    assert_response :success
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..069afb1
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publish" do
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      @board.publish
+    end
+
+    assert @board.publication_key.present?
+  end
+
+  test "publication keys are unique" do
+    other_board = boards(:private)
+
+    @board.publish
+    other_board.publish
+
+    assert_not_equal @board.publication_key, other_board.publication_key
+  end
+
+  test "unpublish" do
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      @board.unpublish
+    end
+
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "public_url" do
+    @board.publish
+
+    assert_includes @board.public_url, "/public/boards/#{@board.publication_key}"
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+  end
+end
