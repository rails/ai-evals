+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show card without authentication" do
+    card = cards(:logo)
+
+    get public_board_card_path(board_key: @board.publication_key, number: card.number)
+
+    assert_response :success
+    assert_select "h1.card__title", text: /The logo isn.*t big enough/
+  end
+
+test "show card with an attached image" do
+  card = cards(:logo)
+  card.image.attach io: Rails.root.join("test/fixtures/files/moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+  get public_board_card_path(board_key: @board.publication_key, number: card.number)
+
+  assert_response :success
+end
+
+  test "show card with an unknown key returns not found" do
+    get public_board_card_path(board_key: "no-such-key", number: cards(:logo).number)
+
+    assert_response :not_found
+  end
+
+  test "show drafted card returns not found" do
+    card = @board.cards.create!(title: "Secret draft", status: :drafted, creator: users(:david))
+
+    get public_board_card_path(board_key: @board.publication_key, number: card.number)
+
+    assert_response :not_found
+  end
+
+  test "show card with an unknown number returns not found" do
+    get public_board_card_path(board_key: @board.publication_key, number: 9999)
+
+    assert_response :not_found
+  end
+
+  test "show card of an unpublished board returns not found" do
+    key = @board.publication_key
+    @board.unpublish
+
+    get public_board_card_path(board_key: key, number: cards(:logo).number)
+
+    assert_response :not_found
+  end
+end
