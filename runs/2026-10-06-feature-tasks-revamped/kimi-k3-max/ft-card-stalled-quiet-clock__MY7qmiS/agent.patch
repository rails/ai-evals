diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..3926e66
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,40 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS_COUNT = 3
+  BURST_COMMENTERS_COUNT = 2
+  BURST_WINDOW_FRACTION = 3
+
+  included do
+    scope :stalled, -> { where(bursted_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    bursted_at.present? && bursted_at <= STALLED_AFTER.ago
+  end
+
+  def track_burst(event)
+    if event.action.card_assigned? || event.action.card_reopened?
+      burst
+    elsif event.action.comment_created? && comment_burst?
+      burst
+    end
+  end
+
+  private
+    def burst
+      update! bursted_at: Time.current
+    end
+
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: burst_window.ago..)
+
+      recent_comments.count >= BURST_COMMENTS_COUNT &&
+        recent_comments.distinct.count(:creator_id) >= BURST_COMMENTERS_COUNT
+    end
+
+    def burst_window
+      auto_postpone_period.seconds / BURST_WINDOW_FRACTION
+    end
+end
