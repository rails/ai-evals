diff --git a/test/integration/stalled_cards_verification_test.rb b/test/integration/stalled_cards_verification_test.rb
new file mode 100644
index 0000000..b43adae
--- /dev/null
+++ b/test/integration/stalled_cards_verification_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class StalledCardsVerificationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "full stalled card lifecycle" do
+    card = cards(:text) # published, open, on writebook (90-day auto-close => 30-day burst window)
+    assert_not card.stalled?
+
+    # A burst: three comments from two people within a third of the auto-close period
+    card.comments.create!(creator: users(:david), body: "This is urgent")
+    card.comments.create!(creator: users(:jz), body: "Agreed, jumping on it")
+    card.comments.create!(creator: users(:david), body: "Any update?")
+
+    assert card.reload.bursted_at.present?, "card should have registered a burst"
+    assert_not card.stalled?, "card should not be stalled yet"
+
+    # Not listed while the burst is fresh
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_not_includes @response.parsed_body.pluck("number"), card.number
+
+    # Two weeks of silence later...
+    travel_to 15.days.from_now do
+      assert card.reload.stalled?, "card should be stalled after two quiet weeks"
+
+      # Listed under indexed_by=stalled...
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_includes @response.parsed_body.pluck("number"), card.number
+
+      # ... and flagged wherever cards are shown
+      get cards_path(indexed_by: "stalled")
+      assert_select ".card--stalled .card__stalled", text: "Stalled"
+
+      get card_path(card)
+      assert_select ".card--stalled .card__stalled", text: "Stalled"
+
+      get board_column_path(card.board, card.column)
+      assert_select ".card--stalled .card__stalled", text: "Stalled"
+    end
+
+    # Any activity resets it (a month later the original comments are outside the burst window)
+    travel_to 31.days.from_now do
+      assert card.reload.stalled?
+
+      post card_comments_path(card), params: { comment: { body: "Reviving this" } }, as: :turbo_stream
+      assert_response :success
+      assert card.reload.bursted_at.nil?, "activity should reset the burst"
+      assert_not card.stalled?
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_not_includes @response.parsed_body.pluck("number"), card.number
+
+      get card_path(card)
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "assignment burst then two quiet weeks is stalled" do
+    card = cards(:text)
+
+    post card_assignments_path(card), params: { assignee_id: users(:jz).id }, as: :turbo_stream
+    assert_response :success
+
+    assert card.reload.bursted_at.present?, "assignment should register a burst"
+
+    travel_to 15.days.from_now do
+      assert card.reload.stalled?
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_includes @response.parsed_body.pluck("number"), card.number
+    end
+  end
+
+  test "reopening a card registers a burst" do
+    card = cards(:shipping) # closed in fixtures
+
+    delete card_closure_path(card), as: :turbo_stream
+    assert_response :success
+
+    assert card.reload.bursted_at.present?, "reopening should register a burst"
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..8987874
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,148 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "bursts when three comments from at least two people land within a third of the auto-close period" do
+    card = create_card
+
+    card.comments.create!(creator: users(:david), body: "First")
+    assert_nil card.reload.bursted_at
+
+    card.comments.create!(creator: users(:jz), body: "Second")
+    assert_nil card.reload.bursted_at
+
+    card.comments.create!(creator: users(:kevin), body: "Third")
+    assert_not_nil card.reload.bursted_at
+  end
+
+  test "bursts when three comments come from exactly two people" do
+    card = create_card
+
+    travel_to 29.days.ago do
+      card.comments.create!(creator: users(:jz), body: "First")
+    end
+
+    travel_to 15.days.ago do
+      card.comments.create!(creator: users(:jz), body: "Second")
+    end
+
+    card.comments.create!(creator: users(:kevin), body: "Third")
+
+    assert_not_nil card.reload.bursted_at
+  end
+
+  test "does not burst when the comments come from a single person" do
+    card = create_card
+
+    3.times { |n| card.comments.create!(creator: users(:david), body: "Note #{n}") }
+
+    assert_nil card.reload.bursted_at
+  end
+
+  test "does not burst when comments fall outside a third of the auto-close period" do
+    card = create_card
+
+    travel_to 31.days.ago do
+      card.comments.create!(creator: users(:jz), body: "Early")
+    end
+
+    travel_to 29.days.ago do
+      card.comments.create!(creator: users(:david), body: "Middle")
+    end
+
+    card.comments.create!(creator: users(:kevin), body: "Late")
+
+    assert_nil card.reload.bursted_at
+  end
+
+  test "comments from the system do not count towards a burst" do
+    card = create_card
+
+    card.comments.create!(creator: users(:david), body: "First")
+    card.comments.create!(creator: users(:jz), body: "Second")
+    card.comments.create!(creator: users(:system), body: "Automated note")
+
+    assert_nil card.reload.bursted_at
+
+    card.comments.create!(creator: users(:kevin), body: "Third human comment")
+    assert_not_nil card.reload.bursted_at
+  end
+
+  test "bursts when someone is assigned" do
+    card = create_card
+
+    card.toggle_assignment(users(:jz))
+
+    assert_not_nil card.reload.bursted_at
+  end
+
+  test "bursts when reopened" do
+    card = create_card
+
+    card.close
+    assert_nil card.reload.bursted_at
+
+    card.reopen
+    assert_not_nil card.reload.bursted_at
+  end
+
+  test "any activity resets the burst" do
+    card = create_card
+
+    card.toggle_assignment(users(:jz))
+    assert_not_nil card.reload.bursted_at
+
+    travel_to 1.day.from_now do
+      card.update!(title: "Renamed")
+      assert_nil card.reload.bursted_at
+    end
+
+    travel_to 2.days.from_now do
+      card.comments.create!(creator: users(:kevin), body: "Ping")
+      assert_nil card.reload.bursted_at
+    end
+
+    travel_to 3.days.from_now do
+      card.toggle_assignment(users(:kevin))
+      assert_not_nil card.reload.bursted_at
+    end
+  end
+
+  test "a card with a burst is stalled after two weeks without activity" do
+    card = create_card
+
+    card.toggle_assignment(users(:jz))
+    assert_not card.reload.stalled?
+
+    travel_to 13.days.from_now do
+      assert_not card.reload.stalled?
+    end
+
+    travel_to 15.days.from_now do
