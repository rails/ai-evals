+<h1 class="title">Here’s what’s new in Fizzy</h1>
+<p class="subtitle"><%= pluralize(@notifications.size, "new notification") %> across your boards</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
