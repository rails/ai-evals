+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification" role="presentation">
+      <tr>
+        <td class="avatar__container">
+          <%= mail_avatar_tag notification.creator %>
+        </td>
+        <td>
+          <p class="notification__author"><%= notification.creator.name %></p>
+          <h3 class="card__title">
+            <%= link_to payload.url do %>
+              <% if notification.source.is_a?(Mention) %>
+                <span class="notificaton__mention"><%= payload.title %></span>
+              <% else %>
+                <%= payload.title %>
+              <% end %>
+            <% end %>
+          </h3>
+          <p class="notification__details"><%= payload.body %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer margin-block-start-double"><%= link_to "See all your notifications in Fizzy", notifications_url %></p>
