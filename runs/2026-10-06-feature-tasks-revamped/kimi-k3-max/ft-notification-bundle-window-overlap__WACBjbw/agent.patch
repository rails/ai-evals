+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,16 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:created_at)
+
+    mail to: @user.identity.email_address, subject: "Your Fizzy notification digest"
+  end
+
+  private
+    def default_url_options
+      # MailDeliveryJob runs without a Current.account, so scope URLs to the
+      # bundle's account explicitly.
+      super.merge(script_name: @bundle.account.slug)
+    end
+end
