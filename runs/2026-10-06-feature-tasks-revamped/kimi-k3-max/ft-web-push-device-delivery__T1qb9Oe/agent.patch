new file mode 100644
index 0000000..851e572
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,30 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    User::PushSubscription.subscribe(user: @user, **subscription_params)
+
+    head :created
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(endpoint: params[:endpoint])&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    # Push subscriptions belong to the device they're created on, so only their owner can manage them.
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c5fea5a
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,126 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static classes = [ "on" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+
+  async connect() {
+    if (this.#enabled) {
+      // Make sure the server always knows about this device's subscription.
+      this.#registerSubscription(await this.#subscription)
+    }
+
+    this.#update()
+  }
+
+  async enable() {
+    if (this.#supported) {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        this.#registerSubscription(await this.#subscribe())
+      }
+    }
+
+    this.#update()
+  }
+
+  async disable() {
+    const subscription = await this.#subscription
+
+    if (subscription) {
+      await subscription.unsubscribe()
+      await this.#destroySubscription(subscription)
+    }
+
+    this.#update()
+  }
+
+  // Private
+
+  async #update() {
+    const on = this.#enabled && !!(await this.#subscription)
+
+    this.element.classList.toggle(this.onClass, on)
+    this.detailsTargets.forEach(target => target.hidden = !this.#denied)
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #enabled() {
+    return this.#supported && Notification.permission === "granted"
+  }
+
+  get #denied() {
+    return this.#supported && Notification.permission === "denied"
+  }
+
+  get #subscription() {
+    return navigator.serviceWorker.getRegistration().then(registration => registration?.pushManager.getSubscription())
+  }
+
+  async #subscribe() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+
+      return await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+    }
+  }
+
+  async #registerSubscription(subscription) {
+    if (subscription) {
+      try {
+        const response = await post(this.subscriptionsUrlValue, {
+          contentType: "application/json",
+          body: JSON.stringify({ push_subscription: this.#subscriptionParams(subscription) })
+        })
+
+        if (!response.ok) {
+          console.error("Couldn't register the push subscription", response.statusCode)
+        }
+      } catch (error) {
+        console.error("Couldn't register the push subscription", error)
+      }
+    }
+  }
+
+  async #destroySubscription(subscription) {
+    try {
+      await destroy(`${this.subscriptionsUrlValue}?endpoint=${encodeURIComponent(subscription.endpoint)}`)
+    } catch (error) {
+      console.error("Couldn't remove the push subscription", error)
+    }
+  }
+
+  #subscriptionParams(subscription) {
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+      auth_key: this.#encodeKey(subscription.getKey("auth"))
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const data = atob(base64)
+
+    return Uint8Array.from([...data].map(char => char.charCodeAt(0)))
+  }
+
+  #encodeKey(key) {
+    return btoa(String.fromCharCode(...new Uint8Array(key || []))).replace(/\+/g, "-").replace(/\//g, "_")
+  }
+}
