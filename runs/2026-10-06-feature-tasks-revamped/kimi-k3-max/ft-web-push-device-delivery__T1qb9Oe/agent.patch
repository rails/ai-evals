index 0000000..cb64a3f
--- /dev/null
+++ b/test/jobs/notification/push_delivery_job_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Notification::PushDeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    User::PushSubscription.stubs(:configured?).returns(true)
+    User::PushSubscription.stubs(:vapid).returns(subject: "mailto:support@fizzy.do", public_key: "public-key", private_key: "private-key")
+  end
+
+  test "delivers what the tray says, linking to the card" do
+    notification = notifications(:layout_commented_kevin)
+    subscription = user_push_subscriptions(:kevins_desktop)
+
+    delivered = nil
+    WebPush.expects(:payload_send).with { |details| delivered = details }
+
+    Notification::PushDeliveryJob.perform_now(notification)
+
+    message = JSON.parse(delivered[:message], symbolize_names: true)
+    assert_equal "RE: Layout is broken", message[:title]
+    assert_equal "The text is overflowing the container.", message[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}#comment_#{comments(:layout_overflowing_david).id}", message[:url]
+
+    assert_equal subscription.endpoint, delivered[:endpoint]
+    assert_equal subscription.p256dh_key, delivered[:p256dh]
+    assert_equal subscription.auth_key, delivered[:auth]
+    assert_equal({ subject: "mailto:support@fizzy.do", public_key: "public-key", private_key: "private-key" }, delivered[:vapid])
+  end
+
+  test "delivers mention notifications" do
+    notification = notifications(:logo_mentioned_david)
+    subscription = user_push_subscriptions(:davids_phone)
+
+    delivered = nil
+    WebPush.expects(:payload_send).with { |details| delivered = details }
+
+    Notification::PushDeliveryJob.perform_now(notification)
+
+    message = JSON.parse(delivered[:message], symbolize_names: true)
+    assert_equal "JZ @mentioned you", message[:title]
+    assert_equal "I agree.", message[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}#comment_#{comments(:logo_agreement_jz).id}", message[:url]
+    assert_equal subscription.endpoint, delivered[:endpoint]
+  end
+
+  test "delivers to every subscription of the user" do
+    notification = notifications(:layout_commented_kevin)
+    users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/subscriptions/kevins-tablet",
+      p256dh_key: "p256dh-key", auth_key: "auth-key")
+
+    WebPush.expects(:payload_send).twice
+
+    Notification::PushDeliveryJob.perform_now(notification)
+  end
+
+  test "forgotten subscriptions are cleaned up" do
+    notification = notifications(:layout_commented_kevin)
+
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { users(:kevin).push_subscriptions.count }, -1 do
+      Notification::PushDeliveryJob.perform_now(notification)
+    end
+  end
+end
