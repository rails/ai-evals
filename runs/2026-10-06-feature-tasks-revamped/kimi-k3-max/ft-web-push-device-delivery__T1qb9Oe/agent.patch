diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..eead30b 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,37 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Push notifications - mirrors whatever lands in the tray
+
+self.addEventListener("push", (event) => {
+  if (event.data) {
+    const { title, body, url } = event.data.json()
+
+    event.waitUntil(
+      self.registration.showNotification(title, {
+        body: body,
+        icon: "/app-icon-192.png",
+        data: { url: url }
+      })
+    )
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = event.notification.data?.url || "/"
+
+  event.waitUntil(
+    clients.matchAll({ type: "window", includeUncontrolled: true }).then((windowClients) => {
+      const client = windowClients.find(client => "focus" in client)
+
+      if (client) {
+        return client.navigate(url).then(navigated => navigated.focus())
+      } else {
+        return clients.openWindow(url)
+      }
+    })
+  )
+})
