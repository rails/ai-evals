diff --git a/app/models/user/push_subscription.rb b/app/models/user/push_subscription.rb
new file mode 100644
index 0000000..d158415
--- /dev/null
+++ b/app/models/user/push_subscription.rb
@@ -0,0 +1,47 @@
+class User::PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def subscribe(user:, endpoint: nil, p256dh_key: nil, auth_key: nil)
+      # Re-subscribing refreshes the keys, and reclaims the subscription when
+      # the same browser signs in as another user.
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(user: user, p256dh_key: p256dh_key, auth_key: auth_key)
+      end
+    rescue ActiveRecord::RecordNotUnique
+      retry # Another process registered the same endpoint first
+    end
+
+    def configured?
+      vapid_credentials.all?(&:present?)
+    end
+
+    def vapid
+      { subject: "mailto:#{contact_address}", public_key: vapid_credentials.first, private_key: vapid_credentials.second }
+    end
+
+    private
+      def vapid_credentials
+        [ Rails.application.config.x.vapid.public_key, Rails.application.config.x.vapid.private_key ]
+      end
+
+      def contact_address
+        Mail::Address.new(ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")).address
+      end
+  end
+
+  def deliver(message)
+    WebPush.payload_send \
+      message: JSON.generate(message),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+end
