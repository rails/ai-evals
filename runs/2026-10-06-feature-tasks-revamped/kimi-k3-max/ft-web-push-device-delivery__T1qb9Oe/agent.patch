diff --git a/test/models/user/push_subscription_test.rb b/test/models/user/push_subscription_test.rb
new file mode 100644
index 0000000..528bd2b
--- /dev/null
+++ b/test/models/user/push_subscription_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class User::PushSubscriptionTest < ActiveSupport::TestCase
+  test "subscribe creates a subscription for the user" do
+    user = users(:jason)
+
+    assert_difference -> { user.push_subscriptions.count }, +1 do
+      User::PushSubscription.subscribe(user: user,
+        endpoint: "https://push.example.com/subscriptions/jasons-laptop",
+        p256dh_key: "p256dh-key", auth_key: "auth-key")
+    end
+
+    subscription = user.push_subscriptions.last
+    assert_equal user.account, subscription.account
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "subscribe refreshes the keys when the endpoint is already registered" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    assert_no_difference -> { User::PushSubscription.count } do
+      User::PushSubscription.subscribe(user: users(:david),
+        endpoint: subscription.endpoint,
+        p256dh_key: "rotated-p256dh-key", auth_key: "rotated-auth-key")
+    end
+
+    assert_equal "rotated-p256dh-key", subscription.reload.p256dh_key
+    assert_equal "rotated-auth-key", subscription.auth_key
+  end
+
+  test "subscribe reclaims the endpoint when the browser signs in as another user" do
+    subscription = user_push_subscriptions(:kevins_desktop)
+
+    assert_no_difference -> { User::PushSubscription.count } do
+      User::PushSubscription.subscribe(user: users(:david), endpoint: subscription.endpoint,
+        p256dh_key: subscription.p256dh_key, auth_key: subscription.auth_key)
+    end
+
+    assert_equal users(:david), subscription.reload.user
+  end
+
+  test "subscriptions require an endpoint and keys" do
+    subscription = User::PushSubscription.new(user: users(:david))
+
+    assert_not subscription.valid?
+    assert subscription.errors[:endpoint].any?
+    assert subscription.errors[:p256dh_key].any?
+    assert subscription.errors[:auth_key].any?
+  end
+
+  test "endpoints are unique" do
+    subscription = user_push_subscriptions(:davids_phone)
+    duplicate = subscription.dup
+
+    assert_not duplicate.valid?
+    assert duplicate.errors[:endpoint].any?
+  end
+
+  test "deliver sends the message through WebPush with the VAPID credentials" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    with_vapid public_key: "public-key", private_key: "private-key" do
+      WebPush.expects(:payload_send).with(
+        message: JSON.generate(title: "Hello", body: "World", url: "/123/cards/456"),
+        endpoint: subscription.endpoint,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: { subject: "mailto:support@fizzy.do", public_key: "public-key", private_key: "private-key" }
+      )
+
+      subscription.deliver(title: "Hello", body: "World", url: "/123/cards/456")
+    end
+  end
+
+  test "deliver removes subscriptions the push service has forgotten" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    with_vapid do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+      assert_difference -> { User::PushSubscription.count }, -1 do
+        subscription.deliver(title: "Hello")
+      end
+    end
+  end
+
+  test "deliver removes invalid subscriptions" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    with_vapid do
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(stub(body: ""), "push.example.com"))
+
+      assert_difference -> { User::PushSubscription.count }, -1 do
+        subscription.deliver(title: "Hello")
+      end
+    end
+  end
+
+  test "configured? depends on the VAPID key pair" do
+    with_vapid public_key: nil, private_key: nil do
+      assert_not User::PushSubscription.configured?
+    end
+
+    with_vapid public_key: "public-key", private_key: "private-key" do
+      assert User::PushSubscription.configured?
+    end
+  end
+
+  private
+    def with_vapid(public_key: "public-key", private_key: "private-key")
+      Rails.application.config.x.vapid.stubs(public_key: public_key, private_key: private_key)
+      yield
+    end
+end
