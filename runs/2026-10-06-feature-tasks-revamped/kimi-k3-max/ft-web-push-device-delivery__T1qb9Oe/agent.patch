@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "create" do
+    assert_difference -> { users(:david).push_subscriptions.count }, +1 do
+      post user_push_subscription_path(users(:david)), as: :json, params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/davids-laptop",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+
+    subscription = users(:david).push_subscriptions.find_by!(endpoint: "https://push.example.com/subscriptions/davids-laptop")
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+  end
+
+  test "create refreshes an existing subscription for the same endpoint" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    assert_no_difference -> { User::PushSubscription.count } do
+      post user_push_subscription_path(users(:david)), as: :json, params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "rotated-p256dh-key",
+          auth_key: "rotated-auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+    assert_equal "rotated-p256dh-key", subscription.reload.p256dh_key
+  end
+
+  test "create requires subscription details" do
+    assert_no_difference -> { User::PushSubscription.count } do
+      post user_push_subscription_path(users(:david)), as: :json, params: {}
+    end
+
+    assert_response :bad_request
+  end
+
+  test "create validates the subscription details" do
+    assert_no_difference -> { User::PushSubscription.count } do
+      post user_push_subscription_path(users(:david)), as: :json, params: { push_subscription: { endpoint: "" } }
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "create is rejected for another user" do
+    assert_no_difference -> { User::PushSubscription.count } do
+      post user_push_subscription_path(users(:kevin)), as: :json, params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/kevins-phone",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    subscription = user_push_subscriptions(:davids_phone)
+
+    assert_difference -> { users(:david).push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(users(:david), endpoint: subscription.endpoint)
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy ignores unknown endpoints" do
+    assert_no_difference -> { User::PushSubscription.count } do
+      delete user_push_subscription_path(users(:david), endpoint: "https://push.example.com/subscriptions/unknown")
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy is rejected for another user" do
+    subscription = user_push_subscriptions(:kevins_desktop)
+
+    assert_no_difference -> { User::PushSubscription.count } do
+      delete user_push_subscription_path(users(:kevin), endpoint: subscription.endpoint)
+    end
+
+    assert_response :forbidden
+  end
+end
