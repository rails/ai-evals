+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+        fresh_when etag: @page.records
+      end
+    end
+  end
+
+  private
+    # Mirrors the events shown in the HTML timeline (see User::DayTimeline),
+    # except that deprecated +card_collection_changed+ events are omitted and
+    # +card_title_changed+ events are included.
+    TIMELINEABLE_ACTIONS = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+      card_title_changed
+      comment_created
+    ]
+
+    def filtered_events
+      events = timelineable_events
+      events = events.where(creator_id: @filter.creators.ids) if @filter.creators.present?
+      events
+    end
+
+    def timelineable_events
+      Event
+        .preloaded
+        .includes(creator: :identity)
+        .where(board: boards, action: TIMELINEABLE_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def boards
+      @filter.boards.presence || Current.user.boards
+    end
+end
diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..bd8f74f 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,26 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # Event-specific details exposed through the activities API. Missing board,
+  # title, or column values are returned as empty strings.
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: assignee_ids }
+    when "card_board_changed"
+      { old_board: api_particular("old_board"), new_board: api_particular("new_board") }
+    when "card_title_changed"
+      { old_title: api_particular("old_title"), new_title: api_particular("new_title") }
+    when "card_triaged"
+      { column: api_particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def api_particular(key)
+      particulars.to_h.dig("particulars", key).to_s
+    end
 end
