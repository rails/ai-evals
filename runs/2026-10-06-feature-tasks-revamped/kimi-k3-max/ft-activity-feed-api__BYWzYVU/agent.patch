+# Activities
+
+Activities are the events that happen in an account - cards being added, moved, closed, assigned, commented on, and so on. This is the same activity you see on the HTML timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of events from boards you can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user ID(s) who triggered the events |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_triaged",
+    "created_at": "2025-12-05T19:38:48.540Z",
+    "description": "David moved \"Plain text mentions\" to \"In progress\"",
+    "particulars": {
+      "column": "In progress"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  },
+  {
+    "id": "03f5va0km6af1gr9tevv3zdy1",
+    "action": "comment_created",
+    "created_at": "2025-12-05T19:37:12.000Z",
+    "description": "David commented on \"Plain text mentions\"",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3#comment_03f5va0gz2c5j2by0ksnxp9m0",
+    "eventable_type": "Comment",
+    "eventable": {
+      "id": "03f5va0gz2c5j2by0ksnxp9m0",
+      "created_at": "2025-12-05T19:37:12.000Z",
+      "updated_at": "2025-12-05T19:37:12.000Z",
+      "body": {
+        "plain_text": "This looks great!",
+        "html": "<div class=\"action-text-content\">This looks great!</div>"
+      }
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` fields use the same representations as the [cards](cards.md), [comments](comments.md), [boards](boards.md), and [users](users.md) endpoints. The `description` is the plain-text form of the event description shown on the timeline.
+
+For card events, `url` opens the card. For comment events, `url` opens the card where the comment was posted and jumps to that comment.
+
+### Actions
+
+The timeline mirrors the events shown in the app, with two exceptions: deprecated `card_collection_changed` events are omitted, and `card_title_changed` events are included. The possible actions are:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
+
+### Particulars
+
+The `particulars` object exposes event-specific details:
+
+| Action(s) | Particulars |
+|-----------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` - the ID(s) of the assigned or unassigned user(s) |
+| `card_board_changed` | `old_board` and `new_board` - the board names before and after the move |
+| `card_title_changed` | `old_title` and `new_title` - the card titles before and after the rename |
+| `card_triaged` | `column` - the name of the column the card was moved into |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..6fe99e6
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,238 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index as JSON returns accessible activity, newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+
+    expected = Event.where(board: boards(:writebook)).order(created_at: :desc, id: :desc)
+    assert_equal expected.pluck(:id), @response.parsed_body.pluck("id")
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index omits deprecated card_collection_changed events but includes card_title_changed events" do
+    Event.create! action: "card_collection_changed", creator: users(:david), board: boards(:writebook),
+      eventable: cards(:logo), particulars: { old_collection: "Writebook", new_collection: "Private board" }
+    cards(:logo).track_event "title_changed", creator: users(:david),
+      particulars: { old_title: "The logo isn't big enough", new_title: "Bigger logo, please" }
+
+    get activities_path(format: :json)
+
+    actions = @response.parsed_body.pluck("action")
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "index renders card event details" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal "card_published", activity["action"]
+    assert_equal events(:logo_published).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal events(:logo_published).description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal polymorphic_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+  end
+
+  test "index links comment events to the comment on their card" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal events(:layout_commented).description_for(users(:david)).to_plain_text, activity["description"]
+    assert_equal polymorphic_url(comments(:layout_overflowing_david)), activity["url"]
+    assert_includes activity["url"], "##{ActionView::RecordIdentifier.dom_id(comments(:layout_overflowing_david))}"
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+  end
+
+  test "assignment events include assignee_ids in particulars" do
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+  end
+
+  test "board change events include the old and new boards in particulars" do
+    cards(:logo).track_event "board_changed", creator: users(:david),
+      particulars: { old_board: "Writebook", new_board: "Private board" }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+  end
+
+  test "title change events include the old and new titles in particulars" do
+    with_current_user users(:david) do
+      cards(:logo).update! title: "The logo is not big enough at all"
+    end
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "The logo is not big enough at all" },
+      activity["particulars"])
+  end
+
+  test "triage events include the column in particulars" do
+    cards(:logo).track_event "triaged", creator: users(:david), particulars: { column: "In progress" }
+
+    get activities_path(format: :json)
+
+    activity = @response.parsed_body.find { it["action"] == "card_triaged" }
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "missing particular values are returned as empty strings" do
+    cards(:logo).track_event "triaged", creator: users(:david)
+    cards(:logo).track_event "board_changed", creator: users(:david)
+    cards(:logo).track_event "title_changed", creator: users(:david)
+
+    get activities_path(format: :json)
+
+    triaged = @response.parsed_body.find { it["action"] == "card_triaged" }
+    assert_equal({ "column" => "" }, triaged["particulars"])
+
+    board_changed = @response.parsed_body.find { it["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_changed["particulars"])
+
+    title_changed = @response.parsed_body.find { it["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_changed["particulars"])
+  end
+
+  test "index filters by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { it.dig("creator", "id") }.uniq
+  end
+
+  test "index filters by board_ids" do
+    with_current_user users(:kevin) do
+      boards(:private).cards.create! title: "Secret plans", creator: users(:kevin), status: "published"
+    end
+
+    logout_and_sign_in_as :kevin
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal [ boards(:private).id ], @response.parsed_body.map { it.dig("board", "id") }.uniq
+  end
+
+  test "index only returns activity from boards the current user can access" do
+    with_current_user users(:kevin) do
+      boards(:private).cards.create! title: "Secret plans", creator: users(:kevin), status: "published"
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert @response.parsed_body.none? { it.dig("board", "id") == boards(:private).id }
+
+    logout_and_sign_in_as :kevin
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert @response.parsed_body.any? { it.dig("board", "id") == boards(:private).id }
+  end
+
+  test "index paginates" do
+    5.times do |index|
+      Event.create! action: "card_published", creator: users(:david), board: boards(:writebook),
+        eventable: cards(:logo), created_at: (index + 1).minutes.ago
+    end
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_equal "16", @response.headers["X-Total-Count"]
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    assert next_page.present?, "Expected a Link header pointing to the next page"
+
+    get next_page
+
+    assert_response :success
+    assert_equal 1, @response.parsed_body.size
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index is cacheable with etags" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    etag = @response.headers["ETag"]
+    assert etag.present?
+
+    get activities_path(format: :json), headers: { "If-None-Match" => etag }
+
+    assert_response :not_modified
+  end
+
+  test "index returns an empty array when the user cannot access any boards" do
+    logout_and_sign_in_as :jason
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "index filters by creator_ids and board_ids combined" do
+    logout_and_sign_in_as :kevin
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+
+    @response.parsed_body.each do |activity|
+      assert_equal users(:kevin).id, activity.dig("creator", "id")
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+
+  test "index authenticates with an access token" do
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
