@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created automatically with the webhook" do
+    assert @tracker.persisted?
+    assert_equal @webhook.account, @tracker.account
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "created on demand for webhooks that predate delinquency tracking" do
+    webhook = webhooks(:active)
+
+    assert_difference "Webhook::DelinquencyTracker.count", 1 do
+      assert_equal webhook, webhook.delinquency_tracker.webhook
+    end
+  end
+
+  test "track_failure counts consecutive failures from the first one" do
+    @tracker.track_failure
+
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert_not_nil @tracker.first_failure_at
+
+    @tracker.track_failure
+
+    assert_equal 2, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "ten consecutive failures within an hour deactivate the webhook" do
+    9.times { @tracker.track_failure }
+    assert @webhook.reload.active?
+
+    @tracker.track_failure
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "the streak resets when the webhook is deactivated" do
+    Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES.times { @tracker.track_failure }
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "ten failures spread over more than an hour do not deactivate the webhook" do
+    @tracker.track_failure
+
+    travel 30.minutes do
+      8.times { @tracker.track_failure }
+    end
+
+    travel 61.minutes do
+      @tracker.track_failure
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "track_success resets the streak" do
+    3.times { @tracker.track_failure }
+    @tracker.track_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "track_success on a clean tracker does nothing" do
+    assert_no_changes -> { @tracker.reload.attributes } do
+      @tracker.track_success
+    end
+  end
+
+  test "activating a webhook resets its tracker" do
+    3.times { @tracker.track_failure }
+
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+end
