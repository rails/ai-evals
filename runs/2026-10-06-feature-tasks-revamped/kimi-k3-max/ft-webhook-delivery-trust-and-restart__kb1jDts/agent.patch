@@ -10,6 +26,31 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later, if: :pending?
+
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).delete_all
+    end
+  end
+
+  # Delivers exactly once: only the first call to claim the pending delivery
+  # posts to the receiver; repeated or concurrent calls find the delivery no
+  # longer pending and do nothing.
+  def deliver
+    if claim_for_delivery
+      record_request
+
+      begin
+        record_response post_event
+      rescue *CONNECTION_ERRORS
+        record_error
+      end
+
+      track_outcome
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +70,109 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def deliver_later
+      Webhook::DeliveryJob.perform_later(self)
+    end
+
+    def claim_for_delivery
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def record_request
+      update! request: { headers: request_headers }
+    end
+
+    def post_event
+      if ip_address = SsrfProtection.resolve_public_ip(uri.host)
+        post_event_to ip_address
+      else
+        raise DestinationUnreachable
+      end
+    end
+
+    def post_event_to(ip_address)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = ip_address
+      http.use_ssl = uri.scheme == "https"
+      http.max_retries = 0
+      http.open_timeout = http.read_timeout = http.write_timeout = ENDPOINT_TIMEOUT
+
+      http.request request_to_endpoint
+    end
+
+    def request_to_endpoint
+      Net::HTTP::Post.new(uri.request_uri, request_headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def request_headers
+      @request_headers ||= {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def signature
+      "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)}"
+    end
+
+    def payload
+      @payload ||= renderer.render \
+        template: "webhooks/event", formats: :json, layout: false,
+        assigns: { event: event }
+    end
+
+    def renderer
+      ApplicationController.renderer.new(renderer_env)
+    end
+
+    # Renders outside of a request, so point URL generation at this instance's
+    # public URL and scope it to the delivery's account.
+    def renderer_env
+      url_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+
+      { script_name: account.slug }.tap do |env|
+        env[:http_host] = http_host_from(url_options) if url_options[:host].present?
+        env[:https] = true if url_options[:protocol].to_s.start_with?("https")
+      end
+    end
+
+    def http_host_from(url_options)
+      host = url_options[:host].to_s
+
+      if url_options[:port].present? && host.exclude?(":")
+        "#{host}:#{url_options[:port]}"
+      else
+        host
+      end
+    end
+
+    def uri
+      @uri ||= URI(webhook.url)
+    end
+
+    def record_response(http_response)
+      update! \
+        state: :completed,
+        response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+    end
+
+    def record_error
+      update! state: :errored, response: { error: "destination_unreachable" }
+    end
+
+    def track_outcome
+      if succeeded?
+        webhook.delinquency_tracker.track_success
+      else
+        webhook.delinquency_tracker.track_failure
+      end
+    end
 end
