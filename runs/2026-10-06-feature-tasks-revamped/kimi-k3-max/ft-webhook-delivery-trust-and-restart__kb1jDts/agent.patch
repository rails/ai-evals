+class AddUniqueIndexesToWebhookDeliveriesAndDelinquencyTrackers < ActiveRecord::Migration[8.2]
+  def change
+    # One delivery per webhook and event pair is what makes deliveries exactly-once.
+    remove_index :webhook_deliveries, :webhook_id
+    add_index :webhook_deliveries, %i[ webhook_id event_id ], unique: true
+
+    # A webhook has exactly one delinquency tracker.
+    remove_index :webhook_delinquency_trackers, :webhook_id
