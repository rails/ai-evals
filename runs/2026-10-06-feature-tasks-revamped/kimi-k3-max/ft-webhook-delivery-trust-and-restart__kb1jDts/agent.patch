 class Webhook::Delivery < ApplicationRecord
+  # Receivers are given this long to answer before a delivery is given up.
+  ENDPOINT_TIMEOUT = 5
+  # The delivery log is kept for a week.
+  RETENTION_PERIOD = 7.days
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  # Raised when the receiver's host can't be resolved to a public IP address.
+  class DestinationUnreachable < StandardError; end
+
+  # Failures talking to the receiver, all logged as "destination_unreachable".
+  CONNECTION_ERRORS = [
+    DestinationUnreachable,
+    IOError, SocketError, SystemCallError, Timeout::Error,
+    Net::HTTPError, OpenSSL::SSL::SSLError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
