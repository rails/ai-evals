diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..01e60de
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,54 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A receiver that keeps failing gets switched off: MAX_CONSECUTIVE_FAILURES
+  # failures in a row, all within FAILURES_WINDOW of the first one. A success,
+  # or failures too spread out in time, keeps the webhook on.
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURES_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track_success
+    with_lock do
+      reset if tracking_failures?
+    end
+  end
+
+  def track_failure
+    with_lock do
+      restart_streak if streak_expired?
+
+      self.consecutive_failures_count += 1
+
+      if delinquent?
+        webhook.deactivate
+        self.first_failure_at = nil
+        self.consecutive_failures_count = 0
+      end
+
+      save!
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    def tracking_failures?
+      consecutive_failures_count > 0
+    end
+
+    def streak_expired?
+      first_failure_at.nil? || first_failure_at.before?(FAILURES_WINDOW.ago)
+    end
+
+    def restart_streak
+      self.first_failure_at = Time.current
+      self.consecutive_failures_count = 0
+    end
+
+    def delinquent?
+      consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES
+    end
+end
