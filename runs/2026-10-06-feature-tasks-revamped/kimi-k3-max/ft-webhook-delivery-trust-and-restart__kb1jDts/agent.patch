@@ -0,0 +1,70 @@
+require "test_helper"
+
+# End-to-end: an event happens, the receiver gets a POST about it, the log
+# shows how it went — exactly once — and a receiver that keeps failing gets
+# switched off.
+class Webhook::DeliveryFlowTest < ActiveSupport::TestCase
+  WEBHOOK_URL = "https://hooks.example.com/flow"
+  WEBHOOK_PUBLIC_IP = "142.250.185.206"
+
+  setup do
+    @board = boards(:writebook)
+    @webhook = @board.webhooks.create!(name: "Flow", url: WEBHOOK_URL, subscribed_actions: %w[ card_published ])
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    # The board's fixture webhook receives the same events; keep its requests off the network.
+    stub_request(:post, "https://api.example.com/webhooks").to_return(status: 200)
+  end
+
+  test "an event is posted to the receiver exactly once and logged" do
+    request = stub_request(:post, WEBHOOK_URL).with(ipaddr: WEBHOOK_PUBLIC_IP).to_return(status: 200)
+
+    card = nil
+    Current.with(user: users(:david)) do
+      perform_enqueued_jobs do
+        card = @board.cards.create!(title: "Flow card", creator: users(:david))
+        card.publish
+      end
+    end
+
+    assert_requested request, times: 1
+
+    delivery = @webhook.deliveries.sole
+    assert_equal "card_published", delivery.event.action
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+    assert_equal WEBHOOK_URL, @webhook.url
+    assert_equal "application/json", delivery.request[:headers]["Content-Type"]
+    assert_not @webhook.delinquency_tracker.reload.consecutive_failures_count.positive?
+  end
+
+  test "a receiver that keeps failing gets switched off and stops receiving events" do
+    stub_request(:post, WEBHOOK_URL).to_return(status: 500)
+
+    Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES.times do
+      perform_enqueued_jobs do
+        @board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      end
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES, @webhook.deliveries.count
+
+    # Switched off: no new deliveries are recorded for new events...
+    assert_no_difference "@webhook.deliveries.count" do
+      perform_enqueued_jobs do
+        @board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      end
+    end
+
+    # ...until it is switched back on.
+    @webhook.activate
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+
+    assert_difference "@webhook.deliveries.count", 1 do
+      perform_enqueued_jobs do
+        @board.events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      end
+    end
+  end
+end
