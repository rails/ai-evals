+class Webhook::DeliveryDeliveryTest < ActiveSupport::TestCase
+  WEBHOOK_PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+    @event = events(:layout_commented)
+    @delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+  end
+
+  test "deliver posts the event payload to the webhook url" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    request = stub_request(:post, "https://example.com/webhook").with(ipaddr: WEBHOOK_PUBLIC_IP).to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested request
+    assert @delivery.completed?
+    assert @delivery.succeeded?
+    assert_equal 200, @delivery.response[:code]
+  end
+
+  test "deliver sends a signed JSON payload" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+
+    signature = body = nil
+    stub_request(:post, "https://example.com/webhook")
+      .with(ipaddr: WEBHOOK_PUBLIC_IP) { |request| body = request.body; signature = request.headers["X-Webhook-Signature"]; true }
+      .to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_equal "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)}", signature
+    assert_equal "application/json", @delivery.request[:headers]["Content-Type"]
+    assert_equal Webhook::Delivery::USER_AGENT, @delivery.request[:headers]["User-Agent"]
+    assert_equal @event.created_at.utc.iso8601, @delivery.request[:headers]["X-Webhook-Timestamp"]
+    assert_equal @event.id, JSON.parse(body)["id"]
+  end
+
+  test "deliver pins the connection to the resolved public IP" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested(:post, "https://example.com/webhook") { |request| request.uri.host == "example.com" }
+  end
+
+  test "delivering exactly once" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").with(ipaddr: WEBHOOK_PUBLIC_IP).to_return(status: 200)
+
+    @delivery.deliver
+    @delivery.deliver
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested :post, "https://example.com/webhook", times: 1
+  end
+
+  test "deliver is a no-op when the delivery is not pending" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").to_return(status: 200)
+
+    @delivery.update! state: :completed, response: { code: 200 }
+    @delivery.deliver
+
+    assert_not_requested :post, "https://example.com/webhook"
+  end
+
+  test "a non-2xx response completes the delivery as failed and tracks the failure" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").with(ipaddr: WEBHOOK_PUBLIC_IP).to_return(status: 500)
+
+    @delivery.deliver
+
+    assert @delivery.completed?
+    assert @delivery.failed?
+    assert_not @delivery.succeeded?
+    assert_equal 500, @delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a successful delivery resets the delinquency tracker" do
+    @webhook.delinquency_tracker.track_failure
+
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").with(ipaddr: WEBHOOK_PUBLIC_IP).to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "an unreachable destination errors the delivery and tracks the failure" do
+    stub_dns_resolution # no addresses resolve
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert @delivery.failed?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a connection failure errors the delivery" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").to_raise(Errno::ECONNREFUSED)
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "a request timeout errors the delivery" do
+    stub_dns_resolution WEBHOOK_PUBLIC_IP
+    stub_request(:post, "https://example.com/webhook").to_timeout
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "creating a pending delivery enqueues its delivery" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: @webhook, event: events(:logo_published))
+    end
+  end
+
+  test "creating an already delivered delivery does not enqueue its delivery" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      Webhook::Delivery.create!(webhook: @webhook, event: events(:logo_published), state: :completed, response: { code: 200 })
+    end
+  end
+
+  test "cleanup removes deliveries older than a week and keeps recent ones" do
+    old_delivery = @delivery
+    old_delivery.update_columns(created_at: Webhook::Delivery::RETENTION_PERIOD.ago - 1.minute)
+    recent_delivery = Webhook::Delivery.create!(webhook: @webhook, event: events(:logo_published))
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id)
+  end
+end
