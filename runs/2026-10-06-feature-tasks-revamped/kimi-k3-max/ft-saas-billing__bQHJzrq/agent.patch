diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..32abed2
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,72 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing ]
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  class << self
+    # Applies a Stripe subscription object (from a customer.subscription.* webhook
+    # event) to the matching account. Creates or updates the account's subscription.
+    def sync_from_stripe(stripe_subscription)
+      if account = find_account(stripe_subscription)
+        subscription = find_or_initialize_by(account: account)
+
+        subscription.update!(
+          stripe_customer_id:      stripe_subscription[:customer],
+          stripe_subscription_id:  stripe_subscription[:id],
+          plan_key:                plan_key_from(stripe_subscription),
+          status:                  stripe_subscription[:status],
+          current_period_end:      timestamp_from(stripe_subscription, :current_period_end),
+          cancel_at:               timestamp_from(stripe_subscription, :cancel_at)
+        )
+      else
+        Rails.logger.warn "Stripe subscription #{stripe_subscription[:id]} could not be matched to an account"
+        nil
+      end
+    end
+
+    private
+      def find_account(stripe_subscription)
+        account_id = stripe_subscription[:metadata].to_h[:account_id]
+        account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id) if account_id.present?
+
+        account ||=
+          find_by(stripe_subscription_id: stripe_subscription[:id])&.account ||
+          find_by(stripe_customer_id: stripe_subscription[:customer])&.account
+
+        account
+      end
+
+      def plan_key_from(stripe_subscription)
+        if (plan_key = stripe_subscription[:metadata].to_h[:plan_key]).present?
+          plan_key
+        else
+          Plan.all.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id_from(stripe_subscription) }&.key
+        end
+      end
+
+      def price_id_from(stripe_subscription)
+        stripe_subscription[:items]&.data&.first&.[](:price)&.[](:id)
+      end
+
+      def timestamp_from(stripe_subscription, field)
+        epoch = stripe_subscription[field]
+        epoch ||= stripe_subscription[:items]&.data&.first&.[](field) if field == :current_period_end
+
+        Time.at(epoch).utc if epoch
+      end
+  end
+
+  def plan
+    Plan[plan_key] || Plan.free
+  end
+
+  def active?
+    status.in? ACTIVE_STATUSES
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..c28ccf1
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,61 @@
+class Plan
+  include ActiveModel::Model
+  include ActiveModel::Attributes
+
+  FREE_KEY = "free"
+  COMPED_KEY = "unlimited_plus"
+
+  attribute :key, :string
+  attribute :name, :string
+  attribute :price_in_cents, :integer, default: 0
+  attribute :card_limit, :integer
+  attribute :storage_limit, :integer
+
+  PLANS = [
+    new(key: FREE_KEY,        name: "Free",       price_in_cents: 0,     card_limit: 1_000, storage_limit: 1.gigabyte),
+    new(key: "unlimited",     name: "Unlimited",  price_in_cents: 20_00, storage_limit: 5.gigabytes),
+    new(key: "unlimited_plus", name: "Unlimited+", price_in_cents: 25_00, storage_limit: 500.gigabytes)
+  ].freeze
+
+  class << self
+    def all
+      PLANS
+    end
+
+    def [](key)
+      all.find { |plan| plan.key == key.to_s }
+    end
+
+    def free
+      self[FREE_KEY]
+    end
+
+    def comped
+      self[COMPED_KEY]
+    end
+  end
+
+  def free?
+    key == FREE_KEY
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def monthly_price
+    price_in_cents / 100.0
+  end
+
+  def stripe_price_id
+    ENV["STRIPE_PRICE_ID_#{key.upcase}"] if paid?
+  end
+
+  def to_param
+    key
+  end
+end
