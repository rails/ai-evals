index 0000000..56f6c3e
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,170 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: "37signals"
+    assert_select "a", text: "Initech LLC"
+  end
+
+  test "account names link to their admin page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: "Initech LLC"
+    end
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can view an account with its support tools" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "h1", text: "Initech LLC"
+    assert_select "strong", text: "Free"
+    assert_select "button[type=submit]", text: "Comp"
+    assert_select "button[type=submit]", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=?]", "Override"
+    assert_select "button[type=submit]", text: "Reset"
+  end
+
+test "admin page shows subscription details and comped badge" do
+  sign_in_as :david
+
+  @account.create_subscription!(plan_key: "unlimited", status: "active",
+    stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1",
+    current_period_end: 1_800_000_000)
+  @account.comp
+
+  untenanted do
+    get saas.admin_account_path(@account)
+  end
+
+  assert_response :success
+  assert_select "strong", text: "Unlimited+"
+  assert_select "span", text: "(comped)"
+  assert_select "div", text: /sub_1 is active/
+end
+
+  test "non-staff cannot view an account" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can comp an account" do
+    sign_in_as :david
+
+    assert_difference -> { Account::BillingWaiver.count } do
+      untenanted do
+        post saas.comp_admin_account_path(@account)
+
+        assert_redirected_to saas.admin_account_path(@account)
+      end
+    end
+
+    assert @account.reload.comped?
+  end
+
+  test "staff can uncomp an account" do
+    sign_in_as :david
+
+    @account.comp
+
+    assert_difference -> { Account::BillingWaiver.count }, -1 do
+      untenanted do
+        post saas.uncomp_admin_account_path(@account)
+
+        assert_redirected_to saas.admin_account_path(@account)
+      end
+    end
+
+    assert_not @account.reload.comped?
+  end
+
+  test "staff can override an account's limits" do
