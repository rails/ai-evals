+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is now comped"
+  end
+
+  def uncomp
+    @account.uncomp
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is no longer comped"
+  end
+
+  def override
+    @account.override_limits(**overridden_limit_params)
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden for #{@account.name}"
+  end
+
+  def reset
+    @account.reset_overridden_limits
+    redirect_to saas.admin_account_path(@account), notice: "Limits reset for #{@account.name}"
+  end
+
+  private
+    def set_account
+      @account = Account.find(params[:id])
+    end
+
+    def overridden_limit_params
+      submitted = params[:overridden_limit].presence || params
+
+      {
+        card_count: submitted[:card_count].presence,
+        bytes_used: submitted[:bytes_used].presence
+      }
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..e53f305
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,44 @@
+class BillingsController < ApplicationController
+  before_action :ensure_admin, only: %i[ checkout portal ]
+
+  def show
+    @plans = Plan.all
+  end
+
+  def checkout
+    if (plan = Plan[params[:plan]])&.paid?
+      redirect_to create_checkout_session(plan).url, allow_other_host: true
+    else
+      redirect_to saas.billing_path, alert: "There's no such plan to upgrade to"
+    end
+  end
+
+  def portal
+    if (customer = Current.account.subscription&.stripe_customer_id).present?
+      session = Stripe::BillingPortal::Session.create(customer: customer, return_url: account_settings_url)
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to saas.billing_path
+    end
+  end
+
+  private
+    def create_checkout_session(plan)
+      Stripe::Checkout::Session.create(**checkout_session_params(plan))
+    end
+
+    def checkout_session_params(plan)
+      {}.tap do |params|
+        params[:mode]              = "subscription"
+        params[:line_items]        = [ { price: plan.stripe_price_id, quantity: 1 } ]
+        params[:client_reference_id] = Current.account.id
+        params[:subscription_data] = { metadata: { account_id: Current.account.id, plan_key: plan.key } }
+        params[:success_url]       = account_settings_url
+        params[:cancel_url]        = saas.billing_url
+
+        if (customer = Current.account.subscription&.stripe_customer_id).present?
+          params[:customer] = customer
+        end
+      end
+    end
+end
