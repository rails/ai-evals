+require "test_helper"
+
+class Account::BillingLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts are on the free plan by default" do
+    assert @account.free?
+    assert_not @account.paid?
+    assert_equal "Free", @account.plan.name
+  end
+
+  test "free plan limits cards to 1,000" do
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "exceeding card limit when card count reaches the limit" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "not exceeding card limit under the limit" do
+    @account.update_column(:cards_count, 999)
+
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit within 100 cards of the limit" do
+    @account.update_column(:cards_count, 900)
+
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+  end
+
+  test "not nearing card limit when well under the threshold" do
+    @account.update_column(:cards_count, 899)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "not nearing card limit when already exceeding it" do
+    @account.update_column(:cards_count, 1_001)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "an active subscription puts the account on its plan" do
+    subscribe! plan_key: "unlimited"
+
+    assert @account.paid?
+    assert_equal "Unlimited", @account.plan.name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited+ plan brings its own storage allowance" do
+    subscribe! plan_key: "unlimited_plus"
+
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "an inactive subscription leaves the account on the free plan" do
+    subscribe! plan_key: "unlimited", status: "canceled"
+
+    assert @account.free?
+  end
+
+  test "comped accounts get the top plan for free" do
+    @account.comp
+
+    assert @account.comped?
+    assert @account.paid?
+    assert_equal "Unlimited+", @account.plan.name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comping is idempotent" do
+    @account.comp
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+  end
+
+test "uncomp takes effect on the same instance" do
+  @account.comp
+  @account.uncomp
+
+  assert_not @account.comped?
+  assert @account.free?
+end
+
+test "resetting overridden limits takes effect on the same instance" do
+  @account.override_limits card_count: 5_000
+  @account.reset_overridden_limits
+
+  assert_equal 1_000, @account.card_limit
+  assert_equal Plan.free.storage_limit, @account.storage_limit
+end
+
+  test "uncomp returns the account to the free plan" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.reload.comped?
+    assert @account.free?
+  end
+
+  test "overridden limits take precedence over the plan" do
+    @account.override_limits card_count: 5_000, bytes_used: 10.gigabytes
+
+    assert_equal 5_000, @account.card_limit
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "overriding limits updates an existing override" do
+    @account.override_limits card_count: 5_000
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      @account.override_limits card_count: 6_000
+    end
+
+    assert_equal 6_000, @account.card_limit
+  end
+
+  test "reset drops the override" do
+    @account.override_limits card_count: 5_000, bytes_used: 10.gigabytes
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+    assert_equal 1_000, @account.card_limit
+    assert_equal Plan.free.storage_limit, @account.storage_limit
+  end
+
+  test "overriding a single limit leaves the other to the plan" do
+    @account.override_limits card_count: 5_000
+
+    assert_equal 5_000, @account.card_limit
+    assert_equal Plan.free.storage_limit, @account.storage_limit
+  end
+
+  private
+    def subscribe!(plan_key:, status: "active")
+      @account.create_subscription!(
+        plan_key: plan_key,
+        status: status,
+        stripe_customer_id: "cus_#{SecureRandom.hex(4)}",
+        stripe_subscription_id: "sub_#{SecureRandom.hex(4)}"
+      )
+    end
+end
