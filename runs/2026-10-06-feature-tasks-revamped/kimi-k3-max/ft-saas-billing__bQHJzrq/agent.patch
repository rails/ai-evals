+<% @page_title = "Plans & Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Choose a plan</h2>
+    </header>
+
+    <div class="flex gap justify-center margin-block">
+      <% @plans.each do |plan| %>
+        <div class="flex flex-column gap-half border-radius pad fill-shade" style="min-width: 16ch;">
+          <h3 class="margin-none"><%= plan.name %></h3>
+
+          <div class="txt-large">
+            <% if plan.free? %>
+              <strong>Free</strong>
+            <% else %>
+              <strong><%= number_to_currency(plan.monthly_price, precision: 0) %></strong><span class="txt-small txt-ink-medium">/month</span>
+            <% end %>
+          </div>
+
+          <ul class="list-unindented margin-none txt-small">
+            <li><%= plan.unlimited_cards? ? "Unlimited cards" : "#{number_with_delimiter(plan.card_limit)} cards" %></li>
+            <li><%= number_to_human_size(plan.storage_limit) %> of storage</li>
+          </ul>
+
+          <% if plan.key == Current.account.plan.key %>
+            <div class="txt-small"><strong>Your plan</strong></div>
+          <% elsif plan.paid? && Current.user.admin? %>
+            <%= button_to "Upgrade to #{plan.name}", saas.billing_checkout_path(plan: plan.key), class: "btn", data: { turbo: false } %>
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+
+    <% if Current.user.admin? && Current.account.subscription&.stripe_customer_id.present? %>
+      <div class="margin-block-end">
+        <%= button_to "Manage billing", saas.billing_portal_path, class: "btn btn--plain txt-link", data: { turbo: false } %>
+        <div class="txt-small txt-ink-medium">Update your card, download invoices, or cancel your subscription via Stripe.</div>
+      </div>
+    <% end %>
+  </div>
+</section>
