diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..121aace
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,180 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  # Stripe posts to this exact URL; exercising the literal path keeps the
+  # contract honest (and dodges lazy route helper finalization).
+  WEBHOOKS_PATH = "/stripe/webhooks"
+
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscription created marks the account as subscribed" do
+    untenanted do
+      post WEBHOOKS_PATH, params: subscription_event("customer.subscription.created",
+        id: "sub_1", customer: "cus_1", status: "active",
+        metadata: { account_id: @account.id, plan_key: "unlimited" },
+        current_period_end: 1_800_000_000), as: :json
+    end
+
+    assert_response :success
+
+    subscription = @account.reload.subscription
+    assert subscription.present?
+    assert_equal "cus_1", subscription.stripe_customer_id
+    assert_equal "sub_1", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal Time.at(1_800_000_000).utc, subscription.current_period_end
+    assert_equal "Unlimited", @account.plan.name
+    assert @account.paid?
+  end
+
+  test "subscription updated changes the plan" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    untenanted do
+      post WEBHOOKS_PATH, params: subscription_event("customer.subscription.updated",
+        id: "sub_1", customer: "cus_1", status: "active",
+        metadata: { account_id: @account.id, plan_key: "unlimited_plus" }), as: :json
+    end
+
+    assert_response :success
+    assert_equal "Unlimited+", @account.reload.plan.name
+  end
+
+  test "subscription deleted returns the account to the free plan" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    untenanted do
+      post WEBHOOKS_PATH, params: subscription_event("customer.subscription.deleted",
+        id: "sub_1", customer: "cus_1", status: "canceled"), as: :json
+    end
+
+    assert_response :success
+    assert @account.reload.free?
+    assert_equal "canceled", @account.subscription.status
+  end
+
+  test "subscription events are matched by stripe customer without metadata" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    untenanted do
+      post WEBHOOKS_PATH, params: subscription_event("customer.subscription.updated",
+        id: "sub_1", customer: "cus_1", status: "past_due"), as: :json
+    end
+
+    assert_response :success
+    assert_equal "past_due", @account.reload.subscription.status
+    assert @account.free?
+  end
+
+  test "plan key falls back to the stripe price id" do
+    with_env("STRIPE_PRICE_ID_UNLIMITED" => "price_unlimited") do
+      untenanted do
+        post WEBHOOKS_PATH, params: subscription_event("customer.subscription.created",
+          id: "sub_2", customer: "cus_2", status: "active",
+          items: { data: [ { price: { id: "price_unlimited" } } ] },
+          metadata: { account_id: @account.id }), as: :json
+      end
+    end
+
+    assert_response :success
+    assert_equal "unlimited", @account.reload.subscription.plan_key
+  end
+
+  test "unmatched accounts are ignored" do
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted do
+        post WEBHOOKS_PATH, params: subscription_event("customer.subscription.created",
+          id: "sub_unknown", customer: "cus_unknown", status: "active"), as: :json
+      end
+    end
+
+    assert_response :success
+  end
+
+  test "unrelated events are acknowledged" do
+    untenanted do
+      post WEBHOOKS_PATH, params: { id: "evt_1", type: "charge.succeeded", data: { object: {} } }, as: :json
+    end
+
+    assert_response :success
+  end
+
+  test "events without a subscription object are acknowledged" do
+    untenanted do
+      post WEBHOOKS_PATH, params: { id: "evt_1", type: "customer.subscription.updated" }, as: :json
+    end
+
+    assert_response :success
+  end
+
+  test "invalid payloads are rejected" do
+    untenanted do
+      post WEBHOOKS_PATH, params: "not json", headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "signed webhooks are verified when a signing secret is configured" do
+    secret = "whsec_test_secret"
+    payload = subscription_event("customer.subscription.created",
+      id: "sub_signed", customer: "cus_signed", status: "active",
+      metadata: { account_id: @account.id, plan_key: "unlimited" }).to_json
+
+    with_env("STRIPE_WEBHOOK_SIGNING_SECRET" => secret) do
+      untenanted do
+        post WEBHOOKS_PATH, params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => stripe_signature_header(payload, secret) }
+      end
+    end
+
+    assert_response :success
+    assert_equal "sub_signed", @account.reload.subscription.stripe_subscription_id
+  end
+
+  test "webhooks with a bad signature are rejected when a signing secret is configured" do
+    secret = "whsec_test_secret"
+    payload = subscription_event("customer.subscription.created",
+      id: "sub_bad", customer: "cus_bad", status: "active",
+      metadata: { account_id: @account.id, plan_key: "unlimited" }).to_json
+
+    assert_no_difference -> { Account::Subscription.count } do
+      with_env("STRIPE_WEBHOOK_SIGNING_SECRET" => secret) do
+        untenanted do
+          post WEBHOOKS_PATH, params: payload,
+            headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => "t=1,v1=bad" }
+        end
+      end
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def subscription_event(type, **subscription)
+      {
+        id: "evt_#{SecureRandom.hex(4)}",
+        type: type,
+        data: { object: subscription }
+      }
+    end
+
+    def stripe_signature_header(payload, secret)
+      timestamp = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
+      "t=#{timestamp},v1=#{signature}"
+    end
+
+    def with_env(vars)
+      original = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      original.each { |key, value| ENV[key] = value }
+    end
+end
