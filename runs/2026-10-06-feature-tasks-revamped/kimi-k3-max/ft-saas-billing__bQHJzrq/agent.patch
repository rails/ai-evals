+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Plan</h2>
+    </header>
+
+    <div class="margin-block-half">
+      <div class="txt-large">
+        <strong><%= @account.plan.name %></strong><% if @account.comped? %> <span class="txt-small txt-ink-medium">(comped)</span><% end %>
+      </div>
+
+      <% if (subscription = @account.subscription) %>
+        <div class="txt-small txt-ink-medium">
+          Stripe subscription <%= subscription.stripe_subscription_id %> is <%= subscription.status %><% if subscription.current_period_end %> until <%= subscription.current_period_end.to_fs(:long) %><% end %>.
+        </div>
+      <% else %>
+        <div class="txt-small txt-ink-medium">No Stripe subscription on file.</div>
+      <% end %>
+    </div>
+
+    <div class="flex gap-half justify-center">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Limits</h2>
+    </header>
+
+    <div class="margin-block-half">
+      <div>
+        Cards: <strong><%= number_with_delimiter(@account.cards_count) %></strong> used of
+        <strong><%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %></strong>
+      </div>
+      <div>
+        Storage: <strong><%= number_to_human_size(@account.bytes_used) %></strong> used of
+        <strong><%= number_to_human_size(@account.storage_limit) %></strong>
+      </div>
+      <% if @account.overridden_limit %>
+        <div class="txt-small txt-ink-medium">These limits are overridden.</div>
+      <% end %>
+    </div>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half align-center" do |form| %>
+      <div class="flex align-center gap-half">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input", placeholder: "Card count" %>
+      </div>
+      <div class="flex align-center gap-half">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input", placeholder: "Bytes used" %>
+      </div>
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), class: "btn btn--negative" %>
+    </div>
+  </div>
+</section>
diff --git a/saas/app/views/billings/show.html.erb b/saas/app/views/billings/show.html.erb
new file mode 100644
index 0000000..1f0e283
--- /dev/null
