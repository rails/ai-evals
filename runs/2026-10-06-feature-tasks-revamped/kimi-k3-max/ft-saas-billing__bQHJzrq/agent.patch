diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..777b7ee
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,29 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+
+  def create
+    case (event = stripe_event).type
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      if (subscription = event.data&.object)
+        Account::Subscription.sync_from_stripe(subscription)
+      end
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def stripe_event
+      payload = request.body.read
+
+      if (signing_secret = ENV["STRIPE_WEBHOOK_SIGNING_SECRET"]).present?
+        Stripe::Webhook.construct_event(payload, request.env["HTTP_STRIPE_SIGNATURE"], signing_secret)
+      else
+        # Without a configured signing secret (development, tests) trust the payload as posted.
+        Stripe::Event.construct_from(JSON.parse(payload))
+      end
+    end
+end
diff --git a/saas/app/models/account/billing_limited.rb b/saas/app/models/account/billing_limited.rb
new file mode 100644
index 0000000..1239356
--- /dev/null
+++ b/saas/app/models/account/billing_limited.rb
@@ -0,0 +1,90 @@
+module Account::BillingLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def plan
+    if comped?
+      Plan.comped
+    elsif subscribed?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def paid?
+    plan.paid?
+  end
+
+  def free?
+    plan.free?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def subscribed?
+    subscription&.active? || false
+  end
+
+  # Card limits. The Free plan is capped; paid plans get unlimited cards.
+  # Support can raise (or lower) an individual account's limit with an override.
+  def card_limit
+    overridden_limit&.card_count || plan.card_limit
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  # Support's override takes precedence over the plan's storage allowance
+  # (and over any storage exception).
+  def storage_limit
+    overridden_limit&.bytes_used || super
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  private
+    def default_storage_limit
+      plan.storage_limit
+    end
+end
