+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "the approved pricing" do
+    free, unlimited, unlimited_plus = Plan.all
+
+    assert_equal "Free", free.name
+    assert_equal 0, free.price_in_cents
+    assert_equal 1_000, free.card_limit
+    assert_equal 1.gigabyte, free.storage_limit
+
+    assert_equal "Unlimited", unlimited.name
+    assert_equal 20_00, unlimited.price_in_cents
+    assert_nil unlimited.card_limit
+    assert_equal 5.gigabytes, unlimited.storage_limit
+
+    assert_equal "Unlimited+", unlimited_plus.name
+    assert_equal 25_00, unlimited_plus.price_in_cents
+    assert_nil unlimited_plus.card_limit
+    assert_equal 500.gigabytes, unlimited_plus.storage_limit
+  end
+
+  test "lookup by key" do
+    assert_equal "Unlimited", Plan["unlimited"].name
+    assert_equal "Unlimited+", Plan[:unlimited_plus].name
+    assert_nil Plan["bogus"]
+  end
+
+  test "free and paid" do
+    assert Plan.free.free?
+    assert_not Plan.free.paid?
+    assert Plan["unlimited"].paid?
+  end
+
+  test "monthly price in dollars" do
+    assert_equal 20.0, Plan["unlimited"].monthly_price
+    assert_equal 25.0, Plan["unlimited_plus"].monthly_price
+  end
+
+  test "stripe price ids come from the environment for paid plans" do
+    assert_nil Plan.free.stripe_price_id
+
+    with_env("STRIPE_PRICE_ID_UNLIMITED" => "price_123") do
+      assert_equal "price_123", Plan["unlimited"].stripe_price_id
+    end
+  end
+
+  private
+    def with_env(vars)
+      original = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      original.each { |key, value| ENV[key] = value }
+    end
+end
