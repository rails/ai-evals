diff --git a/saas/exe/stripe-dev b/saas/exe/stripe-dev
new file mode 100755
index 0000000..7b7156d
--- /dev/null
+++ b/saas/exe/stripe-dev
@@ -0,0 +1,54 @@
+#!/usr/bin/env ruby
+#
+# Sets up local Stripe development for Fizzy billing:
+#   * starts `stripe listen` to forward webhooks to the local app
+#   * prints exports for the Stripe credentials and price ids Fizzy reads
+#
+# Requires the Stripe CLI (https://stripe.com/docs/stripe-cli), signed in to
+# the "37signals Development" account (`stripe login`), and 1Password CLI
+# access to the Deploy vault for the secret key and price ids.
+#
+# Usage: eval "$(BUNDLE_GEMFILE=Gemfile.saas bundle exec stripe-dev)"
+
+OP_ACCOUNT = "23QPQDKZC5BKBIIG7UGT5GR5RM"
+OP_VAULT = "Deploy"
+OP_ITEM = "Fizzy"
+OP_SECTION = "Development"
+
+FORWARD_TO = "http://localhost:3000/stripe/webhooks"
+
+def op_read(field)
+  `op read "op://#{OP_VAULT}/#{OP_ITEM}/#{OP_SECTION}/#{field}" --account #{OP_ACCOUNT} 2>/dev/null`.strip
+end
+
+stripe_secret_key = op_read("STRIPE_SECRET_KEY")
+unlimited_price_id = op_read("STRIPE_PRICE_ID_UNLIMITED")
+unlimited_plus_price_id = op_read("STRIPE_PRICE_ID_UNLIMITED_PLUS")
+
+if stripe_secret_key.empty? || unlimited_price_id.empty? || unlimited_plus_price_id.empty?
+  warn "Error: Could not fetch Stripe credentials from 1Password"
+  warn "Make sure you're signed in: op signin --account #{OP_ACCOUNT}"
+  exit 1
+end
+
+webhook_signing_secret = `stripe listen --print-secret 2>/dev/null`.strip
+
+if webhook_signing_secret.empty?
+  warn "Error: Could not get a webhook signing secret from the Stripe CLI"
+  warn "Make sure you're logged in: stripe login"
+  exit 1
+end
+
+# Forward webhooks to the local app after this script exits.
+spawn "stripe", "listen", "--forward-to", FORWARD_TO, out: "/dev/null", err: "/dev/null"
+
+puts %Q(export STRIPE_SECRET_KEY="#{stripe_secret_key}")
+puts %Q(export STRIPE_WEBHOOK_SIGNING_SECRET="#{webhook_signing_secret}")
+puts %Q(export STRIPE_PRICE_ID_UNLIMITED="#{unlimited_price_id}")
+puts %Q(export STRIPE_PRICE_ID_UNLIMITED_PLUS="#{unlimited_plus_price_id}")
+
+warn ""
+warn "Stripe loaded for development"
+warn "  Secret key: configured"
+warn "  Webhooks: forwarding to #{FORWARD_TO}"
+warn "  Prices: Unlimited #{unlimited_price_id}, Unlimited+ #{unlimited_plus_price_id}"
