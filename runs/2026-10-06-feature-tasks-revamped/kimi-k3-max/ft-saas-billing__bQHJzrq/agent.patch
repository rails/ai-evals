+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and an upgrade link in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing" do
+      assert_select "strong", text: "Free"
+      assert_select "a", text: "Upgrade"
+    end
+  end
+
+  test "admins see their paid plan and a manage billing link in settings" do
+    sign_in_as :mike
+
+    accounts(:initech).create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1")
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "a", text: "Manage billing"
+    end
+  end
+
+  test "members see the plan but no upgrade link" do
+    accounts(:initech).users.create!(name: "JZ", identity: identities(:jz), role: :member, verified_at: Time.current)
+    sign_in_as identities(:jz)
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings__panel--billing" do
+      assert_select "strong", text: "Free"
+      assert_select "a", text: "Upgrade", count: 0
+    end
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
