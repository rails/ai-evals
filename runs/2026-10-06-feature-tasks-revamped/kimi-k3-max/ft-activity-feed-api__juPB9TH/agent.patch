@@ -0,0 +1,50 @@
+# Activities
+
+Activities are the events that happened in the account, such as cards being added, moved, closed, assigned, renamed, or commented on. They mirror what the HTML timeline shows.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of events from the boards the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `board_ids[]` | Filter by board ID(s) |
+| `creator_ids[]` | Filter by the ID(s) of the users who triggered the events |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "eventable_type": "Card",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David assigned JZ to \"Plain text mentions\"",
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "eventable": { "id": "03f5v9zo9qlcwwpyc0ascnikz", "number": 3, "title": "Plain text mentions" },
+    "board": { "id": "03f5v9zkft4hj9qq0lsn9ohcm", "name": "Fizzy" },
+    "creator": { "id": "03f5v9zjw7pz8717a4no1h8a7", "name": "David Heinemeier Hansson" }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the card, board, and user endpoints. `eventable_type` is `Card` for card events and `Comment` for comment events. For comment events, `url` points to the card where the comment was posted, with an anchor that jumps to the comment.
+
+Possible `action` values: `card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_postponed`, `card_auto_postponed`, `card_title_changed`, `card_triaged`, `card_sent_back_to_triage`, and `comment_created`.
+
+The `particulars` object exposes event-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..534adb2
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,213 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal Event.where(board: boards(:writebook)).count, @response.parsed_body.count
+  end
+
+  test "index returns newest activity first" do
+    get activities_path(format: :json)
+
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+
+    timestamps = @response.parsed_body.pluck("created_at")
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "event structure" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { it["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, event.keys.sort
+  end
+
+  test "card event" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { it["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal "card_assigned", event["action"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal events(:layout_assignment_jz).created_at.utc.as_json, event["created_at"]
+    assert_equal events(:layout_assignment_jz).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal card_url(cards(:layout)), event["url"]
+    assert_equal cards(:layout).id, event["eventable"]["id"]
+    assert_equal cards(:layout).title, event["eventable"]["title"]
+    assert_equal boards(:writebook).id, event["board"]["id"]
+    assert_equal boards(:writebook).name, event["board"]["name"]
+    assert_equal users(:david).id, event["creator"]["id"]
+    assert_equal users(:david).name, event["creator"]["name"]
+  end
+
+  test "comment event" do
+    get activities_path(format: :json)
+
+    comment = comments(:layout_overflowing_david)
+    event = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", event["action"]
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    events(:logo_published).update!(action: "card_collection_changed")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+  end
+
+  test "includes card_title_changed events" do
+    event = boards(:writebook).events.create! \
+      creator: users(:david), eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "The old title", new_title: "The new title" } }
+
+    get activities_path(format: :json)
+
+    json_event = @response.parsed_body.find { it["id"] == event.id }
+    assert_equal "card_title_changed", json_event["action"]
+    assert_equal({ "old_title" => "The old title", "new_title" => "The new title" }, json_event["particulars"])
+  end
+
+  test "assignment particulars" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { it["id"] == events(:layout_assignment_jz).id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event["particulars"])
+  end
+
+  test "board change particulars" do
+    event = boards(:writebook).events.create! \
+      creator: users(:david), eventable: cards(:logo),
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Writebook", new_board: "Fizzy" } }
+
+    get activities_path(format: :json)
+
+    json_event = @response.parsed_body.find { it["id"] == event.id }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Fizzy" }, json_event["particulars"])
+  end
+
+  test "triage particulars" do
+    event = boards(:writebook).events.create! \
+      creator: users(:david), eventable: cards(:logo),
+      action: "card_triaged",
+      particulars: { particulars: { column: "In progress" } }
+
+    get activities_path(format: :json)
+
+    json_event = @response.parsed_body.find { it["id"] == event.id }
+    assert_equal({ "column" => "In progress" }, json_event["particulars"])
+  end
+
+  test "missing particulars values are returned as empty strings" do
+    board_change = boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_board_changed"
+    title_change = boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_title_changed"
+    triage = boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_triaged"
+
+    get activities_path(format: :json)
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, @response.parsed_body.find { it["id"] == board_change.id }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, @response.parsed_body.find { it["id"] == title_change.id }["particulars"])
+    assert_equal({ "column" => "" }, @response.parsed_body.find { it["id"] == triage.id }["particulars"])
+  end
+
+  test "other events return empty particulars" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+    assert_equal({}, event["particulars"])
+  end
+
+  test "filter by creator_ids" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ])
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal [ users(:kevin).id ], @response.parsed_body.pluck("creator").pluck("id").uniq
+  end
+
+  test "filter by board_ids" do
+    get activities_path(format: :json, board_ids: [ boards(:writebook).id ])
+
+    assert_response :success
+    assert_equal Event.where(board: boards(:writebook)).count, @response.parsed_body.count
+
+    get activities_path(format: :json, board_ids: [ boards(:private).id ])
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "only returns activity the current user can access" do
+    event = boards(:private).events.create! creator: users(:kevin), eventable: cards(:logo), action: "card_published"
+
+    get activities_path(format: :json)
+    assert_includes @response.parsed_body.pluck("id"), event.id
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), event.id
+    assert_equal Event.where(board: boards(:writebook)).count, @response.parsed_body.count
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+
+    assert_response :unauthorized
+  end
+
+  test "pagination" do
+    20.times do |index|
+      boards(:writebook).events.create! creator: users(:kevin), eventable: cards(:logo), action: "card_published", created_at: index.minutes.ago
+    end
+
+    event_ids = []
+    next_page = activities_path(format: :json)
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      event_ids.concat @response.parsed_body.pluck("id")
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal Event.where(board: boards(:writebook)).count, event_ids.count
+    assert_equal event_ids.uniq, event_ids
+  end
+
+  test "pagination headers" do
+    20.times do |index|
+      boards(:writebook).events.create! creator: users(:kevin), eventable: cards(:logo), action: "card_published", created_at: index.minutes.ago
+    end
+
+    get activities_path(format: :json)
+
+    assert_equal Event.where(board: boards(:writebook)).count.to_s, @response.headers["X-Total-Count"]
+    assert @response.headers["Link"].present?
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
