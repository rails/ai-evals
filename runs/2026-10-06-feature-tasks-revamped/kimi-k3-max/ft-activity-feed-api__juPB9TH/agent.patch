@@ -0,0 +1,26 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  # Mirrors the HTML timeline (see User::DayTimeline::TIMELINEABLE_ACTIONS), except that
+  # deprecated card_collection_changed events are omitted and card_title_changed events are included.
+  ACTIVITY_ACTIONS = User::DayTimeline::TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from filtered_events
+      end
+    end
+  end
+
+  private
+    def filtered_events
+      events = Event.preloaded.where(board: boards, action: ACTIVITY_ACTIONS).order(created_at: :desc, id: :desc)
+      events = events.where(creator_id: @filter.creators.ids) if @filter.creators.present?
+      events
+    end
+
+    def boards
+      @filter.boards.presence || Current.user.boards
+    end
+end
diff --git a/app/views/activities/_event.json.jbuilder b/app/views/activities/_event.json.jbuilder
new file mode 100644
index 0000000..9bde161
--- /dev/null
+++ b/app/views/activities/_event.json.jbuilder
@@ -0,0 +1,36 @@
+json.(event, :id, :action, :eventable_type)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+json.url polymorphic_url(event.eventable)
+
+particulars =
+  case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: event.assignee_ids || [] }
+  when "card_board_changed"
+    {
+      old_board: event.particulars.dig("particulars", "old_board") || "",
+      new_board: event.particulars.dig("particulars", "new_board") || ""
+    }
+  when "card_title_changed"
+    {
+      old_title: event.particulars.dig("particulars", "old_title") || "",
+      new_title: event.particulars.dig("particulars", "new_title") || ""
+    }
+  when "card_triaged"
+    { column: event.particulars.dig("particulars", "column") || "" }
+  else
+    {}
+  end
+
+json.particulars particulars
+
+case event.eventable
+when Card
+  json.eventable event.eventable, partial: "cards/card", as: :card
+when Comment
+  json.eventable event.eventable, partial: "cards/comments/comment", as: :comment
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
