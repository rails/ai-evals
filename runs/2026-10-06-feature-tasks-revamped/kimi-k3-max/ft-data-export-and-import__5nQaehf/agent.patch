diff --git a/test/mailers/account/import_mailer_test.rb b/test/mailers/account/import_mailer_test.rb
new file mode 100644
index 0000000..373cfa7
--- /dev/null
+++ b/test/mailers/account/import_mailer_test.rb
@@ -0,0 +1,36 @@
+require "cgi"
+require "test_helper"
+
+class Account::ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts("37s")
+    @import = @account.imports.create!(
+      user: users(:jason),
+      status: :failed,
+      error_message: "This file doesn't look like a Fizzy account export",
+      file: Rack::Test::UploadedFile.new(file_fixture("moon.jpg"), "image/jpeg"))
+  end
+
+  test "completed" do
+    import = @account.imports.create!(
+      user: users(:jason),
+      imported_account: accounts(:initech),
+      status: :completed,
+      file: Rack::Test::UploadedFile.new(file_fixture("moon.jpg"), "image/jpeg"))
+
+    email = Account::ImportMailer.completed(import)
+
+    assert_equal [ import.user.identity.email_address ], email.to
+    assert_equal "Your Fizzy import is ready", email.subject
+    assert_includes email.html_part.body.decoded, import.imported_account.name
+    assert_includes email.html_part.body.decoded, import.imported_account.slug
+  end
+
+  test "failed" do
+    email = Account::ImportMailer.failed(@import)
+
+    assert_equal [ @import.user.identity.email_address ], email.to
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_includes email.html_part.body.decoded, CGI.escapeHTML(@import.error_message)
+  end
+end
diff --git a/test/mailers/export_mailer_test.rb b/test/mailers/export_mailer_test.rb
