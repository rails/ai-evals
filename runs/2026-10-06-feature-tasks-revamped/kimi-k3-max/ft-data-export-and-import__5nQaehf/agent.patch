+class Account::ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.imported_account
+    @account_url = root_url(script_name: @account.slug)
+
+    mail to: import.user.identity.email_address, subject: "Your Fizzy import is ready"
+  end
+
+  def failed(import)
+    @import = import
+    @error_message = import.error_message
+
+    mail to: import.user.identity.email_address, subject: "Your Fizzy import failed"
+  end
+end
