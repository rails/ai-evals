+      </label>
+
+      <% if @import.errors.any? %>
+        <div class="margin-block-half txt-negative txt-small" style="text-align: left;">
+          <p class="margin-block-none font-weight-bold">Your import couldn't be started:</p>
+          <ul class="margin-block-none">
+            <% @import.errors.full_messages.each do |message| %>
+              <li><%= message %></li>
+            <% end %>
+          </ul>
+        </div>
+      <% end %>
+
+      <button type="submit" class="btn btn--reversed center">
+        <span>Start import</span>
+      </button>
+    <% end %>
+
+    <p class="margin-none txt-small txt-tinted">
+      You'll get an email when the import is done, or if it failed and why. A failed import leaves nothing behind.
+    </p>
+  </div>
+</div>
