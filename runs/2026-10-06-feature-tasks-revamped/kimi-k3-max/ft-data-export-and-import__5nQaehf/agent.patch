diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..56c12c8
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,43 @@
+require "zip"
+
+# Read-based counterpart to ZipFile::Writer, used when importing an export archive.
+class ZipFile::Reader
+  def self.open(path, &block)
+    reader = new(path)
+
+    begin
+      yield reader
+    ensure
+      reader.close
+    end
+  end
+
+  def initialize(path)
+    @zip = Zip::File.open(path)
+  end
+
+  def glob(pattern)
+    @zip.glob(pattern).map(&:name).sort
+  end
+
+  def exist?(path)
+    @zip.find_entry(path).present?
+  end
+
+  def read(path)
+    find_entry(path).get_input_stream.read
+  end
+
+  def open(path, &block)
+    find_entry(path).get_input_stream(&block)
+  end
+
+  def close
+    @zip.close
+  end
+
+  private
+    def find_entry(path)
+      @zip.find_entry(path) || raise(Errno::ENOENT, "No such file or directory - #{path}")
+    end
+end
