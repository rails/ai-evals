+  <div class="header__actions header__actions--start">
+    <%= back_link_to "account settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 55ch;">
+  <div class="flex flex-column gap txt-medium">
+    <p class="margin-none">
+      Bring back a Fizzy account export (<code>.zip</code>). It will be restored as a
+      <strong>brand new account</strong> with everything in it — boards, cards, comments, files, and people.
+    </p>
+
+    <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap" do |form| %>
