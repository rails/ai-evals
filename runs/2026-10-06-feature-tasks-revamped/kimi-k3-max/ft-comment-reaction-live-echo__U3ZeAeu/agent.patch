@@ -0,0 +1,13 @@
+module ReactionsHelper
+  # Emoji, modifiers, joiners, and whitespace only -- no letters, digits, or punctuation.
+  EMOJI_ONLY_PATTERN = /\A[\p{Extended_Pictographic}\u{1F3FB}-\u{1F3FF}\u{200D}\u{FE0E}\u{FE0F}\u{20E3}\u{1F1E6}-\u{1F1FF}\u{E0020}-\u{E007F}\s]+\z/
+
+  def reaction_content_tag(reaction)
+    tag.span reaction.content, class: class_names("txt-small", "txt-medium": emoji_only?(reaction.content))
+  end
+
+  private
+    def emoji_only?(content)
+      content.match?(EMOJI_ONLY_PATTERN)
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..0af14a4
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  expand() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  react({ params: { content } }) {
+    this.inputTarget.value = `${this.inputTarget.value}${content}`
+
+    if (this.inputTarget.maxLength > 0) {
+      this.inputTarget.value = this.inputTarget.value.slice(0, this.inputTarget.maxLength)
+    }
+
+    this.formTarget.requestSubmit()
+  }
+
+  markDeleting({ currentTarget }) {
+    currentTarget.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+}
