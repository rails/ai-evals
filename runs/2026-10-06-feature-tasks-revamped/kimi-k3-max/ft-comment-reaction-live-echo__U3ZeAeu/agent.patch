@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "🔥" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), comment.reactions.last.reacter
+    assert_turbo_stream action: :replace, target: dom_id(comment, :reactions)
+  end
+
+  test "create normalizes content" do
+    comment = comments(:logo_agreement_jz)
+
+    post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "  👀  " } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal "👀", comment.reactions.last.content
+  end
+
+  test "create with too-long content is unprocessable" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "create with blank content is unprocessable" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "  " } }, as: :json
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "destroy own reaction" do
+    reaction = reactions(:layout_party_kevin)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(reaction.comment, :reactions)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+
+    reaction = @response.parsed_body.first
+    assert_equal "👍", reaction["content"]
+    assert_equal users(:jz).id, reaction.dig("reacter", "id")
+    assert reaction["url"].present?
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(comment.card, comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(comment.card, comment, Reaction.last), @response.parsed_body["url"]
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "Flat 💯" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat 💯", Reaction.last.content
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:layout_party_kevin)
+
+    delete card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "card page renders reactions strip" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(cards(:logo))
+
+    assert_response :success
+    assert_select "##{dom_id(comment, :reactions)}" do
+      assert_select ".reactions__list .reaction", 2
+      assert_select ".reactions__trigger"
+      assert_select "form.reaction__form[hidden]"
+    end
+    assert_select "##{dom_id(reactions(:logo_thumbs_up_jz))}[data-creator-id='#{users(:jz).id}']" do
+      assert_select "span.txt-small.txt-medium", text: "👍"
+      assert_select ".reaction__delete"
+    end
+    assert_select "##{dom_id(reactions(:logo_agreement_david))} span.txt-small:not(.txt-medium)", text: "Agreed!"
+  end
+end
