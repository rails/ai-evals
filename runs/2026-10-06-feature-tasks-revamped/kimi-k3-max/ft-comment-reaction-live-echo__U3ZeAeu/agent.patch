+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <%= render "cards/comments/reactions/list", comment: comment %>
+
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction"
+      data-reaction-target="trigger" data-action="reaction#expand">
+    <%= image_tag "boost-color.svg", aria: { hidden: "true" } %>
+  </button>
+
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), namespace: dom_id(comment),
+        class: "reaction reaction__form", html: { hidden: true },
+        data: {
+          controller: "form",
+          reaction_target: "form",
+          action: "submit->form#preventEmptySubmit keydown.esc->reaction#collapse:stop"
+        } do |form| %>
+    <%= form.label :content, class: "reaction__form-label flex align-center" do %>
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::MAX_CONTENT_LENGTH,
+            placeholder: "React", autocomplete: "off",
+            data: { reaction_target: "input", form_target: "input", validation_message: "Add an emoji or a bit of text first" } %>
+    <% end %>
+
+    <span class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" aria-label="Pick an emoji"
+          data-action="click->dialog#toggle:stop">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-dialog-target="dialog"
+          data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <span class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, name| %>
+            <button type="button" class="btn btn--plain" title="<%= name %>"
+                data-action="reaction#react dialog#close" data-reaction-content-param="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </span>
+      </dialog>
+    </span>
+
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless" aria-label="Confirm reaction">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" aria-label="Cancel"
+        data-action="reaction#collapse">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
