diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..bb16f6d
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  include Broadcastable
+
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_commit :bust_comment_fragment_cache, on: %i[ create destroy ]
+
+  private
+    # Bumps the comment's cache key so the reactions strip re-renders on the next
+    # page load, without rippling into a card touch (which would broadcast a
+    # full-page refresh; the strip itself is broadcast instead).
+    def bust_comment_fragment_cache
+      comment.update_column(:updated_at, Time.current) unless comment.destroyed?
+    end
+end
diff --git a/app/models/reaction/broadcastable.rb b/app/models/reaction/broadcastable.rb
new file mode 100644
index 0000000..2011fed
--- /dev/null
+++ b/app/models/reaction/broadcastable.rb
@@ -0,0 +1,17 @@
+module Reaction::Broadcastable
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :broadcast_reactions_list, on: %i[ create destroy ]
+  end
+
+  private
+    # Uses the channel-level API so no +reaction+ local is serialized into the
+    # job: destroyed reactions would fail to deserialize on perform.
+    def broadcast_reactions_list
+      unless comment.destroyed?
+        Turbo::StreamsChannel.broadcast_replace_later_to comment.card, target: [ comment, :reactions_list ],
+          partial: "cards/comments/reactions/list", locals: { comment: comment }
+      end
+    end
+end
