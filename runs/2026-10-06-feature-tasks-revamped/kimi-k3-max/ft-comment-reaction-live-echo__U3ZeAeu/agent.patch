diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..1eb2d20
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "content is limited to 16 characters" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    reaction.content = "a" * 16
+    assert reaction.valid?
+
+    reaction.content = "a" * 17
+    assert_not reaction.valid?
+
+    reaction.content = "👍" * 16
+    assert reaction.valid?
+  end
+
+  test "content is required and normalized" do
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    reaction.content = "   "
+    assert_not reaction.valid?
+
+    reaction.content = "  👍  "
+    assert reaction.valid?
+    assert_equal "👍", reaction.content
+  end
+
+  test "reacter defaults to the current user" do
+    Current.user = users(:kevin)
+
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "🔥")
+
+    assert_equal users(:kevin), reaction.reacter
+  ensure
+    Current.user = nil
+  end
+
+  test "account defaults to the comment's account" do
+    reaction = comments(:logo_agreement_jz).reactions.build(content: "🔥", reacter: users(:kevin))
+
+    reaction.valid?
+    assert_equal accounts("37s"), reaction.account
+  end
+
+  test "creating a reaction busts the comment's cache key" do
+    comment = comments(:logo_agreement_jz)
+
+    travel_to 1.hour.from_now do
+      assert_changes -> { comment.reload.updated_at } do
+        comment.reactions.create!(content: "🔥", reacter: users(:kevin))
+      end
+    end
+  end
+
+  test "destroying a reaction busts the comment's cache key" do
+    reaction = reactions(:layout_party_kevin)
+    comment = reaction.comment
+
+    travel_to 1.hour.from_now do
+      assert_changes -> { comment.reload.updated_at } do
+        reaction.destroy
+      end
+    end
+  end
+
+  test "creating a reaction broadcasts the reactions list to the card" do
+    comment = comments(:logo_agreement_jz)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts [ comment.card ], count: 1 do
+        comment.reactions.create!(content: "🔥", reacter: users(:kevin))
+      end
+    end
+  end
+
+  test "destroying a reaction broadcasts the reactions list to the card" do
+    reaction = reactions(:layout_party_kevin)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts [ reaction.comment.card ], count: 1 do
+        reaction.destroy
+      end
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -2 do
+      comment.destroy
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..bd31904
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,147 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction with the input" do
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_selector ".reaction__form"
+
+      find(".reactions__trigger").click
+      assert_selector ".reaction__form"
+      assert_no_selector ".reactions__trigger"
+
+      find(".reaction__input").set("Nailed it")
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reactions__list .reaction", text: "Nailed it"
+      assert_selector ".reactions__list .reaction", count: 3
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form"
+    end
+  end
+
+  test "adding an emoji reaction from the menu" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button", text: "🎉").click
+
+      assert_selector ".reactions__list .reaction", text: "🎉"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "canceling the reaction form" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").set("Never mind")
+
+      find(".reaction__cancel-btn").click
+
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__list .reaction", count: 2
+    end
+  end
+
+  test "an empty reaction cannot be confirmed" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction__form"
+      assert_selector ".reactions__list .reaction", count: 2
+    end
+  end
+
+  test "removing your own reaction" do
+    visit card_url(@card)
+    reaction = reactions(:logo_agreement_david)
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", count: 2
+
+      find("##{dom_id(reaction)}").click
+      assert_selector "##{dom_id(reaction)}.expanded" do
+        find(".reaction__delete").click
+      end
+
+      assert_no_selector "##{dom_id(reaction)}"
+      assert_selector ".reactions__list .reaction", count: 1
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "you cannot remove someone else's reaction" do
+    visit card_url(@card)
+    reaction = reactions(:logo_thumbs_up_jz)
+
+    within_reactions do
+      find("##{dom_id(reaction)}").click
+      assert_no_selector "##{dom_id(reaction)} .reaction__delete"
+    end
+  end
+
+  test "reactions made elsewhere land without reloading" do
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", count: 2
+    end
+
+    wait_for_cable_subscriptions
+    @comment.reactions.create!(content: "🔥", reacter: users(:jz))
+    perform_enqueued_jobs
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", text: "🔥"
+      assert_selector ".reactions__list .reaction", count: 3
+    end
+  end
+
+  test "reactions removed elsewhere disappear without reloading" do
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector ".reactions__list .reaction", count: 2
+    end
+
+    wait_for_cable_subscriptions
+    reactions(:logo_thumbs_up_jz).destroy
+    perform_enqueued_jobs
+
+    within_reactions do
+      assert_no_selector ".reactions__list .reaction", text: "👍"
+      assert_selector ".reactions__list .reaction", count: 1
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
