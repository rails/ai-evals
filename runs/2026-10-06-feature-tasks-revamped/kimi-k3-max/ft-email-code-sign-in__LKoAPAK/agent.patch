@@ -0,0 +1,82 @@
+require "test_helper"
+
+class EmailChallengeFlowsTest < ActionDispatch::IntegrationTest
+  test "signing in by email code, with the code read out of the email subject" do
+    identity = identities(:kevin)
+
+    untenanted do
+      request_sign_in_code_for identity.email_address
+      follow_redirect!
+
+      assert_in_body identity.email_address
+      assert_select "input[name=code]"
+
+      post session_email_challenge_path, params: { code: code_from_last_email_subject }
+      assert_redirected_to landing_url
+
+      follow_redirect!
+      assert_redirected_to session_menu_path(script_name: nil)
+
+      follow_redirect!
+      assert_redirected_to root_url(script_name: accounts("37s").slug)
+    end
+  end
+
+  test "signing up by email code ends with the person signed up" do
+    untenanted do
+      request_sign_in_code_for "new-user@example.com", url: signup_path, params: { signup: { email_address: "new-user@example.com" } }
+      follow_redirect!
+
+      assert_in_body "new-user@example.com"
+      assert_select "input[name=code]"
+
+      post signup_email_challenge_path, params: { code: code_from_last_email_subject }
+      follow_redirect!
+
+      assert_select "input[name='signup[full_name]']"
+
+      post signup_completion_path, params: { signup: { full_name: "New User" } }
+
+      assert flash[:welcome_letter]
+    end
+
+    identity = Identity.find_by!(email_address: "new-user@example.com")
+    assert identity.users.exists?, "Expected the identity to have a user in its new account"
+  end
+
+  test "joining with a join code by email code ends with the person joined" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    request_sign_in_code_for "new-joiner@example.com", url: join_path(code: join_code.code, script_name: account.slug)
+    follow_redirect!
+
+    assert_in_body "new-joiner@example.com"
+    assert_in_body account.name
+    assert_select "input[name=code]"
+
+    post join_email_challenge_path(join_code: join_code.code, script_name: account.slug), params: { code: code_from_last_email_subject }
+
+    identity = Identity.find_by!(email_address: "new-joiner@example.com")
+    assert identity.users.exists?(account: account), "Expected the identity to have joined the account"
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+
+  private
+    def request_sign_in_code_for(email_address, url: session_path, params: { email_address: email_address })
+      perform_enqueued_jobs do
+        post url, params: params
+      end
+
+      assert_redirected_to %r{/email_challenge/new}
+    end
+
+    def code_from_last_email_subject
+      email = ActionMailer::Base.deliveries.last
+      assert email, "Expected a sign-in code email to have been sent"
+
+      email.subject[/\A[A-Z2-9]{6}/].tap do |code|
+        assert code, "Expected the code to be in the email subject: #{email.subject.inspect}"
+      end
+    end
+end
