+require "test_helper"
+
+class Identity::EmailChallengeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:david)
+  end
+
+  test "generates a six-character code" do
+    challenge = @identity.email_challenges.create!
+
+    assert_equal Identity::EmailChallenge::CODE_LENGTH, challenge.code.length
+    assert_equal 6, challenge.code.length
+    assert_match /\A[A-Z0-9]{6}\z/, challenge.code
+  end
+
+  test "expires fifteen minutes after creation" do
+    challenge = @identity.email_challenges.create!
+
+    assert_in_delta 15.minutes.from_now, challenge.expires_at, 1.second
+    assert_not challenge.expired?
+    assert_includes Identity::EmailChallenge.active, challenge
+
+    travel 16.minutes do
+      assert challenge.expired?
+      assert_not_includes Identity::EmailChallenge.active, challenge
+    end
+  end
+
+  test "redeem with a valid code returns the identity and consumes the challenge" do
+    challenge = @identity.email_challenges.create!
+
+    assert_difference -> { @identity.email_challenges.count }, -1 do
+      assert_equal @identity, Identity::EmailChallenge.redeem(identity: @identity, code: challenge.code)
+    end
+  end
+
+  test "redeem ignores case and surrounding whitespace" do
+    challenge = @identity.email_challenges.create!
+
+    assert_equal @identity, Identity::EmailChallenge.redeem(identity: @identity, code: " #{challenge.code.downcase} ")
+  end
+
+  test "redeem with an invalid code" do
+    @identity.email_challenges.create!
+
+    assert_no_difference -> { @identity.email_challenges.count } do
+      assert_nil Identity::EmailChallenge.redeem(identity: @identity, code: "000000")
+    end
+  end
+
+  test "redeem with an expired code" do
+    challenge = @identity.email_challenges.create!
+
+    travel 16.minutes do
