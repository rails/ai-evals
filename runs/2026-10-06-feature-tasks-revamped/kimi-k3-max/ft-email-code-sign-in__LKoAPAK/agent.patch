+require "test_helper"
+
+class JoinCodes::EmailChallengesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "new without a pending email challenge" do
+    get new_join_email_challenge_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_redirected_to join_path(code: @join_code.code, script_name: @account.slug)
+  end
+
+  test "new with an invalid join code" do
+    get new_join_email_challenge_path(join_code: "INVALID-CODE", script_name: @account.slug)
+
+    assert_response :not_found
+  end
+
+  test "new renders the code entry screen" do
+    request_code_for "new-joiner@example.com"
+
+    get new_join_email_challenge_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_in_body "new-joiner@example.com"
+    assert_in_body @account.name
+  end
+
+  test "create signs in and joins a brand-new identity to the account" do
+    challenge = request_code_for("new-joiner@example.com")
+    identity = Identity.find_by!(email_address: "new-joiner@example.com")
+
+    assert_no_difference -> { Identity.count } do
