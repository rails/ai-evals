diff --git a/app/models/identity/email_challenge.rb b/app/models/identity/email_challenge.rb
new file mode 100644
index 0000000..6a313d9
--- /dev/null
+++ b/app/models/identity/email_challenge.rb
@@ -0,0 +1,37 @@
+class Identity::EmailChallenge < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = %w[ A B C D E F G H J K M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+  EXPIRATION_PERIOD = 15.minutes
+
+  belongs_to :identity
+
+  validates :code, presence: true
+
+  before_validation :assign_code_and_expiration, on: :create
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  class << self
+    def redeem(identity:, code:)
+      if challenge = identity.email_challenges.active.find_by(code: normalize(code))
+        challenge.destroy
+        identity
+      end
+    end
+
+    private
+      def normalize(code)
+        code.to_s.strip.upcase
+      end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def assign_code_and_expiration
+      self.code ||= CODE_CHARACTERS.sample(CODE_LENGTH, random: SecureRandom).join
+      self.expires_at ||= EXPIRATION_PERIOD.from_now
+    end
+end
