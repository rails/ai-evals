new file mode 100644
index 0000000..82e26a7
--- /dev/null
+++ b/app/controllers/concerns/email_challengeable.rb
@@ -0,0 +1,28 @@
+module EmailChallengeable
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :pending_email_challenge_identity
+  end
+
+  private
+    def send_email_challenge(identity)
+      identity.send_email_challenge
+      session[:email_challenge_identity_id] = identity.id
+    end
+
+    def pending_email_challenge_identity
+      if session[:email_challenge_identity_id]
+        @pending_email_challenge_identity ||= Identity.find_by(id: session[:email_challenge_identity_id])
+      end
+    end
+
+    def redeem_email_challenge(code)
+      identity = pending_email_challenge_identity
+
+      if identity && Identity::EmailChallenge.redeem(identity: identity, code: code)
+        session.delete(:email_challenge_identity_id)
+        identity
+      end
+    end
+end
