diff --git a/app/controllers/cards/reactions_controller.rb b/app/controllers/cards/reactions_controller.rb
new file mode 100644
index 0000000..06fe765
--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,43 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @card.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render "cards/reactions/show", status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..9a5f7f4
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,30 @@
+module ReactionsHelper
+  def reactable_reactions_path(reactable)
+    polymorphic_path([ *reaction_route_segments(reactable), :reactions ])
+  end
+
+  def new_reactable_reaction_path(reactable)
+    polymorphic_path([ :new, *reaction_route_segments(reactable), :reaction ])
+  end
+
+  def reactable_reaction_path(reaction)
+    polymorphic_path([ *reaction_route_segments(reaction.reactable), reaction ])
+  end
+
+  def reactable_reaction_url(reaction)
+    polymorphic_url([ *reaction_route_segments(reaction.reactable), reaction ])
+  end
+
+  def reactable_reaction_form_model(reactable)
+    [ *reaction_route_segments(reactable), Reaction.new ]
+  end
+
+  private
+    # Comment reactions are nested under their card; card reactions under the card itself.
+    def reaction_route_segments(reactable)
+      case reactable
+      when Comment then [ reactable.card, reactable ]
+      else [ reactable ]
+      end
+    end
+end
