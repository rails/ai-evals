@@ -0,0 +1,112 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  test "comments show times rendered by the browser in the viewer's timezone" do
+    sign_in_as(users(:david))
+
+    with_current_user(:david) do
+      card = cards(:layout)
+      card.comments.create!(body: "from earlier today", creator: users(:david), created_at: Time.current.beginning_of_day + 1.hour)
+      card.comments.create!(body: "from last night", creator: users(:david), created_at: 1.day.ago)
+      card.comments.create!(body: "from earlier this week", creator: users(:david), created_at: 5.days.ago)
+      card.comments.create!(body: "from a while back", creator: users(:david), created_at: 30.days.ago)
+    end
+
+    visit card_url(cards(:layout))
+
+    # The server sends raw timestamps; the browser turns them into words.
+    assert_selector ".comment__permalink-title time[data-controller~=local-time]", text: /yesterday/i
+    assert_selector ".comment__permalink-title time[data-controller~=local-time]", text: /5 days ago/i
+    assert_selector ".comment__permalink-title time[data-controller~=local-time]", text: /\A\d{1,2}:\d{2} [AP]M\z/
+    assert_selector ".comment__permalink-title time[data-controller~=local-time]", text: /\A[A-Z][a-z]{2} \d{1,2}\z/
+  end
+
+  test "the same timestamp reads differently in different timezones" do
+    sign_in_as(users(:david))
+
+    comment = with_current_user(:david) do
+      # 2:30 PM in Auckland, whatever the server time is.
+      cards(:layout).comments.create!(body: "late night", creator: users(:david),
+        created_at: ActiveSupport::TimeZone["Pacific/Auckland"].now.change(hour: 14, min: 30))
+    end
+
+    # The browser tells the server its timezone with a cookie on the first
+    # visit; the next visit renders in that timezone.
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "Pacific/Auckland")
+    visit card_url(cards(:layout))
+    visit card_url(cards(:layout))
+
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: "2:30 PM"
+
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/Los_Angeles")
+    visit card_url(cards(:layout))
+    visit card_url(cards(:layout))
+
+    los_angeles = ActiveSupport::TimeZone["America/Los_Angeles"]
+    expected = if comment.created_at.in_time_zone(los_angeles).to_date == los_angeles.now.to_date
+      comment.created_at.in_time_zone(los_angeles).strftime("%-l:%M %p")
+    else
+      /yesterday/i
+    end
+
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: expected
+    assert_no_selector "##{dom_id(comment)} .comment__permalink-title time", text: "2:30 PM"
+  ensure
+    # Capybara reuses the browser between tests; don't leak the override.
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+  end
+
+  test "times still render in the viewer's timezone after a broadcast refresh" do
+    sign_in_as(users(:david))
+
+    comment = with_current_user(:david) do
+      cards(:layout).comments.create!(body: "recent", creator: users(:david), created_at: Time.current.beginning_of_day + 30.minutes)
+    end
+
+    visit card_url(cards(:layout))
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: /\A\d{1,2}:\d{2} [AP]M\z/
+
+    with_current_user(:kevin) do
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      cards(:layout).update!(title: "Retitled elsewhere")
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # The morph swaps in the server's fallback text; the browser re-renders it.
+    assert_selector "h1", text: "Retitled elsewhere", wait: 5
+    assert_selector "##{dom_id(comment)} .comment__permalink-title time", text: /\A\d{1,2}:\d{2} [AP]M\z/
+  end
+
+  test "the events timeline shows days and times rendered by the browser" do
+    sign_in_as(users(:david))
+
+    with_current_user(:david) do
+      cards(:layout).update!(title: "Retitled for the timeline")
+    end
+
+    visit events_path
+
+    assert_selector ".events__column-header", text: /#{Time.current.strftime("%A, %B %-d")}/i
+    assert_selector ".event__timestamp", text: /\A\d{1,2}:\d{2} [AP]M\z/
+  end
+
+  test "cards show when they move to Not Now in the viewer's timezone" do
+    sign_in_as(users(:david))
+
+    cards(:layout).update!(last_active_at: 89.days.ago)
+
+    visit card_url(cards(:layout))
+
+    assert_selector ".card-perma__closure-message time[data-controller~=local-time]", text: "tomorrow"
+  end
+
+  test "cards show days until they move to Not Now" do
+    sign_in_as(users(:david))
+
+    cards(:layout).update!(last_active_at: 87.days.ago)
+
+    visit card_url(cards(:layout))
+
+    assert_selector ".card-perma__closure-message time[data-controller~=local-time]", text: "in 3 days"
+  end
+end
