diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..f49775f
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+import { renderLocalTime } from "helpers/local_time_helpers"
+
+const RELATIVE_TIME_REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.#render()
+
+    if (this.styleValue === "relative") {
+      this.#timer = setInterval(() => this.#render(), RELATIVE_TIME_REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  #render() {
+    renderLocalTime(this.element)
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..ed4c8bf
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,105 @@
+import { getMetaContent } from "helpers/meta_helpers"
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const DAYS_IN_A_WEEK = 7
+
+// Renders a <time datetime="…" data-controller="local-time"> element in the
+// viewer's own timezone, using the style the server asked for.
+export function renderLocalTime(element) {
+  const date = new Date(element.getAttribute("datetime"))
+
+  if (!isNaN(date)) {
+    element.textContent = formatLocalTime(date, element.getAttribute("data-local-time-style-value"))
+    element.setAttribute("title", formatFullDatetime(date))
+  }
+}
+
+export function renderAllLocalTimes() {
+  document.querySelectorAll("time[data-controller~=local-time]").forEach(renderLocalTime)
+}
+
+export function formatLocalTime(date, style = "relative") {
+  switch (style) {
+    case "time":          return formatTime(date)
+    case "date":          return formatDate(date)
+    case "weekday-date":  return formatWeekdayDate(date)
+    case "datetime":      return formatDatetime(date)
+    default:              return formatRelativeTime(date)
+  }
+}
+
+// "1:42 PM" for today, "yesterday", "5 days ago", or "Sep 12" further out;
+// "tomorrow" or "in 3 days" for upcoming times.
+export function formatRelativeTime(date) {
+  const days = signedDifferenceInDays(new Date(), date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < 0 && days > -DAYS_IN_A_WEEK) {
+    return `${-days} days ago`
+  } else if (days > 0 && days < DAYS_IN_A_WEEK) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+export function formatTime(date) {
+  return formatter({ hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+export function formatDate(date) {
+  return formatter(withYearUnlessCurrent(date, { month: "short", day: "numeric" })).format(date)
+}
+
+export function formatWeekdayDate(date) {
+  return formatter(withYearUnlessCurrent(date, { weekday: "long", month: "long", day: "numeric" })).format(date)
+}
+
+export function formatDatetime(date) {
+  return formatter(withYearUnlessCurrent(date, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })).format(date)
+}
+
+function formatFullDatetime(date) {
+  return formatter({ weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function withYearUnlessCurrent(date, options) {
+  if (yearInTimezone(date) === yearInTimezone(new Date())) {
+    return options
+  } else {
+    return { ...options, year: "numeric" }
+  }
+}
+
+function yearInTimezone(date) {
+  return parseInt(formatter({ year: "numeric" }).format(date), 10)
+}
+
+const formatters = new Map()
+
+// Format in the timezone the server rendered with (the `timezone` meta tag),
+// so times line up with server-side day boundaries, falling back to the
+// browser's own timezone when it's missing or unknown.
+function formatter(options) {
+  const timezone = getMetaContent("timezone")
+  const key = `${timezone}:${JSON.stringify(options)}`
+
+  if (!formatters.has(key)) {
+    formatters.set(key, buildFormatter(options, timezone))
+  }
+
+  return formatters.get(key)
+}
+
+function buildFormatter(options, timezone) {
+  try {
+    return new Intl.DateTimeFormat("en-US", { ...options, timeZone: timezone })
+  } catch {
+    return new Intl.DateTimeFormat("en-US", options)
+  }
+}
