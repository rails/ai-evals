diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..83b10f3
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag renders a time tag with the raw UTC timestamp" do
+    tag = local_time_tag Time.zone.parse("2025-09-12 09:42:00 -0400")
+
+    assert_dom_equal %(<time datetime="2025-09-12T13:42:00Z" data-controller="local-time" data-local-time-style-value="relative">Sep 12, 2025</time>), tag
+  end
+
+  test "local_time_tag styles" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_includes local_time_tag(time, :time), %(data-local-time-style-value="time")
+    assert_includes local_date_tag(time), %(data-local-time-style-value="date")
+    assert_includes local_weekday_date_tag(time), %(data-local-time-style-value="weekday-date")
+    assert_includes local_datetime_tag(time), %(data-local-time-style-value="datetime")
+    assert_includes local_relative_time_tag(time), %(data-local-time-style-value="relative")
+  end
+
+  test "local_time_tag renders fallback text in UTC so the HTML is shareable" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_equal "1:42 PM", time_text(local_time_tag(time, :time))
+    assert_equal "Sep 12", time_text(local_date_tag(time))
+    assert_equal "Friday, September 12", time_text(local_weekday_date_tag(time))
+    assert_equal "Sep 12, 1:42 PM", time_text(local_datetime_tag(time))
+    assert_equal "Sep 12, 2025", time_text(local_relative_time_tag(time))
+  end
+
+  test "local_time_tag accepts html options" do
+    tag = local_date_tag Time.utc(2025, 9, 12), class: "card__timestamp"
+
+    assert_includes tag, %(class="card__timestamp")
+  end
+
+  test "local_time_tag renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  private
+    def time_text(tag)
+      Nokogiri::HTML5.fragment(tag).at_css("time").text
+    end
+end
