diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..757ba3e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,53 @@
 module TimeHelper
+  # Renders a <time> tag carrying the raw UTC timestamp. The local-time
+  # Stimulus controller rewrites its contents in the viewer's own timezone,
+  # so the HTML can be cached and shared between people in different
+  # timezones. The text rendered here is only a no-JS fallback, in UTC.
+  #
+  # Styles:
+  #   relative:     "1:42 PM" (today), "yesterday", "5 days ago", "Sep 12";
+  #                 "tomorrow", "in 3 days" for upcoming times
+  #   time:         "1:42 PM"
+  #   date:         "Sep 12" ("Sep 12, 2024" when it's not this year)
+  #   weekday-date: "Tuesday, September 9"
+  #   datetime:     "Sep 12, 1:42 PM"
+  def local_time_tag(time, style = :relative, **options)
+    if time
+      style = style.to_s.dasherize
+
+      tag.time local_time_fallback_text(time, style),
+        datetime: time.utc.iso8601,
+        data: { controller: "local-time", local_time_style_value: style, **options.delete(:data).to_h },
+        **options
+    end
+  end
+
+  def local_relative_time_tag(time, **options)
+    local_time_tag time, :relative, **options
+  end
+
+  def local_date_tag(time, **options)
+    local_time_tag time, :date, **options
+  end
+
+  def local_weekday_date_tag(time, **options)
+    local_time_tag time, :"weekday-date", **options
+  end
+
+  def local_datetime_tag(time, **options)
+    local_time_tag time, :datetime, **options
+  end
+
+  private
+    LOCAL_TIME_FALLBACK_FORMATS = {
+      "time" => "%l:%M %p",
+      "date" => "%b %-d",
+      "weekday-date" => "%A, %B %-d",
+      "datetime" => "%b %-d, %l:%M %p",
+      "relative" => "%b %-d, %Y"
+    }
+
+    def local_time_fallback_text(time, style)
+      time.utc.strftime(LOCAL_TIME_FALLBACK_FORMATS.fetch(style)).squish
+    end
 end
