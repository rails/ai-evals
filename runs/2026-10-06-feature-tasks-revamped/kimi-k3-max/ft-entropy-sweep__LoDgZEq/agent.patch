diff --git a/script/repro_entropy_sweep.rb b/script/repro_entropy_sweep.rb
new file mode 100644
index 0000000..49e0d11
--- /dev/null
+++ b/script/repro_entropy_sweep.rb
@@ -0,0 +1,88 @@
+# Reproduction for: hourly entropy sweep (Card.auto_postpone_all_due) exceeding its hour
+# on a SQLite install with 100k+ cards.
+#
+# Usage: bin/rails runner script/repro_entropy_sweep.rb
+require "benchmark"
+
+CARD_COUNT   = ENV.fetch("CARD_COUNT", 120_000).to_i
+BOARD_COUNT  = 20
+DUE_FRACTION = 0.05
+
+def seed!
+  if Card.count >= CARD_COUNT
+    puts "Already seeded (#{Card.count} cards), skipping seed."
+    return
+  end
+
+  puts "Seeding #{CARD_COUNT} cards..."
+  identity = Identity.find_or_create_by!(email_address: "entropy-stress@example.com")
+  account  = Account.find_by(name: "Entropy Stress") || Account.create_with_owner(
+    account: { name: "Entropy Stress" },
+    owner:   { name: "Stress Tester", identity: identity }
+  )
+  Current.account = account
+  owner = account.users.first
+
+  boards = BOARD_COUNT.times.map do |i|
+    Board.find_or_create_by!(name: "Stress Board #{i}", account: account, creator: owner)
+  end
+
+  # Two boards get their own entropy periods (3 days, 90 days)
+  boards[2].entropy&.destroy
+  boards[2].create_entropy!(account: account, auto_postpone_period: 3.days.to_i)
+  boards[5].entropy&.destroy
+  boards[5].create_entropy!(account: account, auto_postpone_period: 90.days.to_i)
+
+  now = Time.current
+  existing = Card.count
+  batch = []
+  CARD_COUNT.times do |i|
+    board = boards[i % BOARD_COUNT]
+    # ~5% of cards are due to be postponed (inactive longer than any period)
+    last_active = (i % 100 < DUE_FRACTION * 100) ? (now - 400.days + (i % 30).days) : now - (i % 25).days
+    batch << {
+      id: ActiveRecord::Type::Uuid.generate,
+      account_id: account.id, board_id: board.id, creator_id: owner.id,
+      number: existing + i + 1, status: "published",
+      title: "Card #{i}", last_active_at: last_active,
+      created_at: last_active, updated_at: last_active
+    }
+    if batch.size >= 5000
+      Card.insert_all(batch)
+      batch.clear
+      print "."
+    end
+  end
+  Card.insert_all(batch) if batch.any?
+  account.update!(cards_count: Card.where(account: account).count)
+  puts "\nSeeded: cards=#{Card.count} boards=#{Board.count} entropies=#{Entropy.count}"
+end
+
+def explain(relation, label)
+  sql = relation.to_sql
+  puts "\n=== #{label} ==="
+  puts sql
+  puts "--- QUERY PLAN ---"
+  ActiveRecord::Base.connection.select_all("EXPLAIN QUERY PLAN #{sql}").each { |row| puts row.values.last }
+end
+
+def time_query(relation, label)
+  elapsed = Benchmark.realtime { relation.load }
+  puts format("%-40s %8.2f s (%d rows)", "#{label} (load)", elapsed, relation.size)
+end
+
+seed!
+puts "\nCards: #{Card.count}"
+
+relation = Card.due_to_be_postponed
+explain(relation, "due_to_be_postponed")
+
+# Time a plain count (aggregate) -- shows raw scan cost
+puts "\n=== TIMING ==="
+elapsed = Benchmark.realtime { @due_count = relation.count }
+puts format("%-40s %8.2f s (%d due)", "due_to_be_postponed.count", elapsed, @due_count)
+
+# Time the first find_each-style batch (ORDER BY id LIMIT 1000)
+batch_sql = relation.order(Card.primary_key => :asc).limit(1000).to_sql
+elapsed = Benchmark.realtime { ActiveRecord::Base.connection.select_all(batch_sql).to_a }
+puts format("%-40s %8.2f s", "first find_each batch (limit 1000)", elapsed)
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..818a4c8 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,57 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due with the shortest entropy period" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    Card.update_all(last_active_at: 1.hour.ago)
+    cards(:logo).update!(last_active_at: 3.days.ago - 1.hour)
+    cards(:shipping).update!(last_active_at: 3.days.ago + 1.hour)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due with the longest entropy period" do
+    entropies(:writebook_board).update! auto_postpone_period: 365.days
+
+    cards(:logo).update!(last_active_at: 365.days.ago - 1.hour)
+    cards(:shipping).update!(last_active_at: 365.days.ago + 1.hour)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "postponing soon with the shortest entropy period" do
+    cards(:logo, :shipping).each(&:published!)
+
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    cards(:logo).update!(last_active_at: 2.28.days.ago)
+    cards(:shipping).update!(last_active_at: 2.22.days.ago)
+
+    assert_includes Card.postponing_soon, cards(:logo)
+    assert_not_includes Card.postponing_soon, cards(:shipping)
+  end
+
+  test "postponing soon with the longest entropy period" do
+    cards(:logo, :shipping).each(&:published!)
+
+    entropies(:writebook_board).update! auto_postpone_period: 365.days
+
+    cards(:logo).update!(last_active_at: 277.days.ago)
+    cards(:shipping).update!(last_active_at: 270.days.ago)
+
+    assert_includes Card.postponing_soon, cards(:logo)
+    assert_not_includes Card.postponing_soon, cards(:shipping)
+  end
 end
