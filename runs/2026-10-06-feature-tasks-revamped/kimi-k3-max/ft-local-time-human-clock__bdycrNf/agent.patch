diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..5c2342a
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/datetime_helpers"
+
+// Rewrites <time datetime="…"> elements in the viewer's own timezone. Watches
+// the datetime attribute and contents so Turbo morph refreshes re-render too.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.#render()
+
+    this.observer = new MutationObserver(() => this.#render())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ], childList: true, characterData: true, subtree: true })
+  }
+
+  disconnect() {
+    this.observer.disconnect()
+  }
+
+  #render() {
+    const timestamp = this.element.getAttribute("datetime")
+
+    if (timestamp) {
+      const formatted = formatTimestamp(timestamp, this.formatValue)
+
+      if (this.element.textContent !== formatted) {
+        this.element.textContent = formatted
+      }
+    }
+  }
+}
diff --git a/app/javascript/helpers/datetime_helpers.js b/app/javascript/helpers/datetime_helpers.js
new file mode 100644
index 0000000..6282e86
--- /dev/null
+++ b/app/javascript/helpers/datetime_helpers.js
@@ -0,0 +1,98 @@
+const DAY_IN_MS = 24 * 60 * 60 * 1000
+
+// Turns a raw timestamp into words in the viewer's own timezone, so the server
+// can send everyone the same timestamp and stay out of the rendering business.
+//
+// Formats:
+//   relative       today "1:42 PM", "yesterday", "5 days ago", "tomorrow", "in 3 days", else a date
+//   date           "Jan 4" ("Jan 4, 2024" when another year)
+//   date_with_year "Jan 4, 2024"
+//   weekday_date   "Saturday, January 4"
+//   time           "1:42 PM"
+//   short_datetime "1/4/26, 1:42 PM"
+export function formatTimestamp(value, format = "relative", now = new Date()) {
+  const date = parseTimestamp(value)
+
+  if (isNaN(date)) {
+    return value
+  } else {
+    switch (format) {
+      case "date": return formatDate(date, now)
+      case "date_with_year": return formatDateWithYear(date)
+      case "weekday_date": return formatWeekdayDate(date)
+      case "time": return formatTime(date)
+      case "short_datetime": return formatShortDateTime(date)
+      default: return formatRelativeTime(date, now)
+    }
+  }
+}
+
+export function formatRelativeTime(date, now = new Date()) {
+  const days = differenceInCalendarDays(now, date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days < -1 && days > -7) {
+    return `${-days} days ago`
+  } else if (days > 1 && days < 7) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+function formatDate(date, now = new Date()) {
+  const options = { month: "short", day: "numeric" }
+
+  if (date.getFullYear() !== now.getFullYear()) {
+    options.year = "numeric"
+  }
+
+  return formatWithOptions(date, options)
+}
+
+function formatDateWithYear(date) {
+  return formatWithOptions(date, { month: "short", day: "numeric", year: "numeric" })
+}
+
+function formatWeekdayDate(date) {
+  return formatWithOptions(date, { weekday: "long", month: "long", day: "numeric" })
+}
+
+function formatTime(date) {
+  return formatWithOptions(date, { hour: "numeric", minute: "2-digit" })
+}
+
+function formatShortDateTime(date) {
+  return formatWithOptions(date, { dateStyle: "short", timeStyle: "short" })
+}
+
+function formatWithOptions(date, options) {
+  // Intl sometimes emits narrow/no-break spaces (e.g. before AM/PM); the app
+  // has always rendered plain spaces, so keep the output consistent.
+  return new Intl.DateTimeFormat("en-US", options).format(date).replace(/[\u00a0\u202f]/g, " ")
+}
+
+function differenceInCalendarDays(fromDate, toDate) {
+  return Math.round((startOfDay(toDate) - startOfDay(fromDate)) / DAY_IN_MS)
+}
+
+function startOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+// Calendar dates arrive date-only ("2025-01-04") and mean that day in the
+// viewer's own timezone, so parse them as a local date rather than UTC midnight.
+function parseTimestamp(value) {
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+
+  if (dateOnly) {
+    return new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3]))
+  } else {
+    return new Date(value)
+  }
+}
