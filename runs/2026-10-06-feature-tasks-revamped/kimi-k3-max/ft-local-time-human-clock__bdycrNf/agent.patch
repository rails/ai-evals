diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..df1841b 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,26 @@
 module TimeHelper
+  # Renders a <time> tag carrying the raw timestamp, which the local-time
+  # Stimulus controller turns into words in the viewer's own timezone. Keeps
+  # rendered HTML free of server-timezone dates so it can be cached and shared
+  # between people in different timezones.
+  def local_time_tag(time, format = :relative, **options)
+    local_timestamp_tag(time&.utc&.iso8601, format, **options)
+  end
+
+  # For calendar dates, where there is no time of day to localize. Rendered as
+  # a date-only timestamp so the label doesn't shift with the viewer's timezone.
+  def local_date_tag(date, format = :weekday_date, **options)
+    local_timestamp_tag(date&.to_date&.iso8601, format, **options)
+  end
+
+  private
+    def local_timestamp_tag(timestamp, format, **options)
+      if timestamp.present?
+        data = (options[:data] || {}).dup
+        controller = token_list("local-time", data.delete(:controller))
+        options[:data] = { controller: controller, local_time_format_value: format }.merge(data)
+
+        tag.time timestamp, datetime: timestamp, **options
+      end
+    end
 end
