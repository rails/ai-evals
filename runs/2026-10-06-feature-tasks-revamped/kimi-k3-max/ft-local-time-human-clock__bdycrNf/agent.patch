diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..f15df51
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag renders a time element carrying the raw timestamp" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12T14:42:00Z" data-controller="local-time" data-local-time-format-value="relative">2025-09-12T14:42:00Z</time>),
+      local_time_tag(Time.utc(2025, 9, 12, 14, 42))
+  end
+
+  test "local_time_tag renders in the given format" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12T14:42:00Z" data-controller="local-time" data-local-time-format-value="short_datetime">2025-09-12T14:42:00Z</time>),
+      local_time_tag(Time.utc(2025, 9, 12, 14, 42), :short_datetime)
+  end
+
+  test "local_time_tag converts to UTC" do
+    time = ActiveSupport::TimeZone["Pacific Time (US & Canada)"].parse("2025-09-12 07:42:00")
+
+    assert_equal_html \
+      %(<time datetime="2025-09-12T14:42:00Z" data-controller="local-time" data-local-time-format-value="relative">2025-09-12T14:42:00Z</time>),
+      local_time_tag(time)
+  end
+
+  test "local_time_tag accepts html options" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12T14:42:00Z" class="txt-small" data-controller="local-time" data-local-time-format-value="relative">2025-09-12T14:42:00Z</time>),
+      local_time_tag(Time.utc(2025, 9, 12, 14, 42), class: "txt-small")
+  end
+
+  test "local_time_tag merges data options" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12T14:42:00Z" data-controller="local-time" data-local-time-format-value="relative" data-action="click->x#y">2025-09-12T14:42:00Z</time>),
+      local_time_tag(Time.utc(2025, 9, 12, 14, 42), data: { action: "click->x#y" })
+  end
+
+  test "local_time_tag combines controllers" do
+  assert_equal_html \
+    %(<time datetime="2025-09-12T14:42:00Z" data-controller="local-time tooltip" data-local-time-format-value="relative" data-tooltip-text-value="hi">2025-09-12T14:42:00Z</time>),
+    local_time_tag(Time.utc(2025, 9, 12, 14, 42), data: { controller: "tooltip", tooltip_text_value: "hi" })
+end
+
+test "local_time_tag renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "local_date_tag renders a date-only timestamp that won't shift with the timezone" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12" data-controller="local-time" data-local-time-format-value="weekday_date">2025-09-12</time>),
+      local_date_tag(Time.utc(2025, 9, 12, 23, 30))
+  end
+
+  test "local_date_tag renders in the given format" do
+    assert_equal_html \
+      %(<time datetime="2025-09-12" data-controller="local-time" data-local-time-format-value="date">2025-09-12</time>),
+      local_date_tag(Date.new(2025, 9, 12), :date)
+  end
+end
