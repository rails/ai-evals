diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f9f80ba
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "search without a query renders the page" do
+    get search_path
+
+    assert_response :success
+  end
+
+  test "search with a blank query finds nothing" do
+    get search_path(q: "")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "search finds cards by title and highlights the match" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: /logo/i
+  end
+
+  test "search finds cards by description" do
+    cards(:logo).update!(description: "Make the logotype bigger")
+
+    get search_path(q: "logotype")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:logo))
+    assert_select "mark", text: "logotype"
+  end
+
+  test "search finds cards by the body of any comment on them" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:layout))
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "search results are newest first" do
+    with_current_user(:david) do
+      @old_card = boards(:writebook).cards.create!(title: "Searching for yesteryear", creator: users(:david), status: :published, created_at: 1.week.ago)
+      @new_card = boards(:writebook).cards.create!(title: "Searching for tomorrow", creator: users(:david), status: :published, created_at: 1.hour.ago)
+    end
+
+    get search_path(q: "searching")
+
+    assert_response :success
+    assert_operator response.body.index(card_path(@new_card)), :<, response.body.index(card_path(@old_card))
+  end
+
+  test "search only finds cards on boards the user can access" do
+    with_current_user(:kevin) do
+      @secret_card = boards(:private).cards.create!(title: "Secret squirrel plan", creator: users(:kevin), status: :published)
+    end
+    secret_card_path = card_path(@secret_card)
+
+    get search_path(q: "squirrel")
+    assert_response :success
+    assert_select "a[href=?]", secret_card_path, count: 0
+
+    sign_out
+    sign_in_as :kevin
+
+    get search_path(q: "squirrel")
+    assert_response :success
+    assert_select "a[href=?]", secret_card_path
+  end
+
+  test "search never finds draft cards or their comments" do
+    with_current_user(:david) do
+      card = boards(:writebook).cards.create!(title: "Unpublished brainstorm", creator: users(:david), status: :published)
+      card.comments.create!(body: "brainstorm notes", creator: users(:david))
+      card.update_column :status, "drafted"
+      @draft_card = card
+    end
+
+    get search_path(q: "brainstorm")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(@draft_card), count: 0
+    assert_no_match "brainstorm notes", response.body
+  end
+
+  test "search escapes HTML in the query" do
+    get search_path(q: "<script>alert('xss')</script>")
+
+    assert_response :success
+    assert_no_match "<script>alert", response.body
+  end
+
+  test "search escapes HTML in card content" do
+    with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "<script>alert('xss')</script>", creator: users(:david), status: :published)
+    end
+
+    get search_path(q: "script")
+
+    assert_response :success
+    assert_no_match "<script>alert", response.body
+  end
+
+  test "search matches multi-word phrases" do
+    get search_path(q: "too small")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(cards(:text))
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_response :redirect
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..4b63c14
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @cards = users(:david).accessible_cards
+  end
+
+  test "search finds cards by title, description, or comment body" do
+    cards(:logo).update!(description: "All about typography")
+
+    assert_includes @cards.search("logo"), cards(:logo)
+    assert_includes @cards.search("typography"), cards(:logo)
+    assert_includes @cards.search("overflowing"), cards(:layout)
+  end
+
+  test "search is case insensitive" do
+    assert_includes @cards.search("LOGO"), cards(:logo)
+  end
+
+  test "search escapes LIKE wildcards" do
+    card = with_current_user(:david) { boards(:writebook).cards.create!(title: "100% coverage", creator: users(:david), status: :published) }
+
+    assert_includes @cards.search("100%"), card
+    assert_not_includes @cards.search("100_"), card
+  end
+
+  test "search returns each matching card only once" do
+    card = with_current_user(:david) do
+      boards(:writebook).cards.create!(title: "Overlapping matches", creator: users(:david), status: :published).tap do |card|
+        card.comments.create!(body: "Overlapping matches here too", creator: users(:david))
+        card.update!(description: "And overlapping matches in the description")
+      end
+    end
+
+    assert_equal [ card ], @cards.search("overlapping").to_a
+  end
+
+  test "search is newest first" do
+    with_current_user(:david) do
+      @old_card = boards(:writebook).cards.create!(title: "Chronologically old", creator: users(:david), status: :published, created_at: 1.week.ago)
+      @new_card = boards(:writebook).cards.create!(title: "Chronologically new", creator: users(:david), status: :published, created_at: 1.hour.ago)
+    end
+
+    assert_equal [ @new_card, @old_card ], @cards.search("chronologically").to_a
+  end
+
+  test "blank queries return no cards" do
+    assert_empty @cards.search(nil)
+    assert_empty @cards.search("")
+    assert_empty @cards.search("   ")
+  end
+
+  test "search only finds published cards" do
+    assert_not_includes @cards.search("unfinished"), cards(:unfinished_thoughts)
+  end
+
+  test "search only finds cards on boards the user can access" do
+    card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Private matters", creator: users(:kevin), status: :published) }
+
+    assert_not_includes @cards.search("private matters"), card
+    assert_includes users(:kevin).accessible_cards.search("private matters"), card
+  end
+end
