+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    set_page_and_extract_portion_from Current.user.accessible_cards.search(@query).includes(:board).with_rich_text_description
+
+    @comments_by_card = Comment.search(@query).where(card: @page.records).chronologically.includes(:creator).with_rich_text_body.group_by(&:card_id)
+  end
+end
