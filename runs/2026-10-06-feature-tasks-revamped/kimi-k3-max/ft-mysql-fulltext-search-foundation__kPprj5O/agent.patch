new file mode 100644
index 0000000..8907ed5
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,27 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Finds published cards whose title, description, or any comment body mentions
+    # the query, newest first. Call on a relation that scopes access, e.g.
+    # Current.user.accessible_cards, so people only ever see what they can access.
+    def search(query)
+      if (query = query.to_s.strip).present?
+        pattern = "%#{sanitize_sql_like(query)}%"
+
+        published
+          .where("cards.title LIKE ? ESCAPE '\\'", pattern)
+          .or(published.where(id: with_description_matching(pattern)))
+          .or(published.where(id: Comment.search(query).select(:card_id)))
+          .reverse_chronologically
+      else
+        none
+      end
+    end
+
+    private
+      def with_description_matching(pattern)
+        joins(:rich_text_description).where("action_text_rich_texts.body LIKE ? ESCAPE '\\'", pattern)
+      end
+  end
+end
