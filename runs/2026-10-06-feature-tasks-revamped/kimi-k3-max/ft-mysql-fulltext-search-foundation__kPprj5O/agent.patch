+<article class="search-result flex flex-column gap-half" id="<%= dom_id(card, :search) %>">
+  <div class="search-result__title flex align-center gap-half">
+    <%= link_to highlight(card.title, query), card, class: "search-result__link txt-medium" %>
+    <span class="search-result__board txt-x-small txt-subtle">in <%= card.board.name %></span>
+  </div>
+
+  <% if search_match?(card.description.to_plain_text, query) %>
+    <div class="search-result__description txt-small">
+      <%= highlight(card.description.to_plain_text, query) %>
+    </div>
+  <% end %>
+
+  <% comments.each do |comment| %>
+    <div class="search-result__comment txt-small">
+      <span class="txt-subtle"><%= comment.creator.name %> commented:</span>
+      <%= highlight(comment.body.to_plain_text, query) %>
+    </div>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..092018e
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,27 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search panel panel--wide center shadow flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half", data: { controller: "form" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…", class: "input flex-item-grow", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <section class="search__results flex flex-column gap">
+        <%= with_automatic_pagination :"search-results", @page do %>
+          <% @page.records.each do |card| %>
+            <%= render "searches/result", card: card, query: @query, comments: @comments_by_card.fetch(card.id, []) %>
+          <% end %>
+        <% end %>
+      </section>
+    <% else %>
+      <p class="blank-slate">No cards found for &ldquo;<%= @query %>&rdquo;</p>
+    <% end %>
+  <% end %>
+</div>
