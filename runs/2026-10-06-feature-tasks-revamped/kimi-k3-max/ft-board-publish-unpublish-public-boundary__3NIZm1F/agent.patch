diff --git a/test/integration/board_publication_test.rb b/test/integration/board_publication_test.rb
new file mode 100644
index 0000000..08685a9
--- /dev/null
+++ b/test/integration/board_publication_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class BoardPublicationTest < ActionDispatch::IntegrationTest
+  test "the whole publication flow" do
+    board = boards(:writebook)
+
+    # Boards are private by default
+    assert_not board.published?
+
+    # Only admins can publish
+    sign_in_as :david
+    post board_publication_path(board)
+    assert_response :forbidden
+    assert_not board.reload.published?
+
+    # Admins can publish
+    logout_and_sign_in_as :kevin
+    post board_publication_path(board)
+    assert board.reload.published?
+
+    get board_path(board), as: :json
+    assert @response.parsed_body["public_url"].end_with?("/public/boards/#{board.publication_key}")
+
+    # Anyone with the link can see the board, its columns, and its published cards
+    key = board.publication_key
+    untenanted do
+      get public_board_path(key)
+      assert_response :success
+
+      get public_board_column_path(key, columns(:writebook_in_progress))
+      assert_response :success
+
+      get public_board_card_path(key, cards(:logo).number)
+      assert_response :success
+    end
+
+    # Unpublishing closes access again
+    delete board_publication_path(board)
+    assert_not board.reload.published?
+
+    get board_path(board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+
+    untenanted do
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..f2f3a76
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+  end
+
+  test "publish generates a publication key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.publication_key.present?
+  end
+
+  test "publish keeps the existing publication key" do
+    @board.publish
+
+    assert_no_changes -> { @board.reload.publication_key } do
+      @board.publish
+    end
+  end
+
+  test "unpublish removes the publication key" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication_key
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+  end
+end
