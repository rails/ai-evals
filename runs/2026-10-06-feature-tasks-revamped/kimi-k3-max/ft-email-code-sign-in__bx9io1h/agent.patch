+<% @page_title = "Enter your verification code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your 6-character code…", maxlength: 6 %>
+      </label>
+    </div>
+
+    <p>We sent a 6-character code to <strong><%= @magic_link.identity.email_address %></strong>. Enter it above to continue. The code works for <%= distance_of_time_in_words(MagicLink::EXPIRATION_DURATION) %>.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? %>
+    <p class="txt-subtle txt-small margin-block-start">Psst, here's your code: <strong><%= @magic_link.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
