diff --git a/app/views/reactions/_form.html.erb b/app/views/reactions/_form.html.erb
new file mode 100644
index 0000000..b139ac3
--- /dev/null
+++ b/app/views/reactions/_form.html.erb
@@ -0,0 +1,38 @@
+<%= tag.div id: dom_id(reactable, :reaction_form), class: "reaction__form", hidden: true,
+      data: { reaction_form_target: "form", turbo_permanent: true } do %>
+  <%= form_with model: Reaction.new, url: reactions_path_for(reactable), namespace: dom_id(reactable),
+        data: { controller: "form", action: "turbo:submit-start->form#preventEmptySubmit keydown.esc->reaction-form#collapse:stop" } do |form| %>
+    <details class="reaction__menu" data-reaction-form-target="menu" data-controller="details" data-details-target="details"
+          data-action="click@document->details#closeOnClickOutside">
+      <summary class="reaction__menu-btn btn" title="Pick an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </summary>
+
+      <div class="reaction__popup popup panel">
+        <div class="reaction__emoji-list">
+          <% ReactionsHelper::EMOJI_CHOICES.each do |emoji| %>
+            <button type="button" class="btn" data-action="reaction-form#pick"><%= emoji %></button>
+          <% end %>
+        </div>
+      </div>
+    </details>
+
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: Reaction::MAX_CONTENT_LENGTH,
+            required: true, autocomplete: "off", placeholder: "React…",
+            data: { reaction_form_target: "input", form_target: "input" } %>
+    <% end %>
+
+    <button type="submit" class="reaction__submit-btn btn" title="Add reaction">
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    </button>
+
+    <button type="button" class="reaction__cancel-btn btn" title="Cancel" data-action="reaction-form#collapse">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+<% end %>
