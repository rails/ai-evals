new file mode 100644
index 0000000..483b0f5
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,17 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  EMOJI_PATTERN = /\A(?:\p{Extended_Pictographic}|\u{200D}|\u{FE0F}|\u{20E3}|\u{1F3FB}-\u{1F3FF}|\s)+\z/
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :ordered, -> { order created_at: :asc, id: :asc }
+
+  def emoji_only?
+    content.match?(EMOJI_PATTERN) && content.match?(/\p{Extended_Pictographic}/)
+  end
+end
