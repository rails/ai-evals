+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :ensure_card_is_published, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def index
+    @reactions = @card.reactions.ordered
+  end
+
+  def create
+    @reaction = @card.reactions.create(reaction_params)
+
+    respond_to do |format|
+      if @reaction.persisted?
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_reaction_path(@card, @reaction, format: :json) }
+      else
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: { errors: @reaction.errors }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def ensure_card_is_published
+      head :forbidden unless @card.published?
+    end
+
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..6ee7614
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,27 @@
+module ReactionsHelper
+  EMOJI_CHOICES = %w[
+    👍 👎 ❤️ 😂 😮 😢 😡 🙏 👏 🔥
+    🎉 🚀 ✅ ⭐ 💯 😍 🤔 👀 💡 ✨
+  ].freeze
+
+  def reactions_path_for(reactable)
+    case reactable
+    when Comment then card_comment_reactions_path(reactable.card, reactable)
+    when Card then card_reactions_path(reactable)
+    end
+  end
+
+  def reaction_path_for(reaction)
+    case reaction.reactable
+    when Comment then card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction)
+    when Card then card_reaction_path(reaction.reactable, reaction)
+    end
+  end
+
+  def reaction_url_for(reaction)
+    case reaction.reactable
+    when Comment then card_comment_reaction_url(reaction.reactable.card, reaction.reactable, reaction)
+    when Card then card_reaction_url(reaction.reactable, reaction)
+    end
+  end
+end
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..da6ba11
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "menu" ]
+
+  expand() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.#closeMenu()
+    this.inputTarget.value = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  pick({ currentTarget }) {
+    this.inputTarget.value = currentTarget.textContent.trim()
+    this.#closeMenu()
+    this.inputTarget.focus()
+  }
+
+  markDeleting(event) {
+    event.target.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  #closeMenu() {
+    if (this.hasMenuTarget) {
+      this.menuTarget.removeAttribute("open")
+    }
+  }
+}
