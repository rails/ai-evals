diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..87d38dc
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "content is limited to 16 characters" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "a" * 16)
+    assert reaction.valid?
+
+    reaction.content = "a" * 17
+    assert_not reaction.valid?
+  end
+
+  test "content must be present" do
+    assert_not comments(:logo_agreement_kevin).reactions.build(content: "").valid?
+    assert_not comments(:logo_agreement_kevin).reactions.build(content: nil).valid?
+  end
+
+  test "reacter defaults to the current user" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍")
+
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "account defaults to the reactable account" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍")
+
+    assert_equal accounts("37s"), reaction.account
+  end
+
+  test "emoji only detection" do
+    assert Reaction.new(content: "👍").emoji_only?
+    assert Reaction.new(content: "🔥🔥").emoji_only?
+    assert Reaction.new(content: "👨‍👩‍👧").emoji_only?
+
+    assert_not Reaction.new(content: "Great 👍").emoji_only?
+    assert_not Reaction.new(content: "hello").emoji_only?
+  end
+
+  test "reactions are ordered chronologically" do
+    comment = comments(:logo_agreement_kevin)
+    comment.reactions.create!(content: "👍")
+    comment.reactions.create!(content: "🎉")
+
+    assert_equal [ "🔥", "👍", "🎉" ], comment.reactions.ordered.pluck(:content)
+  end
+
+  test "creating a reaction touches the comment and its card" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    assert_changes -> { comment.reload.updated_at } do
+      assert_changes -> { card.reload.updated_at } do
+        comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -comment.reactions.count do
+      comment.destroy
+    end
+  end
+
+  test "destroying a card destroys its reactions" do
+    card = cards(:logo)
+
+    assert card.reactions.any?
+    assert_difference -> { Reaction.count }, -card.reactions.count do
+      card.reactions.destroy_all
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..405b6bd
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,113 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "reacting to a comment" do
+    visit card_url(@card)
+
+    within_reactions(@comment) do
+      # The reactions people have left, each showing who left it
+      assert_selector ".reaction", text: "👍"
+      assert_selector ".reaction[data-creator-id='#{users(:kevin).id}']"
+
+      # The button turns into a small input with confirm and cancel
+      click_on "Add a reaction"
+      assert_selector ".reaction__form.expanded"
+      fill_in "Your reaction", with: "🎉"
+
+      # Confirming puts your reaction right there in the strip, the input is
+      # gone, and the button is back for the next one
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "🎉", wait: 5
+      assert_no_selector ".reaction__form.expanded"
+      assert_selector ".reactions__trigger"
+
+      # Canceling brings the button back without adding a reaction
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "nah"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__form.expanded"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction", text: "nah"
+    end
+  end
+
+  test "picking an emoji fills the input" do
+    visit card_url(@card)
+
+    within_reactions(@comment) do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      within(".reaction__emoji-list") { click_on "🔥" }
+
+      assert_field "Your reaction", with: "🔥"
+    end
+  end
+
+  test "removing your own reaction" do
+    visit card_url(@card)
+
+    within_reactions(comments(:logo_agreement_kevin)) do
+      # Clicking your own reaction reveals a way to remove it
+      find(".reaction", text: "🔥").click
+      click_on "Remove your reaction"
+
+      assert_no_selector ".reaction", text: "🔥", wait: 5
+    end
+  end
+
+  test "you cannot remove someone else's reaction" do
+    visit card_url(@card)
+
+    within_reactions(@comment) do
+      find(".reaction", text: "👍").click
+
+      assert_no_selector ".reaction__delete", visible: :visible
+    end
+  end
+
+  test "reactions land as they happen, without reloading" do
+    visit card_url(@card)
+    within_reactions(@comment) { assert_selector ".reaction", count: 1 }
+
+    wait_for_cable_subscriptions
+    @comment.reactions.create!(content: "👀", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within_reactions(@comment) do
+      assert_selector ".reaction", text: "👀", wait: 5
+      assert_selector ".reaction", count: 2
+    end
+  end
+
+  test "boosting a card" do
+    visit card_url(@card)
+
+    within_reactions(@card) do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "🚀"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "🚀", wait: 5
+    end
+  end
+
+  private
+    def within_reactions(reactable, &block)
+      within "##{dom_id(reactable, :reactions)}", &block
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
