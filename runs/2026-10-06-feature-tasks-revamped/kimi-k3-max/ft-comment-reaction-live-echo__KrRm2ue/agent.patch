+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), comment.reactions.last.reacter
+    assert_select "turbo-stream[action=?][target=?]", "replace", "reactions_comment_#{comment.id}"
+  end
+
+  test "create with too long content is unprocessable" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(cards(:logo), comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+    assert_equal "🔥", @response.parsed_body.first["content"]
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(cards(:logo), comment, Reaction.last, format: :json), @response.headers["Location"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(cards(:logo), comment, Reaction.last), @response.parsed_body["url"]
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(cards(:logo), comment), params: { content: "Flat 👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Flat 👍", Reaction.last.content
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    assert_difference -> { comments(:logo_agreement_jz).reactions.count }, -1 do
+      delete card_comment_reaction_path(cards(:logo), reaction.reactable, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=?][target=?]", "remove", "reaction_#{reaction.id}"
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    delete card_comment_reaction_path(cards(:logo), reaction.reactable, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_fire_david)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(cards(:logo), reaction.reactable, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create broadcasts a refresh to everyone looking at the card" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts cards(:logo) do
+        post card_comment_reactions_path(cards(:logo), comments(:logo_agreement_jz)), params: { reaction: { content: "👍" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "destroy broadcasts a refresh to everyone looking at the card" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts cards(:logo) do
+        delete card_comment_reaction_path(cards(:logo), reaction.reactable, reaction), as: :turbo_stream
+      end
+    end
+  end
+end
