+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 55ch;">
+  <div class="flex flex-column gap txt-medium">
+    <p class="margin-none">
+      Bring a Fizzy account export (.zip) back to life as a brand-new account.
+      Everything in the file comes along — boards, cards, comments, files, and people.
+    </p>
+
+    <% if @import.errors.any? %>
+      <p class="txt-negative margin-none"><%= @import.errors.full_messages.to_sentence %></p>
+    <% end %>
+
+    <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+      <label class="flex align-center gap input input--actor">
+        <%= form.file_field :file, class: "input full-width", accept: ".zip,application/zip", required: true %>
+      </label>
+
+      <button type="submit" class="btn btn--link center txt-medium">
+        <%= icon_tag "arrow-up" %>
+        <span>Upload and import</span>
+      </button>
+    <% end %>
+
+    <p class="margin-none txt-small txt-tinted">
+      Importing can take a while for large accounts. You'll get an email when it's done — or if it failed and why.
+    </p>
+  </div>
+</div>
