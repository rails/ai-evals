new file mode 100644
index 0000000..bdcc6ae
--- /dev/null
+++ b/test/test_helpers/zip_file_test_helper.rb
@@ -0,0 +1,19 @@
+module ZipFileTestHelper
+  # Reads a zip archive into a hash of entry name => content (binary string).
+  def read_zip_entries(data)
+    Tempfile.create("test-zip") do |tempfile|
+      tempfile.binmode
+      tempfile.write(data)
+      tempfile.rewind
+
+      ZipKit::FileReader.read_zip_structure(io: tempfile).index_by(&:filename).transform_values do |entry|
+        extractor = entry.extractor_from(tempfile)
+        content = +""
+        while (chunk = extractor.extract(4.megabytes))
+          content << chunk
+        end
+        content
+      end
+    end
+  end
+end
