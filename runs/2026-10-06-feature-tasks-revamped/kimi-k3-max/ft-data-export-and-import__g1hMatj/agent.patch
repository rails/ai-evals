@@ -0,0 +1,18 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @imported_account = import.imported_account
+
+    mail \
+      to: import.user.identity.email_address,
+      subject: "Your Fizzy account import is complete"
+  end
+
+  def failed(import)
+    @import = import
+
+    mail \
+      to: import.user.identity.email_address,
+      subject: "Your Fizzy account import couldn't be completed"
+  end
+end
