diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..f02e9bf
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,47 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  # A card that had a burst of attention and then went quiet is stalled
+  STALLED_AFTER_INACTIVE_PERIOD = 2.weeks
+
+  # A comment burst is three or more comments from at least two people within
+  # a third of the board's auto-close period
+  BURST_MINIMUM_COMMENTS = 3
+  BURST_MINIMUM_COMMENTERS = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER_INACTIVE_PERIOD.ago) }
+  end
+
+  def stalled?
+    active? && last_burst_at? && last_active_at <= STALLED_AFTER_INACTIVE_PERIOD.ago
+  end
+
+  # When the card went (or will go) stalled: after two weeks without activity.
+  # Nil when the card never had a burst.
+  def stalled_at
+    last_active_at + STALLED_AFTER_INACTIVE_PERIOD if last_burst_at?
+  end
+
+  def register_burst
+    update! last_burst_at: Time.current
+  end
+
+  def register_comment_burst
+    register_burst if !burst_recently? && comment_burst?
+  end
+
+  private
+    def burst_recently?
+      last_burst_at? && last_burst_at >= comment_burst_period.seconds.ago
+    end
+
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: comment_burst_period.seconds.ago..Time.current)
+      recent_comments.count >= BURST_MINIMUM_COMMENTS && recent_comments.distinct.count(:creator_id) >= BURST_MINIMUM_COMMENTERS
+    end
+
+    def comment_burst_period
+      auto_postpone_period / 3
+    end
+end
