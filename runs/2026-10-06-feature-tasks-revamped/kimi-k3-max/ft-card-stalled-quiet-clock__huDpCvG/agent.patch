+require "test_helper"
+
+class EntropyHelperTest < ActionView::TestCase
+  test "bubble options expose when the card went stalled so the bubble can flag it" do
+    freeze_time
+
+    card = cards(:layout)
+    card.update! last_active_at: 3.weeks.ago
+
+    assert_nil entropy_bubble_options_for(card)[:stalledAt]
+
+    card.update! last_burst_at: 3.weeks.ago
+
+    assert_equal card.stalled_at.iso8601, entropy_bubble_options_for(card)[:stalledAt]
+    assert_equal card.last_active_at.iso8601, entropy_bubble_options_for(card)[:lastActiveAt]
+  end
+end
diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..a1ba2de
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text) # writebook board auto-closes after 90 days, so the comment burst window is 30 days
+  end
+
+  test "a burst is registered when three comments from at least two people land within a third of the auto-close period" do
+    assert_nil @card.last_burst_at
+
+    comment @card, by: users(:david)
+    comment @card, by: users(:kevin)
+    assert_nil @card.reload.last_burst_at
+
+    comment @card, by: users(:david)
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "no burst when the comments come from a single person" do
+    3.times { comment @card, by: users(:david) }
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "no burst when the comments fall outside a third of the auto-close period" do
+    comment @card, by: users(:david), at: 31.days.ago
+    comment @card, by: users(:kevin), at: 31.days.ago
+    comment @card, by: users(:david)
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the comment burst window falls back to the account auto-close period" do
+    boards(:writebook).entropy.destroy
+    @card.reload
+
+    comment @card, by: users(:david), at: 11.days.ago
+    comment @card, by: users(:kevin), at: 11.days.ago
+    comment @card, by: users(:david)
+
+    assert_nil @card.reload.last_burst_at
+
+    comment @card, by: users(:david), at: 9.days.ago
+    comment @card, by: users(:kevin), at: 9.days.ago
+    comment @card, by: users(:david)
+
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not register bursts" do
+    assert_no_difference -> { Event.count } do
+      3.times { @card.comments.create! body: "System note", creator: users(:system) }
+    end
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assigning someone registers a burst" do
+    assert_changes -> { @card.reload.last_burst_at }, from: nil do
+      @card.toggle_assignment users(:kevin)
+    end
+  end
+
+  test "reopening registers a burst" do
+    @card.close
+
+    assert_changes -> { @card.reload.last_burst_at }, from: nil do
+      @card.reopen
+    end
+  end
+
+  test "a card that had a burst and no activity for two weeks is stalled" do
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert @card.stalled?
+
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 1.week.ago
+    assert_not @card.stalled?
+
+    @card.update! last_burst_at: nil, last_active_at: 3.weeks.ago
+    assert_not @card.stalled?
+  end
+
+  test "stalled boundary is two weeks without activity" do
+    travel_to 4.weeks.from_now do
+      @card.update! last_burst_at: 4.weeks.ago, last_active_at: 2.weeks.ago
+      assert @card.stalled?
+
+      @card.update! last_active_at: 2.weeks.ago + 1.minute
+      assert_not @card.stalled?
+    end
+  end
+
+  test "any activity resets the stalled state" do
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert @card.stalled?
+
+    comment @card, by: users(:kevin)
+    assert_not @card.reload.stalled?
+  end
+
+  test "a card stalls again when it goes quiet after the activity that reset it" do
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    comment @card, by: users(:kevin)
+    assert_not @card.reload.stalled?
+
+    travel_to 15.days.from_now do
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "closed and postponed cards are not stalled" do
+    @card.close
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert_not @card.stalled?
+
+    @card.reopen
+    @card.postpone
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert_not @card.stalled?
+  end
+
+  test "stalled scope" do
+    @card.update! last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    assert_includes Card.stalled, @card
+    assert_not_includes Card.stalled, cards(:logo)
+  end
+
+  private
+    def comment(card, by:, at: Time.current)
+      travel_to at do
+        with_current_user(by) { card.comments.create! body: "Something to say" }
+      end
+    end
+end
