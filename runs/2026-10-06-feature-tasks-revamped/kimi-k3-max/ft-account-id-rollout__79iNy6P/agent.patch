+class FinishAccountIdRollout < ActiveRecord::Migration[8.2]
+  # Every table that holds an account's data carries a required, indexed
+  # account_id. Parents are backfilled before children so that rows orphaned
+  # by a missing parent stay null and are dropped with the rest.
+  TENANT_TABLES = %w[
+    users
+    boards
+    cards columns events webhooks board_publications accesses
+    comments steps assignments closures card_goldnesses card_not_nows card_activity_spikes pins watches taggings
+    filters notification_bundles notifications push_subscriptions search_queries user_settings
+    tags account_join_codes account_imports
+    entropies mentions reactions
+    webhook_delinquency_trackers webhook_deliveries
+    action_text_rich_texts active_storage_attachments active_storage_blobs active_storage_variant_records
+  ]
+
+  # cards and users are indexed on (account_id, ...) already, account_imports
+  # picked up its plain index earlier, and tags get a per-account unique index
+  # on (account_id, title) instead.
+  ALREADY_INDEXED = %w[ account_imports cards tags users ]
+
+  def up
+    add_missing_account_id_columns
+    backfill_account_ids
+    drop_orphaned_rows
+    require_account_ids
+    index_account_ids
+  end
+
+  def down
+    raise ActiveRecord::IrreversibleMigration
+  end
+
+  private
+    def add_missing_account_id_columns
+      missing_column_tables.each do |table|
+        add_column table, :account_id, :uuid
+      end
+    end
+
+    def backfill_account_ids
+      # Rows that belong to an account through their user
+      backfill "boards",               from: "users", on: "users.id = boards.creator_id"
+      backfill "filters",              from: "users", on: "users.id = filters.creator_id"
+      backfill "notification_bundles", from: "users", on: "users.id = notification_bundles.user_id"
+      backfill "notifications",        from: "users", on: "users.id = notifications.user_id"
+      backfill "push_subscriptions",   from: "users", on: "users.id = push_subscriptions.user_id"
+      backfill "search_queries",       from: "users", on: "users.id = search_queries.user_id"
+      backfill "user_settings",        from: "users", on: "users.id = user_settings.user_id"
+
+      # Rows that belong to an account through their board
+      backfill "cards",              from: "boards", on: "boards.id = cards.board_id"
+      backfill "columns",            from: "boards", on: "boards.id = columns.board_id"
+      backfill "events",             from: "boards", on: "boards.id = events.board_id"
+      backfill "webhooks",           from: "boards", on: "boards.id = webhooks.board_id"
+      backfill "board_publications", from: "boards", on: "boards.id = board_publications.board_id"
+      backfill "accesses",           from: "boards", on: "boards.id = accesses.board_id"
+
+      # Rows that belong to an account through their card
+      backfill "comments",             from: "cards", on: "cards.id = comments.card_id"
+      backfill "steps",                from: "cards", on: "cards.id = steps.card_id"
+      backfill "assignments",          from: "cards", on: "cards.id = assignments.card_id"
+      backfill "closures",             from: "cards", on: "cards.id = closures.card_id"
+      backfill "card_goldnesses",      from: "cards", on: "cards.id = card_goldnesses.card_id"
+      backfill "card_not_nows",        from: "cards", on: "cards.id = card_not_nows.card_id"
+      backfill "card_activity_spikes", from: "cards", on: "cards.id = card_activity_spikes.card_id"
+      backfill "pins",                 from: "cards", on: "cards.id = pins.card_id"
+      backfill "watches",              from: "cards", on: "cards.id = watches.card_id"
+      backfill "taggings",             from: "cards", on: "cards.id = taggings.card_id"
+
+      # Tags belong to the account of the cards they are attached to
+      execute(<<~SQL)
+        UPDATE tags
+        SET account_id = (
+          SELECT cards.account_id FROM taggings
+          INNER JOIN cards ON cards.id = taggings.card_id
+          WHERE taggings.tag_id = tags.id AND cards.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+
+      # Entropies belong to their container: the account itself, or its board's account
+      execute(<<~SQL)
+        UPDATE entropies
+        SET account_id = CASE container_type
+          WHEN 'Account' THEN (SELECT id FROM accounts WHERE accounts.id = entropies.container_id)
+          WHEN 'Board' THEN (SELECT account_id FROM boards WHERE boards.id = entropies.container_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      backfill_polymorphic "mentions",  "source",    "Card" => "cards", "Comment" => "comments"
+      backfill_polymorphic "reactions", "reactable", "Card" => "cards", "Comment" => "comments"
+
+      # Webhook machinery belongs to the webhook's account
+      backfill "webhook_delinquency_trackers", from: "webhooks", on: "webhooks.id = webhook_delinquency_trackers.webhook_id"
+      backfill "webhook_deliveries",           from: "webhooks", on: "webhooks.id = webhook_deliveries.webhook_id"
+
+      backfill_polymorphic "action_text_rich_texts", "record", "Card" => "cards", "Comment" => "comments", "Board" => "boards"
+
+      # Attachments belong to the account of the record they are attached to.
+      # Attachments on global records (Identity avatars) stay null and are
+      # dropped as orphans below.
+      execute(<<~SQL)
+        UPDATE active_storage_attachments
+        SET account_id = CASE record_type
+          WHEN 'Card' THEN (SELECT account_id FROM cards WHERE cards.id = active_storage_attachments.record_id)
+          WHEN 'Comment' THEN (SELECT account_id FROM comments WHERE comments.id = active_storage_attachments.record_id)
+          WHEN 'Board' THEN (SELECT account_id FROM boards WHERE boards.id = active_storage_attachments.record_id)
+          WHEN 'User' THEN (SELECT account_id FROM users WHERE users.id = active_storage_attachments.record_id)
+          WHEN 'Export' THEN (SELECT account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'Account::Export' THEN (SELECT account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'User::DataExport' THEN (SELECT account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+          WHEN 'Account::Import' THEN (SELECT account_id FROM account_imports WHERE account_imports.id = active_storage_attachments.record_id)
+          WHEN 'ActionText::RichText' THEN (SELECT account_id FROM action_text_rich_texts WHERE action_text_rich_texts.id = active_storage_attachments.record_id)
+          WHEN 'ActiveStorage::VariantRecord' THEN (
+            SELECT active_storage_blobs.account_id
+            FROM active_storage_variant_records
+            INNER JOIN active_storage_blobs ON active_storage_blobs.id = active_storage_variant_records.blob_id
+            WHERE active_storage_variant_records.id = active_storage_attachments.record_id
+          )
+        END
+        WHERE account_id IS NULL
+      SQL
+
+      # Blobs belong to the account of whatever they are attached to. Blobs
+      # that were never attached stay null and are dropped as orphans below.
+      execute(<<~SQL)
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT account_id FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+
+      backfill "active_storage_variant_records", from: "active_storage_blobs",
+        on: "active_storage_blobs.id = active_storage_variant_records.blob_id"
+    end
+
+    def drop_orphaned_rows
+      TENANT_TABLES.each do |table|
+        execute("DELETE FROM #{table} WHERE account_id IS NULL")
+      end
+    end
+
+    def require_account_ids
+      TENANT_TABLES.each do |table|
+        change_column_null table, :account_id, false
+      end
+    end
+
+    def index_account_ids
+      (TENANT_TABLES - ALREADY_INDEXED).each do |table|
+        add_index table, :account_id
+      end
+
+      # Tags are unique per account now, not across the whole system
+      remove_index :tags, :title
+      add_index :tags, [ :account_id, :title ], unique: true
+    end
+
+    def backfill(table, from:, on:)
+      execute(<<~SQL)
+        UPDATE #{table}
+        SET account_id = (SELECT account_id FROM #{from} WHERE #{on})
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_polymorphic(table, association, sources)
+      cases = sources.map do |type, source|
+        "WHEN '#{type}' THEN (SELECT account_id FROM #{source} WHERE #{source}.id = #{table}.#{association}_id)"
+      end
+
+      execute(<<~SQL)
+        UPDATE #{table}
+        SET account_id = CASE #{association}_type #{cases.join("\n          ")} END
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def missing_column_tables
+      TENANT_TABLES.select { |table| !column_exists?(table, :account_id) }
+    end
+end
