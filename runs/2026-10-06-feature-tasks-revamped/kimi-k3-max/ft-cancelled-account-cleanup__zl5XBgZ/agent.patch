diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..ecff99b
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago along with their data" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: @user)
+    account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.minute)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_empty Board.where(account_id: account.id)
+    assert_empty User.where(account_id: account.id)
+  end
+
+  test "does not incinerate recently cancelled accounts" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert account.reload.cancelled?
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..65bd55b
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.minute)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.minute)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled exactly at the grace period boundary" do
+    freeze_time
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate permanently removes the account and all its data" do
+    @account.cancel(initiated_by: @user)
+    Storage::Entry.create!(account_id: @account.id, delta: 100, operation: "test")
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "incinerate leaves other accounts untouched" do
+    other_account = accounts(:initech)
+
+    @account.incinerate
+
+    assert Account.exists?(other_account.id)
+    assert other_account.users.reload.any?
+    assert other_account.boards.reload.any?
+  end
+end
