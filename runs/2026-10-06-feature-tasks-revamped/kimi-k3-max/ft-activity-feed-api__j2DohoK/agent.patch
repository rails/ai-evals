@@ -0,0 +1,34 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    # Mirrors the events shown in the HTML timeline (see User::DayTimeline::TIMELINEABLE_ACTIONS),
+    # except deprecated card_collection_changed events are omitted and card_title_changed events are included.
+    ACTIONS = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_title_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+      comment_created
+    ]
+
+    def activities
+      @activities ||= begin
+        events = Current.user.accessible_events.preloaded.where(action: ACTIONS).order(created_at: :desc)
+        events = events.where(creator_id: @filter.creators.ids) if @filter.creators.present?
+        events = events.where(board_id: @filter.boards.ids) if @filter.boards.present?
+        events
+      end
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..c04622d
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,21 @@
+module ActivitiesHelper
+  def activity_particulars(activity)
+    case activity.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: activity.assignee_ids }
+    when "card_board_changed"
+      { old_board: activity_particular_value(activity, "old_board"), new_board: activity_particular_value(activity, "new_board") }
+    when "card_title_changed"
+      { old_title: activity_particular_value(activity, "old_title"), new_title: activity_particular_value(activity, "new_title") }
+    when "card_triaged"
+      { column: activity_particular_value(activity, "column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def activity_particular_value(activity, key)
+      activity.particulars.to_h.dig("particulars", key) || ""
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..dad6da5
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,18 @@
+json.cache! [ activity, Current.user ] do
+  json.(activity, :id, :action)
+  json.created_at activity.created_at.utc
+  json.description activity.description_for(Current.user).to_plain_text
+  json.particulars activity_particulars(activity)
+  json.url polymorphic_url(activity.eventable)
+  json.eventable_type activity.eventable_type
+
+  json.eventable do
+    case activity.eventable
+    when Card then json.partial! "cards/card", card: activity.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+    end
+  end
+
+  json.board activity.board, partial: "boards/board", as: :board
+  json.creator activity.creator, partial: "users/user", as: :user
+end
