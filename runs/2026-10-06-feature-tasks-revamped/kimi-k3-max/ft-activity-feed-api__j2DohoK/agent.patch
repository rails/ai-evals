@@ -0,0 +1,68 @@
+# Activities
+
+Activities are the events that happened in the account, such as cards being added, commented on, assigned, moved, or closed. This is the same activity shown in the HTML timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of events from boards the current user has access to, newest activity first. Deprecated `card_collection_changed` events are not included.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user ID(s) who created the events |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David assigned JZ to &quot;Layout is broken&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zppzlksuj4mxba2nbzn"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Writebook",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 90,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "member",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+- `action` is one of `card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, or `comment_created`
+- `description` is the event's plain-text description
+- `url` opens the card; for `comment_created` events, it opens the card and jumps to the comment
+- `eventable` is the card or comment the event is about, following the cards and comments API representations
+- `board` and `creator` follow the boards and users API representations
+- `particulars` contains event-specific details; it is empty for events without details:
+  - `card_assigned` and `card_unassigned` contain `assignee_ids`
+  - `card_board_changed` contains `old_board` and `new_board`
+  - `card_title_changed` contains `old_title` and `new_title`
+  - `card_triaged` contains `column`
+  - Missing board, title, or column values are returned as empty strings
+- The response is paginated; if there are more events, follow the `Link` response header with `rel="next"`
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..c5235b4
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array, newest activity first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_equal Event.count, @response.parsed_body.count
+
+    timestamps = @response.parsed_body.pluck("created_at")
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+  end
+
+  test "index as JSON includes activity attributes" do
+    get activities_path, as: :json
+
+    event = events(:layout_assignment_jz)
+    activity = @response.parsed_body.find { |it| it["id"] == event.id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.eventable_id, activity.dig("eventable", "id")
+    assert_equal event.eventable.title, activity.dig("eventable", "title")
+    assert_equal event.board_id, activity.dig("board", "id")
+    assert_equal event.board.name, activity.dig("board", "name")
+    assert_equal event.creator_id, activity.dig("creator", "id")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+  end
+
+  test "index as JSON points comment events to the comment on the card" do
+    get activities_path, as: :json
+
+    event = events(:layout_commented)
+    activity = @response.parsed_body.find { |it| it["id"] == event.id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.eventable_id, activity.dig("eventable", "id")
+    assert_equal card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable)), activity["url"]
+  end
+
+  test "index as JSON includes assignee ids in particulars for assignment changes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes empty particulars for other events" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["id"] == events(:logo_published).id }
+
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index as JSON includes title changes" do
+    with_current_user(:david) do
+      cards(:logo).update!(title: "The logo needs to be much bigger")
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["action"] == "card_title_changed" }
+    assert_not_nil activity
+    assert_equal "The logo isn't big enough", activity.dig("particulars", "old_title")
+    assert_equal "The logo needs to be much bigger", activity.dig("particulars", "new_title")
+  end
+
+  test "index as JSON includes board changes" do
+    with_current_user(:kevin) do
+      cards(:logo).move_to(boards(:private))
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["action"] == "card_board_changed" }
+    assert_not_nil activity
+    assert_equal "Writebook", activity.dig("particulars", "old_board")
+    assert_equal "Private board", activity.dig("particulars", "new_board")
+  end
+
+  test "index as JSON includes triage events" do
+    with_current_user(:david) do
+      cards(:buy_domain).triage_into(columns(:writebook_in_progress))
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["action"] == "card_triaged" }
+    assert_not_nil activity
+    assert_equal "In progress", activity.dig("particulars", "column")
+  end
+
+  test "index as JSON returns empty strings for missing particular values" do
+    events(:logo_published).update!(action: "card_board_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["id"] == events(:logo_published).id }
+    assert_equal "", activity.dig("particulars", "old_board")
+    assert_equal "", activity.dig("particulars", "new_board")
+  end
+
+  test "index as JSON omits deprecated card collection changed events" do
+    events(:logo_published).update!(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not @response.parsed_body.any? { |it| it["action"] == "card_collection_changed" }
+    assert_not_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "index as JSON filters by creator ids" do
+    get activities_path(creator_ids: [ users(:david).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |it| it.dig("creator", "id") == users(:david).id }
+  end
+
+  test "index as JSON filters by board ids" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Shhh", creator: users(:kevin), status: "published")
+    end
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal 1, @response.parsed_body.count
+    assert_equal boards(:private).id, @response.parsed_body.first.dig("board", "id")
+  end
+
+  test "index only returns activity from boards the current user can access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Shhh", creator: users(:kevin), status: "published")
+    end
+
+    get activities_path, as: :json
+    assert @response.parsed_body.any? { |it| it.dig("board", "id") == boards(:private).id }
+
+    logout_and_sign_in_as :david
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not @response.parsed_body.any? { |it| it.dig("board", "id") == boards(:private).id }
+  end
+
+  test "index as JSON includes assignee ids in particulars for unassignment changes" do
+    with_current_user(:david) do
+      cards(:logo).toggle_assignment(users(:jz))
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |it| it["action"] == "card_unassigned" }
+    assert_not_nil activity
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON returns empty strings for missing triage and title particular values" do
+    events(:layout_published).update!(action: "card_triaged", particulars: {})
+    events(:text_published).update!(action: "card_title_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    triage = @response.parsed_body.find { |it| it["id"] == events(:layout_published).id }
+    assert_equal "", triage.dig("particulars", "column")
+
+    title = @response.parsed_body.find { |it| it["id"] == events(:text_published).id }
+    assert_equal "", title.dig("particulars", "old_title")
+    assert_equal "", title.dig("particulars", "new_title")
+  end
+
+  test "index as JSON paginates" do
+    with_current_user(:david) do
+      5.times { |index| cards(:logo).update!(title: "New title #{index}") }
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal Event.count, @response.headers["X-Total-Count"].to_i
+    assert_equal 15, @response.parsed_body.count
+    assert @response.headers["Link"].present?
+
+    first_page_ids = @response.parsed_body.pluck("id")
+
+    get activities_path(page: 2), as: :json
+
+    assert_response :success
+    assert_equal Event.count - 15, @response.parsed_body.count
+    assert_empty first_page_ids & @response.parsed_body.pluck("id")
+  end
+end
