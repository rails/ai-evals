diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8a040cb
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    travel_to 31.days.ago do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Notification.where(account_id: @account.id)
+  end
+
+  test "does not incinerate accounts cancelled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts that were reactivated" do
+    travel_to 31.days.ago do
+      @account.cancel(initiated_by: @user)
+    end
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..11b1c9d
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerable includes accounts cancelled beyond the grace period" do
+    travel_to (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_includes Account.incinerable, @account
+  end
+
+  test "incinerable excludes accounts cancelled within the grace period" do
+    travel_to (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago do
+      @account.cancel(initiated_by: @user)
+    end
+
+    assert_not_includes Account.incinerable, @account
+  end
+
+  test "incinerable excludes active accounts" do
+    assert_not_includes Account.incinerable, @account
+  end
+
+  test "incinerate permanently removes all data associated with the account" do
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+
+    %w[
+      accesses account_cancellations account_join_codes boards cards closures columns comments
+      entropies events filters mentions notifications tags taggings users watches webhooks
+    ].each do |table|
+      assert_equal 0, unscoped_account_rows(table, @account.id), "Expected no rows left in #{table}"
+    end
+  end
+
+  test "incinerate_due only incinerates accounts past the grace period" do
+    due_account = @account
+    travel_to 31.days.ago do
+      due_account.cancel(initiated_by: @user)
+    end
+
+    recent_account = accounts(:initech)
+    recent_account.cancel(initiated_by: users(:mike))
+
+    active_account = accounts(:acme)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  private
+    def unscoped_account_rows(table, account_id)
+      serialized_id = ActiveRecord::Type::Uuid.new.serialize(account_id)
+      ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{table} WHERE account_id = #{ActiveRecord::Base.connection.quote(serialized_id)}"
+      ).to_i
+    end
+end
