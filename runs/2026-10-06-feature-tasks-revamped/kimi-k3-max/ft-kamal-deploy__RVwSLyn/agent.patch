diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..ae0d009
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,100 @@
+# Kamal deployment configuration for running Fizzy on a single server:
+# the web app, background jobs, and the SQLite databases all run in one
+# container on one box, with SSL handled by kamal-proxy (automatic
+# certificates from Let's Encrypt).
+#
+# To get Fizzy running on your own server:
+#
+#   1. Get a Linux server with Docker installed and point your hostname at it.
+#   2. Replace the placeholders below: your server's IP address, your hostname,
+#      your Docker registry username, and your mail server.
+#   3. Fill in .kamal/secrets (or export the environment variables it references).
+#   4. Run `bin/kamal setup` to deploy. Ship updates with `bin/kamal deploy`.
+#
+# Fizzy will be available at https://<your hostname>. The SQLite databases and
+# uploaded files live in the fizzy-storage Docker volume, so your data survives
+# the next deploy. See docs/deployment.md for more details.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image. Replace "your-docker-hub-username" with your own
+# Docker Hub username or organization.
+image: your-docker-hub-username/fizzy
+
+# Deploy to these servers. Replace 192.0.2.1 with the IP address of your server.
+servers:
+  web:
+    - 192.0.2.1
+
+# Background jobs run inside the web container via Solid Queue's Puma plugin.
+# If you rather run them in a dedicated container on the same box, add a job
+# role with `cmd: bin/jobs` and set SOLID_QUEUE_IN_PUMA: "false" under env/clear:
+#
+# servers:
+#   web:
+#     - 192.0.2.1
+#   job:
+#     hosts:
+#       - 192.0.2.1
+#     cmd: bin/jobs
+
+# kamal-proxy terminates SSL and automatically manages certificates.
+# Replace fizzy.example.com with the hostname pointing at your server.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Credentials for your image registry. Docker Hub is the default; to use
+# another registry, set `server` (e.g. ghcr.io) alongside the credentials.
+registry:
+  username: your-docker-hub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build the image for your server's CPU architecture. Use "arm64" for ARM
+# servers, or build multi-arch images with a remote builder:
+# https://kamal-deploy.org/docs/configuration/builders
+builder:
+  arch: amd64
+
+# Connect over SSH as this user. Defaults to root; many cloud images require
+# a regular user like "ubuntu" that can run Docker.
+# ssh:
+#   user: ubuntu
+
+# Persist the SQLite databases and uploaded files across deploys.
+volumes:
+  - fizzy-storage:/rails/storage
+
+# Keep assets available while old containers drain during a deploy.
+asset_path: /rails/public/assets
+
+# Environment variables. Plain values go under "clear"; "secret" lists the
+# names to read from .kamal/secrets.
+env:
+  clear:
+    # The public hostname of your Fizzy instance. Used for links in emails
+    # and notifications, so keep it in sync with the proxy host above.
+    APP_HOST: fizzy.example.com
+
+    # Outgoing mail server. Fizzy emails sign-in codes, so it needs a working
+    # SMTP server: your own, or a service like Amazon SES, Postmark, or Resend.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_USERNAME: your-smtp-username
+
+    # The sender address for Fizzy's emails.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional, for web push notifications. See docs/development.md.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Helpers for poking around on the server: `bin/kamal console`, `bin/kamal shell`.
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "bash"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..4e9e525 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,30 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Generate absolute URLs (emails, push notifications, webhooks) for the public
+  # hostname Fizzy is served from, e.g. "fizzy.example.com". See config/deploy.yml.
+  if app_host = ENV["APP_HOST"].presence
+    default_url_options = { host: app_host, protocol: config.assume_ssl ? "https" : "http" }
+    config.action_controller.default_url_options = default_url_options
+    config.action_mailer.default_url_options = default_url_options
+  end
+
+  # Deliver email through an external SMTP server when one is configured.
+  # Fizzy emails sign-in codes, so production needs a working mail server.
+  # See config/deploy.yml.
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV["SMTP_DOMAIN"],
+      user_name: ENV["SMTP_USERNAME"],
+      password: ENV["SMTP_PASSWORD"],
+      authentication: (ENV["SMTP_USERNAME"].present? ? ENV.fetch("SMTP_AUTHENTICATION", "plain") : nil),
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..c69995f
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,62 @@
+## Deployment
+
+Fizzy is deployed with [Kamal](https://kamal-deploy.org/). The included `config/deploy.yml` is set up for
+the simplest possible self-hosted installation: a single Linux server running Docker, where the web app,
+background jobs, and the SQLite databases all live in one container, and kamal-proxy handles SSL with
+automatic certificates from Let's Encrypt.
+
+### What you need
+
+- A Linux server with Docker installed, reachable over SSH.
+- A hostname pointing at that server (an A/AAAA record). kamal-proxy needs it to issue the SSL certificate.
+- An SMTP server for outgoing email. Fizzy emails sign-in codes, so it can't send mail without one.
+  Your own server works, and so do services like Amazon SES, Postmark, or Resend.
+- An account on a Docker registry, like Docker Hub, to store the images you build.
+
+### Setting up
+
+1. Fill in the placeholders in `config/deploy.yml`:
+   - `servers`: the IP address of your server.
+   - `proxy/host` and `env/clear/APP_HOST`: your hostname (keep the two in sync).
+   - `image` and `registry/username`: your Docker Hub username or organization.
+   - `env/clear`: your mail server (`SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_DOMAIN`, `SMTP_USERNAME`)
+     and the sender address for Fizzy's emails (`MAILER_FROM_ADDRESS`).
+2. Fill in `.kamal/secrets` — either paste the values in place of the `$VARIABLE` references, or export
+   those variables in your shell. Generate `SECRET_KEY_BASE` with `bin/rails secret`.
+3. Deploy:
+
+   ```sh
+   bin/kamal setup
+   ```
+
+Once the deploy finishes, Fizzy is available at `https://your-hostname`. The SQLite databases and uploaded
+files are stored in the `fizzy-storage` Docker volume, so your data is still there after the next deploy.
+
+### Deploying updates
+
+```sh
+bin/kamal deploy
+```
+
+### Working on the server
+
+```sh
+bin/kamal console       # Rails console
+bin/kamal shell         # Shell inside the running container
+bin/kamal app logs -f   # Follow the logs
+```
+
+### Details and options
+
+- **Background jobs** run inside the web container through Solid Queue's Puma plugin, so there's nothing
+  else to run. If you'd rather have a dedicated job container on the same box, add a `job` role with
+  `cmd: bin/jobs` and set `SOLID_QUEUE_IN_PUMA: "false"` — see the comment in `config/deploy.yml`.
+- **Web push notifications** need a VAPID key pair. Generate one as described in
+  [the development guide](development.md#web-push-notifications) and put the keys in `.kamal/secrets`.
+- **Backups**: all persistent data lives in the `fizzy-storage` volume, mounted at `/rails/storage`.
+  The SQLite databases (`production.sqlite3` and friends) and uploaded files (`production/files`) are
+  in there — back up that volume and you've backed up everything.
+- **Building for another architecture**: `config/deploy.yml` builds `amd64` images by default. For an ARM
+  server, set `builder/arch` to `arm64`, or configure a remote builder for multi-arch images.
+- **No SSL**: if you put Fizzy behind your own load balancer that terminates SSL, remove `ssl`/`host` from
+  the `proxy` section and set `DISABLE_SSL: "true"` under `env/clear` to stop Rails from redirecting to HTTPS.
