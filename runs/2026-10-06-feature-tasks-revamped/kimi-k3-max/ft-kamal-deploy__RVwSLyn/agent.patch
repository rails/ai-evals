+++ b/.kamal/secrets
@@ -0,0 +1,20 @@
+# Secrets for deploying Fizzy with Kamal, referenced from config/deploy.yml.
+#
+# Either fill in the values directly, or keep the $VARIABLE references and
+# export those variables in your shell before deploying. Quote values that
+# contain spaces or special characters, and keep real secrets out of git!
+
+# Password (or access token) for the Docker registry from config/deploy.yml.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Rails secret key base, used to sign and encrypt cookies and more.
+# Generate one with: bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP server configured in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional: VAPID key pair for web push notifications. Generate one with:
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}", "VAPID_PRIVATE_KEY=#{key.private_key}"'
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
