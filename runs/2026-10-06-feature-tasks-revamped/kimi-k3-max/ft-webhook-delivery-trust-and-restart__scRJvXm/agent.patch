--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,10 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  CLEANUP_BATCH_SIZE = 1_000
+
+  TIMEOUT = 5
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +16,28 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).in_batches(of: CLEANUP_BATCH_SIZE, &:delete_all)
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    payload = render_payload
+    headers = headers_for(payload)
+
+    # Claiming is what makes delivery exactly-once: only the performer that
+    # moves the delivery out of pending goes on to post.
+    if claim_for_delivery
+      post payload, headers
+      webhook.track_delivery self
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +57,97 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def render_payload
+      ApplicationController.renderer.new(**renderer_options).render \
+        template: "webhooks/event", formats: :json, assigns: { event: event }, layout: false
+    end
+
+    def renderer_options
+      { script_name: account.slug }.merge(host_options)
+    end
+
+    def host_options
+      if host = default_url_options[:host].presence
+        { http_host: [ host, default_url_options[:port] ].compact.join(":"),
+          https: default_url_options[:protocol].to_s.start_with?("https") }
+      else
+        {}
+      end
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+
+    def headers_for(payload)
+      {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => signature_for(payload)
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, payload
+    end
+
+    def claim_for_delivery
+      self.class.where(id: id, state: "pending").update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
+
+    def post(payload, headers)
+      if ip = SsrfProtection.resolve_public_ip(uri.host)
+        record_response headers, http(ip).request(post_request(payload, headers))
+      else
+        record_error headers, "destination_unreachable"
+      end
+    rescue => error
+      record_error headers, error_reason_for(error)
+    end
+
+    def http(ip)
+      Net::HTTP.new(uri.host, uri.port, nil).tap do |http|
+        http.use_ssl = uri.scheme == "https"
+        http.ipaddr = ip
+        http.open_timeout = TIMEOUT
+        http.read_timeout = TIMEOUT
+        http.write_timeout = TIMEOUT
+      end
+    end
+
+    def post_request(payload, headers)
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def record_response(headers, http_response)
+      update! \
+        state: "completed",
+        request: { headers: headers },
+        response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+    end
+
+    def record_error(headers, reason)
+      update! \
+        state: "errored",
+        request: { headers: headers },
+        response: { error: reason }
+    end
+
+    def error_reason_for(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout, Timeout::Error then "timeout"
+      else "destination_unreachable"
+      end
+    end
 end
