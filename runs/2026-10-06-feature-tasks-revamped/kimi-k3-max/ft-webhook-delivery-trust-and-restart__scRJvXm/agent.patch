+    assert_includes Webhook.subscribed_to("card_published"), webhooks(:active)
+    assert_includes Webhook.subscribed_to("card_assigned"), webhooks(:active)
+    assert_includes Webhook.subscribed_to("card_closed"), webhooks(:active)
+
+    assert_not_includes Webhook.subscribed_to("comment_created"), webhooks(:active)
+    # card_auto_postponed must not match card_postponed or vice versa
+    webhooks(:active).update! subscribed_actions: %w[ card_auto_postponed ]
+    assert_not_includes Webhook.subscribed_to("card_postponed"), webhooks(:active)
+    assert_includes Webhook.subscribed_to("card_auto_postponed"), webhooks(:active)
+  end
+
+  test "deliver_later creates a single delivery for the event and enqueues it" do
+    webhook = webhooks(:active)
+    event = events(:buy_domain_sent_back_to_triage)
+
+    delivery = nil
+    assert_difference "Webhook::Delivery.count", +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        delivery = webhook.deliver_later(event)
+      end
+    end
+
+    assert_equal webhook, delivery.webhook
+    assert_equal event, delivery.event
+    assert_equal webhook.account, delivery.account
+    assert delivery.pending?
+
+    assert_no_difference "Webhook::Delivery.count" do
+      webhook.deliver_later(event)
+    end
+  end
+
+  test "track_delivery records failures and successes on the delinquency tracker" do
+    webhook = webhooks(:active)
+    tracker = webhook_delinquency_trackers(:active)
+
+    webhook.track_delivery Webhook::Delivery.new(webhook: webhook, event: events(:logo_published), state: "completed", response: { code: 500 })
+    assert_equal 1, tracker.reload.consecutive_failures_count
+
+    webhook.track_delivery Webhook::Delivery.new(webhook: webhook, event: events(:logo_published), state: "completed", response: { code: 200 })
+    assert_equal 0, tracker.reload.consecutive_failures_count
+  end
 end
