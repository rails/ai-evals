+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    stub_dns_resolution "93.184.216.34"
+  end
+
+  test "creating an event delivers it to the board webhooks that subscribed to the action" do
+    webhook = webhooks(:active) # subscribed to card_published on the writebook board
+
+    delivery = nil
+    assert_difference "Webhook::Delivery.count", +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        delivery = webhook.deliveries.find_by!(event: create_event)
+      end
+    end
+
+    assert delivery.pending?
+  end
+
+  test "webhooks that are not subscribed to the action get nothing" do
+    webhooks(:active).update! subscribed_actions: %w[ comment_created ]
+
+    assert_no_difference "Webhook::Delivery.count" do
+      create_event
+    end
+  end
+
+  test "inactive webhooks get nothing" do
+    webhooks(:active).deactivate
+
+    assert_no_difference "Webhook::Delivery.count" do
+      create_event
+    end
+  end
+
+  test "webhooks on other boards get nothing" do
+    webhook = Webhook.create! name: "Elsewhere", url: "https://example.com/webhook",
+      board: boards(:private), subscribed_actions: %w[ card_published ]
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      create_event
+    end
+  end
+
+  test "the receiver gets a post about the event and the log shows how it went" do
+    webhook = webhooks(:active)
+    stub_request(:post, webhook.url).to_return status: 200
+
+    delivery = nil
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      delivery = webhook.deliveries.find_by!(event: create_event)
+    end
+
+    assert_requested :post, webhook.url, times: 1
+
+    delivery.reload
+    assert delivery.completed?
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+  end
+
+  private
+    def create_event
+      Event.create! board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published"
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
