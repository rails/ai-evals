+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  test "webhooks get a tracker when they are created" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert tracker = webhook.delinquency_tracker
+    assert_equal webhook.account, tracker.account
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "record_failure counts consecutive failures from the first one" do
+    tracker = webhook_delinquency_trackers(:active)
+
+    tracker.record_failure
+    assert_equal 1, tracker.consecutive_failures_count
+    assert tracker.first_failure_at.present?
+
+    first_failure_at = tracker.first_failure_at
+    tracker.record_failure
+    assert_equal 2, tracker.consecutive_failures_count
+    assert_equal first_failure_at, tracker.first_failure_at
+  end
+
+  test "record_success resets the streak" do
+    tracker = webhook_delinquency_trackers(:active)
+    tracker.update! consecutive_failures_count: 3, first_failure_at: 10.minutes.ago
+
+    tracker.record_success
+
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "switches the webhook off after ten failures in a row over an hour" do
+    webhook = webhooks(:active)
+    tracker = webhook_delinquency_trackers(:active)
+
+    9.times { tracker.record_failure }
+    assert webhook.reload.active?
+
+    travel 30.minutes do
+      tracker.record_failure
+      assert_not webhook.reload.active?
+    end
+  end
+
+  test "keeps the webhook on when the failures spread over more than an hour" do
+    webhook = webhooks(:active)
+    tracker = webhook_delinquency_trackers(:active)
+    tracker.update! consecutive_failures_count: 9, first_failure_at: 1.hour.ago - 1.minute
+
+    tracker.record_failure
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert webhook.reload.active?
+  end
+
+  test "a reset streak starts the count over" do
+    webhook = webhooks(:active)
+    tracker = webhook_delinquency_trackers(:active)
+
+    9.times { tracker.record_failure }
+    tracker.record_success
+    9.times { tracker.record_failure }
+
+    assert webhook.reload.active?
+  end
+end
