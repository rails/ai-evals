diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..973951c
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,30 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A receiver that keeps failing -- this many deliveries in a row over this
+  # window -- gets switched off.
+  FAILURES_LIMIT = 10
+  FAILURES_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      self.consecutive_failures_count += 1
+      self.first_failure_at ||= Time.current
+      save!
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def record_success
+    if consecutive_failures_count > 0
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  private
+    def delinquent?
+      consecutive_failures_count >= FAILURES_LIMIT && first_failure_at.after?(FAILURES_WINDOW.ago)
+    end
+end
