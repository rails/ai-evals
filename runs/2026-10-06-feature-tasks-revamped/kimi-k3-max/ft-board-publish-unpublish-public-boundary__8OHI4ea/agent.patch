+require "test_helper"
+
+class Public::Boards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  test "show a column of a published board without being signed in" do
+    boards(:writebook).publish
+
+    get public_board_column_path(boards(:writebook).publication_key, columns(:writebook_in_progress))
+
+    assert_response :success
+    assert_select "h1", text: /In progress/
+    assert_select ".card__title", text: /#{cards(:text).title}/
+  end
+
+  test "show a column of an unpublished board is not found" do
+    get public_board_column_path("secret-key", columns(:writebook_in_progress))
+
+    assert_response :not_found
+  end
+
+  test "show a column from another board is not found" do
+    boards(:writebook).publish
+    other_column = boards(:private).columns.create!(name: "Secret things")
+
+    get public_board_column_path(boards(:writebook).publication_key, other_column)
+
+    assert_response :not_found
