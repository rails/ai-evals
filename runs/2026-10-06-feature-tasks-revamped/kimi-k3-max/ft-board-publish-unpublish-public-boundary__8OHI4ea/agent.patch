diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..3e70a5d
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,35 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def publish
+    unless published?
+      update! publication_key: self.class.generate_unique_secure_token
+    end
+  end
+
+  def unpublish
+    update! publication_key: nil
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url publication_key, **url_options
+    end
+  end
+
+  private
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      base_options.merge(script_name: account.slug)
+    end
+end
