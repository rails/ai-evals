+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board) }
+      format.json { render "boards/show", status: :created, location: board_path(@board, format: :json) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board) }
+      format.json { render "boards/show" }
+    end
+  end
+end
