@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are not published by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).publication_key
+    assert_nil boards(:writebook).public_url
+  end
+
+  test "publish generates a publication key" do
+    board = boards(:writebook)
+
+    assert_changes -> { board.reload.published? }, from: false, to: true do
+      board.publish
+    end
+
+    assert_not_nil board.publication_key
+  end
+
+  test "publish keeps the same key when already published" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_no_changes -> { board.reload.publication_key } do
+      board.publish
+    end
+  end
+
+  test "unpublish clears the publication key" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_changes -> { board.reload.published? }, from: true, to: false do
+      board.unpublish
+    end
+
+    assert_nil board.publication_key
+    assert_nil board.public_url
+  end
+
+  test "republishing generates a new key" do
+    board = boards(:writebook)
+    board.publish
+    original_key = board.publication_key
+
+    board.unpublish
+    board.publish
+
+    assert_not_equal original_key, board.publication_key
+  end
+
+  test "public_url points to the public board" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_includes board.public_url, "/public/boards/#{board.publication_key}"
+  end
+
+  test "published scope only includes published boards" do
+    assert_not_includes Board.published, boards(:writebook)
+
+    boards(:writebook).publish
+
+    assert_includes Board.published, boards(:writebook)
+  end
+end
