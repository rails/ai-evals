+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= @account.name %></h2>
+    </header>
+
+    <p class="margin-block-half">
+      #<%= @account.external_account_id %> &middot;
+      Plan: <strong><%= @account.plan.name %></strong><%= " (comped)" if @account.comped? %>
+    </p>
+
+    <p class="txt-small margin-block-half">
+      Cards: <strong><%= number_with_delimiter(@account.cards_used) %></strong> of <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %><br>
+      Storage: <strong><%= number_to_human_size(@account.bytes_used) %></strong> of <%= number_to_human_size(@account.storage_limit) %>
+    </p>
+
+    <div class="flex gap-half justify-center">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage override</h2>
+    </header>
+
+    <% if @account.overridden_limit.present? %>
+      <p class="txt-small margin-block-half">
+        Currently overriding
+        card count to <strong><%= @account.overridden_limit.card_count || "not set" %></strong> and
+        bytes used to <strong><%= @account.overridden_limit.bytes_used || "not set" %></strong>.
+      </p>
+    <% end %>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), scope: :overridden_limit, class: "flex flex-column gap-half align-center margin-block-half" do |form| %>
+      <div class="flex align-center gap-half">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, class: "input", min: 0, value: @account.overridden_limit&.card_count %>
+      </div>
+
+      <div class="flex align-center gap-half">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, class: "input", min: 0, value: @account.overridden_limit&.bytes_used %>
+      </div>
+
+      <%= form.submit "Override", class: "btn" %>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn btn--negative" %>
+  </div>
+</section>
