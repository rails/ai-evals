+# Support-set corrections to what an account has used. When the card counter
+# or the storage ledger drifts, support can pin the usage numbers that the
+# limit checks see instead of waiting for a reconcile. Resetting the override
+# returns the account to its computed usage.
+class Account::OverriddenLimit < SaasRecord
+  belongs_to :account
+
+  validates :card_count, numericality: { only_integer: true, greater_than_or_equal_to: 0 }, allow_nil: true
+  validates :bytes_used, numericality: { greater_than_or_equal_to: 0 }, allow_nil: true
+end
