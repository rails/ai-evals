diff --git a/saas/test/controllers/account/settings_test.rb b/saas/test/controllers/account/settings_test.rb
new file mode 100644
index 0000000..a8c4b62
--- /dev/null
+++ b/saas/test/controllers/account/settings_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::SettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade options in settings" do
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "strong", "Free"
+    assert_select "button", /Upgrade/
+  end
+
+  test "paid accounts see their plan and a manage billing button" do
+    sign_in_as :kevin
+    accounts(:"37s").create_subscription!(stripe_customer_id: "cus_123", plan_key: "unlimited", status: "active")
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "strong", "Unlimited"
+    assert_select "button", "Manage billing"
+    assert_select "button", text: /Upgrade/, count: 0
+  end
+
+  test "non-admins do not see the plan in settings" do
+    sign_in_as :david
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "button", text: /Upgrade/, count: 0
+    assert_no_match /This account is on the/, response.body
+  end
+end
