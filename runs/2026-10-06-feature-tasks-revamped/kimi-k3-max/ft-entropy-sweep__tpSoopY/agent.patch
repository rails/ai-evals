@@ -5,6 +5,14 @@ module Board::AutoPostponing
     before_create :set_default_auto_postpone_period
   end
 
+  def auto_postpone_all_due
+    if period = entropy&.auto_postpone_period
+      cards.active.where(last_active_at: ..period.seconds.ago).find_each do |card|
+        card.auto_postpone(user: account.system_user)
+      end
+    end
+  end
+
   private
     def set_default_auto_postpone_period
       self.auto_postpone_period ||= Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days unless attribute_present?(:auto_postpone_period)
diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..4fcd531 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -6,6 +6,22 @@ module Board::Entropic
     has_one :entropy, as: :container, dependent: :destroy
   end
 
+  class_methods do
+    # Groups board ids by their effective auto-postpone period (in seconds): the
+    # board's own entropy period when present, or its account's period otherwise.
+    # Boards with no effective period are left out.
+    def ids_grouped_by_auto_postpone_period
+      board_periods   = Entropy.where(container_type: "Board").pluck(:container_id, :auto_postpone_period).to_h
+      account_periods = Entropy.where(container_type: "Account").pluck(:container_id, :auto_postpone_period).to_h
+
+      pluck(:id, :account_id).each_with_object({}) do |(board_id, account_id), groups|
+        if period = board_periods[board_id] || account_periods[account_id]
+          (groups[period] ||= []) << board_id
+        end
+      end
+    end
+  end
+
   def entropy
     super || account.entropy
   end
