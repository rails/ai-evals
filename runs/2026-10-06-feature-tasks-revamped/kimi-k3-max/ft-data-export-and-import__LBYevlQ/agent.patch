index 0000000..ef2c365
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,28 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  before_action :ensure_admin, only: :create
+
+  rescue_from ActiveSupport::MessageVerifier::InvalidSignature, with: :render_expired_link
+
+  def create
+    Current.account.exports.create! kind: :account, user: Current.user
+
+    redirect_to account_settings_path, notice: "Your export has started. You'll get an email with a download link when it's ready."
+  end
+
+  def show
+    export = Export.find_by_download_token! params[:id]
+
+    if export.file.attached?
+      send_data export.file.download, filename: export.filename, type: "application/zip", disposition: :attachment
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def render_expired_link
+      render plain: "This download link has expired. Please request a new export.", status: :gone
+    end
+end
