+  def data_file_name
+    "#{model_dir}.jsonl"
+  end
+
+  # Export: writes the records as JSON Lines to the zip.
+  def write_to(zip)
+    with_zip(zip) do
+      zip.add_file data_file_name do |sink|
+        each_record do |record|
+          sink.write JSON.generate(export_attributes(record)) + "\n"
+        end
+      end
+    end
+  end
+
+  # Import: yields each row from the zip, streaming.
+  def each_row(zip)
+    return enum_for(:each_row, zip) unless block_given?
+
+    zip.each_line(data_file_name) do |line|
+      yield JSON.parse(line) if line.strip.present?
+    end
+  end
+
+  # Import: reads the raw rows from the zip.
+  def read_from(zip)
+    each_row(zip).to_a
+  end
+
+  # Import: inserts rows from the zip into the database, remapping ids
+  # through the importer.
+  def import_from(zip, importer)
+    each_row(zip).each_slice(IMPORT_BATCH_SIZE) do |rows|
+      prepared_rows = rows.map { |row| prepare_import_row(row, importer) }.compact
+      model.insert_all(prepared_rows) if prepared_rows.any?
+    end
+  end
+
   private
