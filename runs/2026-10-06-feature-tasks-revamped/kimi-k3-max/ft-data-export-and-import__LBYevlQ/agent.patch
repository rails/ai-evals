diff --git a/test/integration/export_import_test.rb b/test/integration/export_import_test.rb
new file mode 100644
index 0000000..e223844
--- /dev/null
+++ b/test/integration/export_import_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class ExportImportTest < ActionDispatch::IntegrationTest
+  test "an admin exports the whole account and someone imports it back" do
+    # The admin asks for an export from the account settings
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    post account_exports_path
+    assert_redirected_to account_settings_path
+
+    # When it's ready, an email with the download link arrives
+    export = Export.order(:created_at).last
+
+    perform_enqueued_jobs only: ExportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    email = ActionMailer::Base.deliveries.find { |mail| mail.to == [ identities(:kevin).email_address ] && mail.subject.to_s.include?("export") }
+    assert email.present?, "expected an email with the download link"
+    download_path = email.body.encoded[%r{https?://[^/]+(/[^\s"']+/account/exports/[^\s"']+)}, 1]
+    assert download_path.present?, "expected the email to contain a download link"
+
+    # The link works without signing in
+    reset!
+    get download_path
+    assert_response :ok
+    assert_equal "application/zip", response.media_type
+
+    zip = Tempfile.new([ "export", ".zip" ])
+    zip.binmode
+    zip.write response.body
+    zip.rewind
+
+    # Someone signed in brings the account file back in
+    sign_in_as :jz
+    clear_enqueued_jobs
+
+    untenanted do
+      get new_account_import_path
+    end
+    assert_response :ok
+
+    assert_difference -> { Account.count }, 1 do
+      untenanted do
+        post account_imports_path, params: { file: fixture_file_upload(zip.path, "application/zip") }
+      end
+    end
+
+    perform_enqueued_jobs only: ImportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    imported = Account.order(:created_at).last
+    assert_equal "37signals", imported.name
+    assert_equal accounts("37s").boards.count, imported.boards.count
+    assert_equal accounts("37s").cards.count, imported.cards.count
+    assert_equal accounts("37s").users.count, imported.users.count
+
+    # And an email arrives saying it's done
+    done_email = ActionMailer::Base.deliveries.find { |mail| mail.subject == "Your Fizzy account import is ready" }
+    assert done_email.present?
+  end
+
+  test "an import that cannot be completed leaves nothing behind and emails why" do
+    sign_in_as :jz
+    clear_enqueued_jobs
+
+    untenanted do
+      post account_imports_path, params: { file: fixture_file_upload("avatar.png", "application/zip") }
+    end
+
+    account_count = Account.count
+
+    perform_enqueued_jobs only: ImportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    assert_equal account_count - 1, Account.count
+
+    email = ActionMailer::Base.deliveries.find { |mail| mail.subject == "Your Fizzy account import failed" }
+    assert email.present?, "expected a failure email"
+    assert_match "not a valid Fizzy account export", email.body.encoded
+  end
+
+  test "anyone exports the cards they can see from their profile page" do
+    sign_in_as :david
+    clear_enqueued_jobs
+
+    post user_export_path(users(:david))
+    assert_redirected_to user_path(users(:david))
+
+    perform_enqueued_jobs only: ExportJob
+    perform_enqueued_jobs only: ActionMailer::MailDeliveryJob
+
+    email = ActionMailer::Base.deliveries.find { |mail| mail.to == [ identities(:david).email_address ] && mail.subject.to_s.include?("cards") }
+    assert email.present?, "expected an email with the download link"
+    download_path = email.body.encoded[%r{https?://[^/]+(/[^\s"']+/account/exports/[^\s"']+)}, 1]
+
+    reset!
+    get download_path
+    assert_response :ok
+
+    reader = ZipFile::Reader.new(StringIO.new(response.body))
+    cards = JSON.parse(reader.read("cards.json"))
+    assert cards.any?
+
+    titles = cards.map { |card| card["title"] }
+    assert_includes titles, "The logo isn't big enough"
+  end
+end
