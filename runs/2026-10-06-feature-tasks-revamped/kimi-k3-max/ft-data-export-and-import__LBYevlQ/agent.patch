+
+    get account_export_path(id: export.download_token)
+
+    assert_response :ok
+    assert_equal "zip contents", response.body
+    assert_equal "application/zip", response.media_type
+    assert_match(/attachment/, response.headers["Content-Disposition"])
+  end
+
+  test "show works without being signed in" do
