@@ -0,0 +1,64 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  test "created exports are pending and enqueue processing" do
+    clear_enqueued_jobs
+
+    export = nil
+    assert_enqueued_jobs 1, only: ExportJob do
+      export = Current.account.exports.create! kind: :account, user: users(:kevin)
+    end
+
+    assert export.status_pending?
+  end
+
+  test "account export process attaches a zip and emails the download link" do
+    export = Current.account.exports.create! kind: :account, user: users(:kevin)
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      export.process
+    end
+
+    assert export.status_completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert export.filename.end_with?(".zip")
+    assert_includes export.filename, "37signals"
+  end
+
+  test "cards export process attaches a zip of the cards the user can see" do
+    export = Current.account.exports.create! kind: :cards, user: users(:kevin)
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      export.process
+    end
+
+    assert export.status_completed?
+    assert export.file.attached?
+
+    reader = ZipFile::Reader.new(StringIO.new(export.file.download))
+    assert reader.exists?("cards.json")
+    cards = JSON.parse(reader.read("cards.json"))
+    assert_equal users(:kevin).accessible_cards.published.count, cards.size
+  end
+
+  test "process marks the export as failed when something goes wrong" do
+    export = Current.account.exports.create! kind: :account, user: users(:kevin)
+
+    Account::DataTransfer::Exporter.any_instance.stubs(:write_to).raises(RuntimeError, "boom")
+
+    assert_raises(RuntimeError) { export.process }
+    assert export.status_failed?
+  end
+
+  test "download token expires after a day" do
+    export = Current.account.exports.create! kind: :account, user: users(:kevin)
+
+    token = export.download_token
+    assert_equal export, Export.find_by_download_token(token)
+
+    travel 1.day + 1.minute do
+      assert_nil Export.find_by_download_token(token)
+    end
+  end
+end
