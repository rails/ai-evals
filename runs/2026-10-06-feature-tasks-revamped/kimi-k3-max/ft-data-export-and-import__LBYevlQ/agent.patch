+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:jason)
+  end
+
+  test "start! creates a new account with a pending import" do
+    file = uploaded_zip
+
+    import = nil
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_jobs 1, only: ImportJob do
+        import = Import.start!(identity: @identity, file: file)
+      end
+    end
+
+    assert import.status_pending?
+    assert import.file.attached?
+    assert import.account.present?
+    assert import.account.system_user.present?
+  end
+
+  test "process brings back the account and emails the importer" do
+    import = Import.start! identity: @identity, file: account_export_upload
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      import.process
+    end
+
+    assert import.status_completed?
+
+    account = import.account.reload
+    assert_equal accounts("37s").name, account.name
+    assert_equal accounts("37s").boards.count, account.boards.count
+  end
+
+  test "process with a bogus file emails the failure and leaves nothing behind" do
+    import = Import.start! identity: @identity, file: uploaded_zip("garbage")
+    account = import.account
+
+    assert_enqueued_jobs 1, only: ActionMailer::MailDeliveryJob do
+      import.process
+    end
+
+    assert import.status_failed?
+    assert_not Account.exists?(account.id)
+    assert_not Import.exists?(import.id)
+  end
+
+  test "process with a zip that is not an account export fails and cleans up" do
+    import = Import.start! identity: @identity, file: uploaded_zip
+    account = import.account
+
+    import.process
+
+    assert import.status_failed?
+    assert_not Account.exists?(account.id)
+  end
+
+  private
+    def account_export_upload
+      account = accounts("37s")
+      export = account.exports.create! kind: :account, user: users(:kevin)
+      export.process
+
+      { io: StringIO.new(export.file.download), filename: "export.zip", content_type: "application/zip" }
+    end
+
+    def uploaded_zip(content = nil)
+      if content
+        { io: StringIO.new(content), filename: "import.zip", content_type: "application/zip" }
+      else
+        tempfile = Tempfile.new([ "empty", ".zip" ])
+        tempfile.binmode
+        writer = ZipFile::Writer.new(tempfile)
+        writer.add_file("hello.txt", "hi")
+        writer.close
+        tempfile.rewind
+
+        { io: tempfile, filename: "import.zip", content_type: "application/zip" }
+      end
+    end
+end
