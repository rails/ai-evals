index 0000000..aec00c9
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "create as admin" do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+
+    assert_difference -> { Export.where(kind: "account").count }, 1 do
+      assert_enqueued_jobs 1, only: ExportJob do
+        post account_exports_path
+      end
+    end
+
+    export = Export.order(:created_at).last
+    assert_equal accounts("37s"), export.account
+    assert_equal users(:kevin), export.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "create as owner" do
+    sign_in_as :jason
+
+    assert_difference -> { Export.count }, 1 do
+      post account_exports_path
+    end
+  end
+
+  test "create as member is forbidden" do
+    sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
