@@ -0,0 +1,21 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  layout "public"
+
+  def new
+    @import = Import.new
+  end
+
+  def create
+    if params[:file].present?
+      Import.start! identity: Current.identity, file: params[:file]
+
+      redirect_to session_menu_path(script_name: nil), notice: "Your import has started. You'll get an email when it's done."
+    else
+      @import = Import.new
+      flash.now[:alert] = "Please choose an account export file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
