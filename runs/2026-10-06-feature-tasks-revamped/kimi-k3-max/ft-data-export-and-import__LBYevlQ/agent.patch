diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..9ada4b3
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,58 @@
+class Export < ApplicationRecord
+  DOWNLOAD_LINK_EXPIRATION = 24.hours
+
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), scopes: false, prefix: true
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending, scopes: false, prefix: true
+
+  after_create_commit :process_later
+
+  class << self
+    def find_by_download_token(token)
+      find_signed token, purpose: :download
+    end
+
+    def find_by_download_token!(token)
+      find_signed! token, purpose: :download
+    end
+  end
+
+  def process
+    status_processing!
+
+    ZipFile.create_for file, filename: filename do |zip|
+      if kind_account?
+        Account::DataTransfer::Exporter.new(account).write_to(zip)
+      else
+        User::CardsExport.new(user).write_to(zip)
+      end
+    end
+
+    status_completed!
+    ExportMailer.ready(self).deliver_later
+  rescue
+    status_failed!
+    raise
+  end
+
+  def process_later
+    ExportJob.perform_later(self)
+  end
+
+  def download_token
+    signed_id purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRATION
+  end
+
+  def filename
+    date = Date.current.to_fs(:db)
+
+    if kind_account?
+      "fizzy-account-export-#{account.name.parameterize}-#{date}.zip"
+    else
+      "fizzy-cards-export-#{user.name.parameterize}-#{date}.zip"
+    end
+  end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..e3ae9d3
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,47 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending, scopes: false, prefix: true
+
+  after_create_commit :process_later
+
+  class << self
+    def start!(identity:, file:)
+      account = Account.create!(name: "Imported account")
+      account.users.create!(role: :system, name: "System")
+
+      Current.with_account(account) do
+        account.create_import!(identity: identity, file: file)
+      end
+    end
+  end
+
+  def process
+    status_processing!
+
+    file.blob.open do |tempfile|
+      tempfile.binmode
+      Account::DataTransfer::Importer.new(tempfile, account: account, identity: identity).import
+    end
+
+    status_completed!
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    status_failed!
+    Rails.error.report(error, context: { import_id: id })
+
+    # The new account is about to be destroyed, so the email must not be
+    # delivered in its tenant context.
+    Current.without_account do
+      ImportMailer.failed(identity, error.message).deliver_later
+    end
+
+    account.destroy!
+  end
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+end
diff --git a/app/models/user/cards_export.rb b/app/models/user/cards_export.rb
new file mode 100644
index 0000000..9ca8cc6
--- /dev/null
+++ b/app/models/user/cards_export.rb
@@ -0,0 +1,98 @@
+# Exports the cards a user can see as JSON — with their comments — along with
+# every picture and file attached to them.
+#
+# The zip contains a single cards.json document and a files/ directory with
+# the attachments referenced from it.
+class User::CardsExport
+  FILES_DIR = "files"
+
+  def initialize(user)
+    @user = user
+  end
+
+  def write_to(zip)
+    @zip = zip
+    @files = {}
+
+    add_cards
+    add_files
+  end
+
+  private
+    attr_reader :zip
+
+    def add_cards
+      zip.add_file "cards.json" do |sink|
+        sink.write JSON.pretty_generate(cards.map { |card| card_json(card) })
+      end
+    end
+
+    def add_files
+      @files.each do |path, blob|
+        zip.add_file path, compress: false do |sink|
+          blob.download { |chunk| sink.write chunk }
+        end
+      end
+    end
+
+    def cards
+      @cards ||= @user.accessible_cards
+        .where(status: :published).or(@user.accessible_cards.where(creator: @user))
+        .chronologically
+        .includes(:board, :column, :creator, :tags, :assignees, :image_attachment, comments: :creator)
+        .with_rich_text_description_and_embeds
+    end
+
+    def card_json(card)
+      {
+        "number" => card.number,
+        "title" => card.title,
+        "description" => card.description.to_s,
+        "status" => card.status,
+        "board" => card.board.name,
+        "column" => card.column&.name,
+        "tags" => card.tags.map(&:title),
+        "assignees" => card.assignees.map(&:name),
+        "creator" => card.creator.name,
+        "due_on" => card.due_on,
+        "created_at" => card.created_at,
+        "updated_at" => card.updated_at,
+        "last_active_at" => card.last_active_at,
+        "closed" => card.closed?,
+        "comments" => card.comments.chronologically.map { |comment| comment_json(comment) },
+        "attachments" => card_attachments(card).map { |attachment| attachment_json(attachment) }
+      }
+    end
+
+    def comment_json(comment)
+      {
+        "creator" => comment.creator.name,
+        "body" => comment.body.to_s,
+        "created_at" => comment.created_at,
+        "attachments" => comment.attachments.map { |attachment| attachment_json(attachment) }
+      }
+    end
+
+    def card_attachments(card)
+      [ card.image_attachment, *card.attachments ].compact
+    end
+
+    def attachment_json(attachment)
+      {
+        "filename" => attachment.filename.to_s,
+        "content_type" => attachment.content_type,
+        "byte_size" => attachment.byte_size,
+        "path" => file_path_for(attachment)
+      }
+    end
+
+    def file_path_for(attachment)
+      "#{FILES_DIR}/#{attachment.blob.key}/#{sanitize_filename(attachment.filename)}".tap do |path|
+        @files[path] = attachment.blob
+      end
+    end
+
+    def sanitize_filename(filename)
+      filename.to_s.gsub("/", "_").gsub("\\", "_")
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..9bfc0f2
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,48 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def entries
+    @entries.keys
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def glob(pattern)
+    entries.select { |entry| File.fnmatch(pattern, entry) }.sort
+  end
+
+  def read(path)
+    chunks = []
+    extract(path) { |chunk| chunks << chunk }
+    chunks.join.presence
+  end
+
+  def extract(path)
+    return unless block_given?
+
+    if entry = @entries[path]
+      extractor = entry.extractor_from(@io)
+      yield extractor.extract(CHUNK_SIZE) until extractor.eof?
+    end
+  end
+
+  def each_line(path)
+    buffer = +""
+
+    extract(path) do |chunk|
+      buffer << chunk
+      while line = buffer.slice!(/\A[^\n]*\n/)
+        yield line
+      end
+    end
+
+    yield buffer if buffer.present?
+  end
+end
