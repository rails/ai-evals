diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..dd9647e
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,229 @@
+# Brings an account export back in as a brand-new account.
+#
+# Every record gets a fresh id, and every reference between records — foreign
+# keys, polymorphic references, ids nested inside JSON particulars, even the
+# global ids embedded in rich text — is remapped to the new ids. Blob keys,
+# which are unique across the whole installation, are regenerated too.
+#
+# Rows stream through the zip in two passes — one to map every exported id to
+# a new one, one to insert — so even very large exports never have to be held
+# in memory. The import itself is all or nothing: everything happens inside a
+# single transaction, and any files already uploaded to the storage service
+# are deleted again if the import can't be completed.
+class Account::DataTransfer::Importer
+  class InvalidExportError < StandardError; end
+
+  # Account ids (and every other uuid in the app) are 25-character base36
+  # strings, e.g. "03ax95qbd6mdo0egzk1xsie2y".
+  ID_PATTERN = /\b[0-9a-z]{25}\b/
+
+  attr_reader :account, :identity
+
+  def initialize(io, account:, identity:)
+    @zip = open_zip(io)
+    @account = account
+    @identity = identity
+    @id_map = {}
+    @blob_keys = {}
+    @blob_checksums = {}
+    @uploaded_blob_keys = []
+    @user_rows = []
+  end
+
+  def import
+    assign_new_ids
+
+    ApplicationRecord.transaction do
+      import_account
+      import_users
+      import_record_sets
+      upload_files
+      grant_access_to_identity
+      reindex_search_records
+    end
+
+    account
+  rescue
+    delete_uploaded_files
+    raise
+  end
+
+  # Rewrites every exported id appearing anywhere in the row — including ids
+  # nested inside serialized JSON or global id strings — to its new id.
+  def substitute_ids(row)
+    json = JSON.generate(row)
+    JSON.parse json.gsub(ID_PATTERN) { |id| @id_map.fetch(id, id) }
+  end
+
+  def remap_blob_key(old_key, checksum: nil)
+    @blob_keys[old_key] ||= generate_blob_key.tap do |new_key|
+      @blob_checksums[new_key] = checksum
+    end
+  end
+
+  # Rich text bodies travel with plain (unsigned) global ids in their
+  # attachment nodes. Re-sign them against the freshly imported records so the
+  # bodies render again.
+  def sign_attachable_global_ids(html)
+    return html unless html.to_s.include?("action-text-attachment")
+
+    fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+    fragment.css("action-text-attachment[sgid]").each do |node|
+      next unless node["sgid"].start_with?("gid://")
+
+      if attachable = locate_global_id(node["sgid"])
+        node["sgid"] = attachable.attachable_sgid
+      end
+    end
+    fragment.to_html
+  end
+
+  private
+    def open_zip(io)
+      io.is_a?(ZipFile::Reader) ? io : ZipFile::Reader.new(io)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature
+      raise InvalidExportError, "This file is not a valid Fizzy account export"
+    end
+
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new(account)
+    end
+
+    def assign_new_ids
+      each_row do |record_set, row|
+        @id_map[row["id"]] ||= generate_uuid if row["id"].present?
+
+        case record_set
+        when Account::DataTransfer::AccountRecordSet
+          @account_row = row
+        when Account::DataTransfer::UserRecordSet
+          @user_rows << row
+        end
+      end
+
+      if @account_row.nil?
+        raise InvalidExportError, "This file does not look like a Fizzy account export"
+      end
+    end
+
+    def each_row
+      manifest.each_record_set do |record_set|
+        record_set.each_row(@zip) do |row|
+          yield record_set, row
+        end
+      end
+    end
+
+    def import_account
+      @id_map[@account_row["id"]] = account.id
+      account.update! name: @account_row["name"].presence || account.name, cards_count: @account_row["cards_count"].to_i
+    end
+
+    def import_users
+      @user_rows.each do |row|
+        if row["role"] == "system"
+          @id_map[row["id"]] = system_user.id
+        else
+          import_user row
+        end
+      end
+    end
+
+    def import_user(row)
+      identity = find_or_create_identity(row["identity_email_address"])
+
+      if identity && existing_user = account.users.find_by(identity: identity)
+        @id_map[row["id"]] = existing_user.id
+      else
+        prepared_row = substitute_ids(row).slice(*User.column_names)
+        prepared_row["identity_id"] = identity&.id
+        User.insert_all([ prepared_row ])
+      end
+    end
+
+    def find_or_create_identity(email_address)
+      Identity.find_or_create_by!(email_address: email_address) if email_address.present?
+    end
+
+    def import_record_sets
+      account.entropies.delete_all # Replace the entropy record the account was created with.
+
+      manifest.each_record_set do |record_set|
+        next if import_special_case?(record_set)
+
+        record_set.import_from(@zip, self)
+      end
+    end
+
+    def import_special_case?(record_set)
+      record_set.is_a?(Account::DataTransfer::AccountRecordSet) ||
+        record_set.is_a?(Account::DataTransfer::UserRecordSet) ||
+        record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+    end
+
+    def upload_files
+      files_dir = Account::DataTransfer::ActiveStorage::FileRecordSet::FILES_DIR
+
+      @zip.glob("#{files_dir}/*").each do |path|
+        old_key = File.basename(path)
+        new_key = @blob_keys[old_key] or next
+
+        upload_file path, to: new_key, checksum: @blob_checksums[new_key]
+      end
+    end
+
+    def upload_file(path, to:, checksum: nil)
+      Tempfile.create("fizzy-import") do |tempfile|
+        tempfile.binmode
+        @zip.extract(path) { |chunk| tempfile.write chunk }
+        tempfile.rewind
+        ActiveStorage::Blob.service.upload(to, tempfile, checksum: checksum)
+      end
+
+      @uploaded_blob_keys << to
+    end
+
+    def delete_uploaded_files
+      @uploaded_blob_keys.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue
+        nil
+      end
+    end
+
+    def grant_access_to_identity
+      return if identity.nil?
+      return if account.users.exists?(identity: identity)
+
+      account.users.create! identity: identity, name: identity.email_address, role: :owner, verified_at: Time.current
+    end
+
+    def reindex_search_records
+      account.cards.published.find_each { |card| safely_reindex(card) }
+      Comment.where(account: account).joins(:card).merge(Card.published).find_each { |comment| safely_reindex(comment) }
+    end
+
+    def safely_reindex(record)
+      record.reindex
+    rescue => error
+      Rails.error.report(error, context: { record: record })
+    end
+
+    def system_user
+      @system_user ||= account.users.find_by!(role: :system)
+    end
+
+    def locate_global_id(gid)
+      GlobalID::Locator.locate(gid)
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def generate_uuid
+      ActiveRecord::Type::Uuid.generate
+    end
+
+    def generate_blob_key
+      SecureRandom.base36(28)
+    end
+end
