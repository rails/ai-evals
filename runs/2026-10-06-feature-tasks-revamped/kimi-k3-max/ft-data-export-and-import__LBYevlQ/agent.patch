+  end
+
+  private
+    def create_completed_export
+      Export.create!(account: Current.account, user: users(:kevin), kind: :account, status: :completed).tap do |export|
+        export.file.attach io: StringIO.new("zip contents"), filename: "export.zip", content_type: "application/zip"
