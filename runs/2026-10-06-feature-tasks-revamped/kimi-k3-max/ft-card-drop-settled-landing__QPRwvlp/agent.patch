diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..c798c88
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,222 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "cards are draggable on the board" do
+    visit_board
+
+    assert_selector "##{dom_id(cards(:buy_domain), :article)}[draggable=true]"
+  end
+
+  test "drag a card into a column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    drag_card card, to: column
+
+    # The board is already the way it was left, without waiting on the save
+    assert_card_in_column card, column
+    assert_eventually { card.reload.column == column }
+  end
+
+  test "a dropped card lands on top of the column, after any golden cards" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_triage) # holds logo (golden) and layout already
+
+    visit_board
+    drag_card card, to: column
+
+    assert_equal [ dom_id(cards(:logo), :article), dom_id(card, :article) ], all_card_ids_in(column).first(2)
+    assert_eventually { card.reload.column == column }
+  end
+
+  test "a dropped golden card lands on top of the other golden cards" do
+    card = cards(:logo) # golden, in the Triage column
+
+    visit_board
+    drag_card card, to: "maybe"
+
+    assert_equal dom_id(card, :article), all_card_ids_in("maybe").first
+    assert_eventually { card.reload.awaiting_triage? }
+  end
+
+  test "drag a card to Done closes it" do
+    card = cards(:buy_domain)
+
+    visit_board
+    drag_card card, to: "closed-cards"
+
+    assert_card_in_column card, "closed-cards"
+    assert_eventually { card.reload.closed? }
+  end
+
+  test "drag a card to Not Now postpones it" do
+    card = cards(:buy_domain)
+
+    visit_board
+    drag_card card, to: "not-now"
+
+    assert_card_in_column card, "not-now"
+    assert_eventually { card.reload.postponed? }
+  end
+
+  test "drag a card back to Maybe? sends it back to triage" do
+    card = cards(:logo)
+
+    visit_board
+    drag_card card, to: "maybe"
+
+    assert_card_in_column card, "maybe"
+    assert_eventually { card.reload.awaiting_triage? }
+  end
+
+  test "drag a closed card into a column reopens it" do
+    card = cards(:shipping) # closed, in the Done column
+    column = columns(:writebook_review)
+
+    visit_board
+    drag_card card, to: column
+
+    assert_card_in_column card, column
+    assert_eventually { card.reload.column == column && card.open? }
+  end
+
+  test "drag a closed card to Not Now reopens and postpones it" do
+    card = cards(:shipping)
+
+    visit_board
+    drag_card card, to: "not-now"
+
+    assert_card_in_column card, "not-now"
+    assert_eventually { card.reload.postponed? && card.open? }
+  end
+
+  test "dragging within the same column keeps the card where it is" do
+    card = cards(:text)
+    column = card.column
+
+    visit_board
+    drag_card card, to: column
+
+    assert_card_in_column card, column
+    assert_no_changes -> { card.reload.last_active_at } do
+      sleep 0.5 # give any rogue save a chance to land
+    end
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    start_dragging_card card, over: column
+
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+
+    end_dragging_card card
+
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_card_in_column card, "maybe"
+  end
+
+  test "a failed save puts the card back where it was" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    page.execute_script(%{window.Turbo = { fetch: () => Promise.resolve(new Response(null, { status: 500 })) }})
+
+    drag_card card, to: column
+
+    assert_card_in_column card, "maybe"
+    assert_no_changes -> { card.reload.column } do
+      sleep 0.5
+    end
+  end
+
+  test "cards stay draggable after a broadcast refresh" do
+    card = cards(:buy_domain)
+
+    visit_board
+    wait_for_cable_subscriptions
+    Current.user = users(:david)
+    card.update!(title: "Renamed elsewhere")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "##{dom_id(card, :article)}", text: "Renamed elsewhere", wait: 5
+    assert_selector "##{dom_id(card, :article)}[draggable=true]"
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def visit_board
+      visit board_url(@board)
+      assert_selector "#maybe .card[draggable=true]"
+    end
+
+    def drag_card(card, to:)
+      start_dragging_card card, over: to
+      dispatch_drag_event "drop", container_element(to)
+      end_dragging_card card
+    end
+
+    def start_dragging_card(card, over:)
+      dispatch_drag_event "dragstart", card_element(card)
+      dispatch_drag_event "dragover", container_element(over)
+    end
+
+    def end_dragging_card(card)
+      dispatch_drag_event "dragend", card_element(card)
+    end
+
+    def card_element(card)
+      find("##{dom_id(card, :article)}", visible: :all)
+    end
+
+    def container_element(container)
+      find("##{container_id(container)}", visible: :all)
+    end
+
+    def container_id(container)
+      container.is_a?(Column) ? dom_id(container) : container.to_s
+    end
+
+    def dispatch_drag_event(type, element)
+      page.execute_script(<<~JS, type, element)
+        const [ type, element ] = arguments
+        const event = new DragEvent(type, { bubbles: true, cancelable: true })
+        Object.defineProperty(event, "dataTransfer", { value: window.__dragDataTransfer ||= new DataTransfer() })
+        element.dispatchEvent(event)
+        if (type === "dragend") { window.__dragDataTransfer = null }
+      JS
+    end
+
+    def all_card_ids_in(container)
+      container_element(container).all(".cards__list .card", visible: :all).map { |element| element[:id] }
+    end
+
+    def assert_card_in_column(card, container)
+      within(container_element(container)) do
+        assert_selector "##{dom_id(card, :article)}", visible: :all
+      end
+    end
+
+    def assert_eventually(&block)
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until block.call
+      end
+    end
+end
