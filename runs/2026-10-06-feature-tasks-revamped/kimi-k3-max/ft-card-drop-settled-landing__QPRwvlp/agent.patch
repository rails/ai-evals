diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..abf1d8f
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,189 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Drag cards around the board to change their column or status. Moves are
+// optimistic: when the card is let go, the board is already the way it was
+// left, and the save happens in the background. Columns keep their own order,
+// so a dropped card goes where the server will place it too: on top of the
+// column, right after any golden cards.
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+
+  // Dragging cards requires a mouse
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  itemTargetConnected(item) {
+    this.#prepareForDragging(item)
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  // Page morphs sync attributes with the server-rendered markup, which strips
+  // the draggable attributes: put them back
+  refreshDraggables() {
+    this.itemTargets.forEach(item => this.#prepareForDragging(item))
+  }
+
+  dragStart({ target, dataTransfer }) {
+    const item = target.closest(this.#itemSelector)
+
+    if (item) {
+      this.draggedItem = item
+      dataTransfer.effectAllowed = "move"
+      dataTransfer.setData("text/plain", item.id)
+
+      // Dim the card once the browser has captured the drag image
+      requestAnimationFrame(() => item.classList.add(this.draggedItemClass))
+    }
+  }
+
+  dragOver(event) {
+    if (this.draggedItem) {
+      const container = this.#droppableContainerFor(event.target)
+
+      event.preventDefault() // Allow the drop
+      event.dataTransfer.dropEffect = container ? "move" : "none"
+      this.#highlightContainer(container)
+    }
+  }
+
+  drop(event) {
+    if (this.draggedItem) {
+      event.preventDefault()
+
+      const container = this.#droppableContainerFor(event.target)
+      const item = this.draggedItem
+
+      if (container) {
+        this.#resetDrag()
+        this.#move(item, container)
+      }
+    }
+  }
+
+  dragEnd() {
+    this.#resetDrag()
+  }
+
+  // Private
+
+  #prepareForDragging(item) {
+    item.draggable = true
+
+    // Make the card the only drag source; nested links and images are draggable by default
+    item.querySelectorAll("a, img").forEach(element => { element.draggable = false })
+  }
+
+  get #itemSelector() {
+    return `[data-${this.identifier}-target~="item"]`
+  }
+
+  get #containerSelector() {
+    return `[data-${this.identifier}-target~="container"]`
+  }
+
+  // Dragging moves a card between places, never within one: the column the
+  // card already belongs to is not a place it can move to
+  #droppableContainerFor(target) {
+    const container = target.closest(this.#containerSelector)
+
+    if (container && container.querySelector(".cards__list") && container !== this.draggedItem.closest(this.#containerSelector) && this.#saveUrlFor(container, this.draggedItem)) {
+      return container
+    }
+  }
+
+  #highlightContainer(container) {
+    this.containerTargets.forEach(element => {
+      element.classList.toggle(this.hoverContainerClass, element === container)
+    })
+  }
+
+  #resetDrag() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.draggedItemClass)
+      this.draggedItem = null
+    }
+    this.#highlightContainer(null)
+  }
+
+  // Move first, save in the background: when you let go, the board is already
+  // the way you left it. If the save fails, put the card back where it was.
+  async #move(item, container) {
+    const list = container.querySelector(".cards__list")
+    const previousParent = item.parentNode
+    const previousSibling = item.nextSibling
+
+    this.#insertOnTop(item, list)
+
+    try {
+      const response = await this.#save(item, container)
+      if (!response.ok) this.#restore(item, previousParent, previousSibling)
+    } catch (error) {
+      this.#restore(item, previousParent, previousSibling)
+    }
+  }
+
+  #insertOnTop(item, list) {
+    const nextCard = this.#cardAfterInsertPoint(item, list)
+
+    if (nextCard) {
+      nextCard.parentNode.insertBefore(item, nextCard)
+    } else {
+      list.appendChild(item)
+    }
+  }
+
+  // Columns keep golden cards first, then order by most recent activity
+  #cardAfterInsertPoint(item, list) {
+    const cards = Array.from(list.querySelectorAll(".card")).filter(card => card !== item)
+
+    if (item.classList.contains("golden-effect")) {
+      return cards[0]
+    } else {
+      return cards.find(card => !card.classList.contains("golden-effect"))
+    }
+  }
+
+  #restore(item, parent, sibling) {
+    if (parent?.isConnected) {
+      if (sibling && sibling.parentNode === parent) {
+        parent.insertBefore(item, sibling)
+      } else {
+        parent.appendChild(item)
+      }
+    }
+  }
+
+  #save(item, container) {
+    const url = this.#saveUrlFor(container, item)
+    const options = { responseKind: "json" }
+
+    switch (container.dataset.dragAndDropKind) {
+      case "column":
+        return post(url, { ...options, query: { column_id: container.dataset.dragAndDropColumnId } })
+      case "maybe":
+        return destroy(url, options)
+      default:
+        return post(url, options)
+    }
+  }
+
+  #saveUrlFor(container, item) {
+    switch (container.dataset.dragAndDropKind) {
+      case "column":
+      case "maybe":
+        return item.dataset.cardTriageUrl
+      case "not-now":
+        return item.dataset.cardNotNowUrl
+      case "closed":
+        return item.dataset.cardClosureUrl
+    }
+  }
+}
