@@ -0,0 +1,24 @@
+class Cards::DropsController < ApplicationController
+  include CardScoped
+
+  def create
+    case params[:drop_target]
+    when "maybe"
+      @card.send_back_to_triage unless @card.awaiting_triage?
+    when "not_now"
+      @card.postpone unless @card.postponed?
+    when "closed"
+      @card.close unless @card.closed?
+    else
+      triage_into_column
+    end
+
+    head :no_content
+  end
+
+  private
+    def triage_into_column
+      column = @card.board.columns.find(params[:drop_target])
+      @card.triage_into(column) unless @card.triaged? && @card.column == column
+    end
+end
