@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Cards::DropsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "drop into a column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: card.column, to: column do
+      post card_drop_path(card), params: { drop_target: column.id }, as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "drop into the same column is a no-op" do
+    card = cards(:logo)
+
+    assert_no_difference -> { Event.count } do
+      post card_drop_path(card), params: { drop_target: card.column_id }, as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "drop into a column from another board is not found" do
+    card = cards(:logo)
+    other_board_column = boards(:writebook).account.boards.create!(name: "Other board", creator: users(:kevin)).columns.create!(name: "Elsewhere")
+
+    post card_drop_path(card), params: { drop_target: other_board_column.id }, as: :json
+
+    assert_response :not_found
+    assert_not_equal other_board_column, card.reload.column
+  end
+
+  test "drop into maybe sends the card back to triage" do
+    card = cards(:logo)
+
+    post card_drop_path(card), params: { drop_target: "maybe" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.awaiting_triage?
+  end
+
+  test "drop into maybe is a no-op for cards awaiting triage" do
+    card = cards(:buy_domain)
+
+    assert card.awaiting_triage?
+
+    assert_no_difference -> { Event.count } do
+      post card_drop_path(card), params: { drop_target: "maybe" }, as: :json
+      assert_response :no_content
+    end
+  end
+
+  test "drop into not now postpones the card" do
+    card = cards(:logo)
+
+    post card_drop_path(card), params: { drop_target: "not_now" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.postponed?
+  end
+
+  test "drop into done closes the card" do
+    card = cards(:logo)
+
+    post card_drop_path(card), params: { drop_target: "closed" }, as: :json
+
+    assert_response :no_content
+    assert card.reload.closed?
+  end
+
+test "drop into not now is a no-op for postponed cards" do
+  card = cards(:logo)
+  card.postpone(user: users(:kevin))
+
+  assert_no_difference -> { Event.count } do
+    post card_drop_path(card), params: { drop_target: "not_now" }, as: :json
+    assert_response :no_content
+  end
+end
+
+test "drop into done is a no-op for closed cards" do
+  card = cards(:shipping)
+
+  assert card.closed?
+
+  assert_no_difference -> { Event.count } do
+    post card_drop_path(card), params: { drop_target: "closed" }, as: :json
+    assert_response :no_content
+  end
+end
+
+  test "drop a closed card into a column reopens it there" do
+    card = cards(:shipping)
+    column = columns(:writebook_in_progress)
+
+    assert card.closed?
+
+    post card_drop_path(card), params: { drop_target: column.id }, as: :json
+
+    assert_response :no_content
+    assert card.reload.open?
+    assert_equal column, card.column
+  end
+
+  test "drop a postponed card into a column resumes it there" do
+    card = cards(:logo)
+    card.postpone(user: users(:kevin))
+    column = columns(:writebook_in_progress)
+
+    assert card.postponed?
+
+    post card_drop_path(card), params: { drop_target: column.id }, as: :json
+
+    assert_response :no_content
+    assert_not card.reload.postponed?
+    assert_equal column, card.column
+  end
+end
diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..552ced4
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,157 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "dragging a card into another column moves it right away and saves in the background" do
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column card, source_column
+
+    card_element = find_card(card)
+    assert_equal "true", card_element[:draggable]
+
+    drag card, over: target_column
+
+    # The column under the pointer lights up…
+    assert_selector "##{column_dom_id(target_column)}.drag-and-drop__hover-container", visible: :all
+    # …and the dragged card dims
+    assert_selector "##{card_dom_id(card)}.drag-and-drop__dragged-item", visible: :all
+
+    drop card, on: target_column
+
+    # The card is already where it was left, before the save comes back
+    assert_card_in_column card, target_column
+
+    end_drag card
+
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+
+    # The save lands and the board stays as it was left
+    assert_column_eventually card, target_column
+    assert_card_in_column card, target_column
+  end
+
+  test "a dropped card takes its place in the column's own order and stays there" do
+    golden_card = cards(:logo)
+    dropped_card = cards(:text)
+    other_card = cards(:layout)
+    target_column = columns(:writebook_triage)
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column dropped_card, columns(:writebook_in_progress)
+
+    drag dropped_card, over: target_column
+    drop dropped_card, on: target_column
+    end_drag dropped_card
+
+    # Golden cards lead, then the freshly dropped card, then the rest
+    assert_equal [ golden_card, dropped_card, other_card ].map { |card| card_dom_id(card) }, card_ids_in(target_column)
+
+    # Once the save lands, the server renders the board just as it was left
+    assert_column_eventually dropped_card, target_column
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column dropped_card, target_column
+    assert_equal [ golden_card, dropped_card, other_card ].map { |card| card_dom_id(card) }, card_ids_in(target_column)
+  end
+
+  test "dragging a card to not now postpones it" do
+    card = cards(:logo)
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column card, columns(:writebook_triage)
+
+    drag card, over: "not-now"
+    drop card, on: "not-now"
+    end_drag card
+
+    assert_selector "#not-now ##{card_dom_id(card)}", visible: :all
+    Timeout.timeout(5) { sleep 0.1 until card.reload.postponed? }
+  end
+
+  test "dragging a card to done closes it" do
+    card = cards(:text)
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column card, columns(:writebook_in_progress)
+    assert_selector "#closed-cards .cards__list", visible: :all
+
+    drag card, over: "closed-cards"
+    drop card, on: "closed-cards"
+    end_drag card
+
+    assert_selector "#closed-cards ##{card_dom_id(card)}", visible: :all
+    Timeout.timeout(5) { sleep 0.1 until card.reload.closed? }
+  end
+
+  test "dropping a card back into its own column does not save" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    visit board_path(boards(:writebook))
+    assert_card_in_column card, column
+
+    assert_no_difference -> { Event.count } do
+      drag card, over: column
+      drop card, on: column
+      end_drag card
+      sleep 0.5
+    end
+  end
+
+  private
+    def card_dom_id(card)
+      "article_card_#{card.id}"
+    end
+
+    def column_dom_id(column)
+      column.is_a?(Column) ? "column_#{column.id}" : column.to_s
+    end
+
+    def find_card(card)
+      find(".card-columns ##{card_dom_id(card)}", visible: :all)
+    end
+
+    def assert_card_in_column(card, column)
+      assert_selector "##{column_dom_id(column)} ##{card_dom_id(card)}", visible: :all
+    end
+
+    def card_ids_in(column)
+      all("##{column_dom_id(column)} .cards__list .card", visible: :all).map { |element| element[:id] }
+    end
+
+    def drag(card, over:)
+      page.execute_script(<<~JS, find_card(card), find("##{column_dom_id(over)}", visible: :all))
+        const [ card, column ] = arguments
+        window.dragDataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.dragDataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.dragDataTransfer }))
+      JS
+    end
+
+    def drop(card, on:)
+      page.execute_script(<<~JS, find("##{column_dom_id(on)}", visible: :all))
+        const [ column ] = arguments
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: window.dragDataTransfer }))
+      JS
+    end
+
+    def end_drag(card)
+      page.execute_script(<<~JS, find_card(card))
+        const [ card ] = arguments
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: window.dragDataTransfer }))
+      JS
+    end
+
+    def assert_column_eventually(card, column)
+      Timeout.timeout(5) { sleep 0.1 until card.reload.column == column }
+    end
+end
