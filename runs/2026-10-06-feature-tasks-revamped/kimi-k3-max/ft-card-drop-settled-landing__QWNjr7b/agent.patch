new file mode 100644
index 0000000..41f44a9
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,175 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards between columns with drag and drop. Columns keep their own
+// order: a dropped card takes its place according to the column's sorting,
+// dragging never rearranges cards within a column.
+//
+// Dropping applies right away: the card lands where it was left and the save
+// happens in the background, so the board doesn't wait on the server and
+// nothing shifts around afterwards.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  itemTargetConnected(item) {
+    item.draggable = this.#draggingIsSupported
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+
+    if (item === this.draggedItem) {
+      this.#endDrag()
+    }
+  }
+
+  dragStart(event) {
+    const item = event.target.closest(this.#itemSelector)
+
+    if (item) {
+      this.draggedItem = item
+
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+      this.#setDragImage(event, item)
+
+      // Dim the card only after the browser captured the drag image, so the
+      // ghost that follows the pointer keeps its original look.
+      nextFrame().then(() => {
+        if (item === this.draggedItem) {
+          item.classList.add(this.draggedItemClass)
+        }
+      })
+    }
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#unhighlight()
+    }
+  }
+
+  dragLeave(event) {
+    if (this.draggedItem && !this.element.contains(event.relatedTarget)) {
+      this.#unhighlight()
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFor(event)
+
+    if (container) {
+      event.preventDefault()
+      this.#drop(this.draggedItem, container)
+    }
+  }
+
+  dragEnd() {
+    this.#endDrag()
+  }
+
+  // Private
+
+  get #draggingIsSupported() {
+    // Drag and drop needs a precise pointing device, so it's not available on
+    // touch-only devices.
+    return !window.matchMedia("(any-hover: none) and (any-pointer: coarse)").matches
+  }
+
+  get #itemSelector() {
+    return '[data-drag-and-drop-target~="item"]'
+  }
+
+  get #containerSelector() {
+    return '[data-drag-and-drop-target~="container"]'
+  }
+
+  #containerFor(event) {
+    return event.target.closest(this.#containerSelector)
+  }
+
+  #setDragImage(event, item) {
+    const bounds = item.getBoundingClientRect()
+    event.dataTransfer.setDragImage(item, event.clientX - bounds.left, event.clientY - bounds.top)
+  }
+
+  #highlight(container) {
+    if (container !== this.highlightedContainer) {
+      this.#unhighlight()
+      this.highlightedContainer = container
+      container.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  #unhighlight() {
+    this.highlightedContainer?.classList.remove(this.hoverContainerClass)
+    this.highlightedContainer = null
+  }
+
+  #drop(item, container) {
+    if (container !== item.closest(this.#containerSelector)) {
+      const originalPosition = { parent: item.parentElement, sibling: item.nextElementSibling }
+
+      this.#insertInOrder(item, container)
+      this.#save(item, container, originalPosition)
+    }
+  }
+
+  #insertInOrder(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      // Columns place golden cards first and then order by most recent
+      // activity, so a freshly dropped card leads its group.
+      const selector = item.classList.contains("golden-effect") ? ".card" : ".card:not(.golden-effect)"
+      const successor = list.querySelector(selector)
+
+      if (successor) {
+        successor.before(item)
+      } else {
+        list.append(item)
+      }
+    }
+  }
+
+  async #save(item, container, originalPosition) {
+    try {
+      const response = await post(item.dataset.cardDropUrl, {
+        body: { drop_target: container.dataset.dropTarget },
+        responseKind: "json"
+      })
+
+      if (!response.ok) {
+        this.#moveBack(item, originalPosition)
+      }
+    } catch {
+      this.#moveBack(item, originalPosition)
+    }
+  }
+
+  #moveBack(item, { parent, sibling }) {
+    if (sibling?.isConnected) {
+      sibling.before(item)
+    } else if (parent?.isConnected) {
+      parent.append(item)
+    }
+  }
+
+  #endDrag() {
+    this.#unhighlight()
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+  }
+}
