+      assert cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create with invalid email address" do
+    untenanted do
+      assert_no_difference -> { MagicLink.count } do
+        post session_path, params: { email_address: "not-a-valid-email" }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create with a new email address signs the person up" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post session_path, params: { email_address: "brand-new-person@example.com" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "create via JSON" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path(format: :json), params: { email_address: identity.email_address }
+
+      assert_response :created
+      assert @response.parsed_body["pending_authentication_token"].present?
+    end
+  end
+
+  test "create with an existing identity when not accepting signups" do
+    identity = identities(:kevin)
+
+    with_multi_tenant_mode(false) do
+      untenanted do
+        assert_difference -> { MagicLink.count }, 1 do
+          post session_path, params: { email_address: identity.email_address }
+        end
+
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+  end
+
+  test "create with an unknown email address when not accepting signups" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        assert_no_difference -> { Identity.count } do
+          assert_no_difference -> { MagicLink.count } do
+            post session_path, params: { email_address: "nobody@example.com" }
+          end
+        end
+
+        assert_response :unprocessable_entity
+      end
+    end
+  end
 end
