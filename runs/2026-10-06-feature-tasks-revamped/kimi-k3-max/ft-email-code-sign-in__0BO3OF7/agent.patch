@@ -0,0 +1,79 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if magic_link = authenticated_magic_link
+      complete_pending_authentication magic_link
+    else
+      reject_invalid_code
+    end
+  end
+
+  private
+    def authenticated_magic_link
+      if magic_link = MagicLink.find_by_pending_authentication_token(cookies[:pending_authentication_token].to_s)
+        magic_link if magic_link.verify(params[:code])
+      end
+    end
+
+    def complete_pending_authentication(magic_link)
+      identity = magic_link.identity
+
+      magic_link.destroy
+      cookies.delete :pending_authentication_token
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_pending_authentication_url(identity) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def after_pending_authentication_url(identity)
+      if join_code = pending_join_code
+        join_account_url(identity, join_code)
+      else
+        after_authentication_url
+      end
+    end
+
+    def pending_join_code
+      if code = session.delete(:pending_join_code)
+        Account::JoinCode.active.find_by(code: code)
+      end
+    end
+
+    def join_account_url(identity, join_code)
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      if user.setup?
+        landing_url(script_name: join_code.account.slug)
+      else
+        new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+
+    def reject_invalid_code
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
