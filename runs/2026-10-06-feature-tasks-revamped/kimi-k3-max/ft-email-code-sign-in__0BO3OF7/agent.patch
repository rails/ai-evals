diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..f9c6c3b
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,34 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_PERIOD = 15.minutes
+
+  belongs_to :identity
+
+  before_create :generate_code, if: -> { code.blank? }
+  after_create_commit :deliver_later
+
+  def self.find_by_pending_authentication_token(token)
+    find_signed(token, purpose: :pending_authentication)
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: :pending_authentication, expires_in: EXPIRATION_PERIOD)
+  end
+
+  def verify(code)
+    !expired? && self.code == code.to_s.strip.upcase
+  end
+
+  def expired?
+    created_at < EXPIRATION_PERIOD.ago
+  end
+
+  def deliver_later
+    MagicLinkMailer.sign_in(self).deliver_later
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+end
