+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,26 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_pending_authentication_for(identity, redirect_after: nil, join_code: nil)
+      magic_link = identity.magic_links.create!
+
+      session[:return_to_after_authenticating] = redirect_after if redirect_after
+      session[:pending_join_code] = join_code.code if join_code
+
+      set_pending_authentication_cookie magic_link
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path(script_name: nil), notice: "We sent a 6-character sign-in code to #{identity.email_address}" }
+        format.json { render json: { pending_authentication_token: magic_link.pending_authentication_token }, status: :created }
+      end
+    end
+
+    def set_pending_authentication_cookie(magic_link)
+      cookies[:pending_authentication_token] = {
+        value: magic_link.pending_authentication_token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+end
