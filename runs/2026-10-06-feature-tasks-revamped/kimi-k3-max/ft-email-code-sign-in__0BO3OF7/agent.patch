diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..f1b1554
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a six-character code on create" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_equal 6, magic_link.code.length
+  end
+
+  test "keeps a code assigned before create" do
+    magic_link = identities(:kevin).magic_links.create!(code: "ABC123")
+
+    assert_equal "ABC123", magic_link.code
+  end
+
+  test "pending authentication token round trips" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_equal magic_link, MagicLink.find_by_pending_authentication_token(magic_link.pending_authentication_token)
+  end
+
+  test "verify accepts the code regardless of case and surrounding whitespace" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert magic_link.verify(magic_link.code)
+    assert magic_link.verify(magic_link.code.downcase)
+    assert magic_link.verify(" #{magic_link.code} ")
+    assert_not magic_link.verify("XXXXXX")
+    assert_not magic_link.verify(nil)
+  end
+
+  test "a code works for fifteen minutes" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    travel 16.minutes do
+      assert magic_link.expired?
+      assert_not magic_link.verify(magic_link.code)
+    end
+  end
+
+  test "pending authentication token expires" do
+    magic_link = identities(:kevin).magic_links.create!
+    token = magic_link.pending_authentication_token
+
+    travel 16.minutes do
+      assert_nil MagicLink.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "creating a magic link enqueues an email with the code in the subject" do
+    identity = identities(:kevin)
+
+    magic_link = nil
+    assert_enqueued_jobs 1 do
+      magic_link = identity.magic_links.create!
+    end
+
+    perform_enqueued_jobs
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+  end
+end
