diff --git a/test/controllers/stalled_cards_test.rb b/test/controllers/stalled_cards_test.rb
new file mode 100644
index 0000000..fb766f8
--- /dev/null
+++ b/test/controllers/stalled_cards_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  test "full stalled lifecycle over HTTP" do
+    card = cards(:text)
+
+    # A burst of comments from two people over HTTP
+    sign_in_as :david
+    post card_comments_path(card), params: { comment: { body: "One" } }, as: :turbo_stream
+
+    logout_and_sign_in_as :kevin
+    post card_comments_path(card), params: { comment: { body: "Two" } }, as: :turbo_stream
+    assert_not card.reload.burst_at?
+
+    logout_and_sign_in_as :david
+    post card_comments_path(card), params: { comment: { body: "Three" } }, as: :turbo_stream
+    assert card.reload.burst_at?
+    assert_not card.stalled?
+
+    travel 15.days do
+      # Two weeks of silence: the card is stalled
+      assert card.reload.stalled?
+
+      # Listed in the cards index with indexed_by=stalled
+      logout_and_sign_in_as :kevin
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_includes @response.parsed_body.pluck("number"), card.number
+
+      # Any activity resets it
+      post card_comments_path(card), params: { comment: { body: "Back at it" } }, as: :turbo_stream
+      assert_not card.reload.stalled?
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_not_includes @response.parsed_body.pluck("number"), card.number
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..582f5fe
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "cards have no burst and are not stalled by default" do
+    assert_not @card.burst_at?
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from at least two people within a third of the auto-close period are a burst" do
+    assert_not @card.burst_at?
+
+    @card.comments.create! body: "First", creator: users(:david)
+    @card.comments.create! body: "Second", creator: users(:kevin)
+    assert_not @card.reload.burst_at?
+
+    @card.comments.create! body: "Third", creator: users(:david)
+    assert @card.reload.burst_at?
+  end
+
+  test "three comments from a single person are not a burst" do
+    3.times { |n| @card.comments.create! body: "Note #{n}", creator: users(:david) }
+
+    assert_not @card.reload.burst_at?
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    # The writebook board closes cards after 90 days, so the burst window is 30 days.
+    @card.comments.create! body: "Old", creator: users(:kevin)
+
+    travel 31.days do
+      @card.comments.create! body: "Recent", creator: users(:david)
+      @card.comments.create! body: "Recent too", creator: users(:kevin)
+
+      assert_not @card.reload.burst_at?
+    end
+  end
+
+  test "the burst window follows the board's auto-close period" do
+    # A third of the board's 3-day auto-close period is a single day.
+    boards(:writebook).update! auto_postpone_period: 3.days
+
+    @card.comments.create! body: "First", creator: users(:david)
+    @card.comments.create! body: "Second", creator: users(:kevin)
+
+    travel 2.hours do
+      @card.comments.create! body: "Third", creator: users(:david)
+      assert @card.reload.burst_at?
+    end
+  end
+
+  test "system comments do not count towards a burst" do
+    3.times { |n| @card.comments.create! body: "System #{n}", creator: @card.account.system_user }
+
+    assert_not @card.reload.burst_at?
+  end
+
+  test "assigning someone is a burst" do
+    assert_not @card.burst_at?
+
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.burst_at?
+  end
+
+  test "reopening is a burst, but closing is not" do
+    @card.close
+    assert_not @card.reload.burst_at?
+
+    @card.reopen
+    assert @card.reload.burst_at?
+  end
+
+  test "a card is stalled when it had a burst and then no activity for two weeks" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 13.days do
+      assert_not @card.reload.stalled?
+    end
+
+    travel 15.days do
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "a card without a burst is not stalled even after two weeks of inactivity" do
+    @card.update! last_active_at: 3.weeks.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity on the card resets it" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 15.days do
+      assert @card.reload.stalled?
+
+      @card.comments.create! body: "Back to it", creator: users(:david)
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "indexed by stalled" do
+    @card.toggle_assignment users(:kevin)
+    @card.update! last_active_at: 15.days.ago
+
+    cards(:logo).update! last_active_at: 15.days.ago
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:logo)
+  end
+end
