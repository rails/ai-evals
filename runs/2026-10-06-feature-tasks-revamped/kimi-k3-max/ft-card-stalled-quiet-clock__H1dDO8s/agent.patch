diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..b480a62
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  # A card is stalled when it got a burst of attention and then went cold.
+  STALLED_AFTER_PERIOD_IN_DAYS = 14
+
+  # A burst of comments is at least this many comments from at least this many
+  # different people, landing within a third of the board's auto-close period.
+  BURST_COMMENTS_COUNT = 3
+  BURST_PEOPLE_COUNT = 2
+
+  # Events that count as a burst of attention on their own.
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ]
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER_PERIOD_IN_DAYS.days.ago) }
+  end
+
+  def stalled?
+    burst_at? && last_active_at <= STALLED_AFTER_PERIOD_IN_DAYS.days.ago
+  end
+
+  def register_burst
+    update! burst_at: Time.current
+  end
+
+  def register_comment_burst
+    register_burst if comment_burst?
+  end
+
+  private
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: burst_window.seconds.ago..)
+      recent_comments.count >= BURST_COMMENTS_COUNT &&
+        recent_comments.distinct.count(:creator_id) >= BURST_PEOPLE_COUNT
+    end
+
+    # A burst of comments lands within a third of the board's auto-close period.
+    def burst_window
+      auto_postpone_period / 3
+    end
+end
