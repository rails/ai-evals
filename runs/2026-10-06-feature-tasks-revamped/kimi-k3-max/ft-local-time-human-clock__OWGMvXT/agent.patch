diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..71e4ee1 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,70 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw timestamp in its +datetime+
+  # attribute. The local-time Stimulus controller rewrites the element's text
+  # in the viewer's own timezone, so the HTML stays identical -- and cacheable
+  # -- no matter who asks for it. The server-rendered text is just a fallback
+  # for when JavaScript isn't available.
+  def local_time_tag(time, format = :relative, **options)
+    return if time.blank?
+
+    tag.time(local_time_fallback_text(time, format),
+      datetime: local_time_datetime_value(time),
+      data: { controller: "local-time", local_time_format_value: format.to_s.dasherize, **options.delete(:data).to_h },
+      **options)
+  end
+
+  private
+    # Mirrors helpers/date_helpers.js so the fallback matches what the browser
+    # will render once the local-time controller connects.
+    def local_time_fallback_text(time, format)
+      time = time.in_time_zone
+
+      case format.to_sym
+      when :relative       then local_relative_time_fallback_text(time)
+      when :date           then local_date_fallback_text(time)
+      when :full_date      then time.strftime("%b %d, %Y")
+      when :weekday_date   then time.strftime("%A, %B %-d")
+      when :time           then time.strftime("%l:%M %p").strip
+      when :short_datetime then time.strftime("%-m/%-d/%y, %-l:%M %p").strip
+      else
+        raise ArgumentError, "Unknown local time format: #{format.inspect}"
+      end
+    end
+
+    def local_relative_time_fallback_text(time)
+      days = (Date.current - time.to_date).to_i
+
+      if days.zero?
+        time.strftime("%l:%M %p").strip
+      elsif days == 1
+        "yesterday"
+      elsif days == -1
+        "tomorrow"
+      elsif days > 1 && days < 7
+        "#{days} days ago"
+      elsif days < -1 && days > -7
+        "in #{days.abs} days"
+      else
+        local_date_fallback_text(time)
+      end
+    end
+
+    def local_date_fallback_text(time)
+      if time.year == Date.current.year
+        time.strftime("%b %-d")
+      else
+        time.strftime("%b %-d, %Y")
+      end
+    end
+
+    # A bare Date marks a calendar day rather than an instant in time, so it's
+    # sent without a time of day for the browser to render as-is.
+    def local_time_datetime_value(time)
+      case time
+      when Time, DateTime, ActiveSupport::TimeWithZone
+        time.utc.iso8601
+      else
+        time.to_fs(:iso8601)
+      end
+    end
 end
