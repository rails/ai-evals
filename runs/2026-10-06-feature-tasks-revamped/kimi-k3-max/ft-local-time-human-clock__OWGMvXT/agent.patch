diff --git a/test/controllers/local_time_rendering_test.rb b/test/controllers/local_time_rendering_test.rb
new file mode 100644
index 0000000..284cabf
--- /dev/null
+++ b/test/controllers/local_time_rendering_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "server sends the raw timestamp for the browser to render" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(comment.card)
+
+    assert_select "time[data-controller='local-time'][data-local-time-format-value='relative'][datetime='#{comment.created_at.utc.iso8601}']"
+  end
+
+  test "raw timestamps do not depend on the viewer's timezone" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(comment.card)
+    assert_includes response.body, %(datetime="#{comment.created_at.utc.iso8601}")
+
+    cookies[:timezone] = "Pacific/Auckland"
+    get card_path(comment.card)
+    assert_includes response.body, %(datetime="#{comment.created_at.utc.iso8601}")
+  end
+
+  test "fallback words follow the viewer's timezone until the browser takes over" do
+    comment = comments(:logo_agreement_kevin)
+
+    cookies[:timezone] = "Pacific/Auckland"
+    get card_path(comment.card)
+
+    assert_select "time[data-controller='local-time']", text: expected_relative_text(comment.created_at, "Pacific/Auckland")
+  end
+
+  test "access tokens are sent as raw timestamps with a short datetime format" do
+    token = identities(:david).access_tokens.create!(description: "CLI", permission: "read")
+
+    get my_access_tokens_path
+
+    assert_select "time[data-controller='local-time'][data-local-time-format-value='short-datetime'][datetime='#{token.created_at.utc.iso8601}']"
+  end
+
+  test "webhook deliveries are sent as raw timestamps" do
+    logout_and_sign_in_as :kevin # only admins can manage webhooks
+
+    delivery = webhook_deliveries(:successfully_completed)
+
+    get board_webhook_path(delivery.webhook.board, delivery.webhook)
+
+    assert_select "time[data-controller='local-time'][data-local-time-format-value='relative'][datetime='#{delivery.created_at.utc.iso8601}']"
+  end
+
+  test "day labels are sent as bare dates so every timezone renders the same calendar day" do
+    get events_path
+
+    assert_select "time[data-controller='local-time'][data-local-time-format-value='weekday-date']"
+    assert_match /<time datetime="\d{4}-\d{2}-\d{2}" data-controller="local-time" data-local-time-format-value="weekday-date">/, response.body
+  end
+
+  private
+    # Mirrors the browser-side formatter in helpers/date_helpers.js
+    def expected_relative_text(time, zone)
+      Time.use_zone(zone) do
+        time = time.in_time_zone
+        days = (Date.current - time.to_date).to_i
+
+        if days.zero?
+          time.strftime("%-l:%M %p")
+        elsif days == 1
+          "yesterday"
+        elsif days == -1
+          "tomorrow"
+        elsif days > 1 && days < 7
+          "#{days} days ago"
+        elsif days < -1 && days > -7
+          "in #{days.abs} days"
+        elsif time.year == Date.current.year
+          time.strftime("%b %-d")
+        else
+          time.strftime("%b %-d, %Y")
+        end
+      end
+    end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..d0df256
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a time element with the raw timestamp in UTC" do
+    tag = local_time_tag(Time.zone.parse("2025-09-12 13:42:15"))
+
+    assert_includes tag, %(datetime="2025-09-12T13:42:15Z")
+    assert_includes tag, %(data-controller="local-time")
+    assert_includes tag, %(data-local-time-format-value="relative")
+    assert_match %r{<time[^>]*>.*</time>}, tag
+  end
+
+  test "renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "formats are dasherized in the format value" do
+    assert_includes local_time_tag(Time.current, :weekday_date), %(data-local-time-format-value="weekday-date")
+    assert_includes local_time_tag(Time.current, :short_datetime), %(data-local-time-format-value="short-datetime")
+  end
+
+  test "passes through additional options" do
+    tag = local_time_tag(Time.current, class: "card__timestamp", title: "Created")
+
+    assert_includes tag, %(class="card__timestamp")
+    assert_includes tag, %(title="Created")
+  end
+
+  test "dates are sent without a time of day so every timezone renders the same calendar day" do
+    tag = local_time_tag(Date.new(2025, 9, 12), :weekday_date)
+
+    assert_includes tag, %(datetime="2025-09-12")
+    assert_includes tag, "Friday, September 12"
+  end
+
+  test "unknown formats raise" do
+    assert_raises(ArgumentError) { local_time_tag(Time.current, :nonsense) }
+  end
+
+  test "relative fallback renders today's times as a clock time" do
+    travel_to Time.zone.parse("2025-09-12 15:00") do
+      assert_equal time_tag_text("1:42 PM"), text_of(local_time_tag(Time.zone.parse("2025-09-12 13:42")))
+    end
+  end
+
+  test "relative fallback renders yesterday and tomorrow as words" do
+    travel_to Time.zone.parse("2025-09-12 15:00") do
+      assert_equal "yesterday", text_of(local_time_tag(Time.zone.parse("2025-09-11 23:30")))
+      assert_equal "tomorrow", text_of(local_time_tag(Time.zone.parse("2025-09-13 00:30")))
+    end
+  end
+
+  test "relative fallback renders days within the week as day counts" do
+    travel_to Time.zone.parse("2025-09-12 15:00") do
+      assert_equal "5 days ago", text_of(local_time_tag(5.days.ago))
+      assert_equal "in 3 days", text_of(local_time_tag(3.days.from_now))
+    end
+  end
+
+  test "relative fallback renders older dates as a date" do
+    travel_to Time.zone.parse("2025-09-12 15:00") do
+      assert_equal "Sep 1", text_of(local_time_tag(Time.zone.parse("2025-09-01 10:00")))
+      assert_equal "Dec 24, 2024", text_of(local_time_tag(Time.zone.parse("2024-12-24 10:00")))
+      assert_equal "Sep 20", text_of(local_time_tag(Time.zone.parse("2025-09-20 10:00")))
+    end
+  end
+
+  test "absolute format fallbacks" do
+    travel_to Time.zone.parse("2025-09-12 15:00") do
+      time = Time.zone.parse("2025-09-12 13:42")
+
+      assert_equal "Sep 12",       text_of(local_time_tag(time, :date))
+      assert_equal "Sep 12, 2025", text_of(local_time_tag(time, :full_date))
+      assert_equal "Friday, September 12", text_of(local_time_tag(time, :weekday_date))
+      assert_equal "1:42 PM",      text_of(local_time_tag(time, :time))
+      assert_equal "9/12/25, 1:42 PM", text_of(local_time_tag(time, :short_datetime))
+    end
+  end
+
+  test "date fallback includes the year for other years" do
+    assert_equal "Sep 12, 2024", text_of(local_time_tag(Time.zone.parse("2024-09-12 13:42"), :date))
+  end
+
+  private
+    def text_of(tag)
+      tag[%r{>(.*)</time>}, 1]
+    end
+
+    def time_tag_text(text)
+      text
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..7846d15
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,135 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "the browser renders raw timestamps in the viewer's own timezone" do
+    sign_in_as(users(:david))
+
+    comment = comments(:logo_agreement_kevin) # 2.hours.ago
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment)}" do
+      assert_selector "time[data-controller='local-time'][datetime='#{comment.created_at.utc.iso8601}']",
+        text: expected_relative_text(comment.created_at, browser_timezone)
+    end
+
+    # Pretend the viewer is in Auckland: the page must re-render the same raw
+    # timestamp in that timezone without asking the server again.
+    with_browser_timezone "Pacific/Auckland" do
+      visit card_url(comment.card)
+
+      expected = expected_relative_text(comment.created_at, "Pacific/Auckland")
+      within "##{dom_id(comment)}" do
+        assert_selector "time[data-controller='local-time'][datetime='#{comment.created_at.utc.iso8601}']", text: expected
+      end
+    end
+  end
+
+  test "relative day words" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+    click_on "Full history" # reveals comments by the system user
+
+    within "##{dom_id(comments(:logo_3))}" do # 1.day.ago
+      assert_selector "time", text: /yesterday/i
+    end
+
+    within "##{dom_id(comments(:logo_agreement_jz))}" do # 2.days.ago
+      assert_selector "time", text: /2 days ago/i
+    end
+
+    within "##{dom_id(comments(:logo_1))}" do # 1.week.ago
+      assert_selector "time", text: /#{Regexp.escape(expected_relative_text(comments(:logo_1).created_at, browser_timezone))}/i
+    end
+  end
+
+  test "future and absolute dates render in the browser" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card.update_columns(last_active_at: 87.days.ago) # auto-closes 3 days from now
+
+    visit card_url(card)
+
+    within "##{dom_id(card, :closure_notice)}" do
+      assert_selector "time[data-local-time-format-value='relative'][datetime='#{card.entropy.auto_clean_at.utc.iso8601}']", text: /in 3 days/i
+    end
+
+    visit card_url(cards(:shipping)) # closed
+
+    within ".card__closed-date" do
+      assert_selector "time[data-local-time-format-value='full-date']",
+        text: /#{Regexp.escape(cards(:shipping).closed_at.in_time_zone(browser_timezone).strftime("%b %d, %Y"))}/i
+    end
+  end
+
+  test "notification timestamps render in the browser" do
+    sign_in_as(users(:david))
+
+    notification = notifications(:logo_mentioned_david) # 1.week.ago
+
+    assert_selector "##{dom_id(notification)} time[data-local-time-format-value='date'][datetime='#{notification.created_at.utc.iso8601}']",
+      text: /#{Regexp.escape(notification.created_at.in_time_zone(browser_timezone).strftime("%b %-d"))}/i
+  end
+
+  test "day timeline labels render in the browser" do
+    sign_in_as(users(:david))
+
+    visit root_path
+
+    assert_selector "time[data-controller='local-time'][data-local-time-format-value='weekday-date']"
+  end
+
+  test "day labels render the same calendar day in every timezone" do
+    Event.update_all(created_at: Time.current)
+
+    sign_in_as(users(:david))
+
+    with_browser_timezone "America/New_York" do
+      visit root_path # sets the timezone cookie to the overridden zone
+      visit root_path # server now groups days by that zone and sends the bare date
+
+      expected = Time.use_zone("America/New_York") { Date.current.strftime("%A, %B %-d") }
+      datetime = Time.use_zone("America/New_York") { Date.current.to_s }
+
+      assert_selector "time[data-local-time-format-value='weekday-date'][datetime='#{datetime}']", text: /#{Regexp.escape(expected)}/i
+    end
+  end
+
+  private
+    def browser_timezone
+      page.evaluate_script("Intl.DateTimeFormat().resolvedOptions().timeZone")
+    end
+
+    # CDP timezone overrides persist across tests, so always put the clock back.
+    def with_browser_timezone(zone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: zone)
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    end
+
+    # Mirrors the browser-side formatter in helpers/date_helpers.js
+    def expected_relative_text(time, zone)
+      Time.use_zone(zone) do
+        time = time.in_time_zone
+        days = (Date.current - time.to_date).to_i
+
+        if days.zero?
+          time.strftime("%-l:%M %p")
+        elsif days == 1
+          "yesterday"
+        elsif days == -1
+          "tomorrow"
+        elsif days > 1 && days < 7
+          "#{days} days ago"
+        elsif days < -1 && days > -7
+          "in #{days.abs} days"
+        elsif time.year == Date.current.year
+          time.strftime("%b %-d")
+        else
+          time.strftime("%b %-d, %Y")
+        end
+      end
+    end
+end
