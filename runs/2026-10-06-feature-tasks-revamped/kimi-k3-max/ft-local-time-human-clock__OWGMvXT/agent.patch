diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..f273c24
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  formatLocalDate,
+  formatLocalFullDate,
+  formatLocalRelativeTime,
+  formatLocalShortDatetime,
+  formatLocalTime,
+  formatLocalTimestamp,
+  formatLocalWeekdayDate
+} from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+// Rewrites <time datetime="…"> elements in the viewer's own timezone. The
+// server only sends the raw timestamp, so the HTML can be cached and shared
+// between people in different timezones.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.mutationObserver = new MutationObserver(() => this.#render())
+    this.mutationObserver.observe(this.element, { childList: true, characterData: true, subtree: true })
+    this.refreshTimer = setInterval(() => this.#render(), REFRESH_INTERVAL)
+    this.#render()
+  }
+
+  disconnect() {
+    this.mutationObserver?.disconnect()
+    clearInterval(this.refreshTimer)
+  }
+
+  #render() {
+    const { date, dateOnly } = this.#parsedDatetime()
+    if (!date) return
+
+    const text = this.#format(date, dateOnly)
+
+    if (this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+
+    if (this.formatValue === "relative" && !dateOnly) {
+      this.element.title = formatLocalTimestamp(date)
+    }
+  }
+
+  #format(date, dateOnly) {
+    switch (this.formatValue) {
+      case "date":           return formatLocalDate(date)
+      case "full-date":      return formatLocalFullDate(date)
+      case "weekday-date":   return formatLocalWeekdayDate(date)
+      case "time":           return formatLocalTime(date)
+      case "short-datetime": return formatLocalShortDatetime(date)
+      default:               return formatLocalRelativeTime(date, { dateOnly })
+    }
+  }
+
+  // A bare "2025-12-12" datetime marks a calendar day rather than an instant:
+  // parse it in local time so it renders as that same day everywhere.
+  #parsedDatetime() {
+    const value = this.element.getAttribute("datetime")
+    if (!value) return {}
+
+    const dateOnlyMatch = value.match(/^(\d{4})-(\d{2})-(\d{2})$/)
+
+    if (dateOnlyMatch) {
+      const [ , year, month, day ] = dateOnlyMatch
+      return { date: new Date(year, month - 1, day), dateOnly: true }
+    }
+
+    const date = new Date(value)
+    return isNaN(date) ? {} : { date, dateOnly: false }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..ae80a06 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,74 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+const LOCAL_TIME_LOCALE = "en-US"
+const localTimeFormatters = new Map()
+
+function localTimeFormatter(options) {
+  const key = JSON.stringify(options)
+
+  if (!localTimeFormatters.has(key)) {
+    localTimeFormatters.set(key, new Intl.DateTimeFormat(LOCAL_TIME_LOCALE, options))
+  }
+
+  return localTimeFormatters.get(key)
+}
+
+// "1:42 PM"
+export function formatLocalTime(date) {
+  return localTimeFormatter({ hour: "numeric", minute: "2-digit", hour12: true }).format(date)
+}
+
+// "Sep 12", or "Sep 12, 2024" when the date falls in another year
+export function formatLocalDate(date) {
+  const options = { month: "short", day: "numeric" }
+
+  if (date.getFullYear() !== new Date().getFullYear()) {
+    options.year = "numeric"
+  }
+
+  return localTimeFormatter(options).format(date)
+}
+
+// "Sep 12, 2025"
+export function formatLocalFullDate(date) {
+  return localTimeFormatter({ month: "short", day: "2-digit", year: "numeric" }).format(date)
+}
+
+// "Friday, September 12"
+export function formatLocalWeekdayDate(date) {
+  return localTimeFormatter({ weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+// "9/12/25, 1:42 PM"
+export function formatLocalShortDatetime(date) {
+  return localTimeFormatter({ month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit", hour12: true }).format(date)
+}
+
+// "Friday, September 12, 2025 at 1:42 PM"
+export function formatLocalTimestamp(date) {
+  return localTimeFormatter({ weekday: "long", month: "long", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit", hour12: true }).format(date)
+}
+
+// Words in the viewer's own timezone: "1:42 PM" earlier today, "yesterday",
+// "5 days ago" or "Sep 12" further back, "tomorrow" or "in 3 days" ahead.
+export function formatLocalRelativeTime(date, { dateOnly = false } = {}) {
+  const days = localDifferenceInDays(date, new Date())
+
+  if (days === 0) return dateOnly ? "today" : formatLocalTime(date)
+  if (days === 1) return "yesterday"
+  if (days === -1) return "tomorrow"
+  if (days > 1 && days < 7) return `${days} days ago`
+  if (days < -1 && days > -7) return `in ${-days} days`
+
+  return formatLocalDate(date)
+}
+
+export function localDifferenceInDays(fromDate, toDate) {
+  return Math.round((localBeginningOfDay(toDate) - localBeginningOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
+
+function localBeginningOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
