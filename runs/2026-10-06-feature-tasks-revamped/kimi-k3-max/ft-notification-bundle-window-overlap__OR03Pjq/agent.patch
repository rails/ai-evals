diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..bc6c14a
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,210 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "the first notification opens a window that starts when it lands" do
+    freeze_time
+
+    notification = notify(events(:layout_commented))
+    bundle = notification.bundle
+
+    assert bundle.present?
+    assert_equal @user, bundle.user
+    assert_equal notification.created_at, bundle.starts_at
+    assert_equal notification.created_at + 4.hours, bundle.ends_at
+    assert bundle.pending?
+  end
+
+  test "window length follows the chosen frequency" do
+    freeze_time
+
+    @user.settings.update!(bundle_email_frequency: "daily")
+    assert_equal 1.day.from_now, notify(events(:layout_commented)).bundle.ends_at
+
+    @user.notification_bundles.destroy_all
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    assert_equal 1.week.from_now, notify(events(:logo_assignment_km)).bundle.ends_at
+  end
+
+  test "notifications landing in the same window join the open bundle" do
+    first = notify(events(:layout_commented))
+
+    travel 2.hours do
+      second = notify(events(:logo_assignment_km))
+      assert_equal first.bundle, second.bundle
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "late notifications join the window that is still open" do
+    first = notify(events(:layout_commented))
+    bundle = first.bundle
+
+    # Past the end of the window, but the email has not gone out yet.
+    travel (4.hours + 5.minutes) do
+      late = notify(events(:logo_assignment_km))
+      assert_equal bundle, late.bundle
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "a new window opens once the previous one was delivered" do
+    first = notify(events(:layout_commented))
+    first.bundle.update!(delivered_at: first.bundle.ends_at)
+
+    travel 5.hours do
+      second = notify(events(:logo_assignment_km))
+
+      assert_not_equal first.bundle, second.bundle
+      assert second.bundle.starts_at >= first.bundle.ends_at, "windows must not overlap"
+      assert_equal 1, @user.notification_bundles.pending.count
+    end
+  end
+
+  test "users with the frequency off never get bundles" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = assert_no_difference("Notification::Bundle.count") { notify(events(:layout_commented)) }
+
+    assert_nil notification.bundle
+  end
+
+  test "re-notifying adds the notification to the currently open window" do
+    notification = notify(events(:layout_commented))
+    notification.bundle.update!(delivered_at: notification.bundle.ends_at)
+
+    travel 5.hours do
+      notification.source_type_will_change!
+      notification.update!(source: events(:layout_published), read_at: nil, unread_count: 2)
+
+      assert_equal @user.notification_bundles.pending.sole, notification.reload.bundle
+    end
+  end
+
+  test "delivering sends a single email with all the notifications in the window and marks it delivered" do
+    notify(events(:layout_commented))
+    travel(1.hour) { notify(events(:logo_assignment_km)) }
+
+    bundle = @user.notification_bundles.sole
+
+    travel 5.hours do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          bundle.deliver_now
+        end
+      end
+
+      assert bundle.reload.delivered_at.present?
+      assert_not bundle.pending?
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match %r{#{@user.account.slug}/}, email.body.encoded
+  end
+
+  test "windows that have not ended yet are not delivered" do
+    notify(events(:layout_commented))
+    bundle = @user.notification_bundles.sole
+
+    assert_no_emails do
+      bundle.deliver_now
+    end
+
+    assert bundle.pending?
+  end
+
+  test "delivering an empty window sends no email but closes the window" do
+    bundle = @user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: 1.minute.ago)
+
+    assert_no_emails do
+      bundle.deliver_now
+    end
+
+    assert_not bundle.pending?
+  end
+
+  test "delivering more than once sends no additional email" do
+    notify(events(:layout_commented))
+    bundle = @user.notification_bundles.sole
+
+    travel 5.hours do
+      perform_enqueued_jobs { bundle.deliver_now }
+
+      assert_no_emails do
+        bundle.deliver_now
+      end
+    end
+  end
+
+  test "deliver_all_due only delivers windows that have ended" do
+    notify(events(:layout_commented))
+    bundle = @user.notification_bundles.sole
+
+    users(:kevin).settings.update!(bundle_email_frequency: "daily")
+    notifications(:layout_commented_kevin).destroy
+    kevins_bundle = Notification.create!(user: users(:kevin), source: events(:layout_commented), creator: users(:david)).bundle
+
+    # No window has ended yet.
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      Notification::Bundle.deliver_all_due
+    end
+
+    # Past the end of the four-hour window, but not the daily one.
+    travel 5.hours do
+      assert_enqueued_with job: Notification::Bundle::DeliveryJob, args: [ bundle ] do
+        Notification::Bundle.deliver_all_due
+      end
+
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+
+      assert bundle.reload.delivered_at.present?
+      assert kevins_bundle.reload.pending?, "kevin's daily window should still be open"
+    end
+  end
+
+  test "no email for deactivated users, but the window still closes" do
+    notify(events(:layout_commented))
+    bundle = @user.notification_bundles.sole
+
+    @user.update!(active: false)
+
+    travel 5.hours do
+      assert_no_emails do
+        bundle.deliver_now
+      end
+
+      assert_not bundle.pending?
+    end
+  end
+
+  test "notifications created by the notifier are bundled" do
+    cards(:layout).watch_by(@user)
+
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      Notifier.for(events(:layout_commented)).notify
+    end
+
+    notification = @user.notifications.order(:created_at).last
+    assert_equal @user.notification_bundles.sole, notification.bundle
+  end
+
+  private
+    def notify(source)
+      Notification.create!(user: @user, source: source, creator: users(:david)).tap(&:reload)
+    end
+end
