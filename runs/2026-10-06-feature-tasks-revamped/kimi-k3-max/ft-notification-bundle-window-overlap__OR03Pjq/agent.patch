+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to never" do
+    settings = User.create!(account: accounts("37s"), name: "New User").settings
+
+    assert_equal "never", settings.bundle_email_frequency
+    assert_not settings.bundles_email?
+    assert_nil settings.bundle_email_window
+  end
+
+  test "bundle email frequency must be a known value" do
+    settings = users(:kevin).settings
+
+    User::Settings::BUNDLE_EMAIL_FREQUENCIES.each do |frequency|
+      assert settings.update(bundle_email_frequency: frequency), "#{frequency} should be valid"
+    end
+
+    assert_not settings.update(bundle_email_frequency: "hourly")
+    assert settings.errors.added?(:bundle_email_frequency, :inclusion, value: "hourly")
+  end
+
+  test "bundle email window matches the frequency" do
+    settings = users(:kevin).settings
+
+    assert_equal({ "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week },
+      User::Settings::BUNDLE_EMAIL_WINDOWS)
+
+    settings.update!(bundle_email_frequency: "every_few_hours")
+    assert settings.bundles_email?
+    assert_equal 4.hours, settings.bundle_email_window
+
+    settings.update!(bundle_email_frequency: "daily")
+    assert_equal 1.day, settings.bundle_email_window
+
+    settings.update!(bundle_email_frequency: "weekly")
+    assert_equal 1.week, settings.bundle_email_window
+  end
+end
