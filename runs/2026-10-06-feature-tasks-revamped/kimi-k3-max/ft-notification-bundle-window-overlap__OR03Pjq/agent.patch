@@ -0,0 +1,36 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "bundle" do
+    user = users(:jz)
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+    Notification.create!(user: user, source: events(:logo_assignment_km), creator: users(:david))
+
+    bundle = user.notification_bundles.sole
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "jz@37signals.com" ], email.to
+    assert_equal "Your Fizzy digest", email.subject
+
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match cards(:logo).title, email.body.encoded
+    assert_match boards(:writebook).name, email.body.encoded
+  end
+
+  test "bundle links carry the account slug" do
+    user = users(:jz)
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+
+    email = NotificationMailer.bundle(user.notification_bundles.sole).deliver_now
+
+    assert_match %r{#{user.account.slug}/}, email.body.encoded
+  end
+end
