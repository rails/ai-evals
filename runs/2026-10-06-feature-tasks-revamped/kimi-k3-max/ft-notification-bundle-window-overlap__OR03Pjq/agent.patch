+<h1 class="title">Your Fizzy digest</h1>
+<p class="subtitle">Here’s what happened while you were away.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+  <%= tag.hr class: "notification__board-separator" if index.positive? %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <table>
+        <tr>
+          <td class="avatar__container">
+            <%= mail_avatar_tag(notification.creator) %>
+          </td>
+          <td>
+            <p class="notification__author"><%= notification.creator.name %></p>
+            <h3 class="card__title">
+              <%= link_to notification.payload.title, notification.payload.url %>
+            </h3>
+            <% if notification.payload.body.present? %>
+              <p class="notification__details">
+                <% if notification.payload.category == "mention" %>
+                  <span class="notificaton__mention"><%= notification.payload.body %></span>
+                <% else %>
+                  <%= notification.payload.body %>
+                <% end %>
+              </p>
+            <% end %>
+          </td>
+        </tr>
+      </table>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">Need help? <%= mail_to "support@fizzy.do", "Send us an email" %>.</p>
