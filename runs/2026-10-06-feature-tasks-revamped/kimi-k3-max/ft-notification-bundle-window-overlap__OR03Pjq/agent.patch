diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..4d71481
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,63 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+
+  class << self
+    # Adds a notification to the user's currently open bundle, opening a new
+    # window when there isn't one. The window starts when the first
+    # notification lands and runs for the user's chosen frequency.
+    #
+    # Notifications that arrive after a window has ended but before its email
+    # went out still join the open window, so a user never has two overlapping
+    # windows at the same time.
+    def add(notification)
+      user = notification.user
+
+      if user.settings&.bundles_email?
+        user.with_lock do
+          bundle = user.notification_bundles.pending.first_or_create!(
+            starts_at: notification.created_at,
+            ends_at: notification.created_at + user.settings.bundle_email_window
+          )
+          notification.update_column(:bundle_id, bundle.id)
+        end
+      end
+    end
+
+    def deliver_all_due
+      due.find_each(&:deliver_later)
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    Current.with_account(account) do
+      with_lock do
+        if pending? && due?
+          update!(delivered_at: Time.current)
+          NotificationMailer.bundle(self).deliver_later if deliverable?
+        end
+      end
+    end
+  end
+
+  def pending?
+    delivered_at.nil?
+  end
+
+  def due?
+    ends_at <= Time.current
+  end
+
+  private
+    def deliverable?
+      user.active? && user.identity.present? && notifications.any?
+    end
+end
