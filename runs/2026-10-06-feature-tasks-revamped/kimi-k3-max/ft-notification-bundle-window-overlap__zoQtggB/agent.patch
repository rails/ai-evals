+<h1 class="title">Your Fizzy digest</h1>
+<p class="subtitle">
+  You have <%= pluralize(@notifications.size, "new notification") %> since your last digest.
+</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+  <%= tag.hr class: "notification__board-separator" unless index.zero? %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <p class="notification__author"><%= notification.creator.name %></p>
+      <p class="card__title"><%= link_to notification.payload.title, notification.payload.url %></p>
+      <p class="notification__details"><%= notification.payload.body %></p>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="margin-block-start-double"><%= link_to "See all your notifications", notifications_url %></p>
+
+<p class="footer">
+  You're receiving this digest because your email frequency is set to &ldquo;<%= @user.bundle_email_frequency.to_s.humanize %>&rdquo;.
+  <%= link_to "Change your notification settings", notifications_settings_url %>.
+</p>
