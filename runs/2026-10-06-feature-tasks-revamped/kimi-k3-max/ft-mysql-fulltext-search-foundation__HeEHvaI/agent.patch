diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4f65dcb
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:shipping).update! description: "Deploy the app carefully"
+
+    get search_path, params: { q: "logo" }
+    assert_select ".search-result", /logo isn.t big enough/
+
+    get search_path, params: { q: "carefully" }
+    assert_select ".search-result", /ship the app/
+
+    get search_path, params: { q: "overflowing" }
+    assert_select ".search-result", /Layout is broken/
+  end
+
+  test "matched words are wrapped in mark" do
+    get search_path, params: { q: "logo" }
+    assert_select ".search-result__title mark", "logo"
+  end
+
+  test "matched comment and description excerpts are wrapped in mark" do
+    cards(:shipping).update! description: "Deploy the app carefully"
+
+    get search_path, params: { q: "carefully" }
+    assert_select ".search-result__snippet mark", "carefully"
+
+    get search_path, params: { q: "overflowing" }
+    assert_select ".search-result__snippet mark", "overflowing"
+  end
+
+  test "results are ordered newest first" do
+    boards(:writebook).cards.create! title: "zebra stripes old", creator: users(:kevin), status: :published, created_at: 2.days.ago
+    boards(:writebook).cards.create! title: "zebra stripes new", creator: users(:kevin), status: :published, created_at: 1.hour.ago
+
+    get search_path, params: { q: "zebra" }
+    assert_equal [ "zebra stripes new", "zebra stripes old" ], css_select(".search-result__title").map { |element| element.text.strip }
+  end
+
+  test "results only include cards from boards the user can access" do
+    boards(:private).cards.create! title: "Secret plans", creator: users(:kevin), status: :published
+
+    get search_path, params: { q: "Secret" }
+    assert_select ".search-result", 1
+
+    logout_and_sign_in_as :david
+    get search_path, params: { q: "Secret" }
+    assert_select ".search-result", 0
+  end
+
+  test "revoked board access removes cards from results" do
+    get search_path, params: { q: "logo" }
+    assert_select ".search-result", 1
+
+    accesses(:writebook_kevin).destroy!
+    get search_path, params: { q: "logo" }
+    assert_select ".search-result", 0
+  end
+
+  test "results never include draft cards or their comments" do
+    card = boards(:writebook).cards.create! title: "Unpublished marsupials", creator: users(:kevin), status: :published
+    card.comments.create! body: "wombats everywhere"
+    card.update! status: :drafted
+
+    get search_path, params: { q: "marsupials" }
+    assert_select ".search-result", 0
+
+    get search_path, params: { q: "wombats" }
+    assert_select ".search-result", 0
+  end
+
+  test "results do not include cards from other accounts" do
+    get search_path, params: { q: "paycheck" }
+    assert_select ".search-result", 0
+  end
+
+  test "blank query shows no results" do
+    get search_path, params: { q: "  " }
+    assert_response :success
+    assert_select ".search-result", 0
+    assert_select ".search .blank-slate", 0
+  end
+
+  test "query with no matches shows a blank slate" do
+    get search_path, params: { q: "nonexistent" }
+    assert_response :success
+    assert_select ".search-result", 0
+    assert_select ".search .blank-slate", 1
+  end
+
+  test "query with html is escaped and does not inject" do
+    get search_path, params: { q: "<script>alert(1)</script>" }
+    assert_response :success
+    assert_not_includes response.body, "<script>alert(1)</script>"
+    assert_select ".search-result", 0
+  end
+
+  test "matched content is sanitized before marking" do
+    boards(:writebook).cards.create! title: "Fix <script>alert(1)</script>bold rendering", creator: users(:kevin), status: :published
+
+    get search_path, params: { q: "bold" }
+    assert_response :success
+    assert_select ".search-result__title mark", "bold"
+    assert_not_includes response.body, "<script>alert(1)</script>"
+  end
+
+  test "query with LIKE wildcards is treated literally" do
+    boards(:writebook).cards.create! title: "Progress at 100% now", creator: users(:kevin), status: :published
+
+    get search_path, params: { q: "100%" }
+    assert_select ".search-result", 1
+    assert_select ".search-result__title mark", "100%"
+
+    get search_path, params: { q: "___" }
+    assert_select ".search-result", 0
+  end
+
+  test "query with regex characters is treated literally" do
+    boards(:writebook).cards.create! title: "Pricing is $100 (plus tax)", creator: users(:kevin), status: :published
+
+    get search_path, params: { q: "$100 (plus" }
+    assert_select ".search-result", 1
+    assert_select ".search-result__title mark", "$100 (plus"
+  end
+
+  test "multiple matches across cards each get marks" do
+    get search_path, params: { q: "text" }
+    assert_select ".search-result__title mark", text: "text", minimum: 1
+  end
+
+  test "match in long comment is excerpted with mark" do
+    card = cards(:shipping)
+    card.comments.create! body: "#{'filler words galore ' * 50} hidden needle deep inside"
+
+    get search_path, params: { q: "needle" }
+    assert_select ".search-result__snippet mark", "needle"
+  end
+
+  test "user with no board access sees no results" do
+    Access.where(user: users(:kevin)).destroy_all
+
+    get search_path, params: { q: "logo" }
+    assert_response :success
+    assert_select ".search-result", 0
+  end
+
+  test "search page links to found cards" do
+    get search_path, params: { q: "logo" }
+    assert_select ".search-result__title[href=?]", card_path(cards(:logo))
+  end
+
+  test "multi word queries match phrases" do
+    get search_path, params: { q: "too small" }
+    assert_select ".search-result", /text is too small/
+    assert_select ".search-result__title mark", "too small"
+  end
+
+  test "search form preserves the query" do
+    get search_path, params: { q: "logo" }
+    assert_select "input[name=q][value=logo]"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..7fab669
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:shipping).update! description: "Deploy the app carefully"
+
+    assert_includes search("logo"), cards(:logo)
+    assert_includes search("carefully"), cards(:shipping)
+    assert_includes search("overflowing"), cards(:layout)
+  end
+
+  test "matches are case insensitive" do
+    assert_includes search("LOGO"), cards(:logo)
+  end
+
+  test "results are newest first" do
+    old_card = boards(:writebook).cards.create! title: "zebra old", creator: @user, status: :published, created_at: 2.days.ago
+    new_card = boards(:writebook).cards.create! title: "zebra new", creator: @user, status: :published, created_at: 1.hour.ago
+
+    assert_equal [ new_card, old_card ], search("zebra")
+  end
+
+  test "only finds cards on boards the user can access" do
+    inaccessible_card = boards(:private).cards.create! title: "Secret plans", creator: @user, status: :published
+
+    assert_includes search("Secret"), inaccessible_card
+    assert_not_includes Search.new(user: users(:david), query: "Secret").results.map(&:card), inaccessible_card
+  end
+
+  test "never finds draft cards or their comments" do
+    card = boards(:writebook).cards.create! title: "Unpublished marsupials", creator: @user, status: :published
+    card.comments.create! body: "wombats everywhere"
+    card.update! status: :drafted
+
+    assert_empty search("marsupials")
+    assert_empty search("wombats")
+  end
+
+  test "ignores matches that only appear in rich text markup" do
+    cards(:logo).update! description: "Nothing to see here"
+
+    assert_empty search("action-text-content")
+  end
+
+  test "blank queries are invalid and return no results" do
+    [ nil, "", "  " ].each do |query|
+      search = Search.new(user: @user, query: query)
+      assert_not search.valid?
+      assert_empty search.results
+    end
+  end
+
+  test "result knows what matched" do
+    cards(:shipping).update! description: "Deploy the app carefully"
+
+    by_title = Search.new(user: @user, query: "logo").results.find { |result| result.card == cards(:logo) }
+    assert by_title.title_matches?
+    assert_not by_title.description_matches?
+    assert_empty by_title.matching_comments
+
+    by_description = Search.new(user: @user, query: "carefully").results.first
+    assert_not by_description.title_matches?
+    assert by_description.description_matches?
+
+    by_comment = Search.new(user: @user, query: "overflowing").results.first
+    assert_equal [ comments(:layout_overflowing_david) ], by_comment.matching_comments
+  end
+
+  test "queries with LIKE wildcards and escape characters are treated literally" do
+    percent = boards(:writebook).cards.create! title: "Progress at 100%!", creator: @user, status: :published
+    backslash = boards(:writebook).cards.create! title: "Edit C:\\temp\\notes.txt", creator: @user, status: :published
+
+    assert_equal [ percent ], search("100%!")
+    assert_equal [ backslash ], search("C:\\temp")
+    assert_empty search("___")
+  end
+
+  private
+    def search(query)
+      Search.new(user: @user, query: query).results.map(&:card)
+    end
+end
