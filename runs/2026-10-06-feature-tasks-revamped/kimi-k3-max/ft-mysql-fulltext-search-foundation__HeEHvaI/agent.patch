+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,14 @@
+<li class="search-result flex flex-column gap-half">
+  <div class="flex align-center gap-half">
+    <%= link_to highlight(result.title, result.query), result.card, class: "search-result__title txt-medium" %>
+    <span class="txt-small txt-subtle txt-nowrap">in <%= result.board.name %></span>
+  </div>
+
+  <% if result.description_matches? %>
+    <p class="search-result__snippet margin-none"><%= highlight(excerpt(result.description, result.query), result.query) %></p>
+  <% end %>
+
+  <% result.matching_comments.each do |comment| %>
+    <p class="search-result__snippet margin-none"><%= highlight(excerpt(comment.body.to_plain_text, result.query), result.query) %></p>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..903565d
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="search panel panel--wide flex flex-column gap margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap-half" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards by title, description, or comment…", class: "input input--transparent full-width", autofocus: true, autocomplete: "off" %>
+    <%= form.button class: "btn btn--reversed", title: "Search" do %>
+      <%= icon_tag "search" %> <span class="for-screen-reader">Search</span>
+    <% end %>
+  <% end %>
+
+  <% if @search.valid? %>
+    <% if @search.results.any? %>
+      <ul class="search__results flex flex-column gap margin-none">
+        <%= render partial: "searches/result", collection: @search.results %>
+      </ul>
+    <% else %>
+      <div class="blank-slate">No cards found for “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</div>
