diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..3e192c0
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,58 @@
+class Search
+  # Matches the query against card titles, descriptions, and comment bodies.
+  # The LIKE prefilter narrows candidates in SQL; Search::Result then verifies
+  # each candidate against plain text so matches hidden inside rich-text markup
+  # don't produce phantom results.
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  MATCH_SQL = <<~SQL.squish
+    cards.title LIKE :like ESCAPE '!'
+    OR EXISTS (
+      SELECT 1 FROM action_text_rich_texts card_description
+      WHERE card_description.record_type = 'Card'
+        AND card_description.record_id = cards.id
+        AND card_description.name = 'description'
+        AND card_description.body LIKE :like ESCAPE '!'
+    )
+    OR EXISTS (
+      SELECT 1 FROM comments
+      INNER JOIN action_text_rich_texts comment_body
+        ON comment_body.record_type = 'Comment'
+        AND comment_body.record_id = comments.id
+        AND comment_body.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND comment_body.body LIKE :like ESCAPE '!'
+    )
+  SQL
+
+  attr_reader :user, :query
+
+  def initialize(user:, query:)
+    @user = user
+    @query = query.to_s.strip
+  end
+
+  def results
+    @results ||= if valid?
+      matching_cards.map { |card| Result.new(card: card, query: query) }.select(&:matches?)
+    else
+      []
+    end
+  end
+
+  def valid?
+    query.present?
+  end
+
+  private
+    def matching_cards
+      user.accessible_cards.published
+        .where(MATCH_SQL, like: like)
+        .reverse_chronologically
+        .includes(:board, :rich_text_description, comments: :rich_text_body)
+    end
+
+    def like
+      "%#{ActiveRecord::Base.sanitize_sql_like(query, LIKE_ESCAPE_CHARACTER)}%"
+    end
+end
diff --git a/app/models/search/result.rb b/app/models/search/result.rb
new file mode 100644
index 0000000..b653408
--- /dev/null
+++ b/app/models/search/result.rb
@@ -0,0 +1,43 @@
+class Search::Result
+  attr_reader :card, :query
+
+  delegate :board, :title, to: :card
+
+  def initialize(card:, query:)
+    @card = card
+    @query = query
+  end
+
+  def matches?
+    title_matches? || description_matches? || matching_comments.any?
+  end
+
+  def title_matches?
+    matched? title
+  end
+
+  def description
+    card.description.to_plain_text if card.description?
+  end
+
+  def description_matches?
+    matched? description
+  end
+
+  def matching_comments
+    @matching_comments ||= card.comments.select { |comment| matched? plain_text_of(comment) }.sort_by(&:created_at)
+  end
+
+  private
+    def matched?(text)
+      text.to_s.match? pattern
+    end
+
+    def plain_text_of(comment)
+      comment.body.to_plain_text if comment.body?
+    end
+
+    def pattern
+      @pattern ||= /#{Regexp.escape(query)}/i
+    end
+end
diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
