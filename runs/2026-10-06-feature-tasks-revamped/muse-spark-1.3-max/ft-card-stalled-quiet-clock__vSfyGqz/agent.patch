diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..c9e4c8b
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,47 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+  BURST_COMMENTS_THRESHOLD = 3
+  BURST_PEOPLE_THRESHOLD = 2
+
+  included do
+    scope :bursted, -> { where.not(burst_at: nil) }
+    scope :stalled, -> { active.bursted.where(last_active_at: ..STALLED_INACTIVITY_PERIOD.ago) }
+  end
+
+  def stalled?
+    bursted? && active? && last_active_at.present? && last_active_at <= STALLED_INACTIVITY_PERIOD.ago
+  end
+
+  def bursted?
+    burst_at.present?
+  end
+  alias_method :burst?, :bursted?
+  alias_method :has_burst?, :bursted?
+
+  def burst!
+    update!(burst_at: Time.current)
+  end
+
+  def burst_window
+    auto_postpone_period.to_f / 3
+  end
+
+  def check_comment_burst!(triggering_comment:)
+    return if triggering_comment.creator.system?
+    return unless triggering_comment.created_at
+
+    window = burst_window
+    return if window.nil? || window <= 0
+
+    end_time = triggering_comment.created_at
+    start_time = end_time - window
+
+    recent = comments.by_user.where(created_at: start_time..end_time)
+
+    if recent.count >= BURST_COMMENTS_THRESHOLD && recent.distinct.count(:creator_id) >= BURST_PEOPLE_THRESHOLD
+      burst!
+    end
+  end
+end
