@@ -0,0 +1,22 @@
+class ExportsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  # Global download via signed_id (expires in 1 day, no auth required)
+  # GET /exports/:signed_id
+  def show
+    @export = Export.find_by_download_id(params[:signed_id] || params[:id])
+
+    unless @export
+      render plain: "This download link is invalid or has expired. Links expire after 24 hours — please request a new export.", status: :not_found and return
+    end
+
+    unless @export.completed? && @export.file.attached?
+      render plain: @export.failed? ? "Export failed: #{@export.error_message}" : "Export is still being prepared.", status: :accepted and return
+    end
+
+    filename = @export.file.filename.to_s.presence || "export.zip"
+    data = @export.file.download
+    send_data data, filename: filename, type: "application/zip", disposition: "attachment"
+  end
+end
