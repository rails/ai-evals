new file mode 100644
index 0000000..7db1e66
--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,16 @@
+class ImportJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    import.perform!
+  rescue => error
+    # perform! already handles status update and failure email, re-raise? No, swallow to avoid retry?
+    # For import failures due to invalid data, we don't want to retry (would send duplicate emails).
+    # So swallow the error after handling. But for transient errors, retry might be desired.
+    # To distinguish, check if import failed? If failed, don't re-raise (already handled).
+    # If import is still pending (unexpected error before status update), re-raise for retry?
+    raise error unless import.failed?
+  end
+end
