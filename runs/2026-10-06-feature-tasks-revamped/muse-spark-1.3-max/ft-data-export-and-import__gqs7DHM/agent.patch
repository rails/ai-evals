+require "test_helper"
+
+class ExportImportControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin  # admin in 37s
+  end
+
+  test "account settings page contains export button for admin" do
+    get account_settings_path
+    assert_response :success
+    assert_select "form[action=?]", account_exports_path
+    assert_match /Export account/, response.body
+    assert_select "a[href=?]", new_account_import_path
+  end
+
+  test "non-admin cannot create account export" do
+    logout_and_sign_in_as :david  # member
+    post account_exports_path
+    assert_response :forbidden
+  end
+
+  test "admin can create account export" do
+    assert_enqueued_jobs 1, only: ExportJob do
+      post account_exports_path
+    end
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+  end
+
+  test "user profile page contains export button for own profile" do
+    kevin = users(:kevin)
+    get user_path(kevin)
+    assert_response :success
+    assert_match /Export my cards/, response.body
+  end
+
+  test "user can export own cards" do
+    david = users(:david)
+    logout_and_sign_in_as :david
+    assert_enqueued_jobs 1, only: ExportJob do
+      post user_exports_path(david)
+    end
+    assert_redirected_to user_path(david)
+  end
+
+  test "user cannot export another user's cards unless admin" do
+    logout_and_sign_in_as :david
+    kevin = users(:kevin)
+    post user_exports_path(kevin)
+    assert_response :forbidden
+  end
+
+  test "admin can export another user's cards" do
+    david = users(:david)
+    post user_exports_path(david)
+    assert_redirected_to user_path(david)
+  end
+
+  test "imports new page accessible when signed in" do
+    get new_account_import_path
+    assert_response :success
+    assert_select "form[action=?]", account_imports_path
+  end
+
+  test "global download with valid signed_id serves file" do
+    # Create export and generate file synchronously
+    account = accounts("37s")
+    user = users(:kevin)
+    Current.with(account: account) do
+      export = account.exports.create!(user: user, kind: "account")
+      export.generate!
+      assert export.completed?
+
+      # Test download via signed_id (unauthenticated, no account scope)
+      untenanted do
+        cookies.delete :session_token
+        get export_download_path(export.download_id)
+        assert_response :success
+        assert_equal "application/zip", response.content_type
+      end
+    end
+  end
+
+  test "global download with expired signed_id returns not found" do
+    account = accounts("37s")
+    user = users(:kevin)
+    Current.with(account: account) do
+      export = account.exports.create!(user: user, kind: "account")
+      export.generate!
+      download_id = export.download_id
+      travel_to 2.days.from_now do
+        untenanted do
+          cookies.delete :session_token
+          get export_download_path(download_id)
+          assert_response :not_found
+        end
+      end
+    end
+  end
+end
