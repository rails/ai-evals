@@ -0,0 +1,74 @@
+require "test_helper"
+
+class ImportFlowTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    clear_enqueued_jobs
+    clear_performed_jobs
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "full import flow creates new account" do
+    account = accounts("37s")
+    user = users(:kevin)
+    export = nil
+    Current.with(account: account) do
+      export = account.exports.create!(user: user, kind: "account")
+      # Generate synchronously but clear its mail job (we want to test import mail, not export mail)
+      clear_enqueued_jobs
+      export.generate!
+      clear_enqueued_jobs
+      ActionMailer::Base.deliveries.clear
+    end
+    assert export.completed?
+
+    export.file.blob.open do |tmp|
+      upload_tmp = Tempfile.new([ "import", ".zip" ])
+      FileUtils.cp(tmp.path, upload_tmp.path)
+      upload_tmp.rewind
+
+      assert_enqueued_jobs 1, only: ImportJob do
+        post account_imports_path, params: { import: { file: fixture_file_upload(upload_tmp.path, "application/zip") } }
+      end
+      assert_response :redirect
+      import = Import.last
+      assert_equal "pending", import.status
+
+      perform_enqueued_jobs(only: ImportJob)
+      import.reload
+      assert_equal "completed", import.status, "Import failed: #{import.error_message}"
+      assert_not_nil import.new_account
+      assert_equal account.name, import.new_account.name
+      assert_equal account.boards.count, import.new_account.boards.count
+      assert_equal account.cards.count, import.new_account.cards.count
+
+      # Perform mail jobs for import completion
+      perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob)
+      assert ActionMailer::Base.deliveries.any? { |m| m.subject == "Your Fizzy import is complete" }, "Expected completion email, got: #{ActionMailer::Base.deliveries.map(&:subject)}"
+
+      upload_tmp.close
+    end
+  end
+
+  test "import with invalid file fails gracefully and leaves nothing" do
+    count_before = Account.count
+    tmp = Tempfile.new([ "bad", ".zip" ])
+    tmp.write("not a zip")
+    tmp.rewind
+
+    post account_imports_path, params: { import: { file: fixture_file_upload(tmp.path, "application/zip") } }
+    assert_response :redirect
+    import = Import.last
+
+    perform_enqueued_jobs(only: ImportJob)
+    import.reload
+    assert_equal "failed", import.status
+    assert_not_nil import.error_message
+    assert_equal count_before, Account.count, "Failed import should leave nothing behind"
+
+    perform_enqueued_jobs(only: ActionMailer::MailDeliveryJob)
+    assert ActionMailer::Base.deliveries.any? { |m| m.subject == "Your Fizzy import failed" }
+
+    tmp.close
+  end
+end
