index 0000000..e8e81b2
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,48 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    @export = Current.account.exports.create!(
+      user: Current.user,
+      kind: "account",
+      status: "pending"
+    )
+
+    ExportJob.perform_later(@export)
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+    end
+  end
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+
+    unless can_download?(@export)
+      head :forbidden and return
+    end
+
+    unless @export.completed? && @export.file.attached?
+      respond_to do |format|
+        format.html { redirect_to account_settings_path, alert: @export.failed? ? "Export failed: #{@export.error_message}" : "Export is still being prepared." }
+        format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+      end
+      return
+    end
+
+    # Serve file directly to avoid ActiveStorage auth issues
+    send_export_file(@export)
+  end
+
+  private
+    def can_download?(export)
+      Current.user.admin? || export.user == Current.user
+    end
+
+    def send_export_file(export)
+      filename = export.file.filename.to_s.presence || "export.zip"
+      data = export.file.download
+      send_data data, filename: filename, type: "application/zip", disposition: "attachment"
+    end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..9f0ef25
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,84 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.new
+  end
+
+  def create
+    uploaded = import_params[:file]
+
+    unless uploaded
+      respond_to do |format|
+        format.html do
+          @import = Current.account.imports.new
+          flash.now[:alert] = "Please choose a file to import."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "Please choose a file to import." }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    @import = Current.account.imports.create!(
+      user: Current.user,
+      status: "pending",
+      original_filename: uploaded.original_filename
+    )
+    @import.file.attach(uploaded)
+
+    ImportJob.perform_later(@import)
+
+    respond_to do |format|
+      format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. We'll email you when it's done." }
+      format.json { render json: { id: @import.id, status: @import.status }, status: :accepted }
+    end
+  rescue => error
+    Rails.logger.error "Import creation failed: #{error.message}"
+    respond_to do |format|
+      format.html do
+        @import ||= Current.account.imports.new
+        flash.now[:alert] = "Couldn't start import: #{error.message}"
+        render :new, status: :unprocessable_entity
+      end
+      format.json { render json: { error: error.message }, status: :unprocessable_entity }
+    end
+  end
+
+  def show
+    @import = Current.account.imports.find(params[:id])
+
+    unless can_view?(@import)
+      head :forbidden and return
+    end
+
+    respond_to do |format|
+      format.html
+      format.json do
+        render json: {
+          id: @import.id,
+          status: @import.status,
+          error_message: @import.error_message,
+          new_account_id: @import.new_account_id,
+          new_account_slug: @import.new_account&.slug
+        }
+      end
+    end
+  end
+
+  private
+    def import_params
+      params.expect(import: [ :file ])
+    rescue
+      # Fallback for direct file param or different nesting
+      if params[:file]
+        { file: params[:file] }
+      elsif params[:import] && params[:import][:file]
+        { file: params[:import][:file] }
+      else
+        {}
+      end
+    end
+
+    def can_view?(import)
+      import.user == Current.user || Current.user.admin?
+    end
+end
