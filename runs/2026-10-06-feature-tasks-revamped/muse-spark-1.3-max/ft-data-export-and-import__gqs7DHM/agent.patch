diff --git a/app/views/account/imports/show.html.erb b/app/views/account/imports/show.html.erb
new file mode 100644
index 0000000..78dd473
--- /dev/null
+++ b/app/views/account/imports/show.html.erb
@@ -0,0 +1,31 @@
+<% @page_title = "Import status" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Import status</h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <% if @import.completed? %>
+        <h2 class="divider">Import complete</h2>
+        <p>Your new account is ready with all your boards, cards, comments, files, and people.</p>
+        <% if @import.new_account %>
+          <p><%= link_to "Open your new account: #{@import.new_account.name}", root_path(script_name: @import.new_account.slug), class: "btn btn--primary" %></p>
+        <% end %>
+      <% elsif @import.failed? %>
+        <h2 class="divider">Import failed</h2>
+        <p>We couldn't complete your import. Nothing was imported — no new account was created.</p>
+        <% if @import.error_message.present? %>
+          <p><strong>Why it failed:</strong></p>
+          <p class="txt-small"><%= @import.error_message %></p>
+        <% end %>
+        <p><%= link_to "Try again", new_account_import_path, class: "btn" %></p>
+      <% else %>
+        <h2 class="divider">Import in progress</h2>
+        <p>Your import is being processed. We'll email you when it's done — or when it failed and why.</p>
+        <p class="txt-small txt-tinted">You can leave this page; we'll email you at <%= Current.user.identity.email_address %>.</p>
+      <% end %>
+    </section>
+  </div>
+</div>
