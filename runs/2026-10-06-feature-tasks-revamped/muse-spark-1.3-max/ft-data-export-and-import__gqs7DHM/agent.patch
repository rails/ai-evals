+class Users::ExportsController < ApplicationController
+  before_action :set_user
+
+  def create
+    unless can_export?(@user)
+      head :forbidden and return
+    end
+
+    # For user exports, kind is "cards" (cards visible to the user)
+    @export = Current.account.exports.create!(
+      user: @user,
+      kind: "cards",
+      status: "pending"
+    )
+
+    ExportJob.perform_later(@export)
+
+    respond_to do |format|
+      format.html { redirect_to user_path(@user), notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+    end
+  end
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+
+    unless can_download?(@export)
+      head :forbidden and return
+    end
+
+    unless @export.completed? && @export.file.attached?
+      respond_to do |format|
+        format.html { redirect_to user_path(@user), alert: @export.failed? ? "Export failed: #{@export.error_message}" : "Export is still being prepared." }
+        format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+      end
+      return
+    end
+
+    send_export_file(@export)
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def can_export?(target_user)
+      Current.user == target_user || Current.user.admin?
+    end
