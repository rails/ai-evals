diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..00b01b2 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,58 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...Account::Incineratable::INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    account_id = id
+    board_ids = boards.ids
+
+    destroy!
+    purge_remaining_data(account_id, board_ids)
+  end
+
+  def incineration_due?
+    if cancelled?
+      cancellation.created_at < Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+    else
+      false
+    end
+  end
+
+  private
+    def purge_remaining_data(account_id, board_ids)
+      delete_remaining_attachments(account_id)
+      purge_remaining_blobs(account_id)
+      delete_remaining_records(account_id, board_ids)
+    end
+
+    def delete_remaining_attachments(account_id)
+      ActiveStorage::Attachment.where(account_id: account_id).delete_all
+      ActiveStorage::VariantRecord.where(account_id: account_id).delete_all
+    end
+
+    def purge_remaining_blobs(account_id)
+      ActiveStorage::Blob.where(account_id: account_id).find_each(&:purge)
+    end
+
+    def delete_remaining_records(account_id, board_ids)
+      Storage::Entry.where(account_id: account_id).delete_all
+      ActionText::RichText.where(account_id: account_id).delete_all
+      Search::Record.for(account_id).where(account_id: account_id).find_each(&:destroy)
+      Storage::Total.where(owner_type: "Account", owner_id: account_id).delete_all
+
+      if board_ids.any?
+        Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+      end
+    end
 end
