+    def auto_postpone_all_due(now = Time.current)
+      groups = boards_by_account_and_period
+      return if groups.empty?
+
+      account_ids = groups.keys.map(&:first).uniq
+      system_users_by_account_id = User.where(account_id: account_ids, role: :system).index_by(&:account_id)
+
+      groups.each do |(account_id, period), board_ids|
+        cutoff = now - period
+        system_user = system_users_by_account_id[account_id] ||= Account.find(account_id).system_user
+
+        board_ids.each_slice(1000) do |board_id_slice|
+          active
+            .where(account_id: account_id, board_id: board_id_slice)
+            .where("cards.last_active_at <= ?", cutoff)
+            .find_each do |card|
+              card.auto_postpone(user: system_user)
+            end
+        end
+      end
+    end
+
+    def boards_by_account_and_period
+      rows = Board
+        .left_outer_joins(:entropy)
+        .joins(:account)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+        .pluck("boards.account_id", "boards.id", Arel.sql("COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period)"))
+
+      default_period = Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+
+      rows.each_with_object({}) do |(account_id, board_id, period), groups|
+        period ||= default_period
+        key = [ account_id, period ]
+        groups[key] ||= []
+        groups[key] << board_id
       end
     end
+
+    def by_auto_postpone_window(now)
+      groups = boards_by_account_and_period
+      return none if groups.empty?
+
+      combined = nil
+
+      groups.each do |(account_id, period), board_ids|
+        lower, upper = yield(period)
+
+        board_ids.each_slice(1000) do |board_id_slice|
+          scope = active.where(account_id: account_id, board_id: board_id_slice)
+
+          if lower && upper
+            scope = scope.where("cards.last_active_at > ? AND cards.last_active_at <= ?", lower, upper)
+          elsif upper
+            scope = scope.where("cards.last_active_at <= ?", upper)
+          end
+
+          if combined
+            combined = combined.or(scope)
+          else
+            combined = scope
+          end
+        end
+      end
+
+      combined
+    end
