diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..9cb2f6f
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,42 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    events = Event
+      .preloaded
+      .where(board: Current.user.boards)
+      .where(action: TIMELINEABLE_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+
+    events = events.where(creator_id: creator_ids) if creator_ids.any?
+    events = events.where(board_id: board_ids) if board_ids.any?
+
+    set_page_and_extract_portion_from(events)
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..f5ddfd8
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,39 @@
+json.(activity, :id, :action, :eventable_type)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+json.url polymorphic_url(activity.eventable)
+
+json.eventable do
+  case activity.eventable
+  when Card then json.partial! "cards/card", card: activity.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: activity.eventable
+  end
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
+
+particulars_data = (activity.particulars || {}).with_indifferent_access
+nested = particulars_data[:particulars]
+nested = nested.with_indifferent_access if nested.is_a?(Hash)
+nested ||= {}.with_indifferent_access
+
+particulars = case activity.action.to_s
+when "card_assigned", "card_unassigned"
+  ids = activity.assignee_ids.presence || particulars_data[:assignee_ids].presence || nested[:assignee_ids].presence || []
+  { assignee_ids: Array(ids) }
+when "card_board_changed"
+  old_board = nested[:old_board].presence || nested[:old_collection].presence || particulars_data[:old_board].presence || particulars_data[:old_collection].presence || ""
+  new_board = nested[:new_board].presence || nested[:new_collection].presence || particulars_data[:new_board].presence || particulars_data[:new_collection].presence || ""
+  { old_board: old_board, new_board: new_board }
+when "card_title_changed"
+  old_title = nested[:old_title].presence || particulars_data[:old_title].presence || ""
+  new_title = nested[:new_title].presence || particulars_data[:new_title].presence || ""
+  { old_title: old_title, new_title: new_title }
+when "card_triaged"
+  column = nested[:column].presence || particulars_data[:column].presence || ""
+  { column: column }
+else
+  {}
+end
+json.particulars particulars
