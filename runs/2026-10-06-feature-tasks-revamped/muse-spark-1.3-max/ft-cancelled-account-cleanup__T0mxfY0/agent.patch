diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..aa321fc 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,47 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...Account::Incineratable::INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    account_id = id
+    destroy!
+    # Cleanup any account-scoped data not covered by dependent: :destroy.
+    # Most associations cascade via destroy!, but async purges (ActiveStorage)
+    # and ledger tables need synchronous cleanup to guarantee full removal.
+    Storage::Entry.where(account_id: account_id).delete_all
+    Search::Query.where(account_id: account_id).delete_all
+    ActionText::RichText.where(account_id: account_id).delete_all
+    ActiveStorage::Attachment.where(account_id: account_id).delete_all
+    ActiveStorage::VariantRecord.where(account_id: account_id).delete_all
+    ActiveStorage::Blob.where(account_id: account_id).find_each do |blob|
+      begin
+        blob.service.delete(blob.key)
+      rescue
+        nil
+      ensure
+        blob.delete
+      end
+    end
+    begin
+      Search::Record.for(account_id).where(account_id: account_id).find_each(&:destroy)
+    rescue
+      nil
+    end
+  end
+
+  def incinerate_due?
+    cancelled? && cancellation.created_at < Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+  end
+  alias_method :due_for_incineration?, :incinerate_due?
 end
