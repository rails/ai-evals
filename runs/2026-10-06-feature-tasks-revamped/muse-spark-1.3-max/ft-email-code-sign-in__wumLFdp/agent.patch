+
+    def clear_pending_email_address
+      session.delete(:signup_verification_email)
+    end
+
+    def set_development_code
+      if Rails.env.development? && @email_address.present?
+        @code = VerificationCode.active.for_email(@email_address).order(created_at: :desc).first&.code
+      end
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_signup_path, alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
