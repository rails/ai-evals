+class Signups::VerificationsController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = pending_email_address
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      @signup = Signup.new(email_address: @email_address)
+      set_development_code
+    end
+  end
+
+  def create
+    email_address = verification_email_address
+    code = params[:code].to_s
+
+    if email_address.present? && (record = VerificationCode.authenticate(email_address: email_address, code: code))
+      signup = Signup.new(email_address: record.email_address)
+      signup.create_identity
+      start_new_session_for signup.identity
+      clear_pending_email_address
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          @email_address = email_address
+          @signup = Signup.new(email_address: email_address)
+          set_development_code
+          flash.now[:alert] = "That code didn't work. Try again."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+
+    def pending_email_address
+      params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:signup_verification_email]
+    end
+
+    def verification_email_address
+      params[:email_address].presence || params.dig(:signup, :email_address).presence || session[:signup_verification_email]
