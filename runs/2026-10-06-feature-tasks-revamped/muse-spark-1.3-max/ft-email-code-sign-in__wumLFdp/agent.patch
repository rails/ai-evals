+class JoinCodes::VerificationsController < ApplicationController
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = pending_email_address
+
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code)
+    else
+      set_development_code
+    end
+  end
+
+  def create
+    email_address = verification_email_address
+    code = params[:code].to_s
+
+    if email_address.present? && (record = VerificationCode.authenticate(email_address: email_address, code: code))
+      identity = Identity.find_or_create_by!(email_address: record.email_address)
+      clear_pending_email_address
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      start_new_session_for identity
+
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          @email_address = email_address
+          set_development_code
+          flash.now[:alert] = "That code didn't work. Try again."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: params.expect(:join_code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def pending_email_address
+      params[:email_address].presence || session[:join_verification_email]
+    end
+
+    def verification_email_address
+      params[:email_address].presence || session[:join_verification_email]
+    end
+
+    def clear_pending_email_address
+      session.delete(:join_verification_email)
+    end
+
+    def set_development_code
+      if Rails.env.development? && @email_address.present?
+        @code = VerificationCode.active.for_email(@email_address).order(created_at: :desc).first&.code
+      end
+    end
+end
