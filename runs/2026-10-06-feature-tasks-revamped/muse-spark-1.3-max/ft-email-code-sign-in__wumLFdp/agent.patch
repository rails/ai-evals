diff --git a/app/models/verification_code.rb b/app/models/verification_code.rb
new file mode 100644
index 0000000..1dd9b99
--- /dev/null
+++ b/app/models/verification_code.rb
@@ -0,0 +1,58 @@
+class VerificationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true
+  validates :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :for_email, ->(email) { where(email_address: email.to_s.strip.downcase) }
+
+  class << self
+    def generate_for(email_address)
+      normalized_email = email_address.to_s.strip.downcase
+
+      where(email_address: normalized_email).delete_all
+
+      code = generate_code
+      record = create!(email_address: normalized_email, code: code, expires_at: LIFETIME.from_now)
+
+      Rails.logger.info "[VerificationCode] Verification code for #{normalized_email}: #{code}"
+
+      record
+    end
+
+    def authenticate(email_address:, code:)
+      normalized_email = email_address.to_s.strip.downcase
+      normalized_code = code.to_s.strip.upcase
+
+      if normalized_email.blank? || normalized_code.blank?
+        nil
+      else
+        record = active.for_email(normalized_email).find_by(code: normalized_code)
+
+        if record
+          where(email_address: normalized_email).delete_all
+          record
+        end
+      end
+    end
+
+    def valid_code?(email_address:, code:)
+      authenticate(email_address: email_address, code: code).present?
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+end
