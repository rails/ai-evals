   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +53,87 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def perform_delivery
+      fresh_webhook = Webhook.find_by(id: webhook_id)
+      fresh_event = Event.find_by(id: event_id)
+
+      if fresh_webhook.nil? || fresh_event.nil?
+        update!(state: "errored", response: { error: "not_found" })
+        return false
+      end
+
+      unless fresh_webhook.active?
+        update!(state: "errored", response: { error: "webhook_inactive" })
+        return false
+      end
+
+      begin
+        payload = build_payload(fresh_event)
+        timestamp = fresh_event.created_at.utc.iso8601
+        signature = OpenSSL::HMAC.hexdigest("SHA256", fresh_webhook.signing_secret, payload)
+
+        headers = {
+          "User-Agent" => USER_AGENT,
+          "Content-Type" => "application/json",
+          "X-Webhook-Signature" => signature,
+          "X-Webhook-Timestamp" => timestamp
+        }
+
+        request_data = { "headers" => headers }
+
+        uri = URI.parse(fresh_webhook.url)
+        resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+
+        if resolved_ip.nil?
+          update!(state: "errored", request: request_data, response: { error: "destination_unreachable" })
+          fresh_webhook.ensure_delinquency_tracker.record_failure
+          return false
+        end
+
+        http = Net::HTTP.new(uri.host, uri.port)
+        http.ipaddr = resolved_ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = 5
+        http.read_timeout = 10
+
+        http_request = Net::HTTP::Post.new(uri.request_uri, headers)
+        http_request.body = payload
+
+        http_response = http.request(http_request)
+        code = http_response.code.to_i
+
+        update!(state: "completed", request: request_data, response: { code: code })
+
+        if code.between?(200, 299)
+          fresh_webhook.ensure_delinquency_tracker.record_success
+          true
+        else
+          fresh_webhook.ensure_delinquency_tracker.record_failure
+          false
+        end
+      rescue => error
+        request_data ||= nil
+
+        begin
+          update!(state: "errored", request: request_data, response: { error: error.class.name.demodulize.underscore })
+        rescue
+          # If updating with request fails, try without
+          update!(state: "errored", response: { error: error.class.name.demodulize.underscore })
+        end
+
+        begin
+          fresh_webhook.ensure_delinquency_tracker.record_failure
+        rescue
+          # Tracker may be missing if webhook was deleted; ignore
+        end
+
+        false
+      end
+    end
+
+    def build_payload(event)
+      ApplicationController.render(template: "webhooks/event", formats: :json, assigns: { event: event })
+    end
 end
