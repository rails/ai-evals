diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..b9ca95f
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,30 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    if consecutive_failures_count != 0 || first_failure_at.present?
+      update!(consecutive_failures_count: 0, first_failure_at: nil)
+    end
+  end
+
+  def record_failure
+    with_lock do
+      failures = consecutive_failures_count.to_i + 1
+      first = first_failure_at || Time.current
+
+      update!(consecutive_failures_count: failures, first_failure_at: first)
+
+      if failures >= FAILURE_THRESHOLD && first <= FAILURE_WINDOW.ago
+        webhook.deactivate unless webhook.active == false
+      end
+    end
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
