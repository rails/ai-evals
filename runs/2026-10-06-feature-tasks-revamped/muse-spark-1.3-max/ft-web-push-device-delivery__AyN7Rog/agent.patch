diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..56bcf98
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,58 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_options
+      {
+        public_key: vapid_public_key,
+        private_key: vapid_private_key,
+        subject: vapid_subject
+      }
+    end
+
+    def vapid_subject
+      if ENV["VAPID_SUBJECT"].present?
+        ENV["VAPID_SUBJECT"]
+      elsif ENV["BASE_URL"].present?
+        ENV["BASE_URL"]
+      elsif ENV["MAILER_FROM_ADDRESS"].present?
+        "mailto:#{ENV["MAILER_FROM_ADDRESS"]}"
+      else
+        "mailto:support@fizzy.do"
+      end
+    end
+  end
+
+  def send_push(message)
+    return unless self.class.vapid_configured?
+
+    WebPush.payload_send(
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+end
+
+# Allow User::PushSubscription as an alias for namespaced lookups.
+User::PushSubscription = PushSubscription unless defined?(User::PushSubscription)
