diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..89f0aab
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,84 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes(subscription_params)
+
+    if subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: subscription.errors.full_messages.to_sentence }
+        format.json { render json: subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    if subscription = find_subscription
+      subscription.destroy
+
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+        format.json { head :no_content }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: "Subscription not found" }
+        format.json { head :not_found }
+      end
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      normalized = normalize_push_subscription_params
+      normalized.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    # Accept both our normalized push_subscription[endpoint, p256dh_key, auth_key]
+    # shape and the raw Web Push API shape { endpoint, keys: { p256dh, auth } }.
+    def normalize_push_subscription_params
+      params = self.params
+
+      if (keys = params.dig(:push_subscription, :keys)).present?
+        params[:push_subscription][:p256dh_key] ||= keys[:p256dh]
+        params[:push_subscription][:auth_key] ||= keys[:auth]
+      elsif params[:keys].present? && params[:push_subscription].blank?
+        params[:push_subscription] = {
+          endpoint: params[:endpoint],
+          p256dh_key: params.dig(:keys, :p256dh),
+          auth_key: params.dig(:keys, :auth)
+        }
+      end
+
+      params
+    end
+
+    def find_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id]) ||
+          @user.push_subscriptions.find_by(endpoint: params[:id]) ||
+          (@user.push_subscriptions.find_by(endpoint: params[:endpoint]) if params[:endpoint].present?)
+      elsif params[:endpoint].present?
+        @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+      elsif params.dig(:push_subscription, :endpoint).present?
+        @user.push_subscriptions.find_by(endpoint: params[:push_subscription][:endpoint])
+      end
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..52d517a
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,171 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details", "button" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async toggle(event) {
+    event?.preventDefault()
+
+    if (this.element.classList.contains("notifications--on")) {
+      await this.disable()
+    } else {
+      await this.enable()
+    }
+  }
+
+  async enable() {
+    if (!this.#supported) {
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#updateUI(false, permission)
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    }
+
+    await this.#saveSubscription(subscription)
+    this.#updateUI(true, permission)
+  }
+
+  async disable() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      const endpoint = subscription.endpoint
+
+      try {
+        await subscription.unsubscribe()
+      } catch (e) {
+        // Ignore unsubscribe errors, still remove server-side
+      }
+
+      await this.#deleteSubscription(endpoint)
+    }
+
+    this.#updateUI(false, Notification.permission)
+  }
+
+  async refresh() {
+    if (!this.#supported) {
+      this.#updateUI(false, "unsupported")
+      return
+    }
+
+    const permission = Notification.permission
+
+    if (permission !== "granted") {
+      this.#updateUI(false, permission)
+      return
+    }
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+      this.#updateUI(!!subscription, permission)
+    } catch (e) {
+      this.#updateUI(false, permission)
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    const body = {
+      push_subscription: {
+        endpoint: json.endpoint,
+        p256dh_key: json.keys.p256dh,
+        auth_key: json.keys.auth
+      }
+    }
+
+    const response = await fetch(this.subscriptionsUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: JSON.stringify(body)
+    })
+
+    if (!response.ok) {
+      throw new Error("Failed to save push subscription")
+    }
+  }
+
+  async #deleteSubscription(endpoint) {
+    const response = await fetch(this.subscriptionsUrlValue, {
+      method: "DELETE",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": this.#csrfToken
+      },
+      body: JSON.stringify({ endpoint: endpoint })
+    })
+
+    // 404 means already gone, treat as success
+    if (!response.ok && response.status !== 404) {
+      throw new Error("Failed to delete push subscription")
+    }
+  }
+
+  #updateUI(enabled, permission) {
+    this.element.classList.toggle("notifications--on", enabled)
+
+    if (this.hasButtonTarget) {
+      this.buttonTarget.textContent = enabled ? "Turn off push notifications" : "Turn on push notifications"
+      this.buttonTarget.setAttribute("aria-pressed", enabled.toString())
+    }
+
+    const blocked = permission === "denied"
+
+    this.detailsTargets.forEach((details) => {
+      details.hidden = !blocked
+    })
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    return this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  get #csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") || ""
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
