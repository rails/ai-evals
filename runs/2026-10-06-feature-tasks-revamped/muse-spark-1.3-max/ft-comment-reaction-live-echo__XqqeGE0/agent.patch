diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..be6eef2
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,78 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content emoji body text ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_creatorship, only: %i[ destroy ]
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(creator: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      content = reaction_content_param
+      { content: content }
+    end
+
+    def reaction_content_param
+      if params[:reaction].is_a?(ActionController::Parameters)
+        params[:reaction][:content].presence ||
+          params[:reaction][:emoji].presence ||
+          params[:reaction][:body].presence ||
+          params[:reaction][:text].presence
+      else
+        params[:content].presence ||
+          params[:emoji].presence ||
+          params[:body].presence ||
+          params[:text].presence
+      end
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..3ef6ceb
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,30 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.isOwnedByCurrentUser) {
+      this.element.classList.add("reaction--deleteable")
+    } else {
+      this.element.classList.remove("reaction--deleteable")
+    }
+  }
+
+  toggle(event) {
+    if (!this.isOwnedByCurrentUser) return
+    if (event.target.closest(".reaction__delete")) return
+    if (event.target.closest("a")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  prepareDelete() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get isOwnedByCurrentUser() {
+    const creatorId = this.element.dataset.creatorId
+    const currentUserId = window.Current?.user?.id
+
+    return creatorId && currentUserId && creatorId === currentUserId
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e27d6c7
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,43 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "formElement", "input", "list" ]
+
+  showForm(event) {
+    event?.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm(event) {
+    event?.preventDefault()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    if (this.hasFormElementTarget) this.formElementTarget.reset()
+    this.triggerTarget.focus({ preventScroll: true })
+  }
+
+  handleSubmit(event) {
+    if (!event.detail.success) return
+
+    if (this.hasFormElementTarget) this.formElementTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  pickEmoji(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    if (!emoji) return
+
+    this.inputTarget.value = emoji
+    this.inputTarget.focus()
+
+    if (this.hasFormElementTarget) {
+      this.formElementTarget.requestSubmit()
+    }
+  }
+}
