diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..c146631
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,71 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  has_one :card, through: :comment
+
+  alias_attribute :emoji, :content
+  alias_attribute :text, :content
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { includes(creator: [ :avatar_attachment, :account ]) }
+
+  before_validation :strip_content
+
+  after_create_commit :broadcast_reaction_created
+  after_create_commit :expire_comment_cache
+  after_destroy_commit :broadcast_reaction_destroyed
+  after_destroy_commit :expire_comment_cache
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  def user
+    creator
+  end
+
+  def user=(value)
+    self.creator = value
+  end
+
+  def body
+    content
+  end
+
+  def body=(value)
+    self.content = value
+  end
+
+  def owned_by?(user)
+    user.present? && creator_id == user.id
+  end
+
+  def emoji_only?
+    content.present? && content.match?(/\A(\p{Emoji}|\p{Emoji_Presentation}|\uFE0F|\u200D)+/u) && content.gsub(/[\p{Emoji}\p{Emoji_Presentation}\uFE0F\u200D\s]/u, "").blank?
+  rescue StandardError
+    false
+  end
+
+  private
+    def strip_content
+      self.content = content.to_s.strip.presence
+    end
+
+    def broadcast_reaction_created
+      broadcast_replace_to card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions), partial: "cards/comments/reactions/reactions", locals: { comment: comment }
+    end
+
+    def broadcast_reaction_destroyed
+      broadcast_replace_to card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions), partial: "cards/comments/reactions/reactions", locals: { comment: comment }
+    end
+
+    def expire_comment_cache
+      comment.update_columns(updated_at: Time.current) unless comment.destroyed?
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
