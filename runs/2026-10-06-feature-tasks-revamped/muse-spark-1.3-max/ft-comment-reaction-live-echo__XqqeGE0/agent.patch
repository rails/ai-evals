+<div class="reactions" id="<%= dom_id(comment, :reactions) %>" data-controller="reactions">
+  <div class="reactions__list" id="<%= dom_id(comment, :reactions_list) %>" data-reactions-target="list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.sort_by { |r| [ r.created_at, r.id ] }, as: :reaction %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle borderless" data-reactions-target="trigger" data-action="reactions#showForm" aria-label="Add reaction">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add reaction</span>
+  </button>
+
+  <div class="reaction reaction__form" data-reactions-target="form" hidden>
+    <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), method: :post, data: { reactions_target: "formElement", action: "turbo:submit-end->reactions#handleSubmit" } do |form| %>
+      <label class="reaction__form-label flex align-center">
+        <span class="for-screen-reader">Add a reaction</span>
+        <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true, autocomplete: "off", placeholder: "React…", data: { reactions_target: "input", action: "keydown.esc->reactions#hideForm" } %>
+      </label>
+      <%= form.button type: "submit", class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction" do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Confirm reaction</span>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#hideForm" title="Cancel">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+      <span class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle:stop" title="Choose emoji" aria-label="Choose emoji">
+          <%= icon_tag "reaction" %>
+        </button>
+        <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+              <button type="button" class="btn btn--circle borderless" data-action="reactions#pickEmoji dialog#close" data-emoji="<%= emoji %>" title="<%= label %>"><%= emoji %><span class="for-screen-reader"><%= label %></span></button>
+            <% end %>
+          </div>
+        </dialog>
+      </span>
+    <% end %>
+  </div>
+</div>
