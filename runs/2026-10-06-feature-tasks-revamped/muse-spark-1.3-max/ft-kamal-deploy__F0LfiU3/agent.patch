+# Fizzy Kamal secrets — copy to `.kamal/secrets` and fill in real values:
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# `.kamal/secrets` is gitignored — never commit real secrets.
+# Kamal loads this file with dotenv, so `$VAR` and `$(command)` work here.
+
+# Docker Hub (or GHCR) password / access token for pushing/pulling the image.
+# Create a read/write access token, then paste it here or export it:
+#   export KAMAL_REGISTRY_PASSWORD="dckr_pat_..."
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Rails secret. Generate a fresh one per install and keep it stable afterwards
+# (rotating it logs everyone out and breaks encrypted data):
+#   bin/rails secret
+SECRET_KEY_BASE=replace-me-with-bin-rails-secret-output
+
+# Password for the SMTP user in config/deploy.yml (`SMTP_USER_NAME`).
+# Leave blank/unset if your relay allows unauthenticated mail from this box,
+# but most providers (SES, Postmark, Gmail) require it.
+SMTP_PASSWORD=replace-me-with-smtp-password
+
+# Optional: VAPID keys for browser push notifications. Generate with:
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}\nVAPID_PRIVATE_KEY=#{k.private_key}"'
+# Then uncomment the two lines in config/deploy.yml `env: secret`.
+# VAPID_PUBLIC_KEY=
+# VAPID_PRIVATE_KEY=
