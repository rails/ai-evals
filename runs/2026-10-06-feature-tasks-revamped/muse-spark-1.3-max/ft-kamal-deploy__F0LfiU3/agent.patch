diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..4c9f950
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,115 @@
+# Fizzy — single-server Kamal deployment (SQLite, one container, kamal-proxy SSL).
+#
+# This config deploys Fizzy to ONE Linux box with Docker:
+#   - SQLite databases + Active Storage files live in /rails/storage,
+#     persisted in the `fizzy_storage` Docker volume across deploys.
+#   - Web + background jobs run in the SAME container (Solid Queue runs
+#     inside Puma via `SOLID_QUEUE_IN_PUMA`).
+#   - kamal-proxy terminates SSL with an automatic Let's Encrypt certificate.
+#
+# To self-host:
+#   1. Fill in YOUR SERVER IP, YOUR HOST, YOUR IMAGE below.
+#   2. Fill in mail settings under `env: clear` + `MAILER_FROM_ADDRESS`.
+#   3. Copy `.kamal/secrets.example` to `.kamal/secrets` and fill in secrets.
+#   4. Run `bin/kamal setup` (first time) then `bin/kamal deploy` for updates.
+# See docs/self-hosting.md for the full guide.
+
+service: fizzy
+
+# Docker image for your app. Replace with your own registry repo, e.g.:
+#   image: your-dockerhub-username/fizzy
+image: your-dockerhub-username/fizzy
+
+# One box. Replace with your server's IP or hostname (must be reachable via SSH
+# with Docker installed — `bin/kamal setup` will bootstrap Docker if missing).
+servers:
+  web:
+    - 192.168.0.1
+
+# SSL is terminated at kamal-proxy on the box. `host` must be the public
+# domain that points at your server. Keep it in sync with `APP_HOST` below.
+proxy:
+  ssl: true
+  host: app.example.com
+  # Thruster listens on 80 inside the container (see Dockerfile CMD).
+  app_port: 80
+  # Forward X-Forwarded-* so Rails sees real client IP/proto behind the proxy.
+  forward_headers: true
+  # Healthcheck hits /up (see config/routes.rb rails/health#show).
+  healthcheck:
+    interval: 3
+    path: /up
+    timeout: 5
+
+# Where the image is pushed. Docker Hub by default (no `server:` key).
+# Create a private repo first, then set KAMAL_REGISTRY_PASSWORD in .kamal/secrets.
+# For GHCR instead, use:
+#   registry:
+#     server: ghcr.io
+#     username: your-github-username
+#     password:
+#       - KAMAL_REGISTRY_PASSWORD
+registry:
+  username: your-dockerhub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build for x86_64 servers (most VPS providers). Use `arm64` for ARM boxes.
+builder:
+  arch: amd64
+
+# Bridge fingerprinted assets between releases to avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Persist SQLite (*.sqlite3) + Active Storage files (storage/production/files).
+# Without this volume, deploys would wipe your data.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Environment injected into the container. Secrets (SECRET_KEY_BASE, passwords)
+# come from `.kamal/secrets` — never commit them.
+env:
+  clear:
+    RAILS_ENV: production
+    # Run Solid Queue workers inside Puma so jobs run on the box
+    # without a second container/process.
+    SOLID_QUEUE_IN_PUMA: true
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    # Public hostname used for URLs in emails and background jobs.
+    # Must match `proxy: host` above.
+    APP_HOST: app.example.com
+    # Address shown in the From: header. Override the default support@fizzy.do.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@app.example.com>"
+    # Outbound mail server. Fizzy sends magic-login codes and notifications.
+    # Works with Postfix, Exim, Amazon SES (SMTP), Postmark, etc.
+    SMTP_ADDRESS: mail.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: app.example.com
+    SMTP_USER_NAME: fizzy
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    # Uncomment to tune concurrency for your box size:
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 2
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    # Optional: browser push notifications (VAPID). Generate with:
+    #   bin/rails runner 'k = WebPush.generate_key; puts "public=#{k.public_key} private=#{k.private_key}"'
+    # Then uncomment these two lines and add the values to .kamal/secrets.
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# Convenience shortcuts: `bin/kamal console`, `bin/kamal shell`, `bin/kamal logs`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+
+# Keep 5 releases for fast rollback (`bin/kamal rollback`).
+retain_containers: 5
+
+# SSH as root by default. Uncomment to deploy as another user with Docker rights:
+# ssh:
+#   user: deploy
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..f29d4e3 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -92,4 +92,45 @@ Rails.application.configure do
 
   # Skip DNS rebinding protection for the default health check endpoint.
   # config.host_authorization = { exclude: ->(request) { request.path == "/up" } }
+
+  # Self-hosted (OSS) mail + host configuration via environment.
+  # Skipped for SaaS — see saas/config/environments/* for the hosted setup.
+  # Configure these with Kamal in config/deploy.yml (`APP_HOST`, `SMTP_*`,
+  # `MAILER_FROM_ADDRESS`) and `.kamal/secrets` (`SMTP_PASSWORD`).
+  unless Fizzy.saas?
+    # Public hostname for URLs generated in mailers, exports and background jobs.
+    # Must match `proxy: host` in config/deploy.yml (e.g. fizzy.example.com).
+    if (app_host = ENV["APP_HOST"].presence)
+      config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+      config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    end
+
+    # Outbound SMTP. Fizzy sends magic-login codes and notifications via SMTP.
+    # Supports Postfix/Exim on the box as well as hosted relays (SES, Postmark, etc).
+    # Env (see config/deploy.yml):
+    #   SMTP_ADDRESS (or SMTP_HOST), SMTP_PORT, SMTP_DOMAIN,
+    #   SMTP_USER_NAME (or SMTP_USERNAME), SMTP_PASSWORD,
+    #   SMTP_AUTHENTICATION (plain/login/cram_md5), SMTP_ENABLE_STARTTLS_AUTO, SMTP_TLS
+    smtp_address = ENV["SMTP_ADDRESS"].presence || ENV["SMTP_HOST"].presence
+    if smtp_address
+      smtp_user_name = ENV["SMTP_USER_NAME"].presence || ENV["SMTP_USERNAME"].presence
+      smtp_auth = ENV["SMTP_AUTHENTICATION"].presence&.to_sym
+      # Default to STARTTLS when authentication is used; allow explicit opt-out.
+      starttls_default = smtp_user_name ? "true" : ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true")
+
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: smtp_address,
+        port: ENV.fetch("SMTP_PORT", 25).to_i,
+        domain: ENV["SMTP_DOMAIN"].presence || ENV["APP_HOST"].presence,
+        user_name: smtp_user_name,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: smtp_auth || (smtp_user_name ? :plain : nil),
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", starttls_default) == "true",
+        tls: ENV["SMTP_TLS"] == "true",
+        open_timeout: 5,
+        read_timeout: 5
+      }.compact
+    end
+  end
 end
diff --git a/docs/self-hosting.md b/docs/self-hosting.md
new file mode 100644
index 0000000..2310141
--- /dev/null
+++ b/docs/self-hosting.md
@@ -0,0 +1,186 @@
+# Self-hosting Fizzy with Kamal (single server)
+
+Deploy Fizzy to **one Linux box** with Docker, SQLite and automatic HTTPS.
+Web + background jobs run in the **same container** (Solid Queue inside Puma),
+and SQLite + uploads survive redeploys in a Docker volume.
+
+What you get after `bin/kamal setup`:
+
+- Fizzy at `https://your-host` with a Let's Encrypt certificate from kamal-proxy
+- SQLite databases at `storage/*.sqlite3` + Active Storage files at
+  `storage/production/files`, persisted in the `fizzy_storage` volume
+- Background jobs (notifications, webhooks, cleanup, recurring tasks from
+  `config/recurring.yml`) running on the box via `SOLID_QUEUE_IN_PUMA=true`
+
+## Prerequisites
+
+- A Linux server (x86_64, 2GB+ RAM) reachable via SSH as `root` with a public IP
+- A domain pointing at that IP (e.g. `fizzy.example.com` → your server)
+- Docker Hub (or GHCR) account with a **private** repo for the image
+- An SMTP server for magic-login codes and notifications (local Postfix/Exim
+  or hosted: SES, Postmark, etc.)
+- Kamal runs from your laptop: Ruby + Docker (see `Gemfile` `kamal` gem)
+
+## 1. Fork and configure the hostname
+
+Edit `config/deploy.yml` (3 places):
+
+```yaml
+image: your-dockerhub-username/fizzy   # your image repo
+servers:
+  web:
+    - 203.0.113.10                     # your server IP or SSH hostname
+proxy:
+  ssl: true
+  host: fizzy.example.com              # your public domain
+```
+
+Keep `env: clear: APP_HOST` in sync with `proxy: host`:
+
+```yaml
+env:
+  clear:
+    APP_HOST: fizzy.example.com
+```
+
+`APP_HOST` is used for URLs in emails and background jobs
+(see `config/environments/production.rb`).
+
+## 2. Configure mail
+
+In the same `config/deploy.yml` under `env: clear`:
+
+```yaml
+MAILER_FROM_ADDRESS: Fizzy <fizzy@fizzy.example.com>
+SMTP_ADDRESS: mail.example.com
+SMTP_PORT: 587
+SMTP_DOMAIN: fizzy.example.com
+SMTP_USER_NAME: fizzy
+SMTP_AUTHENTICATION: plain
+SMTP_ENABLE_STARTTLS_AUTO: true
+```
+
+Notes:
+
+- `SMTP_ADDRESS` also accepts `SMTP_HOST`; `SMTP_USER_NAME` also accepts
+  `SMTP_USERNAME`.
+- For local unauthenticated relays, keep `SMTP_ADDRESS: localhost`,
+  `SMTP_PORT: 25` and leave `SMTP_USER_NAME`/password blank.
+- For implicit TLS (port 465), add `SMTP_TLS: true` under `env: clear`.
+- `MAILER_FROM_ADDRESS` defaults to `Fizzy <support@fizzy.do>` if unset
+  (see `app/mailers/application_mailer.rb`).
+
+## 3. Fill in secrets
+
+```sh
+cp .kamal/secrets.example .kamal/secrets
+```
+
+Edit `.kamal/secrets` (gitignored, never commit):
+
+```sh
+KAMAL_REGISTRY_PASSWORD=...  # Docker Hub access token
+SECRET_KEY_BASE=...          # output of `bin/rails secret`
+SMTP_PASSWORD=...            # password for SMTP_USER_NAME
+```
+
+Generate the Rails secret with:
+
+```sh
+bin/rails secret
+```
+
+Keep `SECRET_KEY_BASE` stable — rotating it logs everyone out.
+
+Optional push notifications: generate VAPID keys, add them to
+`.kamal/secrets`, and uncomment the two `VAPID_*` lines in
+`config/deploy.yml`:
+
+```sh
+bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{k.public_key}\nVAPID_PRIVATE_KEY=#{k.private_key}"'
+```
+
+Also update `registry: username` in `config/deploy.yml` to match your
+Docker Hub username.
+
+## 4. Deploy
+
+First time (bootstraps Docker, proxy, volume, then deploys):
+
+```sh
+bin/kamal setup
+```
+
+Later deploys:
+
+```sh
+bin/kamal deploy
+```
+
+Open `https://fizzy.example.com` (your `proxy: host`). Sign up with your
+email — the code arrives via the SMTP server you configured.
+
+Useful commands:
+
+```sh
+bin/kamal console   # Rails console on the box
+bin/kamal shell     # bash in the app container
+bin/kamal app logs -f
+bin/kamal proxy logs -f
+```
+
+## How persistence works
+
+`volumes: ["fizzy_storage:/rails/storage"]` in `config/deploy.yml` maps the
+container's `/rails/storage` to a named Docker volume:
+
+- `storage/production.sqlite3` (+ `_cable`, `_cache`, `_queue`) — see
+  `config/database.sqlite.yml`
+- `storage/production/files` — Active Storage Disk root, see
+  `config/storage.oss.yml` (`local` service)
+
+`bin/docker-entrypoint` runs `db:prepare` on boot, so the first deploy
+creates the databases and later deploys migrate them in place. Data survives
+because the volume outlives the container.
+
+Verify on the box:
+
+```sh
+ssh root@203.0.113.10 "docker volume inspect fizzy_storage"
+```
+
+## How jobs work
+
+`SOLID_QUEUE_IN_PUMA=true` (see `config/puma.rb` `plugin :solid_queue` and
+`config/queue.yml`) runs dispatchers + workers inside the Puma process, so
+everything stays in one container. No separate `jobs` role or Redis needed.
+
+Tune for your box size in `config/deploy.yml`:
+
+```yaml
+WEB_CONCURRENCY: 2
+JOB_CONCURRENCY: 2
+```
+
+Monitor at `https://your-host/admin/jobs` (Mission Control).
+
+## SSL
+
+`proxy: ssl: true` makes kamal-proxy fetch a Let's Encrypt certificate for
+`proxy: host` on first deploy (port 443 must be open and DNS must already
+point at the box). The app itself always runs plain HTTP on port 80 behind
+Thruster (`./bin/thrust ./bin/rails server` in `Dockerfile`), with
+`assume_ssl` + `force_ssl` enabled (see
+`config/environments/production.rb`).
+
+## Troubleshooting
+
+- `kamal config` — validate `config/deploy.yml` without deploying.
+- `kamal setup` fails on registry auth — check `KAMAL_REGISTRY_PASSWORD`
+  and that the repo exists and is private.
+- No login emails — check `SMTP_*` + `SMTP_PASSWORD`, then
+  `bin/kamal app logs -f` for `Net::SMTP` errors.
+- Certificate issues — ensure DNS points at the box and ports 80/443 are
+  open; check `bin/kamal proxy logs`.
+- Start over (wipes data): `bin/kamal remove` then
+  `docker volume rm fizzy_storage` on the box, then `bin/kamal setup`.
