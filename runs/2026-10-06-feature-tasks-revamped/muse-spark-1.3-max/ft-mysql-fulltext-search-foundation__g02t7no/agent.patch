+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,23 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+
+    if @terms.any?
+      set_page_and_extract_portion_from search_results
+    else
+      @page = nil
+    end
+  end
+
+  private
+    def search_results
+      Current.user.accessible_cards
+        .where(cards: { account_id: Current.account.id })
+        .published
+        .search(@query)
+        .reverse_chronologically
+        .preloaded
+        .preload(comments: [ :rich_text_body, :creator ])
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..2817651
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,40 @@
+module SearchesHelper
+  def search_highlight(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  def search_excerpt(content, terms, length: 200)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text.to_s : content.to_s
+    return "" if text.blank?
+    return highlight(text.truncate(length), terms) if terms.blank?
+
+    lowered = text.downcase
+    first_index = terms.map { |term| lowered.index(term.downcase) }.compact.min
+
+    if first_index
+      context_before = 60
+      start = [ first_index - context_before, 0 ].max
+      excerpt = text[start, length] || ""
+      excerpt = "…#{excerpt}" if start > 0
+      excerpt = "#{excerpt}…" if start + length < text.length
+      highlight(excerpt, terms)
+    else
+      highlight(format_excerpt(content, length: length), terms)
+    end
+  end
+
+  def search_matching_comments(card, terms)
+    return [] if terms.blank?
+
+    card.comments.select { |comment| search_comment_matches?(comment, terms) }
+  end
+
+  def search_comment_matches?(comment, terms)
+    return false if terms.blank?
+
+    text = comment.body.to_plain_text.to_s.downcase
+    terms.any? { |term| text.include?(term.downcase) }
+  rescue
+    false
+  end
+end
