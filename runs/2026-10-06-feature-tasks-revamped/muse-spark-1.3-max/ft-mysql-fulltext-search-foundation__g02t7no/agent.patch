diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..b41d1e1
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,20 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      terms = query.to_s.split
+      return none if terms.empty?
+
+      terms.reduce(all) do |relation, term|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+        relation.where(
+          "cards.title LIKE ? ESCAPE '\\' OR " \
+          "EXISTS (SELECT 1 FROM action_text_rich_texts WHERE action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.record_id = cards.id AND action_text_rich_texts.name = 'description' AND action_text_rich_texts.body LIKE ? ESCAPE '\\') OR " \
+          "EXISTS (SELECT 1 FROM comments INNER JOIN action_text_rich_texts AS comment_rich_texts ON comment_rich_texts.record_type = 'Comment' AND comment_rich_texts.record_id = comments.id AND comment_rich_texts.name = 'body' WHERE comments.card_id = cards.id AND comment_rich_texts.body LIKE ? ESCAPE '\\')",
+          pattern, pattern, pattern
+        )
+      end
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..81142a0
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,57 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" }, class: "flex gap-half" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, autocomplete: "off",
+          class: "input full-width", aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page&.records&.any? %>
+      <div class="search-results txt-align-start margin-block-start">
+        <%= with_automatic_pagination :search_paginated_container, @page do %>
+          <% @page.records.each do |card| %>
+            <article class="search-result pad-block border-radius" id="<%= dom_id(card, :search_result) %>">
+              <h2 class="search-result__title txt-large">
+                <%= link_to search_highlight(card.title, @terms), card_path(card), data: { turbo_frame: "_top" } %>
+              </h2>
+
+              <p class="search-result__meta txt-small translucent">
+                <span><%= card.board.name %></span>
+                <span>·</span>
+                <span>#<%= card.number %></span>
+              </p>
+
+              <% unless card.description.blank? %>
+                <p class="search-result__description margin-block-start-half">
+                  <%= search_excerpt(card.description, @terms, length: 200) %>
+                </p>
+              <% end %>
+
+              <% matching_comments = search_matching_comments(card, @terms) %>
+              <% if matching_comments.any? %>
+                <div class="search-result__comments margin-block-start-half">
+                  <% matching_comments.each do |comment| %>
+                    <blockquote class="search-result__comment txt-small pad-inline-start border-inline-start">
+                      <%= search_excerpt(comment.body, @terms, length: 200) %>
+                      <cite class="translucent">— <%= comment.creator.name %></cite>
+                    </blockquote>
+                  <% end %>
+                </div>
+              <% end %>
+            </article>
+          <% end %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate margin-block-start">No cards match “<%= @query %>”</p>
+    <% end %>
+  <% else %>
+    <p class="blank-slate margin-block-start">Enter a search term to find cards by title, description, or comments.</p>
+  <% end %>
+</section>
