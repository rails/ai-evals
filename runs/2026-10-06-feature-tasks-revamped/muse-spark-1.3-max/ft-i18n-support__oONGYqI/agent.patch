--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,13 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function currentLocale() {
+  return document.documentElement.lang || getMetaContent("locale") || "en"
+}
+
+export function isJapanese() {
+  return currentLocale().startsWith("ja")
+}
+
+export function dateLocale() {
+  return isJapanese() ? "ja-JP" : "en-US"
+}
