         super
       end
     end
+
+    def with_recipient_locale(recipient, &block)
+      locale = locale_for_recipient(recipient)
+      I18n.with_locale(locale, &block)
+    end
+
+    def locale_for_recipient(recipient)
+      # Explicit locale passed via .with(locale:) takes precedence (e.g., magic link request's session locale)
+      if params[:locale].to_s.presence_in(%w[ en ja ])
+        params[:locale].to_sym
+      elsif recipient.respond_to?(:locale_or_default)
+        recipient.locale_or_default.to_sym
+      elsif recipient.respond_to?(:locale) && recipient.locale.to_s.presence_in(%w[ en ja ])
+        recipient.locale.to_sym
+      else
+        I18n.default_locale
+      end
+    rescue StandardError
+      I18n.default_locale
+    end
 end
