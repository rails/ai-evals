diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..644cb74
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,50 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_key, uniqueness: true, allow_nil: true
+
+    alias_attribute :public_token, :public_key
+    alias_attribute :share_key, :public_key
+    alias_attribute :share_token, :public_key
+  end
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+  alias_method :shared?, :published?
+
+  def publish
+    if published?
+      self
+    else
+      update! public_key: self.class.generate_public_key
+      self
+    end
+  end
+  alias_method :publish!, :publish
+
+  def unpublish
+    if published?
+      update! public_key: nil
+    end
+    self
+  end
+  alias_method :unpublish!, :unpublish
+
+  def public_url
+    if published?
+      "#{account.slug}/public/boards/#{public_key}"
+    end
+  end
+
+  class_methods do
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.urlsafe_base64(32)
+        break candidate unless exists?(public_key: candidate)
+      end
+    end
+  end
+end
