+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<p>Board: <%= link_to @board.name, public_board_path(@board.public_key) %></p>
+<% if @card.column %>
+  <p>Column: <%= link_to @card.column.name, public_board_column_path(@board.public_key, @card.column) %></p>
+<% end %>
+
+<h1><%= card_html_title(@card) %></h1>
+
+<% unless @card.description.blank? %>
+  <div class="card__description">
+    <%= @card.description %>
+  </div>
+<% end %>
+
+<% if @card.steps.any? %>
+  <ul>
+    <% @card.steps.each do |step| %>
+      <li><%= step.title %></li>
+    <% end %>
+  </ul>
+<% end %>
