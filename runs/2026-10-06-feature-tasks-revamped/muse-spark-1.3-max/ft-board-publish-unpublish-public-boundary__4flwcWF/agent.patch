+      format.html
+      format.json
+    end
+  end
+
+  private
+    def set_board
+      key = params[:board_key] || params[:key]
+      @board = find_published_board_by_key!(key)
+      Current.account ||= @board.account
+    end
+
+    def find_published_board_by_key!(key)
+      if Current.account
+        Current.account.boards.find_by(public_key: key) || Board.find_by!(public_key: key)
+      else
+        Board.find_by!(public_key: key)
+      end
+    end
