diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..71232d8
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,32 @@
+class ActivitiesController < ApplicationController
+  ACTIVITIES_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    events = Event.preloaded
+      .where(board: Current.user.boards)
+      .where(action: ACTIVITIES_ACTIONS)
+      .order(created_at: :desc, id: :desc)
+
+    events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+    events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+
+    set_page_and_extract_portion_from events
+
+    respond_to do |format|
+      format.json
+    end
+  end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..e7b6877
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,40 @@
+json.id event.id
+json.action event.action.to_s
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text.to_s
+case event.action.to_s
+when "card_assigned", "card_unassigned"
+  json.particulars({ assignee_ids: event.assignee_ids || [] })
+when "card_board_changed"
+  particulars = event.particulars || {}
+  nested = particulars["particulars"] || {}
+  json.particulars({
+    old_board: nested["old_board"] || particulars["old_board"] || nested["old_collection"] || particulars["old_collection"] || "",
+    new_board: nested["new_board"] || particulars["new_board"] || nested["new_collection"] || particulars["new_collection"] || ""
+  })
+when "card_title_changed"
+  particulars = event.particulars || {}
+  nested = particulars["particulars"] || {}
+  json.particulars({
+    old_title: nested["old_title"] || particulars["old_title"] || "",
+    new_title: nested["new_title"] || particulars["new_title"] || ""
+  })
+when "card_triaged"
+  particulars = event.particulars || {}
+  nested = particulars["particulars"] || {}
+  json.particulars({ column: nested["column"] || particulars["column"] || "" })
+else
+  json.particulars({})
+end
+json.url polymorphic_url(event.eventable)
+json.eventable_type event.eventable_type
+json.eventable do
+  case event.eventable
+  when Card
+    json.partial! "cards/card", card: event.eventable
+  when Comment
+    json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
