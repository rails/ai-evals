+        / <%= @account.storage_limit == Float::INFINITY ? "Unlimited" : number_to_human_size(@account.storage_limit) %>
+      </div>
+      <div>
+        <strong>Comped:</strong> <%= @account.comped? ? "Yes" : "No" %>
+      </div>
+      <% if @subscription %>
+        <div>
+          <strong>Subscription:</strong> <%= @subscription.plan_key %> (<%= @subscription.status %>)
+        </div>
+      <% end %>
+    </div>
+  </div>
