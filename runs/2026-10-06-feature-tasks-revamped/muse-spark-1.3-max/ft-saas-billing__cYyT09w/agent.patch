+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @overridden_limit&.card_count, class: "input" %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @overridden_limit&.bytes_used, class: "input" %>
+      </div>
+
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn btn--reversed" %>
+      </div>
+    <% end %>
+
+    <div class="margin-block-half">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :post, class: "btn" %>
+    </div>
+  </div>
+</section>
