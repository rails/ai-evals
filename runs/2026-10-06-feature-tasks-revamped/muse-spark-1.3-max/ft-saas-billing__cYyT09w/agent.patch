+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div>
+        <strong>Name:</strong> <%= @account.name %>
+      </div>
+      <div>
+        <strong>ID:</strong> #<%= @account.external_account_id %>
+      </div>
+      <div>
+        <strong>Plan:</strong> <%= @account.plan_name %>
+      </div>
+      <div>
+        <strong>Cards:</strong> <%= number_with_delimiter(@account.cards_count_without_override) %>
+        <% if @account.card_limit %>
