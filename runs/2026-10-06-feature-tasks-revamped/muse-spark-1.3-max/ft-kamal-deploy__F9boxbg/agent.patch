+# Fizzy Kamal secrets for single-server deployment.
+#
+# Secrets listed here are referenced from `config/deploy.yml` under
+# `registry/password` and `env/secret`. Kamal reads this file with dotenv
+# and supports variable expansion (`$VAR`) and command substitution (`$(...)`).
+# DO NOT COMMIT RAW CREDENTIALS — keep this file safe for git by pulling
+# values from your environment, a password manager, or files.
+#
+# Quick start (values read from your shell environment):
+#   1. Generate the values once:
+#        bin/rails secret
+#          # => SECRET_KEY_BASE (64+ hex chars for Rails sessions/encryption)
+#        bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}\nVAPID_PUBLIC_KEY=#{k.public_key}"'
+#          # => VAPID keys for browser push notifications (optional but recommended)
+#      Create a Docker Hub access token (or GHCR token) with read+write:
+#        https://hub.docker.com/settings/security
+#          # => KAMAL_REGISTRY_PASSWORD
+#      Get your SMTP password from your mail provider:
+#          # => SMTP_PASSWORD
+#   2. Export them before running Kamal (or store them in a password manager):
+#        export SECRET_KEY_BASE="$(bin/rails secret)"
+#        export KAMAL_REGISTRY_PASSWORD="dckr_pat_..."
+#        export SMTP_PASSWORD="smtp-secret"
+#        export VAPID_PRIVATE_KEY="..."
+#        export VAPID_PUBLIC_KEY="..."
+#        bin/kamal setup
+#
+# Alternatives (uncomment and adapt as needed):
+#   # Read from 1Password (or LastPass / Bitwarden via `kamal secrets fetch`):
+#   # SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy SECRET_KEY_BASE KAMAL_REGISTRY_PASSWORD SMTP_PASSWORD VAPID_PRIVATE_KEY VAPID_PUBLIC_KEY)
+#   # SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+#   # KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+#   # SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+#   # VAPID_PRIVATE_KEY=$(kamal secrets extract VAPID_PRIVATE_KEY $SECRETS)
+#   # VAPID_PUBLIC_KEY=$(kamal secrets extract VAPID_PUBLIC_KEY $SECRETS)
+#
+#   # Read from files on disk:
+#   # SECRET_KEY_BASE=$(cat ~/.secrets/fizzy_secret_key_base)
+#
+# If you store raw values directly in this file, make sure it is NOT checked
+# into version control (add `.kamal/secrets` to `.gitignore`).
+
+# Rails secret for sessions, cookies, and encryption. Generate with `bin/rails secret`.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Registry password (Docker Hub access token or GHCR token). Referenced by `registry/password`.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# SMTP password for outbound email. Referenced by `env/secret` as SMTP_PASSWORD.
+# Leave blank (export SMTP_PASSWORD="") only if your relay needs no authentication.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# VAPID keys for web push notifications (see docs/development.md for generation).
+# Push is optional — but the app expects both keys if you list them in `env/secret`.
+# To disable push, remove both lines from `env/secret` in config/deploy.yml instead.
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
