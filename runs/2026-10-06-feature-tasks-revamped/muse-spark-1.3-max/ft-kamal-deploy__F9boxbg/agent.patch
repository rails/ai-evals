new file mode 100644
index 0000000..0cedc10
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,130 @@
+# Fizzy — single-server Kamal deployment.
+#
+# This config deploys everything to one Linux box with Docker:
+#   - SQLite databases + Active Storage files in a persistent Docker volume
+#   - Web + background jobs (Solid Queue in Puma) in a single container
+#   - SSL automatically via kamal-proxy (Let's Encrypt)
+#
+# Prerequisites on your workstation:
+#   - Docker running (to build the image)
+#   - Kamal installed (`bundle install` already includes it)
+#   - SSH access to your server (root, or a user that can run Docker)
+#   - DNS for your hostname pointing at the server, with ports 80 + 443 open
+#
+# Setup:
+#   1. Fill in `image`, `servers.web`, `proxy.host`, `registry`, and `env.clear` below.
+#      At minimum, replace every `example.com` / `your-user` / `your-server-host` value.
+#   2. Fill in `.kamal/secrets` (see comments in that file for how to generate values).
+#   3. Run `bin/kamal setup` from this directory.
+#      Kamal will bootstrap Docker on the server, build + push the image,
+#      and boot the app. Visit https://your-host when it finishes.
+#   4. Later deploys are just `bin/kamal deploy`. Data survives redeploys
+#      because SQLite + files live in the `fizzy_storage` volume.
+#
+# Background jobs run on the box inside the web container via Puma
+# (`SOLID_QUEUE_IN_PUMA=true`). No separate job server is needed. When you
+# outgrow one box, split jobs out to their own role (see commented `job` example).
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+# For Docker Hub: `your-dockerhub-username/fizzy` (must match registry username).
+# For GHCR: `ghcr.io/your-github-username/fizzy`.
+image: your-user/fizzy
+
+# Deploy to a single server running Docker.
+servers:
+  web:
+    - your-server-host # e.g., 192.0.2.10 or fizzy.example.com (reachable via SSH)
+  # When you need a dedicated job server, uncomment and point at the same
+  # or a different box. Remember to set SOLID_QUEUE_IN_PUMA=false then.
+  # job:
+  #   hosts:
+  #     - your-server-host
+  #   cmd: bin/jobs
+
+# Enable SSL auto-certification via Let's Encrypt and route by hostname.
+# Requires a single web server; `host` must resolve to that server.
+proxy:
+  ssl: true
+  host: fizzy.example.com # <-- your public hostname; app will be at https://<host>
+  # The container serves plain HTTP on port 80 via Thruster
+  # (`./bin/thrust ./bin/rails server`), which is kamal-proxy's default app_port.
+  # Forward X-Forwarded-* headers so Rails sees the original protocol and IP.
+  forward_headers: true
+  healthcheck:
+    path: /up
+    interval: 5
+    timeout: 5
+
+# Where you keep your container image. This example uses Docker Hub.
+# For GHCR, add `server: ghcr.io` and use a classic token with read+write packages scope.
+registry:
+  username: your-user # <-- your Docker Hub username (must match `image` prefix)
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from `.kamal/secrets`).
+env:
+  clear:
+    # Run the Solid Queue supervisor inside Puma so jobs run without a separate container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Public hostname used for URLs in emails, Active Storage, webhooks, etc.
+    # Must match `proxy.host` above.
+    APP_HOST: fizzy.example.com
+
+    # Log level (`debug`, `info`, `warn`, `error`). Keep `info` unless debugging.
+    RAILS_LOG_LEVEL: info
+
+    # Outbound email via SMTP. The app reads these in config/environments/production.rb.
+    SMTP_ADDRESS: smtp.example.com # <-- your SMTP server hostname
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com # usually your app hostname; used for HELO
+    SMTP_USER_NAME: fizzy # SMTP login; leave blank for unauthenticated relays
+    # Authentication method when SMTP_USER_NAME is set (`plain`, `login`, `cram_md5`).
+    # SMTP_AUTHENTICATION: plain
+    # Set to "false" only for relays without STARTTLS (e.g., local postfix on port 25).
+    # SMTP_ENABLE_STARTTLS_AUTO: "true"
+
+    # From address for all outgoing mail (see app/mailers/application_mailer.rb).
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>"
+
+    # Optional tuning. Defaults are one Puma worker / one Solid Queue process per CPU.
+    # WEB_CONCURRENCY: 1
+    # JOB_CONCURRENCY: 1
+
+    # Optional: set to "true" to allow anyone to sign up (multi-tenant mode).
+    # By default only the first account can be created (single-tenant, invite via join code).
+    # MULTI_TENANT: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# Persist SQLite databases and Active Storage files across deploys.
+# All production SQLite files live under `storage/` (see config/database.sqlite.yml
+# and config/storage.oss.yml), so one volume covers everything.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets (JS/CSS) between versions to avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Configure the image builder. Override to `arm64` if your server is ARM-only,
+# or remove `arch` to build multi-arch (slower).
+builder:
+  arch: amd64
+
+# Aliases triggered with `bin/kamal <alias>`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Use a different SSH user than root (must be able to run Docker on the server).
+# ssh:
+#   user: app
