+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p>
+      <strong><%= @account.name %></strong><br>
+      <span class="txt-x-small">ID: <%= @account.id %> • #<%= @account.external_account_id %></span>
+    </p>
+
+    <p>
+      Plan: <%= @account.try(:plan) || "Free" %><br>
+      Cards: <%= @account.read_attribute(:cards_count) %> (effective: <%= @account.try(:cards_used) || @account.read_attribute(:cards_count) %>)<br>
+      Storage: <%= number_to_human_size(@account.try(:bytes_used) || 0) %> of <%= number_to_human_size(@account.try(:storage_limit) || 1.gigabyte) %><br>
+      Comped: <%= @account.try(:comped?) ? "yes" : "no" %>
+    </p>
+
+    <div class="flex gap-half margin-block">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+    </div>
+
+    <hr>
+
+    <h2>Override limits</h2>
+    <%= form_with model: (@overridden || Account::OverriddenLimit.new(account: @account)), url: saas.override_admin_account_path(@account), method: :post, scope: :overridden_limit do |form| %>
+      <div>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @overridden&.card_count %>
+      </div>
+      <div>
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @overridden&.bytes_used %>
+      </div>
+      <div class="margin-block-start">
+        <%= form.submit "Override", class: "btn btn--reversed" %>
+      </div>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :post, class: "btn" %>
+    </div>
+
+    <p class="margin-block-start">
+      <%= link_to "Back to accounts", saas.admin_accounts_path %>
+    </p>
+  </div>
+</section>
