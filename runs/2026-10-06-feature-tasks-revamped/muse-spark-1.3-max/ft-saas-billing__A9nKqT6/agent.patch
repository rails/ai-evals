@@ -0,0 +1,26 @@
+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    account = Current.account
+    customer_id = account.try(:active_subscription)&.stripe_customer_id ||
+                  account.try(:subscription)&.stripe_customer_id ||
+                  account.subscriptions.ordered.first&.stripe_customer_id
+
+    unless customer_id.present?
+      redirect_to main_app.account_settings_path, alert: "No billing account found" and return
+    end
+
+    return_url = main_app.account_settings_url(script_name: account.slug, host: request.host, protocol: request.protocol) rescue main_app.account_settings_url
+
+    session = ::Stripe::BillingPortal::Session.create(
+      customer: customer_id,
+      return_url: return_url
+    )
+
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  rescue ::Stripe::StripeError => e
+    Rails.logger.error "[Billing] Portal failed: #{e.message}"
+    redirect_to main_app.account_settings_path, alert: "Could not open billing portal: #{e.message}"
+  end
+end
