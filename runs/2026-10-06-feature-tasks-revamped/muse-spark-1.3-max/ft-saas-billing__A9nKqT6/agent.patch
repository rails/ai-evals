+module Card::BillingLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      account = Current.account
+      # Billing may not be present in OSS; guard with respond_to?
+      exceeding = account.try(:exceeding_card_limit?) || false
+      head :forbidden if exceeding && !Current.identity.staff?
+    end
+
+    # Combined check for publish: block if either storage or card limit exceeded
+    def ensure_within_billing_limits
+      account = Current.account
+      storage_exceeded = account.try(:exceeding_storage_limit?) || false
+      card_exceeded = account.try(:exceeding_card_limit?) || false
+      head :forbidden if (storage_exceeded || card_exceeded) && !Current.identity.staff?
+    end
+end
