+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Plan</h2>
+    </header>
+
+    <% plan_key = Current.account.try(:plan_key) || "free" %>
+    <% plan_name = Current.account.try(:plan) || "Free" %>
+    <div data-plan="<%= plan_key %>">
+      <p>
+        Current plan: <strong><%= plan_name %></strong>
+      </p>
+
+      <% if Current.account.try(:card_limit) %>
+        <p class="txt-small">
+          <%= number_with_delimiter(Current.account.try(:cards_used) || Current.account.cards_count) %> of <%= number_with_delimiter(Current.account.card_limit) %> cards used
+          <% if Current.account.try(:nearing_card_limit?) || Current.account.try(:exceeding_card_limit?) %>
+            (<%= pluralize(Current.account.cards_remaining, "card") %> left)
+          <% end %>
+        </p>
+      <% else %>
+        <p class="txt-small">Unlimited cards</p>
+      <% end %>
+
+      <p class="txt-small">
+        <%= number_to_human_size(Current.account.try(:bytes_used) || 0) %> of <%= number_to_human_size(Current.account.try(:storage_limit) || 1.gigabyte) %> storage used
+      </p>
+    </div>
+
+    <div class="flex flex-column gap-half margin-block-start">
+      <% if plan_key == "free" %>
+        <div class="flex gap-half">
+          <%= button_to "Upgrade to Unlimited — $20/month, 5 GB", saas.billing_checkout_path(plan: "unlimited", script_name: Current.account.slug), method: :post, class: "btn btn--reversed", data: { turbo: false } %>
+        </div>
+        <div class="flex gap-half">
+          <%= button_to "Upgrade to Unlimited+ — $25/month, 500 GB", saas.billing_checkout_path(plan: "unlimited_plus", script_name: Current.account.slug), method: :post, class: "btn btn--reversed", data: { turbo: false } %>
+        </div>
+        <div class="txt-small">
+          Free includes 1,000 cards, 1 GB. <%= link_to "Upgrade", saas.billing_checkout_path(plan: "unlimited", script_name: Current.account.slug), data: { turbo: false } %> for unlimited cards.
+        </div>
+      <% elsif plan_key == "unlimited" %>
+        <div class="flex gap-half">
+          <%= button_to "Upgrade to Unlimited+ — $25/month, 500 GB", saas.billing_checkout_path(plan: "unlimited_plus", script_name: Current.account.slug), method: :post, class: "btn btn--reversed", data: { turbo: false } %>
+          <%= button_to "Manage billing", saas.billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn", data: { turbo: false } %>
+        </div>
+        <div class="txt-small">
+          Unlimited includes unlimited cards, 5 GB. <%= link_to "Upgrade", saas.billing_checkout_path(plan: "unlimited_plus", script_name: Current.account.slug), data: { turbo: false } %> for 500 GB.
+        </div>
+      <% else %>
+        <div class="flex gap-half">
+          <%= button_to "Manage billing", saas.billing_portal_path(script_name: Current.account.slug), method: :post, class: "btn", data: { turbo: false } %>
+          <%= link_to "Upgrade", saas.billing_portal_path(script_name: Current.account.slug), class: "btn", data: { turbo: false } %>
+        </div>
+        <div class="txt-small">
+          Unlimited+ includes unlimited cards, 500 GB.
+        </div>
+      <% end %>
+    </div>
+  </section>
+<% end %>
