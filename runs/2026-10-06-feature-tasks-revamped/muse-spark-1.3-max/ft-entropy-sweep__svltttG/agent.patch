+    def auto_postpone_all_due(now = Time.current)
+      if Rails.env.test?
+        auto_postpone_all_due_without_lock(now)
+      else
+        lockfile = Rails.root.join("tmp/auto_postpone_all_due.lock")
+
+        File.open(lockfile, "w") do |file|
+          if file.flock(File::LOCK_EX | File::LOCK_NB)
+            begin
+              auto_postpone_all_due_without_lock(now)
+            ensure
+              file.flock(File::LOCK_UN)
+            end
+          else
+            Rails.logger.info("auto_postpone_all_due: another sweep is already running, skipping")
+            0
+          end
+        end
+      end
+    end
+
+    def auto_postpone_all_due_without_lock(now = Time.current)
+      board_periods = Entropy.where(container_type: "Board").pluck(:container_id, :auto_postpone_period).to_h
+      account_periods = Entropy.where(container_type: "Account").pluck(:container_id, :auto_postpone_period).to_h
+      system_user_ids = User.where(role: :system).pluck(:account_id, :id).to_h
+
+      boards_by_period = Hash.new { |hash, key| hash[key] = [] }
+
+      Board.pluck(:id, :account_id).each do |board_id, account_id|
+        period = board_periods[board_id] || account_periods[account_id]
+
+        if period && system_user_ids[account_id]
+          boards_by_period[period] << board_id
+        end
       end
+
+      total = 0
+
+      Card.suppressing_turbo_broadcasts do
+        boards_by_period.each do |period, board_ids|
+          cutoff = now - period
+
+          board_ids.each_slice(500) do |board_chunk|
+            Card.active.where(board_id: board_chunk).where("cards.last_active_at <= ?", cutoff).in_batches(of: 500) do |batch|
+              cards_info = batch.pluck(:id, :account_id, :board_id)
+
+              if cards_info.any?
+                total += bulk_postpone_cards(cards_info, system_user_ids, now)
+              end
+            end
+          end
+        end
+      end
+
+      total
     end
+
+    private
+      def bulk_postpone_cards(cards_info, system_user_ids, now)
+        card_ids = cards_info.map(&:first)
+        return 0 if card_ids.empty?
+
+        Card.transaction do
+          Card::ActivitySpike.where(card_id: card_ids).delete_all
+
+          Card.where(id: card_ids).update_all(column_id: nil, last_active_at: now, updated_at: now)
+
+          batch_board_ids = cards_info.map(&:third).uniq
+          Board.where(id: batch_board_ids).update_all(updated_at: now)
+
+          not_now_rows = cards_info.map do |card_id, account_id, _board_id|
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_id,
+              card_id: card_id,
+              user_id: system_user_ids[account_id],
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Card::NotNow.insert_all(not_now_rows)
+
+          event_rows = cards_info.map do |card_id, account_id, board_id|
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_id,
+              board_id: board_id,
+              creator_id: system_user_ids[account_id],
+              eventable_id: card_id,
+              eventable_type: "Card",
+              action: "card_auto_postponed",
+              particulars: "{}",
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Event.insert_all(event_rows)
+
+          comment_rows = cards_info.map do |card_id, account_id, _board_id|
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_id,
+              card_id: card_id,
+              creator_id: system_user_ids[account_id],
+              created_at: now,
+              updated_at: now
+            }
+          end
+          Comment.insert_all(comment_rows)
+
+          rich_text_body = "<strong>Moved</strong> to “Not Now” due to inactivity"
+          rich_text_rows = cards_info.zip(comment_rows).map do |(_card_id, account_id, _board_id), comment_row|
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_id,
+              record_type: "Comment",
+              record_id: comment_row[:id],
+              name: "body",
+              body: rich_text_body,
+              created_at: now,
+              updated_at: now
+            }
+          end
+          ActionText::RichText.insert_all(rich_text_rows)
+
+          index_system_comments_for_bulk(cards_info, comment_rows, now)
+          upsert_watches_for_bulk(cards_info, system_user_ids, now)
+          dispatch_webhooks_for_bulk_if_needed(cards_info, event_rows)
+
+          cards_info.size
+        end
+      end
+
+      def index_system_comments_for_bulk(cards_info, comment_rows, now)
+        plain_text = "Moved to “Not Now” due to inactivity"
+
+        if Search::Record.connection.adapter_name == "SQLite"
+          search_rows = cards_info.zip(comment_rows).map do |(card_id, account_id, board_id), comment_row|
+            {
+              account_id: account_id,
+              searchable_type: "Comment",
+              searchable_id: comment_row[:id],
+              card_id: card_id,
+              board_id: board_id,
+              title: nil,
+              content: plain_text,
+              created_at: now
+            }
+          end
+
+          Search::Record.insert_all(search_rows)
+
+          searchable_ids = comment_rows.map { |row| row[:id] }
+          id_by_searchable = Search::Record.where(searchable_type: "Comment", searchable_id: searchable_ids).pluck(:searchable_id, :id).to_h
+
+          fts_rows = search_rows.filter_map do |row|
+            if rowid = id_by_searchable[row[:searchable_id]]
+              { rowid: rowid, title: row[:title], content: row[:content] }
+            end
+          end
+
+          if fts_rows.any?
+            placeholders = fts_rows.map { "(?, ?, ?)" }.join(", ")
+            binds = fts_rows.flat_map { |row| [ row[:rowid], row[:title], row[:content] ] }
+
+            Search::Record.connection.exec_query(
+              "INSERT OR REPLACE INTO search_records_fts(rowid, title, content) VALUES #{placeholders}",
+              "Search::Record::SQLite::Fts Bulk Upsert",
+              binds
+            )
+          end
+        else
+          rows_by_shard = Hash.new { |hash, key| hash[key] = [] }
+
+          cards_info.zip(comment_rows).each do |(card_id, account_id, board_id), comment_row|
+            shard = Search::Record.for(account_id)
+
+            rows_by_shard[shard] << {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_id,
+              account_key: "account#{account_id}",
+              searchable_type: "Comment",
+              searchable_id: comment_row[:id],
+              card_id: card_id,
+              board_id: board_id,
+              title: nil,
+              content: Search::Stemmer.stem(plain_text),
+              created_at: now
+            }
+          end
+
+          rows_by_shard.each do |shard, rows|
+            shard.insert_all(rows)
+          end
+        end
+      end
+
+      def upsert_watches_for_bulk(cards_info, system_user_ids, now)
+        account_by_card = cards_info.to_h { |card_id, account_id, _board_id| [ card_id, account_id ] }
+        pairs = cards_info.map { |card_id, account_id, _board_id| [ card_id, system_user_ids[account_id] ] }
+        card_ids = pairs.map(&:first)
+        user_ids = pairs.map(&:second).uniq
+
+        existing_map = Watch.where(card_id: card_ids, user_id: user_ids).pluck(:card_id, :user_id, :watching).to_h do |card_id, user_id, watching|
+          [ [ card_id, user_id ], watching ]
+        end
+
+        to_rewatch_by_user = Hash.new { |hash, key| hash[key] = [] }
+
+        pairs.each do |card_id, user_id|
+          if existing_map[[ card_id, user_id ]] == false
+            to_rewatch_by_user[user_id] << card_id
+          end
+        end
+
+        to_rewatch_by_user.each do |user_id, ids|
+          Watch.where(user_id: user_id, card_id: ids, watching: false).update_all(watching: true, updated_at: now)
+        end
+
+        to_insert = pairs.filter_map do |card_id, user_id|
+          unless existing_map.key?([ card_id, user_id ])
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              account_id: account_by_card[card_id],
+              card_id: card_id,
+              user_id: user_id,
+              watching: true,
+              created_at: now,
+              updated_at: now
+            }
+          end
+        end
+
+        if to_insert.any?
+          Watch.insert_all(to_insert)
+        end
+      end
+
+      def dispatch_webhooks_for_bulk_if_needed(cards_info, event_rows)
+        board_ids = cards_info.map(&:third).uniq
+
+        if Webhook.active.where(board_id: board_ids).exists?
+          event_ids = event_rows.map { |row| row[:id] }
+
+          Event.where(id: event_ids).find_each do |event|
+            Event::WebhookDispatchJob.perform_later(event)
+          end
+        end
+      end
   end
 
