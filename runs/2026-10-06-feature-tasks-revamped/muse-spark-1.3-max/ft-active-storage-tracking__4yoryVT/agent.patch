+class UpdateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(board_id, account_id, delta)
+    return if delta.zero?
+
+    ApplicationRecord.transaction do
+      if board_id
+        Board.update_bytes_used_now(board_id, delta)
+      end
+
+      if account_id
+        Account.update_bytes_used_now(account_id, delta)
+      end
+    end
+  end
+end
