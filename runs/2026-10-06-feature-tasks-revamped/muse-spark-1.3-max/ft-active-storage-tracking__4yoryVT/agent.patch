diff --git a/app/models/card/bytes_used.rb b/app/models/card/bytes_used.rb
new file mode 100644
index 0000000..14f287e
--- /dev/null
+++ b/app/models/card/bytes_used.rb
@@ -0,0 +1,65 @@
+module Card::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_board_change_for_bytes_used
+    after_update_commit :transfer_bytes_used_later, if: :should_transfer_bytes_used?
+  end
+
+  def calculate_bytes_used
+    image_bytes_used +
+      description_embeds_bytes_used +
+      comment_embeds_bytes_used
+  end
+
+  def transfer_bytes_used_later
+    old_board_id = @bytes_used_old_board_id
+    new_board_id = board_id
+
+    @bytes_used_old_board_id = nil
+
+    if old_board_id && old_board_id != new_board_id
+      total = calculate_bytes_used
+      return if total.zero?
+
+      old_account_id = Board.find_by(id: old_board_id)&.account_id || account_id
+      new_account_id = Board.find_by(id: new_board_id)&.account_id || account_id
+
+      TransferCardBytesUsedJob.perform_later(old_board_id, new_board_id, old_account_id, new_account_id, total)
+    end
+  end
+
+  private
+    def remember_board_change_for_bytes_used
+      if board_id_changed? && @bytes_used_old_board_id.nil?
+        @bytes_used_old_board_id = board_id_was
+      end
+    end
+
+    def should_transfer_bytes_used?
+      @bytes_used_old_board_id.present? && @bytes_used_old_board_id != board_id
+    end
+
+    def image_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: id)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def description_embeds_bytes_used
+      ActionText::RichText
+        .where(record_type: "Card", name: "description", record_id: id)
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embeds_bytes_used
+      comment_ids = Comment.where(card_id: id).select(:id)
+
+      ActionText::RichText
+        .where(record_type: "Comment", name: "body", record_id: comment_ids)
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
