diff --git a/app/jobs/transfer_card_bytes_used_job.rb b/app/jobs/transfer_card_bytes_used_job.rb
new file mode 100644
index 0000000..6150913
--- /dev/null
+++ b/app/jobs/transfer_card_bytes_used_job.rb
@@ -0,0 +1,27 @@
+class TransferCardBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(old_board_id, new_board_id, old_account_id, new_account_id, total)
+    return if total.zero?
+
+    ApplicationRecord.transaction do
+      if old_board_id
+        Board.update_bytes_used_now(old_board_id, -total)
+      end
+
+      if new_board_id
+        Board.update_bytes_used_now(new_board_id, total)
+      end
+
+      if old_account_id != new_account_id
+        if old_account_id
+          Account.update_bytes_used_now(old_account_id, -total)
+        end
+
+        if new_account_id
+          Account.update_bytes_used_now(new_account_id, total)
+        end
+      end
+    end
+  end
+end
