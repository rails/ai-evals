+++ b/app/models/account/bytes_used.rb
@@ -0,0 +1,79 @@
+module Account::BytesUsed
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used].to_i.clamp(0..)
+  end
+
+  def recalculate_bytes_used_later
+    RecalculateAccountBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    self.class.recalculate_bytes_used_now(id)
+  end
+
+  class_methods do
+    def update_bytes_used_now(account_id, delta)
+      return if delta.zero?
+
+      where(id: account_id).update_counters(bytes_used: delta)
+    end
+
+    def recalculate_bytes_used_now(account_id)
+      account = find_by(id: account_id)
+      return unless account
+
+      total = account.calculate_bytes_used
+      where(id: account_id).update_all(bytes_used: total)
+    end
+  end
+
+  def calculate_bytes_used
+    card_images_bytes_used +
+      board_embeds_bytes_used +
+      card_description_embeds_bytes_used +
+      comment_embeds_bytes_used
+  end
+
+  private
+    def board_ids
+      boards.select(:id)
+    end
+
+    def card_ids
+      Card.where(board_id: board_ids).select(:id)
+    end
+
+    def comment_ids
+      Comment.where(card_id: card_ids).select(:id)
+    end
+
+    def card_images_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_embeds_bytes_used
+      ActionText::RichText
+        .where(record_type: "Board", name: "public_description", record_id: board_ids)
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_embeds_bytes_used
+      ActionText::RichText
+        .where(record_type: "Card", name: "description", record_id: card_ids)
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embeds_bytes_used
+      ActionText::RichText
+        .where(record_type: "Comment", name: "body", record_id: comment_ids)
+        .joins(embeds_attachments: :blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
