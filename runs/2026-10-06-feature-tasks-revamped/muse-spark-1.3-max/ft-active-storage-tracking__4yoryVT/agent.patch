diff --git a/lib/rails_ext/active_storage_bytes_used.rb b/lib/rails_ext/active_storage_bytes_used.rb
new file mode 100644
index 0000000..9842bb2
--- /dev/null
+++ b/lib/rails_ext/active_storage_bytes_used.rb
@@ -0,0 +1,196 @@
+# Tracks storage usage for card images and rich text embeds.
+#
+# Only counts:
+# - Card images (Card#image)
+# - Files embedded in board public descriptions, card descriptions, and comment bodies
+#
+# Updates are applied in the background via UpdateBytesUsedJob using atomic
+# increments, so concurrent attachments from many users never lose updates
+# and reads stay O(1) via cached counters.
+
+ActiveSupport.on_load :active_storage_attachment do
+  after_create_commit :track_bytes_used_on_create
+  before_destroy :capture_bytes_used_for_destroy
+  after_destroy_commit :track_bytes_used_on_destroy
+
+  # Handle purge/detach/delete paths that bypass destroy callbacks.
+  #
+  # ActiveStorage::Attachment#purge, #purge_later and detach use #delete
+  # (no callbacks). We intercept #delete to track those removals, while
+  # skipping when #delete is called as part of #destroy (which is already
+  # tracked via before_destroy/after_destroy_commit).
+  def delete
+    bypassing_destroy = !@bytes_used_capturing_destroy
+
+    if bypassing_destroy
+      captured = capture_bytes_used
+    end
+
+    super.tap do
+      if bypassing_destroy && captured
+        board_id, account_id, byte_size = captured
+        UpdateBytesUsedJob.perform_later(board_id, account_id, -byte_size) if byte_size.positive?
+      end
+    end
+  end
+
+  private
+    def track_bytes_used_on_create
+      if captured = capture_bytes_used
+        board_id, account_id, byte_size = captured
+        UpdateBytesUsedJob.perform_later(board_id, account_id, byte_size) if byte_size.positive?
+      end
+    end
+
+    def capture_bytes_used_for_destroy
+      @bytes_used_capturing_destroy = true
+      @bytes_used_captured = capture_bytes_used
+    end
+
+    def track_bytes_used_on_destroy
+      if @bytes_used_captured
+        board_id, account_id, byte_size = @bytes_used_captured
+        UpdateBytesUsedJob.perform_later(board_id, account_id, -byte_size) if byte_size.positive?
+      end
+    ensure
+      @bytes_used_capturing_destroy = false
+      @bytes_used_captured = nil
+    end
+
+    def capture_bytes_used
+      return unless bytes_used_relevant?
+
+      byte_size = bytes_used_byte_size
+      return unless byte_size.positive?
+
+      board_id = bytes_used_board_id
+      account_id = self[:account_id] || bytes_used_account_id_from_record
+
+      # Always update account when we know it, even if board is gone
+      # (e.g. board destroyed). Skip only when we know neither.
+      return if board_id.nil? && account_id.nil?
+
+      [ board_id, account_id, byte_size ]
+    end
+
+    def bytes_used_relevant?
+      if record_type == "Card" && name == "image"
+        true
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = bytes_used_rich_text
+        rich_text.present? && (
+          (rich_text[:record_type] == "Board" && rich_text[:name] == "public_description") ||
+          (rich_text[:record_type] == "Card" && rich_text[:name] == "description") ||
+          (rich_text[:record_type] == "Comment" && rich_text[:name] == "body")
+        )
+      else
+        false
+      end
+    end
+
+    def bytes_used_byte_size
+      # Prefer in-memory blob to avoid extra query, fall back to DB.
+      if association(:blob).loaded? && blob
+        blob.byte_size.to_i
+      else
+        self[:blob_id] ? ActiveStorage::Blob.where(id: self[:blob_id]).pick(:byte_size).to_i : 0
+      end
+    end
+
+    def bytes_used_board_id
+      if record_type == "Card" && name == "image"
+        bytes_used_card_board_id(self[:record_id])
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = bytes_used_rich_text
+        return unless rich_text
+
+        case rich_text[:record_type]
+        when "Board"
+          rich_text[:record_id] if rich_text[:name] == "public_description"
+        when "Card"
+          bytes_used_card_board_id(rich_text[:record_id]) if rich_text[:name] == "description"
+        when "Comment"
+          bytes_used_comment_board_id(rich_text[:record_id]) if rich_text[:name] == "body"
+        end
+      end
+    end
+
+    def bytes_used_account_id_from_record
+      # Fallback when attachment.account_id is missing (e.g. legacy rows).
+      record&.try(:account_id)
+    rescue
+      nil
+    end
+
+    def bytes_used_rich_text
+      # attachment.record is the RichText when record_type is RichText.
+      # Use in-memory record if loaded to avoid query, else fetch minimal columns.
+      if association(:record).loaded?
+        record
+      else
+        ActionText::RichText.where(id: self[:record_id]).select(:id, :record_type, :record_id, :name, :account_id).first
+      end
+    rescue
+      nil
+    end
+
+    def bytes_used_card_board_id(card_id)
+      return unless card_id
+
+      # Try in-memory record first for Card images to avoid query.
+      if record_type == "Card" && association(:record).loaded? && record
+        record[:board_id]
+      else
+        Card.where(id: card_id).pick(:board_id)
+      end
+    end
+
+    def bytes_used_comment_board_id(comment_id)
+      return unless comment_id
+
+      card_id = Comment.where(id: comment_id).pick(:card_id)
+      return unless card_id
+
+      Card.where(id: card_id).pick(:board_id)
+    end
+end
+
+# Handle DetachMany which uses delete_all (bypasses callbacks).
+Rails.application.config.to_prepare do
+  module ActiveStorageDetachManyBytesUsed
+    def detach
+      captured_totals = nil
+
+      if attachments.any?
+        # Capture before delete_all removes rows.
+        captured_totals = capture_bytes_used_totals
+      end
+
+      super.tap do
+        if captured_totals
+          captured_totals.each do |(board_id, account_id), total|
+            UpdateBytesUsedJob.perform_later(board_id, account_id, -total) if total.positive?
+          end
+        end
+      end
+    end
+
+    private
+      def capture_bytes_used_totals
+        totals = Hash.new(0)
+
+        # Load attachments with blobs to avoid N+1. RichText embeds per record
+        # are small, so loading is cheap and keeps this O(embeds).
+        Array(attachments.includes(:blob, :record)).each do |attachment|
+          if captured = attachment.send(:capture_bytes_used)
+            board_id, account_id, byte_size = captured
+            totals[[ board_id, account_id ]] += byte_size
+          end
+        end
+
+        totals
+      end
+  end
+
