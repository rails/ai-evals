new file mode 100644
index 0000000..53e4c95
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,28 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.order(:updated_at).to_a
+
+    Current.set(account: @account) do
+      mail(
+        to: @user.identity.email_address,
+        subject: digest_subject
+      )
+    end
+  end
+  alias_method :bundle, :digest
+  alias_method :bundle_email, :digest
+  alias_method :email_digest, :digest
+
+  private
+    def digest_subject
+      count = @notifications.size
+      if count == 1
+        "You have 1 new notification"
+      else
+        "You have #{count} new notifications"
+      end
+    end
+end
