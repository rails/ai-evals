@@ -0,0 +1,16 @@
+class Notification::BundleJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(notification_or_bundle, action: :bundle)
+    case action.to_sym
+    when :bundle
+      if notification_or_bundle.is_a?(Notification)
+        Notification::Bundle.bundle_notification(notification_or_bundle)
+      else
+        notification_or_bundle.deliver
+      end
+    when :deliver, :send, :email
+      notification_or_bundle.deliver
+    end
+  end
+end
