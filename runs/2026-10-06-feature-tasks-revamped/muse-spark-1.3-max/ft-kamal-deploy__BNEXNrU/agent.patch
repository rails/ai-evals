+# Fizzy Kamal secrets — single-box (SQLite) deployment.
+#
+# Secrets defined here are available under `registry/password`, `env/secret`,
+# and `builder/secrets` in config/deploy.yml.
+#
+# This file is safe for git: it contains NO raw credentials, only references
+# to ENV vars or password-manager lookups. Fill in the values in your shell
+# (or 1Password/Bitwarden/etc.) before running `bin/kamal setup`.
+#
+# Required before first deploy:
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export KAMAL_REGISTRY_PASSWORD=<docker-hub-token-or-ghcr-pat>
+#   export SMTP_PASSWORD=<your-smtp-password>
+#
+# Then verify with: `bin/kamal config` (should show no missing secrets).
+
+# Registry password (Docker Hub access token or GHCR PAT with write:packages).
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Rails secret (generate with `bin/rails secret`). Must stay stable across
+# deploys or all sessions will be invalidated.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# SMTP password for SMTP_USER_NAME in config/deploy.yml.
+# If your relay needs no auth, `export SMTP_PASSWORD=""`.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Uncomment if you use Rails credentials (config/credentials.yml.enc)
+# and the matching entry in config/deploy.yml `env.secret`:
+# RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+
+# Optional: Web Push (VAPID) keys for browser push notifications.
+# Generate with:
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}\nVAPID_PUBLIC_KEY=#{k.public_key}"'
+# Then uncomment the matching entries in config/deploy.yml `env.secret`.
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+
+# --- Alternative: fetch from password managers (uncomment to use) ---
+# 1Password (requires `op` CLI):
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy SECRET_KEY_BASE KAMAL_REGISTRY_PASSWORD SMTP_PASSWORD)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+#
+# Bitwarden (requires `bw` CLI):
+# SECRETS=$(kamal secrets fetch --adapter bitwarden --from Fizzy SECRET_KEY_BASE KAMAL_REGISTRY_PASSWORD SMTP_PASSWORD)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
