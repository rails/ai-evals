new file mode 100644
index 0000000..96e9a01
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,153 @@
+# Fizzy — single-box Kamal deployment (SQLite, one container, Kamal proxy SSL).
+#
+# This config deploys everything to ONE Linux server with Docker:
+#   - Rails web + Solid Queue jobs run together in a single container
+#     (via Solid Queue's Puma plugin, see SOLID_QUEUE_IN_PUMA below).
+#   - SQLite databases and Active Storage files live in /rails/storage,
+#     persisted in the `fizzy_storage` Docker volume so data survives redeploys.
+#   - Kamal proxy terminates SSL (Let's Encrypt) and serves https://your-host.
+#
+# To deploy your fork:
+#   1. Fill in HOSTNAME in three places below: `servers.web`, `proxy.host`,
+#      and `env.clear.APP_HOST` (they must all match, DNS must point there).
+#   2. Fill in `image` + `registry.username` with your container registry.
+#   3. Fill in your mail server under `env.clear` (SMTP_*) + `MAILER_FROM_ADDRESS`.
+#   4. Fill in `.kamal/secrets` (SECRET_KEY_BASE, SMTP_PASSWORD, registry password).
+#   5. Run `bin/kamal setup` once, then `bin/kamal deploy` for updates.
+#
+# See docs/self-hosting.md for the full step-by-step guide.
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+# TODO: Replace with your own registry repo, e.g. `your-dockerhub-user/fizzy`
+# or `ghcr.io/your-github-user/fizzy`.
+image: your-user/fizzy
+
+# Deploy to a single box. Everything (web + jobs) runs on this host.
+servers:
+  web:
+    # TODO: Replace with your server's IP or hostname (SSH target).
+    # Example: `192.168.0.1`, `fizzy.example.com`, or `root@203.0.113.10`
+    # (user defaults to root unless `ssh.user` is set below).
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt.
+# Kamal proxy terminates TLS and forwards plain HTTP to the container's port 80 (Thruster).
+proxy:
+  ssl: true
+  # TODO: Replace with your public hostname. Must resolve to the server above.
+  # This is where Fizzy will be reachable: https://fizzy.example.com
+  host: fizzy.example.com
+  # The container listens on 80 via Thruster (`./bin/thrust ./bin/rails server`).
+  # This is Kamal's default, made explicit for clarity.
+  app_port: 80
+  # Kamal proxy healthchecks the Rails health endpoint while booting.
+  healthcheck:
+    path: /up
+    interval: 3
+    timeout: 5
+
+# Credentials for your image host.
+# Defaults to Docker Hub. For GHCR, set `server: ghcr.io`.
+registry:
+  # server: ghcr.io
+  # TODO: Replace with your registry username.
+  username: your-user
+  # KAMAL_REGISTRY_PASSWORD comes from `.kamal/secrets`.
+  # For Docker Hub use an access token, for GHCR use a PAT with `write:packages`.
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run Solid Queue workers inside Puma so background jobs run on the box
+    # without a separate job container. This is ideal for one-box SQLite.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # SQLite is the default for OSS Fizzy. Made explicit so a forked
+    # environment can't accidentally pick up `mysql`.
+    DATABASE_ADAPTER: sqlite
+
+    # Canonical public hostname. Must match `proxy.host` above.
+    # Used for URLs in mailers and background jobs (see production.rb).
+    # TODO: Replace with your public hostname (no scheme, no trailing slash).
+    APP_HOST: fizzy.example.com
+
+    # Address shown in the From: header. Your SMTP provider may require
+    # this domain to be verified.
+    # TODO: Replace with your sender, e.g. "Fizzy <fizzy@example.com>".
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # Outgoing mail server. Fizzy sends magic-link login codes via email,
+    # so SMTP must work for logins to work.
+    # TODO: Fill in your provider (Postmark, Sendgrid, SES, Postfix, etc.).
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # HELO domain; defaults to APP_HOST when unset (see production.rb).
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_USER_NAME: fizzy
+    SMTP_AUTHENTICATION: login
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    # Uncomment if your provider needs implicit TLS (usually port 465).
+    # SMTP_TLS: true
+    # Timeouts in seconds.
+    SMTP_OPEN_TIMEOUT: 5
+    SMTP_READ_TIMEOUT: 5
+
+    # Optional tuning (uncomment to override defaults):
+    # Set number of Puma workers (default: CPU count).
+    # WEB_CONCURRENCY: 2
+    # Set number of Solid Queue processes (default: CPU count).
+    # JOB_CONCURRENCY: 1
+    # Rails log level (default: info).
+    # RAILS_LOG_LEVEL: info
+
+    # Optional push notifications (Web Push / VAPID). Leave unset to disable.
+    # Generate with: `bin/rails runner 'puts WebPush.generate_key.private_key'`
+    # and set the matching public key below, or via secrets.
+    # VAPID_PUBLIC_KEY: your-vapid-public-key
+  secret:
+    # Rails session/encryption secret. Generate with `bin/rails secret`
+    # and store in `.kamal/secrets` as SECRET_KEY_BASE.
+    - SECRET_KEY_BASE
+    # Uncomment if you use Rails credentials (config/credentials.yml.enc):
+    # - RAILS_MASTER_KEY
+    # SMTP password for SMTP_USER_NAME above. Stored in `.kamal/secrets`.
+    # If your relay needs no auth, leave SMTP_USER_NAME empty and set this to "".
+    - SMTP_PASSWORD
+    # Uncomment if you enabled Web Push above and prefer secrets for both keys:
+    # - VAPID_PRIVATE_KEY
+    # - VAPID_PUBLIC_KEY
+
+# Aliases are triggered with `bin/kamal <alias>`.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Persist SQLite (*.sqlite3) + Active Storage files across deploys.
+# Databases live in storage/*.sqlite3 and uploads in storage/production/files,
+# both under /rails/storage in the container.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  # Target architecture of your server. Most VPSs are amd64.
+  # For ARM servers (e.g. Ampere, Graviton, Raspberry Pi), use `arm64`.
+  arch: amd64
+  # Uncomment to build on a remote builder (faster amd64 builds from arm64 laptops):
+  # remote: ssh://docker@docker-builder-server
+
+# Use a different ssh user than root (uncomment if your box disables root SSH).
+# ssh:
+#   user: app
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..6234e60 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,66 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Self-hosted single-box (Kamal) configuration.
+  #
+  # Canonical public hostname for URLs generated in mailers, Active Storage,
+  # and background jobs. Set APP_HOST to your domain (e.g. fizzy.example.com).
+  # Must match `proxy.host` in config/deploy.yml. When unset (e.g. SaaS, which
+  # sets its own hosts), this block is skipped.
+  if (app_host = ENV["APP_HOST"].presence)
+    config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+  end
+
+  # SMTP delivery for self-hosted deployments. Configure via SMTP_* env vars
+  # in config/deploy.yml (see docs/self-hosting.md).
+  #
+  # Fizzy sends magic-link login codes via email, so SMTP must work for
+  # logins to work. When SMTP_ADDRESS is unset, Rails falls back to its
+  # default (localhost:25). SaaS sets its own smtp_settings and leaves
+  # SMTP_ADDRESS unset, so this block is skipped there.
+  #
+  # Supported vars:
+  #   SMTP_ADDRESS (required to enable), SMTP_PORT (default 587),
+  #   SMTP_DOMAIN (default APP_HOST), SMTP_USER_NAME, SMTP_PASSWORD,
+  #   SMTP_AUTHENTICATION (default "login" when user present, else none),
+  #   SMTP_ENABLE_STARTTLS_AUTO (default true), SMTP_TLS (default false,
+  #     set true for implicit TLS on port 465),
+  #   SMTP_OPEN_TIMEOUT / SMTP_READ_TIMEOUT (defaults 5s),
+  #   SMTP_OPENSSL_VERIFY_MODE (e.g. "none" for self-signed relays).
+  if ENV["SMTP_ADDRESS"].present?
+    smtp_domain = ENV["SMTP_DOMAIN"].presence || ENV["APP_HOST"].presence
+    smtp_user_name = ENV["SMTP_USER_NAME"].presence
+    smtp_authentication = ENV["SMTP_AUTHENTICATION"].presence || (smtp_user_name ? "login" : nil)
+    smtp_tls = ENV["SMTP_TLS"] == "true"
+
+    smtp_settings = {
+      address: ENV.fetch("SMTP_ADDRESS"),
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: smtp_domain,
+      user_name: smtp_user_name,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: smtp_authentication,
+      open_timeout: ENV.fetch("SMTP_OPEN_TIMEOUT", 5).to_i,
+      read_timeout: ENV.fetch("SMTP_READ_TIMEOUT", 5).to_i
+    }
+
+    # TLS (implicit TLS on port 465) and STARTTLS are mutually exclusive in
+    # the `mail` gem. Only set one.
+    if smtp_tls
+      smtp_settings[:tls] = true
+    else
+      smtp_settings[:enable_starttls_auto] = ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    end
+
+    if (verify_mode = ENV["SMTP_OPENSSL_VERIFY_MODE"].presence)
+      smtp_settings[:openssl_verify_mode] = verify_mode
+    end
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = smtp_settings.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/self-hosting.md b/docs/self-hosting.md
new file mode 100644
index 0000000..44758aa
--- /dev/null
+++ b/docs/self-hosting.md
@@ -0,0 +1,249 @@
+# Self-hosting Fizzy with Kamal (single box)
+
+This guide deploys Fizzy to **one Linux server with Docker** using [Kamal](https://kamal-deploy.org/).
+
+What you get:
+
+- Everything in **one container**: Rails web + background jobs (Solid Queue runs
+  inside Puma via `SOLID_QUEUE_IN_PUMA=true`, so no separate job host needed).
+- **SQLite** for all databases (`storage/*.sqlite3`) and local disk for uploads
+  (`storage/production/files`), persisted in the `fizzy_storage` Docker volume
+  so data survives `kamal deploy` / `kamal redeploy`.
+- **SSL from Kamal proxy** (Let's Encrypt) at `https://your-host`.
+- Outgoing mail via **your SMTP server** (required: Fizzy logs users in with
+  emailed magic-link codes).
+
+If you just want local development, see [development.md](development.md) instead.
+
+## Prerequisites
+
+1. **A Linux server with Docker** (any VPS: Hetzner, DigitalOcean, EC2, etc.).
+   - SSH access as `root` (or set `ssh.user` in `config/deploy.yml`).
+   - Docker will be installed by `kamal setup` if missing, but pre-installing
+     Docker is fine too.
+2. **A public hostname pointing at the server** (e.g. `fizzy.example.com`).
+   - Create an `A` record for the hostname → server IP.
+   - Kamal proxy will fetch a Let's Encrypt certificate on first deploy.
+3. **An SMTP server** for outgoing mail (Postmark, Sendgrid, SES, Mailgun,
+   your own Postfix, etc.).
+   - You need: host, port, username, password, and a verified `From:` domain.
+   - Fizzy sends login codes from `MAILER_FROM_ADDRESS`.
+4. **A container registry** to hold the built image:
+   - Docker Hub (default) with an access token, **or**
+   - GitHub Container Registry (`ghcr.io`) with a PAT (`write:packages`).
+5. **Kamal locally**: `bundle install` already includes `kamal` (`bin/kamal`).
+
+## Quick start (fork → `kamal setup` → https)
+
+### 1. Fork and clone
+
+Fork the repo on GitHub, then:
+
+```sh
+git clone https://github.com/YOUR-USER/fizzy.git
+cd fizzy
+bundle install
+```
+
+### 2. Edit `config/deploy.yml` (hostname, image, mail)
+
+Open [`config/deploy.yml`](../config/deploy.yml). Every place you must change
+is marked `TODO:`.
+
+**a) Hostname (3 places, must all match):**
+
+```yaml
+servers:
+  web:
+    - 203.0.113.10            # TODO: your server IP or SSH hostname
+
+proxy:
+  host: fizzy.example.com     # TODO: your public hostname
+
+env:
+  clear:
+    APP_HOST: fizzy.example.com  # TODO: same as proxy.host
+```
+
+- `servers.web` is the **SSH target** (IP is fine).
+- `proxy.host` is the **public URL host** (DNS must resolve there).
+- `APP_HOST` is used for URLs in mailers and jobs (must equal `proxy.host`).
+
+**b) Image + registry:**
+
+```yaml
+image: your-user/fizzy       # TODO: e.g. `alice/fizzy` or `ghcr.io/alice/fizzy`
+
+registry:
+  # server: ghcr.io          # uncomment for GHCR
+  username: your-user         # TODO: Docker Hub user or GitHub user
+```
+
+**c) Mail server:**
+
+```yaml
+env:
+  clear:
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>  # TODO: verified sender
+    SMTP_ADDRESS: smtp.example.com                  # TODO: your SMTP host
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com                  # TODO: usually your APP_HOST
+    SMTP_USER_NAME: fizzy                           # TODO: SMTP username
+    SMTP_AUTHENTICATION: login
+    SMTP_ENABLE_STARTTLS_AUTO: true
+```
+
+For implicit TLS (port 465), uncomment `SMTP_TLS: true` in the file.
+See `config/environments/production.rb` for all supported `SMTP_*` vars.
+
+### 3. Set secrets in `.kamal/secrets`
+
+[`.kamal/secrets`](../.kamal/secrets) is a template — it references ENV vars,
+so it is safe to commit. Export real values in your shell before deploying:
+
+```sh
+# Rails secret (keep stable across deploys or sessions invalidate)
+export SECRET_KEY_BASE=$(bin/rails secret)
+
+# Registry password (Docker Hub token or GHCR PAT)
+export KAMAL_REGISTRY_PASSWORD="dckr_pat_..."
+
+# SMTP password for SMTP_USER_NAME above (use "" if your relay needs no auth)
+export SMTP_PASSWORD="smtp-secret"
+```
+
+Verify Kamal sees them (should print config with no “missing secret” error):
+
+```sh
+bin/kamal config
+```
+
+> **Alternative:** use 1Password/Bitwarden via `kamal secrets fetch`.
+> See comments in `.kamal/secrets`.
+
+### 4. First deploy
+
+```sh
+bin/kamal setup
+```
+
+This will:
+
+- Bootstrap Docker on the server (if needed),
+- Start Kamal proxy with SSL for your `proxy.host`,
+- Build the image, push to your registry, pull on the server,
+- Create the `fizzy_storage` volume, run `db:prepare` (creates SQLite files),
+- Boot the container and wait for `/up` to return 200.
+
+Then visit:
+
+```
+https://fizzy.example.com
+```
+
+Sign up with your email — the login code arrives via your SMTP server.
+
+### 5. Updates
+
+```sh
+bin/kamal deploy      # build + push + rolling restart (data persists)
+bin/kamal redeploy    # same, without re-bootstrapping
+```
+
+Data persists because `fizzy_storage:/rails/storage` is a Docker volume that
+is reused across deploys. SQLite files (`storage/production*.sqlite3`) and
+uploads (`storage/production/files`) live there.
+
+## How it works
+
+| Concern | Where | Notes |
+|---|---|---|
+| One container | `config/deploy.yml` `servers.web` (single host) + `Dockerfile` `CMD ["./bin/thrust", "./bin/rails", "server"]` | Thruster (port 80) → Puma (port 3000). |
+| Jobs on the box | `SOLID_QUEUE_IN_PUMA=true` + `config/puma.rb` `plugin :solid_queue` | No separate `servers.jobs` role needed for one box. Recurring jobs from `config/recurring.yml` run here too. |
+| SQLite | `DATABASE_ADAPTER=sqlite` + `config/database.sqlite.yml` | `storage/production.sqlite3`, `..._cable.sqlite3`, `..._cache.sqlite3`, `..._queue.sqlite3`. Created by `bin/docker-entrypoint` via `db:prepare`. |
+| Uploads | `ACTIVE_STORAGE_SERVICE=local` (default) + `config/storage.oss.yml` | `storage/production/files`. |
+| Persistence | `volumes: ["fizzy_storage:/rails/storage"]` | Docker volume survives deploys. Back it up (see below). |
+| SSL | `proxy.ssl: true` + `proxy.host` | Kamal proxy terminates TLS, forwards to `:80`. `assume_ssl`/`force_ssl` stay `true` in `production.rb`. |
+| Host URLs | `APP_HOST` → `production.rb` `default_url_options` | Mailers/jobs generate `https://APP_HOST/...`. |
+| Mail | `SMTP_*` + `MAILER_FROM_ADDRESS` → `production.rb` `smtp_settings` + `ApplicationMailer` | Delivery method `:smtp` only when `SMTP_ADDRESS` is set. |
+| Secrets | `.kamal/secrets` → `env.secret` + `registry.password` | `SECRET_KEY_BASE`, `SMTP_PASSWORD`, `KAMAL_REGISTRY_PASSWORD`. |
+| Assets | `asset_path: /rails/public/assets` | Bridges fingerprinted assets across versions (no 404s on deploy). |
+| Health | `proxy.healthcheck.path: /up` → `rails/health#show` | Kamal waits for 200 before routing traffic. |
+
+## Useful commands
+
+```sh
+bin/kamal console   # Rails console on the server
+bin/kamal shell     # bash in the app container
+bin/kamal logs -f   # tail app logs (alias: `logs`)
+bin/kamal app logs -f
+bin/kamal proxy logs -f
+bin/kamal details   # containers, images, proxy status
+bin/kamal dbc       # sqlite console (dbconsole)
+```
+
+Mission Control (jobs dashboard) is mounted at `/admin/jobs` (no auth by
+default in OSS — protect it via firewall, VPN, or by enabling auth in
+`config/application.rb` if exposed publicly).
+
+## Backups
+
+All state is in the `fizzy_storage` Docker volume on the server:
+
+- SQLite: `production.sqlite3`, `production_cable.sqlite3`,
+  `production_cache.sqlite3`, `production_queue.sqlite3`
+- Uploads: `production/files/`
+
+Simple file backup (run on the server or via `ssh`):
+
+```sh
+# Find the volume path
+docker volume inspect fizzy_storage --format '{{ .Mountpoint }}'
+
+# Stop the app, copy, restart (keeps SQLite consistent)
+bin/kamal app stop
+sudo tar -czf fizzy-storage-$(date +%F).tgz -C /var/lib/docker/volumes/fizzy_storage/_data .
+bin/kamal app start
+```
+
+Or use SQLite's online backup from the console (`bin/kamal console`) without
+downtime, plus `rsync` for `storage/production/files`.
+
+## Troubleshooting
+
+- **`bin/kamal config` complains about missing secrets**: `export` the three
+  vars in §3 in the same shell, or wire up your password manager.
+- **SSL / Let's Encrypt fails**: DNS must resolve `proxy.host` → server **before**
+  `setup`, and ports 80/443 must be reachable. Check `bin/kamal proxy logs -f`.
+- **Login emails never arrive**: check `SMTP_*` + `MAILER_FROM_ADDRESS`,
+  then `bin/kamal app logs -f` for `Net::SMTP*` errors. Many providers require
+  the `From:` domain to be verified and port 587 with STARTTLS.
+- **Permission denied on `/rails/storage`**: the image runs as user `rails`
+  (uid 1000). If you pre-created the volume as root with strict perms, remove
+  it (`docker volume rm fizzy_storage` on the server, data will be lost) and
+  let Kamal recreate it on next `setup`.
+- **Wrong arch (`exec format error`)**: set `builder.arch` to your server's
+  arch (`amd64` vs `arm64`) in `config/deploy.yml`.
+- **Jobs not running**: ensure `SOLID_QUEUE_IN_PUMA=true` (default in this
+  config) and check `/admin/jobs` + `bin/kamal app logs -f` for Solid Queue
+  output. For heavy workloads, split jobs to a dedicated host (see below).
+
+## Scaling beyond one box
+
+This config is intentionally minimal. When you outgrow it:
+
+- Add a `servers.jobs` role with `cmd: bin/jobs` and set
+  `SOLID_QUEUE_IN_PUMA=false` on `web` (see commented example in stock
+  `kamal init` templates).
+- Move SQLite → MySQL (`DATABASE_ADAPTER=mysql`, see
+  `config/database.mysql.yml`) and local disk → S3
+  (`ACTIVE_STORAGE_SERVICE=s3`, see `config/storage.oss.yml`).
+- Terminate SSL at a load balancer and set `proxy.ssl: false` on app hosts
+  (see `saas/config/deploy.*.yml` for 37signals' multi-DC setup).
