--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,31 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :set_board
+  before_action :ensure_admin
+
+  def create
+    @board.publish!
+
+    respond_to do |format|
+      format.html { redirect_to @board, notice: "Board published" }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish!
+
+    respond_to do |format|
+      format.html { redirect_to @board, notice: "Board unpublished" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      if Current.user&.admin?
+        @board = Current.account.boards.find(params[:board_id])
+      else
+        @board = Current.user.boards.find(params[:board_id])
+      end
+    end
+end
