diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..90a25b3
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,42 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_token, uniqueness: { allow_nil: true }
+
+    scope :published, -> { where.not(public_token: nil) }
+
+    alias_attribute :public_key, :public_token
+
+    after_update_commit -> { cards.touch_all }, if: :saved_change_to_public_token?
+  end
+
+  def published?
+    public_token.present?
+  end
+
+  def public?
+    published?
+  end
+
+  def publish!
+    if public_token.blank?
+      update! public_token: self.class.generate_unique_public_token
+    end
+
+    self
+  end
+
+  def unpublish!
+    update! public_token: nil
+  end
+
+  class_methods do
+    def generate_unique_public_token
+      loop do
+        token = SecureRandom.urlsafe_base64(32)
+        break token unless exists?(public_token: token)
+      end
+    end
+  end
+end
