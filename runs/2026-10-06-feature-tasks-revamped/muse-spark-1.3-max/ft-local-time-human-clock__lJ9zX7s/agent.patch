diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..dbf6535 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,150 @@
 module TimeHelper
+  # Renders a timestamp for client-side formatting in the viewer's own timezone.
+  #
+  # The server sends the raw timestamp in `datetime` (UTC ISO8601) plus a
+  # timezone-agnostic UTC fallback. The `time` Stimulus controller turns it into
+  # words like "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow" or
+  # "in 3 days" using the browser's timezone, so cached HTML can be shared.
+  #
+  # Formats:
+  #   :smart (default) - today: "1:42 PM", yesterday/tomorrow: words,
+  #                       within a week: "5 days ago"/"in 3 days", older: "Sep 12"
+  #   :relative        - always relative: "2 hours ago", "yesterday", "5 days ago",
+  #                       "tomorrow", "in 3 days"
+  #   :time            - "1:42 PM"
+  #   :date            - "Sep 12"
+  #   :date_with_year  - "Sep 12, 2025"
+  #   :weekday         - "Wednesday, January 22"
+  #   :datetime        - "1/22/25, 1:42 PM"
+  def local_time(time, format: :smart, **options)
+    return "" if time.nil?
+
+    utc_time = time_to_utc(time)
+    iso = utc_time.iso8601
+    format_name = format.to_s
+
+    data = options.delete(:data) || {}
+    # Allow both `time` and `local-time` controllers; primary is `time`.
+    data[:controller] = [ data[:controller], "time" ].compact.join(" ").strip
+    data[:time_format_value] = format_name
+    data[:time_datetime_value] = iso
+
+    fallback = utc_fallback(utc_time, format_name)
+
+    tag.time fallback, datetime: iso, data: data, **options
+  end
+
+  # Aliases for convenience and backwards compatibility with different namings.
+  def relative_time(time, **options)
+    local_time(time, format: :relative, **options)
+  end
+
+  def smart_time(time, **options)
+    local_time(time, format: :smart, **options)
+  end
+
+  def fuzzy_time(time, **options)
+    local_time(time, format: :smart, **options)
+  end
+
+  def local_relative_time(time, **options)
+    local_time(time, format: :relative, **options)
+  end
+
+  private
+    def time_to_utc(time)
+      if time.respond_to?(:utc)
+        time.utc
+      elsif time.is_a?(Date) && !time.is_a?(DateTime)
+        time.to_time.utc
+      else
+        Time.zone.parse(time.to_s).utc
+      end
+    end
+
+    def utc_fallback(utc_time, format_name)
+      case format_name.to_s.tr("-", "_")
+      when "time"
+        utc_time.strftime("%l:%M %p").strip
+      when "date"
+        utc_time.strftime("%b %-d")
+      when "date_with_year"
+        utc_time.strftime("%b %-d, %Y")
+      when "weekday", "weekday_date", "day"
+        utc_time.strftime("%A, %B %-d")
+      when "datetime", "date_time"
+        utc_time.strftime("%-m/%-d/%y, %l:%M %p").strip
+      when "relative", "relative_time", "ago"
+        utc_relative_fallback(utc_time)
+      when "smart", "fuzzy", "comment", "default"
+        utc_smart_fallback(utc_time)
+      else
+        utc_smart_fallback(utc_time)
+      end
+    end
+
+    def utc_smart_fallback(utc_time)
+      now = Time.current.utc
+      days = (utc_time.to_date - now.to_date).to_i
+
+      if days == 0
+        utc_time.strftime("%l:%M %p").strip
+      elsif days == -1
+        "yesterday"
+      elsif days == 1
+        "tomorrow"
+      elsif days < 0 && days >= -6
+        "#{days.abs} days ago"
+      elsif days > 0 && days <= 6
+        "in #{days} days"
+      elsif utc_time.year == now.year
+        utc_time.strftime("%b %-d")
+      else
+        utc_time.strftime("%b %-d, %Y")
+      end
+    end
+
+    def utc_relative_fallback(utc_time)
+      now = Time.current.utc
+      days = (utc_time.to_date - now.to_date).to_i
+
+      if days == 0
+        diff = (utc_time - now).to_i
+        abs_seconds = diff.abs
+
+        if abs_seconds < 60
+          "just now"
+        elsif (abs_minutes = abs_seconds / 60) < 60
+          diff < 0 ? "#{abs_minutes} minute#{'s' unless abs_minutes == 1} ago" : "in #{abs_minutes} minute#{'s' unless abs_minutes == 1}"
+        else
+          abs_hours = abs_minutes / 60
+          diff < 0 ? "#{abs_hours} hour#{'s' unless abs_hours == 1} ago" : "in #{abs_hours} hour#{'s' unless abs_hours == 1}"
+        end
+      elsif days == -1
+        "yesterday"
+      elsif days == 1
+        "tomorrow"
+      elsif days < 0
+        abs_days = days.abs
+        if abs_days < 30
+          "#{abs_days} days ago"
+        elsif abs_days < 365
+          months = (abs_days / 30.0).round
+          months <= 1 ? "about 1 month ago" : "#{months} months ago"
+        else
+          years = (abs_days / 365.0).round
+          years <= 1 ? "about 1 year ago" : "#{years} years ago"
+        end
+      else
+        if days < 30
+          "in #{days} days"
+        elsif days < 365
+          months = (days / 30.0).round
+          months <= 1 ? "in about 1 month" : "in #{months} months"
+        else
+          years = (days / 365.0).round
+          years <= 1 ? "in about 1 year" : "in #{years} years"
+        end
+      end
+    end
 end
