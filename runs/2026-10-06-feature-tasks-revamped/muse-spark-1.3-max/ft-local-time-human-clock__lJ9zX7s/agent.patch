diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..bdf6dde
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatByName, formatFull } from "helpers/date_helpers"
+
+// Renders a raw timestamp in the viewer's own timezone.
+//
+// The server sends `<time datetime="2025-01-22T17:30:00Z" data-controller="time"
+// data-time-format-value="smart">` and this controller turns it into words like
+// "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow" or "in 3 days".
+export default class extends Controller {
+  static values = { format: { type: String, default: "smart" }, datetime: String }
+
+  connect() {
+    this.render()
+  }
+
+  datetimeValueChanged() {
+    if (this.element.isConnected) this.render()
+  }
+
+  formatValueChanged() {
+    if (this.element.isConnected) this.render()
+  }
+
+  render() {
+    const datetime = this.datetimeValue || this.element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date)) return
+
+    this.element.textContent = formatByName(this.formatValue, date, new Date())
+    this.element.setAttribute("title", formatFull(date))
+
+    // Keep bridge attributes in sync when this time backs a native stamp.
+    const stamp = this.element.closest("[data-bridge--stamp-scope-selector-value], [data-controller*='bridge--stamp']")
+    if (stamp && stamp.hasAttribute("data-bridge-description")) {
+      stamp.setAttribute("data-bridge-description", this.element.textContent)
+    }
+  }
+}
