+<% if Current.user.admin? %>
+  <section class="settings__section">
+    <header>
+      <h2 class="divider">Plan</h2>
+      <div>Current plan: <strong><%= Current.account.respond_to?(:plan_name) ? Current.account.plan_name : "Free" %></strong></div>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <% if Current.account.respond_to?(:comped?) && Current.account.comped? %>
+        <div class="txt-small">
+          This account is comped (unlimited cards and storage).
+        </div>
+      <% elsif Current.account.respond_to?(:free?) && Current.account.free? %>
+        <div class="txt-small">
+          Free includes 1,000 cards and 1 GB storage.
+          <% if Current.account.respond_to?(:cards_remaining) && Current.account.cards_remaining != Float::INFINITY %>
+            <br><%= pluralize(Current.account.cards_remaining, "card") %> left.
+          <% end %>
+        </div>
+        <div class="flex gap-half">
+          <%= link_to "Upgrade", "#{Current.account.slug}/billing/checkout?plan=unlimited", class: "btn btn--reversed", data: { turbo: false } %>
+        </div>
+        <div class="txt-small">
+          <%= link_to "Upgrade to Unlimited — $20/month, 5 GB", "#{Current.account.slug}/billing/checkout?plan=unlimited", data: { turbo: false } %><br>
+          <%= link_to "Upgrade to Unlimited+ — $25/month, 500 GB", "#{Current.account.slug}/billing/checkout?plan=unlimited_plus", data: { turbo: false } %>
+        </div>
+      <% else %>
+        <div class="txt-small">
+          <strong><%= Current.account.plan_name %></strong> plan active.
+          <% if Current.account.subscription&.current_period_end.present? %>
+            <br>Renews <%= Current.account.subscription.current_period_end.to_date %>
+          <% end %>
+        </div>
+        <div class="flex gap-half">
+          <%= link_to "Manage billing", "#{Current.account.slug}/billing/portal", class: "btn", data: { turbo: false } %>
+          <% if Current.account.respond_to?(:plan_key) && Current.account.plan_key == "unlimited" %>
+            <%= link_to "Upgrade", "#{Current.account.slug}/billing/checkout?plan=unlimited_plus", class: "btn btn--reversed", data: { turbo: false } %>
+          <% end %>
+        </div>
+      <% end %>
+    </div>
+  </section>
+<% end %>
