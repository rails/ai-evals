+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= @account.name %></h2>
+      <div class="txt-x-small txt-ink-medium">
+        #<%= @account.external_account_id %> •
+        <%= @account.cards_count %> cards •
+        Plan: <%= @account.respond_to?(:plan_name) ? @account.plan_name : "Free" %>
+        <% if @account.respond_to?(:comped?) && @account.comped? %>
+          • Comped
+        <% end %>
+      </div>
+    </header>
+
+    <div class="flex flex-column gap margin-block-half">
+      <div class="flex gap-half">
+        <%= button_to "Comp", "/admin/accounts/#{@account.id}/comp", method: :post, class: "btn" %>
+        <%= button_to "Uncomp", "/admin/accounts/#{@account.id}/uncomp", method: :post, class: "btn" %>
+      </div>
+
+      <div>
+        <h3>Limits Override</h3>
+        <p class="txt-small">
+          Actual: <%= @account.cards_count %> cards<br>
+          Effective: <%= @account.respond_to?(:effective_cards_count) ? @account.effective_cards_count : @account.cards_count %> cards,
+          <%= @account.respond_to?(:bytes_used) ? @account.bytes_used : "unknown" %> bytes used
+        </p>
+
+        <%= form_with url: "/admin/accounts/#{@account.id}/override", method: :patch, class: "flex flex-column gap-half" do |form| %>
+          <div>
+            <%= form.label :card_count, "Card count" %>
+            <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+          </div>
+          <div>
+            <%= form.label :bytes_used, "Bytes used" %>
+            <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+          </div>
+          <div class="flex gap-half">
+            <%= form.submit "Override", class: "btn btn--reversed" %>
+          </div>
+        <% end %>
+
+        <div class="margin-block-start-half">
+          <%= button_to "Reset", "/admin/accounts/#{@account.id}/reset", method: :delete, class: "btn" %>
+        </div>
+      </div>
+
+      <div>
+        <h3>Subscription</h3>
+        <% if @account.subscription.present? %>
+          <p class="txt-small">
+            Plan: <%= @account.subscription.plan_key %> (<%= @account.subscription.plan_name %>)<br>
+            Status: <%= @account.subscription.status %><br>
+            Customer: <%= @account.subscription.stripe_customer_id %><br>
+            Subscription: <%= @account.subscription.stripe_subscription_id %>
+          </p>
+        <% else %>
+          <p class="txt-small">No subscription (Free)</p>
+        <% end %>
+      </div>
+
+      <div>
+        <%= link_to "Back to accounts", "/admin/accounts", class: "btn btn--link" %>
+      </div>
+    </div>
+  </div>
+</section>
