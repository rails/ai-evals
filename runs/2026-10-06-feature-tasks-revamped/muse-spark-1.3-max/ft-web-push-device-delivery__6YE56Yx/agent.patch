new file mode 100644
index 0000000..7fd8616
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,71 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key p256dh auth keys ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @subscription.assign_attributes(subscription_params)
+
+    if @subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { render json: { id: @subscription.id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: @subscription.errors.full_messages.to_sentence }
+        format.json { render json: @subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @subscription = find_subscription
+    @subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      raw = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key, :p256dh, :auth, keys: [ :p256dh, :auth ] ])
+
+      keys = raw[:keys] || {}
+
+      {
+        endpoint: raw[:endpoint],
+        p256dh_key: raw[:p256dh_key] || raw[:p256dh] || keys[:p256dh],
+        auth_key: raw[:auth_key] || raw[:auth] || keys[:auth]
+      }.compact
+    end
+
+    def find_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id]) ||
+          @user.push_subscriptions.find_by(endpoint: params[:id]) ||
+          find_by_endpoint_param
+      else
+        find_by_endpoint_param
+      end
+    end
+
+    def find_by_endpoint_param
+      endpoint = params[:endpoint] || params.dig(:push_subscription, :endpoint)
+      if endpoint.present?
+        @user.push_subscriptions.find_by(endpoint: endpoint)
+      end
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1196f7a
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,153 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "status", "enableButton", "disableButton", "explainer" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    this.updateState()
+
+    if (this.#supported) {
+      try {
+        const registration = await navigator.serviceWorker.ready
+        const subscription = await registration.pushManager.getSubscription()
+        this.#setOn(subscription !== null)
+      } catch {
+        this.#setOn(false)
+      }
+    } else {
+      this.#setOn(false)
+    }
+
+    this.#updateDetailsVisibility()
+  }
+
+  async enable(event) {
+    event?.preventDefault()
+
+    if (!this.#supported) return
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission !== "granted") {
+        this.#updateDetailsVisibility()
+        return
+      }
+
+      const registration = await navigator.serviceWorker.ready
+      let subscription = await registration.pushManager.getSubscription()
+
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+      }
+
+      await this.#saveSubscription(subscription)
+      this.#setOn(true)
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+    } finally {
+      this.#updateDetailsVisibility()
+    }
+  }
+
+  async disable(event) {
+    event?.preventDefault()
+
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        const endpoint = subscription.endpoint
+        await subscription.unsubscribe()
+        await this.#deleteSubscription(endpoint)
+      }
+    } catch (error) {
+      console.error("Failed to disable push notifications", error)
+    } finally {
+      this.#setOn(false)
+      this.#updateDetailsVisibility()
+    }
+  }
+
+  updateState() {
+    this.#updateDetailsVisibility()
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    return this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  #setOn(on) {
+    this.element.classList.toggle("notifications--on", on)
+
+    if (this.hasEnableButtonTarget) {
+      this.enableButtonTarget.hidden = on
+    }
+
+    if (this.hasDisableButtonTarget) {
+      this.disableButtonTarget.hidden = !on
+    }
+  }
+
+  #updateDetailsVisibility() {
+    const blocked = this.#supported && Notification.permission === "denied"
+
+    this.detailsTargets.forEach((element) => {
+      element.hidden = !blocked
+    })
+
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = blocked
+    }
+  }
+
+  async #saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  async #deleteSubscription(endpoint) {
+    await destroy(this.subscriptionUrlValue, {
+      body: { push_subscription: { endpoint } },
+      responseKind: "json"
+    })
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
