diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..5bc0194 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,36 @@
 module TimeHelper
+  def formatted_time_tag(time, format: :relative, **options)
+    if time.blank?
+      ""
+    else
+      iso = time_in_utc(time).iso8601
+      data = options.delete(:data) || {}
+      data[:controller] = [ data[:controller], "time" ].compact.join(" ").strip
+      data[:action] = [ data[:action], "turbo:morph-element->time#update" ].compact.join(" ").strip
+      data[:time_format_value] = format.to_s
+
+      tag.time iso, datetime: iso, title: iso, data: data, **options
+    end
+  end
+
+  def relative_time_tag(time, **options)
+    formatted_time_tag(time, format: :relative, **options)
+  end
+
+  def calendar_time_tag(time, **options)
+    formatted_time_tag(time, format: :calendar, **options)
+  end
+
+  def local_time_tag(time, format: :relative, **options)
+    formatted_time_tag(time, format: format, **options)
+  end
+
+  private
+    def time_in_utc(time)
+      if time.respond_to?(:utc)
+        time.utc
+      else
+        time.to_time.utc
+      end
+    end
 end
