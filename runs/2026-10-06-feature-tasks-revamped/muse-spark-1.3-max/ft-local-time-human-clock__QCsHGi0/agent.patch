diff --git a/app/javascript/controllers/time_controller.js b/app/javascript/controllers/time_controller.js
new file mode 100644
index 0000000..b99c938
--- /dev/null
+++ b/app/javascript/controllers/time_controller.js
@@ -0,0 +1,52 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatWithFormat, formatFullDatetime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.update()
+    this.#startRefreshing()
+  }
+
+  disconnect() {
+    this.#stopRefreshing()
+  }
+
+  formatValueChanged() {
+    this.update()
+  }
+
+  update() {
+    const datetime = this.element.getAttribute("datetime")
+
+    if (!datetime) {
+      return
+    }
+
+    const date = new Date(datetime)
+
+    if (isNaN(date.getTime())) {
+      return
+    }
+
+    this.element.textContent = formatWithFormat(date, this.formatValue)
+    this.element.setAttribute("title", formatFullDatetime(date))
+  }
+
+  #startRefreshing() {
+    this.#stopRefreshing()
+    this.#timer = setInterval(() => this.update(), REFRESH_INTERVAL)
+  }
+
+  #stopRefreshing() {
+    if (this.#timer) {
+      clearInterval(this.#timer)
+      this.#timer = null
+    }
+  }
+}
