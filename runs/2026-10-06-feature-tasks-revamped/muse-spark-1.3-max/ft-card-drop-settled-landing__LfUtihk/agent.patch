diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..dbcc892
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,245 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoveredContainer = null
+    this.dragCounters = new WeakMap()
+  }
+
+  disconnect() {
+    this.#clearDragState()
+  }
+
+  itemTargetConnected(element) {
+    if (!element.hasAttribute("draggable")) {
+      element.setAttribute("draggable", "true")
+    } else if (element.getAttribute("draggable") !== "true") {
+      element.setAttribute("draggable", "true")
+    }
+  }
+
+  dragstart(event) {
+    const item = event.target.closest?.('[data-drag-and-drop-target="item"]') || event.currentTarget
+    if (!item || !this.element.contains(item)) return
+
+    this.draggedItem = item
+    this.sourceContainer = item.closest('[data-drag-and-drop-target="container"]')
+
+    item.classList.add(DRAGGED_ITEM_CLASS)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id || "card")
+      } catch {
+        // Some browsers restrict setData; dragging still works via internal state
+      }
+    }
+  }
+
+  dragend(event) {
+    this.#clearDragState()
+  }
+
+  dragenter(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFromEvent(event)
+    if (!container) return
+
+    event.preventDefault()
+
+    const count = (this.dragCounters.get(container) || 0) + 1
+    this.dragCounters.set(container, count)
+
+    this.#setHoveredContainer(container)
+  }
+
+  dragover(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFromEvent(event)
+    if (!container) return
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    this.#setHoveredContainer(container)
+  }
+
+  dragleave(event) {
+    const container = this.#containerFromEvent(event)
+    if (!container) return
+
+    const count = Math.max((this.dragCounters.get(container) || 1) - 1, 0)
+    this.dragCounters.set(container, count)
+
+    if (count === 0 && this.hoveredContainer === container) {
+      container.classList.remove(HOVER_CONTAINER_CLASS)
+      this.hoveredContainer = null
+    }
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const targetContainer = this.#containerFromEvent(event)
+    const draggedItem = this.draggedItem
+    const sourceContainer = this.sourceContainer
+
+    if (!draggedItem || !targetContainer) {
+      this.#clearDragState()
+      return
+    }
+
+    if (sourceContainer === targetContainer) {
+      this.#clearDragState()
+      return
+    }
+
+    // Move instantly, before saving, so the board is already the way it was left.
+    this.#moveCardToContainer(draggedItem, sourceContainer, targetContainer)
+
+    const persistPromise = this.#persistMove(draggedItem, targetContainer)
+
+    // Clear visual state synchronously so nothing shifts after the save resolves.
+    this.#clearDragState()
+
+    // Fire and forget; failures keep the optimistic position and only log.
+    persistPromise.catch((error) => {
+      console.error("Drag and drop save failed", error)
+    })
+  }
+
+  // Private
+
+  #containerFromEvent(event) {
+    if (event.currentTarget?.matches?.('[data-drag-and-drop-target="container"]')) {
+      return event.currentTarget
+    }
+
+    return event.target.closest?.('[data-drag-and-drop-target="container"]')
+  }
+
+  #setHoveredContainer(container) {
+    if (this.hoveredContainer && this.hoveredContainer !== container) {
+      this.hoveredContainer.classList.remove(HOVER_CONTAINER_CLASS)
+      this.dragCounters.set(this.hoveredContainer, 0)
+    }
+
+    this.hoveredContainer = container
+    container.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #moveCardToContainer(card, sourceContainer, targetContainer) {
+    const targetList = targetContainer.querySelector(".cards__list")
+    if (!targetList) return
+
+    const insertParent = targetList.querySelector("turbo-frame") || targetList
+    const insertBefore = this.#insertionPoint(insertParent, card, targetContainer)
+
+    if (insertBefore) {
+      insertParent.insertBefore(card, insertBefore)
+    } else {
+      insertParent.prepend(card)
+    }
+
+    this.#updateCounts(sourceContainer, targetContainer)
+  }
+
+  #insertionPoint(insertParent, draggedCard, targetContainer) {
+    const kind = targetContainer.dataset.dropKind
+
+    if ((kind === "column" || kind === "stream") && !draggedCard.classList.contains("golden-effect")) {
+      const firstNonGolden = Array.from(insertParent.querySelectorAll(".card")).find((element) => {
+        return !element.classList.contains("golden-effect") && element !== draggedCard
+      })
+
+      if (firstNonGolden) return firstNonGolden
+    }
+
+    const firstCard = insertParent.querySelector(".card")
+    if (firstCard && firstCard !== draggedCard) return firstCard
+
+    return null
+  }
+
+  #updateCounts(sourceContainer, targetContainer) {
+    if (sourceContainer) this.#adjustCount(sourceContainer, -1)
+    if (targetContainer) this.#adjustCount(targetContainer, 1)
+  }
+
+  #adjustCount(container, delta) {
+    const countElement = container.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentText = countElement.textContent.trim()
+    const isCapped = currentText.endsWith("+")
+    const currentValue = parseInt(currentText, 10)
+
+    if (Number.isNaN(currentValue)) return
+    if (isCapped && currentValue >= 99 && delta > 0) return
+
+    const nextValue = Math.max(currentValue + delta, 0)
+
+    if (isCapped && nextValue >= 99) {
+      countElement.textContent = "99+"
+    } else {
+      countElement.textContent = String(nextValue)
+    }
+  }
+
+  async #persistMove(card, targetContainer) {
+    const kind = targetContainer.dataset.dropKind
+    const columnId = targetContainer.dataset.columnId
+
+    const triageUrl = card.dataset.cardTriageUrl
+    const closureUrl = card.dataset.cardClosureUrl
+    const notNowUrl = card.dataset.cardNotNowUrl
+
+    if (kind === "column" && columnId && triageUrl) {
+      const url = `${triageUrl}?column_id=${encodeURIComponent(columnId)}`
+      await post(url, { responseKind: "json" })
+    } else if (kind === "stream" && triageUrl) {
+      await destroy(triageUrl, { responseKind: "json" })
+    } else if (kind === "closed" && closureUrl) {
+      await post(closureUrl, { responseKind: "json" })
+    } else if (kind === "not_now" && notNowUrl) {
+      await post(notNowUrl, { responseKind: "json" })
+    }
+  }
+
+  #clearDragState() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(DRAGGED_ITEM_CLASS)
+    }
+
+    this.#clearHoveredContainer()
+
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  #clearHoveredContainer() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(HOVER_CONTAINER_CLASS)
+      this.dragCounters.set(this.hoveredContainer, 0)
+      this.hoveredContainer = null
+    }
+
+    for (const container of this.containerTargets) {
+      container.classList.remove(HOVER_CONTAINER_CLASS)
+      this.dragCounters.set(container, 0)
+    }
+  }
+}
