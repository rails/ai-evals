+class MagicLinkMailer < ApplicationMailer
+  def code(magic_link)
+    @magic_link = magic_link
+    @code = magic_link.code
+    @email_address = magic_link.email_address
+
+    mail to: @email_address, subject: "#{@code} is your Fizzy code"
+  end
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..cb9d07d
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,60 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  before_create :generate_code, if: -> { code.blank? }
+  before_create :set_expiry, if: -> { expires_at.blank? }
+
+  def self.create_and_deliver(email_address)
+    magic_link = create!(email_address: email_address)
+
+    Rails.logger.info "Verification code for #{magic_link.email_address}: #{magic_link.code}"
+
+    MagicLinkMailer.code(magic_link).deliver_later
+
+    magic_link
+  end
+
+  def self.authenticate(email_address, code)
+    normalized_email = email_address.to_s.strip.downcase
+    normalized_code = code.to_s.strip.upcase
+
+    return nil if normalized_email.blank? || normalized_code.blank?
+
+    where(email_address: normalized_email, code: normalized_code)
+      .where("expires_at > ?", Time.current)
+      .order(created_at: :desc)
+      .first
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def verify?(attempt)
+    !expired? && code == attempt.to_s.strip.upcase
+  end
+
+  def pending_token
+    signed_id(purpose: :magic_link, expires_in: LIFETIME)
+  end
+
+  def self.find_by_pending_token(token)
+    find_signed(token, purpose: :magic_link)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    nil
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expiry
+      self.expires_at = LIFETIME.from_now
+    end
+end
