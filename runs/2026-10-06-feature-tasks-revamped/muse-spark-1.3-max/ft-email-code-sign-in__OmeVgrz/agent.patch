new file mode 100644
index 0000000..a9acc0d
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authenticatable.rb
@@ -0,0 +1,60 @@
+module MagicLinkAuthenticatable
+  extend ActiveSupport::Concern
+
+  private
+    def pending_authentication_token
+      cookies[:pending_authentication_token] || params[:pending_authentication_token]
+    end
+
+    def set_pending_authentication_token(token)
+      cookies[:pending_authentication_token] = {
+        value: token,
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::LIFETIME.from_now
+      }
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
+
+    def code_from_params
+      raw = request.request_parameters[:code] if request.request_parameters.key?("code") || request.request_parameters.key?(:code)
+      raw ||= params[:code] unless join_code_path_collision?
+      raw ||= params.dig(:magic_link, :code)
+      raw ||= params.dig(:signup, :code)
+      raw ||= params.dig(:session, :code)
+      raw.to_s.strip
+    end
+
+    def join_code_path_collision?
+      # When the route uses :code for the join code (e.g. /join/:code),
+      # params[:code] is the path param, not the body. Body is in request_parameters.
+      request.path_parameters.key?("code") || request.path_parameters.key?(:code)
+    end
+
+    def email_address_from_params
+      raw = params[:email_address]
+      raw ||= params.dig(:signup, :email_address)
+      raw ||= params.dig(:session, :email_address)
+      raw ||= params.dig(:magic_link, :email_address)
+      raw.to_s.strip
+    end
+
+    def find_pending_magic_link
+      token = pending_authentication_token
+      MagicLink.find_by_pending_token(token) if token.present?
+    end
+
+    def authenticate_magic_code(code: code_from_params, email_address: nil)
+      token = pending_authentication_token
+      pending = MagicLink.find_by_pending_token(token) if token.present?
+
+      email = pending&.email_address.presence || email_address.presence || email_address_from_params.presence
+
+      return nil if email.blank? || code.blank?
+
+      MagicLink.authenticate(email, code)
+    end
+end
