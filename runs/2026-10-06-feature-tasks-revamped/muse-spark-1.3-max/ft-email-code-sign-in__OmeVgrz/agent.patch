+      <label class="flex align-center gap input input--actor">
+        <%= form.hidden_field :email_address, value: @email_address %>
+        <%= form.text_field :code, required: true, class: "input full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…", maxlength: 6 %>
