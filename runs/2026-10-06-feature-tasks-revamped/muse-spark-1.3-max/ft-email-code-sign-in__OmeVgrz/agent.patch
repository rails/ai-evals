+<% @page_title = "Enter your code to join #{@join_code.account.name}" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+
+  <p>We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to join <strong><%= @join_code.account.name %></strong>.</p>
+
+  <%= form_with url: join_magic_link_path(join_code: @join_code.code, email_address: @email_address), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
