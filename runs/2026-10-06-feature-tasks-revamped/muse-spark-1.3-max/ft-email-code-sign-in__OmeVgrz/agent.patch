+class JoinCodes::MagicLinksController < ApplicationController
+  include MagicLinkAuthenticatable
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || find_pending_magic_link&.email_address
+
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    else
+      @magic_link = MagicLink.where(email_address: @email_address).where("expires_at > ?", Time.current).order(created_at: :desc).first
+    end
+  end
+
+  def show
+    @email_address = params[:email_address].presence || find_pending_magic_link&.email_address
+
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    else
+      @magic_link = MagicLink.where(email_address: @email_address).where("expires_at > ?", Time.current).order(created_at: :desc).first
+      render :new
+    end
+  end
+
+  def create
+    if magic_link = authenticate_magic_code
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      magic_link.destroy!
+
+      clear_pending_authentication_token
+      start_new_session_for identity unless Current.identity == identity
+      Current.identity ||= identity
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          email = email_address_from_params.presence || find_pending_magic_link&.email_address || params[:email_address].presence
+
+          if email.present?
+            redirect_to new_join_magic_link_path(join_code: @join_code.code, email_address: email, script_name: @join_code.account.slug), alert: "That code didn't work. Try again."
+          else
+            redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "That code didn't work. Try again."
+          end
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      code = params[:join_code].presence || params[:code].presence
+      @join_code ||= Account::JoinCode.find_by(code: code, account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
