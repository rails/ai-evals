+class Signups::MagicLinksController < ApplicationController
+  include MagicLinkAuthenticatable
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = params[:email_address].presence || find_pending_magic_link&.email_address
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      @magic_link = MagicLink.where(email_address: @email_address).where("expires_at > ?", Time.current).order(created_at: :desc).first
+    end
+  end
+
+  def show
+    @email_address = params[:email_address].presence || find_pending_magic_link&.email_address
+
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      @magic_link = MagicLink.where(email_address: @email_address).where("expires_at > ?", Time.current).order(created_at: :desc).first
+      render :new
+    end
+  end
+
+  def create
+    if magic_link = authenticate_magic_code
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      magic_link.destroy!
+
+      clear_pending_authentication_token
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          email = email_address_from_params.presence || find_pending_magic_link&.email_address || params[:email_address].presence
+
+          if email.present?
+            redirect_to new_signup_magic_link_path(email_address: email), alert: "That code didn't work. Try again."
+          else
+            redirect_to new_signup_path, alert: "That code didn't work. Try again."
+          end
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+
+    def rate_limit_exceeded
+      respond_to do |format|
+        format.html { redirect_to new_signup_magic_link_path(email_address: params[:email_address]), alert: "Try again later." }
+        format.json { render json: { message: "Try again later." }, status: :too_many_requests }
+      end
+    end
+end
