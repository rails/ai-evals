new file mode 100644
index 0000000..e5eab93
--- /dev/null
+++ b/app/models/board/bytes_used.rb
@@ -0,0 +1,42 @@
+module Board::BytesUsed
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :capture_account_change_for_storage, if: :will_save_change_to_account_id?
+    after_update_commit :transfer_storage_if_account_changed_later
+  end
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used_later
+    ::StorageUsage::RecalculateBoardJob.perform_later(id)
+  end
+
+  def recalculate_bytes_used_now
+    update_column(:bytes_used, ::StorageUsage.board_bytes(id))
+  end
+
+  private
+    def capture_account_change_for_storage
+      @storage_old_account_id = account_id_was
+      @storage_new_account_id = account_id
+    end
+
+    def transfer_storage_if_account_changed_later
+      if @storage_old_account_id.present? && @storage_new_account_id.present?
+        old_account_id = @storage_old_account_id
+        new_account_id = @storage_new_account_id
+        @storage_old_account_id = @storage_new_account_id = nil
+
+        if old_account_id != new_account_id
+          byte_size = ::StorageUsage.board_bytes(id)
+
+          ::StorageUsage::TransferJob.perform_later(
+            id, id, old_account_id, new_account_id, byte_size
+          )
+        end
+      end
+    end
+end
