diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..842a706
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,234 @@
+# Tracks storage used by card images and files embedded in board descriptions,
+# card descriptions, and comments.
+#
+# Counts are maintained as cached counters (Account#bytes_used, Board#bytes_used)
+# updated incrementally by background jobs. Each attachment change enqueues a
+# small atomic delta; card/comment moves enqueue a transfer of the moved bytes.
+# Full recalculation via SQL SUM is available for backfills, imports, and repair.
+class StorageUsage
+  # Resolve the board/account attribution and byte size for a countable attachment.
+  # Returns [ board_id, account_id, byte_size ] or nil if not countable.
+  def self.board_and_account_for_attachment(attachment)
+    byte_size = attachment_byte_size(attachment)
+    return nil if byte_size.nil?
+
+    case [ attachment.record_type, attachment.name ]
+    when [ "Card", "image" ]
+      board_id = Card.where(id: attachment.record_id).pick(:board_id)
+      return nil if board_id.nil?
+
+      account_id = Board.where(id: board_id).pick(:account_id)
+      return nil if account_id.nil?
+
+      [ board_id, account_id, byte_size ]
+    when [ "ActionText::RichText", "embeds" ]
+      rich_text = ActionText::RichText.where(id: attachment.record_id).pick(:record_type, :record_id, :name)
+      return nil if rich_text.nil?
+
+      record_type, record_id, name = rich_text
+      board_id = board_id_for_rich_text(record_type, record_id, name)
+      return nil if board_id.nil?
+
+      account_id = Board.where(id: board_id).pick(:account_id)
+      return nil if account_id.nil?
+
+      [ board_id, account_id, byte_size ]
+    else
+      nil
+    end
+  end
+
+  def self.board_id_for_rich_text(record_type, record_id, name)
+    case [ record_type, name ]
+    when [ "Board", "public_description" ]
+      Board.where(id: record_id).pick(:id)
+    when [ "Card", "description" ]
+      Card.where(id: record_id).pick(:board_id)
+    when [ "Comment", "body" ]
+      card_id = Comment.where(id: record_id).pick(:card_id)
+      return nil if card_id.nil?
+
+      Card.where(id: card_id).pick(:board_id)
+    else
+      nil
+    end
+  end
+
+  def self.attachment_byte_size(attachment)
+    if attachment.association(:blob).loaded? && attachment.blob.present?
+      attachment.blob.byte_size
+    else
+      ActiveStorage::Blob.where(id: attachment.blob_id).pick(:byte_size)
+    end
+  end
+
+  # --- Full calculations (efficient SQL SUMs, no record instantiation) ---
+
+  def self.board_bytes(board_id)
+    card_images_bytes_for_board(board_id) +
+      board_description_bytes(board_id) +
+      card_description_bytes_for_board(board_id) +
+      comment_bytes_for_board(board_id)
+  end
+
+  def self.account_bytes(account_id)
+    card_images_bytes_for_account(account_id) +
+      board_description_bytes_for_account(account_id) +
+      card_description_bytes_for_account(account_id) +
+      comment_bytes_for_account(account_id)
+  end
+
+  def self.card_bytes(card_id)
+    card_image_bytes(card_id) + card_description_bytes(card_id) + comment_bytes_for_card(card_id)
+  end
+
+  def self.comment_bytes(comment_id)
+    comment_body_bytes(comment_id)
+  end
+
+  # --- Atomic counter updates (safe under concurrency) ---
+
+  def self.apply_delta(board_id:, account_id:, delta:)
+    return if delta.nil? || delta == 0
+
+    if board_id.present?
+      Board.where(id: board_id).update_counters(bytes_used: delta)
+    end
+
+    if account_id.present?
+      Account.where(id: account_id).update_counters(bytes_used: delta)
+    end
+  end
+
+  def self.apply_transfer(old_board_id:, new_board_id:, old_account_id:, new_account_id:, byte_size:)
+    return if byte_size.nil? || byte_size == 0
+    return if old_board_id == new_board_id && old_account_id == new_account_id
+
+    if old_board_id.present? && old_board_id != new_board_id
+      Board.where(id: old_board_id).update_counters(bytes_used: -byte_size)
+    end
+
+    if new_board_id.present? && old_board_id != new_board_id
+      Board.where(id: new_board_id).update_counters(bytes_used: byte_size)
+    end
+
+    if old_account_id.present? && new_account_id.present? && old_account_id != new_account_id
+      Account.where(id: old_account_id).update_counters(bytes_used: -byte_size)
+      Account.where(id: new_account_id).update_counters(bytes_used: byte_size)
+    end
+  end
+
+  class << self
+    private
+      def blobs_sum(scope)
+        scope.joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def embeds_scope
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds")
+      end
+
+      def join_rich_text(scope)
+        scope.joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+      end
+
+      # Board-scoped sums (filter via boards for account correctness)
+
+      def card_images_bytes_for_board(board_id)
+        ActiveStorage::Attachment
+          .where(record_type: "Card", name: "image")
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+          .where(cards: { board_id: board_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def board_description_bytes(board_id)
+        join_rich_text(embeds_scope)
+          .where(action_text_rich_texts: { record_type: "Board", record_id: board_id, name: "public_description" })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def card_description_bytes_for_board(board_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Card'")
+          .where(action_text_rich_texts: { record_type: "Card", name: "description" })
+          .where(cards: { board_id: board_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_bytes_for_board(board_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Comment'")
+          .joins("INNER JOIN cards ON cards.id = comments.card_id")
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where(cards: { board_id: board_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      # Account-scoped sums (via boards so cross-account staleness can't misattribute)
+
+      def card_images_bytes_for_account(account_id)
+        ActiveStorage::Attachment
+          .where(record_type: "Card", name: "image")
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN boards ON boards.id = cards.board_id")
+          .where(boards: { account_id: account_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def board_description_bytes_for_account(account_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN boards ON boards.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Board'")
+          .where(action_text_rich_texts: { record_type: "Board", name: "public_description" })
+          .where(boards: { account_id: account_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def card_description_bytes_for_account(account_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Card'")
+          .joins("INNER JOIN boards ON boards.id = cards.board_id")
+          .where(action_text_rich_texts: { record_type: "Card", name: "description" })
+          .where(boards: { account_id: account_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_bytes_for_account(account_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Comment'")
+          .joins("INNER JOIN cards ON cards.id = comments.card_id")
+          .joins("INNER JOIN boards ON boards.id = cards.board_id")
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where(boards: { account_id: account_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      # Card/comment sums for transfers
+
+      def card_image_bytes(card_id)
+        ActiveStorage::Attachment
+          .where(record_type: "Card", record_id: card_id, name: "image")
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def card_description_bytes(card_id)
+        join_rich_text(embeds_scope)
+          .where(action_text_rich_texts: { record_type: "Card", record_id: card_id, name: "description" })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_bytes_for_card(card_id)
+        join_rich_text(embeds_scope)
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id AND action_text_rich_texts.record_type = 'Comment'")
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where(comments: { card_id: card_id })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_body_bytes(comment_id)
+        join_rich_text(embeds_scope)
+          .where(action_text_rich_texts: { record_type: "Comment", record_id: comment_id, name: "body" })
+          .joins(:blob).sum("active_storage_blobs.byte_size")
+      end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..ec84d19
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,58 @@
+# Tracks storage usage for card images and rich text embeds.
+#
+# Countable attachments enqueue small atomic deltas applied in background jobs,
+# keeping Account#bytes_used and Board#bytes_used up to date without expensive
+# recalculation on the hot path. Deltas capture board/account attribution at
+# event time so they stay correct even when parents are destroyed or moved
+# before jobs run.
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.class_eval do
+    after_create_commit :track_storage_usage_on_create_later
+    before_destroy :capture_storage_usage_for_destroy
+    after_destroy_commit :track_storage_usage_on_destroy_later
+
+    # purge/purge_later/detach use #delete (skipping callbacks), so track there too.
+    def delete
+      attribution = countable_storage_attachment? ? StorageUsage.board_and_account_for_attachment(self) : nil
+      result = super
+
+      if attribution.present?
+        board_id, account_id, byte_size = attribution
+        StorageUsage::DeltaJob.perform_later(board_id, account_id, -byte_size)
+      end
+
+      result
+    end
+
+    private
+      def track_storage_usage_on_create_later
+        if countable_storage_attachment?
+          if (attribution = StorageUsage.board_and_account_for_attachment(self))
+            board_id, account_id, byte_size = attribution
+            StorageUsage::DeltaJob.perform_later(board_id, account_id, byte_size)
+          end
+        end
+      end
+
+      def capture_storage_usage_for_destroy
+        if countable_storage_attachment?
+          @storage_usage_attribution_for_destroy = StorageUsage.board_and_account_for_attachment(self)
+        else
+          @storage_usage_attribution_for_destroy = nil
+        end
+      end
+
+      def track_storage_usage_on_destroy_later
+        if @storage_usage_attribution_for_destroy.present?
+          board_id, account_id, byte_size = @storage_usage_attribution_for_destroy
+          StorageUsage::DeltaJob.perform_later(board_id, account_id, -byte_size)
+        end
+      end
