diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..890a671
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  toggle(event) {
+    if (event.target.closest(".reaction__delete")) return
+    if (event.target.closest("form")) return
+    if (!this.isOwn()) return
+    this.element.classList.toggle("expanded")
+  }
+
+  delete(event) {
+    event.stopPropagation()
+    this.element.classList.add("reaction--deleting")
+  }
+
+  isOwn() {
+    return this.element.dataset.reacterId === getMetaContent("current-user-id")
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e4c790b
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  showForm(event) {
+    if (event) event.preventDefault()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  hideForm(event) {
+    if (event) event.preventDefault()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("expanded")
+    this.triggerTarget.hidden = false
+    const dialog = this.formTarget.querySelector("dialog[open]")
+    if (dialog) dialog.close()
+    if (this.hasInputTarget) this.inputTarget.value = ""
+    this.triggerTarget.focus({ preventScroll: true })
+  }
+
+  resetAfterSubmit(event) {
+    if (event.detail.success) {
+      const dialog = this.formTarget.querySelector("dialog[open]")
+      if (dialog) dialog.close()
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("expanded")
+      this.triggerTarget.hidden = false
+      if (this.hasInputTarget) this.inputTarget.value = ""
+      event.target.reset()
+    }
+  }
+
+  pickEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget.dataset.emoji
+    if (!emoji) return
+    this.inputTarget.value = emoji
+    const dialog = this.formTarget.querySelector("dialog[open]")
+    if (dialog) dialog.close()
+    this.inputTarget.focus()
+    const form = this.formTarget.querySelector("form")
+    if (form) form.requestSubmit()
+  }
+}
