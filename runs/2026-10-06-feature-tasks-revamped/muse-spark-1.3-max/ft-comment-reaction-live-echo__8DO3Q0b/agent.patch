@@ -0,0 +1,41 @@
+<div id="<%= dom_id(comment, :reactions_container) %>" class="reactions" data-controller="reactions">
+  <div id="<%= dom_id(comment, :reactions) %>" class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.chronologically.includes(:creator), as: :reaction %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#showForm" aria-label="Add reaction">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add reaction</span>
+  </button>
+
+  <div class="reaction reaction__form" data-reactions-target="form" hidden>
+    <%= form_with model: [ comment.card, comment, Reaction.new ], data: { action: "turbo:submit-end->reactions#resetAfterSubmit" } do |form| %>
+      <label class="reaction__form-label">
+        <span class="for-screen-reader">Add reaction</span>
+        <%= form.text_field :content, class: "input reaction__input", maxlength: 16, required: true, placeholder: "React…", autocomplete: "off", data: { reactions_target: "input" } %>
+      </label>
+
+      <span class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="click->dialog#toggle:stop" aria-label="Choose emoji">
+          <%= icon_tag "reaction" %>
+        </button>
+        <dialog class="reaction__popup popup panel" data-dialog-target="dialog">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+              <button type="button" class="btn btn--circle borderless" data-action="reactions#pickEmoji" data-emoji="<%= emoji %>" title="<%= label %>" aria-label="<%= label %>"><%= emoji %></button>
+            <% end %>
+          </div>
+        </dialog>
+      </span>
+
+      <button type="submit" class="reaction__submit-btn btn btn--circle borderless" aria-label="Confirm reaction">
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Confirm</span>
+      </button>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#hideForm" aria-label="Cancel">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+</div>
