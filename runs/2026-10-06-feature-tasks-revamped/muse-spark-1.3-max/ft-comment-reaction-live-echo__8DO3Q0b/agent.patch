diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..abcebb6
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,68 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account || comment&.account }
+  belongs_to :card, touch: true, default: -> { comment&.card }
+  belongs_to :comment, optional: true, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  before_validation :strip_content
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :for_card, -> { where(comment_id: nil) }
+  scope :for_comments, -> { where.not(comment_id: nil) }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_destruction
+
+  def reacter
+    creator
+  end
+
+  def reacter=(user)
+    self.creator = user
+  end
+
+  def reacter_id
+    creator_id
+  end
+
+  def reacter_id=(id)
+    self.creator_id = id
+  end
+
+  def comment_reaction?
+    comment_id.present?
+  end
+
+  def card_reaction?
+    comment_id.nil?
+  end
+
+  private
+    def strip_content
+      self.content = content.strip if content.present?
+    end
+
+    def broadcast_creation
+      if comment_reaction?
+        broadcast_append_later_to card, target: helpers.dom_id(comment, :reactions),
+          partial: "cards/comments/reactions/reaction", locals: { reaction: self }
+        broadcast_append_later_to card, target: helpers.dom_id(comment, :reactions_list),
+          partial: "cards/comments/reactions/reaction", locals: { reaction: self }
+      else
+        broadcast_append_later_to card, target: helpers.dom_id(card, :reactions),
+          partial: "cards/reactions/reaction", locals: { reaction: self }
+        broadcast_append_later_to card, target: helpers.dom_id(card, :reactions_list),
+          partial: "cards/reactions/reaction", locals: { reaction: self }
+      end
+    end
+
+    def broadcast_destruction
+      broadcast_remove_to card
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
