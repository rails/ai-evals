+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+    @new_account = import.new_account
+    @user = import.creator
+
+    Current.account = @account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your import is complete"
+    )
+  ensure
+    Current.account = nil
+  end
+
+  def failed(import)
+    @import = import
+    @account = import.account
+    @user = import.creator
+
+    Current.account = @account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your import failed"
+    )
+  ensure
+    Current.account = nil
+  end
+end
