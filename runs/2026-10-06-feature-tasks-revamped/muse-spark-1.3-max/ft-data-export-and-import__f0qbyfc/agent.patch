+++ b/app/controllers/account/exports/downloads_controller.rb
@@ -0,0 +1,35 @@
+class Account::Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  def show
+    @export = Export.find_by_token_for(:download, params[:token])
+
+    if @export.nil? || @export.id.to_s != params[:export_id].to_s
+      respond_to do |format|
+        format.html { redirect_to root_path, alert: "Invalid or expired download link" }
+        format.json { head :not_found }
+      end
+      return
+    end
+
+    if Current.account && @export.account_id != Current.account.id
+      respond_to do |format|
+        format.html { redirect_to root_path, alert: "Invalid download link" }
+        format.json { head :not_found }
+      end
+      return
+    end
+
+    unless @export.file.attached?
+      respond_to do |format|
+        format.html { redirect_to root_path, alert: "Export is not ready yet" }
+        format.json { head :not_found }
+      end
+      return
+    end
+
+    ActiveStorage::Current.url_options = { protocol: request.protocol, host: request.host, port: request.port, script_name: request.script_name }
+
+    redirect_to @export.file.blob.url(disposition: "attachment"), allow_other_host: true
+  end
+end
