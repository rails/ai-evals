+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.build
+  end
+
+  def create
+    @import = Current.account.imports.build(creator: Current.user)
+    @import.file.attach(import_params[:file]) if import_params[:file].present?
+
+    unless @import.file.attached?
+      respond_to do |format|
+        format.html do
+          @import.errors.add(:file, "must be attached")
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "File must be attached" }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    @import.save!
+    @import.import_later
+
+    respond_to do |format|
+      format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. You will receive an email when it is complete." }
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def show
+    @import = Current.account.imports.find(params[:id])
+  end
+
+  private
+    def import_params
+      params.expect(import: [ :file ])
+    end
+end
