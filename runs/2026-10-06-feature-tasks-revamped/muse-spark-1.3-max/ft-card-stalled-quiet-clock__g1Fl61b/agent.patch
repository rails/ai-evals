diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..1081a49
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,41 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    active? && burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def burst?
+    burst_at.present?
+  end
+  alias_method :bursted?, :burst?
+  alias_method :had_burst?, :burst?
+
+  def mark_burst!
+    update!(burst_at: Time.current)
+  end
+
+  def burst_window
+    auto_postpone_period / 3.0
+  end
+
+  def check_for_comment_burst(latest_comment = nil)
+    latest_comment ||= comments.by_user.order(created_at: :desc, id: :desc).first
+    return unless latest_comment
+
+    window_start = latest_comment.created_at - burst_window
+    window_end = latest_comment.created_at
+
+    recent = comments.by_user.where(created_at: window_start..window_end)
+
+    if recent.count >= 3 && recent.distinct.count(:creator_id) >= 2
+      mark_burst!
+    end
+  end
+end
