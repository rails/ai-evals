diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..310b351
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,378 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "item", "container" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+
+    this.#makeCardsDraggable()
+    this.handleFrameRender = this.#makeCardsDraggable.bind(this)
+    document.addEventListener("turbo:frame-render", this.handleFrameRender)
+    document.addEventListener("turbo:frame-load", this.handleFrameRender)
+    document.addEventListener("turbo:morph", this.handleFrameRender)
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:frame-render", this.handleFrameRender)
+    document.removeEventListener("turbo:frame-load", this.handleFrameRender)
+    document.removeEventListener("turbo:morph", this.handleFrameRender)
+  }
+
+  itemTargetConnected(item) {
+    item.setAttribute("draggable", "true")
+  }
+
+  dragstart(event) {
+    const card = this.#findCard(event)
+    if (!card) return
+    if (!this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", card.id || "card")
+      } catch {
+        // Some browsers restrict setData outside of native drag
+      }
+    }
+
+    card.classList.add(this.#draggedClass)
+  }
+
+  dragover(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#findColumn(event)
+    if (!column) return
+    if (!this.element.contains(column)) return
+
+    event.preventDefault()
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    if (this.hoveredColumn !== column) {
+      this.#clearHover()
+      this.hoveredColumn = column
+      column.classList.add(this.#hoverClass)
+    }
+  }
+
+  dragenter(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#findColumn(event)
+    if (!column) return
+    if (!this.element.contains(column)) return
+
+    event.preventDefault()
+    if (this.hoveredColumn !== column) {
+      this.#clearHover()
+      this.hoveredColumn = column
+      column.classList.add(this.#hoverClass)
+    }
+  }
+
+  dragleave(event) {
+    const column = this.#findColumn(event)
+    if (!column) return
+
+    const leavingColumn = !event.relatedTarget || !column.contains(event.relatedTarget)
+    if (this.hoveredColumn === column && leavingColumn) {
+      column.classList.remove(this.#hoverClass)
+      this.hoveredColumn = null
+    }
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#findColumn(event)
+    if (!column) return
+    if (!this.element.contains(column)) return
+
+    event.preventDefault()
+
+    const draggedCard = this.draggedCard
+    const sourceColumn = this.sourceColumn
+    const destinationColumn = column
+
+    this.#clearHover()
+
+    // Columns keep their own order — moves within one column are ignored.
+    if (sourceColumn === destinationColumn) {
+      this.#cleanupDrag()
+      return
+    }
+
+    // Instant: update the board synchronously before saving.
+    this.#moveCardOptimistically(draggedCard, destinationColumn, sourceColumn)
+    const cardToSave = draggedCard
+    const destToSave = destinationColumn
+    this.#cleanupDrag()
+
+    // Save in the background with JSON so nothing re-renders afterwards.
+    this.#saveMove(cardToSave, destToSave).catch((error) => {
+      console.error("Drag and drop save failed", error)
+    })
+  }
+
+  dragend(event) {
+    this.#clearHover()
+    this.#cleanupDrag()
+  }
+
+  // Private
+
+  get #draggedClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #findCard(event) {
+    if (event.target?.closest) {
+      return event.target.closest('[data-drag-and-drop-target="item"], article.card')
+    }
+    return null
+  }
+
+  #findColumn(event) {
+    if (event.target?.closest) {
+      return event.target.closest('[data-drag-and-drop-target="container"], .cards')
+    }
+    return null
+  }
+
+  #makeCardsDraggable() {
+    this.element.querySelectorAll("article.card:not([draggable])").forEach((card) => {
+      card.setAttribute("draggable", "true")
+    })
+    this.element.querySelectorAll('article.card[draggable="false"]').forEach((card) => {
+      // Cards themselves must stay draggable; only inner links stay non-draggable.
+      if (card.classList.contains("card") && card.tagName === "ARTICLE") {
+        card.setAttribute("draggable", "true")
+      }
+    })
+  }
+
+  #clearHover() {
+    if (this.hoveredColumn) {
+      this.hoveredColumn.classList.remove(this.#hoverClass)
+      this.hoveredColumn = null
+    } else {
+      this.element.querySelectorAll('.' + this.#hoverClass).forEach((el) => {
+        el.classList.remove(this.#hoverClass)
+      })
+    }
+  }
+
+  #cleanupDrag() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(this.#draggedClass)
+    }
+    this.element.querySelectorAll('.' + this.#draggedClass).forEach((el) => {
+      if (el !== this.draggedCard) el.classList.remove(this.#draggedClass)
+    })
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  #moveCardOptimistically(card, destinationColumn, sourceColumn) {
+    const destinationList = destinationColumn.querySelector(".cards__list")
+    if (destinationList) {
+      const firstCard = destinationList.querySelector("article.card")
+      if (firstCard) {
+        firstCard.before(card)
+      } else {
+        destinationList.prepend(card)
+      }
+    }
+
+    this.#updateCounts(sourceColumn, destinationColumn)
+    this.#updateCardAppearance(card, destinationColumn)
+  }
+
+  #updateCounts(sourceColumn, destinationColumn) {
+    if (sourceColumn) this.#adjustCount(sourceColumn, -1)
+    if (destinationColumn) this.#adjustCount(destinationColumn, 1)
+  }
+
+  #adjustCount(column, delta) {
+    const countElement = column.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const text = countElement.textContent.trim()
+    if (text === "99+") return
+
+    const current = parseInt(text, 10)
+    if (isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    countElement.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #updateCardAppearance(card, destinationColumn) {
+    const destinationType = this.#destinationType(destinationColumn)
+
+    if (destinationType === "not_now") {
+      card.classList.add("card--postponed")
+      card.classList.remove("card--active")
+    } else if (destinationType === "closed") {
+      card.classList.remove("card--postponed")
+      card.classList.remove("card--active")
+    } else {
+      card.classList.remove("card--postponed")
+      card.classList.add("card--active")
+    }
+
+    const header = card.querySelector(".card__header")
+    if (!header) return
+
+    const existingBadge = header.querySelector(".card__column-name--current")
+
+    if (destinationType === "column") {
+      const columnName = destinationColumn.dataset.columnName?.trim() ||
+        destinationColumn.querySelector(".cards__expander-title")?.textContent?.trim()
+
+      if (existingBadge) {
+        if (columnName) {
+          const inner = existingBadge.querySelector(".overflow-ellipsis") || existingBadge
+          inner.textContent = columnName
+        }
+      } else if (columnName) {
+        const badge = document.createElement("span")
+        badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        const inner = document.createElement("span")
+        inner.className = "overflow-ellipsis "
+        inner.textContent = columnName
+        badge.appendChild(inner)
+        header.appendChild(badge)
+      }
+    } else {
+      existingBadge?.remove()
+    }
+
+    this.#updateCardStages(card, destinationColumn, destinationType)
+  }
+
+  #updateCardStages(card, destinationColumn, destinationType) {
+    const stages = card.querySelector(".card__stages")
+    if (!stages) return
+
+    const stageItems = stages.querySelectorAll(".card__column-name")
+    if (destinationType === "column") {
+      const columnName = destinationColumn.dataset.columnName?.trim()
+      stageItems.forEach((item) => {
+        const isCurrent = columnName ? item.textContent.trim() === columnName : false
+        item.classList.toggle("card__column-name--current", isCurrent)
+      })
+    } else {
+      stageItems.forEach((item) => item.classList.remove("card__column-name--current"))
+    }
+  }
+
+  async #saveMove(card, destinationColumn) {
+    const destinationType = this.#destinationType(destinationColumn)
+
+    if (destinationType === "column") {
+      const columnId = this.#columnIdFor(destinationColumn)
+      const url = this.#triageUrlFor(card)
+      if (!url || !columnId) return
+      await post(url, { body: { column_id: columnId }, responseKind: "json" })
+    } else if (destinationType === "stream") {
+      const url = this.#triageUrlFor(card)
+      if (!url) return
+      await destroy(url, { responseKind: "json" })
+    } else if (destinationType === "not_now") {
+      const url = this.#notNowUrlFor(card)
+      if (!url) return
+      await post(url, { responseKind: "json" })
+    } else if (destinationType === "closed") {
+      const url = this.#closureUrlFor(card)
+      if (!url) return
+      await post(url, { responseKind: "json" })
+    }
+  }
+
+  #destinationType(column) {
+    const explicit = column.dataset.dragAndDropDestination || column.dataset.columnType || column.dataset.dropType
+    if (explicit) {
+      const normalized = explicit.toLowerCase()
+      if ([ "column", "stream", "maybe", "not_now", "not-now", "closed", "done" ].includes(normalized)) {
+        if (normalized === "maybe") return "stream"
+        if (normalized === "not-now") return "not_now"
+        if (normalized === "done") return "closed"
+        return normalized
+      }
+    }
+
+    const id = column.id || ""
+    if (id === "maybe" || id === "stream_column") return "stream"
+    if (id === "not-now" || id === "not_now_column") return "not_now"
+    if (id === "closed-cards" || id === "closed_column") return "closed"
+    if (column.classList.contains("cards--maybe")) return "stream"
+    if (column.classList.contains("cards--on-deck")) return "not_now"
+    if (column.classList.contains("cards--closed")) return "closed"
+
+    return "column"
+  }
+
+  #columnIdFor(column) {
+    if (column.dataset.columnId) return column.dataset.columnId
+    if (column.dataset.dragAndDropColumnId) return column.dataset.dragAndDropColumnId
+
+    const id = column.id || ""
+    if (id.startsWith("cards_column_")) {
+      return id.replace(/^cards_column_/, "")
+    }
+    if (id.startsWith("column_")) {
+      return id.replace(/^column_/, "").replace(/_cards$/, "")
+    }
+    return null
+  }
+
+  #triageUrlFor(card) {
+    if (card.dataset.cardTriageUrl) return card.dataset.cardTriageUrl
+    if (card.dataset.dragAndDropTriageUrl) return card.dataset.dragAndDropTriageUrl
+    if (card.dataset.triageUrl) return card.dataset.triageUrl
+
+    const base = this.#cardBaseUrl(card)
+    return base ? `${base}/triage` : null
+  }
+
+  #notNowUrlFor(card) {
+    if (card.dataset.cardNotNowUrl) return card.dataset.cardNotNowUrl
+    if (card.dataset.dragAndDropNotNowUrl) return card.dataset.dragAndDropNotNowUrl
+    if (card.dataset.notNowUrl) return card.dataset.notNowUrl
+
+    const base = this.#cardBaseUrl(card)
+    return base ? `${base}/not_now` : null
+  }
+
+  #closureUrlFor(card) {
+    if (card.dataset.cardClosureUrl) return card.dataset.cardClosureUrl
+    if (card.dataset.dragAndDropClosureUrl) return card.dataset.dragAndDropClosureUrl
+    if (card.dataset.closureUrl) return card.dataset.closureUrl
+
+    const base = this.#cardBaseUrl(card)
+    return base ? `${base}/closure` : null
+  }
+
+  #cardBaseUrl(card) {
+    const link = card.querySelector("a.card__link")
+    const href = link?.getAttribute("href")
+    if (!href) return null
+    return href.split("?")[0].split("#")[0].replace(/\/$/, "")
+  }
+}
