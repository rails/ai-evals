+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,53 @@
+class SearchesController < ApplicationController
+  def show
+    @query = search_query
+    @terms = @query.split(/\s+/).reject(&:blank?)
+    @cards = search_cards
+  end
+
+  private
+    def search_query
+      (params[:q] || params[:query] || params[:term]).to_s.strip
+    end
+
+    def search_cards
+      base = Current.user.accessible_cards.published.where(cards: { account_id: Current.account.id })
+
+      if @terms.any?
+        likes = @terms.map { |term| "%#{ActiveRecord::Base.sanitize_sql_like(term)}%" }
+        title_condition = Array.new(@terms.size, "cards.title LIKE ?").join(" OR ")
+
+        title_ids = base.where(title_condition, *likes).pluck(:id)
+
+        body_condition = Array.new(@terms.size, "body LIKE ?").join(" OR ")
+
+        description_card_ids = ActionText::RichText
+          .where(record_type: "Card", name: "description", account_id: Current.account.id)
+          .where(body_condition, *likes)
+          .pluck(:record_id)
+
+        comment_rich_ids = ActionText::RichText
+          .where(record_type: "Comment", name: "body", account_id: Current.account.id)
+          .where(body_condition, *likes)
+          .pluck(:record_id)
+
+        comment_card_ids = if comment_rich_ids.any?
+          Comment.where(id: comment_rich_ids).pluck(:card_id)
+        else
+          []
+        end
+
+        all_ids = (title_ids + description_card_ids + comment_card_ids).uniq
+
+        if all_ids.any?
+          base.where(id: all_ids).reverse_chronologically
+            .preload(:board, :creator, comments: :rich_text_body)
+            .with_rich_text_description
+        else
+          base.none
+        end
+      else
+        base.none
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..7412c8f
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,24 @@
+module SearchesHelper
+  def matching_comments_for(card, terms)
+    return [] if terms.blank?
+
+    card.comments.select do |comment|
+      plain = comment.body.to_plain_text.to_s
+      terms.any? { |term| plain.downcase.include?(term.downcase) }
+    end
+  end
+
+  def search_excerpt(text, terms, radius: 100, length: 200)
+    plain = text.to_s.strip.gsub(/\s+/, " ")
+    return "" if plain.blank?
+    return plain.truncate(length) if terms.blank?
+
+    matching_term = terms.find { |term| plain.downcase.include?(term.downcase) }
+
+    if matching_term
+      excerpt(plain, matching_term, radius: radius) || plain.truncate(length)
+    else
+      plain.truncate(length)
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..0257187
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,50 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+
+  <div class="header__actions header__actions--end"></div>
+<% end %>
+
+<section class="panel center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" }, class: "flex gap align-center" do %>
+    <%= search_field_tag :q, @query, placeholder: "Search cards...", autofocus: true, class: "input full-width", aria: { label: "Search cards" } %>
+    <%= submit_tag "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="txt-subtle margin-block">Enter a search term to find cards by title, description, or comments.</p>
+  <% elsif @cards.any? %>
+    <div id="search-results" class="margin-block-start">
+      <% @cards.each do |card| %>
+        <article id="<%= dom_id(card) %>" class="panel pad margin-block-start txt-align-start">
+          <h2 class="txt-large">
+            <%= link_to highlight(card.title.to_s, @terms), card_path(card), data: { turbo_frame: "_top" } %>
+          </h2>
+          <p class="txt-small txt-subtle">
+            #<%= card.number %> in <%= card.board.name %> · <%= card.creator.name %>
+          </p>
+
+          <% description_text = card.description.to_plain_text.to_s.strip %>
+          <% if description_text.present? %>
+            <p class="margin-block-start">
+              <%= highlight(search_excerpt(description_text, @terms), @terms) %>
+            </p>
+          <% end %>
+
+          <% matching_comments_for(card, @terms).each do |comment| %>
+            <blockquote class="margin-block-start pad-start border-start">
+              <%= highlight(search_excerpt(comment.body.to_plain_text.to_s, @terms), @terms) %>
+            </blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="margin-block">No cards found for "<%= @query %>".</p>
+  <% end %>
+</section>
