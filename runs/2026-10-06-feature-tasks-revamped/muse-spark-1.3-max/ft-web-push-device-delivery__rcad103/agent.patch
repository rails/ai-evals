diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..85f96ea 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,61 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Web Push Notifications
+// Whatever lands in someone's tray also reaches their phone and desktop.
+// A push says what the tray says and opens the card it's about.
+self.addEventListener("push", (event) => {
+  let data = {}
+
+  if (event.data) {
+    try {
+      data = event.data.json()
+    } catch {
+      data = { body: event.data.text() }
+    }
+  }
+
+  const title = data.title || "Fizzy"
+  const url = data.url || (data.data && data.data.url) || "/"
+
+  const options = {
+    body: data.body || "",
+    data: { url: url },
+    icon: "/app-icon.png",
+    badge: "/app-icon-192.png",
+    tag: data.tag || data.notification_id || "fizzy-notification"
+  }
+
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  const url = (event.notification.data && event.notification.data.url) || "/"
+
+  event.waitUntil(
+    clients.matchAll({ type: "window", includeUncontrolled: true }).then((clientList) => {
+      for (const client of clientList) {
+        if (client.url === url && "focus" in client) {
+          return client.focus()
+        }
+      }
+
+      // Focus an existing window and navigate it to the card, if we have one.
+      if (clientList.length > 0 && "focus" in clientList[0]) {
+        const client = clientList[0]
+        if ("navigate" in client) {
+          return client.navigate(url).then((navigatedClient) => navigatedClient.focus())
+        } else {
+          return client.focus()
+        }
+      }
