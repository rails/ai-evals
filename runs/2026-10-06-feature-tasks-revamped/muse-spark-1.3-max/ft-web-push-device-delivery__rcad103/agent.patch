diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..9b14b13
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,57 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key p256dh auth ]
+
+  before_action :set_user
+  before_action :ensure_can_manage_subscription
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @subscription.assign_attributes(subscription_params.merge(user_agent: request.user_agent))
+
+    if @subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { head :created }
+        format.any { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: @subscription.errors.full_messages.to_sentence }
+        format.json { render json: @subscription.errors, status: :unprocessable_entity }
+        format.any { render json: @subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:id])
+
+    @subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+      format.json { head :no_content }
+      format.any { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_can_manage_subscription
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      raw = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key, :p256dh, :auth, { keys: [ :p256dh, :auth ] } ])
+
+      {
+        endpoint: raw[:endpoint],
+        p256dh_key: raw[:p256dh_key] || raw[:p256dh] || raw.dig(:keys, :p256dh),
+        auth_key: raw[:auth_key] || raw[:auth] || raw.dig(:keys, :auth)
+      }
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..384445d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,130 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "button" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (!this.supported) {
+      return
+    }
+
+    const permission = Notification.permission
+    const subscription = await this.currentSubscription
+
+    if (subscription && permission === "granted") {
+      this.element.classList.add("notifications--on")
+      this.hideDetails()
+    } else {
+      this.element.classList.remove("notifications--on")
+
+      if (permission === "denied") {
+        this.showDetails()
+      } else {
+        this.hideDetails()
+      }
+    }
+  }
+
+  async enable(event) {
+    event?.preventDefault()
+
+    if (!this.supported) {
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.refresh()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.applicationServerKey
+    })
+
+    await this.saveSubscription(subscription)
+
+    this.element.classList.add("notifications--on")
+    this.hideDetails()
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((element) => {
+      element.hidden = false
+    })
+  }
+
+  hideDetails() {
+    this.detailsTargets.forEach((element) => {
+      element.hidden = true
+    })
+  }
+
+  toggleDetails(event) {
+    event?.preventDefault()
+    this.detailsTargets.forEach((element) => {
+      element.hidden = !element.hidden
+    })
+  }
+
+  async saveSubscription(pushSubscription) {
+    const json = pushSubscription.toJSON()
+
+    await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: pushSubscription.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get currentSubscription() {
+    if (!this.supported) {
+      return Promise.resolve(null)
+    }
+
+    return navigator.serviceWorker.ready.then((registration) => {
+      return registration.pushManager.getSubscription()
+    }).catch(() => null)
+  }
+
+  get applicationServerKey() {
+    return this.urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - base64String.length % 4) % 4)
+    const base64 = (base64String + padding)
+      .replace(/-/g, "+")
+      .replace(/_/g, "/")
+
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+
+    return outputArray
+  }
+}
