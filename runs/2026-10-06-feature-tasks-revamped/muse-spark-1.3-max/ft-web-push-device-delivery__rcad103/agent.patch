+  def deliver_push_later
+    Push::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_push_later_on_update
+    deliver_push_later if should_deliver_push?
+  end
+
+  def deliver_push_now
+    return unless Push.enabled?
+    return if source.nil? || card.nil?
+
+    user.push_subscriptions.find_each do |subscription|
+      begin
+        subscription.deliver(self)
+      rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+        subscription.destroy rescue nil
+      rescue StandardError => error
+        Rails.logger.error("Push delivery failed for subscription #{subscription.id}: #{error.message}")
+      end
+    end
+  end
+
+  alias_method :send_push_notification_later, :deliver_push_later
+  alias_method :send_push_notification_now, :deliver_push_now
+  alias_method :deliver_push, :deliver_push_now
+
+  def push_payload
+    {
+      title: push_title,
+      body: push_body,
+      url: push_url,
+      path: push_path,
+      data: { url: push_url, path: push_path },
+      tag: id,
+      notification_id: id,
+      card_id: card_id,
+      unread_count: unread_count
+    }.compact
+  end
+
+  def push_title
+    return card_notification_title(card) if source.nil?
+
+    case source_type
+    when "Event"
+      event_push_title(source)
+    when "Mention"
+      "#{source.mentioner.first_name} @mentioned you"
+    else
+      card_notification_title(card)
+    end
+  rescue
+    card_notification_title(card)
+  end
+
+  def push_body
+    return creator.name if source.nil?
+
+    case source_type
+    when "Event"
+      event_push_body(source)
+    when "Mention"
+      source.source.mentionable_content.truncate(200)
+    else
+      creator.name
+    end
+  rescue
+    creator.name
+  end
+
+  def push_url
+    base_url_options = Rails.application.routes.default_url_options.presence ||
+      Rails.application.config.action_mailer.default_url_options
+
+    Rails.application.routes.url_helpers.card_url(card, base_url_options.merge(script_name: account.slug))
+  rescue
+    push_path
+  end
+
+  def push_path
+    Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+  end
+
+  def push_full_url(host: nil)
+    if host.present?
+      Rails.application.routes.url_helpers.card_url(card, script_name: account.slug, host: host)
+    else
+      push_url
+    end
+  rescue
+    push_path
+  end
+
   private
+    def should_deliver_push?
+      saved_change_to_source_id? || saved_change_to_source_type?
+    end
+
+    def event_push_title(event)
+      case event_push_action(event)
+      when "comment_created" then "RE: #{card_notification_title(event.eventable.card)}"
+      else card_notification_title(event.eventable)
+      end
+    end
+
+    def event_push_body(event)
+      creator_name = event.creator.name
+
+      case event_push_action(event)
+      when "card_assigned" then "Assigned to #{event.assignees.none? ? "self" : event.assignees.pluck(:name).to_sentence}"
+      when "card_unassigned" then "Unassigned by #{creator_name}"
+      when "card_published" then "Added by #{creator_name}"
+      when "card_closed" then "Moved to Done by #{creator_name}"
+      when "card_reopened" then "Reopened by #{creator_name}"
+      when "card_postponed" then "Moved to Not Now by #{creator_name}"
+      when "card_auto_postponed" then "Moved to Not Now due to inactivity"
+      when "card_title_changed" then "Renamed by #{creator_name}"
+      when "card_board_changed" then "Moved by #{creator_name}"
+      when "card_triaged" then "Moved to #{event.particulars.dig("particulars", "column")} by #{creator_name}"
+      when "card_sent_back_to_triage" then "Moved back to Maybe? by #{creator_name}"
+      when "comment_created" then event.eventable.body.to_plain_text.truncate(200)
+      else creator_name
+      end
+    end
+
+    def event_push_action(event)
+      if event.action.card_published? && event.eventable.assigned_to?(event.creator)
+        "card_assigned"
+      else
+        event.action.to_s
+      end
+    end
+
+    def card_notification_title(card)
+      card.title.presence || "Card #{card.number}"
+    end
+
     def set_card
       self.card = source.card
     end
