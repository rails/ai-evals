diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..e6bd822
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,54 @@
+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Back to #{@board.name}", public_board_path(@board.public_token), class: "btn btn--back btn--circle-mobile" %>
+  </div>
+<% end %>
+
+<article class="card card--full" id="<%= dom_id(@card, :article) %>">
+  <header class="card__header">
+    <h1 class="card__title"><%= @card.title %></h1>
+    <p class="card__meta">
+      Added <%= @card.created_at.to_date %> by <%= @card.creator.name %> in <%= @board.name %>
+      <% if @card.column %>
+        / <%= @card.column.name %>
+      <% end %>
+    </p>
+  </header>
+
+  <% if @card.description.present? %>
+    <div class="card__description">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <div class="card__tags">
+      <% @card.tags.each do |tag| %>
+        <span class="card__tag"><%= tag.title %></span>
+      <% end %>
+    </div>
+  <% end %>
+
+  <% if @card.steps.any? %>
+    <ul class="card__steps">
+      <% @card.steps.each do |step| %>
+        <li><%= step.title %></li>
+      <% end %>
+    </ul>
+  <% end %>
+
+  <% if @card.comments.by_user.any? %>
+    <section class="card__comments">
+      <h2>Comments</h2>
+      <% @card.comments.by_user.chronologically.each do |comment| %>
+        <div class="comment" id="<%= dom_id(comment) %>">
+          <strong><%= comment.creator.name %>:</strong>
+          <%= comment.body %>
+        </div>
+      <% end %>
+    </section>
+  <% end %>
+</article>
