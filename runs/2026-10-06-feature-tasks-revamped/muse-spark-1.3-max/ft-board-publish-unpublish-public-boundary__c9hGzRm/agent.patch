@@ -0,0 +1,21 @@
+class Public::BoardsController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  def show
+    @board = find_published_board
+    Current.account ||= @board.account
+    @columns = @board.columns.sorted
+
+    respond_to do |format|
+      format.html
+      format.json
+    end
+  end
+
+  private
+    def find_published_board
+      key = params[:key] || params[:board_key] || params[:board_id] || params[:id]
+      Board.find_by!(public_token: key)
+    end
+end
