@@ -0,0 +1,51 @@
+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<div class="card-columns hide-scrollbar">
+  <div class="card-columns__right">
+    <% @board.columns.sorted.each do |column| %>
+      <section class="cards cards--doing" id="<%= dom_id(column) %>">
+        <header class="cards__header">
+          <h2><%= link_to column.name, public_board_column_path(@board.public_token, column) %></h2>
+          <span><%= column.cards.active.count %> cards</span>
+        </header>
+        <div class="cards__list">
+          <% column.cards.active.latest.with_golden_first.preloaded.limit(25).each do |card| %>
+            <article class="card" id="<%= dom_id(card, :article) %>">
+              <h3 class="card__title">
+                <%= link_to card.title, public_board_card_path(@board.public_token, card.number) %>
+              </h3>
+              <% if card.description.present? %>
+                <div class="card__description"><%= card.description.to_plain_text.truncate(200) %></div>
+              <% end %>
+            </article>
+          <% end %>
+        </div>
+      </section>
+    <% end %>
+
+    <section class="cards cards--maybe" id="maybe">
+      <header class="cards__header">
+        <h2>Maybe?</h2>
+      </header>
+      <div class="cards__list">
+        <% @board.cards.awaiting_triage.latest.with_golden_first.preloaded.limit(25).each do |card| %>
+          <article class="card" id="<%= dom_id(card, :article) %>">
+            <h3 class="card__title">
+              <%= link_to card.title, public_board_card_path(@board.public_token, card.number) %>
+            </h3>
+            <% if card.description.present? %>
+              <div class="card__description"><%= card.description.to_plain_text.truncate(200) %></div>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    </section>
+  </div>
+</div>
