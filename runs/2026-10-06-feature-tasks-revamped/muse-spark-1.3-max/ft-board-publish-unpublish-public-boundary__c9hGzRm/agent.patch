diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..7e00841
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,40 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_token, uniqueness: true, allow_nil: true
+    alias_attribute :public_key, :public_token
+  end
+
+  def published?
+    public_token.present?
+  end
+  alias_method :public?, :published?
+
+  def publish
+    if public_token.blank?
+      update!(public_token: self.class.generate_unique_secure_token)
+    end
+    self
+  end
+
+  def unpublish
+    update!(public_token: nil)
+  end
+
+  def regenerate_public_token
+    update!(public_token: self.class.generate_unique_secure_token)
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_path(public_token, script_name: account.slug)
+    end
+  end
+
+  class_methods do
+    def generate_unique_secure_token(length: 24)
+      SecureRandom.base58(length)
+    end
+  end
+end
