+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+
+    @cards = if @terms.any?
+      search_cards(@terms)
+    else
+      Card.none
+    end
+  end
+
+  private
+    def search_cards(terms)
+      scope = Current.user.accessible_cards.published.where(cards: { account_id: Current.account.id })
+
+      terms.each do |term|
+        like = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+        scope = scope.where(
+          "cards.title LIKE ? OR " \
+          "EXISTS (SELECT 1 FROM action_text_rich_texts WHERE action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.record_id = cards.id AND action_text_rich_texts.name = 'description' AND action_text_rich_texts.body LIKE ?) OR " \
+          "EXISTS (SELECT 1 FROM comments INNER JOIN action_text_rich_texts ON action_text_rich_texts.record_type = 'Comment' AND action_text_rich_texts.record_id = comments.id AND action_text_rich_texts.name = 'body' WHERE comments.card_id = cards.id AND action_text_rich_texts.body LIKE ?)",
+          like, like, like
+        )
+      end
+
+      scope.reverse_chronologically.distinct.includes(:board, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..a62f97b
