+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,56 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="panel center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" } do |form| %>
+    <div class="flex gap-half">
+      <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input full-width" %>
+      <%= form.submit "Search", class: "btn" %>
+    </div>
+  <% end %>
+</section>
+
+<% if @query.present? %>
+  <section class="cards cards--list center margin">
+    <% if @cards.any? %>
+      <div id="search-results" class="cards__list">
+        <% @cards.each do |card| %>
+          <article id="<%= dom_id(card) %>" class="card">
+            <div class="card__content pad">
+              <header class="card__header">
+                <span class="card__board txt-small translucent"><%= h card.board.name %></span>
+              </header>
+
+              <h2 class="card__title">
+                <%= link_to highlight(card.title.to_s, @terms), card_path(card), data: { turbo_frame: "_top" } %>
+              </h2>
+
+              <% description_text = card.description.to_plain_text.to_s %>
+              <% if description_text.present? %>
+                <p class="card__description txt-small">
+                  <%= highlight(description_text, @terms) %>
+                </p>
+              <% end %>
+
+              <% card.comments.each do |comment| %>
+                <% comment_text = comment.body.to_plain_text.to_s %>
+                <% if comment_text.present? %>
+                  <blockquote class="comment__body txt-small">
+                    <%= highlight(comment_text, @terms) %>
+                  </blockquote>
+                <% end %>
+              <% end %>
+            </div>
+          </article>
+        <% end %>
+      </div>
+    <% else %>
+      <div class="blank-slate">No cards found</div>
+    <% end %>
+  </section>
+<% end %>
