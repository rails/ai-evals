+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+
+  <p class="txt-medium margin-none">We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to join <%= @join_code.account.name %>.</p>
+
+  <%= form_with url: join_verification_path(join_code: @join_code.code), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…", maxlength: 6, minlength: 6 %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if Rails.env.development? && @verification %>
+    <p class="txt-subtle txt-small">Psst, here's your code: <strong><%= @verification.code %></strong></p>
+  <% end %>
+
+  <p class="txt-small txt-subtle center">
+    Didn't get a code? <%= link_to "Try again", join_path(code: @join_code.code), class: "txt-link" %>.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
