+    end
+
+    if email.nil? && extract_email_address.present?
+      email = EmailVerificationCode.verify(extract_email_address.to_s, code)
+    end
+
+    if email
+      identity = Identity.find_or_create_by!(email_address: email)
+      start_new_session_for identity
+      cookies.delete(:pending_authentication_token)
