+class JoinCodes::VerificationsController < ApplicationController
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def show
+    @verification = pending_verification
+
+    if @verification.nil?
+      respond_to do |format|
+        format.html { redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "Enter your email to get a code." }
+        format.json { render json: { message: "Enter your email to get a code." }, status: :unauthorized }
+      end
+    else
+      @email_address = @verification.email_address
+
+      respond_to do |format|
+        format.html
+        format.json { render json: { email_address: @email_address } }
+      end
+    end
+  end
+
+  def create
+    code = extract_code.to_s
+    pending_token = extract_pending_token
+
+    email = nil
+    if pending_token.present?
+      email = EmailVerificationCode.verify_token(pending_token, code)
+    end
+
+    if email.nil? && extract_email_address.present?
+      fallback_email = extract_email_address.to_s
+      email = EmailVerificationCode.verify(fallback_email, code) if Identity.new(email_address: fallback_email).valid?
+    end
+
+    if email
+      identity = Identity.find_or_create_by!(email_address: email)
+
+      if Current.identity.nil?
+        start_new_session_for identity
+      elsif Current.identity != identity
+        terminate_session if Current.session
+        start_new_session_for identity
+      end
+
+      cookies.delete(:pending_authentication_token)
+      redeem_and_redirect(identity)
+    else
+      respond_to do |format|
+        format.html { redirect_to join_verification_path(join_code: @join_code.code, script_name: @join_code.account.slug), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redeem_and_redirect(identity)
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def extract_code
+      params[:code].presence || params.dig(:verification, :code).presence || params.dig(:magic_link, :code).presence
+    end
+
+    def extract_email_address
+      params[:email_address].presence
+    end
+
+    def extract_pending_token
+      cookies[:pending_authentication_token].presence || params[:pending_authentication_token].presence
+    end
+
+    def pending_verification
+      token = extract_pending_token
+      return nil if token.blank?
+
+      record = EmailVerificationCode.find_by_pending_token(token)
+
+      if record.nil?
+        nil
+      elsif record.expired?
+        record.destroy
+        nil
+      else
+        record
+      end
+    end
+
+    def set_join_code
+      code = params[:join_code].presence || request.path_parameters[:join_code].presence
+      @join_code ||= code ? Account::JoinCode.find_by(code: code, account: Current.account) : nil
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
