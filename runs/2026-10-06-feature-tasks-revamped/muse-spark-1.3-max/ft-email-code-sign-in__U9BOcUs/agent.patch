+      params[:code].presence || params.dig(:signup, :code).presence || params.dig(:verification, :code).presence || params.dig(:magic_link, :code).presence
+    end
+
+    def extract_email_address
+      params[:email_address].presence || params.dig(:signup, :email_address).presence
+    end
+
+    def extract_pending_token
+      cookies[:pending_authentication_token].presence || params[:pending_authentication_token].presence || params.dig(:signup, :pending_authentication_token).presence
+    end
+
+    def pending_verification
+      token = extract_pending_token
+      return nil if token.blank?
+
+      record = EmailVerificationCode.find_by_pending_token(token)
+
+      if record.nil?
+        nil
+      elsif record.expired?
+        record.destroy
+        nil
+      else
+        record
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to signup_verification_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
