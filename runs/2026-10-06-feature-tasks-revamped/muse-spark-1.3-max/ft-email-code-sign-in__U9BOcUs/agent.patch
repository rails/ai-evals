diff --git a/app/models/email_verification_code.rb b/app/models/email_verification_code.rb
new file mode 100644
index 0000000..1f278d6
--- /dev/null
+++ b/app/models/email_verification_code.rb
@@ -0,0 +1,90 @@
+class EmailVerificationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  LIFETIME = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+  before_validation :set_expiry, on: :create, if: -> { expires_at.blank? }
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+
+  class << self
+    def generate_for(email_address)
+      normalized = email_address.to_s.strip.downcase
+
+      transaction do
+        where(email_address: normalized).delete_all
+        create!(email_address: normalized)
+      end
+    end
+
+    def verify(email_address, code)
+      normalized_email = email_address.to_s.strip.downcase
+      normalized_code = code.to_s.strip.upcase
+
+      return nil if normalized_email.blank? || normalized_code.blank?
+
+      record = active.find_by(email_address: normalized_email, code: normalized_code)
+      if record
+        email = record.email_address
+        record.destroy
+        email
+      end
+    end
+
+    def verify_token(token, code, purpose: :email_verification)
+      record = find_by_pending_token(token, purpose: purpose)
+      return nil unless record
+
+      normalized_code = code.to_s.strip.upcase
+      return nil if normalized_code.blank?
+
+      if record.expired?
+        record.destroy
+        nil
+      elsif codes_match?(record.code, normalized_code)
+        email = record.email_address
+        record.destroy
+        email
+      end
+    end
+
+    def find_by_pending_token(token, purpose: :email_verification)
+      return nil if token.blank?
+
+      find_signed(token, purpose: purpose)
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveSupport::MessageEncryptor::InvalidMessage, ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def codes_match?(stored, provided)
+      return false unless stored.to_s.length == provided.to_s.length
+
+      ActiveSupport::SecurityUtils.secure_compare(stored.to_s.upcase, provided.to_s.upcase)
+    rescue ArgumentError
+      false
+    end
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  def pending_token(purpose: :email_verification)
+    signed_id(purpose: purpose, expires_in: LIFETIME)
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def set_expiry
+      self.expires_at = LIFETIME.from_now
+    end
+end
