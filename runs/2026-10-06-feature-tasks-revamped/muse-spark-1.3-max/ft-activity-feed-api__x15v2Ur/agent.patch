diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..7477080
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,45 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    set_page_and_extract_portion_from activities
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def activities
+      scope = Event.preloaded.where(board: boards, action: TIMELINEABLE_ACTIONS)
+      scope = scope.where(creator_id: creator_ids) if creator_ids.present?
+      scope.order(created_at: :desc, id: :desc)
+    end
+
+    def boards
+      boards = Current.user.boards
+      boards = boards.where(id: board_ids) if board_ids.present?
+      boards
+    end
+
+    def board_ids
+      Array(params[:board_ids]).flatten.compact_blank
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).flatten.compact_blank
+    end
+end
diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..e4ba42a 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,34 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => Array(assignee_ids) }
+    when "card_board_changed"
+      {
+        "old_board" => nested_particular_value("old_board"),
+        "new_board" => nested_particular_value("new_board")
+      }
+    when "card_title_changed"
+      {
+        "old_title" => nested_particular_value("old_title"),
+        "new_title" => nested_particular_value("new_title")
+      }
+    when "card_triaged"
+      { "column" => nested_particular_value("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def nested_particular_value(key)
+      raw = particulars || {}
+      nested = raw["particulars"] || raw[:particulars] || {}
+      value = nested[key.to_s] || nested[key.to_sym]
+      value = raw[key.to_s] || raw[key.to_sym] if value.nil?
+      value.nil? ? "" : value.to_s
+    end
 end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..955eda9
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,21 @@
+json.(activity, :id, :action)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text.to_s
+json.particulars activity.activity_particulars
+
+if activity.eventable_type == "Comment"
+  json.url card_url(activity.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(activity.eventable))
+else
+  json.url card_url(activity.eventable)
+end
+
+json.eventable_type activity.eventable_type
+
+if activity.eventable_type == "Comment"
+  json.eventable activity.eventable, partial: "cards/comments/comment", as: :comment
+else
+  json.eventable activity.eventable, partial: "cards/card", as: :card
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
