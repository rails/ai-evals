+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used_later
+    Account::RecalculateBytesUsedJob.perform_later(id)
+  end
+
+  def recalculate_bytes_used!
+    update_columns(bytes_used: calculate_bytes_used)
+  end
+
+  def calculate_bytes_used
+    card_image_bytes_used + board_description_bytes_used + card_description_bytes_used + comment_bytes_used
+  end
+
+  class_methods do
+    def adjust_bytes_used(account_id, delta)
+      return if delta.zero?
+
+      update_counters(account_id, bytes_used: delta)
+    rescue ActiveRecord::RecordNotFound
+      # Account was deleted, nothing to do
+    end
+  end
+
+  private
+    def card_image_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(account_id: id, record_type: "Card", name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_description_bytes_used
+      rich_text_ids = ActionText::RichText.where(account_id: id, record_type: "Board", name: "public_description").select(:id)
+
+      ActiveStorage::Attachment.joins(:blob)
+        .where(account_id: id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_description_bytes_used
+      rich_text_ids = ActionText::RichText.where(account_id: id, record_type: "Card", name: "description").select(:id)
+
+      ActiveStorage::Attachment.joins(:blob)
+        .where(account_id: id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_bytes_used
+      rich_text_ids = ActionText::RichText.where(account_id: id, record_type: "Comment", name: "body").select(:id)
+
+      ActiveStorage::Attachment.joins(:blob)
+        .where(account_id: id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
