new file mode 100644
index 0000000..c6af5e9
--- /dev/null
+++ b/app/models/card/storage.rb
@@ -0,0 +1,65 @@
+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    # Use after_update (not after_update_commit) because handle_board_change
+    # performs a second save in the same transaction which would clear
+    # saved_change_to_board_id? before commit. Jobs enqueued here are still
+    # deferred until after commit via enqueue_after_transaction_commit.
+    after_update :transfer_storage_usage_if_board_changed, if: :saved_change_to_board_id?
+  end
+
+  def storage_bytes_used
+    image_bytes_used + description_bytes_used + comments_bytes_used
+  end
+
+  private
+    def transfer_storage_usage_if_board_changed
+      old_board_id = board_id_before_last_save
+      new_board_id = board_id
+
+      if old_board_id != new_board_id
+        total = storage_bytes_used
+
+        unless total.zero?
+          ::Storage::AdjustBytesUsedJob.perform_later(board_id: old_board_id, account_id: nil, byte_delta: -total)
+          ::Storage::AdjustBytesUsedJob.perform_later(board_id: new_board_id, account_id: nil, byte_delta: total)
+
+          transfer_storage_usage_between_accounts_if_needed(total, old_board_id, new_board_id)
+        end
+      end
+    end
+
+    def transfer_storage_usage_between_accounts_if_needed(total, old_board_id, new_board_id)
+      old_account_id = Board.where(id: old_board_id).pick(:account_id)
+      new_account_id = Board.where(id: new_board_id).pick(:account_id)
+
+      if old_account_id && new_account_id && old_account_id != new_account_id
+        ::Storage::AdjustBytesUsedJob.perform_later(board_id: nil, account_id: old_account_id, byte_delta: -total)
+        ::Storage::AdjustBytesUsedJob.perform_later(board_id: nil, account_id: new_account_id, byte_delta: total)
+      end
+    end
+
+    def image_bytes_used
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: id)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def description_bytes_used
+      rich_text_ids = ActionText::RichText.where(record_type: "Card", record_id: id, name: "description").select(:id)
+
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comments_bytes_used
+      comment_ids = Comment.where(card_id: id).select(:id)
+      rich_text_ids = ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comment_ids).select(:id)
+
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
