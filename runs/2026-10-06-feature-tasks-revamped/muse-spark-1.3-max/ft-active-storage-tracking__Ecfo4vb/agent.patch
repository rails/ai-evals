diff --git a/lib/rails_ext/active_storage_storage_tracking.rb b/lib/rails_ext/active_storage_storage_tracking.rb
new file mode 100644
index 0000000..143f952
--- /dev/null
+++ b/lib/rails_ext/active_storage_storage_tracking.rb
@@ -0,0 +1,120 @@
+# Tracks storage usage for card images and rich text embeds in board descriptions,
+# card descriptions, and comments. Deltas are applied in the background via
+# Storage::AdjustBytesUsedJob using atomic counter updates.
+
+module ActiveStorageStorageTrackingDelete
+  # Handles purge/purge_later/detach which bypass destroy callbacks via #delete.
+  # #destroy does not call #delete (it calls _delete_row directly), so there is
+  # no double-tracking with the destroy callbacks below.
+  def delete
+    details = begin
+      storage_usage_details_for_tracking
+    rescue => error
+      Rails.error.report(error)
+      nil
+    end
+
+    super.tap do
+      if details
+        begin
+          ::Storage::AdjustBytesUsedJob.perform_later(
+            account_id: details[:account_id],
+            board_id: details[:board_id],
+            byte_delta: -details[:byte_size]
+          )
+        rescue => error
+          Rails.error.report(error)
+        end
+      end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  before_destroy :capture_storage_usage_before_destroy, prepend: true
+  after_create_commit :track_storage_usage_on_create
+  after_destroy_commit :track_storage_usage_on_destroy
+
+  prepend ActiveStorageStorageTrackingDelete
+
+  private
+    def capture_storage_usage_before_destroy
+      @captured_storage_usage = storage_usage_details_for_tracking
+    rescue => error
+      Rails.error.report(error)
+      @captured_storage_usage = nil
+    end
+
+    def track_storage_usage_on_create
+      if details = storage_usage_details_for_tracking
+        ::Storage::AdjustBytesUsedJob.perform_later(
+          account_id: details[:account_id],
+          board_id: details[:board_id],
+          byte_delta: details[:byte_size]
+        )
+      end
+    rescue => error
+      Rails.error.report(error)
+    end
+
+    def track_storage_usage_on_destroy
+      if details = @captured_storage_usage
+        ::Storage::AdjustBytesUsedJob.perform_later(
+          account_id: details[:account_id],
+          board_id: details[:board_id],
+          byte_delta: -details[:byte_size]
+        )
+      end
+    rescue => error
+      Rails.error.report(error)
+    ensure
+      @captured_storage_usage = nil
+    end
+
+    def storage_usage_details_for_tracking
+      if record_type == "Card" && name == "image"
+        storage_details_for_card_image
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        storage_details_for_rich_text_embed
+      end
+    end
+
+    def storage_details_for_card_image
+      byte_size = ActiveStorage::Blob.where(id: blob_id).pick(:byte_size)
+      return nil unless byte_size
+
+      board_id = Card.where(id: record_id).pick(:board_id)
+
+      # If the card is gone we still adjust the account so it stays correct.
+      # The board adjustment is skipped when the board is unknown.
+      { account_id: account_id, board_id: board_id, byte_size: byte_size }
+    end
+
+    def storage_details_for_rich_text_embed
+      rich_text_type, rich_text_record_id, rich_text_name =
+        ActionText::RichText.where(id: record_id).pick(:record_type, :record_id, :name)
+      return nil unless rich_text_type
+
+      board_id = case [ rich_text_type, rich_text_name ]
+      when [ "Board", "public_description" ]
+        rich_text_record_id
+      when [ "Card", "description" ]
+        Card.where(id: rich_text_record_id).pick(:board_id)
+      when [ "Comment", "body" ]
+        Comment.where(id: rich_text_record_id).joins(:card).pick("cards.board_id")
+      else
+        return nil
+      end
+
+      byte_size = ActiveStorage::Blob.where(id: blob_id).pick(:byte_size)
+      return nil unless byte_size
+
+      # Board may be gone (e.g. card or comment already deleted). Account is
+      # still adjusted via the denormalized account_id on the attachment.
+      if board_id
+        { account_id: account_id, board_id: board_id, byte_size: byte_size }
+      else
+        { account_id: account_id, board_id: nil, byte_size: byte_size }
+      end
+    end
+end
