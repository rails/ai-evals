+module Comment::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :transfer_storage_usage_if_card_changed, if: :saved_change_to_card_id?
+  end
+
+  def storage_bytes_used
+    rich_text_ids = ActionText::RichText.where(record_type: "Comment", record_id: id, name: "body").select(:id)
+
+    ActiveStorage::Attachment.joins(:blob)
+      .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+      .sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def transfer_storage_usage_if_card_changed
+      old_card_id = card_id_before_last_save
+      new_card_id = card_id
+
+      if old_card_id != new_card_id
+        total = storage_bytes_used
+
+        unless total.zero?
+          old_board_id = Card.where(id: old_card_id).pick(:board_id)
+          new_board_id = Card.where(id: new_card_id).pick(:board_id)
+
+          if old_board_id && new_board_id && old_board_id != new_board_id
+            ::Storage::AdjustBytesUsedJob.perform_later(board_id: old_board_id, account_id: nil, byte_delta: -total)
+            ::Storage::AdjustBytesUsedJob.perform_later(board_id: new_board_id, account_id: nil, byte_delta: total)
+
+            old_account_id = Board.where(id: old_board_id).pick(:account_id)
+            new_account_id = Board.where(id: new_board_id).pick(:account_id)
+
+            if old_account_id && new_account_id && old_account_id != new_account_id
+              ::Storage::AdjustBytesUsedJob.perform_later(board_id: nil, account_id: old_account_id, byte_delta: -total)
+              ::Storage::AdjustBytesUsedJob.perform_later(board_id: nil, account_id: new_account_id, byte_delta: total)
+            end
+          end
+        end
+      end
+    end
+end
