diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..0183d87 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,95 @@
 module TimeHelper
+  # Render a <time> element whose human-readable text is filled in by the
+  # browser in the viewer's own timezone. The server only sends the raw
+  # timestamp (ISO 8601 in UTC) so the HTML is identical for everyone and
+  # can be safely cached and shared between people in different timezones.
+  #
+  # Formats:
+  #   :friendly  - "1:42 PM" today, "yesterday"/"tomorrow" adjacent days,
+  #                "5 days ago"/"in 3 days" within a week, else "Sep 12"
+  #   :relative  - "just now", "5 minutes ago", "2 hours ago", "5 days ago",
+  #                "in 3 days", "tomorrow"/"yesterday" handled via friendly
+  #   :time      - "1:42 PM"
+  #   :date      - "Sep 12" (with year when different year: "Sep 12, 2024")
+  #   :date_with_year / :stamp - "Sep 12, 2024"
+  #   :weekday_date / :long_date - "Monday, September 12"
+  #   :datetime / :short_datetime - "9/12/24, 1:42 PM"
+  #   :iso / :raw - raw ISO string (for debugging)
+  #
+  # The text content rendered by the server is a UTC fallback so the HTML
+  # stays timezone-independent. The Stimulus `time` controller replaces it
+  # with the viewer's local rendering on connect.
+  def formatted_time(time, format: :friendly, capitalize: false, **options)
+    if time.nil?
+      return ""
+    end
+
+    time = time.to_time if time.is_a?(Date) && !time.is_a?(Time)
+    utc_time = time.utc
+    iso = utc_time.iso8601
+    format_name = format.to_s
+
+    fallback = time_fallback_text(utc_time, format_name)
+    title = utc_time.strftime("%A, %B %-d, %Y at %-l:%M %p").strip + " UTC"
+
+    data = {
+      controller: "time",
+      time_datetime_value: iso,
+      time_format_value: format_name,
+      local: "time",
+      format: format_name
+    }
+    data[:time_capitalize_value] = "true" if capitalize
+
+    # Merge caller-provided data (e.g. extra classes) without clobbering ours.
+    caller_data = options.delete(:data) || {}
+    # Allow caller to pass class etc. via options.
+    tag.time fallback, datetime: iso, title: title, data: data.merge(caller_data), **options
+  end
+
+  def friendly_time(time, **options)
+    formatted_time(time, format: :friendly, **options)
+  end
+
+  def relative_time(time, **options)
+    formatted_time(time, format: :relative, **options)
+  end
+
+  def local_time(time, format: :friendly, **options)
+    formatted_time(time, format: format, **options)
+  end
+
+  # Aliases for compatibility with different naming expectations.
+  alias_method :friendly_datetime, :friendly_time
+  alias_method :local_datetime, :local_time
+  alias_method :time_ago, :relative_time
+  alias_method :relative_datetime, :relative_time
+
+  private
+    def time_fallback_text(utc_time, format_name)
+      case format_name
+      when "time"
+        utc_time.strftime("%-l:%M %p").strip
+      when "date", "short_date", "friendly", "relative", "calendar"
+        if utc_time.year == Time.now.utc.year
+          utc_time.strftime("%b %-d")
+        else
+          utc_time.strftime("%b %-d, %Y")
+        end
+      when "date_with_year", "stamp", "long"
+        utc_time.strftime("%b %d, %Y")
+      when "weekday_date", "long_date", "weekday", "full_date"
+        utc_time.strftime("%A, %B %-d")
+      when "datetime", "short_datetime", "numeric", "short"
+        utc_time.strftime("%-m/%-d/%y, %-l:%M %p").strip
+      when "iso", "raw"
+        utc_time.iso8601
+      else
+        if utc_time.year == Time.now.utc.year
+          utc_time.strftime("%b %-d")
+        else
+          utc_time.strftime("%b %-d, %Y")
+        end
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..697d29d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,61 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatByName, formatFullDatetime } from "helpers/time_helpers"
+
+// Renders a raw timestamp in the viewer's own timezone.
+//
+// The server sends `<time datetime="...Z" data-controller="time"
+// data-time-datetime-value="...Z" data-time-format-value="friendly">` and
+// this controller turns it into words like "1:42 PM", "yesterday",
+// "5 days ago", "Sep 12", "tomorrow" or "in 3 days".
+//
+// Because the HTML only contains the raw timestamp, it is identical for
+// everyone and can be cached and shared between people in different
+// timezones.
+export default class extends Controller {
+  static values = {
+    datetime: String,
+    format: { type: String, default: "friendly" },
+    capitalize: { type: Boolean, default: false }
+  }
+
+  connect() {
+    this.render()
+    this._timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    clearInterval(this._timer)
+  }
+
+  datetimeValueChanged() {
+    if (this.element.isConnected) this.render()
+  }
+
+  formatValueChanged() {
+    if (this.element.isConnected) this.render()
+  }
+
+  render() {
+    const datetime = this.datetimeValue || this.element.getAttribute("datetime") || this.element.getAttribute("data-datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date)) return
+
+    const format = this.formatValue || this.element.getAttribute("data-format") || this.element.getAttribute("data-local-format") || "friendly"
+    let text = formatByName(date, format)
+
+    if (this.capitalizeValue) {
+      text = text.charAt(0).toUpperCase() + text.slice(1)
+    }
+
+    this.element.textContent = text
+    this.element.setAttribute("title", formatFullDatetime(date))
+    this.element.setAttribute("datetime", date.toISOString())
+
+    const bridgeAncestor = this.element.closest("[data-bridge-description]")
+    if (bridgeAncestor && bridgeAncestor !== this.element) {
+      bridgeAncestor.setAttribute("data-bridge-description", text)
+    }
+  }
+}
