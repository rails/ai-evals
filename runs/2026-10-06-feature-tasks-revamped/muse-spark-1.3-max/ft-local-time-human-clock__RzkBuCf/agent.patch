diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..acd8883
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,187 @@
+// Format timestamps in the viewer's own timezone (the browser's resolved
+// timezone). The server sends raw ISO 8601 timestamps; these helpers turn
+// them into words like "1:42 PM", "yesterday", "5 days ago", "Sep 12",
+// "tomorrow" and "in 3 days".
+//
+// All day-boundary math uses the browser's local calendar days so midnight
+// follows the viewer, not the server.
+
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+export function formatTime(date) {
+  return formatWithOptions(date, { hour: "numeric", minute: "2-digit", hour12: true })
+}
+
+export function formatDate(date, { withYear = false } = {}) {
+  const now = new Date()
+  const showYear = withYear || date.getFullYear() !== now.getFullYear()
+
+  if (showYear) {
+    return formatWithOptions(date, { month: "short", day: "numeric", year: "numeric" })
+  } else {
+    return formatWithOptions(date, { month: "short", day: "numeric" })
+  }
+}
+
+export function formatDateWithYear(date) {
+  return formatWithOptions(date, { month: "short", day: "numeric", year: "numeric" })
+}
+
+export function formatWeekdayDate(date, { withYear = false } = {}) {
+  const now = new Date()
+  const showYear = withYear || date.getFullYear() !== now.getFullYear()
+
+  if (showYear) {
+    return formatWithOptions(date, { weekday: "long", month: "long", day: "numeric", year: "numeric" })
+  } else {
+    return formatWithOptions(date, { weekday: "long", month: "long", day: "numeric" })
+  }
+}
+
+export function formatShortDatetime(date) {
+  const datePart = `${date.getMonth() + 1}/${date.getDate()}/${String(date.getFullYear()).slice(-2)}`
+  return `${datePart}, ${formatTime(date)}`
+}
+
+export function formatFullDatetime(date) {
+  const weekdayDate = formatWithOptions(date, { weekday: "long", month: "long", day: "numeric", year: "numeric" })
+  return `${weekdayDate} at ${formatTime(date)}`
+}
+
+// Friendly calendar-relative format:
+//
+//   today          -> "1:42 PM"
+//   yesterday      -> "yesterday"
+//   tomorrow       -> "tomorrow"
+//   within a week  -> "5 days ago" / "in 3 days"
+//   further out    -> "Sep 12" (with year when different year)
+export function formatFriendly(date, now = new Date()) {
+  const diffDays = signedDifferenceInDays(now, date)
+
+  if (diffDays === 0) {
+    return formatTime(date)
+  } else if (diffDays === -1) {
+    return "yesterday"
+  } else if (diffDays === 1) {
+    return "tomorrow"
+  } else if (diffDays < 0 && diffDays > -7) {
+    return `${Math.abs(diffDays)} days ago`
+  } else if (diffDays > 1 && diffDays < 7) {
+    return `in ${diffDays} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+// Elapsed-relative format ("time ago").
+//
+//   < 1 minute  -> "just now"
+//   < 1 hour    -> "5 minutes ago" / "in 5 minutes"
+//   < 1 day     -> "2 hours ago" / "in 2 hours"
+//   < 1 month   -> "5 days ago" / "in 5 days"
+//   < 1 year    -> "3 months ago" / "in 3 months"
+//   else        -> "2 years ago" / "in 2 years"
+//
+// Unlike friendly, this uses elapsed time, not calendar days, so it matches
+// the old server `time_ago_in_words ... ago` behavior while staying fresh
+// in the browser.
+export function formatRelative(date, now = new Date()) {
+  const diffMs = date - now
+  const absMs = Math.abs(diffMs)
+  const absSeconds = Math.floor(absMs / 1000)
+  const isFuture = diffMs > 0
+
+  if (absSeconds < 60) {
+    if (absSeconds < 10) return "just now"
+    return isFuture ? `in ${absSeconds} seconds` : `${absSeconds} seconds ago`
+  }
+
+  const absMinutes = Math.floor(absSeconds / 60)
+  if (absMinutes < 60) {
+    if (absMinutes === 1) return isFuture ? "in 1 minute" : "1 minute ago"
+    return isFuture ? `in ${absMinutes} minutes` : `${absMinutes} minutes ago`
+  }
+
+  const absHours = Math.floor(absMinutes / 60)
+  if (absHours < 24) {
+    if (absHours === 1) return isFuture ? "in 1 hour" : "1 hour ago"
+    return isFuture ? `in ${absHours} hours` : `${absHours} hours ago`
+  }
+
+  const absDays = Math.floor(absHours / 24)
+  if (absDays < 30) {
+    if (absDays === 1) return isFuture ? "in 1 day" : "1 day ago"
+    return isFuture ? `in ${absDays} days` : `${absDays} days ago`
+  }
+
+  const absMonths = Math.floor(absDays / 30)
+  if (absMonths < 12) {
+    if (absMonths === 1) return isFuture ? "in 1 month" : "1 month ago"
+    return isFuture ? `in ${absMonths} months` : `${absMonths} months ago`
+  }
+
+  const absYears = Math.floor(absDays / 365)
+  if (absYears === 1) return isFuture ? "in 1 year" : "1 year ago"
+  return isFuture ? `in ${absYears} years` : `${absYears} years ago`
+}
+
+// Dispatch by format name. Supports many aliases so views can use the most
+// descriptive name for each context.
+export function formatByName(date, formatName, now = new Date()) {
+  const format = (formatName || "friendly").toString()
+
+  switch (format) {
+    case "friendly":
+    case "calendar":
+    case "smart":
+    case "comment":
+      return formatFriendly(date, now)
+    case "relative":
+    case "ago":
+    case "time-ago":
+    case "time_ago":
+    case "elapsed":
+      return formatRelative(date, now)
+    case "time":
+    case "hour":
+      return formatTime(date)
+    case "date":
+    case "short_date":
+    case "short-date":
+      return formatDate(date)
+    case "date_with_year":
+    case "date-with-year":
+    case "stamp":
+    case "long":
+      return formatDateWithYear(date)
+    case "weekday_date":
+    case "weekday-date":
+    case "long_date":
+    case "long-date":
+    case "weekday":
+    case "full_date":
+    case "full-date":
+      return formatWeekdayDate(date)
+    case "datetime":
+    case "short_datetime":
+    case "short-datetime":
+    case "numeric":
+    case "short":
+      return formatShortDatetime(date)
+    case "full":
+    case "full_datetime":
+    case "full-datetime":
+      return formatFullDatetime(date)
+    case "iso":
+    case "raw":
+      return date.toISOString()
+    default:
+      return formatFriendly(date, now)
+  }
+}
+
+// Normalize Intl output: en-US hour formatting can include a narrow
+// no-break space before AM/PM; use a regular space for stable strings.
+function formatWithOptions(date, options) {
+  return new Intl.DateTimeFormat("en-US", options).format(date).replace(/[\u202F\u00A0]/g, " ")
+}
