+
+You have <%= pluralize(@notifications.size, "new notification") %> in Fizzy:
+<% @notifications.each do |notification| %>
+- <%= notification.card.title.presence || "Card #{notification.card.number}" %><% if notification.unread_count.to_i > 1 %> (<%= notification.unread_count %> updates)<% end %>
+  <%= card_url(notification.card) %>
+<% end %>
+
+View all notifications: <%= notifications_url %>
