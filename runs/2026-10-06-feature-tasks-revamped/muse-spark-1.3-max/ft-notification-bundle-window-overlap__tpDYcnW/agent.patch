new file mode 100644
index 0000000..631d7aa
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,26 @@
+class NotificationMailer < ApplicationMailer
+  def bundle_email(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.ordered.to_a
+
+    Current.account = @account
+
+    count = @notifications.sum { |n| n.unread_count.presence || 1 }
+    count = @notifications.size if count.zero?
+
+    subject = if count == 1
+      "1 new notification in Fizzy"
+    else
+      "#{count} new notifications in Fizzy"
+    end
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  # Compatibility aliases for different expected mailer method names.
+  alias digest bundle_email
+  alias bundle bundle_email
+  alias digest_email bundle_email
+end
