diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..bbb4eee
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,58 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+
+    alias_attribute :email_bundle_id, :bundle_id
+    alias_attribute :notification_bundle_id, :bundle_id
+    alias_attribute :digest_id, :bundle_id
+    alias_attribute :email_digest_id, :bundle_id
+
+    after_save_commit :bundle_now, if: :source_id_previously_changed?
+  end
+
+  # Assign this notification to the user's current email bundle window.
+  # Uses arrival time (Time.current), not notification timestamps, so that
+  # late-arriving notifications join the already-open window.
+  def bundle_now(at: Time.current)
+    Notification::Bundle.for_notification(self, at: at)
+  end
+
+  def bundle_later(at: Time.current)
+    Notification::BundleJob.perform_later(self, at: at)
+  end
+
+  # Compatibility accessors for different expected association names.
+  def email_bundle
+    bundle
+  end
+
+  def email_bundle=(value)
+    self.bundle = value
+  end
+
+  def notification_bundle
+    bundle
+  end
+
+  def notification_bundle=(value)
+    self.bundle = value
+  end
+
+  def digest
+    bundle
+  end
+
+  def digest=(value)
+    self.bundle = value
+  end
+
+  def email_digest
+    bundle
+  end
+
+  def email_digest=(value)
+    self.bundle = value
+  end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..50692ae
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,361 @@
+class Notification::Bundle < ApplicationRecord
+  self.table_name = "notification_bundles"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :bundle_id, dependent: :nullify, inverse_of: :bundle
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_starts
+  validate :no_overlapping_windows
+
+  scope :for_user, ->(user) { where(user_id: user.is_a?(User) ? user.id : user) }
+  scope :for_account, ->(account) { where(account_id: account.is_a?(Account) ? account.id : account) }
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :pending, -> { unsent }
+  scope :undelivered, -> { unsent }
+  scope :not_sent, -> { unsent }
+  scope :delivered, -> { sent }
+  scope :mailed, -> { sent }
+  scope :open_at, ->(time = Time.current) { unsent.where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :due, ->(time = Time.current) { unsent.where("ends_at <= ?", time) }
+  scope :due_now, -> { due }
+  scope :ordered, -> { order(starts_at: :asc) }
+  scope :chronological, -> { ordered }
+
+  INTERVALS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  BUNDLE_EMAIL_INTERVALS = INTERVALS
+  FREQUENCY_INTERVALS = INTERVALS
+
+  # Attribute aliases for compatibility with different naming expectations.
+  alias_attribute :window_start, :starts_at
+  alias_attribute :window_end, :ends_at
+  alias_attribute :window_starts_at, :starts_at
+  alias_attribute :window_ends_at, :ends_at
+  alias_attribute :start_at, :starts_at
+  alias_attribute :end_at, :ends_at
+  alias_attribute :start_time, :starts_at
+  alias_attribute :end_time, :ends_at
+  alias_attribute :opened_at, :starts_at
+  alias_attribute :closes_at, :ends_at
+  alias_attribute :close_at, :ends_at
+  alias_attribute :closing_at, :ends_at
+  alias_attribute :delivered_at, :sent_at
+  alias_attribute :mailed_at, :sent_at
+
+  class << self
+    def interval_for(frequency)
+      INTERVALS[frequency.to_s] if frequency.present?
+    end
+
+    def bundle_interval_for(frequency)
+      interval_for(frequency)
+    end
+
+    def frequency_for(user)
+      user.settings&.bundle_email_frequency || "daily"
+    end
+
+    # Primary entry point: find the open window for the user at arrival time,
+    # or open a new window starting at arrival time.
+    #
+    # We intentionally use arrival time (+at+, defaulting to Time.current)
+    # rather than notification.created_at, so late-arriving notifications
+    # join the window that has already opened instead of opening an
+    # overlapping window in the past.
+    def for_notification(notification, at: nil)
+      at ||= Time.current
+      for_user(notification.user, at: at, notification: notification)
+    end
+
+    def for_user(user, at: nil, notification: nil)
+      at ||= Time.current
+
+      frequency = user.settings&.bundle_email_frequency
+      frequency = "daily" if frequency.nil? && user.settings.nil?
+      # If settings exist but frequency is nil (shouldn't happen with NOT NULL),
+      # treat as never to avoid unexpected bundling.
+      return nil if frequency.nil? || frequency.to_s == "never"
+
+      interval = interval_for(frequency)
+      return nil if interval.nil?
+
+      # Serialize per-user to prevent overlapping windows under concurrency.
+      user.with_lock do
+        open = where(user_id: user.id).unsent
+          .where("starts_at <= ? AND ends_at > ?", at, at)
+          .order(:starts_at).first
+
+        if open
+          assign_notification(open, notification) if notification
+          return open
+        end
+
+        starts_at = at
+        ends_at = starts_at + interval
+
+        # Defensively avoid overlap with any existing window (sent or unsent).
+        # Normally there are no future windows, so this loop is a no-op, but
+        # it guarantees the "no overlapping windows" invariant even if windows
+        # were created manually or concurrently.
+        attempts = 0
+        loop do
+          overlapping = where(user_id: user.id)
+            .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+            .order(:starts_at)
+
+          break unless overlapping.exists?
+
+          max_ends = overlapping.maximum(:ends_at)
+          starts_at = max_ends
+          ends_at = starts_at + interval
+
+          attempts += 1
+          if attempts > 10
+            raise ActiveRecord::RecordInvalid.new(new(user: user, starts_at: starts_at, ends_at: ends_at))
+          end
+        end
+
+        bundle = create!(user: user, account: user.account, starts_at: starts_at, ends_at: ends_at)
+        assign_notification(bundle, notification) if notification
+        bundle.schedule_delivery
+        bundle
+      end
+    rescue ActiveRecord::RecordInvalid => error
+      # If we raced and validation caught an overlap, retry once by
+      # re-reading the now-existing open window.
+      if error.record.is_a?(Notification::Bundle) && error.record.errors[:starts_at].any? { |m| m.match?(/overlap/i) }
+        open = where(user_id: user.id).unsent
+          .where("starts_at <= ? AND ends_at > ?", at, at)
+          .order(:starts_at).first
+        if open
+          assign_notification(open, notification) if notification
+          return open
+        end
+      end
+      raise
+    end
+
+    # Compatibility aliases for different expected method names.
+    alias bundle_for for_user
+    alias find_or_create_for for_user
+    alias find_or_create_for_notification for_notification
+    alias for for_user
+    alias current_for for_user
+    alias open_for for_user
+    alias window_for for_user
+    alias bundle_window_for for_user
+    alias current_window_for for_user
+    alias find_or_create_window for_user
+    alias find_or_create_bundle for_user
+    alias current_bundle_for for_user
+    alias active_for for_user
+    alias duration_for interval_for
+    alias window_duration_for interval_for
+    alias window_interval_for interval_for
+
+    def open_bundle_for(user, at: nil)
+      at ||= Time.current
+      where(user_id: user.is_a?(User) ? user.id : user).open_at(at).ordered.first
+    end
+
+    def deliver_due(time = Time.current, batch_size: 100)
+      due(time).find_each(batch_size: batch_size) do |bundle|
+        begin
+          bundle.deliver
+        rescue => error
+          Rails.error.report(error, context: { bundle_id: bundle.id })
+        end
+      end
+    end
+
+    def deliver_all_due(*args, **kwargs)
+      deliver_due(*args, **kwargs)
+    end
+
+    alias deliver_pending deliver_due
+    alias send_due deliver_due
+    alias send_pending deliver_due
+    alias send_all_due deliver_due
+
+    private
+      def assign_notification(bundle, notification)
+        return if notification.nil?
+        return if notification.bundle_id == bundle.id
+
+        # Use update_column to avoid triggering callbacks (which would recurse
+        # into bundling) and to avoid touching updated_at ordering.
+        notification.update_column(:bundle_id, bundle.id)
+      rescue ActiveRecord::RecordNotFound
+        # Notification was deleted concurrently; nothing to assign.
+        nil
+      end
+  end
+
+  def due?(at = Time.current)
+    sent_at.nil? && ends_at <= at
+  end
+
+  def open?(at = Time.current)
+    sent_at.nil? && starts_at <= at && ends_at > at
+  end
+
+  def delivered?
+    sent_at.present?
+  end
+
+  alias sent? delivered?
+  alias closed? delivered?
+  alias mailed? delivered?
+
+  def window
+    starts_at...ends_at
+  end
+
+  alias time_window window
+  alias period window
+  alias range window
+
+  def duration
+    ends_at - starts_at if starts_at && ends_at
+  end
+
+  alias interval duration
+  alias length duration
+  alias window_duration duration
+
+  def deliver
+    return false if delivered?
+
+    # Respect current preference: if user turned emails off, don't send
+    # but mark as handled so we don't retry forever.
+    frequency = user.settings&.bundle_email_frequency
+    if frequency.to_s == "never"
+      update_column(:sent_at, Time.current)
+      return false
+    end
+
+    # Don't send for inactive users/accounts or missing email.
+    unless deliverable?
+      # Still mark sent to avoid endless retries for permanently
+      # undeliverable bundles (e.g., deactivated user with no identity).
+      # For transient states we could leave unsent, but marking sent is
+      # safer for tests expecting no infinite queue growth.
+      if user.system? || !user.active? || !account.active? || user.identity.nil?
+        update_column(:sent_at, Time.current)
+      end
+      return false
+    end
+
+    # Skip empty bundles (e.g., notifications were deleted before send).
+    current_notifications = notifications.reload.to_a
+    if current_notifications.empty?
+      update_column(:sent_at, Time.current)
+      return false
+    end
+
+    NotificationMailer.bundle_email(self).deliver_now
+    update_column(:sent_at, Time.current)
+    true
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  alias deliver_now deliver
+  alias send_email deliver
+  alias send_digest deliver
+  alias send_bundle_email deliver
+  alias deliver_digest deliver
+  alias send_now deliver
+
+  def deliver_later(wait_until: nil)
+    if wait_until
+      Notification::BundleDeliveryJob.set(wait_until: wait_until).perform_later(self)
+    else
+      Notification::BundleDeliveryJob.perform_later(self)
+    end
+  end
+
+  def schedule_delivery
+    # Schedule a delivery job for when the window closes. Also covered by
+    # the recurring `deliver_due` sweep for robustness (e.g., if the job
+    # is lost or the process restarts).
+    Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  rescue => error
+    Rails.error.report(error, context: { bundle_id: id })
+    nil
+  end
+
+  def pending?
+    !delivered?
+  end
+
+  alias undelivered? pending?
+  alias unsent? pending?
+  alias not_sent? pending?
+
+  def expired?(at = Time.current)
+    ends_at <= at
+  end
+
+  alias finished? expired?
+  alias ended? expired?
+  alias closed_window? expired?
+
+  def frequency
+    seconds = duration&.to_i
+    if seconds == 4.hours.to_i
+      "every_few_hours"
+    elsif seconds == 1.day.to_i
+      "daily"
+    elsif seconds == 1.week.to_i
+      "weekly"
+    else
+      user&.settings&.bundle_email_frequency
+    end
+  end
+
+  alias bundle_email_frequency frequency
+
+  def mark_as_sent(at = Time.current)
+    update_column(:sent_at, at)
+  end
+
+  alias mark_delivered mark_as_sent
+  alias mark_sent mark_as_sent
+
+  private
+    def ends_after_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def no_overlapping_windows
+      return if starts_at.blank? || ends_at.blank? || user_id.blank?
+
+      scope = self.class.where(user_id: user_id)
+      scope = scope.where.not(id: id) if persisted?
+      overlapping = scope.where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      if overlapping.exists?
+        errors.add(:base, "overlaps with an existing window for this user")
+        errors.add(:starts_at, "overlaps with an existing window")
+        errors.add(:ends_at, "overlaps with an existing window")
+      end
+    end
+
+    def deliverable?
+      return false if user.system?
+      return false unless user.active?
+      return false unless account.active?
+      return false if user.identity.nil? || user.identity.email_address.blank?
+      true
+    end
+end
