+      ::ActiveStorage::Attachment.where(account: account).where(record_type: INTERNAL_RECORD_TYPES + %w[ActiveStorage::VariantRecord]).select(:blob_id)
     end
 
+    def compressible?(blob)
+      content_type = blob.content_type.to_s
