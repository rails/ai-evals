+class ExportMailer < ApplicationMailer
+  def ready(export)
+    @export = export
+    @account = export.account
+    @user = export.creator
+    @download_url = export_download_url(@export.download_signed_id, script_name: nil)
+
+    Current.with_account(@account) do
+      mail(
+        to: @user.identity.email_address,
+        subject: "Your #{@export.account? ? "account" : "cards"} export is ready"
+      )
+    end
+  end
+end
diff --git a/app/mailers/import_mailer.rb b/app/mailers/import_mailer.rb
new file mode 100644
index 0000000..458da82
--- /dev/null
+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,28 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.imported_account || import.account
+    @identity = import.identity
+
+    Current.with_account(@account) do
+      @account_url = @account ? landing_url(script_name: @account.slug) : root_url(script_name: nil)
+      mail(
+        to: @identity.email_address,
+        subject: "Your import is complete"
+      )
+    end
+  end
+
+  def failed(import)
+    @import = import
+    @identity = import.identity
+    @error_message = import.error_message.presence || "Something went wrong"
+
+    Current.with_account(import.account) do
+      mail(
+        to: @identity.email_address,
+        subject: "Your import failed"
+      )
+    end
+  end
+end
