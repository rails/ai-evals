new file mode 100644
index 0000000..598b2cd
--- /dev/null
+++ b/app/models/account/data_transfer/import_context.rb
@@ -0,0 +1,83 @@
+class Account::DataTransfer::ImportContext
+  attr_reader :target_account, :source_account_id, :uploader_identity
+
+  def initialize(target_account, source_account_id: nil, uploader_identity: nil)
+    @target_account = target_account
+    @source_account_id = source_account_id
+    @uploader_identity = uploader_identity
+    @id_maps = {}
+    @identity_cache = {}
+  end
+
+  def store_id_map(model, map)
+    key = model.is_a?(Class) ? model.name : model.to_s
+    @id_maps[key] ||= {}
+    @id_maps[key].merge!(map)
+  end
+
+  def id_map_for(type_name)
+    @id_maps[type_name.to_s] || {}
+  end
+
+  def remap_foreign_key(model, key, old_id)
+    return nil if old_id.nil?
+
+    # Identity references are handled via email lookup, not ID maps.
+    # The User record set handles identity_id specially.
+    if key == "identity_id"
+      return nil
+    end
+
+    # Try association reflection first for precision.
+    if model.is_a?(Class)
+      assoc = model.reflect_on_all_associations(:belongs_to).find { |a| a.foreign_key.to_s == key.to_s }
+      if assoc
+        target_class = assoc.klass rescue nil
+        if target_class
+          mapped = id_map_for(target_class.name)[old_id]
+          return mapped if mapped
+          # Account references always map to the target account.
+          return target_account.id if target_class == Account
+        end
+      end
+    end
+
+    # Fallback: search all maps for the old ID.
+    @id_maps.each_value do |map|
+      return map[old_id] if map.key?(old_id)
+    end
+
+    nil
+  end
+
+  def remap_polymorphic_id(type_name, old_id)
+    return nil if old_id.nil? || type_name.nil?
+
+    # Account containers always map to the target account.
+    if type_name.to_s == "Account"
+      return target_account.id
+    end
+
+    mapped = id_map_for(type_name.to_s)[old_id]
+    return mapped if mapped
+
+    # Fallback search across all maps.
+    @id_maps.each_value do |map|
+      return map[old_id] if map.key?(old_id)
+    end
+
+    nil
+  end
+
+  def find_or_create_identity_for_email(email)
+    return nil if email.blank?
+
+    normalized = email.to_s.strip.downcase
+    @identity_cache[normalized] ||= Identity.find_or_create_by!(email_address: normalized)
+  end
+
+  def lookup_new_id(type_name, old_id)
+    return target_account.id if type_name.to_s == "Account" && old_id == source_account_id
+    id_map_for(type_name.to_s)[old_id]
+  end
+end
