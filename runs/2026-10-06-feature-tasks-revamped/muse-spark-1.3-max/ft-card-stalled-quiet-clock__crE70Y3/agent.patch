diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..99f18f3
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,66 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS_COUNT = 3
+  BURST_MIN_PEOPLE = 2
+
+  included do
+    scope :with_burst, -> { where.not(burst_at: nil) }
+    scope :stalled, -> { active.with_burst.where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    if active? && burst?
+      last_active_at <= STALLED_AFTER.ago
+    else
+      false
+    end
+  end
+
+  def register_burst!
+    update!(burst_at: Time.current)
+  end
+
+  def clear_burst!
+    if burst?
+      update!(burst_at: nil)
+    end
+  end
+
+  def check_comment_burst!
+    if burst_from_comments?
+      register_burst!
+    end
+  end
+
+  def burst_from_comments?
+    newest = user_comments.order(created_at: :desc, id: :desc).first
+
+    if newest.present?
+      window_start = newest.created_at - burst_window
+      window_comments = user_comments.where(created_at: window_start..newest.created_at)
+
+      if window_comments.count >= BURST_COMMENTS_COUNT
+        window_comments.distinct.count(:creator_id) >= BURST_MIN_PEOPLE
+      else
+        false
+      end
+    else
+      false
+    end
+  end
+
+  private
+    def user_comments
+      Comment.where(card_id: id).by_user
+    end
+
+    def burst_window
+      board.auto_postpone_period / 3.0
+    end
+end
