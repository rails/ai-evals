diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..efcf5b8
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,95 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale
+      ensure_current_identity_for_locale
+      requested = params[:locale]&.to_s
+
+      if requested.present?
+        if available_locale?(requested)
+          I18n.locale = requested.to_sym
+          session[:locale] = I18n.locale.to_s
+          persist_locale(I18n.locale.to_s)
+        else
+          set_locale_from_session_or_persisted
+        end
+      else
+        set_locale_from_session_or_persisted
+      end
+    end
+
+    def set_locale_from_session_or_persisted
+      session_locale = session[:locale]&.to_s
+      if session_locale.present? && available_locale?(session_locale)
+        I18n.locale = session_locale.to_sym
+        sync_session_locale_to_persisted(session_locale)
+      elsif (persisted = persisted_locale).present? && available_locale?(persisted)
+        I18n.locale = persisted.to_sym
+        session[:locale] = I18n.locale.to_s
+      else
+        I18n.locale = I18n.default_locale
+      end
+    end
+
+    def persisted_locale
+      Current.user&.locale.presence || Current.identity&.locale.presence
+    rescue
+      nil
+    end
+
+    def persist_locale(locale_str)
+      if Current.identity.present?
+        begin
+          if Current.identity.locale != locale_str
+            Current.identity.update_column(:locale, locale_str)
+            Current.identity.locale = locale_str
+          end
+        rescue => e
+          Rails.logger.warn "Failed to persist locale to identity: #{e.message}"
+        end
+      end
+
+      if Current.user.present?
+        begin
+          if Current.user.locale != locale_str
+            Current.user.update_column(:locale, locale_str)
+            Current.user.locale = locale_str
+          end
+        rescue => e
+          Rails.logger.warn "Failed to persist locale to user: #{e.message}"
+        end
+      end
+    end
+
+    def sync_session_locale_to_persisted(session_locale)
+      return unless Current.identity.present? || Current.user.present?
+
+      persisted = persisted_locale
+      if persisted != session_locale
+        persist_locale(session_locale)
+      end
+    end
+
+    def available_locale?(locale_str)
+      I18n.available_locales.map(&:to_s).include?(locale_str.to_s)
+    end
+
+    def ensure_current_identity_for_locale
+      return if Current.identity.present?
+      return unless respond_to?(:find_session_by_cookie, true)
+
+      begin
+        if session_record = find_session_by_cookie
+          Current.session = session_record
+        end
+      rescue
+        nil
+      end
+    end
+end
