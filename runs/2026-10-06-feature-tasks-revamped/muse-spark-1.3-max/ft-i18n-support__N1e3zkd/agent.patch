+
+    def with_locale_for(recipient, &block)
+      locale = recipient_locale(recipient)
+      I18n.with_locale(locale, &block)
+    end
+
+    def recipient_locale(recipient)
+      raw = if recipient.respond_to?(:locale_or_default)
+        recipient.locale_or_default
+      elsif recipient.respond_to?(:locale)
+        recipient.locale.presence
+      end
+      raw = raw.to_s if raw
+      if raw.present? && I18n.available_locales.map(&:to_s).include?(raw)
