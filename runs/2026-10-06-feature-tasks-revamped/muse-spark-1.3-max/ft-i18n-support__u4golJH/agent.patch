+# frozen_string_literal: true
+
+# Pluralization rule for Japanese: always :other (no plural forms)
+I18n.backend.class.send(:include, I18n::Backend::Pluralization)
+
+ja_plural = {
+  ja: {
+    i18n: {
+      plural: {
+        keys: [:other],
+        rule: ->(n) { :other }
+      }
+    }
+  }
+}
+
+I18n.backend.store_translations(:ja, ja_plural[:ja])
