diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..95f5d31
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,67 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :with_locale
+    after_action :translate_response_to_japanese
+    helper_method :current_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def with_locale(&action)
+      requested = params[:locale]&.to_s
+
+      if requested.present? && I18n.available_locales.map(&:to_s).include?(requested)
+        # Explicit valid choice: apply, remember in session, persist for next sign-in
+        session[:locale] = requested
+        persist_locale_to_identity(requested) if authenticated?
+        I18n.with_locale(requested, &action)
+      elsif requested.present?
+        # Unsupported locale: ignore entirely, do not break
+        I18n.with_locale(resolve_locale, &action)
+      else
+        # No explicit choice: session wins, then persisted identity preference, then default
+        resolved = resolve_locale
+        # Keep session in sync when falling back to persisted preference
+        session[:locale] = resolved.to_s if authenticated? && session[:locale].blank? && Current.identity&.locale.present?
+        I18n.with_locale(resolved, &action)
+      end
+    end
+
+    def resolve_locale
+      session_locale = session[:locale]&.to_s
+      if session_locale.present? && I18n.available_locales.map(&:to_s).include?(session_locale)
+        session_locale.to_sym
+      elsif authenticated? && Current.identity&.locale.present? && I18n.available_locales.map(&:to_s).include?(Current.identity.locale.to_s)
+        Current.identity.locale.to_sym
+      else
+        I18n.default_locale
+      end
+    end
+
+    def persist_locale_to_identity(locale)
+      identity = Current.identity
+      if identity && identity.locale.to_s != locale.to_s
+        identity.update!(locale: locale)
+      end
+    rescue ActiveRecord::RecordInvalid
+      # Ignore validation failures; session still holds the choice
+    end
+
+    def current_locale
+      I18n.locale
+    end
+
+    def translate_response_to_japanese
+      return unless I18n.locale.to_s == "ja"
+      return unless response.content_type&.include?("html")
+      return if response.body.blank?
+
+      translated = JapaneseTranslator.translate(response.body)
+      response.body = translated
+    rescue => e
+      Rails.logger.warn "Japanese translation failed: #{e.message}"
+    end
+end
