diff --git a/test/integration/full_check.rb b/test/integration/full_check.rb
new file mode 100644
index 0000000..1ea7e22
--- /dev/null
+++ b/test/integration/full_check.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+class FullCheck < ActionDispatch::IntegrationTest
+  test "full pages" do
+    sign_in_as :kevin
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    pages = {}
+    pages["events"] = events_path(locale: "ja")
+    pages["board_show"] = board_path(board, locale: "ja")
+    pages["card_show"] = card_path(card, locale: "ja")
+    pages["notifications"] = notifications_path(locale: "ja")
+    pages["notif_settings"] = notifications_settings_path(locale: "ja")
+    pages["account_settings"] = account_settings_path(locale: "ja")
+    pages["join_code"] = account_join_code_path(locale: "ja")
+    pages["search"] = search_path(locale: "ja")
+    pages["user_show"] = user_path(users(:david), locale: "ja")
+    pages["webhooks"] = board_webhooks_path(board, locale: "ja")
+
+    pages.each do |name, path|
+      get path
+      assert_response :success, "#{name} failed"
+      File.write("/tmp/full_#{name}_ja.html", response.body)
+      puts "#{name} ok #{response.body.size}"
+    end
+
+    untenanted do
+      get new_session_path(locale: "ja")
+      File.write("/tmp/full_session_new_ja.html", response.body)
+      puts "session_new ok"
+
+      get new_signup_path(locale: "ja")
+      File.write("/tmp/full_signup_new_ja.html", response.body)
+      puts "signup_new ok"
+
+      get session_magic_link_path(locale: "ja")
+      # This requires pending auth? Might redirect. Try.
+      puts "magic_link status #{response.status}" rescue puts "magic_link error"
+    end
+  end
+end
