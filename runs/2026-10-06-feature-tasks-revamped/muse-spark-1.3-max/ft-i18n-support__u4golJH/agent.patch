diff --git a/app/javascript/helpers/locale_helpers.js b/app/javascript/helpers/locale_helpers.js
new file mode 100644
index 0000000..44b1e07
--- /dev/null
+++ b/app/javascript/helpers/locale_helpers.js
@@ -0,0 +1,15 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+export function currentLocale() {
+  return getMetaContent("locale") || document.documentElement.lang || "en"
+}
+
+export function dateLocale() {
+  const locale = currentLocale()
+  if (locale === "ja") return "ja-JP"
+  return "en-US"
+}
+
+export function isJapanese() {
+  return currentLocale().startsWith("ja")
+}
