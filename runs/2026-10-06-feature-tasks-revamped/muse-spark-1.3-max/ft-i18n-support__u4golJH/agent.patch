--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -13,4 +13,17 @@ class ApplicationMailer < ActionMailer::Base
         super
       end
     end
+
+    def recipient_locale_for(identity)
+      locale = identity&.locale&.to_s
+      if locale.present? && I18n.available_locales.map(&:to_s).include?(locale)
+        locale.to_sym
+      else
+        I18n.default_locale
+      end
+    end
+
+    def with_recipient_locale(identity, &block)
+      I18n.with_locale(recipient_locale_for(identity), &block)
+    end
 end
