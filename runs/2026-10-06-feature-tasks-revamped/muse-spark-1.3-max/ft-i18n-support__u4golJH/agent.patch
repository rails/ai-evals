+  # - /Check your (.+?) settings/ (25) beats "Check your" (10)
+  # - /Which cards are.../ beats "assigned to " fragment
+  SORTED_TRANSLATIONS = begin
+    strings, regexps = TRANSLATIONS.partition { |(en, _)| en.is_a?(String) }
+    full_strings, fragment_strings = strings.partition { |(en, _)| !(en.end_with?(" ") || en == en.strip && en.split.size == 1 && en.length < 10) }
+    (full_strings + regexps).sort_by { |(en, _)| en.is_a?(String) ? -en.length : -en.source.length } +
+      fragment_strings.sort_by { |(en, _)| -en.length }
+  end.freeze
+
+  def self.translate(html)
+    return html if html.blank?
+    result = html.dup
+    SORTED_TRANSLATIONS.each do |(en, ja)|
+      if en.is_a?(Regexp)
+        result.gsub!(en, ja)
+      else
+        result.gsub!(en, ja)
+      end
+    end
+    result
+  end
