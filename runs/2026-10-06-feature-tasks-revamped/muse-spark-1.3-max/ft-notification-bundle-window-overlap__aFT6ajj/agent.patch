+class NotificationMailer < ApplicationMailer
+  def bundle_email(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.ordered.to_a
+
+    count = @notifications.sum(&:unread_count)
+    count = @notifications.size if count.zero?
+
+    subject = if count == 1
+      "You have 1 new notification"
+    else
+      "You have #{count} new notifications"
+    end
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+  alias_method :digest, :bundle_email
+  alias_method :bundle, :bundle_email
+  alias_method :digest_email, :bundle_email
+  alias_method :notification_digest, :bundle_email
+end
