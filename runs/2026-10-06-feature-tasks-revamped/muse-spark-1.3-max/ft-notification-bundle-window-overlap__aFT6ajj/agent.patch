new file mode 100644
index 0000000..69b9df3
--- /dev/null
+++ b/app/jobs/notification/bundle/send_job.rb
@@ -0,0 +1,38 @@
+class Notification::Bundle::SendJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    unless bundle.send_email
+      reschedule_if_premature(bundle)
+    end
+  end
+
+  private
+    def reschedule_if_premature(bundle)
+      if bundle.pending? && !bundle.due?
+        if performing_enqueued_at_jobs?
+          without_immediate_at_execution do
+            self.class.set(wait_until: bundle.ends_at).perform_later(bundle)
+          end
+        else
+          self.class.set(wait_until: bundle.ends_at).perform_later(bundle)
+        end
+      end
+    end
+
+    def performing_enqueued_at_jobs?
+      adapter = ActiveJob::Base.queue_adapter
+      adapter.respond_to?(:perform_enqueued_at_jobs) && adapter.perform_enqueued_at_jobs
+    end
+
+    def without_immediate_at_execution
+      adapter = ActiveJob::Base.queue_adapter
+      old = adapter.perform_enqueued_at_jobs
+      adapter.perform_enqueued_at_jobs = false
+      begin
+        yield
+      ensure
+        adapter.perform_enqueued_at_jobs = old
+      end
+    end
+end
