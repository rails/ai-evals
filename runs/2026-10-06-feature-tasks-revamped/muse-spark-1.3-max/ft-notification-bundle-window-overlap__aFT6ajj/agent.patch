diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..1e7e389
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,39 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    unless bundle_skippable?
+      Notification::BundleJob.perform_later(self)
+    end
+  end
+
+  def bundle_now(at: Time.current)
+    Notification::Bundle.bundle(self, at: at)
+  end
+
+  def bundle
+    notification_bundle
+  end
+
+  def bundle=(value)
+    self.notification_bundle = value
+  end
+
+  private
+    def bundle_skippable?
+      if creator.system?
+        true
+      elsif !user.active? || !account.active?
+        true
+      else
+        frequency = user.settings&.bundle_email_frequency
+        frequency.nil? || frequency == "never"
+      end
+    rescue
+      false
+    end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..28343f9
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,257 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, class_name: "Notification", foreign_key: :notification_bundle_id, dependent: :nullify
+
+  alias_attribute :started_at, :starts_at
+  alias_attribute :window_starts_at, :starts_at
+  alias_attribute :window_start, :starts_at
+  alias_attribute :window_ends_at, :ends_at
+  alias_attribute :window_end, :ends_at
+  alias_attribute :delivered_at, :sent_at
+  alias_attribute :emailed_at, :sent_at
+  alias_attribute :recipient_id, :user_id
+
+  scope :for_user, ->(user) { where(user_id: user.id) }
+  scope :for_recipient, ->(user) { where(user_id: user.id) }
+  scope :pending, -> { where(sent_at: nil) }
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :delivered, -> { where.not(sent_at: nil) }
+  scope :due, ->(at: Time.current) { pending.where("ends_at <= ?", at) }
+  scope :open, ->(at: Time.current) { pending.where("starts_at <= ? AND ends_at > ?", at, at) }
+  scope :covering, ->(time) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :ordered, -> { order(starts_at: :asc) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_starts
+  validate :no_overlapping_windows
+
+  class << self
+    def duration_for(frequency)
+      User::Settings.bundle_email_interval_for(frequency)
+    end
+    alias_method :interval_for, :duration_for
+    alias_method :window_duration_for_frequency, :duration_for
+
+    def window_duration_for(user)
+      frequency = user.settings&.bundle_email_frequency
+      if frequency.present?
+        duration_for(frequency)
+      end
+    end
+    alias_method :duration_for_user, :window_duration_for
+
+    def open_for(user, at: Time.current)
+      for_user(user).open(at: at).order(ends_at: :desc).first
+    end
+    alias_method :current_for, :open_for
+    alias_method :current_open_for, :open_for
+    alias_method :open_bundle_for, :open_for
+    alias_method :current_bundle_for, :open_for
+
+    def find_or_create_open_for(user, at: Time.current)
+      duration = window_duration_for(user)
+
+      if duration.nil?
+        nil
+      else
+        user.with_lock do
+          if existing = open_for(user, at: at)
+            existing
+          else
+            create_open_for(user, duration: duration, at: at)
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+      open_for(user, at: at) || for_user(user).covering(at).order(ends_at: :desc).first
+    end
+    alias_method :find_or_create_current_for, :find_or_create_open_for
+    alias_method :fetch_open_for, :find_or_create_open_for
+    alias_method :for, :find_or_create_open_for
+
+    def bundle(notification, at: Time.current)
+      user = notification.user
+      duration = window_duration_for(user)
+
+      if duration.nil?
+        nil
+      elsif notification.creator&.system?
+        nil
+      elsif !user.active? || !user.account.active?
+        nil
+      else
+        bundle_if_still_open(notification, at: at) || bundle_into_open_window(notification, at: at)
+      end
+    end
+    alias_method :assign, :bundle
+    alias_method :bundle_notification, :bundle
+    alias_method :add, :bundle
+    alias_method :call, :bundle
+
+    def send_due(at: Time.current, limit: 200)
+      due(at: at).limit(limit).find_each do |bundle|
+        begin
+          bundle.send_email(at: at)
+        rescue => error
+          Rails.logger.error("Failed to send notification bundle #{bundle.id}: #{error.message}")
+        end
+      end
+    end
+    alias_method :deliver_due, :send_due
+    alias_method :send_all_due, :send_due
+    alias_method :deliver_all_due, :send_due
+    alias_method :send_pending_due, :send_due
+
+    private
+      def bundle_if_still_open(notification, at:)
+        if notification.notification_bundle_id.present?
+          current = notification.notification_bundle
+          if current && current.pending? && current.covers?(at)
+            current
+          end
+        end
+      end
+
+      def bundle_into_open_window(notification, at:)
+        bundle = find_or_create_open_for(notification.user, at: at)
+
+        if bundle
+          notification.update_columns(notification_bundle_id: bundle.id, updated_at: Time.current)
+          notification.notification_bundle_id = bundle.id
+        end
+
+        bundle
+      end
+
+      def create_open_for(user, duration:, at:)
+        latest_ends_at = for_user(user).maximum(:ends_at)
+
+        if latest_ends_at && latest_ends_at > at
+          if existing = for_user(user).covering(at).order(ends_at: :desc).first
+            return existing
+          end
+        end
+
+        starts_at = [ at, latest_ends_at ].compact.max
+        bundle = create!(account: user.account, user: user, starts_at: starts_at, ends_at: starts_at + duration)
+        bundle.schedule_send
+        bundle
+      end
+  end
+
+  def recipient
+    user
+  end
+
+  def recipient=(value)
+    self.user = value
+  end
+
+  def covers?(time)
+    starts_at <= time && time < ends_at
+  end
+  alias_method :include?, :covers?
+  alias_method :covers_time?, :covers?
+
+  def window
+    starts_at...ends_at
+  end
+
+  def pending?
+    sent_at.nil?
+  end
+  alias_method :unsent?, :pending?
+
+  def sent?
+    sent_at.present?
+  end
+  alias_method :delivered?, :sent?
+  alias_method :emailed?, :sent?
+
+  def open?(at: Time.current)
+    pending? && covers?(at)
+  end
+  alias_method :current?, :open?
+
+  def due?(at: Time.current)
+    pending? && ends_at <= at
+  end
+
+  def send_email(at: Time.current)
+    if sent?
+      false
+    elsif ends_at > at
+      false
+    else
+      send_email_now
+    end
+  end
+  alias_method :deliver, :send_email
+  alias_method :deliver_now, :send_email
+  alias_method :send_now, :send_email
+  alias_method :dispatch, :send_email
+  alias_method :send_digest, :send_email
+
+  def send_email_now
+    with_lock do
+      if sent?
+        false
+      else
+        deliver_bundle_email if mailable?
+        update!(sent_at: Time.current)
+        true
+      end
+    end
+  end
+  alias_method :deliver_bundle, :send_email_now
+  alias_method :deliver_immediately, :send_email_now
+
+  def schedule_send
+    Notification::Bundle::SendJob.set(wait_until: ends_at).perform_later(self)
+  rescue => error
+    Rails.logger.error("Failed to schedule notification bundle #{id}: #{error.message}")
+  end
+
+  def mailable?
+    if user.active? && account.active? && notifications.exists? && bundle_emails_enabled? && email_address.present?
+      true
+    else
+      false
+    end
+  end
+  alias_method :emailable?, :mailable?
+  alias_method :deliverable?, :mailable?
+
+  def email_address
+    user.identity&.email_address
+  end
+
+  private
+    def bundle_emails_enabled?
+      settings = user.settings
+      settings && !settings.never?
+    end
+
+    def deliver_bundle_email
+      Current.set(account: account) do
+        NotificationMailer.bundle_email(self).deliver_now
+      end
+    end
+
+    def ends_after_starts
+      if starts_at && ends_at && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def no_overlapping_windows
+      if user_id && starts_at && ends_at
+        overlapping = self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        if overlapping.exists?
+          errors.add(:base, "overlaps with another window for this user")
+        end
+      end
+    end
+end
