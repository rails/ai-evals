diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..5b706d3
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,40 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { card&.account || comment&.account }
+  belongs_to :card, touch: true
+  belongs_to :comment, touch: true, optional: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :for_card, -> { where(comment_id: nil) }
+  scope :for_comment, ->(comment) { where(comment: comment) }
+
+  before_validation :set_card_from_comment
+  before_validation :strip_content
+
+  def reacter
+    creator
+  end
+
+  def reacter=(user)
+    self.creator = user
+  end
+
+  def reacter_id
+    creator_id
+  end
+
+  def reacter_id=(id)
+    self.creator_id = id
+  end
+
+  private
+    def set_card_from_comment
+      self.card ||= comment&.card
+    end
+
+    def strip_content
+      self.content = content.strip if content.present?
+    end
+end
