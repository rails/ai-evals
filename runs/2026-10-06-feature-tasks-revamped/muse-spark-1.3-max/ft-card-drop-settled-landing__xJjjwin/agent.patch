diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..82ae482
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,367 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoveredContainer = null
+    this.sourceNextSibling = null
+
+    this.onDragStart = this.onDragStart.bind(this)
+    this.onDragEnd = this.onDragEnd.bind(this)
+    this.onDragOver = this.onDragOver.bind(this)
+    this.onDragEnter = this.onDragEnter.bind(this)
+    this.onDragLeave = this.onDragLeave.bind(this)
+    this.onDrop = this.onDrop.bind(this)
+
+    this.element.addEventListener("dragstart", this.onDragStart)
+    this.element.addEventListener("dragend", this.onDragEnd)
+    this.element.addEventListener("dragover", this.onDragOver)
+    this.element.addEventListener("dragenter", this.onDragEnter)
+    this.element.addEventListener("dragleave", this.onDragLeave)
+    this.element.addEventListener("drop", this.onDrop)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.onDragStart)
+    this.element.removeEventListener("dragend", this.onDragEnd)
+    this.element.removeEventListener("dragover", this.onDragOver)
+    this.element.removeEventListener("dragenter", this.onDragEnter)
+    this.element.removeEventListener("dragleave", this.onDragLeave)
+    this.element.removeEventListener("drop", this.onDrop)
+  }
+
+  itemTargetConnected(item) {
+    item.setAttribute("draggable", "true")
+    item.querySelectorAll("a, img").forEach((el) => {
+      el.setAttribute("draggable", "false")
+    })
+  }
+
+  // Event handlers
+
+  onDragStart(event) {
+    const item = this.#findItem(event.target)
+
+    if (item) {
+      this.draggedItem = item
+      this.sourceContainer = this.#findContainer(item)
+      this.sourceNextSibling = item.nextElementSibling
+
+      item.classList.add(this.#draggedClass)
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = "move"
+        try { event.dataTransfer.setData("text/plain", item.id || "card") } catch (e) {}
+      }
+    }
+  }
+
+  onDragEnd(event) {
+    this.#clearDragState()
+  }
+
+  onDragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#findContainer(event.target)
+
+    if (!container) {
+      this.#clearHover()
+      return
+    }
+
+    if (container) {
+      event.preventDefault()
+
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      if (container !== this.hoveredContainer) {
+        this.#clearHover()
+        this.hoveredContainer = container
+        container.classList.add(this.#hoverClass)
+      }
+    }
+  }
+
+  onDragEnter(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#findContainer(event.target)
+
+    if (container && container !== this.hoveredContainer) {
+      this.#clearHover()
+      this.hoveredContainer = container
+      container.classList.add(this.#hoverClass)
+    }
+  }
+
+  onDragLeave(event) {
+    const container = this.#findContainer(event.target)
+
+    if (container && container === this.hoveredContainer) {
+      const related = event.relatedTarget
+      if (!related || !container.contains(related)) {
+        container.classList.remove(this.#hoverClass)
+        if (this.hoveredContainer === container) {
+          this.hoveredContainer = null
+        }
+      }
+    }
+  }
+
+  onDrop(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#findContainer(event.target)
+
+    if (container) {
+      event.preventDefault()
+      event.stopPropagation()
+
+      const item = this.draggedItem
+      const source = this.sourceContainer
+      const target = container
+
+      this.#clearHover()
+
+      if (target !== source) {
+        this.#moveInstantly(item, source, target)
+      }
+
+      item.classList.remove(this.#draggedClass)
+      this.draggedItem = null
+      this.sourceContainer = null
+      this.sourceNextSibling = null
+      this.hoveredContainer = null
+    }
+  }
+
+  // Private
+
+  #moveInstantly(item, source, target) {
+    const sourceList = source?.querySelector(".cards__list")
+    const nextSibling = this.sourceNextSibling
+    const sourceColor = item.style.getPropertyValue("--card-color")
+    const hadPostponed = item.classList.contains("card--postponed")
+    const hadActive = item.classList.contains("card--active")
+    const stagesState = this.#snapshotStages(item)
+
+    // Move DOM immediately so the board is already the way it was left.
+    this.#insertAtTop(target, item)
+    this.#adjustCounts(source, target)
+    this.#refreshCardAppearance(item, target)
+
+    // Persist in the background with JSON so nothing re-renders afterwards.
+    this.#persistMove(item, target).then((ok) => {
+      if (!ok) {
+        this.#revertMove(item, sourceList, nextSibling, source, target, { sourceColor, hadPostponed, hadActive, stagesState })
+      }
+    })
+  }
+
+  #insertAtTop(container, item) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    const firstCard = list.querySelector(".card")
+
+    if (firstCard) {
+      firstCard.before(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  async #persistMove(item, target) {
+    const destination = target.dataset.dragAndDropDestination
+    const columnId = target.dataset.dragAndDropColumnId
+
+    const triageUrl = item.dataset.dragAndDropTriageUrl || item.dataset.cardTriageUrl
+    const closureUrl = item.dataset.dragAndDropClosureUrl || item.dataset.cardClosureUrl
+    const notNowUrl = item.dataset.dragAndDropNotNowUrl || item.dataset.cardNotNowUrl
+
+    try {
+      let response = null
+
+      if (destination === "column" && columnId && triageUrl) {
+        const separator = triageUrl.includes("?") ? "&" : "?"
+        response = await post(`${triageUrl}${separator}column_id=${encodeURIComponent(columnId)}`, { responseKind: "json" })
+      } else if (destination === "stream" && triageUrl) {
+        response = await destroy(triageUrl, { responseKind: "json" })
+      } else if (destination === "closed" && closureUrl) {
+        response = await post(closureUrl, { responseKind: "json" })
+      } else if ((destination === "not_now" || destination === "not-now") && notNowUrl) {
+        response = await post(notNowUrl, { responseKind: "json" })
+      } else {
+        return false
+      }
+
+      return response.ok
+    } catch (e) {
+      return false
+    }
+  }
+
+  #revertMove(item, sourceList, nextSibling, source, target, snapshot) {
+    if (sourceList) {
+      if (nextSibling && nextSibling.isConnected) {
+        nextSibling.before(item)
+      } else {
+        const firstCard = sourceList.querySelector(".card")
+        if (firstCard) {
+          firstCard.before(item)
+        } else {
+          sourceList.prepend(item)
+        }
+      }
+    }
+
+    this.#adjustCounts(target, source)
+
+    if (snapshot.sourceColor) {
+      item.style.setProperty("--card-color", snapshot.sourceColor)
+    }
+
+    item.classList.toggle("card--postponed", snapshot.hadPostponed)
+    item.classList.toggle("card--active", snapshot.hadActive)
+    this.#restoreStages(item, snapshot.stagesState)
+  }
+
+  #adjustCounts(source, target) {
+    if (source) this.#changeCount(source, -1)
+    if (target) this.#changeCount(target, 1)
+  }
+
+  #changeCount(container, delta) {
+    const counter = container.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const text = counter.textContent.trim()
+
+    if (text === "99+") {
+      if (delta < 0) {
+        // Unknown exact count; keep capped display.
+      }
+      return
+    }
+
+    const current = parseInt(text, 10)
+    if (isNaN(current)) return
+
+    const next = Math.max(0, current + delta)
+    counter.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #refreshCardAppearance(item, target) {
+    const destination = target.dataset.dragAndDropDestination
+    const columnId = target.dataset.dragAndDropColumnId
+    const columnColor = target.dataset.dragAndDropColumnColor
+
+    if (destination === "column") {
+      item.classList.remove("card--postponed")
+      item.classList.add("card--active")
+      if (columnColor) item.style.setProperty("--card-color", columnColor)
+      this.#highlightStage(item, columnId)
+    } else if (destination === "stream") {
+      item.classList.remove("card--postponed")
+      item.classList.add("card--active")
+      item.style.setProperty("--card-color", "var(--color-card-default)")
+      this.#highlightStage(item, null)
+    } else if (destination === "closed" || destination === "not_now" || destination === "not-now") {
+      if (destination === "not_now" || destination === "not-now") {
+        item.classList.add("card--postponed")
+      } else {
+        item.classList.remove("card--postponed")
+      }
+      item.classList.remove("card--active")
+      item.style.setProperty("--card-color", "var(--color-card-complete)")
+      if (destination === "not_now" || destination === "not-now") {
+        this.#highlightStage(item, null)
+      }
+    }
+  }
+
+  #snapshotStages(item) {
+    return Array.from(item.querySelectorAll(".card__stages .card__column-name")).map((el) => ({
+      element: el,
+      current: el.classList.contains("card__column-name--current")
+    }))
+  }
+
+  #restoreStages(item, snapshot) {
+    if (!snapshot) return
+    snapshot.forEach(({ element, current }) => {
+      if (element.isConnected) element.classList.toggle("card__column-name--current", current)
+    })
+  }
+
+  #highlightStage(item, columnId) {
+    const stages = item.querySelectorAll(".card__stages .card__column-name")
+    if (!stages.length) return
+
+    stages.forEach((el) => {
+      const elColumnId = el.dataset.columnId || el.dataset.dragAndDropColumnId
+      if (columnId && elColumnId) {
+        el.classList.toggle("card__column-name--current", elColumnId === String(columnId))
+      } else if (columnId) {
+        // Fallback when stages lack ids: match by order is unreliable, so clear
+        // and let the next refresh correct; keep optimistic color/count only.
+      } else {
+        el.classList.remove("card__column-name--current")
+      }
+    })
+  }
+
+  #findItem(element) {
+    if (element instanceof Element) {
+      return element.closest('[data-drag-and-drop-target="item"]')
+    }
+    return null
+  }
+
+  #findContainer(element) {
+    if (element instanceof Element) {
+      return element.closest('[data-drag-and-drop-target="container"]')
+    }
+    return null
+  }
+
+  #clearHover() {
+    if (this.hoveredContainer) {
+      this.hoveredContainer.classList.remove(this.#hoverClass)
+      this.hoveredContainer = null
+    }
+
+    this.containerTargets.forEach((container) => {
+      container.classList.remove(this.#hoverClass)
+    })
+  }
+
+  #clearDragState() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.#draggedClass)
+    }
+
+    this.#clearHover()
+
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoveredContainer = null
+    this.sourceNextSibling = null
+  }
+
+  get #draggedClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+}
