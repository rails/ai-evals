new file mode 100644
index 0000000..7435cc1
--- /dev/null
+++ b/config/initializers/runner_console_logging.rb
@@ -0,0 +1,12 @@
+# rails runner (unlike rails server) only writes to the env log file by default.
+# Import runbook scripts such as script/library_report.rb need those same lines
+# on the terminal as well, without dropping the file record our log tooling reads.
+Rails.application.runner do
+  next if ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+
+  console = ActiveSupport::Logger.new(STDOUT)
+  console.formatter = Rails.logger.formatter
+  # Keep SQL/debug noise in the log file; the report uses info/warn.
+  console.level = Logger::INFO
+  Rails.logger.broadcast_to(console)
+end
