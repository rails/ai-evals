diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..8de1869
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Import target", everyone_access: false)
+    @kevin = users(:kevin)
+    @jz = users(:jz)
+  end
+
+  test "imports grants and notifies after commit" do
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @jz.id, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal [ @kevin.id, @jz.id ], result.accesses.map(&:user_id)
+    assert_equal [ "reader", "editor" ], result.accesses.map(&:level)
+    assert @book.accesses.exists?(user: @kevin, level: "reader")
+    assert @book.accesses.exists?(user: @jz, level: "editor")
+  end
+
+  test "turns down a duplicate without notifying or keeping any new access" do
+    existing = @book.accesses.create!(user: @kevin, level: "reader")
+    grants = [
+      { user_id: @jz.id, level: "editor" },
+      { user_id: @kevin.id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_not @book.accesses.exists?(user: @jz)
+    assert_equal existing.id, @book.accesses.find_by!(user: @kevin).id
+  end
+
+  test "turns down an unknown level like any other bad row" do
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @jz.id, level: "owner" }
+    ]
+
+    result = nil
+    assert_nothing_raised do
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_not @book.accesses.exists?(user: @kevin)
+    assert_not @book.accesses.exists?(user: @jz)
+  end
+
+  test "write cost does not grow with roster size on success or rejection" do
+    four = create_grants(4, "four")
+    sixteen = create_grants(16, "sixteen")
+
+    success_four = count_writes { Book::AccessImport.new(fresh_book, four).import }
+    success_sixteen = count_writes { Book::AccessImport.new(fresh_book, sixteen).import }
+    assert_equal success_four, success_sixteen
+
+    taken = fresh_book
+    taken.accesses.create!(user: users(:david), level: "reader")
+    reject_four = [ { user_id: users(:david).id, level: "reader" } ] + four[1..]
+    reject_sixteen = [ { user_id: users(:david).id, level: "reader" } ] + sixteen[1..]
+
+    fail_four = count_writes { Book::AccessImport.new(taken, reject_four).import }
+    fail_sixteen = count_writes { Book::AccessImport.new(taken, reject_sixteen).import }
+    assert_equal fail_four, fail_sixteen
+  end
+
+  private
+    def fresh_book
+      Book.create!(title: "Roster #{SecureRandom.hex(4)}", everyone_access: false)
+    end
+
+    def create_grants(count, prefix)
+      count.times.map do |i|
+        user = User.create!(name: "#{prefix}#{i}", email_address: "#{prefix}#{i}@example.com", password: "secret123456")
+        { user_id: user.id, level: "reader" }
+      end
+    end
+
+    def count_writes(&block)
+      count = 0
+      counter = ->(*, payload) {
+        sql = payload[:sql].to_s
+        count += 1 if sql.match?(/\A\s*(INSERT|UPDATE|DELETE)/i)
+      }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      count
+    end
+end
