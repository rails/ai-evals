--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,27 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "show does not render a page from another book by swapping ids" do
+    sign_in :kevin
+
+    get leafable_slug_path(leaves(:welcome_page), book_id: books(:manual).id, book_slug: books(:manual).slug)
+
+    assert_response :not_found
+  end
+
+  test "show does not render an unreadable page under another book id" do
+    secret = books(:manual).press Page.new(body: "Top secret"), title: "Secret Manual Page"
+
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{secret.id}/#{secret.slug}"
+
+    assert_response :not_found
+  end
