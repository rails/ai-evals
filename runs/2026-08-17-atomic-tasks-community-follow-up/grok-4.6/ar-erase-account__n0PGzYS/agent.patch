diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..61edb23 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,71 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase removes the user and all personal records" do
+    kevin = users(:kevin)
+    session = kevin.sessions.start!(user_agent: "Mozilla", ip_address: "1.2.3.4")
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+    original_email = kevin.email_address
+
+    assert SignInEvent.for_address(original_email).exists?
+
+    kevin.erase
+
+    assert_nil User.find_by(id: kevin.id)
+    assert_not Session.exists?(user_id: kevin.id)
+    assert_not Access.exists?(user_id: kevin.id)
+    assert_not ReadingMark.exists?(user_id: kevin.id)
+    assert_not SignInEvent.for_address(original_email).exists?
+    assert_not SignInEvent.exists?(session.attributes.slice("ip_address", "user_agent"))
+  end
+
+  test "erase keeps shared books and bylines them as Deleted author" do
+    kevin = users(:kevin)
+    shared = Book.create!(title: "Shared Handbook", author: "Kevin", everyone_access: true, creator: kevin)
+    leaf = shared.press(Page.new(body: "Kevin's public notes"), title: "Notes")
+    leaf.reindex
+
+    kevin.erase
+
+    shared.reload
+    assert_nil shared.creator_id
+    assert_equal "Deleted author", shared.author
+    assert Book.exists?(shared.id)
+    assert Leaf.exists?(leaf.id)
+    assert_includes Leaf.search("public notes"), leaf
+  end
+
+  test "erase destroys private books the user created" do
+    kevin = users(:kevin)
+    private_book = Book.create!(title: "Kevin Diary", author: "Kevin", everyone_access: false, creator: kevin)
+    leaf = private_book.press(Page.new(body: "secret diary entry"), title: "Diary")
+    leaf.reindex
+
+    kevin.erase
+
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_empty Leaf.search("secret diary")
+  end
+
+  test "erase works for previously deactivated users and their original sign-in emails" do
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+    kevin.sessions.start!(user_agent: "Mozilla", ip_address: "9.9.9.9")
+    assert SignInEvent.for_address(original_email).exists?
+
+    kevin.deactivate
+    deactivated_email = kevin.reload.email_address
+    assert_match(/-deactivated-/, deactivated_email)
+    assert_not_equal original_email, deactivated_email
+
+    kevin.erase
+
+    assert_nil User.find_by(id: kevin.id)
+    assert_not User.exists?(email_address: original_email)
+    assert_not User.exists?(email_address: deactivated_email)
+    assert_not SignInEvent.for_address(original_email).exists?
+    assert_not SignInEvent.for_address(deactivated_email).exists?
+  end
 end
