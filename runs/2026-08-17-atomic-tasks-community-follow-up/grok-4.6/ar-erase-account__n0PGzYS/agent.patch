diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..ab913c9 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,11 +24,41 @@ class User < ApplicationRecord
     end
   end
 
+  def erase
+    transaction do
+      original_email = original_email_address
+
+      anonymize_shared_books
+      destroy_private_books
+      sessions.delete_all
+      erase_sign_in_events(original_email)
+      destroy!
+    end
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def original_email_address
+      email_address.to_s.sub(/-deactivated-[0-9a-f-]+@/i, "@")
+    end
+
+    def anonymize_shared_books
+      created_books.with_everyone_access.find_each do |book|
+        book.update!(creator: nil, author: "Deleted author")
+      end
+    end
+
+    def destroy_private_books
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+    end
+
+    def erase_sign_in_events(original_email)
+      SignInEvent.where(email_address: [ email_address, original_email ].uniq).delete_all
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
