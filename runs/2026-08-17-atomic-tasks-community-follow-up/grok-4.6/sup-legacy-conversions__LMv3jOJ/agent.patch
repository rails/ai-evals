diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..f6b4e26
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:handbook)
+    sign_in :kevin
+  end
+
+  test "show renders the last updated stamp and character summary" do
+    leaves(:welcome_page).leafable.update!(body: "Welcome page content")
+    leaves(:summary_page).leafable.update!(body: "Summary page content")
+    @book.update_column :updated_at, Time.zone.local(2024, 11, 10, 8, 30)
+
+    get book_report_path(@book)
+
+    assert_response :success
+    assert_in_body "Last updated November 10, 2024"
+    assert_in_body @book.reload.report_summary
+    assert_match(/\d{1,3}(,\d{3})* characters/, response.body)
+  end
+
+  test "text download uses formatted dates, numbers, and leaf ids" do
+    @book.update_columns created_at: Time.zone.local(2020, 1, 15, 9, 0),
+      updated_at: Time.zone.local(2024, 6, 2, 14, 5)
+
+    get book_report_path(@book, format: :text)
+
+    assert_response :success
+    assert_match(/shelf-report-#{@book.updated_at.to_fs(:number)}\.txt/, response.headers["Content-Disposition"])
+    assert_includes response.body, "Book: Handbook"
+    assert_includes response.body, "Started: #{@book.created_at.to_fs(:long)}"
+    assert_includes response.body, "Updated: #{@book.updated_at.to_fs(:short)}"
+    assert_includes response.body, "Covers: #{@book.leaves.active.positioned.to_a.to_fs(:db)}"
+  end
+end
