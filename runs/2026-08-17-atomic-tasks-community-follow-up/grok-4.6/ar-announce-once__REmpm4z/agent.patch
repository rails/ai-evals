diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..ee5cd73 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,27 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :capture_publication_before_sitting
+    after_commit :announce_publication, on: :update
+    after_rollback :reset_publication_sitting
   end
 
   private
+    def capture_publication_before_sitting
+      @publication_before_sitting = published_in_database unless defined?(@publication_before_sitting)
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      AnnouncePublicationJob.perform_later self if went_live_this_sitting?
+    ensure
+      reset_publication_sitting
+    end
+
+    def went_live_this_sitting?
+      defined?(@publication_before_sitting) && published? && !@publication_before_sitting
+    end
+
+    def reset_publication_sitting
+      remove_instance_variable(:@publication_before_sitting) if defined?(@publication_before_sitting)
     end
 end
