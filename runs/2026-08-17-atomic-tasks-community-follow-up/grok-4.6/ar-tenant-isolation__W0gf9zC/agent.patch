index 0000000..9ca360f
--- /dev/null
+++ b/test/controllers/tenants_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class TenantsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+
+    users(:kevin).update!(tenant: @acme)
+    users(:jz).update!(tenant: @globex)
+
+    books(:handbook).update!(tenant: @acme)
+    books(:manual).update!(tenant: @globex, published: true)
+
+    # Cross-tenant access row, as "share with everyone" can spray them.
+    Access.find_or_create_by!(user: users(:kevin), book: books(:manual)) do |access|
+      access.level = :reader
+    end
+  end
+
+  test "index hides other tenants' books even when published and access exists" do
+    sign_in :kevin
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "show 404s another tenant's book and keeps the user signed in" do
+    sign_in :kevin
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+  end
+
+  test "page show 404s inside another tenant's book" do
+    sign_in :kevin
+    leaf = books(:manual).press Page.new(body: "Secret"), title: "Hidden"
+
+    get leafable_path(leaf)
+    assert_response :not_found
+  end
+
+  test "edit history 404s for a page in another tenant's book" do
+    sign_in :kevin
+    leaf = books(:manual).press Page.new(body: "Original"), title: "Hidden"
+    leaf.edit leafable_params: { body: "Changed" }
+
+    get page_edit_url(leaf, leaf.edits.last)
+    assert_response :not_found
+
+    get page_edit_url(leaf, "latest")
+    assert_response :not_found
+  end
+
+  test "same tenant books and histories still work" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    leaves(:welcome_page).edit leafable_params: { body: "Updated" }
+    get page_edit_url(leaves(:welcome_page), "latest")
+    assert_response :success
+  end
+
+  test "signed-out visitors still see published books from any tenant" do
+    get book_slug_url(books(:manual))
+    assert_response :success
+  end
+
+  test "users page still names everyone on the install" do
+    sign_in :kevin
+    get users_url
+
+    assert_response :success
+    assert_select "strong", text: /Kevin/
+    assert_select "strong", text: /JZ/
+  end
+
+  test "creating a book assigns the current user's tenant" do
+    sign_in :kevin
+
+    post books_url, params: { book: { title: "Acme Notes", everyone_access: false } }
+
+    book = Book.find_by!(title: "Acme Notes")
+    assert_equal @acme, book.tenant
+    assert_redirected_to book_slug_url(book)
+  end
+end
diff --git a/test/models/tenant_test.rb b/test/models/tenant_test.rb
new file mode 100644
index 0000000..32a1331
--- /dev/null
+++ b/test/models/tenant_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class TenantTest < ActiveSupport::TestCase
+  test "new books inherit the creator's tenant" do
+    tenant = Tenant.create!(name: "Acme")
+    user = users(:kevin)
+    user.update!(tenant: tenant)
+
+    Current.set(user: user) do
+      book = Book.create!(title: "From Kevin")
+      assert_equal tenant, book.tenant
+    end
+  end
+
+  test "accessable_or_published hides other tenants' books from signed-in users" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    kevin = users(:kevin)
+    kevin.update!(tenant: acme)
+    books(:handbook).update!(tenant: acme)
+    books(:manual).update!(tenant: globex, published: true)
+
+    Current.set(user: kevin) do
+      visible = Book.accessable_or_published
+
+      assert_includes visible, books(:handbook)
+      assert_not_includes visible, books(:manual)
+    end
+  end
+
+  test "published books from any tenant remain visible when signed out" do
+    globex = Tenant.create!(name: "Globex")
+    books(:manual).update!(tenant: globex, published: true)
+
+    Current.set(user: nil) do
+      assert_includes Book.accessable_or_published, books(:manual)
+    end
+  end
+
+  test "sharing with everyone does not grant access across tenants" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    kevin = users(:kevin)
+    jz = users(:jz)
+    kevin.update!(tenant: acme)
+    jz.update!(tenant: globex)
+    books(:handbook).update!(tenant: acme, everyone_access: true)
+    books(:handbook).update_access(editors: [ kevin.id ], readers: [])
+
+    assert books(:handbook).accessable?(user: kevin)
+    assert_not books(:handbook).accesses.exists?(user: jz)
+  end
+
+  test "new users only receive everyone access for books in their tenant" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    Book.create!(title: "Acme Book", everyone_access: true, tenant: acme)
+    other = Book.create!(title: "Globex Book", everyone_access: true, tenant: globex)
+
+    bob = User.create!(email_address: "bob@example.com", name: "Bob", password: "secret123456", tenant: acme)
+
+    assert_not other.accessable?(user: bob)
+  end
+end
