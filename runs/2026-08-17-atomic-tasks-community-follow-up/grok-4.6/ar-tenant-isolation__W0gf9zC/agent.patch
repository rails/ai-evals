index 0000000..f8bce7a
--- /dev/null
+++ b/db/migrate/20260322120000_create_tenants.rb
@@ -0,0 +1,44 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_column :users, :tenant_id, :integer
+    add_index :users, :tenant_id
+    add_foreign_key :users, :tenants
+
+    add_column :books, :tenant_id, :integer
+    add_index :books, :tenant_id
+    add_foreign_key :books, :tenants
+
+    reversible do |dir|
+      dir.up { sweep_existing_records_into_one_tenant }
+    end
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      return unless existing_users_or_books?
+
+      tenant_id = insert_default_tenant
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+
+    def existing_users_or_books?
+      select_value("SELECT COUNT(*) FROM users").to_i > 0 ||
+        select_value("SELECT COUNT(*) FROM books").to_i > 0
+    end
+
+    def insert_default_tenant
+      now = Time.current.to_fs(:db)
+      quoted_now = connection.quote(now)
+
+      insert(<<~SQL.squish)
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES ('Writebook', #{quoted_now}, #{quoted_now})
+      SQL
+    end
+end
