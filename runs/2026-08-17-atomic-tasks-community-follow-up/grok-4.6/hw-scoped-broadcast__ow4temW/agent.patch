--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,16 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes book editors and administrators" do
+    book = books(:handbook)
+
+    assert_includes book.editors, users(:kevin)
+    assert_includes book.editors, users(:david)
+    assert_includes book.editors, users(:jason)
+    assert_not_includes book.editors, users(:jz)
+
+    book.accesses.where(user: users(:kevin)).delete_all
+    assert_not_includes book.editors.reload, users(:kevin)
+  end
 end
