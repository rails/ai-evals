diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..b7df74a 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,36 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "upload derives the picture once and reading does not process again" do
+    perform_enqueued_jobs do
+      post book_pictures_path(books(:handbook)), params: {
+        leaf: { title: "Photo" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+
+    picture = Picture.order(:id).last
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    get leafable_slug_path(picture.leaf)
+    assert_response :success
+
+    image_src = css_select("figure img").first["src"]
+    assert image_src.present?
+
+    transforms = 0
+    ActiveSupport::Notifications.subscribed(->(*) { transforms += 1 }, "transform.active_storage") do
+      get image_src
+    end
+
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal "image/webp", response.media_type
+
+    assert_equal 0, transforms, "fetching the picture should not process the image again"
+    assert_equal 1, blob.variant_records.reload.count, "exactly one derived copy should exist"
+  end
 end
