@@ -26,4 +28,40 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges markdown uploads after background jobs" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+
+    assert blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+  end
+
+  test "destroying a page with multiple markdown uploads purges all of them" do
+    page = pages(:welcome)
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    page.body.uploads.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+    blobs = page.body.uploads.blobs.to_a
+
+    assert_equal 2, blobs.size
+    blobs.each { |blob| assert blob.service.exist?(blob.key) }
+
+    perform_enqueued_jobs only: ActiveStorage::PurgeJob do
+      page.destroy!
+    end
+
+    blobs.each do |blob|
+      assert_not ActiveStorage::Blob.exists?(blob.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
 end
