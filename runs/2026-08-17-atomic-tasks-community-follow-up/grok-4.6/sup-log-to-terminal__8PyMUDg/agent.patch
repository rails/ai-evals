--- a/config/application.rb
+++ b/config/application.rb
@@ -19,6 +19,18 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # rails runner only writes to the env log file by default. Mirror the
+    # server's STDOUT broadcast so runbook output is visible without dropping
+    # the record log tooling already reads.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT)
+        console = ActiveSupport::Logger.new(STDOUT)
+        console.formatter = Rails.logger.formatter
+        console.level = Rails.logger.level
+        Rails.logger.broadcast_to(console)
+      end
+    end
+
