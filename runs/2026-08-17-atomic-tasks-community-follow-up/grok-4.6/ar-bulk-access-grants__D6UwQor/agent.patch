diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..4691afe
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Import Target", everyone_access: false)
+    @kevin = users(:kevin)
+    @jz = users(:jz)
+    @jason = users(:jason)
+  end
+
+  test "imports a roster and notifies each person" do
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @jz.id, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal [ @kevin.id, @jz.id ], result.accesses.map(&:user_id)
+    assert_equal [ "reader", "editor" ], result.accesses.map(&:level)
+    assert_equal 2, @book.accesses.count
+  end
+
+  test "rejected roster does not notify about access that was never granted" do
+    @book.accesses.create!(user: @jason, level: :reader)
+
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @jason.id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_not @book.accesses.exists?(user: @kevin)
+  end
+
+  test "unknown level is turned down like any other bad row" do
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @jz.id, level: "wizard" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "duplicate inside the sheet itself is turned down" do
+    grants = [
+      { user_id: @kevin.id, level: "reader" },
+      { user_id: @kevin.id, level: "editor" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "writes do not grow with roster size" do
+    users = [ @kevin, @jz, @jason, users(:david) ]
+    small = users.first(2).map { |user| { user_id: user.id, level: "reader" } }
+    large = users.map { |user| { user_id: user.id, level: "reader" } }
+
+    small_book = Book.create!(title: "Small Roster", everyone_access: false)
+    large_book = Book.create!(title: "Large Roster", everyone_access: false)
+
+    small_writes = write_queries { Book::AccessImport.new(small_book, small).import }
+    large_writes = write_queries { Book::AccessImport.new(large_book, large).import }
+
+    assert_equal small_writes, large_writes
+    assert_operator small_writes, :<=, 2
+  end
+
+  test "accepts symbol levels" do
+    grants = [ { user_id: @kevin.id, level: :editor } ]
+    result = Book::AccessImport.new(@book, grants).import
+    assert_nil result.duplicate_index
+    assert_equal "editor", result.accesses.first.level
+  end
+
+  private
+    def write_queries(&block)
+      count = 0
+      counter = ->(*, payload) {
+        sql = payload[:sql]
+        count += 1 if sql.match?(/\A\s*(INSERT|UPDATE|DELETE)\b/i)
+      }
+
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      count
+    end
+end
