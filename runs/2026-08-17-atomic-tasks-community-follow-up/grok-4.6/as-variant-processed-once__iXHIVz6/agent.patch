diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..444b0df 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -38,4 +38,33 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "opening a picture after upload serves the pre-derived copy" do
+    perform_enqueued_jobs do
+      post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+        leaf: { title: "A photo" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+    assert_response :success
+
+    picture = Picture.order(:id).last
+    blob = picture.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    get leafable_slug_path(picture.leaf)
+    assert_response :success
+
+    img_src = css_select("figure img").first["src"]
+    assert_not_nil img_src
+
+    transform_count = 0
+    ActiveSupport::Notifications.subscribed(->(*) { transform_count += 1 }, "transform.active_storage") do
+      get img_src
+    end
+
+    assert_response :redirect
+    assert_equal 0, transform_count
+    assert_equal 1, blob.variant_records.reload.count
+  end
 end
