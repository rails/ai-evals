diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..6621fec 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,60 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase deletes the user and their private records" do
+    user = users(:kevin)
+    private_book = Book.create!(title: "Kevin Secrets", everyone_access: false, creator: user, author: "Kevin")
+    private_leaf = private_book.press Page.new(body: "supercalifragilistic"), title: "Secret Page"
+    private_leaf.reindex
+
+    ReadingMark.remember(leaves(:welcome_page), user: user)
+    SignInEvent.create!(action: :signed_in, email_address: user.email_address, ip_address: "1.2.3.4", user_agent: "Browser")
+
+    assert_includes Leaf.search("supercalifragilistic"), private_leaf
+
+    user_id = user.id
+    user.erase
+
+    assert_nil User.find_by(id: user_id)
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: private_leaf.id)
+    assert_empty Access.where(user_id: user_id)
+    assert_empty ReadingMark.where(user_id: user_id)
+    assert_empty Session.where(user_id: user_id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+    assert_empty Leaf.search("supercalifragilistic")
+  end
+
+  test "erase keeps everyone-shared books and bylines them Deleted author" do
+    user = users(:kevin)
+    shared_book = Book.create!(title: "Kevin Public", everyone_access: true, creator: user, author: "Kevin")
+    shared_leaf = shared_book.press Page.new(body: "shared wisdom for all"), title: "Public Page"
+    shared_leaf.reindex
+
+    user.erase
+
+    shared_book.reload
+    assert_equal "Deleted author", shared_book.author
+    assert_nil shared_book.creator_id
+    assert Leaf.exists?(shared_leaf.id)
+    assert_includes Leaf.search("shared wisdom"), shared_leaf
+  end
+
+  test "erase works for previously deactivated users and their original sign-in logs" do
+    user = users(:kevin)
+    original_email = user.email_address
+    SignInEvent.create!(action: :signed_in, email_address: original_email, ip_address: "9.9.9.9", user_agent: "Browser")
+
+    user.deactivate
+    assert_not user.reload.active?
+    assert_match(/-deactivated-/, user.email_address)
+
+    user_id = user.id
+    user.erase
+
+    assert_nil User.find_by(id: user_id)
+    assert_empty SignInEvent.for_address(original_email)
+    assert_empty SignInEvent.where("email_address LIKE ?", "%kevin%")
+  end
 end
