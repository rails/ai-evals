diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..2cbecb0 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,11 +24,37 @@ class User < ApplicationRecord
     end
   end
 
+  def erase
+    transaction do
+      preserve_everyone_books
+      sessions.delete_all
+      wipe_sign_in_events
+      destroy!
+    end
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def preserve_everyone_books
+      created_books.with_everyone_access.update_all(creator_id: nil, author: "Deleted author")
+      created_books.reset
+    end
+
+    def wipe_sign_in_events
+      SignInEvent.where(email_address: sign_in_emails).delete_all
+    end
+
+    def sign_in_emails
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address.to_s.sub(/-deactivated-[0-9a-f-]+@/i, "@")
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
