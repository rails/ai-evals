diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..baa731f 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -79,6 +79,46 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "update broadcasts being edited indicator to remaining editors only" do
+    leaf = leaves(:welcome_page)
+
+    books(:handbook).accesses.find_by!(user: users(:kevin)).destroy!
+    sign_in :david
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Updated words" } }
+    end
+
+    assert_response :no_content
+    assert_turbo_stream_broadcasts [ users(:david), leaf, :being_edited ]
+    assert_turbo_stream_broadcasts [ users(:jason), leaf, :being_edited ]
+    assert_no_turbo_stream_broadcasts [ users(:kevin), leaf, :being_edited ]
+    assert_no_turbo_stream_broadcasts [ users(:jz), leaf, :being_edited ]
+    assert_no_turbo_stream_broadcasts [ leaf, :being_edited ]
+  end
+
+  test "update does not broadcast being edited indicator to remaining readers" do
+    leaf = leaves(:welcome_page)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { page: { body: "Updated words" } }
+    end
+
+    assert_response :no_content
+    assert_turbo_stream_broadcasts [ users(:kevin), leaf, :being_edited ]
+    assert_no_turbo_stream_broadcasts [ users(:jz), leaf, :being_edited ]
+  end
+
+  test "edit subscribes to the current user's being edited stream" do
+    leaf = leaves(:welcome_page)
+
+    get edit_leafable_path(leaf)
+
+    assert_response :ok
+    assert_select %(turbo-cable-stream-source[signed-stream-name="#{Turbo::StreamsChannel.signed_stream_name([ users(:kevin), leaf, :being_edited ])}"])
+    assert_select %(turbo-cable-stream-source[signed-stream-name="#{Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited ])}"]), count: 0
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..16c2e3c 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,32 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "users_who_can_edit includes editors and administrators but not readers or removed collaborators" do
+    book = books(:handbook)
+
+    assert_includes book.users_who_can_edit, users(:kevin)
+    assert_includes book.users_who_can_edit, users(:david)
+    assert_includes book.users_who_can_edit, users(:jason)
+    assert_not_includes book.users_who_can_edit, users(:jz)
+
+    book.accesses.find_by!(user: users(:kevin)).destroy!
+
+    assert_not_includes book.users_who_can_edit.reload, users(:kevin)
+    assert_includes book.users_who_can_edit, users(:david)
+  end
+
+  test "users_who_can_edit includes administrators without book access and excludes demoted editors" do
+    book = Book.create!(title: "Secret", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    assert_includes book.users_who_can_edit, users(:kevin)
+    assert_includes book.users_who_can_edit, users(:david)
+    assert_not_includes book.users_who_can_edit, users(:jz)
+
+    book.update_access(editors: [], readers: [ users(:kevin).id ])
+
+    assert_not_includes book.users_who_can_edit.reload, users(:kevin)
+    assert_includes book.users_who_can_edit, users(:david)
+  end
 end
