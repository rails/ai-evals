diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..160aa90
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  setup do
+    TitleCleanupProgress.delete_all
+  end
+
+  test "strips wrapping quotes from leaf titles" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"Welcome to The Handbook!"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Welcome to The Handbook!", leaf.reload.title
+  end
+
+  test "leaves titles without wrapping quotes unchanged" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "Welcome to The Handbook!")
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Welcome to The Handbook!", leaf.reload.title
+  end
+
+  test "does not reclean titles when run a second time" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: %(""Hello," they said"))
+
+    TitleCleanupJob.perform_now
+    assert_equal %("Hello," they said), leaf.reload.title
+
+    TitleCleanupJob.perform_now
+    assert_equal %("Hello," they said), leaf.reload.title
+  end
+
+  test "resumes after the last processed leaf without recleaning earlier titles" do
+    TitleCleanupProgress.advance_to!(Leaf.maximum(:id))
+
+    earlier = books(:manual).press Page.new, title: %("Hello," they said)
+    later = books(:manual).press Page.new, title: '"Summary"'
+    TitleCleanupProgress.advance_to!(earlier.id)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %("Hello," they said), earlier.reload.title
+    assert_equal "Summary", later.reload.title
+  end
+
+  test "rolls back progress when a leaf update is interrupted so that leaf is redone once" do
+    TitleCleanupProgress.advance_to!(Leaf.maximum(:id))
+
+    first = books(:manual).press Page.new, title: '"First"'
+    second = books(:manual).press Page.new, title: '"Second"'
+    third = books(:manual).press Page.new, title: '"Third"'
+
+    interrupt_leaf_updates_for(second.id) do
+      assert_raises(RuntimeError) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal "First", first.reload.title
+    assert_equal '"Second"', second.reload.title
+    assert_equal '"Third"', third.reload.title
+    assert_equal first.id, TitleCleanupProgress.last_leaf_id
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "First", first.reload.title
+    assert_equal "Second", second.reload.title
+    assert_equal "Third", third.reload.title
+  end
+
+  test "redoes the first leaf when interrupted before any progress is recorded" do
+    TitleCleanupProgress.advance_to!(Leaf.maximum(:id))
+
+    only = books(:manual).press Page.new, title: '"Alone"'
+
+    interrupt_leaf_updates_for(only.id) do
+      assert_raises(RuntimeError) { TitleCleanupJob.perform_now }
+    end
+
+    assert_equal '"Alone"', only.reload.title
+    assert_equal Leaf.where("id < ?", only.id).maximum(:id) || 0, TitleCleanupProgress.last_leaf_id
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Alone", only.reload.title
+  end
+
+  private
+    def interrupt_leaf_updates_for(leaf_id)
+      Leaf.class_eval do
+        alias_method :update_without_interrupt!, :update!
+
+        define_method(:update!) do |*args, **kwargs|
+          raise "interrupted" if id == leaf_id
+          update_without_interrupt!(*args, **kwargs)
+        end
+      end
+
+      yield
+    ensure
+      Leaf.class_eval do
+        alias_method :update!, :update_without_interrupt!
+        remove_method :update_without_interrupt!
+      end
+    end
+end
