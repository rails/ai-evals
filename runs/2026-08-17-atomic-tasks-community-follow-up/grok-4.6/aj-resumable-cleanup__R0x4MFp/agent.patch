--- /dev/null
+++ b/app/models/title_cleanup_progress.rb
@@ -0,0 +1,13 @@
+class TitleCleanupProgress < ApplicationRecord
+  def self.last_leaf_id
+    instance.last_leaf_id
+  end
+
+  def self.advance_to!(leaf_id)
+    instance.update!(last_leaf_id: leaf_id)
+  end
+
+  def self.instance
+    first || create!(last_leaf_id: 0)
+  end
+end
