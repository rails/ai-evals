 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    unclean_leaves.find_each(order: :asc) do |leaf|
+      clean(leaf)
     end
   end
 
   private
+    def unclean_leaves
+      Leaf.where("id > ?", TitleCleanupProgress.last_leaf_id)
+    end
+
+    def clean(leaf)
+      Leaf.transaction do
+        leaf.update!(title: cleaned(leaf.title))
+        TitleCleanupProgress.advance_to!(leaf.id)
+      end
+    end
+
     def cleaned(title)
       title.delete_prefix('"').delete_suffix('"')
     end
