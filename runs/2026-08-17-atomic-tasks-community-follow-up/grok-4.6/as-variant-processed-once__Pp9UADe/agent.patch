diff --git a/lib/rails_ext/active_storage_variation.rb b/lib/rails_ext/active_storage_variation.rb
new file mode 100644
index 0000000..32e8663
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation.rb
@@ -0,0 +1,11 @@
+# Signed variation keys JSON-encode transformation values, so :webp comes back
+# as "webp". Digests are Marshal-based and treat those as different, which
+# stored a second derived copy the first time a reader fetched the picture.
+ActiveSupport.on_load(:active_storage_blob) do
+  ActiveStorage::Variation.prepend(Module.new do
+    def initialize(transformations)
+      super
+      @transformations[:format] = @transformations[:format].to_sym if @transformations.key?(:format)
+    end
+  end)
+end
