@@ -38,4 +40,43 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "upload derives the picture once and reading it does no further processing" do
+    perform_enqueued_jobs do
+      post book_pictures_path(books(:handbook), format: :turbo_stream), params: {
+        leaf: { title: "Rabbit" },
+        picture: { image: fixture_file_upload("white-rabbit.webp", "image/webp") }
+      }
+    end
+    assert_response :success
+
+    picture = Picture.order(:id).last
+    blob = picture.image.blob
+    derived_checksum = blob.variant_records.sole.image.blob.checksum
+
+    assert_equal 1, blob.variant_records.size
+
+    get leafable_slug_path(picture.leaf)
+    assert_response :success
+
+    img_src = css_select("figure img").first["src"]
+    assert_predicate img_src, :present?
+
+    transforms = 0
+    callback = ->(*) { transforms += 1 }
+
+    ActiveSupport::Notifications.subscribed(callback, "transform.active_storage") do
+      assert_no_difference -> { ActiveStorage::Blob.count } do
+        get img_src
+        follow_redirect! if response.redirect?
+      end
+    end
+
+    assert_response :success
+    assert_equal "image/webp", response.media_type
+    assert_equal 0, transforms
+    assert_equal 1, blob.variant_records.reload.size
+    assert_equal derived_checksum, blob.variant_records.sole.image.blob.checksum
+    assert_equal Digest::MD5.base64digest(response.body), derived_checksum
+  end
 end
