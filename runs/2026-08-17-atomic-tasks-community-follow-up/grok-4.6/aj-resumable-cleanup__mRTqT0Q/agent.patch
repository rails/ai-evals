@@ -0,0 +1,91 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  setup do
+    TitleCleanupProgress.delete_all
+
+    wrap_existing_titles
+  end
+
+  test "strips wrapping quotes from every title" do
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+  end
+
+  test "running a second time does not strip legitimate inner quotes" do
+    TitleCleanupJob.perform_now
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+  end
+
+  test "resuming after an interruption redoes at most the interrupted leaf" do
+    ordered = Leaf.order(:id).to_a
+    interrupt_leaf = ordered.third
+
+    job = TitleCleanupJob.new
+    job.define_singleton_method(:cleaned) do |title|
+      raise "interrupted" if title == interrupt_leaf.title
+      title.delete_prefix('"').delete_suffix('"')
+    end
+
+    assert_raises(RuntimeError) { job.perform_now }
+
+    assert_equal unwrap(original_title(ordered.first)), ordered.first.reload.title
+    assert_equal unwrap(original_title(ordered.second)), ordered.second.reload.title
+    assert_equal original_title(interrupt_leaf), interrupt_leaf.reload.title
+    assert_equal original_title(ordered.fourth), ordered.fourth.reload.title
+    assert_equal ordered.second.id, TitleCleanupProgress.current.last_leaf_id
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+    assert_equal ordered.last.id, TitleCleanupProgress.current.last_leaf_id
+  end
+
+  test "does not wrap-strip titles that were never quoted" do
+    leaves(:welcome_section).update_column(:title, "Already clean")
+    TitleCleanupProgress.current.update!(last_leaf_id: 0)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Already clean", leaves(:welcome_section).reload.title
+  end
+
+  test "leaves a title unchanged when it only has a leading quote" do
+    leaves(:welcome_page).update_column(:title, %("Leading only))
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %(Leading only), leaves(:welcome_page).reload.title
+  end
+
+  private
+    def wrap_existing_titles
+      leaves(:welcome_section).update_column(:title, %("The Welcome Section"))
+      leaves(:welcome_page).update_column(:title, %("Welcome to The Handbook!"))
+      leaves(:summary_page).update_column(:title, %(""Quoted phrase" remains"))
+      leaves(:reading_picture).update_column(:title, %("Reading"))
+    end
+
+    def assert_cleaned_titles
+      assert_equal "The Welcome Section", leaves(:welcome_section).reload.title
+      assert_equal "Welcome to The Handbook!", leaves(:welcome_page).reload.title
+      assert_equal %("Quoted phrase" remains), leaves(:summary_page).reload.title
+      assert_equal "Reading", leaves(:reading_picture).reload.title
+    end
+
+    def unwrap(title)
+      title.delete_prefix('"').delete_suffix('"')
+    end
+
+    def original_title(leaf)
+      {
+        leaves(:welcome_section).id => %("The Welcome Section"),
+        leaves(:welcome_page).id => %("Welcome to The Handbook!"),
+        leaves(:summary_page).id => %(""Quoted phrase" remains"),
+        leaves(:reading_picture).id => %("Reading")
+      }.fetch(leaf.id)
+    end
+end
