diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..e5558a2
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:manual)
+  end
+
+  test "imports every valid entry once, in order" do
+    result = @book.import_manifest([
+      { title: "First", body: "one" },
+      { title: "Second", body: "two" }
+    ])
+
+    assert result
+    assert_equal [ "First", "Second" ], @book.leaves.order(:position_score).pluck(:title)
+    assert_equal [ "one", "two" ], @book.leaves.order(:position_score).map { it.leafable.body }
+  end
+
+  test "rejects a manifest with a bad entry and imports nothing" do
+    result = @book.import_manifest([
+      { title: "First", body: "one" },
+      { title: "", body: "missing" },
+      { title: "Third", body: "three" }
+    ])
+
+    assert_not result
+    assert_empty @book.leaves
+  end
+
+  test "rejects a duplicate title as a failed import, not a crash" do
+    @book.press Section.new(body: "already here"), title: "Taken"
+
+    result = @book.import_manifest([
+      { title: "Fresh", body: "new" },
+      { title: "Taken", body: "dup" }
+    ])
+
+    assert_not result
+    assert_equal [ "Taken" ], @book.leaves.pluck(:title)
+  end
+
+  test "a rejected manifest inside a larger transaction does not undo other work" do
+    keeper = books(:handbook)
+    before_handbook = keeper.leaves.pluck(:id).sort
+
+    result = BulkImport.new(
+      keeper => [ { title: "Nightly note", body: "kept" } ],
+      @book => [ { title: "Temp", body: "temp" }, { title: "", body: "bad" } ]
+    ).run
+
+    assert_includes result.imported, keeper
+    assert_includes result.rejected, @book
+    assert_empty @book.leaves
+    assert_includes keeper.leaves.reload.pluck(:title), "Nightly note"
+    assert_equal before_handbook, (keeper.leaves.pluck(:id) - [ keeper.leaves.find_by!(title: "Nightly note").id ]).sort
+  end
+end
