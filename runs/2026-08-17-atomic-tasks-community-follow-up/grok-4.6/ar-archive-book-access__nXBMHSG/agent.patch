diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..62b861b 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,25 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives current accesses for the book" do
+    sign_in :david
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map { |access| [ access.user_id, access.user.name, access.level ] }
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      delete book_url(book)
+    end
+
+    assert_redirected_to root_url
+    assert_nil Book.find_by(id: book.id)
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected.size, archives.count
+    expected.each do |user_id, user_name, level|
+      archive = archives.find_by(user_id: user_id)
+      assert_equal user_name, archive.user_name
+      assert_equal level, archive.level
+    end
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..0457f2a 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,45 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives each current access" do
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map { |access| [ access.user_id, access.user.name, access.level ] }
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected.size, archives.count
+
+    expected.each do |user_id, user_name, level|
+      archive = archives.find_by(user_id: user_id)
+      assert_equal user_name, archive.user_name
+      assert_equal level, archive.level
+      assert_equal "Handbook", archive.book_title
+    end
+  end
+
+  test "destroying a book does not archive previously revoked access" do
+    book = Book.create!(title: "Shared then revoked", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+    book.update_access(editors: [ users(:kevin).id ], readers: [])
+
+    book.destroy
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal 1, archives.count
+    assert_equal users(:kevin).id, archives.first.user_id
+    assert_equal "editor", archives.first.level
+    assert_nil archives.find_by(user_id: users(:jz).id)
+  end
+
+  test "destroying a book nobody could access writes no archive rows" do
+    book = Book.create!(title: "Private empty book", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+  end
 end
