+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @original_titles = {
+      leaves(:welcome_section) => %(""Once upon a time," it began),
+      leaves(:welcome_page) => '"Welcome"',
+      leaves(:summary_page) => '"Summary"',
+      leaves(:reading_picture) => '"Reading"'
+    }
+
+    @original_titles.each { |leaf, title| leaf.update!(title: title) }
+  end
+
+  test "strips wrapping quotes while leaving inner quotes intact" do
+    TitleCleanupJob.perform_now
+
+    assert_equal %("Once upon a time," it began), leaves(:welcome_section).reload.title
+    assert_equal "Welcome", leaves(:welcome_page).reload.title
+    assert_equal "Summary", leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "resumes after an interruption without recleaning finished leaves" do
+    first, second, *remaining = Leaf.order(:id).to_a
+
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: second.id.succ) do
+      TitleCleanupJob.perform_now
+    end
+
+    assert_equal cleaned_once(@original_titles[first]), first.reload.title
+    assert_equal cleaned_once(@original_titles[second]), second.reload.title
+    remaining.each do |leaf|
+      assert_equal @original_titles[leaf], leaf.reload.title
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal %("Once upon a time," it began), leaves(:welcome_section).reload.title
+    assert_equal "Welcome", leaves(:welcome_page).reload.title
+    assert_equal "Summary", leaves(:summary_page).reload.title
+    assert_equal "Reading", leaves(:reading_picture).reload.title
+  end
+
+  test "does not mangle a title that legitimately opens with a quote when resumed" do
+    first = Leaf.order(:id).first
+
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: first.id.succ) do
+      TitleCleanupJob.perform_now
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal cleaned_once(@original_titles[first]), first.reload.title
+    assert_match(/\A"/, first.title)
+  end
+
+  private
+    def cleaned_once(title)
+      title.delete_prefix('"').delete_suffix('"')
+    end
+end
