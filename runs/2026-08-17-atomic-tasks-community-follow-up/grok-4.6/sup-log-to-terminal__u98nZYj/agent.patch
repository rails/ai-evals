@@ -19,6 +19,17 @@ module Writebook
     # Raised on noisy runs from the runbook; "debug" is what Rails would pick anyway.
     config.log_level = ENV.fetch("LOG_LEVEL", "debug")
 
+    # rails runner writes only to the env log file by default. The import runbook
+    # needs those same lines on the terminal without dropping the file record.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDERR, STDOUT)
+        console = ActiveSupport::Logger.new(STDOUT)
+        console.formatter = Rails.logger.formatter
+        console.level = Rails.logger.level
+        Rails.logger.broadcast_to(console)
+      end
+    end
+
