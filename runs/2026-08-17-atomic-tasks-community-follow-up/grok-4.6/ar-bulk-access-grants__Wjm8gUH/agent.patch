diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..03f2478
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Import Target", everyone_access: false)
+    @users = [users(:david), users(:jason), users(:jz), users(:kevin)]
+  end
+
+  test "imports a roster and notifies each person" do
+    grants = @users.map { |user| { user_id: user.id, level: "reader" } }
+
+    result = nil
+    assert_enqueued_jobs 4, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 4, result.accesses.size
+    assert_equal @users.map(&:id), result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:reader?)
+    assert_equal 4, @book.accesses.count
+  end
+
+  test "write cost does not grow with roster size" do
+    extra = create_users("Importer", 12)
+    small = grants_for(@users)
+    large = grants_for(@users + extra)
+
+    small_writes = write_query_count { Book::AccessImport.new(Book.create!(title: "Small"), small).import }
+    large_writes = write_query_count { Book::AccessImport.new(Book.create!(title: "Large"), large).import }
+
+    assert_equal small_writes, large_writes
+    assert small_writes > 0
+  end
+
+  test "a rejected roster does not write more as it grows and notifies nobody" do
+    extra = create_users("Dup", 12)
+
+    small = grants_for(@users) + [{ user_id: @users.first.id, level: "editor" }]
+    large = grants_for(@users + extra) + [{ user_id: @users.first.id, level: "editor" }]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      small_writes = write_query_count { @small_result = Book::AccessImport.new(Book.create!(title: "Small Dup"), small).import }
+      large_writes = write_query_count { @large_result = Book::AccessImport.new(Book.create!(title: "Large Dup"), large).import }
+
+      assert_equal small_writes, large_writes
+    end
+
+    assert_equal [], @small_result.accesses
+    assert_equal [], @large_result.accesses
+    assert_not_nil @small_result.duplicate_index
+    assert_not_nil @large_result.duplicate_index
+  end
+
+  test "does not notify when a roster is rejected for an existing grant" do
+    @book.accesses.create!(user: users(:david), level: :reader)
+    grants = [
+      { user_id: users(:jason).id, level: "editor" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+    assert @book.accesses.exists?(user: users(:david), level: "reader")
+    assert_not @book.accesses.exists?(user: users(:jason))
+  end
+
+  test "unknown level is turned down instead of raising" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:jason).id, level: "owner" },
+      { user_id: users(:jz).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_nothing_raised do
+      assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "duplicate within the sheet is turned down" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:jason).id, level: "editor" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  private
+    def grants_for(users)
+      users.map { |user| { user_id: user.id, level: "reader" } }
+    end
+
+    def create_users(prefix, count)
+      count.times.map do |i|
+        User.create!(
+          name: "#{prefix} #{i}",
+          email_address: "#{prefix.downcase}-#{i}@example.com",
+          role: :member,
+          password: "secret123456"
+        )
+      end
+    end
+
+    def write_query_count(&block)
+      count = 0
+      counter = lambda do |*args|
+        sql = args.last[:sql].to_s
+        count += 1 if sql.match?(/\A\s*(INSERT|UPDATE|DELETE)\b/i)
+      end
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      count
+    end
+end
