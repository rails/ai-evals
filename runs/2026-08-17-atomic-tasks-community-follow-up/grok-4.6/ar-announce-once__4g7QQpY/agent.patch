diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..9e18870 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,23 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :track_publication_for_announcement
+    after_update_commit :announce_publication_if_needed
+    after_rollback :clear_publication_announcement_tracking
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def track_publication_for_announcement
+      @published_at_sitting_start = published_before_last_save unless defined?(@published_at_sitting_start)
+    end
+
+    def announce_publication_if_needed
+      went_live = published? && @published_at_sitting_start == false
+      clear_publication_announcement_tracking
+      AnnouncePublicationJob.perform_later self if went_live
+    end
+
+    def clear_publication_announcement_tracking
+      remove_instance_variable(:@published_at_sitting_start) if defined?(@published_at_sitting_start)
     end
 end
