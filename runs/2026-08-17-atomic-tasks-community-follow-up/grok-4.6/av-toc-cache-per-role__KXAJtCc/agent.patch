diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..81ee75e 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,71 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show does not leak editor controls through the collection cache" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page))
+
+      sign_out
+      sign_in :jz
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+    end
+  end
+
+  test "show still renders editor controls after a reader warms the collection cache" do
+    with_fragment_caching do
+      sign_out
+      sign_in :jz
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+
+      sign_out
+      sign_in :kevin
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page))
+    end
+  end
+
+  test "show reflects a renamed entry for the next viewer" do
+    with_fragment_caching do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Welcome to The Handbook!"
+
+      leaves(:welcome_page).update!(title: "A warmer welcome")
+
+      sign_out
+      sign_in :jz
+
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "A warmer welcome"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+
+  private
+    def with_fragment_caching
+      caching, store = ActionController::Base.perform_caching, Rails.cache
+      collection_store = ActionView::PartialRenderer.collection_cache
+
+      ActionController::Base.perform_caching = true
+      Rails.cache = ActiveSupport::Cache::MemoryStore.new
+      ActionView::PartialRenderer.collection_cache = Rails.cache
+
+      yield
+    ensure
+      ActionController::Base.perform_caching = caching
+      Rails.cache = store
+      ActionView::PartialRenderer.collection_cache = collection_store
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..57cf9d4 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,15 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "update_access refreshes memoized editability on the same book instance" do
+    book = books(:handbook)
+
+    assert book.editable?(user: users(:kevin))
+
+    book.update_access(editors: [], readers: [ users(:kevin).id ])
+
+    assert book.accessable?(user: users(:kevin))
+    assert_not book.editable?(user: users(:kevin))
+  end
 end
