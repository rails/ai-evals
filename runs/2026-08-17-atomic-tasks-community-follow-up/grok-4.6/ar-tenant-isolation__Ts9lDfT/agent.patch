--- /dev/null
+++ b/db/migrate/20260814152913_create_tenants.rb
@@ -0,0 +1,33 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up { assign_existing_records_to_a_tenant }
+    end
+  end
+
+  private
+    def assign_existing_records_to_a_tenant
+      return unless table_has_rows?("users") || table_has_rows?("books")
+
+      now = Time.current.to_fs(:db)
+      tenant_id = connection.insert(<<~SQL)
+        INSERT INTO tenants (name, created_at, updated_at)
+        VALUES ('Writebook', #{connection.quote(now)}, #{connection.quote(now)})
+      SQL
+
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+
+    def table_has_rows?(table)
+      connection.select_value("SELECT 1 FROM #{table} LIMIT 1").present?
+    end
+end
