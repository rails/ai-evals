+    get leafable_slug_path(leaves(:welcome_page))
+
+    assert_response :success
+    assert_select "p", "This is such a great handbook."
+  end
 end
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4e3adea
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds matching titles the searcher may read" do
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not return pages from books the searcher cannot read" do
+    books(:manual).press(Page.new(body: "Hidden"), title: "Welcome to The Manual")
+
+    get library_search_path, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome to The Manual"
+  end
+
+  test "show treats an apostrophe as data rather than causing an error" do
+    books(:handbook).press(Page.new(body: "It's fine"), title: "Writer's notes")
+
+    get library_search_path, params: { q: "Writer's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Writer.s notes/
+  end
+
+  test "show does not treat percent or underscore as wildcards" do
+    books(:handbook).press(Page.new(body: "Sale"), title: "Save 50% off")
+    books(:handbook).press(Page.new(body: "Sale"), title: "Save 50 dollars off")
+    books(:handbook).press(Page.new(body: "Sale"), title: "Save_50_off")
+
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 50 dollars off"
+
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Save 50 dollars off"
+
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_in_body "Save_50_off"
+    assert_not_in_body "Save 50 dollars off"
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..a5d18be 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,43 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "update allows changing own name, email address and password" do
+    sign_in :kevin
+
+    put user_profile_path(users(:kevin)), params: {
+      user: { name: "Kevin K", email_address: "kevin.k@example.com", password: "newsecret123456" }
+    }
+
+    assert_redirected_to users_url
+    kevin = users(:kevin).reload
+    assert_equal "Kevin K", kevin.name
+    assert_equal "kevin.k@example.com", kevin.email_address
+    assert kevin.authenticate("newsecret123456")
+    assert_equal "member", kevin.role
+  end
+
+  test "update ignores a role a member did not have" do
+    sign_in :kevin
+    assert users(:kevin).member?
+
+    put user_profile_path(users(:kevin)), params: {
+      user: { name: "Kevin", role: "administrator" }
+    }
+
+    assert_redirected_to users_url
+    assert users(:kevin).reload.member?
+    assert_not users(:kevin).administrator?
+  end
+
+  test "update does not allow a member to change somebody else's role" do
+    sign_in :kevin
+
+    put user_profile_path(users(:jz)), params: {
+      user: { role: "administrator" }
+    }
+
+    assert_response :forbidden
+    assert users(:jz).reload.member?
+  end
 end
