@@ -117,4 +117,32 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "show does not render a page from a book the account cannot open under another book's id" do
+    inaccessible = books(:manual).press(Page.new(body: "Hidden body"), title: "Secret")
+
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{inaccessible.id}/#{inaccessible.slug}"
