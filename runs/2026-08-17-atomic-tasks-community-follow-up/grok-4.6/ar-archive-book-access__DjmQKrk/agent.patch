+    assert_not Book.exists?(book.id)
+
+    archived = AccessArchive.where(book_id: book.id).map { |a| [a.user_id, a.user_name, a.level] }.sort
+    assert_equal expected, archived
+  end
+
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..3483d47 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,41 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives current accesses" do
+    book = books(:handbook)
+    assert book.accesses.any?
+
+    expected = book.accesses.includes(:user).map { |a| [a.user_id, a.user.name, a.level] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      book.destroy!
+    end
+
+    archived = AccessArchive.where(book_id: book.id).map { |a| [a.user_id, a.user_name, a.level] }.sort
+    assert_equal expected, archived
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "destroy of book with no accesses writes no archives" do
+    book = Book.create!(title: "Lonely book", everyone_access: false)
+    assert_empty book.accesses
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+  end
+
+  test "destroy does not archive previously revoked access" do
+    book = books(:handbook)
+    revoked = accesses(:jz_handbook)
+    revoked_user_id = revoked.user_id
+    revoked.destroy!
+
+    assert_difference -> { AccessArchive.count }, book.accesses.count do
+      book.destroy!
+    end
+
+    assert_not AccessArchive.where(book_id: book.id, user_id: revoked_user_id).exists?
+  end
 end
