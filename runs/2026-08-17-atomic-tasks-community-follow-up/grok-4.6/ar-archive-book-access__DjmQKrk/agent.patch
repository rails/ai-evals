+
+  test "destroy archives accesses for people who currently have access" do
+    book = books(:handbook)
+    expected = book.accesses.includes(:user).map { |a| [a.user_id, a.user.name, a.level] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      delete book_url(book)
+    end
+
