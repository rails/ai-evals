diff --git a/test/models/user/erasure_test.rb b/test/models/user/erasure_test.rb
new file mode 100644
index 0000000..a2abfec
--- /dev/null
+++ b/test/models/user/erasure_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class User::ErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.update!(name: "Kevin Author")
+  end
+
+  test "erase deletes the user entirely" do
+    @user.erase
+
+    assert_nil User.find_by(id: @user.id)
+    assert_not User.exists?(email_address: "kevin@example.com")
+    assert_not User.exists?(name: "Kevin Author")
+  end
+
+  test "erase keeps everyone-access books and bylines them as Deleted author" do
+    book = Book.create!(title: "Shared Stories", author: "Kevin Author", everyone_access: true, creator: @user)
+    book.press Page.new(body: "A tale for everyone"), title: "Chapter 1"
+
+    @user.erase
+
+    book.reload
+    assert_equal "Shared Stories", book.title
+    assert_equal "Deleted author", book.author
+    assert_nil book.creator_id
+    assert_equal "A tale for everyone", book.leaves.first.page.body.content.to_s
+  end
+
+  test "erase destroys private books and their search hits" do
+    book = Book.create!(title: "Secret Diary", author: "Kevin Author", everyone_access: false, creator: @user)
+    leaf = book.press Page.new(body: "uniquelyprivatecontent"), title: "Hidden thoughts"
+    leaf.reindex
+
+    assert_includes Leaf.search("uniquelyprivatecontent"), leaf
+
+    @user.erase
+
+    assert_nil Book.find_by(id: book.id)
+    assert_empty Leaf.search("uniquelyprivatecontent")
+  end
+
+  test "erase removes reading marks, accesses, and sessions" do
+    session = @user.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+
+    assert @user.accesses.any?
+    assert ReadingMark.exists?(user: @user)
+
+    user_id = @user.id
+    @user.erase
+
+    assert_empty Session.where(user_id: user_id)
+    assert_empty Access.where(user_id: user_id)
+    assert_empty ReadingMark.where(user_id: user_id)
+    assert_nil Session.find_by(id: session.id)
+  end
+
+  test "erase removes sign-in events for the address they signed in with" do
+    SignInEvent.create!(email_address: "kevin@example.com", action: :signed_in, ip_address: "1.1.1.1", user_agent: "Browser")
+    SignInEvent.create!(email_address: "david@example.com", action: :signed_in, ip_address: "1.1.1.1", user_agent: "Browser")
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+    assert SignInEvent.for_address("david@example.com").exists?
+  end
+
+  test "erase works for previously deactivated users and their original sign-in address" do
+    original_email = @user.email_address
+    SignInEvent.create!(email_address: original_email, action: :signed_in, ip_address: "1.1.1.1", user_agent: "Browser")
+
+    @user.deactivate
+    deactivated_email = @user.reload.email_address
+    assert_match(/kevin-deactivated-.+@example.com/, deactivated_email)
+
+    SignInEvent.create!(email_address: deactivated_email, action: :signed_out, ip_address: "1.1.1.1", user_agent: "Browser")
+
+    @user.erase
+
+    assert_nil User.find_by(id: @user.id)
+    assert_empty SignInEvent.for_address(original_email)
+    assert_empty SignInEvent.for_address(deactivated_email)
+  end
+end
