new file mode 100644
index 0000000..8e728f4
--- /dev/null
+++ b/app/models/user/erasure.rb
@@ -0,0 +1,46 @@
+module User::Erasure
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+  DEACTIVATED_EMAIL_PATTERN = /\A(?<local>.+)-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@(?<domain>.+)\z/i
+
+  def erase
+    transaction do
+      retain_everyone_books
+      destroy_private_created_books
+      reading_marks.delete_all
+      sessions.delete_all
+      accesses.delete_all
+      erase_sign_in_events
+      destroy!
+    end
+  end
+
+  private
+    def retain_everyone_books
+      created_books.with_everyone_access.update_all(
+        creator_id: nil,
+        author: DELETED_AUTHOR_BYLINE
+      )
+    end
+
+    def destroy_private_created_books
+      created_books.where(everyone_access: false).find_each do |book|
+        book.leaves.find_each { |leaf| leaf.send(:remove_from_search_index) }
+        book.destroy!
+      end
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: identifiable_email_addresses).delete_all
+    end
+
+    def identifiable_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      match = email_address.to_s.match(DEACTIVATED_EMAIL_PATTERN)
+      "#{match[:local]}@#{match[:domain]}" if match
+    end
+end
