diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..adfa4e7 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -1,6 +1,10 @@
 require "test_helper"
 
+require "turbo/broadcastable/test_helper"
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include Turbo::Broadcastable::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,6 +83,54 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "edit page subscribes to the current user's being edited stream" do
+    get edit_leafable_path(leaves(:welcome_page))
+
+    assert_response :ok
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]",
+      Turbo::StreamsChannel.signed_stream_name([ leaves(:welcome_page), users(:kevin), :being_edited ])
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]",
+      Turbo::StreamsChannel.signed_stream_name([ leaves(:welcome_page), :being_edited ]), count: 0
+  end
+
+  test "update broadcasts being edited indicator to current editors" do
+    leaf = leaves(:welcome_page)
+
+    assert_turbo_stream_broadcasts [ leaf, users(:jason), :being_edited ] do
+      perform_enqueued_jobs do
+        put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Updated" } }
+      end
+    end
+
+    assert_response :no_content
+  end
+
+  test "update does not broadcast being edited indicator on a shared leaf channel" do
+    leaf = leaves(:welcome_page)
+
+    assert_no_turbo_stream_broadcasts [ leaf, :being_edited ] do
+      perform_enqueued_jobs do
+        put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Updated" } }
+      end
+    end
+  end
+
+  test "update does not broadcast being edited indicator to a removed collaborator" do
+    leaf = leaves(:welcome_page)
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+
+    sign_in :jason
+
+    assert_no_turbo_stream_broadcasts [ leaf, users(:kevin), :being_edited ] do
+      perform_enqueued_jobs do
+        put leafable_path(leaf), params: { leaf: { title: "Better welcome" }, page: { body: "Updated" } }
+      end
+    end
+
+    assert_no_turbo_stream_broadcasts [ leaf, :being_edited ]
+    assert_turbo_stream_broadcasts [ leaf, users(:jason), :being_edited ]
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..f6781cc 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,18 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes granted editors and administrators but not removed collaborators" do
+    book = books(:handbook)
+
+    assert_includes book.editors, users(:kevin)
+    assert_includes book.editors, users(:jason)
+    assert_includes book.editors, users(:david)
+    assert_not_includes book.editors, users(:jz)
+
+    book.accesses.where(user: users(:kevin)).delete_all
+
+    assert_not_includes book.editors, users(:kevin)
+    assert_includes book.editors, users(:jason)
+  end
 end
