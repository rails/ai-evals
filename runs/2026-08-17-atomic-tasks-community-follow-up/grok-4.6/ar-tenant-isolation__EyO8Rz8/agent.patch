new file mode 100644
index 0000000..59a526a
--- /dev/null
+++ b/db/migrate/20260323120000_create_tenants.rb
@@ -0,0 +1,40 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up { assign_existing_records_to_default_tenant }
+    end
+  end
+
+  private
+    def assign_existing_records_to_default_tenant
+      return unless rows_exist?("users") || rows_exist?("books")
+
+      tenant_id = insert_default_tenant
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+
+    def insert_default_tenant
+      now = Time.current.to_fs(:db)
+      name = select_value("SELECT name FROM accounts LIMIT 1").presence || "Writebook"
+
+      execute ActiveRecord::Base.sanitize_sql_array([
+        "INSERT INTO tenants (name, created_at, updated_at) VALUES (?, ?, ?)",
+        name, now, now
+      ])
+
+      select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+    end
+
+    def rows_exist?(table)
+      select_value("SELECT COUNT(*) FROM #{table}").to_i > 0
+    end
+end
