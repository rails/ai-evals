+
+    def duplicate_index
+      taken = existing_user_ids
+      seen = []
+
+      @grants.index do |grant|
+        user_id = grant[:user_id]
+        taken.include?(user_id) || seen.include?(user_id) ? true : seen << user_id && nil
+      end
+    end
+
+    def existing_user_ids
+      @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+    end
+
+    def persisted_accesses
+      accesses = @book.accesses.where(user_id: user_ids).index_by(&:user_id)
+      user_ids.filter_map { |user_id| accesses[user_id] }
+    end
+
+    def access_rows
+      timestamp = Time.current
+
+      @grants.collect do |grant|
+        { user_id: grant[:user_id], level: Access.levels[grant[:level].to_s], created_at: timestamp, updated_at: timestamp }
+      end
+    end
+
+    def user_ids
+      @user_ids ||= @grants.collect { |grant| grant[:user_id] }
+    end
