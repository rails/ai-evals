diff --git a/test/integration/tenant_edge_test.rb b/test/integration/tenant_edge_test.rb
new file mode 100644
index 0000000..8e1b1ce
--- /dev/null
+++ b/test/integration/tenant_edge_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class TenantEdgeTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @beta = Tenant.create!(name: "Beta")
+    users(:kevin).update!(tenant: @acme)
+    books(:handbook).update!(tenant: @beta)
+  end
+
+  test "cross tenant administrator cannot edit or publish another tenant's book" do
+    users(:kevin).update!(role: :administrator)
+    sign_in :kevin
+
+    get edit_book_url(books(:handbook))
+    assert_response :not_found
+
+    patch book_publication_url(books(:handbook)), params: { book: { published: true } }
+    assert_response :not_found
+  end
+
+  test "cross tenant cannot search, move leaves, or bookmark" do
+    sign_in :kevin
+    post book_search_url(books(:handbook)), params: { search: "handbook" }
+    assert_response :not_found
+
+    post book_leaves_moves_url(books(:handbook)), params: { id: [ leaves(:welcome_page).id ], position: 1 }
+    assert_response :not_found
+
+    get book_bookmark_url(books(:handbook))
+    assert_response :not_found
+  end
+
+  test "cross tenant cannot create or update leaves" do
+    sign_in :kevin
+    post book_pages_url(books(:handbook)), params: { page: { body: "nope" } }
+    assert_response :not_found
+
+    patch book_page_url(books(:handbook), leaves(:welcome_page)), params: { page: { body: "nope" } }
+    assert_response :not_found
+
+    delete book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :not_found
+  end
+
+  test "cross tenant cannot update book" do
+    sign_in :kevin
+    patch book_url(books(:handbook)), params: { book: { title: "Stolen" } }
+    assert_response :not_found
+    assert_not_equal "Stolen", books(:handbook).reload.title
+  end
+
+  test "administrators remain administrators inside their tenant" do
+    users(:david).update!(tenant: @beta)
+    sign_in :david
+    get edit_book_url(books(:handbook))
+    assert_response :success
+  end
+
+  test "fixture users and books with no tenant behave as before" do
+    books(:manual).update!(published: false)
+    sign_in :kevin
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+end
diff --git a/test/integration/tenants_test.rb b/test/integration/tenants_test.rb
new file mode 100644
index 0000000..c046b35
--- /dev/null
+++ b/test/integration/tenants_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class TenantsTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @beta = Tenant.create!(name: "Beta")
+    users(:kevin).update!(tenant: @acme)
+    users(:jason).update!(tenant: @acme)
+    users(:david).update!(tenant: @beta)
+    books(:handbook).update!(tenant: @beta)
+    books(:manual).update!(tenant: @acme)
+  end
+
+  test "another tenant's book is not listed" do
+    sign_in :kevin
+    get root_url
+    assert_select "h2", text: "Handbook", count: 0
+    assert_select "h2", text: "Acme book", count: 0
+
+    Book.create!(title: "Acme book", tenant: @acme).update_access(editors: [ users(:kevin).id ], readers: [])
+    get root_url
+    assert_select "h2", text: "Acme book"
+  end
+
+  test "another tenant's unpublished book 404s" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :not_found
+  end
+
+  test "another tenant's published book 404s for signed-in user of other tenant" do
+    books(:handbook).update!(published: true)
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :not_found
+  end
+
+  test "published book of another tenant is visible when signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+    get book_slug_url(books(:handbook))
+    assert_response :success
+  end
+
+  test "another tenant's leaf 404s" do
+    sign_in :kevin
+    get leafable_slug_url(leaves(:welcome_page))
+    assert_response :not_found
+  end
+
+  test "another tenant's edit history 404s even with an access row" do
+    leaves(:welcome_page).edit leafable_params: { body: "Secret" }
+    sign_in :kevin
+
+    get page_edit_url(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+    assert_response :not_found
+
+    get page_edit_url(leaves(:welcome_page), "latest")
+    assert_response :not_found
+  end
+
+  test "edit history works inside a tenant" do
+    users(:kevin).update!(tenant: @beta)
+    leaves(:welcome_page).edit leafable_params: { body: "New" }
+    sign_in :kevin
+    get page_edit_url(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+    assert_response :success
+  end
+
+  test "new books land in the creator's tenant" do
+    sign_in :kevin
+    post books_url, params: { book: { title: "Acme book", everyone_access: false } }
+    assert_equal @acme.id, Book.last.tenant_id
+  end
+
+  test "sharing with everyone only sprays within the tenant" do
+    sign_in :jason
+    post books_url, params: { book: { title: "Everyone book" } }
+    book = Book.last
+    assert_equal @acme.id, book.tenant_id
+    assert book.accessable?(user: users(:kevin))
+    assert_not book.accessable?(user: users(:david))
+  end
+end
