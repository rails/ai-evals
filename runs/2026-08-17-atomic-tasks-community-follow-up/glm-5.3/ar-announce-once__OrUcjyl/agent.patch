diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..999e32f 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,31 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # A sitting saves everything together, so taking a book live is often followed
+    # by more saves within the same transaction (pressing a page touches the book).
+    # Those later saves overwrite the saved-change tracking, so the move to live is
+    # captured as it happens, then announced once the whole sitting has committed.
+    after_update :remember_publication, if: :saved_change_to_published?
+    after_commit :announce_publication, on: :update, if: :publication_remembered?
+    after_rollback :forget_publication
   end
 
   private
+    def remember_publication
+      @publication_remembered = published?
+    end
+
+    def publication_remembered?
+      @publication_remembered
+    end
+
+    def forget_publication
+      @publication_remembered = false
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      forget_publication
+
+      AnnouncePublicationJob.perform_later self if published?
     end
 end
