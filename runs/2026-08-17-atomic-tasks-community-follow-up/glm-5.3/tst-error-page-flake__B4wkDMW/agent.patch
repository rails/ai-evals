diff --git a/test/integration/raised_exceptions_order_test.rb b/test/integration/raised_exceptions_order_test.rb
new file mode 100644
index 0000000..a5a58ab
--- /dev/null
+++ b/test/integration/raised_exceptions_order_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class RaisedExceptionsOrderTest < ActionDispatch::IntegrationTest
+  def render_404
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+
+  def raise_404
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+  end
+
+  test "raised first, then rendered" do
+    raise_404
+    render_404
+  end
+
+  test "rendered first, then raised, then rendered again" do
+    render_404
+    raise_404
+    render_404
+  end
+
+  test "interleaved" do
+    render_404
+    raise_404
+    render_404
+    raise_404
+    render_404
+  end
+
+  test "the setting is left alone when the block raises" do
+    assert_raises RuntimeError do
+      with_raised_exceptions { raise "boom" }
+    end
+
+    render_404
+  end
+
+  test "the setting survives nesting" do
+    render_404
+
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_url(books(:manual))
+        end
+      end
+
+      # Still inside the outer block, so exceptions keep reaching the test.
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    render_404
+  end
+
+  test "the setting is restored for whatever runs next" do
+    assert_equal :rescuable, Rails.application.config.action_dispatch.show_exceptions
+    assert_equal :rescuable, Rails.application.env_config["action_dispatch.show_exceptions"]
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..c8aa000 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,29 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # `config.action_dispatch.show_exceptions` only reaches a request through
+    # `Rails.application.env_config`, which is built from the config once and then
+    # memoized. Setting the config alone is therefore not enough: when `env_config`
+    # has already been built it keeps serving the value it was built with, and when
+    # it is built *while* our temporary value is set, that value sticks around for
+    # every request in the rest of the process. Update both, and restore both, so
+    # the block behaves the same no matter which tests ran before or run after it.
+    SHOW_EXCEPTIONS_ENV_KEY = "action_dispatch.show_exceptions"
+    private_constant :SHOW_EXCEPTIONS_ENV_KEY
+
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
-      yield
-    ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      application = Rails.application
+      previous = application.config.action_dispatch.show_exceptions
+
+      begin
+        application.config.action_dispatch.show_exceptions = :none
+        application.env_config[SHOW_EXCEPTIONS_ENV_KEY] = :none
+
+        yield
+      ensure
+        application.config.action_dispatch.show_exceptions = previous
+        application.env_config[SHOW_EXCEPTIONS_ENV_KEY] = previous
+      end
     end
   end
 end
