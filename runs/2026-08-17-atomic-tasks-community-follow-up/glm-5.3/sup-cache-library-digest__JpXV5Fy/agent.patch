diff --git a/app/models/user/cached.rb b/app/models/user/cached.rb
index db5b6c4..ee9239b 100644
--- a/app/models/user/cached.rb
+++ b/app/models/user/cached.rb
@@ -2,11 +2,13 @@ module User::Cached
   extend ActiveSupport::Concern
 
   def cached(name, expires_in: 1.hour, &block)
+    return yield if new_record?
+
     Rails.cache.fetch(cache_slot(name), expires_in: expires_in, &block)
   end
 
   private
     def cache_slot(name)
-      "users/#{name}"
+      "users/#{id}/#{name}"
     end
 end
diff --git a/test/models/user/cached_test.rb b/test/models/user/cached_test.rb
new file mode 100644
index 0000000..1cf08df
--- /dev/null
+++ b/test/models/user/cached_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class User::CachedTest < ActiveSupport::TestCase
+  setup do
+    @cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @cache
+  end
+
+  test "cache slots are scoped per user" do
+    assert_not_equal users(:david).send(:cache_slot, :library_digest), users(:jz).send(:cache_slot, :library_digest)
+  end
+
+  test "unsaved users do not share a cache slot" do
+    user = User.new(name: "Nobody", email_address: "nobody@example.com", password: "secret123456")
+
+    assert_equal [], user.library_digest
+    assert_empty Rails.cache.instance_variable_get(:@data).keys
+  end
+end
diff --git a/test/models/user/library_digest_test.rb b/test/models/user/library_digest_test.rb
new file mode 100644
index 0000000..c2f0a98
--- /dev/null
+++ b/test/models/user/library_digest_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class User::LibraryDigestTest < ActiveSupport::TestCase
+  setup do
+    @cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @cache
+  end
+
+  test "only lists books the user may open, whatever anybody else did first" do
+    # A colleague builds their overview first, then somebody else opens theirs.
+    users(:david).library_digest
+    users(:jz).library_digest
+
+    assert_equal [ books(:manual).id, books(:handbook).id ], users(:jz).library_digest.collect { it[:id] }
+    assert_equal [ books(:handbook).id ], users(:kevin).library_digest.collect { it[:id] }
+  end
+
+  test "entries keep their shape" do
+    assert_equal [ { id: books(:manual).id, title: "Manual", leaf_count: books(:manual).leaves.count },
+                   { id: books(:handbook).id, title: "Handbook", leaf_count: books(:handbook).leaves.count } ],
+                 users(:david).library_digest
+  end
+
+  test "asking twice does not build the digest twice" do
+    user = users(:david)
+    user.library_digest
+
+    assert_no_queries { user.library_digest }
+  end
+
+  test "changes to who may read what show up within the hour" do
+    user = users(:david)
+    book = Book.create!(title: "Private", everyone_access: false)
+    book.update_access editors: [ user.id ], readers: []
+
+    assert_includes user.library_digest.collect { it[:id] }, book.id
+
+    book.update_access editors: [], readers: []
+    travel 1.hour + 1.second
+
+    assert_not_includes user.library_digest.collect { it[:id] }, book.id
+  end
+end
