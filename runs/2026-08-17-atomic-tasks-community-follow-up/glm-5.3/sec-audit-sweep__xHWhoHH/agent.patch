diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..c744b7d 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -11,12 +11,25 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where(book: readable_books)
+        .where("leaves.title like ? escape '\\'", pattern)
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
-    def readable_book_ids
-      Book.accessable_or_published.ids.presence || [ 0 ]
+    # The term is data, never part of the query: it is bound as a parameter and
+    # every character in it (', ", %, _ and \) is matched literally.
+    def pattern
+      "%#{escape_wildcards(@query)}%"
+    end
+
+    # %, _ and \ are LIKE wildcards/escapes, so quote them to match themselves.
+    def escape_wildcards(terms)
+      terms.gsub(/[\\%_]/) { |character| "\\#{character}" }
+    end
+
+    # Only ever search inside books the current searcher may read.
+    def readable_books
+      Book.accessable_or_published
     end
 end
