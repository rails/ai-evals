diff --git a/test/integration/exception_rendering_test.rb b/test/integration/exception_rendering_test.rb
new file mode 100644
index 0000000..5e9a3c1
--- /dev/null
+++ b/test/integration/exception_rendering_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+# Guards against leaking the ShowExceptions setting between tests: the order the
+# tests below run in is randomized per seed, so each one must hold up whether it
+# runs before or after the others.
+class ExceptionRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "an inaccessible book raises inside with_raised_exceptions" do
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get book_slug_url(books(:manual)) }
+    end
+  end
+
+  test "an inaccessible book renders a 404 page outside with_raised_exceptions" do
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+    assert_in_body "404"
+  end
+
+  test "a request after with_raised_exceptions renders the 404 page again" do
+    with_raised_exceptions do
+      assert_raises(ActiveRecord::RecordNotFound) { get book_slug_url(books(:manual)) }
+    end
+
+    get book_slug_url(books(:manual))
+
+    assert_response :not_found
+    assert_not_equal :none, Rails.application.env_config["action_dispatch.show_exceptions"]
+    assert_equal Rails.application.config.action_dispatch.show_exceptions,
+                  Rails.application.env_config["action_dispatch.show_exceptions"]
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..f8dad29 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,33 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Inside the block, exceptions raised by a controller reach the test as the raised
+    # exception instead of being turned into a rendered error page.
+    #
+    # The setting has to be changed in two places. `Rails.application.env_config` holds a
+    # snapshot of `config.action_dispatch.show_exceptions` that is taken once per process
+    # and merged into the env of every dispatched request (see Rails::Engine#call and
+    # ActionController::TestRequest.create), so it is what the ShowExceptions middleware
+    # actually consults. Updating only the config would leave the stale snapshot behind,
+    # which leaks (or swallows) exceptions for whatever test runs next in this process --
+    # the suite then fails depending on which test happened to run first. Both values are
+    # saved and restored so the block is scoped to itself, no matter what ran before or
+    # runs after.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      app = Rails.application
+      previous_config = app.config.action_dispatch.show_exceptions
+      previous_env = app.env_config["action_dispatch.show_exceptions"]
+
+      app.config.action_dispatch.show_exceptions = :none
+      app.env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      if app
+        app.config.action_dispatch.show_exceptions = previous_config
+        app.env_config["action_dispatch.show_exceptions"] =
+          previous_env.nil? ? previous_config : previous_env
+      end
     end
   end
 end
