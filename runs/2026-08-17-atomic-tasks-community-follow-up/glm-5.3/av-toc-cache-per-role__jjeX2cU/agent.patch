   def markable
     leaves.active.positioned.map { it.leafable.markable }.join("\n\n")
   end
+
+  # The entries that make up a book's table of contents, loaded once and shared
+  # by every part of the page that lists them. Access to the book is resolved the
+  # first time it's asked about, so a few hundred entries cost one lookup, not
