diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..fa86a5a
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @alpha, @beta = Tenant.create!(name: "Alpha"), Tenant.create!(name: "Beta")
+    users(:david).update!(tenant: @alpha)
+    books(:handbook).update!(tenant: @alpha)
+    books(:manual).update!(tenant: @beta, published: true)
+    @foreign_book = books(:manual)
+    @foreign_leaf = @foreign_book.press Page.new(body: "Beta only"), title: "Beta page"
+    @foreign_leaf.edit(leafable_params: { body: "Beta only v2" }, leaf_params: {})
+    # Spray an access row across the tenant boundary, as sharing with
+    # everyone does on a single install.
+    Access.where(user: users(:david), book: @foreign_book).delete_all
+    Access.create!(user: users(:david), book: @foreign_book, level: :editor)
+
+    sign_in :david
+  end
+
+  test "library omits other tenants' books, published or not" do
+    get root_url
+    assert_response :success
+    assert_in_body "Handbook"
+    assert_not_in_body "Manual"
+  end
+
+  test "other tenants' books 404 on show" do
+    get book_slug_url(@foreign_book)
+    assert_response :not_found
+    get slugged_book_url(@foreign_book.id, @foreign_book.slug)
+    assert_response :not_found
+    get edit_book_url(@foreign_book)
+    assert_response :not_found
+  end
+
+  test "other tenants' pages and edit history 404" do
+    get leafable_slug_url(@foreign_leaf)
+    assert_response :not_found
+    get book_page_url(@foreign_book, @foreign_leaf)
+    assert_response :not_found
+    get edit_book_page_url(@foreign_book, @foreign_leaf)
+    assert_response :not_found
+    get page_edit_url(@foreign_leaf, "latest")
+    assert_response :not_found
+    get page_edit_url(@foreign_leaf, @foreign_leaf.edits.last)
+    assert_response :not_found
+    get book_bookmark_url(@foreign_book)
+    assert_response :not_found
+  end
+
+  test "other tenants' book search, publication and leaf move 404" do
+    post book_search_url(@foreign_book), params: { search: "Beta" }
+    assert_response :not_found
+    get book_publication_url(@foreign_book)
+    assert_response :not_found
+    get edit_book_publication_url(@foreign_book)
+    assert_response :not_found
+    patch book_publication_url(@foreign_book), params: { book: { published: false } }
+    assert_response :not_found
+    post book_leaves_moves_url(@foreign_book), params: { id: [ @foreign_leaf.id ], position: 1 }
+    assert_response :not_found
+  end
+
+  test "sections and pictures inside other tenants' books 404" do
+    section = @foreign_book.press Section.new(body: "s"), title: "S"
+    picture = @foreign_book.press Picture.new, title: "P"
+
+    get leafable_slug_url(section)
+    assert_response :not_found
+    get book_section_url(@foreign_book, section)
+    assert_response :not_found
+    get leafable_slug_url(picture)
+    assert_response :not_found
+    get book_picture_url(@foreign_book, picture)
+    assert_response :not_found
+  end
+
+  test "writing into another tenant's book is refused" do
+    assert_no_changes -> { @foreign_leaf.reload.title } do
+      patch book_page_url(@foreign_book, @foreign_leaf), params: { leaf: { title: "Hacked" } }, as: :turbo_stream
+      assert_response :not_found
+    end
+    assert_no_changes -> { Book.count } do
+      post book_pages_url(@foreign_book), params: { page: { body: "Injected" } }
+      assert_response :not_found
+    end
+    assert_no_changes -> { @foreign_book.reload.title } do
+      patch book_url(@foreign_book), params: { book: { title: "Hacked" } }
+      assert_response :not_found
+    end
+    assert_no_changes -> { Book.count } do
+      delete book_url(@foreign_book)
+      assert_response :not_found
+    end
+  end
+
+  test "everything keeps working inside a tenant" do
+    leaf = leaves(:welcome_page)
+    get leafable_slug_url(leaf)
+    assert_response :success
+    leaf.edit(leafable_params: { body: "Own tenant body" }, leaf_params: {})
+    get page_edit_url(leaf, "latest")
+    assert_response :success
+
+    assert_difference -> { Book.count }, +1 do
+      post books_url, params: { book: { title: "Alpha shared", everyone_access: true } }
+    end
+    book = Book.last
+    assert_equal @alpha.id, book.tenant_id
+    assert book.accessable?(user: users(:david))
+    assert book.editable?(user: users(:david))
+
+    # Sharing with everyone keeps working, and stays inside the tenant.
+    newcomer = User.create!(name: "Alpha New", email_address: "new@alpha.com", password: "secret123456", tenant: @alpha)
+    assert book.accessable?(user: newcomer)
+    assert_not book.accessable?(user: users(:jz))
+  end
+
+  test "signed out visitors still see every published book" do
+    sign_out
+    get root_url
+    assert_in_body "Manual"
+    get book_slug_url(@foreign_book)
+    assert_response :success
+    get leafable_slug_url(@foreign_leaf)
+    assert_response :success
+  end
+
+  test "users page still names everyone on the install" do
+    get users_url
+    assert_response :success
+    assert_in_body users(:jz).name
+  end
+end
