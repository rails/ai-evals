diff --git a/app/jobs/application_job.rb b/app/jobs/application_job.rb
index d394c3d..43a7de6 100644
--- a/app/jobs/application_job.rb
+++ b/app/jobs/application_job.rb
@@ -4,4 +4,8 @@ class ApplicationJob < ActiveJob::Base
 
   # Most jobs are safe to ignore if the underlying records are no longer available
   # discard_on ActiveJob::DeserializationError
+
+  # Work is only handed off once the edit that kicked it off has committed, so jobs
+  # never run against uncommitted records, and are dropped if it is rolled back.
+  self.enqueue_after_transaction_commit = true
 end
diff --git a/app/jobs/books/import_failure_job.rb b/app/jobs/books/import_failure_job.rb
index 0bfd478..5077fde 100644
--- a/app/jobs/books/import_failure_job.rb
+++ b/app/jobs/books/import_failure_job.rb
@@ -1,4 +1,8 @@
 class Books::ImportFailureJob < ApplicationJob
+  # The operator has to hear about a failed import even when the batch was rolled
+  # back, so this one is handed off straight away rather than after a commit.
+  self.enqueue_after_transaction_commit = false
+
   def perform(user_id, message)
     Rails.cache.write("import_failure/#{user_id}", message)
   end
