--- a/app/models/picture.rb
+++ b/app/models/picture.rb
@@ -2,7 +2,14 @@ class Picture < ApplicationRecord
   include Leafable
 
   has_one_attached :image do |attachable|
-    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+    # The format must be given as a String, not a Symbol. The variation key that
+    # ends up in a reader's image URL is round-tripped through the message
+    # verifier, which serializes transformations, so it comes back with Strings.
+    # Active Storage derives in the background using the transformations as
+    # declared here, and matches the derived copy by the digest of those
+    # transformations -- a Symbol would give a different digest and the derived
+    # copy would never be found, so every reader would rederive a second copy.
+    attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: "webp", process: :later
   end
 
   def large_image
diff --git a/test/integration/picture_variants_test.rb b/test/integration/picture_variants_test.rb
new file mode 100644
index 0000000..d5f3ce8
--- /dev/null
+++ b/test/integration/picture_variants_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  test "an uploaded picture is derived once, then served without further processing" do
+    book = books(:handbook)
+    sign_in :kevin
+
+    picture = Picture.new caption: "A picture"
+    picture.image.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+    leaf = book.press picture, title: "A picture"
+
+    drain_background_jobs
+
+    blob = leaf.picture.image.blob.reload
+    assert_equal 1, blob.variant_records.count, "the background job should have derived a single copy"
+
+    # The copy the background job wrote is the one the reader is linked to.
+    assert leaf.picture.large_image.processed?, "the derived copy should be reused instead of reprocessed"
+
+    get leafable_slug_path(leaf)
+    assert_response :ok
+
+    image_url = response.body.scan(/src="([^"]+)"/).flatten.grep(%r{active_storage/representations}).first
+    assert image_url, "the page should link to the derived picture"
+
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+    before_serving = stored_files
+
+    get image_url
+    follow_redirect! while response.status == 302
+    assert_response :ok
+    served = response.body.dup
+
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_equal 0, transforms, "serving the picture to a reader should not run image processing"
+    assert_equal before_serving, stored_files, "serving the picture should not leave another copy in storage"
+    assert_equal 1, blob.reload.variant_records.count
+
+    # The reader still gets the same picture they got before, byte for byte.
+    assert_equal derived_copy_for(blob), served
+  end
+
+  test "replacing a picture derives the new image once" do
+    book = books(:handbook)
+    sign_in :kevin
+
+    picture = Picture.new caption: "A picture"
+    picture.image.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+    leaf = book.press picture, title: "A picture"
+    drain_background_jobs
+
+    leaf.edit leafable_params: { image: Rack::Test::UploadedFile.new(file_fixture("reading.webp").open, "image/webp", original_filename: "reading.webp") }
+    drain_background_jobs
+
+    blob = leaf.picture.image.blob.reload
+    assert_equal 1, blob.variant_records.count
+
+    get leafable_slug_path(leaf)
+    assert_response :ok
+    image_url = response.body.scan(/src="([^"]+)"/).flatten.grep(%r{active_storage/representations}).first
+
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+    get image_url
+    follow_redirect! while response.status == 302
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_equal 0, transforms
+    assert_equal 1, blob.reload.variant_records.count
+  end
+
+  private
+    def drain_background_jobs
+      perform_enqueued_jobs
+      perform_enqueued_jobs while ActiveJob::Base.queue_adapter.enqueued_jobs.any?
+    end
+
+    def stored_files
+      Dir[File.join(ActiveStorage::Blob.service.root, "**/*")].select { |path| File.file?(path) }.map { |path|
+        [ File.basename(path), File.size(path) ]
+      }.sort
+    end
+
+    # Derives the copy independently, so we can compare what a reader is served.
+    def derived_copy_for(blob)
+      file = Tempfile.new
+      blob.open { |source| IO.copy_stream(source, file) }
+
+      variant = ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: "webp")
+      file.rewind
+      variant.transform(file) do |output|
+        return output.read
+      end
+    ensure
+      file.close!
+    end
+end
diff --git a/test/models/picture_variant_test.rb b/test/models/picture_variant_test.rb
