diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..5860fcc 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,33 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_save :track_publication_transition
+    after_rollback :forget_publication_transition
+    after_update_commit :announce_publication, if: :went_live?
   end
 
   private
+    # Rails' saved-change tracking ("saved_change_to_published?") is not reliable
+    # here: touching the book from an associated record -- e.g. saving a page
+    # added in the same sitting -- replaces the book's saved changes with the
+    # touch's, so a book that just went live looks untouched, while taking a live
+    # book back down still looks like a change. Track the draft-to-live
+    # transition ourselves so the whole sitting is judged by where it started and
+    # where it ended up: announce only when the book actually ended up live.
+    def track_publication_transition
+      @went_live = published_in_database ? false : will_save_change_to_published? && published?
+    end
+
+    def went_live?
+      !!@went_live
+    end
+
+    def forget_publication_transition
+      @went_live = nil
+    end
+
     def announce_publication
+      forget_publication_transition
       AnnouncePublicationJob.perform_later self
     end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
