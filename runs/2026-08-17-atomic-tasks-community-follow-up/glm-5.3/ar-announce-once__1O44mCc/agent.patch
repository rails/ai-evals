@@ -29,4 +29,34 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_redirected_to book_slug_url(@book)
     assert_equal "new-slug", @book.slug
   end
+
+  test "going live announces the book once even when pages are added in the same sitting" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "A late page" ] }
+    end
+
+    assert_redirected_to book_slug_url(@book)
