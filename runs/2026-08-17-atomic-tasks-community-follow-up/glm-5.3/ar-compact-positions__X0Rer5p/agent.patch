+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! keeps the leaves in their current order" do
+    leaves(:welcome_page).move_to_position(0)
+    leaves(:reading_picture).move_to_position(1)
+    expected = [ leaves(:welcome_page), leaves(:reading_picture), leaves(:welcome_section), leaves(:summary_page) ]
+
+    books(:handbook).compact_positions!
+
+    assert_equal expected, books(:handbook).leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! does not reorder leaves by when they were created" do
+    # Create the leaves in a different order than they are positioned in.
+    newest = books(:handbook).press Page.new(body: "Newest"), title: "Newest"
+    newest.move_to_position(0)
+
+    books(:handbook).compact_positions!
+
+    assert_equal newest, books(:handbook).leaves.positioned.first
+    assert_equal [ 1, 2, 3, 4, 5 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! closes the gaps left by trashed leaves" do
+    leaves(:welcome_page).trashed!
+
+    books(:handbook).compact_positions!
+
+    assert_equal [ leaves(:welcome_section), leaves(:summary_page), leaves(:reading_picture) ], books(:handbook).leaves.active.positioned
+    assert_equal [ 1, 2, 3, 4 ], books(:handbook).leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! keeps a leaf restored from the trash in its place" do
+    leaves(:welcome_page).trashed!
+
+    books(:handbook).compact_positions!
+
+    leaves(:welcome_page).active!
+
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ], books(:handbook).leaves.active.positioned
+  end
+
+  test "compact_positions! leaves a book without leaves alone" do
+    assert_no_changes -> { books(:manual).leaves.to_a } do
+      books(:manual).compact_positions!
+    end
+  end
+
+  test "live_leaf_count counts the leaves that are not in the trash" do
+    assert_equal 4, books(:handbook).live_leaf_count
+
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
