diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..9d8a9ca 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,40 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # Saving a leaf touches the book, which wipes the dirty tracking of the save
+    # that took the book live, so remember the transition as it happens.
+    after_update :track_publication, if: :published_from_draft?
+    after_update :untrack_publication, if: :unpublished_from_live?
+
+    # Announce a book that ends up live exactly once per sitting, whatever else
+    # that sitting did, and never for a sitting that was rolled back.
+    after_update_commit :announce_publication, if: :publication_tracked?
+    after_rollback :untrack_publication
   end
 
   private
+    def published_from_draft?
+      saved_change_to_published?(from: false, to: true)
+    end
+
+    def unpublished_from_live?
+      saved_change_to_published?(from: true, to: false)
+    end
+
+    def track_publication
+      @publication_tracked = true
+    end
+
+    def untrack_publication
+      @publication_tracked = nil
+    end
+
+    def publication_tracked?
+      @publication_tracked && published?
+    end
+
     def announce_publication
+      untrack_publication
       AnnouncePublicationJob.perform_later self
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..fe95256
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "going live announces the book" do
+    assert_enqueued_with job: AnnouncePublicationJob do
+      books(:manual).update! published: true
+    end
+  end
+
+  test "going live announces the book exactly once, whatever else the sitting did" do
+    assert_enqueued_jobs 1 do
+      Book.transaction do
+        books(:manual).update! published: true
+        books(:manual).press Page.new(body: "Some content"), title: "A new page"
+        books(:manual).leaves.first.update! title: "Renamed page"
+      end
+    end
+  end
+
+  test "saving an already live book again does not announce it" do
+    book = books(:manual)
+    book.update! published: true
+
+    assert_no_enqueued_jobs do
+      book.update! published: true
+    end
+  end
+
+  test "taking a live book down does not announce it" do
+    book = books(:manual)
+    book.update! published: true
+
+    assert_no_enqueued_jobs do
+      book.update! published: false
+    end
+  end
+
+  test "a save that does not take a book live announces nothing" do
+    assert_no_enqueued_jobs do
+      Book.transaction do
+        books(:manual).press Page.new(body: "Some content"), title: "A new page"
+        books(:manual).update! title: "Renamed book"
+      end
+    end
+  end
+
+  test "a sitting that fails after the book was marked live leaves a draft and no announcement" do
+    book = books(:manual)
+
+    assert_no_enqueued_jobs do
+      book.transaction do
+        book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not book.reload.published?
+  end
+end
