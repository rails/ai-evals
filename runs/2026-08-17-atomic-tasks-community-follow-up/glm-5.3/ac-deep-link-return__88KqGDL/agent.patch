diff --git a/app/controllers/sessions_controller.rb b/app/controllers/sessions_controller.rb
index 2bef7c1..0592a3f 100644
--- a/app/controllers/sessions_controller.rb
+++ b/app/controllers/sessions_controller.rb
@@ -10,7 +10,9 @@ class SessionsController < ApplicationController
   def create
     if user = User.active.authenticate_by(email_address: params[:email_address], password: params[:password])
       start_new_session_for user
-      redirect_to params[:return_to].presence || post_authenticating_url, allow_other_host: true
+      # Never hand the reader to somebody else's site: an unchecked +return_to+ would
+      # send them straight to an attacker's copy of our sign-in page.
+      redirect_to url_from(params[:return_to]) || post_authenticating_url
     else
       render_rejection :unauthorized
     end
diff --git a/test/controllers/sessions_controller_test.rb b/test/controllers/sessions_controller_test.rb
index fab5c82..70306b0 100644
--- a/test/controllers/sessions_controller_test.rb
+++ b/test/controllers/sessions_controller_test.rb
@@ -55,4 +55,43 @@ class SessionsControllerTest < ActionDispatch::IntegrationTest
     assert_not cookies[:session_token].present?
     assert_nil Session.find_by(id: session.id)
   end
+
+  test "create with valid credentials and a deep link returns the reader to that page" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: leafable_slug_path(leaves(:welcome_page)) }
+
+    assert_redirected_to leafable_slug_path(leaves(:welcome_page))
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a blank return_to returns the reader to the root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "" }
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with an off-site return_to returns the reader to the root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "https://evil.example.com/sign-in" }
+
+    assert_redirected_to root_url
+    assert parsed_cookies.signed[:session_token]
+  end
+
+  test "create with a protocol relative off-site return_to returns the reader to the root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "//evil.example.com" }
+
+    assert_redirected_to root_url
+  end
+
+  test "create with a javascript return_to returns the reader to the root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "javascript:alert(document.domain)" }
+
+    assert_redirected_to root_url
+  end
+
+  test "create with a garbled return_to returns the reader to the root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456", return_to: "http://www.example.com/\\\" onmouseover=\\\"steal" }
+
+    assert_redirected_to root_url
+  end
 end
