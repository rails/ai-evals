new file mode 100644
index 0000000..51b8e28
--- /dev/null
+++ b/config/initializers/log_to_stdout.rb
@@ -0,0 +1,16 @@
+# `rails runner` only writes to the environment's log file, so one-off scripts
+# like script/library_report.rb stay invisible to whoever runs them from the
+# terminal.
+#
+# Do what `rails server --log_stdout` does: keep the file logger in place (the
+# log tooling reads log/<environment>.log) and broadcast the very same lines,
+# at the same severity, to STDOUT as well.
+Rails.application.runner do
+  console = ActiveSupport::Logger.new($stdout)
+  console.formatter = Rails.logger.formatter
+  console.level = Rails.logger.level
+
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+    Rails.logger.broadcast_to(console)
+  end
+end
