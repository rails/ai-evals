+++ b/test/integration/page_uploads_cleanup_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class PageUploadsCleanupTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "destroying a trashed page purges the images embedded in its markdown" do
+    page = pages(:welcome)
+    attachment = attach_upload_to(page)
+    blob = attachment.blob
+    page.leaf.edit leafable_params: { body: "![Reading](#{attachment.slug_path})" }, leaf_params: {}
+
+    leaf = page.leaf.reload
+    leaf.trashed!
+    assert leaf.reload.trashed?
+
+    leaf.destroy
+    perform_enqueued_jobs
+
+    assert_purged blob
+  end
+
+  test "destroying a book purges the uploads of every page in it" do
+    page = pages(:welcome)
+    attachment = attach_upload_to(page)
+    blob = attachment.blob
+    page.update!(body: "![Reading](#{attachment.slug_path})")
+
+    books(:handbook).destroy
+    perform_enqueued_jobs
+
+    assert_purged blob
+  end
+
+  private
+    def attach_upload_to(record)
+      record.body.tap(&:save!).uploads.attach fixture_file_upload("reading.webp", "image/webp")
+      record.reload.body.uploads.attachments.last
+    end
+
+    def assert_purged(blob)
+      assert_not ActiveStorage::Blob.exists?(blob.id), "expected the blob record to be gone"
+      assert_not blob.service.exist?(blob.key), "expected the file to be gone from the service"
+    end
+end
