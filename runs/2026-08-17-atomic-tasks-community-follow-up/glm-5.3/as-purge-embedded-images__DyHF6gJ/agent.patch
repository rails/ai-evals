+
+  test "uploads shared with other markdown records are purged only once no longer in use" do
+    page, other_page = pages(:welcome), pages(:summary)
+    attachment, blob = attach_upload_to(page)
+    other_page.body.tap(&:save!).uploads.attach blob
+
+    page.leaf.destroy
+    perform_enqueued_jobs
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
