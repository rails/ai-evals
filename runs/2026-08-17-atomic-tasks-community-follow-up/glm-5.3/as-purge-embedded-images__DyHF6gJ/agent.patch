+  test "destroying a page purges uploads still referenced by an old revision" do
+    page = pages(:welcome)
+    attachment, blob = attach_upload_to(page)
+
+    page.leaf.edit leafable_params: { body: "![Reading](#{attachment.slug_path})" }, leaf_params: {}
+
+    edit = page.leaf.edits.last
+    assert edit.revision?
