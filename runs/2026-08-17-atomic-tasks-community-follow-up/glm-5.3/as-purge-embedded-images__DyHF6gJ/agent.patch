diff --git a/test/integration/page_upload_serving_test.rb b/test/integration/page_upload_serving_test.rb
new file mode 100644
index 0000000..c73cb1c
--- /dev/null
+++ b/test/integration/page_upload_serving_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class PageUploadServingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "uploading an image into a page's markdown and fetching it back works" do
+    page = pages(:welcome)
+
+    post action_text_markdown_uploads_url, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    assert_response :created
+    file_url = JSON.parse(response.body)["fileUrl"]
+    assert file_url.start_with?("/"), "uploads should use relative URLs"
+
+    # Save the page with the image referenced inline, then render it.
+    page.update!(body: "![Reading](#{file_url})")
+
+    get leafable_slug_path(page.leaf.reload)
+    assert_response :success
+    assert_in_body file_url
+
+    # Fetch the image from the URL the app handed out.
+    get file_url
+    assert_response :redirect
+    assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
+
+    follow_redirect!
+    assert_response :success
+    assert_equal "image/webp", @response.content_type
+  end
+
+  test "destroying a page removes the embedded image's file and record" do
+    page = pages(:welcome)
+
+    post action_text_markdown_uploads_url, params: {
+      record_gid: page.to_signed_global_id.to_s,
+      attribute_name: "body",
+      file: fixture_file_upload("reading.webp", "image/webp")
+    }, as: :xhr
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    blob = page.reload.body.uploads.attachments.last.blob
+    page.update!(body: "![Reading](#{file_url})")
+
+    page.leaf.destroy
+    perform_enqueued_jobs
+
+    assert_not ActiveStorage::Blob.exists?(blob.id), "expected the blob record to be gone"
+    assert_not blob.service.exist?(blob.key), "expected the file to be gone from the service"
+
+    # The slug no longer resolves to an attachment.
+    get file_url
+    assert_response :not_found
+  end
+end
diff --git a/test/integration/page_uploads_cleanup_test.rb b/test/integration/page_uploads_cleanup_test.rb
