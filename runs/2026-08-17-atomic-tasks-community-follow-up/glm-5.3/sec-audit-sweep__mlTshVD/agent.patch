diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..67498a3
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    books(:handbook).press Page.new(body: "Discount"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Discount"), title: "A_b and no percent here"
+    books(:manual).press Page.new(body: "Hidden manual body"), title: "Top Secret Manual Page"
+    Leaf.reindex_all
+  end
+
+  test "search finds pages in books the current user can read" do
+    sign_in :kevin
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "search only returns pages from books the current user can read" do
+    sign_in :kevin
+
+    get library_search_path(q: "Manual")
+
+    assert_response :success
+    assert_not_in_body "Top Secret Manual Page"
+    assert_not_in_body "Hidden manual body"
+  end
+
+  test "search does not error or leak when the term contains an apostrophe" do
+    sign_in :kevin
+
+    get library_search_path(q: "it's")
+
+    assert_response :success
+    assert_not_in_body "Top Secret Manual Page"
+  end
+
+  test "search is not vulnerable to sql injection" do
+    sign_in :kevin
+
+    get library_search_path(q: "' or 1=1 --")
+
+    assert_response :success
+    assert_not_in_body "Top Secret Manual Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search does not error for terms made only of punctuation" do
+    sign_in :kevin
+
+    [ "\"", "%", "_", "\\", "'" ].each do |term|
+      get library_search_path(q: term)
+      assert_response :success, "expected success for #{term.inspect}"
+    end
+  end
+
+  test "search treats a percent sign as data, not a wildcard" do
+    sign_in :kevin
+
+    get library_search_path(q: "%")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search finds a page by its percent sign title" do
+    sign_in :kevin
+
+    get library_search_path(q: "Save 50% off")
+
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search treats an underscore as data, not a wildcard" do
+    sign_in :kevin
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_in_body "A_b and no percent here"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search finds a page containing an underscore" do
+    sign_in :kevin
+
+    get library_search_path(q: "A_b")
+
+    assert_response :success
+    assert_in_body "A_b and no percent here"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search does not treat a backslash as an escape" do
+    sign_in :kevin
+
+    get library_search_path(q: "50\\%")
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search shows no matches for an unmatched term" do
+    sign_in :kevin
+
+    get library_search_path(q: "the invisible man")
+
+    assert_response :success
+    assert_in_body "No matches."
+  end
+
+  test "search returns nothing when not signed in and nothing is published" do
+    sign_out
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "search returns pages of published books when not signed in" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Top Secret Manual Page"
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..b498fb8 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,33 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+  test "update does not allow a member to grant themselves a role" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Bob", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert users(:kevin).reload.member?
+    assert_equal "Bob", users(:kevin).reload.name
+  end
+
+  test "update does not allow changing the role of another user" do
+    sign_in :david
+    users(:kevin).update!(role: :member)
+
+    put user_profile_url(users(:kevin)), params: { user: { role: "administrator" } }
+
+    assert_response :forbidden
+    assert users(:kevin).reload.member?
+  end
+
+  test "update still allows changing email address and password" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { email_address: "kevin2@example.com", password: "newsecret123456" } }
+
+    assert_redirected_to users_url
+    assert_equal "kevin2@example.com", users(:kevin).reload.email_address
+    assert users(:kevin).authenticate("newsecret123456")
+  end
 end
