diff --git a/app/models/book/import.rb b/app/models/book/import.rb
index 6d049dd..1ba4407 100644
--- a/app/models/book/import.rb
+++ b/app/models/book/import.rb
@@ -4,18 +4,25 @@ module Book::Import
   # Imports a manifest — an array of { title:, body: } entries — into the
   # book as sections, in manifest order. Imports are all-or-nothing: a book
   # must never be left holding part of a manifest.
+  #
+  # Returns true when every entry was imported, false when the manifest was
+  # rejected and the book was left exactly as it was.
   def import_manifest(entries)
-    as_one_batch do
-      entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
-
-        press(Section.new(body: entry[:body]), title: entry[:title])
-      end
-    end
-    true
+    as_one_batch { entries.all? { |entry| import_entry(entry) } }
   end
 
   private
+    def import_entry(entry)
+      return rejected(entry) unless entry_valid?(entry)
+
+      press(Section.new(body: entry[:body]), title: entry[:title])
+      true
+    rescue ActiveRecord::RecordInvalid
+      # The book turned the entry away — a title the book already has, say.
+      # That is a rejection like any other, not a crash.
+      rejected(entry)
+    end
+
     def entry_valid?(entry)
       entry[:title].present? && entry[:body].present?
     end
diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..6771f55 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -1,12 +1,39 @@
 module Batched
   extend ActiveSupport::Concern
 
+  # Raised to abandon a batch: the block reported the batch as no-good, so
+  # its writes must not land. Deliberately not an ActiveRecord::Rollback —
+  # that one is silently swallowed inside the transaction call itself, which
+  # is exactly how a rejected batch could look like a successful one.
+  class BatchRejected < StandardError; end
+
   private
     # Runs a batch of writes as a single unit of work: either the whole batch
     # lands or none of it does. The manifest importer goes through here so
     # that a rejected manifest leaves the book exactly as it was before the
     # attempt.
+    #
+    # The block reports on its own batch: truthy means the batch is good and
+    # commits, falsy means the batch is rejected and all of its writes are
+    # undone. The block must never `return` or `break` out of itself —
+    # unwinding through the transaction commits what has been written so far —
+    # so it reports failure by value instead.
+    #
+    # The batch always gets its own transaction (`requires_new:`): inside a
+    # caller's transaction that means a savepoint, so a rejected batch can be
+    # undone on its own while the caller's work carries on. Joining the
+    # caller's transaction instead would leave no way to scope the rollback to
+    # this batch — the batch's writes would survive a rejection, or undoing
+    # them would take the caller's work with it.
+    #
+    # Returns true if the batch committed, false if it was rejected.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true) do
+        raise BatchRejected unless yield
+      end
+
+      true
+    rescue BatchRejected
+      false
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..3161f40
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  setup { @book = books(:manual) }
+
+  test "imports every entry as a section, in manifest order" do
+    assert @book.import_manifest([
+      { title: "One", body: "first" },
+      { title: "Two", body: "second" },
+      { title: "Three", body: "third" }
+    ])
+
+    sections = @book.leaves.order(:position_score)
+    assert_equal %w[ One Two Three ], sections.map(&:title)
+    assert_equal %w[ first second third ], sections.map { it.leafable.body }
+    assert sections.all?(&:section?)
+  end
+
+  test "an empty manifest imports nothing and reports success" do
+    assert @book.import_manifest([])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "an invalid entry anywhere in the manifest imports nothing at all" do
+    [
+      [ { title: "", body: "body" }, { title: "One", body: "first" } ],
+      [ { title: "One", body: "first" }, { title: "", body: "body" }, { title: "Two", body: "second" } ],
+      [ { title: "One", body: "first" }, { title: "Two", body: nil } ],
+      [ { title: "One", body: "first" }, { title: "  ", body: "body" } ]
+    ].each do |manifest|
+      book = Book.create!(title: "Import #{manifest.hash.abs}")
+
+      assert_not book.import_manifest(manifest), "expected #{manifest.inspect} to be rejected"
+      assert_equal 0, book.leaves.count, "expected nothing of #{manifest.inspect} to land"
+    end
+  end
+
+  test "an entry the book turns away is a rejection, not a crash" do
+    book = books(:handbook) # already holds a leaf titled "Summary"
+
+    result = nil
+    assert_nothing_raised do
+      result = book.import_manifest([ { title: "One", body: "first" }, { title: "Summary", body: "duplicate" } ])
+    end
+
+    assert_not result
+    assert_equal 4, book.reload.leaves.count
+    assert_not_includes book.leaves.map(&:title), "One"
+  end
+
+  test "two entries sharing a title reject the manifest" do
+    assert_not @book.import_manifest([ { title: "One", body: "first" }, { title: "One", body: "again" } ])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a rejected manifest leaves the book as it was" do
+    book = books(:handbook)
+    touched_at = book.reload.updated_at
+
+    assert_not book.import_manifest([ { title: "One", body: "first" }, { title: "Two", body: "" } ])
+
+    assert_equal 4, book.reload.leaves.count
+    assert_equal touched_at, book.updated_at
+    assert_equal 4, book.leaves.maximum(:position_score)
+  end
+
+  test "a rejected manifest leaves nothing behind inside a caller's transaction" do
+    @book.press Section.new(body: "kept"), title: "Kept"
+
+    Book.transaction do
+      assert_not @book.import_manifest([ { title: "One", body: "first" }, { title: "Two", body: "" } ])
+      assert_equal [ "Kept" ], @book.leaves.active.map(&:title)
+    end
+
+    assert_equal [ "Kept" ], @book.reload.leaves.active.map(&:title)
+  end
+
+  test "a manifest committed inside a caller's transaction dies with it" do
+    Book.transaction do
+      @book.import_manifest([ { title: "One", body: "first" } ])
+      raise ActiveRecord::Rollback
+    end
+
+    assert_equal 0, @book.reload.leaves.count
+  end
+
+  test "re-running a fixed manifest does not duplicate its good entries" do
+    assert_not @book.import_manifest([ { title: "One", body: "first" }, { title: "", body: "" } ])
+    assert @book.import_manifest([ { title: "One", body: "first" }, { title: "Two", body: "second" } ])
+
+    assert_equal %w[ One Two ], @book.leaves.order(:position_score).map(&:title)
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..dd640dc
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "imports every manifest and reports nothing rejected" do
+    handbook, manual = books(:handbook), books(:manual)
+
+    result = BulkImport.new({
+      handbook => [ { title: "One", body: "first" } ],
+      manual => [ { title: "Two", body: "second" }, { title: "Three", body: "third" } ]
+    }).run
+
+    assert_equal [ handbook, manual ], result.imported
+    assert_empty result.rejected
+    assert_includes handbook.leaves.map(&:title), "One"
+    assert_equal %w[ Two Three ], manual.leaves.order(:position_score).map(&:title)
+  end
+
+  test "a rejected manifest leaves nothing of itself behind" do
+    manual = books(:manual)
+
+    result = BulkImport.new({
+      manual => [ { title: "One", body: "first" }, { title: "Two", body: "" } ]
+    }).run
+
+    assert_equal [ manual ], result.rejected
+    assert_empty result.imported
+    assert_equal 0, manual.reload.leaves.count
+  end
+
+  test "a rejected manifest leaves the rest of the night's work standing" do
+    handbook, manual = books(:handbook), books(:manual)
+
+    result = BulkImport.new({
+      manual => [ { title: "Nope", body: "  " } ],
+      handbook => [ { title: "One", body: "first" }, { title: "Two", body: "second" } ]
+    }).run
+
+    assert_equal [ handbook ], result.imported
+    assert_equal [ manual ], result.rejected
+    assert_equal 0, manual.reload.leaves.count
+    assert_equal %w[ One Two ], handbook.leaves.order(:position_score).map(&:title).last(2)
+  end
+
+  test "an entry the book turns away rejects only its own manifest" do
+    handbook, manual = books(:handbook), books(:manual)
+
+    result = BulkImport.new({
+      handbook => [ { title: "Summary", body: "already taken" } ],
+      manual => [ { title: "One", body: "first" } ]
+    }).run
+
+    assert_equal [ manual ], result.imported
+    assert_equal [ handbook ], result.rejected
+    assert_equal 4, handbook.reload.leaves.count
+    assert_includes manual.leaves.map(&:title), "One"
+  end
+end
