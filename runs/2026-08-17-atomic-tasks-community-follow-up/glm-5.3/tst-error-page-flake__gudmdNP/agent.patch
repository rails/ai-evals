diff --git a/test/integration/raised_exceptions_test.rb b/test/integration/raised_exceptions_test.rb
new file mode 100644
index 0000000..47bf58e
--- /dev/null
+++ b/test/integration/raised_exceptions_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class RaisedExceptionsTest < ActionDispatch::IntegrationTest
+  test "with_raised_exceptions raises inside the block and renders error pages afterwards" do
+    with_raised_exceptions do
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    # The exception-visibility override must be scoped to the block, so error pages
+    # render again for requests made after it, in this and in later tests.
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+
+  test "restores error pages even when the block raises" do
+    assert_raises ZeroDivisionError do
+      with_raised_exceptions { 1 / 0 }
+    end
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+
+  test "is nestable" do
+    with_raised_exceptions do
+      with_raised_exceptions do
+        assert_raises ActiveRecord::RecordNotFound do
+          get book_slug_url(books(:manual))
+        end
+      end
+
+      assert_raises ActiveRecord::RecordNotFound do
+        get book_slug_url(books(:manual))
+      end
+    end
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+  end
+end
diff --git a/test/test_helper.rb b/test/test_helper.rb
