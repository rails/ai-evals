@@ -12,12 +12,31 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # `Rails.application.env_config` is memoized on the first request and is merged
+    # into every request env (Engine#build_request), so it wins over per-request env
+    # and over later changes to the app config. If a test toggles a setting through
+    # the config alone, the stale memoized value sticks around for every request
+    # made later in this process -- including by tests that run after it, since the
+    # parallel workers reuse one process per batch of tests. Sync both places so the
+    # setting is scoped to the block, and reset it before each test as a safety net.
+    SHOW_EXCEPTIONS_KEY = "action_dispatch.show_exceptions"
+
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
+      previous_config = Rails.application.config.action_dispatch.show_exceptions
+      previous_env = Rails.application.env_config[SHOW_EXCEPTIONS_KEY]
+
       Rails.application.config.action_dispatch.show_exceptions = :none
+      Rails.application.env_config[SHOW_EXCEPTIONS_KEY] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Rails.application.config.action_dispatch.show_exceptions = previous_config
+      Rails.application.env_config[SHOW_EXCEPTIONS_KEY] = previous_env
+    end
+
+    setup do
+      # Never inherit an exception-visibility override from whatever ran before us
+      # in this process.
+      Rails.application.env_config[SHOW_EXCEPTIONS_KEY] = Rails.application.config.action_dispatch.show_exceptions
     end
   end
 end
