diff --git a/app/controllers/concerns/authentication.rb b/app/controllers/concerns/authentication.rb
index 0040b33..2a30595 100644
--- a/app/controllers/concerns/authentication.rb
+++ b/app/controllers/concerns/authentication.rb
@@ -71,6 +71,33 @@ module Authentication
       session.delete(:return_to_after_authenticating) || root_url
     end
 
+    # The +return_to+ parameter travels along with shared and emailed links, so it can
+    # hold anything at all by the time it reaches us -- including somebody else's
+    # address. Only ever send the reader to a page on this site: never to another
+    # host, a protocol-relative URL, or a different scheme like +javascript:+.
+    # Anything else falls back to the given URL.
+    def safe_return_to(fallback = root_url)
+      candidate = params[:return_to].to_s
+
+      begin
+        uri = URI.parse(candidate)
+      rescue URI::InvalidURIError, ArgumentError
+        return fallback
+      end
+
+      return fallback if uri.host.present? && !uri.host.casecmp?(request.host)
+      return fallback if uri.scheme.present? && !uri.scheme.in?(%w[ http https ])
+      return fallback if candidate.start_with?("//")
+
+      if uri.host.present?
+        [ uri.path.presence || "/", uri.query && "?#{uri.query}", uri.fragment && "##{uri.fragment}" ].compact.join
+      elsif candidate.start_with?("/", "#")
+        candidate
+      else
+        fallback
+      end
+    end
+
     def set_authentication_cookie(session)
       cookies.signed.permanent[:session_token] = { value: session.token, httponly: true, same_site: :lax }
     end
