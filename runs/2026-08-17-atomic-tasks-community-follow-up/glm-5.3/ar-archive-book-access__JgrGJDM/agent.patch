index 0000000..08080d3
--- /dev/null
+++ b/test/models/book/archive_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Book::ArchiveTest < ActiveSupport::TestCase
+  test "destroy archives every access with user and level" do
+    book = books(:handbook)
+    assert_equal 4, book.accesses.count
+
+    book.destroy!
+
+    rows = AccessArchive.where(book_id: book.id).order(:user_id)
+    assert_equal 4, rows.count
+    assert_equal [ "Handbook" ], rows.map(&:book_title).uniq
+
+    by_user = rows.index_by(&:user_name)
+    assert_equal "editor", by_user[users(:david).name].level
+    assert_equal "editor", by_user[users(:jason).name].level
+    assert_equal "editor", by_user[users(:kevin).name].level
+    assert_equal "reader", by_user[users(:jz).name].level
+
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "revoked access is not archived" do
+    book = books(:handbook)
+    book.accesses.find_by(user: users(:jz)).destroy
+
+    book.destroy!
+
+    names = AccessArchive.where(book_id: book.id).map(&:user_name)
+    assert_not_includes names, users(:jz).name
+    assert_equal 3, names.size
+  end
+
+  test "book with no access archives nothing (app delete)" do
+    book = Book.create!(title: "Orphan", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "book with no access archives nothing (console delete)" do
+    book = Book.create!(title: "Orphan", everyone_access: false)
+
+    assert_no_difference -> { AccessArchive.count } do
+      Book.find(book.id).destroy!
+    end
+
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "nothing is archived before the deletion happens" do
+    book = books(:handbook)
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.valid?
+      book.reload
+    end
+
+    assert_difference -> { AccessArchive.count }, 4 do
+      book.destroy!
+    end
+  end
+
+  test "levels recorded as they stood at deletion time" do
+    book = Book.create!(title: "Levels", everyone_access: false)
+    book.update_access(editors: [ users(:kevin).id ], readers: [ users(:jz).id ])
+
+    book.destroy!
+
+    rows = AccessArchive.where(book_id: book.id).index_by(&:user_name)
+    assert_equal "editor", rows[users(:kevin).name].level
+    assert_equal "reader", rows[users(:jz).name].level
+  end
+
+  test "archives exactly one row per person" do
+    book = books(:handbook)
+    book.destroy!
+
+    rows = AccessArchive.where(book_id: book.id)
+    assert_equal rows.size, rows.map(&:user_id).uniq.size
+  end
+
+  test "access revoked out of band is not archived" do
+    book = books(:handbook)
+    book.accesses.load # warm the association cache
+    Access.find_by(user: users(:jz), book: book).destroy # revoked without the book knowing
+
+    book.destroy!
+
+    names = AccessArchive.where(book_id: book.id).map(&:user_name)
+    assert_not_includes names, users(:jz).name
+    assert_equal 3, names.size
+  end
+end
