diff --git a/db/migrate/20250101000000_create_tenants.rb b/db/migrate/20250101000000_create_tenants.rb
new file mode 100644
index 0000000..2246326
--- /dev/null
+++ b/db/migrate/20250101000000_create_tenants.rb
@@ -0,0 +1,26 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    # Existing installs upgrade in place: every user and book is swept into a
+    # single tenant, so nobody loses access to anything they already had.
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        name = select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").to_s.presence || "Main"
+        now = quote(Time.current)
+
+        execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(name)}, #{now}, #{now})"
+
+        tenant_id = select_value("SELECT id FROM tenants ORDER BY id LIMIT 1")
+        update "UPDATE users SET tenant_id = #{tenant_id}"
+        update "UPDATE books SET tenant_id = #{tenant_id}"
+      end
+    end
+  end
+end
