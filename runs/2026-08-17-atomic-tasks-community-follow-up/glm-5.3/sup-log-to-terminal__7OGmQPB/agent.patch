diff --git a/config/initializers/broadcast_logs_to_stdout.rb b/config/initializers/broadcast_logs_to_stdout.rb
new file mode 100644
index 0000000..1b43854
--- /dev/null
+++ b/config/initializers/broadcast_logs_to_stdout.rb
@@ -0,0 +1,14 @@
+# `rails runner` is used by the runbook (see script/library_report.rb) to print a
+# report on the terminal. Rails only wires the logger up to the environment's
+# log file, so those lines would otherwise be invisible to whoever runs the
+# command. Broadcast them to STDOUT too, mirroring what `rails server` does,
+# while keeping every line in the log file.
+if defined?(Rails::Command::RunnerCommand)
+  console = ActiveSupport::Logger.new(STDOUT)
+  console.formatter = Rails.logger.formatter
+  console.level = Rails.logger.level
+
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+    Rails.logger.broadcast_to(console)
+  end
+end
