@@ -0,0 +1,66 @@
+require "test_helper"
+
+class User::LibraryDigestTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "lists the books the user may open with id, title, and leaf count" do
+    assert_equal [ { id: books(:manual).id, title: "Manual", leaf_count: books(:manual).leaves.count },
+                   { id: books(:handbook).id, title: "Handbook", leaf_count: books(:handbook).leaves.count } ],
+                 users(:david).library_digest
+  end
+
+  test "an overview never shows books the user was not given access to, whoever built theirs first" do
+    david = users(:david)
+    kevin = users(:kevin)
+
+    assert david.books.exists?(books(:manual).id)
+    assert_not kevin.books.exists?(books(:manual).id)
+
+    david.library_digest # warm the cache with somebody else's overview
+
+    assert_equal [ { id: books(:handbook).id, title: "Handbook", leaf_count: books(:handbook).leaves.count } ],
+                  kevin.library_digest
+  end
+
+  test "each user's overview is cached in its own slot" do
+    david, kevin = users(:david), users(:kevin)
+
+    kevin.library_digest
+    david.library_digest
+
+    assert_equal 2, Rails.cache.instance_variable_get(:@data).keys.length
+    assert_equal [ books(:manual).id, books(:handbook).id ].sort, david.library_digest.collect { it[:id] }.sort
+    assert_equal [ books(:handbook).id ], kevin.library_digest.collect { it[:id] }
+  end
+
+  test "asking twice for the same user's overview builds it once" do
+    david = users(:david)
+    digest = david.library_digest
+
+    assert_no_queries { assert_equal digest, david.library_digest }
+  end
+
+  test "a change in who may read what shows up within the hour" do
+    kevin = users(:kevin)
+    secret_book = Book.create!(title: "Secret book", everyone_access: false)
+
+    assert_not_includes kevin.library_digest.collect { it[:id] }, secret_book.id
+
+    secret_book.accesses.create!(user: kevin, level: :reader)
+    accesses(:kevin_handbook).destroy
+
+    travel 1.hour + 1.second
+
+    digest = kevin.library_digest.collect { it[:id] }
+
+    assert_includes digest, secret_book.id
+    assert_not_includes digest, books(:handbook).id
+  end
+end
