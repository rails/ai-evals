diff --git a/test/lib/action_text_markdown_test.rb b/test/lib/action_text_markdown_test.rb
new file mode 100644
index 0000000..42cdcf9
--- /dev/null
+++ b/test/lib/action_text_markdown_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class ActionText::MarkdownTest < ActiveSupport::TestCase
+  include ActionDispatch::TestProcess
+  include ActiveJob::TestHelper
+
+  test "destroying the record purges the uploaded files and their records" do
+    page = Page.create! body: "![A good read](reading.webp)"
+    page.body.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    page.body.uploads.attach fixture_file_upload("white-rabbit.webp", "image/webp")
+    page.save!
+
+    attachments, blobs = page.reload.body.uploads.attachments, page.body.uploads.blobs
+    keys = blobs.map(&:key)
+
+    assert_equal 2, keys.size
+    keys.each { |key| assert blobs.first.service.exist?(key) }
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(id: attachments.map(&:id))
+    assert_not ActiveStorage::Blob.exists?(id: blobs.map(&:id))
+    keys.each { |key| assert_not blobs.first.service.exist?(key) }
+  end
+
+  test "destroying the record leaves uploads attached to other records alone" do
+    sharing_page, keeping_page = Page.create!(body: "Sharing"), Page.create!(body: "Keeping")
+
+    sharing_page.body.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    sharing_page.save!
+    blob = sharing_page.reload.body.uploads.attachments.first.blob
+
+    keeping_page.body.uploads.attach blob
+    keeping_page.save!
+
+    perform_enqueued_jobs do
+      sharing_page.destroy!
+    end
+
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert blob.service.exist?(blob.key)
+    assert keeping_page.reload.body.uploads.attachments.one?
+  end
+end
