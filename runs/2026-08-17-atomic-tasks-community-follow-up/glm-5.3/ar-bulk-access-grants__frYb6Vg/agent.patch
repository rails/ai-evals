@@ -6,20 +6,49 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    # Turn the whole sheet down before anything is written, so nobody is told
+    # about access they never got.
+    return Result.new([], rejected_index) if rejected_index
 
+    accesses = []
     Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
-      end
+      inserted = @book.accesses.insert_all!(rows, returning: [ :id ])
+      ids = inserted.map { |row| row["id"] }
+      accesses = Access.where(id: ids).index_by(&:id).values_at(*ids).compact
+      accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    Result.new(accesses, nil)
   end
+
+  private
+    def rows
+      @grants.map { |grant| grant.slice(:user_id, :level) }
+    end
+
+    # The first row that keeps the sheet from being taken, whether because it
+    # names a level nobody has heard of or because the access exists already.
+    def rejected_index
+      [ unknown_level_index, duplicate_index ].compact.min
+    end
+
+    def unknown_level_index
+      @grants.index { |grant| !valid_level?(grant[:level]) }
+    end
+
+    def duplicate_index
+      granted = existing_user_ids
+      @grants.index { |grant| !granted.add?(grant[:user_id]) }
+    end
+
+    def existing_user_ids
+      @book.accesses.where(user_id: @grants.pluck(:user_id)).pluck(:user_id).to_set
+    end
+
+    def valid_level?(level)
+      Access.type_for_attribute(:level).assert_valid_value(level)
+      true
+    rescue ArgumentError
+      false
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..405f501
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "My new book", everyone_access: false)
+    @roster = 24.times.collect { |i|
+      User.create!(name: "Person #{i} #{SecureRandom.hex(4)}", email_address: "person#{i}-#{SecureRandom.hex(4)}@example.com", password: "secret123456")
+    }
+  end
+
+  test "imports a roster and notifies each person" do
+    assert_enqueued_jobs 2 do
+      @result = Book::AccessImport.new(@book, [
+        { user_id: users(:david).id, level: "reader" },
+        { user_id: users(:jason).id, level: "editor" }
+      ]).import
+    end
+
+    assert_equal %w[ reader editor ], @result.accesses.map(&:level)
+    assert_equal [ users(:david).id, users(:jason).id ], @result.accesses.map(&:user_id)
+    assert @result.accesses.all?(&:persisted?)
+    assert_nil @result.duplicate_index
+    assert_equal 2, @book.accesses.count
+  end
+
+  test "sixteen names cost what four do when the sheet is taken" do
+    grants = @roster.map { |user| { user_id: user.id, level: "reader" } }
+    queries = [ 4, 8, 16 ].index_with do |size|
+      book = Book.create!(title: "Book of #{size}", everyone_access: false)
+      count_queries { Book::AccessImport.new(book, grants.first(size)).import }
+    end
+
+    assert_equal 1, queries.values.uniq.size, queries.inspect
+  end
+
+  test "sixteen names cost what four do when the sheet is turned down" do
+    queries = [ 4, 16 ].index_with do |size|
+      book = Book.create!(title: "Book of #{size}", everyone_access: false)
+      book.accesses.create!(user: @roster.first, level: "reader")
+      grants = grants_for(book, size)
+
+      count_queries { Book::AccessImport.new(book, grants).import }
+    end
+
+    assert_equal 1, queries.values.uniq.size, queries.inspect
+  end
+
+  test "a turned down roster notifies nobody about access they never got" do
+    @book.accesses.create!(user: users(:kevin), level: "reader")
+    grants = (@roster + [ users(:kevin) ]).map { |user| { user_id: user.id, level: "reader" } }
+
+    assert_enqueued_jobs 0 do
+      @result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal @roster.size, @result.duplicate_index
+    assert_equal [], @result.accesses
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "turns down a sheet naming a level nobody has heard of" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:jason).id, level: "wizard" },
+      { user_id: users(:jz).id, level: "editor" }
+    ]
+
+    assert_enqueued_jobs 0 do
+      @result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, @result.duplicate_index
+    assert_equal [], @result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "turns down a roster repeated within itself" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    assert_enqueued_jobs 0 do
+      @result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, @result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "imports an empty roster" do
+    @result = Book::AccessImport.new(@book, []).import
+
+    assert_equal [], @result.accesses
+    assert_nil @result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  private
+    # A sheet of `size` names where the last one has access already.
+    def grants_for(book, size)
+      user_ids = (User.ids - [ book.accesses.pluck(:user_id) ]).first(size - 1)
+      user_ids.collect { |id| { user_id: id, level: "reader" } } + book.accesses.collect { |access| { user_id: access.user_id, level: "reader" } }
+    end
+
+    def count_queries(&block)
+      count = 0
+      callback = ->(*, payload) { count += 1 unless payload[:name] == "SCHEMA" }
+      ActiveSupport::Notifications.subscribed(callback, "sql.active_record", &block)
+      count
+    end
+end
