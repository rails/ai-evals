diff --git a/test/channels/being_edited_channel_test.rb b/test/channels/being_edited_channel_test.rb
new file mode 100644
index 0000000..e1c17fe
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  test "subscribes an editor of the leaf's book" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+
+    assert subscription.confirmed?
+    assert_has_stream stream_name_for(leaves(:welcome_page))
+  end
+
+  test "subscribes an administrator without an explicit access" do
+    stub_connection current_user: users(:david)
+
+    books(:handbook).accesses.where(user: users(:david)).delete_all
+
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+
+    assert subscription.confirmed?
+  end
+
+  test "rejects a user who is only a reader of the leaf's book" do
+    stub_connection current_user: users(:jz)
+
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects a collaborator who has been removed from the book" do
+    books(:handbook).update_access(editors: [], readers: [])
+    books(:handbook).accesses.where(user: users(:kevin)).delete_all
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "rejects a tampered stream name" do
+    stub_connection current_user: users(:kevin)
+
+    subscribe signed_stream_name: "not-a-signed-name"
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "delivers the being edited indicator to a subscriber" do
+    stub_connection current_user: users(:jason)
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+    assert subscription.confirmed?
+
+    broadcast_being_edited_indicator
+
+    assert_broadcasts_text stream_name_for(leaves(:welcome_page)), users(:kevin).name
+  end
+
+  private
+    def broadcast_being_edited_indicator
+      Turbo::StreamsChannel.broadcast_render_to leaves(:welcome_page), :being_edited,
+        partial: "leaves/being_edited_by", locals: { leaf: leaves(:welcome_page), user: users(:kevin) }
+    end
+
+    def assert_broadcasts_text(stream_name, text)
+      assert broadcasts(stream_name).any? { |broadcast| broadcast.include?(text) },
+        "expected #{stream_name.inspect} to broadcast #{text.inspect}"
+    end
+
+    def signed_stream_name_for(leaf)
+      Turbo::StreamsChannel.signed_stream_name([leaf, :being_edited])
+    end
+
+    def stream_name_for(leaf)
+      [ leaf.to_gid_param, :being_edited ].join(":")
+    end
+end
diff --git a/test/channels/removed_collaborator_test.rb b/test/channels/removed_collaborator_test.rb
new file mode 100644
index 0000000..6cf0e9d
--- /dev/null
+++ b/test/channels/removed_collaborator_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+# A collaborator removed from a book may still have the editor open, subscribed to
+# the being-edited stream they signed up for while they had access. That
+# subscription must not keep delivering who is editing.
+class RemovedCollaboratorTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  test "a subscription taken while an editor stops delivering after removal" do
+    stub_connection current_user: users(:kevin)
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+    assert subscription.confirmed?
+
+    books(:handbook).update_access(editors: [ users(:jason).id ], readers: [])
+
+    subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+
+    assert subscription.rejected?
+    assert_no_streams
+  end
+
+  test "the indicator keeps flowing to remaining editors" do
+    [ users(:kevin), users(:jason) ].each do |user|
+      stub_connection current_user: user
+      subscribe signed_stream_name: signed_stream_name_for(leaves(:welcome_page))
+      assert subscription.confirmed?, "expected #{user.name} to subscribe"
+    end
+
+    books(:handbook).update_access(editors: [ users(:jason).id ], readers: [])
+    stream = stream_name_for(leaves(:welcome_page))
+
+    Turbo::StreamsChannel.broadcast_render_to leaves(:welcome_page), :being_edited,
+      partial: "leaves/being_edited_by", locals: { leaf: leaves(:welcome_page), user: users(:jason) }
+
+    assert broadcasts(stream).any? { it.include? users(:jason).name }
+  end
+
+  private
+    def signed_stream_name_for(leaf)
+      Turbo::StreamsChannel.signed_stream_name([leaf, :being_edited])
+    end
+
+    def stream_name_for(leaf)
+      [ leaf.to_gid_param, :being_edited ].join(":")
+    end
+end
