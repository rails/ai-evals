diff --git a/app/channels/being_edited_channel.rb b/app/channels/being_edited_channel.rb
new file mode 100644
index 0000000..63de30c
--- /dev/null
+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,29 @@
+# The being-edited indicator discloses who is currently editing a leaf, so it must
+# only be delivered on a channel that users who can no longer edit the leaf's
+# book are barred from. Rejecting the subscription here means a collaborator who
+# was removed from the book stops receiving being-edited payloads as soon as
+# ActionCable processes the rejection, even with an editor left open.
+class BeingEditedChannel < Turbo::StreamsChannel
+  def subscribed
+    if (stream_name = verified_stream_name_from_params) && streamables_editable?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+    def streamables_editable?(stream_name)
+      streamables = streamables_in(stream_name).select { it.respond_to? :editable? }
+
+      streamables.present? && streamables.all? { it.editable? user: current_user }
+    end
+
+    # Recovers the records the signed stream name was generated from, so that
+    # authorization is derived from the signed name instead of client params.
+    # A name like "Z2lkOi8vd3JpdGVib29rL0xlYWYvMQ:being_edited" splits on the
+    # colons separating streamables, not those inside the encoded gid.
+    def streamables_in(stream_name)
+      stream_name.to_s.split(/:(?!\/\/)/).filter_map { GlobalID::Locator.locate _1 rescue nil }
+    end
+end
diff --git a/app/helpers/being_edited_helper.rb b/app/helpers/being_edited_helper.rb
new file mode 100644
index 0000000..e0da356
--- /dev/null
+++ b/app/helpers/being_edited_helper.rb
@@ -0,0 +1,7 @@
+module BeingEditedHelper
+  # Subscribe to the being-edited stream over a channel that bars users who are
+  # no longer allowed to edit the leaf's book.
+  def being_edited_stream_from(leaf)
+    turbo_stream_from leaf, :being_edited, channel: "BeingEditedChannel"
+  end
+end
