diff --git a/test/integration/pentest_findings_test.rb b/test/integration/pentest_findings_test.rb
new file mode 100644
index 0000000..6b52eeb
--- /dev/null
+++ b/test/integration/pentest_findings_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class PentestFindingsTest < ActionDispatch::IntegrationTest
+  setup { Leaf.reindex_all }
+
+  # PT-01: member cannot escalate own role via profile update
+  test "PT-01 member cannot grant self a role via profile" do
+    sign_in :kevin
+    patch user_profile_url(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "PT-01 member still can change own name/email/password" do
+    sign_in :kevin
+    patch user_profile_url(users(:kevin)), params: { user: { name: "Kevin Renamed" } }
+    assert_equal "Kevin Renamed", users(:kevin).reload.name
+  end
+
+  test "PT-01 admin still changes roles" do
+    sign_in :david
+    patch user_url(users(:kevin)), params: { user: { role: "administrator" } }
+    assert users(:kevin).reload.administrator?
+  end
+
+  # PT-02: reader cannot delete a book
+  test "PT-02 reader cannot delete a book" do
+    sign_in :jz # reader on handbook
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02 published book cannot be deleted by signed-in non-editor" do
+    books(:manual).update!(published: true)
+    sign_in :kevin # no access to manual
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:manual))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02 editor can still delete a book" do
+    sign_in :david
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+  end
+
+  # PT-03: injection & apostrophe
+  test "PT-03 library search does not leak unreadable books via injection" do
+    sign_in :kevin # only handbook
+    get library_search_url(q: "%' OR '1'='1")
+    assert_response :success
+    # manual leaves must not appear
+    assert_select "a", text: /Manual:/, count: 0
+  end
+
+  test "PT-03 apostrophe returns results not error" do
+    sign_in :david
+    get library_search_url(q: "Kevin's")
+    assert_response :success
+  end
+
+  test "PT-03 ordinary search still works" do
+    sign_in :david
+    get library_search_url(q: "Welcome")
+    assert_response :success
+    assert_select "a", text: /Welcome to The Handbook/
+  end
+
+  test "PT-03 only readable books returned" do
+    sign_in :kevin # only handbook
+    get library_search_url(q: "Summary")
+    assert_response :success
+    # summary is in handbook (readable) => appears
+    assert_select "a", text: /Summary/
+  end
+
+  # PT-04: percent/underscore treated literally
+  test "PT-04 percent title findable by title and by percent" do
+    leaf = books(:handbook).leaves.create!(title: "Save 50% off", leafable: Page.new(body: "content"))
+    sign_in :david
+
+    get library_search_url(q: "Save 50% off")
+    assert_response :success
+    assert_select "a", text: /Save 50% off/
+
+    get library_search_url(q: "%")
+    assert_response :success
+    assert_select "a", text: /Save 50% off/
+  end
+
+  test "PT-04 percent does not pull pages without it" do
+    sign_in :david
+    get library_search_url(q: "%")
+    assert_response :success
+    assert_select "a", text: /Welcome to The Handbook/, count: 0
+  end
+
+  test "PT-04 underscore matched literally" do
+    books(:handbook).leaves.create!(title: "hello_world", leafable: Page.new(body: "c"))
+    sign_in :david
+    get library_search_url(q: "hello_world")
+    assert_response :success
+    assert_select "a", text: /hello_world/
+    # underscore should not match "helloXworld"
+    get library_search_url(q: "hello_")
+    assert_select "a", text: /Welcome/, count: 0
+  end
+
+  # PT-05: IDOR - leaf from another book under wrong book id
+  test "PT-05 leaf of unreadable book not renderable under readable book id" do
+    manual_leaf = books(:manual).leaves.create!(title: "Secret", leafable: Page.new(body: "top secret"))
+    sign_in :kevin # readable: handbook only, not manual
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{manual_leaf.id}/#{manual_leaf.slug}"
+    assert_response :not_found
+  end
+
+  test "PT-05 readable leaf still readable" do
+    sign_in :kevin
+    leaf = leaves(:welcome_page)
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{leaf.id}/#{leaf.slug}"
+    assert_response :success
+  end
+
+  test "PT-05 published leaf readable when signed out" do
+    books(:handbook).update!(published: true)
+    leaf = leaves(:welcome_page)
+    get "/#{books(:handbook).id}/#{books(:handbook).slug}/#{leaf.id}/#{leaf.slug}"
+    assert_response :success
+  end
+end
