+require "test_helper"
+
+class EditPageIndicatorRenderTest < ActionDispatch::IntegrationTest
+  setup { sign_in :kevin }
+
+  test "edit page renders being-edited indicator subscribed on BeingEditedChannel" do
+    leaf = leaves(:welcome_page)
+    get edit_leafable_url(leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source[channel=?]", "BeingEditedChannel"
+  end
+end
