diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..5e161b9 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,31 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :note_publication_change, if: :saved_change_to_published?
+    after_commit :announce_publication, if: :publication_noted?
+    after_rollback :clear_publication_note
   end
 
   private
+    # Remember when a save takes the book live, regardless of what else the
+    # transaction (sitting) does afterwards. A later touch (e.g. adding a page)
+    # would otherwise clear `saved_change_to_published?`, so we latch it here.
+    # If a subsequent save flips it back to draft, the note follows suit.
+    def note_publication_change
+      @publication_noted = published?
+    end
+
+    def publication_noted?
+      @publication_noted == true
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+    ensure
+      @publication_noted = nil
+    end
+
+    def clear_publication_note
+      @publication_noted = nil
     end
 end
