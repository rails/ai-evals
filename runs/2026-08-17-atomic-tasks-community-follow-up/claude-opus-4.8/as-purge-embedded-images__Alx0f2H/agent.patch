@@ -0,0 +1,72 @@
+require "test_helper"
+
+class PageImageCleanupTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActiveSupport::Testing::FileFixtures
+  include ActionDispatch::TestProcess::FixtureFile
+
+  test "destroying a page with an embedded image removes the blob, attachment, and file" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    markdown.save!
+
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    service = blob.service
+    key = blob.key
+
+    assert service.exist?(key), "file should exist after upload"
+
+    leaf = page.leaf
+
+    perform_enqueued_jobs do
+      leaf.destroy
+    end
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id), "attachment record should be gone"
+    assert_not ActiveStorage::Blob.exists?(blob.id), "blob record should be gone"
+    assert_not service.exist?(key), "file should be removed from disk"
+    assert_not ActionText::Markdown.exists?(markdown.id), "markdown record should be gone"
+  end
+
+  test "destroying page directly purges embedded image" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach fixture_file_upload("white-rabbit.webp", "image/webp")
+    markdown.save!
+    attachment = markdown.uploads.attachments.last
+    blob = attachment.blob
+    key = blob.key
+    service = blob.service
+
+    perform_enqueued_jobs do
+      page.destroy
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(key)
+  end
+
+  test "shared blob across revisions is not deleted while still referenced" do
+    page = pages(:welcome)
+    markdown = page.body
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+    markdown.save!
+    blob = markdown.uploads.attachments.last.blob
+    key = blob.key
+    service = blob.service
+
+    # simulate a second attachment to the same blob (as revision duping does)
+    other = Page.create!(body: "other")
+    other.body.uploads.attach blob
+    other.body.save!
+
+    perform_enqueued_jobs do
+      page.destroy
+    end
+
+    assert service.exist?(key), "shared blob file must survive while still referenced"
+    assert ActiveStorage::Blob.exists?(blob.id)
+  end
+end
