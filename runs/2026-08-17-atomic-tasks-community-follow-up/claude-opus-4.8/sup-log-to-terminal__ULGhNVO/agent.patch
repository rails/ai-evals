diff --git a/config/initializers/runner_log_to_stdout.rb b/config/initializers/runner_log_to_stdout.rb
new file mode 100644
index 0000000..8a1f271
--- /dev/null
+++ b/config/initializers/runner_log_to_stdout.rb
@@ -0,0 +1,27 @@
+# The import runbook signs off against `script/library_report.rb`, run via
+#
+#     bin/rails runner -e <env> script/library_report.rb
+#
+# The script reports through `Rails.logger`, so its lines land in the
+# environment's log file (e.g. log/development.log) where our log tooling
+# reads them -- but nothing shows up on the on-call's terminal, so the report
+# looked dead.
+#
+# When (and only when) the `runner` command is used, also broadcast the
+# application's log to STDOUT. The record in the log file is kept untouched;
+# we simply add a second sink so every logged line is echoed to the terminal
+# with the exact same formatting, wording, severity and order.
+Rails.application.runner do
+  logger = Rails.logger
+  next unless logger.respond_to?(:broadcast_to)
+
+  stdout_logger = ActiveSupport::Logger.new($stdout)
+  # Match the log level and formatting of the existing sink(s) so the echoed
+  # lines are identical to what is written to the log file.
+  stdout_logger.level = logger.level
+  if (sink = Array(logger.broadcasts).first)
+    stdout_logger.formatter = sink.formatter if sink.respond_to?(:formatter) && sink.formatter
+  end
+
+  logger.broadcast_to(stdout_logger)
+end
