diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..4090575 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -71,4 +71,21 @@ Rails.application.configure do
 
   # Apply autocorrection by RuboCop to files generated by `bin/rails generate`.
   config.generators.apply_rubocop_autocorrect_after_generate!
+
+  # The import runbook's final step is:
+  #   bin/rails runner -e development script/library_report.rb
+  # and the on-call reads the report straight off the terminal to sign the
+  # import off. Rails' development logger only writes to log/development.log,
+  # so the report never showed up on screen and the step looked dead.
+  #
+  # Broadcast the development log to STDOUT in addition to the log file: every
+  # line is still recorded in log/development.log (which our log tooling
+  # reads), and the exact same lines - same wording, same severities, same
+  # order - now also appear on the terminal.
+  config.after_initialize do
+    console_logger = ActiveSupport::Logger.new($stdout)
+    console_logger.formatter = Rails.logger.formatter
+    console_logger.level = Rails.logger.level
+    Rails.logger.broadcast_to(console_logger)
+  end
 end
