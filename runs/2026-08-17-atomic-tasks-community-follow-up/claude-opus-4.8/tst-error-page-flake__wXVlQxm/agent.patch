diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..c0753cf 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,24 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Make controller errors surface as raised exceptions inside the block, while
+    # leaving error-page rendering intact for every other test in the process.
+    #
+    # The request pipeline reads `show_exceptions` from the application's
+    # `env_config`, which Rails memoizes the first time a request is built. That
+    # means mutating `config.action_dispatch.show_exceptions` after the first
+    # request has no effect, and mutating it before the first request bakes the
+    # value into the memoized env_config permanently. Either way the setting
+    # leaks across tests and depends on execution order. To keep the promise
+    # regardless of what ran before or after, we set the value directly on the
+    # (already-forced) memoized env_config and restore it afterwards.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
