+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, null: true, foreign_key: true
+    add_reference :books, :tenant, null: true, foreign_key: true
+
+    if User.any? || Book.any?
+      tenant_id = execute_insert_default_tenant
+      execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+
+  private
+    def execute_insert_default_tenant
+      now = connection.quote(Time.current)
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES ('Default', #{now}, #{now})"
+      select_value("SELECT MAX(id) FROM tenants")
+    end
+end
