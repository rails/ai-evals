diff --git a/test/controllers/books_toc_cache_test.rb b/test/controllers/books_toc_cache_test.rb
new file mode 100644
index 0000000..9e1eef7
--- /dev/null
+++ b/test/controllers/books_toc_cache_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class BooksTocCacheTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    store = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache = store
+    ActionView::PartialRenderer.collection_cache = store
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.cache = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader does not get editor controls even after an editor viewed the book" do
+    # Editor views first, priming the collection cache.
+    sign_in :kevin # editor on handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page))
+
+    sign_out
+
+    # Reader views next.
+    sign_in :jz # reader on handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0,
+      message: "Reader should never see editor edit links"
+  end
+
+  test "editor keeps editor controls even after a reader viewed the book" do
+    # Reader views first, priming the collection cache.
+    sign_in :jz # reader on handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    sign_out
+
+    # Editor views next.
+    sign_in :kevin # editor on handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "a[href=?]", edit_leafable_path(leaves(:welcome_page)),
+      message: "Editor should always see editor edit links"
+  end
+
+  test "renamed entry shows its new title to the next viewer" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    leaves(:welcome_page).update!(title: "A Brand New Title")
+
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select ".toc__title", text: /A Brand New Title/
+  end
+end
diff --git a/test/controllers/books_toc_perf_test.rb b/test/controllers/books_toc_perf_test.rb
new file mode 100644
index 0000000..a435ccc
--- /dev/null
+++ b/test/controllers/books_toc_perf_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class BooksTocPerfTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    store = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache = store
+    ActionView::PartialRenderer.collection_cache = store
+
+    @book = books(:handbook)
+    # Add many entries so any per-entry cost would show up.
+    50.times do |i|
+      page = Page.create!(body: "Body #{i}")
+      @book.leaves.create!(title: "Extra #{i}", leafable: page, position_score: 100 + i, status: :active)
+    end
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.cache = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  def access_queries_for
+    queries = []
+    sub = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      sql = payload[:sql]
+      queries << sql if sql =~ /FROM ["`]?accesses/i
+    end
+    yield
+  ensure
+    ActiveSupport::Notifications.unsubscribe(sub)
+    queries
+  end
+
+  test "editable is not looked up per entry on a warm cache" do
+    sign_in :kevin
+    get book_slug_url(@book) # prime
+    assert_response :success
+
+    q = access_queries_for { get book_slug_url(@book) }
+    assert_response :success
+    # On a warm cache we must not query accesses once per leaf (would be ~50+).
+    # A small constant number of top-level editable? checks is fine.
+    assert q.size <= 10, "Expected a bounded number of accesses lookups, got #{q.size}"
+  end
+end
diff --git a/test/models/book_access_memo_test.rb b/test/models/book_access_memo_test.rb
new file mode 100644
index 0000000..483f7b7
--- /dev/null
+++ b/test/models/book_access_memo_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class BookAccessMemoTest < ActiveSupport::TestCase
+  test "editable? reflects access changes after update_access" do
+    book = books(:handbook)
+    kevin = users(:kevin)
+
+    assert book.editable?(user: kevin)
+
+    # Demote kevin to reader on the same instance.
+    book.update_access(editors: [ users(:david).id ], readers: [ kevin.id ])
+    assert_not book.editable?(user: kevin), "memo must be busted after update_access"
+  end
+
+  test "editable? reflects access changes after reload" do
+    book = books(:handbook)
+    kevin = users(:kevin)
+
+    assert book.editable?(user: kevin)
+
+    Access.where(book: book, user: kevin).update_all(level: :reader)
+    book.reload
+    assert_not book.editable?(user: kevin), "memo must be busted after reload"
+  end
+
+  test "different users are cached independently" do
+    book = books(:handbook)
+    assert book.editable?(user: users(:kevin))   # editor
+    assert_not book.editable?(user: users(:jz))   # reader
+    assert book.editable?(user: users(:kevin))   # still editor
+  end
+end
