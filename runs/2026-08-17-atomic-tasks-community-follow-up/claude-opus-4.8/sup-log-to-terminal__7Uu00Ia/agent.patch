diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..4953b62 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -27,6 +27,18 @@ module Writebook
     # config.time_zone = "Central Time (US & Canada)"
     # config.eager_load_paths << Rails.root.join("extras")
 
+    # `bin/rails runner` (the last step of the import runbook) prints nothing
+    # to the terminal because `Rails.logger` only writes to the environment's
+    # log file. Broadcast the same log entries to STDOUT while the runner is
+    # active so the on-call sees the report, without dropping the log file
+    # record that our log tooling reads. Same lines, severities and order.
+    runner do
+      console_logger = ActiveSupport::Logger.new($stdout)
+      console_logger.level = Rails.logger.level
+      console_logger.formatter = Rails.logger.formatter
+      Rails.logger.broadcast_to(console_logger)
+    end
+
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
   end
