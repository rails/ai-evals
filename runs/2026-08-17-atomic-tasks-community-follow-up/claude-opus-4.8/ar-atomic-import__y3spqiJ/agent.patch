diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..c246f3f 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -6,7 +6,16 @@ module Batched
     # lands or none of it does. The manifest importer goes through here so
     # that a rejected manifest leaves the book exactly as it was before the
     # attempt.
+    #
+    # The batch gets its own savepoint (requires_new: true) so that a
+    # rejection rolls back only this batch — never any enclosing transaction,
+    # such as the nightly bulk importer's — leaving the rest of that work
+    # intact. A rejection is signalled by raising Book::Import::Rejected,
+    # which aborts the batch and is swallowed here so the caller can report
+    # failure without the exception escaping.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
+    rescue Book::Import::Rejected => error
+      Rails.logger.warn error.message
     end
 end
