diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..28365a4
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  # PT-03: SQL injection / apostrophe handling in /search
+  test "PT-03 apostrophe in the term returns results, not a server error" do
+    sign_in :david
+    get library_search_url(q: "O'Brien")
+    assert_response :success
+  end
+
+  test "PT-03 injection attempt cannot leak leaves from unreadable books" do
+    # kevin can only read handbook. Put a secret leaf in manual.
+    manual = books(:manual)
+    secret = manual.press(Section.create!(body: "Secret"), title: "TopSecret")
+
+    sign_in :kevin
+    # classic injection payload attempting to break out of the where clause
+    get library_search_url(q: "%' OR 1=1 --")
+    assert_response :success
+    assert_not response.body.include?("TopSecret"),
+      "search must not leak leaves from books the searcher cannot read"
+  end
+
+  test "PT-03 ordinary searches still find matching leaves" do
+    sign_in :david
+    get library_search_url(q: "Welcome")
+    assert_response :success
+    assert response.body.include?("Welcome to The Handbook!")
+  end
+
+  # PT-04: percent / underscore treated as literals, not wildcards
+  test "PT-04 percent sign is literal in the search term" do
+    handbook = books(:handbook)
+    save_leaf = handbook.press(Section.create!(body: "x"), title: "Save 50% off")
+
+    sign_in :david
+
+    # findable by its title
+    get library_search_url(q: "Save 50% off")
+    assert response.body.include?("Save 50% off")
+
+    # findable by the percent sign alone
+    get library_search_url(q: "%")
+    assert response.body.include?("Save 50% off")
+
+    # the percent sign must not pull in pages without it
+    get library_search_url(q: "%")
+    assert_not response.body.include?("Welcome to The Handbook!"),
+      "percent must not act as a wildcard matching every leaf"
+  end
+
+  test "PT-04 underscore is literal in the search term" do
+    handbook = books(:handbook)
+    under = handbook.press(Section.create!(body: "x"), title: "under_score title")
+
+    sign_in :david
+
+    get library_search_url(q: "under_score")
+    assert response.body.include?("under_score title")
+
+    # underscore must not act as single-char wildcard
+    get library_search_url(q: "Welcom_")
+    assert_not response.body.include?("Welcome to The Handbook!"),
+      "underscore must not act as a wildcard"
+  end
+end
diff --git a/test/integration/pentest_fixes_test.rb b/test/integration/pentest_fixes_test.rb
new file mode 100644
index 0000000..79a51fc
--- /dev/null
+++ b/test/integration/pentest_fixes_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class PentestFixesTest < ActionDispatch::IntegrationTest
+  # PT-01: member cannot escalate their own role
+  test "PT-01 member cannot grant themselves administrator via profile update" do
+    sign_in :kevin
+    kevin = users(:kevin)
+    patch user_profile_url(user_id: kevin.id), params: { user: { name: "Kevin New", role: "administrator" } }
+    assert_not kevin.reload.administrator?
+    assert_equal "Kevin New", kevin.name
+  end
+
+  test "PT-01 administrator can still change roles" do
+    sign_in :david
+    kevin = users(:kevin)
+    patch user_url(kevin), params: { user: { role: "administrator" } }
+    assert kevin.reload.administrator?
+  end
+
+  # PT-02: reader cannot destroy a book
+  test "PT-02 reader cannot delete a book they can only read" do
+    sign_in :jz # reader on handbook
+    book = books(:handbook)
+    assert_no_difference -> { Book.count } do
+      delete book_url(book)
+    end
+    assert_response :forbidden
+  end
+
+  test "PT-02 editor can still delete a book" do
+    sign_in :david # editor on handbook
+    book = books(:handbook)
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(book)
+    end
+  end
+
+  # PT-05: cannot read a leaf of an inaccessible book via another book's id
+  test "PT-05 leaf must belong to the book in the url" do
+    sign_in :kevin # kevin is editor on handbook only, no access to manual
+    handbook = books(:handbook)
+    manual_leaf = books(:manual).press(Section.create!(body: "Secret"), title: "Secret Section")
+    get slugged_leafable_url(book_id: handbook.id, book_slug: handbook.slug,
+                             id: manual_leaf.id, slug: manual_leaf.slug)
+    assert_response :not_found
+  end
+
+  test "PT-05 leaf of readable book stays readable" do
+    sign_in :kevin
+    handbook = books(:handbook)
+    leaf = handbook.leaves.active.first
+    get slugged_leafable_url(book_id: handbook.id, book_slug: handbook.slug,
+                             id: leaf.id, slug: leaf.slug)
+    assert_response :success
+  end
+end
