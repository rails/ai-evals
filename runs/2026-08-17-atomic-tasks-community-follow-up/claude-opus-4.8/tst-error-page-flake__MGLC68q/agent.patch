diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..cd4f128 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -14,10 +14,28 @@ module ActiveSupport
 
     def with_raised_exceptions
       previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      set_show_exceptions :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      set_show_exceptions previous
     end
+
+    private
+      # `Rails.application.env_config` memoizes the Rack env hash the first time a
+      # request is served in the process, capturing the value of
+      # `config.action_dispatch.show_exceptions` at that moment. Since tests run
+      # in parallel and each worker process reuses that memoized value across
+      # tests, simply reassigning the config has no effect on later requests:
+      # whichever test issues the first request "locks in" the setting for the
+      # whole worker. That's what made the suite flaky -- the outcome depended on
+      # which test happened to run first in each worker.
+      #
+      # Clearing the memoized env config forces it to be rebuilt from the current
+      # setting, so the toggle reliably reaches the ShowExceptions middleware both
+      # when entering and when leaving the block, regardless of run order.
+      def set_show_exceptions(value)
+        Rails.application.config.action_dispatch.show_exceptions = value
+        Rails.application.instance_variable_set(:@app_env_config, nil)
+      end
   end
 end
