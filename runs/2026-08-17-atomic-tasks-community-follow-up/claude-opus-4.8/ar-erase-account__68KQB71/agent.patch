diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..037431e
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,57 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@)/
+
+  # Permanently and irreversibly erase this user, satisfying a GDPR erasure
+  # request. Nothing of theirs is left anywhere afterwards:
+  #
+  #   * the user row itself
+  #   * their sessions and the sign-in log entries recorded under every email
+  #     address they ever signed in with (including the original address of a
+  #     user who was previously "removed" the old way, i.e. deactivated with a
+  #     rewritten `...-deactivated-<uuid>@...` email)
+  #   * their book accesses and reading marks
+  #   * the books they created, along with those books' leaves and search hits
+  #
+  # The single exception is a book they created that is shared with everyone:
+  # people are reading it, so it keeps working. We only strip their identity
+  # from it -- the creator link is removed and the byline becomes
+  # "Deleted author".
+  def erase
+    transaction do
+      hand_off_shared_books
+      created_books.reload.destroy_all
+      # Drop sessions without their sign-out auditing so we don't write fresh
+      # sign-in log rows on the way out.
+      sessions.delete_all
+      destroy!
+      erase_sign_in_events
+    end
+  end
+
+  private
+    def erase_sign_in_events
+      erasable_email_addresses.each do |address|
+        SignInEvent.for_address(address).delete_all
+      end
+    end
+
+    # Every address this user's sign-in events could be filed under: the
+    # address they currently have, plus -- if they were deactivated the old
+    # way -- the original address they actually signed in with before the
+    # email was rewritten.
+    def erasable_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_PATTERN, "") if email_address&.match?(DEACTIVATED_EMAIL_PATTERN)
+    end
+
+    def hand_off_shared_books
+      created_books.where(everyone_access: true).find_each do |book|
+        book.update_columns(creator_id: nil, author: "Deleted author")
+      end
+    end
+end
diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..9533edc 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -78,4 +78,29 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     delete user_url(users(:david))
     assert_response :forbidden
   end
+
+  test "destroy erases a previously deactivated user" do
+    sign_in :david
+
+    kevin = users(:kevin)
+    kevin.deactivate
+    assert_not User.active.exists?(kevin.id)
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(kevin)
+    end
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: kevin.id)
+  end
+
+  test "destroy fully removes the user row and their data" do
+    sign_in :david
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(users(:kevin))
+    end
+
+    assert_nil User.find_by(id: users(:kevin).id)
+  end
 end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..d7b91de
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  test "erasing a user removes everything but keeps everyone-books" do
+    alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+
+    # A book shared with everyone (should survive, bylined "Deleted author")
+    everyone_book = Book.create!(title: "Public Book", author: "Alice", everyone_access: true, creator: alice)
+    # A private book (should be destroyed with everyone else's access)
+    private_book = Book.create!(title: "Private Book", author: "Alice", everyone_access: false, creator: alice)
+
+    # A leaf in each, indexed for search
+    epage = Page.new
+    eleaf = everyone_book.press(epage, { title: "Alice Secret Page" })
+    ppage = Page.new
+    pleaf = private_book.press(ppage, { title: "Alice Private Page" })
+
+    # reading marks + access + session + sign-in events under original email
+    ReadingMark.remember(eleaf, user: alice)
+    private_book.accesses.create!(user: alice, level: :editor) rescue nil
+    session = alice.sessions.start!(user_agent: "x", ip_address: "1.2.3.4")
+    # simulate sign-in event under the original email
+    assert SignInEvent.for_address("alice@example.com").exists?
+
+    private_leaf_id = pleaf.id
+    everyone_leaf_id = eleaf.id
+    alice_id = alice.id
+
+    alice.erase
+
+    # user gone
+    assert_nil User.find_by(id: alice_id), "user row should be gone"
+    # sessions gone
+    assert_equal 0, Session.where(user_id: alice_id).count
+    # reading marks gone
+    assert_equal 0, ReadingMark.where(user_id: alice_id).count
+    # accesses gone
+    assert_equal 0, Access.where(user_id: alice_id).count
+    # sign in events gone (under original email)
+    assert_equal 0, SignInEvent.for_address("alice@example.com").count, "sign-in events under original email should be gone"
+    # private book destroyed
+    assert_nil Book.find_by(id: private_book.id), "private book should be destroyed"
+    assert_nil Leaf.find_by(id: private_leaf_id)
+    # private leaf search hit gone
+    assert_equal 0, Leaf.search("Private").to_a.size, "stale search hit for private book"
+    # everyone book kept, but creator nulled, author bylined
+    kept = Book.find_by(id: everyone_book.id)
+    assert kept, "everyone book should survive"
+    assert_nil kept.creator_id, "creator should be nulled"
+    assert_equal "Deleted author", kept.author
+    assert Leaf.find_by(id: everyone_leaf_id), "everyone leaf still there"
+    assert_equal 1, Leaf.search("Secret").to_a.size, "everyone book still searchable"
+  end
+
+  test "erasing a previously-deactivated user removes original-email sign-in events" do
+    bob = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456")
+    session = bob.sessions.start!(user_agent: "x", ip_address: "1.2.3.4")
+    assert SignInEvent.for_address("bob@example.com").exists?
+
+    # old-style removal
+    bob.deactivate
+    assert_match(/bob-deactivated-.*@example.com/, bob.reload.email_address)
+    # sign-in events remain under original address
+    assert SignInEvent.for_address("bob@example.com").exists?
+
+    bob_id = bob.id
+    bob.erase
+
+    assert_nil User.find_by(id: bob_id)
+    assert_equal 0, SignInEvent.for_address("bob@example.com").count, "original email sign-in events must be erased"
+    assert_equal 0, SignInEvent.where("email_address LIKE ?", "bob-deactivated-%").count
+  end
+end
+
+class User::ErasableEdgeCaseTest < ActiveSupport::TestCase
+  test "erasing a user with nothing attached just removes the row" do
+    carol = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456")
+    id = carol.id
+    assert_nothing_raised { carol.erase }
+    assert_nil User.find_by(id: id)
+  end
+
+  test "erasing does not touch other users' sign-in events" do
+    dan = User.create!(name: "Dan", email_address: "dan@example.com", password: "secret123456")
+    dan.sessions.start!(user_agent: "x", ip_address: "1.1.1.1")
+
+    other = users(:kevin)
+    other.sessions.start!(user_agent: "x", ip_address: "2.2.2.2")
+    other_events_before = SignInEvent.for_address(other.email_address).count
+    assert other_events_before > 0
+
+    dan.erase
+
+    assert_equal 0, SignInEvent.for_address("dan@example.com").count
+    assert_equal other_events_before, SignInEvent.for_address(other.email_address).count
+  end
+
+  test "everyone-book created by an already-deactivated user is handed off and stays searchable" do
+    eve = User.create!(name: "Eve", email_address: "eve@example.com", password: "secret123456")
+    book = Book.create!(title: "Shared Handbook", author: "Eve", everyone_access: true, creator: eve)
+    leaf = book.press(Page.new, { title: "Eve Findable Page" })
+
+    eve.deactivate
+    eve.erase
+
+    kept = Book.find_by(id: book.id)
+    assert kept
+    assert_nil kept.creator_id
+    assert_equal "Deleted author", kept.author
+    assert_equal 1, Leaf.search("Findable").to_a.size
+  end
+
+  test "erasing the last editor of a private book removes the book and its search hits" do
+    frank = User.create!(name: "Frank", email_address: "frank@example.com", password: "secret123456")
+    book = Book.create!(title: "Frank Secret", author: "Frank", everyone_access: false, creator: frank)
+    book.press(Page.new, { title: "Frank Confidential Note" })
+
+    frank.erase
+
+    assert_nil Book.find_by(id: book.id)
+    assert_equal 0, Leaf.search("Confidential").to_a.size
+  end
+end
