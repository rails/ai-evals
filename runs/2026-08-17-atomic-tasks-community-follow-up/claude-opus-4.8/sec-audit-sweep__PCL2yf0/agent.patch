+
+    # Escape LIKE wildcards so % and _ are matched literally rather than
+    # acting as pattern syntax. The backslash escape character is escaped too.
+    def escape_like(term)
+      term.gsub(/[\\%_]/) { |char| "\\#{char}" }
+    end
 end
