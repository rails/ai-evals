diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..9386c9c 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,29 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication, if: :saved_change_to_published?
+    after_commit :announce_publication, if: :publication_pending?
+    after_commit :forget_publication
+    after_rollback :forget_publication
   end
 
   private
+    def remember_publication
+      # Track the book's live state as it changes during the sitting, so a
+      # subsequent touch/save in the same transaction can't erase the fact
+      # that it went (or didn't go) live. Only the final state matters.
+      @publication_pending = published?
+    end
+
+    def publication_pending?
+      @publication_pending
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    def forget_publication
+      @publication_pending = false
+    end
 end
