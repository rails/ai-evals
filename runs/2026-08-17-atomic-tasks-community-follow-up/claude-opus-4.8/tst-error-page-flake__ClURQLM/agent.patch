diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..dc7995d 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,30 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# `with_raised_exceptions` used to toggle the *global*
+# `config.action_dispatch.show_exceptions` setting. That value, however, is
+# copied into `Rails.application.env_config` -- a hash that is built once and
+# memoized -- and it is that hash, re-merged onto the Rack env on every single
+# request (see Rails::Engine#build_request), that actually decides whether an
+# exception is rendered or re-raised. Mutating the config object after the hash
+# has been memoized therefore did nothing, and mutating it before it was
+# memoized baked the changed value into every later request in the same
+# process.
+#
+# Because the suite runs in parallel with one process per worker, each worker
+# runs many tests back to back in a single process. Depending on which test
+# happened to trigger the memoization first, `with_raised_exceptions` either
+# had no effect (so `book_absence_test` saw "nothing was raised") or leaked
+# `:none` into unrelated controller tests (so their expected 404 pages blew up
+# with a raised RecordNotFound). Which tests lost the race changed from run to
+# run -- hence the flakiness.
+#
+# The fix targets the value that is actually read at request time: the
+# `action_dispatch.show_exceptions` entry inside `Rails.application.env_config`.
+# We flip it to `:none` for the duration of the block and always restore the
+# previous value, so the promise holds no matter what ran before or after in
+# the same process. `ensure` guarantees the original value comes back even if
+# the block raises, keeping error pages rendering normally outside the block.
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -12,12 +36,15 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    SHOW_EXCEPTIONS_HEADER = "action_dispatch.show_exceptions"
+
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config[SHOW_EXCEPTIONS_HEADER]
+      env_config[SHOW_EXCEPTIONS_HEADER] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config[SHOW_EXCEPTIONS_HEADER] = previous
     end
   end
 end
