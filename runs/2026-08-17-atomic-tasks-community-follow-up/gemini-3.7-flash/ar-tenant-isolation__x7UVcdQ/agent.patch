diff --git a/test/migrate/migration_test.rb b/test/migrate/migration_test.rb
new file mode 100644
index 0000000..8ebc571
--- /dev/null
+++ b/test/migrate/migration_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+require_relative "../../db/migrate/20260816183206_create_tenants_and_add_tenant_id"
+
+class MigrationTest < ActiveSupport::TestCase
+  test "migration creates tenant from existing account name and migrates users and books" do
+    migration = CreateTenantsAndAddTenantId.new
+    # We can test the migration's up logic
+    # Revert migration first
+    ActiveRecord::Migration.suppress_messages do
+      migration.down
+      assert_not ActiveRecord::Base.connection.table_exists?(:tenants)
+      assert_not ActiveRecord::Base.connection.column_exists?(:users, :tenant_id)
+      assert_not ActiveRecord::Base.connection.column_exists?(:books, :tenant_id)
+
+      # Create some dummy records
+      ActiveRecord::Base.connection.execute("INSERT INTO users (name, email_address, password_digest, role, created_at, updated_at) VALUES ('Old User', 'old@example.com', 'digest', 0, datetime('now'), datetime('now'))")
+      ActiveRecord::Base.connection.execute("INSERT INTO books (title, slug, created_at, updated_at) VALUES ('Old Book', 'old-book', datetime('now'), datetime('now'))")
+
+      migration.up
+      assert ActiveRecord::Base.connection.table_exists?(:tenants)
+      assert ActiveRecord::Base.connection.column_exists?(:users, :tenant_id)
+      assert ActiveRecord::Base.connection.column_exists?(:books, :tenant_id)
+
+      tenant_id = ActiveRecord::Base.connection.select_value("SELECT id FROM tenants LIMIT 1")
+      assert_not_nil tenant_id
+
+      user_tenant_id = ActiveRecord::Base.connection.select_value("SELECT tenant_id FROM users WHERE email_address = 'old@example.com'")
+      assert_equal tenant_id, user_tenant_id
+
+      book_tenant_id = ActiveRecord::Base.connection.select_value("SELECT tenant_id FROM books WHERE slug = 'old-book'")
+      assert_equal tenant_id, book_tenant_id
+    end
+  end
+end
diff --git a/test/models/tenant_test.rb b/test/models/tenant_test.rb
new file mode 100644
index 0000000..3ff09dc
--- /dev/null
+++ b/test/models/tenant_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class TenantTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Tenant A")
+    @tenant_b = Tenant.create!(name: "Tenant B")
+
+    @user_a = User.create!(name: "User A", email_address: "user_a@example.com", password: "secret123456", role: :administrator, tenant: @tenant_a)
+    @user_b = User.create!(name: "User B", email_address: "user_b@example.com", password: "secret123456", role: :administrator, tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Book A", tenant: @tenant_a, everyone_access: true, published: false)
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+
+    @book_b = Book.create!(title: "Book B", tenant: @tenant_b, everyone_access: true, published: true)
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+    @page_b = @book_b.press(Page.new(body: "Original B body"), title: "Page B").page
+    @leaf_b = @page_b.leaf
+    @leaf_b.edit(leafable_params: { body: "Edited B body" })
+  end
+
+  test "new book lands in creator tenant" do
+    sign_in @user_a
+    post books_url, params: { book: { title: "Another Book A", everyone_access: true } }
+    new_book = Book.find_by!(title: "Another Book A")
+    assert_equal @tenant_a, new_book.tenant
+  end
+
+  test "user from tenant A cannot see tenant B book in index even if published" do
+    sign_in @user_a
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Book A"
+    assert_select "h2", text: "Book B", count: 0
+  end
+
+  test "signed out visitor sees all published books across tenants" do
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Book B"
+    assert_select "h2", text: "Book A", count: 0
+  end
+
+  test "user from tenant A gets 404 when requesting tenant B book" do
+    sign_in @user_a
+    get book_slug_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "user from tenant A gets 404 when requesting tenant B leafable" do
+    sign_in @user_a
+    get leafable_slug_url(@leaf_b)
+    assert_response :not_found
+  end
+
+  test "user from tenant A gets 404 when requesting tenant B edit history even with access row" do
+    # Give user_a an access row to book_b artificially as described in issue
+    Access.create!(user: @user_a, book: @book_b, level: :reader)
+
+    sign_in @user_a
+    get page_edit_url(@leaf_b, @leaf_b.edits.last)
+    assert_response :not_found
+  end
+
+  test "user from tenant A stays signed in after 404" do
+    sign_in @user_a
+    get book_slug_url(@book_b)
+    assert_response :not_found
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Book A"
+  end
+
+  test "everyone_access does not grant access across tenants" do
+    user_a2 = User.create!(name: "User A2", email_address: "user_a2@example.com", password: "secret123456", role: :member, tenant: @tenant_a)
+    # user_a2 should have access to book_a (tenant_a) but NOT book_b (tenant_b)
+    assert @book_a.accessable?(user: user_a2)
+    assert_not @book_b.accessable?(user: user_a2)
+  end
+
+  test "users index lists everyone on install" do
+    sign_in @user_a
+    get users_url
+    assert_response :success
+    assert_select "body", /User A/
+    assert_select "body", /User B/
+  end
+
+  test "inside tenant everything works normally" do
+    sign_in @user_b
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Book B"
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :success
+
+    get page_edit_url(@leaf_b, @leaf_b.edits.last)
+    assert_response :success
+  end
+end
