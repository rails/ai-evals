+class CreateTenantsAndAddTenantId < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    if select_value("SELECT COUNT(*) FROM users").to_i > 0 || select_value("SELECT COUNT(*) FROM books").to_i > 0
+      tenant_name = select_value("SELECT name FROM accounts LIMIT 1") || "Writebook"
+      now = Time.now.utc.to_fs(:db)
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(tenant_name)}, '#{now}', '#{now}')"
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+  end
+
+  def down
+    remove_reference :books, :tenant
+    remove_reference :users, :tenant
+    drop_table :tenants
+  end
+end
