diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..4943af4 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,69 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+  test "show cached leaves for editor then reader and reader then editor" do
+    ActionController::Base.perform_caching = true
+    Rails.cache.clear
+    begin
+      # 1. Kevin (editor) visits handbook
+      sign_in :kevin
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select "a.hide_from_reading_mode"
+
+      # 2. JZ (reader) visits handbook
+      sign_out
+      sign_in :jz
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select "a.hide_from_reading_mode", count: 0
+
+      # 3. Clear cache and try reverse order: reader then editor
+      Rails.cache.clear
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select "a.hide_from_reading_mode", count: 0
+
+      sign_out
+      sign_in :kevin
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select "a.hide_from_reading_mode"
+    ensure
+      ActionController::Base.perform_caching = false
+    end
+  end
+
+  test "renamed entry shows new title to subsequent viewers" do
+    ActionController::Base.perform_caching = true
+    Rails.cache.clear
+    begin
+      sign_in :kevin
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select ".toc__title", text: /Welcome/
+
+      # Rename the welcome page
+      leaf = leaves(:welcome_page)
+      leaf.update!(title: "Brand New Welcome Title")
+
+      # Reader visits
+      sign_out
+      sign_in :jz
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select ".toc__title", text: /Brand New Welcome Title/
+      assert_select ".toc__title", text: "Welcome Page", count: 0
+      assert_select ".toc__title", text: /Brand New Welcome Title/
+
+      # Editor visits
+      sign_out
+      sign_in :kevin
+      get book_slug_url(books(:handbook))
+      assert_response :success
+      assert_select ".toc__title", text: /Brand New Welcome Title/
+    ensure
+      ActionController::Base.perform_caching = false
+    end
+  end
 end
