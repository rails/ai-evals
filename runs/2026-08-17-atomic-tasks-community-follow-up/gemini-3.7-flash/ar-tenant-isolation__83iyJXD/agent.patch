diff --git a/test/controllers/tenant_isolation_test.rb b/test/controllers/tenant_isolation_test.rb
new file mode 100644
index 0000000..7ed16f9
--- /dev/null
+++ b/test/controllers/tenant_isolation_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = User.create!(name: "User A", email_address: "usera@example.com", password: "secret123456", tenant: @tenant_a)
+    @user_b = User.create!(name: "User B", email_address: "userb@example.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Book A", tenant: @tenant_a, everyone_access: true)
+    @book_b = Book.create!(title: "Book B", tenant: @tenant_b, everyone_access: true)
+
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+    @page_b = @book_b.press(Page.new(body: "Tenant B Secret Content"), title: "Page B")
+  end
+
+  test "new book lands in creator's tenant" do
+    post session_url, params: { email_address: @user_a.email_address, password: "secret123456" }
+    assert_response :redirect
+
+    assert_difference -> { @tenant_a.books.count }, 1 do
+      post books_url, params: { book: { title: "New Book by A" } }
+    end
+
+    new_book = Book.find_by(title: "New Book by A")
+    assert_equal @tenant_a, new_book.tenant
+  end
+
+  test "user cannot see another tenant's unpublished book in library" do
+    post session_url, params: { email_address: @user_a.email_address, password: "secret123456" }
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: @book_a.title
+    assert_select "h2", text: @book_b.title, count: 0
+  end
+
+  test "user cannot see another tenant's published book in library" do
+    @book_b.update!(published: true)
+
+    post session_url, params: { email_address: @user_a.email_address, password: "secret123456" }
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: @book_a.title
+    assert_select "h2", text: @book_b.title, count: 0
+  end
+
+  test "signed-out visitor sees published books across all tenants" do
+    @book_a.update!(published: true)
+    @book_b.update!(published: true)
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: @book_a.title
+    assert_select "h2", text: @book_b.title
+  end
+
+  test "user gets 404 when requesting another tenant's book even if published and with access row" do
+    @book_b.update!(published: true)
+    Access.create!(user: @user_a, book: @book_b, level: :reader)
+
+    post session_url, params: { email_address: @user_a.email_address, password: "secret123456" }
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+
+    get edit_book_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "user gets 404 when requesting another tenant's page or edit history" do
+    @page_b.edit(leafable_params: { body: "Updated Secret Content" })
+    Access.create!(user: @user_a, book: @book_b, level: :reader)
+
+    post session_url, params: { email_address: @user_a.email_address, password: "secret123456" }
+
+    get leafable_slug_url(@page_b)
+    assert_response :not_found
+
+    get page_edit_url(@page_b, @page_b.edits.last)
+    assert_response :not_found
+  end
+
+  test "sharing with everyone does not grant access across tenants" do
+    @book_b.update_access(editors: [], readers: [])
+    assert_not @book_b.accessable?(user: @user_a)
+    assert_not @user_a.books.include?(@book_b)
+
+    new_user_a = User.create!(name: "New User A", email_address: "newa@example.com", password: "secret123456", tenant: @tenant_a)
+    assert_not @book_b.accessable?(user: new_user_a)
+  end
+
+  test "/users lists all users across all tenants" do
+    admin_a = User.create!(name: "Admin A", email_address: "admina@example.com", password: "secret123456", role: :administrator, tenant: @tenant_a)
+    post session_url, params: { email_address: admin_a.email_address, password: "secret123456" }
+
+    get users_url
+    assert_response :success
+    assert_select "strong", text: "User A"
+    assert_select "strong", text: "User B"
+  end
+
+  test "fixture rows without tenant behave as before" do
+    assert_nil users(:david).tenant
+    assert_nil books(:handbook).tenant
+    assert books(:handbook).accessable?(user: users(:david))
+  end
+end
diff --git a/test/models/tenant_test.rb b/test/models/tenant_test.rb
new file mode 100644
index 0000000..3de5041
--- /dev/null
+++ b/test/models/tenant_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class TenantTest < ActiveSupport::TestCase
+  test "validates presence of name" do
+    tenant = Tenant.new(name: "")
+    assert_not tenant.valid?
+    assert_includes tenant.errors[:name], "can't be blank"
+
+    tenant.name = "Acme Corp"
+    assert tenant.valid?
+  end
+
+  test "has many users and books" do
+    tenant = Tenant.create!(name: "Acme")
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", tenant: tenant)
+    book = Book.create!(title: "Alice's Book", tenant: tenant)
+
+    assert_includes tenant.users, user
+    assert_includes tenant.books, book
+  end
+end
