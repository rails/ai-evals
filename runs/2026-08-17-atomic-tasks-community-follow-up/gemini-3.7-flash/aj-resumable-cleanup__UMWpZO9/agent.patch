+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "cleans stray quotes from leaf titles" do
+    leaf1 = leaves(:welcome_section)
+    leaf2 = leaves(:welcome_page)
+
+    leaf1.update_columns(title: %("Hello World"))
+    leaf2.update_columns(title: %("Chapter "One""))
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Hello World", leaf1.reload.title
+    assert_equal %(Chapter "One"), leaf2.reload.title
+  end
+
+  test "resumes after interruption without cleaning already-cleaned leaves twice" do
+    sorted_leaves = Leaf.order(id: :asc).to_a
+    sorted_leaves[0].update_columns(title: %("\"Leaf 0\" with quotes"))
+    sorted_leaves[1].update_columns(title: %("\"Leaf 1\" with quotes"))
+    sorted_leaves[2].update_columns(title: %("\"Leaf 2\" with quotes"))
+    sorted_leaves[3].update_columns(title: %("\"Leaf 3\" with quotes"))
+
+    TitleCleanupJob.perform_later
+
+    # Interrupt after first leaf
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: sorted_leaves[0].id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal %("Leaf 0" with quotes), sorted_leaves[0].reload.title
+    assert_equal %("\"Leaf 1\" with quotes"), sorted_leaves[1].reload.title
+    assert_equal %("\"Leaf 2\" with quotes"), sorted_leaves[2].reload.title
+    assert_equal %("\"Leaf 3\" with quotes"), sorted_leaves[3].reload.title
+
+    # Resume job
+    perform_enqueued_jobs
+
+    assert_equal %("Leaf 0" with quotes), sorted_leaves[0].reload.title
+    assert_equal %("Leaf 1" with quotes), sorted_leaves[1].reload.title
+    assert_equal %("Leaf 2" with quotes), sorted_leaves[2].reload.title
+    assert_equal %("Leaf 3" with quotes), sorted_leaves[3].reload.title
+  end
+end
