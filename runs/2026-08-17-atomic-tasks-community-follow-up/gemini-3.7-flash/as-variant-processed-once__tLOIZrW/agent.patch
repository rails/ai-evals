+  test "update picture derives image once and does not duplicate on reading" do
+    perform_enqueued_jobs do
+      put leafable_path(leaves(:reading_picture)), params: {
+        picture: {
+          image: fixture_file_upload("white-rabbit.webp", "image/webp")
+        }
+      }
+    end
+
+    assert_response :no_content
+
+    updated_picture = Picture.last
+    blob = updated_picture.image.blob
+    assert_equal 1, blob.variant_records.count
+
+    get leafable_slug_path(leaves(:reading_picture))
+    assert_response :ok
+
+    image_src = response.body.scan(/<img[^>]+src="([^"]+)"/).flatten.find { |src| src.include?("active_storage") || src.include?("rails/active_storage") }
+    assert_not_nil image_src
+
+    assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+      get image_src
+      assert_response :redirect
+    end
+
+    assert_equal 1, blob.reload.variant_records.count
+  end
+
