--- /dev/null
+++ b/test/models/book/archive_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Book::ArchiveTest < ActiveSupport::TestCase
+  test "deleting a book archives access list for all users who had access" do
+    book = books(:handbook)
+
+    # handbook has accesses for david (editor), jason (editor), jz (reader), kevin (editor)
+    assert_difference -> { AccessArchive.count }, +4 do
+      assert_difference -> { Book.count }, -1 do
+        assert_difference -> { Access.count }, -4 do
+          book.destroy
+        end
+      end
+    end
+
+    david_archive = AccessArchive.find_by(book_id: book.id, user_id: users(:david).id)
+    assert_not_nil david_archive
+    assert_equal "Handbook", david_archive.book_title
+    assert_equal "David", david_archive.user_name
+    assert_equal "editor", david_archive.level
+
+    jz_archive = AccessArchive.find_by(book_id: book.id, user_id: users(:jz).id)
+    assert_not_nil jz_archive
+    assert_equal "Handbook", jz_archive.book_title
+    assert_equal "JZ", jz_archive.user_name
+    assert_equal "reader", jz_archive.level
+  end
+
+  test "deleting a book with no access creates no archive rows" do
+    book = Book.create!(title: "Empty Book", everyone_access: false)
+    book.accesses.destroy_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+  end
+
+  test "revoked access is not archived upon book deletion" do
+    book = books(:manual)
+    # manual has accesses for david (editor), jason (editor), jz (reader)
+    # revoke jz's access
+    book.accesses.find_by(user: users(:jz)).destroy
+
+    assert_difference -> { AccessArchive.count }, +2 do
+      book.destroy
+    end
+
+    assert_nil AccessArchive.find_by(book_id: book.id, user_id: users(:jz).id)
+  end
+
+  test "updated access level is reflected in archive upon deletion" do
+    book = books(:manual)
+    jz_access = book.accesses.find_by(user: users(:jz))
+    jz_access.editor!
+
+    book.destroy
+
+    jz_archive = AccessArchive.find_by(book_id: book.id, user_id: users(:jz).id)
+    assert_equal "editor", jz_archive.level
+  end
+end
