diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..3d4bcc1 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,53 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "edit renders turbo stream subscription scoped to book accesses" do
+    leaf = leaves(:welcome_page)
+    get edit_leafable_path(leaf)
+
+    assert_response :success
+    expected_signed_name = Turbo::StreamsChannel.signed_stream_name([ leaf.book.accesses.to_a, leaf, :being_edited ])
+    assert_select %(turbo-cable-stream-source[signed-stream-name="#{expected_signed_name}"])
+  end
+
+  test "updating leaf broadcasts being edited indicator scoped to current book accesses" do
+    leaf = leaves(:welcome_page)
+    expected_stream_name = Turbo::StreamsChannel.send(:stream_name_from, [ leaf.book.accesses.to_a, leaf, :being_edited ])
+
+    assert_broadcasts expected_stream_name, 1 do
+      perform_enqueued_jobs do
+        put leafable_path(leaf), params: { leaf: { title: "Updated Title" }, page: { body: "Updated Body" } }
+      end
+    end
+
+    assert_includes broadcasts(expected_stream_name).last, "Kevin"
+  end
+
+  test "removed collaborator cannot receive being edited broadcasts from previous stream name" do
+    leaf = leaves(:welcome_page)
+    book = leaf.book
+
+    # Current stream name with kevin, jason, david, jz
+    old_signed_name = Turbo::StreamsChannel.signed_stream_name([ book.accesses.to_a, leaf, :being_edited ])
+    old_stream_name = Turbo::StreamsChannel.verified_stream_name(old_signed_name)
+
+    # Remove jz from book
+    book.access_for(user: users(:jz)).destroy
+
+    new_stream_name = Turbo::StreamsChannel.send(:stream_name_from, [ book.reload.accesses.to_a, leaf, :being_edited ])
+
+    assert_not_equal old_stream_name, new_stream_name
+
+    # Updating broadcasts to new_stream_name, not old_stream_name
+    assert_no_broadcasts old_stream_name do
+      assert_broadcasts new_stream_name, 1 do
+        perform_enqueued_jobs do
+          put leafable_path(leaf), params: { leaf: { title: "Updated Title 2" }, page: { body: "Updated Body 2" } }
+        end
+      end
+    end
+
+    assert_includes broadcasts(new_stream_name).last, "Kevin"
+  end
 end
