diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..6a43fe0
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:manual)
+  end
+
+  test "imports a fully valid manifest in order" do
+    manifest = [
+      { title: "Chapter 1", body: "Content 1" },
+      { title: "Chapter 2", body: "Content 2" },
+      { title: "Chapter 3", body: "Content 3" }
+    ]
+
+    assert_difference -> { @book.leaves.count }, 3 do
+      assert @book.import_manifest(manifest)
+    end
+
+    leaves = @book.leaves.order(:position_score).last(3)
+    assert_equal [ "Chapter 1", "Chapter 2", "Chapter 3" ], leaves.map(&:title)
+    assert leaves.all?(&:section?)
+    assert_equal [ "Content 1", "Content 2", "Content 3" ], leaves.map { it.leafable.body }
+  end
+
+  test "rejects manifest with invalid entry at the beginning and imports nothing" do
+    manifest = [
+      { title: "", body: "No title" },
+      { title: "Chapter 1", body: "Content 1" }
+    ]
+
+    assert_no_difference -> { @book.leaves.count } do
+      assert_not @book.import_manifest(manifest)
+    end
+  end
+
+  test "rejects manifest with invalid entry in the middle and imports nothing" do
+    manifest = [
+      { title: "Chapter 1", body: "Content 1" },
+      { title: "Chapter 2", body: "" },
+      { title: "Chapter 3", body: "Content 3" }
+    ]
+
+    assert_no_difference -> { @book.leaves.count } do
+      assert_not @book.import_manifest(manifest)
+    end
+  end
+
+  test "rejects manifest with invalid entry at the end and imports nothing" do
+    manifest = [
+      { title: "Chapter 1", body: "Content 1" },
+      { title: "Chapter 2", body: "Content 2" },
+      { title: nil, body: "Content 3" }
+    ]
+
+    assert_no_difference -> { @book.leaves.count } do
+      assert_not @book.import_manifest(manifest)
+    end
+  end
+
+  test "rejects manifest with entry duplicating an existing leaf title without crashing" do
+    @book.press(Section.new(body: "Existing body"), title: "Existing Title")
+
+    manifest = [
+      { title: "New Chapter", body: "New Content" },
+      { title: "Existing Title", body: "Duplicate Content" }
+    ]
+
+    assert_no_difference -> { @book.leaves.count } do
+      assert_not @book.import_manifest(manifest)
+    end
+  end
+
+  test "rejects manifest with duplicate titles within the manifest itself" do
+    manifest = [
+      { title: "Same Title", body: "Content 1" },
+      { title: "Same Title", body: "Content 2" }
+    ]
+
+    assert_no_difference -> { @book.leaves.count } do
+      assert_not @book.import_manifest(manifest)
+    end
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..486f7b6
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  setup do
+    @book1 = books(:manual)
+    @book2 = books(:handbook)
+  end
+
+  test "imports valid manifests and rejects invalid ones while keeping successful work" do
+    valid_manifest = [
+      { title: "Manual Section 1", body: "Body 1" },
+      { title: "Manual Section 2", body: "Body 2" }
+    ]
+
+    invalid_manifest = [
+      { title: "Handbook Section 1", body: "Body 1" },
+      { title: "", body: "Invalid body" }
+    ]
+
+    initial_book2_leaves_count = @book2.leaves.count
+
+    result = nil
+    assert_difference -> { @book1.leaves.count }, 2 do
+      assert_no_difference -> { @book2.leaves.count } do
+        result = BulkImport.new({ @book1 => valid_manifest, @book2 => invalid_manifest }).run
+      end
+    end
+
+    assert_equal [ @book1 ], result.imported
+    assert_equal [ @book2 ], result.rejected
+  end
+
+  test "rejects manifest with duplicate title in bulk import without failing the whole batch" do
+    valid_manifest = [
+      { title: "Manual Section 1", body: "Body 1" }
+    ]
+
+    # handbook fixture already has "The Welcome Section"
+    duplicate_manifest = [
+      { title: "Handbook New Section", body: "Body 1" },
+      { title: "The Welcome Section", body: "Duplicate Title" }
+    ]
+
+    result = nil
+    assert_difference -> { @book1.leaves.count }, 1 do
+      assert_no_difference -> { @book2.leaves.count } do
+        result = BulkImport.new({ @book1 => valid_manifest, @book2 => duplicate_manifest }).run
+      end
+    end
+
+    assert_equal [ @book1 ], result.imported
+    assert_equal [ @book2 ], result.rejected
+  end
+end
