@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! preserves ordering of rearranged leaves and compacts scores" do
+    book = books(:handbook)
+    leaves(:welcome_section).move_to_position(2)
+
+    expected_leaves = [ leaves(:welcome_page), leaves(:summary_page), leaves(:welcome_section), leaves(:reading_picture) ]
+    assert_equal expected_leaves, book.leaves.positioned.to_a
+
+    book.compact_positions!
+
+    assert_equal expected_leaves, book.leaves.positioned.reload.to_a
+    assert_equal [ 1.0, 2.0, 3.0, 4.0 ], book.leaves.positioned.reload.pluck(:position_score)
+  end
+
+  test "live_leaf_count returns count of active leaves excluding trashed" do
+    book = books(:handbook)
+    assert_equal 4, book.live_leaf_count
+
+    leaves(:welcome_page).trashed!
+    assert_equal 3, book.live_leaf_count
+  end
+end
