diff --git a/test/controllers/books_caching_test.rb b/test/controllers/books_caching_test.rb
new file mode 100644
index 0000000..722fb35
--- /dev/null
+++ b/test/controllers/books_caching_test.rb
@@ -0,0 +1,149 @@
+require "test_helper"
+
+class BooksCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @orig_perform_caching = ActionController::Base.perform_caching
+    @orig_cache_store = Rails.cache
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.cache_store = Rails.cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @orig_perform_caching
+    Rails.cache = @orig_cache_store
+    ActionController::Base.cache_store = @orig_cache_store
+  end
+
+  test "reader visiting after editor does not see editor controls" do
+    handbook = books(:handbook)
+    kevin = users(:kevin) # editor
+    jz = users(:jz)       # reader
+
+    assert handbook.editable?(user: kevin)
+    assert_not handbook.editable?(user: jz)
+
+    # 1. Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete"
+    assert_select ".arrangement__handle"
+    assert_select "a.hide_from_reading_mode"
+
+    # 2. Reader visits
+    sign_in :jz
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete", count: 0
+    assert_select ".arrangement__handle", count: 0
+    assert_select "a.hide_from_reading_mode", count: 0
+    assert_select "a[href*='/edit']", count: 0
+  end
+
+  test "editor visiting after reader sees editor controls" do
+    handbook = books(:handbook)
+    kevin = users(:kevin) # editor
+    jz = users(:jz)       # reader
+
+    assert handbook.editable?(user: kevin)
+    assert_not handbook.editable?(user: jz)
+
+    # 1. Reader visits
+    sign_in :jz
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete", count: 0
+    assert_select ".arrangement__handle", count: 0
+    assert_select "a.hide_from_reading_mode", count: 0
+    assert_select "a[href*='/edit']", count: 0
+
+    # 2. Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete"
+    assert_select ".arrangement__handle"
+    assert_select "a.hide_from_reading_mode"
+  end
+
+  test "renamed entry shows new title to subsequent visitors" do
+    handbook = books(:handbook)
+    kevin = users(:kevin) # editor
+    jz = users(:jz)       # reader
+    leaf = leaves(:welcome_page)
+
+    # Reader visits
+    sign_in :jz
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".toc__title", text: "Welcome to The Handbook!"
+
+    # Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".toc__title", text: "Welcome to The Handbook!"
+
+    # Editor renames page
+    patch book_page_url(handbook, leaf), params: { leaf: { title: "Brand New Welcome Title" } }
+
+    # Reader visits
+    sign_in :jz
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".toc__title", text: "Brand New Welcome Title"
+    assert_select ".leaf__delete", count: 0
+
+    # Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".toc__title", text: "Brand New Welcome Title"
+    assert_select ".leaf__delete"
+  end
+
+  test "unauthenticated visitor viewing published book after editor does not see editor controls" do
+    handbook = books(:handbook)
+    handbook.update!(published: true)
+    kevin = users(:kevin) # editor
+
+    # Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete"
+
+    # Sign out -> unauthenticated visitor
+    sign_out
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete", count: 0
+    assert_select ".arrangement__handle", count: 0
+    assert_select "a.hide_from_reading_mode", count: 0
+    assert_select "a[href*='/edit']", count: 0
+  end
+
+  test "editor visiting published book after unauthenticated visitor sees editor controls" do
+    handbook = books(:handbook)
+    handbook.update!(published: true)
+    kevin = users(:kevin) # editor
+
+    # Unauthenticated visitor
+    sign_out
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete", count: 0
+    assert_select ".arrangement__handle", count: 0
+    assert_select "a.hide_from_reading_mode", count: 0
+    assert_select "a[href*='/edit']", count: 0
+
+    # Editor visits
+    sign_in :kevin
+    get book_slug_url(handbook)
+    assert_response :success
+    assert_select ".leaf__delete"
+    assert_select ".arrangement__handle"
+    assert_select "a.hide_from_reading_mode"
+  end
+end
