+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "cleans stray quotes from titles" do
+    leaf1 = leaves(:welcome_page)
+    leaf1.update_columns(title: '"Welcome Page"')
+
+    leaf2 = leaves(:summary_page)
+    leaf2.update_columns(title: '""Quoted Title" by Author"')
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Welcome Page", leaf1.reload.title
+    assert_equal '"Quoted Title" by Author', leaf2.reload.title
+  end
+
+  test "resumes after interruption without cleaning completed leaves again" do
+    leaf1 = leaves(:welcome_section)
+    leaf1.update_columns(title: '"Section One"')
+
+    leaf2 = leaves(:welcome_page)
+    leaf2.update_columns(title: '""Quoted Title" - Part 1"')
+
+    leaf3 = leaves(:summary_page)
+    leaf3.update_columns(title: '"Summary"')
+
+    leaf4 = leaves(:reading_picture)
+    leaf4.update_columns(title: '""Quoted Title" - Part 2"')
+
+    # Ensure IDs are ordered
+    all_leaves = [ leaf1, leaf2, leaf3, leaf4 ].sort_by(&:id)
+
+    TitleCleanupJob.perform_later
+
+    # Interrupt after leaf 2 has been processed
+    # Its advance! will set cursor to leaf2.id + 1
+    cursor_after_leaf2 = all_leaves[1].id + 1
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: cursor_after_leaf2) do
+      perform_enqueued_jobs
+    end
+
+    # Leaf 1 and Leaf 2 should be cleaned
+    assert_equal all_leaves[0].title.delete_prefix('"').delete_suffix('"'), all_leaves[0].reload.title
+    assert_equal all_leaves[1].title.delete_prefix('"').delete_suffix('"'), all_leaves[1].reload.title
+    # Leaf 3 and Leaf 4 should still have quotes
+    assert_equal '"Summary"', leaf3.reload.title
+    assert_equal '""Quoted Title" - Part 2"', leaf4.reload.title
+
+    # Resume and run remaining jobs
+    perform_enqueued_jobs
+
+    # Leaf 1 and Leaf 2 should not have been double-cleaned (quotes intact)
+    assert_equal "Section One", leaf1.reload.title
+    assert_equal '"Quoted Title" - Part 1', leaf2.reload.title
+    assert_equal "Summary", leaf3.reload.title
+    assert_equal '"Quoted Title" - Part 2', leaf4.reload.title
+  end
+end
