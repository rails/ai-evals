diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..f94d375 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,26 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :track_publication_status, if: :published_previously_changed?
+    after_commit :announce_publication, if: :announced_publication?
+    after_rollback :clear_publication_status
   end
 
   private
+    def track_publication_status
+      @was_published_before_transaction = published_before_last_save if @was_published_before_transaction.nil?
+    end
+
+    def announced_publication?
+      (@was_published_before_transaction == false && published?).tap do
+        clear_publication_status
+      end
+    end
+
+    def clear_publication_status
+      @was_published_before_transaction = nil
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
