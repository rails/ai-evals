diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..46023c9
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster Book", everyone_access: false)
+    @users = 20.times.map do |i|
+      User.create!(
+        name: "User #{i}",
+        email_address: "user#{i}@example.com",
+        password: "password123",
+        role: :member
+      )
+    end
+  end
+
+  test "imports grants successfully and enqueues notifications" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal @users[0].id, result.accesses[0].user_id
+    assert_equal "reader", result.accesses[0].level
+    assert_equal @users[1].id, result.accesses[1].user_id
+    assert_equal "editor", result.accesses[1].level
+    assert_equal 2, @book.accesses.count
+  end
+
+  test "turns down roster on invalid access level without blowing up" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "invalid_level" },
+      { user_id: @users[2].id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "turns down roster on nil access level without blowing up" do
+    grants = [
+      { user_id: @users[0].id, level: nil }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 0, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "turns down roster on duplicate user within the sheet" do
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "editor" },
+      { user_id: @users[0].id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 2, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "turns down roster on duplicate user existing in the database" do
+    @book.accesses.create!(user: @users[1], level: "reader")
+
+    grants = [
+      { user_id: @users[0].id, level: "reader" },
+      { user_id: @users[1].id, level: "editor" },
+      { user_id: @users[2].id, level: "reader" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "scales database writes in constant queries" do
+    grants_4 = 4.times.map { |i| { user_id: @users[i].id, level: "reader" } }
+    grants_16 = 16.times.map { |i| { user_id: @users[i].id, level: "reader" } }
+
+    book_a = Book.create!(title: "Book A", everyone_access: false)
+    book_b = Book.create!(title: "Book B", everyone_access: false)
+
+    queries_4 = count_queries { Book::AccessImport.new(book_a, grants_4).import }
+    queries_16 = count_queries { Book::AccessImport.new(book_b, grants_16).import }
+
+    assert_equal queries_4, queries_16
+  end
+
+  test "scales rejected database queries in constant queries" do
+    grants_4 = 4.times.map { |i| { user_id: @users[i].id, level: "reader" } }
+    grants_4[3][:level] = "bogus"
+
+    grants_16 = 16.times.map { |i| { user_id: @users[i].id, level: "reader" } }
+    grants_16[15][:level] = "bogus"
+
+    book_a = Book.create!(title: "Book A", everyone_access: false)
+    book_b = Book.create!(title: "Book B", everyone_access: false)
+
+    queries_4 = count_queries { Book::AccessImport.new(book_a, grants_4).import }
+    queries_16 = count_queries { Book::AccessImport.new(book_b, grants_16).import }
+
+    assert_equal queries_4, queries_16
+  end
+
+  test "handles empty roster" do
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, []).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_empty result.accesses
+  end
+
+  test "handles string keys and symbol levels" do
+    grants = [
+      { "user_id" => @users[0].id, "level" => :reader },
+      { "user_id" => @users[1].id, "level" => :editor }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal "reader", result.accesses[0].level
+    assert_equal "editor", result.accesses[1].level
+  end
+
+  private
+    def count_queries(&block)
+      count = 0
+      counter = ->(name, started, finished, unique_id, data) {
+        count += 1 unless data[:name] == "SCHEMA" || data[:sql].match?(/TRANSACTION|SAVEPOINT|RELEASE/)
+      }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      count
+    end
+end
