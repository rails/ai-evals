diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..2fbd47b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search finds matching pages from accessible books" do
+    get library_search_url, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "search does not return pages from inaccessible books" do
+    secret_leaf = books(:manual).press Page.new(body: "Confidential info"), title: "Secret Guide"
+
+    get library_search_url, params: { q: "Secret" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+    assert_select "p.search__no_matches", text: "No matches."
+  end
+
+  test "search handles apostrophes without server error" do
+    leaves(:welcome_page).update!(title: "It's a great handbook")
+
+    get library_search_url, params: { q: "It's" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /It's a great handbook/
+
+    get library_search_url, params: { q: "'" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /It's a great handbook/
+  end
+
+  test "search handles punctuation without server error" do
+    leaves(:welcome_page).update!(title: "Hello! (world)? [yes] #1 @home & <more>")
+
+    get library_search_url, params: { q: "Hello! (world)? [yes] #1 @home & <more>" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 1
+  end
+
+  test "search treats percent sign literally without acting as wildcard" do
+    leaf_pct = books(:handbook).press Page.new(body: "Discount body"), title: "Save 50% off"
+    leaf_other = books(:handbook).press Page.new(body: "Other body"), title: "Save 50 dollars off"
+
+    # Search for "Save 50% off" finds only the percent title
+    get library_search_url, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50 dollars off/, count: 0
+
+    # Search for "%" alone finds only the page containing %
+    get library_search_url, params: { q: "%" }
+    assert_response :success
+    assert_select "a.search__result", text: /Save 50% off/
+    assert_select "a.search__result", text: /Save 50 dollars off/, count: 0
+  end
+
+  test "search treats underscore literally without acting as wildcard" do
+    leaf_und = books(:handbook).press Page.new(body: "Underscore page"), title: "my_variable_name"
+    leaf_other = books(:handbook).press Page.new(body: "Hyphen page"), title: "my-variable-name"
+
+    get library_search_url, params: { q: "my_variable" }
+    assert_response :success
+    assert_select "a.search__result", text: /my_variable_name/
+    assert_select "a.search__result", text: /my-variable-name/, count: 0
+
+    get library_search_url, params: { q: "_" }
+    assert_response :success
+    assert_select "a.search__result", text: /my_variable_name/
+    assert_select "a.search__result", text: /my-variable-name/, count: 0
+  end
+
+  test "search allows signed out users to search published books" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    get library_search_url, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "search does not reveal unpublished books to signed out users" do
+    sign_out
+    books(:handbook).update!(published: false)
+
+    get library_search_url, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select "a.search__result", count: 0
+  end
+end
