 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,48 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "uploading a picture derives once and does not duplicate on reader request" do
+    put leafable_path(leaves(:reading_picture)), params: {
+      picture: {
+        image: fixture_file_upload("white-rabbit.webp", "image/webp")
+      }
+    }
+    assert_response :no_content
+
+    # Run CreateVariantsJob and cascaded TransformJob
+    perform_enqueued_jobs
+    perform_enqueued_jobs
+
+    picture = leaves(:reading_picture).reload.leafable
+    assert_equal 1, picture.image.blob.variant_records.count
+
+    initial_blob_count = ActiveStorage::Blob.count
+    initial_variant_count = ActiveStorage::VariantRecord.count
+
+    # Reader opens the page
+    sign_out
+    books(:handbook).update!(published: true)
+
+    get leafable_slug_path(leaves(:reading_picture))
+    assert_response :ok
+
+    # Fetch the image URL rendered on the page
+    img_url = response.body.scan(/img[^>]+src="([^">]+rails\/active_storage\/representations[^">]+)"/).flatten.first
+    assert_not_nil img_url
+
+    get img_url
+    assert_response :redirect
+
+    assert_no_difference -> { ActiveStorage::Blob.count } do
+      assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+        get response.location
+        assert_response :ok
+      end
+    end
+
+    assert_equal initial_blob_count, ActiveStorage::Blob.count
+    assert_equal initial_variant_count, ActiveStorage::VariantRecord.count
+    assert_equal 1, picture.image.blob.variant_records.count
+  end
 end
