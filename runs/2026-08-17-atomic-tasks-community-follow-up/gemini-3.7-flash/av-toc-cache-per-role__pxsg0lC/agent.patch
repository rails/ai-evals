diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..47bcd9f 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,97 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "show caching TOC correctly separates reader and editor and avoids N+1 queries" do
+    ActionController::Base.perform_caching = true
+    cache_store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.cache_store = cache_store
+    ActionView::PartialRenderer.collection_cache = cache_store
+    Rails.cache = cache_store
+
+    book = books(:handbook)
+    # Create 20 more leaves to test scale
+    20.times do |i|
+      page = Page.create!(body: "Page content #{i}")
+      book.press(page, title: "Extra Page #{i}")
+    end
+
+    # 1. Sign in as editor (kevin)
+    sign_in :kevin
+    queries_miss_editor = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*args|
+      event = ActiveSupport::Notifications::Event.new(*args)
+      queries_miss_editor << event.payload[:sql] unless event.payload[:name] == "SCHEMA"
+    end
+    get book_slug_url(book)
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 24
+
+    # 2. Sign in as reader (jz)
+    sign_in :jz
+    queries_miss_reader = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*args|
+      event = ActiveSupport::Notifications::Event.new(*args)
+      queries_miss_reader << event.payload[:sql] unless event.payload[:name] == "SCHEMA"
+    end
+    get book_slug_url(book)
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 0
+
+    # 3. Sign in as editor (kevin) again (cache hit)
+    sign_in :kevin
+    queries_hit_editor = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*args|
+      event = ActiveSupport::Notifications::Event.new(*args)
+      queries_hit_editor << event.payload[:sql] unless event.payload[:name] == "SCHEMA"
+    end
+    get book_slug_url(book)
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 24
+
+    # 4. Sign in as reader (jz) again (cache hit)
+    sign_in :jz
+    queries_hit_reader = []
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*args|
+      event = ActiveSupport::Notifications::Event.new(*args)
+      queries_hit_reader << event.payload[:sql] unless event.payload[:name] == "SCHEMA"
+    end
+    get book_slug_url(book)
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 0
+
+    # 5. Rename a leaf and verify it updates for both editor and reader
+    sign_in :kevin
+    leaf = book.leaves.first
+    leaf.update!(title: "Renamed Title 12345")
+
+    # Editor sees new title
+    get book_slug_url(book)
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 24
+    assert_select ".toc__title", text: "Renamed Title 12345"
+
+    # Reader sees new title and no edit controls
+    sign_in :jz
+    get book_slug_url(book)
+    assert_response :success
+    assert_select ".toc__link.hide_from_reading_mode", count: 0
+    assert_select ".toc__title", text: "Renamed Title 12345"
+
+    assert queries_hit_editor.size < 10, "Expected few queries on cache hit, got #{queries_hit_editor.size}"
+    assert queries_hit_reader.size < 10, "Expected few queries on cache hit, got #{queries_hit_reader.size}"
+  ensure
+    ActionController::Base.perform_caching = false
+    Rails.cache = ActiveSupport::Cache::NullStore.new
+    ActionController::Base.cache_store = Rails.cache
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
 end
