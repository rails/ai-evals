@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compact_positions! densely reindexes leaves by position_score" do
+    # Rearrange leaves so position_score order differs from id / creation order
+    leaves(:welcome_page).move_to_position(0)
+    ordered_leaves = @book.leaves.order(:position_score, :id).to_a
+
+    @book.compact_positions!
+
+    assert_equal ordered_leaves.map(&:id), @book.leaves.reload.order(:position_score, :id).pluck(:id)
+    assert_equal (1..@book.leaves.count).map(&:to_f), @book.leaves.order(:position_score, :id).pluck(:position_score)
+  end
+
+  test "compact_positions! preserves relative ordering of trashed leaves" do
+    leaves(:summary_page).trashed!
+
+    @book.compact_positions!
+
+    assert_equal (1..@book.leaves.count).map(&:to_f), @book.leaves.order(:position_score, :id).pluck(:position_score)
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:reading_picture) ], @book.leaves.active.positioned.to_a
+
+    leaves(:summary_page).active!
+    assert_equal [ leaves(:welcome_section), leaves(:welcome_page), leaves(:summary_page), leaves(:reading_picture) ], @book.leaves.active.positioned.to_a
+  end
+
+  test "live_leaf_count returns count of active leaves" do
+    initial_count = @book.live_leaf_count
+    assert_equal @book.leaves.active.count, initial_count
+
+    leaves(:summary_page).trashed!
+    assert_equal initial_count - 1, @book.live_leaf_count
+  end
+end
