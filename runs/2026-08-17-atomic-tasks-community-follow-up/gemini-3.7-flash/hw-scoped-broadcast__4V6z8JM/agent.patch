diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..1a711c4 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,34 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "edit subscribes to user-specific stream for being edited" do
+    get edit_leafable_path(leaves(:welcome_page))
+
+    assert_response :ok
+    assert_select "turbo-cable-stream-source[signed-stream-name=\"#{Turbo::StreamsChannel.signed_stream_name([ users(:kevin), leaves(:welcome_page), :being_edited ])}\"]"
+  end
+
+  test "update broadcasts being edited indicator to all editors of the book" do
+    assert_enqueued_with(job: Turbo::Streams::BroadcastJob, args: ->(args) {
+      args.first == Turbo::StreamsChannel.send(:stream_name_from, [ users(:kevin), leaves(:welcome_page), :being_edited ])
+    }) do
+      assert_enqueued_with(job: Turbo::Streams::BroadcastJob, args: ->(args) {
+        args.first == Turbo::StreamsChannel.send(:stream_name_from, [ users(:david), leaves(:welcome_page), :being_edited ])
+      }) do
+        put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Updated title" }, page: { body: "New body" } }
+      end
+    end
+  end
+
+  test "update does not broadcast to removed collaborator or readers" do
+    books(:handbook).access_for(user: users(:jz)).destroy # removed collaborator
+
+    put leafable_path(leaves(:welcome_page)), params: { leaf: { title: "Updated title" }, page: { body: "New body" } }
+
+    enqueued_streams = enqueued_jobs.select { |job| job[:job] == Turbo::Streams::BroadcastJob }.map { |job| job[:args].first }
+    jz_stream = Turbo::StreamsChannel.send(:stream_name_from, [ users(:jz), leaves(:welcome_page), :being_edited ])
+
+    assert_not_includes enqueued_streams, jz_stream
+  end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..6015667 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,13 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+
+  test "editors includes administrators and active users with editor access" do
+    book = books(:handbook)
+
+    assert_includes book.editors, users(:david) # administrator
+    assert_includes book.editors, users(:jason) # administrator
+    assert_includes book.editors, users(:kevin) # editor
+    assert_not_includes book.editors, users(:jz) # reader
+  end
 end
