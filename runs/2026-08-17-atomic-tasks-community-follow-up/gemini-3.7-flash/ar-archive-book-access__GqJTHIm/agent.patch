diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..06cf1c9 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,44 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroy archives accesses at moment of deletion" do
+    book = books(:handbook)
+    assert_operator book.accesses.count, :>, 0
+    expected_accesses = book.accesses.map { |a| [ a.user_id, a.user.name, a.level ] }
+
+    assert_difference -> { AccessArchive.count }, expected_accesses.size do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected_accesses.size, archives.count
+    expected_accesses.each do |user_id, user_name, level|
+      archive = archives.find_by(user_id: user_id)
+      assert_not_nil archive
+      assert_equal book.title, archive.book_title
+      assert_equal user_name, archive.user_name
+      assert_equal level, archive.level
+    end
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "destroy does not archive revoked accesses" do
+    book = books(:manual)
+    # Revoke access for jz
+    book.accesses.where(user: users(:jz)).destroy_all
+
+    assert_no_difference -> { AccessArchive.where(user_id: users(:jz).id).count } do
+      book.destroy
+    end
+  end
+
+  test "destroy on book without accesses writes no archives" do
+    book = Book.create!(title: "Unshared Book", everyone_access: false)
+    assert_equal 0, book.accesses.count
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+  end
 end
