diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..2773325
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search finds leaves in books the user can access" do
+    get library_search_url, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "search does not find leaves in books the user cannot access" do
+    books(:manual).press Page.new(body: "Manual Content"), title: "Manual Secret Page"
+
+    get library_search_url, params: { q: "Manual Secret" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Manual Secret Page/, count: 0
+  end
+
+  test "search finds leaves in published books when signed out" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    get library_search_url, params: { q: "Welcome" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Welcome to The Handbook!/
+  end
+
+  test "search with apostrophe does not cause server error" do
+    books(:handbook).press Page.new(body: "Content"), title: "It's a wonderful life"
+
+    get library_search_url, params: { q: "It's" }
+
+    assert_response :success
+    assert_select ".search__result", text: /It's a wonderful life/
+  end
+
+  test "search with percent sign finds literal percent and does not act as wildcard" do
+    books(:handbook).press Page.new(body: "Content"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "Content"), title: "Save 500 off"
+
+    get library_search_url, params: { q: "50%" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Save 50% off/
+    assert_select ".search__result", text: /Save 500 off/, count: 0
+
+    get library_search_url, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Save 50% off/
+    assert_select ".search__result", text: /Save 500 off/, count: 0
+  end
+
+  test "search with underscore finds literal underscore and does not act as wildcard" do
+    books(:handbook).press Page.new(body: "Content"), title: "Tom_Jerry"
+    books(:handbook).press Page.new(body: "Content"), title: "TomAJerry"
+
+    get library_search_url, params: { q: "Tom_Jerry" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Tom_Jerry/
+    assert_select ".search__result", text: /TomAJerry/, count: 0
+
+    get library_search_url, params: { q: "_" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Tom_Jerry/
+    assert_select ".search__result", text: /TomAJerry/, count: 0
+  end
+
+  test "search with empty query returns no leaves" do
+    get library_search_url, params: { q: "" }
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+end
