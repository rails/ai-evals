diff --git a/test/controllers/tenant_isolation_test.rb b/test/controllers/tenant_isolation_test.rb
new file mode 100644
index 0000000..68c342d
--- /dev/null
+++ b/test/controllers/tenant_isolation_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Tenant A")
+    @tenant_b = Tenant.create!(name: "Tenant B")
+
+    @user_a = @tenant_a.users.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", role: :member)
+    @user_b = @tenant_b.users.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456", role: :administrator)
+
+    @book_a = @tenant_a.books.create!(title: "Alice Book", everyone_access: true)
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+
+    @book_b = @tenant_b.books.create!(title: "Bob Book", everyone_access: true)
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+    @page_b = @book_b.press Page.new(body: "Bob's secret page content"), title: "Bob Page"
+    @page_b.edit leafable_params: { body: "Bob's updated secret page content" }
+    @edit_b = @page_b.edits.last
+
+    # Add an access row spraying reader across tenants:
+    @book_b.accesses.create!(user: @user_a, level: :reader)
+  end
+
+  test "creating a book assigns current user tenant" do
+    sign_in @user_a
+
+    post books_url, params: { book: { title: "Alice's Second Book", everyone_access: true } }
+    new_book = Book.find_by(title: "Alice's Second Book")
+    assert_equal @tenant_a, new_book.tenant
+  end
+
+  test "user cannot see other tenant's books in index, even if published or having access row" do
+    @book_b.update!(published: true)
+    sign_in @user_a
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Alice Book"
+    assert_select "h2", text: "Bob Book", count: 0
+  end
+
+  test "user gets 404 when requesting other tenant's book" do
+    sign_in @user_a
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+
+    get edit_book_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "user gets 404 when requesting other tenant's page or leafable" do
+    sign_in @user_a
+
+    get leafable_slug_path(@page_b)
+    assert_response :not_found
+
+    get edit_leafable_path(@page_b)
+    assert_response :not_found
+  end
+
+  test "user gets 404 when requesting other tenant's page edit history" do
+    sign_in @user_a
+
+    get page_edit_url(@page_b, @edit_b)
+    assert_response :not_found
+
+    get page_edit_url(@page_b, "latest")
+    assert_response :not_found
+  end
+
+  test "user gets 404 when searching other tenant's book" do
+    sign_in @user_a
+
+    post book_search_url(@book_b), params: { search: "Bob" }
+    assert_response :not_found
+  end
+
+  test "user gets 404 when accessing bookmarks of other tenant's book" do
+    sign_in @user_a
+
+    get book_bookmark_url(@book_b)
+    assert_response :not_found
+  end
+
+  test "signed out visitor can see published books from all tenants" do
+    @book_a.update!(published: true)
+    @book_b.update!(published: true)
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Alice Book"
+    assert_select "h2", text: "Bob Book"
+
+    get book_slug_url(@book_b)
+    assert_response :success
+
+    get leafable_slug_path(@page_b)
+    assert_response :success
+  end
+
+  test "/users lists all users across tenants" do
+    sign_in @user_a
+
+    get users_url
+    assert_response :success
+    assert_select "a", text: /Alice/
+    assert_select "a", text: /Bob/
+  end
+end
diff --git a/test/models/tenant_test.rb b/test/models/tenant_test.rb
new file mode 100644
index 0000000..7cabdf5
--- /dev/null
+++ b/test/models/tenant_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TenantTest < ActiveSupport::TestCase
+  test "books and users belonging to different tenants" do
+    tenant_a = Tenant.create!(name: "Tenant A")
+    tenant_b = Tenant.create!(name: "Tenant B")
+
+    user_a = tenant_a.users.create!(name: "User A", email_address: "usera@example.com", password: "password123")
+    user_b = tenant_b.users.create!(name: "User B", email_address: "userb@example.com", password: "password123")
+
+    book_a = tenant_a.books.create!(title: "Book A", everyone_access: true)
+    book_a.update_access(editors: [ user_a.id ], readers: [])
+
+    book_b = tenant_b.books.create!(title: "Book B", everyone_access: true)
+    book_b.update_access(editors: [ user_b.id ], readers: [])
+
+    # Even if an access row exists for user_a on book_b:
+    book_b.accesses.create!(user: user_a, level: :reader)
+
+    # user_a should see book_a in accessable_or_published, but not book_b
+    assert_includes Book.accessable_or_published(user: user_a), book_a
+    assert_not_includes Book.accessable_or_published(user: user_a), book_b
+
+    # book_b is not accessable? or editable? to user_a
+    assert_not book_b.accessable?(user: user_a)
+    assert_not book_b.editable?(user: user_a)
+
+    # published book_b is also not in accessable_or_published for user_a
+    book_b.update!(published: true)
+    assert_not_includes Book.accessable_or_published(user: user_a), book_b
+
+    # but for signed-out visitors, published books are visible
+    assert_includes Book.accessable_or_published(user: nil), book_b
+  end
+end
