+
+  test "destroying a page purges attached markdown uploads" do
+    page = Page.create!(body: "Some content")
+    page.body.uploads.attach(
+      io: file_fixture("reading.webp").open,
+      filename: "reading.webp",
+      content_type: "image/webp"
+    )
+    page.save!
+
+    blob = page.body.uploads.first.blob
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert ActiveStorage::Blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      page.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
+
+  test "destroying a leaf purges attached markdown uploads from page" do
+    leaf = books(:manual).press Page.new(body: "Some content"), title: "Page with Uploads"
+    page = leaf.page
+    page.body.uploads.attach(
+      io: file_fixture("reading.webp").open,
+      filename: "reading.webp",
+      content_type: "image/webp"
+    )
+    page.save!
+
+    blob = page.body.uploads.first.blob
+    assert ActiveStorage::Blob.exists?(blob.id)
+    assert ActiveStorage::Blob.service.exist?(blob.key)
+
+    perform_enqueued_jobs do
+      leaf.destroy!
+    end
+
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not ActiveStorage::Blob.service.exist?(blob.key)
+  end
 end
