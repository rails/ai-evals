diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..82cd3ba 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -17,4 +17,60 @@ class UserTest < ActiveSupport::TestCase
 
     assert_not other_book.accessable?(user: bob)
   end
+
+  test "erase completely removes user and their private books, reading marks, sessions, and sign in events" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    session = user.sessions.create!(ip_address: "127.0.0.1", user_agent: "TestAgent")
+    SignInEvent.create!(email_address: "alice@example.com", action: "signed_in", ip_address: "127.0.0.1", user_agent: "TestAgent")
+
+    private_book = Book.create!(title: "Alice Private Diary", author: "Alice", creator: user, everyone_access: false)
+    page = Page.create!(body: "Top secret content about quantum_physics_xyz")
+    leaf = private_book.leaves.create!(leafable: page, title: "Secret Leaf", position_score: 1.0)
+    leaf.edit(leafable_params: { body: "Updated secret content about quantum_physics_xyz" })
+    ReadingMark.remember(leaf, user: user)
+
+    everyone_book = Book.create!(title: "Alice Public Novel", author: "Alice", creator: user, everyone_access: true)
+    pub_page = Page.create!(body: "Public story content")
+    everyone_book.leaves.create!(leafable: pub_page, title: "Public Leaf", position_score: 1.0)
+    ReadingMark.remember(pub_page.leaf, user: user)
+
+    assert_equal 1, Leaf.search("quantum_physics_xyz").load.size
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_equal 0, Session.where(user_id: user.id).count
+    assert_equal 0, SignInEvent.where(email_address: "alice@example.com").count
+    assert_equal 0, ReadingMark.where(user_id: user.id).count
+    assert_equal 0, Access.where(user_id: user.id).count
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_empty Leaf.search("quantum_physics_xyz")
+    fts_hits = Leaf.connection.execute("SELECT count(*) FROM leaf_search_index WHERE leaf_search_index MATCH 'quantum_physics_xyz'").first.values.first
+    assert_equal 0, fts_hits
+
+    everyone_book.reload
+    assert_equal "Deleted author", everyone_book.author
+    assert_nil everyone_book.creator_id
+    assert_equal 1, everyone_book.leaves.count
+  end
+
+  test "erase works on already deactivated users with rewritten email" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    SignInEvent.create!(email_address: "alice@example.com", action: "signed_in", ip_address: "127.0.0.1", user_agent: "TestAgent")
+    user.update_columns(active: false, email_address: "alice-deactivated-#{SecureRandom.uuid}@example.com")
+
+    private_book = Book.create!(title: "Alice Private Notes", author: "Alice", creator: user, everyone_access: false)
+    everyone_book = Book.create!(title: "Alice Shared Manual", author: "Alice", creator: user, everyone_access: true)
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_equal 0, SignInEvent.where(email_address: "alice@example.com").count
+    assert_nil Book.find_by(id: private_book.id)
+
+    everyone_book.reload
+    assert_equal "Deleted author", everyone_book.author
+    assert_nil everyone_book.creator_id
+  end
 end
