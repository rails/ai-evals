+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "cleans stray quotes from leaf titles" do
+    leaf1 = Leaf.create!(book: @book, leafable: Page.create!, title: '"Hello World"', position_score: 100)
+    leaf2 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Quoted Title""', position_score: 101)
+    leaf3 = Leaf.create!(book: @book, leafable: Page.create!, title: '"Legitimate "inner quote""', position_score: 102)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Hello World", leaf1.reload.title
+    assert_equal '"Quoted Title"', leaf2.reload.title
+    assert_equal 'Legitimate "inner quote"', leaf3.reload.title
+  end
+
+  test "is resumable and continues from where it left off when interrupted" do
+    leaf1 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Legitimate Quote""', position_score: 100)
+    leaf2 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Another Quote""', position_score: 101)
+    leaf3 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Third Quote""', position_score: 102)
+
+    TitleCleanupJob.perform_later
+
+    # Interrupt the job after leaf1 is processed (cursor at leaf1.id + 1)
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaf1.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    # leaf1 has been cleaned once
+    assert_equal '"Legitimate Quote"', leaf1.reload.title
+    # leaf2 and leaf3 not yet processed in first run because interrupted
+    assert_equal '""Another Quote""', leaf2.reload.title
+    assert_equal '""Third Quote""', leaf3.reload.title
+
+    # Resume and run the remaining enqueued job
+    perform_enqueued_jobs
+
+    # leaf1 must NOT have been cleaned twice (which would make it Legitimate Quote without quotes)
+    assert_equal '"Legitimate Quote"', leaf1.reload.title
+    assert_equal '"Another Quote"', leaf2.reload.title
+    assert_equal '"Third Quote"', leaf3.reload.title
+  end
+
+  test "handles multiple interruptions across non-contiguous IDs" do
+    leaf1 = Leaf.create!(book: @book, leafable: Page.create!, title: '""First""', position_score: 100)
+    leaf2 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Second""', position_score: 101)
+    leaf3 = Leaf.create!(book: @book, leafable: Page.create!, title: '""Third""', position_score: 102)
+
+    TitleCleanupJob.perform_later
+
+    # First interruption after leaf1
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaf1.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal '"First"', leaf1.reload.title
+    assert_equal '""Second""', leaf2.reload.title
+    assert_equal '""Third""', leaf3.reload.title
+
+    # Second interruption after leaf2
+    interrupt_job_during_step(TitleCleanupJob, :clean_titles, cursor: leaf2.id + 1) do
+      perform_enqueued_jobs
+    end
+
+    assert_equal '"First"', leaf1.reload.title
+    assert_equal '"Second"', leaf2.reload.title
+    assert_equal '""Third""', leaf3.reload.title
+
+    # Finish remaining
+    perform_enqueued_jobs
+
+    assert_equal '"First"', leaf1.reload.title
+    assert_equal '"Second"', leaf2.reload.title
+    assert_equal '"Third"', leaf3.reload.title
+  end
+end
