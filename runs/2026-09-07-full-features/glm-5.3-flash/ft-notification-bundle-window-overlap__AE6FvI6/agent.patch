+module Notification::Emailable
+  extend ActiveSupport::Concern
+
+  included do
+    # Notification emails are bundled into windows rather than sent one by one.
+    after_save_commit :bundle_email_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_email_later
+    Notification::BundleEmailJob.perform_later(self)
+  end
+
+  def bundle_email
+    Notification::EmailBundle.bundle(self)
+  end
+end
