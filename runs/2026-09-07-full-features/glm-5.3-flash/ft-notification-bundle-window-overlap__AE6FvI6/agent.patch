+      end
+    end
+  end
+
+  test "update picks how often notification emails are bundled" do
+    assert_changes -> { @user.settings.reload.bundle_email_frequency }, from: "never", to: "weekly" do
+      patch notifications_settings_path, params: { settings: { bundle_email_frequency: "weekly" } }
+    end
+
+    assert_redirected_to notifications_settings_path
+  end
 end
