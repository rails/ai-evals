+class NotificationMailer < ApplicationMailer
+  def bundle(email_bundle)
+    @email_bundle = email_bundle
+    @user = email_bundle.user
+    @notifications = email_bundle.notifications.preloaded.order(:created_at)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "#{@notifications.size} new #{'notification'.pluralize(@notifications.size)}"
+    )
+  end
+end
