+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  # The API mirrors the activity shown in the HTML timeline, except that it omits
+  # the deprecated `card_collection_changed` and includes `card_title_changed`.
+  ACTIVITY_ACTIONS = (Event::TIMELINEABLE_ACTIONS - %w[ card_collection_changed ] + %w[ card_title_changed ]).freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+    fresh_when etag: [ @page.records, Current.user ]
+  end
+
+  private
+    def activities
+      scope = Event.preloaded.where(board: boards).where(action: ACTIVITY_ACTIONS)
+      scope = scope.where(creator_id: @filter.creators.ids) if @filter.creators.present?
+      scope.reverse_chronologically
+    end
+
+    def boards
+      @filter.boards.presence || Current.user.boards
+    end
+end
