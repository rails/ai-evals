diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..5c04626 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,29 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # The particulars revealed by the activities API: assignment changes reveal the
+  # assignees, board and title changes reveal the before and after values, and
+  # triage events reveal the column. Every other action reveals nothing.
+  def api_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular("old_board"), new_board: particular("new_board") }
+    when "card_title_changed"
+      { old_title: particular("old_title"), new_title: particular("new_title") }
+    when "card_triaged"
+      { column: particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    # Depending on how an event was tracked, its particulars are either stored at
+    # the top level of the JSON attribute or nested under the "particulars" key.
+    def particular(key)
+      (particulars.dig("particulars", key) || particulars[key]).to_s
+    end
 end
