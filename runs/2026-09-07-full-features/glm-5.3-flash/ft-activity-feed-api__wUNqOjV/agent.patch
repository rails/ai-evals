@@ -0,0 +1,80 @@
+# Activities
+
+Activities are the events that make up an account's history: cards being added, moved,
+assigned, renamed, and commented on. They are the same events you see in the HTML
+timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of the activity the current user can access, newest first.
+
+The API returns the same activity as the HTML timeline, with two exceptions: the
+deprecated `card_collection_changed` action is omitted, and `card_title_changed` is
+included.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David assigned JZ to &quot;Buy the domain&quot;",
+    "particulars": {
+      "assignee_ids": [ "03f5v9zjvypwh0t0e2rfh0h7j" ]
+    },
+    "url": "http://app.fizzy.localhost:3006/686465299/cards/5",
+    "eventable_type": "Card",
+    "eventable": { "...": "..." },
+    "board": { "...": "..." },
+    "creator": { "...": "..." }
+  }
+]
+```
+
+| Attribute | Description |
+|-----------|-------------|
+| `id` | The id of the activity |
+| `action` | The action that took place, e.g. `card_assigned` or `comment_created` |
+| `created_at` | When the activity took place |
+| `description` | The description of the activity in plain text |
+| `particulars` | Event specific details, see below |
+| `url` | The URL to open. For card activity this is the card, for comment activity it's the card, positioned at the comment |
+| `eventable_type` | The type of the subject of the activity, e.g. `Card` or `Comment` |
+| `eventable` | The subject of the activity: a [card](cards.md) or a [comment](comments.md) |
+| `board` | The [board](boards.md) the activity belongs to |
+| `creator` | The [user](users.md) who performed the activity |
+
+## Particulars
+
+The `particulars` object exposes the details of the action that took place. Actions
+without details return an empty object.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Missing values are returned as empty strings.
+
+## Filtering
+
+Activity can be filtered by passing the following parameters:
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only return activity created by these users |
+| `board_ids[]` | Only return activity on these boards |
+
+Boards you don't have access to are never included, regardless of the parameters you pass.
+
+__Example using curl:__
+
+```bash
+curl -H "Authorization: Bearer put-your-access-token-here" \
+  -H "Accept: application/json" \
+  "http://app.fizzy.localhost:3006/686465299/activities?creator_ids[]=03f5v9zjw7pz8717a4no1h8a7"
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..dbddfd3
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns the account activity" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any? { it["id"] == events(:layout_assignment_jz).id }
+  end
+
+  test "index as JSON returns the newest activity first" do
+    travel_to 2.hours.ago do
+      track_title_change_of cards(:buy_domain), to: "Buy the domain"
+    end
+
+    get activities_path, as: :json
+
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON includes the activity attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:layout_assignment_jz).created_at.utc.as_json, activity["created_at"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_includes activity["description"], "David assigned"
+    assert_equal card_url(cards(:layout)), activity["url"]
+  end
+
+  test "index as JSON omits the deprecated collection changed events" do
+    events(:layout_published).update!(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.collect { it["action"] }, "card_collection_changed"
+  end
+
+  test "index as JSON includes card title changed events" do
+    travel_to 2.hours.ago do
+      track_title_change_of cards(:buy_domain), to: "Buy the domain"
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["action"] == "card_title_changed" }
+
+    assert_equal cards(:buy_domain).id, activity.dig("eventable", "id")
+    assert_equal({ "old_title" => "Buy domain", "new_title" => "Buy the domain" }, activity["particulars"])
+    assert_equal card_url(cards(:buy_domain)), activity["url"]
+  end
+
+  test "index as JSON includes the assignees of assignment activity" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:david)) { cards(:buy_domain).toggle_assignment(users(:jz)) }
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["id"] == cards(:buy_domain).events.where(action: "card_assigned").last.id }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes the boards of board changed activity" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:david)) { cards(:buy_domain).move_to(boards(:private)) }
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["action"] == "card_board_changed" }
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+    assert_equal boards(:private).id, activity.dig("board", "id")
+  end
+
+  test "index as JSON includes the column of triage activity" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:david)) { cards(:buy_domain).triage_into(columns(:writebook_in_progress)) }
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["action"] == "card_triaged" }
+
+    assert_equal({ "column" => "In progress" }, activity["particulars"])
+  end
+
+  test "index as JSON returns empty particulars for activity without particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["id"] == events(:buy_domain_sent_back_to_triage).id }
+
+    assert_equal "card_sent_back_to_triage", activity["action"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    events(:layout_published).update_columns(action: "card_board_changed")
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_published).id }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "index as JSON links comment activity to the commented card" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(cards(:layout), anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_includes activity["description"], "David commented on"
+  end
+
+  test "index as JSON filters activity by creators" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+
+    assert_not_empty @response.parsed_body
+    assert_equal users(:kevin).id, @response.parsed_body.collect { it.dig("creator", "id") }.uniq.first
+  end
+
+  test "index as JSON filters activity by boards" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:kevin)) do
+        boards(:private).cards.create!(title: "A private card", creator: users(:kevin), status: "published")
+      end
+    end
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_not_includes @response.parsed_body.collect { it.dig("eventable", "title") }, "A private card"
+  end
+
+  test "index as JSON omits activity from boards the user cannot access" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:kevin)) do
+        boards(:private).cards.create!(title: "A private card", creator: users(:kevin), status: "published")
+      end
+    end
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.collect { it.dig("eventable", "title") }, "A private card"
+    assert_not_includes @response.parsed_body.collect { it.dig("board", "name") }, "Private board"
+  end
+
+  test "index as JSON paginates the activity" do
+    travel_to 2.hours.ago do
+      with_current_user(users(:kevin)) do
+        20.times { |index| cards(:buy_domain).update!(title: "Buy the domain #{index}") }
+      end
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.count
+    assert_equal Event.count.to_s, @response.headers["X-Total-Count"]
+    assert @response.headers["Link"].present?
+  end
+
+  private
+    def track_title_change_of(card, to:)
+      with_current_user(users(:david)) { card.update!(title: to) }
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..43764bf
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment events expose the assignees" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.api_particulars)
+  end
+
+  test "board changed events expose the old and the new board" do
+    event = events(:logo_published).tap do
+      it.update_columns action: "card_board_changed", particulars: { particulars: { old_board: "Writebook", new_board: "Private board" } }
+    end
+
+    assert_equal({ old_board: "Writebook", new_board: "Private board" }, event.api_particulars)
+  end
+
+  test "title changed events expose the old and the new title" do
+    event = events(:logo_published).tap do
+      it.update_columns action: "card_title_changed", particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    end
+
+    assert_equal({ old_title: "Old title", new_title: "New title" }, event.api_particulars)
+  end
+
+  test "triaged events expose the column" do
+    event = events(:logo_published).tap do
+      it.update_columns action: "card_triaged", particulars: { particulars: { column: "In progress" } }
+    end
+
+    assert_equal({ column: "In progress" }, event.api_particulars)
+  end
+
+  test "events without particulars expose nothing" do
+    assert_equal({}, events(:logo_published).api_particulars)
+    assert_equal({}, events(:buy_domain_sent_back_to_triage).api_particulars)
+    assert_equal({}, events(:layout_commented).api_particulars)
+  end
+
+  test "missing particulars are exposed as empty strings" do
+    event = events(:logo_published).tap { it.update_columns action: "card_board_changed" }
+
+    assert_equal({ old_board: "", new_board: "" }, event.api_particulars)
+  end
+end
