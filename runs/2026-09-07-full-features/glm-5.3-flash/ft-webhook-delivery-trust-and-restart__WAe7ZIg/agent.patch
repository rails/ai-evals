diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..3b05c54
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,63 @@
+# Keeps track of how a webhook receiver is behaving. Receivers that keep
+# failing get their webhook deactivated automatically, so that we stop
+# hammering something that isn't listening anymore.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A webhook is deactivated after this many consecutive failed deliveries.
+  FAILURE_LIMIT = 10
+
+  # Failures only count towards the limit while the streak is younger than
+  # this, so a receiver that fails sporadically is left alone.
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset_failures
+  end
+
+  def record_failure
+    if streak_expired?
+      start_streak
+    else
+      extend_streak
+    end
+
+    deactivate_webhook_if_delinquent
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_LIMIT
+  end
+
+  def reset_failures
+    update! consecutive_failures_count: 0, first_failure_at: nil unless clean?
+  end
+
+  private
+    def clean?
+      consecutive_failures_count.zero? && first_failure_at.nil?
+    end
+
+    # A streak we haven't touched in a while is old news, so we start over.
+    def streak_expired?
+      first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+    end
+
+    def start_streak
+      update! consecutive_failures_count: 1, first_failure_at: Time.current
+    end
+
+    def extend_streak
+      update! \
+        consecutive_failures_count: consecutive_failures_count + 1,
+        first_failure_at: first_failure_at || Time.current
+    end
+
+    def deactivate_webhook_if_delinquent
+      return unless delinquent?
+
+      webhook.deactivate
+      reset_failures
+    end
+end
