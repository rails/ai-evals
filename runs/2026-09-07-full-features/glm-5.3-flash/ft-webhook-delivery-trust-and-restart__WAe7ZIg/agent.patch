diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..774c1f6
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker!
+  end
+
+  test "webhooks get a tracker when they are created" do
+    webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "record_failure counts consecutive failures" do
+    3.times { @tracker.record_failure }
+
+    assert_equal 3, @tracker.reload.consecutive_failures_count
+    assert @tracker.reload.first_failure_at.present?
+  end
+
+  test "record_failure deactivates the webhook after ten consecutive failures" do
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      10.times { @tracker.record_failure }
+    end
+  end
+
+  test "a deactivated webhook starts over with a clean slate" do
+    10.times { @tracker.record_failure }
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.reload.first_failure_at
+  end
+
+  test "record_failure starts over when the last streak is older than an hour" do
+    @tracker.update! consecutive_failures_count: Webhook::DelinquencyTracker::FAILURE_LIMIT - 1, first_failure_at: 2.hours.ago
+
+    @tracker.record_failure
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?, "a webhook that fails sporadically is left alone"
+  end
+
+  test "record_success resets the failures" do
+    @tracker.update! consecutive_failures_count: 4, first_failure_at: Time.current
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.reload.first_failure_at
+  end
+
+  test "activating a webhook resets the failures" do
+    @tracker.update! consecutive_failures_count: 4, first_failure_at: Time.current
+    @webhook.update! active: false
+
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+  end
+end
