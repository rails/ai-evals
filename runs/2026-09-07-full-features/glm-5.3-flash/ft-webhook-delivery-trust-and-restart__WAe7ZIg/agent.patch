+  # Posts the event to the receiver and records how that went. A delivery is
+  # only ever posted once, even when the job running it gets retried, and
+  # never at all once the webhook has been switched off.
+  def deliver
+    return if delivered? || !webhook.active?
+    return unless claim
+
+    record response: post_event
+  end
+
+  def delivered?
+    completed? || errored?
+  end
+
+  def succeeded?
+    completed? && response[:error].blank? && response[:code].between?(200, 299)
+  end
+
+  def failed?
+    (errored? || completed?) && !succeeded?
+  end
 
