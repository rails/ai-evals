@@ -22,11 +81,86 @@ class Webhook::Delivery < ApplicationRecord
     end
   end
 
-  def failed?
-    (errored? || completed?) && !succeeded?
-  end
+  private
+    # Moves the delivery out of the queue, so that nobody else posts it: two
+    # workers racing for the same delivery can't both claim it.
+    def claim
+      self.class.where(id: id, state: [ :pending, :in_progress ])
+        .update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
 
-  def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
-  end
+    def record(response:)
+      self.request = { "headers" => headers }
+      self.response = response
+      self.state = response[:code] ? :completed : :errored
+
+      save!
+
+      succeeded? ? webhook.record_delivery_success : webhook.record_delivery_failure
+    end
+
+    def post_event
+      uri = URI.parse(webhook.url)
+
+      case address = resolve_destination(uri)
+      when :unresolved then post_to(uri)
+      when nil then { error: :destination_unreachable }
+      else post_to(uri, ip: address)
+      end
+    rescue *UNREACHABLE_ERRORS, URI::InvalidURIError
+      { error: :destination_unreachable }
+    rescue *TIMEOUT_ERRORS
+      { error: :timeout }
+    rescue OpenSSL::SSL::SSLError
+      { error: :ssl_error }
+    rescue StandardError
+      { error: :delivery_failed }
+    end
+
+    def post_to(uri, ip: nil)
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = payload
+
+      response = connection_for(uri, ip: ip).start { |connection| connection.request(request) }
+      { code: response.code.to_i }
+    end
+
+    def connection_for(uri, ip: nil)
+      connection = Net::HTTP.new(uri.host, uri.port)
+      connection.use_ssl = uri.is_a?(URI::HTTPS)
+      connection.open_timeout = connection.read_timeout = connection.write_timeout = TIMEOUT
+      connection.ipaddr = ip if ip
+      connection
+    end
+
+    # We resolve the receiver ourselves, so that we never end up talking to
+    # something that isn't publicly routable. When we can't tell where it
+    # lives, we leave it to the connection to find out.
+    def resolve_destination(uri)
+      addresses = SsrfProtection.resolve_addresses(uri.host)
+      return :unresolved if addresses.empty?
+
+      addresses.reject { |address| SsrfProtection.blocked_address?(address) }.first&.to_s
+    rescue Resolv::ResolvError, Resolv::ResolvTimeout, SocketError, SystemCallError
+      :unresolved
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => CONTENT_TYPE,
+        TIMESTAMP_HEADER => event.created_at.utc.iso8601(3),
+        SIGNATURE_HEADER => signature
+      }
+    end
+
+    def payload
+      @payload ||= Webhook::EventPayload.new(event).to_json
+    end
+
+    # Receivers can verify that a request came from us by hashing its body
+    # with the signing secret we generated for them.
+    def signature
+      OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, payload
+    end
 end
diff --git a/app/models/webhook/event_payload.rb b/app/models/webhook/event_payload.rb
new file mode 100644
index 0000000..4990bdc
--- /dev/null
+++ b/app/models/webhook/event_payload.rb
@@ -0,0 +1,72 @@
+# The body we POST to a webhook receiver: everything about the event that
+# triggered the delivery.
+class Webhook::EventPayload
+  attr_reader :event
+
+  delegate :board, :creator, to: :event
+
+  def initialize(event)
+    @event = event
+  end
+
+  def to_json(*)
+    to_h.to_json
+  end
+
+  def to_h
+    { event: {
+      id: event.id,
+      action: event.action,
+      created_at: event.created_at,
+      board: { id: board.id, name: board.name, url: board_url },
+      creator: { id: creator.id, name: creator.name },
+      card: card_attributes,
+      eventable: eventable_attributes
+    } }
+  end
+
+  private
+    def card_attributes
+      { id: card.id, number: card.number, title: card.title, url: card_url }
+    end
+
+    def eventable
+      event.eventable
+    end
+
+    def eventable_attributes
+      { type: event.eventable_type, id: event.eventable_id, url: eventable_url }
+    end
+
+    def eventable_url
+      case eventable
+      when Comment then card_url(anchor: ActionView::RecordIdentifier.dom_id(eventable))
+      when Card then card_url
+      end
+    end
+
+    def card
+      event.card
+    end
+
+    def card_url(**options)
+      url_helpers.card_url card, **url_options.merge(options)
+    end
+
+    def board_url
+      url_helpers.board_url board, **url_options
+    end
+
+    def url_options
+      { host: default_url_options[:host], script_name: event.account&.slug }
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+    end
+end
diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..845fadb 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -159,3 +159,55 @@ __Response:__
 ```
 
 `request` and `response` can be `null` for deliveries that have not started yet or are still in progress. The delivery request headers omit the `X-Webhook-Signature` header.
+
+## Delivery behavior
+
+When an event happens on a board, Fizzy posts it once to every active webhook on that board that subscribed to its action.
+
+__Request:__
+
+```
+POST https://api.example.com/webhooks
+User-Agent: fizzy/1.0.0 Webhook
+Content-Type: application/json
+X-Webhook-Timestamp: 2025-12-05T19:36:35.401Z
+X-Webhook-Signature: 5257a869e7ecebeda32affa62cdca3fa51cad7e77a0e56ff536d0ce8e108d8bd
+```
+
+`X-Webhook-Timestamp` is when the event happened. `X-Webhook-Signature` is the `HMAC` using `SHA256` of the request body with the webhook's `signing_secret`.
+
+__Body:__
+
+```json
+{
+  "event": {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_closed",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcy",
+      "name": "Fizzy",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    },
+    "card": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohdb",
+      "number": "1",
+      "title": "Design the new logo",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/1"
+    },
+    "eventable": {
+      "type": "Card",
+      "id": "03f5v9zkft4hj9qq0lsn9ohdb",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/1"
+    }
+  }
+}
+```
+
+Each delivery is only ever posted once. A receiver that keeps failing — ten failed deliveries in a row within an hour — gets its webhook deactivated. Reactivating a webhook clears the count. Deliveries that didn't answer are logged with an `error` of `timeout` or `destination_unreachable`, and the one that couldn't be delivered at all is logged as `delivery_failed`.
+
+The log of deliveries is kept for a week.
