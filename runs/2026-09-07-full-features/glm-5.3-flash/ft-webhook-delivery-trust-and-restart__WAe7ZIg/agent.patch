+  scope :expired, -> { where created_at: ...RETENTION_PERIOD.ago }
+
+  class << self
+    # Every active webhook on the board that subscribed to the action of the
+    # event gets exactly one delivery, and a job to make it happen.
+    def deliver_later_for(event)
+      event.board.webhooks.active.filter_map do |webhook|
+        next unless webhook.subscribes_to?(event.action)
+
+        delivery = find_or_create_by!(webhook: webhook, event: event)
