@@ -0,0 +1,39 @@
+require "test_helper"
+
+class LocalTimeTest < ActionDispatch::IntegrationTest
+  include SessionTestHelper
+
+  test "cards ship raw timestamps instead of the viewer's clock" do
+    sign_in_as users(:david)
+    get card_path(cards(:layout))
+
+    assert_response :success
+    assert_raw_timestamps
+  end
+
+  test "notifications ship raw timestamps instead of the viewer's clock" do
+    sign_in_as users(:david)
+    get notifications_path
+
+    assert_response :success
+    assert_raw_timestamps
+  end
+
+  test "published boards ship raw timestamps instead of the viewer's clock" do
+    boards(:writebook).publish
+    sign_out
+    get public_board_column_path(boards(:writebook).publication.key, columns(:writebook_in_progress))
+
+    assert_response :success
+    assert_raw_timestamps
+  end
+
+  private
+    # The words on the page are the browser's business: everybody gets their own
+    # timezone, and the HTML we render stays identical for everybody.
+    def assert_raw_timestamps
+      assert_select "time[datetime]", minimum: 1 do |timestamps|
+        timestamps.each { |timestamp| assert_empty timestamp.text.strip }
+      end
+    end
+end
diff --git a/test/system/time_formatting_test.rb b/test/system/time_formatting_test.rb
new file mode 100644
index 0000000..1488655
--- /dev/null
+++ b/test/system/time_formatting_test.rb
@@ -0,0 +1,86 @@
+require "application_system_test_case"
+
+class TimeFormattingTest < ApplicationSystemTestCase
+  test "formats relative timestamps in the viewer's timezone" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    assert_format 2.hours.ago, 2.hours.ago.today? ? 2.hours.ago.strftime("%l:%M %p").strip : "yesterday"
+    assert_format 1.day.ago, "yesterday"
+    assert_format 3.days.ago, "3 days ago"
+    assert_format 5.days.ago, "5 days ago"
+    assert_format 6.days.ago, 6.days.ago.strftime("%b %-d")
+    assert_format 1.year.ago, 1.year.ago.strftime("%b %-d, %Y")
+
+    assert_format 1.day.from_now, "tomorrow"
+    assert_format 3.days.from_now, "in 3 days"
+    assert_format 30.days.from_now, "in 30 days"
+    assert_format 400.days.from_now, "next year"
+    assert_format 5.minutes.from_now, "in 5 minutes"
+  end
+
+  test "formats dates and clock times on demand" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    timestamp = 1.year.ago.noon
+
+    assert_format timestamp, timestamp.strftime("%l:%M %p").strip, format: "time"
+    assert_format timestamp, timestamp.strftime("%b %-d"), format: "date"
+    assert_format timestamp, timestamp.strftime("%b %-d, %Y"), format: "date_with_year"
+    assert_format timestamp, timestamp.strftime("%A, %B %-d"), format: "weekday_date"
+    assert_format timestamp, timestamp.strftime("%b %-d, %Y, %l:%M %p").strip, format: "full_datetime"
+  end
+
+  test "renders nothing without a timestamp" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    page.execute_script <<~JS
+      const element = document.createElement("time")
+      element.setAttribute("data-controller", "timestamp")
+      document.body.appendChild(element)
+    JS
+
+    assert_selector "time[data-controller='timestamp']", text: ""
+  end
+
+  test "renders again when the timestamp changes" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    page.execute_script <<~JS
+      const element = document.createElement("time")
+      element.id = "timestamp-test"
+      element.setAttribute("datetime", "2020-01-01T00:00:00Z")
+      element.setAttribute("data-controller", "timestamp")
+      document.body.appendChild(element)
+    JS
+
+    assert_selector "#timestamp-test", text: "Jan 1, 2020"
+
+    page.execute_script "document.getElementById('timestamp-test').setAttribute('datetime', arguments[0])", 1.day.ago.utc.iso8601
+
+    assert_selector "#timestamp-test", text: "yesterday"
+  end
+
+  test "renders the times on a page in the viewer's timezone" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+
+    assert_selector ".card__meta-text--added time[datetime]", text: /\S/
+    assert_selector ".comment__permalink-title time[datetime]", text: /\S/, minimum: 1
+  end
+
+  private
+    def assert_format(datetime, expected, format: "relative")
+      assert_equal expected, format_timestamp(datetime.utc.iso8601, format)
+    end
+
+    def format_timestamp(datetime, format)
+      page.evaluate_async_script(<<~JS, datetime, format)
+        const [ datetime, format, done ] = arguments
+        import("helpers/time_helpers").then(module => done(module.formatTimestamp(datetime, format)))
+      JS
+    end
+end
