diff --git a/app/javascript/controllers/timestamp_controller.js b/app/javascript/controllers/timestamp_controller.js
new file mode 100644
index 0000000..06176b9
--- /dev/null
+++ b/app/javascript/controllers/timestamp_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_helpers"
+
+// Turns the raw timestamp the server rendered into words in the viewer's own
+// timezone. See TimeHelper for the elements this controller is attached to.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #observer
+
+  connect() {
+    this.#render()
+    this.#rerenderWhenTheTimestampChanges()
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+  }
+
+  formatValueChanged() {
+    this.#render()
+  }
+
+  get #datetime() {
+    return this.element.getAttribute("datetime")
+  }
+
+  #render() {
+    this.element.textContent = formatTimestamp(this.#datetime, this.formatValue)
+    this.element.title = formatTimestamp(this.#datetime, "full_datetime")
+  }
+
+  #rerenderWhenTheTimestampChanges() {
+    this.#observer = new MutationObserver(() => this.#render())
+    this.#observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-timestamp-format-value" ] })
+  }
+}
diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..3f7b1c4
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,132 @@
+// Times and dates are formatted in the browser, in the viewer's own timezone.
+// The server only ships raw timestamps, which keeps the HTML it renders
+// identical for everybody and therefore cacheable and shareable.
+
+const MILLISECONDS_IN_DAY = 86_400_000
+const SECONDS_IN_MINUTE = 60
+const SECONDS_IN_HOUR = 3_600
+const MINUTES_IN_HOUR = 60
+const DAYS_BEFORE_A_DATE_IS_CLEARER = 6
+const DAYS_IN_A_MONTH = 30
+const DAYS_IN_A_YEAR = 365
+
+const FORMATS = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  date_with_year: { month: "short", day: "numeric", year: "numeric" },
+  weekday_date: { weekday: "long", month: "long", day: "numeric" },
+  full_datetime: { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }
+}
+
+// "1:42 PM" earlier today, "yesterday", "5 days ago", "Sep 12" further back,
+// "tomorrow" and "in 30 days" ahead.
+export function formatTimestamp(timestamp, format = "relative") {
+  const date = toDate(timestamp)
+  if (!date) return ""
+
+  if (format === "relative") return relative(date)
+  if (format === "ago") return ago(date)
+
+  return formatter(FORMATS[format] || FORMATS.date).format(date)
+}
+
+function relative(date) {
+  const days = daysFromToday(date)
+
+  if (days === 0) return inThePast(date) ? clock(date) : `in ${duration(date, Math.ceil)}`
+
+  // Further back than that, "Sep 12" says more than "6 days ago" does.
+  if (days <= -DAYS_BEFORE_A_DATE_IS_CLEARER) return calendarDay(date)
+
+  return inDays(days)
+}
+
+function ago(date) {
+  if (!inThePast(date)) return relative(date)
+
+  const days = daysFromToday(date)
+
+  if (days === 0) return `${duration(date)} ago`
+  if (days <= -DAYS_BEFORE_A_DATE_IS_CLEARER) return calendarDay(date)
+
+  return inDays(days)
+}
+
+function inDays(days) {
+  const amount = Math.abs(days)
+
+  if (amount >= DAYS_IN_A_YEAR) return inUnits(Math.round(days / DAYS_IN_A_YEAR), "year")
+  if (amount >= 2 * DAYS_IN_A_MONTH) return inUnits(Math.round(days / DAYS_IN_A_MONTH), "month")
+
+  return inUnits(days, "day")
+}
+
+function inUnits(amount, unit) {
+  return relativeTimeFormatter().format(amount, unit)
+}
+
+function duration(date, round = Math.floor) {
+  const seconds = Math.abs(Date.now() - date.getTime()) / 1000
+
+  if (seconds < SECONDS_IN_MINUTE) return "less than a minute"
+
+  const minutes = round(seconds / SECONDS_IN_MINUTE)
+  if (minutes < MINUTES_IN_HOUR) return `${minutes} ${pluralize("minute", minutes)}`
+
+  const hours = Math.max(1, round(seconds / SECONDS_IN_HOUR))
+  return `${hours} ${pluralize("hour", hours)}`
+}
+
+function daysFromToday(date) {
+  return Math.round((beginningOfDay(date) - beginningOfDay(new Date())) / MILLISECONDS_IN_DAY)
+}
+
+function beginningOfDay(date) {
+  const day = new Date(date)
+  day.setHours(0, 0, 0, 0)
+  return day
+}
+
+function inThePast(date) {
+  return date.getTime() < Date.now()
+}
+
+function toDate(timestamp) {
+  if (!timestamp) return null
+
+  const date = timestamp instanceof Date ? timestamp : new Date(timestamp)
+  return Number.isNaN(date.getTime()) ? null : date
+}
+
+function clock(date) {
+  return formatter(FORMATS.time).format(date)
+}
+
+function calendarDay(date) {
+  const format = date.getFullYear() === new Date().getFullYear() ? FORMATS.date : FORMATS.date_with_year
+  return formatter(format).format(date)
+}
+
+function pluralize(word, count) {
+  return count === 1 ? word : `${word}s`
+}
+
+const formatters = new Map()
+const relativeTimeFormatters = new Map()
+
+function formatter(options) {
+  return fromCache(formatters, keyFor(options), () => new Intl.DateTimeFormat("en-US", options))
+}
+
+function relativeTimeFormatter() {
+  return fromCache(relativeTimeFormatters, "relative", () => new Intl.RelativeTimeFormat("en-US", { numeric: "auto" }))
+}
+
+function fromCache(cache, key, build) {
+  if (!cache.has(key)) cache.set(key, build())
+  return cache.get(key)
+}
+
+function keyFor(options) {
+  return Object.entries(options).map(([ option, value ]) => `${option}:${value}`).join(",")
+}
