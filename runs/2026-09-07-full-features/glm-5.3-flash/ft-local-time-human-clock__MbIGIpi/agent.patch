@@ -0,0 +1,33 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders the raw timestamp for the browser to format" do
+    assert_dom_equal \
+      %(<time datetime="2026-01-14T13:42:00Z" data-controller="timestamp" data-timestamp-format-value="relative"></time>),
+      local_time(Time.zone.parse("2026-01-14 13:42"))
+  end
+
+  test "renders in UTC, no matter which zone the server is using" do
+    time = ActiveSupport::TimeZone["America/New_York"].parse("2026-01-14 08:42")
+
+    assert_dom_equal \
+      %(<time datetime="2026-01-14T13:42:00Z" data-controller="timestamp" data-timestamp-format-value="relative"></time>),
+      local_time(time)
+  end
+
+  test "renders the requested format" do
+    assert_dom_equal \
+      %(<time datetime="2026-01-14T13:42:00Z" data-controller="timestamp" data-timestamp-format-value="date_with_year"></time>),
+      local_time(Time.zone.parse("2026-01-14 13:42"), format: :date_with_year)
+  end
+
+  test "renders additional attributes" do
+    assert_dom_equal \
+      %(<time datetime="2026-01-14T13:42:00Z" class="txt-small" data-controller="timestamp" data-timestamp-format-value="time" data-creator-id="42"></time>),
+      local_time(Time.zone.parse("2026-01-14 13:42"), format: :time, class: "txt-small", data: { creator_id: 42 })
+  end
+
+  test "renders nothing without a timestamp" do
+    assert_nil local_time(nil)
+  end
+end
