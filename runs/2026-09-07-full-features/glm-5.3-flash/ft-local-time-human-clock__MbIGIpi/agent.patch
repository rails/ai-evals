--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,12 @@
+# Times are rendered by the browser, in the viewer's own timezone, so that the
+# HTML we render reads the same for everybody and can be cached and shared
+# between people. The server only ships the raw timestamp; the page turns it
+# into words (see timestamp_controller.js).
 module TimeHelper
+  def local_time(time, format: :relative, **options)
+    return if time.nil?
+
+    data = { controller: "timestamp", timestamp_format_value: format }.merge(options.delete(:data) || {})
+    tag.time(datetime: time.utc.iso8601, **options, data: data)
+  end
 end
