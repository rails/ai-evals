+++ b/app/models/concerns/reactable.rb
@@ -0,0 +1,13 @@
+module Reactable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :reactions, -> { order(:created_at) }, dependent: :delete_all
+  end
+
+  # Reactions are routed below the card of their reactable with the reactable
+  # nested in between: [card, comment] for comments, [card] for cards.
+  def reactions_route_scope
+    [ self ]
+  end
+end
