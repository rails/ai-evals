+
+  test "creating a reaction on a card touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "a reaction must belong to either a comment or a card" do
+    assert_raise ActiveRecord::RecordInvalid do
+      Reaction.create!(content: "Nice!", reacter: users(:david))
+    end
+  end
+
+  test "destroying a card destroys its reactions" do
+    card = cards(:logo)
+    comment_reaction = comments(:logo_1).reactions.create!(content: "Nice!")
+    card_reaction = card.reactions.create!(content: "Nice!")
+
+    assert_difference -> { Reaction.count }, -2 do
+      card.destroy
+    end
+
+    assert_not Reaction.exists?(comment_reaction.id)
+    assert_not Reaction.exists?(card_reaction.id)
+  end
 end
