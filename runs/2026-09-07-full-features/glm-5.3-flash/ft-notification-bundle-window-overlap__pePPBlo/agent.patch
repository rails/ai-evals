index 0000000..bdb112e
--- /dev/null
+++ b/test/jobs/notification/bundle_email_job_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Notification::BundleEmailJobTest < ActiveSupport::TestCase
+  test "is enqueued when a notification is created for someone who bundles their emails" do
+    users(:david).settings.update!(bundle_email_frequency: "daily")
+
+    assert_enqueued_with(job: Notification::BundleEmailJob) do
+      users(:david).notifications.create!(source: events(:layout_published), creator: users(:jason))
+    end
+  end
+
+  test "is not enqueued when someone gets an email per notification" do
+    assert_no_enqueued_jobs only: Notification::BundleEmailJob do
+      users(:david).notifications.create!(source: events(:layout_published), creator: users(:jason))
+    end
+  end
+
+  test "is not enqueued for notifications created by the system" do
+    users(:david).settings.update!(bundle_email_frequency: "daily")
+
+    assert_no_enqueued_jobs only: Notification::BundleEmailJob do
+      users(:david).notifications.create!(
+        source: events(:layout_published), creator: accounts("37s").system_user
+      )
+    end
+  end
+
+  test "files the notification into a window" do
+    users(:kevin).settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+
+    Notification::BundleEmailJob.perform_now(notification)
