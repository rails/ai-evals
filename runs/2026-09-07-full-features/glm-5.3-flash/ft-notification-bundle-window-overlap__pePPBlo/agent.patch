@@ -0,0 +1,18 @@
+class NotificationMailer < ApplicationMailer
+  def email_bundle(email_bundle)
+    @email_bundle = email_bundle
+    @user = email_bundle.user
+    @notifications = email_bundle.notifications.preloaded.order(:created_at)
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      if @notifications.size == 1
+        "1 new notification"
+      else
+        "#{@notifications.size} new notifications"
+      end
+    end
+end
