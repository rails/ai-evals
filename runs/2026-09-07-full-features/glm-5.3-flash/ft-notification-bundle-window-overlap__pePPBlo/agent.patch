@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Notification::DeliverEmailBundleJobTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "delivers the window once its clock has run out" do
+    users(:kevin).settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:buy_domain_sent_back_to_triage_kevin)
+    Notification::BundleEmailJob.perform_now(notification)
+    bundle = notification.reload.email_bundle
+
+    assert_emails 0 do
+      travel_to(bundle.starts_at) { Notification::DeliverEmailBundleJob.perform_now(bundle) }
+    end
+
+    assert_emails 1 do
+      travel_to(bundle.ends_at) { Notification::DeliverEmailBundleJob.perform_now(bundle) }
+    end
+
+    assert bundle.reload.sent?
+  end
+
+  test "is scheduled for when the window closes" do
+    bundle = Notification::EmailBundle.create!(
+      user: users(:kevin), starts_at: 1.hour.ago, ends_at: 3.hours.from_now
+    )
+
+    assert_enqueued_with(job: Notification::DeliverEmailBundleJob, args: [ bundle ], at: 3.hours.from_now) do
+      bundle.deliver_later
+    end
+  end
+end
