+<h1 class="title">Your Fizzy notifications</h1>
+<p class="subtitle">
+  <%= @notifications.size %> new <%= "notification".pluralize(@notifications.size) %>
+  while you were away.
+</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <hr class="notification__board-separator">
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <p class="notification__author">
+        <%= image_tag notification.payload.avatar_url, class: "avatar", alt: "", width: 40, height: 40 %>
+        <%= notification.creator.name %>
+      </p>
+      <p class="notification__details">
+        <%= link_to notification.payload.title, notification.payload.url %>
+        <% if notification.payload.body.present? %>
+          <br>
+          <%= notification.payload.body %>
+        <% end %>
+      </p>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change how often you hear from us", notifications_settings_url %>
+</p>
