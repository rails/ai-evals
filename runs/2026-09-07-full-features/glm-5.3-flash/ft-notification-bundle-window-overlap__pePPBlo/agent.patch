diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
new file mode 100644
index 0000000..9f57057
--- /dev/null
+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "notifications are emailed one by one by default" do
+    assert_equal "never", @settings.bundle_email_frequency
+    assert_not @settings.bundles_email?
+    assert_nil @settings.bundle_email_frequency_duration
+  end
+
+  test "bundling emails every few hours opens four hour windows" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+
+    assert @settings.bundles_email?
+    assert_equal 4.hours, @settings.bundle_email_frequency_duration
+  end
+
+  test "bundling emails daily opens daily windows" do
+    @settings.update!(bundle_email_frequency: "daily")
+
+    assert @settings.bundles_email?
+    assert_equal 1.day, @settings.bundle_email_frequency_duration
+  end
+
+  test "bundling emails weekly opens weekly windows" do
+    @settings.update!(bundle_email_frequency: "weekly")
+
+    assert @settings.bundles_email?
+    assert_equal 1.week, @settings.bundle_email_frequency_duration
+  end
+
+  test "bundling emails can be turned off" do
+    @settings.update!(bundle_email_frequency: "daily")
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_not @settings.bundles_email?
+  end
+end
