new file mode 100644
index 0000000..44fc469
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    fresh_when etag: @comment.reactions
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @comment.reactions.where(reacter: Current.user).find_or_create_by!(content: content) if content.present?
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json do
+        if @reaction
+          render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json)
+        else
+          head :unprocessable_entity
+        end
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def content
+      params.expect(reaction: [ :content ])[:content].to_s.strip.first(Reaction::MAXIMUM_LENGTH)
+    end
+end
