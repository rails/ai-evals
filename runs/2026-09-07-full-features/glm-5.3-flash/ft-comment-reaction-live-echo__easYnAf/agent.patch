+<%= button_tag type: :button, class: "reactions__trigger btn btn--circle", title: "Add a reaction",
+      data: { reactions_target: "trigger", action: "click->reactions#open" } do %>
+  <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+  <span class="for-screen-reader">Add a reaction</span>
+<% end %>
+
+<%= form_with model: [ comment.card, comment, Reaction.new ], class: "reaction__form", html: { hidden: true },
+      data: { reactions_target: "form", action: "turbo:submit-end->reactions#reset" } do |form| %>
+  <div class="reaction__menu" data-controller="dialog"
+        data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn btn--circle" title="Pick an emoji"
+          data-action="click->dialog#toggle:stop">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <dialog class="popup panel reaction__popup" data-dialog-target="dialog"
+          data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+      <%# The emoji list is loaded lazily so a long list of comments doesn't render a picker for each of them %>
+      <%= turbo_frame_tag dom_id(comment, :reactions_emoji),
+            src: new_card_comment_reaction_path(comment.card, comment), loading: :lazy %>
+    </dialog>
+  </div>
+
+  <%= form.label :content, class: "reaction__form-label" do %>
+    <%= form.text_field :content, class: "input reaction__input", maxlength: Reaction::MAXIMUM_LENGTH,
+          placeholder: "Add a reaction", autocomplete: "off", required: true,
+          aria: { label: "Your reaction" },
+          data: { reactions_target: "input" } %>
+  <% end %>
+
+  <%= form.button class: "reaction__submit-btn btn btn--circle", title: "Add this reaction" do %>
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Add this reaction</span>
+  <% end %>
+
+  <button type="button" class="reaction__cancel-btn btn btn--circle" title="Cancel"
+        data-action="click->reactions#close">
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  </button>
+<% end %>
