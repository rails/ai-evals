@@ -0,0 +1,36 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order :created_at, :id }
+
+  normalizes :content, with: ->(content) { content.to_s.strip }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_LENGTH },
+    uniqueness: { scope: %i[ comment_id reacter_id ] }
+
+  after_create :register_card_activity
+
+  after_create_commit  -> { broadcast_addition }
+  after_destroy_commit -> { broadcast_removal }
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  private
+    def register_card_activity
+      comment.card.touch_last_active_at
+    end
+
+    def broadcast_addition
+      broadcast_append_later_to [ comment.card, :reactions ], target: [ comment, :reactions_list ]
+    end
+
+    def broadcast_removal
+      broadcast_remove_to [ comment.card, :reactions ]
+    end
+end
