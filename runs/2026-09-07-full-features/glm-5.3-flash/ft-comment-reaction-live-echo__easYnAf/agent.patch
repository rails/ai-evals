+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "new renders the emoji picker" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select ".reaction__emoji-list .btn", count: EmojiHelper::REACTIONS.size
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(@card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.chronologically.map(&:id), @response.parsed_body.pluck("id")
+    assert_equal comment.reactions.chronologically.map(&:content), @response.parsed_body.pluck("content")
+reactions = comment.reactions.chronologically
+assert_equal card_comment_reaction_url(@card, comment, reactions.first), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "\u{1F44F}" } }, as: :json
+    end
+
+  assert_response :created
+  assert_equal card_comment_reaction_path(@card, @comment, @comment.reactions.last, format: :json),
+    @response.headers["Location"]
+  assert_equal "\u{1F44F}", @response.parsed_body["content"]
+  assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+end
+
+  test "create as JSON without content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "" } }, as: :json
+    end
+
+  assert_response :unprocessable_entity
+end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: "\u{1F44F}", reacter: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "create" do
+      assert_difference -> { @comment.reactions.count }, +1 do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "\u{1F44F}" } }, as: :turbo_stream
+      end
+
+    assert_response :success
+    assert_equal "\u{1F44F}", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+  end
+
+  test "create repeats the same reaction instead of failing" do
+    reaction = @comment.reactions.create!(content: "\u{1F44F}", reacter: users(:kevin))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "\u{1F44F}" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal reaction.id, @comment.reactions.last.id
+  end
+
+  test "create trims and truncates content to the maximum length" do
+    content = "  #{("x" * (Reaction::MAXIMUM_LENGTH + 1))}  "
+
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal Reaction::MAXIMUM_LENGTH, @comment.reactions.last.content.length
+  end
+
+  test "create without content does nothing" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "   " } }, as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "create on an inaccessible card is not found" do
+    board = boards(:private)
+    card, comment = with_current_user :kevin do
+      created = board.cards.create!(title: "Secret", creator: users(:kevin), status: :published)
+      [ created, created.comments.create!(creator: users(:kevin), body: "Hidden comment") ]
+    end
+
+    logout_and_sign_in_as :jason
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(card, comment), params: { reaction: { content: "\u{1F44F}" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "create is broadcast to everyone looking at the card" do
+    assert_turbo_stream_broadcasts [ @card, :reactions ], count: 1 do
+      perform_enqueued_jobs do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "\u{1F44F}" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "destroy" do
+    reaction = @comment.reactions.create!(content: "\u{1F44F}", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+
+    assert_response :success
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_hands_jz)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy is broadcast to everyone looking at the card" do
+    reaction = @comment.reactions.create!(content: "\u{1F44F}", reacter: users(:kevin))
+
+    assert_turbo_stream_broadcasts [ @card, :reactions ], count: 1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+  end
+end
