diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..96f1cd1
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,120 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "reacter defaults to the current user and account to the comment's account" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.create!(content: "\u{1F44F}")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal comment.account, reaction.account
+  end
+
+  test "content is required" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert_not_empty reaction.errors[:content]
+  end
+
+  test "content is stripped" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.create!(content: "  \u{1F44F}  ")
+
+    assert_equal "\u{1F44F}", reaction.content
+  end
+
+  test "content is limited to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = comment.reactions.build(content: "x" * (Reaction::MAXIMUM_LENGTH + 1))
+
+    assert_not reaction.valid?
+    assert_not_empty reaction.errors[:content]
+  end
+
+  test "the same reaction can be left by different people on the same comment" do
+    comment = comments(:logo_agreement_kevin)
+
+    comment.reactions.create!(content: "\u{1F44F}", reacter: users(:david))
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      comment.reactions.create!(content: "\u{1F44F}", reacter: users(:jz))
+    end
+  end
+
+  test "the same person cannot leave the same reaction twice on a comment" do
+    comment = comments(:logo_agreement_kevin)
+
+    comment.reactions.create!(content: "\u{1F44F}", reacter: users(:david))
+
+    assert_no_difference -> { comment.reactions.count } do
+      assert_raises(ActiveRecord::RecordInvalid) do
+        comment.reactions.create!(content: "\u{1F44F}", reacter: users(:david))
+      end
+    end
+  end
+
+  test "the same person can leave different reactions on a comment" do
+    comment = comments(:logo_agreement_kevin)
+
+    comment.reactions.create!(content: "\u{1F44F}", reacter: users(:david))
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      comment.reactions.create!(content: "\u{1F525}", reacter: users(:david))
+    end
+  end
+
+  test "reacting registers card activity" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      card.comments.by_user.first.reactions.create!(content: "\u{1F44F}")
+    end
+  end
+
+  test "removing a reaction leaves the card activity alone" do
+    reaction = reactions(:logo_agreement_thumbs_up_kevin)
+
+    assert_no_changes -> { reaction.comment.card.reload.last_active_at } do
+      reaction.destroy
+    end
+  end
+
+  test "adding a reaction is broadcast to everyone looking at the card" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    reaction = nil
+    assert_turbo_stream_broadcasts [ card, :reactions ], count: 1 do
+      perform_enqueued_jobs do
+        reaction = comment.reactions.create!(content: "\u{1F44F}")
+      end
+    end
+
+    turbo_stream = capture_turbo_stream_broadcasts([ card, :reactions ]).first
+    assert_equal "append", turbo_stream["action"]
+    assert_equal dom_id(comment, :reactions_list), turbo_stream["target"]
+    assert_equal dom_id(reaction), turbo_stream.at(".reaction")["id"]
+  end
+
+  test "removing a reaction is broadcast to everyone looking at the card" do
+    card = cards(:logo)
+    reaction = reactions(:logo_agreement_thumbs_up_kevin)
+
+    assert_turbo_stream_broadcasts [ card, :reactions ], count: 1 do
+      reaction.destroy
+    end
+
+    turbo_stream = capture_turbo_stream_broadcasts([ card, :reactions ]).first
+    assert_equal "remove", turbo_stream["action"]
+    assert_equal dom_id(reaction), turbo_stream["target"]
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..af04487
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,114 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    Current.user = users(:kevin)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "the button turns into an input and confirming puts the reaction in the strip" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reactions__list .reaction", count: 2
+
+      click_on "Add a reaction"
+      assert_selector ".reaction__form:not([hidden])"
+      find(".reaction__input").set("Nice!")
+
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "Nice!", wait: 5
+      assert_no_selector ".reaction__form:not([hidden])"
+      assert_selector ".reactions__trigger:not([hidden])"
+    end
+  end
+
+  test "picking an emoji adds the reaction right away" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      find(".reaction__emoji-list .btn[title='Red heart']").click
+
+      assert_selector ".reaction", text: "\u{2764}\u{FE0F}", wait: 5
+      assert_selector ".reactions__trigger:not([hidden])"
+    end
+  end
+
+  test "canceling hides the input and brings the button back" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      click_on "Add a reaction"
+      assert_selector ".reaction__form:not([hidden])"
+
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__form:not([hidden])"
+      assert_selector ".reactions__trigger:not([hidden])"
+    end
+  end
+
+  test "clicking your own reaction reveals a way to remove it" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      own = find(".reaction", text: "\u{1F44D}")
+
+      own.click
+      assert_selector ".reaction.expanded .reaction__delete"
+
+      within own do
+        click_on "Remove your reaction"
+      end
+
+      assert_no_selector ".reaction", text: "\u{1F44D}", wait: 5
+    end
+  end
+
+  test "reactions left by others land in the strip as they happen" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    assert_no_text "\u{1F525}"
+
+    react_elsewhere comments(:logo_agreement_jz), content: "\u{1F525}"
+
+    assert_text "\u{1F525}", wait: 5
+  end
+
+  test "reactions removed by others disappear from the strip as they happen" do
+    reaction = reactions(:logo_agreement_hands_jz)
+
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    assert_text "\u{1F64C}"
+
+    reaction.destroy
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_no_text "\u{1F64C}", wait: 5
+  end
+
+  private
+    def react_elsewhere(comment, content:)
+      wait_for_cable_subscriptions
+
+      Current.user = users(:jz)
+      comment.reactions.create!(content: content)
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+      Current.user = users(:kevin)
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
