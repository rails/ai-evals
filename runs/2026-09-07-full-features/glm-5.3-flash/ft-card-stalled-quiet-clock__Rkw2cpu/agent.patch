diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..0b1391e
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,64 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  # A burst is a flurry of attention on a card: either a handful of comments from
+  # different people landing within a third of the board's auto-close period, or
+  # somebody being assigned to the card, or the card being reopened.
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_WINDOW_FRACTION = Rational(1, 3)
+  BURSTING_ACTIONS = %w[ card_assigned card_reopened ]
+
+  # How long a card has to sit still after a burst before it counts as stalled.
+  STALLED_AFTER = 2.weeks
+  STALLED_AFTER_IN_DAYS = STALLED_AFTER / 1.day
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..stalled_cutoff) }
+  end
+
+  class_methods do
+    # Silence is counted in whole days, so the cutoff is the end of the day that
+    # lies two weeks behind us rather than a precise timestamp.
+    def stalled_cutoff
+      STALLED_AFTER.ago.end_of_day
+    end
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def burst_from_event?(event)
+    event.action.in?(BURSTING_ACTIONS)
+  end
+
+  def burst_from_comments?(at: Time.current)
+    recent = comments.by_user.where(created_at: (at - burst_window)..)
+
+    recent.count >= BURST_COMMENTS && recent.distinct.count(:creator_id) >= BURST_COMMENTERS
+  end
+
+  # Activity keeps a card from stalling. Unless the activity is itself a burst it
+  # wipes the previous one, so a card has to earn a new burst to stall again.
+  def record_activity(burst: false)
+    if burst
+      burst!
+    elsif burst?
+      update_column :burst_at, nil
+    end
+  end
+
+  def burst!
+    update_column :burst_at, Time.current
+  end
+
+  def stalled?
+    burst? && last_active_at <= self.class.stalled_cutoff
+  end
+
+  private
+    def burst_window
+      board.auto_postpone_period * BURST_WINDOW_FRACTION
+    end
+end
