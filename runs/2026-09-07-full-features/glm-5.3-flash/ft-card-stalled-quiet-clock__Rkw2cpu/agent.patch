diff --git a/test/integration/stalled_cards_test.rb b/test/integration/stalled_cards_test.rb
new file mode 100644
index 0000000..9d98e83
--- /dev/null
+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jz
+  end
+
+  test "a card that bursts and then goes cold is flagged on the card and listed as stalled" do
+    card = create_published_card
+
+    post card_comments_path(card), params: { comment: { body: "First" } }, as: :json
+    assert_response :created
+
+    with_current_user(users(:kevin)) { card.comments.create! body: "Second" }
+
+    post card_comments_path(card), params: { comment: { body: "Third" } }, as: :json
+    assert_response :created
+
+    assert card.reload.burst?, "expected the comments to burst the card"
+    assert_not card.stalled?
+
+    travel_to 2.weeks.from_now do
+      assert card.reload.stalled?
+
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_match card.title, response.body
+
+      get card_path(card)
+      assert_response :success
+      assert_select "div.bubble[data-bubble-stalled-value]"
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    card = create_published_card
+
+    with_current_user(users(:kevin)) { card.toggle_assignment users(:kevin) }
+
+    travel_to 3.weeks.from_now do
+      assert card.reload.stalled?
+
+      post card_comments_path(card), params: { comment: { body: "I am on it" } }, as: :json
+      assert_response :created
+
+      assert_not card.reload.stalled?
+
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_no_match card.title, response.body
+    end
+  end
+
+  private
+    def create_published_card
+      with_current_user(users(:jz)) do
+        boards(:writebook).cards.create! \
+          creator: users(:jz),
+          title: "The logo is not big enough",
+          status: :published,
+          column: columns(:writebook_triage)
+      end
+    end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..06c02d2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,204 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    entropies(:writebook_board).update! auto_postpone_period: 30.days.to_i
+  end
+
+  test "a card bursts when three comments from two people land within a third of the auto close period" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 3.days.ago
+    comment card, creator: :jz,    created_at: 2.days.ago
+    comment card, creator: :david
+
+    assert card.reload.burst?
+  end
+
+  test "a card does not burst from comments by a single person" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 3.days.ago
+    comment card, creator: :david, created_at: 2.days.ago
+    comment card, creator: :david
+
+    assert_not card.reload.burst?
+  end
+
+  test "a card does not burst from fewer than three comments" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 2.days.ago
+    comment card, creator: :jz
+
+    assert_not card.reload.burst?
+  end
+
+  test "a card does not burst from comments spread wider than a third of the auto close period" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 15.days.ago
+    comment card, creator: :jz,    created_at: 8.days.ago
+    comment card, creator: :david
+
+    assert_not card.reload.burst?
+  end
+
+  test "a card does not burst from system comments" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 3.days.ago
+    comment card, creator: :jz,    created_at: 2.days.ago
+    card.comments.create! creator: card.account.system_user, body: "System says hi"
+
+    assert_not card.reload.burst?
+  end
+
+  test "a card bursts when someone is assigned to it" do
+    card = published_card
+
+    assert_changes -> { card.reload.burst_at }, from: nil do
+      assign card, to: :jz
+    end
+
+    assert card.reload.burst?
+  end
+
+  test "a card bursts when it is reopened" do
+    card = published_card
+    card.close
+
+    assert_changes -> { card.reload.burst_at }, from: nil do
+      card.reopen
+    end
+
+    assert card.reload.burst?
+  end
+
+  test "activity that is not a burst resets the burst" do
+    card = published_card
+    card.burst!
+
+    assert_changes -> { card.reload.burst_at }, to: nil do
+      card.update! title: "A new title"
+    end
+
+    assert_not card.reload.burst?
+  end
+
+  test "a burst does not make a card stalled right away" do
+    card = published_card
+    assign card, to: :jz
+
+    freeze_time
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "a card is stalled two weeks after its last activity" do
+    card = published_card
+    assign card, to: :jz
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+      assert_includes Card.stalled, card
+      assert_includes Card.indexed_by("stalled"), card
+    end
+  end
+
+  test "a card is not stalled before two weeks of silence" do
+    card = published_card
+    assign card, to: :jz
+
+    travel 13.days do
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "a card that burst and then went quiet on its own is stalled" do
+    card = published_card
+
+    comment card, creator: :david, created_at: 3.days.ago
+    comment card, creator: :jz,    created_at: 2.days.ago
+    comment card, creator: :david, created_at: 1.day.ago
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+    end
+  end
+
+  test "activity resets a stalled card" do
+    card = published_card
+    assign card, to: :jz
+
+    travel 3.weeks do
+      assert card.reload.stalled?
+
+      with_current_user :jz do
+        card.comments.create! body: "I'm on it"
+      end
+
+      assert_not card.reload.stalled?
+      assert_not_includes Card.stalled, card
+    end
+  end
+
+  test "a card has to earn a new burst to stall again" do
+    card = published_card
+    assign card, to: :jz
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+    end
+
+    with_current_user :jz do
+      card.comments.create! body: "I'm on it"
+    end
+
+    travel 3.weeks do
+      assert_not card.reload.stalled?
+    end
+  end
+
+  test "stalled ignores closed and postponed cards" do
+    card = published_card
+    assign card, to: :jz
+
+    travel 2.weeks do
+      assert card.reload.stalled?
+      card.close
+      assert_not_includes Card.stalled, card.reload
+    end
+
+    card.reopen
+    card.postpone
+
+    travel 2.weeks do
+      assert_not_includes Card.stalled, card.reload
+    end
+  end
+
+  private
+    def assign(card, to:)
+      with_current_user users(:david) do
+        card.toggle_assignment users(to)
+      end
+    end
+
+    def published_card
+      boards(:writebook).cards.create! \
+        creator: users(:david),
+        title: "A card worth arguing about",
+        status: :published,
+        column: columns(:writebook_triage)
+    end
+
+    def comment(card, creator:, created_at: Time.current)
+      with_current_user users(creator) do
+        card.comments.create! body: "A comment", created_at: created_at
+      end
+    end
+end
