diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..22196ca
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = push_subscriptions(:david_phone)
+
+    ENV["VAPID_PUBLIC_KEY"] = vapid.public_key
+    ENV["VAPID_PRIVATE_KEY"] = vapid.private_key
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "register creates a subscription" do
+    subscription = nil
+    assert_difference -> { PushSubscription.count }, 1 do
+      subscription = PushSubscription.register(@user, endpoint: "https://push.example/device", p256dh_key: "p256dh", auth_key: "auth")
+    end
+
+    assert_equal @user, subscription.user
+    assert_equal @user.account, subscription.account
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+  end
+
+  test "register refreshes the keys of a known endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      PushSubscription.register(@user, endpoint: @subscription.endpoint, p256dh_key: "refreshed", auth_key: "auth")
+    end
+
+    assert_equal "refreshed", @subscription.reload.p256dh_key
+  end
+
+  test "register hands a known endpoint over to the user registering it" do
+    subscription = PushSubscription.register(@user, endpoint: push_subscriptions(:kevin_phone).endpoint, p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_equal @user, subscription.reload.user
+  end
+
+  test "register requires a subscription" do
+    assert_raises(ActiveRecord::RecordInvalid) do
+      PushSubscription.register(@user, endpoint: "", p256dh_key: "", auth_key: "")
+    end
+  end
+
+  test "push_payload says what the tray says and opens the card it's about" do
+    payload = JSON.parse(@notification.push_payload)
+
+    assert_equal "The logo isn't big enough", payload["title"]
+    assert_equal "Assigned to Kevin", payload["body"]
+    assert payload["url"].ends_with?("/cards/#{@notification.card.to_param}")
+    assert_equal @notification.id, payload["tag"]
+  end
+
+  test "push posts to the push service" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    @subscription.push(@notification)
+
+    assert_requested :post, @subscription.endpoint,
+      headers: { "Ttl" => "3600", "Urgency" => "high", "Authorization" => /^vapid t=/ }
+  end
+
+  test "push destroys the subscription once the push service retired it" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push destroys the subscription when the push service no longer knows it" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push keeps the subscription when the push service is having a bad day" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 500)
+
+    assert_no_difference -> { PushSubscription.count } do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push is a no-op without VAPID keys" do
+    ENV["VAPID_PUBLIC_KEY"] = nil
+
+    @subscription.push(@notification)
+
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  test "register rejects endpoints that are not push services" do
+    error = assert_raises(ActiveRecord::RecordInvalid) do
+      PushSubscription.register(@user, endpoint: "http://intranet/you", p256dh_key: "p256dh", auth_key: "auth")
+    end
+
+    assert_equal "Validation failed: Endpoint must use https", error.message
+  end
+
+  private
+    def vapid
+      @vapid ||= WebPush.generate_key
+    end
+end
