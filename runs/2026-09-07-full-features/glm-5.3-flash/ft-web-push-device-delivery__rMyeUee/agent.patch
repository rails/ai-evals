 })
 
+// Web push - a push says what the tray says and opens the card it's about
+self.addEventListener("push", (event) => {
+  event.waitUntil(showPushNotification(event.data))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  event.waitUntil(openCard(event.notification.data?.url))
+})
+
+async function showPushNotification(push) {
+  if (!push) return
+
+  const payload = push.json()
+
+  await self.registration.showNotification(payload.title, {
+    body: payload.body,
+    tag: payload.tag,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192-maskable.png",
+    data: { url: payload.url }
+  })
+}
+
+async function openCard(url) {
+  if (!url) return
+
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  if (windows.length > 0) {
+    const client = windows[0]
+
+    await client.focus()
+    await client.navigate(url)
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
+
 self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
