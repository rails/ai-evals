diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..03d07d6
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,46 @@
+class PushSubscription < ApplicationRecord
+  PERMITTED_SCHEMES = %w[ https ].freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+  validate :validate_endpoint
+
+  class << self
+    def register(user, endpoint:, p256dh_key:, auth_key:)
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(user: user, p256dh_key: p256dh_key, auth_key: auth_key)
+      end
+    end
+  end
+
+  def push(notification)
+    if Fizzy::Vapid.configured?
+      WebPush.payload_send \
+        message: notification.push_payload,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: Fizzy::Vapid.options,
+        urgency: "high",
+        ttl: 1.hour
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error => error
+    Rails.error.report(error, context: { endpoint: endpoint })
+  end
+
+  private
+    def validate_endpoint
+      uri = URI.parse(endpoint.presence)
+
+      if PERMITTED_SCHEMES.exclude?(uri.scheme)
+        errors.add :endpoint, "must use #{PERMITTED_SCHEMES.to_sentence}"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a URL"
+    end
+end
