+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    PushSubscription.register(@user, **push_subscription_params)
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on" }
+      format.json { head :no_content }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(endpoint: push_subscription_params[:endpoint])&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..0818101
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,98 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Turns web push notifications on and off for the device the person is using.
+export default class extends Controller {
+  static targets = [ "button", "details" ]
+
+  static values = {
+    subscribeUrl: String,
+    unsubscribeUrl: String,
+    vapidPublicKey: String
+  }
+
+  async connect() {
+    this.subscription = await this.#storedSubscription()
+
+    this.#sync()
+  }
+
+  toggle() {
+    if (this.subscription) {
+      this.#turnOff()
+    } else if (this.#supported) {
+      this.#turnOn()
+    }
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window && this.vapidPublicKeyValue.length > 0
+  }
+
+  get #permission() {
+    if (!this.#supported) return "unsupported"
+
+    return Notification.permission
+  }
+
+  async #storedSubscription() {
+    if (!this.#supported) return null
+
+    const registration = await navigator.serviceWorker.ready
+
+    return registration.pushManager.getSubscription()
+  }
+
+  async #turnOn() {
+    if (await Notification.requestPermission() === "granted") {
+      await this.#subscribe().catch(() => {})
+    }
+
+    this.#sync()
+  }
+
+  async #turnOff() {
+    if (this.subscription) {
+      await destroy(this.unsubscribeUrlValue, { body: { push_subscription: { endpoint: this.subscription.endpoint } } })
+      await this.subscription.unsubscribe().catch(() => {})
+      this.subscription = null
+
+      this.#sync()
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    this.subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await post(this.subscribeUrlValue, { body: { push_subscription: this.#keys } })
+  }
+
+  #sync() {
+    const on = this.#permission === "granted" && this.subscription != null
+
+    this.element.classList.toggle("notifications--on", on)
+    this.element.classList.toggle("notifications--off", !on)
+
+    if (this.hasButtonTarget) this.buttonTarget.disabled = !this.#supported
+
+    const blocked = this.#permission === "denied"
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+  }
+
+  get #keys() {
+    const { endpoint, keys } = this.subscription.toJSON()
+
+    return { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth }
+  }
+
+  get #applicationServerKey() {
+    const encoded = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = encoded + "=".repeat((4 - (encoded.length % 4)) % 4)
+
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
