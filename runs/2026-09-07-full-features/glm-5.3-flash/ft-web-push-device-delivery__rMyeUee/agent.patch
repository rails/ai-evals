+
+    assert_response :no_content
+
+    subscription = @user.push_subscriptions.last
+    assert_equal subscription_params[:endpoint], subscription.endpoint
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+  end
+
+  test "create re-registers a known endpoint" do
+    subscription = @user.push_subscriptions.create!(**subscription_params)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.merge(p256dh_key: "refreshed-key") }, as: :json
+    end
+
+    assert_response :no_content
+    assert_equal "refreshed-key", subscription.reload.p256dh_key
+  end
+
+  test "create for somebody else is forbidden" do
+    logout_and_sign_in_as :kevin
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    subscription = @user.push_subscriptions.create!(**subscription_params)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscription_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint } }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://fcm.googleapis.com/fcm/send/a-new-device",
+        p256dh_key: "a-new-device-p256dh-key",
+        auth_key: "a-new-device-auth-key"
+      }
+    end
+end
