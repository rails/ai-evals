diff --git a/lib/fizzy/vapid.rb b/lib/fizzy/vapid.rb
new file mode 100644
index 0000000..08b74ca
--- /dev/null
+++ b/lib/fizzy/vapid.rb
@@ -0,0 +1,27 @@
+module Fizzy
+  # VAPID key pair identifying this Fizzy installation to push services.
+  #
+  # Ops provides the keys as VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY. Without them
+  # web push is not offered: subscriptions can neither be registered nor delivered.
+  module Vapid
+    SUBJECT = "mailto:support@fizzy.do"
+
+    class << self
+      def configured?
+        public_key.present? && private_key.present?
+      end
+
+      def public_key
+        ENV["VAPID_PUBLIC_KEY"].presence
+      end
+
+      def private_key
+        ENV["VAPID_PRIVATE_KEY"].presence
+      end
+
+      def options
+        { subject: SUBJECT, public_key: public_key, private_key: private_key }
+      end
+    end
+  end
+end
