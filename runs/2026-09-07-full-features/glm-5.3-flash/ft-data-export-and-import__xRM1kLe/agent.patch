--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,20 @@
+# Writes an account archive: a zip file with one JSON document per record,
+# grouped by table, plus the files the records have attached to them.
+class Account::DataTransfer::Exporter
+  MANIFEST_PATH = "manifest.json"
+
+  def initialize(manifest)
+    @manifest = manifest
+  end
+
+  def export(zip)
+    zip.add_file(MANIFEST_PATH, JSON.generate(manifest.metadata))
+
+    manifest.each_record_set do |record_set|
+      record_set.export(zip)
+    end
+  end
+
+  private
+    attr_reader :manifest
+end
diff --git a/app/models/account/data_transfer/identity_record_set.rb b/app/models/account/data_transfer/identity_record_set.rb
new file mode 100644
index 0000000..5cf0015
--- /dev/null
+++ b/app/models/account/data_transfer/identity_record_set.rb
@@ -0,0 +1,21 @@
+class Account::DataTransfer::IdentityRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: ::Identity, attributes: %w[ id email_address created_at ])
+  end
+
+  # Identities are shared across accounts: they are looked up by email address
+  # instead of being duplicated, and the id they get is remembered for the
+  # people that point at them.
+  def import(archive, context = Account::DataTransfer::Context.new)
+    archive.glob("#{model_dir}/*.json").each do |path|
+      row = archive.read_json(path)
+      identity = ::Identity.create_with(created_at: row["created_at"]).find_or_create_by!(email_address: row["email_address"])
+      context.map!(row["id"], identity.id)
+    end
+  end
+
+  private
+    def records
+      ::Identity.where(id: account.users.select(:identity_id))
+    end
+end
