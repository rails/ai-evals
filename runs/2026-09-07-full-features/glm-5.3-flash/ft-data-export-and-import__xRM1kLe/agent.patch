diff --git a/app/models/zip_file/archive.rb b/app/models/zip_file/archive.rb
new file mode 100644
index 0000000..1c7a398
--- /dev/null
+++ b/app/models/zip_file/archive.rb
@@ -0,0 +1,48 @@
+# A read-only view on a zip file. Zip Kit reads the central directory up front,
+# so entries can be read one by one without holding the archive in memory.
+class ZipFile::Archive
+  MANIFEST_PATH = "manifest.json"
+  CHUNK_SIZE = 1.megabyte
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def names
+    @entries.keys.sort
+  end
+
+  def exists?(name)
+    @entries.key?(name)
+  end
+
+  def glob(pattern)
+    names.select { |name| File.fnmatch(pattern, name, File::FNM_PATHNAME) }
+  end
+
+  def read(name)
+    buffer = StringIO.new
+
+    extract(name) { |chunk| buffer << chunk }
+
+    buffer.string
+  end
+
+  def read_json(name)
+    JSON.parse(read(name))
+  end
+
+  def extract(name)
+    entry = @entries.fetch(name) do
+      raise ZipKit::FileReader::ReadError, "No entry named #{name} in the archive"
+    end
+
+    extractor = entry.extractor_from(@io)
+    yield extractor.extract(CHUNK_SIZE) until extractor.eof?
+  end
+
+  def metadata
+    @metadata ||= read_json(MANIFEST_PATH) if exists?(MANIFEST_PATH)
+  end
+end
