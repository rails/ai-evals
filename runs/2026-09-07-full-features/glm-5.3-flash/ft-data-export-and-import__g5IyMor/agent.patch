diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..a860c28
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,63 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  class << self
+    def open(path)
+      file = File.open(path, "rb")
+      reader = new(file)
+      yield reader if block_given?
+      reader
+    ensure
+      file&.close
+    end
+  end
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |entry| File.fnmatch(pattern, entry) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read(path)
+    content = +"".b
+    each_chunk(path) { |chunk| content << chunk }
+    content
+  end
+
+  def extract(path)
+    tempfile = Tempfile.new([ "fizzy-import", File.extname(path) ])
+    tempfile.binmode
+
+    each_chunk(path) { |chunk| tempfile.write(chunk) }
+    tempfile.rewind
+    yield tempfile
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  private
+    def each_chunk(path)
+      extractor = extractor_for(path)
+
+      until extractor.eof?
+        chunk = extractor.extract(CHUNK_SIZE)
+        yield chunk unless chunk.nil? || chunk.empty?
+      end
+    end
+
+    def extractor_for(path)
+      entry_for(path).extractor_from(@io)
+    end
+
+    def entry_for(path)
+      @entries.fetch(path) { raise KeyError, "No entry #{path.inspect} in the zip file" }
+    end
+end
