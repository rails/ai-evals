diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..fcc1561
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const CARD_SELECTOR = '[data-drag-and-drop-target~="card"]'
+const COLUMN_SELECTOR = '[data-drag-and-drop-target~="column"]'
+const CARDS_LIST_SELECTOR = ".cards__list"
+const GOLDEN_CLASS = "golden-effect"
+const REQUEST_OPTIONS = { responseKind: "json" }
+
+// Cards can be dragged onto any of the board's places: one of its columns, the
+// "Maybe?" stream, "Not Now" or "Done". Columns keep their own order, so
+// dropping a card where it already belongs does nothing: dragging moves a card
+// between places, never within one.
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  dragStart(event) {
+    const card = event.target.closest(CARD_SELECTOR)
+    if (!card) return
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_ITEM_CLASS)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  dragOver(event) {
+    const column = event.target.closest(COLUMN_SELECTOR)
+
+    this.#highlight(column)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.element.contains(event.relatedTarget)) this.#highlight(null)
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const column = event.target.closest(COLUMN_SELECTOR)
+
+    event.preventDefault()
+    this.#resetDrag()
+
+    if (card && column) this.#move(card, column)
+  }
+
+  dragEnd() {
+    this.#resetDrag()
+  }
+
+  disconnect() {
+    this.#resetDrag()
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = true
+
+    // Let the whole card be the drag image, not the background picture inside it.
+    card.querySelectorAll("img").forEach(image => image.draggable = false)
+  }
+
+  // Private
+
+  #highlight(column) {
+    if (this.hoveredColumn === column) return
+
+    this.hoveredColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+    column?.classList.add(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = column
+  }
+
+  #resetDrag() {
+    this.#highlight(null)
+    this.#stopDragging(this.draggedCard)
+  }
+
+  #stopDragging(card) {
+    card?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedCard = null
+  }
+
+  async #move(card, column) {
+    if (!card.isConnected || this.#belongsTo(card, column)) return
+
+    const request = this.#requestFor(card, column)
+    if (!request) return
+
+    const position = { container: card.parentElement, sibling: card.previousElementSibling }
+    this.#placeInColumn(card, column)
+
+    const response = await request
+    if (!response.ok) this.#takeBack(card, position)
+  }
+
+  #belongsTo(card, column) {
+    return card.closest(COLUMN_SELECTOR) === column
+  }
+
+  #requestFor(card, column) {
+    const place = column.dataset.dragAndDropPlace
+    const urls = card.dataset
+
+    if (place === "stream" && urls.cardTriageUrl) return destroy(urls.cardTriageUrl, REQUEST_OPTIONS)
+    if (place === "not-now" && urls.cardNotNowUrl) return post(urls.cardNotNowUrl, REQUEST_OPTIONS)
+    if (place === "closed" && urls.cardClosureUrl) return post(urls.cardClosureUrl, REQUEST_OPTIONS)
+
+    if (place && urls.cardTriageUrl) return post(urls.cardTriageUrl, { ...REQUEST_OPTIONS, query: { column_id: place } })
+  }
+
+  // Moving the card before the request completes is what makes dragging feel
+  // instant: the board already looks the way the person left it, and nothing
+  // shifts once the save lands. Cards are ordered by recency, so the one just
+  // dropped leads its place, right after the golden ones, which always do.
+  #placeInColumn(card, column) {
+    const list = column.querySelector(CARDS_LIST_SELECTOR)
+    if (!list) return
+
+    const sibling = [ ...list.querySelectorAll(CARD_SELECTOR) ].find(card => !card.classList.contains(GOLDEN_CLASS))
+
+    if (sibling) {
+      sibling.parentElement.insertBefore(card, sibling)
+    } else {
+      list.append(card)
+    }
+  }
+
+  // Puts the card back where it came from when the save didn't go through.
+  #takeBack(card, { container, sibling }) {
+    if (!container?.isConnected) return
+
+    sibling ? sibling.after(card) : container.prepend(card)
+  }
+}
