diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..6dfbde3
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,168 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @board = boards(:writebook)
+    sign_in_as users(:david)
+    visit board_url(@board)
+  end
+
+  test "dragging a card onto a column moves it there" do
+    card = cards(:buy_domain)
+    destination = columns(:writebook_in_progress)
+
+    assert_card_in_place card, "maybe"
+    drag_card card, onto: destination
+
+    assert card_in?(destination, card), "the card should already be in its new place, without waiting for the save"
+    assert_equal destination.id, card.reload.column_id
+  end
+
+  test "dragging a card onto Done closes it" do
+    card = cards(:layout)
+
+    drag_card card, onto: "closed-cards"
+
+    assert card_in?("closed-cards", card)
+    assert card.reload.closed?
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    card = cards(:text)
+
+    drag_card card, onto: "not-now"
+
+    assert card_in?("not-now", card)
+    assert card.reload.postponed?
+  end
+
+  test "dragging a triaged card onto Maybe? sends it back to triage" do
+    card = cards(:logo)
+
+    drag_card card, onto: "maybe"
+
+    assert card_in?("maybe", card)
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging a closed card out of Done puts it back in a column" do
+    card = cards(:shipping)
+    destination = columns(:writebook_review)
+
+    drag_card card, onto: destination
+
+    assert card_in?(destination, card)
+    assert_not card.reload.closed?
+    assert_equal destination.id, card.reload.column_id
+  end
+
+  test "dropping a card where it already belongs does nothing" do
+    card = cards(:logo)
+    column = columns(:writebook_triage)
+
+    begin_dragging card
+
+    neighbour = previous_neighbour_of(card)
+    was_active_at = card.reload.last_active_at
+
+    hover column
+    drop
+    end_drag
+
+    # Give a stray request, should there be one, the time to land.
+    sleep 0.25
+
+    assert_equal neighbour, previous_neighbour_of(card), "the card should not have been moved"
+    assert_equal column.id, card.reload.column_id
+    assert_equal was_active_at, card.reload.last_active_at
+  end
+
+  test "the dragged card dims and the column under the pointer lights up" do
+    card = cards(:buy_domain)
+    destination = columns(:writebook_in_progress)
+
+    begin_dragging card
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+
+    hover destination
+    assert_selector "##{dom_id(destination)}.drag-and-drop__hover-container"
+
+    end_drag
+
+    assert_no_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_no_selector "##{dom_id(destination)}.drag-and-drop__hover-container"
+  end
+
+  private
+    # Selenium can't drive HTML5 drag and drop, so the events are dispatched by hand.
+    def drag_card(card, onto:)
+      begin_dragging card
+      hover onto
+      drop
+      end_drag
+    end
+
+    def begin_dragging(card)
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+
+      page.execute_script(<<~JS, dom_id(card, :article))
+        window.fizzyDrag = new DataTransfer()
+        document.getElementById(arguments[0]).dispatchEvent(
+          new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: window.fizzyDrag }))
+      JS
+
+      @dragged_card = card
+    end
+
+    def hover(place)
+      assert_selector "##{place_id(place)} .cards__list", visible: :all
+
+      page.execute_script(<<~JS, place_id(place))
+        document.getElementById(arguments[0]).dispatchEvent(
+          new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: window.fizzyDrag }))
+      JS
+
+      @hovered_place = place
+    end
+
+    def drop
+      page.execute_script(<<~JS, place_id(@hovered_place))
+        document.getElementById(arguments[0]).dispatchEvent(
+          new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: window.fizzyDrag }))
+      JS
+    end
+
+    def end_drag
+      release
+      @dragged_card = nil
+    end
+
+    def release
+      page.execute_script(<<~JS, dom_id(@dragged_card, :article))
+        document.getElementById(arguments[0]).dispatchEvent(
+          new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: window.fizzyDrag }))
+      JS
+    end
+
+    def place_id(place)
+      place.is_a?(String) ? place : dom_id(place)
+    end
+
+    # Whether the card element already sits inside the place, without waiting.
+    def card_in?(place, card)
+      page.execute_script("return !!document.querySelector('##{place_id(place)} ##{dom_id(card, :article)}')")
+    end
+
+    def previous_neighbour_of(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        const neighbour = document.getElementById(arguments[0]).previousElementSibling
+        return neighbour ? neighbour.id : ""
+      JS
+    end
+
+    def assert_card_in_place(card, place)
+      assert_selector "##{place_id(place)} ##{dom_id(card, :article)}", visible: :all
+    end
+end
