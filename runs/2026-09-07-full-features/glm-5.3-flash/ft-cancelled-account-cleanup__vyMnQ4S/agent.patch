diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..adcf0d8
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_1)
+    @webhook = webhooks(:active)
+  end
+
+  test "incinerates accounts cancelled more than the grace period ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update! created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not User.exists?(@user.id)
+    assert_not Board.exists?(@board.id)
+    assert_not Card.exists?(@card.id)
+    assert_not Comment.exists?(@comment.id)
+    assert_not Webhook.exists?(@webhook.id)
+    assert_not Event.exists?(account_id: @account.id)
+    assert_not Notification.exists?(account_id: @account.id)
+    assert_not Access.exists?(account_id: @account.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Attachment.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Blob.exists?(account_id: @account.id)
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps accounts that are not cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..2dc6726
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @comment = comments(:logo_1)
+    @webhook = webhooks(:active)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than the grace period ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update! created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts that are not cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate removes the account and all of its data" do
+    @card.image.attach(io: StringIO.new("image"), filename: "image.txt", content_type: "text/plain")
+    blob = ActiveStorage::Blob.where(account_id: @account.id).sole
+    Storage::Entry.create!(account: @account, board: @board, recordable: @card, delta: 10, operation: "create")
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not User.exists?(@user.id)
+    assert_not Board.exists?(@board.id)
+    assert_not Card.exists?(@card.id)
+    assert_not Comment.exists?(@comment.id)
+    assert_not Webhook.exists?(@webhook.id)
+    assert_not Event.exists?(account_id: @account.id)
+    assert_not Notification.exists?(account_id: @account.id)
+    assert_not Access.exists?(account_id: @account.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Attachment.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(blob.service.path_for(blob.key))
+  end
+
+  test "incinerate removes an account without any data" do
+    account = accounts(:initech)
+
+    account.incinerate
+
+    assert_not Account.exists?(account.id)
+  end
+end
