diff --git a/test/models/account_scoping_test.rb b/test/models/account_scoping_test.rb
new file mode 100644
index 0000000..8a6a25a
--- /dev/null
+++ b/test/models/account_scoping_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class AccountScopingTest < ActiveSupport::TestCase
+  # Tables that hold an account's data. Records hanging off another account-scoped record
+  # (an access off a board, a watch off a card) keep their own account_id too, so tenancy
+  # checks, exports and account incineration never have to hop through the owner.
+  ACCOUNT_SCOPED_TABLES = %w[
+    accesses
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  test "every table holding an account's data requires and indexes account_id" do
+    ACCOUNT_SCOPED_TABLES.each do |table|
+      column = connection.columns(table).find { |it| it.name == "account_id" }
+
+      assert_not_nil column, "#{table} has no account_id"
+      assert_not column.null, "#{table}.account_id must be required"
+      assert indexed_by_account?(table), "#{table}.account_id must be indexed"
+    end
+  end
+
+  test "tag titles are only unique within an account" do
+    index = connection.indexes("tags").find { |it| it.columns == %w[ account_id title ] }
+
+    assert index, "tags should be indexed on account_id and title"
+    assert index.unique, "tag titles should only be unique within an account"
+  end
+
+  private
+    def connection
+      ApplicationRecord.connection
+    end
+
+    def indexed_by_account?(table)
+      connection.indexes(table).any? { |index| index.columns.first == "account_id" }
+    end
+end
