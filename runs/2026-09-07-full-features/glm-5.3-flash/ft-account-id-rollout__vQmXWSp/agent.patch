+# Every table that holds an account's data now carries account_id, required and indexed.
+# Rows that can't be tied to an account are dropped rather than left behind as orphans.
+class AddAccountIdToRemainingAccountScopedTables < ActiveRecord::Migration[8.2]
+  # Tables that had no account_id yet, mapped to the owner they can be backfilled from.
+  SINGLE_BACKFILLS = {
+    "accesses" => [ "boards", "board_id" ],
+    "assignments" => [ "cards", "card_id" ],
+    "board_publications" => [ "boards", "board_id" ],
+    "card_activity_spikes" => [ "cards", "card_id" ],
+    "card_goldnesses" => [ "cards", "card_id" ],
+    "card_not_nows" => [ "cards", "card_id" ],
+    "closures" => [ "cards", "card_id" ],
+    "pins" => [ "cards", "card_id" ],
+    "search_queries" => [ "users", "user_id" ],
+    "taggings" => [ "cards", "card_id" ],
+    "user_settings" => [ "users", "user_id" ],
+    "watches" => [ "cards", "card_id" ],
+    "webhook_delinquency_trackers" => [ "webhooks", "webhook_id" ],
+    "webhook_deliveries" => [ "webhooks", "webhook_id" ]
+  }.freeze
+
+  # Same, but their owner is polymorphic, so each owner type backfills from its own table.
+  POLYMORPHIC_BACKFILLS = {
+    "mentions" => [ "source_type", "source_id" ],
+    "reactions" => [ "reactable_type", "reactable_id" ],
+    "action_text_rich_texts" => [ "record_type", "record_id" ],
+    "active_storage_attachments" => [ "record_type", "record_id" ]
+  }.freeze
+
+  TITLE_INDEX_NAME = "index_tags_on_title"
+  ACCOUNT_TITLE_INDEX_NAME = "index_tags_on_account_id_and_title"
+
+  # Every table that holds an account's data.
+  ACCOUNT_SCOPED_TABLES = %w[
+    accesses
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  def up
+    backfill_new_columns
+
+    ACCOUNT_SCOPED_TABLES.each do |table|
+      next unless table_exists?(table)
+
+      drop_orphans(table)
+      change_column_null table, :account_id, false
+      add_index table, :account_id unless indexed_by_account?(table)
+    end
+
+    scope_tag_uniqueness_to_account
+  end
+
+  def down
+    if table_exists?("tags")
+      remove_index "tags", name: ACCOUNT_TITLE_INDEX_NAME if index_name_exists?("tags", ACCOUNT_TITLE_INDEX_NAME)
+      add_index "tags", :title, unique: true, name: TITLE_INDEX_NAME
+    end
+
+    ACCOUNT_SCOPED_TABLES.reverse_each do |table|
+      next unless table_exists?(table)
+
+      change_column_null table, :account_id, true
+    end
+
+    (SINGLE_BACKFILLS.keys + POLYMORPHIC_BACKFILLS.keys + [ "entropies", "active_storage_blobs", "active_storage_variant_records" ]).each do |table|
+      remove_column table, :account_id if table_exists?(table)
+    end
+  end
+
+  private
+    # Tags are only unique within an account, so the global unique index on their title
+    # has to make room for an account scoped one.
+    def scope_tag_uniqueness_to_account
+      return unless table_exists?("tags")
+
+      remove_index "tags", name: TITLE_INDEX_NAME if index_name_exists?("tags", TITLE_INDEX_NAME)
+      add_index "tags", [ :account_id, :title ], unique: true, name: ACCOUNT_TITLE_INDEX_NAME
+    end
+
+    def backfill_new_columns
+      SINGLE_BACKFILLS.each do |table, (owner_table, foreign_key)|
+        add_account_id(table)
+        backfill_from(table, owner_table, foreign_key)
+      end
+
+      POLYMORPHIC_BACKFILLS.each do |table, (type_column, id_column)|
+        add_account_id(table)
+        backfill_from_owners(table, type_column, id_column)
+      end
+
+      add_account_id "entropies"
+      backfill_entropies
+
+      # Blobs are backfilled from their attachments, and variant records from their blobs,
+      # so they have to come last.
+      add_account_id "active_storage_blobs"
+      backfill_blobs
+
+      add_account_id "active_storage_variant_records"
+      backfill_variant_records
+    end
+
+    def add_account_id(table)
+      add_column table, :account_id, :uuid unless table_exists?(table) && column_exists?(table, :account_id)
+    end
+
+    def backfill_from(table, owner_table, foreign_key)
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (SELECT #{owner_table}.account_id FROM #{owner_table} WHERE #{owner_table}.id = #{table}.#{foreign_key})
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_from_owners(table, type_column, id_column)
+      types = select_values("SELECT DISTINCT #{type_column} FROM #{table}")
+
+      types.each do |type|
+        owner_table = table_for_owner_type(type)
+        next unless owner_table
+
+        execute <<~SQL
+          UPDATE #{table}
+          SET account_id = (SELECT #{owner_table}.account_id FROM #{owner_table} WHERE #{owner_table}.id = #{table}.#{id_column})
+          WHERE #{type_column} = #{quote(type)} AND account_id IS NULL
+        SQL
+      end
+    end
+
+    def backfill_entropies
+      execute <<~SQL
+        UPDATE entropies
+        SET account_id = CASE container_type
+          WHEN 'Account' THEN container_id
+          ELSE (SELECT boards.account_id FROM boards WHERE boards.id = entropies.container_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_blobs
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def backfill_variant_records
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    def table_for_owner_type(type)
+      owner = type.to_s.safe_constantize
+      return unless owner.is_a?(Class) && owner < ActiveRecord::Base
+
+      owner_table = owner.table_name
+      owner_table if table_exists?(owner_table) && column_exists?(owner_table, :account_id)
+    end
+
+    def drop_orphans(table)
+      execute "DELETE FROM #{table} WHERE account_id IS NULL"
+    end
+
+    def indexed_by_account?(table)
+      indexes(table).any? { |index| index.columns.first == "account_id" }
+    end
+end
