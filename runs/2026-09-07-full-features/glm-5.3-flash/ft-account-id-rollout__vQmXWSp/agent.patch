diff --git a/config/initializers/tenanting/attachments.rb b/config/initializers/tenanting/attachments.rb
new file mode 100644
index 0000000..6966fdf
--- /dev/null
+++ b/config/initializers/tenanting/attachments.rb
@@ -0,0 +1,32 @@
+# Attachments, blobs, variant records and rich texts all belong to the account that owns
+# the record they hang off. Carrying the account themselves keeps tenancy checks, exports
+# and account incineration from having to hop through the owner to find out where they live.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: true
+
+  before_create { self.account_id ||= Current.account&.id }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: true, default: -> { record.try(:account) || blob.try(:account) }
+
+  before_validation :assign_account_to_blob
+
+  private
+    # Blobs are built before they're attached, so which account they're for is only known
+    # once the record is in hand.
+    def assign_account_to_blob
+      if blob && account_id.present? && blob.account_id.blank?
+        blob.account_id = account_id
+      end
+    end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: true, default: -> { blob.try(:account) }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) }
+end
