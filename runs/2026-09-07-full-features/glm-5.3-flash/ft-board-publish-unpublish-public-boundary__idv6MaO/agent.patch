+@layer components {
+  .public-board {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--block-space);
+    margin: var(--block-space) auto;
+    max-inline-size: min(120ch, 100%);
+    padding-inline: var(--inline-space);
+  }
+
+  .public-board__column {
+    flex: 1 1 24ch;
+    min-inline-size: 0;
+  }
+
+  .public-board__column-name {
+    display: flex;
+    align-items: center;
+    gap: var(--inline-space-half);
+
+    a {
+      text-transform: uppercase;
+    }
+  }
+
+  .public-board__count {
+    border: var(--border);
+    border-radius: 1em;
+    color: var(--color-ink-light);
+    font-size: var(--text-x-small);
+    padding-inline: var(--inline-space);
+  }
+
+  .public-board__cards {
+    display: flex;
+    flex-direction: column;
+    gap: var(--block-space-half);
+    list-style: none;
+    margin: 0;
+    padding: 0;
+  }
+
+  .public-board__card {
+    background-color: var(--color-canvas);
+    border: var(--border);
+    border-radius: var(--panel-border-radius, 1em);
+    overflow-wrap: anywhere;
+    padding: var(--block-space-half) var(--block-space);
+
+    a {
+      color: inherit;
+      text-decoration: none;
+    }
+  }
+
+  .public-card {
+    margin: var(--block-space) auto;
+  }
+
+  .public-card__meta {
+    color: var(--color-ink-light);
+    display: flex;
+    gap: var(--inline-space);
+  }
+
+  .public-card__description {
+    img,
+    video,
+    attachment {
+      max-inline-size: 100%;
+    }
+  }
+
+  .public-card__image {
+    border-radius: var(--panel-border-radius, 1em);
+    max-inline-size: 100%;
+  }
+
+  .public-card__tags {
+    display: flex;
+    flex-wrap: wrap;
+    gap: var(--inline-space-half);
+    list-style: none;
+    margin: var(--block-space) 0 0;
+    padding: 0;
+
+    li {
+      border: var(--border);
+      border-radius: 1em;
+      color: var(--color-ink-light);
+      font-size: var(--text-x-small);
+      padding-inline: var(--inline-space);
+    }
+  }
+}
