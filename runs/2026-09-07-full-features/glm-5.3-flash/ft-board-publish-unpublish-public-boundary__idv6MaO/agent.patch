+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show to anyone with the secret link" do
+    get public_board_path(@board.key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+  end
+
+  test "show without authentication and without an account prefix" do
+    untenanted do
+      get public_board_path(@board.key)
+    end
+
+    assert_response :success
+  end
+
+  test "not found when the key is unknown" do
+    get public_board_path("unknown")
+
+    assert_response :not_found
+  end
+
+  test "not found when the board is not published" do
+    key = @board.key
+    @board.unpublish
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "show column" do
+    column = columns(:writebook_triage)
+
+    get public_board_column_path(@board.key, column)
+
+    assert_response :success
+    assert_select "h1", text: column.name
+    assert_select "a", text: cards(:logo).title
+    assert_select "a", text: cards(:layout).title
+  end
+
+  test "columns of another board are not found" do
+    other_board = boards(:miltons_wish_list)
+    other_board.publish
+    other_column = other_board.columns.create! name: "Other"
+
+    get public_board_column_path(@board.key, other_column)
+
+    assert_response :not_found
+  end
+
+  test "show card by number" do
+    card = cards(:logo)
+
+    get public_board_card_path(@board.key, card)
+
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "card images are publicly accessible" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg"
+
+    get public_board_card_path(@board.key, card)
+    assert_response :success
+
+    assert_select "img.public-card__image" do |images|
+      get images.first["src"]
+    end
+    assert_response :redirect # Authorized, redirects to the blob on the storage service
+    assert_match %r{/rails/active_storage/disk/}, response.location
+  end
+
+  test "drafted cards are not shown" do
+    cards(:logo).update! status: :drafted
+
+    get public_board_path(@board.key)
+    assert_response :success
+    assert_select "a", text: cards(:logo).title, count: 0
+
+    get public_board_card_path(@board.key, cards(:logo))
+    assert_response :not_found
+  end
+end
