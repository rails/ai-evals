+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "not published by default" do
+    assert_not boards(:writebook).published?
+    assert_nil boards(:writebook).public_url
+  end
+
+  test "publish" do
+    boards(:writebook).publish
+
+    assert boards(:writebook).reload.published?
+    assert boards(:writebook).published_at <= Time.current
+    assert boards(:writebook).key.present?
+    assert_equal boards(:writebook).key, boards(:writebook).public_key
+  end
+
+  test "publishing generates a new key" do
+    boards(:writebook).publish
+    key = boards(:writebook).key
+
+    boards(:writebook).unpublish
+    boards(:writebook).publish
+
+    assert_not_equal key, boards(:writebook).reload.key
+  end
+
+  test "unpublish" do
+    boards(:writebook).publish
+    boards(:writebook).unpublish
+
+    assert_not boards(:writebook).reload.published?
+    assert_nil boards(:writebook).key
+    assert_nil boards(:writebook).public_url
+  end
+
+  test "published scope" do
+    boards(:writebook).publish
+
+    assert_includes Board.published, boards(:writebook)
+    assert_not_includes Board.published, boards(:private)
+  end
+
+  test "public_url" do
+    boards(:writebook).publish
+    url = boards(:writebook).public_url
+
+    assert url.start_with?("http://example.com")
+    assert url.include?("/#{boards(:writebook).account.external_account_id}/public/boards/#{boards(:writebook).key}")
+  end
+
+  test "public_url uses the base URL of the current request" do
+    boards(:writebook).publish
+
+    Current.set(base_url: "http://fizzy.example") do
+      assert boards(:writebook).public_url.start_with?("http://fizzy.example")
+    end
+  end
+
+  test "publicly accessible when published" do
+    assert_not boards(:writebook).publicly_accessible?
+
+    boards(:writebook).publish
+    assert boards(:writebook).publicly_accessible?
+  end
+
+  test "cards are not publicly accessible on an unpublished board" do
+    assert_not cards(:logo).publicly_accessible?
+  end
+
+  test "published cards are publicly accessible on a published board" do
+    boards(:writebook).publish
+
+    assert cards(:logo).publicly_accessible?
+    assert_not cards(:unfinished_thoughts).publicly_accessible?
+  end
+end
