diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..d0e95d3
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,51 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(published_at: nil) }
+
+    alias_attribute :public_key, :key
+  end
+
+  def publish
+    update! published_at: Time.current, key: generate_key
+  end
+
+  def unpublish
+    update! published_at: nil, key: nil
+  end
+
+  def published?
+    published_at.present?
+  end
+
+  # Anyone holding the secret link may read a published board, including the
+  # attachments and rich text of its published cards.
+  def publicly_accessible?
+    published?
+  end
+
+  def public_url
+    "#{base_url}#{Rails.application.routes.url_helpers.public_board_path(key, script_name: account.slug)}" if published?
+  end
+
+  private
+    def generate_key
+      SecureRandom.base58(KEY_LENGTH)
+    end
+
+    # The base URL of the request we're responding to, or the one configured for
+    # links that are generated outside of a request (emails, webhooks, ...).
+    def base_url
+      Current.base_url ||
+        Rails.application.routes.url_helpers.root_url(**base_url_options).chomp("/")
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
