index 0000000..fae4d28
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,21 @@
+# Public boards are readable by anyone holding their secret link, whether
+# the request is tenanted or not: the board's key identifies both the board
+# and the account it belongs to.
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    skip_before_action :require_account
+
+    before_action :set_board
+
+    layout "public"
+  end
+
+  private
+    def set_board
+      @board = Board.published.find_by!(key: params[:key])
+      Current.account ||= @board.account
+    end
+end
