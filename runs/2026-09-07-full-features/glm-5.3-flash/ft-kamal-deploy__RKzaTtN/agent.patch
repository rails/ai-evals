diff --git a/bin/docker-entrypoint b/bin/docker-entrypoint
index ad59377..e70ad88 100755
--- a/bin/docker-entrypoint
+++ b/bin/docker-entrypoint
@@ -1,8 +1,16 @@
 #!/bin/bash -e
 
-# If running the rails server then create or migrate existing database
-if [ "${1}" == "./bin/thrust" ] && [ "${2}" == "./bin/rails" ] && [ "${3}" == "server" ]; then
-  MIGRATE=1 ./bin/rails db:prepare
-fi
+# The web server and the job supervisor both expect a prepared database, and
+# Kamal may boot them in either order, so let each one prepare it.
+case "${1}" in
+  ./bin/thrust)
+    if [ "${2}" == "./bin/rails" ] && [ "${3}" == "server" ]; then
+      MIGRATE=1 ./bin/rails db:prepare
+    fi
+    ;;
+  ./bin/jobs | bin/jobs)
+    MIGRATE=1 ./bin/rails db:prepare
+    ;;
+esac
 
 exec "${@}"
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..eeffd4a
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,100 @@
+# Kamal configuration for running Fizzy on a single box.
+#
+# Everything lives in one container on one Linux server: the web server, the
+# background jobs, the SQLite databases and the uploaded files. The databases
+# and the uploads are kept in a Docker volume, so they survive a deploy, a
+# container restart and a reboot. Certificates come from kamal-proxy, which
+# asks Let's Encrypt for them, so the box needs nothing but Docker and an open
+# port 443.
+#
+# Fill in the values marked with TODO, copy .kamal/secrets.example to
+# .kamal/secrets, then deploy with:
+#
+#   bin/kamal setup
+#
+# The whole process is described in docs/deployment.md.
+
+service: fizzy
+
+# TODO: Kamal builds the image locally and pushes it to a registry. Docker Hub
+# works out of the box; for ghcr.io or another registry, see kamal docs registry.
+image: your-dockerhub-username/fizzy
+
+# Kamal copies the fingerprinted assets out of the container and links the
+# running release to them.
+asset_path: /rails/public/assets
+
+# One box, two roles. Both run from the same image and mount the same volume.
+servers:
+  web:
+    hosts:
+      - fizzy.example.com # TODO: the hostname that points at your box
+
+  jobs:
+    hosts:
+      - fizzy.example.com
+    cmd: bin/jobs
+
+# Boot the roles one after the other, so that the job supervisor only starts
+# once the database has been prepared. There is no migration locking to rely
+# on when the database is SQLite.
+boot:
+  parallel_roles: false
+
+# Kamal connects to the box as root. To use another user instead, add:
+#
+#   ssh:
+#     user: deploy
+
+# kamal-proxy listens on 80 and 443, redirects HTTP to HTTPS and terminates
+# TLS with a Let's Encrypt certificate for the host above. The host has to
+# resolve to the box and port 443 has to be reachable from the internet.
+proxy:
+  ssl: true
+  host: fizzy.example.com # TODO: the same hostname as under servers.web
+  forward_headers: true # keep X-Forwarded-For, so we log real client IPs
+  # Imports and exports of large accounts shouldn't be cut off by the proxy.
+  response_timeout: 300
+
+# TODO: Create an access token at https://hub.docker.com/settings/security and
+# put it in .kamal/secrets as KAMAL_REGISTRY_PASSWORD.
+registry:
+  server: docker.io
+  username: your-dockerhub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Databases and uploaded files. Replacing the container is safe, wiping this
+# volume is not: it holds everything Fizzy stores.
+volumes:
+  - fizzy-storage:/rails/storage
+
+env:
+  clear:
+    # Jobs run in their own container, so keep them out of Puma.
+    SOLID_QUEUE_IN_PUMA: "false"
+    # One worker at a time: SQLite is happiest with a single writer.
+    JOB_CONCURRENCY: "1"
+    # Where emails and push notifications link back to. The same hostname as
+    # under servers.web and proxy.host.
+    APP_HOST: fizzy.example.com # TODO
+    # TODO: Your mail server, see docs/deployment.md. Leave SMTP_USER_NAME and
+    # SMTP_PASSWORD empty if the server takes mail without authentication.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: fizzy.example.com
+  secret:
+    # Decrypts config/credentials.yml.enc, see docs/deployment.md.
+    - RAILS_MASTER_KEY
+    - SMTP_USER_NAME
+    - SMTP_PASSWORD
+    # Web push notifications. Generate a key pair as described in
+    # docs/development.md, or remove these two lines to deploy without them.
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+
+# Build for the box's architecture only. Set to arm64 when deploying to an
+# ARM box, e.g. a Raspberry Pi or a Graviton instance.
+builder:
+  arch: amd64
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..056954e 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,35 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Outside of a request there is no host to build a URL from, so APP_HOST tells
+  # Fizzy where to point the links it generates on its own: in emails, in push
+  # notifications, in webhook deliveries and in exports.
+  if app_host = ENV["APP_HOST"]
+    protocol = config.force_ssl ? "https" : "http"
+    config.action_controller.default_url_options = { host: app_host, protocol: protocol }
+    config.action_mailer.default_url_options     = { host: app_host, protocol: protocol }
+  end
+
+  # Outbound mail is sent through the SMTP server named by SMTP_ADDRESS. Set
+  # SMTP_USER_NAME and SMTP_PASSWORD when the server wants to be authenticated,
+  # see docs/deployment.md.
+  if smtp_address = ENV["SMTP_ADDRESS"]
+    smtp_settings = {
+      address: smtp_address,
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      domain: ENV["SMTP_DOMAIN"].presence,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }
+
+    if ENV["SMTP_USER_NAME"].present? && ENV["SMTP_PASSWORD"].present?
+      smtp_settings[:user_name] = ENV["SMTP_USER_NAME"]
+      smtp_settings[:password] = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym
+    end
+
+    config.action_mailer.smtp_settings = smtp_settings
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..f20b4c9
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,121 @@
+## Deployment
+
+Fizzy ships with a [Kamal](https://kamal-deploy.org) configuration, `config/deploy.yml`, that
+runs the whole application on a single box:
+
+- One Linux server: the web server and the background jobs run as two containers, built from the same image.
+- SQLite for everything: the app database plus the cache, queue and cable databases.
+- Uploads on the local disk, inside a Docker volume.
+- HTTPS from [kamal-proxy](https://github.com/basecamp/kamal-proxy), which asks Let's Encrypt for a certificate for your hostname and renews it for you.
+
+There is no MySQL, no Redis and no object storage to look after. What you need
+is a server that can run Docker, a hostname that points at it and a mail server
+to deliver the magic links that sign people in.
+
+### What you need
+
+- A Linux server that you can SSH into as root: 1 CPU and 2 GB of RAM are a comfortable start.
+- A hostname, e.g. `fizzy.example.com`, with an A or AAAA record pointing at the server. Ports 80 and 443 have to be reachable, since Let's Encrypt validates them.
+- A container registry that Kamal can push the built image to. Docker Hub works out of the box.
+- A mail server: either an SMTP relay from your mail provider or your own.
+
+### 1. Fill in the deploy config
+
+Open `config/deploy.yml` and fill in the values marked with `TODO`:
+
+- `image` and `registry.username`, e.g. `yourname/fizzy`
+- the hostname, in `servers.web.hosts`, in `servers.jobs.hosts`, in `proxy.host` and in `APP_HOST`
+- the mail server, in `MAILER_FROM_ADDRESS`, `SMTP_ADDRESS` and `SMTP_DOMAIN`
+
+All four of those name the same host. `proxy.host` is what kamal-proxy
+listens for and what it orders the certificate for, and `APP_HOST` is what
+Fizzy uses for the links it builds outside of a request: in emails, in push
+notifications, in webhook deliveries and in exports.
+
+Leave the `SMTP_PORT` at `587` unless your mail server says otherwise, and drop
+`SMTP_USER_NAME` and `SMTP_PASSWORD` from `config/deploy.yml` and
+`.kamal/secrets` when it takes mail without authentication. Two more knobs,
+`SMTP_AUTHENTICATION` (defaults to `plain`) and `SMTP_ENABLE_STARTTLS_AUTO`
+(defaults to `true`), cover the unusual ones.
+
+### 2. Add your secrets
+
+Copy the example and fill it in:
+
+```sh
+cp .kamal/secrets.example .kamal/secrets
+```
+
+| Secret | What it is |
+| --- | --- |
+| `KAMAL_REGISTRY_PASSWORD` | An access token for your registry, e.g. from [Docker Hub](https://hub.docker.com/settings/security) |
+| `RAILS_MASTER_KEY` | Decrypts `config/credentials.yml.enc`. Run `EDITOR="vi" bin/rails credentials:edit` once to create the key pair, the secret file picks it up from `config/master.key` |
+| `SMTP_USER_NAME`, `SMTP_PASSWORD` | Credentials for your mail server |
+| `VAPID_PRIVATE_KEY`, `VAPID_PUBLIC_KEY` | A [VAPID](docs/development.md#web-push-notifications) key pair, for browser push notifications. Remove both from `config/deploy.yml` if you don't want them |
+
+`.kamal/secrets` is git-ignored. It never leaves your machine: Kamal passes the
+secrets on to the server in an env file next to the containers.
+
+### 3. Deploy
+
+```sh
+bin/kamal setup
+```
+
+This installs Docker on the box if it is missing, starts kamal-proxy on ports 80
+and 443, builds the image, pushes it to your registry, prepares the databases,
+boots the app and the jobs, and requests the certificate. The first run takes a
+while; later deploys are much quicker.
+
+When it finishes, Fizzy is at `https://your-host`. Sign up with your email
+address and follow the magic link. The first account closes sign-ups, so invite
+everyone else with the invite link in your account settings.
+
+### 4. Deploy again tomorrow
+
+```sh
+bin/kamal deploy
+```
+
+A deploy replaces the containers and migrates the database, but not the volume,
+so your data is still there. Other commands worth knowing:
+
+```sh
+bin/kamal logs -f                  # follow the app logs
+bin/kamal logs -r jobs -f          # follow the background jobs
+bin/kamal app exec --reuse -i "bin/rails console"
+bin/kamal proxy logs               # the proxy, useful for certificate trouble
+bin/kamal details                  # what is running where
+bin/kamal rollback [version]       # go back to the previous release
+```
+
+### Where the data lives
+
+Everything Fizzy stores is in the Docker volume `fizzy-storage`, mounted at
+`/rails/storage`:
+
+- `production.sqlite3` — boards, cards, users
+- `production_queue.sqlite3` — background jobs
+- `production_cache.sqlite3` — cache
+- `production_cable.sqlite3` — Turbo Streams
+- `production/files` — uploaded attachments
+
+A deploy, a container restart or a reboot leaves all of that alone. Deleting
+the volume does not, so back it up:
+
+```sh
+bin/kamal app stop
+ssh root@your-host 'docker run --rm -v fizzy-storage:/storage -v "$PWD":/backup alpine \
+  tar czf /backup/fizzy-storage-$(date +%F).tgz -C /storage .'
+bin/kamal app start
+```
+
+The app is stopped while you copy, so the SQLite files are consistent. Restore
+by unpacking the archive back into the volume with the app stopped.
+
+### Building from another machine
+
+Kamal builds the image on your machine and pushes it to the registry, so the
+box itself needs no build tooling. `config/deploy.yml` builds for `amd64`; set
+`builder.arch` to `arm64` if your box is an ARM machine, and build from a
+machine of that architecture or add a remote builder.
