diff --git a/.kamal/secrets.example b/.kamal/secrets.example
new file mode 100644
index 0000000..550fc1d
--- /dev/null
+++ b/.kamal/secrets.example
@@ -0,0 +1,37 @@
+# Copy this file to .kamal/secrets and fill in the values:
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# .kamal/secrets is git-ignored and never leaves your machine: Kamal only uses
+# it to fill in the secrets listed under env.secret in config/deploy.yml, which
+# it stores on the server in an env file next to the containers.
+#
+# Lines are KEY=value pairs. Values may use $(command) substitution, so you can
+# keep secrets in a password manager or in a file that is already on disk.
+#
+# Deploying to more than one environment? Put shared secrets in
+# .kamal/secrets-common and per-environment ones in .kamal/secrets.production.
+
+# Registry credentials. Create an access token at
+# https://hub.docker.com/settings/security and paste it here.
+KAMAL_REGISTRY_PASSWORD=
+
+# Decrypts config/credentials.yml.enc. Create the key pair once with
+# EDITOR="vi" bin/rails credentials:edit, which leaves the key in
+# config/master.key for this line to pick up.
+RAILS_MASTER_KEY=$(cat config/master.key)
+
+# Mail server credentials, matching the SMTP_USER_NAME and SMTP_PASSWORD
+# settings in config/deploy.yml. Leave both empty if your mail server takes
+# mail without authentication.
+SMTP_USER_NAME=
+SMTP_PASSWORD=
+
+# Web push notifications. Generate a key pair with:
+#
+#   bin/rails runner 'k = WebPush.generate_key; puts "VAPID_PRIVATE_KEY=#{k.private_key}"; puts "VAPID_PUBLIC_KEY=#{k.public_key}"'
+#
+# Or remove VAPID_PRIVATE_KEY and VAPID_PUBLIC_KEY from config/deploy.yml if
+# you don't want browser push notifications.
+VAPID_PRIVATE_KEY=
+VAPID_PUBLIC_KEY=
