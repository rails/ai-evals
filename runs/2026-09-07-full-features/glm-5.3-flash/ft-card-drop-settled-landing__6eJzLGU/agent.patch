diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..1697df1
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,137 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:layout)
+  end
+
+  test "dragging a card onto another column moves it there" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: dom_id(columns(:writebook_in_progress)))
+
+    assert_card_in_column(@card, columns(:writebook_in_progress))
+    wait_for { @card.reload.column == columns(:writebook_in_progress) }
+  end
+
+  test "the column under the pointer lights up" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: dom_id(columns(:writebook_in_progress)), events: [ :dragstart, :dragover ])
+
+    assert_selector "##{dom_id(columns(:writebook_in_progress))}.drag-and-drop__hover-container"
+  end
+
+  test "the dragged card dims" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: dom_id(columns(:writebook_in_progress)), events: [ :dragstart ])
+
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+  end
+
+  test "dragging a card back onto its own column leaves the board alone" do
+    visit board_url(@board)
+
+    assert_no_changes -> { cards_in(@card.column) } do
+      drag_card(@card, onto: dom_id(@card.column))
+    end
+  end
+
+  test "the board stays as it was left after the save" do
+    visit board_url(@board)
+    wait_for_cable_subscriptions
+
+    drag_card(@card, onto: dom_id(columns(:writebook_in_progress)))
+
+    assert_card_in_column(@card, columns(:writebook_in_progress))
+    wait_for { @card.reload.column == columns(:writebook_in_progress) }
+
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_card_in_column(@card, columns(:writebook_in_progress))
+    assert_selector "##{dom_id(@card, :article)}", count: 1, visible: :all
+  end
+
+  test "dragging a card onto Maybe sends it back to triage" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: "maybe")
+
+    assert_card_in_column(@card, "maybe")
+    wait_for { @card.reload.column.nil? }
+  end
+
+  test "dragging a card onto Done closes it" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: "closed-cards")
+
+    assert_card_in_column(@card, "closed-cards")
+    wait_for { @card.reload.closed? }
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    visit board_url(@board)
+
+    drag_card(@card, onto: "not-now")
+
+    assert_card_in_column(@card, "not-now")
+    wait_for { @card.reload.postponed? }
+  end
+
+  private
+    # Simulates an HTML5 drag of the card onto the column with the given id.
+    def drag_card(card, onto:, events: [ :dragstart, :dragover, :drop, :dragend ])
+      wait_for do
+        page.has_selector?("##{column_id(onto)} .cards__list", visible: :all) &&
+          page.has_selector?("##{dom_id(card, :article)}", visible: :all)
+      end
+
+      page.execute_script drag_script, dom_id(card, :article), "##{column_id(onto)}", events.map(&:to_s)
+    end
+
+    def drag_script
+      <<~JS
+        const [ cardId, columnSelector, events ] = arguments
+        const card = document.getElementById(cardId)
+        const column = document.querySelector(columnSelector)
+        const transfer = new DataTransfer()
+
+        events.forEach(event => {
+          const options = { bubbles: true, cancelable: true, dataTransfer: transfer }
+          const element = [ "dragstart", "dragend" ].includes(event) ? card : column.querySelector(".cards__header")
+          element.dispatchEvent(new DragEvent(event, options))
+        })
+      JS
+    end
+
+    def assert_card_in_column(card, column)
+      within "##{column_id(column)} .cards__list", visible: :all do
+        assert_selector "##{dom_id(card, :article)}", visible: :all
+      end
+    end
+
+    def cards_in(column)
+      page.all("##{column_id(column)} .cards__list .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def column_id(column)
+      column.is_a?(Column) ? dom_id(column) : column.to_s
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    # The card is placed as soon as it's dropped, the save itself happens in the background.
+    def wait_for
+      page.document.synchronize { yield || raise(Capybara::ElementNotFound, "condition was not met") }
+    end
+end
