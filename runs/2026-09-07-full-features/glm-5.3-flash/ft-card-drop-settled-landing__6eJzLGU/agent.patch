diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..c8a4ed6
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,100 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+// Move a card somewhere else on the board by dragging it onto another column.
+// The card is placed the moment it's dropped and the change is saved in the
+// background, so the board already shows what was asked for without waiting
+// for the save.
+export default class extends Controller {
+  static targets = [ "column" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  start(event) {
+    const card = this.#cardFrom(event.target)
+    if (!card) return
+
+    this.card = card
+
+    // Firefox refuses to drag unless the transfer carries some data.
+    event.dataTransfer.setData("text/plain", card.id)
+    event.dataTransfer.effectAllowed = "move"
+    card.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    if (!this.#isDragging) return
+
+    const column = this.#columnFrom(event.target)
+    if (!column) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  leave(event) {
+    if (!this.#isDragging || !this.hoveredColumn) return
+    if (this.hoveredColumn.contains(event.relatedTarget)) return
+
+    this.#highlight(null)
+  }
+
+  drop(event) {
+    if (!this.#isDragging) return
+
+    event.preventDefault()
+    this.#place(this.#columnFrom(event.target))
+  }
+
+  end() {
+    this.#highlight(null)
+    this.card?.classList.remove(this.draggedItemClass)
+    this.card = null
+  }
+
+  // Private
+
+  get #isDragging() {
+    return this.card != null
+  }
+
+  #cardFrom(target) {
+    return target.closest('[data-drag-and-drop-target~="item"]')
+  }
+
+  #columnFrom(target) {
+    return this.columnTargets.find(column => column === target || column.contains(target))
+  }
+
+  #highlight(column) {
+    if (column === this.hoveredColumn) return
+
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = column
+    this.hoveredColumn?.classList.add(this.hoverContainerClass)
+  }
+
+  #place(column) {
+    if (!column || column === this.#columnFrom(this.card)) return
+
+    column.querySelector(".cards__list")?.prepend(this.card)
+    this.#savePlacement(column)
+  }
+
+  #savePlacement(column) {
+    switch (column.dataset.dragAndDropDestinationValue) {
+      case "column":
+        post(this.card.dataset.cardTriageUrl, { body: { column_id: column.dataset.dragAndDropColumnIdValue }, responseKind: "json" })
+        break
+      case "maybe":
+        destroy(this.card.dataset.cardTriageUrl, { responseKind: "json" })
+        break
+      case "not_now":
+        post(this.card.dataset.cardNotNowUrl, { responseKind: "json" })
+        break
+      case "closed":
+        post(this.card.dataset.cardClosureUrl, { responseKind: "json" })
+        break
+    }
+  }
+}
