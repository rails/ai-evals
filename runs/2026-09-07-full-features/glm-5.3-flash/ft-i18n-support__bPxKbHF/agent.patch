diff --git a/app/controllers/concerns/with_locale.rb b/app/controllers/concerns/with_locale.rb
new file mode 100644
index 0000000..5b06211
--- /dev/null
+++ b/app/controllers/concerns/with_locale.rb
@@ -0,0 +1,45 @@
+# Restores the language chosen by the person making the request.
+#
+# A request can force it with `?locale=ja`. When it is a locale we offer, the
+# choice sticks: it is remembered in a cookie for the rest of the session and,
+# for signed-in people, saved as their preference so that they get their
+# language back on a clean browser and in their emails. Anything else we don't
+# understand is ignored, never an error.
+module WithLocale
+  extend ActiveSupport::Concern
+
+  COOKIE = :locale
+
+  included do
+    around_action :with_locale
+
+    helper_method :selected_locale
+  end
+
+  private
+    def with_locale(&)
+      I18n.with_locale(selected_locale, &)
+    end
+
+    def selected_locale
+      @selected_locale ||= begin
+        locale = requested_locale || remembered_locale || I18n.default_locale
+        remember_locale(locale) if requested_locale
+        locale
+      end
+    end
+
+    # The locale explicitly asked for by the request, if we offer it.
+    def requested_locale
+      @requested_locale ||= Locale[params[:locale]]
+    end
+
+    def remembered_locale
+      Locale[cookies[COOKIE]] || Current.identity&.locale
+    end
+
+    def remember_locale(locale)
+      cookies[COOKIE] = { value: locale.to_s, expires: 1.year.from_now, httponly: true }
+      Current.identity&.update!(locale: locale) if Current.identity && Current.identity.locale != locale.to_s
+    end
+end
