diff --git a/app/models/locale.rb b/app/models/locale.rb
new file mode 100644
index 0000000..06282fc
--- /dev/null
+++ b/app/models/locale.rb
@@ -0,0 +1,19 @@
+# The languages Fizzy speaks. Answers the question "is this a locale we offer?"
+# and silently refuses everything else.
+class Locale
+  class << self
+    # Returns the locale if we offer it, nil for anything else (including nil).
+    def [](value)
+      candidate = value.to_s.downcase.presence
+      candidate if candidate.in?(available)
+    end
+
+    def available
+      I18n.available_locales.map(&:to_s)
+    end
+
+    def default
+      I18n.default_locale.to_s
+    end
+  end
+end
