+# English locale data for the Rails framework pieces, including the formats
+# Fizzy uses for the dates it renders itself.
+en:
+  date:
+    formats:
+      default: "%Y-%m-%d"
+      long: "%B %-d, %Y"
+      short: "%b %-d"
+      day_month: "%B %-d"
+      day_month_year: "%B %-d, %Y"
+      stamp: "%b %d, %Y"
+      weekday_day_month: "%A, %B %-d"
+      time_of_day: "%l:%M %P"
+      weekday: "%A"
+  time:
+    formats:
+      default: "%a, %-d %b %Y %H:%M:%S %z"
+      long: "%B %-d, %Y %H:%M"
+      short: "%-d %b %H:%M"
+      time_only: "%l:%M %P"
+      stamp: "%b %d, %Y"
+      day_month: "%B %-d"
+      day_month_year: "%B %-d, %Y"
+      weekday_day_month: "%A, %B %-d"
+      weekday: "%A"
+      notification: "%-l%P on %A, %B %-d"
