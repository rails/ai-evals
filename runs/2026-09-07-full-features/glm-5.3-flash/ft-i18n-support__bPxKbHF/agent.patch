+# Emails are written by background jobs, long after the request that triggered
+# them, so the language can't come from a cookie or the session. It comes from
+# the person the email is headed to.
+module WithRecipientLocale
+  extend ActiveSupport::Concern
+
+  private
+    def with_locale_for(recipient, &)
+      I18n.with_locale(Locale[recipient.locale], &)
+    end
+end
