diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..ea65d1b
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,75 @@
+// Turns raw timestamps into words in the viewer's own timezone. The server only
+// ships the timestamp (see TimeHelper); the browser decides what it says.
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const SECONDS_IN_MINUTE = 60
+const SECONDS_IN_HOUR = 60 * SECONDS_IN_MINUTE
+
+// Past a week, a day count is harder to read than a date, so we switch over.
+const RELATIVE_DAY_LIMIT = 7
+
+const relative = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" })
+const clock = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const day = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const dayWithYear = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const wholeDay = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const wholeDayWithYear = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" })
+const shortDateAndTime = new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" })
+
+export function formatTimestamp(timestamp, style = "relative") {
+  if (!timestamp) return ""
+
+  const date = new Date(timestamp)
+  if (isNaN(date)) return ""
+
+  switch (style) {
+    case "date": return formatDate(date)
+    case "date_with_year": return formatDate(date, true)
+    case "long_date": return formatLongDate(date)
+    case "time": return clock.format(date)
+    case "short_datetime": return shortDateAndTime.format(date)
+    default: return formatRelative(date)
+  }
+}
+
+function formatRelative(date) {
+  const now = new Date()
+  const dayDifference = signedDifferenceInDays(now, date)
+
+  if (dayDifference === 0) {
+    // Earlier today reads as a clock, later today as a countdown.
+    return date <= now ? clock.format(date) : formatDuration(date - now)
+  }
+
+  if (dayDifference > 0) return formatAhead(dayDifference)
+  if (dayDifference > -RELATIVE_DAY_LIMIT) return relative.format(dayDifference, "day")
+
+  return formatDate(date)
+}
+
+function formatDuration(milliseconds) {
+  const seconds = milliseconds / 1000
+
+  if (seconds < SECONDS_IN_MINUTE) return relative.format(Math.max(1, Math.round(seconds)), "second")
+  if (seconds < SECONDS_IN_HOUR) return relative.format(Math.round(seconds / SECONDS_IN_MINUTE), "minute")
+  return relative.format(Math.round(seconds / SECONDS_IN_HOUR), "hour")
+}
+
+function formatAhead(dayDifference) {
+  if (dayDifference >= 365) return relative.format(Math.round(dayDifference / 365), "year")
+  if (dayDifference >= 60) return relative.format(Math.round(dayDifference / 30), "month")
+  return relative.format(dayDifference, "day")
+}
+
+function formatDate(date, withYear = false) {
+  return sayYear(date, withYear) ? dayWithYear.format(date) : day.format(date)
+}
+
+function formatLongDate(date, withYear = false) {
+  return sayYear(date, withYear) ? wholeDayWithYear.format(date) : wholeDay.format(date)
+}
+
+// A date from another year says so, otherwise the year is noise.
+function sayYear(date, always) {
+  return always || date.getFullYear() !== new Date().getFullYear()
+}
