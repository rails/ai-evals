diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..63fff9b
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_helpers"
+
+// Fills in the <time> elements the server ships empty, using the viewer's own
+// timezone. See TimeHelper for the markup we start from.
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+
+    this.boundRender = this.render.bind(this)
+    this.element.addEventListener("turbo:morph-element", this.boundRender)
+
+    track(this)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("turbo:morph-element", this.boundRender)
+
+    untrack(this)
+  }
+
+  styleValueChanged() {
+    this.render()
+  }
+
+  render() {
+    this.element.textContent = formatTimestamp(this.element.getAttribute("datetime"), this.styleValue)
+  }
+}
+
+// Everything on the page shares a single clock, so that "yesterday" turns into
+// "1:42 PM" without anybody having to reload.
+const REFRESH_INTERVAL = 60_000
+
+const rendered = new Set()
+let clock
+
+function track(controller) {
+  rendered.add(controller)
+  clock ||= setInterval(() => rendered.forEach(controller => controller.render()), REFRESH_INTERVAL)
+}
+
+function untrack(controller) {
+  rendered.delete(controller)
+  if (rendered.size === 0) {
+    clearInterval(clock)
+    clock = null
+  }
+}
