@@ -0,0 +1,124 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:layout)
+  end
+
+  test "a card page turns its timestamps into words" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+
+    assert_selector "time[datetime]"
+    assert_all_times_are_rendered
+  end
+
+  test "a broadcast refresh keeps putting fresh timestamps into words" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:layout))
+
+    assert_selector "time[datetime]"
+    wait_for_cable_subscriptions
+
+    @card.update!(last_active_at: 1.minute.ago)
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector %(time[datetime='#{@card.reload.last_active_at.utc.iso8601}']), wait: 5
+    assert_all_times_are_rendered
+  end
+
+  test "times are words in the viewer's own timezone" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    probed_times
+
+    assert_time "earlier today", /\d{1,2}:\d{2} [AP]M/
+    assert_time "later today", /^in /
+    assert_time "yesterday", "yesterday"
+    assert_time "three days ago", "3 days ago"
+    assert_time "last week", /^[A-Z][a-z]{2} \d{1,2}$/
+    assert_time "tomorrow", "tomorrow"
+    assert_time "in three days", "in 3 days"
+  end
+
+  private
+    def assert_time(name, expected)
+      assert_match expected, probed_times.fetch(name), "\"#{name}\" was not rendered as expected"
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def assert_all_times_are_rendered
+      times = {}
+
+      20.times do
+        times = rendered_times("time[datetime]")
+        break if times.values.all?(&:present?)
+
+        sleep 0.1
+      end
+
+      assert times.values.all?(&:present?), "Every timestamp should have been rendered, got: #{times.inspect}"
+    end
+
+    def probed_times
+      @probed_times ||= begin
+        page.execute_script(PROBE_SCRIPT)
+
+        times = {}
+        20.times do
+          times = rendered_times("time[data-probe]")
+          break if times.values.all?(&:present?)
+
+          sleep 0.1
+        end
+        times
+      end
+    end
+
+    def rendered_times(selector)
+      page.evaluate_script <<~JS
+        Object.fromEntries(
+          Array.from(document.querySelectorAll("#{selector}")).map(element => {
+            return [ element.dataset.probe || element.getAttribute("datetime"), element.textContent ]
+          })
+        )
+      JS
+    end
+
+    PROBE_SCRIPT = <<~JS
+      const now = new Date()
+
+      const atNoon = days => {
+        const date = new Date(now)
+        date.setDate(date.getDate() + days)
+        date.setHours(12, 0, 0, 0)
+        return date
+      }
+
+      const earlierToday = now.getHours() > 0 ? new Date(now).setHours(0, 1, 0, 0) : now.getTime() - 1000
+
+      const probes = {
+        "earlier today": new Date(earlierToday),
+        "later today": new Date(now.getTime() + 3_600_000),
+        "yesterday": atNoon(-1),
+        "three days ago": atNoon(-3),
+        "last week": atNoon(-8),
+        "tomorrow": atNoon(1),
+        "in three days": atNoon(3)
+      }
+
+      for (const [ name, date ] of Object.entries(probes)) {
+        const element = document.createElement("time")
+        element.dataset.probe = name
+        element.setAttribute("datetime", date.toISOString())
+        element.setAttribute("data-controller", "local-time")
+        document.body.appendChild(element)
+      }
+    JS
+end
