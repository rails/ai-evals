+require "test_helper"
+
+class LocalTimeTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "card pages ship timestamps for the browser to put into words" do
+    get card_path(cards(:logo))
+
+    assert_select "time[datetime]" do |times|
+      assert times.size > 0, "Expected the card to show when it was added and updated"
+      times.each { |time| assert_empty time.text, "Times should be rendered by the browser, not by the server" }
+    end
+  end
+
+  test "activity pages ship timestamps for the browser to put into words" do
+    travel_to Time.utc(2025, 1, 22, 17, 30, 0)
+    events(:layout_assignment_jz).update!(created_at: Time.current.beginning_of_day + 8.hours)
+
+    get events_path
+
+    assert_select "time[datetime]" do |times|
+      assert times.size > 0, "Expected the timeline to show when things happened"
+      times.each { |time| assert_empty time.text, "Times should be rendered by the browser, not by the server" }
+    end
+  end
+
+  test "timestamps read the same whatever timezone the viewer is in" do
+    get card_path(cards(:logo))
+    from_los_angeles = rendered_times
+
+    cookies[:timezone] = "Asia/Tokyo"
+    get card_path(cards(:logo))
+
+    assert_equal from_los_angeles, rendered_times
+    assert rendered_times.size > 0
+  end
+
+  private
+    def rendered_times
+      css_select("time[datetime]").map(&:to_html)
+    end
+end
