diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b960788 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,40 @@
+# Times and dates are rendered by the browser, so that everybody reads them in
+# their own timezone and pages stay cacheable: the HTML we ship is identical for
+# everybody, and only carries raw timestamps. See local_time_controller.js for
+# the browser side of this.
 module TimeHelper
+  # The styles the browser knows how to put a timestamp into words:
+  #
+  #   * :relative       "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow", "in 3 days"
+  #   * :date           "Sep 12"
+  #   * :date_with_year "Sep 12, 2025"
+  #   * :long_date      "Friday, September 12"
+  #   * :time           "1:42 PM"
+  #   * :short_datetime "9/12/25, 1:42 PM"
+
+  # Renders an instant as a <time> element for the browser to format.
+  #
+  #   local_time_tag(comment.created_at)                     # => "1:42 PM", "yesterday", "5 days ago", "Sep 12"
+  #   local_time_tag(card.entropy.auto_clean_at)             # => "tomorrow", "in 3 days"
+  #   local_time_tag(event.created_at, style: :time)         # => "1:42 PM"
+  def local_time_tag(time, style: :relative, **options)
+    tag.time datetime: time.utc.iso8601, **local_time_options(style, **options)
+  end
+
+  # Renders a calendar date, one that means the same day no matter where the
+  # viewer is. Timelines are built around days, not around instants.
+  #
+  #   local_date_tag(day_timeline.day)                       # => "Friday, September 12"
+  def local_date_tag(date, style: :long_date, **options)
+    tag.time datetime: "#{date.to_date.iso8601}T00:00:00", **local_time_options(style, **options)
+  end
+
+  private
+    def local_time_options(style, **options)
+      data = (options.delete(:data) || {}).dup
+      data[:controller] = [ data[:controller], "local-time" ].compact.join(" ")
+      data[:local_time_style_value] = style
+
+      options.merge(data: data)
+    end
 end
