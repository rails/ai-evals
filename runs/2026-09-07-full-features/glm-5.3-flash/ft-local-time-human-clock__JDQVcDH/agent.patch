+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders an instant for the browser to format" do
+    travel_to Time.zone.parse("2026-01-15 12:00") do
+      assert_equal_html \
+        %(<time datetime="2026-01-12T15:42:00Z" data-controller="local-time" data-local-time-style-value="relative"></time>),
+        local_time_tag(Time.zone.parse("2026-01-12 15:42"))
+    end
+  end
+
+  test "renders a calendar date for the browser to format" do
+    assert_equal_html \
+      %(<time datetime="2026-01-12T00:00:00" data-controller="local-time" data-local-time-style-value="long_date"></time>),
+      local_date_tag(Time.zone.parse("2026-01-12 15:42"))
+  end
+
+  test "carries the requested style" do
+    assert_equal_html \
+      %(<time datetime="2026-01-12T15:42:00Z" data-controller="local-time" data-local-time-style-value="date"></time>),
+      local_time_tag(Time.zone.parse("2026-01-12 15:42"), style: :date)
+  end
+
+  test "carries options through to the element" do
+    html = local_time_tag(Time.zone.parse("2026-01-12 15:42"), class: "card__timestamp", id: "stamp",
+      data: { controller: "tooltip" })
+
+    assert_equal_html \
+      %(<time datetime="2026-01-12T15:42:00Z" class="card__timestamp" id="stamp" data-controller="tooltip local-time" data-local-time-style-value="relative"></time>),
+      html
+  end
+
+  test "renders an empty element, so that cached pages read the same for everybody" do
+    assert_no_match(/ago/, local_time_tag(2.days.ago))
+    assert_no_match(/PM/, local_time_tag(2.hours.ago))
+  end
+end
