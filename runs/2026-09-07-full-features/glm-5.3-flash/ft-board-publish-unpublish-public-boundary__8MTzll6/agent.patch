+<% @page_title = @card.title %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to "Back to board", public_board_path(@board.publication_key), class: "btn btn--plain txt-link" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="panel shadow public-card">
+  <div class="flex align-center justify-space-between gap-half">
+    <span class="txt-subtle txt-x-small">#<%= @card.number %></span>
