diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..50cbd6b
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,53 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(published_at: nil).or(where.not(public_key: nil)) }
+  end
+
+  # A board is public as soon as it has been published. Publishing stamps the
+  # board and gives it the secret key of its public URL, unpublishing clears both.
+  def published?
+    published_at.present? || public_key.present?
+  end
+
+  def publish
+    update! published_at: Time.current, public_key: public_key.presence || generate_public_key
+  end
+
+  def unpublish
+    update! published_at: nil, public_key: nil
+  end
+
+  # The secret token that identifies this board in its public URL.
+  def publication_key
+    public_key.presence || id
+  end
+
+  # The URL anyone can use to look at this board, or nil when the board isn't
+  # published. Views pass the current request's url options so the URL carries
+  # the host people are actually visiting.
+  def public_url(**url_options)
+    return unless published?
+
+    options = url_options.presence || { script_name: Current.account&.slug }
+    Rails.application.routes.url_helpers.public_board_url publication_key, **base_url_options, **options
+  end
+
+  # Cards of a published board, and their attachments, can be seen by anyone.
+  def publicly_accessible?
+    published?
+  end
+
+  private
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+    end
+
+    def generate_public_key
+      SecureRandom.base58 PUBLIC_KEY_LENGTH
+    end
+end
