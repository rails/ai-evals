diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..c879625
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  include Rails.application.routes.url_helpers
+
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_url
+    assert_not Board.published.include?(@board)
+  end
+
+  test "publish stamps the board and generates a secret public key" do
+    @board.publish
+
+    assert @board.reload.published?
+    assert @board.published_at.present?
+    assert_equal Board::Publication::PUBLIC_KEY_LENGTH, @board.public_key.length
+    assert Board.published.include?(@board)
+  end
+
+  test "publish keeps the same public key when publishing twice" do
+    @board.publish
+    public_key = @board.public_key
+
+    @board.publish
+
+    assert_equal public_key, @board.reload.public_key
+  end
+
+  test "unpublish revokes the public key and the public url" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.reload.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+    assert_not Board.published.include?(@board)
+  end
+
+  test "public url points to the public board page" do
+    @board.publish
+
+    with_default_host do
+      assert_equal "http://example.com#{Current.account.slug}/public/boards/#{@board.public_key}", @board.reload.public_url
+    end
+  end
+
+  test "cards of a published board are publicly accessible" do
+    assert_not @board.publicly_accessible?
+    assert_not cards(:logo).publicly_accessible?
+
+    @board.publish
+
+    assert @board.reload.publicly_accessible?
+    assert cards(:logo).reload.publicly_accessible?
+  end
+
+  test "new boards are published with a generated public key" do
+    board = Current.set(account: accounts("37s"), session: sessions(:kevin), user: users(:kevin)) do
+      Board.create! name: "Fresh board"
+    end
+
+    assert_not board.published?
+    board.publish
+
+    assert board.reload.public_key.present?
+  end
+
+  private
+    def with_default_host(host = "example.com")
+      original = Rails.application.routes.default_url_options.dup
+      Rails.application.routes.default_url_options[:host] = host
+      yield
+    ensure
+      Rails.application.routes.default_url_options = original
+    end
+end
