@@ -0,0 +1,23 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Published" }
+      format.json { render "boards/show", status: :ok }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Unpublished" }
+      format.json { render "boards/show", status: :ok }
+    end
+  end
+end
diff --git a/app/controllers/public/application_controller.rb b/app/controllers/public/application_controller.rb
new file mode 100644
index 0000000..5a862f4
--- /dev/null
+++ b/app/controllers/public/application_controller.rb
@@ -0,0 +1,21 @@
+class Public::ApplicationController < ApplicationController
+  # Anyone with the secret link can look at a published board, whether they are
+  # signed in or not, and whether the link carries an account slug or not.
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  before_action :set_board
+
+  private
+    def set_board
+      @board = Board.published.find_by(public_key: board_key) || Board.published.find_by!(id: board_key)
+      Current.account = @board.account
+    end
+
+    # Routes nested below the board name the key after their parent resource.
+    def board_key
+      params[:key] || params[:board_key]
+    end
+end
