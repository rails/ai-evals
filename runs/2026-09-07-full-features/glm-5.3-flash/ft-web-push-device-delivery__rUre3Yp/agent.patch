@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/send/abc", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create updates the keys when the browser resubscribes an endpoint" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/send/abc", p256dh_key: "old", auth_key: "old")
+
+    post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+
+    assert_response :created
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal "p256dh", @user.push_subscriptions.last.p256dh_key
+  end
+
+  test "an endpoint can only be subscribed once" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/send/abc", p256dh_key: "p", auth_key: "a")
+
+    post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+
+    assert_response :unprocessable_entity
+    assert_equal users(:kevin), subscription.reload.user
+    assert_empty @user.push_subscriptions
+  end
+
+  test "create without a payload" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), as: :json
+    end
+
+    assert_response :bad_request
+  end
+
+  test "destroy" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/send/abc", p256dh_key: "p256dh", auth_key: "auth")
+
+    delete user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: subscription.endpoint } }, as: :json
+
+    assert_response :no_content
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  test "can't manage another user's subscriptions" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def subscription_params
+      { push_subscription: { endpoint: "https://push.example.com/send/abc", p256dh_key: "p256dh", auth_key: "auth" } }
+    end
+end
diff --git a/test/jobs/notification/push_job_test.rb b/test/jobs/notification/push_job_test.rb
