+require "application_system_test_case"
+
+class PushNotificationsTest < ApplicationSystemTestCase
+  setup do
+    ENV["VAPID_PUBLIC_KEY"] = WebPush.generate_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = WebPush.generate_key.private_key
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "push notifications are off for a device that hasn't subscribed" do
+    sign_in_as(users(:david))
+
+    visit notifications_settings_url(script_name: accounts("37s").slug)
+
+    within ".notifications__status" do
+      assert_text "Off for this device."
+      assert_no_text "On for this device."
+    end
+  end
+
+  test "turning notifications on explains what to do when the browser blocks them" do
+    sign_in_as(users(:david))
+
+    visit notifications_settings_url(script_name: accounts("37s").slug)
+
+    within ".notifications__status" do
+      click_on "Turn on"
+    end
+
+    assert_text "Turn on notifications for this website."
+  end
+end
