+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    )
+    ENV["VAPID_PUBLIC_KEY"] = WebPush.generate_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = WebPush.generate_key.private_key
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "notifications are pushed when they land in the tray" do
+    assert_enqueued_with(job: Notification::PushJob) do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    end
+  end
+
+  test "notifications are not pushed again when they are read" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    perform_enqueued_jobs
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "a push is delivered for every subscription" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 201)
+
+    perform_enqueued_jobs do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:david))
+    end
+
+    assert_requested :post, @subscription.endpoint
+  end
+end
diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..2f52301
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  setup do
+    @vapid_public_key = WebPush.generate_key.public_key
+    @vapid_private_key = WebPush.generate_key.private_key
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_private_key
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    )
+  end
+
+  test "says what the tray says for an event" do
+    payload = payload_for(notifications(:logo_assignment_kevin))
+
+    assert_equal "The logo isn't big enough", payload["title"]
+    assert_equal "David: Assigned to Kevin", payload["body"]
+    assert_equal cards(:logo).id, payload["tag"]
+    assert payload["url"].ends_with?("cards/#{cards(:logo).number}")
+  end
+
+  test "says what the tray says for a comment" do
+    payload = payload_for(notifications(:layout_commented_kevin))
+
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal "David: The text is overflowing the container.", payload["body"]
+    assert payload["url"].include?("cards/#{cards(:layout).number}#comment_")
+  end
+
+  test "says what the tray says for a mention" do
+    payload = payload_for(notifications(:logo_mentioned_david))
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal "I agree.", payload["body"]
+  end
+
+  test "deliver sends a push for every subscription" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/def",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    )
+    stub_push(@user.push_subscriptions.first.endpoint)
+    stub_push(@user.push_subscriptions.last.endpoint)
+
+    Notification::Push.new(notifications(:logo_assignment_kevin)).deliver
+
+    assert_requested :post, @user.push_subscriptions.first.endpoint
+    assert_requested :post, @user.push_subscriptions.last.endpoint
+  end
+
+  test "deliver does nothing without the VAPID key pair" do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+
+    Notification::Push.new(notifications(:logo_mentioned_david)).deliver
+
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+
+  test "deliver keeps going when one endpoint can't be reached" do
+    broken = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/broken",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    )
+    stub_push(@subscription.endpoint)
+    stub_request(:post, broken.endpoint).to_raise(Net::OpenTimeout)
+
+    assert_raises(Net::OpenTimeout) do
+      Notification::Push.new(notifications(:logo_assignment_kevin)).deliver
+    end
+
+    assert_requested :post, @subscription.endpoint
+  end
+
+  test "deliver skips notifications whose source is gone" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.update_columns(source_id: "0000000000000000000000000")
+
+    Notification::Push.new(notification).deliver
+
+    assert_not_requested :post, @subscription.endpoint
+  end
+
+  private
+    def stub_push(endpoint)
+      stub_request(:post, endpoint).to_return(status: 201)
+    end
+
+    def payload_for(notification)
+      JSON.parse(Notification::Push.new(notification).payload)
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..935abb0
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    )
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "requires an endpoint and keys" do
+    subscription = PushSubscription.new(user: @user)
+
+    assert_not subscription.valid?
+    assert_equal [ "can't be blank", "can't be blank", "can't be blank" ], subscription.errors.messages.values.flatten
+  end
+
+  test "an endpoint can only be registered once" do
+    subscription = PushSubscription.new(user: users(:kevin), endpoint: @subscription.endpoint)
+
+    assert_not subscription.valid?
+    assert subscription.errors.of_kind?(:endpoint, :taken)
+  end
+
+  test "belongs to the user's account" do
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "deliver sends the payload to the endpoint" do
+    stub_request(:post, @subscription.endpoint)
+      .to_return(status: 201)
+
+    @subscription.deliver(Notification::Push.new(@notification))
+
+    assert_requested :post, @subscription.endpoint, headers: { "Urgency" => "high" }
+  end
+
+  test "deliver forgets an endpoint the push service no longer knows" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 410)
+
+    @subscription.deliver(Notification::Push.new(@notification))
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "deliver forgets an endpoint that has gone missing" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 404)
+
+    @subscription.deliver(Notification::Push.new(@notification))
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "deliver leaves the subscription in place when the push service fails" do
+    stub_request(:post, @subscription.endpoint).to_return(status: 500)
+
+    assert_raises(WebPush::PushServiceError) do
+      @subscription.deliver(Notification::Push.new(@notification))
+    end
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+end
diff --git a/test/models/user/pushable_test.rb b/test/models/user/pushable_test.rb
new file mode 100644
index 0000000..f5b40e9
--- /dev/null
+++ b/test/models/user/pushable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class User::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @params = {
+      endpoint: "https://push.example.com/send/abc",
+      p256dh_key: WebPush.generate_key.public_key,
+      auth_key: WebPush.encode64(Random.bytes(16))
+    }
+  end
+
+  test "subscribe_to_push registers the device" do
+    subscription = @user.subscribe_to_push(@params)
+
+    assert subscription.persisted?
+    assert_equal @params[:endpoint], subscription.endpoint
+    assert_equal @params[:p256dh_key], subscription.p256dh_key
+    assert_equal @params[:auth_key], subscription.auth_key
+  end
+
+  test "subscribe_to_push updates the keys when the browser resubscribes" do
+    @user.subscribe_to_push(@params)
+    new_key = WebPush.generate_key.public_key
+    subscription = @user.subscribe_to_push(@params.merge(p256dh_key: new_key))
+
+    assert_equal 1, @user.push_subscriptions.count
+    assert_equal new_key, @user.push_subscriptions.last.p256dh_key
+    assert_equal subscription.endpoint, @user.push_subscriptions.last.endpoint
+  end
+
+  test "unsubscribe_from_push forgets the device" do
+    @user.subscribe_to_push(@params)
+
+    @user.unsubscribe_from_push(@params[:endpoint])
+
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "unsubscribe_from_push ignores unknown devices" do
+    @user.subscribe_to_push(@params)
+
+    @user.unsubscribe_from_push("https://push.example.com/send/unknown")
+
+    assert_not_empty @user.push_subscriptions.reload
+  end
+
+  test "deactivating a user forgets their devices" do
+    @user.subscribe_to_push(@params)
+
+    @user.deactivate
+
+    assert_empty PushSubscription.where(user: @user)
+  end
+end
