diff --git a/app/models/user/pushable.rb b/app/models/user/pushable.rb
new file mode 100644
index 0000000..98e53ab
--- /dev/null
+++ b/app/models/user/pushable.rb
@@ -0,0 +1,17 @@
+module User::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :push_subscriptions, dependent: :destroy
+  end
+
+  def subscribe_to_push(subscription)
+    push_subscriptions.find_or_initialize_by(endpoint: subscription[:endpoint]).tap do |record|
+      record.update(p256dh_key: subscription[:p256dh_key], auth_key: subscription[:auth_key])
+    end
+  end
+
+  def unsubscribe_from_push(endpoint)
+    push_subscriptions.find_by(endpoint: endpoint)&.destroy
+  end
+end
