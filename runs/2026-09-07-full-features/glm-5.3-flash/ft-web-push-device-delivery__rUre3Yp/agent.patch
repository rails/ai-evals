diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..1704b6f 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,48 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Push notifications
+// ---------------------------------------------------------------------------
+
+self.addEventListener("push", (event) => {
+  event.waitUntil(showPush(event.data))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  event.waitUntil(openPush(event.notification.data?.url))
+})
+
+async function showPush(push) {
+  const data = push?.json()
+
+  if (!data) return
+
+  await self.registration.showNotification(data.title ?? "Fizzy", {
+    body: data.body,
+    icon: absoluteUrl(data.icon),
+    tag: data.tag,
+    renotify: data.renotify,
+    data: { url: data.url }
+  })
+}
+
+// A push opens the card it is about, in a Fizzy window that's already open if there is one.
+async function openPush(url) {
+  const target = absoluteUrl(url ?? "/")
+
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const client = windows.find((client) => client.url === target)
+
+  if (client) {
+    await client.focus()
+  } else {
+    await self.clients.openWindow(target)
+  }
+}
+
+function absoluteUrl(url) {
+  return new URL(url ?? "/", self.location.origin).href
+}
