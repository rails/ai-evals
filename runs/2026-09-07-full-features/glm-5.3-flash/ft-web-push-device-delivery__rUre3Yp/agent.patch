diff --git a/app/models/notification/push.rb b/app/models/notification/push.rb
new file mode 100644
index 0000000..ce57319
--- /dev/null
+++ b/app/models/notification/push.rb
@@ -0,0 +1,66 @@
+class Notification::Push
+  include ActionView::Helpers::TextHelper, NotificationsHelper, Rails.application.routes.url_helpers
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def deliver
+    return unless Fizzy.push_enabled?
+    return if notification.source.nil? || notification.card.nil?
+
+    failures = []
+
+    notification.user.push_subscriptions.each do |subscription|
+      subscription.deliver(self)
+    rescue WebPush::Error, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError => failure
+      failures << failure
+    end
+
+    # One unreachable device shouldn't keep the others from hearing about it.
+    # Raising here lets the job retry, which re-delivers to the ones that did.
+    raise failures.first unless failures.empty?
+  end
+
+  def payload
+    JSON.generate(
+      title: title,
+      body: body,
+      tag: notification.card_id,
+      renotify: true,
+      url: url,
+      icon: "/app-icon-192.png"
+    )
+  end
+
+  private
+    attr_reader :notification
+
+    def source
+      notification.source
+    end
+
+    # Says what the tray says.
+    def title
+      case source
+      when Event then event_notification_title(source)
+      when Mention then "#{source.mentioner.first_name} @mentioned you"
+      end
+    end
+
+    def body
+      case source
+      when Event then "#{notification.creator.name}: #{event_notification_body(source)}"
+      when Mention then source.source.mentionable_content.truncate(200)
+      end
+    end
+
+    def url
+      polymorphic_url(source.notifiable_target, base_url_options.merge(script_name: notification.account.slug))
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..66b2830
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,34 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  def deliver(push)
+    WebPush.payload_send \
+      endpoint: endpoint,
+      message: push.payload,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_options,
+      urgency: :high
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The browser that owns this subscription no longer knows about it, so there
+    # is nothing left to deliver to.
+    destroy
+  end
+
+  private
+    def vapid_options
+      {
+        subject: "mailto:#{mailer_from_address}",
+        public_key: Fizzy.vapid_public_key,
+        private_key: Fizzy.vapid_private_key
+      }
+    end
+
+    def mailer_from_address
+      ApplicationMailer.default[:from].match(URI::MailTo::EMAIL_REGEXP).to_s.presence || "support@fizzy.do"
+    end
+end
