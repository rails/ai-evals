--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,28 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    subscription = @user.subscribe_to_push(push_subscription_params)
+
+    if subscription.persisted?
+      head :created
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @user.unsubscribe_from_push(push_subscription_params[:endpoint])
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.user if Current.user&.id.to_s == params[:user_id]
+      head :not_found unless @user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..010cf76
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,155 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const SERVICE_WORKER_URL = "/service-worker.js"
+
+// Push notifications are enabled per device, so this controller lives in the
+// notification settings: it subscribes the browser to the push service and
+// keeps the server informed about the subscription it got back.
+export default class extends Controller {
+  static targets = [ "details", "explainer" ]
+  static values = { subscribeUrl: String, vapidPublicKey: String }
+
+  #registrationPromise = null
+
+  connect() {
+    this.detailsTargets.forEach((details) => { details.hidden = true })
+    this.#refresh()
+  }
+
+  // Actions
+
+  async subscribe() {
+    if (!this.#supported) return this.#unavailable()
+
+    try {
+      if ((await Notification.requestPermission()) !== "granted") return this.#blocked()
+
+      const subscription = await (await this.#registration).pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      if ((await this.#save(subscription)).ok) {
+        this.#on()
+      } else {
+        await subscription.unsubscribe()
+        this.#unavailable()
+      }
+    } catch {
+      this.#unavailable()
+    }
+  }
+
+  async unsubscribe() {
+    const subscription = await this.#subscription
+
+    if (subscription) {
+      await this.#forget(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.#off()
+  }
+
+  // Private
+
+  async #refresh() {
+    if (!this.#supported) return this.#unavailable()
+
+    try {
+      const subscription = await this.#subscription
+
+      if (subscription && Notification.permission === "granted") {
+        this.#on()
+      } else {
+        this.#off()
+        if (Notification.permission === "denied") this.#showDetails()
+      }
+    } catch {
+      this.#unavailable()
+    }
+  }
+
+  #on() {
+    this.element.classList.add("notifications--on")
+  }
+
+  #off() {
+    this.element.classList.remove("notifications--on")
+  }
+
+  #blocked() {
+    this.#off()
+    this.#showDetails()
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((details) => { details.hidden = false })
+  }
+
+  #unavailable() {
+    this.#off()
+
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = false
+    }
+  }
+
+  async #save(subscription) {
+    return post(this.subscribeUrlValue, {
+      body: { push_subscription: this.#subscriptionParams(subscription) },
+      responseKind: "json"
+    })
+  }
+
+  async #forget(subscription) {
+    return destroy(this.subscribeUrlValue, {
+      body: { push_subscription: { endpoint: subscription.endpoint } },
+      responseKind: "json"
+    })
+  }
+
+  get #subscription() {
+    return this.#registration.then((registration) => registration.pushManager.getSubscription())
+  }
+
+  get #registration() {
+    if (!this.#registrationPromise) {
+      this.#registrationPromise = navigator.serviceWorker.register(SERVICE_WORKER_URL, { scope: "/" })
+    }
+
+    return this.#registrationPromise
+  }
+
+  #subscriptionParams(subscription) {
+    return {
+      endpoint: subscription.endpoint,
+      p256dh_key: this.#base64url(subscription.getKey("p256dh")),
+      auth_key: this.#base64url(subscription.getKey("auth"))
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - (this.vapidPublicKeyValue.length % 4)) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+
+  #base64url(buffer) {
+    if (!buffer) return ""
+
+    const bytes = new Uint8Array(buffer)
+    const base64 = btoa(String.fromCharCode(...bytes))
+
+    return base64.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  get #supported() {
+    return this.vapidPublicKeyValue.length > 0 &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
