@@ -0,0 +1,13 @@
+class Notification::PushJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  # Push services throttle delivery and sometimes fall over briefly, so a
+  # temporary failure is worth retrying.
+  retry_on WebPush::Error, Net::OpenTimeout, Net::ReadTimeout, SocketError, SystemCallError, wait: :polynomially_longer
+
+  def perform(notification)
+    Notification::Push.new(notification).deliver
+  end
+end
