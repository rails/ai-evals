@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  PARTY_POPPER = "\u{1F389}"
+
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+test "new renders the emoji picker" do
+  get new_card_comment_reaction_path(@card, @comment)
+
+  assert_response :success
+  assert_select "ul.reaction__emoji-list li button", minimum: 1
+end
+
+test "new on a comment of a drafted card is forbidden" do
+  @comment.card.update! status: :drafted
+
+  get new_card_comment_reaction_path(@card, @comment)
+
+  assert_response :forbidden
+end
+
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal PARTY_POPPER, @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.creator
+  end
+
+  test "create as JSON" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :json
+
+    assert_response :created
+    assert_equal PARTY_POPPER, @response.parsed_body["content"]
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last), @response.headers["Location"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Nice" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "Nice", @response.parsed_body["content"]
+  end
+
+  test "create replaces the comment's reactions strip" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :turbo_stream
+
+    assert_response :success
+    assert_turbo_stream action: "replace", target: dom_id(@comment, :reactions) do
+      assert_select ".reaction", text: /#{PARTY_POPPER}/
+    end
+  end
+
+  test "create on a comment of a drafted card is forbidden" do
+    @comment.card.update! status: :drafted
+
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :turbo_stream
+
+    assert_response :forbidden
+  end
+
+  test "create with more than 16 characters is unprocessable" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+  end
+
+  test "create twice with the same content is unprocessable" do
+    @comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :turbo_stream
+    end
+  end
+
+  test "create requires a signed in user" do
+    sign_out
+
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: PARTY_POPPER } }, as: :turbo_stream
+    end
+
+    assert_response :redirect
+  end
+
+  test "destroy" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: "remove", target: reaction
+  end
+
+  test "destroy as JSON" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+  end
+
+  test "destroying someone else's reaction is forbidden" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER, creator: users(:david))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+end
