+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    visit card_url(@card)
+
+    within reactions_strip do
+      assert_no_selector ".reaction"
+
+      click_on "Add a reaction"
+      fill_in "Add a reaction", with: "Nice work"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Nice work"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form:not([hidden])"
+    end
+
+    assert_equal "Nice work", @comment.reactions.last.content
+  end
+
+  test "canceling an ongoing reaction leaves the strip alone" do
+    visit card_url(@card)
+
+    within reactions_strip do
+      click_on "Add a reaction"
+      fill_in "Add a reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_nothing_raised { assert_equal 0, @comment.reactions.count }
+  end
+
+  test "picking an emoji from the menu adds it as a reaction" do
+    visit card_url(@card)
+
+    within reactions_strip do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      find(".reaction__emoji-list .btn[title='Thumbs up']").click
+    end
+
+    assert_selector ".reaction", text: "\u{1F44D}"
+  end
+
+  test "clicking your own reaction reveals how to remove it" do
+    @comment.reactions.create!(content: "Nice work", creator: users(:kevin))
+    visit card_url(@card)
+
+    within reactions_strip do
+      assert_no_selector ".reaction__delete"
+
+      find(".reaction", text: "Nice work").click
+      assert_selector ".reaction__delete"
+
+      click_on "Remove your reaction"
+    end
+
+    assert_no_selector ".reaction", text: "Nice work"
+  end
+
+  test "reactions left by other people land without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    @comment.reactions.create!(content: "\u{1F389}", creator: users(:david))
+    perform_enqueued_jobs
+
+    within reactions_strip do
+      assert_selector ".reaction", text: "\u{1F389}"
+      find(".reaction", text: "\u{1F389}").click
+      # Other people's reactions never reveal a way to remove them
+      assert_no_selector ".reaction__delete"
+      assert_no_selector ".reaction.expanded"
+    end
+  end
+
+  private
+    def reactions_strip
+      "##{dom_id(@comment, :reactions)}"
+    end
+
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
