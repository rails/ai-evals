@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (!this.#isMine) return
+
+    this.element.classList.add("reaction--deleteable")
+    this.element.tabIndex = 0
+  }
+
+  toggle(event) {
+    if (!this.#isMine || event.target.closest("button, a, input, form")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  deleting() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #isMine() {
+    return this.element.dataset.creatorId === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..10634b3
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "reaction", "trigger" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.#close()
+  }
+
+  pick({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.formTarget.requestSubmit()
+  }
+
+  collapse({ target }) {
+    if (this.element.contains(target)) return
+
+    this.reactionTargets.forEach(reaction => reaction.classList.remove("expanded"))
+  }
+
+  #close() {
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.inputTarget.value = ""
+  }
+}
