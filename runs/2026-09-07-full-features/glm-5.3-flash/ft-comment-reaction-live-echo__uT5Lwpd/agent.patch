@@ -0,0 +1,22 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload creator: :account }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_LENGTH }
+  validates :content, uniqueness: { scope: [ :comment_id, :creator_id ] }
+
+  after_create_commit -> { comment.broadcast_reactions }
+  after_destroy_commit -> { comment.broadcast_reaction_removed(self) }
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+end
