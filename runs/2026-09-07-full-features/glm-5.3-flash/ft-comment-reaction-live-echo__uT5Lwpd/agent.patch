+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  include ActionView::RecordIdentifier
+
+  PARTY_POPPER = "\u{1F389}"
+
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "defaults account and creator" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER)
+
+    assert_equal @comment.account, reaction.account
+    assert_equal users(:kevin), reaction.creator
+  end
+
+  test "requires content" do
+    reaction = @comment.reactions.new(content: "  ")
+
+    assert_not reaction.valid?
+    assert_equal [ "can't be blank" ], reaction.errors[:content]
+  end
+
+  test "content is limited to 16 characters" do
+    reaction = @comment.reactions.new(content: "a" * (Reaction::MAXIMUM_LENGTH + 1))
+
+    assert_not reaction.valid?
+    assert reaction.errors.of_kind?(:content, :too_long)
+
+    reaction.content = "a" * Reaction::MAXIMUM_LENGTH
+
+    assert reaction.valid?
+  end
+
+  test "content is stripped" do
+    reaction = @comment.reactions.create!(content: "  \u{1F389}  ")
+
+    assert_equal PARTY_POPPER, reaction.content
+  end
+
+  test "the same person can't leave the same reaction twice" do
+    @comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+
+    assert_not @comment.reactions.new(content: PARTY_POPPER, creator: users(:kevin)).valid?
+  end
+
+  test "different people can leave the same reaction" do
+    @comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count } do
+      @comment.reactions.create!(content: PARTY_POPPER, creator: users(:david))
+    end
+  end
+
+  test "reactions are ordered chronologically" do
+    @comment.reactions.create!(content: "first", creator: users(:david))
+    travel 1.minute do
+      @comment.reactions.create!(content: "second", creator: users(:kevin))
+    end
+
+    assert_equal %w[ first second ], @comment.reactions.map(&:content)
+  end
+
+  test "creating a reaction touches the comment" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_changes -> { comment.reload.updated_at } do
+      comment.reactions.create!(content: PARTY_POPPER, creator: users(:kevin))
+    end
+  end
+
+  test "destroying a reaction touches the comment" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER)
+
+    assert_changes -> { @comment.reload.updated_at } do
+      reaction.destroy
+    end
+  end
+
+  test "broadcasting replaces the comment's reactions list on the card stream" do
+    @comment.reactions.create!(content: PARTY_POPPER, creator: users(:david))
+
+    turbo_stream = capture_turbo_stream_broadcasts(@comment.card).last
+
+    assert_equal "replace", turbo_stream["action"]
+    assert_equal dom_id(@comment, :reactions_list), turbo_stream["target"]
+    assert_equal PARTY_POPPER, turbo_stream.at(".reaction span.txt-medium").text
+  end
+
+  test "broadcasting removes the reaction from the card stream" do
+    reaction = @comment.reactions.create!(content: PARTY_POPPER, creator: users(:david))
+    reaction.destroy
+
+    turbo_stream = capture_turbo_stream_broadcasts(@comment.card).last
+
+    assert_equal "remove", turbo_stream["action"]
+    assert_equal dom_id(reaction), turbo_stream["target"]
+  end
+
+  test "destroying a comment removes its reactions" do
+    @comment.reactions.create!(content: PARTY_POPPER)
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy
+    end
+  end
+end
