diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..d16a135 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,6 +1,12 @@
 module Card::Entropic
   extend ActiveSupport::Concern
 
+  AUTO_POSTPONE_BATCH_SIZE = 1000
+
+  # Everything a due card needs to be postponed. Loading it for a whole batch at
+  # once keeps the sweep from querying the same few tables once per card.
+  BATCH_PRELOADS = [ :account, { board: :account }, :closure, :activity_spike, :not_now ].freeze
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -24,9 +30,15 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    def auto_postpone_all_due(batch_size: AUTO_POSTPONE_BATCH_SIZE)
+      # Postponing a card is not an activity worth bumping timestamps for, and
+      # skipping the touches also skips the refreshes they broadcast.
+      ActiveRecord::Base.no_touching do
+        due_to_be_postponed.in_batches(of: batch_size) do |batch|
+          batch.preload(*BATCH_PRELOADS).each do |card|
+            card.auto_postpone(user: card.account.system_user)
+          end
+        end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..cc092b4 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,36 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due sweeps in batches" do
+    cards(:logo, :layout, :radio).each { |card| card.update!(last_active_at: 1.year.ago) }
+
+    assert_difference -> { Card.postponed.count }, +3 do
+      Card.auto_postpone_all_due(batch_size: 2)
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:layout).reload.postponed?
+    assert cards(:radio).reload.postponed?
+  end
+
+  test "auto postpone all due does not touch boards" do
+    cards(:logo).update!(last_active_at: 1.year.ago)
+    boards(:writebook).update!(updated_at: 1.hour.ago)
+
+    assert_no_changes -> { boards(:writebook).reload.updated_at } do
+      assert_no_queries_match(/UPDATE [`"]boards[`"]/) do
+        Card.auto_postpone_all_due
+      end
+    end
+  end
+
+  test "auto postpone all due loads the context of each batch once" do
+    cards(:logo, :layout, :radio).each { |card| card.update!(last_active_at: 1.year.ago) }
+
+    # Whatever the number of cards in the batch, its boards are loaded once.
+    assert_queries_match(/FROM [`"]boards[`"]/, count: 1) do
+      Card.auto_postpone_all_due
+    end
+  end
 end
