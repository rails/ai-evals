+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new" do
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      get new_session_email_code_path
+
+      assert_response :success
+      assert_in_body @identity.email_address
+    end
+  end
+
+  test "new without a pending code" do
+    untenanted do
+      get new_session_email_code_path
+
+      assert_response :success
+      assert_in_body "Enter your email address again"
+    end
+  end
+
+  test "new shows the code on the page in development" do
+    Rails.env.stubs(:development?).returns(true)
+
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      get new_session_email_code_path
+
+      assert_in_body "Psst, here's your code:"
+      assert_in_body last_email_code.code
+    end
+  end
+
+  test "create signs in and lands in the account" do
+    request_email_code_for @identity.email_address
+
+    assert_not cookies[:session_token].present?
+
+    untenanted do
+      post session_email_code_path, params: { code: last_email_code.code }
+
+      assert_redirected_to landing_url
+    end
+
+    assert_signed_in_as @identity
+  end
+
+  test "create signs in and continues where the person was heading" do
+    board = boards(:writebook)
+
+    # Visiting a tenanted URL while signed out remembers where to go back to
+    get board_url(board)
+    assert_redirected_to %r{/session/new\z}
+
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      post session_email_code_path, params: { code: last_email_code.code }
+    end
+
+    assert_redirected_to board_url(board)
+
+    assert_signed_in_as @identity
+  end
+
+  test "create for an email address without an identity" do
+    assert_difference -> { Identity.count }, 1 do
+      request_email_code_for "somebody.new@example.com"
+
+      untenanted do
+        post session_email_code_path, params: { code: last_email_code.code }
+
+        assert_redirected_to landing_url
+      end
+    end
+
+    assert_signed_in_as Identity.find_by!(email_address: "somebody.new@example.com")
+  end
+
+  test "create with a wrong code" do
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "XXXXXX" }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+  end
+
+  test "create with an expired code" do
+    request_email_code_for @identity.email_address
+
+    travel(EmailCode::LIFETIME + 1.second) do
+      untenanted do
+        post session_email_code_path, params: { code: last_email_code.code }
+
+        assert_redirected_to new_session_email_code_path
+        assert_equal "That code didn't work. Try again.", flash[:alert]
+      end
+    end
+  end
+
+  test "create with an already used code" do
+    request_email_code_for @identity.email_address
+    code = last_email_code.code
+
+    untenanted do
+      post session_email_code_path, params: { code: code }
+      assert_signed_in_as @identity
+
+      delete session_path
+      post session_email_code_path, params: { code: code }
+
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create is case insensitive" do
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      post session_email_code_path, params: { code: last_email_code.code.downcase }
+
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "create via JSON" do
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      post session_email_code_path, params: { code: last_email_code.code }, as: :json
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "create via JSON with a wrong code" do
+    request_email_code_for @identity.email_address
+
+    untenanted do
+      post session_email_code_path, params: { code: "XXXXXX" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  private
+    def request_email_code_for(email_address)
+      untenanted do
+        post session_path, params: { email_address: email_address }
+
+        assert_redirected_to new_session_email_code_path
+      end
+    end
+
+    def last_email_code
+      EmailCode.order(:created_at).last
+    end
+
+    def assert_signed_in_as(identity)
+      session = Session.find_signed(parsed_cookies.signed[:session_token])
+
+      assert_equal identity, session.identity
+    end
+end
