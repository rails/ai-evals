+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <% if @email_code %>
+    <p>We sent a six-character code to <strong><%= @email_code.email_address %></strong>. Enter it to get into Fizzy.</p>
+
+    <%= form_with url: session_email_code_path, class: "flex flex-column gap txt-medium" do |form| %>
+      <div class="flex align-center gap">
+        <label class="flex align-center gap input input--actor">
+          <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", maxlength: EmailCode::CODE_LENGTH, placeholder: "Enter your code…" %>
+        </label>
+      </div>
+
+      <% if Rails.env.development? %>
+        <p class="txt-subtle txt-small">Psst, here's your code: <strong><%= @email_code.code %></strong></p>
+      <% end %>
+
+      <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+        <span>Let’s go</span>
+        <%= icon_tag "arrow-right" %>
+      </button>
+    <% end %>
+
+    <p class="txt-subtle txt-small margin-block-none"><%= link_to "Use a different email address", new_session_path, class: "txt-link" %></p>
+  <% else %>
+    <p>Your code request expired. Enter your email address again and we’ll send you a new code.</p>
+
+    <%= link_to "Back to sign in", new_session_path, class: "btn btn--link center txt-medium" %>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
