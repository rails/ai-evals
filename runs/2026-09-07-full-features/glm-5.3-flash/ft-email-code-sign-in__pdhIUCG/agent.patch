@@ -0,0 +1,33 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  setup do
+    @email_code = EmailCode.new(email_address: "david@37signals.com", code: "ABC234", expires_at: EmailCode::LIFETIME.from_now)
+  end
+
+  test "email code" do
+    email = IdentityMailer.email_code(@email_code)
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_equal "Your Fizzy code is ABC234", email.subject
+  end
+
+  test "email code includes the code in the body" do
+    email = IdentityMailer.email_code(@email_code)
+
+    assert_match "ABC234", email.body.encoded
+  end
+
+  test "email code has both HTML and text parts" do
+    email = IdentityMailer.email_code(@email_code)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+
+  test "email code mentions how long the code works" do
+    email = IdentityMailer.email_code(@email_code)
+
+    assert_match /15 minutes/, email.body.encoded
+  end
+end
