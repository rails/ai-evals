diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..c111aec
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issues a code for an email address and emails it" do
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+      @email_code = EmailCode.issue("david@37signals.com")
+    end
+
+    assert_equal "david@37signals.com", @email_code.email_address
+    assert_equal EmailCode::CODE_LENGTH, @email_code.code.length
+    assert_in_delta EmailCode::LIFETIME.from_now, @email_code.expires_at, 1
+    assert @email_code.active?
+  end
+
+  test "doesn't issue a code for an invalid email address" do
+    assert_no_enqueued_jobs do
+      assert_nil EmailCode.issue("not-a-valid-email")
+    end
+  end
+
+  test "normalizes the email address" do
+    assert_equal "david@37signals.com", EmailCode.issue(" David@37signals.com ").email_address
+  end
+
+  test "codes are unique among the active ones" do
+    codes = 25.times.map { EmailCode.issue("david@37signals.com").code }
+
+    assert_equal codes.uniq.length, codes.length
+  end
+
+  test "matches the code it was issued with" do
+    email_code = EmailCode.issue("david@37signals.com")
+
+    assert email_code.matches?(email_code.code)
+    assert email_code.matches?(" #{email_code.code.downcase} ")
+    assert_not email_code.matches?("XXXXXX")
+  end
+
+  test "expires" do
+    email_code = EmailCode.issue("david@37signals.com")
+
+    travel 15.minutes do
+      assert email_code.active?, "A code should work for its lifetime"
+    end
+
+    travel(15.minutes + 1.second) do
+      assert_not email_code.active?
+      assert_not email_code.matches?(email_code.code)
+    end
+  end
+
+  test "verifies the code for a pending authentication token" do
+    email_code = EmailCode.issue("david@37signals.com")
+
+    assert_equal email_code, EmailCode.verify(
+      pending_authentication_token: email_code.pending_authentication_token,
+      code: email_code.code
+    )
+  end
+
+  test "doesn't verify with a wrong code" do
+    email_code = EmailCode.issue("david@37signals.com")
+
+    assert_nil EmailCode.verify(pending_authentication_token: email_code.pending_authentication_token, code: "XXXXXX")
+  end
+
+  test "doesn't verify with an unknown pending authentication token" do
+    assert_nil EmailCode.verify(pending_authentication_token: "nonsense", code: "XXXXXX")
+  end
+
+  test "doesn't verify an expired code" do
+    email_code = EmailCode.issue("david@37signals.com")
+
+    travel(15.minutes + 1.second) do
+      assert_nil EmailCode.verify(pending_authentication_token: email_code.pending_authentication_token, code: email_code.code)
+    end
+  end
+
+  test "consumed codes can't be verified anymore" do
+    email_code = EmailCode.issue("david@37signals.com")
+    email_code.consume
+
+    assert_nil EmailCode.find_by(id: email_code.id)
+    assert_nil EmailCode.verify(pending_authentication_token: email_code.pending_authentication_token, code: email_code.code)
+  end
+
+  test "cleanup removes expired codes" do
+    expired = EmailCode.create!(email_address: "david@37signals.com", code: "ABC234", expires_at: 1.minute.ago)
+    active = EmailCode.create!(email_address: "david@37signals.com", code: "ABC345", expires_at: 1.minute.from_now)
+
+    EmailCode.cleanup
+
+    assert_equal [ active.id ], EmailCode.order(:created_at).ids
+  end
+end
