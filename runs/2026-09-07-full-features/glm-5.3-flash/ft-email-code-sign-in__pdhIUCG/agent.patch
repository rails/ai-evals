diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..c5302d2
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,68 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  # Uppercase letters and digits, minus the ones that are easy to mistake for each other
+  CODE_ALPHABET = %w[ A B C D E F G H J K M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+  LIFETIME = 15.minutes
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  before_create :generate_code, if: -> { code.blank? }
+
+  class << self
+    # Creates a code for the given email address and emails it. Returns nil when the
+    # email address isn't valid, so nobody can use the sign-in flow to enumerate or
+    # stuff bogus addresses.
+    def issue(email_address)
+      email_code = new(email_address: email_address, expires_at: LIFETIME.from_now)
+      return unless email_code.valid?
+
+      email_code.save!
+      IdentityMailer.email_code(email_code).deliver_later
+      email_code
+    end
+
+    # Returns the code that the pending authentication token points to when the given
+    # code still matches it and hasn't expired. Returns nil otherwise.
+    def verify(pending_authentication_token:, code:)
+      email_code = find_by_pending_authentication_token(pending_authentication_token)
+      email_code if email_code&.matches?(code)
+    end
+
+    def find_by_pending_authentication_token(token)
+      find_signed(token, purpose: :pending_authentication)
+    end
+
+    def cleanup
+      expired.destroy_all
+    end
+  end
+
+  def active?
+    expires_at > Time.current
+  end
+
+  def matches?(code)
+    active? && self.code == code.to_s.strip.upcase
+  end
+
+  def pending_authentication_token
+    signed_id(purpose: :pending_authentication)
+  end
+
+  def consume
+    destroy!
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample }.join
+        break candidate unless self.class.active.exists?(code: candidate)
+      end
+    end
+end
