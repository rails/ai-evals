diff --git a/app/models/concerns/storage_usage.rb b/app/models/concerns/storage_usage.rb
new file mode 100644
index 0000000..d8a1933
--- /dev/null
+++ b/app/models/concerns/storage_usage.rb
@@ -0,0 +1,34 @@
+# Storage usage is the total size of the attachments we count for a record: card
+# images plus the files embedded in board descriptions, card descriptions, and
+# comments.
+#
+# Calculating it is delegated to the database, which sums everything up in a
+# single query, so it costs the same for an account or board with a handful of
+# attachments as it does for one with thousands of them. That way the values are
+# always up to date without having to keep a running total in a background job.
+module StorageUsage
+  extend ActiveSupport::Concern
+
+  # The rich text attributes whose embedded files count towards storage usage.
+  COUNTED_RICH_TEXT_NAMES = %w[ public_description description body ]
+
+  def bytes_used
+    counted_attachments.joins(:blob).sum(:byte_size)
+  end
+
+  # Models must implement these methods:
+  # - counted_cards: the cards whose images and description embeds are counted
+  # - counted_rich_texts: the rich texts whose embedded files are counted
+  private
+    def counted_attachments
+      card_images.or(embedded_files)
+    end
+
+    def card_images
+      ActiveStorage::Attachment.where(record_type: "Card", name: "image", record_id: counted_cards.select(:id))
+    end
+
+    def embedded_files
+      ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds", record_id: counted_rich_texts.select(:id))
+    end
+end
diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..636d163
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+    @board = boards(:writebook)
+  end
+
+  test "an account or board without attachments has used no storage" do
+    assert_equal 0, accounts(:acme).bytes_used
+    assert_equal 0, boards(:miltons_wish_list).bytes_used
+  end
+
+  test "counts card images" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+
+    assert_equal card.image.blob.byte_size, @account.bytes_used
+    assert_equal card.image.blob.byte_size, @board.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    card = cards(:logo)
+    attach_to_rich_text(card.description, file_fixture("moon.jpg"))
+
+    assert_equal counted_bytes_of(card.description), @account.bytes_used
+    assert_equal counted_bytes_of(card.description), @board.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    comment = cards(:logo).comments.create!(body: "Have a look at this")
+    attach_to_rich_text(comment.body, file_fixture("moon.jpg"))
+
+    assert_equal counted_bytes_of(comment.body), @account.bytes_used
+    assert_equal counted_bytes_of(comment.body), @board.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    attach_to_rich_text(@board.public_description, file_fixture("moon.jpg"))
+
+    assert_equal counted_bytes_of(@board.public_description), @account.bytes_used
+    assert_equal counted_bytes_of(@board.public_description), @board.bytes_used
+  end
+
+  test "a board doesn't count the attachments of other boards" do
+    other_board = boards(:private)
+    attach_to_rich_text(other_board.public_description, file_fixture("moon.jpg"))
+    attach_to_card_description(cards(:text), file_fixture("avatar.png"))
+
+    assert_equal counted_bytes_of(other_board.public_description), other_board.reload.bytes_used
+    assert_equal counted_bytes_of(cards(:text).description), @board.reload.bytes_used
+  end
+
+  test "doesn't count the attachments of other accounts" do
+    attach_to_rich_text(cards(:logo).description, file_fixture("moon.jpg"))
+
+    assert_equal 0, accounts(:initech).bytes_used
+    assert_equal 0, boards(:miltons_wish_list).bytes_used
+    assert_equal 0, accounts(:acme).bytes_used
+  end
+
+  test "doesn't count other attachments, like user avatars" do
+    users(:david).avatar.attach(io: file_fixture("avatar.png").open, filename: "avatar.png")
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "stops counting attachments once they are removed" do
+    card = cards(:logo)
+    attach_to_rich_text(card.description, file_fixture("moon.jpg"))
+    card.description.embeds.purge
+
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "an account's usage is the sum of the usage of all of its boards" do
+    attach_to_card_description(cards(:logo), file_fixture("moon.jpg"))
+    attach_to_card_description(cards(:text), file_fixture("avatar.png"))
+    attach_to_rich_text(boards(:private).public_description, file_fixture("avatar.svg"))
+
+    assert_equal @account.boards.sum(&:bytes_used), @account.bytes_used
+  end
+
+  private
+    def attach_to_card_description(card, file)
+      attach_to_rich_text(card.description, file)
+    end
+
+    def attach_to_rich_text(rich_text, file)
+      blob = ActiveStorage::Blob.create_and_upload! io: file.open, filename: File.basename(file.to_s)
+      rich_text.body = ActionText::Content.new("Embedded: ").append_attachables(blob)
+      rich_text.record.save!
+    end
+
+    def counted_bytes_of(rich_text)
+      rich_text.embeds.sum(&:byte_size)
+    end
+end
