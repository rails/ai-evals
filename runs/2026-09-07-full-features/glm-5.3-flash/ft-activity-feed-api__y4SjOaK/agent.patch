@@ -0,0 +1,24 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  def index
+    set_page_and_extract_portion_from activities
+    fresh_when etag: [ @page.records, Current.user ]
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.activity.activity_preloaded
+      events = events.where(board_id: @filter.boards.ids) if board_ids.present?
+      events = events.where(creator_id: @filter.creators.ids) if creator_ids.present?
+      events.newest_first
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+end
