@@ -0,0 +1,64 @@
+# Activities
+
+Activities are the things that happened in the account, such as cards being added, moved,
+assigned, or commented on. They are the same events shown in the HTML timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activities, newest first. Only activity from boards the current
+user has access to is returned.
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids` | array | Optional. Only return activity created by these users |
+| `board_ids` | array | Optional. Only return activity from these boards |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to \"Design the new logo\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a9"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": { "...": "..." },
+    "board": { "...": "..." },
+    "creator": { "...": "..." }
+  }
+]
+```
+
+### Attributes
+
+| Attribute | Description |
+|-----------|-------------|
+| `id` | The id of the activity |
+| `action` | The kind of activity. One of `card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, or `comment_created` |
+| `created_at` | When the activity happened |
+| `description` | A human readable description of the activity |
+| `particulars` | Event specific details, see below |
+| `url` | The URL of the card the activity is about. For comments, the URL points to the card and jumps to the comment |
+| `eventable_type` | The type of the eventable, either `Card` or `Comment` |
+| `eventable` | The card, or the comment, the activity is about. See [cards](cards.md) and [comments](comments.md) |
+| `board` | The board the activity happened on. See [boards](boards.md) |
+| `creator` | The user that triggered the activity. See [users](users.md) |
+
+### Particulars
+
+The `particulars` object exposes the details of an activity. Activities without any details
+return an empty object.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids`: the ids of the users that were assigned to, or unassigned from, the card |
+| `card_board_changed` | `old_board` and `new_board`: the name of the board the card was moved from and to |
+| `card_title_changed` | `old_title` and `new_title`: the title of the card before and after it was renamed |
+| `card_triaged` | `column`: the name of the column the card was moved to |
+
+Missing board, title, or column values are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..7c23436
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_not_empty @response.parsed_body
+  end
+
+  test "index as JSON returns activities newest first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.collect { |activity| Time.zone.parse(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index as JSON includes activity attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_assignment_km).id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_not_nil activity["created_at"]
+    assert_not_nil activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal [ users(:kevin).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "index as JSON includes the plain text description of the event" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_assignment_km).id }
+
+    assert_equal events(:logo_assignment_km).description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "index as JSON opens the card the comment was posted on" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "index as JSON returns empty particulars for events without details" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:shipping_closed).id }
+
+    assert_equal "card_closed", activity["action"]
+    assert_empty activity["particulars"]
+  end
+
+  test "index as JSON returns particulars for assignment changes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_assignment_km).id }
+
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, activity["particulars"])
+  end
+
+  test "index as JSON returns particulars for title changes" do
+    with_current_user users(:david) do
+      cards(:logo).update! title: "The new logo"
+    end
+
+    get activities_path, as: :json
+
+    event = cards(:logo).events.where(action: "card_title_changed").last
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "The new logo" }, activity["particulars"])
+  end
+
+  test "index as JSON returns particulars for board changes" do
+    with_current_user users(:david) do
+      cards(:logo).move_to boards(:private)
+    end
+
+    get activities_path, as: :json
+
+    event = cards(:logo).events.where(action: "card_board_changed").last
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal({ "old_board" => boards(:writebook).name, "new_board" => boards(:private).name }, activity["particulars"])
+  end
+
+  test "index as JSON returns particulars for triage" do
+    with_current_user users(:david) do
+      cards(:logo).triage_into columns(:writebook_in_progress)
+    end
+
+    get activities_path, as: :json
+
+    event = cards(:logo).events.where(action: "card_triaged").last
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal({ "column" => columns(:writebook_in_progress).name }, activity["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing particulars" do
+    events(:logo_published).update_columns action: "card_board_changed", particulars: {}
+    events(:layout_published).update_columns action: "card_title_changed", particulars: {}
+    events(:shipping_published).update_columns action: "card_triaged", particulars: {}
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities[events(:logo_published).id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities[events(:layout_published).id]["particulars"])
+    assert_equal({ "column" => "" }, activities[events(:shipping_published).id]["particulars"])
+  end
+
+  test "index as JSON omits deprecated card collection changed events" do
+    events(:logo_published).update_columns action: "card_collection_changed"
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.collect { |activity| activity["action"] }, "card_collection_changed"
+  end
+
+  test "index as JSON only returns activity the current user can access" do
+    inaccessible_board = Board.create! name: "Hidden", creator: users(:jz), account: accounts("37s"), all_access: false
+    with_current_user users(:jz) do
+      inaccessible_board.cards.create! title: "Hidden card", creator: users(:jz), status: "published"
+    end
+
+    get activities_path, as: :json
+
+    assert_not inaccessible_board.accessible_to?(users(:kevin))
+    assert_not_includes @response.parsed_body.collect { |activity| activity.dig("board", "id") }, inaccessible_board.id
+  end
+
+  test "index as JSON filters by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    assert @response.parsed_body.any?
+    assert_equal [ users(:david).id ], @response.parsed_body.collect { |activity| activity.dig("creator", "id") }.uniq
+  end
+
+  test "index as JSON filters by board_ids" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert @response.parsed_body.any?
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.collect { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  test "index as JSON returns no activity for inaccessible board_ids" do
+    inaccessible_board = Board.create! name: "Hidden", creator: users(:jz), account: accounts("37s"), all_access: false
+
+    get activities_path, params: { board_ids: [ inaccessible_board.id ] }, as: :json
+
+    assert_empty @response.parsed_body
+  end
+
+  test "index as JSON is paginated" do
+    with_current_user users(:david) do
+      30.times { |index| cards(:logo).update! title: "Renamed #{index}" }
+    end
+
+    get activities_path, as: :json
+
+    assert_operator @response.parsed_body.size, :<, 30
+  end
+end
