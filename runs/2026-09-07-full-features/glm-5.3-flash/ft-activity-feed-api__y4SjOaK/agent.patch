diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..0874f18 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: tracked_particular("old_board"), new_board: tracked_particular("new_board") }
+    when "card_title_changed"
+      { old_title: tracked_particular("old_title"), new_title: tracked_particular("new_title") }
+    when "card_triaged"
+      { column: tracked_particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def tracked_particular(key)
+      tracked_particulars[key].to_s
+    end
+
+    def tracked_particulars
+      particulars.dig("particulars") || {}
+    end
 end
