diff --git a/test/system/drag_and_drop_detail_test.rb b/test/system/drag_and_drop_detail_test.rb
new file mode 100644
index 0000000..7ab48df
--- /dev/null
+++ b/test/system/drag_and_drop_detail_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class DragAndDropDetailTest < ApplicationSystemTestCase
+  test "the board keeps looking the way the drag left it" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    column = expand(columns(:writebook_triage))
+
+    assert_count columns(:writebook_triage), "2"
+    assert_count "maybe", "1"
+
+    drag_card cards(:buy_domain).title, to: column
+
+    assert_count columns(:writebook_triage), "3"
+    assert_count "maybe", "0"
+    assert_selector column_selector(columns(:writebook_triage)) + " article.card", text: cards(:buy_domain).title
+
+    # Whatever the board refresh makes of the saved card, it should stay put
+    sleep 1
+
+    assert_count columns(:writebook_triage), "3"
+    assert_count "maybe", "0"
+    assert_selector column_selector(columns(:writebook_triage)) + " article.card", text: cards(:buy_domain).title
+    assert_equal columns(:writebook_triage).id, cards(:buy_domain).reload.column_id
+  end
+
+  test "the dropped card takes the color of the column it was dropped on" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    column = expand(columns(:writebook_triage))
+
+    drag_card cards(:buy_domain).title, to: column
+
+    color = page.evaluate_script(<<~JS)
+      getComputedStyle(document.querySelector("#{column_selector(columns(:writebook_triage))} article.card")).getPropertyValue("--card-color")
+    JS
+
+    assert_equal "oklch(68% 0.176 113.11)", color.strip
+  end
+
+  private
+    def drag_card(title, to:)
+      find("article.card", text: title).drag_to(to)
+    end
+
+    def assert_count(column, count)
+      id = column.is_a?(String) ? column : dom_id(column)
+      assert_selector "##{id} .cards__expander-count", text: count, visible: :all
+    end
+
+    def expand(column)
+      element = column_element(column)
+      element.find(".cards__expander").click
+      element
+    end
+
+    def column_element(column)
+      find(column_selector(column))
+    end
+
+    def column_selector(column)
+      "##{dom_id(column)}"
+    end
+end
diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..9275e58
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,165 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  test "dragging a card from Maybe? into a column moves it right away" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    assert_no_selector column_selector(columns(:writebook_triage)) + " article.card", text: cards(:buy_domain).title
+
+    drag_card cards(:buy_domain).title, to: column_element(columns(:writebook_triage))
+
+    assert_selector column_selector(columns(:writebook_triage)) + " article.card", text: cards(:buy_domain).title
+    assert eventually { cards(:buy_domain).reload.triaged? }
+  end
+
+  test "dragging a card between columns" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_card cards(:layout).title, to: column_element(columns(:writebook_in_progress))
+
+    assert_no_selector column_selector(columns(:writebook_triage)) + " article.card", text: cards(:layout).title
+    assert_selector column_selector(columns(:writebook_in_progress)) + " article.card", text: cards(:layout).title, visible: :all
+    assert eventually { cards(:layout).reload.column_id == columns(:writebook_in_progress).id }
+  end
+
+  test "dragging a card onto Done closes it" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_card cards(:layout).title, to: find("#closed-cards")
+
+    assert_selector "#closed-cards article.card", text: cards(:layout).title, visible: :all
+    assert eventually { cards(:layout).reload.closed? }
+  end
+
+  test "dragging a card onto Not Now postpones it" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_card cards(:layout).title, to: find("#not-now")
+
+    assert_selector "#not-now article.card", text: cards(:layout).title, visible: :all
+    assert eventually { cards(:layout).reload.postponed? }
+  end
+
+  test "dragging a card onto Maybe? sends it back to triage" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_card cards(:layout).title, to: find("#maybe")
+
+    assert_selector "#maybe article.card", text: cards(:layout).title
+    assert eventually { cards(:layout).reload.awaiting_triage? }
+  end
+
+  test "dragging a card within its own column leaves it alone" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    last_active_at = cards(:layout).last_active_at
+
+    drag_card cards(:layout).title, to: column_element(columns(:writebook_triage)).find(".cards__header")
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_current_path board_url(boards(:writebook))
+    assert_equal last_active_at, cards(:layout).reload.last_active_at
+  end
+
+  test "the column under the pointer lights up while dragging" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_with_events cards(:layout).title, over: "#closed-cards" do
+      assert_selector "#closed-cards.drag-and-drop__hover-container"
+      assert_no_selector column_selector(columns(:writebook_triage)) + ".drag-and-drop__hover-container"
+    end
+
+    assert eventually { cards(:layout).reload.closed? }
+  end
+
+  test "the dragged card dims while dragging" do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+
+    expand(columns(:writebook_triage))
+
+    drag_with_events cards(:layout).title, over: "#closed-cards" do
+      assert_selector "article.card.drag-and-drop__dragged-item", text: cards(:layout).title
+    end
+  end
+
+  private
+    def drag_card(title, to:)
+      find("article.card", text: title).drag_to(to)
+    end
+
+    # Drags by dispatching drag events, so that we can assert on the board while
+    # the card is being dragged
+    def drag_with_events(title, over:, &block)
+      card = find("article.card", text: title)
+
+      page.execute_script(<<~JS, card[:id], over)
+        const [ id, over ] = arguments
+        const card = document.getElementById(id)
+        const target = document.querySelector(over)
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true }))
+        target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true }))
+      JS
+
+      block.call
+
+      page.execute_script(<<~JS, card[:id])
+        const [ id ] = arguments
+        const card = document.getElementById(id)
+        const target = document.querySelector("#closed-cards")
+
+        target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true }))
+      JS
+    end
+
+    # The card is moved on the board before the change is saved
+    def eventually(seconds = 2)
+      deadline = Time.current + seconds
+
+      loop do
+        result = yield
+        return result if result
+
+        raise "Timed out after #{seconds} seconds" if Time.current > deadline
+
+        sleep 0.05
+      end
+    end
+
+    def expand(column)
+      element = column_element(column)
+      element.find(".cards__expander").click
+      element
+    end
+
+    def column_element(column)
+      find(column_selector(column))
+    end
+
+    def column_selector(column)
+      "##{dom_id(column)}"
+    end
+end
