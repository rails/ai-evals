diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a20b9c8
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,277 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Drag a card onto another column to change the column it belongs to, or onto
+// the Maybe?, Not Now and Done columns to change its status. Columns keep their
+// own order: dragging moves a card between columns, never within one.
+//
+// The board is updated the moment the card is dropped, without waiting for the
+// change to be saved, so that it already looks the way you left it when you let
+// go.
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const CARD_SELECTOR = '[data-drag-and-drop-target~="card"]'
+const COLUMN_SELECTOR = '[data-drag-and-drop-target~="column"]'
+const CARD_LIST_SELECTOR = ".cards__list"
+const COLUMN_COUNT_SELECTOR = ".cards__expander-count"
+const GOLDEN_EFFECT_CLASS = "golden-effect"
+const POSTPONED_CLASS = "card--postponed"
+const COLUMN_DESTINATION = "column"
+const STREAM_DESTINATION = "stream"
+const NOT_NOW_DESTINATION = "not_now"
+const CLOSED_DESTINATION = "closed"
+const DRAG_THRESHOLD = 5
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+
+  connect() {
+    this.draggedCard = null
+    this.hoveredColumn = null
+    this.pointer = null
+  }
+
+  disconnect() {
+    this.#endDrag()
+  }
+
+  // Dragging with the pointer
+
+  pointerDown(event) {
+    if (!this.#isPointerDrag(event)) return
+
+    const card = this.#cardFrom(event)
+    if (!card) return
+
+    this.pointer = { card, x: event.clientX, y: event.clientY }
+    this.#listenForPointer()
+  }
+
+  // Dragging with the browser's drag and drop, which kicks in when the drag
+  // starts on one of the card's contents instead of on the card itself
+
+  dragStarted(event) {
+    const card = this.#cardFrom(event)
+    if (!card) return
+
+    event.preventDefault() // We drag the cards ourselves, the browser shouldn't drag them
+    this.pointer ??= { card, x: event.clientX, y: event.clientY }
+    this.#startDragging(card, event)
+  }
+
+  draggedOver(event) {
+    if (!this.isDragging) return
+
+    event.preventDefault()
+    this.#hoverColumn(this.#columnFrom(event))
+  }
+
+  dragLeft(event) {
+    if (!this.isDragging) return
+    if (this.element.contains(event.relatedTarget)) return
+
+    this.#hoverColumn(null)
+  }
+
+  dropped(event) {
+    if (!this.isDragging) return
+
+    event.preventDefault()
+    this.#drop(this.#columnFrom(event))
+  }
+
+  dragEnded() {
+    this.#endDrag()
+  }
+
+  // Private
+
+  #trackPointer = (event) => {
+    if (!this.pointer) return
+
+    if (this.isDragging) {
+      event.preventDefault()
+      this.#followPointer(event)
+      this.#hoverColumn(this.#columnFrom(event))
+    } else if (this.#isBeyondDragThreshold(event)) {
+      this.#startDragging(this.pointer.card, event)
+    }
+  }
+
+  #releasePointer = (event) => {
+    if (!this.pointer) return
+
+    const column = event.type === "pointercancel" ? null : this.#columnFrom(event)
+
+    this.#forgetPointer()
+    this.#drop(column)
+  }
+
+  #startDragging(card, event) {
+    if (this.draggedCard === card) return
+
+    this.#stopDragging()
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_ITEM_CLASS)
+    card.style.pointerEvents = "none"
+    document.body.style.userSelect = "none"
+    this.#followPointer(event)
+  }
+
+  #followPointer(event) {
+    if (!this.draggedCard || !this.pointer) return
+
+    this.draggedCard.style.translate = `${event.clientX - this.pointer.x}px ${event.clientY - this.pointer.y}px`
+  }
+
+  #drop(column) {
+    const card = this.draggedCard
+    this.#endDrag()
+
+    if (card) this.#move(card, column)
+  }
+
+  #endDrag() {
+    this.#stopDragging()
+    this.#forgetPointer()
+  }
+
+  #stopDragging() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(DRAGGED_ITEM_CLASS)
+      this.draggedCard.style.pointerEvents = ""
+      this.draggedCard.style.translate = ""
+      document.body.style.userSelect = ""
+    }
+
+    this.draggedCard = null
+    this.#hoverColumn(null)
+  }
+
+  #hoverColumn(column) {
+    const hovered = column && column !== this.#columnOf(this.draggedCard) ? column : null
+    if (this.hoveredColumn === hovered) return
+
+    this.hoveredColumn?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.hoveredColumn = hovered
+    this.hoveredColumn?.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #move(card, column) {
+    if (!column || column === this.#columnOf(card)) return
+
+    const list = column.querySelector(CARD_LIST_SELECTOR)
+    if (!list) return
+
+    const sourceColumn = this.#columnOf(card)
+
+    this.#insertCard(card, list)
+    this.#updateCount(sourceColumn, -1)
+    this.#updateCount(column, 1)
+    this.#reflectDestination(card, column)
+    this.#save(card, column)
+  }
+
+  #insertCard(card, list) {
+    const insertionPoint = this.#insertionPointFor(card, list)
+
+    if (insertionPoint) {
+      insertionPoint.parentNode.insertBefore(card, insertionPoint)
+    } else {
+      list.append(card)
+    }
+  }
+
+  #insertionPointFor(card, list) {
+    const siblings = [ ...list.querySelectorAll(CARD_SELECTOR) ]
+
+    return card.classList.contains(GOLDEN_EFFECT_CLASS)
+      ? siblings[0]
+      : siblings.find(sibling => !sibling.classList.contains(GOLDEN_EFFECT_CLASS))
+  }
+
+  #updateCount(column, delta) {
+    const counter = column?.querySelector(COLUMN_COUNT_SELECTOR)
+    if (!counter) return
+
+    counter.textContent = Math.max(0, Number(counter.textContent) + delta)
+  }
+
+  #reflectDestination(card, column) {
+    card.style.setProperty("--card-color", this.#colorOf(column))
+    card.classList.toggle(POSTPONED_CLASS, this.#destinationOf(column) === NOT_NOW_DESTINATION)
+  }
+
+  #save(card, column) {
+    const destination = this.#destinationOf(column)
+    const url = this.#urlFor(card, destination)
+    if (!url) return
+
+    if (destination === STREAM_DESTINATION) {
+      destroy(url, { responseKind: "json" })
+    } else if (destination === COLUMN_DESTINATION) {
+      post(url, { responseKind: "json", body: { column_id: this.#columnIdOf(column) } })
+    } else {
+      post(url, { responseKind: "json" })
+    }
+  }
+
+  #urlFor(card, destination) {
+    if (destination === NOT_NOW_DESTINATION) return card.dataset.cardNotNowUrl
+    if (destination === CLOSED_DESTINATION) return card.dataset.cardClosureUrl
+
+    return card.dataset.cardTriageUrl
+  }
+
+  #destinationOf(column) {
+    return column.dataset.dragAndDropDestinationValue
+  }
+
+  #columnIdOf(column) {
+    return column.dataset.dragAndDropColumnIdValue
+  }
+
+  #colorOf(column) {
+    return getComputedStyle(column).getPropertyValue("--card-color").trim()
+  }
+
+  #columnFrom(event) {
+    return this.#columnOf(event.target)
+  }
+
+  #columnOf(element) {
+    return element?.closest?.(COLUMN_SELECTOR) ?? null
+  }
+
+  #cardFrom(event) {
+    return event.target.closest?.(CARD_SELECTOR) ?? null
+  }
+
+  #isPointerDrag(event) {
+    return event.pointerType === "mouse" && event.button === 0
+  }
+
+  #isBeyondDragThreshold(event) {
+    return Math.abs(event.clientX - this.pointer.x) > DRAG_THRESHOLD ||
+      Math.abs(event.clientY - this.pointer.y) > DRAG_THRESHOLD
+  }
+
+  #listenForPointer() {
+    document.addEventListener("pointermove", this.#trackPointer)
+    document.addEventListener("pointerup", this.#releasePointer)
+    document.addEventListener("pointercancel", this.#releasePointer)
+  }
+
+  #forgetPointer() {
+    document.removeEventListener("pointermove", this.#trackPointer)
+    document.removeEventListener("pointerup", this.#releasePointer)
+    document.removeEventListener("pointercancel", this.#releasePointer)
+    this.pointer = null
+  }
+
+  get isDragging() {
+    return this.draggedCard != null
+  }
+}
