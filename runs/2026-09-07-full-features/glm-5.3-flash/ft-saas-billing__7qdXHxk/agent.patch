+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david
+  end
+
+  test "staff sees the accounts" do
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: @account.name
+  end
+
+  test "non-staff does not see the accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "an account page opens from its name" do
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "h1", text: @account.name
+  end
+
+  test "an account page has the plan, the comp buttons and the override form" do
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_select "strong", text: @account.plan.name
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comping an account waives its billing" do
+    assert_difference -> { Account::BillingWaiver.count } do
+      untenanted do
+        post saas.admin_account_billing_waiver_path(@account)
+      end
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert @account.reload.comped?
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "uncomping an account puts it back on the hook" do
+    @account.create_billing_waiver!
+
+    assert_difference -> { Account::BillingWaiver.count }, -1 do
+      untenanted do
+        delete saas.admin_account_billing_waiver_path(@account)
+      end
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_not @account.reload.comped?
+  end
+
+  test "overriding what an account counts for" do
+    @account.update_column :cards_count, 5_000
+
+    assert_difference -> { Account::OverriddenLimit.count } do
+      untenanted do
+        post saas.admin_account_overridden_limit_path(@account),
+          params: { overridden_limit: { card_count: 50, bytes_used: 100.megabytes } }
+      end
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_equal 50, @account.reload.card_count
+    assert_equal 100.megabytes, @account.bytes_used
+  end
+
+  test "overriding again replaces the override" do
+    @account.create_overridden_limit!(card_count: 50)
+
+    assert_no_difference -> { Account::OverriddenLimit.count } do
+      untenanted do
+        post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 500 } }
+      end
+    end
+
+    assert_equal 500, @account.reload.card_count
+  end
+
+  test "overriding with nothing counts the account for nothing" do
+    @account.create_overridden_limit!(card_count: 50)
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      untenanted do
+        post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: "" } }
+      end
+    end
+
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "resetting drops the override" do
+    @account.create_overridden_limit!(card_count: 50, bytes_used: 100.megabytes)
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      untenanted do
+        delete saas.admin_account_overridden_limit_path(@account)
+      end
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_nil @account.reload.overridden_limit
+    assert_equal @account.cards_count, @account.card_count
+  end
+end
