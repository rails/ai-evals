diff --git a/saas/test/controllers/account/settings_test.rb b/saas/test/controllers/account/settings_test.rb
new file mode 100644
index 0000000..4d609c9
--- /dev/null
+++ b/saas/test/controllers/account/settings_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::SettingsBillingTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and where to upgrade" do
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "strong", text: Plan.free.name
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "non-admins see their plan but can't upgrade" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "h2", text: "Plan"
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "admins on a paid plan manage their subscription instead" do
+    accounts(:"37s").create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123", status: "active")
