diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..3e317b4
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,112 @@
+# The Stripe subscription of an account. Accounts on the free plan have one
+# too, but without a Stripe subscription attached to it: it only comes to life
+# as soon as the account deals with Stripe, either to check out or to manage
+# its billing.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ trialing active ]
+  CANCELED_STATUS = "canceled"
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: Plan.all.map(&:key) }
+  validates :stripe_customer_id, presence: true
+
+  class << self
+    # Creates the subscription along with its Stripe customer if the account
+    # doesn't have one yet.
+    def start_for(account)
+      find_or_create_by!(account: account) do |subscription|
+        subscription.plan_key = Plan.free.key
+        subscription.stripe_customer_id = create_stripe_customer_for(account)
+      end
+    rescue ActiveRecord::RecordNotUnique
+      find_by!(account: account)
+    end
+
+    def find_by_stripe_customer_id(id)
+      find_by(stripe_customer_id: id)
+    end
+
+    def find_by_stripe_subscription_id(id)
+      find_by(stripe_subscription_id: id)
+    end
+
+    private
+      def create_stripe_customer_for(account)
+        Stripe::Customer.create(
+          name: account.name,
+          email: account.owner_email,
+          metadata: { account_id: account.id.to_s }
+        ).id
+      end
+  end
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceled?
+    status == CANCELED_STATUS
+  end
+
+  def checkout_url(plan:, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(
+      mode: "subscription",
+      customer: stripe_customer_id,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: success_url,
+      cancel_url: cancel_url,
+      metadata: { account_id: account.id.to_s }
+    ).url
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(
+      customer: stripe_customer_id,
+      return_url: return_url
+    ).url
+  end
+
+  # Tells Stripe to stop billing for the account.
+  def cancel_in_stripe!
+    return unless stripe_subscription_id && !canceled?
+
+    Stripe::Subscription.cancel(stripe_subscription_id)
+    update!(status: CANCELED_STATUS)
+  end
+
+  def sync_with_stripe!(stripe_subscription)
+    subscription = stripe_subscription.to_hash.deep_symbolize_keys
+
+    update!(
+      plan_key: plan_key_in(subscription) || plan_key,
+      stripe_subscription_id: subscription[:id],
+      status: subscription[:status],
+      current_period_end: timestamp_from_stripe(period_end_in(subscription)),
+      cancel_at: timestamp_from_stripe(subscription[:cancel_at])
+    )
+  end
+
+  private
+    # Stripe drives the plan through the price the subscription is for.
+    def plan_key_in(subscription)
+      Plan.find_by_stripe_price_id(subscription.dig(:items, :data, 0, :price, :id))&.key
+    end
+
+    # Stripe moved the period onto the subscription items, but older events
+    # still carry it on the subscription itself.
+    def period_end_in(subscription)
+      subscription.dig(:items, :data, 0, :current_period_end) || subscription[:current_period_end]
+    end
+
+    def timestamp_from_stripe(value)
+      case value
+      when nil, Time, DateTime, Date then value
+      else Time.at(value)
+      end
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..7d6c5d1
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,96 @@
+# The plans a hosted Fizzy account can be on. Plans are immutable: the price
+# and the allowances they include are defined here and nowhere else.
+class Plan
+  class Unknown < KeyError; end
+
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  # Declared before the plans below, which are built with it.
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+    @key = key
+    @name = name
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    price_in_cents: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    price_in_cents: 20_00,
+    card_limit: nil,
+    storage_limit: 5.gigabytes
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    price_in_cents: 25_00,
+    card_limit: nil,
+    storage_limit: 500.gigabytes
+  )
+
+  class << self
+    def all
+      [ FREE, UNLIMITED, UNLIMITED_PLUS ]
+    end
+
+    def free
+      FREE
+    end
+
+    def unlimited
+      UNLIMITED
+    end
+
+    def unlimited_plus
+      UNLIMITED_PLUS
+    end
+
+    def paid
+      all - [ FREE ]
+    end
+
+    def find(key)
+      all_by_key.fetch(key.to_s) { raise Unknown, "There is no #{key.inspect} plan" }
+    end
+
+    def find_by_stripe_price_id(price_id)
+      all.find { |plan| plan.stripe_price_id == price_id }
+    end
+
+    private
+      def all_by_key
+        all.index_by(&:key)
+      end
+  end
+
+  def free?
+    price_in_cents.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  # Stripe prices are provisioned per environment, hence the indirection.
+  def stripe_price_id
+    ENV["STRIPE_#{key.upcase}_PRICE_ID"].presence
+  end
+
+  def to_s
+    name
+  end
+end
