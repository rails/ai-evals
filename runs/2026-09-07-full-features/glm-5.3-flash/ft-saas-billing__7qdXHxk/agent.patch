diff --git a/saas/app/controllers/admin/overridden_limits_controller.rb b/saas/app/controllers/admin/overridden_limits_controller.rb
new file mode 100644
index 0000000..5521960
--- /dev/null
+++ b/saas/app/controllers/admin/overridden_limits_controller.rb
@@ -0,0 +1,43 @@
+class Admin::OverriddenLimitsController < ::AdminController
+  def create
+    if overriding?
+      record_override
+    else
+      reset_override
+    end
+
+    redirect_to saas.admin_account_path(account),
+      notice: "#{account.name} now counts for #{account.card_count} cards and #{account.bytes_used} bytes."
+  end
+
+  def destroy
+    account.overridden_limit&.destroy
+
+    redirect_to saas.admin_account_path(account), notice: "#{account.name} counts for itself again."
+  end
+
+  private
+    def record_override
+      if limit = account.overridden_limit
+        limit.update! limit_params
+      else
+        account.create_overridden_limit! limit_params
+      end
+    end
+
+    def reset_override
+      account.overridden_limit&.destroy
+    end
+
+    def overriding?
+      limit_params.present?
+    end
+
+    def limit_params
+      params.expect(overridden_limit: [ :card_count, :bytes_used ]).compact_blank
+    end
+
+    def account
+      @account ||= Account.find(params[:account_id])
+    end
+end
