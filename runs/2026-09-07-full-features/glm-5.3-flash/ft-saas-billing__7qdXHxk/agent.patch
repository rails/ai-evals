diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..1777eac
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+  end
+
+  test "syncs the subscription when Stripe reports a change" do
+    with_stripe_price_for(Plan.unlimited, "price_unlimited") do
+      post_stripe_event "customer.subscription.updated",
+        id: "sub_123", customer: "cus_123", status: "active",
+        items: { data: [ { price: { id: "price_unlimited" } } ] }
+    end
+
+    assert_response :no_content
+
+    assert_equal "sub_123", @subscription.reload.stripe_subscription_id
+    assert_equal "unlimited", @subscription.plan_key
+    assert_equal "active", @subscription.status
+    assert_equal Plan.unlimited, @account.reload.plan
+  end
+
+  test "attaches the subscription when Stripe reports a completed checkout" do
+    post_stripe_event "checkout.session.completed", id: "cs_1", customer: "cus_123", subscription: "sub_456"
+
+    assert_response :no_content
+    assert_equal "sub_456", @subscription.reload.stripe_subscription_id
+  end
+
+  test "cancels the subscription when Stripe reports it deleted" do
+    @subscription.update!(stripe_subscription_id: "sub_123", status: "active")
+
+    post_stripe_event "customer.subscription.deleted", id: "sub_123", customer: "cus_123"
+
+    assert_response :no_content
+    assert @subscription.reload.canceled?
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "ignores events about customers we don't know" do
+    assert_no_changes -> { @subscription.reload.attributes } do
+      post_stripe_event "customer.subscription.updated",
+        id: "sub_123", customer: "cus_unknown", status: "active",
+        items: { data: [ { price: { id: "price_unlimited" } } ] }
+    end
+  end
+
+  test "ignores events we don't bill on" do
+    assert_no_changes -> { @subscription.reload.attributes } do
+      post_stripe_event "invoice.paid", id: "in_1", customer: "cus_123"
+    end
+  end
+
+  test "rejects a payload that isn't an event" do
+    post_stripe_payload "{ not json"
+
+    assert_response :bad_request
+  end
+
+  test "rejects a payload that isn't signed properly" do
+    with_stripe_webhook_secret "whsec_test" do
+      post_stripe_payload "{ not json", signature: "t=#{Time.current.to_i},v1=not-the-signature"
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_stripe_event(type, object)
+      post_stripe_payload({ id: "evt_1", type: type, data: { object: object } }.to_json)
+    end
+
+    def post_stripe_payload(payload, signature: nil)
+      signature ||= signature_for(payload) if ENV["STRIPE_WEBHOOK_SECRET"]
+
+      headers = { "CONTENT_TYPE" => "application/json" }
+      headers["Stripe-Signature"] = signature if signature
+
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: headers
+      end
+    end
+
+    def signature_for(payload)
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      Stripe::Webhook::Signature.generate_header(Time.current,
+        Stripe::Webhook::Signature.compute_signature(Time.current, payload, secret))
+    end
+
+    def with_stripe_price_for(plan, price_id)
+      ENV["STRIPE_#{plan.key.upcase}_PRICE_ID"] = price_id
+      yield
+    ensure
+      ENV.delete("STRIPE_#{plan.key.upcase}_PRICE_ID")
+    end
+
+    def with_stripe_webhook_secret(secret)
+      ENV["STRIPE_WEBHOOK_SECRET"] = secret
+      yield
+    ensure
+      ENV.delete("STRIPE_WEBHOOK_SECRET")
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..8802348
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  test "accounts are on the free plan unless they subscribe" do
+    assert_equal Plan.free, accounts(:initech).plan
+    assert_not accounts(:initech).plan.paid?
+  end
+
+  test "an active subscription brings its plan along" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.unlimited_plus.key, stripe_customer_id: "cus_123", status: "active")
+
+    assert_equal Plan.unlimited_plus, account.plan
+  end
+
+  test "a canceled subscription leaves the account on the free plan" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123", status: "canceled")
+
+    assert_equal Plan.free, account.plan
+  end
+
+  test "free accounts are limited to 1,000 cards" do
+    account = accounts(:initech)
+
+    assert_equal 1_000, account.card_limit
+    assert_not account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+  end
+
+  test "paid accounts may create as many cards as they want" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123", status: "active")
+
+    assert_nil account.card_limit
+    assert_not account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+  end
+
+  test "an account with no cards left cannot create any more" do
+    account = accounts(:initech)
+    account.update_column :cards_count, 1_000
+
+    assert account.exceeding_card_limit?
+  end
+
+  test "the countdown starts a hundred cards short of the limit" do
+    account = accounts(:initech)
+    account.update_column :cards_count, 900
+
+    assert account.nearing_card_limit?
+    assert_equal 100, account.cards_remaining
+
+    account.update_column :cards_count, 950
+
+    assert_equal 50, account.cards_remaining
+  end
+
+  test "a paid plan brings its own storage allowance" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123", status: "active")
+
+    assert_equal 5.gigabytes, account.storage_limit
+  end
+
+  test "comped accounts are not limited" do
+    account = accounts(:initech)
+    account.update_column :cards_count, 5_000
+    account.create_storage_total!(bytes_stored: 10.gigabytes)
+    account.create_billing_waiver!
+
+    assert account.comped?
+    assert_nil account.card_limit
+    assert_nil account.storage_limit
+    assert_not account.exceeding_card_limit?
+    assert_not account.exceeding_storage_limit?
+  end
+
+  test "the overridden card count is what the account is counted for" do
+    account = accounts(:initech)
+    account.update_column :cards_count, 5_000
+
+    assert_equal 5_000, account.card_count
+
+    account.create_overridden_limit!(card_count: 5)
+
+    assert_equal 5, account.card_count
+    assert_equal 995, account.cards_remaining
+    assert_not account.exceeding_card_limit?
+  end
+
+  test "the overridden bytes used are what the account is counted for" do
+    account = accounts(:initech)
+    account.create_storage_total!(bytes_stored: 2.gigabytes)
+    account.create_overridden_limit!(bytes_used: 100.megabytes)
+
+    assert_equal 100.megabytes, account.bytes_used
+    assert_not account.exceeding_storage_limit?
+  end
+
+  test "starting a checkout creates the subscription along with its Stripe customer" do
+    Stripe::Customer.stubs(:create).returns(Stripe::StripeObject.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.stubs(:create).returns(Stripe::StripeObject.construct_from(url: "https://checkout.stripe.com/c/pay/123"))
+
+    account = accounts(:initech)
+
+    assert_difference -> { Account::Subscription.count } do
+      assert_equal "https://checkout.stripe.com/c/pay/123",
+        account.checkout_url(plan: Plan.unlimited, success_url: "https://fizzy.do/up", cancel_url: "https://fizzy.do/up")
+    end
+
+    assert_equal "cus_new", account.subscription.stripe_customer_id
+    assert_equal Plan.free.key, account.subscription.plan_key
+  end
+
+  test "checking out hands the account over to Stripe" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+    Stripe::Checkout::Session.stubs(:create).returns(Stripe::StripeObject.construct_from(url: "https://checkout.stripe.com/c/pay/123"))
+
+    assert_equal "https://checkout.stripe.com/c/pay/123",
+      account.checkout_url(plan: Plan.unlimited, success_url: "https://fizzy.do/up", cancel_url: "https://fizzy.do/up")
+  end
+
+  test "the portal hands the account over to Stripe as well" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+    Stripe::BillingPortal::Session.stubs(:create).returns(Stripe::StripeObject.construct_from(url: "https://billing.stripe.com/session/123"))
+
+    assert_equal "https://billing.stripe.com/session/123", account.portal_url(return_url: "https://fizzy.do/up")
+  end
+end
