+require "test_helper"
+
+class Card::PlanLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "draft card shows an upgrade pitch instead of create buttons when out of cards" do
+    out_of_cards
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch" do
+      assert_select "strong", text: /used all 1,000 cards/
+      assert_select "a", text: "Upgrade"
+    end
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows create buttons when there are cards left" do
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "draft card counts down when getting close to the limit" do
+    accounts(:initech).update_column :cards_count, 950
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch", text: /50 cards left/
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "staff sees create buttons even when out of cards" do
+    out_of_cards
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "cannot publish cards when out of cards" do
+    out_of_cards
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "staff can publish cards even when out of cards" do
+    out_of_cards
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "cannot create cards via the API when out of cards" do
+    out_of_cards
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can still draft cards when out of cards" do
+    out_of_cards
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "a paid account is not limited to cards" do
+    accounts(:initech).create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123", status: "active")
+    out_of_cards
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "a comped account is not limited to cards either" do
+    accounts(:initech).create_billing_waiver!
+    out_of_cards
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  private
+    def out_of_cards
+      accounts(:initech).update_column :cards_count, 1_000
+    end
+end
