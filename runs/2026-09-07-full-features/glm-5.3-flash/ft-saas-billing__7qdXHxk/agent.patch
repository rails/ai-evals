+# Stripe reports subscription changes here.
+class Stripe::WebhooksController < ApplicationController
+  SUBSCRIPTION_SYNCED_EVENTS = %w[ customer.subscription.created customer.subscription.updated ]
+  SUBSCRIPTION_ATTACHED_EVENT = "checkout.session.completed"
+  SUBSCRIPTION_CANCELED_EVENT = "customer.subscription.deleted"
+
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_before_action :verify_authenticity_token
+
+  def create
+    if event = verified_event
+      handle event
+      head :no_content
+    else
+      head :bad_request
+    end
+  end
+
+  private
+    def handle(event)
+      case event.type
+      when *SUBSCRIPTION_SYNCED_EVENTS
+        sync event.data.object
+      when SUBSCRIPTION_ATTACHED_EVENT
+        attach event.data.object
+      when SUBSCRIPTION_CANCELED_EVENT
+        cancel event.data.object
+      end
+    end
+
+    def sync(stripe_subscription)
+      subscription = Account::Subscription.find_by_stripe_customer_id(stripe_subscription.customer)
+      subscription&.sync_with_stripe!(stripe_subscription)
+    end
+
+    def attach(stripe_session)
+      subscription = Account::Subscription.find_by_stripe_customer_id(stripe_session.customer)
+      subscription&.update!(stripe_subscription_id: stripe_session.subscription)
+    end
+
+    def cancel(stripe_subscription)
+      subscription = Account::Subscription.find_by_stripe_subscription_id(stripe_subscription.id)
+      subscription&.update!(status: Account::Subscription::CANCELED_STATUS)
+    end
+
+    def verified_event
+      if webhook_secret
+        Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], webhook_secret)
+      else
+        # Without a secret there is nothing to verify the payload against. This
+        # is only ever the case where STRIPE_WEBHOOK_SECRET isn't configured.
+        Stripe::StripeObject.construct_from(JSON.parse(request.raw_post, symbolize_names: true))
+      end
+    rescue JSON::ParserError, Stripe::SignatureVerificationError
+      nil
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..01505a0
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,83 @@
+# What an account is entitled to, and what it uses: its plan, the card count
+# and the storage it is measured against, and the way it pays for all of it.
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  # How far from the card limit the countdown warning starts.
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_stripe_subscription
+    set_callback :incinerate, :before, :cancel_stripe_subscription
+  end
+
+  # The subscription the account is currently paying for, if any.
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def plan
+    active_subscription&.plan || Plan.free
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if value
+      create_billing_waiver! unless billing_waiver
+    else
+      # Assigning nil destroys the waiver, as the association is dependent.
+      self.billing_waiver = nil
+    end
+  end
+
+  def checkout_url(plan:, success_url:, cancel_url:)
+    Account::Subscription.start_for(self).checkout_url(plan: plan, success_url: success_url, cancel_url: cancel_url)
+  end
+
+  def portal_url(return_url:)
+    Account::Subscription.start_for(self).portal_url(return_url: return_url)
+  end
+
+  # The card count the account is measured against, support override included.
+  def card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  # The storage the account is measured against, support override included.
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def card_limit
+    comped? ? nil : plan.card_limit
+  end
+
+  def cards_remaining
+    card_limit - card_count if card_limit
+  end
+
+  def exceeding_card_limit?
+    if limit = card_limit
+      card_count >= limit
+    end
+  end
+
+  def nearing_card_limit?
+    if remaining = cards_remaining
+      !exceeding_card_limit? && remaining <= NEAR_CARD_LIMIT_THRESHOLD
+    end
+  end
+
+  private
+    # Nobody is left to bill for once the account is closed.
+    def cancel_stripe_subscription
+      subscription&.cancel_in_stripe!
+    end
+end
