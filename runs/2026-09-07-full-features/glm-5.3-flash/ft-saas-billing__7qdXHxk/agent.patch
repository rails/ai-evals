diff --git a/saas/app/views/my/billing/show.html.erb b/saas/app/views/my/billing/show.html.erb
new file mode 100644
index 0000000..402bd78
--- /dev/null
+++ b/saas/app/views/my/billing/show.html.erb
@@ -0,0 +1,43 @@
+<% @page_title = "Billing" %>
+
+<section class="panel panel--centered flex flex-column gap" style="--panel-size: auto;">
+  <h1 class="txt-x-large font-weight-black margin-none">Billing</h1>
+
+  <section class="panel shadow flex flex-column gap-half pad">
+    <h2 class="txt-large margin-none"><%= @account.plan.name %></h2>
+
+    <div class="txt-small">
+      <% if @account.plan.free? %>
+        Up to <strong><%= number_with_delimiter(@account.plan.card_limit) %></strong> cards and
+        <strong><%= number_to_human_size(@account.plan.storage_limit) %></strong> of storage.
+      <% else %>
+        Unlimited cards and <strong><%= number_to_human_size(@account.plan.storage_limit) %></strong> of storage for
+        <strong><%= number_to_currency(@account.plan.price_in_cents.fdiv(100), precision: 0) %></strong> a month.
+      <% end %>
+    </div>
+
+    <% if @account.comped? %>
+      <div class="txt-small">This account is comped, so it is on us.</div>
+    <% end %>
+
+    <div class="txt-small txt-ink-medium">
+      Using <strong><%= number_with_delimiter(@account.card_count) %></strong> cards and
+      <strong><%= number_to_human_size(@account.bytes_used) %></strong> of storage.
+    </div>
+  </section>
+
+  <% unless @account.comped? %>
+    <% if @account.plan.paid? %>
+      <%= button_to "Manage subscription", saas.my_billing_portal_path, class: "btn" %>
+    <% else %>
+      <% Plan.paid.each do |plan| %>
+        <%= button_to "Upgrade to " + plan.name + " — " + number_to_currency(plan.price_in_cents.fdiv(100), precision: 0) + "/month",
+              saas.my_billing_checkouts_path(plan: plan.key), class: "btn" %>
+      <% end %>
+    <% end %>
+  <% end %>
+
+  <%= link_to main_app.account_settings_path, class: "btn center txt-small margin-block-start" do %>
+    <span>Back to settings</span>
+  <% end %>
+</section>
