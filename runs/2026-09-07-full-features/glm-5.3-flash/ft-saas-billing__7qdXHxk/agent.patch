new file mode 100644
index 0000000..32118d7
--- /dev/null
+++ b/saas/app/controllers/my/billing/checkouts_controller.rb
@@ -0,0 +1,21 @@
+# Hands the account over to Stripe to check out for a plan.
+class My::Billing::CheckoutsController < ApplicationController
+  def create
+    plan = Plan.find(params[:plan])
+
+    if plan.stripe_price_id
+      redirect_to Current.account.checkout_url(plan: plan, success_url: return_url, cancel_url: return_url),
+        allow_other_host: true, status: :see_other
+    else
+      redirect_to saas.my_billing_path, alert: "The #{plan.name} plan isn't set up here yet."
+    end
+  rescue Plan::Unknown
+    redirect_to saas.my_billing_path, alert: "That plan doesn't exist."
+  end
+
+  private
+    # Where Stripe sends the account back once it is done checking out.
+    def return_url
+      "#{request.base_url}#{main_app.account_settings_path(script_name: request.script_name)}"
+    end
+end
