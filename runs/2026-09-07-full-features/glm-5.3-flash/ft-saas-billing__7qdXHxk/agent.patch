+require "test_helper"
+
+class My::Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    Stripe::Customer.stubs(:create).returns(Stripe::StripeObject.construct_from(id: "cus_new"))
+  end
+
+  test "hands the account over to Stripe to check out" do
+    Stripe::Checkout::Session.expects(:create).with(
+      mode: "subscription",
+      customer: "cus_new",
+      line_items: [ { price: "price_unlimited", quantity: 1 } ],
+      success_url: anything,
+      cancel_url: anything,
+      metadata: { account_id: accounts(:initech).id.to_s }
+    ).returns(Stripe::StripeObject.construct_from(url: "https://checkout.stripe.com/c/pay/123"))
+
+    with_stripe_price_for(Plan.unlimited, "price_unlimited") do
+      post checkout_path(plan: "unlimited")
+    end
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/123", allow_other_host: true
+  end
+
+  test "sends the account back to its settings once it is done" do
+    Stripe::Checkout::Session.expects(:create).with do |session|
+      assert session[:success_url].end_with?("/#{accounts(:initech).external_account_id}/account/settings")
+      assert_equal session[:success_url], session[:cancel_url]
+      true
+    end.returns(Stripe::StripeObject.construct_from(url: "https://checkout.stripe.com/c/pay/123"))
+
+    with_stripe_price_for(Plan.unlimited, "price_unlimited") do
+      post checkout_path(plan: "unlimited")
+    end
+  end
+
+  test "creates the subscription along with its Stripe customer on the way" do
+    Stripe::Checkout::Session.stubs(:create).returns(Stripe::StripeObject.construct_from(url: "https://checkout.stripe.com/c/pay/123"))
+
+    assert_difference -> { Account::Subscription.count } do
+      with_stripe_price_for(Plan.unlimited, "price_unlimited") do
+        post checkout_path(plan: "unlimited")
+      end
+    end
+
+    assert_equal "cus_new", accounts(:initech).subscription.stripe_customer_id
+  end
+
+  test "does nothing for a plan that isn't set up here" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post checkout_path(plan: "unlimited")
+
+    assert_redirected_to saas.my_billing_path(script_name: accounts(:initech).slug)
+    assert_equal "The Unlimited plan isn't set up here yet.", flash[:alert]
+  end
+
+  test "does nothing for a plan we don't have" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post checkout_path(plan: "enterprise")
+
+    assert_redirected_to saas.my_billing_path(script_name: accounts(:initech).slug)
+  end
+
+  private
+    def checkout_path(**options)
+      saas.my_billing_checkouts_path(**options, script_name: accounts(:initech).slug)
+    end
+
+    def with_stripe_price_for(plan, price_id)
+      ENV["STRIPE_#{plan.key.upcase}_PRICE_ID"] = price_id
+      yield
+    ensure
+      ENV.delete("STRIPE_#{plan.key.upcase}_PRICE_ID")
+    end
+end
