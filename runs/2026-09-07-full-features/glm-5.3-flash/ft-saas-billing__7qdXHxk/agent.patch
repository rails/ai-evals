diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..c2e934f
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  test "accounts start out on the free plan" do
+    Stripe::Customer.stubs(:create).returns(stripe_response(id: "cus_new"))
+
+    subscription = Account::Subscription.start_for(accounts(:initech))
+
+    assert_equal Plan.free.key, subscription.plan_key
+    assert_equal "cus_new", subscription.stripe_customer_id
+    assert_not subscription.active?
+  end
+
+  test "an account that already has a subscription keeps it" do
+    account = accounts(:initech)
+    account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+
+    Stripe::Customer.expects(:create).never
+
+    assert_equal "cus_123", Account::Subscription.start_for(account).stripe_customer_id
+  end
+
+  test "syncs with what Stripe reports" do
+    account = accounts(:initech)
+    subscription = account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+
+    with_stripe_price_for(Plan.unlimited, "price_unlimited") do
+      subscription.sync_with_stripe! stripe_subscription(
+        id: "sub_123",
+        status: "active",
+        cancel_at: nil,
+        price_id: "price_unlimited",
+        period_end: 1.month.from_now.to_i
+      )
+    end
+
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal Plan.unlimited.key, subscription.plan_key
+    assert subscription.active?
+    assert_in_delta 1.month.from_now.to_i, subscription.current_period_end.to_i, 1
+  end
+
+  test "keeps its plan when Stripe reports a price we don't know about" do
+    account = accounts(:initech)
+    subscription = account.create_subscription!(plan_key: Plan.unlimited.key, stripe_customer_id: "cus_123")
+
+    subscription.sync_with_stripe! stripe_subscription(
+      id: "sub_123",
+      status: "active",
+      cancel_at: nil,
+      price_id: "price_unknown"
+    )
+
+    assert_equal Plan.unlimited.key, subscription.plan_key
+  end
+
+  test "reads the period from the subscription itself when Stripe reports it there" do
+    account = accounts(:initech)
+    subscription = account.create_subscription!(plan_key: Plan.free.key, stripe_customer_id: "cus_123")
+
+    subscription.sync_with_stripe! stripe_subscription(
+      id: "sub_123",
+      status: "active",
+      cancel_at: nil,
+      price_id: "price_unlimited",
+      period_end_on_subscription: 2.weeks.from_now.to_i
+    )
+
+    assert_in_delta 2.weeks.from_now.to_i, subscription.current_period_end.to_i, 1
+  end
+
+  private
+    def stripe_subscription(id:, status:, cancel_at:, price_id:, period_end: nil, period_end_on_subscription: nil)
+      stripe_response(
+        id: id,
+        status: status,
+        cancel_at: cancel_at,
+        items: { data: [ { price: { id: price_id }, current_period_end: period_end } ] },
+        current_period_end: period_end_on_subscription
+      )
+    end
+
+    def stripe_response(attributes)
+      Stripe::StripeObject.construct_from(attributes)
+    end
+
+    def with_stripe_price_for(plan, price_id)
+      ENV["STRIPE_#{plan.key.upcase}_PRICE_ID"] = price_id
+      yield
+    ensure
+      ENV.delete("STRIPE_#{plan.key.upcase}_PRICE_ID")
+    end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..f995bc2
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan includes 1,000 cards and 1 GB of storage" do
+    assert_equal 1_000, Plan.free.card_limit
+    assert_equal 1.gigabyte, Plan.free.storage_limit
+    assert Plan.free.free?
+  end
+
+  test "paid plans include unlimited cards and their own storage allowance" do
+    Plan.paid.each do |plan|
+      assert_nil plan.card_limit
+      assert plan.unlimited_cards?
+      assert plan.paid?
+      assert plan.storage_limit > Plan.free.storage_limit
+    end
+  end
+
+  test "Unlimited costs $20 a month and comes with 5 GB" do
+    assert_equal "Unlimited", Plan.find(:unlimited).name
+    assert_equal 20_00, Plan.find(:unlimited).price_in_cents
+    assert_equal 5.gigabytes, Plan.find(:unlimited).storage_limit
+  end
+
+  test "Unlimited+ costs $25 a month and comes with 500 GB" do
+    assert_equal "Unlimited+", Plan.find("unlimited_plus").name
+    assert_equal 25_00, Plan.find("unlimited_plus").price_in_cents
+    assert_equal 500.gigabytes, Plan.find("unlimited_plus").storage_limit
+  end
+
+  test "finds a plan by its key" do
+    assert_equal Plan.free, Plan.find("free")
+    assert_equal Plan.unlimited, Plan.find("unlimited")
+    assert_equal Plan.unlimited_plus, Plan.find("unlimited_plus")
+  end
+
+  test "raises when there is no such plan" do
+    assert_raises(Plan::Unknown) { Plan.find("enterprise") }
+  end
+
+  test "finds a plan by its Stripe price" do
+    with_stripe_price_for(Plan.unlimited, "price_123") do
+      assert_equal Plan.unlimited, Plan.find_by_stripe_price_id("price_123")
+      assert_nil Plan.find_by_stripe_price_id("price_unknown")
+    end
+  end
+
+  private
+    def with_stripe_price_for(plan, price_id)
+      ENV["STRIPE_#{plan.key.upcase}_PRICE_ID"] = price_id
+      yield
+    ensure
+      ENV.delete("STRIPE_#{plan.key.upcase}_PRICE_ID")
+    end
+end
