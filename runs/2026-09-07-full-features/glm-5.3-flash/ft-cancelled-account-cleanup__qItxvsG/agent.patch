diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..802d9f1 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,113 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  # Every table that stores data belonging to an account. Each of them carries an
+  # account column, so one delete per table is all it takes.
+  #
+  # Records are listed most dependent first. They mirror the schema and the record
+  # sets exported by Account::DataTransfer::Manifest, so keep them in sync.
+  #
+  # Handled separately, because they either need more than a delete or don't carry
+  # an account column: search records, attachments with their blobs, storage
+  # snapshots of the polymorphic owners, and the join tables pointing at filters.
+  ACCOUNT_DATA = [
+    Webhook::Delivery, Webhook::DelinquencyTracker, Webhook,
+    Notification::Bundle, Notification,
+    Event, Mention, Reaction,
+    Card::ActivitySpike, Card::Goldness, Card::NotNow, Closure, Step, Assignment, Tagging, Watch, Pin, Comment, Card,
+    Board::Publication, Column, Board, Access,
+    Filter, Tag, Entropy, Search::Query,
+    Push::Subscription, User::Settings, User,
+    Export, Account::Import, ActionText::RichText, Storage::Entry,
+    Account::JoinCode, Account::Cancellation
+  ].freeze
+
+  FILTER_JOIN_TABLES = %w[
+    filters_tags
+    boards_filters
+    assignees_filters
+    assigners_filters
+    creators_filters
+    closers_filters
+  ].freeze
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Permanently removes the account and everything it holds from the database.
+  def incinerate
+    blobs = removable_blobs
+    blob_files = blobs.pluck(:service_name, :key)
+
+    transaction do
+      remove_filter_join_records
+      remove_storage_totals
+      remove_search_records
+      remove_attachments(blobs)
+      remove_account_data
+      delete
+    end
+
+    delete_blob_files(blob_files)
+  end
+
+  private
+    def remove_account_data
+      ACCOUNT_DATA.each { |model| model.where(account_id: id).delete_all }
+    end
+
+    # Filter join tables point at filters rather than at the account, so they are
+    # emptied through the account's filters.
+    def remove_filter_join_records
+      connection = self.class.connection
+
+      FILTER_JOIN_TABLES.each do |table|
+        connection.delete \
+          "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{Filter.where(account_id: id).select(:id).to_sql})"
+      end
+    end
+
+    # Storage snapshots are polymorphic on the account and on each of its boards.
+    def remove_storage_totals
+      Storage::Total.where(owner: self).or(Storage::Total.where(owner: boards)).delete_all
+    end
+
+    # Search records live in adapter specific tables, so they know how to remove
+    # themselves.
+    def remove_search_records
+      Search::Record.remove_all_for(id)
+    end
+
+    # Removed without callbacks, since there is no one left to track or purge them.
+    def remove_attachments(blobs)
+      ActiveStorage::Attachment.where(account_id: id).delete_all
+      ActiveStorage::VariantRecord.where(blob_id: blobs).delete_all
+      blobs.delete_all
+    end
+
+    # Blobs attached to the account's records and the ones it owns outright, since
+    # attachments without an account of their own still count as account data.
+    def removable_blobs
+      attached = ActiveStorage::Attachment.where(account_id: id).select(:blob_id)
+      ActiveStorage::Blob.where(id: attached).or(ActiveStorage::Blob.where(account_id: id))
+    end
+
+    def delete_blob_files(blob_files)
+      blob_files.each do |service_name, key|
+        next if service_name.blank?
+
+        ActiveStorage::Blob.services.fetch(service_name).delete(key)
+      end
+    end
 end
