diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7fe5ed5
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("david")
+  end
+
+  test "incinerates accounts cancelled more than 30 days ago" do
+    cancel_account_with(created_at: 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_nil Account.find_by(id: @account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+  end
+
+  test "leaves accounts cancelled within the last 30 days alone" do
+    cancel_account_with(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count }, -> { Card.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "leaves accounts that are not cancelled alone" do
+    assert_no_difference -> { Account.count }, -> { Card.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  private
+    def cancel_account_with(created_at:)
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update!(created_at: created_at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..d3831af
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @creator = users("david")
+    @board = @account.boards.first
+    @card = @account.cards.first
+    @identity_count = Identity.count
+  end
+
+  test "due_for_incineration returns accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @creator)
+
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel 31.days do
+      assert_includes Account.due_for_incineration, @account
+    end
+  end
+
+  test "due_for_incineration ignores accounts that are not cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate removes the account and all of its data" do
+    populate_account
+    assert_data_present
+
+    @account.incinerate
+
+    assert_nil Account.find_by(id: @account.id)
+
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+    assert_empty Account::Import.where(account_id: @account.id)
+    assert_empty Account::JoinCode.where(account_id: @account.id)
+    assert_empty Access.where(account_id: @account.id)
+    assert_empty ActionText::RichText.where(account_id: @account.id)
+    assert_empty ActiveStorage::Attachment.where(account_id: @account.id)
+    assert_empty ActiveStorage::Blob.where(account_id: @account.id)
+    assert_empty ActiveStorage::VariantRecord.where(account_id: @account.id)
+    assert_empty Assignment.where(account_id: @account.id)
+    assert_empty Board.where(account_id: @account.id)
+    assert_empty Board::Publication.where(account_id: @account.id)
+    assert_empty Card.where(account_id: @account.id)
+    assert_empty Card::ActivitySpike.where(account_id: @account.id)
+    assert_empty Card::Goldness.where(account_id: @account.id)
+    assert_empty Card::NotNow.where(account_id: @account.id)
+    assert_empty Closure.where(account_id: @account.id)
+    assert_empty Column.where(account_id: @account.id)
+    assert_empty Comment.where(account_id: @account.id)
+    assert_empty Entropy.where(account_id: @account.id)
+    assert_empty Event.where(account_id: @account.id)
+    assert_empty Export.where(account_id: @account.id)
+    assert_empty Filter.where(account_id: @account.id)
+    assert_empty Mention.where(account_id: @account.id)
+    assert_empty Notification.where(account_id: @account.id)
+    assert_empty Notification::Bundle.where(account_id: @account.id)
+    assert_empty Pin.where(account_id: @account.id)
+    assert_empty Push::Subscription.where(account_id: @account.id)
+    assert_empty Reaction.where(account_id: @account.id)
+    assert_empty Search::Query.where(account_id: @account.id)
+    assert_no_leftover_search_records
+    assert_empty Step.where(account_id: @account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+    assert_empty Tag.where(account_id: @account.id)
+    assert_empty Tagging.where(account_id: @account.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty User::Settings.where(account_id: @account.id)
+    assert_empty Watch.where(account_id: @account.id)
+    assert_empty Webhook.where(account_id: @account.id)
+    assert_empty Webhook::Delivery.where(account_id: @account.id)
+    assert_empty Webhook::DelinquencyTracker.where(account_id: @account.id)
+
+    assert_empty Storage::Total.where(owner: [ @account, @board ])
+    assert_equal 0, leftover_filter_join_records
+
+    # Other accounts keep everything, including the shared identities.
+    assert_equal @identity_count, Identity.count
+    assert Board.exists?(boards(:miltons_wish_list).id)
+    assert_not_empty Card.where.not(account_id: @account.id)
+  end
+
+  test "incinerate removes the files behind the account's blobs" do
+    populate_account
+
+    blob_keys = ActiveStorage::Blob.where(account_id: @account.id).pluck(:key)
+    assert blob_keys.any?
+
+    @account.incinerate
+
+    blob_keys.each do |key|
+      assert_not ActiveStorage::Blob.service.exist?(key)
+    end
+  end
+
+  test "incinerate_due only incinerates accounts cancelled more than 30 days ago" do
+    assert_no_difference -> { Account.count } do
+      Account.incinerate_due
+    end
+
+    due_account = accounts("initech")
+    due_account.cancel(initiated_by: @creator)
+    due_account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_nil Account.find_by(id: due_account.id)
+  end
+
+  private
+    def assert_data_present
+      assert Search::Record.for(@account.id).where(account_id: @account.id).exists?
+      assert Storage::Entry.where(account_id: @account.id).exists?
+      assert ActiveStorage::Blob.where(account_id: @account.id).exists?
+      assert Notification.where(account_id: @account.id).exists?
+      assert leftover_filter_join_records.positive?
+    end
+
+    def populate_account
+      Current.with(account: @account, user: @creator) do
+        card = @board.cards.create!(title: "Incineration card", status: "published")
+
+        attach_image_to(@card)
+        attach_image_to(card)
+
+        comment = @card.comments.create!(creator: @creator, body: "Soon gone")
+        comment.reactions.create!(reacter: @creator, content: "heart")
+        comment.mentions.create!(mentioner: @creator, mentionee: @account.users.excluding(@creator).first, source: comment)
+
+        card.steps.create!(content: "A step")
+        card.assignments.create!(assigner: @creator, assignee: @account.users.excluding(@creator).first)
+        card.create_closure!(user: @creator)
+        card.watches.create!(user: @creator)
+        card.pins.create!(user: @creator)
+        card.create_goldness!
+        card.create_activity_spike!
+        card.create_not_now!(user: @creator)
+        card.taggings.create!(tag: @account.tags.first || @account.tags.create!(title: "Incineration"))
+
+        @board.events.create!(action: "card_published", creator: @creator, eventable: card)
+        @board.create_publication!
+
+        webhooks(:active).deliveries.create!(event: Event.last, request: "{}", response: "200", state: "completed")
+        Webhook::DelinquencyTracker.create!(webhook: webhooks(:active), account: @account, consecutive_failures_count: 1)
+
+        Search::Query.create!(account: @account, user: @creator, terms: "incineration")
+        Notification.create!(account: @account, creator: @creator, user: @creator, source: Event.last, card: @card)
+        User::Settings.find_or_create_by!(user: @creator) { |settings| settings.account = @account }
+
+        export = @account.exports.create!(user: @creator)
+        export.file.attach io: StringIO.new("export"), filename: "export.zip", content_type: "application/zip"
+
+        filter = Filter.create!(creator: @creator, account: @account)
+        filter.update!(tag_ids: [ Tag.first.id ], board_ids: [ @board.id ], assignee_ids: [ @account.users.excluding(@creator).first.id ])
+      end
+    end
+
+    def attach_image_to(card)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open, filename: "embedded.jpg", content_type: "image/jpeg"
+
+      attachment = ActionText::Attachment.from_attachable(blob).to_html
+      card.update!(description: "<p>With an image: #{attachment}</p>")
+    end
+
+    def assert_no_leftover_search_records
+      remaining = Search::Record.for(@account.id).where(account_id: @account.id).select(:id)
+      assert_empty remaining
+
+      if sqlite?
+        assert_empty Search::Record::SQLite::Fts.where(rowid: remaining)
+      end
+    end
+
+    def sqlite?
+      ActiveRecord::Base.connection.adapter_name == "SQLite"
+    end
+
+    def leftover_filter_join_records
+      filters = Filter.where(account_id: @account.id).select(:id)
+
+      Account::Incineratable::FILTER_JOIN_TABLES.sum do |table|
+        ActiveRecord::Base.connection.select_value("SELECT count(*) FROM #{table} WHERE filter_id IN (#{filters.to_sql})")
+      end
+    end
+end
