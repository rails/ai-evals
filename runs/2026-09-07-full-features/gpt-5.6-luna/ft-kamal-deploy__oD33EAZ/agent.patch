 ## License
 
 Fizzy is released under the [O'Saasy License](LICENSE.md).
+
+## Deploying to one server
+
+Fizzy includes a Kamal configuration for a single Linux server with Docker. Install
+Kamal locally, copy `.kamal/secrets.example` to `.kamal/secrets`, and fill in the
+registry token, `RAILS_MASTER_KEY`, `SECRET_KEY_BASE`, and SMTP password. Then edit
+`config/deploy.yml` and replace the Docker image/registry name, host name, SSH user,
+and SMTP values. The host must have ports 80 and 443 available.
+
+Run:
+
+```sh
+kamal setup
+```
+
+The `web` and `jobs` roles intentionally use the same host. Kamal Proxy obtains and
+renews the certificate when `proxy.ssl` is enabled. The `fizzy` volume stores SQLite
+databases, Solid Queue's job data, and uploaded files at `/rails/storage`, so these
+survive container replacement and subsequent deploys. Back up that Docker volume.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..2a3571f
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,45 @@
+# Deploy Fizzy to one Linux host running Docker.
+# Replace the values marked CHANGE ME, then run: kamal setup
+service: fizzy
+image: your-dockerhub-username/fizzy
+
+servers:
+  web:
+    hosts:
+      - your-host.example.com
+  jobs:
+    hosts:
+      - your-host.example.com
+    cmd: bin/jobs
+
+proxy:
+  ssl: true
+
+ssh:
+  user: root
+
+env:
+  clear:
+    RAILS_ENV: production
+    APP_HOSTNAME: your-host.example.com
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: your-host.example.com
+    SMTP_USERNAME: your-mail-user
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@your-host.example.com>
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# Keep SQLite databases, Solid Queue data, and uploads across deploys.
+volumes:
+  - fizzy:/rails/storage
+
+registry:
+  username: your-dockerhub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
