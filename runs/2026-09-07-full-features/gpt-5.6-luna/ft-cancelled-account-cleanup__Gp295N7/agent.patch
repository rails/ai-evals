diff --git a/app/jobs/account/incinerate_due_job.rb b/app/jobs/account/incinerate_due_job.rb
new file mode 100644
index 0000000..f37e017
--- /dev/null
+++ b/app/jobs/account/incinerate_due_job.rb
@@ -0,0 +1,9 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.joins(:cancellation)
+      .where(account_cancellations: { created_at: ...Account::Incineratable::INCINERATION_GRACE_PERIOD.ago })
+      .find_each(&:incinerate)
+  end
+end
