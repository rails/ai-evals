diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..66a8c6b
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,61 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Dates are deliberately formatted here, rather than in ERB. This keeps cached
+// fragments identical for everyone and lets Intl use the viewer's timezone.
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+    if (["relative", "future", "comment"].includes(this.formatValue)) {
+      this.timer = setInterval(() => this.render(), 60_000)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    this.element.textContent = formatDate(date, this.formatValue || "date")
+  }
+}
+
+const day = date => new Intl.DateTimeFormat(undefined, { year: "numeric", month: "numeric", day: "numeric" }).format(date)
+const dayDifference = (from, to) => {
+  const fromDay = new Date(from.getFullYear(), from.getMonth(), from.getDate())
+  const toDay = new Date(to.getFullYear(), to.getMonth(), to.getDate())
+  return Math.round((toDay - fromDay) / 86_400_000)
+}
+
+function formatDate(date, format) {
+  if (format === "time") {
+    return new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+  }
+
+  if (format === "datetime") {
+    return new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(date)
+  }
+
+  if (format === "comment" || format === "relative" || format === "future") {
+    const difference = dayDifference(new Date(), date)
+    if (format === "future") {
+      if (difference === 1) return "tomorrow"
+      if (difference > 1 && difference < 7) return `in ${difference} days`
+      return shortDate(date)
+    }
+    if (difference === 0 && format === "comment") return formatDate(date, "time")
+    if (difference === -1) return "yesterday"
+    if (difference < -1 && difference >= -6) return `${-difference} days ago`
+    return shortDate(date)
+  }
+
+  return shortDate(date)
+}
+
+function shortDate(date) {
+  return new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" }).format(date)
+}
