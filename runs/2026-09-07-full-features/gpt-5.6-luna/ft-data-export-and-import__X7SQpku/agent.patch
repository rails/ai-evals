+class Account::Export < ApplicationRecord
+  self.table_name = "account_exports"
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file
+  before_validation { self.token ||= SecureRandom.urlsafe_base64(32) }
+  validates :token, :expires_at, presence: true
+  scope :available, -> { where("expires_at > ?", Time.current) }
+  def available? = expires_at.future? && file.attached?
+end
