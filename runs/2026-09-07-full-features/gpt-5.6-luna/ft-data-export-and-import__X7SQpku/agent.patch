diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..6252810
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,29 @@
+class Account::ExportJob < ApplicationJob
+  def perform(export)
+    export.reload
+    account = export.account
+    tempfile = Tempfile.new(["fizzy-account", ".zip"]); tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("manifest.json", JSON.generate(version: 1, account_id: account.id, exported_at: Time.current))
+    if export.kind == "cards"
+      account.users.find(export.user_id).accessible_cards.find_each do |card|
+        writer.add_file("cards/#{card.id}.json", JSON.generate(card.attributes.merge("comments" => card.comments.map(&:attributes))))
+        if card.image.attached?
+          blob = card.image.blob
+          writer.add_file("cards/#{card.id}/files/#{blob.filename}") { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+      end
+    else
+      Account::DataTransfer::Manifest.new(account).each_record_set { |set| set.write_to(writer) }
+    end
+    writer.close; tempfile.rewind
+    export.file.attach(io: tempfile, filename: "fizzy-export.zip", content_type: "application/zip")
+    AccountMailer.export_ready(export).deliver_later
+  rescue => error
+    Rails.logger.error("Account export failed: #{error.class}: #{error.message}")
+    AccountMailer.export_failed(export, error).deliver_later if export&.persisted?
+    raise
+  ensure
+    tempfile&.close; tempfile&.unlink
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..8135c52
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,24 @@
+class Account::ImportJob < ApplicationJob
+  def perform(import_record)
+    import_record.update!(status: :processing)
+    new_account = nil
+    ActiveRecord::Base.transaction do
+      new_account = Account.create!(name: "Imported account")
+      import_record.file.open { |io| validate_archive!(io) }
+      import_record.update!(account: new_account)
+      Account::DataTransfer::Importer.new(new_account, import_record.file).run!
+    end
+    import_record.update!(status: :completed)
+    AccountMailer.import_finished(import_record).deliver_later
+  rescue => error
+    new_account&.destroy!
+    import_record.update_columns(status: "failed", error: "#{error.class}: #{error.message}") if import_record&.persisted?
+    AccountMailer.import_failed(import_record).deliver_later if import_record&.persisted?
+  end
+  private
+    def validate_archive!(io)
+      raise ArgumentError, "The account file is empty" if io.size.zero?
+      entries = ZipKit::FileReader.read_zip_structure(io: io)
+      raise ArgumentError, "Not a Fizzy account file" unless entries.any? { |e| e.filename == "manifest.json" }
+    end
+end
