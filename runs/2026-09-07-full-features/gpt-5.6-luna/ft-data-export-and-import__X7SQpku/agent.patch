index 0000000..35d7192
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,14 @@
+class Account::DataTransfer::Importer
+  def initialize(account, attachment)
+    @account, @attachment = account, attachment
+  end
+  def run!
+    @attachment.open do |io|
+      entries = ZipKit::FileReader.read_zip_structure(io: io)
+      manifest = entries.find { |e| e.filename == "manifest.json" }
+      raise ArgumentError, "Not a Fizzy account file" unless manifest
+      data = manifest.extractor_from(io); json = +""; json << data.extract(64.kilobytes) until data.eof?
+      raise ArgumentError, "Unsupported account file" unless JSON.parse(json)["version"] == 1
+    end
+  end
+end
