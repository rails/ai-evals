@@ -0,0 +1,23 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+  belongs_to :webhook
+
+  def failure!
+    with_lock do
+      now = Time.current
+      if first_failure_at.blank? || first_failure_at < 1.hour.ago
+        self.consecutive_failures_count = 1
+        self.first_failure_at = now
+      else
+        self.consecutive_failures_count += 1
+      end
+      save!
+      webhook.deactivate if consecutive_failures_count >= 10 && first_failure_at >= 1.hour.ago
+    end
+  end
+
+  def success!
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
