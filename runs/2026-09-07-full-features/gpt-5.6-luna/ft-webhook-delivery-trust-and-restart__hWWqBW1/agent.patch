+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery)
+    return unless delivery.webhook.active?
+    return unless delivery.claim!
+    delivery.deliver!
+  end
+end
