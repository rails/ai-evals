diff --git a/app/services/webhook/deliverer.rb b/app/services/webhook/deliverer.rb
new file mode 100644
index 0000000..20c4958
--- /dev/null
+++ b/app/services/webhook/deliverer.rb
@@ -0,0 +1,36 @@
+require "net/http"
+require "openssl"
+require "uri"
+
+class Webhook::Deliverer
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  def initialize(delivery)
+    @delivery, @webhook, @event = delivery, delivery.webhook, delivery.event
+  end
+
+  def call
+    body = payload.to_json
+    timestamp = @event.created_at.utc.iso8601(3)
+    headers = { "User-Agent" => USER_AGENT, "Content-Type" => "application/json",
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body),
+      "X-Webhook-Timestamp" => timestamp }
+    @delivery.update!(request: { headers: headers, body: body })
+    uri = URI.parse(@webhook.url)
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https",
+      open_timeout: 5, read_timeout: 15) { |http| http.request(request) }
+    @delivery.complete!(code: response.code.to_i, headers: response.each_header.to_h)
+  rescue StandardError => error
+    @delivery.fail!(error.class.name.underscore)
+  end
+
+  private
+    def payload
+      card = @event.card
+      { id: @event.id, action: @event.action.to_s, created_at: @event.created_at.utc.iso8601(3),
+        board: { id: @event.board_id, name: @event.board.name },
+        creator: { id: @event.creator_id, name: @event.creator.name },
+        card: card && { id: card.id, number: card.number, title: card.title }, particulars: @event.particulars }
+    end
+end
