--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -93,3 +93,29 @@ Rails.application.configure do
   # Skip DNS rebinding protection for the default health check endpoint.
   # config.host_authorization = { exclude: ->(request) { request.path == "/up" } }
 end
+
+# The OSS deployment uses an SMTP server supplied by the operator. Keeping
+# this optional preserves the default Rails behavior for installs that do not
+# send mail.
+Rails.application.configure do
+if ENV["MAILER_SMTP_ADDRESS"].present?
+  config.action_mailer.default_url_options = {
+    host: ENV.fetch("APP_FQDN"),
+    protocol: "https"
+  }
+  config.action_controller.default_url_options = {
+    host: ENV.fetch("APP_FQDN"),
+    protocol: "https"
+  }
+  config.action_mailer.smtp_settings = {
+    address: ENV.fetch("MAILER_SMTP_ADDRESS"),
+    port: Integer(ENV.fetch("MAILER_SMTP_PORT", "587")),
+    domain: ENV.fetch("MAILER_SMTP_DOMAIN", ENV.fetch("APP_FQDN", "localhost")),
+    user_name: ENV["MAILER_SMTP_USERNAME"],
+    password: ENV["MAILER_SMTP_PASSWORD"],
+    authentication: ENV.fetch("MAILER_SMTP_AUTHENTICATION", "plain"),
+    enable_starttls_auto: ENV.fetch("MAILER_SMTP_ENABLE_STARTTLS", "true") == "true"
+  }
+end
+
+end
