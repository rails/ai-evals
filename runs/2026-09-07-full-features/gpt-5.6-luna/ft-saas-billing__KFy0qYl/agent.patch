diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..c5387a0
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,24 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, only: %i[show update reset]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+  def show; end
+  def update
+    if params[:comp] || params[:uncomp]
+      params[:comp] ? @account.create_billing_waiver! : @account.billing_waiver&.destroy!
+      return redirect_to admin_account_path(@account)
+    end
+    limit = @account.overridden_limit || @account.build_overridden_limit
+    limit.update!(params.expect(account_overridden_limit: %i[card_count bytes_used]))
+    redirect_to admin_account_path(@account)
+  end
+  def reset
+    @account.overridden_limit&.destroy!
+    redirect_to admin_account_path(@account)
+  end
+  private
+    def set_account = @account = Account.find(params[:id])
+end
