+
+# Billing is deliberately a local boundary: Stripe owns the destinations and
+# only sends state changes to this webhook.
+Fizzy::Saas::Engine.routes.draw do
+  namespace :stripe do
+    post "webhooks", to: "/stripe#webhook"
+  end
+  get "billing/checkout", to: "billing#checkout", as: :billing_checkout
