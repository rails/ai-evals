new file mode 100644
index 0000000..0832aa9
--- /dev/null
+++ b/saas/app/models/account_subscription.rb
@@ -0,0 +1,13 @@
+class AccountSubscription < SaasRecord
+  belongs_to :account
+  validates :plan_key, presence: true
+
+  PLANS = {
+    "Free" => { cards: 1_000, storage: 1.gigabyte, price: 0 },
+    "Unlimited" => { cards: Float::INFINITY, storage: 5.gigabytes, price: 20 },
+    "Unlimited+" => { cards: Float::INFINITY, storage: 500.gigabytes, price: 25 }
+  }.freeze
+
+  def plan = PLANS.fetch(plan_key, PLANS["Free"])
+  def active? = status.blank? || %w[active trialing].include?(status)
+end
