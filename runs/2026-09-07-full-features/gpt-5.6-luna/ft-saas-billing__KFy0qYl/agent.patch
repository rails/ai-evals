diff --git a/saas/app/controllers/stripe_controller.rb b/saas/app/controllers/stripe_controller.rb
new file mode 100644
index 0000000..0989837
--- /dev/null
+++ b/saas/app/controllers/stripe_controller.rb
@@ -0,0 +1,31 @@
+class StripeController < ApplicationController
+  skip_before_action :verify_authenticity_token, only: :webhook
+  disallow_account_scope
+
+  # Stripe calls this endpoint; keeping parsing here means local development and
+  # tests never need a Stripe connection.
+  def webhook
+    event = JSON.parse(request.raw_post.presence || "{}")
+    object = event.dig("data", "object") || {}
+    customer = object["customer"]
+    account = AccountSubscription.find_by(stripe_customer_id: customer)&.account
+    account ||= Account.find_by(external_account_id: object["metadata"].to_h["account_id"])
+    if account && %w[customer.subscription.created customer.subscription.updated customer.subscription.deleted].include?(event["type"])
+      subscription = account.account_subscription || account.build_account_subscription
+      subscription.assign_attributes(plan_key: plan_for(object), stripe_customer_id: customer,
+        stripe_subscription_id: object["id"], status: object["status"],
+        current_period_end: object["current_period_end"] && Time.at(object["current_period_end"]),
+        cancel_at: object["cancel_at"] && Time.at(object["cancel_at"]))
+      subscription.save!
+    end
+    head :ok
+  rescue JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def plan_for(object)
+      key = object.dig("metadata", "plan") || object.dig("items", "data", 0, "price", "lookup_key")
+      %w[Unlimited Unlimited+].include?(key) ? key : "Free"
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..4ed3efc
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,39 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+  FREE_PLAN = "Free"
+
+  included do
+    has_one :account_subscription, dependent: :destroy
+    has_one :overridden_limit, class_name: "AccountOverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "AccountBillingWaiver", dependent: :destroy
+  end
+
+  def plan
+    return "Unlimited" if comped?
+    account_subscription&.active? ? account_subscription.plan_key : FREE_PLAN
+  end
+
+  def plan_details
+    AccountSubscription::PLANS.fetch(plan, AccountSubscription::PLANS[FREE_PLAN])
+  end
+
+  def card_limit
+    overridden_limit&.card_count || plan_details[:cards]
+  end
+
+  def storage_limit
+    overridden_limitoverridden_limit&.bytes_used || plan_details[:storage].bytes_used || storage_exception&.bytes_allowed || plan_details[:storage]
+  end
+
+  def cards_limit_reached?
+    card_limit != Float::INFINITY && cards_count >= card_limit
+  end
+
+  def cards_remaining
+    return Float::INFINITY if card_limit == Float::INFINITY
+    [card_limit - cards_count, 0].max
+  end
+
+  def paid? = plan != FREE_PLAN
+  def comped? = billing_waiver.present?
+end
