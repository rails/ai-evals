diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..2f8d53c
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,24 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..(Time.current - STALLED_AFTER)) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def mark_burst!
+    update_column(:burst_at, Time.current)
+  end
+
+  def register_comment_burst(comment)
+    window = auto_postpone_period / 3
+    recent_comments = comments.by_user.where(created_at: (comment.created_at - window)..comment.created_at)
+
+    mark_burst! if recent_comments.distinct.count(:creator_id) >= 2 && recent_comments.count >= 3
+  end
+end
