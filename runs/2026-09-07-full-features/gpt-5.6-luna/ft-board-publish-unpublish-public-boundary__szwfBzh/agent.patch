diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..85491ce
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,14 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :set_board
+  before_action :ensure_admin
+  def create
+    @board.publish!
+    respond_to { |format| format.html { redirect_to edit_board_path(@board), notice: "Board published" }; format.json { render "boards/show" } }
+  end
+  def destroy
+    @board.unpublish!
+    respond_to { |format| format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }; format.json { render "boards/show" } }
+  end
+  private
+    def set_board = @board = Current.account.boards.find(params[:board_id])
+end
