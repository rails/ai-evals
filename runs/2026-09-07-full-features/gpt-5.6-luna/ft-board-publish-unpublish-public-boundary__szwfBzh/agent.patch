diff --git a/app/models/board.rb b/app/models/board.rb
index 37ecb85..ddebee0 100644
--- a/app/models/board.rb
+++ b/app/models/board.rb
@@ -8,6 +8,22 @@ class Board < ApplicationRecord
   has_many :events
   has_many :webhooks, dependent: :destroy
 
+  def publish!
+    update!(public_key: SecureRandom.urlsafe_base64(32))
+  end
+
+  def unpublish!
+    update!(public_key: nil)
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_url
+    public_key.present? ? "/public/boards/#{public_key}" : nil
+  end
+
   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
 end
