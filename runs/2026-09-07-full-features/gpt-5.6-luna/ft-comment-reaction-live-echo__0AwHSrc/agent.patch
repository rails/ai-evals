@@ -0,0 +1,43 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_comment_is_commentable
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(account: @card.account, creator: Current.user))
+    render_reactions
+  end
+
+  def destroy
+    head :forbidden unless @reaction.creator == Current.user
+    @reaction.destroy!
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_comment_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      render turbo_stream: turbo_stream.replace(
+        dom_id(@comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: @comment.reload }
+      )
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..a10e3b3
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["form", "input", "submit", "cancel", "trigger"]
+
+  open() {
+    this.inputTarget.hidden = false
+    this.submitTarget.hidden = false
+    this.cancelTarget.hidden = false
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.inputTarget.value = ""
+    this.inputTarget.hidden = true
+    this.submitTarget.hidden = true
+    this.cancelTarget.hidden = true
+    this.triggerTarget.hidden = false
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  toggleDelete(event) {
+    const reaction = event.currentTarget
+    const currentUser = document.querySelector('meta[name="current-user-id"]')?.content
+    if (reaction.dataset.creatorId !== currentUser) return
+    reaction.classList.toggle("expanded")
+  }
+}
