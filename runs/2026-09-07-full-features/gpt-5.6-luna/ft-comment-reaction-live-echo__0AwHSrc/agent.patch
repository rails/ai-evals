diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..c5e2be8
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :comment
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :creator_id, uniqueness: { scope: :comment_id }
+  validate :same_account_as_comment
+
+  after_commit :broadcast_reactions
+
+  private
+    def same_account_as_comment
+      errors.add(:account, "does not match comment") if account && comment && account_id != comment.account_id
+    end
+
+    def broadcast_reactions
+      Turbo::StreamsChannel.broadcast_replace_to(
+        comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: comment.reload }
+      )
+    end
+end
