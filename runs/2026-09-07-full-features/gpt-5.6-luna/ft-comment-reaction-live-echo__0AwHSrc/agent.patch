+  <span class="txt-small txt-medium"><%= reaction.content %></span>
+  <%= button_to card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), method: :delete, class: "reaction__delete btn btn--circle borderless", title: "Remove reaction", form: { data: { turbo_confirm: "Remove this reaction?" } } do %>
+    <%= icon_tag "close" %><span class="for-screen-reader">Remove reaction</span>
+  <% end %>
+</div>
diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
