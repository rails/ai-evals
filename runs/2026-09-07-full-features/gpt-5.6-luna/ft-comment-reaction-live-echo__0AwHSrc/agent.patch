--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,16 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div class="reactions__list">
+    <%= render partial: "cards/comments/reaction", collection: comment.reactions.includes(:creator).order(:created_at), as: :reaction %>
+  </div>
+
+  <div class="reaction__form" data-reactions-target="form">
+    <%= form_with model: [ comment.card, comment, Reaction.new ], class: "flex align-center", data: { action: "turbo:submit-end->reactions#submitted" } do |form| %>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off", placeholder: "React…", aria: { label: "Your reaction" }, data: { reactions_target: "input" }, hidden: true %>
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", hidden: true, data: { reactions_target: "submit" }, title: "Add reaction" do %>
+        <%= icon_tag "check" %><span class="for-screen-reader">Confirm reaction</span>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" hidden data-reactions-target="cancel" data-action="reactions#cancel" title="Cancel"><%= icon_tag "close" %><span class="for-screen-reader">Cancel</span></button>
+      <button type="button" class="reactions__trigger btn btn--circle borderless" data-reactions-target="trigger" data-action="reactions#open" title="Add reaction"><%= image_tag "boost-color.svg", alt: "" %><span class="for-screen-reader">Add reaction</span></button>
+    <% end %>
+  </div>
+</div>
