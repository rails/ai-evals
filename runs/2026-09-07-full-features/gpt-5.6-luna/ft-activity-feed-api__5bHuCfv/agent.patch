diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..790c716
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "returns accessible timeline activity as a flat JSON array" do
+    get activities_path, as: :json
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_kind_of Array, activities
+    assert activities.any?
+    activity = activities.first
+    assert_equal %w[id action created_at description particulars url eventable_type eventable board creator].sort, activity.keys.sort
+  end
+
+  test "filters by board and creator" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ], creator_ids: [ users(:david).id ] }, as: :json
+
+    assert_response :success
+    response.parsed_body.each do |activity|
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+      assert_equal users(:david).id, activity.dig("creator", "id")
+    end
+  end
+end
