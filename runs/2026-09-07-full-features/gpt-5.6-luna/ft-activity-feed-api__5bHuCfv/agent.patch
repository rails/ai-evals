diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..c2262a5
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,31 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities, ordered_by: { created_at: :desc, id: :desc }
+  end
+
+  private
+    def activities
+      events = Event.preloaded
+        .where(board: Current.user.boards)
+        .where(action: TIMELINEABLE_ACTIONS)
+
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      events
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..afc5446
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,33 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+
+  json.particulars do
+    case event.action.to_s
+    when "card_assigned", "card_unassigned"
+      json.assignee_ids event.assignee_ids || []
+    when "card_board_changed"
+      json.old_board (event.particulars || {}).dig("particulars", "old_board").to_s
+      json.new_board (event.particulars || {}).dig("particulars", "new_board").to_s
+    when "card_title_changed"
+      json.old_title (event.particulars || {}).dig("particulars", "old_title").to_s
+      json.new_title (event.particulars || {}).dig("particulars", "new_title").to_s
+    when "card_triaged"
+      json.column (event.particulars || {}).dig("particulars", "column").to_s
+    end
+  end
+
+  if event.eventable_type == "Comment"
+    json.url card_url(event.eventable.card, anchor: ActionView::RecordIdentifier.dom_id(event.eventable))
+    json.eventable_type event.eventable_type
+    json.eventable event.eventable, partial: "cards/comments/comment", as: :comment
+  else
+    json.url card_url(event.eventable)
+    json.eventable_type event.eventable_type
+    json.eventable event.eventable, partial: "cards/card", as: :card
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
