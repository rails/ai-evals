diff --git a/app/services/email_digest_windowing.rb b/app/services/email_digest_windowing.rb
new file mode 100644
index 0000000..18bb59f
--- /dev/null
+++ b/app/services/email_digest_windowing.rb
@@ -0,0 +1,21 @@
+# Assigns notifications to a durable, per-user time window.
+class EmailDigestWindowing
+  DURATIONS = { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.freeze
+
+  def self.add(notification, now: Time.current)
+    frequency = notification.user.settings&.bundle_email_frequency
+    return if frequency.blank? || frequency == "never"
+
+    settings = notification.user.settings
+    settings.with_lock do
+      window = EmailDigestWindow.open.where(user: notification.user)
+        .where("opened_at <= ? AND closes_at > ?", now, now).first
+      unless window
+        window = EmailDigestWindow.create!(account: notification.account, user: notification.user,
+          opened_at: now, closes_at: now + DURATIONS.fetch(frequency))
+        SendEmailDigestJob.set(wait_until: window.closes_at).perform_later(window)
+      end
+      notification.update_column(:email_digest_window_id, window.id)
+    end
+  end
+end
