diff --git a/app/jobs/send_email_digest_job.rb b/app/jobs/send_email_digest_job.rb
new file mode 100644
index 0000000..f3e2c59
--- /dev/null
+++ b/app/jobs/send_email_digest_job.rb
@@ -0,0 +1,11 @@
+class SendEmailDigestJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(window)
+    window.with_lock do
+      return unless window.open? && window.closes_at <= Time.current
+      window.update!(sent_at: Time.current)
+      EmailDigestMailer.digest(window).deliver_now
+    end
+  end
+end
diff --git a/app/mailers/email_digest_mailer.rb b/app/mailers/email_digest_mailer.rb
