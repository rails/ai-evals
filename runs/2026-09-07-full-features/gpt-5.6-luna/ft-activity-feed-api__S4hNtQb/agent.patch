diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..4506462
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,37 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    ACTIONS = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_title_changed
+      card_triaged
+      card_sent_back_to_triage
+      comment_created
+    ].freeze
+
+    def activities
+      scope = Current.user.accessible_events
+        .where(action: ACTIONS)
+        .where(board_id: Current.user.boards.where(account: Current.account).select(:id))
+        .includes(:creator, :board, eventable: :card)
+        .order(created_at: :desc, id: :desc)
+
+      scope = scope.where(creator_id: activity_params[:creator_ids]) if activity_params[:creator_ids].present?
+      scope = scope.where(board_id: activity_params[:board_ids]) if activity_params[:board_ids].present?
+      scope
+    end
+
+    def activity_params
+      params.permit(creator_ids: [], board_ids: [])
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..edfd4ae
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,34 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars do
+    details = event.particulars || {}
+    details = details["particulars"] || details
+
+    case event.action.to_s
+    when "card_assigned", "card_unassigned"
+      json.assignee_ids Array(details["assignee_ids"] || event.assignee_ids)
+    when "card_board_changed"
+      json.old_board details.fetch("old_board", "") || ""
+      json.new_board details.fetch("new_board", "") || ""
+    when "card_title_changed"
+      json.old_title details.fetch("old_title", "") || ""
+      json.new_title details.fetch("new_title", "") || ""
+    when "card_triaged"
+      json.column details.fetch("column", "") || ""
+    end
+  end
+
+  json.url(event.action.comment_created? ? card_comment_url(event.eventable.card, event.eventable) : card_url(event.eventable))
+  json.eventable_type event.eventable_type
+  json.eventable do
+    if event.eventable_type == "Comment"
+      json.partial! "cards/comments/comment", comment: event.eventable
+    else
+      json.partial! "cards/card", card: event.eventable
+    end
+  end
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
