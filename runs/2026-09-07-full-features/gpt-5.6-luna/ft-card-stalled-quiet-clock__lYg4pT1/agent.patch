new file mode 100644
index 0000000..e8606e8
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,29 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) {
+      where.not(burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def mark_burst!
+    update!(burst_at: Time.current) if burst_at.nil?
+  end
+
+  def mark_burst_from_comments!(through: Time.current)
+    window = through - (board.auto_postpone_period / 3.0).seconds
+    qualifying_comments = comments.by_user.where(created_at: window..through)
+
+    if qualifying_comments.count >= BURST_COMMENT_COUNT && qualifying_comments.distinct.count(:creator_id) >= 2
+      mark_burst!
+    end
+  end
+end
