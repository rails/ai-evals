diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..3eac951
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(status: :published, creator: users(:david))
+  end
+
+  test "three comments from two people in a third of the auto-close period create a burst" do
+    now = Time.current
+    travel_to now do
+      @card.comments.create!(body: "one", creator: users(:david), created_at: now - 2.days)
+      @card.comments.create!(body: "two", creator: users(:kevin), created_at: now - 1.day)
+      @card.comments.create!(body: "three", creator: users(:david), created_at: now)
+    end
+
+    assert @card.reload.burst_at
+    assert_not @card.stalled?
+  end
+
+  test "assignment and reopening create a burst" do
+    @card.toggle_assignment(users(:kevin))
+    assert @card.reload.burst_at
+
+    other = boards(:writebook).cards.create!(status: :published, creator: users(:david))
+    other.close
+    other.reopen
+    assert other.reload.burst_at
+  end
+
+  test "a burst is stalled after two weeks without activity and activity resets it" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago - 1.minute)
+    assert @card.reload.stalled?
+    assert_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+
+    @card.touch_last_active_at
+    assert_not @card.reload.stalled?
+    assert_not_includes users(:david).filters.new(indexed_by: "stalled").cards, @card
+  end
+end
