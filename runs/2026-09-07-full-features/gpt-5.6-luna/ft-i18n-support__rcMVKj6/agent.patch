index 0000000..d6dbbf4
--- /dev/null
+++ b/app/mailers/concerns/localized_mailers.rb
@@ -0,0 +1,11 @@
+module LocalizedMailers
+  private
+    def localized_mail(user, subject:, **values)
+      locale = user&.locale.presence || :en
+      I18n.with_locale(locale) { mail(to: user.identity.email_address, subject: I18n.t(subject, **values)) }
+    end
+
+    def localized_mail_to(email, locale:, subject:, **values)
+      I18n.with_locale(locale.presence || :en) { mail(to: email, subject: I18n.t(subject, **values)) }
+    end
+end
