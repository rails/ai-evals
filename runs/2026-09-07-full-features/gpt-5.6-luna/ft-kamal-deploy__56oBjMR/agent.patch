+# Copy this file to .kamal/secrets and replace every value with a real secret.
+# The registry values may also be exported in the shell running Kamal.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..9cf7a07
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,50 @@
+# Deploy Fizzy to one Linux host running Docker.
+# Replace the hostname and registry values below (or provide the matching
+# environment variables) before running `bin/kamal setup`.
+service: fizzy
+image: <%= ENV.fetch("KAMAL_IMAGE", "fizzy") %>
+
+servers:
+  web:
+    hosts:
+      - your-fizzy.example.com
+
+proxy:
+  ssl: true
+  host: your-fizzy.example.com
+
+# SQLite databases and local Active Storage files all live below this path.
+# Keeping this named volume is what makes data survive image replacement.
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    RAILS_ENV: production
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: true
+    APP_HOST: your-fizzy.example.com
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: your-fizzy.example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    MAILER_FROM_ADDRESS: Fizzy <noreply@your-fizzy.example.com>
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+registry:
+  server: <%= ENV.fetch("KAMAL_REGISTRY_SERVER", "ghcr.io") %>
+  username: <%= ENV.fetch("KAMAL_REGISTRY_USERNAME", "your-github-username") %>
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse /bin/bash
