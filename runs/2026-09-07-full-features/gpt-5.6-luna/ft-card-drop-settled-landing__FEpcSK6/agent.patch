diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..32b5d56
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,88 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Moves cards in the DOM first. The request is deliberately not submitted through
+// Turbo: a drag should never wait for (or be rearranged by) a response.
+export default class extends Controller {
+  connect() {
+    this.draggedCard = null
+  }
+
+  dragstart(event) {
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    card.classList.add("drag-and-drop__dragged-item")
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  dragend() {
+    this.clearHover()
+    this.draggedCard?.classList.remove("drag-and-drop__dragged-item")
+    this.draggedCard = null
+  }
+
+  dragover(event) {
+    const target = this.dropTarget(event.target)
+    if (!target || !this.draggedCard || target.contains(this.draggedCard)) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.clearHover(target)
+    target.classList.add("drag-and-drop__hover-container")
+  }
+
+  dragleave(event) {
+    const target = this.dropTarget(event.target)
+    if (target && !target.contains(event.relatedTarget)) target.classList.remove("drag-and-drop__hover-container")
+  }
+
+  drop(event) {
+    event.preventDefault()
+    const target = this.dropTarget(event.target)
+    if (!target || !this.draggedCard || target.contains(this.draggedCard)) return
+
+    const list = target.querySelector(".cards__list")
+    if (!list) return
+
+    const source = this.draggedCard.closest(".cards")
+    const url = target.dataset.dragAndDropUrl
+    const method = target.dataset.dragAndDropMethod || "POST"
+    const cardNumber = this.draggedCard.dataset.cardNumber
+    const requestUrl = url?.replace("__CARD__", cardNumber)
+
+    // Appending is intentional: cards can move between columns, but never within
+    // a column. No sorting or placeholder is introduced while dragging.
+    list.append(this.draggedCard)
+    target.classList.remove("drag-and-drop__hover-container")
+    this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+    this.send(requestUrl, method)
+    this.draggedCard = null
+
+    // Keep the source's card count in sync without triggering a reload.
+    source?.querySelector("[style*='--card-count']")?.style.setProperty("--card-count", source.querySelectorAll(".cards__list .card").length)
+  }
+
+  dropTarget(element) {
+    return element?.closest(".cards[data-drag-and-drop-url]")
+  }
+
+  clearHover(except = null) {
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach((target) => {
+      if (target !== except) target.classList.remove("drag-and-drop__hover-container")
+    })
+  }
+
+  async send(url, method) {
+    if (!url) return
+    await fetch(url, {
+      method,
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']")?.content || ""
+      },
+      credentials: "same-origin"
+    })
+  }
+}
