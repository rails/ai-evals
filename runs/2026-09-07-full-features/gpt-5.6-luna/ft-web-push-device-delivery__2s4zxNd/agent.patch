+
+  def push_payload
+  title = card.title.presence || "Card #{card.number}"
+  if source_type == "Event"
+    action = source.action.to_s
+    title = "RE: #{title}" if action == "comment_created"
+    body = case action
+    when "card_assigned" then "Assigned to #{source.assignees.none? ? "self" : source.assignees.pluck(:name).to_sentence}"
+    when "card_closed" then "Moved to Done by #{creator.name}"
+    when "card_reopened" then "Reopened by #{creator.name}"
+    when "card_published" then "Added by #{creator.name}"
+    when "comment_created" then source.eventable.body.to_plain_text.truncate(200)
+    else creator.name
+    end
+  else
+    title = "#{source.mentioner.first_name} @mentioned you"
+    body = source.source.mentionable_content.to_plain_text.truncate(200)
   end
+  { title: title, body: body, url: Rails.application.routes.url_helpers.card_path(card) }
+end
 
   private
     def set_card
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..bef1121
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,16 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  def deliver(message)
+    WebPush.payload_send(
+      endpoint: endpoint,
+      message: message.to_json,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY") }
+    )
+  end
+end
