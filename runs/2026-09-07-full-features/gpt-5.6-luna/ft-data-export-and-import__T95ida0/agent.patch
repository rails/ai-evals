@@ -1,5 +1,5 @@
 class Account::DataTransfer::RecordSet
-  INTERNAL_RECORD_TYPES = %w[Export].freeze
+  INTERNAL_RECORD_TYPES = %w[Export Import].freeze
 
   attr_reader :account, :model, :attributes
 
@@ -9,6 +9,22 @@ class Account::DataTransfer::RecordSet
     @attributes = (attributes || model.column_names).map(&:to_s)
   end
 
+  def each_record
+    return enum_for(__method__) unless block_given?
+
+    records.find_each(batch_size: 1_000) { |record| yield record }
+  end
+
+  def each_json
+    return enum_for(__method__) unless block_given?
+
+    each_record { |record| yield JSON.generate(attributes.index_with { |attribute| record.public_send(attribute) }) << "\n" }
+  end
+
+  def write_to(zip)
+    zip.add_file("records/#{model_dir}.jsonl") { |sink| each_json { |line| sink.write(line) } }
+  end
+
   private
     attr_reader :zip
 
