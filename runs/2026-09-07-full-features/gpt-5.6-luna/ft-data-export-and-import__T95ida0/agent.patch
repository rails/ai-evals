--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,19 @@
+class Account::DataTransfer::Exporter
+  def initialize(account)
+    @account = account
+  end
+
+  def write_to(zip)
+    zip.add_file("manifest.json", JSON.generate(version: 1, name: @account.name, exported_at: Time.current.iso8601))
+    Account::DataTransfer::Manifest.new(@account).each_record_set { |set| set.write_to(zip) }
+    attachment_set.each_record do |attachment|
+      blob = attachment.blob
+      zip.add_file("files/#{blob.key}") { |sink| blob.download { |chunk| sink.write(chunk) } }
+    end
+  end
+
+  private
+    def attachment_set
+      Account::DataTransfer::ActiveStorage::AttachmentRecordSet.new(@account)
+    end
+end
