diff --git a/app/jobs/export_job.rb b/app/jobs/export_job.rb
new file mode 100644
index 0000000..e9dfd7e
--- /dev/null
+++ b/app/jobs/export_job.rb
@@ -0,0 +1,41 @@
+class ExportJob < ApplicationJob
+  def perform(export)
+    export.processing!
+    Tempfile.create([ "fizzy-export", ".zip" ]) do |file|
+      file.binmode
+      writer = ZipFile::Writer.new(file)
+      if export.account?
+        Account::DataTransfer::Exporter.new(export.account).write_to(writer)
+      else
+        export.user.accessible_cards.preloaded.find_each do |card|
+          writer.add_file("cards/#{card.number}.json", JSON.generate(CardExport.new(card).as_json))
+          card.attachments.each do |attachment|
+            writer.add_file("cards/#{card.number}/files/#{attachment.filename}") { |sink| attachment.blob.download { |chunk| sink.write(chunk) } }
+          end
+        end
+      end
+      writer.close
+      file.rewind
+      export.file.attach(io: file, filename: "fizzy-#{export.kind}-export.zip", content_type: "application/zip")
+    end
+    export.update!(status: :completed, expires_at: 1.day.from_now)
+    DataTransferMailer.export_ready(export).deliver_later
+  rescue => error
+    export.update(status: :failed, error: "#{error.class}: #{error.message}")
+    DataTransferMailer.export_failed(export).deliver_later
+    raise
+  end
+end
+
+class CardExport
+  def initialize(card)
+    @card = card
+  end
+
+  def as_json(*)
+    { id: @card.id, number: @card.number, title: @card.title, description: @card.description.to_s,
+      status: @card.status, created_at: @card.created_at, updated_at: @card.updated_at,
+      comments: @card.comments.chronologically.map { |comment| { id: comment.id, body: comment.body.to_s,
+        creator_id: comment.creator_id, created_at: comment.created_at } } }
+  end
+end
diff --git a/app/jobs/import_job.rb b/app/jobs/import_job.rb
new file mode 100644
index 0000000..ce25be0
--- /dev/null
+++ b/app/jobs/import_job.rb
@@ -0,0 +1,62 @@
+class ImportJob < ApplicationJob
+  class Archive
+    def initialize(file, entries); @file, @entries = file, entries; end
+    def glob(pattern); @entries.map(&:filename).select { |name| File.fnmatch(pattern, name) }; end
+    def read(path)
+      entry = @entries.find { |candidate| candidate.filename == path }
+      raise "Missing archive entry: #{path}" unless entry
+      reader = entry.extractor_from(@file); output = +""
+      output << reader.extract(1.megabyte) until reader.eof?; output
+    end
+  end
+
+  def perform(import)
+    import.processing!
+    account = nil
+    ActiveRecord::Base.transaction do
+      account = Account.create!(name: import_manifest(import).fetch("name", "Imported account"))
+      import_records(import, account)
+    end
+    import.update!(status: :completed)
+    DataTransferMailer.import_ready(import, account).deliver_later
+  rescue => error
+    import.update(status: :failed, error: "#{error.class}: #{error.message}")
+    DataTransferMailer.import_failed(import).deliver_later
+    raise
+  end
+
+  private
+    def import_manifest(import)
+      read_zip(import) { |zip| JSON.parse(zip.read("manifest.json")) }
+    end
+
+    def import_records(import, account)
+      # The account record is deliberately not copied: creating a fresh account is
+      # what makes a failed import atomic and prevents tenant ID collisions.
+      read_zip(import) do |zip|
+        zip.glob("records/*.jsonl").each do |path|
+          table = File.basename(path, ".jsonl")
+          next if table == "accounts"
+          model = table.classify.safe_constantize
+          next unless model && model.column_names.include?("account_id")
+          zip.read(path).each_line do |line|
+            values = JSON.parse(line).slice(*model.column_names)
+            values["account_id"] = account.id
+            values.delete("id")
+            values.delete("created_at")
+            values.delete("updated_at")
+            model.create!(values)
+          end
+        end
+      end
+    end
+
+    def read_zip(import)
+      Tempfile.create([ "fizzy-import", ".zip" ]) do |file|
+        import.file.download { |chunk| file.write(chunk) }
+        file.rewind
+        entries = ZipKit::FileReader.new.read_zip_structure(io: file)
+        yield Archive.new(file, entries)
+      end
+    end
+end
diff --git a/app/mailers/data_transfer_mailer.rb b/app/mailers/data_transfer_mailer.rb
