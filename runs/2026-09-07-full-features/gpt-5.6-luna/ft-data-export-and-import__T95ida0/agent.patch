--- /dev/null
+++ b/app/mailers/data_transfer_mailer.rb
@@ -0,0 +1,21 @@
+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    mail(to: export.user.identity.email_address, subject: "Your Fizzy export is ready")
+  end
+
+  def export_failed(export)
+    @export = export
+    mail(to: export.user.identity.email_address, subject: "Your Fizzy export failed")
+  end
+
+  def import_ready(import, account)
+    @import, @account = import, account
+    mail(to: import.user.identity.email_address, subject: "Your Fizzy import is ready")
+  end
+
+  def import_failed(import)
+    @import = import
+    mail(to: import.user.identity.email_address, subject: "Your Fizzy import failed")
+  end
+end
