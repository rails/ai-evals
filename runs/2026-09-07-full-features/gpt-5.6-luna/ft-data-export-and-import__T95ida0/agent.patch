+class Account::ExportsController < ApplicationController
+  before_action :set_account
+  before_action :ensure_admin, only: :create, if: -> { params[:kind] != "cards" }
+
+  def create
+    export = @account.exports.create!(user: Current.user, kind: params[:kind] == "cards" ? :cards : :account)
+    ExportJob.perform_later(export)
+    redirect_back fallback_location: account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready."
+  end
+
+  def show
+    export = @account.exports.available.find(params[:id])
+    redirect_to rails_blob_path(export.file, disposition: "attachment")
+  end
+
+  private
+    def set_account
+      @account = Current.account
+    end
+end
