diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..41a88fe
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,101 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Moves cards in the DOM first, then persists the destination.  Columns are
+// deliberately only drop targets; cards are never sortable within a column.
+export default class extends Controller {
+  static classes = ["draggedItem", "hoverContainer"]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceList = null
+  }
+
+  dragstart(event) {
+    const card = event.target.closest("[data-card-drag-url]")
+    if (!card) return
+
+    this.draggedCard = card
+    this.sourceList = card.parentElement
+    card.classList.add(this.draggedItemClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  dragover(event) {
+    const column = event.target.closest("[data-drop-destination]")
+    if (!this.draggedCard || !column || column === this.draggedCard.closest("[data-drop-destination]")) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.clearHover()
+    column.classList.add(this.hoverContainerClass)
+  }
+
+  dragleave(event) {
+    const column = event.target.closest("[data-drop-destination]")
+    if (column && !column.contains(event.relatedTarget)) column.classList.remove(this.hoverContainerClass)
+  }
+
+  drop(event) {
+    event.preventDefault()
+    const column = event.target.closest("[data-drop-destination]")
+    if (!this.draggedCard || !column) return
+
+    const card = this.draggedCard
+    const sourceList = this.sourceList
+    const sourceColumn = card.closest("[data-drop-destination]")
+    this.clearHover()
+    this.resetDragState()
+
+    if (!sourceColumn || sourceColumn.dataset.dropDestination === column.dataset.dropDestination) return
+
+    const destinationList = column.querySelector(".cards__list") || column.querySelector("turbo-frame") || column
+    destinationList.append(card)
+    this.persist(card, column, sourceList, sourceColumn)
+  }
+
+  dragend() {
+    this.clearHover()
+    if (this.draggedCard) this.draggedCard.classList.remove(this.draggedItemClass)
+    this.resetDragState()
+  }
+
+  clearHover() {
+    this.element.querySelectorAll(`.${this.hoverContainerClass}`).forEach((column) => column.classList.remove(this.hoverContainerClass))
+  }
+
+  resetDragState() {
+    this.draggedCard = null
+    this.sourceList = null
+  }
+
+  async persist(card, column, sourceList, sourceColumn) {
+    const [url, method] = this.destinationRequest(card, column)
+    try {
+      const response = await fetch(url, {
+        method,
+        credentials: "same-origin",
+        headers: {
+          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
+          Accept: "application/json"
+        }
+      })
+      if (!response.ok) throw new Error(`Card move failed (${response.status})`)
+    } catch (error) {
+      sourceList.append(card)
+      card.dataset.cardDestination = sourceColumn.dataset.dropDestination
+      console.error(error)
+    }
+  }
+
+  destinationRequest(card, column) {
+    const destination = column.dataset.dropDestination
+    if (destination === "maybe") return [card.dataset.cardTriageUrl, "DELETE"]
+    if (destination === "not-now") return [card.dataset.cardNotNowUrl, "POST"]
+    if (destination === "closed") return [card.dataset.cardClosureUrl, "POST"]
+
+    const url = new URL(card.dataset.cardTriageUrl, window.location.origin)
+    url.searchParams.set("column_id", destination)
+    return [url, "POST"]
+  }
+}
