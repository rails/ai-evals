--- /dev/null
+++ b/app/jobs/email_digest_job.rb
@@ -0,0 +1,9 @@
+class EmailDigestJob < ApplicationJob
+  def perform(notification = nil)
+    if notification
+      EmailDigest.open_for(notification)
+    else
+      EmailDigest.due.find_each(&:deliver)
+    end
+  end
+end
diff --git a/app/mailers/email_digest_mailer.rb b/app/mailers/email_digest_mailer.rb
new file mode 100644
index 0000000..132d646
--- /dev/null
+++ b/app/mailers/email_digest_mailer.rb
@@ -0,0 +1,8 @@
+class EmailDigestMailer < ApplicationMailer
+  def digest(email_digest)
+    @digest = email_digest
+    @user = email_digest.user
+    @notifications = email_digest.notifications.preloaded.order(:created_at)
+    mail to: @user.identity.email_address, subject: "Your Fizzy notification digest"
+  end
+end
diff --git a/app/models/email_digest.rb b/app/models/email_digest.rb
new file mode 100644
index 0000000..e1bd41c
--- /dev/null
+++ b/app/models/email_digest.rb
@@ -0,0 +1,38 @@
+class EmailDigest < ApplicationRecord
+  FREQUENCIES = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :due, -> { where(sent_at: nil).where(ends_at: ..Time.current) }
+
+  def self.open_for(notification)
+    user = notification.user
+    frequency = user.settings&.bundle_email_frequency
+
+    if interval = FREQUENCIES[frequency]
+      user.with_lock do
+        now = Time.current
+        digest = where(user: user, sent_at: nil).where("ends_at > ?", now).order(:started_at).first
+        digest ||= create!(account: user.account, user: user, started_at: now, ends_at: now + interval)
+        notification.update!(email_digest: digest)
+        digest
+      end
+    end
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+      if sent_at.nil? && ends_at <= Time.current
+        update!(sent_at: Time.current)
+        EmailDigestMailer.digest(self).deliver_later
+      end
+    end
+  end
+end
