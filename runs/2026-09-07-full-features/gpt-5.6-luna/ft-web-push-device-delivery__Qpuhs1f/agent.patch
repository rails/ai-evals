new file mode 100644
index 0000000..28c7101
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes(subscription_params)
+    subscription.account = Current.account
+    subscription.save!
+    head :no_content
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..7447eba
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["button", "status", "help"]
+  static values = { publicKey: String, userId: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (!("serviceWorker" in navigator) || !("PushManager" in window)) return
+    const registration = await navigator.serviceWorker.register("/service-worker.js")
+    const subscription = await registration.pushManager.getSubscription()
+    this.setState(!!subscription)
+  }
+
+  async toggle() {
+    if (!("Notification" in window)) return
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") { this.setState(false); return }
+
+    const registration = await navigator.serviceWorker.register("/service-worker.js")
+    const subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.decodeKey(this.publicKeyValue) })
+    const json = subscription.toJSON()
+    await fetch(`/users/${this.userIdValue}/push_subscriptions`, {
+      method: "POST", headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content },
+      body: JSON.stringify({ push_subscription: { endpoint: json.endpoint, p256dh_key: json.keys.p256dh, auth_key: json.keys.auth } })
+    })
+    this.setState(true)
+  }
+
+  setState(on) {
+    this.element.classList.toggle("notifications--on", on)
+    if (this.hasButtonTarget) this.buttonTarget.textContent = on ? "Notifications enabled" : "Turn on notifications"
+  }
+
+  decodeKey(key) {
+    const padding = "=".repeat((4 - key.length % 4) % 4)
+    return Uint8Array.from(atob((key + padding).replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push_notification_job.rb b/app/jobs/push_notification_job.rb
new file mode 100644
index 0000000..e021b2c
--- /dev/null
+++ b/app/jobs/push_notification_job.rb
@@ -0,0 +1,31 @@
+class PushNotificationJob < ApplicationJob
+  include NotificationsHelper
+  discard_on ActiveRecord::RecordNotFound
+
+  def perform(notification)
+    return unless ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+
+    notification.user.push_subscriptions.find_each do |subscription|
+      WebPush.payload_send(
+        endpoint: subscription.endpoint, p256dh: subscription.p256dh_key, auth: subscription.auth_key,
+        message: notification_payload(notification).to_json,
+        vapid: { subject: "mailto:#{ENV.fetch("VAPID_SUBJECT", "support@fizzy.do")}", public_key: ENV["VAPID_PUBLIC_KEY"], private_key: ENV["VAPID_PRIVATE_KEY"] }
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      subscription.destroy!
+    end
+  end
+
+  private
+    def notification_payload(notification)
+      { title: notification_title(notification), body: notification_body(notification), url: Rails.application.routes.url_helpers.card_path(notification.card) }
+    end
+
+    def notification_title(notification)
+      notification.source_type == "Mention" ? "#{notification.source.mentioner.first_name} @mentioned you" : event_notification_title(notification.source)
+    end
+
+    def notification_body(notification)
+      notification.source_type == "Mention" ? notification.source.source.mentionable_content.to_plain_text.truncate(200) : event_notification_body(notification.source)
+    end
+end
