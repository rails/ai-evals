diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..c051ab8
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,21 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  def record_failure!
+    now = Time.current
+    if first_failure_at.blank? || first_failure_at < FAILURE_WINDOW.ago
+      update!(consecutive_failures_count: 1, first_failure_at: now)
+    else
+      increment!(:consecutive_failures_count)
+    end
+    webhook.deactivate if consecutive_failures_count >= FAILURE_LIMIT
+  end
+
+  def record_success!
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..3b274d3 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -3,6 +3,8 @@ class Webhook::Delivery < ApplicationRecord
   belongs_to :webhook
   belongs_to :event
 
+  delegate :delinquency_tracker, to: :webhook
+
   store :request, coder: JSON
   store :response, coder: JSON
 
@@ -29,4 +31,69 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+  after_create_commit :enqueue_delivery
+
+  def self.for_event(event)
+    Webhook.active.where(board_id: event.board_id).filter_map do |webhook|
+      next unless Array(webhook.subscribed_actions).include?(event.action.to_s)
+
+      create_or_find_by!(webhook: webhook, event: event)
+    end
+  end
+
+  def self.cleanup
+    where("created_at < ?", 1.week.ago).delete_all
+  end
+
+  def deliver!
+    return unless claim_for_delivery
+
+    timestamp = Time.current.utc.iso8601(3)
+    body = ApplicationController.render(template: "webhooks/event", formats: [ :json ], assigns: { event: event })
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, "#{timestamp}.#{body}")
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => timestamp,
+      "X-Webhook-Signature" => signature
+    }
+    update!(request: { headers: headers })
+
+    uri = URI.parse(webhook.url)
+    response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 10, read_timeout: 30) do |http|
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      http.request(request)
+    end
+    update!(state: :completed, response: { code: response.code.to_i, error: nil })
+    if succeeded?
+      webhook_delinquency_tracker.record_success!
+    else
+      webhook_delinquency_tracker.record_failure!
+    end
+  rescue StandardError => error
+    update!(state: :errored, response: { code: nil, error: "#{error.class}: #{error.message}" })
+    webhook_delinquency_tracker.record_failure!
+  end
+
+  private
+    def webhook_delinquency_tracker
+      webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+    end
+
+    def enqueue_delivery
+      Webhook::DeliveryJob.perform_later(self)
+    end
+
+    def claim_for_delivery
+      self.class.transaction do
+        locked = self.class.lock.find(id)
+        return false unless locked.pending?
+
+        locked.update!(state: :in_progress)
+        true
+      end
+    rescue ActiveRecord::RecordNotFound
+      false
+    end
 end
