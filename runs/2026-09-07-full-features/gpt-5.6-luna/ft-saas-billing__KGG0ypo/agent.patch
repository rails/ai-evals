diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..40f40d5
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,25 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, only: %i[show update destroy comp uncomp]
+  def index = @accounts = Account.order(:name)
+  def show; end
+  def update
+    @account.overridden_limit ? @account.overridden_limit.update!(limit_params) : @account.create_overridden_limit!(limit_params)
+    redirect_to admin_account_path(@account), notice: "Limits overridden"
+  end
+  def destroy
+    @account.overridden_limit&.destroy!
+    redirect_to admin_account_path(@account), notice: "Limits reset"
+  end
+  def comp
+    @account.billing_waiver || @account.create_billing_waiver!
+    redirect_to admin_account_path(@account), notice: "Account comped"
+  end
+  def uncomp
+    @account.billing_waiver&.destroy!
+    redirect_to admin_account_path(@account), notice: "Account uncomped"
+  end
+  private
+  def set_account = @account = Account.find(params[:id])
+  def limit_params = params.expect(account_overridden_limit: %i[card_count bytes_used])
+end
