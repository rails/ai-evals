diff --git a/saas/app/controllers/stripe_controller.rb b/saas/app/controllers/stripe_controller.rb
new file mode 100644
index 0000000..445bbe8
--- /dev/null
+++ b/saas/app/controllers/stripe_controller.rb
@@ -0,0 +1,23 @@
+class StripeController < ApplicationController
+  skip_forgery_protection only: :webhook
+  def checkout
+    session = Stripe::Checkout::Session.create(mode: "subscription", line_items: [{ price: params[:price_id], quantity: 1 }], success_url: account_settings_url, cancel_url: account_settings_url, client_reference_id: Current.account.id.to_s)
+    redirect_to session.url, allow_other_host: true
+  end
+  def portal
+    customer = Current.account.subscription&.stripe_customer_id
+    redirect_to Stripe::BillingPortal::Session.create(customer: customer, return_url: account_settings_url).url, allow_other_host: true
+  end
+  def webhook
+    event = Stripe::Webhook.construct_event(request.body.read, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    object = event.data.object
+    subscription = Account::Subscription.find_by(stripe_subscription_id: object.id) || Account::Subscription.find_by(stripe_customer_id: object.customer)
+    if subscription
+      key = { "active" => "unlimited", "trialing" => "unlimited", "past_due" => "unlimited" }.fetch(object.status, "free")
+      subscription.update!(plan_key: key, status: object.status, current_period_end: Time.at(object.current_period_end))
+    end
+    head :ok
+  rescue Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..54cac3e
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,25 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+  def billing_subscription
+    subscription || Account::Subscription.new(plan_key: "free")
+  end
+  def plan_key = billing_subscription.plan_key
+  def plan = billing_subscription.plan
+  def paid? = billing_subscription.paid?
+  def card_limit = overridden_limit&.card_count || plan[:cards]
+  def storage_limit = overridden_limit&.bytes_used || plan[:storage]
+  def card_limit_reached? = card_limit != Float::INFINITY && cards_count >= card_limit
+  def cards_remaining = card_limit == Float::INFINITY ? Float::INFINITY : [card_limit - cards_count, 0].max
+end
+
+# Billing overrides the legacy Queenbee compatibility methods in SaaS mode.
+module Account::Billing
+  def comped?
+    billing_waiver.present?
+  end
+end
