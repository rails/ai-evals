diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..0405e3b
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,11 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+  PLANS = {
+    "free" => { name: "Free", price: 0, cards: 1_000, storage: 1.gigabyte },
+    "unlimited" => { name: "Unlimited", price: 20, cards: Float::INFINITY, storage: 5.gigabytes },
+    "unlimited_plus" => { name: "Unlimited+", price: 25, cards: Float::INFINITY, storage: 500.gigabytes }
+  }.freeze
+  validates :plan_key, inclusion: { in: PLANS.keys }
+  def plan = PLANS.fetch(plan_key)
+  def paid? = plan_key != "free"
+end
