new file mode 100644
index 0000000..35b6a59
--- /dev/null
+++ b/app/mailers/identity_mailer.rb
@@ -0,0 +1,6 @@
+class IdentityMailer < ApplicationMailer
+  def sign_in_code(email_address:, code:)
+    @code = code
+    mail to: email_address, subject: "Your Fizzy sign-in code is #{code}"
+  end
+end
