diff --git a/app/controllers/sessions/verifications_controller.rb b/app/controllers/sessions/verifications_controller.rb
new file mode 100644
index 0000000..bda430e
--- /dev/null
+++ b/app/controllers/sessions/verifications_controller.rb
@@ -0,0 +1,53 @@
+class Sessions::VerificationsController < ApplicationController
+  include EmailCodeAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  layout "public"
+
+  def new
+    redirect_to new_session_path unless session[:email_code]
+  end
+
+  def create
+    challenge = verify_email_code(params.expect(:code))
+    return invalid_code unless challenge
+
+    identity = if challenge["purpose"] == "sign_in"
+      Identity.find_by(email_address: challenge["email_address"])
+    else
+      Identity.find_or_create_by!(email_address: challenge["email_address"])
+    end
+    return invalid_code unless identity
+    start_new_session_for identity
+
+    case challenge["purpose"]
+    when "signup"
+      redirect_to new_signup_completion_path
+    when "join"
+      complete_join(identity, challenge["join_code_id"])
+    else
+      redirect_to after_authentication_url
+    end
+  rescue ActiveRecord::RecordNotFound
+    invalid_code
+  end
+
+  private
+    def invalid_code
+      flash.now[:alert] = "That code is invalid or has expired."
+      render :new, status: :unprocessable_entity
+    end
+
+    def complete_join(identity, join_code_id)
+      join_code = Account::JoinCode.find(join_code_id)
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      if user.setup?
+        redirect_to landing_url(script_name: join_code.account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+end
