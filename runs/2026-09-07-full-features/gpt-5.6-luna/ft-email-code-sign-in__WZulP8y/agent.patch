@@ -0,0 +1,11 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none">Check your email</h1>
+  <p class="margin-none">Enter the six-character code we sent to <strong><%= session.dig(:email_code, "email_address") %></strong>.</p>
+
+  <%= form_with url: session_verification_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", maxlength: 6, class: "input txt-large full-width", placeholder: "Enter your code" %>
+    <button type="submit" class="btn btn--link center" data-form-target="submit">Continue <%= icon_tag "arrow-right" %></button>
+  <% end %>
+</div>
