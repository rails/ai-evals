new file mode 100644
index 0000000..2495337
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,27 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  EMAIL_CODE_LIFETIME = 15.minutes
+
+  private
+    def send_email_code(email_address:, purpose:, join_code: nil)
+      code = format("%06d", SecureRandom.random_number(1_000_000))
+      session[:email_code] = {
+        "email_address" => email_address,
+        "code_digest" => Digest::SHA256.hexdigest(code),
+        "expires_at" => EMAIL_CODE_LIFETIME.from_now.to_i,
+        "purpose" => purpose.to_s,
+        "join_code_id" => join_code&.id
+      }
+      IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_now
+    end
+
+    def verify_email_code(code)
+      challenge = session[:email_code]
+      return unless challenge && challenge["expires_at"].to_i > Time.current.to_i
+      return unless ActiveSupport::SecurityUtils.secure_compare(challenge["code_digest"], Digest::SHA256.hexdigest(code.to_s.strip))
+
+      session.delete(:email_code)
+      challenge
+    end
+end
