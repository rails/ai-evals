diff --git a/app/jobs/storage_usage_job.rb b/app/jobs/storage_usage_job.rb
new file mode 100644
index 0000000..c80a92e
--- /dev/null
+++ b/app/jobs/storage_usage_job.rb
@@ -0,0 +1,13 @@
+class StorageUsageJob < ApplicationJob
+  queue_as :default
+
+  # Rebuilds the counters from the source of truth. This is deliberately a SQL
+  # operation: attachments can be numerous and this job must not load them all.
+  def perform(board)
+    board = Board.find(board.id)
+    bytes = StorageUsage.bytes_for_board(board.id)
+
+    Board.where(id: board.id).update_all(bytes_used: bytes)
+    StorageUsage.update_account(board.account_id)
+  end
+end
