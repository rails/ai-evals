diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..b0626d7
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,40 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, ->(as_of = Time.current) {
+      where.not(burst_at: nil).where(last_active_at: ..(as_of - STALLED_AFTER))
+    }
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?(as_of: Time.current)
+    burst? && last_active_at <= as_of - STALLED_AFTER
+  end
+
+  # Called by the event callbacks for activity that is itself a burst trigger.
+  def mark_burst!(at: Time.current)
+    update_column(:burst_at, at) if burst_at.nil?
+  end
+
+  # A burst is three comments, by at least two non-system people, in a
+  # sliding window no longer than a third of the board's auto-close period.
+  def consider_comment_burst!(comment)
+    return if burst?
+
+    window = board.auto_postpone_period.to_f / 3
+    return if window <= 0
+
+    recent = comments.by_user
+      .where(created_at: (comment.created_at - window)..comment.created_at)
+      .to_a
+    if recent.length >= 3 && recent.map(&:creator_id).uniq.length >= 2
+      mark_burst!(at: comment.created_at)
+    end
+  end
+end
