@@ -0,0 +1,13 @@
+<% if @magic_link.for_sign_in? %>
+  <h1 class="title">Fizzy確認コード</h1>
+  <p class="subtitle">Fizzyのサインイン画面にこの6文字の確認コードを入力してください。</p>
+<% else %>
+  <h1 class="title">Fizzyへようこそ！</h1>
+  <p class="subtitle">アカウント作成を完了するため、この6文字の確認コードを入力してください。</p>
+<% end %>
+<strong class="txt-large"><%= @magic_link.code %></strong>
+<p>このコードは<%= distance_of_time_in_words(MagicLink::EXPIRATION_TIME) %>有効です。</p>
+<% if account = @magic_link.identity.accounts.last %>
+  <p>より安全ですばやくサインインするには、<%= link_to "パスキー", my_passkeys_url(script_name: account.slug) %>を追加できます。</p>
+<% end %>
+<p class="footer">お困りですか？<%= mail_to "support@fizzy.do", "メールでお問い合わせください" %>。</p>
