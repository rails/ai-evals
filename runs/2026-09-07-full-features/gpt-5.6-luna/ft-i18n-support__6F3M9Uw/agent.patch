diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..3ac413a
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,30 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+
+  included do
+    before_action :set_locale
+    helper_method :locale
+  end
+
+  private
+    def set_locale
+      requested = params[:locale].to_s.downcase
+      if SUPPORTED_LOCALES.include?(requested)
+        session[:locale] = requested
+        Current.identity&.update_column(:locale, requested) if Current.identity
+      end
+
+      I18n.locale = requested_locale
+    end
+
+    def requested_locale
+      candidate = Current.identity&.locale || session[:locale]
+      SUPPORTED_LOCALES.include?(candidate) ? candidate : I18n.default_locale.to_s
+    end
+
+    def locale
+      I18n.locale.to_s
+    end
+end
