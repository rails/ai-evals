diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..3bd81e6
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,27 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:user).order(:created_at).each do |reaction| %>
+      <div class="reaction <%= "reaction--deleteable" if reaction.user == Current.user %>" data-reaction-target="reaction" <% if reaction.user == Current.user %>data-action="click->reaction#toggleDelete"<% end %>>
+        <span class="reaction__form-label txt-small txt-medium" title="<%= reaction.user.name %>"><%= reaction.content %></span>
+        <%= avatar_tag reaction.user, class: "reaction__avatar", hidden_for_screen_reader: true %>
+        <% if reaction.user == Current.user %>
+          <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete, class: "reaction__delete btn btn--plain", data: { action: "click->reaction#stop" } do %>
+            <%= icon_tag "close" %><span class="for-screen-reader">Remove your reaction</span>
+          <% end %>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <div class="reaction__form" data-reaction-target="form">
+    <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "reaction", data: { action: "turbo:submit-end->reaction#submitted" } do |form| %>
+      <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off", aria: { label: "Your reaction" }, data: { reaction_target: "input" } %>
+      <%= form.button class: "reaction__submit-btn btn btn--plain", title: "Confirm reaction" do %><%= icon_tag "check" %><span class="for-screen-reader">Confirm</span><% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--plain" title="Cancel" data-action="reaction#cancel"><%= icon_tag "close" %><span class="for-screen-reader">Cancel</span></button>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction" data-action="reaction#open" data-reaction-target="trigger">
+    <%= image_tag "boost-color.svg", alt: "" %><span class="for-screen-reader">Add a reaction</span>
+  </button>
+</div>
