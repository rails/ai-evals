+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,41 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reaction_owner, only: :destroy
+
+  def create
+    @comment.reactions.create!(reaction_params.merge(user: Current.user))
+    render_reactions
+  end
+
+  def destroy
+    @reaction.destroy!
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reaction_owner
+      head :forbidden unless @reaction.user == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def render_reactions
+      respond_to do |format|
+        format.turbo_stream { render turbo_stream: turbo_stream.replace(dom_id(@comment, :reactions), partial: "cards/comments/reactions", locals: { comment: @comment.reload }) }
+        format.json { render json: @comment.reactions, status: :created }
+      end
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..8f0bd7f
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = ["form", "input", "trigger", "reaction"]
+
+  open() {
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.classList.remove("expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.inputTarget.value = ""
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  toggleDelete(event) {
+    if (event.target.closest("button")) return
+    event.currentTarget.classList.toggle("expanded")
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+}
