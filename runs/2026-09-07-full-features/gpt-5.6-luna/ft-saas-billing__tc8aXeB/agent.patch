--- /dev/null
+++ b/saas/app/controllers/account/billing_controller.rb
@@ -0,0 +1,21 @@
+class Account::BillingController < ApplicationController
+  before_action :ensure_admin
+  def checkout
+    price = params[:plan] == "unlimited_plus" ? ENV.fetch("STRIPE_UNLIMITED_PLUS_PRICE_ID") : ENV.fetch("STRIPE_UNLIMITED_PRICE_ID")
+    session = Stripe::Checkout::Session.create(mode: "subscription", customer: customer_id, line_items: [{ price: price, quantity: 1 }], success_url: account_settings_url, cancel_url: account_settings_url, metadata: { account_id: Current.account.external_account_id })
+    redirect_to session.url, allow_other_host: true
+  end
+  def portal
+    session = Stripe::BillingPortal::Session.create(customer: customer_id, return_url: account_settings_url)
+    redirect_to session.url, allow_other_host: true
+  end
+  private
+  def customer_id
+    Current.account.account_subscription&.stripe_customer_id || begin
+      customer = Stripe::Customer.create(metadata: { account_id: Current.account.external_account_id })
+      subscription = Current.account.account_subscription || Current.account.create_account_subscription!
+      subscription.update!(stripe_customer_id: customer.id)
+      customer.id
+    end
+  end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..e58945e
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,24 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  def index
+    @accounts = Account.order(:name)
+  end
+  def show
+    @account = Account.find(params[:id])
+  end
+  def update
+    account = Account.find(params[:id])
+    account.create_account_overridden_limit!(comped: true) unless account.account_overridden_limit
+    account.account_overridden_limit.update!(limit_params)
+    redirect_to admin_account_path(account), notice: "Limits overridden"
+  end
+  def destroy
+    account = Account.find(params[:id])
+    account.account_overridden_limit&.destroy!
+    redirect_to admin_account_path(account), notice: "Limits reset"
+  end
+  private
+  def limit_params
+    params.require(:account_overridden_limit).permit(:card_count, :bytes_used).transform_values { |v| v.presence && Integer(v) }
+  end
+end
