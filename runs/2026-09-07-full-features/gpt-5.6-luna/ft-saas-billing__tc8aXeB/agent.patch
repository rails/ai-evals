diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..838fa0b
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,25 @@
+class Stripe::WebhooksController < ActionController::API
+  def create
+    payload = request.body.read
+    signature = request.env["HTTP_STRIPE_SIGNATURE"]
+    event = Stripe::Webhook.construct_event(payload, signature, ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    object = event.data.object
+    account = Account.find_by(external_account_id: object.metadata.account_id) if object.metadata&.account_id
+    if account
+      subscription = account.account_subscription || account.create_account_subscription!
+      subscription.update!(plan: plan_for(object), stripe_customer_id: object.customer, stripe_subscription_id: object.id,
+        status: object.status, current_period_end: object.current_period_end && Time.at(object.current_period_end))
+    end
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def plan_for(subscription)
+      price = subscription.items.data.first&.price&.id
+      return "unlimited_plus" if price == ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"]
+      return "unlimited" if price == ENV["STRIPE_UNLIMITED_PRICE_ID"]
+      "free"
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..5b16f9b
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,22 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+  PLANS = { "free" => { name: "Free", price: 0, cards: 1_000, bytes: 1.gigabyte }, "unlimited" => { name: "Unlimited", price: 20, cards: Float::INFINITY, bytes: 5.gigabytes }, "unlimited_plus" => { name: "Unlimited+", price: 25, cards: Float::INFINITY, bytes: 500.gigabytes } }.freeze
+  WARNING_THRESHOLD = 100
+  included do
+    has_one :account_subscription, dependent: :destroy
+    has_one :account_overridden_limit, dependent: :destroy
+  end
+  def billing_plan; PLANS.fetch(account_subscription&.plan || "free"); end
+  alias plan_details billing_plan
+  def plan_name; billing_plan[:name]; end
+  def paid?; account_subscription&.plan.to_s.in?(%w[unlimited unlimited_plus]); end
+  def card_limit; return Float::INFINITY if account_overridden_limit&.comped; account_overridden_limit&.card_count || billing_plan[:cards]; end
+  def storage_limit; return Float::INFINITY if account_overridden_limit&.comped; account_overridden_limit&.bytes_used || billing_plan[:bytes]; end
+  def cards_remaining; return Float::INFINITY if card_limit.infinite?; [card_limit - cards_count, 0].max; end
+  def nearing_card_limit?; !card_limit.infinite? && cards_count >= card_limit - WARNING_THRESHOLD; end
+  def exceeding_card_limit?; !card_limit.infinite? && cards_count >= card_limit; end
+  def exceeding_storage_limit?; bytes_used > storage_limit; end
+  def comped?; account_overridden_limit&.comped? || false; end
+  def comp!; (account_overridden_limit || create_account_overridden_limit!).update!(comped: true); end
+  def uncomp!; account_overridden_limit&.destroy!; end
+end
