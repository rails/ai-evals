new file mode 100644
index 0000000..8ff2787
--- /dev/null
+++ b/app/controllers/search_controller.rb
@@ -0,0 +1,24 @@
+class SearchController < ApplicationController
+  def index
+    @query = params[:q].to_s.strip
+    @cards = @query.present? ? searchable_cards : Card.none
+  end
+
+  private
+    def searchable_cards
+      term = "%#{ActiveRecord::Base.sanitize_sql_like(@query)}%"
+
+      Current.user.accessible_cards
+        .published
+        .where(
+          "cards.title LIKE :term OR cards.id IN (" \
+          "SELECT record_id FROM action_text_rich_texts WHERE record_type = 'Card' AND name = 'description' AND body LIKE :term) OR cards.id IN (" \
+          "SELECT comments.card_id FROM comments INNER JOIN action_text_rich_texts ON action_text_rich_texts.record_id = comments.id " \
+          "AND action_text_rich_texts.record_type = 'Comment' AND action_text_rich_texts.name = 'body' WHERE action_text_rich_texts.body LIKE :term)",
+          term: term
+        )
+        .distinct
+        .includes(:board, :rich_text_description, comments: :rich_text_body)
+        .order(created_at: :desc, id: :desc)
+    end
+end
diff --git a/app/views/search/index.html.erb b/app/views/search/index.html.erb
new file mode 100644
index 0000000..3e25d5a
--- /dev/null
+++ b/app/views/search/index.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% @header_class = "header--events" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search-results margin-inline-auto max-inline-size padding-block">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input flex-item-grow", aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p class="blank-slate">Enter a search term to find cards.</p>
+  <% elsif @cards.empty? %>
+    <p class="blank-slate">No cards match “<%= @query %>”.</p>
+  <% else %>
+    <div class="flex flex-column gap">
+      <% @cards.each do |card| %>
+        <article class="search-result">
+          <h2><%= link_to highlight(card.title.to_s, @query.split), card_path(card) %></h2>
+          <p class="translucent"><%= card.board.name %></p>
+
+          <% description = card.description.to_plain_text %>
+          <% if description.present? && description.match?(/#{Regexp.escape(@query)}/i) %>
+            <p><%= highlight(description, @query.split) %></p>
+          <% end %>
+
+          <% card.comments.each do |comment| %>
+            <% body = comment.body.to_plain_text %>
+            <% if body.present? && body.match?(/#{Regexp.escape(@query)}/i) %>
+              <p class="search-result__comment"><%= highlight(body, @query.split) %></p>
+            <% end %>
+          <% end %>
+        </article>
+      <% end %>
+    </div>
+  <% end %>
+</section>
