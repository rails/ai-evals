index 0000000..4e51fcb
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds published accessible cards and highlights matches" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "h2 a", text: /logo/i
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds matches in descriptions and comments" do
+    cards(:layout).update!(description: "A distinctive marmalade description")
+    comments(:logo_agreement_kevin).update!(body: "A distinctive marmalade comment")
+
+    get search_path(q: "marmalade")
+
+    assert_response :success
+    assert_select "h2 a", count: 2
+    assert_select "mark", text: "marmalade", count: 2
+  end
+
+  test "does not return drafts" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "secret logo")
+
+    get search_path(q: "secret")
+
+    assert_response :success
+    assert_select "h2 a", count: 0
+    assert_not_includes response.body, draft.title
+  end
+end
