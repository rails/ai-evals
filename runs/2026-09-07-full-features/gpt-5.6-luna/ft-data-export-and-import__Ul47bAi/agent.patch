diff --git a/app/services/account/data_transfer/exporter.rb b/app/services/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..b75b465
--- /dev/null
+++ b/app/services/account/data_transfer/exporter.rb
@@ -0,0 +1,13 @@
+class Account::DataTransfer::Exporter
+  def initialize(account, zip); @account, @zip = account, zip; end
+  def call
+    zip.add_file("manifest.json", JSON.generate(version: 1, account_id: account.id, account_name: account.name))
+    Account::DataTransfer::Manifest.new(account).each_record_set { |set| set.export_to(zip) }
+    ActiveStorage::Blob.where(account: account).find_each do |blob|
+      next unless blob.attachments.where.not(record_type: "Export").exists?
+      zip.add_file("files/#{blob.id}/#{blob.filename}", compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+    end
+  end
+  private
+  attr_reader :account, :zip
+end
diff --git a/app/services/account/data_transfer/importer.rb b/app/services/account/data_transfer/importer.rb
new file mode 100644
index 0000000..fc5cc60
--- /dev/null
+++ b/app/services/account/data_transfer/importer.rb
@@ -0,0 +1,32 @@
+require "zip"
+class Account::DataTransfer::Importer
+  def initialize(import); @import = import; end
+  def call
+    file = Tempfile.new(["fizzy-import", ".zip"]); file.binmode
+    import.file.download { |chunk| file.write(chunk) }; file.close
+    Zip::File.open(file.path) do |zip|
+      manifest = JSON.parse(zip.read("manifest.json"))
+      Account.transaction do
+        @account = Account.create_with_owner(account: { name: manifest.fetch("account_name") }, owner: { name: import.requested_by.name })
+        load_users(zip); load_boards(zip); load_columns(zip); load_cards(zip); load_comments(zip)
+      end
+    end
+    account
+  ensure
+    file&.unlink
+  end
+  private
+  attr_reader :import, :account
+  def records(zip, table); zip.glob("#{table}/*.json").map { |e| JSON.parse(zip.read(e.name)) }; end
+  def load_users(zip)
+    @users = {}
+    records(zip, "users").each do |attrs|
+      next if attrs["role"] == "system"
+      user = account.users.create!(attrs.slice("name", "role", "active", "verified_at")); @users[attrs["id"]] = user
+    end
+  end
+  def load_boards(zip); @boards = {}; records(zip, "boards").each { |a| @boards[a["id"]] = account.boards.create!(a.slice("name", "all_access").merge(creator: account.users.first)) }; end
+  def load_columns(zip); @columns = {}; records(zip, "columns").each { |a| @columns[a["id"]] = @boards[a["board_id"]]&.columns&.create!(a.slice("name", "color", "position")) }.compact; end
+  def load_cards(zip); @cards = {}; records(zip, "cards").each { |a| next unless @boards[a["board_id"]]; @cards[a["id"]] = @boards[a["board_id"]].cards.create!(a.slice("title", "status", "due_on").merge(creator: account.users.first)) }; end
+  def load_comments(zip); records(zip, "comments").each { |a| @cards[a["card_id"]]&.comments&.create!(body: a["body"].to_s, creator: account.users.first) }; end
+end
