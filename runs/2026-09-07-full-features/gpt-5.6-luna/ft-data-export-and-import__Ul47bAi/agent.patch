diff --git a/app/controllers/users/exports_controller.rb b/app/controllers/users/exports_controller.rb
new file mode 100644
index 0000000..0928181
--- /dev/null
+++ b/app/controllers/users/exports_controller.rb
@@ -0,0 +1,22 @@
+class Users::ExportsController < ApplicationController
+  def create
+    user = Current.account.users.active.find(params[:user_id])
+    cards = user.accessible_cards.published.includes(:comments, :image_attachment, :rich_text_description)
+    filename = "fizzy-cards-#{user.id}.json"
+    payload = cards.map { |card| card_export(card) }
+    send_data JSON.pretty_generate(payload), filename: filename, type: "application/json", disposition: "attachment"
+  end
+
+  private
+    def card_export(card)
+      { id: card.id, number: card.number, title: card.title, status: card.status,
+        due_on: card.due_on, created_at: card.created_at, updated_at: card.updated_at,
+        description: card.description.to_s,
+        comments: card.comments.includes(:creator).chronologically.map { |comment| {
+          id: comment.id, body: comment.body.to_s, created_at: comment.created_at,
+          creator: comment.creator.name
+        } },
+        files: card.image.attached? ? [{ filename: card.image.filename.to_s, content_type: card.image.content_type,
+          data: Base64.strict_encode64(card.image.download) }] : [] }
+    end
+end
diff --git a/app/jobs/account/export_job.rb b/app/jobs/account/export_job.rb
new file mode 100644
index 0000000..72df1a1
--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,15 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :backend
+  def perform(export)
+    export.update!(status: :processing)
+    Current.with_account(export.account) do
+      ZipFile.create_for(export.file_attachment, filename: "fizzy-export.zip") { |zip| Account::DataTransfer::Exporter.new(export.account, zip).call }
+    end
+    export.update!(status: :completed)
+    AccountMailer.export_ready(export).deliver_later
+  rescue => error
+    export.update(status: :failed, error_message: error.message) if export.persisted?
+    AccountMailer.export_failed(export, error).deliver_later if export.persisted?
+    raise
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..c9757e1
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,13 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :backend
+  def perform(import)
+    import.update!(status: :processing)
+    account = Account::DataTransfer::Importer.new(import).call
+    import.update!(status: :completed)
+    AccountMailer.import_ready(import, account).deliver_later
+  rescue => error
+    import.update(status: :failed, error_message: error.message) if import.persisted?
+    AccountMailer.import_failed(import, error).deliver_later if import.persisted?
+    raise
+  end
+end
