+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,17 @@
+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Current.account.exports.create!(requested_by: Current.user)
+    Account::ExportJob.perform_later(export)
+    redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready."
+  end
+
+  def show
+    export = Current.account.exports.available.find(params[:id])
+    return head(:not_found) unless export.file.signed_id(expires_in: 1.day) == params[:token]
+    send_data export.file.download, filename: "fizzy-export.zip", type: "application/zip", disposition: "attachment"
+  rescue ActiveRecord::RecordNotFound
+    head :not_found
+  end
+end
