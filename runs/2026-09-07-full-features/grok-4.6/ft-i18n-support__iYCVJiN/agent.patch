diff --git a/test/integration/error_pages_locale_test.rb b/test/integration/error_pages_locale_test.rb
new file mode 100644
index 0000000..0d76dd2
--- /dev/null
+++ b/test/integration/error_pages_locale_test.rb
@@ -0,0 +1,11 @@
+require "test_helper"
+
+class ErrorPagesLocaleTest < ActiveSupport::TestCase
+  test "static error pages include English and Japanese" do
+    %w[ 400.html 404.html 422.html 500.html 406-unsupported-browser.html ].each do |page|
+      html = Rails.public_path.join(page).read
+      assert_match(/lang="ja"/, html, "#{page} should include Japanese")
+      assert_match(/Back home/, html, "#{page} should keep English")
+    end
+  end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..202e329
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:jz)
+  end
+
+  test "unrecognized locale param does not change the page language" do
+    untenanted { get new_session_url, params: { locale: "xx" } }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Get into Fizzy", response.body
+    assert_no_match "Fizzyに入る", response.body
+  end
+
+  test "locale=ja switches the page to Japanese" do
+    untenanted { get new_session_url, params: { locale: "ja" } }
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "Fizzyに入る", response.body
+  end
+
+  test "locale choice persists for the rest of the session" do
+    untenanted { get new_session_url, params: { locale: "ja" } }
+    untenanted { get new_session_url }
+
+    assert_select "html[lang=ja]"
+    assert_match "Fizzyに入る", response.body
+  end
+
+  test "locale choice persists on the identity after sign in" do
+    untenanted { get new_session_url, params: { locale: "ja" } }
+    sign_in_as @identity
+
+    assert_equal "ja", @identity.reload.locale
+  end
+
+  test "signed-in identity locale is used from a clean browser" do
+    @identity.update!(locale: "ja")
+
+    sign_in_as @identity
+    get root_url
+
+    assert_select "html[lang=ja]"
+  end
+
+  test "people who never chose a locale keep English" do
+    untenanted { get new_session_url }
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Get into Fizzy", response.body
+    assert_match "Skip to main content", response.body
+  end
+
+  test "magic link email is sent in the identity locale" do
+    @identity.update!(locale: "ja")
+
+    email = MagicLinkMailer.sign_in_instructions(MagicLink.create!(identity: @identity)).deliver_now
+
+    assert_match "Fizzyのコードは", email.subject
+    assert_match "確認コード", email.html_part.decoded
+  end
+end
