diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..4bf494f
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,78 @@
+const BCP47 = { en: "en-US", ja: "ja-JP" }
+
+const STRINGS = {
+  en: {
+    lessThanAMinuteAgo: "Less than a minute ago",
+    yearAgo: "%{count} year ago",
+    yearsAgo: "%{count} years ago",
+    monthAgo: "%{count} month ago",
+    monthsAgo: "%{count} months ago",
+    weekAgo: "%{count} week ago",
+    weeksAgo: "%{count} weeks ago",
+    dayAgo: "%{count} day ago",
+    daysAgo: "%{count} days ago",
+    hourAgo: "%{count} hour ago",
+    hoursAgo: "%{count} hours ago",
+    minuteAgo: "%{count} minute ago",
+    minutesAgo: "%{count} minutes ago",
+    today: "today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    daysAgoCount: "%{count} days ago",
+    inDays: "in %{count} days",
+    todayLabel: "Today",
+    day: "day",
+    days: "days",
+    stalledFor: "Stalled for",
+    pleaseFillOutThisField: "Please fill out this field",
+    backTo: "Back to %{label}",
+    noSelection: "No selection",
+    closesIn: "%{action} in"
+  },
+  ja: {
+    lessThanAMinuteAgo: "1分未満前",
+    yearAgo: "%{count}年前",
+    yearsAgo: "%{count}年前",
+    monthAgo: "%{count}か月前",
+    monthsAgo: "%{count}か月前",
+    weekAgo: "%{count}週間前",
+    weeksAgo: "%{count}週間前",
+    dayAgo: "%{count}日前",
+    daysAgo: "%{count}日前",
+    hourAgo: "%{count}時間前",
+    hoursAgo: "%{count}時間前",
+    minuteAgo: "%{count}分前",
+    minutesAgo: "%{count}分前",
+    today: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    daysAgoCount: "%{count}日前",
+    inDays: "%{count}日後",
+    todayLabel: "今日",
+    day: "日",
+    days: "日",
+    stalledFor: "停滞して",
+    pleaseFillOutThisField: "このフィールドを入力してください",
+    backTo: "%{label}に戻る",
+    noSelection: "未選択",
+    closesIn: "%{action}まで"
+  }
+}
+
+export function pageLocale() {
+  return (document.documentElement.lang || "en").split("-")[0]
+}
+
+export function dateLocale() {
+  const locale = pageLocale()
+  return BCP47[locale] || BCP47.en
+}
+
+export function t(key, interpolations = {}) {
+  const table = STRINGS[pageLocale()] || STRINGS.en
+  let text = table[key] || STRINGS.en[key] || key
+  for (const [name, value] of Object.entries(interpolations)) {
+    text = text.replaceAll(`%{${name}}`, value)
+  }
+  return text
+}
