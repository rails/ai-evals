diff --git a/lib/locale.rb b/lib/locale.rb
new file mode 100644
index 0000000..cebf2c9
--- /dev/null
+++ b/lib/locale.rb
@@ -0,0 +1,17 @@
+module Locale
+  AVAILABLE = %w[ en ja ].freeze
+
+  class << self
+    def available?(locale)
+      AVAILABLE.include?(locale.to_s)
+    end
+
+    def coerce(locale)
+      locale.to_s if available?(locale)
+    end
+
+    def available_symbols
+      AVAILABLE.map(&:to_sym)
+    end
+  end
+end
