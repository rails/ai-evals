diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..23c12f6
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,49 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    after_action :persist_locale, :reset_locale
+    helper_method :current_locale
+    fragment_cache_key { current_locale }
+
+    etag { current_locale }
+  end
+
+  private
+    def set_locale
+      if (requested = Locale.coerce(params[:locale]))
+        session[:locale] = requested
+      end
+
+      I18n.locale = current_locale
+    end
+
+    def persist_locale
+      return unless Current.identity
+
+      if (locale = Locale.coerce(session[:locale]))
+        persist_locale_to_identity(locale)
+      elsif (locale = Locale.coerce(Current.identity.locale))
+        session[:locale] = locale
+      end
+    end
+
+    def current_locale
+      (
+        Locale.coerce(session[:locale]) ||
+        Locale.coerce(Current.identity&.locale) ||
+        I18n.default_locale
+      ).to_sym
+    end
+
+    def persist_locale_to_identity(locale)
+      if Current.identity.locale != locale
+        Current.identity.update!(locale: locale)
+      end
+    end
+
+    def reset_locale
+      I18n.locale = I18n.default_locale
+    end
+end
