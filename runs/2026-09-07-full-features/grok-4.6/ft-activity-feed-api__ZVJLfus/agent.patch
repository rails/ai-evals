@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "activity particulars for assignment events include assignee_ids" do
+    assert_equal(
+      { "assignee_ids" => [ users(:jz).id ] },
+      events(:logo_assignment_jz).activity_particulars
+    )
+  end
+
+  test "activity particulars for other events are empty" do
+    assert_equal({}, events(:logo_published).activity_particulars)
+  end
+
+  test "activity particulars for title changes" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+    event.particulars = { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, event.activity_particulars)
+  end
+
+  test "activity particulars for board changes" do
+    event = events(:logo_published)
+    event.action = "card_board_changed"
+    event.particulars = { "particulars" => { "old_board" => "A", "new_board" => "B" } }
+
+    assert_equal({ "old_board" => "A", "new_board" => "B" }, event.activity_particulars)
+  end
+
+  test "activity particulars for triage events" do
+    event = events(:logo_published)
+    event.action = "card_triaged"
+    event.particulars = { "particulars" => { "column" => "In Progress" } }
+
+    assert_equal({ "column" => "In Progress" }, event.activity_particulars)
+  end
+
+  test "activity particulars use empty strings for missing board title or column values" do
+    event = events(:logo_published)
+    event.particulars = {}
+
+    event.action = "card_title_changed"
+    assert_equal({ "old_title" => "", "new_title" => "" }, event.activity_particulars)
+
+    event.action = "card_board_changed"
+    assert_equal({ "old_board" => "", "new_board" => "" }, event.activity_particulars)
+
+    event.action = "card_triaged"
+    assert_equal({ "column" => "" }, event.activity_particulars)
+  end
+end
