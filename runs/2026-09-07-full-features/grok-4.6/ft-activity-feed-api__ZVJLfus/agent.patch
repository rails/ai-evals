@@ -0,0 +1,44 @@
+require "test_helper"
+
+class User::TimelinedTest < ActiveSupport::TestCase
+  test "activities are newest first and omit collection changed events" do
+    collection_event = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_collection_changed",
+      created_at: 1.minute.from_now
+    )
+    title_event = boards(:writebook).events.create!(
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old", new_title: "New" } },
+      created_at: 2.minutes.from_now
+    )
+
+    activities = users(:kevin).activities.to_a
+
+    assert_equal title_event, activities.first
+    assert_includes activities, title_event
+    assert_not_includes activities, collection_event
+    created_ats = activities.map(&:created_at)
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "activities can be filtered by creator and board" do
+    assert_equal [ users(:kevin).id ], users(:kevin).activities(creator_ids: [ users(:kevin).id ]).map(&:creator_id).uniq
+    assert_equal [ boards(:writebook).id ], users(:kevin).activities(board_ids: [ boards(:writebook).id ]).map(&:board_id).uniq
+  end
+
+  test "activities only include events from accessible boards" do
+    private_event = boards(:private).events.create!(
