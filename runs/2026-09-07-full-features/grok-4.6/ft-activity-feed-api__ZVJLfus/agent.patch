@@ -0,0 +1,256 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body
+    assert json.is_a?(Array)
+    assert json.any?
+
+    event = json.find { |item| item["id"] == events(:layout_assignment_jz).id }
+    assert_not_nil event
+
+    assert_equal events(:layout_assignment_jz).id, event["id"]
+    assert_equal "card_assigned", event["action"]
+    assert_equal events(:layout_assignment_jz).created_at.utc.as_json, event["created_at"]
+    assert_equal events(:layout_assignment_jz).description_for(users(:kevin)).to_plain_text, event["description"]
+    assert_equal [ users(:jz).id ], event["particulars"]["assignee_ids"]
+    assert_equal card_url(cards(:layout)), event["url"]
+    assert_equal "Card", event["eventable_type"]
+    assert_equal cards(:layout).id, event["eventable"]["id"]
+    assert_equal cards(:layout).number, event["eventable"]["number"]
+    assert_equal cards(:layout).title, event["eventable"]["title"]
+    assert_equal boards(:writebook).id, event["board"]["id"]
+    assert_equal boards(:writebook).name, event["board"]["name"]
+    assert_equal users(:david).id, event["creator"]["id"]
+    assert_equal users(:david).name, event["creator"]["name"]
+    assert_equal users(:david).identity.email_address, event["creator"]["email_address"]
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    created_ats = @response.parsed_body.map { |item| item["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON uses card url for card events" do
+    get activities_path, as: :json
+    assert_response :success
+
+    event = @response.parsed_body.find { |item| item["id"] == events(:logo_published).id }
+    assert_equal card_url(cards(:logo)), event["url"]
+  end
+
+  test "index as JSON uses card url with comment anchor for comment events" do
+    get activities_path, as: :json
+    assert_response :success
+
+    event = @response.parsed_body.find { |item| item["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", event["eventable_type"]
+    assert_equal comment.id, event["eventable"]["id"]
+    assert_equal polymorphic_url(comment), event["url"]
+    assert_includes event["url"], ActionView::RecordIdentifier.dom_id(comment)
+  end
+
+  test "index as JSON returns empty particulars for events without details" do
+    get activities_path, as: :json
+    assert_response :success
+
+    event = @response.parsed_body.find { |item| item["id"] == events(:logo_published).id }
+    assert_equal({}, event["particulars"])
+  end
+
+  test "index as JSON includes title change particulars" do
+    event = create_activity_event("card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } })
+
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal "card_title_changed", json["action"]
+    assert_equal "Old", json["particulars"]["old_title"]
+    assert_equal "New", json["particulars"]["new_title"]
+  end
+
+  test "index as JSON includes board change particulars" do
+    event = create_activity_event("card_board_changed", particulars: { particulars: { old_board: "Writebook", new_board: "Private board" } })
+
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal "Writebook", json["particulars"]["old_board"]
+    assert_equal "Private board", json["particulars"]["new_board"]
+  end
+
+  test "index as JSON includes triage column particulars" do
+    event = create_activity_event("card_triaged", particulars: { particulars: { column: "In Progress" } })
+
+    get activities_path, as: :json
+    assert_response :success
+
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal "In Progress", json["particulars"]["column"]
+  end
+
+  test "index as JSON returns empty strings for missing board title or column values" do
+    title_event = create_activity_event("card_title_changed")
+    board_event = create_activity_event("card_board_changed")
+    triage_event = create_activity_event("card_triaged")
+
+    get activities_path, as: :json
+    assert_response :success
+
+    title_json = @response.parsed_body.find { |item| item["id"] == title_event.id }
+    assert_equal "", title_json["particulars"]["old_title"]
+    assert_equal "", title_json["particulars"]["new_title"]
+
+    board_json = @response.parsed_body.find { |item| item["id"] == board_event.id }
+    assert_equal "", board_json["particulars"]["old_board"]
+    assert_equal "", board_json["particulars"]["new_board"]
+
+    triage_json = @response.parsed_body.find { |item| item["id"] == triage_event.id }
+    assert_equal "", triage_json["particulars"]["column"]
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = create_activity_event("card_collection_changed")
+
+    get activities_path, as: :json
+    assert_response :success
+
+    assert_nil @response.parsed_body.find { |item| item["id"] == event.id }
+  end
+
+  test "index as JSON includes card_title_changed events" do
+    event = create_activity_event("card_title_changed", particulars: { particulars: { old_title: "logo", new_title: "Logo" } })
+
+    get activities_path, as: :json
+    assert_response :success
+
+    assert @response.parsed_body.any? { |item| item["id"] == event.id }
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |item| item["creator"]["id"] }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+    assert_includes @response.parsed_body.map { |item| item["id"] }, events(:text_published).id
+    assert_not_includes @response.parsed_body.map { |item| item["id"] }, events(:logo_published).id
+  end
+
+  test "index as JSON can filter by board_ids" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |item| item["board"]["id"] }.uniq
+    assert_equal [ boards(:writebook).id ], board_ids
+    assert_not_includes @response.parsed_body.map { |item| item["id"] }, private_event.id
+  end
+
+  test "index as JSON only returns activity the current user can access" do
+    logout_and_sign_in_as :david
+
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    get activities_path, as: :json
+    assert_response :success
+
+    ids = @response.parsed_body.map { |item| item["id"] }
+    assert_not_includes ids, private_event.id
+    assert_includes ids, events(:logo_published).id
+  end
+
+  test "index as JSON ignores inaccessible board_ids" do
+    logout_and_sign_in_as :david
+
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+
+    ids = @response.parsed_body.map { |item| item["id"] }
+    assert_not_includes ids, private_event.id
+    assert_empty ids
+  end
+
+  test "index as JSON combines creator_ids and board_ids filters" do
+  get activities_path, params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+  assert_response :success
+
+  @response.parsed_body.each do |item|
+    assert_equal users(:kevin).id, item["creator"]["id"]
+    assert_equal boards(:writebook).id, item["board"]["id"]
+  end
+end
+
+test "index as JSON omits card_resumed events" do
+  event = create_activity_event("card_resumed")
+
+  get activities_path, as: :json
+  assert_response :success
+
+  assert_nil @response.parsed_body.find { |item| item["id"] == event.id }
+end
+
+test "index as JSON paginates newest first" do
+    20.times do |index|
+      create_activity_event("card_published", created_at: index.minutes.ago)
+    end
+
+    get activities_path, as: :json
+    assert_response :success
+    assert @response.headers["Link"].present?
+
+    first_page = @response.parsed_body
+    first_page_ids = first_page.map { |item| item["id"] }
+    first_created_ats = first_page.map { |item| item["created_at"] }
+
+    next_page = next_page_from_link_header(@response.headers["Link"])
+    get next_page, as: :json
+    assert_response :success
+
+    second_page = @response.parsed_body
+    assert_empty first_page_ids & second_page.map { |item| item["id"] }
+
+    combined_created_ats = first_created_ats + second_page.map { |item| item["created_at"] }
+    assert_equal combined_created_ats.sort.reverse, combined_created_ats
+  end
+
+  private
+    def create_activity_event(action, particulars: {}, created_at: Time.current, board: boards(:writebook), eventable: cards(:logo), creator: users(:david))
+      board.events.create!(action:, particulars:, created_at:, eventable:, creator:)
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
