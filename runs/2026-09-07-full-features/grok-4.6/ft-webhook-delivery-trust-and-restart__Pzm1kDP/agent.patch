@@ -1,4 +1,21 @@
+require "net/http"
+require "openssl"
+
 class Webhook::Delivery < ApplicationRecord
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  TIMEOUT_ERRORS = [
+    Timeout::Error, Net::OpenTimeout, Net::ReadTimeout, Errno::ETIMEDOUT
+  ].freeze
+
+  UNREACHABLE_ERRORS = [
+    SocketError, Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH,
+    Errno::ENETUNREACH, Errno::EADDRNOTAVAIL, EOFError, IOError,
+    OpenSSL::SSL::SSLError, Net::HTTPBadResponse, URI::InvalidURIError, IPAddr::Error
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +26,29 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...1.week.ago) }
+
+  class << self
+    def cleanup
+      expired.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return unless claim!
+
+    headers = headers_for(body)
+    http_response = post(body, headers)
+    complete headers, http_response
+  rescue *TIMEOUT_ERRORS
+    fail_with "timeout", headers
+  rescue *UNREACHABLE_ERRORS
+    fail_with "destination_unreachable", headers
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +69,81 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim!
+      claimed = self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def body
+      @body ||= Webhook::Payload.new(webhook, event).to_s
+    end
+
+    def headers_for(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      raise SocketError, "destination unreachable" unless public_ip
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = public_ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |key, value| request[key] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def public_ip
+      host = uri.hostname
+
+      if ip_address?(host)
+        host unless SsrfProtection.blocked_address?(host)
+      else
+        SsrfProtection.resolve_public_ip(host)
+      end
+    end
+
+    def ip_address?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def complete(headers, http_response)
+      update!(state: :completed, request: { headers: headers }, response: { code: http_response.code.to_i })
+      record_outcome
+    end
+
+    def fail_with(error, headers)
+      update!(state: :errored, request: ({ headers: headers } if headers), response: { error: error })
+      record_outcome
+    end
+
+    def record_outcome
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+      if succeeded?
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..ceeb19f
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,49 @@
+class Webhook::Payload
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_s
+    if @webhook.for_slack?
+      { text: chat_text }.to_json
+    elsif @webhook.for_campfire?
+      { body: chat_text }.to_json
+    elsif @webhook.for_basecamp?
+      { content: chat_text }.to_json
+    else
+      event_json
+    end
+  end
+
+  private
+    def chat_text
+      [ CGI.unescapeHTML(description), eventable_url ].compact.join("\n")
+    end
+
+    def description
+      @event.description_for(@event.creator).to_plain_text.to_s
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(@event.eventable, **url_options)
+    end
+
+    def event_json
+      ApplicationController.renderer.new(
+        http_host: url_options[:host],
+        script_name: url_options[:script_name]
+      ).render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: @event }
+      )
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      base_options.merge(script_name: @event.account.slug)
+    end
+end
