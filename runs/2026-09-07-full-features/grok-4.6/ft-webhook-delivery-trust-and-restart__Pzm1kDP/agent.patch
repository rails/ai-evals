+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  test "generic payload is the event JSON" do
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+    json = JSON.parse(Webhook::Payload.new(webhook, event).to_s)
+
+    assert_equal event.id, json["id"]
+    assert_equal "card_published", json["action"]
+    assert_equal event.eventable_id, json.dig("eventable", "id")
+    assert_equal event.board_id, json.dig("board", "id")
+    assert_equal event.creator_id, json.dig("creator", "id")
+  end
+
+  test "slack payload uses text" do
+    webhook = webhooks(:active)
+    webhook.url = "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx"
+    event = events(:logo_published)
+    json = JSON.parse(Webhook::Payload.new(webhook, event).to_s)
+
+    assert json["text"].present?
+    assert_includes json["text"], event.eventable.title
+  end
+
+  test "campfire payload uses body" do
+    webhook = webhooks(:active)
+    webhook.url = "https://example.com/rooms/123/456-room-name/messages"
+    event = events(:logo_published)
+    json = JSON.parse(Webhook::Payload.new(webhook, event).to_s)
+
+    assert json["body"].present?
+  end
+
+  test "basecamp payload uses content" do
+    webhook = webhooks(:active)
+    webhook.url = "https://basecamp.com/999/integrations/some-token/buckets/111/chats/222/lines"
+    event = events(:logo_published)
+    json = JSON.parse(Webhook::Payload.new(webhook, event).to_s)
+
+    assert json["content"].present?
+  end
+end
