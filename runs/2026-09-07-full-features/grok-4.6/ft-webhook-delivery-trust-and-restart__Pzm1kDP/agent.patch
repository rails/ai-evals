index 0000000..6c48c25
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  PUBLIC_IP = "93.184.216.34"
+
+  setup do
+    @webhook = webhooks(:active)
+    stub_dns_resolution(PUBLIC_IP)
+  end
+
+  test "creating an event POSTs to subscribed webhooks and logs the delivery" do
+    stub = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    event = nil
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs do
+        event = Event.create!(
+          board: boards(:writebook),
+          creator: users(:david),
+          eventable: cards(:logo),
+          action: "card_published"
+        )
+      end
+    end
+
+    assert_requested stub, times: 1
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal event, delivery.event
+    assert delivery.succeeded?
+  end
+
+  test "does not POST when the webhook is not subscribed to the action" do
+    stub = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        Event.create!(
+          board: boards(:writebook),
+          creator: users(:david),
+          eventable: cards(:logo),
+          action: "card_triaged"
+        )
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "does not POST to inactive webhooks" do
+    webhook = webhooks(:inactive)
+    webhook.update!(subscribed_actions: %w[ card_published ], board: boards(:writebook))
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        Event.create!(
+          board: boards(:writebook),
+          creator: users(:david),
+          eventable: cards(:logo),
+          action: "card_published"
+        )
+      end
+    end
+
+    assert_not_requested stub
+  end
+
+  test "creating the same event twice does not deliver twice" do
+    stub = stub_request(:post, @webhook.url).with(ipaddr: PUBLIC_IP).to_return(status: 200)
+
+    event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_published"
+    )
+
+    perform_enqueued_jobs do
+      event.relay_now
+      event.relay_now
+    end
+
+    assert_requested stub, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
