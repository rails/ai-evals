index 90020f0..c419198 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,14 @@
 module TimeHelper
+  def local_time_tag(time, format: "relative", **options)
+    timestamp = time.to_time.utc.iso8601
+    data = options.delete(:data) || {}
+    data[:controller] = token_list("local-time", data[:controller])
+
+    if format.to_s != "relative"
+      data[:local_time_format_value] = format.to_s
+    end
+
+    tag.time timestamp, class: class_names("local-time-value", options.delete(:class)),
+      datetime: timestamp, data: data, **options
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..1d00d58
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,48 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatClockTime, formatFullDateTime, formatShortDate, formatWeekdayDate, relativeTimeInWords } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.boundRender = this.#render.bind(this)
+    this.#render()
+    document.addEventListener("turbo:morph", this.boundRender)
+    this.#scheduleRefresh()
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:morph", this.boundRender)
+    clearTimeout(this.refreshTimer)
+  }
+
+  #render() {
+    const date = new Date(this.element.dateTime)
+    if (isNaN(date)) return
+
+    this.element.textContent = this.#format(date)
+    this.element.title = formatFullDateTime(date)
+  }
+
+  #format(date) {
+    if (this.formatValue === "time") {
+      return formatClockTime(date)
+    } else if (this.formatValue === "date") {
+      return formatShortDate(date)
+    } else if (this.formatValue === "weekday") {
+      return formatWeekdayDate(date)
+    } else {
+      return relativeTimeInWords(date)
+    }
+  }
+
+  #scheduleRefresh() {
+    const now = new Date()
+    const nextMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1)
+
+    this.refreshTimer = setTimeout(() => {
+      this.#render()
+      this.#scheduleRefresh()
+    }, nextMidnight - now)
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..46014b6 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -9,6 +9,58 @@ export function beginningOfDay(date) {
   return new Date(Date.UTC(year, month - 1, day))
 }
 
+export function relativeTimeInWords(date, now = new Date()) {
+  const days = signedLocalDayDifference(now, date)
+
+  if (days === 0) {
+    if (date < now) {
+      return formatClockTime(date)
+    } else {
+      return "today"
+    }
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days > -7) {
+    return `${-days} days ago`
+  } else {
+    return formatShortDate(date, now)
+  }
+}
+
+export function formatClockTime(date) {
+  return date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
+}
+
+export function formatShortDate(date, now = new Date()) {
+  const options = { month: "short", day: "numeric" }
+
+  if (date.getFullYear() !== now.getFullYear()) {
+    options.year = "numeric"
+  }
+
+  return date.toLocaleDateString("en-US", options)
+}
+
+export function formatWeekdayDate(date) {
+  return date.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })
+}
+
+export function formatFullDateTime(date) {
+  return date.toLocaleString("en-US", { dateStyle: "full", timeStyle: "short" })
+}
+
+function signedLocalDayDifference(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
 // Snap a timestamp to midnight using the timezone the server rendered with (the
 // `timezone` meta tag), so client day boundaries match the server's instead of
 // following the browser's resolved timezone, which can differ in a PWA.
