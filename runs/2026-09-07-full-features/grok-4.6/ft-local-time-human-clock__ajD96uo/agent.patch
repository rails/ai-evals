diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..4f0664b
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "local_time_tag sends the raw timestamp for the browser to format" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+    html = parse(local_time_tag(time))
+
+    assert_select html, "time.local-time-value" do |elements|
+      element = elements.first
+      assert_equal "2024-09-12T17:42:00Z", element["datetime"]
+      assert_equal "local-time", element["data-controller"]
+      assert_equal "2024-09-12T17:42:00Z", element.text
+      assert_nil element["data-local-time-format-value"]
+    end
+  end
+
+  test "local_time_tag accepts a format for absolute dates and times" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+    html = parse(local_time_tag(time, format: :date, class: "card__timestamp"))
+
+    assert_select html, "time.local-time-value.card__timestamp" do |elements|
+      element = elements.first
+      assert_equal "date", element["data-local-time-format-value"]
+      assert_equal "local-time", element["data-controller"]
+    end
+  end
+
+  test "local_time_tag merges extra stimulus controllers" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+    html = parse(local_time_tag(time, data: { controller: "tooltip" }))
+
+    assert_select html, "time[data-controller='local-time tooltip']"
+  end
+
+  test "local_time_tag always emits UTC so HTML can be cached across timezones" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    eastern = Time.use_zone("America/New_York") { local_time_tag(time) }
