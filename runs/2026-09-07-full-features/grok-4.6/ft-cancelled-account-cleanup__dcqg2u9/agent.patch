diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..c9051be
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes data for accounts cancelled more than 30 days ago" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: users(:mike))
+    account.cancellation.update_column(:created_at, 31.days.ago)
+
+    user_id = users(:mike).id
+    board_id = boards(:miltons_wish_list).id
+    other_account = accounts("37s")
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not User.exists?(user_id)
+    assert_not Board.exists?(board_id)
+    assert Account.exists?(other_account.id)
+  end
+
+  test "does not remove accounts cancelled within the grace period" do
+    account = accounts(:initech)
+    account.cancel(initiated_by: users(:mike))
+    account.cancellation.update_column(:created_at, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "does not remove active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..09fb568
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+    assert @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes recently cancelled accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 29.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate destroys a due account and its associated data" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, 31.days.ago)
+
+    user_id = @user.id
+    board_id = boards(:miltons_wish_list).id
+    card_id = cards(:radio).id
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(user_id)
+    assert_not Board.exists?(board_id)
+    assert_not Card.exists?(card_id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+  end
+
+  test "incinerate does nothing when the account is not due" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due incinerates only accounts past the grace period" do
+    due = @account
+    due.cancel(initiated_by: @user)
+    due.cancellation.update_column(:created_at, 31.days.ago)
+
+    recent = accounts(:acme)
+    recent.cancel(initiated_by: users(:david))
+    recent.cancellation.update_column(:created_at, 29.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(recent.id)
+    assert Account.exists?(accounts("37s").id)
+  end
+
+  test "incinerate after traveling past the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    travel 1.second
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+  end
+end
