+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as users(:kevin)
+  end
+
+  test "admin can request an account export" do
+    assert_enqueued_jobs 1, only: ExportJob do
+      assert_difference -> { Export.count }, 1 do
+        post account_exports_url
+      end
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "We'll email you a download link when your export is ready.", flash[:notice]
+    assert Export.last.kind_account?
+  end
+
+  test "member cannot request an account export" do
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+end
