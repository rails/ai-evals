diff --git a/app/models/zip_file/entry_io.rb b/app/models/zip_file/entry_io.rb
new file mode 100644
index 0000000..1653cbd
--- /dev/null
+++ b/app/models/zip_file/entry_io.rb
@@ -0,0 +1,45 @@
+class ZipFile::EntryIO
+  def initialize(extractor)
+    @extractor = extractor
+    @buffer = +"".b
+  end
+
+  def read(length = nil, buf = nil)
+    data = if length.nil?
+      fill_buffer until source_eof?
+      take(@buffer.bytesize)
+    else
+      fill_buffer while @buffer.bytesize < length && !source_eof?
+      take(length)
+    end
+
+    if buf
+      buf.replace(data.to_s)
+      buf
+    else
+      data
+    end
+  end
+
+  def eof?
+    @buffer.empty? && source_eof?
+  end
+
+  def binmode
+    self
+  end
+
+  private
+    def fill_buffer
+      chunk = @extractor.extract(64.kilobytes)
+      @buffer << chunk if chunk
+    end
+
+    def source_eof?
+      @extractor.eof?
+    end
+
+    def take(n)
+      @buffer.slice!(0, n)
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..f04ff71
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,26 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: @io).index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read(path)
+    buffer = +"".b
+    open_entry(path) { |io| buffer << io.read }
+    buffer
+  end
+
+  def open_entry(path)
+    entry = @entries.fetch(path)
+    extractor = entry.extractor_from(@io)
+    yield ZipFile::EntryIO.new(extractor)
+  end
+end
