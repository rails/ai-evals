+    def portableize_attachment(node)
+      if sgid = node["sgid"]
+        if parsed = SignedGlobalID.parse(sgid, for: ActionText::Attachable::LOCATOR_NAME)
+          node["sgid"] = parsed.uri.to_s
+          if parsed.model_name == "ActiveStorage::Blob"
+            node["url"] = "#{PORTABLE_BLOB_URL_PREFIX}#{parsed.model_id}"
+          end
+        end
+      end
+    end
+
+    def restore_attachment(node)
+      if sgid = node["sgid"]
+        if gid = GlobalID.parse(sgid)
+          new_id = id_map.fetch(gid.model_id, gid.model_id)
+          locator = gid.model_name.constantize.new(id: new_id)
+          node["sgid"] = locator.to_sgid(expires_in: nil, for: ActionText::Attachable::LOCATOR_NAME).to_s
+
+          if gid.model_name == "ActiveStorage::Blob"
+            blob = ActiveStorage::Blob.new(id: new_id)
+            node["url"] = Rails.application.routes.url_helpers.polymorphic_url(
+              blob, only_path: true, script_name: account.slug
+            )
+          end
+        end
+      elsif node["url"].to_s.start_with?(PORTABLE_BLOB_URL_PREFIX)
+        old_id = node["url"].delete_prefix(PORTABLE_BLOB_URL_PREFIX)
+        new_id = id_map.fetch(old_id, old_id)
+        blob = ActiveStorage::Blob.new(id: new_id)
+        node["url"] = Rails.application.routes.url_helpers.polymorphic_url(
+          blob, only_path: true, script_name: account.slug
+        )
