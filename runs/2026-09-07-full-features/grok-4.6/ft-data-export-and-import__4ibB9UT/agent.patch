@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::DataTransfer::ImporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "creates a new account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    original_title = card.title
+    original_comment_count = card.comments.count
+    original_user_names = @account.users.order(:name).pluck(:name)
+
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    import = @account.imports.create!(user: @user, file: export.file.blob)
+    assert_difference -> { Account.count }, 1 do
+      import.process
+    end
+
+    assert import.status_completed?, import.error_message
+    destination = import.imported_account
+    assert_not_equal @account.id, destination.id
+    assert_equal @account.name, destination.name
+
+    assert_equal original_user_names, destination.users.order(:name).pluck(:name)
+    assert_equal @user.identity, destination.users.find_by(name: "Jason").identity
+
+    imported_card = destination.cards.find_by!(title: original_title)
+    assert_equal original_comment_count, imported_card.comments.count
+    assert imported_card.image.attached?
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+  end
+
+  test "failed import leaves no account behind" do
+    export = @account.exports.create!(user: @user, kind: :account)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    Account::DataTransfer::Importer.stubs(:validate!).raises(Account::DataTransfer::Importer::InvalidFile, "nope")
+
+    import = @account.imports.create!(user: @user, file: export.file.blob)
+    assert_no_difference -> { Account.count } do
+      import.process
+    end
+    assert import.status_failed?
+    assert_nil import.imported_account
+    assert_equal "nope", import.error_message
+  end
+
+  test "rejects a cards export" do
+    export = @account.exports.create!(user: users(:david), kind: :cards)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    import = @account.imports.create!(user: @user, file: export.file.blob)
+    assert_no_difference -> { Account.count } do
+      import.process
+    end
+
+    assert import.status_failed?
+    assert_match /not a Fizzy account export/i, import.error_message
+  end
+end
