index 0000000..9815d58
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,53 @@
+class Account::DataTransfer::Importer
+  class InvalidFile < StandardError; end
+
+  attr_reader :account, :uploaded_keys
+
+  class << self
+    def validate!(zip)
+      meta = metadata(zip)
+
+      if meta["format"] != "fizzy.account"
+        raise InvalidFile, "This file is not a Fizzy account export."
+      end
+
+      unless zip.glob("accounts/*.json").one?
+        raise InvalidFile, "This file is not a Fizzy account export."
+      end
+    end
+
+    def metadata(zip)
+      if zip.exists?("fizzy.json")
+        JSON.parse(zip.read("fizzy.json"))
+      else
+        {}
+      end
+    end
+  end
+
+  def initialize(account)
+    @account = account
+    @uploaded_keys = []
+    @id_map = {}
+  end
+
+  def import_from(zip)
+    build_id_map(zip)
+
+    Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+      record_set.import_from(zip, id_map: @id_map, uploaded_keys: @uploaded_keys)
+    end
+  end
+
+  private
+    def build_id_map(zip)
+      zip.glob("*/*.json").each do |path|
+        old_id = File.basename(path, ".json")
+        @id_map[old_id] = ActiveRecord::Type::Uuid.generate
+      end
+
+      account_path = zip.glob("accounts/*.json").first
+      old_account_id = File.basename(account_path, ".json")
+      @id_map[old_account_id] = account.id
+    end
+end
