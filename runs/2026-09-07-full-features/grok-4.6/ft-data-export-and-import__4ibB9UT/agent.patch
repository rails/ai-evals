diff --git a/app/models/account/data_transfer/cards_exporter.rb b/app/models/account/data_transfer/cards_exporter.rb
new file mode 100644
index 0000000..de7c0d6
--- /dev/null
+++ b/app/models/account/data_transfer/cards_exporter.rb
@@ -0,0 +1,86 @@
+class Account::DataTransfer::CardsExporter
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(zip)
+    zip.add_file("fizzy.json", { format: "fizzy.cards", version: 1 }.to_json)
+
+    exported_blob_ids = {}
+
+    cards.find_each do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_payload(card)))
+      export_blobs_for(card, zip, exported_blob_ids)
+    end
+  end
+
+  private
+    attr_reader :user
+
+    def cards
+      user.accessible_cards.published.includes(
+        :board, :column, :creator, :tags, :image_attachment,
+        comments: [ :creator, :rich_text_body ],
+        rich_text_description: { embeds_attachments: :blob }
+      )
+    end
+
+    def card_payload(card)
+      {
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: card.board.name,
+        column: card.column&.name,
+        creator: card.creator.name,
+        assignees: card.assignees.map(&:name),
+        tags: card.tags.map(&:title).sort,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        image: card.image.attached? ? file_path(card.image.blob) : nil,
+        attachments: attachment_paths(card),
+        created_at: card.created_at.utc,
+        last_active_at: card.last_active_at.utc,
+        comments: card.comments.chronologically.map { |comment| comment_payload(comment) }
+      }
+    end
+
+    def comment_payload(comment)
+      {
+        creator: comment.creator.name,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        attachments: attachment_paths(comment),
+        created_at: comment.created_at.utc
+      }
+    end
+
+    def attachment_paths(record)
+      record.attachments.map { |attachment| file_path(attachment.blob) }
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}/#{blob.filename}"
+    end
+
+    def export_blobs_for(card, zip, exported_blob_ids)
+      blobs_for(card).each do |blob|
+        next if exported_blob_ids[blob.id]
+        next unless blob.service.exist?(blob.key)
+
+        zip.add_file(file_path(blob), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+
+        exported_blob_ids[blob.id] = true
+      end
+    end
+
+    def blobs_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat(card.attachments.map(&:blob))
+      card.comments.each { |comment| blobs.concat(comment.attachments.map(&:blob)) }
+      blobs.uniq
+    end
+end
