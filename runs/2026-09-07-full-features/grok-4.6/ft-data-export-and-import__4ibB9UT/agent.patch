+require "test_helper"
+
+class Account::DataTransfer::CardsExporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @david = users(:david)
+    @kevin = users(:kevin)
+  end
+
+  test "exports accessible published cards as json with comments" do
+    export = @account.exports.create!(user: @david, kind: :cards)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    ZipFile.open(export.file) do |zip|
+      meta = JSON.parse(zip.read("fizzy.json"))
+      assert_equal "fizzy.cards", meta["format"]
+
+      card = cards(:logo)
+      payload = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, payload["title"]
+      assert_equal card.comments.count, payload["comments"].size
+      assert payload["comments"].any? { |comment| comment["body"].present? }
+    end
+  end
+
+  test "includes pictures and files attached to cards" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @david, kind: :cards)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    ZipFile.open(export.file) do |zip|
+      payload = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal "files/#{card.image.blob.id}/moon.jpg", payload["image"]
+      assert zip.exists?(payload["image"])
+    end
+  end
+
+  test "does not include cards on boards the user cannot see" do
+    private_card = cards(:logo).dup
+    # Use existing private board that david cannot access
+    private_board = boards(:private)
+    assert_not private_board.accessible_to?(@david)
+
+    export = @account.exports.create!(user: @david, kind: :cards)
+    export.process
+    assert export.status_completed?, export.error_message
+
+    ZipFile.open(export.file) do |zip|
+      zip.glob("cards/*.json").each do |path|
+        payload = JSON.parse(zip.read(path))
+        assert_not_equal "Private board", payload["board"]
+      end
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/exporter_test.rb b/test/models/account/data_transfer/exporter_test.rb
new file mode 100644
index 0000000..25b576b
--- /dev/null
+++ b/test/models/account/data_transfer/exporter_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::DataTransfer::ExporterTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "writes a fizzy account manifest" do
+    zip = export_account(@account)
+
+    assert zip.exists?("fizzy.json")
+    meta = JSON.parse(zip.read("fizzy.json"))
+    assert_equal "fizzy.account", meta["format"]
+    assert_equal 1, meta["version"]
+  end
+
+  test "exports account, users, boards, and cards as json" do
+    zip = export_account(@account)
+
+    assert_equal 1, zip.glob("accounts/*.json").size
+    assert zip.glob("users/*.json").any?
+    assert zip.glob("boards/*.json").any?
+    assert zip.glob("cards/*.json").any?
+  end
+
+  test "exported users include email addresses" do
+    zip = export_account(@account)
+    path = zip.glob("users/*.json").find do |file|
+      JSON.parse(zip.read(file))["name"] == "Jason"
+    end
+
+    attrs = JSON.parse(zip.read(path))
+    assert_equal "jason@37signals.com", attrs["email_address"]
+  end
+
+  test "exports attached files" do
+    card = cards(:logo)
+    blob = create_blob_for(card)
+
+    zip = export_account(@account)
+
+    assert zip.exists?("files/#{blob.id}"), "expected blob file in zip"
+  end
+
+  private
+    def export_account(account)
+      export = account.exports.create!(user: @user, kind: :account)
+      export.process
+      assert export.status_completed?, export.error_message
+      read_zip(export.file)
+    end
+
+    def read_zip(attachment)
+      ZipFile.open(attachment) { |zip| return InMemoryZip.new(zip) }
+    end
+
+    def create_blob_for(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    class InMemoryZip
+      def initialize(zip)
+        @files = {}
+        zip.glob("*").each { |path| @files[path] = zip.read(path) }
+        zip.glob("*/*").each { |path| @files[path] = zip.read(path) }
+        zip.glob("*/*/*").each { |path| @files[path] = zip.read(path) }
+      end
+
+      def exists?(path)
+        @files.key?(path)
+      end
+
+      def glob(pattern)
+        @files.keys.select { |name| File.fnmatch(pattern, name) }.sort
+      end
+
+      def read(path)
+        @files.fetch(path)
+      end
+    end
+end
diff --git a/test/models/account/data_transfer/importer_test.rb b/test/models/account/data_transfer/importer_test.rb
