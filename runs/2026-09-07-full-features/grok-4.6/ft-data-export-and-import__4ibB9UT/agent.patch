+class Export < ApplicationRecord
+  EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), prefix: true
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), prefix: true
+
+  scope :expired, -> { where(created_at: ...EXPIRY.ago) }
+
+  class << self
+    def expire_due
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def process
+    status_processing!
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      exporter.export_to(zip)
+    end
+
+    status_completed!
+    AccountMailer.export_ready(self).deliver_later
+  rescue => error
+    update!(status: :failed, error_message: error.message)
+    Rails.error.report(error)
+  end
+
+  def download_url
+    file.url(expires_in: EXPIRY) if file.attached?
+  end
+
+  def publicly_accessible?
+    true
+  end
+
+  def accessible_to?(user)
+    user == self.user || user&.admin?
+  end
+
+  private
+    def filename
+      if kind_account?
+        "#{account.name.parameterize}-export.zip"
+      else
+        "#{user.name.parameterize}-cards.zip"
+      end
+    end
+
+    def exporter
+      if kind_account?
+        Account::DataTransfer::Exporter.new(account)
+      else
+        Account::DataTransfer::CardsExporter.new(user)
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..6b1b261
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,95 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), prefix: true
+
+  def process
+    status_processing!
+
+    destination = nil
+    uploaded_keys = []
+
+    begin
+      ZipFile.open(file) do |zip|
+        Account::DataTransfer::Importer.validate!(zip)
+
+        destination = Account.create!(name: import_name_from(zip))
+        update!(imported_account: destination)
+
+        importer = Account::DataTransfer::Importer.new(destination)
+        Current.with_account(destination) do
+          importer.import_from(zip)
+        end
+        uploaded_keys = importer.uploaded_keys
+      end
+
+      begin
+        grant_access_to_requester(destination)
+        reindex(destination)
+        destination.reconcile_storage
+        destination.boards.find_each(&:reconcile_storage)
+      rescue => post_error
+        Rails.error.report(post_error)
+      end
+
+      status_completed!
+      AccountMailer.import_completed(self).deliver_later
+    rescue => error
+      cleanup_failed_import(destination, uploaded_keys)
+      update!(status: :failed, error_message: error.message, imported_account: nil)
+      AccountMailer.import_failed(self).deliver_later
+    end
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  def accessible_to?(user)
+    user == self.user || user&.admin?
+  end
+
+  private
+    def import_name_from(zip)
+      path = zip.glob("accounts/*.json").first
+      JSON.parse(zip.read(path)).fetch("name")
+    end
+
+    def grant_access_to_requester(destination)
+      if user.identity && !destination.users.exists?(identity: user.identity)
+        destination.users.create!(
+          name: user.name,
+          identity: user.identity,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+    end
+
+    def reindex(destination)
+      Card.where(account: destination).find_each(&:reindex)
+      Comment.where(account: destination).find_each(&:reindex)
+    end
+
+    def cleanup_failed_import(destination, uploaded_keys)
+      if destination
+        ActiveStorage::Blob.where(account_id: destination.id).find_each do |blob|
+          blob.service.delete(blob.key)
+        rescue
+          nil
+        end
+
+        destination.destroy
+      end
+
+      uploaded_keys.each do |key|
+        ActiveStorage::Blob.service.delete(key)
+      rescue
+        nil
+      end
+    end
+end
