+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    sign_in_as users(:david)
+  end
+
+  test "signed in user can view the import form" do
+    get new_account_import_url
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  test "signed in user can start an import" do
+    file = fixture_file_upload("moon.jpg", "image/jpeg")
+
