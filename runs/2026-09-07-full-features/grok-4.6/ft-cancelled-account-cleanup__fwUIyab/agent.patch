diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..95bba5f
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently removes data for accounts canceled more than 30 days ago" do
+    due = accounts(:initech)
+    recent = accounts(:acme)
+    card = cards(:radio)
+    identity = users(:mike).identity
+
+    due.cancel(initiated_by: users(:mike))
+    due.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+    recent.cancel(initiated_by: users(:jason))
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(due.id)
+    assert_not Card.exists?(card.id)
+    assert_not User.exists?(users(:mike).id)
+    assert Identity.exists?(identity.id)
+
+    assert Account.exists?(recent.id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..8a3178e
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "due_for_incineration? is false when the account is active" do
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration? is false during the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration? is true after the grace period" do
+    cancel_account @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+
+    assert @account.due_for_incineration?
+  end
+
+  test "incinerate permanently removes the account and its data when due" do
+    card = cards(:radio)
+    identity = @user.identity
+    cancel_account @account, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not Card.exists?(card.id)
+    assert_not User.exists?(@user.id)
+    assert Identity.exists?(identity.id)
+  end
+
+  test "incinerate does nothing when the account is not due" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate_due only removes accounts past the grace period" do
+    due = @account
+    not_due = accounts(:acme)
+    cancel_account due, at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+    not_due.cancel(initiated_by: users(:jason))
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(not_due.id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+
+  private
+    def cancel_account(account, at:)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update_columns(created_at: at, updated_at: at)
+    end
+end
