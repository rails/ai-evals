@@ -0,0 +1,54 @@
+<div class="reactions" data-controller="reaction-form">
+  <div class="reactions__list" id="<%= dom_id(comment, :reactions) %>">
+    <%= render comment.reactions %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction"
+        data-reaction-form-target="trigger" data-action="reaction-form#show">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ],
+        class: "reaction__form", hidden: true, authenticity_token: false,
+        data: {
+          reaction_form_target: "form",
+          controller: "form",
+          action: "turbo:submit-end->reaction-form#hideOnSuccess keydown.esc->reaction-form#hide:prevent"
+        } do |form| %>
+    <label class="reaction__form-label">
+      <%= form.text_field :content, maxlength: 16, required: true, autocomplete: "off",
+            class: "input reaction__input", placeholder: "👍",
+            data: { reaction_form_target: "input", action: "keydown.esc->reaction-form#hide:prevent" } %>
+    </label>
+
+    <div class="reaction__menu" data-controller="dialog" data-action="click@window->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--plain" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, description| %>
+            <button type="button" class="btn" title="<%= description %>"
+                  data-action="reaction-form#selectEmoji dialog#close"
+                  data-reaction-form-emoji-param="<%= emoji %>">
+              <%= emoji %>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--plain" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn btn--plain" data-action="reaction-form#hide">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
