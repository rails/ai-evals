diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..3f37c4c
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,41 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  before_validation :strip_content
+  after_create :register_card_activity
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  delegate :card, to: :comment
+
+  def emoji_only?
+    content.present? && !content.match?(/\p{L}/)
+  end
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  private
+    def strip_content
+      self.content = content&.strip
+    end
+
+    def register_card_activity
+      card.update_columns(last_active_at: Time.current, updated_at: Time.current)
+    end
+
+    def broadcast_creation
+      broadcast_append_to card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions)
+    end
+
+    def broadcast_removal
+      broadcast_remove_to card
+    end
+end
