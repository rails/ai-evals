@@ -0,0 +1,17 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.#own) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle(event) {
+    if (!event.target.closest(".reaction__delete") && this.#own) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  get #own() {
+    return this.element.dataset.creatorId === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..3176487
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  show() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  hide() {
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  hideOnSuccess(event) {
+    if (event.detail.success) this.hide()
+  }
+
+  selectEmoji({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.formTarget.requestSubmit()
+  }
+}
