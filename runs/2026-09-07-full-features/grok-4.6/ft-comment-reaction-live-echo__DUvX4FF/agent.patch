+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create a reaction on a comment" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comment.account, reaction.account
+  end
+
+  test "content is required and at most 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.build(content: "")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+
+    reaction.content = "a" * 17
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+
+    reaction.content = "a" * 16
+    assert reaction.valid?
+  end
+
+  test "content is stripped" do
+    comment = comments(:logo_agreement_jz)
+    reaction = comment.reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+  end
+
+  test "creating a reaction updates the card last_active_at without a page refresh" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+    card.update_columns(last_active_at: 1.day.ago, updated_at: 1.day.ago)
+
+    streams = capture_turbo_stream_broadcasts card do
+      comment.reactions.create!(content: "🎉")
+    end
+
+    assert streams.any? { |stream| stream["action"] == "append" }
+    assert streams.none? { |stream| stream["action"] == "refresh" }
+    assert_in_delta Time.current, card.reload.last_active_at, 2
+  end
+
+  test "creating a reaction broadcasts it to everyone looking at the card" do
+    comment = comments(:logo_agreement_jz)
+    card = comment.card
+
+    streams = capture_turbo_stream_broadcasts card do
+      comment.reactions.create!(content: "🙌")
+    end
+
+    assert_equal 1, streams.size
+    assert_equal "append", streams.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(comment, :reactions), streams.first["target"]
+  end
+
+  test "destroying a reaction broadcasts removal" do
+    reaction = reactions(:logo_agreement_kevin_thumbs)
+
+    streams = capture_turbo_stream_broadcasts reaction.card do
+      reaction.destroy!
+    end
+
+    assert_equal 1, streams.size
+    assert_equal "remove", streams.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), streams.first["target"]
+  end
+
+  test "emoji_only? is true when content has no letters" do
+    reaction = reactions(:logo_agreement_kevin_thumbs)
+    assert reaction.emoji_only?
+
+    reaction.content = "Great 👍"
+    assert_not reaction.emoji_only?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_difference -> { Reaction.count }, -2 do
+      comment.destroy
+    end
+  end
+end
