diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..5cb12ca
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice 👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal "Nice 👍", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create rejects content longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction" do
+    reaction = reactions(:logo_agreement_kevin_thumbs)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_jz_heart)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(@card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :json
+    end
+
+    reaction = @comment.reactions.last
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal "🎉", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "🙌" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🙌", @comment.reactions.last.content
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs)
+
+    get card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal reaction.content, @response.parsed_body["content"]
+    assert_equal card_comment_reaction_url(reaction.card, reaction.comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_kevin_thumbs)
+
+    delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+test "card show includes the reactions strip on comments" do
+  get card_path(@card)
+  assert_response :success
+
+  comment = comments(:logo_agreement_kevin)
+  assert_select ".reactions" do
+    assert_select ".reaction", comment.reactions.count
+    assert_select ".reactions__trigger"
+    assert_select ".reaction__form input[maxlength=\"16\"]"
+  end
+  assert_select ".reaction", text: /👍/
+end
+
+test "comment JSON includes reactions_url" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
