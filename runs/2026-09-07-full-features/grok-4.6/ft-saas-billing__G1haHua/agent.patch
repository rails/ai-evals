@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Account::BillingSettingsTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "div", text: /Free/
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "non-admins do not see billing in settings" do
+    sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..a3260ac
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "lists accounts and opens an account page" do
+    untenanted do
+      get "/admin/accounts"
+    end
+
+    assert_response :success
+    assert_select "a", text: accounts(:initech).name
+
+    untenanted do
+      get "/admin/accounts/#{accounts(:initech).id}"
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comp and uncomp an account" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/admin/accounts/#{account.id}/comp"
+    end
+
+    assert account.reload.comped?
+
+    untenanted do
+      delete "/admin/accounts/#{account.id}/comp"
+    end
+
+    assert_not account.reload.comped?
+  end
+
+  test "override and reset limits" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/admin/accounts/#{account.id}/overridden_limit",
+        params: { card_count: 1_000, bytes_used: 2.gigabytes }
+    end
+
+    account.reload
+    assert_equal 1_000, account.overridden_limit.card_count
+    assert_equal 2.gigabytes, account.overridden_limit.bytes_used
+
+    untenanted do
+      delete "/admin/accounts/#{account.id}/overridden_limit"
+    end
+
+    assert_nil account.reload.overridden_limit
+  end
+
+  test "non-staff cannot access admin accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get "/admin/accounts"
+    end
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..d6e869a
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+  end
+
+  test "cannot create cards via JSON when card limit exceeded" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create draft cards via HTML when card limit exceeded" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "cannot publish cards when card limit exceeded" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "draft card shows upgrade pitch instead of create buttons when card limit exceeded" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows cards left warning from 100 cards out" do
+    accounts(:initech).update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "div", text: "50 cards left"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "staff can publish cards even when card limit exceeded" do
+    accounts(:initech).update_column(:cards_count, 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
