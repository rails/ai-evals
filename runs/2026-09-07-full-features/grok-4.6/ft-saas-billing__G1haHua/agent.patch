diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..232ca50
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,113 @@
+class Account::Subscription < SaasRecord
+  self.table_name = "account_subscriptions"
+
+  PAID_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  class << self
+    def process_stripe_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+        sync_from_stripe(event.data.object)
+      when "checkout.session.completed"
+        sync_from_checkout_session(event.data.object)
+      end
+    end
+
+    def sync_from_stripe(stripe_subscription)
+      account = find_account_for(stripe_subscription)
+      return unless account
+
+      plan = plan_for(stripe_subscription)
+      record = account.subscription || account.build_subscription
+
+      record.update!(
+        stripe_customer_id: customer_id_for(stripe_subscription),
+        stripe_subscription_id: stripe_subscription.id,
+        plan_key: plan.key,
+        status: stripe_subscription.status,
+        current_period_end: time_at(read_attribute(stripe_subscription, :current_period_end)),
+        cancel_at: time_at(read_attribute(stripe_subscription, :cancel_at))
+      )
+    end
+
+    def sync_from_checkout_session(session)
+      return unless read_attribute(session, :mode).to_s == "subscription" || read_attribute(session, :subscription).present?
+
+      account = find_account_for(session)
+      return unless account
+
+      customer_id = customer_id_for(session)
+      subscription_id = read_attribute(session, :subscription)
+      return if customer_id.blank?
+
+      record = account.subscription || account.build_subscription
+      attributes = { stripe_customer_id: customer_id }
+      attributes[:stripe_subscription_id] = subscription_id if subscription_id.present?
+      attributes[:status] = "active" if record.status.blank?
+      attributes[:plan_key] = Plan.for_key(metadata_for(session)["plan_key"]).key if metadata_for(session)["plan_key"].present?
+
+      record.update!(attributes)
+    end
+
+    private
+      def find_account_for(stripe_object)
+        metadata = metadata_for(stripe_object)
+        account_id = metadata["account_id"].presence || read_attribute(stripe_object, :client_reference_id)
+
+        if account_id.present?
+          Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+        end || find_by(stripe_customer_id: customer_id_for(stripe_object))&.account ||
+          find_by(stripe_subscription_id: stripe_object.id)&.account
+      end
+
+      def plan_for(stripe_subscription)
+        Plan.for_stripe_price_id(price_id_for(stripe_subscription)) ||
+          Plan.for_key(metadata_for(stripe_subscription)["plan_key"])
+      end
+
+      def price_id_for(stripe_subscription)
+        items = read_attribute(stripe_subscription, :items)
+        return if items.blank?
+
+        data = items.respond_to?(:data) ? items.data : items
+        first_item = data.respond_to?(:first) ? data.first : data
+        price = read_attribute(first_item, :price)
+        read_attribute(price, :id) || price
+      end
+
+      def customer_id_for(stripe_object)
+        customer = read_attribute(stripe_object, :customer)
+        customer.respond_to?(:id) ? customer.id : customer
+      end
+
+      def metadata_for(stripe_object)
+        metadata = read_attribute(stripe_object, :metadata)
+        (metadata.presence || {}).to_h.stringify_keys
+      end
+
+      def read_attribute(object, name)
+        if object.respond_to?(name)
+          object.public_send(name)
+        elsif object.respond_to?(:[])
+          object[name] || object[name.to_s]
+        end
+      end
+
+      def time_at(value)
+        return if value.blank?
+        return value if value.is_a?(Time) || value.is_a?(DateTime) || value.is_a?(ActiveSupport::TimeWithZone)
+
+        Time.zone.at(value.to_i)
+      end
+  end
+
+  def plan
+    Plan.for_key(plan_key)
+  end
+
+  def paid?
+    PAID_STATUSES.include?(status) && plan.paid?
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..6a002ce
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,72 @@
+class Plan
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_limit, :stripe_price_env
+
+  def initialize(key:, name:, price_cents:, card_limit:, storage_limit:, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env = stripe_price_env
+  end
+
+  class << self
+    def all
+      [ free, unlimited, unlimited_plus ]
+    end
+
+    def paid
+      all.select(&:paid?)
+    end
+
+    def free
+      @free ||= new(
+        key: "FreeV1",
+        name: "Free",
+        price_cents: 0,
+        card_limit: 1_000,
+        storage_limit: 1.gigabyte
+      )
+    end
+
+    def unlimited
+      @unlimited ||= new(
+        key: "MonthlyV1",
+        name: "Unlimited",
+        price_cents: 2_000,
+        card_limit: nil,
+        storage_limit: 5.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+      )
+    end
+
+    def unlimited_plus
+      @unlimited_plus ||= new(
+        key: "MonthlyExtraStorageV1",
+        name: "Unlimited+",
+        price_cents: 2_500,
+        card_limit: nil,
+        storage_limit: 500.gigabytes,
+        stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+      )
+    end
+
+    def for_key(key)
+      all.find { |plan| plan.key == key.to_s } || free
+    end
+
+    def for_stripe_price_id(price_id)
+      return if price_id.blank?
+
+      paid.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def paid?
+    price_cents.positive?
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env] if stripe_price_env
+  end
+end
