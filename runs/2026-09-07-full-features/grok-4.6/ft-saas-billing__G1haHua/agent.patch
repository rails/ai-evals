@@ -0,0 +1,68 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription updates apply the paid plan" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/stripe/webhooks", params: stripe_event(
+        type: "customer.subscription.updated",
+        object: {
+          id: "sub_unlimited",
+          object: "subscription",
+          customer: "cus_unlimited",
+          status: "active",
+          metadata: { account_id: account.id, plan_key: Plan.unlimited.key },
+          items: {
+            data: [
+              { price: { id: Plan.unlimited.stripe_price_id } }
+            ]
+          }
+        }
+      ), as: :json
+    end
+
+    assert_response :ok
+    account.reload
+    assert_equal "Unlimited", account.current_plan.name
+    assert_equal 5.gigabytes, account.storage_limit
+    assert_equal "cus_unlimited", account.subscription.stripe_customer_id
+  end
+
+  test "subscription deletion returns the account to free" do
+    account = accounts(:initech)
+    account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: Plan.unlimited.key,
+      status: "active"
+    )
+
+    untenanted do
+      post "/stripe/webhooks", params: stripe_event(
+        type: "customer.subscription.deleted",
+        object: {
+          id: "sub_unlimited",
+          object: "subscription",
+          customer: "cus_unlimited",
+          status: "canceled",
+          metadata: { account_id: account.id }
+        }
+      ), as: :json
+    end
+
+    assert_response :ok
+    account.reload
+    assert_equal "Free", account.current_plan.name
+  end
+
+  private
+    def stripe_event(type:, object:)
+      {
+        id: "evt_test",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..949a4d5
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan is the default" do
+    assert_equal "Free", @account.current_plan.name
+    assert_equal 1_000, @account.current_plan.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "exceeding card limit at 1000 cards" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.update_column(:cards_count, 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "paid subscription raises storage allowance and removes card limit" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_unlimited",
+      stripe_subscription_id: "sub_unlimited",
+      plan_key: Plan.unlimited.key,
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.current_plan.name
+    assert_nil @account.current_plan.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "unlimited plus subscription allows 500 GB" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_plus",
+      stripe_subscription_id: "sub_plus",
+      plan_key: Plan.unlimited_plus.key,
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.current_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comp grants unlimited plus without a subscription" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.current_plan.name
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overridden limits replace card count and bytes used" do
+    @account.update_column(:cards_count, 10)
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert_equal 1_000, @account.cards_used
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+    @account.reload
+
+    assert_equal 10, @account.cards_used
+    assert_not @account.exceeding_card_limit?
+  end
+end
