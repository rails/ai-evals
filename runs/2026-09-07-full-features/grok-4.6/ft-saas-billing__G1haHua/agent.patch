diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..52e5b9e
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,39 @@
+class StripeWebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.process_stripe_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def event
+      if webhook_secret.present? && signature.present?
+        Stripe::Webhook.construct_event(payload, signature, webhook_secret)
+      else
+        Stripe::Event.construct_from(event_data)
+      end
+    end
+
+    def event_data
+      if payload.present? && payload.strip.start_with?("{")
+        JSON.parse(payload)
+      else
+        params.to_unsafe_h.except(:controller, :action)
+      end
+    end
+
+    def payload
+      request.body.read
+    end
+
+    def signature
+      request.env["HTTP_STRIPE_SIGNATURE"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..c868ce1
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,140 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+
+    set_callback :cancel, :after, :cancel_paid_subscription
+  end
+
+  def current_plan
+    if billing_waiver.present?
+      Plan.unlimited_plus
+    elsif subscription&.paid?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def next_plan
+    case current_plan.key
+    when Plan.free.key then Plan.unlimited
+    when Plan.unlimited.key then Plan.unlimited_plus
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.paid?
+  end
+
+  def exceeding_card_limit?
+    current_plan.card_limit.present? && cards_used >= current_plan.card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.positive? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def cards_remaining
+    if current_plan.card_limit
+      [ current_plan.card_limit - cards_used, 0 ].max
+    end
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def current_bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      bytes_used
+    end
+  end
+
+  def storage_limit
+    storage_exception&.bytes_allowed || current_plan.storage_limit
+  end
+
+  def exceeding_storage_limit?
+    current_bytes_used > storage_limit
+  end
+
+  def nearing_storage_limit?
+    !exceeding_storage_limit? && current_bytes_used > storage_limit - Account::StorageLimited::NEAR_STORAGE_LIMIT_THRESHOLD
+  end
+
+  def comp
+    create_billing_waiver! unless billing_waiver
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    record = overridden_limit || build_overridden_limit
+    record.update!(
+      card_count: integer_or_nil(card_count),
+      bytes_used: integer_or_nil(bytes_used)
+    )
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+  end
+
+  def create_stripe_checkout_session(plan_key:, success_url:, cancel_url:)
+    plan = Plan.paid.find { |item| item.key == plan_key } || Plan.unlimited
+
+    Stripe::Checkout::Session.create(checkout_session_params(plan, success_url:, cancel_url:))
+  end
+
+  def create_stripe_billing_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: return_url
+    )
+  end
+
+  private
+    def checkout_session_params(plan, success_url:, cancel_url:)
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: id,
+        metadata: { account_id: id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: id, plan_key: plan.key } }
+      }.tap do |params|
+        if subscription&.stripe_customer_id
+          params[:customer] = subscription.stripe_customer_id
+        else
+          params[:customer_email] = owner_email
+        end
+      end
+    end
+
+    def cancel_paid_subscription
+      if subscription&.stripe_subscription_id.present? && Stripe.api_key.present?
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+      end
+    rescue Stripe::StripeError
+      nil
+    end
+
+    def integer_or_nil(value)
+      value.presence&.to_i
+    end
+end
