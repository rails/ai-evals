+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex gap margin-block-half">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account) %>
+      <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete %>
+    </div>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account) do |form| %>
+      <div>
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count %>
+      </div>
+      <div>
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used %>
+      </div>
+      <%= form.submit "Override" %>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete %>
+  </div>
+</section>
