diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..46c1d6e
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+    Current.session = sessions(:david)
+  end
+
+  test "card images count toward the board and account" do
+    attach_image_to @card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, @account.reload.bytes_used
+  end
+
+  test "files embedded in card descriptions count toward the board and account" do
+    embed_moon_in @card, :description
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, @account.reload.bytes_used
+  end
+
+  test "files embedded in comments count toward the board and account" do
+    comment = @card.comments.create!(body: "Check this out")
+    embed_moon_in comment, :body
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, @account.reload.bytes_used
+  end
+
+  test "files embedded in board descriptions count toward the board and account" do
+    embed_moon_in @board, :public_description
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, @account.reload.bytes_used
+  end
+
+  test "a board's usage includes everything on that board and its cards" do
+    attach_image_to @card
+    embed_moon_in @card, :description
+    embed_moon_in @card.comments.create!(body: "file"), :body
+    embed_moon_in @board, :public_description
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes * 4, @board.reload.bytes_used
+  end
+
+  test "an account's usage includes everything across all of its boards" do
+    attach_image_to @card
+    other_card = @other_board.cards.create!(title: "Other", creator: users(:david))
+    attach_image_to other_card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, @other_board.reload.bytes_used
+    assert_equal moon_bytes * 2, @account.reload.bytes_used
+  end
+
+  test "user avatars are not counted" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "export files are not counted" do
+    export = Export.create!(user: users(:david), account: @account)
+    export.file.attach(io: file_fixture("moon.jpg").open, filename: "export.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removing a card image decreases usage" do
+    attach_image_to @card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @account.reload.bytes_used
+
+    @card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a card with an image decreases usage" do
+    attach_image_to @card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @account.reload.bytes_used
+
+    @card.destroy
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card transfers usage between boards" do
+    attach_image_to @card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+
+    @card.move_to @other_board
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal moon_bytes, @other_board.reload.bytes_used
+    assert_equal moon_bytes, @account.reload.bytes_used
+  end
+
+  test "usage is isolated between accounts" do
+    initech = accounts(:initech)
+    initech_board = boards(:miltons_wish_list)
+    initech_card = cards(:radio)
+
+    attach_image_to @card
+
+    Current.account = initech
+    attach_image_to initech_card
+    perform_enqueued_jobs
+
+    assert_equal moon_bytes, @account.reload.bytes_used
+    assert_equal moon_bytes, initech.reload.bytes_used
+    assert_equal moon_bytes, @board.reload.bytes_used
+    assert_equal moon_bytes, initech_board.reload.bytes_used
+  end
+
+  private
+    def moon_bytes
+      file_fixture("moon.jpg").size
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def embed_moon_in(record, rich_text_name)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+
+      record.public_send(:"#{rich_text_name}=", ActionText::Content.new.append_attachables(blob))
+      record.save!
+    end
+end
