new file mode 100644
index 0000000..b0416f5
--- /dev/null
+++ b/app/models/storage/calculator.rb
@@ -0,0 +1,41 @@
+class Storage::Calculator
+  def initialize(record)
+    @record = record
+  end
+
+  def bytes
+    card_image_bytes + rich_text_embed_bytes
+  end
+
+  private
+    def card_image_bytes
+      scope_card_images(ActiveStorage::Attachment.joins(:blob).where(record_type: "Card", name: "image"))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def scope_card_images(attachments)
+      case @record
+      when Account
+        attachments.where(account_id: @record.id)
+      when Board
+        attachments.where(record_id: @record.cards.select(:id))
+      end
+    end
+
+    def rich_text_embed_bytes
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def rich_text_ids
+      case @record
+      when Account
+        ActionText::RichText.where(account_id: @record.id).select(:id)
+      when Board
+        ActionText::RichText.where(record_type: "Board", record_id: @record.id).select(:id)
+          .or(ActionText::RichText.where(record_type: "Card", record_id: @record.cards.select(:id)))
+          .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: @record.cards.select(:id)).select(:id)))
+      end
+    end
+end
diff --git a/app/models/storage/recalculatable.rb b/app/models/storage/recalculatable.rb
