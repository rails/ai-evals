+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :recalculate_bytes_used_for_board_change_later, if: :saved_change_to_board_id?
+  end
+
+  private
+    def recalculate_bytes_used_for_board_change_later
+      Board.find_by(id: board_id_before_last_save)&.recalculate_bytes_used_later
+      board.recalculate_bytes_used_later
+      account.recalculate_bytes_used_later
+    end
+end
