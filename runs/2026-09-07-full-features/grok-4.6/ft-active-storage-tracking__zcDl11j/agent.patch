--- /dev/null
+++ b/app/models/storage/recalculatable.rb
@@ -0,0 +1,11 @@
+module Storage::Recalculatable
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used_later
+    Storage::RecalculationJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    update_column(:bytes_used, Storage::Calculator.new(self).bytes)
+  end
+end
diff --git a/app/models/storage/tracking.rb b/app/models/storage/tracking.rb
new file mode 100644
index 0000000..13d36c9
--- /dev/null
+++ b/app/models/storage/tracking.rb
@@ -0,0 +1,59 @@
+module Storage::Tracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create_commit { enqueue_bytes_used_recalculation }
+    after_destroy_commit { enqueue_bytes_used_recalculation }
+  end
+
+  def purge
+    with_bytes_used_recalculation { super }
+  end
+
+  def purge_later
+    with_bytes_used_recalculation { super }
+  end
+
+  private
+    def with_bytes_used_recalculation
+      board = storage_board
+      account_record = account
+      yield
+      enqueue_bytes_used_recalculation(board: board, account_record: account_record)
+    end
+
+    def enqueue_bytes_used_recalculation(board: storage_board, account_record: account)
+      return unless board || countable_storage?
+
+      if board
+        board.recalculate_bytes_used_later
+        board.account.recalculate_bytes_used_later
+      elsif account_record
+        account_record.boards.find_each(&:recalculate_bytes_used_later)
+        account_record.recalculate_bytes_used_later
+      end
+    end
+
+    def countable_storage?
+      (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+    end
+
+    def storage_board
+      case record
+      when Card
+        record.board if name == "image"
+      when ActionText::RichText
+        storage_board_for(record.record)
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def storage_board_for(owner)
+      case owner
+      when Board then owner
+      when Card then owner.board
+      when Comment then owner.card.board
+      end
+    end
+end
