diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..9410289
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,27 @@
+class StripeWebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    Account::Subscription.sync_from_event(stripe_event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def stripe_event
+      payload = request.body.read
+      signature = request.headers["Stripe-Signature"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if secret.present? && signature.present?
+        Stripe::Webhook.construct_event(payload, signature, secret)
+      elsif payload.present?
+        JSON.parse(payload)
+      else
+        params.to_unsafe_h
+      end
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..3a61a5c
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,140 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :billing_waiver
+    has_one :overridden_limit
+
+    set_callback :cancel, :after, :cancel_stripe_subscription
+  end
+
+  def current_plan
+    if comped?
+      Plan::UnlimitedPlus
+    elsif active_subscription&.plan_key.present?
+      Plan.find(active_subscription.plan_key)
+    else
+      Plan::Free
+    end
+  end
+
+  def plan_name
+    current_plan.name
+  end
+
+  def active_subscription
+    subscription if subscription&.current?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp
+    else
+      uncomp
+    end
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      super
+    end
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = {
+      card_count: card_count.presence && card_count.to_i,
+      bytes_used: bytes_used.presence && bytes_used.to_i
+    }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+
+  def checkout_url(plan:, return_url:)
+    session = Stripe::Checkout::Session.create(
+      {
+        customer: ensure_stripe_customer_id,
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: id.to_s,
+        success_url: return_url,
+        cancel_url: return_url,
+        subscription_data: { metadata: { account_id: id.to_s } }
+      }
+    )
+    session.url
+  end
+
+  def billing_portal_url(return_url:)
+    session = Stripe::BillingPortal::Session.create(
+      {
+        customer: ensure_stripe_customer_id,
+        return_url: return_url
+      }
+    )
+    session.url
+  end
+
+  private
+    def ensure_stripe_customer_id
+      if subscription&.stripe_customer_id.present?
+        subscription.stripe_customer_id
+      else
+        customer = Stripe::Customer.create(
+          {
+            email: owner_email,
+            name: name,
+            metadata: { account_id: id.to_s }
+          }
+        )
+
+        if subscription
+          subscription.update!(stripe_customer_id: customer.id)
+        else
+          create_subscription!(stripe_customer_id: customer.id)
+        end
+
+        customer.id
+      end
+    end
+
+    def cancel_stripe_subscription
+      if subscription&.stripe_subscription_id.present?
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+      end
+    rescue Stripe::StripeError => error
+      Rails.logger.error("Stripe cancellation failed: #{error.message}")
+    end
+end
