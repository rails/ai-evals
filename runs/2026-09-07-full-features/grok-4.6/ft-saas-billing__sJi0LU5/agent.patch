@@ -0,0 +1,32 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  DEFAULT_CARD_LIMIT = 1_000
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    current_plan.card_limit
+  end
+
+  def exceeding_card_limit?
+    if card_limit
+      cards_used >= card_limit
+    else
+      false
+    end
+  end
+
+  def nearing_card_limit?
+    if card_limit && !exceeding_card_limit?
+      cards_used >= card_limit - NEAR_CARD_LIMIT_THRESHOLD
+    else
+      false
+    end
+  end
+
+  def cards_left
+    if card_limit
+      [ card_limit - cards_used, 0 ].max
+    end
+  end
+end
