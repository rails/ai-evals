diff --git a/saas/test/controllers/account/checkouts_controller_test.rb b/saas/test/controllers/account/checkouts_controller_test.rb
new file mode 100644
index 0000000..510f173
--- /dev/null
+++ b/saas/test/controllers/account/checkouts_controller_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_match(/Free/, response.body)
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "upgrade starts a stripe checkout session" do
+    sign_in_as :mike
+
+    customer = stub(id: "cus_test")
+    session = stub(url: "https://checkout.stripe.com/c/pay/cs_test")
+    Stripe::Customer.stubs(:create).returns(customer)
+    Stripe::Checkout::Session.stubs(:create).returns(session)
+
+    post saas.account_checkout_path(script_name: accounts(:initech).slug)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test"
+  end
+
+  test "non-admins cannot start checkout" do
+    sign_in_as :jz
+
+    post saas.account_checkout_path
+
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..862ff2b
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: accounts(:initech).name
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "account name opens the account page with support tools" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech))
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_match(/Card count/, response.body)
+    assert_match(/Bytes used/, response.body)
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comp comps the account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account)
+    end
+
+    assert_redirected_to %r{/admin/accounts/}
+    assert account.reload.comped?
+  end
+
+  test "uncomp removes the waiver" do
+    sign_in_as :david
+    account = accounts(:initech)
+    account.comp
+
+    untenanted do
+      delete saas.admin_account_comp_path(account)
+    end
+
+    assert_not account.reload.comped?
+  end
+
+  test "override sets card count and bytes used" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account),
+        params: { card_count: 950, bytes_used: 123 }
+    end
+
+    account.reload
+    assert_equal 950, account.cards_used
+    assert_equal 123, account.bytes_used
+  end
+
+  test "reset drops the override" do
+    sign_in_as :david
+    account = accounts(:initech)
+    account.override_limits(card_count: 950, bytes_used: 123)
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    assert_nil account.reload.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/card/card_limited/creation_test.rb b/saas/test/controllers/card/card_limited/creation_test.rb
new file mode 100644
index 0000000..7afe462
--- /dev/null
+++ b/saas/test/controllers/card/card_limited/creation_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Card::CardLimited::CreationTest < ActionDispatch::IntegrationTest
+  test "cannot create cards via JSON when card limit exceeded" do
+    sign_in_as :mike
+
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via HTML when card limit exceeded since they become drafts" do
+    sign_in_as :mike
+
+    accounts(:initech).override_limits(card_count: 1_000)
+    accounts(:initech).update_column(:cards_count, 100)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "can create cards via JSON when under card limit" do
+    sign_in_as :mike
+
+    accounts(:initech).override_limits(card_count: 100)
+    accounts(:initech).update_column(:cards_count, 100)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Allowed card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "staff can create cards via JSON even when card limit exceeded" do
+    sign_in_as :mike
+
+    accounts(:initech).override_limits(card_count: 1_000)
+    accounts(:initech).update_column(:cards_count, 100)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Staff card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+end
