+    assert_nil Plan::Unlimited.card_limit
+    assert_equal 5.gigabytes, Plan::Unlimited.storage_limit
+    assert_equal 20, Plan::Unlimited.price
+  end
+
+  test "unlimited plus plan is 25 a month with 500 GB" do
+    assert_equal "Unlimited+", Plan::UnlimitedPlus.name
+    assert_nil Plan::UnlimitedPlus.card_limit
+    assert_equal 500.gigabytes, Plan::UnlimitedPlus.storage_limit
+    assert_equal 25, Plan::UnlimitedPlus.price
