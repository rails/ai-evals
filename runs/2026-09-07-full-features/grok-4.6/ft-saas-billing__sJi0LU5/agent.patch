diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..0306b14
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,120 @@
+class Account::Subscription < SaasRecord
+  CURRENT_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  def current?
+    status.in?(CURRENT_STATUSES)
+  end
+
+  def self.sync_from_event(event)
+    type, object = type_and_object(event)
+    return if object.blank?
+
+    if type.to_s.start_with?("customer.subscription")
+      sync_subscription(object)
+    elsif type.to_s == "checkout.session.completed"
+      sync_checkout_session(object)
+    end
+  end
+
+  def self.sync_subscription(object)
+    object = indifferent(object)
+    account = find_account_from_stripe(object)
+    return unless account
+
+    upsert_for(account, stripe_attributes(object))
+  end
+
+  def self.sync_checkout_session(object)
+    object = indifferent(object)
+    account = Account.find_by(id: object[:client_reference_id]) || find_account_from_stripe(object)
+    return unless account
+
+    attributes = {
+      stripe_customer_id: object[:customer],
+      stripe_subscription_id: object[:subscription]
+    }.compact
+
+    attributes[:status] ||= "active"
+    attributes[:plan_key] ||= Plan::Unlimited.key
+
+    upsert_for(account, attributes)
+  end
+
+  def self.find_account_from_stripe(object)
+    object = indifferent(object)
+    metadata = indifferent(object[:metadata])
+
+    if (account_id = metadata[:account_id].presence)
+      Account.find_by(id: account_id)
+    elsif (customer_id = object[:customer].presence)
+      find_by(stripe_customer_id: customer_id)&.account ||
+        find_by(stripe_subscription_id: object[:id])&.account
+    elsif (subscription_id = object[:id].presence)
+      find_by(stripe_subscription_id: subscription_id)&.account
+    end
+  end
+
+  def self.stripe_attributes(object)
+    object = indifferent(object)
+
+    {
+      stripe_customer_id: object[:customer],
+      stripe_subscription_id: object[:id],
+      status: object[:status],
+      plan_key: plan_key_from(object),
+      current_period_end: time_at(object[:current_period_end]),
+      cancel_at: time_at(object[:cancel_at])
+    }.compact
+  end
+
+  def self.plan_key_from(object)
+    price_id = price_id_from(object)
+    Plan.find_by_stripe_price_id(price_id)&.key || Plan::Unlimited.key
+  end
+
+  def self.price_id_from(object)
+    items = indifferent(object[:items])
+    data = Array(items[:data])
+    first = indifferent(data.first)
+    price = first[:price]
+    if price.is_a?(String)
+      price
+    else
+      indifferent(price)[:id]
+    end
+  end
+
+  def self.upsert_for(account, attributes)
+    record = account.subscription || account.build_subscription
+    record.update!(attributes)
+    record
+  end
+
+  def self.time_at(value)
+    Time.at(value.to_i) if value.present?
+  end
+
+  def self.indifferent(value)
+    if value.respond_to?(:to_unsafe_h)
+      value.to_unsafe_h.with_indifferent_access
+    elsif value.respond_to?(:to_hash)
+      value.to_hash.with_indifferent_access
+    elsif value.is_a?(Hash)
+      value.with_indifferent_access
+    else
+      {}.with_indifferent_access
+    end
+  end
+
+  def self.type_and_object(event)
+    if event.respond_to?(:type) && event.respond_to?(:data)
+      [ event.type, event.data.object ]
+    else
+      event = indifferent(event)
+      [ event[:type], event.dig(:data, :object) ]
+    end
+  end
+  private_class_method :upsert_for, :time_at, :indifferent, :stripe_attributes, :plan_key_from, :price_id_from, :type_and_object
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..f7916dc
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,68 @@
+class Plan
+  attr_reader :key, :name, :short_name, :price, :card_limit, :storage_limit, :stripe_price_env
+
+  def initialize(key:, name:, short_name:, price:, card_limit:, storage_limit:, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @short_name = short_name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env = stripe_price_env
+  end
+
+  Free = new(
+    key: "free",
+    name: "Free",
+    short_name: "FreeV1",
+    price: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+  )
+
+  Unlimited = new(
+    key: "monthly_v1",
+    name: "Unlimited",
+    short_name: "MonthlyV1",
+    price: 20,
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+  )
+
+  UnlimitedPlus = new(
+    key: "monthly_extra_storage_v1",
+    name: "Unlimited+",
+    short_name: "MonthlyExtraStorageV1",
+    price: 25,
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  )
+
+  ALL = [ Free, Unlimited, UnlimitedPlus ].freeze
+
+  class << self
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s } || Free
+    end
+
+    def find_by_stripe_price_id(price_id)
+      ALL.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+
+  def stripe_price_id
+    if stripe_price_env
+      ENV.fetch(stripe_price_env, "price_#{key}")
+    end
+  end
+
+  def paid?
+    price > 0
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+end
