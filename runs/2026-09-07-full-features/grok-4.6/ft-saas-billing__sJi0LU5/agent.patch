+      post "/stripe/webhooks",
+        params: "not-json",
+        headers: { "Content-Type" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..57e51bf
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts use the free plan" do
+    assert_equal Plan::Free, @account.current_plan
+    assert_equal "Free", @account.plan_name
+    assert_equal "FreeV1", @account.plan
+  end
+
+  test "comped accounts use unlimited plus" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal Plan::UnlimitedPlus, @account.current_plan
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "uncomp returns the account to the free plan" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal Plan::Free, @account.current_plan
+  end
+
+  test "paid subscription brings its storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test",
+      stripe_subscription_id: "sub_test",
+      plan_key: Plan::Unlimited.key,
+      status: "active"
+    )
+
+    assert_equal Plan::Unlimited, @account.current_plan
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overridden card count is used for limits" do
+    @account.override_limits(card_count: 950)
+
+    assert_equal 950, @account.cards_used
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_left
+  end
+
+  test "overridden bytes used is used for storage limits" do
+    @account.override_limits(bytes_used: 1.gigabyte + 1)
+
+    assert_equal 1.gigabyte + 1, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 1000, bytes_used: 5.gigabytes)
+    @account.reset_overridden_limits
+
+    assert_nil @account.overridden_limit
+    assert_equal @account.cards_count, @account.cards_used
+  end
+
+  test "exceeding card limit at 1000 cards" do
+    @account.override_limits(card_count: 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.override_limits(card_count: 900)
+
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_left
+    assert_not @account.exceeding_card_limit?
+  end
+end
