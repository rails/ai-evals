diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..8535303
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "syncs an active subscription from a stripe event" do
+    Account::Subscription.sync_from_event(
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_123",
+          customer: "cus_123",
+          status: "active",
+          metadata: { account_id: @account.id },
+          items: { data: [ { price: { id: Plan::Unlimited.stripe_price_id } } ] }
+        }
+      }
+    )
+
+    subscription = @account.reload.subscription
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "active", subscription.status
+    assert_equal Plan::Unlimited.key, subscription.plan_key
+    assert_equal Plan::Unlimited, @account.current_plan
+  end
+
+  test "syncs unlimited plus from its stripe price" do
+    Account::Subscription.sync_from_event(
+      "type" => "customer.subscription.created",
+      "data" => {
+        "object" => {
+          "id" => "sub_plus",
+          "customer" => "cus_plus",
+          "status" => "active",
+          "metadata" => { "account_id" => @account.id },
+          "items" => { "data" => [ { "price" => { "id" => Plan::UnlimitedPlus.stripe_price_id } } ] }
+        }
+      }
+    )
+
+    assert_equal Plan::UnlimitedPlus, @account.reload.current_plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription returns the account to free" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: Plan::Unlimited.key,
+      status: "active"
+    )
+
+    Account::Subscription.sync_from_event(
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_123",
+          customer: "cus_123",
+          status: "canceled",
+          metadata: { account_id: @account.id }
+        }
+      }
+    )
+
+    assert_equal "canceled", @account.reload.subscription.status
+    assert_equal Plan::Free, @account.current_plan
+  end
+end
