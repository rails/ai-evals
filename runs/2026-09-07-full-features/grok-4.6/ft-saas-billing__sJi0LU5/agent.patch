+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  test "subscription changes update the account" do
+    account = accounts(:initech)
+
+    untenanted do
+      post "/stripe/webhooks", params: {
+        type: "customer.subscription.updated",
+        data: {
+          object: {
+            id: "sub_hook",
+            customer: "cus_hook",
+            status: "active",
+            metadata: { account_id: account.id },
+            items: { data: [ { price: { id: Plan::Unlimited.stripe_price_id } } ] }
+          }
+        }
+      }, as: :json
+    end
