diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..54b1d26
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "permanently removes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    identity = @user.identity
+    card = cards(:radio)
+    board = boards(:miltons_wish_list)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(@user.id)
+    assert_not Card.exists?(card.id)
+    assert_not Board.exists?(board.id)
+    assert Identity.exists?(identity.id)
+  end
+
+  test "does not remove accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not remove active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(accounts(:"37s").id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b7af9b3
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @user = users(:mike)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_column(:created_at, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account.reload
+  end
+
+  test "incinerate destroys a due account and its data" do
+    @account.cancel(initiated_by: @user)
+    card = cards(:radio)
+    identity = @user.identity
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Card.exists?(card.id)
+    assert_not User.exists?(@user.id)
+    assert Identity.exists?(identity.id)
+  end
+
+  test "incinerate does nothing when the account is still within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "incinerate does nothing when the account is active" do
+    @account.incinerate
+
+    assert Account.exists?(@account.id)
+  end
+end
