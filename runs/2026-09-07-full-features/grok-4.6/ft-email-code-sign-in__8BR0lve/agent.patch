+    @email_code = Identity::EmailCode.issue(@identity)
+  end
+
+  test "new" do
+    untenanted do
+      get new_session_email_code_path
+      assert_response :success
+    end
+  end
+
+  test "create with a valid code signs in" do
+    untenanted do
+      post session_email_code_path, params: { code: @email_code.code }
