diff --git a/test/models/identity/email_code_test.rb b/test/models/identity/email_code_test.rb
new file mode 100644
index 0000000..74d348e
--- /dev/null
+++ b/test/models/identity/email_code_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Identity::EmailCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "issue creates a six-character code and sends email" do
+    assert_enqueued_emails 1 do
+      email_code = Identity::EmailCode.issue(@identity)
+
+      assert email_code.persisted?
+      assert_equal 6, email_code.code.length
+      assert_match /\A[A-Z0-9]{6}\z/, email_code.code
+      assert_equal @identity, email_code.identity
+    end
+  end
+
+  test "issue replaces existing codes for the identity" do
+    first = Identity::EmailCode.issue(@identity)
+    second = Identity::EmailCode.issue(@identity)
+
+    assert_not Identity::EmailCode.exists?(first.id)
+    assert Identity::EmailCode.exists?(second.id)
+  end
+
+  test "authenticate returns identity and consumes the code" do
+    email_code = Identity::EmailCode.issue(@identity)
+    code = email_code.code
+
+    assert_equal @identity, Identity::EmailCode.authenticate(code)
+    assert_not Identity::EmailCode.exists?(email_code.id)
+    assert_nil Identity::EmailCode.authenticate(code)
+  end
+
+  test "authenticate is case-insensitive and ignores extra characters" do
+    email_code = Identity::EmailCode.issue(@identity)
+    spaced = email_code.code.chars.join("-").downcase
+
+    assert_equal @identity, Identity::EmailCode.authenticate(spaced)
+  end
+
+  test "authenticate rejects expired codes" do
+    email_code = Identity::EmailCode.issue(@identity)
+
+    travel 15.minutes + 1.second do
+      assert_nil Identity::EmailCode.authenticate(email_code.code)
+    end
+  end
+
+  test "authenticate rejects unknown codes" do
+    assert_nil Identity::EmailCode.authenticate("NOPE00")
+  end
+end
