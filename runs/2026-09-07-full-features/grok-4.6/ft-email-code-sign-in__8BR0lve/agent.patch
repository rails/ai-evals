diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..82621ac
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,48 @@
+class Identity::EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+
+  before_create :generate_code
+
+  def self.issue(identity)
+    transaction do
+      where(identity: identity).destroy_all
+      create!(identity: identity).tap(&:deliver_later)
+    end
+  end
+
+  def self.authenticate(code)
+    find_by(code: parse(code))&.authenticate
+  end
+
+  def self.parse(code)
+    code.to_s.gsub(/[^a-z0-9]/i, "").upcase
+  end
+
+  def authenticate
+    if expired?
+      nil
+    else
+      destroy
+      identity
+    end
+  end
+
+  def expired?
+    created_at < EXPIRATION.ago
+  end
+
+  def deliver_later
+    IdentityMailer.email_code(self).deliver_later
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = self.class.parse(SecureRandom.alphanumeric(CODE_LENGTH))
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+end
