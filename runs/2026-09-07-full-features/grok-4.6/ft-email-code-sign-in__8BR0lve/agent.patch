diff --git a/test/controllers/join_codes/email_codes_controller_test.rb b/test/controllers/join_codes/email_codes_controller_test.rb
new file mode 100644
index 0000000..9cb1b04
--- /dev/null
+++ b/test/controllers/join_codes/email_codes_controller_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class JoinCodes::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "new" do
+    get new_join_email_code_path(code: @join_code.code, script_name: @account.slug)
+    assert_response :success
+  end
+
+  test "create for existing identity without a user joins and redirects to verification" do
+    identity = identities(:mike)
+    email_code = Identity::EmailCode.issue(identity)
+
+    assert_not identity.users.exists?(account: @account), "Mike should not be a member of 37s for this test"
+
+    assert_difference -> { User.count }, 1 do
+      post join_email_code_path(code: @join_code.code, script_name: @account.slug), params: { code: email_code.code }
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create for existing setup user signs in and lands" do
+    identity = identities(:jz)
+    email_code = Identity::EmailCode.issue(identity)
+
+    assert identity.users.exists?(account: @account), "JZ should be a member of 37s for this test"
+    assert identity.users.find_by!(account: @account).setup?, "JZ's user should be setup for this test"
+
+    assert_no_difference -> { User.count } do
+      post join_email_code_path(code: @join_code.code, script_name: @account.slug), params: { code: email_code.code }
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create for a new identity joins" do
+    identity = Identity.create!(email_address: "new-joiner@example.com")
+    email_code = Identity::EmailCode.issue(identity)
+
+    assert_difference -> { User.count }, 1 do
+      post join_email_code_path(code: @join_code.code, script_name: @account.slug), params: { code: email_code.code }
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create with an invalid code" do
+    post join_email_code_path(code: @join_code.code, script_name: @account.slug), params: { code: "NOPE00" }
+
+    assert_redirected_to new_join_email_code_path(code: @join_code.code)
+    assert_not cookies[:session_token].present?
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+  end
+end
