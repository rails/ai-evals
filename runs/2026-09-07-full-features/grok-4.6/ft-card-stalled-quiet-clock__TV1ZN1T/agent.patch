new file mode 100644
index 0000000..ce4349e
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,47 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_INACTIVITY_PERIOD.ago)
+    }
+  end
+
+  def stalled?
+    active? && last_burst_at.present? && last_active_at <= STALL_INACTIVITY_PERIOD.ago
+  end
+
+  def record_burst
+    update_column :last_burst_at, Time.current
+  end
+
+  def record_burst_if_comment_cluster(comment)
+    if comment_cluster_burst?(comment)
+      record_burst
+    end
+  end
+
+  private
+    def comment_cluster_burst?(comment)
+      if comment.creator.system?
+        false
+      else
+        creator_ids = recent_user_comment_creator_ids(comment)
+        creator_ids.size >= 3 && creator_ids.uniq.size >= 2
+      end
+    end
+
+    def recent_user_comment_creator_ids(comment)
+      comments.by_user.where(comments: { created_at: comment_burst_window(comment) }).pluck("comments.creator_id")
+    end
+
+    def comment_burst_window(comment)
+      comment.created_at - comment_burst_period..comment.created_at
+    end
+
+    def comment_burst_period
+      (auto_postpone_period / 3.0).seconds
+    end
+end
