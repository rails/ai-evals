diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..bcc3a34
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    card = cards(:buy_domain)
+
+    card.comments.create!(body: "One", creator: users(:david))
+    card.comments.create!(body: "Two", creator: users(:david))
+    assert_nil card.reload.last_burst_at
+
+    card.comments.create!(body: "Three", creator: users(:kevin))
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "three comments from one person is not a burst" do
+    card = cards(:buy_domain)
+
+    3.times { |i| card.comments.create!(body: "Solo #{i}", creator: users(:david)) }
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "comments spread outside a third of the auto-close period are not a burst" do
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days)
+    card = cards(:buy_domain)
+
+    travel_to 2.days.ago do
+      card.comments.create!(body: "Old one", creator: users(:david), created_at: Time.current)
+      card.comments.create!(body: "Old two", creator: users(:kevin), created_at: Time.current)
+    end
+
+    card.comments.create!(body: "New three", creator: users(:jz))
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    card = cards(:buy_domain)
+
+    card.comments.create!(body: "One", creator: users(:david))
+    card.comments.create!(body: "Two", creator: users(:kevin))
+    card.comments.create!(body: "System", creator: users(:system))
+
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "assigning someone records a burst" do
+    card = cards(:buy_domain)
+
+    assert_nil card.last_burst_at
+    card.toggle_assignment users(:kevin)
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "unassigning someone does not record a burst" do
+    card = cards(:layout)
+
+    assert_nil card.last_burst_at
+    card.toggle_assignment users(:jz)
+    assert_nil card.reload.last_burst_at
+  end
+
+  test "reopening a card records a burst" do
+    card = cards(:shipping)
+
+    assert_nil card.last_burst_at
+    card.reopen
+    assert_not_nil card.reload.last_burst_at
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    card = cards(:buy_domain)
+    card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    assert card.reload.stalled?
+    assert_includes Card.stalled, card
+  end
+
+  test "a card with a burst is not stalled while it is still active" do
+    card = cards(:buy_domain)
+    card.update_columns last_burst_at: Time.current, last_active_at: Time.current
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "activity on a stalled card resets it" do
+    card = cards(:buy_domain)
+    card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert card.reload.stalled?
+
+    card.comments.create!(body: "I'm back", creator: users(:david))
+
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    card = cards(:buy_domain)
+    card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    assert card.reload.stalled?
+
+    card.close
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+
+    card.reopen
+    card.update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+    card.postpone
+    assert_not card.reload.stalled?
+    assert_not_includes Card.stalled, card
+  end
+
+  test "indexed_by stalled" do
+    cards(:buy_domain).update_columns last_burst_at: 3.weeks.ago, last_active_at: 3.weeks.ago
+
+    assert_includes Card.indexed_by("stalled"), cards(:buy_domain)
+    assert_not_includes Card.indexed_by("stalled"), cards(:layout)
+  end
+end
