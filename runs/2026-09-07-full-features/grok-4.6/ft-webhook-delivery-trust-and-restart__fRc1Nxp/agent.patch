+++ b/app/models/event/relaying.rb
@@ -0,0 +1,26 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    matching_webhooks.each do |webhook|
+      delivery = webhook.deliveries.find_or_create_by!(event: self)
+
+      if delivery.pending?
+        delivery.deliver_later
+      end
+    end
+  end
+
+  private
+    def matching_webhooks
+      board.webhooks.active.select { |webhook| webhook.subscribed_actions.include?(action.to_s) }
+    end
+end
