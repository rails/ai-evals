@@ -1,4 +1,8 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  TIMEOUT = 5
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +14,22 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if claim
+      perform_delivery
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +49,66 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.where(id: id, state: :pending).update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
+
+    def perform_delivery
+      payload = Webhook::Payload.new(webhook, event)
+      body = payload.body
+      headers = signed_headers(body, payload.content_type)
+      update!(request: { headers: headers })
+
+      http_response = post(body, headers)
+      update!(state: :completed, response: { code: http_response.code.to_i })
+    rescue StandardError
+      update!(state: :errored, response: { error: "destination_unreachable" })
+    ensure
+      track_delinquency
+    end
+
+    def signed_headers(body, content_type)
+      timestamp = Time.current.utc.iso8601(3)
+
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => content_type,
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      ip = SsrfProtection.resolve_public_ip(uri.hostname)
+
+      if ip.blank?
+        raise SocketError, "destination_unreachable"
+      end
+
+      http = Net::HTTP.new(uri.hostname, uri.port)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = TIMEOUT
+      http.read_timeout = TIMEOUT
+      http.write_timeout = TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri)
+      headers.each { |name, value| request[name] = value }
+      request.body = body
+
+      http.request(request)
+    end
+
+    def track_delinquency
+      reload
+
+      if succeeded?
+        webhook.delinquency_tracker&.record_success
+      elsif failed?
+        (webhook.delinquency_tracker || webhook.create_delinquency_tracker!).record_failure
+      end
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..7d47111
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,43 @@
+class Webhook::Payload
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def body
+    if @webhook.for_slack?
+      { text: rendered_event(:html) }.to_json
+    elsif @webhook.for_campfire? || @webhook.for_basecamp?
+      { content: rendered_event(:html) }.to_json
+    else
+      rendered_event(:json)
+    end
+  end
+
+  def content_type
+    "application/json"
+  end
+
+  private
+    def rendered_event(format)
+      ApplicationController.renderer.new(renderer_options).render(
+        template: "webhooks/event",
+        layout: false,
+        formats: [ format ],
+        assigns: { event: @event }
+      )
+    end
+
+    def renderer_options
+      {
+        http_host: url_options[:host],
+        https: url_options[:protocol].to_s == "https",
+        script_name: @webhook.account.slug
+      }.compact
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
