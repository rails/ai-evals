diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..bcebcee
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,38 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  CONSECUTIVE_FAILURES_LIMIT = 10
+  CONSECUTIVE_FAILURES_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset
+  end
+
+  def record_failure
+    if within_window?
+      increment! :consecutive_failures_count
+    else
+      update! consecutive_failures_count: 1, first_failure_at: Time.current
+    end
+
+    if delinquent?
+      webhook.deactivate
+    end
+  end
+
+  def reset
+    if consecutive_failures_count > 0 || first_failure_at.present?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count >= CONSECUTIVE_FAILURES_LIMIT && within_window?
+  end
+
+  private
+    def within_window?
+      first_failure_at.present? && first_failure_at >= CONSECUTIVE_FAILURES_WINDOW.ago
+    end
+end
