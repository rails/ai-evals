+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @webhook = webhooks(:active)
+  end
+
+  test "creating an event enqueues a relay job" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event
+    end
+  end
+
+  test "relay_now creates a delivery and enqueues it for subscribed actions" do
+    event = create_event(action: "card_published")
+
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      assert_difference -> { @webhook.deliveries.count }, +1 do
+        event.relay_now
+      end
+    end
+  end
+
+  test "relay_now ignores unsubscribed actions" do
+    event = create_event(action: "comment_created")
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference -> { @webhook.deliveries.count } do
+        event.relay_now
+      end
+    end
+  end
+
+  test "relay_now ignores inactive webhooks" do
+    @webhook.deactivate
+    event = create_event(action: "card_published")
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference -> { Webhook::Delivery.count } do
+        event.relay_now
+      end
+    end
+  end
+
+  test "relay_now creates exactly one delivery for the same event" do
+    event = create_event(action: "card_published")
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      event.relay_now
+    end
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      event.relay_now
+    end
+  end
+
+  private
+    def create_event(action: "card_published")
+      @board.events.create!(
+        action: action,
+        creator: users(:david),
+        eventable: cards(:logo),
+        account: accounts("37s")
+      )
+    end
+end
