diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..a0f048d
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,96 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+  end
+
+  test "dragging a card to a column moves it immediately and persists" do
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    wait_for_column_list column
+
+    html5_drag "##{dom_id(@card, :article)}", to: "##{dom_id(column)}"
+
+    assert_selector "##{dom_id(column)} ##{dom_id(@card, :article)}"
+    assert_equal column, @card.reload.column
+    assert @card.active?
+  end
+
+  test "dragging a card between columns changes its column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    find("##{dom_id(card.column)}").click
+    assert_selector "##{dom_id(card, :article)}"
+    wait_for_column_list column
+
+    html5_drag "##{dom_id(card, :article)}", to: "##{dom_id(column)}"
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+    assert_equal column, card.reload.column
+  end
+
+  test "dragging a card to Done closes it" do
+    visit_board
+    wait_for_column_list "closed-cards"
+
+    html5_drag "##{dom_id(@card, :article)}", to: "#closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(@card, :article)}"
+    assert @card.reload.closed?
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    visit_board
+    wait_for_column_list "not-now"
+
+    html5_drag "##{dom_id(@card, :article)}", to: "#not-now"
+
+    assert_selector "#not-now ##{dom_id(@card, :article)}"
+    assert @card.reload.postponed?
+  end
+
+  test "dragging a card back to Maybe sends it to triage" do
+    card = cards(:logo)
+
+    visit_board
+    find("##{dom_id(card.column)}").click
+    assert_selector "##{dom_id(card, :article)}"
+
+    html5_drag "##{dom_id(card, :article)}", to: "#maybe"
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert card.reload.awaiting_triage?
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      assert_selector "##{dom_id(@card, :article)}"
+    end
+
+    def wait_for_column_list(column)
+      id = column.respond_to?(:id) ? dom_id(column) : column
+      assert_selector "##{id} .cards__list", visible: :all
+    end
+
+    def html5_drag(from_selector, to:)
+      page.execute_script(<<~JS, from_selector, to)
+        const source = document.querySelector(arguments[0])
+        const target = document.querySelector(arguments[1])
+        const dataTransfer = new DataTransfer()
+
+        source.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        target.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        target.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        source.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+end
