diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..49b07a4
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,151 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Cards are moved in the DOM as soon as you drop them, then saved in the
+// background. The save asks for JSON so Turbo's request id can suppress the
+// board refresh that would otherwise reshuffle the column you just dropped on.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+    item.querySelectorAll("img, a").forEach(element => element.draggable = false)
+  }
+
+  dragstart(event) {
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    this.#draggedItem = item
+    this.#draggedItem.classList.add(this.draggedItemClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+  }
+
+  dragover(event) {
+    const container = this.#droppableContainerFrom(event)
+    if (!container) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.#hover(container)
+  }
+
+  dragleave(event) {
+    if (this.#hoverContainer && !this.#hoverContainer.contains(event.relatedTarget)) {
+      this.#clearHover()
+    }
+  }
+
+  drop(event) {
+    const container = this.#droppableContainerFrom(event)
+    if (!container) return
+
+    event.preventDefault()
+    this.#dropItemIn(container)
+  }
+
+  dragend() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#clearHover()
+  }
+
+  // Private
+
+  #draggedItem = null
+  #hoverContainer = null
+
+  #dropItemIn(container) {
+    const item = this.#draggedItem
+    const source = this.#containerFor(item)
+    if (!item || source === container) return
+
+    if (this.#move(item, container)) {
+      container.focus()
+    }
+    this.#save(item, container, source)
+  }
+
+  #move(item, container) {
+    const destination = this.#destinationFor(container)
+    if (!destination) return false
+
+    destination.prepend(item)
+    item.addEventListener("click", this.#suppressClick, { capture: true, once: true })
+    return true
+  }
+
+  async #save(item, container, source) {
+    try {
+      const response = await this.#requestFor(item, container)
+      if (!response?.ok) this.#move(item, source)
+    } catch {
+      this.#move(item, source)
+    }
+  }
+
+  #requestFor(item, container) {
+    const options = { responseKind: "json" }
+    const action = container.dataset.dropAction
+
+    if (action === "not_now") {
+      return post(item.dataset.cardNotNowUrl, options)
+    } else if (action === "closed") {
+      return post(item.dataset.cardClosureUrl, options)
+    } else if (action === "stream") {
+      return destroy(item.dataset.cardTriageUrl, options)
+    } else if (action === "column") {
+      return post(item.dataset.cardTriageUrl, { ...options, query: { column_id: container.dataset.dropColumnId } })
+    }
+  }
+
+  #hover(container) {
+    if (this.#hoverContainer === container) return
+
+    this.#clearHover()
+    this.#hoverContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHover() {
+    this.#hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoverContainer = null
+  }
+
+  #droppableContainerFrom(event) {
+    const container = this.#containerFrom(event)
+    if (container && this.#draggedItem && this.#containerFor(this.#draggedItem) !== container) {
+      return container
+    }
+  }
+
+  #itemFrom(event) {
+    return event.target.closest("[data-drag-and-drop-target~='item']")
+  }
+
+  #containerFrom(event) {
+    return event.target.closest("[data-drag-and-drop-target~='container']")
+  }
+
+  #containerFor(item) {
+    return item?.closest("[data-drag-and-drop-target~='container']")
+  }
+
+  #destinationFor(container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return null
+    return list.querySelector("turbo-frame") || list
+  }
+
+  #suppressClick = (event) => {
+    event.preventDefault()
+    event.stopPropagation()
+  }
+}
