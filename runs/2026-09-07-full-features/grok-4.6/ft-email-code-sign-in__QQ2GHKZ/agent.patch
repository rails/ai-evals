--- /dev/null
+++ b/test/models/identity/magic_link_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Identity::MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    Identity::MagicLink.stubs(:generate_code).returns("ABC123")
+  end
+
+  test "issue creates a magic link and emails the code" do
+    assert_emails 1 do
+      magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+      assert magic_link.persisted?
+      assert_equal "kevin@37signals.com", magic_link.email_address
+      assert_equal "session", magic_link.intent
+    end
+  end
+
+  test "issue normalizes the email address" do
+    magic_link = Identity::MagicLink.issue("  Kevin@37signals.com ")
+    assert_equal "kevin@37signals.com", magic_link.email_address
+  end
+
+  test "issue replaces an existing code for the same email" do
+    first = Identity::MagicLink.issue("kevin@37signals.com")
+    second = Identity::MagicLink.issue("kevin@37signals.com")
+
+    assert_not Identity::MagicLink.exists?(first.id)
+    assert Identity::MagicLink.exists?(second.id)
+  end
+
+  test "authenticate returns the identity when the code matches" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+    identity = magic_link.authenticate("ABC123")
+    assert_equal identities(:kevin), identity
+  end
+
+  test "authenticate is case-insensitive and ignores spaces" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+    assert_equal identities(:kevin), magic_link.authenticate("abc 123")
+  end
+
+  test "authenticate creates an identity when none exists" do
+    magic_link = Identity::MagicLink.issue("new@example.com")
+
+    assert_difference -> { Identity.count }, 1 do
+      identity = magic_link.authenticate("ABC123")
+      assert_equal "new@example.com", identity.email_address
+    end
+  end
+
+  test "authenticate fails with the wrong code" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+    assert_nil magic_link.authenticate("WRONG1")
+  end
+
+  test "authenticate fails after fifteen minutes" do
+    magic_link = Identity::MagicLink.issue("kevin@37signals.com")
+
+    travel Identity::MagicLink::EXPIRATION + 1.second do
+      assert_nil magic_link.authenticate("ABC123")
+    end
+  end
+
+  test "generate_code is six uppercase characters" do
+    Identity::MagicLink.unstub(:generate_code)
+
+    code = Identity::MagicLink.generate_code
+    assert_equal 6, code.length
+    assert_match /\A[A-Z0-9]{6}\z/, code
+  end
+end
