@@ -0,0 +1,101 @@
+class Sessions::MagicLinksController < ApplicationController
+  include PendingAuthentication
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = pending_authentication
+
+    if @magic_link.nil?
+      redirect_to new_session_path
+    end
+  end
+
+  def create
+    if identity = authenticate_pending_magic_link
+      start_new_session_for identity
+      complete_pending_authentication
+    else
+      reject_magic_link
+    end
+  end
+
+  private
+    def authenticate_pending_magic_link
+      if @magic_link = pending_authentication
+        @magic_link.authenticate(params[:code])
+      end
+    end
+
+    def complete_pending_authentication
+      intent = @magic_link.intent
+      join_code = @magic_link.join_code
+      account = @magic_link.account
+
+      @magic_link.destroy
+      cookies.delete(:pending_authentication_token)
+
+      fulfill_join(join_code, account) if intent == "join"
+
+      respond_to do |format|
+        format.html { redirect_to after_magic_link_url(intent, account) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def fulfill_join(code, account)
+      join_code = Account::JoinCode.find_by(code: code, account: account)
+      join_code.redeem_if { |join_account| Current.identity.join(join_account) }
+    end
+
+    def after_magic_link_url(intent, account)
+      case intent
+      when "signup"
+        new_signup_completion_path
+      when "join"
+        join_redirect_url(account)
+      else
+        after_authentication_url
+      end
+    end
+
+    def join_redirect_url(account)
+      user = User.active.find_by!(account: account, identity: Current.identity)
+
+      if user.setup?
+        landing_url(script_name: account.slug)
+      else
+        new_users_verification_url(script_name: account.slug)
+      end
+    end
+
+    def reject_magic_link
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to magic_link_failure_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def magic_link_failure_path
+      if pending_authentication
+        new_session_magic_link_path
+      else
+        new_session_path
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
