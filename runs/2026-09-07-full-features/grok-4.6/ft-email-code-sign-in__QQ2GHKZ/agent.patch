diff --git a/app/models/identity/magic_link.rb b/app/models/identity/magic_link.rb
new file mode 100644
index 0000000..87a7e5a
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,41 @@
+class Identity::MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :account, optional: true
+
+  has_secure_password :code, validations: false
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  def self.issue(email_address, **attributes)
+    email_address = Identity.normalize_value_for(:email_address, email_address)
+    code = generate_code
+
+    magic_link = transaction do
+      where(email_address: email_address).delete_all
+      create!(email_address: email_address, code: code, **attributes)
+    end
+
+    IdentityMailer.magic_link(email_address, code).deliver_later
+    magic_link
+  end
+
+  def self.generate_code
+    SecureRandom.alphanumeric(CODE_LENGTH).upcase
+  end
+
+  def self.normalize_code(code)
+    code.to_s.gsub(/\s+/, "").upcase
+  end
+
+  def authenticate(submitted_code)
+    if !expired? && authenticate_code(self.class.normalize_code(submitted_code))
+      Identity.find_or_create_by!(email_address: email_address)
+    end
+  end
+
+  def expired?
+    created_at < EXPIRATION.ago
+  end
+end
