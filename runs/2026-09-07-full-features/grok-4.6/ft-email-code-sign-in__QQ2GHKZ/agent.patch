new file mode 100644
index 0000000..923c963
--- /dev/null
+++ b/app/controllers/concerns/pending_authentication.rb
@@ -0,0 +1,20 @@
+module PendingAuthentication
+  private
+
+  def start_pending_authentication(email_address, **attributes)
+    magic_link = Identity::MagicLink.issue(email_address, **attributes)
+    cookies[:pending_authentication_token] = {
+      value: magic_link.signed_id(expires_in: Identity::MagicLink::EXPIRATION),
+      httponly: true,
+      same_site: :lax,
+      expires: Identity::MagicLink::EXPIRATION.from_now
+    }
+    magic_link
+  end
+
+  def pending_authentication
+    if token = cookies[:pending_authentication_token]
+      Identity::MagicLink.find_signed(token)
+    end
+  end
+end
