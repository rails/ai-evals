@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    Identity::MagicLink.stubs(:generate_code).returns("ABC123")
+  end
+
+  test "new" do
+    untenanted do
+      post session_path, params: { email_address: "kevin@37signals.com" }
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "input[name=code]"
+    end
+  end
+
+  test "new without a pending authentication redirects" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create signs in with a valid code" do
+    untenanted do
+      post session_path, params: { email_address: "kevin@37signals.com" }
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: "kevin@37signals.com" }
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create with an invalid code" do
+    untenanted do
+      post session_path, params: { email_address: "kevin@37signals.com" }
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an invalid code via JSON" do
+    untenanted do
+      post session_path(format: :json), params: { email_address: "kevin@37signals.com" }
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create rejects an expired code" do
+    untenanted do
+      post session_path, params: { email_address: "kevin@37signals.com" }
+
+      travel Identity::MagicLink::EXPIRATION + 1.second do
+        post session_magic_link_path, params: { code: "ABC123" }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create for signup redirects to completion" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "newuser@example.com" } }
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+      assert Identity.exists?(email_address: "newuser@example.com")
+
+      post signup_completion_path, params: { signup: { full_name: "New User" } }
+      assert_response :redirect
+      identity = Identity.find_by!(email_address: "newuser@example.com")
+      assert identity.users.exists?
+    end
+  end
+
+  test "create for join joins the account" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    identity = identities(:mike)
+
+    assert_not identity.users.exists?(account: account)
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identity.email_address }
+
+      untenanted do
+        post session_magic_link_path, params: { code: "ABC123" }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert identity.users.exists?(account: account)
+  end
+
+  test "create signs in with the code from the email subject" do
+    Identity::MagicLink.unstub(:generate_code)
+
+    untenanted do
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post session_path, params: { email_address: "kevin@37signals.com" }
+      end
+
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+      assert_equal 6, code.length
+
+      post session_magic_link_path, params: { code: code }
+
+      assert cookies[:session_token].present?
+    end
+  end
+end
