+++ b/app/models/storage/trackable.rb
@@ -0,0 +1,53 @@
+module Storage::Trackable
+  extend ActiveSupport::Concern
+
+  prepended do
+    after_create_commit :refresh_storage_bytes_used_later
+    before_destroy :remember_storage_board
+    after_destroy_commit :refresh_remembered_storage_bytes_used_later
+  end
+
+  def purge
+    remember_storage_board
+    super
+    refresh_remembered_storage_bytes_used_later
+  end
+
+  def purge_later
+    remember_storage_board
+    super
+    refresh_remembered_storage_bytes_used_later
+  end
+
+  private
+    def refresh_storage_bytes_used_later
+      storage_board&.refresh_bytes_used_later
+    end
+
+    def remember_storage_board
+      @storage_board = storage_board
+    end
+
+    def refresh_remembered_storage_bytes_used_later
+      @storage_board&.refresh_bytes_used_later
+    end
+
+    def storage_board
+      case record
+      when Card
+        record.board if name == "image"
+      when ActionText::RichText
+        storage_board_for_rich_text
+      end
+    end
+
+    def storage_board_for_rich_text
+      return unless name == "embeds"
+
+      case owner = record.record
+      when Board then owner
+      when Card then owner.board
+      when Comment then owner.board
+      end
+    end
+end
