@@ -0,0 +1,129 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "card images count toward board usage" do
+    assert_equal 0, @board.bytes_used
+
+    attach_moon @card.image
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "card description embeds count toward board usage" do
+    embed_moon_in @card, :description
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "comment embeds count toward board usage" do
+    comment = @card.comments.create!(body: "Check this out")
+    embed_moon_in comment, :body
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "board description embeds count toward board usage" do
+    embed_moon_in @board, :public_description
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+  end
+
+  test "purging a card image decreases usage" do
+    attach_moon @card.image
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+
+    @card.image.purge_later
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moving a card transfers usage between boards" do
+    other_board = boards(:private)
+
+    attach_moon @card.image
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    @card.update!(board: other_board)
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal moon_size, other_board.reload.bytes_used
+  end
+
+  test "user avatars are not counted" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "export files are not counted" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:david))
+    export.file.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a comment with embeds decreases usage" do
+    comment = @card.comments.create!(body: "Check this out")
+    embed_moon_in comment, :body
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size, @board.reload.bytes_used
+
+    comment.destroy
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "usage is the sum of images and embeds on the board" do
+    attach_moon @card.image
+    embed_moon_in @card, :description
+    comment = @card.comments.create!(body: "File")
+    embed_moon_in comment, :body
+    embed_moon_in @board, :public_description
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal moon_size * 4, @board.reload.bytes_used
+    assert_equal moon_size * 4, accounts(:"37s").bytes_used
+  end
+
+  private
+    def attach_moon(attachment)
+      attachment.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+
+    def embed_moon_in(record, rich_text_name)
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open,
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+
+      rich_text = record.public_send(rich_text_name)
+      html = rich_text.body&.to_html.to_s
+      record.public_send("#{rich_text_name}=", ActionText::Content.new(html).append_attachables(blob))
+      record.save!
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+end
