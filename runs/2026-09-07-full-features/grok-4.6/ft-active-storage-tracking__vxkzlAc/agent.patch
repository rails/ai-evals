@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+  end
+
+  test "account usage is the sum of board usage" do
+    assert_equal 0, @account.bytes_used
+
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal file_fixture("moon.jpg").size, @account.bytes_used
+    assert_equal boards(:writebook).reload.bytes_used, @account.bytes_used
+
+    cards(:logo).update!(board: boards(:private))
+    cards(:shipping).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    expected = file_fixture("moon.jpg").size * 2
+    assert_equal expected, @account.bytes_used
+    assert_equal expected, boards(:writebook).reload.bytes_used + boards(:private).reload.bytes_used
+  end
+
+  test "usage is isolated per account" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Board::RefreshBytesUsedJob
+
+    assert_equal file_fixture("moon.jpg").size, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+end
