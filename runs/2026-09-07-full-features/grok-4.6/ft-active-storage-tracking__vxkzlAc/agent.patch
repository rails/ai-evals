+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :refresh_bytes_used_on_board_change, if: :saved_change_to_board_id?
+  end
+
+  private
+    def refresh_bytes_used_on_board_change
+      board.refresh_bytes_used_later
+
+      if old_board = Board.find_by(id: board_id_before_last_save)
+        old_board.refresh_bytes_used_later
+      end
+    end
+end
