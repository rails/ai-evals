diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..b90eb83
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,43 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  def refresh_bytes_used_later
+    Board::RefreshBytesUsedJob.perform_later(self)
+  end
+
+  def refresh_bytes_used_now
+    update_column :bytes_used, compute_bytes_used
+  end
+
+  private
+    def compute_bytes_used
+      card_image_bytes + card_description_embed_bytes + comment_embed_bytes + public_description_embed_bytes
+    end
+
+    def card_image_bytes
+      attachment_bytes record_type: "Card", record_ids: cards.select(:id), name: "image"
+    end
+
+    def card_description_embed_bytes
+      embed_bytes_for "Card", cards.select(:id)
+    end
+
+    def comment_embed_bytes
+      embed_bytes_for "Comment", Comment.where(card_id: cards.select(:id)).select(:id)
+    end
+
+    def public_description_embed_bytes
+      embed_bytes_for "Board", id
+    end
+
+    def embed_bytes_for(record_type, record_ids)
+      attachment_bytes \
+        record_type: "ActionText::RichText",
+        record_ids: ActionText::RichText.where(record_type: record_type, record_id: record_ids).select(:id),
+        name: "embeds"
+    end
+
+    def attachment_bytes(record_type:, record_ids:, name:)
+      ActiveStorage::Attachment.joins(:blob).where(record_type:, record_id: record_ids, name:).sum("active_storage_blobs.byte_size")
+    end
+end
