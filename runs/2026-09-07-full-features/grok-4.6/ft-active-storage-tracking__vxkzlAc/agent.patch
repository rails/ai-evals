+require "test_helper"
+
+class Board::RefreshBytesUsedJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "recalculates board usage from attachments" do
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_equal 0, @board.bytes_used
+
+    Board::RefreshBytesUsedJob.perform_now(@board)
+
+    assert_equal file_fixture("moon.jpg").size, @board.reload.bytes_used
+  end
+end
