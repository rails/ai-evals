+++ b/test/controllers/join_codes/magic_links_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "new" do
+    get new_join_magic_link_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_select "input[name=code]"
+  end
+
+  test "create joins with a valid code" do
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "new-joiner@example.com" }
+    end
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: magic_link_code_from_last_email }
+      end
+    end
+
+    identity = Identity.find_by!(email_address: "new-joiner@example.com")
+    user = User.active.find_by!(account: @account, identity: identity)
+
+    assert cookies[:session_token].present?
+    assert_not user.setup?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create for an existing identity joins the account" do
+    identity = identities(:mike)
+
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+    end
+
+    assert_no_difference -> { Identity.count } do
+      assert_difference -> { User.count }, 1 do
+        post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: magic_link_code_from_last_email }
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create with an invalid code" do
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "new-joiner@example.com" }
+    end
+
+    assert_no_difference -> { Identity.count } do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: "NOPE00" }
+    end
+
+    assert_redirected_to new_join_magic_link_path(join_code: @join_code.code)
+    assert_not cookies[:session_token].present?
+  end
+end
