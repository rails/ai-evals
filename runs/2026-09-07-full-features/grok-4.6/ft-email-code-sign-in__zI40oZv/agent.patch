new file mode 100644
index 0000000..1b03716
--- /dev/null
+++ b/app/controllers/concerns/magic_linking.rb
@@ -0,0 +1,18 @@
+module MagicLinking
+  private
+
+  def issue_magic_link(email_address)
+    magic_link = MagicLink.deliver(email_address)
+
+    cookies.signed[:pending_authentication_token] = {
+      value: magic_link.cookie_payload,
+      httponly: true,
+      same_site: :lax,
+      expires: MagicLink::EXPIRY_DURATION.from_now
+    }
+  end
+
+  def email_address_from_magic_link_code
+    MagicLink.email_address_for(cookies.signed[:pending_authentication_token], params[:code])
+  end
+end
