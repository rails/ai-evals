diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..b3d0280
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "deliver sends a six-character code in the subject" do
+    magic_link = nil
+
+    assert_emails 1 do
+      magic_link = MagicLink.deliver("kevin@37signals.com")
+    end
+
+    assert_equal 6, magic_link.code.length
+    assert_equal magic_link.code, magic_link.code.upcase
+    assert_includes ActionMailer::Base.deliveries.last.subject, magic_link.code
+    assert_equal [ "kevin@37signals.com" ], ActionMailer::Base.deliveries.last.to
+  end
+
+  test "email_address_for returns the address when the code matches" do
+    magic_link = MagicLink.deliver("kevin@37signals.com")
+
+    assert_equal "kevin@37signals.com", MagicLink.email_address_for(magic_link.cookie_payload, magic_link.code)
+    assert_equal "kevin@37signals.com", MagicLink.email_address_for(magic_link.cookie_payload, magic_link.code.downcase)
+  end
+
+  test "email_address_for returns nil when the code is wrong" do
+    magic_link = MagicLink.deliver("kevin@37signals.com")
+
+    assert_nil MagicLink.email_address_for(magic_link.cookie_payload, "NOPE00")
+  end
+
+  test "email_address_for returns nil after fifteen minutes" do
+    magic_link = MagicLink.deliver("kevin@37signals.com")
+    payload = magic_link.cookie_payload
+
+    travel 16.minutes
+
+    assert_nil MagicLink.email_address_for(payload, magic_link.code)
+  end
+
+  test "email_address_for still works just before expiry" do
+    magic_link = MagicLink.deliver("kevin@37signals.com")
+    payload = magic_link.cookie_payload
+
+    travel 14.minutes
+
+    assert_equal "kevin@37signals.com", MagicLink.email_address_for(payload, magic_link.code)
+  end
+end
