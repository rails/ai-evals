diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b0681a4
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,64 @@
+class MagicLink
+  EXPIRY_DURATION = 15.minutes
+  CODE_LENGTH = 6
+
+  attr_reader :email_address, :code
+
+  class << self
+    def deliver(email_address)
+      new(email_address).tap(&:deliver)
+    end
+
+    def email_address_for(payload, code)
+      return if payload.blank? || code.blank?
+      return unless payload.respond_to?(:with_indifferent_access)
+
+      payload = payload.with_indifferent_access
+
+      if payload[:email_address].present? && unexpired?(payload) && code_matches?(payload, code)
+        payload[:email_address]
+      end
+    end
+
+    def digest(code)
+      Digest::SHA256.hexdigest(normalize_code(code))
+    end
+
+    def normalize_code(code)
+      code.to_s.strip.upcase
+    end
+
+    private
+      def unexpired?(payload)
+        payload[:expires_at].to_f >= Time.current.to_f
+      end
+
+      def code_matches?(payload, code)
+        if payload[:code_digest].present?
+          ActiveSupport::SecurityUtils.secure_compare(payload[:code_digest], digest(code))
+        end
+      end
+  end
+
+  def initialize(email_address)
+    @email_address = email_address.to_s.strip.downcase
+  end
+
+  def deliver
+    generate_code
+    IdentityMailer.magic_link(email_address, code).deliver_later
+  end
+
+  def cookie_payload
+    {
+      email_address: email_address,
+      code_digest: self.class.digest(code),
+      expires_at: EXPIRY_DURATION.from_now.to_f
+    }
+  end
+
+  private
+    def generate_code
+      @code = SecureRandom.base36(CODE_LENGTH).upcase
+    end
+end
