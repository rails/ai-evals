diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..26cd48d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,106 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { vapidPublicKeyBytes } from "helpers/vapid_helpers"
+import { isNative } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+  static targets = [ "details" ]
+
+  async connect() {
+    await this.#sync()
+  }
+
+  async subscribe() {
+    if (this.#supported && this.#permission !== "denied") {
+      const registration = await this.#serviceWorkerRegistration
+
+      if (this.#permission === "default") {
+        await Notification.requestPermission()
+      }
+
+      if (this.#permission === "granted") {
+        await this.#createSubscription(registration)
+      }
+    }
+
+    await this.#sync({ persist: false })
+  }
+
+  async unsubscribe() {
+    const registration = await this.#serviceWorkerRegistration
+    const subscription = await registration?.pushManager?.getSubscription()
+
+    if (subscription) {
+      await this.#destroySubscription(subscription)
+      await subscription.unsubscribe()
+    }
+
+    await this.#sync({ persist: false })
+  }
+
+  async #sync({ persist } = { persist: true }) {
+    const subscription = await this.#existingSubscription()
+    const subscribed = this.#permission === "granted" && subscription != null
+
+    if (persist && subscribed) {
+      await this.#syncSubscriptionToServer(subscription)
+    }
+
+    this.element.classList.toggle("notifications--on", subscribed)
+    this.#revealDetails(this.#permission === "denied")
+  }
+
+  async #existingSubscription() {
+    if (!this.#supported) return null
+
+    const registration = await this.#serviceWorkerRegistration
+    return await registration?.pushManager?.getSubscription()
+  }
+
+  async #createSubscription(registration) {
+    const existing = await registration.pushManager.getSubscription()
+    const subscription = existing || await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: vapidPublicKeyBytes(this.vapidPublicKeyValue)
+    })
+
+    await this.#syncSubscriptionToServer(subscription)
+  }
+
+  async #syncSubscriptionToServer(subscription) {
+    await post(this.subscriptionsUrlValue, { body: this.#payloadFor(subscription) })
+  }
+
+  async #destroySubscription(subscription) {
+    await destroy(this.subscriptionsUrlValue, { body: this.#payloadFor(subscription) })
+  }
+
+  #payloadFor(subscription) {
+    const keys = subscription.toJSON().keys
+
+    return {
+      push_subscription: {
+        endpoint: subscription.endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    }
+  }
+
+  #revealDetails(visible) {
+    this.detailsTargets.forEach(details => details.hidden = !visible)
+  }
+
+  get #supported() {
+    return !isNative() && "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #permission() {
+    return this.#supported ? Notification.permission : "denied"
+  }
+
+  get #serviceWorkerRegistration() {
+    return navigator.serviceWorker.ready
+  }
+}
diff --git a/app/javascript/helpers/vapid_helpers.js b/app/javascript/helpers/vapid_helpers.js
new file mode 100644
index 0000000..0dd345c
--- /dev/null
+++ b/app/javascript/helpers/vapid_helpers.js
@@ -0,0 +1,12 @@
+export function vapidPublicKeyBytes(base64String) {
+  const padding = "=".repeat((4 - base64String.length % 4) % 4)
+  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+  const rawData = window.atob(base64)
+  const output = new Uint8Array(rawData.length)
+
+  for (let i = 0; i < rawData.length; i++) {
+    output[i] = rawData.charCodeAt(i)
+  }
+
+  return output
+}
