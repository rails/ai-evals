@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh-david",
+      auth_key: "auth-david",
+      user_agent: "Mozilla/5.0 Chrome"
+    )
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "deliver sends the tray title, body, and card path" do
+    WebPush.expects(:payload_send).with { |**args|
+      message = JSON.parse(args[:message])
+      args[:endpoint] == @subscription.endpoint &&
+        args[:p256dh] == @subscription.p256dh_key &&
+        args[:auth] == @subscription.auth_key &&
+        message["title"] == @notification.title &&
+        message["body"] == @notification.body &&
+        message["path"] == @notification.path
+    }
+
+    @subscription.deliver(title: @notification.title, body: @notification.body, path: @notification.path)
+  end
+
+  test "deliver destroys expired subscriptions" do
+    response = stub(body: "", inspect: "410 Gone")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(title: "Title", body: "Body", path: "/cards/1")
+    end
+  end
+end
