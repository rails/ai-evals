@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh-david",
+      auth_key: "auth-david"
+    )
+  end
+
+  test "create enqueues a push when the user has subscriptions" do
+    @user.notifications.destroy_all
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:jz))
+    end
+  end
+
+  test "create does not enqueue a push when the user has no subscriptions" do
+    @user.push_subscriptions.delete_all
+    @user.notifications.destroy_all
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:jz))
+    end
+  end
+
+  test "push_now delivers to each subscription" do
+    notification = notifications(:logo_mentioned_david)
+
+    Push::Subscription.any_instance.expects(:deliver).with(
+      title: notification.title,
+      body: notification.body,
+      path: notification.path
+    )
+
+    notification.push_now
+  end
+
+  test "push_now skips read notifications" do
+    notification = notifications(:logo_mentioned_david)
+    notification.read
+
+    Push::Subscription.any_instance.expects(:deliver).never
+
+    notification.push_now
+  end
+
+  test "event notification title and body match the tray" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_equal event_notification_title(notification.source), notification.title
+    assert_equal event_notification_body(notification.source), notification.body
+    assert_equal Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug), notification.path
+  end
+
+  test "mention notification title and body match the tray" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", notification.title
+    assert_equal notification.source.source.mentionable_content.truncate(200), notification.body
+  end
+
+  private
+    def event_notification_title(event)
+      ApplicationController.helpers.event_notification_title(event)
+    end
+
+    def event_notification_body(event)
+      ApplicationController.helpers.event_notification_body(event)
+    end
+end
