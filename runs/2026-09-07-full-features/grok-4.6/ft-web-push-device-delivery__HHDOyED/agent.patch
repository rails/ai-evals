+        push_subscription: { endpoint: "https://push.example.com/new", p256dh_key: "p256dh", auth_key: "auth" }
+      }
+    end
+
+    assert_response :ok
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/new", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create touches an existing subscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh-david",
+      auth_key: "auth-david"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: subscription.p256dh_key, auth_key: subscription.auth_key }
+      }
+    end
+
+    assert_response :ok
+  end
+
+  test "create is forbidden for another user" do
+    kevin = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(kevin), params: {
+        push_subscription: { endpoint: "https://push.example.com/kevin", p256dh_key: "p256dh", auth_key: "auth" }
+      }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/david",
+      p256dh_key: "p256dh-david",
+      auth_key: "auth-david"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: subscription.p256dh_key, auth_key: subscription.auth_key }
+      }
+    end
+
+    assert_response :ok
+  end
+end
