--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,30 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  def deliver(title:, body:, path:)
+    if vapid_configured?
+      WebPush.payload_send \
+        message: { title: title, body: body, path: path }.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: vapid_options
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized, OpenSSL::OpenSSLError
+    destroy
+  end
+
+  private
+    def vapid_configured?
+      vapid_options[:public_key].present? && vapid_options[:private_key].present?
+    end
+
+    def vapid_options
+      {
+        subject: Rails.configuration.x.vapid.subject,
+        public_key: Rails.configuration.x.vapid.public_key,
+        private_key: Rails.configuration.x.vapid.private_key
+      }
+    end
+end
