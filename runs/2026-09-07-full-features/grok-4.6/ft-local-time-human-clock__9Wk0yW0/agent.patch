diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..446ab93
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2024, 9, 12, 17, 42, 0)
+  end
+
+  test "renders a time tag with the raw timestamp for the browser" do
+    html = parse(local_time_tag(@time))
+
+    assert_select html, "time[datetime='2024-09-12T17:42:00Z'][data-controller='local-time'][data-local-time-style-value='relative']"
+    assert_select html, "time span.local-time-value[data-local-time-target='value']", text: "Sep 12"
+  end
+
+  test "renders time style" do
+    html = parse(local_time_tag(@time, style: :time))
+
+    assert_select html, "time[data-local-time-style-value='time']"
+    assert_select html, ".local-time-value", text: "5:42 PM"
+  end
+
+  test "renders date style" do
+    html = parse(local_time_tag(@time, style: :date))
+
+    assert_select html, "time[data-local-time-style-value='date']"
+    assert_select html, ".local-time-value", text: "Sep 12"
+  end
+
+  test "renders long_date style" do
+    html = parse(local_time_tag(@time, style: :long_date))
+
+    assert_select html, ".local-time-value", text: "Sep 12, 2024"
+  end
+
+  test "renders weekday as a date-only datetime so the calendar day is preserved" do
+    html = parse(local_time_tag(@time, style: :weekday))
+
+    assert_select html, "time[datetime='2024-09-12'][data-local-time-style-value='weekday']"
+    assert_select html, ".local-time-value", text: "Thursday, September 12"
+  end
+
+  test "renders datetime style" do
+    html = parse(local_time_tag(@time, style: :datetime))
+
+    assert_select html, "time[data-local-time-style-value='datetime']"
+    assert_select html, ".local-time-value", text: "9/12/24, 5:42 PM"
+  end
+
+  test "accepts extra classes and data attributes" do
+    html = parse(local_time_tag(@time, class: "event__time", data: { controller: "tooltip", extra: "1" }))
+
+    assert_select html, "time.event__time[data-controller='local-time tooltip'][data-extra='1']"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
diff --git a/test/javascript/local_time_helpers_test.js b/test/javascript/local_time_helpers_test.js
new file mode 100644
index 0000000..e82c5f4
--- /dev/null
+++ b/test/javascript/local_time_helpers_test.js
@@ -0,0 +1,48 @@
+import { formatLocalTime, formatRelative, parseLocalTime, signedDifferenceInLocalDays } from "../../app/javascript/helpers/local_time_helpers.js"
+
+function assertEqual(actual, expected, message) {
+  if (actual !== expected) {
+    throw new Error(`${message}\n  expected: ${JSON.stringify(expected)}\n  actual:   ${JSON.stringify(actual)}`)
+  }
+}
+
+const now = new Date(2024, 8, 12, 15, 0, 0) // Sep 12, 2024 3:00 PM local
+
+const twoHoursAgo = new Date(2024, 8, 12, 13, 42, 0)
+assertEqual(formatRelative(twoHoursAgo, now), "1:42 PM", "today shows clock time")
+
+const lastNight = new Date(2024, 8, 11, 22, 0, 0)
+assertEqual(formatRelative(lastNight, now), "yesterday", "last night is yesterday")
+
+const fiveDaysAgo = new Date(2024, 8, 7, 9, 0, 0)
+assertEqual(formatRelative(fiveDaysAgo, now), "5 days ago", "earlier this week is N days ago")
+
+const sixDaysAgo = new Date(2024, 8, 6, 9, 0, 0)
+assertEqual(formatRelative(sixDaysAgo, now), "Sep 6", "further back is a date")
+
+const tomorrow = new Date(2024, 8, 13, 8, 0, 0)
+assertEqual(formatRelative(tomorrow, now), "tomorrow", "overnight is tomorrow")
+
+const inThreeDays = new Date(2024, 8, 15, 8, 0, 0)
+assertEqual(formatRelative(inThreeDays, now), "in 3 days", "near future is in N days")
+
+const nextWeek = new Date(2024, 8, 20, 8, 0, 0)
+assertEqual(formatRelative(nextWeek, now), "Sep 20", "further out future is a date")
+
