diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..0f351b2 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,43 @@
 module TimeHelper
+  def local_time_tag(time, style: :relative, **options)
+    extra_data = options.delete(:data) || {}
+    extra_controller = extra_data.delete(:controller) || extra_data.delete("controller")
+
+    tag.time **options,
+      datetime: datetime_attribute_for(time, style),
+      data: extra_data.merge(
+        controller: [ "local-time", extra_controller ].compact_blank.join(" "),
+        local_time_style_value: style
+      ) do
+        tag.span class: "local-time-value", data: { local_time_target: "value" } do
+          local_time_fallback(time, style.to_sym)
+        end
+      end
+  end
+
+  private
+    def datetime_attribute_for(time, style)
+      if style.to_sym == :weekday
+        time.to_date.iso8601
+      else
+        time.iso8601
+      end
+    end
+
+    def local_time_fallback(time, style)
+      case style
+      when :time
+        time.strftime("%l:%M %p").strip
+      when :date
+        time.strftime("%b %-d")
+      when :long_date
+        time.strftime("%b %d, %Y")
+      when :weekday
+        time.strftime("%A, %B %-d")
+      when :datetime
+        time.strftime("%-m/%-d/%y, %l:%M %p").strip
+      else
+        time.strftime("%b %-d")
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..a5b4b0d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+  static targets = [ "value" ]
+
+  #timer
+
+  connect() {
+    this.update()
+
+    if (this.styleValue === "relative") {
+      this.#timer = setInterval(() => this.update(), REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  update() {
+    const date = parseLocalTime(this.element.dateTime)
+    if (Number.isNaN(date.getTime())) return
+
+    const text = formatLocalTime(date, this.styleValue)
+
+    if (this.hasValueTarget) {
+      this.valueTarget.textContent = text
+    } else {
+      this.element.textContent = text
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..fca2739
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,80 @@
+const MILLISECONDS_PER_DAY = 1000 * 60 * 60 * 24
+const DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/
+
+export function parseLocalTime(value) {
+  if (DATE_ONLY.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  return new Date(value)
+}
+
+export function formatLocalTime(date, style, now = new Date()) {
+  switch (style) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date)
+    case "long_date":
+      return formatLongDate(date)
+    case "weekday":
+      return formatWeekday(date)
+    case "datetime":
+      return formatDateTime(date)
+    default:
+      return formatRelative(date, now)
+  }
+}
+
+export function formatRelative(date, now = new Date()) {
+  const days = signedDifferenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > -6 && days < 0) {
+    return `${Math.abs(days)} days ago`
+  } else if (days > 0 && days < 6) {
+    return `in ${days} days`
+  } else {
+    return formatDate(date)
+  }
+}
+
+export function signedDifferenceInLocalDays(fromDate, toDate) {
+  return Math.round((startOfLocalDay(toDate) - startOfLocalDay(fromDate)) / MILLISECONDS_PER_DAY)
+}
+
+function startOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function formatDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date)
+}
+
+function formatLongDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+function formatWeekday(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+function formatDateTime(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    month: "numeric",
+    day: "numeric",
+    year: "2-digit",
+    hour: "numeric",
+    minute: "2-digit"
+  }).format(date)
+}
