diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..baa3336
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title newest first and highlights matches" do
+    older = newer = nil
+
+    with_current_user :kevin do
+      older = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Unique walrus older", created_at: 2.days.ago)
+      newer = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Unique walrus newer", created_at: 1.day.ago)
+    end
+
+    get search_path(q: "walrus")
+    assert_response :success
+
+    assert_select "mark", text: "walrus", count: 2
+    assert_equal [ newer, older ], css_select(".search__result").map { |result| Card.find_by!(number: result["data-card-number"]) }
+  end
+
+  test "finds cards by description" do
+    card = cards(:logo)
+    card.update!(description: "A unique narwhal in the description")
+
+    get search_path(q: "narwhal")
+    assert_response :success
+
+    assert_select ".search__result[data-card-number=?]", card.number.to_s
+    assert_select "mark", text: "narwhal"
+  end
+
+  test "finds cards by comment body" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select ".search__result[data-card-number=?]", cards(:layout).number.to_s
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "excludes draft cards and their comments" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Secret platypus draft")
+    end
+
+    get search_path(q: "platypus")
+    assert_response :success
+
+    assert_select ".search__result", count: 0
+  end
+
+  test "only returns cards from boards the user can access" do
+    private_card = with_current_user :kevin do
+      boards(:private).cards.create!(creator: users(:kevin), status: :published, title: "Private axolotl notes")
+    end
+
+    get search_path(q: "axolotl")
+    assert_response :success
+    assert_select ".search__result[data-card-number=?]", private_card.number.to_s
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "axolotl")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "empty query does not list cards" do
+    get search_path(q: "")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "search is case insensitive" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select ".search__result[data-card-number=?]", cards(:logo).number.to_s
+    assert_select "mark", text: "logo"
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "a card matching in more than one field appears once" do
+    card = cards(:logo)
+    with_current_user :kevin do
+      card.update!(title: "Repeated kraken title")
+      card.comments.create!(body: "Repeated kraken comment", creator: users(:kevin))
+    end
+
+    get search_path(q: "kraken")
+    assert_response :success
+
+    assert_select ".search__result[data-card-number=?]", card.number.to_s, count: 1
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
