+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,16 @@
+module SearchesHelper
+  def highlighted_search_text(text)
+    highlight(text.to_s, @query)
+  end
+
+  def search_snippets_for(card)
+    snippets = []
+    snippets << card.description.to_plain_text if search_match?(card.description&.to_plain_text)
+    snippets.concat card.comments.filter_map { |comment| comment.body.to_plain_text if search_match?(comment.body&.to_plain_text) }
+    snippets
+  end
+
+  def search_match?(text)
+    text.to_s.downcase.include?(@query.downcase)
+  end
+end
