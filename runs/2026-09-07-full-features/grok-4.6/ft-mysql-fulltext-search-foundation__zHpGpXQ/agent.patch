--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "matching finds published cards by title, description, or comment" do
+    title_card = boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "Contains foobar in title")
+    description_card = cards(:logo)
+    description_card.update!(description: "Contains foobar in description")
+    comment_card = cards(:layout)
+    comment_card.comments.create!(body: "Contains foobar in a comment", creator: users(:kevin))
+
+    results = Card.matching("foobar")
+
+    assert_includes results, title_card
+    assert_includes results, description_card
+    assert_includes results, comment_card
+  end
+
+  test "matching ignores draft cards" do
+    boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Draft foobar")
+
+    assert_not_includes Card.published.matching("foobar"), Card.find_by(title: "Draft foobar")
+    assert_empty Card.published.matching("foobar")
+  end
+
+  test "matching sanitizes LIKE wildcards" do
+    boards(:writebook).cards.create!(creator: users(:kevin), status: :published, title: "100% juice")
+
+    assert_empty Card.matching("100% juice extra")
+    assert_includes Card.matching("100% juice"), Card.find_by(title: "100% juice")
+  end
+end
