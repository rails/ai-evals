diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..b03cee7
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "search__form" do %>
+    <%= search_field_tag :q, @query, class: "input", placeholder: "Search cards…", autofocus: true, autocomplete: "off" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <ol class="search__results txt-align-start" role="list">
+        <% @cards.each do |card| %>
+          <li class="search__result" data-card-number="<%= card.number %>">
+            <%= link_to card_path(card), class: "search__link" do %>
+              <h3 class="search__title"><%= highlighted_search_text(card.title) %></h3>
+            <% end %>
+
+            <% search_snippets_for(card).each do |snippet| %>
+              <p class="search__snippet txt-small txt-subtle"><%= highlighted_search_text(snippet) %></p>
+            <% end %>
+          </li>
+        <% end %>
+      </ol>
+    <% else %>
+      <div class="blank-slate">No cards match this search</div>
+    <% end %>
+  <% end %>
+</section>
