diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..33536b5
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,22 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      if query.blank?
+        none
+      else
+        pattern = "%#{sanitize_sql_like(query)}%"
+
+        matching_descriptions = ActionText::RichText.where(record_type: "Card", name: "description").where("body LIKE ? ESCAPE ?", pattern, "\\")
+        matching_comments = Comment.where(id: ActionText::RichText.where(record_type: "Comment", name: "body").where("body LIKE ? ESCAPE ?", pattern, "\\").select(:record_id))
+
+        title_matches = Card.where("title LIKE ? ESCAPE ?", pattern, "\\")
+        description_matches = Card.where(id: matching_descriptions.select(:record_id))
+        comment_matches = Card.where(id: matching_comments.select(:card_id))
+
+        where(id: title_matches.or(description_matches).or(comment_matches))
+      end
+    end
+  end
+end
