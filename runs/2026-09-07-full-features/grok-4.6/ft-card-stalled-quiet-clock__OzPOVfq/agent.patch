new file mode 100644
index 0000000..66a6230
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,43 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      active.where.not(last_burst_at: nil).where(last_active_at: ..Card::Stallable::STALL_INACTIVITY_PERIOD.ago)
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_INACTIVITY_PERIOD.ago && active?
+  end
+
+  def consider_comment_burst
+    if bursting_comments?
+      record_burst
+    end
+  end
+
+  def record_burst
+    update!(last_burst_at: Time.current)
+  end
+
+  private
+    def bursting_comments?
+      creator_ids = recent_user_comment_creator_ids
+      creator_ids.size >= 3 && creator_ids.uniq.size >= 2
+    end
+
+    def recent_user_comment_creator_ids
+      comments.by_user.where(comments: { created_at: burst_window_start.. }).pluck(:creator_id)
+    end
+
+    def burst_window_start
+      burst_window.seconds.ago
+    end
+
+    def burst_window
+      auto_postpone_period / 3.0
+    end
+end
