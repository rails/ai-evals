diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..1badca2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "assignment records a burst" do
+    assert_not @card.last_burst_at
+
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.last_burst_at
+  end
+
+  test "unassignment does not record a burst" do
+    @card.toggle_assignment users(:kevin)
+    @card.update_column :last_burst_at, nil
+
+    @card.toggle_assignment users(:kevin)
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "reopening records a burst" do
+    @card.close
+    @card.update_column :last_burst_at, nil
+
+    @card.reopen
+
+    assert @card.reload.last_burst_at
+  end
+
+  test "closing does not record a burst" do
+    @card.close
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "three comments from two people within a third of the auto-close period record a burst" do
+    freeze_time
+
+    add_comment @card, :david
+    add_comment @card, :david
+    assert_not @card.reload.last_burst_at
+
+    add_comment @card, :kevin
+
+    assert @card.reload.last_burst_at
+  end
+
+  test "three comments from one person do not record a burst" do
+    add_comment @card, :david
+    add_comment @card, :david
+    add_comment @card, :david
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "two comments from two people do not record a burst" do
+    add_comment @card, :david
+    add_comment @card, :kevin
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    add_comment @card, :david
+    add_comment @card, :kevin
+    @card.comments.create!(body: "System note", creator: users(:system))
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the auto-close period do not record a burst" do
+    window = @card.auto_postpone_period / 3.0
+
+    travel_to (window + 1.day).seconds.ago do
+      add_comment @card, :david
+      add_comment @card, :kevin
+    end
+
+    add_comment @card, :jz
+
+    assert_not @card.reload.last_burst_at
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 2.weeks
+
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    add_comment @card, :david
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed and postponed cards are not stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    @card.close
+    @card.update_columns last_active_at: 2.weeks.ago, last_burst_at: 2.weeks.ago
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    @card.update_columns last_active_at: 2.weeks.ago, last_burst_at: 2.weeks.ago
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "indexed_by stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:layout)
+  end
+
+  private
+    def add_comment(card, user, body: "Hello")
+      with_current_user(user) { card.comments.create!(body: body) }
+    end
+end
