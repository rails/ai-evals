diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..8bb1f4d
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,64 @@
+# One-box Kamal deploy: Linux server, Docker, SQLite, SSL, jobs in the web container.
+#
+# Fill in your hostname, mail server, and image/registry below, then put secrets
+# in `.kamal/secrets` and run `bin/kamal setup`. Fizzy will be at https://your-host.
+# See docs/deploy.md.
+
+<% host = "fizzy.example.com" %>
+
+service: fizzy
+
+# Image to build and push (Docker Hub: user/fizzy, GHCR: ghcr.io/user/fizzy).
+image: your-user/fizzy
+
+servers:
+  web:
+    # Use an IP instead if SSH should not use the public hostname.
+    - <%= host %>
+
+# Let's Encrypt via kamal-proxy. Point DNS at the server first; ports 80 and 443 must be open.
+proxy:
+  ssl: true
+  host: <%= host %>
+
+registry:
+  # server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PRIVATE_KEY
+    - VAPID_PUBLIC_KEY
+  clear:
+    APP_HOST: <%= host %>
+
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # Jobs run on the box inside the web container (Solid Queue in Puma).
+    SOLID_QUEUE_IN_PUMA: true
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# SQLite databases and Active Storage files. Survives deploys; back it up off-box.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+
+# ssh:
+#   user: root
