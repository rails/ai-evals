+# Secrets referenced by config/deploy.yml (registry/password and env/secret).
+# Pull them from the environment, a file, or a password manager - do not commit raw values.
+
+# Docker Hub password or GHCR personal access token.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Generate with: bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# SMTP credentials for magic-link login. Omit or leave unset for an unauthenticated relay.
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional web push. Generate with:
+#   ruby -r web-push -e 'k = WebPush.generate_key; puts k.private_key; puts k.public_key'
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
