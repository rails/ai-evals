diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..04ca5d7
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @settings = @user.settings
+  end
+
+  test "never does not open a window" do
+    @settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification
+    end
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob
+  end
+
+  test "clock starts when the first notification lands" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: 4.hours.from_now do
+      create_notification
+    end
+
+    bundle = Notification::Bundle.last
+    assert_equal Time.current, bundle.started_at
+    assert_equal 4.hours.from_now, bundle.ended_at
+    assert_not bundle.delivered?
+  end
+
+  test "daily windows last one day" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: 1.day.from_now do
+      create_notification
+    end
+
+    assert_equal 1.day.from_now, Notification::Bundle.last.ended_at
+  end
+
+  test "weekly windows last one week" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :weekly)
+
+    assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: 1.week.from_now do
+      create_notification
+    end
+
+    assert_equal 1.week.from_now, Notification::Bundle.last.ended_at
+  end
+
+  test "later notifications join the open window" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    first = create_notification(source: events(:logo_published))
+    travel 1.hour
+    second = create_notification(source: events(:layout_published))
+
+    assert_equal 1, Notification::Bundle.where(user: @user).count
+    bundle = Notification::Bundle.last
+    assert_equal bundle, first.reload.bundle
+    assert_equal bundle, second.reload.bundle
+  end
+
+  test "late notifications belong in the window that has already opened" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    first = create_notification(source: events(:logo_published))
+    bundle = first.bundle
+
+    travel 5.hours
+    late = create_notification(source: events(:layout_published))
+
+    assert_equal bundle, late.reload.bundle
+    assert_equal 1, Notification::Bundle.where(user: @user).count
+  end
+
+  test "nobody ends up with two overlapping windows" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    create_notification(source: events(:logo_published))
+    create_notification(source: events(:layout_published))
+    travel 5.hours
+    create_notification(source: events(:text_published))
+
+    bundles = Notification::Bundle.where(user: @user).order(:started_at)
+    assert_equal 1, bundles.count
+    assert bundles.none? { |bundle| overlapping_undelivered_windows?(bundle) }
+  end
+
+  test "a new window opens after the previous one is delivered" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    first = create_notification(source: events(:logo_published))
+    perform_enqueued_jobs only: Notification::Bundle::DeliveryJob, at: 4.hours.from_now
+
+    assert first.reload.bundle.delivered?
+
+    travel 4.hours
+    second = create_notification(source: events(:layout_published))
+
+    assert_equal 2, Notification::Bundle.where(user: @user).count
+    assert_not_equal first.bundle, second.reload.bundle
+    assert_not second.bundle.delivered?
+    assert second.bundle.started_at >= first.bundle.ended_at
+  end
+
+  test "delivers one email with every notification in the window" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    create_notification(source: events(:logo_published))
+    create_notification(source: events(:layout_published))
+
+    assert_emails 1 do
+      perform_enqueued_jobs only: Notification::Bundle::DeliveryJob, at: 4.hours.from_now
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "2 new notifications on Fizzy", email.subject
+  end
+
+  test "does not deliver twice for the same window" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+
+    notification = create_notification
+    bundle = notification.bundle
+
+    assert_emails 1 do
+      bundle.deliver
+      bundle.deliver
+    end
+  end
+
+  test "does not open a window for inactive users" do
+    @settings.update!(bundle_email_frequency: :every_few_hours)
+    @user.update!(active: false)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification
+    end
+  end
+
+  test "does not send an email immediately" do
+    freeze_time
+    @settings.update!(bundle_email_frequency: :daily)
+
+    assert_no_emails do
+      create_notification
+    end
+  end
+
+  private
+    def create_notification(source: events(:logo_published))
+      @user.notifications.where(card: source.card).destroy_all
+      @user.notifications.create!(source: source, creator: users(:david))
+    end
+
+    def overlapping_undelivered_windows?(bundle)
+      Notification::Bundle.undelivered.where(user: bundle.user).where.not(id: bundle.id).any? do |other|
+        other.started_at < bundle.ended_at && bundle.started_at < other.ended_at
+      end
+    end
+end
