diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..822eaae
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,73 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify, inverse_of: :bundle
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+
+  class << self
+    def capture(notification)
+      if bundlable?(notification)
+        notification.user.settings.with_lock do
+          bundle = open_window_for(notification.user)
+          assign(notification, bundle)
+        end
+      end
+    end
+
+    private
+      def bundlable?(notification)
+        settings = notification.user.settings
+
+        settings.present? && !settings.never? &&
+          notification.user.active? && notification.user.identity&.email_address.present?
+      end
+
+      def open_window_for(user)
+        undelivered.find_by(user: user) || start_window(user)
+      end
+
+      def start_window(user)
+        started_at = Time.current
+
+        create!(
+          user: user,
+          started_at: started_at,
+          ended_at: started_at + user.settings.bundle_email_window_duration
+        ).tap { |bundle| schedule_delivery(bundle) }
+      end
+
+      def schedule_delivery(bundle)
+        Notification::Bundle::DeliveryJob.set(wait_until: bundle.ended_at).perform_later(bundle)
+      end
+
+      def assign(notification, bundle)
+        if notification.bundle_id != bundle.id
+          notification.update_columns(bundle_id: bundle.id)
+        end
+      end
+  end
+
+  def deliver
+    user.settings.with_lock do
+      reload
+
+      unless delivered?
+        if deliverable?
+          NotificationMailer.bundle(self).deliver_now
+        end
+
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  private
+    def deliverable?
+      notifications.any? && user.active? && account.active? && user.identity&.email_address.present?
+    end
+end
