+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc)
+    @notifications_by_board = @notifications.group_by { |notification| notification.card.board }
+
+    mail to: @user.identity.email_address, subject: subject_for_bundle
+  end
+
+  private
+    def subject_for_bundle
+      case @notifications.size
+      when 1
+        @notifications.first.payload.title
+      else
+        "#{@notifications.size} new notifications on Fizzy"
+      end
+    end
+end
