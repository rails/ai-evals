diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..7d51620 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,46 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due uses each board's own period" do
+    freeze_time
+
+    cards(:logo).update!(last_active_at: 45.days.ago)
+    private_card = boards(:private).cards.create!(title: "Old private card", creator: users(:david), status: :published, last_active_at: 45.days.ago)
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert private_card.reload.postponed?
+  end
+
+  test "auto postpone all due skips drafted, closed, and already postponed cards" do
+    period = entropies(:writebook_board).auto_postpone_period
+    stale_at = 1.day.ago - period
+
+    drafted = boards(:writebook).cards.create!(title: "Draft", creator: users(:david), status: :drafted, last_active_at: stale_at)
+    cards(:logo).update!(last_active_at: stale_at)
+    cards(:logo).close
+    cards(:shipping).update!(last_active_at: stale_at)
+    cards(:shipping).postpone
+    cards(:layout).update!(last_active_at: stale_at)
+
+    Card.auto_postpone_all_due
+
+    assert_not drafted.reload.postponed?
+    assert cards(:logo).reload.closed?
+    assert_not cards(:logo).postponed?
+    assert cards(:shipping).reload.postponed?
+    assert cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone all due is idempotent" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    Card.auto_postpone_all_due
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
 end
