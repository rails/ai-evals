+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle_email_frequency defaults to never" do
+    user = User.create!(account: accounts("37s"), name: "New person")
+
+    assert_equal "never", user.settings.bundle_email_frequency
+  end
+
+  test "bundle_email_duration matches the chosen frequency" do
+    settings = users(:kevin).settings
+
+    settings.update!(bundle_email_frequency: :never)
+    assert_nil settings.bundle_email_duration
+
+    settings.update!(bundle_email_frequency: :every_few_hours)
+    assert_equal 4.hours, settings.bundle_email_duration
+
+    settings.update!(bundle_email_frequency: :daily)
+    assert_equal 1.day, settings.bundle_email_duration
+
+    settings.update!(bundle_email_frequency: :weekly)
+    assert_equal 1.week, settings.bundle_email_duration
+  end
+end
