+class NotificationMailer < ApplicationMailer
+  def digest(window)
+    @window = window
+    @user = window.user
+    @notifications = window.notifications
+
+    mail to: @user.identity.email_address, subject: digest_subject
+  end
+
+  private
+    def digest_subject
+      count = @notifications.size
+
+      if count == 1
+        @notifications.first.payload.title
+      else
+        "#{count} new notifications on Fizzy"
+      end
+    end
+end
