diff --git a/app/models/notification/window.rb b/app/models/notification/window.rb
new file mode 100644
index 0000000..da6beca
--- /dev/null
+++ b/app/models/notification/window.rb
@@ -0,0 +1,78 @@
+class Notification::Window < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  scope :covering, ->(time) { where("starts_at <= :time AND ends_at > :time", time: time) }
+  scope :overlapping, ->(starts_at, ends_at) { where("starts_at < :ends_at AND ends_at > :starts_at", starts_at: starts_at, ends_at: ends_at) }
+  scope :unsent, -> { where(sent_at: nil) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :no_overlapping_windows
+
+  after_create_commit :deliver_later
+
+  class << self
+    def open_for(notification)
+      settings = notification.user.settings
+
+      if duration = settings&.bundle_email_duration
+        time = notification.created_at
+
+        settings.with_lock do
+          existing_window_for(notification.user, time, duration) || create!(
+            user: notification.user,
+            starts_at: time,
+            ends_at: time + duration
+          )
+        end
+      end
+    end
+
+    private
+      def existing_window_for(user, time, duration)
+        windows = user.notification_windows
+
+        windows.covering(time).first || windows.overlapping(time, time + duration).first
+      end
+  end
+
+  def deliver_later
+    Notification::Window::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    return if sent?
+
+    if deliverable?
+      NotificationMailer.digest(self).deliver_now
+    end
+
+    update!(sent_at: Time.current)
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def notifications
+    user.notifications.where(created_at: starts_at...ends_at).preloaded.ordered
+  end
+
+  private
+    def no_overlapping_windows
+      if starts_at && ends_at
+        if overlapping_windows.exists?
+          errors.add(:base, "must not overlap another window")
+        end
+      end
+    end
+
+    def overlapping_windows
+      scope = self.class.where(user_id: user_id).overlapping(starts_at, ends_at)
+      persisted? ? scope.where.not(id: id) : scope
+    end
+
+    def deliverable?
+      user.active? && account.active? && user.identity.present? && notifications.any?
+    end
+end
