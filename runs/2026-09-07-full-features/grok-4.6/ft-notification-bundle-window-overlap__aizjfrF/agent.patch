diff --git a/test/models/notification/window_test.rb b/test/models/notification/window_test.rb
new file mode 100644
index 0000000..df8f44b
--- /dev/null
+++ b/test/models/notification/window_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Notification::WindowTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "does not open a window when email bundling is off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Window.count } do
+      Notification::Window.open_for(notifications(:logo_assignment_kevin))
+    end
+  end
+
+  test "clock starts when the first notification lands" do
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    window = Notification::Window.open_for(notification)
+
+    assert_equal landed_at, window.starts_at
+    assert_equal landed_at + 4.hours, window.ends_at
+  end
+
+  test "daily windows last one day" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    window = Notification::Window.open_for(notification)
+
+    assert_equal landed_at + 1.day, window.ends_at
+  end
+
+  test "weekly windows last one week" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    window = Notification::Window.open_for(notification)
+
+    assert_equal landed_at + 1.week, window.ends_at
+  end
+
+  test "later notifications belong to the window that has already opened" do
+    first = notifications(:logo_assignment_kevin)
+    first.update_columns(created_at: Time.zone.parse("2026-03-01 10:00:00"), updated_at: Time.zone.parse("2026-03-01 10:00:00"))
+
+    window = Notification::Window.open_for(first)
+
+    second = notifications(:layout_commented_kevin)
+    second.update_columns(created_at: Time.zone.parse("2026-03-01 12:00:00"), updated_at: Time.zone.parse("2026-03-01 12:00:00"))
+
+    assert_equal window, Notification::Window.open_for(second)
+    assert_equal 1, @user.notification_windows.count
+  end
+
+  test "late notifications belong in the window that has already opened" do
+    first = notifications(:logo_assignment_kevin)
+    first.update_columns(created_at: Time.zone.parse("2026-03-01 10:00:00"), updated_at: Time.zone.parse("2026-03-01 10:00:00"))
+
+    window = Notification::Window.open_for(first)
+
+    travel_to Time.zone.parse("2026-03-01 15:00:00") do
+      late = notifications(:layout_commented_kevin)
+      late.update_columns(created_at: Time.zone.parse("2026-03-01 11:00:00"), updated_at: Time.zone.parse("2026-03-01 11:00:00"))
+
+      assert_equal window, Notification::Window.open_for(late)
+      assert_equal 1, @user.notification_windows.count
+    end
+  end
+
+  test "does not create overlapping windows" do
+    first = notifications(:logo_assignment_kevin)
+    first.update_columns(created_at: Time.zone.parse("2026-03-01 10:00:00"), updated_at: Time.zone.parse("2026-03-01 10:00:00"))
+    Notification::Window.open_for(first)
+
+    overlapping = Notification::Window.new(
+      user: @user,
+      starts_at: Time.zone.parse("2026-03-01 12:00:00"),
+      ends_at: Time.zone.parse("2026-03-01 16:00:00")
+    )
+
+    assert_not overlapping.valid?
+    assert_includes overlapping.errors[:base], "must not overlap another window"
+  end
+
+  test "opens a new window after the previous one closes" do
+    first = notifications(:logo_assignment_kevin)
+    first.update_columns(created_at: Time.zone.parse("2026-03-01 10:00:00"), updated_at: Time.zone.parse("2026-03-01 10:00:00"))
+    first_window = Notification::Window.open_for(first)
+
+    second = notifications(:layout_commented_kevin)
+    second.update_columns(created_at: Time.zone.parse("2026-03-01 14:00:00"), updated_at: Time.zone.parse("2026-03-01 14:00:00"))
+    second_window = Notification::Window.open_for(second)
+
+    assert_not_equal first_window, second_window
+    assert_equal Time.zone.parse("2026-03-01 14:00:00"), second_window.starts_at
+    assert_equal 2, @user.notification_windows.count
+  end
+
+  test "schedules one email delivery when the window closes" do
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    assert_enqueued_with(job: Notification::Window::DeliveryJob, at: landed_at + 4.hours) do
+      Notification::Window.open_for(notification)
+    end
+  end
+
+  test "sends one digest email per window" do
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    window = Notification::Window.open_for(notification)
+
+    assert_emails 1 do
+      window.deliver_now
+    end
+
+    assert window.reload.sent?
+
+    assert_no_emails do
+      window.deliver_now
+    end
+  end
+
+  test "creating a notification opens a window" do
+    assert_difference -> { Notification::Window.count }, +1 do
+      @user.notifications.create!(source: events(:shipping_published), creator: users(:david))
+    end
+  end
+
+  test "creating a notification does not open a window when email bundling is off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Window.count } do
+      @user.notifications.create!(source: events(:text_published), creator: users(:david))
+    end
+  end
+end
