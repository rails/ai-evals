+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "digest" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: :every_few_hours)
+    notification = notifications(:logo_assignment_kevin)
+    landed_at = Time.zone.parse("2026-03-01 10:00:00")
+    notification.update_columns(created_at: landed_at, updated_at: landed_at)
+
+    window = Notification::Window.create!(
+      user: user,
+      starts_at: landed_at,
+      ends_at: landed_at + 4.hours
+    )
+
+    email = NotificationMailer.digest(window)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal notification.payload.title, email.subject
+    assert_match notification.payload.title, email.body.encoded
+  end
+end
