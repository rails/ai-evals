diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..bc43d44
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,34 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  before_validation :normalize_content
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_create :broadcast_replace_list
+  after_destroy :broadcast_replace_list
+
+  delegate :card, to: :comment
+
+  def emoji?
+    content.present? && !content.match?(/[[:alnum:]]/)
+  end
+
+  private
+    def normalize_content
+      self.content = content&.strip
+    end
+
+    def broadcast_replace_list
+      comment.association(:reactions).reset
+
+      broadcast_replace_to card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions/list", locals: { comment: comment }
+    end
+end
