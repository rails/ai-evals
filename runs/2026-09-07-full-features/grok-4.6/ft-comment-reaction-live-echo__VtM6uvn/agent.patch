@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.#mine) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle(event) {
+    if (!this.#mine || event.target.closest("form")) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  closeOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.element.classList.remove("expanded")
+  }
+
+  get #mine() {
+    return this.element.dataset.creatorId === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..334a28f
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,36 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "avatar" ]
+
+  compose() {
+    this.#stampAvatar()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+  }
+
+  pick({ params }) {
+    this.inputTarget.value = params.content
+    this.formTarget.requestSubmit()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  #stampAvatar() {
+    if (this.avatarTarget.querySelector(".avatar")) return
+
+    const source = document.querySelector(".comment--new .avatar")
+    if (source) this.avatarTarget.appendChild(source.cloneNode(true))
+  }
+}
