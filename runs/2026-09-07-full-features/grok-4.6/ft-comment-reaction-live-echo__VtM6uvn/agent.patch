index 0000000..5093a81
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :new_reaction)
+    assert_equal "👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.creator
+  end
+
+  test "create a short text reaction" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "ship it" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal "ship it", @comment.reactions.last.content
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions)
+  end
+
+  test "cannot destroy another user's reaction" do
+    reaction = @comment.reactions.create!(content: "🎉", creator: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "card show includes the reactions strip" do
+    @comment.reactions.create!(content: "👍", creator: users(:jz))
+
+    get card_path(@card)
+
+    assert_response :success
+    assert_select ".reactions"
+    assert_select ".reaction", text: /👍/
+    assert_select ".reactions__trigger"
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..ed53313
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create a reaction on a comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal "👍", reaction.content
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "strips whitespace from content" do
+    reaction = @comment.reactions.create!(content: "  ship it  ")
+
+    assert_equal "ship it", reaction.content
+  end
+
+  test "content cannot be blank" do
+    reaction = @comment.reactions.build(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content cannot exceed 16 characters" do
+    reaction = @comment.reactions.build(content: "a" * 17)
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content can be 16 characters" do
+    reaction = @comment.reactions.create!(content: "a" * 16)
+
+    assert_equal 16, reaction.content.length
+  end
+
+  test "emoji? is true for emoji-only content" do
+    assert @comment.reactions.build(content: "🎉").emoji?
+    assert @comment.reactions.build(content: "💯").emoji?
+    assert_not @comment.reactions.build(content: "ship it").emoji?
+  end
+
+  test "destroying a comment destroys its reactions" do
+    @comment.reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy
+    end
+  end
+
+  test "broadcasts the reactions list on create" do
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      @comment.reactions.create!(content: "👍")
+    end
+
+    html = broadcasts.map(&:to_s).join
+    assert_includes html, "action=\"replace\""
+    assert_includes html, "👍"
+  end
+
+  test "broadcasts the reactions list on destroy" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      reaction.destroy!
+    end
+
+    html = broadcasts.map(&:to_s).join
+    assert_includes html, "action=\"replace\""
+    assert_no_match(/class="reaction"/, html)
+  end
+end
