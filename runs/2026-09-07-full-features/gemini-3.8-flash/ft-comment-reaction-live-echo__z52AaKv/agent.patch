@@ -0,0 +1,21 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :card, default: -> { comment&.card }, touch: true
+  belongs_to :comment, touch: true
+  belongs_to :user, default: -> { Current.user }
+
+  alias_method :creator, :user
+  alias_attribute :body, :content
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  broadcasts_refreshes_to :card
+
+  scope :chronologically, -> { order(created_at: :asc) }
+
+  def emoji_only?
+    content.present? && content.match?(/\A[\p{Extended_Pictographic}\u{FE0E}\u{FE0F}\u{200D}\u{1F3FB}-\u{1F3FF}\s]+\z/)
+  end
+end
