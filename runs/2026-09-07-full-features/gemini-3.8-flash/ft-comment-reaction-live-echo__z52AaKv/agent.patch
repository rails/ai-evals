+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content body ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.new(reaction_params.merge(user: Current.user, card: @card))
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.html { redirect_to @card }
+        format.json { render json: @reaction, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.html { redirect_to @card, alert: @reaction.errors.full_messages.to_sentence }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.require(:reaction).permit(:content, :body)
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..feb88e8
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,64 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { creatorId: String }
+
+  #outsideClickHandler = null
+
+  connect() {
+    this.element.classList.toggle("reaction--deleteable", this.isOwnedByCurrentUser)
+  }
+
+  disconnect() {
+    this.#stopListeningForOutsideClick()
+  }
+
+  toggle(event) {
+    if (!this.isOwnedByCurrentUser) return
+    if (event.target.closest(".reaction__delete")) return
+
+    if (this.element.classList.contains("expanded")) {
+      this.collapse()
+    } else {
+      this.expand()
+    }
+  }
+
+  expand() {
+    this.element.classList.add("expanded")
+    this.#startListeningForOutsideClick()
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+    this.#stopListeningForOutsideClick()
+  }
+
+  delete() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get isOwnedByCurrentUser() {
+    return Boolean(window.Current?.user?.id && this.creatorIdValue === window.Current.user.id)
+  }
+
+  #startListeningForOutsideClick() {
+    this.#outsideClickHandler = (event) => {
+      if (!this.element.contains(event.target)) {
+        this.collapse()
+      }
+    }
+    setTimeout(() => {
+      if (this.#outsideClickHandler) {
+        document.addEventListener("click", this.#outsideClickHandler, true)
+      }
+    }, 0)
+  }
+
+  #stopListeningForOutsideClick() {
+    if (this.#outsideClickHandler) {
+      document.removeEventListener("click", this.#outsideClickHandler, true)
+      this.#outsideClickHandler = null
+    }
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
