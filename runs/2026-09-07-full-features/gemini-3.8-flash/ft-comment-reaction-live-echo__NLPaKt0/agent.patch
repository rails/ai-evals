+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "valid reaction with emoji" do
+    reaction = @comment.reactions.build(content: "👍", reacter: users(:david))
+    assert reaction.valid?
+    assert reaction.emoji?
+  end
+
+  test "valid reaction with text up to 16 characters" do
+    reaction = @comment.reactions.build(content: "1234567890123456", reacter: users(:david))
+    assert reaction.valid?
+    assert_not reaction.emoji?
+  end
+
+  test "invalid without content" do
+    reaction = @comment.reactions.build(content: "", reacter: users(:david))
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "invalid with content longer than 16 characters" do
+    reaction = @comment.reactions.build(content: "12345678901234567", reacter: users(:david))
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "content is stripped of whitespace" do
+    reaction = @comment.reactions.create!(content: "  👍  ", reacter: users(:david))
+    assert_equal "👍", reaction.content
+  end
+
+  test "emoji? handles various emojis" do
+    assert Reaction.new(content: "🎉").emoji?
+    assert Reaction.new(content: "🚀").emoji?
+    assert Reaction.new(content: "👍❤️").emoji?
+    assert_not Reaction.new(content: "great").emoji?
+    assert_not Reaction.new(content: "👍 yes").emoji?
+  end
+
+  test "creating a reaction touches comment and card" do
+    card = @comment.card
+    comment_updated_at = @comment.updated_at
+    card_updated_at = card.updated_at
+
+    sleep 0.05
+    @comment.reactions.create!(content: "🎉", reacter: users(:david))
+
+    assert @comment.reload.updated_at > comment_updated_at
+    assert card.reload.updated_at > card_updated_at
+  end
+
+  test "destroying a reaction touches comment and card" do
+    reaction = @comment.reactions.create!(content: "🎉", reacter: users(:david))
+    card = @comment.card
+    comment_updated_at = @comment.updated_at
+    card_updated_at = card.updated_at
+
+    sleep 0.05
+    reaction.destroy!
+
+    assert @comment.reload.updated_at > comment_updated_at
+    assert card.reload.updated_at > card_updated_at
+  end
+end
