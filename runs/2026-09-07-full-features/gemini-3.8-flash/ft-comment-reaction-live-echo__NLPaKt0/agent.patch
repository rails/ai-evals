+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reacting to a comment, canceling, and removing own reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      # Initial state: trigger button is present
+      assert_selector "button.reactions__trigger"
+      assert_no_selector "form.reaction__form.expanded"
+
+      # Click trigger button to show input
+      find("button.reactions__trigger").click
+
+      # Form is visible, trigger is hidden
+      assert_selector "form.reaction__form.expanded"
+      assert_no_selector "button.reactions__trigger:not([hidden])"
+
+      # Cancel with cancel button
+      find(".reaction__cancel-btn").click
+
+      # Form is hidden, trigger is back
+      assert_no_selector "form.reaction__form.expanded"
+      assert_selector "button.reactions__trigger"
+
+      # Open form again and submit reaction
+      find("button.reactions__trigger").click
+      fill_in "reaction[content]", with: "🎉"
+      find(".reaction__submit-btn").click
+
+      # Confirming puts reaction in the strip, input is gone, button is back
+      assert_selector ".reaction", text: "🎉"
+      assert_no_selector "form.reaction__form.expanded"
+      assert_selector "button.reactions__trigger"
+
+      # Click own reaction to reveal way to remove it
+      reaction_el = find(".reaction", text: "🎉")
+      assert_no_selector ".reaction.expanded"
+      reaction_el.click
+      assert_selector ".reaction.expanded"
+
+      # Click remove button
+      within reaction_el do
+        find(".reaction__delete button").click
+      end
+
+      # Reaction is removed
+      assert_no_selector ".reaction", text: "🎉"
+    end
+  end
+
+  test "submitting reaction with Enter key and canceling with Escape key" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find("button.reactions__trigger").click
+      input = find("input.reaction__input")
+      input.fill_in with: "Nice job"
+
+      # Press escape to cancel
+      input.send_keys :escape
+      assert_no_selector "form.reaction__form.expanded"
+      assert_selector "button.reactions__trigger"
+
+      # Open form, fill in text, and press enter to confirm
+      find("button.reactions__trigger").click
+      input = find("input.reaction__input")
+      input.fill_in with: "Nice job"
+      input.send_keys :enter
+
+      # Reaction is added, button is back for the next one
+      assert_selector ".reaction", text: "Nice job"
+      assert_no_selector "form.reaction__form.expanded"
+      assert_selector "button.reactions__trigger"
+
+      # Add a second reaction to the same comment
+      find("button.reactions__trigger").click
+      input = find("input.reaction__input")
+      input.fill_in with: "🔥"
+      input.send_keys :enter
+
+      # Both reactions are present
+      assert_selector ".reaction", text: "Nice job"
+      assert_selector ".reaction", text: "🔥"
+      assert_selector "button.reactions__trigger"
+    end
+  end
+
+  test "live updates: reactions land as they happen without reloading" do
+    visit card_url(@card)
+
+    # Prove comment is visible
+    assert_selector "##{dom_id(@comment)}"
+
+    # Add reaction elsewhere
+    wait_for_cable_subscriptions
+    @comment.reactions.create!(content: "🚀", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    # Reaction lands without reload
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "🚀", wait: 5
+
+      # JZ's reaction cannot be removed by Kevin
+      jz_reaction = find(".reaction", text: "🚀")
+      assert_not jz_reaction[:class].split.include?("reaction--deleteable")
+      jz_reaction.click
+      assert_no_selector ".reaction.expanded"
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
