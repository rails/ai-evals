--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,21 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { subject.account }
+  belongs_to :subject, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :ordered, -> { order(created_at: :asc, id: :asc) }
+
+  delegate :card, to: :subject
+
+  def emoji?
+    content.present? && content.all_emoji?
+  end
+
+  def comment
+    subject if subject.is_a?(Comment)
+  end
+end
