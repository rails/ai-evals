diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..032cdd0
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+
+    first_reaction = @response.parsed_body.first
+    assert_equal reactions(:thumbs_up_kevin).id, first_reaction["id"]
+    assert_equal "👍", first_reaction["content"]
+    assert_equal users(:kevin).id, first_reaction.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reactions(:thumbs_up_kevin)), first_reaction["url"]
+  end
+
+  test "create as turbo_stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal "🎉", Reaction.last.content
+    assert_equal users(:kevin), Reaction.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🚀" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = Reaction.last
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "🚀", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "🙌" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🙌", Reaction.last.content
+  end
+
+  test "create on draft card is forbidden" do
+    draft_card = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin))
+    # bypass validation to create a comment on draft card
+    comment = draft_card.comments.build(creator: users(:kevin), account: draft_card.account)
+    comment.save!(validate: false)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(draft_card, comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create with content exceeding 16 characters fails" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "12345678901234567" } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction as turbo_stream" do
+    reaction = reactions(:thumbs_up_kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy own reaction as JSON" do
+    reaction = reactions(:thumbs_up_kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:heart_jz)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+end
