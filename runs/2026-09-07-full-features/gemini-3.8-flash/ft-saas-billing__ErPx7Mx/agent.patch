diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..2602c1d
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,52 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account Details</h2>
+    </header>
+    <div class="margin-block-half flex flex-column gap-half">
+      <div>Account Name: <strong><%= @account.name %></strong></div>
+      <div>ID: <strong>#<%= @account.external_account_id %></strong></div>
+      <div>Plan: <strong><%= @account.plan %></strong></div>
+      <div>Status: <strong><%= @account.comped? ? "Comped" : "Active" %></strong></div>
+      <div>Cards count: <strong><%= number_with_delimiter(@account.cards_count) %></strong></div>
+      <div>Bytes used: <strong><%= number_to_human_size(@account.bytes_used) %></strong></div>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Comp Account</h2>
+    </header>
+    <div class="margin-block-half flex gap-half">
+      <%= button_to "Comp", comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override Limits</h2>
+    </header>
+    <div class="margin-block-half">
+      <%= form_with model: @account.overridden_limit || @account.build_overridden_limit, url: override_admin_account_path(@account), method: :post do |f| %>
+        <div class="margin-block-half">
+          <%= f.label :card_count, "Card count", class: "label" %>
+          <%= f.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+        </div>
+        <div class="margin-block-half">
+          <%= f.label :bytes_used, "Bytes used", class: "label" %>
+          <%= f.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+        </div>
+        <div class="margin-block-half flex gap-half align-center">
+          <%= f.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", reset_admin_account_path(@account), method: :post, class: "btn btn--reversed" %>
+      </div>
+    </div>
+  </div>
+</section>
