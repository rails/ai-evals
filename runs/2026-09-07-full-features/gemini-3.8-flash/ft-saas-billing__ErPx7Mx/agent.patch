@@ -0,0 +1,30 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <ul class="margin-block-half list-unindented">
+      <% @accounts.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half justify-space-between">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <strong><%= link_to account.name, admin_account_path(account) %></strong>
+            <br>
