diff --git a/saas/test/controllers/account/settings_controller_test.rb b/saas/test/controllers/account/settings_controller_test.rb
new file mode 100644
index 0000000..fd84d55
--- /dev/null
+++ b/saas/test/controllers/account/settings_controller_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Account::BillingSettingsControllerTest < ActionDispatch::IntegrationTest
+  test "admin sees their plan and Upgrade in settings" do
+    sign_in_as :kevin
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select ".settings", text: /Free/
+    assert_select "a, button", text: "Upgrade"
+  end
+
+  test "non-admin does not see Upgrade in settings" do
+    logout_and_sign_in_as :david
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select "a, button", text: "Upgrade", count: 0
+  end
+
+  test "admin sees Unlimited plan and Upgrade when subscribed to Unlimited" do
+    sign_in_as :kevin
+
+    accounts(:"37s").create_subscription!(
+      stripe_customer_id: "cus_settings_1",
+      stripe_subscription_id: "sub_settings_1",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: accounts(:"37s").slug)
+
+    assert_response :success
+    assert_select ".settings", text: /Unlimited/
+    assert_select "a, button", text: "Upgrade"
+  end
+end
diff --git a/saas/test/controllers/account/upgrades_controller_test.rb b/saas/test/controllers/account/upgrades_controller_test.rb
new file mode 100644
index 0000000..5b2a1c1
--- /dev/null
+++ b/saas/test/controllers/account/upgrades_controller_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Account::UpgradesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "redirects to Stripe Checkout session when not subscribed" do
+    sign_in_as :mike
+
+    get saas.account_upgrade_path(script_name: @account.slug)
+
+    assert_response :redirect
+    assert_redirected_to "https://checkout.stripe.com/test_session"
+  end
+
+  test "redirects to Stripe BillingPortal session when subscribed" do
+    sign_in_as :mike
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_portal_test",
+      stripe_subscription_id: "sub_portal_test",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    get saas.account_upgrade_path(script_name: @account.slug)
+
+    assert_response :redirect
+    assert_redirected_to "https://billing.stripe.com/test_session"
+  end
+end
