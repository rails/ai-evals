diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..6523a4c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,126 @@
+class Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_in_cents
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_in_cents:)
+    @key = key.to_s
+    @name = name.to_s
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_in_cents = price_in_cents
+  end
+
+  def to_s
+    name
+  end
+
+  def to_str
+    name
+  end
+
+  def ==(other)
+    if other.is_a?(Plan)
+      key == other.key
+    elsif other.is_a?(Symbol) || other.is_a?(String)
+      k = other.to_s.underscore.downcase
+      key == k || name.downcase == other.to_s.downcase
+    else
+      super
+    end
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited?
+    key == "unlimited"
+  end
+
+  def unlimited_plus?
+    key == "unlimited_plus"
+  end
+
+  def stripe_price_id
+    case key
+    when "unlimited"
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    when "unlimited_plus"
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    end
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte,
+    price_in_cents: 0
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    price_in_cents: 20_00
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    price_in_cents: 25_00
+  )
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  class << self
+    def all
+      ALL
+    end
+
+    def [](key)
+      return FREE if key.blank?
+      return key if key.is_a?(Plan)
+
+      key_str = key.to_s.strip
+      return UNLIMITED_PLUS if key_str == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      return UNLIMITED if key_str == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+
+      case key_str.downcase
+      when "unlimited+", "unlimited_plus", "unlimited plus"
+        UNLIMITED_PLUS
+      when "unlimited"
+        UNLIMITED
+      when "free", "freev1"
+        FREE
+      else
+        FREE
+      end
+    end
+
+    def detect_plan(keys)
+      Array(keys).flatten.compact.each do |k|
+        k_str = k.to_s
+        if (extra_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]).present? && k_str == extra_id
+          return UNLIMITED_PLUS
+        end
+        if (unlim_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]).present? && k_str == unlim_id
+          return UNLIMITED
+        end
+        if k_str =~ /extra_storage|unlimited_plus|unlimited\+|500gb/i
+          return UNLIMITED_PLUS
+        end
+        if k_str =~ /unlimited|monthly/i
+          return UNLIMITED
+        end
+      end
+      FREE
+    end
+  end
+end
