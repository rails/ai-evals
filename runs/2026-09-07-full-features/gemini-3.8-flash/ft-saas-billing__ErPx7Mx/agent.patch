diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..22d0df9
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,176 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    payload = request.raw_post
+    sig_header = request.headers["Stripe-Signature"]
+    endpoint_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+    event = if endpoint_secret.present? && sig_header.present?
+      begin
+        Stripe::Webhook.construct_event(payload, sig_header, endpoint_secret)
+      rescue JSON::ParserError, Stripe::SignatureVerificationError
+        head :bad_request and return
+      end
+    else
+      begin
+        JSON.parse(payload)
+      rescue JSON::ParserError
+        head :bad_request and return
+      end
+    end
+
+    event_type = event.is_a?(Hash) ? event["type"] : event.type
+    raw_object = event.is_a?(Hash) ? event.dig("data", "object") : event.data.object
+    event_data = JSON.parse(raw_object.to_json).with_indifferent_access
+
+    case event_type
+    when "customer.subscription.created", "customer.subscription.updated"
+      handle_subscription_updated(event_data)
+    when "customer.subscription.deleted"
+      handle_subscription_deleted(event_data)
+    when "checkout.session.completed"
+      handle_checkout_completed(event_data)
+    end
+
+    head :ok
+  end
+
+  private
+    def handle_subscription_updated(sub)
+      account = find_account(sub)
+      return unless account
+
+      plan = extract_plan(sub)
+      status = sub["status"] || "active"
+      current_period_end = sub["current_period_end"] ? Time.at(sub["current_period_end"].to_i) : nil
+      cancel_at = sub["cancel_at"] ? Time.at(sub["cancel_at"].to_i) : nil
+
+      subscription = account.subscription || account.build_subscription
+      subscription.stripe_customer_id = sub["customer"] if sub["customer"].present?
+      subscription.stripe_subscription_id = sub["id"] if sub["id"].present?
+      subscription.plan_key = plan.key
+      subscription.status = status
+      subscription.current_period_end = current_period_end
+      subscription.cancel_at = cancel_at
+      if (amount = extract_amount(sub))
+        subscription.next_amount_due_in_cents = amount
+      end
+      subscription.save!
+    end
+
+    def handle_subscription_deleted(sub)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: sub["id"])
+      if subscription
+        subscription.update!(status: "canceled", plan_key: "free")
+      end
+    end
+
+    def handle_checkout_completed(session)
+      account = find_account(session)
+      return unless account
+
+      if session["subscription"].present?
+        sub_id = session["subscription"]
+        cus_id = session["customer"]
+        subscription = account.subscription || account.build_subscription
+        subscription.stripe_customer_id = cus_id if cus_id.present?
+        subscription.stripe_subscription_id = sub_id if sub_id.present?
+        subscription.status = "active"
+        if session.dig("metadata", "plan").present?
+          subscription.plan_key = Plan[session["metadata"]["plan"]].key
+        end
+        subscription.save!
+      end
+    end
+
+    def find_account(obj)
+      # By subscription ID
+      if obj["id"].to_s.start_with?("sub_")
+        if sub = Account::Subscription.find_by(stripe_subscription_id: obj["id"])
+          return sub.account
+        end
+      end
+      if obj["subscription"].present?
+        if sub = Account::Subscription.find_by(stripe_subscription_id: obj["subscription"])
+          return sub.account
+        end
+      end
+
+      # By customer ID
+      if obj["customer"].present?
+        if sub = Account::Subscription.find_by(stripe_customer_id: obj["customer"])
+          return sub.account
+        end
+      end
+
+      # By metadata
+      metadata = obj["metadata"] || {}
+      if metadata["account_id"].present?
+        if account = Account.find_by(id: metadata["account_id"])
+          return account
+        end
+      end
+      if metadata["external_account_id"].present?
+        if account = Account.find_by(external_account_id: metadata["external_account_id"])
+          return account
+        end
+      end
+
+      # By client_reference_id
+      if obj["client_reference_id"].present?
+        ref = obj["client_reference_id"]
+        if account = Account.find_by(external_account_id: ref) || Account.find_by(id: ref)
+          return account
+        end
+      end
+
+      # By nested subscription_data metadata
+      if obj.dig("subscription_data", "metadata", "account_id").present?
+        if account = Account.find_by(id: obj.dig("subscription_data", "metadata", "account_id"))
+          return account
+        end
+      end
+      if obj.dig("subscription_data", "metadata", "external_account_id").present?
+        if account = Account.find_by(external_account_id: obj.dig("subscription_data", "metadata", "external_account_id"))
+          return account
+        end
+      end
+
+      nil
+    end
+
+    def extract_plan(sub)
+      items = sub.dig("items", "data") || []
+      price_keys = items.flat_map do |item|
+        [
+          item.dig("price", "id"),
+          item.dig("price", "lookup_key"),
+          item.dig("price", "nickname"),
+          item.dig("plan", "id"),
+          item.dig("plan", "nickname")
+        ]
+      end.compact
+
+      if sub.dig("plan", "id").present?
+        price_keys << sub.dig("plan", "id")
+      end
+      if sub.dig("metadata", "plan").present?
+        price_keys << sub.dig("metadata", "plan")
+      end
+
+      Plan.detect_plan(price_keys)
+    end
+
+    def extract_amount(sub)
+      items = sub.dig("items", "data") || []
+      items.each do |item|
+        if (amount = item.dig("price", "unit_amount") || item.dig("plan", "amount"))
+          return amount
+        end
+      end
+      sub.dig("plan", "amount")
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..8ae7702
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,108 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback(:incinerate, :after) do
+      if (sub_id = subscription&.stripe_subscription_id)
+        if defined?(Stripe::Subscription)
+          Stripe::Subscription.cancel(sub_id) rescue nil
+        end
+      end
+    end
+  end
+
+  def plan
+    if active_subscription
+      active_subscription.plan
+    else
+      Plan::FREE
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def free?
+    !subscribed? && !comped?
+  end
+
+  def comped?
+    billing_waiver.present? && !billing_waiver.destroyed?
+  end
+
+  def comp!
+    (billing_waiver && !billing_waiver.destroyed?) || create_billing_waiver!
+  end
+
+  def uncomp!
+    if billing_waiver
+      billing_waiver.destroy
+      association(:billing_waiver).reset
+    end
+  end
+
+  def cards_count
+    if (overridden = overridden_limit&.card_count).present?
+      overridden
+    else
+      super
+    end
+  end
+
+  def bytes_used
+    if (overridden = overridden_limit&.bytes_used).present?
+      overridden
+    else
+      super
+    end
+  end
+
+  def override_limits!(card_count: nil, bytes_used: nil)
+    limit = overridden_limit || build_overridden_limit
+    limit.card_count = card_count.presence
+    limit.bytes_used = bytes_used.presence
+    limit.save!
+    association(:overridden_limit).reset
+  end
+
+  def reset_limits_override!
+    if overridden_limit
+      overridden_limit.destroy
+      association(:overridden_limit).reset
+    end
+  end
+
+  def out_of_cards?
+    return false if comped?
+    return false if plan.card_limit.nil?
+
+    cards_count >= plan.card_limit
+  end
+
+  def cards_remaining
+    return Float::INFINITY if plan.card_limit.nil?
+
+    [ plan.card_limit - cards_count, 0 ].max
+  end
+
+  def nearing_card_limit?
+    return false if comped?
+    return false if plan.card_limit.nil?
+
+    cards_left = cards_remaining
+    cards_left <= 100 && cards_left > 0
+  end
+
+  def stripe_customer_id
+    subscription&.stripe_customer_id
+  end
+end
