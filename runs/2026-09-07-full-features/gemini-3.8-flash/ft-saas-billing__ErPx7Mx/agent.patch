@@ -0,0 +1,51 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to admin_account_path(@account), notice: "Account #{@account.name} was comped."
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to admin_account_path(@account), notice: "Account #{@account.name} was uncomped."
+  end
+
+  def override
+    card_count = params.dig(:account_overridden_limit, :card_count) ||
+                 params.dig(:override, :card_count) ||
+                 params[:card_count]
+
+    bytes_used = params.dig(:account_overridden_limit, :bytes_used) ||
+                 params.dig(:override, :bytes_used) ||
+                 params[:bytes_used]
+
+    limit = @account.overridden_limit || @account.build_overridden_limit
+    limit.card_count = card_count.presence
+    limit.bytes_used = bytes_used.presence
+    limit.save!
+
+    redirect_to admin_account_path(@account), notice: "Override applied."
+  end
+
+  def reset
+    @account.reset_limits_override!
+    redirect_to admin_account_path(@account), notice: "Override was reset."
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) ||
+                 Account.find_by(external_account_id: params[:id]) ||
+                 Account.find(params[:id])
+    end
+end
