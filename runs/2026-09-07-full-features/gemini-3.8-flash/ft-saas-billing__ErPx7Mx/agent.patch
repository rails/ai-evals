index 0000000..37d2cc6
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can access /admin/accounts and see account list with links" do
+    sign_in_as :david
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :success
+      assert_select "a[href='#{admin_account_path(@account)}']", text: @account.name
+    end
+  end
+
+  test "non-staff cannot access /admin/accounts" do
+    sign_in_as :david
+    Identity.any_instance.stubs(:staff?).returns(false)
+
+    untenanted do
+      get "/admin/accounts"
+      assert_response :forbidden
+    end
+  end
+
+  test "account page has Comp, Uncomp, override form with Card count, Bytes used, Override, and Reset" do
+    sign_in_as :david
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    untenanted do
+      get admin_account_path(@account)
+
+      assert_response :success
+      assert_select "button, input[type=submit]", text: "Comp"
+      assert_select "button, input[type=submit]", text: "Uncomp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value='Override']"
+      assert_select "button, input[type=submit]", text: "Reset"
+    end
+  end
+
+  test "comp and uncomp account" do
+    sign_in_as :david
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_not @account.comped?
+
+    untenanted do
+      post comp_admin_account_path(@account)
+      assert_redirected_to admin_account_path(@account)
+      assert @account.reload.comped?
+
+      post uncomp_admin_account_path(@account)
+      assert_redirected_to admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "override form updates card count and bytes used, reset drops override" do
+    sign_in_as :david
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    @account.update_column(:cards_count, 15)
+
+    untenanted do
+      post override_admin_account_path(@account), params: {
+        account_overridden_limit: {
+          card_count: 950,
+          bytes_used: 2.gigabytes
+        }
+      }
+
+      assert_redirected_to admin_account_path(@account)
+      assert_equal 950, @account.reload.cards_count
+      assert_equal 2.gigabytes, @account.bytes_used
+
+      post reset_admin_account_path(@account)
+      assert_redirected_to admin_account_path(@account)
+      assert_equal 15, @account.reload.cards_count
+      assert_nil @account.overridden_limit
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..9c94c7c
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @card = cards(:unfinished_thoughts)
+  end
+
+  test "cannot create cards via JSON when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via HTML when card limit exceeded since they become drafts" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "cannot publish cards when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    post card_publish_path(@card, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert @card.reload.drafted?
+  end
+
+  test "draft card shows Upgrade pitch instead of create buttons when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    get card_draft_path(@card, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch" do
+      assert_select "a, button", text: /Upgrade/
+    end
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows countdown warning from 100 cards out" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(@card, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_includes response.body, "50 cards left"
+  end
+
+  test "staff can create cards via JSON even when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Staff card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "staff can publish cards even when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(@card, script_name: @account.slug)
+
+    assert_response :redirect
+    assert @card.reload.published?
+  end
+
+  test "staff sees create buttons even when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    get card_draft_path(@card, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "paid plan can create cards and publish even when over 1000 cards" do
+    sign_in_as :mike
+
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid_cards",
+      stripe_subscription_id: "sub_paid_cards",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    @account.update_column(:cards_count, 1500)
+
+    post card_publish_path(@card, script_name: @account.slug)
+    assert_response :redirect
+    assert @card.reload.published?
+  end
+
+  test "comped account can create cards and publish even when over 1000 cards" do
+    sign_in_as :mike
+
+    @account.comp!
+    @account.update_column(:cards_count, 1500)
+
+    post card_publish_path(@card, script_name: @account.slug)
+    assert_response :redirect
+    assert @card.reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..2d8c515
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,179 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscribes account to Unlimited plan via customer.subscription.created" do
+    payload = {
+      id: "evt_sub_created",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_unlimited_123",
+          customer: "cus_123",
+          status: "active",
+          current_period_end: 1.month.from_now.to_i,
+          items: {
+            data: [
+              {
+                price: {
+                  id: "price_unlimited",
+                  unit_amount: 2000,
+                  nickname: "Unlimited"
+                }
+              }
+            ]
+          },
+          metadata: {
+            account_id: @account.id
+          }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "Unlimited", @account.plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.plan.card_limit
+    assert_equal "sub_unlimited_123", @account.subscription.stripe_subscription_id
+    assert_equal "cus_123", @account.subscription.stripe_customer_id
+    assert_equal 2000, @account.subscription.next_amount_due_in_cents
+  end
+
+  test "subscribes account to Unlimited+ plan via customer.subscription.created" do
+    payload = {
+      id: "evt_sub_created_plus",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_unlimited_plus_123",
+          customer: "cus_plus_123",
+          status: "active",
+          current_period_end: 1.month.from_now.to_i,
+          items: {
+            data: [
+              {
+                price: {
+                  id: "price_unlimited_plus",
+                  unit_amount: 2500,
+                  nickname: "Unlimited+"
+                }
+              }
+            ]
+          },
+          metadata: {
+            external_account_id: @account.external_account_id
+          }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_nil @account.plan.card_limit
+    assert_equal 2500, @account.subscription.next_amount_due_in_cents
+  end
+
+  test "upgrades account from Unlimited to Unlimited+ via customer.subscription.updated" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_upgrade_123",
+      stripe_subscription_id: "sub_upgrade_123",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_sub_updated",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_upgrade_123",
+          customer: "cus_upgrade_123",
+          status: "active",
+          items: {
+            data: [
+              {
+                price: {
+                  id: "price_unlimited_extra_storage",
+                  unit_amount: 2500,
+                  nickname: "Unlimited+"
+                }
+              }
+            ]
+          }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "drops account back to Free plan via customer.subscription.deleted" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_del_123",
+      stripe_subscription_id: "sub_del_123",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_sub_deleted",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_del_123",
+          customer: "cus_del_123",
+          status: "canceled"
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "Free", @account.plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 1_000, @account.plan.card_limit
+  end
+
+  test "handles checkout.session.completed" do
+    payload = {
+      id: "evt_checkout",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_123",
+          customer: "cus_checkout_123",
+          subscription: "sub_checkout_123",
+          client_reference_id: @account.external_account_id.to_s,
+          metadata: {
+            plan: "unlimited"
+          }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "cus_checkout_123", @account.subscription.stripe_customer_id
+    assert_equal "sub_checkout_123", @account.subscription.stripe_subscription_id
+    assert_equal "Unlimited", @account.plan.name
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..2e9a2b9
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "default plan is Free with 1,000 cards and 1 GB storage" do
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.plan.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert @account.free?
+    assert_not @account.subscribed?
+  end
+
+  test "out_of_cards? when cards_count reaches or exceeds 1,000" do
+    @account.update_column(:cards_count, 999)
+    assert_not @account.out_of_cards?
+
+    @account.update_column(:cards_count, 1000)
+    assert @account.out_of_cards?
+
+    @account.update_column(:cards_count, 1001)
+    assert @account.out_of_cards?
+  end
+
+  test "nearing_card_limit? within 100 cards from 1,000" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column(:cards_count, 1000)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "comp! and uncomp!" do
+    assert_not @account.comped?
+
+    @account.comp!
+    assert @account.comped?
+    assert_not @account.free?
+
+    # Comped account does not run out of cards even when over 1,000
+    @account.update_column(:cards_count, 1500)
+    assert_not @account.out_of_cards?
+    assert_not @account.nearing_card_limit?
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert @account.out_of_cards?
+  end
+
+  test "override_limits! and reset_limits_override!" do
+    @account.update_column(:cards_count, 10)
+    assert_equal 10, @account.cards_count
+
+    @account.override_limits!(card_count: 950, bytes_used: 2.gigabytes)
+    @account.reload
+    assert_equal 950, @account.cards_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.nearing_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_limits_override!
+    @account.reload
+    assert_equal 10, @account.cards_count
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "Unlimited plan gives unlimited cards and 5 GB storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test1",
+      stripe_subscription_id: "sub_test1",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert_equal "Unlimited", @account.plan.name
+    assert @account.subscribed?
+    assert_nil @account.plan.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.update_column(:cards_count, 2000)
+    assert_not @account.out_of_cards?
+  end
+
+  test "Unlimited+ plan gives unlimited cards and 500 GB storage" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test2",
+      stripe_subscription_id: "sub_test2",
+      plan_key: "unlimited_plus",
+      status: "active"
+    )
+
+    assert_equal "Unlimited+", @account.plan.name
+    assert @account.subscribed?
+    assert_nil @account.plan.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+end
