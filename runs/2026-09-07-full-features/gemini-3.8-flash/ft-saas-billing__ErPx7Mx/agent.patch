diff --git a/saas/app/controllers/account/upgrades_controller.rb b/saas/app/controllers/account/upgrades_controller.rb
new file mode 100644
index 0000000..d51767e
--- /dev/null
+++ b/saas/app/controllers/account/upgrades_controller.rb
@@ -0,0 +1,58 @@
+class Account::UpgradesController < ApplicationController
+  def show_or_create; create; end
+  def show
+    create
+  end
+
+  def create
+    if Current.account.subscribed? && Current.account.stripe_customer_id.present?
+      session = create_portal_session
+    else
+      plan = Plan[params[:plan]] || Plan::UNLIMITED
+      session = create_checkout_session(plan)
+    end
+
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def create_checkout_session(plan)
+      price_id = (plan == Plan::UNLIMITED_PLUS) ?
+        (ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] || "price_unlimited_plus") :
+        (ENV["STRIPE_MONTHLY_V1_PRICE_ID"] || "price_unlimited")
+
+      Stripe::Checkout::Session.create(
+        client_reference_id: Current.account.external_account_id.to_s,
+        customer: Current.account.stripe_customer_id.presence,
+        customer_email: (Current.account.stripe_customer_id.blank? ? Current.account.owner_email : nil),
+        line_items: [
+          {
+            price: price_id,
+            quantity: 1
+          }
+        ],
+        mode: "subscription",
+        success_url: main_app.account_settings_url(script_name: Current.account.slug),
+        cancel_url: main_app.account_settings_url(script_name: Current.account.slug),
+        metadata: {
+          account_id: Current.account.id.to_s,
+          external_account_id: Current.account.external_account_id.to_s,
+          plan: plan.key
+        },
+        subscription_data: {
+          metadata: {
+            account_id: Current.account.id.to_s,
+            external_account_id: Current.account.external_account_id.to_s,
+            plan: plan.key
+          }
+        }
+      )
+    end
+
+    def create_portal_session
+      Stripe::BillingPortal::Session.create(
+        customer: Current.account.stripe_customer_id,
+        return_url: main_app.account_settings_url(script_name: Current.account.slug)
+      )
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
