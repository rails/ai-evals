diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..7c5f3a6
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,32 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Event.preloaded
+                    .for_activities
+                    .where(board: accessible_boards)
+                    .reverse_chronologically
+
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events
+    end
+
+    def accessible_boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def board_ids
+      Array(params[:board_ids]).flat_map { |id| id.to_s.split(",") }.compact_blank.presence
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).flat_map { |id| id.to_s.split(",") }.compact_blank.presence
+    end
+end
