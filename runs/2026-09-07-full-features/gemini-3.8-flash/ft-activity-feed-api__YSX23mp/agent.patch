diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..da9d557
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,334 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    logout_and_sign_in_as :david
+  end
+
+  test "GET /:account_slug/activities.json directly returns account activities" do
+    account = accounts("37s")
+    get "/#{account.external_account_id}/activities.json"
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert_not_empty activities
+  end
+
+  test "index contains all required fields with existing API representations" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+
+    required_keys = %w[
+      id action created_at description particulars url
+      eventable_type eventable board creator
+    ]
+
+    activities.each do |activity|
+      required_keys.each do |key|
+        assert activity.key?(key), "Expected #{key} to be present in activity: #{activity.inspect}"
+      end
+
+      # Board representation
+      assert activity["board"].key?("id")
+      assert activity["board"].key?("name")
+      assert activity["board"].key?("all_access")
+
+      # Creator representation
+      assert activity["creator"].key?("id")
+      assert activity["creator"].key?("name")
+      assert activity["creator"].key?("email_address")
+
+      # Description is plain text
+      refute_includes activity["description"], "<span"
+      refute_includes activity["description"], "</span>"
+    end
+  end
+
+  test "URL format for card and comment events" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    card_activity = activities.find { |a| a["eventable_type"] == "Card" }
+    comment_activity = activities.find { |a| a["eventable_type"] == "Comment" }
+
+    assert card_activity.present?
+    assert comment_activity.present?
+
+    # Card event URL opens the card
+    card = Card.find(card_activity["eventable"]["id"])
+    assert_match %r{/cards/#{card.number}\z}, card_activity["url"]
+    assert_equal card.title, card_activity["eventable"]["title"]
+
+    # Comment event URL opens the card where comment was posted and jumps to that comment
+    comment = Comment.find(comment_activity["eventable"]["id"])
+    assert_match %r{/cards/#{comment.card.number}#comment_#{comment.id}\z}, comment_activity["url"]
+    assert comment_activity["eventable"].key?("body")
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    card = cards(:logo)
+    deprecated_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_collection_changed",
+      particulars: { "particulars" => { "new_collection" => "Old Collection" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    refute_includes returned_ids, deprecated_event.id
+  end
+
+  test "includes card_title_changed events" do
+    card = cards(:logo)
+    title_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    returned_ids = @response.parsed_body.pluck("id")
+    assert_includes returned_ids, title_event.id
+
+    activity = @response.parsed_body.find { |a| a["id"] == title_event.id }
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, activity["particulars"])
+  end
+
+  test "particulars for assignment changes" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assignment_activity = @response.parsed_body.find { |a| a["action"] == "card_assigned" }
+    assert assignment_activity.present?
+    assert assignment_activity["particulars"].key?("assignee_ids")
+    assert_kind_of Array, assignment_activity["particulars"]["assignee_ids"]
+    assert_not_empty assignment_activity["particulars"]["assignee_ids"]
+
+    # Test unassigned
+    card = cards(:logo)
+    unassigned_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_unassigned",
+      particulars: { assignee_ids: [ users(:kevin).id ] }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    unassigned_activity = @response.parsed_body.find { |a| a["id"] == unassigned_event.id }
+    assert_equal({ "assignee_ids" => [ users(:kevin).id ] }, unassigned_activity["particulars"])
+  end
+
+  test "particulars for board changes" do
+    card = cards(:logo)
+    board_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Previous Board", "new_board" => "Next Board" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == board_event.id }
+    assert_equal({ "old_board" => "Previous Board", "new_board" => "Next Board" }, activity["particulars"])
+  end
+
+  test "particulars for triage events" do
+    card = cards(:logo)
+    triage_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == triage_event.id }
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "particulars for other events return empty object" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    published_activity = @response.parsed_body.find { |a| a["action"] == "card_published" }
+    closed_activity = @response.parsed_body.find { |a| a["action"] == "card_closed" }
+    comment_activity = @response.parsed_body.find { |a| a["action"] == "comment_created" }
+    sent_back_activity = @response.parsed_body.find { |a| a["action"] == "card_sent_back_to_triage" }
+
+    assert_equal({}, published_activity["particulars"])
+    assert_equal({}, closed_activity["particulars"])
+    assert_equal({}, comment_activity["particulars"])
+    assert_equal({}, sent_back_activity["particulars"])
+  end
+
+  test "missing board, title, or column values are returned as empty strings" do
+    card = cards(:logo)
+
+    board_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_board_changed",
+      particulars: {}
+    )
+    title_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_title_changed",
+      particulars: {}
+    )
+    triage_event = Event.create!(
+      board: card.board,
+      creator: users(:david),
+      eventable: card,
+      action: "card_triaged",
+      particulars: {}
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    board_act = @response.parsed_body.find { |a| a["id"] == board_event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, board_act["particulars"])
+
+    title_act = @response.parsed_body.find { |a| a["id"] == title_event.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, title_act["particulars"])
+
+    triage_act = @response.parsed_body.find { |a| a["id"] == triage_event.id }
+    assert_equal({ "column" => "" }, triage_act["particulars"])
+  end
+
+  test "filter activity by creator_ids" do
+    kevin = users(:kevin)
+    david = users(:david)
+
+    get activities_path(format: :json), params: { creator_ids: [ kevin.id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_not_empty activities
+    assert(activities.all? { |a| a["creator"]["id"] == kevin.id })
+    refute(activities.any? { |a| a["creator"]["id"] == david.id })
+  end
+
+  test "filter activity by board_ids" do
+    writebook = boards(:writebook)
+
+    get activities_path(format: :json), params: { board_ids: [ writebook.id ] }
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_not_empty activities
+    assert(activities.all? { |a| a["board"]["id"] == writebook.id })
+  end
+
+  test "returns only activity the current user can access" do
+    private_board = boards(:private)
+    Current.user = users(:kevin)
+    private_card = Card.create!(
+      board: private_board,
+      creator: users(:kevin),
+      title: "Secret Card",
+      status: "published"
+    )
+
+    # Kevin has access to private board, so Kevin sees the event
+    logout_and_sign_in_as :kevin
+    get activities_path(format: :json), params: { board_ids: [ private_board.id ] }
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), private_card.events.last.id
+
+    # David does NOT have access to private board
+    logout_and_sign_in_as :david
+    get activities_path(format: :json)
+    assert_response :success
+    refute_includes @response.parsed_body.pluck("id"), private_card.events.last.id
+
+    # David requesting the private board explicitly gets nothing
+    get activities_path(format: :json), params: { board_ids: [ private_board.id ] }
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "returns flat array newest activity first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    activities = @response.parsed_body
+    timestamps = activities.map { |a| Time.zone.parse(a["created_at"]) }
+    assert_equal timestamps, timestamps.sort.reverse
+  end
+
+  test "pagination conventions" do
+    writebook = boards(:writebook)
+    card = cards(:logo)
+
+    # Create enough events to paginate (default page 1 is 15 items)
+    10.times do |i|
+      Event.create!(
+        board: writebook,
+        creator: users(:david),
+        eventable: card,
+        action: "card_assigned",
+        particulars: { assignee_ids: [ users(:david).id ] },
+        created_at: Time.current + i.minutes
+      )
+    end
+
+    all_accessible_events = Event.where(board: writebook).for_activities.reverse_chronologically
+    assert_operator all_accessible_events.count, :>, 15
+
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal all_accessible_events.pluck(:id), actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "bearer token authentication" do
+    davids_token = identity_access_tokens(:davids_api_token).token
+    get activities_path(format: :json), headers: { "HTTP_AUTHORIZATION" => "Bearer #{davids_token}" }
+    assert_response :success
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
