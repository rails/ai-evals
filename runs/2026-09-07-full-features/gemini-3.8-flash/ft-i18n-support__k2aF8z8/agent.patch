+<% @page_title = "アカウントをインポート" %>
+<div class="panel panel--centered flex flex-column gap" style="--panel-size: 54ch;">
+  <header>
+    <h1 class="txt-x-large font-weight-black txt-tight-lines margin-block-end-none">Fizzy アカウントをインポート</h1>
+
+    <% if Fizzy.saas? %>
+      <div class="font-weight-semibold margin-block-end">自社サーバーで Fizzy を運用していて、<a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a> でのホスティングに切り替えますか？</div>
+      <div>セルフホストのアカウントからエクスポートし、以下の .zip ファイルをアップロードしてください。</div>
+    <% else %>
+      <div class="font-weight-semibold margin-block-end">ご自身のサーバーで Fizzy をホストする準備はできましたか？</div>
+      <div><a class="txt-ink txt-underline" href="https://fizzy.do" target="_blank" rel="noopener noreferrer">fizzy.do</a> アカウントをエクスポートし、以下の .zip ファイルをアップロードしてください。</div>
+    <% end %>
+  </header>
+
+  <%= form_with url: account_imports_path, class: "flex flex-column gap", data: { controller: "form upload-preview" }, multipart: true do |form| %>
+    <label class="btn input--upload">
+      <div data-upload-preview-target="placeholder">ファイルを選択…</div>
+      <div data-upload-preview-target="fileName" hidden></div>
+      <%= form.file_field :file, accept: ".zip", required: true, data: { action: "upload-preview#previewFileName", upload_preview_target: "input" } %>
+    </label>
+
+    <button type="submit" class="btn btn--link center" data-form-target="submit">
+      <span>インポートを開始 →</span>
+    </button>
+  <% end %>
+
+  <p class="txt-small">お困りの場合やサポートが必要な場合は、<a href="mailto:support@fizzy.do" class="txt-ink txt-underline">メールでお問い合わせ</a>ください。</p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/account/imports/show.ja.html.erb b/app/views/account/imports/show.ja.html.erb
new file mode 100644
index 0000000..9000e7f
--- /dev/null
+++ b/app/views/account/imports/show.ja.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "インポート状況" %>
+
+<%= turbo_stream_from @import %>
+
+<div class="panel panel--centered flex flex-column gap-half" style="--panel-size: 54ch;">
+  <h1 class="txt-x-large font-weight-black margin-block-end">インポート状況</h1>
+
+  <% case @import.status %>
+  <% when "pending", "processing" %>
+    <div class="import-status">
+      インポート処理中です。大規模なアカウントの場合は時間がかかることがあります。
+    </div>
+  <% when "completed" %>
+    <div class="import-status import-status--success">
+      <div><strong>インポートに成功しました！</strong></div>
+      <%= link_to "アカウントへ移動 →", landing_url(script_name: @import.account.slug), class: "btn btn--link" %>
+    </div>
+  <% when "failed" %>
+    <div class="import-status import-status--error">
+      <div><strong>インポート失敗</strong></div>
+      <% if @import.failed_due_to_conflict? %>
+        <div>インポートしようとしているアカウントは既に存在するようです。正しいアカウントをインポートしているかご確認ください。</div>
+      <% elsif @import.failed_due_to_invalid_export? %>
+        <div>アップロードされた .zip ファイルは Fizzy アカウントのエクスポートではないようです。</div>
+      <% else %>
+        <div>エクスポートデータが破損しているか、既存のデータと競合している可能性があります。新しいエクスポートファイルでもう一度お試しください。</div>
+      <% end %>
+      <%= link_to "やり直す", new_account_import_path, class: "btn" %>
+    </div>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
