+            <li><em>システム設定…</em> をクリックします。</li>
+            <li><em>通知</em> をクリックします。</li>
+            <li><em><%= platform.browser.capitalize %></em> をクリックします。</li>
+            <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+          <% end %>
+        </ol>
+      <% when platform.firefox? && platform.desktop? %>
+        <h3>このウェブサイトの通知をオンにする</h3>
+        <ol>
+          <li>左上の <em><%= platform.browser.capitalize %></em> をクリックします。</li>
+          <li><em>設定…</em> をクリックします。</li>
+          <li>サイドバーの <em>プライバシーとセキュリティ</em> をクリックします。</li>
+          <li><em>権限</em> までスクロールします。</li>
+          <li><em>通知</em> の横の <em>設定</em> をクリックします。</li>
+          <li><em><%= root_url %></em> の横で <em>許可</em> を選択します。</li>
+        </ol>
+
+        <h3><%= platform.browser.capitalize %> の通知をオンにする</h3>
+        <ol>
+          <% if platform.windows? %>
+            <li><em>スタート</em> をクリックし、<em>設定</em> を開きます。</li>
+            <li><em>システム &gt; 通知</em> に移動します。</li>
+            <li><%= platform.browser.capitalize %> の <em><%= icon_tag "switch", alt: "切り替えボタン" %></em> を <em>オン</em> にします。</li>
+          <% else %>
+            <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+            <li><em>システム設定…</em> をクリックします。</li>
+            <li><em>通知</em> をクリックします。</li>
+            <li><em><%= platform.browser.capitalize %></em> をクリックします。</li>
+            <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+          <% end %>
+        </ol>
+      <% when platform.chrome? && platform.desktop? %>
+        <h3>このウェブサイトの通知をオンにする</h3>
+        <ol>
+          <li>アドレスバーの <em><%= icon_tag "sliders", alt: "サイト情報を表示" %></em> アイコンをクリックします。</li>
+          <li><em>サイトの設定</em> をクリックします。</li>
+          <li>通知が <em>許可</em> されていることを確認します。</li>
+        </ol>
+
+        <h3><%= platform.browser.capitalize %> の通知をオンにする</h3>
+        <ol>
+          <% if platform.windows? %>
+            <li><em>スタート</em> をクリックし、<em>設定</em> を開きます。</li>
+            <li><em>システム &gt; 通知</em> に移動します。</li>
+            <li><%= platform.browser.capitalize %> の <em><%= icon_tag "switch", alt: "スイッチ" %></em> を <em>オン</em> にします。</li>
+          <% else %>
+            <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+            <li><em>システム設定…</em> をクリックします。</li>
+            <li><em>通知</em> をクリックします。</li>
+            <li><em><%= platform.browser == "Chrome" ? "Google Chrome" : platform.browser.capitalize %></em> をクリックします。</li>
+            <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+          <% end %>
+        </ol>
+      <% when platform.chrome? && platform.android? %>
+        <h3><%= platform.browser.capitalize %> の通知をオンにする</h3>
+        <ol>
+          <li><em><%= icon_tag "menu-dots-vertical", alt: "その他のオプション" %></em> メニューボタンをタップします。</li>
+          <li><em>設定</em> をタップします。</li>
+          <li><em>通知</em> をタップします。</li>
+          <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をタップして <em><%= platform.browser.capitalize %> の通知を許可</em> します。</li>
+          <li><em>ウェブアプリ</em> の横の <em><%= icon_tag "switch", alt: "スイッチ" %></em> をタップします。</li>
+          <li><em><%= icon_tag "bell-alert", alt: "通知ベル" %></em> をタップして <em>許可</em> を選択します。</li>
+        </ol>
+      <% when platform.safari? && platform.desktop? %>
+        <h3>このウェブサイトの通知をオンにする</h3>
+        <ol>
+          <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+          <li><em>システム設定…</em> をクリックします。</li>
+          <li><em>通知</em> をクリックします。</li>
+          <li>リストから <em><%= request.base_url %></em> をクリックします。</li>
+          <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+        </ol>
+        <h3><%= platform.browser.capitalize %> の通知をオンにする</h3>
+        <ol>
+          <li>左上の <em><%= platform.browser.capitalize %></em> をクリックします。</li>
+          <li><em>設定…</em> をクリックします。</li>
+          <li><em>Webサイト</em> タブをクリックします。</li>
+          <li>サイドバーの <em>通知</em> をクリックします。</li>
+          <li>リストから <em><%= request.base_url %></em> をクリックします。</li>
+          <li><em>許可</em> を選択します。</li>
+        </ol>
+      <% else %>
+        <p>ブラウザの設定で <em><%= root_url %></em> の通知が有効になっていることを確認してください。</p>
+    <% end %>
