+<div class="notifications-help hide-in-browser" data-notifications-target="details">
+  <h3><%= platform.operating_system %> の設定を確認</h3>
+  <% case
+    when platform.firefox? && platform.android? %>
+      <ol>
+        <li><em><%= icon_tag "menu-dots-vertical.svg", alt: "その他のオプション" %></em> メニューボタンをタップします。</li>
+        <li><em>設定</em> をタップします。</li>
+        <li><em>通知</em> をタップします。</li>
+        <li><em><%= icon_tag "switch", alt: "切り替えボタン" %></em> をタップして <em><%= platform.browser.capitalize %> の通知を許可</em> します。</li>
+      </ol>
+    <% when platform.edge? && platform.desktop? %>
+      <ol>
+        <li><em>スタート</em> をクリックし、<em>設定</em> を開きます。</li>
+        <li><em>システム &gt; 通知</em> に移動します。</li>
+        <li>Fizzy の <em><%= icon_tag "switch", alt: "切り替えボタン" %></em> を <em>オン</em> にします。</li>
+      </ol>
+    <% when (platform.firefox? || platform.chrome?) && platform.desktop? %>
+      <ol>
+        <% if platform.windows? %>
+          <li><em>スタート</em> をクリックし、<em>設定</em> を開きます。</li>
+          <li><em>システム &gt; 通知</em> に移動します。</li>
+          <li>Fizzy の <em><%= icon_tag "switch", alt: "切り替えボタン" %></em> を <em>オン</em> にします。</li>
+        <% else %>
+          <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+          <li><em>システム設定…</em> をクリックします。</li>
+          <li><em>通知</em> をクリックします。</li>
+          <li><em>Fizzy</em> をクリックします。</li>
+          <li><em><%= icon_tag "switch", alt: "通知許可スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+        <% end %>
+      </ol>
+    <% when platform.safari? && platform.desktop? %>
+      <ol>
+        <li>左上の <em aria-label="Appleメニュー"></em> をクリックします。</li>
+        <li><em>システム設定…</em> をクリックします。</li>
+        <li><em>通知</em> をクリックします。</li>
+        <li><em>Fizzy</em> をクリックします。</li>
+        <li><em><%= icon_tag "switch", alt: "通知許可スイッチ" %></em> をクリックして <em>通知を許可</em> します。</li>
+      </ol>
+    <% when (platform.safari? || platform.chrome?) && platform.ios? %>
+      <ol>
+        <li><em><%= icon_tag "gear", aria: { hidden: "true" } %></em> 設定アプリを開きます。</li>
+        <li>スクロールして <em>Fizzy</em> をタップします。</li>
+        <li><em>通知</em> をタップします。</li>
+        <li><em><%= icon_tag "switch", alt: "通知許可スイッチボタン" %></em> をタップして <em>通知を許可</em> します。</li>
+      </ol>
+    <% when platform.chrome? && platform.android? %>
+      <ol>
+        <li><em><%= icon_tag "gear", aria: { hidden: "true" } %></em> 設定アプリを開きます。</li>
+        <li><em>通知</em> をタップします。</li>
+        <li><em>アプリの通知</em> をタップします。</li>
+        <li>スクロールして <em>Fizzy</em> をタップします。</li>
+        <li><em><%= icon_tag "switch", alt: "スイッチ" %></em> をタップして <em>通知を許可</em> します。</li>
+      </ol>
+    <% else %>
+      <p>システム設定で <%= platform.browser.capitalize %> の通知が許可されていることを確認してください。</p>
+  <% end %>
+</div>
