+  <section
+    class="panel panel--centered flex flex-column gap"
+    style="--popup-icon-size: 24px; --popup-item-padding-inline: 0.5rem;"
+  >
+    <% if @accounts.any? %>
+      <h1 class="txt-x-large font-weight-black txt-tight-lines margin-none">
+        あなたの Fizzy アカウント
+      </h1>
+      <menu class="popup__list pad border-radius border" style="--block-space: var(--inline-space);">
+        <% @accounts.each do |account| %>
+          <li class="popup__item txt-medium">
+            <%= icon_tag "marker", class: "popup__icon" %>
+            <%= link_to landing_path(script_name: account.slug), class: "btn overflow-ellipsis fill-transparent popup__btn" do %>
+              <strong class="overflow-ellipsis"><%= account.name %></strong>
+            <% end %>
+          </li>
+        <% end %>
+      </menu>
+    <% else %>
+      <h1 class="txt-x-large font-weight-black margin-none">うーん...</h1>
+      <p class="margin-none-block-start">Fizzy アカウントが見つかりません。</p>
+    <% end %>
+
+    <%= link_to new_signup_path, class: "btn center txt-small margin-block-start", data: { turbo_prefetch: false } do %>
+      <span>Fizzy アカウントを新規作成</span>
+    <% end %>
+  </section>
+<% end %>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
diff --git a/app/views/sessions/new.ja.html.erb b/app/views/sessions/new.ja.html.erb
new file mode 100644
index 0000000..e5291bd
--- /dev/null
+++ b/app/views/sessions/new.ja.html.erb
@@ -0,0 +1,38 @@
+<% @page_title = "メールアドレスを入力" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Fizzy にログイン</h1>
+
+  <%= form_with url: session_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.email_field :email_address, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "username webauthn", placeholder: "メールアドレスを入力…" %>
+      </label>
+    </div>
+
+    <% if Account.accepting_signups? %>
+      <p><strong>初めてですか？</strong> アカウントを作成するには <%= link_to "新規登録", new_signup_path %> してください。<strong>すでにアカウントをお持ちですか？</strong> メールアドレスを入力していただければログインできます。</p>
+    <% else %>
+      <p>メールアドレスを入力していただければログインできます。</p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>始める</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= passkey_sign_in_button "パスキーでログイン", session_passkey_path,
+          options: @authentication_options,
+          mediation: "conditional",
+          error: { class: "txt-negative margin-block-half" },
+          cancellation: { class: "txt-subtle margin-block-half" },
+          class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
