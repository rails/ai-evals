+++ b/app/views/mailers/notification/bundle_mailer/notification.ja.html.erb
@@ -0,0 +1,22 @@
+<tr>
+  <td>
+    <h1 class="title"><%= @bundle.starts_at.strftime("%Y年%-m月%-d日 %H:%M") %>以降の通知</h1>
+    <p class="subtitle margin-block-end-double">
+      <%= link_to "#{@notifications.count}件の新しい通知", notifications_url %>があります<%= "（#{ Current.account.name }）" if @user.identity.accounts.many? %>。
+    </p>
+
+    <% @notifications.group_by { |n| n.card.board }.sort_by { |board, _| board.name.downcase }.each do |board, board_notifications| %>
+      <hr class="notification__board-separator">
+      <h2 class="notification__board"><%= link_to board.name, board %></h2>
+      <% board_notifications.group_by(&:card).each do |card, notifications| %>
+        <%= link_to card, class: "card__title" do %>#<%= card.number %> <%= card_html_title(card) %><% end %>
+        <%= render partial: "notification/bundle_mailer/notification", collection: notifications, as: :notification %>
+      <% end %>
+    <% end %>
+
+    <p class="footer">Fizzyは数時間ごとに新しい通知をメールでお知らせします。<br>
+      <%= link_to "通知の頻度を変更する", notifications_settings_url %>
+      または <%= link_to "すべてのメール通知の配信を停止する", new_notifications_unsubscribe_url(access_token: @unsubscribe_token) %>。
+    </p>
+  </td>
+</tr>
diff --git a/app/views/mailers/notification/bundle_mailer/notification.ja.text.erb b/app/views/mailers/notification/bundle_mailer/notification.ja.text.erb
