+    <div>エクスポートの準備が整いました。自動的にダウンロードが始まります。</div>
+
+    <%= link_to "データをダウンロード", rails_blob_path(@export.file, disposition: "attachment"),
+          id: "download-link",
+          class: "btn btn--link",
+          data: { turbo: false, controller: "auto-click" } %>
+  <% else %>
+    <div>ダウンロードリンクの有効期限が切れました。<%= link_to "新しいエクスポートをリクエスト", account_settings_path, class: "txt-link" %> してください。</div>
+  <% end %>
+
+</div>
