@@ -9,6 +9,23 @@ You are welcome -- and encouraged -- to modify Fizzy to your liking.
 Please see our [Development guide](docs/development.md) for how to get Fizzy set up for local development.
 
 
+## Deployment
+
+Fizzy is designed to be easily deployed to a single Linux server running Docker with [Kamal](https://kamal-deploy.org/).
+
+1. Configure `config/deploy.yml`:
+   - Set `image` with your Docker registry username/repo (e.g. `your-user/fizzy`).
+   - Set your server's IP address under `servers.web`.
+   - Set your domain name under `proxy.host`.
+   - Configure your outgoing SMTP mail server settings under `env.clear`.
+2. Configure `.kamal/secrets`:
+   - `RAILS_MASTER_KEY` (generate one with `bin/rails secret`).
+   - `KAMAL_REGISTRY_PASSWORD` (access token for your Docker registry).
+   - `SMTP_PASSWORD` (password for your SMTP mail server).
+3. Run `kamal setup` to bootstrap the server, configure SSL from the proxy, and deploy Fizzy.
+
+Your data (SQLite databases and uploaded files) is stored in a Docker volume (`fizzy_storage`) and persists across deployments. Background jobs run automatically on the box in the same container.
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..6134314
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,63 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: your-user/fizzy
+
+# Deploy to this server.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt from kamal-proxy.
+proxy:
+  ssl: true
+  host: &app_host app.example.com
+
+# Where you keep your container images.
+registry:
+  # Specify the registry server, if you're not using Docker Hub
+  # server: registry.digitalocean.com / ghcr.io / ...
+  username: your-user
+
+  # Always use an access token rather than real password (pulled from .kamal/secrets).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Configure builder setup.
+builder:
+  arch: amd64
+
+# Use a persistent storage volume for SQLite database files and Active Storage uploads.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run Solid Queue inside Puma so background jobs run in the same container
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Hostname for URLs generated in mailers and notifications
+    APP_HOST: *app_host
+
+    # Outgoing mail server configuration
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # MAILER_FROM_ADDRESS: Fizzy <support@example.com>
+  secret:
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
