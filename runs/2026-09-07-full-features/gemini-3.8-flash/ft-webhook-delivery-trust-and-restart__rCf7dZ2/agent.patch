--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,29 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track_success
+    reset if consecutive_failures_count.positive? || first_failure_at.present?
+  end
+
+  def track_failure
+    self.first_failure_at ||= Time.current
+    self.consecutive_failures_count += 1
+    save!
+
+    if delinquent?
+      webhook.deactivate
+    end
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_THRESHOLD && first_failure_at <= FAILURE_PERIOD.ago
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
