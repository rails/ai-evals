@@ -0,0 +1,87 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "auto-created with webhook" do
+    new_webhook = Webhook.create!(name: "New Webhook", url: "https://example.com/wh", board: boards(:writebook))
+    assert new_webhook.delinquency_tracker.present?
+    assert_equal 0, new_webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil new_webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "track_failure increments consecutive failures and sets first_failure_at" do
+    assert_nil @tracker.first_failure_at
+    assert_equal 0, @tracker.consecutive_failures_count
+
+    freeze_time do
+      @tracker.track_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+
+      # Second failure keeps original first_failure_at
+      travel 10.minutes
+      @tracker.track_failure
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 10.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "track_success resets consecutive failures and first_failure_at" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    @tracker.track_success
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not deactivate when fewer than 10 failures" do
+    @tracker.update!(consecutive_failures_count: 8, first_failure_at: 2.hours.ago)
+    @tracker.track_failure
+
+    assert_equal 9, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "does not deactivate when 10 failures happen in less than an hour" do
+    freeze_time do
+      10.times do
+        travel 2.minutes
+        @tracker.track_failure
+      end
+
+      assert_equal 10, @tracker.consecutive_failures_count
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "deactivates when 10 failures happen over an hour" do
+    freeze_time do
+      @tracker.track_failure # 1st failure
+
+      travel 65.minutes
+
+      9.times do
+        @tracker.track_failure
+      end
+
+      assert_equal 10, @tracker.consecutive_failures_count
+      assert_not @webhook.reload.active?, "Webhook should be switched off after 10 failures over an hour"
+    end
+  end
+
+  test "activating a webhook resets the delinquency tracker" do
+    @webhook.deactivate
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    @tracker.reload
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
