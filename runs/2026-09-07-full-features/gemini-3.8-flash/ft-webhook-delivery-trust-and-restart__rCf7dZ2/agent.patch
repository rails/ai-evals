@@ -0,0 +1,25 @@
+module Triggerable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :trigger_webhooks_later
+  end
+
+  def trigger_webhooks
+    return unless board
+
+    board.webhooks.active.subscribing_to(action).each do |webhook|
+      next unless webhook.subscribes_to?(action)
+
+      delivery = webhook_deliveries.find_or_create_by!(webhook: webhook, account: account)
+      delivery.deliver_later
+    end
+  end
+
+  private
+    def trigger_webhooks_later
+      trigger_webhooks
+    end
+end
+
+Event::Triggerable = Triggerable
