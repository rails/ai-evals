diff --git a/test/models/event/triggerable_test.rb b/test/models/event/triggerable_test.rb
new file mode 100644
index 0000000..5bcc238
--- /dev/null
+++ b/test/models/event/triggerable_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Event::TriggerableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @user = users(:david)
+    @card = cards(:logo)
+  end
+
+  test "event creation creates delivery and enqueues job for subscribed active webhook" do
+    webhook = webhooks(:active) # on writebook, subscribed to card_published, card_assigned, card_closed
+    stub_request(:post, webhook.url).to_return(status: 200, body: "ok")
+
+    assert_difference -> { webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(
+          action: "card_closed",
+          creator: @user,
+          eventable: @card
+        )
+      end
+    end
+
+    delivery = webhook.deliveries.last
+    assert_equal "completed", delivery.state
+    assert_equal 200, delivery.response["code"]
+  end
+
+  test "event creation does not trigger inactive webhooks" do
+    webhook = webhooks(:inactive) # inactive
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        webhook.board.events.create!(
+          action: "card_published",
+          creator: @user,
+          eventable: @card
+        )
+      end
+    end
+  end
+
+  test "event creation does not trigger webhooks not subscribed to the action" do
+    webhook = Webhook.create!(
+      board: @board,
+      name: "Only Comments",
+      url: "https://example.com/comments",
+      subscribed_actions: [ "comment_created" ]
+    )
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(
+          action: "card_closed",
+          creator: @user,
+          eventable: @card
+        )
+      end
+    end
+  end
+
+  test "event creation does not trigger webhooks on other boards" do
+    other_board = boards(:private)
+    webhook = Webhook.create!(
+      board: other_board,
+      name: "Other Board Webhook",
+      url: "https://example.com/other",
+      subscribed_actions: [ "card_closed" ]
+    )
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(
+          action: "card_closed",
+          creator: @user,
+          eventable: @card
+        )
+      end
+    end
+  end
+
+  test "repeatedly failing webhook gets switched off after 10 failures over an hour" do
+    webhook = Webhook.create!(
+      board: @board,
+      name: "Flaky Webhook",
+      url: "https://example.com/flaky",
+      subscribed_actions: [ "card_closed" ]
+    )
+    stub_request(:post, webhook.url).to_return(status: 500, body: "error")
+
+    freeze_time do
+      # 1st failure
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(action: "card_closed", creator: @user, eventable: @card)
+      end
+      assert webhook.reload.active?
+      assert_equal 1, webhook.reload.delinquency_tracker.consecutive_failures_count
+
+      # Advance time past 1 hour
+      travel 65.minutes
+
+      # 9 more failures
+      9.times do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @board.events.create!(action: "card_closed", creator: @user, eventable: @card)
+        end
+      end
+
+      assert_equal 10, webhook.reload.delinquency_tracker.consecutive_failures_count
+      assert_not webhook.reload.active?, "Webhook should be deactivated after 10 failures over an hour"
+
+      # Future events do not trigger deactivated webhook
+      assert_no_difference -> { webhook.deliveries.count } do
+        perform_enqueued_jobs only: Webhook::DeliveryJob do
+          @board.events.create!(action: "card_closed", creator: @user, eventable: @card)
+        end
+      end
+    end
+  end
+end
