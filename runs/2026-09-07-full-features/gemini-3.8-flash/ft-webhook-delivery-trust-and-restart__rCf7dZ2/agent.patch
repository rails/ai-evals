+++ b/app/models/webhook/delivery.rb
@@ -9,6 +9,52 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...1.week.ago) }
+
+  def self.cleanup
+    expired.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return unless pending? && webhook&.active?
+
+    in_progress!
+
+    timestamp = (event&.created_at || Time.current).utc.iso8601
+    payload_body = webhook.payload_for(event)
+    signature = webhook.signature_for(payload_body)
+
+    request_headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => timestamp,
+      "X-Webhook-Signature" => signature
+    }
+
+    self.request = { headers: request_headers }
+
+    http_response = post_payload(webhook.url, payload_body, request_headers)
+
+    self.state = :completed
+    self.response = { code: http_response.code.to_i }
+    save!
+
+    if succeeded?
+      webhook.delinquency_tracker.track_success
+    else
+      webhook.delinquency_tracker.track_failure
+    end
+  rescue StandardError => e
+    self.state = :errored
+    self.response = { error: e.message }
+    save!
+
+    webhook.delinquency_tracker.track_failure
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -27,6 +73,20 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code]&.between?(200, 299)
   end
+
+  private
+    def post_payload(url, body, headers)
+      uri = URI.parse(url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = (uri.scheme == "https")
+      http.open_timeout = 10
+      http.read_timeout = 10
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http.request(request)
+    end
 end
