+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,323 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of activities, newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_operator @response.parsed_body.length, :>, 0
+
+    created_at_times = @response.parsed_body.map { |a| Time.iso8601(a["created_at"]) }
+    assert_equal created_at_times.sort.reverse, created_at_times
+  end
+
+  test "index via explicit .json path" do
+    slug = ActiveRecord::FixtureSet.identify("37signals")
+    get "/#{slug}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index via activities_path with format json" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index rejects HTML" do
+    get activities_path, as: :html
+
+    assert_response :not_acceptable
+  end
+
+  test "index includes all required event attributes" do
+    get activities_path, as: :json
+
+    assert_response :success
+    required_keys = %w[ id action created_at description particulars url eventable_type eventable board creator ]
+
+    @response.parsed_body.each do |activity|
+      required_keys.each do |key|
+        assert activity.key?(key), "Expected activity #{activity['id']} to contain key '#{key}'"
+      end
+    end
+  end
+
+  test "uses existing API representations for eventable, board, and creator" do
+    get activities_path, as: :json
+
+    card_activity = @response.parsed_body.find { |a| a["eventable_type"] == "Card" }
+    assert_not_nil card_activity
+    assert card_activity["eventable"].key?("number")
+    assert card_activity["eventable"].key?("title")
+    assert card_activity["eventable"].key?("status")
+    assert card_activity["eventable"].key?("description")
+    assert card_activity["eventable"].key?("url")
+    assert card_activity["eventable"].key?("board")
+
+    comment_activity = @response.parsed_body.find { |a| a["eventable_type"] == "Comment" }
+    assert_not_nil comment_activity
+    assert comment_activity["eventable"].key?("body")
+    assert comment_activity["eventable"]["body"].key?("plain_text")
+    assert comment_activity["eventable"]["body"].key?("html")
+    assert comment_activity["eventable"].key?("creator")
+    assert comment_activity["eventable"].key?("card")
+
+    # Board representation
+    board_json = card_activity["board"]
+    assert board_json.key?("id")
+    assert board_json.key?("name")
+    assert board_json.key?("all_access")
+    assert board_json.key?("url")
+
+    # Creator representation
+    creator_json = card_activity["creator"]
+    assert creator_json.key?("id")
+    assert creator_json.key?("name")
+    assert creator_json.key?("role")
+    assert creator_json.key?("email_address")
+    assert creator_json.key?("avatar_url")
+  end
+
+  test "returns plain text descriptions" do
+    get activities_path, as: :json
+
+    @response.parsed_body.each do |activity|
+      assert_no_match(/<span|<div|<p>/, activity["description"])
+      event = Event.find(activity["id"])
+      assert_equal event.description_for(users(:kevin)).to_plain_text.to_s, activity["description"]
+    end
+  end
+
+  test "url opens card for card events and jumps to comment for comment events" do
+    get activities_path, as: :json
+
+    card_activity = @response.parsed_body.find { |a| a["eventable_type"] == "Card" }
+    card = Card.find(card_activity["eventable"]["id"])
+    assert_equal card_url(card), card_activity["url"]
+    assert_no_match(/#/, card_activity["url"])
+
+    comment_activity = @response.parsed_body.find { |a| a["eventable_type"] == "Comment" }
+    comment = Comment.find(comment_activity["eventable"]["id"])
+    expected_comment_url = card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment))
+    assert_equal expected_comment_url, comment_activity["url"]
+    assert_includes comment_activity["url"], "#comment_"
+  end
+
+  test "particulars for assignment changes contain assignee_ids" do
+    get activities_path, as: :json
+
+    assignment_activity = @response.parsed_body.find { |a| a["action"] == "card_assigned" }
+    assert_not_nil assignment_activity
+    assert assignment_activity["particulars"].key?("assignee_ids")
+    assert_kind_of Array, assignment_activity["particulars"]["assignee_ids"]
+  end
+
+  test "particulars for assignment changes with empty particulars" do
+    event = events(:logo_published)
+    event.update!(action: "card_assigned", particulars: {})
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "assignee_ids" => [] }, activity["particulars"])
+  end
+
+  test "particulars for board changes contain old_board and new_board" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Board Alpha", "new_board" => "Board Beta" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_board" => "Board Alpha", "new_board" => "Board Beta" }, activity["particulars"])
+  end
+
+  test "particulars for board changes fall back to empty strings when missing" do
+    event = events(:logo_published)
+    event.update!(action: "card_board_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "particulars for title changes contain old_title and new_title" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Name", "new_title" => "New Name" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_title" => "Old Name", "new_title" => "New Name" }, activity["particulars"])
+  end
+
+  test "particulars for title changes fall back to empty strings when missing" do
+    event = events(:logo_published)
+    event.update!(action: "card_title_changed", particulars: {})
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity["particulars"])
+  end
+
+  test "particulars for triage events contain column" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_triaged",
+      particulars: { "particulars" => { "column" => "In Progress" } }
+    )
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "particulars for triage events fall back to empty string when missing" do
+    event = events(:logo_published)
+    event.update!(action: "card_triaged", particulars: {})
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal({ "column" => "" }, activity["particulars"])
+  end
+
+  test "particulars for other events return empty object" do
+    get activities_path, as: :json
+
+    published = @response.parsed_body.find { |a| a["action"] == "card_published" }
+    assert_equal({}, published["particulars"])
+
+    commented = @response.parsed_body.find { |a| a["action"] == "comment_created" }
+    assert_equal({}, commented["particulars"])
+
+    closed = @response.parsed_body.find { |a| a["action"] == "card_closed" }
+    assert_equal({}, closed["particulars"])
+
+    triage_back = @response.parsed_body.find { |a| a["action"] == "card_sent_back_to_triage" }
+    assert_equal({}, triage_back["particulars"])
+  end
+
+  test "omits deprecated card_collection_changed events" do
+    event = events(:logo_published)
+    event.update!(action: "card_collection_changed")
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, event.id
+  end
+
+  test "includes card_title_changed events" do
+    event = events(:logo_published)
+    event.update!(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+
+    get activities_path, as: :json
+
+    assert_includes @response.parsed_body.map { |a| a["id"] }, event.id
+  end
+
+  test "filter by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    assert_response :success
+    assert_operator @response.parsed_body.length, :>, 0
+    assert @response.parsed_body.all? { |a| a["creator"]["id"] == users(:david).id }
+
+    # Multiple creator_ids
+    get activities_path, params: { creator_ids: [ users(:david).id, users(:kevin).id ] }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.all? { |a| [ users(:david).id, users(:kevin).id ].include?(a["creator"]["id"]) }
+  end
+
+  test "filter by board_ids" do
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_response :success
+    assert_operator @response.parsed_body.length, :>, 0
+    assert @response.parsed_body.all? { |a| a["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "returns only activity current user can access" do
+    # Kevin has access to boards(:private), David does not
+    private_card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published")
+    end
+    private_event = private_card.events.find_by(action: "card_published")
+
+    # Kevin can see it
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+
+    # David cannot see it
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+
+    # David cannot see it even if requested via board_ids
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "paginates results following existing API conventions" do
+    board = boards(:writebook)
+    card = cards(:logo)
+    Current.set(user: users(:kevin)) do
+      25.times do |i|
+        board.events.create!(
+          action: "card_published",
+          creator: users(:kevin),
+          eventable: card,
+          created_at: 10.minutes.ago + i.seconds
+        )
+      end
+    end
+
+    get activities_path, as: :json
+    assert_response :success
+
+    link_header = @response.headers["Link"]
+    assert link_header.present?, "Expected Link header for pagination"
+    assert_match(/rel="next"/, link_header)
+
+    page_1_ids = @response.parsed_body.map { |a| a["id"] }
+
+    next_url = next_page_from_link_header(link_header)
+    assert next_url.present?
+
+    get next_url, as: :json
+    assert_response :success
+    page_2_ids = @response.parsed_body.map { |a| a["id"] }
+
+    assert_operator page_2_ids.length, :>, 0
+    assert_empty page_1_ids & page_2_ids
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..d247fab
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "api_particulars for assignment changes" do
+    event = events(:logo_assignment_jz)
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event.api_particulars)
+
+    event.action = "card_unassigned"
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, event.api_particulars)
+
+    event.particulars = {}
+    assert_equal({ "assignee_ids" => [] }, event.api_particulars)
+
+    event.particulars = nil
+    assert_equal({ "assignee_ids" => [] }, event.api_particulars)
+  end
+
+  test "api_particulars for board changes" do
+    event = events(:logo_published)
+    event.action = "card_board_changed"
+
+    event.particulars = { "particulars" => { "old_board" => "Old", "new_board" => "New" } }
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, event.api_particulars)
+
+    event.particulars = { "old_board" => "Old", "new_board" => "New" }
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, event.api_particulars)
+
+    event.particulars = { "particulars" => { "new_board" => "New" } }
+    assert_equal({ "old_board" => "", "new_board" => "New" }, event.api_particulars)
+
+    event.particulars = { "particulars" => { "old_board" => "Old" } }
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }.merge("new_board" => ""), event.api_particulars)
+
+    event.particulars = {}
+    assert_equal({ "old_board" => "", "new_board" => "" }, event.api_particulars)
+
+    event.particulars = nil
+    assert_equal({ "old_board" => "", "new_board" => "" }, event.api_particulars)
+
+    # Legacy collection keys fallback
+    event.particulars = { "particulars" => { "old_collection" => "Old Col", "new_collection" => "New Col" } }
+    assert_equal({ "old_board" => "Old Col", "new_board" => "New Col" }, event.api_particulars)
+  end
+
+  test "api_particulars for title changes" do
+    event = events(:logo_published)
+    event.action = "card_title_changed"
+
+    event.particulars = { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, event.api_particulars)
+
+    event.particulars = { "old_title" => "Old Title", "new_title" => "New Title" }
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, event.api_particulars)
+
+    event.particulars = { "particulars" => { "new_title" => "New Title" } }
+    assert_equal({ "old_title" => "", "new_title" => "New Title" }, event.api_particulars)
+
+    event.particulars = {}
+    assert_equal({ "old_title" => "", "new_title" => "" }, event.api_particulars)
+
+    event.particulars = nil
+    assert_equal({ "old_title" => "", "new_title" => "" }, event.api_particulars)
+  end
+
+  test "api_particulars for triage events" do
+    event = events(:logo_published)
+    event.action = "card_triaged"
+
+    event.particulars = { "particulars" => { "column" => "In Progress" } }
