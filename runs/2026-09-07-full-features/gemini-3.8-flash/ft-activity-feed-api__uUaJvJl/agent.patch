diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..f2fe37b 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,31 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    data = particulars.is_a?(Hash) ? particulars.with_indifferent_access : {}
+    nested = data[:particulars].is_a?(Hash) ? data[:particulars].with_indifferent_access : {}
+
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      ids = data[:assignee_ids] || nested[:assignee_ids] || assignee_ids || []
+      { "assignee_ids" => Array.wrap(ids) }
+    when "card_board_changed"
+      {
+        "old_board" => (nested[:old_board] || data[:old_board] || nested[:old_collection] || data[:old_collection]).to_s,
+        "new_board" => (nested[:new_board] || data[:new_board] || nested[:new_collection] || data[:new_collection]).to_s
+      }
+    when "card_title_changed"
+      {
+        "old_title" => (nested[:old_title] || data[:old_title]).to_s,
+        "new_title" => (nested[:new_title] || data[:new_title]).to_s
+      }
+    when "card_triaged"
+      {
+        "column" => (nested[:column] || data[:column]).to_s
+      }
+    else
+      {}
+    end
+  end
 end
