new file mode 100644
index 0000000..4e29fb9
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,52 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      scope = Event.preloaded
+                   .includes(creator: :identity, board: { creator: :identity })
+                   .where(board: boards)
+                   .where(action: TIMELINEABLE_ACTIONS)
+                   .order(created_at: :desc, id: :desc)
+
+      scope = scope.where(creator_id: creator_ids) if creator_ids.present?
+      scope
+    end
+
+    def boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def board_ids
+      Array.wrap(params[:board_ids]).compact_blank
+    end
+
+    def creator_ids
+      Array.wrap(params[:creator_ids]).compact_blank
+    end
+end
