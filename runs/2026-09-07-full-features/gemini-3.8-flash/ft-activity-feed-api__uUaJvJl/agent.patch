+
+    event.particulars = { "column" => "In Progress" }
+    assert_equal({ "column" => "In Progress" }, event.api_particulars)
+
+    event.particulars = {}
+    assert_equal({ "column" => "" }, event.api_particulars)
+
+    event.particulars = nil
+    assert_equal({ "column" => "" }, event.api_particulars)
+  end
+
+  test "api_particulars for other events return empty hash" do
+    event = events(:logo_published)
+
+    %w[ card_published card_closed card_reopened card_postponed card_auto_postponed card_sent_back_to_triage comment_created card_collection_changed ].each do |action|
+      event.action = action
+      assert_equal({}, event.api_particulars, "Expected action #{action} to return empty particulars")
+    end
+  end
+end
