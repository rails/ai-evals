diff --git a/app/models/session/magic_link.rb b/app/models/session/magic_link.rb
new file mode 100644
index 0000000..edaada9
--- /dev/null
+++ b/app/models/session/magic_link.rb
@@ -0,0 +1,69 @@
+class Session::MagicLink
+  CODE_LENGTH = 6
+  EXPIRATION_DURATION = 15.minutes
+
+  class << self
+    def deliver(email_address:, purpose: "sign_in", **extra)
+      new(email_address: email_address, purpose: purpose, **extra).tap do |magic_link|
+        magic_link.deliver
+      end
+    end
+
+    def generate_code
+      SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+
+    def generate_token(email_address:, code:, purpose: "sign_in", **extra)
+      verifier.generate(
+        {
+          "email_address" => email_address,
+          "code" => code,
+          "purpose" => purpose.to_s,
+          **extra.stringify_keys
+        },
+        expires_in: EXPIRATION_DURATION
+      )
+    end
+
+    def verify_token(token)
+      verifier.verified(token)
+    end
+
+    def verify_code(payload, submitted_code)
+      if payload.present? && submitted_code.present?
+        ActiveSupport::SecurityUtils.secure_compare(
+          payload["code"].to_s.strip.upcase,
+          submitted_code.to_s.strip.upcase
+        )
+      else
+        false
+      end
+    end
+
+    def verify(token:, code:)
+      if payload = verify_token(token)
+        if verify_code(payload, code)
+          payload
+        end
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+  end
+
+  attr_reader :email_address, :purpose, :extra, :code, :token
+
+  def initialize(email_address:, purpose: "sign_in", **extra)
+    @email_address = email_address.to_s.strip.downcase
+    @purpose = purpose.to_s
+    @extra = extra
+    @code = self.class.generate_code
+    @token = self.class.generate_token(email_address: @email_address, code: @code, purpose: @purpose, **extra)
+  end
+
+  def deliver
+    SessionMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+  end
+end
