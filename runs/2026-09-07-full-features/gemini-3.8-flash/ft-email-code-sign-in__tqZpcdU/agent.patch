+require "test_helper"
+
+class SessionMailerTest < ActionMailer::TestCase
+  test "sign_in_code" do
+    email = SessionMailer.sign_in_code(email_address: "user@example.com", code: "ABC123")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "user@example.com" ], email.to
+    assert_equal "ABC123 is your Fizzy code", email.subject
+    assert_includes email.subject, "ABC123"
+    assert_match "ABC123", email.text_part.body.encoded
+    assert_match "ABC123", email.html_part.body.encoded
+    assert_match "15 minutes", email.text_part.body.encoded
+  end
+end
diff --git a/test/models/session/magic_link_test.rb b/test/models/session/magic_link_test.rb
new file mode 100644
index 0000000..91bdb7e
--- /dev/null
+++ b/test/models/session/magic_link_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Session::MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  test "generates a 6-character code" do
+    code = Session::MagicLink.generate_code
+
+    assert_equal 6, code.length
+    assert_match /\A[A-Z0-9]{6}\z/, code
+  end
+
+  test "delivers code by email with code in subject" do
+    assert_emails 1 do
+      magic_link = Session::MagicLink.deliver(email_address: "user@example.com")
+      assert_equal 6, magic_link.code.length
+      assert magic_link.token.present?
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "user@example.com" ], mail.to
+      assert_includes mail.subject, magic_link.code
+    end
+  end
+
+  test "verify succeeds with correct code" do
+    magic_link = Session::MagicLink.new(email_address: "user@example.com")
+    payload = Session::MagicLink.verify(token: magic_link.token, code: magic_link.code)
+
+    assert_not_nil payload
+    assert_equal "user@example.com", payload["email_address"]
+    assert_equal "sign_in", payload["purpose"]
+  end
+
+  test "verify is case-insensitive and trims whitespace" do
+    magic_link = Session::MagicLink.new(email_address: "user@example.com")
+    payload = Session::MagicLink.verify(token: magic_link.token, code: "  #{magic_link.code.downcase}  ")
+
+    assert_not_nil payload
+    assert_equal "user@example.com", payload["email_address"]
+  end
+
+  test "verify fails with incorrect code" do
+    magic_link = Session::MagicLink.new(email_address: "user@example.com")
+    payload = Session::MagicLink.verify(token: magic_link.token, code: "WRONG1")
+
+    assert_nil payload
+  end
+
+  test "verify fails after 15 minutes" do
+    magic_link = Session::MagicLink.new(email_address: "user@example.com")
+
+    travel 14.minutes do
+      assert_not_nil Session::MagicLink.verify(token: magic_link.token, code: magic_link.code)
+    end
+
+    travel 16.minutes do
+      assert_nil Session::MagicLink.verify(token: magic_link.token, code: magic_link.code)
+    end
+  end
+end
