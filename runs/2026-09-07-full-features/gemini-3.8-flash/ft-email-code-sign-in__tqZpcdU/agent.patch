+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :set_pending_authentication, only: %i[ show new ]
+
+  def show
+  end
+
+  def new
+    render :show
+  end
+
+  def create
+    if payload = Session::MagicLink.verify(token: pending_authentication_token, code: params[:code])
+      cookies.delete(:pending_authentication_token)
+      identity = Identity.find_or_create_by!(email_address: payload["email_address"])
+      start_new_session_for identity
+
+      case payload["purpose"]
+      when "sign_up"
+        respond_to do |format|
+          format.html { redirect_to new_signup_completion_path }
+          format.json { render json: { session_token: session_token }, status: :created }
+        end
+      when "join"
+        join_code = Account::JoinCode.find_by!(code: payload["join_code"])
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: identity)
+
+        target_url = if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+
+        respond_to do |format|
+          format.html { redirect_to target_url }
+          format.json { render json: { session_token: session_token }, status: :created }
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    else
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_pending_authentication
+      if payload = Session::MagicLink.verify_token(pending_authentication_token)
+        @email_address = payload["email_address"]
+        @purpose = payload["purpose"]
+        @join_code = payload["join_code"]
+      else
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Your sign-in code has expired. Please try again." }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
