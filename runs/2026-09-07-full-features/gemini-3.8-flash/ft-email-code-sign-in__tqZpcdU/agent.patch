+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width center", autofocus: true, autocomplete: "one-time-code", placeholder: "6-character code" %>
+      </label>
+    </div>
+
+    <p>We sent a 6-character code to <strong><%= @email_address %></strong>. The code will expire in 15 minutes.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <% back_url = case @purpose
+       when "sign_up" then new_signup_path
+       when "join" then join_path(code: @join_code)
+       else new_session_path
+       end %>
+    <%= link_to "Didn't get an email?", back_url, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
