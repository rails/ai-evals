@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveJob::TestCase
+  test "performs delivery" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested stub, times: 1
+    assert_equal "completed", delivery.reload.state
+    assert_equal 200, delivery.response["code"]
+  end
+
+  test "delivers exactly once even if job is run again" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    assert_requested stub, times: 1
+
+    Webhook::DeliveryJob.perform_now(delivery)
+    assert_requested stub, times: 1
+  end
+end
