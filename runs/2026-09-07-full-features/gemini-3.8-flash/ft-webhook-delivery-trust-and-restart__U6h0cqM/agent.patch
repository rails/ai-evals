diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..ef1cb1e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,30 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  scope :delinquent, -> { where("consecutive_failures_count >= 10 AND first_failure_at <= ?", 1.hour.ago) }
+
+  def record_success
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+  alias_method :track_success, :record_success
+
+  def record_failure(failed_at = Time.current)
+    self.first_failure_at ||= failed_at
+    self.consecutive_failures_count += 1
+    save!
+
+    if delinquent?(failed_at)
+      webhook.deactivate
+    end
+  end
+  alias_method :track_failure, :record_failure
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?(at = Time.current)
+    consecutive_failures_count >= 10 && first_failure_at.present? && first_failure_at <= (at - 1.hour)
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..b57ae0c 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -9,6 +9,63 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where("created_at < ?", 1.week.ago) }
+
+  def self.cleanup
+    stale.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    return unless pending?
+    return unless self.class.where(id: id, state: :pending).update_all(state: :in_progress) == 1
+    reload
+
+    return unless webhook&.active?
+
+    body = webhook.payload_for(event)
+    timestamp = event.created_at.utc.iso8601
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+
+    self.request = { headers: headers }
+
+    uri = URI.parse(webhook.url)
+    http = Net::HTTP.new(uri.host, uri.port)
+    http.use_ssl = (uri.scheme == "https")
+    http.open_timeout = 10
+    http.read_timeout = 10
+
+    post_request = Net::HTTP::Post.new(uri.request_uri)
+    headers.each { |key, value| post_request[key] = value }
+    post_request.body = body
+
+    begin
+      http_response = http.request(post_request)
+      self.response = { code: http_response.code.to_i }
+      self.state = :completed
+    rescue => error
+      self.response = { error: error.message.presence || error.class.name }
+      self.state = :errored
+    end
+
+    save!
+
+    if succeeded?
+      webhook.track_delivery_success
+    else
+      webhook.track_delivery_failure
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
