diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..b8e4183
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @webhook = @board.webhooks.create!(
+      name: "Delinquency Test",
+      url: "https://example.com/delinquency"
+    )
+  end
+
+  test "is auto-created when a webhook is created" do
+    assert @webhook.delinquency_tracker.present?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "recording failure increments consecutive_failures_count and sets first_failure_at" do
+    tracker = @webhook.delinquency_tracker
+    now = Time.current
+
+    travel_to now do
+      tracker.record_failure
+      assert_equal 1, tracker.consecutive_failures_count
+      assert_equal now.to_fs(:db), tracker.first_failure_at.to_fs(:db)
+
+      tracker.record_failure
+      assert_equal 2, tracker.consecutive_failures_count
+      assert_equal now.to_fs(:db), tracker.first_failure_at.to_fs(:db)
+    end
+  end
+
+  test "recording success resets failure count and first_failure_at" do
+    tracker = @webhook.delinquency_tracker
+    tracker.record_failure
+    tracker.record_failure
+    assert_equal 2, tracker.consecutive_failures_count
+    assert_not_nil tracker.first_failure_at
+
+    tracker.record_success
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "does not switch off if fewer than 10 failures even over an hour" do
+    tracker = @webhook.delinquency_tracker
+    travel_to 2.hours.ago do
+      tracker.record_failure
+    end
+
+    8.times { tracker.record_failure }
+    assert_equal 9, tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "does not switch off if 10 failures occur in less than an hour" do
+    tracker = @webhook.delinquency_tracker
+    10.times { tracker.record_failure }
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "switches off when 10 failures in a row occur over an hour" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to 61.minutes.ago do
+      tracker.record_failure
+    end
+
+    9.times { tracker.record_failure }
+
+    assert_equal 10, tracker.consecutive_failures_count
+    assert_not @webhook.reload.active?
+  end
+
+  test "switches off if kept failing and another failure occurs after an hour" do
+    tracker = @webhook.delinquency_tracker
+
+    10.times { tracker.record_failure }
+    assert @webhook.reload.active?
+
+    travel 61.minutes do
+      tracker.record_failure
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "activating a deactivated webhook resets delinquency tracker" do
+    tracker = @webhook.delinquency_tracker
+    travel_to 61.minutes.ago do
+      tracker.record_failure
+    end
+    9.times { tracker.record_failure }
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..d579732 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,120 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "cleanup removes deliveries older than 1 week" do
+    old_delivery = Webhook::Delivery.create!(
+      webhook: webhooks(:active),
+      event: events(:layout_commented),
+      created_at: 8.days.ago
+    )
+    recent_delivery = Webhook::Delivery.create!(
+      webhook: webhooks(:active),
+      event: events(:layout_commented),
+      created_at: 6.days.ago
+    )
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old_delivery.id)
+    assert Webhook::Delivery.exists?(recent_delivery.id)
+  end
+
+  test "deliver sends POST request with headers and body" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub = stub_request(:post, webhook.url)
+      .with { |req|
+        req.headers["User-Agent"] == "fizzy/1.0.0 Webhook" &&
+        req.headers["Content-Type"] == "application/json" &&
+        req.headers["X-Webhook-Timestamp"] == event.created_at.utc.iso8601 &&
+        req.headers["X-Webhook-Signature"] == OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, req.body)
+      }
+      .to_return(status: 200, body: "OK")
+
+    delivery.deliver
+
+    assert_requested stub, times: 1
+    assert_equal "completed", delivery.state
+    assert_equal 200, delivery.response["code"]
+    assert delivery.succeeded?
+    assert_not_nil delivery.request["headers"]
+  end
+
+  test "deliver delivers exactly once" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+    assert_requested stub, times: 1
+
+    # Calling deliver again does not send another request
+    delivery.deliver
+    assert_requested stub, times: 1
+  end
+
+  test "deliver records HTTP failure and increments delinquency tracker" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    delivery.deliver
+
+    assert_equal "completed", delivery.state
+    assert_equal 500, delivery.response["code"]
+    assert delivery.failed?
+    assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deliver records network error and increments delinquency tracker" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub_request(:post, webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver
+
+    assert_equal "errored", delivery.state
+    assert delivery.response["error"].present?
+    assert delivery.failed?
+    assert_equal 1, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "deliver deactivates receiver after ten failures in a row over an hour" do
+    webhook = webhooks(:active)
+    event = events(:layout_commented)
+
+    stub_request(:post, webhook.url).to_return(status: 500)
+
+    travel_to 61.minutes.ago do
+      Webhook::Delivery.create!(webhook: webhook, event: event).deliver
+    end
+
+    9.times do
+      Webhook::Delivery.create!(webhook: webhook, event: event).deliver
+    end
+
+    assert_equal 10, webhook.delinquency_tracker.consecutive_failures_count
+    assert_not webhook.reload.active?
+  end
+
+  test "deliver does not send to inactive webhook" do
+    webhook = webhooks(:inactive)
+    event = events(:layout_commented)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+
+    stub = stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_not_requested stub
+  end
 end
