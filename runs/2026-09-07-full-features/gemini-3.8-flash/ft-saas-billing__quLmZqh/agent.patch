@@ -0,0 +1,110 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "checkout.session.completed creates active subscription" do
+    payload = {
+      id: "evt_test_checkout",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_12345",
+          customer: "cus_12345",
+          subscription: "sub_12345",
+          mode: "subscription",
+          client_reference_id: @account.external_account_id,
+          metadata: {
+            account_id: @account.id,
+            plan_key: "unlimited"
+          }
+        }
+      }
+    }
+
+    assert_difference -> { Account::Subscription.count } do
+      post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :ok
+    assert @account.reload.subscribed?
+    assert_equal "Unlimited", @account.plan_name
+    assert_equal "cus_12345", @account.subscription.stripe_customer_id
+    assert_equal "sub_12345", @account.subscription.stripe_subscription_id
+    assert_equal "active", @account.subscription.status
+  end
+
+  test "customer.subscription.updated updates existing subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_update",
+      stripe_subscription_id: "sub_update",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_test_update",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_update",
+          customer: "cus_update",
+          status: "active",
+          current_period_end: 1770000000,
+          metadata: {
+            account_id: @account.id,
+            plan_key: "unlimited_plus"
+          }
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    @account.reload
+    assert_equal "Unlimited+", @account.plan_name
+    assert_equal Time.at(1770000000), @account.subscription.current_period_end
+  end
+
+  test "customer.subscription.deleted cancels subscription" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_delete",
+      stripe_subscription_id: "sub_delete",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_test_delete",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_delete",
+          customer: "cus_delete",
+          status: "canceled"
+        }
+      }
+    }
+
+    post "/stripe/webhooks", params: payload.to_json, headers: { "CONTENT_TYPE" => "application/json" }
+
+    assert_response :ok
+    assert_not @account.reload.subscribed?
+    assert @account.free?
+  end
+
+  test "invalid signature returns bad request when secret configured" do
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+
+    post "/stripe/webhooks",
+      params: '{"invalid": "data"}',
+      headers: { "CONTENT_TYPE" => "application/json", "HTTP_STRIPE_SIGNATURE" => "bad_sig" }
+
+    assert_response :bad_request
+  ensure
+    ENV["STRIPE_WEBHOOK_SECRET"] = nil
+  end
+end
