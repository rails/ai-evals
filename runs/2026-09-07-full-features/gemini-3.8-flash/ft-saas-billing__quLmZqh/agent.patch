@@ -0,0 +1,49 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, only: [ :show, :comp, :uncomp, :override, :reset ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped."
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped."
+  end
+
+  def override
+    limit = @account.overridden_limit || @account.build_overridden_limit
+    limit.card_count = extract_param(:card_count)
+    limit.bytes_used = extract_param(:bytes_used)
+    limit.save!
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden."
+  end
+
+  def reset
+    @account.overridden_limit&.destroy
+    redirect_to saas.admin_account_path(@account), notice: "Override reset."
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) ||
+                 Account.find_by(external_account_id: params[:id]) ||
+                 Account.find(params[:id])
+    end
+
+    def extract_param(name)
+      val = params[name] ||
+            params.dig(:overridden_limit, name) ||
+            params.dig(:account_overridden_limit, name) ||
+            params.dig(:account, name)
+      val.presence
+    end
+end
