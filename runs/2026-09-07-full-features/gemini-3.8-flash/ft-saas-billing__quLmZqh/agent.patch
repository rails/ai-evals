@@ -0,0 +1,77 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path %> / <%= @account.name %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account Details</h2>
+    </header>
+
+    <div class="margin-block-half flex flex-column gap-half">
+      <div>
+        <strong>Name:</strong> <%= @account.name %>
+      </div>
+      <div>
+        <strong>ID:</strong> <%= @account.external_account_id %>
+      </div>
+      <div>
+        <strong>Plan:</strong> <%= @account.plan_name %>
+      </div>
+      <div>
+        <strong>Comped:</strong> <%= @account.comped? ? "Yes" : "No" %>
+      </div>
+      <div>
+        <strong>Cards:</strong> <%= number_with_delimiter(@account.cards_count) %>
+        <% if @account.overridden_limit&.card_count.present? %>
+          (overridden)
+        <% end %>
+      </div>
+      <div>
+        <strong>Storage:</strong> <%= number_to_human_size(@account.bytes_used) %>
+        <% if @account.overridden_limit&.bytes_used.present? %>
+          (overridden)
+        <% end %>
+      </div>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Billing Waiver</h2>
+    </header>
+
+    <div class="flex gap-half margin-block-half">
+      <%= button_to "Comp", saas.admin_account_billing_waiver_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.admin_account_billing_waiver_path(@account), method: :delete, class: "btn btn--reversed" %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override Limits</h2>
+    </header>
+
+    <div class="margin-block-half">
+      <%= form_with url: saas.admin_account_overridden_limit_path(@account), method: :post, class: "flex flex-column gap-half" do |f| %>
+        <div class="form-group">
+          <%= f.label :card_count, "Card count" %><br>
+          <%= f.number_field :card_count, value: @account.overridden_limit&.card_count, id: "card_count", class: "input" %>
+        </div>
+
+        <div class="form-group">
+          <%= f.label :bytes_used, "Bytes used" %><br>
+          <%= f.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, id: "bytes_used", class: "input" %>
+        </div>
+
+        <div class="flex gap-half align-center margin-block-start-quarter">
+          <%= f.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn btn--reversed" %>
+      </div>
+    </div>
+  </div>
+</section>
