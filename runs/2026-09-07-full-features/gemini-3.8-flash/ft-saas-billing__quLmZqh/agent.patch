diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..2fddc58
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,140 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    event = construct_stripe_event
+    handle_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError => e
+    Rails.logger.warn "[Stripe Webhook] Verification error: #{e.message}"
+    head :bad_request
+  rescue => e
+    Rails.logger.error "[Stripe Webhook] Processing error: #{e.message}\n#{e.backtrace.join("\n")}"
+    head :internal_server_error
+  end
+
+  private
+    def construct_stripe_event
+      payload = request.raw_post
+      sig_header = request.env["HTTP_STRIPE_SIGNATURE"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if secret.present? && sig_header.present?
+        Stripe::Webhook.construct_event(payload, sig_header, secret)
+      elsif Rails.env.test? || secret.blank?
+        if secret.present? && sig_header.present?
+          Stripe::Webhook.construct_event(payload, sig_header, secret)
+        else
+          data = JSON.parse(payload, symbolize_names: true)
+          Stripe::Event.construct_from(data)
+        end
+      else
+        Stripe::Webhook.construct_event(payload, sig_header, secret)
+      end
+    end
+
+    def handle_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_subscription(event.data.object)
+      when "customer.subscription.deleted"
+        cancel_subscription(event.data.object)
+      when "checkout.session.completed"
+        handle_checkout_completed(event.data.object)
+      end
+    end
+
+    def sync_subscription(stripe_sub)
+      account = find_account_for_subscription(stripe_sub)
+      return unless account
+
+      sub = account.subscription || account.build_subscription
+      sub.stripe_customer_id = stripe_sub[:customer]
+      sub.stripe_subscription_id = stripe_sub[:id]
+      sub.status = stripe_sub[:status]
+
+      if stripe_sub[:current_period_end].present?
+        sub.current_period_end = Time.at(stripe_sub[:current_period_end])
+      end
+
+      if stripe_sub[:cancel_at].present?
+        sub.cancel_at = Time.at(stripe_sub[:cancel_at])
+      else
+        sub.cancel_at = nil
+      end
+
+      items_data = stripe_sub[:items]&.[](:data) || []
+      first_item = items_data.first
+      price_id = first_item&.[](:price)&.[](:id) || stripe_sub[:plan]&.[](:id)
+      metadata = stripe_sub[:metadata] || {}
+      metadata_plan = metadata[:plan_key] || metadata["plan_key"]
+
+      plan = Plan.find_by_stripe_price_id(price_id) ||
+             Plan[metadata_plan] ||
+             sub.plan ||
+             Plan.unlimited
+
+      sub.plan_key = plan.key
+      sub.next_amount_due_in_cents = plan.price_in_cents
+      sub.save!
+    end
+
+    def cancel_subscription(stripe_sub)
+      sub = Account::Subscription.find_by(stripe_subscription_id: stripe_sub[:id]) ||
+            Account::Subscription.find_by(stripe_customer_id: stripe_sub[:customer])
+      if sub
+        sub.update!(status: "canceled")
+      end
+    end
+
+    def handle_checkout_completed(session)
+      return unless session[:mode] == "subscription"
+
+      account = find_account_for_checkout(session)
+      return unless account
+
+      sub = account.subscription || account.build_subscription
+      sub.stripe_customer_id = session[:customer] if session[:customer].present?
+      sub.stripe_subscription_id = session[:subscription] if session[:subscription].present?
+
+      metadata = session[:metadata] || {}
+      plan_key = metadata[:plan_key] || metadata["plan_key"] || "unlimited"
+      plan = Plan[plan_key] || Plan.unlimited
+      sub.plan_key = plan.key
+      sub.status = "active"
+      sub.next_amount_due_in_cents = plan.price_in_cents
+      sub.save!
+    end
+
+    def find_account_for_subscription(stripe_sub)
+      metadata = stripe_sub[:metadata] || {}
+      account_id = metadata[:account_id] || metadata["account_id"]
+      ext_id = metadata[:external_account_id] || metadata["external_account_id"]
+
+      if account_id.present?
+        Account.find_by(id: account_id)
+      elsif ext_id.present?
+        Account.find_by(external_account_id: ext_id)
+      elsif stripe_sub[:id].present? && (sub = Account::Subscription.find_by(stripe_subscription_id: stripe_sub[:id]))
+        sub.account
+      elsif stripe_sub[:customer].present? && (sub = Account::Subscription.find_by(stripe_customer_id: stripe_sub[:customer]))
+        sub.account
+      end
+    end
+
+    def find_account_for_checkout(session)
+      metadata = session[:metadata] || {}
+      account_id = metadata[:account_id] || metadata["account_id"]
+      client_ref = session[:client_reference_id]
+
+      if account_id.present?
+        Account.find_by(id: account_id)
+      elsif client_ref.present?
+        Account.find_by(external_account_id: client_ref) || Account.find_by(id: client_ref)
+      elsif session[:customer].present? && (sub = Account::Subscription.find_by(stripe_customer_id: session[:customer]))
+        sub.account
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3924047
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,92 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp!
+    (billing_waiver || create_billing_waiver!).tap do
+      association(:billing_waiver).reset
+    end
+  end
+
+  def uncomp!
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def subscribed?
+    subscription&.active? == true
+  end
+
+  def free?
+    !comped? && !subscribed?
+  end
+
+  def plan
+    if comped?
+      Plan.unlimited_plus
+    elsif subscribed?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def plan_name
+    if comped?
+      "Comped"
+    else
+      plan.name
+    end
+  end
+
+  def cards_count
+    if (limit = overridden_limit&.card_count).present?
+      limit
+    else
+      super
+    end
+  end
+
+  def bytes_used
+    if (limit = overridden_limit&.bytes_used).present?
+      limit
+    else
+      super
+    end
+  end
+
+  def card_limit
+    if comped?
+      nil
+    else
+      plan.card_limit
+    end
+  end
+
+  def cards_left
+    if card_limit
+      [ card_limit - cards_count, 0 ].max
+    end
+  end
+
+  def out_of_cards?
+    free? && card_limit.present? && cards_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    free? && card_limit.present? && !out_of_cards? && cards_count >= card_limit - 100
+  end
+
+  def can_upgrade?
+    !comped? && (free? || plan != Plan.unlimited_plus)
+  end
+end
