+++ b/saas/app/controllers/account/checkouts_controller.rb
@@ -0,0 +1,41 @@
+class Account::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan_key = params[:plan] || params[:plan_key] || "unlimited"
+    plan = Plan[plan_key] || Plan.unlimited
+    price_id = plan.stripe_price_id || "price_#{plan.key}"
+
+    session_params = {
+      mode: "subscription",
+      line_items: [
+        {
+          price: price_id,
+          quantity: 1
+        }
+      ],
+      success_url: account_settings_url(script_name: Current.account.slug),
+      cancel_url: account_settings_url(script_name: Current.account.slug),
+      client_reference_id: Current.account.external_account_id,
+      metadata: {
+        account_id: Current.account.id,
+        plan_key: plan.key
+      },
+      subscription_data: {
+        metadata: {
+          account_id: Current.account.id,
+          plan_key: plan.key
+        }
+      }
+    }
+
+    if Current.account.subscription&.stripe_customer_id.present?
+      session_params[:customer] = Current.account.subscription.stripe_customer_id
+    else
+      session_params[:customer_email] = Current.user.identity.email_address
+    end
+
+    session = Stripe::Checkout::Session.create(session_params)
+    redirect_to session.url, allow_other_host: true, status: :see_other
+  end
+end
