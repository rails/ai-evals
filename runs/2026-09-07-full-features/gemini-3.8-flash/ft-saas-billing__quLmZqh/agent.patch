diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..c3cc73c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,103 @@
+class Plan
+  attr_reader :key, :name, :card_limit, :storage_limit, :price_in_dollars, :price_in_cents
+
+  def initialize(key:, name:, card_limit:, storage_limit:, price_in_dollars:)
+    @key = key.to_s
+    @name = name
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_in_dollars = price_in_dollars
+    @price_in_cents = price_in_dollars * 100
+  end
+
+  def free?
+    @price_in_dollars == 0
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    @card_limit.nil?
+  end
+
+  def stripe_price_id
+    case @key
+    when "unlimited"
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    when "unlimited_plus"
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    end
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+
+  class << self
+    def free
+      @free ||= new(
+        key: "free",
+        name: "Free",
+        card_limit: 1_000,
+        storage_limit: 1.gigabyte,
+        price_in_dollars: 0
+      )
+    end
+
+    def unlimited
+      @unlimited ||= new(
+        key: "unlimited",
+        name: "Unlimited",
+        card_limit: nil,
+        storage_limit: 5.gigabytes,
+        price_in_dollars: 20
+      )
+    end
+
+    def unlimited_plus
+      @unlimited_plus ||= new(
+        key: "unlimited_plus",
+        name: "Unlimited+",
+        card_limit: nil,
+        storage_limit: 500.gigabytes,
+        price_in_dollars: 25
+      )
+    end
+
+    def all
+      [ free, unlimited, unlimited_plus ]
+    end
+
+    def paid
+      [ unlimited, unlimited_plus ]
+    end
+
+    def [](key)
+      return nil unless key.present?
+      case key.to_s.downcase.gsub(/[-_\s+]+/, "_")
+      when "free", "free_v1"
+        free
+      when "unlimited", "unlimited_v1"
+        unlimited
+      when "unlimited_plus", "unlimited_extra_storage", "unlimited_plus_v1"
+        unlimited_plus
+      end
+    end
+
+    def find_by_stripe_price_id(price_id)
+      return nil unless price_id.present?
+
+      if ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        unlimited_plus
+      elsif ENV["STRIPE_MONTHLY_V1_PRICE_ID"].present? && price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+        unlimited
+      elsif price_id.include?("extra_storage") || price_id.include?("plus")
+        unlimited_plus
+      elsif price_id.include?("unlimited")
+        unlimited
+      end
+    end
+  end
+end
diff --git a/saas/app/views/account/settings/saas/_billing.html.erb b/saas/app/views/account/settings/saas/_billing.html.erb
new file mode 100644
index 0000000..d9de121
--- /dev/null
+++ b/saas/app/views/account/settings/saas/_billing.html.erb
@@ -0,0 +1,56 @@
+<section class="settings__section settings__section--plan" id="plan">
+  <header>
+    <h2 class="divider txt-medium margin-block-start">Plan</h2>
+  </header>
+
+  <div class="margin-block-half flex flex-column gap-half">
+    <div class="flex align-center justify-between">
+      <div>
+        <div class="txt-large font-weight-bold"><%= account.plan_name %></div>
+        <div class="txt-small txt-ink-medium">
+          <% if account.comped? %>
+            Complimentary account
+          <% elsif account.plan.free? %>
+            <%= number_with_delimiter(account.card_limit) %> cards, <%= number_to_human_size(account.storage_limit) %> storage
+          <% else %>
+            Unlimited cards, <%= number_to_human_size(account.storage_limit) %> storage
+          <% end %>
+        </div>
+      </div>
+
+      <% if account.subscribed? %>
+        <%= button_to "Customer portal", saas.account_customer_portal_path, method: :post, class: "btn btn--reversed", data: { turbo: false } %>
+      <% end %>
+    </div>
+
+    <% if account.can_upgrade? %>
+      <div class="flex flex-column gap-half margin-block-start-half">
+        <% if account.free? %>
+          <div class="flex align-center justify-between border-top padding-block-start-half">
+            <div>
+              <strong>Unlimited</strong> — $20/month
+              <div class="txt-x-small txt-ink-medium">Unlimited cards, 5 GB storage</div>
+            </div>
+            <%= button_to "Upgrade", saas.account_checkout_path(plan: "unlimited"), method: :post, class: "btn", data: { turbo: false } %>
+          </div>
+
+          <div class="flex align-center justify-between border-top padding-block-start-half">
+            <div>
+              <strong>Unlimited+</strong> — $25/month
+              <div class="txt-x-small txt-ink-medium">Unlimited cards, 500 GB storage</div>
+            </div>
+            <%= button_to "Upgrade", saas.account_checkout_path(plan: "unlimited_plus"), method: :post, class: "btn btn--reversed", data: { turbo: false } %>
+          </div>
+        <% elsif account.plan == Plan.unlimited %>
+          <div class="flex align-center justify-between border-top padding-block-start-half">
+            <div>
+              <strong>Unlimited+</strong> — $25/month
+              <div class="txt-x-small txt-ink-medium">Unlimited cards, 500 GB storage</div>
+            </div>
+            <%= button_to "Upgrade", saas.account_checkout_path(plan: "unlimited_plus"), method: :post, class: "btn", data: { turbo: false } %>
+          </div>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+</section>
