+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can access accounts list" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path(script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "a[href=?]", saas.admin_account_path(@account, script_name: nil), text: @account.name
+  end
+
+  test "non-staff cannot access accounts list" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path(script_name: nil)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can access account page with comp, uncomp, override form and reset" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account, script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comp and uncomp account" do
+    sign_in_as :david
+
+    assert_not @account.comped?
+
+    untenanted do
+      post saas.admin_account_billing_waiver_path(@account, script_name: nil)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert @account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_billing_waiver_path(@account, script_name: nil)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    assert_not @account.reload.comped?
+  end
+
+  test "override card count and bytes used, then reset" do
+    sign_in_as :david
+    original_cards = @account.cards_count
+    original_bytes = @account.bytes_used
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account, script_name: nil), params: {
+        card_count: 950,
+        bytes_used: 2.gigabytes
+      }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    @account.reload
+    assert_equal 950, @account.cards_count
+    assert_equal 2.gigabytes, @account.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(@account, script_name: nil)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: nil)
+    @account.reload
+    assert_nil @account.overridden_limit
+    assert_equal original_cards, @account.cards_count
+    assert_equal original_bytes, @account.bytes_used
+  end
+end
