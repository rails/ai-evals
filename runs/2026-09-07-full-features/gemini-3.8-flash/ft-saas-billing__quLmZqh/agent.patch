+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free account has free plan with 1000 cards and 1 GB storage" do
+    assert @account.free?
+    assert_not @account.subscribed?
+    assert_not @account.comped?
+
+    assert_equal "Free", @account.plan_name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid unlimited plan brings 5 GB storage allowance and unlimited cards" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_123",
+      stripe_subscription_id: "sub_123",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert @account.subscribed?
+    assert_not @account.free?
+    assert_equal "Unlimited", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "paid unlimited+ plan brings 500 GB storage allowance and unlimited cards" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_124",
+      stripe_subscription_id: "sub_124",
+      plan_key: "unlimited_plus",
+      status: "active"
+    )
+
+    assert @account.subscribed?
+    assert_not @account.free?
+    assert_equal "Unlimited+", @account.plan_name
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comped account has comped status, unlimited cards, and paid storage allowance" do
+    @account.comp!
+
+    assert @account.comped?
+    assert_not @account.free?
+    assert_equal "Comped", @account.plan_name
+    assert_nil @account.card_limit
+    assert @account.storage_limit >= 5.gigabytes
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert @account.free?
+    assert_equal "Free", @account.plan_name
+  end
+
+  test "out_of_cards? is true for free account at or above 1000 cards" do
+    @account.update_column(:cards_count, 999)
+    assert_not @account.out_of_cards?
+    assert_equal 1, @account.cards_left
+
+    @account.update_column(:cards_count, 1000)
+    assert @account.out_of_cards?
+    assert_equal 0, @account.cards_left
+
+    @account.update_column(:cards_count, 1050)
+    assert @account.out_of_cards?
+    assert_equal 0, @account.cards_left
+  end
+
+  test "nearing_card_limit? is true from 100 cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_left
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_left
+
+    @account.update_column(:cards_count, 1000)
+    assert_not @account.nearing_card_limit?
+    assert @account.out_of_cards?
+  end
+
+  test "overridden_limit overrides cards_count and bytes_used" do
+    original_cards = @account.cards_count
+    original_bytes = @account.bytes_used
+
+    @account.create_overridden_limit!(card_count: 950, bytes_used: 2.gigabytes)
+
+    assert_equal 950, @account.reload.cards_count
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.nearing_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.overridden_limit.destroy!
+
+    assert_equal original_cards, @account.reload.cards_count
+    assert_equal original_bytes, @account.bytes_used
+  end
+end
