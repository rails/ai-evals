+require "test_helper"
+
+class Public::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "unauthenticated user can view published card of published board via HTML" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card, script_name: nil)
+    end
+
+    assert_response :success
+    assert_select "h1.card__title", text: /The logo isn['’]t big enough/
+  end
+
+  test "unauthenticated user can view published card of published board via JSON" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card, script_name: nil), as: :json
+    end
+
+    assert_response :success
+    assert_equal @card.title, response.parsed_body["title"]
+    assert_equal @card.number, response.parsed_body["number"]
+    assert_equal public_board_url(@board.publication_key, script_name: nil), response.parsed_body["board"]["public_url"]
+  end
+
+  test "drafted card cannot be viewed publicly and returns 404" do
+    @card.drafted!
+    assert @card.drafted?
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card, script_name: nil)
+      assert_response :not_found
+    end
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card, script_name: nil), as: :json
+      assert_response :not_found
+    end
+  end
+
+  test "card belonging to another board returns 404" do
+    other_board = boards(:private)
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(title: "Private Card", creator: users(:kevin), status: "published")
+    end
+    assert_not_equal @board, other_card.board
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, other_card, script_name: nil)
+      assert_response :not_found
+    end
+  end
+
+  test "card of unpublished board returns 404" do
+    @board.unpublish
+
+    untenanted do
+      get "/public/boards/#{@board.publication_key}/cards/#{@card.number}"
+      assert_response :not_found
+    end
+  end
+
+  test "non-existent card number returns 404" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, number: 999999, script_name: nil)
+      assert_response :not_found
+    end
+  end
+end
