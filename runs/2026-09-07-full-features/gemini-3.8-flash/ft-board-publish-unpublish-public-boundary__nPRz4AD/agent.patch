diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..5ff86bd
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+  end
+
+  test "publish board" do
+    @board.publish
+
+    assert @board.published?
+    assert_not_nil @board.publication_key
+    assert_equal 24, @board.publication_key.length
+    assert_equal @board.publication_key, @board.public_key
+    assert_equal "http://example.com/public/boards/#{@board.publication_key}", @board.public_url
+  end
+
+  test "publish is idempotent" do
+    @board.publish
+    key = @board.publication_key
+
+    @board.publish
+    assert_equal key, @board.publication_key
+  end
+
+  test "unpublish board" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "unpublish when not published does nothing" do
+    assert_nothing_raised do
+      @board.unpublish
+    end
+    assert_not @board.published?
+  end
+
+  test "re-publishing generates a new key" do
+    @board.publish
+    first_key = @board.publication_key
+
+    @board.unpublish
+    @board.publish
+    second_key = @board.publication_key
+
+    assert_not_equal first_key, second_key
+  end
+
+  test "published scope returns only published boards" do
+    @board.publish
+
+    assert_includes Board.published, @board
+    assert_not_includes Board.published, boards(:private)
+  end
+end
