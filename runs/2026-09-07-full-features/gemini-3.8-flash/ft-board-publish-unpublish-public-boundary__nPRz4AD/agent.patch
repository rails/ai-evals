diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..7ab0ee7
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,30 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    alias_attribute :public_key, :publication_key
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def publish
+    update!(publication_key: self.class.generate_unique_secure_token(length: 24)) unless published?
+  end
+
+  def unpublish
+    update!(publication_key: nil) if published?
+  end
+
+  def public_url(options = {})
+    if published?
+      default_options = { script_name: nil }
+      default_options[:host] = Rails.application.routes.default_url_options[:host] ||
+        ActionMailer::Base.default_url_options[:host] ||
+        "example.com"
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **default_options.merge(options))
+    end
+  end
+end
