diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..34b9fd6
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,29 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board), notice: "Board published" }
+      format.turbo_stream { render turbo_stream: turbo_stream.replace([ @board, :publication ], partial: "boards/edit/publication", locals: { board: @board }) }
+      format.json { render "boards/show", status: :created, location: public_board_url(@board.publication_key, script_name: nil) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board), notice: "Board unpublished" }
+      format.turbo_stream { render turbo_stream: turbo_stream.replace([ @board, :publication ], partial: "boards/edit/publication", locals: { board: @board }) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id] || params[:id])
+    end
+end
