diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..2900c99
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,128 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin # Admin
+  end
+
+  test "admin can publish board via HTML" do
+    assert_not @board.published?
+
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not_nil @board.publication_key
+  end
+
+  test "admin can publish board via JSON" do
+    assert_not @board.published?
+
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.publication_key, script_name: nil), @response.headers["Location"]
+    assert_equal public_board_url(@board.reload.publication_key, script_name: nil), @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish board via HTML" do
+    @board.publish
+    assert @board.published?
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to edit_board_path(@board)
+    assert_nil @board.publication_key
+  end
+
+  test "admin can unpublish board via JSON" do
+    @board.publish
+    assert @board.published?
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+    assert_nil @board.reload.publication_key
+  end
+
+  test "owner can publish and unpublish board" do
+    logout_and_sign_in_as :jason
+    assert users(:jason).owner?
+
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "regular member cannot publish board" do
+    logout_and_sign_in_as :jz
+    assert_not users(:jz).admin?
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "regular member cannot unpublish board" do
+    @board.publish
+
+    logout_and_sign_in_as :jz
+    assert_not users(:jz).admin?
+
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert @board.reload.published?
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "board creator who is not admin cannot publish board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "board creator who is not admin cannot unpublish board" do
+    @board.publish
+
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "unauthenticated user cannot publish or unpublish" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_response :redirect
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+  end
+end
