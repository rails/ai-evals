diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..ed857b4
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration scope includes accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes accounts canceled 30 days ago or less" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 20.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes active uncanceled accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 35.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration? returns true when canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_predicate @account, :due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false when canceled recently" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_predicate @account, :due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false when active" do
+    assert_not_predicate @account, :due_for_incineration?
+  end
+
+  test "incinerate permanently removes account and associated records" do
+    board = @account.boards.first
+    card = @account.cards.create!(title: "Card to incinerate", board: board, creator: @user)
+    Storage::Entry.record(account: @account, delta: 100, operation: "attach")
+
+    card.image.attach(
+      io: StringIO.new("test content"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+    blob = card.image.blob
+
+    account_id = @account.id
+    user_id = @user.id
+    board_id = board.id
+    card_id = card.id
+    blob_id = blob.id
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert_not User.exists?(user_id)
+    assert_not Board.exists?(board_id)
+    assert_not Card.exists?(card_id)
+    assert_not Storage::Entry.exists?(account_id: account_id)
+    assert_not ActiveStorage::Blob.exists?(blob_id)
+  end
+
+  test "incinerate removes data across all database tables associated with the account" do
+    Push::Subscription.any_instance.stubs(:resolved_endpoint_ip).returns(IPAddr.new("93.184.216.34"))
+
+    board = @account.boards.first
+    card = @account.cards.create!(title: "Comprehensive Test Card", board: board, creator: @user)
+    Card::ActivitySpike.create!(card: card, account: @account)
+    Card::NotNow.create!(card: card, user: @user, account: @account)
+    card.steps.create!(content: "Step 1", account: @account)
+    board.publish
+    Notification::Bundle.create!(user: @user, account: @account, starts_at: Time.current)
+    Push::Subscription.create!(
+      account: @account, user: @user,
+      endpoint: "https://fcm.googleapis.com/fcm/send/123",
+      p256dh_key: "key", auth_key: "auth"
+    )
+    @user.search_queries.create!(terms: "test query", account: @account)
+    Storage::Entry.record(account: @account, delta: 100, operation: "attach")
+    card.image.attach(
+      io: StringIO.new("test content"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+
+    account_id = @account.id
+    val = ActiveRecord::Base.connection.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))
+
+    tables_with_account_id = ActiveRecord::Base.connection.tables.select do |t|
+      ActiveRecord::Base.connection.columns(t).any? { |c| c.name == "account_id" }
+    end
+
+    @account.incinerate
+
+    tables_with_account_id.each do |table|
+      count = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE account_id = #{val}")
+      assert_equal 0, count, "Table #{table} should have 0 records for incinerated account"
+    end
+  end
+
+  test "incinerate_due removes all accounts past the grace period" do
+    account1 = @account
+    account1.cancel(initiated_by: @user)
+    account1.cancellation.update!(created_at: 31.days.ago)
+
+    account2 = accounts(:initech)
+    user2 = users(:mike)
+    account2.cancel(initiated_by: user2)
+    account2.cancellation.update!(created_at: 40.days.ago)
+
+    assert_difference -> { Account.count }, -2 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(account1.id)
+    assert_not Account.exists?(account2.id)
+  end
+end
