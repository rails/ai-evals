+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @settings = @user.settings
+  end
+
+  test "default bundle_email_frequency is never" do
+    new_user = User.create!(account: accounts("37s"), name: "New Person")
+    assert_equal "never", new_user.settings.bundle_email_frequency
+    assert_equal "never", new_user.bundle_email_frequency
+  end
+
+  test "valid bundle_email_frequency values" do
+    %w[ never every_few_hours daily weekly ].each do |freq|
+      @settings.update!(bundle_email_frequency: freq)
+      assert_equal freq, @settings.reload.bundle_email_frequency
+    end
+  end
+
+  test "bundle_duration reflects frequency" do
+    @settings.bundle_email_frequency = "never"
+    assert_nil @settings.bundle_duration
+
+    @settings.bundle_email_frequency = "every_few_hours"
+    assert_equal 4.hours, @settings.bundle_duration
+
+    @settings.bundle_email_frequency = "daily"
+    assert_equal 1.day, @settings.bundle_duration
+
+    @settings.bundle_email_frequency = "weekly"
+    assert_equal 1.week, @settings.bundle_duration
+  end
+
+  test "person can update frequency via user delegation" do
+    @user.bundle_email_frequency = "every_few_hours"
+    @user.settings.save!
+    assert_equal "every_few_hours", @user.reload.bundle_email_frequency
+  end
+
+  test "normalizes off to never and every_four_hours to every_few_hours" do
+    @settings.bundle_email_frequency = "off"
+    assert_equal "never", @settings.bundle_email_frequency
+
+    @settings.bundle_email_frequency = "every_four_hours"
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+  end
+end
