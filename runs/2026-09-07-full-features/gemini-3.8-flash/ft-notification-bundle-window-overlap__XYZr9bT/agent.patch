diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..9125a38
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,22 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.includes(:creator, card: :board, source: [ :creator, :eventable ])
+
+    Current.account ||= @bundle.account
+
+    to_address = @user.identity&.email_address
+    return unless to_address
+
+    mail to: to_address, subject: "Notification digest", template_name: "digest"
+  end
+
+  def bundle(bundle)
+    digest(bundle)
+  end
+end
+
+Notification::BundleMailer = NotificationMailer
