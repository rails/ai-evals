@@ -0,0 +1,27 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+    has_many :bundle_items, class_name: "Notification::BundleItem", dependent: :destroy
+    has_many :bundles, through: :bundle_items, source: :bundle
+
+    alias_method :window, :bundle
+    alias_method :window=, :bundle=
+
+    after_save_commit :bundle_notification, if: :should_bundle?
+  end
+
+  def bundle_notification
+    Notification::Bundle.record(self)
+  end
+
+  private
+    def should_bundle?
+      source_id_previously_changed? && pushable? && bundling_enabled?
+    end
+
+    def bundling_enabled?
+      user&.bundle_email_frequency.present? && user.bundle_email_frequency != "never"
+    end
+end
