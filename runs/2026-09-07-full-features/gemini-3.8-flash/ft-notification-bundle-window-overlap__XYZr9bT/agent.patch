diff --git a/app/views/mailers/notification_mailer/digest.html.erb b/app/views/mailers/notification_mailer/digest.html.erb
new file mode 100644
index 0000000..3630254
--- /dev/null
+++ b/app/views/mailers/notification_mailer/digest.html.erb
@@ -0,0 +1,50 @@
+<tr>
+  <td>
+    <h1 class="title">Notification digest</h1>
+    <p class="subtitle"><%= pluralize(@notifications.count, "notification") %> while you were away</p>
+
+    <% @notifications.group_by { |n| n.card.board }.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board">
+        <%= link_to board.name, board_url(board) %>
+      </h2>
+
+      <table>
+        <% notifications.each do |notification| %>
+          <tr class="notification">
+            <td class="avatar__container">
+              <%= mail_avatar_tag notification.creator %>
+            </td>
+            <td class="notification__details">
+              <div class="card__title">
+                <%= link_to (notification.card.title.presence || "Card ##{notification.card.number}"), card_url(notification.card) %>
+              </div>
+              <div class="notification__author">
+                <%= notification.creator.name %>
+                <% if notification.source.is_a?(Mention) %>
+                  &middot; <span class="notificaton__mention">@mentioned you</span>
+                <% elsif notification.source.is_a?(Event) %>
+                  &middot; <%= event_notification_title(notification.source) %>
+                <% end %>
+              </div>
+              <div class="notification__body">
+                <% if notification.source.is_a?(Mention) %>
+                  <%= notification.source.source.mentionable_content.truncate(200) %>
+                <% elsif notification.source.is_a?(Event) %>
+                  <%= event_notification_body(notification.source) %>
+                <% end %>
+              </div>
+            </td>
+          </tr>
+        <% end %>
+      </table>
+    <% end %>
+
+    <p class="footer">
+      <%= link_to "View all notifications", notifications_url %>
+    </p>
+  </td>
+</tr>
