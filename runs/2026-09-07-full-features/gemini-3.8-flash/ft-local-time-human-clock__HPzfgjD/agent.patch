diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..510ffaa 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,60 @@
 module TimeHelper
+  def local_time(time, options = nil)
+    return unless time
+
+    options = extract_time_options(options)
+    datetime = utc_iso8601(time)
+    options[:datetime] = datetime
+    options[:class] = token_list("local-time-value", options[:class])
+
+    content_tag("local-time", nil, options)
+  end
+
+  def local_date(time, options = nil)
+    return unless time
+
+    options = extract_time_options(options)
+    options[:type] ||= "date"
+    local_time(time, options)
+  end
+
+  def local_time_ago(time, options = nil)
+    return unless time
+
+    options = extract_time_options(options)
+    options[:type] ||= "time-ago"
+    local_time(time, options)
+  end
+
+  def local_relative_time(time, options = nil)
+    return unless time
+
+    options = extract_time_options(options)
+    options[:type] ||= "time-or-date"
+    local_time(time, options)
+  end
+
+  private
+    def extract_time_options(options)
+      case options
+      when Hash
+        options.dup
+      when String, Symbol
+        { format: options.to_s }
+      else
+        {}
+      end
+    end
+
+    def utc_iso8601(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      elsif time.is_a?(Date) && !time.is_a?(DateTime)
+        time.strftime("%Y-%m-%dT00:00:00")
+      elsif time.respond_to?(:to_time)
+        time.to_time.utc.iso8601
+      else
+        time.to_s
+      end
+    end
 end
