diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..c2afb38
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,230 @@
+const MONTH_NAMES = [
+  "January", "February", "March", "April", "May", "June",
+  "July", "August", "September", "October", "November", "December"
+]
+
+const MONTH_NAMES_SHORT = [
+  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+]
+
+const DAY_NAMES = [
+  "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
+]
+
+const DAY_NAMES_SHORT = [
+  "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
+]
+
+function calendarDayDifference(from, to) {
+  const fromUTC = Date.UTC(from.getFullYear(), from.getMonth(), from.getDate())
+  const toUTC = Date.UTC(to.getFullYear(), to.getMonth(), to.getDate())
+  return Math.round((toUTC - fromUTC) / 86400000)
+}
+
+function formatTime(date) {
+  let hours = date.getHours()
+  const minutes = date.getMinutes()
+  const ampm = hours >= 12 ? "PM" : "AM"
+  hours = hours % 12 || 12
+  const formattedMinutes = minutes < 10 ? `0${minutes}` : minutes
+  return `${hours}:${formattedMinutes} ${ampm}`
+}
+
+function formatStrftime(date, format) {
+  const year = date.getFullYear()
+  const month = date.getMonth()
+  const day = date.getDate()
+  const weekday = date.getDay()
+  const hours24 = date.getHours()
+  const minutes = date.getMinutes()
+  const seconds = date.getSeconds()
+  const ampm = hours24 >= 12 ? "PM" : "AM"
+  const hour12 = hours24 % 12 || 12
+
+  return format
+    .replace(/%Y/g, year)
+    .replace(/%y/g, String(year).slice(-2))
+    .replace(/%B/g, MONTH_NAMES[month])
+    .replace(/%b|%h/g, MONTH_NAMES_SHORT[month])
+    .replace(/%m/g, String(month + 1).padStart(2, "0"))
+    .replace(/%-m/g, String(month + 1))
+    .replace(/%A/g, DAY_NAMES[weekday])
+    .replace(/%a/g, DAY_NAMES_SHORT[weekday])
+    .replace(/%d/g, String(day).padStart(2, "0"))
+    .replace(/%-d/g, String(day))
+    .replace(/%e/g, String(day))
+    .replace(/%H/g, String(hours24).padStart(2, "0"))
+    .replace(/%-H/g, String(hours24))
+    .replace(/%I/g, String(hour12).padStart(2, "0"))
+    .replace(/%-I/g, String(hour12))
+    .replace(/%l/g, String(hour12))
+    .replace(/%M/g, String(minutes).padStart(2, "0"))
+    .replace(/%-M/g, String(minutes))
+    .replace(/%S/g, String(seconds).padStart(2, "0"))
+    .replace(/%-S/g, String(seconds))
+    .replace(/%p/g, ampm)
+    .replace(/%P/g, ampm.toLowerCase())
+    .trim()
+}
+
+function formatTimeOrDate(date, now = new Date()) {
+  const dayDiff = calendarDayDifference(date, now)
+
+  if (dayDiff === 0) {
+    if (date.getTime() > now.getTime() + 60000) {
+      return "today"
+    } else {
+      return formatTime(date)
+    }
+  } else if (dayDiff === 1) {
+    return "yesterday"
+  } else if (dayDiff === -1) {
+    return "tomorrow"
+  } else if (dayDiff < -1) {
+    return `in ${-dayDiff} days`
+  } else if (dayDiff <= 6) {
+    return `${dayDiff} days ago`
+  } else {
+    if (date.getFullYear() === now.getFullYear()) {
+      return formatStrftime(date, "%b %-d")
+    } else {
+      return formatStrftime(date, "%b %-d, %Y")
+    }
+  }
+}
+
+function formatTimeAgo(date, now = new Date()) {
+  const seconds = Math.round((now.getTime() - date.getTime()) / 1000)
+  const dayDiff = calendarDayDifference(date, now)
+
+  if (seconds < 0) {
+    if (dayDiff === -1) {
+      return "tomorrow"
+    } else if (dayDiff < -1) {
+      return `in ${-dayDiff} days`
+    } else {
+      return "today"
+    }
+  }
+
+  if (seconds < 60) {
+    return "just now"
+  }
+
+  const minutes = Math.round(seconds / 60)
+  if (minutes < 60) {
+    return minutes === 1 ? "1 minute ago" : `${minutes} minutes ago`
+  }
+
+  const hours = Math.round(seconds / 3600)
+  if (hours < 24 && dayDiff === 0) {
+    return hours === 1 ? "1 hour ago" : `${hours} hours ago`
+  }
+
+  if (dayDiff === 1) {
+    return "yesterday"
+  }
+
+  if (dayDiff <= 6) {
+    return `${dayDiff} days ago`
+  }
+
+  if (date.getFullYear() === now.getFullYear()) {
+    return formatStrftime(date, "%b %-d")
+  } else {
+    return formatStrftime(date, "%b %-d, %Y")
+  }
+}
+
+function formatDate(date, format) {
+  if (format) {
+    return formatStrftime(date, format)
+  }
+  const now = new Date()
+  if (date.getFullYear() === now.getFullYear()) {
+    return formatStrftime(date, "%b %-d")
+  } else {
+    return formatStrftime(date, "%b %-d, %Y")
+  }
+}
+
+function formatTimeOnly(date, format) {
+  if (format) {
+    return formatStrftime(date, format)
+  }
+  return formatTime(date)
+}
+
+class LocalTimeElement extends HTMLElement {
+  static get observedAttributes() {
+    return ["datetime", "format", "type"]
+  }
+
+  connectedCallback() {
+    this.classList.add("local-time-value")
+    this.update()
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.update()
+    }
+  }
+
+  update() {
+    const datetime = this.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date.getTime())) return
+
+    const format = this.getAttribute("format")
+    const type = this.getAttribute("type")
+
+    let text = ""
+    if (type === "time-or-date") {
+      text = formatTimeOrDate(date)
+    } else if (type === "time-ago") {
+      text = formatTimeAgo(date)
+    } else if (type === "date") {
+      text = formatDate(date, format)
+    } else if (type === "time") {
+      text = formatTimeOnly(date, format)
+    } else if (format) {
+      text = formatStrftime(date, format)
+    } else {
+      text = formatTimeOrDate(date)
+    }
+
+    this.textContent = text
+
+    if (!this.getAttribute("title")) {
+      this.setAttribute("title", formatStrftime(date, "%A, %B %-d, %Y at %l:%M %p"))
+    }
+  }
+}
+
+if (!customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
+
+document.addEventListener("turbo:load", () => {
+  document.querySelectorAll("local-time").forEach(el => {
+    if (el.update) el.update()
+  })
+})
+
+document.addEventListener("turbo:render", () => {
+  document.querySelectorAll("local-time").forEach(el => {
+    if (el.update) el.update()
+  })
+})
+
+setInterval(() => {
+  document.querySelectorAll("local-time[type='time-or-date'], local-time[type='time-ago']").forEach(el => {
+    if (el.update) el.update()
+  })
+}, 60000)
+
+export default LocalTimeElement
