diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..77aadfc
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time returns nil when time is nil" do
+    assert_nil local_time(nil)
+    assert_nil local_date(nil)
+    assert_nil local_time_ago(nil)
+    assert_nil local_relative_time(nil)
+  end
+
+  test "local_time renders local-time tag with UTC iso8601 datetime" do
+    time = Time.utc(2026, 9, 8, 13, 42, 0)
+    tag = local_time(time)
+
+    assert_dom_equal %(<local-time datetime="2026-09-08T13:42:00Z" class="local-time-value"></local-time>), tag
+  end
+
+  test "local_time merges custom class" do
+    time = Time.utc(2026, 9, 8, 13, 42, 0)
