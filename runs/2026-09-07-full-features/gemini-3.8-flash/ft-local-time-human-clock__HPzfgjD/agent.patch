+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comment timestamps rendered by browser in viewer timezone" do
+    card = cards(:logo)
+    now = Time.current
+
+    # Set up comments with specific timestamps
+    two_hours_ago_comment = comments(:logo_agreement_kevin)
+    two_hours_ago_comment.update_columns(created_at: now - 2.hours)
+
+    yesterday_comment = comments(:logo_agreement_jz)
+    yesterday_comment.update_columns(created_at: now.yesterday.change(hour: 20))
+
+    five_days_ago_comment = card.comments.create!(
+      creator: users(:david),
+      body: "An older comment from earlier in the week",
+      created_at: now - 5.days
+    )
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    # Comment from 2 hours ago reads the time of day (e.g., "1:42 PM")
+    within("##{ActionView::RecordIdentifier.dom_id(two_hours_ago_comment)}") do
+      local_time_el = find(".comment__permalink-title local-time")
+      assert_match(/\d{1,2}:\d{2}\s+(?:AM|PM)/, local_time_el[:textContent])
+      assert_not_empty local_time_el[:title]
+    end
+
+    # Comment from last night reads "yesterday"
+    within("##{ActionView::RecordIdentifier.dom_id(yesterday_comment)}") do
+      local_time_el = find(".comment__permalink-title local-time")
+      assert_equal "yesterday", local_time_el[:textContent]
+      assert_not_empty local_time_el[:title]
+    end
+
+    # Comment from earlier in the week reads "5 days ago"
+    within("##{ActionView::RecordIdentifier.dom_id(five_days_ago_comment)}") do
+      local_time_el = find(".comment__permalink-title local-time")
+      assert_equal "5 days ago", local_time_el[:textContent]
+      assert_not_empty local_time_el[:title]
+    end
+  end
+
+  test "card auto-closing overnight reads tomorrow and further out reads in 3 days" do
+    card = cards(:logo)
+    now = Time.current
+    period = card.auto_postpone_period
+
+    # Overnight auto-close (tomorrow)
+    card.update_columns(last_active_at: now.tomorrow.change(hour: 3) - period)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    assert_selector ".card-perma__closure-message local-time", text: "tomorrow"
+
+    # Further out (in 3 days)
+    card.update_columns(last_active_at: now + 3.days - period)
+    visit card_url(card)
+
+    assert_selector ".card-perma__closure-message local-time", text: "in 3 days"
+  end
+
+  test "card stamp and completion dates rendered in browser" do
+    card = cards(:logo)
+    closed_at = Time.utc(2026, 9, 8, 14, 30, 0)
+    card.close(user: users(:david))
+    card.closure.update_columns(created_at: closed_at)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    # Stamp renders formatted date
+    stamp_date = find(".card__closed-date local-time")
+    assert_equal "Sep 08, 2026", stamp_date[:textContent]
+
+    # Closure message renders formatted date
+    closure_msg = find(".card-perma__closure-message local-time")
+    assert_equal "Sep 8", closure_msg[:textContent]
+  end
+
+  test "card meta renders relative times in browser" do
+    card = cards(:logo)
+    now = Time.current
+    card.update_columns(created_at: now - 5.days, last_active_at: now - 2.hours)
+
+    sign_in_as(users(:david))
+    visit card_url(card)
+
+    within("##{ActionView::RecordIdentifier.dom_id(card, :meta)}") do
+      added_time = find(".card__meta-text--added local-time")
+      assert_equal "5 days ago", added_time[:textContent]
+
+      updated_time = find(".card__meta-text--updated local-time")
+      assert_equal "2 hours ago", updated_time[:textContent]
+    end
+  end
+end
