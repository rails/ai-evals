+class Board::StorageCalculationJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  limits_concurrency to: 1, key: ->(board) { board }
+
+  def perform(board)
+    board.calculate_bytes_used_now
+  end
+end
