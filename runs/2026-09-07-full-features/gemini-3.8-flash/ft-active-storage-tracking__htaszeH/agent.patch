@@ -0,0 +1,49 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted?
+      self[:bytes_used] = self.class.where(id: id).pick(:bytes_used) || 0
+    else
+      self[:bytes_used] || 0
+    end
+  end
+
+  def calculate_bytes_used_later
+    Current.with_account(account) do
+      Board::StorageCalculationJob.perform_later(self)
+    end
+  end
+
+  def calculate_bytes_used_now
+    if persisted?
+      update_column :bytes_used, calculate_bytes_used
+    end
+  end
+
+  def calculate_bytes_used
+    return 0 unless persisted?
+
+    embed_rich_text_ids = ActionText::RichText.where(
+      record_type: "Board", record_id: id, name: "public_description"
+    ).or(ActionText::RichText.where(
+      record_type: "Card", record_id: cards.select(:id), name: "description"
+    )).or(ActionText::RichText.where(
+      record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id), name: "body"
+    )).select(:id)
+
+    rich_text_embeds = ActiveStorage::Attachment.where(
+      record_type: "ActionText::RichText",
+      record_id: embed_rich_text_ids,
+      name: "embeds"
+    )
+
+    card_images = ActiveStorage::Attachment.where(
+      record_type: "Card",
+      record_id: cards.select(:id),
+      name: "image"
+    )
+
+    rich_text_embeds.or(card_images).joins(:blob).sum("active_storage_blobs.byte_size")
+  end
+end
