+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if new_record?
+      0
+    else
+      boards.sum(:bytes_used)
+    end
+  end
+
+  def calculate_bytes_used
+    boards.sum(&:calculate_bytes_used)
+  end
+
+  def calculate_bytes_used_later
+    boards.find_each(&:calculate_bytes_used_later)
+  end
+end
