diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..d3138ce 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,63 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_board_storage_later
+    before_destroy :remember_board_for_storage_tracking
+    after_destroy_commit :refresh_board_storage_after_destroy
+  end
+
+  module Purging
+    def purge
+      board = board_for_storage_tracking
+      super.tap { board&.calculate_bytes_used_later }
+    end
+
+    def purge_later
+      board = board_for_storage_tracking
+      super.tap { board&.calculate_bytes_used_later }
+    end
+  end
+
+  private
+    def refresh_board_storage_later
+      board_for_storage_tracking&.calculate_bytes_used_later
+    end
+
+    def remember_board_for_storage_tracking
+      @board_for_storage_tracking = board_for_storage_tracking
+    end
+
+    def refresh_board_storage_after_destroy
+      @board_for_storage_tracking&.calculate_bytes_used_later
+    end
+
+    def board_for_storage_tracking
+      case record
+      when Board
+        record
+      when Card
+        record.board
+      when Comment
+        record.card&.board
+      when ActionText::RichText
+        case record.record
+        when Board
+          record.record
+        when Card
+          record.record.board
+        when Comment
+          record.record.card&.board
+        end
+      end
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include ActiveStorageAttachmentStorageTracking
+  ActiveStorage::Attachment.prepend ActiveStorageAttachmentStorageTracking::Purging
+end
