diff --git a/test/models/storage_test.rb b/test/models/storage_test.rb
new file mode 100644
index 0000000..b2cc4e3
--- /dev/null
+++ b/test/models/storage_test.rb
@@ -0,0 +1,316 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @account = @board.account
+  end
+
+  test "initial bytes_used is zero" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card image increases bytes_used in background" do
+    card = @board.cards.create!(title: "Card with image")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+
+    assert_equal 0, @board.bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "board public description embed increases bytes_used in background" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("board description embed content"),
+      filename: "board.txt",
+      content_type: "text/plain"
+    )
+
+    @board.update!(public_description: ActionText::Content.new("About this board").append_attachables(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "card description embed increases bytes_used in background" do
+    card = @board.cards.create!(title: "Card with embed")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card description embed content"),
+      filename: "card.txt",
+      content_type: "text/plain"
+    )
+
+    card.update!(description: ActionText::Content.new("Details").append_attachables(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "comment embed increases bytes_used in background" do
+    card = @board.cards.create!(title: "Card to comment on")
+    card.publish
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment embed content"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+
+    comment = card.comments.create!(body: ActionText::Content.new("Nice card!").append_attachables(blob))
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "user avatar does not count towards storage" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "avatar.jpg",
+      content_type: "image/jpeg"
+    )
+
+    users(:david).avatar.attach(blob)
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "removing embed from card description decreases bytes_used" do
+    card = @board.cards.create!(title: "Card")
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("file 1"),
+      filename: "1.txt",
+      content_type: "text/plain"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("file 2 larger content"),
+      filename: "2.txt",
+      content_type: "text/plain"
+    )
+
+    card.update!(description: ActionText::Content.new("Both").append_attachables([ blob1, blob2 ]))
+    perform_enqueued_jobs
+    assert_equal blob1.byte_size + blob2.byte_size, @board.bytes_used
+
+    # Remove blob2
+    card.update!(description: ActionText::Content.new("Only one").append_attachables(blob1))
+    perform_enqueued_jobs
+
+    assert_equal blob1.byte_size, @board.bytes_used
+    assert_equal blob1.byte_size, @account.bytes_used
+  end
+
+  test "purging card image decreases bytes_used" do
+    card = @board.cards.create!(title: "Card")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.bytes_used
+
+    card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "replacing card image updates storage" do
+    card = @board.cards.create!(title: "Card")
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon1.jpg",
+      content_type: "image/jpeg"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("different image"),
+      filename: "moon2.png",
+      content_type: "image/png"
+    )
+
+    card.image.attach(blob1)
+    perform_enqueued_jobs
+    assert_equal blob1.byte_size, @board.bytes_used
+
+    card.image.attach(blob2)
+    perform_enqueued_jobs
+    assert_equal blob2.byte_size, @board.bytes_used
+    assert_equal blob2.byte_size, @account.bytes_used
+  end
+
+  test "destroying comment decreases bytes_used" do
+    card = @board.cards.create!(title: "Card")
+    card.publish
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment"),
+      filename: "comm.txt",
+      content_type: "text/plain"
+    )
+
+    comment = card.comments.create!(body: ActionText::Content.new("Hello").append_attachables(blob))
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.bytes_used
+
+    comment.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "destroying card decreases bytes_used" do
+    card = @board.cards.create!(title: "Card")
+    card.publish
+
+    blob_image = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    blob_comment = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment on card"),
+      filename: "comm.txt",
+      content_type: "text/plain"
+    )
+
+    card.image.attach(blob_image)
+    card.comments.create!(body: ActionText::Content.new("Hi").append_attachables(blob_comment))
+
+    perform_enqueued_jobs
+    expected_total = blob_image.byte_size + blob_comment.byte_size
+    assert_equal expected_total, @board.bytes_used
+
+    card.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "moving card to another board transfers usage" do
+    board2 = boards(:private)
+    card = @board.cards.create!(title: "Movable card")
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal 0, board2.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    card.move_to(board2)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal blob.byte_size, board2.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "account usage sums all boards" do
+    board2 = boards(:private)
+
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("file on board 1"),
+      filename: "b1.txt",
+      content_type: "text/plain"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("file on board 2"),
+      filename: "b2.txt",
+      content_type: "text/plain"
+    )
+
+    @board.update!(public_description: ActionText::Content.new("Board 1").append_attachables(blob1))
+    board2.update!(public_description: ActionText::Content.new("Board 2").append_attachables(blob2))
+
+    perform_enqueued_jobs
+
+    assert_equal blob1.byte_size, @board.bytes_used
+    assert_equal blob2.byte_size, board2.bytes_used
+    assert_equal blob1.byte_size + blob2.byte_size, @account.bytes_used
+  end
+
+  test "destroying board updates account usage" do
+    board2 = Board.create!(name: "Temporary Board", creator: users(:david), account: @account)
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("temp board content"),
+      filename: "temp.txt",
+      content_type: "text/plain"
+    )
+
+    board2.update!(public_description: ActionText::Content.new("Temp").append_attachables(blob))
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, board2.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+
+    board2.destroy!
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "new unsaved records return 0 bytes_used" do
+    assert_equal 0, Board.new.bytes_used
+    assert_equal 0, Account.new.bytes_used
+  end
+
+  test "synchronous calculate_bytes_used" do
+    card = @board.cards.create!(title: "Card")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("test content"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+    card.update!(description: ActionText::Content.new("Desc").append_attachables(blob))
+
+    assert_equal blob.byte_size, @board.calculate_bytes_used
+    assert_equal blob.byte_size, @account.calculate_bytes_used
+  end
+
+  test "calculate_bytes_used_later enqueues jobs" do
+    card = @board.cards.create!(title: "Card")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("test content"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+    card.update!(description: ActionText::Content.new("Desc").append_attachables(blob))
+
+    @account.calculate_bytes_used_later
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+end
