diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..91b3f06
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration scope includes accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 10.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration? returns true when canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_predicate @account, :due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false for active accounts" do
+    assert_not_predicate @account, :due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false when canceled recently" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 1.day.ago)
+
+    assert_not_predicate @account, :due_for_incineration?
+  end
+
+  test "incinerate removes account and all associated data" do
+    Current.account = @account
+
+    card = @account.cards.first
+    card.image.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "card.png",
+      content_type: "image/png"
+    )
+    card.reindex
+
+    @user.avatar.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    Storage::Entry.create!(account: @account, delta: 100, operation: "upload")
+    @account.cancel(initiated_by: @user)
+
+    account_id = @account.id
+
+    assert ActiveStorage::Blob.where(account_id: account_id).exists?
+    assert Search::Record.for(account_id).where(account_id: account_id).exists?
+    assert Storage::Entry.where(account_id: account_id).exists?
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+
+    all_tables = ActiveRecord::Base.connection.tables.reject do |table|
+      table.start_with?("solid_queue") || table == "schema_migrations" || table == "ar_internal_metadata"
+    end
+
+    remaining_records = {}
+    all_tables.each do |table|
+      columns = ActiveRecord::Base.connection.columns(table).map(&:name)
+      if columns.include?("account_id") || table == "accounts"
+        model = Class.new(ApplicationRecord) { self.table_name = table }
+        count = table == "accounts" ? model.where(id: account_id).count : model.where(account_id: account_id).count
+        remaining_records[table] = count if count > 0
+      end
+    end
+
+    assert_equal({}, remaining_records, "Expected all account data to be incinerated")
+  end
+
+  test "incinerate_due removes only accounts due for incineration" do
+    account_due = accounts(:acme)
+    user_acme = account_due.users.create!(name: "Acme User", role: :owner)
+    account_due.cancel(initiated_by: user_acme)
+    account_due.cancellation.update!(created_at: 31.days.ago)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 5.days.ago)
+
+    account_active = accounts(:initech)
+
+    assert_changes -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(account_due.id)
+    assert Account.exists?(@account.id)
+    assert Account.exists?(account_active.id)
+  end
+end
