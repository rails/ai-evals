diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..7a8e89a
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "permanently removes all data associated with accounts canceled more than 30 days ago" do
+    Current.account = @account
+
+    card = @account.cards.first
+    card.image.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "card.png",
+      content_type: "image/png"
+    )
+    card.reindex
+
+    @user.avatar.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    Storage::Entry.create!(account: @account, delta: 100, operation: "upload")
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    account_id = @account.id
+
+    assert_changes -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account_id)
+
+    all_tables = ActiveRecord::Base.connection.tables.reject do |table|
+      table.start_with?("solid_queue") || table == "schema_migrations" || table == "ar_internal_metadata"
+    end
+
+    remaining_records = {}
+    all_tables.each do |table|
+      columns = ActiveRecord::Base.connection.columns(table).map(&:name)
+      if columns.include?("account_id") || table == "accounts"
+        model = Class.new(ApplicationRecord) { self.table_name = table }
+        count = table == "accounts" ? model.where(id: account_id).count : model.where(account_id: account_id).count
+        remaining_records[table] = count if count > 0
+      end
+    end
+
+    assert_equal({}, remaining_records, "Expected all account data to be incinerated")
+  end
+
+  test "does not remove accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 20.days.ago)
+
+    assert_no_changes -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not remove active accounts" do
+    assert_not @account.cancelled?
+
+    assert_no_changes -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "job is configured in recurring.yml" do
+    file = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(File.read(file))
+    erb.filename = file.to_s
+    recurring_config = YAML.load(erb.result, aliases: true)
+    production_tasks = recurring_config["production"]
+
+    task = production_tasks.values.find { |t| t.is_a?(Hash) && t["class"] == "Account::IncinerateDueJob" }
+    assert_not_nil task, "Account::IncinerateDueJob should be registered in recurring.yml"
+    assert task["schedule"].present?, "Account::IncinerateDueJob should have a schedule"
+  end
+end
