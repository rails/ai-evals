+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "auto-created with webhook" do
+    webhook = Webhook.create!(name: "New Webhook", url: "https://example.com/hook", board: boards(:writebook))
+    assert webhook.delinquency_tracker.present?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "record_failure increments consecutive failures and sets first_failure_at" do
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+
+    freeze_time do
+      @tracker.record_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+
+      @tracker.record_failure
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+
+  test "record_success resets consecutive failures and first_failure_at" do
+    @tracker.update!(consecutive_failures_count: 5, first_failure_at: 30.minutes.ago)
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "does not deactivate when consecutive failures count is less than 10 even over an hour" do
+    @tracker.update!(consecutive_failures_count: 8, first_failure_at: 2.hours.ago)
+
+    @tracker.record_failure
+
+    assert_equal 9, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "does not deactivate when 10 failures occur within an hour" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 30.minutes.ago)
+
+    @tracker.record_failure
+
+    assert_equal 10, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "deactivates webhook when 10 consecutive failures happen over an hour" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago - 1.second)
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.record_failure
+    end
+
+    assert_equal 10, @tracker.consecutive_failures_count
+  end
+
+  test "deactivates webhook when consecutive failures exceed 10 over an hour" do
+    @tracker.update!(consecutive_failures_count: 15, first_failure_at: 2.hours.ago)
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.record_failure
+    end
+  end
+
+  test "reactivating webhook resets delinquency tracker" do
+    @webhook.deactivate
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 1.hour.ago)
+
+    @webhook.activate
+
+    assert @webhook.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
