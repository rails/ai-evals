diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..0599753
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,31 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  CONSECUTIVE_FAILURES_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset
+  end
+
+  def record_failure
+    self.first_failure_at ||= Time.current
+    self.consecutive_failures_count += 1
+    save!
+
+    if delinquent?
+      webhook.deactivate
+    end
+  end
+
+  def delinquent?
+    consecutive_failures_count >= CONSECUTIVE_FAILURES_THRESHOLD &&
+      first_failure_at.present? &&
+      first_failure_at <= FAILURE_WINDOW.ago
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..af77238 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -10,6 +10,60 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_now
+    return unless pending?
+    return unless self.class.where(id: id, state: :pending).update_all(state: :in_progress) == 1
+    reload
+
+    payload_body = webhook.payload_for(event)
+    timestamp = Time.current.utc.iso8601
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload_body)
+
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook",
+      "Content-Type" => "application/json",
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+
+    self.request = { "headers" => headers }
+
+    uri = URI.parse(webhook.url)
+    http = Net::HTTP.new(uri.hostname, uri.port)
+    http.use_ssl = (uri.scheme == "https")
+    http.open_timeout = 10
+    http.read_timeout = 10
+
+    post = Net::HTTP::Post.new(uri.request_uri)
+    headers.each { |key, value| post[key] = value }
+    post.body = payload_body
+
+    http_response = http.start { |h| h.request(post) }
+
+    self.response = { "code" => http_response.code.to_i }
+    self.state = :completed
+    save!
+  rescue StandardError => error
+    self.response = { "error" => error.message }
+    self.state = :errored
+    save!
+  ensure
+    if succeeded?
+      webhook.delinquency_tracker.record_success
+    else
+      webhook.delinquency_tracker.record_failure
+    end
+  end
+  alias_method :deliver, :deliver_now
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
diff --git a/test/models/event/relaying_test.rb b/test/models/event/relaying_test.rb
new file mode 100644
index 0000000..41ea27b
--- /dev/null
+++ b/test/models/event/relaying_test.rb
@@ -0,0 +1,123 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @webhook = webhooks(:active) # on writebook, subscribed to: card_published, card_assigned, card_closed
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "ok")
+  end
+
+  test "event creation triggers delivery to subscribed webhooks on the board" do
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs do
+        @board.events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo),
+          account: accounts("37s")
+        )
+      end
+    end
+
+    assert_requested :post, @webhook.url, times: 1
+    delivery = @webhook.deliveries.last
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+  end
+
+  test "event creation does not trigger webhooks unsubscribed to the action" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        @board.events.create!(
+          action: "card_reopened",
+          creator: users(:david),
+          eventable: cards(:logo),
+          account: accounts("37s")
+        )
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "event creation does not trigger inactive webhooks" do
+    @webhook.deactivate
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        @board.events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo),
+          account: accounts("37s")
+        )
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "event creation does not trigger webhooks from another board" do
+    other_board = boards(:private)
+    other_webhook = Webhook.create!(
+      board: other_board,
+      name: "Private Board Hook",
+      url: "https://example.com/other-hook",
+      subscribed_actions: [ "card_published" ]
+    )
+    stub_request(:post, other_webhook.url).to_return(status: 200)
+
+    # Event on writebook board should NOT trigger webhook on other_board
+    assert_no_difference -> { other_webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        @board.events.create!(
+          action: "card_published",
+          creator: users(:david),
+          eventable: cards(:logo),
+          account: accounts("37s")
+        )
+      end
+    end
+
+    assert_not_requested :post, other_webhook.url
+  end
+
+  test "delivers exactly once even if relay_now is called multiple times" do
+    event = @board.events.create!(
+      action: "card_published",
+      creator: users(:david),
+      eventable: cards(:logo),
+      account: accounts("37s")
+    )
+
+    event.relay_now
+    assert_requested :post, @webhook.url, times: 1
+
+    event.relay_now
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "receiver that keeps failing ten in a row over an hour gets switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    # 9 failures in the past (over an hour ago)
+    @webhook.delinquency_tracker.update!(
+      consecutive_failures_count: 9,
+      first_failure_at: 1.hour.ago - 1.minute
+    )
+
+    assert @webhook.active?
+
+    # 10th failure happens now
+    perform_enqueued_jobs do
+      @board.events.create!(
+        action: "card_published",
+        creator: users(:david),
+        eventable: cards(:logo),
+        account: accounts("37s")
+      )
+    end
+
+    assert_not @webhook.reload.active?, "Webhook should be switched off after 10 consecutive failures over an hour"
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
