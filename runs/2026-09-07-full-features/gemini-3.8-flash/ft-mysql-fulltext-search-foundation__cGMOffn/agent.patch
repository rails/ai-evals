@@ -0,0 +1,34 @@
+module SearchesHelper
+  def highlight_search_matches(text, query)
+    if text.blank? || query.blank?
+      text
+    else
+      escaped_text = text.html_safe? ? text : ERB::Util.html_escape(text)
+      words = query.strip.split.reject(&:blank?)
+
+      highlight(escaped_text, words)
+    end
+  end
+
+  def search_excerpt(content, query, radius: 100)
+    if content.blank?
+      ""
+    else
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text = text.gsub(/\s+/, " ").strip
+
+      if query.blank?
+        text.truncate(radius * 2)
+      else
+        words = query.strip.split.reject(&:blank?)
+        matching_word = words.find { |w| text.downcase.include?(w.downcase) }
+
+        if matching_word
+          excerpt(text, matching_word, radius: radius) || text.truncate(radius * 2)
+        else
+          text.truncate(radius * 2)
+        end
+      end
+    end
+  end
+end
