--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,44 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(term)
+      if term.blank?
+        none
+      else
+        sanitized = "%#{sanitize_sql_like(term.strip)}%"
+
+        descriptions = ActionText::RichText
+          .where(record_type: "Card", name: "description")
+          .where("body LIKE ? ESCAPE '\\'", sanitized)
+        descriptions = descriptions.where(account_id: Current.account.id) if Current.account
+
+        comments = Comment
+          .joins(:rich_text_body)
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '\\'", sanitized)
+        comments = comments.where(account_id: Current.account.id) if Current.account
+
+        where(
+          "cards.title LIKE :query ESCAPE '\\' OR cards.id IN (:card_ids_from_description) OR cards.id IN (:card_ids_from_comments)",
+          query: sanitized,
+          card_ids_from_description: descriptions.select(:record_id),
+          card_ids_from_comments: comments.select(:card_id)
+        ).distinct
+      end
+    end
+  end
+
+  def search_matching_comments(query)
+    if query.blank?
+      Comment.none
+    else
+      sanitized = "%#{ActiveRecord::Base.sanitize_sql_like(query.strip)}%"
+
+      comments
+        .joins(:rich_text_body)
+        .where("action_text_rich_texts.body LIKE ? ESCAPE '\\'", sanitized)
+        .preload(:creator, :rich_text_body)
+        .chronologically
+    end
+  end
+end
