@@ -0,0 +1,209 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+    @board = boards(:writebook)
+    Current.user = @user
+    Current.account = accounts("37s")
+  end
+
+  test "show renders successfully" do
+    get search_path
+    assert_response :success
+    assert_select "input[name='q']"
+  end
+
+  test "show with blank query renders empty state" do
+    get search_path(q: "")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "finds cards by title, newest first, with matched words wrapped in mark" do
+    older_card = @board.cards.create!(
+      title: "Ancient search feature discussion",
+      creator: @user,
+      status: "published",
+      created_at: 2.hours.ago
+    )
+    newer_card = @board.cards.create!(
+      title: "Recent search feature planning",
+      creator: @user,
+      status: "published",
+      created_at: 1.hour.ago
+    )
+
+    get search_path(q: "search feature")
+    assert_response :success
+
+    # Matched words wrapped in <mark>
+    assert_select "mark", text: "search"
+    assert_select "mark", text: "feature"
+
+    # Newest first
+    newer_index = response.body.index(card_path(newer_card))
+    older_index = response.body.index(card_path(older_card))
+    assert newer_index, "Newer card not found in response"
+    assert older_index, "Older card not found in response"
+    assert_operator newer_index, :<, older_index
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    card = @board.cards.create!(
+      title: "Database cleanup",
+      description: "We need to optimize the postgresql indices for speed",
+      creator: @user,
+      status: "published"
+    )
+
+    get search_path(q: "postgresql")
+    assert_response :success
+
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "postgresql"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    card = @board.cards.create!(
+      title: "UI polishing",
+      creator: @user,
+      status: "published"
+    )
+    card.comments.create!(
+      body: "We found an unexpected alignment issue on mobile screens",
+      creator: @user
+    )
+
+    get search_path(q: "alignment")
+    assert_response :success
+
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "alignment"
+  end
+
+  test "search is case-insensitive and wraps original casing in mark" do
+    card = @board.cards.create!(
+      title: "Fix CRITICAL Vulnerability immediately",
+      creator: @user,
+      status: "published"
+    )
+
+    get search_path(q: "critical")
+    assert_response :success
+
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "CRITICAL"
+  end
+
+  test "draft cards never turn up by title or description" do
+    draft_card = @board.cards.create!(
+      title: "Secret unreleased draft feature",
+      description: "Top secret draft information here",
+      creator: @user,
+      status: "drafted"
+    )
+
+    get search_path(q: "unreleased")
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft_card), count: 0
+
+    get search_path(q: "secret draft")
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft_card), count: 0
+  end
+
+  test "comments on draft cards never turn up" do
+    draft_card = @board.cards.create!(
+      title: "Draft card with notes",
+      creator: @user,
+      status: "drafted"
+    )
+    # Draft cards cannot have comments normally due to validation, but bypass to test constraint
+    comment = draft_card.comments.build(creator: @user, account: @board.account)
+    comment.rich_text_body = ActionText::RichText.new(
+      name: "body",
+      record: comment,
+      account: @board.account,
+      body: "classified_draft_comment_unique"
+    )
+    comment.save!(validate: false)
+
+    get search_path(q: "classified_draft_comment_unique")
+    assert_response :success
+    assert_select "a[href=?]", card_path(draft_card), count: 0
+    assert_select "mark", text: "classified_draft_comment_unique", count: 0
+  end
+
+  test "people only ever see results from boards they currently have access to" do
+    accessible_card = @board.cards.create!(
+      title: "Accessible roadmap milestone",
+      creator: @user,
+      status: "published"
+    )
+
+    # Private board that @user does NOT have access to
+    inaccessible_board = accounts("37s").boards.create!(
+      name: "Super Secret Board",
+      creator: users(:david),
+      all_access: false
+    )
+    inaccessible_card = inaccessible_board.cards.create!(
+      title: "Inaccessible roadmap milestone",
+      creator: users(:david),
+      status: "published"
+    )
+
+    get search_path(q: "roadmap milestone")
+    assert_response :success
+
+    assert_select "a[href=?]", card_path(accessible_card), count: 1
+    assert_select "a[href=?]", card_path(inaccessible_card), count: 0
+
+    # When access is granted, card becomes visible
+    inaccessible_board.accesses.create!(user: @user)
+    get search_path(q: "roadmap milestone")
+    assert_response :success
+    assert_select "a[href=?]", card_path(inaccessible_card), count: 1
+
+    # When access is revoked, card disappears
+    inaccessible_board.accesses.where(user: @user).destroy_all
+    get search_path(q: "roadmap milestone")
+    assert_response :success
+    assert_select "a[href=?]", card_path(inaccessible_card), count: 0
+  end
+
+  test "multiple matching comments on single card only returns card once" do
+    card = @board.cards.create!(
+      title: "Production deploy checklist",
+      creator: @user,
+      status: "published"
+    )
+    card.comments.create!(body: "First deploy check completed", creator: @user)
+    card.comments.create!(body: "Second deploy check verified", creator: @user)
+
+    get search_path(q: "deploy")
+    assert_response :success
+
+    # Card only listed once
+    assert_select "article.card[data-id='#{card.number}']", count: 1
+    assert_select "mark", text: "deploy", minimum: 2
+  end
+
+  test "handles special characters safely" do
+    card = @board.cards.create!(
+      title: "100% finished <script>alert(1)</script>",
+      creator: @user,
+      status: "published"
+    )
+
+    get search_path(q: "100%")
+    assert_response :success
+    assert_select "mark", text: "100%"
+
+    get search_path(q: "<script>")
+    assert_response :success
+    assert_select "script", text: "alert(1)", count: 0
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
