+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight_search_matches returns original when text or query is blank" do
+    assert_equal "", highlight_search_matches("", "test")
+    assert_nil highlight_search_matches(nil, "test")
+    assert_equal "hello world", highlight_search_matches("hello world", "")
+    assert_equal "hello world", highlight_search_matches("hello world", nil)
+  end
+
+  test "highlight_search_matches wraps matched words in mark" do
+    result = highlight_search_matches("The quick brown fox", "quick")
+    assert_equal "The <mark>quick</mark> brown fox", result
+  end
+
+  test "highlight_search_matches wraps multiple words in individual mark tags" do
+    result = highlight_search_matches("The quick brown fox", "quick fox")
+    assert_equal "The <mark>quick</mark> brown <mark>fox</mark>", result
+  end
+
+  test "highlight_search_matches is case-insensitive" do
+    result = highlight_search_matches("CRITICAL bug found", "critical")
+    assert_equal "<mark>CRITICAL</mark> bug found", result
+  end
+
+  test "highlight_search_matches escapes HTML safely" do
+    result = highlight_search_matches("<script>alert(1)</script> hello", "hello")
+    assert_equal "&lt;script&gt;alert(1)&lt;/script&gt; <mark>hello</mark>", result
+  end
+
+  test "highlight_search_matches preserves existing html_safe code tags" do
+    safe_title = "Fix <code>bug</code> in production".html_safe
+    result = highlight_search_matches(safe_title, "bug")
+    assert_equal "Fix <code><mark>bug</mark></code> in production", result
+  end
+
+  test "search_excerpt extracts excerpt around matching word" do
+    long_text = "start " + ("padding " * 20) + "target_word " + ("more_padding " * 20) + "end"
+    result = search_excerpt(long_text, "target_word", radius: 30)
+
+    assert_includes result, "target_word"
+    assert_operator result.length, :<, long_text.length
+  end
+
+  test "search_excerpt with blank query truncates text" do
+    assert_equal "Short", search_excerpt("Short", "")
+  end
+end
