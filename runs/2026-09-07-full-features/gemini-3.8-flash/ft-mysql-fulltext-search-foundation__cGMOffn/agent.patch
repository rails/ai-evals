+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="center max-width margin-block-start margin-block-end">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex gap-half align-center pad-inline" do |form| %>
+    <%= form.search_field :q, value: params[:q], placeholder: "Search cards…", autofocus: true, autocorrect: "off", autocomplete: "off", class: "input full-width" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</div>
+
+<% if @query.present? %>
+  <section class="cards cards--grid">
+    <div class="cards__list hide-scrollbar">
+      <% if @cards.any? %>
+        <%= render partial: "searches/card", collection: @cards, as: :card %>
+      <% else %>
+        <div class="blank-slate center txt-align-center">No cards match that search</div>
+      <% end %>
+    </div>
+  </section>
+<% else %>
+  <div class="blank-slate center txt-align-center margin-block">Find cards by searching for what's in them.</div>
+<% end %>
