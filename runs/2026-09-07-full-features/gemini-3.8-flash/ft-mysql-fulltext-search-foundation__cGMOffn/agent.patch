@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @user = users(:david)
+  end
+
+  test "search with blank query returns none" do
+    assert_equal 0, Card.search("").count
+    assert_equal 0, Card.search(nil).count
+    assert_equal 0, Card.search("   ").count
+  end
+
+  test "search finds cards by title" do
+    card = @board.cards.create!(title: "Unique Title Alpha", creator: @user, status: "published")
+
+    results = Card.search("Title Alpha")
+    assert_includes results, card
+  end
+
+  test "search finds cards by description" do
+    card = @board.cards.create!(
+      title: "Task Beta",
+      description: "Detailed description with unique_desc_keyword inside",
+      creator: @user,
+      status: "published"
+    )
+
+    results = Card.search("unique_desc_keyword")
+    assert_includes results, card
+  end
+
+  test "search finds cards by comment body" do
+    card = @board.cards.create!(title: "Task Gamma", creator: @user, status: "published")
+    card.comments.create!(body: "Here is a unique_comment_keyword for testing", creator: @user)
+
+    results = Card.search("unique_comment_keyword")
+    assert_includes results, card
+  end
+
+  test "search returns distinct cards when title and comments both match" do
+    card = @board.cards.create!(title: "Overlap Search Term", creator: @user, status: "published")
+    card.comments.create!(body: "First comment with Overlap Search Term", creator: @user)
+    card.comments.create!(body: "Second comment with Overlap Search Term", creator: @user)
+
+    results = Card.where(id: card.id).search("Overlap Search Term")
+    assert_equal 1, results.to_a.size
+  end
+
+  test "search is case-insensitive" do
+    card = @board.cards.create!(title: "SHOUTING TITLE", creator: @user, status: "published")
+
+    results = Card.search("shouting")
+    assert_includes results, card
+  end
+
+  test "search handles special characters safely" do
+    card = @board.cards.create!(title: "Progress is 100% complete_now", creator: @user, status: "published")
+
+    results = Card.search("100%")
+    assert_includes results, card
+
+    results_underscore = Card.search("complete_now")
+    assert_includes results_underscore, card
+  end
+
+  test "search_matching_comments returns only matching comments" do
+    card = @board.cards.create!(title: "Comments Task", creator: @user, status: "published")
+    matching_comment = card.comments.create!(body: "Need to review metrics", creator: @user)
+    card.comments.create!(body: "Everything is fine", creator: @user)
+
+    assert_equal [ matching_comment ], card.search_matching_comments("metrics").to_a
+    assert_empty card.search_matching_comments("nonexistent")
+    assert_empty card.search_matching_comments("")
+  end
+end
