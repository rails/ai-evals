+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy import failed", email.subject
+    assert_includes email.body.encoded, "Corrupted archive file"
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..673f07f
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @david = users(:david)
+    Current.account = @account
+
+    @export = @account.exports.create!(user: @admin, kind: "account")
+    @export.process_now
+    assert @export.completed?
+    assert @export.file.attached?
+  end
+
+  test "importing an account creates a new account with everything in it" do
+    account_count_before = Account.count
+
+    import = @account.imports.create!(user: @admin)
+    import.file.attach(@export.file.blob)
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    assert import.completed?, "Import failed: #{import.error_message}"
+    assert_equal account_count_before + 1, Account.count
+
+    new_account = import.imported_account
+    assert_not_nil new_account
+    assert_not_equal @account.id, new_account.id
+    assert_not_equal @account.external_account_id, new_account.external_account_id
+    assert_equal @account.name, new_account.name
+
+    # Check boards, cards, comments, and people were imported
+    assert new_account.boards.any?, "Expected boards in new account"
+    assert new_account.cards.any?, "Expected cards in new account"
+    assert new_account.users.any?, "Expected users in new account"
+
+    # Kevin should be in the new account as owner/admin
+    kevin_in_new_account = new_account.users.find_by(identity_id: @admin.identity.id)
+    assert_not_nil kevin_in_new_account
+    assert kevin_in_new_account.admin?
+  end
+
+  test "importing an account restores attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @admin, kind: "account")
+    export.process_now
+
+    import = @account.imports.create!(user: @admin)
+    import.file.attach(export.file.blob)
+    import.process_now
+    assert import.completed?
+
+    new_account = import.imported_account
+    new_card = new_account.cards.find_by(number: card.number)
+    assert_not_nil new_card
+    assert new_card.image.attached?, "Expected image to be attached to imported card"
+    assert_equal "moon.jpg", new_card.image.filename.to_s
+    assert_equal file_fixture("moon.jpg").binread.bytesize, new_card.image.byte_size
+  end
+
+  test "importing by a user not previously in the account adds them as owner" do
+    other_user = users(:mike) # mike has no user in 37s
+
+    import = @account.imports.create!(user: other_user)
+    import.file.attach(@export.file.blob)
+
+    import.process_now
+    assert import.completed?, "Import failed: #{import.error_message}"
+
+    new_account = import.imported_account
+    user_in_account = new_account.users.find_by(identity_id: other_user.identity.id)
+    assert_not_nil user_in_account
+    assert user_in_account.owner?
+  end
+
+  test "failed import leaves nothing behind and sends failure email" do
+    bad_tempfile = Tempfile.new([ "corrupted", ".zip" ])
+    bad_tempfile.write("not valid zip contents")
+    bad_tempfile.rewind
+
+    account_count_before = Account.count
+    board_count_before = Board.count
+    card_count_before = Card.count
+    user_count_before = User.count
+
+    import = @account.imports.create!(user: @admin)
+    import.file.attach(io: bad_tempfile, filename: "corrupted.zip", content_type: "application/zip")
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    assert import.failed?
+    assert import.error_message.present?
+    assert_nil import.imported_account
+
+    # Verify nothing left behind
+    assert_equal account_count_before, Account.count
+    assert_equal board_count_before, Board.count
+    assert_equal card_count_before, Card.count
+    assert_equal user_count_before, User.count
+  ensure
+    bad_tempfile&.close
+    bad_tempfile&.unlink
+  end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..a97405a
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+    Current.account = @account
+  end
+
+  test "account export generates a zip with account records and sends email" do
+    export = @account.exports.create!(user: @admin, kind: "account")
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_not export.expired?
+
+    ZipFile.open(export.file) do |reader|
+      assert reader.glob("accounts/*.json").any?, "Expected accounts/*.json in zip"
+      assert reader.glob("users/*.json").any?, "Expected users/*.json in zip"
+      assert reader.glob("boards/*.json").any?, "Expected boards/*.json in zip"
+      assert reader.glob("cards/*.json").any?, "Expected cards/*.json in zip"
+    end
+  end
+
+  test "cards export generates a zip with cards as json and their comments" do
+    card = cards(:logo)
+    comment = card.comments.create!(creator: @member, body: "Great logo design")
+
+    export = @account.exports.create!(user: @member, kind: "cards")
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |reader|
+      assert reader.exists?("cards.json")
+      assert reader.exists?("cards/#{card.number}.json")
+      assert reader.exists?("cards/#{card.number}/card.json")
+
+      data = JSON.parse(reader.read("cards/#{card.number}.json"))
+      assert_equal card.title, data["title"]
+      assert_equal card.number, data["number"]
+      assert data["comments"].any? { |c| c["body"] == "Great logo design" }
+    end
+  end
+
+  test "cards export includes pictures and files attached to cards" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @member, kind: "cards")
+    export.process_now
+
+    ZipFile.open(export.file) do |reader|
+      assert reader.glob("cards/#{card.number}/**/*moon.jpg").any?, "Expected moon.jpg attachment in card #{card.number}"
+    end
+  end
+
+  test "export expires after 1 day" do
+    export = @account.exports.create!(user: @admin, kind: "account", created_at: 2.days.ago)
+    assert export.expired?
+
+    fresh_export = @account.exports.create!(user: @admin, kind: "account", created_at: 12.hours.ago)
+    assert_not fresh_export.expired?
+  end
+end
