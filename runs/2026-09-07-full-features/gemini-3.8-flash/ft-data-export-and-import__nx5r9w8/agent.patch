+class Export::CardSerializer
+  attr_reader :card
+
+  def initialize(card)
+    @card = card
+  end
+
+  def as_json
+    {
+      id: card.id,
+      number: card.number,
+      title: card.title,
+      status: card.status,
+      description: card.description&.to_plain_text,
+      description_html: card.description&.to_s,
+      created_at: card.created_at&.iso8601,
+      updated_at: card.updated_at&.iso8601,
+      last_active_at: card.last_active_at&.iso8601,
+      closed: card.closed?,
+      postponed: card.postponed?,
+      golden: card.golden?,
+      board: {
+        id: card.board_id,
+        name: card.board&.name
+      },
+      column: card.column ? {
+        id: card.column_id,
+        name: card.column.name
+      } : nil,
+      creator: card.creator ? {
+        id: card.creator_id,
+        name: card.creator.name,
+        email_address: card.creator.identity&.email_address
+      } : nil,
+      assignees: card.assignees.map do |assignee|
+        {
+          id: assignee.id,
+          name: assignee.name,
+          email_address: assignee.identity&.email_address
+        }
+      end,
+      tags: card.tags.pluck(:title).sort,
+      steps: card.steps.map do |step|
+        {
+          id: step.id,
+          content: step.content,
+          completed: step.completed?
+        }
+      end,
+      comments: card.comments.chronologically.map do |comment|
+        {
+          id: comment.id,
+          body: comment.body&.to_plain_text,
+          body_html: comment.body&.to_s,
+          creator: comment.creator ? {
+            id: comment.creator_id,
+            name: comment.creator.name,
+            email_address: comment.creator.identity&.email_address
+          } : nil,
+          created_at: comment.created_at&.iso8601,
+          updated_at: comment.updated_at&.iso8601,
+          attachments: (comment.attachments || []).map do |attachment|
+            blob = attachment.blob
+            {
+              filename: blob.filename.to_s,
+              byte_size: blob.byte_size,
+              content_type: blob.content_type,
+              path: "cards/#{card.number}/attachments/#{blob.key}-#{blob.filename}"
+            }
+          end
+        }
+      end,
+      attachments: ([
+        *(card.image.attached? ? [ card.image.attachment ] : []),
+        *(card.attachments || [])
+      ]).map do |attachment|
+        blob = attachment.blob
+        {
+          filename: blob.filename.to_s,
+          byte_size: blob.byte_size,
+          content_type: blob.content_type,
+          path: "cards/#{card.number}/attachments/#{blob.key}-#{blob.filename}"
+        }
+      end
+    }
+  end
+end
