@@ -0,0 +1,30 @@
+class Account::ImportsController < ApplicationController
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    @import = Current.account.imports.build(user: Current.user)
+    file = params[:file] || params.dig(:account_import, :file) || params.dig(:import, :file)
+
+    if file.present?
+      @import.file.attach(file)
+      if @import.save
+        @import.import_later
+        respond_to do |format|
+          format.html { redirect_to account_settings_path, notice: "Your account import has started. We'll email you when it's done." }
+          format.json { render json: { status: "pending", id: @import.id }, status: :accepted }
+        end
+      else
+        render :new, status: :unprocessable_entity
+      end
+    else
+      @import.errors.add(:file, "must be provided")
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  def show
+    @import = Current.account.imports.find(params[:id])
+  end
+end
