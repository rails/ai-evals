diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..08a46ca
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,63 @@
+class Account::Import < ApplicationRecord
+  self.table_name = "account_imports"
+
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def process_now
+    update!(status: :processing)
+    context = Account::DataTransfer::ImportContext.new(importing_user: user)
+
+    begin
+      Account.transaction do
+        ZipFile.open(file) do |reader|
+          unless reader.glob("accounts/*.json").any?
+            raise "Invalid account export: no account record found in archive"
+          end
+
+          manifest = Account::DataTransfer::Manifest.new(nil)
+          manifest.each_record_set do |record_set|
+            record_set.import_from(reader, context: context)
+          end
+        end
+
+        raise "Account could not be created from archive" unless context.new_account
+      end
+
+      new_account = context.new_account
+
+      # Reconcile storage totals
+      new_account.reconcile_storage rescue nil
+      new_account.materialize_storage rescue nil
+
+      # Reindex search records
+      new_account.cards.published.find_each(&:reindex)
+      Comment.where(account_id: new_account.id).find_each(&:reindex)
+
+      update!(status: :completed, imported_account: new_account)
+      ImportMailer.completed(self).deliver_later
+    rescue StandardError => e
+      # Clean up uploaded storage files
+      context.blob_key_map.values.each do |key|
+        ActiveStorage::Blob.service.delete(key) rescue nil
+      end
+
+      # Ensure account is destroyed if somehow created
+      if context.new_account&.persisted?
+        context.new_account.destroy rescue nil
+      end
+
+      update!(status: :failed, error_message: e.message)
+      ImportMailer.failed(self, e.message).deliver_later
+    end
+  end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..ddc7bdf
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,99 @@
+class Export < ApplicationRecord
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), default: "account"
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  scope :account_exports, -> { where(kind: "account") }
+  scope :cards_exports, -> { where(kind: "cards") }
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def process_now
+    update!(status: :processing)
+    begin
+      if account?
+        process_account_export
+      else
+        process_cards_export
+      end
+      update!(status: :completed)
+      ExportMailer.export_ready(self).deliver_later
+    rescue StandardError => e
+      update!(status: :failed, error_message: e.message)
+      raise e
+    end
+  end
+
+  def expired?
+    created_at < 1.day.ago
+  end
+
+  def accessible_to?(other_user)
+    other_user == user || other_user.admin?
+  end
+
+  def publicly_accessible?
+    false
+  end
+
+  private
+    def process_account_export
+      filename = "#{account.name.parameterize}-account-export-#{id}.zip"
+      ZipFile.create_for(file, filename: filename) do |zip|
+        Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+          record_set.export_to(zip)
+        end
+      end
+    end
+
+    def process_cards_export
+      filename = "#{account.name.parameterize}-cards-export-#{id}.zip"
+      ZipFile.create_for(file, filename: filename) do |zip|
+        cards = user.accessible_cards.reverse_chronologically
+        all_cards_json = []
+
+        cards.find_each do |card|
+          card_data = Export::CardSerializer.new(card).as_json
+          all_cards_json << card_data
+
+          json_str = JSON.pretty_generate(card_data)
+          zip.add_file("cards/#{card.number}.json", json_str)
+          zip.add_file("cards/#{card.number}/card.json", json_str)
+
+          all_attachments = [
+            *(card.image.attached? ? [ card.image.attachment ] : []),
+            *(card.attachments || []),
+            *card.comments.flat_map { |c| c.attachments || [] }
+          ].compact.uniq(&:id)
+
+          all_attachments.each do |attachment|
+            blob = attachment.blob
+            next unless blob
+
+            blob.open do |io|
+              prefixed_path = "cards/#{card.number}/attachments/#{blob.key}-#{blob.filename}"
+              zip.add_file(prefixed_path, compress: false) do |sink|
+                IO.copy_stream(io, sink)
+              end
+
+              io.rewind
+              simple_path = "cards/#{card.number}/#{blob.filename}"
+              unless zip.exists?(simple_path)
+                zip.add_file(simple_path, compress: false) do |sink|
+                  IO.copy_stream(io, sink)
+                end
+              end
+            end
+          end
+        end
+
+        zip.add_file("cards.json", JSON.pretty_generate(all_cards_json))
+      end
+    end
+end
