+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+    @import = @account.imports.create!(user: @user, imported_account: @account)
+  end
+
+  test "completed email is sent to user" do
+    email = ImportMailer.completed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "Your Fizzy import is complete", email.subject
+  end
+
+  test "failed email includes reason" do
+    email = ImportMailer.failed(@import, "Corrupted archive file")
