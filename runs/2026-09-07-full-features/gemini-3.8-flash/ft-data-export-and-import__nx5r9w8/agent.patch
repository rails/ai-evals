@@ -0,0 +1,48 @@
+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    Current.account = @account
+
+    @export = @account.exports.create!(user: @admin, kind: "account")
+    @export.process_now
+    assert @export.completed?
+    assert @export.file.attached?
+  end
+
+  test "downloads export using signed token within 1 day" do
+    token = @export.signed_id(purpose: :download, expires_in: 1.day)
+    get export_path(token)
+
+    assert_response :success
+    assert_equal "application/zip", response.content_type
+  end
+
+  test "download fails when expired after 1 day" do
+    travel 2.days do
+      token = @export.signed_id(purpose: :download, expires_in: 1.day)
+      get export_path(token)
+
+      assert_response :not_found
+    end
+  end
+
+  test "download by raw id for authenticated user" do
+    sign_in_as :kevin
+
+    get export_path(@export)
+    assert_response :success
+    assert_equal "application/zip", response.content_type
+  end
+
+  test "download by raw id fails after 1 day" do
+    sign_in_as :kevin
+
+    travel 2.days do
+      get export_path(@export)
+      assert_response :not_found
+    end
+  end
+end
