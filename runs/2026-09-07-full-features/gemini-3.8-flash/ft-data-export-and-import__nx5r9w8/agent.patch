+      record.attributes.slice(*attributes)
+    end
+
+    def import_record(attributes, context:)
+      old_id = attributes["id"]
+      remapped = remap_attributes(attributes, context: context)
+      new_id = ActiveRecord::Type::Uuid.generate
+      remapped["id"] = new_id
+      context.id_map[old_id] = new_id if old_id
+
+      model.insert(remapped.slice(*model.column_names))
+    end
+
+    def remap_attributes(attributes, context:)
+      attrs = attributes.dup
+      attrs["account_id"] = context.new_account.id if model.column_names.include?("account_id")
+
+      # Remap any foreign key column ending in _id
+      model.column_names.each do |col|
+        if col.end_with?("_id") && col != "account_id" && attrs[col].present?
+          attrs[col] = context.id_map[attrs[col]] || attrs[col]
+        end
+      end
+
+      # Remap polymorphic ids
+      %w[eventable_id reactable_id source_id container_id record_id notifiable_target_id mentionee_id reacter_id].each do |col|
+        if model.column_names.include?(col) && attrs[col].present?
+          attrs[col] = context.id_map[attrs[col]] || attrs[col]
+        end
+      end
+
+      # Unique key for Board::Publication
+      if model == ::Board::Publication && attrs["key"].present?
+        if ::Board::Publication.exists?(key: attrs["key"])
+          attrs["key"] = ::Board::Publication.generate_unique_secure_token(:key)
+        end
+      end
+
+      attrs
+    end
 end
