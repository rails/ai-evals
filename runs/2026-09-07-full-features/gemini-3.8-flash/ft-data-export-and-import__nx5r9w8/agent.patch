@@ -0,0 +1,23 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @user = import.user
+    @account = import.imported_account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import is complete"
+    )
+  end
+
+  def failed(import, reason)
+    @import = import
+    @user = import.user
+    @reason = reason
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy import failed"
+    )
+  end
+end
