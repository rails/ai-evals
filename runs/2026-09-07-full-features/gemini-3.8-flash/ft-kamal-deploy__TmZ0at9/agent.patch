index 82d2cea..5cc15f6 100644
--- a/README.md
+++ b/README.md
@@ -9,6 +9,24 @@ You are welcome -- and encouraged -- to modify Fizzy to your liking.
 Please see our [Development guide](docs/development.md) for how to get Fizzy set up for local development.
 
 
+## Deployment
+
+Fizzy is ready to deploy to a single Linux server with Docker using [Kamal](https://kamal-deploy.org/).
+
+1. Edit `config/deploy.yml`:
+   - Set your server IP under `servers.web`
+   - Set your hostname under `proxy.host`
+   - Set your image repository under `image` (and configure `registry` credentials if private)
+   - Configure your mail server under `env.clear` (`SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`, etc.)
+2. Configure your secrets in `.kamal/secrets`:
+   - `RAILS_MASTER_KEY` (from `config/master.key` or generated with `bin/rails secret`)
+   - `SMTP_PASSWORD` (password for your mail server)
+   - `KAMAL_REGISTRY_PASSWORD` (if using an authenticated image registry)
+3. Run `kamal setup` (or `bin/kamal setup`)
+
+Your Fizzy instance will be accessible at `https://your-host` with SSL automatically configured by the proxy, SQLite data persisted across deploys, and background jobs running on the box.
+
+
 ## Contributing
 
 We welcome contributions! Please read our [style guide](STYLE.md) before submitting code.
diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..0336358
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,64 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (use your-user/fizzy on external registries).
+image: your-user/fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto certification via Let's Encrypt and allow for multiple apps on a single web server.
+proxy:
+  ssl: true
+  host: &app_host app.example.com
+
+# Credentials for your image host.
+registry:
+  # Specify the registry server, if you're not using Docker Hub
+  # server: registry.digitalocean.com / ghcr.io / ...
+  username: your-user
+
+  # Always use an access token rather than real password (pulled from .kamal/secrets).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue Supervisor inside the web server's Puma process to do jobs.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Application host for URL generation in mailers and notifications
+    APP_HOST: *app_host
+
+    # Mail server configuration
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_USERNAME: username
+    # SMTP_AUTH: plain
+    # MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+  secret:
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# Use a persistent storage volume for SQLite database files and local Active Storage files.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
