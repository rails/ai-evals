index 0000000..e3a2b58
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,74 @@
+module SearchesHelper
+  def highlight_search_title(card, query)
+    if card.title.blank?
+      ""
+    elsif query.blank?
+      card_html_title(card)
+    else
+      escaped = card_html_title(card)
+      highlight(escaped, search_highlight_phrases(query))
+    end
+  end
+
+  def search_highlight_snippet(text, query)
+    if text.blank?
+      ""
+    else
+      plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+      if query.blank?
+        ERB::Util.html_escape(format_excerpt(plain_text, length: 200))
+      else
+        phrases = search_phrases(query)
+        matched_phrase = phrases.find { |p| plain_text.match?(Regexp.new(Regexp.escape(p), Regexp::IGNORECASE)) }
+
+        snippet = if matched_phrase
+          excerpt(plain_text, matched_phrase, radius: 100) || plain_text
+        else
+          format_excerpt(plain_text, length: 200)
+        end
+
+        highlight(ERB::Util.html_escape(snippet), search_highlight_phrases(query))
+      end
+    end
+  end
+
+  def search_matching_comments(card, query)
+    if query.blank?
+      []
+    else
+      phrases = search_phrases(query)
+      card.comments.select do |comment|
+        body_text = comment.body&.to_plain_text
+        if body_text.present?
+          phrases.any? { |p| body_text.match?(Regexp.new(Regexp.escape(p), Regexp::IGNORECASE)) }
+        else
+          false
+        end
+      end
+    end
+  end
+
+  def card_description_matches?(card, query)
+    if query.blank? || card.description.blank?
+      false
+    else
+      plain_text = card.description.to_plain_text
+      if plain_text.present?
+        phrases = search_phrases(query)
+        phrases.any? { |p| plain_text.match?(Regexp.new(Regexp.escape(p), Regexp::IGNORECASE)) }
+      else
+        false
+      end
+    end
+  end
+
+  private
+    def search_phrases(query)
+      stripped = query.to_s.strip
+      ([ stripped ] + stripped.split(/\s+/)).uniq.reject(&:blank?)
+    end
+
+    def search_highlight_phrases(query)
+      search_phrases(query).map { |phrase| ERB::Util.html_escape(phrase) }
+    end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
