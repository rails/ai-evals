+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<div class="center max-width margin-block">
+  <%= form_with url: search_path, method: :get, class: "full-width", html: { role: "search" }, data: { turbo_frame: "_top" } do |form| %>
+    <div class="search__field flex gap-half align-center">
+      <%= form.search_field :q, value: @query, placeholder: "Search cards…", class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+      <%= form.submit "Search", class: "btn btn--primary" %>
+    </div>
+  <% end %>
+</div>
+
+<%= turbo_frame_tag :cards_container do %>
+  <section class="cards cards--grid">
+    <div class="cards__list hide-scrollbar">
+      <% if @query.present? %>
+        <%= with_automatic_pagination :cards_paginated_container, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card %>
+        <% end %>
+        <div class="blank-slate">No cards match this search</div>
+      <% else %>
+        <div class="blank-slate">Enter a search term to find cards</div>
+      <% end %>
+    </div>
+  </section>
+<% end %>
