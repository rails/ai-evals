+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search_cards
+    set_page_and_extract_portion_from @cards
+  end
+
+  private
+    def search_cards
+      if @query.present?
+        Current.user.accessible_cards
+          .published
+          .search(@query)
+          .reverse_chronologically
+          .preloaded
+          .preload(comments: [ :rich_text_body, :creator ])
+      else
+        Card.none
+      end
+    end
+end
