+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  include HtmlHelper
+  include ExcerptHelper
+  test "highlight_search_title highlights matched word" do
+    card = cards(:logo)
+    assert_equal "The <mark>logo</mark> isn't big enough", highlight_search_title(card, "logo")
+  end
+
+  test "highlight_search_title handles case insensitivity" do
+    card = cards(:logo)
+    assert_equal "The <mark>logo</mark> isn't big enough", highlight_search_title(card, "LOGO")
+  end
+
+  test "highlight_search_title handles backticks and highlights" do
+    card = cards(:logo).dup
+    card.title = "Fix the `critical_bug` immediately"
+    assert_equal "Fix the <code><mark>critical_bug</mark></code> immediately", highlight_search_title(card, "critical_bug")
+  end
+
+  test "highlight_search_title escapes HTML" do
+    card = cards(:logo).dup
+    card.title = "<script>alert(1)</script> issue"
+    assert_equal "&lt;<mark>script</mark>&gt;alert(1)&lt;/<mark>script</mark>&gt; issue", highlight_search_title(card, "script")
+  end
+
+  test "highlight_search_title returns original html title when query is blank" do
+    card = cards(:logo)
+    assert_equal card_html_title(card), highlight_search_title(card, "")
+    assert_equal card_html_title(card), highlight_search_title(card, nil)
+  end
+
+  test "search_highlight_snippet excerpts and highlights plain text" do
+    text = "The quick brown fox jumps over the lazy dog"
+    assert_equal "The <mark>quick</mark> brown fox jumps over the lazy dog", search_highlight_snippet(text, "quick")
+  end
+
+  test "search_highlight_snippet excerpts around distant matches" do
+    long_text = ("word " * 50) + "findme " + ("word " * 50)
+    result = search_highlight_snippet(long_text, "findme")
+    assert_includes result, "<mark>findme</mark>"
+    assert result.length < 300
+  end
+
+  test "search_matching_comments finds comments matching query" do
+    card = cards(:layout)
+    matching = search_matching_comments(card, "overflowing")
+    assert_equal 1, matching.size
+    assert_equal comments(:layout_overflowing_david), matching.first
+
+    assert_empty search_matching_comments(card, "nonexistent")
+    assert_empty search_matching_comments(card, "")
+  end
+
+  test "card_description_matches? detects matches in description" do
+    card = cards(:logo).dup
+    card.description = "Detailed explanation of the issue"
+    assert card_description_matches?(card, "explanation")
+    assert_not card_description_matches?(card, "nonexistent")
+    assert_not card_description_matches?(card, "")
+  end
+end
