index 0000000..b6f20e9
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,198 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @user = users(:kevin)
+    @account = accounts("37s")
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "show without query" do
+    get search_path
+    assert_response :success
+    assert_select "form[role='search']"
+    assert_select "article.card", count: 0
+    assert_select ".blank-slate", text: /Enter a search term/
+  end
+
+  test "show with whitespace query" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "article.card", count: 0
+    assert_select ".blank-slate", text: /Enter a search term/
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds cards by title case-insensitively" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select "mark", text: "logo"
+  end
+
+  test "finds cards by title with backticks" do
+    card = boards(:writebook).cards.create!(
+      creator: @user,
+      title: "Fix the `critical_bug` immediately",
+      status: "published"
+    )
+
+    get search_path(q: "critical_bug")
+    assert_response :success
+
+    assert_select "article.card" do
+      assert_select "code mark", text: "critical_bug"
+    end
+  end
+
+  test "escapes HTML in title and wraps in mark" do
+    card = boards(:writebook).cards.create!(
+      creator: @user,
+      title: "Fix <script>alert('xss')</script> vulnerability",
+      status: "published"
+    )
+
+    get search_path(q: "script")
+    assert_response :success
+
+    assert_select "article.card script", count: 0
+    assert_select "article.card mark", text: "script"
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "article.card", count: 1
+    assert_select "article.card" do
+      assert_select "h3.card__title", text: /Layout is broken/
+      assert_select "mark", text: "overflowing"
+    end
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    card = cards(:buy_domain)
+    card.update!(description: "Need to check if the DNS records are properly configured")
+
+    get search_path(q: "configured")
+    assert_response :success
+
+    assert_select "article.card" do
+      assert_select "h3.card__title", text: /Buy domain/
+      assert_select "mark", text: "configured"
+    end
+  end
+
+  test "finds cards newest first" do
+    older = boards(:writebook).cards.create!(
+      creator: @user,
+      title: "Older target card",
+      created_at: 2.days.ago,
+      status: "published"
+    )
+    newer = boards(:writebook).cards.create!(
+      creator: @user,
+      title: "Newer target card",
+      created_at: 1.day.ago,
+      status: "published"
+    )
+
+    get search_path(q: "target card")
+    assert_response :success
+
+    card_titles = css_select("article.card h3.card__title").map(&:text).map(&:strip)
+    target_titles = card_titles.select { |t| t.include?("target card") }
+    assert_equal [ "Newer target card", "Older target card" ], target_titles
+  end
+
+  test "people only ever see results from boards they currently have access to" do
+    private_card = boards(:private).cards.create!(
+      creator: @user,
+      title: "Top secret confidential project",
+      status: "published"
+    )
+
+    # Kevin sees it
+    get search_path(q: "confidential")
+    assert_response :success
+    assert_select "article.card", count: 1
+
+    # David does NOT see it
+    logout_and_sign_in_as :david
+    get search_path(q: "confidential")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "people cannot see comment matches from boards they do not have access to" do
+    private_card = boards(:private).cards.create!(
+      creator: @user,
+      title: "Unmarked title",
+      status: "published"
+    )
+    private_card.comments.create!(creator: @user, body: "Classified discussion topic")
+
+    # Kevin sees it
+    get search_path(q: "Classified")
+    assert_response :success
+    assert_select "article.card", count: 1
+
+    # David does NOT see it
+    logout_and_sign_in_as :david
+    get search_path(q: "Classified")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "revoking access immediately hides card from search results" do
+    access = accesses(:writebook_kevin)
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "article.card", count: 1
+
+    access.destroy!
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft_card = boards(:writebook).cards.create!(
+      creator: @user,
+      title: "Draft unfinished thoughts",
+      status: "drafted"
+    )
+
+    get search_path(q: "unfinished")
+    assert_response :success
+    assert_select "article.card", count: 0
+
+    draft_card.update_columns(title: "Draft with special keyword xyz123")
+
+    get search_path(q: "xyz123")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+
+  test "sanitizes SQL LIKE wildcards" do
+    get search_path(q: "%")
+    assert_response :success
+    assert_select "article.card", count: 0
+
+    get search_path(q: "_")
+    assert_response :success
+    assert_select "article.card", count: 0
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
