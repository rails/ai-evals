--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -47,6 +47,33 @@ class Card < ApplicationRecord
     end
   end
 
+  scope :search, ->(query) do
+    stripped_query = query.to_s.strip
+
+    if stripped_query.present?
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(stripped_query)}%"
+
+      card_ids_from_description = ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where("body LIKE ? ESCAPE '\\'", pattern)
+        .select(:record_id)
+
+      card_ids_from_comments = Comment
+        .joins(:rich_text_body)
+        .where("action_text_rich_texts.body LIKE ? ESCAPE '\\'", pattern)
+        .select(:card_id)
+
+      where(
+        "cards.title LIKE :pattern ESCAPE '\\' OR cards.id IN (:card_ids_from_description) OR cards.id IN (:card_ids_from_comments)",
+        pattern: pattern,
+        card_ids_from_description: card_ids_from_description,
+        card_ids_from_comments: card_ids_from_comments
+      )
+    else
+      none
+    end
+  end
+
   def card
     self
   end
