+
+  test "filter by multiple board_ids" do
+    writebook = boards(:writebook)
+
+    get activities_path(format: :json), params: { board_ids: [ writebook.id ] }
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |a| a["board"]["id"] }.uniq
+    assert_equal [ writebook.id ], board_ids
