+        "avatar_url": "http://app.fizzy.localhost:3006/897362094/users/03azfurjljx3onhc5w51s9r6h/avatar"
+      },
+      "assignees": [],
+      "has_more_assignees": false,
+      "comments_url": "http://app.fizzy.localhost:3006/897362094/cards/5/comments",
+      "reactions_url": "http://app.fizzy.localhost:3006/897362094/cards/5/reactions"
+    },
+    "board": {
+      "id": "03ayv6mp60xg3aqes0m9sa68w",
