diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..2023abb
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,59 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :refresh_account_bytes_used_later
+  end
+
+  def bytes_used
+    super || 0
+  end
+
+  def refresh_bytes_used_later
+    Board::StorageJob.perform_later(self)
+  end
+
+  def refresh_bytes_used_now
+    update_columns(bytes_used: calculate_bytes_used)
+    account&.refresh_bytes_used_now
+  end
+
+  def calculate_bytes_used
+    rich_text_ids = ActionText::RichText.where(
+      record_type: "Board",
+      name: "public_description",
+      record_id: id
+    ).or(
+      ActionText::RichText.where(
+        record_type: "Card",
+        name: "description",
+        record_id: cards.select(:id)
+      )
+    ).or(
+      ActionText::RichText.where(
+        record_type: "Comment",
+        name: "body",
+        record_id: Comment.where(card_id: cards.select(:id)).select(:id)
+      )
+    ).select(:id)
+
+    attachments = ActiveStorage::Attachment.where(
+      record_type: "Card",
+      name: "image",
+      record_id: cards.select(:id)
+    ).or(
+      ActiveStorage::Attachment.where(
+        record_type: "ActionText::RichText",
+        name: "embeds",
+        record_id: rich_text_ids
+      )
+    )
+
+    attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+  end
+
+  private
+    def refresh_account_bytes_used_later
+      account&.refresh_bytes_used_later
+    end
+end
