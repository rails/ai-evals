@@ -0,0 +1,166 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @user = users(:david)
+    Current.user = @user
+    Current.account = @board.account
+  end
+
+  test "bytes_used defaults to 0" do
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counts card images" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board.cards.create!(title: "Card with image", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("board description attachment"),
+      filename: "board.txt",
+      content_type: "text/plain"
+    )
+
+    @board.update!(public_description: "<div><action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card description attachment"),
+      filename: "desc.txt",
+      content_type: "text/plain"
+    )
+
+    card = @board.cards.create!(title: "Card with desc embed", creator: @user, status: :published)
+    card.update!(description: "<div><action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+
+    card = @board.cards.create!(title: "Card for comment", creator: @user, status: :published)
+    card.comments.create!(creator: @user, body: "<div><action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "does not count unrelated attachments" do
+    @user.avatar.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates bytes_used when card image is purged" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board.cards.create!(title: "Card with image", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    card.image.purge
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates bytes_used when card description embed is removed" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card description attachment"),
+      filename: "desc.txt",
+      content_type: "text/plain"
+    )
+
+    card = @board.cards.create!(title: "Card", creator: @user, status: :published)
+    card.update!(description: "<div><action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    card.update!(description: "No attachments now")
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates bytes_used when comment with embedded file is destroyed" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+
+    card = @board.cards.create!(title: "Card", creator: @user, status: :published)
+    comment = card.comments.create!(creator: @user, body: "<div><action-text-attachment sgid=\"#{blob.attachable_sgid}\"></action-text-attachment></div>")
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    comment.destroy
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates bytes_used when card is destroyed" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board.cards.create!(title: "Card", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    card.destroy
+    perform_enqueued_jobs
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "updates bytes_used when card is moved to another board" do
+    other_board = boards(:private)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board.cards.create!(title: "Moving Card", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    card.move_to(other_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, other_board.reload.bytes_used
+  end
+end
