diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..ab63ff7
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.user = @user
+    Current.account = @account
+    @board1 = boards(:writebook)
+    @board2 = boards(:private)
+  end
+
+  test "bytes_used defaults to 0" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "includes usage across all boards in the account" do
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("board 2 text embed"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+
+    card1 = @board1.cards.create!(title: "Card 1", creator: @user, status: :published)
+    card1.image.attach(blob1)
+
+    card2 = @board2.cards.create!(title: "Card 2", creator: @user, status: :published)
+    card2.update!(description: "<div><action-text-attachment sgid=\"#{blob2.attachable_sgid}\"></action-text-attachment></div>")
+
+    perform_enqueued_jobs
+
+    expected_total = blob1.byte_size + blob2.byte_size
+    assert_equal blob1.byte_size, @board1.reload.bytes_used
+    assert_equal blob2.byte_size, @board2.reload.bytes_used
+    assert_equal expected_total, @account.reload.bytes_used
+  end
+
+  test "bytes_used does not change when card moves between boards in same account" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board1.cards.create!(title: "Moving Card", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    initial_usage = @account.reload.bytes_used
+    assert_equal blob.byte_size, initial_usage
+
+    card.move_to(@board2)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board1.reload.bytes_used
+    assert_equal blob.byte_size, @board2.reload.bytes_used
+    assert_equal initial_usage, @account.reload.bytes_used
+  end
+
+  test "bytes_used updates when a board is destroyed" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board1.cards.create!(title: "Card on board 1", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    @board1.destroy
+    perform_enqueued_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "bytes_used excludes boards from other accounts" do
+    other_account = accounts(:initech)
+    other_board = boards(:miltons_wish_list)
+
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("avatar.png").open,
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    card = @board1.cards.create!(title: "Card", creator: @user, status: :published)
+    card.image.attach(blob)
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @account.reload.bytes_used
+    assert_equal 0, other_account.reload.bytes_used
+  end
+
+  test "bytes_used does not count user avatars" do
+    @user.avatar.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+end
