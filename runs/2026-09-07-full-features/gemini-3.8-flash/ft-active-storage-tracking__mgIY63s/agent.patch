diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..2d6562f 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,62 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorageAttachmentStorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :refresh_storage_later
+    before_destroy :remember_storage_board
+    after_destroy_commit :refresh_remembered_storage_later
+  end
+
+  def delete
+    board = storage_board
+    super.tap do
+      board&.refresh_bytes_used_later
+    end
+  end
+
+  private
+    def storage_board
+      case record_type
+      when "Card"
+        record&.board if name == "image"
+      when "ActionText::RichText"
+        if name == "embeds"
+          rich_text = record
+          case rich_text&.record_type
+          when "Board"
+            rich_text.record if rich_text.name == "public_description"
+          when "Card"
+            rich_text.record&.board if rich_text.name == "description"
+          when "Comment"
+            rich_text.record&.card&.board if rich_text.name == "body"
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def refresh_storage_later
+      storage_board&.refresh_bytes_used_later
+    end
+
+    def remember_storage_board
+      @storage_board = storage_board
+    end
+
+    def refresh_remembered_storage_later
+      @storage_board&.refresh_bytes_used_later
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorageAttachmentStorageTracking
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include ActiveStorageAttachmentStorageTracking
+end
