diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..b045d03
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @identity = identities(:david)
+  end
+
+  test "unauthenticated user cannot access new import page" do
+    untenanted do
+      get new_account_import_url
+      assert_response :redirect
+    end
+  end
+
+  test "signed in user can view new import page" do
+    sign_in_as @user
+
+    untenanted do
+      get new_account_import_url
+      assert_response :success
+      assert_select "h1", "Import account"
+      assert_select "input[type=file]"
+    end
+  end
+
+  test "submitting import without file shows error" do
+    sign_in_as @user
+
+    untenanted do
+      post account_imports_url, params: { file: "" }
+      assert_response :unprocessable_entity
+      assert_equal "Please choose a file to import.", flash[:alert]
+    end
+  end
+
+  test "submitting valid account file imports everything into a new account" do
+    # Export current account
+    export = @account.exports.create!(user: users(:jason), export_type: "account")
+    export.perform_now
+    assert export.file.attached?
+
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    uploaded_file = fixture_file_upload(tempfile.path, "application/zip")
+
+    sign_in_as @user
+
+    initial_accounts_count = Account.count
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        untenanted do
+          post account_imports_url, params: { file: uploaded_file }
+          assert_response :redirect
+        end
+      end
+    end
+
+    assert_equal initial_accounts_count + 1, Account.count
+
+    new_account = Account.order(created_at: :desc).first
+    assert_not_equal @account.id, new_account.id
+    assert_equal @account.name, new_account.name
+
+    # Check boards, cards, comments, users were created
+    assert new_account.boards.any?, "New account should have boards"
+    assert new_account.cards.any?, "New account should have cards"
+    assert new_account.users.any?, "New account should have users"
+
+    # User who imported has access
+    importer_user = new_account.users.find_by(identity_id: @identity.id)
+    assert_not_nil importer_user
+    assert importer_user.admin?
+
+    # Verify email
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, "import is complete"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+
+  test "failed import leaves nothing behind and sends email explaining why" do
+    tempfile = Tempfile.new([ "corrupt", ".zip" ])
+    tempfile.binmode
+    tempfile.write("CORRUPT_NOT_A_ZIP")
+    tempfile.rewind
+
+    uploaded_file = fixture_file_upload(tempfile.path, "application/zip")
+
+    sign_in_as @user
+
+    initial_accounts_count = Account.count
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        untenanted do
+          post account_imports_url, params: { file: uploaded_file }
+          assert_response :redirect
+        end
+      end
+    end
+
+    # Nothing left behind
+    assert_equal initial_accounts_count, Account.count
+
+    # Failure email was sent explaining why
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, "import failed"
+    assert_includes email.text_part.body.to_s, "Reason:"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
