+++ b/test/models/export_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:jason)
+    @user = users(:david)
+  end
+
+  test "account export creates a zip file with records, card JSONs, and comments" do
+    export = @account.exports.create!(user: @admin, export_type: "account")
+
+    assert_emails 1 do
+      export.perform_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    # Inspect zip contents
+    ZipFile.open(export.file) do |zip|
+      assert zip.glob("accounts/*.json").any?
+      assert zip.glob("users/*.json").any?
+      assert zip.glob("boards/*.json").any?
+      assert zip.glob("cards/*.json").any?
+
+      # Verify card JSON format with comments
+      cards_data = zip.read_json("cards.json")
+      assert cards_data.is_a?(Array)
+      assert cards_data.any?
+
+      first_card = cards_data.first
+      assert first_card.key?("number")
+      assert first_card.key?("title")
+      assert first_card.key?("comments")
+    end
+  end
+
+  test "cards export contains cards visible to user as JSON with comments" do
+    export = @user.exports.create!(account: @account, user: @user, export_type: "cards")
+
+    assert_emails 1 do
+      export.perform_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |zip|
+      cards_data = zip.read_json("cards.json")
+      assert cards_data.is_a?(Array)
+
+      card_files = zip.glob("cards/*.json")
+      assert card_files.any?
+
+      sample_card = zip.read_json(card_files.first)
+      assert sample_card.key?("title")
+      assert sample_card.key?("comments")
+      assert sample_card.key?("attachments")
+    end
+  end
+
+  test "download token expires after 1 day" do
+    export = @account.exports.create!(user: @admin, export_type: "account")
+    token = export.download_token
+
+    assert_equal export, Export.find_by_download_token(token)
+
+    travel 25.hours do
+      assert_nil Export.find_by_download_token(token)
+    end
+  end
+
+test "cards export includes attached image and comment attachments" do
+  card = cards(:logo)
+  card.image.attach(
+    io: StringIO.new("fake image data"),
+    filename: "photo.jpg",
+    content_type: "image/jpeg"
+  )
+  comment = card.comments.create!(
+    creator: @user,
+    body: "Test comment"
+  )
+
+  export = @user.exports.create!(account: @account, user: @user, export_type: "cards")
+  export.perform_now
+
+  ZipFile.open(export.file) do |zip|
+    assert zip.exists?("cards/#{card.number}/photo.jpg")
+
+    card_data = zip.read_json("cards/#{card.number}/card.json")
+    assert_equal card.title, card_data["title"]
+    assert_equal "photo.jpg", card_data["attachments"].first["filename"]
+
+    comment_entry = card_data["comments"].find { |c| c["id"] == comment.id }
+    assert_not_nil comment_entry
+    assert_equal "Test comment", comment_entry["body"]
+  end
+end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..f6e1c24
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:jason)
+    @identity = identities(:jason)
+  end
+
+  test "imports an account file and recreates boards, cards, comments, files, people" do
+    # 1. Export the account first
+    export = @account.exports.create!(user: @admin, export_type: "account")
+    export.perform_now
+    assert export.file.attached?
+
+    # Download export to a tempfile
+    tempfile = Tempfile.new([ "export", ".zip" ])
+    tempfile.binmode
+    tempfile.write(export.file.download)
+    tempfile.rewind
+
+    # 2. Import into a new account
+    new_account = Account.create!(name: "Importing...")
+    import = Import.create!(account: new_account, identity: @identity)
+    Current.with_account(new_account) do
+      import.file.attach(io: tempfile, filename: "account-export.zip", content_type: "application/zip")
+    end
+
+    original_account_count = Account.count
+    assert_emails 1 do
+      import.perform_now
+    end
+
+    assert_equal "completed", import.status
+    assert_equal original_account_count, Account.count
+    assert_not_equal @account.id, new_account.id
+
+    # Verify boards, cards, comments, users were created
+    assert new_account.boards.any?, "New account should have boards"
+    assert new_account.cards.any?, "New account should have cards"
+    assert new_account.users.any?, "New account should have users"
+
+    # Verify importer has owner access to the new account
+    importer_user = new_account.users.find_by(identity_id: @identity.id)
+    assert_not_nil importer_user, "Importer should be a user in the new account"
+    assert importer_user.admin?, "Importer should have admin/owner permissions"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+    new_account&.destroy! rescue nil
+  end
+
+  test "failed import leaves nothing behind and sends email explaining why" do
+    tempfile = Tempfile.new([ "corrupt", ".zip" ])
+    tempfile.binmode
+    tempfile.write("NOT_A_ZIP_FILE_CORRUPTED_DATA")
+    tempfile.rewind
+
+    new_account = Account.create!(name: "Importing...")
+    import = Import.create!(account: new_account, identity: @identity)
+    Current.with_account(new_account) do
+      import.file.attach(io: tempfile, filename: "corrupt.zip", content_type: "application/zip")
+    end
+
+    account_id = new_account.id
+    initial_accounts_count = Account.count - 1 # excluding the temporary one
+
+    assert_emails 1 do
+      assert_raises StandardError do
+        import.perform_now
+      end
+    end
+
+    # Leaves nothing behind: account is gone
+    assert_not Account.exists?(account_id), "Account should have been deleted"
+    assert_equal initial_accounts_count, Account.count
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
