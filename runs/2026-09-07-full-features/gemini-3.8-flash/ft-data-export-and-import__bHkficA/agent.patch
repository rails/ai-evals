diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..f5c31ff 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -3,9 +3,56 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
     super(account: account, model: ::ActionText::RichText)
   end
 
+  def import(zip, id_map = {}, key_map = {})
+    with_zip(zip) do
+      entries = zip.glob("#{model_dir}/*.json")
+      entries.each do |entry_path|
+        data = zip.read_json(entry_path)
+        next unless data.is_a?(Hash)
+
+        old_id = data["id"]
+        new_id = ActiveRecord::Type::Uuid.generate
+        id_map[old_id] = new_id if old_id
+
+        attrs = data.slice(*attributes)
+        attrs["id"] = new_id
+        attrs["account_id"] = account.id
+        attrs["record_id"] = id_map[attrs["record_id"]] if id_map.key?(attrs["record_id"])
+
+        if attrs["body"].present?
+          attrs["body"] = update_embedded_sgids(attrs["body"], id_map)
+        end
+
+        ::ActionText::RichText.insert_all!([ attrs ])
+      end
+    end
+  end
+
   private
     def records
       ::ActionText::RichText.where(account: account)
     end
 
+    def update_embedded_sgids(body, id_map)
+      body.gsub(/sgid="([^"]+)"/) do |match|
+        sgid_str = $1
+        begin
+          data_part = sgid_str.split("--").first
+          decoded = Base64.urlsafe_decode64(data_part) rescue Base64.decode64(data_part)
+          if decoded =~ %r{ActiveStorage::Blob/([a-zA-Z0-9_-]+)}
+            old_blob_id = $1
+            if (new_blob_id = id_map[old_blob_id])
+              new_blob = ActiveStorage::Blob.find_by(id: new_blob_id)
+              new_blob ? "sgid=\"#{new_blob.attachable_sgid}\"" : match
+            else
+              match
+            end
+          else
+            match
+          end
+        rescue
+          match
+        end
+      end
+    end
 end
