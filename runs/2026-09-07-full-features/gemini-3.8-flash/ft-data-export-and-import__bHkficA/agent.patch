diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..e605b13
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,59 @@
+require "zip"
+
+class ZipFile::Reader
+  attr_reader :zip
+
+  class << self
+    def open(file_or_io, &block)
+      if file_or_io.is_a?(ActiveStorage::Attached::One) || file_or_io.is_a?(ActiveStorage::Blob)
+        blob = file_or_io.is_a?(ActiveStorage::Blob) ? file_or_io : file_or_io.blob
+        blob.open do |tempfile|
+          Zip::File.open(tempfile.path) do |zip|
+            yield new(zip)
+          end
+        end
+      elsif file_or_io.respond_to?(:path)
+        Zip::File.open(file_or_io.path) do |zip|
+          yield new(zip)
+        end
+      else
+        Zip::File.open(file_or_io.to_s) do |zip|
+          yield new(zip)
+        end
+      end
+    end
+  end
+
+  def initialize(zip)
+    @zip = zip
+  end
+
+  def entries
+    @zip.entries.map(&:name)
+  end
+
+  def glob(pattern)
+    @zip.glob(pattern).map(&:name).sort
+  end
+
+  def exists?(entry_name)
+    @zip.find_entry(entry_name).present?
+  end
+
+  def read(entry_name)
+    entry = @zip.find_entry(entry_name)
+    entry&.get_input_stream&.read
+  end
+
+  def read_json(entry_name)
+    content = read(entry_name)
+    JSON.parse(content) if content
+  end
+
+  def open(entry_name)
+    entry = @zip.find_entry(entry_name)
+    if entry
+      entry.get_input_stream { |io| yield io }
+    end
+  end
+end
diff --git a/app/models/zip_file/remote_io.rb b/app/models/zip_file/remote_io.rb
new file mode 100644
index 0000000..82a79d4
--- /dev/null
+++ b/app/models/zip_file/remote_io.rb
@@ -0,0 +1,46 @@
+require "net/http"
+require "openssl"
+
+class ZipFile::RemoteIO < ZipKit::RemoteIO
+  protected
+    def request_range(range)
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = range
+        response = http.request(request)
+        case response.code
+        when "206", "200"
+          response.body
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+    def request_object_size
+      with_http do |http|
+        request = Net::HTTP::Get.new(@uri)
+        request.range = 0..0
+        response = http.request(request)
+        case response.code
+        when "206"
+          content_range = response["Content-Range"]
+          content_range.split("/").last.to_i
+        when "200"
+          response["Content-Length"].to_i
+        else
+          raise "Remote at #{@uri} replied with code #{response.code}"
+        end
+      end
+    end
+
+  private
+    def with_http
+      http = Net::HTTP.new(@uri.hostname, @uri.port)
+      http.use_ssl = (@uri.scheme == "https")
+      http.verify_mode = OpenSSL::SSL::VERIFY_NONE
+      http.start do
+        yield http
+      end
+    end
+end
