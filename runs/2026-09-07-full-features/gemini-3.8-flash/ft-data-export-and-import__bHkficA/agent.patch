@@ -0,0 +1,35 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  def perform_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def perform_now
+    Current.with_account(account) do
+      update!(status: "processing")
+
+      ZipFile.open(file) do |zip|
+        importer = Account::DataTransfer::Importer.new(zip, importer_identity: identity, account: account)
+        importer.import
+      end
+
+      update!(status: "completed")
+      ImportMailer.completed(account, recipient_email: identity.email_address).deliver_later
+      account
+    end
+  rescue => error
+    recipient_email = identity.email_address
+    update!(status: "failed", error_message: error.message) rescue nil
+    ImportMailer.failed(recipient_email: recipient_email, error_message: error.message).deliver_later
+    file.purge rescue nil
+    account&.destroy! rescue nil
+    destroy rescue nil
+    raise error
+  end
+end
