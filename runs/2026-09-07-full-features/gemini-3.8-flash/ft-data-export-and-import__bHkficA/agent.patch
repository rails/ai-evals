@@ -0,0 +1,22 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  def new
+  end
+
+  def create
+    if params[:file].present?
+      new_account = Account.create!(name: "Importing...")
+      import = Import.create!(account: new_account, identity: Current.identity)
+      Current.with_account(new_account) do
+        import.file.attach(params[:file])
+      end
+      import.perform_later
+      target_url = Current.account.present? ? root_path : session_menu_path(script_name: nil)
+      redirect_to target_url, notice: "Your import has started. We'll send you an email when it's done."
+    else
+      flash.now[:alert] = "Please choose a file to import."
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
