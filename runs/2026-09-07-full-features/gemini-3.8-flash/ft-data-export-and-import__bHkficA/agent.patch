+class ExportsController < ApplicationController
+  skip_before_action :require_account
+  allow_unauthenticated_access only: :show
+  include ActiveStorage::Streaming
+
+  def show
+    export = Export.find_by_download_token(params[:id])
+    export ||= Export.find_by(id: params[:id]) if authenticated?
+
+    if export&.file&.attached?
+      if export.created_at >= 1.day.ago
+        send_blob_stream export.file.blob, disposition: "attachment"
+      else
+        render plain: "This download link has expired.", status: :gone
+      end
+    else
+      render plain: "This download link is invalid or has expired.", status: :gone
+    end
+  end
+end
