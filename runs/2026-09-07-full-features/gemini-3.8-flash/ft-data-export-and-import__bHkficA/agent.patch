 end
diff --git a/app/models/account/data_transfer/exporter.rb b/app/models/account/data_transfer/exporter.rb
new file mode 100644
index 0000000..3b547a0
--- /dev/null
+++ b/app/models/account/data_transfer/exporter.rb
@@ -0,0 +1,33 @@
+class Account::DataTransfer::Exporter
+  include Account::DataTransfer::CardExportHelper
+
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def export_to(zip)
+    manifest = Account::DataTransfer::Manifest.new(account)
+    manifest.each_record_set do |record_set|
+      record_set.export(zip)
+    end
+
+    export_card_records(zip)
+  end
+
+  private
+    def export_card_records(zip)
+      all_cards_data = []
+
+      account.cards.published.includes(:board, :column, :creator, :tags, :steps, comments: [ :creator ]).find_each do |card|
+        card_data = build_card_data(card, zip)
+        all_cards_data << card_data
+
+        json_str = JSON.pretty_generate(card_data)
+        zip.add_file("cards/#{card.number}/card.json", json_str)
+      end
+
+      zip.add_file("cards.json", JSON.pretty_generate(all_cards_data))
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..10d05b8
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,91 @@
+class Account::DataTransfer::Importer
+  attr_reader :zip, :importer_identity, :account
+
+  def initialize(zip, importer_identity:, account:)
+    @zip = zip
+    @importer_identity = importer_identity
+    @account = account
+  end
+
+  def import
+    id_map = {}
+    key_map = {}
+
+    begin
+      account_entry = zip.glob("accounts/*.json").first
+      raise "Invalid account export: missing account data" unless account_entry
+
+      account_data = zip.read_json(account_entry)
+      account_name = account_data["name"].presence || "Imported Account"
+
+      id_map[account_data["id"]] = account.id
+      account.update_columns(name: account_name)
+
+      manifest = Account::DataTransfer::Manifest.new(account)
+      manifest.each_record_set do |record_set|
+        record_set.import(zip, id_map, key_map)
+      end
+
+      ensure_importer_access(account)
+
+      account.update_columns(cards_count: account.cards.count)
+      reindex_account(account)
+
+      account
+    rescue => error
+      cleanup_failed_import
+      raise error
+    end
+  end
+
+  private
+    def cleanup_failed_import
+      return unless account&.persisted?
+
+      ActiveStorage::Blob.where(account_id: account.id).find_each do |blob|
+        blob.purge rescue nil
+      end
+
+      ActionText::RichText.where(account_id: account.id).delete_all
+      ActiveStorage::Attachment.where(account_id: account.id).delete_all
+      Event.where(account_id: account.id).delete_all
+      Notification.where(account_id: account.id).delete_all
+
+      account.destroy! rescue nil
+    end
+
+    def ensure_importer_access(account)
+      return unless importer_identity
+
+      user = account.users.find_by(identity_id: importer_identity.id)
+
+      if user.nil?
+        user = account.users.joins(:identity).find_by(identities: { email_address: importer_identity.email_address })
+        if user
+          user.update!(identity_id: importer_identity.id)
+        else
+          owner = account.users.find_by(role: :owner) || account.users.first
+          if owner && owner.identity_id.nil?
+            owner.update!(identity_id: importer_identity.id)
+            user = owner
+          else
+            user = account.users.create!(
+              name: importer_identity.email_address.split("@").first,
+              identity: importer_identity,
+              role: :owner,
+              verified_at: Time.current
+            )
+          end
+        end
+      end
+
+      user.update!(role: :owner) if user && !user.owner?
+    end
+
+    def reindex_account(account)
+      account.cards.published.find_each(&:reindex)
+      Comment.where(account_id: account.id).find_each(&:reindex)
+    rescue => e
+      Rails.logger.warn("Reindexing failed during import: #{e.message}")
+    end
+end
