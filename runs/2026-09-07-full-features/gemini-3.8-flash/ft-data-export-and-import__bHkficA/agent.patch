@@ -0,0 +1,59 @@
+class Export < ApplicationRecord
+  belongs_to :account, optional: true
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+  enum :export_type, %w[ account cards ].index_by(&:itself), default: "account"
+
+  scope :account_exports, -> { where(export_type: "account") }
+  scope :cards_exports, -> { where(export_type: "cards") }
+
+  def download_token
+    signed_id(purpose: :download, expires_in: 1.day)
+  end
+
+  def self.find_by_download_token(token)
+    find_signed(token, purpose: :download)
+  end
+
+  def perform_later
+    ExportJob.perform_later(self)
+  end
+
+  def perform_now
+    Current.with_account(account || user.account) do
+      update!(status: "processing")
+
+    filename = if account_export?
+      "account-#{account.external_account_id}-export.zip"
+    else
+      "cards-export.zip"
+    end
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account_export?
+        Account::DataTransfer::Exporter.new(account).export_to(zip)
+      else
+        Export::CardsExporter.new(user).export_to(zip)
+      end
+    end
+
+    update!(status: "completed")
+    ExportMailer.completed(self).deliver_later
+  rescue => error
+    update!(status: "failed")
+    Rails.logger.error("Export #{id} failed: #{error.message}\n#{error.backtrace.join("\n")}")
+    raise error
+    end
+  end
+
+  def account_export?
+    export_type == "account"
+  end
+
+  def cards_export?
+    export_type == "cards"
+  end
+end
