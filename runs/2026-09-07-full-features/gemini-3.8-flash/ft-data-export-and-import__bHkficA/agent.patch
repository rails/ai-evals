diff --git a/app/models/account/data_transfer/card_export_helper.rb b/app/models/account/data_transfer/card_export_helper.rb
new file mode 100644
index 0000000..e1a5620
--- /dev/null
+++ b/app/models/account/data_transfer/card_export_helper.rb
@@ -0,0 +1,100 @@
+module Account::DataTransfer::CardExportHelper
+  def build_card_data(card, zip)
+    card_attachments = []
+
+    if card.image.attached?
+      img_path = "cards/#{card.number}/#{card.image.filename}"
+      unless zip.exists?(img_path)
+        zip.add_file(img_path) { |sink| card.image.download { |chunk| sink.write(chunk) } }
+      end
+      card_attachments << {
+        filename: card.image.filename.to_s,
+        content_type: card.image.content_type,
+        byte_size: card.image.byte_size,
+        path: img_path
+      }
+    end
+
+    card.attachments.each do |att|
+      att_path = add_attachment_to_zip(zip, "cards/#{card.number}", att)
+      card_attachments << {
+        filename: att.filename.to_s,
+        content_type: att.content_type,
+        byte_size: att.byte_size,
+        path: att_path
+      }
+    end
+
+    comments_data = card.comments.chronologically.map do |comment|
+      comment_attachments = []
+      comment.attachments.each do |att|
+        att_path = add_attachment_to_zip(zip, "cards/#{card.number}/comments/#{comment.id}", att)
+        comment_attachments << {
+          filename: att.filename.to_s,
+          content_type: att.content_type,
+          byte_size: att.byte_size,
+          path: att_path
+        }
+      end
+
+      {
+        id: comment.id,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        created_at: comment.created_at,
+        updated_at: comment.updated_at,
+        creator: comment.creator ? {
+          id: comment.creator_id,
+          name: comment.creator.name,
+          email: comment.creator.identity&.email_address
+        } : nil,
+        attachments: comment_attachments
+      }
+    end
+
+    {
+      id: card.id,
+      number: card.number,
+      title: card.title,
+      description: card.description.to_plain_text,
+      description_html: card.description.to_s,
+      status: card.status,
+      closed: card.closed?,
+      postponed: card.postponed?,
+      golden: card.golden?,
+      created_at: card.created_at,
+      updated_at: card.updated_at,
+      last_active_at: card.last_active_at,
+      board: {
+        id: card.board_id,
+        name: card.board.name
+      },
+      column: card.column ? {
+        id: card.column_id,
+        name: card.column.name
+      } : nil,
+      creator: card.creator ? {
+        id: card.creator_id,
+        name: card.creator.name,
+        email: card.creator.identity&.email_address
+      } : nil,
+      assignees: card.assignees.map { |a| { id: a.id, name: a.name, email: a.identity&.email_address } },
+      tags: card.tags.pluck(:title),
+      steps: card.steps.map { |s| { id: s.id, content: s.content, completed: s.completed? } },
+      comments: comments_data,
+      attachments: card_attachments
+    }
+  end
+
+  def add_attachment_to_zip(zip, dir, att)
+    filename = att.filename.to_s
+    path = "#{dir}/#{filename}"
+    if zip.exists?(path)
+      path = "#{dir}/#{att.blob_id}-#{filename}"
+    end
+    unless zip.exists?(path)
+      zip.add_file(path) { |sink| att.download { |chunk| sink.write(chunk) } }
+    end
+    path
+  end
+end
