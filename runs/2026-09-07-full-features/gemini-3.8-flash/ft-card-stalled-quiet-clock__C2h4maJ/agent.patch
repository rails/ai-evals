diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..dee58d2
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,54 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :stalled, -> {
+      active
+        .where.not(bursted_at: nil)
+        .where(last_active_at: ..2.weeks.ago)
+    }
+
+    after_touch :reset_stall_if_stalled, if: :stalled?
+  end
+
+  def stalled?
+    active? && bursted? && last_active_at <= 2.weeks.ago
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+  alias_method :burst?, :bursted?
+
+  def burst!(at = Time.current)
+    update!(bursted_at: at)
+  end
+
+  def reset_stall
+    update!(bursted_at: nil)
+  end
+
+  def stalled_in_days
+    return 0 unless stalled?
+    (Time.current.to_date - last_active_at.to_date).to_i
+  end
+
+  def check_for_burst_from_comments(new_comment = nil)
+    return unless published?
+
+    window = (board.auto_postpone_period / 3.0)
+    latest_time = new_comment&.created_at || Time.current
+    window_start = latest_time - window
+
+    recent_comments = comments.by_user.where(created_at: window_start..latest_time)
+
+    if recent_comments.count >= 3 && recent_comments.select(:creator_id).distinct.count >= 2
+      burst!(latest_time)
+    end
+  end
+
+  private
+    def reset_stall_if_stalled
+      touch_last_active_at
+    end
+end
