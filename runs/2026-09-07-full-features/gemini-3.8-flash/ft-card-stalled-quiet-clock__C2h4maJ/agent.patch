diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..bd6dee4
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,280 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    Current.account = @account
+    Current.session = sessions(:david)
+    Current.user = users(:david)
+    @board = boards(:writebook)
+    @card = @board.cards.create!(creator: users(:david), status: "published")
+  end
+
+  test "burst triggered by three comments from at least two people within 1/3 auto-close period" do
+    assert_not @card.bursted?
+
+    # Auto-close period for writebook board is 30 days, so 1/3 is 10 days
+    @card.comments.create!(creator: users(:david), body: "First comment")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:kevin), body: "Second comment")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:david), body: "Third comment")
+    assert @card.reload.bursted?
+  end
+
+  test "no burst when three comments are from the same person" do
+    assert_not @card.bursted?
+
+    3.times do |i|
+      @card.comments.create!(creator: users(:david), body: "Comment #{i}")
+    end
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "no burst when only two comments from two people" do
+    assert_not @card.bursted?
+
+    @card.comments.create!(creator: users(:david), body: "First comment")
+    @card.comments.create!(creator: users(:kevin), body: "Second comment")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "no burst when comments fall outside 1/3 of the auto-close period" do
+    assert_not @card.bursted?
+
+    @board.auto_postpone_period_in_days = 30
+    # 1/3 of 30 days is 10 days. Create comments older than 10 days
+    travel_to 15.days.ago do
+      @card.comments.create!(creator: users(:david), body: "Old comment 1")
+      @card.comments.create!(creator: users(:kevin), body: "Old comment 2")
+    end
+
+    # Current comment is outside the 10-day window from the first two
+    @card.comments.create!(creator: users(:david), body: "New comment")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "system comments do not count towards burst" do
+    assert_not @card.bursted?
+
+    @card.comments.create!(creator: users(:david), body: "David comment")
+    @card.comments.create!(creator: users(:kevin), body: "Kevin comment")
+    # System comment
+    @card.comments.create!(creator: accounts("37s").system_user, body: "System comment")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "burst triggered when someone is assigned to it" do
+    assert_not @card.bursted?
+
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    assert @card.reload.bursted?
+  end
+
+  test "burst triggered when card is reopened" do
+    @card.close
+    assert @card.reload.closed?
+    assert_not @card.bursted?
+
+    @card.reopen
+    assert @card.reload.open?
+    assert @card.reload.bursted?
+  end
+
+  test "card becomes stalled after two weeks of no activity following a burst" do
+    @card.burst!
+    assert @card.bursted?
+    assert_not @card.stalled?
+
+    travel 1.week
+    assert_not @card.stalled?
+
+    travel 1.week + 1.minute
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+    assert_equal 14, @card.stalled_in_days
+  end
+
+  test "card without a burst is not stalled after two weeks of inactivity" do
+    assert_not @card.bursted?
+    @card.update_columns(last_active_at: 3.weeks.ago)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed card is not stalled" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.close
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "postponed card is not stalled" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.postpone
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comment activity on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(creator: users(:david), body: "Pinging this card")
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "title change on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.update!(title: "Updated Title")
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "tagging activity on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.toggle_tag_with("urgent")
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "reaction on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.reactions.create!(content: "👍", reacter: users(:david))
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "assignment on stalled card resets old stall and triggers new burst" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.assignments.create!(assignee: users(:kevin), assigner: users(:david))
+    @card.reload
+
+    assert_not @card.stalled?
+    assert @card.bursted?
+
+    travel 2.weeks + 1.minute
+    assert @card.stalled?
+  end
+
+  test "activity before two weeks resets the inactivity timer" do
+    @card.burst!
+    @card.update_columns(last_active_at: Time.current)
+
+    travel 1.week
+    @card.touch_last_active_at # activity occurred 1 week in
+
+    travel 1.week # 2 weeks from burst, but only 1 week from last activity
+    assert_not @card.stalled?
+
+    travel 1.week + 1.minute # 2 weeks from last activity
+    assert @card.stalled?
+  end
+
+  test "scope indexed_by stalled" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "burst respects board-specific auto-close period override" do
+    @board.update!(auto_postpone_period_in_days: 7)
+    # 1/3 of 7 days is ~56 hours
+
+    travel_to 60.hours.ago do
+      @card.comments.create!(creator: users(:david), body: "60 hours ago")
+    end
+
+    travel_to 20.hours.ago do
+      @card.comments.create!(creator: users(:kevin), body: "20 hours ago")
+    end
+
+    # david comments now: 60h ago is outside 56h window, so only 2 comments in window
+    @card.comments.create!(creator: users(:david), body: "Now")
+    assert_not @card.reload.bursted?
+
+    # Another comment within the window by kevin: now 3 comments within 56 hours!
+    @card.comments.create!(creator: users(:kevin), body: "Now too")
+    assert @card.reload.bursted?
+  end
+
+  test "unassigning a user from a stalled card resets the stall" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.toggle_assignment(users(:kevin))
+    @card.reload
+    assert_not @card.stalled?
+  end
+
+  test "step activity on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.steps.create!(content: "Do something")
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "rich text description change on stalled card resets it" do
+    @card.burst!
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.update!(description: "Updated description")
+    @card.reload
+
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "burst? and bursted? aliases" do
+    assert_not @card.burst?
+    assert_not @card.bursted?
+
+    @card.burst!
+    assert @card.burst?
+    assert @card.bursted?
+  end
+end
