+require "application_system_test_case"
+
+class StalledCardTest < ApplicationSystemTestCase
+  test "viewing a stalled card displays the stalled bubble" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card.burst!
+    card.update_columns(last_active_at: 16.days.ago)
+
+    visit card_url(card)
+
+    within("##{dom_id(card, :bubble)}") do
+      assert_text(/Stalled for/i)
+      assert_text "16"
+      assert_text(/days/i)
+    end
+  end
+
+  test "listing stalled cards with indexed_by=stalled" do
+    sign_in_as(users(:david))
+
+    card = cards(:logo)
+    card.burst!
+    card.update_columns(last_active_at: 14.days.ago)
+
+    visit cards_url(indexed_by: "stalled")
+
+    within("##{dom_id(card, :bubble)}") do
+      assert_text(/Stalled for/i)
+      assert_text "14"
+      assert_text(/days/i)
+    end
+  end
+end
