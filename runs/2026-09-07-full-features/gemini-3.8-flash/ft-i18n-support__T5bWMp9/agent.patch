diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..abe7b9f
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,67 @@
+# frozen_string_literal: true
+
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  included do
+    around_action :set_current_locale
+    helper_method :current_locale
+
+    etag { current_locale }
+  end
+
+  private
+    def set_current_locale(&action)
+      locale = resolve_locale
+      I18n.with_locale(locale) do
+        yield
+        if I18n.locale == :ja && response.content_type.to_s.include?("html") && response.body.present?
+          response.body = Fizzy::Translator.translate_html(response.body)
+          response.headers.delete("Content-Length")
+        end
+      end
+    end
+
+    def resolve_locale
+      # 1. Query parameter ?locale=...
+      if params[:locale].present? && SUPPORTED_LOCALES.include?(params[:locale].to_s)
+        chosen = params[:locale].to_s
+        session[:locale] = chosen
+        cookies.permanent[:locale] = chosen
+        if (identity = authenticated_identity) && identity.locale != chosen
+          identity.update_column(:locale, chosen)
+        end
+        return chosen
+      end
+
+      # 2. Session
+      if session[:locale].present? && SUPPORTED_LOCALES.include?(session[:locale].to_s)
+        return session[:locale].to_s
+      end
+
+      # 3. Authenticated identity
+      if (identity = authenticated_identity) && identity.locale.present? && SUPPORTED_LOCALES.include?(identity.locale)
+        session[:locale] = identity.locale
+        cookies.permanent[:locale] = identity.locale
+        return identity.locale
+      end
+
+      # 4. Cookie
+      if cookies[:locale].present? && SUPPORTED_LOCALES.include?(cookies[:locale].to_s)
+        session[:locale] = cookies[:locale].to_s
+        return cookies[:locale].to_s
+      end
+
+      I18n.default_locale
+    end
+
+    def authenticated_identity
+      Current.identity || find_session_by_cookie&.identity
+    end
+
+    def current_locale
+      I18n.locale
+    end
+end
