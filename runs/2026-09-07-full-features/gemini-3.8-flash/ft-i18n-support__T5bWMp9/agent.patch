+
+      # This code has been used X/Y times.
+      [ /\AThis code has been used (\d+)\/(\d+) times\.\z/, ->(m) { "このコードは#{m[1]}/#{m[2]}回使用されました。" } ],
+
+      # Search results for "..."
+      [ /\ASearch results for "(.*?)"\z/, ->(m) { "「#{m[1]}」の検索結果" } ],
+
+      # Load page N
+      [ /\ALoad page (\d+)\z/, ->(m) { "ページ#{m[1]}を読み込む" } ],
+
+      # Just a sec while we sign you in with ...
+      [ /\AJust a sec while we sign you in with (.*?)\.\z/, ->(m) { "#{m[1]}でサインインしています。少々お待ちください。" } ],
+
+      # The code sent to ... will work for ...
+      [ /\AThe code sent to (.*?) will work for (.*?)\.\z/, ->(m) { "#{m[1]}宛に送信されたコードの有効期限は#{m[2]}です。" } ],
+
+      # Your ... account will be closed immediately.
+      [ /\AYour (.*?) account will be closed immediately\.\z/, ->(m) { "#{m[1]}アカウントは直ちに閉鎖されます。" } ],
+
+      # Showing the X most recent (Y are hidden)
+      [ /\AShowing the (\d+) most recent \((\d+) are hidden\)\z/, ->(m) { "最新の#{m[1]}件を表示中（#{m[2]}件は非表示）" } ],
+
+      # X person/people will be notified when someone comments on this.
+      [ /\A(\d+) (?:people|person) will be notified when someone comments on this\.\z/, ->(m) { "誰かがコメントしたときに#{m[1]}人に通知されます。" } ],
+
+      # No activity for X days
+      [ /\ANo activity for (\d+) days\z/, ->(m) { "#{m[1]}日間アクティビティがありません" } ],
+
+      # Maximum X assignees
+      [ /\AMaximum (\d+) assignees\z/, ->(m) { "担当者は最大#{m[1]}人です" } ],
+
+      # Show X more watchers
+      [ /\AShow (\d+) more watchers\z/, ->(m) { "さらに#{m[1]}人のウォッチャーを表示" } ],
