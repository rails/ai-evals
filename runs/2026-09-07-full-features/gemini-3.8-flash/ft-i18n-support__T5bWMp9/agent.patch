+      # Save changes (...)
+      [ /\ASave changes \((.*?)\)\z/, ->(m) { "変更を保存 (#{m[1]})" } ],
+
+      # Post this comment (...)
+      [ /\APost this comment \((.*?)\)\z/, ->(m) { "コメントを投稿 (#{m[1]})" } ],
+
+      # Cancel (...)
+      [ /\ACancel \((.*?)\)\z/, ->(m) { "キャンセル (#{m[1]})" } ],
+
+      # Create card (...)
+      [ /\ACreate card \((.*?)\)\z/, ->(m) { "カードを作成 (#{m[1]})" } ],
+
+      # Create and add another (...)
+      [ /\ACreate and add another \((.*?)\)\z/, ->(m) { "作成してもう1枚追加 (#{m[1]})" } ],
+
+      # Unpin this card (...)
+      [ /\AUnpin this card \((.*?)\)\z/, ->(m) { "このカードのピン留めを外す (#{m[1]})" } ],
+
+      # Pin this card (...)
+      [ /\APin this card \((.*?)\)\z/, ->(m) { "このカードをピン留め (#{m[1]})" } ],
+
+      # Stop watching (...)
+      [ /\AStop watching \((.*?)\)\z/, ->(m) { "ウォッチを停止 (#{m[1]})" } ],
+
+      # Watch this (...)
+      [ /\AWatch this \((.*?)\)\z/, ->(m) { "ウォッチする (#{m[1]})" } ],
+
+      # Demote to normal (...)
+      [ /\ADemote to normal \((.*?)\)\z/, ->(m) { "通常カードに戻す (#{m[1]})" } ],
+
+      # Promote to Golden Ticket (...)
+      [ /\APromote to Golden Ticket \((.*?)\)\z/, ->(m) { "ゴールデンチケットにする (#{m[1]})" } ],
+
+      # Download ...
+      [ /\ADownload (.*?)\z/, ->(m) { "#{m[1]}をダウンロード" } ],
+
+      # Notifications since ...
+      [ /\ANotifications since (.*?)\z/, ->(m) { "#{m[1]}以降の通知" } ],
+
+      # Ask someone from ... to send you a new link or increase the limit.
+      [ /\AAsk someone from (.*?) to send you a new link or increase the limit\.\z/, ->(m) { "新しいリンクの送信または上限の引き上げを#{m[1]}のメンバーに依頼してください。" } ],
+
+      # Join ... in Fizzy
+      [ /\AJoin (.*?) in Fizzy\z/, ->(m) { "Fizzyで#{m[1]}に参加" } ],
+
+      # Unsubscribing from all email notifications as ...…
+      [ /\AUnsubscribing from all email notifications as (.*?)…\z/, ->(m) { "#{m[1]}としてすべてのメール通知の配信停止を処理しています…" } ],
+
+      # ... @mentioned you
+      [ /\A(.*?) @mentioned you\z/, ->(m) { "#{m[1]}さんがあなたをメンションしました" } ],
+
+      # Hotkeys: Something (kbd)
+      [ /\A(.*?)\s+<kbd class="([^"]*)">([A-Za-z0-9+ ]+)<\/kbd>\z/, ->(m) {
+        label = translate_value(m[1])
+        "#{label} <kbd class=\"#{m[2]}\">#{m[3]}</kbd>"
+      } ]
+    ].freeze
+
+    class << self
+      def translate_value(text)
+        return text if text.nil? || text.empty?
+
+        trimmed = text.strip
+        return text if trimmed.empty?
+
+        if (exact_match = EXACT[trimmed])
+          return replace_trimmed(text, trimmed, exact_match)
+        end
+
+        PATTERNS.each do |pattern, replacer|
+          if (match = trimmed.match(pattern))
+            translated = replacer.call(match)
+            return replace_trimmed(text, trimmed, translated)
+          end
+        end
+
+        text
+      end
+
+      def translate_text(text)
+        translate_value(text)
+      end
+
+      def translate_html(html)
+        return html if html.nil? || html.empty?
+
+        is_full_doc = html.lstrip.start_with?("<!DOCTYPE", "<html")
+        doc = is_full_doc ? Nokogiri::HTML5.parse(html) : Nokogiri::HTML5.fragment(html)
+
+        if is_full_doc
+          if (html_node = doc.at_css("html"))
+            html_node["lang"] = "ja"
+          end
+        end
+
+        # Traverse all elements
+        doc.traverse do |node|
+          if node.element?
+            translate_element_attributes(node)
+          elsif node.text?
+            next if skippable_node?(node)
+
+            translated = translate_value(node.content)
+            node.content = translated if translated != node.content
+          end
+        end
+
+        is_full_doc ? doc.to_html : doc.to_html
+      end
+
+      private
+        def replace_trimmed(original, trimmed, replacement)
+          leading = original[/\A\s*/]
+          trailing = original[/\s*\z/]
+          "#{leading}#{replacement}#{trailing}"
+        end
+
+        def translate_element_attributes(node)
+          TRANSLATABLE_ATTRS.each do |attr|
+            if (val = node[attr]) && !val.empty?
+              translated = translate_value(val)
+              node[attr] = translated if translated != val
+            end
+          end
+
+          # Translate button / submit values
+          if node.name == "input" && %w[submit button].include?(node["type"])
+            if (val = node["value"]) && !val.empty?
+              translated = translate_value(val)
+              node["value"] = translated if translated != val
+            end
+          end
+        end
+
+        def skippable_node?(node)
+          parent = node.parent
+          while parent && parent.name != "document"
+            return true if SKIP_TAGS.include?(parent.name)
+
+            if (classes = parent["class"]&.split(/\s+/))
+              return true if (classes & SKIP_CLASSES).any?
+            end
+
+            return true if parent.name.include?("lexxy") || parent.name.include?("trix")
+
+            parent = parent.parent
+          end
+          false
+        end
+    end
+  end
+end
