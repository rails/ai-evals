diff --git a/test/integration/japanese_localization_test.rb b/test/integration/japanese_localization_test.rb
new file mode 100644
index 0000000..2af9de6
--- /dev/null
+++ b/test/integration/japanese_localization_test.rb
@@ -0,0 +1,227 @@
+require "test_helper"
+
+class JapaneseLocalizationTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @user.update!(role: :admin)
+    @identity = @user.identity
+    @account = @user.account
+  end
+
+  test "static error pages contain both English and Japanese" do
+    %w[400 404 406-unsupported-browser 422 500].each do |code|
+      path = Rails.root.join("public", "#{code}.html")
+      assert File.exist?(path), "Expected #{path} to exist"
+      content = File.read(path)
+      # Check for Japanese characters
+      assert_match /[\p{Hiragana}\p{Katakana}\p{Han}]/, content, "#{code}.html must contain Japanese"
+      # Check for English characters
+      assert_match /[a-zA-Z]/, content, "#{code}.html must contain English"
+      assert_includes content, "Back home / ホームに戻る"
+    end
+  end
+
+  test "default locale is English for users who never chose anything" do
+    sign_in_as @user
+    get root_url(script_name: @account.slug)
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_select "a", text: /Home|Activity/
+    assert_select ".header__skip-navigation", text: "Skip to main content"
+  end
+
+  test "unsupported locale ?locale=xx does not break page and does not change anything" do
+    sign_in_as @user
+    get root_url(script_name: @account.slug, locale: "xx")
+    assert_response :success
+    assert_select "html[lang='en']"
+    assert_nil @identity.reload.locale
+  end
+
+  test "opening any page with ?locale=ja switches to Japanese and choice sticks for session" do
+    sign_in_as @user
+
+    # Switch to ja
+    get root_url(script_name: @account.slug, locale: "ja")
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_equal "ja", @identity.reload.locale
+    assert_equal "ja", session[:locale]
+
+    # Subsequent request without ?locale remains in Japanese
+    get root_url(script_name: @account.slug)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select ".header__skip-navigation", text: "メインコンテンツへスキップ"
+  end
+
+  test "locale choice sticks the next time they sign in from a clean browser" do
+    # 1. User sets locale to ja
+    @identity.update!(locale: "ja")
+
+    # 2. Simulate clean browser: reset cookies and session
+    reset!
+
+    # 3. Request magic link and sign in
+    untenanted do
+      post session_url, params: { email_address: @identity.email_address }
+      assert_response :redirect
+
+      magic_link = @identity.magic_links.last
+      post session_magic_link_url, params: { code: magic_link.code }
+      assert_response :redirect
+    end
+
+    # 4. Access account page in signed-in session
+    get root_url(script_name: @account.slug)
+    assert_response :success
+    assert_select "html[lang='ja']"
+    assert_select ".header__skip-navigation", text: "メインコンテンツへスキップ"
+  end
+
+  test "unauthenticated visitor can switch to Japanese and choice sticks when signing in" do
+    reset!
+    untenanted do
+      get new_session_url(locale: "ja")
+      assert_response :success
