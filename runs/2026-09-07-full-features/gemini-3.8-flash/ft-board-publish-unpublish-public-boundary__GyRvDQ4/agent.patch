+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+
+  def public_board_url(board_or_key, *args, **options)
+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+
+  def public_board_column_path(board_or_key, *args, **options)
+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+
+  def public_board_column_url(board_or_key, *args, **options)
+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+
+  def public_board_card_path(board_or_key, *args, **options)
+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+
+  def public_board_card_url(board_or_key, *args, **options)
+    key = board_or_key.is_a?(Board) ? board_or_key.public_key : board_or_key
+    super(key, *args, **options.with_defaults(script_name: nil))
+  end
+end
+
+Rails.application.config.to_prepare do
+  Rails.application.routes.named_routes.url_helpers_module.prepend(PublicBoardUrlHelper)
+end
