diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..a36c2cb
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+    assert_not @board.publicly_accessible?
+  end
+
+  test "publish generates public_key" do
+    @board.publish
+
+    assert @board.published?
+    assert_not_nil @board.public_key
+    assert_equal "http://example.com/public/boards/#{@board.public_key}", @board.public_url
+    assert @board.publicly_accessible?
+  end
+
+  test "unpublish clears public_key" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+    assert_not @board.publicly_accessible?
+  end
+
+  test "card publicly_accessible? delegates to board and published status" do
+    card = cards(:logo)
+    assert card.published?
+    assert_not card.publicly_accessible?
+
+    @board.publish
+    assert card.reload.publicly_accessible?
+
+    card.drafted!
+    assert_not card.publicly_accessible?
+  end
+
+  test "column publicly_accessible? delegates to board" do
+    column = columns(:writebook_in_progress)
+    assert_not column.publicly_accessible?
+
+    @board.publish
+    assert column.reload.publicly_accessible?
+  end
+
+  test "published scope returns only published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+    assert_includes Board.published, @board
+
+    @board.unpublish
+    assert_not_includes Board.published, @board
+  end
+end
