+require "test_helper"
+
+class Public::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "unauthenticated user can view published card of published board" do
+    get public_board_card_path(@board, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "unauthenticated user can view card as JSON" do
+    get public_board_card_path(@board, @card), as: :json
+
+    assert_response :success
+    assert_equal @card.id, @response.parsed_body["id"]
+    assert_equal @card.number, @response.parsed_body["number"]
+    assert_equal @card.title, @response.parsed_body["title"]
+    assert_equal "http://www.example.com/public/boards/#{@board.public_key}", @response.parsed_body["board"]["public_url"]
+  end
+
+  test "authenticated user can view published card" do
+    sign_in_as :kevin
+
+    get public_board_card_path(@board, @card)
+    assert_response :success
+  end
+
+  test "user from different account can view published card" do
+    sign_in_as :mike
+
+    get public_board_card_path(@board, @card)
+    assert_response :success
+  end
+
+  test "drafted card cannot be viewed" do
+    draft = @board.cards.create!(title: "Draft card", status: :drafted, creator: users(:david))
+
+    get public_board_card_path(@board, draft)
+    assert_response :not_found
+  end
+
+  test "published card on unpublished board returns not found" do
+    @board.unpublish
+
+    get "/public/boards/#{@board.public_key}/cards/#{@card.number}"
+    assert_response :not_found
+  end
+
+  test "card belonging to another board returns not found" do
+    other_board = boards(:miltons_wish_list)
+    other_board.update!(public_key: Board.generate_unique_secure_token)
+
+    get public_board_card_path(other_board, cards(:shipping))
+    assert_response :not_found
+  end
+
+  test "non-existent card number returns not found" do
+    get "/public/boards/#{@board.public_key}/cards/999999"
+    assert_response :not_found
+  end
+end
