diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..f022004
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,33 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    alias_attribute :key, :public_key
+
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    update!(public_key: self.class.generate_unique_secure_token) unless published?
+  end
+
+  def unpublish
+    update!(public_key: nil) if published?
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publicly_accessible?
+    published?
+  end
+
+  def public_url
+    if published?
+      options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+      Rails.application.routes.url_helpers.public_board_url(public_key, **options.merge(script_name: nil))
+    end
+  end
+end
