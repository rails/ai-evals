diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..f8b7c40
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,30 @@
+class Boards::PublicationsController < ApplicationController
+  skip_before_action :require_account
+  before_action :set_board
+  before_action :ensure_admin
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board, script_name: @board.account.slug) }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to board_path(@board, script_name: @board.account.slug) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = (Current.account ? Current.account.boards : Board).find(params[:board_id] || params[:id])
+      Current.account ||= @board.account
+      Current.user ||= Current.identity&.users&.find_by(account: Current.account)
+    end
+end
