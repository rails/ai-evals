+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish a board" do
+    assert_nil @board.public_key
+
+    post board_publication_path(@board)
+
+    assert_redirected_to board_path(@board)
+    assert @board.reload.published?
+    assert_not_nil @board.public_key
+  end
+
+  test "admin can publish a board via POST /boards/:id/publication" do
+    assert_nil @board.public_key
+
+    post "/boards/#{@board.id}/publication"
+
+    assert_redirected_to board_path(@board)
+    assert @board.reload.published?
+  end
+
+  test "admin can publish a board as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal "http://www.example.com/public/boards/#{@board.public_key}", @response.parsed_body["public_url"]
+  end
+
+  test "admin can unpublish a board" do
+    @board.publish
+    assert @board.published?
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to board_path(@board)
+    assert_not @board.reload.published?
+    assert_nil @board.public_key
+  end
+
+  test "admin can unpublish a board via DELETE /boards/:id/publication" do
+    @board.publish
+    assert @board.published?
+
+    delete "/boards/#{@board.id}/publication"
+
+    assert_redirected_to board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "admin can unpublish a board as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin member cannot publish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin member cannot unpublish a board" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "board creator who is not admin cannot publish board" do
+    logout_and_sign_in_as :david
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "unauthenticated user cannot publish or unpublish" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_response :redirect
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+  end
+
+  test "re-publishing already published board retains key" do
+    @board.publish
+    original_key = @board.public_key
+
+    post board_publication_path(@board)
+    assert_equal original_key, @board.reload.public_key
+  end
+end
