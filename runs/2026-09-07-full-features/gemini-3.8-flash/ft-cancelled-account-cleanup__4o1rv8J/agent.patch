diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..e01e097
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @due_account = accounts("37s")
+    @user = users("david")
+    @due_account.cancel(initiated_by: @user)
+    @due_account.cancellation.update_columns(created_at: 31.days.ago)
+
+    @recent_account = accounts("initech")
+    @recent_user = @recent_account.users.first
+    @recent_account.cancel(initiated_by: @recent_user)
+    @recent_account.cancellation.update_columns(created_at: 10.days.ago)
+  end
+
+  test "permanently removes accounts canceled more than 30 days ago" do
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@due_account.id)
+    assert Account.exists?(@recent_account.id)
+  end
+
+  test "is configured as a recurring job in recurring.yml" do
+    path = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(File.read(path))
+    erb.filename = path.to_s
+    recurring_config = YAML.load(erb.result, aliases: true)
+    tasks = recurring_config["production"]
+
+    task = tasks.values.find { |config| config["class"] == "Account::IncinerateDueJob" }
+    assert_not_nil task, "Account::IncinerateDueJob should be configured in config/recurring.yml"
+    assert_match(/every day/, task["schedule"])
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..597b365
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users("david")
+    Current.user = @user
+  end
+
+  test "due_for_incineration scope includes accounts canceled over 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 29.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes active accounts" do
+    assert_not @account.cancelled?
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    @account.reactivate
+    @account.reload
+
+    assert_not @account.cancelled?
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration? predicate method" do
+    assert_not @account.due_for_incineration?
+
+    @account.cancel(initiated_by: @user)
+    assert_not @account.due_for_incineration?
+
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    assert @account.due_for_incineration?
+  end
+
+  test "incinerate permanently removes account and all associated data" do
+    board = @account.boards.first
+    card = board.cards.create!(title: "Card to incinerate", description: "Rich text description", creator: @user, status: :published)
+
+    file = file_fixture("moon.jpg")
+    blob = ActiveStorage::Blob.create_and_upload!(io: file.open, filename: "test.jpg", content_type: "image/jpeg")
+    blob.update!(account_id: @account.id)
+    card.image.attach(blob)
+
+    card.comments.create!(creator: @user, body: "Comment on card")
+    card.steps.create!(content: "A step")
+    tag = @account.tags.create!(title: "tag-for-incineration")
+    card.taggings.create!(tag: tag)
+    card.watch_by(@user)
+    card.pin_by(@user)
+    card.gild
+    card.close
+
+    Storage::Entry.create!(account_id: @account.id, board_id: board.id, delta: 100, operation: "attach")
+    Search::Record.for(@account.id).upsert!(card.send(:search_record_attributes))
+
+    account_id = @account.id
+    account_binary = ActiveRecord::Type::Uuid.new.serialize(account_id)
+    identity = @user.identity
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(account_id)
+
+    tables = ActiveRecord::Base.connection.tables
+    remaining = {}
+    tables.each do |table|
+      next if table == "accounts"
+      cols = ActiveRecord::Base.connection.columns(table).map(&:name)
+      if cols.include?("account_id")
+        count = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE account_id = ?", nil, [ account_binary ])
+        remaining[table] = count if count > 0
+      end
+    end
+
+    if ActiveRecord::Base.connection.table_exists?("search_records")
+      count = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM search_records WHERE account_id = ?", nil, [ account_binary ])
+      remaining["search_records"] = count if count > 0
+    end
+
+    count = ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM storage_totals WHERE owner_id = ?", nil, [ account_binary ])
+    remaining["storage_totals"] = count if count > 0
+
+    assert_empty remaining, "Expected all records associated with account to be deleted, but found: #{remaining.inspect}"
+
+    # Verify global identity is retained
+    assert Identity.exists?(identity.id)
+  end
+
+  test "incinerate_due removes all due accounts and leaves active/non-due accounts" do
+    due_account = @account
+    due_account.cancel(initiated_by: @user)
+    due_account.cancellation.update_columns(created_at: 35.days.ago)
+
+    recent_account = accounts("initech")
+    recent_user = recent_account.users.first
+    recent_account.cancel(initiated_by: recent_user)
+    recent_account.cancellation.update_columns(created_at: 10.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+  end
+end
