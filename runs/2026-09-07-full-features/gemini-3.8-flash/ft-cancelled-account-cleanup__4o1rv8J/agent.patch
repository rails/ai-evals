diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..afe222d 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,38 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, ->(before: INCINERATION_GRACE_PERIOD.ago) {
+      joins(:cancellation).merge(Account::Cancellation.due_for_incineration(before: before))
+    }
+  end
+
+  class_methods do
+    def incinerate_due(before: INCINERATION_GRACE_PERIOD.ago)
+      due_for_incineration(before: before).find_each do |account|
+        account.incinerate
+      end
+    end
+  end
+
+  def incinerate
+    account_id = id
+
+    destroy
+
+    ActiveStorage::Attachment.where(account_id: account_id).delete_all
+    ActiveStorage::VariantRecord.where(account_id: account_id).delete_all
+    ActiveStorage::Blob.where(account_id: account_id).find_each(&:purge)
+    ActiveStorage::Blob.where(account_id: account_id).delete_all
+    ActionText::RichText.where(account_id: account_id).delete_all
+    Search::Record.for(account_id).where(account_id: account_id).destroy_all
+    Storage::Entry.where(account_id: account_id).delete_all
+    Storage::Total.where(owner_type: "Account", owner_id: account_id).delete_all
+  end
+
+  def due_for_incineration?(before: INCINERATION_GRACE_PERIOD.ago)
+    cancellation&.due_for_incineration?(before: before) || false
+  end
 end
