@@ -49,6 +51,59 @@ class Notification < ApplicationRecord
     read_at.present?
   end
 
+  def deliver_push_notification_later
+    PushNotificationJob.perform_later(self) if !read? && user.push_subscriptions.exists?
+  end
+
+  def deliver_push_notification
+    return if read?
+    return unless user.push_subscriptions.exists?
+    return if ENV["VAPID_PUBLIC_KEY"].blank? || ENV["VAPID_PRIVATE_KEY"].blank?
+
+    user.push_subscriptions.find_each do |subscription|
+      subscription.push(push_payload)
+    end
+  end
+
+  def push_title
+    case source
+    when Event
+      ApplicationController.helpers.event_notification_title(source)
+    when Mention
+      "#{source.mentioner.first_name} @mentioned you"
+    else
+      card&.title.presence || "Notification"
+    end
+  end
+
+  def push_body
+    case source
+    when Event
+      ApplicationController.helpers.event_notification_body(source)
+    when Mention
+      source.source.mentionable_content.truncate(200)
+    else
+      creator&.name.presence || ""
+    end
+  end
+
+  def push_path
+    if Account.multi_tenant
+      Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+    else
+      Rails.application.routes.url_helpers.card_path(card)
+    end
+  end
+
+  def push_payload
+    {
+      title: push_title,
+      body: push_body,
+      path: push_path,
+      url: push_path
+    }
+  end
+
   private
     def set_card
       self.card = source.card
