new file mode 100644
index 0000000..063d427
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,28 @@
+class Push::Subscription < ApplicationRecord
+  self.table_name = "push_subscriptions"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def push(message)
+    payload = message.is_a?(String) ? message : JSON.generate(message)
+
+    vapid = {
+      subject: ENV["VAPID_SUBJECT"].presence || "mailto:support@fizzy.do",
+      public_key: ENV["VAPID_PUBLIC_KEY"],
+      private_key: ENV["VAPID_PRIVATE_KEY"]
+    }.compact
+
+    WebPush.payload_send(
+      endpoint: endpoint,
+      message: payload,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+end
