diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..f779736
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @vapid_key = WebPush.generate_key
+    @original_public = ENV["VAPID_PUBLIC_KEY"]
+    @original_private = ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = @vapid_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = @vapid_key.private_key
+  end
+
+  teardown do
+    ENV["VAPID_PUBLIC_KEY"] = @original_public
+    ENV["VAPID_PRIVATE_KEY"] = @original_private
+  end
+
+  test "validations" do
+    subscription = Push::Subscription.new(user: @user, account: @user.account)
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "push sends payload via WebPush" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://example.com/push/123",
+      p256dh_key: "p256dh_sample",
+      auth_key: "auth_sample"
+    )
+
+    WebPush.expects(:payload_send).with(
+      endpoint: subscription.endpoint,
+      message: '{"title":"Test","body":"Hello"}',
+      p256dh: "p256dh_sample",
+      auth: "auth_sample",
+      vapid: has_entries(
+        public_key: @vapid_key.public_key,
+        private_key: @vapid_key.private_key
+      )
+    )
+
+    subscription.push({ title: "Test", body: "Hello" })
+  end
+
+  test "push destroys subscription on ExpiredSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://example.com/push/expired",
+      p256dh_key: "p256dh_sample",
+      auth_key: "auth_sample"
+    )
+
+    fake_response = Struct.new(:inspect, :body).new("410 Gone", "expired")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(fake_response, "example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push({ title: "Test" })
+    end
+
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+
+  test "push destroys subscription on InvalidSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://example.com/push/invalid",
+      p256dh_key: "p256dh_sample",
+      auth_key: "auth_sample"
+    )
+
+    fake_response = Struct.new(:inspect, :body).new("404 Not Found", "not found")
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(fake_response, "example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      subscription.push({ title: "Test" })
+    end
+
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+end
