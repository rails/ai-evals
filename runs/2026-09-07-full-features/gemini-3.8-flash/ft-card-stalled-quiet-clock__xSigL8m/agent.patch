diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f87a2ca
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,252 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:private) # 30-day auto-close period
+    @david = users(:david)
+    @kevin = users(:kevin)
+    @jz = users(:jz)
+  end
+
+  test "card gets a burst when someone is assigned to it" do
+    card = @board.cards.create!(title: "Assignment burst test", creator: @david, status: :published)
+    assert_not card.bursted?
+
+    card.toggle_assignment(@kevin)
+    assert card.reload.bursted?
+    assert_not card.stalled?
+  end
+
+  test "card gets a burst when assigned directly via assignments association" do
+    card = @board.cards.create!(title: "Direct assignment burst test", creator: @david, status: :published)
+    assert_not card.bursted?
+
+    card.assignments.create!(assignee: @kevin, assigner: @david)
+    assert card.reload.bursted?
+  end
+
+  test "card gets a burst when reopened and stalls after two weeks of inactivity" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Reopen burst test", creator: @david, status: :published)
+    card.close
+    card.update_columns(bursted_at: nil)
+    assert_not card.bursted?
+
+    card.reopen
+    assert card.reload.bursted?
+    assert_not card.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+  end
+
+  test "card gets a burst when 3 or more comments from at least 2 people land within a third of auto-close period" do
+    card = @board.cards.create!(title: "Comments burst test", creator: @david, status: :published)
+    assert_not card.bursted?
+
+    # Board auto-close is 30 days, 1/3 is 10 days
+    card.comments.create!(creator: @david, body: "Comment 1")
+    assert_not card.reload.bursted?
+
+    card.comments.create!(creator: @kevin, body: "Comment 2")
+    assert_not card.reload.bursted?
+
+    card.comments.create!(creator: @david, body: "Comment 3")
+    assert card.reload.bursted?
+  end
+
+  test "3 comments from the same person do not trigger a burst" do
+    card = @board.cards.create!(title: "Single person comments test", creator: @david, status: :published)
+
+    3.times do |i|
+      card.comments.create!(creator: @david, body: "Comment #{i}")
+    end
+
+    assert_not card.reload.bursted?
+  end
+
+  test "2 comments from 2 different people do not trigger a burst" do
