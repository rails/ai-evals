+
+  test "stalled scope and indexed_by stalled" do
+    freeze_time
+
+    stalled_card = @board.cards.create!(title: "Should be stalled", creator: @david, status: :published)
+    stalled_card.toggle_assignment(@kevin)
+
+    unstalled_card = @board.cards.create!(title: "Should not be stalled", creator: @david, status: :published)
+    unstalled_card.comments.create!(creator: @david, body: "Regular card")
+
+    travel 15.days
+
+    assert_includes Card.stalled, stalled_card.reload
+    assert_not_includes Card.stalled, unstalled_card.reload
+
+    assert_includes Card.indexed_by("stalled"), stalled_card.reload
+    assert_not_includes Card.indexed_by("stalled"), unstalled_card.reload
+  end
+end
