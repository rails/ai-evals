+
+    card.comments.create!(creator: @david, body: "Comment 1")
+    card.comments.create!(creator: @kevin, body: "Comment 2")
+
+    assert_not card.reload.bursted?
+  end
+
+  test "comments landing outside a third of the auto-close period do not trigger a burst" do
+    card = @board.cards.create!(title: "Spaced comments test", creator: @david, status: :published)
+
+    # 1/3 of 30 days is 10 days
+    travel_to 15.days.ago do
+      card.comments.create!(creator: @david, body: "Old comment 1")
+    end
+
+    travel_to 12.days.ago do
+      card.comments.create!(creator: @kevin, body: "Old comment 2")
+    end
+
+    card.comments.create!(creator: @david, body: "Recent comment")
+
+    assert_not card.reload.bursted?
+  end
+
+  test "comments burst respects board entropy override" do
+    entropies(:writebook_board).update! auto_postpone_period: 90.days
+    # 1/3 of 90 days is 30 days
+    board = boards(:writebook)
+    card = board.cards.create!(title: "Entropy override burst test", creator: @david, status: :published)
+
+    travel_to 20.days.ago do
+      card.comments.create!(creator: @david, body: "Comment 1")
+    end
+
+    travel_to 15.days.ago do
+      card.comments.create!(creator: @kevin, body: "Comment 2")
+    end
+
+    card.comments.create!(creator: @jz, body: "Comment 3")
+
+    assert card.reload.bursted?
+  end
+
+  test "card that had a burst and sees no activity for two weeks is stalled" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Stalled card test", creator: @david, status: :published)
+    card.toggle_assignment(@kevin)
+    assert card.reload.bursted?
+    assert_not card.stalled?
+
+    travel 15.days
+    assert card.reload.stalled?
+  end
+
+  test "card without a burst seeing no activity for two weeks is not stalled" do
+    freeze_time
+
+    card = @board.cards.create!(title: "No burst test", creator: @david, status: :published)
+    card.comments.create!(creator: @david, body: "Just one comment")
+    assert_not card.reload.bursted?
+
+    travel 15.days
+    assert_not card.reload.stalled?
+  end
+
+  test "closed card is not stalled" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Closed card test", creator: @david, status: :published)
