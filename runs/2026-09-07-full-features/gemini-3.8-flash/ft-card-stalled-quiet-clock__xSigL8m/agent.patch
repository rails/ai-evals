+  end
+
+  test "postponed card is not stalled" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Postponed card test", creator: @david, status: :published)
+    card.toggle_assignment(@kevin)
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    card.postpone
+    assert_not card.reload.stalled?
+  end
+
+  test "any activity on a stalled card resets it" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Reset activity test", creator: @david, status: :published)
+    card.toggle_assignment(@kevin)
+
+    travel 15.days
+    assert card.reload.stalled?
+
+    # Single comment resets it
+    card.comments.create!(creator: @david, body: "Checking in")
+    assert_not card.reload.stalled?
+    assert_not card.reload.bursted?
+  end
+
+  test "reaction on a stalled card resets it" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Reset reaction test", creator: @david, status: :published)
+    card.toggle_assignment(@kevin)
+
+    travel 15.days
+    assert card.reload.stalled?
