+  end
+
+  test "assigning a user to a stalled card resets the stall and starts a new burst" do
+    freeze_time
+
+    card = @board.cards.create!(title: "Reassign stalled test", creator: @david, status: :published)
+    card.toggle_assignment(@kevin)
+
