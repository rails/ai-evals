diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..a264d01
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,49 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :bursted, -> { where.not(bursted_at: nil) }
+    scope :stalled, ->(as_of: Time.current) { active.bursted.where(last_active_at: ..(as_of - 2.weeks)) }
+  end
+
+  def stalled?(as_of: Time.current)
+    active? && bursted? && last_active_at <= (as_of - 2.weeks)
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+
+  def burst!
+    touch_last_active_at(burst: true)
+  end
+
+  def reset_stall!
+    touch_last_active_at(burst: false)
+  end
+
+  def touch_last_active_at(burst: nil)
+    was_stalled = stalled?
+
+    new_bursted_at = if burst == true
+      Time.current
+    elsif burst == false
+      (was_stalled || (assignments.none? && !has_comment_burst?)) ? nil : bursted_at
+    elsif was_stalled
+      nil
+    elsif has_comment_burst?
+      Time.current
+    else
+      bursted_at
+    end
+
+    update!(last_active_at: Time.current, bursted_at: new_bursted_at)
+  end
+
+  def has_comment_burst?
+    window = (board.auto_postpone_period / 3.0).seconds
+    recent_comments = comments.by_user.where(created_at: window.ago..)
+
+    recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+  end
+end
