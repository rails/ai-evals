+require "application_system_test_case"
+
+class StalledCardsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @card.burst!
+    @card.update!(last_active_at: 16.days.ago)
+  end
+
+  test "stalled card displays stalled bubble in browser" do
+    visit card_url(@card)
+
+    assert_selector "article.card--stalled"
+    within(".bubble") do
+      assert_text /stalled for/i
+      assert_text "16"
+      assert_text /days/i
+    end
+  end
+
+  test "listing stalled cards via indexed_by=stalled" do
+    visit cards_url(indexed_by: "stalled")
+
+    assert_selector "article.card--stalled"
+    assert_text @card.title
+  end
+end
