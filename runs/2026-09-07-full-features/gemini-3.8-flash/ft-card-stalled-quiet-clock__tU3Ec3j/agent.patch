diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..6f21de1
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,249 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @user1 = users(:david)
+    @user2 = users(:kevin)
+    @card = boards(:writebook).cards.create!(title: "Fresh Card", status: :published, creator: @user1)
+    @card = Card.find(@card.id)
+  end
+
+  test "card is not stalled by default" do
+    assert_not @card.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "card gets a burst when assigned" do
+    assert_changes -> { @card.bursted? }, from: false, to: true do
+      @card.toggle_assignment(@user2)
+    end
+  end
+
+  test "card gets a burst when reopened" do
+    @card.close
+    assert @card.closed?
+
+    assert_changes -> { @card.bursted? }, from: false, to: true do
+      @card.reopen
+    end
+  end
+
+  test "card gets a burst when 3 comments from 2 people land within 1/3 auto-close period" do
+    freeze_time
+    @card.comments.create!(creator: @user1, body: "First comment")
+    assert_not @card.bursted?
+
+    @card.comments.create!(creator: @user2, body: "Second comment")
+    assert_not @card.bursted?
+
+    @card.comments.create!(creator: @user1, body: "Third comment")
+    assert @card.bursted?
+  end
+
+  test "card does not get burst when 3 comments are from only one person" do
+    freeze_time
+    3.times do |i|
+      @card.comments.create!(creator: @user1, body: "Comment #{i}")
+    end
+
+    assert_not @card.bursted?
+  end
+
+  test "card does not get burst when comments are spread beyond 1/3 auto-close period" do
+    period = @card.board.auto_postpone_period
+    window = period / 3.0
+
+    @card.comments.create!(creator: @user1, body: "First comment", created_at: (window + 2.days).ago)
+    @card.comments.create!(creator: @user2, body: "Second comment", created_at: (window + 1.day).ago)
+    @card.comments.create!(creator: @user1, body: "Third comment", created_at: Time.current)
+
+    assert_not @card.bursted?
+  end
+
+  test "system comments do not count toward burst" do
+    system_user = @card.account.system_user
+
+    @card.comments.create!(creator: @user1, body: "Comment 1")
+    @card.comments.create!(creator: @user2, body: "Comment 2")
+    @card.comments.create!(creator: system_user, body: "System comment")
+
+    assert_not @card.bursted?
+  end
+
+  test "card that had a burst and sees no activity for two weeks is stalled" do
+    @card.burst!
+    @card.update!(last_active_at: 2.weeks.ago)
+
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+    assert_includes Card.indexed_by("stalled"), @card
+  end
+
+  test "card is not stalled before two weeks of inactivity" do
+    @card.burst!
+    @card.update!(last_active_at: 13.days.ago)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card that never had a burst is not stalled even after two weeks" do
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed card is not stalled" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    @card.close
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "postponed card is not stalled" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    @card.postpone
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comment on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(creator: @user1, body: "Reviving this card")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "reaction on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.reactions.create!(reacter: @user1, content: "👍")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "touch_last_active_at on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.touch_last_active_at
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "reopening a stalled closed card resets stall and bursts" do
+    @card.burst!
+    @card.close
+    @card.update!(last_active_at: 3.weeks.ago)
+
+    @card.reopen
+
+    assert_not @card.reload.stalled?
+    assert @card.bursted?
+  end
+
+  test "stalled_days calculation" do
+    @card.burst!
+    @card.update!(last_active_at: 16.days.ago)
+
+    assert_equal 16, @card.stalled_days
+  end
+
+  test "Assignment.create directly triggers burst" do
+    assert_changes -> { @card.bursted? }, from: false, to: true do
+      @card.assignments.create!(assignee: @user2, assigner: @user1)
+    end
+  end
+
+  test "reopening an open card does not trigger burst" do
+    assert @card.open?
+    assert_no_changes -> { @card.bursted? } do
+      @card.reopen
+    end
+  end
+
+  test "title change on a stalled card resets it" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.update!(title: "Updated Title")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "triaging a stalled card resets it" do
+    column = columns(:writebook_in_progress)
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.triage_into(column)
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "assigning a user to a stalled card resets stall and sets new burst" do
+    @card.burst!
+    @card.update!(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.toggle_assignment(@user2)
+
+    assert_not @card.reload.stalled?
+    assert @card.bursted?
+  end
+
+  test "drafted card is not stalled" do
+    draft = boards(:writebook).cards.create!(title: "Draft", status: :drafted, creator: @user1)
+    draft.burst!
+    draft.update!(last_active_at: 3.weeks.ago)
+
+    assert_not draft.stalled?
+    assert_not_includes Card.stalled, draft
+  end
+
+  test "comments burst respects board level auto_postpone_period" do
+    board = boards(:writebook)
+    board.update!(auto_postpone_period_in_days: 30) # 1/3 is 10 days
+    card = board.cards.create!(title: "Custom Entropy Card", status: :published, creator: @user1)
+    card = Card.find(card.id)
+
+    card.comments.create!(creator: @user1, body: "Comment 1", created_at: 9.days.ago)
+    card.comments.create!(creator: @user2, body: "Comment 2", created_at: 8.days.ago)
+    card.comments.create!(creator: @user1, body: "Comment 3", created_at: Time.current)
+
+    assert card.bursted?
+  end
+
+  test "comments burst fails if outside board level auto_postpone_period third" do
+    board = boards(:writebook)
+    board.update!(auto_postpone_period_in_days: 30) # 1/3 is 10 days
+    card = board.cards.create!(title: "Custom Entropy Card 2", status: :published, creator: @user1)
+    card = Card.find(card.id)
+
+    card.comments.create!(creator: @user1, body: "Comment 1", created_at: 11.days.ago)
+    card.comments.create!(creator: @user2, body: "Comment 2", created_at: 8.days.ago)
+    card.comments.create!(creator: @user1, body: "Comment 3", created_at: Time.current)
+
+    assert_not card.bursted?
+end
+end
