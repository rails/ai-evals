diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..51ae86b
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,66 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :stalled, -> { active.where.not(bursted_at: nil).where(last_active_at: ..2.weeks.ago) }
+
+    before_update :reset_stall_on_activity, if: :will_save_change_to_last_active_at?
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+
+  def burst(at: Time.current)
+    self.bursted_at = at
+  end
+
+  def burst!(at: Time.current)
+    update!(bursted_at: at)
+  end
+
+  def reset_burst
+    self.bursted_at = nil
+  end
+
+  def reset_burst!
+    update!(bursted_at: nil)
+  end
+
+  def stalled?
+    active? && bursted? && last_active_at <= 2.weeks.ago
+  end
+
+  def stalled_days
+    return 0 unless stalled?
+
+    ((Time.current - last_active_at) / 1.day).to_i
+  end
+
+  def check_burst_from_comment(comment)
+    return if comment.creator&.system?
+
+    if comments_burst?(comment)
+      burst!(at: comment.created_at)
+    end
+  end
+
+  def comments_burst?(latest_comment = nil)
+    period = auto_postpone_period
+    return false unless period.present? && period > 0
+
+    window = (period / 3.0).seconds
+    end_time = latest_comment&.created_at || Time.current
+    start_time = end_time - window
+
+    recent = comments.by_user.where(created_at: start_time..end_time)
+    recent.count >= 3 && recent.select(:creator_id).distinct.count >= 2
+  end
+
+  private
+    def reset_stall_on_activity
+      if stalled? && last_active_at > 2.weeks.ago && !will_save_change_to_bursted_at?
+        self.bursted_at = nil
+      end
+    end
+end
