+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "magic_code puts code in subject for notifications" do
+    email = IdentityMailer.magic_code(email_address: "user@example.com", code: "XYZ789")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "user@example.com" ], email.to
+    assert_equal "XYZ789 is your Fizzy code", email.subject
+    assert_includes email.subject, "XYZ789"
+  end
+
+  test "magic_code has HTML and text parts with the code" do
+    email = IdentityMailer.magic_code(email_address: "user@example.com", code: "XYZ789")
+
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_includes email.html_part.body.encoded, "XYZ789"
+    assert_includes email.text_part.body.encoded, "XYZ789"
+  end
+
+  test "magic_code mentions 15 minute expiration" do
+    email = IdentityMailer.magic_code(email_address: "user@example.com", code: "XYZ789")
+
+    assert_includes email.text_part.body.encoded, "15 minutes"
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..a5856f2
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generate_code produces a 6-character code" do
+    code = MagicLink.generate_code
+    assert_equal 6, code.length
+    assert_match /\A[A-Z0-9]{6}\z/, code
+  end
+
+  test "generate_token and verify with valid code" do
+    email = "user@example.com"
+    code = MagicLink.generate_code
+    token = MagicLink.generate_token(email_address: email, code: code, purpose: :session)
+
+    payload = MagicLink.verify(token: token, code: code)
+    assert_not_nil payload
+    assert_equal email, payload["email_address"]
+    assert_equal code, payload["code"]
+    assert_equal "session", payload["purpose"]
+  end
+
+  test "verify is case-insensitive and strips whitespace" do
+    email = "user@example.com"
+    code = "ABC123"
+    token = MagicLink.generate_token(email_address: email, code: code, purpose: :session)
+
+    payload = MagicLink.verify(token: token, code: "  abc123  ")
+    assert_not_nil payload
+    assert_equal email, payload["email_address"]
+  end
+
+  test "verify returns nil with wrong code" do
+    email = "user@example.com"
+    code = "ABC123"
+    token = MagicLink.generate_token(email_address: email, code: code, purpose: :session)
+
+    assert_nil MagicLink.verify(token: token, code: "WRONG1")
+  end
+
+  test "verify returns nil with blank token or code" do
+    assert_nil MagicLink.verify(token: nil, code: "ABC123")
+    assert_nil MagicLink.verify(token: "", code: "ABC123")
+    assert_nil MagicLink.verify(token: "token", code: nil)
+    assert_nil MagicLink.verify(token: "token", code: "")
+  end
+
+  test "code works for fifteen minutes" do
+    email = "user@example.com"
+    code = "ABC123"
+    token = MagicLink.generate_token(email_address: email, code: code, purpose: :session)
+
+    travel 14.minutes do
+      assert_not_nil MagicLink.verify_token(token)
+    end
+
+    travel 16.minutes do
+      assert_nil MagicLink.verify_token(token)
+      assert_nil MagicLink.verify(token: token, code: code)
+    end
+  end
+
+  test "code is single use" do
+    with_memory_cache do
+      email = "user@example.com"
+      code = "ABC123"
+      token = MagicLink.generate_token(email_address: email, code: code, purpose: :session)
+
+      first_result = MagicLink.verify(token: token, code: code)
+      assert_not_nil first_result
+
+      second_result = MagicLink.verify(token: token, code: code)
+      assert_nil second_result
+    end
+  end
+
+  test "deliver_code sends email and returns token" do
+    assert_emails 1 do
+      token = MagicLink.deliver_code(email_address: "user@example.com", purpose: :session)
+      assert_not_nil token
+      payload = MagicLink.verify_token(token)
+      assert_equal "user@example.com", payload["email_address"]
+    end
+  end
+
+  private
+    def with_memory_cache
+      original_cache = Rails.cache
+      Rails.cache = ActiveSupport::Cache.lookup_store(:memory_store)
+      yield
+    ensure
+      Rails.cache = original_cache
+    end
+end
