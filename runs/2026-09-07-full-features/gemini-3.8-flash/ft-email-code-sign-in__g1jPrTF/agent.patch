@@ -0,0 +1,80 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    if pending_authentication.blank?
+      redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug)
+    else
+      @email_address = pending_authentication["email_address"]
+      @pending_authentication_token = pending_token
+    end
+  end
+
+  def create
+    if payload = MagicLink.verify(token: pending_token, code: email_code)
+      identity = Identity.find_or_create_by!(email_address: payload["email_address"])
+      start_new_session_for identity
+      cookies.delete(:pending_authentication_token)
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          if pending_authentication.present?
+            redirect_to new_join_magic_link_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "That code didn't work. Try again."
+          else
+            redirect_to join_path(code: @join_code.code, script_name: @join_code.account.slug), alert: "That code has expired. Try again."
+          end
+        end
+        format.json { render json: { message: "Invalid pending_authentication_token or code" }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def email_code
+      request.request_parameters[:code]
+    end
+
+    def join_code_string
+      request.path_parameters[:code]
+    end
+
+    def pending_token
+      cookies[:pending_authentication_token] || params[:pending_authentication_token]
+    end
+
+    def pending_authentication
+      @pending_authentication ||= MagicLink.verify_token(pending_token)
+    end
+
+    def set_join_code
+      @join_code ||= Account::JoinCode.find_by(code: join_code_string, account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+end
