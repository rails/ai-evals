+class IdentityMailer < ApplicationMailer
+  def magic_code(email = nil, c = nil, email_address: nil, code: nil)
+    @email_address = email || email_address
+    @code = c || code
+    mail to: @email_address, subject: "#{@code} is your Fizzy code", template_name: "magic_code"
+  end
+
+  alias_method :sign_in_code, :magic_code
+  alias_method :magic_link, :magic_code
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b7f4f98
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,52 @@
+class MagicLink
+  include ActiveModel::Model
+
+  EXPIRATION = 15.minutes
+  CODE_LENGTH = 6
+
+  attr_accessor :email_address, :code, :purpose, :join_code
+
+  def self.generate_code
+    SecureRandom.alphanumeric(CODE_LENGTH).upcase
+  end
+
+  def self.generate_token(email_address:, code:, purpose: nil, join_code: nil)
+    payload = {
+      "email_address" => email_address.to_s.strip.downcase,
+      "code" => code,
+      "purpose" => purpose&.to_s,
+      "join_code" => join_code&.to_s,
+      "jti" => SecureRandom.hex(16)
+    }.compact
+
+    Rails.application.message_verifier(:magic_link).generate(payload, expires_in: EXPIRATION)
+  end
+
+  def self.verify_token(token)
+    return nil if token.blank?
+
+    payload = Rails.application.message_verifier(:magic_link).verified(token)
+    return nil unless payload
+    return nil if payload["jti"].present? && Rails.cache.exist?("used_magic_link:#{payload["jti"]}")
+
+    payload
+  end
+
+  def self.verify(token:, code:)
+    return nil if token.blank? || code.blank?
+
+    if payload = verify_token(token)
+      if ActiveSupport::SecurityUtils.secure_compare(payload["code"], code.to_s.strip.upcase)
+        Rails.cache.write("used_magic_link:#{payload["jti"]}", true, expires_in: EXPIRATION) if payload["jti"].present?
+        payload
+      end
+    end
+  end
+
+  def self.deliver_code(email_address:, purpose: nil, join_code: nil)
+    code = generate_code
+    token = generate_token(email_address: email_address, code: code, purpose: purpose, join_code: join_code)
+    IdentityMailer.magic_code(email_address: email_address, code: code).deliver_later
+    token
+  end
+end
