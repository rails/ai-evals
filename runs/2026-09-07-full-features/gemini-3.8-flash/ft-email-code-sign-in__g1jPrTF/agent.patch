+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <%= form_with url: join_magic_link_path(code: @join_code.code, script_name: @join_code.account.slug), method: :post, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
