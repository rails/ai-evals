+
+  <div class="margin-block-start">
+    <%= link_to "Enter a different email", join_path(code: @join_code.code, script_name: @join_code.account.slug), class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
