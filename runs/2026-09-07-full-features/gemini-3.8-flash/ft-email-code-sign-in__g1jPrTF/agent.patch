+        <%= form.text_field :code, required: true, class: "input full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter code…" %>
+      </label>
+    </div>
+
+    <p>We sent a 6-character code to <strong><%= @email_address %></strong>. Enter it here to join.</p>
+
+    <button type="submit" id="log_in" class="btn btn--link center" data-form-target="submit">
