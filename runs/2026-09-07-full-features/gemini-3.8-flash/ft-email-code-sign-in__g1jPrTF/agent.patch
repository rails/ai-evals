+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    if pending_authentication.blank?
+      redirect_to new_signup_path
+    else
+      @email_address = pending_authentication["email_address"]
+      @pending_authentication_token = pending_token
+    end
+  end
+
+  def create
+    if payload = MagicLink.verify(token: pending_token, code: params[:code])
+      identity = Identity.find_or_create_by!(email_address: payload["email_address"])
+      start_new_session_for identity
+      cookies.delete(:pending_authentication_token)
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html do
+          if pending_authentication.present?
+            redirect_to new_signup_magic_link_path, alert: "That code didn't work. Try again."
+          else
+            redirect_to new_signup_path, alert: "That code has expired. Try again."
+          end
+        end
+        format.json { render json: { message: "Invalid pending_authentication_token or code" }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+
+    def pending_token
+      cookies[:pending_authentication_token] || params[:pending_authentication_token]
+    end
+
+    def pending_authentication
+      @pending_authentication ||= MagicLink.verify_token(pending_token)
+    end
+end
