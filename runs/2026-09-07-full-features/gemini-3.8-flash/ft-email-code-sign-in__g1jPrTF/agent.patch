+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+  end
+
+  test "end-to-end sign in by email code" do
+    identity = identities(:kevin)
+    email = identity.email_address
+
+    untenanted do
+      get new_session_path
+      assert_response :success
+
+      assert_emails 1 do
+        post session_path, params: { email_address: email }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name='code']"
+
+      mail = ActionMailer::Base.deliveries.last
+      code_match = mail.subject.match(/\A([A-Z0-9]{6}) is your Fizzy code\z/)
+      assert code_match, "Email subject should start with 6-character code"
+      code = code_match[1]
+
+      post session_magic_link_path, params: { code: code }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "end-to-end sign up by email code" do
+    email = "brandnew@example.com"
+
+    untenanted do
+      get new_signup_path
+      assert_response :success
+
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: email } }
+      end
+
+      assert_redirected_to new_signup_magic_link_path
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name='code']"
+
+      mail = ActionMailer::Base.deliveries.last
+      code_match = mail.subject.match(/\A([A-Z0-9]{6}) is your Fizzy code\z/)
+      assert code_match, "Email subject should start with 6-character code"
+      code = code_match[1]
+
+      post signup_magic_link_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+
+      follow_redirect!
+      assert_response :success
+
+      # Complete sign-up
+      post signup_completion_path, params: { signup: { full_name: "Brand New User" } }
+      assert_response :redirect
+      assert flash[:welcome_letter]
+    end
+  end
+
+  test "end-to-end join by email code" do
+    email = "joiner@example.com"
+
+    get join_path(code: @join_code.code, script_name: @account.slug)
+    assert_response :success
+
+    assert_emails 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: email }
+    end
+
+    assert_redirected_to new_join_magic_link_path(code: @join_code.code, script_name: @account.slug)
+    follow_redirect!
+    assert_response :success
+    assert_select "input[name='code']"
+
+    mail = ActionMailer::Base.deliveries.last
+    code_match = mail.subject.match(/\A([A-Z0-9]{6}) is your Fizzy code\z/)
+    assert code_match, "Email subject should start with 6-character code"
+    code = code_match[1]
+
+    post join_magic_link_path(code: @join_code.code, script_name: @account.slug), params: { code: code }
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+
+    identity = Identity.find_by!(email_address: email)
+    user = User.find_by!(account: @account, identity: identity)
+    assert_not user.setup?
+  end
+end
