+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    @email = "newmember@example.com"
+    @code = "JOIN12"
+    @token = MagicLink.generate_token(email_address: @email, code: @code, purpose: :join, join_code: @join_code.code)
+  end
+
+  test "new with pending token cookie renders code form" do
+    cookies[:pending_authentication_token] = @token
+    get new_join_magic_link_path(code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_select "form[action='#{join_magic_link_path(code: @join_code.code, script_name: @account.slug)}']"
+    assert_select "input[name='code']"
+  end
+
+  test "new without pending token redirects to join path" do
+    get new_join_magic_link_path(code: @join_code.code, script_name: @account.slug)
+
+    assert_redirected_to join_path(code: @join_code.code, script_name: @account.slug)
+  end
+
