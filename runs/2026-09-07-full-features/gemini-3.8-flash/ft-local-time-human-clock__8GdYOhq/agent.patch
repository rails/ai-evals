diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..a615437
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,176 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const WEEKDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
+const SHORT_WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
+const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
+const SHORT_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
+
+export function strftime(date, format) {
+  return format.replace(/%([a-zA-Z%]|-[a-zA-Z])/g, (match, token) => {
+    switch (token) {
+      case "A": return WEEKDAYS[date.getDay()]
+      case "a": return SHORT_WEEKDAYS[date.getDay()]
+      case "B": return MONTHS[date.getMonth()]
+      case "b":
+      case "h": return SHORT_MONTHS[date.getMonth()]
+      case "d": return String(date.getDate()).padStart(2, "0")
+      case "-d":
+      case "e": return String(date.getDate())
+      case "Y": return String(date.getFullYear())
+      case "y": return String(date.getFullYear()).slice(-2)
+      case "m": return String(date.getMonth() + 1).padStart(2, "0")
+      case "-m": return String(date.getMonth() + 1)
+      case "H": return String(date.getHours()).padStart(2, "0")
+      case "-H": return String(date.getHours())
+      case "I": return String(date.getHours() % 12 || 12).padStart(2, "0")
+      case "l":
+      case "-I": return String(date.getHours() % 12 || 12)
+      case "M": return String(date.getMinutes()).padStart(2, "0")
+      case "-M": return String(date.getMinutes())
+      case "S": return String(date.getSeconds()).padStart(2, "0")
+      case "-S": return String(date.getSeconds())
+      case "p": return date.getHours() >= 12 ? "PM" : "AM"
+      case "P": return date.getHours() >= 12 ? "pm" : "am"
+      case "%": return "%"
+      default: return match
+    }
+  })
+}
+
+export function formatTime(date) {
+  const hour = date.getHours() % 12 || 12
+  const minute = String(date.getMinutes()).padStart(2, "0")
+  const meridian = date.getHours() >= 12 ? "PM" : "AM"
+  return `${hour}:${minute} ${meridian}`
+}
+
+export function formatFullDate(date) {
+  return strftime(date, "%A, %B %-d, %Y at %l:%M %p")
+}
+
+export function formatRelativeTime(date, type = "time-or-date", now = new Date()) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    if (date > now) {
+      return "today"
+    } else {
+      return formatTime(date)
+    }
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else {
+    // days < -1
+    if (date.getFullYear() === now.getFullYear()) {
+      return strftime(date, "%b %-d")
+    } else {
+      return strftime(date, "%b %-d, %Y")
+    }
+  }
+}
+
+export function formatTimeAgo(date, now = new Date()) {
+  const diffSeconds = Math.round((now - date) / 1000)
+  const days = signedDifferenceInDays(now, date)
+
+  if (diffSeconds < 60 && diffSeconds >= -5) {
+    return "just now"
+  } else if (diffSeconds < 3600 && diffSeconds >= 60) {
+    const minutes = Math.floor(diffSeconds / 60)
+    return `${minutes} ${minutes === 1 ? "minute" : "minutes"} ago`
+  } else if (days === 0) {
+    const hours = Math.max(1, Math.floor(diffSeconds / 3600))
+    return `${hours} ${hours === 1 ? "hour" : "hours"} ago`
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days < -1 && Math.abs(days) < 30) {
+    return `${Math.abs(days)} days ago`
+  } else if (Math.abs(days) >= 30 && Math.abs(days) < 365) {
+    const months = Math.floor(Math.abs(days) / 30)
+    return `${months} ${months === 1 ? "month" : "months"} ago`
+  } else if (Math.abs(days) >= 365) {
+    const years = Math.floor(Math.abs(days) / 365)
+    return `${years} ${years === 1 ? "year" : "years"} ago`
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else {
+    return strftime(date, "%b %-d")
+  }
+}
+
+export function renderDate(element) {
+  const datetime = element.getAttribute("datetime")
+  if (!datetime) return
+
+  const date = new Date(datetime)
+  if (isNaN(date.getTime())) return
+
+  const format = element.getAttribute("format")
+  const type = element.getAttribute("type") || element.getAttribute("data-local") || "time"
+
+  let text
+
+  if (format) {
+    text = strftime(date, format)
+  } else if (type === "time-or-date" || type === "relative") {
+    text = formatRelativeTime(date, type)
+  } else if (type === "time-ago") {
+    text = formatTimeAgo(date)
+  } else if (type === "date") {
+    if (date.getFullYear() === (new Date()).getFullYear()) {
+      text = strftime(date, "%b %-d")
+    } else {
+      text = strftime(date, "%b %-d, %Y")
+    }
+  } else if (type === "time") {
+    text = formatTime(date)
+  } else {
+    text = formatRelativeTime(date, type)
+  }
+
+  element.textContent = text
+  if (!element.getAttribute("title")) {
+    element.setAttribute("title", formatFullDate(date))
+  }
+}
+
+export class LocalTimeElement extends HTMLElement {
+  static get observedAttributes() {
+    return ["datetime", "format", "type"]
+  }
+
+  connectedCallback() {
+    this.update()
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.update()
+    }
+  }
+
+  update() {
+    renderDate(this)
+  }
+}
+
+if (!customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
+
+export function updateAll() {
+  document.querySelectorAll("local-time").forEach(el => el.update?.())
+  document.querySelectorAll("time[data-local]").forEach(renderDate)
+}
+
+document.addEventListener("turbo:load", updateAll)
+document.addEventListener("turbo:render", updateAll)
+document.addEventListener("turbo:frame-render", updateAll)
+
+setInterval(updateAll, 60_000)
