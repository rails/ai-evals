new file mode 100644
index 0000000..a55dde0
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time with default format" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_time(time)
+
+    assert_match %r{<local-time datetime="2026-09-08T13:42:00Z" type="time" class="local-time-value"></local-time>}, rendered
+  end
+
+  test "local_time with custom format string" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_time(time, "%l:%M %p")
+
+    assert_match %r{<local-time datetime="2026-09-08T13:42:00Z" type="time" format="%l:%M %p" class="local-time-value"></local-time>}, rendered
+  end
+
+  test "local_time with format option and extra options" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_time(time, format: "%l:%M %p", class: "custom-class")
+
+    assert_match %r{datetime="2026-09-08T13:42:00Z"}, rendered
+    assert_match %r{format="%l:%M %p"}, rendered
+    assert_match %r{class="local-time-value custom-class"}, rendered
+  end
+
+  test "local_date with format string" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_date(time, "%b %-d")
+
+    assert_match %r{<local-time datetime="2026-09-08T13:42:00Z" type="date" format="%b %-d" class="local-time-value"></local-time>}, rendered
+  end
+
+  test "local_date with Date object" do
+    date = Date.new(2026, 9, 8)
+    rendered = local_date(date, "%A, %B %-d")
+
+    assert_match %r{type="date"}, rendered
+    assert_match %r{format="%A, %B %-d"}, rendered
+    assert_match %r{datetime="2026-09-08}, rendered
+  end
+
+  test "local_time_ago" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_time_ago(time)
+
+    assert_match %r{<local-time datetime="2026-09-08T13:42:00Z" type="time-ago" class="local-time-value"></local-time>}, rendered
+  end
+
+  test "local_relative_time" do
+    time = Time.utc(2026, 9, 8, 13, 42)
+    rendered = local_relative_time(time)
+
+    assert_match %r{<local-time datetime="2026-09-08T13:42:00Z" type="time-or-date" class="local-time-value"></local-time>}, rendered
+  end
+
+  test "returns nil for nil time" do
+    assert_nil local_time(nil)
+    assert_nil local_date(nil)
+    assert_nil local_time_ago(nil)
+    assert_nil local_relative_time(nil)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..964e7cd
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,130 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    Current.user = @user
+    sign_in_as(@user)
+  end
+
+  test "renders comment timestamps relative to viewer time" do
+    card = cards(:logo)
+
+    # In the browser, current time is:
+    browser_now_iso = page.evaluate_script("new Date().toISOString()")
+    browser_now = Time.iso8601(browser_now_iso)
+
+    # 1. Comment from today (e.g. 1 minute ago, guaranteed same calendar day)
+    comment_today = card.comments.create!(creator: @user, body: "Comment today", created_at: browser_now - 1.minute)
+
+    # 2. Comment from last night / yesterday
+    yesterday_time = (browser_now - 1.day).change(hour: 20)
+    comment_yesterday = card.comments.create!(creator: @user, body: "Comment yesterday", created_at: yesterday_time)
+
+    # 3. Comment from 5 days ago (earlier in the week)
+    five_days_ago = (browser_now - 5.days).change(hour: 12)
+    comment_earlier = card.comments.create!(creator: @user, body: "Comment 5 days ago", created_at: five_days_ago)
+
+    visit card_url(card)
+
+    # Comment from today should display the time (e.g. 1:42 PM)
+    within("#comment_#{comment_today.id}") do
+      assert_selector ".comment__permalink-title local-time", text: /\A\d{1,2}:\d{2}\s+(AM|PM)\z/
+    end
+
+    # Comment from last night should read "yesterday" (or capitalized by CSS "Yesterday")
+    within("#comment_#{comment_yesterday.id}") do
+      assert_selector ".comment__permalink-title local-time", text: /yesterday/i
+    end
+
+    # Comment from earlier in the week reads "5 days ago" or "Sep 12"
+    within("#comment_#{comment_earlier.id}") do
+      expected_date = five_days_ago.strftime("%b %-d")
+      assert_selector ".comment__permalink-title local-time", text: /(5 days ago|#{Regexp.escape(expected_date)})/i
+    end
+  end
+
+  test "renders auto-closing closure notice overnight and further out" do
+    card = cards(:logo)
+    card.update!(status: :published)
+
+    browser_now_iso = page.evaluate_script("new Date().toISOString()")
+    browser_now = Time.iso8601(browser_now_iso)
+
+    # Overnight: auto_clean_at is tomorrow (e.g. 1 day from now, overnight at 3 AM)
+    tomorrow_time = (browser_now + 1.day).change(hour: 3)
+    card.update_columns(last_active_at: tomorrow_time - card.auto_postpone_period)
+
+    visit card_url(card)
+    assert_selector "#closure_notice_card_#{card.id}", text: /Moves to “Not Now” tomorrow if there’s no activity\./
+
+    # Further out: auto_clean_at is in 3 days
+    in_three_days = (browser_now + 3.days).change(hour: 12)
+    card.update_columns(last_active_at: in_three_days - card.auto_postpone_period)
+
+    visit card_url(card)
+    assert_selector "#closure_notice_card_#{card.id}", text: /Moves to “Not Now” in 3 days if there’s no activity\./
+  end
+
+  test "javascript formatting functions match exact requirements" do
+    visit root_url
+
+    direct_result = page.evaluate_script(<<~JS)
+      import("initializers/local_time").then(mod => {
+        const now = new Date(2026, 8, 12, 15, 42, 0); // Sep 12, 2026 3:42 PM
+        const twoHoursAgo = new Date(2026, 8, 12, 13, 42, 0); // Sep 12, 2026 1:42 PM
+        const lastNight = new Date(2026, 8, 11, 23, 0, 0); // Sep 11, 2026 (yesterday)
+        const fiveDaysAgo = new Date(2026, 8, 7, 10, 0, 0); // Sep 7, 2026 (earlier in week)
+        const overnight = new Date(2026, 8, 13, 3, 0, 0); // Sep 13, 2026 (tomorrow)
+        const inThreeDays = new Date(2026, 8, 15, 12, 0, 0); // in 3 days
+
+        return {
+          twoHoursAgo: mod.formatRelativeTime(twoHoursAgo, "time-or-date", now),
+          lastNight: mod.formatRelativeTime(lastNight, "time-or-date", now),
+          earlierDate: mod.formatRelativeTime(fiveDaysAgo, "time-or-date", now),
+          earlierAgo: mod.formatTimeAgo(fiveDaysAgo, now),
+          overnight: mod.formatRelativeTime(overnight, "time-or-date", now),
+          inThreeDays: mod.formatRelativeTime(inThreeDays, "time-or-date", now),
+          format1: mod.strftime(twoHoursAgo, "%l:%M %p"),
+          format2: mod.strftime(twoHoursAgo, "%A, %B %-d"),
+          format3: mod.strftime(twoHoursAgo, "%b %d, %Y"),
+          format4: mod.strftime(twoHoursAgo, "%-m/%-d/%y, %l:%M %p")
+        };
+      })
+    JS
+
+    assert_equal "1:42 PM", direct_result["twoHoursAgo"]
+    assert_equal "yesterday", direct_result["lastNight"]
+    assert_equal "Sep 7", direct_result["earlierDate"]
+    assert_equal "5 days ago", direct_result["earlierAgo"]
+    assert_equal "tomorrow", direct_result["overnight"]
+    assert_equal "in 3 days", direct_result["inThreeDays"]
+    assert_equal "1:42 PM", direct_result["format1"]
+    assert_equal "Saturday, September 12", direct_result["format2"]
+    assert_equal "Sep 12, 2026", direct_result["format3"]
+    assert_equal "9/12/26, 1:42 PM", direct_result["format4"]
+  end
+
+  test "updates dynamically when datetime attribute changes" do
+    visit root_url
+
+    result = page.evaluate_script(<<~JS)
+      (() => {
+        const el = document.createElement("local-time");
+        el.setAttribute("type", "time-or-date");
+        el.setAttribute("datetime", "2026-09-12T13:42:00Z");
+        document.body.appendChild(el);
+        const text1 = el.textContent;
+
+        // Change datetime attribute dynamically
+        el.setAttribute("datetime", "2026-09-11T20:00:00Z");
+        const text2 = el.textContent;
+
+        el.remove();
+        return { text1, text2 };
+      })()
+    JS
+
+    assert_not_equal result["text1"], result["text2"]
+  end
+end
