diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..ee9a7b2 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,67 @@
 module TimeHelper
+  def local_time(time, *args)
+    options = args.extract_options!
+    format = args.first || options.delete(:format)
+    time = normalize_local_time(time)
+    return unless time
+
+    options[:datetime] = time.utc.iso8601
+    options[:type] ||= "time"
+    options[:format] = format if format
+    options[:class] = token_list("local-time-value", options[:class])
+
+    tag.send("local-time", **options)
+  end
+
+  def local_date(time, *args)
+    options = args.extract_options!
+    format = args.first || options.delete(:format)
+    time = normalize_local_time(time)
+    return unless time
+
+    options[:datetime] = time.utc.iso8601
+    options[:type] ||= "date"
+    options[:format] = format if format
+    options[:class] = token_list("local-time-value", options[:class])
+
+    tag.send("local-time", **options)
+  end
+
+  def local_time_ago(time, options = {})
+    time = normalize_local_time(time)
+    return unless time
+
+    options = options.dup
+    options[:datetime] = time.utc.iso8601
+    options[:type] ||= "time-ago"
+    options[:class] = token_list("local-time-value", options[:class])
+
+    tag.send("local-time", **options)
+  end
+
+  def local_relative_time(time, options = {})
+    time = normalize_local_time(time)
+    return unless time
+
+    options = options.dup
+    options[:datetime] = time.utc.iso8601
+    options[:type] ||= "time-or-date"
+    options[:class] = token_list("local-time-value", options[:class])
+
+    tag.send("local-time", **options)
+  end
+
+  private
+    def normalize_local_time(time)
+      case time
+      when nil
+        nil
+      when String
+        Time.zone.parse(time)
+      when Date
+        time.to_time
+      else
+        time
+      end
+    end
 end
