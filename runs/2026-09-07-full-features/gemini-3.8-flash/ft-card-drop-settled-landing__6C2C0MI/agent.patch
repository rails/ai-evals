diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..0c9a9d5
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,300 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = {
+    breakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.currentHoverColumn = null
+
+    this.boundDragstart = this.dragstart.bind(this)
+    this.boundDragover = this.dragover.bind(this)
+    this.boundDragenter = this.dragenter.bind(this)
+    this.boundDragleave = this.dragleave.bind(this)
+    this.boundDrop = this.drop.bind(this)
+    this.boundDragend = this.dragend.bind(this)
+    this.boundEnsureDraggable = this.#ensureDraggableCards.bind(this)
+
+    this.element.addEventListener("dragstart", this.boundDragstart)
+    this.element.addEventListener("dragover", this.boundDragover)
+    this.element.addEventListener("dragenter", this.boundDragenter)
+    this.element.addEventListener("dragleave", this.boundDragleave)
+    this.element.addEventListener("drop", this.boundDrop)
+    this.element.addEventListener("dragend", this.boundDragend)
+
+    document.addEventListener("turbo:frame-load", this.boundEnsureDraggable)
+    document.addEventListener("turbo:morph", this.boundEnsureDraggable)
+
+    this.#ensureDraggableCards()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.boundDragstart)
+    this.element.removeEventListener("dragover", this.boundDragover)
+    this.element.removeEventListener("dragenter", this.boundDragenter)
+    this.element.removeEventListener("dragleave", this.boundDragleave)
+    this.element.removeEventListener("drop", this.boundDrop)
+    this.element.removeEventListener("dragend", this.boundDragend)
+
+    document.removeEventListener("turbo:frame-load", this.boundEnsureDraggable)
+    document.removeEventListener("turbo:morph", this.boundEnsureDraggable)
+
+    this.#clearHover()
+    this.#clearDragged()
+  }
+
+  dragstart(event) {
+    if (!this.#isDragEnabled()) return
+    if (this.#shouldIgnore(event)) return
+
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  dragover(event) {
+    if (!this.draggedCard) return
+
+    const targetColumn = event.target.closest(".cards")
+    if (this.#isValidTarget(targetColumn)) {
+      event.preventDefault()
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      if (this.currentHoverColumn !== targetColumn) {
+        this.#clearHover()
+        this.currentHoverColumn = targetColumn
+        this.currentHoverColumn.classList.add("drag-and-drop__hover-container")
+      }
+    } else {
+      this.#clearHover()
+    }
+  }
+
+  dragenter(event) {
+    if (!this.draggedCard) return
+
+    const targetColumn = event.target.closest(".cards")
+    if (this.#isValidTarget(targetColumn)) {
+      event.preventDefault()
+      if (this.currentHoverColumn !== targetColumn) {
+        this.#clearHover()
+        this.currentHoverColumn = targetColumn
+        this.currentHoverColumn.classList.add("drag-and-drop__hover-container")
+      }
+    }
+  }
+
+  dragleave(event) {
+    if (!this.draggedCard) return
+
+    if (this.currentHoverColumn && (!event.relatedTarget || !this.currentHoverColumn.contains(event.relatedTarget))) {
+      this.#clearHover()
+    }
+  }
+
+  async drop(event) {
+    if (!this.draggedCard) return
+
+    const targetColumn = event.target.closest(".cards")
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.#clearHover()
+    this.#clearDragged()
+    this.draggedCard = null
+    this.sourceColumn = null
+
+    if (!targetColumn || targetColumn === sourceColumn || !this.#isValidColumn(targetColumn)) {
+      return
+    }
+
+    event.preventDefault()
+
+    // Instant DOM update: move card to target column respecting order
+    this.#insertCardIntoColumn(card, targetColumn)
+
+    // Update column counters
+    this.#updateColumnCounts(sourceColumn, targetColumn)
+
+    // Update card classes and stages
+    this.#updateCardClassesAndStages(card, targetColumn)
+
+    // Persist in background
+    await this.#saveCardMove(card, targetColumn)
+  }
+
+  dragend(event) {
+    this.#clearHover()
+    this.#clearDragged()
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  // Private
+
+  #isDragEnabled() {
+    return window.matchMedia(this.breakpointValue).matches
+  }
+
+  #shouldIgnore(event) {
+    return event.target.closest("button, input, textarea, select, dialog")
+  }
+
+  #isValidTarget(column) {
+    return column && column !== this.sourceColumn && this.#isValidColumn(column)
+  }
+
+  #isValidColumn(column) {
+    return column && this.element.contains(column) && column.classList.contains("cards")
+  }
+
+  #clearHover() {
+    if (this.currentHoverColumn) {
+      this.currentHoverColumn.classList.remove("drag-and-drop__hover-container")
+      this.currentHoverColumn = null
+    }
+  }
+
+  #clearDragged() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+    }
+  }
+
+  #insertCardIntoColumn(card, targetColumn) {
+    const existingCards = Array.from(targetColumn.querySelectorAll(".card")).filter(c => c !== card)
+
+    if (existingCards.length > 0) {
+      const isGolden = card.classList.contains("golden-effect")
+      if (isGolden) {
+        existingCards[0].before(card)
+      } else {
+        const goldenCards = existingCards.filter(c => c.classList.contains("golden-effect"))
+        if (goldenCards.length > 0) {
+          goldenCards[goldenCards.length - 1].after(card)
+        } else {
+          existingCards[0].before(card)
+        }
+      }
+    } else {
+      const retargetContainer = targetColumn.querySelector("[data-controller~='retarget-links']")
+      if (retargetContainer) {
+        retargetContainer.prepend(card)
+      } else {
+        const cardsList = targetColumn.querySelector(".cards__list")
+        if (cardsList) {
+          cardsList.prepend(card)
+        } else {
+          const container = targetColumn.querySelector(".cards__transition-container") || targetColumn
+          container.appendChild(card)
+        }
+      }
+    }
+  }
+
+  #updateColumnCounts(sourceColumn, targetColumn) {
+    const sourceCountEl = sourceColumn.querySelector(".cards__expander-count")
+    if (sourceCountEl) {
+      const count = parseInt(sourceCountEl.textContent, 10)
+      if (!isNaN(count) && count > 0) {
+        sourceCountEl.textContent = count - 1
+      }
+    }
+
+    const targetCountEl = targetColumn.querySelector(".cards__expander-count")
+    if (targetCountEl) {
+      const count = parseInt(targetCountEl.textContent, 10)
+      if (!isNaN(count)) {
+        targetCountEl.textContent = (count + 1) > 99 ? "99+" : (count + 1)
+      }
+    }
+  }
+
+  #getColumnType(column) {
+    if (column.dataset.columnType) return column.dataset.columnType
+    if (column.id === "not-now") return "not_now"
+    if (column.id === "maybe") return "stream"
+    if (column.id === "closed-cards") return "closed"
+    return "column"
+  }
+
+  #updateCardClassesAndStages(card, targetColumn) {
+    const columnType = this.#getColumnType(targetColumn)
+
+    if (columnType === "not_now") {
+      card.classList.remove("card--active")
+      card.classList.add("card--postponed")
+    } else if (columnType === "closed") {
+      card.classList.remove("card--active")
+      card.classList.remove("card--postponed")
+    } else {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    }
+
+    const stages = card.querySelectorAll(".card__stages .card__column-name")
+    stages.forEach(stage => stage.classList.remove("card__column-name--current"))
+
+    if (columnType === "column") {
+      const columnName = targetColumn.dataset.columnName || targetColumn.getAttribute("data-column-name")
+      if (columnName) {
+        const matchingStage = Array.from(stages).find(s => s.textContent.trim() === columnName.trim())
+        if (matchingStage) {
+          matchingStage.classList.add("card__column-name--current")
+        }
+      }
+    }
+  }
+
+  async #saveCardMove(card, targetColumn) {
+    const columnType = this.#getColumnType(targetColumn)
+
+    try {
+      let response
+      if (columnType === "not_now") {
+        response = await post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+      } else if (columnType === "closed") {
+        response = await post(card.dataset.cardClosureUrl, { responseKind: "json" })
+      } else if (columnType === "stream") {
+        response = await destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+      } else if (columnType === "column") {
+        const columnId = targetColumn.dataset.columnId
+        response = await post(card.dataset.cardTriageUrl, {
+          body: { column_id: columnId },
+          responseKind: "json"
+        })
+      }
+
+      if (!response || !response.ok) {
+        console.error("Failed to move card", response)
+        window.location.reload()
+      }
+    } catch (error) {
+      console.error("Error moving card", error)
+      window.location.reload()
+    }
+  }
+
+  #ensureDraggableCards() {
+    this.element.querySelectorAll(".card").forEach(card => {
+      if (!card.hasAttribute("draggable")) {
+        card.setAttribute("draggable", "true")
+      }
+    })
+  }
+}
