diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..1b7d3bb
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,270 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  setup do
+    @user = users(:david)
+    sign_in_as(@user)
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card from stream to another column updates the column immediately and persists" do
+    card = cards(:buy_domain) # In stream / maybe
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+
+    assert_selector "#maybe article##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(target_column)}"
+
+    # Simulate drag start
+    page.execute_script(<<~JS)
+      window.testDataTransfer = new DataTransfer();
+      const card = document.querySelector('#maybe article##{dom_id(card, :article)}');
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }));
+    JS
+
+    # Check dragged card dims
+    assert_selector "article##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    # Simulate drag over target column
+    page.execute_script(<<~JS)
+      const col = document.querySelector('##{dom_id(target_column)}');
+      col.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }));
+    JS
+
+    # Check column lights up
+    assert_selector "##{dom_id(target_column)}.drag-and-drop__hover-container"
+
+    # Simulate drop
+    page.execute_script(<<~JS)
+      const col = document.querySelector('##{dom_id(target_column)}');
+      col.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }));
+      const card = document.querySelector('article##{dom_id(card, :article)}');
+      card.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: window.testDataTransfer }));
+    JS
+
+    # Immediately on drop:
+    # Card is inside target column (using visible: :all in case column is collapsed)
+    assert_selector "##{dom_id(target_column)} article##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe article##{dom_id(card, :article)}", visible: :all
+
+    # Classes removed
+    assert_no_selector "article##{dom_id(card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_no_selector "##{dom_id(target_column)}.drag-and-drop__hover-container"
+
+    # Wait for background save to finish
+    sleep 0.5
+
+    assert_equal target_column.id, card.reload.column_id
+  end
+
+  test "dragging a card within the same column does nothing" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+
+    page.execute_script(<<~JS)
+      const dt = new DataTransfer();
+      const card = document.querySelector('#maybe article##{dom_id(card, :article)}');
+      const col = document.querySelector('#maybe');
+
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      col.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    # Source column should NOT light up
+    assert_no_selector "#maybe.drag-and-drop__hover-container"
+
+    page.execute_script(<<~JS)
+      const dt = new DataTransfer();
+      const card = document.querySelector('#maybe article##{dom_id(card, :article)}');
+      const col = document.querySelector('#maybe');
+
+      col.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      card.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    assert_selector "#maybe article##{dom_id(card, :article)}"
+    assert_nil card.reload.column_id
+  end
+
+  test "dragging a card to Done closes the card" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+
+    page.execute_script(<<~JS)
+      const dt = new DataTransfer();
+      const card = document.querySelector('#maybe article##{dom_id(card, :article)}');
+      const doneCol = document.querySelector('#closed-cards');
+
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      doneCol.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      doneCol.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      card.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    assert_selector "#closed-cards article##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe article##{dom_id(card, :article)}", visible: :all
+
+    sleep 0.5
+    assert card.reload.closed?
+  end
+
+  test "dragging a card to Not Now postpones the card" do
+    card = cards(:buy_domain)
+
+    visit board_url(@board)
+
+    page.execute_script(<<~JS)
+      const dt = new DataTransfer();
+      const card = document.querySelector('#maybe article##{dom_id(card, :article)}');
+      const notNowCol = document.querySelector('#not-now');
+
+      card.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      notNowCol.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      notNowCol.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: dt }));
+      card.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: dt }));
+    JS
+
+    assert_selector "#not-now article##{dom_id(card, :article)}", visible: :all
