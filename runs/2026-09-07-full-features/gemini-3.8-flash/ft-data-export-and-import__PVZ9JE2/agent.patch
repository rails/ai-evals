diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..d48fcb6
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,51 @@
+class ZipFile::Reader
+  attr_reader :io, :entries
+
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def glob(pattern)
+    @entries.select { |e| File.fnmatch(pattern, e.filename) }
+  end
+
+  def find_entry(path)
+    @entries.find { |e| e.filename == path }
+  end
+
+  def exists?(path)
+    find_entry(path).present?
+  end
+
+  def read(path_or_entry)
+    entry = path_or_entry.is_a?(String) ? find_entry(path_or_entry) : path_or_entry
+    return nil unless entry
+
+    extractor = entry.extractor_from(@io)
+    content = String.new(encoding: Encoding::BINARY, capacity: entry.uncompressed_size)
+    content << extractor.extract(64.kilobytes) until extractor.eof?
+    content
+  end
+
+  def open_entry(path_or_entry)
+    entry = path_or_entry.is_a?(String) ? find_entry(path_or_entry) : path_or_entry
+    return nil unless entry
+
+    tempfile = Tempfile.new([ "zip-entry", File.extname(entry.filename) ], binmode: true)
+    extractor = entry.extractor_from(@io)
+    tempfile.write(extractor.extract(64.kilobytes)) until extractor.eof?
+    tempfile.rewind
+
+    if block_given?
+      begin
+        yield tempfile
+      ensure
+        tempfile.close
+        tempfile.unlink
+      end
+    else
+      tempfile
+    end
+  end
+end
