@@ -0,0 +1,41 @@
+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @export = @account.exports.create!(user: @user, scope: "cards")
+    @export.file.attach(
+      io: StringIO.new("fake zip data"),
+      filename: "david-cards.zip",
+      content_type: "application/zip"
+    )
+  end
+
+  test "download with valid signed id within 1 day" do
+    signed_id = @export.signed_id(purpose: :download, expires_in: 1.day)
+
+    get export_url(signed_id)
+
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+    assert_includes response.headers["Content-Disposition"], "david-cards.zip"
+  end
+
+  test "download with expired link fails" do
+    travel 2.days do
+      signed_id = @export.signed_id(purpose: :download, expires_in: 1.day)
+      travel 2.days
+
+      get export_url(signed_id)
+
+      assert_response :not_found
+    end
+  end
+
+  test "download with invalid token fails" do
+    get export_url("invalid_token")
+
+    assert_response :not_found
+  end
+end
