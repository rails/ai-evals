+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @admin = users(:kevin)
+  end
+
+  test "generate account export creates zip and sends email" do
+    export = @account.exports.create!(user: @admin, scope: "account")
+
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+      export.generate_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+    assert_equal "#{@account.name.parameterize}-export.zip", export.file.filename.to_s
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("accounts/#{@account.id}.json")
+      assert zip.exists?("users/#{@admin.id}.json")
+    end
+  end
+
+  test "generate cards export creates zip with cards, comments, attachments and sends email" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("fake card image"), filename: "logo.png", content_type: "image/png")
+    comment = card.comments.create!(creator: @user, body: "Great logo!")
+
+    export = @account.exports.create!(user: @user, scope: "cards")
+
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+      export.generate_now
+    end
+
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("cards.json")
+      assert zip.exists?("cards/#{card.number}.json")
+      assert zip.exists?("cards/#{card.number}/logo.png")
+
+      cards_json = JSON.parse(zip.read("cards.json"))
+      card_data = cards_json.find { |c| c["id"] == card.id }
+      assert_not_nil card_data
+      assert_equal card.title, card_data["title"]
+      assert_equal 1, card_data["attachments"].size
+      assert_equal "cards/#{card.number}/logo.png", card_data["attachments"].first["path"]
+
+      assert_includes card_data["comments"].map { |c| c["body"]["plain_text"].strip }, "Great logo!"
+    end
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..a77b513
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+    @identity = identities(:jason)
+  end
+
+  test "import creates new account with everything in it and sends email" do
+    export = @account.exports.create!(user: @user, scope: "account")
+    export.generate_now
+
+    new_identity = Identity.create!(email_address: "newimporter@example.com")
+    new_account = Account.create!(name: "Temporary")
+
+    import = nil
+    Current.with_account(new_account) do
+      import = new_account.imports.create!(identity: new_identity)
+      import.file.attach(
+        io: StringIO.new(export.file.download),
+        filename: "account.zip",
+        content_type: "application/zip"
+      )
+    end
+
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+      import.process
+    end
+
+    assert_equal "completed", import.status
+    assert_not_equal @account.id, new_account.id
+    assert_equal @account.name, new_account.reload.name
+
+    # Check imported data
+    assert new_account.boards.exists?
+    assert new_account.cards.exists?
+    assert new_account.users.exists?(identity: new_identity)
+
+    # Clean up
+    new_account.incinerate
+    export.destroy
+  end
+
+  test "failed import leaves nothing behind and sends email with reason" do
+    new_identity = Identity.create!(email_address: "failuretest@example.com")
+    new_account = Account.create!(name: "Doomed")
+
+    import = nil
+    Current.with_account(new_account) do
+      import = new_account.imports.create!(identity: new_identity)
+      import.file.attach(
+        io: StringIO.new("not a real zip file"),
+        filename: "bad.zip",
+        content_type: "application/zip"
+      )
+    end
+
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob) do
+      import.process
+    end
+
+    # Leaves nothing behind: new_account should be incinerated/destroyed
+    assert_not Account.exists?(new_account.id)
+  end
+end
