new file mode 100644
index 0000000..7d5914e
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,65 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+
+  def process
+    update!(status: "processing")
+
+    ZipFile.open(file) do |zip|
+      id_map = {}
+      manifest = Account::DataTransfer::Manifest.new(account, id_map: id_map)
+      manifest.each_record_set do |record_set|
+        record_set.import(zip)
+      end
+    end
+
+    ensure_importer_access
+    reindex_search
+
+    file.purge if file.attached?
+
+    update!(status: "completed")
+    AccountMailer.import_completed(account, identity).deliver_later
+  rescue => e
+    account_to_destroy = account
+    update_columns(status: "failed", error_message: e.message)
+    AccountMailer.import_failed(identity, e.message).deliver_later
+
+    if account_to_destroy
+      account_to_destroy.incinerate rescue nil
+    end
+
+    Rails.logger.error("Import failed: #{e.message}\n#{e.backtrace.join("\n")}")
+  end
+
+  private
+    def ensure_importer_access
+      existing_user = account.users.find_by(identity: identity)
+      if existing_user
+        existing_user.update!(role: :owner) unless existing_user.owner?
+      else
+        user = account.users.create!(
+          identity: identity,
+          name: identity.email_address.split("@").first.humanize,
+          role: :owner,
+          verified_at: Time.current
+        )
+        account.boards.each do |board|
+          board.accesses.find_or_create_by!(user: user)
+        end
+      end
+    end
+
+    def reindex_search
+      account.cards.find_each(&:reindex)
+      Comment.where(account_id: account.id).find_each(&:reindex)
+    end
+end
