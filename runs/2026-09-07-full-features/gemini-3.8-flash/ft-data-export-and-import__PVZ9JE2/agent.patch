diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..49de5f9
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,190 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :scope, %w[ account cards ].index_by(&:itself), default: "account"
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: "pending"
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate_now
+    update!(status: "processing")
+
+    case scope
+    when "account"
+      generate_account_export
+    when "cards"
+      generate_cards_export
+    end
+
+    update!(status: "completed")
+    ExportMailer.ready(self).deliver_later
+  rescue => e
+    update!(status: "failed")
+    Rails.logger.error("Export failed: #{e.message}\n#{e.backtrace.join("\n")}")
+    raise e
+  end
+
+  def filename
+    case scope
+    when "account"
+      "#{account.name.parameterize}-export.zip"
+    when "cards"
+      "#{user.name.parameterize}-cards.zip"
+    end
+  end
+
+  def description
+    case scope
+    when "account"
+      account.name
+    when "cards"
+      "cards"
+    end
+  end
+
+  private
+    def generate_account_export
+      ZipFile.create_for(file, filename: filename) do |zip|
+        manifest = Account::DataTransfer::Manifest.new(account)
+        manifest.each_record_set do |record_set|
+          record_set.export(zip)
+        end
+      end
+    end
+
+    def generate_cards_export
+      cards = user.accessible_cards.published.includes(
+        :board, :column, :tags, :steps,
+        image_attachment: :blob,
+        comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ]
+      )
+
+      ZipFile.create_for(file, filename: filename) do |zip|
+        all_cards_data = []
+
+        cards.each do |card|
+          card_data = card_export_data(card, zip)
+          all_cards_data << card_data
+
+          zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_data))
+        end
+
+        zip.add_file("cards.json", JSON.pretty_generate(all_cards_data))
+      end
+    end
+
+    def card_export_data(card, zip)
+      attachments_data = []
+
+      # Card cover image
+      if card.image.attached? && card.image.blob.present?
+        blob = card.image.blob
+        path = "cards/#{card.number}/#{blob.filename}"
+        attachments_data << {
+          filename: blob.filename.to_s,
+          byte_size: blob.byte_size,
+          content_type: blob.content_type,
+          path: path
+        }
+        zip.add_file(path) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end unless zip.exists?(path)
+      end
+
+      # Card embeds
+      if card.description.present?
+        card.description.embeds.each do |embed|
+          if embed.is_a?(ActiveStorage::Attachment) && embed.blob.present?
+            blob = embed.blob
+            path = "cards/#{card.number}/#{blob.filename}"
+            attachments_data << {
+              filename: blob.filename.to_s,
+              byte_size: blob.byte_size,
+              content_type: blob.content_type,
+              path: path
+            }
+            zip.add_file(path) do |sink|
+              blob.download { |chunk| sink.write(chunk) }
+            end unless zip.exists?(path)
+          end
+        end
+      end
+
+      comments_data = card.comments.chronologically.map do |comment|
+        comment_attachments = []
+        if comment.body.present?
+          comment.body.embeds.each do |embed|
+            if embed.is_a?(ActiveStorage::Attachment) && embed.blob.present?
+              blob = embed.blob
+              path = "cards/#{card.number}/comments/#{comment.id}/#{blob.filename}"
+              comment_attachments << {
+                filename: blob.filename.to_s,
+                byte_size: blob.byte_size,
+                content_type: blob.content_type,
+                path: path
+              }
+              zip.add_file(path) do |sink|
+                blob.download { |chunk| sink.write(chunk) }
+              end unless zip.exists?(path)
+            end
+          end
+        end
+
+        {
+          id: comment.id,
+          created_at: comment.created_at,
+          updated_at: comment.updated_at,
+          body: {
+            plain_text: comment.body&.to_plain_text,
+            html: comment.body&.to_s
+          },
+          creator: {
+            id: comment.creator.id,
+            name: comment.creator.name,
+            email_address: comment.creator.identity&.email_address
+          },
+          attachments: comment_attachments
+        }
+      end
+
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        board: {
+          id: card.board.id,
+          name: card.board.name
+        },
+        column: card.column ? {
+          id: card.column.id,
+          name: card.column.name
+        } : nil,
+        creator: {
+          id: card.creator.id,
+          name: card.creator.name,
+          email_address: card.creator.identity&.email_address
+        },
+        assignees: card.assignees.map { |u| { id: u.id, name: u.name, email_address: u.identity&.email_address } },
+        tags: card.tags.pluck(:title).sort,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        description: {
+          plain_text: card.description&.to_plain_text,
+          html: card.description&.to_s
+        },
+        steps: card.steps.map { |step| { id: step.id, content: step.content, completed: step.completed? } },
+        comments: comments_data,
+        attachments: attachments_data
+      }
+    end
+end
