diff --git a/test/integration/data_transfer_test.rb b/test/integration/data_transfer_test.rb
new file mode 100644
index 0000000..a706821
--- /dev/null
+++ b/test/integration/data_transfer_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class DataTransferTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @member = users(:david)
+  end
+
+  test "admin exports account from settings, receives email with 1-day link, downloads zip" do
+    sign_in_as @admin
+
+    get account_settings_path
+    assert_response :success
+    assert_select "button", text: "Export whole account"
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with(job: ExportJob) do
+        post account_exports_path
+      end
+    end
+
+    export = Export.last
+    assert_equal "account", export.scope
+    assert_redirected_to account_settings_path
+
+    # Perform the export job
+    perform_enqueued_jobs(only: ExportJob)
+
+    export.reload
+    assert_equal "completed", export.status
+    assert export.file.attached?
+
+    # Verify email was enqueued
+    delivery_job = enqueued_jobs.find { |j| j[:job] == ActionMailer::MailDeliveryJob }
+    assert delivery_job
+
+    # Test download link
+    signed_id = export.signed_id(purpose: :download, expires_in: 1.day)
+    get export_path(signed_id)
+    assert_response :success
+    assert_equal "application/zip", response.media_type
+  end
+
+  test "member cannot export account from settings" do
+    sign_in_as @member
+
+    get account_settings_path
+    assert_response :success
+    assert_select "button", text: "Export whole account", count: 0
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+    assert_response :forbidden
+  end
+
+  test "user exports their cards from profile, receives email, downloads zip with cards, comments, attachments" do
+    sign_in_as @member
+
+    # Add an attachment and a comment to a card accessible to member
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("test logo content"), filename: "logo.png", content_type: "image/png")
+    card.comments.create!(creator: @member, body: "Looking sharp!")
+
+    get user_path(@member)
+    assert_response :success
+    assert_select "button", text: "Export my cards"
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with(job: ExportJob) do
+        post user_exports_path(@member)
+      end
+    end
+
+    export = Export.last
+    assert_equal "cards", export.scope
+
+    perform_enqueued_jobs(only: ExportJob)
+
+    export.reload
+    assert_equal "completed", export.status
+
+    # Inspect zip contents
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("cards.json")
+      assert zip.exists?("cards/#{card.number}.json")
+      assert zip.exists?("cards/#{card.number}/logo.png")
+
+      cards_data = JSON.parse(zip.read("cards.json"))
+      card_json = cards_data.find { |c| c["id"] == card.id }
+      assert_not_nil card_json
+      assert_equal card.title, card_json["title"]
+      assert_includes card_json["comments"].map { |c| c["body"]["plain_text"].strip }, "Looking sharp!"
+    end
+  end
+
+  test "user cannot export another user's cards" do
+    sign_in_as @member
+
+    get user_path(@admin)
+    assert_response :success
+    assert_select "button", text: "Export my cards", count: 0
+
+    assert_no_difference -> { Export.count } do
+      post user_exports_path(@admin)
+    end
+    assert_response :forbidden
+  end
+
+  test "signed in user brings account file back in at /account/imports/new, gets new account with everything" do
+    # First generate a real account export
+    sign_in_as @admin
+    post account_exports_path
+    perform_enqueued_jobs(only: ExportJob)
+    export = Export.last
+
+    # Now sign in as a user on another account
+    new_user = users(:mike)
+    logout_and_sign_in_as new_user
+
+    get new_account_import_path(script_name: nil)
+    assert_response :success
+
+    temp = Tempfile.new([ "import", ".zip" ])
+    temp.binmode
+    temp.write(export.file.download)
+    temp.rewind
+
+    file = Rack::Test::UploadedFile.new(temp.path, "application/zip", original_filename: "export.zip")
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_with(job: ImportJob) do
+        post account_imports_path(script_name: nil), params: { file: file }
+      end
+    end
+
+    imported_account = Account.order(:created_at).last
+    perform_enqueued_jobs(only: ImportJob)
+
+    imported_account.reload
+    assert_equal @account.name, imported_account.name
+    assert imported_account.boards.exists?
+    assert imported_account.cards.exists?
+    assert imported_account.users.exists?(identity: new_user.identity)
+
+    # Cleanup
+    imported_account.incinerate
+    export.destroy
+  ensure
+    temp&.close
+    temp&.unlink
+  end
+
+  test "failed import leaves nothing behind" do
+    sign_in_as @member
+
+    temp = Tempfile.new([ "bad", ".zip" ])
+    temp.write("not valid zip")
+    temp.rewind
+    file = Rack::Test::UploadedFile.new(temp.path, "application/zip", original_filename: "bad.zip")
+
+    initial_accounts_count = Account.count
+
+    post account_imports_path(script_name: nil), params: { file: file }
+
+    # Perform the job, which should fail and incinerate the new account
+    perform_enqueued_jobs(only: ImportJob)
+
+    # Leaves nothing behind: no new account exists
+    assert_equal initial_accounts_count, Account.count
+  ensure
+    temp&.close
+    temp&.unlink
+  end
+end
