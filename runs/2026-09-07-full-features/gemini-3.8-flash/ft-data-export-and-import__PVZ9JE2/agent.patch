diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
new file mode 100644
index 0000000..b6c21b1
--- /dev/null
+++ b/app/controllers/account/imports_controller.rb
@@ -0,0 +1,28 @@
+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account
+
+  layout -> { Current.account ? "application" : "public" }
+
+  def new
+  end
+
+  def create
+    if params[:file].blank?
+      redirect_to new_account_import_path, alert: "Please choose a file to import."
+      return
+    end
+
+    account = Account.create!(name: "Importing...")
+    Current.with_account(account) do
+      import = account.imports.create!(identity: Current.identity)
+      import.file.attach(params[:file])
+      import.process_later
+    end
+
+    redirect_to main_app.session_menu_path(script_name: nil),
+      notice: "Your import has started. We'll email you at #{Current.identity.email_address} when it's ready."
+  rescue => e
+    account&.incinerate rescue nil
+    redirect_to new_account_import_path, alert: "Failed to start import: #{e.message}"
+  end
+end
diff --git a/app/controllers/exports_controller.rb b/app/controllers/exports_controller.rb
new file mode 100644
index 0000000..e751da7
--- /dev/null
+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,36 @@
+class ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+  skip_before_action :require_account, only: :show
+
+  def show
+    if @export = Export.find_signed(params[:id], purpose: :download)
+      if @export.file.attached?
+        send_file_or_data
+      else
+        render plain: "Export file not found.", status: :not_found
+      end
+    else
+      render plain: "This download link is invalid or has expired.", status: :not_found
+    end
+  end
+
+  private
+    def send_file_or_data
+      blob = @export.file.blob
+      service = blob.service
+
+      if defined?(ActiveStorage::Service::S3Service) && service.is_a?(ActiveStorage::Service::S3Service)
+        redirect_to blob.url(disposition: :attachment, expires_in: 1.day), allow_other_host: true
+      elsif service.respond_to?(:path_for)
+        send_file service.path_for(blob.key),
+          filename: @export.filename,
+          type: "application/zip",
+          disposition: "attachment"
+      else
+        send_data blob.download,
+          filename: @export.filename,
+          type: "application/zip",
+          disposition: "attachment"
+      end
+    end
+end
