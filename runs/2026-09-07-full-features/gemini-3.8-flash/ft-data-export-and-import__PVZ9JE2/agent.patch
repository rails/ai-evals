+    def transform_attributes_for_import(data)
+      attrs = data.slice(*attributes)
+
+      old_id = data["id"]
+      if old_id.present?
+        if model.exists?(id: old_id)
+          new_id = ActiveRecord::Type::Uuid.generate
+          id_map[old_id] = new_id
+          attrs["id"] = new_id
+        else
+          id_map[old_id] = old_id
+          attrs["id"] = old_id
+        end
+      end
+
+      if model.column_names.include?("account_id")
+        attrs["account_id"] = account.id
+      end
+
+      remap_foreign_keys(attrs)
+
+      attrs
+    end
+
+    def remap_foreign_keys(attrs)
+      attrs.each do |key, val|
+        next if key == "id" || key == "account_id"
+        if key.end_with?("_id") && val.present? && id_map[val]
+          attrs[key] = id_map[val]
+        end
+      end
+    end
 end
