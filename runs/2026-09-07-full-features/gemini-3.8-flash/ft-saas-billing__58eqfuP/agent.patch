@@ -0,0 +1,30 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">All Accounts</h2>
+    </header>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
+        <li class="flex align-start gap-half margin-block-start-half">
+          <div class="flex-item-grow min-width overflow-ellipsis" style="text-align: left">
+            <%= link_to account.name, admin_account_path(account), class: "txt-ink font-weight-bold" %>
