+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    customer_id = Current.account.subscription&.stripe_customer_id
+    if customer_id.blank?
+      redirect_to account_settings_path, alert: "No active subscription found."
+      return
+    end
+
+    session = Stripe::BillingPortal::Session.create(
+      customer: customer_id,
+      return_url: account_settings_url(script_name: Current.account.slug)
+    )
+
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError, Faraday::Error, SocketError => e
+    Rails.logger.error("Stripe portal error: #{e.message}")
+    redirect_to account_settings_path, alert: "Unable to open billing portal at this time."
+  end
+
+  def show
+    create
+  end
+end
