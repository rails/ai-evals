diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..660cb8d
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,125 @@
+class Stripe::WebhooksController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  skip_forgery_protection
+
+  def create
+    payload = request.raw_post
+    sig_header = request.headers["Stripe-Signature"]
+    endpoint_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+    event = begin
+      if endpoint_secret.present? && sig_header.present?
+        Stripe::Webhook.construct_event(payload, sig_header, endpoint_secret)
+      else
+        data = JSON.parse(payload, symbolize_names: true)
+        Stripe::Event.construct_from(data)
+      end
+    rescue JSON::ParserError, Stripe::SignatureVerificationError => e
+      head :bad_request
+      return
+    end
+
+    process_event(event)
+
+    head :ok
+  end
+
+  private
+    def process_event(event)
+      case event.type
+      when "checkout.session.completed"
+        handle_checkout_completed(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        handle_subscription_updated(event.data.object)
+      when "customer.subscription.deleted"
+        handle_subscription_deleted(event.data.object)
+      when "invoice.payment_succeeded", "invoice.created"
+        handle_invoice(event.data.object)
+      end
+    end
+
+    def handle_checkout_completed(session)
+      customer_id = session.customer
+      subscription_id = session.subscription
+      account_id = session.metadata&.[](:account_id) || session.metadata&.[]("account_id")
+      external_id = session.client_reference_id
+
+      account = Account.find_by(id: account_id) if account_id.present?
+      account ||= Account.find_by(external_account_id: external_id) if external_id.present?
+      account ||= Account::Subscription.find_by(stripe_customer_id: customer_id)&.account if customer_id.present?
+
+      if account
+        sub = account.subscription || account.build_subscription
+        sub.stripe_customer_id = customer_id if customer_id.present?
+        sub.stripe_subscription_id = subscription_id if subscription_id.present?
+        plan_key = session.metadata&.[](:plan_key) || session.metadata&.[]("plan_key")
+        sub.plan_key = plan_key if plan_key.present?
+        sub.status ||= "active"
+        sub.save!
+      end
+    end
+
+    def handle_subscription_updated(stripe_sub)
+      subscription_id = stripe_sub.id
+      customer_id = stripe_sub.customer
+      status = stripe_sub.status
+
+      sub = Account::Subscription.find_by(stripe_subscription_id: subscription_id)
+      sub ||= Account::Subscription.find_by(stripe_customer_id: customer_id)
+
+      unless sub
+        account_id = stripe_sub.metadata&.[](:account_id) || stripe_sub.metadata&.[]("account_id")
+        external_id = stripe_sub.metadata&.[](:external_account_id) || stripe_sub.metadata&.[]("external_account_id")
+        account = Account.find_by(id: account_id) if account_id.present?
+        account ||= Account.find_by(external_account_id: external_id) if external_id.present?
+        sub = account.subscription || account.build_subscription if account
+      end
+
+      if sub
+        sub.stripe_customer_id = customer_id if customer_id.present?
+        sub.stripe_subscription_id = subscription_id
+        sub.status = status
+        sub.current_period_end = Time.at(stripe_sub.current_period_end) if stripe_sub.respond_to?(:current_period_end) && stripe_sub.current_period_end.present?
+        sub.cancel_at = Time.at(stripe_sub.cancel_at) if stripe_sub.respond_to?(:cancel_at) && stripe_sub.cancel_at.present?
+
+        price_id = nil
+        items = stripe_sub.items&.data if stripe_sub.respond_to?(:items)
+        if items.present?
+          price_id = items.first&.price&.id
+        end
+
+        if price_id.present?
+          plan = Plan.find_by_stripe_price_id(price_id)
+          sub.plan_key = plan.key if plan
+        end
+
+        if sub.plan_key.blank?
+          sub.plan_key = stripe_sub.metadata&.[](:plan_key) || stripe_sub.metadata&.[]("plan_key")
+        end
+
+        sub.plan_key ||= "unlimited"
+        sub.save!
+      end
+    end
+
+    def handle_subscription_deleted(stripe_sub)
+      subscription_id = stripe_sub.id
+      customer_id = stripe_sub.customer
+
+      sub = Account::Subscription.find_by(stripe_subscription_id: subscription_id)
+      sub ||= Account::Subscription.find_by(stripe_customer_id: customer_id)
+
+      if sub
+        sub.update!(status: "canceled")
+      end
+    end
+
+    def handle_invoice(invoice)
+      customer_id = invoice.customer
+      sub = Account::Subscription.find_by(stripe_customer_id: customer_id)
+      if sub && invoice.respond_to?(:amount_due) && invoice.amount_due
+        sub.update(next_amount_due_in_cents: invoice.amount_due)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..1b03c38
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,68 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback :incinerate, :before, :cancel_subscription_on_incinerate
+  end
+
+  def active_subscription
+    subscription if subscription&.persisted? && subscription&.active?
+  end
+
+  def subscribed?
+    active_subscription.present?
+  end
+
+  def comped?
+    billing_waiver.present? && billing_waiver.persisted?
+  end
+
+  def comp!
+    (billing_waiver if billing_waiver&.persisted?) || create_billing_waiver!
+  end
+
+  def uncomp!
+    billing_waiver&.destroy
+  end
+
+  def plan
+    if comped?
+      Plan::UNLIMITED
+    elsif subscribed?
+      active_subscription.plan
+    else
+      Plan::FREE
+    end
+  end
+
+  def card_limit
+    return overridden_limit.card_count if overridden_limit&.persisted? && overridden_limit.card_count.present?
+    return nil if comped? || subscribed?
+    plan.card_limit
+  end
+  alias_method :cards_limit, :card_limit
+
+  def cards_left
+    return Float::INFINITY if card_limit.nil?
+    [ card_limit - cards_count, 0 ].max
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_left <= 100
+  end
+
+  private
+    def cancel_subscription_on_incinerate
+      active_subscription&.cancel!
+    end
+end
