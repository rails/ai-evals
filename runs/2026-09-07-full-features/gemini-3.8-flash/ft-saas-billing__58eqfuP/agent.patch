diff --git a/saas/app/views/admin/accounts/show.html.erb b/saas/app/views/admin/accounts/show.html.erb
new file mode 100644
index 0000000..c095dbb
--- /dev/null
+++ b/saas/app/views/admin/accounts/show.html.erb
@@ -0,0 +1,56 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account Details</h2>
+    </header>
+
+    <div class="margin-block-half flex flex-column gap-half">
+      <div><strong>Name:</strong> <%= @account.name %></div>
+      <div><strong>ID:</strong> #<%= @account.external_account_id %></div>
+      <div><strong>Plan:</strong> <%= @account.plan.name %></div>
+      <div><strong>Status:</strong> <%= @account.comped? ? "Comped" : "Active" %></div>
+      <div><strong>Cards count:</strong> <%= @account.cards_count %></div>
+      <div><strong>Bytes used:</strong> <%= number_to_human_size(@account.bytes_used) %></div>
+    </div>
+
+    <div class="margin-block">
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <% end %>
+    </div>
+
+    <header>
+      <h3 class="divider txt-medium margin-block-start">Limit Override</h3>
+    </header>
+
+    <div class="margin-block-half">
+      <%= form_with url: override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half" do |f| %>
+        <div class="flex flex-column gap-quarter">
+          <%= f.label :card_count, "Card count" %>
+          <%= f.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input" %>
+        </div>
+
+        <div class="flex flex-column gap-quarter">
+          <%= f.label :bytes_used, "Bytes used" %>
+          <%= f.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input" %>
+        </div>
+
+        <div class="flex gap-half margin-block-start-half">
+          <%= f.submit "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <div class="margin-block-start-half">
+        <%= button_to "Reset", reset_admin_account_path(@account), method: :post, class: "btn btn--reversed" %>
+      </div>
+    </div>
+  </div>
+</section>
