diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..aa2da92
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,45 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset_override ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to admin_account_path(@account), notice: "Account comped."
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to admin_account_path(@account), notice: "Account uncomped."
+  end
+
+  def override
+    card_count = params[:card_count] || params.dig(:account, :card_count) || params.dig(:account_overridden_limit, :card_count)
+    bytes_used = params[:bytes_used] || params.dig(:account, :bytes_used) || params.dig(:account_overridden_limit, :bytes_used)
+
+    override = @account.overridden_limit || @account.build_overridden_limit
+    override.card_count = card_count.presence
+    override.bytes_used = bytes_used.presence
+    override.save!
+
+    redirect_to admin_account_path(@account), notice: "Override updated."
+  end
+
+  def reset_override
+    @account.overridden_limit&.destroy
+    redirect_to admin_account_path(@account), notice: "Override dropped."
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by(external_account_id: params[:id])
+      raise ActiveRecord::RecordNotFound unless @account
+    end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..8ccb096
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,37 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan_key = params[:plan] || "unlimited"
+    plan = Plan.find(plan_key)
+
+    customer_id = Current.account.subscription&.stripe_customer_id
+    if customer_id.blank? && defined?(Stripe::Customer)
+      customer = Stripe::Customer.create(
+        email: Current.user.identity.email_address,
+        name: Current.account.name,
+        metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id }
+      )
+      customer_id = customer.id
+    end
+
+    session = Stripe::Checkout::Session.create(
+      customer: customer_id,
+      mode: "subscription",
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: "#{account_settings_url(script_name: Current.account.slug)}?session_id={CHECKOUT_SESSION_ID}",
+      cancel_url: account_settings_url(script_name: Current.account.slug),
+      client_reference_id: Current.account.external_account_id,
+      metadata: { account_id: Current.account.id, external_account_id: Current.account.external_account_id, plan_key: plan.key }
+    )
+
+    redirect_to session.url, allow_other_host: true
+  rescue Stripe::StripeError, Faraday::Error, SocketError => e
+    Rails.logger.error("Stripe checkout error: #{e.message}")
+    redirect_to account_settings_path, alert: "Unable to start checkout at this time."
+  end
+
+  def show
+    create
+  end
+end
