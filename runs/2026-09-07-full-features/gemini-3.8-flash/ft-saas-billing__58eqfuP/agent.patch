diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..5b0353a
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,27 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: true, allow_nil: true
+
+  scope :active, -> { where(status: %w[ active trialing ]) }
+
+  def active?
+    status.in?(%w[ active trialing ])
+  end
+
+  def plan
+    Plan.find(plan_key)
+  end
+
+  def cancel!
+    if stripe_subscription_id.present? && defined?(Stripe::Subscription)
+      begin
+        Stripe::Subscription.cancel(stripe_subscription_id)
+      rescue Stripe::StripeError, Faraday::Error => e
+        Rails.logger.warn("Failed to cancel Stripe subscription: #{e.message}")
+      end
+    end
+    update!(status: "canceled")
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..5a6005c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,97 @@
+class Plan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:, stripe_price_id: nil)
+    @key = key.to_s
+    @name = name
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id = stripe_price_id
+  end
+
+  def stripe_price_id
+    if @stripe_price_id.is_a?(Proc)
+      @stripe_price_id.call
+    else
+      @stripe_price_id
+    end
+  end
+
+  def free?
+    @key == "free"
+  end
+
+  def unlimited?
+    @key.in?(%w[ unlimited unlimited_plus ])
+  end
+
+  def to_s
+    @name
+  end
+
+  def ==(other)
+    case other
+    when Plan
+      key == other.key
+    when String, Symbol
+      key == other.to_s || name.downcase == other.to_s.downcase
+    else
+      false
+    end
+  end
+
+  FREE = new(
+    key: "free",
+    name: "Free",
+    price_in_cents: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+  )
+
+  UNLIMITED = new(
+    key: "unlimited",
+    name: "Unlimited",
+    price_in_cents: 2000,
+    card_limit: nil,
+    storage_limit: 5.gigabytes,
+    stripe_price_id: -> { ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID", "price_monthly_v1") }
+  )
+
+  UNLIMITED_PLUS = new(
+    key: "unlimited_plus",
+    name: "Unlimited+",
+    price_in_cents: 2500,
+    card_limit: nil,
+    storage_limit: 500.gigabytes,
+    stripe_price_id: -> { ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", "price_monthly_extra_storage_v1") }
+  )
+
+  def self.all
+    [ FREE, UNLIMITED, UNLIMITED_PLUS ]
+  end
+
+  def self.find(key)
+    case key.to_s.downcase.gsub(/[^a-z0-9_]/, "_")
+    when "unlimited_plus", "unlimited_", "unlimited_extra_storage"
+      UNLIMITED_PLUS
+    when "unlimited"
+      UNLIMITED
+    when "free"
+      FREE
+    else
+      FREE
+    end
+  end
+
+  def self.find_by_stripe_price_id(price_id)
+    return nil if price_id.blank?
+    if price_id == UNLIMITED_PLUS.stripe_price_id || price_id == ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      UNLIMITED_PLUS
+    elsif price_id == UNLIMITED.stripe_price_id || price_id == ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      UNLIMITED
+    else
+      nil
+    end
+  end
+end
