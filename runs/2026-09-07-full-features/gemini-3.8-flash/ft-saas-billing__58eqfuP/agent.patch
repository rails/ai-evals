diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..cc48174
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+teardown do
+  if @account
+    @account.uncomp!
+    @account.overridden_limit&.destroy
+    @account.subscription&.destroy
+  end
+end
+
+
+  test "non-staff cannot access accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+
+      get saas.admin_account_path(@account)
+      assert_response :forbidden
+    end
+  end
+
+  test "staff can list accounts, each name opening its page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+    end
+  end
+
+  test "comp and uncomp account" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+
+      post saas.comp_admin_account_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Uncomp"
+
+      post saas.uncomp_admin_account_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "override form with Card count and Bytes used submitted by Override, and Reset" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "form" do
+        assert_select "label", text: "Card count"
+        assert_select "input#card_count"
+        assert_select "label", text: "Bytes used"
+        assert_select "input#bytes_used"
+        assert_select "input[type=submit][value='Override']"
+      end
+      assert_select "button, input[type=submit]", text: "Reset"
+
+      post saas.override_admin_account_path(@account), params: {
+        card_count: 500,
+        bytes_used: 2.gigabytes
+      }
