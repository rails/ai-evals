+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+teardown do
+  if @account
+    @account.uncomp!
+    @account.overridden_limit&.destroy
+    @account.subscription&.destroy
+  end
+end
+
+
+  test "cannot create cards via JSON when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via HTML when card limit exceeded since they become drafts" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "cannot publish cards when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "can publish cards when under card limit" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 100)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "staff can create and publish cards even when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Staff card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "draft card shows Upgrade pitch instead of create buttons when card limit exceeded" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch" do
+      assert_select "a", text: /Upgrade/
+    end
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows countdown warning when from 100 cards out" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch" do
+      assert_select ".card-perma__notch-new-card-buttons"
+      assert_select "div", text: /50 cards left/
+    end
+  end
+
+  test "paid account can create and publish cards beyond 1000 cards" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    @account.create_subscription!(
+      stripe_customer_id: "cus_paid",
+      stripe_subscription_id: "sub_paid",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Paid card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "comped account can create and publish cards beyond 1000 cards" do
+    sign_in_as :mike
+
+    @account.update_column(:cards_count, 1000)
+    @account.comp!
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Comped card" } },
+        as: :json
+    end
+    assert_response :created
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
