@@ -0,0 +1,52 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "highlight_card_title wraps matched words in mark" do
+    card = Card.new(title: "The quick brown fox")
+    result = highlight_card_title(card, "brown")
+
+    assert_equal "The quick <mark>brown</mark> fox", result
+  end
+
+  test "highlight_card_title with multiple words" do
+    card = Card.new(title: "The quick brown fox")
+    result = highlight_card_title(card, "quick fox")
+
+    assert_equal "The <mark>quick</mark> brown <mark>fox</mark>", result
+  end
+
+  test "highlight_card_title without query returns escaped title" do
+    card = Card.new(title: "Simple title")
+    assert_equal "Simple title", highlight_card_title(card, nil)
+    assert_equal "Simple title", highlight_card_title(card, "")
+  end
+
+  test "highlight_card_description wraps matched words in mark" do
+    card = boards(:writebook).cards.create!(title: "Title", description: "Contains exciting information", creator: users(:david), status: :published)
+    result = highlight_card_description(card, "exciting")
+
+    assert_includes result, "<mark>exciting</mark>"
+  end
+
+  test "highlight_card_description returns nil when query not present in text" do
+    card = boards(:writebook).cards.create!(title: "Title", description: "Plain text", creator: users(:david), status: :published)
+    assert_nil highlight_card_description(card, "missing")
+  end
+
+  test "highlight_card_comments returns matching comments with highlighted excerpts" do
+    card = boards(:writebook).cards.create!(title: "Title", creator: users(:david), status: :published)
+    card.comments.create!(body: "First comment is unrelated", creator: users(:david))
+    card.comments.create!(body: "Second comment mentions the secret treasure", creator: users(:david))
+
+    results = highlight_card_comments(card, "treasure")
+    assert_equal 1, results.size
+
+    comment, excerpt = results.first
+    assert_includes excerpt, "<mark>treasure</mark>"
+    assert_equal users(:david), comment.creator
+  end
+end
