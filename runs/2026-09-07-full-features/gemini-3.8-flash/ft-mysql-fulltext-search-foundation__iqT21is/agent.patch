+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    cards = if @query.present?
+      Current.user.accessible_cards.published.reverse_chronologically.search(@query).preloaded.preload(comments: [ :creator, :rich_text_body ])
+    else
+      Card.none
+    end
+
+    set_page_and_extract_portion_from cards
+    @cards = @page.records
+
+    respond_to do |format|
+      format.html
+      format.json { render json: @cards }
+    end
+  end
+end
