@@ -0,0 +1,171 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:david)
+    sign_in_as :david
+  end
+
+  test "show without query" do
+    get search_path
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_select "input[type=search][name=q]"
+  end
+
+  test "search by title" do
+    card = boards(:writebook).cards.create!(title: "Special Unicorn Feature", creator: users(:david), status: :published)
+
+    get search_path(q: "Unicorn")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "Unicorn"
+    assert_includes response.body, card_path(card)
+  end
+
+  test "search by description" do
+    card = boards(:writebook).cards.create!(title: "Ordinary Title", description: "This contains a magical pegasus inside", creator: users(:david), status: :published)
+
+    get search_path(q: "pegasus")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "pegasus"
+    assert_includes response.body, card_path(card)
+  end
+
+  test "search by comment body" do
+    card = boards(:writebook).cards.create!(title: "Discussion Card", creator: users(:david), status: :published)
+    card.comments.create!(body: "Here is a comment mentioning chimera creature", creator: users(:david))
+
+    get search_path(q: "chimera")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "chimera"
+    assert_includes response.body, card_path(card)
+  end
+
+  test "results ordered newest first" do
+    card_older = boards(:writebook).cards.create!(title: "Older dragon item", creator: users(:david), status: :published, created_at: 2.days.ago)
+    card_newer = boards(:writebook).cards.create!(title: "Newer dragon item", creator: users(:david), status: :published, created_at: 1.hour.ago)
+
+    get search_path(q: "dragon")
+    assert_response :success
+
+    # Verify both cards returned and newer card appears before older card in HTML
+    assert_select ".card", count: 2
+    newer_pos = response.body.index(card_path(card_newer))
+    older_pos = response.body.index(card_path(card_older))
+    assert newer_pos < older_pos, "Expected newer card to appear before older card"
+  end
+
+  test "only shows results from accessible boards" do
+    # board where david has access
+    accessible_card = boards(:writebook).cards.create!(title: "Griffin in writebook", creator: users(:david), status: :published)
+
+    # board where david does NOT have access
+    inaccessible_board = accounts("37s").boards.create!(name: "Secret Board", creator: users(:kevin))
+    inaccessible_board.accesses.where(user: users(:david)).destroy_all
+    inaccessible_card = inaccessible_board.cards.create!(title: "Griffin in secret", creator: users(:kevin), status: :published)
+
+    get search_path(q: "Griffin")
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_includes response.body, card_path(accessible_card)
+    assert_not_includes response.body, card_path(inaccessible_card)
+  end
+
+  test "draft cards never turn up" do
+    draft_by_title = boards(:writebook).cards.create!(title: "Phoenix draft title", creator: users(:david), status: :drafted)
+    draft_by_desc = boards(:writebook).cards.create!(title: "Draft with desc", description: "Phoenix in draft desc", creator: users(:david), status: :drafted)
+
+    # Search for Phoenix
+    get search_path(q: "Phoenix")
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_not_includes response.body, card_path(draft_by_title)
+    assert_not_includes response.body, card_path(draft_by_desc)
+  end
+
+  test "comments on draft cards never turn up" do
+    card = boards(:writebook).cards.create!(title: "Card", creator: users(:david), status: :published)
+    comment = card.comments.create!(body: "Centaur in comment", creator: users(:david))
+    card.drafted!
+
+    get search_path(q: "Centaur")
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_not_includes response.body, card_path(card)
+  end
+
+  test "no results found" do
+    get search_path(q: "nonexistent_gibberish_query_xyz")
+    assert_response :success
+    assert_select ".card", count: 0
+    assert_select ".blank-slate", text: "No cards match that search"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path(q: "test")
+    assert_response :redirect
+  end
+
+  test "case insensitive search" do
+    card = boards(:writebook).cards.create!(title: "UPPERCASE TITLE", description: "LOWERCASE DESCRIPTION", creator: users(:david), status: :published)
+
+    get search_path(q: "uppercase")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "UPPERCASE"
+
+    get search_path(q: "DESCRIPTION")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "DESCRIPTION"
+  end
+
+  test "multi-word search" do
+    card = boards(:writebook).cards.create!(title: "First Word and Second Word", creator: users(:david), status: :published)
+
+    get search_path(q: "First Second")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "First"
+    assert_select "mark", text: "Second"
+  end
+
+  test "special characters in search query" do
+    card = boards(:writebook).cards.create!(title: "100% discount on item_name", creator: users(:david), status: :published)
+
+    get search_path(q: "100%")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "100%"
+
+    get search_path(q: "item_name")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "item_name"
+  end
+
+  test "XSS safety in search highlighting" do
+    card = boards(:writebook).cards.create!(title: "Safe <script>alert('xss')</script> test", creator: users(:david), status: :published)
+
+    get search_path(q: "alert")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "alert"
+    assert_not_includes response.body, "<script>alert"
+    assert_includes response.body, "&lt;script&gt;<mark>alert</mark>"
+  end
+
+  test "search as json" do
+    card = boards(:writebook).cards.create!(title: "JSON Search Target", creator: users(:david), status: :published)
+
+    get search_path(q: "JSON", format: :json)
+    assert_response :success
+    numbers = response.parsed_body.pluck("number")
+    assert_includes numbers, card.number
+  end
+end
