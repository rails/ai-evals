+++ b/app/models/card/searchable.rb
@@ -0,0 +1,49 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      return none if query.blank?
+
+      clean_query = query.strip
+      return none if clean_query.blank?
+
+      pattern = "%#{sanitize_sql_like(clean_query)}%"
+      words = clean_query.split(/\s+/).reject(&:blank?)
+
+      title_matches = where("cards.title LIKE ? ESCAPE '\\'", pattern)
+      desc_matches = where(
+        id: ActionText::RichText.where(record_type: "Card", name: "description")
+                                .where("body LIKE ? ESCAPE '\\'", pattern)
+                                .select(:record_id)
+      )
+      comment_matches = where(
+        id: Comment.where(
+          id: ActionText::RichText.where(record_type: "Comment", name: "body")
+                                  .where("body LIKE ? ESCAPE '\\'", pattern)
+                                  .select(:record_id)
+        ).select(:card_id)
+      )
+
+      matches = title_matches.or(desc_matches).or(comment_matches)
+
+      if words.length > 1
+        word_title_scope = words.reduce(all) { |scope, word| scope.where("cards.title LIKE ? ESCAPE '\\'", "%#{sanitize_sql_like(word)}%") }
+
+        desc_rich_texts = words.reduce(ActionText::RichText.where(record_type: "Card", name: "description")) do |scope, word|
+          scope.where("body LIKE ? ESCAPE '\\'", "%#{sanitize_sql_like(word)}%")
+        end
+        word_desc_scope = where(id: desc_rich_texts.select(:record_id))
+
+        comment_rich_texts = words.reduce(ActionText::RichText.where(record_type: "Comment", name: "body")) do |scope, word|
+          scope.where("body LIKE ? ESCAPE '\\'", "%#{sanitize_sql_like(word)}%")
+        end
+        word_comment_scope = where(id: Comment.where(id: comment_rich_texts.select(:record_id)).select(:card_id))
+
+        matches = matches.or(word_title_scope).or(word_desc_scope).or(word_comment_scope)
+      end
+
+      matches
+    end
+  end
+end
