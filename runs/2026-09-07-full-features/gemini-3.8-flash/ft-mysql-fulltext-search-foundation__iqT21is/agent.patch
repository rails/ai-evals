+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<div class="center-block max-width pad-block margin-block-end">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half align-center", role: "search", data: { turbo_frame: "cards_container", turbo_action: "advance" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true, class: "input full-width", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn btn--primary" %>
+  <% end %>
+</div>
+
+<%= turbo_frame_tag :cards_container do %>
+  <section class="cards cards--grid">
+    <div class="cards__list hide-scrollbar">
+      <% if @cards.any? %>
+        <%= with_automatic_pagination :cards_paginated_container, @page do %>
+          <%= render partial: "cards/display/preview", collection: @cards, as: :card, locals: { highlight_query: @query, draggable: false } %>
+        <% end %>
+      <% elsif @query.present? %>
+        <div class="blank-slate">No cards match that search</div>
+      <% else %>
+        <div class="blank-slate">Type to search cards by title, description, or comments</div>
+      <% end %>
+    </div>
+  </section>
+<% end %>
