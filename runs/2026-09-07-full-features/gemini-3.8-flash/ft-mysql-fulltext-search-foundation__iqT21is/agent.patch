@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "search matches by title" do
+    card = boards(:writebook).cards.create!(title: "Alpha Centauri Planet", creator: users(:david), status: :published)
+
+    assert_includes Card.published.search("Centauri"), card
+    assert_not_includes Card.published.search("Betelgeuse"), card
+  end
+
+  test "search matches by description" do
+    card = boards(:writebook).cards.create!(title: "Title Here", description: "Contains Betelgeuse star in text", creator: users(:david), status: :published)
+
+    assert_includes Card.published.search("Betelgeuse"), card
+    assert_not_includes Card.published.search("Aldebaran"), card
+  end
+
+  test "search matches by comment body" do
+    card = boards(:writebook).cards.create!(title: "Title Here", creator: users(:david), status: :published)
+    card.comments.create!(body: "Discussion about Aldebaran star", creator: users(:david))
+
+    assert_includes Card.published.search("Aldebaran"), card
+    assert_not_includes Card.published.search("Betelgeuse"), card
+  end
+
+  test "draft cards are excluded from search results" do
+    draft = boards(:writebook).cards.create!(title: "Rigel Star Draft", description: "Rigel in desc", creator: users(:david), status: :drafted)
+
+    assert_not_includes Card.published.search("Rigel"), draft
+  end
+
+  test "empty or blank query returns none" do
+    assert_equal Card.none, Card.search("")
+    assert_equal Card.none, Card.search(nil)
+    assert_equal Card.none, Card.search("   ")
+  end
+
+  test "sanitizes like wildcards" do
+    card = boards(:writebook).cards.create!(title: "50% off everything", creator: users(:david), status: :published)
+
+    assert_includes Card.published.search("50%"), card
+    assert_not_includes Card.published.search("500%"), card
+  end
+
+  test "multi-word query matches across words" do
+    card = boards(:writebook).cards.create!(title: "Deep Space Exploration Mission", creator: users(:david), status: :published)
+
+    assert_includes Card.published.search("Space Mission"), card
+    assert_not_includes Card.published.search("Space Submarine"), card
+  end
+end
