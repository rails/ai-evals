+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,50 @@
+module SearchesHelper
+  include HtmlHelper
+
+  def highlight_card_title(card, query)
+    title_html = card_html_title(card)
+    if query.present? && title_html.present?
+      words = query.to_s.split(/\s+/).reject(&:blank?)
+      highlight(title_html, words)
+    else
+      title_html
+    end
+  end
+
+  def highlight_card_description(card, query, radius: 100)
+    highlight_search_text(card.description, query, radius: radius)
+  end
+
+  def highlight_card_comments(card, query, limit: 5)
+    return [] if query.blank?
+
+    matching = []
+    card.comments.each do |comment|
+      if excerpt = highlight_search_text(comment.body, query)
+        matching << [ comment, excerpt ]
+        break if matching.size >= limit
+      end
+    end
+    matching
+  end
+
+  def highlight_search_text(text, query, radius: 100)
+    return nil if text.blank? || query.blank?
+
+    plain_text = text.respond_to?(:to_plain_text) ? text.to_plain_text : text.to_s
+    clean_query = query.to_s.strip
+    return nil if clean_query.blank?
+
+    words = clean_query.split(/\s+/).reject(&:blank?)
+    target = ([ clean_query ] + words).find { |w| plain_text.downcase.include?(w.downcase) }
+    return nil unless target
+
+    snip = if plain_text.length <= (radius * 2)
+      plain_text
+    else
+      excerpt(plain_text, target, radius: radius) || plain_text.truncate(radius * 2)
+    end
+
+    highlight(snip, words)
+  end
+end
