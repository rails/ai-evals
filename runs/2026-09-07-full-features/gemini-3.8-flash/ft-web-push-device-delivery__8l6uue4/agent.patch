diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..851f8f6
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:david)
+    @notification = notifications(:logo_mentioned_david)
+    ENV["VAPID_PUBLIC_KEY"] = "fake_public_key"
+    ENV["VAPID_PRIVATE_KEY"] = "fake_private_key"
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "push sends webpush payload with notification title, body, and card path" do
+    expected_message = {
+      title: @notification.title,
+      body: @notification.body,
+      path: @notification.path,
+      icon: "/app-icon.png",
+      badge: "/favicon.png"
+    }.to_json
+
+    WebPush.expects(:payload_send).with(
+      endpoint: @subscription.endpoint,
+      message: expected_message,
+      p256dh: @subscription.p256dh_key,
+      auth: @subscription.auth_key,
+      vapid: {
+        public_key: "fake_public_key",
+        private_key: "fake_private_key",
+        subject: "mailto:support@fizzy.do"
+      }
+    )
+
+    @subscription.push(@notification)
+  end
+
+  test "push destroys subscription on ExpiredSubscription" do
+    res = Net::HTTPGone.new("1.1", "410", "Gone")
+    res.instance_variable_set(:@read, true)
+    res.body = "Gone"
+
+    WebPush.expects(:payload_send).raises(
+      WebPush::ExpiredSubscription.new(res, "push.example.com")
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+
+    assert_not Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "push destroys subscription on InvalidSubscription" do
+    res = Net::HTTPNotFound.new("1.1", "404", "Not Found")
+    res.instance_variable_set(:@read, true)
+    res.body = "Not Found"
+
+    WebPush.expects(:payload_send).raises(
+      WebPush::InvalidSubscription.new(res, "push.example.com")
+    )
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+
+    assert_not Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "push does nothing when VAPID keys are missing" do
+    ENV.delete("VAPID_PUBLIC_KEY")
+
+    WebPush.expects(:payload_send).never
+    @subscription.push(@notification)
+  end
+end
