diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..e43554f
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,35 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    Push::Subscription.where(endpoint: push_subscription_params[:endpoint]).where.not(user: @user).destroy_all
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.json { head :created }
+      format.html { head :created }
+    end
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(endpoint: params[:endpoint] || params.dig(:push_subscription, :endpoint))
+    subscription ||= @user.push_subscriptions.find_by(id: params[:id]) if params[:id].present? && params[:id] != "destroy"
+    subscription&.destroy
+
+    respond_to do |format|
+      format.json { head :no_content }
+      format.html { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..9115551
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,187 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details", "explainer" ]
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  async connect() {
+    if (!this.#isSupported()) {
+      if (this.hasToggleTarget) {
+        this.toggleTarget.disabled = true
+      }
+      return
+    }
+
+    await this.#updateStatus()
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.#enable()
+    } else {
+      await this.#disable()
+    }
+  }
+
+  async #updateStatus() {
+    if (Notification.permission === "denied") {
+      this.#showBlockedHelp()
+      return
+    }
+
+    this.#hideBlockedHelp()
+
+    if (Notification.permission === "granted") {
+      const registration = await this.#getRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        this.#setOn(true)
+      } else {
+        this.#setOn(false)
+      }
+    } else {
+      this.#setOn(false)
+    }
+  }
+
+  async #enable() {
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        this.#hideBlockedHelp()
+
+        const registration = await this.#getRegistration()
+        if (!registration) {
+          throw new Error("Service worker registration not found")
+        }
+
+        let subscription = await registration.pushManager.getSubscription()
+
+        if (!subscription) {
+          const applicationServerKey = this.#urlBase64ToUint8Array(this.vapidPublicKeyValue)
+          subscription = await registration.pushManager.subscribe({
+            userVisibleOnly: true,
+            applicationServerKey: applicationServerKey
+          })
+        }
+
+        const subscriptionJson = subscription.toJSON()
+        const p256dhKey = subscriptionJson.keys?.p256dh || this.#arrayBufferToBase64(subscription.getKey("p256dh"))
+        const authKey = subscriptionJson.keys?.auth || this.#arrayBufferToBase64(subscription.getKey("auth"))
+
+        const response = await post(this.subscriptionUrlValue, {
+          body: {
+            push_subscription: {
+              endpoint: subscription.endpoint,
+              p256dh_key: p256dhKey,
+              auth_key: authKey
+            }
+          },
+          contentType: "application/json"
+        })
+
+        if (response.ok) {
+          this.#setOn(true)
+        } else {
+          this.#setOn(false)
+        }
+      } else if (permission === "denied") {
+        this.#showBlockedHelp()
+      } else {
+        this.#setOn(false)
+      }
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+      this.#setOn(false)
+    }
+  }
+
+  async #disable() {
+    try {
+      const registration = await this.#getRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        const endpoint = subscription.endpoint
+        await subscription.unsubscribe()
+        await destroy(this.subscriptionUrlValue, {
+          query: { endpoint }
+        })
+      }
+    } catch (error) {
+      console.error("Failed to disable push notifications", error)
+    } finally {
+      this.#setOn(false)
+    }
+  }
+
+  #setOn(isOn) {
+    if (isOn) {
+      this.element.classList.add("notifications--on")
+      if (this.hasToggleTarget) {
+        this.toggleTarget.checked = true
+        this.toggleTarget.disabled = false
+      }
+    } else {
+      this.element.classList.remove("notifications--on")
+      if (this.hasToggleTarget) {
+        this.toggleTarget.checked = false
+      }
+    }
+  }
+
+  #showBlockedHelp() {
+    this.#setOn(false)
+    if (this.hasToggleTarget) {
+      this.toggleTarget.disabled = true
+    }
+    this.detailsTargets.forEach(target => target.hidden = false)
+    if (this.hasExplainerTarget) {
+      this.explainerTarget.hidden = false
+    }
+  }
+
+  #hideBlockedHelp() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+    if (this.hasToggleTarget && this.#isSupported()) {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  #isSupported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  async #getRegistration() {
+    if ("serviceWorker" in navigator) {
+      try {
+        return await navigator.serviceWorker.ready
+      } catch {
+        return await navigator.serviceWorker.register("/service-worker.js")
+      }
+    }
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  #arrayBufferToBase64(buffer) {
+    if (!buffer) return ""
+    const binary = String.fromCharCode(...new Uint8Array(buffer))
+    return window.btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+}
