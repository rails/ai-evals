+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+    @valid_params = {
+      push_subscription: {
+        endpoint: "https://push.example.com/sub/new_endpoint",
+        p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u",
+        auth_key: "tBHItJI5svbpez7KI4CCXg"
+      }
+    }
+  end
+
+  test "create creates a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @valid_params, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/new_endpoint", subscription.endpoint
+    assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u", subscription.p256dh_key
+    assert_equal "tBHItJI5svbpez7KI4CCXg", subscription.auth_key
+  end
+
+  test "create with form params" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: @valid_params
+    end
+
+    assert_response :created
+  end
+
+  test "create updates existing subscription with same endpoint" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/new_endpoint",
+      p256dh_key: "old_key",
+      auth_key: "old_auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: @valid_params, as: :json
+    end
+
+    assert_response :created
+    existing.reload
+    assert_equal "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u", existing.p256dh_key
+  end
+
+  test "create removes endpoint from previous user" do
+    other_user = users(:kevin)
+    other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/new_endpoint",
+      p256dh_key: "old_key",
+      auth_key: "old_auth"
+    )
+
+    assert_difference -> { other_user.push_subscriptions.count }, -1 do
+      assert_difference -> { @user.push_subscriptions.count }, 1 do
+        post user_push_subscriptions_path(@user), params: @valid_params, as: :json
+      end
+    end
+
+    assert_response :created
+  end
+
+  test "create is forbidden for other users" do
+    other_user = users(:kevin)
+
+    assert_no_difference "Push::Subscription.count" do
+      post user_push_subscriptions_path(other_user), params: @valid_params, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy deletes push subscription by endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/to_delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: subscription.endpoint }, as: :json
+    end
+
+    assert_response :no_content
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+
+  test "destroy deletes push subscription by id" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/to_delete_by_id",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+    assert_not Push::Subscription.exists?(subscription.id)
+  end
+end
