diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..971c84e
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,41 @@
+module Push
+  class Subscription < ApplicationRecord
+    belongs_to :account, default: -> { user.account }
+    belongs_to :user
+
+    validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+    def push(notification)
+      return unless vapid_configured?
+
+      message = {
+        title: notification.title,
+        body: notification.body,
+        path: notification.path,
+        icon: "/app-icon.png",
+        badge: "/favicon.png"
+      }.to_json
+
+      WebPush.payload_send(
+        endpoint: endpoint,
+        message: message,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"],
+          subject: ENV["VAPID_SUBJECT"].presence || "mailto:support@fizzy.do"
+        }
+      )
+    rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+      destroy
+    rescue WebPush::ResponseError => error
+      Rails.logger.error "Failed to deliver push notification: #{error.message}"
+    end
+
+    private
+      def vapid_configured?
+        ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+      end
+  end
+end
