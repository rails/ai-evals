+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "new" do
+    get new_account_import_url
+    assert_response :success
+  end
+
+  test "create enqueues an import" do
+    file = Rack::Test::UploadedFile.new(file_fixture("avatar.png"), "application/zip")
+
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_with job: Account::ImportJob do
+        post account_imports_url, params: { import: { file: file } }
+      end
+    end
+
+    import = Import.order(:created_at).last
+    assert_equal identities(:david), import.identity
+    assert import.file.attached?
+    assert_redirected_to account_settings_path
+  end
+
+  test "create without a file" do
+    assert_no_difference -> { Import.count } do
+      post account_imports_url, params: { import: { file: nil } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "importing an account export end to end" do
+    # make an export of this account first
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    export.process
+    export.file.open { |tempfile| FileUtils.cp(tempfile.path, "/tmp/fizzy-import-e2e-#{Process.pid}.zip") }
+  
+    file = Rack::Test::UploadedFile.new("/tmp/fizzy-import-e2e-#{Process.pid}.zip", "application/zip")
+  
+    assert_difference -> { Account.count }, 1 do
+      perform_enqueued_jobs do
+        post account_imports_url, params: { import: { file: file } }
+      end
+    end
+  
+    import = Import.order(:created_at).last
+    new_account = import.reload.imported_account
+    assert_equal "37signals", new_account.name
+    assert_equal accounts(:"37s").cards.count, new_account.cards.count
+  
+    # the importer got in as the owner
+    assert new_account.users.find_by(identity: identities(:david)).owner?
+  
+    # and they were emailed about it
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:david).email_address ], mail.to
+    assert_match /import is ready/i, mail.subject
+  end
+  
+  test "importing requires authentication" do
+
+    sign_out
+
+    get new_account_import_url
+    assert_response :redirect
+  end
+end
