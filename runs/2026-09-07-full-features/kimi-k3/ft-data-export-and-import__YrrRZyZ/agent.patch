+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "account settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<div class="panel shadow center" style="--panel-size: 55ch;">
+  <div class="flex flex-column gap txt-medium">
+    <p class="margin-none">
+      Bring a Fizzy account export (<code>.zip</code>) back in as a <strong>brand new account</strong> —
+      with all its boards, cards, comments, files, and people.
+    </p>
+
+    <%= form_with model: @import, url: account_imports_path, scope: :import, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
+      <% if @import.errors.any? %>
+        <div class="txt-negative">
+          <%= @import.errors.full_messages.to_sentence %>
+        </div>
+      <% end %>
+
+      <strong class="full-width">
+        <%= form.file_field :file, required: true, class: "input full-width", accept: ".zip,application/zip", data: { action: "input->form#disableSubmitWhenInvalid" } %>
+      </strong>
+
+      <%= form.button type: :submit, class: "btn btn--link center" do %>
+        <%= icon_tag "upload" %>
+        <span>Import account</span>
+      <% end %>
+    <% end %>
+
+    <p class="txt-small txt-tinted margin-none">
+      Importing runs in the background and can take a while for big accounts.
+      You'll get an email when it's done — or when it failed, and why. Your current account isn't affected.
+    </p>
+  </div>
+</div>
