+class ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  before_action :set_active_storage_url_options, only: :show
+
+  def show
+    export = Export.find_by_download_token(params[:id])
+
+    if export&.file&.attached?
+      redirect_to export.file.url(disposition: :attachment, filename: export.file.filename.to_s), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+
+  private
+    # Blob service URLs are usually generated by Active Storage's own
+    # controllers, which set this up for us -- here we're generating one
+    # ourselves for the download redirect.
+    def set_active_storage_url_options
+      ActiveStorage::Current.url_options = {
+        protocol: request.protocol,
+        host: request.host,
+        port: request.port,
+        script_name: request.script_name
+      }
+    end
+end
