+    end
+
+    # Importing
+
+    def each_archived_record(zip)
+      zip.glob("#{model_dir}/*.json").each do |path|
+        begin
+          row = JSON.parse(zip.read(path))
+        rescue JSON::ParserError => error
+          raise Account::DataTransfer::InvalidArchiveError, "The archive contains invalid JSON in #{path} (#{error.message})"
+        end
+
