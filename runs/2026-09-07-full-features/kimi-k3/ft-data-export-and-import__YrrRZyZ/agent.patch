index 0000000..beaa1cb
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,55 @@
+# An archive of Fizzy data, built in the background and delivered by email.
+#
+# An account export (requested by an admin from account settings) contains the
+# whole account: every record as JSON plus every uploaded file, in a layout
+# that can be brought back in through /account/imports/new.
+#
+# A cards export (requested by anyone from their profile page) contains the
+# cards they can see -- with their comments -- as JSON, plus every picture and
+# file attached to them.
+class Export < ApplicationRecord
+  # The download link in the delivery email stops working after this long.
+  DOWNLOAD_LINK_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself), scopes: false
+
+  class << self
+    def find_by_download_token(token)
+      find_signed token, purpose: :download
+    end
+  end
+
+  def download_token
+    signed_id purpose: :download, expires_in: DOWNLOAD_LINK_EXPIRY
+  end
+
+  def process_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def process
+    Current.with_account(account) do
+      build
+      ExportMailer.ready(self).deliver_later
+    end
+  end
+
+  def filename
+    "fizzy-#{kind}-export-#{Date.current.iso8601}.zip"
+  end
+
+  private
+    def build
+      ZipFile.create_for file, filename: filename do |zip|
+        case kind
+        when "account" then Account::DataTransfer::Manifest.new(account).export_to(zip)
+        when "cards"   then Export::CardsBuilder.new(user).build(zip)
+        end
+      end
+    end
+end
diff --git a/app/models/export/cards_builder.rb b/app/models/export/cards_builder.rb
new file mode 100644
index 0000000..317786a
--- /dev/null
+++ b/app/models/export/cards_builder.rb
@@ -0,0 +1,88 @@
+# Writes the cards a user can see -- with their comments -- into an export
+# archive, as one JSON document per card under "cards/", plus every picture
+# and file attached to them under "files/".
+class Export::CardsBuilder
+  def initialize(user)
+    @user = user
+  end
+
+  def build(zip)
+    @zip = zip
+
+    cards.find_each do |card|
+      write_card card
+      write_files_for card
+    end
+  ensure
+    @zip = nil
+  end
+
+  private
+    attr_reader :user, :zip
+
+    def cards
+      user.accessible_cards.includes(
+        :board, :column, :tags, :creator, :assignees,
+        :image_attachment, rich_text_description: { embeds_attachments: :blob },
+        comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ]
+      )
+    end
+
+    def write_card(card)
+      zip.add_file "cards/#{card.id}.json", card_json(card).to_json
+    end
+
+    def card_json(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.body.to_s,
+        board: card.board.name,
+        column: card.column&.name,
+        tags: card.tags.map(&:title),
+        creator: card.creator.name,
+        assignees: card.assignees.map(&:name),
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        comments: card.comments.chronologically.map { |comment| comment_json(comment) }
+      }
+    end
+
+    def comment_json(comment)
+      {
+        id: comment.id,
+        creator: comment.creator.name,
+        body: comment.body.to_s,
+        created_at: comment.created_at
+      }
+    end
+
+    def write_files_for(card)
+      blobs_for(card).each do |blob|
+        path = "files/#{blob.key}"
+        next if zip.exists?(path)
+
+        zip.add_file path, compress: false do |sink|
+          blob.download { |chunk| sink << chunk }
+        end
+      end
+    end
+
+    def blobs_for(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      blobs.concat embed_blobs(card.rich_text_description)
+
+      card.comments.each do |comment|
+        blobs.concat embed_blobs(comment.rich_text_body)
+      end
+
+      blobs.uniq
+    end
+
+    def embed_blobs(rich_text)
+      rich_text&.embeds_attachments&.map(&:blob) || []
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..ca036cd
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,73 @@
+# Brings a Fizzy account export archive back in as a brand new account, with
+# everything in it -- boards, cards, comments, files, and people.
+#
+# The person importing uploads the archive from /account/imports/new while
+# signed in. The archive is processed in the background, and they get an email
+# when it's done -- or when it failed, and why. An import that can't be
+# completed leaves nothing behind: all records are created inside a
+# transaction, and any files already uploaded to the storage service are
+# removed again.
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  validate :file_attached
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process
+    translation = Account::DataTransfer::Translation.new
+
+    transaction do
+      import_account translation
+      grant_ownership_to translation.account
+    end
+
+    update! imported_account: translation.account
+
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    translation&.cleanup_uploads
+
+    Rails.error.report error, severity: :error
+    ImportMailer.failed(self, error_message: error.message).deliver_later
+  end
+
+  private
+    def import_account(translation)
+      file.open do |tempfile|
+        ZipFile::Reader.open(tempfile.path) do |zip|
+          Account::DataTransfer::Manifest.new(nil).import_from(zip, translation)
+        end
+      end
+
+      translation.account
+    end
+
+    def grant_ownership_to(account)
+      owner = account.users.create! \
+        identity: identity,
+        name: importer_name,
+        role: :owner,
+        verified_at: Time.current
+
+      account.users.create!(role: :system, name: "System") unless account.users.exists?(role: :system)
+
+      # Make sure the importer can see everything they brought in, including
+      # boards that were restricted on the original account.
+      account.boards.find_each { |board| board.accesses.grant_to(owner) }
+    end
+
+    def importer_name
+      identity.users.find_by(account: account)&.name.presence || identity.email_address
+    end
+
+    def file_attached
+      errors.add(:file, "can't be blank") unless file.attached?
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..54fba4a
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,51 @@
+# Reads a ZIP archive produced by ZipFile::Writer (or any other ZIP tool).
+#
+# Used by account imports, where the archive is supplied by the user, so this
+# is backed by rubyzip rather than ZipKit::FileReader (which explicitly warns
+# against reading untrusted archives). rubyzip validates entry sizes while
+# extracting, which protects against ZIP bombs.
+class ZipFile::Reader
+  class Error < StandardError; end
+
+  def self.open(path, &block)
+    new(path).open(&block)
+  end
+
+  def initialize(path)
+    @path = path
+  end
+
+  def open
+    Zip::File.open(@path) do |zip|
+      @zip = zip
+      yield self
+    end
+  rescue ::Zip::Error => error
+    raise Error, "The uploaded file could not be read as a ZIP archive (#{error.message})"
+  ensure
+    @zip = nil
+  end
+
+  def glob(pattern)
+    zip.entries.map(&:name).select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    zip.find_entry(path).present?
+  end
+
+  def read(path)
+    if entry = zip.find_entry(path)
+      entry.get_input_stream(&:read)
+    end
+  end
+
+  def open_entry(path, &block)
+    if entry = zip.find_entry(path)
+      entry.get_input_stream(&block)
+    end
+  end
+
+  private
+    attr_reader :zip
+end
