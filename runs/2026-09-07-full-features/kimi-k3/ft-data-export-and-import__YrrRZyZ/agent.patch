+++ b/app/models/account/data_transfer/account_record_set.rb
@@ -3,9 +3,39 @@ class Account::DataTransfer::AccountRecordSet < Account::DataTransfer::RecordSet
     super(account: account, model: Account)
   end
 
+  # The account itself is created by hand rather than inserted: it needs a
+  # fresh external_account_id, a new join code, and an owner that belongs to
+  # the person importing (added later by the Import).
+  def import_from(zip, translation)
+    if row = read_account_row(zip)
+      account = Account.create! \
+        name: row["name"],
+        cards_count: row["cards_count"] || 0,
+        created_at: row["created_at"] || Time.current
+
+      # A freshly created account comes with a default entropy configuration.
+      # The exported one is imported by the entropy record set, so make room.
+      account.entropy&.destroy!
+
+      translation.account = account
+      translation.remember row["id"], account.id
+    else
+      raise Account::DataTransfer::InvalidArchiveError, "The archive doesn't look like a Fizzy account export"
+    end
+  end
+
   private
     def records
-      [ account ]
+      Account.where(id: account.id)
     end
 
+    def read_account_row(zip)
+      if path = zip.glob("#{model_dir}/*.json").first
+        begin
+          JSON.parse(zip.read(path))
+        rescue JSON::ParserError => error
+          raise Account::DataTransfer::InvalidArchiveError, "The archive contains an invalid account record (#{error.message})"
+        end
+      end
+    end
 end
diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..967f7a1 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -8,4 +8,40 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def translate_attributes(row, translation)
+      super.tap do |translated|
+        translated["body"] = rewrite_embedded_blob_sgids(translated["body"], translation)
+      end
+    end
+
+    # Rich text bodies refer to their embedded attachments by signed global ID.
+    # Those sgids point at the old blobs, so rewrite them to the freshly
+    # imported ones. Best effort: anything we can't make sense of is left alone.
+    def rewrite_embedded_blob_sgids(body, translation)
+      return body unless body.is_a?(String)
+
+      body.gsub(/sgid="([^"]+)"/) do |match|
+        if new_blob = translated_blob($1, translation)
+          %(sgid="#{new_blob.attachable_sgid}")
+        else
+          match
+        end
+      end
+    end
+
+    def translated_blob(sgid, translation)
+      if blob_id = extract_blob_id(sgid)
+        ::ActiveStorage::Blob.find_by(id: translation.translate(blob_id))
+      end
+    end
+
+    # An attachable sgid is a base64-encoded, signed JSON document carrying the
+    # blob's global ID: {"_rails":{"data":"gid://fizzy/ActiveStorage::Blob/<id>",...}}
+    def extract_blob_id(sgid)
+      payload = Base64.urlsafe_decode64(sgid.split("--").first.to_s)
+      gid = JSON.parse(payload).dig("_rails", "data").to_s
+      gid[%r{ActiveStorage::Blob/([0-9a-z]+)}, 1]
+    rescue ArgumentError, JSON::ParserError
+      nil
+    end
 end
