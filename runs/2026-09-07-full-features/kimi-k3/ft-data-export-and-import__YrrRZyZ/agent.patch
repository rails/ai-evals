diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..68de0a4
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "account export contains every record as JSON plus attached files" do
+    account = accounts(:"37s")
+    user = users(:jason)
+
+    export = account.exports.create!(user: user, kind: :account)
+    export.process
+
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert_match /\.zip\z/, export.file.filename.to_s
+
+    with_zip_read(export) do |zip|
+      # every board, card, and comment is exported as JSON
+      assert_equal account.boards.count, zip.glob("boards/*.json").size
+      assert_equal account.cards.count, zip.glob("cards/*.json").size
+      assert_equal Comment.where(account: account).count, zip.glob("comments/*.json").size
+      assert_equal account.users.count, zip.glob("users/*.json").size
+
+      card = account.cards.first
+      card_json = JSON.parse(zip.read("cards/#{card.id}.json"))
+      assert_equal card.title, card_json["title"]
+
+      # the export's own zip is not part of the export
+      blob_ids = zip.glob("active_storage_blobs/*.json").map { |path| JSON.parse(zip.read(path))["id"] }
+      assert_not_includes blob_ids, export.file.blob.id
+    end
+  end
+
+  test "cards export contains the cards the user can see with their comments and files" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+
+    Current.user = users(:david)
+    card = board.cards.create!(creator: users(:david), title: "Export me", status: "published", description: "<p>Some description</p>")
+    card.comments.create!(creator: users(:jz), body: "<p>A comment</p>")
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("pretend image"), filename: "image.png", content_type: "image/png")
+    card.image.attach(blob)
+
+    export = account.exports.create!(user: users(:david), kind: :cards)
+    export.process
+
+    with_zip_read(export) do |zip|
+      exported_cards = zip.glob("cards/*.json").map { |path| JSON.parse(zip.read(path)) }
+      exported_card = exported_cards.find { |attributes| attributes["title"] == "Export me" }
+
+      assert exported_card, "expected the card to be exported"
+      assert_includes exported_card["description"], "Some description"
+      assert_equal 1, exported_card["comments"].size
+      assert_includes exported_card["comments"].first["body"], "A comment"
+      assert_equal "JZ", exported_card["comments"].first["creator"]
+
+      assert_equal [ "files/#{blob.key}" ], zip.glob("files/*")
+      assert_equal "pretend image", zip.read("files/#{blob.key}")
+    end
+  end
+
+  test "cards export only includes cards on boards the user can see" do
+    account = accounts(:"37s")
+
+    # the "private" board is restricted to kevin
+    Current.user = users(:kevin)
+    boards(:private).cards.create!(creator: users(:kevin), title: "Hidden from David", status: "published")
+
+    export = account.exports.create!(user: users(:david), kind: :cards)
+    export.process
+
+    with_zip_read(export) do |zip|
+      exported_titles = zip.glob("cards/*.json").map { |path| JSON.parse(zip.read(path))["title"] }
+      assert_not_includes exported_titles, "Hidden from David"
+    end
+  end
+
+  test "download token expires after a day" do
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    token = export.download_token
+
+    assert_equal export, Export.find_by_download_token(token)
+
+    travel 1.day + 1.minute do
+      assert_nil Export.find_by_download_token(token)
+    end
+  end
+
+  test "creating an export enqueues the export job" do
+    assert_enqueued_with job: Account::ExportJob do
+      accounts(:"37s").exports.create!(user: users(:jason), kind: :account).process_later
+    end
+  end
+
+  test "processing an export emails the requester" do
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+
+    assert_enqueued_emails 1 do
+      perform_enqueued_jobs only: Account::ExportJob do
+        export.process_later
+      end
+    end
+  end
+
+  private
+    def with_zip_read(export)
+      export.file.open do |tempfile|
+        ZipFile::Reader.open(tempfile.path) do |zip|
+          yield zip
+        end
+      end
+    end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..c8d9d96
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,191 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source = accounts(:"37s")
+    @importer = identities(:jason)
+  end
+
+  test "importing an account export brings back boards, cards, comments, files, and people" do
+    card = @source.cards.published.first
+    image_blob = attach_file_to card, "moon.jpg"
+    embedded_blob = embed_file_in card, "hello.txt", "say hello"
+
+    export = export_account(@source)
+    import = build_import(export)
+
+    assert_difference -> { Account.count }, 1 do
+      import.process
+    end
+
+    new_account = import.reload.imported_account
+    assert_not_equal @source, new_account
+    assert_equal @source.name, new_account.name
+
+    assert_equal @source.boards.count, new_account.boards.count
+    assert_equal @source.cards.count, new_account.cards.count
+    assert_equal Comment.where(account: @source).count, Comment.where(account: new_account).count
+    assert_equal @source.users.count + 1, new_account.users.count # imported people + the importer
+    assert_equal transferable_blob_count(@source), ActiveStorage::Blob.where(account: new_account).count
+
+    # cards keep their numbers, so new cards continue the sequence
+    assert_equal @source.cards_count, new_account.cards_count
+
+    # imported people aren't linked to any identity
+    imported_people = new_account.users.where.not(id: new_account.users.find_by(identity: @importer).id)
+    assert imported_people.any?
+    assert imported_people.all? { |user| user.identity.nil? }
+
+    # the importer gets in as an owner named like on the account they imported from
+    owner = new_account.users.find_by(identity: @importer)
+    assert owner.owner?
+    assert_equal "Jason", owner.name
+
+    # and they can see every board, even ones that were restricted
+    assert new_account.boards.all? { |board| board.accessible_to?(owner) }
+
+    # the imported account still has a system user
+    assert_equal "System", new_account.system_user.name
+
+    # card contents and comments survived the trip
+    imported_card = new_account.cards.find_by(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert_equal card.comments.count, imported_card.comments.count
+
+    # files are downloadable from the new account under fresh keys
+    imported_image = ActiveStorage::Blob.where(account: new_account).find_by(filename: "moon.jpg")
+    assert imported_image, "expected moon.jpg to be imported"
+    assert_not_equal image_blob.key, imported_image.key
+    assert_equal image_blob.download, imported_image.download
+    assert imported_card.image.attached?
+
+    # history and metadata came along too
+    assert_equal Event.where(account: @source).count, Event.where(account: new_account).count
+    assert_equal Notification.where(account: @source).count, Notification.where(account: new_account).count
+    assert_equal @source.tags.count, new_account.tags.count
+    assert_equal Reaction.where(account: @source).count, Reaction.where(account: new_account).count
+    assert_equal Column.where(account: @source).count, new_account.columns.count
+    
+    # files embedded in rich text point at the imported blobs
+
+    imported_embed = ActiveStorage::Blob.where(account: new_account).find_by(filename: "hello.txt")
+    assert imported_embed, "expected hello.txt to be imported"
+    assert_equal embedded_blob.download, imported_embed.download
+    assert_includes imported_card.description.body.to_s, imported_embed.attachable_sgid
+  end
+
+  test "importing an export back into the same instance doesn't touch the source account" do
+    export = export_account(@source)
+    import = build_import(export)
+
+    assert_no_difference -> { @source.boards.reload.count } do
+      assert_no_difference -> { @source.cards.reload.count } do
+        import.process
+      end
+    end
+  end
+
+  test "successful import emails the importer with a link to the new account" do
+    export = export_account(@source)
+    import = build_import(export)
+
+    perform_enqueued_jobs do
+      import.process
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @importer.email_address ], mail.to
+    assert_match /import is ready/i, mail.subject
+    assert_match %r{#{import.reload.imported_account.slug}}, mail.text_part.body.to_s
+  end
+
+  test "importing a file that isn't a zip fails and leaves nothing behind" do
+    import = Current.account.imports.new(identity: @importer)
+    import.file.attach io: StringIO.new("this is no zip"), filename: "broken.zip", content_type: "application/zip"
+    import.save!
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Board.count } do
+        perform_enqueued_jobs do
+          import.process
+        end
+      end
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ @importer.email_address ], mail.to
+    assert_match /failed/i, mail.subject
+    assert_match /could not be read as a ZIP archive/, mail.text_part.body.to_s
+
+    assert_nil import.reload.imported_account
+  end
+
+  test "importing a zip that isn't a Fizzy export fails and leaves nothing behind" do
+    tempfile = Tempfile.new([ "not-fizzy", ".zip" ])
+    Zip::File.open(tempfile.path, create: true) { |zip| zip.get_output_stream("hello.txt") { |io| io.write "hi" } }
+
+    import = Current.account.imports.new(identity: @importer)
+    import.file.attach io: File.open(tempfile.path), filename: "not-fizzy.zip", content_type: "application/zip"
+    import.save!
+
+    assert_no_difference -> { Account.count } do
+      perform_enqueued_jobs do
+        import.process
+      end
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_match /failed/i, mail.subject
+    assert_match /doesn't look like a Fizzy account export/, mail.text_part.body.to_s
+  ensure
+    tempfile&.close!
+  end
+
+  test "an import requires a file" do
+    import = Current.account.imports.build(identity: @importer)
+
+    assert_not import.valid?
+    assert import.errors[:file].any?
+  end
+
+  private
+    def export_account(account)
+      account.exports.create!(user: users(:jason), kind: :account).tap(&:process)
+    end
+
+    def build_import(export)
+      export.file.open do |tempfile|
+        Current.account.imports.new(identity: @importer).tap do |import|
+          import.file.attach io: File.open(tempfile.path), filename: "export.zip", content_type: "application/zip"
+          import.save!
+        end
+      end
+    end
+
+    def transferable_blob_count(account)
+      internal_blob_ids = ActiveStorage::Attachment.where(account: account, record_type: %w[Export Import]).select(:blob_id)
