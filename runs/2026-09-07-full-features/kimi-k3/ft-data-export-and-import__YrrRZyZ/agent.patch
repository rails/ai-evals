diff --git a/app/models/account/data_transfer/translation.rb b/app/models/account/data_transfer/translation.rb
new file mode 100644
index 0000000..a3b1f73
--- /dev/null
+++ b/app/models/account/data_transfer/translation.rb
@@ -0,0 +1,55 @@
+# Tracks the translation of record IDs and blob keys while importing an
+# account export into a freshly created account.
+#
+# Every imported record gets a brand new ID so that an archive can be imported
+# back into the same instance it was exported from without colliding with the
+# original records. Foreign keys are translated through the same map: the first
+# time an ID is seen -- either as a record's own ID or as a reference from
+# another record -- a replacement is generated and reused, so references
+# resolve no matter which record set runs first.
+class Account::DataTransfer::Translation
+  # The account being imported into. Assigned once the account record itself
+  # has been imported.
+  attr_accessor :account
+
+  # Keys of blobs uploaded to the storage service during the import. Tracked so
+  # they can be cleaned up when an import can't be completed.
+  attr_reader :uploaded_blob_keys
+
+  def initialize
+    @ids = {}
+    @blob_keys = {}
+    @uploaded_blob_keys = []
+  end
+
+  def translate(old_id)
+    return if old_id.nil?
+
+    @ids[old_id] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def remember(old_id, new_id)
+    @ids[old_id] = new_id
+  end
+
+  def translate_blob_key(old_key)
+    return if old_key.nil?
+
+    @blob_keys[old_key] ||= ActiveStorage::Blob.generate_unique_secure_token
+  end
+
+  def blob_key_for(old_key)
+    @blob_keys[old_key]
+  end
+
+  # Best-effort cleanup of files that were already uploaded to the storage
+  # service when an import fails. Database records are rolled back by the
+  # surrounding transaction; the service has no such luxury.
+  def cleanup_uploads
+    uploaded_blob_keys.each do |key|
+      ActiveStorage::Blob.service.delete(key)
+    rescue => error
+      Rails.logger.error "Failed to clean up blob #{key} after a failed import: #{error.message}"
+    end
+  end
+end
