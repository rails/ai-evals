+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    sign_in_as users(:jason)
+  end
+
+  test "account settings shows the export button to admins" do
+    get account_settings_url
+  
+    assert_response :success
+    assert_select "form[action=?]", account_export_path
+  end
+  
+  test "account settings doesn't show the export button to members" do
+    logout_and_sign_in_as users(:david)
+  
+    get account_settings_url
+  
+    assert_response :success
+    assert_select "form[action=?]", account_export_path, count: 0
+  end
+  
+  test "admins can request an account export" do
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with job: Account::ExportJob do
+        post account_export_url
+      end
+    end
+
+    export = Export.order(:created_at).last
+    assert export.account?
+    assert_equal users(:jason), export.user
+    assert_redirected_to account_settings_path
+  end
+
+  test "exporting emails a download link once the export is ready" do
+    perform_enqueued_jobs do
+      post account_export_url
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ users(:jason).identity.email_address ], mail.to
+    assert_match /export is ready/i, mail.subject
+    assert_match %r{/exports/}, mail.text_part.body.to_s
+  end
+
+  test "members cannot request an account export" do
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Export.count } do
+      post account_export_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "requesting an export requires authentication" do
+    sign_out
+
+    assert_no_difference -> { Export.count } do
+      post account_export_url
+    end
+
+    assert_response :redirect
+  end
+end
