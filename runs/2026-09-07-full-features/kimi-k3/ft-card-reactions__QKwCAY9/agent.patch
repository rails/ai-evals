+require "test_helper"
+
+class CardReactionViewsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail view includes reactions UI" do
+    get card_path(@card)
+    assert_response :success
+    assert_select "turbo-frame[id=?]", dom_id(@card, :reacting) do
+      assert_select "a[href=?]", new_card_reaction_path(@card)
+    end
+  end
+
+  test "card detail view renders existing card reactions" do
+    @card.reactions.create!(content: "🚀", reacter: users(:david))
+
+    get card_path(@card)
+    assert_response :success
+    assert_select ".reaction span", "🚀"
+  end
+
+  test "new reaction form renders with emoji menu" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "form.reaction__form"
+    assert_select ".reaction__emoji-list"
+  end
+
+  test "card previews show boost count when non-zero" do
+    @card.reactions.create!(content: "🚀", reacter: users(:david))
+    @card.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+    assert_select "##{dom_id(@card, :article)} .card__boosts" do
+      assert_select "strong", "2"
+    end
+  end
+
+  test "card previews omit boost count when zero" do
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+    assert_select "##{dom_id(@card, :article)} .card__boosts", count: 0
+  end
+
+  test "full reaction flow" do
+    post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "🚀" } }
+    assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+
+    reaction = @card.reactions.last
+    assert_equal "🚀", reaction.content
+    assert_equal users(:david), reaction.reacter
+
+    get board_column_path(@card.board, @card.column)
+    assert_select "##{dom_id(@card, :article)} .card__boosts strong", "1"
+
+    delete card_reaction_path(@card, reaction, format: :turbo_stream)
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+
+    get board_column_path(@card.board, @card.column)
+    assert_select "##{dom_id(@card, :article)} .card__boosts", count: 0
+  end
+
+  test "draft card page renders without reactions UI" do
+    card = users(:david).draft_new_card_in(boards(:writebook))
+    card.save!
+
+    get card_draft_path(card)
+    assert_response :success
+    assert_select "turbo-frame[id=?]", dom_id(card, :reacting), count: 0
+  end
+
+  test "closed card shows reactions UI" do
+    @card.close(user: users(:david))
+
+    get card_path(@card)
+    assert_response :success
+    assert_select "turbo-frame[id=?]", dom_id(@card, :reacting)
+  end
+end
