diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..cd9660e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,61 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw UTC timestamp, which the browser
+  # rewrites in the viewer's own timezone (see the local-time Stimulus controller).
+  # No clock in the server's timezone is baked into the HTML, so pages stay
+  # shareable and cacheable across timezones. The element's text is a UTC
+  # fallback for clients without JavaScript.
+  def local_time_tag(time, format = "datetime", **options)
+    if time
+      tag.time(local_time_fallback_text(time, format), **local_time_tag_options(time.utc.iso8601, format, options))
+    end
+  end
+
+  # Like +local_time_tag+, but for calendar dates (e.g. day-timeline headers).
+  # The date travels as YYYY-MM-DD so the browser renders the exact day it was
+  # given, with no shifting across timezone boundaries.
+  def local_date_tag(date, format = "weekdayDate", **options)
+    if date
+      tag.time(local_date_fallback_text(date), **local_time_tag_options(date.to_date.iso8601, format, options))
+    end
+  end
+
+  # Data attributes that let the local-time controller render a timestamp into
+  # an attribute of an element instead of its text (e.g. a native bridge
+  # description consumed outside the page).
+  def local_time_data(time, format = "datetime", attribute:)
+    if time
+      {
+        local_time_datetime_value: time.utc.iso8601,
+        local_time_format_value: format,
+        local_time_attribute_value: attribute
+      }
+    else
+      {}
+    end
+  end
+
+  private
+    def local_time_tag_options(datetime, format, options)
+      data = options.delete(:data) || {}
+      data[:controller] = token_list(data[:controller], "local-time")
+      data[:local_time_format_value] = format
+      options[:datetime] = datetime
+      options[:data] = data
+      options
+    end
+
+    # The fallback never attempts to be relative -- it would go stale inside
+    # cached fragments. It only ever approximates the absolute formats, in UTC.
+    def local_time_fallback_text(time, format)
+      case format
+      when "time"                 then time.utc.strftime("%-l:%M %p UTC")
+      when "date", "dateWithYear" then time.utc.strftime("%b %-d, %Y")
+      when "weekdayDate"          then time.utc.strftime("%A, %B %-d, %Y")
+      else                             time.utc.strftime("%b %-d, %Y, %-l:%M %p UTC")
+      end
+    end
+
+    def local_date_fallback_text(date)
+      date.to_date.strftime("%A, %B %-d, %Y")
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..fd8eb8c
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatCalendarDate, formatTimestamp } from "helpers/date_helpers"
+
+const RELATIVE_TIME_REFRESH_INTERVAL = 60_000 // 1 minute in milliseconds
+
+// Rewrites a raw timestamp into words in the viewer's timezone, so the server
+// can cache and share the same HTML with everyone. The timestamp comes from the
+// element's `datetime` attribute (<time> elements) or from
+// `data-local-time-datetime-value`, and the words go into the element's text --
+// or into the attribute named by `data-local-time-attribute-value` when the text
+// is consumed elsewhere (e.g. a native bridge description).
+export default class extends Controller {
+  static values = {
+    datetime: String,
+    format: { type: String, default: "datetime" },
+    attribute: String
+  }
+
+  initialize() {
+    this.render = this.render.bind(this)
+  }
+
+  connect() {
+    this.render()
+
+    // A page refresh morphs the fallback text back in from the server; rewrite it.
+    document.addEventListener("turbo:morph", this.render)
+
+    if (this.formatValue === "relative") {
+      this.timer = setInterval(this.render, RELATIVE_TIME_REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    document.removeEventListener("turbo:morph", this.render)
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = this.#date
+    if (!date) return
+
+    const text = this.#isCalendarDate ? formatCalendarDate(date, this.formatValue) : formatTimestamp(date, this.formatValue)
+
+    if (this.hasAttributeValue) {
+      if (this.element.getAttribute(this.attributeValue) !== text) {
+        this.element.setAttribute(this.attributeValue, text)
+      }
+    } else if (this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+  }
+
+  get #date() {
+    const value = this.#timestampValue
+    if (!value) return null
+
+    if (this.#isCalendarDate) {
+      const [ year, month, day ] = value.split("-").map(Number)
+      return new Date(year, month - 1, day, 12) // midday so DST transitions can't shift the date
+    } else {
+      const date = new Date(value)
+      return isNaN(date) ? null : date
+    }
+  }
+
+  get #timestampValue() {
+    return this.hasDatetimeValue ? this.datetimeValue : this.element.getAttribute("datetime")
+  }
+
+  get #isCalendarDate() {
+    return /^\d{4}-\d{2}-\d{2}$/.test(this.#timestampValue || "")
+  }
+}
