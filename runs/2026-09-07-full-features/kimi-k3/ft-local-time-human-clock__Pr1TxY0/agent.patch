@@ -0,0 +1,67 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "comment timestamps are rendered by the browser, not the server" do
+    sign_in_as(users(:david))
+
+    comment = comments(:logo_agreement_jz) # created 2 days ago
+    visit card_url(comment.card)
+
+    within "##{dom_id(comment)}" do
+      # The server sends the raw UTC timestamp...
+      element = find("time[data-controller='local-time'][datetime='#{comment.created_at.utc.iso8601}']")
+
+      # ...and the browser turns it into relative words
+      assert_match(/\A2 days ago\z/i, element.text)
+    end
+  end
+
+  test "a comment from moments ago reads as the time of day" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+    fill_in_lexxy with: "Hello from the browser"
+    click_on "Post"
+
+    assert_selector "time[data-controller='local-time'][data-local-time-format-value='relative']", text: /\d{1,2}:\d{2} (AM|PM)/
+  end
+
+  test "old comments render as absolute dates" do
+    sign_in_as(users(:david))
+
+    comment = comments(:logo_1) # created 1 week ago, collapsed into the comment history
+    visit card_url(comment.card)
+
+    element = find("##{dom_id(comment)} time[data-controller='local-time']", visible: :all)
+    assert_match(/\A[A-Z][a-z]{2} \d{1,2}(, \d{4})?\z/, element.text(:all)) # "Sep 1" or "Sep 1, 2026"
+  end
+
+  test "page morph refreshes restore localized times" do
+  sign_in_as(users(:david))
+
+  comment = comments(:logo_agreement_jz)
+  visit card_url(comment.card)
+
+  selector = "time[datetime='#{comment.created_at.utc.iso8601}']"
+  assert_selector selector, text: /\A2 days ago\z/i
+
+  # A broadcasted refresh morphs fresh server HTML with the UTC fallback back in...
+  page.execute_script(<<~JS)
+    const el = document.querySelector("#{selector}")
+    el.textContent = "#{comment.created_at.utc.strftime("%b %-d, %Y, %-l:%M %p UTC")}"
+    document.documentElement.dispatchEvent(new CustomEvent("turbo:morph", { bubbles: true }))
+  JS
+
+  # ...and the controller rewrites it in the viewer's timezone again
+  assert_selector selector, text: /\A2 days ago\z/i
+end
+
+test "card meta renders relative times" do
+    sign_in_as(users(:david))
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".card__meta-text--added time[data-controller='local-time'][data-local-time-format-value='relative']"
+    assert_selector ".card__meta-text--updated time[data-controller='local-time'][data-local-time-format-value='relative']"
+  end
+end
