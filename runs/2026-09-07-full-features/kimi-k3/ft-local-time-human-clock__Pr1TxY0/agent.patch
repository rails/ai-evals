diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..733b295
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include TimeHelper
+
+  test "local_time_tag sends the raw UTC timestamp for the browser to render" do
+    time = Time.utc(2026, 9, 6, 7, 42, 26)
+
+    tag = local_time_tag(time, "relative")
+
+    assert_equal %(<time datetime="2026-09-06T07:42:26Z" data-controller="local-time" data-local-time-format-value="relative">Sep 6, 2026, 7:42 AM UTC</time>), tag
+  end
+
+  test "local_time_tag carries no server-timezone words" do
+    time = Time.zone.parse("2026-09-06 07:42:26")
+
+    tag = local_time_tag(time, "time", class: "event__timestamp")
+
+    assert_includes tag, %(datetime="2026-09-06T07:42:26Z")
+    assert_includes tag, %(class="event__timestamp")
+    assert_includes tag, %(data-local-time-format-value="time")
+    assert_includes tag, ">7:42 AM UTC</time>"
+  end
+
+  test "local_time_tag merges with other controllers" do
+    tag = local_time_tag(Time.utc(2026, 9, 6), "date", data: { controller: "tooltip", action: "click->tooltip#show" })
+
+    assert_includes tag, %(data-controller="tooltip local-time")
+    assert_includes tag, %(data-action="click-&gt;tooltip#show")
+  end
+
+  test "local_time_tag returns nil without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "local_date_tag sends a plain calendar date that cannot shift across timezones" do
+    tag = local_date_tag(Time.zone.parse("2026-09-06 00:00:00"), "weekdayDate", class: "txt-capitalize")
+
+    assert_includes tag, %(datetime="2026-09-06")
+    assert_includes tag, %(class="txt-capitalize")
+    assert_includes tag, %(data-local-time-format-value="weekdayDate")
+    assert_includes tag, ">Sunday, September 6, 2026</time>"
+  end
+
+  test "local_time_data renders into an attribute instead of element text" do
+    time = Time.utc(2026, 9, 6, 7, 42, 26)
+
+    assert_equal({
+      local_time_datetime_value: "2026-09-06T07:42:26Z",
+      local_time_format_value: "dateWithYear",
+      local_time_attribute_value: "data-bridge-description"
+    }, local_time_data(time, "dateWithYear", attribute: "data-bridge-description"))
+
+    assert_equal({}, local_time_data(nil, "date", attribute: "data-bridge-description"))
+  end
+end
diff --git a/test/integration/local_time_rendering_test.rb b/test/integration/local_time_rendering_test.rb
new file mode 100644
index 0000000..280402f
--- /dev/null
+++ b/test/integration/local_time_rendering_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "times are sent as raw timestamps for the browser to render" do
+    comment = comments(:logo_agreement_jz)
+
+    get card_path(comment.card)
+    assert_response :success
+
+    # The server sends the raw UTC timestamp and lets the browser do the talking...
+    assert_select %(time[data-controller="local-time"][data-local-time-format-value="relative"][datetime="#{comment.created_at.utc.iso8601}"])
+
+    # ...instead of baking a clock into the HTML in some server's timezone
+    assert_no_match comment.created_at.strftime("%A, %B %-d"), @response.body
+    assert_no_match comment.created_at.strftime("%A, %B %-d, %l:%M %p").strip, @response.body
+  end
+
+  test "rendered times are identical no matter which timezone asks" do
+    card = cards(:logo)
+
+    cookies[:timezone] = "UTC"
+    get card_path(card)
+    utc_times = @response.body.scan(/<time\b[^>]*>[^<]*<\/time>/)
+
+    cookies[:timezone] = "Pacific/Auckland"
+    get card_path(card)
+    auckland_times = @response.body.scan(/<time\b[^>]*>[^<]*<\/time>/)
+
+    assert_not_empty utc_times
+    assert_equal utc_times, auckland_times
+  end
+
+  test "day timeline headers travel as plain calendar dates that cannot shift across timezones" do
+    get events_path(day: 2.days.ago.to_date)
+    assert_response :success
+
+    assert_select %(time[data-controller="local-time"][data-local-time-format-value="weekdayDate"]) do |elements|
+      assert_not_empty elements
+      elements.each { assert_match /\A\d{4}-\d{2}-\d{2}\z/, it["datetime"] }
+    end
+  end
+
+  test "entropy data attributes serialize in canonical UTC so markup stays shareable" do
+    cookies[:timezone] = "UTC"
+    get card_path(cards(:logo))
+    utc_bubbles = @response.body.scan(/data-bubble-entropy-value="[^"]*"/)
+
+    cookies[:timezone] = "Pacific/Auckland"
+    get card_path(cards(:logo))
+    auckland_bubbles = @response.body.scan(/data-bubble-entropy-value="[^"]*"/)
+
+    assert_not_empty utc_bubbles
+    assert_equal utc_bubbles, auckland_bubbles
+  end
+end
diff --git a/test/system/local_time_formats_test.rb b/test/system/local_time_formats_test.rb
new file mode 100644
index 0000000..67c4c89
--- /dev/null
+++ b/test/system/local_time_formats_test.rb
@@ -0,0 +1,119 @@
+require "application_system_test_case"
+
+# Exercises the local-time controller's formatting against injected <time>
+# elements, covering the relative/absolute calendar edges.
+class LocalTimeFormatsTest < ApplicationSystemTestCase
+  test "browser renders each format in the viewer's timezone" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    {
+      "2 hours ago"     => [ 2.hours.ago, /\A\d{1,2}:\d{2} (AM|PM)\z/ ],
+      "last night"      => [ 1.day.ago, /\Ayesterday\z/ ],
+      "5 days ago"      => [ 5.days.ago, /\A5 days ago\z/ ],
+      "2 weeks ago"     => [ 2.weeks.ago, /\A[A-Z][a-z]{2} \d{1,2}(, \d{4})?\z/ ],
+      "last year"       => [ 1.year.ago, /\A[A-Z][a-z]{2} \d{1,2}, \d{4}\z/ ],
+      "later today"     => [ 2.hours.from_now, /\Atoday\z/ ],
+      "overnight"       => [ 1.day.from_now, /\Atomorrow\z/ ],
+      "in 3 days"       => [ 3.days.from_now, /\Ain 3 days\z/ ],
+      "in 2 weeks"      => [ 12.days.from_now, /\Ain 2 weeks\z/ ],
+      "in 2 months"     => [ 50.days.from_now, /\Ain 2 months\z/ ]
+    }.each_with_index do |(name, (time, pattern)), index|
+      page.execute_script(<<~JS)
+        const el = document.createElement("time")
+        el.id = "case-#{index}"
+        el.setAttribute("data-controller", "local-time")
+        el.setAttribute("data-local-time-format-value", "relative")
+        el.setAttribute("datetime", "#{time.utc.iso8601}")
+        el.textContent = "fallback"
+        document.body.appendChild(el)
+      JS
+
+      assert_selector "time#case-#{index}", text: pattern, normalize_ws: true
+    end
+  end
+
+  test "absolute formats" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    time = Time.utc(2026, 9, 6, 13, 42)
+
+    {
+      "time"         => /\A\d{1,2}:\d{2} (AM|PM)\z/,
+      "date"         => /\ASep 6(, \d{4})?\z/,
+      "dateWithYear" => /\ASep 6, 2026\z/,
+      "datetime"     => /\ASep 6(, \d{4})?, \d{1,2}:\d{2} (AM|PM)\z/,
+      "weekdayDate"  => /\ASunday, September 6\z/
+    }.each do |format, pattern|
+      page.execute_script(<<~JS)
+        const el = document.createElement("time")
+        el.id = "format-#{format}"
+        el.setAttribute("data-controller", "local-time")
+        el.setAttribute("data-local-time-format-value", "#{format}")
+        el.setAttribute("datetime", "#{time.iso8601}")
+        el.textContent = "fallback"
+        document.body.appendChild(el)
+      JS
+
+      assert_selector "time#format-#{format}", text: pattern
+    end
+  end
+
+  test "calendar dates render the exact day regardless of timezone" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    page.execute_script(<<~JS)
+      const el = document.createElement("time")
+      el.id = "calendar-date"
+      el.setAttribute("data-controller", "local-time")
+      el.setAttribute("data-local-time-format-value", "weekdayDate")
+      el.setAttribute("datetime", "2026-09-06")
+      document.body.appendChild(el)
+    JS
+
+    assert_selector "time#calendar-date", text: "Sunday, September 6"
+  end
+
+  test "missing or invalid timestamps keep the server-rendered fallback" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    page.execute_script(<<~JS)
+      const invalid = document.createElement("time")
+      invalid.id = "invalid"
+      invalid.setAttribute("data-controller", "local-time")
+      invalid.setAttribute("datetime", "not-a-time")
+      invalid.textContent = "fallback"
+      document.body.appendChild(invalid)
+
+      const empty = document.createElement("time")
+      empty.id = "empty"
+      empty.setAttribute("data-controller", "local-time")
+      empty.textContent = "fallback"
+      document.body.appendChild(empty)
+    JS
+
+    assert_selector "time#invalid", text: "fallback"
+    assert_selector "time#empty", text: "fallback"
+  end
+
+  test "attribute mode writes the words into the named attribute" do
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    page.execute_script(<<~JS)
+      const el = document.createElement("div")
+      el.id = "attr-case"
+      el.setAttribute("data-controller", "local-time")
+      el.setAttribute("data-local-time-datetime-value", "#{1.day.from_now.utc.iso8601}")
+      el.setAttribute("data-local-time-format-value", "relative")
+      el.setAttribute("data-local-time-attribute-value", "data-bridge-description")
+      el.textContent = "untouched"
+      document.body.appendChild(el)
+    JS
+
+    assert_selector "div#attr-case[data-bridge-description='tomorrow']", text: "untouched"
+  end
+end
