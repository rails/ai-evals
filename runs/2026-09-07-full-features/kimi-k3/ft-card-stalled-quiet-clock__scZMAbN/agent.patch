@@ -0,0 +1,21 @@
+require "application_system_test_case"
+
+class StalledBubbleTest < ApplicationSystemTestCase
+  test "stalled card shows the stalled bubble" do
+    sign_in_as(users(:david))
+
+    cards(:logo).update!(bursted_at: 15.days.ago)
+
+    visit card_url(cards(:logo))
+    assert_selector ".bubble:not([hidden])", text: /stalled for/i
+  end
+
+  test "bursting but not yet stalled card does not show the stalled bubble" do
+    sign_in_as(users(:david))
+
+    cards(:logo).update!(bursted_at: 1.day.ago)
+
+    visit card_url(cards(:logo))
+    assert_no_selector ".bubble:not([hidden])", text: /stalled for/i
+  end
+end
