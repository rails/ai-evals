diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..62905e9
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ].freeze
+  STALLED_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(bursted_at: nil).where(bursted_at: ..STALLED_PERIOD.ago) }
+  end
+
+  def bursted?
+    bursted_at?
+  end
+
+  def stalled?
+    bursted_at? && bursted_at <= STALLED_PERIOD.ago
+  end
+
+  def register_burst
+    update!(bursted_at: Time.current) if active?
+  end
+
+  def register_burst_for(event)
+    register_burst if event.action.in?(BURST_EVENT_ACTIONS)
+  end
+
+  def register_comment_burst
+    comments_in_window = comments.by_user.where(created_at: burst_window.ago..)
+
+    if comments_in_window.count >= BURST_COMMENT_COUNT && comments_in_window.distinct.count(:creator_id) >= BURST_COMMENTER_COUNT
+      register_burst
+    end
+  end
+
+  private
+    # Comments burst when they land within a third of the board's auto-close period
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+end
