+++ b/test/integration/stalled_cards_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class StalledCardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "stalled cards are listed on the cards index with indexed_by=stalled" do
+    cards(:logo).register_burst
+
+    travel 2.weeks + 1.minute do
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_includes response.body, card_path(cards(:logo))
+      assert_includes response.body, "burstedAt"
+    end
+  end
+
+  test "cards with a burst carry burst data for the bubble wherever they are shown" do
+    cards(:logo).register_burst
+    cards(:buy_domain).register_burst
+
+    get cards_path
+    assert_response :success
+    assert_includes response.body, "burstedAt"
+
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_includes response.body, "burstedAt"
+
+    get board_column_path(boards(:writebook), columns(:writebook_triage))
+    assert_response :success
+    assert_includes response.body, "burstedAt"
+
+    get card_path(cards(:logo))
+    assert_response :success
+    assert_includes response.body, "burstedAt"
+  end
+
+  test "cards without a burst carry no burst data" do
+    get card_path(cards(:layout))
+    assert_response :success
+    assert_not_includes response.body, "burstedAt"
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..7302f8f
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = Card.find(boards(:writebook).cards.create!(title: "Burst test", creator: users(:david), status: "published").id)
+  end
+
+  test "a burst is three or more comments from at least two people" do
+    @card.comments.create!(creator: users(:david), body: "one")
+    @card.comments.create!(creator: users(:kevin), body: "two")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:kevin), body: "three")
+    assert @card.reload.bursted?
+  end
+
+  test "three comments from a single person is not a burst" do
+    3.times { @card.comments.create!(creator: users(:david), body: "solo") }
+    assert_not @card.reload.bursted?
+  end
+
+  test "system comments do not count towards a burst" do
+    2.times { @card.comments.create!(creator: accounts("37s").system_user, body: "system") }
+    @card.comments.create!(creator: users(:david), body: "one")
+    @card.comments.create!(creator: users(:kevin), body: "two")
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments older than a third of the auto-close period do not count towards a burst" do
+    @card.comments.create!(creator: users(:david), body: "old", created_at: 31.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "old", created_at: 31.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "new")
+    assert_not @card.reload.bursted?
+  end
+
+  test "burst window follows the board's auto-close period" do
+    boards(:writebook).update! auto_postpone_period: 3.days
+
+    @card.comments.create!(creator: users(:david), body: "old", created_at: 2.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "old", created_at: 2.days.ago)
+    @card.comments.create!(creator: users(:kevin), body: "new")
+    assert_not @card.reload.bursted?
+
+    @card.comments.create!(creator: users(:david), body: "new one")
+    @card.comments.create!(creator: users(:kevin), body: "new two")
+    assert @card.reload.bursted?
+  end
+
+  test "being assigned is a burst" do
+    @card.toggle_assignment(users(:kevin))
+    assert @card.reload.bursted?
+  end
+
+  test "closed cards do not register bursts" do
+    @card.close(user: users(:david))
+    @card = Card.find(@card.id)
+
+    2.times { @card.comments.create!(creator: users(:david), body: "one") }
+    @card.comments.create!(creator: users(:kevin), body: "two")
+    assert_not @card.reload.bursted?
+
+    @card.toggle_assignment(users(:kevin))
+    assert_not @card.reload.bursted?
+  end
+
+  test "being reopened is a burst" do
+    @card.close(user: users(:david))
+    assert_not @card.reload.bursted?
+
+    @card.reopen(user: users(:david))
+    assert @card.reload.bursted?
+  end
+
+  test "a card with a burst is stalled after two quiet weeks" do
+    @card.register_burst
+    assert_not @card.stalled?
+
+    travel 2.weeks - 1.day do
+      assert_not @card.stalled?
+    end
+
+    travel 2.weeks + 1.minute do
+      assert @card.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    @card.register_burst
+
+    travel 2.weeks + 1.minute do
+      assert @card.stalled?
+
+      @card.comments.create!(creator: users(:kevin), body: "back from the dead")
+      assert_not @card.reload.stalled?
+      assert_not @card.bursted?
+    end
+  end
+
+  test "stalling is not restored by later inactivity without a new burst" do
+    @card.register_burst
+
+    travel 2.weeks + 1.minute do
+      @card.touch_last_active_at
+    end
+
+    travel 4.weeks do
+      assert_not @card.stalled?
+    end
+  end
+
+  test "closing and postponing reset the burst" do
+    @card.register_burst
+
+    @card.close(user: users(:david))
+    assert_not @card.reload.bursted?
+
+    @card.reopen(user: users(:david))
+    assert @card.reload.bursted?
+
+    @card.postpone(user: users(:david))
+    assert_not @card.reload.bursted?
+  end
+
+  test "stalled cards can be listed with indexed_by" do
+    @card.register_burst
+
+    travel 2.weeks + 1.minute do
+      assert_includes Card.indexed_by("stalled"), @card
+      assert_not_includes Card.indexed_by("stalled"), cards(:logo)
+    end
+  end
+end
