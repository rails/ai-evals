+class ActivitiesController < ApplicationController
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from accessible_activities
+      end
+    end
+  end
+
+  private
+    # Same kinds of events as the HTML timeline, except deprecated
+    # +card_collection_changed+ events, and including +card_title_changed+.
+    ACTIVITY_ACTIONS = %w[
+      card_assigned
+      card_unassigned
+      card_published
+      card_closed
+      card_reopened
+      card_board_changed
+      card_postponed
+      card_auto_postponed
+      card_triaged
+      card_sent_back_to_triage
+      card_title_changed
+      comment_created
+    ]
+
+    def accessible_activities
+      activities = Event
+        .preloaded
+        .where(board: Current.user.boards, action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+      activities = activities.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      activities = activities.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      activities
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..4b106e2
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,25 @@
+module ActivitiesHelper
+  # Event-specific details exposed to API clients.
+  def activity_particulars(event)
+    case event.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: event.assignee_ids }
+    when "card_board_changed"
+      { old_board: event.particulars.dig("particulars", "old_board") || "",
+        new_board: event.particulars.dig("particulars", "new_board") || "" }
+    when "card_title_changed"
+      { old_title: event.particulars.dig("particulars", "old_title") || "",
+        new_title: event.particulars.dig("particulars", "new_title") || "" }
+    when "card_triaged"
+      { column: event.particulars.dig("particulars", "column") || "" }
+    else
+      {}
+    end
+  end
+
+  # Card events open the card; comment events open the card where the
+  # comment was posted and jump to that comment.
+  def activity_url(event)
+    polymorphic_url(event.eventable)
+  end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..8587670
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,18 @@
+json.cache! [ event, Current.user ] do
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars activity_particulars(event)
+  json.url activity_url(event)
+  json.eventable_type event.eventable_type
+
+  json.eventable do
+    case event.eventable
+    when Card then json.partial! "cards/card", card: event.eventable
+    when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
