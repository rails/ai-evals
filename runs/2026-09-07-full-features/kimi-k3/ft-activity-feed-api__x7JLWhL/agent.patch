index 0000000..3ef90b8
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,214 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns a flat array of activities, newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert_equal Event.count, activities.count
+
+    created_ats = activities.map { |activity| Time.iso8601(activity["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "activities include the expected attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+    assert_not_nil activity
+
+    assert_equal "card_published", activity["action"]
+    assert_equal events(:logo_published).created_at.utc.as_json, activity["created_at"]
+    assert_equal "David added &quot;The logo isn&#39;t big enough&quot;", activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+  end
+
+  test "activities use the API representations for eventable, board, and creator" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_published).id }
+
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal card_url(cards(:logo)), activity.dig("eventable", "url")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+    assert_equal board_url(boards(:writebook)), activity.dig("board", "url")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+    assert_equal user_url(users(:david)), activity.dig("creator", "url")
+  end
+
+  test "card_collection_changed events are omitted" do
+    cards(:logo).track_event :collection_changed, creator: users(:david),
+      particulars: { old_collection: "Writebook", new_collection: "Private board" }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |a| a["action"] }, "card_collection_changed"
+  end
+
+  test "card_title_changed events are included" do
+    cards(:logo).track_event :title_changed, creator: users(:david),
+      particulars: { old_title: "The logo isn't big enough", new_title: "The logo is too small" }
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_title_changed" }
+    assert_not_nil activity
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "The logo is too small" }, activity["particulars"])
+  end
+
+  test "assignment changes contain assignee_ids in particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_assignment_jz).id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+  end
+
+  test "board changes contain old_board and new_board in particulars" do
+    cards(:logo).track_event :board_changed, creator: users(:david),
+      particulars: { old_board: "Writebook", new_board: "Private board" }
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+  end
+
+  test "triage events contain column in particulars" do
+    cards(:logo).track_event :triaged, creator: users(:david), particulars: { column: "In Progress" }
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_triaged" }
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "missing board, title, and column particulars are returned as empty strings" do
+    cards(:logo).track_event :board_changed, creator: users(:david)
+    cards(:logo).track_event :title_changed, creator: users(:david)
+    cards(:logo).track_event :triaged, creator: users(:david)
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.find { |a| a["action"] == "card_board_changed" }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.find { |a| a["action"] == "card_title_changed" }["particulars"])
+    assert_equal({ "column" => "" }, activities.find { |a| a["action"] == "card_triaged" }["particulars"])
+  end
+
+  test "other events return empty particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:shipping_closed).id }
+    assert_equal "card_closed", activity["action"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "comment activity urls point at the card with a comment anchor" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+
+    comment = comments(:layout_overflowing_david)
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "descriptions are personalized for the current user" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_assignment_david).id }
+    assert_equal "David will handle &quot;The logo isn&#39;t big enough&quot;", activity["description"]
+  end
+
+  test "filtering by creator_ids" do
+    get activities_path, as: :json, params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+
+    activities = @response.parsed_body
+    assert_equal 3, activities.count
+    assert activities.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "filtering by board_ids" do
+    with_current_user :kevin do
+      boards(:private).cards.create!(title: "Secret plan", creator: users(:kevin), status: "published")
+    end
+
+    logout_and_sign_in_as :kevin
+
+    get activities_path, as: :json
+    board_ids = @response.parsed_body.map { |a| a.dig("board", "id") }.uniq
+    assert_includes board_ids, boards(:writebook).id
+    assert_includes board_ids, boards(:private).id
+
+    get activities_path, as: :json, params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [ boards(:private).id ], @response.parsed_body.map { |a| a.dig("board", "id") }.uniq
+  end
+
+  test "only returns activity from boards the current user can access" do
+    with_current_user :kevin do
+      boards(:private).cards.create!(title: "Secret plan", creator: users(:kevin), status: "published")
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal [ boards(:writebook).id ], @response.parsed_body.map { |a| a.dig("board", "id") }.uniq
+    assert_not_includes @response.parsed_body.map { |a| a.dig("eventable", "title") }, "Secret plan"
+
+    logout_and_sign_in_as :kevin
+    get activities_path, as: :json
+
+    assert_includes @response.parsed_body.map { |a| a.dig("eventable", "title") }, "Secret plan"
+  end
+
+  test "index paginates with geared pagination headers" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal Event.count.to_s, @response.headers["X-Total-Count"]
+    assert_nil @response.headers["Link"]
+  end
+
+  test "index follows pagination conventions" do
+    20.times { cards(:logo).track_event :reopened, creator: users(:david) }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal 15, @response.parsed_body.count
+    assert @response.headers["Link"].present?
+
+    get activities_path, as: :json, params: { page: 2 }
+
+    assert_response :success
+    assert_equal Event.count - 15, @response.parsed_body.count
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path, as: :json, env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+
+    assert_response :unauthorized
+  end
+end
