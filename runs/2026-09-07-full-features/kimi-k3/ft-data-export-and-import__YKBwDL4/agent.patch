--- /dev/null
+++ b/app/controllers/exports_controller.rb
@@ -0,0 +1,28 @@
+# Downloads of completed exports. The download links emailed when an export is
+# ready carry a signed id that expires after Export::DOWNLOAD_LINK_EXPIRATION.
+class ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  def show
+    export = Export.find_by_signed_download_id(params[:id])
+
+    if export&.file&.attached?
+      serve_file export.file.blob
+    else
+      head :not_found
+    end
+  end
+
+  private
+    def serve_file(blob)
+      if disk_service?(blob)
+        send_file blob.service.path_for(blob.key), filename: blob.filename.to_s, type: blob.content_type, disposition: "attachment"
+      else
+        redirect_to blob.url(disposition: "attachment"), allow_other_host: true
+      end
+    end
+
+    def disk_service?(blob)
+      blob.service.is_a? ActiveStorage::Service::DiskService
+    end
+end
