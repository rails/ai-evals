@@ -0,0 +1,212 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @source_account = accounts(:"37s")
+    @importing_account = accounts(:initech)
+    @importing_user = users(:mike)  # admin of the initech account
+  end
+
+  test "importing an account export creates a new account with everything in it" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = create_account_export
+    new_account = nil
+
+    assert_difference -> { Account.count }, 1 do
+      new_account = import_export export
+    end
+
+    assert_not_equal @source_account.id, new_account.id
+    assert_equal @source_account.name, new_account.name
+
+    assert_equal @source_account.boards.count, new_account.boards.count
+    assert_equal @source_account.cards.count, new_account.cards.count
+    assert_equal Comment.where(account: @source_account).count, Comment.where(account: new_account).count
+    assert_equal @source_account.users.count, new_account.users.count
+    assert_equal @source_account.tags.count, new_account.tags.count
+    assert_equal @source_account.columns.count, new_account.columns.count
+
+    imported_card = new_account.cards.find_by(number: cards(:logo).number)
+    assert_equal card.title, imported_card.title
+    assert_equal comments(:logo_agreement_jz).body.to_plain_text,
+      imported_card.comments.find_by(creator: new_account.users.find_by(name: "JZ")).body.to_plain_text
+
+    assert imported_card.image.attached?
+    assert_equal card.image.blob.checksum, imported_card.image.blob.checksum
+    assert_equal "moon.jpg", imported_card.image.filename.to_s
+    assert_equal file_fixture("moon.jpg").binread, imported_card.image.download
+  end
+
+  test "imported users are linked to existing identities by email address" do
+    new_account = import_export create_account_export
+
+    imported_david = new_account.users.find_by(name: "David")
+    assert_equal identities(:david), imported_david.identity
+  end
+
+  test "import emails the requester when it completes" do
+    export = create_account_export
+    ActionMailer::Base.deliveries.clear
+
+    assert_emails 1 do
+      import_export export
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @importing_user.identity.email_address ], email.to
+    assert_match "ready", email.subject
+  end
+
+  test "importing a file that is not a zip fails with a reason and leaves nothing behind" do
+    assert_no_difference -> { Account.count } do
+      assert_emails 1 do
+        import_file io: StringIO.new("this is not a zip"), filename: "export.zip"
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "failed", email.subject
+    assert_match "not a ZIP archive", email.body.encoded
+
+    assert_equal 0, Import.count
+  end
+
+  test "importing a zip that is not an account export fails and leaves nothing behind" do
+    cards_export = create_export(kind: :cards, user: users(:david))
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { Card.count } do
+        assert_emails 1 do
+          import_blob cards_export.file.blob
+        end
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "failed", email.subject
+    assert_match "not a Fizzy account export", email.body.encoded
+
+    assert_equal 0, Import.count
+  end
+
+
+  test "imported rich text points at the imported blobs and users" do
+    card = cards(:logo)
+
+    Current.set(user: users(:david)) do
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.update!(description: %Q(<p>Here is the logo <action-text-attachment sgid="#{blob.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg"></action-text-attachment></p>))
+
+      comment = card.comments.create!(creator: users(:david), body: %Q(<p>Hey <action-text-attachment sgid="#{users(:david).attachable_sgid}"></action-text-attachment> what do you think?</p>))
+    end
+
+    old_blob = card.reload.description.embeds.first.blob
+    new_account = import_export create_account_export
+
+    imported_card = new_account.cards.find_by(number: card.number)
+
+    imported_blob = imported_card.description.embeds.first.blob
+    assert_not_equal old_blob.id, imported_blob.id
+    assert_equal "moon.jpg", imported_blob.filename.to_s
+    assert imported_blob.service.exist?(imported_blob.key)
+
+    # The rendered description resolves the imported blob, not the original one
+    rendered = imported_card.description.to_s
+    assert_no_match old_blob.signed_id, rendered
+
+    # Mentions resolve to the imported user
+    imported_comment = imported_card.comments.find_by(creator: new_account.users.find_by(name: "David"))
+    mentioned_user = imported_comment.body.body.attachables.grep(User).first
+    assert_equal new_account.users.find_by(name: "David"), mentioned_user
+  end
+
+  test "import creates identities that do not exist yet" do
+    identity = Identity.create!(email_address: "somebody-new@example.com")
+    account = Account.create_with_owner(account: { name: "Fresh" }, owner: { name: "Somebody New", identity: identity })
+
+    export = nil
+    perform_enqueued_jobs do
+      Current.with_account(account) do
+        export = account.exports.create!(kind: :account, user: account.users.find_by(role: :owner))
+      end
+    end
+
+    identity.destroy # pretend this instance has never seen them
+
+    assert_difference -> { Identity.count }, 1 do
+      new_account = import_export export
+
+      imported_owner = new_account.users.find_by(name: "Somebody New")
+      assert_equal "somebody-new@example.com", imported_owner.identity.email_address
+    end
+  end
+
+  test "imported cards can be found through search" do
+    new_account = import_export create_account_export
+
+    card = new_account.cards.find_by(number: cards(:logo).number)
+    search_record = Search::Record.for(new_account.id).find_by(searchable: card)
+    assert search_record, "expected imported card to be indexed for search"
+  end
+
+
+  test "importing an account with a published board regenerates the publication key" do
+    board = boards(:writebook)
+    board.publish
+    old_key = board.publication.key
+
+    new_account = import_export create_account_export
+
+    imported_board = new_account.boards.find_by(name: board.name)
+    assert imported_board.published?
+    assert_not_equal old_key, imported_board.publication.key
+  end
+
+  test "account exports do not contain previous export files" do
+    first_export = create_account_export
+
+    second_export = nil
+    perform_enqueued_jobs do
+      second_export = @source_account.exports.create!(kind: :account, user: users(:kevin))
+    end
+
+    Zip::File.open(second_export.file.blob.service.path_for(second_export.file.blob.key)) do |zip|
+      assert_empty zip.glob("files/*/*").map(&:name).select { |name| name.include?("export") }
+    end
+  end
+
+  private
+    def create_account_export
+      create_export(kind: :account, user: users(:kevin))
+    end
+
+    def create_export(kind:, user:)
+      export = nil
+      perform_enqueued_jobs do
+        export = @source_account.exports.create!(kind: kind, user: user)
+      end
+      export
+    end
+
+    def import_export(export)
+      existing_account_ids = Account.ids
+      import_blob export.file.blob
+      Account.where.not(id: existing_account_ids).first
+    end
+
+    def import_blob(blob)
+      import_file io: File.open(blob.service.path_for(blob.key)), filename: "export.zip"
+    end
+
+    def import_file(io:, filename:)
+      perform_enqueued_jobs do
+        Current.with_account(@importing_account) do
+          @importing_account.imports.create!(user: @importing_user, file: { io: io, filename: filename, content_type: "application/zip" })
+        end
+      end
+    end
+end
