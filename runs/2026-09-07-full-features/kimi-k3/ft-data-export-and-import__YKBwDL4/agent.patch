diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..466a4ed
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "account export produces a zip with all the account data" do
+    export = create_export(kind: :account)
+
+    with_zip(export) do |zip|
+      assert zip.find_entry("manifest.json")
+      assert zip.glob("accounts/*.json").any?
+      assert zip.glob("users/*.json").any?
+      assert zip.glob("boards/*.json").any?
+      assert zip.glob("cards/*.json").any?
+      assert zip.glob("comments/*.json").any?
+    end
+  end
+
+  test "account export includes attached files" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = create_export(kind: :account)
+
+    with_zip(export) do |zip|
+      assert_equal [ "files/#{card.image.blob.id}/moon.jpg" ], zip.glob("files/*/*").map(&:name)
+    end
+  end
+
+  test "cards export contains the cards the user can see as JSON with their comments" do
+    export = create_export(kind: :cards)
+
+    data = with_zip(export) { |zip| JSON.parse zip.read("cards.json") }
+
+    expected_cards = @user.accessible_cards.published
+    assert_equal expected_cards.map(&:title).sort, data.map { |card| card["title"] }.sort
+
+    card_data = data.find { |card| card["title"] == cards(:logo).title }
+    assert card_data["comments"].any?, "expected exported card to include its comments"
+  end
+
+  test "cards export does not include cards the user cannot see" do
+    Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(creator: users(:kevin), title: "Secret", status: :published)
+    end
+
+    export = create_export(kind: :cards)
+
+    data = with_zip(export) { |zip| JSON.parse zip.read("cards.json") }
+    assert_not_includes data.map { |card| card["title"] }, "Secret"
+  end
+
+  test "cards export includes attached files" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = create_export(kind: :cards)
+
+    with_zip(export) do |zip|
+      assert_equal [ "files/#{card.image.blob.id}/moon.jpg" ], zip.glob("files/*/*").map(&:name)
+
+      card_data = JSON.parse(zip.read("cards.json")).find { |c| c["title"] == card.title }
+      assert_equal "moon.jpg", card_data["attachments"].first["filename"]
+    end
+  end
+
+  test "creating an export emails a download link when it is ready" do
+    assert_emails 1 do
+      create_export(kind: :account)
+    end
+  end
+
+  test "download link expires after a day" do
+    export = create_export(kind: :account)
+    download_id = export.signed_download_id
+
+    assert_equal export, Export.find_by_signed_download_id(download_id)
+
+    travel 2.days do
+      assert_nil Export.find_by_signed_download_id(download_id)
+    end
+  end
+
+  test "cleanup removes expired exports" do
+    create_export(kind: :account)
+
+    travel 2.days do
+      assert_difference -> { Export.count }, -1 do
+        Export.cleanup
+      end
+    end
+  end
+
+
+  test "cards export includes files embedded in card descriptions and comments" do
+    card = cards(:logo)
+
+    Current.set(user: @user) do
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.update!(description: %Q(<p>Logo <action-text-attachment sgid="#{blob.attachable_sgid}" content-type="image/jpeg" filename="moon.jpg"></action-text-attachment></p>))
+
+      comment_blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+      card.comments.create!(creator: @user, body: %Q(<p>See <action-text-attachment sgid="#{comment_blob.attachable_sgid}" content-type="image/png" filename="avatar.png"></action-text-attachment></p>))
+    end
+
+    export = create_export(kind: :cards)
+
+    with_zip(export) do |zip|
+      file_names = zip.glob("files/*/*").map(&:name)
+      assert_equal 2, file_names.size
+      assert file_names.any? { |name| name.end_with?("/moon.jpg") }
+      assert file_names.any? { |name| name.end_with?("/avatar.png") }
+
+      card_data = JSON.parse(zip.read("cards.json")).find { |c| c["title"] == card.title }
+      assert_equal "moon.jpg", card_data["attachments"].first["filename"]
+      assert_equal "avatar.png", card_data["comments"].last["attachments"].first["filename"]
+    end
+  end
+
+  private
+    def create_export(kind:)
+      perform_enqueued_jobs do
+        @account.exports.create!(kind: kind, user: @user)
+      end
+
+      Export.order(:created_at).last
+    end
+
+    def with_zip(export)
+      Zip::File.open(export.file.blob.service.path_for(export.file.blob.key)) do |zip|
+        yield zip
+      end
+    end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
