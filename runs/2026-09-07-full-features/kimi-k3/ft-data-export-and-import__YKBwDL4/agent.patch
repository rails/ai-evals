+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    # Filter fields embed card and column ids in a JSON column, so they need remapping too.
+    def prepare_row(data, importer)
+      super.tap do |row|
+        if row["fields"].is_a?(Hash)
+          row["fields"] = row["fields"].dup
+          row["fields"]["card_ids"] = importer.mapped_ids("cards", row["fields"]["card_ids"]) if row["fields"].key?("card_ids")
+          row["fields"]["column_ids"] = importer.mapped_ids("columns", row["fields"]["column_ids"]) if row["fields"].key?("column_ids")
+        end
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..8f43412
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,190 @@
+require "zip"
+
+class Account::DataTransfer::Importer
+  FORMAT = Account::DataTransfer::Exporter::FORMAT
+  VERSION = Account::DataTransfer::Exporter::VERSION
+
+  class InvalidFile < StandardError; end
+
+  attr_reader :account
+
+  def self.import!(blob)
+    new(blob).import!
+  end
+
+  def initialize(blob)
+    @blob = blob
+    @id_mappings = Hash.new { |mappings, table_name| mappings[table_name] = {} }
+    @uploaded_keys = []
+  end
+
+  def import!
+    @blob.open do |file|
+      with_zip(file.path) do |zip|
+        validate!(zip)
+
+        Account.transaction do
+          manifest.each_record_set do |record_set|
+            record_set.load_from(zip, importer: self)
+          end
+
+          reindex_imported_content
+        end
+      end
+    end
+
+    account
+  rescue
+    delete_uploaded_files
+    raise
+  end
+
+  # Records get fresh ids so that an account can be imported alongside the
+  # account it was exported from. References between records are remapped here.
+  def remap_attributes(model, data)
+    data = data.dup
+    data["id"] = map_id(model.table_name, data["id"])
+    data["account_id"] = account.id if data.key?("account_id")
+
+    model.reflect_on_all_associations(:belongs_to).each do |association|
+      next if association.name == :account
+
+      if association.polymorphic?
+        remap_polymorphic_association(data, association)
+      else
+        remap_belongs_to_association(data, association)
+      end
+    end
+
+    data
+  end
+
+  def map_id(table_name, old_id)
+    mappings_for(table_name)[old_id] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def mapped_id(table_name, old_id)
+    mappings_for(table_name)[old_id]
+  end
+
+  def mapped_id!(table_name, old_id)
+    mapped_id(table_name, old_id) || raise(InvalidFile, "The archive references a #{table_name.singularize.humanize.downcase} record that is not included in it.")
+  end
+
+  def mapped_ids(table_name, old_ids)
+    Array(old_ids).filter_map { |old_id| mapped_id(table_name, old_id) }
+  end
+
+  def register_account(old_id, account)
+    @account = account
+    mappings_for("accounts")[old_id] = account.id
+  end
+
+  def register_uploaded_key(key)
+    @uploaded_keys << key
+  end
+
+  def find_or_create_identity(email_address)
+    Identity.find_or_create_by!(email_address: email_address) if email_address.present?
+  end
+
+  # Rich text bodies point at blobs and mentioned users via signed global ids. Rewrite
+  # them so they resolve to the freshly imported records. References to records that
+  # aren't part of the export are left untouched.
+  def rewrite_attachable_sgids(body)
+    body.gsub(/sgid="([^"]+)"/) do
+      original = Regexp.last_match(1)
+      rewritten_sgid(original) || %Q(sgid="#{original}")
+    end
+  end
+
+  private
+    def with_zip(path, &block)
+      Zip::File.open(path, &block)
+    rescue Zip::Error
+      raise InvalidFile, "That file is not a ZIP archive."
+    end
+
+    def validate!(zip)
+      manifest = read_manifest(zip)
+
+      unless manifest["format"] == FORMAT
+        raise InvalidFile, "That file is not a Fizzy account export."
+      end
+
+      if manifest["version"].to_i > VERSION
+        raise InvalidFile, "This export was created by a newer version of Fizzy and can't be imported here."
+      end
+    end
+
+    def read_manifest(zip)
+      entry = zip.find_entry("manifest.json")
+      raise InvalidFile, "That file is not a Fizzy account export (manifest.json is missing)." unless entry
+
+      JSON.parse(entry.get_input_stream.read)
+    rescue JSON::ParserError
+      raise InvalidFile, "That file is not a Fizzy account export (manifest.json is unreadable)."
+    end
+
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new
+    end
+
+    def mappings_for(table_name)
+      @id_mappings[table_name]
+    end
+
+    def remap_belongs_to_association(data, association)
+      foreign_key = association.foreign_key
+      return unless data.key?(foreign_key)
+
+      old_id = data[foreign_key]
+      return if old_id.nil?
+
+      data[foreign_key] = mapped_id!(association.klass.table_name, old_id)
+    end
+
+    def remap_polymorphic_association(data, association)
+      foreign_key = association.foreign_key
+      return unless data.key?(foreign_key)
+
+      old_id = data[foreign_key]
+      old_type = data["#{association.name}_type"]
+      return if old_id.nil? || old_type.nil?
+
+      model = old_type.safe_constantize
+      raise InvalidFile, "The archive references an unknown record type (#{old_type})." unless model
+
+      data[foreign_key] = mapped_id!(model.table_name, old_id)
+    end
+
+    def rewritten_sgid(original)
+      sgid = SignedGlobalID.parse(original, for: ActionText::Attachable::LOCATOR_NAME)
+      return unless sgid
+
+      new_id = mapped_id(sgid.model_class.table_name, sgid.model_id)
+      return unless new_id
+
+      new_gid = URI::GID.build(app: sgid.app, model_name: sgid.model_name, model_id: new_id, params: sgid.params)
+      %Q(sgid="#{SignedGlobalID.new(new_gid, for: sgid.purpose)}")
+    rescue NameError, URI::GID::InvalidModelName
+      nil
+    end
+
+    def reindex_imported_content
+      account.cards.includes(:comments).find_each do |card|
+        card.reindex
+        card.comments.each(&:reindex)
+      end
+    end
+
+    def delete_uploaded_files
+      service = ActiveStorage::Blob.service
+
+      @uploaded_keys.each do |key|
+        service.delete(key)
+      rescue
+        Rails.logger.warn "Import cleanup: couldn't delete uploaded file #{key}"
+      end
+    end
+end
