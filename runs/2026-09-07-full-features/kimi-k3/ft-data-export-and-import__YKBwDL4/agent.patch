@@ -0,0 +1,34 @@
+class Account::DataTransfer::Exporter
+  FORMAT = "fizzy-account-export"
+  VERSION = 1
+
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def export_to(export)
+    ZipFile.create_for(export.file, filename: export.filename) do |zip|
+      zip.add_file "manifest.json", JSON.pretty_generate(manifest_data)
+
+      manifest.each_record_set do |record_set|
+        record_set.dump_to(zip)
+      end
+    end
+  end
+
+  private
+    def manifest
+      Account::DataTransfer::Manifest.new(account)
+    end
+
+    def manifest_data
+      {
+        "format" => FORMAT,
+        "version" => VERSION,
+        "exported_at" => Time.current.iso8601,
+        "account" => { "name" => account.name }
+      }
+    end
+end
