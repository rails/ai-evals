new file mode 100644
index 0000000..a2d48d6
--- /dev/null
+++ b/test/integration/account_data_transfer_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class AccountDataTransferTest < ActionDispatch::IntegrationTest
+  test "an account export can be imported back in as a new account" do
+    sign_in_as users(:kevin)  # admin of 37signals
+    clear_enqueued_jobs
+
+    # Request the export from account settings
+    perform_enqueued_jobs do
+      post account_exports_url
+    end
+    assert_redirected_to account_settings_path
+
+    # The download link arrives by email
+    email = ActionMailer::Base.deliveries.last
+    assert email, "expected an email with the download link"
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+
+    download_path = email.body.encoded[%r{/#{accounts(:"37s").external_account_id}/exports/[^"\s<]+}]
+    assert download_path, "expected the email to contain a download link"
+
+    # Download the export
+    get download_path
+    assert_response :success
+
+    # Upload it for import
+    import_file = Rack::Test::UploadedFile.new(StringIO.new(@response.body), "application/zip", original_filename: "export.zip")
+    existing_account_ids = Account.ids
+
+    assert_difference -> { Account.count }, 1 do
+      perform_enqueued_jobs do
+        post account_imports_url, params: { import: { file: import_file } }
+      end
+      assert_redirected_to new_account_import_path
+    end
+
+    # The completion email arrives
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ users(:kevin).identity.email_address ], email.to
+    assert_match "ready", email.subject
+
+    # The new account has everything in it
+    new_account = Account.where.not(id: existing_account_ids).first
+    assert_equal accounts(:"37s").name, new_account.name
+    assert_equal accounts(:"37s").cards.count, new_account.cards.count
+    assert_equal accounts(:"37s").boards.count, new_account.boards.count
+  end
+
+  test "a failed import leaves nothing behind" do
+    sign_in_as users(:kevin)
+    clear_enqueued_jobs
+
+    cards(:logo).image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    perform_enqueued_jobs do
+      accounts(:"37s").exports.create!(kind: :account, user: users(:kevin))
+    end
+    export = Export.order(:created_at).last
+
+    # Corrupt one of the files inside the archive
+    blob = export.file.blob
+    tampered = tamper_with_zip_entry(blob.service.path_for(blob.key))
+
+    assert_no_difference -> { Account.count } do
+      assert_no_difference -> { ActiveStorage::Blob.count } do
+        perform_enqueued_jobs do
+          post account_imports_url, params: { import: { file: Rack::Test::UploadedFile.new(tampered.path, "application/zip", original_filename: "export.zip") } }
+        end
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_match "failed", email.subject
+  ensure
+    tampered&.unlink
+  end
+
+  private
+    def tamper_with_zip_entry(path)
+      tempfile = Tempfile.new([ "tampered", ".zip" ])
+
+      Zip::File.open(path) do |zip|
+        Zip::File.open(tempfile.path, create: true) do |out|
+          zip.each do |entry|
+            content = entry.get_input_stream.read
+            content = "corrupted" if entry.name.start_with?("files/")
+            out.get_output_stream(entry.name) { |io| io.write(content) }
+          end
+        end
+      end
+
+      tempfile
+    end
+end
