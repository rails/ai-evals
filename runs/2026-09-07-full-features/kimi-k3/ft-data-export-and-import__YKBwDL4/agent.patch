+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Current.account.imports.build(user: Current.user)
+    @import.file.attach(import_file) if import_file.present?
+
+    if @import.save
+      redirect_to new_account_import_path, notice: "Your import has started. You'll get an email when it's done."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_file
+      if params[:import].present?
+        params.require(:import).permit(:file)[:file]
+      else
+        params[:file]
+      end
+    end
+end
