diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..f8aac1f
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,49 @@
+class Export < ApplicationRecord
+  # Download links shared by email stop working after this period.
+  DOWNLOAD_LINK_EXPIRATION = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :kind, %w[ account cards ].index_by(&:itself)
+
+  after_create_commit :process_later
+
+  def process
+    if account?
+      Account::DataTransfer::Exporter.new(account).export_to(self)
+    else
+      User::CardsExport.new(user).export_to(self)
+    end
+
+    ExportMailer.download_ready(self).deliver_later
+  end
+
+  def process_later
+    ExportJob.perform_later(self)
+  end
+
+  def filename
+    if account?
+      "#{account.name.parameterize}-fizzy-account-export.zip"
+    else
+      "#{user.name.parameterize}-fizzy-cards-export.zip"
+    end
+  end
+
+  def signed_download_id
+    signed_id(expires_in: DOWNLOAD_LINK_EXPIRATION, purpose: :download)
+  end
+
+  # Returns nil when the link has expired or has been tampered with.
+  def self.find_by_signed_download_id(id)
+    find_signed(id, purpose: :download)
+  end
+
+  # Removes exports whose download links have expired, along with their files.
+  def self.cleanup
+    where(created_at: ...DOWNLOAD_LINK_EXPIRATION.ago).find_each(&:destroy)
+  end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..b99bb4a
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,37 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  validate :file_attached
+
+  after_create_commit :process_later
+
+  def process
+    new_account = Account::DataTransfer::Importer.import!(file)
+    ImportMailer.completed(user: user, account: new_account).deliver_later
+  rescue => error
+    Rails.error.report(error, severity: :error)
+    ImportMailer.failed(user: user, reason: failure_reason(error)).deliver_later
+  ensure
+    destroy!
+  end
+
+  def process_later
+    ImportJob.perform_later(self)
+  end
+
+  private
+    def file_attached
+      errors.add(:file, "must be attached") unless file.attached?
+    end
+
+    def failure_reason(error)
+      if error.is_a?(Account::DataTransfer::Importer::InvalidFile)
+        error.message
+      else
+        "Something went wrong while importing the file (#{error.message})."
+      end
+    end
+end
diff --git a/app/models/user/cards_export.rb b/app/models/user/cards_export.rb
new file mode 100644
index 0000000..6767c69
--- /dev/null
+++ b/app/models/user/cards_export.rb
@@ -0,0 +1,87 @@
+# Builds a ZIP archive with the cards a user can see: cards.json with every card
+# (including its comments), plus a files/ directory with every picture and file
+# attached to those cards.
+class User::CardsExport
+  attr_reader :user
+
+  def initialize(user)
+    @user = user
+  end
+
+  def export_to(export)
+    ZipFile.create_for(export.file, filename: export.filename) do |zip|
+      zip.add_file "cards.json", JSON.pretty_generate(cards_data)
+
+      blobs.each do |blob|
+        zip.add_file(path_for(blob), compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      end
+    end
+  end
+
+  private
+    def cards
+      @cards ||= user.accessible_cards.published.preloaded.chronologically
+    end
+
+    def cards_data
+      cards.map { |card| card_data(card) }
+    end
+
+    def card_data(card)
+      {
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "created_at" => card.created_at.iso8601,
+        "last_active_at" => card.last_active_at.iso8601,
+        "due_on" => card.due_on&.iso8601,
+        "board" => card.board.name,
+        "column" => card.column&.name,
+        "creator" => card.creator.name,
+        "assignees" => card.assignees.map(&:name),
+        "tags" => card.tags.map(&:title).sort,
+        "description" => card.description.to_plain_text,
+        "description_html" => card.description.to_s,
+        "attachments" => attachments_for(card).map { |blob| attachment_data(blob) },
+        "comments" => card.comments.chronologically.preloaded.map { |comment| comment_data(comment) }
+      }
+    end
+
+    def comment_data(comment)
+      {
+        "creator" => comment.creator.name,
+        "created_at" => comment.created_at.iso8601,
+        "body" => comment.body.to_plain_text,
+        "body_html" => comment.body.to_s,
+        "attachments" => attachments_for(comment).map { |blob| attachment_data(blob) }
+      }
+    end
+
+    def attachments_for(attachable)
+      [].tap do |blobs|
+        blobs << attachable.image.blob if attachable.respond_to?(:image) && attachable.image.attached?
+        attachable.attachments.each { |attachment| blobs << attachment.blob }
+      end
+    end
+
+    def attachment_data(blob)
+      {
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "path" => path_for(blob)
+      }
+    end
+
+    def blobs
+      @blobs ||= cards.flat_map do |card|
+        attachments_for(card) + card.comments.flat_map { |comment| attachments_for(comment) }
+      end.uniq
+    end
+
+    def path_for(blob)
+      "files/#{blob.id}/#{File.basename(blob.filename.to_s)}"
+    end
+end
