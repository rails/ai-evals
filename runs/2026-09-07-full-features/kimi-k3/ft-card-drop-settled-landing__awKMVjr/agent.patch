diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..a715c67
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,119 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+// Moves cards between columns, or statuses via the Not Now, Maybe?, and Done columns, by
+// dragging them around the board. Columns keep their own order, so a dropped card simply joins
+// its new column: the move is applied to the DOM as soon as the card is let go, and the save
+// follows in the background. The save asks for a JSON response so it does not answer with a
+// Turbo Stream, and the board's refresh broadcast skips the client that made the change. When
+// you let go, the board is already the way you left it, and nothing shifts afterwards.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  dragStart(event) {
+    const item = event.target.closest("[data-drag-and-drop-target~='item']")
+
+    if (item && event.target.draggable) {
+      this.draggedItem = item
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+      item.classList.add(this.draggedItemClass)
+    }
+  }
+
+  dragOver(event) {
+    if (this.draggedItem) {
+      const container = this.#containerFor(event.target)
+
+      if (container) {
+        event.preventDefault()
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      this.#highlightContainer(container)
+    }
+  }
+
+  drop(event) {
+    const item = this.draggedItem
+    const container = this.#containerFor(event.target)
+
+    if (item && container) {
+      event.preventDefault()
+      this.#moveItem(item, container)
+    }
+  }
+
+  dragEnd() {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove(this.draggedItemClass)
+      this.draggedItem = null
+      this.#highlightContainer(null)
+    }
+  }
+
+  // Private
+
+  #containerFor(element) {
+    return element.closest("[data-drag-and-drop-target~='container']")
+  }
+
+  #highlightContainer(container) {
+    if (container !== this.hoverContainer) {
+      this.hoverContainer?.classList.remove(this.hoverContainerClass)
+      container?.classList.add(this.hoverContainerClass)
+      this.hoverContainer = container
+    }
+  }
+
+  // Dropping back into the same column is a no-op: columns keep their own order, so a card
+  // that does not change places has nothing to save.
+  #moveItem(item, container) {
+    if (!container.contains(item)) {
+      const url = item.dataset[container.dataset.dragAndDropUrlAttribute]
+      const list = container.querySelector(".cards__list")
+
+      if (url && list) {
+        const origin = { parent: item.parentNode, nextSibling: item.nextSibling }
+
+        list.prepend(item)
+        this.#save(item, container, url, origin)
+      }
+    }
+  }
+
+  async #save(item, container, url, origin) {
+    const columnId = container.dataset.dragAndDropColumnId
+    const request = new FetchRequest(container.dataset.dragAndDropMethod || "post", url, {
+      responseKind: "json",
+      query: columnId ? { column_id: columnId } : {}
+    })
+
+    try {
+      const response = await request.perform()
+
+      if (!response.ok) {
+        this.#restore(item, origin)
+      }
+    } catch {
+      this.#restore(item, origin)
+    }
+  }
+
+  #restore(item, origin) {
+    if (origin.nextSibling?.parentNode === origin.parent) {
+      origin.parent.insertBefore(item, origin.nextSibling)
+    } else if (origin.parent.isConnected) {
+      origin.parent.appendChild(item)
+    }
+  }
+}
