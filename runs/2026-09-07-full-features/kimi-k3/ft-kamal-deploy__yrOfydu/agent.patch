@@ -0,0 +1,22 @@
+# Secrets referenced by config/deploy.yml. Fill in real values before running
+# `bin/kamal setup`, and never commit the filled-in file anywhere public.
+#
+# Values can also be pulled from your environment or a password manager
+# instead of being written here -- see `kamal secrets` for the options.
+
+# Required: signs sessions and other secrets. Generate with `bin/rails secret`.
+SECRET_KEY_BASE=
+
+# Required: password (or access token) for the container registry in
+# config/deploy.yml. For Docker Hub, create an access token at
+# https://app.docker.com/settings/personal-access-tokens
+KAMAL_REGISTRY_PASSWORD=
+
+# Required: credentials for the mail server in config/deploy.yml.
+SMTP_USERNAME=
+SMTP_PASSWORD=
+
+# Optional: enables web push notifications. Generate a key pair with:
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}\nVAPID_PRIVATE_KEY=#{key.private_key}"'
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
