new file mode 100644
index 0000000..bf13310
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,88 @@
+# Deploy Fizzy on a single server with Kamal.
+#
+# Everything runs on one box: the Rails app, its SQLite databases, file
+# uploads, and the background job worker. kamal-proxy terminates SSL with an
+# automatically provisioned Let's Encrypt certificate, so Fizzy is served at
+# https://<your host>.
+#
+# To deploy:
+#   1. Point your domain's DNS at a Linux server with Docker installed.
+#   2. Fill in every line marked TODO below.
+#   3. Fill in your secrets in .kamal/secrets.
+#   4. Run `bin/kamal setup`.
+#
+# Later on, redeploy with `bin/kamal deploy`. The SQLite databases and
+# uploaded files live in the fizzy-storage volume, so they survive deploys.
+
+service: fizzy
+
+# TODO: Name of the image to build and publish, typically
+# "<registry user>/fizzy" on Docker Hub.
+image: your-registry-user/fizzy
+
+# TODO: Your server's IP address or SSH hostname (twice). The same box runs
+# the web app and the background job worker.
+servers:
+  web:
+    hosts:
+      - 192.0.2.1
+  jobs:
+    hosts:
+      - 192.0.2.1
+    cmd: bin/jobs
+
+# kamal-proxy listens on ports 80 and 443, terminates SSL, and forwards
+# requests to the app.
+proxy:
+  ssl: true
+  # TODO: Your public hostname, e.g. fizzy.example.com. DNS for it must point
+  # at your server. The `fizzy_host` anchor is reused for APP_HOST further
+  # down, so you only need to set it here.
+  host: &fizzy_host fizzy.example.com
+
+# The registry kamal pushes the image to and the server pulls it from.
+# Defaults to Docker Hub. To use GitHub Container Registry instead, add
+# `server: ghcr.io` and use your GitHub username below.
+registry:
+  # TODO: Your registry username.
+  username: your-registry-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build for the server's CPU architecture. Most cloud VMs are amd64; use
+# arm64 for ARM servers (AWS Graviton, Hetzner CAX, Raspberry Pi, ...).
+builder:
+  arch: amd64
+
+# The SQLite databases and Active Storage uploads all live in /rails/storage.
+# Mounting a named volume there keeps your data across deploys.
+volumes:
+  - fizzy-storage:/rails/storage
+
+env:
+  clear:
+    # Background jobs run in the dedicated `jobs` role, not inside Puma.
+    SOLID_QUEUE_IN_PUMA: "false"
+
+    # Public hostname Fizzy is served at -- reused from the proxy host above.
+    # Used for URLs generated outside of a request, like magic link emails.
+    APP_HOST: *fizzy_host
+
+    # TODO: Outgoing mail. Magic links and notifications are sent through
+    # this mail server. Its credentials go in .kamal/secrets.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@fizzy.example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: fizzy.example.com
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# Let kamal-proxy serve the compiled assets instead of the Rails process.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
