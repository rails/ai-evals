@@ -0,0 +1,115 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "add a text reaction to a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_no_selector ".reaction"
+
+      find(".reactions__trigger").click
+      fill_in "Your reaction", with: "Great 👍"
+      click_on "Save reaction"
+
+      assert_selector ".reaction", text: "Great 👍"
+      assert_selector ".reaction__avatar[aria-label='#{users(:kevin).name}']"
+      assert_selector ".reactions__trigger" # the button is back for the next one
+      assert_no_selector ".reaction__form:not([hidden])", visible: :all
+    end
+
+    assert_equal "Great 👍", @comment.reactions.sole.content
+    assert_equal users(:kevin), @comment.reactions.sole.reacter
+  end
+
+  test "cancel adding a reaction" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      fill_in "Your reaction", with: "Nah"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form:not([hidden])", visible: :all
+    end
+
+    assert_equal 0, @comment.reactions.count
+  end
+
+  test "add a reaction from the emoji menu" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      find(".reaction__menu-btn").click
+      find(".reaction__emoji-list button", text: "🎉").click
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal "🎉", @comment.reactions.sole.content
+  end
+
+  test "remove your own reaction" do
+    reaction = @comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reaction span.txt-small", text: "👍").click # reveals the remove button
+      click_on "Remove this reaction"
+
+      assert_no_selector ".reaction"
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reactions land live for everyone looking at the card" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_no_selector ".reaction"
+    end
+
+    wait_for_cable_subscriptions
+    Current.user = users(:david)
+    @comment.reactions.create!(content: "🙌")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "🙌", wait: 5
+    end
+  end
+
+  test "react to the card itself" do
+    visit card_url(@card)
+
+    within "##{dom_id(@card, :reactions)}" do
+      assert_selector ".reaction", text: "🎉" # from fixtures
+
+      find(".reactions__trigger").click
+      fill_in "Your reaction", with: "On it"
+      click_on "Save reaction"
+
+      assert_selector ".reaction", text: "On it"
+    end
+
+    assert_equal "On it", @card.reactions.last.content
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
