+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    comment = comments(:logo_agreement_kevin)
+
+    get card_comment_reactions_path(comment.card, comment), as: :json
+
+    assert_response :success
+    assert_equal comment.reactions.count, @response.parsed_body.count
+  end
+
+  test "create" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), comment.reactions.last.reacter
+  end
+
+  test "create replaces the reactions strip" do
+    comment = comments(:logo_agreement_jz)
+
+    post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Great work" } }, as: :turbo_stream
+
+    assert_turbo_stream action: :replace, target: "reactions_comment_#{comment.id}"
+    assert_includes @response.body, "Great work"
+  end
+
+  test "create as JSON" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "🎉" } }, as: :json
+    end
+
+    assert_response :created
+
+    reaction = comment.reactions.last
+    assert_equal card_comment_reaction_path(comment.card, comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "🎉", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_difference -> { comment.reactions.count }, +1 do
+      post card_comment_reactions_path(comment.card, comment), params: { content: "🎉" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🎉", comment.reactions.last.content
+  end
+
+  test "create with too long content is unprocessable" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy own reaction" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    assert_difference -> { comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up_david)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.reactable.card, reaction.reactable, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy as JSON" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(reacter: users(:kevin), content: "👍")
+
+    delete card_comment_reaction_path(comment.card, comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
