@@ -0,0 +1,52 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :ensure_card_is_reactable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @card.reactions.chronologically
+
+    fresh_when etag: @reactions
+  end
+
+  def create
+    @reaction = @card.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_reaction_path(@card, @reaction, format: :json) }
+    end
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def ensure_card_is_reactable
+      head :forbidden unless @card.published?
+    end
+
+    def set_reaction
+      @reaction = @card.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..701ffc0
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,37 @@
+module ReactionsHelper
+  def reactable_reactions_path(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def reactable_reaction_path(reaction)
+    reactable = reaction.reactable
+
+    if reactable.is_a?(Comment)
+      card_comment_reaction_path(reactable.card, reactable, reaction)
+    else
+      card_reaction_path(reactable, reaction)
+    end
+  end
+
+  def reactable_reactions_url(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_url(reactable.card, reactable)
+    else
+      card_reactions_url(reactable)
+    end
+  end
+
+  def reactable_reaction_url(reaction)
+    reactable = reaction.reactable
+
+    if reactable.is_a?(Comment)
+      card_comment_reaction_url(reactable.card, reactable, reaction)
+    else
+      card_reaction_url(reactable, reaction)
+    end
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..1bb3fbd
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+    }
+  }
+
+  toggle(event) {
+    if (event.target.closest("a")) return // let avatar links through to the profile
+
+    if (this.#isOwnReaction) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  remove(event) {
+    event.stopPropagation()
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #isOwnReaction() {
+    return this.element.dataset.creatorId === window.Current?.user?.id
+  }
+}
