diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..10cff8d
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "content is limited to 16 characters" do
+    assert comments(:logo_agreement_kevin).reactions.build(content: "a" * 16).valid?
+    assert_not comments(:logo_agreement_kevin).reactions.build(content: "a" * 17).valid?
+  end
+
+  test "content is required" do
+    assert_not comments(:logo_agreement_kevin).reactions.build(content: "").valid?
+    assert_not comments(:logo_agreement_kevin).reactions.build(content: "  ").valid?
+  end
+
+  test "content is stripped" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "  👍  ")
+    assert_equal "👍", reaction.content
+  end
+
+  test "reacter defaults to the current user" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "👍")
+    assert_equal users(:david), reaction.reacter
+  end
+
+  test "cards can be reacted to as well" do
+    reaction = cards(:text).reactions.create!(content: "🎉")
+
+    assert_equal cards(:text), reaction.reactable
+    assert_equal cards(:text).account, reaction.account
+  end
+
+  test "creating and destroying reactions touches the reactable" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_changes -> { comment.reload.updated_at } do
+      comment.reactions.create!(content: "👍")
+    end
+
+    reaction = comment.reactions.last
+
+    assert_changes -> { comment.reload.updated_at } do
+      reaction.destroy!
+    end
+  end
+
+  test "reactions on comments touch the card too" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_changes -> { comment.card.reload.updated_at } do
+      comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reactions are destroyed with their reactable" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "👍")
+    reactions_count = comment.reactions.count
+
+    assert_difference -> { Reaction.count }, -reactions_count do
+      comment.destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creating a reaction broadcasts a refresh to the card" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_turbo_stream_broadcasts [ comment.card ], count: 1 do
+      perform_enqueued_jobs do
+        comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+end
