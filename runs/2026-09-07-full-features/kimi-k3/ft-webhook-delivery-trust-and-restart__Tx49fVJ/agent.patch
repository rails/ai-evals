+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  test "perform delivers the delivery" do
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, "https://api.example.com/webhooks").with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    delivery = webhook_deliveries(:pending)
+
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert delivery.reload.completed?
+    assert delivery.succeeded?
+    assert_requested :post, "https://api.example.com/webhooks", times: 1
+  end
+
+  test "performing the job repeatedly delivers exactly once" do
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, "https://api.example.com/webhooks").with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    delivery = webhook_deliveries(:pending)
+
+    3.times { Webhook::DeliveryJob.perform_now(delivery.reload) }
+
+    assert_requested :post, "https://api.example.com/webhooks", times: 1
+    assert delivery.reload.completed?
+  end
+
+  test "jobs are enqueued on the webhooks queue" do
+    assert_equal "webhooks", Webhook::DeliveryJob.new(webhook_deliveries(:pending)).queue_name
+  end
+end
