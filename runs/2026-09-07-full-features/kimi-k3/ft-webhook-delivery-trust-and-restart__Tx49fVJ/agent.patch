diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..98a6c9b
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,36 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A webhook is deactivated when it accumulates MAX_CONSECUTIVE_FAILURES
+  # failed deliveries in a row, all within FAILURE_TIMESPAN.
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_TIMESPAN = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    else
+      register_failure
+    end
+  end
+
+  private
+    def reset
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+
+    def register_failure
+      if first_failure_at&.after?(FAILURE_TIMESPAN.ago)
+        increment! :consecutive_failures_count
+      else
+        update! consecutive_failures_count: 1, first_failure_at: Time.current
+      end
+
+      webhook.deactivate if delinquent?
+    end
+
+    def delinquent?
+      consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES
+    end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
