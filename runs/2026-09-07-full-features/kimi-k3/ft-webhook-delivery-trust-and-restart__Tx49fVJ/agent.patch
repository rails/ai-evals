+require "test_helper"
+
+class Event::WebhookableTest < ActiveSupport::TestCase
+  test "creating an event creates a pending delivery for each active webhook subscribed to the action" do
+    webhook = webhooks(:active) # on the writebook board, subscribed to card_published
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      boards(:writebook).events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+    end
+
+    delivery = Webhook::Delivery.last
+    assert_equal webhook, delivery.webhook
+    assert_equal "card_published", delivery.event.action
+    assert delivery.pending?
+  end
+
+  test "creating an event enqueues a delivery job" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      boards(:writebook).events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+    end
+  end
+
+  test "no delivery when no webhook is subscribed to the action" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      boards(:writebook).events.create! action: "comment_created", creator: users(:david), eventable: cards(:logo).comments.create!(body: "Hello!", creator: users(:david))
+    end
+  end
+
+  test "no delivery for inactive webhooks" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      boards(:private).events.create! action: "card_published", creator: users(:david), eventable: cards(:unfinished_thoughts)
+    end
+  end
+
+  test "no delivery for webhooks on other boards" do
+    webhook = Webhook.create! name: "Other board", url: "https://example.com/webhook", board: boards(:private), subscribed_actions: %w[ card_published ]
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      boards(:writebook).events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+    end
+  end
+
+  test "delivery is performed exactly once when the job runs" do
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, "https://api.example.com/webhooks").with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    perform_enqueued_jobs do
+      boards(:writebook).events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+    end
+
+    assert_requested :post, "https://api.example.com/webhooks", times: 1
+    assert Webhook::Delivery.last.completed?
+  end
+
+  test "closing a card posts the event to subscribed webhooks" do
+    stub_dns_resolution "93.184.216.34"
+    stub_request(:post, "https://api.example.com/webhooks").with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    card = cards(:logo) # on the writebook board, watched by webhooks(:active) for card_closed
+
+    perform_enqueued_jobs do
+      card.close(user: users(:david))
+    end
+
+    assert_requested :post, "https://api.example.com/webhooks", times: 1
+    assert_equal "card_closed", Webhook::Delivery.last.event.action
+    assert Webhook::Delivery.last.succeeded?
+  end
+end
