@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "webhooks are created with a delinquency tracker" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.present?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "destroying a webhook destroys its tracker" do
+    assert_difference -> { Webhook::DelinquencyTracker.count }, -1 do
+      @webhook.destroy
+    end
+  end
+
+  test "failed deliveries count consecutive failures" do
+    assert_difference -> { @tracker.reload.consecutive_failures_count }, 1 do
+      @tracker.record(failed_delivery)
+    end
+
+    assert @tracker.first_failure_at.present?
+  end
+
+  test "successful deliveries reset the tracker" do
+    @tracker.update! consecutive_failures_count: 5, first_failure_at: 10.minutes.ago
+
+    @tracker.record(succeeded_delivery)
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "webhook is deactivated after ten consecutive failures within an hour" do
+    9.times { @tracker.record(failed_delivery) }
+    assert @webhook.reload.active?
+
+    @tracker.record(failed_delivery)
+    assert_not @webhook.reload.active?
+  end
+
+  test "failures older than an hour start a new window" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    @tracker.record(failed_delivery)
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "failures within the window accumulate" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 30.minutes.ago
+
+    @tracker.record(failed_delivery)
+
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+    assert_not @webhook.reload.active?
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: events(:shipping_closed), state: :completed, response: { code: 500 })
+    end
+
+    def succeeded_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: events(:shipping_closed), state: :completed, response: { code: 200 })
+    end
+end
