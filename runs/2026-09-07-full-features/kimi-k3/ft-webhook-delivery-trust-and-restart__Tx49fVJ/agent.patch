--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,17 @@
 class Webhook::Delivery < ApplicationRecord
+  # Raised when the webhook URL doesn't resolve to a public IP address.
+  class DestinationUnreachable < StandardError; end
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
+  RETENTION_PERIOD = 1.week
+
+  CONNECTION_ERRORS = [ SocketError, SystemCallError, Timeout::Error, IOError, OpenSSL::OpenSSLError, Resolv::ResolvError ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +22,26 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ..RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      stale.in_batches(&:delete_all)
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if claim_for_delivery
+      transmit_payload
+      webhook.delinquency_tracker&.record(self)
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +62,74 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # Atomically moving pending -> in_progress guarantees the request is only
+    # ever sent once, even if the delivery job is performed again.
+    def claim_for_delivery
+      self.class.pending.where(id: id).update_all(state: "in_progress", updated_at: Time.current) == 1
+    end
+
+    def transmit_payload
+      self.request = { headers: request_headers }
+
+      begin
+        http_response = post_payload
+        self.state = "completed"
+        self.response = { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+      rescue DestinationUnreachable, *CONNECTION_ERRORS
+        self.state = "errored"
+        self.response = { error: "destination_unreachable" }
+      end
+
+      save!
+    end
+
+    def post_payload
+      if ip_address = SsrfProtection.resolve_public_ip(uri.host)
+        connection_to(ip_address).request(post_request)
+      else
+        raise DestinationUnreachable, "#{uri.host} does not resolve to a public IP address"
+      end
+    end
+
+    # The connection is pinned to the resolved IP so DNS rebinding can't
+    # redirect the request to a different host.
+    def connection_to(ip_address)
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.use_ssl = uri.scheme == "https"
+        http.ipaddr = ip_address
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = WRITE_TIMEOUT
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri.request_uri, request_headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def payload
+      @payload ||= ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event", formats: [ :json ], assigns: { event: event })
+    end
+
+    def request_headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
 end
diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..a952539 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -159,3 +159,18 @@ __Response:__
 ```
 
 `request` and `response` can be `null` for deliveries that have not started yet or are still in progress. The delivery request headers omit the `X-Webhook-Signature` header.
+
+## Delivery
+
+When an event matching a webhook's `subscribed_actions` happens on its board, Fizzy sends a `POST` request to the webhook URL with the event as JSON in the request body. Each delivery is sent exactly once.
+
+Requests include these headers:
+
+- `Content-Type: application/json`
+- `User-Agent: fizzy/1.0.0 Webhook`
+- `X-Webhook-Timestamp`: when the event happened
+- `X-Webhook-Signature`: an HMAC-SHA256 hex digest of the request body, generated with the webhook's `signing_secret`
+
+Every delivery is recorded in the webhook's delivery log with its request and response. Deliveries are kept for one week.
+
+A webhook that accumulates ten consecutive failed deliveries within an hour is deactivated automatically. It can be reactivated with `POST /:account_slug/boards/:board_id/webhooks/:id/activation`.
