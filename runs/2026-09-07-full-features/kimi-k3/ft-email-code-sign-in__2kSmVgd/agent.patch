diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..43c5bad
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  test "generates a six character code" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_match /\A[A-Z0-9]{6}\z/, magic_link.code
+  end
+
+  test "codes are active for fifteen minutes" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert magic_link.active?
+    assert_not magic_link.expired?
+
+    travel 16.minutes do
+      assert_not magic_link.active?
+      assert magic_link.expired?
+    end
+  end
+
+  test "active scope" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_includes MagicLink.active, magic_link
+
+    travel 16.minutes do
+      assert_not_includes MagicLink.active, magic_link
+    end
+  end
+
+  test "consume returns and destroys the magic link" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      assert_equal magic_link, MagicLink.consume(magic_link.code)
+    end
+  end
+
+  test "consume is case insensitive and ignores whitespace" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    assert_equal magic_link, MagicLink.consume(" #{magic_link.code.downcase} ")
+  end
+
+  test "consume returns nil for unknown, blank, and expired codes" do
+    assert_nil MagicLink.consume("NOPE12")
+    assert_nil MagicLink.consume("")
+    assert_nil MagicLink.consume(nil)
+
+    magic_link = identities(:kevin).magic_links.create!
+
+    travel 16.minutes do
+      assert_nil MagicLink.consume(magic_link.code)
+    end
+
+    assert MagicLink.exists?(magic_link.id), "Expired codes are not consumed"
+  end
+
+  test "does not reuse an active code" do
+    magic_link = identities(:kevin).magic_links.create!
+
+    SecureRandom.stubs(:alphanumeric).returns(magic_link.code.downcase, "ABC123")
+
+    assert_equal "ABC123", identities(:jz).magic_links.create!.code
+  end
+end
