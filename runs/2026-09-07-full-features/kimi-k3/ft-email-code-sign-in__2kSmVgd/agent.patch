new file mode 100644
index 0000000..7ed06a5
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,53 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_magic_link_code(identity)
+      IdentityMailer.magic_link(identity.magic_links.create!).deliver_later
+    end
+
+    def authenticate_with_magic_link_code(code)
+      if magic_link = MagicLink.consume(code)
+        start_new_session_for magic_link.identity
+        magic_link.identity
+      end
+    end
+
+    def after_magic_link_authentication_url(identity)
+      if pending_join_url = redeem_pending_join_code(identity)
+        pending_join_url
+      elsif identity.users.exists?
+        after_authentication_url
+      else
+        new_signup_completion_url
+      end
+    end
+
+    def invalid_magic_link_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def redeem_pending_join_code(identity)
+      if code = session.delete(:pending_join_code)
+        if join_code = Account::JoinCode.active.find_by(code: code)
+          join_code.redeem_if { |account| identity.join(account) }
+          join_destination_url join_code, identity
+        end
+      end
+    end
+
+    def join_destination_url(join_code, identity)
+      if user = User.active.find_by(account: join_code.account, identity: identity)
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      end
+    end
+end
