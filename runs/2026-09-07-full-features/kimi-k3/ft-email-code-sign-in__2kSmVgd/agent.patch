diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..0a94dda
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,33 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION_TIME = 15.minutes
+
+  belongs_to :identity
+
+  before_create :generate_code, if: -> { code.blank? }
+
+  scope :active, -> { where("created_at > ?", EXPIRATION_TIME.ago) }
+
+  def self.consume(code)
+    if magic_link = active.find_by(code: code.to_s.strip.upcase)
+      magic_link.destroy
+      magic_link
+    end
+  end
+
+  def active?
+    created_at > EXPIRATION_TIME.ago
+  end
+
+  def expired?
+    !active?
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.active.exists?(code: candidate)
+      end
+    end
+end
