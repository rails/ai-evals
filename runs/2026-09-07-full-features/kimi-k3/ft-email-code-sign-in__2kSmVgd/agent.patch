@@ -78,4 +78,96 @@ class JoinCodesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :too_many_requests
   end
+  test "create sends a code by email for a new email address" do
+    assert_difference -> { Identity.count }, 1 do
+      assert_enqueued_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: "new-joiner@example.com" }
+      end
+    end
+
+    assert_response :success
+
+    perform_enqueued_jobs
+
+    identity = Identity.find_by!(email_address: "new-joiner@example.com")
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "new-joiner@example.com" ], email.to
+    assert_includes email.subject, identity.magic_links.last.code
+  end
+
+  test "create sends a code by email for an existing identity that is not signed in" do
+    identity = identities(:jz)
+
+    assert_no_difference -> { Identity.count } do
+      assert_enqueued_emails 1 do
+        post join_path(code: @join_code.code, script_name: @account.slug), params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_response :success
+  end
+
+  test "create with a code joins the account" do
+    identity = Identity.create!(email_address: "new-joiner@example.com")
+    magic_link = identity.magic_links.create!
+
+    assert_difference -> { User.count }, 1 do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { code: magic_link.code }
+    end
+
+    assert identity.users.exists?(account: @account), "Identity should be a member of the account"
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+  end
+
+  test "create with a code for an existing member redirects to the landing page" do
+    identity = identities(:jz)
+    magic_link = identity.magic_links.create!
+
+    assert_no_difference -> { User.count } do
+      post join_path(code: @join_code.code, script_name: @account.slug), params: { code: magic_link.code }
+    end
+
+    assert cookies[:session_token].present?
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create with an invalid code" do
+    assert_no_difference -> { User.count } do
