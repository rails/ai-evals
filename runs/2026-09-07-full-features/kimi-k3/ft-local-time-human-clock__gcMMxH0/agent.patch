+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "comment times render as raw timestamps, identical for every viewer timezone" do
+    comment = comments(:logo_agreement_kevin)
+
+    cookies[:timezone] = "America/Chicago"
+    get card_path(comment.card)
+    chicago_html = response.body
+
+    cookies[:timezone] = "Australia/Sydney"
+    get card_path(comment.card)
+    sydney_html = response.body
+
+    expected_tag = %(<time datetime="#{comment.created_at.utc.iso8601}" data-local-time-style-value="datetime" data-controller="local-time">)
+
+    assert_includes chicago_html, expected_tag
+    assert_includes sydney_html, expected_tag
+    assert_equal comment_html(chicago_html, comment), comment_html(sydney_html, comment)
+  end
+
+  test "cached comment fragments are shared between viewer timezones" do
+    comment = comments(:logo_agreement_kevin)
+
+    with_actionview_partial_caching do
+      cookies[:timezone] = "America/Chicago"
+      get card_path(comment.card)
+
+      cookies[:timezone] = "Australia/Sydney"
+      get card_path(comment.card)
+
+      assert_includes response.body, %(<time datetime="#{comment.created_at.utc.iso8601}")
+    end
+  end
+
+  test "card meta and closure notice render local-time elements" do
+    card = cards(:logo)
+
+    get card_path(card)
+
+    assert_select "time[data-local-time-style-value=ago][datetime=?]", card.created_at.utc.iso8601
+    assert_select "time[data-local-time-style-value=ago][datetime=?]", card.last_active_at.utc.iso8601
+    assert_select "time[data-local-time-style-value=until][datetime=?]", card.entropy.auto_clean_at.utc.iso8601
+  end
+
+  test "closed card stamps render local-time elements" do
+    card = cards(:logo)
+    card.close(user: users(:david))
+
+    get card_path(card)
+
+    assert_select "time[data-local-time-style-value=long_date][datetime=?]", card.closed_at.utc.iso8601
+    assert_select "time[data-local-time-style-value=date][datetime=?]", card.closed_at.utc.iso8601
+  end
+
+  test "notification times render as local-time elements" do
+    notification = notifications(:logo_assignment_kevin)
+
+    get notifications_path
+
+    assert_select "time[data-local-time-style-value=date][datetime=?]", notification.created_at.utc.iso8601
+  end
+
+  test "event times render as local-time elements" do
+    day = 1.week.ago.to_date
+
+    get events_path(day: day)
+
+    assert_select "time[data-local-time-style-value=weekday_date][datetime=?]", day.iso8601
+    assert_select "time[data-local-time-style-value=time]"
+  end
+
+  test "days without activity render calendar-date elements" do
+    day = 2.days.ago.to_date  # no fixture events on this day
+
+    get events_path(day: day)
+
+    assert_select ".events__none time[data-local-time-style-value=weekday_date][datetime=?]", 6.days.ago.to_date.iso8601
+    assert_select ".events__none time[data-local-time-style-value=weekday_date][datetime=?]", 3.days.ago.to_date.iso8601
+  end
+
+  test "webhook delivery times render as local-time elements" do
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.first
+
+    get board_webhook_path(webhook.board, webhook)
+
+    assert_select "time[data-local-time-style-value=ago][datetime=?]", delivery.created_at.utc.iso8601
+  end
+
+  test "access token times render as local-time elements" do
+    access_token = users(:kevin).identity.access_tokens.create!(description: "Test token")
+
+    get my_access_tokens_path
+
+    assert_select "time[data-local-time-style-value=short][datetime=?]", access_token.created_at.utc.iso8601
+  end
