+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    @recent = comment_on_card(@card, created_at: Time.current.beginning_of_day + 12.hours)
+    @last_night = comment_on_card(@card, created_at: 1.day.ago)
+    @this_week = comment_on_card(@card, created_at: 3.days.ago)
+    @older = comment_on_card(@card, created_at: 10.days.ago)
+  end
+
+  test "comment timestamps render as words in the browser" do
+    sign_in_as users(:kevin)
+    visit card_path(@card)
+
+    # Two hours ago -> "1:42 PM"
+    within "##{dom_id(@recent)}" do
+      assert_selector "time[datetime='#{@recent.created_at.utc.iso8601}']", text: /\d{1,2}:\d{2} [AP]M/
+    end
+
+    # Last night -> "yesterday"
+    within "##{dom_id(@last_night)}" do
+      assert_selector "time", text: /yesterday/i
+    end
+
+    # Earlier in the week -> "3 days ago"
+    within "##{dom_id(@this_week)}" do
+      assert_selector "time", text: /3 days ago/i
+    end
+
+    # Older -> "Aug 29"
+    within "##{dom_id(@older)}" do
+      assert_selector "time", text: @older.created_at.strftime("%b %-d")
+    end
+  end
+
+  test "comment timestamps render in the viewer's timezone" do
+    sign_in_as users(:kevin)
+    visit card_path(@card)
+
+    utc_text = timestamp_text_for(@recent)
+
+    with_timezone_override "Australia/Sydney" do
+      sydney_text = timestamp_text_for(@recent)
+
+      assert_equal @recent.created_at.in_time_zone("UTC").strftime("%-l:%M %p").strip, utc_text
+      assert_equal @recent.created_at.in_time_zone("Australia/Sydney").strftime("%-l:%M %p").strip, sydney_text
+      assert_not_equal utc_text, sydney_text
+    end
+  end
+
+  test "card auto-closing reads as words in the browser" do
+    @card.update!(last_active_at: 1.day.from_now - @card.auto_postpone_period)
+
+    sign_in_as users(:kevin)
+    visit card_path(@card)
+
+    assert_selector "time[data-local-time-style-value='until']", text: /tomorrow/i
+
+    @card.update!(last_active_at: 3.days.from_now - @card.auto_postpone_period)
+    visit card_path(@card)
+
+    assert_selector "time[data-local-time-style-value='until']", text: /in 3 days/i
+  end
+
+  test "card meta renders relative times in the browser" do
+    sign_in_as users(:kevin)
+    visit board_path(boards(:writebook))
+
+    assert_selector ".card__meta time[data-local-time-style-value='ago']", text: /\d+ days ago/
+  end
+
+  test "event timestamps render in the browser" do
+    day = 1.week.ago.to_date
+
+    sign_in_as users(:kevin)
+    visit root_path(day: day)
+
+    assert_selector ".event__timestamp time[data-local-time-style-value='time']", text: /\d{1,2}:\d{2} [AP]M/
+    assert_selector ".events__column-header time[data-local-time-style-value='weekday_date']", text: /#{day.strftime("%A, %B %-d")}/i
+  end
+
+  private
+    def comment_on_card(card, created_at:)
+      card.comments.create!(body: "Hello", creator: users(:kevin), created_at: created_at)
+    end
+
+    def timestamp_text_for(comment)
+      within "##{dom_id(comment)}" do
+        find("time").text
+      end
+    end
+
+    def with_timezone_override(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      visit current_path
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    end
+
+    def dom_id(record)
+      ActionView::RecordIdentifier.dom_id(record)
+    end
+end
