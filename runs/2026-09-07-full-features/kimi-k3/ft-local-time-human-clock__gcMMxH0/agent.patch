diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..42d3b3f
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include TimeHelper
+
+  test "local_time_tag renders a time element carrying the raw timestamp" do
+    tag = local_time_tag(Time.zone.parse("2025-09-12 1:42 PM"), :datetime)
+
+    assert_dom_equal %(<time datetime="2025-09-12T13:42:00Z" data-local-time-style-value="datetime" data-controller="local-time">Sep 12, 2025, 1:42 PM UTC</time>), tag
+  end
+
+  test "local_time_tag renders timestamps in UTC so the HTML is identical for everyone" do
+    time = Time.zone.parse("2025-09-12 1:42 PM")
+
+    assert_equal local_time_tag(time, :datetime), Time.use_zone("Australia/Sydney") { local_time_tag(time, :datetime) }
+  end
+
+  test "local_time_tag renders dates as calendar days without a time of day" do
+    tag = local_time_tag(Date.new(2025, 9, 12), :weekday_date)
+
+    assert_dom_equal %(<time datetime="2025-09-12" data-local-time-style-value="weekday_date" data-controller="local-time">Sep 12, 2025</time>), tag
+  end
+
+  test "local_time_tag passes through attributes" do
+    tag = local_time_tag(Time.utc(2025, 9, 12, 13, 42), :ago, class: "card__timestamp")
+
+    assert_dom_equal %(<time class="card__timestamp" datetime="2025-09-12T13:42:00Z" data-local-time-style-value="ago" data-controller="local-time">Sep 12, 2025, 1:42 PM UTC</time>), tag
+  end
+
+  test "local_time_tag merges with an existing controller" do
+    tag = local_time_tag(Time.utc(2025, 9, 12, 13, 42), :ago, data: { controller: "tooltip" })
+
+    assert_includes tag, %(data-controller="local-time tooltip")
+  end
+end
