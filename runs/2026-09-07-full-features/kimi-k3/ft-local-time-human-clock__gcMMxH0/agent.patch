diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..e5c7a4e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,41 @@
 module TimeHelper
+  # Renders a <time> element carrying the raw timestamp in its datetime
+  # attribute. The local-time Stimulus controller puts it into words in the
+  # browser, in the viewer's own timezone, so the server-rendered HTML stays
+  # identical for everyone and can be cached and shared.
+  #
+  # Styles:
+  #   :ago          "just now", "5 minutes ago", "yesterday", "5 days ago"
+  #   :until        "today", "tomorrow", "in 3 days"
+  #   :datetime     "1:42 PM", "yesterday", "5 days ago", "Sep 12"
+  #   :date         "Sep 12" or "Sep 12, 2024" when another year
+  #   :long_date    "Sep 12, 2025"
+  #   :weekday_date "Friday, September 12"
+  #   :time         "1:42 PM"
+  #   :short        "9/12/25, 1:42 PM"
+  def local_time_tag(time, style, **attributes)
+    data = attributes.delete(:data) || {}
+    data[:controller] = [ "local-time", data[:controller] ].compact_blank.join(" ")
+
+    tag.time fallback_content(time), datetime: iso8601_in_utc(time),
+      data: { local_time_style_value: style, **data }, **attributes
+  end
+
+  private
+    def iso8601_in_utc(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        # Dates name a calendar day, not an instant: no timezone to normalize
+        time.iso8601
+      end
+    end
+
+    def fallback_content(time)
+      if time.respond_to?(:utc)
+        time.utc.strftime("%b %-d, %Y, %-l:%M %p UTC")
+      else
+        time.strftime("%b %-d, %Y")
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..edd255d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/local_time_helpers"
+
+// Rewrites the contents of a <time datetime="..."> element -- rendered by the
+// server with a raw timestamp -- as words in the viewer's own timezone.
+// Re-renders whenever the timestamp or the contents change, e.g. after a
+// Turbo morph refresh restores the server-rendered fallback.
+export default class extends Controller {
+  static values = { style: { type: String, default: "datetime" } }
+
+  connect() {
+    this.#render()
+
+    this.observer = new MutationObserver(() => this.#render())
+    this.observer.observe(this.element, { childList: true, characterData: true, subtree: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+  }
+
+  #render() {
+    const text = formatLocalTime(this.date, this.styleValue)
+
+    if (text && this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+  }
+
+  get date() {
+    return parseLocalTime(this.element.getAttribute("datetime"))
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..97b151d
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,105 @@
+const MINUTE_IN_SECONDS = 60
+const HOUR_IN_SECONDS = 60 * MINUTE_IN_SECONDS
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+
+const timeFormatter = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" })
+const dateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" })
+const longDateFormatter = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" })
+const weekdayDateFormatter = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" })
+const shortDateTimeFormatter = new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit", hour: "numeric", minute: "2-digit" })
+
+// Turns a raw timestamp into words, in the viewer's own timezone.
+export function formatLocalTime(date, style, now = new Date()) {
+  if (isNaN(date)) return ""
+
+  switch (style) {
+    case "ago": return timeAgo(date, now)
+    case "until": return timeUntil(date, now)
+    case "datetime": return smartDatetime(date, now)
+    case "date": return localDate(date, now)
+    case "long_date": return longDateFormatter.format(date)
+    case "weekday_date": return weekdayDateFormatter.format(date)
+    case "time": return timeFormatter.format(date)
+    case "short": return shortDateTimeFormatter.format(date)
+    default: return smartDatetime(date, now)
+  }
+}
+
+export function parseLocalTime(value) {
+  const calendarDate = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || "")
+
+  if (calendarDate) {
+    // Date-only values name a calendar day, not an instant: parse them as
+    // local time so the day doesn't shift with the viewer's timezone.
+    const [ , year, month, day ] = calendarDate
+    return new Date(year, month - 1, day)
+  } else {
+    return new Date(value)
+  }
+}
+
+// "just now", "5 minutes ago", "3 hours ago", "yesterday", "5 days ago"
+function timeAgo(date, now) {
+  const seconds = Math.floor((now - date) / 1000)
+  const days = differenceInCalendarDays(date, now)
+
+  if (seconds < MINUTE_IN_SECONDS) return "just now"
+  if (seconds < HOUR_IN_SECONDS) return `${pluralize(Math.floor(seconds / MINUTE_IN_SECONDS), "minute")} ago`
+  if (days === 0 && seconds < 24 * HOUR_IN_SECONDS) return `${pluralize(Math.floor(seconds / HOUR_IN_SECONDS), "hour")} ago`
+  if (days <= 1) return "yesterday"
+  if (days < 30) return `${pluralize(days, "day")} ago`
+
+  const months = Math.floor(days / 30)
+  if (months < 12) return `${pluralize(months, "month")} ago`
+
+  return `${pluralize(Math.max(1, Math.round(days / 365)), "year")} ago`
+}
+
+// "today", "tomorrow", "in 3 days", "in 2 weeks"
+function timeUntil(date, now) {
+  const days = differenceInCalendarDays(now, date)
+
+  if (days <= 0) return "today"
+  if (days === 1) return "tomorrow"
+  if (days < 7) return `in ${pluralize(days, "day")}`
+
+  const weeks = Math.round(days / 7)
+  if (days < 30) return `in ${pluralize(weeks, "week")}`
+
+  const months = Math.floor(days / 30)
+  if (months < 12) return `in ${pluralize(months, "month")}`
+
+  return `in ${pluralize(Math.max(1, Math.round(days / 365)), "year")}`
+}
+
+// "1:42 PM" today, "yesterday", "5 days ago" this week, "Sep 12" after that
+function smartDatetime(date, now) {
+  const days = differenceInCalendarDays(date, now)
+
+  if (days === 0) return timeFormatter.format(date)
+  if (days === 1) return "yesterday"
+  if (days > 1 && days < 7) return timeAgo(date, now)
+
+  return localDate(date, now)
+}
+
+// "Sep 12", or "Sep 12, 2024" when another year
+function localDate(date, now) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return dateFormatter.format(date)
+  } else {
+    return longDateFormatter.format(date)
+  }
+}
+
+function differenceInCalendarDays(from, to) {
+  return Math.round((startOfDay(to) - startOfDay(from)) / DAY_IN_MILLISECONDS)
+}
+
+function startOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function pluralize(count, noun) {
+  return `${count} ${noun}${count === 1 ? "" : "s"}`
+}
