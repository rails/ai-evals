+<button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="reaction#expandForm">
+  <%= image_tag "boost-color.svg", aria: { hidden: true }, alt: "" %>
+  <span class="for-screen-reader">Add a reaction</span>
+</button>
+
+<%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction, class: "reaction__form", html: { hidden: true },
+      data: { controller: "form", reaction_target: "form", action: "submit->form#preventEmptySubmit submit->form#preventComposingSubmit" } do |form| %>
+  <label class="reaction__form-label">
+    <span class="for-screen-reader">Your reaction</span>
+    <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "reaction__input input", maxlength: Reaction::MAX_CONTENT_LENGTH, placeholder: "Add a reaction…", autocomplete: "off",
+          data: { form_target: "input", reaction_target: "input", action: "keydown.esc->reaction#collapseForm" } %>
+  </label>
+
+  <span class="reaction__menu" data-controller="dialog" data-action="click@document->dialog#closeOnClickOutside">
+    <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle" title="Pick an emoji">
+      <%= icon_tag "reaction" %>
+      <span class="for-screen-reader">Pick an emoji</span>
+    </button>
+
+    <dialog class="reaction__popup popup panel" data-dialog-target="dialog" data-action="keydown.esc->dialog#close">
+      <span class="reaction__emoji-list">
+        <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+          <button type="button" class="btn btn--circle borderless" title="<%= label %>" data-action="reaction#selectEmoji" data-reaction-emoji-param="<%= emoji %>"><%= emoji %></button>
+        <% end %>
+      </span>
+    </dialog>
+  </span>
+
+  <button type="submit" class="reaction__submit-btn btn btn--circle borderless" title="Confirm reaction">
+    <%= icon_tag "check" %>
+    <span class="for-screen-reader">Confirm reaction</span>
+  </button>
+
+  <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction#collapseForm" title="Cancel">
+    <%= icon_tag "close" %>
+    <span class="for-screen-reader">Cancel</span>
+  </button>
+<% end %>
