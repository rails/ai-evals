@@ -0,0 +1,80 @@
+# Activities
+
+Activities are the events that make up the account timeline: cards being added, moved, triaged, assigned, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activities from boards the current user has access to, newest first.
+
+The kinds of events returned mirror the HTML timeline, except that deprecated `card_collection_changed` events are omitted and `card_title_changed` events are included:
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `board_ids[]` | Filter by board ID(s) |
+| `creator_ids[]` | Filter by the user ID(s) who made the change |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-11-19T04:03:58.000Z",
+    "description": "David assigned JZ to \"The logo isn't big enough\"",
+    "particulars": {
+      "assignee_ids": [ "03f5v9zjw7pz8717a4no1h8a7" ]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 1,
+      "title": "The logo isn't big enough",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zpjaaly2z5nbsfjs2pi",
+      "name": "Writebook",
+      "all_access": true
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `url` of a card event opens the card. The `url` of a `comment_created` event opens the card where the comment was posted and jumps to that comment.
+
+The `particulars` object exposes event-specific details:
+
+- `card_assigned` and `card_unassigned` events contain `assignee_ids`
+- `card_board_changed` events contain `old_board` and `new_board`
+- `card_title_changed` events contain `old_title` and `new_title`
+- `card_triaged` events contain `column`
+
+Other events return an empty `particulars` object. Missing board, title, or column values are returned as empty strings.
+
+The `eventable`, `board`, and `creator` attributes use the same representations as the card, board, and user endpoints.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..e7f49ea
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,211 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:kevin)
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    expected = Event.where(action: ActivitiesController::ACTIONS).order(created_at: :desc, id: :desc)
+    assert_equal expected.ids, @response.parsed_body.pluck("id")
+  end
+
+  test "index defaults to JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json; charset=utf-8", @response.headers["Content-Type"]
+  end
+
+  test "index rejects HTML" do
+    get activities_path(format: :html)
+
+    assert_response :not_acceptable
+  end
+
+  test "index requires authentication" do
+    sign_out
+
+    get activities_path, as: :json, env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+
+    assert_response :unauthorized
+  end
+
+  test "index as JSON with a bearer token" do
+    get activities_path, env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+  end
+
+  test "activity contains the API representations of its eventable, board, and creator" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:logo_assignment_jz).created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal events(:logo_assignment_jz).description_for(users(:kevin)).to_plain_text, activity["description"]
+
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal boards(:writebook).name, activity.dig("board", "name")
+
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_equal users(:david).name, activity.dig("creator", "name")
+
+    assert_equal card_url(cards(:logo)), activity["url"]
+  end
+
+  test "comment activities link to the comment on its card" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:layout_commented).id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+    assert_equal card_url(comments(:layout_overflowing_david).card, anchor: "comment_#{comments(:layout_overflowing_david).id}"), activity["url"]
+  end
+
+  test "assignment activities include assignee ids in particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+  end
+
+  test "board change activities include old and new boards in particulars" do
+    boards(:writebook).events.create! \
+      action: "card_board_changed",
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      particulars: { particulars: { old_board: "Writebook", new_board: "Private" } }
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["action"] == "card_board_changed" }
+    assert_equal "Writebook", activity.dig("particulars", "old_board")
+    assert_equal "Private", activity.dig("particulars", "new_board")
+  end
+
+  test "title change activities include old and new titles in particulars" do
+    cards(:logo).update! title: "The logo is definitely too small"
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["action"] == "card_title_changed" }
+    assert activity.present?, "Expected a card_title_changed activity"
+
+    assert_equal "The logo isn't big enough", activity.dig("particulars", "old_title")
+    assert_equal "The logo is definitely too small", activity.dig("particulars", "new_title")
+  end
+
+  test "triage activities include the column in particulars" do
+    cards(:buy_domain).triage_into columns(:writebook_in_progress)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["action"] == "card_triaged" }
+    assert activity.present?, "Expected a card_triaged activity"
+
+    assert_equal "In progress", activity.dig("particulars", "column")
+  end
+
+  test "missing particular values are returned as empty strings" do
+    boards(:writebook).events.create! action: "card_triaged", creator: users(:kevin), eventable: cards(:logo)
+    boards(:writebook).events.create! action: "card_board_changed", creator: users(:kevin), eventable: cards(:logo)
+    boards(:writebook).events.create! action: "card_title_changed", creator: users(:kevin), eventable: cards(:logo)
+
+    get activities_path, as: :json
+
+    assert_equal "", @response.parsed_body.find { |record| record["action"] == "card_triaged" }.dig("particulars", "column")
+    assert_equal({ "old_board" => "", "new_board" => "" }, @response.parsed_body.find { |record| record["action"] == "card_board_changed" }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, @response.parsed_body.find { |record| record["action"] == "card_title_changed" }["particulars"])
+  end
+
+  test "other activities return empty particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "deprecated card_collection_changed activities are omitted" do
+    boards(:writebook).events.create! action: "card_collection_changed", creator: users(:kevin), eventable: cards(:logo)
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.pluck("action"), "card_collection_changed"
+  end
+
+  test "index can be filtered by creator_ids" do
+    get activities_path, params: { creator_ids: [ users(:david).id ] }, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_equal [ users(:david).id ], @response.parsed_body.map { |record| record.dig("creator", "id") }.uniq
+  end
+
+  test "index can be filtered by board_ids" do
+    card = boards(:private).cards.create!(creator: users(:kevin), title: "Secret card", status: :published)
+    event = Event.where(board: boards(:private)).sole
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_equal [ event.id ], @response.parsed_body.pluck("id")
+    assert_equal card.id, @response.parsed_body.sole.dig("eventable", "id")
+  end
+
+  test "index only returns activity from boards the current user can access" do
+    boards(:private).cards.create!(creator: users(:kevin), title: "Secret card", status: :published)
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal boards(:writebook).id, @response.parsed_body.map { |record| record.dig("board", "id") }.uniq.sole
+  end
+
+  test "filtering by an inaccessible board returns nothing" do
+    boards(:private).cards.create!(creator: users(:kevin), title: "Secret card", status: :published)
+
+    logout_and_sign_in_as :david
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index paginates with a Link header" do
+    ratios = GearedPagination::Ratios.new([ 2 ])
+    GearedPagination::Ratios.stubs(:new).returns(ratios)
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal 2, @response.parsed_body.size
+    assert_match(/<[^>]+>; rel="next"/, @response.headers["Link"])
+
+    get next_page_from_link_header(@response.headers["Link"]), as: :json
+    assert_response :success
+    assert_equal 2, @response.parsed_body.size
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
