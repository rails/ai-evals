@@ -0,0 +1,35 @@
+class ActivitiesController < ApplicationController
+  # Mirrors the kinds of events shown in the HTML timeline, except that
+  # deprecated +card_collection_changed+ events are omitted and
+  # +card_title_changed+ events are included.
+  ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  def index
+    respond_to do |format|
+      format.json do
+        set_page_and_extract_portion_from activities
+      end
+    end
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.preloaded.where(action: ACTIONS).order(created_at: :desc, id: :desc)
+      events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..c010d75
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,18 @@
+module ActivitiesHelper
+  def activity_particulars(activity)
+    case activity.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: activity.assignee_ids || [] }
+    when "card_board_changed"
+      { old_board: activity.particulars.dig("particulars", "old_board") || "",
+        new_board: activity.particulars.dig("particulars", "new_board") || "" }
+    when "card_title_changed"
+      { old_title: activity.particulars.dig("particulars", "old_title") || "",
+        new_title: activity.particulars.dig("particulars", "new_title") || "" }
+    when "card_triaged"
+      { column: activity.particulars.dig("particulars", "column") || "" }
+    else
+      {}
+    end
+  end
+end
