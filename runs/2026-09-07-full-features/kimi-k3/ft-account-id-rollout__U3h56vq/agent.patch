diff --git a/db/migrate/20260710120000_add_account_id_to_remaining_tables.rb b/db/migrate/20260710120000_add_account_id_to_remaining_tables.rb
new file mode 100644
index 0000000..cef2e7b
--- /dev/null
+++ b/db/migrate/20260710120000_add_account_id_to_remaining_tables.rb
@@ -0,0 +1,131 @@
+class AddAccountIdToRemainingTables < ActiveRecord::Migration[8.2]
+  # Finishes the multi-tenant rollout: every table holding an account's data
+  # gets a required, indexed account_id. Rows whose account can't be resolved
+  # are orphaned and dropped.
+
+  # table => [ parent table, foreign key ] for rows whose account comes
+  # straight from a parent record (accesses.board_id -> boards.account_id).
+  BACKFILL_VIA_PARENT = {
+    "accesses" => %w[ boards board_id ],
+    "assignments" => %w[ cards card_id ],
+    "board_publications" => %w[ boards board_id ],
+    "card_activity_spikes" => %w[ cards card_id ],
+    "card_goldnesses" => %w[ cards card_id ],
+    "card_not_nows" => %w[ cards card_id ],
+    "closures" => %w[ cards card_id ],
+    "pins" => %w[ cards card_id ],
+    "search_queries" => %w[ users user_id ],
+    "taggings" => %w[ cards card_id ],
+    "user_settings" => %w[ users user_id ],
+    "watches" => %w[ cards card_id ],
+    "webhook_delinquency_trackers" => %w[ webhooks webhook_id ],
+    "webhook_deliveries" => %w[ webhooks webhook_id ]
+  }
+
+  # table => [ polymorphic association, { record type => record table } ] for
+  # rows whose account comes through a polymorphic parent. "Account" containers
+  # carry their own id. Rich texts must be backfilled before the attachments
+  # that point at them.
+  BACKFILL_VIA_POLYMORPHIC = {
+    "entropies" => [ "container", { "Account" => "accounts", "Board" => "boards" } ],
+    "mentions" => [ "source", { "Card" => "cards", "Comment" => "comments" } ],
+    "reactions" => [ "reactable", { "Card" => "cards", "Comment" => "comments" } ],
+    "action_text_rich_texts" => [ "record", { "Card" => "cards", "Comment" => "comments", "Board" => "boards" } ],
+    "active_storage_attachments" => [ "record", {
+      "Card" => "cards", "Comment" => "comments", "Board" => "boards", "User" => "users",
+      "Export" => "exports", "Account::Import" => "account_imports", "ActionText::RichText" => "action_text_rich_texts"
+    } ]
+  }
+
+  TABLES = BACKFILL_VIA_PARENT.keys | BACKFILL_VIA_POLYMORPHIC.keys | %w[ active_storage_blobs active_storage_variant_records ]
+
+  def up
+    add_account_id_columns
+    backfill_account_ids
+    drop_orphaned_rows
+    index_and_require_account_ids
+    scope_tag_titles_to_accounts
+  end
+
+  def down
+    remove_index :tags, %i[ account_id title ]
+    add_index :tags, :title, unique: true
+
+    TABLES.each do |table|
+      remove_index table, :account_id
+      remove_column table, :account_id
+    end
+  end
+
+  private
+    def add_account_id_columns
+      TABLES.each do |table|
+        add_column table, :account_id, :uuid
+      end
+    end
+
+    def backfill_account_ids
+      BACKFILL_VIA_PARENT.each do |table, (parent_table, foreign_key)|
+        execute <<~SQL
+          UPDATE #{table}
+          SET account_id = (SELECT #{parent_table}.account_id FROM #{parent_table} WHERE #{parent_table}.id = #{table}.#{foreign_key})
+        SQL
+      end
+
+      BACKFILL_VIA_POLYMORPHIC.each do |table, (association, record_tables)|
+        record_tables.each do |record_type, record_table|
+          if record_type == "Account"
+            execute <<~SQL
+              UPDATE #{table}
+              SET account_id = #{table}.#{association}_id
+              WHERE #{association}_type = '#{record_type}'
+            SQL
+          else
+            execute <<~SQL
+              UPDATE #{table}
+              SET account_id = (SELECT #{record_table}.account_id FROM #{record_table} WHERE #{record_table}.id = #{table}.#{association}_id)
+              WHERE #{association}_type = '#{record_type}'
+            SQL
+          end
+        end
+      end
+
+      execute <<~SQL
+        UPDATE active_storage_blobs
+        SET account_id = (SELECT MIN(active_storage_attachments.account_id) FROM active_storage_attachments WHERE active_storage_attachments.blob_id = active_storage_blobs.id)
+      SQL
+
+      execute <<~SQL
+        UPDATE active_storage_variant_records
+        SET account_id = (SELECT active_storage_blobs.account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+      SQL
+    end
+
+    def drop_orphaned_rows
+      TABLES.each do |table|
+        execute <<~SQL
+          DELETE FROM #{table}
+          WHERE account_id IS NULL OR account_id NOT IN (SELECT id FROM accounts)
+        SQL
+      end
+
+      execute <<~SQL
+        DELETE FROM active_storage_variant_records WHERE blob_id NOT IN (SELECT id FROM active_storage_blobs)
+      SQL
+    end
+
+    def index_and_require_account_ids
+      TABLES.each do |table|
+        change_column_null table, :account_id, false
+        add_index table, :account_id
+      end
+    end
+
+    # Tag titles were globally unique before multi-tenancy; now they're unique
+    # per account. Existing data can't violate this since titles were globally
+    # unique.
+    def scope_tag_titles_to_accounts
+      remove_index :tags, :title
+      add_index :tags, %i[ account_id title ], unique: true
+    end
+end
