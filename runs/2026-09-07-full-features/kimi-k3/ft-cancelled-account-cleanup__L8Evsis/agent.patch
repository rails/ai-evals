diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..97542f9
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago along with their data" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:jason))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not User.where(account_id: account.id).exists?
+    assert_not Board.where(account_id: account.id).exists?
+    assert_not Card.where(account_id: account.id).exists?
+  end
+
+  test "incinerates all due accounts" do
+    due_accounts = [ accounts(:"37s"), accounts(:initech) ]
+    due_accounts.each do |account|
+      account.cancel(initiated_by: users(:jason))
+      account.cancellation.update!(created_at: 60.days.ago)
+    end
+
+    assert_difference -> { Account.count }, -2 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    due_accounts.each { |account| assert_not Account.exists?(account.id) }
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:jason))
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "keeps accounts that are not cancelled" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "runs without an account context, as when enqueued by solid queue recurring" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:jason))
+    account.cancellation.update!(created_at: 31.days.ago)
+
+    Current.clear_all
+    Account::IncinerateDueJob.perform_later
+
+    perform_enqueued_jobs
+
+    assert_not Account.exists?(account.id)
+    assert_not Card.where(account_id: account.id).exists?
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..bc0ff64
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "due_for_incineration includes accounts cancelled more than 30 days ago" do
+    cancel_account @account, cancelled_at: 31.days.ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration includes accounts cancelled exactly at the grace period cutoff" do
+  cancel_account @account, cancelled_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago
+
+  assert_includes Account.due_for_incineration, @account
+end
+
+test "due_for_incineration excludes accounts cancelled less than 30 days ago" do
+    cancel_account @account, cancelled_at: 29.days.ago
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts that are not cancelled" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    cancel_account @account, cancelled_at: 31.days.ago
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "incinerate permanently removes the account and all its data" do
+    account_id = @account.id
+
+    assert Card.where(account_id: account_id).exists?
+    assert Comment.where(account_id: account_id).exists?
+
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert_not Account::Cancellation.where(account_id: account_id).exists?
+    assert_not Account::JoinCode.where(account_id: account_id).exists?
+    assert_not User.where(account_id: account_id).exists?
+    assert_not Board.where(account_id: account_id).exists?
+    assert_not Column.where(account_id: account_id).exists?
+    assert_not Card.where(account_id: account_id).exists?
+    assert_not Comment.where(account_id: account_id).exists?
+    assert_not Event.where(account_id: account_id).exists?
+    assert_not Notification.where(account_id: account_id).exists?
+    assert_not Tag.where(account_id: account_id).exists?
+    assert_not Webhook.where(account_id: account_id).exists?
+    assert_not Access.where(account_id: account_id).exists?
+    assert_not Entropy.where(account_id: account_id).exists?
+    assert_not Search::Record.where(account_id: account_id).exists?
+  end
+
+  test "incinerate keeps global identities around" do
+    identity = users(:david).identity
+
+    @account.incinerate
+
+    assert Identity.exists?(identity.id)
+  end
+
+  test "incinerate_due incinerates only accounts past the grace period" do
+    due_account = @account
+    recent_account = accounts(:initech)
+    active_account = accounts(:acme)
+
+    cancel_account due_account, cancelled_at: 31.days.ago
+    cancel_account recent_account, cancelled_at: 1.day.ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+    assert Account.exists?(active_account.id)
+  end
+
+  private
+    def cancel_account(account, cancelled_at:)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: cancelled_at)
+    end
+end
