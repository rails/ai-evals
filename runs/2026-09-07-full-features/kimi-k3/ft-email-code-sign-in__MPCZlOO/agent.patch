@@ -0,0 +1,27 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p class="margin-none txt-medium">We sent a sign-in code to <strong><%= @email_address %></strong>. Enter it below to continue. The code is good for the next 15 minutes.</p>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.hidden_field :email_address, value: @email_address %>
+    <%= form.hidden_field :join_code, value: @join_code if @join_code %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your sign-in code…" %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
