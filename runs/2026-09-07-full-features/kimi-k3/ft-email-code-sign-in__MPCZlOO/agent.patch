@@ -0,0 +1,173 @@
+require "test_helper"
+
+class Sessions::CodesControllerTest < ActionDispatch::IntegrationTest
+  test "new" do
+    untenanted do
+      get new_session_code_path(email_address: "someone@example.com")
+
+      assert_response :success
+      assert_in_body "someone@example.com"
+      assert_select "form[action=?]", session_code_path do
+        assert_select "input[name=code]"
+        assert_select "input[name=email_address][value=?]", "someone@example.com"
+      end
+    end
+  end
+
+  test "new without an email address" do
+    untenanted do
+      get new_session_code_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create with a valid code signs in" do
+    identity = identities(:kevin)
+    email_code = EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path, params: { email_address: identity.email_address, code: email_code.code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with a valid code for a new email address starts the sign up flow" do
+    email_code = EmailCode.deliver_to("new@example.com")
+
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        post session_code_path, params: { email_address: "new@example.com", code: email_code.code }
+      end
+
+      assert_redirected_to new_signup_completion_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with a valid code and a join code joins the account" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_code = EmailCode.deliver_to("new@example.com")
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_code_path, params: { email_address: "new@example.com", code: email_code.code, join_code: join_code.code }
+      end
+
+      assert_redirected_to new_session_start_url(script_name: account.slug)
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with a valid code and a join code for an existing member" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    identity = identities(:kevin)
+    email_code = EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_code_path, params: { email_address: identity.email_address, code: email_code.code, join_code: join_code.code }
+      end
+
+      assert_redirected_to new_session_start_url(script_name: account.slug)
+    end
+  end
+
+  test "create with a valid code while signed in as someone else switches identities" do
+    sign_in_as :kevin
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_code = EmailCode.deliver_to("new@example.com")
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_code_path, params: { email_address: "new@example.com", code: email_code.code, join_code: join_code.code }
+      end
+
+      assert_redirected_to new_session_start_url(script_name: account.slug)
+    end
+
+    identity = Identity.find_by(email_address: "new@example.com")
+    assert identity.users.exists?(account: account)
+    assert_equal identity.id, Session.find_signed(parsed_cookies.signed[:session_token]).identity_id
+  end
+
+  test "create with an invalid code" do
+    identity = identities(:kevin)
+    EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path, params: { email_address: identity.email_address, code: "WRONG!" }
+
+      assert_redirected_to new_session_code_path(email_address: identity.email_address)
+      assert cookies[:session_token].blank?
+      assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+    end
+  end
+
+  test "create with an expired code" do
+    identity = identities(:kevin)
+    email_code = EmailCode.deliver_to(identity.email_address)
+
+    travel EmailCode::EXPIRY_DURATION + 1.minute do
+      untenanted do
+        post session_code_path, params: { email_address: identity.email_address, code: email_code.code }
+
+        assert_redirected_to new_session_code_path(email_address: identity.email_address)
+        assert cookies[:session_token].blank?
+      end
+    end
+  end
+
+  test "create with a blank code" do
+    identity = identities(:kevin)
+    EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path, params: { email_address: identity.email_address, code: "" }
+
+      assert_redirected_to new_session_code_path(email_address: identity.email_address)
+      assert cookies[:session_token].blank?
+    end
+  end
+
+  test "sign in with a code via JSON" do
+    identity = identities(:kevin)
+    email_code = EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path(format: :json), params: { email_address: identity.email_address, code: email_code.code }
+
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "sign in with a wrong code via JSON" do
+    identity = identities(:kevin)
+    EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path(format: :json), params: { email_address: identity.email_address, code: "WRONG!" }
+
+      assert_response :unauthorized
+      assert response.parsed_body["message"].present?
+    end
+  end
+
+  test "create is rate limited" do
+    identity = identities(:kevin)
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_code_path, params: { email_address: identity.email_address, code: "ABC123" }
