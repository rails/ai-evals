diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..7ec2bbe
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "deliver_to creates a six-character code and sends it by email" do
+    assert_enqueued_jobs 1 do
+      email_code = EmailCode.deliver_to("someone@example.com")
+
+      assert_equal 6, email_code.code.length
+      assert_equal "someone@example.com", email_code.email_address
+    end
+  end
+
+  test "email address is normalized" do
+    email_code = EmailCode.deliver_to("  SOMEONE@example.COM ")
+
+    assert_equal "someone@example.com", email_code.email_address
+  end
+
+  test "verify consumes a matching unexpired code" do
+    email_code = EmailCode.deliver_to("someone@example.com")
+
+    assert EmailCode.verify(email_address: "someone@example.com", code: email_code.code)
+    assert_not EmailCode.exists?(email_code.id), "A code can only be used once"
+  end
+
+  test "verify with a wrong code" do
+    EmailCode.deliver_to("someone@example.com")
+
+    assert_not EmailCode.verify(email_address: "someone@example.com", code: "WRONG1")
+  end
+
+  test "verify is scoped to the email address" do
+    email_code = EmailCode.deliver_to("someone@example.com")
+
+    assert_not EmailCode.verify(email_address: "other@example.com", code: email_code.code)
+  end
+
+  test "verify ignores expired codes" do
+    email_code = EmailCode.deliver_to("someone@example.com")
+
+    travel EmailCode::EXPIRY_DURATION + 1.minute do
+      assert_not EmailCode.verify(email_address: "someone@example.com", code: email_code.code)
+    end
+  end
+
+  test "codes expire after fifteen minutes" do
+    email_code = EmailCode.deliver_to("someone@example.com")
+
+    assert_not email_code.expired?
+
+    travel EmailCode::EXPIRY_DURATION + 1.minute do
+      assert email_code.expired?
+    end
+  end
+end
