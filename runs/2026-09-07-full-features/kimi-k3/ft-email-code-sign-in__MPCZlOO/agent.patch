diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..955613f
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,39 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY_DURATION = 15.minutes
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true
+
+  before_validation :generate_code, on: :create
+
+  scope :unexpired, -> { where(created_at: EXPIRY_DURATION.ago..) }
+
+  class << self
+    def deliver_to(email_address)
+      create!(email_address: email_address).tap do |email_code|
+        IdentityMailer.sign_in_code(email_code).deliver_later
+      end
+    end
+
+    def verify(email_address:, code:)
+      if email_code = unexpired.find_by(email_address: email_address, code: code.to_s.strip)
+        email_code.destroy
+        true
+      else
+        false
+      end
+    end
+  end
+
+  def expired?
+    created_at < EXPIRY_DURATION.ago
+  end
+
+  private
+    def generate_code
+      self.code ||= SecureRandom.base58(CODE_LENGTH)
+    end
+end
