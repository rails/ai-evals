diff --git a/test/integration/email_code_flows_test.rb b/test/integration/email_code_flows_test.rb
new file mode 100644
index 0000000..caf460c
--- /dev/null
+++ b/test/integration/email_code_flows_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class EmailCodeFlowsTest < ActionDispatch::IntegrationTest
+  test "signing in by email code end to end" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      follow_redirect!
+
+      assert_response :success
+      assert_in_body "sign-in code"
+
+      post session_code_path, params: { email_address: identity.email_address, code: EmailCode.last.code }
+      assert_redirected_to landing_url
+    end
+
+    follow_redirect!
+    assert_redirected_to session_menu_url(script_name: nil)
+
+    follow_redirect!
+    assert_redirected_to root_url(script_name: accounts("37s").slug)
+  end
+
+  test "signing up by email code end to end" do
+    untenanted do
+      post signup_path, params: { signup: { email_address: "brand-new@example.com" } }
+      follow_redirect!
+
+      assert_response :success
+
+      post session_code_path, params: { email_address: "brand-new@example.com", code: EmailCode.last.code }
+      assert_redirected_to new_signup_completion_url
+
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "Brand New" } }
+      end
+
+      account = Account.last
+      assert_redirected_to landing_url(script_name: account.slug)
+    end
+  end
+
+  test "joining by email code end to end" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    get join_path(code: join_code.code, script_name: account.slug)
+    assert_response :success
+
+    post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "joiner@example.com" }
+
+    untenanted do
+      follow_redirect!
+      assert_response :success
+      assert_in_body "sign-in code"
+
+      post session_code_path, params: { email_address: "joiner@example.com", code: EmailCode.last.code, join_code: join_code.code }
+      assert_redirected_to new_session_start_url(script_name: account.slug)
+    end
+
+    follow_redirect!
+    assert_response :success
+    assert_in_body "Just a sec while we sign you in with #{account.name}"
+
+    post session_start_path(script_name: account.slug)
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+
+    identity = Identity.find_by(email_address: "joiner@example.com")
+    user = identity.users.find_by(account: account)
+    assert_not user.verified?
+
+    follow_redirect!
+    post users_verifications_path(script_name: account.slug)
+
+    assert user.reload.verified?
+  end
+
+  test "entering a wrong code asks to try again" do
+    identity = identities(:kevin)
+    EmailCode.deliver_to(identity.email_address)
+
+    untenanted do
+      post session_code_path, params: { email_address: identity.email_address, code: "NOPE12" }
+      follow_redirect!
+
+      assert_response :success
+      assert_in_body "try again"
+    end
+  end
+
+  test "an expired code is not accepted" do
+    identity = identities(:kevin)
+    email_code = EmailCode.deliver_to(identity.email_address)
+
+    travel 16.minutes do
+      untenanted do
+        post session_code_path, params: { email_address: identity.email_address, code: email_code.code }
+        assert_redirected_to new_session_code_path(email_address: identity.email_address)
+        assert cookies[:session_token].blank?
+      end
+    end
+  end
+end
