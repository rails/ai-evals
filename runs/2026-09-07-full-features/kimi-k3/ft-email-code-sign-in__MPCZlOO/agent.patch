+    @email = IdentityMailer.sign_in_code(@email_code)
+  end
+
+  test "sign_in_code is sent to the email address" do
+    assert_equal [ "someone@example.com" ], @email.to
+  end
+
+  test "sign_in_code includes the code in the subject" do
+    assert_includes @email.subject, @email_code.code
+  end
+
+  test "sign_in_code includes the code in both parts" do
+    assert_includes @email.text_part.body.to_s, @email_code.code
+    assert_includes @email.html_part.body.to_s, @email_code.code
+  end
+end
