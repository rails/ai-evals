diff --git a/lib/rails_ext/active_storage_storage_usage.rb b/lib/rails_ext/active_storage_storage_usage.rb
new file mode 100644
index 0000000..19e1fdd
--- /dev/null
+++ b/lib/rails_ext/active_storage_storage_usage.rb
@@ -0,0 +1,51 @@
+# Keeps Board#bytes_used and Account#bytes_used up to date. Storage usage
+# counts card images and files embedded in board descriptions, card
+# descriptions, and comments -- all of which flow through attachments, so
+# recalculations are enqueued from here rather than from the individual
+# models.
+#
+# When the owning board can't be resolved (e.g. the attachment's record was
+# destroyed in the same transaction), we fall back to recalculating the whole
+# account, which re-derives every board's usage from scratch.
+ActiveSupport.on_load :active_storage_attachment do
+  after_commit :recalculate_storage_usage_later, on: %i[ create destroy ]
+
+  # purge, purge_later, and detach delete the row directly, skipping destroy
+  # callbacks, so they need their own hook.
+  def delete
+    super.tap { recalculate_storage_usage_later }
+  end
+
+  private
+    def recalculate_storage_usage_later
+      if countable_for_storage_usage?
+        if board = storage_usage_board
+          board.recalculate_bytes_used_later
+        elsif account
+          account.recalculate_bytes_used_later
+        end
+      end
+    end
+
+    def countable_for_storage_usage?
+      case record_type
+      when "Card"                 then name == "image"
+      when "ActionText::RichText" then name == "embeds"
+      else                             false
+      end
+    end
+
+    def storage_usage_board
+      case record_type
+      when "Card"
+        Card.find_by(id: record_id)&.board
+      when "ActionText::RichText"
+        case ActionText::RichText.where(id: record_id).pick(:record_type, :record_id)
+        in [ "Board", board_id ]     then Board.find_by(id: board_id)
+        in [ "Card", card_id ]       then Card.find_by(id: card_id)&.board
+        in [ "Comment", comment_id ] then Comment.find_by(id: comment_id)&.card&.board
+        else nil # rich text is gone (e.g. destroyed along with its record)
+        end
+      end
+    end
+end
diff --git a/test/models/board/storage_usage_test.rb b/test/models/board/storage_usage_test.rb
new file mode 100644
index 0000000..92ec3fa
--- /dev/null
+++ b/test/models/board/storage_usage_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class Board::StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "boards and accounts start with zero usage" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, accounts("37s").bytes_used
+  end
+
+  test "attaching a card image recalculates usage in the background" do
+    assert_enqueued_with(job: Board::StorageUsageJob) do
+      attach_image @card
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal @card.image.blob.byte_size, @board.reload.bytes_used
+    assert_equal @card.image.blob.byte_size, accounts("37s").reload.bytes_used
+  end
+
+  test "files embedded in card descriptions count towards usage" do
+    blob = perform_and_return { embed_file @card, :description }
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in board descriptions count towards usage" do
+    blob = perform_and_return { embed_file @board, :public_description }
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in comments count towards usage" do
+    comment = @card.comments.create!(body: "Hello", creator: users(:david))
+    blob = perform_and_return { embed_file comment, :body }
+
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "usage is the sum of all countable attachments on the board and its cards" do
+    comment = @card.comments.create!(body: "Hello", creator: users(:david))
+
+    blobs = perform_and_return do
+      [ attach_image(@card), embed_file(@card, :description), embed_file(@board, :public_description), embed_file(comment, :body) ]
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal blobs.sum(&:byte_size), @board.reload.bytes_used
+    assert_equal blobs.sum(&:byte_size), accounts("37s").reload.bytes_used
+  end
+
+  test "usage is scoped to the board" do
+    perform_and_return { attach_image @card }
+
+    perform_enqueued_jobs
+
+    assert_equal 0, boards(:private).reload.bytes_used
+    assert_equal 0, accounts(:initech).reload.bytes_used
+  end
+
+  test "unrelated attachments do not count towards usage" do
+    perform_and_return do
+      users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "removing an embedded file from a description updates usage" do
+    perform_and_return { embed_file @card, :description }
+    perform_enqueued_jobs
+    assert @board.reload.bytes_used > 0
+
+    perform_enqueued_jobs { @card.update!(description: "No more embeds") }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "purging a card image updates usage" do
+    perform_and_return { attach_image @card }
+    perform_enqueued_jobs
+    assert @board.reload.bytes_used > 0
+
+    perform_enqueued_jobs { @card.reload.image.purge_later }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "replacing a card image updates usage" do
+    perform_and_return { attach_image @card }
+    perform_enqueued_jobs
+
+    perform_enqueued_jobs do
+      @card.reload.image.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+    end
+
+    assert_equal @card.image.blob.byte_size, @board.reload.bytes_used
+  end
+
+  test "destroying a comment removes its usage" do
+    comment = @card.comments.create!(body: "Hello", creator: users(:david))
+    perform_and_return { embed_file comment, :body }
+    perform_enqueued_jobs
+    assert @board.reload.bytes_used > 0
+
+    perform_enqueued_jobs { comment.destroy }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "destroying a card removes its usage" do
+    comment = @card.comments.create!(body: "Hello", creator: users(:david))
+    perform_and_return do
+      attach_image @card
+      embed_file @card, :description
+      embed_file comment, :body
+    end
+    perform_enqueued_jobs
+    assert @board.reload.bytes_used > 0
+
+    perform_enqueued_jobs { @card.destroy }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, accounts("37s").reload.bytes_used
+  end
+
+  test "usage moves with the card to another board" do
+    perform_and_return { attach_image @card }
+    perform_enqueued_jobs
+
+    other_board = boards(:private)
+    perform_enqueued_jobs { @card.move_to(other_board) }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal @card.image.blob.byte_size, other_board.reload.bytes_used
+    assert_equal @card.image.blob.byte_size, accounts("37s").reload.bytes_used
+  end
+
+  private
+    def attach_image(card, fixture = "moon.jpg")
+      card.image.attach io: file_fixture(fixture).open, filename: fixture, content_type: "image/jpeg"
+      card.image.blob
+    end
+
+    def embed_file(record, attribute, fixture = "avatar.png")
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture(fixture).open, filename: fixture, content_type: "image/png"
+      record.update! attribute => %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+      blob
+    end
+
+    def perform_and_return
+      result = nil
+      perform_enqueued_jobs { result = yield }
+      result
+    end
+end
