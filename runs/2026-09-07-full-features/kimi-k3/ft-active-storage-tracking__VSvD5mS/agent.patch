diff --git a/app/models/account/storage_usage.rb b/app/models/account/storage_usage.rb
new file mode 100644
index 0000000..3e286d7
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,26 @@
+# Tracks how many bytes of storage an account uses, which is the sum of the
+# usage of all its boards (see Board::StorageUsage).
+#
+# The result is stored in the +bytes_used+ column and recalculated in the
+# background (Account::StorageUsageJob), so reading it is always cheap.
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used
+    if !destroyed?
+      boards.find_each(&:recalculate_bytes_used)
+      recalculate_bytes_used_from_boards
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Account::StorageUsageJob.perform_later self
+  end
+
+  def recalculate_bytes_used_from_boards
+    if !destroyed?
+      bytes = boards.sum(:bytes_used)
+      update_column(:bytes_used, bytes) if bytes != bytes_used
+    end
+  end
+end
