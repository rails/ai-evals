diff --git a/app/models/board/storage_usage.rb b/app/models/board/storage_usage.rb
new file mode 100644
index 0000000..a83abf8
--- /dev/null
+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,48 @@
+# Tracks how many bytes of storage a board uses. Storage usage counts card
+# images and files embedded in board descriptions, card descriptions, and
+# comments (see Attachments).
+#
+# The result is stored in the +bytes_used+ column and recalculated in the
+# background (Board::StorageUsageJob) whenever a countable attachment is
+# added or removed, so reading it is always cheap.
+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used
+    if !destroyed?
+      bytes = calculate_bytes_used
+      update_column(:bytes_used, bytes) if bytes != bytes_used
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Board::StorageUsageJob.perform_later self
+  end
+
+  private
+    def calculate_bytes_used
+      card_image_bytes + embedded_file_bytes
+    end
+
+    def card_image_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embedded_file_bytes
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: countable_rich_texts.select(:id))
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def countable_rich_texts
+      board_descriptions = ActionText::RichText.where(record_type: "Board", name: "public_description", record_id: id)
+      card_descriptions = ActionText::RichText.where(record_type: "Card", name: "description", record_id: cards.select(:id))
+      comment_bodies = ActionText::RichText.where(record_type: "Comment", name: "body", record_id: Comment.where(card_id: cards.select(:id)).select(:id))
+
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+end
