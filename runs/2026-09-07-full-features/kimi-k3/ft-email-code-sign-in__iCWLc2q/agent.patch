@@ -0,0 +1,8 @@
+class IdentityMailer < ApplicationMailer
+  def login_code(login_code)
+    @login_code = login_code
+
+    # The code is in the subject so it shows up in notifications.
+    mail to: login_code.email_address, subject: "Your Fizzy sign-in code: #{login_code.code}"
+  end
+end
diff --git a/app/models/login_code.rb b/app/models/login_code.rb
new file mode 100644
index 0000000..ebbd6b1
--- /dev/null
+++ b/app/models/login_code.rb
@@ -0,0 +1,54 @@
+class LoginCode < ApplicationRecord
+  CODE_LENGTH = 6
+
+  # Characters that are easy to read and type: no 0/O, 1/I, etc.
+  CODE_ALPHABET = %w[ A B C D E F G H J K M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+
+  EXPIRES_IN = 15.minutes
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.strip.upcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+
+  scope :active, -> { where(created_at: EXPIRES_IN.ago..) }
+
+  class << self
+    def deliver_to(email_address:)
+      where(email_address: email_address).delete_all
+
+      create!(email_address: email_address).tap(&:deliver)
+    end
+
+    # Finds the active code and consumes it, so each code can only be used once.
+    def redeem(code)
+      active.find_by(code: code)&.destroy
+    end
+  end
+
+  def deliver
+    IdentityMailer.login_code(self).deliver_later
+
+    # When email isn't configured, the code can be found in the logs.
+    Rails.logger.info "Login code for #{email_address}: #{code}"
+  end
+
+  def active?
+    created_at >= EXPIRES_IN.ago
+  end
+
+  def expired?
+    !active?
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = CODE_LENGTH.times.map { CODE_ALPHABET.sample(random: SecureRandom) }.join
+        break candidate unless self.class.exists?(code: candidate)
+      end
+    end
+end
