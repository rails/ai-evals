--- /dev/null
+++ b/test/models/login_code_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class LoginCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generates a six-character code" do
+    login_code = LoginCode.create!(email_address: "test@example.com")
+
+    assert_equal 6, login_code.code.length
+  end
+
+  test "normalizes email address and code" do
+    login_code = LoginCode.create!(email_address: "  Test@Example.COM ", code: " abc123 ")
+
+    assert_equal "test@example.com", login_code.email_address
+    assert_equal "ABC123", login_code.code
+  end
+
+  test "requires a valid email address" do
+    assert_not LoginCode.new(email_address: "not-a-valid-email").valid?
+  end
+
+  test "codes are active for fifteen minutes" do
+    login_code = LoginCode.create!(email_address: "test@example.com")
+
+    assert login_code.active?
+    assert_not login_code.expired?
+
+    travel 16.minutes do
+      assert_not login_code.active?
+      assert login_code.expired?
+      assert_not LoginCode.active.exists?(login_code.id)
+    end
+  end
+
+  test "redeem returns and consumes an active code" do
+    login_code = LoginCode.create!(email_address: "test@example.com")
+
+    redeemed = LoginCode.redeem(login_code.code)
+    assert_equal login_code, redeemed
+    assert_not LoginCode.exists?(login_code.id), "Redeemed codes should be consumed"
+
+    assert_nil LoginCode.redeem(login_code.code), "Codes can only be redeemed once"
+  end
+
+  test "redeem is not case sensitive" do
+    login_code = LoginCode.create!(email_address: "test@example.com")
+
+    assert_equal login_code, LoginCode.redeem(login_code.code.downcase)
+  end
+
+  test "redeem returns nil for an expired code" do
+    login_code = LoginCode.create!(email_address: "test@example.com")
+
+    travel 16.minutes do
+      assert_nil LoginCode.redeem(login_code.code)
+    end
+  end
+
+  test "deliver_to emails a code with the code in the subject" do
+    assert_emails 1 do
+      login_code = LoginCode.deliver_to(email_address: "test@example.com")
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "test@example.com" ], mail.to
+      assert_includes mail.subject, login_code.code
+    end
+  end
+
+  test "deliver_to replaces previous codes for the same email address" do
+    old_code = LoginCode.deliver_to(email_address: "test@example.com")
+    new_code = LoginCode.deliver_to(email_address: "test@example.com")
+
+    assert_nil LoginCode.redeem(old_code.code), "Previous codes should no longer work"
+    assert_equal new_code, LoginCode.redeem(new_code.code)
+  end
+end
