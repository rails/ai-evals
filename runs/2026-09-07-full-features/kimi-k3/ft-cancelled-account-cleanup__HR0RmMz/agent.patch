index 0000000..d355328
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than the grace period ago" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "does not incinerate accounts cancelled within the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    account = accounts(:"37s")
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+
+  test "does not incinerate accounts that were reactivated" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    account.reactivate
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b3d9012
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incineratable includes accounts cancelled more than the grace period ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    assert_includes Account.incineratable, @account
+  end
+
+  test "incineratable excludes accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago + 1.day)
+
+    assert_not_includes Account.incineratable, @account
+  end
+
+  test "incineratable excludes accounts that have not been cancelled" do
+    assert_not_includes Account.incineratable, @account
+  end
+
+  test "incineratable excludes accounts cancelled exactly at the grace period boundary" do
+    freeze_time
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+    assert_not_includes Account.incineratable, @account
+  end
+
+  test "incinerate permanently removes the account and all its associated data" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    Current.with_account(@account) do
+      card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+      Storage::Entry.create!(account: @account, board: board, delta: 100, operation: "attach")
+    end
+
+    @account.cancel(initiated_by: @user)
+
+    assert_nothing_raised do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty User.where(account: @account)
+    assert_empty Board.where(account: @account)
+    assert_empty Card.where(account: @account)
+    assert_empty Account::Cancellation.where(account: @account)
+    assert_empty Storage::Entry.where(account: @account)
+  end
+
+  test "incinerate_due only incinerates accounts past the grace period" do
+    due = accounts(:"37s")
+    due.cancel(initiated_by: @user)
+    due.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    within_grace_period = accounts(:initech)
+    within_grace_period.cancel(initiated_by: users(:mike))
+
+    active = accounts(:acme)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due.id)
+    assert Account.exists?(within_grace_period.id)
+    assert Account.exists?(active.id)
+  end
+end
