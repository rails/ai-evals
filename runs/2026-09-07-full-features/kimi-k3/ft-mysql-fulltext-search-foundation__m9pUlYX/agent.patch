@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "searching by title" do
+    assert_equal [ cards(:layout) ], Card.published.searching_for("Layout is broken")
+  end
+
+  test "searching by description" do
+    card = boards(:writebook).cards.create! status: :published, title: "Unrelated", description: "A treatise on flibbertigibbets"
+
+    assert_equal [ card ], Card.published.searching_for("flibbertigibbets")
+  end
+
+  test "searching by comment body" do
+    assert_equal [ cards(:layout) ], Card.published.searching_for("overflowing")
+  end
+
+  test "searching with no matches" do
+    assert_empty Card.published.searching_for("nonexistentword")
+  end
+
+  test "searching with a blank query returns nothing" do
+    assert_empty Card.searching_for("")
+    assert_empty Card.searching_for(nil)
+  end
+
+  test "comments searching by body" do
+    assert_equal [ comments(:layout_overflowing_david) ], Comment.searching_for("overflowing")
+  end
+end
