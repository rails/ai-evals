diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..600b875
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "search finds cards by title" do
+    get search_path(q: "broken")
+
+    assert_response :success
+    assert_equal [ "Layout is broken" ], search_result_titles
+  end
+
+  test "search finds cards by description" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! status: :published, title: "Some card", description: "A very descriptive gobbledygook"
+    end
+
+    get search_path(q: "gobbledygook")
+
+    assert_response :success
+    assert_equal [ "Some card" ], search_result_titles
+    assert_select ".search-result mark", "gobbledygook"
+  end
+
+  test "search finds cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_equal [ "Layout is broken" ], search_result_titles
+    assert_select ".search-result mark", "overflowing"
+  end
+
+  test "search wraps matched words in mark" do
+    get search_path(q: "broken")
+
+    assert_response :success
+    assert_select ".search-result mark", text: "broken"
+  end
+
+  test "search results are newest first" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! status: :published, title: "quagmire old", created_at: 2.days.ago
+      boards(:writebook).cards.create! status: :published, title: "quagmire new", created_at: 1.hour.ago
+    end
+
+    get search_path(q: "quagmire")
+
+    assert_response :success
+    assert_equal [ "quagmire new", "quagmire old" ], search_result_titles
+  end
+
+  test "search only shows cards from boards the user can access" do
+    with_current_user :kevin do
+      boards(:private).cards.create! status: :published, title: "Secret plans"
+    end
+
+    get search_path(q: "Secret")
+    assert_response :success
+    assert_equal [ "Secret plans" ], search_result_titles
+
+    logout_and_sign_in_as :david
+    get search_path(q: "Secret")
+    assert_response :success
+    assert_equal [], search_result_titles
+  end
+
+  test "search does not return cards from other accounts" do
+    get search_path(q: "paycheck")
+
+    assert_response :success
+    assert_equal [], search_result_titles
+  end
+
+  test "search does not return draft cards or their comments" do
+    with_current_user :kevin do
+      card = boards(:writebook).cards.create! status: :published, title: "Drafty McDraftface", description: "drafty description"
+      card.comments.create! body: "drafty comment body"
+      card.update_column :status, :drafted
+    end
+
+    get search_path(q: "Drafty")
+
+    assert_response :success
+    assert_equal [], search_result_titles
+  end
+
+  test "search with a blank query returns no results" do
+    get search_path(q: "")
+
+    assert_response :success
+    assert_equal [], search_result_titles
+  end
+
+  test "search without a query param" do
+    get search_path
+
+    assert_response :success
+    assert_equal [], search_result_titles
+  end
+
+  test "search requires authentication" do
+    sign_out
+
+    get search_path(q: "broken")
+
+    assert_response :redirect
+  end
+
+  test "search matches percent and underscore literally" do
+  with_current_user :kevin do
+    boards(:writebook).cards.create! status: :published, title: "Give 100% effort"
+    boards(:writebook).cards.create! status: :published, title: "Give 1000 efforts"
+    boards(:writebook).cards.create! status: :published, title: "under_score literal"
+    boards(:writebook).cards.create! status: :published, title: "underXscore not"
+  end
+
+  get search_path(q: "100%")
+  assert_response :success
+  assert_equal [ "Give 100% effort" ], search_result_titles
+
+  get search_path(q: "under_score")
+  assert_response :success
+  assert_equal [ "under_score literal" ], search_result_titles
+end
+
+test "search treats query as literal text" do
+  with_current_user :kevin do
+    boards(:writebook).cards.create! status: :published, title: "Price is $5 (cheap)"
+  end
+
+  get search_path(q: "$5 (cheap)")
+
+  assert_response :success
+  assert_equal [ "Price is $5 (cheap)" ], search_result_titles
+end
+
+test "search escapes HTML in results" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! status: :published, title: "<script>alert('xss')</script> broken"
+    end
+
+    get search_path(q: "broken")
+
+    assert_response :success
+    assert_no_match(/<script>alert/, @response.body)
+    assert_select ".search-result mark", "broken"
+  end
+
+  private
+    def search_result_titles
+      Nokogiri::HTML(@response.body).css(".search-result a").map { |link| link.text.squish }
+    end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..d0d4a78
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight wraps matches in mark" do
+    assert_equal "Layout is <mark>broken</mark>", highlight_search_matches("Layout is broken", "broken")
+  end
+
+  test "highlight is case insensitive and preserves original casing" do
+    assert_equal "<mark>Broken</mark> layout, <mark>broken</mark> again", highlight_search_matches("Broken layout, broken again", "broken")
+  end
+
+  test "highlight escapes HTML in text" do
+    assert_equal "&lt;script&gt; <mark>broken</mark>", highlight_search_matches("<script> broken", "broken")
+  end
+
+  test "highlight escapes HTML in query" do
+    assert_equal "a <mark>&lt;b&gt;</mark> c", highlight_search_matches("a <b> c", "<b>")
+  end
+
+  test "highlight treats query as literal text" do
+    assert_equal "<mark>a.c</mark>", highlight_search_matches("a.c", "a.c")
+    assert_equal "abc", highlight_search_matches("abc", "a.c")
+  end
+
+  test "highlight with blank query returns escaped text" do
+    assert_equal "plain", highlight_search_matches("plain", "")
+    assert_equal "&lt;b&gt;", highlight_search_matches("<b>", nil)
+  end
+
+  test "excerpt returns nil when there is no match" do
+    assert_nil search_match_excerpt("nothing to see here", "missing")
+  end
+
+  test "excerpt centers the match" do
+    text = ("a" * 200) + " needle " + ("b" * 200)
+    excerpt = search_match_excerpt(text, "needle", radius: 20)
+
+    assert_includes excerpt, "<mark>needle</mark>"
+    assert excerpt.start_with?("…")
+    assert excerpt.end_with?("…")
+    assert_operator excerpt.length, :<, 100
+  end
+
+  test "excerpt of rich text content" do
+    excerpt = search_match_excerpt(ActionText::Content.new("<p>Hello searchable world</p>"), "searchable")
+
+    assert_equal "Hello <mark>searchable</mark> world", excerpt
+  end
+
+  test "excerpt escapes HTML" do
+    excerpt = search_match_excerpt("<b>bold</b> needle", "needle")
+
+    assert_includes excerpt, "&lt;b&gt;bold&lt;/b&gt;"
+    assert_includes excerpt, "<mark>needle</mark>"
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
