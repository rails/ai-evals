@@ -0,0 +1,22 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    set_page_and_extract_portion_from matching_cards
+    @matching_comments = matching_comments.group_by(&:card_id)
+  end
+
+  private
+    def matching_cards
+      Current.user.accessible_cards
+        .published
+        .searching_for(@query)
+        .reverse_chronologically
+        .preload(:board)
+        .with_rich_text_description
+    end
+
+    def matching_comments
+      Comment.where(card: @page.records).searching_for(@query).chronologically.preload(:creator).with_rich_text_body
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..5d4eede
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,27 @@
+module SearchesHelper
+  def highlight_search_matches(text, query)
+    text = text.to_s
+
+    if query.present?
+      segments = text.split(/(#{Regexp.escape(query)})/i)
+
+      safe_join segments.each_with_index.map { |segment, index| index.odd? ? tag.mark(segment) : segment }
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+
+  def search_match_excerpt(content, query, radius: 120)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    text = text.squish
+
+    if match_at = text.index(/#{Regexp.escape(query)}/i)
+      from = [ match_at - radius, 0 ].max
+      excerpt = text[from, match_at - from + query.length + radius]
+      excerpt = "…#{excerpt}" if from > 0
+      excerpt = "#{excerpt}…" if from + excerpt.length < text.length
+
+      highlight_search_matches(excerpt, query)
+    end
+  end
+end
