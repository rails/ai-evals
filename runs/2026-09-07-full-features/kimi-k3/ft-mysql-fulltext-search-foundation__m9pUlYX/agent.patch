diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..6f18fb1
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,32 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def searching_for(query)
+      if query.present?
+        pattern = "%#{sanitize_sql_like(query, "!")}%"
+
+        where("cards.title LIKE ? ESCAPE '!'", pattern)
+          .or(where(id: card_ids_with_matching_description(pattern)))
+          .or(where(id: card_ids_with_matching_comment(pattern)))
+      else
+        none
+      end
+    end
+
+    private
+      # LIKE wildcards are escaped with "!" and an explicit ESCAPE clause so that
+      # patterns behave the same on SQLite (no default escape) and MySQL.
+      def card_ids_with_matching_description(pattern)
+        matching_rich_texts(record_type: "Card", name: "description", pattern: pattern).select(:record_id)
+      end
+
+      def card_ids_with_matching_comment(pattern)
+        Comment.where(id: matching_rich_texts(record_type: "Comment", name: "body", pattern: pattern).select(:record_id)).select(:card_id)
+      end
+
+      def matching_rich_texts(record_type:, name:, pattern:)
+        ActionText::RichText.where(record_type: record_type, name: name).where("body LIKE ? ESCAPE '!'", pattern)
+      end
+  end
+end
