--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = "Search" %>
+<% @hide_footer_frames = true %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, class: "search-form flex align-center gap-half margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards, descriptions, and comments…", autocomplete: "off", autofocus: true, class: "input full-width" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <div class="search-results txt-align-start">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { query: @query, matching_comments: @matching_comments } %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards found for “<%= @query %>”</p>
+    <% end %>
+  <% else %>
+    <p class="blank-slate">Find cards by title, description, or comment</p>
+  <% end %>
+</section>
