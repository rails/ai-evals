diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..84802f2
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,40 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    update! publication_key: generate_unique_publication_key unless published?
+  end
+
+  def unpublish
+    update! publication_key: nil
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **public_url_options)
+    end
+  end
+
+  private
+    def generate_unique_publication_key
+      loop do
+        key = self.class.generate_unique_secure_token
+        break key unless self.class.published.exists?(publication_key: key)
+      end
+    end
+
+    def public_url_options
+      base_url_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      base_url_options.merge(script_name: account.slug)
+    end
+end
