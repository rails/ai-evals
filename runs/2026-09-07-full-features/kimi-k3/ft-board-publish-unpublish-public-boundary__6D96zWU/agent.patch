+  test "cards from other boards are not visible" do
+    with_current_user :kevin do
+      other_card = boards(:private).cards.create!(title: "Secret", status: :published, creator: users(:kevin))
+
+      get public_board_card_path(@board.publication_key, other_card.number)
+      assert_response :not_found
+    end
+  end
+end
