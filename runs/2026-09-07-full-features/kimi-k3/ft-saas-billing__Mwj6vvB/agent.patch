diff --git a/saas/test/controllers/account/billing_controller_test.rb b/saas/test/controllers/account/billing_controller_test.rb
new file mode 100644
index 0000000..1a964aa
--- /dev/null
+++ b/saas/test/controllers/account/billing_controller_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Account::BillingControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_test"
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @price_id
+  end
+
+  test "billing page requires an admin" do
+    accounts(:initech).users.create!(name: "Member JZ", role: :member, identity: identities(:jz), verified_at: Time.current)
+    sign_in_as :jz
+
+    get saas.account_billing_path(script_name: @account.slug)
+    assert_response :forbidden
+  end
+
+  test "admins can see the billing page with upgrade options" do
+    sign_in_as :mike
+
+    get saas.account_billing_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "strong", text: "Unlimited"
+    assert_select "strong", text: "Unlimited+"
+  end
+
+  test "checkout redirects to Stripe" do
+    sign_in_as :mike
+
+    session = mock(url: "https://checkout.stripe.com/c/pay/cs_test_123")
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      assert_equal "subscription", params[:mode]
+      assert_equal [ { price: "price_unlimited_test", quantity: 1 } ], params[:line_items]
+      assert_equal @account.id, params[:client_reference_id]
+      assert_equal @account.id, params[:metadata][:account_id]
+      true
+    end.returns(session)
+
+    post saas.checkout_account_billing_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+  end
+
+  test "checkout reuses the existing Stripe customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "canceled")
+
+    sign_in_as :mike
+
+    session = mock(url: "https://checkout.stripe.com/c/pay/cs_test_123")
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      assert_equal "cus_123", params[:customer]
+      assert_nil params[:customer_email]
+      true
+    end.returns(session)
+
+    post saas.checkout_account_billing_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+  end
+
+  test "checkout with an unknown plan redirects back" do
+    sign_in_as :mike
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.checkout_account_billing_path(script_name: @account.slug), params: { plan: "bogus" }
+
+    assert_redirected_to saas.account_billing_path(script_name: @account.slug)
+  end
+
+  test "portal redirects to Stripe for subscribed accounts" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "active")
+
+    sign_in_as :mike
+
+    session = mock(url: "https://billing.stripe.com/p/session/test_123")
+    Stripe::BillingPortal::Session.expects(:create).with(customer: "cus_123", return_url: saas.account_billing_url(script_name: @account.slug, host: "www.example.com")).returns(session)
+
+    post saas.portal_account_billing_path(script_name: @account.slug)
+
+    assert_redirected_to "https://billing.stripe.com/p/session/test_123"
+  end
+
+  test "portal redirects back when there is no Stripe customer" do
+    sign_in_as :mike
+
+    Stripe::BillingPortal::Session.expects(:create).never
+
+    post saas.portal_account_billing_path(script_name: @account.slug)
+
+    assert_redirected_to saas.account_billing_path(script_name: @account.slug)
+  end
