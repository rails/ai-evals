diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..a7fe332
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,23 @@
+# Mirrors the state of the account's Stripe subscription. Stripe posts
+# subscription changes to /stripe/webhooks, and Stripe::WebhooksController
+# keeps this record in sync.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ trialing active ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true, uniqueness: true
+  validates :stripe_subscription_id, uniqueness: { allow_nil: true }
+
+  def plan
+    Plan[plan_key] || Plan.free
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..8e3eeb3
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,86 @@
+# The plans offered on hosted Fizzy. Stripe hosts checkout and billing; the
+# price IDs are configured through environment variables.
+#
+#   Free          1,000 cards, 1 GB storage
+#   Unlimited     $20/month, 5 GB storage
+#   Unlimited+    $25/month, 500 GB storage
+#
+# Comped accounts (see Account::BillingWaiver) get the full Unlimited+
+# allowances on the house.
+class Plan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+    @key             = key
+    @name            = name
+    @price_in_cents  = price_in_cents
+    @card_limit      = card_limit
+    @storage_limit   = storage_limit
+  end
+
+  def free?
+    self == Plan.free
+  end
+
+  def paid?
+    price_in_cents.positive?
+  end
+
+  def comped?
+    self == Plan.comped
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price
+    price_in_cents / 100.0
+  end
+
+  def stripe_price_id
+    case key
+    when "unlimited"      then ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    when "unlimited_plus" then ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    end
+  end
+
+  def to_param
+    key
+  end
+
+  PLANS = [
+    FREE           = new(key: "free",           name: "Free",       price_in_cents: 0,     card_limit: 1_000, storage_limit: 1.gigabyte),
+    UNLIMITED      = new(key: "unlimited",      name: "Unlimited",  price_in_cents: 2_000, card_limit: nil,   storage_limit: 5.gigabytes),
+    UNLIMITED_PLUS = new(key: "unlimited_plus", name: "Unlimited+", price_in_cents: 2_500, card_limit: nil,   storage_limit: 500.gigabytes),
+    COMPED         = new(key: "comped",         name: "Comped",     price_in_cents: 0,     card_limit: nil,   storage_limit: 500.gigabytes)
+  ].freeze
+
+  class << self
+    def all
+      PLANS
+    end
+
+    def [](key)
+      all.find { |plan| plan.key == key.to_s }
+    end
+
+    def free
+      FREE
+    end
+
+    def comped
+      COMPED
+    end
+
+    def paid
+      all.select(&:paid?)
+    end
+
+    def find_by_stripe_price_id(price_id)
+      return if price_id.blank?
+
+      paid.find { |plan| plan.stripe_price_id == price_id }
+    end
+  end
+end
diff --git a/saas/app/views/account/billing/show.html.erb b/saas/app/views/account/billing/show.html.erb
new file mode 100644
index 0000000..3710d71
--- /dev/null
+++ b/saas/app/views/account/billing/show.html.erb
@@ -0,0 +1,54 @@
+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Current plan</h2>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div>
+        This account is on the <strong><%= Current.account.plan.name %></strong> plan.
+      </div>
+
+      <div class="txt-small txt-ink-medium">
+        <%= number_with_delimiter(Current.account.cards_used) %> cards used,
+        <%= number_to_human_size(Current.account.bytes_used) %> of
+        <%= number_to_human_size(Current.account.storage_limit) %> storage used.
+      </div>
+
+      <% if Current.account.paid? %>
+        <div class="margin-block-start-half">
+          <%= button_to "Manage billing", saas.portal_account_billing_path, class: "btn", form: { data: { turbo: false } } %>
+        </div>
+      <% end %>
+    </div>
+  </div>
+
+  <% unless Current.account.paid? || Current.account.comped? %>
+    <div class="settings__panel panel shadow center">
+      <header>
+        <h2 class="divider txt-medium margin-block-start">Upgrade</h2>
+      </header>
+
+      <div class="flex flex-column gap margin-block-half">
+        <% Plan.paid.each do |plan| %>
+          <div class="flex align-center gap">
+            <div class="flex-item-grow">
+              <strong><%= plan.name %></strong> — $<%= plan.price.to_i %>/month
+              <div class="txt-small txt-ink-medium">
+                Unlimited cards, <%= number_to_human_size(plan.storage_limit) %> of storage.
+              </div>
+            </div>
+
+            <%= button_to "Upgrade", saas.checkout_account_billing_path(plan: plan.key), class: "btn", form: { data: { turbo: false } } %>
+          </div>
+        <% end %>
+      </div>
+    </div>
+  <% end %>
+</div>
diff --git a/saas/app/views/account/settings/saas/_plan.html.erb b/saas/app/views/account/settings/saas/_plan.html.erb
