diff --git a/saas/app/controllers/account/billing_controller.rb b/saas/app/controllers/account/billing_controller.rb
new file mode 100644
index 0000000..51fb43b
--- /dev/null
+++ b/saas/app/controllers/account/billing_controller.rb
@@ -0,0 +1,48 @@
+# Plan and billing management for an account. Stripe hosts both checkout
+# (for upgrading) and the customer portal (for managing an existing
+# subscription), so both actions simply redirect to Stripe-hosted pages.
+class Account::BillingController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+  end
+
+  def checkout
+    if plan = Plan.paid.find { |plan| plan.key == params[:plan].to_s }
+      redirect_to create_checkout_session(plan).url, allow_other_host: true
+    else
+      redirect_to saas.account_billing_path, alert: "Please pick a plan"
+    end
+  end
+
+  def portal
+    if customer = Current.account.subscription&.stripe_customer_id
+      session = Stripe::BillingPortal::Session.create(customer: customer, return_url: saas.account_billing_url)
+      redirect_to session.url, allow_other_host: true
+    else
+      redirect_to saas.account_billing_path
+    end
+  end
+
+  private
+    def create_checkout_session(plan)
+      Stripe::Checkout::Session.create \
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        **customer_attributes,
+        success_url: saas.account_billing_url,
+        cancel_url: saas.account_billing_url,
+        metadata: { account_id: Current.account.id },
+        subscription_data: { metadata: { account_id: Current.account.id } }
+    end
+
+    # Stripe rejects sessions passing both customer and customer_email.
+    def customer_attributes
+      if (customer = Current.account.subscription&.stripe_customer_id).present?
+        { customer: customer }
+      else
+        { customer_email: Current.user.identity&.email_address }
+      end
+    end
+end
diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..a18298e
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,46 @@
+# Support tooling for accounts: comping (waiving billing) and overriding the
+# usage an account is limited by.
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "#{@account.name} is no longer comped"
+  end
+
+  def override
+    @account.override_limits(card_count: override_param(:card_count), bytes_used: override_param(:bytes_used))
+    redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+  end
+
+  def reset
+    @account.reset_overridden_limits!
+    redirect_to saas.admin_account_path(@account), notice: "Overrides reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) || Account.find_by!(external_account_id: params[:id])
+    end
+
+    def override_param(key)
+      value = params[key]
+      value = params[:overridden_limit][key] if value.blank? && params[:overridden_limit].is_a?(ActionController::Parameters)
+      value = params[:account][key] if value.blank? && params[:account].is_a?(ActionController::Parameters)
+      value.presence
+    end
+end
