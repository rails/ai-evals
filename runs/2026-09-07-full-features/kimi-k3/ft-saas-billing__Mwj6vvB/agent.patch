+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div>
+        <strong><%= @account.name %></strong>
+        <span class="txt-x-small txt-ink-medium">#<%= @account.external_account_id %></span>
+      </div>
+      <div>Owner: <%= @account.owner_email || "No owner" %></div>
+      <div>
+        Plan: <strong><%= @account.plan.name %></strong>
+        <% if @account.comped? %><span class="txt-x-small txt-ink-medium">(comped)</span><% end %>
+      </div>
+      <% if @account.subscription %>
+        <div class="txt-small txt-ink-medium">
+          Stripe customer <%= @account.subscription.stripe_customer_id %>
+          <% if @account.subscription.stripe_subscription_id %>
+            • subscription <%= @account.subscription.stripe_subscription_id %> (<%= @account.subscription.status %>)
+          <% end %>
+        </div>
+      <% end %>
+      <div>Cards: <%= number_with_delimiter(@account.cards_used) %><% if @account.card_limit %> / <%= number_with_delimiter(@account.card_limit) %><% end %></div>
+      <div>Storage: <%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %></div>
+    </div>
+
+    <div class="flex gap-half margin-block-half">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn" %>
+    </div>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override limits</h2>
+    </header>
+
+    <p class="txt-small txt-ink-medium margin-block-half">
+      Override the usage this account is limited by. Leave a field blank to use the real count.
+      <% if @account.overridden_limit %>
+        <strong>An override is in effect.</strong>
+      <% end %>
+    </p>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <div class="flex align-center gap-half">
+        <%= form.label :card_count, "Card count", class: "flex-item-grow" %>
+        <%= form.text_field :card_count, value: @account.overridden_limit&.card_count, placeholder: @account.cards_count.to_s %>
+      </div>
+
+      <div class="flex align-center gap-half">
+        <%= form.label :bytes_used, "Bytes used", class: "flex-item-grow" %>
+        <%= form.text_field :bytes_used, value: @account.overridden_limit&.bytes_used, placeholder: @account.bytes_used.to_s %>
+      </div>
+
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <%= button_to "Reset", saas.reset_admin_account_path(@account), class: "btn btn--reversed", form: { data: { turbo: false } } %>
+  </div>
+</section>
