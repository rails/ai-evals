diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..dae9670
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: @account.name
+    assert_select "a", text: accounts(:"37s").name
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :mike
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "account names open the account page" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_select "a[href=?]", saas.admin_account_path(@account, script_name: ""), text: @account.name
+  end
+
+  test "staff can see an account page with support tools" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "h1", @account.name
+    assert_select "strong", "Free"
+    assert_select "button", "Comp"
+    assert_select "button", "Uncomp"
+    assert_select "label", "Card count"
+    assert_select "label", "Bytes used"
+    assert_select "input[type=submit][value=?]", "Override"
+    assert_select "button", "Reset"
+  end
+
+  test "non-staff cannot see the account page" do
+    sign_in_as :mike
+
+    untenanted do
+      get saas.admin_account_path(@account)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comp comps the account" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.comp_admin_account_path(@account)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert @account.reload.comped?
+    assert_equal Plan.comped, @account.plan
+  end
+
+  test "uncomp removes the comp" do
+    @account.comp!
+    sign_in_as :david
+
+    untenanted do
+      post saas.uncomp_admin_account_path(@account)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_not @account.reload.comped?
+  end
+
+  test "uncomp via DELETE on comp" do
+    @account.comp!
+    sign_in_as :david
+
+    untenanted do
+      delete saas.comp_admin_account_path(@account)
+    end
+
+    assert_not @account.reload.comped?
+  end
+
+  test "override sets the usage the account is limited by" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.override_admin_account_path(@account), params: { card_count: 5_000, bytes_used: 3.gigabytes }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+
+    override = @account.reload.overridden_limit
+    assert_equal 5_000, override.card_count
+    assert_equal 3.gigabytes, override.bytes_used
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "override updates an existing override" do
+    @account.override_limits(card_count: 5_000, bytes_used: nil)
+    sign_in_as :david
+
+    untenanted do
+      post saas.override_admin_account_path(@account), params: { card_count: 100, bytes_used: 123 }
+    end
+
+    assert_equal 100, @account.reload.overridden_limit.card_count
+    assert_equal 123, @account.overridden_limit.bytes_used
+  end
+
+  test "override with a blank field falls back to the real count" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.override_admin_account_path(@account), params: { card_count: "", bytes_used: 123 }
+    end
+
+    override = @account.reload.overridden_limit
+    assert_nil override.card_count
+    assert_equal 123, override.bytes_used
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 5_000, bytes_used: 3.gigabytes)
+    sign_in_as :david
+
+    untenanted do
+      post saas.reset_admin_account_path(@account)
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_nil @account.reload.overridden_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "reset via DELETE on override" do
+    @account.override_limits(card_count: 5_000, bytes_used: nil)
+    sign_in_as :david
+
+    untenanted do
+      delete saas.override_admin_account_path(@account)
+    end
+
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "account page works with the external account id" do
+    sign_in_as :david
+
+    untenanted do
+      get "/admin/accounts/#{@account.external_account_id}"
+    end
+
+    assert_response :success
+    assert_select "h1", @account.name
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..aaaeb3c
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  # Publishing
+
+  test "cannot publish when the card limit is reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_changes -> { cards(:unfinished_thoughts).reload.status } do
+      post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can publish when under the card limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 999)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid accounts can publish past the free card limit" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "active")
+    @account.update_column(:cards_count, 5_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "comped accounts can publish past the free card limit" do
+    sign_in_as :mike
+    @account.comp!
+    @account.update_column(:cards_count, 5_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "staff can publish even when the card limit is reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :redirect
+  end
+
+  test "cannot publish via JSON when the card limit is reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug), as: :json
+
+    assert_response :forbidden
+  end
+
+  # API creation
+
+  test "cannot create cards via JSON when the card limit is reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can create cards via JSON when under the card limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 999)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Allowed card" } },
+        as: :json
+    end
+
+    assert_response :created
+  end
+
+  # Drafting stays open
+
+  test "can still draft via HTML when the card limit is reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  # Views
+
+  test "draft shows an upgrade pitch instead of the create buttons when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "draft shows a countdown warning from 100 cards out" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+  end
+
+  test "draft shows the countdown warning exactly 100 cards out" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 900)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "100 cards left"
+  end
+
+  test "draft shows no warning when more than 100 cards away from the limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 899)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+    assert_no_match "cards left", response.body
+  end
+
+  test "staff see the create buttons instead of the upgrade pitch" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..1373036
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,269 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @webhook_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    @price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited_test"
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @webhook_secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @price_id
+  end
+
+  test "rejects unsigned events" do
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  test "rejects events signed with the wrong secret" do
+    untenanted do
+      post "/stripe/webhooks", params: subscription_event_payload, headers: webhook_headers(subscription_event_payload, secret: "whsec_wrong")
+    end
+
+    assert_response :bad_request
+  end
+
+  test "checkout session completion links the Stripe customer to the account" do
+    payload = checkout_session_payload
+
+    assert_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+      end
+    end
+
+    assert_response :ok
+
+    subscription = @account.subscription
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+  end
+
+  test "subscription created upgrades the account to the matching plan" do
+    payload = subscription_event_payload
+
+    assert_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+      end
+    end
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal Time.zone.at(1_900_000_000), subscription.current_period_end
+    assert_equal Plan["unlimited"], @account.plan
+  end
+
+  test "subscription updated syncs an existing subscription found by Stripe subscription id" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "active")
+
+    payload = subscription_event_payload(type: "customer.subscription.updated", status: "canceled")
+
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+      end
+    end
+
+    assert_response :ok
+    assert_equal "canceled", @account.subscription.reload.status
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "subscription deleted reverts the account to free" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "active")
+
+    payload = subscription_event_payload(type: "customer.subscription.deleted")
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+    end
+
+    assert_response :ok
+    assert_equal "canceled", @account.subscription.reload.status
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "unknown events are acknowledged" do
+    payload = signed_event(type: "invoice.paid", object: { id: "in_123" })
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+    end
+
+    assert_response :ok
+  end
+
+  test "subscriptions for unknown accounts are acknowledged but not stored" do
+    payload = subscription_event_payload(account_id: "no-such-account")
+
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+      end
+    end
+
+    assert_response :ok
+  end
+
+
+  test "handles expanded customer objects" do
+    payload = signed_event \
+      type: "customer.subscription.created",
+      object: {
+        id: "sub_123",
+        object: "subscription",
+        customer: { id: "cus_123", object: "customer" },
+        status: "active",
+        items: { object: "list", data: [ { id: "si_123", price: { id: "price_unlimited_test" } } ] },
+        metadata: { account_id: @account.id }
+      }
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+    end
+
+    assert_response :ok
+    assert_equal "cus_123", @account.reload.subscription.stripe_customer_id
+    assert_equal "unlimited", @account.subscription.plan_key
+  end
+
+  test "moving between paid plans updates the plan key" do
+    extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus_test"
+
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "unlimited", status: "active")
+
+    payload = signed_event \
+      type: "customer.subscription.updated",
+      object: {
+        id: "sub_123",
+        object: "subscription",
+        customer: "cus_123",
+        status: "active",
+        items: { object: "list", data: [ { id: "si_123", price: { id: "price_unlimited_plus_test" } } ] },
+        metadata: { account_id: @account.id }
+      }
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+    end
+
+    assert_response :ok
+    assert_equal "unlimited_plus", @account.subscription.reload.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  ensure
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = extra_storage_price_id
+  end
+
+  test "a re-checkout replaces the Stripe subscription id" do
+    @account.create_subscription!(stripe_customer_id: "cus_123", stripe_subscription_id: "sub_old", plan_key: "unlimited", status: "canceled")
+
+    payload = checkout_session_payload
+
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: webhook_headers(payload)
+      end
+    end
+
+    assert_response :ok
+    assert_equal "sub_123", @account.subscription.reload.stripe_subscription_id
+  end
+
+  test "processing a real end-to-end upgrade" do
+    # 1. Free account at the card limit cannot publish
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+
+    # 2. Stripe posts checkout.session.completed
+    payload = checkout_session_payload
+    untenanted { post "/stripe/webhooks", params: payload, headers: webhook_headers(payload) }
+    assert_response :ok
+    assert_equal Plan.free, @account.reload.plan
+
+    # 3. Stripe posts customer.subscription.created with the paid price
+    payload = subscription_event_payload
+    untenanted { post "/stripe/webhooks", params: payload, headers: webhook_headers(payload) }
+    assert_response :ok
+
+    # 4. The account is now Unlimited with unlimited cards and 5 GB of storage
+    assert_equal Plan["unlimited"], @account.reload.plan
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    # 5. Canceling the subscription reverts to Free and the limits
+    payload = subscription_event_payload(type: "customer.subscription.deleted")
+    untenanted { post "/stripe/webhooks", params: payload, headers: webhook_headers(payload) }
+    assert_response :ok
+
+    assert_equal Plan.free, @account.reload.plan
+    assert @account.exceeding_card_limit?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  private
+    def checkout_session_payload
+      signed_event \
+        type: "checkout.session.completed",
+        object: {
+          id: "cs_test_123",
+          object: "checkout.session",
+          mode: "subscription",
+          customer: "cus_123",
+          subscription: "sub_123",
+          client_reference_id: @account.id,
+          metadata: { account_id: @account.id }
+        }
+    end
+
+    def subscription_event_payload(type: "customer.subscription.created", status: "active", account_id: @account.id)
+      signed_event \
+        type: type,
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: status,
+          current_period_end: 1_900_000_000,
+          cancel_at: nil,
+          canceled_at: 1_800_000_000,
+          items: {
+            object: "list",
+            data: [ { id: "si_123", object: "subscription_item", price: { id: "price_unlimited_test", object: "price" }, current_period_end: 1_900_000_000 } ]
+          },
+          metadata: { account_id: account_id }
+        }
+    end
+
+    def signed_event(type:, object:)
+      JSON.generate(
+        id: "evt_123",
+        object: "event",
+        type: type,
+        data: { object: object }
+      )
+    end
+
+    def webhook_headers(payload, secret: ENV["STRIPE_WEBHOOK_SECRET"])
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+
+      {
+        "CONTENT_TYPE" => "application/json",
+        "Stripe-Signature" => "t=#{timestamp.to_i},v1=#{signature}"
+      }
+    end
+end
