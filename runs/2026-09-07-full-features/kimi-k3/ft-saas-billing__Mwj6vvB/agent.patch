diff --git a/saas/app/models/account/overridden_limit.rb b/saas/app/models/account/overridden_limit.rb
new file mode 100644
index 0000000..2c6e4f3
--- /dev/null
+++ b/saas/app/models/account/overridden_limit.rb
@@ -0,0 +1,10 @@
+# Support override for the usage numbers an account is limited by. When
+# present, the account's card and storage limit checks count card_count and
+# bytes_used instead of the real usage. Resetting (destroying) the override
+# returns the account to its actual usage.
+class Account::OverriddenLimit < SaasRecord
+  belongs_to :account
+
+  validates :card_count, numericality: { only_integer: true, greater_than_or_equal_to: 0, allow_nil: true }
+  validates :bytes_used, numericality: { only_integer: true, greater_than_or_equal_to: 0, allow_nil: true }
+end
