--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,47 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  include Rails.application.routes.url_helpers
+
+  included do
+    # +source_id+ is always "previously changed" on create, and changes on update when
+    # something new happens on the card, so this fires whenever the notification lands in the tray.
+    after_commit :push_later, on: %i[ create update ], if: :source_id_previously_changed?
+  end
+
+  def push_later
+    if PushSubscription.supported? && user.push_subscriptions.exists?
+      Notification::PushJob.perform_later(self)
+    end
+  end
+
+  def push_now
+    if PushSubscription.supported?
+      user.push_subscriptions.find_each do |subscription|
+        safely_push_to subscription
+      end
+    end
+  end
+
+  private
+    def safely_push_to(subscription)
+      subscription.push(**push_details)
+    rescue => error
+      Rails.error.report(error, context: { notification_id: id, push_subscription_id: subscription.id })
+    end
+
+    def push_details
+      @push_details ||= JSON.parse(rendered_tray_text).symbolize_keys.merge(path: push_path)
+    end
+
+    def rendered_tray_text
+      ApplicationController.render \
+        partial: "notifications/notification/#{source_type.underscore}/body",
+        formats: :json,
+        locals: { notification: self }
+    end
+
+    def push_path
+      card_path(card, script_name: account.slug)
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..a97423b
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,72 @@
+class PushSubscription < ApplicationRecord
+  VAPID_SUBJECT = "mailto:support@fizzy.do"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint_url
+  validate :validate_p256dh_key
+  validate :validate_auth_key
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def supported?
+      vapid_public_key.present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+
+  def push(title:, body:, path:)
+    WebPush.payload_send \
+      message: JSON.generate(title: title, body: body, path: path),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def vapid
+      { subject: VAPID_SUBJECT, public_key: ENV["VAPID_PUBLIC_KEY"], private_key: ENV["VAPID_PRIVATE_KEY"] }
+    end
+
+    def validate_endpoint_url
+      if endpoint.present?
+        errors.add :endpoint, "must be an HTTPS URL" unless URI.parse(endpoint).is_a?(URI::HTTPS)
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "is not a valid URL"
+    end
+
+    def validate_p256dh_key
+      if p256dh_key.present? && !valid_p256dh_key?
+        errors.add :p256dh_key, "is not a valid P-256 public key"
+      end
+    end
+
+    def valid_p256dh_key?
+      group = OpenSSL::PKey::EC::Group.new("prime256v1")
+      OpenSSL::PKey::EC::Point.new(group, OpenSSL::BN.new(Base64.urlsafe_decode64(p256dh_key), 2))
+      true
+    rescue ArgumentError, OpenSSL::OpenSSLError
+      false
+    end
+
+    def validate_auth_key
+      if auth_key.present? && !valid_base64url?(auth_key)
+        errors.add :auth_key, "is not valid base64url"
+      end
+    end
+
+    def valid_base64url?(value)
+      Base64.urlsafe_decode64(value)
+      true
+    rescue ArgumentError
+      false
+    end
+end
