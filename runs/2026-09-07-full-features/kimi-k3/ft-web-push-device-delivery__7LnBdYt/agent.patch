index 0000000..f770197
--- /dev/null
+++ b/test/test_helpers/push_notifications_test_helper.rb
@@ -0,0 +1,10 @@
+module PushNotificationsTestHelper
+  private
+    def with_vapid_keys(public_key: "test-vapid-public-key", private_key: "test-vapid-private-key")
+      old_public_key, old_private_key = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = public_key, private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = old_public_key, old_private_key
+    end
+end
