diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..2962601
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "creating a notification enqueues a push job" do
+    notifications(:logo_assignment_kevin).destroy
+
+    with_vapid_keys do
+      assert_enqueued_with job: Notification::PushJob do
+        Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+      end
+    end
+  end
+
+  test "updating a notification with a new source enqueues a push job" do
+    with_vapid_keys do
+      notification = notifications(:logo_assignment_kevin)
+
+      assert_enqueued_with job: Notification::PushJob do
+        notification.update!(source: events(:logo_published))
+      end
+    end
+  end
+
+  test "no push job without vapid keys" do
+    notifications(:logo_assignment_kevin).destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    end
+  end
+
+  test "no push job when the user has no subscribed devices" do
+    with_vapid_keys do
+      notification = notifications(:logo_assignment_kevin)
+      notification.user.push_subscriptions.destroy_all
+
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        notification.update!(source: events(:logo_published))
+      end
+    end
+  end
+
+  test "no push job when marking as read or unread" do
+    with_vapid_keys do
+      notification = notifications(:logo_assignment_kevin)
+
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        notification.read
+        notification.unread
+      end
+    end
+  end
+
+  test "push says what the tray says and opens the card for events" do
+    with_vapid_keys do
+      notification = notifications(:logo_assignment_kevin)
+      subscription = push_subscriptions(:kevin_browser)
+
+      WebPush.expects(:payload_send).with do |message:, endpoint:, **|
+        payload = JSON.parse(message)
+
+        endpoint == subscription.endpoint &&
+          payload["title"] == "The logo isn't big enough" &&
+          payload["body"] == "Assigned to Kevin" &&
+          payload["path"] == card_path(notification.card, script_name: notification.account.slug)
+      end.returns(true)
+
+      notification.push_now
+    end
+  end
+
+  test "push says what the tray says and opens the card for comments" do
+    with_vapid_keys do
+      notification = notifications(:layout_commented_kevin)
+
+      WebPush.expects(:payload_send).with do |message:, **|
+        payload = JSON.parse(message)
+
+        payload["title"] == "RE: Layout is broken" &&
+          payload["body"] == "The text is overflowing the container." &&
+          payload["path"] == card_path(notification.card, script_name: notification.account.slug)
+      end.returns(true)
+
+      notification.push_now
+    end
+  end
+
+  test "push says what the tray says for mentions" do
+    with_vapid_keys do
+      mention = Mention.create!(source: comments(:layout_overflowing_david), mentioner: users(:david), mentionee: users(:david))
+      notification = Notification.create!(user: users(:david), source: mention, creator: users(:david))
+
+      WebPush.expects(:payload_send).with do |message:, **|
+        payload = JSON.parse(message)
+
+        payload["title"] == "David @mentioned you" &&
+          payload["body"] == "The text is overflowing the container." &&
+          payload["path"] == card_path(notification.card, script_name: notification.account.slug)
+      end.returns(true)
+
+      notification.push_now
+    end
+  end
+
+  test "whatever lands in the tray is pushed to subscribed devices" do
+    notifications(:layout_commented_kevin).destroy
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |message:, endpoint:, **|
+        endpoint == push_subscriptions(:kevin_browser).endpoint &&
+          JSON.parse(message)["title"] == "RE: Layout is broken"
+      end.returns(true)
+
+      perform_enqueued_jobs do
+        Notifier.for(events(:layout_commented)).notify
+      end
+    end
+  end
+
+  test "a failing device does not prevent pushing to other devices" do
+    with_vapid_keys do
+      users(:kevin).push_subscriptions.create!(
+        endpoint: "https://push.example.com/subscriptions/kevin-phone",
+        p256dh_key: "BMm9NBm-EQQLVI0EzkHUKZUBkZ60k4-Ed894Dxvz_G-7KmTY-pjBl3NqBYp7ZuFGyN7R-0kgfXztNsnReYICoJI",
+        auth_key: "C7V5zz0cEo6vUTJPu1KBkg")
+
+      notification = notifications(:logo_assignment_kevin)
+      response = stub(body: "Server error")
+
+      WebPush.stubs(:payload_send).with { |endpoint:, **| endpoint.include?("kevin-browser") }.raises(WebPush::PushServiceError.new(response, "push.example.com"))
+      WebPush.expects(:payload_send).with { |endpoint:, **| endpoint.include?("kevin-phone") }.returns(true)
+
+      assert_nothing_raised { notification.push_now }
+    end
+  end
+
+  test "push does nothing without vapid keys" do
+    WebPush.expects(:payload_send).never
+
+    notifications(:layout_commented_kevin).push_now
+  end
+
+  private
+    def card_path(*args)
+      Rails.application.routes.url_helpers.card_path(*args)
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..ac2c064
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:david_browser)
+  end
+
+  test "requires endpoint and keys" do
+    subscription = users(:david).push_subscriptions.build
+
+    assert_not subscription.valid?
+    assert subscription.errors[:endpoint].present?
+    assert subscription.errors[:p256dh_key].present?
+    assert subscription.errors[:auth_key].present?
+  end
+
+  test "belongs to the user's account by default" do
+    subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.com/new",
+      p256dh_key: "BMm9NBm-EQQLVI0EzkHUKZUBkZ60k4-Ed894Dxvz_G-7KmTY-pjBl3NqBYp7ZuFGyN7R-0kgfXztNsnReYICoJI",
+      auth_key: "C7V5zz0cEo6vUTJPu1KBkg")
+
+    assert_equal users(:david).account, subscription.account
+  end
+
+  test "validates the shape of the endpoint and keys" do
+    subscription = users(:david).push_subscriptions.build(
+      endpoint: "http://insecure.example.com/push", p256dh_key: "not-a-key", auth_key: "not valid base64url!")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:endpoint], "must be an HTTPS URL"
+    assert_includes subscription.errors[:p256dh_key], "is not a valid P-256 public key"
+    assert_includes subscription.errors[:auth_key], "is not valid base64url"
+  end
+
+  test "supported when vapid keys are configured" do
+    assert_not PushSubscription.supported?
+
+    with_vapid_keys do
+      assert PushSubscription.supported?
+    end
+  end
+
+  test "push sends the payload to the push service" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |message:, endpoint:, p256dh:, auth:, vapid:|
+        JSON.parse(message) == { "title" => "Hello", "body" => "World", "path" => "/123/cards/1" } &&
+          endpoint == @subscription.endpoint &&
+          p256dh == @subscription.p256dh_key &&
+          auth == @subscription.auth_key &&
+          vapid == { subject: PushSubscription::VAPID_SUBJECT, public_key: "test-vapid-public-key", private_key: "test-vapid-private-key" }
+      end.returns(true)
+
+      @subscription.push(title: "Hello", body: "World", path: "/123/cards/1")
+    end
+  end
+
+  test "push delivers an encrypted, signed payload to the push service" do
+    browser_key = OpenSSL::PKey::EC.generate("prime256v1")
+    p256dh = Base64.urlsafe_encode64(browser_key.public_key.to_octet_string(:uncompressed), padding: false)
+    auth = Base64.urlsafe_encode64(SecureRandom.random_bytes(16), padding: false)
+    vapid_key = WebPush.generate_key
+
+    subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/e2e", p256dh_key: p256dh, auth_key: auth)
+
+    with_vapid_keys public_key: vapid_key.public_key, private_key: vapid_key.private_key do
+      stub_request(:post, subscription.endpoint).to_return(status: 201)
+
+      subscription.push(title: "Hello", body: "World", path: "/123/cards/1")
+
+      assert_requested :post, subscription.endpoint,
+        headers: { "Authorization" => /vapid t=.+/, "Content-Encoding" => "aes128gcm" }
+    end
+  end
+
+  test "push destroys subscriptions that are no longer valid" do
+    response = stub(body: "Gone")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.push(title: "Hello", body: "World", path: "/123/cards/1")
+      end
+    end
+
+    WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      push_subscriptions(:kevin_browser).push(title: "Hello", body: "World", path: "/123/cards/1")
+    end
+  end
+end
