+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  VALID_P256DH_KEY = "BMm9NBm-EQQLVI0EzkHUKZUBkZ60k4-Ed894Dxvz_G-7KmTY-pjBl3NqBYp7ZuFGyN7R-0kgfXztNsnReYICoJI"
+  VALID_AUTH_KEY = "C7V5zz0cEo6vUTJPu1KBkg"
+
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/subscriptions/new",
+          p256dh_key: VALID_P256DH_KEY,
+          auth_key: VALID_AUTH_KEY
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/subscriptions/new", subscription.endpoint
+    assert_equal VALID_P256DH_KEY, subscription.p256dh_key
+    assert_equal VALID_AUTH_KEY, subscription.auth_key
+  end
+
+  test "create with an existing endpoint updates the keys" do
+    subscription = push_subscriptions(:david_browser)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: "BD-qfLQuHWcn8OTTjTTB0g-mIlyr74tLhzdbHHHZWu30r8jgqk5_BmcrC-Q2A-PmB73GPnWJJ3-8P3u0EfqccEE",
+          auth_key: "aYyl6rLOqdCMgjsd5sSw6g"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "BD-qfLQuHWcn8OTTjTTB0g-mIlyr74tLhzdbHHHZWu30r8jgqk5_BmcrC-Q2A-PmB73GPnWJJ3-8P3u0EfqccEE", subscription.reload.p256dh_key
+    assert_equal "aYyl6rLOqdCMgjsd5sSw6g", subscription.auth_key
+  end
+
+  test "create requires valid subscription details" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "", p256dh_key: "", auth_key: "" }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "not-a-url", p256dh_key: "not-a-key", auth_key: "not valid!" }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy" do
+    subscription = push_subscriptions(:david_browser)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: subscription.endpoint }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy with an unknown endpoint is a no-op" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      delete user_push_subscriptions_path(@user), params: { endpoint: "https://push.example.com/unknown" }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot manage another user's subscriptions" do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/subscriptions/new",
+        p256dh_key: VALID_P256DH_KEY,
+        auth_key: VALID_AUTH_KEY
+      }
+    }, as: :json
+
+    assert_response :forbidden
+
+    delete user_push_subscriptions_path(users(:kevin)), params: { endpoint: push_subscriptions(:kevin_browser).endpoint }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/subscriptions/new",
+        p256dh_key: VALID_P256DH_KEY,
+        auth_key: VALID_AUTH_KEY
+      }
+    }, as: :json
+
+    assert_response :redirect
+  end
+end
