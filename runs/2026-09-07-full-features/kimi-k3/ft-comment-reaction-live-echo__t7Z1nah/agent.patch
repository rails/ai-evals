diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..4648733
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,30 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  after_commit :broadcast_reactions, on: [ :create, :destroy ]
+
+  def emoji_only?
+    content.match?(/\A[\p{Extended_Pictographic}\u{200D}\u{FE0F}\u{20E3}\u{1F3FB}-\u{1F3FF}\u{E0020}-\u{E007F}]+\z/)
+  end
+
+  private
+    def broadcast_reactions
+      if comment
+        broadcast_replace_to comment.card,
+          target: [ comment, :reactions ],
+          partial: "cards/comments/reactions/reactions",
+          locals: { comment: comment },
+          method: :morph
+      end
+    end
+end
