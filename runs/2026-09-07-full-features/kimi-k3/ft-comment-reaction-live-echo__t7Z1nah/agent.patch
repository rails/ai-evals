diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..e5ef952
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,53 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def index
+    @reactions = @comment.reactions
+  end
+
+  def create
+    @reaction = @comment.reactions.create(reaction_params)
+
+    if @reaction.persisted?
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..191ed67
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    this.refresh()
+  }
+
+  refresh() {
+    this.element.classList.toggle("reaction--deleteable", this.deleteable)
+
+    if (this.deleteable) {
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.removeAttribute("role")
+      this.element.removeAttribute("tabindex")
+    }
+  }
+
+  toggle() {
+    if (this.deleteable) this.element.classList.toggle("expanded")
+  }
+
+  remove(event) {
+    event.stopPropagation()
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get deleteable() {
+    return this.element.dataset.creatorId != null && this.element.dataset.creatorId === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..0724f87
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  revealForm() {
+    console.log("REACTIONS revealForm")
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.#hideForm()
+  }
+
+  submitEnd(event) {
+    console.log("REACTIONS submitEnd fired", event.detail.success)
+    if (event.detail.success) this.#hideForm()
+  }
+
+  pickEmoji({ currentTarget }) {
+    const emoji = currentTarget.dataset.emoji
+
+    if (this.inputTarget.value.length + emoji.length <= this.inputTarget.maxLength) {
+      this.inputTarget.setRangeText(emoji, this.inputTarget.selectionStart, this.inputTarget.selectionEnd, "end")
+    }
+
+    this.inputTarget.focus()
+  }
+
+  #hideForm() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+}
