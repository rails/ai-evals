diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..8434223
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day do
+      assert_difference -> { Account.count }, -1 do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not User.where(account_id: account.id).exists?
+    assert_not Board.where(account_id: account.id).exists?
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day do
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..a45f030
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled past the grace period" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes accounts cancelled within the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account.reload
+  end
+
+  test "incinerate removes the account and all of its data" do
+    Current.user = @user
+    card = boards(:writebook).cards.create!(title: "Incinerated", creator: @user, status: :published)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert Search::Record.where(account_id: @account.id).exists?
+    assert Storage::Entry.where(account_id: @account.id).exists?
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+
+    [ User, Board, Card, Column, Comment, Event, Notification, Tag, Webhook,
+      Account::Cancellation, Account::JoinCode, Search::Record, Storage::Entry,
+      ActionText::RichText, ActiveStorage::Attachment ].each do |model|
+      assert_not model.where(account_id: @account.id).exists?, "Expected no #{model.name} data left for incinerated account"
+    end
+  end
+
+  test "incinerate leaves other accounts and their data alone" do
+    other = accounts(:initech)
+
+    @account.incinerate
+
+    assert Account.exists?(other.id)
+    assert_equal 2, User.where(account: other).count
+    assert_equal 1, Board.where(account: other).count
+  end
+
+  test "incinerate_due incinerates due accounts and keeps the rest" do
+    recent = accounts(:initech)
+    recent.cancel(initiated_by: @user)
+
+    active = accounts(:acme)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(recent.id)
+    assert Account.exists?(active.id)
+  end
+end
