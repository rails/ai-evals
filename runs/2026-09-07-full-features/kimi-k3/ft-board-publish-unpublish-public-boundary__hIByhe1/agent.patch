diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..42ca210
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create publishes the board" do
+    assert_changes -> { boards(:writebook).reload.published? }, from: false, to: true do
+      post board_publication_path(boards(:writebook))
+    end
+
+    assert_response :redirect
+  end
+
+  test "create as JSON renders the board with its public url" do
+    post board_publication_path(boards(:writebook)), as: :json
+
+    assert_response :created
+    assert_equal public_board_url(boards(:writebook).reload.public_key), @response.parsed_body["public_url"]
+  end
+
+  test "destroy unpublishes the board" do
+    boards(:writebook).publish
+
+    assert_changes -> { boards(:writebook).reload.published? }, from: true, to: false do
+      delete board_publication_path(boards(:writebook))
+    end
+
+    assert_response :redirect
+  end
+
+  test "destroy as JSON" do
+    boards(:writebook).publish
+
+    delete board_publication_path(boards(:writebook)), as: :json
+
+    assert_response :no_content
+    assert_not boards(:writebook).reload.published?
+  end
+
+  test "only admins can publish boards" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(boards(:writebook))
+
+    assert_response :forbidden
+    assert_not boards(:writebook).reload.published?
+  end
+
+  test "only admins can unpublish boards" do
+    boards(:writebook).publish
+
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(boards(:writebook))
+
+    assert_response :forbidden
+    assert boards(:writebook).reload.published?
+  end
+
+  test "publishing requires authentication" do
+    sign_out
+
+    post board_publication_path(boards(:writebook))
+
+    assert_response :redirect
+    assert_not boards(:writebook).reload.published?
+  end
+end
