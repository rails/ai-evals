+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+  end
+
+  test "publish generates a public key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.public_key.present?
+  end
+
+  test "publish keeps the same public key when already published" do
+    @board.publish
+    public_key = @board.public_key
+
+    @board.publish
+
+    assert_equal public_key, @board.public_key
+  end
+
+  test "unpublish removes the public key" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.reload.published?
+    assert_nil @board.public_key
+  end
+
+  test "republishing generates a new public key" do
+    @board.publish
+    old_public_key = @board.public_key
+
+    @board.unpublish
+    @board.publish
+
+    assert_not_equal old_public_key, @board.public_key
+  end
+
+  test "published scope only includes published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+  end
+
+  test "public_url points to the public board page" do
+    @board.publish
+
+    assert_includes @board.public_url, "/public/boards/#{@board.public_key}"
+  end
+end
