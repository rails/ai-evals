+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show card without signing in" do
+    get public_board_card_path(@board.public_key, @card.number)
+
+    assert_response :success
+    assert_select "h1", /#{@card.title}/
+  end
+
+  test "show drafted card is not found" do
+    draft = @board.cards.create!(creator: users(:kevin), status: :drafted, title: "Secret draft")
+
+    get public_board_card_path(@board.public_key, draft.number)
+
+    assert_response :not_found
+  end
+
+  test "show card of an unpublished board is not found" do
+    @board.unpublish
+
+    get public_board_card_path(@board.public_key_was || "nonsense", @card.number)
+
+    assert_response :not_found
+  end
+
+  test "show card from another board is not found" do
+    other_board = Board.create!(name: "Other board", creator: users(:kevin), account: accounts("37s"))
+    other_board.publish
+
+    get public_board_card_path(other_board.public_key, @card.number)
+
+    assert_response :not_found
+  end
+
+  test "show as JSON" do
+    get public_board_card_path(@board.public_key, @card.number), as: :json
+
+    assert_response :success
+    assert_equal @card.title, @response.parsed_body["title"]
+  end
+end
