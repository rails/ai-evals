diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..12c170e
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,33 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publish
+    update!(public_key: self.class.generate_unique_secure_token) unless published?
+  end
+
+  def unpublish
+    update!(public_key: nil)
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(public_key, **public_url_options)
+    end
+  end
+
+  private
+    def public_url_options
+      url_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      url_options.merge(script_name: account.slug)
+    end
+end
