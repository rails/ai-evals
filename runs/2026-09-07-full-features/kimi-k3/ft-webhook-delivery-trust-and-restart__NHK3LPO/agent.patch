+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @webhook = webhooks(:active)
+    @delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "performs the delivery" do
+    stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(@delivery)
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "does not redeliver a completed delivery" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    Webhook::DeliveryJob.perform_now(@delivery)
+    Webhook::DeliveryJob.perform_now(@delivery.reload)
+
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  test "discards deliveries that no longer exist" do
+    @delivery.destroy!
+
+    assert_nothing_raised do
+      Webhook::DeliveryJob.perform_now(@delivery)
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
