+  end
+
+  test "ten consecutive failures within an hour switch the webhook off" do
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    events = Event.where(board: @webhook.board).limit(10).to_a
+    events << @event while events.size < 10
+
+    10.times do |i|
+      @webhook.deliveries.create!(event: events[i]).deliver
+    end
+
+    assert_not @webhook.reload.active?
+    assert_requested :post, @webhook.url, times: 10
+  end
+
+  test "payloads for slack wrap the rendered event as text" do
+    webhook = @webhook.board.webhooks.create!(name: "Slack", url: "https://hooks.slack.com/services/T123/B123/xyz", subscribed_actions: %w[ card_published ])
+    delivery = webhook.deliveries.create!(event: @event)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, webhook.url).to_return(status: 200)
+
+    delivery.deliver
+
+    assert_requested :post, webhook.url, times: 1 do |request|
+      body = JSON.parse(request.body)
+      body["text"].include?("added") && body["text"].include?("/cards/")
+    end
+  end
+
+  test "payloads for campfire and basecamp wrap the rendered event as content" do
+    campfire = @webhook.board.webhooks.create!(name: "Campfire", url: "https://campfire.example.com/rooms/123/456-room/messages", subscribed_actions: %w[ card_published ])
+    basecamp = @webhook.board.webhooks.create!(name: "Basecamp", url: "https://basecamp.com/999/integrations/token/buckets/111/chats/222/lines", subscribed_actions: %w[ card_published ])
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, campfire.url).to_return(status: 200)
+    stub_request(:post, basecamp.url).to_return(status: 200)
+
+    campfire.deliveries.create!(event: @event).deliver
+    basecamp.deliveries.create!(event: @event).deliver
+
+    assert_requested :post, campfire.url, times: 1 do |request|
+      JSON.parse(request.body)["content"].include?("added")
+    end
+    assert_requested :post, basecamp.url, times: 1 do |request|
+      JSON.parse(request.body)["content"].include?("added")
+    end
+  end
+
+  test "cleanup removes deliveries older than a week" do
+    old = @webhook.deliveries.create!(event: @event)
+    old.update_columns(created_at: 8.days.ago)
+    fresh = @webhook.deliveries.create!(event: events(:logo_assignment_jz))
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old.id)
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id), "fixture is 2 days old"
+  end
+
+  test "cleanup keeps deliveries from the last week" do
+    borderline = @webhook.deliveries.create!(event: @event)
+    borderline.update_columns(created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(borderline.id)
+  end
 end
