new file mode 100644
index 0000000..0ca25f2
--- /dev/null
+++ b/test/models/webhook/dispatch_test.rb
@@ -0,0 +1,80 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @webhook = webhooks(:active) # writebook board, subscribed to card_published, card_assigned, card_closed
+  end
+
+  test "a new event is dispatched to the board's active, subscribed webhooks" do
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      cards(:logo).close
+    end
+
+    delivery = @webhook.deliveries.last
+    assert_equal "card_closed", delivery.event.action
+    assert_equal "pending", delivery.state
+    assert_equal @webhook.account, delivery.account
+  end
+
+  test "dispatch enqueues a delivery job" do
+    assert_enqueued_with job: Webhook::DeliveryJob, queue: "webhooks" do
+      cards(:logo).close
+    end
+  end
+
+  test "inactive webhooks are skipped" do
+    webhook = webhooks(:inactive) # private board
+    card = boards(:private).cards.create!(title: "Shh")
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      card.close
+    end
+  end
+
+  test "webhooks not subscribed to the action are skipped" do
+    webhook = boards(:writebook).webhooks.create!(name: "Comments only", url: "https://example.com/hook", subscribed_actions: %w[ comment_created ])
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      cards(:logo).close
+    end
+  end
+
+  test "webhooks without any subscriptions are skipped" do
+    webhook = boards(:writebook).webhooks.create!(name: "None", url: "https://example.com/hook")
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      cards(:logo).close
+    end
+  end
+
+  test "webhooks on other boards are skipped" do
+    webhook = boards(:miltons_wish_list).webhooks.create!(name: "Other board", url: "https://example.com/hook", subscribed_actions: %w[ card_closed ])
+
+    assert_no_difference -> { webhook.deliveries.count } do
+      cards(:logo).close
+    end
+  end
+
+  test "comments dispatch to subscribed webhooks" do
+    webhook = boards(:writebook).webhooks.create!(name: "Comments", url: "https://example.com/hook", subscribed_actions: %w[ comment_created ])
+
+    assert_difference -> { webhook.deliveries.count }, +1 do
+      cards(:logo).comments.create!(body: "Looks good")
+    end
+
+    assert_equal "comment_created", webhook.deliveries.last.event.action
+  end
+
+  test "publishing a card dispatches card_published" do
+    card = boards(:writebook).cards.create!(title: "Brand new idea")
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      card.publish
+    end
+
+    delivery = @webhook.deliveries.last
+    assert_equal card.id, delivery.event.eventable_id
+    assert_equal "card_published", delivery.event.action
+  end
+end
