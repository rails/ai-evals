index 0000000..a641e09
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created automatically with the webhook" do
+    webhook = Webhook.create!(name: "Tracked", url: "https://example.com/webhook", board: boards(:writebook))
+
+    tracker = webhook.delinquency_tracker
+    assert tracker.persisted?
+    assert_equal webhook.account, tracker.account
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "failure counts consecutive failures and remembers the first one" do
+    freeze_time do
+      @tracker.failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+
+      travel 1.minute
+      @tracker.failure
+
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 1.minute.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "success resets the counter" do
+    @tracker.update!(consecutive_failures_count: 3, first_failure_at: 10.minutes.ago)
+
+    @tracker.success
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "success on a clean tracker does not touch it" do
+    assert_no_changes -> { @tracker.reload.updated_at } do
+      @tracker.success
+    end
+  end
+
+  test "ten consecutive failures within an hour deactivate the webhook" do
+    9.times { @tracker.failure }
+
+    assert @webhook.reload.active?
+
+    @tracker.failure
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "failures older than an hour start a new streak" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 61.minutes.ago)
+
+    freeze_time do
+      @tracker.failure
+
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "nine spread-out failures followed by a success keeps the webhook active" do
+    9.times { @tracker.failure }
+    @tracker.success
+    9.times { @tracker.failure }
+
+    assert @webhook.reload.active?
+    assert_equal 9, @tracker.consecutive_failures_count
+  end
+
+  test "is destroyed with the webhook" do
+    assert_difference -> { Webhook::DelinquencyTracker.count }, -1 do
+      @webhook.destroy
+    end
+  end
+end
