--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,28 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
+  # Raised when the receiver can't be reached at the network level, as opposed
+  # to responding with an error status code.
+  DestinationUnreachable = Class.new(StandardError)
+
+  CONNECTION_ERRORS = [
+    DestinationUnreachable,
+    EOFError,
+    SocketError,
+    SystemCallError,
+    Timeout::Error,
+    Net::HTTPBadResponse,
+    Net::HTTPHeaderSyntaxError,
+    OpenSSL::SSL::SSLError,
+    Resolv::ResolvError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +33,22 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :expired, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  def self.cleanup
+    expired.in_batches(&:delete_all)
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if webhook.active? && claim
+      post_event
+      track_outcome
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +69,80 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      # Flipping the state atomically is what makes the delivery go out exactly
+      # once: only the first performer to claim a pending delivery posts it,
+      # even if the job gets executed more than once.
+      self.class.where(id: id, state: "pending").update_all(state: "in_progress", updated_at: Time.current) == 1 && reload
+    end
+
+    def post_event
+      payload = webhook.payload_for(event)
+      headers = headers_for(payload)
+      logged_request = { headers: headers }
+
+      begin
+        http_response = post_payload(payload, headers)
+        update! state: :completed, request: logged_request, response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+      rescue *CONNECTION_ERRORS
+        update! state: :errored, request: logged_request, response: { error: "destination_unreachable" }
+      end
+    end
+
+    def headers_for(payload)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => Time.now.utc.iso8601(3),
+        "X-Webhook-Signature" => signature_for(payload)
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    end
+
+    def post_payload(payload, headers)
+      if ip_address = public_ip_address
+        http_connection(ip_address).request post_request(payload, headers)
+      else
+        raise DestinationUnreachable
+      end
+    end
+
+    def public_ip_address
+      SsrfProtection.resolve_public_ip(uri.host)
+    end
+
+    def http_connection(ip_address)
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        # Pin the connection to the verified public IP so a DNS rebinding can't
+        # redirect the request to an internal address.
+        http.ipaddr = ip_address
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = WRITE_TIMEOUT
+      end
+    end
+
+    def post_request(payload, headers)
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
+
+    def track_outcome
+      if succeeded?
+        webhook.delinquency_tracker&.success
+      else
+        webhook.delinquency_tracker&.failure
+      end
+    end
 end
diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..52d58d9 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -159,3 +159,37 @@ __Response:__
 ```
 
 `request` and `response` can be `null` for deliveries that have not started yet or are still in progress. The delivery request headers omit the `X-Webhook-Signature` header.
+
+## Receiving webhooks
+
+When an event happens on a board, Fizzy sends a `POST` request to the payload URL of every active webhook subscribed to the event's action.
+
+The request is sent with these headers:
+
+```
+User-Agent: fizzy/1.0.0 Webhook
+Content-Type: application/json
+X-Webhook-Timestamp: 2025-12-05T19:36:35.401Z
+X-Webhook-Signature: 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
+```
+
+`X-Webhook-Signature` is a hex-encoded HMAC-SHA256 of the request body, computed with the webhook's `signing_secret`. Use it together with `X-Webhook-Timestamp` to verify that a request came from Fizzy and is not a replay.
+
+The request body describes the event:
+
+```json
+{
+  "id": "03f5v9zkft4hj9qq0lsn9ohde",
+  "action": "card_closed",
+  "created_at": "2025-12-05T19:36:35.401Z",
+  "eventable": { "id": "03f5v9zkft4hj9qq0lsn9ohdb", "number": 1, "title": "The logo isn't big enough" },
+  "board": { "id": "03f5v9zkft4hj9qq0lsn9ohcy", "name": "Fizzy" },
+  "creator": { "id": "03f5v9zjw7pz8717a4no1h8a7", "name": "David Heinemeier Hansson" }
+}
+```
+
+Webhooks pointing at a Slack, Campfire, or Basecamp chat URL receive a simplified body instead, with the event rendered as text in a `text` (Slack) or `content` (Campfire and Basecamp) field.
+
+Every event is delivered exactly once: deliveries are not retried. A receiver is expected to answer with a `2XX` status code. Anything else -- an error status, a timeout, or an unreachable host -- is recorded as a failure in the webhook's delivery log. If a receiver fails ten times in a row within an hour, the webhook is switched off and must be reactivated by hand once the receiver is healthy again.
+
+Deliveries are kept for one week.
