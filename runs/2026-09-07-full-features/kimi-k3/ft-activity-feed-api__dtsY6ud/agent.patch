+class ActivitiesController < ApplicationController
+  # Mirrors the kinds of events shown on the HTML timeline (see User::DayTimeline),
+  # except deprecated card_collection_changed events are omitted and
+  # card_title_changed events are included.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  def index
+    set_page_and_extract_portion_from filtered_events
+  end
+
+  private
+    def filtered_events
+      events = Current.user.accessible_events.preloaded.where(action: ACTIVITY_ACTIONS).order(created_at: :desc, id: :desc)
+      events = events.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      events = events.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      events
+    end
+end
diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..5b649f5 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,26 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # Event-specific details, as exposed through the API. Missing values are
+  # returned as empty strings.
+  def particulars_summary
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: assignee_ids }
+    when "card_board_changed"
+      { old_board: particular("old_board"), new_board: particular("new_board") }
+    when "card_title_changed"
+      { old_title: particular("old_title"), new_title: particular("new_title") }
+    when "card_triaged"
+      { column: particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular(key)
+      particulars.dig("particulars", key).to_s
+    end
 end
