+# Activities
+
+Activities are the events that happened in the account, such as cards being added, moved, assigned, or commented on. They mirror what you see in the activity timeline in the app.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of events from boards you have access to, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by event creator user ID(s) |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David assigned JZ to \"Layout is broken\"",
+    "particulars": {
+      "assignee_ids": [
+        "03f5v9zppzlksuj4mxba2nbzn"
+      ]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.534Z",
+      "auto_postpone_period_in_days": 30,
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+Each event contains:
+
+| Field | Description |
+|-------|-------------|
+| `id` | Unique identifier of the event |
+| `action` | The kind of event (see below) |
+| `created_at` | When the event happened |
+| `description` | Plain-text description of the event |
+| `particulars` | Event-specific details (see below) |
+| `url` | For card events, opens the card. For comment events, opens the card where the comment was posted and jumps to that comment |
+| `eventable_type` | `card` or `comment` |
+| `eventable` | The card or comment the event is about |
+| `board` | The board where the event happened |
+| `creator` | The user who made the event happen |
+
+### Actions
+
+- `card_assigned`
+- `card_unassigned`
+- `card_published`
+- `card_closed`
+- `card_reopened`
+- `card_board_changed`
+- `card_postponed`
+- `card_auto_postponed`
+- `card_triaged`
+- `card_sent_back_to_triage`
+- `card_title_changed`
+- `comment_created`
+
+### Particulars
+
+The `particulars` object exposes event-specific details. Events of other kinds return an empty `particulars` object. Missing values are returned as empty strings.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..8e24ce5
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,284 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of events, newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any?
+
+    timestamps = @response.parsed_body.map { |event| Time.iso8601(event["created_at"]) }
+    assert_equal timestamps.sort.reverse, timestamps
+  end
+
+  test "index as JSON includes event attributes" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_assignment_jz).id }
+    assert_not_nil event
+
+    assert_equal "card_assigned", event["action"]
+    assert_equal events(:layout_assignment_jz).created_at.utc.as_json, event["created_at"]
+    assert_equal [ users(:jz).id ], event.dig("particulars", "assignee_ids")
+    assert_equal "card", event["eventable_type"]
+    assert_equal cards(:layout).id, event.dig("eventable", "id")
+    assert_equal boards(:writebook).id, event.dig("board", "id")
+    assert_equal users(:david).id, event.dig("creator", "id")
+    assert_equal card_url(cards(:layout)), event["url"]
+    assert_includes event["description"], "assigned JZ to"
+    assert_includes event["description"], cards(:layout).title
+  end
+
+  test "index as JSON includes descriptions in plain text" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    assert_equal "David commented on &quot;#{cards(:layout).title}&quot;", event["description"]
+  end
+
+  test "comment events point to the card with a comment anchor" do
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["id"] == events(:layout_commented).id }
+    comment = events(:layout_commented).eventable
+
+    assert_equal "comment_created", event["action"]
+    assert_equal "comment", event["eventable_type"]
+    assert_equal comment.id, event.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), event["url"]
+    assert_equal({}, event["particulars"])
+  end
+
+  test "title changes are included and expose old and new titles" do
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_title_changed" }
+    assert_not_nil event
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, event["particulars"])
+  end
+
+  test "board changes expose old and new boards" do
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_board_changed",
+      particulars: { particulars: { old_board: "Writebook", new_board: "Private board" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, event["particulars"])
+  end
+
+  test "triage events expose the column" do
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_triaged",
+      particulars: { particulars: { column: "In progress" } })
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_triaged" }
+    assert_equal({ "column" => "In progress" }, event["particulars"])
+  end
+
+  test "missing particular values are returned as empty strings" do
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_triaged", particulars: {})
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_title_changed", particulars: {})
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_board_changed", particulars: {})
+
+    get activities_path(format: :json)
+
+    assert_equal({ "column" => "" }, @response.parsed_body.find { |e| e["action"] == "card_triaged" }["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, @response.parsed_body.find { |e| e["action"] == "card_title_changed" }["particulars"])
+    assert_equal({ "old_board" => "", "new_board" => "" }, @response.parsed_body.find { |e| e["action"] == "card_board_changed" }["particulars"])
+  end
+
+  test "deprecated card_collection_changed events are omitted" do
+    boards(:writebook).events.create!(
+      creator: users(:david), eventable: cards(:logo), action: "card_collection_changed",
+      particulars: { particulars: { old_collection: "A", new_collection: "B" } })
+
+    get activities_path(format: :json)
+
+    assert_nil @response.parsed_body.find { |e| e["action"] == "card_collection_changed" }
+  end
+
+  test "other events return empty particulars" do
+    get activities_path(format: :json)
+
+    %w[ card_published card_closed card_sent_back_to_triage ].each do |action|
+      event = @response.parsed_body.find { |e| e["action"] == action }
+      assert_not_nil event, "Expected an event with action #{action}"
+      assert_equal({}, event["particulars"])
+    end
+  end
+
+  test "filter by creator_ids" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "filter by board_ids" do
+    boards(:private).events.create!(
+      creator: users(:kevin), eventable: cards(:logo), action: "card_published")
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event.dig("board", "id") == boards(:private).id }
+  end
+
+  test "only returns activity the current user can access" do
+    boards(:private).events.create!(
+      creator: users(:kevin), eventable: cards(:logo), action: "card_published")
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.none? { |event| event.dig("board", "id") == boards(:private).id }
+  end
+
+  test "board_ids filter cannot leak inaccessible activity" do
+    boards(:private).events.create!(
+      creator: users(:kevin), eventable: cards(:logo), action: "card_published")
+
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "authenticate with access token" do
+    sign_out
+
+    get activities_path(format: :json), env: bearer_token_env(identity_access_tokens(:davids_api_token).token)
+    assert_response :success
+
+    get activities_path(format: :json), env: bearer_token_env("nonsense")
+    assert_response :unauthorized
+  end
+
+  test "read-only access token can read activities" do
+    get activities_path(format: :json), env: bearer_token_env(identity_access_tokens(:jasons_api_token).token)
+    assert_response :success
+  end
+
+  test "requests without .json extension default to JSON" do
+    get activities_path, env: bearer_token_env(identity_access_tokens(:davids_api_token).token)
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get activities_path(format: :json)
+    assert_response :redirect
+  end
+
+  test "returns an empty array when nothing matches" do
+    get activities_path(format: :json), params: { creator_ids: [ "nope" ] }
+
+    assert_response :success
+    assert_equal [], @response.parsed_body
+  end
+
+  test "supports conditional requests with etags" do
+    get activities_path(format: :json)
+    assert_response :success
+    etag = @response.headers["ETag"]
+    assert_not_nil etag
+
+    get activities_path(format: :json), headers: { "If-None-Match" => etag }
+    assert_response :not_modified
+  end
+
+  test "includes events tracked by real card operations" do
+    with_current_user :david do
+      cards(:logo).update!(title: "The logo REALLY isn't big enough")
+    end
+
+    get activities_path(format: :json)
+
+    event = @response.parsed_body.find { |e| e["action"] == "card_title_changed" }
+    assert_not_nil event
+    assert_equal "The logo isn't big enough", event.dig("particulars", "old_title")
+    assert_equal "The logo REALLY isn't big enough", event.dig("particulars", "new_title")
+  end
+
+  test "triaging a card surfaces in activities with the column particular" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    post card_triage_path(card), params: { column_id: column.id }
+
+    get activities_path(format: :json)
+    event = @response.parsed_body.find { |e| e["action"] == "card_triaged" }
+    assert_not_nil event
+    assert_equal column.name, event.dig("particulars", "column")
+  end
+
+  test "paginates with total count header" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.where(action: ActivitiesController::ACTIVITY_ACTIONS).count.to_s,
+      @response.headers["X-Total-Count"]
+  end
+
+  test "paginates following the geared pagination conventions" do
+    20.times do |index|
+      boards(:writebook).events.create!(
+        creator: users(:david), eventable: cards(:logo), action: "card_published",
+        created_at: Time.current + index.minutes)
+    end
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+
+    next_page_url = @response.headers["Link"][/<([^>]+)>/, 1]
+    assert_not_nil next_page_url
+
+    get next_page_url
+    assert_response :success
+    assert_equal @response.headers["X-Total-Count"].to_i - 15, @response.parsed_body.size
+  end
+
+test "system-generated events render with the system user as creator" do
+  boards(:writebook).events.create!(
+    creator: users(:system), eventable: cards(:shipping), action: "card_auto_postponed")
+
+  get activities_path(format: :json)
+
+  event = @response.parsed_body.find { |e| e["action"] == "card_auto_postponed" }
+  assert_not_nil event
+  assert_equal users(:system).id, event.dig("creator", "id")
+  assert_includes event["description"], "due to inactivity"
+  assert_equal({}, event["particulars"])
+end
+
+  private
+    def bearer_token_env(token)
+      { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+    end
+end
