diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..00b3595
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,44 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # Switch a webhook off when its receiver keeps failing: this many
+  # consecutive failed deliveries...
+  MAX_CONSECUTIVE_FAILURES = 10
+
+  # ...within this window. Failures spread out over a longer period start
+  # a new streak instead of adding to an expired one.
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track_success
+    reset if tracking_failures?
+  end
+
+  def track_failure
+    with_lock do
+      if first_failure_at&.after?(FAILURE_WINDOW.ago)
+        self.consecutive_failures_count += 1
+      else
+        self.consecutive_failures_count = 1
+        self.first_failure_at = Time.current
+      end
+
+      save!
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    def tracking_failures?
+      consecutive_failures_count > 0 || first_failure_at.present?
+    end
+
+    def delinquent?
+      consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES
+    end
+end
