@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Webhook::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution("93.184.216.34")
+    Current.user = users(:kevin)
+    @board = Board.create!(name: "Delivery job board", creator: users(:kevin))
+    @webhook = @board.webhooks.create!(
+      name: "Test", url: "https://receiver.example.com/hook",
+      subscribed_actions: %w[ card_published ])
+  end
+
+  test "deliveries run on the webhooks queue" do
+    assert_enqueued_with(job: Webhook::DeliveryJob, queue: "webhooks") do
+      @board.cards.create!(title: "New card", creator: users(:kevin), status: :published)
+    end
+  end
+
+  test "performing the job delivers the webhook" do
+    stub_request(:post, "https://receiver.example.com/hook")
+      .with(ipaddr: "93.184.216.34")
+      .to_return(status: 200)
+
+    perform_enqueued_jobs do
+      @board.cards.create!(title: "New card", creator: users(:kevin), status: :published)
+    end
+
+    delivery = @webhook.deliveries.last
+    assert_equal "completed", delivery.state
+    assert delivery.succeeded?
+  end
+
+  test "discarded when the delivery is gone" do
+    delivery = @webhook.deliveries.create!(event: events(:logo_published))
+    delivery.destroy
+
+    assert_nothing_raised do
+      Webhook::DeliveryJob.perform_now(delivery)
+    end
+  end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..777aa0b
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(name: "Test", url: "https://example.com/webhook", board: boards(:writebook))
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created automatically with the webhook" do
+    assert @tracker.persisted?
+    assert_equal @webhook.account, @tracker.account
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "failures accumulate within an hour of the first one" do
+    9.times { @tracker.track_failure }
+
+    assert @webhook.reload.active?
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+
+    @tracker.track_failure
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "a failure after more than an hour starts a new streak" do
+    @tracker.track_failure
+    @tracker.update! first_failure_at: 61.minutes.ago
+
+    @tracker.track_failure
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "success resets the streak" do
+    3.times { @tracker.track_failure }
+
+    @tracker.track_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "success on a clean tracker does not write" do
+    assert_no_difference -> { Webhook::DelinquencyTracker.find(@tracker.id).updated_at } do
+      @tracker.track_success
+    end
+  end
+end
diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..ce5d2bc 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -77,4 +77,102 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
 
     assert_nil delivery.response_summary
   end
+
+  test "deliver posts the event payload to the webhook url" do
+    stub_dns_resolution("93.184.216.34")
+    Current.user = users(:kevin)
+    webhook = webhooks(:active)
+    event = events(:logo_published)
+    delivery = webhook.deliveries.create!(event: event)
+
+    request_body = nil
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return do |request|
+      request_body = request.body
+      { status: 200 }
+    end
+
+    delivery.deliver
+
+    assert delivery.reload.succeeded?
+    assert_equal "completed", delivery.state
+    assert_equal 200, delivery.response[:code]
+    assert_nil delivery.response[:error]
+
+    headers = delivery.request["headers"]
+    assert_equal "fizzy/1.0.0 Webhook", headers["User-Agent"]
+    assert_equal "application/json", headers["Content-Type"]
+    assert_equal event.created_at.utc.iso8601(3), headers["X-Webhook-Timestamp"]
+    assert_equal "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, request_body)}", headers["X-Webhook-Signature"]
+
+    payload = JSON.parse(request_body)
+    assert_equal event.id, payload["id"]
+    assert_equal event.action, payload["action"]
+    assert_equal event.board_id, payload.dig("board", "id")
+    assert_equal event.creator_id, payload.dig("creator", "id")
+
+    assert_requested(:post, webhook.url, times: 1)
+  end
+
+  test "deliver is exactly once even when invoked repeatedly" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    delivery.deliver
+    delivery.reload.deliver
+    Webhook::DeliveryJob.perform_now(delivery)
+
+    assert_requested(:post, webhook.url, times: 1)
+    assert_equal "completed", delivery.reload.state
+  end
+
+  test "deliver records non-2xx responses as failed" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 500)
+
+    delivery.deliver
+
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 500, delivery.response[:code]
+  end
+
+  test "deliver records network errors as errored" do
+    stub_dns_resolution("93.184.216.34")
+    webhook = webhooks(:active)
+    delivery = webhook.deliveries.create!(event: events(:logo_published))
+
+    stub_request(:post, webhook.url).with(ipaddr: "93.184.216.34").to_raise(Errno::ECONNREFUSED)
+
+    delivery.deliver
+
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response[:error]
+    assert delivery.failed?
+  end
+
+  test "deliver skips inactive webhooks" do
+    webhook = webhooks(:inactive)
+    delivery = webhook.deliveries.create!(event: events(:layout_published))
+
+    delivery.deliver
+
+    assert delivery.reload.pending?
+  end
+
+  test "cleanup deletes deliveries older than a week" do
+    old = webhook_deliveries(:successfully_completed)
+    old.update_columns(created_at: 8.days.ago)
+    recent = webhook_deliveries(:pending)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(old.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
 end
