+  RETENTION_PERIOD = 1.week
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+  WRITE_TIMEOUT = 10
+
+  NETWORK_ERRORS = [
+    EOFError, IOError, SocketError, SystemCallError, Timeout::Error,
+    Net::ProtocolError, OpenSSL::SSL::SSLError, URI::InvalidURIError
+  ].freeze
+
   belongs_to :account, default: -> { webhook.account }
