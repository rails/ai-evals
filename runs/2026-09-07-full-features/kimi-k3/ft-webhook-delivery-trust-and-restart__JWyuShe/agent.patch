   belongs_to :event
@@ -10,6 +22,24 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if webhook.active? && claim_for_delivery
+      perform_request
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +59,106 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    # Atomically transition pending -> in_progress so only one performer ever
+    # sends the request, even if the delivery job is performed more than once.
+    def claim_for_delivery
+      if self.class.where(id: id, state: "pending").update_all(state: "in_progress", updated_at: Time.current) == 1
+        self.state = :in_progress
+        true
+      else
+        false
+      end
+    end
+
+    def perform_request
+      self.request = { headers: request_headers }
+      save!
+
+      if http_response = post_payload
+        record_response http_response
+      else
+        record_error
+      end
+    rescue *NETWORK_ERRORS
+      record_error
+    end
+
+    def post_payload
+      if ip_address = SsrfProtection.resolve_public_ip(uri.host)
+        http = Net::HTTP.new(uri.host, uri.port)
+        http.ipaddr = ip_address
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = WRITE_TIMEOUT
+        http.max_retries = 0
+
+        http.request build_post_request
+      end
+    end
+
+    def build_post_request
+      Net::HTTP::Post.new(uri.request_uri, request_headers).tap do |post|
+        post.body = payload
+      end
+    end
+
+    def record_response(http_response)
+      update! state: :completed, response: { code: http_response.code.to_i, error: nil }
+      track_delinquency
+    end
+
+    def record_error
+      update! state: :errored, response: { error: "destination_unreachable" }
+      track_delinquency
+    end
+
+    def track_delinquency
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+      if succeeded?
+        tracker.track_success
+      elsif failed?
+        tracker.track_failure
+      end
+    end
+
+    def request_headers
+      @request_headers ||= {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601(3),
+        "X-Webhook-Signature" => payload_signature
+      }
+    end
+
+    def payload_signature
+      "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)}"
+    end
+
+    def payload
+      @payload ||= ApplicationController.renderer.new(**renderer_options).render \
+        template: "webhooks/event", formats: [ :json ], assigns: { event: event }
+    end
+
+    def renderer_options
+      { script_name: account.slug }.tap do |options|
+        if url_options[:host].present?
+          options[:http_host] = [ url_options[:host], url_options[:port] ].compact.join(":")
+          options[:https] = url_options[:protocol].to_s.start_with?("https")
+        end
+      end
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
 end
diff --git a/docs/api/sections/webhooks.md b/docs/api/sections/webhooks.md
index a4f48b5..5fb5796 100644
--- a/docs/api/sections/webhooks.md
+++ b/docs/api/sections/webhooks.md
@@ -159,3 +159,29 @@ __Response:__
 ```
 
 `request` and `response` can be `null` for deliveries that have not started yet or are still in progress. The delivery request headers omit the `X-Webhook-Signature` header.
+
+## Receiving webhooks
+
+When something happens on a board, Fizzy sends an HTTP `POST` with a JSON body to the
+URL of every active webhook subscribed to that event. Each event is delivered exactly
+once per webhook.
+
+The body describes the event: its `id`, `action`, and `created_at` timestamp, plus the
+`eventable` (a card or a comment), the `board`, and the `creator`.
+
+__Request headers:__
+
+- `Content-Type: application/json`
+- `User-Agent: fizzy/1.0.0 Webhook`
+- `X-Webhook-Timestamp`: when the event happened, in ISO 8601 UTC
+- `X-Webhook-Signature`: `sha256=` followed by the HMAC-SHA256 hex digest of the request
+  body, keyed with the webhook's `signing_secret`. Use it to verify the request came
+  from us.
+
+Respond with any `2XX` status to acknowledge the delivery. Any other status, or an
+unreachable receiver, is recorded as a failure in the webhook's delivery log. A webhook
+whose deliveries fail ten times in a row within an hour is switched off automatically;
+an admin can reactivate it once the receiver is healthy again.
+
+Delivery history is kept for one week and can be inspected with the deliveries endpoint
+above.
