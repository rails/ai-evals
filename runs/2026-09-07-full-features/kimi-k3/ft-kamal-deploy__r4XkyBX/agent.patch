diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..ec922cb
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,87 @@
+# Deploy Fizzy to your own server with Kamal (https://kamal-deploy.org).
+#
+# Everything runs on one box: the Rails app, background jobs (Solid Queue),
+# kamal-proxy terminating SSL with a free Let's Encrypt certificate, and
+# SQLite databases + file uploads on a persistent Docker volume.
+#
+# To deploy:
+#   1. Replace the values marked CHANGE ME below.
+#   2. Fill in the secrets that .kamal/secrets reads.
+#   3. Run `bin/kamal setup`.
+#
+# See docs/deployment.md for a step-by-step guide.
+
+service: fizzy
+
+# The Docker image that is built and deployed. CHANGE ME to your own
+# Docker Hub account (or push to another registry, see registry/server).
+image: your-docker-hub-username/fizzy
+
+# Everything is deployed to this one server. CHANGE ME to the IP address or
+# SSH hostname of your server.
+servers:
+  web:
+    hosts:
+      - 192.168.0.1
+  # Background jobs run on the same box.
+  job:
+    cmd: bin/jobs
+    hosts:
+      - 192.168.0.1
+
+# kamal-proxy serves the app over HTTPS and automatically requests and renews
+# a Let's Encrypt certificate. CHANGE ME to the hostname that points at your
+# server, e.g. fizzy.example.com.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+
+# Credentials for the registry your image is pushed to.
+registry:
+  # CHANGE ME to your registry username (Docker Hub by default).
+  username: your-docker-hub-username
+  # Always use an access token rather than a real password (read from .kamal/secrets).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+  # Using another registry? Point at it here, e.g. ghcr.io.
+  # server: ghcr.io
+
+# Environment variables for the app. Secrets are read from .kamal/secrets.
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+  clear:
+    # Jobs run in the dedicated job role (bin/jobs), not inside the web process.
+    SOLID_QUEUE_IN_PUMA: "false"
+
+    # CHANGE ME: the same hostname as proxy/host above. Used for links in emails.
+    APP_HOST: fizzy.example.com
+
+    # CHANGE ME: the address sign-in and notification emails are sent from.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+
+    # CHANGE ME: your outgoing mail server. Magic links are sent by email,
+    # so Fizzy can't log anyone in without one.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    SMTP_DOMAIN: fizzy.example.com
+    # The password is read from SMTP_PASSWORD in .kamal/secrets.
+
+# Keep the SQLite databases and uploaded files in a Docker volume so your
+# data survives the next deploy.
+volumes:
+  - fizzy-storage:/rails/storage
+
+# Bridge fingerprinted assets between releases to avoid 404s on in-flight requests.
+asset_path: /rails/public/assets
+
+# Build for the CPU architecture of your server. Use arm64 for ARM machines.
+builder:
+  arch: amd64
+
+# Handy shortcuts: bin/kamal console, bin/kamal shell.
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse "bash"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..abd271b 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,28 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Generate URLs (like the magic sign-in links in emails) for the hostname
+  # Fizzy is served from, e.g. APP_HOST=fizzy.example.com.
+  if ENV["APP_HOST"].present?
+    config.action_controller.default_url_options = { host: ENV["APP_HOST"], protocol: "https" }
+    config.action_mailer.default_url_options     = { host: ENV["APP_HOST"], protocol: "https" }
+  end
+
+  # Deliver email through your own SMTP server. Fizzy signs people in with
+  # magic links sent by email, so it can't log anyone in until this works.
+  if ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address:              ENV["SMTP_ADDRESS"],
+      port:                 ENV.fetch("SMTP_PORT", 587).to_i,
+      domain:               ENV["SMTP_DOMAIN"].presence,
+      user_name:            ENV["SMTP_USERNAME"].presence,
+      password:             ENV["SMTP_PASSWORD"].presence,
+      authentication:       (ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym if ENV["SMTP_USERNAME"].present?),
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..9c5f7b0
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,95 @@
+# Deploying Fizzy to your own server
+
+Fizzy ships with a [Kamal](https://kamal-deploy.org) configuration for running
+everything on a single Linux box: the Rails app, background jobs, SQLite
+databases, and file uploads in one container, with kamal-proxy terminating
+SSL via a free Let's Encrypt certificate.
+
+## What you'll need
+
+- **A server** running a recent Linux with at least 1GB of RAM, that you can
+  SSH into as root (or a user with passwordless sudo). Kamal will install
+  Docker on it during setup — you don't need to install anything yourself.
+- **A hostname** pointing at your server, e.g. an `A` record for
+  `fizzy.example.com`. Ports 80 and 443 must be reachable from the internet
+  so Let's Encrypt can issue your certificate.
+- **A Docker registry account** to hold the images you build, e.g.
+  [Docker Hub](https://hub.docker.com). Create an access token; Kamal uses it
+  to push the image from your machine and pull it onto the server.
+- **An SMTP server** for outgoing email. Fizzy signs people in with magic
+  links sent by email, so nothing works without one. Any provider works:
+  Postmark, SES, Mailgun, your own Postfix, etc.
+- **A local checkout** of your fork with the dependencies installed
+  (`bin/setup`), so you can run `bin/kamal`.
+
+## Setup
+
+1. **Fill in `config/deploy.yml`.** Replace every value marked CHANGE ME:
+
+   - `image`: the image name in your registry, e.g. `your-docker-hub-username/fizzy`.
+   - `servers`: the IP address or SSH hostname of your server (same host for
+     the `web` and `job` roles — background jobs run on the box).
+   - `proxy/host`: the hostname Fizzy will be served from.
+   - `registry/username`: your registry username.
+   - `env/clear`: `APP_HOST` (same hostname again, used for links in emails),
+     `MAILER_FROM_ADDRESS`, and your `SMTP_*` settings.
+
+2. **Fill in the secrets** that `.kamal/secrets` reads. By default they're
+   read from your environment:
+
+   ```sh
+   export KAMAL_REGISTRY_PASSWORD=...  # access token for your registry
+   export SECRET_KEY_BASE=$(bin/rails secret)
+   export SMTP_PASSWORD=...            # password for your SMTP server
+   ```
+
+   Keep them somewhere safe — `SECRET_KEY_BASE` protects your session data,
+   and if you lose it, everyone is logged out after the next deploy.
+
+3. **Deploy:**
+
+   ```sh
+   bin/kamal setup
+   ```
+
+   This installs Docker on the server, builds the image, pushes it to your
+   registry, creates the `fizzy-storage` volume for the SQLite databases and
+   uploads, runs the migrations, and boots the app behind kamal-proxy.
+
+4. **Visit `https://your-host`** and sign up. The first account is created
+   from your email address via a magic link.
+
+That's it — your data lives in the `fizzy-storage` Docker volume, so it
+survives every deploy.
+
+## Day to day
+
+```sh
+bin/kamal deploy    # deploy the latest code (git pull first)
+bin/kamal console   # Rails console on the server
+bin/kamal shell     # shell inside the running container
+bin/kamal app logs  # tail the app logs
+```
+
+### Backups
+
+Everything that matters is in the `fizzy-storage` volume on the server
+(`/rails/storage` inside the container): the SQLite databases and the
+uploaded files. To back it up:
+
+```sh
+ssh root@your-server "mkdir -p /root/backups && docker run --rm -v fizzy-storage:/data -v /root/backups:/backup alpine tar czf /backup/fizzy-$(date +%F).tar.gz -C /data ."
+```
+
+## Options
+
+- **Push notifications**: generate VAPID keys as described in
+  [the development guide](development.md#web-push-notifications), add
+  `VAPID_PUBLIC_KEY` and `VAPID_PRIVATE_KEY` to `env/secret` in
+  `config/deploy.yml` and to `.kamal/secrets`, then redeploy.
+- **Object storage for uploads**: set `ACTIVE_STORAGE_SERVICE=s3` and the
+  `S3_*` variables from `config/storage.oss.yml` in `env` to store uploads in
+  S3 instead of on the volume.
+- **SaaS mode**: 37signals' own multi-tenant deployment lives in
+  [saas/config](../saas/config/deploy.yml) and can serve as inspiration for
+  larger setups.
