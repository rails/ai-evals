@@ -0,0 +1,23 @@
+# Secrets defined here are available for reference under registry/password and
+# env/secret in config/deploy.yml. All secrets should be pulled from either a
+# password manager, the environment, or a file. DO NOT ENTER RAW CREDENTIALS
+# HERE! This file needs to be safe for git.
+
+# Option 1: Read secrets from the environment. Export these before running
+# bin/kamal, e.g. in your shell profile or a locally-sourced .env file:
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Generate SECRET_KEY_BASE with: bin/rails secret
+
+# Option 2: Read secrets via a command:
+# SECRET_KEY_BASE=$(cat config/master.key)
+# KAMAL_REGISTRY_PASSWORD=$(gh auth token)
+
+# Option 3: Read secrets via kamal secrets helpers (adapters for 1Password,
+# LastPass, and Bitwarden):
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/MyItem KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD)
+# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
