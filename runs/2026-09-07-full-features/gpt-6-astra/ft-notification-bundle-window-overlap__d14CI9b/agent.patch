diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..b88fd89
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,63 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :items, class_name: "Notification::BundleItem", dependent: :destroy
+  has_many :notifications, through: :items
+
+  validates :starts_at, :ends_at, presence: true
+  validate :window_does_not_overlap
+
+  after_create_commit :deliver_later
+
+  class << self
+    def add(notification, at: Time.current)
+      user = notification.user
+
+      # Lock the user, not a bundle: the first notification has no bundle to lock.
+      # Delivery takes this same lock so late arrivals cannot race with sending.
+      user.with_lock do
+        interval = user.settings&.reload&.bundle_email_interval
+        if interval && user.active? && user.identity && user.account.active? && !notification.creator.system?
+          latest = user.notification_bundles.order(starts_at: :desc).first
+
+          bundle = if latest && !latest.completed_at? && at < latest.ends_at
+            # No lower bound: out-of-order arrivals belong in the window already opened.
+            latest
+          else
+            starts_at = [ at, latest&.ends_at, (Time.current if latest&.completed_at?) ].compact.max
+            user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + interval)
+          end
+
+          bundle.items.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::BundleEmailJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    user.with_lock do
+      reload
+      if !completed_at? && ends_at <= Time.current
+        if user.active? && account.active? && user.identity && user.settings&.reload&.bundle_email_interval && notifications.unread.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+        update!(completed_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def window_does_not_overlap
+      if starts_at && ends_at
+        errors.add(:ends_at, "must be after the start") if ends_at <= starts_at
+        if self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at).exists?
+          errors.add(:starts_at, "overlaps another email window")
+        end
+      end
+    end
+end
