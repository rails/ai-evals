diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..e24e09f
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  test "simultaneous first arrivals open only one window" do
+    identity = Identity.create!(email_address: "digest-concurrency@example.com")
+    user = User.create!(account: accounts(:"37s"), identity: identity, name: "Digest concurrency test")
+    notification = Notification.create!(user: user, source: events(:layout_commented), creator: users(:david))
+    other_notification = Notification.create!(user: user, source: events(:logo_assignment_km), creator: users(:david))
+    user.settings.update!(bundle_email_frequency: "every_few_hours")
+    ready = Queue.new
+    start = Queue.new
+
+    threads = [ notification, other_notification ].map do |candidate|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          arrival = Notification.find(candidate.id)
+          ready << true
+          start.pop
+          Notification::Bundle.add(arrival)
+        end
+      end
+    end
+
+    2.times { ready.pop }
+    2.times { start << true }
+    bundles = threads.map(&:value)
+
+    assert_equal 1, bundles.map(&:id).uniq.size
+    assert_equal 1, user.notification_bundles.count
+    assert_equal 2, user.notification_bundles.sole.items.count
+  ensure
+    threads&.each(&:join)
+    user&.destroy!
+    identity&.destroy!
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..b15f542
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,242 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "notifications share a window starting with the first arrival" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      travel 1.hour
+      other = Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+      assert_equal bundle, other
+      assert_equal 4.hours, bundle.ends_at - bundle.starts_at
+      assert_equal 2, bundle.notifications.count
+    end
+  end
+
+  test "late notifications join the already opened window" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      late_bundle = Notification::Bundle.add(notifications(:layout_commented_kevin), at: 1.hour.ago)
+
+      assert_equal bundle, late_bundle
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+  test "off creates no window" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "each frequency sets the duration of a new window" do
+    { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, interval|
+      @user.notification_bundles.reload.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+      freeze_time do
+        bundle = Notification::Bundle.add(@notification)
+        assert_equal Time.current, bundle.starts_at
+        assert_equal Time.current + interval, bundle.ends_at
+      end
+    end
+  end
+
+  test "the exact end opens an adjacent non-overlapping window" do
+    freeze_time do
+      first = Notification::Bundle.add(@notification)
+      second = Notification::Bundle.add(@notification, at: first.ends_at)
+
+      assert_not_equal first, second
+      assert_equal first.ends_at, second.starts_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "idle time does not create empty windows" do
+    first = Notification::Bundle.add(@notification)
+    travel_to 3.weeks.from_now do
+      second = Notification::Bundle.add(@notification)
+      assert_equal Time.current, second.starts_at
+      assert_operator second.starts_at, :>, first.ends_at
+      assert_equal 2, @user.notification_bundles.count
+    end
+  end
+
+  test "frequency changes leave the open window intact" do
+    first = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    assert_equal first, Notification::Bundle.add(@notification)
+    second = Notification::Bundle.add(@notification, at: first.ends_at)
+    assert_equal 4.hours, first.ends_at - first.starts_at
+    assert_equal 1.week, second.ends_at - second.starts_at
+  end
+
+  test "repeated arrivals do not duplicate membership or delivery jobs" do
+    assert_enqueued_jobs 1, only: Notification::BundleEmailJob do
+      first = Notification::Bundle.add(@notification)
+      assert_equal first, Notification::Bundle.add(@notification)
+      assert_equal 1, first.items.count
+    end
+  end
+
+  test "different people have independent windows" do
+    other = notifications(:logo_mentioned_david)
+    other.user.settings.update!(bundle_email_frequency: "daily")
+    first = Notification::Bundle.add(@notification)
+    second = Notification::Bundle.add(other)
+
+    assert_not_equal first, second
+    assert_equal @user.account, first.account
+    assert_equal other.user, second.user
+    assert_equal 1.day, second.ends_at - second.starts_at
+  end
+
+  test "invalid and overlapping windows are rejected" do
+    bundle = Notification::Bundle.add(@notification)
+    overlapping = @user.notification_bundles.new(starts_at: bundle.starts_at + 1.hour, ends_at: bundle.ends_at + 1.hour)
+    assert_not overlapping.valid?
+    assert overlapping.errors[:starts_at].present?
+    invalid = @user.notification_bundles.new(starts_at: bundle.ends_at, ends_at: bundle.starts_at)
+    assert_not invalid.valid?
+    assert invalid.errors[:ends_at].present?
+  end
+
+  test "new notifications are bundled transactionally and reading does not rebundle" do
+    notifications(:layout_commented_kevin).destroy!
+    notification = nil
+    assert_difference "Notification::Bundle.count", 1 do
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+    assert_equal [ notification ], @user.notification_bundles.sole.notifications
+
+    travel 1.week do
+      assert_no_difference "Notification::Bundle.count" do
+        notification.read
+      end
+    end
+  end
+
+  test "updates to an existing card notification join a new window" do
+    first = Notification::Bundle.add(@notification)
+    travel_to first.ends_at do
+      @notification.update!(source: notifications(:logo_mentioned_david).source)
+      assert_equal 2, @user.notification_bundles.count
+      assert_equal [ @notification ], @user.notification_bundles.order(:starts_at).last.notifications
+    end
+  end
+
+  test "delivery is scheduled at the end and sends one email even if retried" do
+    freeze_time do
+      assert_enqueued_with(job: Notification::BundleEmailJob, at: 4.hours.from_now) do
+        @bundle = Notification::Bundle.add(@notification)
+      end
+      Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        @bundle.deliver
+      end
+      assert_nil @bundle.reload.completed_at
+
+      travel_to @bundle.ends_at
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        Notification::BundleEmailJob.perform_now(@bundle)
+        Notification::BundleEmailJob.perform_now(@bundle)
+      end
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], email.to
+      assert_includes CGI.unescapeHTML(email.html_part.body.decoded), @notification.payload.title
+      assert_includes CGI.unescapeHTML(email.html_part.body.decoded), notifications(:layout_commented_kevin).payload.title
+      assert_includes email.text_part.body.decoded, @notification.account.slug
+      assert @bundle.reload.completed_at
+    end
+  end
+
+  test "late arrivals after delivery never reopen or overlap a completed window" do
+    first = Notification::Bundle.add(@notification)
+    travel_to first.ends_at + 1.hour do
+      first.deliver
+      second = Notification::Bundle.add(notifications(:layout_commented_kevin), at: first.starts_at - 1.hour)
+      assert_equal Time.current, second.starts_at
+      assert_operator second.starts_at, :>=, first.ends_at
+      assert_equal 1, first.items.count
+    end
+  end
+
+  test "turning email off suppresses a pending digest" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: "never")
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+      assert bundle.reload.completed_at
+    end
+  end
+
+  test "read or deleted notifications do not produce an empty email" do
+    bundle = Notification::Bundle.add(@notification)
+    @notification.read
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+    end
+    @notification.destroy!
+    assert_empty bundle.items
+  end
+
+  test "a failed delivery can be retried" do
+    bundle = Notification::Bundle.add(@notification)
+    travel_to bundle.ends_at do
+      NotificationMailer.expects(:bundle).raises(IOError).once
+      assert_raises(IOError) { bundle.deliver }
+      assert_nil bundle.reload.completed_at
+
+      NotificationMailer.unstub(:bundle)
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        bundle.deliver
+      end
+      assert bundle.reload.completed_at
+    end
+  end
+  test "rolling back a notification also rolls back its bundle and delivery job" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_no_enqueued_jobs only: Notification::BundleEmailJob do
+      assert_no_difference "Notification::Bundle.count" do
+        Notification.transaction do
+          Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "inactive users do not open windows" do
+    @user.update!(active: false)
+    assert_nil Notification::Bundle.add(@notification)
+    assert_empty @user.notification_bundles
+  end
+
+  test "deactivated users do not receive pending digests" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.update!(active: false, identity: nil)
+
+    travel_to bundle.ends_at do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+      assert bundle.reload.completed_at
+    end
+  end
+end
