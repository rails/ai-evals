+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.account = @account
+    Current.user = users(:jason)
+  end
+
+  test "an account export can be imported as a separate account" do
+    export = build_export
+    assert export.archive.attached?
+    with_reader(export) do |reader|
+      imported = Account::DataTransfer::Importer.new(reader, identities(:david)).import
+      assert_not_equal export.account.id, imported.id
+      assert_equal export.account.cards.count, imported.cards.count
+      assert_equal export.account.boards.count, imported.boards.count
+      assert_equal Comment.where(account: @account).count, Comment.where(account: imported).count
+      assert imported.users.find_by!(identity: identities(:david)).owner?
+      assert_equal 1, imported.users.where(role: :owner).count
+      assert_not imported.cards.where(id: @account.cards.select(:id)).exists?
+      assert_equal @account.cards_count, imported.cards_count
+    end
+  end
+
+  test "images and comment attachments survive with new keys and rich text references" do
+    card = @account.cards.first
+    card.image.attach(io: StringIO.new("picture bytes"), filename: "picture.png", content_type: "image/png")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("document bytes"), filename: "document.txt", content_type: "text/plain")
+    comment = card.comments.create!(creator: users(:jason), body: ActionText::Content.new("Comment #{blob.to_attachable_partial_path}").append_attachables([ blob ]))
+    export = build_export
+
+    with_reader(export) do |reader|
+      imported = Account::DataTransfer::Importer.new(reader, identities(:david)).import
+      copy = imported.cards.find_by!(number: card.number)
+      assert_equal "picture bytes", copy.image.download
+      assert_not_equal card.image.blob.key, copy.image.blob.key
+      copy_comment = copy.comments.find_by!(created_at: comment.created_at)
+      assert_equal "document bytes", copy_comment.attachments.first.download
+      assert_equal copy_comment.attachments.first.blob, copy_comment.body.body.attachables.first
+      assert_equal 27, imported.bytes_used_exact
+    end
+  end
+
+  test "card exports include only accessible cards and cannot be imported as accounts" do
+    user = users(:david)
+    private_board = @account.boards.create!(name: "Private", creator: users(:jason), all_access: false)
+    private_card = private_board.cards.create!(title: "Secret", creator: users(:jason))
+    export = build_export(kind: "cards", user: user)
+    with_reader(export) do |reader|
+      assert_equal user.accessible_cards.count, reader.glob("cards/*.json").size
+      assert_not_includes reader.glob("cards/*.json"), "cards/#{private_card.id}.json"
+      assert reader.json(reader.glob("cards/*.json").first).key?("comments")
+      assert_no_difference "Account.count" do
+        assert_raises(Account::DataTransfer::Importer::InvalidArchive) do
+          Account::DataTransfer::Importer.new(reader, identities(:david)).import
+        end
+      end
+    end
+  end
+
+  test "failure after uploading attachments rolls back all records and files" do
+    @account.cards.first.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    export = build_export
+    with_reader(export) do |reader|
+      importer = Account::DataTransfer::Importer.new(reader, identities(:david))
+      importer.stubs(:ensure_owner).raises(Account::DataTransfer::Importer::InvalidArchive, "Broken account")
+      ActiveStorage::Blob.service.expects(:delete).with { |key| key != export.archive.blob.key }.once
+      assert_no_difference [ "Account.count", "User.count", "Card.count", "Identity.count", "ActiveStorage::Blob.count", "ActiveStorage::Attachment.count" ] do
+        assert_raises(Account::DataTransfer::Importer::InvalidArchive) { importer.import }
+      end
+    end
+  end
+
+  test "an incomplete archive is rejected" do
+    export = build_export
+    with_reader(export) do |reader|
+      reader.stubs(:glob).with("*").returns([ "manifest.json" ])
+      assert_no_difference "Account.count" do
+        assert_raises(Account::DataTransfer::Importer::InvalidArchive) do
+          Account::DataTransfer::Importer.new(reader, identities(:david)).import
+        end
+      end
+    end
+  end
+
+  test "account export permissions are checked when the job runs" do
+    export = Export.create!(account: @account, user: users(:david), kind: "account")
+    assert_raises(ActiveRecord::RecordNotFound) { export.build }
+    assert_not export.archive.attached?
+  end
+
+  test "saved filters and user mentions refer to the imported records" do
+    card = cards(:logo)
+    card.update!(description: ActionText::Content.new("Hello").append_attachables([ users(:david) ]))
+    users(:david).filters.create!(board_ids: [ card.board_id ], tag_ids: [ tags(:mobile).id ], card_ids: [ card.id ])
+    export = build_export
+    with_reader(export) do |reader|
+      imported = Account::DataTransfer::Importer.new(reader, identities(:david)).import
+      copy = imported.cards.find_by!(number: card.number)
+      user = imported.users.find_by!(identity: identities(:david))
+      assert_equal user, copy.description.body.attachables.first
+      filter = user.filters.find { |candidate| candidate.card_ids == [ copy.id ] }
+      assert filter
+      assert_equal [ copy.board_id ], filter.board_ids
+      assert_equal [ imported.tags.find_by!(title: tags(:mobile).title).id ], filter.tag_ids
+    end
+  end
+
+  test "export job emails a signed download link and expired archives are purged" do
+    export = Export.create!(account: @account, user: users(:jason), kind: "account")
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      ExportJob.perform_now(export)
+    end
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ users(:jason).identity.email_address ], mail.to
+    assert_match "/exports/", mail.text_part.body.decoded
+    blob = export.reload.archive.blob
+    travel_to export.completed_at + 1.day + 1.second do
+      Export.cleanup
+      assert_not Export.exists?(export.id)
+      assert_not blob.service.exist?(blob.key)
+    end
+  end
+
+  private
+    def build_export(kind: "account", user: users(:jason))
+      Export.create!(account: @account, user: user, kind: kind).tap(&:build)
+    end
+
+    def with_reader(export)
+      export.archive.open { |file| yield ZipFile::Reader.new(file) }
+    end
+end
