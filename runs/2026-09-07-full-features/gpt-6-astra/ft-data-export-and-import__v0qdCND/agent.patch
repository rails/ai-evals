diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..5bcfc4d
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,60 @@
+# Reads ZIP64 archives without extracting paths or downloading the entire archive.
+class ZipFile::Reader
+  class InvalidArchive < StandardError; end
+  JSON_LIMIT = 32.megabytes
+
+  def initialize(io)
+    @io = io
+    @reader = ZipKit::FileReader.new
+    entries = @reader.read_zip_structure(io: io, read_local_headers: false)
+    @entries = entries.index_by(&:filename)
+    raise InvalidArchive, "Duplicate archive entries" unless entries.size == @entries.size
+
+    entries.each do |entry|
+      unless entry.filename.match?(%r{\A[a-zA-Z0-9_][a-zA-Z0-9_./-]*\z}) && !entry.filename.split("/").include?("..") &&
+          entry.local_file_header_offset >= 0 && entry.local_file_header_offset + entry.compressed_size <= io.size
+        raise InvalidArchive, "Invalid archive entry"
+      end
+    end
+  end
+
+  def glob(pattern)
+    @entries.keys.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def json(path)
+    raise InvalidArchive, "JSON entry is too large" if @entries.fetch(path).uncompressed_size > JSON_LIMIT
+    output = StringIO.new
+    copy(path, output, limit: JSON_LIMIT)
+    JSON.parse(output.string)
+  end
+
+  def size(path)
+    @entries.fetch(path).uncompressed_size
+  end
+
+  def copy(path, output, limit: nil, checksum: nil)
+    entry = @entries.fetch(path) { raise InvalidArchive, "Missing file: #{path}" }
+    unless entry.known_offset?
+      entry.compressed_data_offset = @reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+    end
+    if entry.compressed_data_offset + entry.compressed_size > @io.size
+      raise InvalidArchive, "Invalid file offset"
+    end
+    extractor = entry.extractor_from(@io)
+    size = crc = 0
+    digest = Digest::MD5.new
+    until extractor.eof?
+      chunk = extractor.extract(16.kilobytes)
+      raise InvalidArchive, "Truncated archive entry" if chunk.nil? || (chunk.empty? && !extractor.eof?)
+      size += chunk.bytesize
+      raise InvalidArchive, "Invalid file size" if size > (limit || entry.uncompressed_size)
+      crc = Zlib.crc32(chunk, crc)
+      digest.update(chunk)
+      output.write(chunk)
+    end
+    unless size == entry.uncompressed_size && crc == entry.crc32 && (!checksum || checksum == digest.base64digest)
+      raise InvalidArchive, "Damaged file: #{path}"
+    end
+  end
+end
diff --git a/app/models/zip_file/storage_io.rb b/app/models/zip_file/storage_io.rb
new file mode 100644
index 0000000..7d7848d
--- /dev/null
+++ b/app/models/zip_file/storage_io.rb
@@ -0,0 +1,39 @@
+# Seekable range reads work identically with DiskService and S3Service.
+class ZipFile::StorageIO
+  READ_AHEAD = 8.megabytes
+
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(service, key, size)
+    @service, @key, @size, @pos = service, key, size, 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    position = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then pos + offset
+    when IO::SEEK_END then size + offset
+    end
+    raise ZipFile::Reader::InvalidArchive, "Invalid ZIP offset" unless position && position.between?(0, size)
+    @pos = position
+    0
+  end
+
+  def read(length = nil)
+    length ||= size - pos
+    raise ZipFile::Reader::InvalidArchive, "ZIP directory is too large" unless length.between?(0, 128.megabytes)
+    length = [ length, size - pos ].min
+    if length.zero?
+      "".b
+    else
+      unless @buffer && pos >= @buffer_offset && pos + length <= @buffer_offset + @buffer.bytesize
+        @buffer_offset = pos
+        end_position = [ pos + [ length, READ_AHEAD ].max, size ].min
+        @buffer = @service.download_chunk(@key, pos...end_position)
+        raise ZipFile::Reader::InvalidArchive, "Truncated archive" unless @buffer.bytesize == end_position - pos
+      end
+      @buffer.byteslice(pos - @buffer_offset, length).tap { |data| @pos += data.bytesize }
+    end
+  end
+end
