@@ -0,0 +1,16 @@
+# The same human-readable card JSON is included in account and personal exports.
+class Account::DataTransfer::CardData
+  def self.for(card)
+    {
+      "description" => Account::DataTransfer::RichText.export(card.rich_text_description),
+      "image" => card.image.blob&.as_json(only: %w[id filename content_type byte_size]),
+      "attachments" => card.attachments.map { |attachment| attachment.blob.as_json(only: %w[id filename content_type byte_size]) },
+      "comments" => card.comments.chronologically.map do |comment|
+        comment.as_json.merge(
+          "body" => Account::DataTransfer::RichText.export(comment.rich_text_body),
+          "attachments" => comment.attachments.map { |attachment| attachment.blob.as_json(only: %w[id filename content_type byte_size]) }
+        )
+      end
+    }
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..cc27b2c
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,211 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  def initialize(zip, identity)
+    @zip, @identity = zip, identity
+    @ids, @types, @uploaded_blobs = {}, {}, []
+  end
+
+  def import
+    validate_manifest
+    Account.transaction(requires_new: true) do
+      source = @zip.json(@zip.glob("accounts/*.json").sole)
+      @account = Account.create!(name: source.fetch("name"), cards_count: source.fetch("cards_count"))
+      @account.entropy.destroy!
+      prepare_ids(source.fetch("id"))
+
+      Current.with(account: @account, user: nil) do
+        record_sets.each do |set|
+          next if set.model == Account || set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+          @zip.glob("#{set.model.table_name}/*.json").each { |path| import_record(set.model, @zip.json(path)) }
+        end
+        import_filter_resources
+        ensure_owner
+        rewrite_rich_text
+        rebuild_storage
+        @account.cards.find_each(&:reindex)
+        Comment.where(account: @account).find_each(&:reindex)
+        yield @account if block_given?
+      end
+      @account
+    end
+  rescue Exception
+    # Storage is not transactional. Never leave uploaded objects after a rollback.
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+    raise
+  end
+
+  private
+    def validate_manifest
+      manifest = @zip.json("manifest.json")
+      unless manifest.slice("format", "version", "kind") == { "format" => "fizzy", "version" => 1, "kind" => "account" }
+        raise InvalidArchive, "This is not a supported Fizzy account export"
+      end
+      validate_entries(manifest)
+    end
+
+    def validate_entries(manifest)
+      actual = @zip.glob("*").excluding("manifest.json").group_by { |path| File.dirname(path) }.transform_values(&:size)
+      unless actual == manifest.fetch("entries")
+        raise InvalidArchive, "The archive is incomplete"
+      end
+    end
+
+    def record_sets
+      @record_sets ||= [].tap do |sets|
+        Account::DataTransfer::Manifest.new(@account).each_record_set { |set| sets << set }
+      end
+    end
+
+    def prepare_ids(source_id)
+      record_sets.map(&:model).uniq.each do |model|
+        @zip.glob("#{model.table_name}/*.json").each do |path|
+          id = File.basename(path, ".json")
+          raise InvalidArchive, "Duplicate record ID" if @ids.key?(id)
+          @ids[id] = model == Account ? @account.id : ActiveRecord::Type::Uuid.generate
+          @types[id] = model.name
+        end
+      end
+      raise InvalidArchive, "Invalid account record" unless @types[source_id] == "Account"
+      @source_account_id = source_id
+    end
+
+    def import_record(model, data)
+      source_id = data.fetch("id")
+      unless @types[source_id] == model.name && data["account_id"] == @source_account_id
+        raise InvalidArchive, "Record belongs to another account"
+      end
+      attributes = data.slice(*model.column_names)
+      attributes["id"] = @ids.fetch(source_id)
+      attributes["account_id"] = @account.id
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        key = association.foreign_key.to_s
+        next if key.in?(%w[account_id identity_id]) || attributes[key].nil?
+        type = association.polymorphic? ? attributes[association.foreign_type] : association.klass.name
+        unless @types[attributes[key]] == type
+          raise InvalidArchive, "Missing or invalid #{model.name} #{association.name}"
+        end
+        attributes[key] = @ids.fetch(attributes[key])
+      end
+
+      attributes.each do |key, value|
+        attributes[key] = remap_nested_ids(value) if model.in?([ Event, Filter ]) && (value.is_a?(Hash) || value.is_a?(Array))
+      end
+
+      if model == User
+
+        attributes["identity_id"] = identity_for(data)&.id
+        attributes["role"] = "admin" if attributes["role"] == "owner"
+      elsif model == ActiveStorage::Blob
+        return import_blob(data, attributes)
+      elsif model == Notification::Bundle
+        attributes["status"] = "delivered"
+      elsif model == Board::Publication
+        attributes["key"] = SecureRandom.urlsafe_base64(24)
+      elsif model == Webhook
+        attributes["active"] = false # Never dispatch imported webhook deliveries.
+      end
+      # Bulk insertion deliberately avoids notifications, broadcasts, and other callbacks.
+      model.insert_all!([ attributes ])
+    end
+
+    def remap_nested_ids(value, reference: false)
+      case value
+      when Hash
+        value.to_h { |key, nested| [ key, remap_nested_ids(nested, reference: key.end_with?("_id", "_ids")) ] }
+      when Array
+        value.map { |nested| remap_nested_ids(nested, reference: reference) }
+      when String
+        if reference
+          @ids.fetch(value) { raise InvalidArchive, "Missing reference in account data" }
+        else
+          value
+        end
+      else
+        value
+      end
+    end
+
+    def import_filter_resources
+      @zip.glob("filters/*.json").each do |path|
+        data = @zip.json(path)
+        filter = Filter.find(@ids.fetch(data.fetch("id")))
+        data.fetch("resources", {}).each do |name, ids|
+          association = Filter.reflect_on_association(name)
+          unless association && association.macro == :has_and_belongs_to_many
+            raise InvalidArchive, "Invalid filter resource"
+          end
+          mapped = ids.map do |id|
+            raise InvalidArchive, "Invalid filter reference" unless @types[id] == association.klass.name
+            @ids.fetch(id)
+          end
+          filter.public_send("#{name.to_s.singularize}_ids=", mapped)
+        end
+        filter.update_columns(params_digest: Filter.digest_params(filter.as_params))
+      end
+    end
+
+    def rebuild_storage
+      @account.boards.find_each do |board|
+        board.reconcile_storage
+        board.materialize_storage
+      end
+      @account.materialize_storage
+    end
+
+    def identity_for(data)
+      if data["email_address"].present? && data["role"] != "system"
+        Identity.find_or_create_by!(email_address: data["email_address"])
+      end
+    end
+
+    def import_blob(data, attributes)
+      blob = ActiveStorage::Blob.new(attributes.except("key", "service_name"))
+      blob.service_name = ActiveStorage::Blob.service.name
+      blob.key = ActiveStorage::Blob.generate_unique_secure_token
+      blob.save!
+      @uploaded_blobs << blob
+      path = "files/#{data.fetch('id')}"
+      raise InvalidArchive, "Attachment size mismatch" unless @zip.size(path) == blob.byte_size
+      if defined?(ActiveStorage::Service::S3Service) && blob.service.is_a?(ActiveStorage::Service::S3Service)
+        blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes) do |stream|
+          @zip.copy(path, stream, limit: blob.byte_size, checksum: blob.checksum)
+        end
+      else
+        Tempfile.create("fizzy-import", binmode: true) do |file|
+          @zip.copy(path, file, limit: blob.byte_size, checksum: blob.checksum)
+          file.rewind
+          blob.service.upload(blob.key, file, checksum: blob.checksum, content_type: blob.content_type)
+        end
+      end
+    end
+
+    def ensure_owner
+      raise InvalidArchive, "The account must contain one system user" unless @account.users.where(role: :system).count == 1
+      owner = @account.users.find_by(identity: @identity) || @account.users.create!(identity: @identity, name: @identity.email_address)
+      owner.update!(role: :owner, active: true, verified_at: Time.current)
+      @account.boards.find_each do |board|
+        Access.find_or_create_by!(account: @account, board: board, user: owner)
+      end
+    end
+
+    def rewrite_rich_text
+      ActionText::RichText.where(account: @account).find_each do |text|
+        fragment = Nokogiri::HTML5.fragment(text.body&.to_html.to_s)
+        fragment.css("action-text-attachment").each do |node|
+          if node["sgid"].present?
+            match = /\Afizzy:(ActiveStorage::Blob|User):([a-z0-9]+)\z/.match(node["sgid"])
+            unless match && @types[match[2]] == match[1]
+              raise InvalidArchive, "Invalid rich text attachment"
+            end
+            klass = match[1] == "User" ? User : ActiveStorage::Blob
+            attachable = klass.find(@ids.fetch(match[2]))
+            node["sgid"] = attachable.attachable_sgid
+            node.remove_attribute("url")
+          end
+        end
+        # Skip ActionText callbacks: the archive already contains embed attachments.
+        text.update_columns(body: fragment.to_html)
+      end
+    end
+end
