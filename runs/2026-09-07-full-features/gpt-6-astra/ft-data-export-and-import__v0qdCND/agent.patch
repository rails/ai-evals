+    assert_no_difference "Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+    logout_and_sign_in_as :jason
+    assert_enqueued_with(job: ExportJob) { post account_exports_path }
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.kind
+  end
+
+  test "members can request only their own card exports" do
+    sign_in_as :david
+    assert_enqueued_with(job: ExportJob) { post user_exports_path(users(:david)) }
+    assert_equal users(:david), Export.last.user
+    assert_no_difference "Export.count" do
+      post user_exports_path(users(:jason))
+      assert_response :forbidden
+    end
+  end
+
+  test "import requires a signed in identity but not an account" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+    end
+    sign_in_as :david
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      post account_imports_path
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "an identity with no account can upload an import" do
