@@ -0,0 +1,52 @@
+require "test_helper"
+require "active_storage/service/s3_service"
+
+class ZipFileS3Test < ActiveSupport::TestCase
+  test "S3 imports stream attachments with regenerated storage keys" do
+    Current.account = accounts(:"37s")
+    card = Current.account.cards.first
+    card.image.attach(io: StringIO.new("picture bytes"), filename: "picture.png", content_type: "image/png")
+    export = Export.create!(account: Current.account, user: users(:jason), kind: "account")
+    export.build
+    original_service = ActiveStorage::Blob.service
+    export.archive.open do |file|
+      service = ActiveStorage::Service::S3Service.new(bucket: "test", region: "us-east-1", access_key_id: "test", secret_access_key: "test", stub_responses: true)
+      service.name = "transfer_s3"
+      ActiveStorage::Blob.service = service
+      ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(service)
+      stream = StringIO.new
+      service.expects(:upload_stream).with(has_entries(content_type: "image/png", part_size: 100.megabytes)).yields(stream)
+      imported = Account::DataTransfer::Importer.new(ZipFile::Reader.new(file), identities(:david)).import
+      assert_equal "picture bytes", stream.string
+      copy = imported.cards.find_by!(number: card.number).image.blob
+      assert_equal "transfer_s3", copy.service_name
+      assert_not_equal card.image.blob.key, copy.key
+    end
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+
+  test "S3 export streams its ZIP and records a usable checksum" do
+    Current.account = accounts(:"37s")
+    service = ActiveStorage::Service::S3Service.new(bucket: "test", region: "us-east-1", access_key_id: "test", secret_access_key: "test", stub_responses: true)
+    service.name = "transfer_s3"
+    original_service = ActiveStorage::Blob.service
+    ActiveStorage::Blob.service = service
+    ActiveStorage::Blob.services.stubs(:fetch).with("transfer_s3").returns(service)
+    stream = StringIO.new
+    service.expects(:upload_stream).with(has_entries(content_type: "application/zip", part_size: 100.megabytes)).yields(stream)
+    export = Export.create!(account: Current.account, user: users(:jason), kind: "account")
+
+    export.build
+
+    assert_equal stream.size, export.archive.blob.byte_size
+    assert_equal Digest::MD5.base64digest(stream.string), export.archive.blob.checksum
+    assert_equal "transfer_s3", export.archive.blob.service_name
+    reader = ZipFile::Reader.new(stream)
+    assert_equal "account", reader.json("manifest.json")["kind"]
+    assert_not_includes reader.glob("active_storage_blobs/*.json"), "active_storage_blobs/#{export.archive.blob.id}.json"
+    assert_not_includes reader.glob("files/*"), "files/#{export.archive.blob.id}"
+  ensure
+    ActiveStorage::Blob.service = original_service
+  end
+end
