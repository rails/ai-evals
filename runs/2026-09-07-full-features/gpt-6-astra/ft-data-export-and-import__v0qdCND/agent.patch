+class Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  def show
+    export = Export.find_signed(params[:export_id], purpose: :download)
+    if export && export.user.active? && (export.kind != "account" || export.user.admin?) && export.account.active? && !export.expired?
+      ActiveStorage::Current.url_options = { protocol: request.protocol, host: request.host, port: request.port }
+      response.headers["Cache-Control"] = "private, no-store"
+      redirect_to export.archive.url(expires_in: [ export.completed_at + 1.day - Time.current, 5.minutes ].min,
+        disposition: :attachment), allow_other_host: true
+    else
+      head :not_found
+    end
+  end
+end
