@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  test "the import job creates an account and emails its identity" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "account")
+    export.build
+    export.archive.open do |file|
+      upload = ActionDispatch::Http::UploadedFile.new(tempfile: file, filename: "account.zip")
+      import = Account::Import.receive(identity: identities(:david), upload: upload)
+      Current.reset
+      assert_difference "Account.count", 1 do
+        assert_difference "ActionMailer::Base.deliveries.size", 1 do
+          Account::ImportJob.perform_now(import)
+        end
+      end
+      assert_equal "completed", import.reload.status
+      assert_equal [ identities(:david).email_address ], ActionMailer::Base.deliveries.last.to
+      assert_match "Your Fizzy import is complete", ActionMailer::Base.deliveries.last.subject
+      assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+      assert_no_difference "Account.count" do
+        import.process
+      end
+    end
+  end
+
+  test "a late failure rolls back the account and emails a reason" do
+    export = Export.create!(account: accounts(:"37s"), user: users(:jason), kind: "account")
+    export.build
+    export.archive.open do |file|
+      upload = ActionDispatch::Http::UploadedFile.new(tempfile: file, filename: "account.zip")
+      import = Account::Import.receive(identity: identities(:david), upload: upload)
+      Account::DataTransfer::Importer.any_instance.stubs(:ensure_owner).raises(Account::DataTransfer::Importer::InvalidArchive, "Missing owner")
+      assert_no_difference [ "Account.count", "User.count", "Card.count" ] do
+        assert_difference "ActionMailer::Base.deliveries.size", 1 do
+          Account::ImportJob.perform_now(import)
+        end
+      end
+      assert_equal "failed", import.reload.status
+      assert_nil import.account
+      assert_equal "Missing owner", import.error
+      assert_match "Missing owner", ActionMailer::Base.deliveries.last.text_part.body.decoded
+      assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+    end
+  end
+
+  test "invalid ZIP input is reported as a failure" do
+    Tempfile.create("invalid-zip") do |file|
+      file.write("not a ZIP file")
+      file.rewind
+      import = Account::Import.receive(identity: identities(:david), upload: ActionDispatch::Http::UploadedFile.new(tempfile: file, filename: "bad.zip"))
+      assert_no_difference "Account.count" do
+        import.process
+      end
+      assert_equal "failed", import.status
+      assert import.error.present?
+      assert_not ActiveStorage::Blob.service.exist?(import.storage_key)
+    end
+  end
+end
diff --git a/test/models/zip_file_reader_test.rb b/test/models/zip_file_reader_test.rb
new file mode 100644
index 0000000..78cc633
--- /dev/null
+++ b/test/models/zip_file_reader_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  test "writer computes the actual archive size and checksum" do
+    with_archive do |io, writer|
+      assert_equal io.size, writer.byte_size
+      assert_equal Digest::MD5.base64digest(io.string), writer.checksum
+      reader = ZipFile::Reader.new(io)
+      assert_equal({ "hello" => "world" }, reader.json("data.json"))
+    end
+  end
+
+  test "reading storage uses ranges rather than downloading the archive" do
+    with_archive do |io, writer|
+      service = Object.new
+      service.define_singleton_method(:download_chunk) { |key, range| io.string.b.byteslice(range) }
+      reader = ZipFile::Reader.new(ZipFile::StorageIO.new(service, "zip", io.size))
+      assert_equal({ "hello" => "world" }, reader.json("data.json"))
+    end
+  end
+
+  test "small sequential reads share a storage range request" do
+    content = "x" * 1.megabyte
+    service = mock
+    service.expects(:download_chunk).with("zip", 0...content.bytesize).returns(content).once
+    io = ZipFile::StorageIO.new(service, "zip", content.bytesize)
+    10.times { assert_equal "x" * 16.kilobytes, io.read(16.kilobytes) }
+  end
+
+  test "damaged entries fail checksum verification" do
+    with_archive do |io, writer|
+      position = io.string.index("original bytes")
+      io.string[position] = "X"
+      reader = ZipFile::Reader.new(io)
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader.copy("file.bin", StringIO.new) }
+    end
+  end
+
+  test "unsafe paths are rejected without extraction" do
+    io = StringIO.new
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("../outside", "payload")
+    writer.close
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(io) }
+  end
+
+  test "oversized JSON is rejected before decompression" do
+    with_archive do |io, writer|
+      reader = ZipFile::Reader.new(io)
+      reader.instance_variable_get(:@entries).fetch("data.json").uncompressed_size = ZipFile::Reader::JSON_LIMIT + 1
+      assert_raises(ZipFile::Reader::InvalidArchive) { reader.json("data.json") }
+    end
+  end
+
+  test "out of bounds or excessive storage reads are rejected" do
+    io = ZipFile::StorageIO.new(mock, "zip", 600.gigabytes)
+    assert_raises(ZipFile::Reader::InvalidArchive) { io.seek(-1) }
+    assert_raises(ZipFile::Reader::InvalidArchive) { io.read }
+  end
+
+  private
+    def with_archive
+      io = StringIO.new
+      writer = ZipFile::Writer.new(io)
+      writer.add_file("data.json", { hello: "world" }.to_json)
+      writer.add_file("file.bin", "original bytes", compress: false)
+      writer.close
+      yield io, writer
+    end
+end
