diff --git a/app/models/account/data_transfer/rich_text.rb b/app/models/account/data_transfer/rich_text.rb
new file mode 100644
index 0000000..2b78822
--- /dev/null
+++ b/app/models/account/data_transfer/rich_text.rb
@@ -0,0 +1,15 @@
+class Account::DataTransfer::RichText
+  def self.export(record)
+    if record&.body
+      fragment = Nokogiri::HTML5.fragment(record.body.to_html)
+      fragment.css("action-text-attachment").each do |node|
+        attachable = ActionText::Attachable.from_node(node)
+        if attachable.is_a?(ActiveStorage::Blob) || attachable.is_a?(User)
+          node["sgid"] = "fizzy:#{attachable.class.name}:#{attachable.id}"
+          node.remove_attribute("url")
+        end
+      end
+      fragment.to_html
+    end
+  end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..cf5c7ef
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,51 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  def self.receive(identity:, upload:)
+    key = "imports/#{SecureRandom.base58(32)}"
+    service = ActiveStorage::Blob.service
+    service.upload(key, upload.tempfile)
+    create!(identity: identity, storage_key: key, service_name: service.name, byte_size: upload.size)
+  rescue Exception
+    service&.delete(key) if key
+    raise
+  end
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process
+    with_lock do
+      if status == "pending"
+        begin
+          reader = ZipFile::Reader.new(ZipFile::StorageIO.new(service, storage_key, byte_size))
+          Account::DataTransfer::Importer.new(reader, identity).import do |account|
+            update!(account: account, status: "completed")
+          end
+        rescue StandardError => exception
+          Rails.logger.error("Import #{id} failed: #{exception.class}: #{exception.message}")
+          update!(status: "failed", error: failure_reason(exception))
+        end
+      end
+    end
+    service.delete(storage_key)
+  end
+
+  private
+    def service
+      ActiveStorage::Blob.services.fetch(service_name)
+    end
+
+    def failure_reason(exception)
+      case exception
+      when Account::DataTransfer::Importer::InvalidArchive, ZipFile::Reader::InvalidArchive
+        exception.message.truncate(500)
+      when ActiveRecord::RecordInvalid
+        "Invalid account data: #{exception.record.errors.full_messages.to_sentence}".truncate(500)
+      else
+        "The archive is incomplete, damaged, or contains invalid records. Please export the account again and retry."
+      end
+    end
+end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..0dee23f
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,66 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  validates :kind, inclusion: { in: %w[account cards] }
+
+  def self.cleanup
+    where(completed_at: ...1.day.ago).find_each do |export|
+      export.archive.purge
+      export.destroy!
+    end
+  end
+
+  def build_later
+    ExportJob.perform_later(self)
+  end
+
+  def build
+    generated_blob = nil
+    with_lock do
+      unless completed_at
+        raise ActiveRecord::RecordNotFound unless user.active? && user.account == account
+        raise ActiveRecord::RecordNotFound if kind == "account" && !user.admin?
+
+        Current.with(account: account, user: user) do
+          ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+            if kind == "account"
+              Account::DataTransfer::Manifest.new(account).each_record_set { |set| set.export(zip) }
+            else
+              export_cards(zip)
+            end
+            zip.add_file("manifest.json", { format: "fizzy", version: 1, kind: kind, entries: zip.glob("*").group_by { |path| File.dirname(path) }.transform_values(&:size) }.to_json)
+          end
+          generated_blob = archive.blob
+          update!(completed_at: Time.current)
+        end
+      end
+    end
+  rescue Exception
+    generated_blob&.purge
+    raise
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: completed_at + 1.day)
+  end
+
+  def expired?
+    !completed_at || completed_at <= 1.day.ago
+  end
+
+  private
+    def export_cards(zip)
+      user.accessible_cards.where(account: account).find_each do |card|
+        comments = card.comments.chronologically
+        zip.add_file("cards/#{card.id}.json", card.as_json.merge(Account::DataTransfer::CardData.for(card)).to_json)
+        blobs = [ card.image.blob, *card.attachments.map(&:blob), *comments.flat_map { |comment| comment.attachments.map(&:blob) } ].compact
+        blobs.uniq(&:id).each do |blob|
+          next if zip.exists?("files/#{blob.id}")
+          zip.add_file("files/#{blob.id}.json", blob.as_json(only: %w[id filename content_type byte_size]).to_json)
+          zip.add_file("files/#{blob.id}", compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+        end
+      end
+    end
+end
