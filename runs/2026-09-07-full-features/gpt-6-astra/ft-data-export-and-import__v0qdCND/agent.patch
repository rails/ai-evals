+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @download_url = export_download_url(export.download_token, script_name: nil)
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def import_finished(import)
+    @import = import
+    mail to: import.identity.email_address,
+      subject: import.status == "completed" ? "Your Fizzy import is complete" : "Your Fizzy import failed"
+  end
+end
