diff --git a/app/jobs/storage/backfill_job.rb b/app/jobs/storage/backfill_job.rb
new file mode 100644
index 0000000..7fb64b4
--- /dev/null
+++ b/app/jobs/storage/backfill_job.rb
@@ -0,0 +1,14 @@
+class Storage::BackfillJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  limits_concurrency to: 1, key: ->(account, **) { account.id }
+
+  def perform(account, force: false)
+    unless account.importing?
+      total = Storage::Total.for_account(account.id)
+      if force || !total.backfilled_at?
+        total.backfill_now
+        Storage::ReconcileJob.perform_later(account.id)
+      end
+    end
+  end
+end
diff --git a/app/jobs/storage/reconcile_job.rb b/app/jobs/storage/reconcile_job.rb
new file mode 100644
index 0000000..19eb9a2
--- /dev/null
+++ b/app/jobs/storage/reconcile_job.rb
@@ -0,0 +1,11 @@
+class Storage::ReconcileJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound
+  retry_on ActiveRecord::Deadlocked, ActiveRecord::LockWaitTimeout
+
+  def perform(account_id)
+    if Account.exists?(account_id)
+      Storage::Total.for_account(account_id).reconcile_now
+      self.class.perform_later(account_id) if Storage::Change.where(account_id: account_id).exists?
+    end
+  end
+end
