@@ -0,0 +1,13 @@
+module Storage::DetachmentTracking
+  # has_many_attached#detach uses delete_all, bypassing attachment callbacks.
+  def detach
+    if record.is_a?(ActionText::RichText) && name.to_s == "embeds"
+      record.transaction do
+        record.record_storage_change
+        super
+      end
+    else
+      super
+    end
+  end
+end
