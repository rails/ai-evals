diff --git a/test/controllers/sessions/email_codes_controller_test.rb b/test/controllers/sessions/email_codes_controller_test.rb
new file mode 100644
index 0000000..f247548
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,319 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in by emailed code" do
+    untenanted do
+      assert_enqueued_emails 1 do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_select "input[name=code][maxlength='6']"
+
+      perform_enqueued_jobs
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      assert code
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+  test "invalid code can be retried" do
+    untenanted do
+      code = request_sign_in_code
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "WRONG!" }
+      end
+      assert_redirected_to new_session_email_code_path
+
+      post session_email_code_path, params: { code: " #{code.downcase} " }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "expired code does not sign in" do
+    untenanted do
+      code = request_sign_in_code
+      travel 15.minutes, with_usec: true do
+        assert_no_difference -> { Session.count } do
+          post session_email_code_path, params: { code: code }
+        end
+        assert_redirected_to new_session_email_code_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "used code cannot sign in again" do
+    untenanted do
+      code = request_sign_in_code
+      post session_email_code_path, params: { code: code }
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "code requires the requesting browser" do
+    untenanted do
+      code = request_sign_in_code
+      open_session do |other_browser|
+        assert_no_difference -> { Session.count } do
+          other_browser.post session_email_code_path, params: { code: code }
+        end
+        other_browser.assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "requesting another code replaces the pending code" do
+    untenanted do
+      old_code = request_sign_in_code
+      old_record = EmailCode.last
+      code = request_sign_in_code
+      assert_not EmailCode.exists?(old_record.id)
+
+      post session_email_code_path, params: { code: old_code }
+      assert_redirected_to new_session_email_code_path
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "missing pending request starts over" do
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_path
+
+      post session_email_code_path, params: { code: "ABC123" }, as: :json
+      assert_response :unauthorized
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      code = request_sign_in_code
+      Rails.cache.stubs(:increment).returns(11)
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :too_many_requests
+    end
+  end
+
+  test "JSON sign in returns a session token" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }, as: :json
+      end
+      assert_response :created
+      code = delivered_code
+
+      post session_email_code_path, params: { code: "WRONG!" }, as: :json
+      assert_response :unauthorized
+      post session_email_code_path, params: { code: code }, as: :json
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "sign up verifies the email before completing an account" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: " New-Person@example.com " } }
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_not cookies[:session_token].present?
+
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_url
+      assert cookies[:session_token].present?
+      assert_equal "new-person@example.com", Session.last.identity.email_address
+
+      Signup.any_instance.stubs(:skip_account_seeding).returns(true)
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      assert_redirected_to landing_url(script_name: Account.last.slug)
+    end
+  end
+
+  test "sign up with an existing email uses the existing identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: identities(:kevin).email_address } }
+        end
+      end
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_url
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "join verifies a new identity and redeems the invitation" do
+    join_code = account_join_codes(:"37s")
+    assert_difference -> { Identity.count }, 1 do
+      assert_no_difference -> { User.count } do
+        request_join_code(join_code, "new-member@example.com")
+      end
+    end
+    assert_not cookies[:session_token].present?
+
+    untenanted do
+      assert_redirected_to new_session_email_code_url
+      assert_difference -> { User.count }, 1 do
+        assert_difference -> { join_code.reload.usage_count }, 1 do
+          post session_email_code_path, params: { code: delivered_code }
+        end
+      end
+      assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+      user = Session.last.identity.users.find_by!(account: join_code.account)
+      follow_redirect!
+      assert_response :success
+      post users_verifications_path(script_name: join_code.account.slug)
+      assert_redirected_to new_users_join_path(script_name: join_code.account.slug)
+      post users_joins_path(script_name: join_code.account.slug), params: { user: { name: "New Member" } }
+      assert_redirected_to landing_path(script_name: join_code.account.slug)
+      assert user.reload.verified?
+      assert user.setup?
+    end
+  end
+
+  test "join an existing member without creating another user or using the invitation" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:jz).email_address)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { join_code.reload.usage_count } do
+          post session_email_code_path, params: { code: delivered_code }
+        end
+      end
+      assert_redirected_to landing_url(script_name: join_code.account.slug)
+    end
+  end
+
+  test "JSON join redeems the invitation" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:mike).email_address)
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: delivered_code }, as: :json
+      end
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "exhausted invitation cannot be redeemed after requesting an email code" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:mike).email_address)
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to session_menu_url
+    end
+  end
+
+  test "reset invitation cannot be redeemed after requesting an email code" do
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:mike).email_address)
+    join_code.reset
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: delivered_code }
+      end
+      assert_redirected_to session_menu_url
+    end
+  end
+
+  test "sign in returns to the originally requested account page" do
+    get board_path(boards(:writebook))
+
+    untenanted do
+      assert_redirected_to new_session_url
+      code = request_sign_in_code
+      post session_email_code_path, params: { code: code }
+    end
+    assert_redirected_to board_url(boards(:writebook))
+  end
+
+  test "invalid email does not send a code" do
+    untenanted do
+      assert_no_enqueued_emails do
+        post session_path, params: { email_address: "invalid-email" }
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "unknown email does not create an identity or send a code" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_enqueued_emails do
+          post session_path, params: { email_address: "unknown@example.com" }
+        end
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "missing code does not sign in" do
+    untenanted do
+      request_sign_in_code
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path
+      end
+      assert_response :bad_request
+    end
+  end
+
+  test "join can verify a different email than the currently signed in identity" do
+    sign_in_as :kevin
+    join_code = account_join_codes(:"37s")
+    request_join_code(join_code, identities(:mike).email_address)
+
+    untenanted do
+      follow_redirect!
+      assert_response :success
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+      assert_equal identities(:mike), Session.last.identity
+    end
+  end
+
+  private
+
+    def request_sign_in_code
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: " #{identities(:kevin).email_address.upcase} " }
+      end
+      delivered_code
+    end
+
+    def request_join_code(join_code, email_address)
+      perform_enqueued_jobs do
+        post join_path(code: join_code.code, script_name: join_code.account.slug), params: { email_address: email_address }
+      end
+    end
+
+    def delivered_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+    end
+end
