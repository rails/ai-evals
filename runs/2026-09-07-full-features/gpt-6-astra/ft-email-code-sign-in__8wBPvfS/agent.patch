diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..4c91ba7
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,41 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION_TIME = 15.minutes
+  CODE_LENGTH = 6
+  MAX_ATTEMPTS = 10
+
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  attr_reader :code
+
+  validates :purpose, inclusion: { in: %w[ sign_in sign_up join ] }
+
+  before_create :generate_code
+
+  def consume(code)
+    return false if destroyed?
+
+    with_lock do
+      if expires_at.future? && attempts < MAX_ATTEMPTS
+        if ActiveSupport::SecurityUtils.secure_compare(code_digest, Digest::SHA256.hexdigest(code.to_s.strip.upcase))
+          destroy!
+          true
+        else
+          increment!(:attempts)
+          false
+        end
+      else
+        false
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  private
+    def generate_code
+      @code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      self.code_digest = Digest::SHA256.hexdigest(@code)
+      self.expires_at = EXPIRATION_TIME.from_now
+    end
+end
