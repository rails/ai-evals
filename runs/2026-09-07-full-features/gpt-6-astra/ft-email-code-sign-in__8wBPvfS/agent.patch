@@ -0,0 +1,84 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+  before_action :set_email_code
+
+  layout "public"
+  helper_method :new_email_code_request_path
+
+  def new
+  end
+
+  def create
+    if @email_code.consume(params.expect(:code))
+      session.delete(:email_code_id)
+      start_new_session_for @email_code.identity
+      destination = completion_url
+
+      respond_to do |format|
+        format.html { redirect_to destination }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "That code didn’t work. Please try again or request a new code." }
+        format.json { render json: { message: "That code didn’t work." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:email_code_id])
+
+      unless @email_code
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Please request a new sign-in code." }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def new_email_code_request_path
+      case @email_code.purpose
+      when "sign_up"
+        new_signup_path
+      when "join"
+        join_path(code: @email_code.join_code, script_name: @email_code.account.slug)
+      else
+        new_session_path
+      end
+    end
+
+    def completion_url
+      case @email_code.purpose
+      when "sign_up"
+        new_signup_completion_url
+      when "join"
+        join_account_url
+      else
+        after_authentication_url
+      end
+    end
+
+    def join_account_url
+      join_code = Account::JoinCode.find_by(account: @email_code.account, code: @email_code.join_code)
+
+      if join_code
+        join_code.redeem_if { |account| Current.identity.join(account) }
+        user = User.active.find_by(account: join_code.account, identity: Current.identity)
+      end
+
+      if user
+        if user.setup?
+          landing_url(script_name: join_code.account.slug)
+        else
+          new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        flash[:alert] = "That join code is no longer available. Please ask for a new invitation."
+        session_menu_url
+      end
+    end
+end
