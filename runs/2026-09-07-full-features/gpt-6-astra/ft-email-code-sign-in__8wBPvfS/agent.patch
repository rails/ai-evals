--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @email_code = identities(:kevin).email_codes.create!
+    @code = @email_code.code
+  end
+
+  test "generates six-character codes and stores only a digest" do
+    assert_match /\A[A-Z0-9]{6}\z/, @code
+    assert_equal Digest::SHA256.hexdigest(@code), @email_code.code_digest
+    assert_in_delta 15.minutes.from_now, @email_code.expires_at, 1.second
+  end
+
+  test "accepts a code once, ignoring surrounding whitespace and case" do
+    assert @email_code.consume(" #{@code.downcase} ")
+    assert_not EmailCode.exists?(@email_code.id)
+    assert_not @email_code.consume(@code)
+  end
+
+  test "a code works just before fifteen minutes but not at expiry" do
+    travel_to @email_code.expires_at - 1.second do
+      assert @email_code.consume(@code)
+    end
+
+    email_code = identities(:kevin).email_codes.create!
+    travel_to email_code.expires_at, with_usec: true do
+      assert_not email_code.consume(email_code.code)
+    end
+  end
+
+  test "invalid and missing codes do not consume the code" do
+    [ "wrong", "", nil ].each do |code|
+      assert_not @email_code.consume(code)
+    end
+
+    assert_equal 3, @email_code.reload.attempts
+    assert @email_code.consume(@code)
+  end
+
+  test "ten incorrect guesses exhaust a code" do
+    EmailCode::MAX_ATTEMPTS.times do
+      assert_not @email_code.consume("wrong")
+    end
+
+    assert_not @email_code.consume(@code)
+  end
+
+  test "a code cannot authenticate a different pending request" do
+    other_code = identities(:david).email_codes.create!
+    assert_not other_code.consume(@code)
+    assert @email_code.consume(@code)
+  end
+end
