+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,15 @@
+module EmailCodeAuthentication
+  private
+
+  def send_email_code(identity, **attributes)
+    EmailCode.find_by(id: session.delete(:email_code_id))&.destroy!
+    email_code = identity.email_codes.create!(**attributes)
+    session[:email_code_id] = email_code.id
+    IdentityMailer.sign_in_code(identity, code: email_code.code).deliver_later
+
+    respond_to do |format|
+      format.html { redirect_to new_session_email_code_url(script_name: nil) }
+      format.json { head :created }
+    end
+  end
+end
