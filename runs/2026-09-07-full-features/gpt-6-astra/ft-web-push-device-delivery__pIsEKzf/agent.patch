@@ -0,0 +1,10 @@
+class PushSubscription::DeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, Net::OpenTimeout, Net::ReadTimeout, wait: :polynomially_longer
+
+  def perform(subscription, payload)
+    if PushSubscription.configured? && subscription.user.active? && subscription.account.active?
+      subscription.deliver(payload)
+    end
+  end
+end
