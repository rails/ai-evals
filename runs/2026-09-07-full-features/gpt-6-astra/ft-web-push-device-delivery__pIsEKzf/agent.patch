+require "test_helper"
+
+class PushSubscription::DeliveryJobTest < ActiveJob::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "key", auth_key: "auth")
+  end
+
+  test "temporary errors retry without dropping the device" do
+    PushSubscription.any_instance.expects(:deliver).raises(Net::ReadTimeout)
+
+    assert_enqueued_with job: PushSubscription::DeliveryJob do
+      PushSubscription::DeliveryJob.perform_now(@subscription, "payload")
+    end
+    assert @subscription.reload
+  end
+
+  test "removed devices are discarded before delivery" do
+    PushSubscription::DeliveryJob.perform_later(@subscription, "payload")
+    @subscription.destroy!
+    PushSubscription.any_instance.expects(:deliver).never
+
+    assert_nothing_raised { perform_enqueued_jobs }
+  end
+end
