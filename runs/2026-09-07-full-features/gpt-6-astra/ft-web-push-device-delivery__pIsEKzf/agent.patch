+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+  end
+
+  test "new tray entries enqueue push delivery" do
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: users(:kevin), creator: users(:david), source: events(:layout_commented))
+    end
+  end
+
+  test "new sources on existing tray entries enqueue pushes but reading does not" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.update!(source: mentions(:logo_comment_david_mention_by_jz))
+    end
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "unconfigured servers do not enqueue pushes" do
+    PushSubscription.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).push_later
+    end
+  end
+
+  test "pushes fan out only to the recipient's devices" do
+    notification = notifications(:logo_assignment_kevin)
+    subscriptions = 2.times.map do |device|
+      notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/#{device}", p256dh_key: "key", auth_key: "auth")
+    end
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/other", p256dh_key: "key", auth_key: "auth")
+
+    assert_enqueued_jobs 2, only: PushSubscription::DeliveryJob do
+      notification.push_now
+    end
+    subscriptions.each do |subscription|
+      assert_enqueued_with job: PushSubscription::DeliveryJob, args: [ subscription, notification.push_payload ]
+    end
+  end
+
+  test "event payload uses tray text and an account scoped destination" do
+    notification = notifications(:layout_commented_kevin)
+    payload = JSON.parse(notification.push_payload)
+    helpers = ApplicationController.helpers
+
+    assert_equal helpers.event_notification_title(notification.source), payload["title"]
+    assert_equal helpers.event_notification_body(notification.source), payload["body"]
+    assert_equal "notification_#{notification.id}", payload["tag"]
+    assert_equal Rails.application.routes.url_helpers.polymorphic_path(notification.notifiable_target, script_name: notification.account.slug, only_path: true), payload.dig("data", "url")
+  end
+
+  test "mention payload uses the tray's mention text" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert_equal mention.source.mentionable_content.truncate(200), payload["body"]
+    assert_includes payload.dig("data", "url"), "#{notification.account.slug}/cards/#{notification.card.number}"
+  end
+
+  test "inactive recipients do not get pushes" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.update!(active: false)
+
+    assert_no_enqueued_jobs only: PushSubscription::DeliveryJob do
+      notification.push_now
+    end
+  end
+end
