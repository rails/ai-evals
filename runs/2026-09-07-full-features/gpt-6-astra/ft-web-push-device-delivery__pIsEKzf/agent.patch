--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,25 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { previously_new_record? || source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if PushSubscription.configured?
+  end
+
+  def push_now
+    if PushSubscription.configured? && user.active? && account.active?
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        PushSubscription::DeliveryJob.perform_later(subscription, payload)
+      end
+    end
+  end
+
+  def push_payload
+    ApplicationController.render \
+      template: "notifications/push", formats: [ :json ], locals: { notification: self }
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..ea85324
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,36 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :digest_endpoint
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :validate_endpoint
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def deliver(payload)
+    Request.new(
+      subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } }, message: payload,
+      vapid: { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY") },
+    ).perform
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def digest_endpoint
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def validate_endpoint
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil?
+        errors.add :endpoint, "must be an HTTPS URL"
+      end
+    rescue URI::InvalidURIError
+      errors.add :endpoint, "must be an HTTPS URL"
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..3d2d464
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,22 @@
+class PushSubscription::Request < WebPush::Request
+  class InvalidEndpoint < StandardError; end
+
+  def perform
+    address = SsrfProtection.resolve_public_ip(uri.host)
+    raise InvalidEndpoint, "Push endpoint must resolve to a public address" unless address
+
+    # Pin the checked address to prevent DNS rebinding, preserving TLS verification
+    # against the original hostname. Push services must not redirect requests.
+    http = Net::HTTP.new(uri.host, uri.port, nil)
+    http.ipaddr = address
+    http.use_ssl = true
+    http.open_timeout = 5
+    http.read_timeout = 5
+
+    request = Net::HTTP::Post.new(uri.request_uri, headers)
+    request.body = body
+    response = http.request(request)
+    verify_response(response)
+    response
+  end
+end
