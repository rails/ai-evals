+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    vapid = WebPush.generate_key
+    @request = PushSubscription::Request.new(
+      message: "", subscription: { endpoint: "https://push.example.com/device" },
+      vapid: { public_key: vapid.public_key, private_key: vapid.private_key }
+    )
+  end
+
+  test "pins the public address while preserving TLS hostname verification" do
+    SsrfProtection.expects(:resolve_public_ip).with("push.example.com").returns("8.8.4.4")
+    http = mock("http")
+    Net::HTTP.expects(:new).with("push.example.com", 443, nil).returns(http)
+    http.expects(:ipaddr=).with("8.8.4.4")
+    http.expects(:use_ssl=).with(true)
+    http.expects(:open_timeout=).with(5)
+    http.expects(:read_timeout=).with(5)
+    http.expects(:request).with do |request|
+      request.path == "/device" && request["Authorization"].start_with?("vapid ")
+    end.returns(Net::HTTPCreated.new("1.1", "201", "Created"))
+
+    @request.perform
+  end
+
+  test "private endpoints are never contacted" do
+    SsrfProtection.expects(:resolve_public_ip).returns(nil)
+    Net::HTTP.expects(:new).never
+
+    assert_raises(PushSubscription::Request::InvalidEndpoint) { @request.perform }
+  end
+
+  test "expired responses retain the gem's error handling" do
+    SsrfProtection.expects(:resolve_public_ip).returns("8.8.4.4")
+    response = Net::HTTPGone.new("1.1", "410", "Gone")
+    response.stubs(:body).returns("gone")
+    Net::HTTP.any_instance.stubs(:request).returns(response)
+
+    assert_raises(WebPush::ExpiredSubscription) { @request.perform }
+  end
+end
