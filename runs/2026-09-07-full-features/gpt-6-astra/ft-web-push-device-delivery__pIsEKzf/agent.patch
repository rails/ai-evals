--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,33 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def index
+    response.headers["Cache-Control"] = "no-store"
+    render json: @user.push_subscriptions.as_json(only: [ :id, :endpoint ])
+  end
+
+  def create
+    attributes = params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    subscription = @user.push_subscriptions.create_or_find_by!(endpoint: attributes[:endpoint]) do |subscription|
+      subscription.assign_attributes(attributes)
+    end
+    subscription.update!(attributes)
+
+    render json: { id: subscription.id }, status: :created
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b6c26f9
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,108 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "help", "details" ]
+  static values = { url: String, publicKey: String }
+
+  #registration
+  #subscriptionId
+
+  async connect() {
+    if (!this.publicKeyValue) {
+      this.statusTarget.textContent = "Push notifications aren’t configured on this server."
+    } else if (!this.#supported) {
+      this.statusTarget.textContent = "This browser doesn’t support push notifications."
+      this.helpTarget.hidden = false
+    } else {
+      try {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.#registration = await navigator.serviceWorker.ready
+        await this.#refresh()
+      } catch {
+        this.#showError()
+      }
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+
+    try {
+      if (this.#subscriptionId) {
+        // Keep the browser subscription: other accounts may still use this device.
+        await this.#request(`${this.urlValue}/${this.#subscriptionId}`, { method: "DELETE" })
+        this.#subscriptionId = null
+      } else {
+        // Request permission directly from the click, as required on Safari/iOS.
+        const permission = await Notification.requestPermission()
+        if (permission === "granted") {
+          const subscription = await this.#registration.pushManager.getSubscription() ||
+            await this.#registration.pushManager.subscribe({
+              userVisibleOnly: true,
+              applicationServerKey: this.#applicationServerKey
+            })
+          const { endpoint, keys } = subscription.toJSON()
+          const response = await this.#request(this.urlValue, {
+            method: "POST",
+            body: JSON.stringify({ push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } })
+          })
+          this.#subscriptionId = (await response.json()).id
+        }
+      }
+      this.#render()
+    } catch {
+      this.#showError()
+    } finally {
+      this.buttonTarget.disabled = !this.#subscriptionId && Notification.permission === "denied"
+    }
+  }
+
+  async #refresh() {
+    this.#subscriptionId = null
+    const subscription = await this.#registration.pushManager.getSubscription()
+    if (subscription) {
+      const response = await this.#request(this.urlValue)
+      const subscriptions = await response.json()
+      this.#subscriptionId = subscriptions.find(({ endpoint }) => endpoint === subscription.endpoint)?.id
+    }
+    this.#render()
+  }
+
+  #render() {
+    const enabled = !!this.#subscriptionId && Notification.permission === "granted"
+    const denied = Notification.permission === "denied"
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.textContent = this.#subscriptionId ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.setAttribute("aria-pressed", enabled.toString())
+    this.buttonTarget.disabled = denied && !this.#subscriptionId
+    this.statusTarget.textContent = denied ? "Notifications are blocked. Follow the instructions below to allow them." : ""
+    this.helpTarget.hidden = enabled
+  }
+
+  async #request(url, options = {}) {
+    const response = await fetch(url, {
+      ...options,
+      credentials: "same-origin",
+      cache: "no-store",
+      headers: { "Content-Type": "application/json", "Accept": "application/json", "X-CSRF-Token": getMetaContent("csrf-token") }
+    })
+    if (!response.ok) throw new Error("Could not save notification settings")
+    return response
+  }
+
+  #showError() {
+    this.buttonTarget.disabled = !this.#registration
+    this.statusTarget.textContent = "Couldn’t update notifications. Please try again."
+    this.helpTarget.hidden = false
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
