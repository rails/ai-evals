@@ -0,0 +1,169 @@
+#!/usr/bin/env ruby
+# Run with: bundle exec ruby script/test-push-notifications-browser
+# Uses Chromium with mocked browser push APIs; no external push service needed.
+require "bundler/setup"
+require "minitest/autorun"
+require "selenium-webdriver"
+
+class PushNotificationsBrowserTest < Minitest::Test
+  def setup
+    options = Selenium::WebDriver::Chrome::Options.new
+    options.add_argument("--headless")
+    options.add_argument("--no-sandbox")
+    options.add_argument("--disable-dev-shm-usage")
+    @browser = Selenium::WebDriver.for(:chrome, options: options)
+    @browser.navigate.to("about:blank")
+    controller = File.read(File.expand_path("../app/javascript/controllers/notifications_controller.js", __dir__))
+      .gsub(/^import .*\n/, "").sub("export default class", "window.NotificationsController = class")
+    @browser.execute_script(<<~JS + controller)
+      class Controller {}
+      function getMetaContent() { return "csrf-token" }
+      window.calls = []
+      window.permission = "default"
+      window.subscription = null
+      window.devices = []
+      window.failRequest = false
+      window.subscribeCount = 0
+      window.Notification = {
+        get permission() { return window.permission },
+        requestPermission: async () => window.permission = window.nextPermission || "granted"
+      }
+      window.PushManager = class {}
+      window.device = {
+        endpoint: "https://push.example.com/device",
+        toJSON: () => ({ endpoint: "https://push.example.com/device", keys: { p256dh: "public", auth: "auth" } })
+      }
+      window.registration = { pushManager: {
+        getSubscription: async () => window.subscription,
+        subscribe: async options => {
+          if (!options.userVisibleOnly || !(options.applicationServerKey instanceof Uint8Array)) throw new Error("Invalid subscription options")
+          window.subscribeCount++
+          return window.subscription = window.device
+        }
+      } }
+      Object.defineProperty(navigator, "serviceWorker", { configurable: true, value: {
+        register: async () => window.registration,
+        ready: Promise.resolve(window.registration)
+      } })
+      window.fetch = async (url, options) => {
+        window.calls.push({ url, ...options })
+        return { ok: !window.failRequest, json: async () => options.method === "POST" ? { id: "device-id" } : window.devices }
+      }
+    JS
+    @browser.execute_script(<<~JS)
+      window.controller = new NotificationsController()
+      controller.element = document.createElement("section")
+      controller.buttonTarget = document.createElement("button")
+      controller.statusTarget = document.createElement("p")
+      controller.helpTarget = document.createElement("div")
+      controller.urlValue = "/123/users/user-id/push_subscriptions"
+      controller.publicKeyValue = "AQID"
+    JS
+  end
+
+  def teardown
+    @browser&.quit
+  end
+
+  def test_enable_posts_browser_keys_and_disable_removes_only_this_registration
+    run_async("await controller.connect(); await controller.toggle()")
+    assert_equal "Turn off notifications", evaluate("controller.buttonTarget.textContent")
+    assert_equal "true", evaluate('controller.buttonTarget.getAttribute("aria-pressed")')
+    request = evaluate("calls[0]")
+    assert_equal "/123/users/user-id/push_subscriptions", request["url"]
+    assert_equal "csrf-token", request.dig("headers", "X-CSRF-Token")
+    assert_equal({ "push_subscription" => { "endpoint" => "https://push.example.com/device", "p256dh_key" => "public", "auth_key" => "auth" } }, JSON.parse(request["body"]))
+
+    run_async("await controller.toggle()")
+    assert_equal "DELETE", evaluate("calls[1].method")
+    assert_equal "/123/users/user-id/push_subscriptions/device-id", evaluate("calls[1].url")
+    assert_equal "Turn on notifications", evaluate("controller.buttonTarget.textContent")
+    assert evaluate("subscription !== null"), "Other accounts can still use the browser subscription"
+  end
+
+  def test_existing_browser_subscription_is_reused_only_when_explicitly_enabled
+    @browser.execute_script('window.subscription = device; window.permission = "granted"')
+    run_async("await controller.connect()")
+    assert_equal "Turn on notifications", evaluate("controller.buttonTarget.textContent")
+    assert_equal 1, evaluate("calls.length")
+
+    run_async("await controller.toggle()")
+    assert_equal 0, evaluate("subscribeCount")
+    assert_equal "POST", evaluate("calls[1].method")
+  end
+
+  def test_persisted_device_state_is_restored
+    @browser.execute_script('window.subscription = device; window.permission = "granted"; window.devices = [{ id: "saved", endpoint: device.endpoint }]')
+    run_async("await controller.connect()")
+    assert_equal "Turn off notifications", evaluate("controller.buttonTarget.textContent")
+    assert evaluate("controller.helpTarget.hidden")
+  end
+
+  def test_denied_permission_shows_help_without_posting
+    @browser.execute_script('window.nextPermission = "denied"')
+    run_async("await controller.connect(); await controller.toggle()")
+    assert_equal 0, evaluate("calls.length")
+    assert evaluate("controller.buttonTarget.disabled")
+    refute evaluate("controller.helpTarget.hidden")
+    assert_match(/blocked/, evaluate("controller.statusTarget.textContent"))
+  end
+
+  def test_unsupported_browser_shows_help
+    @browser.execute_script("delete window.PushManager")
+    run_async("await controller.connect()")
+    refute evaluate("controller.helpTarget.hidden")
+    assert_match(/doesn’t support/, evaluate("controller.statusTarget.textContent"))
+  end
+
+  def test_failed_post_does_not_claim_notifications_are_enabled
+    @browser.execute_script("window.failRequest = true")
+    run_async("await controller.connect(); await controller.toggle()")
+    refute evaluate('controller.element.classList.contains("notifications--on")')
+    assert_match(/Couldn’t update/, evaluate("controller.statusTarget.textContent"))
+    refute evaluate("controller.buttonTarget.disabled")
+  end
+
+  def test_worker_displays_push_and_opens_or_focuses_the_destination
+    source = File.read(File.expand_path("../app/views/pwa/service_worker.js.erb", __dir__))
+    source = source[source.index('self.addEventListener("push"')..]
+    @browser.execute_script(<<~JS, source)
+      window.handlers = {}
+      window.shown = null
+      window.opened = null
+      window.focused = false
+      window.waiting = Promise.resolve()
+      window.worker = {
+        location: { origin: "https://fizzy.example.com" },
+        addEventListener: (name, handler) => handlers[name] = handler,
+        registration: { showNotification: async (title, options) => window.shown = { title, ...options } },
+        clients: { matchAll: async () => window.windows || [], openWindow: async url => window.opened = url }
+      }
+      new Function("self", arguments[0])(worker)
+      window.payload = { title: "Card title", body: "Added by David", tag: "notification-id", data: { url: "/123/cards/42" } }
+      window.clickEvent = { notification: { ...payload, close: () => {} }, waitUntil: promise => window.waiting = promise }
+    JS
+    run_async("handlers.push({ data: { json: () => payload }, waitUntil: promise => window.waiting = promise }); await window.waiting")
+    assert_equal "Added by David", evaluate("shown.body")
+    assert_equal "Card title", evaluate("shown.title")
+    assert_equal "notification-id", evaluate("shown.tag")
+    run_async("handlers.notificationclick(clickEvent); await window.waiting")
+    assert_equal "https://fizzy.example.com/123/cards/42", evaluate("opened")
+    @browser.execute_script('window.opened = null; window.windows = [{ url: "https://fizzy.example.com/123/cards/42", focus: async () => window.focused = true }]')
+    run_async("handlers.notificationclick(clickEvent); await window.waiting")
+    assert evaluate("focused")
+    assert_nil evaluate("opened")
+    @browser.execute_script('clickEvent.notification.data.url = "https://evil.example.com/"')
+    run_async("handlers.notificationclick(clickEvent); await window.waiting")
+    assert_nil evaluate("opened")
+  end
+
+  private
+    def evaluate(expression)
+      @browser.execute_script("return #{expression}")
+    end
+
+    def run_async(source)
+      result = @browser.execute_async_script("const done = arguments[arguments.length - 1]; (async () => { #{source} })().then(() => done(null)).catch(error => done(error.stack))")
+      assert_nil result, result
+    end
+end
