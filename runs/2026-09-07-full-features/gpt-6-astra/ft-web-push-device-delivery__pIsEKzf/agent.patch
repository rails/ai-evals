@@ -0,0 +1,55 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "key", auth_key: "auth")
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns("vapid-public")
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns("vapid-private")
+    @request = mock("push request")
+  end
+
+  test "delivers encrypted push with the configured VAPID keys" do
+    PushSubscription::Request.expects(:new).with(
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "key", auth: "auth" } },
+      message: "payload", vapid: { public_key: "vapid-public", private_key: "vapid-private" }
+    ).returns(@request)
+    @request.expects(:perform)
+
+    @subscription.deliver("payload")
+  end
+
+  test "expired and invalid subscriptions are removed" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error_class|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/new", p256dh_key: "key", auth_key: "auth") unless error_class == WebPush::ExpiredSubscription
+      subscription ||= @subscription
+      PushSubscription::Request.stubs(:new).returns(@request)
+      @request.stubs(:perform).raises(error_class.new(stub(body: "gone"), "push.example.com"))
+
+      assert_difference "PushSubscription.count", -1 do
+        subscription.deliver("payload")
+      end
+    end
+  end
+
+  test "temporary failures retain the subscription" do
+    PushSubscription::Request.stubs(:new).returns(@request)
+    @request.expects(:perform).raises(WebPush::PushServiceError.new(stub(body: "unavailable"), "push.example.com"))
+
+    assert_no_difference "PushSubscription.count" do
+      assert_raises(WebPush::PushServiceError) { @subscription.deliver("payload") }
+    end
+  end
+
+  test "insecure and malformed endpoints are rejected" do
+    [ "http://push.example.com/device", "not a url", "https://user:password@push.example.com/device", "https:///device" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, endpoint
+    end
+  end
+
+  test "deactivating a user removes their device subscriptions" do
+    assert_difference "PushSubscription.count", -1 do
+      @subscription.user.deactivate
+    end
+  end
+end
