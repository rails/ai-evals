diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..0b135d9
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,108 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :owner, polymorphic: true
+
+  def self.reconcile(account)
+    total = create_or_find_by!(owner: account)
+    total.with_lock { total.reconcile_batch }
+  end
+
+  # Only called while holding the account total's lock. Requests never acquire it
+  # for attachment changes, and workers for different accounts run independently.
+  def reconcile_batch
+    backfill_batch unless backfilled_at?
+
+    changes = Storage::Change.where(account_id: owner_id).order(:id).limit(Storage::Change::BATCH_SIZE).to_a
+    adjustments = Hash.new(0)
+    reconcile_attachments(changes.filter_map(&:attachment_id).uniq, adjustments)
+    reconcile_cards(changes.filter_map(&:card_id).uniq, adjustments)
+    apply_adjustments(adjustments)
+    Storage::Change.where(id: changes.map(&:id)).delete_all
+
+    !backfilled_at? || Storage::Change.where(account_id: owner_id).exists?
+  end
+
+  private
+    def backfill_batch
+      attachments = ActiveStorage::Attachment.storage_countable.where(account_id: owner_id).order(:id)
+      attachments = attachments.where(ActiveStorage::Attachment.arel_table[:id].gt(backfill_cursor)) if backfill_cursor
+      ids = attachments.limit(Storage::Change::BATCH_SIZE).pluck(:id)
+      if ids.any?
+        Storage::Change.insert_all!(ids.map { |id| { id: ActiveRecord::Type::Uuid.generate, account_id: owner_id, attachment_id: id } })
+      end
+      update!(backfill_cursor: ids.last || backfill_cursor,
+        backfilled_at: ids.size < Storage::Change::BATCH_SIZE ? Time.current : nil)
+    end
+
+    def reconcile_attachments(ids, adjustments)
+      attachments = ActiveStorage::Attachment.storage_countable.where(account_id: owner_id, id: ids).includes(:blob, :record).to_a
+      rich_texts = attachments.map(&:record).grep(ActionText::RichText)
+      preload(rich_texts, :record)
+      preload(rich_texts.map(&:record).grep(Comment), :card)
+      attachments = attachments.index_by(&:id)
+      entries = Storage::Entry.where(account_id: owner_id, attachment_id: ids).index_by(&:attachment_id)
+
+      ids.each do |id|
+        entry = entries[id]
+        attributes = entry_attributes(attachments[id])
+        if entry && (!attributes || entry.attributes.symbolize_keys.slice(*attributes.keys) != attributes)
+          adjustments[entry.board_id] -= entry.bytes_used
+          entry.destroy!
+          entry = nil
+        end
+        if attributes && !entry
+          Storage::Entry.create!(attributes.merge(account_id: owner_id, attachment_id: id))
+          adjustments[attributes[:board_id]] += attributes[:bytes_used]
+        end
+      end
+    end
+
+    def preload(records, association)
+      ActiveRecord::Associations::Preloader.new(records: records.compact, associations: association).call
+    end
+
+    def entry_attributes(attachment)
+      if attachment
+        record = attachment.record
+        if record.is_a?(ActionText::RichText)
+          expected_name = { "Board" => "public_description", "Card" => "description", "Comment" => "body" }[record.record_type]
+          record = record.name == expected_name ? record.record : nil
+        end
+
+        card = case record
+        when Card then record
+        when Comment then record.card
+        end
+        board_id = record.is_a?(Board) ? record.id : card&.board_id
+        if board_id && record.account_id == owner_id
+          { board_id: board_id, card_id: card&.id, bytes_used: attachment.blob.byte_size }
+        end
+      end
+    end
+
+    def reconcile_cards(ids, adjustments)
+      boards = Card.where(account_id: owner_id, id: ids).pluck(:id, :board_id).to_h
+      ids.each do |id|
+        entries = Storage::Entry.where(account_id: owner_id, card_id: id)
+        board_id = boards[id]
+        entries.group(:board_id).sum(:bytes_used).each do |old_board_id, bytes|
+          adjustments[old_board_id] -= bytes
+          adjustments[board_id] += bytes if board_id
+        end
+        if board_id
+          entries.update_all(board_id: board_id)
+        else
+          entries.delete_all
+        end
+      end
+    end
+
+    def apply_adjustments(adjustments)
+      adjustments.each do |board_id, bytes|
+        if bytes != 0 && (board = Board.find_by(id: board_id, account_id: owner_id))
+          total = Storage::Total.create_or_find_by!(owner: board)
+          total.increment!(:bytes_used, bytes)
+        end
+      end
+      increment!(:bytes_used, adjustments.values.sum) unless adjustments.values.sum.zero?
+    end
+end
