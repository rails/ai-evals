index 0000000..ab2b427
--- /dev/null
+++ b/app/models/storage/detach_many_tracking.rb
@@ -0,0 +1,14 @@
+module Storage::DetachManyTracking
+  def detach
+    if record.is_a?(ActionText::RichText) && name.to_s == "embeds" && attachments.respond_to?(:find_each)
+      # Rails uses delete_all here, bypassing Attachment#delete and callbacks.
+      # Delete precisely the attachments for which we write notifications.
+      record.class.transaction do
+        attachments.find_each(&:delete)
+        record.attachment_changes.delete(name)
+      end
+    else
+      super
+    end
+  end
+end
