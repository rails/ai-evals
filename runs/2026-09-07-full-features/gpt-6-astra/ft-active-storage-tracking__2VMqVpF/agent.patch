--- /dev/null
+++ b/app/models/storage/change.rb
@@ -0,0 +1,11 @@
+class Storage::Change < ApplicationRecord
+  BATCH_SIZE = 500
+
+  def self.reconcile_all_later
+    accounts = Account.left_joins(:storage_total)
+    accounts.where(storage_totals: { backfilled_at: nil })
+      .or(accounts.where(id: select(:account_id))).find_each do |account|
+        Storage::ReconcileJob.perform_later(account)
+      end
+  end
+end
diff --git a/app/models/storage/detach_many_tracking.rb b/app/models/storage/detach_many_tracking.rb
