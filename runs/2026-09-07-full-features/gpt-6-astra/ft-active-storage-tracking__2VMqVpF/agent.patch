diff --git a/app/models/account/storage.rb b/app/models/account/storage.rb
new file mode 100644
index 0000000..0f75c22
--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,22 @@
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    include StorageTracked
+
+    after_destroy :delete_storage_accounting
+  end
+
+  def reconcile_storage_later
+    # Imports bypass attachment callbacks and can contain IDs older than our cursor.
+    total = ::Storage::Total.create_or_find_by!(owner: self)
+    total.with_lock { total.update!(backfill_cursor: nil, backfilled_at: nil) }
+    ::Storage::ReconcileJob.perform_later(self)
+  end
+
+  private
+    def delete_storage_accounting
+      ::Storage::Change.where(account_id: id).delete_all
+      ::Storage::Entry.where(account_id: id).delete_all
+    end
+end
