+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "empty boards and accounts use no bytes" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts only card images and embeds in board and card descriptions and comments" do
+    attach(@card, :image, 11)
+    embed(@board, :public_description, 13)
+    embed(@card, :description, 17)
+    embed(comments(:logo_agreement_jz), :body, 19)
+    attach(users(:david), :avatar, 23)
+    blob(29) # Unattached uploads do not count.
+    variant = ActiveStorage::VariantRecord.create!(blob: @card.image.blob, variation_digest: "test-variant")
+    variant.image.attach(blob(31))
+    export = @account.exports.create!(user: users(:david))
+    export.file.attach(blob(37))
+    import = @account.imports.create!(identity: identities(:david))
+    import.file.attach(blob(41))
+
+
+    assert_equal 0, @board.bytes_used
+    reconcile
+    assert_equal 60, @board.bytes_used
+    assert_equal 60, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "removing and replacing attachments subtracts their previous sizes" do
+    attach(@card, :image, 11)
+    embed(@card, :description, 17)
+    reconcile
+
+    attach(@card, :image, 23)
+    @card.update!(description: "No attachments")
+    reconcile
+    assert_equal 23, @account.bytes_used
+
+    @card.image.detach
+    reconcile
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "card moves transfer images and comment embeds but not board descriptions" do
+    attach(@card, :image, 11)
+    embed(@card, :description, 13)
+    embed(comments(:logo_agreement_jz), :body, 17)
+    embed(@board, :public_description, 19)
+    reconcile
+
+    @card.move_to(boards(:private))
+    reconcile
+    assert_equal 19, @board.bytes_used
+    assert_equal 41, boards(:private).bytes_used
+    assert_equal 60, @account.bytes_used
+  end
+
+  test "moving before attachment reconciliation uses the current board" do
+    reconcile # Finish initial backfill first.
+    attach(@card, :image, 11)
+    @card.move_to(boards(:private))
+    reconcile
+    assert_equal 0, @board.bytes_used
+    assert_equal 11, boards(:private).bytes_used
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "deleting comments cards and boards removes their usage" do
+    attach(@card, :image, 11)
+    embed(comments(:logo_agreement_jz), :body, 17)
+    embed(@board, :public_description, 19)
+    reconcile
+
+    comments(:logo_agreement_jz).destroy!
+    reconcile
+    assert_equal 30, @account.bytes_used
+    @card.destroy!
+    reconcile
+    assert_equal 19, @account.bytes_used
+    @board.destroy!
+    reconcile
+    assert_equal 0, @account.bytes_used
+    assert_not Storage::Total.exists?(owner: @board)
+  end
+
+  test "duplicate and late notifications are idempotent" do
+    attachment = attach(@card, :image, 11)
+    reconcile
+    3.times { Storage::Change.create!(account_id: @account.id, attachment_id: attachment.id) }
+    reconcile
+    assert_equal 11, @account.bytes_used
+
+    @card.image.detach
+    3.times { Storage::Change.create!(account_id: @account.id, attachment_id: attachment.id) }
+    reconcile
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, Storage::Entry.count
+  end
+
+  test "shared blobs count once per attachment reference" do
+    shared = blob(11)
+    @card.image.attach(shared)
+    cards(:layout).image.attach(shared)
+    reconcile
+    assert_equal 22, @account.bytes_used
+    @card.image.detach
+    reconcile
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "rolled back changes do not affect accounting" do
+    reconcile
+    assert_no_difference "Storage::Change.count" do
+      Card.transaction do
+        attach(@card, :image, 11)
+        raise ActiveRecord::Rollback
+      end
+    end
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "backfill finds existing attachments without change notifications and is repeatable" do
+    attach(@card, :image, 11)
+    Storage::Change.delete_all
+    reconcile
+    assert_equal 11, @account.bytes_used
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @account.reconcile_storage_later }
+    assert_equal 11, @account.bytes_used
+    assert_equal 1, Storage::Entry.count
+  end
+
+  test "failed batches roll back totals ledger and consumed notifications together" do
+    attach(@card, :image, 11)
+    Storage::Total.any_instance.stubs(:apply_adjustments).raises("failure")
+    assert_raises(RuntimeError) { Storage::Total.reconcile(@account) }
+    assert_equal 0, @account.bytes_used
+    assert_equal 0, Storage::Entry.count
+    Storage::Total.any_instance.unstub(:apply_adjustments)
+    reconcile
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "bulk detaching rich text embeds removes usage" do
+    embed(@card, :description, 11)
+    reconcile
+    @card.description.embeds.detach
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "purging an attachment removes usage even when the blob is gone" do
+    attach(@card, :image, 11)
+    reconcile
+    @card.image.purge
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "unrelated rich text attachments do not count" do
+    ActionText::RichText.create!(record: @board, name: "other", body: ActionText::Attachment.from_attachable(blob(11)).to_html)
+    reconcile
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "one batch consumes at most the batch size and schedules continuation" do
+    attachment = attach(@card, :image, 11)
+    reconcile
+    count = Storage::Change::BATCH_SIZE + 1
+    Storage::Change.insert_all!(Array.new(count) do
+      { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, attachment_id: attachment.id }
+    end)
+
+    assert_enqueued_with(job: Storage::ReconcileJob, args: [ @account ]) do
+      Storage::ReconcileJob.perform_now(@account)
+    end
+    assert_equal 1, Storage::Change.where(account_id: @account.id).count
+    assert_equal 11, @account.bytes_used
+    reconcile
+    assert_equal 0, Storage::Change.where(account_id: @account.id).count
+    assert_equal 11, @account.bytes_used
+  end
+
+  test "dispatcher discovers both existing accounts and pending changes" do
+    assert_enqueued_with(job: Storage::ReconcileJob, args: [ @account ]) do
+      Storage::Change.reconcile_all_later
+    end
+    reconcile
+    clear_enqueued_jobs
+    attach(@card, :image, 11)
+    assert_enqueued_with(job: Storage::ReconcileJob, args: [ @account ]) do
+      Storage::Change.reconcile_all_later
+    end
+  end
+
+  test "accounts sum usage across boards without including another account" do
+    attach(@card, :image, 11)
+    embed(boards(:private), :public_description, 13)
+    Current.with_account(accounts(:initech)) do
+      embed(boards(:miltons_wish_list), :public_description, 17)
+      Storage::Total.reconcile(accounts(:initech))
+    end
+    reconcile
+    assert_equal 24, @account.bytes_used
+    assert_equal 11, @board.bytes_used
+    assert_equal 13, boards(:private).bytes_used
+    assert_equal 17, accounts(:initech).bytes_used
+  end
+
+  test "destroying an account removes its accounting records" do
+    attach(@card, :image, 11)
+    reconcile
+    @account.destroy!
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Change.exists?(account_id: @account.id)
+    assert_not Storage::Total.exists?(owner: @account)
+    assert_not Storage::Total.exists?(owner: @board)
+  end
+
+  test "totals support sizes larger than 32 bit integers" do
+    attachment = attach(@card, :image, 11)
+    attachment.blob.update_column(:byte_size, 5.gigabytes)
+    reconcile
+    assert_equal 5.gigabytes, @account.bytes_used
+    assert_equal 5.gigabytes, @board.bytes_used
+  end
+
+  test "backfill resumes in bounded batches alongside live changes" do
+    attach(@card, :image, 11)
+    attach(cards(:layout), :image, 13)
+    embed(@board, :public_description, 17)
+    Storage::Change.delete_all # Simulate attachments that predate accounting.
+
+    stub_const(Storage::Change, :BATCH_SIZE, 2) do
+      assert Storage::Total.reconcile(@account)
+      total = Storage::Total.find_by!(owner: @account)
+      assert_nil total.backfilled_at
+      assert_not_nil total.backfill_cursor
+      assert_equal 2, Storage::Entry.count
+
+      # A normal upload after the backfill cursor advanced is not lost or doubled.
+      embed(comments(:logo_agreement_jz), :body, 19)
+      reconcile
+      assert_not_nil total.reload.backfilled_at
+      assert_equal 4, Storage::Entry.count
+      assert_equal 60, @account.bytes_used
+    end
+  end
+
+  test "resuming after bulk import finds attachments older than the cursor" do
+    attach(@card, :image, 11)
+    reconcile
+    attachment = attach(cards(:layout), :image, 13)
+    Storage::Change.delete_all
+    old_id = ActiveRecord::FixtureSet.identify("imported_attachment", :uuid)
+    attachment.update_column(:id, old_id)
+
+    perform_enqueued_jobs(only: Storage::ReconcileJob) { @account.reconcile_storage_later }
+    assert_equal 24, @account.bytes_used
+  end
+
+  private
+    def blob(bytes)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * bytes), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def attach(record, name, bytes)
+      record.public_send(name).attach(blob(bytes))
+      record.public_send("#{name}_attachment")
+    end
+
+    def embed(record, name, bytes)
+      record.update!(name => ActionText::Content.new(ActionText::Attachment.from_attachable(blob(bytes)).to_html))
+    end
+
+    def reconcile
+      perform_enqueued_jobs(only: Storage::ReconcileJob) { Storage::ReconcileJob.perform_later(@account) }
+    end
+end
