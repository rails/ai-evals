+      t.references :owner, polymorphic: true, type: :uuid, null: false, index: { unique: true }
+      t.bigint :bytes_used, default: 0, null: false
+      t.uuid :backfill_cursor
+      t.datetime :backfilled_at
+    end
+
+    create_table :storage_entries, id: :uuid do |t|
+      t.uuid :attachment_id, null: false
+      t.uuid :account_id, null: false
+      t.uuid :board_id, null: false
+      t.uuid :card_id
+      t.bigint :bytes_used, null: false
+      t.index :attachment_id, unique: true
+      t.index [ :account_id, :card_id ]
+    end
+
+    # These are an outbox, written in the same transaction as the source change.
+    # No foreign keys: deletion notifications must outlive their source records.
+    create_table :storage_changes, id: :uuid do |t|
+      t.uuid :account_id, null: false
+      t.uuid :attachment_id
+      t.uuid :card_id
+      t.index [ :account_id, :id ]
+    end
+  end
+end
