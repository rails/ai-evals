+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,28 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  included do
+    scope :storage_countable, -> {
+      where(record_type: "Card", name: "image")
+        .or(where(record_type: "ActionText::RichText", name: "embeds"))
+    }
+
+    after_create :record_storage_change
+    after_destroy :record_storage_change
+  end
+
+  # Active Storage's purge and detach paths use delete rather than destroy.
+  def delete
+    transaction do
+      record_storage_change if persisted?
+      super
+    end
+  end
+
+  private
+    def record_storage_change
+      if (record_type == "Card" && name == "image") || (record_type == "ActionText::RichText" && name == "embeds")
+        Storage::Change.create!(account_id: account_id, attachment_id: id)
+      end
+    end
+end
diff --git a/app/models/storage/change.rb b/app/models/storage/change.rb
