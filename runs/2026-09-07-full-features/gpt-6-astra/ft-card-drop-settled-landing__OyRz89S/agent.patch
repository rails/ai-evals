diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..0d8ffe5
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,223 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  initialize() {
+    this.pendingCards = new Map()
+    this.saveQueue = Promise.resolve()
+  }
+
+  disconnect() {
+    this.end()
+    this.cardTargets.forEach(card => card.removeAttribute("draggable"))
+  }
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!this.cardTargets.includes(card) || this.pendingCards.has(card)) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedCard = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    event.dataTransfer.setDragImage(card, event.offsetX, event.offsetY)
+    card.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const container = this.#destination(event)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (!this.hoveredContainer?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#destination(event)
+    const card = this.draggedCard
+    this.end()
+
+    if (container) {
+      event.preventDefault()
+      this.#move(card, container)
+    }
+  }
+
+  end() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#highlight(null)
+  }
+
+  preventDraggableRemoval(event) {
+    // Draggability belongs to this board, not the shared server-rendered preview.
+    if (event.detail.attributeName === "draggable" && this.cardTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  preventPendingMorph(event) {
+    if (this.#busy && (event.target.contains(this.element) || this.element.contains(event.target))) {
+      event.preventDefault()
+    }
+  }
+
+  preventPendingFrameRender(event) {
+    const frame = event.target
+    const containsDraggedCard = this.draggedCard && frame.contains(this.draggedCard)
+    const containsPendingMove = Array.from(this.pendingCards).some(([ card, source ]) => frame.contains(card) || source.contains(frame))
+
+    if (containsDraggedCard || containsPendingMove) {
+      // A frame fetched before the save can still contain the card's old location.
+      event.detail.render = () => {}
+    }
+  }
+
+  // Private
+
+  #destination(event) {
+    if (!this.draggedCard) return null
+
+    const container = event.target.closest('[data-drag-and-drop-target~="container"]')
+    if (this.containerTargets.includes(container) && !container.contains(this.draggedCard) && container.querySelector(".cards__list")) {
+      return container
+    }
+  }
+
+  #highlight(container) {
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.hoveredContainer = container
+    this.hoveredContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  async #move(card, container) {
+    const source = card.closest('[data-drag-and-drop-target~="container"]')
+    const origin = document.createComment("Card before move")
+    card.before(origin)
+    const original = card.cloneNode(true)
+
+    this.pendingCards.set(card, source)
+    this.#insert(card, container)
+    this.#updateAppearance(card, container)
+    this.#changeCount(source, -1)
+    this.#changeCount(container, 1)
+
+    try {
+      const request = this.#request(card, container)
+      // Save in drop order, not network completion order, to preserve recency sorting.
+      const save = this.saveQueue.then(() => request.perform())
+      this.saveQueue = save.catch(() => {})
+      const response = await save
+      if (!response.ok) throw new Error("Could not move card")
+    } catch {
+      origin.replaceWith(card)
+      card.innerHTML = original.innerHTML
+      card.className = original.className
+      card.setAttribute("style", original.getAttribute("style"))
+      this.#changeCount(source, 1)
+      this.#changeCount(container, -1)
+      if (this.element.isConnected) {
+        window.alert("The card could not be moved. Please try again.")
+      }
+    } finally {
+      origin.remove()
+      this.pendingCards.delete(card)
+    }
+  }
+
+  #insert(card, container) {
+    const list = container.querySelector(".cards__list")
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="card"]'))
+    const goldenFirst = [ "column", "maybe" ].includes(container.dataset.dragAndDropKind)
+    const nextCard = goldenFirst && !card.classList.contains("golden-effect")
+      ? cards.find(card => !card.classList.contains("golden-effect"))
+      : cards[0]
+
+    // Moves are activity: newest first, after gold cards in active columns.
+    // Insert inside the pagination frame so a refresh keeps the same structure.
+    if (nextCard) {
+      nextCard.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      const parent = list.querySelector("turbo-frame") || list
+      parent.prepend(card)
+    }
+  }
+
+  #updateAppearance(card, container) {
+    const kind = container.dataset.dragAndDropKind
+    const active = [ "column", "maybe" ].includes(kind)
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", kind === "not-now")
+    card.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+    card.style.setProperty("--card-color", active ? container.style.getPropertyValue("--card-color") || "var(--color-card-default)" : "var(--color-card-complete)")
+
+    if (kind !== "closed") {
+      const stages = card.querySelectorAll(".card__stages [data-column-id]")
+      stages.forEach(stage => {
+        stage.classList.toggle("card__column-name--current", stage.dataset.columnId === container.dataset.dragAndDropColumnId)
+      })
+      card.querySelector(".card__header .card__column-name")?.remove()
+      const currentStage = Array.from(stages).find(stage => stage.classList.contains("card__column-name--current"))
+      if (currentStage) {
+        card.querySelector(".card__header").append(currentStage.cloneNode(true))
+      }
+    }
+  }
+
+  #changeCount(container, change) {
+    const counter = container.querySelector("[data-drag-and-drop-count]")
+    const count = Number(counter.dataset.dragAndDropCount) + change
+    counter.dataset.dragAndDropCount = count
+    counter.textContent = count > 99 ? "99+" : count
+    counter.closest("button").style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  #request(card, container) {
+    const kind = container.dataset.dragAndDropKind
+    const options = { responseKind: "json" }
+    let method = "post"
+    let url
+
+    switch (kind) {
+      case "column":
+        url = card.dataset.dragAndDropTriageUrl
+        options.body = { column_id: container.dataset.dragAndDropColumnId }
+        break
+      case "maybe":
+        url = card.dataset.dragAndDropTriageUrl
+        method = "delete"
+        break
+      case "not-now":
+        url = card.dataset.dragAndDropNotNowUrl
+        break
+      case "closed":
+        url = card.dataset.dragAndDropClosureUrl
+        break
+    }
+
+    return new FetchRequest(method, url, options)
+  }
+
+  get #busy() {
+    return this.draggedCard || this.pendingCards.size > 0
+  }
+}
