+++ b/test/models/zip_file_transfer_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class ZipFileTransferTest < ActiveSupport::TestCase
+  test "writer measures every ZIP byte including the central directory" do
+    io = StringIO.new("".b)
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("test.json", '{"hello":"world"}')
+    writer.close
+    assert_equal io.string.bytesize, writer.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), writer.checksum
+    assert_equal({ "hello" => "world" }, ZipFile::Reader.new(io).read_json("test.json"))
+  end
+
+  test "unsafe paths are rejected without extracting to the filesystem" do
+    [ "../escape", "/absolute", "some/../escape", "windows\\escape" ].each do |path|
+      io = StringIO.new("".b)
+      writer = ZipFile::Writer.new(io)
+      writer.add_file("x" * path.bytesize, "bad")
+      writer.close
+      io.string.gsub!("x" * path.bytesize, path)
+      assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(io) }
+    end
+  end
+
+  test "duplicate ZIP entry names are rejected" do
+    io = StringIO.new("".b)
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("first", "one")
+    writer.add_file("other", "two")
+    writer.close
+    io.string.gsub!("other", "first")
+    assert_raises(ZipFile::Reader::InvalidArchive) { ZipFile::Reader.new(io) }
+  end
+
+  test "stored files are read in bounded chunks and checked for corruption" do
+    io = StringIO.new("".b)
+    writer = ZipFile::Writer.new(io)
+    writer.add_file("file", "contents", compress: false)
+    writer.close
+    reader = ZipFile::Reader.new(io)
+    reader.open("file") { |file| assert_equal "contents", file.read }
+    io.string.sub!("contents", "corrupt!")
+    assert_raises(ZipFile::Reader::InvalidArchive) { reader.open("file") { } }
+  end
+
+  test "S3 archives use multipart streaming and store the resulting checksum and size" do
+    require "active_storage/service/s3_service"
+    Current.account = accounts(:'37s')
+    export = Export.create!(account: Current.account, user: users(:david), kind: "cards")
+    service = ActiveStorage::Service::S3Service.new(bucket: "test", region: "us-east-1", stub_responses: true)
+    service.name = "test_s3"
+    ActiveStorage::Blob.services.stubs(:fetch).with("test_s3").returns(service)
+    ActiveStorage::Blob.stubs(:service).returns(service)
+    io = StringIO.new("".b)
+    service.expects(:upload_stream).with(key: anything, content_type: "application/zip", part_size: 100.megabytes).yields(io)
+    ZipFile.create_for(export.file, filename: "s3.zip") { |zip| zip.add_file("hello", "world") }
+    assert_equal "test_s3", export.file.blob.service_name
+    assert_equal io.string.bytesize, export.file.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), export.file.checksum
+  end
+end
