@@ -0,0 +1,78 @@
+require "test_helper"
+
+class DataTransfersTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = Account.create_with_owner(account: { name: "Transfers" }, owner: { name: "David", identity: identities(:david) })
+    @user = @account.users.find_by!(identity: identities(:david))
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "export attaches a valid ZIP and emails a one day download link" do
+    export = Export.create!(account: @account, user: @user, kind: "account")
+    freeze_time do
+      assert_enqueued_email_with DataTransferMailer, :export_ready, args: [ export ] do
+        export.generate
+      end
+      assert export.available?
+      assert_equal 1.day.from_now, export.expires_at
+      assert_equal export, Export.find_signed!(export.download_token, purpose: :download)
+      export.file.open { |file| assert_equal "account", ZipFile::Reader.new(file).read_json("manifest.json")["type"] }
+      assert_includes DataTransferMailer.export_ready(export).text_part.body.decoded, "Your Fizzy export is ready"
+      token = export.download_token
+      travel 1.day + 1.second
+      assert_not export.available?
+      assert_nil Export.find_signed(token, purpose: :download)
+      Export::PurgeJob.perform_now(export)
+      assert_not export.file.attached?
+    end
+  end
+
+  test "imports run without account context and purge their staging upload" do
+    export = Export.create!(account: @account, user: @user, kind: "account")
+    export.generate
+    export.file.open do |file|
+      upload = ActionDispatch::Http::UploadedFile.new(tempfile: file, filename: "account.zip")
+      import = nil
+      Current.without_account do
+        assert_enqueued_with(job: ImportJob) do
+          import = Import.create_for(identity: identities(:jz), upload: upload)
+        end
+        assert_enqueued_email_with DataTransferMailer, :import_finished, args: [ import ] do
+          ImportJob.perform_now(import)
+        end
+      end
+      assert_no_difference "Account.count" do
+        ImportJob.perform_now(import)
+      end
+      assert_equal "completed", import.reload.status
+      assert_not_equal @account, import.account
+      assert import.account.users.find_by!(identity: identities(:jz)).owner?
+      assert_not import.storage.exist?(import.archive_key)
+      assert_includes DataTransferMailer.import_finished(import).text_part.body.decoded, "Your Fizzy account has been imported"
+    end
+  end
+
+  test "corrupt imports leave no account and send an explanation" do
+    Tempfile.create("bad-import") do |file|
+      file.write("Not a ZIP")
+      file.rewind
+      import = Import.create_for(identity: identities(:jz), upload: ActionDispatch::Http::UploadedFile.new(tempfile: file, filename: "bad.zip"))
+      # Simulate files left by a worker interrupted before its database commit.
+      leftover_key = "imported/#{import.id}/interrupted-upload"
+      ActiveStorage::Blob.service.upload(leftover_key, StringIO.new("partial"))
+      assert_no_difference [ "Account.count", "User.count", "ActiveStorage::Blob.count" ] do
+        assert_enqueued_email_with DataTransferMailer, :import_finished, args: [ import ] do
+          ImportJob.perform_now(import)
+        end
+      end
+      assert_not ActiveStorage::Blob.service.exist?(leftover_key)
+      assert_equal "failed", import.reload.status
+      assert_match(/damaged/, import.error)
+      assert_nil import.account
+      assert_not import.storage.exist?(import.archive_key)
+      assert_includes DataTransferMailer.import_finished(import).text_part.body.decoded, "Your Fizzy import failed"
+    end
+  end
+end
diff --git a/test/models/zip_file_transfer_test.rb b/test/models/zip_file_transfer_test.rb
