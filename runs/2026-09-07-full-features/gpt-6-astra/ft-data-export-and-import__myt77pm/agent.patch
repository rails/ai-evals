diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..5110291
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,64 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+
+  after_destroy_commit -> { storage.delete(archive_key) }
+
+  def self.create_for(identity:, upload:)
+    raise ArgumentError, "Choose a Fizzy account ZIP file" unless upload.respond_to?(:tempfile)
+
+    import = create!(identity: identity, archive_key: "imports/#{SecureRandom.hex(28)}", service_name: ActiveStorage::Blob.service.name)
+    begin
+      import.storage.upload(import.archive_key, upload.tempfile, content_type: "application/zip")
+      Current.without_account { ImportJob.perform_later(import) }
+      import
+    rescue StandardError
+      import.storage.delete(import.archive_key)
+      import.destroy!
+      raise
+    end
+  end
+
+  def restore
+    with_lock do
+      next unless status == "pending"
+      begin
+        ActiveStorage::Blob.service.delete_prefixed(destination_key_prefix)
+        storage.open(archive_key, checksum: nil, verify: false) do |file|
+          Account::DataTransfer::Restorer.new(ZipFile::Reader.new(file), identity: identity, key_prefix: destination_key_prefix).restore do |account|
+            update!(account: account, status: "completed")
+          end
+        end
+      rescue StandardError => exception
+        # The restorer rolls back its savepoint before we persist the failure.
+        update!(status: "failed", account: nil, error: failure_reason(exception))
+        Rails.error.report(exception, handled: true)
+      end
+    end
+    storage.delete(archive_key)
+    ActiveStorage::Blob.service.delete_prefixed(destination_key_prefix) if status == "failed"
+    DataTransferMailer.import_finished(self).deliver_later
+  end
+
+  def storage
+    ActiveStorage::Blob.services.fetch(service_name)
+  end
+
+  private
+    def destination_key_prefix
+      "imported/#{id}/"
+    end
+
+    def failure_reason(exception)
+      case exception
+      when Account::DataTransfer::InvalidArchive, ZipFile::Reader::InvalidArchive
+        exception.message.truncate(1000)
+      when JSON::ParserError, ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature, Zlib::Error
+        "The ZIP file is damaged or is not a supported Fizzy export."
+      when ActiveRecord::ActiveRecordError, KeyError, ArgumentError
+        "The archive contains invalid or incomplete records."
+      else
+        "The import could not finish because a file could not be read or stored. Please try again or contact support."
+      end
+    end
+end
