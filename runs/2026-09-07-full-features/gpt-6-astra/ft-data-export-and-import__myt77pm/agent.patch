@@ -0,0 +1,42 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :file
+
+  validates :kind, inclusion: { in: %w[account cards] }
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate
+    with_lock { generate_file if status == "pending" }
+    if status == "completed"
+      Export::PurgeJob.set(wait_until: expires_at).perform_later(self)
+      DataTransferMailer.export_ready(self).deliver_later
+    end
+  end
+
+  def available?
+    status == "completed" && expires_at&.future? && file.attached?
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  private
+    def generate_file
+      raise ActiveRecord::RecordNotFound unless user.active? && (kind == "cards" || user.admin?)
+      Current.with(account: account, user: user) do
+        ZipFile.create_for(file, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+          Account::DataTransfer::Archive.new(account, user: (user if kind == "cards")).export(zip)
+        end
+      end
+      update!(status: "completed", expires_at: 1.day.from_now)
+    rescue StandardError
+      file.purge if file.attached?
+      update!(status: "failed")
+      Rails.error.report($!, handled: true)
+    end
+end
