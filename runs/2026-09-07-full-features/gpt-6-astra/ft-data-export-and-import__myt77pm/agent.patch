+++ b/app/models/account/data_transfer/archive.rb
@@ -0,0 +1,41 @@
+class Account::DataTransfer::Archive
+  def initialize(account, user: nil)
+    @account, @user = account, user
+  end
+
+  def export(zip)
+    manifest = { version: Account::DataTransfer::VERSION, type: @user ? "cards" : "account" }
+    unless @user
+      manifest[:record_counts] = {}
+      Account::DataTransfer::Manifest.new(@account).each_record_set do |set|
+        set.export(zip)
+        manifest[:record_counts][set.model.table_name] = zip.glob("records/#{set.model.table_name}/*.json").size
+      end
+    end
+    export_cards(zip)
+    zip.add_file("manifest.json", manifest.to_json)
+  end
+
+  private
+    def export_cards(zip)
+      cards = @user ? @user.accessible_cards : @account.cards
+      cards.find_each do |card|
+        files = []
+        data = card.attributes.merge("description" => card.description.to_s)
+        data["comments"] = card.comments.chronologically.map do |comment|
+          files.concat(comment.attachments.map(&:blob))
+          comment.attributes.merge("body" => comment.body.to_s)
+        end
+        files.concat(card.attachments.map(&:blob))
+        files << card.image.blob if card.image.attached?
+        data["files"] = files.uniq(&:id).map do |blob|
+          path = @user ? "cards/#{card.id}/files/#{blob.id}/#{blob.filename.to_s.gsub(/[\\\/]/, '_')}" : "files/#{blob.id}"
+          if @user
+            zip.add_file(path, compress: false) { |sink| blob.download { |chunk| sink.write(chunk) } }
+          end
+          { id: blob.id, filename: blob.filename.to_s, path: path, content_type: blob.content_type }
+        end
+        zip.add_file("cards/#{card.id}.json", data.to_json)
+      end
+    end
+end
