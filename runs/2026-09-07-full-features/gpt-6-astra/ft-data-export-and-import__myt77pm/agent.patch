+require "test_helper"
+
+class Account::DataTransfersControllerTest < ActionDispatch::IntegrationTest
+  test "only admins can export an account" do
+    sign_in_as :david
+    assert_no_difference "Export.count" do
+      post account_exports_path
+      assert_response :forbidden
+    end
+    logout_and_sign_in_as :kevin
+    assert_difference "Export.count" do
+      assert_enqueued_with(job: ExportJob) { post account_exports_path }
+      assert_redirected_to account_settings_path
+    end
+    assert_equal users(:kevin), Export.last.user
+    assert_equal accounts(:'37s'), Export.last.account
+    assert_equal "account", Export.last.kind
+  end
+
+  test "members can only request their own card exports" do
+    sign_in_as :david
+    assert_difference "Export.count" do
+      post user_exports_path(users(:david))
+      assert_redirected_to user_path(users(:david))
+    end
+    assert_equal "cards", Export.last.kind
+    assert_no_difference "Export.count" do
+      post user_exports_path(users(:jason))
+      assert_response :forbidden
+    end
+  end
+
+  test "imports require authentication but no account" do
+    untenanted do
+      get new_account_import_path
+      assert_response :redirect
+    end
+    identity = Identity.create!(email_address: "new-importer@example.com")
+    sign_in_as identity
+    untenanted do
+      get new_account_import_path
+      assert_response :success
+      assert_select "input[type=file][name=file]"
+      post account_imports_path
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "download links are signed and expire after a day" do
+    Current.account = accounts(:'37s')
+    export = Export.create!(account: Current.account, user: users(:david), kind: "cards", status: "completed", expires_at: 1.day.from_now)
+    export.file.attach(io: StringIO.new("zip"), filename: "cards.zip", content_type: "application/zip")
+    token = export.download_token
+    untenanted do
+      get export_path(token)
+      assert_response :redirect
+      assert_equal "no-store", response.headers["Cache-Control"]
+      get export_path("invalid")
+      assert_response :not_found
+      travel 1.day + 1.second do
+        get export_path(token)
+        assert_response :not_found
+      end
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/archive_test.rb b/test/models/account/data_transfer/archive_test.rb
new file mode 100644
index 0000000..2eb1b49
--- /dev/null
+++ b/test/models/account/data_transfer/archive_test.rb
@@ -0,0 +1,141 @@
+require "test_helper"
+
+class Account::DataTransfer::ArchiveTest < ActiveSupport::TestCase
+  setup do
+    @account = Account.create_with_owner(account: { name: "Portable account" }, owner: { name: "Mike", identity: identities(:mike) })
+    @owner = @account.users.find_by!(identity: identities(:mike))
+    Current.account = @account
+    Current.user = @owner
+    @board = @account.boards.create!(name: "Export me", creator: @owner, all_access: true)
+    @card = @board.cards.create!(title: "Portable", creator: @owner, status: :published)
+    @comment = @card.comments.create!(body: "A comment", creator: @owner)
+    @card.image.attach(io: StringIO.new("a file"), filename: "file.txt", content_type: "text/plain")
+  end
+
+  test "account round trip restores people cards comments and files with new IDs" do
+    with_archive do |zip|
+      imported = Account::DataTransfer::Restorer.new(zip, identity: identities(:david)).restore
+      assert_not_equal @account.id, imported.id
+      card = imported.cards.find_by!(title: "Portable")
+      assert_not_equal @card.id, card.id
+      assert_equal "A comment", card.comments.first.body.to_plain_text
+      assert_equal "a file", card.image.download
+      assert_equal @owner.identity, card.creator.identity
+      assert imported.users.find_by!(identity: identities(:david)).owner?
+      assert_equal @account.boards.count, imported.boards.count
+    end
+  end
+
+  test "card export only includes accessible boards and is not an account archive" do
+    other = @account.users.create!(name: "Private", identity: identities(:jz))
+    private_board = @account.boards.create!(name: "Private", creator: other)
+    private_card = private_board.cards.create!(title: "Secret", creator: other)
+    with_archive(user: @owner) do |zip|
+      assert_equal "cards", zip.read_json("manifest.json")["type"]
+      assert_includes zip.paths, "cards/#{@card.id}.json"
+      assert_not_includes zip.paths, "cards/#{private_card.id}.json"
+      assert_not zip.paths.any? { |path| path.start_with?("records/") }
+      assert_raises(Account::DataTransfer::InvalidArchive) do
+        Account::DataTransfer::Restorer.new(zip, identity: identities(:david)).restore
+      end
+    end
+  end
+
+  test "a missing file rolls back the entire account and uploaded files" do
+    with_archive do |zip|
+      zip.stubs(:open).with("files/#{@card.image.blob.id}").raises(ZipFile::Reader::InvalidArchive, "Missing file")
+      assert_no_difference [ "Account.count", "User.count", "Card.count", "ActiveStorage::Blob.count", "Identity.count" ] do
+        assert_raises(ZipFile::Reader::InvalidArchive) do
+          Account::DataTransfer::Restorer.new(zip, identity: identities(:david)).restore
+        end
+      end
+    end
+  end
+
+  test "embedded files mentions columns assignments tags and filters survive a round trip" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embedded contents"), filename: "embedded.txt", content_type: "text/plain")
+    @card.update!(description: "<p>A file</p>#{ActionText::Attachment.from_attachable(blob).to_html}#{ActionText::Attachment.from_attachable(@owner).to_html}")
+    column = @board.columns.create!(name: "Working", color: "var(--color-card-1)")
+    @card.update!(column: column)
+    @card.assignments.create!(assignee: @owner, assigner: @owner)
+    @card.steps.create!(content: "Do this", completed: true)
+    tag = @account.tags.create!(title: "Important")
+    @card.taggings.create!(tag: tag)
+    @owner.filters.create!(boards: [ @board ], tags: [ tag ], card_ids: [ @card.id ], column_ids: [ column.id ])
+
+    with_archive do |zip|
+      imported = Account::DataTransfer::Restorer.new(zip, identity: @owner.identity).restore
+      card = imported.cards.find_by!(title: "Portable")
+      assert_equal "Working", card.column.name
+      assert_equal [ "important" ], card.tags.pluck(:title)
+      assert_equal card.creator, card.assignments.first.assignee
+      assert card.steps.first.completed?
+      assert_equal "embedded contents", card.description.embeds.first.download
+      assert_includes card.description.body.attachables, card.creator
+      assert_includes card.description.body.attachables, card.description.embeds.first.blob
+      assert_equal imported.id, card.description.embeds.first.blob.account_id
+      filter = card.creator.filters.first
+      assert_equal [ card.id ], filter.card_ids
+      assert_equal [ card.column_id ], filter.column_ids
+      assert_equal [ card.board_id ], filter.boards.ids
+      assert_equal card.tags.ids, filter.tags.ids
+      assert_equal "a file".bytesize + "embedded contents".bytesize, imported.bytes_used
+      assert_equal imported.bytes_used, card.board.bytes_used
+    end
+  end
+
+  test "a reference to a user outside the archive is rejected" do
+    with_archive do |zip|
+      path = "records/cards/#{@card.id}.json"
+      data = zip.read_json(path).merge("creator_id" => users(:david).id)
+      original = zip.method(:read_json)
+      zip.define_singleton_method(:read_json) { |requested| requested == path ? data : original.call(requested) }
+      assert_no_difference [ "Account.count", "Card.count" ] do
+        assert_raises(Account::DataTransfer::InvalidArchive) do
+          Account::DataTransfer::Restorer.new(zip, identity: identities(:david)).restore
+        end
+      end
+    end
+  end
+
+  test "failure after uploading deletes the new storage keys and rolls back the database" do
+    with_archive do |zip|
+      restorer = Account::DataTransfer::Restorer.new(zip, identity: identities(:david))
+      restorer.stubs(:restore_rich_text).raises(Account::DataTransfer::InvalidArchive, "Bad rich text")
+      new_key = nil
+      ActiveStorage::Blob.service.expects(:upload).with do |key, *|
+        new_key = key
+        key != @card.image.blob.key
+      end
+      ActiveStorage::Blob.service.expects(:delete).with { |key| key == new_key }
+      assert_no_difference [ "Account.count", "User.count", "Card.count", "ActiveStorage::Blob.count" ] do
+        assert_raises(Account::DataTransfer::InvalidArchive) { restorer.restore }
+      end
+    end
+  end
+
+
+  test "missing record files are detected before creating an account" do
+    with_archive do |zip|
+      paths = zip.paths.without("records/cards/#{@card.id}.json")
+      zip.stubs(:paths).returns(paths)
+      assert_no_difference "Account.count" do
+        error = assert_raises(Account::DataTransfer::InvalidArchive) do
+          Account::DataTransfer::Restorer.new(zip, identity: identities(:david)).restore
+        end
+        assert_match(/incomplete/, error.message)
+      end
+    end
+  end
+
+  private
+    def with_archive(user: nil)
+      Tempfile.create("archive", binmode: true) do |file|
+        writer = ZipFile::Writer.new(file)
+        Account::DataTransfer::Archive.new(@account, user: user).export(writer)
+        writer.close
+        file.rewind
+        yield ZipFile::Reader.new(file)
+      end
+    end
+end
