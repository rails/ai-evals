diff --git a/saas/test/controllers/card/billing_test.rb b/saas/test/controllers/card/billing_test.rb
new file mode 100644
index 0000000..a9d859d
--- /dev/null
+++ b/saas/test/controllers/card/billing_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Card::BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.override_usage(card_count: 1000)
+  end
+
+  test "API creation is refused at the limit" do
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Over quota" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "drafting is allowed but publishing is refused" do
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    assert_response :redirect
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+  test "draft view replaces publishing buttons with an upgrade pitch" do
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "strong", text: /Your draft is saved/
+  end
+
+  test "warning counts down from 100 remaining cards" do
+    @account.override_usage(card_count: 950)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :success
+    assert_select "aside[role=status]", text: /50 cards left/
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "last free card can be published" do
+    @account.override_usage(card_count: 999)
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid accounts can publish above the free quota" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", status: "active", plan_key: "unlimited")
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+
+  test "paid API creation uses the paid storage allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", status: "active", plan_key: "unlimited")
+    @account.override_usage(bytes_used: 4.gigabytes)
+    @account.update_column(:cards_count, 100)
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+      params: { card: { title: "Paid card" } }, as: :json
+    assert_response :created
+
+    @account.override_usage(bytes_used: 5.gigabytes + 1)
+    post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+      params: { card: { title: "Over storage" } }, as: :json
+    assert_response :forbidden
+  end
+
+  test "column create buttons become upgrade links" do
+    get board_path(boards(:miltons_wish_list), script_name: @account.slug)
+    assert_response :success
+    assert_select ".board-tools" do
+      assert_select "a", text: "Upgrade"
+      assert_select "button", text: /Add a card/, count: 0
+    end
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..bf2d99e
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    WebMock.disable_net_connect!
+    ENV.stubs(:fetch).with("STRIPE_WEBHOOK_SECRET").returns("whsec_test")
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_test")
+    Plan.find("unlimited").stubs(:stripe_price_id).returns("price_unlimited")
+    Plan.find("unlimited_plus").stubs(:stripe_price_id).returns("price_plus")
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  test "signed subscription changes activate upgrade and cancel plans" do
+    deliver "customer.subscription.created", status: "active", price: "price_unlimited"
+    assert_equal "Unlimited", @account.reload.billing_plan.name
+    assert_equal 5.gigabytes, @account.storage_limit
+    deliver "customer.subscription.updated", status: "active", price: "price_plus"
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+    deliver "customer.subscription.deleted", status: "canceled", price: "price_plus"
+    assert_equal "Free", @account.reload.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "duplicate and stale notifications read current state" do
+    2.times { deliver "customer.subscription.updated", status: "active", price: "price_plus" }
+    deliver "customer.subscription.created", status: "canceled", price: "price_plus"
+    assert_equal "Free", @account.reload.billing_plan.name
+    assert_equal 1, @account.subscription.class.where(account_id: @account.id).count
+  end
+
+  test "unknown customers and irrelevant events are acknowledged without changing accounts" do
+    Stripe::Subscription.expects(:retrieve).never
+    post_event(type: "customer.subscription.updated", customer: "cus_other")
+    assert_response :ok
+    post_event(type: "invoice.paid")
+    assert_response :ok
+    assert_not @subscription.reload.active?
+  end
+
+  test "invalid signatures are refused" do
+    untenanted do
+      post saas.stripe_webhooks_path, params: "{}", headers: { "Stripe-Signature" => "bad", "Content-Type" => "application/json" }
+    end
+    assert_response :bad_request
+    assert_not @subscription.reload.active?
+  end
+
+  test "unrecognized prices do not grant paid privileges" do
+    deliver "customer.subscription.updated", status: "active", price: "price_unknown"
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "failed Stripe reads are retryable and do not change allowances" do
+    Stripe::Subscription.expects(:retrieve).raises(Stripe::APIConnectionError.new("Unavailable"))
+    post_event(type: "customer.subscription.updated")
+    assert_response :service_unavailable
+    assert_equal "Free", @account.reload.billing_plan.name
+  end
+
+  test "old subscriptions cannot replace a newer subscription" do
+    @subscription.update!(stripe_subscription_id: "sub_new", status: "active", plan_key: "unlimited_plus")
+    Stripe::Subscription.expects(:retrieve).never
+    post_event(type: "customer.subscription.deleted")
+    assert_response :ok
+    assert_equal "sub_new", @subscription.reload.stripe_subscription_id
+    assert_equal "Unlimited+", @account.reload.billing_plan.name
+  end
+
+  test "tampered signed bodies are rejected" do
+    timestamp = Time.now.to_i
+    signature = OpenSSL::HMAC.hexdigest("SHA256", "whsec_test", "#{timestamp}.{}")
+    untenanted do
+      post saas.stripe_webhooks_path, params: '{"changed":true}',
+        headers: { "Stripe-Signature" => "t=#{timestamp},v1=#{signature}", "Content-Type" => "application/json" }
+    end
+    assert_response :bad_request
+  end
+
+  private
+    def deliver(type, status:, price:)
+      Stripe::Subscription.expects(:retrieve).with("sub_test").returns(Stripe::Subscription.construct_from(
+        id: "sub_test", customer: "cus_test", status: status, cancel_at: nil,
+        items: { data: [ { price: { id: price }, current_period_end: 1.month.from_now.to_i } ] }
+      ))
+      post_event(type: type)
+      assert_response :ok
+    end
+
+    def post_event(type:, customer: "cus_test")
+      payload = { id: "evt_test", object: "event", type: type, data: { object: { id: "sub_test", customer: customer } } }.to_json
+      timestamp = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", "whsec_test", "#{timestamp}.#{payload}")
+      untenanted do
+        post saas.stripe_webhooks_path, params: payload,
+          headers: { "Stripe-Signature" => "t=#{timestamp},v1=#{signature}", "Content-Type" => "application/json" }
+      end
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..6efb683
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  test "free allowance and warning boundaries" do
+    account = accounts(:initech)
+    assert_equal "Free", account.billing_plan.name
+    assert_equal 1.gigabyte, account.storage_limit
+
+    account.override_usage(card_count: 899)
+    assert_not account.nearing_card_limit?
+    account.override_usage(card_count: 900)
+    assert account.nearing_card_limit?
+    assert_equal 100, account.cards_remaining
+    account.override_usage(card_count: 950)
+    assert_equal 50, account.cards_remaining
+    account.override_usage(card_count: 1000)
+    assert account.exceeding_card_limit?
+    account.override_usage(card_count: 1001)
+    assert_equal 0, account.cards_remaining
+  end
+
+  test "drafts do not consume the published card allowance" do
+    account = accounts(:initech)
+    assert_equal account.cards.published.count, account.card_count
+    account.update_column(:cards_count, 100)
+    assert_no_difference -> { account.card_count } do
+      account.cards.create!(board: boards(:miltons_wish_list), creator: users(:mike), status: :drafted)
+    end
+  end
+  test "paid and comped plans have unlimited cards and their own storage" do
+    account = accounts(:initech)
+    account.override_usage(card_count: 10_000)
+    account.comp
+    assert_not account.exceeding_card_limit?
+    assert_not account.nearing_card_limit?
+    assert_equal 5.gigabytes, account.storage_limit
+    account.uncomp
+    assert account.exceeding_card_limit?
+
+    subscription = account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited", status: "active")
+    assert_nil account.cards_remaining
+    assert_equal 5.gigabytes, account.storage_limit
+    subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, account.storage_limit
+    subscription.update!(status: "canceled")
+    assert account.exceeding_card_limit?
+    assert_equal 1.gigabyte, account.storage_limit
+  end
+
+  test "usage overrides support zero and blank fields and reset restores measured usage" do
+    account = accounts(:initech)
+    measured_count, measured_bytes = account.card_count, account.bytes_used
+    account.override_usage(card_count: 0, bytes_used: 0)
+    assert_equal 0, account.card_count
+    assert_equal 0, account.bytes_used
+    account.override_usage(card_count: "", bytes_used: 123)
+    assert_equal measured_count, account.card_count
+    assert_equal 123, account.bytes_used
+    account.reset_usage_override
+    assert_nil account.overridden_limits
+    assert_equal measured_count, account.card_count
+    assert_equal measured_bytes, account.bytes_used
+  end
+
+  test "comp does not downgrade a paid plan and storage exceptions remain effective" do
+    account = accounts(:initech)
+    account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited_plus", status: "active")
+    account.comp
+    assert_equal 500.gigabytes, account.storage_limit
+    account.uncomp
+    assert_equal 500.gigabytes, account.storage_limit
+    account.add_storage_exception(600.gigabytes)
+    assert_equal 600.gigabytes, account.storage_limit
+  end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..cdb5aad
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    WebMock.disable_net_connect!
+    @subscription = accounts(:initech).create_subscription!(stripe_customer_id: "cus_test")
+    @plan = Plan.find("unlimited")
+    @plan.stubs(:stripe_price_id).returns("price_unlimited")
+  end
+
+  teardown do
+    WebMock.allow_net_connect!
+  end
+
+  test "repeated checkout reuses an open session" do
+    checkout = Stripe::Checkout::Session.construct_from(id: "cs_test", url: "https://checkout.stripe.com/test", status: "open", metadata: { plan_key: @plan.key })
+    Stripe::Checkout::Session.expects(:create).once.returns(checkout)
+    assert_equal checkout.url, @subscription.checkout_url(@plan, return_url: "https://example.com/billing")
+    Stripe::Checkout::Session.expects(:retrieve).with("cs_test").returns(checkout)
+    assert_equal checkout.url, @subscription.checkout_url(@plan, return_url: "https://example.com/billing")
+  end
+
+  test "switching checkout plan expires the old open session" do
+    @subscription.update!(stripe_checkout_session_id: "cs_old")
+    Stripe::Checkout::Session.expects(:retrieve).with("cs_old").returns(
+      Stripe::Checkout::Session.construct_from(id: "cs_old", status: "open", metadata: { plan_key: "unlimited_plus" })
+    )
+    Stripe::Checkout::Session.expects(:expire).with("cs_old")
+    Stripe::Checkout::Session.expects(:create).returns(Stripe::Checkout::Session.construct_from(id: "cs_new", url: "https://checkout.stripe.com/new"))
+    assert_equal "https://checkout.stripe.com/new", @subscription.checkout_url(@plan, return_url: "https://example.com/billing")
+    assert_equal "cs_new", @subscription.reload.stripe_checkout_session_id
+  end
+
+  test "completed checkout cannot be repeated while waiting for a webhook" do
+    @subscription.update!(stripe_checkout_session_id: "cs_done")
+    Stripe::Checkout::Session.expects(:retrieve).with("cs_done").returns(Stripe::Checkout::Session.construct_from(status: "complete"))
+    Stripe::Checkout::Session.expects(:create).never
+    assert_raises ArgumentError do
+      @subscription.checkout_url(@plan, return_url: "https://example.com/billing")
+    end
+  end
+
+  test "existing subscriptions including overdue subscriptions must use the portal" do
+    Stripe::Checkout::Session.expects(:create).never
+    %w[ active trialing past_due unpaid incomplete paused ].each do |status|
+      @subscription.update!(stripe_subscription_id: "sub_test", status: status, plan_key: @plan.key)
+      assert @subscription.subscribed?
+      assert_raises ArgumentError do
+        @subscription.checkout_url(@plan, return_url: "https://example.com/billing")
+      end
+    end
+  end
+end
