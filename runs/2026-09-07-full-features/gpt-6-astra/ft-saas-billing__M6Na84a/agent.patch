@@ -0,0 +1,16 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Plan.find(params[:plan_key])
+    raise ArgumentError, "Choose a configured paid plan" if plan.free? || plan.stripe_price_id.blank?
+    url = Current.account.billing_subscription.checkout_url(plan, return_url: saas.account_billing_url)
+    redirect_to url, allow_other_host: true, status: :see_other
+  rescue KeyError
+    head :unprocessable_entity
+  rescue ArgumentError => error
+    render plain: error.message, status: :unprocessable_entity
+  rescue Stripe::StripeError
+    render plain: "Billing is temporarily unavailable. Please try again.", status: :service_unavailable
+  end
+end
