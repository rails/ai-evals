+  <h2>Current plan: <%= @account.billing_plan.name %><%= " (Comped)" if @account.comped? %></h2>
+  <p><%= number_with_delimiter(@account.card_count) %> cards · <%= number_to_human_size(@account.bytes_used) %> used of <%= number_to_human_size(@account.storage_limit) %></p>
+  <p>Free includes 1,000 cards and 1 GB of storage.</p>
+
+  <% if @account.subscription&.subscribed? %>
+    <%= button_to "Manage subscription", saas.account_billing_portal_path, class: "btn", data: { turbo: false } %>
+  <% else %>
+    <% Plan.paid.each do |plan| %>
+      <section class="margin-block">
+        <h3><%= plan.name %> — $<%= plan.price %>/month</h3>
+        <p>Unlimited cards · <%= number_to_human_size(plan.storage_limit) %> storage</p>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_billing_checkout_path, params: { plan_key: plan.key }, class: "btn btn--link", data: { turbo: false } %>
+      </section>
+    <% end %>
+    <% if @account.subscription %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn", data: { turbo: false } %>
+    <% end %>
+  <% end %>
+  <p><%= link_to "Account settings", main_app.account_settings_path %></p>
+</section>
