diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..2fe02d1
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,73 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  def self.process_event(event)
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      object = event.data.object
+      if subscription = find_by(stripe_customer_id: object.customer)
+        subscription.with_lock do
+          # Read Stripe's current state under the lock, rather than replaying a stale
+          # event payload. Redeliveries and out-of-order updates are harmless.
+          unless subscription.subscribed? && subscription.stripe_subscription_id != object.id
+            subscription.synchronize(Stripe::Subscription.retrieve(object.id))
+          end
+        end
+      end
+    end
+  end
+
+  def active?
+    status.in?(%w[ active trialing ]) && Plan::PLANS.key?(plan_key) && !Plan.find(plan_key).free?
+  end
+
+  def subscribed?
+    stripe_subscription_id.present? && !status.in?(%w[ canceled incomplete_expired ])
+  end
+
+  def checkout_url(plan, return_url:)
+    raise ArgumentError, "Choose a paid plan" if plan.free? || plan.stripe_price_id.blank?
+    with_lock do
+      raise ArgumentError, "Use the customer portal to change your subscription" if subscribed?
+
+      if stripe_checkout_session_id
+        checkout = Stripe::Checkout::Session.retrieve(stripe_checkout_session_id)
+        raise ArgumentError, "Your checkout is complete. Waiting for subscription confirmation." if checkout.status == "complete"
+
+        if checkout.status == "open" && checkout.metadata.plan_key != plan.key
+          Stripe::Checkout::Session.expire(checkout.id)
+          checkout = nil
+        end
+      end
+
+      unless checkout&.status == "open"
+        checkout = Stripe::Checkout::Session.create(
+          customer: stripe_customer_id,
+          mode: "subscription",
+          line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+          success_url: return_url,
+          cancel_url: return_url,
+          client_reference_id: account_id,
+          metadata: { plan_key: plan.key }
+        )
+        update! stripe_checkout_session_id: checkout.id
+      end
+      checkout.url
+    end
+  end
+
+  def portal_url(return_url:)
+    Stripe::BillingPortal::Session.create(customer: stripe_customer_id, return_url: return_url).url
+  end
+
+  def synchronize(remote)
+    item = remote.items.data.first
+    plan = Plan.for_price(item&.price&.id)
+    update! stripe_subscription_id: remote.id, status: remote.status, plan_key: plan&.key,
+      current_period_end: timestamp(item&.current_period_end), cancel_at: timestamp(remote.cancel_at), stripe_checkout_session_id: nil
+  end
+
+  private
+    def timestamp(value)
+      Time.at(value).utc if value
+    end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..b3ee8db
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,33 @@
+class Plan
+  attr_reader :key, :name, :price, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:)
+    @key, @name, @price, @card_limit, @storage_limit = key, name, price, card_limit, storage_limit
+  end
+
+  PLANS = [
+    new(key: "free", name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+    new(key: "unlimited", name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes),
+    new(key: "unlimited_plus", name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes)
+  ].index_by(&:key).freeze
+
+  def self.find(key)
+    PLANS.fetch(key)
+  end
+
+  def self.paid
+    PLANS.values.reject(&:free?)
+  end
+
+  def self.for_price(price_id)
+    paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+  end
+
+  def free?
+    price.zero?
+  end
+
+  def stripe_price_id
+    ENV["STRIPE_#{key.upcase}_PRICE_ID"]
+  end
+end
