diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..e32cc65
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,14 @@
+# Stripe authenticates these untenanted requests with a signature, not a session.
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    Account::Subscription.process_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  rescue Stripe::StripeError
+    head :service_unavailable
+  end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..ac3991c
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,70 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :overridden_limits, class_name: "Account::OverriddenLimits", dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Plan.find(subscription.plan_key)
+    elsif comped?
+      Plan.find("unlimited")
+    else
+      Plan.find("free")
+    end
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def cards_remaining
+    [ billing_plan.card_limit - card_count, 0 ].max if billing_plan.card_limit
+  end
+
+  def exceeding_card_limit?
+    cards_remaining == 0
+  end
+
+  def nearing_card_limit?
+    cards_remaining&.between?(1, 100) || false
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def override_usage(attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_usage_override
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def billing_subscription
+    subscription || with_lock do
+      reload_subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create(
+        { name: name, email: Current.identity.email_address, metadata: { account_id: id } },
+        { idempotency_key: "fizzy-account-#{id}" }
+      ).id)
+    end
+  end
+end
