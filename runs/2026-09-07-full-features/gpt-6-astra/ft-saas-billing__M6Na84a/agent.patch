@@ -0,0 +1,20 @@
+module Card::BillingLimited
+  extend ActiveSupport::Concern
+
+  private
+    def within_card_limit
+      Current.account.with_lock do
+        ensure_within_card_limit
+        yield unless performed?
+      end
+    end
+
+    def ensure_within_card_limit
+      if Current.account.exceeding_card_limit?
+        respond_to do |format|
+          format.html { render plain: "Upgrade to publish more cards. Your draft is saved.", status: :forbidden }
+          format.json { render json: { error: "Card limit reached. Upgrade to publish more cards." }, status: :forbidden }
+        end
+      end
+    end
+end
