diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..54a33fa
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,55 @@
+# Single-server, SQLite deployment. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: your-github-user/fizzy
+
+servers:
+  web:
+    - &hostname fizzy.example.com
+
+# Point this hostname at the server and open ports 80 and 443.
+# Kamal Proxy terminates TLS; Thruster serves the app over HTTP on port 80.
+proxy:
+  ssl: true
+  host: *hostname
+  app_port: 80
+
+registry:
+  server: ghcr.io
+  username: your-github-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+env:
+  clear:
+    APP_FQDN: *hostname
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Conservative defaults for a small box; increase as resources permit.
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: *hostname
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# All SQLite databases (primary, queue, cache, cable) and uploaded files.
+# Keep this volume name stable across deploys. A volume is not a backup!
+volumes:
+  - fizzy_storage:/rails/storage
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
