new file mode 100644
index 0000000..39f7191
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,23 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publish
+    with_lock do
+      update! public_key: SecureRandom.base58(24) unless published?
+    end
+  end
+
+  def unpublish
+    with_lock do
+      update! public_key: nil
+    end
+  end
+end
