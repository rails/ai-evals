+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards start unpublished" do
+    assert_nil @board.public_key
+    assert_not @board.published?
+    assert_not_includes Board.published, @board
+  end
+
+  test "publishing generates a stable secret until revoked" do
+    @board.publish
+    key = @board.public_key
+
+    assert_match(/\A[1-9A-HJ-NP-Za-km-z]{24}\z/, key)
+    assert @board.published?
+    assert_includes Board.published, @board
+
+    @board.publish
+    assert_equal key, @board.reload.public_key
+
+    @board.unpublish
+    assert_nil @board.reload.public_key
+    assert_not @board.published?
+
+    @board.unpublish
+    assert_not @board.published?
+
+    @board.publish
+    assert_not_equal key, @board.reload.public_key
+  end
+
+  test "publishing separate boards creates distinct keys" do
+    @board.publish
+    boards(:private).publish
+
+    assert_not_equal @board.public_key, boards(:private).public_key
+  end
+end
