index 0000000..0b8fc8f
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "boards have no public URL by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "admins can publish and unpublish" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :success
+    assert @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_equal public_board_url(@board.public_key), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+  end
+  test "publication changes invalidate cached board JSON" do
+    original_cache = Rails.cache
+    original_perform_caching = ApplicationController.perform_caching
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ApplicationController.perform_caching = true
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+    etag = response.headers["ETag"]
+
+    post board_publication_path(@board), as: :json
+    get board_path(@board), headers: { "If-None-Match" => etag }, as: :json
+    assert_response :success
+    assert_equal public_board_url(@board.reload.public_key), response.parsed_body["public_url"]
+    etag = response.headers["ETag"]
+
+    delete board_publication_path(@board), as: :json
+    get board_path(@board), headers: { "If-None-Match" => etag }, as: :json
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  ensure
+    Rails.cache = original_cache
+    ApplicationController.perform_caching = original_perform_caching
+  end
+
+  test "members including the creator cannot publish or unpublish" do
+    [ :jz, :david ].each do |user|
+      logout_and_sign_in_as user
+
+      post board_publication_path(@board), as: :json
+      assert_response :forbidden
+      assert_not @board.reload.published?
+
+      @board.publish
+      key = @board.public_key
+
+      delete board_publication_path(@board), as: :json
+      assert_response :forbidden
+      assert_equal key, @board.reload.public_key
+
+      @board.unpublish
+    end
+  end
+
+  test "HTML requests redirect to board settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "publication requires authentication" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish boards in another account" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..5960a04
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.public_key
+    @card = cards(:logo)
+    @column = columns(:writebook_triage)
+  end
+
+  test "anyone with the key can browse a board and its columns and cards" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, @column), text: @column.name
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_select "turbo-cable-stream-source", count: 0
+    assert_equal "no-store", response.headers["Cache-Control"]
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_equal "none", response.headers["X-Robots-Tag"]
+
+    get public_board_column_path(@key, @column)
+    assert_response :success
+    assert_select "h2", text: @column.name
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:text)), count: 0
+
+    get public_board_card_path(@key, @card)
+    assert_response :success
+    assert_select "h2", text: @card.title
+    assert_select "a[href=?]", public_board_path(@key), text: @board.name
+    assert_select "form", count: 0
+  end
+
+  test "published card descriptions are rendered without authentication" do
+    @card.update! description: "<p>Public card details</p>"
+
+    get public_board_card_path(@key, @card)
+
+    assert_response :success
+    assert_select ".rich-text-content p", text: "Public card details"
+  end
+
+  test "unpublishing immediately revokes access" do
+    get public_board_path(@key)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    @board.unpublish
+
+    get public_board_path(@key), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "drafts are neither listed nor directly accessible" do
+    @card.drafted!
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, @card), count: 0
+
+    get public_board_column_path(@key, @column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, @card), count: 0
+
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "cards and columns must belong to the published board" do
+    private_board = boards(:private)
+    private_board.publish
+
+    get public_board_card_path(private_board.public_key, @card)
+    assert_response :not_found
+
+    get public_board_column_path(private_board.public_key, @column)
+    assert_response :not_found
+  end
+
+  test "published boards are scoped to the account" do
+    other_board = boards(:miltons_wish_list)
+    other_board.publish
+
+    get public_board_path(other_board.public_key)
+    assert_response :not_found
+  end
+
+  test "invalid keys and board IDs do not grant public access" do
+    [ "unknown", @board.id ].each do |key|
+      get public_board_path(key)
+      assert_response :not_found
+    end
+  end
+
+  test "unpublishing revokes the board and all nested URLs even after republishing" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "a signed in user from another account can browse with the key" do
+    sign_in_as :mike
+
+    get public_board_path(@key)
+    assert_response :success
+
+    get public_board_card_path(@key, @card)
+    assert_response :success
+  end
+
+  test "private boards can be explicitly published without changing membership" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.public_key)
+    assert_response :success
+    assert_not board.reload.all_access?
+  end
+end
