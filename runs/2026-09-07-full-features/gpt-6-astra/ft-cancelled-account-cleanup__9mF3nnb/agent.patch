diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..52c008d 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,57 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if self.class.due_for_incineration.exists?(id)
+        Current.with_account(self) do
+          incinerate_unscoped_records
+          incinerate_account_records
+          delete
+        end
+      end
+    end
+  end
+
+  private
+    def incinerate_unscoped_records
+      # These records have no account_id: storage totals,
+      # and SQLite's full-text index (removed by Search::Record's callbacks).
+      ::Storage::Total.where(owner: self).or(::Storage::Total.where(owner: boards)).delete_all
+      Search::Record.for(id).where(account_id: id).find_each(&:destroy!)
+    end
+
+    def incinerate_account_records
+      # Delete directly to avoid callbacks creating new records or jobs for an
+      # account that no longer exists. Include framework and SaaS tables too.
+      self.class.connection_pool.with_connection do |connection|
+        account_id = connection.quote(self.class.type_for_attribute("id").serialize(id))
+
+        # Filter join tables, including legacy ones, must be cleared before filters.
+        filters = Filter.where(account_id: id).select(:id).to_sql
+        connection.tables.each do |table|
+          if connection.schema_cache.columns_hash(table).key?("filter_id")
+            connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE filter_id IN (#{filters})"
+          end
+        end
+
+        connection.tables.each do |table|
+          if connection.schema_cache.columns_hash(table).key?("account_id")
+            connection.delete "DELETE FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id}"
+          end
+        end
+      end
+    end
 end
