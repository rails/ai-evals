diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..b7d3638
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.reset
+  end
+
+  test "incinerates all data belonging to accounts cancelled more than 30 days ago" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    Current.with_account(@account) do
+      cards(:logo).image.attach io: StringIO.new("image"), filename: "image.png", content_type: "image/png"
+      ActiveStorage::VariantRecord.create!(blob: cards(:logo).image.blob, variation_digest: "variant")
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt", content_type: "text/plain")
+      cards(:logo).update!(description: "Account data to incinerate")
+      comments(:logo_agreement_jz).reindex
+      @account.materialize_storage
+      boards(:writebook).materialize_storage
+    end
+    search_record_ids = Search::Record.for(@account.id).where(account_id: @account.id).ids
+    assert_not_empty search_record_ids
+    assert_not_empty account_data_counts(@account)
+    accounts(:initech).materialize_storage
+    accounts(:initech).users.create!(name: "David", identity: identities(:david))
+    other_account_data = account_data_counts(accounts(:initech))
+    identity_ids = Identity.ids
+    storage_total_ids = Storage::Total.where(owner: @account).or(Storage::Total.where(owner: @account.boards)).ids
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_empty account_data_counts(@account)
+    assert_not Storage::Total.exists?(id: storage_total_ids)
+    if ApplicationRecord.connection.adapter_name == "SQLite"
+      assert_not Search::Record::SQLite::Fts.exists?(rowid: search_record_ids)
+    end
+    assert Storage::Total.exists?(owner: accounts(:initech))
+    assert_equal other_account_data, account_data_counts(accounts(:initech))
+    assert_equal identity_ids.sort, Identity.ids.sort
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "retains accounts cancelled less than 30 days ago or exactly 30 days ago" do
+    freeze_time do
+      @account.create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago)
+      accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 30.days.ago + 1.second)
+
+      assert_no_difference "Account.count" do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "incinerates accounts just beyond the grace period and can run repeatedly" do
+    freeze_time do
+      @account.create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago - 1.second)
+      accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 31.days.ago)
+
+      assert_difference "Account.count", -2 do
+        Account::IncinerateDueJob.perform_now
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "retains reactivated accounts" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "removes filter join rows including legacy associations" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    filter = filters(:jz_assignments)
+    filter.board_ids = [ boards(:writebook).id ]
+    filter.tags << tags(:mobile)
+    filter.assignees << users(:jz)
+    filter.creators << users(:david)
+    filter.closers << users(:kevin)
+    connection = ApplicationRecord.connection
+    filter_id = connection.quote(Filter.type_for_attribute("id").serialize(filter.id))
+    user_id = connection.quote(User.type_for_attribute("id").serialize(users(:david).id))
+    connection.insert "INSERT INTO assigners_filters (filter_id, assigner_id) VALUES (#{filter_id}, #{user_id})"
+
+    Account::IncinerateDueJob.perform_now
+
+    connection.tables.each do |table|
+      if connection.columns(table).any? { |column| column.name == "filter_id" }
+        assert_equal 0, connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE filter_id = #{filter_id}"), table
+      end
+    end
+  end
+
+  test "rechecks eligibility when an account was reactivated after selection" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    selected_account = Account.due_for_incineration.find(@account.id)
+    @account.reactivate
+
+    assert_no_difference "Account.count" do
+      selected_account.incinerate
+    end
+  end
+
+  test "rolls back data deletion if incineration fails" do
+    @account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    original_data = account_data_counts(@account)
+    @account.stubs(:delete).raises(ActiveRecord::StatementInvalid)
+
+    assert_raises ActiveRecord::StatementInvalid do
+      @account.incinerate
+    end
+
+    assert Account.exists?(@account.id)
+    assert_equal original_data, account_data_counts(@account)
+  end
+
+  private
+    def account_data_counts(account)
+      connection = ApplicationRecord.connection
+      connection.tables.each_with_object({}) do |table, counts|
+        if connection.columns(table).any? { |column| column.name == "account_id" }
+          count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(Account.type_for_attribute("id").serialize(account.id))}")
+          counts[table] = count if count.positive?
+        end
+      end
+    end
+end
