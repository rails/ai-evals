+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    visit new_session_path(script_name: nil)
+    # A shared cached page can contain a timezone different from the viewer's.
+    page.execute_script <<~JS
+      let timezone = document.querySelector('meta[name="timezone"]')
+      if (!timezone) {
+        timezone = document.createElement("meta")
+        timezone.name = "timezone"
+        document.head.append(timezone)
+      }
+      timezone.content = "UTC"
+    JS
+    page.driver.browser.execute_async_script <<~JS
+      const done = arguments[0]
+      import("helpers/local_time_helpers").then(module => {
+        window.formatLocalTime = module.formatLocalTime
+        done()
+      })
+    JS
+  end
+
+  test "relative times use the viewer's calendar days" do
+    in_timezone "America/Los_Angeles" do
+      now = "2026-09-17T22:42:00Z"
+      assert_format "1:42 PM", "2026-09-17T20:42:00Z", now: now
+      assert_format "yesterday", "2026-09-17T06:42:00Z", now: now
+      assert_format "5 days ago", "2026-09-12T20:42:00Z", now: now
+      assert_format "Sep 10", "2026-09-10T20:42:00Z", now: now
+      assert_format "tomorrow", "2026-09-18T08:00:00Z", now: now
+      assert_format "in 3 days", "2026-09-20T20:42:00Z", now: now
+      assert_format "Sep 17, 2025", "2025-09-17T20:42:00Z", now: now
+      assert_format "Sep 17", "2026-09-18T01:00:00Z", format: "date", now: now
+      assert_format "Thursday, September 17", "2026-09-18T01:00:00Z", format: "long-date", now: now
+      assert_format "Sep 17, 2026", "2026-09-18T01:00:00Z", format: "date-year", now: now
+      assert_format "Sep 17, 2026, 6:00 PM", "2026-09-18T01:00:00Z", format: "datetime", now: now
+    end
+
+    in_timezone "Asia/Tokyo" do
+      assert_format "5:42 AM", "2026-09-17T20:42:00Z", now: "2026-09-17T22:42:00Z"
+      assert_format "Sep 18", "2026-09-18T01:00:00Z", format: "date", now: "2026-09-17T22:42:00Z"
+    end
+  end
+
+  test "relative days survive midnight, month and year boundaries and DST" do
+    in_timezone "America/New_York" do
+      assert_format "yesterday", "2026-03-08T04:59:00Z", now: "2026-03-08T05:01:00Z"
+      assert_format "tomorrow", "2026-03-09T04:01:00Z", now: "2026-03-08T05:01:00Z"
+      assert_format "2 days ago", "2026-03-07T17:00:00Z", now: "2026-03-09T16:00:00Z"
+      assert_format "12:01 AM", "2026-11-01T04:01:00Z", now: "2026-11-02T04:59:00Z"
+      assert_format "yesterday", "2026-11-01T04:01:00Z", now: "2026-11-02T05:01:00Z"
+      assert_format "2 days ago", "2026-10-31T16:00:00Z", now: "2026-11-02T17:00:00Z"
+      assert_format "yesterday", "2025-12-31T23:00:00Z", now: "2026-01-01T17:00:00Z"
+      assert_format "tomorrow", "2026-10-01T16:00:00Z", now: "2026-09-30T16:00:00Z"
+      assert_format "12:00 AM", "2026-09-17T04:00:00Z", format: "time"
+      assert_format "12:00 PM", "2026-09-17T16:00:00Z", format: "time"
+    end
+  end
+
+  test "new and updated time elements are rendered locally, including after reconnection" do
+    in_timezone "America/Los_Angeles" do
+      page.execute_script <<~JS
+        document.body.insertAdjacentHTML("beforeend", '<time id="test-time" datetime="2026-09-17T20:42:00Z" data-controller="local-time" data-local-time-format-value="time"></time>')
+      JS
+      assert_selector "#test-time", text: "1:42 PM"
+      assert_equal "Sep 17, 2026, 1:42 PM", find("#test-time")[:title]
+
+      page.execute_script 'document.querySelector("#test-time").setAttribute("datetime", "2026-09-17T21:42:00Z")'
+      assert_selector "#test-time", text: "2:42 PM"
+
+      page.execute_script 'window.savedTime = document.querySelector("#test-time"); savedTime.remove()'
+      assert_no_selector "#test-time"
+      page.execute_script "document.body.append(window.savedTime)"
+      assert_selector "#test-time", text: "2:42 PM"
+
+      page.execute_script 'document.querySelector("#test-time").dataset.localTimeFormatValue = "date-year"'
+      assert_selector "#test-time", text: "Sep 17, 2026"
+    end
+  end
+
+  test "missing or invalid timestamps do not render invalid dates" do
+    page.execute_script <<~JS
+      document.body.insertAdjacentHTML("beforeend", '<time id="invalid-time" datetime="not-a-date" data-controller="local-time"></time><time id="missing-time" data-controller="local-time"></time>')
+    JS
+    assert_selector "#invalid-time", visible: :all, text: "", exact_text: true
+    assert_selector "#missing-time", visible: :all, text: "", exact_text: true
+    assert_no_selector "#invalid-time[title]", visible: :all
+    assert_no_selector "#missing-time[title]", visible: :all
+
+    page.execute_script <<~JS
+      const time = document.querySelector("#invalid-time")
+      time.dataset.localTimeFormatValue = "date-year"
+      time.setAttribute("datetime", "2026-09-17T12:00:00Z")
+    JS
+    in_timezone "UTC" do
+      assert_selector "#invalid-time", text: "Sep 17, 2026"
+    end
+  end
+
+  test "open pages refresh relative labels and stop refreshing when removed" do
+    in_timezone "America/Los_Angeles" do
+      page.execute_script <<~JS
+        window.originalDate = Date
+        window.originalSetInterval = window.setInterval
+        window.originalClearInterval = window.clearInterval
+        window.testNow = "2026-09-17T22:42:00Z"
+        window.Date = class extends originalDate {
+          constructor(...args) { super(...(args.length ? args : [window.testNow])) }
+        }
+        window.setInterval = callback => { window.refreshTime = callback; return 12345 }
+        window.clearInterval = id => { window.clearedTimer = id }
+        document.body.insertAdjacentHTML("beforeend", '<time id="refresh-time" datetime="2026-09-17T20:42:00Z" data-controller="local-time"></time>')
+      JS
+      assert_selector "#refresh-time", text: "1:42 PM"
+      page.execute_script 'window.testNow = "2026-09-18T08:00:00Z"; window.refreshTime()'
+      assert_selector "#refresh-time", text: "yesterday"
+      page.execute_script 'document.querySelector("#refresh-time").remove()'
+      assert_no_selector "#refresh-time"
+      assert_equal 12345, page.evaluate_script("window.clearedTimer")
+    end
+  ensure
+    page.execute_script <<~JS
+      window.Date = window.originalDate
+      window.setInterval = window.originalSetInterval
+      window.clearInterval = window.originalClearInterval
+    JS
+  end
+
+  test "native stamp and share descriptions are formatted in the browser" do
+    in_timezone "America/Los_Angeles" do
+      descriptions = page.driver.browser.execute_async_script <<~JS
+        const done = arguments[0]
+        Promise.all([import("controllers/bridge/share_controller"), import("controllers/bridge/stamp_controller")]).then(([share, stamp]) => {
+          const descriptions = []
+          const attributes = {
+            "share-description": "by Jane and not assigned.",
+            "share-created-at": "2026-09-18T01:00:00Z",
+            "share-updated-at": "2026-09-19T01:00:00Z",
+            "timestamp": "2026-09-18T01:00:00Z"
+          }
+          const controller = {
+            bridgeElement: { bridgeAttribute: name => attributes[name] },
+            send: (event, data) => descriptions.push(data.description)
+          }
+          share.default.prototype.shareUrl.call(controller)
+          stamp.default.prototype.notifyBridgeOfConnect.call(controller)
+          delete attributes["share-created-at"]
+          delete attributes["share-updated-at"]
+          attributes["share-description"] = "3 open cards"
+          share.default.prototype.shareUrl.call(controller)
+          done(descriptions)
+        })
+      JS
+      assert_equal [ "Added #{bridge_date(17)} by Jane and not assigned. Updated #{bridge_date(18)}", "Sep 17, 2026", "3 open cards" ], descriptions
+    end
+  end
+
+  private
+    def bridge_date(day)
+      page.evaluate_script("window.formatLocalTime(new Date(arguments[0]), 'date')", "2026-09-#{day}T20:00:00Z")
+    end
+
+    def in_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+      yield
+    ensure
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    end
+
+    def assert_format(expected, timestamp, format: "relative", now: "2026-09-17T22:42:00Z")
+      actual = page.evaluate_script("window.formatLocalTime(new Date(arguments[0]), arguments[1], new Date(arguments[2]))", timestamp, format, now)
+      assert_equal expected, actual
+    end
+end
