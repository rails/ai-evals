diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..5ea103b
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,50 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const clockOptions = { hour: "numeric", minute: "2-digit", hour12: true }
+
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  switch (format) {
+    case "relative":
+      return relativeTime(date, now)
+    case "time":
+      return formatDate(date, clockOptions)
+    case "date":
+      return calendarDate(date, now)
+    case "date-year":
+      return formatDate(date, { month: "short", day: "numeric", year: "numeric" })
+    case "long-date":
+      return formatDate(date, { weekday: "long", month: "long", day: "numeric", ...yearOptions(date, now) })
+    case "datetime":
+      return formatDate(date, { year: "numeric", month: "short", day: "numeric", ...clockOptions })
+  }
+}
+
+function relativeTime(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return formatDate(date, clockOptions)
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days > -7) {
+    return `${-days} days ago`
+  } else {
+    return calendarDate(date, now)
+  }
+}
+
+function calendarDate(date, now) {
+  return formatDate(date, { month: "short", day: "numeric", ...yearOptions(date, now) })
+}
+
+function yearOptions(date, now) {
+  return date.getFullYear() === now.getFullYear() ? {} : { year: "numeric" }
+}
+
+function formatDate(date, options) {
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
