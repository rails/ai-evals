diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..05a57f1
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,32 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.refreshTimer = setInterval(() => this.render(), 60_000)
+    this.observer = new MutationObserver(() => this.render())
+    this.observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime" ] })
+  }
+
+  disconnect() {
+    clearInterval(this.refreshTimer)
+    this.observer.disconnect()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const timestamp = this.element.getAttribute("datetime")
+    const date = new Date(timestamp)
+
+    if (timestamp && !isNaN(date.getTime())) {
+      this.element.textContent = formatLocalTime(date, this.formatValue)
+      this.element.title = formatLocalTime(date, "datetime")
+    }
+  }
+}
