diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..fbd1091
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,11 @@
+// Read from the current page, not module-load time: Turbo can change languages.
+export function locale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key, values = {}) {
+  const catalog = JSON.parse(document.querySelector('meta[name="i18n"]').content)
+  let message = catalog[key]
+  if (typeof message === "object") message = message[values.count === 1 ? "one" : "other"]
+  return message.replace(/%\{(\w+)\}/g, (_, name) => String(values[name]))
+}
