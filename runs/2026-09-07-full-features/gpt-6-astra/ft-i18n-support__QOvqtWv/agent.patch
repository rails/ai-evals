+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  test "Turbo switches language and JavaScript dates use the selected locale" do
+    visit new_session_path(script_name: "")
+    assert_selector "h1", text: "Get into Fizzy"
+    page.execute_script("Turbo.visit(arguments[0])", new_session_path(script_name: "", locale: "ja"))
+    assert_selector "html[lang=ja]"
+    assert_selector "h1", text: "Fizzyにログイン"
+
+    sign_in_as users(:kevin)
+    visit card_path(cards(:logo))
+    assert_selector "html[lang=ja]"
+    assert_selector "meta[name=i18n]", visible: :all
+
+    page.execute_script <<~JS
+      const time = document.createElement("time")
+      time.id = "locale-time-test"
+      time.dataset.localTimeTarget = "ago"
+      time.setAttribute("datetime", Math.floor(Date.now() / 1000) - 120)
+      document.querySelector('[data-controller~="local-time"]').append(time)
+    JS
+    assert_selector "#locale-time-test", text: "2分前"
+
+    translation = page.evaluate_async_script <<~JS
+      const done = arguments[arguments.length - 1]
+      import("helpers/i18n").then(({ translate }) => done(translate("required")))
+    JS
+    assert_equal "この項目を入力してください", translation
+
+    page.execute_script("Turbo.visit(arguments[0])", card_path(cards(:logo), locale: "en"))
+    assert_selector "html[lang=en]"
+    assert_selector "[data-number-label='No.']"
+  end
+end
