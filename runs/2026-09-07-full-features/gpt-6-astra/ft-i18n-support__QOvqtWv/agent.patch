diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..2370347
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,29 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def with_locale(&action)
+      resume_session || authenticate_by_bearer_token
+      requested_locale = params[:locale]
+      if requested_locale.is_a?(String) && I18n.available_locales.map(&:to_s).include?(requested_locale)
+        session[:locale] = requested_locale
+      end
+
+      Current.locale_preference = session[:locale]
+      persist_locale_preference
+      locale = Current.identity&.locale || session[:locale] || I18n.default_locale
+      I18n.with_locale(locale) { action.call unless performed? }
+    end
+
+    def persist_locale_preference
+      if Current.identity && session[:locale].present? && I18n.available_locales.map(&:to_s).include?(session[:locale])
+        Current.identity.update!(locale: session[:locale]) unless Current.identity.locale == session[:locale]
+      end
+    end
+end
