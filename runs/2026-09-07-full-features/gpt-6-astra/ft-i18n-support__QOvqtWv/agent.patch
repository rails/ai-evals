diff --git a/app/jobs/localized_broadcast_job.rb b/app/jobs/localized_broadcast_job.rb
new file mode 100644
index 0000000..e52ddd2
--- /dev/null
+++ b/app/jobs/localized_broadcast_job.rb
@@ -0,0 +1,15 @@
+class LocalizedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError, ActiveRecord::RecordNotFound
+
+  def perform(record)
+    # Resolve the preference at delivery time, not when the update was queued.
+    I18n.with_locale(record.user.identity&.locale || I18n.default_locale) do
+      case record
+      when Notification
+        record.broadcast_prepend_to record.user, :notifications, target: "notifications"
+      when Pin
+        record.broadcast_replace_to [ record.user, :pins_tray ], partial: "my/pins/pin"
+      end
+    end
+  end
+end
