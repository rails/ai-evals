index 0000000..7ad48a4
--- /dev/null
+++ b/test/jobs/localized_broadcast_job_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class LocalizedBroadcastJobTest < ActiveJob::TestCase
+  test "broadcast resolves the recipient preference at delivery time" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.user.identity.update!(locale: :ja)
+    notification.expects(:broadcast_prepend_to).with do |*args, **options|
+      assert_equal :ja, I18n.locale
+      true
+    end
+    I18n.with_locale(:en) { LocalizedBroadcastJob.perform_now(notification) }
+    assert_equal :en, I18n.locale
+  end
+end
