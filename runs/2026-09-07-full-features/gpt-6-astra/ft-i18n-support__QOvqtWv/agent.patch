+require "test_helper"
+
+class LocalizationCatalogTest < ActiveSupport::TestCase
+  test "Japanese has all application translations and the same interpolations" do
+    %w[ui extra javascript onboarding].each do |namespace|
+      english = flatten(I18n.t(namespace, locale: :en))
+      japanese = flatten(I18n.t(namespace, locale: :ja))
+      english.each do |key, value|
+        # Japanese uses only the other plural form.
+        translated = japanese[key] || japanese[key.sub(/\.one$/, ".other")]
+        assert translated, "Missing Japanese #{namespace}.#{key}"
+        assert_equal value.scan(/%\{(.*?)\}/).flatten.sort,
+          translated.scan(/%\{(.*?)\}/).flatten.sort, "Interpolation mismatch: #{namespace}.#{key}"
+      end
+    end
+  end
+
+  test "labels in constants resolve in the current language" do
+    I18n.with_locale(:en) do
+      assert_equal "Blue", Color::COLORS.first.name
+      assert_equal "Today", TimeWindowParser.human_name_for("today")
+    end
+    I18n.with_locale(:ja) do
+      assert_equal "青", Color::COLORS.first.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "拍手", I18n.t(EmojiHelper::REACTIONS.fetch("👏"))
+    end
+  end
+
+  test "dates are Japanese and locale does not leak after exceptions" do
+    assert_raises(RuntimeError) do
+      I18n.with_locale(:ja) do
+        assert_equal "2026年01月02日", I18n.l(Time.utc(2026, 1, 2), format: :stamp)
+        assert_equal "5分", ApplicationController.helpers.distance_of_time_in_words(5.minutes)
+        raise "test"
+      end
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  private
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), result|
+        path = [ prefix, key ].compact.join(".")
+        value.is_a?(Hash) ? result.merge!(flatten(value, path)) : result[path] = value
+      end
+    end
+end
+
+class LocalizedSystemCommentTest < ActiveSupport::TestCase
+  test "system event comments localize without translating user content" do
+    Current.session = sessions(:david)
+    card = cards(:text)
+    card.toggle_assignment(users(:kevin))
+    comment = card.comments.by_system.last
+    I18n.with_locale(:ja) do
+      assert_match "担当者", comment.localized_body.to_plain_text
+      assert_no_match /assigned/, comment.localized_body.to_plain_text
+      assert_equal "システム", comment.creator.name
+    end
+    I18n.with_locale(:en) do
+      assert_match "assigned", comment.localized_body.to_plain_text
+      assert_equal "System", comment.creator.name
+    end
+  end
+end
+
+class StaticErrorLocalizationTest < ActiveSupport::TestCase
+  test "every static error page contains both languages" do
+    Rails.root.glob("public/*.html").each do |path|
+      page = Nokogiri::HTML5(path.read)
+      assert page.at_css("html[lang=en]"), path.to_s
+      japanese = page.at_css("section[lang=ja]")
+      assert japanese, path.to_s
+      assert_match /[\p{Hiragana}\p{Han}]/, japanese.text
+      assert page.at_css("a [lang=ja]"), path.to_s
+    end
+  end
+end
