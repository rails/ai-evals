diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..f5cf77f
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "default remains English and unsupported locales do not switch" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en]"
+      assert_select "h1", "Get into Fizzy"
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select "html[lang=en]"
+      get new_session_path(locale: [ "ja" ])
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "Japanese sticks in the anonymous session and is saved on sign in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_select "html[lang=ja]"
+      assert_select "h1", "Fizzyにログイン"
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+      get new_session_path
+      assert_select "html[lang=ja]"
+    end
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal :en, I18n.locale
+  end
+
+  test "authenticated preference survives a clean browser and can switch back" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+    get root_path(locale: "xx")
+    assert_select "html[lang=ja]"
+    reset!
+    sign_in_as :kevin
+    get root_path
+    follow_redirect! while response.redirect?
+    assert_select "html[lang=ja]"
+    get root_path(locale: "en")
+    assert_equal "en", identities(:kevin).reload.locale
+    assert_select "html[lang=en]"
+  end
+end
+
+class JapaneseScreensTest < ActionDispatch::IntegrationTest
+  test "authenticated screens and fragments render in Japanese" do
+    users(:david).update!(role: :admin)
+    sign_in_as :david
+    get root_path(locale: "ja")
+    draft = users(:david).draft_new_card_in(boards(:writebook))
+    paths = [
+      root_path, board_path(boards(:writebook)), edit_board_path(boards(:writebook)),
+      new_board_path, cards_path, card_path(cards(:logo)), card_draft_path(draft),
+      notifications_path, notifications_settings_path, account_settings_path,
+      account_join_code_path, user_path(users(:david)), edit_user_path(users(:david)),
+      my_menu_path, my_pins_path, my_access_tokens_path, new_my_access_token_path,
+      my_passkeys_path, search_path, board_webhooks_path(boards(:writebook)), new_board_webhook_path(boards(:writebook))
+    ]
+    paths.each do |path|
+      get path
+      follow_redirect! while response.redirect?
+      assert_response :success, "#{path}: #{response.status} #{response.body[0, 180]}"
+      assert_no_match /translation_missing|translation missing/i, response.body, path
+      assert_no_match /ui\.[a-z_]+_[0-9a-f]{6}/, Nokogiri::HTML5(response.body).text, path
+    end
+  end
+end
+
+class LocalizationEdgeCasesTest < ActionDispatch::IntegrationTest
+  test "cached card collections and ETags vary by language" do
+    sign_in_as :kevin
+    with_actionview_partial_caching do
+      get cards_path
+      assert_match "Added", response.body
+      get card_path(cards(:logo))
+      english_etag = response.headers["ETag"]
+      get card_path(cards(:logo), locale: "ja"), headers: { "If-None-Match" => english_etag }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "[data-number-label=番号]"
+      get cards_path
+      assert_no_match /\badded by\b/, response.body
+      get cards_path(locale: "en")
+      assert_match "Added", response.body
+    end
+  end
+
+  test "public boards honor the anonymous choice without shared language caches" do
+    board = boards(:writebook)
+    board.publish
+    get public_board_path(board.publication.key, locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_select "[data-column-name='未定？']"
+    assert_no_match /\bpublic\b/, response.headers["Cache-Control"]
+    get public_board_path(board.publication.key, locale: "xx")
+    assert_select "html[lang=ja]"
+  end
+
+  test "anonymous Japanese sign in email uses session locale without changing identity" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          post session_path, params: { email_address: identities(:kevin).email_address }
+        end
+      end
+      assert_match "Fizzy認証コード", ActionMailer::Base.deliveries.last.subject
+      assert_nil identities(:kevin).reload.locale
+    end
+  end
+
+  test "two people do not share locale state" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    open_session do |other|
+      other.get new_session_path(script_name: "")
+      other.assert_select "html[lang=en]"
+    end
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_equal :en, I18n.locale
+  end
+end
diff --git a/test/jobs/localized_broadcast_job_test.rb b/test/jobs/localized_broadcast_job_test.rb
