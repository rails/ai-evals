diff --git a/app/controllers/sessions/email_codes_controller.rb b/app/controllers/sessions/email_codes_controller.rb
new file mode 100644
index 0000000..dd394fa
--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,59 @@
+class Sessions::EmailCodesController < ApplicationController
+  include Joining
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+  before_action :set_email_code
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = @email_code.consume(params.expect(:code))
+      session.delete(:pending_email_code_id)
+      start_new_session_for identity
+      redirect_url = after_email_code_authentication_url(identity)
+
+      respond_to do |format|
+        format.html { redirect_to redirect_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path, alert: "That code didn’t work or has expired. Try again or request a new code." }
+        format.json { render json: { message: "That code didn’t work or has expired." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_by(id: session[:pending_email_code_id])
+      unless @email_code
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email to get a new code." }
+          format.json { render json: { message: "Enter your email to get a new code." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def after_email_code_authentication_url(identity)
+      return_to = session.delete(:email_code_return_to)
+      session.delete(:email_code_retry_url)
+
+      if join_code_attributes = session.delete(:email_code_join_code)
+        session.delete(:return_to_after_authenticating)
+        if join_code = Account::JoinCode.find_by(join_code_attributes)
+          after_join_url(identity, join_code)
+        else
+          flash[:alert] = "That join code is no longer available."
+          landing_url
+        end
+      else
+        return_to || after_authentication_url
+      end
+    end
+end
