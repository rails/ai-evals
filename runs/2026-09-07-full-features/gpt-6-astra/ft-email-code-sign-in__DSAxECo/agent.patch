--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @email_code = identities(:kevin).email_codes.create!
+    @code = @email_code.code
+  end
+
+  test "generates a six-character code stored as a digest" do
+    assert_match /\A[A-Z0-9]{6}\z/, @code
+    assert_not_equal @code, @email_code.code_digest
+    assert_in_delta 15.minutes.from_now, @email_code.expires_at, 1.second
+  end
+
+  test "accepts lowercase and surrounding whitespace, only once" do
+    assert_equal identities(:kevin), @email_code.consume(" #{@code.downcase}\n")
+    assert_nil @email_code.consume(@code)
+  end
+
+  test "valid just before fifteen minutes" do
+    travel_to @email_code.expires_at - 1.second do
+      assert_equal identities(:kevin), @email_code.consume(@code)
+    end
+  end
+
+  test "expired at fifteen minutes" do
+    travel_to @email_code.expires_at, with_usec: true do
+      assert_nil @email_code.consume(@code)
+    end
+  end
+
+  test "wrong and blank codes do not consume the code" do
+    [ "wrong!", "", nil ].each do |code|
+      assert_nil @email_code.consume(code)
+    end
+    assert_equal identities(:kevin), @email_code.consume(@code)
+  end
+
+  test "locks out after ten wrong attempts" do
+    10.times { assert_nil @email_code.consume("wrong!") }
+    assert_nil @email_code.consume(@code)
+  end
+
+  test "code cannot be used for another identity" do
+    other_code = identities(:david).email_codes.create!
+    assert_nil other_code.consume(@code)
+  end
+end
