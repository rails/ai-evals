index 0000000..4f81089
--- /dev/null
+++ b/test/controllers/sessions/email_codes_controller_test.rb
@@ -0,0 +1,236 @@
+require "test_helper"
+
+class Sessions::EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  test "sign in with an emailed code" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: " #{identities(:kevin).email_address.upcase} " }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      assert_nil cookies[:session_token]
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      assert code
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code][maxlength='6']"
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+  test "unknown emails do not create identities or send codes" do
+    untenanted do
+      assert_no_difference [ -> { Identity.count }, -> { EmailCode.count } ] do
+        post session_path, params: { email_address: "unknown@example.com" }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "verification requires a pending code in this browser" do
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "ABC123" }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "invalid and expired codes do not sign in" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      email_code = EmailCode.last
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "wrong!" }
+        assert_redirected_to new_session_email_code_path
+
+        email_code.update!(expires_at: 1.second.ago)
+        post session_email_code_path, params: { code: "ABC123" }
+        assert_redirected_to new_session_email_code_path
+      end
+      assert_nil cookies[:session_token]
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      post session_path, params: { email_address: identities(:kevin).email_address }
+      Rails.cache.stubs(:increment).returns(11)
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "ABC123" }
+      end
+      assert_response :too_many_requests
+    end
+  end
+
+  test "sign up verifies email before completing the account" do
+    untenanted do
+      assert_difference -> { Identity.count }, 1 do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: " New-Person@Example.com " } }
+        end
+      end
+      assert_redirected_to new_session_email_code_path
+      assert_nil cookies[:session_token]
+      code = delivered_code
+
+      follow_redirect!
+      assert_select "a[href=?]", new_signup_url
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to new_signup_completion_path
+      follow_redirect!
+      assert_response :success
+
+      Signup.any_instance.stubs(:skip_account_seeding).returns(true)
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      identity = Identity.find_by!(email_address: "new-person@example.com")
+      assert_equal "New Person", identity.users.sole.name
+      assert_redirected_to landing_url(script_name: identity.accounts.sole.slug)
+    end
+  end
+
+  test "join verifies email before redeeming the join code and completing profile setup" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+      perform_enqueued_jobs do
+        post join_path(code: join_code.code), params: { email_address: "new-member@example.com" }
+      end
+    end
+    code = delivered_code
+
+    untenanted do
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_response :success
+      assert_select "a[href=?]", join_url(code: join_code.code, script_name: account.slug)
+
+      assert_difference [ -> { User.count }, -> { join_code.reload.usage_count } ], 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_users_verification_url(script_name: account.slug)
+    end
+
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "New Member" } }
+    assert_redirected_to landing_path(script_name: account.slug)
+    user = Identity.find_by!(email_address: "new-member@example.com").users.sole
+    assert user.verified?
+    assert user.setup?
+  end
+
+  test "an existing member can join with email without consuming another use" do
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code), params: { email_address: identities(:kevin).email_address }
+    end
+    code = delivered_code
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url(script_name: accounts("37s").slug)
+    end
+  end
+
+  test "join codes are rechecked after email verification" do
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+    end
+    code = delivered_code
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to join_url(code: join_code.code, script_name: accounts("37s").slug)
+    end
+  end
+
+  test "JSON verification also joins and cannot be replayed" do
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }, as: :json
+    end
+    assert_response :created
+    code = delivered_code
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        post session_email_code_path, params: { code: code }, as: :json
+      end
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }, as: :json
+      end
+    end
+  end
+
+  test "sign in returns to the originally requested account page" do
+    target = boards_url(script_name: accounts("37s").slug)
+    get target
+
+    untenanted do
+      assert_redirected_to new_session_path
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to target
+    end
+  end
+
+  test "a reset join code cannot be redeemed after email verification" do
+    join_code = account_join_codes(:"37s")
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code), params: { email_address: identities(:mike).email_address }
+    end
+    code = delivered_code
+    join_code.reset
+
+    untenanted do
+      assert_no_difference [ -> { User.count }, -> { join_code.reload.usage_count } ] do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to landing_url
+    end
+  end
+
+  test "signing up with an existing email reuses the identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: identities(:kevin).email_address } }
+        end
+      end
+      post session_email_code_path, params: { code: delivered_code }
+      assert_redirected_to new_signup_completion_path
+    end
+  end
+
+  private
+    def delivered_code
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/].tap do |code|
+        assert code
+      end
+    end
+end
