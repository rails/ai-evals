diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..efd6ac8
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,32 @@
+class EmailCode < ApplicationRecord
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+  has_secure_password :code, validations: false
+
+  before_validation :generate_code, on: :create
+
+  def consume(code)
+    return if destroyed?
+
+    with_lock do
+      if expires_at > Time.current && attempts_remaining > 0
+        if authenticate_code(code.to_s.strip.upcase)
+          destroy!
+          identity
+        else
+          decrement! :attempts_remaining
+          nil
+        end
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    nil
+  end
+
+  private
+    def generate_code
+      self.code = SecureRandom.alphanumeric(6).upcase
+      self.expires_at = EXPIRATION.from_now
+    end
+end
