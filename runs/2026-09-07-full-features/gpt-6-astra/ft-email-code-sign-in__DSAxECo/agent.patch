+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <p>We sent a six-character code to <strong><%= @email_code.identity.email_address %></strong>. It works for 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code" %>
+    <%= form.text_field :code, required: true, minlength: 6, maxlength: 6, autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, class: "input txt-large full-width" %>
+
+    <%= form.submit "Continue", class: "btn btn--link center" %>
+  <% end %>
+
+  <p><%= link_to "Use another email or request a new code", session[:email_code_retry_url] || new_session_path %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
