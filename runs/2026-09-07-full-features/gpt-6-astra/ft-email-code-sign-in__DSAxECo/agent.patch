+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "delivery does not log the code" do
+    assert_equal IdentityMailer::DeliveryJob, IdentityMailer.delivery_job
+    assert_not IdentityMailer::DeliveryJob.log_arguments
+  end
+
+  test "email code appears in the subject and both message formats" do
+    mail = IdentityMailer.email_code(identities(:kevin), "ABC123")
+
+    assert_equal [ identities(:kevin).email_address ], mail.to
+    assert_includes mail.subject, "ABC123"
+    assert_includes mail.text_part.body.to_s, "ABC123"
+    assert_includes mail.html_part.body.to_s, "ABC123"
+    assert_includes mail.text_part.body.to_s, "15 minutes"
+  end
+end
