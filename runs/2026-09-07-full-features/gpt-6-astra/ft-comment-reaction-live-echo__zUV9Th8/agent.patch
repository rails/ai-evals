+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+    visit card_url(@comment.card)
+  end
+
+  test "add, cancel, add again, and remove a reaction" do
+    within "##{dom_id(@comment)} .reactions" do
+      assert_no_selector ".reaction__input"
+      click_on "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Never mind"
+      click_on "Cancel reaction"
+      assert_no_selector ".reaction__input"
+      assert_no_selector ".reactions__list .reaction"
+
+      click_on "Add a reaction"
+      assert_field "Your reaction (16 characters maximum)", with: ""
+      fill_in "Your reaction (16 characters maximum)", with: "🎉"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", text: "🎉", count: 1
+      assert_no_selector ".reaction__input"
+      assert_button "Add a reaction"
+      assert_equal "flex", find(".reactions__list .reaction").style("display")["display"]
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob
+      assert_selector ".reactions__list .reaction", count: 1
+
+      click_on "Add a reaction"
+      fill_in "Your reaction (16 characters maximum)", with: "Great work!"
+      click_on "Confirm reaction"
+      assert_selector ".reactions__list .reaction", count: 2
+      assert_no_button "Remove reaction"
+      find("button[aria-label='🎉 by #{users(:kevin).name}']").click
+      click_on "Remove reaction"
+      assert_no_selector ".reactions__list .reaction", text: "🎉"
+      assert_selector ".reactions__list .reaction", text: "Great work!"
+    end
+
+    visit card_url(@comment.card)
