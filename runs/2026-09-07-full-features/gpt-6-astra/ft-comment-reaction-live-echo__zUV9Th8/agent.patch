+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create a reaction on another person's comment" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_select "turbo-stream[action=append][target='#{ActionView::RecordIdentifier.dom_id(@comment, :reactions)}']"
+    assert_select ".reaction", text: /🎉/
+  end
+  test "cannot choose the creator or account" do
+    post card_comment_reactions_path(@comment.card, @comment), params: {
+      reaction: { content: "Nice!", creator_id: users(:jz).id, account_id: accounts(:initech).id }
+    }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal users(:kevin), @comment.reactions.last.creator
+    assert_equal @comment.account, @comment.reactions.last.account
+  end
+
+  test "rejects blank and overlong reactions without closing the input" do
+    [ "", "  ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+
+      assert_response :unprocessable_entity
+      assert_select "turbo-stream[action=update][target='#{ActionView::RecordIdentifier.dom_id(@comment, :reaction_errors)}']"
+      assert_select "turbo-stream[action=append]", count: 0
+    end
+  end
+
+  test "destroy own reaction on someone else's comment" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target='#{ActionView::RecordIdentifier.dom_id(reaction)}']"
+  end
+
+  test "cannot destroy another person's reaction even on own comment" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "Nice!", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(comment.card, comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot react to a comment on another card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot react to an inaccessible card" do
+    accesses(:writebook_kevin).destroy!
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "cannot destroy a reaction through another comment" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "renders persisted reactions and the supplied controls" do
+    @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+    get card_comment_path(@comment.card, @comment)
+
+    assert_response :success
+    assert_select ".reactions .reactions__list .reaction", text: /Nice!/
+    assert_select ".reaction__avatar[title=?]", users(:kevin).name
+    assert_select ".reactions__trigger img[src*='boost-color']"
+    assert_select ".reaction__input[maxlength='16'][required]"
+    assert_select ".reaction__submit-btn"
+    assert_select ".reaction__cancel-btn"
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
