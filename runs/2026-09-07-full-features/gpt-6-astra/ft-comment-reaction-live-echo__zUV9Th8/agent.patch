+++ b/test/models/reaction_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "emoji and short text with defaults" do
+    [ "🎉", "Great work!", "a" * 16, "🎉" * 16 ].each do |content|
+      reaction = @comment.reactions.create!(content: content)
+      assert_equal content, reaction.content
+      assert_equal Current.user, reaction.creator
+      assert_equal @comment.account, reaction.account
+    end
+  end
+
+  test "blank or overly long reactions are invalid" do
+    [ nil, "", "  ", "a" * 17, "🎉" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?, "Expected #{content.inspect} to be invalid"
+    end
+  end
+
+  test "multiple reactions by the same person" do
+    assert_difference -> { @comment.reactions.count }, 2 do
+      2.times { @comment.reactions.create!(content: "🎉") }
+    end
+  end
+
+  test "creation and removal broadcast to the card" do
+    reaction = nil
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        reaction = @comment.reactions.create!(content: "🎉")
+      end
+    end
+
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy!
+    end
+  end
+
+  test "changes invalidate the cached comment" do
+    freeze_time do
+      original_cache_key = @comment.cache_key_with_version
+      reaction = @comment.reactions.create!(content: "🎉")
+      assert_not_equal original_cache_key, @comment.reload.cache_key_with_version
+
+      travel 1.second
+      original_cache_key = @comment.cache_key_with_version
+      reaction.destroy!
+      assert_not_equal original_cache_key, @comment.reload.cache_key_with_version
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "🎉")
+    @comment.destroy!
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
