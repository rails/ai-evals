diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..f99f838
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,37 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+
+    # Associated activity (edits, steps, reactions, etc.) touches the card.
+    after_touch :touch_last_active_at, if: :last_burst_at?
+    before_update :reset_stalled_activity, if: :card_content_changed?
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def record_burst
+    update! last_burst_at: Time.current, last_active_at: Time.current
+  end
+
+  def record_comment_burst
+    if comments.by_user.where(comments: { created_at: (Time.current - auto_postpone_period / 3.0)..Time.current })
+        .group(:card_id).having("COUNT(*) >= 3 AND COUNT(DISTINCT comments.creator_id) >= 2").exists?
+      record_burst
+    end
+  end
+
+  private
+    def card_content_changed?
+      title_changed? || board_id_changed? || column_id_changed? || (association(:rich_text_description).loaded? && rich_text_description&.changed?)
+    end
+
+    def reset_stalled_activity
+      self.last_active_at = Time.current unless last_active_at_changed?
+    end
+end
