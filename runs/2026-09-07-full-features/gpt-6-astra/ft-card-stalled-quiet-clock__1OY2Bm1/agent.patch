diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..b167153
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create!(title: "Burst then silence", status: :published)
+    @card.reload
+    freeze_time
+  end
+
+  test "a burst of comments stalls after two weeks without activity" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create!(body: "Still working", creator: users(:jz))
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+  test "quiet cards without a burst do not stall" do
+    travel 3.weeks
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a burst requires at least three comments and two people" do
+    3.times { @card.comments.create!(body: "Thinking aloud", creator: users(:david)) }
+    assert_nil @card.reload.last_burst_at
+
+    @card.comments.create!(body: "Joining in", creator: users(:jz))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "two comments from two people are not a burst" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Automatic update", creator: @card.account.system_user)
+    @card.record_comment_burst
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments at the edge of a third of the board period count" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel @card.auto_postpone_period / 3
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments outside the board window do not count" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel @card.auto_postpone_period / 3 + 1.second
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the comment window falls back to the account period" do
+    @card.board.entropy.destroy!
+    @card.board.reload
+    @card.comments.create!(body: "First", creator: users(:david))
+    travel @card.account.entropy.auto_postpone_period / 3 + 1.second
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Third", creator: users(:david))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assignment is a burst but unassignment is not" do
+    @card.toggle_assignment(users(:jz))
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert @card.stalled?
+
+    burst_at = @card.last_burst_at
+    @card.toggle_assignment(users(:jz))
+    assert_not @card.reload.stalled?
+    assert_equal burst_at, @card.last_burst_at
+  end
+
+  test "reopening is a burst" do
+    @card.close
+    assert_nil @card.reload.last_burst_at
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  test "activity restarts the two week timer without requiring another burst" do
+    @card.toggle_assignment(users(:jz))
+    travel 2.weeks
+    @card.update!(title: "Work resumed")
+    assert_not @card.reload.stalled?
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    travel 1.second
+    assert @card.stalled?
+  end
+
+  test "activity before the deadline postpones stalling" do
+    @card.toggle_assignment(users(:jz))
+    travel 13.days
+    @card.touch_last_active_at
+    travel 1.day
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+    travel 13.days
+    assert @card.stalled?
+  end
+
+  test "reopening an already open card is not a burst" do
+    @card.reopen
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "edits steps and reactions reset stalled cards" do
+    @card.toggle_assignment(users(:jz))
+    activities = [
+      -> { @card.update!(description: "An update") },
+      -> { @card.steps.create!(content: "Next step") },
+      -> { @card.steps.first.update!(completed: true) },
+      -> { @card.reactions.create!(content: "Great", reacter: users(:david)) },
+      -> { @card.comments.create!(body: "An update", creator: users(:david)) },
+      -> { @card.comments.by_user.last.update!(body: "Edited update") },
+      -> { @card.comments.by_user.last.destroy! }
+    ]
+
+    activities.each do |activity|
+      travel 2.weeks
+      assert @card.reload.stalled?
+      activity.call
+      assert_not @card.reload.stalled?
+      assert_equal Time.current, @card.last_active_at
+    end
+  end
+
+  test "closed postponed and draft cards are not stalled" do
+    @card.toggle_assignment(users(:jz))
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+end
