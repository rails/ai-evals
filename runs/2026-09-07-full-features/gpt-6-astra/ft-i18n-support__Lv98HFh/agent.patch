--- /dev/null
+++ b/app/javascript/initializers/localized_validation.js
@@ -0,0 +1,14 @@
+import { t, locale } from "helpers/i18n"
+
+document.addEventListener("invalid", (event) => {
+  if (locale() !== "ja-JP") return
+
+  const input = event.target
+  if (!input.validity.customError) {
+    const message = input.validity.valueMissing ? "required" :
+      (input.type === "email" && input.validity.typeMismatch ? "invalid_email" : "invalid_value")
+    input.setCustomValidity(t(message))
+    input.addEventListener("input", () => input.setCustomValidity(""), { once: true })
+    input.addEventListener("change", () => input.setCustomValidity(""), { once: true })
+  }
+}, true)
