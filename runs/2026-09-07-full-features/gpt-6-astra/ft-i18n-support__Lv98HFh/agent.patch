@@ -6,4 +6,22 @@ if (Current.user) {
     native: true,
     preload: /\/assets\//
   })
+
+  synchronizeCacheLocale()
+}
+
+async function synchronizeCacheLocale() {
+  try {
+    const locale = document.documentElement.lang
+    const previousLocale = localStorage.getItem("fizzy-offline-locale") || "en"
+
+    if (previousLocale !== locale) {
+      Turbo.cache.clear()
+      await Turbo.offline.clearCache()
+    }
+
+    localStorage.setItem("fizzy-offline-locale", locale)
+  } catch {
+    // Offline storage may be unavailable in private or restricted browsing.
+  }
 }
