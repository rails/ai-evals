diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..100c5b3
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,36 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_current_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_current_locale(&block)
+      # Resume before other callbacks, including redirects and unauthenticated pages.
+      resume_session
+      requested_locale = supported_locale(params[:locale])
+      session[:locale] = requested_locale if requested_locale
+
+      locale = supported_locale(session[:locale]) || Current.identity&.locale || I18n.default_locale
+      if requested_locale && Current.identity
+        Current.identity.update!(locale: requested_locale)
+      end
+
+      I18n.with_locale(locale, &block)
+    end
+
+    def supported_locale(value)
+      value if value.is_a?(String) && I18n.available_locales.map(&:to_s).include?(value)
+    end
+
+    def remember_locale_for(identity)
+      if locale = supported_locale(session[:locale])
+        identity.update!(locale: locale) unless identity.locale == locale
+      else
+        session[:locale] = identity.locale if identity.locale
+      end
+      I18n.locale = identity.locale || I18n.default_locale
+    end
+end
