+require "test_helper"
+
+class LocalizedUpdatesTest < ActiveSupport::TestCase
+  test "system history is translated for the viewer and stored English is preserved" do
+    card = cards(:logo)
+    with_current_user(:kevin) do
+      card.close
+    end
+    comment = card.comments.by_system.order(:created_at).last
+    assert_match "Moved", comment.body.to_plain_text
+    I18n.with_locale(:ja) do
+      assert_match "完了", comment.localized_body.to_plain_text
+      assert_no_match "Moved", comment.localized_body.to_plain_text
+    end
+    assert_match "Moved", comment.reload.body.to_plain_text
+  end
+
+  test "notification broadcasts capture the recipient locale, not the actor locale" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.identity.update!(locale: "ja")
+    clear_enqueued_jobs
+    notification.send(:broadcast_localized_notification)
+    job = enqueued_jobs.find { it[:job] == Turbo::Streams::ActionBroadcastJob }
+    assert_equal "ja", job.fetch("locale")
+    assert_equal :en, I18n.locale
+  end
+
+  test "Japanese onboarding includes translated descriptions and attachment captions" do
+    I18n.with_locale(:ja) do
+      Current.account.setup_customer_template
+      board = Current.account.boards.last
+      assert_equal "練習用ボード", board.name
+      board.cards.each do |card|
+        assert_match(/[ぁ-んァ-ヶ一-龯]/, card.title)
+        assert_no_match(/There’s a whole|Demo of|Click the|Passkeys let|Make one called/, card.description.body.to_html)
+      end
