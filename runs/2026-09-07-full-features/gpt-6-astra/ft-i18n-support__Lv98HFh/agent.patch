diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..ade92d8
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,12 @@
+// Read on use, not module evaluation: Turbo may replace the page's locale.
+export function locale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function t(key, values = {}) {
+  const translations = JSON.parse(document.querySelector('meta[name="fizzy-translations"]').content)
+  const message = translations[key]
+  if (message === undefined) throw new Error(`Missing application translation: ${key}`)
+
+  return message.replace(/%\{(\w+)\}/g, (_, name) => String(values[name]))
+}
