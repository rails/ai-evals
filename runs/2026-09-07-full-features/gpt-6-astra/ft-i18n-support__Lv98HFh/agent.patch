diff --git a/test/controllers/locales_test.rb b/test/controllers/locales_test.rb
new file mode 100644
index 0000000..6c49e97
--- /dev/null
+++ b/test/controllers/locales_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class LocalesTest < ActionDispatch::IntegrationTest
+  test "English is the default and unsupported locales do not switch" do
+    untenanted do
+      get new_session_path
+      assert_select 'html[lang="en"]'
+      get new_session_path(locale: "xx")
+      assert_response :success
+      assert_select 'html[lang="en"]'
+    end
+  end
+
+  test "anonymous selection survives navigation and is saved at sign in" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_select 'html[lang="ja"]'
+      get new_session_path(locale: "xx")
+      assert_select 'html[lang="ja"]'
+    end
+    sign_in_as :kevin
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_equal :en, I18n.locale
+  end
+
+  test "authenticated selection persists across a clean browser sign in" do
+    sign_in_as :kevin
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+    get root_path(locale: "xx")
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select 'html[lang="ja"]'
+    reset!
+    sign_in_as :kevin
+    get root_path
+    assert_select 'html[lang="ja"]'
+    get root_path(locale: "en")
+    assert_equal "en", identities(:kevin).reload.locale
+  end
+end
diff --git a/test/integration/internationalization_test.rb b/test/integration/internationalization_test.rb
new file mode 100644
index 0000000..0fe5767
--- /dev/null
+++ b/test/integration/internationalization_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class InternationalizationTest < ActionDispatch::IntegrationTest
+  test "Japanese pages, controls and accessibility labels" do
+    sign_in_as :kevin
+    paths = [ root_path, cards_path, board_path(boards(:writebook)), edit_board_path(boards(:writebook)),
+      card_path(cards(:logo)), user_path(users(:kevin)), edit_user_path(users(:kevin)),
+      notifications_path, notifications_settings_path, account_settings_path, my_access_tokens_path,
+      my_passkeys_path, new_board_path ]
+
+    paths.each do |path|
+      get path, params: { locale: "ja" }
+      assert_response :success, path
+      assert_no_match(/translation missing/i, response.body, path)
+      assert_select "html[lang=ja]"
+      assert_select "a.header__skip-navigation", text: "メインコンテンツへスキップ"
+      # Dynamic values (names, card text) are user content, not interface strings.
+      labels = css_select("[aria-label], [title], [placeholder], [alt]").flat_map do |element|
+        %w[aria-label title placeholder alt].filter_map { element[it] }
+      end.join("\n")
+      assert_no_match(/Skip to main content|Add a card|Board settings|Sign out|Name it|Save changes/, labels, path)
+    end
+  end
+
+  test "public pages honor locale but are not shared between language preferences" do
+    boards(:writebook).publish
+    get published_board_path(boards(:writebook)), params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_no_match(/translation missing|Skip to main content/, response.body)
+    assert_includes response.headers["Cache-Control"], "private"
+  end
+
+  test "Japanese invalid selections and sign out do not leak into another request" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      get new_session_path, params: { locale: [ "ja" ] }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_equal :en, I18n.locale
+      reset!
+      get new_session_path(script_name: "")
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "Japanese signup email honors anonymous choice without changing existing identity" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      assert_match "Fizzyの認証コード", ActionMailer::Base.deliveries.last.subject
+      assert_nil identities(:kevin).reload.locale
+    end
+  end
+end
