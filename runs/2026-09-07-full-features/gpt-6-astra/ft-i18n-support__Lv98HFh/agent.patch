+require "test_helper"
+require "yaml"
+
+class TranslationsTest < ActiveSupport::TestCase
+  test "every application key has Japanese text and the same interpolation parameters" do
+    en = YAML.load_file(Rails.root.join("config/locales/en.yml")).fetch("en")
+    ja = YAML.load_file(Rails.root.join("config/locales/ja.yml")).fetch("ja")
+    compare_catalogs(en, ja)
+  end
+
+  test "Japanese dates and labels are resolved at use time" do
+    I18n.with_locale(:ja) do
+      date = Time.zone.local(2026, 1, 2, 13)
+      assert_equal "2026年1月2日", I18n.l(date, format: :stamp)
+      assert_includes I18n.l(date, format: :notification), "金曜日"
+      assert_equal "青", Color::COLORS.first.name
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "拍手", I18n.t(EmojiHelper::REACTIONS.fetch("👏"))
+      assert_equal "1人", I18n.t("ui.watchers_count", count: 1)
+      assert_equal "2人", I18n.t("ui.watchers_count", count: 2)
+    end
+    assert_equal "Blue", Color::COLORS.first.name
+    assert_equal "Today", TimeWindowParser.human_name_for("today")
+  end
+
+  test "static error pages contain both languages without ERB" do
+    Dir[Rails.root.join("public/{400,404,406-unsupported-browser,422,500}.html")].each do |path|
+      html = Nokogiri::HTML5(File.read(path))
+      assert html.at_css('[lang="ja"]'), path
+      assert_includes html.text, "Back home"
+      assert_includes html.text, "ホームに戻る"
+      assert_not_includes File.read(path), "<%"
+    end
+  end
+
+  private
+    def compare_catalogs(en, ja, prefix = "")
+      en.each do |key, value|
+        path = "#{prefix}.#{key}"
+        assert ja.key?(key), "Missing Japanese key #{path}"
+        if value.is_a?(Hash)
+          compare_catalogs(value, ja.fetch(key), path)
+        else
+          assert ja.fetch(key).present?, path
+          assert_equal value.scan(/%\{(\w+)\}/).sort, ja.fetch(key).scan(/%\{(\w+)\}/).sort, path
+        end
+      end
+    end
+end
