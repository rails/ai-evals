+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+
+  before_action :set_public_response_headers
+  before_action :set_board
+
+  layout "public"
+
+  private
+    def set_public_response_headers
+      response.headers["Referrer-Policy"] = "no-referrer"
+      no_store
+    end
+
+    def set_board
+      if Current.account.active?
+        publication = Board::Publication.find_by!(account: Current.account, key: params[:board_key] || params[:key])
+        @board = publication.board
+      else
+        head :not_found
+      end
+    end
+end
