@@ -0,0 +1,163 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+  end
+
+  test "anyone with the key can see a board and its columns and cards" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href=?]", public_board_column_path(@key, columns(:writebook_triage))
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, cards(:logo))
+
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+  end
+
+  test "drafts are never public" do
+    card = cards(:logo)
+    card.update!(status: :drafted)
+
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, card), count: 0
+
+    get public_board_column_path(@key, card.column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, card), count: 0
+
+    get public_board_card_path(@key, card)
+    assert_response :not_found
+  end
+
+  test "columns and cards must belong to the public board" do
+    other_board = boards(:private)
+    other_board.publish
+
+    get public_board_column_path(other_board.publication.key, columns(:writebook_triage))
+    assert_response :not_found
+
+    get public_board_card_path(other_board.publication.key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "invalid and revoked keys do not grant access" do
+    get public_board_path("invalid")
+    assert_response :not_found
+
+    @board.unpublish
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :not_found
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :not_found
+  end
+
+  test "keys are account scoped" do
+    boards(:miltons_wish_list).publish
+    get public_board_path(boards(:miltons_wish_list).publication.key)
+    assert_response :not_found
+  end
+
+  test "signed in visitors need not have board or account access" do
+    @board = boards(:private)
+    @board.publish
+    sign_in_as :mike
+
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+  test "public pages are read only and do not cache or share the secret URL" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_equal "none", response.headers["X-Robots-Tag"]
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+
+    patch public_board_card_path(@key, cards(:logo)), params: { card: { title: "Changed" } }
+    assert_response :not_found
+    assert_not_equal "Changed", cards(:logo).reload.title
+  end
+
+  test "republishing does not restore the old URL" do
+    @board.unpublish
+    @board.publish
+
+    get public_board_path(@key)
+    assert_response :not_found
+
+    get public_board_path(@board.publication.key)
+    assert_response :success
+  end
+
+  test "revoked pages cannot be conditionally retrieved" do
+    get public_board_path(@key)
+    etag = response.headers["ETag"]
+    @board.unpublish
+
+    get public_board_path(@key), headers: { "If-None-Match" => etag }
+    assert_response :not_found
+  end
+
+  test "public card pages render rich text without editing controls" do
+    card = cards(:logo)
+    card.update!(description: "<p>Public <strong>description</strong></p>")
+
+    get public_board_card_path(@key, card)
+    assert_response :success
+    assert_select ".card__description strong", text: "description"
+    assert_select "form, [contenteditable], turbo-cable-stream-source", count: 0
+  end
+
+  test "public board and column pagination retain their key and scope" do
+    column = columns(:writebook_triage)
+    @board.cards.insert_all! 100.times.map { |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate, account_id: @board.account_id,
+        creator_id: @board.creator_id, column_id: column.id,
+        number: 1000 + index, title: "Public card #{index}", status: "published",
+        last_active_at: Time.current
+      }
+    }
+
+    [ public_board_path(@key), public_board_column_path(@key, column) ].each do |path|
+      get path
+      assert_response :success
+      next_page = css_select("a.pagination-link").first
+      assert_not_nil next_page
+      assert_includes next_page["href"], path
+      first_page_cards = css_select("article.card a").map { |link| link["href"] }
+
+      get next_page["href"]
+      assert_response :success
+      second_page_cards = css_select("article.card a").map { |link| link["href"] }
+      assert second_page_cards.any?
+      assert_empty first_page_cards & second_page_cards
+      assert second_page_cards.all? { |href| href.start_with?(public_board_path(@key) + "/cards/") }
+    end
+  end
+
+  test "cancelled accounts cannot serve public pages" do
+    @board.account.create_cancellation!(initiated_by: users(:david))
+
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_column_path(@key, columns(:writebook_triage))
+    assert_response :not_found
+    get public_board_card_path(@key, cards(:logo))
+    assert_response :not_found
+  end
+end
