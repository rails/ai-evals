@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "publish and unpublish" do
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+
+    post board_publication_path(@board), as: :json
+    assert_response :success
+    assert @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_equal public_board_url(@board.publication.key), response.parsed_body.fetch("public_url")
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body.fetch("public_url")
+  end
+
+  test "HTML publication changes redirect to board settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+  end
+
+  test "members cannot publish even their own boards" do
+    @board.update!(creator: users(:jz))
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "members cannot unpublish" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish inaccessible boards" do
+    post board_publication_path(boards(:miltons_wish_list)), as: :json
+    assert_response :not_found
+  end
+
+  test "anonymous users cannot publish" do
+    sign_out
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "board index includes public URLs only for published boards" do
+    @board.publish
+
+    get boards_path, as: :json
+    assert_response :success
+    board_json = response.parsed_body.find { |board| board["id"] == @board.id }
+    assert_equal public_board_url(@board.publication.key), board_json.fetch("public_url")
+    private_board_json = response.parsed_body.find { |board| board["id"] == boards(:private).id }
+    assert_nil private_board_json.fetch("public_url")
+  end
+end
