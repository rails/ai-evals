@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are private by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publishing creates one publication with a secret key" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert_equal @board.account, @board.publication.account
+    assert_operator @board.publication.key.length, :>=, 24
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+      assert_equal key, @board.reload.publication.key
+    end
+  end
+
+  test "unpublishing is idempotent and republishing rotates the key" do
+    @board.publish
+    old_key = @board.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+      @board.unpublish
+    end
+    assert_not @board.published?
+
+    @board.publish
+    assert_not_equal old_key, @board.publication.key
+    assert_nil Board::Publication.find_by(key: old_key)
+  end
+
+  test "publishing and unpublishing invalidate the board cache" do
+    freeze_time do
+      original_cache_key = @board.cache_key_with_version
+      @board.publish
+      assert_not_equal original_cache_key, @board.reload.cache_key_with_version
+
+      travel 1.second
+      published_cache_key = @board.cache_key_with_version
+      @board.unpublish
+      assert_not_equal published_cache_key, @board.reload.cache_key_with_version
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy!
+    end
+  end
+
+  test "publication keys and board publications are unique" do
+    @board.publish
+    other_board = boards(:private)
+    other_board.publish
+    assert_not_equal @board.publication.key, other_board.publication.key
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      other_board.publication.update!(key: @board.publication.key)
+    end
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Board::Publication.create!(board: @board)
+    end
+  end
+end
