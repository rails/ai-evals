diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..36b7fc1
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,18 @@
+class Stripe::WebhooksController < ActionController::Base
+  # Stripe authenticates the raw body, not a session or CSRF token. Never trust
+  # account IDs from the URL or metadata to assign a subscription to a customer.
+  def create
+    event = Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"],
+      ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+
+    if event.type.in?(%w[ customer.subscription.created customer.subscription.updated customer.subscription.deleted ])
+      if subscription = Account::Subscription.find_by(stripe_customer_id: event.data.object.customer)
+        subscription.apply_stripe_event(event)
+      end
+    end
+
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..52e2912
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,68 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  class CardLimitReached < StandardError; end
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.active?
+      Account::Plan.find(subscription.plan_key) || Account::Plan::FREE
+    elsif comped?
+      Account::Plan::UNLIMITED
+    else
+      Account::Plan::FREE
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def cards_remaining
+    if limit = billing_plan.card_limit
+      [ limit - card_count, 0 ].max
+    end
+  end
+
+  def card_limit_reached?
+    cards_remaining == 0
+  end
+
+  def nearing_card_limit?
+    remaining = cards_remaining
+    remaining.present? && remaining.between?(1, 100)
+  end
+
+  def reset_overridden_limits
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def billing_subscription
+    subscription || create_subscription!
+  rescue ActiveRecord::RecordNotUnique
+    reload_subscription
+  end
+end
