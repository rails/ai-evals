diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..d629f6e
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,30 @@
+class Account::Plan
+  def self.find(key)
+    ALL.find { |plan| plan.key == key }
+  end
+
+  def self.for_stripe_price(id)
+    PAID.find { |plan| ENV[plan.stripe_price_env].present? && ENV[plan.stripe_price_env] == id }
+  end
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit, :stripe_price_env
+
+  def initialize(key, name:, price:, card_limit: nil, storage_limit:, stripe_price_env: nil)
+    @stripe_price_env = stripe_price_env
+    @key = key
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+  end
+
+  def stripe_price_id
+    ENV.fetch(stripe_price_env)
+  end
+
+  FREE = new("free", name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte).freeze
+  UNLIMITED = new("unlimited", name: "Unlimited", price: 20, storage_limit: 5.gigabytes, stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID").freeze
+  UNLIMITED_PLUS = new("unlimited_plus", name: "Unlimited+", price: 25, storage_limit: 500.gigabytes, stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID").freeze
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+  ALL = [ FREE, *PAID ].freeze
+end
