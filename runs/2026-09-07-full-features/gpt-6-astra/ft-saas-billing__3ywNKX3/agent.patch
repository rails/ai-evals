+<% @page_title = "Billing" %>
+<% content_for :header do %>
+  <h1 class="header__title">Billing</h1>
+<% end %>
+<section class="settings panel center">
+  <h2>Current plan: <%= @account.billing_plan.name %></h2>
+  <p><%= number_with_delimiter @account.card_count %> cards · <%= number_to_human_size @account.bytes_used %> used</p>
+  <p>Plan changes appear here after confirmation from Stripe.</p>
+  <% Account::Plan::ALL.each do |plan| %>
+    <section class="margin-block">
+      <h3><%= plan.name %> — <%= plan.price.zero? ? "Free" : "$#{plan.price}/month" %></h3>
+      <p><%= plan.card_limit ? number_with_delimiter(plan.card_limit) : "Unlimited" %> cards, <%= number_to_human_size plan.storage_limit %> storage</p>
+      <% unless plan.price.zero? %>
+        <%= button_to "Upgrade to #{plan.name}", saas.account_billing_path, params: { plan_key: plan.key }, class: "btn", data: { turbo: false } %>
+      <% end %>
+    </section>
+  <% end %>
+  <% if @account.subscription&.stripe_customer_id? %>
+    <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn", data: { turbo: false } %>
+  <% end %>
+</section>
