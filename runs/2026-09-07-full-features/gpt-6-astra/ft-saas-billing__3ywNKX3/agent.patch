+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  rescue_from Stripe::StripeError, KeyError do |error|
+    Rails.logger.error "Billing unavailable: #{error.class}"
+    redirect_to saas.account_billing_path, alert: "Billing is temporarily unavailable. Please try again later."
+  end
+
+  def show
+    @account = Current.account
+  end
+
+  def create
+    plan = Account::Plan::PAID.find { |candidate| candidate.key == params[:plan_key] }
+    return head :unprocessable_entity unless plan
+
+    subscription = Current.account.billing_subscription
+    if subscription.active?
+      redirect_to subscription.portal_url(return_url: saas.account_billing_url), allow_other_host: true, status: :see_other
+    else
+      redirect_to subscription.checkout_url(plan, success_url: saas.account_billing_url, cancel_url: saas.account_billing_url),
+        allow_other_host: true, status: :see_other
+    end
+  end
+end
