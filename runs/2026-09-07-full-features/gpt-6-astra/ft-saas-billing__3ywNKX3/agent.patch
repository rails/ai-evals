+module Card::BillingLimited
+  extend ActiveSupport::Concern
+
+  included do
+    around_save :enforce_billing_limit, if: -> { published? && (new_record? || status_changed?) }
+  end
+
+  private
+    def enforce_billing_limit
+      account.with_lock do
+        raise Account::Billing::CardLimitReached if account.card_limit_reached?
+        yield
+      end
+    end
+end
