diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..10457a6
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @billing_env = { "STRIPE_WEBHOOK_SECRET" => "whsec_test", "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID" => "price_plus" }
+    @original_billing_env = ENV.to_h.slice(*@billing_env.keys)
+    ENV.update(@billing_env)
+    @subscription = accounts(:"37s").create_subscription!(stripe_customer_id: "cus_test")
+  end
+
+  teardown do
+    @billing_env.each_key { |key| ENV[key] = @original_billing_env[key] }
+  end
+
+  test "signed subscription changes apply without login, including renewal and cancellation" do
+    deliver event("evt_1", "customer.subscription.created")
+    assert_response :ok
+    assert @subscription.reload.active?
+    assert_equal "unlimited", @subscription.plan_key
+    assert_equal 5.gigabytes, @subscription.account.storage_limit
+
+    upgraded = event("evt_2", "customer.subscription.updated", created: 200)
+    upgraded[:data][:object][:items][:data][0][:price][:id] = "price_plus"
+    deliver upgraded
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+    assert_equal 500.gigabytes, @subscription.account.storage_limit
+
+    deliver upgraded
+    assert_response :ok
+    deliver event("evt_old", "customer.subscription.updated", created: 100)
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+
+    deliver event("evt_3", "customer.subscription.deleted", created: 300)
+    assert_not @subscription.reload.active?
+    assert_equal 1.gigabyte, @subscription.account.storage_limit
+    deliver upgraded
+    assert_not @subscription.reload.active?
+  end
+
+  test "scheduled cancellation retains access until Stripe cancels the subscription" do
+    scheduled = event("evt_1", "customer.subscription.updated")
+    scheduled[:data][:object][:cancel_at] = 2_000_000_000
+    deliver scheduled
+    assert @subscription.reload.active?
+    assert_equal Time.at(2_000_000_000).utc, @subscription.cancel_at
+    assert_equal Time.at(2_000_000_000).utc, @subscription.current_period_end
+  end
+
+  test "past due and unpaid subscriptions fall back to free" do
+    %w[ past_due unpaid incomplete incomplete_expired paused ].each_with_index do |status, index|
+      change = event("evt_#{index}", "customer.subscription.updated", created: 100 + index)
+      change[:data][:object][:status] = status
+      deliver change
+      assert_response :ok
+      assert_not @subscription.reload.active?
+    end
+  end
+
+  test "deletion of a previous subscription cannot cancel a newer subscription" do
+    deliver event("evt_1", "customer.subscription.created")
+    deliver event("evt_2", "customer.subscription.deleted", created: 200)
+    replacement = event("evt_3", "customer.subscription.created", created: 300)
+    replacement[:data][:object][:id] = "sub_new"
+    deliver replacement
+    deliver event("evt_4", "customer.subscription.deleted", created: 400)
+    assert @subscription.reload.active?
+    assert_equal "sub_new", @subscription.stripe_subscription_id
+  end
+
+  test "invalid signatures are rejected without changing the subscription" do
+    untenanted do
+      post "/stripe/webhooks", params: event("evt_1", "customer.subscription.created").to_json,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "invalid" }
+    end
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "unknown prices do not grant paid access" do
+    unknown = event("evt_1", "customer.subscription.created")
+    unknown[:data][:object][:items][:data][0][:price][:id] = "price_unknown"
+    deliver unknown
+    assert_response :ok
+    assert_not @subscription.reload.active?
+  end
+
+  test "unknown customers and unrelated events are acknowledged without changes" do
+    unknown = event("evt_1", "customer.subscription.created")
+    unknown[:data][:object][:customer] = "cus_other"
+    deliver unknown
+    assert_response :ok
+    assert_nil @subscription.reload.status
+    deliver event("evt_2", "checkout.session.completed")
+    assert_response :ok
+    assert_nil @subscription.reload.status
+  end
+
+  private
+    def event(id, type, created: 100)
+      { id: id, object: "event", type: type, created: created, data: { object: {
+        id: "sub_test", object: "subscription", customer: "cus_test", status: "active", cancel_at: nil,
+        items: { object: "list", data: [ { price: { id: "price_unlimited" }, current_period_end: 2_000_000_000 } ] }
+      } } }
+    end
+
+    def deliver(event)
+      payload = event.to_json
+      signature = Stripe::Webhook::Signature.compute_signature(Time.current, payload, "whsec_test")
+      header = Stripe::Webhook::Signature.generate_header(Time.current, signature)
+      untenanted do
+        post "/stripe/webhooks", params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => header }
+      end
+    end
+end
