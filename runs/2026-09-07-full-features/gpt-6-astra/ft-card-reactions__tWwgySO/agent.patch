       comments(:logo_1).reactions.create!(content: "Nice!")
     end
   end
+
+  test "creating and deleting reactions invalidates the target and card caches" do
+    [ cards(:logo), comments(:logo_1) ].each do |reactable|
+      reaction = nil
+
+      assert_changes -> { reactable.reload.cache_key_with_version } do
+        assert_changes -> { reactable.card.reload.cache_key_with_version } do
+          reaction = reactable.reactions.create!(content: "Nice!")
+        end
+      end
+
+      assert_changes -> { reactable.reload.cache_key_with_version } do
+        assert_changes -> { reactable.card.reload.cache_key_with_version } do
+          reaction.destroy!
+        end
+      end
+    end
+  end
+
+  test "destroying a reactable deletes its reactions" do
+    [ comments(:logo_1), cards(:text) ].each do |reactable|
+      reaction = reactable.reactions.create!(content: "Nice!")
+      reactable.destroy!
+
+      assert_not Reaction.exists?(reaction.id)
+    end
+  end
