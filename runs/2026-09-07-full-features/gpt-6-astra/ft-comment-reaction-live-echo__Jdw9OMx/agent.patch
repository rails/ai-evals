@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+    @card = @comment.card
+  end
+
+  test "create appends a reaction with the signed in creator" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: {
+        reaction: { content: "🎉", creator_id: users(:jz).id, account_id: accounts(:initech).id }
+      }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_select "turbo-stream[action=append][target='#{dom_id(@comment, :reactions)}']"
+    assert_select ".reaction", text: /🎉/
+    assert_select "[data-reaction-creator-id-value='#{users(:kevin).id}']"
+  end
+
+  test "invalid reactions preserve the form and show an error" do
+    [ "", "   ", "x" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+      assert_select "turbo-stream[action=replace][target='#{dom_id(@comment, :new_reaction)}']"
+      assert_select "[role=alert]"
+      assert_select "form:not([hidden])"
+    end
+  end
+
+  test "destroy own reaction" do
+    reaction = @comment.reactions.create!(content: "Thanks", creator: users(:kevin))
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target='#{dom_id(reaction)}']"
+  end
+
+  test "cannot destroy someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "Thanks", creator: users(:jz))
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :forbidden
+  end
+
+  test "comment must belong to the requested card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Hi" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction must belong to the requested comment" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "Hi", creator: users(:kevin))
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "card must be accessible" do
+    @card.board.update!(all_access: false)
+    @card.board.accesses.where(user: users(:kevin)).destroy_all
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Hi" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "card shows the strip, creator and styled input" do
+    @comment.reactions.create!(content: "<b>Hi</b>", creator: users(:jz))
+    get card_path(@card)
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}" do
+      assert_select ".reaction", text: /<b>Hi<\/b>/
+      assert_select "b", count: 0
+      assert_select ".avatar[aria-label='#{users(:jz).name}']"
+    end
+    assert_select ".reactions__trigger img[src*='boost-color']"
+    assert_select "[data-reaction-form-max-length-value='16'] .reaction__input"
+  end
+end
