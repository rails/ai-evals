+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    sign_in_as users(:kevin)
+  end
+
+  test "add, cancel and remove reactions on someone else's comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)} .reactions" do
+      click_on "Add a reaction"
+      fill_in "Your reaction (16 characters max)", with: "🎉"
+      click_on "Confirm reaction"
+      assert_selector ".reaction", text: "🎉", count: 1
+      assert_no_selector ".reaction__input"
+      assert_button "Add a reaction"
+
+      click_on "Add a reaction"
+      fill_in "Your reaction (16 characters max)", with: "Never mind"
+      click_on "Cancel reaction"
+      assert_no_selector ".reaction__input"
+      assert_no_text "Never mind"
+
+      click_on "Add a reaction"
+      assert_field "Your reaction (16 characters max)", with: ""
+      fill_in "Your reaction (16 characters max)", with: "Nice!"
+      click_on "Confirm reaction"
+      assert_selector ".reaction:not(.reaction__form)", count: 2
+
+      click_on "🎉"
+      click_on "Remove reaction"
+      assert_no_text "🎉"
+      assert_text "Nice!"
+    end
+  end
+
+  test "length validation allows 16 emoji but rejects blank and overlong text" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)} .reactions" do
+      click_on "Add a reaction"
+      [ "   ", "a" * 17, "👍" * 17 ].each do |content|
+        fill_in "Your reaction (16 characters max)", with: content
+        click_on "Confirm reaction"
+        assert_selector ".reaction__input:invalid"
+        assert_no_selector ".reaction:not(.reaction__form)"
+      end
+
+      fill_in "Your reaction (16 characters max)", with: "👍" * 16
+      click_on "Confirm reaction"
+      assert_selector ".reaction:not(.reaction__form)", text: "👍" * 16
+      assert_button "Add a reaction"
+    end
+  end
+
+  test "live reactions show their creator and cannot be removed by other viewers" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    # Keep a draft open to ensure incoming reactions do not replace the form.
+    within "##{dom_id(@comment)} .reactions" do
+      click_on "Add a reaction"
+      fill_in "Your reaction (16 characters max)", with: "Draft"
+    end
+
+    reaction = nil
+    perform_enqueued_jobs only: [ Turbo::Streams::ActionBroadcastJob, Turbo::Streams::BroadcastStreamJob ] do
+      reaction = @comment.reactions.create!(content: "Wonderful", creator: users(:jz))
+    end
+
+    within "##{dom_id(@comment)} .reactions" do
+      assert_selector ".reaction", text: "Wonderful"
