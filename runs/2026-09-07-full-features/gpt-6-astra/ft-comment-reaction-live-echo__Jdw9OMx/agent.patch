@@ -0,0 +1,40 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "emoji and text up to 16 characters are accepted" do
+    [ "👍", "Thanks!", "a" * 16, "👍" * 16 ].each do |content|
+      reaction = @comment.reactions.create!(content: content)
+      assert_equal users(:david), reaction.creator
+      assert_equal @comment.account, reaction.account
+    end
+  end
+
+  test "blank and overlong reactions are rejected" do
+    [ nil, "", "   ", "a" * 17, "👍" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?
+    end
+  end
+
+  test "reactions are removed with their comment" do
+    reaction = @comment.reactions.create!(content: "Thanks")
+    @comment.destroy!
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "creating and deleting broadcast to the card" do
+    reaction = nil
+    assert_turbo_stream_broadcasts @comment.card do
+      perform_enqueued_jobs only: Turbo::Streams::ActionBroadcastJob do
+        reaction = @comment.reactions.create!(content: "🎉")
+      end
+    end
+    assert_turbo_stream_broadcasts @comment.card do
+      reaction.destroy!
+    end
+  end
+end
