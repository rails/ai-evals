@@ -0,0 +1,21 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "toggle", "removal", "content" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.owned = this.creatorIdValue === document.querySelector('meta[name="current-user-id"]')?.content
+    this.toggleTarget.hidden = !this.owned
+    this.contentTarget.hidden = this.owned
+    this.removalTarget.hidden = !this.owned
+    this.element.classList.toggle("reaction--deleteable", this.owned)
+  }
+
+  toggle() {
+    if (this.owned) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.toggleTarget.setAttribute("aria-expanded", expanded)
+    }
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..8ab2704
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,42 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "error" ]
+  static values = { maxLength: Number }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  validate() {
+    const content = this.inputTarget.value
+    let message = ""
+
+    // Native maxlength counts UTF-16 code units, counting many emoji twice.
+    if (Array.from(content).length > this.maxLengthValue) {
+      message = `Reactions must be ${this.maxLengthValue} characters or fewer.`
+    } else if (!content.trim()) {
+      message = "Please enter a reaction."
+    }
+
+    this.inputTarget.setCustomValidity(message)
+  }
+
+  cancel() {
+    this.formTarget.reset()
+    this.inputTarget.value = ""
+    this.inputTarget.setCustomValidity("")
+    if (this.hasErrorTarget) this.errorTarget.remove()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+}
