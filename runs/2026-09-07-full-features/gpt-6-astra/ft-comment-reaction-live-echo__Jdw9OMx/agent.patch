+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,36 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(params.expect(reaction: [ :content ]))
+
+    if @reaction.save
+      render turbo_stream: turbo_stream.append([ @comment, :reactions ], @reaction)
+    else
+      render turbo_stream: turbo_stream.replace([ @comment, :new_reaction ],
+        partial: "cards/comments/reactions/form", locals: { comment: @comment, reaction: @reaction }), status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    render turbo_stream: turbo_stream.remove(@reaction)
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+end
