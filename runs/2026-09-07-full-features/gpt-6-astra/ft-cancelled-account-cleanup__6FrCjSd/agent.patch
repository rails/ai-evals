diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..a84e97c
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates all data belonging to an account cancelled more than 30 days ago" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    account.storage_entries.create!(delta: 100, operation: "attach")
+    cards(:logo).image.attach io: StringIO.new("image"), filename: "test.png", content_type: "image/png"
+    Current.with_account(account) do
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("unattached"), filename: "unattached.txt")
+    end
+    account.materialize_storage
+    boards(:writebook).materialize_storage
+
+    other_account_counts = account_record_counts(accounts(:initech))
+
+    assert_no_difference "Identity.count" do
+      perform_enqueued_jobs(only: ActiveStorage::PurgeJob) do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_equal({}, account_record_counts(account))
+    assert_equal other_account_counts, account_record_counts(accounts(:initech))
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "incinerates multiple due accounts and restores the account context" do
+    accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 32.days.ago)
+
+    Current.with_account(accounts(:acme)) do
+      assert_difference "Account.count", -2 do
+        Account::IncinerateDueJob.perform_now
+      end
+
+      assert_equal accounts(:acme), Current.account
+      assert Account.exists?(accounts(:acme).id)
+    end
+  end
+
+  test "preserves active accounts and cancellations within the grace period" do
+    freeze_time do
+      accounts(:"37s").create_cancellation!(initiated_by: users(:david), created_at: 30.days.ago)
+      accounts(:initech).create_cancellation!(initiated_by: users(:mike), created_at: 29.days.ago)
+
+      assert_no_difference "Account.count" do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      travel 1.second
+
+      assert_difference "Account.count", -1 do
+        Current.without_account { Account::IncinerateDueJob.perform_now }
+      end
+
+      assert_not Account.exists?(accounts(:"37s").id)
+      assert Account.exists?(accounts(:initech).id)
+      assert Account.exists?(accounts(:acme).id)
+    end
+  end
+
+  test "preserves reactivated accounts" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    account.reactivate
+
+    assert_no_difference "Account.count" do
+      Current.without_account { Account::IncinerateDueJob.perform_now }
+    end
+  end
+
+  test "rechecks cancellation before incinerating a selected account" do
+    account = accounts(:"37s")
+    account.create_cancellation!(initiated_by: users(:david), created_at: 31.days.ago)
+    Account.find(account.id).reactivate
+
+    assert_no_difference "Account.count" do
+      account.incinerate
+    end
+  end
+
+  private
+    def account_record_counts(account)
+      ApplicationRecord.connection.tables.each_with_object({}) do |table, counts|
+        model = Class.new(ApplicationRecord) { self.table_name = table }
+        if model.column_names.include?("account_id")
+          count = model.where(account_id: account.id).count
+          counts[table] = count if count.positive?
+        end
+      end
+    end
+end
