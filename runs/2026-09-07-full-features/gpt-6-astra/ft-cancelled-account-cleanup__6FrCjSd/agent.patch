diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..dff0a28 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,22 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }).find_each do |account|
+        Current.with_account(account) { account.incinerate }
+      end
+    end
+  end
+
+  def incinerate
+    with_lock do
+      if reload_cancellation && cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+        destroy!
+        ActiveStorage::Blob.where(account_id: id).find_each(&:purge_later)
+      end
+    end
+  end
 end
