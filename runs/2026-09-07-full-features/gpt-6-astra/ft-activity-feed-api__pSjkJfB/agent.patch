diff --git a/docs/api/sections/activities.md b/docs/api/sections/activities.md
new file mode 100644
index 0000000..123ec3e
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,52 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity from boards the current user can access, as a flat JSON
+array ordered newest first. This mirrors the HTML timeline, except that deprecated
+`card_collection_changed` events are omitted and `card_title_changed` events are
+included.
+
+Results are [paginated](../README.md#pagination). Follow the response's `Link`
+header with `rel="next"` to retrieve the next page.
+
+### Filters
+
+- `creator_ids[]`: include only activity created by these user IDs.
+- `board_ids[]`: include only activity from these board IDs.
+
+Multiple IDs within a filter are combined with OR; the two filters are combined
+with AND. Filters never grant access to otherwise inaccessible activity.
+
+For example:
+
+```text
+GET /1234567/activities.json?creator_ids[]=USER_ID&board_ids[]=BOARD_ID
+```
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID. |
+| `action` | Event action (listed below). |
+| `created_at` | Event timestamp in UTC, formatted as ISO 8601. |
+| `description` | Plain-text description, without HTML markup or HTML escaping. |
+| `particulars` | Event-specific details (listed below). |
+| `url` | Opens the card; comment events also include an anchor that jumps to the comment. |
+| `eventable_type` | `Card` or `Comment`. |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation. |
+| `board` | The existing [board](boards.md) API representation. |
+| `creator` | The existing [user](users.md) API representation. |
+
+### Actions and particulars
+
+| Action | `particulars` |
+|--------|---------------|
+| `card_assigned`, `card_unassigned` | `{"assignee_ids": ["USER_ID"]}` |
+| `card_board_changed` | `{"old_board": "Old board name", "new_board": "New board name"}` |
+| `card_title_changed` | `{"old_title": "Old title", "new_title": "New title"}` |
+| `card_triaged`, `card_sent_back_to_triage` | `{"column": "Column name"}` |
+| `card_published`, `card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `comment_created` | `{}` |
+
+Missing board names, titles, and column names are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..b10dec8
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON uses existing resource representations and card URLs" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    event = events(:layout_assignment_jz)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({ "assignee_ids" => event.assignee_ids }, activity["particulars"])
+
+    get card_path(event.eventable), as: :json
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board), as: :json
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator), as: :json
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity uses the comment representation and links to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal({}, activity["particulars"])
+    assert_equal %(David commented on "#{comment.card.title}"), activity["description"]
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or other actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed
+      card_triaged card_sent_back_to_triage comment_created
+    ]
+    created = actions.map do |action|
+      create_event(action, eventable: action == "comment_created" ? comments(:layout_overflowing_david) : cards(:layout))
+    end
+    create_event("card_collection_changed")
+    create_event("card_resumed")
+    create_event("card_unknown")
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal created.reverse.map(&:id), response.parsed_body.first(created.size).pluck("id")
+    assert_empty response.parsed_body.pluck("action") - actions
+  end
+
+  test "exposes only event-specific particulars and uses empty strings for missing values" do
+    examples = [
+      [ "card_assigned", { "assignee_ids" => [ users(:jz).id ] }, { "assignee_ids" => [ users(:jz).id ] } ],
+      [ "card_unassigned", { "assignee_ids" => [ users(:jz).id ] }, { "assignee_ids" => [ users(:jz).id ] } ],
+      [ "card_board_changed", { "particulars" => { "old_board" => "Old", "new_board" => "New" } }, { "old_board" => "Old", "new_board" => "New" } ],
+      [ "card_board_changed", {}, { "old_board" => "", "new_board" => "" } ],
+      [ "card_title_changed", { "particulars" => { "old_title" => "Old", "new_title" => "New" } }, { "old_title" => "Old", "new_title" => "New" } ],
+      [ "card_title_changed", { "particulars" => { "old_title" => nil } }, { "old_title" => "", "new_title" => "" } ],
+      [ "card_triaged", { "particulars" => { "column" => "In progress" } }, { "column" => "In progress" } ],
+      [ "card_triaged", { "particulars" => { "column" => nil } }, { "column" => "" } ],
+      [ "card_sent_back_to_triage", {}, { "column" => "" } ],
+      [ "card_closed", { "internal" => "private detail" }, {} ]
+    ]
+
+    examples.each do |action, particulars, expected|
+      event = create_event(action, particulars: particulars.merge("internal" => "private detail"))
+
+      get activities_path(format: :json)
+
+      assert_response :success
+      activity = response.parsed_body.find { |item| item["id"] == event.id }
+      assert_equal expected, activity["particulars"], action
+    end
+  end
+
+  test "descriptions are literal plain text rather than HTML or HTML entities" do
+    users(:david).update_column(:name, "David & <friends>")
+    cards(:layout).update_column(:title, 'Use "quotes" & <tags>')
+    event = create_event("card_title_changed", particulars: { particulars: { old_title: "Old & <title>" } })
+
+    get activities_path(format: :json)
+
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+    assert_equal %(David & <friends> renamed "Use "quotes" & <tags>" (was: "Old & <title>")), activity["description"]
+  end
+
+  test "filters by creators and boards together" do
+    event = create_event("card_published")
+    create_event("card_published", creator: users(:kevin))
+    create_event("card_published", board: boards(:private))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), event.id
+    response.parsed_body.each do |activity|
+      assert_equal users(:david).id, activity.dig("creator", "id")
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+
+  test "accepts multiple IDs in each filter" do
+    private_event = create_event("card_published", board: boards(:private), creator: users(:kevin))
+    public_event = create_event("card_published")
+    excluded_event = create_event("card_published", creator: users(:jz))
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:kevin).id, users(:david).id ],
+      board_ids: [ boards(:private).id, boards(:writebook).id ]
+    }
+
+    assert_response :success
+    assert_includes response.parsed_body.pluck("id"), private_event.id
+    assert_includes response.parsed_body.pluck("id"), public_event.id
+    assert_not_includes response.parsed_body.pluck("id"), excluded_event.id
+  end
+
+  test "returns an empty array when the user has no board access" do
+    users(:kevin).accesses.destroy_all
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "moving a card to an inaccessible board hides its card and comment activity" do
+    card_event = events(:layout_published)
+    comment_event = events(:layout_commented)
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_empty response.parsed_body.pluck("id") & [ card_event.id, comment_event.id ]
+  end
+
+  test "inaccessible boards and other accounts are excluded even when requested" do
+    private_event = create_event("card_published", board: boards(:private))
+    other_account_event = create_event("card_published", board: boards(:miltons_wish_list), eventable: cards(:radio), creator: users(:mike))
+    logout_and_sign_in_as :david
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_empty response.parsed_body.pluck("id") & [ private_event.id, other_account_event.id ]
+
+    get activities_path(format: :json), params: { board_ids: [ boards(:private).id, boards(:miltons_wish_list).id ] }
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "unmatched filters return an empty array" do
+    get activities_path(format: :json), params: { creator_ids: [ users(:mike).id ] }
+
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates newest first with stable ties and preserves filters in next links" do
+    baseline = Time.current.change(usec: 0)
+    60.times do |index|
+      create_event("card_published", created_at: baseline + (index / 2).seconds)
+    end
+    create_event("card_published", creator: users(:kevin))
+    expected_ids = users(:kevin).accessible_events.for_activity.where(creator: users(:david), board: boards(:writebook))
+      .order(created_at: :desc, id: :desc).pluck(:id)
+    actual_ids = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(response.parsed_body.pluck("id"))
+      next_page = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  test "accepts read-only bearer tokens and rejects invalid tokens" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+    assert_response :unauthorized
+
+    token = identities(:david).access_tokens.create!(permission: :read)
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+    assert_equal [ boards(:writebook).id ], response.parsed_body.map { |activity| activity.dig("board", "id") }.uniq
+  end
+
+  private
+    def create_event(action, eventable: cards(:layout), board: eventable.board, creator: users(:david), particulars: {}, created_at: Time.current)
+      Event.create!(action: action, eventable: eventable, board: board, creator: creator, particulars: particulars, created_at: created_at)
+    end
+end
