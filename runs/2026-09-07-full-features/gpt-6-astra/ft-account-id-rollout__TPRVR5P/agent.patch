diff --git a/config/initializers/active_storage_tenancy.rb b/config/initializers/active_storage_tenancy.rb
new file mode 100644
index 0000000..93f6fd8
--- /dev/null
+++ b/config/initializers/active_storage_tenancy.rb
@@ -0,0 +1,22 @@
+# Inline uploads and derivatives inherit ownership from their record, even when
+# running without request context. Direct uploads use the current account.
+module ActiveStorageBlobTenancy
+  def build_after_unfurling(record: nil, **attributes)
+    super.tap do |blob|
+      blob.account = record.try(:account) || Current.account
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+  singleton_class.prepend ActiveStorageBlobTenancy
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
