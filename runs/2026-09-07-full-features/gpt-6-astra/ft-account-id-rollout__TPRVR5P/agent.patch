+require "test_helper"
+
+class AccountOwnershipTest < ActiveSupport::TestCase
+  test "child ownership comes from the parent rather than the current account" do
+    Current.account = accounts(:initech)
+    card = cards(:logo)
+    board = card.board
+    user = users(:david)
+
+    records = [
+      board.accesses.build(user: user),
+      board.build_publication,
+      card.assignments.build(assignee: user, assigner: user),
+      card.build_goldness,
+      card.build_not_now,
+      card.build_closure,
+      card.pins.build(user: user),
+      card.watches.build(user: user),
+      card.taggings.build(tag: tags(:mobile)),
+      user.build_settings,
+      user.search_queries.build(terms: "logo"),
+      board.build_entropy,
+      board.build_storage_total,
+      accounts(:"37s").build_storage_total,
+      card.rich_text_description || card.build_rich_text_description
+    ]
+
+    records.each do |record|
+      record.valid?
+      assert_equal card.account_id, record.account_id, record.class.name
+    end
+  end
+
+  test "filter resource inserts carry account ownership" do
+    Current.account = accounts(:initech)
+    filter = users(:david).filters.create!(
+      tag_ids: [ tags(:mobile).id ],
+      board_ids: [ boards(:writebook).id ],
+      assignee_ids: [ users(:jz).id ],
+      creator_ids: [ users(:kevin).id ],
+      closer_ids: [ users(:david).id ]
+    )
+
+    %i[ tag_resources board_resources assignee_resources creator_resources closer_resources ].each do |association|
+      assert_equal [ filter.account_id ], filter.public_send(association).pluck(:account_id), association.to_s
+    end
+  end
+
+  test "inline uploads and variants inherit the owner without request context" do
+    Current.account = nil
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    assert_equal card.account_id, card.image.blob.account_id
+    assert_equal card.account_id, card.image.attachment.account_id
+    variant = card.image.blob.variant_records.create!(variation_digest: "tenant-test")
+    assert_equal card.account_id, variant.account_id
+  end
+
+  test "search query value objects need neither a user nor an account" do
+    Current.account = nil
+    assert_predicate Search::Query.wrap("logo"), :valid?
+  end
+end
