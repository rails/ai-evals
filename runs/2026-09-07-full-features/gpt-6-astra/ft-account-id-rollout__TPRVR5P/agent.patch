+    @connection.create_table(:accounts, id: :uuid)
+    FinishAccountIdRollout::EXISTING_TABLES.each do |table, parent|
+      @connection.create_table(table, id: :uuid) do |t|
+        t.uuid :account_id
+        t.uuid parent.last if parent
+      end
+    end
+    FinishAccountIdRollout::NEW_TABLES.each do |table, (_, foreign_key)|
+      @connection.create_table(table, id: :uuid) { |t| t.uuid foreign_key }
+    end
+    FinishAccountIdRollout::POLYMORPHIC_TABLES.each do |table, (association, _)|
+      @connection.create_table(table, id: :uuid) do |t|
+        t.uuid "#{association}_id"
+        t.string "#{association}_type"
+      end
+    end
+    @connection.create_table(:exports, id: :uuid) { |t| t.uuid :account_id }
+    @connection.create_table(:active_storage_blobs, id: :uuid)
