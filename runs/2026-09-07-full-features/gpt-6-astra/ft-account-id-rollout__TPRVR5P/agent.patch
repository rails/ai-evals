+      t.uuid :blob_id
+      t.uuid :record_id
+      t.string :record_type
+    end
+    @connection.create_table(:active_storage_variant_records, id: :uuid) { |t| t.uuid :blob_id }
+    @connection.add_index :users, [ :account_id, :id ], unique: true
+  end
+
+  teardown do
+    MigrationRecord.remove_connection
+  end
