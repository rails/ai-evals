+
+class FinishAccountIdRolloutTest < ActiveSupport::TestCase
+  class MigrationRecord < ActiveRecord::Base
+    self.abstract_class = true
+  end
+
+  setup do
+    MigrationRecord.establish_connection(adapter: "sqlite3", database: ":memory:")
+    @connection = MigrationRecord.connection_pool.lease_connection
+    @migration = FinishAccountIdRollout.new
+    @migration.define_singleton_method(:connection) { MigrationRecord.connection_pool.lease_connection }
+    @migration.verbose = false
