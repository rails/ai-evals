+require "test_helper"
+
+class PushSubscription::RequestTest < ActiveSupport::TestCase
+  setup do
+    key = WebPush.generate_key
+    @request = PushSubscription::Request.new(
+      message: { title: "A card", body: "Added by David" }.to_json,
+      subscription: { endpoint: "https://push.example.com/device", keys: { p256dh: key.public_key, auth: Base64.urlsafe_encode64(SecureRandom.random_bytes(16)) } },
+      vapid: { public_key: key.public_key, private_key: key.private_key },
+      ttl: 86400
+    )
+  end
+
+  test "sends encrypted payload with VAPID authentication to a pinned public address" do
+    stub_dns_resolution("93.184.216.34")
+    request = stub_request(:post, "https://push.example.com/device").with(
+      ipaddr: "93.184.216.34",
+      headers: { "Content-Encoding" => "aes128gcm", "Ttl" => "86400", "Authorization" => /\Avapid t=/ }
+    ) { |request| !request.body.include?("Added by David") }.to_return(status: 201)
+
+    @request.perform
+
+    assert_requested request
+  end
+
+  test "does not send requests to private endpoints" do
+    stub_dns_resolution("127.0.0.1", "10.0.0.1", "::1")
+    @request.perform
+    assert_not_requested :post, "https://push.example.com/device"
+  end
+
+  test "preserves WebPush expired subscription handling" do
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, "https://push.example.com/device").to_return(status: 410)
+    assert_raises(WebPush::ExpiredSubscription) { @request.perform }
+  end
+end
