diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..7d5b18c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,98 @@
+import { Controller } from "@hotwired/stimulus"
+import { get, post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "help", "details" ]
+  static values = { url: String, publicKey: String }
+
+  async connect() {
+    this.subscriptionId = null
+    this.buttonTarget.disabled = true
+
+    if (this.#supported) {
+      try {
+        const registration = await navigator.serviceWorker.getRegistration("/")
+        const subscription = await registration?.pushManager.getSubscription()
+
+        if (subscription && Notification.permission === "granted") {
+          const response = await get(this.urlValue, { responseKind: "json" })
+          if (!response.ok) throw new Error("Could not check notification settings")
+          this.subscriptionId = (await response.json).find(device => device.endpoint === subscription.endpoint)?.id
+        }
+        this.#render()
+      } catch {
+        this.statusTarget.textContent = "Couldn’t check notifications. Please reload and try again."
+      }
+    } else {
+      this.statusTarget.textContent = "This browser can’t receive notifications here. See the instructions below."
+      this.helpTarget.hidden = false
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.statusTarget.textContent = ""
+
+    try {
+      if (this.subscriptionId) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+      this.#render()
+    } catch {
+      this.#render()
+      this.statusTarget.textContent = "Couldn’t update notifications. Please try again."
+    }
+  }
+
+  async #enable() {
+    // Ask while we still have the user's gesture (required by Safari).
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.getSubscription() || await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+    const { endpoint, keys } = subscription.toJSON()
+    const response = await post(this.urlValue, {
+      responseKind: "json",
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } }
+    })
+
+    if (!response.ok) throw new Error("Could not save subscription")
+    this.subscriptionId = (await response.json).id
+  }
+
+  async #disable() {
+    const response = await destroy(`${this.urlValue}/${this.subscriptionId}`, { responseKind: "json" })
+    if (!response.ok && response.statusCode !== 404) throw new Error("Could not remove subscription")
+
+    // Other accounts can share the browser subscription. Only unregister this
+    // account's device on the server, rather than unsubscribing them all.
+    this.subscriptionId = null
+  }
+
+  #render() {
+    const enabled = Boolean(this.subscriptionId)
+    const denied = Notification.permission === "denied"
+    this.element.classList.toggle("notifications--on", enabled)
+    this.buttonTarget.disabled = !enabled && denied
+    this.buttonTarget.setAttribute("aria-pressed", enabled)
+    this.helpTarget.hidden = !denied
+    this.statusTarget.textContent = denied ? "Notifications are blocked. Follow the instructions below, then reload this page." : ""
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const key = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const paddedKey = key.padEnd(Math.ceil(key.length / 4) * 4, "=")
+    return Uint8Array.from(atob(paddedKey), character => character.charCodeAt(0))
+  }
+}
