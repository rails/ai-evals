+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    ENV.stubs(:fetch).with("VAPID_PUBLIC_KEY").returns("vapid-public")
+    ENV.stubs(:fetch).with("VAPID_PRIVATE_KEY").returns("vapid-private")
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "public-key", auth_key: "auth-key")
+    @payload = { title: "A card", body: "Added by David", data: { url: "/123/cards/456" } }
+  end
+
+  test "push uses the subscription and VAPID keys" do
+    request = mock
+    request.expects(:perform)
+    PushSubscription::Request.expects(:new).with(
+      message: @payload.to_json,
+      subscription: { endpoint: @subscription.endpoint, keys: { p256dh: "public-key", auth: "auth-key" } },
+      vapid: { public_key: "vapid-public", private_key: "vapid-private" }, ttl: 86400
+    ).returns(request)
+
+    @subscription.push(@payload)
+  end
+
+  test "push is a no-op without VAPID configuration" do
+    PushSubscription.stubs(:configured?).returns(false)
+    PushSubscription::Request.expects(:new).never
+    @subscription.push(@payload)
+  end
+
+  [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription ].each do |error_class|
+    test "removes #{error_class} subscriptions" do
+      response = stub(body: "expired")
+      request = mock
+      request.expects(:perform).raises(error_class.new(response, "push.example.com"))
+      PushSubscription::Request.stubs(:new).returns(request)
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.push(@payload)
+      end
+    end
+  end
+
+  test "transient failures do not remove the subscription" do
+    request = mock
+    request.expects(:perform).raises(Net::ReadTimeout)
+    PushSubscription::Request.stubs(:new).returns(request)
+
+    assert_no_difference -> { PushSubscription.count } do
+      assert_raises(Net::ReadTimeout) { @subscription.push(@payload) }
+    end
+  end
+
+  test "requires endpoint and encryption keys" do
+    [ :endpoint, :p256dh_key, :auth_key ].each do |attribute|
+      subscription = @subscription.dup
+      subscription[attribute] = ""
+      assert_not subscription.valid?
+      assert subscription.errors[attribute].any?
+    end
+  end
+
+  test "requires an HTTPS endpoint without credentials or fragments" do
+    [ "http://example.com/push", "not a url", "https:///push", "https://user:password@example.com/push", "https://example.com/push#fragment" ].each do |endpoint|
+      @subscription.endpoint = endpoint
+      assert_not @subscription.valid?, endpoint
+      assert @subscription.errors[:endpoint].any?
+    end
+  end
+
+  test "endpoint uniqueness is per user and case sensitive" do
+    assert_not @subscription.dup.valid?
+    assert @subscription.user.push_subscriptions.build(endpoint: @subscription.endpoint.upcase.sub("HTTPS", "https"), p256dh_key: "key", auth_key: "key").valid?
+    assert users(:david).push_subscriptions.create!(endpoint: @subscription.endpoint, p256dh_key: "key", auth_key: "key")
+  end
+
+  test "deactivating a user removes their subscriptions" do
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.user.deactivate
+    end
+  end
+end
