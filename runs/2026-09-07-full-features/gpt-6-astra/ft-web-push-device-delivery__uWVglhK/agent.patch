new file mode 100644
index 0000000..660165f
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,33 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { previously_new_record? || source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_later
+    if PushSubscription.configured? && !read?
+      payload = push_payload
+      user.push_subscriptions.find_each do |subscription|
+        Notification::PushJob.perform_later(self, subscription, payload)
+      end
+    end
+  end
+
+  def push_now(subscription, payload)
+    if !read? && user.active? && account.active? && subscription.user == user && user.accessible_cards.exists?(card.id)
+      subscription.push(payload)
+    end
+  end
+
+  def push_payload
+    helpers = ApplicationController.helpers
+    {
+      title: helpers.notification_title(self),
+      body: helpers.notification_body(self),
+      icon: "/app-icon.png",
+      tag: "notification_#{id}",
+      data: { url: Rails.application.routes.url_helpers.polymorphic_path(notifiable_target, script_name: account.slug, only_path: true) }
+    }
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..f386279
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,46 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, length: { maximum: 2048 }
+  validates :p256dh_key, :auth_key, length: { maximum: 255 }
+  validates :endpoint_digest, uniqueness: { scope: :user_id }
+  validate :endpoint_is_https
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def push(payload)
+    if self.class.configured?
+      Request.new(
+        message: payload.to_json,
+        subscription: { endpoint: endpoint, keys: { p256dh: p256dh_key, auth: auth_key } },
+        vapid: {
+          public_key: ENV.fetch("VAPID_PUBLIC_KEY"),
+          private_key: ENV.fetch("VAPID_PRIVATE_KEY")
+        },
+        ttl: 1.day.to_i
+      ).perform
+    end
+  rescue WebPush::InvalidSubscription, WebPush::ExpiredSubscription
+    destroy!
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil? && uri.fragment.nil?
+        errors.add(:endpoint, "must be an HTTPS URL")
+      end
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an HTTPS URL")
+    end
+end
diff --git a/app/models/push_subscription/request.rb b/app/models/push_subscription/request.rb
new file mode 100644
index 0000000..99736a2
--- /dev/null
+++ b/app/models/push_subscription/request.rb
@@ -0,0 +1,20 @@
+# Keep WebPush's encryption and protocol handling, but pin the connection to a
+# public address, just as we do for webhooks. Endpoints are supplied by clients.
+class PushSubscription::Request < WebPush::Request
+  def perform
+    if address = SsrfProtection.resolve_public_ip(uri.host)
+      http = Net::HTTP.new(uri.host, uri.port, nil)
+      http.ipaddr = address
+      http.use_ssl = true
+      http.open_timeout = 5
+      http.read_timeout = 5
+      http.write_timeout = 5
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      response = http.request(request)
+      verify_response(response)
+      response
+    end
+  end
+end
