+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.stubs(:configured?).returns(true)
+    @notification = notifications(:logo_assignment_kevin)
+    @user = @notification.user
+    @subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.com/device", p256dh_key: "key", auth_key: "key")
+  end
+
+  test "creating a tray notification pushes to every subscribed device" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "key")
+    users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/someone-else", p256dh_key: "key", auth_key: "key")
+    notifications(:layout_commented_kevin).destroy!
+
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing card pushes again" do
+    assert_enqueued_with(job: Notification::PushJob) do
+      @notification.update!(source: events(:logo_published), unread_count: 3)
+    end
+  end
+
+  test "switching from an event to a mention pushes again" do
+    assert_enqueued_with(job: Notification::PushJob) do
+      @notification.update!(source: mentions(:logo_card_david_mention_by_jz))
+    end
+  end
+
+  test "reading, marking unread, and destroying do not push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+      @notification.destroy!
+    end
+  end
+
+  test "no push jobs when unconfigured or unsubscribed" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs(only: Notification::PushJob) { @notification.push_later }
+    PushSubscription.stubs(:configured?).returns(true)
+    @subscription.destroy!
+    assert_no_enqueued_jobs(only: Notification::PushJob) { @notification.push_later }
+  end
+
+  test "event payload has tray text and account-scoped card path" do
+    payload = @notification.push_payload
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload[:title]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload[:body]
+    assert_equal "#{@user.account.slug}/cards/#{@notification.card.number}", payload[:data][:url]
+  end
+
+  test "comment payload has plain text and opens the comment's card" do
+    notification = notifications(:layout_commented_kevin)
+    assert_equal "RE: #{notification.card.title}", notification.push_payload[:title]
+    assert_equal notification.source.eventable.body.to_plain_text.truncate(200), notification.push_payload[:body]
+    assert_includes notification.push_payload[:data][:url], "#{notification.account.slug}/cards/#{notification.card.number}#comment_"
+  end
+
+  test "mention payload matches tray and links to its source" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+    payload = notification.push_payload
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload[:title]
+    assert_equal mention.source.mentionable_content.truncate(200), payload[:body]
+    assert_includes payload[:data][:url], "#{notification.account.slug}/cards/#{notification.card.number}#comment_"
+  end
+
+  test "delivery sends the captured payload, not newer tray activity" do
+    payload = @notification.push_payload
+    @notification.update!(source: events(:logo_published))
+    @subscription.expects(:push).with(payload)
+    @notification.push_now(@subscription, payload)
+  end
+
+  test "delivery skips read notifications" do
+    @notification.read
+    @subscription.expects(:push).never
+    @notification.push_now(@subscription, @notification.push_payload)
+  end
+
+  test "delivery skips users who have lost access to the card" do
+    @user.accesses.where(board: @notification.card.board).delete_all
+    @subscription.expects(:push).never
+    @notification.push_now(@subscription, @notification.push_payload)
+  end
+
+  test "deleted subscriptions are safely discarded by queued jobs" do
+    @notification.push_later
+    @subscription.destroy!
+    assert_nothing_raised { perform_enqueued_jobs(only: Notification::PushJob) }
+  end
+
+  test "jobs retry transient push service failures" do
+    PushSubscription.any_instance.stubs(:push).raises(Net::ReadTimeout)
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification::PushJob.perform_now(@notification, @subscription, @notification.push_payload)
+    end
+  end
+  test "a transient failure for one device does not prevent delivery to another" do
+    other_device = @user.push_subscriptions.create!(endpoint: "https://push.example.com/phone", p256dh_key: "key", auth_key: "key")
+    PushSubscription.any_instance.expects(:push).raises(Net::ReadTimeout).then.returns(nil).twice
+
+    @notification.push_later
+    # Limit the time window so the failed device's scheduled retry is not run.
+    perform_enqueued_jobs(only: Notification::PushJob, at: Time.current)
+
+    assert_enqueued_jobs 1, only: Notification::PushJob
+    assert PushSubscription.exists?(@subscription.id)
+    assert PushSubscription.exists?(other_device.id)
+  end
+
+  test "delivery skips deactivated recipients and another user's subscriptions" do
+    @user.update!(active: false)
+    @subscription.expects(:push).never
+    @notification.push_now(@subscription, @notification.push_payload)
+
+    @user.update!(active: true)
+    @subscription.update!(user: users(:david))
+    @notification.push_now(@subscription, @notification.push_payload)
+  end
+end
