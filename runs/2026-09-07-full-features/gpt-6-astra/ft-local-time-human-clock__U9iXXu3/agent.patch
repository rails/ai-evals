diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..4056c1e
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+    this.timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    clearInterval(this.timer)
+  }
+
+  render() {
+    const date = parseLocalTime(this.element.dateTime)
+
+    if (!isNaN(date.getTime())) {
+      this.element.textContent = formatLocalTime(date, this.formatValue)
+      this.element.title = formatLocalTime(date, "dateTime")
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..98338e9
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,47 @@
+const DAY_IN_MILLISECONDS = 86_400_000
+const relativeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+const formats = {
+  time: { hour: "numeric", minute: "2-digit" },
+  date: { month: "short", day: "numeric" },
+  fullDate: { year: "numeric", month: "short", day: "numeric" },
+  weekday: { weekday: "long", month: "long", day: "numeric" },
+  dateTime: { year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }
+}
+const formatters = Object.fromEntries(Object.entries(formats).map(([ name, options ]) => {
+  return [ name, new Intl.DateTimeFormat("en-US", options) ]
+}))
+
+export function parseLocalTime(timestamp) {
+  // Calendar dates have no timezone. Parsing them as ISO timestamps would move
+  // them to the previous day for viewers west of UTC.
+  if (/^\d{4}-\d{2}-\d{2}$/.test(timestamp)) {
+    const [ year, month, day ] = timestamp.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  } else {
+    return new Date(timestamp)
+  }
+}
+
+export function formatLocalTime(date, format = "relative", now = new Date()) {
+  if (format === "relative") {
+    const days = localDayNumber(date) - localDayNumber(now)
+
+    if (days === 0) {
+      return formatters.time.format(date)
+    } else if (Math.abs(days) < 7) {
+      return relativeFormatter.format(days, "day")
+    } else {
+      return formatters[date.getFullYear() === now.getFullYear() ? "date" : "fullDate"].format(date)
+    }
+  } else if (format === "relativeDays") {
+    return relativeFormatter.format(localDayNumber(date) - localDayNumber(now), "day")
+  } else {
+    return formatters[format].format(date)
+  }
+}
+
+function localDayNumber(date) {
+  // Compare local calendar days, not elapsed 24-hour periods: DST days may
+  // contain 23 or 25 hours.
+  return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) / DAY_IN_MILLISECONDS
+}
