+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "accounts and boards start with no counted storage" do
+    assert_equal 0, accounts("37s").bytes_used
+    assert_equal 0, boards(:writebook).bytes_used
+  end
+  test "counts only card images and embeds in board descriptions, card descriptions and comments" do
+    card = cards(:logo)
+    board = card.board
+    account = card.account
+
+    card.image.attach blob(10)
+    embed board, :public_description, blob(20)
+    embed card, :description, blob(30)
+    embed comments(:logo_1), :body, blob(40)
+    users(:david).avatar.attach blob(50)
+    blob(60) # An unattached direct upload.
+
+    assert_equal 0, account.bytes_used
+    reconcile
+    assert_equal 100, board.bytes_used
+    assert_equal 100, account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "counts each attachment even when a blob is reused" do
+    shared = blob(12)
+    cards(:logo).image.attach shared
+    cards(:layout).image.attach shared
+    embed cards(:logo), :description, shared
+    reconcile
+
+    assert_equal 36, boards(:writebook).bytes_used
+    assert_equal 36, accounts("37s").bytes_used
+  end
+
+  test "replaces images and removes rich text embeds" do
+    card = cards(:logo)
+    card.image.attach blob(10)
+    embed card, :description, blob(20)
+    reconcile
+
+    card.image.attach blob(40)
+    card.update!(description: "No more embeds")
+    reconcile
+    assert_equal 40, card.board.bytes_used
+    assert_equal 40, card.account.bytes_used
+
+    card.image.detach
+    reconcile
+    assert_equal 0, card.account.bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "moves all card and comment attachments but not board descriptions" do
+    card = cards(:logo)
+    old_board = card.board
+    new_board = boards(:private)
+    card.image.attach blob(10)
+    embed card, :description, blob(20)
+    embed comments(:logo_1), :body, blob(30)
+    embed old_board, :public_description, blob(40)
+    reconcile
+
+    card.move_to(new_board)
+    reconcile
+    assert_equal 40, old_board.bytes_used
+    assert_equal 60, new_board.bytes_used
+    assert_equal 100, card.account.bytes_used
+
+    card.move_to(old_board)
+    card.move_to(new_board)
+    reconcile
+    assert_equal 40, old_board.bytes_used
+    assert_equal 60, new_board.bytes_used
+    assert_equal 100, card.account.bytes_used
+  end
+
+  test "deletes comments, cards and boards" do
+    card = cards(:logo)
+    board = card.board
+    comment = comments(:logo_1)
+    card.image.attach blob(10)
+    embed comment, :body, blob(20)
+    embed board, :public_description, blob(30)
+    reconcile
+
+    comment.destroy!
+    reconcile
+    assert_equal 40, board.bytes_used
+
+    card.destroy!
+    reconcile
+    assert_equal 30, board.bytes_used
+
+    board.destroy!
+    reconcile
+    assert_equal 0, accounts("37s").bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "deleting before accounting and replaying jobs cannot double count" do
+    card = cards(:logo)
+    card.image.attach blob(10)
+    entry = Storage::Entry.last
+    card.image.detach
+    2.times { Storage::ReconcileJob.perform_now(card.account, entry.id) }
+    reconcile
+    assert_equal 0, card.account.bytes_used
+
+    card.image.attach blob(20)
+    entry = Storage::Entry.last
+    2.times { Storage::ReconcileJob.perform_now(card.account, entry.id) }
+    reconcile
+    assert_equal 20, card.account.bytes_used
+  end
+
+  test "rolled back uploads do not affect accounting" do
+    assert_no_difference "Storage::Entry.count" do
+      Card.transaction do
+        cards(:logo).image.attach blob(10)
+        raise ActiveRecord::Rollback
+      end
+    end
+    reconcile
+    assert_equal 0, accounts("37s").bytes_used
+  end
+
+  test "pending entries can be recovered without the original job" do
+    cards(:logo).image.attach blob(10)
+    clear_enqueued_jobs
+    Storage::Entry.reconcile_pending
+    reconcile
+    assert_equal 10, accounts("37s").bytes_used
+  end
+
+  test "backfills existing attachments idempotently" do
+    cards(:logo).image.attach blob(10)
+    Storage::Entry.delete_all
+    clear_enqueued_jobs
+
+    2.times { Storage::BackfillJob.perform_now(accounts("37s")) }
+    reconcile
+    assert_equal 10, accounts("37s").bytes_used
+    assert_equal 1, Storage::Entry.count
+  end
+
+  test "purging synchronously or later removes usage without relying on blob deletion" do
+    [ :purge, :purge_later ].each do |method|
+      cards(:logo).image.attach blob(10)
+      reconcile
+      cards(:logo).image.public_send(method)
+      reconcile
+      assert_equal 0, accounts("37s").bytes_used
+    end
+  end
+
+  test "bulk detaching embeds removes usage but retains blobs" do
+    file = blob(10)
+    embed cards(:logo), :description, file
+    reconcile
+    cards(:logo).description.embeds.detach
+    reconcile
+
+    assert_equal 0, accounts("37s").bytes_used
+    assert ActiveStorage::Blob.exists?(file.id)
+    assert_empty Storage::Entry.all
+  end
+
+  test "zero byte files and values larger than 32 bits" do
+    cards(:logo).image.attach blob(0)
+    large = blob(1)
+    large.update!(byte_size: 5.gigabytes)
+    cards(:layout).image.attach large
+    reconcile
+    assert_equal 5.gigabytes, accounts("37s").bytes_used
+
+    cards(:logo).image.detach
+    cards(:layout).image.detach
+    reconcile
+    assert_equal 0, accounts("37s").bytes_used
+    assert_empty Storage::Entry.all
+  end
+
+  test "changes from different accounts stay isolated" do
+    cards(:logo).image.attach blob(10)
+    other_board = boards(:miltons_wish_list)
+    Current.with_account(other_board.account) do
+      embed other_board, :public_description, blob(20)
+    end
+    reconcile
+
+    assert_equal 10, accounts("37s").bytes_used
+    assert_equal 20, accounts(:initech).bytes_used
+    assert_equal 20, other_board.bytes_used
+  end
+
+  test "an accounting failure rolls back totals and can be retried" do
+    cards(:logo).image.attach blob(10)
+    entry = Storage::Entry.last
+    entry.stubs(:update!).raises(RuntimeError, "interrupted")
+
+    assert_raises(RuntimeError) { entry.reconcile_now }
+    assert_equal 0, accounts("37s").bytes_used
+    assert_equal 0, boards(:writebook).bytes_used
+    assert entry.reload.dirty?
+
+    entry.unstub(:update!)
+    entry.reconcile_now
+    assert_equal 10, accounts("37s").bytes_used
+    assert_equal 10, boards(:writebook).bytes_used
+  end
+
+  test "a stale instance still marks an entry pending after another worker clears it" do
+    cards(:logo).image.attach blob(10)
+    stale_entry = Storage::Entry.last
+    reconcile
+    assert_not Storage::Entry.last.dirty?
+
+    stale_entry.mark_dirty
+    assert Storage::Entry.last.dirty?
+    reconcile
+    assert_equal 10, accounts("37s").bytes_used
+  end
+
+  test "moving before the upload job runs accounts on the destination board" do
+    card = cards(:logo)
+    card.image.attach blob(10)
+    card.move_to(boards(:private))
+    reconcile
+    assert_equal 0, boards(:writebook).bytes_used
+    assert_equal 10, boards(:private).bytes_used
+    assert_equal 10, accounts("37s").bytes_used
+  end
+
+  test "rolled back moves and removals leave totals intact" do
+    card = cards(:logo)
+    card.image.attach blob(10)
+    reconcile
+    Card.transaction do
+      card.move_to(boards(:private))
+      card.image.detach
+      raise ActiveRecord::Rollback
+    end
+    reconcile
+    assert_equal 10, boards(:writebook).bytes_used
+    assert_equal 0, boards(:private).bytes_used
+    assert_equal 10, accounts("37s").bytes_used
+  end
+
+  test "deleting an account cleans up accounting and discards pending jobs" do
+    cards(:logo).image.attach blob(10)
+    reconcile
+    cards(:layout).image.attach blob(20)
+    accounts("37s").destroy!
+    reconcile
+    assert_empty Storage::Entry.all
+    assert_empty Storage::Total.all
+  end
+
+  test "backfill cursor advances past attachments already visited" do
+    cards(:logo).image.attach blob(10)
+    cards(:layout).image.attach blob(20)
+    Storage::Entry.delete_all
+    clear_enqueued_jobs
+
+    first, last = ActiveStorage::Attachment.order(:id).to_a
+    assert_nil Storage::Entry.backfill_batch(accounts("37s"), after: first.id)
+    assert_nil Storage::Entry.backfill_batch(accounts("37s"), after: last.id)
+    reconcile
+    assert_equal 20, accounts("37s").bytes_used
+  end
+
+  test "excludes export files, variants and previews" do
+    original = blob(10)
+    cards(:logo).image.attach original
+    exports(:pending_account_export).file.attach blob(20)
+    original.preview_image.attach blob(30)
+    variant = ActiveStorage::VariantRecord.create!(blob: original, variation_digest: "storage-test")
+    variant.image.attach blob(40)
+    reconcile
+
+    assert_equal 10, accounts("37s").bytes_used
+    assert_equal 10, boards(:writebook).bytes_used
+    assert_equal 1, Storage::Entry.count
+  end
+
+  test "backfill continues across batch boundaries" do
+    cards(:logo).image.attach blob(10)
+    cards(:layout).image.attach blob(20)
+    Storage::Entry.delete_all
+    clear_enqueued_jobs
+
+    stub_const(Storage::Entry, :BATCH_SIZE, 1) do
+      perform_enqueued_jobs(only: [ Storage::BackfillJob, Storage::ReconcileJob ]) do
+        Storage::BackfillJob.perform_later(accounts("37s"))
+      end
+    end
+    assert_equal 30, accounts("37s").bytes_used
+    assert_equal 2, Storage::Entry.count
+  end
+
+  test "moves continue across batch boundaries" do
+    card = cards(:logo)
+    card.image.attach blob(10)
+    embed card, :description, blob(20)
+    embed comments(:logo_1), :body, blob(30)
+    reconcile
+
+    stub_const(Storage::Entry, :BATCH_SIZE, 1) do
+      perform_enqueued_jobs(only: Storage::ReconcileSourceJob) do
+        card.move_to(boards(:private))
+      end
+    end
+    assert_equal 0, boards(:writebook).bytes_used
+    assert_equal 60, boards(:private).bytes_used
+    assert_equal 60, accounts("37s").bytes_used
+  end
+
+  test "moving a card without attachments does not enqueue accounting work" do
+    assert_no_enqueued_jobs(only: Storage::ReconcileSourceJob) do
+      cards(:logo).move_to(boards(:private))
+    end
+  end
+
+  test "detaching embeds from unsaved rich text does not create accounting entries" do
+    rich_text = ActionText::RichText.new(record: cards(:logo), name: "description")
+    assert_no_difference "Storage::Entry.count" do
+      rich_text.embeds.attach blob(10)
+      rich_text.embeds.detach
+    end
+  end
+
+  private
+    def blob(bytes)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x" * bytes), filename: "file.txt", content_type: "text/plain")
+    end
+
+    def embed(record, attribute, blob)
+      attachment = ActionText::Attachment.from_attributes(blob.to_rich_text_attributes)
+      record.update!(attribute => attachment.to_html)
+    end
+
+    def reconcile
+      perform_enqueued_jobs(only: [ Storage::ReconcileJob, Storage::ReconcileSourceJob ])
+    end
+end
