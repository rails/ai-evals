diff --git a/app/models/storage/attachment.rb b/app/models/storage/attachment.rb
new file mode 100644
index 0000000..d6ded30
--- /dev/null
+++ b/app/models/storage/attachment.rb
@@ -0,0 +1,48 @@
+module Storage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create :track_storage_usage
+    after_destroy :remove_storage_usage
+  end
+
+  # Active Storage deliberately skips destroy callbacks for detach and purge.
+  def delete
+    transaction do
+      super.tap { remove_storage_usage }
+    end
+  end
+
+  # Also used to backfill attachments created before accounting was installed or
+  # imported with insert_all. Each attachment occurrence counts once, not each blob.
+  def track_storage_usage
+    if source = storage_source
+      Storage::Entry.find_or_create_by!(attachment_id: id) do |entry|
+        entry.account = account
+        entry.source = source
+        entry.byte_size = blob.byte_size
+      end
+    end
+  end
+
+  private
+    def storage_source
+      if record_type == "Card" && name == "image"
+        record
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = record
+        case [ rich_text&.record_type, rich_text&.name ]
+        when [ "Board", "public_description" ], [ "Card", "description" ]
+          rich_text.record
+        when [ "Comment", "body" ]
+          rich_text.record&.card
+        end
+      end
+    end
+
+    def remove_storage_usage
+      if entry = Storage::Entry.find_by(attachment_id: id)
+        entry.mark_dirty
+      end
+    end
+end
diff --git a/app/models/storage/entry.rb b/app/models/storage/entry.rb
new file mode 100644
index 0000000..96257a9
--- /dev/null
+++ b/app/models/storage/entry.rb
@@ -0,0 +1,81 @@
+class Storage::Entry < ApplicationRecord
+  BATCH_SIZE = 1_000
+
+  belongs_to :account
+  belongs_to :source, polymorphic: true, optional: true
+
+  scope :pending, -> { where(dirty: true) }
+
+  after_create_commit :reconcile_later
+
+  def self.backfill_batch(account, after: nil)
+    attachments = ActiveStorage::Attachment.where(account: account).order(:id).limit(BATCH_SIZE)
+    attachments = attachments.where(ActiveStorage::Attachment.arel_table[:id].gt(after)) if after
+    batch = attachments.preload(:blob).to_a
+    batch.each(&:track_storage_usage)
+    batch.last.id if batch.size == BATCH_SIZE
+  end
+
+  def self.reconcile_pending
+    pending.limit(BATCH_SIZE).each do |entry|
+      Storage::ReconcileJob.perform_now(entry.account, entry.id)
+    end
+  end
+
+  def self.reconcile_source_batch(account, source_type, source_id, after: nil)
+    entries = where(account: account, source_type: source_type, source_id: source_id).pending.order(:id).limit(BATCH_SIZE)
+    entries = entries.where(arel_table[:id].gt(after)) if after
+    batch = entries.to_a
+    batch.each(&:reconcile_now)
+    batch.last.id if batch.size == BATCH_SIZE
+  end
+
+  def mark_dirty
+    # Do not use dirty tracking here: a worker may have cleared the flag since
+    # this instance was loaded. The unconditional write also serializes with it.
+    update_columns(dirty: true)
+    reconcile_later
+  end
+
+  def reconcile_later
+    Storage::ReconcileJob.perform_later(account, id)
+  end
+
+  def reconcile_now
+    with_lock do
+      if dirty?
+        new_board_id = current_board_id
+        attached = ActiveStorage::Attachment.exists?(attachment_id)
+        new_bytes = new_board_id && attached ? byte_size : 0
+
+        # Always update the account first, then boards in a stable order. Only
+        # workers contend on these totals; uploads never lock account-wide rows.
+        Storage::Total.adjust(account, "Account", account_id, new_bytes - accounted_bytes)
+        board_changes = Hash.new(0)
+        board_changes[board_id] -= accounted_bytes if board_id
+        board_changes[new_board_id] += new_bytes if new_board_id
+        board_changes.sort.each do |id, delta|
+          Storage::Total.adjust(account, "Board", id, delta)
+        end
+
+        if attached
+          update!(board_id: new_board_id, accounted_bytes: new_bytes, dirty: false)
+        else
+          destroy!
+        end
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Another worker may have reconciled and removed a detached entry already.
+    raise if self.class.exists?(id)
+  end
+
+  private
+    def current_board_id
+      if source_type == "Card"
+        Card.where(account_id: account_id, id: source_id).pick(:board_id)
+      else
+        Board.where(account_id: account_id, id: source_id).pick(:id)
+      end
+    end
+end
diff --git a/app/models/storage/total.rb b/app/models/storage/total.rb
new file mode 100644
index 0000000..10a6399
--- /dev/null
+++ b/app/models/storage/total.rb
@@ -0,0 +1,14 @@
+class Storage::Total < ApplicationRecord
+  belongs_to :account
+  # Deleted boards keep their total until account cleanup: outstanding entries
+  # still need to subtract their previously accounted bytes.
+  belongs_to :owner, polymorphic: true, optional: true
+
+  def self.adjust(account, owner_type, owner_id, bytes)
+    unless bytes.zero?
+      total = find_by(owner_type: owner_type, owner_id: owner_id) ||
+        create_or_find_by!(owner_type: owner_type, owner_id: owner_id) { |total| total.account = account }
+      where(id: total.id).update_counters(bytes_used: bytes)
+    end
+  end
+end
