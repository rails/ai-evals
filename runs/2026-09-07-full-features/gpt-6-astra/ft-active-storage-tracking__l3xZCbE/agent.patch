+module Card::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_update :move_storage_usage, if: :saved_change_to_board_id?
+  end
+
+  private
+    def move_storage_usage
+      # Mark within the move transaction, before Card's nested updates clear its
+      # saved changes. Comment attachments use the card as their source too.
+      if ::Storage::Entry.where(source: self).update_all(dirty: true).positive?
+        ::Storage::ReconcileSourceJob.perform_later(account, self.class.name, id)
+      end
+    end
+end
