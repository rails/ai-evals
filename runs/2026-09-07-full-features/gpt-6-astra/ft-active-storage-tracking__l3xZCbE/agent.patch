@@ -0,0 +1,47 @@
+require "test_helper"
+
+class StorageConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "concurrent workers reconcile distinct and duplicate entries without losing increments" do
+    account = accounts("37s")
+    board = boards(:writebook)
+    created_cards = 8.times.map do |index|
+      board.cards.create!(title: "Storage concurrency #{index}").tap do |card|
+        card.image.attach io: StringIO.new("x" * (index + 1)), filename: "file.txt", content_type: "text/plain"
+      end
+    end
+    entries = Storage::Entry.where(account: account).order(:id).pluck(:id)
+    ready, start = Queue.new, Queue.new
+
+    workers = [ entries, entries.reverse ].map do |ids|
+      Thread.new do
+        Rails.application.executor.wrap do
+          ActiveRecord::Base.connection_pool.with_connection do
+            ready << true
+            start.pop
+            ids.each { |id| Storage::Entry.find(id).reconcile_now }
+          end
+        end
+      end
+    end
+    workers.size.times { ready.pop }
+    workers.size.times { start << true }
+    workers.each(&:value)
+
+    assert_equal 36, account.bytes_used
+    assert_equal 36, board.bytes_used
+    assert_empty Storage::Entry.pending
+  ensure
+    workers&.each(&:join)
+    created_cards&.each do |card|
+      card.image.purge
+      card.destroy!
+    end
+    Storage::Entry.reconcile_pending
+  end
+end
diff --git a/test/models/storage/usage_test.rb b/test/models/storage/usage_test.rb
