+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,9 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from Current.user.accessible_cards
+      .where(account: Current.account).search(@query).preload(:board, :rich_text_description)
+    @comments_by_card = Current.user.accessible_comments.search(@query)
+      .where(card_id: @page.records.map(&:id)).with_rich_text_body.chronologically.group_by(&:card_id)
+  end
+end
