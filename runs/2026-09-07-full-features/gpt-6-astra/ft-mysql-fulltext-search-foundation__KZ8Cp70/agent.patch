diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..4b262d6
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section class="search panel center-block">
+  <%= form_with url: search_path, method: :get, role: "search", class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", class: "input", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.blank? %>
+    <p>Search card titles, descriptions, and comments.</p>
+  <% elsif @page.records.empty? %>
+    <p>No cards found.</p>
+  <% else %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <%= tag.article class: "search-result margin-block", data: { search_card: card.number } do %>
+          <p class="txt-small"><%= card.board.name %> · #<%= card.number %> · <%= local_datetime_tag card.created_at, style: :date %></p>
+          <h2><%= link_to highlight_search_result(card.title, @query), card_path(card) %></h2>
+          <p class="search-result__description"><%= highlight_search_result(card.description.to_plain_text, @query) %></p>
+          <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+            <blockquote class="search-result__comment"><%= highlight_search_result(comment.body.to_plain_text, @query) %></blockquote>
+          <% end %>
+        <% end %>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
