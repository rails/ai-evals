@@ -0,0 +1,12 @@
+module SearchesHelper
+  def highlight_search_result(text, query)
+    if query.present?
+      pattern = Regexp.new("(#{Regexp.union(query.split).source})", Regexp::IGNORECASE)
+      safe_join(text.to_s.split(pattern).each_with_index.map do |part, index|
+        index.odd? ? tag.mark(part) : part
+      end)
+    else
+      ERB::Util.html_escape(text)
+    end
+  end
+end
