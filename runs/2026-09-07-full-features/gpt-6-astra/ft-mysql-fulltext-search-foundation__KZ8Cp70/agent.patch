diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9acbafc
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "searches titles descriptions and comments once per card newest first" do
+    cards(:logo).update! title: "Needle in title", created_at: 3.days.ago
+    cards(:layout).update! description: "<p>A NEEDLE in the description</p>", created_at: 2.days.ago
+    cards(:text).update! created_at: 1.day.ago
+    2.times { cards(:text).comments.create! body: "A needle in a comment", creator: users(:kevin) }
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map(&:number).map(&:to_s),
+      css_select("[data-search-card]").map { |element| element["data-search-card"] }
+    assert_select "h2 mark", text: "Needle"
+    assert_select ".search-result__description mark", text: "NEEDLE"
+    assert_select ".search-result__comment mark", text: "needle", count: 2
+  end
+
+  test "only searches currently accessible boards in the current account" do
+    cards(:logo).update! title: "Visibilityneedle"
+    cards(:radio).update! title: "Visibilityneedle"
+    private_card = boards(:private).cards.create! title: "Visibilityneedle", status: :published, creator: users(:kevin)
+
+    get search_path, params: { q: "visibilityneedle" }
+    assert_select "[data-search-card]", count: 2
+
+    accesses(:private_kevin).destroy!
+    get search_path, params: { q: "visibilityneedle" }
+    assert_select "[data-search-card]", count: 1
+    assert_select "[data-search-card='#{cards(:logo).number}']"
+    assert_select "a[href=?]", card_path(private_card), count: 0
+  end
+
+  test "drafts and their comments are excluded even for their creator" do
+    cards(:text).comments.create! body: "Draftcommentneedle", creator: users(:kevin)
+    cards(:text).update! title: "Drafttitleneedle", description: "Draftdescriptionneedle", status: :drafted
+
+    %w[ Drafttitleneedle Draftdescriptionneedle Draftcommentneedle ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select "[data-search-card]", count: 0
+    end
+  end
+
+  test "blank and missing queries do not return all cards" do
+    [ nil, "", "   " ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_select "[data-search-card]", count: 0
+      assert_select "form[action=?][method=get]", search_path
+      assert_select "input[name=q]"
+    end
+  end
+
+  test "literal SQL wildcards and quotes are safe" do
+    cards(:logo).update! title: "100%_literal's progress"
+
+    get search_path, params: { q: "%_literal's" }
+    assert_response :success
+    assert_select "[data-search-card]", count: 1
+    assert_select "mark", text: "%_literal's"
+
+    get search_path, params: { q: "' OR 1=1 --" }
+    assert_response :success
+    assert_select "[data-search-card]", count: 0
+  end
+
+  test "highlights escaped text without rendering title HTML" do
+    cards(:logo).update! title: '<img src=x onerror="alert(1)"> Safeneedle'
+
+    get search_path, params: { q: "safeneedle" }
+    assert_response :success
+    assert_select "[data-search-card] img", count: 0
+    assert_select "[data-search-card] mark", text: "Safeneedle"
+    assert_includes css_select("[data-search-card] h2").first.text, "<img"
+  end
+
+  test "matches multiple words across fields" do
+    cards(:logo).update! title: "Firstneedle title", description: "Secondneedle description"
+    cards(:layout).update! title: "Firstneedle only"
+
+    get search_path, params: { q: "  firstneedle   secondneedle  " }
+    assert_response :success
+    assert_select "[data-search-card]", count: 1
+    assert_select "h2 mark", text: "Firstneedle"
+    assert_select ".search-result__description mark", text: "Secondneedle"
+  end
+
+  test "inaccessible comment matches do not leak cards" do
+    private_card = boards(:private).cards.create! title: "Private", status: :published, creator: users(:kevin)
+    private_card.comments.create! body: "Secretcommentneedle", creator: users(:kevin)
+    cards(:radio).comments.create! body: "Secretcommentneedle", creator: users(:mike)
+    accesses(:private_kevin).destroy!
+
+    get search_path, params: { q: "secretcommentneedle" }
+    assert_response :success
+    assert_select "[data-search-card]", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "search reflects edited and deleted comments" do
+    comment = cards(:logo).comments.create! body: "Oldcommentneedle", creator: users(:kevin)
+    comment.update! body: "Newcommentneedle"
+
+    get search_path, params: { q: "oldcommentneedle" }
+    assert_select "[data-search-card]", count: 0
+    get search_path, params: { q: "newcommentneedle" }
+    assert_select "[data-search-card]", count: 1
+
+    comment.destroy!
+    get search_path, params: { q: "newcommentneedle" }
+    assert_select "[data-search-card]", count: 0
+  end
+
+  test "moving a matching card to an inaccessible board removes it from search" do
+    cards(:logo).comments.create! body: "Movingneedle", creator: users(:kevin)
+    accesses(:private_kevin).destroy!
+
+    get search_path, params: { q: "movingneedle" }
+    assert_select "[data-search-card]", count: 1
+
+    # Keep the comment attached to the same card while changing its board.
+    cards(:logo).update_columns(board_id: boards(:private).id, column_id: nil)
+    get search_path, params: { q: "movingneedle" }
+    assert_select "[data-search-card]", count: 0
+  end
+
+  test "paginates newest first while preserving the query and matching comments" do
+    matching_cards = 16.times.map do |index|
+      boards(:writebook).cards.create! title: "Pagingneedle #{index}", status: :published,
+        creator: users(:kevin), created_at: index.minutes.ago
+    end
+    matching_cards.last.comments.create! body: "Pagingneedle comment", creator: users(:kevin)
+
+    get search_path, params: { q: "pagingneedle" }
+    assert_response :success
+    assert_equal matching_cards.first(15).map { |card| card.number.to_s },
+      css_select("[data-search-card]").map { |element| element["data-search-card"] }
+    next_page = css_select("a[aria-label='Load page 2']").first["href"]
+    assert_includes next_page, "q=pagingneedle"
+
+    get next_page
+    assert_response :success
+    assert_select "[data-search-card]", count: 1
+    assert_select "[data-search-card='#{matching_cards.last.number}']"
+    assert_select ".search-result__comment mark", text: "Pagingneedle"
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
new file mode 100644
index 0000000..3636e49
--- /dev/null
+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlights case insensitive literal matches" do
+    assert_equal "<mark>C++</mark> and <mark>c++</mark>", highlight_search_result("C++ and c++", "c++")
+    assert_equal "<mark>[word]</mark>", highlight_search_result("[word]", "[word]")
+  end
+
+  test "escapes content both inside and outside marks" do
+    assert_equal "&lt;script&gt;<mark>alert</mark>(1)&lt;/script&gt;",
+      highlight_search_result("<script>alert(1)</script>", "alert")
+    assert_equal "<mark>&lt;script&gt;</mark>", highlight_search_result("<script>", "<script>")
+    assert_equal "A <mark>&amp;</mark> B", highlight_search_result("A & B", "&")
+  end
+
+  test "handles blank text and blank queries" do
+    assert_equal "", highlight_search_result(nil, "word")
+    assert_equal "&lt;b&gt;word&lt;/b&gt;", highlight_search_result("<b>word</b>", "")
+    assert_equal "word", highlight_search_result("word", " ")
+  end
+end
