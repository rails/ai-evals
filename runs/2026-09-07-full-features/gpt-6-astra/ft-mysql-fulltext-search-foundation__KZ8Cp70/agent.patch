diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..cabc17f
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,21 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      if query.present?
+        query.split.reduce(published) do |cards, word|
+          pattern = "%#{sanitize_sql_like(word.downcase, "!")}%"
+          descriptions = ActionText::RichText.where(record_type: "Card", name: "description")
+            .where("LOWER(body) LIKE ? ESCAPE '!'", pattern)
+
+          cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern)
+            .or(cards.where(id: descriptions.select(:record_id)))
+            .or(cards.where(id: Comment.search(word).select(:card_id)))
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
