diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..dee1579
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,65 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :delete_all
+  has_many :notifications, through: :items
+
+  validates :starts_at, :ends_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }, if: -> { starts_at && ends_at }
+
+  before_create :prevent_overlapping_windows
+  attr_readonly :user_id, :account_id, :starts_at, :ends_at
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+
+  class << self
+    def add(notification)
+      user = User.find(notification.user_id)
+
+      user.with_lock do
+        # A write also serializes window assignment on SQLite, where SELECT FOR
+        # UPDATE is unavailable. Failed lock upgrades roll back rather than overlap.
+        user.touch
+        if user.active? && user.account.active? && (interval = user.settings&.reload&.bundle_email_interval)
+          now = Time.current
+          # No lower bound: an out-of-order arrival belongs to the window already
+          # opened, rather than creating an earlier, overlapping window.
+          bundle = user.notification_bundles.lock.where("ends_at > ?", now).order(:ends_at).first
+          bundle ||= user.notification_bundles.create!(starts_at: now, ends_at: now + interval)
+          bundle.items.find_or_create_by!(notification: notification)
+          bundle
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each do |bundle|
+        Current.with(account: bundle.account) { DeliveryJob.perform_later(bundle) }
+      end
+    end
+  end
+
+  def deliver
+    with_lock do
+      if delivered_at.nil? && ends_at <= Time.current
+        touch # Acquire SQLite's write lock before sending, not after.
+        if user.active? && account.active? && user.identity && user.settings&.bundle_email_interval && notifications.exists?
+          NotificationMailer.bundle(self).deliver_now
+        end
+        update!(delivered_at: Time.current)
+      end
+    end
+  end
+
+  private
+    def prevent_overlapping_windows
+      owner = User.find(user_id)
+      owner.lock!
+      owner.touch
+      if user.notification_bundles.lock.where("starts_at < ? AND ends_at > ?", ends_at, starts_at).exists?
+        errors.add(:base, "Email digest windows cannot overlap")
+        throw :abort
+      end
+    end
+end
