diff --git a/test/models/notification/bundle_concurrency_test.rb b/test/models/notification/bundle_concurrency_test.rb
new file mode 100644
index 0000000..ed488d0
--- /dev/null
+++ b/test/models/notification/bundle_concurrency_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Notification::BundleConcurrencyTest < ActiveSupport::TestCase
+  self.use_transactional_tests = false
+
+  setup do
+    @user = User.create!(account: accounts("37s"), name: "Digest concurrency", identity: Identity.create!(email_address: "digest-concurrency@example.com"))
+    @notification = Notification.create!(user: @user, creator: users(:david), source: events(:logo_assignment_km))
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  teardown do
+    identity = @user.identity
+    @user.destroy!
+    identity.destroy!
+  end
+
+  test "concurrent arrivals share one window and one membership" do
+    concurrently do
+      Notification::Bundle.add(Notification.find(@notification.id))
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal [ @notification ], @user.notification_bundles.sole.notifications
+  end
+
+  test "concurrent delivery workers send only one email" do
+    bundle = Notification::Bundle.add(@notification)
+    travel_to bundle.ends_at + 1.second do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        concurrently { Notification::Bundle.find(bundle.id).deliver }
+      end
+    end
+    assert bundle.reload.delivered_at
+  end
+
+  private
+    def concurrently(&block)
+      ready = Queue.new
+      start = Queue.new
+      workers = 4.times.map do
+        Thread.new do
+          ActiveRecord::Base.connection_pool.with_connection do
+            ready << true
+            start.pop
+            block.call
+          end
+        end
+      end
+      4.times { ready.pop }
+      4.times { start << true }
+      workers.each(&:value)
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..2364daa
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,224 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "the first arrival starts a four hour window" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert_equal [ @notification ], bundle.notifications
+    end
+  end
+
+  test "late arrivals join the open window without moving its boundaries" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      travel 1.hour
+      late_notification = notifications(:layout_commented_kevin)
+      late_notification.update_columns(created_at: 2.days.ago, updated_at: 2.days.ago)
+
+      assert_no_difference "Notification::Bundle.count" do
+        assert_equal bundle, Notification::Bundle.add(late_notification)
+      end
+      assert_equal 3.hours.from_now, bundle.reload.ends_at
+      assert_equal 2, bundle.notifications.count
+    end
+  end
+
+  test "repeated assignment is idempotent" do
+    bundle = Notification::Bundle.add(@notification)
+    Notification::Bundle.add(@notification)
+
+    assert_equal 1, bundle.notifications.count
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference "Notification::Bundle.count" do
+      assert_nil Notification::Bundle.add(@notification)
+    end
+  end
+
+  test "daily and weekly windows start at arrival time" do
+    freeze_time do
+      { daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+        @user.settings.update!(bundle_email_frequency: frequency)
+        bundle = Notification::Bundle.add(@notification)
+        assert_equal Time.current, bundle.starts_at
+        assert_equal duration.from_now, bundle.ends_at
+        travel duration
+      end
+    end
+  end
+
+  test "frequency changes do not create overlapping windows" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      travel 1.hour
+      @user.settings.update!(bundle_email_frequency: :weekly)
+      assert_equal bundle, Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+      travel 3.hours
+      next_bundle = Notification::Bundle.add(@notification)
+      assert_equal bundle.ends_at, next_bundle.starts_at
+      assert_equal 1.week.from_now, next_bundle.ends_at
+    end
+  end
+
+  test "different users have independent windows" do
+    other = notifications(:logo_mentioned_david)
+    other.user.settings.update!(bundle_email_frequency: :daily)
+
+    first = Notification::Bundle.add(@notification)
+    second = Notification::Bundle.add(other)
+
+    assert_not_equal first, second
+    assert_equal @user, first.user
+    assert_equal other.user, second.user
+    assert_equal 1.day, second.ends_at - second.starts_at
+  end
+
+  test "overlapping windows are rejected even when created directly" do
+    bundle = Notification::Bundle.add(@notification)
+
+    [ [ -1.hour, 1.hour ], [ 1.hour, 5.hours ], [ -1.hour, 5.hours ] ].each do |start_offset, end_offset|
+      overlapping = @user.notification_bundles.build(starts_at: bundle.starts_at + start_offset, ends_at: bundle.starts_at + end_offset)
+      assert_not overlapping.save
+      assert_includes overlapping.errors[:base], "Email digest windows cannot overlap"
+    end
+  end
+
+  test "new notifications and new activity on existing notifications are bundled" do
+    notifications(:layout_commented_kevin).destroy!
+    notification = Notification.create!(user: @user, creator: users(:david), source: events(:layout_commented))
+    bundle = @user.notification_bundles.sole
+    assert_includes bundle.notifications, notification
+
+    travel 4.hours
+    @notification.update!(source: events(:logo_published))
+    assert_equal 2, @user.notification_bundles.count
+    assert_includes @user.notification_bundles.order(:starts_at).last.notifications, @notification
+  end
+
+  test "reading a notification does not open a digest window" do
+    assert_no_difference "Notification::Bundle.count" do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "delivery sends one email containing the window's notifications" do
+    freeze_time do
+      bundle = Notification::Bundle.add(@notification)
+      Notification::Bundle.add(notifications(:layout_commented_kevin))
+
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+
+      travel 4.hours
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        bundle.deliver
+        bundle.reload.deliver
+      end
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ @user.identity.email_address ], mail.to
+      assert_includes mail.html_part.body.decoded, ERB::Util.html_escape(@notification.payload.title)
+      assert_includes mail.text_part.body.decoded, notifications(:layout_commented_kevin).payload.title
+      assert_includes mail.html_part.body.decoded, @notification.payload.url
+      assert_equal Time.current, bundle.reload.delivered_at
+    end
+  end
+
+  test "opting out suppresses a pending digest" do
+    bundle = Notification::Bundle.add(@notification)
+    @user.settings.update!(bundle_email_frequency: :never)
+    travel 4.hours
+
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered_at
+  end
+
+  test "empty digests and deactivated users do not receive email" do
+    bundle = Notification::Bundle.add(@notification)
+    @notification.destroy!
+    travel 4.hours
+    assert_no_difference("ActionMailer::Base.deliveries.size") { bundle.deliver }
+
+    bundle = Notification::Bundle.add(notifications(:layout_commented_kevin))
+    @user.deactivate
+    travel 4.hours
+    assert_no_difference("ActionMailer::Base.deliveries.size") { bundle.deliver }
+  end
+
+  test "the recurring task delivers only due bundles and is safe to repeat" do
+    bundle = Notification::Bundle.add(@notification)
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliveryJob) { Notification::Bundle.deliver_due }
+    travel 4.hours
+
+    assert_difference "ActionMailer::Base.deliveries.size", 1 do
+      perform_enqueued_jobs(only: Notification::Bundle::DeliveryJob) do
+        Notification::Bundle.deliver_due
+        Notification::Bundle.deliver_due
+      end
+    end
+    assert bundle.reload.delivered_at
+  end
+test "an idle gap does not generate empty windows" do
+  bundle = Notification::Bundle.add(@notification)
+  travel 2.days
+  next_bundle = Notification::Bundle.add(@notification)
+
+  assert_equal 2, @user.notification_bundles.count
+  assert_equal Time.current, next_bundle.starts_at
+  assert_operator next_bundle.starts_at, :>, bundle.ends_at
+end
+
+test "delivery failures leave the bundle pending for retry" do
+  bundle = Notification::Bundle.add(@notification)
+  travel 4.hours
+  NotificationMailer.expects(:bundle).raises(Net::SMTPServerBusy.new("451 Try again later"))
+
+  assert_raises(Net::SMTPServerBusy) { bundle.deliver }
+  assert_nil bundle.reload.delivered_at
+end
+test "turning email off and back on does not open an overlapping window" do
+  bundle = Notification::Bundle.add(@notification)
+  travel 1.hour
+  @user.settings.update!(bundle_email_frequency: :never)
+  assert_nil Notification::Bundle.add(@notification)
+  @user.settings.update!(bundle_email_frequency: :daily)
+
+  assert_equal bundle, Notification::Bundle.add(@notification)
+  assert_equal 3.hours.from_now, bundle.reload.ends_at
+end
+
+test "window boundaries cannot be changed after creation" do
+  bundle = Notification::Bundle.add(@notification)
+
+  assert_raises(ActiveRecord::ReadonlyAttributeError) do
+    bundle.update!(ends_at: 1.week.from_now)
+  end
+  assert_equal 4.hours.from_now, bundle.reload.ends_at
+end
+
+test "windows must have a positive duration" do
+  [ Time.current, 1.second.ago ].each do |ends_at|
+    bundle = @user.notification_bundles.build(starts_at: Time.current, ends_at: ends_at)
+    assert_not bundle.valid?
+    assert bundle.errors[:ends_at].present?
+  end
+end
+end
