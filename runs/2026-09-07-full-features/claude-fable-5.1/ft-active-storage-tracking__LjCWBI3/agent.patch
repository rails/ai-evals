+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts card images" do
+    attach_image_to @card, byte_size: 100
+    recalculate_bytes_used
+
+    assert_equal 100, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    @card.update!(description: "<p>See attached</p>#{embed(upload(1_000))}")
+    recalculate_bytes_used
+
+    assert_equal 1_000, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    @card.comments.create!(body: "<p>Here</p>#{embed(upload(10_000))}")
+    recalculate_bytes_used
+
+    assert_equal 10_000, @board.reload.bytes_used
+  end
+
+  test "counts files embedded in the board description" do
+    @board.update!(public_description: "<p>About</p>#{embed(upload(100_000))}")
+    recalculate_bytes_used
+
+    assert_equal 100_000, @board.reload.bytes_used
+  end
+
+  test "adds up everything on the board and its cards" do
+    attach_image_to @card, byte_size: 100
+    @card.update!(description: embed(upload(1_000)))
+    @card.comments.create!(body: embed(upload(10_000)))
+    cards(:layout).comments.create!(body: embed(upload(20_000)))
+    @board.update!(public_description: embed(upload(100_000)))
+    recalculate_bytes_used
+
+    assert_equal 131_100, @board.reload.bytes_used
+  end
+
+  test "does not count files on other boards" do
+    cards(:radio).update!(description: embed(upload(1_000)))
+    recalculate_bytes_used
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 1_000, boards(:miltons_wish_list).reload.bytes_used
+  end
+
+  test "stops counting removed files" do
+    attach_image_to @card, byte_size: 100
+    @card.update!(description: embed(upload(1_000)))
+    comment = @card.comments.create!(body: embed(upload(10_000)))
+    recalculate_bytes_used
+    assert_equal 11_100, @board.reload.bytes_used
+
+    @card.update!(image: nil)
+    recalculate_bytes_used
+    assert_equal 11_000, @board.reload.bytes_used
+
+    @card.update!(description: "<p>No more attachment</p>")
+    recalculate_bytes_used
+    assert_equal 10_000, @board.reload.bytes_used
+
+    comment.destroy!
+    recalculate_bytes_used
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+test "stops counting comments destroyed along with their creator" do
+  @card.comments.create!(body: embed(upload(10_000)), creator: users(:kevin))
+  recalculate_bytes_used
+  assert_equal 10_000, @board.reload.bytes_used
+
+  users(:kevin).destroy!
+  recalculate_bytes_used
+  assert_equal 0, @board.reload.bytes_used
+end
+
+test "stops counting destroyed cards" do
+    attach_image_to @card, byte_size: 100
+    @card.comments.create!(body: embed(upload(10_000)))
+    recalculate_bytes_used
+    assert_equal 10_100, @board.reload.bytes_used
+
+    @card.destroy!
+    recalculate_bytes_used
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "follows cards moved to another board" do
+    other_board = boards(:private)
+
+    attach_image_to @card, byte_size: 100
+    @card.comments.create!(body: embed(upload(10_000)))
+    recalculate_bytes_used
+    assert_equal 10_100, @board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    @card.move_to(other_board)
+    recalculate_bytes_used
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 10_100, other_board.reload.bytes_used
+  end
+
+  test "recalculates in the background" do
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      @card.update!(description: embed(upload(1_000)))
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "does not recalculate for changes that can't affect storage" do
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      @card.update!(last_active_at: Time.current)
+      @board.update!(name: "New name")
+      users(:david).draft_new_card_in(@board)
+    end
+  end
+
+  test "does not recalculate boards being destroyed along with their cards" do
+    @card.update!(description: embed(upload(1_000)))
+
+    assert_no_enqueued_jobs only: Board::RecalculateBytesUsedJob do
+      @board.destroy!
+    end
+  end
+
+  test "skips recalculations already covered by a later one" do
+    @card.update!(description: embed(upload(1_000)))
+    @board.recalculate_bytes_used
+    @board.update_columns(bytes_used: 42)
+
+    recalculate_bytes_used
+
+    assert_equal 42, @board.reload.bytes_used
+  end
+
+private
+  def recalculate_bytes_used
+    perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+  end
+
+  def attach_image_to(card, byte_size:)
+      card.image.attach(io: StringIO.new("i" * byte_size), filename: "image.png", content_type: "image/png")
+    end
+
+    def upload(byte_size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("f" * byte_size), filename: "file-#{byte_size}.bin", content_type: "application/octet-stream")
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
