diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..e6ad852
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts(:"37s")
+  end
+
+  test "adds up the storage used across all boards" do
+    cards(:logo).update!(description: embed(upload(1_000)))
+    card_on(boards(:private)).comments.create!(body: embed(upload(10_000)))
+    cards(:radio).update!(description: embed(upload(100_000)))
+    recalculate_bytes_used
+
+    assert_equal 1_000, boards(:writebook).reload.bytes_used
+    assert_equal 10_000, boards(:private).reload.bytes_used
+    assert_equal 11_000, @account.reload.bytes_used
+    assert_equal 100_000, accounts(:initech).reload.bytes_used
+  end
+
+  test "stops counting destroyed boards" do
+    cards(:logo).update!(description: embed(upload(1_000)))
+    card_on(boards(:private)).update!(description: embed(upload(10_000)))
+    recalculate_bytes_used
+    assert_equal 11_000, @account.reload.bytes_used
+
+    boards(:writebook).destroy!
+    recalculate_bytes_used
+    assert_equal 10_000, @account.reload.bytes_used
+  end
+
+  test "recalculates in the background" do
+    boards(:writebook).update_columns(bytes_used: 1_000)
+
+    assert_enqueued_with job: Account::RecalculateBytesUsedJob, args: [ @account ] do
+      boards(:private).destroy!
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+
+    recalculate_bytes_used
+
+    assert_equal 1_000, @account.reload.bytes_used
+  end
+
+  test "does not recalculate when the whole account is destroyed" do
+    assert_no_enqueued_jobs only: Account::RecalculateBytesUsedJob do
+      @account.destroy!
+    end
+  end
+
+  private
+    def recalculate_bytes_used
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+    end
+
+    def card_on(board)
+      board.cards.create!(title: "A card", status: "published", creator: users(:kevin))
+    end
+
+    def upload(byte_size)
+      ActiveStorage::Blob.create_and_upload!(io: StringIO.new("f" * byte_size), filename: "file-#{byte_size}.bin", content_type: "application/octet-stream")
+    end
+
+    def embed(blob)
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+end
