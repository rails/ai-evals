+++ b/test/jobs/board/recalculate_bytes_used_job_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Board::RecalculateBytesUsedJobTest < ActiveJob::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @board.update_columns(bytes_used: 42)
+  end
+
+  test "recalculates the board and account" do
+    Board::RecalculateBytesUsedJob.perform_now(@board)
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @board.account.reload.bytes_used
+  end
+
+  test "recalculates when requested after the last recalculation" do
+    @board.update_columns(bytes_used_calculated_at: 1.minute.ago)
+
+    Board::RecalculateBytesUsedJob.perform_later(@board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "skips requests already covered by a later recalculation" do
+    Board::RecalculateBytesUsedJob.perform_later(@board)
+    @board.update_columns(bytes_used_calculated_at: 1.minute.from_now)
+
+    perform_enqueued_jobs
+
+    assert_equal 42, @board.reload.bytes_used
+  end
+
+  test "runs one recalculation at a time per board" do
+    job = Board::RecalculateBytesUsedJob.new(@board)
+
+    assert_equal 1, job.class.concurrency_limit
+    assert_includes job.concurrency_key, @board.id
+  end
+  test "discards requests for boards that no longer exist" do
+    Board::RecalculateBytesUsedJob.perform_later(@board)
+    @board.destroy!
+
+    assert_nothing_raised { perform_enqueued_jobs only: Board::RecalculateBytesUsedJob }
+  end
+end
