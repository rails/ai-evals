+                data-action="reactions#pick dialog#close" data-reactions-emoji-param="<%= emoji %>">
+              <%= emoji %>
+              <span class="for-screen-reader"><%= description %></span>
+            </button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <label class="reaction__form-label flex align-center">
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content, id: nil, class: "input reaction__input", placeholder: "React…", required: true, autocomplete: "off",
