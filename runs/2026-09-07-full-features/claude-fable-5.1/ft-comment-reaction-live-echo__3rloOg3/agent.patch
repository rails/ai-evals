new file mode 100644
index 0000000..090e3f5
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,34 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction in the strip. Only the person who left it can expand it
+// to reveal the delete button; everyone else just sees who reacted with what.
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#mine) this.element.classList.add(this.deleteableClass)
+  }
+
+  toggle(event) {
+    if (!this.#mine || event.target.closest("form")) return
+
+    this.element.classList.toggle(this.expandedClass)
+  }
+
+  collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  deleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #mine() {
+    return window.Current?.user?.id === this.reacterIdValue
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..4307830
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,46 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" trigger for a small inline form, and back again
+// once a reaction has been submitted or the form is dismissed.
+export default class extends Controller {
+  static targets = [ "form", "input", "trigger" ]
+  static classes = [ "reaction", "expanded" ]
+
+  disconnect() {
+    this.#stopGuardingAgainstMorphs()
+  }
+
+  expand() {
+    this.#guardAgainstMorphs()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(this.reactionClass, this.expandedClass)
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.classList.remove(this.reactionClass, this.expandedClass)
+    this.formTarget.hidden = true
+    this.formTarget.reset()
+    this.triggerTarget.hidden = false
+    this.#stopGuardingAgainstMorphs()
+  }
+
+  submitEnd({ detail: { success } }) {
+    if (success) this.collapse()
+  }
+
+  pick({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.formTarget.requestSubmit()
+  }
+
+  // Keep a reaction in progress from being wiped out by a broadcasted page refresh
+  #guardAgainstMorphs() {
+    this.element.setAttribute("data-turbo-permanent", "")
+  }
+
+  #stopGuardingAgainstMorphs() {
+    this.element.removeAttribute("data-turbo-permanent")
+  }
+}
