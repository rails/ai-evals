@@ -0,0 +1,21 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_CONTENT_LENGTH = 16
+  EMOJI_ONLY_PATTERN = /\A(?:(?:\p{Extended_Pictographic}|\p{Regional_Indicator})[\p{Emoji_Modifier}\uFE0F\u200D]*|\s)+\z/
+
+  belongs_to :account, default: -> { reactable.account }
+  belongs_to :reactable, polymorphic: true, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  delegate :card, :board, to: :reactable
+
+  def emoji_only?
+    content.to_s.match?(EMOJI_ONLY_PATTERN)
+  end
+end
