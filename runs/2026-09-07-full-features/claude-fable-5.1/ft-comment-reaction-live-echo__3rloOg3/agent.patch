+        data: { reactions_target: "form", action: "turbo:submit-end->reactions#submitEnd keydown.esc->reactions#collapse:stop" } do |form| %>
+    <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Pick an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel shadow" data-dialog-target="dialog"
+          data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, description| %>
