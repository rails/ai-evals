diff --git a/test/models/account/storage_tracking_test.rb b/test/models/account/storage_tracking_test.rb
new file mode 100644
index 0000000..135a5d6
--- /dev/null
+++ b/test/models/account/storage_tracking_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::StorageTrackingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+  end
+
+  test "bytes used is zero until something is counted" do
+    assert_equal 0, @account.bytes_used
+    assert_nil @account.storage_usage
+  end
+
+  test "everything counted on the account's boards adds up" do
+    cards(:logo).image.attach(create_blob(100))
+    cards(:logo).comments.create!(body: embed(create_blob(40)))
+    boards(:writebook).update!(public_description: embed(create_blob(50)))
+    boards(:private).cards.create!(title: "Elsewhere", status: :published, description: embed(create_blob(30)))
+
+    assert_bytes_used 220
+  end
+
+  test "attachments that aren't card images or embedded files don't count" do
+    users(:david).avatar.attach(create_blob(1000))
+    Account::Export.create!(account: @account, user: users(:david)).file.attach(create_blob(2000))
+
+    cards(:logo).image.attach(create_blob(1))
+
+    assert_bytes_used 1
+  end
+
+  test "attachments on other accounts don't count" do
+    Current.account = accounts(:initech)
+    cards(:radio).image.attach(create_blob(100))
+
+    Current.account = @account
+    cards(:logo).image.attach(create_blob(1))
+
+    assert_bytes_used 1
+    assert_bytes_used 100, accounts(:initech)
+  end
+
+  test "destroying a board is subtracted" do
+    cards(:logo).image.attach(create_blob(100))
+    boards(:private).cards.create!(title: "Elsewhere", status: :published, description: embed(create_blob(30)))
+    assert_bytes_used 130
+
+    boards(:private).destroy
+
+    assert_bytes_used 100
+  end
+
+  test "moving a card between boards doesn't change the account's usage" do
+    cards(:logo).image.attach(create_blob(100))
+    assert_bytes_used 100
+
+    cards(:logo).move_to(boards(:private))
+
+    assert_bytes_used 100
+  end
+
+  test "changes on a busy account are coalesced into a single recalculation" do
+    assert_enqueued_jobs 2, only: StorageUsage::RecalculationJob do
+      cards(:logo).image.attach(create_blob(1))
+      cards(:layout).image.attach(create_blob(1))
+      cards(:text).image.attach(create_blob(1))
+    end
+
+    assert_bytes_used 3
+  end
+
+  test "destroying the account destroys its usage" do
+    cards(:logo).image.attach(create_blob(100))
+    assert_bytes_used 100
+
+    assert_difference -> { StorageUsage.count }, -2 do
+      @account.destroy
+    end
+  end
+
+  private
+    def create_blob(byte_size)
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * byte_size), filename: "#{byte_size}.txt", content_type: "text/plain"
+    end
+
+    def embed(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def assert_bytes_used(expected, account = @account)
+      perform_enqueued_jobs only: StorageUsage::RecalculationJob
+      assert_equal expected, account.reload.bytes_used
+    end
+end
