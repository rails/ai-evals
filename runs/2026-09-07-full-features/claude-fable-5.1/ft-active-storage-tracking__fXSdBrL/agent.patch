@@ -0,0 +1,29 @@
+module StorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :storage_usage, as: :container, dependent: :destroy
+  end
+
+  def bytes_used
+    storage_usage&.bytes_used || 0
+  end
+
+  def recalculate_bytes_used_later
+    find_or_create_storage_usage.recalculate_later unless destroyed?
+  end
+
+  def recalculate_bytes_used_now
+    find_or_create_storage_usage.recalculate_now
+  end
+
+  private
+    def find_or_create_storage_usage
+      storage_usage || create_storage_usage!
+    rescue ActiveRecord::RecordNotUnique
+      reload_storage_usage
+    end
+
+  # Models must implement:
+  # - storage_attachments: relation with the ActiveStorage::Attachments counted towards the model's storage
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..6d61cc0
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,35 @@
+# Storage used by an account or a board, recalculated in the background whenever it changes.
+#
+# Recalculating means adding up every counted attachment, which gets expensive on big accounts, so
+# changes don't recalculate right away. They request a recalculation instead: the first request schedules
+# a job, and every request that follows is covered by that same job until it runs.
+class StorageUsage < ApplicationRecord
+  RECALCULATION_DELAY = 30.seconds
+  RECALCULATION_TIMEOUT = 10.minutes
+
+  belongs_to :account, default: -> { container.account }
+  belongs_to :container, polymorphic: true
+
+  def recalculate_later
+    if request_recalculation
+      StorageUsage::RecalculationJob.set(wait: RECALCULATION_DELAY).perform_later(self)
+    end
+  end
+
+  def recalculate_now
+    update_columns recalculation_requested_at: nil
+    update! bytes_used: container.storage_attachments.joins(:blob).sum("active_storage_blobs.byte_size")
+  end
+
+  def recalculation_pending?
+    recalculation_requested_at.present?
+  end
+
+  private
+    # Only one request goes through at a time: the rest are covered by the recalculation already pending.
+    # A request left pending for too long, like when its job got lost, is superseded by a fresh one.
+    def request_recalculation
+      self.class.where(id: id, recalculation_requested_at: [ nil, ...RECALCULATION_TIMEOUT.ago ])
+        .update_all(recalculation_requested_at: Time.current) == 1
+    end
+end
