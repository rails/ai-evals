diff --git a/script/migrations/20260710-backfill-storage-usage.rb b/script/migrations/20260710-backfill-storage-usage.rb
new file mode 100755
index 0000000..de6a1a0
--- /dev/null
+++ b/script/migrations/20260710-backfill-storage-usage.rb
@@ -0,0 +1,11 @@
+#!/usr/bin/env ruby
+
+require_relative "../../config/environment"
+
+# Schedules a storage usage recalculation for every account and board, so that Account#bytes_used and
+# Board#bytes_used reflect the attachments that existed before storage usage started being tracked.
+Account.find_each do |account|
+  puts "Scheduling storage usage recalculation for account #{account.id} (#{account.name})"
+  account.recalculate_bytes_used_later
+  account.boards.find_each(&:recalculate_bytes_used_later)
+end
