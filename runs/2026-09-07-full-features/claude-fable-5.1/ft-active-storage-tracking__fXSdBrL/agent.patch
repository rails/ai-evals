+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @usage = StorageUsage.create!(container: @board)
+  end
+
+  test "recalculate later schedules a delayed recalculation" do
+    freeze_time do
+      assert_enqueued_with job: StorageUsage::RecalculationJob, args: [ @usage ], at: StorageUsage::RECALCULATION_DELAY.from_now do
+        @usage.recalculate_later
+      end
+    end
+
+    assert @usage.reload.recalculation_pending?
+  end
+
+  test "requests made while a recalculation is pending are covered by it" do
+    @usage.recalculate_later
+
+    assert_no_enqueued_jobs only: StorageUsage::RecalculationJob do
+      3.times { @usage.recalculate_later }
+    end
+  end
+
+  test "a recalculation clears the way for the next request" do
+    @usage.recalculate_later
+    @usage.recalculate_now
+
+    assert_not @usage.reload.recalculation_pending?
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculationJob do
+      @usage.recalculate_later
+    end
+  end
+
+  test "a request pending for too long is superseded by a fresh one" do
+    @usage.recalculate_later
+
+    travel StorageUsage::RECALCULATION_TIMEOUT + 1.minute
+
+    assert_enqueued_jobs 1, only: StorageUsage::RecalculationJob do
+      @usage.recalculate_later
+    end
+  end
+
+  test "recalculate now adds up the container's attachments" do
+    cards(:logo).image.attach(create_blob(100))
+    cards(:layout).image.attach(create_blob(20))
+
+    @usage.recalculate_now
+
+    assert_equal 120, @usage.reload.bytes_used
+  end
+
+  test "recalculation job recalculates the usage" do
+    cards(:logo).image.attach(create_blob(100))
+    @usage.update!(recalculation_requested_at: Time.current)
+
+    StorageUsage::RecalculationJob.perform_now(@usage)
+
+    assert_equal 100, @usage.reload.bytes_used
+    assert_not @usage.recalculation_pending?
+  end
+
+  test "recalculation job for a destroyed usage is discarded" do
+    @usage.recalculate_later
+    @usage.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs only: StorageUsage::RecalculationJob
+    end
+  end
+
+  private
+    def create_blob(byte_size)
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * byte_size), filename: "#{byte_size}.txt", content_type: "text/plain"
+    end
+end
