diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..1431df7 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,37 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module ActiveStorage
+  module Extensions
+    # Keeps the storage usage of the boards and accounts an attachment counts towards up to date.
+    module Attachment
+      extend ActiveSupport::Concern
+
+      prepended do
+        after_commit :recalculate_storage_usage_later, on: [ :create, :destroy ]
+      end
+
+      # Purging deletes the attachment without running destroy callbacks
+      def purge
+        super
+        recalculate_storage_usage_later
+      end
+
+      def purge_later
+        super
+        recalculate_storage_usage_later
+      end
+
+      private
+        def recalculate_storage_usage_later
+          # Containers are missing when the attachment was destroyed along with them
+          Array(record.try(:storage_containers)).compact.each(&:recalculate_bytes_used_later)
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend ActiveStorage::Extensions::Attachment
+end
