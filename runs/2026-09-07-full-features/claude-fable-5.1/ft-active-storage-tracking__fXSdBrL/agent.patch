+
+  test "destroying a card is subtracted" do
+    @card.image.attach(create_blob(100))
+    @card.comments.create!(body: embed(create_blob(40)))
+    cards(:layout).image.attach(create_blob(5))
+    assert_bytes_used 145
+
+    @card.destroy
+
+    assert_bytes_used 5
+  end
+
+  test "moving a card moves its usage to the new board" do
+    other_board = boards(:private)
+    @card.image.attach(create_blob(100))
+    @card.comments.create!(body: embed(create_blob(40)))
+    cards(:layout).image.attach(create_blob(5))
+    assert_bytes_used 145
+
+    @card.move_to(other_board)
+
+    assert_bytes_used 5
+    assert_bytes_used 140, other_board
+  end
+
+  test "changes on a busy board are coalesced into a single recalculation" do
+    assert_enqueued_jobs 2, only: StorageUsage::RecalculationJob do
+      5.times { @card.comments.create!(body: embed(create_blob(1))) }
+    end
+
+    assert_bytes_used 5
+  end
+
+  test "destroying the board destroys its usage" do
+    @card.image.attach(create_blob(100))
+    assert_bytes_used 100
+
+    assert_difference -> { StorageUsage.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  private
+    def create_blob(byte_size)
+      ActiveStorage::Blob.create_and_upload! io: StringIO.new("x" * byte_size), filename: "#{byte_size}.txt", content_type: "text/plain"
+    end
+
+    def embed(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def assert_bytes_used(expected, board = @board)
+      perform_enqueued_jobs only: StorageUsage::RecalculationJob
+      assert_equal expected, board.reload.bytes_used
+    end
+end
