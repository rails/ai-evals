@@ -0,0 +1,32 @@
+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { turbo: false } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false, maxlength: MagicLink::CODE_LENGTH, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <p>We emailed you a <%= MagicLink::CODE_LENGTH %>-character code. Enter it here to get in. It’s good for <%= distance_of_time_in_words(MagicLink::EXPIRATION) %>.</p>
+
+    <% if @magic_link %>
+      <p class="txt-subtle">Psst, here’s your code: <strong><%= @magic_link.code %></strong></p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">
+    Didn’t get it? Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %> to get a new code.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
