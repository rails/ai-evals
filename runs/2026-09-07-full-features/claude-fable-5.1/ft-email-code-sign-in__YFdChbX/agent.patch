--- /dev/null
+++ b/app/controllers/concerns/pending_authentication.rb
@@ -0,0 +1,25 @@
+module PendingAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def start_pending_authentication_for(email_address)
+      cookies[:pending_authentication_token] = {
+        value: Identity.pending_authentication_token_for(email_address),
+        expires: MagicLink::EXPIRATION.from_now,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def find_pending_identity
+      Identity.find_by_pending_authentication_token(pending_authentication_token)
+    end
+
+    def end_pending_authentication
+      cookies.delete(:pending_authentication_token)
+    end
+end
