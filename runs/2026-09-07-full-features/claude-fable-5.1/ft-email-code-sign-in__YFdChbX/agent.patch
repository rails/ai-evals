+require "test_helper"
+
+class Identity::MagicLinkableTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "send_magic_link creates a code and emails it" do
+    assert_difference -> { @identity.magic_links.count }, 1 do
+      assert_enqueued_email_with IdentityMailer, :magic_link, args: ->(args) { args.first == @identity.magic_links.last } do
+        @identity.send_magic_link
+      end
+    end
+  end
+
+  test "redeem_magic_link with a valid code deletes all of the identity's codes" do
+    stale = @identity.magic_links.create!
+    magic_link = @identity.magic_links.create!
+
+    assert @identity.redeem_magic_link(magic_link.code)
+    assert_not MagicLink.exists?(magic_link.id)
+    assert_not MagicLink.exists?(stale.id)
+  end
+
+  test "redeem_magic_link ignores case and whitespace" do
+    magic_link = @identity.magic_links.create!
+
+    assert @identity.redeem_magic_link(" #{magic_link.code.downcase} ")
+  end
+
+  test "redeem_magic_link with a wrong code" do
+    magic_link = @identity.magic_links.create!
+
+    assert_not @identity.redeem_magic_link("NOPE12")
+    assert_not @identity.redeem_magic_link(nil)
+    assert MagicLink.exists?(magic_link.id)
+  end
+
+  test "redeem_magic_link with an expired code" do
+    magic_link = @identity.magic_links.create!
+
+    travel (MagicLink::EXPIRATION + 1.second) do
+      assert_not @identity.redeem_magic_link(magic_link.code)
+    end
+  end
+
+  test "redeem_magic_link with another identity's code" do
+    magic_link = identities(:david).magic_links.create!
+
+    assert_not @identity.redeem_magic_link(magic_link.code)
+  end
+
+  test "codes can only be redeemed once" do
+    magic_link = @identity.magic_links.create!
+
+    assert @identity.redeem_magic_link(magic_link.code)
+    assert_not @identity.redeem_magic_link(magic_link.code)
+  end
+
+  test "pending authentication token finds the identity by email address" do
+    token = Identity.pending_authentication_token_for(" Kevin@37signals.com ")
+
+    assert_equal @identity, Identity.find_by_pending_authentication_token(token)
+  end
+
+  test "pending authentication token for an unknown email address" do
+    token = Identity.pending_authentication_token_for("nobody@example.com")
+
+    assert_nil Identity.find_by_pending_authentication_token(token)
+  end
+
+  test "pending authentication token expires with the code" do
+    token = Identity.pending_authentication_token_for(@identity.email_address)
+
+    travel (MagicLink::EXPIRATION + 1.second) do
+      assert_nil Identity.find_by_pending_authentication_token(token)
+    end
+  end
+
+  test "pending authentication token can't be forged or reused for another purpose" do
+    assert_nil Identity.find_by_pending_authentication_token("garbage")
+    assert_nil Identity.find_by_pending_authentication_token(nil)
+    assert_nil Identity.find_by_pending_authentication_token(@identity.transfer_id)
+    assert_nil Identity.find_by_pending_authentication_token(@identity.signed_id(purpose: :pending_authentication))
+  end
+
+  test "destroying an identity deletes its codes" do
+    @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      @identity.destroy
+    end
+  end
+end
diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..8a9e80f
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a code and expiration on create" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal MagicLink::CODE_LENGTH, magic_link.code.length
+    assert magic_link.code.chars.all? { |char| MagicLink::CODE_ALPHABET.include?(char) }, "expected #{magic_link.code} to only use unambiguous characters"
+    assert_in_delta MagicLink::EXPIRATION.from_now, magic_link.expires_at, 5.seconds
+    assert_not magic_link.expired?
+  end
+
+  test "codes are single-shot random" do
+    codes = Array.new(20) { @identity.magic_links.create!.code }
+
+    assert_equal codes.uniq.size, codes.size
+  end
+
+  test "normalizes codes" do
+    magic_link = @identity.magic_links.create!(code: " abc123 ")
+
+    assert_equal "ABC123", magic_link.code
+    assert_equal magic_link, @identity.magic_links.find_by(code: "abc123")
+  end
+
+  test "active and expired scopes" do
+    magic_link = @identity.magic_links.create!
+
+    assert_includes MagicLink.active, magic_link
+    assert_not_includes MagicLink.expired, magic_link
+
+    travel (MagicLink::EXPIRATION + 1.second) do
+      assert_not_includes MagicLink.active, magic_link
+      assert_includes MagicLink.expired, magic_link
+      assert magic_link.expired?
+    end
+  end
+
+  test "cleanup deletes expired codes only" do
+    expired = @identity.magic_links.create!
+    expired.update_columns(expires_at: 1.minute.ago)
+    active = @identity.magic_links.create!
+
+    assert_difference -> { MagicLink.count }, -1 do
+      MagicLink.cleanup
+    end
+
+    assert_not MagicLink.exists?(expired.id)
+    assert MagicLink.exists?(active.id)
+  end
+end
