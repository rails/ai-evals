diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..4b1fa8d
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,62 @@
+class Sessions::MagicLinksController < ApplicationController
+  include PendingAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  before_action :require_pending_authentication
+  before_action :set_identity
+
+  layout "public"
+
+  def new
+    @magic_link = @identity&.magic_links.active.last if Rails.env.development?
+  end
+
+  def create
+    if @identity&.redeem_magic_link(params.expect(:code))
+      end_pending_authentication
+      start_new_session_for @identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+
+    def require_pending_authentication
+      if pending_authentication_token.blank?
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Enter your email address to get a code." }
+          format.json { render json: { message: "Request a code first." }, status: :unauthorized }
+        end
+      end
+    end
+
+    def set_identity
+      @identity = find_pending_identity
+    end
+
+    def invalid_code
+      message = "That code didn't work. Check it and try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+end
