+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "new" do
+    request_code
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_in_body "Check your email"
+      assert_in_body 'name="code"'
+    end
+  end
+
+  test "new without having asked for a code" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "new redirects authenticated users" do
+    sign_in_as :kevin
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "create signs in with the emailed code" do
+    magic_link = request_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].blank?
+      assert_equal @identity, Session.last.identity
+      assert_empty @identity.magic_links
+    end
+  end
+
+test "create returns to where authentication was requested" do
+  get root_url
+
+  untenanted do
+    assert_redirected_to new_session_url
+    post session_path, params: { email_address: @identity.email_address }
+    post session_magic_link_path, params: { code: @identity.magic_links.last.code }
+  end
+
+  assert_redirected_to root_url
+end
+
+  test "create accepts codes in any case with stray whitespace" do
+    magic_link = request_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: " #{magic_link.code.downcase} " }
+
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create via JSON returns the session token" do
+    magic_link = request_code
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: magic_link.code }, as: :json
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+    end
+  end
+
+  test "create with a wrong code" do
+    request_code
+
+    untenanted do
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Check it and try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+      assert cookies[:pending_authentication_token].present?, "should get another go with the same code"
+    end
+  end
+
+  test "create with a wrong code via JSON" do
+    request_code
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "WRONG1" }, as: :json
+
+      assert_response :unauthorized
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    magic_link = request_code
+
+    travel (MagicLink::EXPIRATION + 1.second) do
+      untenanted do
+        post session_magic_link_path, params: { code: magic_link.code }
+
+        assert_redirected_to new_session_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create with somebody else's code" do
+    request_code
+    magic_link = identities(:david).magic_links.create!
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create for an email address without an identity" do
+    with_multi_tenant_mode(false) do
+      untenanted do
+        post session_path, params: { email_address: "nobody@example.com" }
+        post session_magic_link_path, params: { code: "ABC123" }
+
+        assert_redirected_to new_session_magic_link_path
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "create without having asked for a code" do
+    untenanted do
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create without having asked for a code via JSON" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "ABC123" }, as: :json
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    magic_link = request_code
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  private
+    def request_code
+      untenanted do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      @identity.magic_links.last
+    end
+end
