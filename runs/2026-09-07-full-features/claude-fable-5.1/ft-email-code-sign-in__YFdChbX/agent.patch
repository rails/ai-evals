diff --git a/app/models/identity/magic_linkable.rb b/app/models/identity/magic_linkable.rb
new file mode 100644
index 0000000..7d7c3ff
--- /dev/null
+++ b/app/models/identity/magic_linkable.rb
@@ -0,0 +1,44 @@
+module Identity::MagicLinkable
+  extend ActiveSupport::Concern
+
+  PENDING_AUTHENTICATION_PURPOSE = :pending_authentication
+
+  included do
+    has_many :magic_links, dependent: :delete_all
+  end
+
+  class_methods do
+    def pending_authentication_token_for(email_address)
+      pending_authentication_verifier.generate email_address,
+        purpose: PENDING_AUTHENTICATION_PURPOSE, expires_in: MagicLink::EXPIRATION
+    end
+
+    def find_by_pending_authentication_token(token)
+      if email_address = pending_authentication_verifier.verified(token.to_s, purpose: PENDING_AUTHENTICATION_PURPOSE)
+        find_by(email_address: email_address)
+      end
+    end
+
+    private
+      def pending_authentication_verifier
+        Rails.application.message_verifier(PENDING_AUTHENTICATION_PURPOSE)
+      end
+  end
+
+  # The code is logged too, so instances without email configured can still be signed in to.
+  def send_magic_link
+    magic_links.create!.tap do |magic_link|
+      Rails.logger.info "Sign-in code for #{email_address}: #{magic_link.code}"
+      IdentityMailer.magic_link(magic_link).deliver_later
+    end
+  end
+
+  def redeem_magic_link(code)
+    if magic_links.active.exists?(code: code)
+      magic_links.delete_all
+      true
+    else
+      false
+    end
+  end
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..89d314d
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,32 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_ALPHABET = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ] # Skips 0/O and 1/I, which are easy to mix up
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity
+
+  scope :active, -> { where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  normalizes :code, with: ->(code) { code.strip.upcase }
+
+  before_create :generate_code, if: -> { code.blank? }
+  before_create :set_expiration
+
+  def self.cleanup
+    expired.delete_all
+  end
+
+  def expired?
+    expires_at.past?
+  end
+
+  private
+    def generate_code
+      self.code = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample(random: SecureRandom) }.join
+    end
+
+    def set_expiration
+      self.expires_at = EXPIRATION.from_now
+    end
+end
