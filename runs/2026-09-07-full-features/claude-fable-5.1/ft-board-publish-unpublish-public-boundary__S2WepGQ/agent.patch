diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..29b711a
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,25 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_permission_to_admin_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board) }
+      format.turbo_stream
+      format.json { render "boards/show", status: :created, location: board_path(@board, format: :json) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board) }
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+end
