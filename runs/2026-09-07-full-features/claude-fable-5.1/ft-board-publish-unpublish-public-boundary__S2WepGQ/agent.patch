diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..70b7002
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,22 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  def publish
+    create_publication! unless published?
+  end
+
+  def unpublish
+    publication&.destroy
+    reset_publication
+  end
+
+  def published?
+    publication.present?
+  end
+end
