diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..21806a1
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,43 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">Anyone with this secret link can see this board and its cards, without signing in. Keep it private to keep the board private.</p>
+
+      <% url = public_board_url_for(board) %>
+      <div class="flex align-center gap-half margin-block">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+        <%= button_to_copy_to_clipboard url do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+
+      <div class="flex flex-wrap justify-center align-center gap">
+        <%= link_to url, class: "btn", target: "_blank", data: { turbo: false } do %>
+          <%= icon_tag "world" %>
+          <span>Open public board</span>
+        <% end %>
+
+        <% if Current.user.can_administer_board?(board) %>
+          <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative", form: { data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } } do %>
+            <%= icon_tag "lock" %>
+            <span>Unpublish</span>
+          <% end %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to get a secret link that anyone can use to see it, without signing in.</p>
+
+      <% if Current.user.can_administer_board?(board) %>
+        <div class="flex justify-center margin-block">
+          <%= button_to board_publication_path(board), method: :post, class: "btn" do %>
+            <%= icon_tag "globe" %>
+            <span>Publish this board</span>
+          <% end %>
+        </div>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
