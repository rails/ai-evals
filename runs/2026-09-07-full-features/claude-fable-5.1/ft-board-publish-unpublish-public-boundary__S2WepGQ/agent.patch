+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_select "h1", text: /#{Regexp.escape(@card.title)}/
+    assert_select "##{dom_id(@card.comments.first)}"
+  end
+
+  test "show does not expose private card actions" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_select "a[href=?]", card_path(@card), count: 0
+    assert_select "a[href=?]", edit_card_path(@card), count: 0
+    assert_select "form", count: 0
+  end
+
+  test "show drafted card" do
+    @card.update! status: :drafted
+
+    get public_board_card_path(@board.publication, @card)
+    assert_response :not_found
+  end
+
+  test "show card from another board" do
+    other_card = Current.set(user: users(:kevin)) { boards(:private).cards.create!(title: "Secret") }
+
+    get public_board_card_path(@board.publication, other_card)
+    assert_response :not_found
+  end
+
+  test "show with unknown key" do
+    get public_board_card_path("unknown", @card)
+    assert_response :not_found
+  end
+
+  test "show unpublished board" do
+    key = @board.publication.key
+    @board.unpublish
+
+    get public_board_card_path(key, @card)
+    assert_response :not_found
+  end
+end
