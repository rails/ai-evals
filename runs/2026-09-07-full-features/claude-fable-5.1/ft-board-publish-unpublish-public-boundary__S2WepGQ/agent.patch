diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..ace06b9
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publishing creates a publication with a secret key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publication.key.present?
+    assert_equal @board.account, @board.publication.account
+  end
+
+  test "publishing an already published board keeps the same key" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.reload.publication
+  end
+
+  test "unpublishing an unpublished board is a no-op" do
+    assert_nothing_raised { @board.unpublish }
+    assert_not @board.published?
+  end
+
+  test "published scope" do
+    assert_empty Board.published
+
+    @board.publish
+    assert_equal [ @board ], Board.published
+  end
+
+  test "publishing touches the board" do
+    @board.update_column :updated_at, 1.day.ago
+
+    @board.publish
+    assert_in_delta Time.current, @board.reload.updated_at, 5.seconds
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "published cards of a published board are publicly accessible" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+    assert_not card.comments.first.publicly_accessible?
+
+    @board.publish
+    assert card.reload.publicly_accessible?
+    assert card.comments.first.publicly_accessible?
+
+    card.update! status: :drafted
+    assert_not card.publicly_accessible?
+  end
+end
