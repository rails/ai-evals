+class Public::BoardsController < ApplicationController
+  CLOSED_CARDS_LIMIT = 15
+
+  include PublicBoardScoped
+
+  def show
+    set_page_and_extract_portion_from @board.cards.awaiting_triage.latest.with_golden_first.preloaded
+    @closed_cards = @board.cards.closed.recently_closed_first.preloaded.limit(CLOSED_CARDS_LIMIT)
+
+    fresh_when etag: [ @board, @page.records ]
+  end
+
+  private
+    def board_key
+      params[:key]
+    end
+end
diff --git a/app/helpers/public/boards_helper.rb b/app/helpers/public/boards_helper.rb
new file mode 100644
index 0000000..f22fa0d
--- /dev/null
+++ b/app/helpers/public/boards_helper.rb
@@ -0,0 +1,23 @@
+module Public::BoardsHelper
+  def public_board_url_for(board)
+    public_board_url(board.publication) if board.published?
+  end
+
+  def link_back_to_public_board(board)
+    back_link_to board.name, public_board_path(board.publication), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click"
+  end
+
+  def public_column_tag(id:, name:, collapsed: true, data: {}, **properties, &block)
+    classes = token_list("cards", properties.delete(:class), "is-collapsed": collapsed, "is-expanded": !collapsed)
+
+    data = {
+      column_name: name,
+      collapsible_columns_target: "column",
+      action: "focus->collapsible-columns#focusOnColumn"
+    }.merge(data)
+
+    tag.section(id: id, class: classes, tabindex: "0", data: data, **properties) do
+      tag.div(class: "cards__transition-container", &block)
+    end
+  end
+end
