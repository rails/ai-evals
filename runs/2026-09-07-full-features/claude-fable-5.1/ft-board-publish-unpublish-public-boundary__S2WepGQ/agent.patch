diff --git a/app/views/public/boards/cards/_container.html.erb b/app/views/public/boards/cards/_container.html.erb
new file mode 100644
index 0000000..41c7676
--- /dev/null
+++ b/app/views/public/boards/cards/_container.html.erb
@@ -0,0 +1,58 @@
+<section id="<%= dom_id(card, :card_container) %>" class="card-perma" style="--card-color: <%= card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag card, class: "card" do %>
+      <header class="card__header">
+        <div class="card__board">
+          <%= render "cards/display/common/board", card: card %>
+        </div>
+
+        <% if card.tags.any? %>
+          <div class="card__tags">
+            <div class="card__tags-list min-width">
+              <% card.tags.each_with_index do |tag, index| %>
+                <span class="card__tag btn btn--plain min-width txt-uppercase fill-transparent"><%= tag.title %></span><%= "," unless index == card.tags.size - 1 %>
+              <% end %>
+            </div>
+          </div>
+        <% end %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title flex align-start gap-half">
+            <%= card_html_title(card) %>
+          </h1>
+
+          <% unless card.description.blank? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= card.description %>
+            </div>
+          <% end %>
+
+          <%= render "public/boards/cards/steps", card: card if card.steps.any? %>
+        </div>
+
+        <% if card.board.columns.any? %>
+          <div class="card__stages">
+            <% card.board.columns.sorted.each do |column| %>
+              <%= tag.span column.name, class: [ "card__column-name btn overflow-ellipsis", { "card__column-name--current": column == card.column && card.open? } ], style: "--column-color: #{column.color}" %>
+            <% end %>
+          </div>
+        <% end %>
+
+        <%= render "cards/display/common/stamp", card: card %>
+      </div>
+
+      <footer class="card__footer">
+        <%= render "public/boards/cards/meta", card: card %>
+        <%= render "cards/display/common/background", card: card do %>
+          <%= link_to card.image.presence, class: "card__zoom-bg-btn btn", data: { controller: "tooltip", lightbox_target: "image" } do %>
+            <%= icon_tag "picture-zoom" %>
+            <span class="for-screen-reader">Zoom background image</span>
+          <% end %>
+        <% end %>
+        <%= render "public/boards/cards/reactions", reactable: card %>
+      </footer>
+    <% end %>
+  </div>
+</section>
