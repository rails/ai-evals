+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+    @bundle = @user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+  end
+
+  test "bundle with a single notification" do
+    notification = @user.notifications.create!(source: mentions(:logo_comment_david_mention_by_jz), creator: users(:jz), bundle: @bundle)
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_equal "JZ mentioned you", email.subject
+    assert_match "The logo isn&#39;t big enough", email.html_part.body.to_s
+    assert_match "JZ mentioned you", email.html_part.body.to_s
+    assert_match %r{/#{AccountSlug.encode(@user.account.external_account_id)}/cards/#{notification.card.number}}, email.html_part.body.to_s
+    assert_match "1 new notification", email.text_part.body.to_s
+  end
+
+  test "bundle with several notifications groups them by board" do
+    @user.notifications.create!(source: events(:layout_published), creator: users(:jason), bundle: @bundle)
+    @user.notifications.create!(source: events(:logo_published), creator: users(:jason), bundle: @bundle)
+    @user.notifications.create!(source: events(:shipping_published), creator: users(:jason), bundle: @bundle)
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal "3 new notifications in 37signals", email.subject
+
+    html = email.html_part.body.to_s
+    assert_select_in html, "h2.notification__board", count: @bundle.notifications.map { |n| n.card.board }.uniq.size
+    assert_select_in html, "table.notification", count: 3
+    assert_match "Layout is broken", html
+    assert_match "We need to ship the app", html
+    assert_match "notifications/settings", html
+  end
+
+  private
+    def assert_select_in(html, selector, count:)
+      assert_equal count, Nokogiri::HTML(html).css(selector).size, "Expected #{count} #{selector}"
+    end
+end
