diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..995978a
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,201 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+    @interval = @user.bundle_email_interval
+    @now = Time.current.change(usec: 0)
+  end
+
+  test "landing_at opens a window when the first notification lands" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+
+    assert_equal @user, bundle.user
+    assert_equal @user.account, bundle.account
+    assert_equal @now, bundle.starts_at
+    assert_equal @now + @interval, bundle.ends_at
+    assert bundle.undelivered?
+  end
+
+  test "landing_at puts notifications landing during an open window in it" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+
+    assert_equal bundle, @user.notification_bundles.landing_at(@now + 1.hour, interval: @interval)
+    assert_equal bundle, @user.notification_bundles.landing_at(@now + @interval - 1.second, interval: @interval)
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "landing_at opens a new window once the previous one has ended" do
+    first = @user.notification_bundles.landing_at(@now, interval: @interval)
+    second = @user.notification_bundles.landing_at(@now + @interval, interval: @interval)
+
+    assert_not_equal first, second
+    assert_equal @now + @interval, second.starts_at
+    assert_equal @now + 2 * @interval, second.ends_at
+  end
+
+  test "landing_at puts late notifications in the window that had already opened" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+
+    travel_to @now + @interval + 10.minutes do
+      assert bundle.undelivered?
+      assert_equal bundle, @user.notification_bundles.landing_at(@now + 1.hour, interval: @interval)
+    end
+  end
+
+  test "landing_at puts notifications that landed just before an open window in it rather than overlapping it" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+
+    assert_equal bundle, @user.notification_bundles.landing_at(@now - 1.hour, interval: @interval)
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "landing_at restarts the clock when the window a late notification landed in was already delivered" do
+    delivered = @user.notification_bundles.create!(starts_at: @now, ends_at: @now + @interval, delivered_at: @now + @interval)
+
+    bundle = @user.notification_bundles.landing_at(@now + 1.hour, interval: @interval)
+
+    assert_not_equal delivered, bundle
+    assert_equal delivered.ends_at, bundle.starts_at
+    assert_equal delivered.ends_at + @interval, bundle.ends_at
+  end
+
+  test "landing_at never opens a window overlapping another one" do
+    @user.notification_bundles.create!(starts_at: @now, ends_at: @now + @interval, delivered_at: @now + @interval)
+    later = @user.notification_bundles.create!(starts_at: @now + @interval + 1.hour, ends_at: @now + 2 * @interval + 1.hour, delivered_at: @now + 2 * @interval + 1.hour)
+
+    bundle = @user.notification_bundles.landing_at(@now + 1.hour, interval: @interval)
+
+    assert_equal @now + @interval, bundle.starts_at
+    assert_equal later.starts_at, bundle.ends_at
+    assert_no_overlapping_windows
+  end
+
+  test "landing_at keeps windows of different users apart" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+    other = users(:jz).notification_bundles.landing_at(@now, interval: @interval)
+
+    assert_not_equal bundle, other
+    assert_equal users(:jz), other.user
+  end
+
+  test "due bundles are the undelivered ones whose window has ended" do
+    bundle = @user.notification_bundles.landing_at(@now, interval: @interval)
+
+    travel_to(@now + @interval - 1.minute) { assert_not_includes Notification::Bundle.due, bundle }
+    travel_to(@now + @interval) { assert_includes Notification::Bundle.due, bundle }
+
+    bundle.update!(delivered_at: Time.current)
+    travel_to(@now + @interval) { assert_not_includes Notification::Bundle.due, bundle }
+  end
+
+  test "deliver_all_due enqueues a delivery for every due bundle" do
+    due = @user.notification_bundles.create!(starts_at: @now - @interval, ends_at: @now)
+    @user.notification_bundles.create!(starts_at: @now, ends_at: @now + @interval)
+
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ due ]) do
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob do
+        Notification::Bundle.deliver_all_due
+      end
+    end
+  end
+
+  test "deliver emails the bundled notifications once" do
+    bundle = bundle_with_notifications
+
+    assert_enqueued_emails 1 do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+  end
+
+  test "deliver sends one email per window" do
+    bundle = bundle_with_notifications(events(:layout_published), events(:logo_published))
+
+    assert_emails 1 do
+      perform_enqueued_jobs { bundle.deliver }
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match "Layout is broken", email.text_part.body.to_s
+    assert_match "The logo isn't big enough", email.text_part.body.to_s
+  end
+
+  test "deliver skips empty bundles but still marks them delivered" do
+    bundle = @user.notification_bundles.create!(starts_at: @now, ends_at: @now + @interval)
+
+    assert_no_enqueued_emails { bundle.deliver }
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips users who turned bundle emails off in the meantime" do
+    bundle = bundle_with_notifications
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_emails { bundle.deliver }
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips deactivated users and cancelled accounts" do
+    bundle = bundle_with_notifications
+    @user.update!(active: false)
+
+    assert_no_enqueued_emails { bundle.deliver }
+
+    bundle = bundle_with_notifications(events(:logo_published))
+    @user.update!(active: true)
+    @user.account.cancel(initiated_by: @user)
+
+    assert_no_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+      bundle.deliver
+    end
+  end
+
+  test "shorten ends the window sooner without ending it in the past" do
+    bundle = @user.notification_bundles.create!(starts_at: @now - 2.hours, ends_at: @now - 2.hours + 1.week)
+
+    bundle.shorten(1.day)
+    assert_equal @now - 2.hours + 1.day, bundle.ends_at
+
+    bundle.shorten(1.hour)
+    assert_in_delta Time.current, bundle.ends_at, 5.seconds
+
+    bundle.shorten(1.week)
+    assert_in_delta Time.current, bundle.ends_at, 5.seconds
+  end
+
+  test "destroying a bundle keeps its notifications" do
+    bundle = bundle_with_notifications
+    notification = bundle.notifications.first
+
+    bundle.destroy
+
+    assert_nil notification.reload.bundle
+  end
+
+  private
+    def bundle_with_notifications(*sources)
+      sources = [ events(:layout_published) ] if sources.empty?
+
+      @user.notification_bundles.create!(starts_at: @now - @interval, ends_at: @now).tap do |bundle|
+        sources.each do |source|
+          @user.notifications.create!(source: source, creator: users(:jason), bundle: bundle)
+        end
+      end
+    end
+
+    def assert_no_overlapping_windows
+      @user.notification_bundles.chronologically.map(&:window).each_cons(2) do |earlier, later|
+        assert earlier.end <= later.begin, "#{earlier} overlaps #{later}"
+      end
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..baf63de
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.notifications.destroy_all
+  end
+
+  test "bundle_later is called after a notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    end
+  end
+
+  test "bundle_later is called again when the notification source changes" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    assert_enqueued_with(job: Notification::BundleJob, args: [ notification ]) do
+      notification.update!(source: events(:layout_commented))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      notification.read
+    end
+  end
+
+  test "bundle_now opens a window when the first notification lands" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    notification.bundle_now
+
+    bundle = notification.reload.bundle
+    assert_equal @user, bundle.user
+    assert_equal notification.updated_at, bundle.starts_at
+    assert_equal notification.updated_at + 4.hours, bundle.ends_at
+  end
+
+  test "bundle_now groups notifications landing in the same window" do
+    first = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    first.bundle_now
+
+    travel 1.hour
+    second = @user.notifications.create!(source: events(:logo_published), creator: users(:jason))
+    second.bundle_now
+
+    assert_equal first.reload.bundle, second.reload.bundle
+    assert_equal [ first, second ].sort, first.bundle.notifications.sort
+  end
+
+  test "bundle_now starts a new window after the previous one ends" do
+    first = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    first.bundle_now
+
+    travel 4.hours + 1.minute
+    second = @user.notifications.create!(source: events(:logo_published), creator: users(:jason))
+    second.bundle_now
+
+    assert_not_equal first.reload.bundle, second.reload.bundle
+  end
+
+  test "bundle_now honors the user's frequency" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    notification.bundle_now
+
+    assert_equal 1.day, notification.reload.bundle.ends_at - notification.bundle.starts_at
+  end
+
+  test "bundle_now leaves a late notification in the window it landed in" do
+    first = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    first.bundle_now
+
+    travel 1.hour
+    late = @user.notifications.create!(source: events(:logo_published), creator: users(:jason))
+
+    travel 3.hours + 30.minutes
+    late.bundle_now
+
+    assert_equal first.reload.bundle, late.reload.bundle
+  end
+
+  test "bundle_now moves a re-notified notification into a new window once its bundle was delivered" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    notification.bundle_now
+    first_bundle = notification.reload.bundle
+    first_bundle.update!(delivered_at: Time.current)
+
+    travel 5.hours
+    notification.update!(source: events(:layout_commented))
+    notification.bundle_now
+
+    assert_not_equal first_bundle, notification.reload.bundle
+    assert notification.bundle.undelivered?
+  end
+
+  test "bundle_now does nothing when bundle emails are off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    notification.bundle_now
+
+    assert_nil notification.reload.bundle
+    assert_empty @user.notification_bundles
+  end
+
+  test "bundle_now skips notifications from the system user" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:system))
+
+    notification.bundle_now
+
+    assert_nil notification.reload.bundle
+  end
+
+  test "bundle_now skips deactivated users" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    @user.update!(active: false)
+
+    notification.bundle_now
+
+    assert_nil notification.reload.bundle
+  end
+
+  test "bundling job bundles the notification" do
+    notification = @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+
+    perform_enqueued_jobs only: Notification::BundleJob
+
+    assert notification.reload.bundle.present?
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
