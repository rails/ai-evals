+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+  end
+
+  test "bundle emails every few hours by default" do
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert_equal 4.hours, @settings.bundle_email_interval
+  end
+
+  test "bundle email interval follows the frequency" do
+    @settings.bundle_email_frequency = :daily
+    assert_equal 1.day, @settings.bundle_email_interval
+
+    @settings.bundle_email_frequency = :weekly
+    assert_equal 1.week, @settings.bundle_email_interval
+
+    @settings.bundle_email_frequency = :never
+    assert_nil @settings.bundle_email_interval
+  end
+
+  test "bundle email frequency must be a known one" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+  end
+
+  test "picking a more frequent schedule shortens the open window" do
+    @settings.update!(bundle_email_frequency: :weekly)
