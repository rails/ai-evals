diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..584d9af
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,30 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+  helper_method :notifications_by_board, :time_for
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.order(:updated_at).to_a
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications)
+  end
+
+  private
+    def subject_for(notifications)
+      if notifications.one?
+        notifications.first.payload.title
+      else
+        "#{notifications.size} new notifications in #{@account.name}"
+      end
+    end
+
+    def notifications_by_board
+      @notifications.group_by { |notification| notification.card.board }.sort_by { |board, _| board.name }
+    end
+
+    def time_for(time)
+      time.in_time_zone(@user.timezone).strftime("%b %-d at %-l:%M %p")
+    end
+end
