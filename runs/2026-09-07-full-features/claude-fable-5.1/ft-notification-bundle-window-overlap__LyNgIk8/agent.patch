diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..b283720
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,78 @@
+# A bundle collects the notifications a user receives during a window of time, so they can be
+# emailed together once the window ends. The window opens when the first notification lands and
+# lasts as long as the user's bundle email frequency dictates. A user's windows never overlap.
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :covering, ->(time) { where(starts_at: ..time).where("ends_at > ?", time) }
+  scope :overlapping, ->(window) { where(starts_at: ...window.end).where("ends_at > ?", window.begin) }
+  scope :chronologically, -> { order(:starts_at) }
+
+  class << self
+    # Returns the bundle a notification landing at +time+ belongs to, opening a new window lasting
+    # +interval+ when there isn't one yet. Meant to be called on a user's bundles.
+    def landing_at(time, interval:)
+      if bundle = undelivered.overlapping(time...(time + interval)).chronologically.first
+        bundle
+      elsif bundle = delivered.covering(time).first
+        # Too late for the window it landed in, so the clock restarts when that window ended.
+        landing_at(bundle.ends_at, interval: interval)
+      else
+        create! starts_at: time, ends_at: [ time + interval, next_start_after(time) ].compact.min
+      end
+    end
+
+    def deliver_all_due
+      due.find_each(&:deliver_later)
+    end
+
+    private
+      def next_start_after(time)
+        where("starts_at > ?", time).minimum(:starts_at)
+      end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    with_lock do
+      if undelivered?
+        NotificationMailer.bundle(self).deliver_later if deliverable?
+        update! delivered_at: Time.current
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def undelivered?
+    !delivered?
+  end
+
+  def window
+    starts_at...ends_at
+  end
+
+  # Ends the window sooner, as when the user picks a more frequent email schedule.
+  def shorten(interval)
+    shortened_ends_at = [ starts_at + interval, Time.current ].max
+
+    if shortened_ends_at < ends_at
+      update! ends_at: shortened_ends_at
+    end
+  end
+
+  private
+    def deliverable?
+      notifications.any? && user.active? && account.active? && user.bundle_email_interval.present?
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..54e5d3e
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,36 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def bundle_now
+    if bundleable?
+      # One notification at a time per user, so their windows never overlap.
+      user.settings.with_lock do
+        update_column :bundle_id, find_or_open_bundle.id
+      end
+    end
+  end
+
+  private
+    def bundleable?
+      !creator.system? && user.active? && account.active? && user.bundle_email_interval.present?
+    end
+
+    def find_or_open_bundle
+      user.notification_bundles.landing_at(landed_at, interval: user.bundle_email_interval)
+    end
+
+    # A notification is saved again whenever there's new activity on its card, so this is when the latest landed.
+    def landed_at
+      updated_at
+    end
+end
