@@ -0,0 +1,28 @@
+# Secrets referenced from config/deploy.yml. This file is committed, so it must never contain the
+# values themselves: it reads them from your environment, a file or a password manager.
+#
+# Export these before running `bin/kamal setup` or `bin/kamal deploy`, or put them in a file you
+# keep out of git and load it into your shell first. See docs/deployment.md for how to generate
+# each of them.
+
+# Signs cookies and sessions. Generate with `bin/rails secret`.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Password for the SMTP_USERNAME set in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Keys for browser push notifications. Generate with `bin/rails runner "puts WebPush.generate_key.to_hash"`.
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Only needed when pushing to an external registry instead of the one Kamal runs on your server.
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Alternatively, fetch everything from a password manager. Kamal has adapters for 1Password,
+# LastPass, Bitwarden and more: https://kamal-deploy.org/docs/commands/secrets/
+#
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy SECRET_KEY_BASE SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+# SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+# VAPID_PUBLIC_KEY=$(kamal secrets extract VAPID_PUBLIC_KEY $SECRETS)
+# VAPID_PRIVATE_KEY=$(kamal secrets extract VAPID_PRIVATE_KEY $SECRETS)
