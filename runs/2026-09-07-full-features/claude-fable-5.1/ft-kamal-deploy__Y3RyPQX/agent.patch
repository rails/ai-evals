   # config.active_job.queue_name_prefix = "fizzy_production"
 
+  # Canonical host for links in emails, push notifications and webhooks. Set APP_HOST to the
+  # hostname Fizzy is served from (e.g. fizzy.example.com). Without it, URLs can only be built
+  # from an incoming request, so mail sent from a background job has no host to link to.
+  if ENV["APP_HOST"].present?
+    url_options = { host: ENV["APP_HOST"], protocol: config.force_ssl ? "https" : "http" }
+
+    config.action_controller.default_url_options = url_options
+    config.action_mailer.default_url_options = url_options
+  end
+
+  # Deliver mail through the SMTP server given by SMTP_ADDRESS. Optional settings: SMTP_PORT (587),
+  # SMTP_DOMAIN (APP_HOST), SMTP_USERNAME and SMTP_PASSWORD, SMTP_AUTHENTICATION (plain),
+  # SMTP_ENABLE_STARTTLS_AUTO (true) and SMTP_TLS (false; set it for implicit TLS on port 465).
+  if ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV.fetch("SMTP_DOMAIN") { ENV["APP_HOST"] },
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain"),
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+      tls: ENV["SMTP_TLS"] == "true"
+    }.compact
+  end
+
   config.action_mailer.perform_caching = false
 
   # Ignore bad email addresses and do not raise email delivery errors.
