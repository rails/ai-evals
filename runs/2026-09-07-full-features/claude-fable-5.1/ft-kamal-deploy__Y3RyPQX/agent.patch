diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..61856dc
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,96 @@
+# Deploy Fizzy to a single server with Kamal: https://kamal-deploy.org
+#
+# Everything runs in one container on one Linux box with Docker: Puma serves the web requests,
+# Solid Queue runs the background jobs inside Puma, and SQLite holds the data. kamal-proxy sits
+# in front and terminates SSL with a certificate from Let's Encrypt. The databases and uploaded
+# files live in a Docker volume, so they survive deploys.
+#
+# To deploy your own Fizzy:
+#
+#   1. Fill in the hostname and mail server below.
+#   2. Export the secrets listed in .kamal/secrets.
+#   3. Run `bin/kamal setup` the first time, and `bin/kamal deploy` for every release after that.
+#
+# See docs/deployment.md for the details.
+
+<%
+  # The hostname you'll serve Fizzy from. Its DNS record must point at your server and ports
+  # 80 and 443 must be reachable, so Let's Encrypt can issue the certificate.
+  host = "fizzy.example.com"
+%>
+
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - <%= host %> # Where Kamal SSHes to. Put the IP here if it differs from the hostname above.
+
+proxy:
+  ssl: true
+  host: <%= host %>
+
+# Images are pushed to a registry that Kamal runs on your server, so no external registry or
+# credentials are needed. To use Docker Hub, GHCR or another registry instead, change this to:
+#
+#   registry:
+#     server: ghcr.io
+#     username: your-github-user
+#     password:
+#       - KAMAL_REGISTRY_PASSWORD
+#
+# and add KAMAL_REGISTRY_PASSWORD to .kamal/secrets. The image name must then include your
+# user or organization, e.g. `image: your-github-user/fizzy`.
+registry:
+  server: localhost:5555
+
+# Build for the architecture of your server. Use `arch: arm64` for ARM servers (e.g. AWS Graviton,
+# Hetzner CAX) or `arch: [ amd64, arm64 ]` to build for both.
+builder:
+  arch: amd64
+
+env:
+  clear:
+    APP_HOST: <%= host %>
+
+    # The address mail is sent from, and the SMTP server that sends it.
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: fizzy@example.com
+    # SMTP_DOMAIN: example.com          # HELO domain, defaults to APP_HOST
+    # SMTP_AUTHENTICATION: plain        # plain, login or cram_md5
+    # SMTP_ENABLE_STARTTLS_AUTO: true   # set to false if your server doesn't offer STARTTLS
+    # SMTP_TLS: true                    # implicit TLS, typically with SMTP_PORT: 465
+
+    # Puma web workers and Solid Queue worker processes. Both default to the number of CPUs.
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 1
+
+    # Uncomment to host several accounts on one Fizzy, each signing up at /signup.
+    # MULTI_TENANT: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases and uploaded files. This volume persists across deploys and container
+# replacements; back it up to keep your data safe.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep the assets of the previous version around during a deploy, so pages that were loaded
+# right before don't 404 on their JS and CSS.
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Kamal connects as root by default. To deploy as another user with Docker access:
+#
+# ssh:
+#   user: deploy
