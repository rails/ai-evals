new file mode 100644
index 0000000..654a06d
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,51 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preloaded
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..9f785e3
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,43 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction in the strip. Reactions are rendered once for everybody
+// (comments are cached), so ownership is resolved here against the current user:
+// your own reactions can be expanded to reveal the delete button, other people's can't.
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded", "deleting" ]
+  static values = { reacterId: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  refresh() {
+    if (this.#mine) {
+      this.element.classList.add(this.deleteableClass)
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("tabindex", "0")
+    }
+  }
+
+  toggle() {
+    if (this.#mine) {
+      this.element.classList.toggle(this.expandedClass)
+    }
+  }
+
+  collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  remove() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #mine() {
+    return this.reacterIdValue === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..f9c9ea1
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,51 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" button for a small inline form, and back again.
+// While the form is open the element is marked permanent, so a broadcasted page
+// refresh can't morph away a reaction that's being typed.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "menu", "emojiList" ]
+  static classes = [ "expanded" ]
+
+  open() {
+    this.#populateEmojiList()
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(...this.expandedClasses)
+    this.element.setAttribute("data-turbo-permanent", "")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    if (this.formTarget.hidden) return
+
+    event.stopPropagation()
+    this.#reset()
+    this.triggerTarget.focus()
+  }
+
+  pick({ params: { emoji } }) {
+    this.inputTarget.value = emoji
+    this.inputTarget.form.requestSubmit()
+  }
+
+  #populateEmojiList() {
+    if (this.emojiListTarget.childElementCount > 0) return
+
+    const template = document.getElementById("reaction_emoji_list")
+
+    if (template) {
+      this.emojiListTarget.append(template.content.cloneNode(true))
+    } else {
+      this.menuTarget.hidden = true
+    }
+  }
+
+  #reset() {
+    this.inputTarget.form.reset()
+    this.formTarget.classList.remove(...this.expandedClasses)
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.element.removeAttribute("data-turbo-permanent")
+  }
+}
