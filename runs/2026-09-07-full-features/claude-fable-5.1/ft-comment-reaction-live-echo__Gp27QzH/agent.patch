+      assert_select "##{dom_id(reactions(:logo_agreement_jz_thumbs_up_by_kevin))}[data-reaction-reacter-id-value=?]", users(:kevin).id
+      assert_select ".reactions__trigger img[src*=?]", "boost-color"
