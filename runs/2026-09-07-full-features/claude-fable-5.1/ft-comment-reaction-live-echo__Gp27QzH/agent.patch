+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_jz_nice_by_david)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(reaction.card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reactions are rendered with the comment" do
+    comment = comments(:logo_agreement_jz)
+
+    get card_path(comment.card)
+
+    assert_response :success
+    assert_select "##{dom_id(comment, :reactions)}.reactions" do
