diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..e0bb299
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,28 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+  EMOJI_ONLY_PATTERN = /\A(?:\p{Extended_Pictographic}|\p{Emoji_Presentation}|\p{Emoji_Modifier}|\p{Regional_Indicator}|\u200d|\ufe0f|\s)+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { includes(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create :register_card_activity
+
+  delegate :card, to: :comment
+
+  def emoji_only?
+    content.present? && content.match?(EMOJI_ONLY_PATTERN)
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
