+<%# locals: (comment:) %>
+<%= tag.div id: dom_id(comment, :new_reaction), class: "reactions__new",
+      data: { controller: "reaction-form", reaction_form_expanded_class: "reaction expanded", action: "keydown.esc->reaction-form#cancel" } do %>
+  <button type="button" class="reactions__trigger btn btn--circle" data-controller="tooltip" data-reaction-form-target="trigger" data-action="reaction-form#open">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <div class="reaction__form" hidden data-reaction-form-target="form">
+    <%= form_with model: [ comment.card, comment, Reaction.new ], class: "flex align-center", data: { controller: "form", action: "submit->form#preventEmptySubmit" } do |form| %>
+      <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false" data-reaction-form-target="menu"
+          data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless fill-transparent" data-action="dialog#toggle">
+          <%= icon_tag "reaction" %>
+          <span class="for-screen-reader">Pick an emoji</span>
+        </button>
+
+        <dialog class="reaction__popup popup panel fill-white shadow" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
+          <div class="reaction__emoji-list" data-reaction-form-target="emojiList"></div>
+        </dialog>
+      </div>
+
+      <%= form.label :content, for: dom_id(comment, :reaction_content), class: "reaction__form-label flex align-center" do %>
+        <span class="for-screen-reader">Your reaction</span>
+        <%= form.text_field :content, id: dom_id(comment, :reaction_content), class: "reaction__input input txt-small", placeholder: "React…",
+              maxlength: Reaction::MAX_CONTENT_LENGTH, required: true, autocomplete: "off", autocorrect: "off",
+              data: { reaction_form_target: "input", form_target: "input", "1p-ignore": "true" } %>
+      <% end %>
+
+      <%= form.button type: "submit", class: "reaction__submit-btn btn btn--circle borderless fill-transparent" do %>
+        <%= icon_tag "check-circle" %>
+        <span class="for-screen-reader">Add your reaction</span>
+      <% end %>
+
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless fill-transparent" data-action="reaction-form#cancel">
+        <%= icon_tag "close-circle" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+<% end %>
