diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..2f669ba
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,54 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime, describeDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Puts <time> elements rendered by TimeHelper#local_datetime_tag into words in
+// the viewer's own timezone. Lives on <body>, so any <time> that arrives later
+// (frames, streams, morphs) gets rendered as it connects.
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(this.refresh.bind(this), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  // Morphing leaves an element in place but resets its content to what the server sent
+  morph({ target }) {
+    if (target.hasAttribute(this.#targetAttribute)) {
+      this.#render(target)
+    }
+  }
+
+  // Relative times drift: "1:42 PM" turns into "yesterday" at midnight
+  refresh() {
+    this.timeTargets.forEach(target => this.#render(target))
+  }
+
+  get #targetAttribute() {
+    return this.application.schema.targetAttributeForScope(this.identifier)
+  }
+
+  #render(target) {
+    const datetime = target.getAttribute("datetime")
+    const text = formatDateTime(datetime, target.dataset.localTimeStyle)
+
+    if (target.textContent !== text) {
+      target.textContent = text
+    }
+
+    if (!target.title) {
+      target.title = describeDateTime(datetime)
+    }
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..a50c914 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,114 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// Formatting for <time> elements rendered by the local-time controller. Unlike
+// the day math above, these deliberately follow the viewer's own timezone.
+//
+// Styles are listed alongside TimeHelper#local_datetime_tag in app/helpers/time_helper.rb.
+
+const LOCALE = "en-US"
+const DATE_ONLY_PATTERN = /^\d{4}-\d{2}-\d{2}$/
+const DAYS_WITHIN_A_WEEK = 7
+
+export function formatDateTime(value, style, now = new Date()) {
+  const { date, dateOnly } = parseDateTime(value)
+
+  if (isNaN(date)) return ""
+
+  switch (dateOnly ? dateOnlyStyleFor(style) : style) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date, now)
+    case "long_date":
+      return formatLongDate(date, now)
+    case "relative":
+      return formatRelative(date, now)
+    default:
+      return formatDate(date, now) + ", " + formatTime(date)
+  }
+}
+
+// Everything at once, for a tooltip: "Friday, September 12, 2025 at 1:42 PM"
+export function describeDateTime(value) {
+  const { date, dateOnly } = parseDateTime(value)
+
+  if (isNaN(date)) return ""
+
+  return dateOnly ? format(date, LONG_DATE_WITH_YEAR) : format(date, { ...LONG_DATE_WITH_YEAR, ...TIME })
+}
+
+export function differenceInCalendarDays(fromDate, toDate) {
+  return Math.round((startOfDay(toDate) - startOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
+
+const TIME = { hour: "numeric", minute: "2-digit" }
+const DATE = { month: "short", day: "numeric" }
+const LONG_DATE = { weekday: "long", month: "long", day: "numeric" }
+const LONG_DATE_WITH_YEAR = { ...LONG_DATE, year: "numeric" }
+
+// A bare "2025-09-12" is a calendar day, not an instant: read it as that day
+// in the viewer's timezone rather than as midnight UTC.
+function parseDateTime(value) {
+  if (DATE_ONLY_PATTERN.test(value)) {
+    const [ year, month, day ] = value.split("-").map(Number)
+    return { date: new Date(year, month - 1, day), dateOnly: true }
+  } else {
+    return { date: new Date(value), dateOnly: false }
+  }
+}
+
+function dateOnlyStyleFor(style) {
+  return style === "long_date" || style === "relative" ? style : "date"
+}
+
+function formatTime(date) {
+  return format(date, TIME)
+}
+
+function formatDate(date, now) {
+  return format(date, withYearUnlessCurrent(DATE, date, now))
+}
+
+function formatLongDate(date, now) {
+  return format(date, withYearUnlessCurrent(LONG_DATE, date, now))
+}
+
+function formatRelative(date, now) {
+  const days = differenceInCalendarDays(now, date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (Math.abs(days) < DAYS_WITHIN_A_WEEK) {
+    return relativeDayFormatter().format(days, "day")
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+function withYearUnlessCurrent(options, date, now) {
+  return date.getFullYear() === now.getFullYear() ? options : { ...options, year: "numeric" }
+}
+
+function startOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+const formatterCache = new Map()
+
+function format(date, options) {
+  const key = JSON.stringify(options)
+
+  if (!formatterCache.has(key)) {
+    formatterCache.set(key, new Intl.DateTimeFormat(LOCALE, options))
+  }
+
+  return formatterCache.get(key).format(date)
+}
+
+let relativeDayFormatterCache
+
+function relativeDayFormatter() {
+  return relativeDayFormatterCache ??= new Intl.RelativeTimeFormat(LOCALE, { numeric: "auto" })
+}
