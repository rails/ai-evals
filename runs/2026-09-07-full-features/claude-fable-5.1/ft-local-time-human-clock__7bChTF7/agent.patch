diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..a5ca6af 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,38 @@
+# Renders timestamps as empty <time> elements carrying the raw value, so the
+# browser can put them into words in the viewer's own timezone (see the
+# local-time Stimulus controller). Keeps server-rendered HTML free of any
+# particular clock, which is what lets it be cached and shared between people.
 module TimeHelper
+  # Styles are formatted client-side in helpers/date_helpers.js:
+  #
+  #   :time      → "1:42 PM"
+  #   :date      → "Sep 12" (or "Sep 12, 2024" outside the current year)
+  #   :datetime  → "Sep 12, 1:42 PM"
+  #   :long_date → "Friday, September 12"
+  #   :relative  → "1:42 PM" today, "yesterday", "5 days ago", "tomorrow",
+  #                "in 3 days", and "Sep 12" beyond a week either way
+  def local_datetime_tag(datetime, style: :datetime, **attributes)
+    data = { local_time_target: "time", local_time_style: style }.merge(attributes.delete(:data) || {})
+
+    tag.time datetime: iso8601_for(datetime), data: data, **attributes
+  end
+
+  # Takes either an instant (rendered as the viewer's calendar date for it) or
+  # a plain Date (rendered as that day, whatever the viewer's timezone).
+  def local_date_tag(date, style: :date, **attributes)
+    local_datetime_tag(date, style: style, **attributes)
+  end
+
+  def local_relative_time_tag(datetime, **attributes)
+    local_datetime_tag(datetime, style: :relative, **attributes)
+  end
+
+  private
+    def iso8601_for(datetime)
+      if datetime.acts_like?(:time)
+        datetime.utc.iso8601
+      else
+        datetime.iso8601
+      end
+    end
 end
