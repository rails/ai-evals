diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..163d50a
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2025, 9, 12, 17, 42, 5)
+  end
+
+  test "local_datetime_tag leaves the words to the browser" do
+    html = local_datetime_tag(@time)
+
+    assert_dom_equal %(<time datetime="2025-09-12T17:42:05Z" data-local-time-target="time" data-local-time-style="datetime"></time>), html
+  end
+
+  test "local_datetime_tag sends the same timestamp whatever the server's timezone" do
+    in_zone = Time.use_zone("Asia/Tokyo") { local_datetime_tag(Time.zone.at(@time)) }
+    in_utc = Time.use_zone("UTC") { local_datetime_tag(Time.zone.at(@time)) }
+
+    assert_equal in_utc, in_zone
+    assert_includes in_zone, %(datetime="2025-09-12T17:42:05Z")
+  end
+
+  test "local_datetime_tag takes a style and extra attributes" do
+    html = local_datetime_tag(@time, style: :time, class: "stamp", data: { foo: "bar" })
+
+    assert_dom_equal %(<time datetime="2025-09-12T17:42:05Z" class="stamp" data-foo="bar" data-local-time-target="time" data-local-time-style="time"></time>), html
+  end
+
+  test "local_date_tag renders an instant as a date" do
+    assert_dom_equal %(<time datetime="2025-09-12T17:42:05Z" data-local-time-target="time" data-local-time-style="date"></time>), local_date_tag(@time)
+  end
+
+  test "local_date_tag renders a plain date as that day, wherever the viewer is" do
+    assert_dom_equal %(<time datetime="2025-01-22" data-local-time-target="time" data-local-time-style="long_date"></time>),
+      local_date_tag(Date.new(2025, 1, 22), style: :long_date)
+  end
+
+  test "local_relative_time_tag" do
+    assert_dom_equal %(<time datetime="2025-09-12T17:42:05Z" data-local-time-target="time" data-local-time-style="relative"></time>), local_relative_time_tag(@time)
+  end
+end
diff --git a/test/system/local_time_morph_test.rb b/test/system/local_time_morph_test.rb
new file mode 100644
index 0000000..7bab85b
--- /dev/null
+++ b/test/system/local_time_morph_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class LocalTimeMorphTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    @comment.update_columns(created_at: 1.day.ago)
+  end
+
+  test "times survive a turbo stream morph and a page refresh" do
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /yesterday/i
+
+    click_on "Mark as Done"
+
+    today = Time.now.in_time_zone("America/New_York").strftime("%b %-d")
+    assert_selector ".card-perma__closure-message", text: "Completed by Kevin on #{today}."
+    assert_selector ".card-perma .card__closed-date time", text: /#{today}/i
+    assert_selector comment_time_selector, text: /yesterday/i
+
+    # A page refresh (as a broadcast would trigger) morphs the whole body in place
+    @card.reload.update_columns(title: "Retitled elsewhere")
+    page.execute_script("Turbo.session.refresh(location.href)")
+    assert_selector "h1", text: "Retitled elsewhere"
+    assert_selector comment_time_selector, text: /yesterday/i
+    assert_no_selector "time", text: /\A\s*\z/, visible: :all
+  end
+
+  test "an element morphed in place gets its time put back into words" do
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /yesterday/i
+
+    # Morph the comment with what the server sends: the same markup, with the <time> left empty
+    page.execute_script(<<~JS, dom_id(@comment))
+      const comment = document.getElementById(arguments[0])
+      const template = document.createElement("template")
+      template.innerHTML = comment.outerHTML.replace(/(<time[^>]*>)[^<]*(<\\/time>)/g, "$1$2")
+
+      const stream = document.createElement("turbo-stream")
+      stream.setAttribute("action", "replace")
+      stream.setAttribute("method", "morph")
+      stream.setAttribute("target", comment.id)
+      stream.appendChild(template)
+      document.body.appendChild(stream)
+    JS
+
+    assert_selector comment_time_selector, text: /yesterday/i
+    assert_no_selector "##{dom_id(@comment)} time", text: /\A\s*\z/, visible: :all
+  end
+
+  test "the events timeline shows the day and hour timestamps" do
+    visit events_url
+    assert_selector ".events__column-header time", text: /\A[a-z]+day, [a-z]+ \d{1,2}\z/i
+    assert_selector ".event__timestamp time", text: /\A\d{1,2}:\d{2} [AP]M\z/i
+  end
+
+  private
+    def comment_time_selector
+      "##{dom_id(@comment)} .comment__permalink-title time"
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..7c935fb
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,108 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "times are rendered by the browser in the viewer's timezone" do
+    use_browser_timezone "Asia/Tokyo"
+    @comment.update_columns(created_at: 1.day.ago)
+
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /yesterday/i
+
+    use_browser_timezone "America/Los_Angeles"
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /yesterday/i
+
+    assert_no_selector comment_time_selector, text: /\A\s*\z/
+  end
+
+  test "a comment from earlier today reads as a time of day" do
+    use_browser_timezone "America/New_York"
+    noon = Time.now.in_time_zone("America/New_York").beginning_of_day + 12.hours
+    @comment.update_columns(created_at: noon)
+
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: "12:00 PM"
+
+    use_browser_timezone "Europe/Madrid"
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /(6:00 PM|yesterday|tomorrow)/i
+  end
+
+  test "a comment from earlier in the week reads as days ago, older ones as a date" do
+    use_browser_timezone "America/New_York"
+
+    @comment.update_columns(created_at: 5.days.ago)
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /5 days ago/i
+
+    @comment.update_columns(created_at: 30.days.ago)
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: /\A[A-Z][a-z]{2} \d{1,2}(, \d{4})?\z/
+  end
+
+  test "entropy notice reads tomorrow or in N days" do
+    use_browser_timezone "America/New_York"
+    tomorrow_noon = Time.now.in_time_zone("America/New_York").beginning_of_day + 36.hours
+    @card.update_columns(last_active_at: tomorrow_noon - @card.auto_postpone_period)
+
+    visit card_url(@card)
+    assert_selector "#closure_notice_card_#{@card.id}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    @card.update_columns(last_active_at: tomorrow_noon + 2.days - @card.auto_postpone_period)
+    visit card_url(@card)
+    assert_selector "#closure_notice_card_#{@card.id}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "rendered times carry a full description as a tooltip" do
+    use_browser_timezone "America/New_York"
+    @comment.update_columns(created_at: Time.utc(2024, 9, 12, 17, 42))
+
+    visit card_url(@card)
+    assert_selector comment_time_selector, text: "Sep 12, 2024"
+    assert_equal "Thursday, September 12, 2024 at 1:42 PM", find(comment_time_selector)[:title]
+  end
+
+  private
+    def comment_time_selector
+      "#comment_#{@comment.id} .comment__permalink-title time"
+    end
+
+    def use_browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+end
+
+class LocalTimeBridgeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "America/New_York")
+  end
+
+  test "the native share description has its dates put into words by the browser" do
+    card = cards(:logo)
+    card.update_columns(created_at: Time.utc(2024, 9, 12, 17, 42), last_active_at: Time.utc(2024, 9, 14, 3, 0))
+
+    visit card_url(card)
+
+    description = find("button[data-controller='bridge--share'] [data-bridge--share-target='description']", visible: :all)
+    assert_equal "Added Sep 12, 2024 by David and assigned to JZ and Kevin. Updated Sep 13, 2024", description.text(:all).squish
+  end
+
+  test "the stamp exposes its date to the native bridge as a target" do
+    card = cards(:logo)
+    card.close(user: users(:kevin))
+    card.closure.update_columns(created_at: Time.utc(2024, 9, 14, 3, 0))
+
+    visit card_url(card)
+
+    stamps = all(".card-perma [data-controller='bridge--stamp'] [data-bridge--stamp-target='description']", visible: :all)
+    assert stamps.any?
+    stamps.each { |stamp| assert_equal "Sep 13, 2024", stamp.text(:all) }
+  end
+end
