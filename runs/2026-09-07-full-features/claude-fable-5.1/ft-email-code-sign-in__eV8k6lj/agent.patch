+require "test_helper"
+
+class MagicLinkMailerTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @magic_link = @identity.magic_links.create!(code: "ABC123")
+    @email = MagicLinkMailer.sign_in_instructions(@magic_link)
+  end
+
+  test "sends to the identity's email address" do
+    assert_emails 1 do
+      @email.deliver_now
+    end
+
+    assert_equal [ @identity.email_address ], @email.to
+  end
+
+  test "puts the code in the subject" do
+    assert_equal "ABC123 is your Fizzy sign-in code", @email.subject
+  end
+
+  test "includes the code and how long it lasts in both parts" do
+    assert @email.html_part.present?, "Email should have HTML part"
+    assert @email.text_part.present?, "Email should have text part"
+
+    assert_match "ABC123", @email.html_part.body.encoded
+    assert_match "ABC123", @email.text_part.body.encoded
+    assert_match "15 minutes", @email.text_part.body.encoded
+  end
+end
