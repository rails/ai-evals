+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <p>
+      <% if @identity %>
+        We sent a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @identity.email_address %></strong>.
+      <% else %>
+        If that email address has a Fizzy account, we sent it a <%= MagicLink::CODE_LENGTH %>-character code.
+      <% end %>
+      Enter it here to continue.
+    </p>
+
+    <div class="flex align-center justify-center gap">
+      <%= form.text_field :code, required: true, class: "input", autofocus: true, autocomplete: "one-time-code",
+            autocapitalize: "characters", spellcheck: false, maxlength: MagicLink::CODE_LENGTH, placeholder: "•" * MagicLink::CODE_LENGTH,
+            aria: { label: "Code" } %>
+    </div>
+
+    <button type="submit" id="verify_code" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">
+    The code works for <%= distance_of_time_in_words(MagicLink::EXPIRY) %>.
+    Didn’t get it? Check your spam folder, or <%= link_to "start over", new_session_path, class: "txt-link" %> to get a new one.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
