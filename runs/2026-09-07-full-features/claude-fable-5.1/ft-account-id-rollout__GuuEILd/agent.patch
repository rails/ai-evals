diff --git a/app/models/filter/selection.rb b/app/models/filter/selection.rb
new file mode 100644
index 0000000..6991338
--- /dev/null
+++ b/app/models/filter/selection.rb
@@ -0,0 +1,10 @@
+# Join rows pairing a filter with one of the resources it filters by (tags, boards,
+# assignees, creators or closers). They have no primary key of their own; they belong
+# to the filter's account so every row can be attributed to a tenant.
+class Filter::Selection < ApplicationRecord
+  self.abstract_class = true
+  self.primary_key = nil
+
+  belongs_to :account, default: -> { filter.account }
+  belongs_to :filter
+end
