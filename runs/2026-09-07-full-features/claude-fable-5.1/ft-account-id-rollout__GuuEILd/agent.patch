--- /dev/null
+++ b/test/models/account_scoping_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class AccountScopingTest < ActiveSupport::TestCase
+  # Tables that don't hold an account's data: the accounts themselves, global identity
+  # and authentication records, and bookkeeping.
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens sessions magic_links
+    action_pack_passkeys schema_migrations ar_internal_metadata search_records_fts
+  ]
+
+  test "every account table has a required, indexed account_id" do
+    connection = ActiveRecord::Base.connection
+
+    connection.tables.each do |table|
+      next if GLOBAL_TABLES.include?(table) || table.start_with?("search_records_fts_")
+
+      column = connection.columns(table).find { it.name == "account_id" }
+      assert column, "#{table} has no account_id column"
+      assert_not column.null, "#{table}.account_id is nullable"
+      assert connection.indexes(table).any? { it.columns.first == "account_id" }, "#{table}.account_id is not indexed"
+    end
+  end
+
+  test "records take their account from their parent" do
+    card = cards(:logo)
+    user = users(:kevin)
+    board = boards(:writebook)
+
+    assert_equal board.account, Access.create!(board: board, user: users(:mike)).account
+    assert_equal board.account, Board::Publication.create!(board: board).account
+    assert_equal board.account, Entropy.create!(container: board.account.boards.create!(name: "Entropic", creator: users(:david)), auto_postpone_period: 3.days.to_i).account
+    assert_equal card.account, Reaction.create!(reactable: card, reacter: user, content: "👍").account
+    assert_equal card.account, Reaction.create!(reactable: comments(:logo_1), reacter: user, content: "👍").account
+    assert_equal card.account, Mention.create!(source: comments(:logo_1), mentioner: user, mentionee: users(:jz)).account
+    assert_equal card.account, Card::Goldness.create!(card: cards(:layout)).account
+    assert_equal user.account, user.create_settings!.account
+    assert_equal user.account, user.search_queries.create!(terms: "haggis").account
+  end
+
+  test "account entropy and storage total belong to the account itself" do
+    account = Account.create!(name: "Fresh")
+
+    assert_equal account, account.entropy.account
+    assert_equal account, Storage::Total.create!(owner: account).account
+  end
+
+  test "filter selections carry the filter's account" do
+    filter = users(:david).filters.create! tag_ids: [ tags(:mobile).id ], board_ids: [ boards(:writebook).id ], assignee_ids: [ users(:jz).id ]
+
+    assert_equal [ accounts("37s") ], filter.tag_selections.map(&:account).uniq
+    assert_equal [ accounts("37s") ], filter.board_selections.map(&:account).uniq
+    assert_equal [ accounts("37s") ], filter.assignee_selections.map(&:account).uniq
+
+    filter.update! tag_ids: []
+    assert_empty filter.reload.tag_selections
+  end
+
+  test "tags are unique per account, not globally" do
+    Current.account = accounts(:initech)
+    assert_nothing_raised { Tag.create!(title: tags(:web).title) }
+    assert_raises(ActiveRecord::RecordNotUnique) { Tag.create!(title: tags(:web).title) }
+  end
+
+  test "blobs, attachments and rich texts are account scoped" do
+    card = cards(:logo)
+    card.update!(description: "<p>Scoped</p>")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    assert_equal card.account, card.rich_text_description.account
+    assert_equal card.account, card.image.attachment.account
+    assert_equal card.account, card.image.blob.account
+  end
+
+  test "variants generated outside an account context inherit the account" do
+    card = cards(:logo)
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    variant = Current.without_account { card.image.blob.variant(resize_to_limit: [ 10, 10 ]).processed }
+    record = ActiveStorage::VariantRecord.find_by!(blob: card.image.blob, variation_digest: variant.variation.digest)
+
+    assert_equal card.account, record.account
+    assert_equal card.account, record.image.attachment.account
+    assert_equal card.account, record.image.blob.account
+  end
+
+  test "blobs cannot be created without an account" do
+    Current.without_account do
+      blob = ActiveStorage::Blob.new(filename: "x", key: "x", byte_size: 0, checksum: "x", service_name: "test")
+      assert_not blob.valid?
+      assert_includes blob.errors[:account], "must exist"
+    end
+  end
+
+  test "bulk-granted accesses carry the board's account" do
+    board = boards(:writebook)
+    board.accesses.grant_to users(:mike)
+
+    assert_equal board.account, board.access_for(users(:mike)).account
+  end
+end
