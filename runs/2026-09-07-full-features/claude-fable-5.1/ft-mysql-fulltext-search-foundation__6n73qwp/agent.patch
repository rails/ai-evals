diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1324d0a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,133 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+    assert_select "mark", count: 0
+  end
+
+  test "finds cards by title and highlights the matched words" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:logo).id}" do
+      assert_select "mark", text: "logo"
+    end
+    assert_select "#search_result_card_#{cards(:layout).id}", count: 0
+  end
+
+  test "finds cards by description" do
+    cards(:shipping).update! description: "<div>Ship it before the <strong>deadline</strong></div>"
+
+    get search_path(q: "deadline")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:shipping).id}" do
+      assert_select "mark", text: "deadline"
+    end
+  end
+
+  test "finds cards by comment body" do
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "#search_result_card_#{cards(:layout).id}" do
+      assert_select "mark", text: "overflowing"
+      assert_select "h3", text: "Layout is broken"
+    end
+  end
+
+  test "requires every word to match" do
+    get search_path(q: "logo enough")
+    assert_select "#search_result_card_#{cards(:logo).id}"
+
+    get search_path(q: "logo container")
+    assert_select ".search__result", count: 0
+  end
+
+  test "matches case insensitively and keeps the original casing" do
+    get search_path(q: "LAYOUT")
+    assert_select "#search_result_card_#{cards(:layout).id}" do
+      assert_select "mark", text: "Layout"
+    end
+  end
+
+  test "lists newest cards first" do
+    older = create_card title: "Searchable older card", created_at: 2.days.ago
+    newer = create_card title: "Searchable newer card", created_at: 1.day.ago
+
+    get search_path(q: "searchable")
+    assert_response :success
+
+    ids = css_select(".search__result").map { |node| node["id"] }
+    assert_equal [ "search_result_card_#{newer.id}", "search_result_card_#{older.id}" ], ids
+  end
+
+  test "never shows drafts or their comments" do
+    draft = create_card title: "Secret draft plans"
+    with_current_user :kevin do
+      draft.comments.create! body: "Hush about the draft plans"
+    end
+    draft.update_columns status: "drafted"
+
+    get search_path(q: "draft plans")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "only shows cards from boards the searcher has access to" do
+    create_card title: "Confidential roadmap", board: boards(:private)
+
+    get search_path(q: "confidential")
+    assert_select ".search__result", count: 1
+
+    logout_and_sign_in_as :david
+    get search_path(q: "confidential")
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "escapes user content while highlighting" do
+    create_card title: "<script>alert('xss')</script> alerting"
+
+    get search_path(q: "alert")
+    assert_response :success
+    assert_no_match "<script>", response.body
+    assert_select "mark", text: "alert", minimum: 1
+  end
+
+  test "treats like wildcards literally" do
+    get search_path(q: "l_go")
+    assert_select ".search__result", count: 0
+
+    get search_path(q: "%")
+    assert_select ".search__result", count: 0
+  end
+
+  test "copes with regex special characters and lots of words" do
+    get search_path(q: "(logo) *big* [enough] .+? \\ " + ("word " * 20))
+    assert_response :success
+
+    get search_path(q: "(logo")
+    assert_select ".search__result", count: 0
+  end
+
+  test "requires signing in" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+
+  private
+    def create_card(board: boards(:writebook), status: "published", **attributes)
+      with_current_user :kevin do
+        board.cards.create! status: status, **attributes
+      end
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..9801221
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  test "terms are the unique words of the query" do
+    assert_equal [ "logo", "big" ], Search.new("  logo   big logo ", searcher: users(:kevin)).terms
+    assert Search.new("   ", searcher: users(:kevin)).blank?
+    assert_empty Search.new(nil, searcher: users(:kevin)).cards
+  end
+
+  test "finds cards by title, description, or comment body" do
+    cards(:shipping).update! description: "<div>Before the <em>deadline</em></div>"
+
+    assert_equal [ cards(:logo) ], Search.new("logo", searcher: users(:kevin)).cards
+    assert_equal [ cards(:shipping) ], Search.new("deadline", searcher: users(:kevin)).cards
+    assert_equal [ cards(:layout) ], Search.new("overflowing", searcher: users(:kevin)).cards
+  end
+
+  test "every term must match somewhere on the card" do
+    assert_equal [ cards(:layout) ], Search.new("layout overflowing", searcher: users(:kevin)).cards
+    assert_empty Search.new("layout logo", searcher: users(:kevin)).cards
+  end
+
+  test "excludes drafts and cards on boards the searcher can't access" do
+    Current.set(user: users(:kevin)) do
+      boards(:private).cards.create! title: "Confidential launch", status: "published"
+      boards(:writebook).cards.create! title: "Confidential draft", status: "drafted"
+    end
+
+    assert_equal [ "Confidential launch" ], Search.new("confidential", searcher: users(:kevin)).cards.map(&:title)
+    assert_empty Search.new("confidential", searcher: users(:david)).cards
+  end
+
+  test "newest cards come first" do
+    Current.set(user: users(:kevin)) do
+      boards(:writebook).cards.create! title: "Ordering first", status: "published", created_at: 3.days.ago
+      boards(:writebook).cards.create! title: "Ordering second", status: "published", created_at: 2.days.ago
+    end
+
+    assert_equal [ "Ordering second", "Ordering first" ], Search.new("ordering", searcher: users(:kevin)).cards.map(&:title)
+  end
+
+  test "matched text comes from the description or comment mentioning a term" do
+    search = Search.new("overflowing", searcher: users(:kevin))
+
+    assert_equal "The text is overflowing the container.", search.matched_text_for(cards(:layout))
+    assert_nil search.matched_text_for(cards(:logo))
+  end
+end
