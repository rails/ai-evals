@@ -0,0 +1,31 @@
+<% @page_title = @search.blank? ? "Search" : "Search: #{@search.query}" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half", data: { turbo_frame: "_top" } do %>
+    <%= search_query_field_tag @search %>
+    <button class="btn btn--reversed">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    </button>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="blank-slate center">Find cards by their title, description, or the comments on them</div>
+  <% else %>
+    <div class="search__results flex flex-column gap-half" data-controller="navigable-list" data-action="keydown@document->navigable-list#navigate">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+      <% end %>
+      <div class="search__blank-slate blank-slate center">No cards match “<%= @search.query %>”</div>
+    </div>
+  <% end %>
+</section>
