+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Cards whose title, description, or any comment contain every one of the terms.
+    def matching(terms)
+      terms.reduce(all) { |cards, term| cards.matching_term(term) }
+    end
+
+    def matching_term(term)
+      where(Search::Like.contains(arel_table[:title], term))
+        .or(where(id: descriptions_matching(term).select(:record_id)))
+        .or(where(id: Comment.matching_term(term).select(:card_id)))
+    end
+
+    private
+      def descriptions_matching(term)
+        ActionText::RichText.where(record_type: name, name: "description").where(Search::Like.contains(ActionText::RichText.arel_table[:body], term))
+      end
+  end
+end
