+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Comments whose body contains at least one of the terms.
+    def matching_any(terms)
+      terms.map { |term| matching_term(term) }.reduce(:or)
+    end
+
+    def matching_term(term)
+      joins(:rich_text_body).where(Search::Like.contains(ActionText::RichText.arel_table[:body], term))
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..dff13f8
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,45 @@
+class Search
+  MAX_TERMS = 10
+
+  attr_reader :query, :searcher
+
+  def initialize(query, searcher: Current.user)
+    @query = query.to_s.squish
+    @searcher = searcher
+  end
+
+  def terms
+    @terms ||= query.split(" ").uniq.first(MAX_TERMS)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    if blank?
+      Card.none
+    else
+      searcher.accessible_cards.published.matching(terms).reverse_chronologically.preloaded
+    end
+  end
+
+  # Plain text of the description, or else the earliest comment, mentioning any of the terms,
+  # so results can show where they matched.
+  def matched_text_for(card)
+    if matches?(description = card.description.to_plain_text)
+      description
+    elsif comment = card.comments.matching_any(terms).chronologically.first
+      comment.body.to_plain_text
+    end
+  end
+
+  def matches?(text)
+    text.present? && text.match?(pattern)
+  end
+
+  # Longer terms first so overlapping ones like "logo" and "log" highlight the longest match.
+  def pattern
+    @pattern ||= Regexp.union(terms.sort_by { |term| -term.length }.map { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) })
+  end
+end
diff --git a/app/models/search/like.rb b/app/models/search/like.rb
new file mode 100644
index 0000000..c92a477
--- /dev/null
+++ b/app/models/search/like.rb
@@ -0,0 +1,10 @@
+# Substring matching that behaves the same on MySQL and SQLite, taking LIKE wildcards in the term literally.
+module Search::Like
+  ESCAPE_CHARACTER = "!"
+
+  extend self
+
+  def contains(column, term)
+    column.matches("%#{ActiveRecord::Base.sanitize_sql_like(term, ESCAPE_CHARACTER)}%", ESCAPE_CHARACTER)
+  end
+end
