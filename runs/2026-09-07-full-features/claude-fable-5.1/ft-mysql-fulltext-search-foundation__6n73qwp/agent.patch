index 0000000..2eb325b
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,26 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 120
+
+  def search_query_field_tag(search)
+    text_field_tag :q, search.query,
+      type: "search",
+      placeholder: "Search cards by title, description, or comment…",
+      class: "input search__input",
+      autofocus: true,
+      autocorrect: "off",
+      autocomplete: "off",
+      data: { "1p-ignore": "true" }
+  end
+
+  # Wraps every occurrence of the search terms in <mark>, escaping everything else.
+  def highlight_search_terms(text, search)
+    safe_join text.to_s.split(/(#{search.pattern})/).map { |part| search.matches?(part) ? tag.mark(part) : part }
+  end
+
+  # A highlighted snippet around the first match in the description or comment that matched, when one did.
+  def search_result_excerpt(card, search)
+    if (text = search.matched_text_for(card)) && (snippet = excerpt(text.squish, search.pattern, radius: EXCERPT_RADIUS, omission: "…"))
+      highlight_search_terms snippet, search
+    end
+  end
+end
diff --git a/app/javascript/controllers/search_link_controller.js b/app/javascript/controllers/search_link_controller.js
new file mode 100644
index 0000000..4115f90
--- /dev/null
+++ b/app/javascript/controllers/search_link_controller.js
@@ -0,0 +1,18 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Points a link at the search page for whatever is typed in the input, hiding it when there's nothing to search for.
+export default class extends Controller {
+  static targets = [ "input", "link", "query" ]
+  static values = { url: String }
+
+  update() {
+    const query = this.inputTarget.value.trim()
+
+    this.linkTargets.forEach(link => {
+      link.href = `${this.urlValue}?q=${encodeURIComponent(query)}`
+      link.hidden = query.length === 0
+    })
+
+    this.queryTargets.forEach(element => element.textContent = query)
+  }
+}
