+      </dl>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider txt-medium">Plan</h2>
+      </header>
+
+      <dl class="margin-block-half">
+        <dt class="txt-x-small txt-ink-medium">Plan</dt>
+        <dd><strong><%= @account.billing_plan.name %></strong><%= " (comped)" if @account.comped? %></dd>
