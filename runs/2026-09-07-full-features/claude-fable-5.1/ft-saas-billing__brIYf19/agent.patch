diff --git a/saas/lib/fizzy/saas/mounted_at_root.rb b/saas/lib/fizzy/saas/mounted_at_root.rb
new file mode 100644
index 0000000..c39acaa
--- /dev/null
+++ b/saas/lib/fizzy/saas/mounted_at_root.rb
@@ -0,0 +1,21 @@
+module Fizzy
+  module Saas
+    # The engine is mounted at "/", so its routes live wherever the request does: under the
+    # account slug that AccountSlug::Extractor moved into SCRIPT_NAME, or at the top level.
+    #
+    # Rails only tells the engine's URL helpers about that when the request is dispatched
+    # through the engine itself. Telling them for every request means links to engine routes
+    # from the app's own pages stay within the same account, and `script_name: nil` opts out,
+    # just like it does for the app's routes.
+    class MountedAtRoot
+      def initialize(app)
+        @app = app
+      end
+
+      def call(env)
+        env[Engine.routes.env_key] = env["SCRIPT_NAME"].to_s.dup
+        @app.call env
+      end
+    end
+  end
+end
diff --git a/saas/lib/fizzy/saas/testing.rb b/saas/lib/fizzy/saas/testing.rb
index 3b40f02..37168d1 100644
--- a/saas/lib/fizzy/saas/testing.rb
+++ b/saas/lib/fizzy/saas/testing.rb
@@ -18,3 +18,27 @@ module Fizzy::Saas::EngineFixtures
 end
 
 ActiveRecord::TestFixtures.singleton_class.prepend(Fizzy::Saas::EngineFixtures)
+
+# Routes load lazily, and only a `*_path` or `*_url` call triggers that. The `saas` route proxy
+# is defined when the application's routes finalize, so a test reaching for `saas.` before any
+# other URL helper would find nothing there. Load the routes on its behalf.
+module Fizzy::Saas::LazyMountedHelper
+  private
+    def method_missing(name, ...)
+      if name == :saas && Rails.application.reload_routes_unless_loaded
+        public_send(name, ...)
+      else
+        super
+      end
+    end
+
+    def respond_to_missing?(name, include_private = false)
+      if name == :saas && Rails.application.reload_routes_unless_loaded
+        respond_to?(name, include_private)
+      else
+        super
+      end
+    end
+end
+
+ActionDispatch::Routing::RouteSet::MountedHelpers.prepend(Fizzy::Saas::LazyMountedHelper)
