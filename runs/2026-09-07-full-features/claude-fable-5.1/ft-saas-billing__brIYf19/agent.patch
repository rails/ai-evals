@@ -0,0 +1,67 @@
+<% @page_title = "Plans" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Your plan</h2>
+        <div>
+          <strong><%= @account.name %></strong> is on the <strong><%= @account.billing_plan.name %></strong> plan<% if @account.comped? %>, on the house<% end %>.
+        </div>
+      </header>
+
+      <div class="txt-small">
+        <% if @account.card_limit %>
+          <div>Using <strong><%= number_with_delimiter(@account.card_count) %></strong> of <strong><%= number_with_delimiter(@account.card_limit) %></strong> cards.</div>
+        <% end %>
+        <div>Using <strong><%= number_to_human_size(@account.bytes_used) %></strong> of <strong><%= number_to_human_size(@account.storage_limit) %></strong> storage.</div>
+
+        <% if subscription = @account.active_subscription %>
+          <% if subscription.ending? %>
+            <div>Your subscription ends <%= subscription.cancel_at.to_date.to_fs(:long) %>.</div>
+          <% elsif subscription.current_period_end %>
+            <div>Next payment of <%= number_to_currency(subscription.next_amount_due_in_dollars) %> on <%= subscription.current_period_end.to_date.to_fs(:long) %>.</div>
+          <% end %>
+        <% end %>
+      </div>
+
+      <% if @account.paid? %>
+        <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn", form: { data: { turbo: false } } %>
+      <% end %>
+    </section>
+
+    <% @plans.each do |plan| %>
+      <section class="settings__section" id="plan_<%= plan.key %>">
+        <header>
+          <h2 class="divider flex justify-space-between gap">
+            <span><%= plan.name %></span>
+            <span class="txt-normal"><%= plan_price_tag(plan) %></span>
+          </h2>
+          <div><%= plan_allowances(plan).upcase_first %>.</div>
+        </header>
+
+        <% if plan == @account.billing_plan %>
+          <div class="txt-small txt-ink-medium">Your current plan</div>
+        <% elsif plan.paid? && !@account.comped? %>
+          <% if @account.paid? %>
+            <%= button_to saas.account_billing_portal_path, class: "btn", form: { data: { turbo: false } } do %>
+              <span><%= plan.price_in_cents > @account.billing_plan.price_in_cents ? "Upgrade" : "Switch" %> to <%= plan.name %></span>
+            <% end %>
+          <% else %>
+            <%= button_to saas.account_billing_checkouts_path(plan: plan), class: "btn btn--link", form: { data: { turbo: false } } do %>
+              <span>Upgrade to <%= plan.name %></span>
+            <% end %>
+          <% end %>
+        <% end %>
+      </section>
+    <% end %>
+
+    <div class="txt-small txt-ink-medium">
+      Payments are handled by Stripe. <%= link_to "Back to settings", account_settings_path, class: "txt-current txt-underline" %>
+    </div>
+  </div>
+</div>
