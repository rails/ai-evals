+          <% if @account.overridden_limit&.card_count %><span class="txt-x-small txt-ink-medium">(overridden)</span><% end %>
+        </dd>
+
+        <dt class="txt-x-small txt-ink-medium">Storage</dt>
+        <dd>
+          <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+          <% if @account.overridden_limit&.bytes_used %><span class="txt-x-small txt-ink-medium">(overridden)</span><% end %>
+          <% if @account.storage_exception %><span class="txt-x-small txt-ink-medium">(storage exception: <%= number_to_human_size(@account.storage_exception.bytes_allowed) %>)</span><% end %>
+        </dd>
