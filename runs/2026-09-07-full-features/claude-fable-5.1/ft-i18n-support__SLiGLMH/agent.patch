diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..e8d04f0
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,35 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+const DEFAULT_LOCALE = "en"
+const INTL_LOCALES = { en: "en-US", ja: "ja-JP" }
+
+let translationsCache
+let translationsLocale
+
+// The locale the server rendered the page with, as declared on <html lang>.
+export function currentLocale() {
+  return document.documentElement.lang || DEFAULT_LOCALE
+}
+
+// The BCP 47 tag to hand to Intl formatters for the current locale.
+export function intlLocale() {
+  return INTL_LOCALES[currentLocale()] || currentLocale()
+}
+
+// Looks up a translation rendered by the server into the "translations" meta tag,
+// using dotted keys ("local_time.today") and %{name} interpolations, as Rails does.
+export function translate(key, interpolations = {}) {
+  const value = key.split(".").reduce((tree, part) => tree?.[part], translations()) ?? key
+  return Object.entries(interpolations).reduce((text, [ name, replacement ]) => text.replaceAll(`%{${name}}`, replacement), value)
+}
+
+function translations() {
+  const locale = currentLocale()
+
+  if (!translationsCache || translationsLocale !== locale) {
+    translationsLocale = locale
+    translationsCache = JSON.parse(getMetaContent("translations") || "{}")
+  }
+
+  return translationsCache
+}
