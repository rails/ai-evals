diff --git a/test/mailers/export_mailer_test.rb b/test/mailers/export_mailer_test.rb
new file mode 100644
index 0000000..d9582da
--- /dev/null
+++ b/test/mailers/export_mailer_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  setup do
+    @export = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+  end
+
+  test "completed links to the download" do
+    @export.file.attach io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip"
+    email = ExportMailer.completed(@export)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+    assert_match %r{/#{@export.account.external_account_id}/rails/active_storage/blobs/redirect/}, email.text_part.body.to_s
+    assert_match "1 day", email.text_part.body.to_s
+    assert email.html_part.present?
+  end
+
+  test "failed explains there's nothing to download" do
+    email = ExportMailer.failed(@export)
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "Your Fizzy export couldn't be completed", email.subject
+    assert_match(/nothing to download/i, email.text_part.body.to_s)
+  end
+end
