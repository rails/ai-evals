+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @import = Account::Import.create!(identity: identities(:jason))
+  end
+
+  test "completed links to the new account" do
+    @import.update! status: :completed, account: accounts(:initech)
+    email = ImportMailer.completed(@import)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:jason).email_address ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+    assert_match accounts(:initech).name, email.text_part.body.to_s
+    assert_match "http://example.com#{accounts(:initech).slug}/landing", email.text_part.body.to_s
+    assert email.html_part.present?
+  end
+
+  test "failed says why" do
+    @import.update! status: :failed, error_message: "The file isn't a Fizzy account export"
+    email = ImportMailer.failed(@import)
+
+    assert_equal [ identities(:jason).email_address ], email.to
+    assert_equal "Your Fizzy import couldn't be completed", email.subject
+    assert_match "The file isn't a Fizzy account export", email.text_part.body.to_s
+    assert_match(/no account was created/i, email.html_part.body.to_s)
+  end
+end
