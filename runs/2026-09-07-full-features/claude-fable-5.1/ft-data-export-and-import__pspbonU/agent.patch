diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..74eef4a
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,160 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @card.description = "<div>Some description</div>"
+    @card.save!
+    @comment = @card.comments.create!(creator: users(:david), body: "<div>Hi</div>")
+    boards(:writebook).publish
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @comment.update!(body: "<div>See attached</div><action-text-attachment sgid=\"#{embed.attachable_sgid}\"></action-text-attachment><action-text-attachment sgid=\"#{users(:jz).attachable_sgid}\" content-type=\"application/vnd.actiontext.mention\"></action-text-attachment>")
+
+    @export = Account::Export.create!(account: @account, user: users(:kevin))
+    @export.process
+    assert @export.completed?, "export should complete"
+
+    @identity = identities(:jason)
+  end
+
+  test "export contains records and files" do
+    ZipFile.open(@export.file) do |zip|
+      assert_equal 1, zip.glob("accounts/*.json").size
+      assert_equal @account.users.count, zip.glob("users/*.json").size
+      assert_equal @account.cards.count, zip.glob("cards/*.json").size
+      assert_equal Comment.where(account: @account).count, zip.glob("comments/*.json").size
+      assert zip.exists?("files/#{@card.image.blob.id}")
+      assert_equal @card.image.blob.byte_size, zip.read("files/#{@card.image.blob.id}").bytesize
+      assert_not zip.exists?("files/#{@export.file.blob.id}"), "export's own file should not be exported"
+
+      user = JSON.parse(zip.read("users/#{users(:david).id}.json"))
+      assert_equal identities(:david).email_address, user["email_address"]
+    end
+  end
+
+  test "importing an export creates a new account with everything in it" do
+    import = Account::Import.new(identity: @identity)
+    import.file.attach(io: StringIO.new(@export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+
+    assert_difference -> { Account.count }, 1 do
+      assert_enqueued_emails 1 do
+        import.process
+      end
+    end
+
+    assert import.reload.completed?, import.error_message
+    account = import.account
+    assert_not_equal @account, account
+    assert_equal @account.name, account.name
+    assert_equal @account.cards_count, account.cards_count
+    assert_equal @account.users.count, account.users.count
+    assert_equal @account.boards.count, account.boards.count
+    assert_equal @account.cards.count, account.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: account).count
+    assert_equal Event.where(account: @account).count, Event.where(account: account).count
+    assert account.join_code.present?
+    assert_equal @account.entropy.auto_postpone_period, account.entropy.auto_postpone_period
+    assert_equal 1, Entropy.where(account: account, container_type: "Account").count
+
+    # People are matched to identities by email address
+    jason = account.users.find_by!(identity: @identity)
+    assert jason.owner?
+    david = account.users.find_by!(identity: identities(:david))
+    assert_equal users(:david).name, david.name
+    assert_equal users(:david).boards.map(&:name).sort, david.boards.map(&:name).sort
+    assert account.users.find_by(role: :system).present?
+
+    # Cards keep their relationships
+    card = account.cards.find_by!(number: @card.number)
+    assert_equal @card.title, card.title
+    assert_equal @card.board.name, card.board.name
+    assert_equal @card.comments.count, card.comments.count
+    assert_equal @card.tags.map(&:title).sort, card.tags.map(&:title).sort
+    assert_equal @card.creator.name, card.creator.name
+    assert card.image.attached?
+    assert_not_equal @card.image.blob.key, card.image.blob.key
+    assert_equal @card.image.blob.checksum, card.image.blob.checksum
+    assert_equal @card.image.blob.download, card.image.blob.download
+
+    # Rich text attachments are re-signed for the new records
+    comment = card.comments.find_by!(created_at: @comment.created_at)
+    assert_equal @comment.created_at, comment.created_at
+    assert_equal 2, comment.body.body.attachments.size
+    blob = comment.body.body.attachables.grep(ActiveStorage::Blob).first
+    assert_equal comment.account, blob.account
+    assert_equal "avatar.png", blob.filename.to_s
+    mentioned = comment.body.body.attachables.grep(User).first
+    assert_equal account, mentioned.account
+    assert_equal users(:jz).name, mentioned.name
+
+# Filters keep what they filter by
+filter = Filter.where(account: account).find_by!(creator: david)
+assert_equal [ "JZ" ], filter.assignees.map(&:name)
+assert_equal [ "mobile" ], filter.tags.map(&:title)
+assert_equal Filter.digest_params(filter.as_params), filter.params_digest
+
+# Boards are published under new keys, webhooks keep their settings
+board = account.boards.find_by!(name: boards(:writebook).name)
+boards(:writebook).publication&.then { |publication| assert_not_equal publication.key, board.publication.key }
+assert_equal boards(:writebook).webhooks.map(&:url).sort, board.webhooks.map(&:url).sort
+assert_equal webhooks(:active).subscribed_actions, board.webhooks.find_by!(name: webhooks(:active).name).subscribed_actions
+
+    # Search works in the new account
+    assert_includes Card.where(account: account).mentioning("logo", user: david), card
+  end
+
+  test "an import that fails leaves nothing behind" do
+    import = Account::Import.new(identity: @identity)
+    import.file.attach(io: StringIO.new(@export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import_from).raises("Disk full")
+
+    assert_no_difference [ -> { Account.count }, -> { User.count }, -> { Card.count }, -> { ActiveStorage::Blob.count } ] do
+      assert_enqueued_emails 1 do
+        import.process
+      end
+    end
+
+    assert import.reload.failed?
+    assert_nil import.account
+    assert_equal "Disk full", import.error_message
+  end
+
+  test "files uploaded before an import fails are removed again" do
+    import = Account::Import.new(identity: @identity)
+    import.file.attach(io: StringIO.new(@export.file.download), filename: "export.zip", content_type: "application/zip")
+    import.save!
+
+    Account::Import.any_instance.stubs(:reindex_search).raises("Index unavailable")
+
+    assert_no_difference [ -> { stored_files.size }, -> { ActiveStorage::Blob.count } ] do
+      import.process
+    end
+
+    assert import.reload.failed?
+  end
+
+  test "a file that isn't an export fails with a reason" do
+    import = Account::Import.new(identity: @identity)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "export.zip", content_type: "application/zip")
+    import.save!
+
+    assert_no_difference -> { Account.count } do
+      import.process
+    end
+
+    assert import.reload.failed?
+    assert_match(/not a zip archive/i, import.error_message)
+  end
+
+  private
+    def stored_files
+      Dir.glob(File.join(ActiveStorage::Blob.service.root, "**", "*")).select { |path| File.file?(path) }
+    end
+end
