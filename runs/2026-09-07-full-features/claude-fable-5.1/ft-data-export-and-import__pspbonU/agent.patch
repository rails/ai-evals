+++ b/test/models/export_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  test "creating an export processes it in the background" do
+    assert_enqueued_with job: ExportJob do
+      Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+    end
+  end
+
+  test "cleanup removes finished exports once their download links have expired" do
+    fresh = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin), status: :completed)
+    stale = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin), status: :completed)
+    stale.file.attach io: StringIO.new("zip"), filename: "export.zip", content_type: "application/zip"
+    stale.update_columns updated_at: (Export::DOWNLOAD_LINK_EXPIRY + 1.hour).ago
+    in_progress = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin), status: :processing)
+    in_progress.update_columns updated_at: (Export::DOWNLOAD_LINK_EXPIRY + 1.hour).ago
+
+    assert_difference -> { Export.count }, -1 do
+      assert_enqueued_with job: ActiveStorage::PurgeJob do
+        Export.cleanup
+      end
+    end
+
+    assert Export.exists?(fresh.id)
+    assert Export.exists?(in_progress.id)
+    assert_not Export.exists?(stale.id)
+  end
+
+  test "destroying an account removes its exports" do
+    export = Account::Export.create!(account: accounts(:initech), user: users(:mike))
+
+    accounts(:initech).destroy
+
+    assert_not Export.exists?(export.id)
+  end
+end
