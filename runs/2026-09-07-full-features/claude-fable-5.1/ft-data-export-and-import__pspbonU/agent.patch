@@ -0,0 +1,74 @@
+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @card.save!
+
+    embed = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+    @comment = @card.comments.create!(creator: @user, body: "<div>See attached</div><action-text-attachment sgid=\"#{embed.attachable_sgid}\"></action-text-attachment>")
+
+    @export = User::Export.create!(account: accounts(:"37s"), user: @user)
+  end
+
+  test "exports the cards the user can see as JSON with comments and files" do
+    assert_enqueued_emails 1 do
+      @export.process
+    end
+
+    assert @export.completed?
+    assert @export.file.attached?
+    assert_match(/\A37signals-cards-.*\.zip\z/, @export.file.filename.to_s)
+
+    ZipFile.open(@export.file) do |zip|
+      assert_equal @user.accessible_cards.published.count, zip.glob("cards/*/card.json").size
+
+      card = JSON.parse(zip.read("cards/#{@card.number}/card.json"))
+      assert_equal @card.title, card["title"]
+      assert_equal @card.board.name, card.dig("board", "name")
+      assert_equal @card.comments.count, card["comments"].size
+
+      comment = card["comments"].find { |it| it["id"] == @comment.id }
+      assert_match(/See attached/, comment.dig("body", "plain_text"))
+      assert_equal @user.name, comment.dig("creator", "name")
+      assert_equal [ "avatar.png" ], comment["attachments"].map { |it| it["filename"] }
+
+      assert_equal "moon.jpg", card.dig("image", "filename")
+      assert_equal @card.image.blob.byte_size, zip.read(card.dig("image", "path")).bytesize
+      assert_equal "avatar.png", File.basename(comment["attachments"].first["path"])
+      assert zip.exists?(comment["attachments"].first["path"])
+    end
+  end
+
+  test "does not export cards the user can't see" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret", status: "published") }
+    assert_not @user.accessible_cards.include?(private_card)
+
+    @export.process
+
+    ZipFile.open(@export.file) do |zip|
+      assert_not zip.exists?("cards/#{private_card.number}/card.json")
+      assert zip.exists?("cards/#{@card.number}/card.json")
+    end
+  end
+
+  test "marks the export failed and lets the user know when something goes wrong" do
+    User::Export.any_instance.stubs(:write_to).raises("Disk full")
+
+    assert_enqueued_emails 1 do
+      @export.process
+    end
+
+    assert @export.failed?
+    assert_not @export.file.attached?
+  end
+
+  test "the export is only accessible to its user" do
+    assert @export.accessible_to?(@user)
+    assert_not @export.accessible_to?(users(:kevin))
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..7f14fbe 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,87 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  setup do
+    @tempfile = Tempfile.new([ "test", ".zip" ])
+    @tempfile.binmode
+
+    writer = ZipFile::Writer.new(@tempfile)
+    writer.add_file("docs/readme.json", { "hello" => "world" }.to_json)
+    writer.add_file("docs/empty.txt", "")
+    writer.add_file("files/stored", compress: false) { |sink| 3.times { sink.write("x" * 1024) } }
+    writer.add_file("files/streamed") { |sink| 100.times { |i| sink.write("line #{i}\n") } }
+    writer.close
+    @tempfile.flush
+
+    @reader = ZipFile::Reader.new(File.open(@tempfile.path, "rb"))
+  end
+
+  test "lists, globs and finds entries" do
+    assert_equal %w[ docs/empty.txt docs/readme.json files/stored files/streamed ], @reader.entries.sort
+    assert_equal %w[ docs/empty.txt docs/readme.json ], @reader.glob("docs/*")
+    assert @reader.exists?("files/stored")
+    assert_not @reader.exists?("files/missing")
+  end
+
+  test "reads deflated and stored entries" do
+    assert_equal({ "hello" => "world" }, JSON.parse(@reader.read("docs/readme.json")))
+    assert_equal "", @reader.read("docs/empty.txt")
+    assert_equal "x" * 3072, @reader.read("files/stored")
+    assert_equal 100, @reader.read("files/streamed").lines.size
+  end
+
+  test "streams entries as an IO" do
+    @reader.open("files/streamed") do |io|
+      assert_equal 790, io.size
+      assert_equal "line 0\n", io.read(7)
+      assert_not io.eof?
+
+      rest = +""
+      while (chunk = io.read(100))
+        rest << chunk
+      end
+
+      assert io.eof?
+      assert_equal 783, rest.bytesize
+
+      io.rewind
+      assert_equal "line 0\n", io.read(7)
+    end
+  end
+
+  test "copies entries into other IOs" do
+    copy = StringIO.new
+    @reader.open("files/stored") { |io| IO.copy_stream(io, copy) }
+
+    assert_equal "x" * 3072, copy.string
+  end
+
+  test "raises for missing entries" do
+    assert_raises Errno::ENOENT do
+      @reader.read("nope")
+    end
+  end
+
+  test "rejects files that aren't zip archives" do
+    file = Tempfile.new("not-a-zip")
+    file.write("hello there")
+    file.flush
+
+    assert_raises ZipFile::Reader::InvalidArchive do
+      ZipFile::Reader.new(File.open(file.path, "rb"))
+    end
+  end
+
+  test "reads archives straight from Active Storage" do
+    @tempfile.rewind
+    blob = ActiveStorage::Blob.create_and_upload!(io: @tempfile, filename: "test.zip", content_type: "application/zip")
+    import = Account::Import.create!(identity: identities(:jason), file: blob)
+
+    ZipFile.open(import.file) do |zip|
+      assert_equal "x" * 3072, zip.read("files/stored")
+      assert_equal({ "hello" => "world" }, JSON.parse(zip.read("docs/readme.json")))
+    end
+  end
+end
