diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..80e079c
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "an admin can export the account" do
+    assert_difference -> { Account::Export.count }, 1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_url
+      end
+    end
+
+    assert_redirected_to account_settings_url
+    assert_match(/preparing your export/i, flash[:notice])
+
+    export = Account::Export.last
+    assert_equal accounts(:"37s"), export.account
+    assert_equal users(:kevin), export.user
+    assert export.pending?
+  end
+
+  test "creating an export as JSON" do
+    assert_difference -> { Account::Export.count }, 1 do
+      post account_exports_url, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "a member can't export the account" do
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "processing the export emails a download link that works for a day" do
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        post account_exports_url
+      end
+    end
+
+    export = Account::Export.last
+    assert export.completed?
+    assert export.file.attached?
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:kevin).email_address ], email.to
+
+    download_url = email.text_part.body.to_s[%r{http\S+}]
+    assert_match %r{\Ahttp://example.com/#{accounts(:"37s").external_account_id}/rails/active_storage/blobs/redirect/}, download_url
+
+    get URI(download_url).request_uri
+    assert_redirected_to %r{/rails/active_storage/disk/}
+
+    travel Export::DOWNLOAD_LINK_EXPIRY + 1.minute do
+      get URI(download_url).request_uri
+      assert_response :not_found
+    end
+  end
+
+  test "only the requesting user can download the export" do
+    perform_enqueued_jobs do
+      post account_exports_url
+    end
+
+    download_url = ActionMailer::Base.deliveries.last.text_part.body.to_s[%r{http\S+}]
+
+    logout_and_sign_in_as users(:jason)
+    get URI(download_url).request_uri
+    assert_response :forbidden
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..1ab6706
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :jason
+  end
+
+  test "new" do
+    untenanted do
+      get new_account_import_url
+    end
+
+    assert_response :success
+    assert_select "input[type=file][name='import[file]']"
+  end
+
+  test "new works from within an account too" do
+    get new_account_import_url
+    assert_response :success
+  end
+
+  test "new requires signing in" do
+    sign_out
+
+    untenanted do
+      get new_account_import_url
+    end
+
+    assert_response :redirect
+  end
+
+  test "create imports the uploaded export in the background" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+    perform_enqueued_jobs only: ExportJob
+    zip = Tempfile.new([ "export", ".zip" ], binmode: true).tap { |file| file.write(export.file.download); file.rewind }
+
+    assert_difference -> { Account::Import.count }, 1 do
+      assert_enqueued_with job: Account::ImportJob do
+        untenanted do
+          post account_imports_url, params: { import: { file: Rack::Test::UploadedFile.new(zip.path, "application/zip") } }
+        end
+      end
+    end
+
+    assert_redirected_to session_menu_url(script_name: nil)
+    assert_match(/importing your account/i, flash[:notice])
+
+    import = Account::Import.last
+    assert_equal identities(:jason), import.identity
+    assert import.file.attached?
+    assert_nil import.file.blob.account
+
+    assert_difference -> { Account.count }, 1 do
+      assert_emails 1 do
+        perform_enqueued_jobs only: Account::ImportJob
+      end
+    end
+
+    assert import.reload.completed?, import.error_message
+    assert_equal accounts(:"37s").name, import.account.name
+    assert import.account.users.exists?(identity: identities(:jason))
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ identities(:jason).email_address ], email.to
+    assert_match import.account.slug, email.text_part.body.to_s
+  end
+
+  test "create without a file" do
+    untenanted do
+      post account_imports_url, params: { import: { name: "nope" } }
+    end
+
+    assert_response :bad_request
+  end
+end
