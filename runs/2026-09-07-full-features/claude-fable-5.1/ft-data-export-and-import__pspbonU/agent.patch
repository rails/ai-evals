diff --git a/app/models/user/export.rb b/app/models/user/export.rb
new file mode 100644
index 0000000..cc004a7
--- /dev/null
+++ b/app/models/user/export.rb
@@ -0,0 +1,91 @@
+# The cards a user can see, one JSON file per card with its comments, along with every
+# picture and file attached to the card or its comments.
+class User::Export < Export
+  private
+    def filename
+      "#{account.name.parameterize}-cards-#{Date.current.iso8601}.zip"
+    end
+
+    def write_to(zip)
+      cards.find_each do |card|
+        zip.add_file card_path(card, "card.json"), card_json(card).to_json
+
+        blobs_for(card).each do |blob|
+          export_blob(zip, card, blob)
+        end
+      end
+    end
+
+    def cards
+      user.accessible_cards.published.preloaded.preload(comments: [ :creator, :rich_text_body ])
+    end
+
+    def card_path(card, path)
+      "cards/#{card.number}/#{path}"
+    end
+
+    def card_json(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: user_json(card.creator),
+        assignees: card.assignees.map { |assignee| user_json(assignee) },
+        tags: card.tags.map(&:title).sort,
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed? } },
+        golden: card.golden?,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        due_on: card.due_on,
+        description: rich_text_json(card.description),
+        image: card.image.attached? ? blob_json(card, card.image.blob) : nil,
+        attachments: card.attachments.map { |attachment| blob_json(card, attachment.blob) },
+        comments: card.comments.chronologically.map { |comment| comment_json(comment) },
+        created_at: card.created_at.utc,
+        updated_at: card.updated_at.utc,
+        last_active_at: card.last_active_at.utc
+      }
+    end
+
+    def comment_json(comment)
+      {
+        id: comment.id,
+        creator: user_json(comment.creator),
+        body: rich_text_json(comment.body),
+        attachments: comment.attachments.map { |attachment| blob_json(comment.card, attachment.blob) },
+        created_at: comment.created_at.utc,
+        updated_at: comment.updated_at.utc
+      }
+    end
+
+    def user_json(user)
+      { id: user.id, name: user.name }
+    end
+
+    def rich_text_json(rich_text)
+      { plain_text: rich_text.to_plain_text, html: rich_text.to_s }
+    end
+
+    def blob_json(card, blob)
+      { id: blob.id, filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, path: blob_path(card, blob) }
+    end
+
+    def blob_path(card, blob)
+      card_path(card, "attachments/#{blob.id}/#{blob.filename.sanitized}")
+    end
+
+    def blobs_for(card)
+      [ card.image.blob, *card.attachments.map(&:blob), *card.comments.flat_map { |comment| comment.attachments.map(&:blob) } ].compact.uniq
+    end
+
+    def export_blob(zip, card, blob)
+      zip.add_file blob_path(card, blob), compress: false do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    rescue ActiveStorage::FileNotFoundError
+      Rails.logger.warn "Skipping missing file for blob #{blob.id} while exporting cards for user #{user.id}"
+    end
+end
