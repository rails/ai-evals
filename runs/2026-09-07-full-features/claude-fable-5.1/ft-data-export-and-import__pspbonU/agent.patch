diff --git a/db/migrate/20260710120000_create_exports_and_imports.rb b/db/migrate/20260710120000_create_exports_and_imports.rb
new file mode 100644
index 0000000..446236b
--- /dev/null
+++ b/db/migrate/20260710120000_create_exports_and_imports.rb
@@ -0,0 +1,32 @@
+class CreateExportsAndImports < ActiveRecord::Migration[8.2]
+  def change
+    create_table :exports, id: :uuid do |t|
+      t.string :type, null: false
+      t.uuid :account_id, null: false
+      t.uuid :user_id, null: false
+      t.string :status, null: false, default: "pending"
+
+      t.timestamps
+
+      t.index :account_id
+      t.index :user_id
+    end
+
+    create_table :account_imports, id: :uuid do |t|
+      t.uuid :identity_id, null: false
+      t.uuid :account_id
+      t.string :status, null: false, default: "pending"
+      t.text :error_message
+
+      t.timestamps
+
+      t.index :identity_id
+      t.index :account_id
+    end
+
+    # Imports are uploaded by an identity before the account they will create exists,
+    # so their files can't be scoped to an account.
+    change_column_null :active_storage_blobs, :account_id, true
+    change_column_null :active_storage_attachments, :account_id, true
+  end
+end
