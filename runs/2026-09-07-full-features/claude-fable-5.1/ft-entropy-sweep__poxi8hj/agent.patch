diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..9628ef5 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -24,9 +24,16 @@ module Card::Entropic
   end
 
   class_methods do
+    # Sweeps entropy by entropy rather than through +due_to_be_postponed+: the period is fixed
+    # per entropy, so each query can bound +last_active_at+ with a constant and walk the
+    # (account_id, last_active_at, status) index instead of scanning every card on every batch.
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      Entropy.includes(:account, :container).find_each do |entropy|
+        system_user = entropy.account.system_user
+
+        entropy.cards_due_to_be_postponed.find_each do |card|
+          card.auto_postpone(user: system_user)
+        end
       end
     end
   end
diff --git a/app/models/entropy.rb b/app/models/entropy.rb
index c896fc4..f2d3682 100644
--- a/app/models/entropy.rb
+++ b/app/models/entropy.rb
@@ -10,6 +10,23 @@ class Entropy < ApplicationRecord
 
   after_commit -> { container.cards.touch_all if container }
 
+  # Cards whose auto-postponing is governed by this entropy: all the cards of a board
+  # with its own entropy, or the cards of every board falling back to the account's entropy.
+  def cards
+    case container
+    when Board
+      account.cards.where(board: container)
+    when Account
+      account.cards.left_outer_joins(board: :entropy).where(entropies: { id: nil })
+    else
+      Card.none
+    end
+  end
+
+  def cards_due_to_be_postponed(now: Time.now)
+    cards.active.where(last_active_at: ..(now - auto_postpone_period))
+  end
+
   def auto_postpone_period_in_days
     days = auto_postpone_period / 1.day.to_i
 
diff --git a/test/models/entropy_test.rb b/test/models/entropy_test.rb
index 98abb0a..65ef801 100644
--- a/test/models/entropy_test.rb
+++ b/test/models/entropy_test.rb
@@ -26,3 +26,39 @@ class Entropy::Test < ActiveSupport::TestCase
     end
   end
 end
+
+class Entropy::CardsTest < ActiveSupport::TestCase
+  test "board entropy governs the cards of its board only" do
+    assert_equal boards(:writebook).cards.to_set, entropies(:writebook_board).cards.to_set
+    assert_not_includes entropies(:writebook_board).cards, cards(:radio)
+  end
+
+  test "account entropy governs the cards of boards without their own entropy" do
+    assert_empty entropies("37s_account").cards
+
+    entropies(:writebook_board).destroy
+
+    assert_equal boards(:writebook).cards.to_set, entropies("37s_account").reload.cards.to_set
+    assert_not_includes entropies("37s_account").cards, cards(:radio)
+  end
+
+  test "cards due to be postponed are the active ones inactive for longer than the period" do
+    entropy = entropies(:writebook_board)
+    cards(:logo).update!(last_active_at: entropy.auto_postpone_period.seconds.ago - 1.day)
+    cards(:shipping).update!(last_active_at: entropy.auto_postpone_period.seconds.ago + 1.day)
+    cards(:layout).update!(last_active_at: entropy.auto_postpone_period.seconds.ago - 1.day)
+    cards(:layout).postpone(user: users(:david))
+
+    assert_equal [ cards(:logo) ], entropy.cards_due_to_be_postponed.to_a
+  end
+
+  test "cards due to be postponed match the due_to_be_postponed scope" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 1.day)
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 1.day)
+
+    due_by_entropy = Entropy.all.flat_map { |entropy| entropy.cards_due_to_be_postponed.to_a }
+
+    assert_equal Card.due_to_be_postponed.to_set, due_by_entropy.to_set
+    assert_equal cards(:logo, :radio).to_set, due_by_entropy.to_set
+  end
+end
