diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..04937fa
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled longer ago than the grace period" do
+    due = accounts(:"37s")
+    due.cancel(initiated_by: @user)
+    due.cancellation.update!(created_at: 31.days.ago)
+
+    recently_cancelled = accounts(:initech)
+    recently_cancelled.cancel(initiated_by: users(:mike))
+
+    active = accounts(:acme)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due.id)
+    assert_not User.exists?(account_id: due.id)
+    assert Account.exists?(recently_cancelled.id)
+    assert Account.exists?(active.id)
+  end
+
+  test "does nothing when no account is due" do
+    accounts(:"37s").cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..53987d8
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration includes accounts cancelled longer ago than the grace period" do
+    cancel_before_grace_period(@account)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration excludes recently cancelled and active accounts" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.due_for_incineration, @account
+    assert_not_includes Account.due_for_incineration, accounts(:initech)
+  end
+
+  test "due_for_incineration? follows the grace period" do
+    assert_not @account.due_for_incineration?
+
+    @account.cancel(initiated_by: @user)
+    assert_not @account.due_for_incineration?
+
+    @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.minute)
+    assert @account.due_for_incineration?
+  end
+
+  test "incinerate removes the account and everything in it" do
+    Current.session = sessions(:david)
+    card = cards(:logo)
+    card.image.attach io: StringIO.new("x" * 1000), filename: "test.png", content_type: "image/png"
+    @account.materialize_storage
+
+    cancel_before_grace_period(@account)
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty tenanted_models.select { |model| model.unscoped.where(account_id: @account.id).exists? }
+    assert_not Storage::Total.exists?(owner: @account)
+    assert_not Search::Record.exists?(card_id: card.id)
+    assert enqueued_jobs.any? { |job| job["job_class"] == "ActiveStorage::PurgeJob" }, "attachments should be purged"
+  end
+
+  test "incinerate leaves other accounts alone" do
+    other_account = accounts(:initech)
+    cancel_before_grace_period(@account)
+
+    @account.incinerate
+
+    assert Account.exists?(other_account.id)
+    assert other_account.users.any?
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "incinerate does nothing for an active account" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing before the grace period is over" do
+    @account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  private
+    def cancel_before_grace_period(account)
+      account.cancel(initiated_by: @user)
+      account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.day)
+    end
+
+    def tenanted_models
+      Rails.application.eager_load!
+
+      ApplicationRecord.descendants.select do |model|
+        !model.abstract_class? && model.base_class == model && model.table_exists? && model.column_names.include?("account_id")
+      end
+    end
+end
