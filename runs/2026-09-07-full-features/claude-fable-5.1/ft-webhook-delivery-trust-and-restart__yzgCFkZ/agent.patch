+++ b/test/models/webhook/payload_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:logo_assignment_jz)
+  end
+
+  test "event as JSON by default" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+    body = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal @event.id, body["id"]
+    assert_equal "card_assigned", body["action"]
+    assert_equal cards(:logo).id, body["eventable"]["id"]
+    assert_equal cards(:logo).title, body["eventable"]["title"]
+    assert_equal boards(:writebook).id, body["board"]["id"]
+    assert_equal users(:david).id, body["creator"]["id"]
+    assert_match %r{#{Regexp.escape(accounts(:"37s").slug)}/cards/#{cards(:logo).number}\z}, body["eventable"]["url"]
+  end
+
+  test "comment as JSON" do
+    event = events(:layout_commented)
+    body = JSON.parse(Webhook::Payload.new(webhooks(:active), event).body)
+
+    assert_equal "comment_created", body["action"]
+    assert_equal event.eventable.id, body["eventable"]["id"]
+    assert_equal event.eventable.card_id, body["eventable"]["card"]["id"]
+  end
+
+  test "text message for Slack" do
+    webhook = Webhook.new(url: "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx", board: boards(:writebook)) # gitleaks:allow
+    payload = Webhook::Payload.new(webhook, @event)
+    body = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal %w[ text ], body.keys
+    assert_includes body["text"], %(David assigned JZ to "#{cards(:logo).title}")
+    assert_includes body["text"], "/cards/#{cards(:logo).number}"
+  end
+
+  test "html message for Campfire" do
+    webhook = Webhook.new(url: "https://campfire.example.com/rooms/1/2-abc/messages", board: boards(:writebook))
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, "David assigned JZ to"
+    assert_match %r{<a href="[^"]+/cards/#{cards(:logo).number}">}, payload.body
+    assert_not_includes payload.body, "<html", "renders without the application layout"
+  end
+
+  test "html content for Basecamp" do
+    webhook = Webhook.new(url: "https://3.basecamp.com/1/integrations/tok/buckets/2/chats/3/lines", board: boards(:writebook))
+    payload = Webhook::Payload.new(webhook, @event)
+    body = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal %w[ content ], body.keys
+    assert_includes body["content"], "David assigned JZ to"
+    assert_match %r{<a href="[^"]+/cards/#{cards(:logo).number}">}, body["content"]
+  end
+end
