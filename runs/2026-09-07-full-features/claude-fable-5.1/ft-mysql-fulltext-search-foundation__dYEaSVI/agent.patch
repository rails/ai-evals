diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..4067cf5
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,30 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  MATCHING_TERM_SQL = <<~SQL.squish
+    cards.title LIKE :pattern ESCAPE '#{Search::LIKE_ESCAPE_CHARACTER}'
+    OR EXISTS (
+      SELECT 1 FROM action_text_rich_texts descriptions
+      WHERE descriptions.record_type = 'Card'
+        AND descriptions.record_id = cards.id
+        AND descriptions.name = 'description'
+        AND descriptions.body LIKE :pattern ESCAPE '#{Search::LIKE_ESCAPE_CHARACTER}'
+    )
+    OR EXISTS (
+      SELECT 1 FROM comments
+      INNER JOIN action_text_rich_texts bodies
+        ON bodies.record_type = 'Comment'
+        AND bodies.record_id = comments.id
+        AND bodies.name = 'body'
+      WHERE comments.card_id = cards.id
+        AND bodies.body LIKE :pattern ESCAPE '#{Search::LIKE_ESCAPE_CHARACTER}'
+    )
+  SQL
+
+  included do
+    # Every term has to appear somewhere on the card: its title, its description, or the body of one of its comments.
+    scope :matching, ->(terms) do
+      Array(terms).inject(all) { |cards, term| cards.where(MATCHING_TERM_SQL, pattern: Search.like_pattern_for(term)) }
+    end
+  end
+end
