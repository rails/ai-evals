diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..687f005
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are split on whitespace, deduplicated, and blank when there is no query" do
+    assert_equal %w[ logo enough ], Search.new("  logo   enough logo ").terms
+    assert Search.new(nil).blank?
+    assert Search.new("   ").blank?
+    assert_not Search.new("logo").blank?
+  end
+
+  test "pattern matches any term regardless of case and escapes regexp characters" do
+    search = Search.new("logo a.b")
+
+    assert search.matches?("The LOGO")
+    assert search.matches?("a.b")
+    assert_not search.matches?("axb")
+    assert_not search.matches?("nothing here")
+    assert_equal [ "The ", "LOGO", " is ", "a.b" ], "The LOGO is a.b".split(search.pattern)
+  end
+
+  test "cards are the accessible published cards matching every term, newest first" do
+    newest = boards(:writebook).cards.create!(title: "Newest logo", status: "published")
+    private_card = boards(:private).cards.create!(title: "Private logo", status: "published")
+    draft = users(:kevin).draft_new_card_in(boards(:writebook)).tap { |card| card.update! title: "Draft logo" }
+
+    assert_equal [ private_card, newest, cards(:logo) ], Search.new("logo").cards.to_a
+    assert_not_includes Search.new("logo").cards, draft
+
+    Current.session = sessions(:david)
+    assert_equal [ newest, cards(:logo) ], Search.new("logo").cards.to_a
+  end
+
+  test "cards is empty for a blank query" do
+    assert_empty Search.new("").cards
+  end
+
+  test "matched text prefers the description and falls back to the first matching comment" do
+    cards(:layout).update! description: "<div>The overflowing sidebar</div>"
+
+    assert_equal "The overflowing sidebar", Search.new("overflowing").matched_text_in(cards(:layout))
+    assert_equal "The text is overflowing the container.", Search.new("container").matched_text_in(cards(:layout))
+    assert_nil Search.new("layout").matched_text_in(cards(:layout))
+  end
+end
