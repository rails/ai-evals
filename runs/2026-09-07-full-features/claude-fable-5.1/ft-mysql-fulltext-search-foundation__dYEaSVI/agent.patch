diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e5ac58f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,156 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select "[id^=search_result_card]", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "show finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+    assert_select "#" + dom_id(cards(:layout), :search_result), count: 0
+    assert_select "mark", text: "logo"
+  end
+
+  test "show finds cards by description" do
+    with_current_user(:kevin) { cards(:shipping).update! description: "<div>We should deploy to the cloud next week</div>" }
+
+    get search_path(q: "deploy")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:shipping), :search_result)
+    assert_select "mark", text: "deploy"
+  end
+
+  test "show finds cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:layout), :search_result)
+    assert_select "#" + dom_id(cards(:logo), :search_result), count: 0
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "show requires every word to match somewhere on the card" do
+    get search_path(q: "logo enough")
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+    assert_select "mark", text: "logo"
+    assert_select "mark", text: "enough"
+
+    get search_path(q: "logo agree")
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+
+    get search_path(q: "logo overflowing")
+    assert_select "[id^=search_result_card]", count: 0
+  end
+
+  test "show is case insensitive" do
+    get search_path(q: "LOGO")
+
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+    assert_select "mark", text: "logo"
+  end
+
+  test "show orders results newest first" do
+    newest = with_current_user(:kevin) { boards(:writebook).cards.create!(title: "A brand new logo", status: "published") }
+
+    get search_path(q: "logo")
+
+    ids = css_select("[id^=search_result_card]").map { |node| node["id"] }
+    assert_equal [ dom_id(newest, :search_result), dom_id(cards(:logo), :search_result) ], ids
+  end
+
+  test "show only includes cards from boards the user has access to" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret logo plans", status: "published") }
+
+    get search_path(q: "logo")
+    assert_select "#" + dom_id(private_card, :search_result)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#" + dom_id(private_card, :search_result), count: 0
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+  end
+
+  test "show stops including cards once access to their board is revoked" do
+    private_card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret logo plans", status: "published") }
+
+    get search_path(q: "secret")
+    assert_select "#" + dom_id(private_card, :search_result)
+
+    boards(:private).accesses.destroy_all
+
+    get search_path(q: "secret")
+    assert_select "#" + dom_id(private_card, :search_result), count: 0
+  end
+
+  test "show excludes draft cards" do
+    draft = with_current_user(:kevin) { users(:kevin).draft_new_card_in(boards(:writebook)).tap { |card| card.update! title: "Drafted logo idea" } }
+
+    get search_path(q: "logo")
+
+    assert_select "#" + dom_id(draft, :search_result), count: 0
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+  end
+
+  test "show excludes comments on draft cards" do
+    draft = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Drafted", status: "published").tap do |card|
+        card.comments.create!(body: "an unpublishedword here")
+        card.update_columns status: "drafted"
+      end
+    end
+
+    assert draft.drafted?
+    assert Comment.matching_any("unpublishedword").exists?
+
+    get search_path(q: "unpublishedword")
+
+    assert_select "[id^=search_result_card]", count: 0
+  end
+
+  test "show escapes HTML in results" do
+    with_current_user(:kevin) { cards(:logo).update! title: "<script>alert('logo')</script>" }
+
+    get search_path(q: "logo")
+
+    assert_no_match "<script>", response.body
+    assert_select "mark", text: "logo"
+  end
+
+  test "show treats LIKE wildcards literally" do
+    with_current_user(:kevin) { cards(:logo).update! title: "100% logo" }
+
+    get search_path(q: "%")
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+    assert_select "#" + dom_id(cards(:layout), :search_result), count: 0
+
+    get search_path(q: "_")
+    assert_select "[id^=search_result_card]", count: 0
+  end
+
+  test "show highlights the matching excerpt of a comment" do
+    get search_path(q: "overflowing")
+
+    assert_select "#{"#" + dom_id(cards(:layout), :search_result)} .card__search-excerpt mark", text: "overflowing"
+  end
+  test "show requires a signed in user" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
