@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "matching by title" do
+    assert_includes Card.matching("logo"), cards(:logo)
+    assert_not_includes Card.matching("logo"), cards(:layout)
+  end
+
+  test "matching by description" do
+    cards(:shipping).update! description: "<div>Deploy to the <strong>cloud</strong></div>"
+
+    assert_includes Card.matching("cloud"), cards(:shipping)
+    assert_not_includes Card.matching("cloud"), cards(:logo)
+  end
+
+  test "matching by comment body" do
+    assert_includes Card.matching("overflowing"), cards(:layout)
+    assert_not_includes Card.matching("overflowing"), cards(:logo)
+  end
+
+  test "matching is case insensitive" do
+    assert_includes Card.matching("LOGO"), cards(:logo)
+    assert_includes Card.matching("OVERFLOWING"), cards(:layout)
+  end
+
+  test "matching requires every term to appear somewhere on the card" do
+    assert_includes Card.matching(%w[ logo enough ]), cards(:logo)
+    assert_includes Card.matching(%w[ logo agree ]), cards(:logo)
+    assert_empty Card.matching(%w[ logo overflowing ])
+  end
+
+  test "matching treats LIKE wildcards literally" do
+    cards(:logo).update! title: "100% done_and_dusted"
+
+    assert_equal [ cards(:logo) ], Card.matching("%").to_a
+    assert_equal [ cards(:logo) ], Card.matching("_and_").to_a
+    assert_empty Card.matching("!")
+  end
+
+  test "matching with no terms matches everything" do
+    assert_equal Card.count, Card.matching([]).count
+  end
+end
