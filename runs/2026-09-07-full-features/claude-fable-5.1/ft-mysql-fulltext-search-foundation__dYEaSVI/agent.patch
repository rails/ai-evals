--- /dev/null
+++ b/app/models/comment/searchable.rb
@@ -0,0 +1,11 @@
+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Comments whose body contains at least one of the terms.
+    scope :matching_any, ->(terms) do
+      body = ActionText::RichText.arel_table[:body]
+      joins(:rich_text_body).where Array(terms).map { |term| body.matches(Search.like_pattern_for(term), Search::LIKE_ESCAPE_CHARACTER) }.inject(:or)
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..f4f0add
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,55 @@
+class Search
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  attr_reader :query
+
+  class << self
+    # Portable between MySQL and SQLite, which disagree on how to quote a backslash in an ESCAPE clause.
+    def like_pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term, LIKE_ESCAPE_CHARACTER)}%"
+    end
+  end
+
+  def initialize(query)
+    @query = query.to_s.squish
+  end
+
+  def terms
+    @terms ||= query.split.uniq
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  # Case-insensitively captures any one of the terms, so that splitting a text on it alternates
+  # between unmatched and matched segments.
+  def pattern
+    @pattern ||= /(#{terms.map { |term| Regexp.escape(term) }.join("|")})/i
+  end
+
+  def cards
+    if blank?
+      Card.none
+    else
+      Current.user.accessible_cards.published.matching(terms).reverse_chronologically.preloaded
+    end
+  end
+
+  def matched_text_in(card)
+    if matches?(description = card.description.to_plain_text)
+      description
+    else
+      matching_comment_bodies_in(card).find { |body| matches?(body) }
+    end
+  end
+
+  def matches?(text)
+    text.to_s.match?(pattern)
+  end
+
+  private
+    def matching_comment_bodies_in(card)
+      card.comments.matching_any(terms).chronologically.with_rich_text_body.map { |comment| comment.body.to_plain_text }
+    end
+end
