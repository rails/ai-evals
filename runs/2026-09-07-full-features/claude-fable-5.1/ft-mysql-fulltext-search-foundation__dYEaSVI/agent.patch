+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = @search.blank? ? "Search" : "Search: #{@search.query}" %>
+<% @hide_footer_frames = true %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center borderless unpad flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half", data: { turbo_action: "replace" } do |form| %>
+    <%= search_query_field_tag @search %>
+    <%= form.button name: nil, class: "btn", title: "Search" do %>
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search</span>
+    <% end %>
+  <% end %>
+
+  <% unless @search.blank? %>
+    <div class="search__results flex flex-column gap-half" id="search_results">
+      <% if @page.records.any? %>
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+        <% end %>
+      <% else %>
+        <div class="blank-slate center">No cards match “<%= @search.query %>”</div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
