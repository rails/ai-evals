+module SearchesHelper
+  def search_query_field_tag(search)
+    search_field_tag :q, search.query,
+      placeholder: "Search cards by title, description, or comments…",
+      class: "input search__field",
+      autofocus: true,
+      autocorrect: "off",
+      autocomplete: "off",
+      aria: { label: "Search cards" },
+      data: { "1p-ignore": "true" }
+  end
+
+  def highlight_search_terms(text, search)
+    safe_join text.to_s.split(search.pattern).map.with_index { |segment, index| index.odd? ? tag.mark(segment) : segment }
+  end
+
+  def search_excerpt(text, search, radius: 80)
+    highlight_search_terms excerpt(text, search.pattern, radius: radius), search
+  end
+end
