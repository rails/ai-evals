diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..77fda2f
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,141 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Drag cards between the columns of a board. A dropped card moves right away and the change is saved
+// in the background. Columns keep their own order (golden cards first, then the latest), so a card
+// lands where the server will render it and nothing shifts once the save comes back.
+export default class extends Controller {
+  static targets = [ "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem = null
+  #hoveredContainer = null
+
+  disconnect() {
+    this.#reset()
+  }
+
+  start(event) {
+    const item = this.#itemFor(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+    this.#useAsDragImage(item, event)
+    this.#dimDraggedItem()
+  }
+
+  hover(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#dropTargetFor(event)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  async drop(event) {
+    const item = this.#draggedItem
+    const container = this.#dropTargetFor(event)
+    if (!item || !container) return
+
+    event.preventDefault()
+    this.#reset()
+
+    const origin = { parent: item.parentNode, nextSibling: item.nextSibling }
+    this.#place(item, container)
+
+    try {
+      const response = await this.#save(item, container)
+      if (!response.ok) this.#restore(item, origin)
+    } catch {
+      this.#restore(item, origin)
+    }
+  }
+
+  end() {
+    this.#reset()
+  }
+
+  // Private
+
+  #itemFor(target) {
+    return target instanceof Element ? target.closest("[draggable=true]") : null
+  }
+
+  // Cards can only move between columns, so the column they came from isn't a drop target
+  #dropTargetFor(event) {
+    const container = this.containerTargets.find(container => container.contains(event.target))
+    return container?.contains(this.#draggedItem) ? null : container
+  }
+
+  // Drag the whole card even when the drag started on an image inside it
+  #useAsDragImage(item, { dataTransfer, clientX, clientY }) {
+    const { left, top } = item.getBoundingClientRect()
+    dataTransfer.setDragImage(item, clientX - left, clientY - top)
+  }
+
+  // Let the browser take the drag image before dimming the card left behind
+  async #dimDraggedItem() {
+    const item = this.#draggedItem
+    await nextFrame()
+    if (this.#draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  #highlight(container) {
+    if (this.#hoveredContainer === container) return
+
+    this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+    container?.classList.add(this.hoverContainerClass)
+    this.#hoveredContainer = container
+  }
+
+  #reset() {
+    this.#highlight(null)
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+  }
+
+  #place(item, container) {
+    const cards = this.#cardsIn(container)
+    const golden = item.classList.contains("golden-effect")
+    const nextCard = golden ? cards[0] : cards.find(card => !card.classList.contains("golden-effect"))
+
+    if (nextCard) {
+      nextCard.before(item)
+    } else if (cards.length) {
+      cards.at(-1).after(item)
+    } else {
+      container.querySelector(".cards__list").append(item)
+    }
+  }
+
+  #cardsIn(container) {
+    return Array.from(container.querySelectorAll(".cards__list [draggable=true]"))
+  }
+
+  #restore(item, { parent, nextSibling }) {
+    parent.insertBefore(item, nextSibling?.parentNode === parent ? nextSibling : null)
+  }
+
+  #save(card, container) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = card.dataset
+    const options = { responseKind: "turbo-stream" }
+
+    switch (container.dataset.dropDestination) {
+      case "column":
+        return post(cardTriageUrl, { ...options, query: { column_id: container.dataset.columnId } })
+      case "stream":
+        return destroy(cardTriageUrl, options)
+      case "not_now":
+        return post(cardNotNowUrl, options)
+      case "closed":
+        return post(cardClosureUrl, options)
+    }
+  }
+}
