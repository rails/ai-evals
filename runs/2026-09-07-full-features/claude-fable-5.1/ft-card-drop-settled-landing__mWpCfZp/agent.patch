+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card from Maybe into a column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    within_column("maybe") { assert_selector card_selector(card) }
+
+    drag card, to: column
+    assert_card_moved card, into: dom_id(column)
+
+    assert_equal column, card.reload.column
+    within_column(dom_id(column)) { assert_selector ".cards__expander-count", text: "2" }
+    within_column("maybe") { assert_selector ".cards__expander-count", text: "0", visible: :all }
+  end
+
+  test "dragging a card from a column to Not Now" do
+    card = cards(:text)
+
+    visit_board
+    expand_column dom_id(card.column)
+
+    drag card, to: "not-now"
+    assert_card_moved card, into: "not-now"
+
+    assert card.reload.postponed?
+    within_column("not-now") { assert_selector ".cards__expander-count", text: "1" }
+  end
+
+  test "dragging a card from a column to Done" do
+    card = cards(:text)
+
+    visit_board
+    expand_column dom_id(card.column)
+
+    drag card, to: "closed-cards"
+    assert_card_moved card, into: "closed-cards"
+
+    assert card.reload.closed?
+    within_column("closed-cards") { assert_selector ".cards__expander-count", text: "2" }
+  end
+
+  test "dragging a closed card back into a column reopens it" do
+    card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    visit_board
+    expand_column "closed-cards"
+
+    drag card, to: column
+    assert_card_moved card, into: dom_id(column)
+
+    assert card.reload.open?
+    assert_equal column, card.column
+  end
+
+  test "dragging a card back to Maybe sends it back to triage" do
+    card = cards(:text)
+
+    visit_board
+    expand_column dom_id(card.column)
+
+    drag card, to: "maybe"
+    assert_card_moved card, into: "maybe"
+
+    assert card.reload.awaiting_triage?
+  end
+
+  test "a dropped card moves before the save completes and stays put afterwards" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    delay_requests_by 2.seconds
+
+    drag card, to: column
+    assert_card_moved card, into: dom_id(column)
+    mark_element card_selector(card)
+    assert card.reload.awaiting_triage?, "The move should not wait on the save"
+
+    assert_equal column, wait_until { card.reload.column }
+    within_column(dom_id(column)) { assert_selector ".cards__expander-count", text: "2" }
+    assert_no_selector "turbo-frame[busy]", visible: :all, wait: 10
+    assert_marked_element card_selector(card)
+  end
+
+  test "a card goes back where it came from when the save fails" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    visit_board
+    fail_requests
+
+    drag card, to: column
+
+    within_column("maybe") { assert_selector card_selector(card) }
+    within_board { assert_selector card_selector(card), count: 1, visible: :all }
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dropping a card on its own column leaves it alone" do
+    card = cards(:text)
+    column = card.column
+
+    visit_board
+    expand_column dom_id(column)
+
+    drag card, to: column
+    within_column(dom_id(column)) { assert_selector card_selector(card) }
+
+    assert_equal column, card.reload.column
+  end
+
+  test "golden cards stay on top of the column a card is dropped into" do
+    card = cards(:buy_domain)
+    golden_card = cards(:logo)
+    column = golden_card.column
+
+    assert golden_card.golden?
+
+    visit_board
+    within_column(dom_id(column)) { assert_selector card_selector(golden_card), visible: :all }
+
+    drag card, to: column
+    assert_card_moved card, into: dom_id(column)
+
+    within_column(dom_id(column)) do
+      assert_equal [ dom_id(golden_card, :article), dom_id(card, :article) ], find_all(".card", minimum: 2, visible: :all).first(2).map { |element| element[:id] }
+    end
+  end
+
+  private
+    def visit_board
+      visit board_url(@board)
+      assert_selector "[data-controller~='drag-and-drop']"
+      assert_no_selector "turbo-frame[busy]", visible: :all
+    end
+
+    def expand_column(column_id)
+      within_column(column_id) { find(".cards__expander").click }
+      assert_selector "##{column_id}.is-expanded"
+    end
+
+    def drag(card, to:)
+      target = to.is_a?(Column) ? dom_id(to) : to
+      within_board { find(card_selector(card)).drag_to find("##{target}"), html5: true }
+    end
+
+    def assert_card_moved(card, into:)
+      within_column(into) { assert_selector card_selector(card), visible: :all }
+
+      within_board do
+        assert_selector card_selector(card), count: 1, visible: :all
+        assert_no_selector "#{card_selector(card)}.drag-and-drop__dragged-item", visible: :all
+        assert_no_selector ".drag-and-drop__hover-container"
+      end
+    end
+
+    def delay_requests_by(duration)
+      page.execute_script <<~JS, duration.in_milliseconds
+        const fetch = window.fetch
+        window.fetch = async (...args) => { await new Promise(resolve => setTimeout(resolve, arguments[0])); return fetch(...args) }
+      JS
+    end
+
+    def fail_requests
+      page.execute_script "window.fetch = async () => new Response('', { status: 500 })"
+    end
+
+    def wait_until(timeout: Capybara.default_max_wait_time * 2)
+      deadline = Time.current + timeout
+      loop do
+        value = yield
+        return value if value || Time.current > deadline
+        sleep 0.1
+      end
+    end
+
+    # Marks the DOM node so we can tell whether the card was left alone or replaced by the save
+    def mark_element(selector)
+      page.execute_script "document.querySelector(arguments[0]).marked = true", selector
+    end
+
+    def assert_marked_element(selector)
+      assert page.evaluate_script("document.querySelector(arguments[0]).marked", selector), "Expected #{selector} to be the same element"
+    end
+
+    def within_board(&block)
+      within ".card-columns", &block
+    end
+
+    def within_column(column_id, &block)
+      within_board { within "##{column_id}", &block }
+    end
+
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+end
