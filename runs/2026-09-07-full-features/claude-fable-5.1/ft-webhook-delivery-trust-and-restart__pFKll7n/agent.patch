diff --git a/app/models/event/relaying.rb b/app/models/event/relaying.rb
new file mode 100644
index 0000000..d68220c
--- /dev/null
+++ b/app/models/event/relaying.rb
@@ -0,0 +1,25 @@
+# Relays events to the board's webhooks subscribed to them, one delivery per webhook.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :webhook_deliveries, class_name: "Webhook::Delivery", dependent: :delete_all
+
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    subscribed_webhooks.each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+
+  private
+    def subscribed_webhooks
+      board.webhooks.active.select { it.subscribed_to?(action) }
+    end
+end
