+++ b/test/models/webhook/payload_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:logo_published)
+    @board = @event.board
+  end
+
+  test "generic receivers get the event as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+    json = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal @event.id, json["id"]
+    assert_equal "card_published", json["action"]
+    assert_equal cards(:logo).id, json.dig("eventable", "id")
+    assert_equal cards(:logo).title, json.dig("eventable", "title")
+    assert_equal @board.id, json.dig("board", "id")
+    assert_equal users(:david).id, json.dig("creator", "id")
+    assert_match %r{\Ahttp://example\.com#{@board.account.slug}/cards/#{cards(:logo).number}\z}, json.dig("eventable", "url")
+  end
+
+  test "comments are included in the JSON" do
+    event = events(:layout_commented)
+    json = JSON.parse(Webhook::Payload.new(webhooks(:active), event).body)
+
+    assert_equal "comment_created", json["action"]
+    assert_equal event.eventable.id, json.dig("eventable", "id")
+    assert_equal event.eventable.body.to_plain_text, json.dig("eventable", "body", "plain_text")
+  end
+
+  test "slack receives a text message" do
+    webhook = Webhook.new board: @board, url: "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    payload = Webhook::Payload.new(webhook, @event)
+    json = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal %w[ text ], json.keys
+    assert_match %(David added "The logo isn't big enough"), json["text"]
+    assert_match %r{<http://example\.com/\d+/cards/#{cards(:logo).number}\|↗︎>}, json["text"]
+  end
+
+  test "campfire receives an HTML message" do
+    webhook = Webhook.new board: @board, url: "https://campfire.example.com/rooms/1/2-bot-key/messages"
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_match %r{David added &quot;The logo isn&#39;t big enough&quot;}, payload.body
+    assert_match %r{<a href="http://example\.com/\d+/cards/#{cards(:logo).number}">↗︎</a>}, payload.body
+  end
+
+  test "basecamp campfire receives the HTML message as content" do
+    webhook = Webhook.new board: @board, url: "https://3.basecamp.com/999/integrations/token/buckets/1/chats/2/lines"
+    payload = Webhook::Payload.new(webhook, @event)
+    json = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal %w[ content ], json.keys
+    assert_match %r{David added &quot;The logo isn&#39;t big enough&quot;}, json["content"]
+    assert_match %r{<a href="http://example\.com/\d+/cards/#{cards(:logo).number}">↗︎</a>}, json["content"]
+  end
+end
