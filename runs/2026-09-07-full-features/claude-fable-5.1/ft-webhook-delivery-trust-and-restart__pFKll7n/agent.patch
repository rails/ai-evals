+    elsewhere = boards(:private).webhooks.create! name: "Elsewhere", url: "https://elsewhere.example.com/hook", subscribed_actions: %w[ card_published ]
+
+    event = @board.events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+
+    assert_difference -> { Webhook::Delivery.count }, +2 do
+      event.relay_now
+    end
+
+    assert_equal [ @webhook, other ].sort, event.webhook_deliveries.map(&:webhook).sort
+    assert_empty unsubscribed.deliveries
+    assert_empty inactive.deliveries
+    assert_empty elsewhere.deliveries
+  end
+
+  test "relaying enqueues the deliveries" do
+    event = @board.events.create! action: "card_closed", creator: users(:david), eventable: cards(:logo)
+
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      event.relay_now
+    end
+  end
+
+  test "events nobody subscribed to are not delivered" do
+    event = @board.events.create! action: "card_title_changed", creator: users(:david), eventable: cards(:logo)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "an event makes it to the receiver" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      @board.events.create! action: "card_published", creator: users(:david), eventable: cards(:logo)
+    end
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @webhook.deliveries.ordered.first.succeeded?
+  end
+end
