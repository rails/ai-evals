@@ -29,4 +64,51 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock { pending? && in_progress! }
+    end
+
+    def send_request
+      payload = Webhook::Payload.new(webhook, event)
+      headers = headers_for(payload)
+      http_response = post(payload, headers)
+
+      update! state: :completed, request: { headers: headers },
+        response: { code: http_response.code.to_i, headers: http_response.each_header.to_h }
+    rescue *UNREACHABLE_ERRORS => error
+      update! state: :errored, request: { headers: headers },
+        response: { error: "destination_unreachable", message: error.message }
+    rescue => error
+      update! state: :errored, request: { headers: headers },
+        response: { error: "unexpected_error", message: error.message }
+      raise
+    end
+
+    def headers_for(payload)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => payload.content_type,
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => signature_for(payload)
+      }
+    end
+
+    def signature_for(payload)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload.body)
+    end
+
+    def post(payload, headers)
+      uri = URI.parse(webhook.url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https",
+          open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT, write_timeout: WRITE_TIMEOUT) do |http|
+        http.request Net::HTTP::Post.new(uri, headers).tap { it.body = payload.body }
+      end
+    end
+
+    def track_delinquency
+      webhook.delinquency_tracker.track(self)
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..9515b05
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,90 @@
+# What gets POSTed to a webhook's URL for a given event. Generic receivers get the
+# event as JSON; chat integrations get a message they can display directly.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  delegate :account, to: :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||= build_body
+  end
+
+  private
+    def build_body
+      case
+      when webhook.for_slack?    then { text: slack_text }.to_json
+      when webhook.for_campfire? then html
+      when webhook.for_basecamp? then { content: html }.to_json
+      else json
+      end
+    end
+
+    def slack_text
+      "#{slack_escape(plain_text)} <#{eventable_url}|↗︎>"
+    end
+
+    def slack_escape(text)
+      text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
+    end
+
+    def plain_text
+      CGI.unescapeHTML event.description_for(nil).to_plain_text
+    end
+
+    def eventable_url
+      url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def html
+      render formats: [ :html ]
+    end
+
+    def json
+      render formats: [ :json ]
+    end
+
+    def render(formats:)
+      renderer.render template: "webhooks/event", formats: formats, layout: false, assigns: { event: event }
+    end
+
+    def renderer
+      ApplicationController.renderer.new renderer_env
+    end
+
+    def renderer_env
+      { http_host: http_host, https: https?, script_name: account.slug }.compact
+    end
+
+    def http_host
+      if host = url_options[:host]
+        [ host, url_options[:port] ].compact.join(":")
+      end
+    end
+
+    def https?
+      url_options[:protocol].to_s.delete_suffix("://") == "https"
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      base_options.merge(script_name: account.slug)
+    end
+
+    def url_helpers
+      Rails.application.routes.url_helpers
+    end
+end
