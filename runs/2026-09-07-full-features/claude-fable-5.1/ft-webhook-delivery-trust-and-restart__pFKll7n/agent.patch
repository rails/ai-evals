@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "created on demand for webhooks that predate tracking" do
+    @tracker.destroy!
+
+    assert_difference -> { Webhook::DelinquencyTracker.count }, +1 do
+      assert @webhook.reload.delinquency_tracker.persisted?
+    end
+  end
+
+  test "record_failure counts consecutive failures from the first one" do
+    freeze_time do
+      @tracker.record_failure
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+
+    travel 10.minutes do
+      @tracker.record_failure
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 10.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "reset forgets past failures" do
+    @tracker.update! consecutive_failures_count: 5, first_failure_at: 30.minutes.ago
+
+    @tracker.reset
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "track resets on success and counts on failure" do
+    @tracker.track webhook_deliveries(:unsuccessfully_completed)
+    @tracker.track webhook_deliveries(:errored)
+    assert_equal 2, @tracker.consecutive_failures_count
+
+    @tracker.track webhook_deliveries(:successfully_completed)
+    assert_equal 0, @tracker.consecutive_failures_count
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    9.times { @tracker.record_failure }
+    assert @webhook.reload.active?
+
+    travel 1.hour + 1.minute do
+      assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+        @tracker.record_failure
+      end
+
+      assert @tracker.delinquent?
+    end
+  end
+
+  test "a burst of failures within the hour doesn't deactivate the webhook" do
+    freeze_time do
+      12.times { @tracker.record_failure }
+    end
+
+    assert_not @tracker.delinquent?
+    assert @webhook.reload.active?
+  end
+
+  test "an hour of failures below the threshold doesn't deactivate the webhook" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    assert_not @tracker.delinquent?
+    assert @webhook.reload.active?
+  end
+
+  test "a success in between starts the count over" do
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+
+    @tracker.reset
+    @tracker.record_failure
+
+    assert_not @tracker.delinquent?
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating the webhook gives it a fresh start" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.active?
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+end
