+  scope :stale, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Each delivery makes exactly one attempt: the first caller to claim a pending
+  # delivery sends it, anybody else finds it already taken and leaves it alone.
+  def deliver
