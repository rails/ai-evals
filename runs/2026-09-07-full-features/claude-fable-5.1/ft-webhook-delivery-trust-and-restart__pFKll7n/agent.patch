diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..a37c86f
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,44 @@
+# Keeps count of a webhook's consecutive failed deliveries. Once a webhook has been
+# failing for long enough (at least FAILURE_THRESHOLD deliveries in a row, spanning at
+# least FAILURE_WINDOW), it's considered delinquent and gets deactivated. Reactivating
+# the webhook gives it a fresh start.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    if delivery.succeeded?
+      reset
+    else
+      record_failure
+    end
+  end
+
+  def record_failure
+    with_lock do
+      update! consecutive_failures_count: consecutive_failures_count + 1, first_failure_at: first_failure_at || Time.current
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    failing_repeatedly? && failing_for_too_long?
+  end
+
+  private
+    def failing_repeatedly?
+      consecutive_failures_count >= FAILURE_THRESHOLD
+    end
+
+    def failing_for_too_long?
+      first_failure_at.present? && first_failure_at <= FAILURE_WINDOW.ago
+    end
+end
