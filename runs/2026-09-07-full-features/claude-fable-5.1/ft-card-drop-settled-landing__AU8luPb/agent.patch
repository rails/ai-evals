diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..1a08a08
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,139 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+import { Turbo } from "@hotwired/turbo-rails"
+import { nextEventLoopTick } from "helpers/timing_helpers"
+
+// Moves items between containers by dragging them around. Containers keep their own order,
+// so a dropped item goes where the server will list it: at the top, below any sticky items.
+// The item is placed the moment it's dropped, then the move is saved in the background.
+//
+// Each container declares where to save a drop with `data-drop-url`, using a `:card_id`
+// placeholder for the item's `data-card-id`, plus an optional `data-drop-method`.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer", "stickyItem" ]
+  static targets = [ "container", "item", "list" ]
+
+  #draggedItem = null
+  #hoveredContainer = null
+
+  async dragStart(event) {
+    const item = this.#itemFrom(event)
+    if (!item) return
+
+    this.#draggedItem = item
+    this.#prepareTransfer(event, item)
+
+    // Let the browser capture the drag image before dimming the item
+    await nextEventLoopTick()
+    if (this.#draggedItem === item) item.classList.add(this.draggedItemClass)
+  }
+
+  dragEnd() {
+    this.#finishDragging()
+  }
+
+  dragOver(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#containerFrom(event)
+    this.#hover(this.#isDroppable(container) ? container : null)
+
+    if (this.#hoveredContainer) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!this.#isWithinElement(event)) {
+      this.#hover(null)
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const container = this.#containerFrom(event)
+
+    if (item && this.#isDroppable(container)) {
+      event.preventDefault()
+      this.#finishDragging()
+      this.#place(item, container)
+      this.#save(item, container)
+    }
+  }
+
+  // Private
+
+  #itemFrom(event) {
+    return event.target.closest?.(this.#selectorFor("item"))
+  }
+
+  #containerFrom(event) {
+    return event.target.closest?.(this.#selectorFor("container"))
+  }
+
+  #selectorFor(targetName) {
+    return `[data-${this.identifier}-target~="${targetName}"]`
+  }
+
+  #prepareTransfer(event, item) {
+    const { left, top } = item.getBoundingClientRect()
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id) // Firefox won't start a drag without data
+    event.dataTransfer.setDragImage(item, event.clientX - left, event.clientY - top)
+  }
+
+  #isDroppable(container) {
+    return container?.dataset.dropUrl && !container.contains(this.#draggedItem)
+  }
+
+  #isWithinElement({ clientX, clientY }) {
+    const { left, right, top, bottom } = this.element.getBoundingClientRect()
+    return clientX >= left && clientX <= right && clientY >= top && clientY <= bottom
+  }
+
+  #hover(container) {
+    if (container === this.#hoveredContainer) return
+
+    this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.#hoveredContainer = container
+    this.#hoveredContainer?.classList.add(this.hoverContainerClass)
+  }
+
+  #finishDragging() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#hover(null)
+  }
+
+  #place(item, container) {
+    const list = this.listTargets.find(list => container.contains(list))
+    if (!list) return
+
+    const items = this.itemTargets.filter(other => list.contains(other))
+    const nextItem = this.#isSticky(item) ? items[0] : items.find(other => !this.#isSticky(other))
+
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length > 0) {
+      items.at(-1).after(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #isSticky(item) {
+    return this.hasStickyItemClass && item.classList.contains(this.stickyItemClass)
+  }
+
+  async #save(item, container) {
+    const boardUrl = document.baseURI
+    const url = container.dataset.dropUrl.replace(":card_id", item.dataset.cardId)
+    const request = new FetchRequest(container.dataset.dropMethod || "post", url, { responseKind: "json" })
+    await request.perform()
+
+    // The board already shows the move, so catch up on everything else it changed (card details,
+    // counts) with a refresh. Morphing leaves the dropped item right where it landed.
+    Turbo.session.refresh(boardUrl)
+  }
+}
