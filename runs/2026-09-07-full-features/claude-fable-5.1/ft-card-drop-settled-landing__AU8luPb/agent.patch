diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..9e3291f
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,115 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "dragging a card into a column triages it there" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    drag card, to: dom_id(column)
+
+    assert_selector "##{dom_id(column)} #{card_selector(card)}", visible: :all
+    assert_no_selector "#maybe #{card_selector(card)}"
+
+    assert_selector "##{dom_id(column)} #{card_selector(card)} .card__column-name--current", text: column.name, visible: :all
+    assert_equal column, card.reload.column
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:buy_domain)
+
+    drag card, to: "closed-cards"
+
+    assert_selector "#closed-cards #{card_selector(card)}", visible: :all
+    assert_no_selector "#maybe #{card_selector(card)}"
+
+    assert_selector "#closed-cards #{card_selector(card)}:not(.card--active)", visible: :all
+    assert card.reload.closed?
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:buy_domain)
+
+    drag card, to: "not-now"
+
+    assert_selector "#not-now #{card_selector(card)}", visible: :all
+    assert_no_selector "#maybe #{card_selector(card)}"
+
+    assert_selector "#not-now #{card_selector(card)}.card--postponed", visible: :all
+    assert card.reload.postponed?
+  end
+
+  test "dragging a card to Maybe sends it back to triage" do
+    card = cards(:logo)
+    expand_column dom_id(card.column)
+
+    drag card, to: "maybe"
+
+    assert_selector "#maybe #{card_selector(card)}"
+    assert_no_selector "##{dom_id(card.column)} #{card_selector(card)}", visible: :all
+
+    assert_no_selector "#maybe #{card_selector(card)} .card__column-name--current"
+    assert_nil card.reload.column
+  end
+
+  test "dropped cards land at the top and stay there once saved" do
+    card = cards(:logo)
+    expand_column dom_id(card.column)
+
+    drag card, to: "maybe"
+    assert_equal card.title, first("#maybe .card h3").text
+
+    assert_no_selector "#maybe #{card_selector(card)} .card__column-name--current"
+    assert_equal card.title, first("#maybe .card h3").text
+  end
+
+  test "dragging within the same column changes nothing" do
+    card = cards(:buy_domain)
+
+    drag card, to: "maybe"
+
+    assert_selector "#maybe #{card_selector(card)}"
+    assert card.reload.awaiting_triage?
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    card = cards(:buy_domain)
+
+    page.execute_script(<<~JS, find(card_selector(card)), find("#closed-cards"))
+      const [ card, column ] = arguments
+      const dataTransfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+    JS
+
+    assert_selector "#closed-cards.drag-and-drop__hover-container"
+    assert_selector "#{card_selector(card)}.drag-and-drop__dragged-item"
+
+    page.execute_script(<<~JS, find(card_selector(card)))
+      arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true }))
+    JS
+
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".drag-and-drop__dragged-item"
+  end
+
+  private
+    def drag(card, to:)
+      find(card_selector(card)).drag_to(find("##{to}"))
+    end
+
+    def card_selector(card)
+      "##{dom_id(card, :article)}"
+    end
+
+    def expand_column(id)
+      find("##{id} .cards__expander").click
+      assert_selector "##{id}.is-expanded"
+    end
+end
