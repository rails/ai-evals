diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..6a4d9cb
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "an admin can export the account" do
+    sign_in_as :kevin
+
+    assert_difference -> { Account::Export.count }, 1 do
+      post account_exports_url
+    end
+
+    assert_redirected_to account_settings_url
+    assert_match(/email/, flash[:notice])
+
+    export = Account::Export.last
+    assert_equal accounts(:"37s"), export.account
+    assert_equal users(:kevin), export.user
+    assert_enqueued_jobs 1, only: Export::ProcessJob
+  end
+
+  test "members can't export the account" do
+    sign_in_as :david
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "exporting the account over the API" do
+    sign_in_as :kevin
+
+    assert_difference -> { Account::Export.count }, 1 do
+      post account_exports_url, as: :json
+    end
+
+    assert_response :accepted
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
new file mode 100644
index 0000000..671047e
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "new" do
+    get new_account_import_url
+
+    assert_response :success
+    assert_select "form[action=?]", account_imports_path
+    assert_select "input[type=file][name=?]", "account_import[file]"
+  end
+
+  test "create" do
+    assert_difference -> { Account::Import.count }, 1 do
+      post account_imports_url, params: { account_import: { file: fixture_file_upload("moon.jpg", "application/zip") } }
+    end
+
+    assert_redirected_to account_settings_url
+    assert_match(/email/, flash[:notice])
+
+    import = Account::Import.last
+    assert_equal users(:david), import.user
+    assert_equal accounts(:"37s"), import.account
+    assert import.file.attached?
+    assert_enqueued_jobs 1, only: Account::Import::ProcessJob
+  end
+
+  test "create with a directly uploaded file" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("not really a zip"), filename: "export.zip", content_type: "application/zip")
+
+    post account_imports_url, params: { account_import: { file: blob.signed_id } }
+
+    assert_redirected_to account_settings_url
+    assert_equal blob, Account::Import.last.file.blob
+  end
+
+  test "create without a file" do
+    assert_no_difference -> { Account::Import.count } do
+      post account_imports_url, params: { account_import: { file: "" } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
