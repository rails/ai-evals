diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..e162209
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,65 @@
+# Filters keep their boards, tags and people in join tables without an account, so those
+# travel embedded in the filter. Their digest is derived from ids and is recomputed once
+# those are translated.
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = %i[ tags boards assignees creators closers ].freeze
+  ID_FIELDS = %w[ card_ids column_ids ].freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def export_record(record)
+      super.merge(resource_ids_names.index_with { |name| record.public_send(name) })
+    end
+
+    def import_attributes(attributes)
+      super.tap do |attributes|
+        attributes["fields"] = translate_fields(attributes["fields"].to_h)
+        attributes["params_digest"] = Filter.digest_params(params_from(attributes))
+      end
+    end
+
+    def translate_fields(fields)
+      fields.merge(fields.slice(*ID_FIELDS).transform_values { |list| Array(list).map { |id| ids.translate(id) } })
+    end
+
+    def params_from(attributes)
+      attributes["fields"].slice(*%w[ indexed_by sorted_by creation closure assignment_status terms card_ids ])
+        .merge(attributes.slice(*resource_ids_names))
+    end
+
+    def import_records(records)
+      Filter.insert_all!(records.map { |attributes| attributes.except(*resource_ids_names) })
+
+      RESOURCES.each do |resource|
+        import_resource(resource, records)
+      end
+    end
+
+    def import_resource(resource, records)
+      join_model = join_model_for(resource)
+      foreign_key = join_model.right_reflection.foreign_key
+
+      rows = records.flat_map do |attributes|
+        attributes[ids_name_for(resource)].map { |id| { "filter_id" => attributes["id"], foreign_key => id } }
+      end
+
+      join_model.insert_all!(rows) if rows.any?
+    end
+
+    # Rails keeps the join models of has_and_belongs_to_many private, but they are
+    # still the right tool for inserting the join rows in bulk.
+    def join_model_for(resource)
+      Filter.const_get("HABTM_#{resource.to_s.camelize}")
+    end
+
+    def resource_ids_names
+      RESOURCES.map { |resource| ids_name_for(resource) }
+    end
+
+    def ids_name_for(resource)
+      "#{resource.to_s.singularize}_ids"
+    end
+end
diff --git a/app/models/account/data_transfer/id_translator.rb b/app/models/account/data_transfer/id_translator.rb
new file mode 100644
index 0000000..dcd821d
--- /dev/null
+++ b/app/models/account/data_transfer/id_translator.rb
@@ -0,0 +1,28 @@
+# Derives the ids for an imported account from the exported ones, so the same archive
+# can be imported next to its source account (or several times) without collisions.
+#
+# The translation is a pure function of the exported id and a per-import salt, which
+# means every foreign key, polymorphic reference or id buried in a JSON column can be
+# translated independently without keeping a lookup table for millions of records.
+# The UUIDv7 time prefix is kept, so records keep sorting the way they did.
+class Account::DataTransfer::IdTranslator
+  TIME_PREFIX_LENGTH = 16 # hex chars: 48-bit timestamp, version nibble and 12 bits of sub-millisecond ordering
+
+  def initialize(salt)
+    @salt = salt.to_s
+  end
+
+  def translate(id)
+    if id.present?
+      hex = ActiveRecord::Type::Uuid.base36_to_hex(id)
+      ActiveRecord::Type::Uuid.hex_to_base36(hex.first(TIME_PREFIX_LENGTH) + random_half_for(id))
+    end
+  end
+
+  private
+    def random_half_for(id)
+      digest = Digest::SHA256.hexdigest("#{@salt}/#{id}").first(32 - TIME_PREFIX_LENGTH)
+      variant = (digest.first.hex & 0x3 | 0x8).to_s(16) # Keep the RFC 4122 variant bits
+      variant + digest.from(1)
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..e71cbc4
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,86 @@
+# Turns an account export into a brand-new account owned by the person importing it.
+# Every id is translated on the way in, so the archive can be imported anywhere, including
+# next to the account it came from. A failed import destroys whatever it had created.
+class Account::DataTransfer::Importer
+  attr_reader :zip, :ids, :owner
+
+  def initialize(zip, salt:, owner:)
+    @zip = zip
+    @ids = Account::DataTransfer::IdTranslator.new(salt)
+    @owner = owner
+  end
+
+  def import
+    verify_archive
+    import_records
+    verify_account
+
+    Current.with_account(account) do
+      grant_ownership
+      rebuild_derived_data
+    end
+
+    account
+  rescue => error
+    discard_account
+    raise error
+  end
+
+  private
+    def verify_archive
+      unless zip.exists?(Export::METADATA_PATH) && metadata["kind"] == Account::Export::KIND
+        raise Account::DataTransfer::InvalidArchive, "This file is not a Fizzy account export"
+      end
+    end
+
+    def metadata
+      @metadata ||= JSON.parse(zip.read(Export::METADATA_PATH))
+    end
+
+    def import_records
+      Account::DataTransfer::Manifest.new.each_record_set do |record_set|
+        record_set.import_from(zip, ids)
+      end
+    end
+
+    def verify_account
+      raise Account::DataTransfer::InvalidArchive, "The export doesn't contain an account" unless account
+    end
+
+    def account
+      @account ||= Account.find_by(id: ids.translate(metadata.dig("account", "id")))
+    end
+
+    def grant_ownership
+      user = account.users.create_with(name: owner.name, verified_at: Time.current).find_or_create_by!(identity: owner.identity)
+      user.update!(role: :owner, active: true)
+    end
+
+    def rebuild_derived_data
+      reindex_search
+      reconcile_storage
+    end
+
+    # Records are inserted without callbacks, so the search index is built afterwards
+    def reindex_search
+      account.cards.published.includes(:rich_text_description).find_each(&:reindex)
+      Comment.where(account: account).joins(:card).merge(Card.published).includes(:rich_text_body).find_each(&:reindex)
+    end
+
+    # Same for the storage ledger, which is rebuilt from the imported attachments
+    def reconcile_storage
+      account.reconcile_storage
+      account.boards.find_each(&:reconcile_storage)
+    end
+
+    def discard_account
+      if account
+        Current.with_account(account) do
+          account.incinerate
+          ActiveStorage::Blob.where(account_id: account.id).find_each(&:purge)
+        end
+      end
+    rescue => error
+      Rails.error.report(error, context: { account_id: account.id })
+    end
+end
