+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,53 @@
+class ZipFile::Reader
+  class MissingEntry < StandardError; end
+
+  # Bytes of compressed data to pull from the archive at a time while extracting an entry.
+  CHUNK_SIZE = 4.megabytes
+
+  def initialize(io)
+    @io = io
+    @file_reader = ZipKit::FileReader.new
+    @entries = @file_reader.read_zip_structure(io: io, read_local_headers: false).index_by(&:filename)
+  end
+
+  def entries
+    @entries.keys
+  end
+
+  def glob(pattern)
+    entries.select { |path| File.fnmatch(pattern, path) }.sort
+  end
+
+  def exists?(path)
+    @entries.key?(path)
+  end
+
+  def read(path)
+    open(path, &:read)
+  end
+
+  def each_line(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    open(path) do |io|
+      io.each_line { |line| yield line }
+    end
+  end
+
+  def open(path)
+    raise ArgumentError, "No block given" unless block_given?
+
+    yield EntryIO.new(entry_for(path), @io)
+  end
+
+  private
+    def entry_for(path)
+      entry = @entries.fetch(path) { raise MissingEntry, "#{path} is not in the archive" }
+
+      unless entry.known_offset?
+        entry.compressed_data_offset = @file_reader.get_compressed_data_offset(io: @io, local_file_header_offset: entry.local_file_header_offset)
+      end
+
+      entry
+    end
+end
diff --git a/app/models/zip_file/reader/blob_io.rb b/app/models/zip_file/reader/blob_io.rb
new file mode 100644
index 0000000..34dac12
--- /dev/null
+++ b/app/models/zip_file/reader/blob_io.rb
@@ -0,0 +1,58 @@
+# Just enough of an IO for ZipKit::FileReader, backed by ranged downloads from the
+# blob's storage service so the archive never has to be fetched as a whole. The small
+# consecutive reads done while parsing ZIP headers are served from a read-ahead buffer.
+class ZipFile::Reader::BlobIO
+  READ_AHEAD = 1.megabyte
+
+  attr_reader :blob
+
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+    @buffer = "".b
+    @buffer_start = 0
+  end
+
+  def size
+    blob.byte_size
+  end
+
+  def tell
+    @pos
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    raise ArgumentError, "Only IO::SEEK_SET is supported" unless whence == IO::SEEK_SET
+
+    @pos = offset.clamp(0, size)
+    0
+  end
+
+  def read(length = nil)
+    available = size - @pos
+    wanted = [ length || available, available ].min
+
+    if wanted.zero?
+      length&.positive? ? nil : ""
+    else
+      buffered_read(wanted).tap { |data| @pos += data.bytesize }
+    end
+  end
+
+  private
+    def buffered_read(length)
+      fill_buffer(length) unless buffered?(length)
+      @buffer.byteslice(@pos - @buffer_start, length)
+    end
+
+    def buffered?(length)
+      @pos >= @buffer_start && @pos + length <= @buffer_start + @buffer.bytesize
+    end
+
+    def fill_buffer(length)
+      last = [ @pos + [ length, READ_AHEAD ].max, size ].min - 1
+
+      @buffer_start = @pos
+      @buffer = blob.download_chunk(@pos..last)
+    end
+end
diff --git a/app/models/zip_file/reader/entry_io.rb b/app/models/zip_file/reader/entry_io.rb
new file mode 100644
index 0000000..e9814f7
--- /dev/null
+++ b/app/models/zip_file/reader/entry_io.rb
@@ -0,0 +1,73 @@
+# Read-only, streaming IO over a single archive entry. Decompresses on the fly and never
+# holds more than a chunk of the entry in memory, which is what lets us hand
+# multi-gigabyte files straight to Active Storage for upload.
+class ZipFile::Reader::EntryIO
+  attr_reader :entry
+
+  def initialize(entry, io)
+    @entry = entry
+    @io = io
+    rewind
+  end
+
+  def size
+    entry.uncompressed_size
+  end
+
+  def read(length = nil, outbuf = nil)
+    if length
+      fill until finished? || @pending.bytesize >= length
+    else
+      fill until finished?
+    end
+
+    data = take(length || @pending.bytesize)
+
+    if data.empty? && length&.positive?
+      nil
+    else
+      outbuf ? outbuf.replace(data) : data
+    end
+  end
+
+  def each_line
+    raise ArgumentError, "No block given" unless block_given?
+
+    until eof?
+      fill until finished? || @pending.include?("\n")
+
+      while (newline = @pending.index("\n"))
+        yield take(newline + 1).chomp.force_encoding(Encoding::UTF_8)
+      end
+
+      yield take(@pending.bytesize).force_encoding(Encoding::UTF_8) if finished? && @pending.present?
+    end
+  end
+
+  def eof?
+    finished? && @pending.empty?
+  end
+
+  def rewind
+    @extractor = entry.extractor_from(@io)
+    @pending = "".b
+    0
+  end
+
+  private
+    def finished?
+      @extractor.eof?
+    end
+
+    def fill
+      if chunk = @extractor.extract(ZipFile::Reader::CHUNK_SIZE)
+        @pending << chunk
+      end
+    end
+
+    def take(length)
+      @pending.byteslice(0, length).tap do
+        @pending = @pending.byteslice(length..) || "".b
+      end
+    end
+end
