@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    Current.session = sessions(:kevin)
+    users(:kevin).avatar.attach io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png"
+  end
+
+  test "includes every published card in the account, not just the accessible ones" do
+    private_card = boards(:private).cards.create!(title: "Secret", status: :published, creator: users(:kevin))
+    export = Account::Export.create!(user: users(:david)).tap(&:process_now)
+
+    ZipFile.open(export.file) do |zip|
+      assert_equal "account", JSON.parse(zip.read("export.json"))["kind"]
+      assert zip.exists?("cards/#{cards(:logo).number}/card.json")
+      assert zip.exists?("cards/#{private_card.number}/card.json")
+    end
+  end
+
+  test "includes the account's records and files for importing" do
+    export = Account::Export.create!.tap(&:process_now)
+
+    ZipFile.open(export.file) do |zip|
+      %w[ accounts users boards columns cards comments action_text_rich_texts active_storage_blobs active_storage_attachments ].each do |table|
+        assert zip.exists?("data/#{table}.jsonl"), "Expected data/#{table}.jsonl in the archive"
+      end
+
+      users = zip.read("data/users.jsonl").lines.map { |line| JSON.parse(line) }
+      assert_equal @account.users.count, users.size
+      assert_includes users.map { |user| user["email_address"] }, "kevin@37signals.com"
+      assert_not users.first.key?("identity_id")
+
+      assert_equal 1, zip.read("data/accounts.jsonl").lines.size
+      assert_includes zip.glob("data/files/*"), "data/files/#{users(:kevin).avatar.blob.id}"
+      assert_equal users(:kevin).avatar.download, zip.read("data/files/#{users(:kevin).avatar.blob.id}")
+    end
+  end
+
+  test "leaves out other exports and imports" do
+    other = Account::Export.create!.tap(&:process_now)
+    export = Account::Export.create!.tap(&:process_now)
+
+    ZipFile.open(export.file) do |zip|
+      blobs = zip.read("data/active_storage_blobs.jsonl").lines.map { |line| JSON.parse(line) }
+      assert_not_includes blobs.map { |blob| blob["id"] }, other.file.blob.id
+      assert_not zip.exists?("data/files/#{other.file.blob.id}")
+    end
+  end
+
+  test "names the file after the account" do
+    export = Account::Export.create!
+
+    assert_equal "37signals-account-#{Date.current.iso8601}.zip", export.filename
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..97ba71d
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,213 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+
+    Current.session = sessions(:david)
+
+    @image = attach_image_to(@card)
+    @embed = attach_embed_to(@card)
+    @card.update!(description: "<p>Hi #{mention_html(users(:jz))} #{@card.description.body.to_html}</p>")
+    boards(:writebook).publish
+    @filter = users(:david).filters.create!(boards: [ boards(:writebook) ], tags: [ tags(:web) ], card_ids: [ @card.id ], sorted_by: "newest")
+    @export = export_account
+  end
+
+  test "importing an export creates a new account with everything in it" do
+    import = nil
+
+    assert_difference -> { Account.count }, 1 do
+      import = import_export
+    end
+
+    assert import.completed?, import.error_message
+    account = import.imported_account
+
+    assert_not_equal @account, account
+    assert_equal @account.name, account.name
+    assert_not_equal @account.external_account_id, account.external_account_id
+    assert account.join_code.present?
+
+    assert_equal @account.boards.pluck(:name).sort, account.boards.pluck(:name).sort
+    assert_equal @account.cards.pluck(:number, :title).sort, account.cards.pluck(:number, :title).sort
+    assert_equal @account.cards_count, account.cards_count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: account).count
+    assert_equal @account.users.map { |user| [ user.name, user.identity&.email_address ] }.sort,
+      account.users.map { |user| [ user.name, user.identity&.email_address ] }.sort
+    assert account.users.find_by!(name: "Kevin").admin?
+    assert account.users.find_by!(name: "System").system?
+    assert_equal @account.entropy.auto_postpone_period, account.entropy.auto_postpone_period
+  end
+
+  test "imported records get new ids that keep referring to each other" do
+    account = import_export.imported_account
+    card = account.cards.find_by!(number: @card.number)
+
+    assert_not_equal @card.id, card.id
+    assert_equal @card.created_at, card.created_at
+    assert_equal account, card.board.account
+    assert_equal users(:david).identity, card.creator.identity
+    assert_equal @card.column.name, card.column.name
+    assert_equal @card.comments.count, card.comments.count
+    assert_equal @card.comments.map { |comment| comment.creator.name }.sort, card.comments.map { |comment| comment.creator.name }.sort
+    assert_equal @card.events.count, card.events.count
+    assert_equal @card.reactions.count, card.reactions.count
+    assert_equal Event.where(account: @account).count, Event.where(account: account).count
+    assert_equal Notification.where(account: @account).count, Notification.where(account: account).count
+  end
+
+  test "files come along and are stored under new keys" do
+    account = import_export.imported_account
+    card = account.cards.find_by!(number: @card.number)
+
+    assert card.image.attached?
+    assert_not_equal @image.key, card.image.blob.key
+    assert_equal @image.checksum, card.image.blob.checksum
+    assert_equal @image.download, card.image.blob.download
+
+    embed = card.description.embeds.sole
+    assert_equal @embed.checksum, embed.blob.checksum
+    assert card.description.body.attachables.include?(embed.blob), "Rich text attachment should point at the imported blob"
+    assert card.description.body.attachables.any? { |attachable| attachable.is_a?(User) && attachable.account == account }, "Mentions should point at the imported user"
+  end
+
+  test "filters follow their creator with translated boards, tags and cards" do
+    account = import_export.imported_account
+    david = account.users.find_by!(identity: identities(:david))
+    filter = david.filters.detect { |filter| filter.card_ids.present? }
+
+    assert_equal [ account.boards.find_by!(name: "Writebook") ], filter.boards
+    assert_equal [ "web" ], filter.tags.pluck(:title)
+    assert_equal [ account.cards.find_by!(number: @card.number).id ], filter.card_ids
+    assert_equal "newest", filter.sorted_by
+    assert_equal filter, Filter.find_by_params(filter.as_params)
+  end
+
+  test "the same export can be imported more than once" do
+    first = import_export.imported_account
+    second = import_export.imported_account
+
+    assert_not_equal first, second
+    assert_equal first.cards.count, second.cards.count
+    assert_equal first.users.count, second.users.count
+    assert_not_equal first.cards.find_by!(number: @card.number).image.blob.key, second.cards.find_by!(number: @card.number).image.blob.key
+  end
+
+  test "published boards get new publication keys" do
+    account = import_export.imported_account
+
+    board = account.boards.find_by!(name: boards(:writebook).name)
+    assert board.published?
+    assert_not_equal boards(:writebook).publication.key, board.publication.key
+  end
+
+  test "the person importing becomes an owner of the new account" do
+    account = import_export(by: users(:mike)).imported_account
+
+    owner = account.users.find_by!(identity: identities(:mike))
+    assert owner.owner?
+    assert owner.verified?
+  end
+
+  test "an existing user importing their own account keeps a single user record and gets ownership" do
+    account = import_export(by: users(:david)).imported_account
+
+    assert_equal 1, account.users.where(identity: identities(:david)).count
+    assert account.users.find_by!(identity: identities(:david)).owner?
+  end
+
+  test "imported cards are searchable" do
+    account = import_export.imported_account
+
+    Current.with_account(account) do
+      user = account.users.find_by!(identity: identities(:david))
+      assert account.cards.mentioning("logo", user: user).exists?
+    end
+  end
+
+  test "sends an email when the import is done" do
+    import_export
+
+    assert_import_email_enqueued :completed
+  end
+
+  test "a failed import leaves nothing behind and reports why" do
+    Account::DataTransfer::ActiveStorage::FileRecordSet.any_instance.stubs(:import_from).raises("Disk full")
+    import = nil
+
+    assert_no_difference -> { Account.count }, -> { ActiveStorage::Blob.count } do
+      import = import_export
+    end
+
+    assert import.failed?
+    assert_equal "Disk full", import.error_message
+    assert_nil import.imported_account
+    assert_import_email_enqueued :failed
+  end
+
+  test "rejects files that aren't account exports" do
+    Current.with_account(@account) { Export.create!(user: users(:david)).process_now }
+    import = Account::Import.create!(account: @account, user: users(:david), file: Export.last.file.blob)
+
+    perform_enqueued_jobs only: Account::Import::ProcessJob
+
+    assert import.reload.failed?
+    assert_match(/not a Fizzy account export/, import.error_message)
+  end
+
+  test "rejects files that aren't zips" do
+    import = Account::Import.new(account: @account, user: users(:david))
+    import.file.attach io: file_fixture("moon.jpg").open, filename: "export.zip", content_type: "application/zip"
+    import.save!
+
+    perform_enqueued_jobs only: Account::Import::ProcessJob
+
+    assert import.reload.failed?
+    assert import.error_message.present?
+    assert_import_email_enqueued :failed
+  end
+
+  test "the uploaded file is purged once processed" do
+    import = import_export
+
+    assert_not import.reload.file.attached?
+  end
+
+  private
+    def assert_import_email_enqueued(method)
+      mail_jobs = enqueued_jobs.select { |job| job["job_class"] == "ActionMailer::MailDeliveryJob" }
+      assert mail_jobs.any? { |job| job["arguments"].first(2) == [ "Account::ImportMailer", method.to_s ] }, "Expected Account::ImportMailer##{method} to be enqueued"
+    end
+
+    def export_account
+      Current.with_account(@account) do
+        Account::Export.create!(user: users(:david)).tap(&:process_now)
+      end
+    end
+
+    def import_export(by: users(:david))
+      Current.with_account(@account) do
+        Account::Import.create!(account: @account, user: by, file: @export.file.blob).tap do |import|
+          perform_enqueued_jobs only: Account::Import::ProcessJob
+          import.reload
+        end
+      end
+    end
+
+    def attach_image_to(card)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      card.image.blob
+    end
+
+    def attach_embed_to(card)
+      blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "avatar.png", content_type: "image/png")
+      card.update!(description: "<p>Look: #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+      card.description.embeds.sole
+    end
+
+    def mention_html(user)
+      ActionText::Attachment.from_attachable(user).to_html
+    end
+end
diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..c0a2ef0
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    Current.session = sessions(:david)
+
+    @card = cards(:logo)
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    @blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("avatar.png").open, filename: "moon.jpg", content_type: "image/png")
+    @card.update!(description: "<p>Look: #{ActionText::Attachment.from_attachable(@blob).to_html}</p>")
+  end
+
+  test "creating an export processes it in the background" do
+    export = Export.create!
+
+    assert export.pending?
+    assert_enqueued_with job: Export::ProcessJob, args: [ export ]
+  end
+
+  test "processing builds a zip and emails a download link" do
+    export = Export.create!
+
+    perform_enqueued_jobs only: Export::ProcessJob
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+    assert_equal "37signals-cards-#{Date.current.iso8601}.zip", export.file.filename.to_s
+
+    mail_job = enqueued_jobs.find { |job| job["job_class"] == "ActionMailer::MailDeliveryJob" }
+    assert_equal [ "ExportMailer", "ready" ], mail_job["arguments"].first(2)
+  end
+
+  test "cards come as JSON with their comments and every attached file" do
+    export = Export.create!.tap(&:process_now)
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("export.json")
+      assert_equal "cards", JSON.parse(zip.read("export.json"))["kind"]
+
+      card = JSON.parse(zip.read("cards/#{@card.number}/card.json"))
+      assert_equal @card.title, card["title"]
+      assert_equal @card.board.name, card.dig("board", "name")
+      assert_equal @card.comments.count, card["comments"].size
+      assert_equal @card.comments.chronologically.first.body.to_plain_text, card["comments"].first.dig("body", "plain_text")
+      assert_equal "jz@37signals.com", card["comments"].find { |comment| comment.dig("creator", "name") == "JZ" }.dig("creator", "email_address")
+
+      assert_equal "cards/#{@card.number}/attachments/moon.jpg", card.dig("image", "path")
+      assert_equal "cards/#{@card.number}/attachments/moon-2.jpg", card["attachments"].sole["path"]
+      assert_equal @card.image.download, zip.read(card.dig("image", "path"))
+      assert_equal @blob.download, zip.read(card["attachments"].sole["path"])
+    end
+  end
+
+  test "only includes the cards the user can see" do
+    private_card = boards(:private).cards.create!(title: "Secret", status: :published, creator: users(:kevin))
+    export = Export.create!.tap(&:process_now)
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("cards/#{@card.number}/card.json")
+      assert_not zip.exists?("cards/#{private_card.number}/card.json")
+      assert_empty zip.glob("data/*")
+    end
+  end
+
+  test "the download is only accessible to the person who requested it" do
+    export = Export.create!.tap(&:process_now)
+
+    assert export.file.blob.accessible_to?(@user)
+    assert_not export.file.blob.accessible_to?(users(:kevin))
+    assert_not export.file.blob.publicly_accessible?
+  end
+
+  test "a failed export is marked as such and reported" do
+    Export::CardSet.any_instance.stubs(:export_to).raises("Boom")
+    export = Export.create!
+
+    assert_raises(RuntimeError) { export.process_now }
+
+    assert export.reload.failed?
+    mail_job = enqueued_jobs.find { |job| job["job_class"] == "ActionMailer::MailDeliveryJob" }
+    assert_equal [ "ExportMailer", "failed" ], mail_job["arguments"].first(2)
+  end
+
+  test "cleanup destroys exports past their retention period" do
+    old = Export.create!.tap(&:process_now)
+    old.update_columns(updated_at: (Export::RETENTION_PERIOD + 1.hour).ago)
+    recent = Export.create!.tap(&:process_now)
+    pending = Export.create!.tap { |export| export.update_columns(updated_at: 3.days.ago) }
+
+    Export.cleanup
+
+    assert_not Export.exists?(old.id)
+    assert Export.exists?(recent.id)
+    assert Export.exists?(pending.id)
+  end
+end
diff --git a/test/models/zip_file_test.rb b/test/models/zip_file_test.rb
index 249f23c..18cc646 100644
--- a/test/models/zip_file_test.rb
+++ b/test/models/zip_file_test.rb
@@ -38,3 +38,61 @@ class ZipFileTest < ActiveSupport::TestCase
     assert_equal [ "images/logo.png" ], writer.glob("**/*.png")
   end
 end
+
+class ZipFileReaderTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts(:"37s")
+
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    tempfile.binmode
+    writer = ZipFile::Writer.new(tempfile)
+    writer.add_file("hello.txt", "Hello, World!")
+    writer.add_file("data/records.jsonl", "{\"id\":1}\n{\"id\":2}\n{\"id\":3}")
+    writer.add_file("files/big.bin", compress: false) { |sink| 3.times { sink.write("A" * 3.megabytes) } }
+    writer.close
+    tempfile.rewind
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: tempfile, filename: "test.zip", content_type: "application/zip")
+    @record = Export.new
+    @record.file.attach(blob)
+  end
+
+  test "lists, globs and reads entries" do
+    ZipFile.open(@record.file) do |zip|
+      assert_equal [ "hello.txt", "data/records.jsonl", "files/big.bin" ], zip.entries
+      assert_equal [ "data/records.jsonl" ], zip.glob("data/*.jsonl")
+      assert zip.exists?("hello.txt")
+      assert_not zip.exists?("missing.txt")
+      assert_equal "Hello, World!", zip.read("hello.txt")
+    end
+  end
+
+  test "streams lines" do
+    ZipFile.open(@record.file) do |zip|
+      lines = []
+      zip.each_line("data/records.jsonl") { |line| lines << line }
+      assert_equal [ "{\"id\":1}", "{\"id\":2}", "{\"id\":3}" ], lines
+    end
+  end
+
+  test "streams large entries in chunks and can be copied like an IO" do
+    ZipFile.open(@record.file) do |zip|
+      zip.open("files/big.bin") do |io|
+        assert_equal 9.megabytes, io.size
+        assert_equal "A" * 1000, io.read(1000)
+        assert_equal 9.megabytes - 1000, io.read.bytesize
+        assert io.eof?
+        assert_nil io.read(10)
+
+        io.rewind
+        assert_equal 9.megabytes, IO.copy_stream(io, File::NULL)
+      end
+    end
+  end
+
+  test "raises for missing entries" do
+    ZipFile.open(@record.file) do |zip|
+      assert_raises(ZipFile::Reader::MissingEntry) { zip.read("missing.txt") }
+    end
+  end
+end
