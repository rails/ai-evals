       ::ActionText::RichText.where(account: account)
     end
 
+    def export_record(record)
+      super.merge("body" => export_body(record.body))
+    end
+
+    def export_body(body)
+      if body
+        replace_attachments(body.to_html) do |node|
+          if gid = SignedGlobalID.parse(node["sgid"], for: ::ActionText::Attachable::LOCATOR_NAME)
+            node.remove_attribute("sgid")
+            node[GID_ATTRIBUTE] = URI::GID.build(app: GlobalID.app, model_name: gid.model_name, model_id: gid.model_id).to_s
+          end
+        end
+      end
+    end
+
+    def import_attributes(attributes)
+      super.merge("body" => import_body(attributes["body"]))
+    end
+
+    def import_body(html)
+      if html
+        replace_attachments(html) do |node|
+          if gid = GlobalID.parse(node.remove_attribute(GID_ATTRIBUTE)&.value)
+            node["sgid"] = signed_gid_for(gid.model_name, ids.translate(gid.model_id))
+          end
+        end
+      end
+    end
+
+    def replace_attachments(html)
+      ::ActionText::Fragment.wrap(html).replace(ATTACHMENT_SELECTOR) do |node|
+        yield node
+        node
+      end.to_html
+    end
+
+    def signed_gid_for(model_name, id)
+      SignedGlobalID.new("gid://#{GlobalID.app}/#{model_name}/#{id}", for: ::ActionText::Attachable::LOCATOR_NAME, expires_in: nil).to_s
+    end
 end
