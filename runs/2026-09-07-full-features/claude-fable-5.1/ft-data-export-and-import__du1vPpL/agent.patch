diff --git a/test/mailers/account/import_mailer_test.rb b/test/mailers/account/import_mailer_test.rb
new file mode 100644
index 0000000..8844586
--- /dev/null
+++ b/test/mailers/account/import_mailer_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Account::ImportMailerTest < ActionMailer::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @import = Account::Import.new(user: users(:david), account: accounts(:"37s"))
+    @import.file.attach io: file_fixture("moon.jpg").open, filename: "export.zip", content_type: "application/zip"
+    @import.save!
+    clear_enqueued_jobs
+  end
+
+  test "completed links to the new account" do
+    @import.update!(imported_account: accounts(:acme), status: :completed)
+    email = Account::ImportMailer.completed(@import)
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_equal "Your Fizzy import is done", email.subject
+    assert_match accounts(:acme).name, email.body.encoded
+    assert_match accounts(:acme).slug, email.html_part.body.decoded
+  end
+
+  test "failed says why" do
+    @import.update!(status: :failed, error_message: "This file is not a Fizzy account export")
+    email = Account::ImportMailer.failed(@import)
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_match(/couldn't be completed/, email.subject)
+    assert_match "This file is not a Fizzy account export", email.text_part.body.decoded
+    assert_match "This file is not a Fizzy account export", email.html_part.body.decoded
+  end
+end
diff --git a/test/mailers/export_mailer_test.rb b/test/mailers/export_mailer_test.rb
new file mode 100644
index 0000000..bd2ecf7
--- /dev/null
+++ b/test/mailers/export_mailer_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class ExportMailerTest < ActionMailer::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @export = Export.create!.tap(&:process_now)
+  end
+
+  test "ready links to the download for a day" do
+    email = ExportMailer.ready(@export)
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_equal "Your Fizzy export is ready", email.subject
+
+    link = email.html_part.body.decoded[%r{href="([^"]+)"}, 1]
+    signed_id = link[%r{/blobs/redirect/([^/]+)/}, 1]
+    assert_equal @export.file.blob, ActiveStorage::Blob.find_signed(signed_id)
+    assert_match %r{/#{ActiveRecord::FixtureSet.identify("37signals")}/rails/active_storage}, link
+    assert_match "1 day", email.text_part.body.decoded
+
+    travel Export::RETENTION_PERIOD + 1.minute do
+      assert_nil ActiveStorage::Blob.find_signed(signed_id)
+    end
+  end
+
+  test "failed" do
+    email = ExportMailer.failed(@export)
+
+    assert_equal [ "david@37signals.com" ], email.to
+    assert_match(/couldn't be completed/, email.subject)
+  end
+end
