+++ b/test/models/account/data_transfer/id_translator_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Account::DataTransfer::IdTranslatorTest < ActiveSupport::TestCase
+  setup do
+    @translator = Account::DataTransfer::IdTranslator.new("import-1")
+  end
+
+  test "translates ids deterministically for a given salt" do
+    id = ActiveRecord::Type::Uuid.generate
+
+    assert_equal @translator.translate(id), @translator.translate(id)
+    assert_not_equal id, @translator.translate(id)
+    assert_not_equal @translator.translate(id), Account::DataTransfer::IdTranslator.new("import-2").translate(id)
+  end
+
+  test "translated ids are valid uuids that keep their ordering" do
+    ids = 5.times.map { ActiveRecord::Type::Uuid.generate.tap { sleep 0.002 } }
+    translated = ids.map { |id| @translator.translate(id) }
+
+    assert_equal translated, translated.sort
+    translated.each do |id|
+      assert_equal ActiveRecord::Type::Uuid::BASE36_LENGTH, id.length
+      assert_match(/\A[0-9a-z]+\z/, id)
+      assert_includes %w[ 8 9 a b ], ActiveRecord::Type::Uuid.base36_to_hex(id)[16]
+    end
+  end
+
+  test "leaves blanks alone" do
+    assert_nil @translator.translate(nil)
+    assert_nil @translator.translate("")
+  end
+end
diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
