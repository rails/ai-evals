diff --git a/app/models/export/card_set/folder.rb b/app/models/export/card_set/folder.rb
new file mode 100644
index 0000000..328bce8
--- /dev/null
+++ b/app/models/export/card_set/folder.rb
@@ -0,0 +1,113 @@
+class Export::CardSet::Folder
+  attr_reader :card, :zip
+
+  def initialize(card, zip)
+    @card = card
+    @zip = zip
+    @files = {}
+  end
+
+  def write
+    zip.add_file("#{path}/card.json", JSON.pretty_generate(card_json))
+
+    @files.each do |file_path, blob|
+      write_file(file_path, blob)
+    end
+  end
+
+  private
+    def path
+      "cards/#{card.number}"
+    end
+
+    def card_json
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column && { id: card.column.id, name: card.column.name },
+        creator: person_json(card.creator),
+        assignees: card.assignees.map { |assignee| person_json(assignee) },
+        tags: card.tags.map(&:title).sort,
+        golden: card.golden?,
+        postponed: card.postponed?,
+        closed: card.closed?,
+        closed_at: card.closure&.created_at,
+        due_on: card.due_on,
+        created_at: card.created_at,
+        updated_at: card.updated_at,
+        last_active_at: card.last_active_at,
+        description: rich_text_json(card.description),
+        image: card.image.attached? ? file_json(card.image) : nil,
+        attachments: card.attachments.map { |attachment| file_json(attachment) },
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed? } },
+        reactions: card.reactions.map { |reaction| reaction_json(reaction) },
+        comments: comments.map { |comment| comment_json(comment) }
+      }
+    end
+
+    def comments
+      card.comments.with_rich_text_body_and_embeds.includes(:creator, reactions: :reacter).chronologically
+    end
+
+    def comment_json(comment)
+      {
+        id: comment.id,
+        creator: person_json(comment.creator),
+        created_at: comment.created_at,
+        updated_at: comment.updated_at,
+        body: rich_text_json(comment.body),
+        attachments: comment.attachments.map { |attachment| file_json(attachment) },
+        reactions: comment.reactions.map { |reaction| reaction_json(reaction) }
+      }
+    end
+
+    def person_json(user)
+      { id: user.id, name: user.name, email_address: user.identity&.email_address }
+    end
+
+    def reaction_json(reaction)
+      { content: reaction.content, reacter: person_json(reaction.reacter), created_at: reaction.created_at }
+    end
+
+    def rich_text_json(rich_text)
+      { plain_text: rich_text.to_plain_text, html: rich_text.body&.to_html }
+    end
+
+    def file_json(attachment)
+      blob = attachment.blob
+
+      { filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, path: register_file(blob) }
+    end
+
+    def register_file(blob)
+      file_path = "#{path}/attachments/#{unique_filename_for(blob)}"
+      @files[file_path] = blob
+      file_path
+    end
+
+    def unique_filename_for(blob)
+      filename = blob.filename
+      candidate = filename.sanitized
+      count = 1
+
+      while @files.key?("#{path}/attachments/#{candidate}")
+        count += 1
+        candidate = "#{filename.base}-#{count}#{filename.extension_with_delimiter}"
+      end
+
+      candidate
+    end
+
+    def write_file(file_path, blob)
+      if blob.service.exist?(blob.key)
+        zip.add_file(file_path, compress: false) do |sink|
+          blob.download { |chunk| sink.write(chunk) }
+        end
+      else
+        Rails.logger.warn "Skipping export of missing file for blob #{blob.id}"
+      end
+    end
+end
