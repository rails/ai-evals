@@ -0,0 +1,46 @@
+# Brings an account export back as a new account, owned by whoever imported it. Runs in
+# the background and reports back by email, both when it succeeds and when it fails.
+class Account::Import < ApplicationRecord
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  validate :file_is_attached, on: :create
+
+  after_create_commit :process_later
+
+  def process_later
+    Account::Import::ProcessJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+    update!(imported_account: import_account, status: :completed)
+    Account::ImportMailer.completed(self).deliver_later
+  rescue => error
+    update!(status: :failed, error_message: error.message)
+    Account::ImportMailer.failed(self).deliver_later
+    Rails.error.report(error, context: { import_id: id }) unless error.is_a?(Account::DataTransfer::Error)
+  ensure
+    file.purge_later
+  end
+
+  def accessible_to?(user)
+    self.user == user
+  end
+
+  private
+    def file_is_attached
+      errors.add(:file, "must be attached") unless file.attached?
+    end
+
+    def import_account
+      ZipFile.open(file) do |zip|
+        Account::DataTransfer::Importer.new(zip, salt: id, owner: user).import
+      end
+    end
+end
