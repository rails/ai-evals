diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..d4ae3c6
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "👍", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+    assert_select "##{dom_id(@card, :reactions)} .reaction", count: 2
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "form[action='#{card_reactions_path(@card)}']"
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    assert_equal users(:david), @card.reactions.last.reacter
+  end
+
+  test "creating a reaction touches the card activity" do
+    assert_changes -> { @card.reload.last_active_at } do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "🔥" } }
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "cannot react to inaccessible card" do
+    logout_and_sign_in_as :kevin
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "👀" } }
+      assert_response :not_found
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+    assert_equal card_reaction_url(@card, @david_reaction), @response.parsed_body.first["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, @card.reactions.last), @response.parsed_body["url"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
diff --git a/test/integration/card_reactions_test.rb b/test/integration/card_reactions_test.rb
new file mode 100644
index 0000000..784dac2
--- /dev/null
+++ b/test/integration/card_reactions_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class CardReactionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+  end
+
+  test "card detail view shows reactions and lets user react" do
+    get card_path(@card)
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@card, :reacting)}"
+    assert_select "a[href='#{new_card_reaction_path(@card)}']"
+
+    @card.reactions.create!(content: "🚀", reacter: users(:kevin))
+    get card_path(@card)
+    assert_select "##{dom_id(@card, :reactions)} .reaction", count: 1
+    assert_select ".reaction form[action='#{card_reaction_path(@card, @card.reactions.first)}']"
+  end
+
+  test "comment reactions still render in the card detail view" do
+    comment = comments(:logo_agreement_jz)
+    comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    get card_path(@card)
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(comment, :reacting)}"
+    assert_select "##{dom_id(comment, :reactions)} .reaction form[action='#{card_comment_reaction_path(@card, comment, comment.reactions.first)}']"
+  end
+
+  test "card preview shows boost count only when non-zero" do
+    get board_column_path(@card.board, @card.column)
+    assert_response :success
+    assert_select "##{dom_id(@card, :article)} .card__boosts", count: 0
+
+    @card.reactions.create!(content: "🚀", reacter: users(:kevin))
+    @card.reactions.create!(content: "💯", reacter: users(:david))
+
+    get board_column_path(@card.board, @card.column)
+    assert_select "##{dom_id(@card, :article)} .card__boosts strong", text: "2"
+  end
+
+  test "card JSON includes reactions_url" do
+    get card_path(@card), as: :json
+    assert_equal card_reactions_url(@card), @response.parsed_body["reactions_url"]
+  end
+end
