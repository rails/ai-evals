@@ -5,9 +5,50 @@ class ReactionTest < ActiveSupport::TestCase
     Current.session = sessions(:david)
   end
 
-  test "creating a reaction touches the card activity" do
+  test "creating a comment reaction touches the card activity" do
     assert_changes -> { cards(:logo).reload.last_active_at } do
       comments(:logo_1).reactions.create!(content: "Nice!")
     end
   end
+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "reactions default to the current user and the reactable's account" do
+    reaction = cards(:logo).reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal cards(:logo).account, reaction.account
+    assert_equal cards(:logo), reaction.reactable
+    assert_equal cards(:logo), reaction.card
+  end
+
+  test "card reactions are separate from comment reactions" do
+    card = cards(:logo)
+    comment = comments(:logo_1)
+
+    card_reaction = card.reactions.create!(content: "🚀")
+    comment_reaction = comment.reactions.create!(content: "👍")
+
+    assert_equal [ card_reaction ], card.reactions
+    assert_equal [ comment_reaction ], comment.reactions
+    assert_equal card, comment_reaction.card
+  end
+
+  test "reactions are deleted along with their reactable" do
+    card = cards(:logo)
+    card.reactions.create!(content: "🚀")
+    comments(:logo_1).reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      comments(:logo_1).destroy
+    end
+
+    assert_difference -> { Reaction.count }, -1 do
+      card.destroy
+    end
+  end
 end
