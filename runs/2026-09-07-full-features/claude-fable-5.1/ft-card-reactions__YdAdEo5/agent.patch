diff --git a/app/controllers/reactions_controller.rb b/app/controllers/reactions_controller.rb
new file mode 100644
index 0000000..1dacd35
--- /dev/null
+++ b/app/controllers/reactions_controller.rb
@@ -0,0 +1,51 @@
+# Abstract base for reacting to reactables (cards, comments) within a card.
+# Subclasses set @reactable and inherit the views from app/views/reactions.
+class ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_reactable
+
+  with_options only: :destroy do
+    before_action :set_reaction
+    before_action :ensure_permission_to_administer_reaction
+  end
+
+  def index
+  end
+
+  def new
+  end
+
+  def create
+    @reaction = @reactable.reactions.create!(params.expect(reaction: :content))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_reactable
+      raise NotImplementedError, "#{self.class.name} must implement #set_reactable"
+    end
+
+    def set_reaction
+      @reaction = @reactable.reactions.find(params[:id])
+    end
+
+    def ensure_permission_to_administer_reaction
+      head :forbidden if Current.user != @reaction.reacter
+    end
+end
diff --git a/app/helpers/reactions_helper.rb b/app/helpers/reactions_helper.rb
new file mode 100644
index 0000000..4f8db22
--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,30 @@
+module ReactionsHelper
+  # Reactions are nested under the card, and additionally under the comment when reacting to one:
+  #
+  #   /cards/:card_id/reactions
+  #   /cards/:card_id/comments/:comment_id/reactions
+  def reactions_path_for(reactable, **options)
+    polymorphic_path [ *reactable_routing_scope(reactable), :reactions ], **options
+  end
+
+  def reactions_url_for(reactable, **options)
+    polymorphic_url [ *reactable_routing_scope(reactable), :reactions ], **options
+  end
+
+  def new_reaction_path_for(reactable, **options)
+    new_polymorphic_path [ *reactable_routing_scope(reactable), Reaction ], **options
+  end
+
+  def reaction_path_for(reaction, **options)
+    polymorphic_path [ *reactable_routing_scope(reaction.reactable), reaction ], **options
+  end
+
+  def reaction_url_for(reaction, **options)
+    polymorphic_url [ *reactable_routing_scope(reaction.reactable), reaction ], **options
+  end
+
+  private
+    def reactable_routing_scope(reactable)
+      reactable.is_a?(Card) ? [ reactable ] : [ reactable.card, reactable ]
+    end
+end
