diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..d5377c6
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,50 @@
+# A card gets a burst of attention when several people pile comments on it in a short
+# span, or when someone is assigned to it or reopens it. A burst that is then followed
+# by a stretch of silence means the card has stalled. Any activity resets the clock.
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_ACTIONS = %w[ card_assigned card_reopened ]
+
+  included do
+    scope :burst, -> { where.not(burst_at: nil) }
+    scope :stalled, -> { active.burst.where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    active? && burst? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def record_burst_from(event)
+    record_burst if event.action.in?(BURST_ACTIONS)
+  end
+
+  def record_burst_from_comments
+    record_burst if comments_bursting?
+  end
+
+  private
+    def record_burst
+      update! burst_at: Time.current
+    end
+
+    # Three or more comments from at least two people within a third of the board's
+    # auto-postpone period.
+    def comments_bursting?
+      recent_comments = comments.by_user.where(created_at: burst_window.ago..)
+
+      recent_comments.count >= BURST_COMMENTS &&
+        recent_comments.distinct.count(:creator_id) >= BURST_COMMENTERS
+    end
+
+    def burst_window
+      (auto_postpone_period / 3).seconds
+    end
+end
