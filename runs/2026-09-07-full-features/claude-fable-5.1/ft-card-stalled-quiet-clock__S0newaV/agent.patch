diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..afe3045
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.comments.delete_all
+  end
+
+  test "three comments from two people within a third of the auto-postpone period are a burst" do
+    @card.comments.create! body: "one", creator: users(:david)
+    @card.comments.create! body: "two", creator: users(:david)
+    assert_not @card.reload.burst?
+
+    @card.comments.create! body: "three", creator: users(:kevin)
+    assert @card.reload.burst?
+  end
+
+  test "three comments from a single person aren't a burst" do
+    3.times { |i| @card.comments.create! body: "comment #{i}", creator: users(:david) }
+    assert_not @card.reload.burst?
+  end
+
+  test "comments spread beyond a third of the auto-postpone period aren't a burst" do
+    window = @card.auto_postpone_period / 3
+
+    @card.comments.create! body: "one", creator: users(:david), created_at: (window + 1.day).ago
+    @card.comments.create! body: "two", creator: users(:kevin)
+    @card.comments.create! body: "three", creator: users(:david)
+    assert_not @card.reload.burst?
+
+    @card.comments.create! body: "four", creator: users(:kevin)
+    assert @card.reload.burst?
+  end
+
+  test "system comments don't count towards a burst" do
+    3.times { |i| @card.comments.create! body: "system #{i}", creator: accounts("37s").system_user }
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning someone is a burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.burst?
+  end
+
+  test "reopening is a burst" do
+    @card.close
+    assert_not @card.reload.burst?
+
+    @card.reopen
+    assert @card.reload.burst?
+  end
+
+  test "a card that had a burst and then went quiet for two weeks is stalled" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 13.days do
+      assert_not @card.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+
+    travel 15.days do
+      assert @card.stalled?
+      assert_includes Card.stalled, @card
+      assert_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+  test "any activity resets the stall" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 15.days do
+      assert @card.stalled?
+
+      @card.comments.create! body: "Still on it", creator: users(:jz)
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "quiet cards without a burst aren't stalled" do
+    @card.update! last_active_at: 3.weeks.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed and postponed cards aren't stalled" do
+    @card.toggle_assignment users(:kevin)
+
+    travel 15.days do
+      @card.postpone
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+
+    travel 30.days do
+      @card.resume
+      @card.close
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+end
