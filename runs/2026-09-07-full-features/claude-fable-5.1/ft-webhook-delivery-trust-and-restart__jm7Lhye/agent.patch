@@ -1,4 +1,10 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+  RESPONSE_BODY_LIMIT = 1.kilobyte
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +15,26 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where created_at: ...RETENTION_PERIOD.ago }
+
+  class << self
+    def cleanup
+      stale.in_batches.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  # Only a pending delivery can be delivered, and claiming it is atomic, so the
+  # receiver hears about an event at most once even if the job runs more than once.
+  def deliver
+    if start
+      perform_request
+      webhook.track_delinquency(self)
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +55,68 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def start
+      claimed = self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload if claimed
+      claimed
+    end
+
+    def perform_request
+      payload = Webhook::Payload.new(self)
+      headers = headers_for(payload)
+
+      update! request: { headers: headers }
+      complete_with post(payload.body, headers)
+    rescue Timeout::Error => error
+      complete_with_error :timeout, error
+    rescue OpenSSL::OpenSSLError => error
+      complete_with_error :ssl_error, error
+    rescue SocketError, SystemCallError => error
+      complete_with_error :destination_unreachable, error
+    rescue IOError, Net::ProtocolError, Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError => error
+      complete_with_error :invalid_response, error
+    end
+
+    def headers_for(payload)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => payload.content_type,
+        "X-Webhook-Signature" => signature_for(payload.body),
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3)
+      }
+    end
+
+    def signature_for(body)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", **timeouts) do |http|
+        http.request Net::HTTP::Post.new(uri, headers), body
+      end
+    end
+
+    def timeouts
+      { open_timeout: OPEN_TIMEOUT.to_i, read_timeout: READ_TIMEOUT.to_i, write_timeout: READ_TIMEOUT.to_i }
+    end
+
+    def complete_with(http_response)
+      update! state: :completed, response: {
+        code: http_response.code.to_i,
+        headers: http_response.each_header.to_h,
+        body: excerpt_of(http_response.body)
+      }
+    end
+
+    def complete_with_error(type, error)
+      update! state: :errored, response: { error: type, message: excerpt_of(error.message) }
+    end
+
+    def excerpt_of(text)
+      text.to_s.dup.force_encoding(Encoding::UTF_8).scrub.truncate(RESPONSE_BODY_LIMIT)
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..15a796f
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,56 @@
+# What gets POSTed to a webhook's URL for an event. Chat tools get a message
+# in their own format, everything else gets the full JSON representation of the event.
+class Webhook::Payload
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+  delegate :account, to: :webhook
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||= build_body
+  end
+
+  private
+    def build_body
+      if webhook.for_slack?
+        { text: render(:text) }.to_json
+      elsif webhook.for_basecamp?
+        { content: render(:html) }.to_json
+      elsif webhook.for_campfire?
+        render(:html)
+      else
+        render(:json)
+      end
+    end
+
+    def render(format)
+      renderer.render(template: "webhooks/event", formats: [ format ], layout: false, assigns: { event: event }).strip
+    end
+
+    def renderer
+      ApplicationController.renderer.new \
+        http_host: http_host, https: url_options[:protocol].to_s.start_with?("https"), script_name: account.slug
+    end
+
+    def http_host
+      [ url_options[:host], url_options[:port] ].compact.join(":")
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
