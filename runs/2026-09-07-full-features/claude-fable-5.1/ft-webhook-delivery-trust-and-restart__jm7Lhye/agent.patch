diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..7e00201
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,37 @@
+# Keeps count of how many deliveries in a row have failed for a webhook, and since when.
+# A webhook becomes delinquent once it has failed FAILURE_THRESHOLD times in a row
+# and has been failing for at least FAILURE_WINDOW, at which point it gets deactivated.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    with_lock do
+      if delivery.succeeded?
+        reset
+      else
+        record_failure
+      end
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_THRESHOLD && failing_since.before?(FAILURE_WINDOW.ago)
+  end
+
+  private
+    def record_failure
+      update! consecutive_failures_count: consecutive_failures_count + 1, first_failure_at: first_failure_at || Time.current
+    end
+
+    def failing_since
+      first_failure_at || Time.current
+    end
+end
