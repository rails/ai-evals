+class Webhook::DeliveryJob < ApplicationJob
+  queue_as :webhooks
+
+  # A delivery is attempted once, and never again. Dropping the job when the
+  # delivery or webhook is gone is the right thing to do.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(delivery)
+    delivery.deliver
+  end
+end
