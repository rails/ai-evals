+
+class WebhookDeliveringTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+  end
+
+  test "subscribed_to" do
+    assert_includes Webhook.subscribed_to(:card_published), @webhook
+    assert_not_includes Webhook.subscribed_to(:card_postponed), @webhook
+
+    assert @webhook.subscribed_to?(:card_published)
+    assert_not @webhook.subscribed_to?(:card_postponed)
+  end
+
+  test "deliver_later creates a delivery and enqueues it" do
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      assert_enqueued_with job: Webhook::DeliveryJob do
+        @webhook.deliver_later(@event)
+      end
+    end
+
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal @event, delivery.event
+    assert delivery.pending?
+  end
+
+  test "switched off after ten failed deliveries in a row over an hour" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    travel_to 90.minutes.ago do
+      9.times { @webhook.deliver(@event) }
+    end
+    assert @webhook.reload.active?, "nine failures aren't enough"
+
+    @webhook.deliver(@event)
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "not switched off by a burst of failures within the hour" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    12.times { @webhook.deliver(@event) }
+
+    assert @webhook.reload.active?
+  end
+
+  test "a successful delivery forgives earlier failures" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    travel_to 90.minutes.ago do
+      9.times { @webhook.deliver(@event) }
+    end
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.deliver(@event)
+    assert_equal 0, @webhook.delinquency_tracker.consecutive_failures_count
+
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    @webhook.deliver(@event)
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating starts over with delinquency" do
+    webhook = webhooks(:inactive)
+    webhook.delinquency_tracker.update! consecutive_failures_count: 10, first_failure_at: 2.hours.ago
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+end
