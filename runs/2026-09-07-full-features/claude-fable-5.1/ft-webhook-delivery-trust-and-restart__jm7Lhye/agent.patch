+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "tracking a failed delivery counts it and remembers when the failing started" do
+    freeze_time do
+      @tracker.track failed_delivery
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+
+    travel 10.minutes do
+      @tracker.track failed_delivery
+      assert_equal 2, @tracker.consecutive_failures_count
+      assert_equal 10.minutes.ago, @tracker.first_failure_at
+    end
+  end
+
+  test "tracking a successful delivery resets the count" do
+    @tracker.update! consecutive_failures_count: 5, first_failure_at: 30.minutes.ago
+
+    @tracker.track successful_delivery
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "delinquent after ten failures in a row spanning at least an hour" do
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 61.minutes.ago
+    assert @tracker.delinquent?
+
+    @tracker.update! consecutive_failures_count: 9, first_failure_at: 2.hours.ago
+    assert_not @tracker.delinquent?, "needs ten failures"
+
+    @tracker.update! consecutive_failures_count: 10, first_failure_at: 59.minutes.ago
+    assert_not @tracker.delinquent?, "needs to have been failing for an hour"
+
+    @tracker.update! consecutive_failures_count: 0, first_failure_at: nil
+    assert_not @tracker.delinquent?
+  end
+
+  private
+    def failed_delivery
+      Webhook::Delivery.new webhook: @webhook, event: events(:logo_published), state: :completed, response: { code: 500 }
+    end
+
+    def successful_delivery
+      Webhook::Delivery.new webhook: @webhook, event: events(:logo_published), state: :completed, response: { code: 200 }
+    end
+end
