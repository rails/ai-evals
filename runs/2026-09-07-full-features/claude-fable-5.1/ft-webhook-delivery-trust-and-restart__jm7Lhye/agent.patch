+
+class Webhook::DeliveryDeliveringTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+    @delivery = @webhook.deliveries.create!(event: @event)
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ @delivery ] do
+      @delivery.deliver_later
+    end
+  end
+
+  test "deliver POSTs the signed event to the receiver and logs the outcome" do
+    request_body = nil
+    stub_request(:post, @webhook.url).with { |request| request_body = request.body }.to_return(status: 200, body: "ok", headers: { "X-Request-Id" => "abc" })
+
+    freeze_time do
+      @delivery.deliver
+
+      assert @delivery.completed?
+      assert @delivery.succeeded?
+      assert_equal 200, @delivery.response[:code]
+      assert_equal "ok", @delivery.response[:body]
+      assert_equal "abc", @delivery.response[:headers]["x-request-id"]
+
+      headers = @delivery.request[:headers]
+      assert_equal "fizzy/1.0.0 Webhook", headers["User-Agent"]
+      assert_equal "application/json", headers["Content-Type"]
+      assert_equal Time.current.utc.iso8601(3), headers["X-Webhook-Timestamp"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request_body), headers["X-Webhook-Signature"]
+    end
+
+    payload = JSON.parse(request_body)
+    assert_equal @event.id, payload["id"]
+    assert_equal "card_published", payload["action"]
+    assert_equal @event.eventable_id, payload.dig("eventable", "id")
+    assert_equal @event.board_id, payload.dig("board", "id")
+    assert_equal @event.creator_id, payload.dig("creator", "id")
+  end
+
+  test "a non-2xx response completes the delivery as a failure" do
+    stub_request(:post, @webhook.url).to_return(status: 422, body: "nope")
+
+    @delivery.deliver
+
+    assert @delivery.completed?
+    assert @delivery.failed?
+    assert_not @delivery.succeeded?
+    assert_equal({ code: 422, error: nil }, @delivery.response_summary)
+  end
+
+  test "an unreachable receiver errors the delivery" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert @delivery.failed?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "a receiver that doesn't answer in time errors the delivery" do
+    stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver
+
+    assert @delivery.errored?
+    assert_equal "timeout", @delivery.response[:error]
+  end
+
+  test "a response body that isn't text is still logged" do
+    stub_request(:post, @webhook.url).to_return(status: 200, body: "\xFF\xFEbinary".b)
+
+    @delivery.deliver
+
+    assert @delivery.reload.succeeded?
+    assert_includes @delivery.response[:body], "binary"
+  end
+
+  test "a delivery is attempted exactly once" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+    @delivery.deliver
+    Webhook::Delivery.find(@delivery.id).deliver
+    perform_enqueued_jobs only: Webhook::DeliveryJob do
+      2.times { @delivery.deliver_later }
+    end
+
+    assert_requested stub, times: 1
+  end
+
+  test "only pending deliveries are delivered" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    webhook_deliveries(:in_progress).deliver
+    webhook_deliveries(:errored).deliver
+    webhook_deliveries(:successfully_completed).deliver
+
+    assert_not_requested stub
+  end
+
+  test "delivering keeps track of the webhook's delinquency" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    assert_difference -> { @webhook.delinquency_tracker.reload.consecutive_failures_count }, +1 do
+      @delivery.deliver
+    end
+  end
+
+  test "cleanup keeps a week of deliveries" do
+    stale = @webhook.deliveries.create!(event: @event, created_at: 8.days.ago)
+    fresh = @webhook.deliveries.create!(event: @event, created_at: 6.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(stale.id)
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert Webhook::Delivery.exists?(@delivery.id)
+  end
+end
