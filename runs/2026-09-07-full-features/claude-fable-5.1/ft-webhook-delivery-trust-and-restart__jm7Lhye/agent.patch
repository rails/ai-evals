@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:logo_published)
+    @board = @event.board
+  end
+
+  test "generic receivers get the event as JSON" do
+    payload = payload_for "https://api.example.com/webhooks"
+
+    assert_equal "application/json", payload.content_type
+
+    json = JSON.parse(payload.body)
+    assert_equal @event.id, json["id"]
+    assert_equal "card_published", json["action"]
+    assert_equal @event.eventable.id, json.dig("eventable", "id")
+    assert_equal card_url(@event.eventable, script_name: @event.account.slug, host: "example.com"), json.dig("eventable", "url")
+    assert_equal @board.id, json.dig("board", "id")
+    assert_equal @event.creator.id, json.dig("creator", "id")
+  end
+
+  test "Slack gets a text message" do
+    payload = payload_for "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+
+    assert_equal "application/json", payload.content_type
+
+    text = JSON.parse(payload.body).fetch("text")
+    assert_includes text, %(David added "The logo isn't big enough")
+    assert_includes text, "<#{card_url(@event.eventable, script_name: @event.account.slug, host: "example.com")}|↗︎>"
+  end
+
+  test "Campfire gets an HTML message" do
+    payload = payload_for "https://campfire.example.com/rooms/1/2-bot-key/messages"
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes payload.body, %(<a href="#{card_url(@event.eventable, script_name: @event.account.slug, host: "example.com")}">↗︎</a>)
+  end
+
+  test "Basecamp Campfire gets an HTML message as JSON" do
+    payload = payload_for "https://3.basecamp.com/1/integrations/token/buckets/2/chats/3/lines"
+
+    assert_equal "application/json", payload.content_type
+
+    content = JSON.parse(payload.body).fetch("content")
+    assert_includes content, "David added &quot;The logo isn&#39;t big enough&quot;"
+    assert_includes content, "<a href="
+  end
+
+  private
+    def payload_for(url)
+      webhook = Webhook.create!(name: "Test", url: url, board: @board)
+      Webhook::Payload.new(webhook.deliveries.new(event: @event))
+    end
+
+    def card_url(...)
+      Rails.application.routes.url_helpers.card_url(...)
+    end
+end
