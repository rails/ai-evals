+require "test_helper"
+
+class Event::WebhooksTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+    @card = cards(:logo)
+  end
+
+  test "creating an event delivers it to the board's webhooks subscribed to it" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = nil
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs only: Webhook::DeliveryJob do
+        event = @board.events.create!(action: "card_closed", creator: users(:david), eventable: @card)
+      end
+    end
+
+    assert_requested stub, times: 1
+    assert @webhook.deliveries.find_by(event: event).succeeded?
+  end
+
+  test "events for actions the webhook isn't subscribed to are not delivered" do
+    assert_no_difference -> { Webhook::Delivery.count } do
+      assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+        @board.events.create!(action: "card_postponed", creator: users(:david), eventable: @card)
+      end
+    end
+  end
+
+  test "events are not delivered to inactive webhooks" do
+    @webhook.deactivate
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      @board.events.create!(action: "card_published", creator: users(:david), eventable: @card)
+    end
+  end
+
+  test "events are not delivered to webhooks of other boards" do
+    other_webhook = webhooks(:inactive).tap(&:activate)
+
+    @board.events.create!(action: "card_published", creator: users(:david), eventable: @card)
+
+    assert_empty other_webhook.deliveries
+  end
+end
