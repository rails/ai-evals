@@ -0,0 +1,21 @@
+class Notification::BundleMailer < ApplicationMailer
+  include ActionView::Helpers::TextHelper
+
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc)
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      "#{pluralize(@notifications.size, "new notification")} in #{@account.name}"
+    end
+
+    def default_url_options
+      super.merge(script_name: @account.slug)
+    end
+end
