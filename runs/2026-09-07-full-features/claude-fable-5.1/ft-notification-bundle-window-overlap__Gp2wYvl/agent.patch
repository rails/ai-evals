+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @bundle = Notification::Bundle.window_for(@user, 1.week.ago)
+    @user.notifications.update_all(bundle_id: @bundle.id)
+  end
+
+  test "digest" do
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "3 new notifications in 37signals", email.subject
+
+    [ email.html_part, email.text_part ].each do |part|
+      body = part.body.encoded
+
+      assert_match "Writebook", body
+      assert_match "The logo isn&#39;t big enough", body.gsub("The logo isn't big enough", "The logo isn&#39;t big enough")
+      assert_match "Layout is broken", body
+      assert_match "Buy domain", body
+      assert_match %r{http://example\.com#{@user.account.slug}/cards/#{cards(:logo).number}}, body
+      assert_match %r{http://example\.com#{@user.account.slug}/notifications/settings}, body
+    end
+  end
+
+  test "digest groups notifications by board" do
+    html = Notification::BundleMailer.digest(@bundle).html_part.body.encoded
+
+    assert_equal 1, html.scan("notification__board\"").size
+    assert_equal 3, html.scan("class=\"notification\"").size
+  end
+
+  test "digest for a single notification" do
+    @user.notifications.where.not(id: notifications(:layout_commented_kevin)).update_all(bundle_id: nil)
+
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_equal "1 new notification in 37signals", email.subject
+  end
+end
diff --git a/test/mailers/previews/notification/bundle_mailer_preview.rb b/test/mailers/previews/notification/bundle_mailer_preview.rb
new file mode 100644
index 0000000..6fe3e3f
--- /dev/null
+++ b/test/mailers/previews/notification/bundle_mailer_preview.rb
@@ -0,0 +1,24 @@
+class Notification::BundleMailerPreview < ActionMailer::Preview
+  def digest
+    with_transient_bundle do |bundle|
+      Notification::BundleMailer.digest(bundle)
+    end
+  end
+
+  private
+    # Previews shouldn't leave data behind, so the bundle only lives for as long as it takes to render the email.
+    def with_transient_bundle
+      mail = nil
+
+      Notification::Bundle.transaction do
+        user = User.joins(:notifications).first
+        bundle = user.notification_bundles.create!(starts_at: 4.hours.ago, ends_at: Time.current)
+        user.notifications.limit(5).update_all(bundle_id: bundle.id)
+
+        mail = yield(bundle).tap(&:message)
+        raise ActiveRecord::Rollback
+      end
+
+      mail
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..79d8b91
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "window_for opens a window that starts when the first notification lands" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      assert bundle.pending?
+      assert_equal Time.utc(2026, 9, 7, 10, 0), bundle.starts_at
+      assert_equal Time.utc(2026, 9, 7, 14, 0), bundle.ends_at
+    end
+  end
+
+  test "window length follows the person's frequency" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      @user.settings.update!(bundle_email_frequency: "daily")
+      assert_equal 1.day.from_now, Notification::Bundle.window_for(@user, Time.current).ends_at
+
+      @user.notification_bundles.destroy_all
+      @user.settings.update!(bundle_email_frequency: "weekly")
+      assert_equal 1.week.from_now, Notification::Bundle.window_for(@user, Time.current).ends_at
+    end
+  end
+
+  test "window_for reuses the pending window while it's open" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      assert_no_difference -> { Notification::Bundle.count } do
+        assert_equal bundle, Notification::Bundle.window_for(@user, 2.hours.from_now)
+        assert_equal bundle, Notification::Bundle.window_for(@user, 3.hours.from_now + 59.minutes)
+      end
+    end
+  end
+
+  test "window_for puts late notifications in the window that has already opened" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      assert_no_difference -> { Notification::Bundle.count } do
+        assert_equal bundle, Notification::Bundle.window_for(@user, 30.minutes.ago)
+      end
+
+      assert_equal Time.utc(2026, 9, 7, 10, 0), bundle.reload.starts_at
+    end
+  end
+
+  test "window_for opens a new window once the previous one has ended" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      first = Notification::Bundle.window_for(@user, Time.current)
+      second = Notification::Bundle.window_for(@user, 4.hours.from_now + 5.minutes)
+
+      assert_not_equal first, second
+      assert_equal Time.utc(2026, 9, 7, 14, 5), second.starts_at
+      assert_equal Time.utc(2026, 9, 7, 18, 5), second.ends_at
+    end
+  end
+
+  test "window_for never opens a window overlapping a delivered one" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      first = Notification::Bundle.window_for(@user, Time.current)
+      first.update!(delivered_at: 4.hours.from_now)
+
+      second = Notification::Bundle.window_for(@user, 3.hours.from_now + 59.minutes)
+
+      assert_not_equal first, second
+      assert_equal first.ends_at, second.starts_at
+    end
+  end
+
+  test "due lists pending windows that have ended" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+      assert_not_includes Notification::Bundle.due, bundle
+
+      travel 4.hours
+      assert_includes Notification::Bundle.due, bundle
+
+      bundle.update!(delivered_at: Time.current)
+      assert_not_includes Notification::Bundle.due, bundle
+    end
+  end
+
+  test "deliver marks the window delivered and emails its notifications once" do
+    bundle = bundle_with_notifications
+
+    assert_enqueued_emails 1 do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+  end
+
+  test "deliver skips the email when the window is empty" do
+    bundle = Notification::Bundle.window_for(@user, Time.current)
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email when the person turned bundles off in the meantime" do
+    bundle = bundle_with_notifications
+    @user.settings.update_columns(bundle_email_frequency: "never")
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email for deactivated people" do
+    bundle = bundle_with_notifications
+    @user.deactivate
+
+    assert_no_enqueued_emails do
+      bundle.reload.deliver
+    end
+  end
+
+  test "deliver_all_due enqueues delivery for due windows only" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      due = bundle_with_notifications
+
+      travel 4.hours
+      pending = Notification::Bundle.window_for(users(:david), Time.current)
+
+      assert_enqueued_jobs 1, only: Notification::Bundle::DeliveryJob do
+        Notification::Bundle.deliver_all_due
+      end
+
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ due ])
+      assert pending.reload.pending?
+    end
+  end
+
+  test "deliver_all_due delivers the email end to end" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = bundle_with_notifications
+
+      travel 4.hours
+
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+
+      assert bundle.reload.delivered?
+      assert_equal [ "kevin@37signals.com" ], ActionMailer::Base.deliveries.last.to
+    end
+  end
+
+  test "reschedule adjusts the window to the new frequency" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      bundle = Notification::Bundle.window_for(@user, Time.current)
+
+      @user.settings.update!(bundle_email_frequency: "weekly")
+      assert_equal Time.utc(2026, 9, 14, 10, 0), bundle.reload.ends_at
+
+      @user.settings.update!(bundle_email_frequency: "daily")
+      assert_equal Time.utc(2026, 9, 8, 10, 0), bundle.reload.ends_at
+    end
+  end
+
+  test "reschedule drops the pending window when bundles are turned off" do
+    bundle = bundle_with_notifications
+    notification = bundle.notifications.first
+
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_raises(ActiveRecord::RecordNotFound) { bundle.reload }
+    assert_nil notification.reload.bundle
+  end
+
+  test "destroying a person removes their windows" do
+    bundle_with_notifications
+
+    assert_difference -> { Notification::Bundle.count }, -1 do
+      @user.destroy
+    end
+  end
+
+  private
+    def bundle_with_notifications
+      Notification::Bundle.window_for(@user, Time.current).tap do |bundle|
+        @user.notifications.create!(source: events(:layout_published), creator: users(:jason), bundle: bundle)
+        @user.notifications.create!(source: events(:logo_published), creator: users(:jason), bundle: bundle)
+      end
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..003aa0f
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,168 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "bundle_later is called after notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      create_notification(events(:layout_published))
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    notification = create_notification(events(:layout_published))
+
+    assert_enqueued_with(job: Notification::BundleJob, args: [ notification ]) do
+      notification.update!(source: events(:layout_commented))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    notification = create_notification(events(:layout_published))
+
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      notification.read
+    end
+  end
+
+  test "bundle_now files the notification in the person's current window" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      first = create_notification(events(:layout_published))
+      first.bundle_now
+
+      assert_equal Time.utc(2026, 9, 7, 10, 0), first.bundle.starts_at
+      assert_equal Time.utc(2026, 9, 7, 14, 0), first.bundle.ends_at
+
+      travel 2.hours
+      second = create_notification(events(:logo_published))
+      second.bundle_now
+
+      assert_equal first.bundle, second.bundle
+      assert_equal 1, @user.notification_bundles.count
+    end
+  end
+
+  test "bundle_now files late notifications in the window that has already opened" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      first = create_notification(events(:layout_published))
+      first.bundle_now
+
+      late = create_notification(events(:logo_published), created_at: 30.minutes.ago, updated_at: 30.minutes.ago)
+      late.bundle_now
+
+      assert_equal first.bundle, late.bundle
+      assert_equal Time.utc(2026, 9, 7, 10, 0), first.bundle.reload.starts_at
+    end
+  end
+
+  test "bundle_now opens a new window after the previous one ended" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      first = create_notification(events(:layout_published))
+      first.bundle_now
+
+      travel 4.hours + 1.minute
+      second = create_notification(events(:logo_published))
+      second.bundle_now
+
+      assert_not_equal first.bundle, second.bundle
+      assert_equal Time.utc(2026, 9, 7, 14, 1), second.bundle.starts_at
+    end
+  end
+
+  test "bundle_now moves a re-notified notification into the current window" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      notification = create_notification(events(:layout_published))
+      notification.bundle_now
+      first = notification.bundle
+      first.update!(delivered_at: 4.hours.from_now)
+
+      travel 5.hours
+      notification.update!(source: events(:layout_commented))
+      notification.bundle_now
+
+      assert_not_equal first, notification.bundle
+      assert_empty first.notifications
+      assert_equal Time.utc(2026, 9, 7, 15, 0), notification.bundle.starts_at
+    end
+  end
+
+  test "bundle_now does not broadcast the notification again" do
+    notification = create_notification(events(:layout_published))
+
+    broadcasts = capture_turbo_stream_broadcasts [ @user, :notifications ] do
+      perform_enqueued_jobs only: Notification::BundleJob do
+        notification.bundle_now
+      end
+    end
+
+    assert_empty broadcasts
+  end
+
+  test "bundle_now skips people who don't want bundle emails" do
+    @user.settings.update!(bundle_email_frequency: "never")
+    notification = create_notification(events(:layout_published))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.bundle_now
+    end
+
+    assert_nil notification.bundle
+  end
+
+  test "bundle_now skips notifications from the system user" do
+    notification = create_notification(events(:layout_published), creator: users(:system))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.bundle_now
+    end
+  end
+
+  test "bundle_now skips cancelled accounts" do
+    notification = create_notification(events(:layout_published))
+    @user.account.cancel(initiated_by: users(:david))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      notification.bundle_now
+    end
+  end
+
+  test "notifications created by the notifier end up bundled" do
+    Current.user = users(:david)
+    cards(:logo).watch_by(@user)
+
+    perform_enqueued_jobs only: [ NotifyRecipientsJob, Notification::BundleJob ] do
+      cards(:logo).comments.create!(body: "Great work on this!", creator: users(:david))
+    end
+
+    notification = @user.notifications.find_by!(card: cards(:logo))
+    assert notification.bundle.present?
+    assert notification.bundle.pending?
+  end
+
+  test "windows for a person never overlap even when notifications land out of order" do
+    travel_to Time.utc(2026, 9, 7, 10, 0) do
+      offsets = [ 0, 30.minutes, -45.minutes, 4.hours + 10.minutes, 3.hours ]
+      sources = events(:layout_published, :logo_published, :buy_domain_sent_back_to_triage, :text_published, :shipping_published)
+
+      offsets.zip(sources).each do |offset, source|
+        landed_at = Time.current + offset
+        create_notification(source, created_at: landed_at, updated_at: landed_at).bundle_now
+      end
+
+      windows = @user.notification_bundles.chronologically.to_a
+      assert_operator windows.size, :>=, 2
+      windows.each_cons(2) do |earlier, later|
+        assert_operator earlier.ends_at, :<=, later.starts_at
+      end
+    end
+  end
+
+  private
+    def create_notification(source, creator: users(:jason), **attributes)
+      @user.notifications.create!(source: source, creator: creator, **attributes)
+    end
+end
