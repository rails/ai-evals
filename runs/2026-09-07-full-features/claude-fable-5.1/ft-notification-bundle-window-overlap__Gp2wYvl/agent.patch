diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..0af770f
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,60 @@
+# A time window that batches a person's notifications, so they get one email per window
+# instead of one per notification. The window opens when the first notification lands and
+# stays open for as long as the person's +bundle_email_frequency+ dictates.
+class Notification::Bundle < ApplicationRecord
+  include Deliverable
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :chronologically, -> { order(:starts_at) }
+
+  before_validation :set_ends_at, on: :create
+
+  validates :starts_at, presence: true
+  validates :ends_at, comparison: { greater_than: :starts_at }
+
+  class << self
+    # Returns the window a notification that landed at +time+ belongs to, opening a new one
+    # when necessary. A person never has two overlapping windows: a late notification landing
+    # before the pending window opened still belongs to it, and a new window can't open before
+    # the previous one has ended.
+    #
+    # Callers are expected to hold a lock on the user to serialize concurrent openings.
+    def window_for(user, time)
+      latest = user.notification_bundles.order(ends_at: :desc).first
+
+      if latest&.pending? && time < latest.ends_at
+        latest
+      else
+        user.notification_bundles.create! starts_at: [ time, latest&.ends_at ].compact.max
+      end
+    end
+  end
+
+  def pending?
+    delivered_at.nil?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def reschedule
+    if user.settings.bundles_emails?
+      update! ends_at: starts_at + user.settings.bundle_email_window
+    else
+      destroy
+    end
+  end
+
+  private
+    def set_ends_at
+      if starts_at.present? && user.settings&.bundle_email_window.present?
+        self.ends_at ||= starts_at + user.settings.bundle_email_window
+      end
+    end
+end
diff --git a/app/models/notification/bundle/deliverable.rb b/app/models/notification/bundle/deliverable.rb
new file mode 100644
index 0000000..60cb4a5
--- /dev/null
+++ b/app/models/notification/bundle/deliverable.rb
@@ -0,0 +1,38 @@
+module Notification::Bundle::Deliverable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :due, -> { pending.where(ends_at: ..Time.current) }
+  end
+
+  class_methods do
+    def deliver_all_due
+      due.find_each do |bundle|
+        Current.with_account(bundle.account) { bundle.deliver_later }
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  # Each window is delivered exactly once, even if delivery is attempted concurrently.
+  def deliver
+    with_lock do
+      if pending?
+        update! delivered_at: Time.current
+        Notification::BundleMailer.digest(self).deliver_later if emailable?
+      end
+    end
+  end
+
+  private
+    def emailable?
+      notifications.exists? && user.settings.bundles_emails? && recipient_reachable?
+    end
+
+    def recipient_reachable?
+      user.active? && user.identity.present? && account.active?
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..3abbfc8
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,30 @@
+# Files each notification into the person's current email window (see Notification::Bundle),
+# so they get a single digest per window rather than an email per notification.
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_later, if: :source_id_previously_changed?
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  # Notifications are reused per card, so +updated_at+ is when this one last landed. Bundling
+  # only touches the bundle column: the person's tray shouldn't be re-broadcast because of it.
+  def bundle_now
+    if bundleable?
+      user.with_lock do
+        update_columns bundle_id: Notification::Bundle.window_for(user, updated_at).id
+      end
+    end
+  end
+
+  private
+    def bundleable?
+      !creator.system? && user.active? && account.active? && user.settings.bundles_emails?
+    end
+end
