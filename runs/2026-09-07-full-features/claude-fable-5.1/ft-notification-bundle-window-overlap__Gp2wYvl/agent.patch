+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundle emails go out every few hours by default" do
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert @settings.bundles_emails?
+    assert_equal 4.hours, @settings.bundle_email_window
+  end
+
+  test "bundle email windows follow the frequency" do
+    @settings.update!(bundle_email_frequency: "daily")
+    assert_equal 1.day, @settings.bundle_email_window
+
+    @settings.update!(bundle_email_frequency: "weekly")
+    assert_equal 1.week, @settings.bundle_email_window
+  end
+
+  test "never turns bundle emails off" do
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_not @settings.bundles_emails?
+    assert_nil @settings.bundle_email_window
+  end
+
+  test "unknown frequencies are invalid" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+  end
+end
