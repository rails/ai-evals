@@ -0,0 +1,34 @@
+<h1 class="title"><%= @account.name %></h1>
+<p class="subtitle">Here’s what you missed since <%= @bundle.starts_at.in_time_zone(@user.timezone).strftime("%B %-d at %-l:%M %p") %>.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each_with_index do |(board, notifications), index| %>
+  <% if index.positive? %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+        <td>
+          <p class="card__title"><%= link_to payload.title, payload.url %></p>
+          <p class="notification__details">
+            <% if notification.source.is_a?(Mention) %>
+              <mark class="notificaton__mention"><%= notification.creator.first_name %> @mentioned you</mark>
+            <% end %>
+            <%= payload.body %>
+          </p>
+          <p class="notification__author"><%= notification.creator.name %> · <%= notification.updated_at.in_time_zone(@user.timezone).strftime("%b %-d, %-l:%M %p") %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "See all your notifications", notifications_url %>.
+  You’re getting this email <%= @user.settings.bundle_email_frequency.humanize.downcase %> — <%= link_to "change how often", notifications_settings_url %>.
+</p>
