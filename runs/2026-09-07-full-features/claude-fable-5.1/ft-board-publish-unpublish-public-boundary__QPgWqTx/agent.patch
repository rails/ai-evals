+    tag.section(id: id, class: classes, tabindex: "0", "aria-selected": selected, data: data, **properties) do
+      tag.div(class: "cards__transition-container", data: { controller: "css-variable-counter", css_variable_counter_property_name_value: "--card-count" }, &block)
+    end
+  end
 end
