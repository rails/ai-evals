+<% comments = card.comments.by_user.preloaded.chronologically %>
+
+<% if comments.any? %>
+  <div id="<%= dom_id(card, :messages) %>" class="comments gap center" style="--card-color: <%= card.color %>" role="group" aria-label="Comments">
+    <% comments.each do |comment| %>
+      <div id="<%= dom_id(comment) %>" class="comment align-start full-width">
+        <figure class="comment__avatar flex-item-no-shrink" aria-hidden="true">
+          <%= avatar_preview_tag comment.creator, hidden_for_screen_reader: true %>
+        </figure>
+
+        <div class="comment__content flex flex-column flex-item-grow full-width">
+          <div class="comment__author flex align-center gap-half">
+            <h3 class="font-weight-normal txt-normal flex-item-justify-start min-width overflow-ellipsis">
+              <strong><%= comment.creator.name %></strong>
+
+              <span class="comment__permalink-title">
+                <%= local_datetime_tag comment.created_at, style: :agoorweekday %>,
+                <%= local_datetime_tag comment.created_at, style: :time %>
+              </span>
+            </h3>
+          </div>
+
+          <div class="comment__body lexxy-content" data-controller="syntax-highlight retarget-links">
+            <%= comment.body %>
+          </div>
+        </div>
+      </div>
+    <% end %>
+  </div>
+<% end %>
