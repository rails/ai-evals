diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..1b1f5db
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,29 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <% url = public_board_url(board.publication) %>
+      <p class="margin-none-block-start">Anyone with this secret link can see the cards on this board, without signing in.</p>
+
+      <div class="flex align-center gap-half margin-block-end-half">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public link">
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+
+      <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative txt-small", form: { data: { turbo_confirm: "Are you sure? The public link will stop working." } } do %>
+        <span>Stop publishing this board</span>
+      <% end %>
+    <% else %>
+      <p class="margin-none-block-start">Publish this board to get a secret link that lets anyone see it, without signing in.</p>
+
+      <%= button_to board_publication_path(board), method: :post, class: "btn txt-small" do %>
+        <%= icon_tag "globe" %>
+        <span>Publish this board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
