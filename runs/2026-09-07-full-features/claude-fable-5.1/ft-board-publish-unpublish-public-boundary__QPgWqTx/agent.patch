diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..1f89e44
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key" do
+    @board.publish
+
+    assert @board.published?
+    assert_equal Board::Publication::KEY_LENGTH, @board.publication.key.length
+    assert_equal @board.account, @board.publication.account
+  end
+
+  test "publish is idempotent" do
+    @board.publish
+    key = @board.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublish removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_not @board.reload.published?
+  end
+
+  test "unpublish when not published" do
+    assert_nothing_raised { @board.unpublish }
+  end
+
+  test "publishing touches the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      @board.publish
+    end
+
+    assert_changes -> { @board.reload.updated_at } do
+      @board.unpublish
+    end
+  end
+
+  test "public cards only include published cards" do
+    draft = @board.cards.create!(title: "Draft", creator: users(:david), status: "drafted")
+
+    assert_includes @board.public_cards, cards(:logo)
+    assert_not_includes @board.public_cards, draft
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+end
