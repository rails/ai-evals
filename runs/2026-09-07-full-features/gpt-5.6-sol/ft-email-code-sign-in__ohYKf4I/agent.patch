+class EmailCodesController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_email_code
+
+  layout "public"
+
+  def show
+  end
+
+  def create
+    if @email_code.consume(params.expect(:code))
+      complete_authentication
+    else
+      flash.now[:alert] = "That code is incorrect or has expired. Try again."
+      render :show, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def set_email_code
+      @email_code = EmailCode.find_signed!(params.expect(:id), purpose: :email_code)
+    end
+
+    def complete_authentication
+      identity = case @email_code.purpose
+      when "sign_in"
+        Identity.find_by(email_address: @email_code.email_address)
+      when "signup", "join"
+        Identity.find_or_create_by!(email_address: @email_code.email_address)
+      end
+
+      unless identity
+        flash.now[:alert] = "We couldn't sign you in with that email address."
+        return render :show, status: :unprocessable_entity
+      end
+
+      start_new_session_for(identity)
+
+      case @email_code.purpose
+      when "sign_in"
+        redirect_to after_authentication_url
+      when "signup"
+        redirect_to new_signup_completion_path
+      when "join"
+        complete_join(identity)
+      end
+    end
+
+    def complete_join(identity)
+      join_code = @email_code.join_code
+      join_code.redeem_if { |account| identity.join(account) }
+
+      if user = User.active.find_by(account: join_code.account, identity: identity)
+        if user.setup?
+          redirect_to landing_url(script_name: join_code.account.slug)
+        else
+          redirect_to new_users_verification_url(script_name: join_code.account.slug)
+        end
+      else
+        redirect_to join_url(code: join_code.code, script_name: join_code.account.slug), alert: "That join code is no longer available."
+      end
+    end
+end
