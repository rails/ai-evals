+require "test_helper"
+
+class EmailCodeMailerTest < ActionMailer::TestCase
+  test "verification puts the code in the subject and body" do
+    email_code = EmailCode.issue(email_address: "person@example.com", purpose: :sign_in)
+    email = EmailCodeMailer.verification(email_code, email_code.code)
+
+    assert_equal [ "person@example.com" ], email.to
+    assert_includes email.subject, email_code.code
+    assert_includes email.body.encoded, email_code.code
+    assert_match(/15 minutes/, email.body.encoded)
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
