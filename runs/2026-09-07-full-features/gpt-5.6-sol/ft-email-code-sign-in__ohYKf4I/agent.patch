diff --git a/test/controllers/email_codes_controller_test.rb b/test/controllers/email_codes_controller_test.rb
new file mode 100644
index 0000000..9660991
--- /dev/null
+++ b/test/controllers/email_codes_controller_test.rb
@@ -0,0 +1,139 @@
+require "test_helper"
+
+class EmailCodesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionMailer::Base.deliveries.clear
+  end
+
+  test "sign in sends a six-character code and verifies it" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_difference -> { EmailCode.count }, 1 do
+        assert_emails 1 do
+          post session_path, params: { email_address: identity.email_address }
+        end
+      end
+
+      email_code = EmailCode.order(:created_at).last
+      mail = ActionMailer::Base.deliveries.last
+      code = mail.subject[/\b[A-Z0-9]{6}\b/]
+
+      assert_equal [ identity.email_address ], mail.to
+      assert code, "expected the six-character code in the subject"
+      assert_redirected_to email_code_path(email_code.signed_id(purpose: :email_code))
+
+      follow_redirect!
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: code }
+      assert_redirected_to landing_url
+      assert cookies[:session_token].present?
+      assert email_code.reload.consumed?
+    end
+  end
+
+  test "a wrong code does not authenticate and can be retried" do
+    email_code = EmailCode.issue(email_address: identities(:kevin).email_address, purpose: :sign_in)
+
+    untenanted do
+      post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: "WRONG1" }
+
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+      assert_not email_code.reload.consumed?
+    end
+  end
+
+  test "a code expires after fifteen minutes" do
+    email_code = EmailCode.issue(email_address: identities(:kevin).email_address, purpose: :sign_in)
+    code = email_code.code
+
+    travel 15.minutes + 1.second do
+      untenanted do
+        post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: code }
+
+        assert_response :unprocessable_entity
+        assert_not cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "a code can only be used once" do
+    email_code = EmailCode.issue(email_address: identities(:kevin).email_address, purpose: :sign_in)
+
+    untenanted do
+      post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: email_code.code }
+      Session.delete_all
+      cookies.delete :session_token
+      assert_no_difference -> { Session.count } do
+        post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: email_code.code }
+      end
+
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "signup verifies the email, creates an identity, and continues signup" do
+    email_address = "brand-new@example.com"
+
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        perform_enqueued_jobs do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      email_code = EmailCode.order(:created_at).last
+      code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+      assert_difference -> { Identity.count }, 1 do
+        post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: code }
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert_equal email_address, Identity.order(:created_at).last.email_address
+      assert cookies[:session_token].present?
+    end
+  end
+
+test "an exhausted join code is handled while verification is in flight" do
+  join_code = account_join_codes(:"37s")
+  email_code = EmailCode.issue(email_address: "late-member@example.com", purpose: :join, join_code: join_code)
+  join_code.update!(usage_count: join_code.usage_limit)
+
+  untenanted do
+    assert_no_difference -> { User.count } do
+      post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: email_code.code }
+    end
+  end
+
+  assert_redirected_to join_url(code: join_code.code, script_name: join_code.account.slug)
+end
+
+  test "join verifies the email, creates a user, and continues setup" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+    email_address = "new-member@example.com"
+
+    assert_no_difference -> { User.count } do
+      perform_enqueued_jobs do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+      end
+    end
+
+    email_code = EmailCode.order(:created_at).last
+    assert_equal join_code, email_code.join_code
+    code = ActionMailer::Base.deliveries.last.subject[/\b[A-Z0-9]{6}\b/]
+
+    assert_difference -> { Identity.count }, 1 do
+      assert_difference -> { User.count }, 1 do
+        untenanted do
+          post email_code_path(email_code.signed_id(purpose: :email_code)), params: { code: code }
+        end
+      end
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+  end
+end
