diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..db9cfbd
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,52 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+  CODE_LENGTH = 6
+  PURPOSES = %w[ sign_in signup join ].freeze
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  has_secure_password :code, validations: false
+
+  attr_reader :code
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code_digest, :expires_at, presence: true
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :join_code, presence: true, if: -> { purpose == "join" }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  scope :active, -> { where(consumed_at: nil).where("expires_at > ?", Time.current) }
+
+  def self.issue(email_address:, purpose:, join_code: nil)
+    new(email_address: email_address, purpose: purpose, join_code: join_code, expires_at: LIFETIME.from_now).tap do |email_code|
+      email_code.code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      email_code.save!
+    end
+  end
+
+  def code=(value)
+    @code = value
+    self.code_digest = BCrypt::Password.create(value)
+  end
+
+  def consume(candidate)
+    with_lock do
+      return false if consumed? || expired? || !code_matches?(candidate)
+
+      update!(consumed_at: Time.current)
+    end
+  end
+
+  def consumed?
+    consumed_at.present?
+  end
+
+  def expired?
+    expires_at <= Time.current
+  end
+
+  private
+    def code_matches?(candidate)
+      candidate.present? && BCrypt::Password.new(code_digest).is_password?(candidate.to_s.upcase)
+    end
+end
