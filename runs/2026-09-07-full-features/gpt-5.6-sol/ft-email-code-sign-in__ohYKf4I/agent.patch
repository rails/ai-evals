@@ -0,0 +1,21 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issue creates a six-character code valid for fifteen minutes" do
+    freeze_time do
+      email_code = EmailCode.issue(email_address: " Person@Example.com ", purpose: :sign_in)
+
+      assert_match(/\A[A-Z0-9]{6}\z/, email_code.code)
+      assert_equal "person@example.com", email_code.email_address
+      assert_equal 15.minutes.from_now, email_code.expires_at
+      assert_not_includes email_code.code_digest, email_code.code
+    end
+  end
+
+  test "consume is case insensitive and single use" do
+    email_code = EmailCode.issue(email_address: "person@example.com", purpose: :signup)
+
+    assert email_code.consume(email_code.code.downcase)
+    assert_not email_code.consume(email_code.code)
+  end
+end
