+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+  <p>We sent a six-character code to <strong><%= @email_code.email_address %></strong>. It expires in 15 minutes.</p>
+
+  <%= form_with url: email_code_path(@email_code.signed_id(purpose: :email_code)), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <label class="flex align-center gap input input--actor">
+      <%= form.text_field :code, required: true, maxlength: EmailCode::CODE_LENGTH, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", placeholder: "Six-character code" %>
+    </label>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
