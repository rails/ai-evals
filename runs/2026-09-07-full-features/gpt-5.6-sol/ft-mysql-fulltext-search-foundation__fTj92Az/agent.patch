@@ -0,0 +1,12 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search if @query.present?
+  end
+
+  private
+    def search
+      Current.user.accessible_cards.published.matching(@query).reverse_chronologically
+        .preload(:board, :rich_text_description, comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..323d7ff
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,13 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    pattern = /#{Regexp.escape(query)}/i
+
+    safe_join(text.to_s.split(pattern, -1).zip(text.to_s.scan(pattern)).flat_map do |before, match|
+      [ before, (tag.mark(match) if match) ]
+    end.compact)
+  end
+
+  def search_match?(text, query)
+    text.to_s.match?(/#{Regexp.escape(query)}/i)
+  end
+end
