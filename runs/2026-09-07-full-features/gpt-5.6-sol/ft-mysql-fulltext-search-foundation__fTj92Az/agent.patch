diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f5c3069
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    with_current_user :kevin do
+      @older = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title: "A searchable title", created_at: 2.days.ago
+      )
+      @newer = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title: "Newest card", description: "A SEARCHABLE description", created_at: 1.day.ago
+      )
+      @newer.comments.create!(creator: users(:kevin), body: "First searchable comment")
+      @newer.comments.create!(creator: users(:kevin), body: "Another searchable comment")
+      @comment_match = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title: "Middle card", created_at: 36.hours.ago
+      )
+      @comment_match.comments.create!(creator: users(:kevin), body: "Only this comment is searchable")
+
+      @draft = boards(:writebook).cards.create!(
+        creator: users(:kevin), status: :published, title: "Searchable draft", description: "Searchable draft description"
+      )
+      @draft.comments.create!(creator: users(:kevin), body: "Searchable draft comment")
+      @draft.update!(status: :drafted)
+    end
+  end
+
+  test "finds published cards by title, description, or comment newest first without duplicates" do
+    get search_path, params: { q: "searchable" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 3
+    assert_select "[data-search-result]" do |results|
+      assert_equal [ @newer.number.to_s, @comment_match.number.to_s, @older.number.to_s ], results.map { |result| result["data-card-number"] }
+    end
+    assert_select "mark", text: /searchable/i, minimum: 2
+    assert_select "[data-card-number=?]", @draft.number.to_s, count: 0
+  end
+
+  test "only returns cards from boards the user can currently access" do
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "searchable" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+
+  test "treats query metacharacters as literal text and safely highlights them" do
+    @newer.update!(title: "Use <script> carefully")
+
+    get search_path, params: { q: "<script>" }
+
+    assert_response :success
+    assert_select "[data-card-number=?]", @newer.number.to_s
+    assert_select "mark", text: "<script>"
+    assert_select "[data-card-number=?]", @newer.number.to_s do
+      assert_select "script", count: 0
+    end
+  end
+
+  test "treats SQL wildcard characters as literal text" do
+    @newer.update!(title: "Complete 100% of this")
+
+    get search_path, params: { q: "%" }
+
+    assert_select "[data-search-result]", count: 1
+    assert_select "mark", text: "%"
+  end
+
+  test "shows an empty search page for a blank query" do
+    get search_path, params: { q: "" }
+
+    assert_response :success
+    assert_select "[data-search-result]", count: 0
+  end
+end
