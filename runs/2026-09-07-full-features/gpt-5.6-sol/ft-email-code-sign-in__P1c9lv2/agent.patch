+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end"><%= @page_title %></h1>
+
+  <%= form_with url: @email_code_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <label class="flex align-center gap input input--actor">
+      <%= form.text_field :code, required: true, class: "input txt-large full-width txt-align-center", autofocus: true,
+            autocomplete: "one-time-code", inputmode: "text", maxlength: EmailCode::LENGTH, pattern: "[A-Za-z0-9]{6}", placeholder: "6-character code" %>
