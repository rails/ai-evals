+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "generates a six-character alphanumeric code" do
+    email_code = EmailCode.generate(email_address: " Person@Example.com ", purpose: :sign_in)
+
+    assert_match(/\A[A-Z0-9]{6}\z/, email_code.code)
+    assert_equal "person@example.com", email_code.email_address
+  end
+
+  test "verifies a code case insensitively for fifteen minutes" do
+    email_code = EmailCode.generate(email_address: "person@example.com", purpose: :sign_in)
+    token = email_code.token
+
+    assert EmailCode.verify(token, code: email_code.code.downcase, purpose: :sign_in)
+
+    travel_to(EmailCode::EXPIRATION.from_now + 1.second) do
+      assert_nil EmailCode.verify(token, code: email_code.code, purpose: :sign_in)
+    end
+  end
+
+  test "does not verify the wrong code or purpose" do
+    email_code = EmailCode.generate(email_address: "person@example.com", purpose: :sign_in)
+    token = email_code.token
+
+    assert_nil EmailCode.verify(token, code: "WRONG1", purpose: :sign_in)
+    assert_nil EmailCode.verify(token, code: email_code.code, purpose: :sign_up)
+  end
+end
