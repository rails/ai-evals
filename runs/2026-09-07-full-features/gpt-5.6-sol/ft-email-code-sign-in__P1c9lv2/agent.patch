new file mode 100644
index 0000000..0b24d1b
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,22 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_email_code(email_address, purpose:)
+      EmailCode.generate(email_address: email_address, purpose: purpose).tap do |email_code|
+        session[:email_code_token] = email_code.token
+        email_code.deliver_later
+      end
+    end
+
+    def verify_email_code(purpose:)
+      EmailCode.verify(session[:email_code_token], code: params.expect(:code), purpose: purpose).tap do |email_code|
+        session.delete(:email_code_token) if email_code
+      end
+    end
+
+    def invalid_email_code
+      flash.now[:alert] = "That code didn't work. Check the code and try again."
+      render "email_codes/new", status: :unprocessable_entity
+    end
+end
