diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..15b7d47
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,48 @@
+class EmailCode
+  EXPIRATION = 15.minutes
+  LENGTH = 6
+  ALPHABET = ("A".."Z").to_a + ("0".."9").to_a
+
+  attr_reader :code, :email_address
+
+  def self.generate(email_address:, purpose:)
+    new(
+      email_address: Identity.new(email_address: email_address).email_address,
+      code: Array.new(LENGTH) { ALPHABET[SecureRandom.random_number(ALPHABET.length)] }.join,
+      purpose: purpose
+    )
+  end
+
+  def self.verify(token, code:, purpose:)
+    if (attributes = verifier.verified(token, purpose: purpose)) && Time.current < Time.zone.at(attributes.fetch("expires_at"))
+      candidate = code.to_s.strip.upcase
+
+      if candidate.bytesize == LENGTH && ActiveSupport::SecurityUtils.secure_compare(candidate, attributes.fetch("code"))
+        new(email_address: attributes.fetch("email_address"), code: candidate, purpose: purpose)
+      end
+    end
+  end
+
+  def self.verifier
+    Rails.application.message_verifier(:email_code)
+  end
+  private_class_method :verifier
+
+  def initialize(email_address:, code:, purpose:)
+    @email_address = email_address
+    @code = code
+    @purpose = purpose
+  end
+
+  def token
+    self.class.send(:verifier).generate(
+      { email_address: email_address, code: code, expires_at: EXPIRATION.from_now.to_f },
+      expires_in: EXPIRATION,
+      purpose: @purpose
+    )
+  end
+
+  def deliver_later
+    IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+  end
+end
