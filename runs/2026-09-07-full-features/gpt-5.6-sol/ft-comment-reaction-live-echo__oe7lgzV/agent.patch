+<%= form_with model: [ comment.card, comment, reaction ],
+      id: dom_id(comment, :new_reaction), class: "reaction__form",
+      data: { reaction_form_target: "form", action: "turbo:submit-end->reaction-form#submitted" } do |form| %>
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-form-target="trigger" data-action="reaction-form#open">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <div data-reaction-form-target="fields" hidden>
+    <%= form.label :content, "Reaction", class: "for-screen-reader" %>
+    <%= form.text_field :content, maxlength: 16, required: true, autocomplete: "off",
+          class: "reaction__input input txt-small", data: { reaction_form_target: "input" },
+          aria: { invalid: reaction.errors.any? } %>
+    <button type="submit" class="reaction__submit-btn btn btn--circle borderless">
+      <%= icon_tag "check" %><span class="for-screen-reader">Confirm reaction</span>
+    </button>
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reaction-form#cancel">
+      <%= icon_tag "close" %><span class="for-screen-reader">Cancel reaction</span>
+    </button>
+  </div>
+<% end %>
