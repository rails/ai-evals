diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..93b0184
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  delegate :card, to: :comment
+
+  private
+    def broadcast_creation
+      broadcast_append_to card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/reactions/reaction"
+    end
+
+    def broadcast_removal
+      broadcast_remove_to card
+    end
+end
