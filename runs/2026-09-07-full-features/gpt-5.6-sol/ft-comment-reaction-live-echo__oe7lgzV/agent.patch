+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,52 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def create
+    @reaction = @comment.reactions.create(reaction_params)
+
+    if @reaction.persisted?
+      render turbo_stream: turbo_stream.replace(
+        [ @comment, :new_reaction ],
+        partial: "cards/reactions/form",
+        locals: { comment: @comment, reaction: @comment.reactions.new }
+      )
+    else
+      render turbo_stream: turbo_stream.replace(
+        [ @comment, :new_reaction ],
+        partial: "cards/reactions/form",
+        locals: { comment: @comment, reaction: @reaction }
+      ), status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    head :no_content
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
