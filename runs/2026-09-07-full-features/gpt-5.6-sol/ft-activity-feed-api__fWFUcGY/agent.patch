diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..247e38f
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible timeline activity newest first" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    older = create_event("card_title_changed", card, creator: users(:david), particulars: { particulars: { old_title: nil, new_title: "Renamed" } }, created_at: 2.minutes.ago)
+    newer = create_event("comment_created", comment, creator: users(:kevin), created_at: 1.minute.ago)
+    deprecated = create_event("card_collection_changed", card, created_at: Time.current)
+    create_event("card_resumed", card, created_at: Time.current)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_equal [ newer.id, older.id ], body.first(2).pluck("id")
+    assert_not_includes body.pluck("id"), deprecated.id
+
+    title_change = body.find { |activity| activity["id"] == older.id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], title_change.keys.sort
+    assert_equal "card_title_changed", title_change["action"]
+    assert_equal "Card", title_change["eventable_type"]
+    assert_equal({ "old_title" => "", "new_title" => "Renamed" }, title_change["particulars"])
+    assert_equal older.description_for(users(:kevin)).to_plain_text, title_change["description"]
+    assert_equal card_url(card), title_change["url"]
+    assert_equal card.id, title_change.dig("eventable", "id")
+    assert_equal card.board.id, title_change.dig("board", "id")
+    assert_equal users(:david).id, title_change.dig("creator", "id")
+
+    comment_activity = body.find { |activity| activity["id"] == newer.id }
+    assert_equal comment.id, comment_activity.dig("eventable", "id")
+    assert_equal card_url(card, anchor: dom_id(comment)), comment_activity["url"]
+    assert_equal({}, comment_activity["particulars"])
+  end
+
+test "index exposes event-specific particulars and empty missing strings" do
+  assignment = create_event("card_assigned", cards(:logo), particulars: { assignee_ids: [ users(:jz).id ] })
+  board_change = create_event("card_board_changed", cards(:logo), particulars: { particulars: { old_board: "Old" } })
+  triage = create_event("card_sent_back_to_triage", cards(:logo))
+
+  get activities_path(format: :json)
+
+  assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity_json(assignment)["particulars"])
+  assert_equal({ "old_board" => "Old", "new_board" => "" }, activity_json(board_change)["particulars"])
+  assert_equal({ "column" => "" }, activity_json(triage)["particulars"])
+end
+
+test "index follows API pagination conventions" do
+  16.times { create_event("card_published", cards(:logo)) }
+
+  get activities_path(format: :json)
+
+  assert_equal 15, @response.parsed_body.size
+  assert_match(/rel="next"/, @response.headers["Link"])
+end
+
+  test "index filters by creators and boards" do
+    matching = create_event("card_published", cards(:logo), creator: users(:david))
+    create_event("card_published", cards(:text), creator: users(:kevin))
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ]
+    }
+
+    assert_response :success
+    assert_includes @response.parsed_body.pluck("id"), matching.id
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:david).id }
+    assert @response.parsed_body.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "index excludes activity on inaccessible boards" do
+    board = boards(:private)
+    board.accesses.revoke_from users(:kevin)
+    inaccessible = create_event("card_published", board.cards.create!(title: "Secret", creator: users(:jason), status: :drafted), board: board)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.pluck("id"), inaccessible.id
+  end
+
+  private
+    def activity_json(event)
+      @response.parsed_body.find { |activity| activity["id"] == event.id }
+    end
+
+    def create_event(action, eventable, creator: users(:kevin), board: eventable.try(:board) || eventable.card.board, particulars: {}, created_at: Time.current)
+      Event.create!(action:, eventable:, creator:, board:, particulars:, created_at:)
+    end
+end
