diff --git a/app/models/event/activitable.rb b/app/models/event/activitable.rb
new file mode 100644
index 0000000..fc33906
--- /dev/null
+++ b/app/models/event/activitable.rb
@@ -0,0 +1,46 @@
+module Event::Activitable
+  extend ActiveSupport::Concern
+
+  ACTIVITABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ]
+
+  included do
+    scope :activitable, -> { where(action: ACTIVITABLE_ACTIONS) }
+  end
+
+  def activity_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(activity_particular(:assignee_ids)) }
+    when "card_board_changed"
+      string_particulars(:old_board, :new_board)
+    when "card_title_changed"
+      string_particulars(:old_title, :new_title)
+    when "card_triaged", "card_sent_back_to_triage"
+      string_particulars(:column)
+    else
+      {}
+    end
+  end
+
+  private
+    def string_particulars(*names)
+      names.index_with { |name| activity_particular(name).to_s }
+    end
+
+    def activity_particular(name)
+      particulars.dig("particulars", name.to_s) || particulars[name.to_s]
+    end
+end
