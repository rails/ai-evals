@@ -0,0 +1,58 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:david).push_subscriptions.build(
+      endpoint: "https://push.example.test/one", p256dh_key: "p256dh", auth_key: "auth"
+    )
+  end
+
+  test "requires complete subscription details" do
+    assert @subscription.valid?
+
+    @subscription.endpoint = nil
+    assert_not @subscription.valid?
+  end
+
+  test "requires an HTTPS endpoint" do
+    @subscription.endpoint = "http://push.example.test/one"
+
+    assert_not @subscription.valid?
+  end
+
+  test "delivers tray content and card URL" do
+    notification = notifications(:logo_mentioned_david)
+    WebPush.expects(:payload_send).with do |attributes|
+      payload = JSON.parse(attributes[:message])
+      attributes[:endpoint] == @subscription.endpoint &&
+        attributes[:p256dh] == @subscription.p256dh_key &&
+        attributes[:auth] == @subscription.auth_key &&
+        payload["title"] == "JZ @mentioned you" &&
+        payload["body"].present? &&
+        payload["url"].end_with?("/cards/#{notification.card.to_param}")
+    end
+
+    with_vapid_keys { @subscription.deliver(notification) }
+  end
+
+  test "removes an expired subscription" do
+    @subscription.save!
+    response = Struct.new(:code, :body).new("410", "Gone")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.test"))
+
+    with_vapid_keys { @subscription.deliver(notifications(:logo_mentioned_david)) }
+
+    assert_not @subscription.persisted?
+  end
+
+  private
+    def with_vapid_keys
+      old_public, old_private = ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY")
+      ENV["VAPID_PUBLIC_KEY"] = "public"
+      ENV["VAPID_PRIVATE_KEY"] = "private"
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"] = old_public
+      ENV["VAPID_PRIVATE_KEY"] = old_private
+    end
+end
