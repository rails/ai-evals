+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers a device for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "https://push.example.test/one", p256dh_key: "p256dh", auth_key: "auth" }
+      }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.test/one", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+  end
+
+  test "create refreshes keys when the endpoint is already registered" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/one", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: "new-p256dh", auth_key: "new-auth" }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal [ "new-p256dh", "new-auth" ], subscription.reload.values_at(:p256dh_key, :auth_key)
+  end
+
+  test "create transfers an existing browser endpoint to the current user" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.test/shared", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: "new", auth_key: "new" }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal @user, subscription.reload.user
+  end
+
+  test "create rejects another user's subscription" do
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: { endpoint: "https://push.example.test/one", p256dh_key: "p256dh", auth_key: "auth" }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy unregisters the current device by endpoint" do
+    @user.push_subscriptions.create!(endpoint: "https://push.example.test/one", p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { endpoint: "https://push.example.test/one" }, as: :json
+    end
+
+    assert_response :no_content
+  end
+end
