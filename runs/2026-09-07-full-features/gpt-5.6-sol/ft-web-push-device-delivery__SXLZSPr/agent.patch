+require "test_helper"
+
+class Notification::PushDeliveryJobTest < ActiveJob::TestCase
+  test "delivers to every device registered by the recipient" do
+    notification = notifications(:logo_mentioned_david)
+    notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/one", p256dh_key: "one", auth_key: "one")
+    notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/two", p256dh_key: "two", auth_key: "two")
+
+    PushSubscription.any_instance.expects(:deliver).with(notification).twice
+
+    Notification::PushDeliveryJob.perform_now(notification)
+  end
+end
