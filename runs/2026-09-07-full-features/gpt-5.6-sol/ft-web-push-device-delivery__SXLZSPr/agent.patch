--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,25 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :ensure_current_user
+
+  def create
+    subscription = PushSubscription.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    created = subscription.new_record?
+    subscription.update!(subscription_params.merge(user: Current.user, account: Current.account))
+
+    head(created ? :created : :ok)
+  end
+
+  def destroy
+    Current.user.push_subscriptions.find_by(endpoint: params[:endpoint])&.destroy
+    head :no_content
+  end
+
+  private
+    def ensure_current_user
+      head :forbidden unless params[:user_id] == Current.user.id
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..8435fdb
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,95 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = { publicKey: String, url: String }
+
+  async connect() {
+    if (!this.supported) {
+      this.showHelp()
+      return
+    }
+
+    this.registration = await navigator.serviceWorker.ready
+    this.subscription = await this.registration.pushManager.getSubscription()
+    if (this.subscription) await this.save(this.subscription)
+    this.updateStatus()
+  }
+
+  async subscribe() {
+    if (!this.supported) {
+      this.showHelp()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+    if (permission === "granted") {
+      this.registration ||= await navigator.serviceWorker.ready
+      this.subscription = await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.decodeKey(this.publicKeyValue)
+      })
+      await this.save(this.subscription)
+      this.updateStatus()
+    } else {
+      this.showHelp()
+    }
+  }
+
+  async unsubscribe() {
+    if (this.subscription) {
+      const endpoint = this.subscription.endpoint
+      await this.subscription.unsubscribe()
+      await fetch(this.urlValue, {
+        method: "DELETE",
+        headers: this.headers,
+        body: JSON.stringify({ endpoint })
+      })
+      this.subscription = null
+      this.updateStatus()
+    }
+  }
+
+  get supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get headers() {
+    return {
+      "Content-Type": "application/json",
+      "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content
+    }
+  }
+
+  async save(subscription) {
+    const json = subscription.toJSON()
+    const response = await fetch(this.urlValue, {
+      method: "POST",
+      headers: this.headers,
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error("Unable to save push subscription")
+  }
+
+  updateStatus() {
+    this.element.classList.toggle("notifications--on", !!this.subscription)
+    if (Notification.permission === "denied") this.showHelp()
+  }
+
+  showHelp() {
+    this.detailsTargets.forEach((element) => element.hidden = false)
+  }
+
+  decodeKey(value) {
+    const padding = "=".repeat((4 - value.length % 4) % 4)
+    const base64 = (value + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+}
