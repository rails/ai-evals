@@ -84,4 +84,23 @@ class NotificationTest < ActiveSupport::TestCase
       notification.destroy
     end
   end
+
+test "push delivery is enqueued when a tray notification receives a new event" do
+  notification = notifications(:logo_assignment_kevin)
+  notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/one", p256dh_key: "key", auth_key: "auth")
+
+  assert_enqueued_with(job: Notification::PushDeliveryJob) do
+    notification.update!(source: events(:logo_published))
+  end
+end
+
+  test "push delivery is enqueued when a subscribed user's notification is created" do
+    user = users(:kevin)
+    user.push_subscriptions.create!(endpoint: "https://push.example.test/one", p256dh_key: "key", auth_key: "auth")
+    notification = user.notifications.build(source: events(:shipping_published), creator: users(:david), unread_count: 1)
+
+    assert_enqueued_with(job: Notification::PushDeliveryJob) do
+      notification.save!
+    end
