+++ b/app/models/notification/push_payload.rb
@@ -0,0 +1,38 @@
+class Notification::PushPayload
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def to_json(*)
+    {
+      title: title,
+      body: body,
+      url: card_path(notification.card, script_name: notification.account.slug),
+      tag: "card-#{notification.card_id}"
+    }.to_json
+  end
+
+  private
+    attr_reader :notification
+
+    def title
+      case notification.source
+      when Event
+        event_notification_title(notification.source)
+      when Mention
+        "#{notification.source.mentioner.first_name} @mentioned you"
+      end
+    end
+
+    def body
+      case notification.source
+      when Event
+        event_notification_body(notification.source)
+      when Mention
+        notification.source.source.mentionable_content.truncate(200)
+      end
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..270dad9
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,30 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, format: { with: URI::DEFAULT_PARSER.make_regexp(%w[ https ]) }
+  validates :endpoint, uniqueness: true
+
+  def deliver(notification)
+    if vapid_configured?
+      WebPush.payload_send(
+        message: Notification::PushPayload.new(notification).to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def vapid_configured?
+      ENV.values_at("VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY").all?(&:present?)
+    end
+end
