diff --git a/test/controllers/cards/columns_controller_test.rb b/test/controllers/cards/columns_controller_test.rb
new file mode 100644
index 0000000..354600c
--- /dev/null
+++ b/test/controllers/cards/columns_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Cards::ColumnsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:david)
+    @card = cards(:layout)
+  end
+
+  test "updates the card to a board column" do
+    column = columns(:writebook_in_progress)
+
+    patch card_column_path(@card), params: { destination: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, @card.reload.column
+    assert @card.active?
+  end
+
+  test "updates the card to maybe" do
+    patch card_column_path(@card), params: { destination: "maybe" }, as: :json
+
+    assert_response :no_content
+    assert @card.reload.awaiting_triage?
+  end
+
+  test "updates the card to not now" do
+    patch card_column_path(@card), params: { destination: "not_now" }, as: :json
+
+    assert_response :no_content
+    assert @card.reload.postponed?
+  end
+
+  test "updates the card to done" do
+    patch card_column_path(@card), params: { destination: "closed" }, as: :json
+
+    assert_response :no_content
+    assert @card.reload.closed?
+  end
+
+  test "resumes the card when moving from done to a board column" do
+    patch card_column_path(@card), params: { destination: "closed" }, as: :json
+    assert @card.reload.closed?
+    column = columns(:writebook_in_progress)
+
+    patch card_column_path(@card), params: { destination: column.id }, as: :json
+
+    assert_response :no_content
+    assert_equal column, @card.reload.column
+    assert @card.open?
+  end
+
+  test "rejects a column from another board" do
+    other_column = boards(:miltons_wish_list).columns.create!(name: "Other board", color: "var(--color-card-1)")
+
+    patch card_column_path(@card), params: { destination: other_column.id }, as: :json
+
+    assert_response :not_found
+    assert_equal columns(:writebook_triage), @card.reload.column
+  end
+end
diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..c0bffb3
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,90 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:layout)
+    @source_column = boards(:writebook).columns.create!(name: "One card", color: "var(--color-card-1)")
+    @card.update_column :column_id, @source_column.id
+    @destination_column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card to another column moves it immediately and saves its status" do
+    visit board_url(boards(:writebook))
+
+    source = find("##{dom_id(@source_column)}")
+    page.execute_script("arguments[0].scrollIntoView({ block: \"center\", inline: \"center\" })", source)
+    within(source) { assert_selector "##{dom_id(@card, :article)}", visible: :all }
+
+    destination = find("##{dom_id(@destination_column)}")
+    page.execute_script("arguments[0].scrollIntoView({ block: \"center\", inline: \"center\" })", destination)
+    within(destination) { assert_selector ".cards__list", visible: :all }
+
+    card = find("##{dom_id(@card, :article)}", visible: :all)
+    assert_equal "true", card[:draggable]
+
+    original_order = source.all("article", visible: :all).map { |item| item[:id] }
+    page.execute_script <<~JAVASCRIPT, card, source
+      const [card, source] = arguments
+      const transfer = new DataTransfer()
+      const dispatch = (element, type) => element.dispatchEvent(new DragEvent(type, {
+        bubbles: true,
+        cancelable: true,
+        dataTransfer: transfer
+      }))
+
+      dispatch(card, "dragstart")
+      dispatch(source, "dragover")
+      dispatch(source, "drop")
+      dispatch(card, "dragend")
+    JAVASCRIPT
+
+    assert_equal original_order, source.all("article", visible: :all).map { |item| item[:id] }
+    assert_equal @source_column, @card.reload.column
+    assert_equal "none", page.evaluate_script("getComputedStyle(arguments[0].querySelector('.blank-slate--drag')).display", source)
+
+    page.execute_script <<~JAVASCRIPT, card, destination
+      const [card, destination] = arguments
+      const transfer = new DataTransfer()
+      const dispatch = (element, type) => element.dispatchEvent(new DragEvent(type, {
+        bubbles: true,
+        cancelable: true,
+        dataTransfer: transfer
+      }))
+
+      dispatch(card, "dragstart")
+      dispatch(destination, "dragenter")
+    JAVASCRIPT
+
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(@destination_column)}.drag-and-drop__hover-container"
+
+    page.execute_script <<~JAVASCRIPT, card, destination
+      const [card, destination] = arguments
+      const transfer = new DataTransfer()
+      const dispatch = (element, type) => element.dispatchEvent(new DragEvent(type, {
+        bubbles: true,
+        cancelable: true,
+        dataTransfer: transfer
+      }))
+
+      dispatch(destination, "dragover")
+      dispatch(destination, "drop")
+      dispatch(card, "dragend")
+    JAVASCRIPT
+
+    within destination do
+      assert_selector "##{dom_id(@card, :article)}", visible: :all, wait: 0
+    end
+    within source do
+      assert_no_selector "##{dom_id(@card, :article)}", visible: :all, wait: 0
+    end
+    assert_not_equal "none", page.evaluate_script("getComputedStyle(arguments[0].querySelector('.blank-slate--drag')).display", source)
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_equal @destination_column, @card.reload.column
+  end
+end
