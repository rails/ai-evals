diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..13bf11f
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,121 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  dragStart(event) {
+    this.draggedItem = event.currentTarget
+    this.sourceContainer = this.#containerFor(this.draggedItem)
+
+    this.draggedItem.classList.add(this.draggedItemClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", this.draggedItem.id)
+  }
+
+  dragEnd() {
+    this.#clearDragState()
+  }
+
+  dragEnter(event) {
+    if (this.#canDropIn(event.currentTarget)) {
+      event.preventDefault()
+      this.#showHoverContainer(event.currentTarget)
+    }
+  }
+
+  dragOver(event) {
+    if (this.#canDropIn(event.currentTarget)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragLeave(event) {
+    if (!event.currentTarget.contains(event.relatedTarget)) {
+      event.currentTarget.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    const destination = event.currentTarget
+
+    if (this.#canDropIn(destination)) {
+      event.preventDefault()
+
+      const move = this.#captureMove(destination)
+      this.#moveTo(move)
+      this.#save(move)
+    }
+
+    this.#clearDragState()
+  }
+
+  #canDropIn(container) {
+    return this.draggedItem && container !== this.sourceContainer
+  }
+
+  #showHoverContainer(container) {
+    this.containerTargets.forEach((target) => target.classList.remove(this.hoverContainerClass))
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #captureMove(destination) {
+    return {
+      item: this.draggedItem,
+      destination,
+      sourceParent: this.draggedItem.parentNode,
+      sourceNextSibling: this.draggedItem.nextSibling
+    }
+  }
+
+  #moveTo(move) {
+    this.#listFor(move.destination).prepend(move.item)
+  }
+
+  async #save(move) {
+    try {
+      const request = new FetchRequest("patch", move.item.dataset.dragAndDropUrl, {
+        body: JSON.stringify({ destination: move.destination.dataset.dragAndDropDestination }),
+        responseKind: "json"
+      })
+      const response = await request.perform()
+
+      if (!response.ok) this.#restoreSourcePosition(move)
+    } catch (error) {
+      this.#restoreSourcePosition(move)
+    }
+  }
+
+  #restoreSourcePosition(move) {
+    if (move.sourceNextSibling?.parentNode === move.sourceParent) {
+      move.sourceNextSibling.before(move.item)
+    } else {
+      move.sourceParent.append(move.item)
+    }
+  }
+
+  #containerFor(item) {
+    return item.closest("[data-drag-and-drop-target~='container']")
+  }
+
+  #listFor(container) {
+    return container.querySelector(".cards__list")
+  }
+
+  #clearDragState() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.containerTargets.forEach((target) => target.classList.remove(this.hoverContainerClass))
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+}
