diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..34cc025
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,41 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, class: "flex gap-half margin-block-end" do |form| %>
+  <%= form.search_field :q, value: @query, placeholder: "Search cards", autofocus: true, class: "input", aria: { label: "Search cards" } %>
+  <%= form.submit "Search", class: "btn" %>
+<% end %>
+
+<section class="cards cards--grid" aria-label="Search results">
+  <div class="cards__list hide-scrollbar">
+    <% @cards.each do |card| %>
+      <article class="card pad-inline pad-block" data-search-result>
+        <h2 data-search-result-title>
+          <%= link_to search_highlight(card.title, @query), card_path(card) %>
+        </h2>
+        <p class="txt-small translucent"><%= card.board.name %></p>
+
+        <% description = card.description.to_plain_text %>
+        <% if search_match?(description, @query) %>
+          <p><%= search_highlight(description, @query) %></p>
+        <% end %>
+
+        <% card.comments.each do |comment| %>
+          <% body = comment.body.to_plain_text %>
+          <% if search_match?(body, @query) %>
+            <blockquote><%= search_highlight(body, @query) %></blockquote>
+          <% end %>
+        <% end %>
+      </article>
+    <% end %>
+
+    <% if @query.present? && @cards.empty? %>
+      <div class="blank-slate">No cards match “<%= @query %>”</div>
+    <% elsif @query.blank? %>
+      <div class="blank-slate">Enter a term to search cards and comments</div>
+    <% end %>
+  </div>
+</section>
