+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,9 @@
+module SearchesHelper
+  def search_highlight(text, query)
+    highlight text.to_s, query, highlighter: "<mark>\\1</mark>"
+  end
+
+  def search_match?(text, query)
+    text.to_s.downcase.include? query.downcase
+  end
+end
diff --git a/app/models/card.rb b/app/models/card.rb
index b3eac96..a64ffca 100644
--- a/app/models/card.rb
+++ b/app/models/card.rb
@@ -19,6 +19,30 @@ class Card < ApplicationRecord
   after_touch  -> { board.touch }, if: :published?
   after_update :handle_board_change, if: :saved_change_to_board_id?
 
+  scope :searching, ->(query) do
+    pattern = "%#{sanitize_sql_like(query.downcase, "!")}%"
+
+    where(<<~SQL.squish, pattern: pattern, escape: "!", card_type: "Card", comment_type: "Comment", description_name: "description", body_name: "body")
+      LOWER(cards.title) LIKE :pattern ESCAPE :escape
+      OR EXISTS (
+        SELECT 1 FROM action_text_rich_texts descriptions
+        WHERE descriptions.record_type = :card_type
+          AND descriptions.record_id = cards.id
+          AND descriptions.name = :description_name
+          AND LOWER(descriptions.body) LIKE :pattern ESCAPE :escape
+      )
+      OR EXISTS (
+        SELECT 1 FROM comments
+        INNER JOIN action_text_rich_texts comment_bodies
+          ON comment_bodies.record_type = :comment_type
+          AND comment_bodies.record_id = comments.id
+          AND comment_bodies.name = :body_name
+        WHERE comments.card_id = cards.id
+          AND LOWER(comment_bodies.body) LIKE :pattern ESCAPE :escape
+      )
+    SQL
+  end
+
   scope :reverse_chronologically, -> { order created_at:     :desc, id: :desc }
   scope :chronologically,         -> { order created_at:     :asc,  id: :asc  }
   scope :latest,                  -> { order last_active_at: :desc, id: :desc }
