+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,16 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search_cards
+  end
+
+  private
+    def search_cards
+      if @query.present?
+        Current.user.accessible_cards.published.searching(@query).reverse_chronologically
+          .includes(:board).with_rich_text_description.preload(comments: :rich_text_body)
+      else
+        Card.none
+      end
+    end
+end
