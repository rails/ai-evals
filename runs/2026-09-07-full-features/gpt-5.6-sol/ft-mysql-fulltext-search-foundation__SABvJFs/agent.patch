diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..8b2e948
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "finds accessible published cards by title, description, or comments newest first" do
+    older = create_card title: "Needle in the title", created_at: 3.days.ago
+    middle = create_card title: "Description result", description: "A NEEDLE in rich text", created_at: 2.days.ago
+    newer = create_card title: "Comment result", created_at: 1.day.ago
+    create_comment newer, "Found the needle here"
+
+    inaccessible = create_card title: "Inaccessible needle", board: boards(:private), creator: users(:kevin)
+    draft = create_card title: "Draft needle result", created_at: Time.current
+    create_comment draft, "Needle in a draft comment"
+    draft.update! status: :drafted
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "[data-search-result]", 3
+    assert_equal [ newer.title, middle.title, older.title ], css_select("[data-search-result-title]").map { |node| node.text.strip }
+    assert_select "mark", count: 3
+    assert css_select("mark").all? { |node| node.text.match?(/needle/i) }
+    assert_no_match inaccessible.title, response.body
+    assert_no_match draft.title, response.body
+    assert_no_match "draft comment", response.body
+  end
+
+  test "escapes query and result content while highlighting matches" do
+    create_card title: "Find <script>alert('bad')</script> & needle"
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "mark", text: "needle"
+    assert_no_match(/<script>/, response.body)
+  end
+
+  test "treats SQL wildcard characters as literal search terms" do
+    matching = create_card title: "Progress is 100%_done"
+    create_card title: "Progress is 100 percent done"
+
+    get search_path, params: { q: "%_" }
+
+    assert_response :success
+    assert_equal [ matching.title ], css_select("[data-search-result-title]").map { |node| node.text.strip }
+    assert_select "mark", text: "%_"
+  end
+
+  test "shows no results for a blank query" do
+    get search_path, params: { q: " " }
+
+    assert_response :success
+    assert_select "[data-search-result]", 0
+  end
+
+  private
+    def create_card(title:, description: nil, created_at: Time.current, board: boards(:writebook), creator: users(:david))
+      with_current_user creator do
+        board.cards.create!(
+          title: title, description: description, status: :published,
+          creator: creator, created_at: created_at, last_active_at: created_at
+        )
+      end
+    end
+
+    def create_comment(card, body)
+      with_current_user users(:david) do
+        card.comments.create! body: body, creator: users(:david)
+      end
+    end
+end
