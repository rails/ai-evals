diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..e467a26
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,28 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[ en ja ].freeze
+
+  included do
+    around_action :use_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def use_locale(&action)
+      remember_requested_locale
+      I18n.with_locale(preferred_locale, &action)
+    end
+
+    def remember_requested_locale
+      if params[:locale].present? && params[:locale].to_s.in?(SUPPORTED_LOCALES)
+        session[:locale] = params[:locale].to_s
+        Current.identity&.update!(locale: session[:locale])
+      end
+    end
+
+    def preferred_locale
+      candidates = [ session[:locale], Current.identity&.locale ].compact.map(&:to_s)
+      candidates.find { |locale| locale.in?(SUPPORTED_LOCALES) } || I18n.default_locale
+    end
+end
