diff --git a/test/controllers/localization_test.rb b/test/controllers/localization_test.rb
new file mode 100644
index 0000000..fccfa6d
--- /dev/null
+++ b/test/controllers/localization_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "supported locale switches immediately and sticks in the session and identity" do
+    sign_in_as :kevin
+
+    get landing_path, params: { locale: "ja" }
+    follow_redirect!
+    assert_response :success
+    assert_equal "ja", session[:locale]
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select "html[lang=ja]"
+    assert_match "メインコンテンツへ移動", response.body
+  end
+
+  test "unsupported locale is ignored" do
+    sign_in_as :kevin
+
+    get landing_path, params: { locale: "xx" }
+    follow_redirect!
+    assert_response :success
+    assert_nil session[:locale]
+    assert_nil identities(:kevin).reload.locale
+    assert_select "html[lang=en]"
+  end
+
+  test "identity locale is restored in a clean browser session" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+
+    get landing_path
+    follow_redirect!
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "default English rendering remains English" do
+    sign_in_as :kevin
+
+    get landing_path
+    follow_redirect!
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_select "a", text: "Skip to main content"
+  end
+  test "invalid persisted locale falls back without breaking the page" do
+    identities(:kevin).update_column(:locale, "xx")
+    sign_in_as :kevin
+
+    get landing_path
+    follow_redirect!
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "anonymous locale choice applies to the first sign-in email" do
+    ActionMailer::Base.deliveries.clear
+
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      post session_path, params: { email_address: identities(:kevin).email_address }
+    end
+    perform_enqueued_jobs
+
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_match "Fizzy認証コード", ActionMailer::Base.deliveries.last.subject
+  end
+
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..f3689cf
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  test "mail renders in the recipient identity locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_match "Fizzy認証コード", email.subject
+    assert_match "認証コード", email.html_part.body.to_s
+    assert_match "15分", email.html_part.body.to_s
+  end
+  test "invalid persisted locale falls back without breaking email" do
+    identity = identities(:kevin)
+    identity.update_column(:locale, "xx")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+  end
+
+end
