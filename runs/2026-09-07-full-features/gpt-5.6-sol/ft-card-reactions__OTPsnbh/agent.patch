+class CardReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "card reactions belong directly to a card and touch its activity" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      reaction = card.reactions.create!(content: "Nice!")
+      assert_equal card, reaction.card
+      assert_nil reaction.comment
+    end
+  end
+
+  test "card reactions inherit the card account and are deleted with the card" do
+    card = boards(:writebook).cards.create!(title: "Reactable", status: :published)
+    reaction = card.reactions.create!(content: "👍")
+
+    assert_equal card.account, reaction.account
+    assert_difference -> { Reaction.where(id: reaction.id).count }, -1 do
+      card.destroy!
+    end
+  end
+
+  test "a reaction must belong to exactly one target" do
+    card = cards(:logo)
+    comment = comments(:logo_1)
+
+    assert_not Reaction.new(content: "👍").valid?
+    assert_not Reaction.new(content: "👍", card: card, comment: comment).valid?
+  end
