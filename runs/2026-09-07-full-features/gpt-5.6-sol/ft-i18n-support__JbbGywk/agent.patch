@@ -5,7 +5,38 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  def process(method_name, *args)
+    I18n.with_locale(locale_for(args)) { super }
+  end
+
+  ruby2_keywords(:process)
+
   private
+    def locale_for(arguments)
+      find_identity(arguments)&.locale.presence_in(I18n.available_locales.map(&:to_s)) || I18n.default_locale
+    end
+
+    def find_identity(value)
+      case value
+      when Identity
+        value
+      when User
+        value.identity
+      when Array
+        value.filter_map { |item| find_identity(item) }.first
+      when Hash
+        find_identity(value.values)
+      else
+        if value.respond_to?(:identity)
+          value.identity
+        elsif value.respond_to?(:user)
+          find_identity(value.user)
+        elsif value.respond_to?(:initiated_by)
+          find_identity(value.initiated_by)
+        end
+      end
+    end
+
     def default_url_options
