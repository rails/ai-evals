diff --git a/script/audit_i18n b/script/audit_i18n
new file mode 100755
index 0000000..7fa98ac
--- /dev/null
+++ b/script/audit_i18n
@@ -0,0 +1,38 @@
+#!/usr/bin/env ruby
+require "yaml"
+
+root = File.expand_path("..", __dir__)
+en = YAML.safe_load_file(File.join(root, "config/locales/en.yml")).fetch("en")
+ja = YAML.safe_load_file(File.join(root, "config/locales/ja.yml")).fetch("ja")
+
+failures = []
+flatten = ->(hash, prefix = nil) do
+  hash.flat_map do |key, value|
+    path = [ prefix, key ].compact.join(".")
+    value.is_a?(Hash) ? flatten.call(value, path) : [ path ]
+  end
+end
+
+%w[ui mail helpers notifications].each do |namespace|
+  en_keys = flatten.call(en.fetch(namespace, {})).sort
+  ja_keys = flatten.call(ja.fetch(namespace, {})).sort
+  failures << "#{namespace} keys differ between en and ja" unless en_keys == ja_keys
+end
+
+%w[application public mailer].each do |layout|
+  source = File.read(File.join(root, "app/views/layouts/#{layout}.html.erb"))
+  failures << "#{layout} layout has no dynamic lang" unless source.include?("I18n.locale")
+end
+
+Dir[File.join(root, "public/{400,404,406-unsupported-browser,422,500}.html")].each do |file|
+  source = File.read(file)
+  failures << "#{File.basename(file)} is not bilingual" unless source.include?('lang="en"') && source.include?('lang="ja"')
+end
+
+application_source = Dir[File.join(root, "app/**/*.{rb,erb,js}")].map { |file| File.read(file) }.join("\n")
+failures << "nested translation call found" if application_source.match?(/(?:I18n\.)?t\((?:I18n\.)?t\(/)
+failures << "human-readable strftime found" if application_source.match?(/strftime\("%b/)
+failures << "local dates do not use the document locale" unless File.read(File.join(root, "app/javascript/controllers/local_time_controller.js")).include?("document.documentElement.lang")
+
+abort failures.join("\n") if failures.any?
+puts "Internationalization audit passed"
diff --git a/test/controllers/concerns/localization_test.rb b/test/controllers/concerns/localization_test.rb
new file mode 100644
index 0000000..84ef3c4
--- /dev/null
+++ b/test/controllers/concerns/localization_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "a supported locale parameter sticks in the session" do
+    get new_session_path(locale: :ja)
+    assert_response :redirect
+    assert_equal "ja", session[:locale]
+
+    get new_session_path
+    assert_response :redirect
+    assert_equal "ja", session[:locale]
+  end
+
+  test "an unsupported locale parameter is ignored" do
+    get new_session_path(locale: :xx)
+    assert_response :redirect
+    assert_nil session[:locale]
+  end
+
+  test "an unsupported locale does not replace an existing choice" do
+    get new_session_path(locale: :ja)
+    get new_session_path(locale: :xx)
+
+    assert_equal "ja", session[:locale]
+  end
+
+  test "chosen locale is saved on the signed in identity" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "saved identity locale is restored in a clean browser" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+    get root_path
+    assert_equal "ja", session[:locale]
+  end
+
+  test "Japanese page renders translations without missing keys" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+    assert_response :success
+    assert_includes response.body, 'lang="ja"'
+    assert_no_match(/translation missing/i, response.body)
+  end
+end
