diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..bfb7ec1
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,40 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :use_locale
+    before_action :restore_identity_locale
+  end
+
+  private
+    def use_locale(&action)
+      if requested_locale
+        session[:locale] = requested_locale
+      end
+
+      I18n.with_locale(session_locale || I18n.default_locale, &action)
+    end
+
+    def restore_identity_locale
+      if Current.identity
+        if session_locale
+          Current.identity.update_column(:locale, session_locale) if Current.identity.locale != session_locale
+        elsif available_locale?(Current.identity.locale)
+          session[:locale] = Current.identity.locale
+          I18n.locale = Current.identity.locale
+        end
+      end
+    end
+
+    def requested_locale
+      params[:locale].to_s if params.key?(:locale) && available_locale?(params[:locale])
+    end
+
+    def session_locale
+      session[:locale].to_s if available_locale?(session[:locale])
+    end
+
+    def available_locale?(locale)
+      locale.to_s.in?(I18n.available_locales.map(&:to_s))
+    end
+end
