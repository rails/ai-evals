diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..b0829bd
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,47 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :use_current_locale
+    helper_method :current_locale
+  end
+
+  private
+    def use_current_locale(&action)
+      remember_requested_locale
+      I18n.with_locale(current_locale) do
+        localize_flash
+        action.call
+        localize_flash
+      end
+    end
+
+    def localize_flash
+      flash.each do |type, message|
+        flash[type] = I18n.t(message, scope: :static, default: message, separator: "\0") if message.is_a?(String)
+      end
+    end
+
+    def remember_requested_locale
+      if supported_locale?(params[:locale])
+        session[:locale] = params[:locale]
+        Current.identity&.update!(locale: params[:locale])
+      end
+    end
+
+    def current_locale
+      session_locale || identity_locale || I18n.default_locale
+    end
+
+    def session_locale
+      session[:locale] if supported_locale?(session[:locale])
+    end
+
+    def identity_locale
+      Current.identity.locale if supported_locale?(Current.identity&.locale)
+    end
+
+    def supported_locale?(locale)
+      locale.to_s.in?(I18n.available_locales.map(&:to_s))
+    end
+end
