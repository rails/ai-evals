diff --git a/config/initializers/localized_templates.rb b/config/initializers/localized_templates.rb
new file mode 100644
index 0000000..b1af249
--- /dev/null
+++ b/config/initializers/localized_templates.rb
@@ -0,0 +1,33 @@
+# ERB appends literal template source through safe_append= and dynamic values through
+# append=. Localizing here keeps user-authored card/comment content untouched while
+# ensuring text and accessibility labels in every template use the same catalogue.
+module LocalizedTemplates
+  READABLE_ATTRIBUTE = /(?<name>\b(?:alt|aria-label|placeholder|title|value))=(?<quote>["'])(?<text>[^"']*[A-Za-z][^"']*)\k<quote>/
+  TEXT_NODE = /(?<=>)(?<text>[^<>]*[A-Za-z][^<>]*)(?=<)/
+  LEADING_TEXT = /\A(?<text>[^<>]*[A-Za-z][^<>]*)(?=<)/
+  TRAILING_TEXT = /(?<=>)(?<text>[^<>]*[A-Za-z][^<>]*)\z/
+
+  def safe_append=(value)
+    if I18n.locale == :ja && value.is_a?(String)
+      value = localize_template_literal(value)
+    end
+    super(value)
+  end
+
+  private
+    def localize_template_literal(source)
+      source.gsub(READABLE_ATTRIBUTE) do
+        %(#{Regexp.last_match[:name]}=#{Regexp.last_match[:quote]}#{translate_literal(Regexp.last_match[:text])}#{Regexp.last_match[:quote]})
+      end.gsub(TEXT_NODE) do
+        translate_literal(Regexp.last_match[:text])
+      end
+    end
+
+    def translate_literal(text)
+      leading, content, trailing = text.partition(/\S/).then { |before, first, after| [ before, first + after.sub(/\s+\z/, ""), after[/\s+\z/] ] }
+      translation = I18n.t(content, scope: :static, default: content, separator: "\0")
+      "#{leading}#{translation}#{trailing}"
+    end
+end
+
+ActionView::OutputBuffer.prepend(LocalizedTemplates)
