diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..0c6975c
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "a supported locale is selected and sticks for the session" do
+    untenanted do
+      get new_session_path(locale: :ja)
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+
+  test "an unsupported locale is ignored" do
+    untenanted do
+      get new_session_path(locale: :xx)
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "an authenticated person's selection is saved on their identity" do
+    sign_in_as :kevin
+    get root_path(locale: :ja)
+
+    assert_response :success
+    assert_equal "ja", identities(:kevin).reload.locale
+    assert_select "html[lang=ja]"
+  end
+
+  test "an identity's locale is restored in a clean session" do
+    identities(:kevin).update!(locale: "ja")
+    sign_in_as :kevin
+    get root_path
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "an anonymous selection is saved before sending a sign-in email" do
+    identity = identities(:kevin)
+
+    perform_enqueued_jobs do
+      untenanted do
+        get new_session_path(locale: :ja)
+        post session_path, params: { email_address: identity.email_address }
+      end
+    end
+
+    assert_equal "ja", identity.reload.locale
+    assert_equal "Fizzy認証コード：#{MagicLink.last.code}", ActionMailer::Base.deliveries.last.subject
+  end
+
+  test "an anonymous selection is applied to a newly created identity" do
+    email_address = "japanese-#{SecureRandom.hex(4)}@example.com"
+
+    perform_enqueued_jobs do
+      untenanted do
+        get new_signup_path(locale: :ja)
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+    end
+
+    assert_equal "ja", Identity.find_by!(email_address: email_address).locale
+    assert_match "Fizzy認証コード", ActionMailer::Base.deliveries.last.subject
+  end
+end
diff --git a/test/mailers/locale_test.rb b/test/mailers/locale_test.rb
new file mode 100644
index 0000000..a6dc1df
--- /dev/null
+++ b/test/mailers/locale_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class MailerLocaleTest < ActionMailer::TestCase
+  test "mail is rendered in the recipient identity's locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+
+    assert_match "認証コード", email.subject
+    assert_match "分間", email.text_part.decoded
+  end
+end
