diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..05073ad
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "permanently deletes accounts cancelled more than thirty days ago" do
+    due_account = accounts(:"37s")
+    retained_account = accounts(:initech)
+
+    travel_to Time.current.change(usec: 0) do
+      due_account.create_cancellation!(initiated_by: due_account.users.first, created_at: 30.days.ago - 1.second)
+      retained_account.create_cancellation!(initiated_by: retained_account.users.first, created_at: 30.days.ago)
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(retained_account.id)
+
+    account_owned_tables.each do |table|
+      assert_equal 0, count_rows_for(table, due_account.id), "Expected #{table} to have no data for the incinerated account"
+    end
+  end
+
+  private
+    def account_owned_tables
+      ActiveRecord::Base.connection.tables.select do |table|
+        ActiveRecord::Base.connection.column_exists?(table, :account_id)
+      end
+    end
+
+    def count_rows_for(table, account_id)
+      connection = ActiveRecord::Base.connection
+      column = connection.quote_column_name(:account_id)
+      connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE #{column} = #{connection.quote(account_id)}").to_i
+    end
+end
