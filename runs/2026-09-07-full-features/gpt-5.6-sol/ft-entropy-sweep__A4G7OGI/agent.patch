diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..43a5e6c 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
@@ -1,5 +1,6 @@
 module Card::Entropic
   extend ActiveSupport::Concern
+  AUTO_POSTPONE_BATCH_SIZE = 1000
 
   included do
     scope :due_to_be_postponed, -> do
@@ -25,8 +26,11 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      # Snapshot IDs so the expensive due scope is not rerun for every batch.
+      due_to_be_postponed.ids.each_slice(AUTO_POSTPONE_BATCH_SIZE) do |card_ids|
+        where(id: card_ids).each do |card|
+          card.auto_postpone(user: card.account.system_user)
+        end
       end
     end
   end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..10ccf32 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,40 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone evaluates the expensive due scope only once across batches" do
+    template = cards(:logo)
+    first_number = Card.maximum(:number) + 1
+    now = Time.current
+    rows = (Card::Entropic::AUTO_POSTPONE_BATCH_SIZE + 1).times.map do |offset|
+      {
+        id: SecureRandom.uuid,
+        account_id: template.account_id,
+        board_id: template.board_id,
+        creator_id: template.creator_id,
+        number: first_number + offset,
+        status: "published",
+        title: "entropy sweep regression",
+        last_active_at: 2.years.ago,
+        created_at: now,
+        updated_at: now
+      }
+    end
+    Card.insert_all!(rows)
+
+    entropy_queries = 0
+    batch_queries = 0
+    count_entropy_queries = ->(*, payload) do
+      entropy_queries += 1 if payload[:sql].include?("account_entropies")
+      batch_queries += 1 if payload[:sql].start_with?(%q(SELECT "cards".* FROM "cards" WHERE "cards"."id"))
+    end
+    Card.any_instance.stubs(:auto_postpone)
+
+    ActiveSupport::Notifications.subscribed(count_entropy_queries, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    assert_equal 1, entropy_queries
+    assert_operator batch_queries, :>=, 2
+  end
 end
