+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_activities
+    fresh_when etag: @page.records
+  end
+
+  private
+    def filtered_activities
+      activities = Event.account_activity.where(board: Current.user.boards)
+      activities = activities.where(creator_id: params[:creator_ids]) if params[:creator_ids].present?
+      activities = activities.where(board_id: params[:board_ids]) if params[:board_ids].present?
+      activities.order(created_at: :desc, id: :asc)
+    end
+end
