+++ b/docs/api/sections/activities.md
@@ -0,0 +1,21 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity visible to the current user, newest first. The response is a flat, paginated array. Follow the `Link` response header with `rel="next"` to fetch additional activity.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | string[] | No | Only return activity created by these users |
+| `board_ids[]` | string[] | No | Only return activity from these accessible boards |
+
+Each activity contains `id`, `action`, `created_at`, a plain-text `description`, `particulars`, `url`, `eventable_type`, and the standard API representations of its `eventable`, `board`, and `creator`. Card activity URLs open the card; comment activity URLs open the card at the comment.
+
+`particulars` contains event-specific values:
+
+- Assignment changes: `assignee_ids`
+- Board changes: `old_board` and `new_board`
+- Title changes: `old_title` and `new_title`
+- Triage events: `column`
+
+Other activity has an empty `particulars` object. Missing board, title, and column values are empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..aabffa1
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,114 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @board = boards(:writebook)
+    @creator = users(:david)
+  end
+
+  test "index as JSON returns timeline activity newest first with API representations" do
+    assignment = create_event "card_assigned", particulars: { assignee_ids: [ users(:jz).id ] }, created_at: 3.minutes.ago
+    title_change = create_event "card_title_changed", particulars: { old_title: "Old title", new_title: "New title" }, created_at: 2.minutes.ago
+    comment_event = create_event "comment_created", eventable: comments(:layout_overflowing_david), created_at: 1.minute.ago
+    deprecated = create_event "card_collection_changed", created_at: Time.current
+    create_event "card_resumed", created_at: Time.current
+
+    get activities_path, as: :json
+
+    assert_response :success
+
+    json = response.parsed_body
+    returned_ids = json.pluck("id")
+    assert_includes returned_ids, assignment.id
+    assert_includes returned_ids, title_change.id
+    assert_includes returned_ids, comment_event.id
+    assert_not_includes returned_ids, deprecated.id
+    assert_equal returned_ids, Event.where(id: returned_ids).order(created_at: :desc, id: :asc).pluck(:id)
+
+    event_json = json.find { |item| item["id"] == title_change.id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], event_json.keys.sort
+    assert_equal title_change.action, event_json["action"]
+    assert_equal title_change.created_at.as_json, event_json["created_at"]
+    assert_equal title_change.description_for(users(:kevin)).to_plain_text, event_json["description"]
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, event_json["particulars"])
+    assert_equal card_url(@card), event_json["url"]
+    assert_equal "Card", event_json["eventable_type"]
+    assert_equal @card.id, event_json.dig("eventable", "id")
+    assert_equal @board.id, event_json.dig("board", "id")
+    assert_equal @creator.id, event_json.dig("creator", "id")
+
+    assignment_json = json.find { |item| item["id"] == assignment.id }
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, assignment_json["particulars"])
+
+    comment_json = json.find { |item| item["id"] == comment_event.id }
+    assert_equal card_url(comment_event.eventable.card, anchor: dom_id(comment_event.eventable)), comment_json["url"]
+    assert_equal "Comment", comment_json["eventable_type"]
+    assert_equal comment_event.eventable.id, comment_json.dig("eventable", "id")
+  end
+
+  test "particulars include event-specific fields with missing values as empty strings" do
+    board_change = create_event "card_board_changed", particulars: { old_board: nil }
+    title_change = create_event "card_title_changed", particulars: {}
+    triaged = create_event "card_triaged", particulars: {}
+    sent_back = create_event "card_sent_back_to_triage", particulars: {}
+    published = create_event "card_published", particulars: { ignored: "value" }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    json = response.parsed_body.index_by { |item| item["id"] }
+    assert_equal({ "old_board" => "", "new_board" => "" }, json.fetch(board_change.id)["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, json.fetch(title_change.id)["particulars"])
+    assert_equal({ "column" => "" }, json.fetch(triaged.id)["particulars"])
+    assert_equal({ "column" => "" }, json.fetch(sent_back.id)["particulars"])
+    assert_equal({}, json.fetch(published.id)["particulars"])
+  end
+
+  test "filters by creators and accessible boards" do
+    david_event = create_event "card_published", creator: users(:david)
+    kevin_event = create_event "card_closed", creator: users(:kevin)
+
+    get activities_path, params: { creator_ids: [ users(:david).id ], board_ids: [ @board.id ] }, as: :json
+
+    assert_response :success
+    ids = response.parsed_body.pluck("id")
+    assert_includes ids, david_event.id
+    assert_not_includes ids, kevin_event.id
+    assert response.parsed_body.all? { |event| event.dig("board", "id") == @board.id }
+  end
+
+  test "does not return activity from inaccessible boards" do
+    private_board = boards(:private)
+    private_card = private_board.cards.create!(title: "Secret", creator: users(:kevin), status: :drafted)
+    inaccessible_event = create_event "card_published", board: private_board, eventable: private_card
+
+    logout_and_sign_in_as :david
+    get activities_path, params: { board_ids: [ private_board.id ] }, as: :json
+
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), inaccessible_event.id
+  end
+
+  test "index as JSON is paginated" do
+    30.times { |index| create_event "card_published", created_at: index.seconds.ago }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert response.headers["Link"].match?(/rel="next"/)
+    assert response.parsed_body.length < Event.count
+  end
+
+  private
+    def create_event(action, board: @board, eventable: @card, creator: @creator, particulars: {}, created_at: Time.current)
+stored_particulars = if action.in?(%w[card_assigned card_unassigned])
+  particulars
+else
+  { particulars: }
+end
+Event.create!(account: board.account, board:, eventable:, creator:, action:, particulars: stored_particulars, created_at:)
+    end
+end
