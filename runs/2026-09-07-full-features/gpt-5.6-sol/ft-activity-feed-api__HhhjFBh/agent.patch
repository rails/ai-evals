diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..66e5118
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,33 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action, :eventable_type)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.url polymorphic_url(event.eventable)
+
+  stored_particulars = event.particulars.fetch("particulars", event.particulars)
+  particulars = case event.action
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: stored_particulars["assignee_ids"] || [] }
+  when "card_board_changed"
+    { old_board: stored_particulars["old_board"].to_s, new_board: stored_particulars["new_board"].to_s }
+  when "card_title_changed"
+    { old_title: stored_particulars["old_title"].to_s, new_title: stored_particulars["new_title"].to_s }
+  when "card_triaged", "card_sent_back_to_triage"
+    { column: stored_particulars["column"].to_s }
+  else
+    {}
+  end
+  json.particulars particulars
+
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
