diff --git a/test/deployment/one_box_kamal_config_test.rb b/test/deployment/one_box_kamal_config_test.rb
new file mode 100644
index 0000000..bab08d8
--- /dev/null
+++ b/test/deployment/one_box_kamal_config_test.rb
@@ -0,0 +1,38 @@
+require "minitest/autorun"
+require "yaml"
+
+class OneBoxKamalConfigTest < Minitest::Test
+  CONFIG_PATH = File.expand_path("../../config/deploy.yml", __dir__)
+  PRODUCTION_PATH = File.expand_path("../../config/environments/production.rb", __dir__)
+
+  def setup
+    @source = File.read(CONFIG_PATH)
+    @config = YAML.safe_load(@source, aliases: true)
+  end
+
+  def test_deploys_one_web_container_behind_an_ssl_proxy
+    assert_equal [ "YOUR_SERVER_IP" ], @config.dig("servers", "web")
+    assert_equal true, @config.dig("proxy", "ssl")
+    assert_equal "fizzy.example.com", @config.dig("proxy", "host")
+    refute @config.dig("servers").key?("jobs"), "jobs should run in Puma in the one container"
+    refute_equal "false", @config.dig("env", "clear", "SOLID_QUEUE_IN_PUMA")
+  end
+
+  def test_persists_sqlite_databases_and_uploads_on_the_host
+    assert_includes @config.fetch("volumes"), "fizzy_storage:/rails/storage"
+  end
+
+  def test_passes_public_url_and_mail_configuration
+    clear = @config.dig("env", "clear")
+    assert_equal "fizzy.example.com", clear["APP_HOST"]
+    assert clear.values_at("SMTP_ADDRESS", "SMTP_PORT", "SMTP_DOMAIN", "SMTP_AUTHENTICATION", "SMTP_ENABLE_STARTTLS_AUTO").all?
+
+    secrets = @config.dig("env", "secret")
+    %w[ SECRET_KEY_BASE SMTP_USERNAME SMTP_PASSWORD ].each { |name| assert_includes secrets, name }
+
+    production = File.read(PRODUCTION_PATH)
+    %w[ APP_HOST SMTP_ADDRESS SMTP_PORT SMTP_DOMAIN SMTP_USERNAME SMTP_PASSWORD SMTP_AUTHENTICATION SMTP_ENABLE_STARTTLS_AUTO ].each do |name|
+      assert_includes production, name
+    end
+  end
+end
