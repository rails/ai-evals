@@ -0,0 +1,15 @@
+# Kamal evaluates this file as a shell script. Keep actual values in the
+# gitignored .kamal/secrets.local file, not in this tracked file.
+if [ ! -f .kamal/secrets.local ]; then
+  echo "Missing .kamal/secrets.local (copy .kamal/secrets.local.example)" >&2
+  exit 1
+fi
+
+set -a
+. .kamal/secrets.local
+set +a
+
+KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?KAMAL_REGISTRY_PASSWORD is required}
+SECRET_KEY_BASE=${SECRET_KEY_BASE:?SECRET_KEY_BASE is required}
+SMTP_USERNAME=${SMTP_USERNAME:?SMTP_USERNAME is required}
+SMTP_PASSWORD=${SMTP_PASSWORD:?SMTP_PASSWORD is required}
