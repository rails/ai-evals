diff --git a/test/models/webhook/delivery_test.rb b/test/models/webhook/delivery_test.rb
index b51445b..9ad34f1 100644
--- a/test/models/webhook/delivery_test.rb
+++ b/test/models/webhook/delivery_test.rb
@@ -78,3 +78,56 @@ class Webhook::DeliveryTest < ActiveSupport::TestCase
     assert_nil delivery.response_summary
   end
 end
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  FakeResponse = Struct.new(:code) do
+    def each_header
+      {}.each
+    end
+  end
+
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+    @delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+  end
+
+  test "posts a signed JSON event and logs success exactly once" do
+    posts = []
+    @delivery.define_singleton_method(:perform_request) do |uri, headers, body|
+      posts << Net::HTTP::Post.new(uri.request_uri, headers).tap { |post| post.body = body }
+      FakeResponse.new("204")
+    end
+
+    @delivery.deliver_now
+    @delivery.deliver_now
+
+    assert_equal 1, posts.size
+    post = posts.first
+    payload = JSON.parse(post.body)
+    assert_equal @event.id, payload["id"]
+    assert_equal @event.action, payload["action"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, post.body), post["X-Webhook-Signature"]
+    assert_equal "application/json", post["Content-Type"]
+    assert @delivery.reload.succeeded?
+    assert_equal 204, @delivery.response[:code]
+  end
+
+  test "logs non-successful HTTP responses as failures" do
+    @delivery.define_singleton_method(:perform_request) { |*| FakeResponse.new("503") }
+    @delivery.deliver_now
+
+    assert @delivery.reload.failed?
+    assert_equal 503, @delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "logs transport errors and delinquency" do
+    @delivery.define_singleton_method(:perform_request) { |*| raise SocketError, "unreachable" }
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "socket_error", @delivery.response[:error]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+end
diff --git a/test/models/webhook/operation_test.rb b/test/models/webhook/operation_test.rb
new file mode 100644
index 0000000..a54a280
--- /dev/null
+++ b/test/models/webhook/operation_test.rb
@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Webhook::OperationTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:logo_published)
+    Webhook::Delivery.where(webhook: @webhook, event: @event).delete_all
+  end
+
+  test "an event relays once to each active subscribed board webhook" do
+    assert_enqueued_with job: Webhook::DeliveryJob do
+      @event.relay_now
+    end
+
+    assert_equal 1, @webhook.deliveries.where(event: @event).count
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      @event.relay_now
+    end
+
+    assert_equal 1, @webhook.deliveries.where(event: @event).count
+  end
+
+  test "an event does not relay to inactive or unsubscribed webhooks" do
+    @webhook.update!(active: false)
+
+    assert_no_difference "Webhook::Delivery.count" do
+      @event.relay_now
+    end
+
+    @webhook.update!(active: true, subscribed_actions: [ "card_closed" ])
+
+    assert_no_difference "Webhook::Delivery.count" do
+      @event.relay_now
+    end
+  end
+
+  test "webhooks create a delinquency tracker" do
+    webhook = Webhook.create!(name: "Tracker", url: "https://example.com/hook", board: boards(:writebook))
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "ten consecutive failures over an hour deactivate the webhook" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to 61.minutes.ago do
+      9.times { tracker.track_failure }
+    end
+
+    assert @webhook.reload.active?
+
+    tracker.track_failure
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "failures in less than an hour and successful deliveries reset delinquency" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to 59.minutes.ago do
+      9.times { tracker.track_failure }
+    end
+    tracker.track_failure
+
+    assert @webhook.reload.active?
+
+    tracker.track_success
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "activation resets delinquency" do
+    tracker = @webhook.delinquency_tracker
+    tracker.track_failure
+    @webhook.deactivate
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "delivery cleanup retains one week of history" do
+    stale = webhook_deliveries(:unsuccessfully_completed)
+    recent = webhook_deliveries(:pending)
+    stale.update_column(:created_at, 1.week.ago - 1.second)
+    recent.update_column(:created_at, 1.week.ago + 1.second)
+
+    Webhook::Delivery.cleanup
+
+    assert_not Webhook::Delivery.exists?(stale.id)
+    assert Webhook::Delivery.exists?(recent.id)
+  end
+end
