@@ -1,4 +1,7 @@
 class Webhook::Delivery < ApplicationRecord
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +13,22 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim
+
+    post
+  rescue StandardError => error
+    record_error(error)
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +48,82 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      with_lock do
+        if pending?
+          update!(state: :in_progress)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def post
+      uri = URI.parse(webhook.url)
+      body = payload
+      headers = request_headers(body)
+      update!(request: { headers: headers, body: body })
+
+      http_response = perform_request(uri, headers, body)
+
+      update!(state: :completed, response: {
+        code: http_response.code.to_i,
+        headers: http_response.each_header.to_h
+      })
+      track_result
+    end
+
+    def perform_request(uri, headers, body)
+      Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        http.request Net::HTTP::Post.new(uri.request_uri, headers).tap { |post| post.body = body }
+      end
+    end
+
+    def payload
+      if webhook.for_slack?
+        { text: rendered_event(:html) }.to_json
+      elsif webhook.for_basecamp?
+        { content: rendered_event(:html) }.to_json
+      elsif webhook.for_campfire?
+        { message: { body: rendered_event(:html) } }.to_json
+      else
+        rendered_event(:json)
+      end
+    end
+
+    def rendered_event(format)
+      ApplicationController.renderer.new(script_name: account.slug).render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: [ format ]
+      )
+    end
+
+    def request_headers(body)
+      timestamp = Time.current.utc.iso8601(3)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body),
+        "X-Webhook-Timestamp" => timestamp
+      }
+    end
+
+    def record_error(error)
+      update!(state: :errored, response: { error: error.class.name.underscore })
+      track_result
+    end
+
+    def track_result
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+      if succeeded?
+        tracker.track_success
+      else
+        tracker.track_failure
+      end
+    end
 end
