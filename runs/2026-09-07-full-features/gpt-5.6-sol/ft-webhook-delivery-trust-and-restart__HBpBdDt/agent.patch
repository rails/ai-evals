--- /dev/null
+++ b/app/models/event/relaying.rb
@@ -0,0 +1,20 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self)
+  end
+
+  def relay_now
+    board.webhooks.active.find_each do |webhook|
+      next unless webhook.subscribed_actions.include?(action.to_s)
+
+      delivery = webhook.deliveries.create_or_find_by!(event: self)
+      delivery.deliver_later if delivery.previously_new_record?
+    end
+  end
+end
