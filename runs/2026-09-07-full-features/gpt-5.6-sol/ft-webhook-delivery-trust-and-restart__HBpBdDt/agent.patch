@@ -1,4 +1,10 @@
 class Webhook::Delivery < ApplicationRecord
+  class DestinationUnreachable < StandardError; end
+
+  RETENTION_PERIOD = 1.week
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +16,25 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...RETENTION_PERIOD.ago).delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    delivery_started = start_delivery
+    return unless delivery_started
+
+    perform_request
+  rescue StandardError => error
+    finish_with_error(error)
+  ensure
+    webhook.track_delivery_result(self) if delivery_started && finished?
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -23,10 +48,93 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def failed?
-    (errored? || completed?) && !succeeded?
+    finished? && !succeeded?
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def start_delivery
+      with_lock do
+        if pending?
+          update!(state: :in_progress)
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def perform_request
+      body = render_payload
+      headers = request_headers(body)
+      update!(request: { headers: headers })
+
+      http_response = post(body, headers)
+      update!(state: :completed, response: {
+        code: http_response.code.to_i,
+        headers: http_response.each_header.to_h
+      })
+    end
+
+    def render_payload
+      ApplicationController.renderer.new(script_name: webhook.account.slug).render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: [ :json ]
+      )
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      resolved_ip = SsrfProtection.resolve_public_ip(uri.host)
+      raise DestinationUnreachable if resolved_ip.nil?
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = resolved_ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+      http.start { http.request(request) }
+    end
+
+    def finish_with_error(error)
+      update!(state: :errored, response: { error: error_name(error) }) if in_progress?
+    end
+
+    def error_name(error)
+      if destination_unreachable?(error)
+        "destination_unreachable"
+      else
+        Rails.error.report(error, context: { webhook_delivery_id: id })
+        "delivery_failed"
+      end
+    end
+
+    def destination_unreachable?(error)
+      error.is_a?(DestinationUnreachable) ||
+        error.is_a?(SocketError) ||
+        error.is_a?(Resolv::ResolvError) ||
+        error.is_a?(SystemCallError) ||
+        error.is_a?(Timeout::Error) ||
+        error.is_a?(OpenSSL::SSL::SSLError)
+    end
+
+    def finished?
+      completed? || errored?
+    end
 end
