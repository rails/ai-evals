diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
index 7f1dd39..384297b 100644
--- a/test/models/reaction_test.rb
+++ b/test/models/reaction_test.rb
@@ -11,3 +11,44 @@ class ReactionTest < ActiveSupport::TestCase
     end
   end
 end
+
+class CardReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "creating a card reaction touches the card activity" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.last_active_at } do
+      card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "destroying a card reaction touches the card" do
+    card = cards(:logo)
+    reaction = card.reactions.create!(content: "Nice!")
+
+    assert_changes -> { card.reload.updated_at } do
+      reaction.destroy!
+    end
+  end
+
+  test "reaction belongs to exactly one card or comment" do
+    reaction = Reaction.new(content: "Nice!")
+    assert_not reaction.valid?
+
+    reaction.card = cards(:logo)
+    reaction.comment = comments(:logo_1)
+    assert_not reaction.valid?
+  end
+
+  test "destroying a card destroys its reactions" do
+    card = cards(:logo)
+    reaction = card.reactions.create!(content: "Nice!")
+
+    card.destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
