+require "test_helper"
+
+class CardPreviewBoostsPartialTest < ActionView::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+  end
+
+  test "does not show a boost count when there are no card reactions" do
+    render partial: "cards/display/preview/boosts", locals: { card: @card }
+
+    assert_select ".card__boosts", count: 0
+  end
+
+  test "shows the card boost count when it is non-zero" do
+    2.times { @card.reactions.create!(content: "👍") }
+
+    render partial: "cards/display/preview/boosts", locals: { card: @card }
+
+    assert_select ".card__boosts strong", text: "2"
+  end
+
+  test "does not count comment reactions as card boosts" do
