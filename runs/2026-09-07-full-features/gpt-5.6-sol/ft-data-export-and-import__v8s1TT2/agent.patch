+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as users(:jason) }
+
+  test "shows import form" do
+    get new_account_import_path
+    assert_response :ok
+    assert_select "form[action='#{account_imports_path}']"
+  end
+
+  test "uploads and enqueues an account import" do
+    file = Rack::Test::UploadedFile.new(StringIO.new("archive"), "application/zip", original_filename: "account.zip")
+
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_with(job: ImportJob) { post account_imports_path, params: { import: { file: file } } }
+    end
+
+    assert_redirected_to account_settings_path
+  end
+
+  test "rejects another file type" do
+    file = Rack::Test::UploadedFile.new(StringIO.new("hello"), "text/plain", original_filename: "account.txt")
+
+    assert_no_difference -> { Import.count } do
+      post account_imports_path, params: { import: { file: file } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
