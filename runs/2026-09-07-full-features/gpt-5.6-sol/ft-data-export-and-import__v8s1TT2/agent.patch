diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..4e0a9a7
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,44 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :export_type, %i[ account cards ].index_by(&:itself), scopes: false
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validates :export_type, presence: true
+
+  def generate_later
+    ExportJob.perform_later(self)
+  end
+
+  def generate_now
+    update!(status: :processing, error_message: nil)
+    ZipFile.create_for(file, filename: filename) do |zip|
+      exporter.write_to(zip)
+    end
+    update!(status: :completed, expires_at: 1.day.from_now)
+    ExportMailer.ready(self).deliver_later
+  rescue => error
+    update!(status: :failed, error_message: error.message)
+    ExportMailer.failed(self).deliver_later
+  end
+
+  def downloadable?
+    completed? && expires_at&.future? && file.attached?
+  end
+
+  def filename
+    "fizzy-#{export_type}-#{account.name.parameterize}-#{created_at.to_date}.zip"
+  end
+
+  private
+    def exporter
+      if account?
+        Account::DataTransfer::Exporter.new(account, requested_by: user)
+      else
+        Account::DataTransfer::CardExporter.new(user)
+      end
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..01af63a
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,34 @@
+class Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  enum :status, %i[ pending processing completed failed ].index_by(&:itself), scopes: false
+
+  validate :file_is_zip
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    update!(status: :processing, error_message: nil)
+    file.open do |archive|
+      account = Account::DataTransfer::Importer.new(archive, identity: identity).import
+      update!(status: :completed, imported_account: account)
+    end
+    ImportMailer.completed(self).deliver_later
+  rescue => error
+    update!(status: :failed, error_message: error.message.truncate(2_000), imported_account: nil)
+    ImportMailer.failed(self).deliver_later
+  end
+
+  private
+    def file_is_zip
+      if file.attached? && !file.content_type.in?(%w[application/zip application/x-zip-compressed])
+        errors.add(:file, "must be a ZIP file")
+      end
+    end
+end
