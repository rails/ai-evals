diff --git a/test/models/account/data_transfer/card_exporter_test.rb b/test/models/account/data_transfer/card_exporter_test.rb
new file mode 100644
index 0000000..d8d803c
--- /dev/null
+++ b/test/models/account/data_transfer/card_exporter_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Account::DataTransfer::CardExporterTest < ActiveSupport::TestCase
+  test "exports accessible cards with comments and attachments" do
+    user = users(:david)
+    card = user.accessible_cards.first
+    card.image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    export = Export.create!(account: user.account, user: user, export_type: :cards)
+
+    export.generate_now
+
+    assert export.reload.completed?, export.error_message
+    export.file.open do |archive|
+      entries = ZipKit::FileReader.read_zip_structure(io: archive).index_by(&:filename)
+      card_entry = entries.fetch("cards/#{card.number}.json")
+      extractor = card_entry.extractor_from(archive)
+      json = JSON.parse(extractor.extract)
+
+      assert_kind_of Array, json.fetch("comments")
+      assert json.fetch("attachments").any? { |attachment| attachment["filename"] == "picture.png" }
+      path = json.fetch("attachments").find { |attachment| attachment["filename"] == "picture.png" }.fetch("path")
+      assert entries.key?(path)
+    end
+  end
+end
diff --git a/test/models/account/data_transfer/export_import_test.rb b/test/models/account/data_transfer/export_import_test.rb
new file mode 100644
index 0000000..aa83c28
--- /dev/null
+++ b/test/models/account/data_transfer/export_import_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:jason)
+  end
+
+  test "exports account records and attached files and imports a distinct account" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("attachment contents"), filename: "notes.txt", content_type: "text/plain"
+    )
+    card.update!(description: "Description with attachment")
+    card.image.attach(blob)
+
+    export = Export.create!(account: @account, user: @user, export_type: :account)
+    export.generate_now
+
+    assert export.reload.completed?, export.error_message
+    assert export.file.attached?
+
+    imported_account = nil
+    export.file.open do |archive|
+      transfer = Import.create!(account: @account, identity: @user.identity)
+      transfer.file.attach(io: archive, filename: "account.zip", content_type: "application/zip")
+      transfer.import_now
+      assert transfer.reload.completed?, transfer.error_message
+      imported_account = transfer.imported_account
+    end
+
+    assert_not_equal @account.id, imported_account.id
+    assert_equal @account.name, imported_account.name
+    assert_equal @account.boards.count, imported_account.boards.count
+    assert_equal @account.cards.count, imported_account.cards.count
+    assert_equal Comment.where(account: @account).count, Comment.where(account: imported_account).count
+    assert_equal "attachment contents", imported_account.cards.find_by(number: card.number).image.download
+    assert_equal @user.identity, imported_account.users.owner.first.identity
+  end
+
+  test "a failed import leaves no account behind" do
+    transfer = Import.create!(account: @account, identity: @user.identity)
+    transfer.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+
+    assert_no_difference -> { Account.count } do
+      transfer.import_now
+    end
+
+    assert transfer.reload.failed?
+    assert transfer.error_message.present?
+    assert_nil transfer.imported_account
+  end
+end
