diff --git a/app/models/account/data_transfer/card_exporter.rb b/app/models/account/data_transfer/card_exporter.rb
new file mode 100644
index 0000000..0d6c5f8
--- /dev/null
+++ b/app/models/account/data_transfer/card_exporter.rb
@@ -0,0 +1,40 @@
+class Account::DataTransfer::CardExporter
+  def initialize(user)
+    @user = user
+  end
+
+  def write_to(zip)
+    zip.add_file("manifest.json", JSON.generate(version: Account::DataTransfer::Exporter::VERSION, type: "cards"))
+
+    @user.accessible_cards.preload(:comments, :rich_text_description).find_each do |card|
+      zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_json(card)))
+      attachment_blobs(card).uniq(&:id).each { |blob| add_blob(zip, blob) }
+    end
+  end
+
+  private
+    def card_json(card)
+      card.attributes.merge(
+        "description" => card.description.body&.to_html,
+        "comments" => card.comments.chronologically.map { |comment| comment.attributes.merge("body" => comment.body.body&.to_html) },
+        "attachments" => attachment_blobs(card).map { |blob| { "filename" => blob.filename.to_s, "path" => file_path(blob) } }
+      )
+    end
+
+    def attachment_blobs(card)
+      rich_texts = [ card.rich_text_description, *card.comments.includes(:rich_text_body).map(&:rich_text_body) ].compact
+      [ card.image_blob ].compact + ActiveStorage::Blob.joins(:attachments).where(active_storage_attachments: { record: rich_texts }).to_a
+    end
+
+    def add_blob(zip, blob)
+      return if zip.exists?(file_path(blob))
+
+      zip.add_file(file_path(blob), compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+
+    def file_path(blob)
+      "files/#{blob.id}/#{blob.filename.to_s.gsub(/[^a-zA-Z0-9_.-]/, "_")}"
+    end
+end
