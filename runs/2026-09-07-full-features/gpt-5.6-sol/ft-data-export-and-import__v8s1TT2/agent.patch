+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..a4d0095
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,218 @@
+class Account::DataTransfer::Importer
+  MAX_JSON_SIZE = 100.megabytes
+  MAX_ENTRIES = 2_000_000
+
+  class InvalidArchive < StandardError; end
+
+  def initialize(archive, identity:)
+    @archive = archive
+    @identity = identity
+    @ids = {}
+    @uploaded_keys = []
+  end
+
+  def import
+    read_entries
+    validate_manifest
+
+    Account.transaction do
+      import_records
+      attach_identity
+      create_join_code
+      upload_files
+      @account
+    end
+  rescue
+    delete_uploaded_files
+    raise
+  end
+
+  private
+    def read_entries
+      entries = ZipKit::FileReader.read_zip_structure(io: @archive)
+      raise InvalidArchive, "Archive contains too many files" if entries.size > MAX_ENTRIES
+      raise InvalidArchive, "Archive contains duplicate filenames" unless entries.map(&:filename).uniq.size == entries.size
+      raise InvalidArchive, "Archive contains unsafe filenames" if entries.any? { |entry| unsafe_path?(entry.filename) }
+
+      @entries = entries.index_by(&:filename)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD => error
+      raise InvalidArchive, "This is not a valid Fizzy account file: #{error.message}"
+    end
+
+    def unsafe_path?(path)
+      path.start_with?("/", "\\") || path.split(/[\\\/]/).include?("..") || path.include?("\0")
+    end
+
+    def validate_manifest
+      manifest = read_json("manifest.json")
+      unless manifest["type"] == "account" && manifest["version"] == Account::DataTransfer::Exporter::VERSION
+        raise InvalidArchive, "This file is not a supported Fizzy account export"
+      end
+      @requested_by_id = manifest["requested_by_id"]
+    end
+
+    def import_records
+      source_account = nil
+
+      record_sets.each do |record_set|
+        table = record_set.model.table_name
+        records_for(table).each do |attributes|
+          old_id = attributes["id"]
+          transformed = transform(attributes, model: record_set.model)
+          record_set.model.insert_all!([ transformed ])
+
+          if record_set.model == Account
+            @account = Account.find(transformed.fetch("id"))
+            source_account = old_id
+          end
+        end
+      end
+
+      raise InvalidArchive, "Account data is missing" unless @account
+      @source_account_id = source_account
+    end
+
+    def record_sets
+      sets = []
+      source_account = Struct.new(:id).new("source")
+      Account::DataTransfer::Manifest.new(source_account).each_record_set { |set| sets << set unless set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet) }
+      sets
+    end
+
+    def records_for(table)
+      pattern = %r{\A#{Regexp.escape(table)}/[^/]+\.json\z}
+      @entries.each_value.lazy.select { |entry| entry.filename.match?(pattern) }.map { |entry| read_json_entry(entry) }
+    end
+
+    def transform(attributes, model:)
+      attributes.each_with_object({}) do |(name, value), result|
+        if name == "id"
+          result[name] = mapped_id(value)
+        elsif name == "account_id"
+          result[name] = @account&.id || mapped_id(value)
+        elsif model == Account && name == "external_account_id"
+          result[name] = Account::ExternalIdSequence.next
+        elsif model == ActiveStorage::Blob && name == "key"
+          result[name] = ActiveStorage::Blob.generate_unique_secure_token
+        elsif model == ActiveStorage::Blob && name == "service_name"
+          result[name] = ActiveStorage::Blob.service.name
+        elsif name == "identity_id"
+          result[name] = nil
+        elsif name.end_with?("_id") && value.present?
+          result[name] = mapped_id(value)
+        else
+          result[name] = value
+        end
+      end.tap do |result|
+        result["service_name"] = ActiveStorage::Blob.service.name if model == ActiveStorage::Blob
+      end
+    end
+
+    def mapped_id(old_id)
+      @ids[old_id] ||= ActiveRecord::Type::Uuid.generate
+    end
+
+    def attach_identity
+      imported_user_id = @ids[@requested_by_id]
+      user = @account.users.find_by(id: imported_user_id) || @account.users.where.not(role: :system).first
+      raise InvalidArchive, "Account has no person who can own it" unless user
+
+      @account.users.where(role: :owner).where.not(id: user.id).update_all(role: :admin)
+      user.update_columns(identity_id: @identity.id, role: "owner", active: true, verified_at: Time.current)
+    end
+
+    def create_join_code
+      @account.create_join_code!
+    end
+
+    def upload_files
+      ActiveStorage::Blob.where(account: @account).find_each do |blob|
+        source_id = @ids.key(blob.id)
+        entry = @entries["files/#{source_id}"]
+        raise InvalidArchive, "Attachment data is missing for #{blob.filename}" unless entry
+        raise InvalidArchive, "Attachment size is invalid for #{blob.filename}" unless entry.uncompressed_size == blob.byte_size
+
+        upload_file(blob, entry)
+        @uploaded_keys << [ blob.service, blob.key ]
+      end
+    end
+
+    def upload_file(blob, entry)
+      io = EntryIO.new(entry.extractor_from(@archive), blob.byte_size, blob.checksum)
+      if s3_service?(blob.service)
+        blob.service.send(:upload_stream, key: blob.key, content_type: blob.content_type, part_size: 100.megabytes) do |output|
+          output.binmode
+          IO.copy_stream(io, output)
+        end
+      else
+        blob.service.upload(blob.key, io, checksum: blob.checksum)
+      end
+    end
+
+    def s3_service?(service)
+      defined?(ActiveStorage::Service::S3Service) && service.is_a?(ActiveStorage::Service::S3Service)
+    end
+
+    def delete_uploaded_files
+      @uploaded_keys.each { |service, key| service.delete(key) }
+    end
+
+    def read_json(path)
+      entry = @entries[path] || raise(InvalidArchive, "#{path} is missing")
+      read_json_entry(entry)
+    end
+
+    def read_json_entry(entry)
+      raise InvalidArchive, "#{entry.filename} is too large" if entry.uncompressed_size > MAX_JSON_SIZE
+      JSON.parse(extract(entry))
+    rescue JSON::ParserError => error
+      raise InvalidArchive, "Invalid JSON in #{entry.filename}: #{error.message}"
+    end
+
+    def extract(entry)
+      extractor = entry.extractor_from(@archive)
+      output = String.new(capacity: entry.uncompressed_size, encoding: Encoding::BINARY)
+      until extractor.eof?
+        chunk = extractor.extract(1.megabyte)
+        raise InvalidArchive, "#{entry.filename} expands beyond the allowed size" if output.bytesize + chunk.bytesize > MAX_JSON_SIZE
+        output << chunk
+      end
+      output
+    end
+
+    class EntryIO
+      attr_reader :size
+
+      def initialize(extractor, byte_size, checksum)
+        @extractor = extractor
+        @remaining = @size = byte_size
+        @expected_checksum = checksum
+        @digest = Digest::MD5.new
+      end
+
+      def read(length = 5.megabytes, output = nil)
+        if @extractor.eof?
+          raise InvalidArchive, "Attachment is shorter than its declared size" unless @remaining.zero?
+          verify_checksum
+          return
+        end
+        raise InvalidArchive, "Attachment expands beyond its declared size" if @remaining <= 0
+
+        chunk = @extractor.extract([ length, @remaining ].min)
+        @remaining -= chunk.bytesize
+        @digest.update(chunk)
+        output ? output.replace(chunk) : chunk
+      end
+
+      def rewind
+        raise IOError, "ZIP entries cannot be rewound"
+      end
+
+      private
+        def verify_checksum
+          if @expected_checksum.present? && Base64.strict_encode64(@digest.digest) != @expected_checksum
+            raise ActiveStorage::IntegrityError
+          end
+        end
+    end
+end
