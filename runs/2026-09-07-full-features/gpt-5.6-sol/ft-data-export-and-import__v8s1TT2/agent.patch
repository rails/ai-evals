+class Account::ImportsController < ApplicationController
+  def new
+    @import = Import.new
+  end
+
+  def create
+    @import = Import.new(account: Current.account, identity: Current.identity)
+    @import.file.attach(import_params[:file])
+
+    if @import.save
+      @import.import_later
+      redirect_to account_settings_path, notice: "We’ll email you when your import is finished."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def import_params
+      params.expect(import: [ :file ])
+    end
+end
