+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,26 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :show
+
+  before_action :ensure_admin, only: :create
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, export_type: :account)
+    export.generate_later
+    redirect_to account_settings_path, notice: "We’ll email you when your account export is ready."
+  end
+
+  def show
+    export = Current.account.exports.find(params[:id])
+    if valid_download?(export)
+      ActiveStorage::Current.url_options = { protocol: request.protocol, host: request.host, port: request.port }
+      redirect_to export.file.url(expires_in: 1.day, disposition: :attachment), allow_other_host: true
+    else
+      head :gone
+    end
+  end
+
+  private
+    def valid_download?(export)
+      export.downloadable? && export == Export.find_signed(params[:token], purpose: :download)
+    end
+end
