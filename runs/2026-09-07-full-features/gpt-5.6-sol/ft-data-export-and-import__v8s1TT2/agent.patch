diff --git a/test/controllers/account/exports_controller_test.rb b/test/controllers/account/exports_controller_test.rb
new file mode 100644
index 0000000..c859992
--- /dev/null
+++ b/test/controllers/account/exports_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  test "admin requests an account export" do
+    sign_in_as users(:jason)
+
+    assert_difference -> { Export.count }, 1 do
+      assert_enqueued_with(job: ExportJob) { post account_exports_path }
+    end
+
+    assert_redirected_to account_settings_path
+    assert_equal "account", Export.last.export_type
+  end
+
+  test "member cannot request an account export" do
+    sign_in_as users(:jz)
+
+    assert_no_difference -> { Export.count } do
+      post account_exports_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "download requires a current signed link" do
+    sign_in_as users(:jason)
+    export = Export.create!(account: Current.account, user: users(:jason), export_type: :account, status: :completed, expires_at: 1.day.from_now)
+    export.file.attach(io: StringIO.new("zip"), filename: "data.zip", content_type: "application/zip")
+
+    get account_export_path(export, token: export.signed_id(expires_in: 1.day, purpose: :download))
+    assert_response :redirect
+
+    export.update!(expires_at: 1.minute.ago)
+    get account_export_path(export, token: export.signed_id(expires_in: 1.day, purpose: :download))
+    assert_response :gone
+  end
+end
diff --git a/test/controllers/account/imports_controller_test.rb b/test/controllers/account/imports_controller_test.rb
