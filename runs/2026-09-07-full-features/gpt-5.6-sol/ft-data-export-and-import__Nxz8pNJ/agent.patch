diff --git a/test/controllers/exports_controller_test.rb b/test/controllers/exports_controller_test.rb
new file mode 100644
index 0000000..ebab65e
--- /dev/null
+++ b/test/controllers/exports_controller_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as :kevin }
+
+  test "one-day token downloads completed export" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :cards, status: :completed)
+    export.file.attach(io: StringIO.new("zip"), filename: "cards.zip", content_type: "application/zip")
+    get download_export_path(export.download_token)
+    assert_response :redirect
+    assert_match "/rails/active_storage/", response.location
+  end
+
+  test "download token expires after one day" do
+    export = Export.create!(account: Current.account, user: users(:kevin), kind: :cards, status: :completed)
+    export.file.attach(io: StringIO.new("zip"), filename: "cards.zip", content_type: "application/zip")
+    token = export.download_token
+
+    travel 1.day + 1.second do
+      get download_export_path(token)
+      assert_response :not_found
+    end
+  end
+
+  test "invalid token is rejected" do
+    get download_export_path("bad-token")
+    assert_response :not_found
+  end
+end
