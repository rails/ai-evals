diff --git a/saas/app/controllers/stripe/checkouts_controller.rb b/saas/app/controllers/stripe/checkouts_controller.rb
new file mode 100644
index 0000000..f42e6f8
--- /dev/null
+++ b/saas/app/controllers/stripe/checkouts_controller.rb
@@ -0,0 +1,34 @@
+class Stripe::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Account::Plan[params.require(:plan)]
+    return head :unprocessable_content unless plan.paid?
+
+    options = {
+      mode: "subscription",
+      client_reference_id: Current.account.id,
+      line_items: [ { price: price_id_for(plan), quantity: 1 } ],
+      metadata: { account_id: Current.account.id },
+      subscription_data: { metadata: { account_id: Current.account.id } },
+      success_url: account_settings_url(billing: "success"),
+      cancel_url: account_settings_url
+    }
+    if customer_id = Current.account.billing_subscription&.stripe_customer_id
+      options[:customer] = customer_id
+    else
+      options[:customer_email] = Current.identity.email_address
+    end
+
+    session = ::Stripe::Checkout::Session.create(options)
+    redirect_to session.url, allow_other_host: true
+  end
+
+  private
+    def price_id_for(plan)
+      case plan.key
+      when "unlimited" then ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID")
+      when "unlimited_plus" then ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+      end
+    end
+end
