diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..c33838e
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,46 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(:name)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+  end
+
+  def comp
+    account.create_billing_waiver! unless account.comped?
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+  end
+
+  def uncomp
+    account.billing_waiver&.destroy!
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+  end
+
+  def override
+    values = override_params.to_h.compact_blank
+    if values.empty?
+      account.overridden_limit&.destroy!
+    else
+      record = account.overridden_limit || account.build_overridden_limit
+      record.update!(values)
+    end
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+  end
+
+  def reset
+    account.overridden_limit&.destroy!
+    redirect_to Fizzy::Saas::Engine.routes.url_helpers.admin_account_path(account)
+  end
+
+  private
+    def account
+      @account ||= Account.find(params[:id])
+    end
+
+    def override_params
+      params.expect(overridden_limit: [ :card_count, :bytes_used ])
+    end
+end
