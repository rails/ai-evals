diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..70d5b44
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,37 @@
+class Account::Plan
+  PLANS = {
+    "free" => { name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+    "unlimited" => { name: "Unlimited", price: 20_00, card_limit: nil, storage_limit: 5.gigabytes },
+    "unlimited_plus" => { name: "Unlimited+", price: 25_00, card_limit: nil, storage_limit: 500.gigabytes }
+  }.freeze
+
+  attr_reader :key
+
+  def self.[](key)
+    new(PLANS.key?(key.to_s) ? key.to_s : "free")
+  end
+
+  def self.from_price_id(price_id)
+    prices = {
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] => "unlimited",
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] => "unlimited_plus"
+    }.reject { |id, _key| id.blank? }
+    key = prices.fetch(price_id, "free")
+    self[key]
+  end
+
+  def initialize(key)
+    @key = key
+  end
+
+  def name = attributes.fetch(:name)
+  def price = attributes.fetch(:price)
+  def card_limit = attributes.fetch(:card_limit)
+  def storage_limit = attributes.fetch(:storage_limit)
+  def paid? = price.positive?
+  def free? = !paid?
+  def to_s = name
+
+  private
+    def attributes = PLANS.fetch(key)
+end
diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
