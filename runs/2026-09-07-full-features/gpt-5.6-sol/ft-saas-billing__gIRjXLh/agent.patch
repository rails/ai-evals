diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..fabb259
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.billing_waiver&.destroy!
+    @account.overridden_limit&.destroy!
+  end
+
+  test "staff lists accounts and opens account tools" do
+    sign_in_as :david
+    untenanted { get saas.admin_accounts_path }
+    assert_response :success
+    assert_select "a", text: @account.name
+
+    untenanted { get saas.admin_account_path(@account) }
+    assert_response :success
+    assert_select "input[name='overridden_limit[card_count]']"
+    assert_select "input[name='overridden_limit[bytes_used]']"
+    assert_select "button", text: "Comp"
+  end
+
+  test "non staff cannot access account tools" do
+    sign_in_as :jz
+    untenanted { get saas.admin_accounts_path }
+    assert_response :forbidden
+  end
+
+  test "staff can comp uncomp override and reset" do
+    sign_in_as :david
+
+    untenanted { post saas.comp_admin_account_path(@account) }
+    assert_predicate @account.reload, :comped?
+
+    untenanted do
+      patch saas.override_admin_account_path(@account), params: {
+        overridden_limit: { card_count: 999, bytes_used: 1234 }
+      }
+    end
+    assert_equal 999, @account.reload.effective_card_count
+    assert_equal 1234, @account.effective_bytes_used
+
+    untenanted { delete saas.reset_admin_account_path(@account) }
+    assert_nil @account.reload.overridden_limit
+
+    untenanted { delete saas.uncomp_admin_account_path(@account) }
+    assert_not_predicate @account.reload, :comped?
+  end
+end
diff --git a/saas/test/controllers/card/billing_limited_test.rb b/saas/test/controllers/card/billing_limited_test.rb
new file mode 100644
index 0000000..166c78b
--- /dev/null
+++ b/saas/test/controllers/card/billing_limited_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Card::BillingLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @account.update_column(:cards_count, 100)
+    @account.overridden_limit&.destroy!
+    @account.billing_subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    Account.any_instance.stubs(:bytes_used).returns(0)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+  end
+
+  test "free account at limit cannot create via API but can still draft" do
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug), params: { card: { title: "No" } }, as: :json
+    end
+    assert_response :forbidden
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "the one thousandth draft can publish" do
+    card = boards(:miltons_wish_list).cards.create!(creator: users(:mike), status: :drafted, title: "Draft")
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    post card_publish_path(card, script_name: @account.slug)
+
+    assert_response :redirect
+    assert_predicate card.reload, :published?
+  end
+
+  test "a draft beyond one thousand cannot publish" do
+    card = boards(:miltons_wish_list).cards.create!(creator: users(:mike), status: :drafted, title: "Draft")
+    @account.create_overridden_limit!(card_count: 1_001)
+
+    post card_publish_path(card, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert_predicate card.reload, :drafted?
+  end
+end
diff --git a/saas/test/controllers/stripe/billing_controller_test.rb b/saas/test/controllers/stripe/billing_controller_test.rb
new file mode 100644
index 0000000..666ef72
--- /dev/null
+++ b/saas/test/controllers/stripe/billing_controller_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Stripe::BillingControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.billing_subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    @old_env = ENV.to_h.slice("STRIPE_MONTHLY_V1_PRICE_ID", "STRIPE_WEBHOOK_SECRET")
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+  end
+
+  teardown do
+    %w[ STRIPE_MONTHLY_V1_PRICE_ID STRIPE_WEBHOOK_SECRET ].each { |key| ENV.delete(key) }
+    @old_env.each { |key, value| ENV[key] = value }
+  end
+
+test "account admin sees current plan and upgrade in settings" do
+  sign_in_as :mike
+
+  get account_settings_path(script_name: @account.slug)
+
+  assert_response :success
+  assert_select "strong", text: "Free"
+  assert_select "h3", text: "Upgrade"
+  assert_select "button", text: /Unlimited — \$20\/month/
+end
+
+  test "admin checkout redirects to Stripe hosted checkout" do
+    sign_in_as :mike
+    hosted = Struct.new(:url).new("https://checkout.stripe.test/session")
+    Stripe::Checkout::Session.expects(:create).with do |options|
+      options[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        options[:subscription_data][:metadata][:account_id] == @account.id
+    end.returns(hosted)
+
+    post saas.stripe_checkout_path(script_name: @account.slug), params: { plan: "unlimited" }
+
+    assert_redirected_to hosted.url
+  end
+
+test "paid account admin redirects to Stripe hosted customer portal" do
+  @account.create_billing_subscription!(
+    plan_key: "unlimited", status: "active",
+    stripe_customer_id: "cus_portal", stripe_subscription_id: "sub_portal"
+  )
+  sign_in_as :mike
+  hosted = Struct.new(:url).new("https://billing.stripe.test/session")
+  Stripe::BillingPortal::Session.expects(:create).with do |options|
+    options[:customer] == "cus_portal" && options[:return_url].end_with?("/account/settings")
+  end.returns(hosted)
+
+  post saas.stripe_portal_path(script_name: @account.slug)
+
+  assert_redirected_to hosted.url
+end
+
+  test "non admin cannot start checkout" do
+    sign_in_as :jz
+    post saas.stripe_checkout_path(plan: "unlimited")
+    assert_response :forbidden
+  end
+
+  test "signed webhook updates subscription and invalid signature is rejected" do
+    payload = {
+      id: "evt_test", type: "customer.subscription.created", created: 100,
+      data: { object: {
+        id: "sub_test", customer: "cus_test", status: "active",
+        metadata: { account_id: @account.id },
+        items: { data: [ { price: { id: "price_unlimited" } } ] }
+      } }
+    }.to_json
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => signature(payload) }
+    end
+    assert_response :ok
+    assert_equal "Unlimited", @account.reload.plan.name
+
+    untenanted do
+      post Fizzy::Saas::Engine.routes.url_helpers.stripe_webhooks_path, params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "bad" }
+    end
+    assert_response :bad_request
+  end
+
+  private
+    def signature(payload)
+      timestamp = Time.now
+      digest = Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      Stripe::Webhook::Signature.generate_header(timestamp, digest)
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..a5de5ef
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.billing_subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    @account.overridden_limit&.destroy!
+  end
+
+  test "free plan has approved limits and final 100 card warning" do
+    @account.update_column(:cards_count, 900)
+
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_equal 100, @account.cards_remaining
+    assert_predicate @account, :nearing_card_limit?
+  end
+
+  test "active paid plans have unlimited cards and their own storage" do
+    subscribe("unlimited")
+    assert_equal "Unlimited", @account.plan.name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.billing_subscription.update!(plan_key: "unlimited_plus")
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "inactive subscription falls back to free" do
+    subscribe("unlimited", status: "canceled")
+    assert_equal "Free", @account.plan.name
+  end
+
+  test "comp grants Unlimited and uncomp restores subscription entitlement" do
+    subscribe("unlimited_plus")
+    @account.create_billing_waiver!
+    assert_equal "Unlimited", @account.reload.plan.name
+
+    @account.billing_waiver.destroy!
+    assert_equal "Unlimited+", @account.reload.plan.name
+  end
+
+  test "usage override drives enforcement without changing real usage" do
+    @account.update_column(:cards_count, 12)
+    @account.stubs(:bytes_used).returns(20)
+    @account.create_overridden_limit!(card_count: 1_000, bytes_used: 1.gigabyte + 1)
+
+    assert_equal 12, @account.cards_count
+    assert_equal 1_000, @account.effective_card_count
+    assert_equal 1.gigabyte + 1, @account.effective_bytes_used
+    assert_predicate @account, :card_limit_reached?
+    assert_predicate @account, :exceeding_storage_limit?
+  end
+
+  private
+    def subscribe(plan_key, status: "active")
+      @account.create_billing_subscription!(
+        plan_key: plan_key, status: status,
+        stripe_customer_id: "cus_#{@account.id}", stripe_subscription_id: "sub_#{@account.id}"
+      )
+    end
+end
