+require "test_helper"
+
+class StripeSubscriptionSyncTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.billing_subscription&.destroy!
+    @old_price = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+  end
+
+  teardown do
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = @old_price
+  end
+
+  test "subscription event sets account plan and deletion returns it to free" do
+    StripeSubscriptionSync.new(event("customer.subscription.created", created: 100)).call
+
+    subscription = @account.reload.billing_subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal "Unlimited", @account.plan.name
+
+    StripeSubscriptionSync.new(event("customer.subscription.deleted", created: 101)).call
+    assert_equal "canceled", @account.reload.billing_subscription.status
+    assert_equal "Free", @account.plan.name
+  end
+
+  test "older event cannot replace newer subscription state" do
+    StripeSubscriptionSync.new(event("customer.subscription.updated", created: 200, status: "active")).call
+    StripeSubscriptionSync.new(event("customer.subscription.updated", created: 100, status: "canceled")).call
+
+    assert_equal "active", @account.reload.billing_subscription.status
+  end
+
+  private
+    def event(type, created:, status: "active")
+      Stripe::Event.construct_from(
+        id: "evt_#{created}", type: type, created: created,
+        data: { object: {
+          id: "sub_test", customer: "cus_test", status: status,
+          metadata: { account_id: @account.id }, current_period_end: 1_800_000_000,
+          items: { data: [ { price: { id: "price_unlimited" } } ] }
+        } }
+      )
+    end
+end
