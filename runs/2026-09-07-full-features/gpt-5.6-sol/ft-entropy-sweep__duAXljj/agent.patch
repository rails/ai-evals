diff --git a/script/check-entropy-sweep-query-plan.rb b/script/check-entropy-sweep-query-plan.rb
new file mode 100755
index 0000000..684d642
--- /dev/null
+++ b/script/check-entropy-sweep-query-plan.rb
@@ -0,0 +1,20 @@
+#!/usr/bin/env ruby
+# Checks that SQLite can narrow entropy-sweep candidates before performing joins.
+ENV["RAILS_ENV"] ||= "test"
+require_relative "../config/environment"
+
+connection = Card.connection
+abort "This query-plan check is intended for SQLite" unless connection.adapter_name == "SQLite"
+
+sql = Card.due_to_be_postponed.to_sql
+plan = connection.execute("EXPLAIN QUERY PLAN #{sql}").map { |row| row.fetch("detail") }
+
+puts sql
+puts "\nQuery plan:"
+puts plan.map { |detail| "  #{detail}" }
+
+candidate_lookup = plan.find { |detail| detail.match?(/SEARCH cards USING .*index_cards_on_status_and_last_active_at .*last_active_at</) }
+full_scan = plan.any? { |detail| detail == "SCAN cards" }
+
+abort "\nSLOW: entropy sweep performs a full cards-table scan" if full_scan || !candidate_lookup
+puts "\nOK: entropy sweep narrows cards through the status/activity index"
