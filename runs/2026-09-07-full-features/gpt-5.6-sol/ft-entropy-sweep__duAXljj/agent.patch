@@ -32,6 +32,18 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_equal original_period, account_entropy.reload.auto_postpone_period
   end
 
+  test "due scope applies the shortest entropy period as an indexable candidate cutoff" do
+    freeze_time
+    shortest_period = Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.min
+    entropies(:writebook_board).update!(auto_postpone_period: shortest_period)
+
+    cards(:logo).update!(last_active_at: Time.current - shortest_period + 1.second)
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+
+    cards(:logo).update!(last_active_at: Time.current - shortest_period)
+    assert_includes Card.due_to_be_postponed, cards(:logo)
+  end
+
   test "auto postpone all due using the default account entropy" do
     entropies(:writebook_board).destroy
 
