--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,15 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  def publish
+    update!(publication_key: self.class.generate_unique_secure_token) unless published?
+  end
+
+  def unpublish
+    update!(publication_key: nil)
+  end
+
+  def published?
+    publication_key.present?
+  end
+end
