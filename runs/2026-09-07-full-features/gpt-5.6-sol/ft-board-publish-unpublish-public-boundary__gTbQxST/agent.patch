diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..ad86687
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin publishes and unpublishes a board" do
+    assert_changes -> { @board.reload.publication_key }, from: nil do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :success
+    public_url = @response.parsed_body["public_url"]
+    assert_equal public_board_url(@board.publication_key), public_url
+
+    assert_changes -> { @board.reload.publication_key }, to: nil do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "publishing from HTML redirects to the board" do
+    post board_publication_path(@board)
+
+    assert_redirected_to @board
+    assert @board.reload.published?
+  end
+
+  test "publishing an already public board keeps its URL" do
+    post board_publication_path(@board), as: :json
+    original_key = @board.reload.publication_key
+
+    assert_no_changes -> { @board.reload.publication_key } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_equal original_key, @board.publication_key
+  end
+
+  test "only admins can publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    @board.update!(publication_key: "existing-secret")
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_equal "existing-secret", @board.reload.publication_key
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..b90a513
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.update!(publication_key: "public-board-secret")
+  end
+
+  test "board JSON includes a nil public URL by default" do
+    sign_in_as :kevin
+    @board.unpublish
+
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "anyone with the key can open a board" do
+    get public_board_path(@board.publication_key)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a[href='#{public_board_card_path(@board.publication_key, cards(:logo).number)}']"
+    assert_no_match cards(:unfinished_thoughts).title, @response.body
+  end
+
+  test "public board JSON contains columns and only published cards" do
+    get public_board_path(@board.publication_key), as: :json
+
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal @board.columns.count, @response.parsed_body["columns"].count
+    assert_includes @response.parsed_body["cards"].pluck("id"), cards(:logo).id
+    assert_not_includes @response.parsed_body["cards"].pluck("id"), cards(:unfinished_thoughts).id
+  end
+
+  test "anyone with the key can open a column and a published card" do
+    get public_board_column_path(@board.publication_key, columns(:writebook_triage))
+    assert_response :success
+    assert_match columns(:writebook_triage).name, @response.body
+
+    get public_board_card_path(@board.publication_key, cards(:logo).number)
+    assert_response :success
+    assert_select "h1", text: cards(:logo).title
+  end
+
+  test "drafts and resources belonging to another board cannot be opened" do
+    draft = @board.cards.create!(number: 99, title: "Secret draft", status: :drafted, creator: users(:kevin))
+    get public_board_card_path(@board.publication_key, draft.number)
+    assert_response :not_found
+
+    other_card = cards(:radio)
+    other_card.update_column(:number, 100)
+    get public_board_card_path(@board.publication_key, other_card.number)
+    assert_response :not_found
+
+    other_column = boards(:miltons_wish_list).columns.create!(name: "Private")
+    get public_board_column_path(@board.publication_key, other_column)
+    assert_response :not_found
+  end
+
+  test "an invalid or revoked key cannot be used" do
+    get public_board_path("wrong-secret")
+    assert_response :not_found
+
+    old_key = @board.publication_key
+    @board.unpublish
+    get public_board_path(old_key)
+    assert_response :not_found
+  end
+end
