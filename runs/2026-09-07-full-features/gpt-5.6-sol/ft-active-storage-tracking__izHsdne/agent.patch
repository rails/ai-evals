new file mode 100644
index 0000000..c838043
--- /dev/null
+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,72 @@
+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :mark_storage_owner_destroying, prepend: true
+    after_destroy_commit :refresh_account_storage_usage_later
+  end
+
+  attr_reader :storage_owner_destroying
+  alias_method :storage_owner_destroying?, :storage_owner_destroying
+
+  def bytes_used
+    self[:bytes_used]
+  end
+
+  def refresh_storage_usage_later
+    return if storage_owner_destroying? || destroyed? || account.storage_owner_destroying?
+
+    if mark_storage_usage_stale
+      Board::RefreshStorageUsageJob.perform_later(self)
+    end
+  end
+
+  def refresh_storage_usage_now
+    update_columns storage_usage_stale: false
+    calculated_bytes = storage_blobs.sum(:byte_size)
+
+    account.with_lock do
+      update_columns bytes_used: calculated_bytes
+      account.update_columns bytes_used: account.boards.sum(:bytes_used)
+    end
+  end
+
+  private
+    def mark_storage_owner_destroying
+      @storage_owner_destroying = true
+    end
+
+    def mark_storage_usage_stale
+      self.class.where(id: id, storage_usage_stale: false).update_all(storage_usage_stale: true) == 1
+    end
+
+    def storage_blobs
+      ActiveStorage::Blob.where(id: storage_attachments.select(:blob_id))
+    end
+
+    def storage_attachments
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: cards.select(:id), name: "image").or(
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: storage_rich_texts.select(:id), name: "embeds")
+      )
+    end
+
+    def storage_rich_texts
+      board_descriptions.or(card_descriptions).or(comment_bodies)
+    end
+
+    def board_descriptions
+      ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description")
+    end
+
+    def card_descriptions
+      ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description")
+    end
+
+    def comment_bodies
+      ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id), name: "body")
+    end
+
+    def refresh_account_storage_usage_later
+      account.refresh_storage_usage_later
+    end
+end
