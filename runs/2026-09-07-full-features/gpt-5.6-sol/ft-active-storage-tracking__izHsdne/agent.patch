diff --git a/app/models/concerns/storage_usage_tracking.rb b/app/models/concerns/storage_usage_tracking.rb
new file mode 100644
index 0000000..fcf9ea6
--- /dev/null
+++ b/app/models/concerns/storage_usage_tracking.rb
@@ -0,0 +1,38 @@
+module StorageUsageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_upload :refresh_storage_usage_later
+    after_destroy_commit :refresh_storage_usage_later
+  end
+
+  def delete
+    board = storage_usage_board
+    super.tap { board&.refresh_storage_usage_later }
+  end
+
+  private
+    def refresh_storage_usage_later
+      storage_usage_board&.refresh_storage_usage_later
+    end
+
+    def storage_usage_board
+      case record
+      when Card
+        record.board if name == "image"
+      when ActionText::RichText
+        storage_usage_board_for_rich_text
+      end
+    end
+
+    def storage_usage_board_for_rich_text
+      case record.record
+      when Board
+        record.record if name == "embeds" && record.name == "public_description"
+      when Card
+        record.record.board if name == "embeds" && record.name == "description"
+      when Comment
+        record.record.board if name == "embeds" && record.name == "body"
+      end
+    end
+end
