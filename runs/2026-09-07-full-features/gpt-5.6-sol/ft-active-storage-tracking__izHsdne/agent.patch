+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :mark_storage_owner_destroying, prepend: true
+  end
+
+  attr_reader :storage_owner_destroying
+  alias_method :storage_owner_destroying?, :storage_owner_destroying
+
+  def bytes_used
+    self[:bytes_used]
+  end
+
+  def refresh_storage_usage_later
+    return if storage_owner_destroying? || destroyed?
+
+    if mark_storage_usage_stale
+      Account::RefreshStorageUsageJob.perform_later(self)
+    end
+  end
+
+  def refresh_storage_usage_now
+    with_lock do
+      update_columns storage_usage_stale: false, bytes_used: boards.sum(:bytes_used)
+    end
+  end
+
+  private
+    def mark_storage_owner_destroying
+      @storage_owner_destroying = true
+    end
+
+    def mark_storage_usage_stale
+      self.class.where(id: id, storage_usage_stale: false).update_all(storage_usage_stale: true) == 1
+    end
+end
