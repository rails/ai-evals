diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..873e606
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,143 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = @board.cards.create!(title: "Storage usage", status: :published)
+  end
+
+  test "counts card images in the board and account in the background" do
+    attach(@card.image, "image contents")
+
+    assert_equal 0, @board.reload.bytes_used
+    perform_storage_jobs
+
+    assert_equal 14, @board.reload.bytes_used
+    assert_equal 14, @account.reload.bytes_used
+  end
+
+  test "counts embeds in board descriptions, card descriptions, and comments" do
+    comment = @card.comments.create!(body: "Comment", creator: users(:david))
+    attach_embed(@board, :public_description)
+    attach_embed(@card, :description)
+    attach_embed(comment, :body)
+    perform_storage_jobs
+
+    expected = file_fixture("moon.jpg").size * 3
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+  end
+
+  test "does not count unrelated account attachments" do
+    attach(users(:david).avatar, "avatar")
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "refreshes both boards when a card moves" do
+    other_board = @account.boards.create!(name: "Other", creator: users(:david))
+    attach(@card.image, "image")
+    perform_storage_jobs
+
+    @card.update!(board: other_board)
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 5, other_board.reload.bytes_used
+    assert_equal 5, @account.reload.bytes_used
+  end
+
+  test "removes usage when an attachment is removed" do
+    attach(@card.image, "image")
+    perform_storage_jobs
+
+    @card.image.detach
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "counts a shared blob once per board" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("shared"), filename: "shared.txt")
+    @card.image.attach(blob)
+    other_card = @board.cards.create!(title: "Other", status: :published)
+    other_card.image.attach(blob)
+    perform_storage_jobs
+
+    assert_equal 6, @board.reload.bytes_used
+    assert_equal 6, @account.reload.bytes_used
+  end
+
+  test "removes usage when a rich text embed is removed" do
+    attach_embed(@card, :description)
+    perform_storage_jobs
+    assert_operator @board.reload.bytes_used, :>, 0
+
+    @card.update!(description: "No attachment")
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "coalesces refreshes while a board refresh is pending" do
+    other_card = @board.cards.create!(title: "Other", status: :published)
+
+    assert_enqueued_jobs 1, only: Board::RefreshStorageUsageJob do
+      attach(@card.image, "first")
+      attach(other_card.image, "second")
+    end
+  end
+
+  test "dispatches refreshes for stale boards" do
+    @board.update_column(:storage_usage_stale, true)
+
+    assert_enqueued_with(job: Board::RefreshStorageUsageJob, args: [ @board ]) do
+      RefreshStaleStorageUsageJob.perform_now
+    end
+  end
+
+  test "removes usage when a card is destroyed" do
+    attach(@card.image, "image")
+    perform_storage_jobs
+
+    @card.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removes a destroyed board's usage from its account" do
+    attach(@card.image, "image")
+    perform_storage_jobs
+
+    @board.destroy!
+    perform_storage_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  private
+    def perform_storage_jobs
+      3.times do
+        perform_enqueued_jobs only: [ Board::RefreshStorageUsageJob, Account::RefreshStorageUsageJob ]
+      end
+    end
+
+    def attach_embed(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+      )
+      record.update!(attribute => ActionText::Attachment.from_attachable(blob).to_html)
+    end
+
+    def attach(attachment, contents)
+      attachment.attach(io: StringIO.new(contents), filename: "file.txt", content_type: "text/plain")
+    end
+end
