diff --git a/app/models/notification/email_bundleable.rb b/app/models/notification/email_bundleable.rb
new file mode 100644
index 0000000..5dda1c3
--- /dev/null
+++ b/app/models/notification/email_bundleable.rb
@@ -0,0 +1,45 @@
+module Notification::EmailBundleable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :bundle_for_email, if: :source_id_previously_changed?
+  end
+
+  def bundle_for_email
+    if user.settings.bundle_email_frequency != "never"
+      user.settings.with_lock do
+        add_to_email_bundle
+      end
+    end
+  end
+
+  private
+    def add_to_email_bundle
+      bundle = current_email_bundle || open_email_bundle
+      bundle.include(self)
+    end
+
+    def current_email_bundle
+      if bundle = user.notification_bundles.open.first
+        if bundle.ends_at > Time.current
+          bundle
+        else
+          bundle.close
+          Notification::Bundle::DeliveryJob.perform_later(bundle)
+          nil
+        end
+      end
+    end
+
+    def open_email_bundle
+      frequency = user.settings.bundle_email_frequency
+      starts_at = Time.current
+      bundle = user.notification_bundles.create!(
+        frequency: frequency,
+        starts_at: starts_at,
+        ends_at: starts_at + Notification::Bundle.duration_for(frequency)
+      )
+      Notification::Bundle::DeliveryJob.set(wait_until: bundle.ends_at).perform_later(bundle)
+      bundle
+    end
+end
