diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..d991a8c
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,61 @@
+class Notification::Bundle < ApplicationRecord
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :entries, class_name: "Notification::Bundle::Entry", foreign_key: :notification_bundle_id, dependent: :destroy
+  has_many :notifications, through: :entries
+
+  scope :open, -> { where(open: true) }
+
+  validates :frequency, inclusion: { in: DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_it_starts
+
+  class << self
+    def duration_for(frequency)
+      DURATIONS.fetch(frequency)
+    end
+  end
+
+  def include(notification)
+    entries.create_or_find_by!(notification: notification)
+  end
+
+  def close
+    update!(open: nil)
+  end
+
+  def deliver
+    user.settings.with_lock do
+      reload
+
+      if open? && ends_at > Time.current
+        Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+      elsif !sent?
+        close if open?
+        NotificationMailer.with(bundle: self).digest.deliver_now if deliverable?
+        update!(sent_at: Time.current)
+      end
+    end
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  private
+    def ends_after_it_starts
+      errors.add(:ends_at, "must be after starts_at") if starts_at && ends_at && ends_at <= starts_at
+    end
+
+    def deliverable?
+      notifications.exists? && user.active? && account.active? && user.identity.present? &&
+        user.settings.bundle_email_frequency != "never"
+    end
+end
