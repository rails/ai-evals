diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..833d785
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "does not bundle when email bundles are disabled" do
+    assert_no_enqueued_jobs do
+      assert_no_difference "Notification::Bundle.count" do
+        @notification.bundle_for_email
+      end
+    end
+  end
+
+  test "opens a window from the first notification and adds later notifications to it" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    starts_at = Time.zone.parse("2026-03-01 09:17:00")
+
+    travel_to starts_at do
+      assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: starts_at + 4.hours do
+        @notification.bundle_for_email
+      end
+    end
+
+    bundle = Notification::Bundle.last
+    assert_equal starts_at, bundle.starts_at
+    assert_equal starts_at + 4.hours, bundle.ends_at
+    assert_equal "every_few_hours", bundle.frequency
+    assert_equal [ @notification ], bundle.notifications
+
+    travel_to starts_at + 3.hours do
+      assert_no_enqueued_jobs do
+        notifications(:buy_domain_sent_back_to_triage_kevin).bundle_for_email
+      end
+    end
+
+    assert_equal 1, Notification::Bundle.open.where(user: @user).count
+    assert_equal 2, bundle.reload.notifications.count
+  end
+
+  test "opens a non-overlapping window after the prior window expires" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    starts_at = Time.zone.parse("2026-03-01 09:17:00")
+
+    travel_to starts_at do
+      @notification.bundle_for_email
+    end
+
+    first_bundle = Notification::Bundle.last
+
+    travel_to first_bundle.ends_at + 1.minute do
+      notifications(:buy_domain_sent_back_to_triage_kevin).bundle_for_email
+    end
+
+    second_bundle = Notification::Bundle.last
+    assert_not first_bundle.reload.open?
+    assert second_bundle.open?
+    assert_operator first_bundle.ends_at, :<=, second_bundle.starts_at
+    assert_equal 1, Notification::Bundle.open.where(user: @user).count
+  end
+
+
+  test "delivers one email once and closes the window" do
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    @notification.bundle_for_email
+    bundle = Notification::Bundle.last
+
+    travel_to bundle.ends_at + 1.second do
+      assert_difference "ActionMailer::Base.deliveries.size", 1 do
+        bundle.deliver
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "1 new notification in Fizzy", email.subject
+    assert_includes email.text_part.body.to_s, @notification.card.title
+    assert bundle.reload.sent?
+    assert_not bundle.open?
+
+    assert_no_difference "ActionMailer::Base.deliveries.size" do
+      bundle.deliver
+    end
+  end
+
+  test "turning email off cancels an open window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification.bundle_for_email
+    bundle = Notification::Bundle.last
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to bundle.ends_at + 1.second do
+      assert_no_difference "ActionMailer::Base.deliveries.size" do
+        bundle.deliver
+      end
+    end
+
+    assert bundle.reload.sent?
+    assert_not bundle.open?
+  end
+
+  test "an early delivery job keeps the current window open" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification.bundle_for_email
+    bundle = Notification::Bundle.last
+
+    assert_enqueued_with job: Notification::Bundle::DeliveryJob, at: bundle.ends_at do
+      bundle.deliver
+    end
+
+    assert bundle.reload.open?
+    assert_not bundle.sent?
+  end
+
+
+  test "the database prevents two open windows for one person" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification.bundle_for_email
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      @user.notification_bundles.create!(
+        frequency: "daily",
+        starts_at: Time.current,
+        ends_at: 1.day.from_now
+      )
+    end
+  end
+
+  test "uses the selected elapsed duration" do
+    assert_equal 4.hours, Notification::Bundle.duration_for("every_few_hours")
+    assert_equal 1.day, Notification::Bundle.duration_for("daily")
+    assert_equal 1.week, Notification::Bundle.duration_for("weekly")
+  end
+end
