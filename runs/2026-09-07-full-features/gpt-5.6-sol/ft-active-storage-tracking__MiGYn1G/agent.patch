diff --git a/app/models/storage/trackable_attachment.rb b/app/models/storage/trackable_attachment.rb
new file mode 100644
index 0000000..d84abd0
--- /dev/null
+++ b/app/models/storage/trackable_attachment.rb
@@ -0,0 +1,38 @@
+module Storage::TrackableAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_board
+    after_create :recalculate_storage_usage_later
+    after_destroy :recalculate_storage_usage_later
+  end
+
+  def delete
+    @storage_board = storage_board
+    super.tap { recalculate_storage_usage_later }
+  end
+
+  private
+    def remember_storage_board
+      @storage_board = storage_board
+    end
+
+    def recalculate_storage_usage_later
+      if (board = @storage_board || storage_board) && !board.destroyed? && !board.destroyed_by_association
+        board.recalculate_storage_later
+      end
+    end
+
+    def storage_board
+      case [ record_type, name ]
+      when [ "Card", "image" ]
+        record.board
+      when [ "ActionText::RichText", "embeds" ]
+        case owner = record.record
+        when Board then owner
+        when Card then owner.board
+        when Comment then owner.card.board
+        end
+      end
+    end
+end
diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..8bbd789
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,23 @@
+class Storage::Usage
+  def self.for_board(board)
+    card_ids = Card.where(board_id: board.id).select(:id)
+    comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+    rich_text_ids = ActionText::RichText.where(
+      record_type: "Board", record_id: board.id, name: "public_description"
+    ).or(ActionText::RichText.where(
+      record_type: "Card", record_id: card_ids, name: "description"
+    )).or(ActionText::RichText.where(
+      record_type: "Comment", record_id: comment_ids, name: "body"
+    )).select(:id)
+
+    attachments = ActiveStorage::Attachment.where(
+      record_type: "Card", record_id: card_ids, name: "image"
+    ).or(ActiveStorage::Attachment.where(
+      record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds"
+    ))
+
+    ActiveStorage::Blob.where(id: attachments.select(:blob_id)).joins(:attachments)
+      .merge(attachments).sum(:byte_size)
+  end
+end
