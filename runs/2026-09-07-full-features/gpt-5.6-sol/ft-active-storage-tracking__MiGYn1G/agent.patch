   scope :alphabetically, -> { order("lower(name)") }
   scope :ordered_by_recently_accessed, -> { merge(Access.ordered_by_recently_accessed) }
+
+  private
+    def remove_storage_from_account
+      return if @storage_removed_from_account
+      @storage_removed_from_account = true
+      stored_bytes = self.class.where(id: id).pick(:bytes_used).to_i
+      Account.update_counters(account_id, bytes_used: -stored_bytes) if stored_bytes.positive? && Account.exists?(account_id)
+    end
 end
