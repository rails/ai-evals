diff --git a/app/jobs/board/recalculate_storage_job.rb b/app/jobs/board/recalculate_storage_job.rb
new file mode 100644
index 0000000..5d856b4
--- /dev/null
+++ b/app/jobs/board/recalculate_storage_job.rb
@@ -0,0 +1,23 @@
+class Board::RecalculateStorageJob < ApplicationJob
+  queue_as :backend
+  self.enqueue_after_transaction_commit = true
+  limits_concurrency key: ->(board_id) { board_id }, duration: 5.minutes
+
+  def perform(board_or_id)
+    board = Board.find_by(id: board_or_id.respond_to?(:id) ? board_or_id.id : board_or_id)
+    return unless board&.storage_usage_stale?
+
+    version = board.storage_usage_version
+    calculated_bytes = Storage::Usage.for_board(board)
+
+    board.with_lock do
+      return unless board.storage_usage_stale? && board.storage_usage_version == version
+
+      difference = calculated_bytes - board.bytes_used
+      board.update_columns(bytes_used: calculated_bytes, storage_usage_stale: false)
+      Account.update_counters(board.account_id, bytes_used: difference) unless difference.zero?
+    end
+  rescue ActiveRecord::RecordNotFound
+    # The board was deleted while its usage was being calculated.
+  end
+end
