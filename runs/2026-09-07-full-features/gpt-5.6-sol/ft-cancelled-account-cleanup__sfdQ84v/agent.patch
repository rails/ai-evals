@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled at least 30 days ago" do
+    overdue = create_cancelled_account("Overdue", 31.days.ago)
+    due = create_cancelled_account("Due", Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+    recent = create_cancelled_account("Recent", 29.days.ago)
+    overdue_board = overdue.boards.create!(name: "Overdue board", creator: overdue.system_user)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(overdue.id)
+    assert_not Account.exists?(due.id)
+    assert_not Board.exists?(overdue_board.id)
+    assert Account.exists?(recent.id)
+  end
+
+  test "does not incinerate active accounts" do
+    active = Account.create!(name: "Active")
+    active.update_column(:created_at, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(active.id)
+  end
+
+  private
+    def create_cancelled_account(name, cancelled_at)
+      Account.create!(name: name).tap do |account|
+        owner = account.users.create!(name: "Owner", role: :owner)
+        account.users.create!(name: "System", role: :system)
+        account.cancel(initiated_by: owner)
+        account.cancellation.update_columns(created_at: cancelled_at, updated_at: cancelled_at)
+      end
+    end
+end
