+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :storage_usages, class_name: "::StorageUsage", dependent: :delete_all
+
+    before_destroy :remove_storage_usage, prepend: true
+  end
+
+  private
+    def remove_storage_usage
+      usage = storage_usages.sum(:bytes_used)
+      Account.update_counters(account_id, bytes_used: -usage) unless usage.zero?
+      storage_usages.delete_all
+    end
+end
