diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..6005062
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts card images and files embedded in board, card, and comment descriptions" do
+    other_board = @account.boards.create!(name: "Other", creator: users(:david))
+    comment = @card.comments.create!(body: "A comment")
+
+    attach_image(@card, :image, 11)
+    embed(@board, :public_description, 13)
+    embed(@card, :description, 17)
+    embed(comment, :body, 19)
+    attach_image(users(:david), :avatar, 23)
+
+    perform_enqueued_jobs
+
+    assert_equal 60, @board.reload.bytes_used
+    assert_equal 60, @account.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+  end
+
+  test "updates usage when an attachment is removed without double counting retried jobs" do
+    attach_image(@card, :image, 11)
+    attachment = @card.image_attachment
+    perform_enqueued_jobs
+
+    StorageUsage::ReconcileJob.perform_now(attachment.id)
+    assert_equal 11, @board.reload.bytes_used
+
+    @card.image.detach
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "backfills existing attachments and removes stale entries" do
+    attach_image(@card, :image, 11)
+    attachment_id = @card.image_attachment.id
+    clear_enqueued_jobs
+
+    StorageUsage::BackfillJob.perform_now
+    assert_equal 11, @board.reload.bytes_used
+
+    ActiveStorage::Attachment.where(id: attachment_id).delete_all
+    StorageUsage::BackfillJob.perform_now
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "removes a deleted board from account usage" do
+    attach_image(@card, :image, 11)
+    perform_enqueued_jobs
+
+    @board.destroy!
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moves a card's usage between boards" do
+    other_board = @account.boards.create!(name: "Other", creator: users(:david))
+    comment = @card.comments.create!(body: "A comment")
+    attach_image(@card, :image, 11)
+    embed(comment, :body, 13)
+    perform_enqueued_jobs
+
+    @card.move_to(other_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 24, other_board.reload.bytes_used
+    assert_equal 24, @account.reload.bytes_used
+  end
+
+  private
+    def attach_image(record, name, size)
+      record.public_send(name).attach(
+        io: StringIO.new("x" * size), filename: "#{size}.txt", content_type: "text/plain"
+      )
+    end
+
+    def embed(record, name, size)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("x" * size), filename: "#{size}.txt", content_type: "text/plain"
+      )
+      rich_text = record.public_send(name)
+      rich_text.body = ActionText::Content.new(rich_text.body&.to_html.to_s).append_attachables(blob)
+      rich_text.save!
+    end
+end
