+++ b/app/models/storage_usage/trackable_attachment.rb
@@ -0,0 +1,26 @@
+module StorageUsage::TrackableAttachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :reconcile_created_attachment_storage_usage_later, if: :tracks_storage_usage?
+    after_destroy_commit :reconcile_destroyed_attachment_storage_usage_later, if: :tracks_storage_usage?
+  end
+
+  def delete
+    super.tap { reconcile_destroyed_attachment_storage_usage_later if tracks_storage_usage? }
+  end
+
+  private
+    def tracks_storage_usage?
+      (record_type == "Card" && name == "image") ||
+        (record_type == "ActionText::RichText" && name == "embeds")
+    end
+
+    def reconcile_created_attachment_storage_usage_later
+      StorageUsage::ReconcileJob.perform_later(id)
+    end
+
+    def reconcile_destroyed_attachment_storage_usage_later
+      StorageUsage::ReconcileJob.perform_later(id)
+    end
+end
