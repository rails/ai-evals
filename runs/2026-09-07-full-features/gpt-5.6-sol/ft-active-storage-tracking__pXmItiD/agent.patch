@@ -0,0 +1,42 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_storage_usage_board_change
+    after_update_commit :reconcile_storage_usage_after_board_change
+  end
+
+  def reconcile_storage_usage_later
+    Card::StorageUsageJob.perform_later(self)
+  end
+
+  def reconcile_storage_usage_now
+    storage_attachments.find_each do |attachment|
+      ::StorageUsage.reconcile(attachment.id)
+    end
+  end
+
+  private
+    def remember_storage_usage_board_change
+      @storage_usage_board_changed ||= will_save_change_to_board_id?
+    end
+
+    def reconcile_storage_usage_after_board_change
+      if @storage_usage_board_changed
+        reconcile_storage_usage_later
+        @storage_usage_board_changed = false
+      end
+    end
+
+    def storage_attachments
+      rich_text_ids = ActionText::RichText.where(
+        record_type: "Card", record_id: id, name: "description"
+      ).or(ActionText::RichText.where(
+        record_type: "Comment", record_id: comments.select(:id), name: "body"
+      )).select(:id)
+
+      ActiveStorage::Attachment.where(record_type: "Card", record_id: id, name: "image").or(
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds")
+      )
+    end
+end
diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..a93b02f
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,92 @@
+class StorageUsage < ApplicationRecord
+  belongs_to :account
+  belongs_to :board
+
+  class << self
+    def reconcile(attachment_id)
+      if target = target_for(attachment_id)
+        reconcile_target(attachment_id, target)
+      elsif usage = find_by(attachment_id: attachment_id)
+        usage.remove
+      end
+    end
+
+    private
+      def target_for(attachment_id)
+        if attachment = ActiveStorage::Attachment.includes(:blob, :record).find_by(id: attachment_id)
+          board = board_for(attachment)
+          Target.new(account: board.account, board: board, bytes_used: attachment.blob.byte_size) if board
+        end
+      end
+
+      def board_for(attachment)
+        case attachment.record
+        when Card
+          attachment.record.board if attachment.name == "image"
+        when ActionText::RichText
+          board_for_rich_text(attachment.record) if attachment.name == "embeds"
+        end
+      end
+
+      def board_for_rich_text(rich_text)
+        case rich_text.record
+        when Board
+          rich_text.record if rich_text.name == "public_description"
+        when Card
+          rich_text.record.board if rich_text.name == "description"
+        when Comment
+          rich_text.record.board if rich_text.name == "body"
+        end
+      end
+
+      def reconcile_target(attachment_id, target)
+        transaction do
+          usage = create_or_find_by!(attachment_id: attachment_id) do |new_usage|
+            new_usage.account = target.account
+            new_usage.board = target.board
+            new_usage.bytes_used = 0
+          end
+
+          usage.with_lock do
+            if current_target = target_for(attachment_id)
+              usage.apply(current_target)
+            else
+              usage.remove
+            end
+          end
+        end
+      end
+  end
+
+  def apply(target)
+    apply_transition(Account, account_id, bytes_used, target.account.id, target.bytes_used)
+    apply_transition(Board, board_id, bytes_used, target.board.id, target.bytes_used)
+
+    update!(account: target.account, board: target.board, bytes_used: target.bytes_used)
+  end
+
+  def remove
+    with_lock do
+      adjust_counter(Account, account_id, -bytes_used)
+      adjust_counter(Board, board_id, -bytes_used)
+      destroy!
+    end
+  end
+
+  private
+    def apply_transition(model, old_id, old_bytes, new_id, new_bytes)
+      if old_id == new_id
+        adjust_counter(model, old_id, new_bytes - old_bytes)
+      else
+        [ [ old_id, -old_bytes ], [ new_id, new_bytes ] ].sort_by(&:first).each do |id, amount|
+          adjust_counter(model, id, amount)
+        end
+      end
+    end
+
+    def adjust_counter(model, id, amount)
+      model.update_counters(id, bytes_used: amount) unless amount.zero?
+    end
+
+    Target = Data.define(:account, :board, :bytes_used)
+end
diff --git a/app/models/storage_usage/trackable_attachment.rb b/app/models/storage_usage/trackable_attachment.rb
