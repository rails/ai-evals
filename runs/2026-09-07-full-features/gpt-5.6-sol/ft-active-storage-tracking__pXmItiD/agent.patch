--- /dev/null
+++ b/app/jobs/storage_usage/backfill_job.rb
@@ -0,0 +1,33 @@
+class StorageUsage::BackfillJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(account = nil)
+    step :attachments do |step|
+      attachments(account).find_each(start: step.cursor) do |attachment|
+        StorageUsage.reconcile(attachment.id)
+        step.advance! from: attachment.id
+      end
+    end
+
+    step :removed_attachments do |step|
+      usages(account).where.not(attachment_id: ActiveStorage::Attachment.select(:id)).find_each(start: step.cursor) do |usage|
+        StorageUsage.reconcile(usage.attachment_id)
+        step.advance! from: usage.id
+      end
+    end
+  end
+
+  private
+    def attachments(account)
+      scope = ActiveStorage::Attachment.where(record_type: "Card", name: "image").or(
+        ActiveStorage::Attachment.where(record_type: "ActionText::RichText", name: "embeds")
+      )
+      account ? scope.where(account: account) : scope
+    end
+
+    def usages(account)
+      account ? StorageUsage.where(account: account) : StorageUsage.all
+    end
+end
