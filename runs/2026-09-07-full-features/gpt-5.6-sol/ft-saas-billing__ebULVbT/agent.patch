+<% @page_title = @account.name %>
+<div class="panel panel--wide shadow center flex flex-column gap">
+  <h1><%= @account.name %></h1>
+  <p>Plan: <strong><%= @account.plan.name %></strong></p>
+  <% if @account.comped? %>
+    <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+  <% else %>
+    <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+  <% end %>
+
+  <%= form_with url: saas.admin_account_override_path(@account), scope: :override, class: "flex flex-column gap-half" do |form| %>
+    <%= form.label :card_count, "Card count" %>
+    <%= form.number_field :card_count, min: 0, value: @account.overridden_limit&.card_count || @account.cards_count, required: true %>
+    <%= form.label :bytes_used, "Bytes used" %>
+    <%= form.number_field :bytes_used, min: 0, value: @account.overridden_limit&.bytes_used || @account.bytes_used, required: true %>
+    <%= form.submit "Override", class: "btn" %>
+  <% end %>
