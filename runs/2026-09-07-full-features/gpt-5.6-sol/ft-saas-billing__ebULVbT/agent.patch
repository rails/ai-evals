@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff lists accounts and can comp and override usage" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted { get saas.admin_accounts_path }
+    assert_response :success
+    assert_select "a", text: account.name
+
+    untenanted { post saas.admin_account_comp_path(account) }
+    assert account.reload.comped?
+
+    untenanted do
+      post saas.admin_account_override_path(account), params: { override: { card_count: 999, bytes_used: 1234 } }
+    end
+    assert_equal 999, account.reload.billable_card_count
+    assert_equal 1234, account.billable_bytes_used
+
+    untenanted { delete saas.admin_account_override_path(account) }
+    assert_nil account.reload.overridden_limit
+  ensure
+    account&.uncomp!
+    account&.reset_usage_override!
+  end
+
+  test "non-staff is forbidden" do
+    sign_in_as :jz
+    untenanted { get saas.admin_accounts_path }
+    assert_response :forbidden
+  end
+end
