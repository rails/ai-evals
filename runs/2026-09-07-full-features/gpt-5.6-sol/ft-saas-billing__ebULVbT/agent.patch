diff --git a/saas/app/controllers/stripe_billing/webhooks_controller.rb b/saas/app/controllers/stripe_billing/webhooks_controller.rb
new file mode 100644
index 0000000..93e92cb
--- /dev/null
+++ b/saas/app/controllers/stripe_billing/webhooks_controller.rb
@@ -0,0 +1,48 @@
+class StripeBilling::WebhooksController < ::ApplicationController
+  disallow_account_scope
+  skip_before_action :require_authentication
+  skip_forgery_protection
+
+  def create
+    event = construct_event
+    synchronize_subscription(event.data.object) if event.type.start_with?("customer.subscription.")
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def construct_event
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+      if secret.present?
+        ::Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], secret)
+      else
+        ::Stripe::Event.construct_from(JSON.parse(request.raw_post))
+      end
+    end
+
+    def synchronize_subscription(object)
+      metadata = object.metadata.to_h.with_indifferent_access
+      account = Account.find_by(id: metadata[:account_id])
+      account ||= Account::Subscription.find_by(stripe_customer_id: object.customer)&.account
+      return unless account
+
+      price_id = object.items&.data&.first&.price&.id
+      plan = BillingPlan.from_price_id(price_id) || BillingPlan::PLANS[metadata[:plan_key]]
+      return unless plan&.paid?
+
+      subscription = account.subscription || account.build_subscription
+      subscription.update!(
+        plan_key: plan.key,
+        stripe_customer_id: object.customer,
+        stripe_subscription_id: object.id,
+        status: object.status,
+        current_period_end: time_at(object.current_period_end),
+        cancel_at: time_at(object.cancel_at)
+      )
+    end
+
+    def time_at(value)
+      Time.zone.at(value) if value.present?
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..a509384
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,45 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+  end
+
+  def plan
+    return BillingPlan.fetch("unlimited_plus") if comped?
+    subscription&.active? ? subscription.plan : BillingPlan.free
+  end
+
+  def card_limit = plan.card_limit
+  def billable_card_count = overridden_limit&.card_count || cards_count
+  def billable_bytes_used = overridden_limit&.bytes_used || bytes_used
+
+  def cards_remaining
+    card_limit && [ card_limit - billable_card_count, 0 ].max
+  end
+
+  def exceeding_card_limit? = card_limit.present? && billable_card_count >= card_limit
+  alias_method :card_limit_exceeded?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.positive? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def comped? = billing_waiver.present?
+  def comp! = self.billing_waiver = (billing_waiver || create_billing_waiver!)
+  def uncomp! = billing_waiver&.destroy!
+  def comped=(value)
+    # Queenbee compatibility: support changes use comp!/uncomp! explicitly.
+  end
+
+  def override_usage!(card_count:, bytes_used:)
+    record = overridden_limit || build_overridden_limit
+    record.update!(card_count: card_count, bytes_used: bytes_used)
+  end
+
+  def reset_usage_override! = overridden_limit&.destroy!
+end
