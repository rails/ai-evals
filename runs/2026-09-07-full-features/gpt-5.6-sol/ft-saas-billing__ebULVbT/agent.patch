+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,26 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = BillingPlan.fetch(params.require(:plan))
+    raise ActionController::BadRequest, "Free is not a checkout plan" unless plan.paid?
+    raise ActionController::BadRequest, "Stripe price is not configured" if plan.stripe_price_id.blank?
+
+    attributes = {
+      mode: "subscription",
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      client_reference_id: Current.account.id,
+      metadata: { account_id: Current.account.id, plan_key: plan.key },
+      subscription_data: { metadata: { account_id: Current.account.id, plan_key: plan.key } },
+      success_url: account_settings_url,
+      cancel_url: account_settings_url
+    }
+    if Current.account.subscription&.stripe_customer_id.present?
+      attributes[:customer] = Current.account.subscription.stripe_customer_id
+    else
+      attributes[:customer_email] = Current.account.owner_email
+    end
+
+    redirect_to Stripe::Checkout::Session.create(attributes).url, allow_other_host: true
+  end
+end
