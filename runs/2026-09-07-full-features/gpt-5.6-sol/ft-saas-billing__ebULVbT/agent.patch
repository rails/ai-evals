+require "test_helper"
+
+class Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  test "admin starts Stripe hosted checkout" do
+    sign_in_as :mike
+    old_price = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_20"
+    session = stub(url: "https://checkout.stripe.test/session")
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" && attributes[:line_items] == [ { price: "price_20", quantity: 1 } ] &&
+        attributes.dig(:subscription_data, :metadata, :account_id) == accounts(:initech).id
+    end.returns(session)
+
+    post saas.billing_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_redirected_to session.url
+  ensure
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = old_price
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..93b71f4
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    @account.overridden_limit&.destroy!
+    sign_in_as :mike
+  end
+
+  teardown do
+    @account&.subscription&.destroy!
+    @account&.billing_waiver&.destroy!
+    @account&.overridden_limit&.destroy!
+  end
+
+  test "exhausted free account can draft but cannot create through JSON" do
+    @account.update_column(:cards_count, 1_000)
+    board = boards(:miltons_wish_list)
+    board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(board, script_name: @account.slug)
+    end
+    assert_response :redirect
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(board, script_name: @account.slug), params: { card: { title: "API card" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "warning counts down the last 100 cards" do
+    @account.update_column(:cards_count, 900)
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-limit-notice", text: /100 cards left/
+  end
+
+  test "paid plan has no card publishing limit" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_paid")
+    @account.update_column(:cards_count, 5_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
diff --git a/saas/test/controllers/stripe_billing/webhooks_controller_test.rb b/saas/test/controllers/stripe_billing/webhooks_controller_test.rb
new file mode 100644
index 0000000..1b1c481
--- /dev/null
+++ b/saas/test/controllers/stripe_billing/webhooks_controller_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class StripeBilling::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+  end
+
+  teardown do
+    @account&.subscription&.destroy!
+    @account&.billing_waiver&.destroy!
+    @account&.overridden_limit&.destroy!
+  end
+
+  test "subscription changes posted by Stripe update the account plan" do
+    payload = {
+      id: "evt_1", type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_1", object: "subscription", customer: "cus_1", status: "active",
+        current_period_end: 2.days.from_now.to_i, cancel_at: nil,
+        metadata: { account_id: @account.id, plan_key: "unlimited_plus" },
+        items: { data: [ { price: { id: "price_plus" } } ] }
+      } }
+    }
+
+    body = payload.to_json
+    timestamp = Time.now.to_i
+    signature = OpenSSL::HMAC.hexdigest("SHA256", ENV.fetch("STRIPE_WEBHOOK_SECRET"), "#{timestamp}.#{body}")
+    untenanted { post saas.stripe_webhooks_path, params: body, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}" } }
+
+    assert_response :ok
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal "sub_1", @account.subscription.stripe_subscription_id
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "deleted subscription returns account to free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_2", stripe_subscription_id: "sub_2")
+    payload = { id: "evt_2", type: "customer.subscription.deleted", data: { object: {
+      id: "sub_2", object: "subscription", customer: "cus_2", status: "canceled", current_period_end: nil,
+      cancel_at: nil, metadata: { plan_key: "unlimited" }, items: { data: [] }
+    } } }
+
+    body = payload.to_json
+    timestamp = Time.now.to_i
+    signature = OpenSSL::HMAC.hexdigest("SHA256", ENV.fetch("STRIPE_WEBHOOK_SECRET"), "#{timestamp}.#{body}")
+    untenanted { post saas.stripe_webhooks_path, params: body, headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=#{timestamp},v1=#{signature}" } }
+
+    assert_response :ok
+    assert_equal "Free", @account.reload.plan.name
+  end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..a4da7f2
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @account.subscription&.destroy!
+    @account.billing_waiver&.destroy!
+    @account.overridden_limit&.destroy!
+  end
+
+  teardown do
+    @account&.subscription&.destroy!
+    @account&.billing_waiver&.destroy!
+    @account&.overridden_limit&.destroy!
+  end
+
+  test "free plan has 1000 cards and 1 GB storage" do
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "paid plans have unlimited cards and their approved storage" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_1")
+    assert_nil @account.reload.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "free card countdown starts with 100 cards left" do
+    @account.update_column(:cards_count, 900)
+    assert_equal 100, @account.cards_remaining
+    assert @account.nearing_card_limit?
+
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
