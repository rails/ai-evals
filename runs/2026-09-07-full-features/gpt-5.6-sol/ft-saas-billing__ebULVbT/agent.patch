diff --git a/saas/app/models/billing_plan.rb b/saas/app/models/billing_plan.rb
new file mode 100644
index 0000000..c610b7f
--- /dev/null
+++ b/saas/app/models/billing_plan.rb
@@ -0,0 +1,29 @@
+class BillingPlan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit
+
+  def initialize(key:, name:, price_in_cents:, card_limit:, storage_limit:)
+    @key, @name, @price_in_cents, @card_limit, @storage_limit = key, name, price_in_cents, card_limit, storage_limit
+  end
+
+def stripe_price_id
+  legacy_key = {
+    "unlimited" => "STRIPE_MONTHLY_V1_PRICE_ID",
+    "unlimited_plus" => "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+  }[key]
+  ENV[legacy_key] || ENV["STRIPE_#{key.upcase}_PRICE_ID"]
+end
+  def paid? = price_in_cents.positive?
+
+  PLANS = {
+    "free" => new(key: "free", name: "Free", price_in_cents: 0, card_limit: 1_000, storage_limit: 1.gigabyte),
+    "unlimited" => new(key: "unlimited", name: "Unlimited", price_in_cents: 2_000, card_limit: nil, storage_limit: 5.gigabytes),
+    "unlimited_plus" => new(key: "unlimited_plus", name: "Unlimited+", price_in_cents: 2_500, card_limit: nil, storage_limit: 500.gigabytes)
+  }.freeze
+
+  class << self
+    def fetch(key) = PLANS.fetch(key.to_s)
+    def free = fetch("free")
+    def paid = PLANS.values.select(&:paid?)
+    def from_price_id(price_id) = paid.find { |plan| plan.stripe_price_id == price_id }
+  end
+end
