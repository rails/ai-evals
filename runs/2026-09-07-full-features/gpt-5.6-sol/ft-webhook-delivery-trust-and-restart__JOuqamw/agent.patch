--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,8 @@
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +14,37 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    return unless claim
+
+    begin
+      body = render_body
+      headers = request_headers(body)
+      update! request: { body: body, headers: headers }
+
+      result = post(body, headers)
+      update! state: :completed, response: result
+    rescue StandardError => error
+      record_error(error)
+    end
+
+    track_result
+  rescue StandardError => tracking_error
+    Rails.error.report tracking_error, context: { webhook_delivery_id: id }
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +62,50 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def claim
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def render_body
+      WebhooksController.render template: "webhooks/event", assigns: { event: event }, formats: [ :json ]
+    end
+
+    def request_headers(body)
+      timestamp = Time.current.utc.iso8601(3)
+      signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, "#{timestamp}.#{body}")
+
+      {
+        "User-Agent" => "Fizzy Webhook",
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => "sha256=#{signature}"
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      response = http.request(Net::HTTP::Post.new(uri.request_uri, headers).tap { |request| request.body = body })
+      { code: response.code.to_i, headers: response.each_header.to_h }
+    end
+
+    def track_result
+      if succeeded?
+        webhook.delinquency_tracker.record_success
+      else
+        webhook.delinquency_tracker.record_failure
+      end
+    end
+
+    def record_error(error)
+      update! state: :errored, response: { error: "#{error.class}: #{error.message}" }
+    end
 end
