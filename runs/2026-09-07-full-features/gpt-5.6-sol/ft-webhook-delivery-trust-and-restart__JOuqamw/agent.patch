diff --git a/test/models/webhook/dispatch_test.rb b/test/models/webhook/dispatch_test.rb
new file mode 100644
index 0000000..e88d855
--- /dev/null
+++ b/test/models/webhook/dispatch_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+    @webhook.update!(subscribed_actions: [ @event.action ])
+  end
+
+  test "committing an event dispatches it automatically" do
+    @webhook.update!(subscribed_actions: [ "card_reopened" ])
+
+    assert_enqueued_with(job: Webhook::DeliveryJob) do
+      assert_difference "Webhook::Delivery.count", 1 do
+        Event.create!(
+          account: @event.account,
+          board: @event.board,
+          creator: @event.creator,
+          eventable: @event.eventable,
+          action: "card_reopened"
+        )
+      end
+    end
+  end
+
+  test "an event queues one delivery for each active subscribed webhook" do
+    assert_enqueued_with(job: Webhook::DeliveryJob) do
+      assert_difference "Webhook::Delivery.count", 1 do
+        @event.dispatch_to_webhooks_later
+      end
+    end
+
+    delivery = Webhook::Delivery.order(:created_at).last
+    assert_equal @webhook, delivery.webhook
+    assert_equal @event, delivery.event
+
+    assert_no_difference "Webhook::Delivery.count" do
+      @event.dispatch_to_webhooks_later
+    end
+  end
+
+  test "inactive and unsubscribed webhooks are ignored" do
+    @webhook.deactivate
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        @event.dispatch_to_webhooks_later
+      end
+    end
+  end
+
+  test "delivery posts signed JSON once and records success" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    request = stub_request(:post, @webhook.url).to_return(status: 204, headers: { "X-Receiver" => "ok" })
+
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert delivery.reload.succeeded?
+    assert_equal 204, delivery.response[:code]
+    assert_equal "ok", delivery.response.dig(:headers, "x-receiver")
+    assert_equal "application/json", delivery.request.dig(:headers, "Content-Type")
+    assert delivery.request.dig(:headers, "X-Webhook-Signature").present?
+    assert_equal @event.id, JSON.parse(delivery.request[:body]).fetch("id")
+
+    delivery.deliver_now
+    assert_requested request, times: 1
+  end
+
+  test "network errors are logged without retrying" do
+    delivery = Webhook::Delivery.create!(webhook: @webhook, event: @event)
+    request = stub_request(:post, @webhook.url).to_raise(SocketError.new("unreachable"))
+
+    delivery.deliver_now
+
+    assert_requested request, times: 1
+    assert delivery.reload.errored?
+    assert_match(/SocketError/, delivery.response[:error])
+  end
+
+  test "ten consecutive failures within an hour deactivate the webhook" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to Time.current do
+      9.times { tracker.record_failure }
+      assert @webhook.reload.active?
+      travel 59.minutes
+      tracker.record_failure
+    end
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "failures spanning more than an hour start a new sequence" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to Time.current do
+      9.times { tracker.record_failure }
+      travel 61.minutes
+      tracker.record_failure
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+  end
+
+  test "success resets consecutive failures" do
+    tracker = @webhook.delinquency_tracker
+    9.times { tracker.record_failure }
+
+    tracker.record_success
+
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+
+  test "cleanup keeps one week of logs" do
+    recent = webhook_deliveries(:pending)
+    old = webhook_deliveries(:successfully_completed)
+    recent.update_columns(created_at: 7.days.ago + 1.second)
+    old.update_columns(created_at: 7.days.ago - 1.second)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(old.id)
+  end
+end
