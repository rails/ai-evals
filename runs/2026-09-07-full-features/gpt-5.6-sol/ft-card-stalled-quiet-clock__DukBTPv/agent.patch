diff --git a/test/controllers/cards/stalled_index_test.rb b/test/controllers/cards/stalled_index_test.rb
new file mode 100644
index 0000000..31fc986
--- /dev/null
+++ b/test/controllers/cards/stalled_index_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Cards::StalledIndexTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @card.update!(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+  end
+
+  test "indexed_by stalled lists stalled cards" do
+    get cards_path, params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_select ".cards__list .card__stalled", text: "Stalled"
+    assert_select ".card__title", count: 1
+  end
+
+  test "stalled state is included in JSON" do
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert response.parsed_body.first["stalled"]
+  end
+
+  test "stalled state is shown on the card" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+  end
+
+  test "cached cards show stalled state when inactivity crosses two weeks" do
+    @card.update!(last_active_at: 2.weeks.ago + 1.day)
+
+    with_actionview_partial_caching do
+      get cards_path, params: { card_ids: [ @card.id ] }
+      assert_select ".cards__list .card__stalled", count: 0
+
+      travel 2.days do
+        get cards_path, params: { card_ids: [ @card.id ] }
+        assert_select ".cards__list .card__stalled", text: "Stalled"
+      end
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..54fdaf5
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.comments.by_user.delete_all
+    @card.update_columns(burst_at: nil, last_active_at: Time.current)
+  end
+
+  test "three comments from two people within one third of auto-close marks a burst" do
+    travel_to Time.current.change(usec: 0) do
+      add_comment(:david, burst_window.ago + 1.day)
+      add_comment(:david, 1.day.ago)
+      add_comment(:kevin, Time.current)
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "comments outside one third of auto-close do not mark a burst" do
+    travel_to Time.current.change(usec: 0) do
+      add_comment(:david, burst_window.ago - 1.day)
+      add_comment(:david, 1.day.ago)
+      add_comment(:kevin, Time.current)
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments from only one person do not mark a burst" do
+    travel_to Time.current.change(usec: 0) do
+      add_comment(:david, 2.days.ago)
+      add_comment(:david, 1.day.ago)
+      add_comment(:david, Time.current)
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "system comments do not contribute to a burst" do
+    travel_to Time.current.change(usec: 0) do
+      add_comment(:david, 2.days.ago)
+      add_comment(:kevin, 1.day.ago)
+      @card.comments.create!(body: "Automated", creator: users(:system), created_at: Time.current)
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "assignment marks a burst" do
+    freeze_time do
+      @card.toggle_assignment(users(:kevin))
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "reopening marks a burst" do
+    @card.close
+    @card.update_column(:burst_at, nil)
+
+    freeze_time do
+      @card.reopen
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "card is stalled after two weeks without activity following a burst" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "activity resets a stalled card" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    assert_predicate @card.reload, :stalled?
+
+    @card.close
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  private
+    def burst_window
+      (@card.auto_postpone_period / 3.0).seconds
+    end
+
+    def add_comment(user, created_at)
+      @card.comments.create!(body: "A comment", creator: users(user), created_at: created_at)
+    end
+end
