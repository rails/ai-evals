diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..1e5faf8
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,29 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def record_burst_from(event)
+    if event.action.in?(BURST_ACTIONS)
+      update!(burst_at: event.created_at)
+    end
+  end
+
+  def record_comment_burst(comment)
+    window = (comment.created_at - auto_postpone_period / 3.0)..comment.created_at
+    recent_comments = comments.by_user.where(created_at: window)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+      update!(burst_at: comment.created_at)
+    end
+  end
+end
