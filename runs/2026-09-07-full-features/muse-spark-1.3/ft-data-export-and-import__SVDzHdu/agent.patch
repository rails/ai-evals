+    def remap_attributes(data, context)
+      attrs = super
+      # Assign a fresh key to avoid unique-key collisions with source blobs.
+      # The actual file bytes are restored by FileRecordSet afterwards.
+      attrs["key"] = ActiveStorage::Blob.generate_unique_secure_token
+      attrs["service_name"] = ActiveStorage::Blob.service.name
+      attrs["account_id"] = context.new_account_id
+      # Remember blob mapping is already handled via id_for; ensure checksum/size
