diff --git a/app/controllers/account/exports_controller.rb b/app/controllers/account/exports_controller.rb
new file mode 100644
index 0000000..3f1c12f
--- /dev/null
+++ b/app/controllers/account/exports_controller.rb
@@ -0,0 +1,93 @@
+class Account::ExportsController < ApplicationController
+  before_action :set_export, only: %i[show download]
+
+  def create
+    export_type = params.dig(:export, :export_type) || params[:export_type] || "account"
+
+    if export_type == "account"
+      head(:forbidden) and return unless Current.user.admin?
+      export = Current.account.exports.create!(user: Current.user, export_type: "account")
+    else
+      export = Current.account.exports.create!(
+        user: Current.user,
+        subject_user: Current.user,
+        export_type: "cards"
+      )
+    end
+
+    Account::ExportJob.perform_later(export)
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { render json: { id: export.id, status: export.status }, status: :accepted }
+    end
+  end
+
+  def show
+    # Show status / download page
+    unless can_download?(@export)
+      head :forbidden and return
+    end
+    respond_to do |format|
+      format.html
+      format.json { render json: { id: @export.id, status: @export.status, ready: @export.ready? } }
+    end
+  end
+
+  # GET /account/exports/download/:token  (signed, expires in a day)
+  # Also supports /account/exports/:id/download for direct authenticated download.
+  def download
+    unless can_download?(@export)
+      head :forbidden and return
+    end
+    unless @export.ready?
+      respond_to do |format|
+        format.html { redirect_to account_export_path(@export), alert: "Export is not ready yet." }
+        format.json { render json: { status: @export.status }, status: :accepted }
+      end
+      return
+    end
+
+    # Stream the file without loading it into memory (large-file safe),
+    # supporting both Disk and S3 services.
+    blob = @export.file.blob
+    send_data_stream(blob, filename: @export.filename)
+  end
+
+  private
+    def set_export
+      if params[:token].present?
+        @export = Account::Export.find_signed!(params[:token], purpose: :download)
+      elsif params[:id].present?
+        # id may itself be a signed token
+        begin
+          @export = Account::Export.find_signed!(params[:id], purpose: :download)
+        rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+          @export = Current.account.exports.find(params[:id])
+        end
+      end
+    rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+      head :not_found and return
+    end
+
+    def can_download?(export)
+      return false unless export
+      return false unless export.account_id == Current.account.id
+      export.user_id == Current.user.id || Current.user.admin?
+    end
+
+    def send_data_stream(blob, filename:)
+      # For Disk service, stream from disk; for S3, stream via download chunks.
+      # Use send_data with streaming enumerator to avoid loading 500GB.
+      self.response.headers["Content-Type"] = "application/zip"
+      self.response.headers["Content-Disposition"] = "attachment; filename=\"#{filename}\""
+      self.response_body = Enumerator.new do |yielder|
+        blob.service.download(blob.key) do |chunk|
+          yielder << chunk
+        end
+      end
+    rescue => e
+      # Fallback: redirect to rails blob (signed, short-lived)
+      redirect_to rails_blob_path(blob, disposition: "attachment")
+    end
+end
