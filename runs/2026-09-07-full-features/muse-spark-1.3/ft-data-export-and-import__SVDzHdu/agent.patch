diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..274225f
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,97 @@
+class Account::Export < ApplicationRecord
+  DOWNLOAD_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+  belongs_to :subject_user, class_name: "User", optional: true
+
+  has_one_attached :file
+
+  validates :export_type, inclusion: { in: %w[account cards] }
+
+  scope :ready, -> { where(status: "ready") }
+
+  def ready?
+    status == "ready" && file.attached?
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def pending?
+    status == "pending"
+  end
+
+  def account_export?
+    export_type == "account"
+  end
+
+  def cards_export?
+    export_type == "cards"
+  end
+
+  # Signed id for the email download link; valid for a day.
+  def download_token
+    signed_id(purpose: :download, expires_in: DOWNLOAD_EXPIRY)
+  end
+
+  def self.find_by_download_token(token)
+    find_signed(token, purpose: :download)
+  end
+
+  def filename
+    if account_export?
+      "fizzy-account-#{account.name.parameterize}-#{created_at.to_i}.zip"
+    else
+      "fizzy-cards-#{created_at.to_i}.zip"
+    end
+  end
+
+  # Cards visible to the requesting user (for cards exports) or all
+  # account cards (for account exports).
+  def cards_scope
+    if account_export?
+      Card.where(account_id: account_id)
+    else
+      target = subject_user || user
+      # Cards the requesting user can see. For profile exports this is the
+      # requester's accessible cards; ensures private boards are excluded.
+      accessible = user.accessible_cards.where(account_id: account_id)
+      # If exporting another user's profile, narrow to cards involving them
+      # (assigned or created) but still visible to requester.
+      if subject_user && subject_user_id != user_id
+        accessible.where("cards.creator_id = ? OR cards.id IN (SELECT card_id FROM assignments WHERE assignee_id = ?)", subject_user.id, subject_user.id)
+      else
+        accessible
+      end
+    end
+  end
+
+  def generate!
+    update!(status: "generating")
+    Current.with_account(account) do
+      Current.set(user: user) do
+        scope = account_export? ? nil : cards_scope
+        ZipFile.create_for(file_attachment_or_build, filename: filename) do |zip|
+          if account_export?
+            Account::DataTransfer::Exporter.new(account).export(zip)
+          else
+            Account::DataTransfer::CardsExporter.new(account, scope).export(zip)
+          end
+        end
+      end
+    end
+    update!(status: "ready")
+  rescue => e
+    update!(status: "failed", error_message: e.message.truncate(2000))
+    raise
+  end
+
+  private
+    def file_attachment_or_build
+      # ZipFile.create_for expects an attachment proxy (record#attachment).
+      # Ensure the record is persisted so attach works.
+      self.file
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
