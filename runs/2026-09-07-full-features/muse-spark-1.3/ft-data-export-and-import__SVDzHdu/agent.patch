+class Account::Import < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  belongs_to :new_account, class_name: "Account", optional: true
+
+  has_one_attached :file
+
+  validates :file, presence: true, on: :create
+
+  scope :pending, -> { where(status: "pending") }
+
+  def pending?
+    status == "pending"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def process!
+    update!(status: "processing")
+    new_account = nil
+    Current.with_account(account) do
+      ZipFile::Reader.open_attachment(file) do |reader|
+        importer = Account::DataTransfer::Importer.new(reader, requesting_user: user)
+        new_account = importer.import!
+      end
+    end
+    update!(status: "completed", new_account: new_account)
+    new_account
+  rescue Account::DataTransfer::Importer::ImportError => e
+    update!(status: "failed", error_message: e.message.truncate(2000))
+    raise e
+  rescue => e
+    update!(status: "failed", error_message: e.message.truncate(2000))
+    raise Account::DataTransfer::Importer::ImportError, e.message
+  end
+end
