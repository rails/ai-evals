@@ -0,0 +1,34 @@
+# Tracks old-id -> new-id mapping during import and holds the new account.
+class Account::DataTransfer::ImportContext
+  attr_reader :new_account, :new_account_id, :blob_keys
+
+  def initialize(new_account)
+    @new_account = new_account
+    @new_account_id = new_account.id
+    @map = {}
+    @blob_keys = {}
+  end
+
+  def id_for(old_id)
+    return nil if old_id.nil?
+    key = old_id.to_s
+    @map[key] ||= ActiveRecord::Type::Uuid.generate
+  end
+
+  def mapped?(old_id)
+    return false if old_id.nil?
+    @map.key?(old_id.to_s)
+  end
+
+  def register(old_id, new_id)
+    @map[old_id.to_s] = new_id.to_s
+  end
+
+  def store_blob_key(old_blob_id, old_key)
+    @blob_keys[old_blob_id.to_s] = old_key
+  end
+
+  def old_blob_key(old_blob_id)
+    @blob_keys[old_blob_id.to_s]
+  end
+end
