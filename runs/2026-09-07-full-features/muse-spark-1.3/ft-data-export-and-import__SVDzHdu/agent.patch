+  end
+
+  def import_from(reader, context)
+    count = 0
+    reader.glob("#{model_dir}/*.json").each do |path|
+      data = reader.read_json(path)
+      import_record(data, context)
+      count += 1
+    end
+    count
+  end
+  alias read_from import_from
+  alias load_from import_from
+
