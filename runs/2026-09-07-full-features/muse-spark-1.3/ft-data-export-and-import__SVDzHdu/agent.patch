+
+    def each_record(&block)
+      rel = records
+      if rel.respond_to?(:find_each)
+        rel.find_each(&block)
+      else
+        Array(rel).each(&block)
+      end
+    end
+
+    def decorate_export_attributes(record, attrs)
+      attrs
+    end
+
+    def remap_attributes(data, context)
+      attrs = data.dup
+      new_id = context.id_for(attrs["id"])
+      attrs["id"] = new_id
+
+      attrs.each_key do |key|
+        next if key == "id"
+        if key == "account_id"
+          attrs[key] = context.new_account_id
+        elsif key.end_with?("_id") && attrs[key].is_a?(String)
+          if context.mapped?(attrs[key])
+            attrs[key] = context.id_for(attrs[key])
+          end
+        end
+      end
