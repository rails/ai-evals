+      sanitized = sanitize_for_insert(attrs)
+      model.insert!(sanitized)
+      # Store original key mapping so FileRecordSet can find the zip entry.
+      context.store_blob_key(original_data["id"], original_data["key"])
+      nil
+    end
 end
