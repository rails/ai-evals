+    mail(
+      to: @user.identity.email_address,
+      subject: "Your import is complete"
+    )
+  end
+
+  def import_failed(import, error_message = nil)
+    @import = import
+    @user = import.user
+    @account = import.account
+    @error_message = error_message || import.error_message
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your import failed"
+    )
+  end
+end
