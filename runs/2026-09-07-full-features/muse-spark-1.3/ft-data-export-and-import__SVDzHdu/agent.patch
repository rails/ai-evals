+class ZipFile::Reader
+  include Enumerable
+
+  EntryNotFound = Class.new(StandardError)
+
+  def initialize(io, size: nil)
+    @io = io
+    @size = size
+    @entries = nil
+  end
+
+  class << self
+    # Open from a local file path, streaming without loading whole file.
+    def open_path(path)
+      File.open(path, "rb") do |f|
+        yield new(f)
+      end
+    end
+
+    # Open from an ActiveStorage blob, downloading to a tempfile on disk
+    # (streaming, not into memory) so very large ZIPs are supported on
+    # both Disk and S3 services.
+    def open_blob(blob)
+      blob.open do |file|
+        File.open(file.path, "rb") do |f|
+          yield new(f)
+        end
+      end
+    end
+
+    # Open from an ActiveStorage attachment's blob.
+    def open_attachment(attachment)
+      open_blob(attachment.blob) { |r| yield r }
+    end
+  end
+
+  def entries
+    @entries ||= ZipKit::FileReader.read_zip_structure(io: @io)
+  end
+
+  def each(&block)
+    entries.each(&block)
+  end
+
+  def filenames
+    entries.map(&:filename)
+  end
+
+  def exists?(path)
+    filenames.include?(path)
+  end
+
+  def glob(pattern)
+    filenames.select { |e| File.fnmatch(pattern, e, File::FNM_PATHNAME | File::FNM_DOTMATCH) }.sort
+  end
+
+  def read(path)
+    entry = entries.find { |e| e.filename == path }
+    raise EntryNotFound, path unless entry
+
+    extractor = entry.extractor_from(@io)
+    buffer = +"".b
+    until extractor.eof?
+      chunk = extractor.extract(1.megabyte)
+      buffer << chunk if chunk
+    end
+    buffer
+  end
+
+  def read_json(path)
+    JSON.parse(read(path).force_encoding(Encoding::UTF_8))
+  end
+
+  # Stream entry contents in chunks without loading whole entry into memory.
+  def stream(path)
+    entry = entries.find { |e| e.filename == path }
+    raise EntryNotFound, path unless entry
+
+    extractor = entry.extractor_from(@io)
+    until extractor.eof?
+      chunk = extractor.extract(5.megabytes)
+      yield chunk if chunk && !chunk.empty?
+    end
+  end
+
+  # Stream entry directly into a writable IO.
+  def stream_to(path, dest_io)
+    stream(path) { |chunk| dest_io.write(chunk) }
+  end
+end
