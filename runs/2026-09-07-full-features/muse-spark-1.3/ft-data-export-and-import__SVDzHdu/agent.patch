+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,133 @@
+# Restores a full account export (created by Exporter/Manifest) into a NEW
+# account. Runs inside a transaction so a failed import leaves nothing behind.
+class Account::DataTransfer::Importer
+  class ImportError < StandardError; end
+
+  attr_reader :reader, :requesting_user, :original_account_id
+
+  def initialize(reader, requesting_user: nil)
+    @reader = reader
+    @requesting_user = requesting_user
+  end
+
+  def import!
+    manifest = read_manifest
+    validate_manifest!(manifest)
+
+    new_account = nil
+    ActiveRecord::Base.transaction do
+      new_account = create_new_account(manifest)
+      context = Account::DataTransfer::ImportContext.new(new_account)
+
+      Storage::Entry.suppressing_recording do
+      # Import in manifest order (dependency order). AccountRecordSet is no-op.
+      import_record_sets(context)
+
+      # Ensure requesting user is a member/owner of the new account so they
+      # can access it, unless they already are via imported users.
+      ensure_requester_membership!(new_account)
+      end
+
+      # Validate completeness: at least account exists; raise if critical
+      # tables failed (insert! would already have raised).
+      new_account
+    end
+  rescue ActiveRecord::RecordInvalid, ActiveRecord::RecordNotFound, ActiveRecord::StatementInvalid => e
+    raise ImportError, e.message
+  rescue ZipFile::Reader::EntryNotFound => e
+    raise ImportError, "Invalid import file: #{e.message}"
+  rescue JSON::ParserError => e
+    raise ImportError, "Invalid import file: corrupt JSON (#{e.message})"
+  end
+
+  private
+    def read_manifest
+      if reader.exists?("manifest.json")
+        reader.read_json("manifest.json")
+      else
+        # Fallback: allow cards-only zips? They lack manifest; treat as invalid
+        # for account import (must have manifest).
+        raise ImportError, "Invalid import file: missing manifest.json"
+      end
+    end
+
+    def validate_manifest!(manifest)
+      unless manifest.is_a?(Hash) && manifest["version"]
+        raise ImportError, "Invalid import file: bad manifest"
+      end
+    end
+
+    def create_new_account(manifest)
+      source_name = manifest["account_name"].presence || "Imported account"
+      account_attrs = read_exported_account_attrs
+      new_account = nil
+      Storage::Entry.suppressing_recording do
+        new_account = Account.create!(
+          name: account_attrs&.dig("name").presence || source_name,
+          cards_count: account_attrs&.dig("cards_count") || 0
+        )
+        Entropy.where(container: new_account).delete_all
+      end
+      new_account
+    end
+
+    def read_exported_account_attrs
+      paths = reader.glob("accounts/*.json")
+      return nil if paths.empty?
+      reader.read_json(paths.first)
+    rescue
+      nil
+    end
+
+    def import_record_sets(context)
+      # Build record sets for the SOURCE account id (not needed for import
+      # except ordering); we instantiate generic sets with a dummy account
+      # object carrying the new account id? Instead, directly iterate over
+      # the manifest's record set classes in order, importing via fresh
+      # RecordSet instances bound to new account (records scope unused).
+      ordered_sets = ordered_record_sets(context.new_account)
+      ordered_sets.each do |record_set|
+        # Skip AccountRecordSet (handled) and FileRecordSet (handled last
+        # after blobs so keys exist). We'll handle FileRecordSet after all.
+        next if record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+        record_set.import(reader, context)
+      end
+      # Now stream file binaries into new blobs
+      file_set = Account::DataTransfer::ActiveStorage::FileRecordSet.new(context.new_account)
+      # Trick: FileRecordSet#records scopes to source account; for import we
+      # want it to just process zip entries, so call import directly.
+      file_set.import(reader, context)
+    end
+
+    def ordered_record_sets(new_account)
+      manifest = Account::DataTransfer::Manifest.new(new_account)
+      sets = []
+      manifest.each_record_set { |rs| sets << rs }
+      # Rebind: RecordSet instances already bound to new_account (for scoping
+      # export), but import doesn't use #records, only model_dir + logic,
+      # so they work as-is.
+      sets
+    end
+
+    def ensure_requester_membership!(new_account)
+      return unless requesting_user
+      return if new_account.users.exists?(identity_id: requesting_user.identity_id)
+
+      email = requesting_user.identity&.email_address
+      identity = requesting_user.identity
+      if email.present?
+        # If requester email already has a user in new account (imported),
+        # nothing to do. Otherwise add them as admin so they can access.
+        unless new_account.users.joins(:identity).exists?(identities: { email_address: email })
+          new_account.users.create!(
+            name: requesting_user.name,
+            identity: identity,
+            role: new_account.users.exists? ? "admin" : "owner",
+            verified_at: Time.current
+          )
+        end
+      end
+    rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+      nil
+    end
+end
