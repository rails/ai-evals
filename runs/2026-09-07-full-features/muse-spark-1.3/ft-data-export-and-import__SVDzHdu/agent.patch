+class Account::ImportsController < ApplicationController
+  def new
+    @import = Current.account.imports.build
+  end
+
+  def create
+    uploaded = params.dig(:account_import, :file) || params.dig(:import, :file) || params[:file]
+    unless uploaded
+      respond_to do |format|
+        format.html do
+          @import = Current.account.imports.build
+          @import.errors.add(:file, "must be attached")
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "file must be attached" }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    @import = Current.account.imports.create!(user: Current.user, file: uploaded)
+    Account::ImportJob.perform_later(@import)
+
+    respond_to do |format|
+      format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. We'll email you when it's done." }
+      format.json { render json: { id: @import.id, status: @import.status }, status: :accepted }
+    end
+  end
+
+  def show
+    @import = Current.account.imports.find(params[:id])
+    respond_to do |format|
+      format.html
+      format.json do
+        render json: {
+          id: @import.id,
+          status: @import.status,
+          error_message: @import.error_message,
+          new_account_id: @import.new_account_id
+        }
+      end
+    end
+  end
+end
