--- /dev/null
+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,24 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(export)
+    export = Account::Export.find(export.id) if export.is_a?(Account::Export)
+    Current.with_account(export.account) do
+      Current.set(user: export.user) do
+        begin
+          export.generate!
+          ExportMailer.export_ready(export).deliver_later
+        rescue => e
+          begin
+            ExportMailer.export_failed(export, e.message).deliver_later
+          rescue
+            nil
+          end
+          raise
+        end
+      end
+    end
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
