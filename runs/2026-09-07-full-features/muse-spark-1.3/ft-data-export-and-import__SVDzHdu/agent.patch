+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,29 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :default
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(import)
+    import = Account::Import.find(import.id) if import.is_a?(Account::Import)
+    Current.with_account(import.account) do
+      Current.set(user: import.user) do
+        begin
+          new_account = import.process!
+          ImportMailer.import_completed(import).deliver_later
+        rescue Account::DataTransfer::Importer::ImportError => e
+          import.reload
+          ImportMailer.import_failed(import, e.message).deliver_later
+          raise
+        rescue => e
+          import.reload rescue nil
+          begin
+            ImportMailer.import_failed(import, e.message).deliver_later
+          rescue
+            nil
+          end
+          raise
+        end
+      end
+    end
+  end
+end
diff --git a/app/mailers/export_mailer.rb b/app/mailers/export_mailer.rb
new file mode 100644
index 0000000..8484ce6
--- /dev/null
+++ b/app/mailers/export_mailer.rb
@@ -0,0 +1,37 @@
+class ExportMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @download_url = download_url_for(@export)
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your export is ready"
+    )
+  end
+
+  def export_failed(export, error_message = nil)
+    @export = export
+    @user = export.user
+    @account = export.account
+    @error_message = error_message || export.error_message
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your export failed"
+    )
+  end
+
+  private
+    def download_url_for(export)
+      token = export.download_token
+      # Build absolute URL honoring tenant slug
+      account_slug = export.account.slug
+      host = Rails.application.config.action_mailer.default_url_options&.dig(:host) || "example.com"
+      # Use polymorphic route with script_name so link works inside tenant
+      Rails.application.routes.url_helpers.account_export_download_url(token, host: host, script_name: account_slug)
+    rescue
+      token
+    end
+end
