@@ -3,6 +3,42 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
     super(account: account, model: ::ActiveStorage::Blob)
   end
 
+  # Files are binary payloads, not JSON. Stream each blob's bytes
+  # directly into the zip without loading whole files into memory,
+  # supporting both Disk and S3 services and very large files.
+  def export_to(zip)
+    records.find_each do |blob|
+      zip.add_file("files/#{blob.id}", compress: false) do |sink|
+        download_blob_streaming(blob) do |chunk|
+          sink.write(chunk)
+        end
+      end
+    end
+  end
+  alias export export_to
+
+  # Import: stream each files/<old_blob_id> entry into the NEW blob's
+  # storage (new key), updating byte_size/checksum.
+  def import_from(reader, context)
+    count = 0
+    reader.glob("files/*").each do |path|
+      # Skip friendly card files? Both use files/<blob_id>, same handling.
+      # Only process blobs that were mapped (i.e., in BlobRecordSet).
+      old_blob_id = path.sub(%r{\Afiles/}, "")
+      next if old_blob_id.include?("/")
+      new_blob_id = context.mapped?(old_blob_id) ? context.id_for(old_blob_id) : nil
+      next unless new_blob_id
+
+      blob = ::ActiveStorage::Blob.find_by(id: new_blob_id)
+      next unless blob
+
+      upload_streaming(reader, path, blob)
+      count += 1
+    end
+    count
+  end
+  alias import import_from
+
   private
     def records
       ::ActiveStorage::Blob.where(account: account).where.not(id: excluded_blob_ids)
@@ -12,4 +48,33 @@ class Account::DataTransfer::ActiveStorage::FileRecordSet < Account::DataTransfe
       ::ActiveStorage::Attachment.where(account: account, record_type: INTERNAL_RECORD_TYPES).select(:blob_id)
     end
 
+    def download_blob_streaming(blob)
+      service = blob.service
+      begin
+        service.download(blob.key) do |chunk|
+          yield chunk
+        end
+        return
+      rescue ArgumentError, LocalJumpError
+      end
+      blob.open do |file|
+        File.open(file.path, "rb") do |f|
+          while (chunk = f.read(5.megabytes))
+            yield chunk
+          end
+        end
+      end
+    end
+
+    def upload_streaming(reader, path, blob)
+      service = blob.service
+      Tempfile.create([ "import-blob", ".bin" ], binmode: true) do |tmp|
+        reader.stream_to(path, tmp)
+        tmp.flush
+        tmp.rewind
+        File.open(tmp.path, "rb") do |f|
+          service.upload(blob.key, f, checksum: blob.checksum, content_type: blob.content_type)
+        end
+      end
+    end
 end
diff --git a/app/models/account/data_transfer/card_record_set.rb b/app/models/account/data_transfer/card_record_set.rb
new file mode 100644
index 0000000..44bde37
--- /dev/null
+++ b/app/models/account/data_transfer/card_record_set.rb
@@ -0,0 +1,56 @@
+# Card rows are exported enriched with comments + attachment metadata so that
+# "Cards come as JSON with their comments, plus every picture and file".
+# Import ignores the extra keys and restores the plain row; comments and
+# attachments are restored via their own record sets.
+class Account::DataTransfer::CardRecordSet < Account::DataTransfer::RecordSet
+  def initialize(account)
+    super(account: account, model: Card)
+  end
+
+  private
+    def decorate_export_attributes(record, attrs)
+      attrs["comments"] = enriched_comments(record)
+      attrs["description_body"] = begin record.description&.to_s rescue nil end
+      attrs["description_text"] = begin record.description&.to_plain_text rescue nil end
+      attrs["attachment_files"] = attachment_files(record)
+      attrs
+    end
+
+    def enriched_comments(card)
+      Comment.where(card_id: card.id).order(:created_at).map do |comment|
+        {
+          "id" => comment.id,
+          "creator_id" => comment.creator_id,
+          "created_at" => comment.created_at&.utc&.iso8601,
+          "updated_at" => comment.updated_at&.utc&.iso8601,
+          "body" => begin comment.body&.to_s rescue nil end,
+          "body_text" => begin comment.body&.to_plain_text rescue nil end
+        }
+      end
+    end
+
+    def attachment_files(record)
+      rich_text_ids = ActionText::RichText.where(record: record).pluck(:id)
+      attachments = ActiveStorage::Attachment.where(
+        "(record_type = ? AND record_id = ?) OR (record_type = ? AND record_id IN (?))",
+        record.class.name, record.id, "ActionText::RichText", rich_text_ids.presence || [ "00000000-0000-0000-0000-000000000000" ]
+      ).includes(:blob)
+      attachments = attachments.where.not(record_type: INTERNAL_RECORD_TYPES)
+      files = attachments.map do |att|
+        blob = att.blob
+        { "blob_id" => blob.id, "filename" => blob.filename.to_s, "file" => "files/#{blob.id}" }
+      end
+      if record.is_a?(Card) && record.image.attached?
+        blob = record.image.blob
+        files << { "blob_id" => blob.id, "filename" => blob.filename.to_s, "file" => "files/#{blob.id}" }
+      end
+      files
+    rescue
+      []
+    end
+
+    def sanitize_for_insert(attrs)
+      cols = model.column_names
+      attrs.select { |k, _| cols.include?(k.to_s) }
+    end
+end
diff --git a/app/models/account/data_transfer/cards_exporter.rb b/app/models/account/data_transfer/cards_exporter.rb
