index 0000000..2249693
--- /dev/null
+++ b/app/models/account/data_transfer/cards_exporter.rb
@@ -0,0 +1,154 @@
+# Lightweight cards-only exporter for profile-page downloads:
+# cards the user can see as JSON with comments + every attached picture/file.
+class Account::DataTransfer::CardsExporter < Account::DataTransfer::Exporter
+  def initialize(account, cards_scope)
+    super(account, cards_scope: cards_scope)
+  end
+
+  def export_to(zip)
+    zip.add_file("manifest.json", JSON.generate(
+      "version" => 1,
+      "type" => "cards",
+      "exported_at" => Time.current.utc.iso8601,
+      "account_id" => account.id
+    ))
+    export_cards(zip)
+    export_files(zip)
+  end
+  alias export export_to
+
+  private
+    def export_cards(zip)
+      cards_scope.find_each do |card|
+        data = card_json(card)
+        zip.add_file("cards/#{card.id}.json", JSON.generate(data))
+      end
+    end
+
+    def card_json(card)
+      comments = Comment.where(card_id: card.id).order(:created_at).map do |comment|
+        {
+          "id" => comment.id,
+          "creator_id" => comment.creator_id,
+          "creator_name" => begin comment.creator&.name rescue nil end,
+          "created_at" => comment.created_at&.utc&.iso8601,
+          "updated_at" => comment.updated_at&.utc&.iso8601,
+          "body" => begin comment.body&.to_s rescue nil end,
+          "body_text" => begin comment.body&.to_plain_text rescue nil end,
+          "attachments" => attachments_for_record_and_rich_texts(comment)
+        }
+      end
+
+      {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "board_id" => card.board_id,
+        "board_name" => begin card.board&.name rescue nil end,
+        "column_id" => card.column_id,
+        "column_name" => begin card.column&.name rescue nil end,
+        "creator_id" => card.creator_id,
+        "creator_name" => begin card.creator&.name rescue nil end,
+        "created_at" => card.created_at&.utc&.iso8601,
+        "updated_at" => card.updated_at&.utc&.iso8601,
+        "last_active_at" => card.last_active_at&.utc&.iso8601,
+        "description" => begin card.description&.to_s rescue nil end,
+        "description_text" => begin card.description&.to_plain_text rescue nil end,
+        "tags" => begin card.tags.pluck(:title).sort rescue [] end,
+        "comments" => comments,
+        "attachments" => attachments_for_record_and_rich_texts(card),
+        "image" => image_info(card)
+      }
+    end
+
+    def attachments_for_record_and_rich_texts(record)
+      rich_text_ids = ActionText::RichText.where(record: record).pluck(:id)
+      attachments = ActiveStorage::Attachment.where(
+        "(record_type = ? AND record_id = ?) OR (record_type = ? AND record_id IN (?))",
+        record.class.name, record.id, "ActionText::RichText", rich_text_ids.presence || [ "00000000-0000-0000-0000-000000000000" ]
+      ).includes(:blob)
+      attachments = attachments.where.not(record_type: Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES)
+      attachments.map do |attachment|
+        blob = attachment.blob
+        {
+          "attachment_id" => attachment.id,
+          "name" => attachment.name,
+          "record_type" => attachment.record_type,
+          "blob_id" => blob.id,
+          "filename" => blob.filename.to_s,
+          "content_type" => blob.content_type,
+          "byte_size" => blob.byte_size,
+          "file" => "files/#{blob.id}"
+        }
+      end
+    rescue
+      []
+    end
+
+    def image_info(card)
+      return nil unless card.image.attached?
+      blob = card.image.blob
+      {
+        "blob_id" => blob.id,
+        "filename" => blob.filename.to_s,
+        "content_type" => blob.content_type,
+        "byte_size" => blob.byte_size,
+        "file" => "files/#{blob.id}"
+      }
+    rescue
+      nil
+    end
+
+    def export_files(zip)
+      blob_ids = Set.new
+      cards_scope.find_each do |card|
+        blob_ids.merge(blob_ids_for(card))
+        Comment.where(card_id: card.id).find_each do |comment|
+          blob_ids.merge(blob_ids_for(comment))
+        end
+      end
+      ActiveStorage::Blob.where(id: blob_ids.to_a).find_each do |blob|
+        next if ActiveStorage::Attachment.where(blob_id: blob.id, record_type: Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES).exists?
+        zip.add_file("files/#{blob.id}", compress: false) do |sink|
+          stream_blob(blob) do |chunk|
+            sink.write(chunk)
+          end
+        end
+      end
+    end
+
+    def blob_ids_for(record)
+      rich_text_ids = ActionText::RichText.where(record: record).pluck(:id)
+      ids = ActiveStorage::Attachment.where(
+        "(record_type = ? AND record_id = ?) OR (record_type = ? AND record_id IN (?))",
+        record.class.name, record.id, "ActionText::RichText", rich_text_ids.presence || [ "00000000-0000-0000-0000-000000000000" ]
+      ).pluck(:blob_id)
+      if record.is_a?(Card) && record.image.attached?
+        ids << record.image.blob_id
+      end
+      ids
+    rescue
+      []
+    end
+
+    def stream_blob(blob)
+      service = blob.service
+      begin
+        service.download(blob.key) do |chunk|
+          yield chunk
+        end
+        return
+      rescue ArgumentError
+      end
+      blob.open do |file|
+        File.open(file.path, "rb") do |f|
+          while (chunk = f.read(5.megabytes))
+            yield chunk
+          end
+        end
+      end
+    end
+end
+
+CardsExporter = Account::DataTransfer::CardsExporter unless defined?(CardsExporter)
