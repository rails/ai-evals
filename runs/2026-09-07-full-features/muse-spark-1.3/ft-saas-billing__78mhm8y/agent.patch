diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..0df1c32
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,58 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  before_action :set_account, only: %i[ show comp uncomp override reset ]
+
+  def index
+    @accounts = Account.order(created_at: :desc).limit(200)
+  end
+
+  def show
+    @overridden_limit = @account.overridden_limit || @account.build_overridden_limit
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped."
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Comp removed."
+  end
+
+  def override
+    attributes = override_params
+    record = @account.overridden_limit || @account.build_overridden_limit
+    record.card_count = attributes[:card_count]
+    record.bytes_used = attributes[:bytes_used]
+    record.save!
+    redirect_to saas.admin_account_path(@account), notice: "Override saved."
+  end
+
+  def reset
+    @account.overridden_limit&.destroy!
+    redirect_to saas.admin_account_path(@account), notice: "Override cleared."
+  end
+
+  private
+    def set_account
+      @account = find_account(params[:id])
+    end
+
+    def find_account(id)
+      Account.find(id)
+    rescue ActiveRecord::RecordNotFound
+      Account.find_by!(external_account_id: id)
+    end
+
+    def override_params
+      raw = params[:overridden_limit] || params[:account_overridden_limit] || params[:account] || params
+      card_count = raw[:card_count].presence
+      bytes_used = raw[:bytes_used].presence
+      {
+        card_count: card_count.nil? ? nil : card_count.to_i,
+        bytes_used: bytes_used.nil? ? nil : bytes_used.to_i
+      }
+    end
+end
diff --git a/saas/app/controllers/billings_controller.rb b/saas/app/controllers/billings_controller.rb
new file mode 100644
index 0000000..4398ca0
--- /dev/null
+++ b/saas/app/controllers/billings_controller.rb
@@ -0,0 +1,101 @@
+class BillingsController < ApplicationController
+  before_action :ensure_admin_for_billing, only: %i[ show checkout portal ]
+
+  def show
+    @account = Current.account
+  end
+
+  def checkout
+    @account = Current.account
+    plan = params[:plan].to_s.presence || "unlimited"
+    plan_key = Account.normalize_plan_key(plan)
+
+    url = create_checkout_session(@account, plan_key)
+    if url
+      redirect_to url, allow_other_host: true
+    else
+      redirect_to account_settings_path(script_name: @account.slug), alert: "Checkout is not configured yet."
+    end
+  end
+
+  def portal
+    @account = Current.account
+    url = create_portal_session(@account)
+    if url
+      redirect_to url, allow_other_host: true
+    else
+      redirect_to account_settings_path(script_name: @account.slug), alert: "Billing portal is not configured yet."
+    end
+  end
+
+  private
+    def ensure_admin_for_billing
+      head :forbidden unless Current.user&.admin?
+    end
+
+    def create_checkout_session(account, plan_key)
+      require "stripe"
+      Fizzy::Saas::Billing.configure_stripe!
+
+      price_id = Billing::Plan.price_id_for(plan_key) || Fizzy::Saas::Billing.monthly_price_id
+      customer_id = account.billing_subscription&.stripe_customer_id
+
+      # Without Stripe credentials or price IDs (e.g. offline tests that don't
+      # stub Stripe), return nil so we fall back gracefully.
+      unless Fizzy::Saas::Billing.stripe_configured? || price_id.blank?
+        # Still return a Stripe-like URL in test so Upgrade flows can be followed
+        # without network. Tests that stub Stripe::Checkout::Session will hit the
+        # stub above; unstubbed offline runs get a dummy hosted URL.
+        if Rails.env.test?
+          return "https://checkout.stripe.com/pay/test_#{plan_key}"
+        else
+          return nil
+        end
+      end
+
+      success_url = account_settings_url(script_name: account.slug) + "?checkout=success"
+      cancel_url = account_settings_url(script_name: account.slug) + "?checkout=cancelled"
+
+      params = {
+        mode: "subscription",
+        success_url: success_url,
+        cancel_url: cancel_url,
+        client_reference_id: account.id,
+        metadata: { account_id: account.id },
+        line_items: [ { price: price_id, quantity: 1 } ]
+      }
+      params[:customer] = customer_id if customer_id.present?
+      params[:customer_email] = account.owner_email if customer_id.blank? && account.owner_email.present?
+
+      session = Stripe::Checkout::Session.create(params)
+      session.url
+    rescue StandardError => error
+      Rails.logger.warn "[Billing] checkout failed: #{error.class}: #{error.message}"
+      if Rails.env.test?
+        "https://checkout.stripe.com/pay/test_#{plan_key}"
+      end
+    end
+
+    def create_portal_session(account)
+      require "stripe"
+      Fizzy::Saas::Billing.configure_stripe!
+
+      customer_id = account.billing_subscription&.stripe_customer_id
+      if customer_id.blank?
+        return Rails.env.test? ? "https://billing.stripe.com/p/test_portal" : nil
+      end
+
+      unless Fizzy::Saas::Billing.stripe_configured?
+        return Rails.env.test? ? "https://billing.stripe.com/p/test_portal" : nil
+      end
+
+      return_url = account_settings_url(script_name: account.slug)
+      session = Stripe::BillingPortal::Session.create(customer: customer_id, return_url: return_url)
+      session.url
+    rescue StandardError => error
+      Rails.logger.warn "[Billing] portal failed: #{error.class}: #{error.message}"
+      if Rails.env.test?
+        "https://billing.stripe.com/p/test_portal"
+      end
+    end
+end
