+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+        <div>Plan: <%= @account.plan %></div>
+        <div>Cards: <%= number_with_delimiter(@account.billing_card_count) %> / <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %></div>
+        <div>Storage: <%= number_to_human_size(@account.bytes_used) %> / <%= number_to_human_size(@account.storage_limit) %></div>
+        <% if @account.comped? %>
+          <div>Comped</div>
+        <% end %>
+      </header>
+
+      <div class="flex gap-half margin-block-start-half">
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+        <% else %>
+          <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+          <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn" %>
+        <% end %>
+      </div>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override usage</h2>
+      </header>
+
+      <%= form_with model: @overridden_limit, url: saas.override_admin_account_path(@account), method: :post, scope: :overridden_limit, class: "flex flex-column gap-half" do |form| %>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :card_count, "Card count" %>
+          <%= form.number_field :card_count, class: "input" %>
+        </div>
+        <div class="flex flex-column gap-quarter">
+          <%= form.label :bytes_used, "Bytes used" %>
+          <%= form.number_field :bytes_used, class: "input" %>
+        </div>
+        <%= form.submit "Override", class: "btn" %>
+      <% end %>
+
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :post, class: "btn" %>
+    </section>
+  </div>
+</section>
