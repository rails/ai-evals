diff --git a/saas/lib/fizzy/saas/billing.rb b/saas/lib/fizzy/saas/billing.rb
new file mode 100644
index 0000000..10ecd9c
--- /dev/null
+++ b/saas/lib/fizzy/saas/billing.rb
@@ -0,0 +1,81 @@
+module Fizzy
+  module Saas
+    module Billing
+      def self.stripe_configured?
+        ENV["STRIPE_SECRET_KEY"].present?
+      end
+
+      def self.configure_stripe!
+        require "stripe"
+        Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+      end
+
+      def self.monthly_price_id
+        ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      end
+
+      def self.extra_storage_price_id
+        ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      end
+
+      # Resolve a plan key from Stripe subscription data without network calls.
+      # Handles real Stripe payloads (price IDs) as well as test payloads that
+      # carry plan names in metadata.
+      def self.plan_key_for_subscription(subscription_data)
+        data = subscription_data.with_indifferent_access rescue {}
+
+        metadata_plan = data.dig(:metadata, :plan) || data.dig(:metadata, :plan_key) ||
+          data.dig(:metadata, :planKey) || data[:plan_key] || data[:plan]
+        if metadata_plan.present?
+          return Account.normalize_plan_key(metadata_plan)
+        end
+
+        price_ids = []
+
+        if (items = data[:items]).present?
+          list = items[:data] || items
+          Array(list).each do |item|
+            price = item[:price] || item
+            price_ids << price[:id] if price.is_a?(Hash) && price[:id]
+            price_ids << item[:price_id] if item.is_a?(Hash) && item[:price_id]
+            price_ids << item[:id] if item.is_a?(Hash) && item[:id]&.start_with?("price_")
+          end
+        end
+
+        %i[ price_ids prices ].each do |key|
+          Array(data[key]).each { |id| price_ids << id.to_s }
+        end
+
+        if (plan = data[:plan]).is_a?(Hash)
+          price_ids << plan[:id].to_s if plan[:id]
+          price_ids << plan[:nickname].to_s if plan[:nickname]
+          price_ids << plan[:name].to_s if plan[:name]
+        elsif plan.present?
+          price_ids << plan.to_s
+        end
+
+        # Direct nickname matching for test payloads.
+        joined = price_ids.join(" ").downcase
+        if joined.include?("unlimited+") || joined.include?("unlimited_plus") || joined.include?("extra_storage") || joined.include?("extra-storage")
+          return "unlimited_plus"
+        elsif joined.include?("unlimited")
+          # Distinguish Unlimited vs Unlimited+ when both words appear.
+          if joined.include?("plus")
+            return "unlimited_plus"
+          else
+            return "unlimited"
+          end
+        end
+
+        resolved = Billing::Plan.plan_key_for_price_ids(price_ids)
+        if resolved == "free" && price_ids.any?
+          # Unknown price IDs in a subscription event imply a paid plan; default
+          # to unlimited rather than dropping to free.
+          "unlimited"
+        else
+          resolved
+        end
+      end
+    end
+  end
+end
