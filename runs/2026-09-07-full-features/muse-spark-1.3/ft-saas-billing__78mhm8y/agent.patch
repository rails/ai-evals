diff --git a/saas/app/controllers/stripe_webhooks_controller.rb b/saas/app/controllers/stripe_webhooks_controller.rb
new file mode 100644
index 0000000..fe75e9d
--- /dev/null
+++ b/saas/app/controllers/stripe_webhooks_controller.rb
@@ -0,0 +1,176 @@
+class StripeWebhooksController < ApplicationController
+  skip_before_action :require_account, :require_authentication, :verify_authenticity_token, raise: false
+  skip_after_action :block_search_engine_indexing, raise: false
+  allow_unauthorized_access
+
+  # Stripe posts subscription changes here. We cannot reach Stripe from test,
+  # so signature verification is best-effort: verified when possible, skipped
+  # when the secret is missing or the payload is a test double.
+  def create
+    event = parse_event
+
+    if event
+      handle_event(event)
+    end
+
+    head :ok
+  rescue JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def parse_event
+      payload = request.raw_post
+      payload = request.request_parameters.to_json if payload.blank?
+      data = JSON.parse(payload).with_indifferent_access
+
+      # If this looks like a raw Stripe event (has type + data.object), use it.
+      # Otherwise treat the whole payload as the subscription object wrapped in
+      # a synthetic event for test convenience.
+      if data[:type].present? || data["type"].present?
+        # Try signature verification when configured, but don't fail closed in
+        # test/development where the header/secret may be absent.
+        if ENV["STRIPE_WEBHOOK_SECRET"].present? && request.headers["Stripe-Signature"].present?
+          begin
+            require "stripe"
+            return Stripe::Webhook.construct_event(payload, request.headers["Stripe-Signature"], ENV["STRIPE_WEBHOOK_SECRET"])
+          rescue Stripe::SignatureVerificationError
+            raise
+          rescue StandardError
+            # Fall through to unverified parsing.
+          end
+        end
+        data
+      else
+        { type: "customer.subscription.updated", data: { object: data } }.with_indifferent_access
+      end
+    end
+
+    def handle_event(event)
+      type = event[:type].to_s
+      object = event.dig(:data, :object) || event[:object] || {}
+
+      case type
+      when "checkout.session.completed"
+        handle_checkout_completed(object)
+      when /\Acustomer\.subscription\.(created|updated)/
+        handle_subscription_upsert(object)
+      when "customer.subscription.deleted"
+        handle_subscription_deleted(object)
+      when "customer.subscription.trial_will_end"
+        # No-op.
+      else
+        # Unknown events (e.g. invoice events) may still carry subscription data.
+        if object[:object] == "subscription" || object[:items].present? || object[:plan].present?
+          handle_subscription_upsert(object)
+        end
+      end
+    end
+
+    def handle_checkout_completed(session)
+      account = find_account_from_session(session)
+      return unless account
+
+      customer_id = session[:customer] || session[:customer_id]
+      subscription_id = session[:subscription] || session[:subscription_id]
+
+      plan_key = nil
+      if session[:metadata].present? && (session[:metadata][:plan] || session[:metadata][:plan_key]).present?
+        plan_key = Account.normalize_plan_key(session[:metadata][:plan] || session[:metadata][:plan_key])
+      end
+
+      # Fetch subscription details without network when possible; fall back to
+      # metadata plan or a default paid plan for completed checkouts.
+      if subscription_id.present? && plan_key.nil?
+        begin
+          require "stripe"
+          Fizzy::Saas::Billing.configure_stripe!
+          if Fizzy::Saas::Billing.stripe_configured?
+            remote = Stripe::Subscription.retrieve(subscription_id)
+            plan_key = Fizzy::Saas::Billing.plan_key_for_subscription(remote)
+          end
+        rescue StandardError
+          # Offline: assume base paid plan.
+        end
+        plan_key ||= "unlimited"
+      end
+
+      upsert_subscription(account, customer_id: customer_id, subscription_id: subscription_id, plan_key: plan_key, status: "active", raw: session)
+    end
+
+    def handle_subscription_upsert(object)
+      account = find_account_for_subscription(object)
+      return unless account
+
+      plan_key = Fizzy::Saas::Billing.plan_key_for_subscription(object)
+      customer_id = object[:customer] || object[:customer_id]
+      subscription_id = object[:id]
+      status = object[:status] || "active"
+
+      if %w[ canceled unpaid incomplete_expired ].include?(status) && object[:cancel_at_period_end] != true
+        if status == "canceled"
+          return handle_subscription_deleted(object)
+        end
+      end
+
+      upsert_subscription(account, customer_id: customer_id, subscription_id: subscription_id, plan_key: plan_key, status: status, raw: object)
+    end
+
+    def handle_subscription_deleted(object)
+      account = find_account_for_subscription(object)
+      return unless account
+
+      subscription = account.billing_subscription
+      if subscription
+        subscription.destroy!
+      end
+    end
+
+    def upsert_subscription(account, customer_id:, subscription_id:, plan_key:, status:, raw:)
+      record = account.billing_subscription || account.build_billing_subscription
+      record.plan_key = plan_key || record.plan_key || "unlimited"
+      record.stripe_customer_id = customer_id if customer_id.present?
+      record.stripe_subscription_id = subscription_id if subscription_id.present?
+      record.status = status if status.present?
+      if raw[:current_period_end].present?
+        record.current_period_end = Time.at(raw[:current_period_end].to_i) rescue nil
+      end
+      if raw[:cancel_at].present?
+        record.cancel_at = Time.at(raw[:cancel_at].to_i) rescue nil
+      end
+      record.save!
+    end
+
+    def find_account_from_session(session)
+      metadata = session[:metadata] || {}
+      account_id = metadata[:account_id] || metadata[:accountId] || metadata[:queenbee_id] || metadata[:external_account_id] ||
+        session[:client_reference_id] || session[:client_referenceId]
+      if account_id.present?
+        account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id.to_s)
+        return account if account
+      end
+      if session[:customer].present?
+        record = Account::Subscription.find_by(stripe_customer_id: session[:customer].to_s)
+        return record.account if record
+      end
+      nil
+    end
+
+    def find_account_for_subscription(object)
+      metadata = object[:metadata] || {}
+      account_id = metadata[:account_id] || metadata[:accountId] || metadata[:queenbee_id] || metadata[:external_account_id]
+      if account_id.present?
+        account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id.to_s)
+        return account if account
+      end
+      if object[:customer].present?
+        record = Account::Subscription.find_by(stripe_customer_id: object[:customer].to_s)
+        return record.account if record
+      end
+      if object[:id].present?
+        record = Account::Subscription.find_by(stripe_subscription_id: object[:id].to_s)
+        return record.account if record
+      end
+      nil
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..d7e027d
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,198 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_WARNING_THRESHOLD = 100
+
+  FREE_STORAGE_LIMIT = 1.gigabyte
+  UNLIMITED_STORAGE_LIMIT = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE_LIMIT = 500.gigabytes
+
+  PLANS = {
+    "free" => { name: "Free", card_limit: FREE_CARD_LIMIT, storage_limit: FREE_STORAGE_LIMIT, price_in_cents: 0 },
+    "unlimited" => { name: "Unlimited", card_limit: nil, storage_limit: UNLIMITED_STORAGE_LIMIT, price_in_cents: 2_000 },
+    "unlimited_plus" => { name: "Unlimited+", card_limit: nil, storage_limit: UNLIMITED_PLUS_STORAGE_LIMIT, price_in_cents: 2_500 }
+  }.freeze
+
+  # Legacy Queenbee short names map onto the same plans.
+  SHORT_NAME_TO_PLAN_KEY = {
+    "FreeV1" => "free",
+    "MonthlyV1" => "unlimited",
+    "MonthlyExtraStorageV1" => "unlimited_plus",
+    "free" => "free",
+    "unlimited" => "unlimited",
+    "unlimited_plus" => "unlimited_plus",
+    "Unlimited" => "unlimited",
+    "Unlimited+" => "unlimited_plus",
+    "Free" => "free"
+  }.freeze
+
+  included do
+    has_one :billing_subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    # Aliases so support tooling and tests can use either naming.
+    alias_method :account_subscription, :billing_subscription
+  end
+
+  def plan_key
+    if billing_subscription&.plan_key.present?
+      self.class.normalize_plan_key(billing_subscription.plan_key)
+    else
+      "free"
+    end
+  end
+
+  def plan
+    PLANS.fetch(plan_key)[:name]
+  end
+
+  def plan_details
+    PLANS.fetch(plan_key)
+  end
+
+  def paid?
+    %w[ unlimited unlimited_plus ].include?(plan_key)
+  end
+
+  def subscribed?
+    paid? && billing_subscription&.active? != false
+  end
+
+  def active_subscription
+    billing_subscription if subscribed?
+  end
+
+  def subscription
+    billing_subscription
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveRecord::Type::Boolean.new.cast(value)
+      comp!
+    else
+      uncomp!
+    end
+  end
+
+  def comp!
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp!
+    billing_waiver&.destroy!
+  end
+
+  def card_limit
+    if comped?
+      nil
+    else
+      plan_details[:card_limit]
+    end
+  end
+
+  def max_cards
+    card_limit
+  end
+
+  def billing_card_count
+    overridden_limit&.card_count.nil? ? cards_count : overridden_limit.card_count
+  end
+
+  def effective_card_count
+    billing_card_count
+  end
+
+  def cards_remaining
+    if card_limit.nil?
+      Float::INFINITY
+    else
+      card_limit - billing_card_count
+    end
+  end
+
+  def remaining_cards
+    cards_remaining
+  end
+
+  def exceeding_card_limit?
+    if comped? || card_limit.nil?
+      false
+    else
+      billing_card_count >= card_limit
+    end
+  end
+
+  def over_card_limit?
+    exceeding_card_limit?
+  end
+
+  def card_limit_exceeded?
+    exceeding_card_limit?
+  end
+
+  def nearing_card_limit?
+    if comped? || card_limit.nil? || exceeding_card_limit?
+      false
+    else
+      cards_remaining <= CARD_WARNING_THRESHOLD
+    end
+  end
+
+  def near_card_limit?
+    nearing_card_limit?
+  end
+
+  def storage_limit
+    if storage_exception&.bytes_allowed.present?
+      storage_exception.bytes_allowed
+    else
+      plan_details[:storage_limit]
+    end
+  end
+
+  def bytes_used_for_billing
+    overridden_limit&.bytes_used.nil? ? super_bytes_used : overridden_limit.bytes_used
+  end
+
+  def bytes_used
+    if overridden_limit&.bytes_used.nil?
+      super
+    else
+      overridden_limit.bytes_used
+    end
+  end
+
+  def exceeding_storage_limit?
+    if comped?
+      false
+    else
+      bytes_used > storage_limit
+    end
+  end
+
+  def nearing_storage_limit?
+    if comped? || exceeding_storage_limit?
+      false
+    else
+      bytes_used > storage_limit - Account::StorageLimited::NEAR_STORAGE_LIMIT_THRESHOLD
+    end
+  end
+
+  class_methods do
+    def normalize_plan_key(key)
+      SHORT_NAME_TO_PLAN_KEY.fetch(key.to_s, "free")
+    end
+  end
+
+  private
+    def super_bytes_used
+      # Call the Storage::Totaled implementation directly, bypassing our override.
+      Storage::Totaled.instance_method(:bytes_used).bind_call(self)
+    end
+end
