--- /dev/null
+++ b/saas/app/models/billing/plan.rb
@@ -0,0 +1,42 @@
+module Billing
+  module Plan
+    FREE = "free"
+    UNLIMITED = "unlimited"
+    UNLIMITED_PLUS = "unlimited_plus"
+
+    DETAILS = {
+      FREE => { name: "Free", card_limit: 1_000, storage_limit: 1.gigabyte, price_in_cents: 0 },
+      UNLIMITED => { name: "Unlimited", card_limit: nil, storage_limit: 5.gigabytes, price_in_cents: 2_000 },
+      UNLIMITED_PLUS => { name: "Unlimited+", card_limit: nil, storage_limit: 500.gigabytes, price_in_cents: 2_500 }
+    }.freeze
+
+    def self.for_key(key)
+      DETAILS.fetch(Account.normalize_plan_key(key))
+    end
+
+    def self.price_id_for(plan_key)
+      case Account.normalize_plan_key(plan_key)
+      when UNLIMITED
+        ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      when UNLIMITED_PLUS
+        ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      end
+    end
+
+    def self.plan_key_for_price_ids(price_ids)
+      ids = Array(price_ids).compact.map(&:to_s)
+      monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"].to_s
+      extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"].to_s
+
+      if extra.present? && ids.include?(extra)
+        UNLIMITED_PLUS
+      elsif monthly.present? && ids.include?(monthly)
+        UNLIMITED
+      else
+        # Fall back to name-based heuristics when price IDs are unknown (e.g. tests
+        # that cannot reach Stripe stub their own IDs).
+        FREE
+      end
+    end
+  end
+end
