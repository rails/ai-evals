diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..90cbbae
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,98 @@
+# Fizzy — single-box Kamal config (SQLite, one container, kamal-proxy SSL).
+#
+# This is the self-host / OSS deploy. It is deliberately separate from the
+# 37signals SaaS deploys in saas/config/deploy.*.yml (those are multi-host,
+# MySQL, and only used with `bin/kamal -d <destination>` in SaaS mode).
+#
+# Fork setup — fill in the placeholders, then run:
+#
+#   1. Set the secrets in your shell (see .kamal/secrets):
+#        KAMAL_REGISTRY_PASSWORD=$(...)  # Docker Hub access token
+#        SECRET_KEY_BASE=$(openssl rand -hex 64)
+#        SMTP_PASSWORD=$(...)            # your mail provider password/token
+#      (RAILS_MASTER_KEY is only needed if you use Rails credentials.)
+#   2. Edit the three placeholders below: server IP, proxy host, image name,
+#      plus APP_HOST / mail server settings under `env`.
+#   3. Provision + deploy the box:
+#        bin/kamal setup
+#      Later deploys:
+#        bin/kamal deploy
+#
+# What you get: Fizzy at https://YOUR_HOST with SQLite + uploads persisted in
+# the `fizzy_storage` Docker volume (survives redeploys), and Solid Queue
+# background jobs running inside the same web container (via Puma plugin).
+
+service: fizzy
+
+# Your container image. Forks should point this at their own repository, e.g.
+# `your-dockerhub-user/fizzy`. Kamal builds the root Dockerfile and pushes here.
+image: your-dockerhub-user/fizzy
+
+# One box: a single Linux server with Docker. Replace with your server's IP or
+# hostname. The same host serves the app, runs jobs (in-process), and holds the
+# SQLite volume.
+servers:
+  web:
+    - YOUR_SERVER_IP_OR_HOSTNAME
+
+# SSL is terminated at kamal-proxy on the box. `ssl: true` gets a free Let's
+# Encrypt certificate for `host` (port 443 must be reachable). The proxy talks
+# plain HTTP to the container on `app_port: 80` (Thruster listens on 80).
+proxy:
+  ssl: true
+  host: YOUR_HOST.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+    interval: 5
+    timeout: 5
+
+# Docker Hub credentials. Create a scoped access token and export it — see
+# .kamal/secrets. (If you use another registry, add `server: <registry host>`.)
+registry:
+  username: your-dockerhub-username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Build the root (OSS) Dockerfile locally for the target server CPU.
+builder:
+  arch: amd64
+
+# Environment injected into the container. Secrets (see .kamal/secrets) are
+# resolved from your shell at deploy time — never commit raw values here.
+env:
+  clear:
+    RAILS_ENV: production
+    # Run Solid Queue workers inside the Puma process so everything fits in one
+    # container on the box. (config/puma.rb enables the plugin unless this is
+    # literally "false".)
+    SOLID_QUEUE_IN_PUMA: true
+    # Public hostname of the app. Used for mailer/controller URL generation
+    # (see config/environments/production.rb). Must match proxy.host above.
+    APP_HOST: YOUR_HOST.example.com
+    # "From" header for all outgoing mail (magic links, notifications, ...).
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@YOUR_HOST.example.com>
+    # Outgoing mail server. Fill in your provider (Postmark, SendGrid, SES,
+    # your own Postfix, ...). Password/token comes from secrets as SMTP_PASSWORD.
+    SMTP_ADDRESS: YOUR_SMTP_HOST.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: YOUR_HOST.example.com
+    SMTP_USERNAME: YOUR_SMTP_USERNAME
+  secret:
+    - SECRET_KEY_BASE
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# Persist SQLite databases (primary/cable/cache/queue) and Active Storage files.
+# All of them live under /rails/storage, so one named volume keeps data alive
+# across deploys. Without this, `kamal redeploy` would wipe your database.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Share fingerprinted assets between releases to avoid 404s for in-flight
+# requests during a rolling restart.
+asset_path: /rails/public/assets
+
+# Use a root-owned SSH connection by default; override if your box uses `app`:
+# ssh:
+#   user: root
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..f2c0982 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,29 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Single-box / self-hosted (Kamal) configuration.
+  #
+  # `bin/kamal setup` injects APP_HOST (public FQDN, same as proxy.host in
+  # config/deploy.yml) and SMTP_* settings. When present they become the
+  # canonical host for generated URLs and the outgoing mail server. SaaS
+  # environments override these afterwards, so this is a no-op there.
+  app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence || ENV["HOST"].presence
+  if app_host
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+  end
+
+  config.action_mailer.delivery_method = :smtp
+  config.action_mailer.smtp_settings = {
+    address: ENV.fetch("SMTP_ADDRESS", "localhost"),
+    port: ENV.fetch("SMTP_PORT", "25").to_i,
+    domain: ENV.fetch("SMTP_DOMAIN", app_host || "localhost"),
+    user_name: ENV["SMTP_USERNAME"].presence,
+    password: ENV["SMTP_PASSWORD"].presence,
+    authentication: ENV["SMTP_AUTHENTICATION"].presence || (ENV["SMTP_USERNAME"].present? ? "plain" : nil),
+    enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+  }.compact
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
