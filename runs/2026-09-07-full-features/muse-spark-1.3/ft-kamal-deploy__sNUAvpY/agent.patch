@@ -0,0 +1,17 @@
+# Fizzy single-box secrets (safe for git — no raw values here).
+#
+# Kamal resolves each line in this file at deploy time. Export the values in
+# your shell before running `bin/kamal setup` / `bin/kamal deploy`:
+#
+#   export KAMAL_REGISTRY_PASSWORD="your-docker-hub-access-token"
+#   export SECRET_KEY_BASE="$(openssl rand -hex 64)"
+#   export SMTP_PASSWORD="your-mail-provider-password-or-token"
+#   # Only if you use Rails credentials (config/credentials/production.yml.enc):
+#   # export RAILS_MASTER_KEY="$(cat config/master.key)"
+#
+# Then Kamal picks them up via the pass-throughs below.
+
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+SMTP_PASSWORD=$SMTP_PASSWORD
