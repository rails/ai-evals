new file mode 100644
index 0000000..6c43fce
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,13 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(created_at: :asc)
+    Current.account = @bundle.account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "You have #{@notifications.size} new notifications"
+    )
+  end
+end
