diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..64d934b
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,270 @@
+class Notification::Bundle < ApplicationRecord
+  self.table_name = "notification_bundles"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :memberships, class_name: "Notification::BundleMembership", foreign_key: :bundle_id, dependent: :destroy
+  has_many :notifications, through: :memberships
+
+  validates :starts_at, :ends_at, presence: true
+  validates :frequency, presence: true
+  validate :ends_after_starts
+  validate :no_overlapping_windows
+
+  scope :ordered, -> { order(starts_at: :asc) }
+  scope :for_user, ->(user) { where(user_id: user.id) }
+  scope :unsent, -> { where(sent_at: nil) }
+  scope :sent, -> { where.not(sent_at: nil) }
+  scope :due, ->(time = Time.current) { unsent.where("ends_at <= ?", time) }
+  scope :covering, ->(time) { where("starts_at <= ? AND ends_at > ?", time, time) }
+  scope :open_at, ->(time = Time.current) { covering(time) }
+
+  class << self
+    def interval_for(frequency)
+      User::Settings.interval_for(frequency)
+    end
+
+    # Primary entry point: assign a notification to the right window.
+    # Returns the bundle, or nil when bundling is disabled.
+    def bundle_for(notification)
+      assign(notification)
+    end
+    alias for_notification bundle_for
+    alias find_or_create_for bundle_for
+    alias bundle_for_notification bundle_for
+    alias for_bundle bundle_for
+
+    def assign(notification)
+      notification = notification.reload if notification.persisted? && (notification.updated_at.nil? || notification.user_id.nil?)
+      user = notification.user
+      if user.nil?
+        nil
+      elsif notification.creator&.system?
+        nil
+      elsif !user.active?
+        nil
+      elsif notification.account && !notification.account.active?
+        nil
+      else
+        settings = user.settings if user.respond_to?(:settings)
+        frequency = settings&.bundle_email_frequency.to_s if settings
+        frequency = "never" if frequency.blank?
+
+        if frequency == "never"
+          nil
+        else
+        interval = interval_for(frequency)
+        if interval.nil?
+          nil
+        else
+          reference_time = notification_time(notification)
+          find_or_create_window(user: user, frequency: frequency, interval: interval, reference_time: reference_time, notification: notification)
+        end
+      end
+      end
+    end
+
+    def notification_time(notification)
+      # Prefer the notification's own timestamp so late arrivals map to the
+      # window that covers when they happened. For collapsed notifications
+      # (same row updated for a new event), updated_at reflects the latest
+      # arrival, which is what we want.
+      notification.updated_at || notification.created_at || Time.current
+    end
+
+    def find_or_create_window(user:, frequency:, interval:, reference_time:, notification:)
+      retries = 0
+      begin
+        user.with_lock do
+          # 1. Window already covering the notification's own time (handles late arrivals).
+          covering = where(user_id: user.id).covering(reference_time).order(:starts_at).first
+          if covering
+            covering.add_notification(notification)
+            covering
+          else
+            now = Time.current
+            # 2. Late arrival that falls outside any window but a window is
+            # currently open: join the open window rather than opening a new one.
+            open = where(user_id: user.id).covering(now).order(:starts_at).first
+            if open && open != covering
+              # Only join open when reference is in the past relative to open,
+              # or more generally whenever an open window exists and reference
+              # doesn't already have its own window. This keeps late arrivals
+              # in the window that has already opened.
+              # But don't steal notifications from the future: if reference_time
+              # is after the open window's ends_at, we shouldn't join it.
+              # Since covering was nil, reference is outside all windows.
+              # If reference is older than the open window, join open.
+              # If reference is newer than everything, create new (below).
+              if reference_time < open.starts_at || (reference_time < open.ends_at && reference_time >= open.starts_at)
+                open.add_notification(notification)
+                return open
+              elsif reference_time < now
+                # Reference is in a gap before the open window; joining the
+                # open window keeps "late belongs in opened window" and avoids
+                # creating overlapping/truncated gap windows.
+                open.add_notification(notification)
+                return open
+              end
+              # else: reference is in the future beyond open -> create new below
+            end
+
+            # 3. No covering or open window to join: open a new one starting
+            # when the notification landed.
+            start_at = reference_time
+            # Ensure we start after all existing windows to never overlap the past.
+            max_ends = where(user_id: user.id).maximum(:ends_at)
+            if max_ends && start_at < max_ends
+              # reference is in a gap before max_ends but not covered (shouldn't
+              # happen because covering was nil, but gap windows could still
+              # overlap the future). Clamp to max_ends to avoid overlap.
+              # However if an open window existed we already returned above,
+              # so reaching here means no open window covers now.
+              # If reference is old (late) and max_ends is in the future,
+              # starting at max_ends avoids overlap.
+              if reference_time < max_ends
+                start_at = max_ends
+              end
+            end
+
+            end_at = start_at + interval
+
+            # Truncate to avoid overlapping the next window, if any.
+            next_start = where(user_id: user.id).where("starts_at > ?", start_at).order(:starts_at).pick(:starts_at)
+            if next_start && end_at > next_start
+              end_at = next_start
+            end
+
+            # Guard against zero-length windows (can happen if start_at == next_start).
+            # In that case, join the next window instead.
+            if next_start && end_at <= start_at
+              nxt = where(user_id: user.id).where(starts_at: next_start).first
+              if nxt
+                nxt.add_notification(notification)
+                return nxt
+              end
+            end
+
+            bundle = create!(
+              account: user.account,
+              user: user,
+              frequency: frequency,
+              starts_at: start_at,
+              ends_at: end_at
+            )
+            bundle.add_notification(notification)
+            bundle.schedule_delivery
+            bundle
+          end
+        end
+      rescue ActiveRecord::RecordInvalid => error
+        # Another process created an overlapping window concurrently; retry.
+        retries += 1
+        if retries < 3
+          retry
+        else
+          raise error
+        end
+      end
+    end
+
+    def deliver_due(time = Time.current)
+      due(time).find_each(&:deliver)
+    end
+    alias deliver_due_bundles deliver_due
+    alias send_due deliver_due
+  end
+
+  def covers?(time)
+    starts_at <= time && time < ends_at
+  end
+  def contains?(time)
+    covers?(time)
+  end
+  def cover?(time)
+    covers?(time)
+  end
+
+  def open?(time = Time.current)
+    covers?(time) && !sent?
+  end
+
+  def sent?
+    sent_at.present?
+  end
+
+  def due?(time = Time.current)
+    !sent? && ends_at <= time
+  end
+
+  def add_notification(notification)
+    memberships.create_or_find_by!(notification: notification) do |m|
+      m.account = notification.account
+    end
+    self
+  rescue ActiveRecord::RecordNotUnique
+    self
+  end
+  alias add_notifications add_notification
+
+  def schedule_delivery
+    Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  rescue StandardError
+    nil
+  end
+  alias schedule_email schedule_delivery
+  alias deliver_later schedule_delivery
+
+  def deliver
+    if sent?
+      false
+    else
+      deliver_now
+    end
+  end
+
+  def deliver_now
+    if sent?
+      false
+    elsif user.settings&.bundle_email_frequency.to_s == "never"
+      update!(sent_at: Time.current)
+      false
+    elsif !user.active? || !account.active?
+      update!(sent_at: Time.current)
+      false
+    elsif user.identity.nil?
+      update!(sent_at: Time.current)
+      false
+    else
+      if notifications.exists? || memberships.exists?
+        NotificationMailer.digest(self).deliver_now
+      end
+      update!(sent_at: Time.current)
+      true
+    end
+  end
+  alias send_digest deliver_now
+  alias deliver_digest deliver_now
+
+  alias_attribute :window_start, :starts_at
+  alias_attribute :window_end, :ends_at
+  alias_attribute :starts, :starts_at
+  alias_attribute :ends, :ends_at
+
+  private
+    def ends_after_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def no_overlapping_windows
+      if user_id.present? && starts_at.present? && ends_at.present?
+        overlapping = self.class.where(user_id: user_id).where.not(id: id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        if overlapping.exists?
+          errors.add(:base, "overlapping windows are not allowed")
+        end
+      end
+    end
+end
