@@ -49,6 +51,69 @@ class Notification < ApplicationRecord
     read_at.present?
   end
 
+  def deliver_web_push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def deliver_web_push_on_create
+    deliver_web_push_later
+  end
+
+  def deliver_web_push_on_update
+    deliver_web_push_later
+  end
+
+  def deliver_web_push_now
+    return if user.push_subscriptions.empty?
+    return unless PushSubscription.vapid_public_key.present? && PushSubscription.vapid_private_key.present?
+
+    message = push_payload
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver(message)
+    end
+  end
+
+  def push_payload
+    JSON.generate(title: push_title, body: push_body, url: push_url)
+  end
+
+  def push_title
+    case source
+    when Event
+      push_helper.event_notification_title(source)
+    when Mention
+      "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def push_body
+    case source
+    when Event
+      push_helper.event_notification_body(source)
+    when Mention
+      source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  def push_url
+    Rails.application.routes.url_helpers.card_url(card, script_name: account.slug, host: push_host)
+  end
+
+  def push_host
+    Rails.application.routes.default_url_options[:host].presence ||
+      Rails.application.config.action_mailer.default_url_options[:host].presence ||
+      "example.com"
+  end
+
+  def push_helper
+    @push_helper ||= Object.new.extend(NotificationsHelper)
+  end
+
+  def saved_source_change_for_push?
+    previous_changes.key?("source_id") || previous_changes.key?("source_type")
+  end
+
+
   private
     def set_card
       self.card = source.card
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..2a6ec86
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,43 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_details
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+    end
+  end
+
+  def deliver(message)
+    WebPush.payload_send(
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid_details
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::Error
+    nil
+  end
+end
