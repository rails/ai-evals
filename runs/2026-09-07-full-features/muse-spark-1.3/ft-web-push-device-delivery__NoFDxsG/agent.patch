--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,48 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    subscription.assign_attributes(subscription_params)
+
+    if subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on for this device" }
+        format.json { head :no_content }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: subscription.errors.full_messages.to_sentence }
+        format.json { render json: subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+
+    subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..989801c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,112 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = {
+    vapidPublicKey: String,
+    subscribeUrl: String
+  }
+  static targets = [ "details" ]
+
+  connect() {
+    this.update()
+    if ("permissions" in navigator && navigator.permissions.query) {
+      navigator.permissions.query({ name: "notifications" }).then((status) => {
+        status.onchange = () => this.update()
+      }).catch(() => {})
+    }
+  }
+
+  async subscribe(event) {
+    if (event) event.preventDefault()
+    await this.enable()
+  }
+
+  async enable(event) {
+    if (event) event.preventDefault()
+
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission !== "granted") {
+      this.#showDetails()
+      this.update()
+      return
+    }
+
+    const subscription = await this.#getSubscription()
+
+    if (subscription) {
+      await this.#saveSubscription(subscription)
+    }
+
+    this.update()
+  }
+
+  update() {
+    const granted = ("Notification" in window) && Notification.permission === "granted"
+    this.element.classList.toggle("notifications--on", granted)
+  }
+
+  // Private
+
+  get #supported() {
+    return ("Notification" in window) && ("serviceWorker" in navigator) && ("PushManager" in window)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach((el) => {
+      el.hidden = false
+    })
+  }
+
+  async #getSubscription() {
+    const registration = await navigator.serviceWorker.ready
+
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+    }
+
+    return subscription
+  }
+
+  async #saveSubscription(subscription) {
+    const json = subscription.toJSON()
+
+    const body = new FormData()
+    body.append("push_subscription[endpoint]", subscription.endpoint)
+    body.append("push_subscription[p256dh_key]", json.keys.p256dh)
+    body.append("push_subscription[auth_key]", json.keys.auth)
+
+    const request = new FetchRequest("post", this.subscribeUrlValue, {
+      body,
+      responseKind: "json"
+    })
+
+    const response = await request.perform()
+
+    if (!response.ok) {
+      throw new Error("Failed to save push subscription")
+    }
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padding = "=".repeat((4 - (base64.length % 4)) % 4)
+    const raw = atob(base64 + padding)
+    const output = new Uint8Array(raw.length)
+    for (let i = 0; i < raw.length; ++i) {
+      output[i] = raw.charCodeAt(i)
+    }
+    return output
+  }
+}
