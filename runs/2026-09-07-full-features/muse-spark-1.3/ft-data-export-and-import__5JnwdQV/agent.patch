+class Users::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :download
+  skip_before_action :require_account, only: :download
+  before_action :set_user
+
+  def show
+  end
+
+  def create
+    @export = Current.account.exports.create!(user: Current.user, kind: "visible")
+    @export.export_later
+
+    respond_to do |format|
+      format.html { redirect_to @user, notice: "Your cards export is being prepared. We'll email you when it's ready." }
+      format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+    end
+  end
+
+  def download
+    token = params[:token] || params[:user_export_token]
+    begin
+      # Support both Account::Export tokens and lookup by user export
+      if params[:id]
+        @export = Account::Export.find_for_download!(params[:id], token)
+      else
+        @export = Account::Export.find_signed!(token, purpose: :export_download)
+      end
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      render plain: "This link has expired. Please request a new export.", status: :gone and return
+    end
+
+    unless @export.ready?
+      render plain: "Export is not ready yet.", status: :accepted and return
+    end
+
+    blob = @export.file.blob
+    if blob.service.is_a?(ActiveStorage::Service::DiskService)
+      send_file blob.service.path_for(blob.key), filename: @export.filename, type: "application/zip", disposition: "attachment"
+    else
+      redirect_to blob.url(expires_in: 1.day, disposition: "attachment; filename=\"#{@export.filename}\"")
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id]) if params[:user_id] && Current.account
+    end
+end
