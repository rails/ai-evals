@@ -0,0 +1,58 @@
+class Account::ExportsController < ApplicationController
+  allow_unauthenticated_access only: :download
+  skip_before_action :require_account, only: :download
+  before_action :ensure_admin_for_account_export, only: %i[create]
+  before_action :ensure_admin, only: %i[new]
+
+  def new
+  end
+
+  def create
+    kind = params[:kind] == "visible" ? "visible" : "account"
+
+    @export = Current.account.exports.create!(user: Current.user, kind: kind)
+    @export.export_later
+
+    respond_to do |format|
+      format.html { redirect_to account_settings_path, notice: "Your export is being prepared. We'll email you when it's ready." }
+      format.json { render json: { id: @export.id, status: @export.status }, status: :accepted }
+    end
+  end
+
+  def show
+    @export = Current.account.exports.find(params[:id])
+    head :forbidden unless @export.user == Current.user || Current.user.admin?
+
+    respond_to do |format|
+      format.html {}
+      format.json { render json: { id: @export.id, status: @export.status, ready: @export.ready? } }
+    end
+  end
+
+  private
+    def ensure_admin_for_account_export
+      kind = params[:kind] == "visible" ? "visible" : "account"
+      ensure_admin if kind == "account"
+    end
+
+  public
+  def download
+    token = params[:token]
+    begin
+      @export = Account::Export.find_for_download!(params[:id], token)
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      render plain: "This link has expired. Please request a new export.", status: :gone and return
+    end
+
+    unless @export.ready?
+      render plain: "Export is not ready yet.", status: :accepted and return
+    end
+
+    blob = @export.file.blob
+    if blob.service.is_a?(ActiveStorage::Service::DiskService)
+      send_file blob.service.path_for(blob.key), filename: @export.filename, type: "application/zip", disposition: "attachment"
+    else
+      redirect_to blob.url(expires_in: 1.day, disposition: "attachment; filename=\"#{@export.filename}\"")
+    end
+  end
+end
