+class Account::ImportsController < ApplicationController
+  skip_before_action :require_account, only: %i[new create show]
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    unless params[:account_import] && params[:account_import][:file]
+      respond_to do |format|
+        format.html do
+          @import = Account::Import.new
+          flash.now[:alert] = "Please choose a file to import."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { error: "Please choose a file to import." }, status: :unprocessable_entity }
+      end
+      return
+    end
+
+    requester = current_import_user
+    unless requester
+      respond_to do |format|
+        format.html { redirect_to session_menu_path(script_name: nil), alert: "Please sign in." }
+        format.json { render json: { error: "Please sign in." }, status: :unauthorized }
+      end
+      return
+    end
+
+    @import = Account::Import.new(user: requester, source_filename: params[:account_import][:file].original_filename)
+    # Ensure source account for attachment framework constraint
+    @import.account = Current.account || requester.account
+    @import.file.attach(params[:account_import][:file])
+    @import.save!
+    @import.import_later
+
+    respond_to do |format|
+      format.html { redirect_to account_import_path(@import), notice: "Your import is being processed. We'll email you when it's done." }
+      format.json { render json: { id: @import.id, status: @import.status }, status: :accepted }
+    end
+  end
+
+  def show
+    scope = Account::Import.where(user: current_import_user || Current.user)
+    @import = scope.find(params[:id])
+
+    respond_to do |format|
+      format.html {}
+      format.json { render json: { id: @import.id, status: @import.status, account_id: @import.account_id, error_message: @import.error_message } }
+    end
+  end
+
+  private
+    def current_import_user
+      Current.user || Current.identity&.users&.first
+    end
+end
