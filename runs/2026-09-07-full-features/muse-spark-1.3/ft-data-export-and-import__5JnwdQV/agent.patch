--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,77 @@
+class Account::Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  validates :kind, inclusion: { in: %w[account visible] }
+
+  scope :completed, -> { where(status: "completed") }
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def ready?
+    completed? && file.attached?
+  end
+
+  def filename
+    prefix = kind == "visible" ? "fizzy-cards" : "fizzy-account"
+    "#{prefix}-#{account.name.to_s.parameterize}-#{created_at&.to_fs(:number) || Time.current.to_fs(:number)}.zip"
+  end
+
+  def export_later
+    Account::ExportJob.perform_later(self)
+  end
+
+  def export_now
+    update!(status: "processing", error_message: nil)
+    Current.set(account: account, user: user) do
+      ZipFile.create_for(file, filename: filename) do |zip|
+        Account::Export::Packager.new(self, zip).package
+      end
+      update!(status: "completed", error_message: nil)
+      ExportMailer.ready(self).deliver_later
+    end
+  rescue => error
+    Rails.error.report(error, severity: :error)
+    begin
+      update!(status: "failed", error_message: "#{error.class}: #{error.message}")
+    rescue
+    end
+    raise error if Rails.env.test?
+  end
+
+  def download_token
+    signed_id(expires_in: 1.day, purpose: :export_download)
+  end
+
+  class << self
+    def find_for_download!(id, token)
+      record = find_signed!(token, purpose: :export_download)
+      raise ActiveRecord::RecordNotFound unless record.id.to_s == id.to_s
+      record
+    end
+  end
+
+  def cards_scope
+    if kind == "visible"
+      user.accessible_cards
+    else
+      account.cards
+    end
+  end
+end
diff --git a/app/models/account/export/packager.rb b/app/models/account/export/packager.rb
new file mode 100644
index 0000000..e536bc1
--- /dev/null
+++ b/app/models/account/export/packager.rb
@@ -0,0 +1,217 @@
+class Account::Export::Packager
+  BATCH_SIZE = 500
+
+  def initialize(export, zip)
+    @export = export
+    @zip = zip
+    @account = export.account
+    @user = export.user
+    @blob_paths = {}
+  end
+
+  def package
+    write_version
+    write_account
+    write_users
+    write_boards
+    write_cards
+    write_files_manifest
+  end
+
+  private
+    attr_reader :export, :zip, :account, :user, :blob_paths
+
+    def write_version
+      zip.add_file("version.json", JSON.pretty_generate(version_data))
+    end
+
+    def version_data
+      {
+        version: 1,
+        exported_at: Time.current.iso8601,
+        account_name: account.name,
+        kind: export.kind
+      }
+    end
+
+    def write_account
+      zip.add_file("account.json", JSON.pretty_generate(account_data))
+    end
+
+    def account_data
+      {
+        name: account.name
+      }
+    end
+
+    def write_users
+      users = account.users.active.includes(:identity).order(:created_at)
+      data = users.map do |u|
+        {
+          name: u.name,
+          email_address: u.identity&.email_address,
+          role: u.role,
+          verified_at: u.verified_at&.iso8601,
+          created_at: u.created_at.iso8601
+        }
+      end
+      zip.add_file("users.json", JSON.pretty_generate(data))
+    end
+
+    def write_boards
+      boards = account.boards.includes(:columns, :creator).order(:created_at)
+      data = boards.map do |board|
+        {
+          name: board.name,
+          all_access: board.all_access,
+          creator_email: board.creator&.identity&.email_address || board.creator&.name,
+          created_at: board.created_at.iso8601,
+          columns: board.columns.order(:position).map do |col|
+            { name: col.name, color: col.color.to_s, position: col.position }
+          end
+        }
+      end
+      zip.add_file("boards.json", JSON.pretty_generate(data))
+    end
+
+    def write_cards
+      cards = export.cards_scope.includes(:board, :column, :creator, :comments, :board).order(:number)
+      cards.find_each(batch_size: BATCH_SIZE) do |card|
+        write_card(card)
+      end
+    end
+
+    def write_card(card)
+      card_data = {
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        board: card.board&.name,
+        column: card.column&.name,
+        color: card.try(:color)&.to_s,
+        creator_email: creator_email_for(card.creator),
+        creator_name: card.creator&.name,
+        description_html: description_html_for(card),
+        due_on: card.due_on&.to_s,
+        created_at: card.created_at.iso8601,
+        updated_at: card.updated_at.iso8601,
+        image: image_data_for(card),
+        assignments: assignments_for(card),
+        steps: steps_for(card),
+        tags: tags_for(card),
+        comments: comments_for(card)
+      }
+      zip.add_file("cards/card-#{card.number}.json", JSON.pretty_generate(card_data))
+      write_card_blobs(card, card_data)
+    end
+
+    def creator_email_for(user)
+      user&.identity&.email_address
+    end
+
+    def description_html_for(card)
+      card.description&.body&.to_s
+    end
+
+    def image_data_for(card)
+      if card.image.attached?
+        blob = card.image.blob
+        {
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          checksum: blob.checksum,
+          path: file_path_for(blob),
+          sgid: blob.attachable_sgid.to_s
+        }
+      end
+    end
+
+    def assignments_for(card)
+      card.assignments.includes(assignee: :identity).map do |a|
+        { assignee_email: a.assignee&.identity&.email_address, assignee_name: a.assignee&.name }
+      end
+    end
+
+    def steps_for(card)
+      card.steps.order(:created_at).map do |s|
+        { content: s.content, completed: s.completed, created_at: s.created_at.iso8601 }
+      end
+    end
+
+    def tags_for(card)
+      card.tags.map(&:title)
+    end
+
+    def comments_for(card)
+      card.comments.includes(creator: :identity).order(:created_at).map do |comment|
+        body_html = comment.body&.body&.to_s
+        {
+          creator_email: creator_email_for(comment.creator),
+          creator_name: comment.creator&.name,
+          body_html: body_html,
+          created_at: comment.created_at.iso8601,
+          embeds: embeds_data_for(comment)
+        }
+      end
+    end
+
+    def embeds_data_for(record)
+      rich = rich_text_for(record)
+      return [] unless rich
+      rich.embeds.blobs.map do |blob|
+        {
+          filename: blob.filename.to_s,
+          content_type: blob.content_type,
+          byte_size: blob.byte_size,
+          checksum: blob.checksum,
+          path: file_path_for(blob),
+          sgid: blob.attachable_sgid.to_s
+        }
+      end
+    end
+
+    def rich_text_for(record)
+      assoc = record.class.reflect_on_all_associations(:has_one).find { it.klass == ActionText::RichText }
+      assoc && record.public_send(assoc.name)
+    end
+
+    def file_path_for(blob)
+      "files/#{blob.id}-#{blob.filename}"
+    end
+
+    def write_card_blobs(card, card_data)
+      blobs = card_blobs(card)
+      blobs.each do |blob|
+        path = file_path_for(blob)
+        next if blob_paths[blob.id]
+        blob_paths[blob.id] = { filename: blob.filename.to_s, content_type: blob.content_type, byte_size: blob.byte_size, checksum: blob.checksum, path: path, sgid: blob.attachable_sgid.to_s }
+        zip.add_file(path) do |sink|
+          stream_blob_to(blob, sink)
+        end
+      end
+      # Also ensure user avatars for creators? Not needed for cards, but include account avatars separately
+    end
+
+    def card_blobs(card)
+      blobs = []
+      blobs << card.image.blob if card.image.attached?
+      Array(card.description&.body&.attachments&.map(&:blob)).each { |b| blobs << b if b }
+      card.comments.each do |comment|
+        Array(comment.body&.body&.attachments&.map(&:blob)).each { |b| blobs << b if b }
+      end
+      blobs.uniq
+    rescue
+      blobs.uniq
+    end
+
+    def stream_blob_to(blob, sink)
+      blob.service.download(blob.key) do |chunk|
+        sink.write(chunk)
+      end
+    end
+
+    def write_files_manifest
+      zip.add_file("files.json", JSON.pretty_generate(blob_paths.values))
+    end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
