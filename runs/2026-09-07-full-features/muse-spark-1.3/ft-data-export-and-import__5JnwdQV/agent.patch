+      <%= button_to "Export my cards", user_export_path(@user), method: :post, class: "btn" %>
+    </section>
+  </div>
+<% end %>
+
 <% if @user.verified? %>
   <%= turbo_frame_tag "user_events", src: user_events_path(@user) %>
 <% end %>
