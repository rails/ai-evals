--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,66 @@
+class Account::Import < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, optional: true
+
+  before_validation :set_source_account, on: :create
+  before_save :ensure_file_attachment_account
+
+  has_one_attached :file
+
+  def pending?
+    status == "pending"
+  end
+
+  def processing?
+    status == "processing"
+  end
+
+  def completed?
+    status == "completed"
+  end
+
+  def failed?
+    status == "failed"
+  end
+
+  def import_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def import_now
+    update!(status: "processing", error_message: nil)
+    restorer = Account::Import::Restorer.new(self)
+    new_account = nil
+    begin
+      new_account = restorer.restore
+      update!(status: "completed", account: new_account, error_message: nil)
+      ImportMailer.completed(self).deliver_later
+    rescue => error
+      Rails.error.report(error, severity: :error)
+      begin
+        update!(status: "failed", error_message: "#{error.class}: #{error.message}")
+      rescue
+      end
+      ImportMailer.failed(self).deliver_later
+      raise error if Rails.env.test?
+    end
+    new_account
+  end
+
+  private
+    def set_source_account
+      self.account ||= Current.account || user&.account
+    end
+
+    def ensure_file_attachment_account
+      return unless file.attached?
+      acct = account || Current.account || user&.account
+      return unless acct
+      if file_attachment && file_attachment.account_id.blank?
+        file_attachment.account_id = acct.id
+      end
+      if file.blob && file.blob.account_id.blank?
+        file.blob.account_id = acct.id
+      end
+    end
+end
diff --git a/app/models/account/import/restorer.rb b/app/models/account/import/restorer.rb
