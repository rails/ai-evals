+++ b/app/models/account/import/restorer.rb
@@ -0,0 +1,349 @@
+class Account::Import::Restorer
+  def initialize(import)
+    @import = import
+    @requesting_user = import.user
+    @sgid_map = {}
+  end
+
+  def restore
+    download_to_tempfile do |zip_path|
+      read_zip_entries(zip_path) do |entries|
+        validate!(entries)
+        create_account_transactionally(entries, zip_path)
+      end
+    end
+  end
+
+  private
+    attr_reader :import, :requesting_user, :sgid_map
+
+    def download_to_tempfile
+      blob = import.file.blob
+      blob.open do |file|
+        yield file.path
+      end
+    end
+
+    def read_zip_entries(zip_path)
+      entries = {}
+      require "zip"
+      Zip::File.open(zip_path) do |zip|
+        zip.each do |entry|
+          next if entry.directory?
+          entries[entry.name] = entry
+        end
+        yield entries
+      end
+    end
+
+    def read_json(entries, zip_path, name)
+      entry = entries[name]
+      raise StandardError, "Missing #{name} in import file" unless entry
+      JSON.parse(entry.get_input_stream.read)
+    end
+
+    def validate!(entries)
+      unless entries["account.json"] || entries["cards/card-1.json"] || entries.keys.any? { it.start_with?("cards/") } || entries["users.json"]
+        raise StandardError, "Invalid import file: missing account data"
+      end
+    end
+
+    def create_account_transactionally(entries, zip_path)
+      new_account = nil
+      ActiveRecord::Base.transaction do
+        account_data = entries["account.json"] ? read_json(entries, zip_path, "account.json") : { "name" => "Imported account" }
+        account_name = account_data["name"].presence || "Imported account"
+
+        new_account = Account.create!(name: account_name)
+        new_account.users.create!(role: :system, name: "System")
+
+        # Requesting identity becomes owner of new account (or keep existing role mapping?)
+        owner_user = find_or_create_owner(new_account)
+
+        user_map = build_users(new_account, entries, zip_path)
+        user_map = user_map.merge(owner_user[:map]) if owner_user
+
+        board_map = build_boards(new_account, entries, zip_path, user_map)
+
+        build_cards(new_account, entries, zip_path, user_map, board_map)
+
+        # If anything failed, transaction rolls back; Storage entries suppressed? Let normal tracking run.
+        new_account
+      end
+      new_account
+    rescue => error
+      # Ensure nothing left behind: transaction already rolled back, but account might have been created outside?
+      # Since all inside transaction, nothing persists on failure.
+      raise error
+    end
+
+    def find_or_create_owner(new_account)
+      identity = requesting_user.identity
+      if identity
+        existing = new_account.users.find_by(identity: identity)
+        unless existing
+          owner = new_account.users.create!(name: requesting_user.name, identity: identity, role: :owner, verified_at: Time.current)
+          return { map: { identity.email_address => owner, requesting_user.name => owner } }
+        else
+          existing.update!(role: :owner) unless existing.owner?
+          return { map: { identity.email_address => existing } }
+        end
+      else
+        sys = new_account.system_user
+        return { map: {} }
+      end
+      { map: {} }
+    end
+
+    def build_users(new_account, entries, zip_path)
+      map = {}
+      return map unless entries["users.json"]
+      users_data = read_json(entries, zip_path, "users.json")
+      users_data.each do |u|
+        name = u["name"].presence || "Member"
+        email = u["email_address"].presence
+        role = %w[owner admin member].include?(u["role"]) ? u["role"] : "member"
+        # System users skipped (already created)
+        next if name == "System"
+
+        if email
+          identity = Identity.find_or_create_by!(email_address: email.strip.downcase)
+          # Reuse requesting user's identity mapping already handled, but ensure user in new account
+          user = new_account.users.find_by(identity: identity)
+          unless user
+            # First owner already created; demote duplicates: only one owner, rest admin/member
+            role = "admin" if role == "owner" && new_account.users.exists?(role: :owner)
+            user = new_account.users.create!(name: name, identity: identity, role: role, verified_at: Time.current)
+          end
+          map[email] = user
+          map[name] = user
+        else
+          user = new_account.users.create!(name: name, role: role, verified_at: nil)
+          map[name] = user
+        end
+      end
+      map
+    end
+
+    def build_boards(new_account, entries, zip_path, user_map)
+      map = {}
+      return map unless entries["boards.json"]
+      boards_data = read_json(entries, zip_path, "boards.json")
+      boards_data.each do |b|
+        creator = find_user(user_map, b["creator_email"], new_account)
+        board = new_account.boards.create!(name: b["name"].presence || "Board", all_access: !!b["all_access"], creator: creator)
+        (b["columns"] || []).each_with_index do |c, idx|
+          color_value = c["color"].presence || "var(--color-card-default)"
+          board.columns.create!(name: c["name"].presence || "Column", color: color_value, position: c["position"] || idx, account: new_account)
+        rescue => e
+          # Column color validation may fail; fallback
+          board.columns.create!(name: c["name"].presence || "Column", color: "var(--color-card-default)", position: c["position"] || idx, account: new_account)
+        end
+        map[b["name"]] = board
+      end
+      map
+    end
+
+    def build_cards(new_account, entries, zip_path, user_map, board_map)
+      require "zip"
+      card_names = entries.keys.select { it.start_with?("cards/") && it.end_with?(".json") }.sort
+      # Empty accounts (no cards) are valid — nothing to import for cards
+      # Allow empty cards (account with no cards) — still valid
+      Zip::File.open(zip_path) do |zip|
+        card_names.each do |name|
+          data = JSON.parse(zip.read(name))
+          create_card(new_account, zip, entries, data, user_map, board_map)
+        end
+      end
+    end
+
+    def create_card(new_account, zip, entries, data, user_map, board_map)
+      board = board_map[data["board"]] || new_account.boards.first || new_account.boards.create!(name: data["board"].presence || "Board", all_access: true, creator: new_account.users.where.not(role: :system).first || new_account.system_user)
+      # Ensure board in map for subsequent cards with same name
+      board_map[data["board"]] ||= board if data["board"]
+
+      creator = find_user(user_map, data["creator_email"] || data["creator_name"], new_account)
+      column = data["column"].present? ? board.columns.find_by(name: data["column"]) : nil
+
+      Current.set(user: creator, account: new_account) do
+        card = board.cards.build(
+          title: data["title"].presence || "Untitled",
+          status: %w[drafted published].include?(data["status"]) ? data["status"] : "published",
+          creator: creator,
+          account: new_account,
+          column: column,
+          due_on: data["due_on"].presence,
+          created_at: parse_time(data["created_at"]) || Time.current,
+          updated_at: parse_time(data["updated_at"]) || Time.current,
+          last_active_at: parse_time(data["updated_at"]) || Time.current
+        )
+        # Description with rewritten sgids
+        card.description = rewrite_html(data["description_html"], zip)
+        card.save!
+
+        # Image
+        if data["image"]
+          attach_blob_from_zip(card, :image, zip, entries, data["image"], new_account)
+        end
+
+        # Tags
+        Array(data["tags"]).each do |title|
+          tag = new_account.tags.find_or_create_by!(title: title.to_s.downcase.delete_prefix("#"))
+          card.taggings.create!(tag: tag, account: new_account)
+        rescue
+        end
+
+        # Steps
+        Array(data["steps"]).each do |s|
+          card.steps.create!(content: s["content"].to_s, completed: !!s["completed"], account: new_account)
+        rescue
+        end
+
+        # Assignments
+        Array(data["assignments"]).each do |a|
+          assignee = find_user(user_map, a["assignee_email"] || a["assignee_name"], new_account)
+          next if assignee.system?
+          card.assignments.create!(assignee: assignee, assigner: creator, account: new_account)
+        rescue
+        end
+
+        # Comments
+        Array(data["comments"]).each do |c|
+          comment_creator = find_user(user_map, c["creator_email"] || c["creator_name"], new_account)
+          Current.set(user: comment_creator) do
+            comment = card.comments.build(creator: comment_creator, account: new_account, created_at: parse_time(c["created_at"]) || Time.current, updated_at: parse_time(c["created_at"]) || Time.current)
+            comment.body = rewrite_html(c["body_html"], zip)
+            comment.save!
+            # Embeds are already handled via rewrite (blobs created during rewrite)
+          end
+        end
+
+        # Preserve number? Numbers auto-assigned; keep original if possible by updating after create
+        # (account.cards_count uniqueness) — we don't force original numbers to avoid collisions; new numbers assigned.
+        card
+      end
+    end
+
+    def find_user(user_map, key, new_account)
+      return user_map[key] if key && user_map[key]
+      if key&.include?("@")
+        identity = Identity.find_or_create_by!(email_address: key.strip.downcase)
+        user = new_account.users.find_by(identity: identity)
+        unless user
+          user = new_account.users.create!(name: key.split("@").first, identity: identity, role: :member, verified_at: Time.current)
+        end
+        user_map[key] = user
+        return user
+      elsif key.present?
+        # Find by name or create placeholder member
+        found = new_account.users.find_by(name: key)
+        return found if found
+        # Create with no identity (unverified)
+        user = new_account.users.create!(name: key, role: :member)
+        user_map[key] = user
+        return user
+      else
+        return new_account.system_user
+      end
+    end
+
+    def parse_time(str)
+      Time.parse(str.to_s)
+    rescue
+      nil
+    end
+
+    def rewrite_html(html, zip)
+      return nil if html.blank?
+      new_html = html.dup
+      # Find all sgids in html and replace with newly created blobs' sgids
+      sgids = html.scan(/sgid="([^"]+)"/).flatten.uniq
+      sgids.each do |old_sgid|
+        new_sgid = sgid_for(old_sgid, zip)
+        new_html.gsub!(old_sgid, new_sgid) if new_sgid
+      end
+      new_html
+    end
+
+    def sgid_for(old_sgid, zip)
+      return @sgid_map[old_sgid] if @sgid_map.key?(old_sgid)
+      old_blob = locate_old_blob(old_sgid, zip)
+      if old_blob
+        new_blob = create_blob_from_old(old_blob, zip)
+        @sgid_map[old_sgid] = new_blob.attachable_sgid.to_s
+      else
+        @sgid_map[old_sgid] = nil
+      end
+      @sgid_map[old_sgid]
+    rescue
+      nil
+    end
+
+    def locate_old_blob(old_sgid, zip)
+      # Try to locate via GlobalID (same instance)
+      begin
+        located = GlobalID::Locator.locate_signed(old_sgid)
+        return located if located.is_a?(ActiveStorage::Blob)
+      rescue
+      end
+      # Fallback: find by matching sgid in files.json / card metadata
+      # Search all file entries for a blob whose attachable_sgid matches? Can't without old blob.
+      # Instead, try to find blob by filename embedded in surrounding HTML? Give up.
+      nil
+    end
+
+    def create_blob_from_old(old_blob, zip)
+      # Find file bytes in zip: files/<id>-<filename> or files.json mapping
+      # Try direct path first
+      path = "files/#{old_blob.id}-#{old_blob.filename}"
+      data = nil
+      begin
+        data = zip.read(path)
+      rescue
+        # Try any files/* with matching filename
+        match = zip.glob("files/*").find { |e| e.name.end_with?(old_blob.filename.to_s) }
+        data = zip.read(match.name) if match
+      end
+      raise StandardError, "Missing file for blob #{old_blob.filename}" unless data
+      # Create new blob in new account context
+      account = Current.account
+      new_blob = ActiveStorage::Blob.build_after_unfurling(io: StringIO.new(data), filename: old_blob.filename.to_s, content_type: old_blob.content_type, record: nil)
+      new_blob.account_id = account.id
+      new_blob.save!
+      # Upload data (build_after_unfurling already uploads? Ensure)
+      unless new_blob.service.exist?(new_blob.key)
+        new_blob.service.upload(new_blob.key, StringIO.new(data), checksum: new_blob.checksum)
+      end
+      new_blob
+    end
+
+    def attach_blob_from_zip(record, name, zip, entries, meta, new_account)
+      path = meta["path"]
+      filename = meta["filename"] || "file"
+      content_type = meta["content_type"]
+      data = nil
+      begin
+        data = zip.read(path) if path && zip.find_entry(path)
+      rescue
+      end
+      unless data
+        # Fallback: find by filename
+        match = zip.glob("files/*").find { |e| e.name.end_with?(filename) }
+        data = zip.read(match.name) if match
+      end
+      return unless data
+      Current.set(account: new_account) do
+        blob = ActiveStorage::Blob.build_after_unfurling(io: StringIO.new(data), filename: filename, content_type: content_type, record: nil)
+        blob.account_id = new_account.id
+        blob.save!
+        unless blob.service.exist?(blob.key)
+          blob.service.upload(blob.key, StringIO.new(data), checksum: blob.checksum)
+        end
+        # Map old sgid to new for future rewrites
+        if meta["sgid"]
+          @sgid_map[meta["sgid"]] = blob.attachable_sgid.to_s
+        end
+        record.public_send(name).attach(blob)
+      end
+    end
+end
