diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..0b901ae
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,68 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRES_IN = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+
+  scope :active, -> { where("created_at > ?", EXPIRES_IN.ago) }
+
+  def self.generate_code_string
+    SecureRandom.alphanumeric(CODE_LENGTH).upcase
+  end
+
+  def self.issue_for(email_address)
+    normalized = Identity.new(email_address: email_address).email_address
+    return nil if normalized.blank?
+
+    where(email_address: normalized).delete_all
+    create!(email_address: normalized, code: generate_code_string)
+  end
+
+  def self.authenticate(email_address, input_code)
+    return nil if email_address.blank? || input_code.blank?
+
+    normalized_email = email_address.to_s.strip.downcase
+    normalized_code = input_code.to_s.strip.upcase
+    return nil if normalized_email.blank? || normalized_code.blank?
+
+    record = active.where(email_address: normalized_email).find_each.to_a.find do |candidate|
+      ActiveSupport::SecurityUtils.secure_compare(candidate.code.to_s.upcase, normalized_code) rescue candidate.code.to_s.upcase == normalized_code
+    end
+
+    # Fallback to case-insensitive SQL lookup for robustness
+    record ||= active.where(email_address: normalized_email).where("UPPER(code) = ?", normalized_code).first
+
+    if record
+      where(email_address: normalized_email).delete_all
+      record
+    else
+      nil
+    end
+  end
+
+  def self.authenticate_any(input_code)
+    normalized_code = input_code.to_s.strip.upcase
+    return nil if normalized_code.blank?
+
+    record = active.where("UPPER(code) = ?", normalized_code).first
+    if record
+      where(email_address: record.email_address).delete_all
+      record
+    else
+      nil
+    end
+  end
+
+  def expired?
+    created_at < EXPIRES_IN.ago
+  end
+
+  private
+    def generate_code
+      self.code = self.class.generate_code_string
+    end
+end
