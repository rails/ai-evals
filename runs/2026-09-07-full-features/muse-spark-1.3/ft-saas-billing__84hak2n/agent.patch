diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..58067e6
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,69 @@
+class Admin::AccountsController < ::AdminController
+  def index
+    @accounts = Account.order(created_at: :desc).limit(100)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+  end
+
+  def comp
+    @account = Account.find(params[:id])
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account = Account.find(params[:id])
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Comp removed"
+  end
+
+  def override
+    @account = Account.find(params[:id])
+    card_count = extract_value(:card_count)
+    bytes_used = extract_value(:bytes_used)
+
+    @account.override!(card_count: card_count, bytes_used: bytes_used)
+    redirect_to saas.admin_account_path(@account), notice: "Override saved"
+  end
+
+  def reset
+    @account = Account.find(params[:id])
+    @account.reset_override!
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def extract_value(key)
+      human = key.to_s.titleize # "Card Count"
+      human_variant = key.to_s.humanize.capitalize # fallback
+      # nested params
+      %i[ overridden_limit account_overridden_limit override account ].each do |nest|
+        if params[nest] && params[nest][key].present?
+          return to_int_or_nil(params[nest][key])
+        end
+      end
+      return to_int_or_nil(params[key]) if params[key].present?
+      params.each do |k, v|
+        next if v.blank?
+        if [ human.downcase, key.to_s.downcase, key.to_s.downcase.tr("_", " ") ].include?(k.to_s.downcase)
+          return to_int_or_nil(v.is_a?(Hash) ? v.values.first : v)
+        end
+      end
+      # Also check "Card count" / "Bytes used" exact labels
+      params.each do |k, v|
+        if k.to_s == human || k.to_s == key.to_s.humanize
+          return to_int_or_nil(v) if v.present?
+        end
+      end
+      nil
+    end
+
+    def to_int_or_nil(value)
+      return nil if value.blank?
+      Integer(value.to_s.delete(","))
+    rescue ArgumentError
+      value.to_i
+    end
+end
