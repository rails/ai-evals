diff --git a/app/controllers/account/billings_controller.rb b/app/controllers/account/billings_controller.rb
new file mode 100644
index 0000000..12a40bb
--- /dev/null
+++ b/app/controllers/account/billings_controller.rb
@@ -0,0 +1,38 @@
+class Account::BillingsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    @account = Current.account
+    unless Fizzy.saas?
+      redirect_to account_settings_path and return
+    end
+  end
+
+  def checkout
+    @account = Current.account
+    plan = normalize_plan_param(params[:plan])
+    session = Billing::StripeCheckout.create_checkout_session(account: @account, plan: plan)
+    redirect_to session.url, allow_other_host: true
+  rescue => e
+    Rails.logger.error("[Billing] checkout failed: #{e.class}: #{e.message}")
+    redirect_to account_settings_path, alert: "Could not start checkout. Please try again."
+  end
+
+  def portal
+    @account = Current.account
+    session = Billing::StripeCheckout.create_portal_session(account: @account)
+    redirect_to session.url, allow_other_host: true
+  rescue => e
+    Rails.logger.error("[Billing] portal failed: #{e.class}: #{e.message}")
+    redirect_to account_settings_path, alert: "Could not open billing portal. Please try again."
+  end
+
+  private
+    def normalize_plan_param(given)
+      case given.to_s.downcase
+      when /plus|extra/ then "unlimited_plus"
+      when /unlimited/ then "unlimited"
+      else "unlimited"
+      end
+    end
+end
diff --git a/app/models/billing/stripe_checkout.rb b/app/models/billing/stripe_checkout.rb
new file mode 100644
index 0000000..8cf13d0
--- /dev/null
+++ b/app/models/billing/stripe_checkout.rb
@@ -0,0 +1,65 @@
+module Billing::StripeCheckout
+  class << self
+    def create_checkout_session(account:, plan: "unlimited")
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+
+      price_id = price_id_for(plan)
+      customer_id = account.subscription&.stripe_customer_id
+
+      params = {
+        mode: "subscription",
+        client_reference_id: account.external_account_id.to_s,
+        metadata: { account_id: account.external_account_id.to_s, plan: plan },
+        subscription_data: { metadata: { account_id: account.external_account_id.to_s, plan: plan } },
+        line_items: [ { price: price_id, quantity: 1 } ],
+        success_url: success_url(account),
+        cancel_url: cancel_url(account)
+      }
+      params[:customer] = customer_id if customer_id.present?
+
+      Stripe::Checkout::Session.create(params)
+    end
+
+    def create_portal_session(account:)
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+
+      customer_id = account.subscription&.stripe_customer_id
+      raise "No Stripe customer for account" if customer_id.blank?
+
+      Stripe::BillingPortal::Session.create(
+        customer: customer_id,
+        return_url: return_url(account)
+      )
+    end
+
+    def price_id_for(plan)
+      case plan.to_s
+      when "unlimited_plus"
+        ENV.fetch("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID", "price_unlimited_plus")
+      else
+        ENV.fetch("STRIPE_MONTHLY_V1_PRICE_ID", "price_unlimited")
+      end
+    end
+
+    private
+      def success_url(account)
+        "#{base_url(account)}/account/billing?checkout=success"
+      end
+
+      def cancel_url(account)
+        "#{base_url(account)}/account/settings"
+      end
+
+      def return_url(account)
+        "#{base_url(account)}/account/settings"
+      end
+
+      def base_url(account)
+        host = Rails.application.config.action_controller.default_url_options[:host] rescue "example.com"
+        protocol = Rails.application.config.action_controller.default_url_options[:protocol] rescue "https"
+        "#{protocol}://#{host}#{account.slug}"
+      rescue
+        "https://example.com#{account.slug}"
+      end
+  end
+end
