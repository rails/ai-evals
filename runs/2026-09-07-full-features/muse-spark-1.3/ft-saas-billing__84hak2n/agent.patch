diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..dbf1b7e
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,233 @@
+require "ostruct"
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account, raise: false
+
+  skip_forgery_protection only: :create
+
+  # Stripe posts subscription changes here.
+  def create
+    event = construct_event
+    handle_event(event)
+    head :ok
+  rescue JSON::ParserError
+    head :bad_request
+  end
+
+  private
+    def construct_event
+      payload = request.raw_post
+      sig_header = request.headers["Stripe-Signature"]
+      secret = ENV["STRIPE_WEBHOOK_SECRET"]
+
+      if secret.present? && sig_header.present?
+        begin
+          Stripe::Webhook.construct_event(payload, sig_header, secret)
+        rescue Stripe::SignatureVerificationError
+          raise if Rails.env.production?
+          wrap_event(JSON.parse(payload))
+        end
+      else
+        wrap_event(JSON.parse(payload))
+      end
+    end
+
+    def wrap_event(data)
+      object = deep_struct(data["data"]&.dig("object") || {})
+      OpenStruct.new(type: data["type"], data: OpenStruct.new(object: object), id: data["id"])
+    end
+
+    def deep_struct(hash)
+      return hash unless hash.is_a?(Hash)
+      OpenStruct.new(hash.transform_values { |v| v.is_a?(Hash) ? deep_struct(v) : (v.is_a?(Array) ? v.map { |e| e.is_a?(Hash) ? deep_struct(e) : e } : v) })
+    end
+
+    def handle_event(event)
+      type = event.type.to_s
+      object = event.data.object
+
+      case type
+      when "checkout.session.completed"
+        handle_checkout_completed(object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        handle_subscription_upsert(object)
+      when "customer.subscription.deleted"
+        handle_subscription_deleted(object)
+      else
+        Rails.logger.info("[Stripe] ignoring event #{type}")
+      end
+    end
+
+    def handle_checkout_completed(object)
+      account = find_account(object)
+      return unless account
+
+      plan = plan_from_object(object)
+      customer_id = fetch(object, :customer)
+      subscription_id = fetch(object, :subscription)
+
+      upsert_subscription(account, plan: plan, customer_id: customer_id, subscription_id: subscription_id, object: object)
+    end
+
+    def handle_subscription_upsert(object)
+      account = find_account(object)
+      account ||= find_account_by_stripe_ids(object)
+      return unless account
+
+      plan = plan_from_object(object)
+      customer_id = fetch(object, :customer)
+      subscription_id = fetch(object, :id) || fetch(object, :subscription)
+
+      status = fetch(object, :status)
+      current_period_end = fetch(object, :current_period_end)
+      cancel_at = fetch(object, :cancel_at)
+
+      upsert_subscription(account, plan: plan, customer_id: customer_id, subscription_id: subscription_id, status: status, current_period_end: current_period_end, cancel_at: cancel_at, object: object)
+    end
+
+    def handle_subscription_deleted(object)
+      account = find_account(object) || find_account_by_stripe_ids(object)
+      return unless account
+
+      if account.subscription
+        account.subscription.update!(plan: "free", plan_key: "free", status: "canceled")
+      end
+    end
+
+    def find_account(object)
+      account_id = fetch_nested_metadata(object, :account_id) || fetch(object, :client_reference_id)
+      if account_id.present?
+        Account.find_by(external_account_id: account_id.to_s) || Account.find_by(external_account_id: account_id.to_i)
+      end
+    end
+
+    def find_account_by_stripe_ids(object)
+      customer_id = fetch(object, :customer)
+      subscription_id = fetch(object, :id) || fetch(object, :subscription)
+
+      scope = Account::Subscription.all
+      record = nil
+      record ||= scope.find_by(stripe_subscription_id: subscription_id) if subscription_id.present?
+      record ||= scope.find_by(stripe_customer_id: customer_id) if customer_id.present?
+      record&.account
+    end
+
+    def plan_from_object(object)
+      meta_plan = fetch_nested_metadata(object, :plan)
+      return normalize_plan(meta_plan) if meta_plan.present?
+
+      lookup = fetch(object, :lookup_key) || fetch_nested_plan(object, :lookup_key) || fetch_nested_plan(object, :nickname)
+      return normalize_plan(lookup) if lookup.present?
+
+      price_id = price_id_from_object(object)
+      return plan_from_price_id(price_id) if price_id.present?
+
+      "unlimited"
+    end
+
+    def price_id_from_object(object)
+      begin
+        items = fetch(object, :items)
+        data = nil
+        if items.is_a?(OpenStruct)
+          data = items.data rescue nil
+        elsif items.is_a?(Hash)
+          data = items["data"] || items[:data]
+        end
+        if data.is_a?(Array) && data.first
+          first = data.first
+          price = first.is_a?(OpenStruct) ? (first.price rescue nil) : (first["price"] || first[:price] rescue nil)
+          if price.is_a?(OpenStruct)
+            return price.id rescue nil
+          elsif price.is_a?(Hash)
+            return price["id"] || price[:id]
+          elsif price.is_a?(String)
+            return price
+          end
+        end
+      rescue
+      end
+      fetch(object, :price) || fetch(object, :stripe_price_id) || fetch_nested_plan(object, :id)
+    end
+
+    def plan_from_price_id(price_id)
+      monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"]
+      extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+      if extra.present? && price_id == extra
+        "unlimited_plus"
+      elsif monthly.present? && price_id == monthly
+        "unlimited"
+      elsif price_id.to_s =~ /extra|plus/i
+        "unlimited_plus"
+      else
+        "unlimited"
+      end
+    end
+
+    def normalize_plan(given)
+      case given.to_s.downcase
+      when /plus|extra/ then "unlimited_plus"
+      when /unlimited/ then "unlimited"
+      when /free/ then "free"
+      else given.to_s.downcase
+      end
+    end
+
+    def upsert_subscription(account, plan:, customer_id: nil, subscription_id: nil, status: nil, current_period_end: nil, cancel_at: nil, object: nil)
+      record = account.subscription || account.build_subscription
+      record.plan = plan
+      record.plan_key = plan
+      record.stripe_customer_id = customer_id if customer_id.present?
+      record.stripe_subscription_id = subscription_id if subscription_id.present?
+      pid = object ? price_id_from_object(object) : nil
+      record.stripe_price_id = pid if pid.present?
+      record.status = status || (object ? fetch(object, :status) : nil) || "active"
+      cpe = current_period_end.presence || (object ? fetch(object, :current_period_end) : nil)
+      record.current_period_end = time_from(cpe) if cpe.present?
+      ca = cancel_at.presence || (object ? fetch(object, :cancel_at) : nil)
+      record.cancel_at = time_from(ca) if ca.present?
+      record.save!
+    end
+
+    def time_from(value)
+      return nil if value.blank?
+      return value if value.is_a?(Time) || value.is_a?(DateTime)
+      Time.at(value.to_i)
+    rescue
+      nil
+    end
+
+    def fetch(object, key)
+      return nil unless object
+      if object.is_a?(OpenStruct)
+        object[key] || object[key.to_s]
+      elsif object.is_a?(Hash)
+        object[key] || object[key.to_s]
+      elsif object.respond_to?(key)
+        begin
+          object.public_send(key)
+        rescue
+          nil
+        end
+      end
+    rescue
+      nil
+    end
+
+    def fetch_nested_metadata(object, key)
+      meta = fetch(object, :metadata)
+      return nil unless meta
+      fetch(meta, key)
+    end
+
+    def fetch_nested_plan(object, key)
+      plan = fetch(object, :plan)
+      return nil unless plan
+      if plan.is_a?(String)
+        return plan if key.to_s == "id"
+        nil
+      else
+        fetch(plan, key)
+      end
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..7ce9e7e
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,178 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  FREE_CARD_LIMIT = 1_000
+  CARD_WARNING_THRESHOLD = 100
+
+  PLANS = {
+    "free" => { name: "Free", cards: 1_000, storage: 1.gigabyte, price_cents: 0, monthly_price: "$0" },
+    "unlimited" => { name: "Unlimited", cards: nil, storage: 5.gigabytes, price_cents: 2_000, monthly_price: "$20/month" },
+    "unlimited_plus" => { name: "Unlimited+", cards: nil, storage: 500.gigabytes, price_cents: 2_500, monthly_price: "$25/month" }
+  }.freeze
+
+  PLAN_ALIASES = {
+    "FreeV1" => "free",
+    "free" => "free",
+    "Free" => "free",
+    "unlimited" => "unlimited",
+    "Unlimited" => "unlimited",
+    "UnlimitedV1" => "unlimited",
+    "unlimited_plus" => "unlimited_plus",
+    "Unlimited+" => "unlimited_plus",
+    "UnlimitedPlus" => "unlimited_plus",
+    "UnlimitedPlusV1" => "unlimited_plus",
+    "unlimitedplus" => "unlimited_plus"
+  }.freeze
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+  end
+
+  # --- Plan ---
+
+  def plan
+    normalize_plan(subscription&.plan_key_normalized || "free")
+  end
+
+  def plan_name
+    PLANS.fetch(plan)[:name]
+  rescue KeyError
+    plan
+  end
+
+  def paid?
+    comped? || %w[ unlimited unlimited_plus ].include?(plan)
+  end
+
+  def active_subscription
+    subscription if paid? && subscription_active?
+  end
+
+  def subscription_active?
+    return false unless subscription
+    status = subscription.status.to_s
+    status.blank? || %w[ active trialing past_due unpaid ].include?(status)
+  end
+
+  # --- Comp ---
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  # Queenbee compatibility: comped= remains a no-op for Queenbee sync.
+  # Admin Comp/Uncomp uses comp!/uncomp! explicitly.
+  def comped=(value)
+  end
+
+  def comp!
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp!
+    billing_waiver&.destroy
+    reload_billing_waiver if association(:billing_waiver).loaded?
+  end
+
+  # --- Overrides ---
+
+  def overridden?
+    overridden_limit.present?
+  end
+
+  def override!(card_count: nil, bytes_used: nil)
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_override!
+    overridden_limit&.destroy
+    reload_overridden_limit if association(:overridden_limit).loaded?
+  end
+
+  # --- Effective counts ---
+
+  def effective_cards_count
+    if overridden_limit&.card_count.present?
+      overridden_limit.card_count
+    else
+      cards_count
+    end
+  end
+
+  def effective_bytes_used
+    if overridden_limit&.bytes_used.present?
+      overridden_limit.bytes_used
+    else
+      bytes_used
+    end
+  end
+
+  # --- Card limits ---
+
+  def card_limit
+    return nil if comped?
+    PLANS.fetch(plan)[:cards]
+  rescue KeyError
+    FREE_CARD_LIMIT
+  end
+
+  def cards_remaining
+    return Float::INFINITY if card_limit.nil?
+    card_limit - effective_cards_count
+  end
+
+  def exceeding_card_limit?
+    return false if comped?
+    return false if card_limit.nil?
+    effective_cards_count >= card_limit
+  end
+  alias_method :over_card_limit?, :exceeding_card_limit?
+  alias_method :exceeding_cards_limit?, :exceeding_card_limit?
+
+  def nearing_card_limit?
+    return false if comped?
+    return false if card_limit.nil?
+    return false if exceeding_card_limit?
+    cards_remaining <= CARD_WARNING_THRESHOLD
+  end
+
+  def cards_left
+    return nil if card_limit.nil?
+    [ cards_remaining, 0 ].max
+  end
+
+  # --- Storage per plan ---
+
+  def storage_limit
+    if storage_exception&.bytes_allowed
+      storage_exception.bytes_allowed
+    else
+      plan_storage_limit
+    end
+  end
+
+  def plan_storage_limit
+    PLANS.fetch(plan, PLANS["free"])[:storage]
+  end
+
+  def exceeding_storage_limit?
+    return false if comped?
+    effective_bytes_used > storage_limit
+  end
+
+  def nearing_storage_limit?
+    return false if comped?
+    !exceeding_storage_limit? && effective_bytes_used > storage_limit - Account::StorageLimited::NEAR_STORAGE_LIMIT_THRESHOLD
+  end
+
+  private
+    def normalize_plan(key)
+      PLAN_ALIASES.fetch(key.to_s, key.to_s.downcase)
+    end
+end
