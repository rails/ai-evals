diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..99f46b2 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,81 @@
 module TimeHelper
+  def local_time(time, format: :relative, **options)
+    return if time.nil?
+
+    utc_time = time.utc
+    iso = utc_time.iso8601
+    fallback = local_time_fallback(utc_time, time, format)
+
+    data = {
+      controller: "local-time",
+      local_time_format_value: format.to_s,
+      local_time_datetime_value: iso
+    }
+
+    tag.time fallback, datetime: iso, data: data, **options
+  end
+
+  def local_relative_time(time, **options)
+    local_time(time, format: :relative, **options)
+  end
+
+  def local_comment_time(time, **options)
+    local_time(time, format: :comment, **options)
+  end
+
+  def local_date(time, **options)
+    local_time(time, format: :date, **options)
+  end
+
+  def local_future_time(time, **options)
+    local_time(time, format: :future, **options)
+  end
+
+  private
+    def local_time_fallback(utc_time, original_time, format)
+      case format.to_sym
+      when :time
+        utc_time.strftime("%l:%M %p").strip
+      when :date
+        utc_time.strftime("%b %-d")
+      when :full_date
+        utc_time.strftime("%b %-d, %Y")
+      when :weekday_date, :weekday
+        utc_time.strftime("%A, %B %-d")
+      when :datetime
+        utc_time.strftime("%-m/%-d/%y, %l:%M %p").strip
+      when :comment
+        "#{utc_time.strftime("%A, %B %-d")}, #{utc_time.strftime("%l:%M %p").strip}"
+      when :relative
+        local_time_relative_fallback(original_time)
+      when :future
+        local_time_future_fallback(original_time)
+      else
+        utc_time.strftime("%b %-d")
+      end
+    end
+
+    def local_time_relative_fallback(time)
+      if respond_to?(:time_ago_in_words)
+        if time >= Time.current
+          "in #{time_ago_in_words(time)}"
+        else
+          "#{time_ago_in_words(time)} ago"
+        end
+      else
+        time.utc.strftime("%b %-d")
+      end
+    rescue
+      time.utc.strftime("%b %-d")
+    end
+
+    def local_time_future_fallback(time)
+      if respond_to?(:time_ago_in_words)
+        "in #{time_ago_in_words(time)}"
+      else
+        time.utc.strftime("%b %-d")
+      end
+    rescue
+      time.utc.strftime("%b %-d")
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..ce025ed
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,189 @@
+import { Controller } from "@hotwired/stimulus"
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { format: String, datetime: String }
+
+  #timer = null
+
+  connect() {
+    this.render()
+    // Keep relative words fresh. Refresh every minute.
+    this.#timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    if (this.#timer) clearInterval(this.#timer)
+  }
+
+  datetimeValueChanged() {
+    this.render()
+  }
+
+  formatValueChanged() {
+    this.render()
+  }
+
+  render() {
+    const date = this.#date
+    if (!date) return
+
+    const now = new Date()
+    const text = this.#format(date, now)
+
+    if (text != null && this.element.textContent !== text) {
+      this.element.textContent = text
+    }
+
+    // Helpful tooltip with the full local date/time.
+    if (!this.element.hasAttribute("title")) {
+      this.element.setAttribute("title", formatFull(date))
+    }
+  }
+
+  get #date() {
+    const raw = this.hasDatetimeValue && this.datetimeValue ? this.datetimeValue : this.element.getAttribute("datetime")
+    if (!raw) return null
+    const date = new Date(raw)
+    if (isNaN(date)) return null
+    return date
+  }
+
+  #format(date, now) {
+    switch ((this.formatValue || "relative").toLowerCase()) {
+      case "comment":
+        return formatComment(date, now)
+      case "relative":
+        return formatRelative(date, now)
+      case "future":
+      case "auto_close":
+      case "auto-close":
+        return formatFuture(date, now)
+      case "date":
+        return formatDate(date, now)
+      case "full_date":
+      case "full-date":
+      case "date_with_year":
+        return formatFullDate(date)
+      case "weekday_date":
+      case "weekday-date":
+      case "weekday":
+        return formatWeekdayDate(date)
+      case "time":
+        return formatTime(date)
+      case "datetime":
+        return formatDatetime(date)
+      default:
+        return formatRelative(date, now)
+    }
+  }
+}
+
+export function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", hour12: true }).format(date)
+}
+
+export function formatDate(date, now = new Date()) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date)
+  } else {
+    return formatFullDate(date)
+  }
+}
+
+export function formatFullDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+export function formatFull(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    weekday: "long", month: "long", day: "numeric", year: "numeric",
+    hour: "numeric", minute: "2-digit", hour12: true
+  }).format(date)
+}
+
+export function formatWeekdayDate(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+export function formatDatetime(date) {
+  const datePart = new Intl.DateTimeFormat("en-US", { month: "numeric", day: "numeric", year: "2-digit" }).format(date)
+  return `${datePart}, ${formatTime(date)}`
+}
+
+export function formatRelative(date, now = new Date()) {
+  const diffMs = date - now
+  const absMs = Math.abs(diffMs)
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    const absSeconds = Math.round(absMs / 1000)
+    if (absSeconds < 60) {
+      if (absSeconds < 10) return "just now"
+      return diffMs < 0 ? `${absSeconds} seconds ago` : `in ${absSeconds} seconds`
+    }
+
+    const absMinutes = Math.round(absSeconds / 60)
+    if (absMinutes < 60) {
+      if (absMinutes === 1) return diffMs < 0 ? "1 minute ago" : "in 1 minute"
+      return diffMs < 0 ? `${absMinutes} minutes ago` : `in ${absMinutes} minutes`
+    }
+
+    const absHours = Math.round(absMinutes / 60)
+    if (absHours === 1) return diffMs < 0 ? "1 hour ago" : "in 1 hour"
+    return diffMs < 0 ? `${absHours} hours ago` : `in ${absHours} hours`
+  }
+
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < -1) {
+    const ago = -days
+    if (ago < 30) return `${ago} days ago`
+    return formatMonthsOrYearsAgo(ago, diffMs)
+  }
+  if (days > 1) {
+    if (days < 30) return `in ${days} days`
+    return formatMonthsOrYearsFuture(days)
+  }
+}
+
+function formatMonthsOrYearsAgo(daysAgo, diffMs) {
+  if (daysAgo < 365) {
+    const months = Math.round(daysAgo / 30)
+    if (months <= 1) return "about 1 month ago"
+    return `about ${months} months ago`
+  } else {
+    const years = Math.round(daysAgo / 365)
+    if (years <= 1) return "about 1 year ago"
+    return `about ${years} years ago`
+  }
+}
+
+function formatMonthsOrYearsFuture(days) {
+  if (days < 365) {
+    const months = Math.round(days / 30)
+    if (months <= 1) return "in about 1 month"
+    return `in about ${months} months`
+  } else {
+    const years = Math.round(days / 365)
+    if (years <= 1) return "in about 1 year"
+    return `in about ${years} years`
+  }
+}
+
+export function formatComment(date, now = new Date()) {
+  const daysAgo = signedDifferenceInDays(date, now)
+
+  if (daysAgo === 0) return formatTime(date)
+  if (daysAgo === 1) return "yesterday"
+  if (daysAgo >= 2 && daysAgo <= 6) return `${daysAgo} days ago`
+  return formatDate(date, now)
+}
+
+export function formatFuture(date, now = new Date()) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days <= 0) return "today"
+  if (days === 1) return "tomorrow"
+  return `in ${days} days`
+}
