diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..df73b9c
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,48 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    if consecutive_failures_count.to_i != 0 || first_failure_at.present?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def record_failure
+    now = Time.current
+
+    if stale_window?(now)
+      update! consecutive_failures_count: 1, first_failure_at: now
+    else
+      update! consecutive_failures_count: consecutive_failures_count.to_i + 1, first_failure_at: first_failure_at || now
+    end
+
+    if should_deactivate?
+      webhook.deactivate
+    end
+  end
+
+  def should_deactivate?
+    if consecutive_failures_count.to_i >= FAILURE_THRESHOLD && first_failure_at.present?
+      true
+    else
+      false
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    def stale_window?(now)
+      if first_failure_at.present? && updated_at.present?
+        first_failure_at < FAILURE_WINDOW.ago(now) && updated_at < FAILURE_WINDOW.ago(now)
+      else
+        false
+      end
+    end
+end
