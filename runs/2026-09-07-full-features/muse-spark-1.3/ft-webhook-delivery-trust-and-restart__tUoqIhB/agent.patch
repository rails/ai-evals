   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where(created_at: ...RETENTION_PERIOD.ago) }
+
+  validates :event_id, uniqueness: { scope: :webhook_id }
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    with_lock do
+      if completed? || errored?
+        false
+      else
+        perform_delivery
+        true
+      end
+    end
+  rescue ActiveRecord::RecordNotFound
+    false
+  end
+
+  def perform_delivery
+    update! state: :in_progress
+
+    payload = build_payload
+    body = JSON.generate(payload)
+    headers = build_headers(body)
+
+    store_request(headers, body)
+
+    begin
+      code, response_headers, response_body = post_webhook(headers, body)
+      store_response(code: code, headers: response_headers, body: response_body, error: nil)
+      update! state: :completed
+
+      if succeeded?
+        webhook.record_delivery_success
+      else
+        webhook.record_delivery_failure
+      end
+    rescue StandardError => error
+      store_response(code: nil, headers: {}, body: nil, error: error_class_for(error))
+      update! state: :errored
+      webhook.record_delivery_failure
+    end
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +84,90 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def build_payload
+      {
+        "event" => {
+          "id" => event.id,
+          "action" => event.action.to_s,
+          "created_at" => event.created_at.utc.iso8601(3),
+          "creator" => {
+            "id" => event.creator_id,
+            "name" => event.creator.name
+          },
+          "eventable" => {
+            "type" => event.eventable_type,
+            "id" => event.eventable_id,
+            "url" => eventable_url
+          },
+          "particulars" => event.api_particulars
+        },
+        "board" => {
+          "id" => event.board_id,
+          "name" => event.board.name
+        },
+        "webhook" => {
+          "id" => webhook.id,
+          "name" => webhook.name
+        }
+      }
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, host: host_for_url)
+    rescue StandardError
+      nil
+    end
+
+    def host_for_url
+      ENV.fetch("WEBHOOK_URL_HOST", "example.com")
+    end
+
+    def build_headers(body)
+      {
+        "Content-Type" => "application/json",
+        "User-Agent" => "fizzy/1.0.0 Webhook",
+        "X-Webhook-Signature" => signature_for(body),
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def signature_for(body)
+      OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+    end
+
+    def store_request(headers, body)
+      update! request: { "headers" => headers, "body" => body, "url" => webhook.url, "method" => "POST" }
+    end
+
+    def store_response(code:, headers:, body:, error:)
+      update! response: { "code" => code, "headers" => headers, "body" => truncated_body(body), "error" => error }
+    end
+
+    def truncated_body(body)
+      if body.is_a?(String) && body.bytesize > 10_000
+        body.byteslice(0, 10_000)
+      else
+        body
+      end
+    end
+
+    def post_webhook(headers, body)
+      uri = URI.parse(webhook.url)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = REQUEST_TIMEOUT
+      http.read_timeout = REQUEST_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      response = http.request(request)
+      [ response.code.to_i, response.to_hash, response.body ]
+    end
+
+    def error_class_for(error)
+      error.class.name.demodulize.underscore
+    end
 end
