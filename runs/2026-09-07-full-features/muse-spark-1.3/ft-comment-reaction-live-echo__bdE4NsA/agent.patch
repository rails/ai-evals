@@ -0,0 +1,30 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }, optional: true
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  has_one :card, through: :comment
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  normalizes :content, with: ->(content) { content.to_s.strip }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(creator: [ :avatar_attachment, :account ]) }
+
+  delegate :board, to: :comment, allow_nil: true
+
+  after_create_commit { broadcast_reaction_change }
+  after_destroy_commit { broadcast_reaction_change }
+
+  def to_partial_path
+    "cards/reactions/reaction"
+  end
+
+  private
+    def broadcast_reaction_change
+      if card = comment&.card
+        broadcast_replace_to card, target: ActionView::RecordIdentifier.dom_id(comment, :reactions), partial: "cards/reactions/reactions", locals: { comment: comment.reload }
+      end
+    end
+end
