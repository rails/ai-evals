@@ -0,0 +1,71 @@
+class Cards::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content body text emoji ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+
+  def index
+    @reactions = @comment.reactions.chronologically.preloaded
+
+    respond_to do |format|
+      format.json { render :index }
+    end
+  end
+
+  def new
+    @reaction = @comment.reactions.build
+
+    respond_to do |format|
+      format.html { render partial: "cards/reactions/form", locals: { comment: @comment, reaction: @reaction } }
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(creator: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def show
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def destroy
+    if @reaction.creator != Current.user
+      head :forbidden
+    else
+      @reaction.destroy!
+
+      respond_to do |format|
+        format.turbo_stream
+        format.json { head :no_content }
+      end
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      raw = if params[:reaction].present?
+        params.expect(reaction: [ :content, :body, :text, :emoji ])
+      else
+        params.permit(:content, :body, :text, :emoji).to_h
+      end
+      content = raw["content"] || raw[:content] || raw["body"] || raw[:body] || raw["text"] || raw[:text] || raw["emoji"] || raw[:emoji]
+      { content: content }
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..4d55544
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,50 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "menuButton", "popup" ]
+
+  showForm(event) {
+    if (event) event.stopPropagation()
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = true
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = false
+      this.formTarget.classList.add("expanded")
+      if (this.hasInputTarget) this.inputTarget.focus()
+    }
+    if (this.hasMenuButtonTarget) this.menuButtonTarget.hidden = false
+  }
+
+  hideForm(event) {
+    if (event) event.stopPropagation()
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("expanded")
+      this.formTarget.reset()
+    }
+    if (this.hasTriggerTarget) {
+      this.triggerTarget.hidden = false
+      this.triggerTarget.focus()
+    }
+    if (this.hasMenuButtonTarget) this.menuButtonTarget.hidden = true
+  }
+
+  toggleDelete(event) {
+    // Don't toggle when clicking the delete button/form itself
+    if (event.target.closest(".reaction__delete, form")) return
+    const reaction = event.currentTarget
+    reaction.classList.toggle("expanded")
+  }
+
+  pickEmoji(event) {
+    const emoji = event.currentTarget.dataset.emoji
+    if (this.hasInputTarget && emoji) {
+      this.showForm()
+      this.inputTarget.value = emoji
+      this.inputTarget.focus()
+    }
+  }
+
+  stop(event) {
+    event.stopPropagation()
+  }
+}
