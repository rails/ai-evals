diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..e048a23 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,66 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    if incineration_due?
+      account_id = id
+      destroy!
+      purge_residual_account_data(account_id)
+      self
+    end
+  end
+
+  def incineration_due?
+    if cancelled?
+      cancellation.created_at < INCINERATION_GRACE_PERIOD.ago
+    else
+      false
+    end
+  end
+
+  private
+    # Some account-scoped tables have no `dependent: :destroy` cascade from
+    # Account (e.g. events, storage entries). After destroying the account,
+    # remove any rows still referencing it so no data is kept forever.
+    #
+    # Active Storage tables are excluded: their rows are removed by the
+    # `dependent: :purge_later` cascades (purge jobs run asynchronously).
+    # Deleting blob rows here would orphan files before those jobs run.
+    def purge_residual_account_data(account_id)
+      connection = self.class.connection
+      quoted_id = connection.quote(account_id)
+
+      skipped_tables = %w[
+        active_storage_attachments
+        active_storage_blobs
+        active_storage_variant_records
+      ]
+
+      connection.tables.each do |table|
+        next if skipped_tables.include?(table)
+        next unless connection.column_exists?(table, :account_id)
+
+        connection.execute("DELETE FROM #{connection.quote_table_name(table)} WHERE #{connection.quote_column_name("account_id")} = #{quoted_id}")
+      rescue StandardError => e
+        Rails.error.report(e, context: { table: table, account_id: account_id })
+      end
+
+      if connection.adapter_name == "SQLite"
+        connection.execute("DELETE FROM search_records_fts WHERE rowid NOT IN (SELECT id FROM search_records)")
+      end
+    rescue StandardError => e
+      Rails.error.report(e, context: { account_id: account_id })
+    end
 end
