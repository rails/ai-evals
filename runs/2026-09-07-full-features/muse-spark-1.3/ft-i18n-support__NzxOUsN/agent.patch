diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..a3b6579
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,70 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    after_action :translate_response_to_japanese, if: -> { I18n.locale == :ja }
+    etag { I18n.locale.to_s }
+  end
+
+  private
+    def set_locale
+      available = I18n.available_locales.map(&:to_s)
+      requested = params[:locale]&.to_s
+
+      if requested.present?
+        if available.include?(requested)
+          I18n.locale = requested
+          session[:locale] = requested
+          persist_locale_to_identity(requested)
+        else
+          set_locale_from_session_or_identity
+        end
+      else
+        set_locale_from_session_or_identity
+      end
+    end
+
+    def set_locale_from_session_or_identity
+      available = I18n.available_locales.map(&:to_s)
+      stored = session[:locale].presence || Current.identity&.locale.presence
+
+      if stored.present? && available.include?(stored.to_s)
+        I18n.locale = stored.to_sym
+        # Keep session in sync so rest of session sticks even when restored from identity
+        session[:locale] ||= stored.to_s
+        # Keep identity in sync when session provided the locale
+        sync_identity_locale_from_session
+      else
+        I18n.locale = I18n.default_locale
+      end
+    end
+
+    def persist_locale_to_identity(locale)
+      return unless Current.identity
+      return if Current.identity.locale == locale.to_s
+
+      Current.identity.update_column(:locale, locale.to_s)
+      # reload to keep in-memory consistent without callbacks
+      Current.identity.locale = locale.to_s
+    rescue StandardError
+      nil
+    end
+
+    def sync_identity_locale_from_session
+      return unless Current.identity && session[:locale].present?
+      return if Current.identity.locale == session[:locale].to_s
+
+      Current.identity.update_column(:locale, session[:locale].to_s)
+      Current.identity.locale = session[:locale].to_s
+    rescue StandardError
+      nil
+    end
+
+    def translate_response_to_japanese
+      return unless response.media_type == "text/html" || response.content_type&.include?("text/html")
+      return if response.body.blank?
+
+      response.body = JapaneseTranslation.translate_html(response.body)
+    end
+end
