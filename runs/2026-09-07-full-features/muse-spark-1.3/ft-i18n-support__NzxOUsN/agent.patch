diff --git a/app/jobs/concerns/locale_tenanted.rb b/app/jobs/concerns/locale_tenanted.rb
new file mode 100644
index 0000000..3400092
--- /dev/null
+++ b/app/jobs/concerns/locale_tenanted.rb
@@ -0,0 +1,35 @@
+# Serializes the current I18n.locale into job data so jobs (including
+# mail delivery) run with the locale that was active at enqueue time.
+# Mailers additionally prefer the recipient's stored locale (see ApplicationMailer).
+module LocaleTenanted
+  extend ActiveSupport::Concern
+
+  prepended do
+    attr_reader :locale_at_enqueue
+    around_perform :with_locale_context
+  end
+
+  def initialize(...)
+    super
+    @locale_at_enqueue = I18n.locale.to_s
+  end
+
+  def serialize
+    super.merge({ "locale" => @locale_at_enqueue })
+  end
+
+  def deserialize(job_data)
+    super
+    @locale_at_enqueue = job_data["locale"]
+  end
+
+  private
+    def with_locale_context(&block)
+      available = I18n.available_locales.map(&:to_s)
+      if @locale_at_enqueue.present? && available.include?(@locale_at_enqueue.to_s)
+        I18n.with_locale(@locale_at_enqueue.to_sym, &block)
+      else
+        yield
+      end
+    end
+end
diff --git a/app/mailers/application_mailer.rb b/app/mailers/application_mailer.rb
index 9f0d723..c2c9a50 100644
--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -5,7 +5,73 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  after_action :translate_mail_to_japanese, if: -> { I18n.locale == :ja }
+
+  # Override mail to set locale from recipient BEFORE rendering,
+  # since before_action runs before mailer ivars are set.
+  def mail(headers = {}, &block)
+    set_locale_from_recipient
+    super
+  end
+
   private
+    def set_locale_from_recipient
+      available = I18n.available_locales.map(&:to_s)
+      recipient_locale = detect_recipient_locale
+      if recipient_locale.present? && available.include?(recipient_locale.to_s)
+        I18n.locale = recipient_locale.to_sym
+      end
+      # otherwise keep I18n.locale from job/request (LocaleTenanted restored it)
+    end
+
+    def detect_recipient_locale
+      identity =
+        (@identity if defined?(@identity) && @identity) ||
+        (@user&.identity if defined?(@user) && @user) ||
+        (@import&.identity if defined?(@import) && @import) ||
+        (@export&.user&.identity if defined?(@export) && @export) ||
+        (@bundle&.user&.identity if defined?(@bundle) && @bundle) ||
+        (@magic_link&.identity if defined?(@magic_link) && @magic_link) ||
+        (@account && nil)
+      if identity.nil? && self.class.name == "ImportMailer"
+        identity = @identity_for_locale if defined?(@identity_for_locale) && @identity_for_locale
+        identity ||= @identity if defined?(@identity) && @identity
+      end
+      if identity
+        begin
+          fresh = Identity.find_by(id: identity.id)
+          return fresh.locale if fresh&.locale.present?
+          return identity.locale if identity.respond_to?(:locale) && identity.locale.present?
+        rescue StandardError
+          return identity.locale if identity.respond_to?(:locale)
+        end
+      end
+      nil
+    end
+
+    def translate_mail_to_japanese
+      if mail.subject.present?
+        mail.subject = JapaneseTranslation.translate_subject(mail.subject)
+      end
+      if mail.multipart?
+        mail.parts.each do |part|
+          translate_mail_part(part)
+        end
+      else
+        translate_mail_part(mail)
+      end
+    end
+
+    def translate_mail_part(part)
+      content_type = part.content_type.to_s
+      body_str = part.body.to_s
+      return if body_str.empty?
+      translated = JapaneseTranslation.translate_email_body(body_str, content_type)
+      part.body = translated
+    rescue StandardError
+      nil
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
