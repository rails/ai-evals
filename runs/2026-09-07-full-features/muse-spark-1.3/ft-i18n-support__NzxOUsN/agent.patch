+    "Unsubscribe from all email notifications:" => "すべてのメール通知の解除：",
+    "Fizzy emails you about new notifications every few hours." => "Fizzyは数時間ごとに新しい通知をメールします。",
+    "in " => "（",
+    "Card " => "カード",
+    "RE: " => "返信：",
+    "Fizzy: New notifications" => "Fizzy：新しい通知",
+    "New notifications" => "新しい通知",
+  }
+  EXTRA_PHRASES_5 = {
+  "Home" => "ホーム",
+  "Board…" => "ボード…",
+  "Person…" => "人…",
+  "Nothing matches that filter" => "フィルターに一致するものはありません",
+  "Activity in" => "アクティビティ（対象：",
+  "Activity across" => "すべてのアクティビティ",
+  "Activity" => "アクティビティ",
+  "across" => "全体",
+  "everyone" => "全員",
+  "Recently updated" => "最近更新された順",
+  "Assigned to me" => "自分に割り当て",
+  "Added by me" => "自分が追加",
+}
+EXTRA_PHRASES_6 = {
+  "Which cards are assigned to me?" => "自分に割り当てられたカードは？",
+  "Which cards were added by me?" => "自分が追加したカードは？",
+  "Push notifications are" => "プッシュ通知は",
+  "Moves to \u201CNot Now\u201D" => "\u201C後で\u201Dへ移動",
+  "if there\u2019s no activity." => "アクティビティがない場合。",
+  "Undo" => "元に戻す",
+  "Unverified" => "未確認",
+  "is no longer on this account" => "はこのアカウントに属していません",
+  "personal access tokens" => "個人アクセストークン",
+  "Updated" => "更新",
+  "Not assigned" => "未割り当て",
+  "By" => "作成者",
+  "Generate a personal access token" => "個人アクセストークンを生成",
+  "New personal access token" => "新しい個人アクセストークン",
+  "Generate a new access token" => "新しいアクセストークンを生成",
+}
+  REGEX_PATTERNS = [
+    [ /\A\s*by\s*\z/, '作成者' ],
+    [ /Card already has the maximum of (\d+) assignees/, 'カードの担当者は最大\1人までです' ],
+    [ /width must be less than (\d+)px/, '幅は\1px未満にしてください' ],
+    [ /height must be less than (\d+)px/, '高さは\1px未満にしてください' ],
+    [ /Bundle window overlaps with an existing pending bundle with id (.+)/, '保留中のバンドル（ID：\1）と期間が重なっています' ],
+    [ /must use (.+)/, '次を使用してください：\1' ],
+    [ /\A\s*and\s*\z/, 'および' ],
+    [ /\A\s*By\s*\z/, '作成者' ],
+    [ /By (.+)/, '作成者：\1' ],
+    [ /(\d+) persons?/, '\1人' ],
+    [ /(\d+) people/, '\1人' ],
+    [ /Which cards are assigned to (.+)\?/, '「\1」に割り当てられたカードは？' ],
+    [ /Which cards were added by (.+)\?/, '「\1」が追加したカードは？' ],
+    [ /Completed by (.+) on/, '完了者：\1（' ],
+    [ /Moves to \u201CNot Now\u201D/, '\u201C後で\u201Dへ移動' ],
+    [ /Assigned to (.+)/, '割り当て先：\1' ],
+    [ /Unassigned by (.+)/, '割り当て解除者：\1' ],
+    [ /Added by (.+)/, '追加者：\1' ],
+    [ /Moved to Done by (.+)/, '完了への移動者：\1' ],
+    [ /Reopened by (.+)/, '再開者：\1' ],
+    [ /Moved to Not Now by (.+)/, '後でへの移動者：\1' ],
+    [ /Renamed by (.+)/, '名前変更者：\1' ],
+    [ /Moved by (.+)/, '移動者：\1' ],
+    [ /Moved to (.+) by (.+)/, '移動先：\1（実施者：\2）' ],
+    [ /Moved back to Maybe\? by (.+)/, 'たぶん？への移動者：\1' ],
+    [ /(\d+) open cards, (\d+) in MAYBE\?/, '\1件のオープンカード、\2件がたぶん？' ],
+    [ /You have (\d+) new notifications?/, 'あなたには\1件の新しい通知があります' ],
+    [ /You have (\d+) new notification/, 'あなたには\1件の新しい通知があります' ],
+    [ /Notifications since (.+)/, '次の日時以降の通知：\1' ],
+    [ /Your Fizzy code is (\S+)/, 'Fizzyコードは\1です' ],
+    [ /Show (\d+) more watchers/, '\1人のウォッチャーをさらに表示' ],
+    [ /Back to (.+)/, '\1に戻る' ],
+    [ /Go to (.+)/, '\1へ移動' ],
+    [ /Profile avatar for (.+)/, 'プロフィール画像：\1' ],
+    [ /Role: (.+)/, '役割：\1' ],
+    [ /Completed by (.+)/, '完了者：\1' ],
+    [ /(\d+) days ago/, '\1日前' ],
+    [ /(\d+) day ago/, '\1日前' ],
+    [ /(\d+) hours? ago/, '\1時間前' ],
+    [ /(\d+) minutes? ago/, '\1分前' ],
+    [ /(\d+) weeks? ago/, '\1週間前' ],
+    [ /(\d+) months? ago/, '\1ヶ月前' ],
+    [ /(\d+) years? ago/, '\1年前' ],
+    [ /(\d+) days/, '\1日' ],
+    [ /in (\d+) days?/, '\1日後' ],
+  ]
+
+  class << self
+    def translate_html(html)
+      return html if html.blank?
+      # Split out script/style to avoid translating code
+      parts = html.split(/(<script.*?<\/script>|<style.*?<\/style>)/mi)
+      parts.map! do |part|
+        if part =~ /\A<(script|style)/i
+          part
+        else
+          translate_html_part(part)
+        end
+      end
+      parts.join
+    end
+
+    def translate_html_part(html)
+      # 1) readable attributes (double-quoted)
+      html = html.gsub(/(aria-label|aria-description|placeholder|title|alt|value|data-text|data-validation-message|validation-message|bridge_title|bridge-title|bridge_description|bridge-description|data-bridge[^\s=]*|data-turbo-navigation[^\s=]*|data-turbo-confirm|data-boards-form[^\s=]*|data-[a-z0-9-]+-message-value|data-[a-z0-9-]+-prompt-message-value|data-multi-selection-combobox[^\s=]*|data-filter[^\s=]*)\s*=\s*"([^"]*)"/) do
+        attr = Regexp.last_match(1)
+        val = Regexp.last_match(2)
+        # Skip tokens that are clearly code (URLs, tokens with no spaces and long)
+        if val.length > 25 && !val.include?(" ") && !val.include?("、")
+          %Q(#{attr}="#{val}")
+        else
+          %Q(#{attr}="#{translate_text(val)}")
+        end
+      end
+      # single-quoted variants
+      html = html.gsub(/(aria-label|aria-description|placeholder|title|alt|value|data-text|data-validation-message)\s*=\s*'([^']*)'/) do
+        attr = Regexp.last_match(1)
+        val = Regexp.last_match(2)
+        %(#{attr}='#{translate_text(val)}')
+      end
+      # 2) text nodes
+      html.gsub(/>([^<>]+)</) do
+        inner = Regexp.last_match(1)
+        if inner.strip.empty?
+          ">#{inner}<"
+        else
+          ">#{translate_text(inner)}<"
+        end
+      end
+    end
+
+    def translate_text(text)
+      return text if text.nil? || text.empty?
+      # Normalize curly apostrophes to straight for matching (views mix both)
+      result = text.dup.gsub(/[\u2019\u2018]/, "'")
+      REGEX_PATTERNS.each do |regex, replacement|
+        begin
+          result.gsub!(regex, replacement)
+        rescue StandardError
+          nil
+        end
+      end
+      sorted_phrases.each do |en, ja|
+        next if en.empty?
+        # Avoid replacing inside longer words unintentionally? For UI phrases, direct gsub is fine.
+        if result.include?(en)
+          result.gsub!(en, ja)
+        end
+      end
+      result
+    end
+
+    def translate_subject(subject)
+      return subject if subject.nil?
+      translate_text(subject.to_s)
+    end
+
+    def translate_email_body(body, content_type = nil)
+      return body if body.nil? || body.to_s.empty?
+      str = body.to_s
+      if content_type.to_s.include?("html")
+        translate_html(str)
+      else
+        translate_text(str)
+      end
+    end
+
+    def sorted_phrases
+      @sorted_phrases ||= begin
+        combined = PHRASE_MAP.merge(EXTRA_PHRASES_1).merge(EXTRA_PHRASES_2).merge(EXTRA_PHRASES_3).merge(EXTRA_PHRASES_4).merge(EXTRA_PHRASES_5).merge(EXTRA_PHRASES_6).transform_keys { |k| k.gsub(/[\u2019\u2018]/, "'") }
+        # Longest first so longer sentences win
+        combined.sort_by { |en, _| -en.length }
+      end
+    end
+  end
+end
