diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..b3e2be0
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,55 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @subscription.assign_attributes(subscription_params.merge(user_agent: request.user_agent))
+    @subscription.save!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications turned on for this device" }
+      format.json { head :created }
+    end
+  end
+
+  def destroy
+    @subscription = find_subscription
+    if @subscription
+      @subscription.destroy
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications turned off for this device" }
+        format.json { head :no_content }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: "Subscription not found" }
+        format.json { head :not_found }
+      end
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def find_subscription
+      if params[:endpoint].present?
+        @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+      elsif params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id]) ||
+          @user.push_subscriptions.find_by(endpoint: CGI.unescape(params[:id].to_s))
+      end
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..66665aa
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,125 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = {
+    vapidPublicKey: String,
+    subscriptionsUrl: String
+  }
+  static targets = [ "details" ]
+
+  connect() {
+    this.update()
+    // Re-check when page becomes visible (permission may have changed in settings)
+    this._onVisibility = () => { if (!document.hidden) this.update() }
+    document.addEventListener("visibilitychange", this._onVisibility)
+    if (navigator.permissions?.query) {
+      navigator.permissions.query({ name: "notifications" }).then((status) => {
+        status.onchange = () => this.update()
+      }).catch(() => {})
+    }
+  }
+
+  disconnect() {
+    document.removeEventListener("visibilitychange", this._onVisibility)
+  }
+
+  async update() {
+    const supported = this.isSupported
+    const subscription = supported ? await this.getSubscription().catch(() => null) : null
+    const permission = ("Notification" in window) ? Notification.permission : "denied"
+
+    const on = !!(subscription && permission === "granted")
+    this.element.classList.toggle("notifications--on", on)
+
+    // Show help details when blocked
+    const blocked = supported && permission === "denied"
+    for (const el of this.detailsTargets) {
+      el.hidden = !blocked
+    }
+  }
+
+  async subscribe(event) {
+    if (event) event.preventDefault()
+    if (!this.isSupported) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.update()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.applicationServerKey
+      })
+    }
+
+    await this.saveSubscription(subscription)
+    this.update()
+  }
+
+  async unsubscribe(event) {
+    if (event) event.preventDefault()
+    const subscription = await this.getSubscription().catch(() => null)
+    if (subscription) {
+      // Try to remove server-side by endpoint first
+      await this.deleteSubscription(subscription).catch(() => {})
+      await subscription.unsubscribe().catch(() => {})
+    }
+    this.update()
+  }
+
+  get isSupported() {
+    return ("Notification" in window) && ("serviceWorker" in navigator) && ("PushManager" in window)
+  }
+
+  get applicationServerKey() {
+    return urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  async getSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async saveSubscription(subscription) {
+    const json = subscription.toJSON()
+    const body = new FormData()
+    body.append("push_subscription[endpoint]", json.endpoint)
+    body.append("push_subscription[p256dh_key]", json.keys.p256dh)
+    body.append("push_subscription[auth_key]", json.keys.auth)
+
+    const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content")
+    await fetch(this.subscriptionsUrlValue, {
+      method: "POST",
+      headers: token ? { "X-CSRF-Token": token, "Accept": "application/json" } : { "Accept": "application/json" },
+      body,
+      credentials: "same-origin"
+    })
+  }
+
+  async deleteSubscription(subscription) {
+    const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content")
+    const endpoint = encodeURIComponent(subscription.endpoint)
+    const url = `${this.subscriptionsUrlValue}/0?endpoint=${endpoint}`
+    await fetch(url, {
+      method: "DELETE",
+      headers: token ? { "X-CSRF-Token": token, "Accept": "application/json" } : { "Accept": "application/json" },
+      credentials: "same-origin"
+    }).catch(() => {})
+  }
+}
+
+function urlBase64ToUint8Array(base64String) {
+  const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+  const rawData = atob(base64)
+  const outputArray = new Uint8Array(rawData.length)
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i)
+  }
+  return outputArray
+}
