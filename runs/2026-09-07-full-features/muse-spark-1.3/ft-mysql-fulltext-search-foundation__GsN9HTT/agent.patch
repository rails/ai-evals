diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..391ee8b
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,24 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search_by_content(query, user:, account:)
+      terms = query.to_s.strip.split
+      if terms.any?
+        relation = user.accessible_cards.published.where(cards: { account_id: account.id })
+        relation = relation.joins("LEFT JOIN action_text_rich_texts AS card_descriptions ON card_descriptions.record_type = 'Card' AND card_descriptions.name = 'description' AND card_descriptions.record_id = cards.id")
+          .joins("LEFT JOIN comments AS search_comments ON search_comments.card_id = cards.id")
+          .joins("LEFT JOIN action_text_rich_texts AS comment_bodies ON comment_bodies.record_type = 'Comment' AND comment_bodies.name = 'body' AND comment_bodies.record_id = search_comments.id")
+
+        terms.each do |term|
+          pattern = "%#{sanitize_sql_like(term)}%"
+          relation = relation.where("cards.title LIKE :pattern ESCAPE '\\' OR card_descriptions.body LIKE :pattern ESCAPE '\\' OR comment_bodies.body LIKE :pattern ESCAPE '\\'", pattern: pattern)
+        end
+
+        relation.distinct.reverse_chronologically.preload(:board, :rich_text_description, comments: :rich_text_body)
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..77298fd
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="panel borderless center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: @query.blank?, class: "input full-width", autocomplete: "off" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="cards cards--list">
+        <% @cards.each do |card| %>
+          <article class="card search-result" id="<%= dom_id(card) %>">
+            <h2 class="card__title">
+              <%= link_to highlight_search_terms(card.title.to_s, @query), card_path(card) %>
+            </h2>
+            <p class="txt-small translucent"><%= card.board.name %> #<%= card.number %></p>
+            <% if card.description.to_plain_text.to_s.present? %>
+              <div class="card__description">
+                <%= highlight_search_terms(card.description.to_plain_text.to_s.truncate(1000), @query) %>
+              </div>
+            <% end %>
+            <% search_matching_comments(card, @query).each do |comment| %>
+              <blockquote class="search-result__comment">
+                <%= highlight_search_terms(comment.body.to_plain_text.to_s.truncate(1000), @query) %>
+              </blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% else %>
+      <p>No cards match this search</p>
+    <% end %>
+  <% end %>
+</section>
