@@ -0,0 +1,20 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search_cards
+
+    respond_to do |format|
+      format.html
+      format.json { render json: @cards.map { |card| { number: card.number, title: card.title, board: card.board.name } } }
+    end
+  end
+
+  private
+    def search_cards
+      if @query.present?
+        Card.search_by_content(@query, user: Current.user, account: Current.account)
+      else
+        Card.none
+      end
+    end
+end
