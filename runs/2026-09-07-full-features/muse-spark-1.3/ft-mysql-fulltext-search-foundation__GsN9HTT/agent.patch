@@ -0,0 +1,28 @@
+module SearchesHelper
+  def highlight_search_terms(text, query)
+    text = text.to_s
+    if query.blank? || text.blank?
+      ERB::Util.html_escape(text)
+    else
+      escaped = ERB::Util.html_escape(text)
+      query.split.uniq.sort_by { |term| -term.length }.each do |term|
+        next if term.blank?
+        pattern = Regexp.new(Regexp.escape(term), Regexp::IGNORECASE)
+        escaped = escaped.gsub(pattern) { |match| "<mark>#{match}</mark>" }.html_safe
+      end
+      escaped
+    end
+  end
+
+  def search_matching_comments(card, query)
+    terms = query.to_s.split
+    if terms.any?
+      card.comments.select do |comment|
+        body = comment.body&.to_plain_text.to_s
+        body.present? && terms.any? { |term| body.downcase.include?(term.downcase) }
+      end
+    else
+      []
+    end
+  end
+end
