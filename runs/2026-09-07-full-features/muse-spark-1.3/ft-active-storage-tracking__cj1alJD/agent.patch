+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_account, prepend: true
+    after_destroy_commit :recalculate_account_after_destroy
+  end
+
+  def bytes_used
+    if persisted?
+      self.class.where(id: id).pick(:bytes_used) || self[:bytes_used] || 0
+    else
+      self[:bytes_used] || 0
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Board::BytesUsedRecalculationJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used
+    with_lock do
+      update_columns(bytes_used: calculate_bytes_used)
+    end
+  end
+
+  private
+    def calculate_bytes_used
+      card_image_bytes_used + board_embeds_bytes_used + card_embeds_bytes_used + comment_embeds_bytes_used
+    end
+
+    def card_image_bytes_used
+      card_ids = Card.where(board_id: id).select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: card_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def board_embeds_bytes_used
+      rich_text_ids = ActionText::RichText.where(record_type: "Board", record_id: id, name: "public_description").select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def card_embeds_bytes_used
+      card_ids = Card.where(board_id: id).select(:id)
+      rich_text_ids = ActionText::RichText.where(record_type: "Card", name: "description", record_id: card_ids).select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comment_embeds_bytes_used
+      card_ids = Card.where(board_id: id).select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+      rich_text_ids = ActionText::RichText.where(record_type: "Comment", name: "body", record_id: comment_ids).select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def remember_storage_account
+      @storage_account_id = account_id
+    end
+
+    def recalculate_account_after_destroy
+      if @storage_account_id.present?
+        Account.find_by(id: @storage_account_id)&.recalculate_bytes_used_later
+      end
+    end
+end
