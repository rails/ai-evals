+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,45 @@
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    if persisted?
+      self.class.where(id: id).pick(:bytes_used) || self[:bytes_used] || 0
+    else
+      self[:bytes_used] || 0
+    end
+  end
+
+  def recalculate_bytes_used_later
+    Account::BytesUsedRecalculationJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used
+    with_lock do
+      update_columns(bytes_used: calculate_bytes_used)
+    end
+  end
+
+  private
+    def calculate_bytes_used
+      card_image_bytes_used + embeds_bytes_used
+    end
+
+    def card_image_bytes_used
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(account_id: id, record_type: "Card", name: "image")
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def embeds_bytes_used
+      rich_text_ids = ActionText::RichText
+        .where(account_id: id)
+        .where("(action_text_rich_texts.record_type = 'Board' AND action_text_rich_texts.name = 'public_description') OR (action_text_rich_texts.record_type = 'Card' AND action_text_rich_texts.name = 'description') OR (action_text_rich_texts.record_type = 'Comment' AND action_text_rich_texts.name = 'body')")
+        .select(:id)
+
+      ActiveStorage::Attachment
+        .joins(:blob)
+        .where(account_id: id, record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+        .sum("active_storage_blobs.byte_size")
+    end
+end
