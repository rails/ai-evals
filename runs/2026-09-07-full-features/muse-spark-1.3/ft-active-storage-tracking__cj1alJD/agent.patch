diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..d4d4f02
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,137 @@
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.class_eval do
+    before_destroy :remember_bytes_used_location, prepend: true
+    after_commit :recalculate_bytes_used_later
+
+    private
+      def remember_bytes_used_location
+        @bytes_used_board_id, @bytes_used_account_id = bytes_used_location
+      end
+
+      def recalculate_bytes_used_later
+        board_id, account_id = if destroyed?
+          [ @bytes_used_board_id, @bytes_used_account_id ]
+        else
+          bytes_used_location
+        end
+
+        if destroyed? && board_id.nil? && account_id.nil?
+          fallback_account_id = self[:account_id]
+
+          if fallback_account_id.present?
+            account_id = fallback_account_id
+          end
+        end
+
+        if board_id.present?
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later
+        end
+
+        if account_id.present?
+          Account.find_by(id: account_id)&.recalculate_bytes_used_later
+        end
+      end
+
+      def bytes_used_location
+        if record_type == "Card" && name == "image"
+          card = Card.find_by(id: record_id)
+
+          if card
+            [ card.board_id, card.account_id ]
+          else
+            [ nil, nil ]
+          end
+        elsif record_type == "ActionText::RichText" && name == "embeds"
+          rich_text = ActionText::RichText.find_by(id: record_id)
+
+          if rich_text.nil?
+            [ nil, nil ]
+          elsif rich_text.record_type == "Board" && rich_text.name == "public_description"
+            board = Board.find_by(id: rich_text.record_id)
+
+            if board
+              [ board.id, board.account_id ]
+            else
+              [ nil, rich_text.account_id ]
+            end
+          elsif rich_text.record_type == "Card" && rich_text.name == "description"
+            card = Card.find_by(id: rich_text.record_id)
+
+            if card
+              [ card.board_id, card.account_id ]
+            else
+              [ nil, rich_text.account_id ]
+            end
+          elsif rich_text.record_type == "Comment" && rich_text.name == "body"
+            comment = Comment.find_by(id: rich_text.record_id)
+
+            if comment
+              [ comment.card.board_id, comment.account_id ]
+            else
+              [ nil, rich_text.account_id ]
+            end
+          else
+            [ nil, nil ]
+          end
+        else
+          [ nil, nil ]
+        end
+      end
+  end
+
+  ActiveStorage::Attachment.prepend(Module.new do
+    def purge(*args, **kwargs)
+      board_id, account_id = begin
+        send(:bytes_used_location)
+      rescue StandardError
+        [ nil, nil ]
+      end
+
+      super.tap do
+        if board_id.present?
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later
+        end
+
+        if account_id.present?
+          Account.find_by(id: account_id)&.recalculate_bytes_used_later
+        end
+      end
+    end
+
+    def purge_later(*args, **kwargs)
+      board_id, account_id = begin
+        send(:bytes_used_location)
+      rescue StandardError
+        [ nil, nil ]
+      end
+
+      super.tap do
+        if board_id.present?
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later
+        end
+
+        if account_id.present?
+          Account.find_by(id: account_id)&.recalculate_bytes_used_later
+        end
+      end
+    end
+
+    def delete(*args, **kwargs)
+      board_id, account_id = begin
+        send(:bytes_used_location)
+      rescue StandardError
+        [ nil, nil ]
+      end
+
+      super.tap do
+        if board_id.present?
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later
+        end
+
+        if account_id.present?
+          Account.find_by(id: account_id)&.recalculate_bytes_used_later
+        end
+      end
+    end
+  end)
+end
