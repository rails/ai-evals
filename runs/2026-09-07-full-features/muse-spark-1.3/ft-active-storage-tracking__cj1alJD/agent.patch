@@ -0,0 +1,57 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_old_board_id_for_storage, if: :will_save_change_to_board_id?
+    after_commit :recalculate_storage_usage_if_board_changed
+    before_destroy :remember_storage_location, prepend: true
+    after_destroy_commit :recalculate_storage_usage_after_destroy
+  end
+
+  private
+    def remember_old_board_id_for_storage
+      @old_board_id_for_storage ||= board_id_was
+    end
+
+    def recalculate_storage_usage_if_board_changed
+      if !destroyed? && @old_board_id_for_storage.present? && @old_board_id_for_storage != board_id
+        old_board_id = @old_board_id_for_storage
+        @old_board_id_for_storage = nil
+
+        if old_board_id.present?
+          Board.find_by(id: old_board_id)&.recalculate_bytes_used_later
+        end
+
+        if board_id.present?
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later
+        end
+
+        account&.recalculate_bytes_used_later
+
+        if old_board_id.present?
+          old_account_id = Board.find_by(id: old_board_id)&.account_id
+
+          if old_account_id.present? && old_account_id != account_id
+            Account.find_by(id: old_account_id)&.recalculate_bytes_used_later
+          end
+        end
+      end
+    end
+
+    def remember_storage_location
+      @storage_board_id = board_id
+      @storage_account_id = account_id
+    end
+
+    def recalculate_storage_usage_after_destroy
+      if @storage_board_id.present?
+        Board.find_by(id: @storage_board_id)&.recalculate_bytes_used_later
+      end
+
+      if @storage_account_id.present?
+        Account.find_by(id: @storage_account_id)&.recalculate_bytes_used_later
+      else
+        account&.recalculate_bytes_used_later
+      end
+    end
+end
