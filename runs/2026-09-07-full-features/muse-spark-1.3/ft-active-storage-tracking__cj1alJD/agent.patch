diff --git a/app/jobs/storage_usage_backfill_job.rb b/app/jobs/storage_usage_backfill_job.rb
new file mode 100644
index 0000000..2fb39e5
--- /dev/null
+++ b/app/jobs/storage_usage_backfill_job.rb
@@ -0,0 +1,31 @@
+class StorageUsageBackfillJob < ApplicationJob
+  include ActiveJob::Continuable
+
+  queue_as :backend
+
+  def perform(batch_size: 500)
+    step :boards do |step|
+      Board.find_each(start: step.cursor, batch_size: batch_size) do |board|
+        begin
+          board.recalculate_bytes_used
+        rescue StandardError => error
+          Rails.error.report(error, context: { board_id: board.id })
+        end
+
+        step.advance! from: board.id
+      end
+    end
+
+    step :accounts do |step|
+      Account.find_each(start: step.cursor, batch_size: batch_size) do |account|
+        begin
+          account.recalculate_bytes_used
+        rescue StandardError => error
+          Rails.error.report(error, context: { account_id: account.id })
+        end
+
+        step.advance! from: account.id
+      end
+    end
+  end
+end
