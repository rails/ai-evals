diff --git a/config/initializers/account_tenancy.rb b/config/initializers/account_tenancy.rb
new file mode 100644
index 0000000..2151ef0
--- /dev/null
+++ b/config/initializers/account_tenancy.rb
@@ -0,0 +1,19 @@
+# Multi-tenant rollout: every tenant table carries account_id, required and indexed.
+# Framework tables (ActiveStorage / ActionText) are extended here to match the
+# application models that already declare `belongs_to :account`.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record&.account }
+end
