+        UPDATE active_storage_attachments SET account_id = (SELECT account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_attachments.blob_id) WHERE account_id IS NULL AND EXISTS (SELECT 1 FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_attachments.blob_id AND active_storage_blobs.account_id IS NOT NULL)
+      SQL
+
+      # active_storage_variant_records via blobs
+      execute <<~SQL
+        UPDATE active_storage_variant_records SET account_id = (SELECT account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id) WHERE account_id IS NULL
+      SQL
+
+      # storage_totals via Account/Board owners
+      execute <<~SQL
+        UPDATE storage_totals SET account_id = owner_id WHERE account_id IS NULL AND owner_type = 'Account'
+      SQL
+      execute <<~SQL
+        UPDATE storage_totals SET account_id = (SELECT account_id FROM boards WHERE boards.id = storage_totals.owner_id) WHERE account_id IS NULL AND owner_type = 'Board'
+      SQL
+    end
+
+    def drop_orphans
+      (NEW_TABLES + EXISTING_TABLES).each do |table|
+        execute "DELETE FROM #{table} WHERE account_id IS NULL"
+      end
+    end
+
+    def add_missing_indexes
+      (NEW_TABLES + EXISTING_TABLES).each do |table|
+        add_index table.to_sym, :account_id unless index_exists?(table.to_sym, :account_id)
+      end
+    end
+
+    def enforce_not_null
+      (NEW_TABLES + EXISTING_TABLES).each do |table|
+        change_column_null table.to_sym, :account_id, false
+      end
+    end
+
+    def fix_tags_uniqueness
+      # Tags must be unique per account, not globally.
+      if index_exists?(:tags, :title, name: "index_tags_on_title")
+        remove_index :tags, name: "index_tags_on_title"
+      end
+      add_index :tags, [ :account_id, :title ], unique: true, name: "index_tags_on_account_id_and_title" unless index_exists?(:tags, [ :account_id, :title ], name: "index_tags_on_account_id_and_title")
+    end
+end
