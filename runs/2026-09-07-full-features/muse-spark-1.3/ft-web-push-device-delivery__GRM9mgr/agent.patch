+require "test_helper"
+
+class Push::DeliveryJobTest < ActiveSupport::TestCase
+  setup do
+    ENV["VAPID_PUBLIC_KEY"] = "public-test-key"
+    ENV["VAPID_PRIVATE_KEY"] = "private-test-key"
+    @user = users(:kevin)
+    @user.push_subscriptions.destroy_all
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://fcm.googleapis.com/test",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "delivers push with tray title/body and card url" do
+    notification = notifications(:logo_assignment_kevin)
+    called = nil
+    WebPush.stubs(:payload_send).with do |**args|
+      called = args
+      true
+    end.returns(Struct.new(:code).new("201"))
+    Push::DeliveryJob.perform_now(notification)
+
+    assert_not_nil called
+    assert_equal @subscription.endpoint, called[:endpoint]
+    assert_equal "p256dh-key", called[:p256dh]
+    assert_equal "auth-key", called[:auth]
+    assert_equal "public-test-key", called[:vapid][:public_key]
+    assert_equal "private-test-key", called[:vapid][:private_key]
+
+    payload = JSON.parse(called[:message])
+    assert_equal notification.push_title, payload["title"]
+    assert_equal notification.push_body, payload["body"]
+    assert_equal notification.push_url, payload["url"]
+    assert_includes payload["url"], notification.card.number.to_s
+  end
+
+  test "push title/body matches tray helpers" do
+    notification = notifications(:logo_assignment_kevin)
+    assert_equal ApplicationController.helpers.event_notification_title(notification.source), notification.push_title
+    assert_equal ApplicationController.helpers.event_notification_body(notification.source), notification.push_body
+  end
+
+  test "mention push title/body" do
+    notification = notifications(:logo_mentioned_david)
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", notification.push_title
+    assert_equal notification.source.source.mentionable_content.truncate(200), notification.push_body
+  end
+
+  test "expired subscription is destroyed" do
+    notification = notifications(:logo_assignment_kevin)
+    fake_response = Struct.new(:body).new("gone")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(fake_response, "fcm"))
+    Push::DeliveryJob.perform_now(notification)
+    assert_not Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "notification creation enqueues push job" do
+    notifications(:layout_commented_kevin).destroy
+    assert_enqueued_with(job: Push::DeliveryJob) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+end
