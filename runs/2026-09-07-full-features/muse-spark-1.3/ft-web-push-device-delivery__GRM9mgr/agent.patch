diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..279bc69
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,59 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_can_manage_subscriptions
+
+  def create
+    @subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: subscription_params[:endpoint])
+    @subscription.assign_attributes(subscription_params.merge(user_agent: request.user_agent))
+
+    if @subscription.save
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled for this device" }
+        format.json { head :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: @subscription.errors.full_messages.to_sentence }
+        format.json { render json: @subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:id]) ||
+      @user.push_subscriptions.find_by(endpoint: params[:endpoint])
+
+    if @subscription.nil? && params[:push_subscription].present?
+      @subscription = @user.push_subscriptions.find_by(endpoint: destroy_params[:endpoint]) if destroy_params[:endpoint].present?
+    end
+
+    @subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_can_manage_subscriptions
+      head :forbidden unless @user == Current.user
+    end
+
+    def subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    def destroy_params
+      params.expect(push_subscription: [ :endpoint ])
+    rescue ActionController::ParameterMissing
+      {}
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..166cb99
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,160 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Manages web push subscriptions for the device in use.
+//
+// Expected markup:
+//
+//   <div data-controller="notifications"
+//        data-notifications-vapid-public-key-value="..."
+//        data-notifications-subscription-url-value="/users/:id/push_subscriptions">
+//   </div>
+//
+// Toggles the `notifications--on` class on the element when push is enabled
+// for this device, which drives the .notifications__on-message /
+// .notifications__off-message styles. Help copy for blocked browsers lives in
+// notifications/settings/_browser and _system partials with
+// data-notifications-target="details".
+export default class extends Controller {
+  static values = {
+    vapidPublicKey: String,
+    subscriptionUrl: String
+  }
+
+  static targets = [ "details" ]
+
+  connect() {
+    this.refresh()
+  }
+
+  async refresh() {
+    if (!this.isSupported()) {
+      return
+    }
+
+    if (Notification.permission === "granted") {
+      const subscription = await this.getSubscription()
+      this.setEnabled(!!subscription)
+    } else {
+      this.setEnabled(false)
+    }
+  }
+
+  async enable(event) {
+    if (event) event.preventDefault()
+
+    if (!this.isSupported()) return
+
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.setEnabled(false)
+      this.showDetails()
+      return
+    }
+
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.applicationServerKey()
+      })
+    }
+
+    await this.saveSubscription(subscription)
+    this.setEnabled(true)
+  }
+
+  async disable(event) {
+    if (event) event.preventDefault()
+
+    const subscription = await this.getSubscription()
+    if (subscription) {
+      const endpoint = subscription.endpoint
+      try {
+        await subscription.unsubscribe()
+      } catch (_) {
+        // ignore unsubscribe errors, still remove server-side
+      }
+      await this.deleteSubscription(endpoint)
+    }
+    this.setEnabled(false)
+  }
+
+  // -- private --
+
+  isSupported() {
+    return ("Notification" in window) && ("serviceWorker" in navigator) && ("PushManager" in window)
+  }
+
+  setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+  }
+
+  showDetails() {
+    this.detailsTargets.forEach((el) => {
+      el.open = true
+      el.classList.add("notifications--blocked")
+    })
+  }
+
+  async getSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return await registration.pushManager.getSubscription()
+  }
+
+  applicationServerKey() {
+    return this.urlBase64ToUint8Array(this.vapidPublicKeyValue)
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  subscriptionJson(subscription) {
+    const json = subscription.toJSON()
+    return {
+      endpoint: json.endpoint,
+      p256dh_key: json.keys.p256dh,
+      auth_key: json.keys.auth
+    }
+  }
+
+  csrfToken() {
+    return document.querySelector('meta[name="csrf-token"]')?.content
+  }
+
+  async saveSubscription(subscription) {
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "Accept": "application/json",
+        "X-CSRF-Token": this.csrfToken()
+      },
+      body: JSON.stringify({ push_subscription: this.subscriptionJson(subscription) })
+    })
+
+    if (!response.ok) {
+      throw new Error("Failed to save push subscription")
+    }
+  }
+
+  async deleteSubscription(endpoint) {
+    const url = `${this.subscriptionUrlValue}/0?endpoint=${encodeURIComponent(endpoint)}`
+    await fetch(url, {
+      method: "DELETE",
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": this.csrfToken()
+      }
+    })
+  }
+}
