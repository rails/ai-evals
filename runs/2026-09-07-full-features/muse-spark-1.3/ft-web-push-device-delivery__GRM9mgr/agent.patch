index 0000000..688fda9
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,32 @@
+module Push
+  def self.table_name_prefix
+    "push_"
+  end
+
+  class << self
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT", "mailto:notifications@fizzy.do")
+    end
+
+    def vapid_details
+      details = {
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+      details[:subject] = vapid_subject if ENV["VAPID_SUBJECT"].present?
+      details
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..ccf2c29
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,30 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, presence: true
+  validates :auth_key, presence: true
+
+  def deliver(notification)
+    return unless Push.configured?
+
+    WebPush.payload_send(
+      message: JSON.generate(notification.push_payload),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_details
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  class << self
+    def deliver_for(notification)
+      notification.user.push_subscriptions.find_each do |subscription|
+        subscription.deliver(notification)
+      end
+    end
+  end
+end
