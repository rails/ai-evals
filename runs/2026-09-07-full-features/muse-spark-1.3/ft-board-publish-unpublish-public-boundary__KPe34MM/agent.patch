diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..cdcd139
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,30 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_key, uniqueness: true, allow_nil: true
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def publish!
+    update!(public_key: self.class.generate_unique_public_key) unless published?
+    self
+  end
+
+  def unpublish!
+    update!(public_key: nil) if published?
+    self
+  end
+
+  module ClassMethods
+    def generate_unique_public_key
+      loop do
+        candidate = SecureRandom.urlsafe_base64(18)
+        break candidate unless exists?(public_key: candidate)
+      end
+    end
+  end
+end
