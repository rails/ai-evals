--- /dev/null
+++ b/app/models/comment/storage_usage.rb
@@ -0,0 +1,51 @@
+module Comment::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_card_for_storage_usage, if: :will_save_change_to_card_id?
+    after_commit :recalculate_storage_usage_after_card_change, on: [ :update ]
+    after_destroy_commit :recalculate_storage_usage_on_destroy
+  end
+
+  private
+    def remember_card_for_storage_usage
+      @old_card_id_for_storage_usage = card_id_was
+    end
+
+    def recalculate_storage_usage_after_card_change
+      old_card_id = @old_card_id_for_storage_usage
+      @old_card_id_for_storage_usage = nil
+      return if old_card_id.nil? || old_card_id == card_id
+
+      old_card = Card.find_by(id: old_card_id)
+      new_card = Card.find_by(id: card_id)
+
+      boards = []
+      accounts = []
+
+      if old_card
+        boards << old_card.board if old_card.board
+        accounts << old_card.account if old_card.account
+      end
+
+      if new_card
+        boards << new_card.board if new_card.board
+        accounts << new_card.account if new_card.account
+      end
+
+      accounts << Account.find_by(id: account_id) if account_id.present?
+
+      boards.uniq.compact.each(&:recalculate_bytes_used_later)
+      accounts.uniq.compact.each(&:recalculate_bytes_used_later)
+    end
+
+    def recalculate_storage_usage_on_destroy
+      card_record = Card.find_by(id: card_id)
+      if card_record
+        card_record.board&.recalculate_bytes_used_later
+        card_record.account&.recalculate_bytes_used_later
+      else
+        Account.find_by(id: account_id)&.recalculate_bytes_used_later
+      end
+    end
+end
