diff --git a/app/models/account/storage_usage.rb b/app/models/account/storage_usage.rb
new file mode 100644
index 0000000..c4bd2b9
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,35 @@
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def recalculate_bytes_used_later
+    Account::BytesUsedRecalculationJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used!
+    update_column(:bytes_used, calculate_bytes_used)
+  end
+
+  def calculate_bytes_used
+    image_blob_ids = ActiveStorage::Attachment
+      .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+      .select(:blob_id)
+
+    relevant_rich_texts = ActionText::RichText
+      .where(record_type: "Board", record_id: boards.select(:id), name: "public_description")
+      .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id), name: "description"))
+      .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id), name: "body"))
+
+    embed_blob_ids = ActiveStorage::Attachment
+      .where(record_type: "ActionText::RichText", name: "embeds", record_id: relevant_rich_texts.select(:id))
+      .select(:blob_id)
+
+    ActiveStorage::Blob
+      .where(id: image_blob_ids)
+      .or(ActiveStorage::Blob.where(id: embed_blob_ids))
+      .sum(:byte_size)
+  end
+end
diff --git a/app/models/active_storage/attachment_storage_usage.rb b/app/models/active_storage/attachment_storage_usage.rb
new file mode 100644
index 0000000..3fce67c
--- /dev/null
+++ b/app/models/active_storage/attachment_storage_usage.rb
@@ -0,0 +1,136 @@
+# Callbacks on ActiveStorage::Attachment to keep Account/Board#bytes_used fresh.
+#
+# Only card images and ActionText embeds are counted toward storage usage, so
+# other attachments (avatars, export/import files, …) are ignored. The actual
+# summation is a single SQL SUM over distinct blobs (see Account::StorageUsage
+# and Board::StorageUsage), so recalculation stays cheap no matter how many
+# attachments exist. Recalculation itself runs in background jobs, which are
+# idempotent full recomputations — safe under concurrent writers, unlike
+# read-modify-write counter increments.
+module ActiveStorage::AttachmentStorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :recalculate_storage_usage_on_create, if: :counted_for_storage_usage?
+    after_update_commit :recalculate_storage_usage_on_update, if: :counted_for_storage_usage_changed?
+    after_destroy_commit :recalculate_storage_usage_on_destroy, if: :counted_for_storage_usage?
+  end
+
+  def counted_for_storage_usage?
+    (record_type == "Card" && name == "image") ||
+      (record_type == "ActionText::RichText" && name == "embeds")
+  end
+
+  def counted_for_storage_usage_changed?
+    counted_for_storage_usage?
+  end
+
+  # ActiveStorage deletes attachments with #delete (bypassing callbacks) in
+  # #purge, #purge_later and #detach. Hook #delete so those paths still
+  # refresh usage counts, deferring the enqueue until the transaction commits
+  # so background jobs observe committed data.
+  def delete
+    should_track = counted_for_storage_usage?
+    board_id, account_id = storage_usage_board_and_account_ids if should_track
+    super.tap do
+      if should_track && (board_id || account_id)
+        if self.class.connection.transaction_open?
+          self.class.connection.add_transaction_record(
+            StorageUsageDeleteCallback.new(board_id, account_id)
+          )
+        else
+          Board.find_by(id: board_id)&.recalculate_bytes_used_later if board_id
+          Account.find_by(id: account_id)&.recalculate_bytes_used_later if account_id
+        end
+      end
+    end
+  end
+
+  private
+    def recalculate_storage_usage_on_create
+      recalculate_storage_usage_later
+    end
+
+    def recalculate_storage_usage_on_update
+      recalculate_storage_usage_later
+    end
+
+    def recalculate_storage_usage_on_destroy
+      recalculate_storage_usage_later
+    end
+
+    def recalculate_storage_usage_later
+      board, account = storage_usage_board_and_account
+      board&.recalculate_bytes_used_later
+      account&.recalculate_bytes_used_later
+    rescue StandardError => e
+      Rails.error.report(e, context: { attachment_id: id, record_type: record_type, record_id: record_id })
+    end
+
+    def storage_usage_board_and_account_ids
+      board, account = storage_usage_board_and_account
+      [ board&.id, account&.id ]
+    end
+
+    def storage_usage_board_and_account
+      if record_type == "Card" && name == "image"
+        card = Card.find_by(id: record_id)
+        if card
+          [ card.board, card.account ]
+        else
+          [ nil, Account.find_by(id: account_id) ]
+        end
+      elsif record_type == "ActionText::RichText" && name == "embeds"
+        rich_text = ActionText::RichText.find_by(id: record_id)
+        if rich_text
+          case rich_text.record_type
+          when "Board"
+            board = Board.find_by(id: rich_text.record_id)
+            [ board, board&.account || Account.find_by(id: account_id) ]
+          when "Card"
+            card = Card.find_by(id: rich_text.record_id)
+            if card
+              [ card.board, card.account ]
+            else
+              [ nil, Account.find_by(id: account_id) ]
+            end
+          when "Comment"
+            comment = Comment.find_by(id: rich_text.record_id)
+            card = comment&.card
+            if card
+              [ card.board, card.account ]
+            elsif comment
+              [ nil, Account.find_by(id: comment.account_id) ]
+            else
+              [ nil, Account.find_by(id: account_id) ]
+            end
+          else
+            [ nil, Account.find_by(id: account_id) ]
+          end
+        else
+          [ nil, Account.find_by(id: account_id) ]
+        end
+      else
+        [ nil, nil ]
+      end
+    end
+
+  class StorageUsageDeleteCallback
+    def initialize(board_id, account_id)
+      @board_id = board_id
+      @account_id = account_id
+    end
+
+    def committed!(*)
+      Board.find_by(id: @board_id)&.recalculate_bytes_used_later if @board_id
+      Account.find_by(id: @account_id)&.recalculate_bytes_used_later if @account_id
+    end
+
+    def rolledback!(*); end
+    def before_committed!(*); end
+    def trigger_transactional_callbacks?
+      true
+    end
+    def add_to_transaction(*); end
+  end
+end
