diff --git a/app/models/card/storage_usage.rb b/app/models/card/storage_usage.rb
new file mode 100644
index 0000000..cb8ee7e
--- /dev/null
+++ b/app/models/card/storage_usage.rb
@@ -0,0 +1,51 @@
+module Card::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    before_update :remember_board_for_storage_usage, if: :will_save_change_to_board_id?
+    after_commit :recalculate_storage_usage_after_board_change, on: [ :update ]
+    after_destroy_commit :recalculate_storage_usage_on_destroy
+  end
+
+  private
+    def remember_board_for_storage_usage
+      @old_board_id_for_storage_usage = board_id_was
+    end
+
+    def recalculate_storage_usage_after_board_change
+      old_board_id = @old_board_id_for_storage_usage
+      @old_board_id_for_storage_usage = nil
+      return if old_board_id.nil? || old_board_id == board_id
+
+      boards_to_update = []
+      accounts_to_update = []
+
+      if (old_board = Board.find_by(id: old_board_id))
+        boards_to_update << old_board
+        accounts_to_update << old_board.account if old_board.account
+      else
+        accounts_to_update << Account.find_by(id: account_id) if account_id.present?
+      end
+
+      if (new_board = Board.find_by(id: board_id))
+        boards_to_update << new_board
+        accounts_to_update << new_board.account if new_board.account
+      end
+
+      if (current_account = Account.find_by(id: account_id))
+        accounts_to_update << current_account
+      end
+
+      boards_to_update.uniq.each(&:recalculate_bytes_used_later)
+      accounts_to_update.uniq.compact.each(&:recalculate_bytes_used_later)
+    end
+
+    def recalculate_storage_usage_on_destroy
+      if (b = Board.find_by(id: board_id))
+        b.recalculate_bytes_used_later
+      end
+      if (a = Account.find_by(id: account_id))
+        a.recalculate_bytes_used_later
+      end
+    end
+end
