diff --git a/app/mailers/application_mailer.rb b/app/mailers/application_mailer.rb
index 9f0d723..286e14b 100644
--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -5,7 +5,66 @@ class ApplicationMailer < ActionMailer::Base
   append_view_path Rails.root.join("app/views/mailers")
   helper AvatarsHelper, HtmlHelper
 
+  after_action :translate_mail_for_japanese
+
   private
+    def with_recipient_locale(recipient, &block)
+      locale = LocaleHelper.locale_for(recipient)
+      @recipient_locale = locale || I18n.locale
+      if locale
+        I18n.with_locale(locale) do
+          result = yield
+          # Translate the built message if Japanese
+          translate_message_if_japanese(result) if locale.to_s == "ja" && result.is_a?(Mail::Message)
+          result
+        end
+      else
+        yield
+      end
+    end
+
+    def translate_mail_for_japanese
+      return unless @recipient_locale.to_s == "ja"
+      return unless message
+      translate_message_if_japanese(message)
+    end
+
+    def translate_message_if_japanese(mail_message)
+      # Subject already translated via I18n.t, but ensure any remaining English translated
+      if mail_message.subject
+        mail_message.subject = LocaleDictionary.translate_html(mail_message.subject)
+      end
+      if mail_message.html_part
+        begin
+          body = mail_message.html_part.body.decoded
+          translated = LocaleDictionary.translate_html(body)
+          mail_message.html_part.body = translated
+        rescue StandardError
+          nil
+        end
+      end
+      if mail_message.text_part
+        begin
+          body = mail_message.text_part.body.decoded
+          translated = LocaleDictionary.translate_html(body)
+          mail_message.text_part.body = translated
+        rescue StandardError
+          nil
+        end
+      else
+        # Single part
+        begin
+          if mail_message.body && mail_message.content_type.to_s.include?("text")
+            body = mail_message.body.decoded
+            translated = LocaleDictionary.translate_html(body)
+            mail_message.body = translated
+          end
+        rescue StandardError
+          nil
+        end
+      end
+    end
+
     def default_url_options
       if Current.account
         super.merge(script_name: Current.account.slug)
