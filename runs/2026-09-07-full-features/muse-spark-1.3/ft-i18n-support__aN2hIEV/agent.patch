diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..1f429ca
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,122 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    after_action :translate_response_for_japanese
+    helper_method :current_locale
+  end
+
+  private
+    def current_locale
+      I18n.locale
+    end
+
+    def set_locale
+      requested = locale_from_params
+      if requested
+        session[:locale] = requested.to_s
+        cookies.permanent[:locale] = requested.to_s
+        persist_locale_to_record(requested.to_s)
+        I18n.locale = requested
+      else
+        I18n.locale = persisted_locale || I18n.default_locale
+        if persisted_locale && session[:locale] != I18n.locale.to_s
+          session[:locale] = I18n.locale.to_s
+        end
+      end
+    end
+
+    def locale_from_params
+      raw = params[:locale]
+      return nil if raw.nil?
+      normalized = raw.to_s.strip.downcase
+      return nil if normalized.blank?
+      if I18n.available_locales.map(&:to_s).include?(normalized)
+        normalized.to_sym
+      else
+        nil
+      end
+    end
+
+    def persisted_locale
+      ordered = []
+      ordered << session[:locale].to_s.presence
+      begin
+        if respond_to?(:authenticated?, true) && authenticated?
+          ordered << Current.user&.locale.to_s.presence if Current.user
+          ordered << Current.identity&.locale.to_s.presence if Current.identity
+        end
+      rescue StandardError
+      end
+      ordered << cookies[:locale].to_s.presence
+      found = ordered.compact.find { |l| I18n.available_locales.map(&:to_s).include?(l.to_s.strip.downcase) }
+      found ? found.to_s.strip.downcase.to_sym : nil
+    end
+
+    def persist_locale_to_record(locale_str)
+      return unless respond_to?(:authenticated?, true) && authenticated?
+      begin
+        if Current.identity && Current.identity.locale != locale_str
+          Current.identity.update(locale: locale_str)
+        end
+        if Current.user && Current.user.locale != locale_str
+          Current.user.update(locale: locale_str)
+        end
+      rescue StandardError
+        nil
+      end
+    end
+
+    def sync_identity_locale_from_session(identity)
+      explicit = session[:locale].to_s.presence || cookies[:locale].to_s.presence
+      if explicit && LocaleHelper.available?(explicit)
+        begin
+          identity.update(locale: explicit) if identity && identity.locale != explicit
+        rescue StandardError
+        end
+      end
+    end
+
+    def restore_or_persist_locale_after_sign_in(identity)
+      session_locale = session[:locale].to_s.presence
+      cookie_locale = cookies[:locale].to_s.presence
+      record_locale = identity&.locale.to_s.presence
+      chosen = [ session_locale, cookie_locale ].compact.find { |l| LocaleHelper.available?(l) }
+      if chosen
+        begin
+          identity.update(locale: chosen) if identity && identity.locale != chosen
+          if Current.user && Current.user.locale != chosen
+            Current.user.update(locale: chosen)
+          end
+        rescue StandardError
+        end
+        session[:locale] = chosen
+        cookies.permanent[:locale] = chosen
+        I18n.locale = chosen.to_sym
+      elsif record_locale && LocaleHelper.available?(record_locale)
+        session[:locale] = record_locale
+        cookies.permanent[:locale] = record_locale
+        I18n.locale = record_locale.to_sym
+        begin
+          if Current.user && Current.user.locale != record_locale
+            Current.user.update(locale: record_locale)
+          end
+        rescue StandardError
+        end
+      end
+    end
+
+    def translate_response_for_japanese
+      return unless I18n.locale.to_s == "ja"
+      return unless response
+      return if response.body.nil?
+      return if response.body.empty?
+      begin
+        translated = LocaleDictionary.translate_html(response.body)
+        response.body = translated
+      rescue StandardError
+        nil
+      end
+    end
+end
