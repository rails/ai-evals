+    "Invite people" => "メンバーを招待",
+    "Only admins can change these settings" => "これらの設定を変更できるのは管理者のみです",
+    "Board Settings" => "ボード設定",
+    "Cancel and go back" => "キャンセルして戻る",
+
+
+    "Couldn't create account." => "アカウントを作成できませんでした。",
+    "Saved (you were removed from the board)" => "保存しました（ボードから削除されました）",
+    "Token is no longer visible" => "トークンは表示されなくなりました",
+    "Invalid unsubscribe link" => "無効な登録解除リンクです",
+    "Token is invalid or has expired" => "トークンが無効か有効期限が切れています",
+    "Something went wrong, and we couldn't create your account. Please give it another try." => "問題が発生し、アカウントを作成できませんでした。もう一度お試しください。",
+    "Board Settings" => "ボード設定",
+    "Only admins can change these settings" => "これらの設定を変更できるのは管理者のみです",
+    "Cancel and go back" => "キャンセルして戻る",
+    "Are you sure you want to remove yourself from this board? You won’t be able to get back in unless someone invites you." => "本当にこのボードから自分を削除しますか？誰かに招待されない限り戻れません。",
+    "Danger zone" => "危険ゾーン",
+    "Delete this board" => "このボードを削除します",
+    "Are you sure you want to permanently delete this board and all the cards on it? This can't be undone." => "このボードとすべてのカードを完全に削除してもよろしいですか？この操作は取り消せません。",
+    "Delete this board?" => "このボードを削除しますか？",
+
+
+  }.freeze
+
+  def self.safe_replace(text, en, ja)
+    if en.match?(/\A[A-Za-z]+\z/) && en.length <= 6
+      pattern = Regexp.new("(?<![A-Za-z])" + Regexp.escape(en) + "(?![A-Za-z])")
+      text.gsub(pattern, ja)
+    else
+      text.gsub(en, ja)
+    end
+  end
+
+  def self.translate_html(html)
+    return html if html.nil? || html.empty?
+    # For plain text (no HTML tags), simple replacement is safe
+    unless html.include?("<")
+      result = html.dup
+      TRANSLATIONS.sort_by { |k, _| -k.length }.each do |en, ja|
+        next if en.strip.empty? || en.length < 2
+        next if en.strip.length < 2
+        result = safe_replace(result, en, ja)
+      end
+      return result
+    end
+    begin
+      require "nokogiri"
+      is_fragment = !html.include?("<html")
+      doc = is_fragment ? Nokogiri::HTML::DocumentFragment.parse(html) : Nokogiri::HTML.parse(html)
+      # Translate text nodes, excluding script/style
+      doc.traverse do |node|
+        if node.text? && node.parent && !%w[script style].include?(node.parent.name)
+          original = node.content
+          # Skip if no letters or looks like code (URLs, emails)?
+          next unless original.match?(/[A-Za-z]/)
+          translated = original.dup
+          TRANSLATIONS.sort_by { |k, _| -k.length }.each do |en, ja|
+            next if en.strip.empty? || en.length < 2
+            next if en.strip.length < 2
+            # Skip brand names that should stay? Actually Fizzy should stay, but our dict keeps Fizzy in some phrases? Keep as is.
+            translated = safe_replace(translated, en, ja)
+          end
+          node.content = translated if translated != original
+        elsif node.element?
+          %w[aria-label placeholder title alt aria-description data-bridge-title].each do |attr|
+            # Also handle data-bridge-title? Actually bridge_title is data attribute with English? Check: data-bridge-title="..."? In HTML it's data-bridge--title-title-value? Hmm.
+            # For now handle standard ones
+            if node.has_attribute?(attr)
+              v = node[attr]
+              next unless v && v.match?(/[A-Za-z]{3,}/)
+              translated = v.dup
+              TRANSLATIONS.sort_by { |k, _| -k.length }.each do |en, ja|
+                next if en.strip.empty? || en.length < 2
+                next if en.strip.length < 2
+                translated = safe_replace(translated, en, ja)
+              end
+              node[attr] = translated if translated != v
+            end
+          end
+          # Handle data attributes that contain UI strings: bridge_title, etc.? They are in data-* attributes like data-bridge--title-title-value? Let's translate any data-* that looks like UI?
+          node.attribute_nodes.each do |attr_node|
+            name = attr_node.name
+            next unless name.start_with?("data-") && attr_node.value.match?(/[A-Za-z]{4,}/)
+            # Skip IDs, URLs, technical values (contain /, -, _, :, etc. heavily?) Heuristic: only translate if value is mostly letters/spaces and in dictionary?
+            v = attr_node.value
+            # Skip if looks like URL, path, ID, code
+            next if v.include?("/") && v.include?("-")
+            next if v.match?(/\A[a-z0-9\-_]+\z/)
+            translated = v.dup
+            TRANSLATIONS.sort_by { |k, _| -k.length }.each do |en, ja|
+              next if en.strip.empty? || en.length < 4
+              translated = safe_replace(translated, en, ja)
+            end
+            attr_node.value = translated if translated != v
+          end
+        end
+      end
+      # Preserve html lang
+      if is_fragment
+        doc.to_html
+      else
+        html_node = doc.at_css("html")
+        html_node["lang"] = "ja" if html_node
+        doc.to_html
+      end
+    rescue StandardError
+      # Fallback to simple (but avoid style corruption? just return original)
+      html
+    end
+  end
+
+end
