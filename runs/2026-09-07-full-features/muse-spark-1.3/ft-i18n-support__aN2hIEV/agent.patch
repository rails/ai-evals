diff --git a/app/helpers/locale_helper.rb b/app/helpers/locale_helper.rb
new file mode 100644
index 0000000..5993bef
--- /dev/null
+++ b/app/helpers/locale_helper.rb
@@ -0,0 +1,47 @@
+module LocaleHelper
+  AVAILABLE = %w[en ja].freeze
+
+  class << self
+    def available?(locale)
+      AVAILABLE.include?(locale.to_s)
+    end
+
+    def locale_for(record)
+      locale = extract_locale(record)
+      locale = locale.to_s.strip.downcase if locale
+      available?(locale) ? locale.to_sym : nil
+    end
+
+    def locale_for_user_or_identity(user: nil, identity: nil)
+      locale_for(user) || locale_for(identity) || I18n.default_locale
+    end
+
+    private
+      def extract_locale(record)
+        return nil if record.nil?
+        # Direct locale attribute
+        if record.respond_to?(:locale) && record.locale.present?
+          return record.locale
+        end
+        # User -> identity
+        if record.respond_to?(:identity) && record.identity&.locale.present?
+          return record.identity.locale
+        end
+        # Identity -> users? pick first with locale
+        if record.is_a?(Identity)
+          # identity locale already checked
+          return nil
+        end
+        # Bundle -> user
+        if record.respond_to?(:user) && record.user
+          return extract_locale(record.user) || extract_locale(record.user.identity)
+        end
+        # Export -> user
+        # Account cancellation -> initiated_by
+        if record.respond_to?(:initiated_by) && record.initiated_by
+          return extract_locale(record.initiated_by)
+        end
+        nil
+      end
+  end
+end
