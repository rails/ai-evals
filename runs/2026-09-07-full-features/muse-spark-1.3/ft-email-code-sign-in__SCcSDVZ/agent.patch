diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..7e01378
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,64 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRES_IN = 15.minutes
+
+  CODE_ALPHABET = ("A".."Z").to_a + ("2".."9").to_a - %w[0 1 O I]
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  before_create :generate_code, if: -> { code.blank? }
+
+  def expired?
+    created_at < EXPIRES_IN.ago
+  end
+
+  def expired_or_consumed?
+    expired?
+  end
+
+  def matches?(submitted_code)
+    ActiveSupport::SecurityUtils.secure_compare(code.to_s.upcase, submitted_code.to_s.strip.upcase)
+  rescue ActiveSupport::SecurityUtils::LengthMismatch
+    false
+  end
+
+  def pending_token
+    signed_id(purpose: :email_code, expires_in: EXPIRES_IN)
+  end
+
+  def self.find_by_pending_token(token)
+    find_signed(token, purpose: :email_code)
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveSupport::MessageVerifier::InvalidMessage
+    nil
+  end
+
+  def self.authenticate(email_address, submitted_code)
+    normalized = email_address.to_s.strip.downcase
+    submitted = submitted_code.to_s.strip.upcase
+    return nil if normalized.blank? || submitted.blank?
+
+    where(email_address: normalized)
+      .where("created_at > ?", EXPIRES_IN.ago)
+      .order(created_at: :desc)
+      .find { |record| record.matches?(submitted) }
+  end
+
+  def self.create_for(email_address)
+    normalized = email_address.to_s.strip.downcase
+    create!(email_address: normalized)
+  end
+
+  def consume!
+    destroy!
+  end
+
+  private
+    def generate_code
+      self.code = loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_ALPHABET.sample }.join
+        # Ensure no unexpired duplicate for same email to reduce confusion, but allow global reuse
+        break candidate unless self.class.where(email_address: email_address).where("created_at > ?", EXPIRES_IN.ago).exists?(code: candidate)
+      end
+    end
+end
