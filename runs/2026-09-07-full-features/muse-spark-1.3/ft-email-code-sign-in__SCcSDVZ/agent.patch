+class Sessions::MagicLinksController < ApplicationController
+  include EmailCodeAuthenticatable
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @email_address = pending_email_address
+    if @email_address.blank?
+      redirect_to new_session_path
+    else
+      @latest_code = latest_code_for_dev_hint
+    end
+  end
+
+  def create
+    code = submitted_verification_code
+    email = submitted_email_address || pending_email_address
+
+    if code.blank? || email.blank?
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "Enter the code we emailed you." }
+        format.json { render json: { message: "Enter the code we emailed you." }, status: :unauthorized }
+      end
+      return
+    end
+
+    record = EmailCode.authenticate(email, code)
+
+    if record
+      email_address = record.email_address
+      record.consume!
+      identity = Identity.find_or_create_by!(email_address: email_address)
+      start_new_session_for identity
+      session.delete(:pending_email_address)
+      cookies.delete(:pending_authentication_token)
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: Current.session.signed_id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def latest_code_for_dev_hint
+      return nil unless Rails.env.development?
+      EmailCode.where(email_address: @email_address).order(created_at: :desc).first
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
