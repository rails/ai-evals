@@ -0,0 +1,96 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  include EmailCodeAuthenticatable
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @email_address = session[join_session_key] || session[:pending_email_address] || pending_email_address
+    if @email_address.blank?
+      redirect_to join_path(code: @join_code.code)
+    else
+      @latest_code = Rails.env.development? ? EmailCode.where(email_address: @email_address).order(created_at: :desc).first : nil
+    end
+  end
+
+  def create
+    verification_code = request.request_parameters["code"] || request.request_parameters[:code] ||
+      request.query_parameters["code"] || request.query_parameters[:code] ||
+      (params[:code].is_a?(String) && params[:code] != @join_code.code ? params[:code] : nil)
+
+    # Fallback: params[:code] is shadowed by path, so if body code wasn't found above but params has join code only, treat as missing
+    if verification_code.blank?
+      # Try generic helper which also checks nested
+      verification_code = submitted_verification_code
+      verification_code = nil if verification_code == @join_code.code
+    end
+
+    email = request.request_parameters["email_address"] || request.request_parameters[:email_address] ||
+      request.query_parameters["email_address"] || request.query_parameters[:email_address] ||
+      (params[:email_address].is_a?(String) ? params[:email_address] : nil)
+    email ||= session[join_session_key] || session[:pending_email_address] || pending_email_address
+
+    if verification_code.blank? || email.blank?
+      respond_to do |format|
+        format.html { redirect_to join_magic_link_path(code: @join_code.code), alert: "Enter the code we emailed you." }
+        format.json { render json: { message: "Enter the code we emailed you." }, status: :unauthorized }
+      end
+      return
+    end
+
+    record = EmailCode.authenticate(email, verification_code)
+
+    if record
+      email_address = record.email_address
+      record.consume!
+      identity = Identity.find_or_create_by!(email_address: email_address)
+      start_new_session_for identity unless Current.identity == identity
+      Current.identity = identity if Current.identity.nil?
+      session.delete(join_session_key)
+      session.delete(:pending_email_address)
+      cookies.delete(:pending_authentication_token)
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: Current.session.signed_id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to join_magic_link_path(code: @join_code.code), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def join_session_key
+      "join_email_#{@join_code.id}"
+    end
+
+    def set_join_code
+      join_code_value = request.path_parameters[:code] || params[:code]
+      @join_code ||= Account::JoinCode.find_by(code: join_code_value, account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render :inactive, status: :gone
+      end
+    end
+end
