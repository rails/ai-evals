--- /dev/null
+++ b/app/controllers/concerns/email_code_authenticatable.rb
@@ -0,0 +1,83 @@
+module EmailCodeAuthenticatable
+  extend ActiveSupport::Concern
+
+  private
+    def request_email_code_for(email_address)
+      email_code = EmailCode.create_for(email_address)
+      AuthenticationMailer.email_code(email_address: email_code.email_address, code: email_code.code).deliver_later
+      email_code
+    end
+
+    def set_pending_authentication(email_code)
+      token = email_code.pending_token
+      cookies.signed[:pending_authentication_token] = {
+        value: token,
+        httponly: true,
+        same_site: :lax,
+        expires: EmailCode::EXPIRES_IN.from_now
+      }
+      token
+    end
+
+    def pending_email_code
+      token = cookies.signed[:pending_authentication_token] || params[:pending_authentication_token]
+      if token.present?
+        EmailCode.find_by_pending_token(token)
+      end
+    end
+
+    def pending_email_address(fallback_session_key: nil)
+      if (record = pending_email_code)
+        record.email_address
+      elsif fallback_session_key && session[fallback_session_key].present?
+        session[fallback_session_key]
+      elsif session[:pending_email_address].present?
+        session[:pending_email_address]
+      end
+    end
+
+    def submitted_verification_code
+      code = request.request_parameters["code"] || request.request_parameters[:code] ||
+        request.query_parameters["code"] || request.query_parameters[:code]
+      code ||= params[:code] if params[:code].is_a?(String)
+      # Also support nested, e.g. signup[code]
+      if code.nil?
+        %i[signup session].each do |scope|
+          if params[scope].is_a?(ActionController::Parameters) && params[scope][:code].present?
+            code = params[scope][:code]
+            break
+          elsif params[scope].is_a?(Hash) && params[scope][:code].present?
+            code = params[scope][:code]
+            break
+          end
+        end
+      end
+      code.to_s.strip.presence
+    end
+
+    def submitted_email_address
+      email = request.request_parameters["email_address"] || request.request_parameters[:email_address] ||
+        request.query_parameters["email_address"] || request.query_parameters[:email_address]
+      email ||= params[:email_address] if params[:email_address].is_a?(String)
+      if email.nil?
+        %i[signup session].each do |scope|
+          nested = params[scope] if params[scope].is_a?(ActionController::Parameters) || params[scope].is_a?(Hash)
+          if nested && nested[:email_address].present?
+            email = nested[:email_address]
+            break
+          end
+        end
+      end
+      email.to_s.strip.presence
+    end
+
+    def valid_email_address?(email_address)
+      Identity.new(email_address: email_address).valid?
+    end
+
+    def consume_matching_code!(email_address, code)
+      record = EmailCode.authenticate(email_address, code)
+      record&.consume!
+      record
+    end
+end
