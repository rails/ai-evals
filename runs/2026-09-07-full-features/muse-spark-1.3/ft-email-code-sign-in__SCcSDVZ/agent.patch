+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= "Join #{@join_code.account.name} in Fizzy" %></h1>
+
+  <p>We sent a six-character code to <strong><%= @email_address %></strong>. Enter it below to join.</p>
+
+  <%= form_with url: join_magic_link_path(code: @join_code.code), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <% if @latest_code %>
+    <p class="txt-subtle txt-small">Psst, here's your code: <strong><%= @latest_code.code %></strong></p>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
