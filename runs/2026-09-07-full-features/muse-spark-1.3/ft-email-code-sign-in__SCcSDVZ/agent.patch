+      session[:pending_email_address] = email_code.email_address
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_magic_link_path }
+        format.json { render json: { pending_authentication_token: token }, status: :created }
+      end
     else
       head :unprocessable_entity
     end
   end
 
   private
+    def verify_code_and_sign_up(code)
+      email = submitted_email_address || session[:signup_email_address] || session[:pending_email_address] || pending_email_address
+
+      record = email.present? ? EmailCode.authenticate(email, code) : nil
+
+      if record
+        email_address = record.email_address
+        record.consume!
+        identity = Identity.find_or_create_by!(email_address: email_address)
+        start_new_session_for identity
+        session.delete(:signup_email_address)
+        session.delete(:pending_email_address)
+        cookies.delete(:pending_authentication_token)
+
+        respond_to do |format|
+          format.html { redirect_to new_signup_completion_path }
+          format.json { render json: { session_token: Current.session.signed_id }, status: :created }
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to new_signup_magic_link_path, alert: "That code didn't work. Try again." }
+          format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+        end
+      end
+    end
+
     def redirect_authenticated_user
       redirect_to new_signup_completion_path if authenticated?
     end
