+class Signups::MagicLinksController < ApplicationController
+  include EmailCodeAuthenticatable
+
+  wrap_parameters :signup, include: %i[ email_address ]
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { redirect_to new_signup_magic_link_path, alert: "Try again later." }
+  before_action :redirect_authenticated_user
+  before_action :enforce_tenant_limit
+
+  layout "public"
+
+  def new
+    @email_address = session[:signup_email_address] || session[:pending_email_address] || pending_email_address
+    if @email_address.blank?
+      redirect_to new_signup_path
+    else
+      @latest_code = Rails.env.development? ? EmailCode.where(email_address: @email_address).order(created_at: :desc).first : nil
+    end
+  end
+
+  def create
+    code = submitted_verification_code
+    email = submitted_email_address || session[:signup_email_address] || session[:pending_email_address] || pending_email_address
+
+    if code.blank? || email.blank?
+      respond_to do |format|
+        format.html { redirect_to new_signup_magic_link_path, alert: "Enter the code we emailed you." }
+        format.json { render json: { message: "Enter the code we emailed you." }, status: :unauthorized }
+      end
+      return
+    end
+
+    record = EmailCode.authenticate(email, code)
+
+    if record
+      email_address = record.email_address
+      record.consume!
+      identity = Identity.find_or_create_by!(email_address: email_address)
+      start_new_session_for identity
+      session.delete(:signup_email_address)
+      session.delete(:pending_email_address)
+      cookies.delete(:pending_authentication_token)
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path }
+        format.json { render json: { session_token: Current.session.signed_id }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_signup_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def redirect_authenticated_user
+      redirect_to new_signup_completion_path if authenticated?
+    end
+
+    def enforce_tenant_limit
+      redirect_to new_session_url unless Account.accepting_signups?
+    end
+end
