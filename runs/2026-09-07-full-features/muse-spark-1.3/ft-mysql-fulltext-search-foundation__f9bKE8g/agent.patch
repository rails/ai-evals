@@ -0,0 +1,28 @@
+module SearchesHelper
+  def highlight_search_terms(text, terms)
+    plain = text.to_s
+    cleaned_terms = Array(terms).map(&:to_s).reject(&:blank?)
+
+    if plain.blank? || cleaned_terms.blank?
+      return ERB::Util.html_escape(plain)
+    end
+
+    escaped = ERB::Util.html_escape(plain)
+    sorted = cleaned_terms.sort_by { |term| -term.length }
+    pattern = sorted.map { |term| Regexp.escape(term) }.join("|")
+
+    return escaped if pattern.blank?
+
+    escaped.gsub(/(#{pattern})/i) { "<mark>#{$1}</mark>" }.html_safe
+  end
+
+  def search_matching_comments(card, terms)
+    cleaned_terms = Array(terms).map(&:to_s).reject(&:blank?).map(&:downcase)
+    return [] if cleaned_terms.blank?
+
+    card.comments.select do |comment|
+      body = comment.body.to_plain_text.to_s.downcase
+      cleaned_terms.any? { |term| body.include?(term) }
+    end
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7b5055c
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<%= form_with url: search_path, method: :get, data: { turbo_action: "advance" } do |form| %>
+  <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true %>
+  <%= form.submit "Search" %>
+<% end %>
+
+<% if @terms.any? %>
+  <div id="search-results">
+    <% if @cards.any? %>
+      <% @cards.each do |card| %>
+        <article id="<%= dom_id(card, :search_result) %>">
+          <h2><%= link_to highlight_search_terms(card.title, @terms), card_path(card) %></h2>
+          <p>in <%= h card.board.name %></p>
+          <% description_text = card.description.to_plain_text.to_s %>
+          <% if description_text.present? %>
+            <p><%= highlight_search_terms(description_text, @terms) %></p>
+          <% end %>
+          <% search_matching_comments(card, @terms).each do |comment| %>
+            <blockquote><%= highlight_search_terms(comment.body.to_plain_text.to_s, @terms) %></blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    <% else %>
+      <p>No cards found</p>
+    <% end %>
+  </div>
+<% end %>
