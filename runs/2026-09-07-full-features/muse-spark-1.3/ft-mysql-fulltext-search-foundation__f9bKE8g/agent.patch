+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,53 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+
+    @cards = if @terms.any?
+      search_scope.reverse_chronologically.distinct
+    else
+      Card.none
+    end
+
+    # Preload associations needed for rendering without N+1.
+    @cards = @cards.preload(:board, :column, creator: :identity).with_rich_text_description.preload(comments: :rich_text_body)
+  end
+
+  private
+    def search_scope
+      base = Current.user.accessible_cards.published
+
+      conditions = []
+      binds = []
+
+      @terms.each do |term|
+        like = "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase)}%"
+
+        conditions << <<~SQL.squish
+          (
+            LOWER(cards.title) LIKE ?
+            OR EXISTS (
+              SELECT 1 FROM action_text_rich_texts
+              WHERE action_text_rich_texts.record_type = 'Card'
+                AND action_text_rich_texts.name = 'description'
+                AND action_text_rich_texts.record_id = cards.id
+                AND LOWER(action_text_rich_texts.body) LIKE ?
+            )
+            OR EXISTS (
+              SELECT 1 FROM comments
+              INNER JOIN action_text_rich_texts AS comment_bodies
+                ON comment_bodies.record_type = 'Comment'
+                AND comment_bodies.name = 'body'
+                AND comment_bodies.record_id = comments.id
+              WHERE comments.card_id = cards.id
+                AND LOWER(comment_bodies.body) LIKE ?
+            )
+          )
+        SQL
+
+        binds.concat([ like, like, like ])
+      end
+
+      base.where(conditions.join(" OR "), *binds)
+    end
+end
