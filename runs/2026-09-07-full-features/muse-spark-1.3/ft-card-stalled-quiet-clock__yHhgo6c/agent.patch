diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..2409b5c
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,120 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+
+  included do
+    scope :stalled, -> {
+      where("#{table_name}.last_active_at <= ?", STALLED_INACTIVITY_PERIOD.ago).where(id: burst_card_ids)
+    }
+  end
+
+  class_methods do
+    def burst_card_ids
+      assigned_ids = Assignment.distinct.pluck(:card_id)
+      assigned_event_ids = Event.where(action: "card_assigned", eventable_type: "Card").distinct.pluck(:eventable_id)
+      reopened_ids = Event.where(action: "card_reopened", eventable_type: "Card").distinct.pluck(:eventable_id)
+
+      known_ids = (assigned_ids + assigned_event_ids + reopened_ids).uniq
+
+      comment_burst_ids = comment_burst_card_ids(excluding: known_ids)
+
+      (known_ids + comment_burst_ids).uniq
+    end
+
+    def comment_burst_card_ids(excluding: [])
+      cutoff = STALLED_INACTIVITY_PERIOD.ago
+
+      scope = Card.where(last_active_at: ..cutoff)
+      scope = scope.where.not(id: excluding) if excluding.any?
+
+      ids = []
+
+      scope.find_each do |card|
+        if card.comment_burst?
+          ids << card.id
+        end
+      end
+
+      ids
+    end
+  end
+
+  def stalled?
+    if last_active_at.present? && burst?
+      last_active_at <= STALLED_INACTIVITY_PERIOD.ago
+    else
+      false
+    end
+  end
+
+  def burst?
+    if assigned_burst?
+      true
+    elsif reopened_burst?
+      true
+    else
+      comment_burst?
+    end
+  end
+
+  def comment_burst?
+    window = burst_window
+
+    if window.nil? || window <= 0
+      false
+    else
+      timestamps = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+
+      if timestamps.size >= BURST_COMMENT_COUNT
+        comment_burst_in_window?(timestamps, window)
+      else
+        false
+      end
+    end
+  end
+
+  def burst_window
+    period = board.auto_postpone_period
+
+    if period.present?
+      period.to_f / 3
+    end
+  end
+
+  def assigned_burst?
+    if assignments.exists?
+      true
+    else
+      events.where(action: "card_assigned").exists?
+    end
+  end
+
+  def reopened_burst?
+    events.where(action: "card_reopened").exists?
+  end
+
+  private
+    def comment_burst_in_window?(timestamps, window)
+      timestamps.each_with_index do |(time, _creator), i|
+        creators = []
+        count = 0
+
+        timestamps[i..].each do |other_time, other_creator|
+          if other_time - time <= window
+            count += 1
+            creators |= [ other_creator ]
+
+            if count >= BURST_COMMENT_COUNT && creators.size >= 2
+              return true
+            end
+          else
+            break
+          end
+        end
+      end
+
+      false
+    end
+end
