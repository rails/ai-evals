+    # Hourly sweep. Processes due cards in small per-period batches so each
+    # query can use the (status, last_active_at) index with a constant cutoff
+    # instead of a per-row datetime() computation (which forces a full scan).
+    def auto_postpone_all_due(now = Time.now)
+      system_users = {}
+
+      postpone = lambda do |scope|
+        scope.find_each(batch_size: 500) do |card|
+          system_users[card.account_id] ||= User.find_by(account_id: card.account_id, role: :system) || card.account.system_user
+          card.auto_postpone(user: system_users[card.account_id])
+        rescue ActiveRecord::RecordNotUnique, ActiveRecord::RecordInvalid
+          # Another overlapping sweep (or concurrent resume) already postponed this card.
+          next
+        end
+      end
+
+      Entropy::AUTO_POSTPONE_PERIODS_IN_SECONDS.each do |period|
+        cutoff = now - period
+
+        # Boards with an explicit entropy row for this period.
+        postpone.call(
+          active.joins(board: :entropy)
+            .where(entropies: { auto_postpone_period: period })
+            .where("cards.last_active_at <= ?", cutoff)
+        )
+
+        # Boards without entropy inherit their account's entropy.
+        postpone.call(
+          active.joins(board: :account)
+            .left_outer_joins(board: :entropy)
+            .joins(ACCOUNT_ENTROPY_JOIN)
+            .where(entropies: { id: nil })
+            .where(account_entropies: { auto_postpone_period: period })
+            .where("cards.last_active_at <= ?", cutoff)
+        )
       end
+
+      # Fallback when neither board nor account entropy exists.
+      default_cutoff = now - Entropy::DEFAULT_AUTO_POSTPONE_PERIOD_IN_DAYS.days.to_i
+      postpone.call(
+        active.joins(board: :account)
+          .left_outer_joins(board: :entropy)
+          .joins(ACCOUNT_ENTROPY_JOIN)
+          .where(entropies: { id: nil })
+          .where(account_entropies: { id: nil })
+          .where("cards.last_active_at <= ?", default_cutoff)
+      )
     end
   end
 
