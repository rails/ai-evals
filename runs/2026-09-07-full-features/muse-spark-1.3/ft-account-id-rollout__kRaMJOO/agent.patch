diff --git a/config/initializers/account_tenancy.rb b/config/initializers/account_tenancy.rb
new file mode 100644
index 0000000..d599e34
--- /dev/null
+++ b/config/initializers/account_tenancy.rb
@@ -0,0 +1,33 @@
+# Multi-tenant account_id on framework tables (ActiveStorage / ActionText).
+# These tables hold an account's data and must be account-scoped like the rest.
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, optional: false, default: -> { attachment_account }
+
+  private
+    def attachment_account
+      # record may be Card/Comment/Board/User/Export/Account::Import/ActionText::RichText.
+      # Global records (e.g. Identity avatars) have no account; fall back to request tenant.
+      record&.try(:account) || Current.account
+    end
+end
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, optional: false, default: -> { Current.account }
+
+  before_validation :assign_account_from_current, on: :create, if: -> { account_id.blank? }
+
+  private
+    def assign_account_from_current
+      # When blobs are created via direct upload, Current.account carries the tenant.
+      self.account ||= Current.account
+    end
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, optional: false, default: -> { blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, optional: false, default: -> { record&.try(:account) || Current.account }
+end
