diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..1c4fb6f
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,286 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  connect() {
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoverContainer = null
+
+    this.handleDragStart = this.handleDragStart.bind(this)
+    this.handleDragOver = this.handleDragOver.bind(this)
+    this.handleDragEnter = this.handleDragEnter.bind(this)
+    this.handleDragLeave = this.handleDragLeave.bind(this)
+    this.handleDrop = this.handleDrop.bind(this)
+    this.handleDragEnd = this.handleDragEnd.bind(this)
+
+    this.element.addEventListener("dragstart", this.handleDragStart)
+    this.element.addEventListener("dragover", this.handleDragOver)
+    this.element.addEventListener("dragenter", this.handleDragEnter)
+    this.element.addEventListener("dragleave", this.handleDragLeave)
+    this.element.addEventListener("drop", this.handleDrop)
+    this.element.addEventListener("dragend", this.handleDragEnd)
+
+    this.makeCardsDraggable()
+    this.observeMutations()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.handleDragStart)
+    this.element.removeEventListener("dragover", this.handleDragOver)
+    this.element.removeEventListener("dragenter", this.handleDragEnter)
+    this.element.removeEventListener("dragleave", this.handleDragLeave)
+    this.element.removeEventListener("drop", this.handleDrop)
+    this.element.removeEventListener("dragend", this.handleDragEnd)
+
+    if (this._observer) {
+      this._observer.disconnect()
+      this._observer = null
+    }
+  }
+
+  // Actions (also usable via data-action if wired)
+  dragstart(event) {
+    this.handleDragStart(event)
+  }
+
+  dragover(event) {
+    this.handleDragOver(event)
+  }
+
+  dragenter(event) {
+    this.handleDragEnter(event)
+  }
+
+  dragleave(event) {
+    this.handleDragLeave(event)
+  }
+
+  drop(event) {
+    this.handleDrop(event)
+  }
+
+  dragend(event) {
+    this.handleDragEnd(event)
+  }
+
+  handleDragStart(event) {
+    const card = event.target.closest?.(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedItem = card
+    this.sourceContainer = card.closest("section.cards")
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", card.id || "card")
+      } catch (_e) {
+        // Some browsers restrict setData
+      }
+    }
+
+    // Add dim class on next frame so drag image is not affected
+    requestAnimationFrame(() => {
+      if (this.draggedItem) {
+        this.draggedItem.classList.add("drag-and-drop__dragged-item")
+      }
+    })
+  }
+
+  handleDragEnter(event) {
+    const container = event.target.closest?.("section.cards")
+    if (!container || !this.element.contains(container)) return
+    if (!this.draggedItem) return
+    if (container === this.sourceContainer) return
+
+    event.preventDefault()
+  }
+
+  handleDragOver(event) {
+    const container = event.target.closest?.("section.cards")
+    if (!container || !this.element.contains(container)) return
+    if (!this.draggedItem) return
+
+    // Columns keep their own order — no reordering within the same column
+    if (container === this.sourceContainer) {
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "none"
+      return
+    }
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    if (this.hoverContainer !== container) {
+      this.clearHover()
+      this.hoverContainer = container
+      container.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  handleDragLeave(event) {
+    const container = event.target.closest?.("section.cards")
+    if (!container) return
+    // Only clear when truly leaving the container
+    if (event.relatedTarget && container.contains(event.relatedTarget)) return
+
+    container.classList.remove("drag-and-drop__hover-container")
+    if (this.hoverContainer === container) {
+      this.hoverContainer = null
+    }
+  }
+
+  handleDrop(event) {
+    const container = event.target.closest?.("section.cards")
+    if (!container || !this.draggedItem) return
+
+    // Ignore drops within the same column
+    if (container === this.sourceContainer) {
+      this.clearHover()
+      return
+    }
+
+    event.preventDefault()
+    event.stopPropagation()
+
+    const card = this.draggedItem
+
+    // Optimistic move: board is already the way you left it on drop.
+    // Insert at the top to match server ordering (latest first).
+    const list = container.querySelector(".cards__list")
+    if (list) {
+      list.prepend(card)
+    } else {
+      container.appendChild(card)
+    }
+
+    // Fire-and-forget save: no waiting, nothing re-rendered afterwards (JSON).
+    this.saveMove(card, container)
+
+    card.classList.remove("drag-and-drop__dragged-item")
+    this.clearHover()
+    this.draggedItem = null
+    this.sourceContainer = null
+  }
+
+  handleDragEnd(_event) {
+    if (this.draggedItem) {
+      this.draggedItem.classList.remove("drag-and-drop__dragged-item")
+    }
+    this.clearHover()
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoverContainer = null
+  }
+
+  clearHover() {
+    if (this.hoverContainer) {
+      this.hoverContainer.classList.remove("drag-and-drop__hover-container")
+      this.hoverContainer = null
+    }
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach((el) => {
+      el.classList.remove("drag-and-drop__hover-container")
+    })
+  }
+
+  saveMove(card, container) {
+    const { url, method, body, query } = this.requestFor(card, container)
+    if (!url) return
+
+    try {
+      if (method === "delete") {
+        destroy(url, { responseKind: "json" }).catch(() => {})
+      } else {
+        const options = { responseKind: "json" }
+        if (query) options.query = query
+        if (body) options.body = body
+        post(url, options).catch(() => {})
+      }
+    } catch (_e) {
+      // Fire-and-forget: never block the UI
+    }
+  }
+
+  requestFor(card, container) {
+    const info = this.destinationFor(container)
+    const triageUrl = card.dataset.cardTriageUrl
+    const notNowUrl = card.dataset.cardNotNowUrl
+    const closureUrl = card.dataset.cardClosureUrl
+
+    if (info.type === "column") {
+      if (triageUrl && info.columnId) {
+        return { url: triageUrl, method: "post", query: { column_id: info.columnId } }
+      }
+    } else if (info.type === "maybe") {
+      if (triageUrl) {
+        return { url: triageUrl, method: "delete" }
+      }
+    } else if (info.type === "not-now") {
+      if (notNowUrl) {
+        return { url: notNowUrl, method: "post" }
+      }
+    } else if (info.type === "closed") {
+      if (closureUrl) {
+        return { url: closureUrl, method: "post" }
+      }
+    }
+
+    return {}
+  }
+
+  destinationFor(container) {
+    const dataset = container.dataset || {}
+    let type = dataset.columnType || dataset.dropType || dataset.dragAndDropType
+    let columnId = dataset.columnId || dataset.columnID || dataset.dragAndDropColumnId
+
+    if (!type) {
+      const id = container.id
+      if (id === "maybe") {
+        type = "maybe"
+      } else if (id === "not-now") {
+        type = "not-now"
+      } else if (id === "closed-cards") {
+        type = "closed"
+      } else if (columnId) {
+        type = "column"
+      } else {
+        // Regular columns use dom_id(column) — treat any other section as a column
+        // and try to resolve the column id from explicit data or leave for caller.
+        type = "column"
+      }
+    }
+
+    return { type, columnId }
+  }
+
+  makeCardsDraggable() {
+    this.element.querySelectorAll(".card").forEach((card) => {
+      if (card.getAttribute("draggable") !== "true") {
+        card.setAttribute("draggable", "true")
+      }
+    })
+  }
+
+  observeMutations() {
+    if (typeof MutationObserver === "undefined") return
+
+    this._observer = new MutationObserver((mutations) => {
+      let needsUpdate = false
+      for (const mutation of mutations) {
+        for (const node of mutation.addedNodes) {
+          if (node.nodeType !== Node.ELEMENT_NODE) continue
+          if (node.classList?.contains("card") || node.querySelector?.(".card")) {
+            needsUpdate = true
+            break
+          }
+        }
+        if (needsUpdate) break
+      }
+      if (needsUpdate) this.makeCardsDraggable()
+    })
+
+    this._observer.observe(this.element, { childList: true, subtree: true })
+  }
+}
