diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..95276e1
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,32 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    validates :public_key, uniqueness: true, allow_nil: true
+  end
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+
+  def publish!
+    return if published?
+    update!(public_key: self.class.generate_public_key)
+  end
+
+  def unpublish!
+    update!(public_key: nil) if published?
+  end
+
+  def public_url
+    return nil unless published?
+    "#{account.slug}/public/boards/#{public_key}"
+  end
+
+  class_methods do
+    def generate_public_key
+      SecureRandom.hex(16)
+    end
+  end
+end
