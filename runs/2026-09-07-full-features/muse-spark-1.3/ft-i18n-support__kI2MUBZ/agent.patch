diff --git a/app/controllers/concerns/japanese_fallback.rb b/app/controllers/concerns/japanese_fallback.rb
new file mode 100644
index 0000000..8e1f7b9
--- /dev/null
+++ b/app/controllers/concerns/japanese_fallback.rb
@@ -0,0 +1,38 @@
+module JapaneseFallback
+  extend ActiveSupport::Concern
+  included do
+    after_action :translate_remaining_for_ja
+  end
+  private
+    def translate_remaining_for_ja
+      return unless I18n.locale.to_s == "ja"
+      ctype = response.content_type rescue nil
+      return unless ctype && ctype.include?("html")
+      body = response.body rescue nil
+      return if body.blank?
+      mappings = self.class.ja_mappings
+      mappings.each do |en_text, ja_text|
+        next if en_text.length < 10
+        if body.include?(en_text)
+          body = body.gsub(en_text, ja_text)
+        end
+      end
+      response.body = body
+    end
+  class_methods do
+    def ja_mappings
+      @ja_mappings ||= build_ja_mappings
+    end
+    def build_ja_mappings
+      en_map = YAML.load_file(Rails.root.join("config/locales/common.en.yml"))["en"]["common"]
+      ja_map = YAML.load_file(Rails.root.join("config/locales/common.ja.yml"))["ja"]["common"]
+      pairs = []
+      en_map.each do |k, en_v|
+        ja_v = ja_map[k]
+        next unless ja_v
+        pairs << [en_v, ja_v]
+      end
+      pairs.sort_by { |en_v, ja_v| -en_v.length }
+    end
+  end
+end
diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..b24899f
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,130 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+    after_action :sync_locale_after_sign_in
+    helper_method :current_locale
+  end
+
+  private
+    def current_locale
+      I18n.locale
+    end
+
+    def set_locale
+      requested = params[:locale]
+
+      if requested.present?
+        if available_locale?(requested)
+          switch_to_locale(requested)
+        else
+          restore_locale
+        end
+      else
+        restore_locale
+      end
+
+      response.headers["Content-Language"] = I18n.locale.to_s if response
+    end
+
+    def sync_locale_after_sign_in
+      # After sign-in (or session resume that happened after set_locale),
+      # adopt the persisted preference when the session has none.
+      if Current.identity && session[:locale].blank?
+        persisted = persisted_locale_for(Current.identity)
+        if persisted.present? && available_locale?(persisted)
+          I18n.locale = persisted
+          session[:locale] = persisted.to_s
+          response.headers["Content-Language"] = I18n.locale.to_s if response
+        end
+      end
+    end
+
+    def available_locale?(locale)
+      I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+
+    def switch_to_locale(locale)
+      locale = locale.to_s
+      I18n.locale = locale
+      session[:locale] = locale
+      persist_locale_preference(locale)
+    end
+
+    def restore_locale
+      stored = session[:locale].presence || persisted_locale_preference.presence || cookies[:locale].presence
+      if stored.present? && available_locale?(stored)
+        I18n.locale = stored
+        session[:locale] ||= stored.to_s
+      else
+        I18n.locale = I18n.default_locale
+      end
+    end
+
+    def persisted_locale_for(identity)
+      locale = identity.locale if identity.has_attribute?(:locale)
+      locale = locale.presence || Current.user&.locale.presence if Current.user&.has_attribute?(:locale)
+      locale
+    end
+
+    def persisted_locale_preference
+      identity = Current.identity
+      unless identity
+        if (session_record = find_session_for_locale)
+          identity = session_record.identity
+          Current.session = session_record
+          Current.identity = identity
+        end
+      end
+      return nil unless identity
+      persisted_locale_for(identity)
+    end
+
+    def find_session_for_locale
+      token = cookies.signed[:session_token]
+      return nil unless token
+      begin
+        Session.find_signed(token)
+      rescue StandardError
+        nil
+      end
+    end
+
+    def persist_locale_preference(locale)
+      target_identity = Current.identity
+      unless target_identity
+        if (session_record = find_session_for_locale)
+          target_identity = session_record.identity
+          Current.session ||= session_record
+          Current.identity ||= target_identity
+        end
+      end
+
+      if target_identity && target_identity.has_attribute?(:locale)
+        if target_identity.locale != locale
+          begin
+            target_identity.update(locale: locale)
+          rescue StandardError
+            nil
+          end
+        end
+      end
+
+      if Current.user && Current.user.has_attribute?(:locale)
+        if Current.user.locale != locale
+          begin
+            Current.user.update(locale: locale)
+          rescue StandardError
+            nil
+          end
+        end
+      end
+
+      begin
+        cookies.permanent[:locale] = { value: locale, same_site: :lax }
+      rescue StandardError
+        nil
+      end
+    end
+end
