--- a/app/mailers/application_mailer.rb
+++ b/app/mailers/application_mailer.rb
@@ -13,4 +13,27 @@ class ApplicationMailer < ActionMailer::Base
         super
       end
     end
+
+    def recipient_locale(recipient)
+      locale = nil
+      if recipient
+        if recipient.respond_to?(:locale) && recipient.locale.present?
+          locale = recipient.locale
+        elsif recipient.respond_to?(:identity) && recipient.identity&.locale.present?
+          locale = recipient.identity.locale
+        elsif recipient.is_a?(Identity) && recipient.locale.present?
+          locale = recipient.locale
+        end
+      end
+      locale = locale.to_s if locale
+      if locale.present? && I18n.available_locales.map(&:to_s).include?(locale)
+        locale.to_sym
+      else
+        I18n.locale.presence_in(I18n.available_locales.map(&:to_s))&.to_sym || I18n.default_locale
+      end
+    end
+
+    def with_recipient_locale(recipient, &block)
+      I18n.with_locale(recipient_locale(recipient), &block)
+    end
 end
