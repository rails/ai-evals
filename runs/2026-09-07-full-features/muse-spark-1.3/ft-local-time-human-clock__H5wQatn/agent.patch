diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c24d135 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,63 @@
 module TimeHelper
+  # Render a timestamp for client-side formatting in the viewer's own timezone.
+  #
+  # The server emits the raw UTC timestamp in a <time> element; a Stimulus
+  # controller (`local-time`) turns it into words in the browser. Because the
+  # HTML no longer contains timezone-specific strings, it can be cached and
+  # shared between people in different timezones.
+  #
+  # Supported formats:
+  #   time            "1:42 PM"
+  #   date            "Sep 12" (with year when outside the current year)
+  #   date-with-year  "Sep 12, 2025"
+  #   weekday-date    "Monday, September 8"
+  #   datetime        "9/8/25, 1:42 PM"
+  #   comment         smart: "1:42 PM" today, "yesterday", "5 days ago", "Sep 12"
+  #   relative        smart: "just now", "5 minutes ago", "2 hours ago",
+  #                   "yesterday", "5 days ago", "Sep 12", "in 3 days", "tomorrow"
+  #   future          "today", "tomorrow", "in 3 days"
+  def local_time(time, format: :relative, **options)
+    return "" if time.nil?
+
+    utc_time = time.utc
+    iso = utc_time.iso8601
+    fallback = local_time_fallback(utc_time, format.to_s.tr("_", "-"))
+
+    data = options.delete(:data) || {}
+    data[:controller] = [ data[:controller], "local-time" ].compact.join(" ").strip
+    data[:local_time_format_value] = format.to_s.tr("_", "-").dasherize
+    data[:local_time_datetime_value] = iso
+
+    tag.time fallback, datetime: iso, title: iso, data: data, **options
+  end
+
+  private
+    def local_time_fallback(utc_time, format)
+      case format
+      when "time"
+        utc_time.strftime("%l:%M %p").strip
+      when "date"
+        local_time_date_fallback(utc_time)
+      when "date-with-year"
+        utc_time.strftime("%b %-d, %Y")
+      when "weekday-date"
+        utc_time.strftime("%A, %B %-d")
+      when "datetime"
+        utc_time.strftime("%-m/%-d/%y, %-l:%M %p").strip
+      when "comment", "relative", "future"
+        # Absolute UTC fallback so cached HTML doesn't go stale as
+        # relative words ("2 hours ago") age. JS replaces this on connect.
+        local_time_date_fallback(utc_time)
+      else
+        local_time_date_fallback(utc_time)
+      end
+    end
+
+    def local_time_date_fallback(utc_time)
+      if utc_time.year == Time.now.utc.year
+        utc_time.strftime("%b %-d")
+      else
+        utc_time.strftime("%b %-d, %Y")
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..fb8c0db
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,175 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = { format: String, datetime: String }
+
+  connect() {
+    this.render()
+
+    // Re-render when Turbo morphs attributes in place without reconnecting.
+    this.#observer = new MutationObserver(() => this.render())
+    this.#observer.observe(this.element, { attributes: true, attributeFilter: [ "datetime", "data-local-time-datetime-value", "data-local-time-format-value" ] })
+  }
+
+  disconnect() {
+    this.#observer?.disconnect()
+  }
+
+  // Re-render when morphed in place (Turbo morphing updates attributes
+  // without reconnecting the controller).
+  render() {
+    const date = this.#date
+    if (!date || isNaN(date)) return
+
+    const now = new Date()
+    const text = this.#format(date, now)
+    if (text) this.element.textContent = text
+
+    const title = this.#fullTitle(date)
+    if (title) this.element.setAttribute("title", title)
+  }
+
+  get #date() {
+    const raw = this.hasDatetimeValue && this.datetimeValue
+      ? this.datetimeValue
+      : this.element.getAttribute("datetime")
+    if (!raw) return null
+    return new Date(raw)
+  }
+
+  #format(date, now) {
+    switch ((this.formatValue || "relative").replace(/_/g, "-")) {
+      case "time": return formatTime(date)
+      case "date": return formatDate(date, now)
+      case "date-with-year": return formatDateWithYear(date)
+      case "weekday-date": return formatWeekdayDate(date)
+      case "datetime": return formatDateTime(date)
+      case "comment": return formatComment(date, now)
+      case "relative": return formatRelative(date, now)
+      case "future": return formatFuture(date, now)
+      default: return formatRelative(date, now)
+    }
+  }
+
+  #fullTitle(date) {
+    try {
+      return new Intl.DateTimeFormat("en-US", {
+        weekday: "long", year: "numeric", month: "long", day: "numeric",
+        hour: "numeric", minute: "2-digit"
+      }).format(date)
+    } catch {
+      return null
+    }
+  }
+
+  #observer
+}
+
+export function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    hour: "numeric", minute: "2-digit", hour12: true
+  }).format(date)
+}
+
+export function formatDate(date, now = new Date()) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return new Intl.DateTimeFormat("en-US", {
+      month: "short", day: "numeric"
+    }).format(date)
+  } else {
+    return formatDateWithYear(date)
+  }
+}
+
+export function formatDateWithYear(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    month: "short", day: "numeric", year: "numeric"
+  }).format(date)
+}
+
+export function formatWeekdayDate(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    weekday: "long", month: "long", day: "numeric"
+  }).format(date)
+}
+
+export function formatDateTime(date) {
+  const datePart = `${date.getMonth() + 1}/${date.getDate()}/${String(date.getFullYear()).slice(-2)}`
+  return `${datePart}, ${formatTime(date)}`
+}
+
+// A comment from two hours ago reads "1:42 PM"; one from last night reads
+// "yesterday"; one from earlier in the week reads "5 days ago" or "Sep 12".
+export function formatComment(date, now = new Date()) {
+  const days = signedDifferenceInDays(date, now)
+
+  if (days <= 0) {
+    // Today (or clock skew into the future): show the time of day.
+    if (isSameDay(date, now)) return formatTime(date)
+    return formatDate(date, now)
+  }
+  if (days === 1) return "yesterday"
+  if (days <= 6) return `${days} days ago`
+  return formatDate(date, now)
+}
+
+// Past: "just now", "5 minutes ago", "2 hours ago", "yesterday",
+// "5 days ago", "Sep 12". Future: "tomorrow", "in 3 days", "in 2 hours".
+export function formatRelative(date, now = new Date()) {
+  const diffMs = date - now
+  const absMs = Math.abs(diffMs)
+  const days = signedDifferenceInDays(now, date) // negative when date is past
+
+  if (absMs < 60 * 1000) return "just now"
+
+  if (absMs < 60 * 60 * 1000) {
+    const minutes = Math.round(absMs / (60 * 1000))
+    if (diffMs < 0) return minutes === 1 ? "1 minute ago" : `${minutes} minutes ago`
+    return minutes === 1 ? "in 1 minute" : `in ${minutes} minutes`
+  }
+
+  // Within the same calendar day, speak in hours.
+  if (isSameDay(date, now) && absMs < 24 * 60 * 60 * 1000) {
+    const hours = Math.round(absMs / (60 * 60 * 1000))
+    if (diffMs < 0) return hours === 1 ? "1 hour ago" : `${hours} hours ago`
+    return hours === 1 ? "in 1 hour" : `in ${hours} hours`
+  }
+
+  if (days === 0) {
+    // Different day but less than 24h rounding edge: fall back to hours.
+    const hours = Math.max(1, Math.round(absMs / (60 * 60 * 1000)))
+    if (diffMs < 0) return hours === 1 ? "1 hour ago" : `${hours} hours ago`
+    return hours === 1 ? "in 1 hour" : `in ${hours} hours`
+  }
+
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days <= -2 && days >= -6) return `${-days} days ago`
+  if (days >= 2 && days <= 6) return `in ${days} days`
+  if (days < -6 || days > 6) return formatDate(date, now)
+
+  return formatDate(date, now)
+}
+
+// A card auto-closing overnight reads "tomorrow", further out "in 3 days".
+export function formatFuture(date, now = new Date()) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days <= 0) return "today"
+  if (days === 1) return "tomorrow"
+  return `in ${days} days`
+}
+
+export function isSameDay(a, b) {
+  return a.getFullYear() === b.getFullYear() &&
+    a.getMonth() === b.getMonth() &&
+    a.getDate() === b.getDate()
+}
+
+export function beginningOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+export function signedDifferenceInDays(fromDate, toDate) {
+  return Math.round((beginningOfDay(toDate) - beginningOfDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
