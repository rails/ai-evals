diff --git a/app/models/account/data_transfer/id_map.rb b/app/models/account/data_transfer/id_map.rb
new file mode 100644
index 0000000..d9e04c1
--- /dev/null
+++ b/app/models/account/data_transfer/id_map.rb
@@ -0,0 +1,26 @@
+# Records get new UUIDs when they're imported, since the archive may well be
+# read back into the very same installation it came from. Every UUID column is
+# run through the map, so associations keep pointing at the right records.
+class Account::DataTransfer::IdMap
+  def initialize
+    @ids = {}
+  end
+
+  def translate(id)
+    if id.present?
+      @ids[id] ||= ActiveRecord::Type::Uuid.generate
+    end
+  end
+
+  def record(old_id, new_id)
+    @ids[old_id] = new_id
+  end
+
+  def translated?(id)
+    @ids.key?(id)
+  end
+
+  def size
+    @ids.size
+  end
+end
