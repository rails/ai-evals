+class ExportMailer < ApplicationMailer
+  def completed(export)
+    @export = export
+    @account = export.account
+    @download_url = polymorphic_url(export, script_name: @account.slug)
+
+    mail to: recipient_for(export), subject: "Your #{@account.name} export is ready"
+  end
+
+  def failed(export)
+    @export = export
+    @account = export.account
+
+    mail to: recipient_for(export), subject: "Your #{@account.name} export couldn't be prepared"
+  end
+
+  private
+    def recipient_for(export)
+      export.creator.identity.email_address
+    end
+end
