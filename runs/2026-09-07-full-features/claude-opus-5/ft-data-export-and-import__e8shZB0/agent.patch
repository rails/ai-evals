+# The whole account in one ZIP: every record, every attachment, and every file.
+# It's the format Account::Import reads back in.
+class Account::Export < ::Export
+  def accessible_to?(user)
+    super || (user.present? && user.account_id == account_id && user.admin?)
+  end
+
+  private
+    def write_to(zip)
+      Account::DataTransfer::Manifest.new(account).export(zip)
+    end
+end
