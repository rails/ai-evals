     end
 
+    # Rich text bodies point at their attachments with signed global ids, so
+    # they have to be re-signed for the blobs the files were imported as.
+    def import_value(name, value, ids)
+      if name == "body"
+        rewrite_attachment_sgids value, ids
+      else
+        super
+      end
+    end
+
+    def rewrite_attachment_sgids(body, ids)
+      body&.gsub(SGID_PATTERN) do |attribute|
+        if sgid = translate_sgid($1, ids)
+          %(sgid="#{sgid}")
+        else
+          attribute
+        end
+      end
+    end
+
+    def translate_sgid(sgid, ids)
+      if (gid = SignedGlobalID.parse(sgid, for: "attachable")) && ids.translated?(gid.model_id)
+        SignedGlobalID.new(
+          URI::GID.build(app: GlobalID.app, model_name: gid.model_name, model_id: ids.translate(gid.model_id)),
+          for: "attachable"
+        ).to_s
+      end
+    rescue StandardError
+      nil
+    end
 end
