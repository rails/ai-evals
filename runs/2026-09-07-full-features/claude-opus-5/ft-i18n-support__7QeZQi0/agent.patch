--- /dev/null
+++ b/test/models/identity/localizable_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Identity::LocalizableTest < ActiveSupport::TestCase
+  test "no preferred locale by default" do
+    assert_nil identities(:kevin).locale
+  end
+
+  test "preferring a locale" do
+    identities(:kevin).prefer_locale "ja"
+
+    assert_equal :ja, identities(:kevin).reload.locale
+  end
+
+  test "preferring the locale already preferred doesn't touch the record" do
+    identities(:kevin).prefer_locale :ja
+
+    assert_no_changes -> { identities(:kevin).reload.updated_at } do
+      identities(:kevin).prefer_locale :ja
+    end
+  end
+
+  test "locales we don't offer are rejected" do
+    assert_raises ActiveRecord::RecordInvalid do
+      identities(:kevin).prefer_locale :xx
+    end
+  end
+
+  test "users speak the language of their identity" do
+    identities(:kevin).prefer_locale :ja
+
+    assert_equal :ja, users(:kevin).locale
+    assert_nil users(:david).locale
+  end
+end
