+require "test_helper"
+
+class Account::SeederTest < ActiveSupport::TestCase
+  test "seeding the playground board in English" do
+    board = seed_account.boards.first
+
+    assert_equal "Playground", board.name
+    assert_equal "First, rename this card", board.cards.last.title
+  end
+
+  test "seeding the playground board in Japanese" do
+    board = I18n.with_locale(:ja) { seed_account }.boards.first
+
+    assert_equal "遊び場", board.name
+    assert_equal "まず、このカードの名前を変える", board.cards.last.title
+  end
+
+  private
+    def seed_account
+      account = Account.create!(name: "Initech")
+      owner = account.users.create!(name: "Milton", role: :owner, identity: identities(:mike))
+
+      Account::Seeder.new(account, owner).seed
+      account
+    end
+end
diff --git a/test/models/identity/localizable_test.rb b/test/models/identity/localizable_test.rb
new file mode 100644
