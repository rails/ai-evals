@@ -0,0 +1,28 @@
+# Secrets defined here are available for reference under registry/password and
+# env/secret in config/deploy.yml. They're read from your environment, so
+# nothing sensitive is stored in the repo. DO NOT ENTER RAW CREDENTIALS HERE!
+# This file needs to be safe for git.
+#
+# Export these before deploying, e.g. by keeping them in a git-ignored .env
+# file and running `set -a && source .env && set +a`, or by fetching them from
+# a password manager (see the commented example at the bottom).
+
+# An access token for the registry in config/deploy.yml, not your password.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Generate once with `bin/rails secret` and keep it forever: changing it logs
+# everyone out.
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# The password for the SMTP_USER_NAME set in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Web push notifications. See docs/deployment.md for how to generate a pair.
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Or read them from a password manager, in as few calls as possible:
+#
+# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
