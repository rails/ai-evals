--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,131 @@
+# Fizzy on one box.
+#
+# This deploys Fizzy to a single Linux server running Docker: the web app,
+# the background jobs, the SQLite databases, and the uploaded files all live
+# in one container, and Kamal's proxy terminates SSL with an automatically
+# renewed Let's Encrypt certificate.
+#
+# Fill in the bits marked CHANGE ME below, add your secrets to .kamal/secrets,
+# and then run:
+#
+#   bin/kamal setup
+#
+# See docs/deployment.md for the full walkthrough.
+
+service: fizzy
+
+# Give the first boot room to create the SQLite databases and run migrations.
+deploy_timeout: 60
+
+# CHANGE ME: the name of the image Kamal builds and pushes for you.
+# For GitHub's registry that's ghcr.io/<your-github-user>/fizzy.
+image: your-user/fizzy
+
+# CHANGE ME: the server Fizzy runs on, by IP address or hostname.
+# One host, one role: web serves requests and, thanks to SOLID_QUEUE_IN_PUMA
+# below, also runs the background jobs.
+servers:
+  web:
+    - 192.168.0.1
+  # Outgrown a single container? Give the jobs their own on the same box and
+  # set SOLID_QUEUE_IN_PUMA to false below. They share the volume, so they
+  # keep talking to the same SQLite files.
+  #
+  # jobs:
+  #   hosts:
+  #     - 192.168.0.1
+  #   cmd: bin/jobs
+
+# CHANGE ME: the hostname people will use, e.g. fizzy.example.com.
+# Point its DNS A/AAAA record at the server before running kamal setup: the
+# proxy needs to answer on port 80 to get a Let's Encrypt certificate.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  healthcheck:
+    path: /up
+
+# CHANGE ME: where the image is pushed. Any registry will do, as long as the
+# server can pull from it. Use an access token, never your real password, and
+# keep it in .kamal/secrets.
+registry:
+  server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  # Match your server, not your laptop: amd64 for most cloud boxes,
+  # arm64 for Ampere/Graviton ones.
+  arch: amd64
+
+# Everything Fizzy needs to know about your installation. Anything sensitive
+# goes under secret: and is resolved from .kamal/secrets.
+env:
+  clear:
+    # Must match proxy/host above. Used for the links in emails and
+    # notifications, which have no request to infer a host from.
+    APP_HOST: fizzy.example.com
+
+    # One SQLite database per Rails role, all under /rails/storage.
+    DATABASE_ADAPTER: sqlite
+
+    # Uploaded files go on disk, in the same volume as the databases.
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Run Solid Queue inside Puma so jobs run on the box without a second
+    # container fighting over the same SQLite files.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Tune to taste. A small box is happy with a couple of Puma workers and
+    # a single job worker.
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+
+    # CHANGE ME: your mail server. Fizzy emails sign-in codes, so a working
+    # SMTP server is required to log in. SMTP_PASSWORD is a secret, below.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USER_NAME: fizzy@example.com
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    # Set for implicit TLS servers, usually on port 465.
+    # SMTP_TLS: true
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_DOMAIN: example.com
+
+  secret:
+    # Sessions and signed cookies. Generate one with `bin/rails secret`.
+    - SECRET_KEY_BASE
+
+    # The password for SMTP_USER_NAME above.
+    - SMTP_PASSWORD
+
+    # Web push notifications. Optional: comment out both here and in
+    # .kamal/secrets if you don't want them.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The one thing that must outlive a deploy: databases in
+# /rails/storage/production*.sqlite3 and uploads in
+# /rails/storage/production/files.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Keep serving the old version's assets while in-flight requests finish.
+asset_path: /rails/public/assets
+
+# Deploying to a single host, so restart it as soon as the new one is healthy.
+boot:
+  limit: 1
+  wait: 0
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  dbconsole: app exec --interactive --reuse "bin/rails dbconsole"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs --follow
+
+# Fizzy's image runs as an unprivileged user, so root on the server is only
+# needed for Docker itself. Set this if you SSH in as someone else.
+# ssh:
+#   user: deployer
