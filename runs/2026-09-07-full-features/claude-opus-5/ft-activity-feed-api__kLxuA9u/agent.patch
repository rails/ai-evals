diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..bfebc40 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -1,6 +1,11 @@
 module Event::Particulars
   extend ActiveSupport::Concern
 
+  ASSIGNMENT_ACTIONS   = %w[ card_assigned card_unassigned ]
+  BOARD_CHANGE_ACTIONS = %w[ card_board_changed card_collection_changed ]
+  TITLE_CHANGE_ACTIONS = %w[ card_title_changed ]
+  TRIAGE_ACTIONS       = %w[ card_triaged ]
+
   included do
     store_accessor :particulars, :assignee_ids
   end
@@ -8,4 +13,33 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  # The particulars of an event, normalized for public consumption.
+  def detailed_particulars
+    case action
+    when *ASSIGNMENT_ACTIONS
+      { assignee_ids: Array(assignee_ids) }
+    when *BOARD_CHANGE_ACTIONS
+      { old_board: old_board, new_board: new_board }
+    when *TITLE_CHANGE_ACTIONS
+      { old_title: particular(:old_title), new_title: particular(:new_title) }
+    when *TRIAGE_ACTIONS
+      { column: particular(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def old_board
+      particular(:old_board).presence || particular(:old_collection)
+    end
+
+    def new_board
+      particular(:new_board).presence || particular(:new_collection)
+    end
+
+    def particular(name)
+      particulars&.dig("particulars", name.to_s).to_s
+    end
 end
