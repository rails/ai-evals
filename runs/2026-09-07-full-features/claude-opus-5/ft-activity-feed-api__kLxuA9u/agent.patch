+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      events = Current.user.accessible_events.activity.preloaded.reverse_chronologically
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events
+    end
+
+    def creator_ids
+      @creator_ids ||= Array.wrap(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      @board_ids ||= Array.wrap(params[:board_ids]).compact_blank
+    end
+end
