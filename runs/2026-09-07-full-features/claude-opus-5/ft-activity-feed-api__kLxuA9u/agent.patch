@@ -0,0 +1,71 @@
+# Activities
+
+Activities are the events that happen in an account: cards added, moved, renamed, assigned, closed, and commented on. They're the same events shown in Fizzy's activity timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activities, newest first. Only activities from boards the current user can access are returned.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids` | array | No | Only return activities created by these users |
+| `board_ids` | array | No | Only return activities that happened on these boards |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;Plain text mentions&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcy",
+      "name": "Fizzy",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+`eventable` is the full [card](cards.md) or [comment](comments.md) the activity happened on, `board` is the full [board](boards.md), and `creator` is the full [user](users.md). They're abbreviated in the example above.
+
+`url` opens the card the activity happened on. For comment activities, it opens the card and jumps to the comment.
+
+`action` is one of:
+`card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, `comment_created`
+
+`particulars` carries the details of the action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Every other action returns an empty `particulars` object.
+
+__Filtering example:__
+
+```
+GET /897362094/activities?creator_ids[]=03f5v9zjw7pz8717a4no1h8a7&board_ids[]=03f5v9zkft4hj9qq0lsn9ohcy
+```
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..51a0886
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_assignment_jz).id }
+    assert_equal "card_assigned", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_match "assigned", activity["description"]
+    assert_match card_url(cards(:logo)), activity["url"]
+  end
+
+  test "index is ordered newest first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.collect { |activity| activity["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "comment activity links to the comment" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+  end
+
+  test "title changes are included with their particulars" do
+    event = nil
+    Current.set(user: users(:david)) do
+      cards(:logo).update!(title: "New logo")
+      event = Event.where(action: "card_title_changed").last
+    end
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_equal "The logo isn't big enough", activity.dig("particulars", "old_title")
+    assert_equal "New logo", activity.dig("particulars", "new_title")
+  end
+
+  test "collection changes are omitted" do
+    event = Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_collection_changed",
+      particulars: { particulars: { old_board: "Old", new_board: "New" } })
+
+    get activities_path, as: :json
+
+    assert_not @response.parsed_body.any? { |a| a["id"] == event.id }
+  end
+
+  test "filtering by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "filtering by board" do
+    get activities_path(board_ids: [ boards(:writebook).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("board", "id") == boards(:writebook).id }
+  end
+
+  test "only returns activity from accessible boards" do
+    card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "drafted")
+    event = Event.create!(board: boards(:private), creator: users(:kevin), eventable: card, action: "card_published")
+
+    logout_and_sign_in_as :jz
+    get activities_path, as: :json
+
+    assert_not @response.parsed_body.any? { |a| a["id"] == event.id }
+  end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
new file mode 100644
index 0000000..e75cdc6
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment particulars expose assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, event.detailed_particulars)
+  end
+
+  test "board change particulars expose the old and new board" do
+    event = build_event "card_board_changed", particulars: { old_board: "Writebook", new_board: "Fizzy" }
+
+    assert_equal({ old_board: "Writebook", new_board: "Fizzy" }, event.detailed_particulars)
+  end
+
+  test "title change particulars expose the old and new title" do
+    event = build_event "card_title_changed", particulars: { old_title: "Logo", new_title: "New logo" }
+
+    assert_equal({ old_title: "Logo", new_title: "New logo" }, event.detailed_particulars)
+  end
+
+  test "triage particulars expose the column" do
+    event = build_event "card_triaged", particulars: { column: "In progress" }
+
+    assert_equal({ column: "In progress" }, event.detailed_particulars)
+  end
+
+  test "missing particulars are returned as empty strings" do
+    assert_equal({ old_board: "", new_board: "" }, build_event("card_board_changed").detailed_particulars)
+    assert_equal({ old_title: "", new_title: "" }, build_event("card_title_changed").detailed_particulars)
+    assert_equal({ column: "" }, build_event("card_triaged").detailed_particulars)
+  end
+
+  test "other events have no particulars" do
+    assert_equal({}, events(:logo_published).detailed_particulars)
+    assert_equal({}, events(:layout_commented).detailed_particulars)
+  end
+
+  private
+    def build_event(action, particulars: nil)
+      Event.new \
+        action: action,
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: cards(:logo),
+        particulars: particulars ? { particulars: particulars } : {}
+    end
+end
