--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,147 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Moves cards across the columns of a board by dragging them.
+//
+// Every column keeps its own order, so dropping a card only changes its column or its
+// status, never its position within a column. The card is moved as soon as it's dropped and
+// the change is sent to the server in the background, so the board never shifts under the
+// pointer while the request is in flight. If the request fails, the card goes back to where
+// it was dragged from.
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  start(event) {
+    this.draggedCard = this.#cardFrom(event.target)
+
+    if (this.draggedCard) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", this.draggedCard.id)
+
+      // Deferred so the drag image pictures the card, not the dimmed one
+      requestAnimationFrame(() => this.draggedCard?.classList.add(this.draggedItemClass))
+    }
+  }
+
+  over(event) {
+    const column = this.#dropColumnFrom(event.target)
+
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#hover(column)
+    } else {
+      this.#stopHovering()
+    }
+  }
+
+  leave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#stopHovering()
+    }
+  }
+
+  drop(event) {
+    const card = this.draggedCard
+    const column = this.#dropColumnFrom(event.target)
+
+    if (column) {
+      event.preventDefault()
+      this.#move(card, column)
+    }
+
+    this.end()
+  }
+
+  end() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#stopHovering()
+  }
+
+  // Private
+
+  #cardFrom(element) {
+    return this.#closestTarget(element, "card")
+  }
+
+  // A card can only be dropped on a column other than the one it's being dragged from
+  #dropColumnFrom(element) {
+    const origin = this.#closestTarget(this.draggedCard, "column")
+    const column = this.#closestTarget(element, "column")
+
+    return origin && column !== origin ? column : null
+  }
+
+  #closestTarget(element, name) {
+    return element?.closest?.(`[data-${this.identifier}-target~="${name}"]`)
+  }
+
+  #hover(column) {
+    if (this.hoveredColumn !== column) {
+      this.#stopHovering()
+      this.hoveredColumn = column
+      this.hoveredColumn.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  #stopHovering() {
+    this.hoveredColumn?.classList.remove(this.hoverContainerClass)
+    this.hoveredColumn = null
+  }
+
+  async #move(card, column) {
+    const origin = { list: card.parentElement, nextCard: card.nextElementSibling }
+
+    this.#insert(card, column)
+
+    const response = await this.#relocate(card, column)
+    if (!response.ok) {
+      origin.list.insertBefore(card, origin.nextCard)
+    }
+  }
+
+  #insert(card, column) {
+    const list = column.querySelector(".cards__list")
+    const followingCard = this.#firstCardFollowing(card, list)
+
+    if (followingCard) {
+      followingCard.before(card)
+    } else {
+      list?.append(card)
+    }
+  }
+
+  // Columns list their golden cards first and the rest by recent activity, and a card is the
+  // most recently active one right after being moved
+  #firstCardFollowing(card, list) {
+    const cards = Array.from(list?.querySelectorAll(".card") || []).filter(other => other !== card)
+    return this.#golden(card) ? cards[0] : cards.find(other => !this.#golden(other))
+  }
+
+  #golden(card) {
+    return card.classList.contains("golden-effect")
+  }
+
+  #relocate(card, column) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = card.dataset
+    const { columnId, cardStatus } = column.dataset
+
+    switch (cardStatus) {
+      case "not_now":
+        return post(cardNotNowUrl, { responseKind: "json" })
+      case "closed":
+        return post(cardClosureUrl, { responseKind: "json" })
+      case "awaiting_triage":
+        return destroy(cardTriageUrl, { responseKind: "json" })
+      default:
+        return post(cardTriageUrl, { body: { column_id: columnId }, responseKind: "json" })
+    }
+  }
+}
