diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..34d15cf
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,135 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+  end
+
+  test "dragging a card into a column triages it" do
+    column = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+    drag_card_to dom_id(column)
+
+    assert_selector "##{dom_id(column)} ##{dom_id(@card, :article)}", visible: :all, wait: 0
+    assert_column_for @card, column
+  end
+
+  test "dragging a card into Not Now postpones it" do
+    visit board_url(@board)
+    drag_card_to "not-now"
+
+    assert_selector "#not-now ##{dom_id(@card, :article)}", visible: :all, wait: 0
+    assert_status_for @card, :postponed?
+  end
+
+  test "dragging a card into Done closes it" do
+    visit board_url(@board)
+    drag_card_to "closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(@card, :article)}", visible: :all, wait: 0
+    assert_status_for @card, :closed?
+  end
+
+  test "dragging a card back into Maybe sends it back to triage" do
+    @card = cards(:text)
+
+    visit board_url(@board)
+    expand_column dom_id(columns(:writebook_in_progress))
+    drag_card_to "maybe"
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}", wait: 0
+    assert_status_for @card, :awaiting_triage?
+  end
+
+  test "dragging a closed card into a column reopens it" do
+    @card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    visit board_url(@board)
+    expand_column "closed-cards"
+    drag_card_to dom_id(column)
+
+    assert_selector "##{dom_id(column)} ##{dom_id(@card, :article)}", visible: :all, wait: 0
+    assert_column_for @card, column
+    assert @card.reload.open?
+  end
+
+  test "dropping a card back into its own column leaves it alone" do
+    @card = cards(:text)
+    column = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+    expand_column dom_id(column)
+    drag_card_to dom_id(column)
+
+    assert_selector "##{dom_id(column)} ##{dom_id(@card, :article)}"
+    assert_column_for @card, column
+  end
+
+  test "the dragged card dims and the column under the pointer lights up" do
+    visit board_url(@board)
+    start_dragging_card_over "not-now"
+
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "#not-now.drag-and-drop__hover-container"
+  end
+
+  test "a card that can't be saved goes back where it was dragged from" do
+    visit board_url(@board)
+    break_the_not_now_url
+    drag_card_to "not-now"
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_not @card.reload.postponed?
+  end
+
+  private
+    def drag_card_to(column_id)
+      find("##{dom_id(@card, :article)}").drag_to find("##{column_id}"), html5: true
+    end
+
+    def start_dragging_card_over(column_id)
+      execute_script <<~JS
+        const dataTransfer = new DataTransfer()
+        document.getElementById("#{dom_id(@card, :article)}").dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+        document.getElementById("#{column_id}").dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def break_the_not_now_url
+      execute_script %(document.getElementById("#{dom_id(@card, :article)}").dataset.cardNotNowUrl = "/nonexistent")
+    end
+
+    def expand_column(column_id)
+      find(".cards__expander[aria-controls='#{column_id}']").click
+      assert_selector "##{dom_id(@card, :article)}"
+    end
+
+    def assert_column_for(card, column)
+      wait_for_card(card) { card.column == column }
+      assert_equal column, card.column
+    end
+
+    def assert_status_for(card, status)
+      wait_for_card(card) { card.public_send(status) }
+      assert card.public_send(status), "Expected the card to be #{status}"
+    end
+
+    # Cards move on the board right away, and the change is saved in the background
+    def wait_for_card(card)
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        loop do
+          break if yield card.reload
+          sleep 0.05
+        end
+      end
+    rescue Timeout::Error
+      # Let the assertion report what is wrong with the card
+    end
+end
