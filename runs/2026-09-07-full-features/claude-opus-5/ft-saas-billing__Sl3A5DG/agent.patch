+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  DEFAULT_CARD_LIMIT = 1_000
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    overridden_limit&.card_count || plan.card_limit
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def cards_remaining
+    [ card_limit - cards_count, 0 ].max unless unlimited_cards?
+  end
+
+  def exceeding_card_limit?
+    !unlimited_cards? && cards_remaining.zero?
+  end
+
+  def nearing_card_limit?
+    !unlimited_cards? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
