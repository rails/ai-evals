@@ -0,0 +1,53 @@
+<% @page_title = "Plans and billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Current plan</h2>
+        <div>
+          This account is on the <strong><%= @plan.title %></strong> plan<%= " (comped)" if @account.comped? %>.
+          <% if @account.unlimited_cards? %>
+            Unlimited cards and <%= number_to_human_size(@account.storage_limit) %> of storage.
+          <% else %>
+            <%= pluralize(@account.cards_remaining, "card") %> left of
+            <%= number_with_delimiter(@account.card_limit) %>, and
+            <%= number_to_human_size(@account.bytes_used) %> used of
+            <%= number_to_human_size(@account.storage_limit) %>.
+          <% end %>
+        </div>
+      </header>
+
+      <% if @account.paid? %>
+        <div class="flex gap-half align-center">
+          <%= button_to "Manage billing", saas.account_billing_portal_path, method: :post, class: "btn" %>
+        </div>
+      <% end %>
+    </section>
+
+    <% @plans.each do |plan| %>
+      <section class="settings__section">
+        <header>
+          <h2 class="divider"><%= plan.title %></h2>
+          <div>
+            <% if plan.paid? %>
+              <strong><%= number_to_currency(plan.price_in_dollars, precision: 0) %>/month</strong> —
+            <% else %>
+              <strong>Free</strong> —
+            <% end %>
+            <%= plan.unlimited_cards? ? "unlimited cards" : "#{number_with_delimiter(plan.card_limit)} cards" %>,
+            <%= number_to_human_size(plan.storage_limit) %> of storage.
+          </div>
+        </header>
+
+        <% if plan.paid? && plan != @plan %>
+          <%= button_to "Upgrade to #{plan.title}", saas.account_billing_checkouts_path(plan: plan.key), method: :post, class: "btn btn--link" %>
+        <% end %>
+      </section>
+    <% end %>
+  </div>
+</div>
