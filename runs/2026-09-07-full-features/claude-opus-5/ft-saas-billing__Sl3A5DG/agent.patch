+  test "exceeding the card limit once every included card is used" do
+    @account.update! cards_count: 1_000
+
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "nearing the card limit counts down from a hundred cards out" do
+    @account.update! cards_count: 900
+
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update! cards_count: 950
+
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "not nearing the card limit with room to spare" do
+    @account.update! cards_count: 899
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid accounts have unlimited cards" do
+    @account.create_subscription! stripe_customer_id: "cus_123", plan_key: "MonthlyV1", status: "active"
+    @account.update! cards_count: 10_000
+
+    assert @account.unlimited_cards?
+    assert_nil @account.card_limit
+    assert_nil @account.cards_remaining
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "comped accounts have unlimited cards" do
+    @account.comp
+    @account.update! cards_count: 10_000
+
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overridden limits replace the plan's card limit" do
+    @account.override_limits card_count: 5
+
+    assert_equal 5, @account.card_limit
+
+    @account.update! cards_count: 5
+
+    assert @account.exceeding_card_limit?
+  end
+end
