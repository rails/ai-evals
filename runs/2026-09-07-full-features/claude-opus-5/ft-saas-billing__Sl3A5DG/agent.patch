@@ -0,0 +1,16 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event.process
+    head :ok
+  rescue ::Billing::StripeEvent::SignatureError => error
+    logger.error "[Stripe] Rejected webhook: #{error.message}"
+    head :bad_request
+  end
+
+  private
+    def event
+      ::Billing::StripeEvent.verify payload: request.raw_post, signature: request.headers["Stripe-Signature"]
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..55c95b2
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,84 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_subscription_at_period_end
+    set_callback :reactivate, :after, :resume_subscription
+    set_callback :incinerate, :before, :cancel_subscription_now
+  end
+
+  def plan
+    if comped?
+      ::Subscription::MonthlyExtraStorageV1
+    else
+      active_subscription&.plan || ::Subscription.default
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.active?
+  end
+
+  def paid?
+    active_subscription.present?
+  end
+
+  def free?
+    !paid?
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comped=(value)
+    if ActiveModel::Type::Boolean.new.cast(value)
+      comp
+    else
+      uncomp
+    end
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    if billing_waiver
+      billing_waiver.destroy
+      reload_billing_waiver
+    end
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+  end
+
+  def reset_overridden_limits
+    if overridden_limit
+      overridden_limit.destroy
+      reload_overridden_limit
+    end
+  end
+
+  private
+    def cancel_subscription_at_period_end
+      subscription&.cancel_at_period_end
+    end
+
+    def resume_subscription
+      subscription&.resume if subscription&.canceling?
+    end
+
+    def cancel_subscription_now
+      subscription&.cancel_now
+    end
+end
