diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..011720b
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "completed checkout subscribes the account" do
+    post_webhook \
+      type: "checkout.session.completed",
+      data: { object: {
+        id: "cs_test_123",
+        customer: "cus_123",
+        subscription: "sub_123",
+        client_reference_id: @account.id,
+        metadata: { account_id: @account.id, plan_key: "MonthlyV1" }
+      } }
+
+    assert_response :success
+
+    subscription = @account.reload.subscription
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal Subscription::MonthlyV1, subscription.plan
+    assert @account.paid?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "subscription updates are recorded from the price" do
+    @account.create_subscription! stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active"
+
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra"
+
+    post_webhook \
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_123",
+        customer: "cus_123",
+        status: "active",
+        cancel_at: 1.week.from_now.to_i,
+        items: { data: [ { price: { id: "price_extra" }, current_period_end: 1.month.from_now.to_i } ] }
+      } }
+
+    assert_response :success
+
+    subscription = @account.reload.subscription
+    assert_equal Subscription::MonthlyExtraStorageV1, subscription.plan
+    assert subscription.canceling?
+    assert_equal 500.gigabytes, @account.storage_limit
+  ensure
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "deleted subscriptions fall back to the free plan" do
+    @account.create_subscription! stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active"
+
+    post_webhook \
+      type: "customer.subscription.deleted",
+      data: { object: { id: "sub_123", customer: "cus_123", status: "canceled" } }
+
+    assert_response :success
+    assert_not @account.reload.paid?
+    assert_equal Subscription::FreeV1, @account.plan
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "invoices record what's due next" do
+    @account.create_subscription! stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active"
+
+    post_webhook \
+      type: "invoice.upcoming",
+      data: { object: { customer: "cus_123", subscription: "sub_123", amount_due: 2_000 } }
+
+    assert_response :success
+    assert_equal 2_000, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "unsigned webhooks are refused" do
+    untenanted do
+      post "/stripe/webhooks", params: { type: "checkout.session.completed" }.to_json,
+        headers: { "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "badly signed webhooks are refused" do
+    untenanted do
+      post "/stripe/webhooks", params: { type: "checkout.session.completed" }.to_json,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=1,v1=nonsense" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "unknown event types are shrugged off" do
+    assert_no_difference -> { Account::Subscription.count } do
+      post_webhook type: "customer.updated", data: { object: { id: "cus_123" } }
+    end
+
+    assert_response :success
+  end
+
+  private
+    def post_webhook(payload)
+      payload = payload.to_json
+
+      untenanted do
+        post "/stripe/webhooks", params: payload,
+          headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => stripe_signature_for(payload) }
+      end
+    end
+
+    def stripe_signature_for(payload, timestamp: Time.now)
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      Stripe::Webhook::Signature.generate_header(timestamp, signature)
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
