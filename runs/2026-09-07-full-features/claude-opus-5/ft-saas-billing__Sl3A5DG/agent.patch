diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..da74fa7
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,62 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due incomplete ]
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  def plan
+    ::Subscription.find_by_key(plan_key) || ::Subscription.default
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.short_name
+  end
+
+  def active?
+    status.blank? || status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceling?
+    cancel_at.present?
+  end
+
+  def canceled?
+    status == "canceled"
+  end
+
+  def next_amount_due_in_dollars
+    next_amount_due_in_cents.to_i / 100.0 if next_amount_due_in_cents
+  end
+
+  # Tells Stripe to stop renewing. The matching webhook syncs the details back.
+  def cancel_at_period_end
+    with_stripe_subscription do |id|
+      Stripe::Subscription.update(id, cancel_at_period_end: true)
+    end
+  end
+
+  def resume
+    with_stripe_subscription do |id|
+      Stripe::Subscription.update(id, cancel_at_period_end: false)
+      update! cancel_at: nil
+    end
+  end
+
+  def cancel_now
+    with_stripe_subscription do |id|
+      Stripe::Subscription.cancel(id)
+      update! status: "canceled"
+    end
+  end
+
+  private
+    def with_stripe_subscription
+      if stripe_subscription_id.present?
+        yield stripe_subscription_id
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, severity: :error)
+      nil
+    end
+end
diff --git a/saas/app/models/billing/stripe_event.rb b/saas/app/models/billing/stripe_event.rb
new file mode 100644
index 0000000..7a2f161
--- /dev/null
+++ b/saas/app/models/billing/stripe_event.rb
@@ -0,0 +1,129 @@
+# Stripe is the source of truth for subscriptions: it hosts checkout and the
+# customer portal, then tells us what happened. Every change arrives here.
+class Billing::StripeEvent
+  class SignatureError < StandardError; end
+
+  attr_reader :type, :object
+
+  class << self
+    def verify(payload:, signature:, secret: self.secret)
+      if secret.present?
+        new Stripe::Webhook.construct_event(payload, signature.to_s, secret)
+      else
+        new JSON.parse(payload)
+      end
+    rescue Stripe::SignatureVerificationError, JSON::ParserError, TypeError => error
+      raise SignatureError, error.message
+    end
+
+    def secret
+      ENV["STRIPE_WEBHOOK_SECRET"]
+    end
+  end
+
+  def initialize(event)
+    # Stripe objects nest their own types, so round-trip through JSON to get
+    # plain hashes all the way down.
+    payload = JSON.parse(event.to_json).with_indifferent_access
+    @type   = payload[:type]
+    @object = (payload.dig(:data, :object) || {}).with_indifferent_access
+  end
+
+  def process
+    case type
+    when "checkout.session.completed"
+      complete_checkout
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.resumed"
+      record_subscription
+    when "customer.subscription.deleted"
+      remove_subscription
+    when "invoice.upcoming", "invoice.created", "invoice.paid", "invoice.payment_succeeded"
+      record_next_amount_due
+    end
+  end
+
+  private
+    def complete_checkout
+      if account = find_account
+        subscription = account.subscription || account.build_subscription
+
+        subscription.stripe_customer_id     = object[:customer]
+        subscription.stripe_subscription_id = object[:subscription] if object[:subscription].present?
+        subscription.plan_key               = plan_key if plan_key
+        subscription.status                 = "active" if subscription.status.blank? || subscription.canceled?
+        subscription.cancel_at              = nil
+
+        subscription.save!
+      end
+    end
+
+    def record_subscription
+      if subscription = find_or_build_subscription
+        subscription.stripe_subscription_id = object[:id]
+        subscription.plan_key               = plan_key if plan_key
+        subscription.status                 = object[:status] if object[:status].present?
+        subscription.current_period_end     = time_at(current_period_end)
+        subscription.cancel_at              = time_at(object[:cancel_at])
+
+        subscription.save!
+      end
+    end
+
+    def remove_subscription
+      if subscription = find_subscription
+        subscription.update! status: "canceled", cancel_at: time_at(object[:canceled_at]) || Time.current
+      end
+    end
+
+    def record_next_amount_due
+      if subscription = find_subscription
+        subscription.update! next_amount_due_in_cents: object[:amount_due]
+      end
+    end
+
+    def find_or_build_subscription
+      if subscription = find_subscription
+        subscription
+      elsif (account = find_account) && object[:customer].present?
+        account.build_subscription(stripe_customer_id: object[:customer])
+      end
+    end
+
+    def find_subscription
+      Account::Subscription.find_by(stripe_subscription_id: stripe_subscription_id) ||
+        Account::Subscription.find_by(stripe_customer_id: object[:customer])
+    end
+
+    def stripe_subscription_id
+      if type.start_with?("customer.subscription.")
+        object[:id]
+      else
+        object[:subscription]
+      end
+    end
+
+    def find_account
+      Account.find_by(id: account_id) if account_id.present?
+    end
+
+    def account_id
+      object[:client_reference_id] || object.dig(:metadata, :account_id)
+    end
+
+    def plan_key
+      ::Subscription.find_by_key(object.dig(:metadata, :plan_key))&.short_name ||
+        ::Subscription.find_by_stripe_price_id(price_id)&.short_name
+    end
+
+    def price_id
+      object.dig(:items, :data, 0, :price, :id) || object.dig(:plan, :id)
+    end
+
+    def current_period_end
+      object[:current_period_end] || object.dig(:items, :data, 0, :current_period_end)
+    end
+
+    def time_at(seconds)
+      Time.at(seconds).utc if seconds.present?
+    end
+end
