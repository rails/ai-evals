+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">
+        #<%= @account.external_account_id %> • <%= @account.plan.title %>
+      </h2>
+    </header>
+
+    <ul class="list-unindented margin-block-half">
+      <li>Owner: <%= @account.owner_email || "No owner" %></li>
+      <li>
+        Cards: <strong><%= number_with_delimiter(@account.cards_count) %></strong> of
+        <%= @account.unlimited_cards? ? "unlimited" : number_with_delimiter(@account.card_limit) %>
+      </li>
+      <li>
+        Storage: <strong><%= number_to_human_size(@account.bytes_used) %></strong> of
+        <%= number_to_human_size(@account.storage_limit) %>
+      </li>
+      <li>Comped: <strong><%= @account.comped? ? "Yes" : "No" %></strong></li>
+      <% if subscription = @account.subscription %>
+        <li>
+          Stripe: <%= subscription.stripe_customer_id %>
+          (<%= subscription.status || "unknown" %>)
+        </li>
+      <% end %>
+    </ul>
+
+    <div class="flex gap-half margin-block-half">
+      <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
