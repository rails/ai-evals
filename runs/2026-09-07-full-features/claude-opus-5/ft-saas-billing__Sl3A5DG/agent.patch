@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start out on the free plan" do
+    assert_equal Subscription::FreeV1, @account.plan
+    assert @account.free?
+    assert_not @account.paid?
+    assert_nil @account.active_subscription
+  end
+
+  test "a paid plan brings its own storage allowance" do
+    assert_equal 1.gigabyte, @account.storage_limit
+
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_123", plan_key: "MonthlyV1", status: "active")
+
+    assert_equal Subscription::MonthlyV1, @account.plan
+    assert @account.paid?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    subscription.update! plan_key: "MonthlyExtraStorageV1"
+
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "a canceled subscription falls back to the free plan" do
+    @account.create_subscription! stripe_customer_id: "cus_123", plan_key: "MonthlyV1", status: "canceled"
+
+    assert_equal Subscription::FreeV1, @account.plan
+    assert_not @account.paid?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping and uncomping an account" do
+    assert_not @account.comped?
+
+    @account.comp
+
+    assert @account.comped?
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comping is idempotent" do
+    @account.comp
+
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+  end
+
+  test "overriding and resetting limits" do
+    @account.override_limits card_count: 25, bytes_used: 3.gigabytes
+
+    assert_equal 25, @account.card_limit
+    assert_equal 3.gigabytes, @account.storage_limit
+
+    @account.reset_overridden_limits
+
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "cancelling an account stops the subscription from renewing" do
+    @account.create_subscription! stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active"
+
+    Stripe::Subscription.expects(:update).with("sub_123", cancel_at_period_end: true).once
+
+    @account.cancel(initiated_by: users(:mike))
+  end
+
+  test "incinerating an account cancels the subscription outright" do
+    @account.create_subscription! stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123", plan_key: "MonthlyV1", status: "active"
+
+    Stripe::Subscription.expects(:cancel).with("sub_123").once
+
+    @account.incinerate
+  end
+end
