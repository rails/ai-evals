+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <%= form_with url: saas.admin_accounts_path, method: :get, class: "flex gap-half margin-block-half" do |form| %>
+      <%= form.search_field :query, value: params[:query], class: "input", placeholder: "Search by name…" %>
+      <%= form.button "Search", class: "btn" %>
+    <% end %>
+
+    <ul class="margin-block-half">
+      <% @accounts.each do |account| %>
