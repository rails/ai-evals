@@ -0,0 +1,52 @@
+# Stripe hosts the checkout: we hand it a plan and send the admin over.
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan
+
+  def create
+    redirect_to checkout_session.url, allow_other_host: true, status: :see_other
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+    redirect_to saas.account_billing_path, alert: "Sorry, we couldn't reach our payment processor. Please try again."
+  end
+
+  private
+    def set_plan
+      @plan = if params[:plan].present?
+        ::Subscription.find_by_key(params[:plan])
+      else
+        ::Subscription.paid.first
+      end
+
+      head :not_found unless @plan&.paid?
+    end
+
+    def checkout_session
+      Stripe::Checkout::Session.create(checkout_session_params)
+    end
+
+    def checkout_session_params
+      {
+        mode: "subscription",
+        line_items: [ { price: @plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: Current.account.id,
+        metadata: subscription_metadata,
+        subscription_data: { metadata: subscription_metadata },
+        allow_promotion_codes: true,
+        success_url: saas.account_billing_url(script_name: Current.account.slug),
+        cancel_url: saas.account_billing_url(script_name: Current.account.slug)
+      }.merge(customer_params)
+    end
+
+    def subscription_metadata
+      { account_id: Current.account.id, plan_key: @plan.short_name }
+    end
+
+    def customer_params
+      if customer_id = Current.account.subscription&.stripe_customer_id
+        { customer: customer_id }
+      else
+        { customer_email: Current.user.identity&.email_address }
+      end
+    end
+end
