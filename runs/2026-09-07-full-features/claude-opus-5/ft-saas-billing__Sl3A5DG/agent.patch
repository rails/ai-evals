+# Stripe hosts the customer portal, where admins change or cancel their plan.
+class Account::Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_subscription
+
+  def create
+    redirect_to portal_session.url, allow_other_host: true, status: :see_other
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+    redirect_to saas.account_billing_path, alert: "Sorry, we couldn't reach our payment processor. Please try again."
+  end
+
+  private
+    def set_subscription
+      @subscription = Current.account.subscription
+
+      if @subscription&.stripe_customer_id.blank?
+        redirect_to saas.account_billing_path, alert: "This account isn't on a paid plan yet."
+      end
+    end
+
+    def portal_session
+      Stripe::BillingPortal::Session.create \
+        customer: @subscription.stripe_customer_id,
+        return_url: saas.account_billing_url(script_name: Current.account.slug)
+    end
+end
