+require "test_helper"
+
+class CacheableTimesTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :david
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "timestamps go out raw, in UTC, for the browser to put into words" do
+    get card_url(@comment.card)
+
+    assert_select "##{dom_id(@comment)} time[datetime=?][data-local-time-format-value=?]",
+      @comment.created_at.utc.iso8601, "relative"
+  end
+
+  test "every timezone gets the same markup, so pages stay cacheable" do
+    assert_equal comment_markup(timezone: "America/New_York"), comment_markup(timezone: "Asia/Tokyo")
+  end
+
+  private
+    def comment_markup(timezone:)
+      cookies[:timezone] = timezone
+      get card_url(@comment.card)
+      css_select("##{dom_id(@comment)}").to_s
+    end
+end
diff --git a/test/system/local_times_test.rb b/test/system/local_times_test.rb
new file mode 100644
index 0000000..b0e2559
--- /dev/null
+++ b/test/system/local_times_test.rb
@@ -0,0 +1,96 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  # A Monday, 1:42 PM in New York, 2:42 AM the next day in Tokyo.
+  NOW = "2025-09-15T17:42:00Z"
+
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+    sign_in_as users(:david)
+    visit card_url(@comment.card)
+  end
+
+  test "times read as words in the viewer's own timezone" do
+    in_timezone "America/New_York" do
+      assert_equal "1:42 PM", format_local_time(NOW)
+      assert_equal "11:42 AM", format_local_time("2025-09-15T15:42:00Z")
+      assert_equal "yesterday", format_local_time("2025-09-15T02:00:00Z")
+      assert_equal "5 days ago", format_local_time("2025-09-10T16:00:00Z")
+      assert_equal "Sep 3", format_local_time("2025-09-03T16:00:00Z")
+      assert_equal "May 15, 2024", format_local_time("2024-05-15T16:00:00Z")
+      assert_equal "tomorrow", format_local_time("2025-09-16T16:00:00Z")
+      assert_equal "in 3 days", format_local_time("2025-09-18T16:00:00Z")
+    end
+  end
+
+  test "the same instant reads differently for viewers in different timezones" do
+    in_timezone "America/New_York" do
+      assert_equal "1:42 PM", format_local_time(NOW)
+      assert_equal "Monday, September 15", format_local_time(NOW, format: "weekday_date")
+      assert_equal "Monday, September 15, 2025 at 1:42 PM", format_local_time(NOW, format: "full")
+    end
+
+    in_timezone "Asia/Tokyo" do
+      assert_equal "2:42 AM", format_local_time(NOW)
+      assert_equal "Tuesday, September 16", format_local_time(NOW, format: "weekday_date")
+    end
+  end
+
+  test "distances read from the moment the viewer is reading them" do
+    in_timezone "America/New_York" do
+      assert_equal "now", format_local_time("2025-09-15T17:41:30Z", format: "distance")
+      assert_equal "45 minutes ago", format_local_time("2025-09-15T16:57:00Z", format: "distance")
+      assert_equal "2 hours ago", format_local_time("2025-09-15T15:42:00Z", format: "distance")
+      assert_equal "yesterday", format_local_time("2025-09-14T16:00:00Z", format: "distance")
+      assert_equal "5 days ago", format_local_time("2025-09-10T16:00:00Z", format: "distance")
+      assert_equal "2 months ago", format_local_time("2025-07-15T16:00:00Z", format: "distance")
+      assert_equal "tomorrow", format_local_time("2025-09-16T04:00:00Z", format: "distance")
+      assert_equal "in 3 days", format_local_time("2025-09-18T16:00:00Z", format: "distance")
+    end
+  end
+
+  test "dates read the same everywhere, since they belong to no timezone" do
+    in_timezone "Asia/Tokyo" do
+      assert_equal "Friday, September 12", format_local_time("2025-09-12", format: "weekday_date")
+    end
+
+    in_timezone "America/Los_Angeles" do
+      assert_equal "Friday, September 12", format_local_time("2025-09-12", format: "weekday_date")
+    end
+  end
+
+  test "a comment falls on the day it happened where the viewer is reading it" do
+    @comment.update! created_at: Time.utc(2024, 5, 15, 23, 30)
+
+    in_timezone "America/New_York" do
+      visit card_url(@comment.card)
+      assert_selector "##{dom_id(@comment)}", text: "May 15, 2024"
+    end
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(@comment.card)
+      assert_selector "##{dom_id(@comment)}", text: "May 16, 2024"
+    end
+  end
+
+  private
+    def in_timezone(timezone)
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: timezone
+      yield
+    ensure
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: ""
+    end
+
+    def format_local_time(timestamp, format: "relative", now: NOW)
+      page.evaluate_async_script <<~JS, timestamp, format, now
+        const [ timestamp, format, now ] = arguments
+        const callback = arguments[arguments.length - 1]
+
+        import("helpers/date_helpers").then(({ formatLocalTime }) => {
+          callback(formatLocalTime(timestamp, format, new Date(now)))
+        })
+      JS
+    end
+end
