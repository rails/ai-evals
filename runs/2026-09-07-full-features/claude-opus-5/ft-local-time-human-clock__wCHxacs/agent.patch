@@ -0,0 +1,54 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders an empty time element carrying the raw timestamp" do
+    assert_dom_equal <<~HTML, local_time_tag(Time.utc(2025, 9, 12, 18, 42, 30))
+      <time class="local-time-value" datetime="2025-09-12T18:42:30Z"
+        data-controller="local-time"
+        data-action="turbo:morph-element->local-time#render:self"
+        data-local-time-format-value="relative"></time>
+    HTML
+  end
+
+  test "renders the same markup no matter which timezone the server is in" do
+    time = Time.utc(2025, 9, 12, 18, 42, 30)
+
+    in_new_york = Time.use_zone("America/New_York") { local_time_tag(time.in_time_zone) }
+    in_tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(time.in_time_zone) }
+
+    assert_equal in_new_york, in_tokyo
+  end
+
+  test "renders dates without a time of day, since they belong to no timezone" do
+    assert_dom_includes local_time_tag(Date.new(2025, 9, 12), format: :weekday_date),
+      %(datetime="2025-09-12")
+  end
+
+  test "renders nothing without a time" do
+    assert_nil local_time_tag(nil)
+  end
+
+  test "passes the format along to the browser" do
+    assert_dom_includes local_time_tag(Time.current, format: :date_time),
+      %(data-local-time-format-value="date_time")
+  end
+
+  test "rejects formats the browser doesn't know how to render" do
+    assert_raises ArgumentError do
+      local_time_tag Time.current, format: :fortnight
+    end
+  end
+
+  test "merges classes and data attributes" do
+    tag = local_time_tag(Time.current, class: "card__timestamp", data: { turbo_frame: "_top" })
+
+    assert_dom_includes tag, %(class="local-time-value card__timestamp")
+    assert_dom_includes tag, %(data-turbo-frame="_top")
+    assert_dom_includes tag, %(data-controller="local-time")
+  end
+
+  private
+    def assert_dom_includes(html, fragment)
+      assert_includes html, fragment, "Expected #{html} to include #{fragment}"
+    end
+end
