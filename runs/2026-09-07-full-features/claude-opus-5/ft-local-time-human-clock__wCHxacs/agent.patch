diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..f951646 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,38 @@
+# Times are never rendered here. The server only ships the raw timestamp and the
+# local-time controller turns it into words in the viewer's own timezone, so no
+# one's clock gets baked into HTML we'd like to cache and share between people.
 module TimeHelper
+  # Keep in sync with formatLocalTime in app/javascript/helpers/date_helpers.js
+  FORMATS = %i[ relative distance time date date_time weekday_date ]
+
+  def local_time_tag(time, format: :relative, **options)
+    raise ArgumentError, "Unknown local time format: #{format}" unless FORMATS.include?(format)
+
+    if time.present?
+      tag.time datetime: local_timestamp(time),
+        class: token_list("local-time-value", options.delete(:class)),
+        data: local_time_data(format).merge(options.delete(:data) || {}),
+        **options
+    end
+  end
+
+  private
+    # Always UTC: an offset would vary with the renderer's timezone, and that's
+    # exactly what we're keeping out of the markup. Dates carry no timezone at
+    # all, so they go out as they are.
+    def local_timestamp(time)
+      if time.acts_like?(:time)
+        time.utc.iso8601
+      else
+        time.to_date.iso8601
+      end
+    end
+
+    def local_time_data(format)
+      {
+        controller: "local-time",
+        action: "turbo:morph-element->local-time#render:self",
+        local_time_format_value: format
+      }
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..b1181e6
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,55 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, isRelativeFormat } from "helpers/date_helpers"
+
+// Relative labels go stale while a page sits open, so a single clock shared by
+// every time on the page keeps them honest.
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+const refreshables = new Set()
+let refreshTimer
+
+// Turns the raw timestamp the server sent into words in the viewer's own
+// timezone: "1:42 PM", "yesterday", "5 days ago", "in 3 days".
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+
+    if (isRelativeFormat(this.formatValue)) startRefreshing(this)
+  }
+
+  disconnect() {
+    stopRefreshing(this)
+  }
+
+  render() {
+    this.element.textContent = formatLocalTime(this.#timestamp, this.formatValue)
+
+    // Words like "yesterday" hide the details, so keep them a hover away.
+    if (isRelativeFormat(this.formatValue)) {
+      this.element.title = formatLocalTime(this.#timestamp, "full")
+    }
+  }
+
+  get #timestamp() {
+    return this.element.getAttribute("datetime")
+  }
+}
+
+function startRefreshing(controller) {
+  refreshables.add(controller)
+  refreshTimer ||= setInterval(refreshAll, REFRESH_INTERVAL)
+}
+
+function refreshAll() {
+  refreshables.forEach(controller => controller.render())
+}
+
+function stopRefreshing(controller) {
+  refreshables.delete(controller)
+
+  if (refreshables.size === 0) {
+    clearInterval(refreshTimer)
+    refreshTimer = null
+  }
+}
