diff --git a/test/models/multi_tenancy_test.rb b/test/models/multi_tenancy_test.rb
new file mode 100644
index 0000000..37a7fd0
--- /dev/null
+++ b/test/models/multi_tenancy_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class MultiTenancyTest < ActiveSupport::TestCase
+  # Identity, session, and authentication records are global: they're shared by
+  # every account an identity belongs to, so they can't carry an account_id.
+  GLOBAL_TABLES = %w[
+    account_external_id_sequences
+    accounts
+    action_pack_passkeys
+    ar_internal_metadata
+    identities
+    identity_access_tokens
+    magic_links
+    schema_migrations
+    sessions
+  ].freeze
+
+  test "every table that holds an account's data has a required account_id" do
+    tenanted_tables.each do |table|
+      account_id = connection.columns(table).find { |column| column.name == "account_id" }
+
+      assert account_id, "#{table} is missing an account_id"
+      assert_not account_id.null, "#{table}.account_id should be required"
+    end
+  end
+
+  test "every account_id is indexed" do
+    tenanted_tables.each do |table|
+      assert connection.indexes(table).any? { |index| Array(index.columns).first == "account_id" },
+        "#{table}.account_id should be indexed"
+    end
+  end
+
+  test "records get their account from the record they belong to" do
+    card = cards(:logo)
+
+    assert_equal card.account, Pin.create!(card: card, user: users(:jz)).account
+    assert_equal card.account, Step.create!(card: card, content: "Ship it").account
+    assert_equal card.account, Tagging.create!(card: card, tag: tags(:mobile)).account
+    assert_equal card.account, Card::Goldness.new(card: card).tap(&:validate).account
+    assert_equal card.board.account, Board::Publication.create!(board: card.board).account
+    assert_equal users(:mike).account, User::Settings.create!(user: users(:mike)).account
+  end
+
+  test "join tables get their account from the records they join" do
+    filter = filters(:jz_assignments)
+    filter.boards = [ boards(:writebook) ]
+
+    assert_equal [ filter.account_id ], join_table("boards_filters").pluck(:account_id)
+  end
+
+  test "attachments and rich texts belong to the account of the record they're attached to" do
+    card = cards(:logo)
+    card.update! description: "<p>Something</p>"
+    card.image.attach io: StringIO.new("image"), filename: "test.png", content_type: "image/png"
+
+    assert_equal card.account, card.rich_text_description.account
+    assert_equal card.account, card.image_attachment.account
+    assert_equal card.account, card.image_attachment.blob.account
