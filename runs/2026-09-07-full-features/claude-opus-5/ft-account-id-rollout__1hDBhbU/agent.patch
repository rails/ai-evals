+    [ "active_storage_attachments",   [ { from: "boards", on: "record_id", only: [ "record_type", "Board" ] },
+                                        { from: "cards", on: "record_id", only: [ "record_type", "Card" ] },
+                                        { from: "comments", on: "record_id", only: [ "record_type", "Comment" ] },
+                                        { from: "users", on: "record_id", only: [ "record_type", "User" ] },
+                                        { from: "exports", on: "record_id", only: [ "record_type", "Export" ] },
+                                        { from: "account_imports", on: "record_id", only: [ "record_type", "Account::Import" ] },
