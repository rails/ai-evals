+  # backfill takes the account from:
+  #   { from: "parents", on: "parent_id" }       the parent row it points at
+  #   { column: "owner_id" }                     one of its own columns
+  #   { aggregate: "children", on: "parent_id" } the rows pointing back at it
+  # and "only:" restricts a backfill to one flavour of a polymorphic reference.
+  TENANTED_TABLES = [
+    [ "users",                        [ ] ],
+    [ "account_join_codes",           [ ] ],
+    [ "account_imports",              [ ] ],
+    [ "boards",                       [ { from: "users", on: "creator_id" } ] ],
+    [ "columns",                      [ { from: "boards", on: "board_id" } ] ],
+    [ "cards",                        [ { from: "boards", on: "board_id" } ] ],
+    [ "comments",                     [ { from: "cards", on: "card_id" } ] ],
+    [ "steps",                        [ { from: "cards", on: "card_id" } ] ],
+    [ "events",                       [ { from: "boards", on: "board_id" } ] ],
+    [ "tags",                         [ ] ],
+    [ "filters",                      [ { from: "users", on: "creator_id" } ] ],
+    [ "webhooks",                     [ { from: "boards", on: "board_id" } ] ],
+    [ "notifications",                [ { from: "users", on: "user_id" } ] ],
+    [ "notification_bundles",         [ { from: "users", on: "user_id" } ] ],
+    [ "push_subscriptions",           [ { from: "users", on: "user_id" } ] ],
+    [ "user_settings",                [ { from: "users", on: "user_id" } ] ],
+    [ "search_queries",               [ { from: "users", on: "user_id" } ] ],
+    [ "accesses",                     [ { from: "boards", on: "board_id" } ] ],
+    [ "board_publications",           [ { from: "boards", on: "board_id" } ] ],
+    [ "assignments",                  [ { from: "cards", on: "card_id" } ] ],
+    [ "card_activity_spikes",         [ { from: "cards", on: "card_id" } ] ],
+    [ "card_goldnesses",              [ { from: "cards", on: "card_id" } ] ],
+    [ "card_not_nows",                [ { from: "cards", on: "card_id" } ] ],
