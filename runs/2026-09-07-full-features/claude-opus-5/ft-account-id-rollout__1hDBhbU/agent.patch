+    [ "taggings",                     [ { from: "cards", on: "card_id" } ] ],
+    [ "watches",                      [ { from: "cards", on: "card_id" } ] ],
+    [ "mentions",                     [ { from: "cards", on: "source_id", only: [ "source_type", "Card" ] },
+                                        { from: "comments", on: "source_id", only: [ "source_type", "Comment" ] } ] ],
+    [ "reactions",                    [ { from: "cards", on: "reactable_id", only: [ "reactable_type", "Card" ] },
+                                        { from: "comments", on: "reactable_id", only: [ "reactable_type", "Comment" ] } ] ],
+    [ "entropies",                    [ { column: "container_id", only: [ "container_type", "Account" ] },
+                                        { from: "boards", on: "container_id", only: [ "container_type", "Board" ] } ] ],
+    [ "storage_totals",               [ { column: "owner_id", only: [ "owner_type", "Account" ] },
+                                        { from: "boards", on: "owner_id", only: [ "owner_type", "Board" ] } ] ],
+    [ "webhook_delinquency_trackers", [ { from: "webhooks", on: "webhook_id" } ] ],
+    [ "webhook_deliveries",           [ { from: "webhooks", on: "webhook_id" } ] ],
+    [ "assignees_filters",            [ { from: "filters", on: "filter_id" } ] ],
+    [ "assigners_filters",            [ { from: "filters", on: "filter_id" } ] ],
