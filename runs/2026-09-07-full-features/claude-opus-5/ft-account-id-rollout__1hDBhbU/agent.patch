diff --git a/config/initializers/tenanting/framework_records.rb b/config/initializers/tenanting/framework_records.rb
new file mode 100644
index 0000000..30778e1
--- /dev/null
+++ b/config/initializers/tenanting/framework_records.rb
@@ -0,0 +1,23 @@
+# Active Storage and Action Text keep an account's data too — blobs, their
+# attachments and variants, and rich text bodies all belong to exactly one
+# account — so they carry a required account_id like every other tenanted
+# table.
+#
+# The account is inherited from whatever the record is attached to, falling
+# back to the account the request (or job) is running for.
+
+ActiveSupport.on_load(:active_storage_blob) do
+  belongs_to :account, default: -> { Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  belongs_to :account, default: -> { record.try(:account) || blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:active_storage_variant_record) do
+  belongs_to :account, default: -> { blob&.account || Current.account }
+end
+
+ActiveSupport.on_load(:action_text_rich_text) do
+  belongs_to :account, default: -> { record.try(:account) || Current.account }
+end
