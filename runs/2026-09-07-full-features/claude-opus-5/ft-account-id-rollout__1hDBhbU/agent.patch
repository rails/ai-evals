+        users account_join_codes account_imports boards columns cards comments steps events
+        tags filters webhooks notifications notification_bundles push_subscriptions
+      ].include?(table.to_s)
+    end
+
+    def add_account_id_to(table)
+      add_column table, :account_id, :uuid unless column_exists?(table, :account_id)
+    end
+
+    def backfill_account_id(table, from: nil, on: nil, column: nil, aggregate: nil, only: nil)
+      filter = "#{table}.account_id IS NULL"
+      filter += " AND #{table}.#{only.first} = #{quote(only.second)}" if only
+
+      value = if column
+        "#{table}.#{column}"
+      elsif aggregate
+        "(SELECT MIN(#{aggregate}.account_id) FROM #{aggregate} WHERE #{aggregate}.#{on} = #{table}.id)"
+      else
+        "(SELECT #{from}.account_id FROM #{from} WHERE #{from}.id = #{table}.#{on})"
+      end
