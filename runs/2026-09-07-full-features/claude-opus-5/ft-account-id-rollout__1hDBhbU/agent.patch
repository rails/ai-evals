+      else
+        remove_index table, column: :account_id, if_exists: true
+        remove_column table, :account_id
+      end
+    end
+  end
+
+  private
+    # A tag title only has to be unique within the account that owns it.
+    def scope_tag_titles_to_their_account
+      remove_index :tags, column: :title, if_exists: true
+      remove_index :tags, column: :account_id, if_exists: true
+      add_index :tags, [ :account_id, :title ], unique: true
+    end
+
+    def unscope_tag_titles_from_their_account
+      remove_index :tags, column: [ :account_id, :title ], if_exists: true
+      add_index :tags, :title, unique: true
+    end
+
+    # Tables that already had account_id before this migration keep the column
+    # when rolling back, they just go back to allowing NULLs.
+    def optional_account_id?(table)
