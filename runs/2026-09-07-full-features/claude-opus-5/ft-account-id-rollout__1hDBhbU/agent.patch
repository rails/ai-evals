+    [ "closers_filters",              [ { from: "filters", on: "filter_id" } ] ],
+    [ "creators_filters",             [ { from: "filters", on: "filter_id" } ] ],
+    [ "filters_tags",                 [ { from: "filters", on: "filter_id" } ] ],
+    [ "action_text_rich_texts",       [ { from: "boards", on: "record_id", only: [ "record_type", "Board" ] },
