@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "creating an event relays it to the webhooks subscribed to its action" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event action: "card_published"
+    end
+  end
+
+  test "creating an event nobody subscribed to doesn't relay it" do
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      create_event action: "comment_created", eventable: comments(:layout_overflowing_david)
+    end
+  end
+
+  test "creating an event doesn't relay it to inactive webhooks" do
+    webhooks(:active).deactivate
+
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      create_event action: "card_published"
+    end
+  end
+
+  test "relay_now creates a pending delivery per subscribed webhook" do
+    other = boards(:writebook).webhooks.create! name: "Another", url: "https://another.example.com/webhooks",
+      subscribed_actions: %w[ card_published ]
+    event = create_event action: "card_published"
+
+    assert_difference -> { Webhook::Delivery.count }, 2 do
+      event.relay_now
+    end
+
+    assert_equal %w[ pending pending ], event.webhook_deliveries.map(&:state)
+    assert_equal [ other, webhooks(:active) ].sort, event.webhook_deliveries.map(&:webhook).sort
+  end
+
+  test "relay_now only ever creates one delivery per webhook and event" do
+    event = create_event action: "card_published"
+    event.relay_now
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relaying an event posts it to the receiver and logs the delivery" do
+    stub_dns_resolution "93.184.216.34"
+    request = stub_request(:post, webhooks(:active).url).to_return(status: 200, body: "thanks")
+
+    event = nil
+
+    perform_enqueued_jobs do
+      event = create_event action: "card_published"
+    end
+
+    assert_requested request, times: 1
+
+    delivery = event.webhook_deliveries.sole
+    assert_equal webhooks(:active), delivery.webhook
+    assert_predicate delivery, :succeeded?
+    assert_equal 200, delivery.response[:code]
+  end
+
+  private
+    def create_event(action:, eventable: cards(:logo))
+      boards(:writebook).events.create! action: action, creator: users(:david), eventable: eventable
+    end
+end
