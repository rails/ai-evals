diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..47442d9
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders the raw timestamp for the browser to localize" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_dom_equal <<~HTML.squish, local_time_tag(time)
+      <time datetime="2025-09-12T13:42:00Z" data-controller="local-time"
+        data-action="turbo:morph-element->local-time#render"
+        data-local-time-format-value="relative"></time>
+    HTML
+  end
+
+  test "renders the same markup for everyone, whatever the server's timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    in_tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(time) }
+    in_chicago = Time.use_zone("America/Chicago") { local_time_tag(time) }
+
+    assert_dom_equal in_tokyo, in_chicago
+  end
+
+  test "renders plain days as days, so they aren't shifted by the viewer's timezone" do
+    assert_dom_equal <<~HTML.squish, local_time_tag(Date.new(2025, 9, 12), format: :weekday_date)
+      <time datetime="2025-09-12" data-controller="local-time"
+        data-action="turbo:morph-element->local-time#render"
+        data-local-time-format-value="weekday_date"></time>
+    HTML
+  end
+
+  test "passes attributes through" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_dom_equal <<~HTML.squish, local_time_tag(time, format: :time_ago, class: "card__timestamp")
+      <time datetime="2025-09-12T13:42:00Z" class="card__timestamp" data-controller="local-time"
+        data-action="turbo:morph-element->local-time#render"
+        data-local-time-format-value="time_ago"></time>
+    HTML
+  end
+end
diff --git a/test/system/local_times_test.rb b/test/system/local_times_test.rb
new file mode 100644
index 0000000..050bc04
--- /dev/null
+++ b/test/system/local_times_test.rb
@@ -0,0 +1,114 @@
+require "application_system_test_case"
+
+class LocalTimesTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "today's comments are timestamped with the viewer's own clock" do
+    comment = comments(:logo_agreement_kevin) # Two hours ago
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(comment.card)
+      assert_comment_time comment, local_time(comment.created_at, "Asia/Tokyo")
+    end
+
+    in_timezone "America/Los_Angeles" do
+      visit card_url(comment.card)
+      assert_comment_time comment, local_time(comment.created_at, "America/Los_Angeles")
+    end
+  end
+
+  test "older comments are timestamped in words, then in dates" do
+    comment = comments(:logo_agreement_jz)
+
+    in_timezone "Asia/Tokyo" do
+      comment.update! created_at: 1.day.ago
+      visit card_url(comment.card)
+      assert_comment_time comment, "yesterday"
+
+      comment.update! created_at: 5.days.ago
+      visit card_url(comment.card)
+      assert_comment_time comment, "5 days ago"
+
+      comment.update! created_at: 3.weeks.ago
+      visit card_url(comment.card)
+      assert_comment_time comment, comment.created_at.in_time_zone("Asia/Tokyo").strftime("%b %-d")
+    end
+  end
+
+  test "cards say how long ago they were added and updated" do
+    card = cards(:logo) # A week ago
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(card)
+      assert_card_meta_times card
+    end
+  end
+
+  test "cards say when they'll be postponed in words" do
+    card = cards(:logo)
+
+    in_timezone "Asia/Tokyo" do
+      card.update! last_active_at: 1.day.from_now - card.auto_postpone_period
+      visit card_url(card)
+      assert_selector "##{dom_id(card, :closure_notice)}", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+      card.update! last_active_at: 3.days.from_now - card.auto_postpone_period
+      visit card_url(card)
+      assert_selector "##{dom_id(card, :closure_notice)}", text: "Moves to “Not Now” in 3 days if there’s no activity."
+    end
+  end
+
+  test "times are rendered again when their element is morphed" do
+    card = cards(:logo)
+
+    in_timezone "Asia/Tokyo" do
+      visit card_url(card)
+      assert_card_meta_times card
+
+      morph_element "##{dom_id(card, :meta)}"
+
+      assert_card_meta_times card
+    end
+  end
+
+  private
+    def local_time(time, timezone)
+      time.in_time_zone(timezone).strftime("%-l:%M %p")
+    end
+
+    # Some of these are capitalized by the interface, so match the words alone.
+    def assert_comment_time(comment, text)
+      within "##{dom_id(comment)}" do
+        assert_selector "time", text: /#{Regexp.escape(text)}/i
+      end
+    end
+
+    def assert_card_meta_times(card)
+      within "##{dom_id(card, :meta)}" do
+        assert_selector "time", text: /7 days ago/i, count: 2
+      end
+    end
+
+    def in_timezone(timezone)
+      override_browser_timezone timezone
+      yield
+    ensure
+      override_browser_timezone Time.zone.name
+    end
+
+    def override_browser_timezone(timezone)
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: timezone
+    end
+
+    # Morphs an element with a copy of what the server renders: empty times.
+    def morph_element(selector)
+      page.execute_script <<~JS
+        const element = document.querySelector("#{selector}")
+        const replacement = element.cloneNode(true)
+        replacement.querySelectorAll("time").forEach(time => time.textContent = "")
+        Turbo.morphElements(element, replacement)
+      JS
+    end
+end
