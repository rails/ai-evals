diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c591ca6 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,34 @@
 module TimeHelper
+  # Renders a <time> element that the browser fills in, in the viewer's own
+  # timezone. We only send the raw timestamp, so the same HTML reads correctly
+  # for everyone — and can be cached and shared between people.
+  #
+  # Formats (see app/javascript/controllers/local_time_controller.js):
+  #
+  #   :relative       "1:42 PM" today, "yesterday", "5 days ago", "Sep 12", "in 3 days"
+  #   :time_ago       "just now", "2 hours ago", "yesterday", "in 3 days"
+  #   :time           "1:42 PM"
+  #   :date           "Sep 12", with the year when it isn't this year
+  #   :date_with_year "Sep 12, 2025"
+  #   :weekday_date   "Friday, September 12"
+  #   :date_and_time  "9/12/25, 1:42 PM"
+  #   :full           "Friday, September 12, 2025 at 1:42 PM"
+  def local_time_tag(time, format: :relative, **attributes)
+    data = { controller: "local-time", action: "turbo:morph-element->local-time#render",
+      local_time_format_value: format }
+
+    tag.time datetime: local_time_datetime(time), **attributes,
+      data: data.merge(attributes[:data] || {})
+  end
+
+  private
+    # Plain days are the same day everywhere, so they're sent as dates and left
+    # where they are. Instants are sent in UTC and localized by the browser.
+    def local_time_datetime(time)
+      if time.is_a?(Date) && !time.is_a?(DateTime)
+        time.iso8601
+      else
+        time.utc.iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..a7d095d
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime, formatFullDateAndTime, parseDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Turns the raw timestamp the server put in a <time datetime="…"> element into
+// words in the viewer's timezone. Relative wordings ("2 hours ago") are kept
+// fresh while the page is open, and carry the full date as a tooltip.
+//
+// The wording is ours, not the server's, so it's rendered again after a morph,
+// which would otherwise leave the element as empty as it was rendered.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.render()
+
+    if (this.#relative) {
+      this.#timer = setInterval(this.render.bind(this), REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    this.element.textContent = formatDateTime(this.#date, this.formatValue)
+
+    if (this.#relative && !this.element.title) {
+      this.element.title = formatFullDateAndTime(this.#date)
+    }
+  }
+
+  get #date() {
+    return parseDateTime(this.element.getAttribute("datetime"))
+  }
+
+  get #relative() {
+    return [ "relative", "time_ago" ].includes(this.formatValue)
+  }
+}
