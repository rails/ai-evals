+
+// Parses what the server puts in a `datetime` attribute. Plain days
+// ("2025-09-12") are days everywhere, so they're read as local midnight instead
+// of being shifted around by the browser's UTC parsing.
+export function parseDateTime(value) {
+  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return new Date(`${value}T00:00:00`)
+  } else {
+    return new Date(value)
+  }
