+// Dates and times are rendered in the browser so that everyone sees them in
+// their own timezone, and so the HTML the server sends can be cached and shared
+// between people. The wording stays in English, like the rest of the interface,
+// but the clock is always the viewer's.
+const LOCALE = "en-US"
+
+const MILLISECONDS_PER_DAY = 86_400_000
+const SECONDS_PER_MINUTE = 60
+const SECONDS_PER_HOUR = 3600
+const DAYS_PER_WEEK = 7
+const DAYS_PER_MONTH = 30
+const DAYS_PER_YEAR = 365
+
+// Formats a timestamp the way the server used to: "1:42 PM", "yesterday",
+// "5 days ago", "Sep 12", "in 3 days"… only now in the viewer's timezone.
+export function formatDateTime(date, format = "relative", now = new Date()) {
+  switch (format) {
+    case "time_ago":       return formatTimeAgo(date, now)
+    case "time":           return formatTime(date)
+    case "date":           return formatDate(date, now)
+    case "date_with_year": return formatDateWithYear(date)
+    case "weekday_date":   return formatWeekdayDate(date)
+    case "date_and_time":  return formatDateAndTime(date)
+    case "full":           return formatFullDateAndTime(date)
+    default:               return formatRelativeDateTime(date, now)
+  }
+}
+
+// Today's timestamps read as a clock time, the days around today as words, and
+// anything older as a plain date: "1:42 PM", "yesterday", "5 days ago", "Sep 12".
+export function formatRelativeDateTime(date, now = new Date()) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) {
+    return formatTime(date)
+  } else if (Math.abs(days) < DAYS_PER_WEEK) {
+    return formatTimeAgo(date, now)
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+// Always words, in either direction: "just now", "5 minutes ago", "2 hours ago",
+// "yesterday", "5 days ago", "tomorrow", "in 3 days".
+export function formatTimeAgo(date, now = new Date()) {
+  const seconds = Math.round((date - now) / 1000)
+  const days = signedDifferenceInDays(now, date)
+
+  if (Math.abs(seconds) < SECONDS_PER_MINUTE) {
+    return "just now"
+  } else if (Math.abs(seconds) < SECONDS_PER_HOUR) {
+    return formatDistance(Math.round(seconds / SECONDS_PER_MINUTE), "minute")
+  } else if (days === 0) {
+    return formatDistance(Math.round(seconds / SECONDS_PER_HOUR), "hour")
+  } else if (Math.abs(days) < DAYS_PER_MONTH) {
+    return formatDistance(days, "day")
+  } else if (Math.abs(days) < DAYS_PER_YEAR) {
+    return formatDistance(Math.round(days / DAYS_PER_MONTH), "month")
+  } else {
+    return formatDistance(Math.round(days / DAYS_PER_YEAR), "year")
+  }
+}
+
+export function formatTime(date) {
+  return formatWith({ hour: "numeric", minute: "2-digit" }, date)
+}
+
+export function formatDate(date, now = new Date()) {
+  if (isSameYear(date, now)) {
+    return formatWith({ month: "short", day: "numeric" }, date)
+  } else {
+    return formatDateWithYear(date)
+  }
+}
+
+export function formatDateWithYear(date) {
+  return formatWith({ month: "short", day: "numeric", year: "numeric" }, date)
+}
+
+export function formatWeekdayDate(date) {
+  return formatWith({ weekday: "long", month: "long", day: "numeric" }, date)
+}
+
+export function formatDateAndTime(date) {
+  return formatWith({ dateStyle: "short", timeStyle: "short" }, date)
+}
+
+export function formatFullDateAndTime(date) {
+  return formatWith({ dateStyle: "full", timeStyle: "short" }, date)
