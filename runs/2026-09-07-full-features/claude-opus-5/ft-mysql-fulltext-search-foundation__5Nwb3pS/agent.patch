+<% @page_title = @search.present? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<div class="search margin-block pad-inline">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half align-center margin-block-end" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards…",
+          class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off",
+          data: { "1p-ignore": "true" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="blank-slate">Search for cards by title, description, or comments</div>
+  <% elsif @page.records.none? %>
+    <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+  <% else %>
+    <section class="search__results flex flex-column gap">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+      <% end %>
+    </section>
+  <% end %>
+</div>
