diff --git a/docs/api/sections/search.md b/docs/api/sections/search.md
new file mode 100644
index 0000000..c3323fb
--- /dev/null
+++ b/docs/api/sections/search.md
@@ -0,0 +1,33 @@
+# Search
+
+Search finds cards by their title, description, or the body of any of their comments.
+Only cards on boards you currently have access to are returned, and drafted cards
+(along with their comments) are never included.
+
+## `GET /:account_slug/search`
+
+Returns a paginated list of matching cards, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `q` | The words to search for. Every word must match somewhere in the card |
+
+Example:
+- `/:account_slug/search?q=broken%20layout`
+
+__Response:__
+
+Returns the same card representation as [`GET /:account_slug/cards`](cards.md).
+
+```json
+[
+  {
+    "id": "03fx1a2b3c4d5e6f7g8h9i0jk",
+    "number": 2,
+    "title": "Layout is broken",
+    "status": "published"
+  }
+]
+```
diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..9de4463
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show without a query" do
+    get search_path
+    assert_response :success
+
+    assert_select "article.search__result", count: 0
+  end
+
+  test "finding cards by title" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "article.search__result", count: 1
+    assert_select "mark", text: "logo"
+    assert_select "article.search__result a", text: /The logo isn't big enough/
+  end
+
+  test "finding cards by description" do
+    cards(:layout).update! description: "The sidebar is misaligned on mobile"
+
+    get search_path(q: "misaligned")
+    assert_response :success
+
+    assert_select "article.search__result", count: 1
+    assert_select "mark", text: "misaligned"
+  end
+
+  test "finding cards by comment body" do
+    cards(:text).comments.create! body: "I love haggis", creator: users(:kevin)
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "article.search__result", count: 1
+    assert_select "mark", text: "haggis"
+    assert_select "article.search__result a", text: /The text is too small/
+  end
+
+  test "results are sorted newest first" do
+    older = newer = nil
+
+    with_current_user :kevin do
+      older = boards(:writebook).cards.create! title: "Older haggis", status: "published", created_at: 2.days.ago
+      newer = boards(:writebook).cards.create! title: "Newer haggis", status: "published", created_at: 1.minute.ago
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_equal [ newer, older ].collect { |card| card_path(card) },
+      css_select("article.search__result a.search__result-title").collect { |link| link["href"] }
+  end
+
+  test "cards from inaccessible boards are never found" do
+    with_current_user :kevin do
+      boards(:private).cards.create! title: "Secret haggis", status: "published"
+    end
+
+    logout_and_sign_in_as :david
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "article.search__result", count: 0
+  end
+
+  test "drafted cards and their comments are never found" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! title: "Drafted haggis", status: "drafted"
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_select "article.search__result", count: 0
+  end
+
+  test "cards from other accounts are never found" do
+    get search_path(q: "radio")
+    assert_response :success
+
+    assert_select "article.search__result", count: 0
+  end
+
+  test "queries without searchable words find nothing" do
+    get search_path(q: "%")
+    assert_response :success
+
+    assert_select "article.search__result", count: 0
+  end
+
+  test "matches are escaped before they are highlighted" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! title: "<script>alert('haggis')</script>", status: "published"
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+
+    assert_no_match "<script>", response.body
+    assert_select "mark", text: "haggis"
+  end
+
+  test "show as JSON" do
+    get search_path(q: "logo", format: :json)
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], response.parsed_body.pluck("number")
+  end
+end
