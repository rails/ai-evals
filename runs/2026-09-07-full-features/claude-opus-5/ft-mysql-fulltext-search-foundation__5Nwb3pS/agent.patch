diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..1d340f0
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finding cards by title, description, or comment body" do
+    cards(:layout).update! description: "The sidebar is misaligned"
+    cards(:text).comments.create! body: "I love haggis", creator: @user
+
+    assert_equal [ cards(:logo) ], search("logo").cards.to_a
+    assert_equal [ cards(:layout) ], search("misaligned").cards.to_a
+    assert_equal [ cards(:text) ], search("haggis").cards.to_a
+  end
+
+  test "matching is case insensitive and partial" do
+    assert_equal [ cards(:logo) ], search("LOGO").cards.to_a
+    assert_equal [ cards(:buy_domain) ], search("dom").cards.to_a
+  end
+
+  test "every word must match, wherever it appears" do
+    cards(:logo).update! description: "It should be bigger"
+
+    assert_equal [ cards(:logo) ], search("logo bigger").cards.to_a
+    assert_empty search("logo haggis").cards
+  end
+
+  test "a card matching several times is only returned once" do
+    cards(:logo).update! description: "The logo is small"
+    cards(:logo).comments.create! body: "The logo again", creator: @user
+    cards(:logo).comments.create! body: "And the logo once more", creator: @user
+
+    assert_equal [ cards(:logo) ], search("logo").cards.to_a
+  end
+
+  test "cards are returned newest first" do
+    older = boards(:writebook).cards.create! title: "Older haggis", status: "published", created_at: 2.days.ago
+    newer = boards(:writebook).cards.create! title: "Newer haggis", status: "published", created_at: 1.minute.ago
+
+    assert_equal [ newer, older ], search("haggis").cards.to_a
+  end
+
+  test "only cards on accessible boards are found" do
+    boards(:private).cards.create! title: "Secret haggis", status: "published"
+
+    assert_equal 1, search("haggis").cards.count
+    assert_empty Search.new("haggis", user: users(:david)).cards
+  end
+
+  test "drafted cards and their comments are never found" do
+    card = boards(:writebook).cards.create! title: "Drafted haggis", status: "published"
+    card.comments.create! body: "Commented haggis", creator: @user
+    card.update! status: "drafted"
+
+    assert_empty search("haggis").cards
+  end
+
+  test "blank queries find nothing" do
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+    assert_empty search(nil).cards
+    assert search("").blank?
+  end
+
+  test "words extracts the searchable words in the query" do
+    assert_equal %w[ big logo ], search(" big  logo! ").words
+  end
+
+  test "matching text of a card is its description or the matching comment" do
+    cards(:logo).update! description: "The logo needs more space"
+    assert_equal "The logo needs more space", search("logo").matching_text_for(cards(:logo))
+
+    assert_equal "I agree.", search("agree").matching_text_for(cards(:logo))
+  end
