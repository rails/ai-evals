diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..e8b9d6c
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,26 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :containing, ->(term) do
+      words = Search.words_in(term)
+      words.any? ? words.reduce(all) { |cards, word| cards.containing_word(word) } : none
+    end
+
+    scope :containing_word, ->(word) do
+      with_title_containing(word).or(with_description_containing(word)).or(with_comment_containing(word))
+    end
+
+    scope :with_title_containing, ->(word) do
+      where("cards.title LIKE ?", Search.like_pattern(word))
+    end
+
+    scope :with_description_containing, ->(word) do
+      where(id: Search.rich_texts_containing(word, record_type: "Card", name: "description").select(:record_id))
+    end
+
+    scope :with_comment_containing, ->(word) do
+      where(id: Comment.with_body_containing(word).select(:card_id))
+    end
+  end
+end
