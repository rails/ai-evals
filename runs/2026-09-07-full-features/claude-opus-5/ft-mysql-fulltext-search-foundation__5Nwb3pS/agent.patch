--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,25 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 100
+  EXCERPT_LENGTH = 240
+
+  def search_highlight(text, search)
+    highlight text.to_s, search.words
+  end
+
+  def search_excerpt(card, search)
+    text = search.matching_text_for(card).to_s.squish
+
+    if text.present?
+      search_highlight search_snippet(text, search), search
+    end
+  end
+
+  private
+    def search_snippet(text, search)
+      if word = search.matched_word_in(text)
+        excerpt(text, word, radius: EXCERPT_RADIUS) || text.truncate(EXCERPT_LENGTH)
+      else
+        text.truncate(EXCERPT_LENGTH)
+      end
+    end
+end
