diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..8d6a8bb
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,70 @@
+# Finds cards by their title, description, or the body of any of their comments.
+#
+# Searches are always scoped to the boards the searching user can access at the
+# moment of the search, and drafted cards (and their comments) are never found.
+class Search
+  WORD_PATTERN = /[[:word:]]+(?:['’][[:word:]]+)*/
+
+  attr_reader :query, :user
+
+  class << self
+    def words_in(query)
+      query.to_s.scan(WORD_PATTERN).uniq
+    end
+
+    def rich_texts_containing(word, record_type:, name:)
+      ActionText::RichText
+        .where(record_type: record_type, name: name)
+        .where("action_text_rich_texts.body LIKE ?", like_pattern(word))
+    end
+
+    def like_pattern(word)
+      "%#{ActiveRecord::Base.sanitize_sql_like(word.to_s)}%"
+    end
+  end
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def words
+    @words ||= self.class.words_in(query)
+  end
+
+  def blank?
+    words.none?
+  end
+
+  def present?
+    !blank?
+  end
+
+  def cards
+    @cards ||= if blank?
+      Card.none
+    else
+      user.accessible_cards.published.containing(query).reverse_chronologically.preloaded
+    end
+  end
+
+  # The plain text where the query matched, so results can show it as an excerpt.
+  def matching_text_for(card)
+    description = card.description.to_plain_text
+
+    if matched_word_in(description)
+      description
+    else
+      matching_comment_for(card)&.body&.to_plain_text || description
+    end
+  end
+
+  def matched_word_in(text)
+    words.find { |word| text.to_s.downcase.include?(word.downcase) }
+  end
+
+  private
+    def matching_comment_for(card)
+      card.comments.containing(query).order(created_at: :desc, id: :desc).first
+    end
+end
