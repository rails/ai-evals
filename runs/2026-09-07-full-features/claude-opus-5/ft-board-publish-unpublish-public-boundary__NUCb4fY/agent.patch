+# Base for the pages of published boards, which are readable by anyone who
+# knows the board's secret publication key.
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+
+  layout "public"
+
+  before_action :set_board
+
+  private
+    def set_board
+      @board = Current.account.boards.published.find_by!(publication_key: publication_key)
+    end
+
+    def publication_key
+      params[:board_key] || params[:key]
+    end
+end
