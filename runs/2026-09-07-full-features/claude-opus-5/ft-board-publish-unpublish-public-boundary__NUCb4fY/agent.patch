diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..ec7fb88
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,35 @@
+<div class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <% url = public_board_url(board.publication_key) %>
+
+    <p class="margin-none-block-start">Anyone with this link can read this board — but no one can change anything.</p>
+
+    <div class="flex align-center gap-half">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" readonly aria-label="Public link to this board">
+
+      <%= button_to_copy_to_clipboard(url) do %>
+        <%= icon_tag "clipboard" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <div class="txt-align-center margin-block-start">
+      <%= button_to board_publication_path(board), method: :delete, class: "btn borderless txt-small", data: {
+            turbo_frame: "_top",
+            turbo_confirm: "Are you sure? The public link will stop working for everyone." } do %>
+        <span>Stop publishing this board</span>
+      <% end %>
+    </div>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to get a secret link that anyone can use to read it.</p>
+
+    <div class="txt-align-center margin-block-start">
+      <%= button_to board_publication_path(board), method: :post, class: "btn", data: { turbo_frame: "_top" } do %>
+        <%= icon_tag "clipboard" %>
+        <span>Publish this board</span>
+      <% end %>
+    </div>
+  <% end %>
+</div>
diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
