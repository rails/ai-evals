+<% @page_title = @board.name %>
+<% @body_class = "contained-scrolling" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @board.name %></span>
+  </h1>
+<% end %>
+
+<%= tag.div class: "card-columns hide-scrollbar", data: {
+      controller: "collapsible-columns",
+      collapsible_columns_board_value: @board.id,
+      collapsible_columns_collapsed_class: "is-collapsed",
+      collapsible_columns_expanded_class: "is-expanded",
+      collapsible_columns_no_transitions_class: "no-transitions",
+      collapsible_columns_title_not_visible_class: "is-off-screen",
+      native_prevent_pull_to_refresh: true } do %>
+  <div class="card-columns__left"></div>
+
+  <%= render "public/boards/show/column", board: @board, id: "maybe", title: "Maybe?", class: "cards--maybe",
+        count: @board.cards.awaiting_triage.count, page: @page, collapsed: false, maybe: true %>
+
+  <div class="card-columns__right">
+    <% @board.columns.sorted.each do |column| %>
+      <% cards = column.cards.active.latest.with_golden_first.preloaded %>
+
+      <%= render "public/boards/show/column", board: @board, id: dom_id(column), title: column.name,
+            class: "cards--doing", style: "--card-color: #{column.color};", count: cards.size, cards: cards,
+            url: public_board_column_path(@board.publication_key, column) %>
+    <% end %>
+  </div>
+<% end %>
