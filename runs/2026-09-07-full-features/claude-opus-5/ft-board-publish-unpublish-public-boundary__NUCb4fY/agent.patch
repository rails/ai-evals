+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to @board.name, public_board_path(@board.publication_key), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+<% end %>
+
+<section id="<%= dom_id(@card, :card_container) %>" class="card-perma" style="--card-color: <%= @card.color %>;">
+  <div class="card-perma__bg">
+    <%= card_article_tag @card, class: "card" do %>
+      <header class="card__header">
+        <div class="card__board">
+          <div class="card__board-name">
+            <span class="overflow-ellipsis"><%= @board.name %></span>
+          </div>
+        </div>
+
+        <%= render "cards/display/preview/tags", card: @card %>
+      </header>
+
+      <div class="card__body justify-space-between">
+        <div class="card__content">
+          <h1 class="card__title"><%= card_html_title(@card) %></h1>
+
+          <% unless @card.description.blank? %>
+            <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+              <%= @card.description %>
+            </div>
+          <% end %>
+
+          <%= render "public/cards/steps", card: @card %>
+        </div>
+
+        <% if @card.triaged? %>
+          <div class="card__stages">
+            <% @board.columns.sorted.each do |column| %>
+              <%= tag.span column.name, class: [ "card__column-name btn overflow-ellipsis", { "card__column-name--current": column == @card.column } ] %>
+            <% end %>
+          </div>
+        <% end %>
+
+        <%= render "cards/display/common/stamp", card: @card %>
+      </div>
+
+      <footer class="card__footer">
+        <%= render "public/cards/meta", card: @card %>
+        <%= render "cards/display/common/background", card: @card %>
+        <%= render "public/cards/reactions", reactable: @card %>
+      </footer>
+    <% end %>
+  </div>
+</section>
+
+<div class="comments gap center" style="--card-color: <%= @card.color %>" role="group" aria-label="Messages">
+  <%= render partial: "public/cards/comment", collection: @card.comments.preloaded.chronologically, as: :comment %>
+</div>
