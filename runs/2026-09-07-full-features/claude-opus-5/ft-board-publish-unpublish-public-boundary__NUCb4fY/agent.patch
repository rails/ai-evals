+<%
+  collapsed = local_assigns.fetch(:collapsed, true)
+  cards = local_assigns[:page]&.records || local_assigns[:cards]
+%>
+
+<%= tag.section id: id, tabindex: "0", style: local_assigns[:style],
+      class: token_list("cards", local_assigns[:class], "is-collapsed": collapsed, "is-expanded": !collapsed),
+      data: {
+        collapsible_columns_target: local_assigns.fetch(:maybe, false) ? "column maybeColumn" : "column",
+        column_name: title,
+        action: "turbo:before-morph-attribute->collapsible-columns#preventToggle focus->collapsible-columns#focusOnColumn"
+      } do %>
+  <div class="cards__transition-container" data-controller="css-variable-counter" data-css-variable-counter-property-name-value="--card-count">
+    <header class="cards__header">
+      <%= render "boards/show/expander", title: title, count: count, column_id: id %>
+      <%= render "boards/show/menu/maximize", column_path: url if local_assigns[:url] %>
+    </header>
+
+    <div class="cards__list hide-scrollbar">
+      <% if local_assigns[:page] %>
+        <% if page.used? %>
+          <%= with_automatic_pagination id, page do %>
+            <%= render "public/cards/previews", cards: cards, board: board %>
+          <% end %>
+        <% end %>
+      <% else %>
+        <%= render "public/cards/previews", cards: cards, board: board %>
+      <% end %>
+    </div>
+  </div>
+<% end %>
