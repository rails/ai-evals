diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..6bbdf3a
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards start out unpublished" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publishing generates a publication key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.publication_key.present?
+    assert_includes Board.published, @board
+  end
+
+  test "publishing twice keeps the same key" do
+    @board.publish
+    key = @board.publication_key
+
+    @board.publish
+    assert_equal key, @board.reload.publication_key
+  end
+
+  test "unpublishing throws the key away" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.reload.published?
+    assert_nil @board.publication_key
+    assert_not_includes Board.published, @board
+  end
+
+  test "public url includes the account slug and the publication key" do
+    @board.publish
+
+    assert_includes @board.public_url, "#{@board.account.slug}/public/boards/#{@board.publication_key}"
+  end
+
+  test "published boards are publicly accessible" do
+    assert_not @board.publicly_accessible?
+    @board.publish
+    assert @board.publicly_accessible?
+  end
+
+  test "cards and comments of a published board are publicly accessible" do
+    card = cards(:logo)
+    assert_not card.publicly_accessible?
+
+    @board.publish
+
+    assert card.reload.publicly_accessible?
+    drafted = cards(:buy_domain)
+    drafted.update! status: :drafted
+    assert_not drafted.publicly_accessible?, "Drafted cards are never public"
+  end
+end
