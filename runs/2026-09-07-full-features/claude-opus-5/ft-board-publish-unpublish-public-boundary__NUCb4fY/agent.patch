diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..d9c63bf
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,55 @@
+# Boards can be published, which makes them readable by anyone who knows their
+# secret public URL. Publishing generates a random key that's used to look the
+# board up publicly, and unpublishing throws that key away, breaking every link
+# that was shared before.
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLICATION_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    update! publication_key: generate_publication_key unless published?
+    self
+  end
+
+  def unpublish
+    update! publication_key: nil if published?
+    self
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  alias_method :public?, :published?
+
+  # Attachments on a published board are readable by anyone with its public URL.
+  def publicly_accessible?
+    published?
+  end
+
+  def public_url(**options)
+    if published?
+      Rails.application.routes.url_helpers.public_board_url publication_key, **public_url_options.merge(options)
+    end
+  end
+
+  private
+    def generate_publication_key
+      loop do
+        candidate = SecureRandom.base58(PUBLICATION_KEY_LENGTH)
+        break candidate unless Board.unscoped.exists?(publication_key: candidate)
+      end
+    end
+
+    def public_url_options
+      default_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options.presence || {}
+
+      default_options.merge(script_name: account.slug)
+    end
+end
