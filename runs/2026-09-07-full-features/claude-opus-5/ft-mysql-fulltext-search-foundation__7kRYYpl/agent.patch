diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..1c15974
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,20 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :with_title_matching,       ->(term) { where(Search.like_condition("cards.title", term)) }
+    scope :with_description_matching, ->(term) { joins(:rich_text_description).where(Search.like_condition("action_text_rich_texts.body", term)) }
+    scope :with_comment_matching,     ->(term) { where(id: Comment.with_body_matching(term).select(:card_id)) }
+
+    # Cards with a term in their title, in their description, or in the body of any of their comments.
+    scope :matching, ->(term) do
+      with_title_matching(term)
+        .or(where(id: Card.unscoped.with_description_matching(term)))
+        .or(with_comment_matching(term))
+    end
+
+    scope :matching_all, ->(terms) do
+      Array(terms).reduce(all) { |cards, term| cards.where(id: Card.unscoped.matching(term)) }
+    end
+  end
+end
