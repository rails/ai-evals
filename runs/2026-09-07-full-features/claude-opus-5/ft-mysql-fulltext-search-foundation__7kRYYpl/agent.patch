diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..bc051e7
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,22 @@
+<article class="search-result panel flex flex-column gap-half txt-align-start" id="<%= dom_id(card, :search_result) %>">
+  <h2 class="txt-normal">
+    <%= link_to highlight_card_title(card, search.terms), card, data: { turbo_frame: "_top" } %>
+  </h2>
+
+  <div class="flex gap-half align-center txt-small translucent">
+    <span class="overflow-ellipsis"><%= card.board.name %></span>
+    <span>#<%= card.number %></span>
+    <%= local_datetime_tag card.created_at, style: :daysago %>
+  </div>
+
+  <% if snippet = highlight_search_snippet(card.description, search.terms) %>
+    <p class="txt-small txt-break"><%= snippet %></p>
+  <% end %>
+
+  <% search.comments_in(card).each do |comment| %>
+    <blockquote class="txt-small txt-break" id="<%= dom_id(comment, :search_result) %>">
+      <strong><%= comment.creator.familiar_name %>:</strong>
+      <%= highlight_search_snippet(comment.body, search.terms) %>
+    </blockquote>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..7fdbf75
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,28 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search center margin flex flex-column gap">
+  <%= form_with url: search_path, method: :get, class: "full-width", data: { turbo_action: "advance" } do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…",
+          class: "input full-width", autofocus: true, autocorrect: "off", autocomplete: "off",
+          aria: { label: "Search" }, data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if @search.blank? %>
+    <div class="blank-slate">Search for anything written in a card or a comment</div>
+  <% elsif @page.empty? %>
+    <div class="blank-slate">Nothing matches “<%= @search.query %>”</div>
+  <% else %>
+    <%= with_automatic_pagination :search_results, @page, class: "flex flex-column gap full-width" do %>
+      <%= render partial: "searches/result", collection: @page.records, as: :card, locals: { search: @search } %>
+    <% end %>
+  <% end %>
+</section>
