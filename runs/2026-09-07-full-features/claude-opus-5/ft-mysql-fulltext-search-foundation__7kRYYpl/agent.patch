+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "show finds cards by title" do
+    get search_url(q: "logo")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:logo), :search_result)
+    assert_select "mark", text: "logo"
+  end
+
+  test "show finds cards by description" do
+    cards(:layout).update! description: "The gutter is way too wide"
+
+    get search_url(q: "gutter")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:layout), :search_result)
+    assert_select "mark", text: "gutter"
+  end
+
+  test "show finds cards by comment body" do
+    get search_url(q: "overflowing")
+
+    assert_response :success
+    assert_select "#" + dom_id(cards(:layout), :search_result)
+    assert_select "#" + dom_id(comments(:layout_overflowing_david), :search_result)
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "show finds nothing without a query" do
+    get search_url
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "show finds nothing matching" do
+    get search_url(q: "nothingtoseehere")
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "show skips cards on boards without access" do
+    with_current_user :kevin do
+      boards(:private).cards.create! title: "The secret logo", creator: users(:kevin), status: :published
+    end
+
+    get search_url(q: "secret")
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "show skips drafted cards" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create! title: "A drafted secret", creator: users(:kevin), status: :drafted
+    end
+
+    get search_url(q: "secret")
+
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "show requires authentication" do
+    sign_out
+
+    get search_url(q: "logo")
+
+    assert_redirected_to "/session/new"
+  end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..a71c572
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+  end
+
+  test "finding cards by title" do
+    assert_equal [ cards(:logo) ], search("logo").cards
+  end
+
+  test "finding cards by description" do
+    cards(:layout).update! description: "The gutter is way too wide"
+
+    assert_equal [ cards(:layout) ], search("gutter").cards
+  end
+
+  test "finding cards by comment body" do
+    assert_equal [ cards(:layout) ], search("overflowing").cards
+  end
+
+  test "finding cards regardless of case" do
+    assert_equal [ cards(:logo) ], search("LoGo").cards
+  end
+
+  test "finding cards matching every term" do
+    assert_equal [ cards(:logo) ], search("logo enough").cards
+    assert_empty search("logo unrelated").cards
+  end
+
+  test "returning cards newest first" do
+    cards(:logo).update! created_at: 2.days.ago
+    with_current_user :david do
+      cards(:layout).update! created_at: 1.day.ago, title: "The logo layout is broken"
+    end
+
+    assert_equal [ cards(:layout), cards(:logo) ], search("logo").cards
+  end
+
+  test "returning nothing for a blank query" do
+    assert_predicate search(" "), :blank?
+    assert_empty search(" ").cards
+  end
+
+  test "skipping cards on boards without access" do
+    card = create_card_in boards(:private), title: "The logo of the secret project"
+
+    assert_empty search("secret").cards
+    assert_not_includes search("logo").cards, card
+    assert_includes Search.new("secret", user: users(:kevin)).cards, card
+  end
+
+  test "skipping drafted cards" do
+    create_card_in boards(:writebook), title: "A drafted logo idea", status: :drafted
+
+    assert_equal [ cards(:logo) ], search("logo").cards
+  end
+
+  test "skipping comments on drafted cards" do
+    card = create_card_in boards(:writebook), title: "Just thinking"
+    card.comments.create! creator: users(:kevin), body: "Something spectacular"
+
+    assert_equal [ card ], search("spectacular").cards
+
+    card.update! status: :drafted
+    assert_empty search("spectacular").cards
+  end
+
+  test "treating LIKE wildcards literally" do
+    assert_empty search("%").cards
+    assert_empty search("_ogo").cards
+
+    cards(:logo).update! description: "It is only 50% as big as it should be"
+    assert_equal [ cards(:logo) ], search("50%").cards
+  end
+
+  test "ignoring terms beyond the maximum" do
+    assert_equal Search::MAX_TERMS, search("one two three four five six seven").terms.size
+  end
+
+  test "listing the comments matching in a card" do
+    assert_equal [ comments(:layout_overflowing_david) ], search("overflowing").comments_in(cards(:layout))
+    assert_empty search("logo").comments_in(cards(:logo))
+  end
+
+  private
+    def search(query)
+      Search.new(query, user: @user)
+    end
+
+    def create_card_in(board, **attributes)
+      with_current_user :kevin do
+        board.cards.create! **attributes.with_defaults(creator: users(:kevin), status: :published)
+      end
+    end
+end
