diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..05fb8ca
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,55 @@
+class Search
+  MAX_TERMS = 5
+  ESCAPE_CHARACTER = "!"
+
+  attr_reader :query, :terms
+
+  class << self
+    # Portable LIKE condition for finding a term anywhere in a column, wildcards and all.
+    def like_condition(column, term)
+      ActiveRecord::Base.sanitize_sql_array \
+        [ "#{column} LIKE :pattern ESCAPE :escape_character", pattern: pattern_for(term), escape_character: ESCAPE_CHARACTER ]
+    end
+
+    def pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term.to_s, ESCAPE_CHARACTER)}%"
+    end
+  end
+
+  def initialize(query, user: Current.user)
+    @query = query.to_s.strip
+    @user  = user
+    @terms = @query.split.first(MAX_TERMS)
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    matching_cards.reverse_chronologically
+  end
+
+  def comments_in(card)
+    if blank?
+      Comment.none
+    else
+      card.comments.matching_any(terms).chronologically
+    end
+  end
+
+  private
+    attr_reader :user
+
+    def matching_cards
+      if blank?
+        Card.none
+      else
+        searchable_cards.matching_all(terms)
+      end
+    end
+
+    def searchable_cards
+      user.accessible_cards.published
+    end
+end
