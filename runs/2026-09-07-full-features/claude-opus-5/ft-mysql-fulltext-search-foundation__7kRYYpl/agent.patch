+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,23 @@
+module SearchesHelper
+  SNIPPET_LENGTH = 240
+
+  def highlight_card_title(card, terms)
+    highlight_terms card_html_title(card), terms
+  end
+
+  def highlight_search_snippet(content, terms)
+    text = format_excerpt(content, length: SNIPPET_LENGTH * 20)
+
+    highlight_terms h(snippet_around(text, terms)), terms if text.present?
+  end
+
+  private
+    def highlight_terms(html, terms)
+      highlight html, terms, highlighter: '<mark>\1</mark>', sanitize: false
+    end
+
+    def snippet_around(text, terms)
+      terms.lazy.filter_map { |term| excerpt(text, term, radius: SNIPPET_LENGTH / 2, separator: " ") }.first ||
+        text.truncate(SNIPPET_LENGTH)
+    end
+end
