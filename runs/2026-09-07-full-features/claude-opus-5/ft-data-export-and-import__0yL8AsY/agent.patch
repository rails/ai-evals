+require "test_helper"
+
+class ExportDownloadTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts("37s")
+    @export = @account.exports.create!(kind: Export::ACCOUNT, creator: users(:kevin))
+    @export.package_now
+  end
+
+  test "the link in the email downloads the export" do
+    sign_in_as :kevin
+
+    get emailed_download_url
+
+    assert_response :redirect
+    assert_match %r{rails/active_storage}, response.location
