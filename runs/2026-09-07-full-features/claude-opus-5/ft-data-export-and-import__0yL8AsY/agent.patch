+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,14 @@
+# Moving accounts in and out of a Fizzy instance, as a single zip file.
+#
+#   accounts/<id>.json          one JSON document per record, per model
+#   boards/<id>.json
+#   cards/<id>.json
+#   ...
+#   files/<blob id>             every picture and file, byte for byte
+#   manifest.json               what this archive is and where it came from
+module Account::DataTransfer
+  # Bumped whenever the layout of an archive changes in a way older Fizzys can't read.
+  FORMAT_VERSION = 1
+
+  MANIFEST_PATH = "manifest.json"
+end
