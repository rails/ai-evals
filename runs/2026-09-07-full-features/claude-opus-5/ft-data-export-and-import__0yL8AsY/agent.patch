+    <p>
+      Your import is done.
+      <%= link_to "Go to #{@import.imported_account.name}", root_url(script_name: @import.imported_account.slug), class: "btn btn--link", data: { turbo: false } %>
+    </p>
+  <% elsif @import.failed? %>
+    <p class="txt-negative">
+      We couldn't complete this import, so nothing was created.
+      <% if @import.error_message.present? %>
+        <br><em><%= @import.error_message %></em>
+      <% end %>
+    </p>
+    <%= link_to "Try another file", new_account_import_path, class: "btn" %>
+  <% else %>
+    <p class="txt-subtle">We're importing your account. We'll email you when it's done.</p>
+  <% end %>
+</section>
