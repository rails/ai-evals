diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..9a9095b
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,157 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:david)
+    @board = boards(:writebook)
+
+    visit board_url(@board)
+  end
+
+  test "dragging a card into a column triages it" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    drag card, into: dom_id(column)
+
+    assert_card_in dom_id(column), card
+    assert_eventually { card.reload.column == column }
+  end
+
+  test "dragging a card into Done closes it" do
+    card = cards(:buy_domain)
+
+    drag card, into: "closed-cards"
+
+    assert_card_in "closed-cards", card
+    assert_eventually { card.reload.closed? }
+  end
+
+  test "dragging a card into Not Now postpones it" do
+    card = cards(:buy_domain)
+
+    drag card, into: "not-now"
+
+    assert_card_in "not-now", card
+    assert_eventually { card.reload.postponed? }
+  end
+
+  test "dragging a card into Maybe? sends it back to triage" do
+    card = cards(:logo)
+
+    expand dom_id(columns(:writebook_triage))
+    drag card, into: "maybe"
+
+    assert_card_in "maybe", card
+    assert_eventually { card.reload.column.nil? }
+  end
+
+  test "dragging a closed card into a column reopens it there" do
+    card = cards(:shipping)
+    column = columns(:writebook_review)
+
+    expand "closed-cards"
+    drag card, into: dom_id(column)
+
+    assert_card_in dom_id(column), card
+    assert_eventually { card.reload.open? && card.column == column }
+  end
+
+  test "the dragged card dims and the column under it lights up" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    start_dragging card, over: dom_id(column)
+
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+  end
+
+  test "a card dropped into a column takes its color" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    drag card, into: dom_id(column)
+
+    assert_selector "##{dom_id(card, :article)}[style*='--card-color: #{column.color}']", visible: :all
+  end
+
+  test "the counts of both columns are updated right away" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    assert_count_in "maybe", 1
+    assert_count_in dom_id(column), 1
+
+    drag card, into: dom_id(column)
+
+    assert_count_in "maybe", 0
+    assert_count_in dom_id(column), 2
+  end
+
+  test "the board stays put once the change reaches the server" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    wait_for_cable_subscriptions
+    drag card, into: dom_id(column)
+    assert_eventually { card.reload.column == column }
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_card_in dom_id(column), card
+    assert_count_in dom_id(column), 2
+    assert_count_in "maybe", 0
+  end
+
+  test "dropping a card back into its own column leaves it alone" do
+    card = cards(:buy_domain)
+
+    drag card, into: "maybe"
+
+    assert_card_in "maybe", card
+    assert_count_in "maybe", 1
+    assert_nil card.reload.column
+  end
+
+  private
+    def drag(card, into:)
+      find("##{dom_id(card, :article)}").drag_to find("##{into}")
+    end
+
+    def start_dragging(card, over:)
+      execute_script <<~JS
+        const dataTransfer = new DataTransfer()
+        document.getElementById("#{dom_id(card, :article)}").dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        document.getElementById("#{over}").dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def expand(column_id)
+      find("##{column_id} .cards__expander").click
+    end
+
+    def assert_card_in(column_id, card)
+      assert_selector "##{column_id} ##{dom_id(card, :article)}", visible: :all
+    end
+
+    def assert_count_in(column_id, count)
+      assert_selector "##{column_id} .cards__expander-count", text: count.to_s, visible: :all
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def assert_eventually(timeout: 5)
+      deadline = Time.now + timeout
+
+      until yield
+        flunk "The change never reached the server" if Time.now > deadline
+        sleep 0.1
+      end
+    end
+end
