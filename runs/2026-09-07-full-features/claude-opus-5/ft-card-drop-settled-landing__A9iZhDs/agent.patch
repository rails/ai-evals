diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..60bb0af
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,132 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+// Moves cards between the columns of a board by dragging them around.
+//
+// Columns keep their own order, so dropping a card changes its column or its status, never its
+// position within a column. Cards move in the DOM as soon as they are dropped, leaving the board
+// settled right away, while the change is saved in the background. When saving fails, the card
+// goes back to where it was dragged from.
+//
+// Each column declares where its cards land with a destination param: the id of a column, or one
+// of the "stream", "not_now" and "closed" statuses. Each card carries the urls used to save it.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "column" ]
+
+  // Dragging isn't available on mobile, where columns are shown one at a time.
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  dragStart({ currentTarget, dataTransfer }) {
+    this.draggedCard = currentTarget
+    dataTransfer.effectAllowed = "move"
+    dataTransfer.setData("text/plain", currentTarget.id)
+
+    // Dim the card once the browser has taken the snapshot it drags around
+    requestAnimationFrame(() => currentTarget.classList.add(this.draggedItemClass))
+  }
+
+  dragOver(event) {
+    if (this.#droppableInto(event.currentTarget)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(event.currentTarget)
+    }
+  }
+
+  dragLeave({ currentTarget, relatedTarget }) {
+    if (!currentTarget.contains(relatedTarget)) {
+      currentTarget.classList.remove(this.hoverContainerClass)
+    }
+  }
+
+  drop(event) {
+    if (this.#droppableInto(event.currentTarget)) {
+      event.preventDefault()
+      this.#move(this.draggedCard, event.currentTarget, event.params)
+    }
+  }
+
+  dragEnd() {
+    this.draggedCard?.classList.remove(this.draggedItemClass)
+    this.draggedCard = null
+    this.#highlight(null)
+  }
+
+  // Private
+
+  async #move(card, column, { destination, cardColor }) {
+    const origin = { list: card.parentElement, sibling: card.nextElementSibling, color: this.#colorOf(card) }
+
+    this.#dropInto(column, card, cardColor)
+
+    const response = await this.#save(card, destination)
+
+    if (!response.ok) {
+      this.#returnTo(origin, card)
+    }
+  }
+
+  #dropInto(column, card, color) {
+    this.#recount(this.#columnFor(card), -1)
+    this.#listIn(column).prepend(card)
+    this.#recolor(card, color)
+    this.#recount(column, +1)
+  }
+
+  #returnTo({ list, sibling, color }, card) {
+    this.#recount(this.#columnFor(card), -1)
+    list.insertBefore(card, list.contains(sibling) ? sibling : null)
+    this.#recolor(card, color)
+    this.#recount(this.#columnFor(card), +1)
+  }
+
+  #save(card, destination) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = card.dataset
+
+    switch (destination) {
+      case "stream":  return destroy(cardTriageUrl, { responseKind: "json" })
+      case "not_now": return post(cardNotNowUrl, { responseKind: "json" })
+      case "closed":  return post(cardClosureUrl, { responseKind: "json" })
+      default:        return post(cardTriageUrl, { body: { column_id: destination }, responseKind: "json" })
+    }
+  }
+
+  // Keep the count in the column header up to date while the server catches up
+  #recount(column, amount) {
+    const counter = column?.querySelector(".cards__expander-count")
+
+    if (counter) {
+      const count = Math.max(0, parseInt(counter.textContent, 10) + amount)
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  #droppableInto(column) {
+    return this.draggedCard && this.#listIn(column) && this.#columnFor(this.draggedCard) !== column
+  }
+
+  #highlight(column) {
+    this.columnTargets.forEach(target => target.classList.toggle(this.hoverContainerClass, target === column))
+  }
+
+  // Cards take the color of the column they are dropped into
+  #recolor(card, color) {
+    card.style.setProperty("--card-color", color)
+  }
+
+  #colorOf(card) {
+    return card.style.getPropertyValue("--card-color")
+  }
+
+  #columnFor(card) {
+    return card.closest(`[data-${this.identifier}-target~="column"]`)
+  }
+
+  #listIn(column) {
+    return column.querySelector(".cards__list")
+  }
+}
