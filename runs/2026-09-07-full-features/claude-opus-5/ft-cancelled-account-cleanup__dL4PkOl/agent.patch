--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,33 @@
+# Cancelled accounts stay around, inactive, during a grace period so people can change
+# their mind. Once it elapses, they are incinerated: every record they own is permanently
+# removed from the database, and their files are purged from storage.
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, ->(as_of: Time.current) do
+      joins(:cancellation).where(cancellation: { created_at: ..(as_of - INCINERATION_GRACE_PERIOD) })
+    end
+  end
+
+  class_methods do
+    def incinerate_due(as_of: Time.current)
+      due_for_incineration(as_of: as_of).find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    Current.with_account(self) do
+      # There is nothing left to account for once everything is gone, and the
+      # ledger entries would reference an account that no longer exists.
+      Storage::Entry.without_tracking do
+        transaction do
+          Storage::Entry.where(account: self).delete_all
+          destroy
+        end
+      end
+    end
+  end
 end
