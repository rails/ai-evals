diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..f760cdf
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled before the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..6729dd3
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration only includes accounts cancelled before the grace period" do
+    assert_empty Account.due_for_incineration
+
+    @account.cancel(initiated_by: @user)
+
+    assert_empty Account.due_for_incineration
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_equal [ @account ], Account.due_for_incineration.to_a
+  end
+
+  test "due_for_incineration excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+    @account.reactivate
+
+    assert_empty Account.due_for_incineration
+  end
+
+  test "incinerate removes every record belonging to the account" do
+    create_card_with_attachment
+
+    perform_enqueued_jobs do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty tables_with_records_for(@account)
+    assert_empty ActiveStorage::Blob.where(account_id: @account.id)
+  end
+
+  test "incinerate leaves other accounts untouched" do
+    assert_no_changes -> { accounts(:initech).cards.count } do
+      @account.incinerate
+    end
+
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "incinerate_due only incinerates the accounts past the grace period" do
+    @account.cancel(initiated_by: @user)
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    accounts(:initech).cancel(initiated_by: users(:mike))
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  test "incinerate_due leaves active accounts alone" do
+    assert_no_difference -> { Account.count } do
+      Account.incinerate_due
+    end
+  end
+
+  private
+    def create_card_with_attachment
+      Current.set(account: @account, user: @user) do
+        card = @account.boards.first.cards.create!(creator: @user, title: "Doomed", status: "published")
+        card.image.attach io: StringIO.new("hello"), filename: "hello.txt", content_type: "text/plain"
+      end
+    end
+
+    def tables_with_records_for(account)
+      connection = ApplicationRecord.lease_connection
+
+      connection.tables.select do |table|
+        connection.column_exists?(table, :account_id) && count_records(table, account, connection) > 0
+      end
+    end
+
+    def count_records(table, account, connection)
+      connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id)}").to_i
+    end
+end
