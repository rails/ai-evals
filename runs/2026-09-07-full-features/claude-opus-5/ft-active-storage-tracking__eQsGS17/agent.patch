@@ -0,0 +1,9 @@
+namespace :storage do
+  desc "Recalculate the storage used (Account#bytes_used and Board#bytes_used) by every account and board"
+  task recalculate_usage: :environment do
+    Account.find_each do |account|
+      account.recalculate_bytes_used_now
+      puts "#{account.name}: #{ActiveSupport::NumberHelper.number_to_human_size(account.bytes_used)}"
+    end
+  end
+end
diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..55f5701
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,200 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "accounts and boards start out using no storage" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counting card images" do
+    assert_bytes_used blob.byte_size do
+      attach_card_image
+    end
+  end
+
+  test "counting files embedded in card descriptions" do
+    assert_bytes_used blob.byte_size do
+      @card.update! description: embedded_attachment_html
+    end
+  end
+
+  test "counting files embedded in comments" do
+    assert_bytes_used blob.byte_size do
+      @card.comments.create! body: embedded_attachment_html, creator: users(:david)
+    end
+  end
+
+  test "counting files embedded in board descriptions" do
+    assert_bytes_used blob.byte_size do
+      @board.update! public_description: embedded_attachment_html
+    end
+  end
+
+  test "not counting avatars" do
+    assert_bytes_used 0 do
+      users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+  end
+
+  test "not counting image variants" do
+    assert_bytes_used blob.byte_size do
+      @card.update! description: embedded_attachment_html
+    end
+
+    assert_bytes_used 0 do
+      @card.description.embeds.first.variant(:small).processed
+    end
+  end
+
+  test "removing a card image stops counting it" do
+    track_storage_usage_of { attach_card_image }
+
+    assert_bytes_used(-blob.byte_size) { @card.image.purge_later }
+  end
+
+  test "replacing a card image counts only the replacement" do
+    track_storage_usage_of { attach_card_image }
+
+    assert_bytes_used other_blob.byte_size - blob.byte_size do
+      @card.image.attach other_blob
+    end
+  end
+
+  test "editing a comment to drop an embedded file stops counting it" do
+    comment = nil
+
+    assert_bytes_used blob.byte_size do
+      comment = @card.comments.create! body: embedded_attachment_html, creator: users(:david)
+    end
+
+    assert_bytes_used(-blob.byte_size) { comment.update! body: "Never mind" }
+  end
+
+  test "destroying a comment stops counting its embedded files" do
+    comment = nil
+
+    assert_bytes_used blob.byte_size do
+      comment = @card.comments.create! body: embedded_attachment_html, creator: users(:david)
+    end
+
+    assert_bytes_used(-blob.byte_size) { comment.destroy }
+  end
+
+  test "destroying a card stops counting its attachments" do
+    track_storage_usage_of { attach_card_image }
+
+    assert_bytes_used(-blob.byte_size) { @card.destroy }
+  end
+
+  test "destroying a board stops counting everything on it" do
+    track_storage_usage_of do
+      @board.update! public_description: embedded_attachment_html
+      attach_card_image
+    end
+
+    assert_equal blob.byte_size * 2, @account.reload.bytes_used
+
+    track_storage_usage_of { @board.destroy }
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card to another board moves the storage used by it and its comments" do
+    track_storage_usage_of do
+      attach_card_image
+      @card.comments.create! body: embedded_attachment_html, creator: users(:david)
+    end
+
+    other_board = boards(:private)
+
+    track_storage_usage_of { @card.move_to other_board }
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size * 2, other_board.reload.bytes_used
+    assert_equal blob.byte_size * 2, @account.reload.bytes_used
+  end
+
+  test "a board counts only its own attachments, while its account counts them all" do
+    other_board = boards(:private)
+    other_card = other_board.cards.create! title: "Confidential", creator: users(:kevin)
+
+    track_storage_usage_of do
+      attach_card_image
+      other_card.image.attach other_blob
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal other_blob.byte_size, other_board.reload.bytes_used
+    assert_equal blob.byte_size + other_blob.byte_size, @account.reload.bytes_used
+    assert_equal 0, accounts(:initech).reload.bytes_used
+  end
+
+  test "recalculating usage that was never tracked" do
+    attach_card_image
+    @card.comments.create! body: embedded_attachment_html, creator: users(:david)
+    clear_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+
+    @account.recalculate_bytes_used_now
+
+    assert_equal blob.byte_size * 2, @board.reload.bytes_used
+    assert_equal blob.byte_size * 2, @account.reload.bytes_used
+  end
+
+  test "recalculating usage in the background" do
+    attach_card_image
+    clear_enqueued_jobs
+
+    @board.recalculate_bytes_used_later
+    @account.recalculate_bytes_used_later
+    perform_enqueued_jobs
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  private
+    def assert_bytes_used(bytes, &block)
+      board_before, account_before = @board.reload.bytes_used, @account.reload.bytes_used
+
+      track_storage_usage_of(&block)
+
+      assert_equal board_before + bytes, @board.reload.bytes_used, "Board#bytes_used"
+      assert_equal account_before + bytes, @account.reload.bytes_used, "Account#bytes_used"
+    end
+
+    def track_storage_usage_of
+      yield
+      perform_enqueued_jobs only: [ StorageUsage::TrackingJob, StorageUsage::TransferJob, StorageUsage::RecalculationJob ]
+    end
+
+    def attach_card_image
+      @card.image.attach blob
+    end
+
+    def embedded_attachment_html
+      ActionText::Attachment.from_attachable(blob).to_html
+    end
+
+    def blob
+      @blob ||= create_blob "moon.jpg", "image/jpeg"
+    end
+
+    def other_blob
+      @other_blob ||= create_blob "avatar.png", "image/png"
+    end
+
+    def create_blob(filename, content_type)
+      ActiveStorage::Blob.create_and_upload! io: file_fixture(filename).open, filename: filename, content_type: content_type
+    end
