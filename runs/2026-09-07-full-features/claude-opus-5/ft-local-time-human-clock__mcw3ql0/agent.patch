diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..b54479f
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time_tag renders the raw timestamp for the browser to format" do
+    assert_dom_equal <<~HTML.strip, local_time_tag(Time.utc(2025, 9, 12, 13, 42))
+      <time class="local-time-value" datetime="2025-09-12T13:42:00Z" data-controller="local-time" data-local-time-format-value="relative"></time>
+    HTML
+  end
+
+  test "local_time_tag renders no words, so the HTML can be cached and shared between timezones" do
+    assert_equal "", Nokogiri::HTML::DocumentFragment.parse(local_time_tag(Time.utc(2025, 9, 12, 13, 42))).text
+  end
+
+  test "local_time_tag renders the same HTML, whatever the server's timezone" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    from_new_york = Time.use_zone("America/New_York") { local_time_tag(time.in_time_zone) }
+    from_madrid = Time.use_zone("Europe/Madrid") { local_time_tag(time.in_time_zone) }
+
+    assert_includes from_new_york, 'datetime="2025-09-12T13:42:00Z"'
+    assert_equal from_new_york, from_madrid
+  end
+
+  test "local_time_tag accepts a format" do
+    assert_includes local_time_tag(Time.utc(2025, 9, 12), format: :date_and_time),
+      'data-local-time-format-value="date_and_time"'
+  end
+
+  test "local_time_tag accepts a date" do
+    assert_includes local_time_tag(Date.new(2025, 9, 12), format: :weekday),
+      'data-local-time-format-value="weekday"'
+  end
+
+  test "local_time_tag merges classes and data attributes" do
+    html = local_time_tag Time.utc(2025, 9, 12), class: "card__timestamp", data: { turbo_permanent: true }
+
+    assert_includes html, 'class="local-time-value card__timestamp"'
+    assert_includes html, 'data-controller="local-time"'
+    assert_includes html, 'data-turbo-permanent="true"'
+  end
+end
diff --git a/test/integration/local_times_test.rb b/test/integration/local_times_test.rb
new file mode 100644
index 0000000..3f97532
--- /dev/null
+++ b/test/integration/local_times_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class LocalTimesTest < ActionDispatch::IntegrationTest
+  include CachingTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    sign_in_as :david
+  end
+
+  test "times are sent as raw timestamps for the browser to render" do
+    get card_path(@card)
+
+    assert_select "time[datetime][data-controller=?]", "local-time", minimum: 1
+    assert_select "time", text: ""
+  end
+
+  test "cached HTML reads the same for viewers in every timezone" do
+    with_actionview_partial_caching do
+      cookies[:timezone] = "Asia/Tokyo"
+      get card_path(@card)
+      timestamps_in_tokyo = timestamps_in(response.body)
+
+      cookies[:timezone] = "America/New_York"
+      get card_path(@card)
+
+      assert_equal timestamps_in_tokyo, timestamps_in(response.body)
+      assert_no_match(/\d{1,2}:\d{2}\s?[AP]M/i, response.body)
+    end
+  end
+
+  private
+    def timestamps_in(body)
+      Nokogiri::HTML(body).css("time").map { |time| [ time["datetime"], time.text ] }
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..254da1e
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,125 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  TIMEZONE = "America/New_York"
+
+  setup do
+    use_browser_timezone TIMEZONE
+    sign_in_as(users(:david))
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  teardown do
+    use_browser_timezone nil
+  end
+
+  test "a comment from today reads as a time of day" do
+    @comment.update! created_at: local_time(days_from_today: 0)
+
+    assert_comment_timestamp "1:42 PM"
+  end
+
+  test "a comment from last night reads as yesterday" do
+    @comment.update! created_at: local_time(days_from_today: -1)
+
+    assert_comment_timestamp "yesterday"
+  end
+
+  test "a comment from earlier in the week reads as days ago" do
+    @comment.update! created_at: local_time(days_from_today: -5)
+
+    assert_comment_timestamp "5 days ago"
+  end
+
+  test "a comment from a while back reads as a date" do
+    @comment.update! created_at: local_time(days_from_today: -40)
+
+    assert_comment_timestamp @comment.created_at.in_time_zone(TIMEZONE).strftime("%b %-d")
+  end
+
+  test "the same timestamp reads in each viewer's own timezone" do
+    @comment.update! created_at: local_time(days_from_today: 0)
+
+    assert_comment_timestamp "1:42 PM"
+
+    use_browser_timezone "Europe/Madrid"
+
+    assert_comment_timestamp @comment.created_at.in_time_zone("Europe/Madrid").strftime("%l:%M %p").strip
+  end
+
+  test "a card auto-closing overnight reads as tomorrow" do
+    assert_closure_notice_timestamp "tomorrow", auto_closing_in_days: 1
+  end
+
+  test "a card auto-closing further out reads as days from now" do
+    assert_closure_notice_timestamp "in 3 days", auto_closing_in_days: 3
+  end
+
+  test "a card auto-closing months out reads as months from now" do
+    assert_closure_notice_timestamp "in 3 months", auto_closing_in_days: 90
+  end
+
+  test "a rendered time survives a refresh morphing the page" do
+    @comment.update! created_at: local_time(days_from_today: -1)
+
+    assert_comment_timestamp "yesterday"
+    refresh_card_elsewhere @comment.card
+
+    assert_selector "h1", text: "Refreshed elsewhere", wait: 5
+    assert_comment_timestamp "yesterday", visit: false
+  end
+
+  test "every timestamp in the app is rendered by the browser" do
+    [ board_url(boards(:writebook)), card_url(cards(:logo)), events_url, notifications_url, my_access_tokens_url ].each do |url|
+      visit url
+
+      assert_selector "time", visible: :all, minimum: 1
+      assert_no_selector "time:empty", visible: :all
+    end
+  end
+
+  private
+    def local_time(days_from_today:)
+      ActiveSupport::TimeZone[TIMEZONE].now.advance(days: days_from_today).change(hour: 13, min: 42)
+    end
+
+    # Times are capitalized by CSS in places, so match them case-insensitively.
+    def assert_comment_timestamp(text, visit: true)
+      visit card_url(@comment.card) if visit
+
+      within "##{dom_id(@comment)}" do
+        assert_selector ".comment__permalink-title time", text: /\A#{Regexp.escape(text)}\z/i
+      end
+    end
+
+    def assert_closure_notice_timestamp(text, auto_closing_in_days:)
+      card = cards(:layout)
+      card.update! last_active_at: local_time(days_from_today: auto_closing_in_days) - card.auto_postpone_period
+
+      visit card_url(card)
+
+      within "##{dom_id(card, :closure_notice)}" do
+        assert_selector "time", text: /\A#{Regexp.escape(text)}\z/i
+      end
+    end
+
+    def refresh_card_elsewhere(card)
+      wait_for_cable_subscriptions
+
+      Current.user = users(:kevin)
+      card.update! title: "Refreshed elsewhere"
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+
+    def use_browser_timezone(timezone)
+      page.driver.browser.execute_cdp "Emulation.setTimezoneOverride", timezoneId: timezone.to_s
+    end
+end
