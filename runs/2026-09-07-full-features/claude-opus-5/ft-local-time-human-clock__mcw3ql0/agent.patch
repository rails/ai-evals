diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..13a6b52 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,12 @@
 module TimeHelper
+  # Renders a timestamp for the browser to format, in the viewer's own timezone,
+  # rather than baking the server's clock into HTML we want to cache and share
+  # between people. See the local-time Stimulus controller for the formats.
+  def local_time_tag(time, format: :relative, **attributes)
+    tag.time \
+      class: token_list("local-time-value", attributes.delete(:class)),
+      datetime: time.to_time.utc.iso8601,
+      data: { controller: "local-time", local_time_format_value: format, **attributes.delete(:data).to_h },
+      **attributes
+  end
 end
