diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..4574cd1
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,183 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+
+    @board = boards(:writebook)
+    @triage = columns(:writebook_triage)
+    @in_progress = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card into a column" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: dom_id(@in_progress)
+
+    assert_card_in_column card, dom_id(@in_progress)
+    assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+    assert_saved { card.reload.column == @in_progress }
+  end
+
+  test "dragging a card into another card's column" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: dom_id(@triage), on: dom_id(cards(:layout), :article)
+
+    assert_card_in_column card, dom_id(@triage)
+    assert_saved { card.reload.column == @triage }
+  end
+
+  test "dragging a card back to the stream" do
+    visit board_url(@board)
+    card = cards(:text)
+
+    expand_column dom_id(@in_progress)
+    drag_card_to card, column: "maybe"
+
+    assert_card_in_column card, "maybe"
+    assert_saved { card.reload.awaiting_triage? }
+  end
+
+  test "dragging a card to Not Now" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: "not-now"
+
+    assert_card_in_column card, "not-now"
+    assert_saved { card.reload.postponed? }
+  end
+
+  test "dragging a card to Done" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: "closed-cards"
+
+    assert_card_in_column card, "closed-cards"
+    assert_saved { card.reload.closed? }
+  end
+
+  test "dragging a closed card into a column reopens it" do
+    visit board_url(@board)
+    card = cards(:shipping)
+
+    expand_column "closed-cards"
+    drag_card_to card, column: dom_id(@in_progress)
+
+    assert_card_in_column card, dom_id(@in_progress)
+    assert_saved { card.reload.open? && card.column == @in_progress }
+  end
+
+  test "dropping a card in its own column leaves it alone" do
+    visit board_url(@board)
+    card = cards(:text)
+
+    expand_column dom_id(@in_progress)
+    drag_card_to card, column: dom_id(@in_progress)
+
+    assert_card_in_column card, dom_id(@in_progress)
+    assert_no_changes -> { card.reload.updated_at }, "The card was moved" do
+      sleep 0.5
+    end
+  end
+
+  test "a dropped card lands where its new column sorts it, and stays put" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: dom_id(@triage)
+    expand_column dom_id(@triage)
+
+    # Golden cards sort first, then the just moved card, then the rest
+    assert_card_order [ cards(:logo), card, cards(:layout) ], column: dom_id(@triage)
+
+    assert_saved { card.reload.column == @triage }
+    visit board_url(@board)
+    expand_column dom_id(@triage)
+    assert_card_order [ cards(:logo), card, cards(:layout) ], column: dom_id(@triage)
+  end
+
+  test "a dropped card takes its column count with it" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_to card, column: dom_id(@in_progress)
+
+    assert_column_count 0, column: "maybe"
+    assert_column_count 2, column: dom_id(@in_progress)
+
+    assert_saved { card.reload.column == @in_progress }
+    visit board_url(@board)
+
+    assert_column_count 0, column: "maybe"
+    assert_column_count 2, column: dom_id(@in_progress)
+  end
+
+  test "the column under the pointer lights up and the dragged card dims" do
+    visit board_url(@board)
+    card = cards(:buy_domain)
+
+    drag_card_over card, column: dom_id(@in_progress)
+
+    assert_selector "##{dom_id(@in_progress)}.drag-and-drop__hover-container"
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    drag_card_over card, column: "not-now"
+
+    assert_selector "#not-now.drag-and-drop__hover-container"
+    assert_no_selector "##{dom_id(@in_progress)}.drag-and-drop__hover-container"
+  end
+
+  private
+    # Columns remember whether they were expanded, so only expand the collapsed ones.
+    def expand_column(column)
+      find("##{column} .cards__expander").click unless has_css?("##{column}.is-expanded", wait: 1)
+      assert_selector "##{column}.is-expanded"
+    end
+
+    def drag_card_to(card, column:, on: column)
+      find("##{dom_id(card, :article)}").drag_to find("##{on}", visible: :all), html5: true
+    end
+
+    def assert_card_in_column(card, column)
+      assert_selector "##{column} ##{dom_id(card, :article)}", visible: :all
+    end
+
+    def assert_card_order(cards, column:)
+      expected = cards.map { |card| dom_id(card, :article) }
+      actual = all("##{column} .card", visible: :all).map { |card| card[:id] }
+
+      assert_equal expected, actual
+    end
+
+    def assert_column_count(count, column:)
+      assert_selector "##{column} .cards__expander-count", text: count.to_s, visible: :all
+    end
+
+    def assert_saved(timeout: Capybara.default_max_wait_time)
+      deadline = Time.current + timeout
+
+      until yield
+        flunk "Timed out waiting for the move to be saved" if Time.current > deadline
+        sleep 0.05
+      end
+    end
+
+    # Drags a card over a column and leaves it hanging there, without dropping it.
+    def drag_card_over(card, column:)
+      execute_script <<~JS, find("##{dom_id(card, :article)}"), find("##{column}", visible: :all)
+        const [ card, column ] = arguments
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+end
