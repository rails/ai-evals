diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..056c554
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,196 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+import { nextFrame } from "helpers/timing_helpers"
+
+// Moves cards to another column, or to another status, by dragging them around the board.
+//
+// A dropped card is moved on the page right away and the move is persisted in the background,
+// so the board doesn't shift once the drag is over. Columns keep their own order, so a card
+// lands where its new column sorts it, not where it was dropped.
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "item", "container" ]
+  static values = { desktopBreakpoint: { type: String, default: "(min-width: 640px)" } }
+
+  initialize() {
+    this.draggedItem = null
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  start(event) {
+    const item = this.#itemFrom(event.target)
+
+    if (item && this.#isDesktop) {
+      this.#startDragging(item, event.dataTransfer)
+    } else {
+      event.preventDefault()
+    }
+  }
+
+  over(event) {
+    if (this.draggedItem) {
+      const container = this.#dropContainerFrom(event.target)
+      this.#hover(container)
+
+      if (container) {
+        event.preventDefault() // Accept the drop
+        event.dataTransfer.dropEffect = "move"
+      }
+    }
+  }
+
+  leave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#hover(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#dropContainerFrom(event.target)
+
+    if (this.draggedItem && container) {
+      event.preventDefault()
+      this.#move(this.draggedItem, container)
+    }
+  }
+
+  end() {
+    this.#stopDragging()
+  }
+
+  // Private
+
+  #itemFrom(element) {
+    return element.closest?.(this.#itemSelector)
+  }
+
+  #startDragging(item, dataTransfer) {
+    this.draggedItem = item
+
+    dataTransfer.effectAllowed = "move"
+    dataTransfer.setData("text/plain", item.id)
+
+    this.#dimDraggedItem()
+  }
+
+  // Dim the card only after the browser has taken the drag image from it.
+  async #dimDraggedItem() {
+    const item = this.draggedItem
+
+    await nextFrame()
+    item.classList.add(this.draggedItemClass)
+  }
+
+  // Cards move between columns, never within one, so their own column takes no drops.
+  #dropContainerFrom(element) {
+    const container = element.closest?.(this.#containerSelector)
+
+    return container?.contains(this.draggedItem) ? null : container
+  }
+
+  #hover(hoveredContainer) {
+    this.containerTargets.forEach(container => {
+      container.classList.toggle(this.hoverContainerClass, container === hoveredContainer)
+    })
+  }
+
+  async #move(item, container) {
+    const origin = this.#originOf(item)
+
+    this.#insert(item, container)
+    this.#recount(origin.container, container)
+
+    const response = await this.#requestMove(item, container)
+
+    if (!response.ok) {
+      origin.list.insertBefore(item, origin.nextItem)
+      this.#recount(container, origin.container)
+    }
+  }
+
+  #originOf(item) {
+    return {
+      container: item.closest(this.#containerSelector),
+      list: item.parentElement,
+      nextItem: item.nextElementSibling
+    }
+  }
+
+  // Columns sort their cards by activity, so a moved card goes on top of its new column,
+  // with only golden cards sorting above it.
+  #insert(item, container) {
+    const items = this.#itemsIn(container)
+    const nextItem = items.find(other => this.#isGolden(item) || !this.#isGolden(other))
+
+    if (nextItem) {
+      nextItem.before(item)
+    } else if (items.length > 0) {
+      items[items.length - 1].after(item)
+    } else {
+      this.#listIn(container)?.prepend(item)
+    }
+  }
+
+  #itemsIn(container) {
+    return Array.from(container.querySelectorAll(this.#itemSelector))
+  }
+
+  #isGolden(item) {
+    return item.classList.contains("golden-effect")
+  }
+
+  #listIn(container) {
+    return container.querySelector(".cards__list")
+  }
+
+  // Column headers count every card of the column, loaded or not, so move the count along
+  // with the card instead of counting the cards on the page.
+  #recount(from, to) {
+    this.#addToCount(from, -1)
+    this.#addToCount(to, 1)
+  }
+
+  #addToCount(container, difference) {
+    const counter = container?.querySelector(".cards__expander-count")
+
+    if (counter) {
+      const count = Number(counter.dataset.count) + difference
+
+      counter.dataset.count = count
+      counter.textContent = count > 99 ? "99+" : count
+    }
+  }
+
+  #requestMove(item, container) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = item.dataset
+    const { dragAndDropStatus: status, dragAndDropColumnId: columnId } = container.dataset
+
+    switch (status) {
+      case "awaiting_triage": return destroy(cardTriageUrl, { responseKind: "json" })
+      case "postponed":       return post(cardNotNowUrl, { responseKind: "json" })
+      case "closed":          return post(cardClosureUrl, { responseKind: "json" })
+      default:                return post(cardTriageUrl, { query: { column_id: columnId }, responseKind: "json" })
+    }
+  }
+
+  #stopDragging() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+    this.#hover(null)
+  }
+
+  get #itemSelector() {
+    return `[data-${this.identifier}-target~="item"]`
+  }
+
+  get #containerSelector() {
+    return `[data-${this.identifier}-target~="container"]`
+  }
+
+  get #isDesktop() {
+    return window.matchMedia(this.desktopBreakpointValue).matches
+  }
+}
