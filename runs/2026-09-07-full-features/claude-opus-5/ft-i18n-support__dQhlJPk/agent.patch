diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..62675ae
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,45 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+let cachedJSON
+let cachedTranslations
+
+// Translations are rendered into the page by the server (see
+// `ApplicationHelper#javascript_translations`) so the front end speaks the same
+// language as everything else.
+function translations() {
+  const json = getMetaContent("translations") || "{}"
+
+  if (json !== cachedJSON) {
+    cachedJSON = json
+    try {
+      cachedTranslations = JSON.parse(json)
+    } catch {
+      cachedTranslations = {}
+    }
+  }
+
+  return cachedTranslations
+}
+
+export function translate(key, interpolations = {}) {
+  let value = key.split(".").reduce((node, part) => (node ? node[part] : undefined), translations())
+
+  if (value && typeof value === "object") {
+    value = Number(interpolations.count) === 1 ? value.one : value.other
+  }
+
+  if (typeof value !== "string") return key
+
+  return value.replace(/%\{(\w+)\}/g, (match, name) => (name in interpolations ? interpolations[name] : match))
+}
+
+export function locale() {
+  return document.documentElement.lang || "en"
+}
+
+// The locale to hand to Intl. English keeps its US formats so nothing changes
+// for people who never picked a language.
+export function intlLocale() {
+  const current = locale()
+  return current.startsWith("en") ? "en-US" : current
+}
