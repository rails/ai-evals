@@ -0,0 +1,63 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show a published board without being signed in" do
+    get public_board_url(@board.public_key)
+    assert_response :success
+assert_select "h1", /Writebook/
+assert_select "a[href=?]", public_board_column_path(@board.public_key, columns(:writebook_in_progress)), text: "In progress"
+assert_select "a[href=?]", public_board_card_path(@board.public_key, cards(:text).number)
+  end
+
+  test "unknown key renders not found" do
+    get public_board_url("nope")
+    assert_response :not_found
+  end
+
+  test "unpublished board is not accessible" do
+    key = @board.public_key
+    @board.unpublish
+
+    get public_board_url(key)
+    assert_response :not_found
+  end
+
+  test "show a column of a published board" do
+    get public_board_column_url(@board.public_key, columns(:writebook_in_progress))
+    assert_response :success
+  end
+
+  test "show a published card of a published board" do
+    get public_board_card_url(@board.public_key, cards(:text).number)
+    assert_response :success
+  end
+
+  test "drafted cards are not accessible" do
+    drafted = @board.cards.create!(creator: users(:david), status: :drafted, title: "Draft")
+
+    get public_board_card_url(@board.public_key, drafted.number)
+    assert_response :not_found
+  end
+
+  test "board json includes the public url" do
+    sign_in_as :david
+    get board_url(@board, format: :json)
+
+    assert_response :success
+    assert_equal public_board_url(@board.public_key), response.parsed_body["public_url"]
+  end
+
+  test "board json public url is nil when unpublished" do
+    @board.unpublish
+    sign_in_as :david
+    get board_url(@board, format: :json)
+
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
