diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..3f35a7a
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,59 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+    scope :unpublished, -> { where(public_key: nil) }
+  end
+
+  class_methods do
+    def find_published_by_key!(key)
+      published.find_by!(public_key: key)
+    end
+
+    def generate_public_key
+      loop do
+        key = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break key unless exists?(public_key: key)
+      end
+    end
+  end
+
+  def publish
+    update! public_key: self.class.generate_public_key unless published?
+    self
+  end
+
+  def unpublish
+    update! public_key: nil
+    self
+  end
+
+  def published?
+    public_key.present?
+  end
+  alias_method :public?, :published?
+
+  def to_public_param
+    public_key
+  end
+
+  def public_url(**options)
+    if published?
+      Rails.application.routes.url_helpers.public_board_url public_key, **url_options.merge(options)
+    end
+  end
+
+  private
+    def url_options
+      base_url_options.merge(script_name: account.slug)
+    end
+
+    def base_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
