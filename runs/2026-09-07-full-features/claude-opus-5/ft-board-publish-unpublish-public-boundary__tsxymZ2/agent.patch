+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "publish a board" do
+    sign_in_as :david # admin
+
+    assert_changes -> { @board.reload.published? }, from: false, to: true do
+      post board_publication_url(@board)
+    end
+
+    assert_response :redirect
+  end
+
+  test "publish a board as json" do
+    sign_in_as :david
+
+    post board_publication_url(@board, format: :json)
+    assert_response :created
+    assert @board.reload.published?
+  end
+
+  test "unpublish a board" do
+    sign_in_as :david
+    @board.publish
+
+    assert_changes -> { @board.reload.published? }, from: true, to: false do
+      delete board_publication_url(@board)
+    end
+  end
+
+  test "board settings offer publishing and reveal the public link" do
+  sign_in_as :david
+
+  get edit_board_url(@board)
+  assert_response :success
+  assert_select "form[action=?][method=post]", board_publication_path(@board)
+
+  @board.publish
+
+  get edit_board_url(@board)
+  assert_response :success
+  assert_select "input[value=?]", public_board_url(@board.public_key)
+end
+
+test "non-admins can't unpublish" do
+  @board.publish
+  sign_in_as :jz
+
+  delete board_publication_url(@board)
+  assert_response :forbidden
+  assert @board.reload.published?
+end
+
+test "non-admins can't publish" do
+    sign_in_as :jz
+
+    post board_publication_url(@board)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+end
