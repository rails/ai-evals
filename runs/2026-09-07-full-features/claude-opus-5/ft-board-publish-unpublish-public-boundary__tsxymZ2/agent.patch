+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+  end
+
+  test "publishing generates a secret key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.public_key.present?
+    assert_includes Board.published, @board
+    assert_equal @board, Board.find_published_by_key!(@board.public_key)
+  end
+
+  test "publishing twice keeps the same key" do
+    key = @board.publish.public_key
+    assert_equal key, @board.publish.public_key
+  end
+
+  test "unpublishing removes the key" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_includes Board.unpublished, @board
+    assert_raises(ActiveRecord::RecordNotFound) { Board.find_published_by_key!("nope") }
+  end
+
+  test "public url points at the account scoped public board" do
+    @board.publish
+
+    assert_match %r{/#{@board.account.external_account_id}/public/boards/#{@board.public_key}\z}, @board.public_url
+  end
+end
