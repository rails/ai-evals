diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..3f1874f
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incinerates accounts cancelled before the grace period" do
+    cancel_account at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty @account.boards
+    assert_empty @account.users
+    assert_empty @account.cards
+    assert_nil Account::Cancellation.find_by(account_id: @account.id)
+  end
+
+  test "keeps accounts cancelled within the grace period" do
+    cancel_account at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "keeps active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  private
+    def cancel_account(at:)
+      @account.cancel(initiated_by: @user)
+      @account.cancellation.update_columns(created_at: at)
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..184004c
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due for incineration includes accounts cancelled before the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due for incineration excludes accounts cancelled within the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due for incineration excludes active accounts" do
+    assert_empty Account.due_for_incineration
+  end
+
+  test "incinerate removes the account" do
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "incinerate removes every record belonging to the account" do
+    assert_not_empty populated_tables_for(@account)
+
+    @account.incinerate
+
+    assert_empty populated_tables_for(@account)
+  end
+
+  test "incinerate purges the files of the account" do
+    blob = nil
+
+    Current.set(account: @account, user: @user) do
+      card = cards(:logo)
+      card.image.attach(io: StringIO.new("hello"), filename: "hello.txt", content_type: "text/plain")
+      blob = card.image.blob
+    end
+
+    assert blob.service.exist?(blob.key)
+
+    @account.incinerate
+
+    assert_not blob.service.exist?(blob.key)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+  end
+
+  test "incinerate_all_due only incinerates the accounts past the grace period" do
+    cancel @account, at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago
+    cancel accounts(:initech), at: (Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day).ago
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_all_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(accounts(:initech).id)
+  end
+
+  private
+    def cancel(account, at:)
+      account.cancel(initiated_by: account.users.owner.first || @user)
+      account.cancellation.update_columns(created_at: at)
+    end
+
+    def populated_tables_for(account)
+      account_scoped_tables.select do |table|
+        model_for(table).where(account_id: account.id).exists?
+      end
+    end
+
+    def account_scoped_tables
+      connection.tables.select do |table|
+        connection.columns(table).any? { |column| column.name == "account_id" }
+      end - [ "accounts" ]
+    end
+
+    def model_for(table)
+      Class.new(ApplicationRecord) { self.table_name = table }
+    end
+
+    def connection
+      ApplicationRecord.connection
+    end
+end
