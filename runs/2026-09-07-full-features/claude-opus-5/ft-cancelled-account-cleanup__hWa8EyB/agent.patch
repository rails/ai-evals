diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..402b11f 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,33 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_all_due
+      due_for_incineration.each(&:incinerate)
+    end
+  end
+
+  # Removes the account and everything associated with it for good.
+  def incinerate
+    Current.with_account(self) do
+      purge_files
+      destroy!
+    end
+  end
+
+  private
+    # Purged upfront, so nothing is left behind in the storage service, and so that
+    # storage tracking doesn't run for records that are about to be deleted.
+    def purge_files
+      ActiveStorage::Attachment.where(account: self).each(&:purge)
+      ActiveStorage::Blob.where(account: self).each(&:purge)
+    end
 end
