diff --git a/test/models/identity/magic_link_test.rb b/test/models/identity/magic_link_test.rb
new file mode 100644
index 0000000..3383b94
--- /dev/null
+++ b/test/models/identity/magic_link_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Identity::MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "generates a six character code" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal Identity::MagicLink::CODE_LENGTH, magic_link.code.length
+    assert_match /\A[A-Z0-9]+\z/, magic_link.code
+  end
+
+  test "authenticating with the right code returns the identity and spends the magic link" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal @identity, magic_link.authenticate(magic_link.code)
+    assert_not Identity::MagicLink.exists?(magic_link.id)
+  end
+
+  test "authenticating ignores case and spaces" do
+    magic_link = @identity.magic_links.create!
+
+    assert_equal @identity, magic_link.authenticate(" #{magic_link.code.downcase} ")
+  end
+
+  test "authenticating with the wrong code fails and keeps the magic link" do
+    magic_link = @identity.magic_links.create!
+
+    assert_nil magic_link.authenticate("nope42")
+    assert_nil magic_link.authenticate("")
+    assert_nil magic_link.authenticate(nil)
+    assert Identity::MagicLink.exists?(magic_link.id)
+  end
+
+  test "codes work for fifteen minutes" do
+    magic_link = @identity.magic_links.create!
+
+    travel 14.minutes
+    assert magic_link.active?
+    assert_equal @identity, magic_link.authenticate(magic_link.code)
+
+    magic_link = @identity.magic_links.create!
+
+    travel 16.minutes
+    assert_not magic_link.active?
+    assert_nil magic_link.authenticate(magic_link.code)
+  end
+
+  test "finding by pending authentication token" do
+    magic_link = @identity.magic_links.create!
+    token = magic_link.pending_authentication_token
+
+    assert_equal magic_link, Identity::MagicLink.find_by_pending_authentication_token(token)
+
+    assert_nil Identity::MagicLink.find_by_pending_authentication_token("bogus")
+    assert_nil Identity::MagicLink.find_by_pending_authentication_token(nil)
+
+    travel 16.minutes
+    assert_nil Identity::MagicLink.find_by_pending_authentication_token(token)
+  end
+
+  test "delivering to an identity emails the code" do
+    magic_link = nil
+
+    assert_emails 1 do
+      magic_link = Identity::MagicLink.deliver_to(@identity)
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+  end
+
+  test "cleanup deletes expired magic links" do
+    expired = @identity.magic_links.create!
+    travel Identity::MagicLink::EXPIRES_IN + 1.minute
+    active = @identity.magic_links.create!
+
+    Identity::MagicLink.cleanup
+
+    assert_not Identity::MagicLink.exists?(expired.id)
+    assert Identity::MagicLink.exists?(active.id)
+  end
+
+  test "magic links are destroyed with their identity" do
+    @identity.magic_links.create!
+
+    assert_difference -> { Identity::MagicLink.count }, -1 do
+      @identity.destroy
+    end
+  end
+end
