+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  setup do
+    @magic_link = identities(:kevin).magic_links.create!
+  end
+
+  test "magic link goes to the identity with the code in the subject" do
+    email = IdentityMailer.magic_link(@magic_link)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ identities(:kevin).email_address ], email.to
+    assert_equal "#{@magic_link.code} is your Fizzy sign-in code", email.subject
+  end
+
+  test "magic link includes the code in the body" do
+    email = IdentityMailer.magic_link(@magic_link)
+
+    assert_match @magic_link.code, email.text_part.body.encoded
+    assert_match @magic_link.code, email.html_part.body.encoded
+  end
+end
