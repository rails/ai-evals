diff --git a/app/models/identity/magic_link.rb b/app/models/identity/magic_link.rb
new file mode 100644
index 0000000..97b50a1
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,67 @@
+# A single-use, six-character code that's emailed to an identity to sign in, sign up, or join an account.
+class Identity::MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_ALPHABET = %w[ 2 3 4 6 7 9 A C D E F G H J K L M N P Q R T U V W X Y Z ] # Skipping look-alikes like 0/O and 1/I
+  EXPIRES_IN = 15.minutes
+
+  belongs_to :identity
+
+  scope :active, -> { where(created_at: EXPIRES_IN.ago..) }
+  scope :expired, -> { where(created_at: ...EXPIRES_IN.ago) }
+
+  normalizes :code, with: ->(code) { code.to_s.upcase.gsub(/[^A-Z0-9]/, "").presence }
+
+  validates :code, presence: true
+
+  before_validation :generate_code, on: :create
+
+  class << self
+    def deliver_to(identity)
+      identity.magic_links.create!.tap(&:deliver_later)
+    end
+
+    def cleanup
+      expired.delete_all
+    end
+
+    def find_by_pending_authentication_token(token)
+      if magic_link = find_signed(token, purpose: :pending_authentication)
+        magic_link if magic_link.active?
+      end
+    end
+  end
+
+  def pending_authentication_token
+    signed_id purpose: :pending_authentication, expires_in: EXPIRES_IN
+  end
+
+  def deliver_later
+    # Logged so self-hosted instances without SMTP configured can still find the code and sign in.
+    logger.info "Emailing magic link code #{code} to #{identity.email_address}"
+
+    IdentityMailer.magic_link(self).deliver_later
+  end
+
+  # Returns the identity when the entered code is the right one, and spends the magic link so it can't be used again.
+  def authenticate(entered_code)
+    if active? && correct_code?(entered_code)
+      destroy
+      identity
+    end
+  end
+
+  def active?
+    created_at.present? && created_at > EXPIRES_IN.ago
+  end
+
+  private
+    def generate_code
+      self.code ||= CODE_LENGTH.times.map { CODE_ALPHABET.sample(random: SecureRandom) }.join
+    end
+
+    def correct_code?(entered_code)
+      entered_code = self.class.normalize_value_for(:code, entered_code)
+
+      entered_code.present? && ActiveSupport::SecurityUtils.secure_compare(code, entered_code)
+    end
+end
