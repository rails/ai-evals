+    end
+  end
+
+  test "create without a pending authentication" do
+    untenanted do
+      post session_magic_link_path, params: { code: "XXXXXX" }
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create is rate limited" do
+    request_magic_link
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: "XXXXXX" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  test "create via JSON" do
+    code = request_magic_link
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create with an incorrect code via JSON" do
+    request_magic_link
+
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "XXXXXX" }
+
+      assert_response :unauthorized
+      assert_equal "That code didn’t work. Try again.", @response.parsed_body["message"]
+    end
+  end
+
+  test "create without a pending authentication via JSON" do
