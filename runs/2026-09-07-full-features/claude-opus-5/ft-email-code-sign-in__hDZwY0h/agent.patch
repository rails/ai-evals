new file mode 100644
index 0000000..dcc494b
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,31 @@
+# Emails a six-character code and then trades that code for a session. See Sessions::MagicLinksController.
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def deliver_magic_link_to(identity, return_to: nil)
+      magic_link = Identity::MagicLink.deliver_to(identity)
+
+      set_pending_authentication magic_link
+      session[:return_to_after_authenticating] = return_to if return_to
+
+      respond_to do |format|
+        format.html { redirect_to main_app.new_session_magic_link_url(script_name: nil) }
+        format.json { render json: { pending_authentication_token: magic_link.pending_authentication_token }, status: :created }
+      end
+    end
+
+    def pending_authentication
+      Identity::MagicLink.find_by_pending_authentication_token(cookies[:pending_authentication_token])
+    end
+
+    def set_pending_authentication(magic_link)
+      cookies[:pending_authentication_token] = {
+        value: magic_link.pending_authentication_token, httponly: true, same_site: :lax
+      }
+    end
+
+    def clear_pending_authentication
+      cookies.delete :pending_authentication_token
+    end
+end
