diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..69ba277
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,152 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "several comments from different people within a third of the auto-close period burst the card" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+    comment_on @card, users(:jz), at: 38.days.ago
+
+    assert_predicate @card.reload, :bursted?
+    assert_predicate @card, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a couple of comments don't burst the card" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+
+    assert_not_predicate @card.reload, :bursted?
+    assert_not_predicate @card, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comments from a single person don't burst the card" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:david), at: 39.days.ago
+    comment_on @card, users(:david), at: 38.days.ago
+
+    assert_not_predicate @card.reload, :bursted?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "comments spread beyond a third of the auto-close period don't burst the card" do
+    comment_on @card, users(:david), at: 100.days.ago
+    comment_on @card, users(:kevin), at: 60.days.ago
+    comment_on @card, users(:jz), at: 20.days.ago
+
+    assert_not_predicate @card.reload, :bursted?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "system comments left behind by events don't count towards a burst" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, accounts("37s").system_user, at: 39.days.ago
+    comment_on @card, accounts("37s").system_user, at: 38.days.ago
+
+    assert_not_predicate @card.reload, :bursted?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "assigning someone bursts the card" do
+    travel_to 20.days.ago do
+      @card.toggle_assignment users(:jz)
+    end
+
+    assert_predicate @card.reload, :bursted?
+    assert_predicate @card, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "reopening bursts the card" do
+    travel_to 20.days.ago do
+      @card.close
+      @card.reopen
+    end
+
+    assert_predicate @card.reload, :bursted?
+    assert_predicate @card, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a card that burst recently isn't stalled yet" do
+    travel_to 10.days.ago do
+      @card.toggle_assignment users(:jz)
+    end
+
+    assert_predicate @card.reload, :bursted?
+    assert_not_predicate @card, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on the card resets the stall" do
+    travel_to 20.days.ago do
+      @card.toggle_assignment users(:jz)
+    end
+    assert_predicate @card.reload, :stalled?
+
+    comment_on @card, users(:kevin), at: Time.current
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "boards without their own auto-close period burst on the account one" do
+    entropies(:writebook_board).destroy
+    boards(:writebook).reload
+
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+    comment_on @card, users(:jz), at: 38.days.ago
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "cards that are done or parked don't stall" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+    comment_on @card, users(:jz), at: 38.days.ago
+    assert_predicate @card.reload, :stalled?
+
+    travel_to 20.days.ago do
+      @card.close
+    end
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel_to 20.days.ago do
+      @card.postpone
+    end
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "the stalled scope matches the stalled predicate" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+    comment_on @card, users(:jz), at: 38.days.ago
+
+    assert_equal Card.all.select(&:stalled?).to_set, Card.stalled.to_set
+  end
+
+  test "stalled cards can be indexed" do
+    comment_on @card, users(:david), at: 40.days.ago
+    comment_on @card, users(:kevin), at: 39.days.ago
+    comment_on @card, users(:jz), at: 38.days.ago
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:text)
+  end
+
+  private
+    def comment_on(card, creator, at:)
+      travel_to at do
+        card.comments.create! creator: creator, body: "Something to say"
+      end
+    end
+end
