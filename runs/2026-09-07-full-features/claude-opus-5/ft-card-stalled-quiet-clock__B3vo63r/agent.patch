diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..93faefc
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,95 @@
+# Cards that got a burst of attention and then went cold. A card bursts when someone
+# is assigned to it or reopens it, or when a flurry of comments — several of them,
+# from different people — lands on it within a fraction of the board's auto-close
+# period. A burst card with nothing happening on it for a couple of weeks is stalled;
+# any activity refreshes +last_active_at+ and resets the stall.
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_PERIOD_FRACTION = 3
+
+  included do
+    scope :stalled, -> { active.bursted.where(last_active_at: ..STALL_PERIOD.ago) }
+
+    # Derives the burst period per card from the board's auto-close period, falling
+    # back to the account's, the same way `postponing_soon` does. Then it anchors a
+    # window on each comment and counts the ones landing within the burst period
+    # before it, ignoring the system comments that events leave behind.
+    scope :bursted, -> do
+      burst_period = "(COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) / #{BURST_PERIOD_FRACTION})"
+      burst_actions = BURST_ACTIONS.map { |action| connection.quote(action) }.join(", ")
+
+      joins(board: :account)
+        .left_outer_joins(board: :entropy)
+        .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+        .where(<<~SQL.squish)
+          EXISTS (
+            SELECT 1 FROM events
+            WHERE events.eventable_type = 'Card' AND events.eventable_id = cards.id
+              AND events.action IN (#{burst_actions})
+          ) OR EXISTS (
+            SELECT 1 FROM comments AS burst_anchors
+            INNER JOIN comments AS burst_comments
+              ON burst_comments.card_id = burst_anchors.card_id
+              AND burst_comments.created_at <= burst_anchors.created_at
+              AND burst_comments.created_at >= #{connection.date_subtract("burst_anchors.created_at", burst_period)}
+            INNER JOIN users AS burst_commenters
+              ON burst_commenters.id = burst_comments.creator_id AND burst_commenters.role != 'system'
+            WHERE burst_anchors.card_id = cards.id
+            GROUP BY burst_anchors.id
+            HAVING COUNT(*) >= #{BURST_COMMENTS} AND COUNT(DISTINCT burst_comments.creator_id) >= #{BURST_COMMENTERS}
+          )
+        SQL
+    end
+  end
+
+  def stalled?
+    cold? && active? && bursted?
+  end
+
+  def bursted?
+    burst_events? || burst_comments?
+  end
+
+  # Cards look stale to caches as soon as they could have stalled, so a stall setting
+  # in while nothing happens doesn't stay hidden behind a cached rendering.
+  def cache_version
+    if last_active_at
+      [ super, cold? ].join("/")
+    else
+      super
+    end
+  end
+
+  private
+    def cold?
+      last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+
+    def burst_events?
+      events.where(action: BURST_ACTIONS).exists?
+    end
+
+    def burst_comments?
+      burst_windows.any? do |window|
+        window.size >= BURST_COMMENTS && window.collect(&:last).uniq.size >= BURST_COMMENTERS
+      end
+    end
+
+    def burst_windows
+      stamps = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+
+      stamps.each_index.collect do |index|
+        deadline = stamps[index].first + burst_period
+        stamps[index..].take_while { |created_at, _| created_at <= deadline }
+      end
+    end
+
+    def burst_period
+      auto_postpone_period / BURST_PERIOD_FRACTION
+    end
+end
