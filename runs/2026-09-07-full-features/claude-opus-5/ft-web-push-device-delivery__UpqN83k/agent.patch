new file mode 100644
index 0000000..95e6dc4
--- /dev/null
+++ b/test/test_helpers/push_test_helper.rb
@@ -0,0 +1,12 @@
+module PushTestHelper
+  def with_push_notifications_enabled
+    vapid = Rails.configuration.x.vapid
+    previous_keys = [ vapid.public_key, vapid.private_key ]
+    key = WebPush.generate_key
+
+    vapid.public_key, vapid.private_key = key.public_key, key.private_key
+    yield
+  ensure
+    vapid.public_key, vapid.private_key = previous_keys
+  end
+end
