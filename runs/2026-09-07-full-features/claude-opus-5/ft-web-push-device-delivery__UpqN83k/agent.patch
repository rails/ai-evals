+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit -> { push_later }
+    after_update_commit -> { push_later }, if: :source_id_previously_changed?
+  end
+
+  def push_later
+    user.push_subscriptions.each { |subscription| subscription.deliver_later(push_payload) }
+  end
+
+  def push_payload
+    Push::Payload.new(self)
+  end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..bad2045
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,31 @@
+# Web push notifications are signed with a VAPID key pair that ops provides via
+# the VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY environment variables. When they are
+# missing, push notifications are simply turned off.
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      vapid_configuration.public_key
+    end
+
+    def vapid_private_key
+      vapid_configuration.private_key
+    end
+
+    def vapid_options
+      { public_key: vapid_public_key, private_key: vapid_private_key, subject: vapid_configuration.subject }
+    end
+
+    private
+      def vapid_configuration
+        Rails.configuration.x.vapid
+      end
+  end
+end
