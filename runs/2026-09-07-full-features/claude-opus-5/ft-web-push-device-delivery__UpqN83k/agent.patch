@@ -0,0 +1,41 @@
+# What a push notification says: the same title and body the notification shows
+# in the tray, plus the path of the card it's about.
+class Push::Payload
+  include Rails.application.routes.url_helpers
+
+  attr_reader :notification
+  delegate :card, :account, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def title
+    helpers.notification_title(notification)
+  end
+
+  def body
+    helpers.notification_body(notification)
+  end
+
+  def path
+    card_path(card, script_name: account.slug)
+  end
+
+  def tag
+    card.id
+  end
+
+  def to_h
+    { title: title, body: body, path: path, tag: tag }
+  end
+
+  def to_json(*args)
+    to_h.to_json(*args)
+  end
+
+  private
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..67ba50f
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,32 @@
+class Push::Subscription < ApplicationRecord
+  TIME_TO_LIVE = 24.hours
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  def deliver_later(payload)
+    Push::Subscription::DeliverJob.perform_later(self, payload.to_h)
+  end
+
+  def deliver_now(payload)
+    WebPush.payload_send(**delivery_options(payload)) if Push.enabled?
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy # The push service has forgotten about this subscription, so we should too.
+  end
+
+  private
+    def delivery_options(payload)
+      {
+        message: payload.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: Push.vapid_options,
+        urgency: "high",
+        ttl: TIME_TO_LIVE.to_i
+      }
+    end
+end
