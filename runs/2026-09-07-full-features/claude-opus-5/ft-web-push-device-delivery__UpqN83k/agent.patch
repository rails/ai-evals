diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..f5bf683
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,76 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+import { decodeVapidKey, signedWith } from "helpers/push_helpers"
+
+// Subscribes this device to push notifications, and shows how to unblock them
+// when the browser or the operating system is holding them back.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details" ]
+  static values = { url: String, vapidPublicKey: String }
+
+  connect() {
+    if (this.#granted) {
+      this.#subscribe()
+    } else {
+      this.#reflect(false)
+    }
+  }
+
+  async requestPermission() {
+    if (this.#supported && await Notification.requestPermission() === "granted") {
+      this.#subscribe()
+    } else {
+      this.#reflect(false)
+    }
+  }
+
+  async #subscribe() {
+    try {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await this.#pushSubscription(registration)
+
+      this.#reflect(await this.#createSubscription(subscription))
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+      this.#reflect(false)
+    }
+  }
+
+  async #pushSubscription(registration) {
+    const vapidKey = decodeVapidKey(this.vapidPublicKeyValue)
+    const subscription = await registration.pushManager.getSubscription()
+
+    if (subscription) {
+      if (signedWith(subscription, vapidKey)) return subscription
+
+      await subscription.unsubscribe() // It was signed with a key we no longer use
+    }
+
+    return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: vapidKey })
+  }
+
+  async #createSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    return response.ok
+  }
+
+  #reflect(subscribed) {
+    this.element.classList.toggle(this.onClass, subscribed)
+    this.detailsTargets.forEach(details => details.hidden = subscribed)
+  }
+
+  get #supported() {
+    return "Notification" in window && "PushManager" in window && "serviceWorker" in navigator
+  }
+
+  get #granted() {
+    return this.#supported && Notification.permission === "granted"
+  }
+}
diff --git a/app/javascript/helpers/push_helpers.js b/app/javascript/helpers/push_helpers.js
new file mode 100644
index 0000000..7befc5f
--- /dev/null
+++ b/app/javascript/helpers/push_helpers.js
@@ -0,0 +1,14 @@
+// Push services want the VAPID public key as bytes, but we deliver it to the
+// browser as the URL-safe base64 string the server signs with.
+export function decodeVapidKey(key) {
+  const base64 = (key + "=".repeat((4 - (key.length % 4)) % 4)).replace(/-/g, "+").replace(/_/g, "/")
+  const binary = atob(base64)
+
+  return Uint8Array.from(binary, character => character.charCodeAt(0))
+}
+
+export function signedWith(subscription, vapidKey) {
+  const key = new Uint8Array(subscription.options?.applicationServerKey || [])
+
+  return key.length === vapidKey.length && key.every((byte, index) => byte === vapidKey[index])
+}
