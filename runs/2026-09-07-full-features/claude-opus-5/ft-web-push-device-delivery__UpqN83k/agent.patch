+// Push notifications
+
+self.addEventListener("push", (event) => {
+  const { title, body, path, tag } = event.data.json()
+
+  event.waitUntil(self.registration.showNotification(title, {
+    body: body,
+    tag: tag,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192-maskable.png",
+    data: { path: path }
+  }))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  event.waitUntil(openCard(event.notification.data?.path || "/"))
+})
+
+async function openCard(path) {
+  const url = new URL(path, self.location.origin).href
+  const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const client = clients.find((client) => client.url === url) || clients[0]
+
+  if (client) {
+    await client.focus()
+
+    if (client.url !== url && "navigate" in client) {
+      await client.navigate(url)
+    }
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
+
 self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
