+require "test_helper"
+
+class PushNotificationsTest < ActionDispatch::IntegrationTest
+  test "what lands in the tray reaches the subscribed device" do
+    endpoint = push_subscriptions(:kevin_phone).endpoint
+    stub_request(:post, endpoint).to_return(status: 201)
+
+    with_push_notifications_enabled do
+      perform_enqueued_jobs only: Push::Subscription::DeliverJob do
+        Notification.create!(user: users(:kevin), source: events(:text_published),
+          creator: users(:david), unread_count: 1)
+      end
+    end
+
+    assert_requested :post, endpoint do |request|
+      request.headers["Content-Encoding"] == "aes128gcm" && request.headers["Authorization"].start_with?("vapid")
+    end
+  end
+
+  test "subscriptions the push service has forgotten are dropped" do
+    stub_request(:post, push_subscriptions(:kevin_phone).endpoint).to_return(status: 410)
+
+    with_push_notifications_enabled do
+      assert_difference -> { Push::Subscription.count }, -1 do
+        perform_enqueued_jobs only: Push::Subscription::DeliverJob do
+          Notification.create!(user: users(:kevin), source: events(:text_published),
+            creator: users(:david), unread_count: 1)
+        end
+      end
+    end
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
new file mode 100644
index 0000000..1c7167b
--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  test "creating a notification pushes it to every device of the recipient" do
+    kevin = users(:kevin)
+    kevin.push_subscriptions.create!(endpoint: "https://push.example.com/subscriptions/kevin-laptop",
+      p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_enqueued_jobs 2, only: Push::Subscription::DeliverJob do
+      create_notification_for kevin
+    end
+  end
+
+  test "renotifying about the same card pushes again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_jobs 1, only: Push::Subscription::DeliverJob do
+      notification.update!(source: events(:logo_assignment_david), unread_count: 3)
+    end
+  end
+
+  test "reading a notification doesn't push" do
+    assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+      notifications(:logo_assignment_kevin).read
+    end
+  end
+
+  test "nothing is pushed to someone without subscriptions" do
+    assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+      create_notification_for users(:jz)
+    end
+  end
+
+  test "the push says what the tray says and points at the card" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = notification.push_payload.to_h
+
+    assert_equal ApplicationController.helpers.notification_title(notification), payload[:title]
+    assert_equal ApplicationController.helpers.notification_body(notification), payload[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload[:path]
+    assert_equal notification.card.id, payload[:tag]
+  end
+
+  private
+    def create_notification_for(user)
+      Notification.create!(user: user, source: events(:text_published), creator: users(:david), unread_count: 1)
+    end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..4cd4d85
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:david_desktop)
+  end
+
+  test "endpoint is unique per user" do
+    duplicate = @subscription.user.push_subscriptions.build(@subscription.slice(:endpoint, :p256dh_key, :auth_key))
+    assert_not duplicate.valid?
+
+    someone_else = users(:jason).push_subscriptions.build(@subscription.slice(:endpoint, :p256dh_key, :auth_key))
+    assert someone_else.valid?
+  end
+
+  test "keys are required" do
+    assert_not @subscription.user.push_subscriptions.build(endpoint: "https://push.example.com/other").valid?
+  end
+
+  test "account defaults to the user's account" do
+    subscription = users(:jason).push_subscriptions.create!(
+      endpoint: "https://push.example.com/subscriptions/jason", p256dh_key: "p256dh", auth_key: "auth")
+
+    assert_equal users(:jason).account, subscription.account
+  end
+
+  test "deliver_later enqueues a delivery" do
+    assert_enqueued_with job: Push::Subscription::DeliverJob, args: [ @subscription, { title: "Hi" } ] do
+      @subscription.deliver_later(title: "Hi")
+    end
+  end
+
+  test "deliver_now sends the payload to the push service" do
+    with_push_notifications_enabled do
+      WebPush.expects(:payload_send).with do |options|
+        options[:message] == { title: "Hi" }.to_json &&
+          options[:endpoint] == @subscription.endpoint &&
+          options[:p256dh] == @subscription.p256dh_key &&
+          options[:auth] == @subscription.auth_key &&
+          options[:vapid] == Push.vapid_options
+      end
+
+      @subscription.deliver_now(title: "Hi")
+    end
+  end
+
+  test "deliver_now does nothing without a VAPID key pair" do
+    WebPush.expects(:payload_send).never
+
+    @subscription.deliver_now(title: "Hi")
+  end
+
+  test "deliver_now forgets subscriptions the push service has expired" do
+    with_push_notifications_enabled do
+      WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(Struct.new(:body).new("Gone"), "push.example.com"))
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver_now(title: "Hi")
+      end
+    end
+  end
+end
