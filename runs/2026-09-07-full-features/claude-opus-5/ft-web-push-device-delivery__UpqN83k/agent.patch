diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..c6abab2
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,24 @@
+# Push notifications are signed with a VAPID key pair. Ops provides the pair in
+# production via VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY. In development we
+# generate a throwaway pair and keep it in tmp/ so subscriptions survive restarts.
+Rails.application.configure do
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+  config.x.vapid.subject = ENV["VAPID_SUBJECT"].presence || ENV["BASE_URL"].presence || "https://fizzy.do"
+
+  if Rails.env.development? && (config.x.vapid.public_key.blank? || config.x.vapid.private_key.blank?)
+    keys_path = Rails.root.join("tmp/vapid_keys.json")
+
+    keys = if keys_path.exist?
+      JSON.parse(keys_path.read)
+    else
+      WebPush.generate_key.then { |key| { "public_key" => key.public_key, "private_key" => key.private_key } }.tap do |generated|
+        keys_path.dirname.mkpath
+        keys_path.write(generated.to_json)
+      end
+    end
+
+    config.x.vapid.public_key = keys["public_key"]
+    config.x.vapid.private_key = keys["private_key"]
+  end
+end
