@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: "https://push.example.com/subscriptions/david-phone",
+          p256dh_key: "p256dh", auth_key: "auth" } },
+        headers: { "User-Agent" => "Firefox on Android" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.order(:created_at).last
+    assert_equal "https://push.example.com/subscriptions/david-phone", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal "Firefox on Android", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+test "create as JSON" do
+  assert_difference -> { @user.push_subscriptions.count }, 1 do
+    post user_push_subscriptions_path(@user),
+      params: { endpoint: "https://push.example.com/subscriptions/david-tablet",
+        p256dh_key: "p256dh", auth_key: "auth" },
+      as: :json
+  end
+
+  assert_response :created
+end
+
+  test "create refreshes the keys of a known subscription" do
+    subscription = push_subscriptions(:david_desktop)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint, p256dh_key: "new-p256dh", auth_key: "new-auth" } }
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", subscription.reload.p256dh_key
+  end
+
+  test "create for someone else is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)),
+        params: { push_subscription: { endpoint: "https://push.example.com/subscriptions/nope",
+          p256dh_key: "p256dh", auth_key: "auth" } }
+    end
+
+    assert_response :forbidden
+  end
+end
