+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundled emails are on every few hours by default" do
+    assert_equal "every_few_hours", User::Settings.new.bundle_email_frequency
+  end
+
+  test "each frequency has its own window" do
+    { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, window|
+      @settings.update! bundle_email_frequency: frequency
+
+      assert_equal window, @settings.bundle_email_window
+      assert @settings.bundle_emails?
+    end
+  end
+
+  test "never means no window at all" do
+    @settings.update! bundle_email_frequency: :never
+
+    assert_nil @settings.bundle_email_window
+    assert_not @settings.bundle_emails?
+  end
+
+  test "unknown frequencies are rejected" do
+    assert_raises ActiveRecord::RecordInvalid do
+      @settings.update! bundle_email_frequency: "hourly"
+    end
+  end
+end
