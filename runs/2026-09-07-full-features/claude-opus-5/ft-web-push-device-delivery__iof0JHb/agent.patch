--- /dev/null
+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @creator = users(:kevin)
+  end
+
+  test "new notifications reach every browser the person subscribed with" do
+    assert_enqueued_jobs 2, only: Push::Subscription::DeliverJob do
+      create_notification
+    end
+  end
+
+  test "renotifying about the same card pushes again" do
+    notification = create_notification
+
+    assert_enqueued_jobs 2, only: Push::Subscription::DeliverJob do
+      notification.update!(source: events(:shipping_published), read_at: nil)
+    end
+  end
+
+  test "reading a notification doesn't push" do
+    notification = create_notification
+
+    assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+      notification.read
+    end
+  end
+
+  test "people without subscriptions get no pushes" do
+    assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+      Notification.create!(user: users(:jz), creator: @creator, source: events(:shipping_closed))
+    end
+  end
+
+  test "payload says what the tray says and points at the card" do
+    payload = JSON.parse(create_notification.push_payload.to_json)
+
+    assert_equal "We need to ship the app", payload["title"]
+    assert_equal "Moved to Done by #{@creator.name}", payload.dig("options", "body")
+    assert_equal "/#{accounts("37s").external_account_id}/cards/#{cards(:shipping).number}", payload.dig("options", "data", "path")
+  end
+
+  test "mentions push the mentioner and their words" do
+    mention = mentions(:logo_comment_david_mention_by_jz)
+    payload = JSON.parse(notifications(:logo_mentioned_david).push_payload.to_json)
+
+    assert_equal "#{mention.mentioner.first_name} @mentioned you", payload["title"]
+    assert payload.dig("options", "body").present?
+  end
+
+  private
+    def create_notification
+      Notification.create!(user: @user, creator: @creator, source: events(:shipping_closed))
+    end
+end
