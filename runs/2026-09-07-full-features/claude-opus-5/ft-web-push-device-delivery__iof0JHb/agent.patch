+++ b/test/integration/push_notifications_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class PushNotificationsTest < ActionDispatch::IntegrationTest
+  ENDPOINT = "https://push.example.com/subscriptions/brand-new"
+
+  setup do
+    sign_in_as :david
+
+    @push_service = stub_request(:post, ENDPOINT).to_return(status: 201)
+  end
+
+  test "notifications reach the browsers people turned notifications on for" do
+    subscribe_this_browser
+
+    perform_enqueued_jobs do
+      Notification.create!(user: users(:david), creator: users(:kevin), source: events(:shipping_closed))
+    end
+
+    assert_requested :post, ENDPOINT do |request|
+      request.headers["Authorization"].start_with?("vapid") && request.headers["Content-Encoding"] == "aes128gcm"
+    end
+  end
+
+  test "notifications stop once the browser unsubscribes" do
+    subscribe_this_browser
+    delete user_push_subscription_path(users(:david), Push::Subscription.find(response.parsed_body["id"]))
+
+    perform_enqueued_jobs do
+      Notification.create!(user: users(:david), creator: users(:kevin), source: events(:shipping_closed))
+    end
+
+    assert_not_requested @push_service
+  end
+
+  test "subscriptions the push service has forgotten are dropped" do
+    subscribe_this_browser
+    stub_request(:post, ENDPOINT).to_return(status: 410)
+
+    assert_difference -> { users(:david).push_subscriptions.count }, -1 do
+      perform_enqueued_jobs do
+        Notification.create!(user: users(:david), creator: users(:kevin), source: events(:shipping_closed))
+      end
+    end
+  end
+
+  private
+    def subscribe_this_browser
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: ENDPOINT,
+          p256dh_key: "BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM",
+          auth_key: "tBHItJI5svbpez7KI4CCXg"
+        }
+      }, as: :json
+
+      assert_response :created
+    end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
