diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..81e0998
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:davids_laptop)
+  end
+
+  test "account defaults to the user's account" do
+    subscription = users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/new", p256dh_key: "key", auth_key: "auth")
+
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "endpoints are unique per user" do
+    duplicate = users(:david).push_subscriptions.new(endpoint: @subscription.endpoint, p256dh_key: "key", auth_key: "auth")
+
+    assert_not duplicate.valid?
+  end
+
+  test "the same endpoint can belong to different users" do
+    subscription = users(:kevin).push_subscriptions.new(endpoint: @subscription.endpoint, p256dh_key: "key", auth_key: "auth")
+
+    assert subscription.valid?
+  end
+
+  test "deliver_later enqueues a delivery job" do
+    payload = Push::Payload.new(title: "Hello", body: "World", path: "/1/cards/1")
+
+    assert_enqueued_with job: Push::Subscription::DeliverJob, args: [ @subscription, payload.to_json ] do
+      @subscription.deliver_later(payload)
+    end
+  end
+
+  test "deliver posts the message to the push service" do
+    WebPush.expects(:payload_send).with do |options|
+      options[:endpoint] == @subscription.endpoint &&
+        options[:p256dh] == @subscription.p256dh_key &&
+        options[:auth] == @subscription.auth_key &&
+        options[:message] == "payload"
+    end
+
+    @subscription.deliver("payload")
+  end
+
+  test "deliver removes subscriptions the push service has expired" do
+    response = stub(body: "Gone", code: "410")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver("payload")
+    end
+  end
+
+  test "long user agents are trimmed to fit" do
+    subscription = users(:david).push_subscriptions.create!(endpoint: "https://push.example.com/new", p256dh_key: "key", auth_key: "auth", user_agent: "A" * 500)
+
+    assert_equal 255, subscription.reload.user_agent.length
+  end
+
+  test "users lose their subscriptions when they're deleted" do
+    assert_difference -> { Push::Subscription.count }, -2 do
+      users(:david).destroy
+    end
+  end
+end
