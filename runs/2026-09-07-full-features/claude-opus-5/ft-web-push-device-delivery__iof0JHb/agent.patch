new file mode 100644
index 0000000..e9cc38a
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,33 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.html { head :created }
+      format.json { render :create, status: :created }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find_by(id: params[:id])&.destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..c4c7a5b
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,132 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Turns push notifications on and off for this browser. The subscription the
+// push service hands us is kept server-side, so what lands in the tray also
+// reaches this device when Fizzy is closed.
+export default class extends Controller {
+  static targets = [ "switch", "details", "unsupported" ]
+  static classes = [ "on" ]
+  static values = { url: String, vapidPublicKey: String }
+
+  connect() {
+    this.refresh()
+  }
+
+  toggle(event) {
+    if (event.target.checked) {
+      this.subscribe()
+    } else {
+      this.unsubscribe()
+    }
+  }
+
+  async subscribe() {
+    try {
+      if (this.#supported && await this.#requestPermission()) {
+        await this.#createSubscription(await this.#subscribeToPushService())
+      }
+    } finally {
+      await this.refresh()
+    }
+  }
+
+  async unsubscribe() {
+    try {
+      const subscription = await this.#currentSubscription()
+
+      if (subscription) {
+        await subscription.unsubscribe()
+        await this.#destroySubscription(subscription)
+      }
+    } finally {
+      await this.refresh()
+    }
+  }
+
+  async refresh() {
+    const blocked = this.#supported && this.#permission === "denied"
+    const subscribed = this.#supported && this.#permission === "granted" && Boolean(await this.#currentSubscription())
+
+    this.element.classList.toggle(this.onClass, subscribed)
+
+    if (this.hasSwitchTarget) {
+      this.switchTarget.checked = subscribed
+      this.switchTarget.disabled = !this.#supported || blocked
+    }
+
+    this.unsupportedTargets.forEach(target => target.hidden = this.#supported)
+    this.detailsTargets.forEach(target => target.hidden = !blocked)
+  }
+
+  async #subscribeToPushService() {
+    const registration = await navigator.serviceWorker.ready
+    const options = { userVisibleOnly: true, applicationServerKey: this.#applicationServerKey }
+
+    try {
+      return await registration.pushManager.subscribe(options)
+    } catch {
+      // A subscription made with an older key pair stands in the way of a new one.
+      const stale = await registration.pushManager.getSubscription()
+      await stale?.unsubscribe()
+
+      return registration.pushManager.subscribe(options)
+    }
+  }
+
+  async #currentSubscription() {
+    if (this.#supported) {
+      const registration = await navigator.serviceWorker.ready
+
+      return registration.pushManager.getSubscription()
+    } else {
+      return null
+    }
+  }
+
+  async #createSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const response = await post(this.urlValue, {
+      body: { push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      const { id } = await response.json
+      localStorage.setItem(this.#storageKey(endpoint), id)
+    }
+  }
+
+  async #destroySubscription(subscription) {
+    const id = localStorage.getItem(this.#storageKey(subscription.endpoint))
+
+    if (id) {
+      localStorage.removeItem(this.#storageKey(subscription.endpoint))
+      await destroy(`${this.urlValue}/${id}`, { responseKind: "json" })
+    }
+  }
+
+  async #requestPermission() {
+    return this.#permission === "granted" || await Notification.requestPermission() === "granted"
+  }
+
+  #storageKey(endpoint) {
+    return `push_subscription:${endpoint}`
+  }
+
+  get #permission() {
+    return this.#supported ? Notification.permission : "denied"
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padded = this.vapidPublicKeyValue.padEnd(Math.ceil(this.vapidPublicKeyValue.length / 4) * 4, "=")
+    const base64 = padded.replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
