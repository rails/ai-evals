diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..5da03c6
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,43 @@
+# Everything that lands in the tray also reaches the browsers people have
+# turned notifications on for.
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    include Rails.application.routes.url_helpers
+
+    after_create_commit -> { deliver_push_notifications_later }
+    after_update_commit -> { deliver_push_notifications_later }, if: :source_id_previously_changed?
+  end
+
+  def deliver_push_notifications_later
+    user.push_subscriptions.each { it.deliver_later(push_payload) }
+  end
+
+  def push_payload
+    Push::Payload.new(title: push_title, body: push_body, path: push_path, tag: card_id)
+  end
+
+  private
+    def push_title
+      case source
+      when Event   then helpers.event_notification_title(source)
+      when Mention then "#{source.mentioner.first_name} @mentioned you"
+      end
+    end
+
+    def push_body
+      case source
+      when Event   then helpers.event_notification_body(source)
+      when Mention then source.source.mentionable_content
+      end
+    end
+
+    def push_path
+      card_path(card, script_name: account.slug)
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..8dccc70
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,35 @@
+module Push
+  DEFAULT_SUBJECT = "mailto:support@fizzy.do"
+
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    # Ops provides the key pair. Without it, there's nothing to sign pushes with.
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      vapid[:public_key]
+    end
+
+    def vapid_private_key
+      vapid[:private_key]
+    end
+
+    def vapid_subject
+      vapid[:subject].presence || DEFAULT_SUBJECT
+    end
+
+    def vapid_credentials
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+
+    private
+      def vapid
+        Rails.configuration.x.vapid
+      end
+  end
+end
diff --git a/app/models/push/payload.rb b/app/models/push/payload.rb
new file mode 100644
index 0000000..f9cd255
--- /dev/null
+++ b/app/models/push/payload.rb
@@ -0,0 +1,33 @@
+# The message handed to the push service, and from there to the service worker,
+# which turns it into a notification on the person's phone or desktop.
+class Push::Payload
+  MAX_TITLE_LENGTH = 100
+  MAX_BODY_LENGTH  = 200
+
+  attr_reader :title, :body, :path, :tag
+
+  def initialize(title:, body:, path:, tag: nil)
+    @title = title.to_s.truncate(MAX_TITLE_LENGTH)
+    @body = body.to_s.truncate(MAX_BODY_LENGTH)
+    @path = path
+    @tag = tag
+  end
+
+  def to_h
+    {
+      title: title,
+      options: {
+        body: body,
+        tag: tag,
+        renotify: tag.present?,
+        icon: "/app-icon-192.png",
+        badge: "/app-icon-192-maskable.png",
+        data: { path: path }
+      }.compact
+    }
+  end
+
+  def to_json(*args)
+    to_h.to_json(*args)
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..5a03251
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,44 @@
+# A single browser on a single device, as handed to us by its push service.
+class Push::Subscription < ApplicationRecord
+  TIMEOUT = 5.seconds
+
+  # A push service that no longer knows this subscription won't ever know it again.
+  GONE_ERRORS = [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized ]
+
+  # Pushes are best-effort: a push service that's down, slow, or unhappy shouldn't
+  # take anything else with it.
+  DELIVERY_ERRORS = [ WebPush::Error, SocketError, SystemCallError, IOError, Timeout::Error, OpenSSL::SSL::SSLError ]
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  normalizes :user_agent, with: -> { it.truncate(255) }
+
+  scope :ordered, -> { order(:created_at) }
+
+  def deliver_later(payload)
+    DeliverJob.perform_later(self, payload.to_json)
+  end
+
+  def deliver(message)
+    if Push.enabled?
+      WebPush.payload_send \
+        message: message,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: Push.vapid_credentials,
+        urgency: "high",
+        open_timeout: TIMEOUT.to_i,
+        read_timeout: TIMEOUT.to_i,
+        ssl_timeout: TIMEOUT.to_i
+    end
+  rescue *GONE_ERRORS
+    destroy
+  rescue *DELIVERY_ERRORS => error
+    Rails.logger.warn "Push delivery to subscription #{id} failed: #{error.class}"
+  end
+end
