@@ -0,0 +1,82 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @user = users(:david)
+  end
+
+  test "create registers the subscription the browser handed us" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "https://push.example.com/subscriptions/new", p256dh_key: "p256dh", auth_key: "auth" }
+      }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.order(:created_at).last
+    assert_equal "https://push.example.com/subscriptions/new", subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create refreshes the keys of a subscription we already know about" do
+    subscription = push_subscriptions(:davids_laptop)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: "refreshed", auth_key: "refreshed" }
+      }
+    end
+
+    assert_response :created
+    assert_equal "refreshed", subscription.reload.p256dh_key
+  end
+
+  test "create returns the subscription as json" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: { endpoint: "https://push.example.com/subscriptions/new", p256dh_key: "p256dh", auth_key: "auth" }
+    }, as: :json
+
+    assert_response :created
+    assert_equal @user.push_subscriptions.order(:created_at).last.id, response.parsed_body["id"]
+  end
+
+  test "create requires the endpoint" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "", p256dh_key: "p256dh", auth_key: "auth" }
+      }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy removes the subscription" do
+    subscription = push_subscriptions(:davids_laptop)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_response :no_content
+  end
+
+  test "subscriptions can only be managed for yourself" do
+    post user_push_subscriptions_path(users(:kevin)), params: {
+      push_subscription: { endpoint: "https://push.example.com/subscriptions/new", p256dh_key: "p256dh", auth_key: "auth" }
+    }
+
+    assert_response :forbidden
+  end
+
+  test "destroy leaves other people's subscriptions alone" do
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(@user, push_subscriptions(:kevins_laptop))
+    end
+
+    assert_response :no_content
+  end
+end
