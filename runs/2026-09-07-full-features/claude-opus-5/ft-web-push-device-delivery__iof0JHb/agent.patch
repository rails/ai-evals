diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..5716b2e
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,33 @@
+# Push notifications are signed with a VAPID key pair, provided by ops as
+# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY. Without them, web push stays off.
+#
+# For development and test we generate a key pair on the fly, so push can be
+# tried out without any setup. The development pair is cached in tmp/, since
+# browsers remember the key they subscribed with.
+require "web_push"
+
+Rails.application.configure do
+  config.x.vapid = ActiveSupport::OrderedOptions.new
+  config.x.vapid.subject = ENV["VAPID_SUBJECT"].presence
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+
+  if (config.x.vapid.public_key.blank? || config.x.vapid.private_key.blank?) && Rails.env.local?
+    cache = Rails.root.join("tmp/vapid_key.json")
+
+    keys = begin
+      JSON.parse(cache.read) if Rails.env.development? && cache.exist?
+    rescue JSON::ParserError
+      nil
+    end
+
+    if keys.nil?
+      generated = WebPush.generate_key
+      keys = { "public_key" => generated.public_key, "private_key" => generated.private_key }
+      cache.write(JSON.generate(keys)) if Rails.env.development?
+    end
+
+    config.x.vapid.public_key = keys["public_key"]
+    config.x.vapid.private_key = keys["private_key"]
+  end
+end
