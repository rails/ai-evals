diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..d7770b2
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,126 @@
+# A time window that collects the notifications a person receives, so they get
+# a single email per window instead of one email per notification.
+#
+# The window opens when the first notification of the window lands, and lasts
+# for the period configured in the person's `bundle_email_frequency` setting.
+# Windows for a person never overlap: notifications that arrive late join the
+# window that has already opened for them.
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, dependent: :nullify
+
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_it_starts, :does_not_overlap_another_window
+
+  scope :ordered, -> { order(:starts_at) }
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :elapsed, ->(time = Time.current) { where(ends_at: ..time) }
+  scope :due, ->(time = Time.current) { pending.elapsed(time) }
+
+  after_create_commit :deliver_later
+
+  class << self
+    # Returns the window a notification landing at +at+ belongs to, opening a new
+    # one when there isn't an open window already. Returns nil when the person
+    # doesn't want bundled emails.
+    def open_for(user, at: Time.current)
+      if period = user.bundle_email_period
+        user.with_lock do
+          latest = latest_for(user)
+
+          if latest&.open?(at)
+            latest
+          else
+            open_window_after(latest, user: user, at: at, period: period)
+          end
+        end
+      end
+    end
+
+    def deliver_all_due
+      due.find_each(&:deliver_now)
+    end
+
+    private
+      def latest_for(user)
+        user.notification_bundles.ordered.last
+      end
+
+      # New windows start when the notification landed, but never before the
+      # previous window ended, so windows can't overlap.
+      def open_window_after(bundle, user:, at:, period:)
+        starts_at = [ at, bundle&.ends_at ].compact.max
+        user.notification_bundles.create!(starts_at: starts_at, ends_at: starts_at + period)
+      end
+  end
+
+  def open?(time = Time.current)
+    pending? && time < ends_at
+  end
+
+  def elapsed?(time = Time.current)
+    ends_at <= time
+  end
+
+  def pending?
+    delivered_at.nil?
+  end
+
+  def delivered?
+    !pending?
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    if deliverable? && claim_delivery
+      Current.with_account(account) do
+        NotificationMailer.bundle(self).deliver_later
+      end
+    end
+  end
+
+  def bundled_notifications
+    notifications.unread.preloaded.ordered
+  end
+
+  private
+    # Windows are only ever emailed once they have closed, so a person gets a
+    # single email per window no matter when delivery is attempted.
+    def deliverable?
+      elapsed? && user.bundle_emails? && user.active? && user.identity.present? &&
+        account.active? && bundled_notifications.any?
+    end
+
+    def ends_after_it_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add :ends_at, "must be after the window starts"
+      end
+    end
+
+    def does_not_overlap_another_window
+      if starts_at.present? && ends_at.present? && user.present? && overlapping_windows.exists?
+        errors.add :base, "can't overlap another window"
+      end
+    end
+
+    def overlapping_windows
+      user.notification_bundles.where.not(id: id).where(starts_at: ...ends_at).where.not(ends_at: ..starts_at)
+    end
+
+    # Claiming the delivery in a single statement ensures a bundle is only ever
+    # emailed once, even if its delivery is attempted concurrently.
+    def claim_delivery
+      now = Time.current
+
+      if self.class.pending.where(id: id).update_all(delivered_at: now, updated_at: now) == 1
+        self.delivered_at = now
+        true
+      end
+    end
+end
diff --git a/app/models/notification/bundling.rb b/app/models/notification/bundling.rb
new file mode 100644
index 0000000..3725b97
--- /dev/null
+++ b/app/models/notification/bundling.rb
@@ -0,0 +1,22 @@
+# Puts every notification into the email bundle covering the moment it landed,
+# so people get one email per window instead of one email per notification.
+module Notification::Bundling
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    after_save_commit :bundle_for_email, if: :source_id_previously_changed?
+  end
+
+  def bundle_for_email
+    if bundle = Notification::Bundle.open_for(user, at: landed_at)
+      update_column :bundle_id, bundle.id
+    end
+  end
+
+  private
+    def landed_at
+      updated_at || Time.current
+    end
+end
