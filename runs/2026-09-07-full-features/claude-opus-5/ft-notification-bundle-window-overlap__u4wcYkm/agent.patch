+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+  end
+
+  test "bundle emails every notification in the window at once" do
+    bundle = Notification::Bundle.open_for(@user)
+    @user.notifications.each { |notification| notification.update!(bundle: bundle) }
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "#{@user.notifications.unread.count} new notifications in 37signals", email.subject
+
+    @user.notifications.unread.each do |notification|
+      assert_includes email.html_part.body.to_s, notification.card.board.name
+      assert_includes email.text_part.body.to_s, notification.payload.title
+    end
+
+    assert_includes email.html_part.body.to_s, "once a day"
+  end
+
+  test "bundle subject is singular for a single notification" do
+    bundle = Notification::Bundle.open_for(@user)
+    @user.notifications.unread.first.update!(bundle: bundle)
+
+    assert_equal "1 new notification in 37signals", NotificationMailer.bundle(bundle).subject
+  end
+end
