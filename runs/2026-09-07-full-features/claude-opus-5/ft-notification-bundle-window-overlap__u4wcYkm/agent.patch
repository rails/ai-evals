+class NotificationMailerPreview < ActionMailer::Preview
+  def bundle
+    notification = Notification.order(:created_at).last
+    user = notification.user
+    Current.account = user.account
+
+    bundle = user.notification_bundles.first ||
+      Notification::Bundle.new(user: user, starts_at: 1.day.ago, ends_at: Time.current)
+    bundle.notifications = user.notifications.unread.limit(10)
+
+    NotificationMailer.bundle(bundle)
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..e008121
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,221 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.notifications.reset
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "no bundle is opened when email bundling is off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_nil Notification::Bundle.open_for(@user)
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification
+    end
+  end
+
+  test "the first notification opens a window that starts when it landed" do
+    notification = nil
+
+    assert_difference -> { Notification::Bundle.count }, 1 do
+      notification = create_notification
+    end
+
+    bundle = notification.reload.bundle
+
+    assert_equal @user, bundle.user
+    assert_equal @user.account, bundle.account
+    assert_in_delta notification.created_at, bundle.starts_at, 1.second
+    assert_in_delta notification.created_at + 4.hours, bundle.ends_at, 1.second
+  end
+
+  test "window length follows the frequency setting" do
+    { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.each do |frequency, period|
+      @user.notification_bundles.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+
+      bundle = Notification::Bundle.open_for(@user)
+
+      assert_equal period, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "notifications landing within an open window join it" do
+    first = create_notification(card: cards(:logo))
+    second = travel_to(2.hours.from_now) { create_notification(card: cards(:layout)) }
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal first.reload.bundle, second.reload.bundle
+  end
+
+  test "a notification landing after the window closes opens a new one" do
+    first = create_notification(card: cards(:logo))
+    second = travel_to(5.hours.from_now) { create_notification(card: cards(:layout)) }
+
+    assert_equal 2, @user.notification_bundles.count
+    assert_not_equal first.reload.bundle, second.reload.bundle
+    assert second.reload.bundle.starts_at >= first.reload.bundle.ends_at
+  end
+
+  test "late notifications join the window that has already opened" do
+    bundle = Notification::Bundle.open_for(@user)
+
+    late = create_notification(at: 10.minutes.ago)
+
+    assert_equal bundle, late.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "windows never overlap" do
+    Notification::Bundle.open_for(@user, at: 1.hour.ago)
+    Notification::Bundle.open_for(@user, at: 2.hours.ago)
+    travel 5.hours
+    Notification::Bundle.open_for(@user)
+    Notification::Bundle.open_for(@user, at: 3.hours.ago)
+
+    windows = @user.notification_bundles.ordered.pluck(:starts_at, :ends_at)
+
+    windows.each_cons(2) do |(_, first_ends_at), (second_starts_at, _)|
+      assert second_starts_at >= first_ends_at, "windows #{windows.inspect} overlap"
+    end
+  end
+
+  test "overlapping windows are invalid" do
+    bundle = Notification::Bundle.open_for(@user)
+
+    overlapping = @user.notification_bundles.build(starts_at: bundle.ends_at - 1.hour, ends_at: bundle.ends_at + 1.hour)
+    assert_not overlapping.valid?
+
+    adjacent = @user.notification_bundles.build(starts_at: bundle.ends_at, ends_at: bundle.ends_at + 1.hour)
+    assert adjacent.valid?
+  end
+
+  test "a window has to end after it starts" do
+    bundle = @user.notification_bundles.build(starts_at: Time.current, ends_at: 1.hour.ago)
+
+    assert_not bundle.valid?
+  end
+
+  test "a delivered window is never reused" do
+    bundle = Notification::Bundle.open_for(@user)
+    bundle.update!(delivered_at: Time.current)
+
+    assert_not_equal bundle, Notification::Bundle.open_for(@user)
+  end
+
+  test "delivery is scheduled for the end of the window" do
+    bundle = nil
+
+    assert_enqueued_with job: Notification::Bundle::DeliveryJob do
+      bundle = Notification::Bundle.open_for(@user)
+    end
+
+    assert_equal bundle.ends_at.to_i, enqueued_jobs.last["scheduled_at"].to_time.to_i
+  end
+
+  test "one email per window" do
+    create_notification(card: cards(:logo))
+    create_notification(card: cards(:layout))
+    bundle = @user.notification_bundles.sole
+
+    travel_to bundle.ends_at + 1.second
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        bundle.deliver_now
+        bundle.deliver_now
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "an open window is not emailed yet" do
+    create_notification
+    bundle = @user.notification_bundles.sole
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+
+    assert bundle.reload.pending?
+  end
+
+  test "due windows are delivered" do
+    create_notification
+    bundle = @user.notification_bundles.sole
+
+    travel_to bundle.ends_at + 1.minute
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        Notification::Bundle.deliver_all_due
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "windows that are still open are not delivered" do
+    create_notification
+
+    assert_no_emails do
+      perform_enqueued_jobs do
+        Notification::Bundle.deliver_all_due
+      end
+    end
+  end
+
+  test "empty windows are not emailed" do
+    bundle = Notification::Bundle.open_for(@user)
+
+    travel_to bundle.ends_at + 1.second
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+  end
+
+  test "windows with only read notifications are not emailed" do
+    notification = create_notification
+    notification.read
+    bundle = notification.reload.bundle
+
+    travel_to bundle.ends_at + 1.second
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+  end
+
+  test "nothing is emailed after turning bundled emails off" do
+    notification = create_notification
+    @user.settings.update!(bundle_email_frequency: :never)
+    bundle = notification.reload.bundle
+
+    travel_to bundle.ends_at + 1.second
+
+    assert_no_emails do
+      perform_enqueued_jobs { bundle.deliver_now }
+    end
+  end
+
+  private
+    def create_notification(card: cards(:logo), at: nil)
+      if at
+        travel_to(at) { build_notification(card) }
+      else
+        build_notification(card)
+      end
+    end
+
+    def build_notification(card)
+      Notification.create!(user: @user, creator: users(:david), card: card,
+        source: card.events.first || events(:logo_published), unread_count: 1)
+    end
+end
diff --git a/test/models/notification/bundling_test.rb b/test/models/notification/bundling_test.rb
new file mode 100644
index 0000000..d60758a
--- /dev/null
+++ b/test/models/notification/bundling_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Notification::BundlingTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+    @user.notifications.reset
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "activity within a window is emailed once" do
+    perform_enqueued_jobs do
+      Notifier.for(events(:layout_commented)).notify
+      travel 1.hour
+      Notifier.for(events(:logo_published)).notify
+    end
+
+    bundle = @user.notification_bundles.sole
+
+    assert_equal @user.notifications.pluck(:id).sort, bundle.notifications.pluck(:id).sort
+
+    travel_to bundle.ends_at + 1.minute
+
+    assert_emails 1 do
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+    end
+  end
+
+  test "activity in a later window is emailed separately" do
+    Notifier.for(events(:layout_commented)).notify
+    first = @user.notification_bundles.sole
+
+    travel_to first.ends_at + 1.minute
+    Notifier.for(events(:logo_published)).notify
+
+    assert_equal 2, @user.notification_bundles.count
+
+    assert_emails 1 do
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+    end
+
+    travel_to @user.notification_bundles.ordered.last.ends_at + 1.minute
+
+    assert_emails 1 do
+      perform_enqueued_jobs { Notification::Bundle.deliver_all_due }
+    end
+  end
+
+  test "notifications are not bundled when email bundling is off" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notifier.for(events(:layout_commented)).notify
+    end
+
+    assert_nil @user.notifications.sole.bundle
+  end
+
+  test "renotifying an already bundled notification keeps it in the open window" do
+    Notifier.for(events(:layout_commented)).notify
+    notification = @user.notifications.sole
+    bundle = notification.bundle
+
+    travel 1.hour
+    Notifier.for(events(:layout_published)).notify
+
+    assert_equal bundle, notification.reload.bundle
+    assert_equal 1, @user.notification_bundles.count
+  end
+end
