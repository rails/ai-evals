+++ b/test/models/notification/pushable_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  test "a new notification is pushed to the user's devices" do
+    assert_enqueued_with job: Notification::PushJob do
+      users(:david).notifications.create!(source: events(:shipping_published), creator: users(:kevin))
+    end
+  end
+
+  test "a notification is pushed again when it's about something new" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob do
+      notification.update!(source: events(:logo_published), read_at: nil)
+    end
+  end
+
+  test "reading a notification doesn't push it again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "pushing delivers the notification to every device of the user" do
+    kevin = users(:kevin)
+    subscriptions = [ subscribe(kevin, endpoint: "https://push.example.com/subscriptions/kevins-laptop"),
+      subscribe(kevin, endpoint: "https://push.example.com/subscriptions/kevins-phone") ]
+    stub_push_requests
+
+    notifications(:logo_assignment_kevin).push_now
+
+    subscriptions.each { |subscription| assert_requested :post, subscription.endpoint }
+  end
+
+  test "nothing is pushed without a VAPID key pair" do
+    without_vapid_credentials do
+      assert_no_enqueued_jobs only: Notification::PushJob do
+        users(:david).notifications.create!(source: events(:shipping_published), creator: users(:kevin))
+      end
+    end
+  end
+
+  private
+    def without_vapid_credentials
+      vapid = Rails.application.config.x.vapid
+      public_key, private_key = vapid.public_key, vapid.private_key
+      vapid.public_key = vapid.private_key = nil
+      yield
+    ensure
+      vapid.public_key, vapid.private_key = public_key, private_key
+    end
+end
