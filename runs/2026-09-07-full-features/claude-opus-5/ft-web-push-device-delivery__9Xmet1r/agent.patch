diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..2e06672
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.order(:created_at).last
+    assert_equal subscription_params[:endpoint], subscription.endpoint
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create refreshes the keys of a device that's already subscribed" do
+    existing = subscribe(@user)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: subscription_params.merge(endpoint: existing.endpoint) }, as: :json
+    end
+
+    assert_response :created
+    assert_equal subscription_params[:auth_key], existing.reload.auth_key
+  end
+
+  test "create for someone else is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires signing in" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_response :redirect
+  end
+
+  private
+    def subscription_params
+      { endpoint: "https://push.example.com/subscriptions/new-device", p256dh_key: "a-p256dh-key", auth_key: "an-auth-key" }
+    end
+end
