new file mode 100644
index 0000000..1fa6024
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,26 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :newly_notified?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if Push.enabled?
+  end
+
+  def push_now
+    user.push_subscriptions.each { |subscription| subscription.deliver(push_payload) }
+  end
+
+  private
+    # A notification lands in the tray when it's created, and again whenever a new
+    # event or mention refreshes it.
+    def newly_notified?
+      previously_new_record? || source_id_previously_changed?
+    end
+
+    def push_payload
+      Push::Payload.new(self)
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..f1b688e
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,29 @@
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    # Pushes only reach browsers where ops has provisioned a VAPID key pair.
+    def enabled?
+      public_key.present? && private_key.present?
+    end
+
+    def public_key
+      vapid.public_key
+    end
+
+    def private_key
+      vapid.private_key
+    end
+
+    def vapid_credentials
+      { subject: vapid.subject, public_key: public_key, private_key: private_key }
+    end
+
+    private
+      def vapid
+        Rails.application.config.x.vapid
+      end
+  end
+end
diff --git a/app/models/push/payload.rb b/app/models/push/payload.rb
new file mode 100644
index 0000000..104a3f2
--- /dev/null
+++ b/app/models/push/payload.rb
@@ -0,0 +1,40 @@
+# The contents of a push notification: what the notification tray says, plus the
+# path of the card it's about, in the shape the service worker hands to
+# `showNotification`.
+class Push::Payload
+  BODY_LIMIT = 200
+
+  attr_reader :notification
+  delegate :card, :source, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def title
+    case source
+    when Event   then helpers.event_notification_title(source)
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def body
+    case source
+    when Event   then helpers.event_notification_body(source)
+    when Mention then source.source.mentionable_content.truncate(BODY_LIMIT)
+    end
+  end
+
+  def path
+    Rails.application.routes.url_helpers.card_path(card, script_name: card.account.slug)
+  end
+
+  def to_json(*)
+    { title: title, options: { body: body, tag: card.id, data: { path: path } } }.to_json
+  end
+
+  private
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..2920c8e
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,22 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, length: { maximum: 512 }, uniqueness: { scope: :user_id }
+  validates :p256dh_key, :auth_key, presence: true
+
+  def deliver(payload)
+    WebPush.payload_send(
+      message: payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_credentials,
+      urgency: "high"
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::ResponseError => error
+    Rails.logger.error "Push subscription #{id} failed to deliver: #{error.message}"
+  end
+end
