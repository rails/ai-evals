+namespace :push do
+  desc "Generate a VAPID key pair for sending web push notifications"
+  task keys: :environment do
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+  end
+end
