+require "test_helper"
+
+class Push::PayloadTest < ActiveSupport::TestCase
+  test "an event notification says what the tray says" do
+    payload = Push::Payload.new(notifications(:logo_assignment_kevin))
+
+    assert_equal "The logo isn't big enough", payload.title
+    assert_equal "Assigned to Kevin", payload.body
+  end
+
+  test "a mention notification says who mentioned you" do
+    payload = Push::Payload.new(notifications(:logo_mentioned_david))
+
+    assert_equal "JZ @mentioned you", payload.title
+    assert_equal mentions(:logo_comment_david_mention_by_jz).source.mentionable_content, payload.body
+  end
+
+  test "it points at the card the notification is about" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = Push::Payload.new(notification)
+
+    assert_equal "#{accounts("37s").slug}/cards/#{notification.card.to_param}", payload.path
+    assert_equal payload.path, JSON.parse(payload.to_json).dig("options", "data", "path")
+  end
+
+  test "it carries the title and body the service worker shows" do
+    payload = Push::Payload.new(notifications(:logo_assignment_kevin))
+    pushed = JSON.parse(payload.to_json)
+
+    assert_equal payload.title, pushed["title"]
+    assert_equal payload.body, pushed.dig("options", "body")
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..4e3caad
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = subscribe(users(:david))
+  end
+
+  test "a device can only subscribe once per user" do
+    duplicate = users(:david).push_subscriptions.build(@subscription.attributes.except("id"))
+
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:endpoint], "has already been taken"
+  end
+
+  test "the same device can subscribe for different users" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription.attributes.except("id", "user_id", "account_id"))
+
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "keys are required" do
+    subscription = users(:david).push_subscriptions.build(endpoint: "https://push.example.com/subscriptions/keyless")
+
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "delivering a payload to the push service" do
+    stub_push_request
+
+    @subscription.deliver payload
+
+    assert_requested :post, @subscription.endpoint
+  end
+
+  test "delivering to a subscription the push service has forgotten removes it" do
+    stub_push_request status: 410
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver payload
+    end
+  end
+
+  test "a failing push service leaves the subscription alone" do
+    stub_push_request status: 500
+
+    assert_no_difference -> { Push::Subscription.count } do
+      @subscription.deliver payload
+    end
+  end
+
+  private
+    def payload
+      Push::Payload.new(notifications(:logo_assignment_kevin))
+    end
+
+    def stub_push_request(status: 201)
+      stub_request(:post, @subscription.endpoint).to_return(status: status)
+    end
+end
