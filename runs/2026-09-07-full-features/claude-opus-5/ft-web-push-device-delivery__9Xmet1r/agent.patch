@@ -0,0 +1,21 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.user
+
+      head :forbidden unless @user&.id == params[:user_id]
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..cc9a8f0
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+import { getMetaContent } from "helpers/meta_helpers"
+
+// Turns push notifications on for this device: asks the browser for permission,
+// subscribes to its push service, and hands the subscription over to the server
+// so notifications reach the device.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details" ]
+  static values = { publicKey: String, url: String }
+
+  connect() {
+    this.#refresh()
+  }
+
+  async subscribe() {
+    if (this.#supported && await this.#permissionGranted()) {
+      await this.#deliverSubscription(await this.#subscribeToPushService())
+    }
+
+    this.#refresh()
+  }
+
+  async #refresh() {
+    const subscription = this.#supported && this.#permitted ? await this.#currentSubscription() : null
+
+    this.element.classList.toggle(this.onClass, Boolean(subscription))
+    this.detailsTargets.forEach(details => details.hidden = !this.#blocked)
+
+    if (subscription) await this.#deliverSubscription(subscription)
+  }
+
+  async #currentSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  async #subscribeToPushService() {
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+  }
+
+  async #deliverSubscription(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await fetch(this.urlValue, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", "X-CSRF-Token": getMetaContent("csrf-token") },
+      body: JSON.stringify({ push_subscription: { endpoint: endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } })
+    })
+  }
+
+  async #permissionGranted() {
+    return await Notification.requestPermission() === "granted"
+  }
+
+  get #permitted() {
+    return Notification.permission === "granted"
+  }
+
+  get #blocked() {
+    return !this.#supported || Notification.permission === "denied"
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // The push service wants the VAPID public key as bytes, but it travels here as base64url.
+  get #applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(this.publicKeyValue.length / 4) * 4, "=")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
