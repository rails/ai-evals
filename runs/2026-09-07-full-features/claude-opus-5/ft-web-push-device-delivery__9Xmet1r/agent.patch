+module PushTestHelper
+  # Browsers hand over a P-256 public key and an auth secret from their push service.
+  def subscribe(user, endpoint: "https://push.example.com/subscriptions/#{user.name.parameterize}")
+    user.push_subscriptions.create! \
+      endpoint: endpoint,
+      p256dh_key: WebPush::VapidKey.new.public_key,
+      auth_key: Base64.urlsafe_encode64(SecureRandom.bytes(16)),
+      user_agent: "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Chrome/140.0"
+  end
+
+  def stub_push_requests
+    stub_request(:post, /push\.example\.com/).to_return(status: 201)
+  end
+end
