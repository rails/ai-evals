+require "test_helper"
+
+class PushNotificationsTest < ActionDispatch::IntegrationTest
+  ENDPOINT = "https://push.example.com/subscriptions/davids-laptop"
+
+  test "what lands in the tray reaches the device" do
+    subscribe_davids_laptop
+    push = stub_request(:post, ENDPOINT).to_return(status: 201)
+
+    logout_and_sign_in_as :kevin
+    perform_enqueued_jobs do
+      post card_comments_path(cards(:logo)), params: { comment: { body: "Agreed." } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_requested push
+    assert_requested :post, ENDPOINT, headers: { "Content-Encoding" => "aes128gcm" }
+  end
+
+  test "nothing is pushed to someone who hasn't turned notifications on" do
+    push = stub_request(:post, ENDPOINT)
+
+    logout_and_sign_in_as :kevin
+    perform_enqueued_jobs do
+      post card_comments_path(cards(:logo)), params: { comment: { body: "Agreed." } }, as: :turbo_stream
+    end
+
+    assert_not_requested push
+  end
+
+  private
+    def subscribe_davids_laptop
+      sign_in_as :david
+
+      post user_push_subscriptions_path(users(:david)), as: :json, params: { push_subscription: {
+        endpoint: ENDPOINT,
+        p256dh_key: WebPush::VapidKey.new.public_key,
+        auth_key: Base64.urlsafe_encode64(SecureRandom.bytes(16)) } }
+
+      assert_response :created
+    end
+end
