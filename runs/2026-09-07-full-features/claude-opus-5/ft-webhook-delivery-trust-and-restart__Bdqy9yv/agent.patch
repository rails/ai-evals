@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "a tracker is created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal webhook.account, webhook.delinquency_tracker.account
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+
+  test "recording a failure starts the failure window" do
+    freeze_time do
+      @tracker.record_failure
+
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+    end
+  end
+
+  test "consecutive failures within the window deactivate the webhook" do
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES.times { @tracker.record_failure }
+    end
+
+    assert @tracker.delinquent?
+    assert_equal Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES, @tracker.consecutive_failures_count
+  end
+
+  test "one failure short of the threshold keeps the webhook active" do
+    (Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES - 1).times { @tracker.record_failure }
+
+    assert_not @tracker.delinquent?
+    assert @webhook.reload.active?
+  end
+
+  test "failures spread over more than an hour restart the window" do
+    9.times { @tracker.record_failure }
+
+    travel 61.minutes do
+      @tracker.record_failure
+
+      assert_equal 1, @tracker.consecutive_failures_count
+      assert_equal Time.current, @tracker.first_failure_at
+      assert_not @tracker.delinquent?
+      assert @webhook.reload.active?
+    end
+  end
+
+  test "a success resets the count" do
+    3.times { @tracker.record_failure }
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "track dispatches on the delivery outcome" do
+    delivery = webhook_deliveries(:successfully_completed)
+    @tracker.update! consecutive_failures_count: 4, first_failure_at: Time.current
+
+    @tracker.track delivery
+    assert_equal 0, @tracker.consecutive_failures_count
+
+    @tracker.track webhook_deliveries(:errored)
+    assert_equal 1, @tracker.consecutive_failures_count
+  end
+
+  test "reactivating a webhook clears its delinquency" do
+    webhook = webhooks(:inactive)
+    webhook.delinquency_tracker.update! consecutive_failures_count: 10, first_failure_at: Time.current
+
+    webhook.activate
+
+    assert webhook.reload.active?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+    assert_not webhook.delinquency_tracker.delinquent?
+  end
+end
