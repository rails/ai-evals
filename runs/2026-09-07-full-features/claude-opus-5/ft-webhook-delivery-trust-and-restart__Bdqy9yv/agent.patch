diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..e59ea1f
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,49 @@
+# Keeps an eye on webhooks that keep failing. A receiver that fails
+# MAX_CONSECUTIVE_FAILURES times in a row within FAILURE_WINDOW gets switched
+# off, so we stop hammering an endpoint that's clearly not listening anymore.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    if delivery.succeeded?
+      record_success
+    else
+      record_failure
+    end
+  end
+
+  def record_success
+    reset
+  end
+
+  def record_failure
+    with_lock do
+      if within_failure_window?
+        increment! :consecutive_failures_count
+      else
+        update! consecutive_failures_count: 1, first_failure_at: Time.current
+      end
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def reset
+    if consecutive_failures_count.to_i.positive? || first_failure_at.present?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def delinquent?
+    within_failure_window? && consecutive_failures_count.to_i >= MAX_CONSECUTIVE_FAILURES
+  end
+
+  private
+    def within_failure_window?
+      first_failure_at.present? && first_failure_at > FAILURE_WINDOW.ago
+    end
+end
