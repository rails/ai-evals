+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+    @card = cards(:logo)
+    @creator = users(:david)
+  end
+
+  test "creating an event relays it to the subscribed webhooks" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event "card_published"
+    end
+  end
+
+  test "events nobody subscribed to aren't relayed" do
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      create_event "card_triaged"
+    end
+  end
+
+  test "inactive webhooks don't get events relayed" do
+    @webhook.deactivate
+
+    assert_no_enqueued_jobs only: Event::RelayJob do
+      create_event "card_published"
+    end
+  end
+
+  test "webhooks on other boards don't get events relayed" do
+    boards(:private).webhooks.create! name: "Private", url: "https://private.example.com/webhook", subscribed_actions: [ "card_published" ]
+
+    event = create_event "card_published"
+    event.relay_now
+
+    assert_equal [ @webhook.id ], event.webhook_deliveries.map(&:webhook_id)
+  end
+
+  test "relay_now creates one pending delivery per subscribed webhook and enqueues it" do
+    other = @board.webhooks.create! name: "Another", url: "https://another.example.com/webhook", subscribed_actions: [ "card_published" ]
+    event = create_event "card_published"
+
+    assert_difference -> { Webhook::Delivery.count }, 2 do
+      assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+        event.relay_now
+      end
+    end
+
+    assert_equal [ @webhook, other ].map(&:id).sort, event.webhook_deliveries.map(&:webhook_id).sort
+    assert event.webhook_deliveries.all?(&:pending?)
+  end
+
+  test "relay_now only creates one delivery per webhook and event" do
+    event = create_event "card_published"
+
+    assert_difference -> { Webhook::Delivery.count }, 1 do
+      2.times { event.relay_now }
+    end
+  end
+
+  test "relaying delivers the event to the receiver" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = create_event "card_published"
+    2.times { perform_enqueued_jobs }
+
+    assert_requested stub, times: 1
+    assert event.webhook_deliveries.sole.succeeded?
+  end
+
+  private
+    def create_event(action)
+      Event.create! board: @board, creator: @creator, eventable: @card, action: action
+    end
+end
