diff --git a/test/models/webhook/payload_test.rb b/test/models/webhook/payload_test.rb
new file mode 100644
index 0000000..a107e55
--- /dev/null
+++ b/test/models/webhook/payload_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @event = events(:layout_commented)
+  end
+
+  test "headers" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+
+    assert_equal %w[ User-Agent Content-Type X-Webhook-Signature X-Webhook-Timestamp ], payload.headers.keys
+    assert_equal "fizzy/1.0.0 Webhook", payload.headers["User-Agent"]
+    assert_equal "application/json", payload.headers["Content-Type"]
+    assert_equal @event.created_at.utc.iso8601, payload.headers["X-Webhook-Timestamp"]
+  end
+
+  test "signature is an HMAC of the body" do
+    webhook = webhooks(:active)
+    payload = Webhook::Payload.new(webhook, @event)
+
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload.body), payload.signature
+  end
+
+  test "regular receivers get the event as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), @event)
+    body = JSON.parse(payload.body)
+
+    assert_equal "application/json", payload.content_type
+    assert_equal @event.id, body["id"]
+    assert_equal @event.action, body["action"]
+    assert_equal @event.board.id, body.dig("board", "id")
+    assert_equal @event.creator.id, body.dig("creator", "id")
+    assert_equal @event.eventable.id, body.dig("eventable", "id")
+  end
+
+  test "campfire receivers get an HTML message" do
+    payload = Webhook::Payload.new(webhook_for("https://chat.example.com/rooms/1/2-secret/messages"), @event)
+
+    assert_equal "text/html", payload.content_type
+    assert_match "commented on", payload.body
+    assert_match card_url(@event.eventable.card), payload.body
+  end
+
+  test "basecamp receivers get their content param" do
+    payload = Webhook::Payload.new(webhook_for("https://3.basecamp.com/999/integrations/token/buckets/1/chats/2/lines"), @event)
+
+    assert_equal "application/json", payload.content_type
+    assert_match "commented on", JSON.parse(payload.body)["content"]
+  end
+
+  test "slack receivers get their text param" do
+    payload = Webhook::Payload.new(webhook_for("https://hooks.slack.com/services/T1234/B1234/abcdefghijkl"), @event)
+
+    assert_equal "application/json", payload.content_type
+    assert_match "commented on", JSON.parse(payload.body)["text"]
+  end
+
+  private
+    def webhook_for(url)
+      Webhook.create! name: "Chat", url: url, board: @event.board
+    end
+
+    def card_url(card)
+      Rails.application.routes.url_helpers.card_url(card, host: "example.com", script_name: @event.account.slug)
+    end
+end
