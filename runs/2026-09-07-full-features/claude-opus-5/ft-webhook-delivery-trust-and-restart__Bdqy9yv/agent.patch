@@ -29,4 +69,46 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      if self.class.pending.where(id: id).update_all(state: :in_progress, updated_at: Time.current) == 1
+        reload
+        true
+      else
+        false
+      end
+    end
+
+    def post_payload
+      payload = Webhook::Payload.new(webhook, event)
+      update! request: { headers: payload.headers }
+
+      record_response post(payload)
+    rescue *NETWORK_ERRORS => error
+      record_error error, "destination_unreachable"
+    rescue StandardError => error
+      record_error error, "delivery_failed"
+      raise
+    end
+
+    def post(payload)
+      uri = URI.parse(webhook.url)
+
+      Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT) do |http|
+        http.post uri.request_uri, payload.body, payload.headers
+      end
+    end
+
+    def record_response(response)
+      update! state: :completed, response: { code: response.code.to_i, headers: response.each_header.to_h }
+    end
+
+    def record_error(error, name)
+      update! state: :errored, response: { error: name, message: error.message }
+    end
+
+    def track_delinquency
+      webhook.delinquency_tracker.track self
+    end
 end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..889b436
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,80 @@
+# Renders what we send to a webhook receiver. Chat services get a readable
+# message; everything else gets the full JSON representation of the event.
+class Webhook::Payload
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  TEMPLATE = "webhooks/event"
+
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook, @event = webhook, event
+  end
+
+  def headers
+    {
+      "User-Agent" => USER_AGENT,
+      "Content-Type" => content_type,
+      "X-Webhook-Signature" => signature,
+      "X-Webhook-Timestamp" => timestamp
+    }
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||= if webhook.for_campfire?
+      message
+    elsif webhook.for_basecamp?
+      { content: message }.to_json
+    elsif webhook.for_slack?
+      { text: message }.to_json
+    else
+      event_json
+    end
+  end
+
+  def signature
+    OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, body
+  end
+
+  def timestamp
+    event.created_at.utc.iso8601
+  end
+
+  private
+    def message
+      render :html
+    end
+
+    def event_json
+      render :json
+    end
+
+    def render(format)
+      renderer.render(template: TEMPLATE, formats: [ format ], layout: false, assigns: { event: event }).strip
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: event.account.slug, **request_options)
+    end
+
+    def request_options
+      if host = url_options[:host].presence
+        { http_host: [ host, url_options[:port] ].compact.join(":"), https: url_options[:protocol].to_s.start_with?("https") }
+      else
+        {}
+      end
+    end
+
+    def url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
