index 0000000..b41b086
--- /dev/null
+++ b/test/integration/webhook_delivery_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class WebhookDeliveryTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @webhook.update! subscribed_actions: [ "comment_created", "card_closed" ]
+    @webhook.deliveries.delete_all
+    @card = cards(:logo)
+
+    Current.user = users(:david)
+  end
+
+  test "commenting on a card posts to the receiver and logs the delivery" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      relaying { @card.comments.create! body: "Looking good" }
+    end
+
+    delivery = @webhook.deliveries.ordered.first
+
+    assert_requested stub, times: 1
+    assert delivery.succeeded?
+    assert_equal "comment_created", delivery.event.action
+    assert_equal "application/json", delivery.request[:headers]["Content-Type"]
+  end
+
+  test "events the webhook isn't subscribed to are never posted" do
+    stub = stub_request(:post, @webhook.url)
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      relaying { @card.toggle_assignment(users(:kevin)) }
+    end
+
+    assert_not_requested stub
+  end
+
+  test "a receiver that keeps failing gets switched off, and the log tells the story" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES.times do |index|
+      relaying { @card.comments.create! body: "Attempt #{index}" }
+    end
+
+    assert_not @webhook.reload.active?
+    assert_equal Webhook::DelinquencyTracker::MAX_CONSECUTIVE_FAILURES, @webhook.deliveries.count
+    assert @webhook.deliveries.all?(&:failed?)
+    assert_equal [ 503 ], @webhook.deliveries.map { |delivery| delivery.response[:code] }.uniq
+  end
+
+  private
+    def relaying
+      perform_enqueued_jobs only: Event::RelayJob do
+        yield
+      end
+
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+end
