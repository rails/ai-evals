new file mode 100644
index 0000000..884f8a6
--- /dev/null
+++ b/app/models/event/relaying.rb
@@ -0,0 +1,25 @@
+# Relays events to the board's webhooks. One delivery record per webhook keeps
+# the log of what we sent and how it went, and makes sure each receiver gets
+# an event exactly once.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self) if relayable_webhooks.exists?
+  end
+
+  def relay_now
+    relayable_webhooks.each do |webhook|
+      webhook.deliver_later self
+    end
+  end
+
+  private
+    def relayable_webhooks
+      board.webhooks.active.subscribed_to(action)
+    end
+end
