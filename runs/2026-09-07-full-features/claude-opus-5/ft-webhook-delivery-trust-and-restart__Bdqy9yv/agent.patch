+
+  # Every event reaches a receiver exactly once: the pending -> in_progress
+  # transition is claimed atomically, so a duplicated or retried job that finds
+  # a delivery already under way -- or already delivered -- does nothing.
+  # Receivers that were switched off in the meantime are left alone.
+  def deliver_now
+    if deliverable? && claim
+      post_payload
