@@ -0,0 +1,26 @@
+class StripeWebhooksController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+  skip_forgery_protection
+
+  def create
+    event = Stripe::Webhook.construct_event(payload, signature_header, webhook_secret)
+    Account::Subscription.sync_from_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def payload
+      request.raw_post
+    end
+
+    def signature_header
+      request.headers["Stripe-Signature"]
+    end
+
+    def webhook_secret
+      ENV["STRIPE_WEBHOOK_SECRET"].to_s
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..061e96f
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,99 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def billing_plan
+    if subscription&.entitled? && subscription.plan.paid?
+      subscription.plan
+    elsif comped?
+      Account::Plan.complimentary
+    else
+      Account::Plan.free
+    end
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def cards_used
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards.published.count
+    end
+  end
+
+  def cards_remaining
+    return if card_limit.nil?
+
+    [ card_limit - cards_used, 0 ].max
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+
+  def cards_remaining_label
+    return if cards_remaining.nil?
+
+    "#{cards_remaining} #{"card".pluralize(cards_remaining)} left"
+  end
+
+  def checkout_session_for(plan, success_url:, cancel_url:)
+    configure_stripe!
+
+    Stripe::Checkout::Session.create(
+      mode: "subscription",
+      customer: stripe_customer_id!,
+      client_reference_id: id,
+      success_url: success_url,
+      cancel_url: cancel_url,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      metadata: { account_id: id, plan_key: plan.key },
+      subscription_data: { metadata: { account_id: id, plan_key: plan.key } }
+    )
+  end
+
+  def customer_portal_session(return_url:)
+    configure_stripe!
+
+    Stripe::BillingPortal::Session.create(
+      customer: stripe_customer_id!,
+      return_url: return_url
+    )
+  end
+
+  private
+    def stripe_customer_id!
+      if subscription&.stripe_customer_id.present?
+        subscription.stripe_customer_id
+      else
+        customer = Stripe::Customer.create(
+          email: owner_email,
+          name: name,
+          metadata: { account_id: id }
+        )
+        record = subscription || build_subscription
+        record.stripe_customer_id = customer.id
+        record.plan_key ||= "free"
+        record.save!
+        customer.id
+      end
+    end
+
+    def configure_stripe!
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"] if ENV["STRIPE_SECRET_KEY"].present?
+    end
+end
