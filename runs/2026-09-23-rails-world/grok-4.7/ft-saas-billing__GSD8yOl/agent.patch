diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..e826605
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,113 @@
+class Account::Plan
+  FREE_CARD_LIMIT = 1_000
+  UNLIMITED_STORAGE = 5.gigabytes
+  UNLIMITED_PLUS_STORAGE = 500.gigabytes
+
+  attr_reader :key, :name, :price, :card_limit, :storage_limit, :stripe_price_env
+
+  def initialize(key:, name:, price:, card_limit:, storage_limit:, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @price = price
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env = stripe_price_env
+  end
+
+  def self.free
+    new(
+      key: "free",
+      name: "Free",
+      price: 0,
+      card_limit: FREE_CARD_LIMIT,
+      storage_limit: Account::StorageLimited::DEFAULT_STORAGE_LIMIT
+    )
+  end
+
+  def self.unlimited
+    new(
+      key: "unlimited",
+      name: "Unlimited",
+      price: 20,
+      card_limit: nil,
+      storage_limit: UNLIMITED_STORAGE,
+      stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+    )
+  end
+
+  def self.unlimited_plus
+    new(
+      key: "unlimited_plus",
+      name: "Unlimited+",
+      price: 25,
+      card_limit: nil,
+      storage_limit: UNLIMITED_PLUS_STORAGE,
+      stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    )
+  end
+
+  # Support comps an account onto the roomiest paid allowance.
+  def self.complimentary
+    new(
+      key: "complimentary",
+      name: "Comped",
+      price: 0,
+      card_limit: nil,
+      storage_limit: UNLIMITED_PLUS_STORAGE
+    )
+  end
+
+  def self.all
+    [ free, unlimited, unlimited_plus ]
+  end
+
+  def self.paid
+    all.select(&:paid?)
+  end
+
+  def self.find(key)
+    normalized = normalize_key(key)
+    all.find { |plan| plan.key == normalized } || complimentary_if(normalized) || free
+  end
+
+  def self.find_by_price_id(price_id)
+    return if price_id.blank?
+
+    paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+  end
+
+  def self.normalize_key(key)
+    case key.to_s.strip.downcase
+    when "unlimited", "unlimitedv1", "monthly_v1"
+      "unlimited"
+    when "unlimited+", "unlimitedplus", "unlimited_plus", "unlimitedplusv1", "monthly_extra_storage_v1"
+      "unlimited_plus"
+    when "free", "freev1"
+      "free"
+    when "complimentary", "comped"
+      "complimentary"
+    else
+      key.to_s.presence
+    end
+  end
+
+  def self.complimentary_if(key)
+    complimentary if key == "complimentary"
+  end
+
+  def paid?
+    price.positive?
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env].presence if stripe_price_env
+  end
+
+  def price_label
+    if price.positive?
+      "$#{price}/month"
+    else
+      "Free"
+    end
+  end
+end
