diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..db3446d
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,192 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  ENTITLED_STATUSES = %w[ active trialing past_due ].freeze
+
+  def entitled?
+    ENTITLED_STATUSES.include?(status) && (cancel_at.nil? || cancel_at.future?)
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def self.sync_from_event(event)
+    case event.type
+    when "checkout.session.completed"
+      sync_from_checkout_session(event.data.object)
+    when /\Acustomer\.subscription\./
+      sync_from_stripe_subscription(event.data.object)
+    when "invoice.upcoming", "invoice.created", "invoice.finalized", "invoice.paid", "invoice.payment_succeeded"
+      sync_from_invoice(event.data.object)
+    end
+  end
+
+  def self.sync_from_checkout_session(session)
+    customer_id = string_id(session.customer)
+    subscription_id = string_id(session.subscription)
+    metadata = metadata_hash(session)
+    account = find_account(metadata, customer_id: customer_id, subscription_id: subscription_id, client_reference_id: session.client_reference_id)
+    return unless account && customer_id
+
+    plan_key = Account::Plan.normalize_key(metadata[:plan_key] || metadata[:plan])
+    status = session.status == "complete" ? "active" : session.status
+
+    upsert_for(account, {
+      stripe_customer_id: customer_id,
+      stripe_subscription_id: subscription_id,
+      plan_key: plan_key,
+      status: status
+    })
+  end
+
+  def self.sync_from_stripe_subscription(stripe_subscription)
+    customer_id = string_id(stripe_subscription.customer)
+    subscription_id = stripe_subscription.id
+    metadata = metadata_hash(stripe_subscription)
+    account = find_account(metadata, customer_id: customer_id, subscription_id: subscription_id)
+    return unless account && customer_id
+
+    upsert_for(account, {
+      stripe_customer_id: customer_id,
+      stripe_subscription_id: subscription_id,
+      plan_key: plan_key_from(stripe_subscription, metadata),
+      status: stripe_subscription.status,
+      current_period_end: period_end_from(stripe_subscription),
+      cancel_at: timestamp_from(stripe_subscription.cancel_at)
+    }, clear_cancel_at: true)
+  end
+
+  def self.sync_from_invoice(invoice)
+    customer_id = string_id(invoice.customer)
+    record = find_by(stripe_customer_id: customer_id)
+    return unless record
+
+    amount = invoice.respond_to?(:amount_due) ? invoice.amount_due : invoice["amount_due"]
+    record.update!(next_amount_due_in_cents: amount) unless amount.nil?
+  end
+
+  def self.upsert_for(account, attributes, clear_cancel_at: false)
+    record = locate(account, attributes.compact)
+
+    if record
+      record.assign_attributes(attributes.compact)
+      record.cancel_at = attributes[:cancel_at] if clear_cancel_at
+      record.account = account
+      record.save!
+      record
+    else
+      create!(attributes.compact.merge(account: account))
+    end
+  end
+
+  def self.locate(account, attributes)
+    if attributes[:stripe_subscription_id]
+      found = find_by(stripe_subscription_id: attributes[:stripe_subscription_id])
+      return found if found
+    end
+
+    if attributes[:stripe_customer_id]
+      found = find_by(stripe_customer_id: attributes[:stripe_customer_id])
+      return found if found
+    end
+
+    find_by(account_id: account.id)
+  end
+
+  def self.find_account(metadata, customer_id: nil, subscription_id: nil, client_reference_id: nil)
+    account_id = metadata[:account_id].presence || client_reference_id.presence
+    account = account_from_identifier(account_id)
+    return account if account
+
+    if customer_id && (record = find_by(stripe_customer_id: customer_id))
+      return record.account
+    end
+
+    if subscription_id && (record = find_by(stripe_subscription_id: subscription_id))
+      record.account
+    end
+  end
+
+  def self.account_from_identifier(identifier)
+    return if identifier.blank?
+
+    Account.find_by(id: identifier) || Account.find_by(external_account_id: identifier)
+  end
+
+  def self.plan_key_from(stripe_subscription, metadata)
+    from_price = Account::Plan.find_by_price_id(price_id_from(stripe_subscription))&.key
+    return from_price if from_price
+
+    from_metadata = Account::Plan.normalize_key(metadata[:plan_key] || metadata[:plan])
+    from_metadata if Account::Plan.all.any? { |plan| plan.key == from_metadata }
+  end
+
+  def self.price_id_from(stripe_subscription)
+    items = stripe_subscription.items
+    return if items.nil?
+
+    data = items.respond_to?(:data) ? items.data : items
+    item = Array(data).first
+    return if item.nil?
+
+    price = price_from(item)
+    if price.respond_to?(:id) && !price.is_a?(String)
+      price.id
+    elsif price.is_a?(String)
+      price
+    elsif price.respond_to?(:[])
+      price["id"] || price[:id]
+    end
+  end
+
+  def self.price_from(item)
+    if item.respond_to?(:price) && item.price
+      item.price
+    elsif item.respond_to?(:plan) && item.plan
+      item.plan
+    elsif item.respond_to?(:[])
+      item["price"] || item["plan"] || item[:price] || item[:plan]
+    end
+  end
+
+  def self.period_end_from(stripe_subscription)
+    if stripe_subscription.respond_to?(:current_period_end) && stripe_subscription.current_period_end
+      return timestamp_from(stripe_subscription.current_period_end)
+    end
+
+    items = stripe_subscription.items
+    return if items.nil?
+
+    data = items.respond_to?(:data) ? items.data : items
+    item = Array(data).first
+    return if item.nil?
+
+    value = item.respond_to?(:current_period_end) ? item.current_period_end : item["current_period_end"]
+    timestamp_from(value)
+  end
+
+  def self.timestamp_from(value)
+    return if value.blank?
+    return value if value.is_a?(Time) || value.is_a?(ActiveSupport::TimeWithZone)
+
+    Time.zone.at(value.to_i)
+  end
+
+  def self.string_id(value)
+    return if value.blank?
+    return value if value.is_a?(String)
+    return value.id if value.respond_to?(:id)
+
+    value.to_s
+  end
+
+  def self.metadata_hash(object)
+    metadata = object.respond_to?(:metadata) ? object.metadata : nil
+    if metadata.respond_to?(:to_hash)
+      metadata.to_hash.with_indifferent_access
+    else
+      {}.with_indifferent_access
+    end
+  end
+end
diff --git a/saas/app/views/account/billings/show.html.erb b/saas/app/views/account/billings/show.html.erb
