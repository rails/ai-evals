@@ -0,0 +1,32 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    limit = @account.overridden_limit || @account.build_overridden_limit
+    limit.update!(overridden_limit_params)
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  def destroy
+    @account.overridden_limit&.destroy
+    redirect_to saas.admin_account_path(@account)
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
+
+    def overridden_limit_params
+      raw = if params[:overridden_limit]
+        params.expect(overridden_limit: [ :card_count, :bytes_used ])
+      else
+        params.permit(:card_count, :bytes_used)
+      end
+
+      {
+        card_count: raw[:card_count].presence,
+        bytes_used: raw[:bytes_used].presence
+      }
+    end
+end
