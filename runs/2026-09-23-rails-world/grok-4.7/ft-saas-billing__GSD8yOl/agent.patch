--- /dev/null
+++ b/saas/test/controllers/account/billing_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Account::BillingControllerTest < ActionDispatch::IntegrationTest
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".settings-subscription", text: /Free/
+    assert_select "a", text: "Upgrade"
+  end
+
+  test "members do not see upgrade in settings" do
+    sign_in_as :jz
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "billing page lists paid plans" do
+    sign_in_as :mike
+
+    get account_billing_path(script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_match "$20/month", response.body
+    assert_match "$25/month", response.body
+    assert_match "Unlimited+", response.body
+  end
+
+  test "checkout redirects to the stripe-hosted session" do
+    sign_in_as :mike
+    Stripe::Customer.stubs(:create).returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.stubs(:create).returns(Stripe::Checkout::Session.construct_from(id: "cs_123", url: "https://checkout.stripe.com/c/pay/cs_test"))
+
+    post account_subscription_checkouts_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_response :see_other
+    assert_equal "https://checkout.stripe.com/c/pay/cs_test", response.headers["Location"]
+  end
+
+  test "customer portal redirects to stripe" do
+    sign_in_as :mike
+    accounts(:initech).create_subscription!(stripe_customer_id: "cus_portal", plan_key: "unlimited", status: "active")
+    Stripe::BillingPortal::Session.stubs(:create).returns(Stripe::BillingPortal::Session.construct_from(id: "bps_123", url: "https://billing.stripe.com/session/test"))
+
+    post account_customer_portal_path(script_name: accounts(:initech).slug)
+
+    assert_response :see_other
+    assert_equal "https://billing.stripe.com/session/test", response.headers["Location"]
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..9d07f56
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  test "staff can list accounts and open one by name" do
+    sign_in_as :david
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: accounts(:initech).name
+
+    untenanted do
+      get saas.admin_account_path(accounts(:initech))
+    end
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "button", text: "Uncomp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "button", text: "Override"
+    assert_select "button", text: "Reset"
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get saas.admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comp and uncomp toggle the waiver" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account)
+    end
+
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_comp_path(account)
+    end
+
+    assert_not account.reload.comped?
+  end
+
+  test "override and reset change the enforced usage" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account), params: {
+        overridden_limit: { card_count: 950, bytes_used: 2.gigabytes }
+      }
+    end
+
+    account.reload
+    assert_equal 950, account.cards_used
+    assert_equal 2.gigabytes, account.bytes_used
+    assert_equal "50 cards left", account.cards_remaining_label
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account)
+    end
+
+    account.reload
+    assert_nil account.overridden_limit
+    assert_not account.exceeding_card_limit?
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..b4d460e
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+  end
+
+  test "draft card shows an upgrade pitch instead of create buttons when the card limit is reached" do
+    sign_in_as :mike
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card counts down when 50 cards are left" do
+    sign_in_as :mike
+    @account.create_overridden_limit!(card_count: 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_match "50 cards left", response.body
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "publishing is refused at the card limit" do
+    sign_in_as :mike
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "creating through the api is refused at the card limit" do
+    sign_in_as :mike
+    @account.create_overridden_limit!(card_count: 1_000)
+    @account.update_column(:cards_count, 100)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Blocked" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a full account can still draft" do
+    sign_in_as :mike
+    @account.create_overridden_limit!(card_count: 1_000)
+    @account.update_column(:cards_count, 100)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "paid plans are not refused" do
+    sign_in_as :mike
+    @account.create_subscription!(stripe_customer_id: "cus_paid_cards", plan_key: "unlimited", status: "active")
+    @account.create_overridden_limit!(card_count: 5_000)
+    @account.update_column(:cards_count, 100)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Allowed" } }, as: :json
+    end
+
+    assert_response :created
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..8342b00
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret = "whsec_test"
+    @previous = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_WEBHOOK_SECRET"] = @secret
+    @account = accounts(:initech)
+  end
+
+  teardown do
+    ENV["STRIPE_WEBHOOK_SECRET"] = @previous
+  end
+
+  test "subscription update applies the paid plan" do
+    payload = {
+      id: "evt_1",
+      object: "event",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: "active",
+          cancel_at: nil,
+          metadata: { account_id: @account.id, plan_key: "unlimited" },
+          items: {
+            object: "list",
+            data: [
+              { id: "si_123", price: { id: "price_unlimited" }, current_period_end: 1.month.from_now.to_i }
+            ]
+          }
+        }
+      }
+    }.to_json
+
+    post_webhook payload
+
+    assert_response :success
+    subscription = @account.reload.subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_nil @account.card_limit
+  end
+
+  test "subscription update maps the extra storage price" do
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+
+    payload = {
+      id: "evt_2",
+      object: "event",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_plus",
+          object: "subscription",
+          customer: "cus_plus",
+          status: "active",
+          metadata: { account_id: @account.id },
+          items: {
+            object: "list",
+            data: [ { id: "si_plus", price: { id: "price_plus" }, current_period_end: 1.month.from_now.to_i } ]
+          }
+        }
+      }
+    }.to_json
+
+    post_webhook payload
+
+    assert_response :success
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  ensure
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "invoice stores the next amount due" do
+    @account.create_subscription!(stripe_customer_id: "cus_invoice", plan_key: "unlimited", status: "active")
+
+    payload = {
+      id: "evt_3",
+      object: "event",
+      type: "invoice.upcoming",
+      data: {
+        object: {
+          id: "in_123",
+          object: "invoice",
+          customer: "cus_invoice",
+          amount_due: 2000
+        }
+      }
+    }.to_json
+
+    post_webhook payload
+
+    assert_response :success
+    assert_equal 2000, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "rejects a bad signature" do
+    post "/stripe/webhooks", params: "{}", headers: {
+      "CONTENT_TYPE" => "application/json",
+      "HTTP_STRIPE_SIGNATURE" => "t=1,v1=bad"
+    }
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_webhook(payload)
+      header = stripe_signature(payload)
+      post "/stripe/webhooks", params: payload, headers: {
+        "CONTENT_TYPE" => "application/json",
+        "HTTP_STRIPE_SIGNATURE" => header
+      }
+    end
+
+    def stripe_signature(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @secret)
+      Stripe::Webhook::Signature.generate_header(timestamp, signature)
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..6bb1c4c
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan allows 1000 cards and 1 GB" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit within 100 cards" do
+    @account.create_overridden_limit!(card_count: 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal "50 cards left", @account.cards_remaining_label
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "exactly 100 cards remaining is nearing the limit" do
+    @account.create_overridden_limit!(card_count: 900)
+
+    assert @account.nearing_card_limit?
+    assert_equal "100 cards left", @account.cards_remaining_label
+  end
+
+  test "more than 100 cards remaining is not nearing the limit" do
+    @account.create_overridden_limit!(card_count: 899)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "card limit is reached at 1000 published cards" do
+    @account.create_overridden_limit!(card_count: 1_000)
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "unlimited plan removes the card limit and raises storage to 5 GB" do
+    @account.create_subscription!(stripe_customer_id: "cus_unlimited", plan_key: "unlimited", status: "active")
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited plus plan allows 500 GB" do
+    @account.create_subscription!(stripe_customer_id: "cus_plus", plan_key: "unlimited_plus", status: "active")
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription falls back to free" do
+    @account.create_subscription!(stripe_customer_id: "cus_canceled", plan_key: "unlimited", status: "canceled")
+
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "storage exception still overrides the plan allowance" do
+    @account.create_subscription!(stripe_customer_id: "cus_exception", plan_key: "unlimited", status: "active")
+    @account.add_storage_exception(10.gigabytes)
+
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "bytes used override replaces measured usage" do
+    @account.create_overridden_limit!(bytes_used: 2.gigabytes)
+
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "comped accounts get unlimited cards and the largest storage allowance" do
+    @account.comped = true
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+    assert_equal "Comped", @account.billing_plan.name
+  end
+
+  test "reset drops the override" do
+    @account.create_overridden_limit!(card_count: 1_000, bytes_used: 10)
+    @account.overridden_limit.destroy!
+    @account.association(:overridden_limit).reset
+
+    assert_not @account.exceeding_card_limit?
+    assert_equal 0, @account.bytes_used
+  end
+end
