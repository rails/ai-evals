@@ -0,0 +1,48 @@
+<% @page_title = "Billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section settings-subscription">
+      <h2 class="txt-large divider">Plan</h2>
+      <p>
+        You’re on <strong><%= @account.billing_plan.name %></strong>
+        <% if @account.billing_plan.paid? %>
+          (<%= @account.billing_plan.price_label %>)
+        <% end %>.
+      </p>
+
+      <% if @account.card_limit %>
+        <p class="txt-small">
+          <%= number_with_delimiter(@account.cards_used) %> of <%= number_with_delimiter(@account.card_limit) %> cards
+          · <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+        </p>
+      <% else %>
+        <p class="txt-small">
+          Unlimited cards
+          · <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+        </p>
+      <% end %>
+    </section>
+
+    <% @plans.each do |plan| %>
+      <section class="settings__section">
+        <h2 class="txt-medium divider"><%= plan.name %> — <%= plan.price_label %></h2>
+        <p class="txt-small">
+          Unlimited cards, <%= number_to_human_size(plan.storage_limit) %> storage.
+        </p>
+        <%= button_to "Upgrade", account_subscription_checkouts_path, params: { plan: plan.key }, class: "btn btn--link settings-subscription__button", form: { data: { turbo: false } } %>
+      </section>
+    <% end %>
+
+    <% if @account.subscription&.stripe_customer_id.present? %>
+      <section class="settings__section">
+        <%= button_to "Manage billing", account_customer_portal_path, class: "btn", form: { data: { turbo: false } } %>
+        <p class="txt-small">Stripe hosts the customer portal.</p>
+      </section>
+    <% end %>
+  </div>
+</div>
