+
+    def exactly_one_reactable
+      if comment_id.present? && card_id.present?
+        errors.add(:base, "cannot belong to both a comment and a card")
+      elsif comment_id.blank? && card_id.blank?
+        errors.add(:base, "must belong to a comment or a card")
+      end
+    end
+
+    def card_is_reactable
+      errors.add(:card, "does not allow reactions") unless card.published?
     end
 end
