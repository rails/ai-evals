diff --git a/script/reproduce_time_rendering.rb b/script/reproduce_time_rendering.rb
new file mode 100755
index 0000000..ad299a0
--- /dev/null
+++ b/script/reproduce_time_rendering.rb
@@ -0,0 +1,38 @@
+#!/usr/bin/env ruby
+# Reproduce timezone-baked time rendering.
+#
+# Before the fix, formatting a timestamp on the server produces different words
+# in different zones, so those words cannot be fragment-cached and shared.
+# After the fix, the HTML contains only the raw UTC timestamp and is identical
+# regardless of Time.zone.
+
+require_relative "../config/environment"
+
+time = Time.utc(2026, 3, 20, 18, 42, 0)
+zones = [ "UTC", "America/Los_Angeles", "Asia/Tokyo" ]
+
+puts "Same instant formatted on the server:"
+zones.each do |zone|
+  Time.use_zone(zone) do
+    local = time.in_time_zone
+    puts format("  %-22s %s  |  %s", zone, local.strftime("%l:%M %p").strip, local.strftime("%b %-d"))
+  end
+end
+
+include TimeHelper
+include ActionView::Helpers::TagHelper
+
+htmls = zones.map do |zone|
+  Time.use_zone(zone) { local_time(time) }
+end
+
+puts "\nHelper HTML by zone:"
+htmls.each_with_index { |html, i| puts "  #{zones[i]}: #{html}" }
+
+if htmls.uniq.size == 1 && htmls.first.include?(time.utc.iso8601) && htmls.first.exclude?("PM") && htmls.first.exclude?("AM")
+  puts "\nOK: markup is timezone-independent and carries the raw timestamp."
+  exit 0
+else
+  puts "\nFAIL: time markup still depends on the server timezone or bakes in a clock."
+  exit 1
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8654048
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time markup is the raw timestamp and does not depend on the zone" do
+    time = Time.utc(2026, 3, 20, 18, 42, 0)
+
+    html = Time.use_zone("America/New_York") { local_time(time) }
+    other = Time.use_zone("Asia/Tokyo") { local_time(time) }
+
+    assert_equal html, other
+    assert_includes html, %(datetime="#{time.utc.iso8601}")
+    assert_includes html, %(data-controller="local-time")
+    assert_includes html, %(data-local-time-format-value="relative")
+    assert_not_includes html, "PM"
+    assert_not_includes html, "AM"
+    assert_not_includes html, "ago"
+  end
+
+  test "local date sends a calendar date without a time of day" do
+    html = local_date(Date.new(2026, 3, 20), format: :weekday_date)
+
+    assert_includes html, %(datetime="2026-03-20")
+    assert_includes html, %(data-local-time-format-value="weekday-date")
+    assert_not_includes html, "March"
+  end
+
+  test "blank times render nothing" do
+    assert_nil local_time(nil)
+    assert_nil local_date(nil)
+  end
+end
