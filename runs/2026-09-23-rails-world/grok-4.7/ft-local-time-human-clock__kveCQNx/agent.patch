diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..c064dd7 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,29 @@
 module TimeHelper
+  # Raw timestamp for the browser to phrase in the viewer's timezone.
+  # The markup is identical in every zone, so it can be fragment-cached and shared.
+  def local_time(time, format: :relative, **attributes)
+    return if time.blank?
+
+    local_time_tag time.utc.iso8601, format: format, **attributes
+  end
+
+  # A calendar date already resolved by the server (day headers), not an instant.
+  # Sent as a date-only value so the browser does not shift it across a timezone.
+  def local_date(date, format: :date, **attributes)
+    return if date.blank?
+
+    local_time_tag date.to_date.iso8601, format: format, **attributes
+  end
+
+  private
+    def local_time_tag(datetime, format:, **attributes)
+      data = (attributes.delete(:data) || {}).merge(
+        controller: "local-time",
+        action: "turbo:morph-element->local-time#update:self",
+        local_time_format_value: format.to_s.tr("_", "-")
+      )
+      css = [ "local-time-value", attributes.delete(:class) ].compact.join(" ")
+
+      tag.time datetime, datetime: datetime, class: css, data: data, **attributes
+    end
 end
