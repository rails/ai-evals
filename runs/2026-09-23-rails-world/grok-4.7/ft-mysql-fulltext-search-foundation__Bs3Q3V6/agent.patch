@@ -0,0 +1,74 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "search page finds cards and wraps matched words in mark" do
+    card = boards(:writebook).cards.create!(title: "Fix the lantern", creator: users(:kevin), status: :published)
+    card.update!(description: "The lantern glass is cracked")
+    card.comments.create!(body: "Order a new lantern globe", creator: users(:kevin))
+
+    get search_path(q: "lantern")
+
+    assert_response :success
+    assert_select "input[name=q][value=?]", "lantern"
+    assert_select "mark", text: "lantern"
+    assert_select ".search-result__title mark", text: "lantern"
+    assert_select ".search-result__excerpt mark", text: "lantern"
+    assert_select "##{dom_id(card, :search_result)}"
+  end
+
+  test "wraps each matched word" do
+    get search_path(q: "logo enough")
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "logo"
+    assert_select ".search-result__title mark", text: "enough"
+  end
+
+  test "orders results newest first" do
+    older = boards(:writebook).cards.create!(title: "Older marigold", creator: users(:kevin), status: :published, created_at: 2.days.ago, last_active_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Newer marigold", creator: users(:kevin), status: :published, created_at: 1.hour.ago, last_active_at: 1.hour.ago)
+
+    get search_path(q: "marigold")
+
+    assert_response :success
+    numbers = css_select(".search-result").map { |element| element["data-card-number"].to_i }
+    assert_equal [ newer.number, older.number ], numbers
+  end
+
+  test "does not reveal drafts or inaccessible boards" do
+    boards(:writebook).cards.create!(title: "Secret kumquat draft", creator: users(:kevin), status: :drafted)
+    boards(:private).cards.create!(title: "Private kumquat", creator: users(:kevin), status: :published)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "kumquat")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+    assert_select "mark", count: 0
+  end
+
+  test "empty search shows the form without results" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select ".search-result", count: 0
+  end
+
+  test "escapes card text before wrapping marks" do
+    boards(:writebook).cards.create!(title: "<script>alert('sarsaparilla')</script>", creator: users(:kevin), status: :published)
+
+    get search_path(q: "sarsaparilla")
+
+    assert_response :success
+    assert_select "mark", text: "sarsaparilla"
+    title_html = css_select(".search-result__title").first.inner_html
+    assert_includes title_html, "&lt;script&gt;"
+    assert_not_includes title_html, "<script>"
+  end
+end
diff --git a/test/models/card/search_test.rb b/test/models/card/search_test.rb
new file mode 100644
index 0000000..f0ce74f
--- /dev/null
+++ b/test/models/card/search_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @kevin = users(:kevin)
+    @david = users(:david)
+  end
+
+  test "finds published cards by title, description, or comment body" do
+    title_card = publish_card("Title has zephyrstone", created_at: 3.days.ago)
+    description_card = publish_card("Plain title", created_at: 2.days.ago)
+    description_card.update!(description: "Hidden zephyrstone in the description")
+    comment_card = publish_card("Another plain title", created_at: 1.day.ago)
+    comment_card.comments.create!(body: "A comment mentions zephyrstone", creator: @kevin)
+
+    results = Card::Search.new("zephyrstone").cards_for(@kevin)
+
+    assert_equal [ comment_card, description_card, title_card ], results.to_a
+  end
+
+  test "matches every word and ignores cards the user cannot access" do
+    visible = publish_card("Visible quokka waffle")
+    hidden = boards(:private).cards.create!(title: "Hidden quokka waffle", creator: @kevin, status: :published)
+    partial = publish_card("Only a quokka here")
+
+    assert_equal [ visible ], Card::Search.new("quokka waffle").cards_for(@david).to_a
+    assert_includes Card::Search.new("quokka waffle").cards_for(@kevin), hidden
+    assert_not_includes Card::Search.new("quokka waffle").cards_for(@kevin), partial
+  end
+
+  test "draft cards and comments on drafts never turn up" do
+    draft = boards(:writebook).cards.create!(title: "Draft mangosteen idea", creator: @kevin, status: :drafted)
+    comment = Comment.new(card: draft, creator: @kevin, account: draft.account)
+    comment.save!(validate: false)
+    ActionText::RichText.create!(record: comment, name: "body", body: "draft mangosteen note", account: draft.account)
+
+    assert_empty Card::Search.new("mangosteen").cards_for(@kevin)
+  end
+
+  test "treats like wildcards as literals and is case insensitive" do
+    card = publish_card("Ship 100% of the build")
+
+    assert_includes Card::Search.new("100%").cards_for(@kevin), card
+    assert_not_includes Card::Search.new("100_").cards_for(@kevin), card
+    assert_includes Card::Search.new("SHIP").cards_for(@kevin), card
+  end
+
+  test "blank queries match nothing" do
+    assert_empty Card::Search.new("   ").cards_for(@kevin)
+    assert_empty Card::Search.new(nil).cards_for(@kevin)
+  end
+
+  private
+    def publish_card(title, created_at: Time.current)
+      boards(:writebook).cards.create!(title: title, creator: @kevin, status: :published, created_at: created_at, last_active_at: created_at)
+    end
+end
