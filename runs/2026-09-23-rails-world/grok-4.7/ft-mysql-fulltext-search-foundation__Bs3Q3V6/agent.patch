@@ -0,0 +1,35 @@
+<% @page_title = @search.query.present? ? "Search: #{@search.query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="search panel panel--wide center margin-block-start">
+  <%= form_with url: search_path, method: :get, class: "search__form", data: { turbo_action: "replace" } do |form| %>
+    <%= form.search_field :q,
+          value: @search.query,
+          placeholder: "Search cards…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          spellcheck: false,
+          class: "input",
+          aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @page.records.any? %>
+    <%= with_automatic_pagination :search_results, @page, class: "search__results" do %>
+      <%= render partial: "searches/result", collection: @page.records, as: :card %>
+    <% end %>
+  <% elsif @search.query.present? %>
+    <p class="blank-slate">No cards match “<%= @search.query %>”</p>
+  <% else %>
+    <p class="blank-slate">Search titles, descriptions, and comments</p>
+  <% end %>
+</section>
