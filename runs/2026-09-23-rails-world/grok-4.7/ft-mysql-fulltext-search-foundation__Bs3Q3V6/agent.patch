diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..535921e
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,55 @@
+module SearchHelper
+  def highlight_matches(text, query)
+    words = search_words(query)
+    escaped = ERB::Util.html_escape(text.to_s)
+    return escaped if words.empty?
+
+    pattern = Regexp.new(words.map { |word| Regexp.escape(ERB::Util.html_escape(word)) }.sort_by { |word| -word.length }.join("|"), Regexp::IGNORECASE)
+    highlighted = escaped.to_str.gsub(pattern) { |match| "<mark>#{match}</mark>" }
+    highlighted.html_safe
+  end
+
+  def search_excerpt_for(card, search)
+    fragments = []
+
+    description = card.description.to_plain_text
+    if search.matches_any?(description)
+      fragments << tag.p(highlight_matches(search_snippet(description, search), search.query), class: "search-result__excerpt")
+    end
+
+    if comment = search.matching_comment_for(card)
+      text = comment.body.to_plain_text
+      if search.matches_any?(text)
+        fragments << tag.p(class: "search-result__excerpt") do
+          safe_join([
+            tag.span("Comment", class: "search-result__source"),
+            highlight_matches(search_snippet(text, search), search.query)
+          ], " ")
+        end
+      end
+    end
+
+    safe_join(fragments) if fragments.any?
+  end
+
+  def search_snippet(text, search, radius: 90)
+    plain = text.to_s.squish
+    return plain if plain.length <= radius * 2
+
+    pattern = Regexp.new(search.words.map { |word| Regexp.escape(word) }.join("|"), Regexp::IGNORECASE)
+    index = plain.match(pattern)&.begin(0)
+    return plain.truncate(radius * 2) unless index
+
+    start = [ index - radius, 0 ].max
+    finish = [ index + radius, plain.length ].min
+    snippet = plain[start...finish]
+    prefix = start.positive? ? "…" : ""
+    suffix = finish < plain.length ? "…" : ""
+    "#{prefix}#{snippet}#{suffix}"
+  end
+
+  private
+    def search_words(query)
+      query.to_s.strip.split(/\s+/).reject(&:blank?).uniq
+    end
+end
diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..e41325b
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,96 @@
+class Card::Search
+  LIKE_ESCAPE = "\\"
+
+  attr_reader :query
+
+  def initialize(query)
+    @query = query.to_s.delete("\u0000").strip
+  end
+
+  def cards_for(user)
+    if words.any?
+      user.accessible_cards.published.where(id: matching_ids_for(user)).reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def words
+    @words ||= query.split(/\s+/).reject(&:blank?).uniq
+  end
+
+  def matches?(text)
+    haystack = text.to_s
+    words.any? && words.all? { |word| haystack.match?(/#{Regexp.escape(word)}/i) }
+  end
+
+  def matches_any?(text)
+    haystack = text.to_s
+    words.any? && words.any? { |word| haystack.match?(/#{Regexp.escape(word)}/i) }
+  end
+
+  def preload_matches(cards)
+    @comments_by_card_id = {}
+    return if cards.blank? || words.empty?
+
+    @comments_by_card_id = comments_matching(cards.map(&:id)).group_by(&:card_id)
+  end
+
+  def matching_comment_for(card)
+    if defined?(@comments_by_card_id)
+      @comments_by_card_id[card.id]&.first
+    else
+      comments_matching([ card.id ]).first
+    end
+  end
+
+  private
+    def matching_ids_for(user)
+      words.reduce(nil) do |scope, word|
+        word_ids = ids_matching_word(user, word)
+        scope ? scope.where(id: word_ids) : word_ids
+      end
+    end
+
+    def ids_matching_word(user, word)
+      pattern = like_pattern(word)
+      account_id = user.account_id
+
+      title_ids = Card.published.where(account_id: account_id).where(like_sql("cards.title"), pattern, LIKE_ESCAPE).select(:id)
+      description_ids = Card.published.where(account_id: account_id, id: description_record_ids(account_id, pattern)).select(:id)
+      comment_ids = Card.published.where(account_id: account_id, id: comment_card_ids(account_id, pattern)).select(:id)
+
+      Card.where(id: title_ids).or(Card.where(id: description_ids)).or(Card.where(id: comment_ids)).select(:id)
+    end
+
+    def description_record_ids(account_id, pattern)
+      ActionText::RichText
+        .where(account_id: account_id, record_type: "Card", name: "description")
+        .where(like_sql("action_text_rich_texts.body"), pattern, LIKE_ESCAPE)
+        .select(:record_id)
+    end
+
+    def comment_card_ids(account_id, pattern)
+      Comment
+        .where(account_id: account_id)
+        .joins(:rich_text_body)
+        .where(like_sql("action_text_rich_texts.body"), pattern, LIKE_ESCAPE)
+        .select(:card_id)
+    end
+
+    def comments_matching(card_ids)
+      words
+        .map { |word| Comment.where(card_id: card_ids).joins(:rich_text_body).where(like_sql("action_text_rich_texts.body"), like_pattern(word), LIKE_ESCAPE) }
+        .reduce(:or)
+        .preload(:rich_text_body)
+        .order(created_at: :desc, id: :desc)
+    end
+
+    def like_pattern(word)
+      "%#{ActiveRecord::Base.sanitize_sql_like(word, LIKE_ESCAPE)}%"
+    end
+
+    def like_sql(column)
+      "#{column} LIKE ? ESCAPE ?"
+    end
+end
