diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..d3780b0
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,73 @@
+class Card::Search
+  def self.terms_for(query)
+    query.to_s.squish.split(" ").filter_map { |term| normalize_term(term) }.uniq
+  end
+
+  def self.normalize_term(term)
+    term.gsub(/\A[^\p{Alnum}%_]+|[^\p{Alnum}%_]+\z/, "").presence
+  end
+
+  def initialize(query)
+    @query = query
+  end
+
+  def terms
+    @terms ||= self.class.terms_for(@query)
+  end
+
+  def filter(cards)
+    if terms.empty?
+      cards.none
+    else
+      cards.published.where(id: matching_ids).reorder(created_at: :desc, id: :desc)
+    end
+  end
+
+  def contains_all_terms?(text)
+    folded = text.to_s.downcase
+    terms.any? && terms.all? { |term| folded.include?(term.downcase) }
+  end
+
+  def excerpt(text, length: 280)
+    plain = text.to_s.gsub(/\s+/, " ").strip
+    return plain if plain.length <= length
+
+    folded = plain.downcase
+    index = terms.filter_map { |term| folded.index(term.downcase) }.min
+    return plain.truncate(length) if index.nil?
+
+    start = [ index - (length / 2), 0 ].max
+    finish = [ start + length, plain.length ].min
+    start = [ finish - length, 0 ].max
+    snippet = plain[start...finish].strip
+    snippet = "…#{snippet}" if start > 0
+    snippet = "#{snippet}…" if finish < plain.length
+    snippet
+  end
+
+  private
+    def matching_ids
+      Card.where(id: title_matches.select(:id))
+        .or(Card.where(id: description_matches.select(:id)))
+        .or(Card.where(id: comment_matches.select(:id)))
+        .select(:id)
+    end
+
+    def title_matches
+      terms.reduce(Card.all) do |relation, term|
+        relation.where("INSTR(LOWER(cards.title), LOWER(?)) > 0", term)
+      end
+    end
+
+    def description_matches
+      terms.reduce(Card.joins(:rich_text_description)) do |relation, term|
+        relation.where("INSTR(LOWER(action_text_rich_texts.body), LOWER(?)) > 0", term)
+      end
+    end
+
+    def comment_matches
+      terms.reduce(Card.joins(comments: :rich_text_body)) do |relation, term|
+        relation.where("INSTR(LOWER(action_text_rich_texts.body), LOWER(?)) > 0", term)
+      end
+    end
+end
