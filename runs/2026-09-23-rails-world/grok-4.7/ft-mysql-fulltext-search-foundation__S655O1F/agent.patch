diff --git a/app/views/searches/_result.html.erb b/app/views/searches/_result.html.erb
new file mode 100644
index 0000000..87dbb5a
--- /dev/null
+++ b/app/views/searches/_result.html.erb
@@ -0,0 +1,25 @@
+<% search = Card::Search.new(query) %>
+<% description = card.description.to_plain_text %>
+<% matching_comments = card.comments.select { |comment| search.contains_all_terms?(comment.body.to_plain_text) } %>
+
+<li class="search-result" id="<%= dom_id(card, :search) %>">
+  <h2 class="search-result__title">
+    <%= link_to highlight_matches(card.title, query), card %>
+  </h2>
+
+  <p class="search-result__board txt-small txt-subtle">
+    <%= card.board.name %>
+  </p>
+
+  <% if search.contains_all_terms?(description) %>
+    <p class="search-result__description">
+      <%= search_snippet(description, query) %>
+    </p>
+  <% end %>
+
+  <% matching_comments.first(5).each do |comment| %>
+    <blockquote class="search-result__comment">
+      <%= link_to search_snippet(comment.body.to_plain_text, query), card_path(card, anchor: dom_id(comment)) %>
+    </blockquote>
+  <% end %>
+</li>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2d1001a
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap center margin-block" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search titles, descriptions, and comments", class: "input", autofocus: true, autocomplete: "off", autocorrect: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <ol class="search-results list-style-none txt-align-start">
+        <% @page.records.each do |card| %>
+          <%= render "searches/result", card: card, query: @query %>
+        <% end %>
+      </ol>
+
+      <%= link_to_next_page :search, @page %>
+    <% else %>
+      <p class="blank-slate">No cards match "<%= @query %>"</p>
+    <% end %>
+  <% else %>
+    <p class="blank-slate">Search cards you can access</p>
+  <% end %>
+</div>
