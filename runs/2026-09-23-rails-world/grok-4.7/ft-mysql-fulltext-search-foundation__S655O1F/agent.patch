diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..71555d6
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "show renders a search form" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action=?]", search_path
+    assert_select "input[name=q]"
+  end
+
+  test "finds cards by title, description, or comment body and highlights matches" do
+    titled = boards(:writebook).cards.create!(title: "Zebra title match", creator: users(:kevin), status: :published, created_at: 3.days.ago)
+    described = boards(:writebook).cards.create!(title: "Plain card", creator: users(:kevin), status: :published, created_at: 2.days.ago, description: "Hidden zebra description")
+    commented = boards(:writebook).cards.create!(title: "Another plain card", creator: users(:kevin), status: :published, created_at: 1.day.ago)
+    commented.comments.create!(creator: users(:kevin), body: "A zebra lives in this comment")
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    assert_select "##{dom_id(titled, :search)}"
+    assert_select "##{dom_id(described, :search)}"
+    assert_select "##{dom_id(commented, :search)}"
+    assert_select "mark", text: /zebra/i
+  end
+
+  test "orders results newest first" do
+    older = boards(:writebook).cards.create!(title: "Older xylophone", creator: users(:kevin), status: :published, created_at: 5.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Newer xylophone", creator: users(:kevin), status: :published, created_at: 1.hour.ago)
+
+    get search_path(q: "xylophone")
+
+    assert_response :success
+    assert_operator response.body.index(dom_id(newer, :search)), :<, response.body.index(dom_id(older, :search))
+  end
+
+  test "does not return draft cards or comments on drafts" do
+    draft = boards(:writebook).cards.create!(title: "Secret draft quokka", creator: users(:kevin), status: :drafted)
+    comment = draft.comments.new(creator: users(:kevin), account: draft.account)
+    comment.body = "draft-only quokka note"
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    get search_path(q: "quokka")
+
+    assert_response :success
+    assert_select "##{dom_id(draft, :search)}", count: 0
+    assert_no_match "draft-only quokka note", response.body
+  end
+
+  test "only returns cards from boards the user can access" do
+    private_card = boards(:private).cards.create!(title: "Kevin private wallaby", creator: users(:kevin), status: :published)
+
+    get search_path(q: "wallaby")
+    assert_select "##{dom_id(private_card, :search)}"
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "wallaby")
+    assert_response :success
+    assert_select "##{dom_id(private_card, :search)}", count: 0
+  end
+
+  test "does not return cards from other accounts" do
+    get search_path(q: "radio")
+
+    assert_response :success
+    assert_no_match "reasonable volume", response.body
+  end
+
+  test "matches every word in the same field, case-insensitively" do
+    card = boards(:writebook).cards.create!(title: "Unrelated", creator: users(:kevin), status: :published, description: "The TEXT is overflowing the container")
+    partial = boards(:writebook).cards.create!(title: "Only overflowing here", creator: users(:kevin), status: :published)
+
+    get search_path(q: "text OVERFLOWING")
+
+    assert_select "##{dom_id(card, :search)}"
+    assert_select "##{dom_id(partial, :search)}", count: 0
+    assert_select "mark", text: "TEXT"
+    assert_select "mark", text: "overflowing"
+  end
+
+  test "escapes html in titles while highlighting the match" do
+    card = boards(:writebook).cards.create!(title: "Fix <script>alert(\"xss\")</script> zebra", creator: users(:kevin), status: :published)
+
+    get search_path(q: "zebra")
+
+    assert_response :success
+    assert_select "mark", text: "zebra"
+    assert_no_match "<script>alert", response.body
+    assert_match "&lt;script&gt;", response.body
+  end
+
+  test "hides a card after board access is revoked" do
+    card = boards(:writebook).cards.create!(title: "Shared wombat", creator: users(:kevin), status: :published)
+    boards(:writebook).update!(all_access: false)
+    boards(:writebook).accesses.revoke_from(users(:david))
+
+    logout_and_sign_in_as :david
+    get search_path(q: "wombat")
+
+    assert_response :success
+    assert_select "##{dom_id(card, :search)}", count: 0
+  end
+end
diff --git a/test/models/card/search_test.rb b/test/models/card/search_test.rb
new file mode 100644
index 0000000..fad08a7
--- /dev/null
+++ b/test/models/card/search_test.rb
@@ -0,0 +1,24 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+  end
+
+  test "terms ignore surrounding punctuation and extra space" do
+    assert_equal [ "logo", "enough" ], Card::Search.terms_for("  logo,   enough! ")
+  end
+
+  test "blank query matches nothing" do
+    assert_empty Current.user.accessible_cards.search("   ")
+  end
+
+  test "percent signs are treated literally" do
+    card = boards(:writebook).cards.create!(title: "100% done", creator: users(:kevin), status: :published)
+    boards(:writebook).cards.create!(title: "1000 done", creator: users(:kevin), status: :published)
+
+    results = Current.user.accessible_cards.search("100%")
+
+    assert_equal [ card ], results.to_a
+  end
+end
