--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,14 @@
+module SearchesHelper
+  def highlight_matches(text, query)
+    terms = Card::Search.terms_for(query)
+    escaped = ERB::Util.html_escape(text.to_s)
+    return escaped if terms.empty?
+
+    pattern = Regexp.new(terms.sort_by { |term| -term.length }.map { |term| Regexp.escape(ERB::Util.html_escape(term)) }.join("|"), Regexp::IGNORECASE)
+    escaped.to_str.gsub(pattern) { |match| "<mark>#{match}</mark>" }.html_safe
+  end
+
+  def search_snippet(text, query)
+    highlight_matches(Card::Search.new(query).excerpt(text), query)
+  end
+end
