@@ -0,0 +1,26 @@
+# Secrets for config/deploy.yml. This file is committed. Do not put raw
+# passwords here — pull them from the environment, a file, or a password manager.
+#
+# Generate a stable SECRET_KEY_BASE once and keep it across deploys
+# (changing it signs everyone out):
+#
+#   bin/rails secret
+#
+# Then export it before `bin/kamal setup`, or replace the right-hand side
+# with a command that prints it, for example:
+#
+#   SECRET_KEY_BASE=$(cat ~/.config/fizzy/secret_key_base)
+
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# Fill these in if your mail server requires authentication. Leave them empty
+# for an open relay on a private network.
+SMTP_USERNAME=$SMTP_USERNAME
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Optional. Web push notifications. See docs/development.md.
+# VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+# VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Only needed if you switch config/deploy.yml off the local registry.
+# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
