@@ -0,0 +1,33 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_activities
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def filtered_activities
+      events = accessible_activities
+      events = events.where(creator_id: creator_ids) if creator_ids.any?
+      events = events.where(board_id: board_ids) if board_ids.any?
+      events
+    end
+
+    def accessible_activities
+      Event.preloaded.where(board: Current.user.boards, action: Event::ACTIVITY_ACTIONS).reverse_chronologically
+    end
+
+    def creator_ids
+      id_list(:creator_ids)
+    end
+
+    def board_ids
+      id_list(:board_ids)
+    end
+
+    def id_list(key)
+      Array(params[key]).flatten.compact_blank
+    end
+end
