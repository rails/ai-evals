@@ -0,0 +1,49 @@
+# Activity
+
+Account activity is the same stream of events shown on the HTML timeline: card updates, assignments, triage, and comments. Deprecated `card_collection_changed` events are omitted. `card_title_changed` events are included.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user who caused the event |
+| `board_ids[]` | Filter by board. Boards you cannot access are ignored |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zkft4hj9qq0lsn9ohde",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David assigned JZ to \"The logo isn't big enough\"",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/1",
+    "eventable_type": "Card",
+    "eventable": {},
+    "board": {},
+    "creator": {}
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the cards, boards, and users endpoints. `description` is plain text. `url` opens the card. For comments, `url` opens that card and jumps to the comment.
+
+`particulars` depends on the event:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| anything else | `{}` |
+
+Missing board, title, or column values are empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..f862337
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns accessible activity newest first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    body = @response.parsed_body
+    assert_kind_of Array, body
+    assert_equal Event.where(board: users(:kevin).boards, action: Event::ACTIVITY_ACTIONS).count, body.size
+
+    created_ats = body.map { |event| Time.zone.parse(event["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+
+    newest = body.first
+    assert_equal events(:layout_assignment_jz).id, newest["id"]
+    assert_equal "card_assigned", newest["action"]
+    assert_equal events(:layout_assignment_jz).description_for(users(:kevin)).to_plain_text, newest["description"]
+    assert_equal [ users(:jz).id ], newest["particulars"]["assignee_ids"]
+    assert_equal card_url(cards(:layout)), newest["url"]
+    assert_equal "Card", newest["eventable_type"]
+    assert_equal cards(:layout).id, newest["eventable"]["id"]
+    assert_equal boards(:writebook).id, newest["board"]["id"]
+    assert_equal users(:david).id, newest["creator"]["id"]
+    assert_not newest.key?("eventable_id")
+  end
+
+  test "comment activity links to the card and jumps to the comment" do
+    get activities_path, as: :json
+
+    comment_event = @response.parsed_body.find { |event| event["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "comment_created", comment_event["action"]
+    assert_equal "Comment", comment_event["eventable_type"]
+    assert_equal comment.id, comment_event["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), comment_event["url"]
+    assert_equal({}, comment_event["particulars"])
+  end
+
+  test "omits deprecated collection changes and inaccessible boards" do
+    collection_event = events(:logo_published).dup
+    collection_event.assign_attributes(id: ActiveRecord::Type::Uuid.generate, action: "card_collection_changed", created_at: Time.current)
+    collection_event.save!
+
+    private_event = nil
+    with_current_user(:kevin) do
+      card = boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published")
+      private_event = card.events.find_by!(action: "card_published")
+    end
+
+    get activities_path, as: :json
+    ids = @response.parsed_body.pluck("id")
+
+    assert_includes ids, private_event.id
+    assert_not_includes ids, collection_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    ids = @response.parsed_body.pluck("id")
+
+    assert_not_includes ids, private_event.id
+    assert_not_includes ids, collection_event.id
+  end
+
+  test "includes title changes and exposes event particulars" do
+    with_current_user(:kevin) do
+      cards(:logo).update!(title: "Bigger logo")
+      cards(:layout).update!(board: boards(:private))
+      cards(:text).triage_into(columns(:writebook_in_progress))
+    end
+
+    title_event = cards(:logo).events.find_by!(action: "card_title_changed")
+    board_event = cards(:layout).events.find_by!(action: "card_board_changed")
+    triage_event = cards(:text).events.find_by!(action: "card_triaged")
+
+    get activities_path, as: :json
+    body = @response.parsed_body.index_by { |event| event["id"] }
+
+    assert_equal({ "old_title" => "The logo isn't big enough", "new_title" => "Bigger logo" }, body.dig(title_event.id, "particulars"))
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, body.dig(board_event.id, "particulars"))
+    assert_equal({ "column" => "In progress" }, body.dig(triage_event.id, "particulars"))
+    assert_equal "card_published", body.dig(events(:shipping_published).id, "action")
+    assert_equal({}, body.dig(events(:shipping_published).id, "particulars"))
+  end
+
+  test "missing particular values are empty strings" do
+    event = events(:logo_published)
+    event.update!(action: "card_title_changed", particulars: {})
+
+    get activities_path, as: :json
+    particulars = @response.parsed_body.find { |row| row["id"] == event.id }["particulars"]
+
+    assert_equal({ "old_title" => "", "new_title" => "" }, particulars)
+  end
+
+  test "filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |event| event["creator"]["id"] }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    assert_empty @response.parsed_body
+
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "Secret", creator: users(:kevin), status: "published")
+    end
+
+    get activities_path, params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:kevin).id ] }, as: :json
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event["board"]["id"] == boards(:private).id && event["creator"]["id"] == users(:kevin).id }
+
+    get activities_path, params: { board_ids: [ boards(:private).id ] }, as: :json
+    logout_and_sign_in_as :david
+    get activities_path, params: { board_ids: [ boards(:private).id, boards(:writebook).id ] }, as: :json
+
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |event| event["board"]["id"] == boards(:writebook).id }
+  end
+
+  test "paginates newest first" do
+    now = Time.current
+    Event.insert_all 20.times.map { |index|
+      {
+        id: ActiveRecord::Type::Uuid.generate,
+        account_id: accounts("37s").id,
+        board_id: boards(:writebook).id,
+        creator_id: users(:david).id,
+        eventable_type: "Card",
+        eventable_id: cards(:logo).id,
+        action: "card_reopened",
+        particulars: "{}",
+        created_at: now + index.seconds,
+        updated_at: now + index.seconds
+      }
+    }
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+    assert_match(/rel="next"/, @response.headers["Link"])
+    assert_operator @response.headers["X-Total-Count"].to_i, :>, 15
+    page_one_oldest = @response.parsed_body.last["created_at"]
+
+    get activities_path(page: 2), as: :json
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_operator @response.parsed_body.first["created_at"], :<=, page_one_oldest
+    assert_operator @response.parsed_body.first["created_at"], :>=, @response.parsed_body.last["created_at"]
+  end
+end
+
+class ActivitiesBearerTokenTest < ActionDispatch::IntegrationTest
+  test "authenticates with a bearer token and hides other accounts" do
+    token = identity_access_tokens(:davids_api_token).token
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer #{token}" }
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |event| event["board"]["id"] }.uniq
+    assert_includes board_ids, boards(:writebook).id
+    assert_not_includes board_ids, boards(:miltons_wish_list).id
+
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+    assert_response :unauthorized
+  end
+end
