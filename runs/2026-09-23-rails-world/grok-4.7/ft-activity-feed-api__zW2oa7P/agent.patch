diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..ce7a85e 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular_value("old_board"), new_board: particular_value("new_board") }
+    when "card_title_changed"
+      { old_title: particular_value("old_title"), new_title: particular_value("new_title") }
+    when "card_triaged"
+      { column: particular_value("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      raw = (particulars || {}).with_indifferent_access
+      nested = raw[:particulars]
+      value = nested[key] if nested.respond_to?(:[])
+      value = raw[key] if value.nil?
+      value.to_s
+    end
 end
