diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..f88d4de
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,122 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :notifications, foreign_key: :bundle_id, dependent: :nullify, inverse_of: :bundle
+
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+  scope :ordered, -> { order(:starts_at) }
+
+  validate :does_not_overlap_another_window, on: :create
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    # Place a notification in the window it belongs to, opening one if needed.
+    #
+    # The clock starts when the first notification lands. A notification that
+    # arrives late — after a window has already opened — joins that window
+    # instead of starting a second, possibly overlapping, one.
+    def absorb(notification, at:)
+      duration = notification.user.settings&.bundle_email_duration
+      return if duration.nil?
+
+      at = parse_time(at)
+
+      notification.user.with_lock do
+        bundle = find_or_open_for(notification.user, at: at, duration: duration)
+        assign_notification(notification, to: bundle)
+        bundle
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver_now)
+    end
+
+    private
+      def find_or_open_for(user, at:, duration:)
+        if bundle = locate(user, at)
+          bundle
+        else
+          user.notification_bundles.create!(starts_at: at, ends_at: at + duration)
+        end
+      end
+
+      def locate(user, at)
+        bundles = user.notification_bundles.ordered.to_a
+
+        if containing = bundles.find { |bundle| bundle.cover?(at) }
+          containing
+        elsif opened = bundles.find { |bundle| bundle.starts_at > at }
+          # Late arrival: a window has already opened ahead of this timestamp.
+          opened
+        end
+      end
+
+      def assign_notification(notification, to:)
+        notification.reload
+        current = notification.bundle
+
+        # A newer window already holds the latest activity; don't pull it backward.
+        if current.nil? || to.starts_at >= current.starts_at
+          notification.update_column(:bundle_id, to.id) unless notification.bundle_id == to.id
+        end
+      rescue ActiveRecord::RecordNotFound
+        nil
+      end
+
+      def parse_time(at)
+        case at
+        when String then Time.zone.parse(at)
+        else at
+        end
+      end
+  end
+
+  def cover?(time)
+    starts_at <= time && time < ends_at
+  end
+
+  def deliver_now
+    return if ends_at.future?
+
+    with_lock do
+      reload
+      return if delivered? || ends_at.future?
+
+      if sendable?
+        Current.with_account(account) do
+          NotificationMailer.digest(self).deliver_later
+        end
+      end
+
+      update!(delivered_at: Time.current)
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  private
+    def schedule_delivery
+      Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def sendable?
+      notifications.any? && user.active? && account.active? && user.identity&.email_address.present?
+    end
+
+    def does_not_overlap_another_window
+      return if user_id.blank? || starts_at.blank? || ends_at.blank?
+
+      overlap = self.class.where(user_id: user_id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+      overlap = overlap.where.not(id: id) if id.present?
+
+      if overlap.exists?
+        errors.add(:base, "overlaps another email window")
+      end
+    end
+end
diff --git a/app/models/notification/bundleable.rb b/app/models/notification/bundleable.rb
new file mode 100644
index 0000000..4c5f145
--- /dev/null
+++ b/app/models/notification/bundleable.rb
@@ -0,0 +1,27 @@
+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+
+    after_save_commit :bundle_later, if: :bundle_later?
+  end
+
+  def bundle_later
+    Notification::BundlingJob.perform_later(self, updated_at.iso8601(6))
+  end
+
+  def bundle_now(at: updated_at)
+    Notification::Bundle.absorb(self, at: at)
+  end
+
+  private
+    def bundle_later?
+      source_id_previously_changed? && email_bundleable?
+    end
+
+    def email_bundleable?
+      creator.present? && !creator.system? && user.active? && account.active? &&
+        user.identity&.email_address.present? && user.settings&.bundles_email?
+    end
+end
