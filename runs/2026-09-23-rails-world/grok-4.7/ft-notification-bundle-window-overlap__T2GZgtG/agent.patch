diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..0f505f8
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,29 @@
+class NotificationMailer < ApplicationMailer
+  helper_method :bundle_notification_time
+
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account
+    @notifications = bundle.notifications.preloaded.order(:updated_at).to_a
+
+    mail to: @user.identity.email_address, subject: digest_subject
+  end
+
+  private
+    def digest_subject
+      summary = if @notifications.one?
+        @notifications.first.payload.title
+      else
+        "#{@notifications.size} new notifications"
+      end
+
+      "#{summary} · #{@account.name}"
+    end
+
+    def bundle_notification_time(notification)
+      @user.in_time_zone do
+        notification.updated_at.in_time_zone.strftime("%b %d, %Y at %I:%M %p %Z")
+      end
+    end
+end
