+class Notifications::BundleEmailFrequenciesController < ApplicationController
+  def update
+    frequency = params.expect(:bundle_email_frequency)
+
+    if User::Settings.bundle_email_frequencies.key?(frequency)
+      Current.user.settings.update!(bundle_email_frequency: frequency)
