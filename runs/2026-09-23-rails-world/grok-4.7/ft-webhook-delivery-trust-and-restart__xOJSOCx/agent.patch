diff --git a/test/models/webhook/dispatch_test.rb b/test/models/webhook/dispatch_test.rb
new file mode 100644
index 0000000..20a4aea
--- /dev/null
+++ b/test/models/webhook/dispatch_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @url = @webhook.url
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, @url).to_return(status: 200, body: "ok")
+  end
+
+  test "an event posts once to subscribed receivers and the log records the result" do
+    event = create_event("card_closed")
+
+    assert_enqueued_with(job: Event::RelayJob, args: [ event ])
+
+    deliver_webhooks
+
+    assert_requested :post, @url, times: 1
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response_summary[:code]
+    assert_equal "fizzy/1.0.0 Webhook", delivery.request["headers"]["User-Agent"]
+    assert_equal event.created_at.utc.iso8601, delivery.request["headers"]["X-Webhook-Timestamp"]
+    assert_equal Webhook::Delivery.sign(last_request_body, @webhook.signing_secret), delivery.request["headers"]["X-Webhook-Signature"]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+
+    body = JSON.parse(last_request_body)
+    assert_equal event.id, body["id"]
+    assert_equal "card_closed", body["action"]
+
+    delivery.deliver_later
+    deliver_webhooks
+    assert_requested :post, @url, times: 1
+  end
+
+  test "inactive and unsubscribed webhooks are not posted to" do
+    @webhook.deactivate
+    create_event("card_closed")
+    deliver_webhooks
+    assert_not_requested :post, @url
+
+    @webhook.activate
+    create_event("comment_created")
+    deliver_webhooks
+    assert_not_requested :post, @url
+  end
+
+  test "slack and campfire receivers get a chat payload" do
+    slack = Webhook.create!(
+      name: "Slack",
+      url: "https://hooks.slack.com/services/T123/B456/secret",
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_closed ]
+    )
+    campfire = Webhook.create!(
+      name: "Campfire",
+      url: "https://example.com/rooms/123/456-room-name/messages",
+      board: boards(:writebook),
+      subscribed_actions: %w[ card_closed ]
+    )
+    stub_request(:post, slack.url).to_return(status: 200)
+    stub_request(:post, campfire.url).to_return(status: 200)
+
+    create_event("card_closed")
+    deliver_webhooks
+
+    assert_requested :post, slack.url, times: 1
+    assert_requested :post, campfire.url, times: 1
+
+    slack_payload = JSON.parse(last_body_for(slack.url))
+    assert slack_payload["text"].present?
+    assert_not slack_payload.key?("id")
+
+    campfire_payload = JSON.parse(last_body_for(campfire.url))
+    assert campfire_payload["content"].present?
+    assert_not campfire_payload.key?("id")
+  end
+
+  test "ten consecutive failures within an hour switch the receiver off" do
+    stub_request(:post, @url).to_return(status: 500)
+
+    10.times { create_event("card_closed") }
+    deliver_webhooks
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "failures spread over more than an hour do not switch the receiver off" do
+    stub_request(:post, @url).to_return(status: 500)
+
+    9.times { create_event("card_closed") }
+    deliver_webhooks
+    assert @webhook.reload.active?
+
+    travel 61.minutes do
+      create_event("card_closed")
+      deliver_webhooks
+    end
+
+    assert @webhook.reload.active?
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "a success breaks the failure streak" do
+    stub_request(:post, @url).to_return(status: 500)
+    9.times { create_event("card_closed") }
+    deliver_webhooks
+
+    stub_request(:post, @url).to_return(status: 200)
+    create_event("card_closed")
+    deliver_webhooks
+
+    stub_request(:post, @url).to_return(status: 500)
+    9.times { create_event("card_closed") }
+    deliver_webhooks
+
+    assert @webhook.reload.active?
+  end
+
+  test "a private address is not requested" do
+    stub_dns_resolution("127.0.0.1")
+    event = create_event("card_closed")
+    deliver_webhooks
+
+    assert_not_requested :post, @url
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+  end
+
+  test "cleanup keeps a week of the log" do
+    fresh = @webhook.deliveries.create!(event: create_event("comment_created"))
+    stale = @webhook.deliveries.create!(event: create_event("comment_created"))
+    fresh.update_columns(created_at: 6.days.ago)
+    stale.update_columns(created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+
+  private
+    def deliver_webhooks
+      perform_enqueued_jobs only: Event::RelayJob
+      perform_enqueued_jobs only: Webhook::DeliveryJob
+    end
+
+    def create_event(action)
+      Event.create!(
+        board: @webhook.board,
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        action: action
+      )
+    end
+
+    def last_request_body
+      last_body_for(@url)
+    end
+
+    def last_body_for(url)
+      target = URI(url)
+      WebMock::RequestRegistry.instance.requested_signatures.hash.keys.reverse.find do |signature|
+        signature.uri.host == target.host && signature.uri.path == target.path
+      end&.body
+    end
+end
