@@ -0,0 +1,69 @@
+class Webhook::Payload
+  include Rails.application.routes.url_helpers
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def to_s
+    if webhook.for_slack?
+      { text: chat_message }.to_json
+    elsif webhook.for_campfire? || webhook.for_basecamp?
+      { content: chat_message }.to_json
+    else
+      event_json
+    end
+  end
+
+  def default_url_options
+    configured_url_options.merge(script_name: webhook.account.slug)
+  end
+
+  private
+    attr_reader :webhook, :event
+
+    def event_json
+      ApplicationController.renderer.new(renderer_options).render(
+        template: "webhooks/event",
+        assigns: { event: event },
+        formats: [ :json ]
+      )
+    end
+
+    def renderer_options
+      options = { script_name: webhook.account.slug }
+      options[:http_host] = configured_url_options[:host] if configured_url_options[:host].present?
+      options[:https] = true if configured_url_options[:protocol].to_s == "https"
+      options
+    end
+
+    def chat_message
+      [ chat_text, event_url ].compact_blank.join("\n")
+    end
+
+    def chat_text
+      text = event.description_for(nil).to_plain_text
+      CGI.unescapeHTML(text.to_s)
+    end
+
+    def event_url
+      eventable = event.eventable
+      return if eventable.nil?
+
+      case eventable
+      when Card
+        card_url(eventable)
+      when Comment
+        card_url(eventable.card, anchor: ActionView::RecordIdentifier.dom_id(eventable))
+      else
+        polymorphic_url(eventable)
+      end
+    end
+
+    def configured_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
