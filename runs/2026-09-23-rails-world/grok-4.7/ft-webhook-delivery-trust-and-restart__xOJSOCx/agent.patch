+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self) if pending?
+  end
+
+  # Posts at most once. A second run finds the delivery no longer pending and does nothing.
+  def deliver_now
+    return unless claim
+
+    Current.with_account(account) { transmit }
+  rescue => error
