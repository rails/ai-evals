--- /dev/null
+++ b/app/models/event/relaying.rb
@@ -0,0 +1,22 @@
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later(self) if relayable?
+  end
+
+  def relay_now
+    board.webhooks.active.each do |webhook|
+      webhook.deliver(self)
+    end
+  end
+
+  private
+    def relayable?
+      board.webhooks.active.any? { |webhook| webhook.subscribed_to?(action) }
+    end
+end
