diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..957fbf1
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,39 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success
+    reset if consecutive_failures_count.to_i.positive? || first_failure_at.present?
+  end
+
+  def record_failure
+    with_lock do
+      if streak_expired?
+        self.consecutive_failures_count = 1
+        self.first_failure_at = Time.current
+      else
+        self.consecutive_failures_count = consecutive_failures_count.to_i + 1
+        self.first_failure_at ||= Time.current
+      end
+
+      save!
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update!(consecutive_failures_count: 0, first_failure_at: nil)
+  end
+
+  def delinquent?
+    consecutive_failures_count.to_i >= FAILURE_THRESHOLD && !streak_expired?
+  end
+
+  private
+    def streak_expired?
+      first_failure_at.nil? || first_failure_at.before?(FAILURE_WINDOW.ago)
+    end
+end
