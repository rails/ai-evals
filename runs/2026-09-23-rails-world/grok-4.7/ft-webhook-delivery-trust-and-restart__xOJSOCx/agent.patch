   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +71,103 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim
+      claimed = false
+
+      with_lock do
+        if pending?
+          in_progress!
+          claimed = true
+        end
+      end
+
+      claimed
+    end
+
+    def transmit
+      body = Webhook::Payload.new(webhook, event).to_s
+      headers = request_headers(body)
+      update!(request: { headers: headers })
+
+      record_http_response(post(body, headers))
+    rescue DestinationUnreachable, *TRANSPORT_ERRORS
+      record_transport_failure
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => self.class.sign(body, webhook.signing_secret)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      ip = public_ip_for(uri)
+      raise DestinationUnreachable if ip.blank?
+
+      Net::HTTP.start(
+        uri.host,
+        uri.port,
+        ipaddr: ip,
+        use_ssl: uri.scheme == "https",
+        open_timeout: OPEN_TIMEOUT,
+        read_timeout: READ_TIMEOUT,
+        write_timeout: READ_TIMEOUT
+      ) do |http|
+        http.max_retries = 0
+        request = Net::HTTP::Post.new(uri)
+        headers.each { |key, value| request[key] = value }
+        request.body = body
+        http.request(request)
+      end
+    end
+
+    def public_ip_for(uri)
+      host = uri.host
+      return if host.blank?
+
+      if host.match?(Resolv::AddressRegex)
+        return if SsrfProtection.blocked_address?(host)
+
+        host
+      else
+        SsrfProtection.resolve_public_ip(host)
+      end
+    rescue Resolv::ResolvError, IPAddr::InvalidAddressError, Timeout::Error
+      nil
+    end
+
+    def record_http_response(http_response)
+      code = http_response.code.to_i
+      update!(state: :completed, response: { code: code, error: nil })
+      report_to_tracker(code.between?(200, 299))
+    end
+
+    def record_transport_failure
+      update!(state: :errored, response: { error: "destination_unreachable" })
+      report_to_tracker(false)
+    end
+
+    def record_internal_failure(error)
+      Rails.logger.error("Webhook delivery #{id} failed: #{error.class}: #{error.message}")
+      update!(state: :errored, response: { error: "delivery_failed" }) if persisted? && !completed?
+    rescue StandardError
+      nil
+    end
+
+    def report_to_tracker(success)
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!(account: account)
+      if success
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    end
+
+    class DestinationUnreachable < StandardError; end
 end
