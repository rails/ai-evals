diff --git a/lib/rails_ext/habtm_account_id.rb b/lib/rails_ext/habtm_account_id.rb
new file mode 100644
index 0000000..03de1e6
--- /dev/null
+++ b/lib/rails_ext/habtm_account_id.rb
@@ -0,0 +1,31 @@
+# Join rows for has_and_belongs_to_many are inserted through the association,
+# not a model callback. Copy account_id from the owning record so the required
+# column is populated.
+module HasManyAccountId
+  def insert_record(record, ...)
+    assign_account_id(record)
+    super
+  end
+
+  private
+    def assign_account_id(record)
+      return unless record.respond_to?(:has_attribute?) && record.has_attribute?(:account_id)
+      return if record.account_id.present?
+      return unless owner.respond_to?(:account_id)
+
+      record.account_id = owner.account_id || owner.try(:creator)&.account_id || owner.try(:account)&.id
+    end
+end
+
+module HasManyThroughAccountId
+  def save_through_record(record)
+    through_record = build_through_record(record)
+    assign_account_id(through_record)
+    super
+  end
+end
+
+ActiveSupport.on_load(:active_record) do
+  ActiveRecord::Associations::HasManyAssociation.prepend(HasManyAccountId)
+  ActiveRecord::Associations::HasManyThroughAssociation.prepend(HasManyThroughAccountId)
+end
diff --git a/script/check-account-tenancy.rb b/script/check-account-tenancy.rb
new file mode 100644
index 0000000..92375bf
--- /dev/null
+++ b/script/check-account-tenancy.rb
@@ -0,0 +1,41 @@
+# Verifies the multi-tenant account_id rollout: every table that holds an
+# account's data has a required, indexed account_id. Global identity and
+# authentication tables are excluded.
+#
+#   bin/rails runner script/check-account-tenancy.rb
+
+GLOBAL_TABLES = %w[
+  accounts
+  account_external_id_sequences
+  action_pack_passkeys
+  identities
+  identity_access_tokens
+  magic_links
+  sessions
+  ar_internal_metadata
+  schema_migrations
+].freeze
+
+failures = []
+
+ActiveRecord::Base.connection.tables.each do |table|
+  next if GLOBAL_TABLES.include?(table)
+  next unless ActiveRecord::Base.connection.column_exists?(table, :account_id)
+
+  column = ActiveRecord::Base.connection.columns(table).find { |c| c.name == "account_id" }
+  indexed = ActiveRecord::Base.connection.indexes(table).any? { |index| index.columns == [ "account_id" ] || index.columns == [ :account_id ] }
+
+  failures << "#{table}.account_id allows NULL" if column.null
+  failures << "#{table}.account_id is not indexed" unless indexed
+end
+
+account_tables = ActiveRecord::Base.connection.tables - GLOBAL_TABLES
+missing = account_tables.reject { |table| ActiveRecord::Base.connection.column_exists?(table, :account_id) }
+missing.each { |table| failures << "#{table} has no account_id" }
+
+if failures.any?
+  warn failures.join("\n")
+  exit 1
+else
+  puts "account_id is required and indexed on #{account_tables.size} account tables"
+end
