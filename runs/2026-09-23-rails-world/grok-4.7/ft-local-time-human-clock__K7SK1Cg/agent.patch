diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..4e7e36a
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,40 @@
+import { renderLocalTimes } from "helpers/local_time"
+
+const REFRESH_INTERVAL = 30_000
+
+function render() {
+  renderLocalTimes()
+}
+
+function start() {
+  render()
+
+  document.addEventListener("turbo:load", render)
+  document.addEventListener("turbo:render", render)
+  document.addEventListener("turbo:frame-load", render)
+  document.addEventListener("turbo:frame-render", render)
+  document.addEventListener("turbo:morph", render)
+  document.addEventListener("turbo:morph-element", (event) => {
+    if (event.target instanceof Element) renderLocalTimes(event.target)
+  })
+
+  const observer = new MutationObserver((mutations) => {
+    for (const mutation of mutations) {
+      for (const node of mutation.addedNodes) {
+        if (!(node instanceof Element)) continue
+
+        if (node.matches("time[data-local-time-type]")) renderLocalTimes(node)
+        if (node.querySelector?.("time[data-local-time-type]")) renderLocalTimes(node)
+      }
+    }
+  })
+
+  observer.observe(document.documentElement, { childList: true, subtree: true })
+  setInterval(render, REFRESH_INTERVAL)
+}
+
+if (document.readyState === "loading") {
+  document.addEventListener("DOMContentLoaded", start)
+} else {
+  start()
+}
