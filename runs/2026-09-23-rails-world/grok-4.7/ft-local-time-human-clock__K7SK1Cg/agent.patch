diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..a2bf24e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,33 @@
 module TimeHelper
+  # Emit a raw UTC timestamp for the browser to phrase in the viewer's timezone.
+  # The markup is identical for every viewer, so fragment and page caches can be shared.
+  def local_time_tag(time, type: :relative, **attributes)
+    return if time.blank?
+
+    timestamp = utc_timestamp(time)
+    data = attributes.delete(:data) || {}
+
+    tag.time timestamp, datetime: timestamp, **attributes, data: data.merge(local_time_type: type)
+  end
+
+  # A calendar date (not an instant). Used for day headings that already name a date,
+  # so the browser must not shift them across a timezone boundary.
+  def local_date_tag(date, type: :date, **attributes)
+    return if date.blank?
+
+    iso = date.to_date.iso8601
+    data = attributes.delete(:data) || {}
+
+    tag.time iso, datetime: iso, **attributes, data: data.merge(local_time_type: type)
+  end
+
+  # Placeholder expanded in the browser, for strings that leave HTML (native share sheets).
+  def local_time_token(time, type = :date)
+    "[local-time:#{utc_timestamp(time)}|#{type}]"
+  end
+
+  private
+    def utc_timestamp(time)
+      time.utc.iso8601
+    end
 end
