diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..965e64f
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,178 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const RELATIVE_DAY_LIMIT = 7
+const TOKEN = /\[local-time:([^|\]]+)\|([^\]]+)\]/g
+
+// Phrases a timestamp the way the app speaks:
+//   two hours ago  -> "1:42 PM"
+//   last night     -> "yesterday"
+//   earlier week   -> "5 days ago", and older "Sep 12"
+//   overnight      -> "tomorrow"
+//   further out    -> "in 3 days"
+export function formatTimestamp(value, type = "relative", now = new Date()) {
+  if (!value) return ""
+
+  const dateOnly = isDateOnly(value)
+  const date = dateOnly ? parseDateOnly(value) : new Date(value)
+  if (Number.isNaN(date.getTime())) return String(value)
+
+  switch (String(type).replaceAll("_", "-")) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatShortDate(date, date.getFullYear() !== now.getFullYear())
+    case "date-with-year":
+      return formatShortDate(date, true)
+    case "weekday":
+      return formatWeekday(date)
+    case "numeric":
+      return formatNumeric(date)
+    case "day":
+      return formatDayPhrase(date, now)
+    case "ago":
+      return formatAgo(date, now)
+    default:
+      return formatRelative(date, now)
+  }
+}
+
+export function formatTitle(value) {
+  if (!value) return ""
+
+  if (isDateOnly(value)) {
+    return new Intl.DateTimeFormat("en-US", {
+      weekday: "long",
+      month: "long",
+      day: "numeric",
+      year: "numeric"
+    }).format(parseDateOnly(value))
+  }
+
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return ""
+
+  const datePart = new Intl.DateTimeFormat("en-US", {
+    month: "long",
+    day: "numeric",
+    year: "numeric"
+  }).format(date)
+
+  return `${datePart} at ${formatTime(date)}`
+}
+
+export function expandLocalTimeTokens(text, now = new Date()) {
+  if (!text) return text
+
+  return String(text).replace(TOKEN, (_match, value, type) => formatTimestamp(value, type, now))
+}
+
+export function renderLocalTime(element, now = new Date()) {
+  const value = element.dateTime || element.getAttribute("datetime")
+  const text = formatTimestamp(value, element.dataset.localTimeType, now)
+
+  if (text && element.textContent !== text) element.textContent = text
+
+  const title = formatTitle(value)
+  if (title) element.title = title
+  element.dataset.localTimeRendered = "true"
+}
+
+export function renderLocalTimes(root = document, now = new Date()) {
+  const scope = root.querySelectorAll ? root : document
+  scope.querySelectorAll("time[data-local-time-type]").forEach((element) => renderLocalTime(element, now))
+
+  if (scope.matches?.("time[data-local-time-type]")) renderLocalTime(scope, now)
+}
+
+function formatRelative(date, now) {
+  const dayDiff = signedDifferenceInDays(now, date)
+
+  if (dayDiff === 0) return formatTime(date)
+  if (dayDiff === -1) return "yesterday"
+  if (dayDiff === 1) return "tomorrow"
+  if (dayDiff <= -2 && dayDiff > -RELATIVE_DAY_LIMIT) return `${Math.abs(dayDiff)} days ago`
+  if (dayDiff >= 2 && dayDiff < RELATIVE_DAY_LIMIT) return `in ${dayDiff} days`
+
+  return formatShortDate(date, date.getFullYear() !== now.getFullYear())
+}
+
+function formatAgo(date, now) {
+  if (signedDifferenceInDays(now, date) === 0) return formatSameDayDistance(date, now)
+
+  return formatRelative(date, now)
+}
+
+function formatDayPhrase(date, now) {
+  const dayDiff = signedDifferenceInDays(now, date)
+
+  if (dayDiff === 0) return "today"
+  if (dayDiff === -1) return "yesterday"
+  if (dayDiff === 1) return "tomorrow"
+  if (dayDiff < 0) return `${Math.abs(dayDiff)} days ago`
+
+  return `in ${dayDiff} days`
+}
+
+function formatSameDayDistance(date, now) {
+  const diffMs = date.getTime() - now.getTime()
+  const future = diffMs > 0
+  const absSeconds = Math.abs(diffMs) / 1000
+
+  if (absSeconds < 45) return "just now"
+
+  const absMinutes = Math.round(absSeconds / 60)
+  if (absMinutes < 45) {
+    const phrase = pluralize(absMinutes, "minute")
+    return future ? `in ${phrase}` : `${phrase} ago`
+  }
+
+  const absHours = Math.max(1, Math.round(absSeconds / 3600))
+  const phrase = pluralize(absHours, "hour")
+  return future ? `in ${phrase}` : `${phrase} ago`
+}
+
+function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    hour: "numeric",
+    minute: "2-digit",
+    hour12: true
+  }).format(date).replace(/[\u202f\u00a0]/g, " ")
+}
+
+function formatShortDate(date, withYear) {
+  const month = new Intl.DateTimeFormat("en-US", { month: "short" }).format(date)
+  const day = date.getDate()
+
+  if (withYear) return `${month} ${day}, ${date.getFullYear()}`
+
+  return `${month} ${day}`
+}
+
+function formatWeekday(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    weekday: "long",
+    month: "long",
+    day: "numeric"
+  }).format(date)
+}
+
+function formatNumeric(date) {
+  const month = date.getMonth() + 1
+  const day = date.getDate()
+  const year = String(date.getFullYear()).slice(-2)
+
+  return `${month}/${day}/${year}, ${formatTime(date)}`
+}
+
+function pluralize(count, noun) {
+  return `${count} ${noun}${count === 1 ? "" : "s"}`
+}
+
+function isDateOnly(value) {
+  return /^\d{4}-\d{2}-\d{2}$/.test(value)
+}
+
+function parseDateOnly(value) {
+  const [ year, month, day ] = value.split("-").map((part) => parseInt(part, 10))
+  return new Date(year, month - 1, day)
+}
