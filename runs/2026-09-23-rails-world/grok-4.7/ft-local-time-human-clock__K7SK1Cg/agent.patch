diff --git a/script/verify_local_time.rb b/script/verify_local_time.rb
new file mode 100644
index 0000000..623c9ab
--- /dev/null
+++ b/script/verify_local_time.rb
@@ -0,0 +1,79 @@
+#!/usr/bin/env ruby
+# Verifies times are not rendered in the server timezone.
+# The server emits a raw timestamp; phrasing happens in the browser.
+
+require_relative "../config/environment"
+require "action_view"
+
+include ActionView::Helpers::TagHelper
+include TimeHelper
+
+time = Time.utc(2026, 9, 22, 17, 42, 0)
+eastern = Time.use_zone("America/New_York") { local_time_tag(time) }
+tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(time, type: :relative) }
+
+abort "server still bakes a timezone into the markup" unless eastern == tokyo
+abort "server still phrases the clock" if eastern.match?(/AM|PM|ago|yesterday|tomorrow/)
+abort "missing raw timestamp" unless eastern.include?("2026-09-22T17:42:00Z")
+
+html = File.expand_path("../tmp/verify_local_time.html", __dir__)
+File.write(html, <<~HTML)
+  <!DOCTYPE html>
+  <html>
+    <head><meta charset="utf-8"></head>
+    <body>
+      <pre id="results">pending</pre>
+      <script>
+        window.addEventListener("error", (event) => {
+          document.getElementById("results").textContent = "ERROR " + event.message
+          document.title = "FAIL"
+        })
+      </script>
+      <script type="importmap">
+        {
+          "imports": {
+            "helpers/date_helpers": "../app/javascript/helpers/date_helpers.js",
+            "helpers/local_time": "../app/javascript/helpers/local_time.js"
+          }
+        }
+      </script>
+      <script type="module">
+        import { formatTimestamp, expandLocalTimeTokens } from "helpers/local_time"
+
+        const now = new Date("2026-09-22T19:42:00Z") // 3:42 PM in New York
+        const cases = [
+          ["comment two hours ago", formatTimestamp("2026-09-22T17:42:00Z", "relative", now), "1:42 PM"],
+          ["comment last night", formatTimestamp("2026-09-22T03:00:00Z", "relative", now), "yesterday"],
+          ["comment earlier in the week", formatTimestamp("2026-09-17T19:42:00Z", "relative", now), "5 days ago"],
+          ["comment older than a week", formatTimestamp("2026-09-12T19:42:00Z", "relative", now), "Sep 12"],
+          ["auto close overnight", formatTimestamp("2026-09-23T15:00:00Z", "day", now), "tomorrow"],
+          ["auto close further out", formatTimestamp("2026-09-25T19:42:00Z", "day", now), "in 3 days"],
+          ["added two hours ago", formatTimestamp("2026-09-22T17:42:00Z", "ago", now), "2 hours ago"],
+          ["closed date", formatTimestamp("2026-09-05T17:42:00Z", "date-with-year", now), "Sep 5, 2026"],
+          ["calendar heading ignores viewer offset", formatTimestamp("2026-09-12", "weekday", now), "Saturday, September 12"],
+          ["share sheet", expandLocalTimeTokens("Added [local-time:2026-09-22T17:42:00Z|date] by Ada", now), "Added Sep 22 by Ada"]
+        ]
+
+        const failures = cases.filter(([ , actual, expected ]) => actual !== expected)
+        const payload = { failures, cases }
+        document.getElementById("results").textContent = JSON.stringify(payload)
+        document.title = failures.length === 0 ? "PASS" : "FAIL"
+      </script>
+    </body>
+  </html>
+HTML
+
+cmd = [
+  "chromium", "--headless", "--disable-gpu", "--no-sandbox",
+  "--allow-file-access-from-files",
+  "--virtual-time-budget=5000",
+  "--dump-dom", "file://#{html}"
+]
+output = IO.popen({ "TZ" => "America/New_York" }, cmd, &:read)
+title = output[/<title>(.*?)<\/title>/m, 1]
+results = output[/<pre id="results">(.*?)<\/pre>/m, 1]
+
+puts results
+abort "browser did not phrase times (#{title.inspect})" unless title == "PASS"
+
+puts "PASS: server sends raw timestamps; browser phrases them in the viewer timezone"
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..877bb03
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  setup do
+    @time = Time.utc(2026, 9, 22, 17, 42, 0)
+  end
+
+  test "local time tag sends a raw UTC timestamp independent of the server zone" do
+    eastern = Time.use_zone("America/New_York") { local_time_tag(@time) }
+    tokyo = Time.use_zone("Asia/Tokyo") { local_time_tag(@time) }
+
+    assert_equal eastern, tokyo
+    assert_includes eastern, 'datetime="2026-09-22T17:42:00Z"'
+    assert_includes eastern, 'data-local-time-type="relative"'
+    assert_includes eastern, ">2026-09-22T17:42:00Z<"
+    assert_not_includes eastern, "PM"
+    assert_not_includes eastern, "ago"
+  end
+
+  test "local time tag records the requested phrase type" do
+    html = local_time_tag(@time, type: :day)
+
+    assert_includes html, 'data-local-time-type="day"'
+    assert_includes html, 'datetime="2026-09-22T17:42:00Z"'
+  end
+
+  test "local date tag sends a calendar date without a clock" do
+    html = local_date_tag(Date.new(2026, 9, 12), type: :weekday)
+
+    assert_includes html, 'datetime="2026-09-12"'
+    assert_includes html, 'data-local-time-type="weekday"'
+    assert_not_includes html, "T"
+  end
+
+  test "share tokens carry the raw timestamp rather than a server formatted date" do
+    token = local_time_token(@time, :date)
+
+    assert_equal "[local-time:2026-09-22T17:42:00Z|date]", token
+  end
+end
