diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..9f5eccf
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,22 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @account = bundle.account
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:updated_at, :id).to_a
+
+    mail to: @user.identity.email_address, subject: subject_line
+  end
+
+  private
+    def subject_line
+      count = @notifications.size
+      "#{count} new #{"notification".pluralize(count)} in #{@account.name}"
+    end
+
+    def default_url_options
+      options = super
+      options = options.merge(script_name: @account.slug) if @account
+      options
+    end
+end
