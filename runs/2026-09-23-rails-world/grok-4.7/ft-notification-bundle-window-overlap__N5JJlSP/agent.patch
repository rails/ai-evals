+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "digest includes each notification and the settings link" do
+    user = users(:kevin)
+    user.settings.update!(bundle_email_frequency: "daily")
+    notification = notifications(:layout_commented_kevin)
+    bundle = Notification::Bundle.absorb(notification, at: Time.zone.parse("2026-03-02 09:00:00"))
+
+    email = NotificationMailer.digest(bundle)
+
+    assert_equal [ user.identity.email_address ], email.to
+    assert_equal "1 new notification in #{user.account.name}", email.subject
+    assert_match notification.card.title, email.html_part.body.to_s
+    assert_match notification.card.title, email.text_part.body.to_s
+    assert_match "notifications/settings", email.html_part.body.to_s
+    assert_match user.account.slug, email.html_part.body.to_s
+    assert_match user.account.slug, email.text_part.body.to_s
+  end
+end
