index 0000000..8ade92e
--- /dev/null
+++ b/app/views/mailers/notification_mailer/digest.html.erb
@@ -0,0 +1,27 @@
+<h1 class="title"><%= @notifications.size %> new <%= "notification".pluralize(@notifications.size) %></h1>
+<p class="subtitle">Here's what happened in <%= @account.name %>.</p>
+
+<% @notifications.group_by { |notification| notification.card.board }.each do |board, notifications| %>
+  <h2 class="notification__board"><%= link_to board.name, board_url(board) %></h2>
+
+  <% notifications.each do |notification| %>
+    <% payload = notification.payload %>
+    <table class="notification" role="presentation">
+      <tr>
+        <td class="avatar__container"><%= mail_avatar_tag notification.creator %></td>
+        <td>
+          <p class="card__title"><%= link_to payload.title, payload.url %></p>
+          <p class="notification__details"><%= payload.body %></p>
+          <p class="notification__author"><%= notification.creator.name %></p>
+        </td>
+      </tr>
+    </table>
+  <% end %>
+
+  <hr class="notification__board-separator">
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change how often you get these emails", notifications_settings_url %>.
+  Need help? <%= mail_to "support@fizzy.do", "Send us an email" %>.
+</p>
