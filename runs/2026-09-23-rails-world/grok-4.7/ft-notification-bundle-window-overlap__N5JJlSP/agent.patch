--- /dev/null
+++ b/test/mailers/previews/notification_mailer_preview.rb
@@ -0,0 +1,15 @@
+class NotificationMailerPreview < ActionMailer::Preview
+  def digest
+    user = User.active.joins(:identity).joins(:notifications).first
+    notification = user.notifications.first
+    bundle = user.notification_bundles.first || Notification::Bundle.create!(
+      user: user,
+      account: user.account,
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+    bundle.adopt(notification) if bundle.notifications.empty?
+
+    NotificationMailer.digest(bundle)
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..75a302b
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,219 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @frequency = "every_few_hours"
+    @user.settings.update!(bundle_email_frequency: "never")
+    @creator = users(:david)
+  end
+
+  test "never does not open a window" do
+    notification = build_notification(events(:layout_commented))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      assert_nil Notification::Bundle.absorb(notification, at: Time.zone.parse("2026-03-02 09:00:00"))
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: @frequency)
+    landed_at = Time.zone.parse("2026-03-02 09:15:00")
+
+    travel_to landed_at do
+      Notification.find_by(user: @user, card: events(:layout_commented).card)&.destroy!
+      Notification.find_by(user: @user, card: events(:layout_commented).card)&.destroy!
+      notification = Notification.create!(user: @user, source: events(:layout_commented), creator: @creator)
+      bundle = @user.notification_bundles.sole
+
+      assert_equal landed_at, bundle.starts_at
+      assert_equal landed_at + 4.hours, bundle.ends_at
+      assert_includes bundle.notifications, notification
+    end
+  end
+
+  test "frequency chooses the window length" do
+    landed_at = Time.zone.parse("2026-03-02 09:15:00")
+
+    {
+      "every_few_hours" => 4.hours,
+      "daily" => 1.day,
+      "weekly" => 1.week
+    }.each do |frequency, period|
+      @user.notification_bundles.destroy_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+      notification = build_notification(events(:layout_commented))
+
+      bundle = Notification::Bundle.absorb(notification, at: landed_at)
+
+      assert_equal landed_at, bundle.starts_at, frequency
+      assert_equal landed_at + period, bundle.ends_at, frequency
+    end
+  end
+
+  test "notifications inside an open window share it" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 09:00:00")
+    first = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    second = Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at + 3.hours)
+
+    assert_equal first, second
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "a notification after the window closes opens the next window" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 09:00:00")
+    first = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    second = Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at + 4.hours)
+
+    assert_not_equal first, second
+    assert_equal first.ends_at, second.starts_at
+    assert_not overlapping?(@user)
+  end
+
+  test "late notifications join the window that has already opened" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 12:00:00")
+    first = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    late = Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at - 2.hours)
+
+    assert_equal first, late
+    assert_equal opened_at, first.reload.starts_at
+    assert_equal 1, @user.notification_bundles.count
+    assert_not overlapping?(@user)
+  end
+
+  test "a much earlier late notification still does not open an overlapping window" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 12:00:00")
+    Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at - 1.day)
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_not overlapping?(@user)
+  end
+
+  test "out of order arrivals never create overlapping windows" do
+    enable_digests
+    sources = [
+      events(:layout_commented),
+      events(:logo_published),
+      events(:text_published),
+      events(:shipping_published),
+      events(:buy_domain_sent_back_to_triage)
+    ]
+    times = [
+      Time.zone.parse("2026-03-02 12:00:00"),
+      Time.zone.parse("2026-03-02 09:30:00"),
+      Time.zone.parse("2026-03-02 15:45:00"),
+      Time.zone.parse("2026-03-02 11:00:00"),
+      Time.zone.parse("2026-03-03 08:00:00")
+    ]
+
+    sources.zip(times).each do |source, time|
+      Notification::Bundle.absorb(build_notification(source), at: time)
+    end
+
+    assert_not overlapping?(@user)
+    assert_equal sources.size, Notification::BundleItem.joins(:bundle).where(notification_bundles: { user_id: @user.id }).count
+  end
+
+  test "one email is sent per window" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 09:00:00")
+    bundle = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at + 1.hour)
+
+    travel_to bundle.ends_at - 1.minute do
+      assert_emails 0 do
+        bundle.deliver
+      end
+    end
+
+    travel_to bundle.ends_at do
+      assert_emails 1 do
+        bundle.deliver
+        bundle.deliver
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "2 new notifications in #{@user.account.name}", email.subject
+    assert_match "Here's what happened", email.html_part.body.to_s
+    assert bundle.reload.delivered?
+  end
+
+  test "a later window sends its own email" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 09:00:00")
+    first = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    second = Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at + 5.hours)
+
+    travel_to second.ends_at do
+      assert_emails 2 do
+        first.deliver
+        second.deliver
+      end
+    end
+  end
+
+  test "deliver due enqueues closed windows only" do
+    enable_digests
+    opened_at = Time.zone.parse("2026-03-02 09:00:00")
+    due = Notification::Bundle.absorb(build_notification(events(:layout_commented)), at: opened_at)
+    open_window = Notification::Bundle.absorb(build_notification(events(:logo_published)), at: opened_at + 5.hours)
+    clear_enqueued_jobs
+
+    travel_to due.ends_at + 1.minute do
+      Notification::Bundle.deliver_due
+    end
+
+    queued = enqueued_jobs.select { |job| job[:job] == Notification::BundleDeliveryJob }
+    assert_equal 1, queued.size
+    assert_includes queued.first[:args].inspect, due.id
+    assert_not_includes queued.first[:args].inspect, open_window.id
+  end
+
+  test "a backdated notification starts the clock when it lands" do
+    enable_digests
+    landed_at = Time.zone.parse("2026-03-02 09:15:00")
+    Notification.find_by(user: @user, card: events(:text_published).card)&.destroy!
+
+    notification = Notification.create!(user: @user, source: events(:text_published), creator: @creator, created_at: landed_at, updated_at: landed_at)
+    bundle = @user.notification_bundles.sole
+
+    assert_equal landed_at, bundle.starts_at
+    assert_includes bundle.notifications, notification
+  end
+
+  test "creating a notification bundles it when digests are on" do
+    enable_digests
+
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      Notification.create!(user: @user, source: events(:text_published), creator: @creator)
+    end
+  end
+
+  private
+    def enable_digests
+      @user.settings.update!(bundle_email_frequency: @frequency)
+    end
+
+    def build_notification(source)
+      frequency = @user.settings.bundle_email_frequency
+      @user.settings.update!(bundle_email_frequency: "never")
+      Notification.find_by(user: @user, card: source.card)&.destroy!
+      notification = Notification.create!(user: @user, source: source, creator: @creator)
+      @user.settings.update!(bundle_email_frequency: frequency)
+      notification
+    end
+
+    def overlapping?(user)
+      windows = user.notification_bundles.ordered.to_a
+      windows.each_cons(2).any? { |left, right| left.ends_at > right.starts_at }
+    end
+end
