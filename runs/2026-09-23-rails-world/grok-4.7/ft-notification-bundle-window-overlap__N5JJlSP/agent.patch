diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..bc2400f
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,132 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::BundleItem", foreign_key: :bundle_id, inverse_of: :bundle, dependent: :destroy
+  has_many :notifications, through: :items
+
+  scope :ordered, -> { order(:starts_at) }
+  scope :undelivered, -> { where(delivered_at: nil) }
+  scope :due, -> { undelivered.where(ends_at: ..Time.current) }
+
+  validate :ends_after_it_starts
+  validate :does_not_overlap_another_window
+
+  after_create_commit :schedule_delivery
+
+  class << self
+    # Place a notification into the single window it belongs to.
+    #
+    # The clock starts when the first notification lands: a new window opens at
+    # that time and runs for the recipient's chosen period. Notifications that
+    # arrive late — timestamped before a window that has already opened — join
+    # that window instead of opening a second, overlapping one.
+    def absorb(notification, at: nil)
+      at ||= notification.updated_at || Time.current
+      period = notification.user.settings&.bundle_email_period
+
+      if period && deliverable_recipient?(notification)
+        notification.user.with_lock do
+          bundle = window_for(notification.user, at, period)
+          bundle.adopt(notification)
+          bundle
+        end
+      end
+    end
+
+    def deliver_due
+      due.find_each do |bundle|
+        Notification::BundleDeliveryJob.perform_later(bundle)
+      end
+    end
+
+    private
+      def deliverable_recipient?(notification)
+        user = notification.user
+
+        user.active? && user.account.active? && !notification.creator&.system? && user.identity&.email_address.present?
+      end
+
+      def window_for(user, at, period)
+        windows = user.notification_bundles.ordered.lock.load
+
+        if window = windows.find { |candidate| candidate.covers?(at) }
+          window
+        elsif window = windows.find { |candidate| candidate.starts_at > at }
+          # Late arrival. The window that has already opened owns this time so
+          # we don't backdate a new window over it.
+          window
+        elsif window = windows.find { |candidate| candidate.overlaps?(at, at + period) }
+          window
+        else
+          create!(user: user, account: user.account, starts_at: at, ends_at: at + period)
+        end
+      end
+  end
+
+  def covers?(at)
+    starts_at <= at && at < ends_at
+  end
+
+  def overlaps?(range_start, range_end)
+    starts_at < range_end && ends_at > range_start
+  end
+
+  def adopt(notification)
+    items.create_or_find_by!(notification: notification) do |item|
+      item.account = account
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def due?
+    !delivered? && ends_at <= Time.current
+  end
+
+  def deliver
+    if due?
+      claimed = self.class.where(id: id, delivered_at: nil).update_all(delivered_at: Time.current)
+
+      if claimed == 1
+        reload
+        send_email if sendable?
+      end
+    end
+  end
+
+  private
+    def schedule_delivery
+      Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+    end
+
+    def sendable?
+      notifications.any? && user.active? && user.account.active? && user.identity&.email_address.present? && user.settings&.bundle_email_period.present?
+    end
+
+    def send_email
+      NotificationMailer.digest(self).deliver_now
+    rescue
+      update_columns(delivered_at: nil)
+      raise
+    end
+
+    def ends_after_it_starts
+      if starts_at.present? && ends_at.present? && ends_at <= starts_at
+        errors.add(:ends_at, "must be after the window opens")
+      end
+    end
+
+    def does_not_overlap_another_window
+      if starts_at.present? && ends_at.present? && user_id.present?
+        overlap = self.class.where(user_id: user_id).where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+        overlap = overlap.where.not(id: id) if persisted?
+
+        if overlap.exists?
+          errors.add(:base, "overlaps another notification window")
+        end
+      end
+    end
+end
