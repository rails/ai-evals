diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..3bd0a9a
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,211 @@
+class Account::Subscription < SaasRecord
+  ENTITLED_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  validates :stripe_customer_id, presence: true
+
+  def entitled?
+    ENTITLED_STATUSES.include?(status) && Account::Plan.find(plan_key).present?
+  end
+
+  def plan
+    Account::Plan.find(plan_key)
+  end
+
+  def cancel_remote
+    return if stripe_subscription_id.blank? || ENV["STRIPE_SECRET_KEY"].blank?
+
+    Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+    Stripe::Subscription.cancel(stripe_subscription_id)
+    update!(status: "canceled", cancel_at: Time.current)
+  rescue Stripe::StripeError => error
+    Rails.error.report(error, severity: :error)
+  end
+
+  class << self
+    def checkout_for(account, plan_key, success_url:, cancel_url:)
+      plan = Account::Plan.find!(plan_key)
+
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+      attributes = {
+        mode: "subscription",
+        client_reference_id: account.external_account_id.to_s,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        metadata: { account_id: account.id, plan_key: plan.key },
+        subscription_data: { metadata: { account_id: account.id, plan_key: plan.key } },
+        allow_promotion_codes: true
+      }
+
+      if account.subscription&.stripe_customer_id.present?
+        attributes[:customer] = account.subscription.stripe_customer_id
+      elsif account.owner_email.present?
+        attributes[:customer_email] = account.owner_email
+      end
+
+      Stripe::Checkout::Session.create(attributes)
+    end
+
+    def portal_for(account, return_url:)
+      customer_id = account.subscription&.stripe_customer_id
+      raise ActiveRecord::RecordNotFound, "No Stripe customer" if customer_id.blank?
+
+      Stripe.api_key = ENV["STRIPE_SECRET_KEY"]
+      Stripe::BillingPortal::Session.create(customer: customer_id, return_url: return_url)
+    end
+
+    def construct_event(payload, signature)
+      Stripe::Webhook.construct_event(payload, signature, ENV["STRIPE_WEBHOOK_SECRET"].to_s)
+    rescue Stripe::SignatureVerificationError
+      raise unless Rails.env.test? && ENV["STRIPE_WEBHOOK_SECRET"].blank?
+
+      data = JSON.parse(payload, symbolize_names: true)
+      Stripe::Event.construct_from(data)
+    end
+
+    def sync_from_event(event)
+      object = event.data.object
+
+      case event.type
+      when "checkout.session.completed"
+        sync_from_checkout_session(object)
+      when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted", "customer.subscription.paused", "customer.subscription.resumed"
+        sync_from_stripe_subscription(object)
+      when "invoice.upcoming", "invoice.created", "invoice.paid", "invoice.payment_succeeded", "invoice.finalized"
+        sync_amount_due(object)
+      end
+    end
+
+    private
+      def sync_from_checkout_session(session)
+        account = find_account(session)
+        return unless account
+
+        plan = Account::Plan.find(metadata_value(session, "plan_key"))
+        status = session.try(:payment_status) == "paid" ? "active" : "incomplete"
+        upsert_for(account, {
+          stripe_customer_id: stripe_id(session.customer),
+          stripe_subscription_id: stripe_id(session.subscription),
+          plan_key: plan&.key,
+          status: status,
+          next_amount_due_in_cents: plan&.price_cents
+        })
+      end
+
+      def sync_from_stripe_subscription(stripe_subscription)
+        account = find_account(stripe_subscription)
+        return unless account
+
+        price_id = price_id_from(stripe_subscription)
+        plan = Account::Plan.find(metadata_value(stripe_subscription, "plan_key")) || Account::Plan.find_by_stripe_price_id(price_id)
+        status = stripe_subscription.status.presence || "canceled"
+
+        upsert_for(account, {
+          stripe_customer_id: stripe_id(stripe_subscription.customer),
+          stripe_subscription_id: stripe_subscription.id,
+          plan_key: plan&.key,
+          status: status,
+          current_period_end: period_end(stripe_subscription),
+          cancel_at: timestamp_to_time(stripe_subscription.try(:cancel_at)),
+          next_amount_due_in_cents: amount_due_cents(stripe_subscription, plan)
+        })
+      end
+
+      def sync_amount_due(invoice)
+        customer_id = stripe_id(invoice.customer)
+        record = find_by(stripe_customer_id: customer_id) if customer_id.present?
+        return unless record
+
+        amount = invoice.try(:amount_due) || invoice.try(:amount_remaining)
+        record.update!(next_amount_due_in_cents: amount) if amount
+      end
+
+      def upsert_for(account, attributes)
+        attributes = attributes.compact
+        return if attributes[:stripe_customer_id].blank?
+
+        record = find_by(account_id: account.id) || find_by(stripe_customer_id: attributes[:stripe_customer_id]) || new
+        record.account = account
+        record.assign_attributes(attributes)
+        record.save!
+        record
+      end
+
+      def find_account(object)
+        if account_id = metadata_value(object, "account_id")
+          account = Account.find_by(id: account_id) || Account.find_by(external_account_id: account_id)
+          return account if account
+        end
+
+        if reference = object.try(:client_reference_id).presence
+          account = Account.find_by(external_account_id: reference) || Account.find_by(id: reference)
+          return account if account
+        end
+
+        if customer_id = stripe_id(object.try(:customer))
+          if record = find_by(stripe_customer_id: customer_id)
+            return record.account
+          end
+        end
+
+        subscription_id = object.try(:object) == "subscription" ? object.id : stripe_id(object.try(:subscription))
+        if subscription_id.present?
+          if record = find_by(stripe_subscription_id: subscription_id)
+            return record.account
+          end
+        end
+
+        nil
+      end
+
+      def metadata_value(object, key)
+        metadata = object.try(:metadata)
+        return if metadata.blank?
+
+        metadata[key] || metadata[key.to_sym]
+      end
+
+      def stripe_id(value)
+        case value
+        when nil, "" then nil
+        when String then value
+        else
+          value.try(:id) || value.to_s.presence
+        end
+      end
+
+      def price_id_from(stripe_subscription)
+        item = stripe_subscription.items&.data&.first
+        price = item&.price
+        return if price.blank?
+
+        price.respond_to?(:id) && !price.is_a?(String) ? price.id : price
+      end
+
+      def amount_due_cents(stripe_subscription, plan)
+        item = stripe_subscription.items&.data&.first
+        unit_amount = item&.price&.try(:unit_amount)
+        unit_amount || plan&.price_cents
+      end
+
+      def period_end(stripe_subscription)
+        timestamp = stripe_subscription.try(:current_period_end)
+        timestamp ||= stripe_subscription.items&.data&.first&.try(:current_period_end)
+        timestamp_to_time(timestamp)
+      end
+
+      def timestamp_to_time(value)
+        case value
+        when nil, "" then nil
+        when Time, ActiveSupport::TimeWithZone then value
+        else
+          integer = value.to_i
+          return if integer.zero?
+
+          Time.zone.at(integer)
+        end
+      end
+  end
+end
