diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..4aa065d
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,105 @@
+class Account::Plan
+  FREE_CARD_LIMIT = 1_000
+  WARNING_WITHIN = 100
+
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_limit, :stripe_price_env
+
+  def self.free
+    new(
+      key: "free",
+      name: "Free",
+      price_cents: 0,
+      card_limit: FREE_CARD_LIMIT,
+      storage_limit: Account::StorageLimited::DEFAULT_STORAGE_LIMIT
+    )
+  end
+
+  def self.unlimited
+    new(
+      key: "unlimited",
+      name: "Unlimited",
+      price_cents: 2_000,
+      card_limit: nil,
+      storage_limit: 5.gigabytes,
+      stripe_price_env: "STRIPE_MONTHLY_V1_PRICE_ID"
+    )
+  end
+
+  def self.unlimited_plus
+    new(
+      key: "unlimited_plus",
+      name: "Unlimited+",
+      price_cents: 2_500,
+      card_limit: nil,
+      storage_limit: 500.gigabytes,
+      stripe_price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+    )
+  end
+
+  def self.all
+    [ free, unlimited, unlimited_plus ]
+  end
+
+  def self.paid
+    [ unlimited, unlimited_plus ]
+  end
+
+  def self.find(key)
+    return if key.blank?
+
+    all.find { |plan| plan.key == key.to_s || plan.aliases.include?(key.to_s) }
+  end
+
+  def self.find!(key)
+    find(key) || raise(Unknown, "Unknown plan: #{key}")
+  end
+
+  def self.find_by_stripe_price_id(price_id)
+    return if price_id.blank?
+
+    paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+  end
+
+  def initialize(key:, name:, price_cents:, card_limit:, storage_limit:, stripe_price_env: nil)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_env = stripe_price_env
+  end
+
+  def aliases
+    case key
+    when "unlimited" then [ "monthly_v1" ]
+    when "unlimited_plus" then [ "monthly_extra_storage_v1" ]
+    else []
+    end
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_env] if stripe_price_env
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price_label
+    if price_cents.zero?
+      "Free"
+    else
+      "$#{price_cents / 100}/month"
+    end
+  end
+
+  class Unknown < StandardError; end
+end
