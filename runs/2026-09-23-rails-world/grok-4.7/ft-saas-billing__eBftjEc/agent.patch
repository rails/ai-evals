+class StripeWebhooksController < ApplicationController
+  allow_unauthenticated_access
+  skip_forgery_protection
+  skip_before_action :require_account
+
+  def create
+    event = Account::Subscription.construct_event(request.raw_post, stripe_signature)
+    Account::Subscription.sync_from_event(event)
+    head :ok
+  rescue JSON::ParserError, Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def stripe_signature
+      request.headers["Stripe-Signature"] || request.env["HTTP_STRIPE_SIGNATURE"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..3973708
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,127 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = Account::Plan::WARNING_WITHIN
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_remote_subscription
+  end
+
+  def billing_plan
+    plan = entitled_subscription_plan || Account::Plan.free
+
+    if billing_waived? && plan.storage_limit < Account::Plan.unlimited_plus.storage_limit
+      Account::Plan.unlimited_plus
+    else
+      plan
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.entitled?
+  end
+
+  def billing_waived?
+    waiver = billing_waiver
+    waiver.present? && !waiver.destroyed?
+  end
+
+  def card_limit
+    billing_plan.card_limit
+  end
+
+  def effective_card_count
+    override = limit_override&.card_count
+    if override.nil?
+      cards_count
+    else
+      override
+    end
+  end
+
+  def cards_remaining
+    limit = card_limit
+    if limit.nil?
+      nil
+    else
+      limit - effective_card_count
+    end
+  end
+
+  def exceeding_card_limit?
+    remaining = cards_remaining
+    if remaining.nil?
+      false
+    else
+      remaining <= 0
+    end
+  end
+
+  def nearing_card_limit?
+    remaining = cards_remaining
+    if remaining.nil?
+      false
+    else
+      remaining <= CARD_LIMIT_WARNING_THRESHOLD && remaining.positive?
+    end
+  end
+
+  def card_limit_warning
+    "#{cards_remaining} cards left" if nearing_card_limit?
+  end
+
+  def bytes_used
+    override = limit_override&.bytes_used
+    if override.nil?
+      super
+    else
+      override
+    end
+  end
+
+  def checkout_session(plan_key, success_url:, cancel_url:)
+    Account::Subscription.checkout_for(self, plan_key, success_url: success_url, cancel_url: cancel_url)
+  end
+
+  def billing_portal_session(return_url:)
+    Account::Subscription.portal_for(self, return_url: return_url)
+  end
+
+  def comp_billing
+    billing_waiver || create_billing_waiver!
+  end
+
+  def uncomp_billing
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def override_limits(card_count:, bytes_used:)
+    limit = overridden_limit || build_overridden_limit
+    limit.update!(card_count: card_count, bytes_used: bytes_used)
+    limit
+  end
+
+  def reset_limit_override
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  private
+    def entitled_subscription_plan
+      active_subscription&.plan
+    end
+
+    def limit_override
+      limit = overridden_limit
+      limit if limit.present? && !limit.destroyed?
+    end
+
+    def cancel_remote_subscription
+      subscription&.cancel_remote
+    end
+end
