diff --git a/saas/test/controllers/account/upgrades_controller_test.rb b/saas/test/controllers/account/upgrades_controller_test.rb
new file mode 100644
index 0000000..86e29ed
--- /dev/null
+++ b/saas/test/controllers/account/upgrades_controller_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Account::UpgradesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    ENV["STRIPE_SECRET_KEY"] = "sk_test"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_SECRET_KEY")
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "upgrade page lists paid plans" do
+    get new_account_upgrade_path
+
+    assert_response :success
+    assert_select "h3", text: "Unlimited"
+    assert_select "h3", text: "Unlimited+"
+    assert_match "$20/month", response.body
+    assert_match "$25/month", response.body
+    assert_match "5 GB", response.body
+    assert_match "500 GB", response.body
+  end
+
+  test "checkout redirects to Stripe" do
+    Stripe::Checkout::Session.expects(:create).returns(stub(url: "https://checkout.stripe.com/c/pay_test"))
+
+    post account_upgrade_path, params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay_test"
+  end
+
+  test "customer portal redirects to Stripe" do
+    accounts(:"37s").create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_portal", status: "active")
+    Stripe::BillingPortal::Session.expects(:create).returns(stub(url: "https://billing.stripe.com/p/session_test"))
+
+    post account_billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/p/session_test"
+  end
+end
diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..6e0e3dd
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can list accounts and open one by name" do
+    sign_in_as :david
+
+    untenanted do
+      get admin_accounts_path
+      assert_response :success
+      assert_select "a", text: @account.name
+
+      get admin_account_path(@account)
+      assert_response :success
+      assert_match "Comp", response.body
+      assert_match "Uncomp", response.body
+      assert_match "Card count", response.body
+      assert_match "Bytes used", response.body
+      assert_match "Override", response.body
+      assert_match "Reset", response.body
+    end
+  end
+
+  test "non-staff cannot list accounts" do
+    sign_in_as :jz
+
+    untenanted do
+      get admin_accounts_path
+      assert_response :forbidden
+    end
+  end
+
+  test "comp, override, and reset" do
+    sign_in_as :david
+
+    untenanted do
+      post admin_account_billing_waiver_path(@account)
+      assert_redirected_to admin_account_path(@account)
+      assert @account.reload.billing_waiver.present?
+
+      delete admin_account_billing_waiver_path(@account)
+      assert_nil @account.reload.billing_waiver
+
+      post admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 42, bytes_used: 99 } }
+      assert_equal 42, @account.reload.overridden_limit.card_count
+      assert_equal 99, @account.overridden_limit.bytes_used
+
+      delete admin_account_overridden_limit_path(@account)
+      assert_nil @account.reload.overridden_limit
+    end
+  end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
