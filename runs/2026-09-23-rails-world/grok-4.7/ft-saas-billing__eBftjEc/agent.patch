--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "draft card shows upgrade pitch instead of create buttons when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card counts down remaining cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "50 cards left"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "can still draft when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "publishing is refused when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: @account.slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "api create is refused when out of cards" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: @account.slug),
+        params: { card: { title: "Blocked" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "admins see their plan and upgrade in settings" do
+    sign_in_as :mike
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_select "strong", text: "Free"
+    assert_select "a", text: "Upgrade"
+  end
+end
diff --git a/saas/test/controllers/stripe_webhooks_controller_test.rb b/saas/test/controllers/stripe_webhooks_controller_test.rb
new file mode 100644
index 0000000..a86e4a6
--- /dev/null
+++ b/saas/test/controllers/stripe_webhooks_controller_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @secret = "whsec_test"
+    ENV["STRIPE_WEBHOOK_SECRET"] = @secret
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+    @account = accounts(:initech)
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "subscription update entitles the account and sets storage" do
+    payload = {
+      id: "evt_1",
+      object: "event",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_123",
+          object: "subscription",
+          customer: "cus_123",
+          status: "active",
+          cancel_at: nil,
+          metadata: { account_id: @account.id, plan_key: "unlimited" },
+          items: {
+            object: "list",
+            data: [
+              {
+                id: "si_123",
+                object: "subscription_item",
+                current_period_end: 1_800_000_000,
+                price: { id: "price_unlimited", object: "price", unit_amount: 2000 }
+              }
+            ]
+          }
+        }
+      }
+    }.to_json
+
+    post_webhook payload
+
+    assert_response :ok
+    subscription = @account.reload.subscription
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal "active", subscription.status
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal 2000, subscription.next_amount_due_in_cents
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "extra storage price maps to unlimited plus" do
+    payload = {
+      id: "evt_2",
+      object: "event",
+      type: "customer.subscription.created",
+      data: {
+        object: {
+          id: "sub_plus",
+          object: "subscription",
+          customer: "cus_plus",
+          status: "active",
+          metadata: { account_id: @account.id },
+          items: {
+            object: "list",
+            data: [
+              {
+                id: "si_plus",
+                object: "subscription_item",
+                price: { id: "price_plus", object: "price", unit_amount: 2500 }
+              }
+            ]
+          }
+        }
+      }
+    }.to_json
+
+    post_webhook payload
+
+    assert_response :ok
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "rejects a bad signature" do
+    post "/stripe/webhooks", params: "{}", headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => "t=1,v1=bad" }
+    assert_response :bad_request
+  end
+
+  private
+    def post_webhook(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, @secret)
+      header = Stripe::Webhook::Signature.generate_header(timestamp, signature)
+
+      post "/stripe/webhooks",
+        params: payload,
+        headers: { "CONTENT_TYPE" => "application/json", "Stripe-Signature" => header }
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..8764792
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan allows 1000 cards and 1 GB" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal Account::StorageLimited::DEFAULT_STORAGE_LIMIT, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "warning starts 100 cards out" do
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_card_limit?
+    assert_equal "100 cards left", @account.card_limit_warning
+
+    @account.update_column(:cards_count, 950)
+    assert_equal "50 cards left", @account.card_limit_warning
+
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "running out of cards exceeds the free limit" do
+    @account.update_column(:cards_count, 1_000)
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "unlimited plan brings a 5 GB allowance and no card limit" do
+    @account.create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_unlimited", status: "active")
+
+    assert_equal "Unlimited", @account.billing_plan.name
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert_not @account.exceeding_card_limit?
+    assert @account.active_subscription
+  end
+
+  test "unlimited plus plan brings a 500 GB allowance" do
+    @account.create_subscription!(plan_key: "unlimited_plus", stripe_customer_id: "cus_plus", status: "active")
+
+    assert_equal "Unlimited+", @account.billing_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comp grants unlimited plus allowances" do
+    @account.update_column(:cards_count, 2_000)
+    @account.comp_billing
+
+    assert_not @account.exceeding_card_limit?
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp_billing
+    assert @account.exceeding_card_limit?
+  end
+
+  test "override replaces card count and bytes used until reset" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert @account.exceeding_card_limit?
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_limit_override
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "inactive subscription does not entitle the account" do
+    @account.create_subscription!(plan_key: "unlimited", stripe_customer_id: "cus_canceled", status: "canceled")
+
+    assert_nil @account.active_subscription
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+end
