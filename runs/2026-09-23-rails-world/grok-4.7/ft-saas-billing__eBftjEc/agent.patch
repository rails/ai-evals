@@ -0,0 +1,31 @@
+class Admin::Accounts::OverriddenLimitsController < AdminController
+  include Admin::AccountScoped
+
+  layout "public"
+
+  def create
+    apply
+  end
+
+  def update
+    apply
+  end
+
+  def destroy
+    @account.reset_limit_override
+    redirect_to admin_account_path(@account)
+  end
+
+  private
+    def apply
+      @account.override_limits(card_count: limit_value(:card_count), bytes_used: limit_value(:bytes_used))
+      redirect_to admin_account_path(@account)
+    end
+
+    def limit_value(key)
+      source = params[:overridden_limit].presence || params
+      value = source[key]
+      value = source[:cards_count] if value.nil? && key.to_sym == :card_count
+      value.presence
+    end
+end
