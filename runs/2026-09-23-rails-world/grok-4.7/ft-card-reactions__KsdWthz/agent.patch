 Returns `204 No Content` on success.
+
+## `GET /:account_slug/cards/:card_number/reactions`
+
+Returns a list of reactions on a card.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5v9zo9qlcwwpyc0ascnikz",
+    "content": "👍",
+    "reacter": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3/reactions/03f5v9zo9qlcwwpyc0ascnikz"
+  }
+]
+```
+
+## `POST /:account_slug/cards/:card_number/reactions`
+
+Adds a reaction to a card.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `content` | string | Yes | The reaction text |
+
+__Request:__
+
+```json
+{
+  "reaction": {
+    "content": "Great 👍"
+  }
+}
+```
+
+__Response:__
+
+Returns `201 Created` on success.
+
+## `DELETE /:account_slug/cards/:card_number/reactions/:reaction_id`
+
+Removes your reaction from a card.
+
+__Response:__
+
+Returns `204 No Content` on success.
diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..eccb752
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @david_reaction = @card.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_reaction = @card.reactions.create!(content: "🔥", reacter: users(:kevin))
+  end
+
+  test "show renders card reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@card, :reacting)}"
+    assert_select "##{dom_id(@david_reaction)}", text: /👍/
+    assert_select "a[href=?]", new_card_reaction_path(@card)
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "form[action=?]", card_reactions_path(@card)
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+
+    assert_equal "Great work!", @card.reactions.order(:created_at).last.content
+    assert_equal users(:david), @card.reactions.order(:created_at).last.reacter
+  end
+
+  test "destroy" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    reaction = @kevin_reaction
+
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+    body = @response.parsed_body.find { |reaction| reaction["id"] == @david_reaction.id }
+    assert_equal card_reaction_url(@card, @david_reaction), body["url"]
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+    assert_equal card_reaction_url(@card, Reaction.find(@response.parsed_body["id"])), @response.parsed_body["url"]
+  end
+
+  test "create as flat JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { content: "🔥" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "🔥", @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot react to a drafted card" do
+    card = boards(:writebook).cards.create!(title: "Draft", status: "drafted", creator: users(:david))
+
+    assert_no_difference -> { card.reactions.count } do
+      post card_reactions_path(card), params: { reaction: { content: "Nope" } }, as: :json
+      assert_response :forbidden
+    end
+  end
+
+  test "card JSON includes reactions url" do
+    get card_path(@card), as: :json
+
+    assert_response :success
+    assert_equal card_reactions_url(@card), @response.parsed_body["reactions_url"]
+  end
+
+  test "column preview shows boost count when non-zero and hides it otherwise" do
+    boosted = cards(:text)
+    boosted.reactions.create!(content: "🔥", reacter: users(:kevin))
+    boosted.reactions.create!(content: "👍", reacter: users(:david))
+
+    quiet = cards(:logo)
+    quiet.reactions.delete_all
+
+    get board_column_path(boosted.board, boosted.column)
+
+    assert_response :success
+    assert_select "##{dom_id(boosted, :article)} .card__boosts strong", text: "2"
+    assert_select "##{dom_id(boosted, :article)} .card__boosts", text: /boosts/
+
+    get board_column_path(quiet.board, quiet.column)
+
+    assert_response :success
+    assert_select "##{dom_id(quiet, :article)} .card__boosts", count: 0
+  end
+
+  test "comment reactions are not counted as card boosts" do
+    card = cards(:text)
+    comment = card.comments.create!(body: "A comment", creator: users(:david))
+    comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    get board_column_path(card.board, card.column)
+
+    assert_response :success
+    assert_select "##{dom_id(card, :article)} .card__boosts", count: 0
+  end
+
+  test "public column preview shows boost count when non-zero" do
+    card = cards(:text)
+    card.board.publish
+    card.reactions.create!(content: "🎉", reacter: users(:david))
+
+    get public_board_column_path(card.board.publication.key, card.column)
+
+    assert_response :success
+    assert_select "##{dom_id(card, :article)} .card__boosts strong", text: "1"
+  end
+end
