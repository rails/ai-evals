diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..65c2978
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,165 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @kept = accounts(:initech)
+    @owner = users(:jason)
+  end
+
+  test "permanently removes accounts canceled more than 30 days ago and their data" do
+    card = cards(:logo)
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    blob = card.image.blob
+    assert_equal @account.id, blob.account_id
+    assert blob.service.exist?(blob.key)
+
+    search_record = Search::Record.for(card.account_id).find_by!(searchable: card)
+    david_id = users(:david).id
+    david_identity_id = identities(:david).id
+    writebook_id = boards(:writebook).id
+    jz_id = users(:jz).id
+    filter_id = filters(:jz_assignments).id
+
+    Storage::Total.create!(owner: @account, bytes_stored: 10)
+    Storage::Total.create!(owner: boards(:writebook), bytes_stored: 5)
+
+    kept_user = users(:mike)
+    kept_identity = identities(:mike)
+
+    cancel_at(@account, 31.days.ago)
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(david_id)
+    assert_not Board.exists?(writebook_id)
+    assert_not Card.exists?(card.id)
+    assert_not Comment.where(account_id: @account.id).exists?
+    assert_not Event.where(account_id: @account.id).exists?
+    assert_not Notification.where(account_id: @account.id).exists?
+    assert_not Tag.where(account_id: @account.id).exists?
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not Account::JoinCode.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_not Search::Record.for(@account.id).exists?(account_id: @account.id)
+    assert_not Search::Record::SQLite::Fts.exists?(rowid: search_record.id)
+    assert_not ActionText::RichText.exists?(account_id: @account.id)
+    assert_not Storage::Entry.exists?(account_id: @account.id)
+    assert_not Storage::Total.where(owner_type: "Account", owner_id: @account.id).exists?
+    assert_not Storage::Total.where(owner_type: "Board", owner_id: writebook_id).exists?
+    assert_not Identity.exists?(david_identity_id)
+    assert_not Session.exists?(identity_id: david_identity_id)
+    assert_not Identity::AccessToken.exists?(identity_id: david_identity_id)
+    assert_no_rows_with_account_id(@account.id)
+    assert_equal 0, join_count("assignees_filters", "assignee_id", jz_id)
+    assert_equal 0, join_count("filters_tags", "filter_id", filter_id)
+
+    assert Account.exists?(@kept.id)
+    assert User.exists?(kept_user.id)
+    assert Identity.exists?(kept_identity.id)
+    assert Session.exists?(identity: kept_identity)
+  end
+
+  test "does not incinerate accounts canceled within the grace period" do
+    cancel_at(@account, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+    assert User.exists?(users(:david).id)
+  end
+
+  test "does not incinerate an account canceled exactly at the grace period boundary" do
+    freeze_time do
+      cancel_at(@account, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+      assert_not @account.due_for_incineration?
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@kept.id)
+  end
+
+  test "keeps an identity that still belongs to another account" do
+    shared = identities(:david)
+    david_id = users(:david).id
+    other = @kept.users.create!(name: "David Elsewhere", identity: shared, role: :member, verified_at: Time.current)
+    cancel_at(@account, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Identity.exists?(shared.id)
+    assert User.exists?(other.id)
+    assert_not User.exists?(david_id)
+  end
+
+  test "reactivation prevents incineration" do
+    cancel_at(@account, 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not @account.reload.cancelled?
+  end
+
+  test "is safe to run twice" do
+    cancel_at(@account, 31.days.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_nothing_raised do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "is registered as a recurring job" do
+    source = File.read(Rails.root.join("config/recurring.yml"))
+    assert_match(/class: Account::IncinerateDueJob/, source)
+    assert_match(/incinerate_due_accounts:/, source)
+  end
+
+  private
+    def cancel_at(account, created_at)
+      account.cancel(initiated_by: @owner)
+      account.cancellation.update_column(:created_at, created_at)
+    end
+
+    def assert_no_rows_with_account_id(account_id)
+      connection = Account.connection
+      connection.tables.each do |table|
+        next unless connection.column_exists?(table, :account_id)
+
+        count = connection.select_value(<<~SQL.squish)
+          SELECT COUNT(*) FROM #{connection.quote_table_name(table)}
+          WHERE account_id = #{quoted_id(account_id)}
+        SQL
+        assert_equal 0, count.to_i, "expected no rows in #{table} for incinerated account"
+      end
+    end
+
+    def join_count(table, column, id)
+      Account.connection.select_value("SELECT COUNT(*) FROM #{table} WHERE #{column} = #{quoted_id(id)}").to_i
+    end
+
+    def quoted_id(id)
+      Account.connection.quote(Account.type_for_attribute("id").serialize(id))
+    end
+end
