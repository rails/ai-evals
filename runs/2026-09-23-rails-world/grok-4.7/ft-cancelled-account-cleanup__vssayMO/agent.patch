diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..0db500a 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,30 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
+  # Canceled accounts are kept for this long so they can be reactivated,
+  # then permanently removed.
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    with_lock do
+      Incineration.new(self).run if due_for_incineration?
+    end
+  end
+
+  def due_for_incineration?
+    cancellation = Account::Cancellation.find_by(account_id: id)
+    cancellation.present? && cancellation.created_at.before?(INCINERATION_GRACE_PERIOD.ago)
+  end
 end
diff --git a/app/models/account/incineratable/incineration.rb b/app/models/account/incineratable/incineration.rb
new file mode 100644
index 0000000..46626f4
--- /dev/null
+++ b/app/models/account/incineratable/incineration.rb
@@ -0,0 +1,122 @@
+class Account::Incineratable::Incineration
+  # Join tables that reference account-owned records but do not themselves
+  # carry an account_id.
+  USER_FILTER_JOINS = {
+    "assignees_filters" => "assignee_id",
+    "assigners_filters" => "assigner_id",
+    "creators_filters" => "creator_id",
+    "closers_filters" => "closer_id"
+  }.freeze
+
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    Current.without_account do
+      identity_ids = account.users.where.not(identity_id: nil).distinct.pluck(:identity_id)
+
+      purge_stored_files
+      delete_auxiliary_records
+      delete_account_scoped_records
+      delete_orphaned_identities(identity_ids)
+      account.delete
+    end
+  end
+
+  private
+    attr_reader :account
+
+    def purge_stored_files
+      ActiveStorage::Blob.where(account_id: account.id).find_each do |blob|
+        blob.service.delete(blob.key)
+        blob.service.delete_prefixed("variants/#{blob.key}/")
+        blob.service.delete_prefixed("previews/#{blob.key}/")
+      end
+    end
+
+    def delete_auxiliary_records
+      delete_filter_joins
+      delete_storage_totals
+      delete_search_index
+    end
+
+    def delete_filter_joins
+      filter_ids = ids_for(Filter)
+      user_ids = ids_for(User)
+      board_ids = ids_for(Board)
+      tag_ids = ids_for(Tag)
+
+      delete_matching("filters_tags", "filter_id", filter_ids)
+      delete_matching("filters_tags", "tag_id", tag_ids)
+      delete_matching("boards_filters", "filter_id", filter_ids)
+      delete_matching("boards_filters", "board_id", board_ids)
+
+      USER_FILTER_JOINS.each do |table, column|
+        delete_matching(table, "filter_id", filter_ids)
+        delete_matching(table, column, user_ids)
+      end
+    end
+
+    def delete_storage_totals
+      Storage::Total.where(owner_type: "Account", owner_id: account.id).delete_all
+      Storage::Total.where(owner_type: "Board", owner_id: ids_for(Board)).delete_all
+    end
+
+    def delete_search_index
+      return unless Fizzy.db_adapter.sqlite?
+      return unless defined?(Search::Record::SQLite::Fts)
+
+      Search::Record.where(account_id: account.id).in_batches do |records|
+        Search::Record::SQLite::Fts.where(rowid: records.pluck(:id)).delete_all
+      end
+    end
+
+    def delete_account_scoped_records
+      connection.tables.each do |table|
+        next if table == Account.table_name
+        next unless connection.column_exists?(table, :account_id)
+
+        self.class.deleter_for(table).where(account_id: account.id).delete_all
+      end
+    end
+
+    def delete_orphaned_identities(identity_ids)
+      return if identity_ids.empty?
+
+      Identity.where(id: identity_ids).where.missing(:users).find_each do |identity|
+        Account::Import.where(identity: identity).find_each(&:destroy)
+        identity.destroy
+      end
+    end
+
+    def ids_for(model)
+      model.where(account_id: account.id).reorder(nil).select(:id)
+    end
+
+    def delete_matching(table, column, ids)
+      return unless connection.data_source_exists?(table)
+
+      connection.delete(<<~SQL.squish)
+        DELETE FROM #{connection.quote_table_name(table)}
+        WHERE #{connection.quote_column_name(column)} IN (#{ids.to_sql})
+      SQL
+    end
+
+    def connection
+      Account.connection
+    end
+
+    class << self
+      def deleter_for(table_name)
+        deleters[table_name] ||= Class.new(ApplicationRecord) do
+          self.table_name = table_name
+          self.inheritance_column = :_type_disabled
+        end
+      end
+
+      def deleters
+        @deleters ||= {}
+      end
+    end
+end
