@@ -0,0 +1,14 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  # Recurring and global: never pin this job to whatever account happened
+  # to be current when it was enqueued. That account may already be gone.
+  def initialize(...)
+    super
+    @account = nil
+  end
+
+  def perform
+    Account.incinerate_due
+  end
+end
