+<% content_for :header do %>
+  <h1 class="header__title"><%= @account.name %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p>
+      <%= link_to "Accounts", admin_accounts_path %>
+    </p>
+
+    <header>
+      <h2 class="divider txt-medium"><%= @account.name %></h2>
+      <div class="txt-small txt-ink-medium">
+        #<%= @account.external_account_id %>
+        · <%= @account.billing_plan.name %>
+        · <%= @account.billing_waived? ? "Comped" : "Not comped" %>
+      </div>
+    </header>
+
+    <div class="flex gap margin-block">
+      <%= button_to "Comp", comp_admin_account_path(@account), method: :post, class: "btn", form: { data: { turbo: false } } %>
+      <%= button_to "Uncomp", uncomp_admin_account_path(@account), method: :post, class: "btn", form: { data: { turbo: false } } %>
+    </div>
+
+    <p class="txt-small">
+      Cards counted: <strong><%= number_with_delimiter(@account.cards_used) %></strong>
+      of <%= @account.card_limit ? number_with_delimiter(@account.card_limit) : "unlimited" %>.
+      Bytes counted: <strong><%= number_with_delimiter(@account.storage_bytes_used) %></strong>.
+    </p>
+
+    <%= form_with url: override_admin_account_path(@account), scope: :overridden_limit, method: :post, data: { turbo: false }, class: "flex flex-column gap-half" do |form| %>
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, class: "input", min: 0 %>
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, class: "input", min: 0 %>
+      </div>
+
+      <%= form.button "Override", class: "btn" %>
+    <% end %>
+
+    <div class="margin-block-start">
+      <%= button_to "Reset", reset_admin_account_path(@account), method: :delete, class: "btn", form: { data: { turbo: false } } %>
+    </div>
+  </div>
+</section>
