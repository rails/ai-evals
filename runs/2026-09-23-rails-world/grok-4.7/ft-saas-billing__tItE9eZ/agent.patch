+class BillingsController < ApplicationController
+  before_action :ensure_admin, only: [ :checkout, :portal ]
+
+  def show
+    @plan = Current.account.billing_plan
+    @plans = Billing::Plan.paid
+    @page_title = "Upgrade"
+  end
+
+  def checkout
+    url = Billing::Checkout.new(Current.account, params[:plan], account_settings_url).url
+    redirect_to url, allow_other_host: true
+  rescue Billing::Checkout::Error, Stripe::StripeError
+    redirect_to billing_path, alert: "Could not reach Stripe to start checkout."
+  end
+
+  def portal
+    url = Billing::Checkout.new(Current.account, Current.account.billing_plan.key, account_settings_url).portal_url
