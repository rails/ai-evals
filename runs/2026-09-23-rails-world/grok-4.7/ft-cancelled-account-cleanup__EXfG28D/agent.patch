diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..b2818c6
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = Account.create!(name: "Due for incineration")
+    @owner = @account.users.create!(name: "Owner", role: :owner, identity: identities(:david))
+
+    Current.set(user: @owner, account: @account) do
+      @board = @account.boards.create!(name: "Board", creator: @owner, all_access: true)
+      @card = @board.cards.create!(creator: @owner, title: "A card", status: "published", description: "Hello")
+      @card.comments.create!(creator: @owner, body: "A comment")
+      @tag = @account.tags.create!(title: "design")
+      @card.taggings.create!(tag: @tag)
+      @filter = @owner.filters.create!(tag_ids: [ @tag.id ], board_ids: [ @board.id ])
+      @blob = ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new("file-bytes"),
+        filename: "note.txt",
+        content_type: "text/plain"
+      )
+      @card.image.attach(@blob)
+      @account.cancel(initiated_by: @owner)
+    end
+
+    @account.cancellation.update!(created_at: 31.days.ago)
+  end
+
+  test "permanently removes data for accounts canceled more than 30 days ago" do
+    other_account = accounts(:"37s")
+    other_card_count = other_account.cards.count
+    identity = identities(:david)
+
+    assert Search::Record.where(account_id: @account.id).exists?, "expected a search record to exist before incineration"
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_not User.exists?(account_id: @account.id)
+    assert_not Board.exists?(account_id: @account.id)
+    assert_not Card.exists?(account_id: @account.id)
+    assert_not Comment.exists?(account_id: @account.id)
+    assert_not Tag.exists?(account_id: @account.id)
+    assert_not Tagging.exists?(account_id: @account.id)
+    assert_not Filter.exists?(account_id: @account.id)
+    assert_not Account::Cancellation.exists?(account_id: @account.id)
+    assert_not Account::JoinCode.exists?(account_id: @account.id)
+    assert_not ActiveStorage::Blob.exists?(@blob.id)
+    assert_not File.exist?(ActiveStorage::Blob.service.path_for(@blob.key))
+    assert_not ActiveStorage::Attachment.exists?(record: @card)
+    assert_equal 0, Search::Record.where(account_id: @account.id).count
+    if ApplicationRecord.connection.adapter_name == "SQLite"
+      orphan_fts = ApplicationRecord.connection.select_value("SELECT COUNT(*) FROM search_records_fts WHERE rowid NOT IN (SELECT id FROM search_records)").to_i
+      assert_equal 0, orphan_fts, "search index rows should be removed with their records"
+    end
+    assert_no_account_rows(@account.id)
+    assert_equal 0, Storage::Entry.where(account_id: @account.id).count
+    assert_equal 0, Storage::Total.where(owner: @account).or(Storage::Total.where(owner: @board)).count
+    assert_equal 0, ApplicationRecord.connection.select_value("SELECT COUNT(*) FROM filters_tags WHERE tag_id = '#{@tag.id}' OR filter_id = '#{@filter.id}'")
+    assert_equal 0, ApplicationRecord.connection.select_value("SELECT COUNT(*) FROM boards_filters WHERE board_id = '#{@board.id}' OR filter_id = '#{@filter.id}'")
+
+    assert Account.exists?(other_account.id)
+    assert_equal other_card_count, other_account.cards.count
+    assert Identity.exists?(identity.id), "shared identities must be kept"
+
+    assert_not_empty account_rows(other_account.id), "helper should see surviving account rows"
+    Account::IncinerateDueJob.perform_now
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "does not incinerate accounts canceled within the grace period" do
+    @account.cancellation.update!(created_at: 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Card.exists?(@card.id)
+  end
+
+  test "does not incinerate active accounts" do
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate an account canceled exactly 30 days ago" do
+    freeze_time do
+      @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+      assert_no_difference -> { Account.count } do
+        Account::IncinerateDueJob.perform_now
+      end
+    end
+  end
+
+  test "incinerates an account once the grace period has fully elapsed" do
+    freeze_time do
+      @account.cancellation.update!(created_at: Account::Incineratable::INCINERATION_GRACE_PERIOD.ago - 1.second)
+
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  private
+    def assert_no_account_rows(account_id)
+      assert_empty account_rows(account_id)
+    end
+
+    def account_rows(account_id)
+      connection = ApplicationRecord.connection
+      connection.tables.filter_map do |table|
+        next unless connection.column_exists?(table, "account_id")
+
+        account_id_sql = connection.quote(Account.type_for_attribute("id").serialize(account_id))
+        count = connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{account_id_sql}").to_i
+        "#{table}=#{count}" if count.positive?
+      end
+    end
+end
