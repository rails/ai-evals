@@ -0,0 +1,13 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  # Recurring and not tenant-scoped. Drop any captured account so a later
+  # incineration of that account cannot discard this job before it runs.
+  def serialize
+    super.merge("account" => nil)
+  end
+
+  def perform
+    Account.due_for_incineration.find_each(&:incinerate)
+  end
+end
