diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..f37c837 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,23 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> {
+      where(id: Account::Cancellation.where(created_at: ...INCINERATION_GRACE_PERIOD.ago).select(:account_id))
+    }
+  end
+
+  def incinerate
+    with_lock do
+      Incineration.new(self).run if due_for_incineration?
+    end
+  rescue ActiveRecord::RecordNotFound
+    # Already incinerated by a concurrent run.
+  end
+
+  def due_for_incineration?
+    self.class.due_for_incineration.exists?(id)
+  end
 end
diff --git a/app/models/account/incineratable/incineration.rb b/app/models/account/incineratable/incineration.rb
new file mode 100644
index 0000000..3b892cd
--- /dev/null
+++ b/app/models/account/incineratable/incineration.rb
@@ -0,0 +1,176 @@
+class Account::Incineratable::Incineration
+  ACTIVE_STORAGE_TABLES = %w[
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+  ].freeze
+
+  JOIN_TABLES = {
+    "assignees_filters" => [ [ "assignee_id", :user_ids ], [ "filter_id", :filter_ids ] ],
+    "assigners_filters" => [ [ "assigner_id", :user_ids ], [ "filter_id", :filter_ids ] ],
+    "boards_filters" => [ [ "board_id", :board_ids ], [ "filter_id", :filter_ids ] ],
+    "closers_filters" => [ [ "closer_id", :user_ids ], [ "filter_id", :filter_ids ] ],
+    "creators_filters" => [ [ "creator_id", :user_ids ], [ "filter_id", :filter_ids ] ],
+    "filters_tags" => [ [ "tag_id", :tag_ids ], [ "filter_id", :filter_ids ] ]
+  }.freeze
+
+  BATCH_SIZE = 500
+
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    files = nil
+
+    delete_saas_records
+
+    ApplicationRecord.transaction do
+      files = delete_primary_records
+    end
+
+    delete_files(files)
+  end
+
+  private
+    attr_reader :account
+
+    def delete_primary_records
+      ids = associated_ids
+      files = delete_active_storage(ids)
+
+      delete_join_rows(ids)
+      delete_search_index
+      delete_storage_totals(ids)
+      delete_account_scoped_rows
+      account.delete
+
+      files
+    end
+
+    def associated_ids
+      {
+        user_ids: User.where(account_id: account.id).pluck(:id),
+        board_ids: Board.where(account_id: account.id).pluck(:id),
+        filter_ids: Filter.where(account_id: account.id).pluck(:id),
+        tag_ids: Tag.where(account_id: account.id).pluck(:id),
+        shared_identity_ids: shared_identity_ids
+      }
+    end
+
+    def shared_identity_ids
+      identity_ids = User.where(account_id: account.id).where.not(identity_id: nil).distinct.pluck(:identity_id)
+      return [] if identity_ids.empty?
+
+      User.where(identity_id: identity_ids).where.not(account_id: account.id).distinct.pluck(:identity_id)
+    end
+
+    def delete_join_rows(ids)
+      JOIN_TABLES.each do |table, columns|
+        next unless connection.table_exists?(table)
+
+        columns.each do |column, id_key|
+          delete_in(table, column, ids[id_key])
+        end
+      end
+    end
+
+    def delete_search_index
+      return unless connection.adapter_name == "SQLite"
+
+      # FTS5 virtual tables are omitted from connection.tables / table_exists?.
+      ids = Search::Record.where(account_id: account.id).pluck(:id)
+      return if ids.empty?
+
+      ids.each_slice(BATCH_SIZE) do |slice|
+        sql = ApplicationRecord.sanitize_sql_array([ "DELETE FROM search_records_fts WHERE rowid IN (?)", slice ])
+        connection.delete(sql)
+      end
+    end
+
+    def delete_storage_totals(ids)
+      totals = Storage::Total.where(owner_type: "Account", owner_id: account.id)
+      totals = totals.or(Storage::Total.where(owner_type: "Board", owner_id: ids[:board_ids])) if ids[:board_ids].any?
+      totals.delete_all
+    end
+
+    def delete_active_storage(ids)
+      preserved_blob_ids = preserved_blob_ids_for(ids[:shared_identity_ids])
+      blobs = ActiveStorage::Blob.where(account_id: account.id)
+      blobs = blobs.where.not(id: preserved_blob_ids) if preserved_blob_ids.any?
+
+      files = blobs.pluck(:key, :service_name, :content_type)
+      blob_ids = blobs.pluck(:id)
+
+      if blob_ids.any?
+        ActiveStorage::Attachment.where(blob_id: blob_ids).delete_all
+        ActiveStorage::VariantRecord.where(blob_id: blob_ids).delete_all
+        ActiveStorage::Blob.where(id: blob_ids).delete_all
+      end
+
+      attachments = ActiveStorage::Attachment.where(account_id: account.id)
+      variants = ActiveStorage::VariantRecord.where(account_id: account.id)
+      if preserved_blob_ids.any?
+        attachments = attachments.where.not(blob_id: preserved_blob_ids)
+        variants = variants.where.not(blob_id: preserved_blob_ids)
+      end
+      attachments.delete_all
+      variants.delete_all
+
+      files
+    end
+
+    def preserved_blob_ids_for(identity_ids)
+      return [] if identity_ids.empty?
+
+      ActiveStorage::Attachment.where(record_type: "Identity", record_id: identity_ids).pluck(:blob_id)
+    end
+
+    def delete_account_scoped_rows
+      connection.tables.each do |table|
+        next if ACTIVE_STORAGE_TABLES.include?(table)
+        next unless connection.column_exists?(table, "account_id")
+
+        model_for(table).where(account_id: account.id).delete_all
+      end
+    end
+
+    def delete_saas_records
+      return unless defined?(Account::StorageException)
+      return unless Account::StorageException.table_exists?
+
+      Account::StorageException.where(account_id: account.id).delete_all
+    end
+
+    def delete_files(rows)
+      Array(rows).each do |key, service_name, content_type|
+        service = ActiveStorage::Blob.services.fetch(service_name)
+        service.delete(key)
+        service.delete_prefixed("variants/#{key}/") if content_type.to_s.start_with?("image")
+      rescue Errno::ENOENT, ActiveStorage::FileNotFoundError
+        # The file is already gone.
+      end
+    end
+
+    def delete_in(table, column, ids)
+      return if ids.blank?
+
+      model = model_for(table)
+      ids.each_slice(BATCH_SIZE) do |slice|
+        model.where(column => slice).delete_all
+      end
+    end
+
+    def model_for(table)
+      @models ||= {}
+      @models[table] ||= Class.new(ApplicationRecord) do
+        self.table_name = table
+      end.tap do |model|
+        model.primary_key = connection.column_exists?(table, "id") ? "id" : nil
+      end
+    end
+
+    def connection
+      ApplicationRecord.connection
+    end
+end
