diff --git a/test/models/webhook/relay_test.rb b/test/models/webhook/relay_test.rb
new file mode 100644
index 0000000..b2f3b25
--- /dev/null
+++ b/test/models/webhook/relay_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class Webhook::RelayTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution("93.184.216.34")
+    @webhook = webhooks(:active)
+    @board = @webhook.board
+    @webhook.create_delinquency_tracker!(account: @webhook.account) unless @webhook.delinquency_tracker
+  end
+
+  test "creating a subscribed event posts once and logs the outcome" do
+    request = stub_request(:post, @webhook.url).to_return(status: 204, body: "ok")
+
+    event = create_event("card_closed")
+    perform_enqueued_jobs
+
+    assert_requested request, times: 1
+    delivery = @webhook.deliveries.find_by!(event: event)
+    assert delivery.succeeded?
+    assert_equal 204, delivery.response_summary[:code]
+    assert_nil delivery.response_summary[:error]
+    assert_equal Webhook::USER_AGENT, delivery.sanitized_request[:headers]["User-Agent"]
+    assert_equal "application/json", delivery.sanitized_request[:headers]["Content-Type"]
+    assert_not delivery.sanitized_request[:headers].key?("X-Webhook-Signature")
+    assert delivery.request["headers"]["X-Webhook-Signature"].present?
+    assert_equal delivery.id, delivery.request["headers"]["X-Webhook-Delivery"]
+
+    body = nil
+    assert_requested :post, @webhook.url do |posted|
+      body = posted.body
+      signature = posted.headers["X-Webhook-Signature"] || posted.headers["X-Webhook-Signature".downcase]
+      assert_equal @webhook.signature_for(body), signature
+    end
+
+    payload = JSON.parse(body)
+    assert_equal event.id, payload["id"]
+    assert_equal "card_closed", payload["action"]
+    assert_equal cards(:logo).id, payload.dig("eventable", "id")
+  end
+
+  test "does not deliver unsubscribed actions, inactive webhooks, or other boards" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    inactive = webhooks(:inactive)
+    inactive_request = stub_request(:post, inactive.url).to_return(status: 200)
+
+    create_event("comment_created", eventable: cards(:logo).comments.create!(body: "Hello", creator: users(:david)))
+    create_event("card_closed", board: inactive.board)
+    @webhook.deactivate
+    create_event("card_closed")
+    perform_enqueued_jobs
+
+    assert_not_requested request
+    assert_not_requested inactive_request
+  end
+
+  test "delivers exactly once even if relayed again" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    event = create_event("card_closed")
+
+    perform_enqueued_jobs
+    event.relay_now
+    @webhook.deliveries.find_by!(event: event).deliver
+
+    assert_requested request, times: 1
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+  end
+
+  test "ten failures in an hour switch the receiver off and a later success does not" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    9.times { create_event("card_closed") }
+    perform_enqueued_jobs
+    assert @webhook.reload.active?
+    assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+
+    create_event("card_closed")
+    perform_enqueued_jobs
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.deliveries.where(event: Event.where(action: "card_closed").where(created_at: 1.minute.ago..)).count
+  end
+
+  test "failures spread over more than an hour do not switch the receiver off" do
+    tracker = @webhook.delinquency_tracker
+
+    travel_to 2.hours.ago do
+      9.times { tracker.record_failure }
+    end
+
+    tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+  end
+
+  test "a success resets the failure streak" do
+    tracker = @webhook.delinquency_tracker
+    9.times { tracker.record_failure }
+    tracker.record_success
+    tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, tracker.reload.consecutive_failures_count
+  end
+
+  test "reactivating a switched-off receiver starts a fresh streak" do
+    tracker = @webhook.delinquency_tracker
+    10.times { tracker.record_failure }
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+    assert @webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+
+    tracker.record_failure
+    assert @webhook.reload.active?
+  end
+
+  test "cleanup keeps a week of delivery logs" do
+    recent = @webhook.deliveries.create!(event: events(:layout_commented), created_at: 6.days.ago)
+    stale = @webhook.deliveries.create!(event: events(:logo_published), created_at: 8.days.ago)
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(recent.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+
+  test "creating a webhook starts a delinquency tracker" do
+    webhook = Webhook.create!(name: "Fresh", url: "https://example.com/hook", board: boards(:writebook))
+    assert webhook.delinquency_tracker.persisted?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+test "unreachable and private destinations are logged without a post" do
+  stub_dns_resolution("127.0.0.1")
+  request = stub_request(:post, @webhook.url)
+
+  create_event("card_closed")
+  perform_enqueued_jobs
+
+  assert_not_requested request
+  delivery = @webhook.deliveries.order(created_at: :desc).first
+  assert delivery.errored?
+  assert_equal "destination_unreachable", delivery.response_summary[:error]
+  assert @webhook.reload.active?
+  assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+end
+
+  test "pins the connection to the resolved public address" do
+    request = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    create_event("card_closed")
+    perform_enqueued_jobs
+
+    assert_requested request
+  end
+
+
+test "slack campfire and basecamp receivers get a chat payload" do
+  slack = Webhook.create!(name: "Slack", url: "https://hooks.slack.com/services/T123/B456/secret", board: @board, subscribed_actions: %w[ card_closed ])
+  campfire = Webhook.create!(name: "Campfire", url: "https://example.com/rooms/1/2-bot/messages", board: @board, subscribed_actions: %w[ card_closed ])
+  basecamp = Webhook.create!(name: "Basecamp", url: "https://3.basecamp.com/99/integrations/token/buckets/1/chats/2/lines", board: @board, subscribed_actions: %w[ card_closed ])
+
+  stub_request(:post, slack.url).to_return(status: 200)
+  stub_request(:post, campfire.url).to_return(status: 200)
+  stub_request(:post, basecamp.url).to_return(status: 200)
+
+  create_event("card_closed")
+  perform_enqueued_jobs
+
+  assert_requested :post, slack.url do |posted|
+    assert JSON.parse(posted.body).key?("text")
+  end
+  assert_requested :post, campfire.url do |posted|
+    assert JSON.parse(posted.body).key?("body")
+  end
+  assert_requested :post, basecamp.url do |posted|
+    assert JSON.parse(posted.body).key?("content")
+  end
+end
+
+  private
+    def create_event(action, board: @board, eventable: cards(:logo))
+      board.events.create!(action: action, creator: users(:david), eventable: eventable)
+    end
+end
