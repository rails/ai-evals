   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        if pending?
+          in_progress!
+          true
+        else
+          false
+        end
+      end
+    end
+
+    def post_payload
+      payload = Webhook::Payload.new(webhook, event)
+      headers = request_headers(payload.body)
+      update!(request: { "headers" => headers })
+
+      http_response = Webhook::HttpClient.new(webhook.url, payload.body, headers).post
+      record_http_response(http_response)
+    end
+
+    def request_headers(body)
+      {
+        "User-Agent" => Webhook::USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+        "X-Webhook-Signature" => webhook.signature_for(body),
+        "X-Webhook-Delivery" => id
+      }
+    end
+
+    def record_http_response(http_response)
