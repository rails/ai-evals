+      update!(state: :completed, response: { code: code, error: nil })
+      notify_tracker(succeeded?)
+    end
+
+    def record_transport_error(error)
+      update!(state: :errored, response: { error: transport_error_code(error) })
+      notify_tracker(false)
+    rescue => recording_error
+      Rails.logger.error("Webhook delivery #{id} could not record #{error.class}: #{recording_error.class}: #{recording_error.message}")
+    end
+
+    def transport_error_code(error)
+      case error
+      when Timeout::Error
+        "timeout"
+      when Webhook::HttpClient::Unreachable, SocketError, SystemCallError, OpenSSL::SSL::SSLError, EOFError, IOError, Net::ProtocolError
+        "destination_unreachable"
+      else
+        "delivery_failed"
+      end
+    end
+
+    def notify_tracker(success)
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!(account: webhook.account)
+      if success
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    rescue => error
+      Rails.logger.error("Webhook delivery #{id} could not update delinquency: #{error.class}: #{error.message}")
+    end
 end
diff --git a/app/models/webhook/http_client.rb b/app/models/webhook/http_client.rb
new file mode 100644
index 0000000..5ff2c79
--- /dev/null
+++ b/app/models/webhook/http_client.rb
@@ -0,0 +1,65 @@
+class Webhook::HttpClient
+  class Unreachable < StandardError; end
+
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  def initialize(url, body, headers)
+    @url = url
+    @body = body
+    @headers = headers
+  end
+
+  def post
+    uri = parse_uri
+    ip = public_ip_for(uri)
+
+    http = Net::HTTP.new(uri.host, uri.port)
+    http.ipaddr = ip
+    http.use_ssl = uri.scheme == "https"
+    http.open_timeout = OPEN_TIMEOUT
+    http.read_timeout = READ_TIMEOUT
+
+    request = Net::HTTP::Post.new(uri.request_uri)
+    headers.each { |key, value| request[key] = value }
+    request.body = body
+
+    http.request(request)
+  end
+
+  private
+    attr_reader :url, :body, :headers
+
+    def parse_uri
+      uri = URI.parse(url)
+      unless %w[ http https ].include?(uri.scheme) && uri.host.present?
+        raise Unreachable, "destination_unreachable"
+      end
+      uri
+    rescue URI::InvalidURIError
+      raise Unreachable, "destination_unreachable"
+    end
+
+    def public_ip_for(uri)
+      ip = if literal_ip?(uri.host)
+        uri.host
+      else
+        SsrfProtection.resolve_public_ip(uri.host)
+      end
+
+      if ip.blank? || SsrfProtection.blocked_address?(ip)
+        raise Unreachable, "destination_unreachable"
+      end
+
+      ip
+    rescue Resolv::ResolvError, SocketError, SystemCallError
+      raise Unreachable, "destination_unreachable"
+    end
+
+    def literal_ip?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..89c9fe5
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,70 @@
+class Webhook::Payload
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def body
+    if webhook.for_slack?
+      { text: plain_message }.to_json
+    elsif webhook.for_campfire?
+      { body: plain_message }.to_json
+    elsif webhook.for_basecamp?
+      { content: html_message }.to_json
+    else
+      json_body
+    end
+  end
+
+  private
+    attr_reader :webhook, :event
+
+    def json_body
+      render_template(:json)
+    end
+
+    def html_message
+      render_template(:html).strip
+    end
+
+    def plain_message
+      text = CGI.unescapeHTML(event.description_for(nil).to_plain_text.to_s)
+      "#{text} #{event_url}"
+    end
+
+    def event_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options.merge(script_name: webhook.account.slug))
+    end
+
+    def render_template(format)
+      previous = ActiveStorage::Current.url_options
+      ActiveStorage::Current.url_options = url_options.merge(script_name: webhook.account.slug)
+      renderer.render(template: "webhooks/event", formats: [ format ], assigns: { event: event })
+    ensure
+      ActiveStorage::Current.url_options = previous
+    end
+
+    def renderer
+      ApplicationController.renderer.new(
+        http_host: http_host,
+        https: url_options[:protocol].to_s == "https",
+        script_name: webhook.account.slug
+      )
+    end
+
+    def http_host
+      if url_options[:port]
+        "#{url_options[:host]}:#{url_options[:port]}"
+      else
+        url_options[:host]
+      end
+    end
+
+    def url_options
+      @url_options ||= (
+        Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+      ).symbolize_keys
+    end
+end
diff --git a/app/models/webhook/triggerable.rb b/app/models/webhook/triggerable.rb
new file mode 100644
index 0000000..6dcd07d
--- /dev/null
+++ b/app/models/webhook/triggerable.rb
@@ -0,0 +1,22 @@
+module Webhook::Triggerable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def triggered_by(event)
+      active.where(board_id: event.board_id).subscribing_to(event.action)
+    end
+
+    def subscribing_to(action)
+      action = action.to_s
+      if Webhook::PERMITTED_ACTIONS.include?(action)
+        where("subscribed_actions LIKE ?", "%\"#{action}\"%")
+      else
+        none
+      end
+    end
+  end
+
+  def subscribes_to?(action)
+    subscribed_actions.include?(action.to_s)
+  end
+end
