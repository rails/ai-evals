diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..8f1f7c4 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,50 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due clears the column and records the system comment" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    assert cards(:logo).column_id.present?
+
+    Card.auto_postpone_all_due
+
+    card = cards(:logo).reload
+    assert card.postponed?
+    assert_nil card.column_id
+    assert card.events.last.action.card_auto_postponed?
+    assert_equal accounts("37s").system_user, card.postponed_by
+
+    comment = card.comments.order(:created_at).last
+    assert_match /Moved to .Not Now. due to inactivity/, comment.body.to_plain_text
+    assert_equal accounts("37s").system_user, comment.creator
+  end
+
+  test "auto postpone all due includes the cutoff instant and excludes a newer card" do
+    period = entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update!(last_active_at: Time.current - period)
+    cards(:shipping).update!(last_active_at: Time.current - period + 1.second)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due leaves closed and already postponed cards alone" do
+    period = entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update!(last_active_at: 1.day.ago - period)
+    cards(:logo).postpone
+    cards(:shipping).update!(last_active_at: 1.day.ago - period)
+    cards(:shipping).close
+
+    assert_no_difference -> { cards(:logo).events.count } do
+      assert_no_difference -> { Card::NotNow.count } do
+        Card.auto_postpone_all_due
+      end
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:shipping).reload.closed?
+    assert_not cards(:shipping).postponed?
+  end
 end
