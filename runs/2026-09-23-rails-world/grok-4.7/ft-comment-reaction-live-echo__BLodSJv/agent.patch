@@ -0,0 +1,55 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div id="<%= dom_id(comment, :reactions_list) %>" class="reactions__list">
+    <%= render comment.reactions %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction"
+      data-reactions-target="trigger" data-action="reactions#open">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], id: dom_id(comment, :new_reaction),
+        html: { hidden: true },
+        class: "reaction__form",
+        data: { reactions_target: "form",
+                turbo_frame: "_top",
+                action: "turbo:submit-end->reactions#submitted keydown.esc->reactions#close:stop" } do |form| %>
+    <span class="reaction__avatar" aria-hidden="true">
+      <%= avatar_image_tag Current.user, class: "avatar" %>
+    </span>
+
+    <span class="reaction__form-label">
+      <%= form.text_field :content, id: dom_id(comment, :reaction_content), maxlength: 16, required: true, autocomplete: "off",
+            placeholder: "👍", class: "input reaction__input",
+            aria: { label: "Reaction" },
+            data: { reactions_target: "input" } %>
+    </span>
+
+    <details class="reaction__menu" data-reactions-target="emoji">
+      <summary class="btn reaction__menu-btn">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </summary>
+
+      <div class="reaction__popup panel">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" title="<%= label %>"
+                data-action="reactions#pick" data-reactions-emoji-param="<%= emoji %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </div>
+    </details>
+
+    <%= form.button class: "btn reaction__submit-btn", title: "Add reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <button type="button" class="btn reaction__cancel-btn" title="Cancel" data-action="reactions#close">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
