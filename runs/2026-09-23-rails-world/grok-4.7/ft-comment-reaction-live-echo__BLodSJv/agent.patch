+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "card page shows a reactions strip on people comments" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} .reactions"
+    assert_select "##{dom_id(@comment)} .reactions__trigger"
+    assert_select ".comment-by-system .reactions", count: 0
+  end
+
+  test "create adds a reaction to the strip" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "Nice 👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list)
+    assert_equal "Nice 👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal card_comment_reaction_path(@card, @comment, Reaction.last, format: :json), @response.headers["Location"]
+
+    json = @response.parsed_body
+    assert_equal "Great 👍", json["content"]
+    assert_equal users(:kevin).id, json.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, Reaction.last), json["url"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "👍" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", Reaction.last.content
+  end
+
+  test "rejects reactions longer than 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "a" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "index as JSON" do
+    @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+    @comment.reactions.create!(content: "Yes", reacter: users(:jz))
+
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    body = @response.parsed_body
+    assert_equal [ "👍", "Yes" ], body.map { |reaction| reaction["content"] }
+    assert_equal users(:jz).name, body.last.dig("reacter", "name")
+  end
+
+  test "destroy removes your reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "cannot remove someone else's reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:jz))
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comment JSON links to its reactions" do
+    get card_comment_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+
+  test "creating a reaction is broadcast to people watching the card" do
+    assert_turbo_stream_broadcasts @card, count: 1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+  end
+end
