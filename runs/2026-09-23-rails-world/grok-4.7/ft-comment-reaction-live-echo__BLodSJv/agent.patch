+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "content is required and limited to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.build(content: "   ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+
+    reaction.content = "a" * 17
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "strips surrounding whitespace" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "  nice  ")
+
+    assert_equal "nice", reaction.content
+  end
+
+  test "emoji only reactions are distinguished from text" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert comment.reactions.create!(content: "👍").emoji_only?
+    assert_not comment.reactions.create!(content: "Great 👍").emoji_only?
+  end
+
+  test "creating a reaction broadcasts it onto the card" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_turbo_stream_broadcasts comment.card, count: 1 do
+      comment.reactions.create!(content: "👍")
+    end
+  end
+end
