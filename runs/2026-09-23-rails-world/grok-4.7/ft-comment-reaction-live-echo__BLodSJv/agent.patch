diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..8bc417d
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,62 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  wrap_parameters :reaction, include: %i[ content ]
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  rescue_from ActiveRecord::RecordInvalid do |exception|
+    respond_to do |format|
+      format.turbo_stream { head :unprocessable_entity }
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)), alert: exception.record.errors.full_messages.to_sentence }
+      format.json { render json: { errors: exception.record.errors.full_messages }, status: :unprocessable_entity }
+    end
+  end
+
+  def index
+    @reactions = @comment.reactions.preloaded
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)) }
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: dom_id(@comment)) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..3aab85e
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.mine) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.tabIndex = 0
+    }
+  }
+
+  toggle(event) {
+    if (!this.mine) return
+    if (event.target.closest("a, button, form, input")) return
+
+    event.preventDefault()
+    this.element.classList.toggle("expanded")
+  }
+
+  collapse(event) {
+    if (!this.element.contains(event.target)) {
+      this.element.classList.remove("expanded")
+    }
+  }
+
+  get mine() {
+    return window.Current?.user?.id === this.element.dataset.creatorId
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..e89aced
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,64 @@
+import { Controller } from "@hotwired/stimulus"
+
+let dedupeInstalled = false
+
+function installStreamDedupe() {
+  if (dedupeInstalled) return
+  dedupeInstalled = true
+
+  document.addEventListener("turbo:before-stream-render", (event) => {
+    const stream = event.target
+    if (!stream?.action || (stream.action !== "append" && stream.action !== "prepend")) return
+
+    const incoming = stream.templateElement?.content?.firstElementChild
+    if (incoming?.id && document.getElementById(incoming.id)) {
+      event.preventDefault()
+    }
+  })
+}
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "emoji" ]
+
+  connect() {
+    installStreamDedupe()
+  }
+
+  open(event) {
+    event.preventDefault()
+    this.formTarget.classList.add("reaction", "expanded")
+    this.formTarget.hidden = false
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    event?.preventDefault()
+    if (!this.hasFormTarget) return
+
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    if (this.hasEmojiTarget) this.emojiTarget.open = false
+    this.triggerTarget.hidden = false
+  }
+
+  submitted(event) {
+    if (event.detail.success) {
+      this.close()
+    } else {
+      this.formTarget.classList.add("shake")
+    }
+  }
+
+  pick(event) {
+    event.preventDefault()
+    const emoji = event.params.emoji
+    const input = this.inputTarget
+    if ((input.value + emoji).length <= input.maxLength) {
+      input.value += emoji
+    }
+    input.focus()
+    if (this.hasEmojiTarget) this.emojiTarget.open = false
+  }
+}
