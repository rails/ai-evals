diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..bbeb148
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,47 @@
+class Reaction < ApplicationRecord
+  include ActionView::RecordIdentifier
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  normalizes :content, with: ->(value) { value.to_s.strip.gsub(/\s+/, " ").presence }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_removal
+
+  def emoji_only?
+    content.present? && content.match?(/\A[^\p{Alnum}]+\z/)
+  end
+
+  def to_partial_path
+    "cards/comments/reactions/reaction"
+  end
+
+  private
+    def broadcast_creation
+      return unless comment&.card
+
+      broadcast_append_to comment.card,
+        target: dom_id(comment, :reactions_list),
+        html: render_for_broadcast
+    end
+
+    def broadcast_removal
+      return unless comment&.card
+
+      broadcast_remove_to comment.card
+    end
+
+    def render_for_broadcast
+      ApplicationController.renderer.new(script_name: comment.account.slug).render(
+        partial: to_partial_path,
+        locals: { reaction: self }
+      )
+    end
+end
