+class ActivitiesController < ApplicationController
+  # HTML timeline actions, minus deprecated collection moves, plus title changes.
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def activities
+      events = Event.preloaded.where(board: boards, action: ACTIVITY_ACTIONS).order(created_at: :desc, id: :desc)
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events
+    end
+
+    def boards
+      if board_ids.present?
+        Current.user.boards.where(id: board_ids)
+      else
+        Current.user.boards
+      end
+    end
+
+    def creator_ids
+      Array(params[:creator_ids]).compact_blank
+    end
+
+    def board_ids
+      Array(params[:board_ids]).compact_blank
+    end
+end
