@@ -0,0 +1,49 @@
+# Activities
+
+Account activity is the same kind of timeline shown on the home page: card updates and comments the current user can access.
+
+## `GET /:account_slug/activities`
+
+Returns a flat, paginated list of activity, newest first.
+
+Deprecated `card_collection_changed` events are omitted. `card_title_changed` events are included.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user who caused the event |
+| `board_ids[]` | Filter by board. Boards you cannot access are ignored |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "comment_created",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David commented on \"Layout is broken\"",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2#comment_03f5v9zo9qlcwwpyc0ascnikz",
+    "eventable_type": "Comment",
+    "eventable": {},
+    "board": {},
+    "creator": {}
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the cards, comments, boards, and users endpoints. `description` is the event's plain-text sentence. `url` opens the card; comment events also jump to that comment.
+
+`particulars` depends on the action:
+
+| Action | `particulars` |
+|--------|----------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| anything else | `{}` |
+
+Missing board, title, or column values are empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..3be1cb4
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,154 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns accessible activity newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:layout_assignment_jz).id
+    assert_includes ids, events(:layout_commented).id
+
+    created_ats = @response.parsed_body.pluck("created_at")
+    assert_equal created_ats.sort.reverse, created_ats
+    assert_equal events(:layout_assignment_jz).id, @response.parsed_body.first["id"]
+  end
+
+  test "index as JSON includes activity attributes and existing representations" do
+    event = events(:layout_commented)
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_comment_url(comment.card, comment), activity.dig("eventable", "url")
+    assert_equal card_url(comment.card, anchor: dom_id(comment)), activity["url"]
+    assert_equal event.board.id, activity.dig("board", "id")
+    assert_equal event.creator.id, activity.dig("creator", "id")
+    assert_equal event.creator.name, activity.dig("creator", "name")
+    assert activity["created_at"].present?
+  end
+
+  test "card events link to the card and expose assignment particulars" do
+    event = events(:logo_assignment_jz)
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == event.id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).title, activity.dig("eventable", "title")
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal [ users(:jz).id ], activity.dig("particulars", "assignee_ids")
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+  end
+
+  test "omits deprecated collection changes and includes title changes" do
+    collection_change = events(:logo_published).dup
+    collection_change.id = ActiveRecord::Type::Uuid.generate
+    collection_change.action = "card_collection_changed"
+    collection_change.created_at = Time.current
+    collection_change.save!
+
+    title_change = events(:logo_published).dup
+    title_change.id = ActiveRecord::Type::Uuid.generate
+    title_change.action = "card_title_changed"
+    title_change.particulars = { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+    title_change.created_at = Time.current
+    title_change.save!
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.pluck("id")
+    assert_not_includes ids, collection_change.id
+    assert_includes ids, title_change.id
+
+    activity = @response.parsed_body.find { |record| record["id"] == title_change.id }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "missing board, title, and column values are empty strings" do
+    board_change = events(:logo_published)
+    board_change.update_columns(action: "card_board_changed", particulars: { "particulars" => { "new_board" => "New Board" } })
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == board_change.id }
+    assert_equal({ "old_board" => "", "new_board" => "New Board" }, activity["particulars"])
+
+    board_change.update_columns(action: "card_triaged", particulars: {})
+    get activities_path, as: :json
+    activity = @response.parsed_body.find { |record| record["id"] == board_change.id }
+    assert_equal({ "column" => "" }, activity["particulars"])
+
+    board_change.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => nil } })
+    get activities_path, as: :json
+    activity = @response.parsed_body.find { |record| record["id"] == board_change.id }
+    assert_equal({ "old_title" => "", "new_title" => "" }, activity["particulars"])
+  end
+
+  test "other events return an empty particulars object" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |record| record["id"] == events(:logo_published).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "filters by creator and accessible boards" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_closed",
+      created_at: Time.current
+    )
+
+    get activities_path, params: { creator_ids: [ users(:kevin).id ] }, as: :json
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:text_published).id
+    assert_includes ids, private_event.id
+    assert_not_includes ids, events(:logo_published).id
+
+    get activities_path, params: { board_ids: [ boards(:writebook).id ] }, as: :json
+    ids = @response.parsed_body.pluck("id")
+    assert_includes ids, events(:logo_published).id
+    assert_not_includes ids, private_event.id
+
+    get activities_path, params: { board_ids: [ boards(:private).id ], creator_ids: [ users(:david).id ] }, as: :json
+    assert_empty @response.parsed_body
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.pluck("id"), private_event.id
+    assert_includes @response.parsed_body.pluck("id"), events(:logo_published).id
+  end
+
+  test "paginates with the standard next link" do
+    16.times do |index|
+      boards(:writebook).events.create!(
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_reopened",
+        created_at: index.seconds.from_now
+      )
+    end
+
+    get activities_path, as: :json
+
+    assert_operator @response.parsed_body.size, :<, Event.where(action: "card_reopened").count
+    assert_match(/rel="next"/, @response.headers["Link"])
+  end
+end
