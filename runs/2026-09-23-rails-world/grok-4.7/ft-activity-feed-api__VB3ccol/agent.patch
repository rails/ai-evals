+module ActivitiesHelper
+  def activity_event_url(event)
+    if event.action.comment_created?
+      card_url(event.card, anchor: dom_id(event.eventable))
+    else
+      card_url(event.card)
+    end
+  end
+end
diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..53ef7d0 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,34 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def activity_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: string_particular("old_board"), new_board: string_particular("new_board") }
+    when "card_title_changed"
+      { old_title: string_particular("old_title"), new_title: string_particular("new_title") }
+    when "card_triaged"
+      { column: string_particular("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def string_particular(key)
+      nested_particulars[key].to_s
+    end
+
+    def nested_particulars
+      value = particulars
+      if value.is_a?(Hash)
+        nested = value["particulars"] || value[:particulars]
+        nested.is_a?(Hash) ? nested.stringify_keys : {}
+      else
+        {}
+      end
+    end
 end
