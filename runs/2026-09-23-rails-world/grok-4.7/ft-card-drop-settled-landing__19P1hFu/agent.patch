diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..74c0ba3
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,287 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+const DESKTOP_QUERY = "(min-width: 640px)"
+// Long enough for the board touch to broadcast a morph refresh after the save.
+const REFRESH_SETTLE_MS = 2000
+
+// Moves a card between columns and statuses. Columns keep their own order, so a
+// drop chooses a place — not a position within it — and the card is inserted
+// where that place will keep it after the save. The move is applied before the
+// request returns, and the affected columns are held still so the refresh that
+// follows the save cannot shift them.
+export default class extends Controller {
+  connect() {
+    this.pendingSaves = 0
+    this.moveSeq = 0
+    this.mediaQuery = window.matchMedia(DESKTOP_QUERY)
+    this.syncDraggable = this.syncDraggable.bind(this)
+    this.mediaQuery.addEventListener("change", this.syncDraggable)
+    this.observer = new MutationObserver(this.syncDraggable)
+    this.observer.observe(this.element, { childList: true, subtree: true })
+    this.syncDraggable()
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.syncDraggable)
+    this.observer?.disconnect()
+    this.releaseColumns()
+  }
+
+  start(event) {
+    const card = event.target.closest?.(".card")
+    if (!card || !this.element.contains(card) || !this.enabled) return
+
+    this.draggedCard = card
+    this.originColumn = card.closest(".cards")
+    card.classList.add(DRAGGED_CLASS)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest?.(".cards")
+    if (!column || !this.element.contains(column)) {
+      this.clearHighlight()
+      return
+    }
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.highlight(column)
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+    const card = this.draggedCard
+    const column = event.target.closest?.(".cards")
+    this.clearDragStyles()
+
+    if (!column || !this.element.contains(column) || column === this.originColumn) return
+
+    const move = this.plan(card, column)
+    if (!move) return
+
+    const snapshot = this.snapshot(card, this.originColumn, column)
+    this.apply(card, column, move)
+    this.save(card, column, snapshot)
+  }
+
+  end() {
+    this.clearDragStyles()
+    this.draggedCard = null
+    this.originColumn = null
+  }
+
+  // Private
+
+  syncDraggable() {
+    this.element.querySelectorAll(".card").forEach((card) => {
+      const draggable = this.enabled && this.movable(card)
+      card.draggable = draggable
+      card.querySelectorAll("a, img").forEach((child) => {
+        child.draggable = false
+      })
+    })
+  }
+
+  plan(card, column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return null
+
+    const frame = column.querySelector("turbo-frame[src]")
+    if (frame && !frame.hasAttribute("complete") && !list.querySelector(".card, .blank-slate, .pagination-link")) return null
+
+    return { list, before: this.cardToInsertBefore(card, column, list) }
+  }
+
+  cardToInsertBefore(card, column, list) {
+    const cards = [ ...list.querySelectorAll(".card") ].filter((other) => other !== card)
+    const goldenFirst = column.dataset.dragAndDropLocation === "column" || column.dataset.dragAndDropLocation === "stream"
+
+    if (!goldenFirst || card.classList.contains("golden-effect")) return cards[0] || null
+
+    const lastGolden = [ ...cards ].reverse().find((other) => other.classList.contains("golden-effect"))
+    if (lastGolden) return lastGolden.nextElementSibling
+
+    return cards[0] || null
+  }
+
+  apply(card, column, move) {
+    const parent = move.before?.parentElement || move.list.querySelector("turbo-frame") || move.list
+    parent.insertBefore(card, move.before || parent.querySelector(".pagination-link, .blank-slate"))
+    card.dataset.dragAndDropMove = String(++this.moveSeq)
+    this.syncColor(card, column)
+    this.syncStatus(card, column)
+    this.syncBadge(card, column)
+    this.adjustCount(this.originColumn, -1)
+    this.adjustCount(column, 1)
+    this.hold(this.originColumn)
+    this.hold(column)
+  }
+
+  async save(card, column, snapshot) {
+    this.pendingSaves += 1
+    try {
+      const response = await this.request(card, column)
+      if (!response.ok) this.restore(card, snapshot)
+    } catch (error) {
+      this.restore(card, snapshot)
+    } finally {
+      this.pendingSaves -= 1
+      this.scheduleRelease()
+    }
+  }
+
+  request(card, column) {
+    const location = column.dataset.dragAndDropLocation
+    const options = { responseKind: "json" }
+
+    if (location === "not_now") {
+      return post(card.dataset.cardNotNowUrl, options)
+    } else if (location === "closed") {
+      return post(card.dataset.cardClosureUrl, options)
+    } else if (location === "stream") {
+      return destroy(card.dataset.cardTriageUrl, options)
+    } else if (location === "column") {
+      return post(card.dataset.cardTriageUrl, { ...options, query: { column_id: column.dataset.dragAndDropColumnId } })
+    }
+  }
+
+  snapshot(card, source, target) {
+    return {
+      move: String(this.moveSeq + 1),
+      parent: card.parentElement,
+      next: card.nextSibling,
+      className: card.className,
+      style: card.getAttribute("style"),
+      badge: card.querySelector(".card__column-name--current")?.outerHTML || null,
+      source,
+      target,
+      sourceCount: source?.querySelector(".cards__expander-count")?.textContent,
+      targetCount: target?.querySelector(".cards__expander-count")?.textContent
+    }
+  }
+
+  restore(card, snapshot) {
+    if (card.dataset.dragAndDropMove !== snapshot.move) return
+
+    const next = snapshot.next && snapshot.parent?.contains(snapshot.next) ? snapshot.next : null
+    snapshot.parent?.insertBefore(card, next)
+    card.className = snapshot.className
+    if (snapshot.style == null) {
+      card.removeAttribute("style")
+    } else {
+      card.setAttribute("style", snapshot.style)
+    }
+    card.querySelector(".card__column-name--current")?.remove()
+    if (snapshot.badge) {
+      const host = card.querySelector(".card__header") || card
+      host.insertAdjacentHTML("beforeend", snapshot.badge)
+    }
+    this.writeCount(snapshot.source, snapshot.sourceCount)
+    this.writeCount(snapshot.target, snapshot.targetCount)
+  }
+
+  syncColor(card, column) {
+    const location = column.dataset.dragAndDropLocation
+    const color = location === "column" ? column.style.getPropertyValue("--card-color").trim()
+      : location === "stream" ? "var(--color-card-default)"
+      : "var(--color-card-complete)"
+
+    if (color) card.style.setProperty("--card-color", color)
+  }
+
+  syncStatus(card, column) {
+    const location = column.dataset.dragAndDropLocation
+    card.classList.toggle("card--postponed", location === "not_now")
+    card.classList.toggle("card--active", location === "column" || location === "stream")
+  }
+
+  syncBadge(card, column) {
+    const existing = card.querySelector(".card__column-name--current")
+    if (column.dataset.dragAndDropLocation !== "column") {
+      existing?.remove()
+      return
+    }
+
+    const host = card.querySelector(".card__header") || card
+    let badge = existing
+    if (!badge) {
+      badge = document.createElement("span")
+      badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+      const label = document.createElement("span")
+      label.className = "overflow-ellipsis"
+      badge.append(label)
+      host.append(badge)
+    }
+    const label = badge.querySelector(".overflow-ellipsis") || badge
+    label.textContent = column.dataset.columnName
+  }
+
+  adjustCount(column, delta) {
+    const counter = column?.querySelector(".cards__expander-count")
+    if (!counter) return
+
+    const text = counter.textContent.trim()
+    if (!/^\d+$/.test(text)) return
+
+    counter.textContent = String(Math.max(0, Number(text) + delta))
+  }
+
+  writeCount(column, text) {
+    const counter = column?.querySelector(".cards__expander-count")
+    if (counter && text != null) counter.textContent = text
+  }
+
+  hold(column) {
+    column?.setAttribute("data-turbo-permanent", "")
+  }
+
+  scheduleRelease() {
+    clearTimeout(this.releaseTimer)
+    const release = () => {
+      if (this.pendingSaves === 0) this.releaseColumns()
+    }
+    document.addEventListener("turbo:morph", release, { once: true })
+    this.releaseTimer = setTimeout(release, REFRESH_SETTLE_MS)
+  }
+
+  releaseColumns() {
+    this.element.querySelectorAll("[data-turbo-permanent]").forEach((column) => {
+      column.removeAttribute("data-turbo-permanent")
+    })
+  }
+
+  highlight(column) {
+    if (this.highlightedColumn === column) return
+
+    this.clearHighlight()
+    column.classList.add(HOVER_CLASS)
+    this.highlightedColumn = column
+  }
+
+  clearHighlight() {
+    this.highlightedColumn?.classList.remove(HOVER_CLASS)
+    this.highlightedColumn = null
+  }
+
+  clearDragStyles() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.clearHighlight()
+  }
+
+  movable(card) {
+    return Boolean(card.dataset.cardTriageUrl || card.dataset.cardNotNowUrl || card.dataset.cardClosureUrl)
+  }
+
+  get enabled() {
+    return this.mediaQuery?.matches
+  }
+}
