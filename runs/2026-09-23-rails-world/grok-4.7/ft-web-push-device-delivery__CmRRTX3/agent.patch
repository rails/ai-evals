diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..5fcea84
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,88 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint_digest, presence: true, uniqueness: true
+
+  before_validation :set_endpoint_digest
+
+  class << self
+    def subscribe(user:, endpoint:, p256dh_key:, auth_key:)
+      subscription = if endpoint.present?
+        find_or_initialize_by(endpoint_digest: digest(endpoint))
+      else
+        new
+      end
+
+      subscription.user = user
+      subscription.account = user.account
+      subscription.endpoint = endpoint
+      subscription.p256dh_key = p256dh_key
+      subscription.auth_key = auth_key
+      subscription.save
+      subscription
+    end
+
+    def find_by_endpoint(endpoint)
+      find_by(endpoint_digest: digest(endpoint))
+    end
+
+    def digest(endpoint)
+      Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_subject
+      if ENV["VAPID_SUBJECT"].present?
+        ENV["VAPID_SUBJECT"]
+      elsif ENV["BASE_URL"].present?
+        ENV["BASE_URL"]
+      else
+        "mailto:#{mailer_address}"
+      end
+    end
+
+    private
+      def mailer_address
+        email = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+        email[/\A.*<([^>]+)>/, 1] || email
+      end
+  end
+
+  def deliver(notification)
+    return unless self.class.configured?
+
+    WebPush.payload_send(
+      message: notification.to_push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: {
+        subject: self.class.vapid_subject,
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  rescue WebPush::ResponseError => error
+    Rails.error.report(error, handled: true)
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = self.class.digest(endpoint) if endpoint.present?
+    end
+end
