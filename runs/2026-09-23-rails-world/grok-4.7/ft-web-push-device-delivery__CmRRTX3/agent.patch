new file mode 100644
index 0000000..058c810
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal subscription_params[:endpoint], subscription.endpoint
+    assert_equal subscription_params[:p256dh_key], subscription.p256dh_key
+    assert_equal subscription_params[:auth_key], subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal subscription.id, @response.parsed_body["id"]
+  end
+
+  test "create updates an existing endpoint instead of duplicating it" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params.merge(auth_key: "new-auth") }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal "new-auth", @user.push_subscriptions.last.auth_key
+  end
+
+  test "create reassigns an endpoint that belonged to someone else" do
+    other = users(:kevin)
+    other.push_subscriptions.create!(subscription_params)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal @user, PushSubscription.find_by_endpoint(subscription_params[:endpoint]).user
+    assert_empty other.push_subscriptions.reload
+  end
+
+  test "create rejects another user's subscription" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    assert_response :not_found
+  end
+
+  test "create with missing keys" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example/1" } }, as: :json
+    assert_response :bad_request
+  end
+
+  test "destroy" do
+    subscription = @user.push_subscriptions.create!(subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy by endpoint" do
+    @user.push_subscriptions.create!(subscription_params)
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: subscription_params[:endpoint] } }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://push.example/subscription/david",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..896d617
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_mentioned_david)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example/subscription/kevin",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "deliver sends what the tray says and opens the card" do
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with do |payload|
+        message = JSON.parse(payload.fetch(:message))
+        assert_equal @notification.tray_title, message["title"]
+        assert_equal @notification.tray_body, message["body"]
+        assert_equal Rails.application.routes.url_helpers.card_path(@notification.card, script_name: @notification.account.slug), message["url"]
+        assert_equal @subscription.endpoint, payload[:endpoint]
+        assert_equal @subscription.p256dh_key, payload[:p256dh]
+        assert_equal @subscription.auth_key, payload[:auth]
+        assert_equal ENV["VAPID_PUBLIC_KEY"], payload.dig(:vapid, :public_key)
+        assert_equal ENV["VAPID_PRIVATE_KEY"], payload.dig(:vapid, :private_key)
+        true
+      end
+
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver removes subscriptions the push service has expired" do
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.allocate)
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "deliver does nothing without vapid keys" do
+    WebPush.expects(:payload_send).never
+    @subscription.deliver(@notification)
+  end
+
+  test "creating a notification pushes it to the tray subscriber" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "marking a notification read does not push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+    end
+  end
+
+  test "putting a notification back in the tray pushes it" do
+    notification = notifications(:logo_assignment_kevin)
+    notification.read
+
+    assert_enqueued_with(job: Notification::PushJob, args: [ notification ]) do
+      notification.unread
+    end
+  end
+
+  private
+    def with_vapid_keys
+      key = WebPush.generate_key
+      switch_env("VAPID_PUBLIC_KEY", key.public_key) do
+        switch_env("VAPID_PRIVATE_KEY", key.private_key) do
+          yield
+        end
+      end
+    end
+
+    def switch_env(key, value)
+      old = ENV[key]
+      ENV[key] = value
+      yield
+    ensure
+      ENV[key] = old
+    end
+end
