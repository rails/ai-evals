new file mode 100644
index 0000000..7a64bae
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,53 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+
+  def create
+    @push_subscription = PushSubscription.subscribe(user: @user, **push_subscription_attributes)
+
+    if @push_subscription.errors.empty?
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, notice: "Notifications turned on for this device" }
+        format.json { render :show, status: @push_subscription.previously_new_record? ? :created : :ok }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to notifications_settings_path, alert: "Couldn't turn on notifications for this device" }
+        format.json { render json: @push_subscription.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    find_subscription&.destroy!
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Notifications turned off for this device" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.identity.users.find_by!(id: params[:user_id], account: Current.account)
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).tap do |subscription|
+        subscription.require(%i[ endpoint p256dh_key auth_key ])
+      end
+    end
+
+    def push_subscription_attributes
+      push_subscription_params.to_h.symbolize_keys
+    end
+
+    def find_subscription
+      if params[:id].present?
+        @user.push_subscriptions.find_by(id: params[:id])
+      elsif params[:push_subscription].present?
+        @user.push_subscriptions.find_by_endpoint(params.expect(push_subscription: [ :endpoint ])[:endpoint])
+      end
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..06120fb
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,137 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "blocked", "toggle" ]
+  static values = {
+    publicKey: String,
+    url: String,
+    subscriptions: { type: Array, default: [] }
+  }
+
+  async connect() {
+    if (!this.#supported || !this.publicKeyValue) return
+
+    const subscription = await this.#existingSubscription()
+    if (this.#permission === "denied") this.#showBlocked()
+    if (subscription) {
+      await this.#sync(subscription)
+      this.#setEnabled(true)
+    }
+  }
+
+  async toggle() {
+    if (this.element.classList.contains("notifications--on")) {
+      await this.#turnOff()
+    } else {
+      await this.#turnOn()
+    }
+  }
+
+  async #turnOn() {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") {
+      this.#showBlocked()
+      return
+    }
+
+    const registration = await this.#registration()
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    const response = await this.#sync(subscription)
+    if (response?.ok) {
+      this.#hideBlocked()
+      this.#setEnabled(true)
+    }
+  }
+
+  async #turnOff() {
+    const registration = await this.#registration()
+    const subscription = await registration.pushManager.getSubscription()
+    const endpoint = subscription?.endpoint
+
+    if (subscription) await subscription.unsubscribe()
+
+    const record = this.subscriptionsValue.find((item) => item.endpoint === endpoint)
+    if (record) {
+      await destroy(`${this.urlValue}/${record.id}`, { responseKind: "json" })
+    } else if (endpoint) {
+      await destroy(this.urlValue, {
+        responseKind: "json",
+        body: { push_subscription: { endpoint } }
+      })
+    }
+
+    this.subscriptionsValue = this.subscriptionsValue.filter((item) => item.endpoint !== endpoint)
+    this.#setEnabled(false)
+  }
+
+  async #sync(subscription) {
+    const response = await post(this.urlValue, {
+      responseKind: "json",
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+          auth_key: this.#encodeKey(subscription.getKey("auth"))
+        }
+      }
+    })
+
+    if (response.ok) {
+      const record = await response.json
+      this.subscriptionsValue = this.subscriptionsValue
+        .filter((item) => item.endpoint !== record.endpoint)
+        .concat(record)
+    }
+
+    return response
+  }
+
+  async #existingSubscription() {
+    const registration = await this.#registration()
+    return registration.pushManager.getSubscription()
+  }
+
+  #registration() {
+    return navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).then(() => navigator.serviceWorker.ready)
+  }
+
+  #setEnabled(enabled) {
+    this.element.classList.toggle("notifications--on", enabled)
+    if (this.hasToggleTarget) this.toggleTarget.setAttribute("aria-pressed", enabled)
+  }
+
+  #showBlocked() {
+    if (this.hasBlockedTarget) this.blockedTarget.hidden = false
+  }
+
+  #hideBlocked() {
+    if (this.hasBlockedTarget) this.blockedTarget.hidden = true
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #permission() {
+    return Notification.permission
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+    return Uint8Array.from([ ...raw ].map((char) => char.charCodeAt(0)))
+  }
+
+  #encodeKey(buffer) {
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    bytes.forEach((byte) => { binary += String.fromCharCode(byte) })
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "")
+  }
+}
