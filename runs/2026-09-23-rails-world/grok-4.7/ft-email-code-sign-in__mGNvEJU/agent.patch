diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..b5e878d
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,42 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  belongs_to :identity, optional: true
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  enum :purpose, %w[ sign_in sign_up join ].index_by(&:itself), validate: true, scopes: false
+
+  normalizes :email_address, with: ->(value) { value.to_s.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.to_s.strip.upcase.presence }
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+  validates :join_code, presence: true, if: :join?
+
+  before_validation :generate_code, on: :create
+
+  generates_token_for :pending_authentication, expires_in: EXPIRATION do
+    code
+  end
+
+  def self.consume(token, submitted_code)
+    magic_link = find_by_token_for(:pending_authentication, token)
+    if magic_link&.matches?(submitted_code)
+      magic_link.identity
+      magic_link.join_code
+      magic_link.destroy!
+      magic_link
+    end
+  end
+
+  def matches?(submitted_code)
+    candidate = submitted_code.to_s.gsub(/\s+/, "").upcase
+    candidate.bytesize == code.to_s.bytesize && ActiveSupport::SecurityUtils.secure_compare(code, candidate)
+  end
+
+  private
+    def generate_code
+      self.code ||= SecureRandom.alphanumeric(CODE_LENGTH).upcase
+    end
+end
