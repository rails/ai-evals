diff --git a/app/controllers/sessions/magic_links_controller.rb b/app/controllers/sessions/magic_links_controller.rb
new file mode 100644
index 0000000..9733938
--- /dev/null
+++ b/app/controllers/sessions/magic_links_controller.rb
@@ -0,0 +1,109 @@
+class Sessions::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :set_magic_link, only: :show
+
+  def show
+  end
+
+  def create
+    magic_link = MagicLink.find_by_token_for(:pending_authentication, cookies.signed[:pending_authentication_token])
+
+    if magic_link&.matches?(params[:code]) && complete_magic_link(magic_link)
+      magic_link.destroy!
+      cookies.delete(:pending_authentication_token, path: "/")
+      respond_with_session
+    else
+      deny_magic_link(magic_link)
+    end
+  end
+
+  private
+    def set_magic_link
+      @magic_link = MagicLink.find_by_token_for(:pending_authentication, cookies.signed[:pending_authentication_token])
+
+      if @magic_link.nil?
+        redirect_to new_session_path, alert: "That code expired. Enter your email to get a new one."
+      end
+    end
+
+    def complete_magic_link(magic_link)
+      case magic_link.purpose
+      when "sign_in"
+        complete_sign_in(magic_link)
+      when "sign_up"
+        complete_sign_up(magic_link)
+      when "join"
+        complete_join(magic_link)
+      else
+        false
+      end
+    end
+
+    def complete_sign_in(magic_link)
+      if magic_link.identity
+        start_new_session_for magic_link.identity
+        @redirect_url = after_authentication_url
+        true
+      else
+        false
+      end
+    end
+
+    def complete_sign_up(magic_link)
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+      start_new_session_for identity
+      @redirect_url = new_signup_completion_path(script_name: nil)
+      true
+    end
+
+    def complete_join(magic_link)
+      join_code = magic_link.join_code
+
+      if join_code&.active?
+        identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+        start_new_session_for identity
+        @redirect_url = url_after_joining(identity, join_code)
+        true
+      else
+        false
+      end
+    end
+
+    def respond_with_session
+      respond_to do |format|
+        format.html { redirect_to @redirect_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def deny_magic_link(magic_link)
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html do
+          if magic_link
+            redirect_to session_magic_link_path, alert: message
+          else
+            redirect_to new_session_path, alert: "That code expired. Enter your email to get a new one."
+          end
+        end
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :too_many_requests }
+      end
+    end
+end
