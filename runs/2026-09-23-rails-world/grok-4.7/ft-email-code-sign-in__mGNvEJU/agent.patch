@@ -0,0 +1,32 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+              placeholder: "Enter your code…", inputmode: "text" %>
+      </label>
+    </div>
+
+    <% if @magic_link.sign_in? %>
+      <p>If there’s an account for <strong><%= @magic_link.email_address %></strong>, we emailed a six-character code. It’s in the subject so it shows in a notification, and it works for 15 minutes.</p>
+    <% elsif @magic_link.join? %>
+      <p>We emailed a six-character code to <strong><%= @magic_link.email_address %></strong> so you can join. It’s in the subject, and it works for 15 minutes.</p>
+    <% else %>
+      <p>We emailed a six-character code to <strong><%= @magic_link.email_address %></strong>. It’s in the subject so it shows in a notification, and it works for 15 minutes.</p>
+    <% end %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
