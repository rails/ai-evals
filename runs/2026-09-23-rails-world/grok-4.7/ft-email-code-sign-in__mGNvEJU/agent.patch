@@ -0,0 +1,49 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def issue_magic_link(email_address:, purpose:, identity: nil, join_code: nil)
+      magic_link = MagicLink.create!(
+        email_address: email_address,
+        purpose: purpose,
+        identity: identity,
+        join_code: join_code
+      )
+
+      if purpose.to_s != "sign_in" || identity.present?
+        MagicLinkMailer.sign_in_instructions(magic_link).deliver_later
+      end
+
+      cookies.signed[:pending_authentication_token] = {
+        value: magic_link.generate_token_for(:pending_authentication),
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRATION.from_now,
+        path: "/"
+      }
+
+      magic_link
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def respond_with_pending_authentication(redirect_path)
+      respond_to do |format|
+        format.html { redirect_to redirect_path, notice: "Check your email for a code." }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+
+    def url_after_joining(identity, join_code)
+      join_code.redeem_if { identity.join(join_code.account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      if user.setup?
+        landing_url(script_name: join_code.account.slug)
+      else
+        new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+end
