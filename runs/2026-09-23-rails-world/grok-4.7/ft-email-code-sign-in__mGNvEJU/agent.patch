+require "test_helper"
+
+class EmailCodeShowTest < ActionDispatch::IntegrationTest
+  test "join code page renders" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: "show-join@example.com" }
+    end
+
+    get session_magic_link_path
+    assert_response :success
+    assert_select "input[name=code]"
+    assert_match "show-join@example.com", response.body
+  end
+
+  test "expired or missing token redirects home to request a new code" do
+    untenanted do
+      get session_magic_link_path
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "json rejects a bad code" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(format: :json), params: { email_address: identities(:kevin).email_address }
+      end
+
+      post session_magic_link_path(format: :json), params: { code: "NOPE00" }
+      assert_response :unauthorized
+    end
+  end
+end
diff --git a/test/controllers/email_code_signup_and_join_test.rb b/test/controllers/email_code_signup_and_join_test.rb
new file mode 100644
index 0000000..ae8b52f
--- /dev/null
+++ b/test/controllers/email_code_signup_and_join_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class EmailCodeSignupAndJoinTest < ActionDispatch::IntegrationTest
+  test "signing up by email code ends signed up" do
+    email_address = "new.person@example.com"
+
+    untenanted do
+      perform_enqueued_jobs do
+        assert_emails 1 do
+          post signup_path, params: { signup: { email_address: email_address } }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path
+      magic_link = MagicLink.last
+      assert_equal "sign_up", magic_link.purpose
+      assert_includes ActionMailer::Base.deliveries.last.subject, magic_link.code
+
+      assert_difference -> { Identity.count }, 1 do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+
+      assert_redirected_to new_signup_completion_path
+      assert cookies[:session_token].present?
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+
+      identity = Identity.find_by!(email_address: email_address)
+      assert identity.users.exists?(name: "New Person")
+    end
+  end
+
+  test "joining by email code ends joined" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+    email_address = "joiner@example.com"
+
+    perform_enqueued_jobs do
+      assert_emails 1 do
+        post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+      end
+    end
+
+    assert_redirected_to session_magic_link_path(script_name: nil)
+    magic_link = MagicLink.last
+    assert_equal "join", magic_link.purpose
+    assert_equal join_code, magic_link.join_code
+    assert_includes ActionMailer::Base.deliveries.last.subject, magic_link.code
+
+    assert_difference -> { User.count }, 1 do
+      assert_difference -> { Identity.count }, 1 do
+        post session_magic_link_path, params: { code: magic_link.code }
+      end
+    end
+
+    identity = Identity.find_by!(email_address: email_address)
+    user = account.users.find_by!(identity: identity)
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+    assert cookies[:session_token].present?
+    assert_equal email_address, user.name
+    assert_equal 1, join_code.reload.usage_count
+  end
+
+  test "joining an existing identity by email code signs them into the account" do
+    account = accounts("37s")
+    join_code = account_join_codes("37s")
+    identity = identities(:mike)
+
+    assert_not identity.users.exists?(account: account)
+
+    perform_enqueued_jobs do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: identity.email_address }
+    end
+
+    post session_magic_link_path, params: { code: MagicLink.last.code }
+
+    assert identity.users.exists?(account: account)
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+end
diff --git a/test/controllers/sessions/magic_links_controller_test.rb b/test/controllers/sessions/magic_links_controller_test.rb
new file mode 100644
index 0000000..6a52511
--- /dev/null
+++ b/test/controllers/sessions/magic_links_controller_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "requesting a sign-in code emails it in the subject and shows the code form" do
+    untenanted do
+      perform_enqueued_jobs do
+        assert_emails 1 do
+          post session_path, params: { email_address: @identity.email_address }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert cookies[:pending_authentication_token].present?
+
+      magic_link = MagicLink.last
+      assert_equal 6, magic_link.code.length
+      assert_equal @identity, magic_link.identity
+
+      email = ActionMailer::Base.deliveries.last
+      assert_equal [ @identity.email_address ], email.to
+      assert_includes email.subject, magic_link.code
+      assert email.subject.start_with?(magic_link.code)
+
+      follow_redirect!
+      assert_response :success
+      assert_select "input[name=code]"
+    end
+  end
+
+  test "requesting a sign-in code via JSON returns the pending token" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(format: :json), params: { email_address: "  #{@identity.email_address.upcase}  " }
+      end
+
+      assert_response :created
+      assert_equal cookies[:pending_authentication_token], @response.parsed_body["pending_authentication_token"]
+    end
+  end
+
+  test "unknown email does not reveal whether an account exists" do
+    untenanted do
+      perform_enqueued_jobs do
+        assert_no_emails do
+          post session_path, params: { email_address: "missing@example.com" }
+        end
+      end
+
+      assert_redirected_to session_magic_link_path
+      assert_not MagicLink.last.identity
+    end
+  end
+
+  test "invalid email is rejected when signups are accepted" do
+    untenanted do
+      post session_path, params: { email_address: "not-an-email" }
+
+      assert_response :redirect
+      follow_redirect!
+      assert_match "valid email", response.body
+    end
+  end
+
+  test "submitting the code signs in" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = MagicLink.last.code
+      post session_magic_link_path, params: { code: code.downcase }
+
+      assert cookies[:session_token].present?
+      assert_redirected_to landing_path
+      assert_nil MagicLink.find_by(code: code)
+    end
+  end
+
+  test "submitting the code via JSON returns a session token" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path(format: :json), params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path(format: :json), params: { code: " #{MagicLink.last.code} " }
+
+      assert_response :success
+      assert_equal cookies[:session_token], @response.parsed_body["session_token"]
+    end
+  end
+
+  test "a code stops working after fifteen minutes" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = MagicLink.last.code
+
+      travel 16.minutes do
+        post session_magic_link_path, params: { code: code }
+
+        assert_not cookies[:session_token].present?
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "a code still works just before it expires" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      travel 14.minutes do
+        post session_magic_link_path, params: { code: MagicLink.last.code }
+
+        assert cookies[:session_token].present?
+      end
+    end
+  end
+
+  test "wrong code does not sign in and can be retried" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      post session_magic_link_path, params: { code: "WRONG1" }
+
+      assert_not cookies[:session_token].present?
+      assert_redirected_to session_magic_link_path
+
+      post session_magic_link_path, params: { code: MagicLink.last.code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "a used code cannot be reused" do
+    untenanted do
+      perform_enqueued_jobs do
+        post session_path, params: { email_address: @identity.email_address }
+      end
+
+      code = MagicLink.last.code
+      post session_magic_link_path, params: { code: code }
+      delete session_path
+
+      post session_magic_link_path, params: { code: code }
+      assert_not cookies[:session_token].present?
+    end
+  end
+end
