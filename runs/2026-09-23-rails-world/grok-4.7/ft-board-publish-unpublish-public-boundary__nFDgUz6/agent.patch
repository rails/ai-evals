+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  setup do
+    Current.account = accounts("37s")
+    Current.user = users(:kevin)
+    @board = boards(:writebook)
+  end
+
+  test "publish creates a secret key and unpublish removes it" do
+    publication = @board.publish
+
+    assert @board.published?
+    assert publication.key.present?
+    assert_equal users(:kevin), publication.publisher
+    assert_equal accounts("37s"), publication.account
+
+    @board.unpublish
+
+    assert_not @board.reload.published?
+    assert_nil Board::Publication.find_by(key: publication.key)
+  end
+end
