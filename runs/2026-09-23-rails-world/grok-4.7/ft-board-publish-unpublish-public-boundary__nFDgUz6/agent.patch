@@ -0,0 +1,29 @@
+<% if Current.user.admin? || board.published? %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public link</h2>
+
+    <% if board.published? %>
+      <p class="margin-none-block-start">Anyone with this secret link can view the board. Draft cards stay private.</p>
+      <div class="flex align-center gap-half margin-block">
+        <input type="text" class="input flex-item-grow" value="<%= public_board_url(board.publication.key) %>" readonly>
+        <%= button_to_copy_to_clipboard public_board_url(board.publication.key) do %>
+          <%= icon_tag "copy-paste" %>
+          <span class="for-screen-reader">Copy public link</span>
+        <% end %>
+      </div>
+
+      <% if Current.user.admin? %>
+        <%= button_to board_publication_path(board), method: :delete, class: "btn txt-small",
+              data: { turbo_confirm: "Unpublish this board? The current link will stop working." } do %>
+          <span>Unpublish</span>
+        <% end %>
+      <% end %>
+    <% elsif Current.user.admin? %>
+      <p class="margin-none-block-start">Publish this board to share a secret link. Anyone with the link can view published cards.</p>
+      <%= button_to board_publication_path(board), method: :post, class: "btn btn--link margin-block-start" do %>
+        <%= icon_tag "globe" %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
