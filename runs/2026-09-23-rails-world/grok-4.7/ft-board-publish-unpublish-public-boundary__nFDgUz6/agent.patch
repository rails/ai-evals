diff --git a/app/views/public/boards/cards/show.html.erb b/app/views/public/boards/cards/show.html.erb
new file mode 100644
index 0000000..91016d5
--- /dev/null
+++ b/app/views/public/boards/cards/show.html.erb
@@ -0,0 +1,45 @@
+<% @page_title = @card.title %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <% if @card.column %>
+      <%= link_to @card.column.name, public_board_column_path(@publication.key, @card.column), class: "btn btn--back" %>
+    <% else %>
+      <%= link_to @board.name, public_board_path(@publication.key), class: "btn btn--back" %>
+    <% end %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @card.title %></span>
+  </h1>
+<% end %>
+
+<article class="card-perma" id="<%= dom_id(@card, :public) %>">
+  <h1 class="card__title"><%= @card.title %></h1>
+
+  <% if @card.description.present? %>
+    <div class="card__description lexxy-content">
+      <%= @card.description %>
+    </div>
+  <% end %>
+
+  <% if @card.tags.any? %>
+    <ul>
+      <% @card.tags.each do |tag| %>
+        <li><%= tag.title %></li>
+      <% end %>
+    </ul>
+  <% end %>
+
+  <% if @card.comments.any? %>
+    <section>
+      <h2>Comments</h2>
+      <% @card.comments.preloaded.chronologically.each do |comment| %>
+        <article class="comment" id="<%= dom_id(comment) %>">
+          <strong><%= comment.creator.name %></strong>
+          <div><%= comment.body %></div>
+        </article>
+      <% end %>
+    </section>
+  <% end %>
+</article>
