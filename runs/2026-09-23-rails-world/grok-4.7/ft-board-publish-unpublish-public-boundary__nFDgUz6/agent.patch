diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..8cd24b4
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,20 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy, inverse_of: :board
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def publish(publisher: Current.user)
+    publication || create_publication!(publisher: publisher)
+  end
+
+  def unpublish
+    publication&.destroy
+    association(:publication).reset
+  end
+end
