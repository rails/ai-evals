index 0000000..2c12e49
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,10 @@
+class Public::BoardsController < Public::BaseController
+  def show
+    @columns = @board.columns.sorted
+    published_cards = @board.cards.published
+    @maybe_cards = published_cards.awaiting_triage.latest
+    @not_now_cards = published_cards.postponed.latest
+    @closed_cards = published_cards.closed.recently_closed_first
+    @cards_by_column_id = published_cards.active.where.not(column_id: nil).latest.group_by(&:column_id)
+  end
+end
