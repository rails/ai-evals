diff --git a/app/controllers/boards/publications_controller.rb b/app/controllers/boards/publications_controller.rb
new file mode 100644
index 0000000..724c786
--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,24 @@
+class Boards::PublicationsController < ApplicationController
+  include BoardScoped
+
+  before_action :ensure_admin
+
+  def create
+    created = !@board.published?
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board published" }
+      format.json { render "boards/show", status: created ? :created : :ok, location: public_board_url(@board.publication.key) }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_to edit_board_path(@board), notice: "Board unpublished" }
+      format.json { render "boards/show" }
+    end
+  end
+end
