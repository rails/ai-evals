 - The `users` array contains the current page of results; if there are more users, follow the `Link` response header with `rel="next"`
 
 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+
+## Publication
+
+Boards can be published so anyone with a secret URL can view them. `public_url` is included on every board JSON response and is `null` until the board is published. Only account admins can publish or unpublish a board.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board and returns the board JSON, including `public_url`. Publishing again keeps the same secret URL.
+
+__Response:__ `201 Created` the first time, `200 OK` if the board was already published.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board. The previous secret URL stops working. Returns the board JSON with `public_url` set to `null`.
+
+### `GET /:account_slug/public/boards/:key`
+
+Returns the published board to anyone with the secret key. No authentication is required. The same path also works without the account slug. Draft cards are not included.
+
+### `GET /:account_slug/public/boards/:key/columns/:id`
+
+Returns a column on the published board, including its open published cards.
+
+### `GET /:account_slug/public/boards/:key/cards/:number`
+
+Returns a published card on the public board. Draft cards, and cards from other boards, are not available.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..bdc8305
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes a nil public_url by default" do
+    get board_path(@board), as: :json
+
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "admins can publish a board" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :created
+    @board.reload
+    assert @board.published?
+    assert_equal public_board_url(@board.publication.key), @response.parsed_body["public_url"]
+    assert_equal public_board_url(@board.publication.key), @response.headers["Location"]
+  end
+
+  test "publishing again keeps the same secret url" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    assert_no_difference -> { Board::Publication.count } do
+      post board_publication_path(@board), as: :json
+    end
+
+    assert_response :ok
+    assert_equal key, @board.reload.publication.key
+    assert_equal public_board_url(key), @response.parsed_body["public_url"]
+  end
+
+  test "admins can unpublish a board" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication.key
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board), as: :json
+    end
+
+    assert_response :success
+    assert_not @board.reload.published?
+    assert_nil @response.parsed_body["public_url"]
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "html publish and unpublish redirect back to settings" do
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    follow_redirect!
+    assert_select "input[value=?]", public_board_url(@board.reload.publication.key)
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "members cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    Current.set(account: accounts("37s"), user: users(:kevin)) { @board.publish }
+
+    logout_and_sign_in_as :jz
+    delete board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "board creators who are not admins cannot publish" do
+    logout_and_sign_in_as :david
+    assert users(:david).can_administer_board?(@board)
+    assert_not users(:david).admin?
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "owners can publish" do
+    logout_and_sign_in_as :jason
+    @board.accesses.grant_to(users(:jason))
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    assert @board.reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..012738b
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @publication = Current.set(account: accounts("37s"), user: users(:kevin)) { @board.publish }
+    @column = columns(:writebook_in_progress)
+    @card = cards(:text)
+  end
+
+  test "anyone can view a published board, its columns, and published cards" do
+    get public_board_path(@publication.key)
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: @card.title
+    assert_select "a[href=?]", public_board_column_path(@publication.key, @column)
+
+    get public_board_column_path(@publication.key, @column)
+    assert_response :success
+    assert_select "h1", text: @column.name
+    assert_select "a", text: @card.title
+
+    get public_board_card_path(@publication.key, @card.number)
+    assert_response :success
+    assert_select "h1", text: @card.title
+
+    get public_board_card_path(@publication.key, cards(:shipping).number)
+    assert_response :success
+    assert_select "h1", text: cards(:shipping).title
+  end
+
+  test "public JSON exposes the board, column, and published card" do
+    get public_board_path(@publication.key), as: :json
+    assert_response :success
+    assert_equal @board.name, @response.parsed_body["name"]
+    assert_equal public_board_url(@publication.key), @response.parsed_body["public_url"]
+    assert_includes @response.parsed_body["cards"].pluck("number"), @card.number
+
+    get public_board_column_path(@publication.key, @column), as: :json
+    assert_response :success
+    assert_equal [ @card.number ], @response.parsed_body["cards"].pluck("number")
+
+    get public_board_card_path(@publication.key, @card.number), as: :json
+    assert_response :success
+    assert_equal @card.title, @response.parsed_body["title"]
+    assert_equal public_board_card_url(@publication.key, @card.number), @response.parsed_body["url"]
+  end
+
+  test "secret url works without an account prefix" do
+    integration_session.default_url_options[:script_name] = ""
+
+    get "/public/boards/#{@publication.key}"
+    assert_response :success
+    assert_match @board.name, response.body
+
+    get "/public/boards/#{@publication.key}/columns/#{@column.id}"
+    assert_response :success
+
+    get "/public/boards/#{@publication.key}/cards/#{@card.number}"
+    assert_response :success
+  end
+
+  test "unpublished boards, unknown keys, other columns, and drafts are not public" do
+    other_column = columns(:writebook_triage)
+    draft = @board.cards.create!(creator: users(:kevin), title: "Secret draft", status: "drafted", last_active_at: Time.current)
+
+    get public_board_column_path(@publication.key, columns(:writebook_in_progress))
+    assert_response :success
+    assert_no_match draft.title, response.body
+
+    get public_board_card_path(@publication.key, draft.number)
+    assert_response :not_found
+
+    get public_board_card_path(@publication.key, 999_999)
+    assert_response :not_found
+
+    get public_board_column_path("missing-key", other_column)
+    assert_response :not_found
+
+    @board.unpublish
+    get public_board_path(@publication.key)
+    assert_response :not_found
+  end
+
+  test "a key from another account is not visible in this account" do
+    other = Current.set(account: accounts(:initech), user: users(:mike)) { boards(:miltons_wish_list).publish }
+
+    get public_board_path(other.key)
+    assert_response :not_found
+  end
+end
