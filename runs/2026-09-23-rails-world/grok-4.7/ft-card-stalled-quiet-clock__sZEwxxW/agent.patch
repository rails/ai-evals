diff --git a/test/controllers/cards/stalled_index_test.rb b/test/controllers/cards/stalled_index_test.rb
new file mode 100644
index 0000000..e456464
--- /dev/null
+++ b/test/controllers/cards/stalled_index_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Cards::StalledIndexTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:text)
+    @card.board.update!(auto_postpone_period: 30.days)
+
+    with_current_user(:david) do
+      @card.toggle_assignment(users(:kevin))
+    end
+  end
+
+  test "cards index lists stalled cards with indexed_by=stalled" do
+    travel 2.weeks do
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_select ".card--stalled", text: /Stalled/
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_response :success
+      numbers = @response.parsed_body.pluck("number")
+      assert_includes numbers, @card.number
+      assert @response.parsed_body.find { |card| card["number"] == @card.number }["stalled"]
+    end
+  end
+
+  test "show renders the stalled flag" do
+    travel 2.weeks do
+      get card_path(@card)
+      assert_response :success
+      assert_select ".card--stalled .card__stalled", text: "Stalled"
+    end
+  end
+end
diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..f177808
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @card.board.update!(auto_postpone_period: 30.days)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    comment_as(:david, "One")
+    comment_as(:kevin, "Two")
+    assert_not @card.reload.burst?
+
+    comment_as(:david, "Three")
+
+    assert @card.reload.burst?
+    assert_not @card.stalled?
+  end
+
+  test "comments spread beyond a third of the auto-close period are not a burst" do
+    window = @card.board.auto_postpone_period / 3.0
+
+    comment_as(:david, "Old", created_at: (window + 1.minute).seconds.ago)
+    comment_as(:kevin, "Also old", created_at: (window + 1.minute).seconds.ago)
+    comment_as(:david, "Now")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "three comments from one person are not a burst" do
+    3.times { |i| comment_as(:david, "Again #{i}") }
+
+    assert_not @card.reload.burst?
+  end
+
+  test "two comments from two people are not a burst" do
+    comment_as(:david, "One")
+    comment_as(:kevin, "Two")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments do not count toward a burst" do
+    comment_as(:david, "One")
+    comment_as(:kevin, "Two")
+    @card.comments.create!(creator: @card.account.system_user, body: "System note")
+
+    assert_not @card.reload.burst?
+  end
+
+  test "assigning someone is a burst" do
+    with_current_user(:david) do
+      @card.toggle_assignment(users(:kevin))
+    end
+
+    assert @card.reload.burst?
+  end
+
+  test "reopening a card is a burst" do
+    with_current_user(:david) do
+      @card.close
+      assert_not @card.reload.burst?
+
+      @card.reopen
+    end
+
+    assert @card.reload.burst?
+  end
+
+  test "a burst with no activity for two weeks is stalled" do
+    burst_by_assignment
+
+    travel 2.weeks do
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+      assert_includes Card.indexed_by("stalled"), @card
+    end
+  end
+
+  test "activity before two weeks keeps the card from stalling" do
+    burst_by_assignment
+
+    travel 13.days do
+      assert_not @card.reload.stalled?
+    end
+  end
+
+  test "any activity resets a stalled card" do
+    burst_by_assignment
+
+    travel 2.weeks do
+      assert @card.reload.stalled?
+
+      comment_as(:david, "Picking this back up")
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "a stalled card shows the flag wherever the card is rendered" do
+    burst_by_assignment
+
+    travel 2.weeks do
+      html = ApplicationController.render(partial: "cards/display/preview", locals: { card: @card.reload })
+
+      assert_includes html, "card--stalled"
+      assert_includes html, "Stalled"
+    end
+  end
+
+  private
+    def comment_as(user, body, created_at: nil)
+      attrs = { creator: users(user), body: body }
+      attrs[:created_at] = created_at if created_at
+      @card.comments.create!(attrs)
+    end
+
+    def burst_by_assignment
+      with_current_user(:david) do
+        @card.toggle_assignment(users(:kevin))
+      end
+      @card.reload
+    end
+end
