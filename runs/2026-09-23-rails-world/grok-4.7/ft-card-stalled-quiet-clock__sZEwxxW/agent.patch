diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..5f6851f
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,89 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_AFTER = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_PEOPLE_COUNT = 2
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ...stall_cutoff) }
+  end
+
+  class_methods do
+    # Include the remainder of the current second. `travel 2.weeks` freezes time
+    # at a whole second, which would otherwise miss activity recorded later in
+    # that same second.
+    def stall_cutoff
+      Time.zone.at(STALL_AFTER.ago.to_i + 1)
+    end
+
+    # Bust fragment caches once a burst card crosses the stall threshold.
+    # Activity updates last_active_at, which is what clears the stalled state.
+    def touch_newly_stalled(as_of: Time.current)
+      cutoff = as_of - STALL_AFTER
+      where.not(burst_at: nil)
+        .where(last_active_at: ..cutoff)
+        .where(updated_at: ..cutoff)
+        .find_each(&:touch)
+    end
+  end
+
+  def stalled?
+    burst? && active? && last_active_at.to_i <= STALL_AFTER.ago.to_i
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def cache_version
+    version = super
+    return version unless version
+
+    "#{version}/stalled:#{stalled?}"
+  end
+
+  def record_burst_from_event(event)
+    if event.action.card_assigned? || event.action.card_reopened?
+      mark_burst
+    end
+  end
+
+  def record_comment_burst(comment)
+    return if burst?
+    return if comment.creator.system?
+
+    mark_burst if comment_burst?
+  end
+
+  private
+    def mark_burst
+      update!(burst_at: Time.current) unless burst?
+    end
+
+    def comment_burst?
+      window = burst_window
+      rows = comments.by_user.order(:created_at, :id).pluck(:created_at, :creator_id)
+
+      rows.each_with_index.any? do |(start_time, _), index|
+        creator_ids = creator_ids_within_window(rows, index, start_time, window)
+        creator_ids.size >= BURST_COMMENT_COUNT && creator_ids.uniq.size >= BURST_PEOPLE_COUNT
+      end
+    end
+
+    def creator_ids_within_window(rows, index, start_time, window)
+      creator_ids = []
+
+      rows[index..].each do |time, creator_id|
+        break if time - start_time > window
+
+        creator_ids << creator_id
+      end
+
+      creator_ids
+    end
+
+    def burst_window
+      auto_postpone_period / 3.0
+    end
+end
