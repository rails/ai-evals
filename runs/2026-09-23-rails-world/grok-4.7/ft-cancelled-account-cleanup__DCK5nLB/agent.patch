index 2357b99..86046f0 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,14 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :cancelled, -> { joins(:cancellation) }
+    scope :due_for_incineration, -> { cancelled.where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  def incinerate
+    Incineration.new(self).run
+  end
 end
diff --git a/app/models/account/incineratable/incineration.rb b/app/models/account/incineratable/incineration.rb
new file mode 100644
index 0000000..81b75e8
--- /dev/null
+++ b/app/models/account/incineratable/incineration.rb
@@ -0,0 +1,139 @@
+class Account::Incineratable::Incineration
+  FILTER_JOIN_TABLES = {
+    "assignees_filters" => %w[ filter_id assignee_id ],
+    "assigners_filters" => %w[ filter_id assigner_id ],
+    "boards_filters" => %w[ filter_id board_id ],
+    "closers_filters" => %w[ filter_id closer_id ],
+    "creators_filters" => %w[ filter_id creator_id ],
+    "filters_tags" => %w[ filter_id tag_id ]
+  }.freeze
+
+  def initialize(account)
+    @account = account
+  end
+
+  def run
+    blobs = account.with_lock { incinerate_if_due }
+    delete_blob_files(blobs)
+  rescue ActiveRecord::RecordNotFound
+    # Already incinerated by a concurrent run.
+  end
+
+  private
+    attr_reader :account
+
+    def incinerate_if_due
+      if due?
+        identity_ids = exclusive_identity_ids
+        rehome_shared_identity_blobs
+        blobs = ActiveStorage::Blob.where(account_id: account.id).to_a
+
+        delete_search_index
+        delete_filter_join_records
+        delete_storage_totals
+        delete_account_scoped_rows
+        account.delete
+        delete_exclusive_identities(identity_ids)
+
+        blobs
+      end
+    end
+
+    def due?
+      account.cancelled? && !account.cancellation.created_at.after?(Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+    end
+
+    def exclusive_identity_ids
+      identity_ids = account.users.where.not(identity_id: nil).distinct.pluck(:identity_id)
+      shared_ids = User.where(identity_id: identity_ids).where.not(account_id: account.id).distinct.pluck(:identity_id)
+      identity_ids - shared_ids
+    end
+
+    def rehome_shared_identity_blobs
+      shared_identity_ids = account.users.where.not(identity_id: nil).distinct.pluck(:identity_id) - exclusive_identity_ids
+      return if shared_identity_ids.empty?
+
+      replacement_account_ids = User.where(identity_id: shared_identity_ids).where.not(account_id: account.id).pluck(:identity_id, :account_id).to_h
+
+      ActiveStorage::Attachment.where(record_type: "Identity", record_id: shared_identity_ids, account_id: account.id).find_each do |attachment|
+        if new_account_id = replacement_account_ids[attachment.record_id]
+          attachment.update_columns(account_id: new_account_id)
+          rehome_blob(attachment.blob, new_account_id)
+        end
+      end
+    end
+
+    def rehome_blob(blob, new_account_id)
+      if blob&.account_id == account.id
+        blob.update_columns(account_id: new_account_id)
+        ActiveStorage::VariantRecord.where(blob_id: blob.id, account_id: account.id).update_all(account_id: new_account_id)
+      end
+    end
+
+    def delete_search_index
+      if Search::Record.include?(Search::Record::SQLite)
+        ids = Search::Record.where(account_id: account.id).pluck(:id)
+        Search::Record::SQLite::Fts.where(rowid: ids).delete_all if ids.any?
+      end
+    end
+
+    def delete_filter_join_records
+      ids_by_column = {
+        "filter_id" => Filter.where(account_id: account.id).pluck(:id),
+        "assignee_id" => user_ids,
+        "assigner_id" => user_ids,
+        "closer_id" => user_ids,
+        "creator_id" => user_ids,
+        "board_id" => Board.where(account_id: account.id).pluck(:id),
+        "tag_id" => Tag.where(account_id: account.id).pluck(:id)
+      }
+
+      FILTER_JOIN_TABLES.each do |table, columns|
+        columns.each do |column|
+          delete_where(table, column, ids_by_column[column])
+        end
+      end
+    end
+
+    def user_ids
+      @user_ids ||= User.where(account_id: account.id).pluck(:id)
+    end
+
+    def delete_storage_totals
+      board_ids = Board.where(account_id: account.id).select(:id)
+      Storage::Total.where(owner_type: "Board", owner_id: board_ids).delete_all
+      Storage::Total.where(owner_type: "Account", owner_id: account.id).delete_all
+    end
+
+    def delete_account_scoped_rows
+      Account.connection.tables.each do |table|
+        if Account.connection.column_exists?(table, :account_id)
+          relation_for(table).where(account_id: account.id).delete_all
+        end
+      end
+    end
+
+    def delete_exclusive_identities(identity_ids)
+      Identity.where(id: identity_ids).find_each(&:destroy!)
+    end
+
+    def delete_where(table, column, ids)
+      if ids.present? && Account.connection.table_exists?(table)
+        relation_for(table).where(column => ids).delete_all
+      end
+    end
+
+    def relation_for(table)
+      Class.new(ApplicationRecord) do
+        self.table_name = table
+      end
+    end
+
+    def delete_blob_files(blobs)
+      Array(blobs).each do |blob|
+        blob.delete
+      rescue StandardError => error
+        Rails.logger.error("Failed to delete storage for blob #{blob.id} while incinerating account #{account.id}: #{error.class}: #{error.message}")
+      end
+    end
+end
