diff --git a/script/reproduce_account_incineration.rb b/script/reproduce_account_incineration.rb
new file mode 100644
index 0000000..35329fc
--- /dev/null
+++ b/script/reproduce_account_incineration.rb
@@ -0,0 +1,53 @@
+# Reproduces account retention after cancellation and checks incineration.
+# Run with: RAILS_ENV=test bin/rails runner script/reproduce_account_incineration.rb
+
+require "stringio"
+
+begin
+  identity = Identity.create!(email_address: "incinerate-#{SecureRandom.hex(6)}@example.com")
+  account = Account.create!(name: "Incineration repro #{SecureRandom.hex(4)}")
+  keeper = Account.create!(name: "Incineration keeper #{SecureRandom.hex(4)}")
+  user = account.users.create!(name: "Owner", role: :owner, identity: identity, verified_at: Time.current)
+  keeper_identity = Identity.create!(email_address: "keeper-#{SecureRandom.hex(6)}@example.com")
+  keeper_user = keeper.users.create!(name: "Keeper", role: :owner, identity: keeper_identity, verified_at: Time.current)
+  Current.account = account
+  Current.user = user
+  board = Board.create!(name: "Doomed board", account: account, creator: user)
+  card = Card.create!(title: "Doomed card", account: account, board: board, creator: user, status: :published, last_active_at: Time.current)
+  card.comments.create!(body: "secret comment", creator: user)
+  blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("secret"), filename: "secret.txt", content_type: "text/plain")
+  blob.update!(account: account)
+  session = identity.sessions.create!(ip_address: "127.0.0.1", user_agent: "repro")
+
+  account.cancel(initiated_by: user)
+  account.cancellation.update_columns(created_at: 31.days.ago, updated_at: 31.days.ago)
+
+  Account::IncinerateDueJob.perform_now
+
+  failures = []
+  failures << "cancelled account was not removed" if Account.exists?(account.id)
+  failures << "keeper account was removed" unless Account.exists?(keeper.id)
+  failures << "keeper user was removed" unless User.exists?(keeper_user.id)
+  failures << "board rows remain" if Board.where(account_id: account.id).exists?
+  failures << "card rows remain" if Card.where(account_id: account.id).exists?
+  failures << "comment rows remain" if Comment.where(account_id: account.id).exists?
+  failures << "user rows remain" if User.where(account_id: account.id).exists?
+  failures << "blob rows remain" if ActiveStorage::Blob.exists?(blob.id)
+  failures << "exclusive identity remains" if Identity.exists?(identity.id)
+  failures << "exclusive session remains" if Session.exists?(session.id)
+
+  if failures.any?
+    warn failures.join("\n")
+    exit 1
+  else
+    puts "Account incineration removed cancelled account data and kept unrelated accounts."
+  end
+ensure
+  if defined?(keeper) && keeper&.persisted?
+    User.where(account_id: keeper.id).delete_all
+    keeper.delete
+  end
+  if defined?(keeper_identity) && keeper_identity
+    Identity.where(id: keeper_identity.id).delete_all
+  end
+end
diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..d4e1deb
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,130 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @keeper = accounts(:initech)
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "permanently removes data for accounts cancelled more than 30 days ago" do
+    cancel_at(@account, 31.days.ago)
+    create_associated_data(@account, @user)
+
+    other_user_id = users(:mike).id
+    identity_id = identities(:david).id
+    other_board_id = boards(:miltons_wish_list).id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+    assert_no_account_rows(@account.id)
+    assert_not Identity.exists?(identity_id)
+    assert_not Session.exists?(identity_id: identity_id)
+    assert Account.exists?(@keeper.id)
+    assert User.exists?(other_user_id)
+    assert Board.exists?(other_board_id)
+  end
+
+  test "leaves accounts cancelled less than 30 days ago" do
+    cancel_at(@account, 29.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerates an account once the 30 day grace period has elapsed" do
+    cancel_at(@account, Account::Incineratable::INCINERATION_GRACE_PERIOD.ago)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "keeps identities that still belong to another account" do
+    identity = identities(:david)
+    other_account = @keeper
+    other_account.users.create!(name: "David Elsewhere", role: :member, identity: identity, verified_at: Time.current)
+    session = identity.sessions.create!(ip_address: "127.0.0.1", user_agent: "test")
+
+    cancel_at(@account, 31.days.ago)
+    Account::IncinerateDueJob.perform_now
+
+    assert Identity.exists?(identity.id)
+    assert Session.exists?(session.id)
+    assert other_account.users.exists?(identity: identity)
+    assert_not User.exists?(account_id: @account.id, identity: identity)
+  end
+
+  test "incinerate is a no-op until the grace period has elapsed" do
+    cancel_at(@account, 2.days.ago)
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+  end
+
+  test "removes search index rows and uploaded files" do
+    cancel_at(@account, 31.days.ago)
+    board = @account.boards.first
+    card = @account.cards.first
+    record = Search::Record.create!(
+      account_id: @account.id,
+      searchable: card,
+      card: card,
+      board_id: board.id,
+      title: "secret title",
+      content: "secret content",
+      created_at: Time.current
+    )
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("secret-bytes"),
+      filename: "secret.txt",
+      content_type: "text/plain"
+    )
+    blob.update!(account: @account)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Search::Record.exists?(record.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not blob.service.exist?(blob.key)
+    assert_equal 0, Search::Record::SQLite::Fts.where(rowid: record.id).count
+  end
+
+  private
+    def cancel_at(account, time)
+      account.cancel(initiated_by: account.users.where.not(identity_id: nil).first)
+      account.cancellation.update_columns(created_at: time, updated_at: time)
+    end
+
+    def create_associated_data(account, user)
+      board = account.boards.first
+      card = account.cards.first
+      tag = account.tags.create!(title: "doomed")
+      card.taggings.create!(tag: tag)
+      filter = user.filters.create!(fields: {}, params_digest: "incinerate-#{SecureRandom.hex(4)}")
+      account.webhooks.create!(board: board, url: "https://example.com/hooks", name: "hook", subscribed_actions: [ "card_closed" ])
+    end
+
+    def assert_no_account_rows(account_id)
+      connection = Account.connection
+
+      connection.tables.each do |table|
+        next unless connection.column_exists?(table, :account_id)
+
+        count = Class.new(ApplicationRecord) { self.table_name = table }.where(account_id: account_id).count
+        assert_equal 0, count, "#{table} still has rows for the incinerated account"
+      end
+    end
+end
