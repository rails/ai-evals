+++ b/app/jobs/account/incinerate_due_job.rb
@@ -0,0 +1,18 @@
+class Account::IncinerateDueJob < ApplicationJob
+  queue_as :backend
+
+  def perform
+    Account.due_for_incineration.find_each(&:incinerate)
+  end
+
+  # This job spans every account, so it must not capture or require a tenant.
+  def serialize
+    super.except("account")
+  end
+
+  def deserialize(job_data)
+    super
+    @account = nil
+    @account_gid = nil
+  end
+end
