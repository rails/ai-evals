diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..447da92
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,272 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+// Moving a card changes its column or status. Each column keeps its own order
+// (golden cards first, then most recently active), so a drop never reorders
+// cards inside one column. The card is placed where the save will leave it
+// before the request returns, so a later refresh has nothing to shift.
+export default class extends Controller {
+  static targets = [ "column" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.draggedCard = null
+    this.hoverColumn = null
+    this.queue = Promise.resolve()
+    this.desktopMedia = window.matchMedia(this.desktopBreakpointValue)
+    this.syncDraggable = this.#syncDraggable.bind(this)
+    this.desktopMedia.addEventListener("change", this.syncDraggable)
+    this.observer = new MutationObserver(this.syncDraggable)
+    this.observer.observe(this.element, { childList: true, subtree: true })
+    this.#syncDraggable()
+  }
+
+  disconnect() {
+    this.observer?.disconnect()
+    this.desktopMedia?.removeEventListener("change", this.syncDraggable)
+    this.#clearDragState()
+  }
+
+  start(event) {
+    const card = event.target.closest?.("article.card")
+    if (!card || !this.element.contains(card)) return
+
+    if (!this.desktopMedia.matches) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedCard = card
+    card.classList.add(DRAGGED_CLASS)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  over(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFrom(event.target)
+    if (!column) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+    this.#highlight(column)
+  }
+
+  leave(event) {
+    const column = this.#columnFrom(event.target)
+    if (!column || column !== this.hoverColumn) return
+
+    const next = event.relatedTarget
+    if (next && column.contains(next)) return
+
+    column.classList.remove(HOVER_CLASS)
+    this.hoverColumn = null
+  }
+
+  drop(event) {
+    const column = this.#columnFrom(event.target)
+    const card = this.draggedCard
+    if (!column || !card) return
+
+    event.preventDefault()
+    this.#moveCard(card, column)
+  }
+
+  end() {
+    this.#clearDragState()
+  }
+
+  // Private
+
+  #syncDraggable() {
+    const enabled = this.desktopMedia.matches
+    this.element.querySelectorAll("article.card").forEach(card => {
+      card.draggable = enabled
+      card.querySelectorAll("img, a").forEach(child => {
+        child.draggable = false
+      })
+    })
+  }
+
+  #moveCard(card, column) {
+    const source = this.#columnFrom(card)
+    if (!source || source === column) return
+
+    const list = this.#listFor(column)
+    if (!list) return
+
+    const snapshot = this.#snapshot(card, source)
+    this.#placeCard(card, column, list)
+    this.#syncAppearance(card, column)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(column, 1)
+    this.#enqueue(() => this.#persist(card, column, snapshot))
+  }
+
+  async #persist(card, column, snapshot) {
+    try {
+      const response = await this.#request(card, column)
+      if (!response?.ok) this.#restore(card, snapshot, column)
+    } catch (error) {
+      if (error?.name !== "AbortError") this.#restore(card, snapshot, column)
+    }
+  }
+
+  #request(card, column) {
+    const path = card.querySelector("a.card__link")?.pathname
+    if (!path) return Promise.resolve(null)
+
+    const options = { responseKind: "json", keepalive: true }
+    const action = column.dataset.dragAndDropAction
+
+    switch (action) {
+      case "not-now":
+        return post(`${path}/not_now`, options)
+      case "close":
+        return post(`${path}/closure`, options)
+      case "maybe":
+        return destroy(`${path}/triage`, options)
+      case "column":
+        return post(`${path}/triage`, { ...options, query: { column_id: column.dataset.columnId } })
+      default:
+        return Promise.resolve(null)
+    }
+  }
+
+  #placeCard(card, column, list) {
+    const container = list.querySelector("turbo-frame") || list
+    const cards = [ ...container.querySelectorAll("article.card") ].filter(item => item !== card)
+    const goldenFirst = column.dataset.dragAndDropOrder === "golden"
+    const golden = card.classList.contains("golden-effect")
+
+    let before = null
+    if (!goldenFirst || golden) {
+      before = cards[0]
+    } else {
+      before = cards.find(item => !item.classList.contains("golden-effect"))
+    }
+
+    if (before) {
+      before.before(card)
+    } else if (goldenFirst && !golden && cards.length > 0) {
+      cards.at(-1).after(card)
+    } else {
+      const pagination = container.querySelector(".pagination-link")
+      if (pagination) {
+        pagination.before(card)
+      } else {
+        container.prepend(card)
+      }
+    }
+  }
+
+  #syncAppearance(card, column) {
+    const action = column.dataset.dragAndDropAction
+    const postponed = action === "not-now"
+    const closed = action === "close"
+
+    card.classList.toggle("card--postponed", postponed)
+    card.classList.toggle("card--active", !postponed && !closed)
+
+    if (!closed) {
+      card.querySelectorAll(".card__closed").forEach(node => node.remove())
+    }
+
+    if (!postponed && !closed) {
+      const color = action === "maybe" ? "var(--color-card-default)" : column.style.getPropertyValue("--card-color").trim()
+      if (color) card.style.setProperty("--card-color", color)
+    }
+  }
+
+  #listFor(column) {
+    const existing = column.querySelector(".cards__list")
+    if (existing) return existing
+
+    const parent = column.querySelector("turbo-frame") || column.querySelector(".cards__transition-container")
+    if (!parent) return null
+
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    parent.append(list)
+    return list
+  }
+
+  #adjustCount(column, delta) {
+    const element = column.querySelector(".cards__expander-count")
+    if (!element) return
+
+    const current = element.textContent.trim()
+    if (current.endsWith("+")) return
+
+    const count = Number.parseInt(current, 10)
+    if (Number.isNaN(count)) return
+
+    const next = Math.max(count + delta, 0)
+    element.textContent = next > 99 ? "99+" : String(next)
+  }
+
+  #snapshot(card, source) {
+    return {
+      source,
+      parent: card.parentNode,
+      next: card.nextSibling,
+      className: card.className,
+      style: card.getAttribute("style"),
+      stamps: [ ...card.querySelectorAll(".card__closed") ].map(node => ({
+        node,
+        parent: node.parentNode,
+        next: node.nextSibling
+      }))
+    }
+  }
+
+  #restore(card, snapshot, column) {
+    if (!snapshot.parent?.isConnected) return
+
+    snapshot.parent.insertBefore(card, snapshot.next)
+    card.className = snapshot.className
+    if (snapshot.style == null) {
+      card.removeAttribute("style")
+    } else {
+      card.setAttribute("style", snapshot.style)
+    }
+
+    snapshot.stamps.forEach(({ node, parent, next }) => {
+      if (!node.isConnected && parent?.isConnected) parent.insertBefore(node, next)
+    })
+
+    this.#adjustCount(column, -1)
+    if (snapshot.source?.isConnected) this.#adjustCount(snapshot.source, 1)
+  }
+
+  #enqueue(task) {
+    this.queue = this.queue.then(task, task)
+    return this.queue
+  }
+
+  #highlight(column) {
+    if (this.hoverColumn === column) return
+
+    this.hoverColumn?.classList.remove(HOVER_CLASS)
+    column.classList.add(HOVER_CLASS)
+    this.hoverColumn = column
+  }
+
+  #clearDragState() {
+    this.draggedCard?.classList.remove(DRAGGED_CLASS)
+    this.draggedCard = null
+    this.hoverColumn?.classList.remove(HOVER_CLASS)
+    this.hoverColumn = null
+  }
+
+  #columnFrom(node) {
+    const element = node instanceof Element ? node : node?.parentElement
+    return element?.closest("[data-drag-and-drop-target='column']") || null
+  }
+}
