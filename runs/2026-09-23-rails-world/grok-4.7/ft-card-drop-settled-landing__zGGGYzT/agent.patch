diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..f23fd9b
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,117 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card into a column changes its column immediately and keeps that column's order" do
+    visit board_url(@board)
+
+    card = find_card("Buy domain")
+    expand(column("Triage"))
+    before = card_ids("Triage")
+
+    card.drag_to(column("Triage"))
+
+    expected = before.dup.insert(1, dom_id(cards(:buy_domain), :article))
+    assert_equal expected, card_ids("Triage")
+    assert_eventually_moved cards(:buy_domain), column: columns(:writebook_triage)
+
+    sleep 0.4
+    assert_equal expected, card_ids("Triage")
+
+    visit board_url(@board)
+    expand(column("Triage"))
+    assert_equal expected.first(2), card_ids("Triage").first(2)
+  end
+
+  test "dragging within a column does not reorder it" do
+    visit board_url(@board)
+
+    expand(column("Triage"))
+    before = card_ids("Triage")
+
+    find_card("Layout is broken").drag_to(column("Triage"))
+
+    assert_equal before, card_ids("Triage")
+    assert_equal columns(:writebook_triage), cards(:layout).reload.column
+  end
+
+  test "dragging a card to Done or Not Now changes its status immediately" do
+    visit board_url(@board)
+
+    find_card("Buy domain").drag_to(column("Not Now"))
+
+    assert_selector "#not-now article.card", text: "Buy domain", visible: :all
+    assert_eventually_postponed cards(:buy_domain)
+    sleep 0.4
+    assert_selector "#not-now article.card", text: "Buy domain", visible: :all
+    assert_no_selector "#maybe article.card", text: "Buy domain", visible: :all
+
+    expand(column("Not Now"))
+    find("#not-now article.card", text: "Buy domain").drag_to(column("Done"))
+
+    assert_selector "#closed-cards article.card", text: "Buy domain", visible: :all
+    assert_eventually_closed cards(:buy_domain)
+    sleep 0.4
+    assert_selector "#closed-cards article.card", text: "Buy domain", visible: :all
+    assert_no_selector "#not-now article.card", text: "Buy domain", visible: :all
+  end
+
+  test "dragging a triaged card back to Maybe sends it back to the front of that column's order" do
+    visit board_url(@board)
+
+    expand(column("Triage"))
+    maybe_before = card_ids("Maybe?")
+    find_card("Layout is broken").drag_to(column("Maybe?"))
+
+    expected = [ dom_id(cards(:layout), :article) ] + maybe_before
+    assert_equal expected, card_ids("Maybe?")
+    wait_until { cards(:layout).reload.awaiting_triage? }
+
+    sleep 0.4
+    assert_equal expected, card_ids("Maybe?")
+  end
+
+  private
+    def column(name)
+      find("section.cards[data-column-name='#{name}']")
+    end
+
+    def expand(column)
+      return if column[:class].to_s.split.include?("is-expanded")
+
+      column.find(".cards__expander").click
+      assert_selector "##{column[:id]}.is-expanded"
+    end
+
+    def find_card(title)
+      find("article.card", text: title, match: :first)
+    end
+
+    def card_ids(name)
+      column(name).all("article.card", visible: :all).map { |card| card[:id] }
+    end
+
+    def assert_eventually_moved(card, column:)
+      wait_until { card.reload.column == column }
+    end
+
+    def assert_eventually_closed(card)
+      wait_until { card.reload.closed? }
+    end
+
+    def assert_eventually_postponed(card)
+      wait_until { card.reload.postponed? }
+    end
+
+    def wait_until
+      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 5
+      until yield
+        raise "timed out waiting for card update" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline
+        sleep 0.05
+      end
+    end
+end
