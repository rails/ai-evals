@@ -0,0 +1,161 @@
+require "test_helper"
+
+class StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "bytes_used counts card images, description embeds, comment embeds, and board description embeds" do
+    image = attach_card_image(@card, "image-bytes")
+    description = attach_rich_text(@card, :description, "description-bytes")
+    comment = attach_rich_text(@card.comments.create!(body: "note"), :body, "comment-bytes")
+    board_file = attach_rich_text(@board, :public_description, "board-bytes")
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+
+    perform_enqueued_jobs
+
+    expected = image + description + comment + board_file
+    assert_equal expected, @board.bytes_used
+    assert_equal 0, @other_board.bytes_used
+    assert_equal expected, @account.bytes_used
+  end
+
+  test "removing an image decreases usage" do
+    size = attach_card_image(@card, "gone")
+    perform_enqueued_jobs
+    assert_equal size, @board.bytes_used
+
+    @card.image.purge
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "replacing an image adjusts by the difference" do
+    attach_card_image(@card, "short")
+    perform_enqueued_jobs
+
+    replacement = "a much longer replacement"
+    @card.image.attach(io: StringIO.new(replacement), filename: "next.txt", content_type: "image/jpeg")
+    perform_enqueued_jobs
+
+    assert_equal replacement.bytesize, @board.bytes_used
+    assert_equal replacement.bytesize, @account.bytes_used
+  end
+
+  test "moving a card transfers usage to the destination board" do
+    image = attach_card_image(@card, "moving-image")
+    comment = attach_rich_text(@card.comments.create!(body: "note"), :body, "moving-comment")
+    board_file = attach_rich_text(@board, :public_description, "stays")
+    perform_enqueued_jobs
+
+    @card.move_to(@other_board)
+    perform_enqueued_jobs
+
+    assert_equal board_file, @board.bytes_used
+    assert_equal image + comment, @other_board.bytes_used
+    assert_equal image + comment + board_file, @account.bytes_used
+  end
+
+  test "destroying a card removes its usage but keeps the board description" do
+    image = attach_card_image(@card, "doomed")
+    board_file = attach_rich_text(@board, :public_description, "kept")
+    perform_enqueued_jobs
+
+    @card.destroy
+    perform_enqueued_jobs
+
+    assert_equal board_file, @board.bytes_used
+    assert_equal board_file, @account.bytes_used
+    assert_not_equal image + board_file, @account.bytes_used
+  end
+
+  test "syncing the same attachment twice does not double count" do
+    size = attach_card_image(@card, "once")
+    perform_enqueued_jobs
+
+    Storage.sync_attachment(@card.image.attachment.id)
+    Storage.sync_attachment(@card.image.attachment.id)
+
+    assert_equal size, @board.bytes_used
+    assert_equal size, @account.bytes_used
+  end
+
+  test "image variants are not counted" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: file_fixture("moon.jpg").open,
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    @card.update!(description: ActionText::Attachment.from_attachable(blob).to_html)
+    perform_enqueued_jobs
+
+    assert @card.description.embeds.sole.variant(:small).processed?
+    assert_equal blob.byte_size, @board.bytes_used
+    assert_equal blob.byte_size, @account.bytes_used
+  end
+
+  test "recalculate matches incremental tracking" do
+    attach_card_image(@card, "recalc")
+    attach_rich_text(@other_board, :public_description, "other-board")
+    perform_enqueued_jobs
+
+    Account.where(id: @account.id).update_all(bytes_used: 0)
+    Board.where(account: @account).update_all(bytes_used: 0)
+    Storage::Contribution.where(account: @account).delete_all
+
+    Storage.recalculate(@account)
+
+    assert_operator @board.bytes_used, :>, 0
+    assert_operator @other_board.bytes_used, :>, 0
+    assert_equal @board.bytes_used + @other_board.bytes_used, @account.bytes_used
+  end
+
+
+test "purging a description embed decreases usage" do
+  size = attach_rich_text(@card, :description, "described")
+  perform_enqueued_jobs
+  assert_equal size, @board.bytes_used
+
+  @card.description.embeds.each(&:purge)
+  perform_enqueued_jobs
+
+  assert_equal 0, @board.bytes_used
+  assert_equal 0, @account.bytes_used
+end
+
+test "replacing a description with plain text removes embed usage" do
+  size = attach_rich_text(@card, :description, "described")
+  perform_enqueued_jobs
+  assert_equal size, @board.bytes_used
+
+  @card.update!(description: "plain text")
+  perform_enqueued_jobs
+
+  assert_equal 0, @board.bytes_used
+  assert_equal 0, @account.bytes_used
+end
+  private
+    def attach_card_image(card, contents)
+      card.image.attach(io: StringIO.new(contents), filename: "file.txt", content_type: "text/plain")
+      contents.bytesize
+    end
+
+    def attach_rich_text(record, name, contents)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "#{name}.jpg",
+        content_type: "image/jpeg"
+      )
+      record.update!(name => ActionText::Attachment.from_attachable(blob).to_html)
+      blob.byte_size
+    end
+end
