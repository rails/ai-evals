@@ -0,0 +1,9 @@
+module Storage::Usage
+  # Reads the counter maintained by background jobs so callers see the latest
+  # committed total even if this instance was loaded earlier.
+  def bytes_used
+    return 0 if new_record?
+
+    self.class.where(id: id).pick(:bytes_used).to_i
+  end
+end
