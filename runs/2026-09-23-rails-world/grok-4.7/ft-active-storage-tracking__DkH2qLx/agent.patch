@@ -0,0 +1,14 @@
+module Storage::CardTracking
+  extend ActiveSupport::Concern
+
+  included do
+    # after_update_commit can miss board changes made inside the request transaction.
+    # The job itself still waits until that transaction commits.
+    after_update :sync_storage_after_board_change, if: :saved_change_to_board_id?
+  end
+
+  private
+    def sync_storage_after_board_change
+      Storage.sync_card_later(self)
+    end
+end
