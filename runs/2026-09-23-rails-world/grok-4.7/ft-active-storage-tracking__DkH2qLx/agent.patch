new file mode 100644
index 0000000..437d177
--- /dev/null
+++ b/app/jobs/storage/sync_attachment_job.rb
@@ -0,0 +1,10 @@
+class Storage::SyncAttachmentJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+  retry_on ActiveRecord::Deadlocked, wait: :polynomially_longer, attempts: 5
+
+  limits_concurrency to: 1, key: ->(attachment_id) { attachment_id }, duration: 5.minutes
+
+  def perform(attachment_id)
+    Storage.sync_attachment(attachment_id)
+  end
+end
