diff --git a/app/models/storage.rb b/app/models/storage.rb
new file mode 100644
index 0000000..c10be09
--- /dev/null
+++ b/app/models/storage.rb
@@ -0,0 +1,206 @@
+module Storage
+  Location = Data.define(:board_id, :account_id, :byte_size)
+
+  class << self
+    def sync_attachment_later(attachment_id)
+      SyncAttachmentJob.perform_later(attachment_id)
+    end
+
+    def sync_card_later(card)
+      SyncCardJob.perform_later(card)
+    end
+
+    def sync_card(card)
+      attachment_ids_for(card).each { |attachment_id| sync_attachment(attachment_id) }
+    end
+
+    # Applies the current countable state of one attachment to the stored counters.
+    # Safe to run more than once and alongside other attachment syncs.
+    def sync_attachment(attachment_id, attempts: 3)
+      contribution = Contribution.create_or_find_by!(attachment_id: attachment_id)
+      contribution.with_lock do
+        apply_attachment(contribution, attachment_id)
+      end
+    rescue ActiveRecord::RecordNotFound
+      raise if attempts <= 1
+
+      sync_attachment(attachment_id, attempts: attempts - 1)
+    end
+
+    # Rebuilds counters from countable attachments. Imports insert records without callbacks.
+    def recalculate(account)
+      Contribution.transaction do
+        Contribution.where(account_id: account.id).delete_all
+        Board.where(account_id: account.id).update_all(bytes_used: 0)
+
+        rows = trackable_rows(account)
+        insert_contributions(account, rows)
+
+        totals = rows.each_with_object(Hash.new(0)) do |(_attachment_id, board_id, byte_size), sums|
+          sums[board_id] += byte_size
+        end
+
+        totals.each do |board_id, byte_size|
+          Board.where(id: board_id).update_all(bytes_used: byte_size)
+        end
+        Account.where(id: account.id).update_all(bytes_used: totals.values.sum)
+      end
+    end
+
+    private
+      def apply_attachment(contribution, attachment_id)
+        location = location_for(ActiveStorage::Attachment.find_by(id: attachment_id))
+
+        if location
+          move_contribution(contribution, location)
+        else
+          remove_contribution(contribution)
+        end
+      end
+
+      def move_contribution(contribution, location)
+        return if contribution.applied? &&
+          contribution.board_id == location.board_id &&
+          contribution.account_id == location.account_id &&
+          contribution.byte_size == location.byte_size
+
+        release_contribution(contribution)
+
+        contribution.update!(
+          account_id: location.account_id,
+          board_id: location.board_id,
+          byte_size: location.byte_size
+        )
+        adjust_counters(location.account_id, location.board_id, location.byte_size)
+      end
+
+      def remove_contribution(contribution)
+        release_contribution(contribution)
+        contribution.delete
+      end
+
+      def release_contribution(contribution)
+        if contribution.applied?
+          adjust_counters(contribution.account_id, contribution.board_id, -contribution.byte_size)
+        end
+      end
+
+      def adjust_counters(account_id, board_id, delta)
+        return if delta.zero?
+
+        Account.update_counters(account_id, bytes_used: delta) if account_id
+        Board.update_counters(board_id, bytes_used: delta) if board_id
+      end
+
+      def location_for(attachment)
+        return if attachment.nil?
+
+        byte_size = attachment.blob&.byte_size
+        return if byte_size.nil?
+
+        case attachment.record
+        when Card
+          location_for_card_image(attachment, byte_size)
+        when ActionText::RichText
+          location_for_embed(attachment, byte_size)
+        end
+      end
+
+      def location_for_card_image(attachment, byte_size)
+        return unless attachment.name == "image"
+
+        card = attachment.record
+        return if card.board_id.blank?
+
+        Location.new(card.board_id, card.account_id, byte_size)
+      end
+
+      def location_for_embed(attachment, byte_size)
+        return unless attachment.name == "embeds"
+
+        rich_text = attachment.record
+        parent = rich_text.record
+        return if parent.nil?
+
+        case parent
+        when Board
+          Location.new(parent.id, parent.account_id, byte_size) if rich_text.name == "public_description"
+        when Card
+          Location.new(parent.board_id, parent.account_id, byte_size) if rich_text.name == "description" && parent.board_id.present?
+        when Comment
+          card = parent.card
+          Location.new(card.board_id, card.account_id, byte_size) if rich_text.name == "body" && card&.board_id.present?
+        end
+      end
+
+      def attachment_ids_for(card)
+        ids = ActiveStorage::Attachment.where(record_type: "Card", record_id: card.id, name: "image").pluck(:id)
+
+        rich_text_ids = ActionText::RichText.where(record_type: "Card", record_id: card.id, name: "description").pluck(:id)
+        comment_ids = card.comments.pluck(:id)
+        if comment_ids.any?
+          rich_text_ids.concat ActionText::RichText.where(record_type: "Comment", record_id: comment_ids, name: "body").pluck(:id)
+        end
+
+        if rich_text_ids.any?
+          ids.concat ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_text_ids, name: "embeds").pluck(:id)
+        end
+
+        ids
+      end
+
+      def trackable_rows(account)
+        card_image_rows(account) +
+          embed_rows(account, "Board", "public_description", "boards", "boards.id") +
+          embed_rows(account, "Card", "description", "cards", "cards.board_id") +
+          comment_embed_rows(account)
+      end
+
+      def card_image_rows(account)
+        ActiveStorage::Attachment
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id AND cards.account_id = active_storage_attachments.account_id")
+          .joins("INNER JOIN active_storage_blobs ON active_storage_blobs.id = active_storage_attachments.blob_id")
+          .where(account_id: account.id, record_type: "Card", name: "image")
+          .pluck("active_storage_attachments.id", "cards.board_id", "active_storage_blobs.byte_size")
+      end
+
+      def embed_rows(account, record_type, name, table, board_sql)
+        ActiveStorage::Attachment
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN #{table} ON #{table}.id = action_text_rich_texts.record_id")
+          .joins("INNER JOIN active_storage_blobs ON active_storage_blobs.id = active_storage_attachments.blob_id")
+          .where(account_id: account.id, record_type: "ActionText::RichText", name: "embeds")
+          .where(action_text_rich_texts: { record_type: record_type, name: name })
+          .pluck("active_storage_attachments.id", board_sql, "active_storage_blobs.byte_size")
+      end
+
+      def comment_embed_rows(account)
+        ActiveStorage::Attachment
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+          .joins("INNER JOIN cards ON cards.id = comments.card_id")
+          .joins("INNER JOIN active_storage_blobs ON active_storage_blobs.id = active_storage_attachments.blob_id")
+          .where(account_id: account.id, record_type: "ActionText::RichText", name: "embeds")
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .pluck("active_storage_attachments.id", "cards.board_id", "active_storage_blobs.byte_size")
+      end
+
+      def insert_contributions(account, rows)
+        now = Time.current
+
+        rows.each_slice(1000) do |slice|
+          Contribution.insert_all(slice.map { |attachment_id, board_id, byte_size|
+            {
+              id: ActiveRecord::Type::Uuid.generate,
+              attachment_id: attachment_id,
+              account_id: account.id,
+              board_id: board_id,
+              byte_size: byte_size,
+              created_at: now,
+              updated_at: now
+            }
+          })
+        end
+      end
+  end
+end
diff --git a/app/models/storage/attachment_tracking.rb b/app/models/storage/attachment_tracking.rb
new file mode 100644
index 0000000..1038b82
--- /dev/null
+++ b/app/models/storage/attachment_tracking.rb
@@ -0,0 +1,44 @@
+module Storage::AttachmentTracking
+  extend ActiveSupport::Concern
+
+  prepended do
+    # Attachments created through a parent autosave do not run after_*_commit.
+    # Jobs are still deferred until the surrounding transaction commits.
+    after_create :sync_storage_later
+    after_destroy :sync_storage_later
+  end
+
+  # purge/purge_later delete the row without callbacks, so count them here.
+  def purge
+    remember_storage_sync
+    super
+    enqueue_remembered_storage_sync
+  end
+
+  def purge_later
+    remember_storage_sync
+    super
+    enqueue_remembered_storage_sync
+  end
+
+  private
+    def sync_storage_later
+      if storage_trackable?
+        Storage.sync_attachment_later(id)
+      end
+    end
+
+    def remember_storage_sync
+      @storage_sync_attachment_id = id if storage_trackable?
+    end
+
+    def enqueue_remembered_storage_sync
+      if @storage_sync_attachment_id
+        Storage.sync_attachment_later(@storage_sync_attachment_id)
+      end
+    end
+
+    def storage_trackable?
+      name == "image" && record_type == "Card" || name == "embeds" && record_type == "ActionText::RichText"
+    end
+end
