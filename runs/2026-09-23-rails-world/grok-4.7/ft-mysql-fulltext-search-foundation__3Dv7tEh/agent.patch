diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c594409
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel panel--wide shadow center search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do %>
+    <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+    <%= search_field_tag :q, @query,
+          placeholder: "Search titles, descriptions, and comments…",
+          class: "input",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off" %>
+    <%= submit_tag "Search", class: "btn", name: nil %>
+  <% end %>
+
+  <% if @terms.any? %>
+    <% if @cards.any? %>
+      <ol class="search-results unpad margin-none-block-end">
+        <%= render partial: "searches/result", collection: @cards, as: :card, locals: { terms: @terms } %>
+      </ol>
+    <% else %>
+      <p class="blank-slate">No cards match this search</p>
+    <% end %>
+  <% else %>
+    <p class="txt-subtle">Find a card by its title, description, or any comment on it.</p>
+  <% end %>
+</section>
