diff --git a/test/controllers/search_controller_test.rb b/test/controllers/search_controller_test.rb
new file mode 100644
index 0000000..6457123
--- /dev/null
+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "search page requires a signed in user" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  test "finds cards by title, description, or comment body and highlights matches" do
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    by_title = board.cards.create!(
+      title: "Title mentions zzqxtitle",
+      creator: creator,
+      status: :published,
+      created_at: 3.days.ago
+    )
+    by_description = board.cards.create!(
+      title: "Plain description card",
+      creator: creator,
+      status: :published,
+      created_at: 2.days.ago,
+      description: "Hidden in the description: zzqxdescription"
+    )
+    by_comment = board.cards.create!(
+      title: "Plain comment card",
+      creator: creator,
+      status: :published,
+      created_at: 1.day.ago
+    )
+    by_comment.comments.create!(body: "A comment about zzqxcomment", creator: creator)
+
+    get search_path(q: "zzqxtitle")
+    assert_response :success
+    assert_select "a[href=?]", card_path(by_title)
+    assert_select "mark", text: "zzqxtitle"
+    assert_no_match(/zzqxdescription|zzqxcomment/, response.body)
+
+    get search_path(q: "ZZQXDESCRIPTION")
+    assert_response :success
+    assert_select "a[href=?]", card_path(by_description)
+    assert_select "mark", text: "zzqxdescription"
+    assert_select "a[href=?]", card_path(by_title), count: 0
+
+    get search_path(q: "zzqxcomment")
+    assert_response :success
+    assert_select "a[href=?]", card_path(by_comment)
+    assert_select "mark", text: "zzqxcomment"
+    assert_select "a[href=?]", card_path(by_title), count: 0
+  end
+
+  test "returns newest cards first" do
+    board = boards(:writebook)
+    creator = users(:kevin)
+
+    older = board.cards.create!(title: "older zzqxorder", creator: creator, status: :published, created_at: 5.days.ago)
+    newer = board.cards.create!(title: "newer zzqxorder", creator: creator, status: :published, created_at: 1.hour.ago)
+
+    get search_path(q: "zzqxorder")
+
+    assert_response :success
+    titles = css_select(".search-result__title").map(&:text)
+    assert_equal [ newer.title, older.title ], titles
+  end
+
+  test "hides cards on boards the user cannot access" do
+    hidden = boards(:private).cards.create!(
+      title: "Secret zzqxhidden card",
+      creator: users(:kevin),
+      status: :published
+    )
+    visible = boards(:writebook).cards.create!(
+      title: "Visible zzqxhidden card",
+      creator: users(:david),
+      status: :published
+    )
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "zzqxhidden")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(visible)
+    assert_select "a[href=?]", card_path(hidden), count: 0
+    assert_select "mark", text: "zzqxhidden"
+    assert_no_match(/Secret zzqxhidden/, response.body)
+  end
+
+  test "draft cards and their comments never turn up" do
+    board = boards(:writebook)
+    draft = board.cards.create!(title: "Draft zzqxdraft", creator: users(:kevin), status: :drafted)
+    draft.update!(description: "draft description zzqxdraft")
+    comment = Comment.new(card: draft, creator: users(:kevin), account: draft.account)
+    comment.body = "draft comment zzqxdraft"
+    comment.rich_text_body.account = draft.account
+    comment.save!(validate: false)
+
+    published = board.cards.create!(title: "Published zzqxdraft", creator: users(:kevin), status: :published)
+
+    get search_path(q: "zzqxdraft")
+
+    assert_response :success
+    assert_select "a[href=?]", card_path(published)
+    assert_select "a[href=?]", card_path(draft), count: 0
+    assert_no_match(/draft comment|draft description|Draft zzqxdraft/i, response.body)
+  end
+
+  test "matches every word across fields and treats like wildcards as literals" do
+    card = boards(:writebook).cards.create!(
+      title: "100% zzqxwild_card",
+      creator: users(:kevin),
+      status: :published,
+      description: "Needs fuel"
+    )
+    card.comments.create!(body: "Bring the oxidizer", creator: users(:kevin))
+    decoy = boards(:writebook).cards.create!(title: "zzqxwildXcard", creator: users(:kevin), status: :published)
+
+    get search_path(q: "fuel oxidizer")
+    assert_response :success
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "fuel"
+    assert_select "mark", text: "oxidizer"
+
+    get search_path(q: "100%")
+    assert_response :success
+    assert_select "a[href=?]", card_path(card)
+    assert_select "mark", text: "100%"
+
+    get search_path(q: "zzqxwild_card")
+    assert_response :success
+    assert_select "mark", text: "zzqxwild_card"
+    assert_select "a[href=?]", card_path(decoy), count: 0
+
+    get search_path(q: "zzqxtitle' OR '1'='1")
+    assert_response :success
+    assert_select ".search-result", count: 0
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_no_match(/<script>alert/, response.body)
+  end
+
+  test "blank search shows the form without results" do
+    get search_path
+
+    assert_response :success
+    assert_select "input[name=q]"
+    assert_select ".search-result", count: 0
+  end
+end
