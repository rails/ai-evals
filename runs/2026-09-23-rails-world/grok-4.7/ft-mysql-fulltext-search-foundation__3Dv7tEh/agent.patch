diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..deca99e
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,19 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s
+    @terms = Card.search_terms(@query)
+    @cards = matching_cards
+  end
+
+  private
+    def matching_cards
+      if @terms.any?
+        Current.user.accessible_cards.search(@query)
+          .preload(:board, :rich_text_description, comments: :rich_text_body)
+          .to_a
+          .select { |card| card.matches_search?(@terms) }
+      else
+        []
+      end
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..ec45829
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,38 @@
+module SearchHelper
+  def search_snippets(card, terms)
+    snippets = []
+
+    if card.description?
+      text = card.description.to_plain_text
+      snippets << search_window(text, terms) if search_text_matches?(text, terms)
+    end
+
+    card.comments.each do |comment|
+      text = comment.body.to_plain_text
+      snippets << search_window(text, terms) if search_text_matches?(text, terms)
+    end
+
+    snippets.compact_blank
+  end
+
+  private
+    def search_text_matches?(text, terms)
+      folded = text.to_s.downcase
+      terms.any? { |term| folded.include?(term.downcase) }
+    end
+
+    def search_window(text, terms, radius: 80)
+      plain = text.to_s.gsub(/\s+/, " ").strip
+      return "" if plain.blank?
+
+      indexes = terms.filter_map { |term| plain.downcase.index(term.downcase) }
+      return plain.truncate(radius * 2) if indexes.empty?
+
+      start_at = [ indexes.min - radius, 0 ].max
+      finish_at = [ indexes.max + terms.map(&:length).max + radius, plain.length ].min
+      window = plain[start_at...finish_at]
+      window = "…#{window}" if start_at.positive?
+      window = "#{window}…" if finish_at < plain.length
+      window
+    end
+end
