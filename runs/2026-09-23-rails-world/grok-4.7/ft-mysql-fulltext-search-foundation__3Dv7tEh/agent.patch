diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..d02915b
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,60 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) {
+      terms = search_terms(query)
+
+      if terms.empty?
+        none
+      else
+        ids = terms.map { |term| ids_matching_term(self, term) }.reduce(:&)
+        published.where(id: ids).reverse_chronologically
+      end
+    }
+  end
+
+  class_methods do
+    def search_terms(query)
+      query.to_s.squish.split(/\s+/).uniq
+    end
+
+    def ids_matching_term(relation, term)
+      scoped = relation.unscope(:order)
+      rich_text = ActionText::RichText.arel_table
+
+      title_ids = scoped.where(match_any(arel_table[:title], term)).distinct.pluck(arel_table[:id])
+      description_ids = scoped.joins(:rich_text_description).where(match_any(rich_text[:body], term)).distinct.pluck(arel_table[:id])
+      comment_ids = scoped.joins(comments: :rich_text_body).where(match_any(rich_text[:body], term)).distinct.pluck(arel_table[:id])
+
+      (title_ids + description_ids + comment_ids).uniq
+    end
+
+    private
+      def match_any(column, term)
+        values = [ term.to_s ]
+        escaped = ERB::Util.html_escape(term.to_s).to_str
+        values << escaped unless escaped == term.to_s
+
+        values.map { |value| column.matches("%#{sanitize_sql_like(value)}%", "\\") }.reduce(:or)
+      end
+  end
+
+  def matches_search?(terms)
+    folded = searchable_text.downcase
+    terms.all? { |term| folded.include?(term.downcase) }
+  end
+
+  private
+    def searchable_text
+      [ title, description_plain_text, *comment_plain_texts ].compact.join("\n")
+    end
+
+    def description_plain_text
+      description.to_plain_text if description?
+    end
+
+    def comment_plain_texts
+      comments.map { |comment| comment.body.to_plain_text }
+    end
+end
