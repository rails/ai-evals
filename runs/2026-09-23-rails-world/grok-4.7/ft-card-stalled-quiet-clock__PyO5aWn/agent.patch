diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..6c1d05d
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,60 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  # A burst that then sees no activity for this long is stalled.
+  STALL_AFTER = 2.weeks
+  BURST_COMMENT_MINIMUM = 3
+  BURST_PEOPLE_MINIMUM = 2
+
+  included do
+    # Quiet after a burst. Closed and Not Now cards are filtered by the cards
+    # index itself; this scope is the time-based half of `indexed_by=stalled`.
+    scope :stalled, -> {
+      where.not(burst_at: nil)
+        .where(burst_at: ..STALL_AFTER.ago)
+        .where(last_active_at: ..STALL_AFTER.ago)
+    }
+  end
+
+  def stalled?
+    active? && stalls_at.present? && stalls_at <= Time.current
+  end
+
+  # When the card will be (or was) stalled. Activity moves `last_active_at`
+  # forward, which pushes this out and resets a stalled card.
+  def stalls_at
+    if burst_at.present? && last_active_at.present?
+      [ burst_at, last_active_at ].max + STALL_AFTER
+    end
+  end
+
+  def capture_comment_burst(comment)
+    if comment_burst?(comment)
+      record_burst(at: comment.created_at)
+    end
+  end
+
+  def record_burst(at: Time.current)
+    if burst_at.nil? || at > burst_at
+      update!(burst_at: at)
+    end
+  end
+
+  def burst_window
+    auto_postpone_period / 3
+  end
+
+  private
+    def comment_burst?(comment)
+      if comment.creator.system?
+        false
+      else
+        creator_ids = comments.by_user.where(created_at: burst_window_for(comment)).pluck(:creator_id)
+        creator_ids.size >= BURST_COMMENT_MINIMUM && creator_ids.uniq.size >= BURST_PEOPLE_MINIMUM
+      end
+    end
+
+    def burst_window_for(comment)
+      (comment.created_at - burst_window)..comment.created_at
+    end
+end
