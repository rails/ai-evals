diff --git a/test/controllers/cards/stalled_controller_test.rb b/test/controllers/cards/stalled_controller_test.rb
new file mode 100644
index 0000000..86a723c
--- /dev/null
+++ b/test/controllers/cards/stalled_controller_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Cards::StalledControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:text)
+  end
+
+  test "cards index lists stalled cards with indexed_by=stalled" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_select "##{dom_id(@card, :article)}", count: 0
+
+      travel 2.weeks
+
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_select "##{dom_id(@card, :article)}.card--stalled", text: /Stalled/
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_response :success
+      body = @response.parsed_body.find { |card| card["number"] == @card.number }
+      assert body["stalled"]
+      assert_not @response.parsed_body.any? { |card| card["number"] == cards(:logo).number }
+    end
+  end
+
+  test "activity removes a card from the stalled index" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+      travel 2.weeks
+      Current.session = sessions(:david)
+      @card.comments.create!(creator: users(:david), body: "Back to it")
+
+      get cards_path(format: :json), params: { indexed_by: "stalled" }
+      assert_response :success
+      assert_not_includes @response.parsed_body.pluck("number"), @card.number
+    end
+  end
+
+  test "a stalled card is marked wherever the card is shown" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+      travel 2.weeks
+
+      get card_path(@card)
+      assert_response :success
+      assert_select "##{dom_id(@card, :article)}.card--stalled", text: /Stalled/
+      assert_match "stalled", css_select("##{dom_id(@card, :article)} a, ##{dom_id(@card, :article)}").to_s
+    end
+  end
+end
diff --git a/test/models/card/stalled_test.rb b/test/models/card/stalled_test.rb
new file mode 100644
index 0000000..330a86b
--- /dev/null
+++ b/test/models/card/stalled_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Card::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    freeze_time do
+      comment_as users(:david), "One"
+      comment_as users(:kevin), "Two"
+      assert_nil @card.reload.burst_at
+
+      comment_as users(:david), "Three"
+
+      assert_equal Time.current, @card.reload.burst_at
+      assert_not @card.stalled?
+    end
+  end
+
+  test "three comments from one person are not a burst" do
+    freeze_time do
+      3.times { |i| comment_as users(:david), "Note #{i}" }
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments outside a third of the auto-close period are not a burst" do
+    window = @card.burst_window
+
+    freeze_time do
+      comment_as users(:david), "Old", created_at: window.seconds.ago - 1.second
+      comment_as users(:kevin), "Older", created_at: window.seconds.ago - 2.seconds
+      comment_as users(:david), "Now"
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "comments landing exactly at the window boundary are a burst" do
+    window = @card.burst_window
+
+    freeze_time do
+      comment_as users(:david), "Edge", created_at: window.seconds.ago
+      comment_as users(:kevin), "Middle", created_at: (window / 2).seconds.ago
+      comment_as users(:jz), "Now"
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "system comments do not count toward a burst" do
+    freeze_time do
+      2.times { |i| @card.comments.create!(creator: @card.account.system_user, body: "System #{i}") }
+      comment_as users(:david), "Just me"
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "assigning someone is a burst" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "reopening a card is a burst" do
+    card = cards(:shipping)
+
+    freeze_time do
+      card.reopen
+
+      assert_equal Time.current, card.reload.burst_at
+      assert_not card.stalled?
+    end
+  end
+
+  test "a burst with no activity for two weeks is stalled" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+      assert_not @card.reload.stalled?
+
+      travel 2.weeks - 1.second
+      assert_not @card.reload.stalled?
+
+      travel 1.second
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity resets a stalled card until it goes quiet again" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      comment_as users(:david), "Picking this back up"
+      assert_not @card.reload.stalled?
+      assert @card.burst_at.present?
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+  end
+
+  test "closed cards are not shown as stalled" do
+    freeze_time do
+      with_current_user(:jz) { @card.toggle_assignment(users(:jason)) }
+      @card.close
+      travel 2.weeks
+
+      assert_not @card.reload.stalled?
+    end
+  end
+
+
+test "burst window is a third of the board auto-close period, not the account default" do
+  assert_equal boards(:writebook).auto_postpone_period / 3, @card.burst_window
+  assert_not_equal @card.account.entropy.auto_postpone_period / 3, @card.burst_window
+
+  boards(:writebook).update!(auto_postpone_period: 3.days)
+  assert_equal 1.day.to_i, @card.reload.burst_window
+
+  freeze_time do
+    comment_as users(:david), "Too old", created_at: 2.days.ago
+    comment_as users(:kevin), "Also too old", created_at: 2.days.ago
+    comment_as users(:jz), "Only one in the window"
+    assert_nil @card.reload.burst_at
+
+    comment_as users(:david), "Inside", created_at: 12.hours.ago
+    comment_as users(:kevin), "Also inside", created_at: 6.hours.ago
+    comment_as users(:jz), "Completes the burst"
+    assert_equal Time.current, @card.reload.burst_at
+  end
+end
+  private
+    def comment_as(user, body, created_at: Time.current)
+      Current.session = Session.new(identity: user.identity)
+      @card.comments.create!(creator: user, body: body, created_at: created_at)
+    end
+end
