diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..ac42da1
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,58 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ show destroy ]
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.preload(reacter: [ :identity, :account, :avatar_attachment ])
+  end
+
+  def create
+    @reaction = @comment.reactions.create(reaction_params)
+
+    if @reaction.persisted?
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: { errors: @reaction.errors.full_messages }, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def show
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..05482c6
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,74 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "list", "popup" ]
+
+  listTargetConnected() {
+    this.#markOwnReactions()
+  }
+
+  showForm() {
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.triggerTarget.hidden = true
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.#closePopup()
+    this.#resetForm()
+  }
+
+  preventEmpty(event) {
+    if (!this.inputTarget.value.trim()) {
+      event.preventDefault()
+    }
+  }
+
+  insertEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget.dataset.emoji
+    const input = this.inputTarget
+    input.value = `${input.value}${emoji}`.slice(0, input.maxLength || 16)
+    input.focus()
+    this.#closePopup()
+  }
+
+  toggleExpanded(event) {
+    const reaction = event.currentTarget
+    if (!reaction.classList.contains("reaction--deleteable")) return
+    if (event.target.closest(".reaction__delete, button, a, form")) return
+
+    if (event.type === "keydown") event.preventDefault()
+    reaction.classList.toggle("expanded")
+  }
+
+  markDeleting(event) {
+    event.target.closest(".reaction")?.classList.add("reaction--deleting")
+  }
+
+  #resetForm() {
+    if (!this.hasFormTarget) return
+
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+  }
+
+  #closePopup() {
+    if (this.hasPopupTarget && this.popupTarget.open) this.popupTarget.close()
+  }
+
+  #markOwnReactions() {
+    const userId = window.Current?.user?.id
+    if (!userId || !this.hasListTarget) return
+
+    this.listTarget.querySelectorAll(`[data-creator-id="${userId}"]`).forEach((reaction) => {
+      reaction.classList.add("reaction--deleteable")
+      reaction.tabIndex = 0
+    })
+  }
+}
