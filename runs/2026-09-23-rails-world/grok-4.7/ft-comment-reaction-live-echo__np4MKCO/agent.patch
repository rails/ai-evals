@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "card page renders a reactions strip on comments" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select ".comment .reactions"
+    assert_select ".reactions__trigger"
+    assert_match "boost-color", response.body
+    assert_select "form.reaction__form[hidden]"
+    assert_select "form.reaction__form.reaction", count: 0
+    assert_select ".reaction__submit-btn"
+    assert_select ".reaction__cancel-btn"
+    assert_select ".reaction__emoji-list .btn", minimum: 1
+  end
+
+  test "create adds a reaction to the strip and brings the button back" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      assert_turbo_stream_broadcasts(@card, count: 1) do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice 👍" } }, as: :turbo_stream
+      end
+    end
+
+    assert_response :success
+    assert_equal "Nice 👍", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
