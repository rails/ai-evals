+<div id="<%= dom_id(comment, :reaction_composer) %>" class="display-contents" data-turbo-permanent>
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#showForm" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ],
+        class: "reaction__form",
+        html: { hidden: true },
+        data: { turbo_frame: "_top", reactions_target: "form", action: "keydown.esc->reactions#cancel:stop submit->reactions#preventEmpty" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label" do %>
+      <span class="for-screen-reader">Your reaction</span>
+      <%= form.text_field :content,
+            class: "input reaction__input",
+            maxlength: 16,
+            required: true,
+            autocomplete: "off",
+            autocapitalize: "off",
+            spellcheck: false,
+            placeholder: "React…",
+            aria: { label: "Your reaction" },
+            data: { reactions_target: "input" } %>
+    <% end %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
