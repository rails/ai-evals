diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..a8788b0
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,54 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, inverse_of: :reactions
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }, inverse_of: :reactions
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  before_validation :normalize_content
+
+  after_create_commit :broadcast_addition
+  after_destroy_commit :broadcast_removal
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  delegate :card, to: :comment
+
+  def emoji_only?
+    content.present? && !content.match?(/[[:alnum:]]/)
+  end
+
+  private
+    def normalize_content
+      self.content = content.to_s.strip
+    end
+
+    def broadcast_addition
+      refresh_comment_cache
+      broadcast_reactions_list
+    end
+
+    def broadcast_removal
+      if comment_still_there?
+        refresh_comment_cache
+        broadcast_remove_to comment.card
+      end
+    end
+
+    def broadcast_reactions_list
+      comment.reactions.reset
+
+      broadcast_replace_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/comments/reactions_list",
+        locals: { comment: comment }
+    end
+
+    def refresh_comment_cache
+      comment.update_column(:updated_at, Time.current)
+    end
+
+    def comment_still_there?
+      comment.present? && !comment.destroyed? && Comment.exists?(comment.id)
+    end
+end
