+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "creates a short reaction" do
+    reaction = @comment.reactions.create!(content: "  Nice 👍  ")
+
+    assert_equal "Nice 👍", reaction.content
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "rejects blank and overlong reactions" do
+    blank = @comment.reactions.build(content: "   ")
+    assert_not blank.valid?
+    assert_includes blank.errors[:content], "can't be blank"
+
+    long = @comment.reactions.build(content: "a" * 17)
+    assert_not long.valid?
+    assert_includes long.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "emoji only reactions are just pictographs or punctuation" do
+    assert @comment.reactions.build(content: "👍").emoji_only?
+    assert_not @comment.reactions.build(content: "Nice 👍").emoji_only?
+  end
+
+  test "broadcasts the reactions list when created" do
+    assert_turbo_stream_broadcasts(@comment.card, count: 1) do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+end
