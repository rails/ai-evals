+        <%= icon_tag "reaction" %>
+      </button>
+
+      <dialog class="reaction__popup popup" data-dialog-target="dialog" data-reactions-target="popup">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" aria-label="<%= label %>" data-emoji="<%= emoji %>" data-action="reactions#insertEmoji"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "reaction__submit-btn btn", aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn" data-action="reactions#cancel" aria-label="Cancel">
+      <%= icon_tag "close" %>
+    </button>
+  <% end %>
+</div>
