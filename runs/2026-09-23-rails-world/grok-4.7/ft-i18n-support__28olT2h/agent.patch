diff --git a/config/initializers/broadcast_locale.rb b/config/initializers/broadcast_locale.rb
new file mode 100644
index 0000000..867584d
--- /dev/null
+++ b/config/initializers/broadcast_locale.rb
@@ -0,0 +1,11 @@
+module BroadcastLocale
+  private
+    def render_format(format, **rendering)
+      locale = LocaleText.locale_from_rendering(rendering) || I18n.locale
+      I18n.with_locale(locale) { super }
+    end
+end
+
+Rails.application.config.to_prepare do
+  Turbo::StreamsChannel.singleton_class.prepend(BroadcastLocale) unless Turbo::StreamsChannel.singleton_class.ancestors.include?(BroadcastLocale)
+end
