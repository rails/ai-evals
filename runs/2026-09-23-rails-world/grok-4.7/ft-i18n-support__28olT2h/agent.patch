diff --git a/app/controllers/concerns/localizable.rb b/app/controllers/concerns/localizable.rb
new file mode 100644
index 0000000..2e87bf5
--- /dev/null
+++ b/app/controllers/concerns/localizable.rb
@@ -0,0 +1,46 @@
+module Localizable
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :capture_locale_param
+    before_action :apply_locale
+    helper_method :tx
+    etag { I18n.locale }
+  end
+
+  private
+    def tx(text, **options)
+      LocaleText.translate(text, **options)
+    end
+
+    def capture_locale_param
+      requested = params[:locale]
+      return unless requested.is_a?(String)
+      return if requested.blank?
+      return unless LocaleText.available?(requested)
+
+      session[:locale] = requested
+      response.headers["Turbo-Visit-Control"] = "reload"
+    end
+
+    def apply_locale
+      if explicit_locale_request? && Current.identity && Current.identity.locale != session[:locale]
+        Current.identity.update!(locale: session[:locale])
+      elsif session[:locale].blank? && LocaleText.available?(Current.identity&.locale)
+        session[:locale] = Current.identity.locale
+      end
+
+      Current.locale = session[:locale] if LocaleText.available?(session[:locale])
+      I18n.locale = resolved_locale
+    end
+
+    def explicit_locale_request?
+      requested = params[:locale]
+      requested.is_a?(String) && LocaleText.available?(requested) && session[:locale] == requested
+    end
+
+    def resolved_locale
+      candidate = session[:locale].presence || Current.identity&.locale
+      LocaleText.available?(candidate) ? candidate : I18n.default_locale
+    end
+end
