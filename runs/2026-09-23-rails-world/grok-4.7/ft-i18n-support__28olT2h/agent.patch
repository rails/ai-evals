diff --git a/app/models/locale_text.rb b/app/models/locale_text.rb
new file mode 100644
index 0000000..56c832d
--- /dev/null
+++ b/app/models/locale_text.rb
@@ -0,0 +1,74 @@
+class LocaleText
+  LOCALES = %w[ en ja ].freeze
+
+  class << self
+    def available?(locale)
+      LOCALES.include?(locale.to_s)
+    end
+
+    def translate(text, **options)
+      return text if text.nil?
+
+      html = options.delete(:html)
+      locale = (options.delete(:locale) || I18n.locale).to_s
+      template = lookup(text, locale)
+      return mark(template, html) if options.empty?
+
+      result = template.gsub(/%\{(\w+)\}/) do
+        value = options[$1.to_sym]
+        value = value.to_s
+        html ? ERB::Util.html_escape(value) : value
+      end
+      mark(result, html)
+    end
+
+    def locale_from(object)
+      return if object.nil?
+
+      identity = if object.respond_to?(:identity)
+        object.identity
+      elsif object.respond_to?(:user)
+        object.user&.identity
+      end
+
+      locale = identity&.locale
+      available?(locale) ? locale : nil
+    end
+
+    def locale_from_rendering(rendering)
+      locals = rendering[:locals] || {}
+      locals.each_value do |value|
+        locale = locale_from(value)
+        return locale if locale
+      end
+      nil
+    end
+
+    private
+      def lookup(text, locale)
+        return text if locale.blank? || locale == "en"
+
+        dictionary(locale).fetch(text, text)
+      end
+
+      def dictionary(locale)
+        if Rails.env.development?
+          load_dictionary(locale)
+        else
+          @dictionaries ||= {}
+          @dictionaries[locale] ||= load_dictionary(locale)
+        end
+      end
+
+      def load_dictionary(locale)
+        path = Rails.root.join("config/translations/#{locale}.json")
+        return {} unless path.exist?
+
+        JSON.parse(File.read(path))
+      end
+
+      def mark(text, html)
+        html ? text.html_safe : text
+      end
+  end
+end
