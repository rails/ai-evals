diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..6e037fd
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "query param switches to Japanese and sticks in the session" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_includes response.body, "サインイン"
+      assert_equal "ja", session[:locale]
+
+      get new_session_path
+      assert_includes response.body, "サインイン"
+    end
+  end
+
+  test "unknown locale does not switch or error" do
+    untenanted do
+      get new_session_path(locale: "xx")
+
+      assert_response :success
+      assert_includes response.body, "Get into Fizzy"
+      assert_nil session[:locale]
+    end
+  end
+
+  test "default pages stay English" do
+    untenanted do
+      get new_session_path
+
+      assert_response :success
+      assert_includes response.body, "Get into Fizzy"
+      assert_not_includes response.body, "サインイン"
+    end
+  end
+
+  test "locale persists on the identity and is restored on the next sign in" do
+    sign_in_as :david
+
+    get events_path(locale: "ja")
+    assert_response :success
+    assert_equal "ja", identities(:david).reload.locale
+    assert_includes response.body, "ホーム"
+
+    open_session do |clean_browser|
+      clean_browser.extend SessionTestHelper
