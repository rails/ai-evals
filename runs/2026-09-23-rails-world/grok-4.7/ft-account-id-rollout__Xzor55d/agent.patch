+        if source == :identity
+          execute <<~SQL
+            UPDATE #{q(table)}
+            SET #{c("account_id")} = #{c("#{association}_id")}
+            WHERE #{c("#{association}_type")} = #{connection.quote(type_name)}
+              AND #{c("account_id")} IS NULL
+          SQL
+        else
+          execute <<~SQL
+            UPDATE #{q(table)}
+            SET #{c("account_id")} = (
+              SELECT #{q(source)}.#{c("account_id")}
+              FROM #{q(source)}
+              WHERE #{q(source)}.#{c("id")} = #{q(table)}.#{c("#{association}_id")}
+                AND #{q(source)}.#{c("account_id")} IS NOT NULL
+            )
+            WHERE #{q(table)}.#{c("#{association}_type")} = #{connection.quote(type_name)}
+              AND #{q(table)}.#{c("account_id")} IS NULL
+          SQL
+        end
+      end
+    end
