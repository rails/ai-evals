+      copy_account_id "taggings", "cards", "card_id"
+      copy_account_id "watches", "cards", "card_id"
+      copy_account_id "search_queries", "users", "user_id"
+      copy_account_id "user_settings", "users", "user_id"
+      copy_account_id "webhook_delinquency_trackers", "webhooks", "webhook_id"
+      copy_account_id "webhook_deliveries", "webhooks", "webhook_id"
