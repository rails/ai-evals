+      end
+    end
+
+    def account_id_indexed?(table)
+      connection.indexes(table).any? { |index| Array(index.columns).first == "account_id" }
+    end
+
+    def copy_account_id(table, source_table, foreign_key, source_key: "id", aggregate: false)
+      source_account = "#{q(source_table)}.#{c("account_id")}"
+      source_match = "#{q(source_table)}.#{c(source_key)} = #{q(table)}.#{c(foreign_key)}"
+      selected = aggregate ? "MIN(#{source_account})" : source_account
+
+      execute <<~SQL
+        UPDATE #{q(table)}
+        SET #{c("account_id")} = (
+          SELECT #{selected}
+          FROM #{q(source_table)}
+          WHERE #{source_match}
+            AND #{source_account} IS NOT NULL
+        )
+        WHERE #{q(table)}.#{c("account_id")} IS NULL
+      SQL
+    end
