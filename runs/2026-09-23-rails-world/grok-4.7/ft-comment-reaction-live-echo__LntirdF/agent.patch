+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "comment page includes a reactions strip" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions)}" do
+      assert_select ".reactions__trigger", text: "Add a reaction"
+      assert_select ".reaction__input"
+      assert_select ".reaction__emoji-list .btn", minimum: 1
+    end
+  end
+
+  test "create adds the reaction to the strip and restores the button" do
+    assert_difference -> { @comment.reactions.count }, +1 do
