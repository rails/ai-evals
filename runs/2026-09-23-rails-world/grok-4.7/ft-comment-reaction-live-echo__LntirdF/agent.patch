@@ -0,0 +1,62 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    visit card_path(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Nice"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Nice"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction__form:not([hidden])"
+    end
+  end
+
+  test "clicking your reaction reveals a way to remove it" do
+    @comment.reactions.create!(content: "Nice", reacter: users(:kevin))
+
+    visit card_path(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reaction", text: "Nice").click
+      click_on "Remove reaction"
+      assert_no_selector ".reaction", text: "Nice"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "a reaction added elsewhere shows up without reloading" do
+    visit card_path(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    @comment.reactions.create!(content: "Live", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "Live", wait: 5
+    end
+  end
+
+  test "cancelling the composer brings the button back without adding a reaction" do
+    visit card_path(@card)
+
+    within "##{dom_id(@comment)}" do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Nope"
+      click_on "Cancel"
+      assert_selector ".reactions__trigger"
+      assert_no_selector ".reaction", text: "Nope"
+    end
+
+    assert_equal 0, @comment.reactions.count
+  end
+end
