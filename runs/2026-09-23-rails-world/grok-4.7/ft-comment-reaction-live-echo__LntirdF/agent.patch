diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..8ed3ba4
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,35 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  normalizes :content, with: ->(content) { content.strip }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  after_commit :broadcast_reactions_list, on: [ :create, :destroy ]
+
+  delegate :card, to: :comment
+
+  def emoji_only?
+    content.present? &&
+      content.match?(/\p{Extended_Pictographic}/) &&
+      content.gsub(/\p{Extended_Pictographic}|\p{Emoji_Component}/, "").blank?
+  end
+
+  private
+    def broadcast_reactions_list
+      return if comment.destroyed?
+
+      Turbo::StreamsChannel.broadcast_replace_to card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions_list),
+        partial: "cards/comments/reactions/list",
+        locals: { comment: comment, reactions: reactions_for_broadcast }
+    end
+
+    def reactions_for_broadcast
+      comment.reactions.preload(reacter: [ :avatar_attachment, :account ])
+    end
+end
