+    end
+
+    assert_response :success
+    assert_equal "Nice", @comment.reactions.last.content
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reactions_list)
+    assert_turbo_stream action: :replace, target: dom_id(@comment, :reaction_composer)
+    assert_match "Nice", response.body
+    assert_match "reactions__trigger", response.body
+    assert_match "boost-color", response.body
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
