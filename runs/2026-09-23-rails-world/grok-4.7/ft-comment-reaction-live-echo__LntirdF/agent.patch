+<div id="<%= dom_id(comment, :reaction_composer) %>" contents data-controller="reaction-composer">
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-composer-target="trigger"
+      data-action="reaction-composer#open" data-controller="tooltip" aria-label="Add a reaction">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], id: dom_id(comment, :new_reaction),
+        class: "reaction__form", html: { hidden: "hidden" },
+        data: { reaction_composer_target: "form", turbo_frame: "_top", controller: "form",
+                action: "keydown.esc->form#cancel:stop submit->form#preventEmptySubmit" } do |form| %>
+    <%= form.label :content, class: "reaction__form-label", for: dom_id(comment, :reaction_content) do %>
+      <%= form.text_field :content, id: dom_id(comment, :reaction_content), maxlength: 16, required: true, autocomplete: "off", spellcheck: false,
+            placeholder: "React…", aria: { label: "Reaction" },
+            class: "reaction__input input",
+            data: { reaction_composer_target: "input", form_target: "input", "1p-ignore": "true" } %>
+    <% end %>
+
+    <div class="reaction__menu" data-controller="dialog" data-dialog-orient-value="false"
+        data-action="click@document->dialog#closeOnClickOutside">
+      <button type="button" class="reaction__menu-btn btn" data-action="dialog#toggle" aria-label="Choose an emoji">
+        <%= icon_tag "reaction" %>
+        <span class="for-screen-reader">Choose an emoji</span>
+      </button>
+
+      <dialog class="reaction__popup popup panel" data-dialog-target="dialog" data-reaction-composer-target="dialog">
+        <div class="reaction__emoji-list">
+          <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+            <button type="button" class="btn" data-action="reaction-composer#pick" data-reaction-composer-emoji-param="<%= emoji %>" aria-label="<%= label %>"><%= emoji %></button>
+          <% end %>
+        </div>
+      </dialog>
+    </div>
+
+    <%= form.button class: "reaction__submit-btn btn", aria: { label: "Add reaction" } do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn" data-action="reaction-composer#close" data-form-target="cancel" aria-label="Cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel</span>
+    </button>
+  <% end %>
+</div>
