+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create strips content and assigns the current user" do
+    reaction = @comment.reactions.create!(content: "  Nice  ")
+
+    assert_equal "Nice", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "content is required and limited to 16 characters" do
+    blank = @comment.reactions.build(content: "   ")
+    assert_not blank.valid?
+    assert_includes blank.errors[:content], "can't be blank"
+
+    too_long = @comment.reactions.build(content: "a" * 17)
+    assert_not too_long.valid?
+    assert_includes too_long.errors[:content], "is too long (maximum is 16 characters)"
+
+    assert @comment.reactions.build(content: "a" * 16).valid?
+  end
+
+  test "emoji only reactions are just pictographs" do
+    assert @comment.reactions.build(content: "👍").emoji_only?
+    assert @comment.reactions.build(content: "🔥🔥").emoji_only?
+    assert_not @comment.reactions.build(content: "Great 👍").emoji_only?
+    assert_not @comment.reactions.build(content: "ok").emoji_only?
+  end
+
+  test "creating a reaction broadcasts the updated strip to the card" do
+    assert_turbo_stream_broadcasts @comment.card, count: 1 do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_difference -> { Reaction.count }, -1 do
+      @comment.destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
