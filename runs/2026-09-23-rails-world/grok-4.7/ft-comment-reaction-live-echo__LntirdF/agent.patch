diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..06bb102
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,53 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = reactions_scope
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params)
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to @card }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reactions_scope
+      @comment.reactions.preload(reacter: [ :identity, :account, :avatar_attachment ])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_composer_controller.js b/app/javascript/controllers/reaction_composer_controller.js
new file mode 100644
index 0000000..5211cb7
--- /dev/null
+++ b/app/javascript/controllers/reaction_composer_controller.js
@@ -0,0 +1,54 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns the add-reaction button into a short input, then back again.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "dialog" ]
+
+  connect() {
+    if (!this.formTarget.classList.contains("expanded")) {
+      this.formTarget.hidden = true
+      this.triggerTarget.hidden = false
+    }
+  }
+
+  open() {
+    this.element.setAttribute("data-turbo-permanent", "")
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.#closeDialog()
+    this.formTarget.reset()
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.element.removeAttribute("data-turbo-permanent")
+    this.triggerTarget.focus()
+  }
+
+  pick(event) {
+    event.preventDefault()
+
+    const emoji = event.params.emoji
+    if (!emoji) return
+
+    const input = this.inputTarget
+    const remaining = 16 - Array.from(input.value).length
+    if (remaining <= 0) {
+      input.focus()
+      return
+    }
+
+    input.value = input.value + Array.from(emoji).slice(0, remaining).join("")
+    input.dispatchEvent(new Event("input", { bubbles: true }))
+    this.#closeDialog()
+    input.focus()
+  }
+
+  #closeDialog() {
+    if (this.hasDialogTarget && this.dialogTarget.open) this.dialogTarget.close()
+  }
+}
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..f7f5c94
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reveals a way to remove your own reaction. Ownership is decided in the
+// browser so a cached comment looks right for whoever is looking at it.
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    this.owned = window.Current.user?.id === this.reacterIdValue
+
+    if (this.owned) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.tabIndex = 0
+      this.element.setAttribute("role", "button")
+      this.element.setAttribute("aria-expanded", "false")
+    }
+  }
+
+  toggle(event) {
+    if (!this.owned) return
+    if (event.target.closest(".reaction__delete")) return
+
+    event.preventDefault()
+    this.element.classList.toggle("expanded")
+    this.element.setAttribute("aria-expanded", this.element.classList.contains("expanded"))
+  }
+
+  remove(event) {
+    if (!this.owned) {
+      event.preventDefault()
+      return
+    }
+
+    event.preventDefault()
+    this.element.classList.add("reaction--deleting")
+
+    const form = event.target.closest("form")
+    setTimeout(() => form?.requestSubmit(), 180)
+  }
+}
