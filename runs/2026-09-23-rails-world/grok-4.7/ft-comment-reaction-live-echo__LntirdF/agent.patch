+    assert_equal "Great 👍", json["content"]
+    assert_equal users(:kevin).id, json.dig("reacter", "id")
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), json["url"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
