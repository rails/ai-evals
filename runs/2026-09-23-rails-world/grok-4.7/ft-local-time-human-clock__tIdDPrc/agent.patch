diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..585b12a
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,131 @@
+// Turns a raw timestamp into words in the viewer's timezone.
+//
+// relative:
+//   same day, already happened → "1:42 PM"
+//   same day, still ahead      → "today"
+//   previous calendar day      → "yesterday"
+//   next calendar day          → "tomorrow"
+//   earlier in the week        → "5 days ago"
+//   further ahead              → "in 3 days"
+//   older than a week          → "Sep 12" (year appended when it isn't this year)
+
+const MONTHS_SHORT = [ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" ]
+const MONTHS_LONG = [ "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" ]
+const WEEKDAYS = [ "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ]
+
+const DAY_MS = 24 * 60 * 60 * 1000
+const WEEK_IN_DAYS = 7
+
+export function formatLocalTime(value, format = "relative", now = new Date()) {
+  const parsed = parseTimeValue(value)
+  if (!parsed) return ""
+
+  switch (format) {
+    case "time":
+      return formatTime(parsed.date)
+    case "date":
+      return formatShortDate(parsed)
+    case "long-date":
+      return formatLongDate(parsed)
+    case "weekday-date":
+      return formatWeekdayDate(parsed)
+    case "numeric":
+      return formatNumeric(parsed.date)
+    default:
+      return formatRelative(parsed, now)
+  }
+}
+
+export function expandLocalTimes(text, now = new Date()) {
+  if (!text) return text
+
+  return text.replace(/\[\[time\|([^|]+)\|([^\]]+)\]\]/g, (_match, iso, format) => {
+    return formatLocalTime(iso, format, now) || iso
+  })
+}
+
+export function renderLocalTime(element, now = new Date()) {
+  const value = element.getAttribute("datetime")
+  if (!value) return
+
+  const format = element.dataset.localTimeFormatValue || "relative"
+  const text = formatLocalTime(value, format, now)
+  if (text && element.textContent !== text) element.textContent = text
+}
+
+export function renderAllLocalTimes(root = document, now = new Date()) {
+  root.querySelectorAll("time[data-controller~='local-time']").forEach((element) => {
+    renderLocalTime(element, now)
+  })
+}
+
+function parseTimeValue(value) {
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value)
+  if (dateOnly) {
+    const year = Number(dateOnly[1])
+    const month = Number(dateOnly[2])
+    const day = Number(dateOnly[3])
+    return { date: new Date(year, month - 1, day), year, month, day, dateOnly: true }
+  }
+
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return null
+
+  return {
+    date,
+    year: date.getFullYear(),
+    month: date.getMonth() + 1,
+    day: date.getDate(),
+    dateOnly: false
+  }
+}
+
+function formatRelative(parsed, now) {
+  const diff = calendarDayDiff(parsed.date, now)
+
+  if (diff === 0) {
+    if (parsed.dateOnly || parsed.date.getTime() > now.getTime()) return "today"
+    return formatTime(parsed.date)
+  }
+  if (diff === -1) return "yesterday"
+  if (diff === 1) return "tomorrow"
+  if (diff <= -2 && diff > -WEEK_IN_DAYS) return `${Math.abs(diff)} days ago`
+  if (diff >= 2) return `in ${diff} days`
+
+  return formatShortDate(parsed, { withYear: parsed.year !== now.getFullYear() })
+}
+
+function calendarDayDiff(date, now) {
+  const start = new Date(date.getFullYear(), date.getMonth(), date.getDate())
+  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
+  return Math.round((start - today) / DAY_MS)
+}
+
+function formatTime(date) {
+  let hours = date.getHours()
+  const minutes = String(date.getMinutes()).padStart(2, "0")
+  const meridiem = hours >= 12 ? "PM" : "AM"
+  hours = hours % 12
+  if (hours === 0) hours = 12
+  return `${hours}:${minutes} ${meridiem}`
+}
+
+function formatShortDate(parsed, { withYear = false } = {}) {
+  const text = `${MONTHS_SHORT[parsed.month - 1]} ${parsed.day}`
+  return withYear ? `${text}, ${parsed.year}` : text
+}
+
+function formatLongDate(parsed) {
+  const day = String(parsed.day).padStart(2, "0")
+  return `${MONTHS_SHORT[parsed.month - 1]} ${day}, ${parsed.year}`
+}
+
+function formatWeekdayDate(parsed) {
+  const weekday = WEEKDAYS[parsed.date.getDay()]
+  return `${weekday}, ${MONTHS_LONG[parsed.month - 1]} ${parsed.day}`
+}
+
+function formatNumeric(date) {
+  const year = String(date.getFullYear()).slice(-2)
+  return `${date.getMonth() + 1}/${date.getDate()}/${year}, ${formatTime(date)}`
+}
