diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..6d7f25c 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,26 @@
 module TimeHelper
+  # Raw timestamp for the browser to turn into words. The formatted string is
+  # never rendered here, so cached HTML stays shareable across timezones.
+  def local_time(time, format: :relative, date_only: false, **options)
+    return "" if time.blank?
+
+    stamp = date_only ? time.in_time_zone.to_date.iso8601 : time.to_time.utc.iso8601
+    format_name = format.to_s.tr("_", "-")
+
+    data = { controller: "local-time", local_time_format_value: format_name }
+    data.merge!(options.delete(:data) || {})
+
+    tag.time stamp,
+      datetime: stamp,
+      class: class_names("local-time-value", options.delete(:class)),
+      data: data,
+      **options
+  end
+
+  # Placeholder expanded by the native share bridge, which has no <time> element.
+  def local_time_token(time, format = :date)
+    return "" if time.blank?
+
+    "[[time|#{time.to_time.utc.iso8601}|#{format.to_s.tr("_", "-")}]]"
+  end
 end
