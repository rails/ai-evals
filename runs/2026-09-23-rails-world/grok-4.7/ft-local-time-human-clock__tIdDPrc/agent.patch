diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..336e07a
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "sends a raw UTC timestamp and leaves the words to the browser" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    html = local_time(time)
+    fragment = Nokogiri::HTML::DocumentFragment.parse(html)
+    element = fragment.at_css("time")
+
+    assert_equal "2024-09-12T17:42:00Z", element["datetime"]
+    assert_equal "2024-09-12T17:42:00Z", element.text
+    assert_equal "relative", element["data-local-time-format-value"]
+    assert_equal "local-time", element["data-controller"]
+    assert_includes element["class"], "local-time-value"
+    assert_not_includes html, "ago"
+    assert_not_includes html, "Sep"
+  end
+
+  test "raw timestamp does not change with the server timezone" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    utc = Time.use_zone("UTC") { local_time(time) }
+    pacific = Time.use_zone("America/Los_Angeles") { local_time(time) }
+
+    assert_equal utc, pacific
+  end
+
+  test "named formats are exposed for the browser" do
+    time = Time.utc(2024, 9, 5, 13, 5, 0)
+
+    assert_equal "date", Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :date)).at_css("time")["data-local-time-format-value"]
+    assert_equal "long-date", Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :long_date)).at_css("time")["data-local-time-format-value"]
+    assert_equal "weekday-date", Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :weekday_date)).at_css("time")["data-local-time-format-value"]
+    assert_equal "numeric", Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :numeric)).at_css("time")["data-local-time-format-value"]
+    assert_equal "time", Nokogiri::HTML::DocumentFragment.parse(local_time(time, format: :time)).at_css("time")["data-local-time-format-value"]
+  end
+
+  test "date-only stamps keep the calendar date the server grouped by" do
+    time = Time.utc(2024, 9, 12, 3, 0, 0)
+
+    html = Time.use_zone("America/New_York") { local_time(time, format: :weekday_date, date_only: true) }
+    element = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+    assert_equal "2024-09-11", element["datetime"]
+    assert_equal "weekday-date", element["data-local-time-format-value"]
+  end
+
+  test "share tokens carry the raw timestamp instead of formatted words" do
+    time = Time.utc(2024, 9, 12, 17, 42, 0)
+
+    assert_equal "[[time|2024-09-12T17:42:00Z|date]]", local_time_token(time)
+    assert_equal "", local_time(nil)
+    assert_equal "", local_time_token(nil)
+  end
+end
