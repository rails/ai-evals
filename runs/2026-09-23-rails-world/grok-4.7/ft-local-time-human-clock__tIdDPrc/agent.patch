diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..d1218a8
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,43 @@
+import { renderAllLocalTimes } from "helpers/local_time"
+
+const REFRESH_INTERVAL = 60_000
+
+function render() {
+  renderAllLocalTimes()
+}
+
+document.addEventListener("turbo:load", render)
+document.addEventListener("turbo:render", render)
+document.addEventListener("turbo:frame-load", render)
+document.addEventListener("turbo:morph", render)
+
+// Keep a formatted time when the instant hasn't changed, so a morph doesn't
+// flash the raw timestamp back into the page.
+document.addEventListener("turbo:before-morph-element", (event) => {
+  const current = event.target
+  if (!(current instanceof HTMLTimeElement)) return
+  if (!current.dataset.controller?.split(/\s+/).includes("local-time")) return
+
+  const incoming = event.detail?.newElement
+  if (!(incoming instanceof Element)) return
+
+  const sameInstant = current.getAttribute("datetime") === incoming.getAttribute("datetime")
+  const sameFormat = (current.dataset.localTimeFormatValue || "relative") === (incoming.dataset.localTimeFormatValue || "relative")
+
+  if (sameInstant && sameFormat) event.preventDefault()
+})
+
+// Snapshots must keep the raw timestamp so a restored page reformats itself
+// instead of replaying stale words like "yesterday".
+document.addEventListener("turbo:before-cache", () => {
+  document.querySelectorAll("time[data-controller~='local-time']").forEach((element) => {
+    const datetime = element.getAttribute("datetime")
+    if (datetime) element.textContent = datetime
+  })
+})
+
+document.addEventListener("visibilitychange", () => {
+  if (document.visibilityState === "visible") render()
+})
+
+setInterval(render, REFRESH_INTERVAL)
