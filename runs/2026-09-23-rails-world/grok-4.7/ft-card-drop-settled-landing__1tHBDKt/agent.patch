diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..faf680b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,327 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+const DRAGGED_ITEM_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CONTAINER_CLASS = "drag-and-drop__hover-container"
+const DESKTOP_QUERY = "(min-width: 640px)"
+
+// Moves a card between columns or statuses. Columns keep their own order, so a
+// drop changes where the card lives, not its place among siblings. The board
+// updates before the save so letting go already shows the result, and the save
+// does not render a stream that would shift it afterwards.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  connect() {
+    this.draggedItem = null
+    this.highlightedContainer = null
+    this.mediaQuery = window.matchMedia(DESKTOP_QUERY)
+    this.updateDragging = this.#updateDragging.bind(this)
+
+    this.#updateDragging()
+    this.mediaQuery.addEventListener("change", this.updateDragging)
+  }
+
+  disconnect() {
+    this.mediaQuery?.removeEventListener("change", this.updateDragging)
+  }
+
+  itemTargetConnected(item) {
+    this.#prepareItem(item)
+  }
+
+  dragStart(event) {
+    const item = this.#itemFrom(event)
+    if (!this.#draggingEnabled || !item || this.#shouldIgnore(event)) {
+      event.preventDefault()
+      return
+    }
+
+    this.draggedItem = item
+    item.classList.add(DRAGGED_ITEM_CLASS)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+  }
+
+  dragOver(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerFrom(event)
+    if (container) {
+      event.preventDefault()
+      if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+
+    this.#autoScroll(event)
+  }
+
+  async drop(event) {
+    const item = this.draggedItem
+    if (!item) return
+
+    event.preventDefault()
+    const container = this.#containerFrom(event)
+    this.#clearHighlight()
+
+    if (!container || container.contains(item)) return
+
+    const snapshot = this.#commitMove(item, container)
+    await this.#saveMove(item, container, snapshot)
+  }
+
+  dragEnd() {
+    this.draggedItem?.classList.remove(DRAGGED_ITEM_CLASS)
+    this.draggedItem = null
+    this.#clearHighlight()
+  }
+
+  // Private
+
+  #updateDragging() {
+    this.itemTargets.forEach(item => this.#prepareItem(item))
+  }
+
+  #prepareItem(item) {
+    item.draggable = this.#draggingEnabled
+    item.querySelectorAll("a, img").forEach(element => {
+      element.draggable = false
+    })
+  }
+
+  get #draggingEnabled() {
+    return this.mediaQuery?.matches ?? false
+  }
+
+  #shouldIgnore(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return true
+
+    return target.closest("button, a, input, textarea, select, dialog, lexxy-editor")
+  }
+
+  #itemFrom(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return null
+
+    const item = target.closest("[data-drag-and-drop-target~='item']")
+    if (item && this.element.contains(item)) return item
+
+    return null
+  }
+
+  #containerFrom(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return null
+
+    const container = target.closest("[data-drag-and-drop-target~='container']")
+    if (container && this.element.contains(container)) return container
+
+    return null
+  }
+
+  #highlight(container) {
+    if (this.highlightedContainer === container) return
+
+    this.#clearHighlight()
+    this.highlightedContainer = container
+    container.classList.add(HOVER_CONTAINER_CLASS)
+  }
+
+  #clearHighlight() {
+    this.highlightedContainer?.classList.remove(HOVER_CONTAINER_CLASS)
+    this.highlightedContainer = null
+  }
+
+  #autoScroll(event) {
+    const rect = this.element.getBoundingClientRect()
+    const edge = 48
+    const speed = 16
+
+    if (event.clientX < rect.left + edge) {
+      this.element.scrollLeft -= speed
+    } else if (event.clientX > rect.right - edge) {
+      this.element.scrollLeft += speed
+    }
+  }
+
+  #commitMove(item, container) {
+    const source = item.closest("[data-drag-and-drop-target~='container']")
+    const snapshot = this.#snapshot(item, source, container)
+
+    item.classList.remove(DRAGGED_ITEM_CLASS)
+    this.#moveItem(item, container)
+    this.#applyPlace(item, container)
+    this.#changeCount(source, -1)
+    this.#changeCount(container, 1)
+
+    return snapshot
+  }
+
+  #moveItem(item, container) {
+    const list = this.#listFor(container)
+    const anchor = this.#anchorIn(list, item, container)
+
+    if (anchor) {
+      anchor.before(item)
+    } else {
+      list.append(item)
+    }
+  }
+
+  #listFor(container) {
+    const existing = container.querySelector(".cards__list")
+    if (existing) return existing
+
+    const list = document.createElement("div")
+    list.className = "cards__list hide-scrollbar"
+    const frame = container.querySelector("turbo-frame")
+    const parent = frame || container.querySelector(".cards__transition-container") || container
+    parent.append(list)
+    return list
+  }
+
+  // Golden cards stay first in Maybe and named columns. A moved card is the
+  // newest activity, so it leads its group. Not Now and Done are newest-first.
+  #anchorIn(list, item, container) {
+    const cards = Array.from(list.querySelectorAll(".card")).filter(card => card !== item)
+    const leadsTheList = !this.#keepsGoldenFirst(container) || item.classList.contains("golden-effect")
+
+    if (leadsTheList) {
+      return cards[0]
+    } else {
+      return cards.find(card => !card.classList.contains("golden-effect"))
+    }
+  }
+
+  #keepsGoldenFirst(container) {
+    const place = container.dataset.dragAndDropPlace
+    return place === "column" || place === "maybe"
+  }
+
+  #applyPlace(item, container) {
+    const place = container.dataset.dragAndDropPlace
+    const open = place === "column" || place === "maybe"
+
+    item.classList.toggle("card--postponed", place === "not-now")
+    item.classList.toggle("card--active", open)
+    item.querySelectorAll(".card__closed").forEach(stamp => stamp.remove())
+
+    const color = container.style.getPropertyValue("--card-color").trim() || "var(--color-card-default)"
+    item.style.setProperty("--card-color", color)
+
+    item.querySelectorAll(".card__stages [data-column-id]").forEach(stage => {
+      const current = place === "column" && stage.dataset.columnId === container.dataset.columnId
+      stage.classList.toggle("card__column-name--current", current)
+    })
+
+    if (open) {
+      item.dataset.cardNotNowUrl = item.dataset.dragAndDropNotNowUrl
+      item.dataset.cardClosureUrl = item.dataset.dragAndDropClosureUrl
+    }
+  }
+
+  async #saveMove(item, container, snapshot) {
+    item.draggable = false
+
+    try {
+      const response = await this.#persist(item, container)
+      if (!response?.ok) this.#restore(snapshot)
+    } catch {
+      this.#restore(snapshot)
+    } finally {
+      item.draggable = this.#draggingEnabled
+    }
+  }
+
+  #persist(item, container) {
+    const place = container.dataset.dragAndDropPlace
+
+    if (place === "maybe") {
+      return destroy(item.dataset.dragAndDropTriageUrl, { responseKind: "json" })
+    } else if (place === "not-now") {
+      return post(item.dataset.dragAndDropNotNowUrl, { responseKind: "json" })
+    } else if (place === "closed") {
+      return post(item.dataset.dragAndDropClosureUrl, { responseKind: "json" })
+    } else if (place === "column") {
+      return post(item.dataset.dragAndDropTriageUrl, {
+        responseKind: "json",
+        query: { column_id: container.dataset.columnId }
+      })
+    }
+  }
+
+  #snapshot(item, source, destination) {
+    return {
+      item,
+      parent: item.parentElement,
+      next: item.nextElementSibling,
+      source,
+      destination,
+      postponed: item.classList.contains("card--postponed"),
+      active: item.classList.contains("card--active"),
+      color: item.style.getPropertyValue("--card-color"),
+      stamps: Array.from(item.querySelectorAll(".card__closed")),
+      stages: Array.from(item.querySelectorAll(".card__stages [data-column-id]")).map(stage => ({
+        stage,
+        current: stage.classList.contains("card__column-name--current")
+      })),
+      sourceCount: this.#countText(source),
+      destinationCount: this.#countText(destination)
+    }
+  }
+
+  #restore(snapshot) {
+    const { item, parent, next } = snapshot
+
+    if (next && next.parentElement === parent) {
+      parent.insertBefore(item, next)
+    } else if (parent) {
+      parent.append(item)
+    }
+
+    item.classList.toggle("card--postponed", snapshot.postponed)
+    item.classList.toggle("card--active", snapshot.active)
+
+    if (snapshot.color) {
+      item.style.setProperty("--card-color", snapshot.color)
+    } else {
+      item.style.removeProperty("--card-color")
+    }
+
+    snapshot.stamps.forEach(stamp => item.append(stamp))
+    snapshot.stages.forEach(({ stage, current }) => {
+      stage.classList.toggle("card__column-name--current", current)
+    })
+
+    this.#setCount(snapshot.source, snapshot.sourceCount)
+    this.#setCount(snapshot.destination, snapshot.destinationCount)
+  }
+
+  #changeCount(container, delta) {
+    const element = this.#countElement(container)
+    if (!element) return
+
+    const text = element.textContent.trim()
+    if (text === "99+") return
+
+    const value = Number.parseInt(text, 10)
+    if (Number.isNaN(value)) return
+
+    const next = value + delta
+    element.textContent = next > 99 ? "99+" : String(Math.max(next, 0))
+  }
+
+  #setCount(container, text) {
+    const element = this.#countElement(container)
+    if (element && text != null) element.textContent = text
+  }
+
+  #countText(container) {
+    return this.#countElement(container)?.textContent
+  }
+
+  #countElement(container) {
+    return container?.querySelector(".cards__expander-count")
+  }
+}
