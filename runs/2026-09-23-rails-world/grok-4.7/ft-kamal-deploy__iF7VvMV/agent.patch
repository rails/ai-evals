diff --git a/test/lib/one_box_deploy_config_test.rb b/test/lib/one_box_deploy_config_test.rb
new file mode 100644
index 0000000..5da991a
--- /dev/null
+++ b/test/lib/one_box_deploy_config_test.rb
@@ -0,0 +1,65 @@
+require "test_helper"
+require "erb"
+require "yaml"
+
+class OneBoxDeployConfigTest < ActiveSupport::TestCase
+  test "kamal config is a single container with proxy ssl and a persistent sqlite volume" do
+    config = deploy_config
+
+    assert_equal [ "web" ], config.fetch("servers").keys
+    assert_equal [ "fizzy.example.com" ], config.dig("servers", "web")
+    assert_equal true, config.dig("proxy", "ssl")
+    assert_equal "fizzy.example.com", config.dig("proxy", "host")
+    assert_equal "sqlite", config.dig("env", "clear", "DATABASE_ADAPTER")
+    assert_equal "true", config.dig("env", "clear", "SOLID_QUEUE_IN_PUMA")
+    assert_includes config.fetch("volumes"), "fizzy_storage:/rails/storage"
+    assert_nil config["accessories"]
+    assert_equal "localhost:5555", config.dig("registry", "server")
+    assert_includes config.dig("env", "secret"), "SECRET_KEY_BASE"
+    assert_includes config.dig("env", "secret"), "SMTP_PASSWORD"
+  end
+
+  test "filling in hostname and mail server is enough to point the app at them" do
+    config = deploy_config(
+      hostname: "kanban.example.org",
+      mail_server: "mail.internal"
+    )
+
+    assert_equal [ "kanban.example.org" ], config.dig("servers", "web")
+    assert_equal "kanban.example.org", config.dig("proxy", "host")
+    assert_equal "kanban.example.org", config.dig("env", "clear", "APP_HOST")
+    assert_equal "mail.internal", config.dig("env", "clear", "SMTP_ADDRESS")
+    assert_equal "Fizzy <notifications@kanban.example.org>", config.dig("env", "clear", "MAILER_FROM_ADDRESS")
+    assert_equal "https", config.dig("env", "clear", "APP_PROTOCOL")
+  end
+
+  test "secrets file is the place a fork fills in credentials" do
+    secrets = Rails.root.join(".kamal/secrets").read
+
+    assert_match(/^SECRET_KEY_BASE=/, secrets)
+    assert_match(/^SMTP_USERNAME=/, secrets)
+    assert_match(/^SMTP_PASSWORD=/, secrets)
+    assert_no_match(/[a-f0-9]{32,}/, secrets)
+  end
+
+  test "production wires hostname and mail server from the environment" do
+    production = Rails.root.join("config/environments/production.rb").read
+
+    assert_includes production, 'ENV["APP_HOST"]'
+    assert_includes production, 'ENV["SMTP_ADDRESS"]'
+    assert_includes production, "config.action_mailer.delivery_method = :smtp"
+    assert_includes production, 'request.path == "/up"'
+  end
+
+  test "image build does not copy kamal secrets" do
+    assert_match(%r{^/\.kamal$}, Rails.root.join(".dockerignore").read)
+  end
+
+  private
+    def deploy_config(hostname: "fizzy.example.com", mail_server: "smtp.example.com")
+      template = Rails.root.join("config/deploy.yml").read
+      template = template.sub('hostname = "fizzy.example.com"', %(hostname = "#{hostname}"))
+      template = template.sub('mail_server = "smtp.example.com"', %(mail_server = "#{mail_server}"))
+      YAML.unsafe_load(ERB.new(template, trim_mode: "-").result)
+    end
+end
