--- /dev/null
+++ b/.kamal/hooks/pre-deploy
@@ -0,0 +1,21 @@
+#!/bin/sh
+# Fail fast if a fork has not filled in the one-box deploy yet.
+set -eu
+
+case "${KAMAL_HOSTS:-}" in
+  *fizzy.example.com*)
+    echo "Set hostname in config/deploy.yml to the DNS name that points at this server." >&2
+    exit 1
+    ;;
+esac
+
+if [ "${SECRET_KEY_BASE:-change-me}" = "change-me" ] || [ -z "${SECRET_KEY_BASE:-}" ]; then
+  echo "Fill in SECRET_KEY_BASE in .kamal/secrets (generate one with: bin/rails secret)." >&2
+  exit 1
+fi
+
+if [ "${SMTP_USERNAME-change-me}" = "change-me" ] || [ "${SMTP_PASSWORD-change-me}" = "change-me" ]; then
+  echo "Fill in SMTP_USERNAME and SMTP_PASSWORD in .kamal/secrets." >&2
+  echo "Use empty values if the mail server does not authenticate." >&2
+  exit 1
+fi
