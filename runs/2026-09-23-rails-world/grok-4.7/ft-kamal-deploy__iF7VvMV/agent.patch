@@ -0,0 +1,13 @@
+# Secrets for config/deploy.yml. Fill these in before `kamal setup`.
+# Do not commit real values. Generate a key with: bin/rails secret
+#
+# Quote values that contain spaces or shell characters.
+# A mail server without authentication can use empty SMTP_USERNAME and SMTP_PASSWORD.
+
+SECRET_KEY_BASE=change-me
+SMTP_USERNAME=change-me
+SMTP_PASSWORD=change-me
+
+# Optional, for browser push notifications:
+# VAPID_PUBLIC_KEY=
+# VAPID_PRIVATE_KEY=
